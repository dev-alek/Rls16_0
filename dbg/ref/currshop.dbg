     1679         end.
     1680         assign
     1681           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1682         no-error .
     1683         if error-status :error
     1684         or error-status :get-message(1) <> ""
     1685         then do:
     1686           undo move_block, retry move_block.
     1687         end.
     1688         if frame Dialog-Frame :scrollable = true
     1689         then do:
     1690           assign
     1691             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1692           no-error .
     1693           if error-status :error
     1694           or error-status :get-message(1) <> ""
     1695           then do:
     1696             undo move_block, retry move_block.
     1697           end.
     1698         end.
     1699       end.
     1700       if p-move-resize
     1701       then do:
     1702         run diasize_position-resize-button in this-procedure .
     1703       end.
     1704       if v-diasize-wndstore = true
     1705       then do:
     1706         if connected("ub") = true
     1707         then do:
     1708           define variable v-cntxt-db-num        as integer   no-undo .
     1709           define variable v-cntxt-userid        as character no-undo .
     1710           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1711                                             , OUTPUT v-cntxt-userid
     1712                                             ) .
     1713           run gbl/wndsizew.p
     1714             (input  v-cntxt-db-num
     1715             ,input  v-cntxt-userid
     1716             ,input  v-diasize-proc-name
     1717             ,input  'width':u
     1718             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1719             ) .
     1720         end.
     1721       end.
     1722     end.
     1723     assign
     1724       v-diasize-change-size = false
     1725     .
     1726   end procedure.
     1727   procedure diasize_set-width :
     1728     define input  parameter p-new-width  as decimal   no-undo .
     1729     define input  parameter p-move-resize as logical   no-undo .
     1730     do
     1731     on error undo, return error return-value
     1732     :
     1733       run diasize_change-width in this-procedure
     1734         (input  (p-new-width - frame Dialog-Frame :width)
     1735         ,input  p-move-resize
     1736         ) .
     1737     end.
     1738   end procedure.
     1739   procedure diasize_position-resize-button :
     1740     do with frame Dialog-Frame
     1741     :
     1742       hide v-diasize-resize-button .
     1743       assign
     1744         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1745                     - 1
     1746                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1747         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1748                     - 1
     1749                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1750       .
     1751       view v-diasize-resize-button .
     1752     end.
     1753   end procedure.
     1754   on alt-right anywhere
     1755   do:
     1756     run diasize_change-width in this-procedure
     1757       (input 1
     1758       ,input true
     1759       ) .
     1760     return no-apply .
     1761   end.
     1762   on alt-left anywhere
     1763   do:
     1764     run diasize_change-width in this-procedure
     1765       (input -1
     1766       ,input true
     1767       ) .
     1768     return no-apply .
     1769   end.
     1770   on alt-down anywhere
     1771   do:
     1772     run diasize_change-height in this-procedure
     1773       (input 1
     1774       ,input true
     1775       ) .
     1776     return no-apply .
     1777   end.
     1778   on alt-up anywhere
     1779   do:
     1780     run diasize_change-height in this-procedure
     1781       (input -1
     1782       ,input true
     1783       ) .
     1784     return no-apply .
     1785   end.
     1786   on alt-enter of frame Dialog-Frame
     1787   do:
     1788     run diasize_maximize in this-procedure
     1789       (input  ?
     1790       ).
     1791     return no-apply .
     1792   end.
     1793   procedure diasize_end-move :
     1794     do
     1795     on error undo, return error return-value
     1796     :
     1797       define variable v-row-delta as decimal   no-undo .
     1798       define variable v-col-delta as decimal   no-undo .
     1799       define variable v-new-row as decimal   no-undo .
     1800       define variable v-new-col as decimal   no-undo .
     1801       assign
     1802         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1803         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1804       .
     1805       assign
     1806         v-row-delta = v-new-row - frame Dialog-Frame :height
     1807         v-col-delta = v-new-col - frame Dialog-Frame :width
     1808       .
     1809       run diasize_change-height in this-procedure
     1810         (input v-row-delta
     1811         ,input true
     1812         ) .
     1813       run diasize_change-width in this-procedure
     1814         (input v-col-delta
     1815         ,input true
     1816         ) .
     1817     end.
     1818   end procedure.
     1819   procedure diasize_maximize :
     1820     define input  parameter p-action as logical   no-undo .
     1821     do
     1822     on error undo, return error return-value
     1823     :
     1824       if p-action = ?
     1825       then do:
     1826         if v-diasize-need-maximize = true
     1827         then do:
     1828           assign
     1829             p-action = true
     1830           .
     1831         end.
     1832         else do:
     1833           assign
     1834             p-action = false
     1835           .
     1836         end.
     1837       end.
     1838       if p-action = true
     1839       then do:
     1840         run diasize_change-height in this-procedure
     1841           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1842               - frame Dialog-Frame :height-chars
     1843           ,input true
     1844           ) .
     1845         run diasize_change-width in this-procedure
     1846           (input session :width-chars
     1847               - frame Dialog-Frame :width-chars
     1848           ,input true
     1849           ) .
     1850         assign
     1851           v-diasize-need-maximize = false
     1852         .
     1853       end.
     1854       else do:
     1855         run diasize_change-width in this-procedure
     1856           (input v-diasize-orig-frame-width
     1857               - frame Dialog-Frame :width-chars
     1858           ,input true
     1859           ) .
     1860         run diasize_change-height in this-procedure
     1861           (input v-diasize-orig-frame-height
     1862               - frame Dialog-Frame :height-chars
     1863           ,input true
     1864           ) .
     1865         assign
     1866           v-diasize-need-maximize = true
     1867         .
     1868       end.
     1869     end.
     1870   end procedure.
     1871   procedure diasize_restore-orig-size :
     1872     do
     1873     on error undo, return error return-value
     1874     :
     1875       assign
     1876         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1877         v-diasize-current-frame-height = frame Dialog-Frame :height
     1878       .
     1879       run diasize_set-height in this-procedure
     1880         (input  v-diasize-orig-frame-height
     1881         ,input  true
     1882         ) .
     1883       run diasize_set-width in this-procedure
     1884         (input  v-diasize-orig-frame-width
     1885         ,input  true
     1886         ) .
     1887     end.
     1888   end procedure.
     1889   procedure diasize_restore-current-size :
     1890     do
     1891     on error undo, return error return-value
     1892     :
     1893       run diasize_set-height in this-procedure
     1894         (input  v-diasize-current-frame-height
     1895         ,input  true
     1896         ) .
     1897       run diasize_set-width in this-procedure
     1898         (input  v-diasize-current-frame-width
     1899         ,input  true
     1900         ) .
     1901     end.
     1902   end procedure.
     1903   procedure diasize_set-browse-handle :
     1904     define input  parameter p-browse-handle as handle   no-undo .
     1905     define buffer buf_temp-browse-handle for temp-browse-handle .
     1906     do
     1907     on error undo, return error return-value
     1908     :
     1909       assign
     1910         v-diasize-browse-handle = p-browse-handle
     1911       .
     1912       for each buf_temp-browse-handle
     1913       on error undo, return error return-value
     1914       :
     1915         delete buf_temp-browse-handle .
     1916       end.
     1917     end.
     1918   end procedure.
     1919   procedure diasize_add_browse :
     1920     define input  parameter p-browse-type   as character no-undo .
     1921     define input  parameter p-browse-handle as handle    no-undo .
     1922     define buffer buf_temp-browse-handle for temp-browse-handle .
     1923     do
     1924     on error undo, return error return-value
     1925     :
     1926       assign
     1927         v-diasize-browse-number = v-diasize-browse-number + 1
     1928       .
     1929       create buf_temp-browse-handle .
     1930       assign
     1931         buf_temp-browse-handle.browse-type   = p-browse-type
     1932         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1933         buf_temp-browse-handle.browse-handle = p-browse-handle
     1934       .
     1935     end.
     1936   end procedure.
     1937   procedure diasize_init :
     1938     define variable v-default-value    as logical   no-undo .
     1939     define variable v-restore-saved    as logical   no-undo .
     1940     define variable v-resize-value-str as character no-undo .
     1941     do
     1942     on error undo, return error return-value
     1943     :
     1944       do with frame Dialog-Frame
     1945       :
     1946         assign
     1947           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1948           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1949           v-diasize-browse-handle     = browse BR-curr-shop :handle
     1950         .
     1951         create button v-diasize-resize-button
     1952         assign
     1953           parent        = frame Dialog-Frame :first-child
     1954           label         = "s"
     1955           height-pixels = 16
     1956           width-pixels  = 16
     1957           visible       = true
     1958           sensitive     = true
     1959           movable       = true
     1960           triggers:
     1961             on end-move persistent run diasize_end-move in this-procedure .
     1962           end triggers.
     1963         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1964         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1965         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1966         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1967         assign
     1968           v-diasize-wndmax = false
     1969         .
     1970         if connected("ub") = true
     1971         then do:
     1972           define variable v-cntxt-db-num        as integer   no-undo .
     1973           define variable v-cntxt-userid        as character no-undo .
     1974           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1975                                             , OUTPUT v-cntxt-userid
     1976                                             ) .
     1977           run gbl/wndpar_r.p
     1978             (input  v-cntxt-db-num
     1979             ,input  v-cntxt-userid
     1980             ,input  'wndmax':U
     1981             ,output v-diasize-wndmax
     1982             ,output v-default-value
     1983             ) .
     1984         end.
     1985         assign
     1986           v-diasize-wndstore = false
     1987         .
     1988         if connected("ub") = true
     1989         then do:
     1990           run gbl/wndpar_r.p
     1991             (input  v-cntxt-db-num
     1992             ,input  v-cntxt-userid
     1993             ,input  'wndstore':U
     1994             ,output v-diasize-wndstore
     1995             ,output v-default-value
     1996             ) .
     1997         end.
     1998         assign
     1999           v-diasize-proc-name = entry(1, program-name(2), '.')
     2000         .
     2001         if v-diasize-wndstore = true
     2002         then do:
     2003           assign
     2004             v-restore-saved = false
     2005           .
     2006           if connected("ub") = true
     2007           then do:
     2008             run gbl/wndsizer.p
     2009               (input  v-cntxt-db-num
     2010               ,input  v-cntxt-userid
     2011               ,input  v-diasize-proc-name
     2012               ,input  'height':u
     2013               ,output v-resize-value-str
     2014               ) .
     2015             if v-resize-value-str <> '':U
     2016             then do:
     2017               run diasize_change-height in this-procedure
     2018                 (input  integer(v-resize-value-str)
     2019                 ,input  true
     2020                 ) .
     2021               assign
     2022                 v-restore-saved = true
     2023               .
     2024             end.
     2025           end.
     2026           if connected("ub") = true
     2027           then do:
     2028             run gbl/wndsizer.p
     2029               (input  v-cntxt-db-num
     2030               ,input  v-cntxt-userid
     2031               ,input  v-diasize-proc-name
     2032               ,input  'width':u
     2033               ,output v-resize-value-str
     2034               ) .
     2035             if v-resize-value-str <> '':U
     2036             then do:
     2037               run diasize_change-width in this-procedure
     2038                 (input  integer(v-resize-value-str)
     2039                 ,input  true
     2040                 ) .
     2041               assign
     2042                 v-restore-saved = true
     2043               .
     2044             end.
     2045           end.
     2046           if v-restore-saved <> true
     2047           then do:
     2048             if v-diasize-wndmax = true
     2049             then do:
     2050               run diasize_maximize in this-procedure
     2051                 (input  true
     2052                 ) .
     2053             end.
     2054           end.
     2055         end.
     2056         else do:
     2057           if v-diasize-wndmax = true
     2058           then do:
     2059             run diasize_maximize in this-procedure
     2060               (input  true
     2061               ) .
     2062           end.
     2063         end.
     2064       end.
     2065     end.
     2066   end procedure.
     2067   procedure diasize_need-full-display :
     2068     define output parameter p-need-full-display as logical   no-undo .
     2069     do
     2070     on error undo, return error return-value
     2071     :
     2072       assign
     2073         p-need-full-display = v-diasize-need-full-display
     2074       .
     2075       assign
     2076         v-diasize-need-full-display = false
     2077       .
     2078     end.
     2079   end procedure.
     2080   procedure get-context :
     2081      define output parameter p-db-num as integer          no-undo.
     2082      define output parameter p-user-id as character        no-undo.
     2083      define variable v-login               as character    no-undo.
     2084      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2085      define buffer buf_user-login  for ub.user-login .
     2086      do
     2087      on error undo, return error
     2088      :
     2089            FIND FIRST buf_sys-ctrl no-lock.
     2090            ASSIGN
     2091               v-login = USERID("ub")
     2092               p-db-num = buf_sys-ctrl.db-num
     2093            .
     2094            FIND FIRST buf_user-login
     2095                 WHERE buf_user-login.db-num = p-db-num
     2096                   AND buf_user-login.user-login = v-login
     2097                 no-lock
     2098                 no-error
     2099                 .
     2100            IF AVAILABLE buf_user-login
     2101            THEN DO:
     2102               assign
     2103                  p-user-id = buf_user-login.user-id
     2104               .
     2105            END.
     2106      end.
     2107   end procedure.
     2108       run diasize_init in this-procedure .
     2109   MAIN-BLOCK:
     2110   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2111      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2112   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2113     run mainmenu_getcntxt in parparentproc
     2114       (output v-cntxt-db-num
     2115       ,output v-cntxt-userid
     2116       ,output v-cntxt-level
     2117       ,output v-cntxt-host-code-obj
     2118       ,output v-cntxt-obj-type
     2119       ,output v-cntxt-obj-code
     2120       ,output v-cntxt-db-num-obj
     2121       ,output v-cntxt-is-admin
     2122       ) .
     2123     RUN Myenable in this-procedure .
     2124     WAIT-FOR GO OF FRAME Dialog-Frame.
     2125   END.
     2126   RUN disable_UI.
     2127   PROCEDURE add-rate :
     2128   define parameter buffer buf_currency for ub.currency.
     2129   define output param rid as recid no-undo init ?.
     2130   define variable found as logical init no.
     2131   define variable last-rate  like ub.curr-shop.exch-rate.
     2132   define variable last-scale like ub.curr-shop.exch-scale.
     2133   define variable v-today as date      no-undo.
     2134   define variable v-time  as integer   no-undo.
     2135   define buffer b-curr-shop   for ub.curr-shop.
     2136   define buffer buf_curr-shop for ub.curr-shop.
     2137   define button b-OK        label "&Ввод "   size 10 by 1  auto-go.
     2138   define button b-cancel  label "&Отмена"  size 10 by 1  auto-endkey.
     2139   define frame d-rate
     2140   b-OK
     2141   b-cancel
     2142   ub.curr-shop.exch-date    at row 2 col 16     colon-aligned  label "&Дата курса" format "99/99/9999"
     2143   ub.curr-shop.exch-rate     at row 3 col 16     colon-aligned  label "&Курс валюты"
     2144   ub.curr-shop.exch-scale   at row 4 col 16     colon-aligned  label "&Масштаб"
     2145   space( 1 )
     2146   with view-as dialog-box side-labels three-d
     2147   default-button b-OK title "Курс валюты: ВВОД".
     2148   find LAST b-curr-shop where
     2149            b-curr-shop.curr-code = buf_currency.curr-code
     2150        AND b-curr-shop.obj-type   = p-obj-type
     2151        AND b-curr-shop.obj-code  = p-obj-code no-error.
     2152     if  available b-curr-shop
     2153     then
     2154     assign
     2155     last-rate = b-curr-shop.exch-rate
     2156     last-scale = b-curr-shop.exch-scale
     2157     .
     2158     on go of frame d-rate do:
     2159       define buffer b-currency for ub.currency.
     2160       define variable rr as recid no-undo.
     2161       do on error undo, return on stop undo, return:
     2162           rr = recid( buf_currency ).
     2163           find b-currency where recid( b-currency ) = rr exclusive-lock.
     2164       end.
     2165      find LAST b-curr-shop where
     2166               b-curr-shop.curr-code = buf_currency.curr-code
     2167           AND b-curr-shop.obj-type   = p-obj-type
     2168           AND b-curr-shop.obj-code  = p-obj-code no-error.
     2169      run cur-time in this-procedure ( output v-today
     2170                                     , output v-time
     2171                                     ).
     2172      if  available b-curr-shop
     2173      AND (( b-curr-shop.exch-date > input ub.curr-shop.exch-date )
     2174            OR (( b-curr-shop.exch-date = input ub.curr-shop.exch-date )
     2175            AND ( b-curr-shop.exch-time > v-time )))     then do:
     2176         message
     2177         "Дата и время вводимого курса не могут быть" skip
     2178         "раньше чем у последнего введенного курса"
     2179         view-as alert-box error.
     2180         apply "entry":U to ub.curr-shop.exch-date.
     2181         return no-apply.
     2182      end.
     2183       find first buf_curr-shop where
     2184               buf_curr-shop.obj-type = p-obj-type
     2185           AND  buf_curr-shop.obj-code = p-obj-code
     2186           AND  buf_curr-shop.curr-code = buf_currency.curr-code
     2187           AND  buf_curr-shop.exch-date = 01/01/9999 no-error.
     2188       if NOT AVAIL buf_curr-shop then do:
     2189         create buf_curr-shop.
     2190         assign
     2191         buf_curr-shop.curr-code = buf_currency.curr-code
     2192         buf_curr-shop.obj-type   = p-obj-type
     2193         buf_curr-shop.obj-code  = p-obj-code
     2194         buf_curr-shop.exch-date = input curr-shop.exch-date
     2195         buf_curr-shop.exch-time = 0
     2196         buf_curr-shop.exch-rate = input curr-shop.exch-rate
     2197         buf_curr-shop.exch-scale = input curr-shop.exch-scale
     2198         rid = recid( buf_curr-shop )
     2199         v-created = YES
     2200         .
     2201       end.
     2202       else do:
     2203         assign
     2204         found = yes
     2205         buf_curr-shop.exch-rate = input curr-shop.exch-rate
     2206         buf_curr-shop.exch-scale =  input curr-shop.exch-scale
     2207         rid = recid( buf_curr-shop )
     2208         .
     2209       end.
     2210     end.
     2211     on window-close of frame d-rate apply "end-error":U to self.
     2212     frame d-rate:title = "Курс валюты: ВВОД".
     2213     enable all except curr-shop.exch-date with frame d-rate.
     2214     if avail buf_curr-shop then do:
     2215       display
     2216       1/1/9999 @ curr-shop.exch-date
     2217       last-rate @ curr-shop.exch-rate
     2218       last-scale @ curr-shop.exch-scale
     2219       with frame d-rate.
     2220     end.
     2221     else do:
     2222        display
     2223         1/1/9999 @ curr-shop.exch-date
     2224         1 @ curr-shop.exch-rate
     2225         1 @ curr-shop.exch-scale
     2226         with frame d-rate.
     2227     end.
     2228     do on endkey undo, leave on error undo, leave:
     2229         wait-for go of frame d-rate  focus curr-shop.exch-rate.
     2230     end.
     2231     disable all with frame d-rate.
     2232     hide frame d-rate.
     2233   OPEN QUERY br-currency FOR EACH X_currency       WHERE X_currency.curr-code > 0 NO-LOCK INDEXED-REPOSITION.
     2234    OPEN QUERY BR-curr-shop FOR EACH X_curr-shop       WHERE X_curr-shop.obj-type = p-obj-type  AND X_curr-shop.obj-code = p-obj-code  AND X_curr-shop.curr-code = X_currency.curr-code NO-LOCK     BY X_curr-shop.exch-date DESCENDING      BY X_curr-shop.exch-time DESCENDING INDEXED-REPOSITION.    OPEN QUERY br-currency FOR EACH X_currency       WHERE X_currency.curr-code > 0 NO-LOCK INDEXED-REPOSITION.
     2235   apply "value-changed":U to br-currency IN FRAME Dialog-Frame.
     2236   END PROCEDURE.
     2237   PROCEDURE disable_UI :
     2238     HIDE FRAME Dialog-Frame.
     2239   END PROCEDURE.
     2240   PROCEDURE enable_UI :
     2241     DISPLAY f-curr-bank-title f-curr-bank-rate f-curr-bank-scale-title
     2242             f-curr-bank-scale
     2243         WITH FRAME Dialog-Frame.
     2244     ENABLE b-quit B-repeat B-add B-Help br-currency BR-curr-shop
     2245            f-curr-bank-title f-curr-bank-rate f-curr-bank-scale-title
     2246            f-curr-bank-scale
     2247         WITH FRAME Dialog-Frame.
     2248     VIEW FRAME Dialog-Frame.
     2249     OPEN QUERY BR-curr-shop FOR EACH X_curr-shop       WHERE X_curr-shop.obj-type = p-obj-type  AND X_curr-shop.obj-code = p-obj-code  AND X_curr-shop.curr-code = X_currency.curr-code NO-LOCK     BY X_curr-shop.exch-date DESCENDING      BY X_curr-shop.exch-time DESCENDING INDEXED-REPOSITION.    OPEN QUERY br-currency FOR EACH X_currency       WHERE X_currency.curr-code > 0 NO-LOCK INDEXED-REPOSITION.
     2250   END PROCEDURE.
     2251   PROCEDURE MyEnable :
     2252   DISPLAY
     2253    f-curr-bank-title
     2254    f-curr-bank-scale-title
     2255    f-curr-bank-rate
