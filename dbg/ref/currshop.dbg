      669         X_curr-shop.cre-date FORMAT "99/99/9999":U
      670         string(X_curr-shop.cre-time, "hh:mm:ss") COLUMN-LABEL "Время!ввода" FORMAT "X(8)":U
      671               WIDTH 5.25
