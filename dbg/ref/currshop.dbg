        1   DEFINE BUFFER X_curr-shop FOR ub.curr-shop.
        2   DEFINE BUFFER X_currency FOR ub.currency.
        3   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        4   DEFINE INPUT PARAMETER p-obj-type LIKE ub.clients.obj-type NO-UNDO.
        5   DEFINE INPUT PARAMETER p-obj-code LIKE ub.clients.obj-code NO-UNDO.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Курсы валют в магазине".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   define variable v-waitfram-action01         as character   no-undo .
       68   define variable v-waitfram-action02         as character   no-undo .
       69   define variable v-waitfram-action03         as character   no-undo .
       70   define variable mWaitFramTextBeg            as character   no-undo.
       71   define variable mWaitFramTextEnd            as character   no-undo.
       72   define variable mWaitFramView               as logical     no-undo.
       73   define variable mWaitProcEvent              as logical     no-undo init yes.
       74   define variable mWaitFramInterval           as integer     no-undo init 1 .
       75   define variable mWaitFramStop               as logical     no-undo.
       76   define variable mWaitFramStopUser           as logical     no-undo.
       77   define variable mWaitFramStopTimeOut        as logical     no-undo.
       78   define variable mWaitFramStartProc          as datetime-tz no-undo.
       79   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       80   define button B-WaitFramStop auto-end-key
       81        label "Стоп"
       82        size 10 by 1 tooltip "Остоновить процесс".
       83   define button B-viewProcInfo
       84        label "Информация"
       85        size 15 by 1 tooltip "Информация о процесс".
       86   define frame waitfram
       87     v-waitfram-action01 format "x(72)" no-label skip
       88     v-waitfram-action02 format "x(72)" no-label skip
       89     v-waitfram-action03 format "x(72)" no-label skip
       90     B-viewProcInfo
       91     B-WaitFramStop at row 4 col 30
       92     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       93     .
       94   define new global shared variable mBatchMode as logical no-undo init ?.
       95   define variable mFramBachModHandle as handle no-undo.
       96   mFramBachModHandle = frame waitfram:handle.
       97   define variable mFameOldVis as logical no-undo.
       98   define variable mVisCUrentVin as logical no-undo.
       99   if session:batch-mode
      100   then
      101      mBatchMode = yes.
      102   if mBatchMode = ? then do:
      103     mVisCUrentVin = current-window:visible.
      104     mFameOldVis = mFramBachModHandle:visible.
      105     mFramBachModHandle:visible  = yes.
      106     mBatchMode = mFramBachModHandle:visible ne yes.
      107     mFramBachModHandle:visible = mFameOldVis.
      108     current-window:visible = mVisCUrentVin.
      109   end.
      110    if  log-manager:logfile-name ne ?
      111     then DO:
      112         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      113         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      114         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      115     end.
      116   on choose of B-WaitFramStop in frame waitfram
      117   do:
      118     mWaitFramStop = yes.
      119     mWaitFramStopUser = yes.
      120   end.
      121   function waitfram-check-timeout returns logical():
      122      define variable vtime as int64 no-undo.
      123      if mWaitFramStopTimeOut
      124      then
      125         return yes.
      126      vtime = ( now - mWaitFramStartProc ) / 1000 .
      127      if     mWaitFramTimeOut ne ?
      128         and mWaitFramTimeOut ne 0
      129         and mWaitFramTimeOut lt vtime
      130      then do:
      131         mWaitFramStopTimeOut = yes.
      132      end.
      133      return mWaitFramStopTimeOut.
      134   end.
      135   procedure waitfram-hide :
      136     if not session:batch-mode
      137     then do
      138     on error undo, return error return-value
      139     :
      140       pause 0 before-hide .
      141       if not mBatchMode then
      142         hide frame waitfram .
      143     if     not mWaitFramView
      144        and mWaitProcEvent
      145     then
      146       process events .
      147     end.
      148   end procedure.
      149   procedure waitfram-show :
      150     define input  parameter p-message as character no-undo .
      151     define variable v-left-margin as integer   no-undo .
      152     if not session:batch-mode
      153     then do
      154     on error undo, return error return-value
      155     :
      156       if length(p-message) <= 70 then do:
      157         assign
      158           v-left-margin = integer((70 - length(p-message)) / 2)
      159         .
      160         assign
      161           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      162         .
      163         assign
      164           v-waitfram-action01 = " "
      165           v-waitfram-action02 = " "
      166                                    + fill(" ", v-left-margin)
      167                                    + p-message
      168           v-waitfram-action03 = " "
      169         .
      170       end.
      171       else do:
      172         define variable vRindex1 as integer no-undo.
      173         define variable vRindex2 as integer no-undo.
      174         vRindex1 = r-index(p-message," ",70).
      175         if vRindex1 = 0
      176         then
      177            vRindex1 = 70.
      178         if length(p-message)  <= vRindex1 + 70 then do:
      179           assign
      180             v-waitfram-action01 = " "
      181             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      182             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      183           .
      184         end.
      185         else do:
      186           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      187           if vRindex2 <= vRindex1
      188           then
      189              vRindex2 = vRindex1 + 70.
      190           assign
      191             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      192             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      193             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      194           .
      195         end.
      196       end.
      197       B-viewProcInfo:visible   in frame waitfram = no.
      198       B-viewProcInfo:sensitive in frame waitfram = no.
      199       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      200       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      201       if  (   mWaitFramView
      202          or  mWaitProcEvent)
      203          and not mBatchMode
      204       then
      205          display
      206             v-waitfram-action01 skip
      207             v-waitfram-action02 skip
      208             v-waitfram-action03 skip
      209          with frame waitfram .
      210       if     mWaitFramView
      211          then do:
      212             if     mWaitFramInterval ne ?
      213                and not mBatchMode
      214             then
      215                wait-for go of frame waitfram pause mWaitFramInterval.
      216          end.
      217          else
      218             if     mWaitProcEvent
      219                and not mBatchMode
      220             then
      221                process events .
      222     end.
      223   end procedure.
      224      procedure waitfram-show-this:
      225         define input  parameter iInterval as int64 no-undo.
      226         define variable vtime as int64 no-undo.
      227         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      228         mWaitFramInterval = iInterval.
      229         run waitfram-show (substitute("&1&2 &3&4" ,
      230                                       mWaitFramTextBeg ,
      231                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      232                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      233                                       mWaitFramTextEnd
      234                                      )
      235                           ).
      236      end.
      237      procedure WaitFramRunPause:
      238         define input  parameter iInterval as dec no-undo.
      239         define variable vStart  as datetime-tz no-undo.
      240         define variable vend    as datetime-tz no-undo.
      241         define variable vint as int64 no-undo.
      242         define variable vOk as logical no-undo.
      243         vStart = now.
      244         vend   = vStart.
      245         publish "WaitFramPause" (iInterval,output vOk).
      246         vend   =  now.
      247         vint = vend - vStart.
      248         vint = iInterval - vint / 1000.
      249         if     not mWaitFramStop
      250            and (   vint > 0
      251                 or (    not vOk
      252                     and iInterval eq ?
      253                     )
      254                 )
      255         then
      256            run waitfram-show-this (iInterval).
      257         vend   =  now.
      258         vint = vend - vStart.
      259         vint = iInterval - vint / 1000.
      260         if     not mWaitFramStop
      261            and vint > 0
      262         then do:
      263            run gbl/pause.p (vint * 1000).
      264         end.
      265         if iInterval ne ?
      266         then
      267            publish "WaitFramStop".
      268         waitfram-check-timeout().
      269      end.
      270      procedure WaitFramWaitFor:
      271         define input  parameter iInterval as dec no-undo.
      272         assign
      273            mWaitFramStartProc   = now
      274            mWaitFramStopUser    = no
      275            mWaitFramStopTimeOut = no
      276         .
      277         block-wait:
      278         do while not mWaitFramStop:
      279            run WaitFramRunPause (iInterval).
      280            if  waitfram-check-timeout()
      281            then do:
      282               leave block-wait.
      283            end.
      284         end.
      285         run waitfram-hide.
      286      end.
      287   procedure waitfram-join :
      288     define input  parameter p-line-1  as character no-undo .
      289     define input  parameter p-line-2  as character no-undo .
      290     define input  parameter p-line-3  as character no-undo .
      291     define output parameter p-message as character no-undo .
      292     do
      293     on error undo, return error return-value
      294     :
      295       assign
      296         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      297                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      298                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      299       .
      300     end.
      301   end procedure.
      302   function waitfram-join-function returns character
      303     (input p-line-1 as character
      304     ,input p-line-2 as character
      305     ,input p-line-3 as character
      306     ).
      307     define variable v-message as character no-undo .
      308     run waitfram-join in this-procedure
      309       (input  p-line-1
      310       ,input  p-line-2
      311       ,input  p-line-3
      312       ,output v-message
      313       ) .
      314     return v-message .
      315   end function .
      316   define new global shared variable g#language as character no-undo .
      317   if g#language <> '' and g#language <> 'rus':U then do:
      318     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      319   end.
      320   define new global shared variable g#library  as handle no-undo .
      321   define new global shared variable g#library2 as handle no-undo .
      322   define   shared variable g#auto as logical no-undo.
      323   define   shared variable g#news as logical no-undo.
      324   define   shared variable g#oxml as logical no-undo.
      325   define   shared variable g#esys as logical no-undo.
      326   define   shared variable g#news-source-db as integer no-undo.
      327   define   shared variable g#esys-source-esys as integer no-undo.
      328   define   shared variable g#db-num as integer   no-undo .
      329   define   shared variable g#userid as character no-undo .
      330   define   shared variable g#passwd as character no-undo .
      331   procedure proc-alt-shift-f2:
      332     if not ibs.th.gbl.gbl-var:rcode
      333   then
      334     run gbl\inidebug.p .
      335   end.
      336   procedure proc-alt-shift-f3:
      337     run gbl/prvssinf.p
      338       ( input this-procedure
      339       ) .
      340   end.
      341   define variable v-inform-launched as logical no-undo initial false .
      342   procedure proc-alt-shift-f4:
      343     define variable v-action as character no-undo .
      344     if v-inform-launched = false then do:
      345       assign
      346         v-inform-launched = true
      347       .
      348       run gbl/d-inform.w
      349         (  input self
      350         ,  input this-procedure
      351         , output v-action
      352         ) no-error .
      353       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      354       assign
      355         v-inform-launched = false
      356       .
      357     end.
      358   end.
      359   procedure proc-alt-f1:
      360     run gbl/corrhelp.p
      361       (input this-procedure
      362       ) .
      363   end .
      364   on alt-shift-f2 anywhere do:
      365     run proc-alt-shift-f2.
      366   end.
      367   on alt-shift-f3 anywhere do:
      368     run proc-alt-shift-f3 in this-procedure .
      369   end.
      370   on alt-shift-f4 anywhere do:
      371     run proc-alt-shift-f4 in this-procedure.
      372   end.
      373   on alt-f1 anywhere do:
      374     run proc-alt-f1 in this-procedure .
      375   end.
      376   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   procedure cur-time :
      378      define output parameter p-today as date      no-undo .
      379      define output parameter p-time  as integer   no-undo .
      380     do
      381     on error undo, return error
      382     :
      383       define variable v-date1 as date      no-undo .
      384       define variable v-date2 as date      no-undo .
      385       define variable v-time  as integer   no-undo .
      386       assign
      387         v-date1 = today
      388         v-time  = time
      389         v-date2 = today
      390       .
      391       if v-date1 <> v-date2
      392       then do:
      393         assign
      394           v-date1 = today
      395           v-time  = v-time
      396         .
      397       end.
      398       assign
      399         p-today = v-date1
      400         p-time  = v-time
      401       .
      402     end.
      403   end.
      404   function cur-time-date returns character
      405   :
      406     return string(today, '99/99/9999':U) .
      407   end.
      408   function cur-time-mjd returns decimal
      409   :
      410     define variable v-date as date      no-undo .
      411     define variable v-time as integer   no-undo .
      412     run cur-time in this-procedure
      413       (output v-date
      414       ,output v-time
      415       ) .
      416     return integer(v-date) - 2400002 + (v-time / 86400) .
      417   end.
      418   function cur-time-get-ending-index returns integer
      419   (input p-number as integer
      420   )
      421   :
      422     if p-number < 0
      423     or p-number = ?
      424     then do:
      425       return 1 .
      426     end.
      427     define variable v-rest as integer   no-undo .
      428     assign
      429       p-number = p-number modulo 100
      430     .
      431     if p-number < 20
      432     then do:
      433       assign
      434         v-rest = p-number
      435       .
      436     end.
      437     else do:
      438       assign
      439         v-rest = p-number modulo 10
      440       .
      441     end.
      442     case v-rest :
      443       when 1
      444       then do:
      445         return 2 .
      446       end.
      447       when 2 or
      448       when 3 or
      449       when 4
      450       then do:
      451         return 3 .
      452       end.
      453       otherwise do:
      454         return 1 .
      455       end.
      456     end case .
      457   end.
      458   procedure cur-time-mjd-to-date :
      459      define input  parameter i-mjd-diff as decimal no-undo.
      460      define output parameter o-Date     as date    no-undo.
      461      define output parameter o-Time     as integer no-undo.
      462      define variable v-day-number as integer   no-undo .
      463      if    i-mjd-diff < 0
      464         or i-mjd-diff = ?
      465      then do:
      466         return "?" .
      467      end.
      468      assign
      469         v-day-number = truncate(i-mjd-diff,0).
      470         o-Date = date(v-day-number + 2400002).
      471         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      472     .
      473   end.
      474   function cur-time-mjd-to-string returns character
      475   (input p-mjd-diff as decimal
      476   )
      477   :
      478     define variable v-day-number as integer   no-undo .
      479     define variable v-seconds    as integer   no-undo .
      480     define variable v-hour       as integer   no-undo .
      481     define variable v-min        as integer   no-undo .
      482     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      483     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      484     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      485     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      486     if p-mjd-diff < 0
      487     or p-mjd-diff = ?
      488     then do:
      489       return "?" .
      490     end.
      491     assign
      492       v-day-number = integer(truncate(p-mjd-diff,0))
      493       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      494     .
      495     if v-seconds > 86400
      496     then do:
      497       assign
      498         v-seconds = 86400 - 1
      499       .
      500     end.
      501     if v-seconds < 0
      502     then do:
      503       assign
      504         v-seconds = 0
      505       .
      506     end.
      507     assign
      508       v-hour = truncate(v-seconds / 3600, 0)
      509     .
      510     assign
      511       v-seconds = v-seconds modulo 3600
      512     .
      513     assign
      514       v-min = truncate(v-seconds / 60, 0)
      515     .
      516     assign
      517       v-seconds = v-seconds modulo 60
      518     .
      519     return
      520         (if v-day-number <> 0
      521           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      522           else ""
      523         )
      524       + (if v-day-number <> 0 or v-hour <> 0
      525           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      526           else ""
      527         )
      528       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      529           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      530           else ""
      531         )
      532       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      533       .
      534   end.
      535   function cur-time-string returns character
      536   :
      537     define variable v-date as date      no-undo .
      538     define variable v-time as integer   no-undo .
      539     run cur-time in this-procedure
      540       (output v-date
      541       ,output v-time
      542       ) .
      543     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      544   end.
      545   function cur-time-string-sec returns character
      546   :
      547     define variable v-date as date      no-undo .
      548     define variable v-time as integer   no-undo .
      549     run cur-time in this-procedure
      550       (output v-date
      551       ,output v-time
      552       ) .
      553     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      554   end.
      555   function cur-time-custom  returns character
      556   (input p-prefix as character
      557   ,input p-date-format as character
      558   ,input p-delimiter as character
      559   ,input p-time-format as character
      560   ,input p-suffix as character
      561   )
      562   :
      563     define variable v-date as date      no-undo .
      564     define variable v-time as integer   no-undo .
      565     run cur-time in this-procedure
      566       (output v-date
      567       ,output v-time
      568       ) .
      569     return
      570       p-prefix
      571       + string(v-date, p-date-format)
      572       + p-delimiter
      573       + string(v-time, p-time-format)
      574       + p-suffix
      575       .
      576   end.
      577   function cur-time-print  returns character
      578   :
      579     define variable v-date as date      no-undo .
      580     define variable v-time as integer   no-undo .
      581     run cur-time in this-procedure
      582       (output v-date
      583       ,output v-time
      584       ) .
      585     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      586   end.
      587   function cur-time-datetime returns datetime
      588   :
      589     define variable v-char as character no-undo .
      590     define variable v-datetime as datetime no-undo .
      591     v-char = cur-time-string().
      592     v-datetime = datetime(v-char).
      593     return  v-datetime.
      594   end.
      595   function cur-time-string-msec returns character
      596   :
      597     define variable v-date as datetime  no-undo .
      598     v-date = now.
      599     return string(v-date) .
      600   end.
