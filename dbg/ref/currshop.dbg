     1361     define variable v-window-virtual-width as decimal   no-undo .
     1362     define variable v-change-sign          as integer   no-undo .
     1363     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1364     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1365     if p-change-value > 0
     1366     then do:
     1367       if frame Dialog-Frame :width + p-change-value >
     1368           session :width-chars
     1369       then do:
     1370         assign
     1371           p-change-value = session :width-chars - frame Dialog-Frame :width
     1372         .
     1373         if p-change-value <= 0
     1374         then do:
     1375           run diasize_position-resize-button in this-procedure .
     1376           return .
     1377         end.
     1378       end.
     1379     end.
     1380     if p-change-value < 0
     1381     then do:
     1382       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1383       then do:
     1384         assign
     1385           p-change-value = v-diasize-orig-frame-width
     1386                          - frame Dialog-Frame :width
     1387         .
     1388         if p-change-value >= 0
     1389         then do:
     1390           run diasize_position-resize-button in this-procedure .
     1391           return .
     1392         end.
     1393       end.
     1394     end.
     1395     if p-change-value >= 0
     1396     then do:
     1397       assign
     1398         v-change-sign = 1
     1399       .
     1400     end.
     1401     else do:
     1402       assign
     1403         v-change-sign = -1
     1404       .
     1405     end.
     1406     assign
     1407       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1408     .
     1409     if p-change-value = 0
     1410     then do:
     1411       run diasize_position-resize-button in this-procedure .
     1412       return .
     1413     end.
