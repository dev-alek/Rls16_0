      891         run diasize_position-resize-button in this-procedure .
      892       end.
      893       if v-diasize-wndstore = true
      894       then do:
      895         if connected("ub") = true
      896         then do:
      897           define variable v-cntxt-db-num        as integer   no-undo .
      898           define variable v-cntxt-userid        as character no-undo .
      899           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      900                                             , OUTPUT v-cntxt-userid
      901                                             ) .
      902           run gbl/wndsizew.p
      903             (input  v-cntxt-db-num
      904             ,input  v-cntxt-userid
      905             ,input  v-diasize-proc-name
      906             ,input  'height':u
      907             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      908             ) .
      909         end.
      910       end.
      911     end.
      912     assign
      913       v-diasize-change-size = false
      914     .
      915   end procedure.
      916   procedure diasize_set-height :
      917     define input  parameter p-new-height  as decimal   no-undo .
      918     define input  parameter p-move-resize as logical   no-undo .
      919     do
      920     on error undo, return error return-value
      921     :
      922       run diasize_change-height in this-procedure
      923         (input  (p-new-height - frame Dialog-Frame :height)
      924         ,input  p-move-resize
      925         ) .
      926     end.
      927   end procedure.
      928   procedure diasize_change-width :
      929     define input  parameter p-change-value as decimal   no-undo .
      930     define input  parameter p-move-resize  as logical   no-undo .
      931     define variable v-field-group-handle   as handle    no-undo .
      932     define variable v-object-handle        as handle    no-undo .
      933     define variable v-frame-width          as decimal   no-undo .
      934     define variable v-frame-virtual-width  as decimal   no-undo .
      935     define variable v-browse-width         as decimal   no-undo .
      936     define variable v-window-width         as decimal   no-undo .
      937     define variable v-window-virtual-width as decimal   no-undo .
      938     define variable v-change-sign          as integer   no-undo .
      939     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      940     define buffer buf_temp-browse-handle  for temp-browse-handle .
      941     if p-change-value > 0
      942     then do:
      943       if frame Dialog-Frame :width + p-change-value >
      944           session :width-chars
      945       then do:
      946         assign
      947           p-change-value = session :width-chars - frame Dialog-Frame :width
      948         .
      949         if p-change-value <= 0
      950         then do:
      951           run diasize_position-resize-button in this-procedure .
      952           return .
      953         end.
      954       end.
      955     end.
      956     if p-change-value < 0
      957     then do:
      958       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      959       then do:
      960         assign
      961           p-change-value = v-diasize-orig-frame-width
      962                          - frame Dialog-Frame :width
      963         .
      964         if p-change-value >= 0
      965         then do:
      966           run diasize_position-resize-button in this-procedure .
      967           return .
      968         end.
      969       end.
      970     end.
      971     if p-change-value >= 0
      972     then do:
      973       assign
      974         v-change-sign = 1
      975       .
      976     end.
      977     else do:
      978       assign
      979         v-change-sign = -1
      980       .
      981     end.
      982     assign
      983       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      984     .
      985     if p-change-value = 0
      986     then do:
      987       run diasize_position-resize-button in this-procedure .
      988       return .
      989     end.
      990     move_block:
