      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118     define variable v-cntxt-db-num        as integer   no-undo .
      119     define variable v-cntxt-userid        as character no-undo .
      120     define variable v-cntxt-level         as character no-undo .
      121     define variable v-cntxt-host-code-obj as integer   no-undo .
      122     define variable v-cntxt-obj-type      as character no-undo .
      123     define variable v-cntxt-obj-code      as integer   no-undo .
      124     define variable v-cntxt-db-num-obj    as integer   no-undo .
      125     define variable v-cntxt-is-admin      as logical   no-undo .
      126   define variable v-mark    as logical FORMAT "*/ "     no-undo.
      127   define variable v-change  as logical FORMAT "*/ "     no-undo.
      128   define variable v-ok      as logical      no-undo.
      129   define variable v-version    as integer      no-undo.
      130   DEFINE BUTTON b-add
      131        LABEL "&Добавить"
      132        SIZE 10 BY 1.
      133   DEFINE BUTTON b-chg
      134        LABEL "&Изменить"
      135        SIZE 10 BY 1.
      136   DEFINE BUTTON b-del
      137        LABEL "&Удалить"
      138        SIZE 10 BY 1.
      139   DEFINE BUTTON b-down
      140        LABEL "Выгрузить"
      141        SIZE 10 BY 1.
      142   DEFINE BUTTON b-help
      143        LABEL "Помо&щь"
      144        SIZE 10 BY 1
      145        BGCOLOR 8 .
      146   DEFINE BUTTON b-load
      147        LABEL "&Загрузить"
      148        SIZE 10 BY 1.
      149   DEFINE BUTTON b-mark
      150        LABEL "*"
      151        SIZE 3 BY 1.
      152   DEFINE BUTTON b-quit AUTO-END-KEY
      153        LABEL "&Выход"
      154        SIZE 10 BY 1
      155        BGCOLOR 8 .
      156   DEFINE BUTTON b-sel AUTO-GO
      157        LABEL "Выбор"
      158        SIZE 10 BY 1.
      159   DEFINE QUERY BROWSE-2 FOR
      160         buf_cd-events SCROLLING.
      161   DEFINE BROWSE BROWSE-2
      162     QUERY BROWSE-2 NO-LOCK DISPLAY
      163         (IF ( INDEX (rid-list, string( recid( buf_cd-events ) ) ) > 0 ) THEN TRUE ELSE FALSE) @ v-mark COLUMN-LABEL "*"
      164         buf_cd-events.event-id FORMAT ">>>9":U
      165         buf_cd-events.event-level FORMAT ">9":U
      166         buf_cd-events.event-name FORMAT "x(30)":U
      167         buf_cd-events.event-status FORMAT ">9":U
      168         buf_cd-events.event-type FORMAT "x(1)":U
      169         buf_cd-events.event-description FORMAT "x(255)":U
      170       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 19.75 FIT-LAST-COLUMN.
      171   DEFINE FRAME Dialog-Frame
      172        b-quit AT ROW 1 COL 1
      173        b-mark AT ROW 1 COL 13.5 WIDGET-ID 4
      174        b-sel AT ROW 1 COL 16.5 WIDGET-ID 6
      175        b-add AT ROW 1 COL 29 WIDGET-ID 10
      176        b-chg AT ROW 1 COL 39 WIDGET-ID 8
      177        b-del AT ROW 1 COL 49 WIDGET-ID 14
      178        b-load AT ROW 1 COL 61.63 WIDGET-ID 2
      179        b-down AT ROW 1 COL 71.63 WIDGET-ID 12
      180        b-help AT ROW 1 COL 88
      181        BROWSE-2 AT ROW 2.25 COL 1 WIDGET-ID 200
      182        SPACE(0.00) SKIP(0.99)
      183       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      184            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      185            TITLE "Справочник событий на кассе"
      186            CANCEL-BUTTON b-quit WIDGET-ID 100.
      187   ASSIGN
      188          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      189          FRAME Dialog-Frame:HIDDEN           = TRUE.
      190   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      191   DO:
      192     APPLY "END-ERROR":U TO SELF.
      193   END.
      194   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      195   DO:
      196      define variable v-id    as integer      no-undo.
      197      assign
      198         v-ok = FALSE
      199      .
      200      run ref/cdevened.w ( INPUT parparentproc
      201                         , INPUT v-version
      202                         , INPUT-OUTPUT v-id
      203                         , OUTPUT v-ok
      204                         ) NO-ERROR.
      205      IF ERROR-STATUS:ERROR
      206      THEN DO:
      207         message
      208            "Ошибка создания записи в справочнике событий на кассе"
      209            skip RETURN-VALUE
      210            skip ERROR-STATUS:GET-MESSAGE (1)
      211         view-as alert-box error.
      212      END.
      213      IF  v-ok
      214      AND v-ID <> 0
      215      THEN DO:
      216         define buffer buf_buf_cd-events      for ub.cd-events .
      217         FIND FIRST buf_buf_cd-events
      218              WHERE buf_buf_cd-events.event-id = v-ID
      219              NO-LOCK
      220              NO-ERROR
      221              .
      222         IF AVAILABLE buf_buf_cd-events
      223         THEN DO:
      224            run enable_UI.
      225            run post_enable_UI.
      226            REPOSITION BROWSE-2 to rowid rowid( buf_buf_cd-events ) no-error.
      227         END.
      228      END.
      229   END.
      230   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      231   DO:
      232      IF AVAILABLE buf_cd-events
      233      THEN DO:
      234         assign
      235            v-ok     = FALSE
      236         .
      237         run ref/cdevened.w ( INPUT parparentproc
      238                            , INPUT v-version
      239                            , INPUT-OUTPUT buf_cd-events.event-id
      240                            , OUTPUT v-ok
      241                            ) NO-ERROR.
      242         IF ERROR-STATUS:ERROR
      243         THEN DO:
      244            message
      245               "Ошибка создания записи"
      246               skip RETURN-VALUE
      247               skip ERROR-STATUS:GET-MESSAGE (1)
      248            view-as alert-box error.
      249         END.
      250         IF v-ok
      251         THEN DO:
      252            BROWSE-2:refresh().
      253         END.
      254      END.
      255   END.
      256   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      257   DO:
      258      IF AVAILABLE buf_cd-events
      259      THEN DO:
      260         ASSIGN
      261            v-ok = FALSE
      262         .
      263         message
      264            "Удалить запись?"
      265            skip buf_cd-events.event-id
      266            skip buf_cd-events.event-name
      267            skip buf_cd-events.event-description
      268            view-as alert-box QUESTION
      269            BUTTONS YES-NO
      270            update v-ok
      271         .
      272         IF v-ok
      273         THEN DO:
      274            run ref/cdevdel.p ( INPUT parparentproc
      275                              , INPUT v-version
      276                              , INPUT buf_cd-events.event-id
      277                              , OUTPUT v-ok
      278                              ) NO-ERROR.
      279            IF ERROR-STATUS:ERROR
      280            THEN DO:
      281               message
      282                  "Ошибка удаления записи"
      283                  skip RETURN-VALUE
      284                  skip ERROR-STATUS:GET-MESSAGE (1)
      285               view-as alert-box error.
      286            END.
      287            IF  v-ok
      288            THEN DO:
      289                  run enable_UI.
      290                  run post_enable_UI.
      291            END.
      292         END.
      293      END.
      294   END.
      295   ON CHOOSE OF b-down IN FRAME Dialog-Frame
      296   DO:
      297      IF v-cntxt-db-num = 0
      298      THEN DO:
      299         run utl/cdevdown.p ( INPUT parparentproc
      300                            , INPUT-OUTPUT v-version
      301                            ) NO-ERROR.
      302         IF ERROR-STATUS:ERROR
      303         THEN DO:
      304            message
      305               RETURN-VALUE
      306               skip
      307            view-as alert-box ERROR.
      308         END.
      309         ELSE DO:
      310            run enable_UI.
      311            run post_enable_UI.
      312         END.
      313      END.
      314   END.
      315   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      316   OR HELP OF FRAME Dialog-Frame
      317   DO:
      318     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\cd-event.w" VIEW-AS ALERT-BOX INFORMATION.
      319   END.
      320   ON CHOOSE OF b-load IN FRAME Dialog-Frame
      321   DO:
      322      IF v-cntxt-db-num = 0
      323      THEN DO:
      324         run utl/cdevload.p ( INPUT parparentproc
      325                            , INPUT-OUTPUT v-version
      326                            ) NO-ERROR.
      327         IF ERROR-STATUS:ERROR
      328         THEN DO:
      329            message
      330               RETURN-VALUE
      331               skip
      332            view-as alert-box ERROR.
      333         END.
      334         ELSE DO:
      335            run enable_UI.
      336            run post_enable_UI.
      337         END.
      338      END.
      339   END.
      340   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      341   DO:
      342      define variable v-ok as logical no-undo .
      343      if not available buf_cd-events then do:
      344         return no-apply.
      345      end.
      346   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      347   define variable v-str-recid2 as character no-undo .
      348   define variable v-num-entry2 as integer   no-undo .
      349   assign
      350     v-str-recid2 = trim( string( recid( buf_cd-events ) , "->>>>>>>>>>>9":U ) )
      351     v-num-entry2 = lookup( v-str-recid2 , rid-list )
      352   .
      353   if v-num-entry2 > 0 then do:
      354     assign
      355       entry( v-num-entry2, rid-list ) = "":U
      356       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      357     .
      358   end.
      359   else do:
      360     assign
      361       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid2
      362     .
      363   end.
      364      v-ok = BROWSE-2:select-next-row ().
      365      v-ok = BROWSE-2:refresh( )  in frame Dialog-Frame.
      366   END.
      367   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      368   DO:
      369      IF AVAILABLE buf_cd-events
      370      AND rid-list = ""
      371      then DO:
      372         assign
      373            rid-list = string( recid( buf_cd-events ) )
      374         .
      375      end.
      376      ASSIGN
      377         p-ok = true
      378      .
      379   END.
      380   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      381   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      382   MAIN-BLOCK:
      383   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      384      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      385      FIND LAST buf_cd-events NO-LOCK NO-ERROR.
      386      IF AVAILABLE buf_cd-events
      387      THEN DO:
      388         ASSIGN
      389            v-version = buf_cd-events.version
      390         .
      391         RELEASE buf_cd-events.
      392         ASSIGN
      393            frame Dialog-Frame:TITLE = SUBSTITUTE("&1, версия &2", frame Dialog-Frame:TITLE, v-version ).
      394         .
      395      END.
      396   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      397     run mainmenu_getcntxt in parparentproc
      398       (output v-cntxt-db-num
      399       ,output v-cntxt-userid
      400       ,output v-cntxt-level
      401       ,output v-cntxt-host-code-obj
      402       ,output v-cntxt-obj-type
      403       ,output v-cntxt-obj-code
      404       ,output v-cntxt-db-num-obj
      405       ,output v-cntxt-is-admin
      406       ) .
      407   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      408   on help of frame Dialog-Frame
      409   do:
      410     run gbl/app_help.p
      411       (input this-procedure :file-name
      412       ,input ''
      413       ,input ?
      414       ) no-error.
      415     if error-status :error then do:
      416       message
      417         "Ошибка при вызове помощи"
      418         error-status :get-message(1)
      419         view-as alert-box .
      420     end.
      421   end.
      422   run minbtn-set in this-procedure .
      423   on choose of b-help in frame Dialog-Frame
      424   do:
      425     apply "help":u to frame Dialog-Frame .
      426   end.
      427   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      428   procedure minbtn-set :
      429       do
      430           on error undo, return error return-value
      431           :
      432           define variable ii              as integer       no-undo .
      433           define variable fh              as widget-handle no-undo .
      434           define variable hh              as widget-handle no-undo .
      435           define variable v-h             as handle        extent 4 no-undo .
      436           define variable v-name-button   as character     no-undo .
      437           define variable v-help-old-x    as decimal       no-undo .
      438           define variable v-help-old-y    as decimal       no-undo .
      439           define variable v-help-old-size as decimal       no-undo .
      440           define variable v-frame-width   as decimal       no-undo .
      441           define variable jj              as integer       no-undo .
      442           do
      443               on error undo, return error
      444               :
      445               assign
      446                   v-frame-width = frame Dialog-Frame:width - 0.3
      447                   fh            = frame Dialog-Frame:first-child
      448                   hh            = fh:first-child
      449                   ii            = 1
      450                   .
      451               do while valid-handle(hh):
      452                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      453                   do:
      454                       case lc(hh:name) :
      455                           when "b-help" then
      456                               do:
      457                                   hh:load-image-up("cmp/b-help.bmp":u) .
      458                                   hh:load-image-down("cmp/b-help.bmp":u) .
      459                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      460                                   hh:TOOLTIP = "Помощь" .
      461                                   v-help-old-x = hh:column .
      462                                   v-help-old-y = hh:row    .
      463                                   v-help-old-size = hh:width .
      464                                   hh:width-chars = 2.5 .
      465                               end.
      466                           when "b-print" then
      467                               do:
      468                                   hh:load-image("cmp/b-print.bmp":u) .
      469                                   hh:TOOLTIP = "Печать" .
      470                                   v-h[ii] = hh:handle .
      471                                   ii = ii + 1 .
      472                                   hh:width-chars = 3 .
      473                               end.
      474                           when "b-history" or
      475                           when "b-hist" then
      476                               do:
      477                                   hh:load-image("cmp/b-hist.bmp":u) .
      478                                   hh:TOOLTIP = "История" .
      479                                   v-h[ii] = hh:handle .
      480                                   ii = ii + 1 .
      481                                   hh:width-chars = 3 .
      482                               end.
      483                           when "b-sch" then
      484                               do:
      485                                   hh:load-image("cmp/b-sch.bmp":u) .
      486                                   hh:TOOLTIP = "Установка Фильтра" .
      487                                   v-h[ii] = hh:handle .
      488                                   ii = ii + 1 .
      489                                   hh:width-chars = 3 .
      490                               end.
      491                           when "b-hist-user" then
      492                               do:
      493                                   hh:load-image("cmp/b-hist.bmp":u) .
      494                                   hh:TOOLTIP = "История пользователя" .
      495                                   ii = ii + 1 .
      496                               end.
      497                       end case.
      498                   end.
      499                   hh = hh:next-sibling.
      500               end.
      501               b-help:column = v-frame-width - b-help:width-chars.
      502               jj = 0.
      503               repeat ii = 4 to 1 by -1 :
      504                   if valid-handle (v-h[ii] ) then
      505                   do:
      506                       jj  = jj + 1 .
      507                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      508                       v-h[ii]:row    = v-help-old-y .
      509                   end.
      510               end.
      511           end.
      512       end.
      513   end procedure.
      514   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      515   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      516   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      517   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      518   define variable v-diasize-current-frame-width  as decimal   no-undo .
      519   define variable v-diasize-current-frame-height as decimal   no-undo .
      520   define variable v-diasize-change-size          as logical   no-undo .
      521   define variable v-diasize-resize-button        as handle    no-undo .
      522   define variable v-diasize-wndmax               as logical   no-undo .
      523   define variable v-diasize-wndstore             as logical   no-undo .
      524   define variable v-diasize-proc-name            as character no-undo .
      525   define variable v-diasize-browse-handle        as handle    no-undo .
      526   define variable v-diasize-browse-number        as integer   no-undo .
      527   define variable v-diasize-need-full-display    as logical   no-undo init false .
      528   define temp-table temp-diasize-handle no-undo
      529     field handle-value  as handle
      530     field save-position as decimal
      531     index xpk is primary unique handle-value
      532     .
      533   define temp-table temp-browse-handle no-undo
      534     field browse-type   as character
      535     field browse-number as integer
      536     field browse-handle as handle
      537     field original-size as decimal
      538     index xpk is primary unique browse-type browse-number
      539     index xie browse-type browse-handle
      540   .
      541   procedure diasize_change-height :
      542     define input  parameter p-change-value  as decimal   no-undo .
      543     define input  parameter p-move-resize   as logical   no-undo .
      544     define variable v-field-group-handle    as handle    no-undo .
      545     define variable v-object-handle         as handle    no-undo .
      546     define variable v-frame-height          as decimal   no-undo .
      547     define variable v-frame-virtual-height  as decimal   no-undo .
      548     define variable v-browse-height         as decimal   no-undo .
      549     define variable v-window-height         as decimal   no-undo .
      550     define variable v-window-virtual-height as decimal   no-undo .
      551     define variable v-change-sign           as integer   no-undo .
      552     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      553     define buffer buf_temp-browse-handle  for temp-browse-handle .
      554     if p-change-value > 0
      555     then do:
      556       if frame Dialog-Frame :height + p-change-value
      557           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      558       then do:
      559         assign
      560           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      561                           - (frame Dialog-Frame :height-chars)
      562         .
      563         if p-change-value <= 0
      564         then do:
      565           run diasize_position-resize-button in this-procedure .
      566           return .
      567         end.
      568       end.
      569     end.
      570     if p-change-value < 0
      571     then do:
      572       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      573       then do:
      574         assign
      575           p-change-value = v-diasize-orig-frame-height
      576                          - (frame Dialog-Frame :height-chars)
      577         .
      578         if p-change-value >= 0
      579         then do:
      580           run diasize_position-resize-button in this-procedure .
      581           return .
      582         end.
      583       end.
      584     end.
      585     if p-change-value >= 0
      586     then do:
      587       assign
      588         v-change-sign = 1
      589       .
      590     end.
      591     else do:
      592       assign
      593         v-change-sign = -1
      594       .
      595     end.
      596     assign
      597       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      598     .
      599     if p-change-value = 0
      600     then do:
      601       run diasize_position-resize-button in this-procedure .
      602       return .
      603     end.
      604     move_block:
      605     do
      606     on error undo move_block, retry move_block
      607     :
      608       if retry
      609       then do:
      610         do
      611         on error undo move_block, leave move_block
      612         :
      613           if p-change-value > 0
      614           then do:
      615             for each buf_temp-diasize-handle
      616             on error undo, next
      617             :
      618               assign
      619                 v-object-handle = buf_temp-diasize-handle.handle-value
      620               .
      621               if v-object-handle <> v-diasize-resize-button
      622               then do:
      623                 assign
      624                   v-object-handle :row = buf_temp-diasize-handle.save-position
      625                 .
      626               end.
      627             end.
      628             assign
      629               v-diasize-browse-handle :height = v-browse-height
      630             .
      631             for each buf_temp-browse-handle
      632               where buf_temp-browse-handle.browse-type = 'height':u
      633             on error undo, next
      634             :
      635               assign
      636                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      637               .
      638             end.
      639             assign
      640               frame Dialog-Frame :height = v-frame-height
      641             .
      642             if frame Dialog-Frame :scrollable = true
      643             then do:
      644               assign
      645                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      646               .
      647             end.
      648             run diasize_position-resize-button in this-procedure .
      649           end.
      650           else do:
      651             if frame Dialog-Frame :scrollable = true
      652             then do:
      653               assign
      654                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      655               .
      656             end.
      657             assign
      658               frame Dialog-Frame :height = v-frame-height
      659             .
      660             assign
      661               v-diasize-browse-handle :height = v-browse-height
      662             .
      663             for each buf_temp-browse-handle
      664               where buf_temp-browse-handle.browse-type = 'height':u
      665             on error undo, next
      666             :
      667               assign
      668                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      669               .
      670             end.
