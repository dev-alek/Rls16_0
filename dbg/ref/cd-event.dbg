     1197         on error undo move_block, retry move_block
     1198         :
     1199           assign
     1200             v-object-handle = buf_temp-diasize-handle.handle-value
     1201           .
     1202           if v-object-handle <> v-diasize-resize-button
     1203           then do:
     1204             assign
     1205               v-object-handle :col = v-object-handle :col + p-change-value
     1206               no-error .
     1207             if error-status :error
     1208             or error-status :get-message(1) <> ""
     1209             then do:
     1210               undo move_block, retry move_block .
     1211             end.
     1212           end.
     1213         end.
     1214       end.
     1215       else do:
     1216         for each buf_temp-diasize-handle
     1217         on error undo move_block, retry move_block
     1218         :
     1219           assign
     1220             v-object-handle = buf_temp-diasize-handle.handle-value
     1221           .
     1222           if v-object-handle <> v-diasize-resize-button
     1223           then do:
     1224             assign
     1225               v-object-handle :col = v-object-handle :col + p-change-value
     1226               no-error .
     1227             if error-status :error
     1228             or error-status :get-message(1) <> ""
     1229             then do:
     1230               undo move_block, retry move_block .
     1231             end.
     1232           end.
     1233         end.
     1234         for each buf_temp-browse-handle
     1235           where buf_temp-browse-handle.browse-type = 'width':u
     1236         on error undo move_block, retry move_block
     1237         :
     1238           assign
     1239             buf_temp-browse-handle.browse-handle :width
     1240               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1241             no-error .
     1242           if error-status :error
     1243           or error-status :get-message(1) <> ""
     1244           then do:
     1245             undo move_block, retry move_block .
     1246           end.
     1247         end.
     1248         assign
     1249           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1250           no-error .
     1251         if error-status :error
     1252         or error-status :get-message(1) <> ""
     1253         then do:
     1254           undo move_block, retry move_block.
     1255         end.
     1256         assign
     1257           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1258         no-error .
     1259         if error-status :error
     1260         or error-status :get-message(1) <> ""
     1261         then do:
     1262           undo move_block, retry move_block.
     1263         end.
     1264         if frame Dialog-Frame :scrollable = true
     1265         then do:
     1266           assign
     1267             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1268           no-error .
     1269           if error-status :error
     1270           or error-status :get-message(1) <> ""
     1271           then do:
     1272             undo move_block, retry move_block.
     1273           end.
     1274         end.
     1275       end.
     1276       if p-move-resize
     1277       then do:
     1278         run diasize_position-resize-button in this-procedure .
     1279       end.
     1280       if v-diasize-wndstore = true
     1281       then do:
     1282         if connected("ub") = true
     1283         then do:
     1284           define variable v-cntxt-db-num        as integer   no-undo .
     1285           define variable v-cntxt-userid        as character no-undo .
     1286           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1287                                             , OUTPUT v-cntxt-userid
     1288                                             ) .
     1289           run gbl/wndsizew.p
     1290             (input  v-cntxt-db-num
     1291             ,input  v-cntxt-userid
     1292             ,input  v-diasize-proc-name
     1293             ,input  'width':u
     1294             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1295             ) .
     1296         end.
     1297       end.
     1298     end.
     1299     assign
     1300       v-diasize-change-size = false
     1301     .
     1302   end procedure.
     1303   procedure diasize_set-width :
     1304     define input  parameter p-new-width  as decimal   no-undo .
     1305     define input  parameter p-move-resize as logical   no-undo .
     1306     do
     1307     on error undo, return error return-value
     1308     :
     1309       run diasize_change-width in this-procedure
     1310         (input  (p-new-width - frame Dialog-Frame :width)
     1311         ,input  p-move-resize
     1312         ) .
     1313     end.
     1314   end procedure.
     1315   procedure diasize_position-resize-button :
     1316     do with frame Dialog-Frame
     1317     :
     1318       hide v-diasize-resize-button .
     1319       assign
     1320         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1321                     - 1
     1322                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1323         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1324                     - 1
     1325                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1326       .
     1327       view v-diasize-resize-button .
     1328     end.
     1329   end procedure.
     1330   on alt-right anywhere
     1331   do:
     1332     run diasize_change-width in this-procedure
     1333       (input 1
     1334       ,input true
     1335       ) .
     1336     return no-apply .
     1337   end.
     1338   on alt-left anywhere
     1339   do:
     1340     run diasize_change-width in this-procedure
     1341       (input -1
     1342       ,input true
     1343       ) .
     1344     return no-apply .
     1345   end.
     1346   on alt-down anywhere
     1347   do:
     1348     run diasize_change-height in this-procedure
     1349       (input 1
     1350       ,input true
     1351       ) .
     1352     return no-apply .
     1353   end.
     1354   on alt-up anywhere
     1355   do:
     1356     run diasize_change-height in this-procedure
     1357       (input -1
     1358       ,input true
     1359       ) .
     1360     return no-apply .
     1361   end.
     1362   on alt-enter of frame Dialog-Frame
     1363   do:
     1364     run diasize_maximize in this-procedure
     1365       (input  ?
     1366       ).
     1367     return no-apply .
     1368   end.
     1369   procedure diasize_end-move :
     1370     do
     1371     on error undo, return error return-value
     1372     :
     1373       define variable v-row-delta as decimal   no-undo .
     1374       define variable v-col-delta as decimal   no-undo .
     1375       define variable v-new-row as decimal   no-undo .
     1376       define variable v-new-col as decimal   no-undo .
     1377       assign
     1378         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1379         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1380       .
     1381       assign
     1382         v-row-delta = v-new-row - frame Dialog-Frame :height
     1383         v-col-delta = v-new-col - frame Dialog-Frame :width
     1384       .
     1385       run diasize_change-height in this-procedure
     1386         (input v-row-delta
     1387         ,input true
     1388         ) .
     1389       run diasize_change-width in this-procedure
     1390         (input v-col-delta
     1391         ,input true
     1392         ) .
     1393     end.
     1394   end procedure.
     1395   procedure diasize_maximize :
     1396     define input  parameter p-action as logical   no-undo .
     1397     do
     1398     on error undo, return error return-value
     1399     :
     1400       if p-action = ?
     1401       then do:
     1402         if v-diasize-need-maximize = true
     1403         then do:
     1404           assign
     1405             p-action = true
     1406           .
     1407         end.
     1408         else do:
     1409           assign
     1410             p-action = false
     1411           .
     1412         end.
     1413       end.
     1414       if p-action = true
     1415       then do:
     1416         run diasize_change-height in this-procedure
     1417           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1418               - frame Dialog-Frame :height-chars
     1419           ,input true
     1420           ) .
     1421         run diasize_change-width in this-procedure
     1422           (input session :width-chars
     1423               - frame Dialog-Frame :width-chars
     1424           ,input true
     1425           ) .
     1426         assign
     1427           v-diasize-need-maximize = false
     1428         .
     1429       end.
     1430       else do:
     1431         run diasize_change-width in this-procedure
     1432           (input v-diasize-orig-frame-width
     1433               - frame Dialog-Frame :width-chars
     1434           ,input true
     1435           ) .
     1436         run diasize_change-height in this-procedure
     1437           (input v-diasize-orig-frame-height
     1438               - frame Dialog-Frame :height-chars
     1439           ,input true
     1440           ) .
     1441         assign
     1442           v-diasize-need-maximize = true
     1443         .
     1444       end.
     1445     end.
     1446   end procedure.
     1447   procedure diasize_restore-orig-size :
     1448     do
     1449     on error undo, return error return-value
     1450     :
     1451       assign
     1452         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1453         v-diasize-current-frame-height = frame Dialog-Frame :height
     1454       .
     1455       run diasize_set-height in this-procedure
     1456         (input  v-diasize-orig-frame-height
     1457         ,input  true
     1458         ) .
     1459       run diasize_set-width in this-procedure
     1460         (input  v-diasize-orig-frame-width
     1461         ,input  true
     1462         ) .
     1463     end.
     1464   end procedure.
     1465   procedure diasize_restore-current-size :
     1466     do
     1467     on error undo, return error return-value
     1468     :
     1469       run diasize_set-height in this-procedure
     1470         (input  v-diasize-current-frame-height
     1471         ,input  true
     1472         ) .
     1473       run diasize_set-width in this-procedure
     1474         (input  v-diasize-current-frame-width
     1475         ,input  true
     1476         ) .
     1477     end.
     1478   end procedure.
     1479   procedure diasize_set-browse-handle :
     1480     define input  parameter p-browse-handle as handle   no-undo .
     1481     define buffer buf_temp-browse-handle for temp-browse-handle .
     1482     do
     1483     on error undo, return error return-value
     1484     :
     1485       assign
     1486         v-diasize-browse-handle = p-browse-handle
     1487       .
     1488       for each buf_temp-browse-handle
     1489       on error undo, return error return-value
     1490       :
     1491         delete buf_temp-browse-handle .
     1492       end.
     1493     end.
     1494   end procedure.
     1495   procedure diasize_add_browse :
     1496     define input  parameter p-browse-type   as character no-undo .
     1497     define input  parameter p-browse-handle as handle    no-undo .
     1498     define buffer buf_temp-browse-handle for temp-browse-handle .
     1499     do
     1500     on error undo, return error return-value
     1501     :
     1502       assign
     1503         v-diasize-browse-number = v-diasize-browse-number + 1
     1504       .
     1505       create buf_temp-browse-handle .
     1506       assign
     1507         buf_temp-browse-handle.browse-type   = p-browse-type
     1508         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1509         buf_temp-browse-handle.browse-handle = p-browse-handle
     1510       .
     1511     end.
     1512   end procedure.
     1513   procedure diasize_init :
     1514     define variable v-default-value    as logical   no-undo .
     1515     define variable v-restore-saved    as logical   no-undo .
     1516     define variable v-resize-value-str as character no-undo .
     1517     do
     1518     on error undo, return error return-value
     1519     :
     1520       do with frame Dialog-Frame
     1521       :
     1522         assign
     1523           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1524           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1525           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1526         .
     1527         create button v-diasize-resize-button
     1528         assign
     1529           parent        = frame Dialog-Frame :first-child
     1530           label         = "s"
     1531           height-pixels = 16
     1532           width-pixels  = 16
     1533           visible       = true
     1534           sensitive     = true
     1535           movable       = true
     1536           triggers:
     1537             on end-move persistent run diasize_end-move in this-procedure .
     1538           end triggers.
     1539         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1540         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1541         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1542         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1543         assign
     1544           v-diasize-wndmax = false
     1545         .
     1546         if connected("ub") = true
     1547         then do:
     1548           define variable v-cntxt-db-num        as integer   no-undo .
     1549           define variable v-cntxt-userid        as character no-undo .
     1550           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1551                                             , OUTPUT v-cntxt-userid
     1552                                             ) .
     1553           run gbl/wndpar_r.p
     1554             (input  v-cntxt-db-num
     1555             ,input  v-cntxt-userid
     1556             ,input  'wndmax':U
     1557             ,output v-diasize-wndmax
     1558             ,output v-default-value
     1559             ) .
     1560         end.
     1561         assign
     1562           v-diasize-wndstore = false
     1563         .
     1564         if connected("ub") = true
     1565         then do:
     1566           run gbl/wndpar_r.p
     1567             (input  v-cntxt-db-num
     1568             ,input  v-cntxt-userid
     1569             ,input  'wndstore':U
     1570             ,output v-diasize-wndstore
     1571             ,output v-default-value
     1572             ) .
     1573         end.
     1574         assign
     1575           v-diasize-proc-name = entry(1, program-name(2), '.')
     1576         .
     1577         if v-diasize-wndstore = true
     1578         then do:
     1579           assign
     1580             v-restore-saved = false
     1581           .
     1582           if connected("ub") = true
     1583           then do:
     1584             run gbl/wndsizer.p
     1585               (input  v-cntxt-db-num
     1586               ,input  v-cntxt-userid
     1587               ,input  v-diasize-proc-name
     1588               ,input  'height':u
     1589               ,output v-resize-value-str
     1590               ) .
     1591             if v-resize-value-str <> '':U
     1592             then do:
     1593               run diasize_change-height in this-procedure
     1594                 (input  integer(v-resize-value-str)
     1595                 ,input  true
     1596                 ) .
     1597               assign
     1598                 v-restore-saved = true
     1599               .
     1600             end.
     1601           end.
     1602           if connected("ub") = true
     1603           then do:
     1604             run gbl/wndsizer.p
     1605               (input  v-cntxt-db-num
     1606               ,input  v-cntxt-userid
     1607               ,input  v-diasize-proc-name
     1608               ,input  'width':u
     1609               ,output v-resize-value-str
     1610               ) .
     1611             if v-resize-value-str <> '':U
     1612             then do:
     1613               run diasize_change-width in this-procedure
     1614                 (input  integer(v-resize-value-str)
     1615                 ,input  true
     1616                 ) .
     1617               assign
     1618                 v-restore-saved = true
     1619               .
     1620             end.
     1621           end.
     1622           if v-restore-saved <> true
     1623           then do:
     1624             if v-diasize-wndmax = true
     1625             then do:
     1626               run diasize_maximize in this-procedure
     1627                 (input  true
     1628                 ) .
     1629             end.
     1630           end.
     1631         end.
     1632         else do:
     1633           if v-diasize-wndmax = true
     1634           then do:
     1635             run diasize_maximize in this-procedure
     1636               (input  true
     1637               ) .
     1638           end.
     1639         end.
     1640       end.
     1641     end.
     1642   end procedure.
     1643   procedure diasize_need-full-display :
     1644     define output parameter p-need-full-display as logical   no-undo .
     1645     do
     1646     on error undo, return error return-value
     1647     :
     1648       assign
     1649         p-need-full-display = v-diasize-need-full-display
     1650       .
     1651       assign
     1652         v-diasize-need-full-display = false
     1653       .
     1654     end.
     1655   end procedure.
     1656   procedure get-context :
     1657      define output parameter p-db-num as integer          no-undo.
     1658      define output parameter p-user-id as character        no-undo.
     1659      define variable v-login               as character    no-undo.
     1660      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1661      define buffer buf_user-login  for ub.user-login .
     1662      do
     1663      on error undo, return error
     1664      :
     1665            FIND FIRST buf_sys-ctrl no-lock.
     1666            ASSIGN
     1667               v-login = USERID("ub")
     1668               p-db-num = buf_sys-ctrl.db-num
     1669            .
     1670            FIND FIRST buf_user-login
     1671                 WHERE buf_user-login.db-num = p-db-num
     1672                   AND buf_user-login.user-login = v-login
     1673                 no-lock
     1674                 no-error
     1675                 .
     1676            IF AVAILABLE buf_user-login
     1677            THEN DO:
     1678               assign
     1679                  p-user-id = buf_user-login.user-id
     1680               .
     1681            END.
     1682      end.
     1683   end procedure.
     1684       run diasize_init in this-procedure .
     1685      run enable_UI.
     1686      run post_enable_UI.
     1687      WAIT-FOR GO OF FRAME Dialog-Frame.
     1688   END.
     1689   run disable_UI.
     1690   PROCEDURE disable_UI :
     1691     HIDE FRAME Dialog-Frame.
     1692   END PROCEDURE.
     1693   PROCEDURE enable_UI :
     1694     ENABLE b-quit b-mark b-sel b-add b-chg b-del b-load b-down b-help BROWSE-2
     1695         WITH FRAME Dialog-Frame.
     1696     VIEW FRAME Dialog-Frame.
     1697     OPEN QUERY BROWSE-2 FOR EACH buf_cd-events NO-LOCK INDEXED-REPOSITION.
     1698   END PROCEDURE.
     1699   PROCEDURE Post_enable_UI :
     1700      DISABLE
     1701         b-sel
     1702         b-mark
     1703         b-load
     1704         b-down
     1705         b-chg
     1706         b-del
     1707         b-add
     1708      WITH FRAME Dialog-Frame.
     1709      ENABLE
     1710         b-sel  WHEN (( lookup  ( "b-sel":U  , p-bttns) > 0 ) OR  ( lookup  ( "b-mark":U , p-bttns) > 0 ))
     1711         b-mark WHEN (  lookup  ( "b-mark":U , p-bttns) > 0 )
     1712         b-load WHEN (( lookup  ( "b-add":U , p-bttns) > 0 ) AND ( v-cntxt-db-num = 0 ))
     1713         b-down WHEN (( lookup  ( "b-add":U , p-bttns) > 0 ) AND ( v-cntxt-db-num = 0 ))
     1714         b-chg  WHEN (( lookup  ( "b-add":U , p-bttns) > 0 ) AND ( v-cntxt-db-num = 0 ))
     1715         b-del  WHEN (( lookup  ( "b-add":U , p-bttns) > 0 ) AND ( v-cntxt-db-num = 0 ))
     1716         b-add  WHEN (( lookup  ( "b-add":U , p-bttns) > 0 ) AND ( v-cntxt-db-num = 0 ))
     1717      WITH FRAME Dialog-Frame.
     1718   END PROCEDURE.
