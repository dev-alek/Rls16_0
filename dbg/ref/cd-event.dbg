     1145         .
     1146       end.
     1147       do with frame Dialog-Frame
     1148       :
     1149         hide v-diasize-resize-button .
     1150         v-diasize-resize-button :row = 1.
     1151         v-diasize-resize-button :column = 1.
     1152       end.
     1153       if p-change-value > 0
     1154       then do:
     1155         if frame Dialog-Frame :scrollable = true
     1156         then do:
     1157           assign
     1158             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1159             no-error .
