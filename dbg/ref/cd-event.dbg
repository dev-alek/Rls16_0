     1119           and can-query(v-object-handle, "height")
     1120           and ( v-object-handle :col + v-object-handle :width
     1121                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1122               )
     1123           then do:
     1124             find first buf_temp-browse-handle
     1125               where buf_temp-browse-handle.browse-type   = 'width':u
     1126                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1127               no-error .
     1128             if available buf_temp-browse-handle
     1129             then do:
     1130             end.
     1131             else do:
     1132               create buf_temp-diasize-handle .
     1133               assign
     1134                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1135                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1136               .
     1137             end.
     1138           end.
     1139           assign
     1140             v-object-handle = v-object-handle :next-sibling
     1141           .
     1142         end.
