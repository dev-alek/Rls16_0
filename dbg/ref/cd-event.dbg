     1164           end.
     1165         end.
     1166         assign
     1167           frame Dialog-Frame :width = v-frame-width + p-change-value
     1168           no-error .
     1169         if error-status :error
     1170         or error-status :get-message(1) <> ""
     1171         then do:
     1172           undo move_block, retry move_block.
     1173         end.
     1174         assign
     1175           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1176         no-error .
     1177         if error-status :error
     1178         or error-status :get-message(1) <> ""
     1179         then do:
     1180           undo move_block, retry move_block.
     1181         end.
     1182         for each buf_temp-browse-handle
     1183           where buf_temp-browse-handle.browse-type = 'width':u
     1184         on error undo move_block, retry move_block
     1185         :
     1186           assign
     1187             buf_temp-browse-handle.browse-handle :width
     1188               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1189             no-error .
     1190           if error-status :error
     1191           or error-status :get-message(1) <> ""
     1192           then do:
     1193             undo move_block, retry move_block .
