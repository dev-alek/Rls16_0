      727         .
      728         do while valid-handle(v-object-handle)
      729         :
      730           if  v-object-handle <> v-diasize-browse-handle :handle
      731           and can-query(v-object-handle, "row")
      732           and can-query(v-object-handle, "height")
      733           and ( v-object-handle :row > v-diasize-browse-handle :row )
      734           then do:
      735             find first buf_temp-browse-handle
      736               where buf_temp-browse-handle.browse-type   = 'height':u
      737                 and buf_temp-browse-handle.browse-handle = v-object-handle
      738               no-error .
      739             if available buf_temp-browse-handle
      740             then do:
      741             end.
      742             else do:
      743               create buf_temp-diasize-handle .
      744               assign
      745                 buf_temp-diasize-handle.handle-value  = v-object-handle
      746                 buf_temp-diasize-handle.save-position = v-object-handle :row
      747               .
      748             end.
      749           end.
      750           assign
      751             v-object-handle = v-object-handle :next-sibling
      752           .
      753         end.
      754         assign
      755           v-field-group-handle = v-field-group-handle :next-sibling
      756         .
      757       end.
      758       do with frame Dialog-Frame
      759       :
      760         hide v-diasize-resize-button .
      761         assign
      762           v-diasize-resize-button :row    = 1
      763           v-diasize-resize-button :column = 1
      764         .
      765       end.
      766       if p-change-value > 0
      767       then do:
      768         if frame Dialog-Frame :scrollable = true
      769         then do:
      770           assign
      771             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      772             no-error .
      773           if error-status :error
      774           or error-status :get-message(1) <> ""
      775           then do:
      776             undo move_block, retry move_block .
      777           end.
      778         end.
      779         assign
      780           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      781           no-error .
      782         if error-status :error
      783         or error-status :get-message(1) <> ""
      784         then do:
