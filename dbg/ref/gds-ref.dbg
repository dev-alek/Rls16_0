      180               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      181                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      182               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      183         otherwise do:
      184           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
      185         end.
      186       end CASE.
      187     end.
      188   end procedure.
      189   procedure uf-get :
      190     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      191     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      192     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      193     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      194     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      195     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      196     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      197     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      198     do
      199     on error undo, return error
      200     :
      201       define buffer buf_usr-flt for ubflt.usr-flt .
      202       define variable v-use-List_     as logical   no-undo .
      203       define variable v-type-List_     as character no-undo .
      204       define variable v-format-List_   as character no-undo .
      205       define variable v-use-Naim      as logical   no-undo .
      206       define variable v-type-Naim      as character no-undo .
      207       define variable v-format-Naim    as character no-undo .
      208       define variable v-use-print-graft as logical   no-undo .
      209       define variable v-use-sort-gr     as logical   no-undo .
      210       define variable v-use-type-price  as logical   no-undo .
      211       define variable v-use-type-val    as logical   no-undo .
      212       define variable v-label          as character no-undo .
      213       define variable v-tooltip        as character no-undo .
      214       define variable v-user-can-edit  as logical   no-undo .
      215       define variable v-output-display as logical   no-undo .
      216       define variable v-other          as character no-undo .
      217       run uf-name in this-procedure
      218          (input  entry(1, p-code, chr(4))
      219         ,output v-use-List_
      220         ,output v-type-List_
      221         ,output v-format-List_
      222         ,output v-use-Naim
      223         ,output v-type-Naim
      224         ,output v-format-Naim
      225         ,output v-use-print-graft
      226         ,output v-use-sort-gr
      227         ,output v-use-type-price
      228         ,output v-use-type-val
      229         ,output v-label
      230         ,output v-tooltip
      231         ,output v-user-can-edit
      232         ,output v-output-display
      233         ,output v-other
      234         ) no-error .
      235       if error-status :error then do:
      236         undo, return error return-value .
      237       end.
      238       find first buf_usr-flt no-lock where
      239                  buf_usr-flt.Call-point     = p-code AND
      240                  buf_usr-flt.user-name       = p-user-name
      241         no-error .
      242       if avail buf_usr-flt then do:
      243         assign
      244         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      245         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      246         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      247         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      248         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      249         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      250         .
      251       end.
      252       else do:
      253         assign
      254         p-List_        = (if v-use-List_       then "":U                    else ?)
      255         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      256         p-print-graft  = (if v-use-print-graft then no                      else ?)
      257         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      258         p-type-price   = (if v-use-type-price  then no                      else ?)
      259         p-type-val     = (if v-use-List_       then no                      else ?)
      260         .
      261       end.
      262     end.
      263   end procedure.
      264   procedure uf-set :
      265     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      266     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      267     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      268     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      269     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      270     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      271     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      272     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      273     do
      274     on error undo, return error
      275     :
      276       define buffer buf_usr-flt for ubflt.usr-flt .
      277       define variable v-use-List_     as logical   no-undo .
      278       define variable v-type-List_     as character no-undo .
      279       define variable v-format-List_   as character no-undo .
      280       define variable v-use-Naim      as logical   no-undo .
      281       define variable v-type-Naim      as character no-undo .
      282       define variable v-format-Naim    as character no-undo .
      283       define variable v-use-print-graft as logical   no-undo .
      284       define variable v-use-sort-gr   as logical   no-undo .
      285       define variable v-use-type-price as logical   no-undo .
      286       define variable v-use-type-val  as logical   no-undo .
      287       define variable v-tooltip        as character no-undo .
      288       define variable v-label          as character no-undo .
      289       define variable v-user-can-edit  as logical   no-undo .
      290       define variable v-output-display as logical   no-undo .
      291       define variable v-other          as character no-undo .
      292       run uf-name in this-procedure
      293         (input  entry(1, p-code, chr(4))
      294         ,output v-use-List_
      295         ,output v-type-List_
      296         ,output v-format-List_
      297         ,output v-use-Naim
      298         ,output v-type-Naim
      299         ,output v-format-Naim
      300         ,output v-use-print-graft
      301         ,output v-use-sort-gr
      302         ,output v-use-type-price
      303         ,output v-use-type-val
      304         ,output v-label
      305         ,output v-tooltip
      306         ,output v-user-can-edit
      307         ,output v-output-display
      308         ,output v-other
      309         ) no-error .
      310       if error-status :error then do:
      311         undo, return error return-value .
      312       end.
      313       find first buf_usr-flt where
      314                  buf_usr-flt.Call-point     = p-code AND
      315                  buf_usr-flt.user-name       = p-user-name
      316         no-error .
      317       if not avail buf_usr-flt then do:
      318           create buf_usr-flt .
      319           assign
      320           buf_usr-flt.call-point = p-code
      321           buf_usr-flt.user-name  = p-user-name
      322           .
      323       end.
      324       if avail buf_usr-flt then do:
      325        assign
      326        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      327        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      328        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      329        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      330        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      331        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      332       .
      333       release buf_usr-flt.
      334       end.
      335       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      336     end.
      337   end procedure.
      338   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      339     define variable v-cntxt-db-num        as integer   no-undo .
      340     define variable v-cntxt-userid        as character no-undo .
      341     define variable v-cntxt-level         as character no-undo .
      342     define variable v-cntxt-host-code-obj as integer   no-undo .
      343     define variable v-cntxt-obj-type      as character no-undo .
      344     define variable v-cntxt-obj-code      as integer   no-undo .
      345     define variable v-cntxt-db-num-obj    as integer   no-undo .
      346     define variable v-cntxt-is-admin      as logical   no-undo .
      347   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      348   define temp-table userobjs_temp-user-obj no-undo
      349     field obj-type as character
      350     field obj-code as integer
      351     index xpk is primary unique obj-type obj-code
      352     .
      353   procedure userobjs_clear :
      354     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      355     do
      356     on error undo, return error return-value
      357     :
      358       for each buf_userobjs_temp-user-obj
      359       on error undo, return error return-value
      360       :
      361         delete buf_userobjs_temp-user-obj .
      362       end.
      363     end.
      364   end .
      365   procedure userobjs_object-count :
      366     define output parameter p-total-count as integer   no-undo .
      367     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      368     do
      369     on error undo, return error return-value
      370     :
      371       assign
      372         p-total-count = 0
      373       .
      374       for each buf_userobjs_temp-user-obj
      375       on error undo, return error return-value
      376       :
      377         assign
      378           p-total-count = p-total-count + 1
      379         .
      380       end.
      381     end.
      382   end.
      383   procedure userobjs_append :
      384      define input  parameter p-obj-type as character no-undo .
      385      define input  parameter p-obj-code as integer   no-undo .
      386     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      387     do
      388     on error undo, return error return-value
      389     :
      390       find first buf_userobjs_temp-user-obj
      391         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      392           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      393         no-error .
      394       if not available buf_userobjs_temp-user-obj
      395       then do:
      396         create buf_userobjs_temp-user-obj .
      397         assign
      398           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      399           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      400         .
      401       end.
      402     end.
      403   end.
      404   procedure userobjs_object-exist :
      405     define output parameter p-object-exist as logical   no-undo .
      406     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      407     do
      408     on error undo, return error return-value
      409     :
      410       find first buf_userobjs_temp-user-obj
      411         no-error .
      412       if not available buf_userobjs_temp-user-obj
      413       then do:
      414         assign
      415           p-object-exist = false
      416         .
      417       end.
      418       else do:
      419         assign
      420           p-object-exist = true
      421         .
      422       end.
      423     end.
      424   end.
      425   procedure userobjs_transfer :
      426     define input  parameter p-callback-handle as handle no-undo .
      427     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      428     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      429     do
      430     on error undo, return error return-value
      431     :
      432       if valid-handle(p-callback-handle) <> true
      433       then do:
      434         message
      435           vss-workfile vss-revision vss-description skip
      436           "Ошибка задания входных параметров" skip
      437           "Неизвестный указатель на процедуру" skip
      438           view-as alert-box error .
      439         undo, return error return-value .
      440       end.
      441       if p-callback-handle :get-signature("userobjs_append") = ""
      442       then do:
      443         message
      444           vss-workfile vss-revision vss-description skip
      445           "Ошибка задания входных параметров" skip
      446           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      447                     ,p-callback-handle :file-name
      448                     ) skip
      449           view-as alert-box error .
      450         undo, return error return-value .
      451       end.
      452       for each buf_userobjs_temp-user-obj
      453       on error undo, return error return-value
      454       :
      455         run userobjs_append in p-callback-handle
      456           (input  buf_userobjs_temp-user-obj.obj-type
      457           ,input  buf_userobjs_temp-user-obj.obj-code
      458           ) .
      459       end.
      460     end.
      461   end procedure.
      462   procedure userobjs_select-one :
      463      define input  parameter parparentproc     as widget-handle no-undo .
      464      define input  parameter p-db-num          as integer   no-undo .
      465      define input  parameter p-user-id         as character no-undo .
      466      define input  parameter p-host-code-obj   as integer   no-undo .
      467      define input  parameter p-obj-type        as character no-undo .
      468      define input  parameter p-obj-code        as integer   no-undo .
      469      define output parameter p-user-select     as logical   no-undo .
      470      define output parameter p-select-obj-type as character no-undo .
      471      define output parameter p-select-obj-code as character no-undo .
      472     do
      473     on error undo, return error return-value
      474     :
      475       run gbl/userobjs.w
      476         (input  parparentproc
      477         ,input  this-procedure :handle
      478         ,input  p-db-num
      479         ,input  p-user-id
      480         ,input  p-host-code-obj
      481         ,input  p-obj-type
      482         ,input  p-obj-code
      483         ,INPUT  "b-sel"
      484         ,output p-user-select
