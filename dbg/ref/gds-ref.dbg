      490   procedure userobjs_select-many :
      491     define input  parameter parparentproc   as widget-handle no-undo .
      492     define input  parameter p-db-num        as integer   no-undo .
      493     define input  parameter p-user-id       as character no-undo .
      494     define input  parameter p-host-code-obj as integer   no-undo .
      495     define input  parameter p-obj-type      as character no-undo .
      496     define input  parameter p-obj-code      as integer   no-undo .
      497     define output parameter p-user-select   as logical   no-undo .
      498     define variable v-select-obj-type as character no-undo .
      499     define variable v-select-obj-code as integer   no-undo .
      500     do
      501     on error undo, return error return-value
      502     :
      503       run gbl/userobjs.w
      504         (input  parparentproc
      505         ,input  this-procedure :handle
      506         ,input  p-db-num
      507         ,input  p-user-id
      508         ,input  p-host-code-obj
      509         ,input  p-obj-type
      510         ,input  p-obj-code
