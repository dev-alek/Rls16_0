        1   block-level on error undo, throw.
        2   define input  parameter parparentproc as widget-handle no-undo.
        3   define input  parameter bttns         as character no-undo.
        4   define input  parameter p-stat        as character no-undo .
        5   define input  parameter p-list        as character no-undo .
        6   define input  parameter p-cond        as character no-undo .
        7   define input  parameter p-rec         as recid     no-undo .
        8   define input  parameter p-grp         like ub.goods.grp-name   no-undo .
        9   define input  parameter p-cli-type    like ub.clients.obj-type no-undo .
       10   define input  parameter p-cli-code    like ub.clients.obj-code no-undo .
       11   define input  parameter p-obj-type    like ub.clients.obj-type no-undo .
       12   define input  parameter p-obj-code    like ub.clients.obj-code no-undo .
       13   define input  parameter p-other       as character no-undo .
       14   define output parameter rid-list      as character no-undo .
       15   define variable vss-revision    as character no-undo initial "$Revision: b1f216c91d59, 3334, rls $":U .
       16   define variable vss-author      as character no-undo initial "$Author: SSlivenko $":U .
       17   define variable vss-date        as character no-undo initial "$Date: 2023/05/19 13:37:09 $":U .
       18   define variable vss-workfile    as character no-undo initial "$Workfile: gds-ref.p $":U .
       19   define variable vss-archive     as character no-undo initial "$Archive: ref/gds-ref.p $":U .
       20   define variable vss-description as character no-undo initial "Справочник товаров и товаров на объекте".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39       assign
       40         p-vss-parameters = substitute('&1|&2':u,substitute('&1|&2|&3|&4|&5|&6':u,parparentproc,bttns,p-stat,p-list,p-cond,p-rec),substitute('&1|&2|&3|&4|&5|&6':u,p-grp,p-cli-type,p-cli-code,p-obj-type,p-obj-code,p-other))
       41       .
       42   end procedure.
       43   define new global shared variable g#vssrevis-logger as handle    no-undo .
       44   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       45   define variable v-vssrevis-logger                   as handle    no-undo .
       46   procedure vss-logevent :
       47     define input  parameter p-extra-paramters as character no-undo .
       48     define variable v-vssrevis-parameters as character no-undo .
       49     do
       50     on error undo, return error return-value
       51     :
       52       if  valid-handle(v-vssrevis-logger)
       53       and v-vssrevis-logger :get-signature("logevent") <> ""
       54       then do:
       55         run vss-get-parameters in this-procedure
       56           (output v-vssrevis-parameters
       57           ).
       58         run logevent in v-vssrevis-logger
       59           (input vss-workfile
       60           ,input vss-revision
       61           ,input v-vssrevis-parameters
       62           ,input p-extra-paramters
       63           ).
       64       end.
       65     end.
       66   end procedure.
       67   assign
       68     v-vssrevis-logger = g#vssrevis-logger
       69   .
       70   if  valid-handle(v-vssrevis-logger)
       71   and v-vssrevis-logger :get-signature("logevent") <> ""
       72   then do:
       73     assign
       74       v-vssrevis-logevent = true
       75     .
       76     run vss-logevent in this-procedure (input vss-description) .
       77   end.
       78   define new global shared variable g#language as character no-undo .
       79   if g#language <> '' and g#language <> 'rus':U then do:
       80     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       81   end.
       82   define new global shared variable g#library  as handle no-undo .
       83   define new global shared variable g#library2 as handle no-undo .
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
       86   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
       87   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
       88   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
       89   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
       90   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
       91   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
       92   procedure uf-name :
       93     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
       94     define output parameter p-use-List_     as logical   no-undo .
       95     define output parameter p-type-List_     as character no-undo .
       96     define output parameter p-format-List_   as character no-undo .
       97     define output parameter p-use-Naim      as logical   no-undo .
       98     define output parameter p-type-Naim      as character no-undo .
       99     define output parameter p-format-Naim    as character no-undo .
      100     define output parameter p-use-print-graft as logical   no-undo .
      101     define output parameter p-use-sort-gr   as logical   no-undo .
      102     define output parameter p-use-type-price as logical   no-undo .
      103     define output parameter p-use-type-val  as logical   no-undo .
      104     define output parameter p-label          as character no-undo .
      105     define output parameter p-tooltip        as character no-undo .
      106     define output parameter p-user-can-edit  as logical   no-undo .
      107     define output parameter p-output-display as logical   no-undo .
      108     define output parameter p-other          as character no-undo .
      109     do
      110     on error undo, return error
      111     :
      112       case p-code :
      113               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
