      518   procedure thobjs :
      519      define input        parameter parparentproc     as widget-handle no-undo .
      520      define input        parameter i-bttns           as character     no-undo .
      521      define input        parameter i-list-mode       as character     no-undo.
      522      define input        parameter i-obj-type        as character     no-undo.
      523      define input        parameter i-db-num          as integer       no-undo.
      524      define input        parameter i-host-code       as integer       no-undo.
      525      define input-output parameter p-rid-list        as character     no-undo .
      526   run ref/thobjs.p
      527           ( input parparentproc
      528            ,input  this-procedure :handle
      529           , input i-bttns
      530           , input i-list-mode
      531           , input i-obj-type
      532           , input i-db-num
      533           , input i-host-code
      534           , input-output p-rid-list ) no-error .
      535   end.
      536   define variable v-stat as character no-undo init 'текущие':U.
      537   define variable v-list as character no-undo init 'все':U.
      538   define variable v-cond as character no-undo init 'все':U.
      539   define variable v-rep  as recid     no-undo init ?.
      540   define variable v-grp  like ub.goods.grp-name no-undo init "":U.
      541   define variable v-producer-type like ub.clients.obj-type no-undo init "":U.
      542   define variable v-producer-code  like ub.clients.obj-code no-undo init 0.
      543   define variable v-obj-type like ub.clients.obj-type no-undo init ?.
      544   define variable v-obj-code like ub.clients.obj-code no-undo init ?.
      545   define variable v-other as character no-undo .
      546   define variable v-no-obj as logical no-undo .
      547   define variable v-gds-name-width as decimal no-undo init 31.
      548   define variable v-grp-name-width as decimal no-undo init 60.
      549   DEF new shared VAR sch-rec AS recid no-undo.
      550   DEF new shared VAR loc-art AS CHAR no-undo.
      551   DEF new shared VAR loc-name AS CHAR no-undo.
      552   DEF new shared VAR loc-code AS CHAR no-undo.
      553   DEF new shared VAR a-n-c AS CHAR no-undo.
      554   define buffer buf_clients  for ub.clients .
      555   rid-list = "".
      556   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      557     run mainmenu_getcntxt in parparentproc
      558       (output v-cntxt-db-num
      559       ,output v-cntxt-userid
      560       ,output v-cntxt-level
      561       ,output v-cntxt-host-code-obj
      562       ,output v-cntxt-obj-type
      563       ,output v-cntxt-obj-code
      564       ,output v-cntxt-db-num-obj
      565       ,output v-cntxt-is-admin
      566       ) .
      567   run uf-get in this-procedure(
      568       input  'gds-ref-p':U
      569       ,input  v-cntxt-userid
      570       ,output v-uf-List_
      571       ,output v-uf-Naim
      572       ,output v-uf-print-graft
      573       ,output v-uf-sort-gr
      574       ,output v-uf-type-price
      575       ,output v-uf-type-val
      576   )  no-error.
      577   if not error-status:error
      578   and num-entries(v-uf-List_, chr(4)) = 8
      579   then do:
      580     assign
      581     v-stat       = entry(1, v-uf-List_, chr(4))
      582     v-list       = entry(2, v-uf-List_, chr(4))
      583     v-cond       = entry(3, v-uf-List_, chr(4))
      584     v-rep        = (if entry(4, v-uf-List_, chr(4)) = chr(63)
      585                     then ?
      586                     else integer(entry(4, v-uf-List_, chr(4)))
      587                     )
      588     v-grp        = entry(5, v-uf-List_, chr(4))
      589     v-producer-type   = entry(6, v-uf-List_, chr(4))
      590     v-producer-code   = integer(entry(7, v-uf-List_, chr(4)))
      591     v-other      = entry(8, v-uf-List_, chr(4))
      592     no-error
      593     .
      594     if v-list = "ptrl"
      595     or v-list = "lgas"
      596     or v-list = "ptrlsug"
      597     or v-list = "only-np"
      598     then do:
      599       entry(2, v-uf-list_,  chr(4) ) = 'все':U.
      600       v-list =  'все':U.
      601     end.
      602     if num-entries(v-uf-Naim, chr(4)) >=4 then do:
      603       assign
      604       v-gds-name-width = decimal(entry(3, v-uf-naim,  chr(4)))
      605       v-grp-name-width = decimal(entry(4, v-uf-naim, chr(4)))
      606       no-error .
      607     end.
      608   end.
      609   assign
      610   p-stat      = (if p-stat = ? then v-stat else p-stat)
      611   p-list      = (if p-list = ? then v-list else p-list)
      612   p-cond      = (if p-cond = ? then v-cond else p-cond)
      613   p-rec       = (if p-rec = ?  then v-rep  else p-rec )
      614   p-grp       = (if p-grp = ?  then v-grp  else p-grp )
      615   p-cli-type  = (if p-cli-type = ? then v-producer-type else p-cli-type)
      616   p-cli-code  = (if p-cli-code = ? then v-producer-code  else p-cli-code)
      617   p-other     = (if p-other = ? then v-other else  p-other)
      618   no-error
      619   .
      620   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      621     run mainmenu_getcntxt in parparentproc
      622       (output v-cntxt-db-num
      623       ,output v-cntxt-userid
      624       ,output v-cntxt-level
      625       ,output v-cntxt-host-code-obj
      626       ,output v-cntxt-obj-type
      627       ,output v-cntxt-obj-code
      628       ,output v-cntxt-db-num-obj
      629       ,output v-cntxt-is-admin
      630       ) .
      631   if p-obj-type = ?
      632   or p-obj-code = ?
      633   then do:
      634     assign
      635       p-obj-type = v-cntxt-obj-type
      636       p-obj-code = v-cntxt-obj-code
      637     .
      638   end.
      639   if p-obj-type = "":U
      640   or p-obj-code = 0
      641   or p-obj-type = ?
      642   or p-obj-code = ?
      643   then do:
      644     if num-entries(v-uf-naim, chr(4)) >= 2
      645     then do:
      646       find first buf_clients no-lock
      647         where buf_clients.obj-type = entry(1, v-uf-Naim, chr(4))
      648           and buf_clients.obj-code = integer(entry(2, v-uf-Naim, chr(4)))
      649         no-error .
      650       if available  buf_clients
      651       then do:
      652         define variable v-object-available as logical   no-undo .
      653   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      654   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usobjava in g#library2
      655     (input  v-cntxt-db-num
      656     ,input  0
      657     ,input  v-cntxt-userid
      658     ,input  buf_clients.obj-type
      659     ,input  buf_clients.obj-code
      660     ,output v-object-available
      661     ) no-error .
      662         if error-status :error
      663         then do:
      664           message
      665             vss-workfile vss-revision vss-description skip
      666             "Ошибка при вызове процедуры gbl/usobjava.i" skip
      667             error-status :get-message(1) skip
      668             return-value skip
      669             view-as alert-box error .
      670           undo, return no-apply .
      671         end.
      672         if v-object-available = true
      673         then do:
      674           assign
      675             p-obj-type = buf_clients.obj-type
      676             p-obj-code = buf_clients.obj-code
      677             v-no-obj   = yes
      678           .
      679         end.
      680       end.
      681     end.
      682   end.
      683   define variable v-user-select     as logical   no-undo .
      684   define variable v-select-obj-type as character no-undo .
      685   define variable v-select-obj-code as integer   no-undo .
      686   if p-obj-type = "":U
      687   or p-obj-code = 0
      688   or p-obj-type = ?
      689   or p-obj-code = ?
      690   then do:
      691   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      692   run userobjs_select-one in this-procedure
      693     (input  parparentproc
      694     ,input  v-cntxt-db-num
      695     ,input  v-cntxt-userid
      696     ,input  v-cntxt-host-code-obj
      697     ,input  v-cntxt-obj-type
      698     ,input  v-cntxt-obj-code
      699     ,output v-user-select
      700     ,output v-select-obj-type
      701     ,output v-select-obj-code
      702     )  .
      703     if v-user-select <> true
      704     then do:
      705       return no-apply .
      706     end.
      707     assign
      708       p-obj-type = v-select-obj-type
      709       p-obj-code = v-select-obj-code
      710       v-no-obj   = yes
      711     .
      712     assign
      713       p-other = p-other + chr(4) + "no-object"
      714     .
      715   end.
      716   DO WHILE a-n-c <> "вых":u :
      717       if p-cond = 'все':U then
      718           run ref/goo-ref.w ( input parparentproc
      719                          ,bttns
      720                         ,input-output p-stat
      721                         ,input-output p-list
      722                         ,input-output p-cond
      723                         ,input-output p-rec
      724                         ,input-output p-grp
      725                         ,input-output p-cli-type
      726                         ,input-output p-cli-code
      727                         ,input-output p-obj-type
      728                         ,input-output p-obj-code
      729                         ,input-output v-gds-name-width
      730                         ,input-output v-grp-name-width
      731                         ,input-output p-other
      732                         ,input-output rid-list ).
      733       else do:
      734           find first ub.assortment-matrix no-lock where
      735                     ub.assortment-matrix.obj-code = p-obj-code and
      736                     ub.assortment-matrix.obj-type = p-obj-type and
      737                     ub.assortment-matrix.asmt-status = integer ('0':U) no-error .
      738           if available ub.assortment-matrix then
      739           run ref/gam-ref.w ( input parparentproc
      740                         ,bttns
      741                         ,input-output p-stat
      742                         ,input-output p-list
      743                         ,input-output p-cond
      744                         ,input-output p-rec
      745                         ,input-output p-grp
      746                         ,input-output p-cli-type
      747                         ,input-output p-cli-code
      748                         ,input-output p-obj-type
      749                         ,input-output p-obj-code
      750                         ,input-output v-gds-name-width
      751                         ,input-output v-grp-name-width
      752                         ,input-output p-other
      753                         ,input-output rid-list ).
      754           else
      755           run ref/gob-ref.w ( input parparentproc
      756                         ,bttns
      757                         ,input-output p-stat
      758                         ,input-output p-list
      759                         ,input-output p-cond
      760                         ,input-output p-rec
      761                         ,input-output p-grp
      762                         ,input-output p-cli-type
      763                         ,input-output p-cli-code
      764                         ,input-output p-obj-type
      765                         ,input-output p-obj-code
      766                         ,input-output v-gds-name-width
      767                         ,input-output v-grp-name-width
      768                         ,input-output p-other
      769                         ,input-output rid-list ).
      770       end.
      771   END .
      772   assign
      773   v-uf-list_ = p-stat  + chr(4) +
      774                 p-list  + chr(4) +
      775                 p-cond  + chr(4) +
      776                 (if p-rec = ?
      777                 then chr(63)
      778                 else string(p-rec)) + chr(4) +
      779                 p-grp  + chr(4) +
      780                 p-cli-type + chr(4) +
      781                 string(p-cli-code) + chr(4) +
      782                 p-other
      783   v-uf-NAIM = p-obj-type + chr(4) + string(p-obj-code) + chr(4) +
      784               string(v-gds-name-width) +  chr(4) + string(v-grp-name-width)
      785   .
      786   run uf-set in this-procedure(
      787       input  'gds-ref-p':U
      788       ,input  v-cntxt-userid
      789       ,input v-uf-List_
      790       ,input v-uf-Naim
      791       ,input v-uf-print-graft
      792       ,input v-uf-sort-gr
      793       ,input v-uf-type-price
      794       ,input v-uf-type-val
      795   )  no-error .
