     2696                              then
     2697           (
     2698           " " + "  " +
     2699             " " + sort-column-phrase +
     2700           " " + " BY X_clients.obj-name  "
     2701           )
     2702                              else
     2703           (
     2704           " " + "  " +
     2705             " " + sort-column-phrase +
     2706           " " + sort-phrase-27
     2707           )
     2708         parameter-7-27 =
     2709           " indexed-reposition  "
     2710       .
     2711       do
     2712       on stop undo, leave
     2713       on error undo, leave
     2714       :
     2715         assign
     2716           l-disable-where-27 =
     2717             (" X_clients.is-prod = yes                             AND X_clients.obj-name contains NameOrCode                             AND X_clients.grp-name begins Curr-Grp-Name                             AND X_clients.stts <> 0 " + " " + where-phrase-27 = "")
     2718         .
     2719         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2720                             ,input query cli-list:handle
     2721                             ,input parameter-3-27
     2722                             ,input parameter-4-27
     2723                             ,input parameter-5-27
     2724                             ,input parameter-6-27
     2725                             ,input parameter-7-27
     2726                             )
     2727         .
     2728         assign
     2729           l-filter-open-27 = true
     2730         .
     2731       end.
     2732       if l-filter-open-27 = false then do:
     2733         message
     2734           "Ошибка при фильтрации / сортировке" skip
     2735           "Будут показаны записи без учета фильтра" skip
     2736           view-as alert-box .
     2737       end.
     2738       else do:
     2739           assign
     2740             l-query-was-opened = true
     2741           .
     2742       end.
     2743     end.
     2744     if l-filter-open-27 = false then do:
     2745       OPEN QUERY CLi-List FOR EACH X_clients no-lock
     2746         where  X_clients.is-prod = yes                             AND X_clients.obj-name contains NameOrCode                             AND X_clients.grp-name begins Curr-Grp-Name                             AND X_clients.stts <> 0
     2747          BY X_clients.obj-name
     2748         indexed-reposition
     2749     .
     2750         assign
     2751           l-query-was-opened = true
     2752         .
     2753     end.
     2754   end.
     2755   else do:
     2756     assign
     2757       v-doc-rec = recid( ub.clients )
     2758     .
     2759     do
     2760     on stop undo, leave
     2761     on error undo, leave
     2762     :
     2763       if query cli-list:handle:get-buffer-handle(1) = (buffer X_clients:handle) then do:
     2764         assign
     2765         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     2766         parameter-4-27 =
     2767           "where ":u +  substitute('X_clients.is-prod = yes                             AND X_clients.obj-name contains &1&2&1                             AND X_clients.grp-name begins &1&3&1                             AND X_clients.stts <> 0 ', chr(34), NameOrCode, Curr-Grp-Name)  + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     2768         parameter-5-27 = "  "
     2769       .
     2770         run fltopend_fltfindd in this-procedure  (
     2771                             input this-procedure:handle
     2772                             ,input query cli-list:handle
     2773                             ,input rowid(ub.clients)
     2774                             ,input logical(parameter-2-27)
     2775                             ,input no-lock
     2776                             ,input (buffer ub.clients:handle)
     2777                             ,input parameter-4-27
     2778                             ,input parameter-5-27
     2779                             ) no-error.
     2780         .
     2781         assign
     2782           v-doc-rec = integer(return-value)
     2783           v-fltopend-rowid[1] = ?
     2784         .
     2785       end.
     2786       else do:
     2787         assign
     2788         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     2789         parameter-3-27 =  "FOR EACH X_clients"
     2790         parameter-4-27 =
     2791           (
     2792             if (" X_clients.is-prod = yes                             AND X_clients.obj-name contains NameOrCode                             AND X_clients.grp-name begins Curr-Grp-Name                             AND X_clients.stts <> 0 " + " " + where-phrase-27) <> ""
     2793             then  substitute('X_clients.is-prod = yes                             AND X_clients.obj-name contains &1&2&1                             AND X_clients.grp-name begins &1&3&1                             AND X_clients.stts <> 0 ', chr(34), NameOrCode, Curr-Grp-Name)  + " " + where-phrase-27
     2794             else "true"
     2795           )
     2796         parameter-5-27 = (" " + "" + " " + "" + " " + p-find-condition)
     2797         parameter-6-27 = if sort-phrase-27 = ''
     2798                              then
     2799           (
     2800           " " + "  " +
     2801             " " + sort-column-phrase +
     2802           " " + " BY X_clients.obj-name  "
     2803           )
     2804                              else
     2805           (
     2806           " " + "  " +
     2807             " " + sort-column-phrase +
     2808           " " + sort-phrase-27
     2809           )
     2810         parameter-7-27 =
     2811           " indexed-reposition  "
     2812       .
     2813         run fltopend_fltfindq in this-procedure  (
     2814                             input this-procedure:handle
     2815                             ,input query cli-list:handle
     2816                             ,input logical(parameter-2-27)
     2817                             ,input no-lock
     2818                             ,input parameter-3-27
     2819                             ,input parameter-4-27
     2820                             ,input parameter-5-27
     2821                             ,input parameter-6-27
     2822                             ,input parameter-7-27
     2823                             ,output v-fltopend-rowid
     2824                             ) no-error.
     2825         .
     2826         v-doc-rec = ?.
     2827       end.
     2828       assign
     2829         l-query-was-opened = true
     2830       .
     2831     end.
     2832   end.
     2833     run waitfram-hide in this-procedure .
     2834          end.
     2835        END CASE .
     2836      end.
     2837   END CASE.
     2838     end.
     2839   end procedure.
