        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-rule-num as integer no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: show-dr.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: ref/show-dr.p $":U .
        9   define variable vss-description as character no-undo init "Просмотр правила скидки".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71     define variable v-cntxt-db-num        as integer   no-undo .
       72     define variable v-cntxt-userid        as character no-undo .
       73     define variable v-cntxt-level         as character no-undo .
       74     define variable v-cntxt-host-code-obj as integer   no-undo .
       75     define variable v-cntxt-obj-type      as character no-undo .
       76     define variable v-cntxt-obj-code      as integer   no-undo .
       77     define variable v-cntxt-db-num-obj    as integer   no-undo .
       78     define variable v-cntxt-is-admin      as logical   no-undo .
       79   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80     run mainmenu_getcntxt in parparentproc
       81       (output v-cntxt-db-num
       82       ,output v-cntxt-userid
       83       ,output v-cntxt-level
       84       ,output v-cntxt-host-code-obj
       85       ,output v-cntxt-obj-type
       86       ,output v-cntxt-obj-code
       87       ,output v-cntxt-db-num-obj
       88       ,output v-cntxt-is-admin
       89       ) .
       90   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   procedure dr-code :
       92     do
       93     on error undo, return error
       94     :
       95       define input  parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
       96       define output parameter  p-des               like ub.dis-rule.des               no-undo .
       97       define output parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
       98       define output parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
       99       define output parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
      100       define output parameter  p-level-1           as character no-undo .
      101       define output parameter  p-level-2           as character no-undo .
      102       define output parameter  p-global             as integer no-undo .
      103       define output parameter  p-host               as integer no-undo .
      104       define output parameter  p-object             as integer no-undo .
      105       define output parameter  p-output-display as logical   no-undo .
      106       define output parameter  p-tree           as char  no-undo .
      107       define output parameter  p-other          as character no-undo .
      108       define variable v-other as character no-undo .
      109       define buffer buf_dis-rule for ub.dis-rule .
      110       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      111       find first buf_dis-rule no-lock where
      112                 buf_dis-rule.rule-num = p-templ-rl-root no-error.
      113       find first buf_dis-cfg-rule no-lock where
      114               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      115           and buf_dis-cfg-rule.pos-type = '':U
      116           and buf_dis-cfg-rule.table-name = '':U
      117           and buf_dis-cfg-rule.discnt-role = '':U
      118           and buf_dis-cfg-rule.self-nonunique = '':U
      119               no-error.
      120       if not available buf_Dis-cfg-rule then do:
      121           undo, return error substitute("неизвестный шаблон скидки &1", p-templ-rl-root ).
      122       end.
      123       assign
      124       p-des = buf_dis-rule.des
      125       p-discnt-type = buf_dis-rule.discnt-type
      126       p-subject-type = buf_dis-rule.subject-type
      127       p-value-type = buf_dis-rule.value-type
      128       p-global = (if available buf_dis-cfg-rule
      129                   then buf_dis-cfg-rule.has-global
      130                   else 0)
      131       p-host = (if available buf_dis-cfg-rule
      132                 then buf_dis-cfg-rule.has-host
      133                 else 0)
      134       p-object = (if available buf_dis-cfg-rule
      135                 then buf_dis-cfg-rule.has-obj
      136                 else 0)
      137       p-output-display = (buf_dis-rule.sts = integer('0':U))
      138       p-tree = buf_Dis-rule.uniq-field
      139       p-other = buf_dis-rule.other-inf
      140       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      141       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      142                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      143                    else '')
      144       .
      145     end.
      146   end procedure.
      147   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      148   procedure disrules-fill-properties:
      149   define input  parameter p-templ-rl-root as integer   no-undo .
      150   define buffer buf_drt-prop for ub.drt-prop.
      151   define buffer buf_temp-drt-prop for temp-drt-prop.
      152   do
      153   on error undo, return error return-value
      154   :
      155     for each buf_temp-drt-prop:
      156       delete buf_temp-drt-prop.
      157     end.
      158     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      159       create buf_temp-drt-prop.
      160       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      161     end.
      162   end.
      163   end procedure.
      164   procedure disrules-get-interface-form :
      165   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
      166   define output parameter p-form-name as character no-undo .
      167   define buffer buf_temp-drt-prop for temp-drt-prop.
      168   define buffer buf_drt-prop for ub.drt-prop.
      169   find first buf_temp-drt-prop where
      170             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
      171         and buf_temp-drt-prop.upper-prop-code = "InputForm"
      172         and buf_temp-drt-prop.prop-code = "FormName" no-error.
      173   if not available buf_temp-drt-prop then do:
      174     find first buf_drt-prop where
      175               buf_drt-prop.templ-rl-root = p-templ-rl-root
      176           and buf_drt-prop.upper-prop-code = "InputForm"
      177           and buf_drt-prop.prop-code = "FormName" no-error.
      178     if available buf_drt-prop then do:
      179       p-form-name = buf_drt-prop.property-value.
      180     end.
      181     else do:
      182       p-form-name = "ref/dis-ruli.w".
      183     end.
      184   end.
      185   else do:
      186     p-form-name = buf_temp-drt-prop.property-value.
      187   end.
      188   end procedure.
      189   ~
      190   define variable loc-doc-rec as recid no-undo .
      191   define variable glog as logical no-undo .
      192   define variable v-branch-rl-root as integer no-undo .
      193   define buffer buf_dis-rule for ub.dis-rule.
      194   do
      195   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      196   :
      197   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      198   do:
      199     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      200       (input  v-cntxt-db-num
      201       ,input  v-cntxt-userid
      202       ,input  0
      203       ,input  'actn_discount_work':U
      204       ,input  'global':U
      205       ,input  0
      206       ,input  '':U
      207       ,input  0
      208       ,input  0
      209       ,input  0
      210       ,input  0
      211       ,input  true
      212       ,output glog
      213       )  .
      214   end.
      215       if not glog then return .
      216       FIND FIRST buf_Dis-rule NO-LOCK WHERE
      217                 buf_Dis-rule.rule-num = p-rule-num NO-ERROR.
      218       IF NOT AVAILABLE buf_Dis-rule THEN do:
      219         message
      220         substitute("Не найдено правило скидки &1", p-rule-num)
      221         view-as alert-box error .
      222         RETURN error.
      223       end.
      224       if buf_dis-rule.root = no then do:
      225         assign
      226         v-branch-rl-root = buf_dis-rule.rl-root
      227         .
      228         FIND FIRST buf_Dis-rule NO-LOCK WHERE
      229                   buf_Dis-rule.rule-num = v-branch-rl-root NO-ERROR.
      230         IF NOT AVAILABLE buf_Dis-rule THEN do:
      231           message
      232           substitute("Не найдено правило скидки &1", v-branch-rl-root)
      233           view-as alert-box error .
      234           RETURN error.
      235         end.
      236       end.
      237       ASSIGN
      238       loc-doc-rec = recid(buf_dis-rule)
      239       .
      240       define variable v-form-name as character no-undo init "ref/dis-ruli.w".
      241       run disrules-get-interface-form in this-procedure ( input buf_dis-rule.templ-rl-root
      242                                                         ,output v-form-name) .
      243       run value(v-form-name) (
      244                                input parParentProc
      245                               ,input 'ПРОСМОТР':U
      246                               ,input buf_dis-rule.templ-rl-root
      247                               ,input buf_dis-rule.host-code
      248                               ,input buf_dis-rule.obj-type
      249                               ,input buf_dis-rule.obj-code
      250                               ,input buf_dis-rule.rule-num
      251                               ,input buf_dis-rule.upper-rule-num
      252                               ,input 0
      253                               ,input buf_dis-rule.time-templ-rl-root
      254                               ,input '':U
      255                               ,input-output loc-doc-rec
      256                                           ) no-error .
      257   end.
