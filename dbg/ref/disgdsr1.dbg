        1   block-level on error undo, throw.
        2   define input parameter p-mode            as character no-undo .
        3   define input parameter p-gds-code        like ub.dis-gds-rule.gds-code no-undo .
        4   define input parameter p-obj-type        like ub.dis-gds-rule.obj-type no-undo .
        5   define input parameter p-obj-code        like ub.dis-gds-rule.obj-code no-undo .
        6   define temp-table tt0-dis-gds-rule no-undo like ub.dis-gds-rule.
        7   DEFINE INPUT PARAMETER TABLE FOR tt0-dis-gds-rule.
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: disgdsr1.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: ref/disgdsr1.p $":U .
       13   define variable vss-description as character no-undo init "Сохранение изменений скидок товара на объекте".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32       assign
       33         p-vss-parameters = substitute('&1|&2|&3':u,p-gds-code,p-obj-type,p-obj-code)
       34       .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   def new shared var bc-frmt as character no-undo .
       87   def new shared var bc-pfx  as character no-undo .
       88   def var bc-par-type as character no-undo .
       89       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
       90       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
       91           do:
       92               message "Не задан или не верно задан ТИП собственного бар-кода!"
       93                   view-as alert-box ERROR TITLE "".
       94               return error.
       95           end.
       96       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
       97       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
       98           do:
       99               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      100                   view-as alert-box ERROR TITLE "".
      101               return error.
      102           end.
      103   PROCEDURE gen-bc:
      104     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      105     def output parameter full-b-code     as character init ""    no-undo .
      106   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      107     define variable tmp-str0  as character no-undo.
      108     define variable tmp-num0  as character no-undo.
      109     define variable i0        as integer   no-undo.
      110     define variable sum0      as integer   no-undo.
      111     define variable len-code0 as integer   no-undo.
      112     define variable varcont0  as logical   initial yes no-undo.
      113     CASE bc-frmt :
      114       WHEN "EAN13" THEN do:
      115         assign
      116           tmp-str0 = string( internal-b-code, "999999999999" )
      117         .
      118       end.
      119       WHEN "EAN8" THEN do:
      120         assign
      121           tmp-str0 = string( internal-b-code, "9999999" )
      122         .
      123       end.
      124       OTHERWISE DO:
      125           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      126           view-as alert-box error.
      127           return error.
      128       END.
      129     END CASE.
      130     if varcont0 = yes then do:
      131       if integer( substring( tmp-str0, 1, length( bc-pfx ) ) ) <> 0
      132       then do:
      133         message
      134           "Невозможно сформировать бар-код" SKIP
      135           "для товара с кодом: " internal-b-code
      136           view-as alert-box error title "подрезание кода".
      137         return error.
      138       end.
      139       else do:
      140         assign
      141           full-b-code = bc-pfx + substring( tmp-str0, length( bc-pfx ) + 1, length( tmp-str0 ) - length( bc-pfx ) )
      142           len-code0    = length( full-b-code )
      143         .
      144         define variable v-sum-char0 as character no-undo .
      145         assign
      146           sum0 = 0
      147         .
      148         do i0 = 1 to len-code0 by 2
      149         :
      150           assign
      151             v-sum-char0 = substr(full-b-code, len-code0 - i0 + 1, 1)
      152           .
      153           if v-sum-char0 < "0"
      154           or v-sum-char0 > "9"
      155           then do:
      156             message
      157               "Невозможно сформировать бар-код" skip
      158               "для товара с кодом: " internal-b-code skip
      159               view-as alert-box error title "подсчет контрольной суммы".
      160             return error.
      161           end.
      162           assign
      163             sum0 = sum0 + integer(v-sum-char0)
      164           .
      165         end.
      166         if varcont0 = yes then do:
      167           assign
      168             sum0 = sum0 * 3
      169           .
      170           do i0 = 2 to len-code0 by 2
      171           :
      172             assign
      173               v-sum-char0 = substr(full-b-code, len-code0 - i0 + 1, 1)
      174             .
      175             if v-sum-char0 < "0"
      176             or v-sum-char0 > "9"
      177             then do:
      178               message
      179                 "Невозможно сформировать бар-код" skip
      180                 "для товара с кодом: " internal-b-code skip
      181                 view-as alert-box error title "подсчет контрольной суммы".
      182               return error.
      183             end.
      184             assign
      185               sum0 = sum0 + integer(v-sum-char0)
      186             .
      187           end.
      188           if varcont0 = yes then do:
      189              if sum0 mod 10 = 0 then do:
      190                assign
      191                  full-b-code = full-b-code + '0'
      192                .
      193              end.
      194              else do:
      195                assign
      196                  full-b-code = full-b-code + string(10 - sum0 mod 10)
      197                .
      198              end.
      199           end.
      200         end.
      201       end.
      202     end.
      203   END PROCEDURE.
      204   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      205   procedure cr_dis-gds-rule-attr :
      206   def input parameter v-recid-rule-gds as int no-undo .
      207   def buffer buf_dis-gds-rule-attr for dis-gds-rule-attr .
      208   def buffer buf_dis-gds-rule for dis-gds-rule .
      209   def buffer buf_bar-code for ub.bar-code .
      210   def buffer buf_prod-bc  for prod-bc .
      211   def buffer buf_templ-dis-rule for dis-rule .
      212   def buffer buf_templ-dis-time-rule for dis-time-rule .
      213   def buffer buf_dis-cfg-rule   for dis-cfg-rule .
      214   def buffer buf_dis-rule   for dis-rule .
      215   define variable v-upd as character no-undo .
      216   define variable v-number-action as character no-undo .
      217   define variable v-bar-code as character no-undo .
      218   find buf_dis-gds-rule no-lock where recid(buf_dis-gds-rule) = v-recid-rule-gds  no-error.
      219   if avail buf_dis-gds-rule then
      220   do:
      221     find first buf_dis-rule no-lock where buf_dis-rule.rule-num = buf_dis-gds-rule.rule-num  no-error .
      222     find first buf_templ-dis-rule no-lock where buf_templ-dis-rule.rule-num = buf_dis-rule.templ-rl-root  no-error .
      223     if avail buf_templ-dis-rule and avail buf_dis-rule then
      224     do:
      225        find first buf_dis-cfg-rule no-lock where
      226                   buf_dis-cfg-rule.table-name = "dis-gds-rule"
      227               and buf_dis-cfg-rule.pos-type = buf_dis-gds-rule.pos-type
      228               and buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      229               and buf_dis-cfg-rule.time-templ-rl-root =  buf_dis-rule.time-templ-rl-root
      230               and buf_dis-cfg-rule.self-nonunique = ""
      231               and buf_dis-cfg-rule.nonunique = "bar-code.b-code"
      232               no-error.
      233        if avail buf_dis-cfg-rule then
      234        do:
      235          find first buf_bar-code no-lock where buf_bar-code.b-code = integer(buf_dis-gds-rule.nonunique) no-error.
      236          if avail buf_bar-code then
      237          do:
      238             run gen-bc(input buf_bar-code.b-code,output v-bar-code) .
      239             for each buf_prod-bc no-lock where buf_prod-bc.b-code = buf_bar-code.b-code :
      240               if buf_prod-bc.bc-on = yes then
      241               do:
      242                  v-upd = 'A' .
      243               end.
      244               else
      245               do:
      246                  v-upd = "D" .
      247               end.
      248               find first  buf_dis-gds-rule-attr WHERE
      249                   buf_dis-gds-rule-attr.gds-code = buf_dis-gds-rule.gds-code
      250               AND buf_dis-gds-rule-attr.obj-type = buf_dis-gds-rule.obj-type
      251               AND buf_dis-gds-rule-attr.obj-code = buf_dis-gds-rule.obj-code
      252               AND buf_dis-gds-rule-attr.pos-type = buf_dis-gds-rule.pos-type
      253               AND buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
      254               and buf_dis-gds-rule-attr.nonunique = buf_dis-gds-rule.nonunique
      255               and entry(1,buf_dis-gds-rule-attr.attr-value,",") = buf_prod-bc.b-str
      256                    exclusive-lock no-error .
      257               if (not avail buf_dis-gds-rule-attr) and (not locked buf_dis-gds-rule-attr) then
      258               do:
      259                   if v-upd = "A" then
      260                   do:
      261                       run def-number-action(buf_templ-dis-rule.rule-num,output v-number-action) .
      262                       create buf_dis-gds-rule-attr .
      263                       assign
      264                        buf_dis-gds-rule-attr.gds-code = buf_dis-gds-rule.gds-code
      265                        buf_dis-gds-rule-attr.obj-type = buf_dis-gds-rule.obj-type
      266                        buf_dis-gds-rule-attr.obj-code = buf_dis-gds-rule.obj-code
      267                        buf_dis-gds-rule-attr.pos-type = buf_dis-gds-rule.pos-type
      268                        buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
      269                        buf_dis-gds-rule-attr.nonunique = buf_dis-gds-rule.nonunique
      270                        buf_dis-gds-rule-attr.attr-code = v-number-action
      271                        buf_dis-gds-rule-attr.attr-value = buf_prod-bc.b-str + "," + v-upd
      272                       .
      273                   end.
      274               end.
      275               else
      276               do:
      277                 if avail buf_dis-gds-rule-attr and  buf_dis-gds-rule-attr.attr-value <> v-upd then
      278                 do:
      279                  assign
      280                   buf_dis-gds-rule-attr.attr-value = buf_prod-bc.b-str + "," + v-upd
      281                   .
      282                 end.
      283               end.
      284             end.
      285             if v-bar-code <> '' then
      286             do:
      287               find first  buf_dis-gds-rule-attr WHERE
      288                   buf_dis-gds-rule-attr.gds-code = buf_dis-gds-rule.gds-code
      289               AND buf_dis-gds-rule-attr.obj-type = buf_dis-gds-rule.obj-type
      290               AND buf_dis-gds-rule-attr.obj-code = buf_dis-gds-rule.obj-code
      291               AND buf_dis-gds-rule-attr.pos-type = buf_dis-gds-rule.pos-type
      292               AND buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
      293               and buf_dis-gds-rule-attr.nonunique = buf_dis-gds-rule.nonunique
      294               and entry(1,buf_dis-gds-rule-attr.attr-value,",") = v-bar-code
      295                    exclusive-lock no-error .
      296               if not avail buf_dis-gds-rule-attr  then
      297               do:
      298                       run def-number-action(buf_templ-dis-rule.rule-num,output v-number-action) .
      299                       create buf_dis-gds-rule-attr .
      300                       assign
      301                        buf_dis-gds-rule-attr.gds-code = buf_dis-gds-rule.gds-code
      302                        buf_dis-gds-rule-attr.obj-type = buf_dis-gds-rule.obj-type
      303                        buf_dis-gds-rule-attr.obj-code = buf_dis-gds-rule.obj-code
      304                        buf_dis-gds-rule-attr.pos-type = buf_dis-gds-rule.pos-type
      305                        buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
      306                        buf_dis-gds-rule-attr.nonunique = buf_dis-gds-rule.nonunique
      307                        buf_dis-gds-rule-attr.attr-code = v-number-action
      308                        buf_dis-gds-rule-attr.attr-value = v-bar-code + "," + "A"
      309                       .
      310               end.
      311             end.
      312             for each  buf_dis-gds-rule-attr WHERE
      313                   buf_dis-gds-rule-attr.gds-code = buf_dis-gds-rule.gds-code
      314               AND buf_dis-gds-rule-attr.obj-type = buf_dis-gds-rule.obj-type
      315               AND buf_dis-gds-rule-attr.obj-code = buf_dis-gds-rule.obj-code
      316               AND buf_dis-gds-rule-attr.pos-type = buf_dis-gds-rule.pos-type
      317               AND buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
      318               and buf_dis-gds-rule-attr.nonunique = buf_dis-gds-rule.nonunique
      319                     :
      320                find first buf_prod-bc no-lock where
      321                     buf_prod-bc.b-str = entry(1,buf_dis-gds-rule-attr.attr-value,",")
      322                        and can-find(first buf_bar-code where buf_bar-code.b-code = int(buf_dis-gds-rule.nonunique))
      323                        no-error.
      324                if not avail buf_prod-bc or (avail buf_prod-bc and buf_prod-bc.bc-on = no) then
      325                do:
      326                  if entry(1,buf_dis-gds-rule-attr.attr-value,",") <> v-bar-code then
      327                  do:
      328                    v-upd = "D" .
      329                    if buf_dis-gds-rule-attr.attr-value <> v-upd then
      330                    do:
      331                      assign
      332                      buf_dis-gds-rule-attr.attr-value = buf_prod-bc.b-str + "," + v-upd
      333                      .
      334                    end.
      335                  end.
      336                end.
      337             end.
      338          end.
      339        end.
      340     end.
      341   end.
      342   end procedure .
      343   procedure def-number-action :
      344     define input  parameter p-templ-rl-root as int no-undo .
      345     define output parameter p-number-action as char no-undo .
      346     define variable v-action as integer   no-undo .
      347     def buffer buf_dis-rule-attr for dis-rule-attr .
      348     find first buf_dis-rule-attr exclusive-lock where buf_dis-rule-attr.rule-num = p-templ-rl-root
      349                                          and buf_dis-rule-attr.attr-code =  "NCR bonus-qnty"
      350                                          no-error.
      351     if not avail buf_dis-rule-attr then
      352     do:
      353       create buf_dis-rule-attr .
      354       assign
      355          buf_dis-rule-attr.rule-num = p-templ-rl-root
      356          buf_dis-rule-attr.attr-code =  "NCR bonus-qnty"
      357          buf_dis-rule-attr.attr-value = "3100101"
      358          p-number-action = buf_dis-rule-attr.attr-value
      359          .
      360     end.
      361     else
      362     do:
      363        v-action = integer(buf_dis-rule-attr.attr-value) no-error .
      364        if error-status:error = no then
      365        do:
      366          assign
      367             v-action = v-action + 1
      368             buf_dis-rule-attr.attr-value = string(v-action)
      369             p-number-action = buf_dis-rule-attr.attr-value
      370             .
      371        end.
      372     end.
      373   end procedure.
      374   define variable v-deleted as logical no-undo .
      375   define variable v-err-mess as character no-undo .
      376   define variable v-bb-list  as character no-undo .
      377   define variable v-cnt      as integer   no-undo .
      378   define variable v-number-action as character no-undo .
      379   define variable v-bar-code as character no-undo .
      380   define buffer buf_dis-gds-rule for ub.dis-gds-rule.
      381   define buffer buf_dis-gds-rule-attr for ub.dis-gds-rule-attr.
      382   define buffer buf_goods for ub.goods.
      383   define buffer buf_bar-code          for ub.bar-code.
      384   define buffer buf_prod-bc           for ub.prod-bc.
      385   do v-cnt = 2 to num-entries(p-mode, chr(44)):
      386       if entry( v-cnt, p-mode, chr(44) ) begins "dk" then do:
      387           find first buf_prod-bc no-lock where recid(buf_prod-bc) = int( substring( entry( v-cnt, p-mode, chr(44) ), 3 ) ) no-error .
      388           if avail buf_prod-bc then do:
      389               v-bb-list = v-bb-list + ( if v-bb-list = "":U then "":U else chr(44) ) + buf_prod-bc.b-str .
      390           end.
      391       end.
      392       else do:
      393           find first buf_bar-code no-lock where recid(buf_bar-code) = int( entry( v-cnt, p-mode, chr(44) ) ) no-error .
      394           if avail buf_bar-code then do:
      395               v-bb-list = v-bb-list + ( if v-bb-list = "":U then "":U else chr(44) ) + string( buf_bar-code.b-code ) .
      396           end.
      397       end.
      398   end.
      399   p-mode = entry( 1, p-mode, chr(44) ) .
      400   _main:
      401   do
      402   on error undo, return error return-value
      403   :
      404     find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
      405     if not available buf_goods then do:
      406       undo, return error substitute("&1 &2 &3&4Не найден товар с кодом &5"
      407                                    , vss-workfile
      408                                    , vss-revision
      409                                    , vss-description
      410                                    , chr(10)
      411                                    , p-gds-code).
      412     end.
      413     FOR EACH tt0-dis-gds-rule
      414     on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      415     on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      416     on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )  :
      417       if tt0-dis-gds-rule.obj-type = 'орг':U and g#db-num <> 0 then next.
      418       if tt0-dis-gds-rule.obj-type = '':U and g#db-num <> 0 then next.
      419       if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
      420         find FIRST buf_dis-gds-rule WHERE
      421                   buf_dis-gds-rule.gds-code = p-gds-code
      422               AND buf_dis-gds-rule.obj-type = tt0-dis-gds-rule.obj-type
      423               AND buf_dis-gds-rule.obj-code = tt0-dis-gds-rule.obj-code
      424               AND buf_dis-gds-rule.pos-type = tt0-dis-gds-rule.pos-type
      425               AND buf_dis-gds-rule.discnt-role = tt0-dis-gds-rule.discnt-role
      426               and buf_dis-gds-rule.nonunique = tt0-dis-gds-rule.nonunique
      427               no-error.
      428       end.
      429       IF p-mode = 'ДОБАВЛЕНИЕ':U
      430       or not available buf_dis-gds-rule
      431       or buf_dis-gds-rule.rule-num <> tt0-dis-gds-rule.rule-num THEN DO:
      432         if p-mode = 'ДОБАВЛЕНИЕ':U
      433         or not available buf_dis-gds-rule then do:
      434           create buf_Dis-gds-rule.
      435           assign
      436           buf_dis-gds-rule.gds-code = p-gds-code
      437           buf_dis-gds-rule.obj-type = tt0-dis-gds-rule.obj-type
      438           buf_dis-gds-rule.obj-code = tt0-dis-gds-rule.obj-code
      439           buf_dis-gds-rule.pos-type = tt0-dis-gds-rule.pos-type
      440           buf_dis-gds-rule.nonunique = tt0-dis-gds-rule.nonunique
      441           buf_dis-gds-rule.discnt-role = tt0-dis-gds-rule.discnt-role
      442           .
      443         end.
      444         assign
      445         buf_dis-gds-rule.rule-num = tt0-dis-gds-rule.rule-num
      446         buf_dis-gds-rule.rl-root = tt0-dis-gds-rule.rule-num
      447         buf_dis-gds-rule.time-templ-rl-root = tt0-dis-gds-rule.time-templ-rl-root
      448         buf_dis-gds-rule.nonunique = tt0-dis-gds-rule.nonunique
      449         buf_dis-gds-rule.templ-rl-root = tt0-dis-gds-rule.templ-rl-root
      450         buf_dis-gds-rule.time-templ-rl-root = tt0-dis-gds-rule.time-templ-rl-root
      451         .
      452         if buf_dis-gds-rule.templ-rl-root = 91 then do:
      453                    do v-cnt = 1 to num-entries(v-bb-list, chr(44)):
      454                      v-bar-code = entry( v-cnt, v-bb-list, chr(44) ) .
      455                      find first buf_dis-gds-rule-attr exclusive-lock
      456                      where buf_dis-gds-rule-attr.gds-code    = buf_dis-gds-rule.gds-code
      457                        and buf_dis-gds-rule-attr.obj-type    = buf_dis-gds-rule.obj-type
      458                        and buf_dis-gds-rule-attr.obj-code    = buf_dis-gds-rule.obj-code
      459                        and buf_dis-gds-rule-attr.pos-type    = buf_dis-gds-rule.pos-type
      460                        and buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
      461                        and buf_dis-gds-rule-attr.nonunique   = buf_dis-gds-rule.nonunique
      462                        and entry(1,buf_dis-gds-rule-attr.attr-value,",") = v-bar-code
      463                      no-error.
      464                      if not avail buf_dis-gds-rule-attr then do:
      465                         create buf_dis-gds-rule-attr .
      466         end.
      467                      run def-number-action(buf_dis-gds-rule.templ-rl-root, output v-number-action) .
      468                      assign
      469                       buf_dis-gds-rule-attr.gds-code    = buf_dis-gds-rule.gds-code
      470                       buf_dis-gds-rule-attr.obj-type    = buf_dis-gds-rule.obj-type
      471                       buf_dis-gds-rule-attr.obj-code    = buf_dis-gds-rule.obj-code
      472                       buf_dis-gds-rule-attr.pos-type    = buf_dis-gds-rule.pos-type
      473                       buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
      474                       buf_dis-gds-rule-attr.nonunique   = buf_dis-gds-rule.nonunique
      475                       buf_dis-gds-rule-attr.attr-code   = v-number-action
      476                       buf_dis-gds-rule-attr.attr-value  = v-bar-code + ",A"
      477                      .
      478                    end.
      479         end.
      480         release buf_dis-gds-rule no-error.
      481         IF ERROR-STATUS:ERROR THEN DO:
      482           assign
      483           v-err-mess = substitute("Ошибка при сохранении скидки &1 (POS &2) на товар &3 на &4&5&6&7&6&8"
      484                                   ,tt0-dis-gds-rule.templ-rl-root
      485                                   ,tt0-dis-gds-rule.pos-type
      486                                   ,p-gds-code
      487                                   ,tt0-dis-gds-rule.obj-type
      488                                   ,tt0-dis-gds-rule.obj-code
      489                                   ,chr(10)
      490                                   ,error-status:get-message(1)
      491                                   ,return-value
      492                                   ).
      493           undo _main, return error v-err-mess.
      494         END.
      495       END.
      496     END.
      497     if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
      498       FOR EACH buf_dis-gds-rule where
      499               buf_dis-gds-rule.gds-code = p-gds-code
      500       on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      501       on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      502       on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )  :
      503         if buf_Dis-gds-rule.obj-type = 'орг':U and g#db-num <> 0 then next.
      504         if buf_dis-gds-rule.obj-type = '':U and g#db-num <> 0 then next.
      505         if (buf_dis-gds-rule.obj-type = 'маг':U
      506             or
      507             buf_dis-gds-rule.obj-type = 'скл':U )
      508         and ((buf_dis-gds-rule.obj-type <> p-obj-type
      509              or buf_dis-gds-rule.obj-code <> p-obj-code))  then next.
      510         if buf_dis-gds-rule.templ-rl-root = 0 then next.
      511           FIND FIRST tt0-dis-gds-rule NO-LOCK WHERE
      512               tt0-dis-gds-rule.gds-code = p-gds-code
      513           AND tt0-dis-gds-rule.obj-type = buf_dis-gds-rule.obj-type
      514           AND tt0-dis-gds-rule.obj-code = buf_dis-gds-rule.obj-code
      515           AND tt0-dis-gds-rule.pos-type = buf_dis-gds-rule.pos-type
      516           AND tt0-dis-gds-rule.discnt-role = buf_dis-gds-rule.discnt-role
      517           AND tt0-dis-gds-rule.nonunique = buf_dis-gds-rule.nonunique
      518           NO-ERROR.
      519         IF NOT AVAILABLE tt0-dis-gds-rule THEN DO:
      520               for each buf_dis-gds-rule-attr exclusive-lock
      521               where buf_dis-gds-rule-attr.gds-code    = buf_dis-gds-rule.gds-code
      522                 and buf_dis-gds-rule-attr.obj-type    = buf_dis-gds-rule.obj-type
      523                 and buf_dis-gds-rule-attr.obj-code    = buf_dis-gds-rule.obj-code
      524                 and buf_dis-gds-rule-attr.pos-type    = buf_dis-gds-rule.pos-type
      525                 and buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
      526                 and buf_dis-gds-rule-attr.nonunique   = buf_dis-gds-rule.nonunique
      527               :
      528                   delete buf_dis-gds-rule-attr no-error.
      529                   IF error-status:error
      530                   THEN DO:
      531                     assign
      532                     v-err-mess = substitute("Ошибка при удалении атрибутов скидки &1 (POS &2) на товар &3 на &4&5&6&7&6&8"
      533                                             ,buf_dis-gds-rule.templ-rl-root
      534                                             ,buf_dis-gds-rule.pos-type
      535                                             ,p-gds-code
      536                                             ,buf_dis-gds-rule.obj-type
      537                                             ,buf_dis-gds-rule.obj-code
      538                                             ,chr(10)
      539                                             ,error-status:get-message(1)
      540                                             ,return-value
      541                                             ).
      542                     undo _main, return error v-err-mess.
      543                   END.
      544               end.
      545           delete buf_dis-gds-rule no-error.
      546           IF error-status:error
      547           THEN DO:
      548             assign
      549             v-err-mess = substitute("Ошибка при удалении скидки &1 (POS &2) на товар &3 на &4&5&6&7&6&8"
      550                                     ,buf_dis-gds-rule.templ-rl-root
      551                                     ,buf_dis-gds-rule.pos-type
      552                                     ,p-gds-code
      553                                     ,buf_dis-gds-rule.obj-type
      554                                     ,buf_dis-gds-rule.obj-code
      555                                     ,chr(10)
      556                                     ,error-status:get-message(1)
      557                                     ,return-value
      558                                     ).
      559             undo _main, return error v-err-mess.
      560           END.
      561         END.
      562       END.
      563     end.
      564   end.
