        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   define input parameter imode as character no-undo.
        3   define input parameter iparent as character no-undo.
        4   define input-output parameter p-rid as recid init ? no-undo.
        5   define buffer b3-code for code .
        6   define variable vss-revision    as character no-undo init "$Revision: $":U .
        7   define variable vss-author      as character no-undo init "$Author: $":U .
        8   define variable vss-date        as character no-undo init "$Date: $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: $":U .
       11   define variable vss-description as character no-undo init "редактирование параметров".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   procedure sel-date :
      119     define input  parameter p-date-handle as handle    no-undo .
      120     define input  parameter p-description as character no-undo .
      121     do
      122     on error undo, return error return-value
      123     :
      124       if (can-query (p-date-handle, "sensitive")
      125         and
      126         p-date-handle :sensitive = true
      127         )
      128       or (can-query (p-date-handle, "read-only")
      129         and
      130         p-date-handle :read-only = false
      131         )
      132       then do:
      133         if p-date-handle :handle <> focus :handle
      134         then do:
      135           apply "entry":u to p-date-handle .
      136         end.
      137         define variable v-ok            as logical no-undo .
      138         define variable v-curr-sv-date as date no-undo .
      139         assign
      140           v-curr-sv-date = date(p-date-handle :screen-value) no-error
      141         .
      142         if v-curr-sv-date = ?
      143         then do:
      144           run gbl/getcurdt.p
      145             (output v-curr-sv-date
      146             ) .
      147         end.
      148         if v-curr-sv-date <> ?
      149         then do:
      150           run gbl/d-inpday.w
      151             (input ?
      152             ,input "Выбор даты"
      153             ,input p-description
      154             ,input ""
      155             ,input-output v-curr-sv-date
      156             ,output v-ok
      157             ).
      158           if v-ok = true
      159           then do:
      160             assign
      161               p-date-handle :screen-value = string(v-curr-sv-date) .
      162             .
      163           end.
      164         end.
      165       end.
      166     end.
      167   end procedure.
      168   define variable v-db-num like ub.db.db-num no-undo .
      169   define variable v-name   as character no-undo .
      170   define variable vDateIsoOld as character no-undo.
      171   define variable mViewDop as logical no-undo.
      172   mViewDop = num-entries (iparent,chr(4)) eq 2.
      173   DEFINE BUTTON B-Help
      174      LABEL "Помо&щь"
      175      SIZE 10 BY 1
      176      BGCOLOR 8 .
      177   DEFINE BUTTON b-quit AUTO-END-KEY
      178      LABEL "&Отмена"
      179      SIZE 10 BY 1
      180      BGCOLOR 8 .
      181   DEFINE BUTTON B-save AUTO-GO
      182      LABEL "&Ввод"
      183      SIZE 10 BY 1
      184      BGCOLOR 8 .
      185   DEFINE VARIABLE mParentCode   AS character       FORMAT "x(40)":U
      186      LABEL "Группа"
      187      VIEW-AS FILL-IN
      188      SIZE 40 BY 1 NO-UNDO.
      189   DEFINE VARIABLE mCode   AS character       FORMAT "x(40)":U
      190      LABEL "Название параметра"
      191      VIEW-AS FILL-IN
      192      SIZE 40 BY 1 NO-UNDO.
      193   DEFINE VARIABLE mZNACH  AS character    FORMAT "x(40)":U
      194      LABEL "Значение"
      195      VIEW-AS FILL-IN
      196      SIZE 40 BY 1 NO-UNDO.
      197   DEFINE VARIABLE mDecript  AS character    FORMAT "x(4000)":U
      198      LABEL "Описание параметра"
      199      VIEW-AS FILL-IN
      200      SIZE 80 BY 1 NO-UNDO.
      201   DEFINE VARIABLE fStatus AS integer   init '0':U
      202      LABEL "Статус"
      203      VIEW-AS COMBO-BOX INNER-LINES 2
      204      LIST-ITEM-PAIRS "Текущая",'0':U,
      205      "Удаленный",'1':U
      206      DROP-DOWN-LIST
      207      SIZE 20 BY 1 NO-UNDO.
      208   DEFINE FRAME Dialog-Frame
      209      B-save AT ROW 1 COL 1
      210      b-quit AT ROW 1 COL 11
      211      B-Help AT ROW 1 COL 36
      212      mParentCode AT ROW 2.5 COL 25 COLON-ALIGNED WIDGET-ID 8
      213      mCode AT ROW 4 COL 25 COLON-ALIGNED WIDGET-ID 10
      214      mZNACH AT ROW 5.5 COL 25 COLON-ALIGNED WIDGET-ID 12
      215      mDecript AT ROW 7 COL 25 COLON-ALIGNED WIDGET-ID 14
      216      fStatus AT ROW 8.5 COL 20 COLON-ALIGNED WIDGET-ID 16
      217      WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      218      SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      219      TITLE "Редактирование параметра"
      220      DEFAULT-BUTTON B-save CANCEL-BUTTON b-quit.
      221   ASSIGN
      222      FRAME Dialog-Frame:SCROLLABLE = FALSE
      223      FRAME Dialog-Frame:HIDDEN     = TRUE.
      224   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      225      DO:
      226         APPLY "END-ERROR":U TO SELF.
      227      END.
      228   ON CHOOSE OF B-save IN FRAME Dialog-Frame
      229      DO:
      230         run proc-save in this-procedure no-error.
      231         if error-status:error then return no-apply.
      232      END.
      233   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      234      THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      235   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      236   on help of frame Dialog-Frame
      237   do:
      238     run gbl/app_help.p
      239       (input this-procedure :file-name
      240       ,input ''
      241       ,input ?
      242       ) no-error.
      243     if error-status :error then do:
      244       message
      245         "Ошибка при вызове помощи"
      246         error-status :get-message(1)
      247         view-as alert-box .
      248     end.
      249   end.
      250   run minbtn-set in this-procedure .
      251   on choose of b-help in frame Dialog-Frame
      252   do:
      253     apply "help":u to frame Dialog-Frame .
      254   end.
      255   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      256   procedure minbtn-set :
      257       do
      258           on error undo, return error return-value
      259           :
      260           define variable ii              as integer       no-undo .
      261           define variable fh              as widget-handle no-undo .
      262           define variable hh              as widget-handle no-undo .
      263           define variable v-h             as handle        extent 4 no-undo .
      264           define variable v-name-button   as character     no-undo .
      265           define variable v-help-old-x    as decimal       no-undo .
      266           define variable v-help-old-y    as decimal       no-undo .
      267           define variable v-help-old-size as decimal       no-undo .
      268           define variable v-frame-width   as decimal       no-undo .
      269           define variable jj              as integer       no-undo .
      270           do
      271               on error undo, return error
      272               :
      273               assign
      274                   v-frame-width = frame Dialog-Frame:width - 0.3
      275                   fh            = frame Dialog-Frame:first-child
      276                   hh            = fh:first-child
      277                   ii            = 1
      278                   .
      279               do while valid-handle(hh):
      280                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      281                   do:
      282                       case lc(hh:name) :
      283                           when "b-help" then
      284                               do:
      285                                   hh:load-image-up("cmp/b-help.bmp":u) .
      286                                   hh:load-image-down("cmp/b-help.bmp":u) .
      287                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      288                                   hh:TOOLTIP = "Помощь" .
      289                                   v-help-old-x = hh:column .
      290                                   v-help-old-y = hh:row    .
      291                                   v-help-old-size = hh:width .
      292                                   hh:width-chars = 2.5 .
      293                               end.
      294                           when "b-print" then
      295                               do:
      296                                   hh:load-image("cmp/b-print.bmp":u) .
      297                                   hh:TOOLTIP = "Печать" .
      298                                   v-h[ii] = hh:handle .
      299                                   ii = ii + 1 .
      300                                   hh:width-chars = 3 .
      301                               end.
      302                           when "b-history" or
      303                           when "b-hist" then
      304                               do:
      305                                   hh:load-image("cmp/b-hist.bmp":u) .
      306                                   hh:TOOLTIP = "История" .
      307                                   v-h[ii] = hh:handle .
      308                                   ii = ii + 1 .
      309                                   hh:width-chars = 3 .
      310                               end.
      311                           when "b-sch" then
      312                               do:
      313                                   hh:load-image("cmp/b-sch.bmp":u) .
      314                                   hh:TOOLTIP = "Установка Фильтра" .
      315                                   v-h[ii] = hh:handle .
      316                                   ii = ii + 1 .
      317                                   hh:width-chars = 3 .
      318                               end.
      319                           when "b-hist-user" then
      320                               do:
      321                                   hh:load-image("cmp/b-hist.bmp":u) .
      322                                   hh:TOOLTIP = "История пользователя" .
      323                                   ii = ii + 1 .
      324                               end.
      325                       end case.
      326                   end.
      327                   hh = hh:next-sibling.
      328               end.
      329               b-help:column = v-frame-width - b-help:width-chars.
      330               jj = 0.
      331               repeat ii = 4 to 1 by -1 :
      332                   if valid-handle (v-h[ii] ) then
      333                   do:
      334                       jj  = jj + 1 .
      335                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      336                       v-h[ii]:row    = v-help-old-y .
      337                   end.
      338               end.
      339           end.
      340       end.
      341   end procedure.
      342   MAIN-BLOCK:
      343   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      344      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      345      if imode <> 'ДОБАВЛЕНИЕ':U and
      346         imode <> 'ИЗМЕНЕНИЕ':U  and
      347         imode <> 'ПРОСМОТР':U
      348         then
      349      do:
      350         message
      351            vss-workfile vss-revision vss-description skip
      352            "Неверное значение параметров вызова imode"  imode
      353            view-as alert-box ERROR.
      354         undo, return error.
      355      end.
      356   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      357   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      358     (output v-db-num
      359     )  .
      360      define variable vparentpar as character no-undo.
      361      assign
      362         vparentpar = iparent
      363         mParentCode   = entry(num-entries (vparentpar,chr(4)),vparentpar,chr(4))
      364         entry(num-entries (vparentpar,chr(4)),vparentpar,chr(4)) = ""
      365         vparentpar = trim(vparentpar,chr(4))
      366      no-error.
      367      if not error-status:error
      368      then do:
      369         find first b3-code where
      370            b3-code.parent  = vparentpar
      371            and b3-code.code    = mParentCode no-lock no-error.
      372         if available b3-code
      373            then
      374         do:
      375            FRAME Dialog-Frame:TITLE = "Редактирование параметра " + b3-code.codename.
      376            v-name = b3-code.CodeName .
      377         end.
      378      end.
      379      if imode = 'ИЗМЕНЕНИЕ':U or imode = 'ПРОСМОТР':U then
      380      do:
      381         find first b3-code where
      382            recid(b3-code) = p-rid exclusive-lock no-wait no-error.
      383         if not available b3-code then
      384         do:
      385            message
      386               vss-workfile vss-revision vss-description skip
      387               "Не найдена запись параметра"
      388               view-as alert-box error .
      389            undo, return error.
      390         end.
      391         assign
      392            mCode    = b3-code.code
      393            mZNACH   = b3-code.CodeValue
      394            mDecript     = b3-code.CodeName
      395            Fstatus  = b3-code.status_
      396            .
      397      end.
      398      run enable_UI in this-procedure .
      399      if imode = 'ДОБАВЛЕНИЕ':U then
      400      do:
      401         ENABLE mCode WITH FRAME Dialog-Frame.
      402         apply "entry" to mCode in FRAME Dialog-Frame.
      403      end.
      404      WAIT-FOR GO OF FRAME Dialog-Frame.
      405   END.
      406   session:data-entry-return = no .
      407   RUN disable_UI.
      408   PROCEDURE disable_UI :
      409      HIDE FRAME Dialog-Frame.
      410   END PROCEDURE.
      411   PROCEDURE enable_UI :
      412      DISPLAY mCode mZNACH fStatus mDecript mParentCode
      413         WITH FRAME Dialog-Frame.
      414      ENABLE B-save when iMode ne 'ПРОСМОТР':U
      415      b-quit B-Help
      416      mParentCode when iMode eq 'ИЗМЕНЕНИЕ':U
      417      mCode    when iMode eq 'ИЗМЕНЕНИЕ':U
      418      mZNACH   when iMode eq 'ИЗМЕНЕНИЕ':U
      419      fStatus  when iMode eq 'ИЗМЕНЕНИЕ':U
      420      mDecript when iMode eq 'ИЗМЕНЕНИЕ':U
      421         WITH FRAME Dialog-Frame.
      422      VIEW FRAME Dialog-Frame.
      423      if mParentCode eq  "" and iMode eq 'ИЗМЕНЕНИЕ':U
      424      then ENABLE mParentCode
      425         WITH FRAME Dialog-Frame.
      426   END PROCEDURE.
      427   PROCEDURE proc-save :
      428      define buffer b3-code for code.
      429      define buffer b2-code for code.
      430      assign frame Dialog-Frame
      431         mParentCode
      432         mCode
      433         mZNACH
      434         mDecript
      435         fStatus
      436         .
      437       if mcode = ""
      438       then do:
      439         message "Введите Название параметра ! " view-as  alert-box  error.
      440         apply "entry"  to mcode .
      441         return ERROR.
      442       end.
      443      do on error undo, return error
      444         on stop undo, return error:
      445         entry(num-entries (iparent,chr(4)),iparent,chr(4)) = mParentCode.
      446         if mCode eq ?
      447         then do:
      448            message "Код не может быть пустой"
      449            view-as alert-box.
      450            return error.
      451         end.
      452         find first b3-code where
      453            b3-code.parent = iparent
      454            and b3-code.code   = mcode
      455            and if p-rid eq ? then yes else recid(b3-code) ne p-rid
      456            no-lock no-error.
      457         if avail b3-code then
      458         do:
      459            message
      460               "Уже есть такаой параметр :" mCode
      461               view-as alert-box error .
      462            return error.
      463         end.
      464         find first b3-code where
      465            recid(b3-code) eq p-rid
      466            exclusive-lock no-error.
      467         if not avail b3-code then
      468         do:
      469            create b3-code.
      470         end.
      471         assign
      472            b3-code.parent    = iparent
      473            b3-code.code      = mcode
      474            b3-code.codevalue = mZNACH
      475            b3-code.CodeName  = mDecript
      476            b3-code.status_   = fStatus
      477            b3-code.nwsgbd    = yes
      478            .
      479         p-rid = recid(b3-code).
      480      end.
      481   END PROCEDURE.
