        1   DEFINE BUFFER buf_norm-loss FOR ub.norm-loss.
        2   define input  parameter parParentProc as widget-handle                    no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Справочник норм технологических потерь".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define new global shared variable g#library  as handle no-undo .
       68   define new global shared variable g#library2 as handle no-undo .
       69   define   shared variable g#auto as logical no-undo.
       70   define   shared variable g#news as logical no-undo.
       71   define   shared variable g#oxml as logical no-undo.
       72   define   shared variable g#esys as logical no-undo.
       73   define   shared variable g#news-source-db as integer no-undo.
       74   define   shared variable g#esys-source-esys as integer no-undo.
       75   define   shared variable g#db-num as integer   no-undo .
       76   define   shared variable g#userid as character no-undo .
       77   define   shared variable g#passwd as character no-undo .
       78   procedure proc-alt-shift-f2:
       79     if not ibs.th.gbl.gbl-var:rcode
       80   then
       81     run gbl\inidebug.p .
       82   end.
       83   procedure proc-alt-shift-f3:
       84     run gbl/prvssinf.p
       85       ( input this-procedure
       86       ) .
       87   end.
       88   define variable v-inform-launched as logical no-undo initial false .
       89   procedure proc-alt-shift-f4:
       90     define variable v-action as character no-undo .
       91     if v-inform-launched = false then do:
       92       assign
       93         v-inform-launched = true
       94       .
       95       run gbl/d-inform.w
       96         (  input self
       97         ,  input this-procedure
       98         , output v-action
       99         ) no-error .
      100       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      101       assign
      102         v-inform-launched = false
      103       .
      104     end.
      105   end.
      106   procedure proc-alt-f1:
      107     run gbl/corrhelp.p
      108       (input this-procedure
      109       ) .
      110   end .
      111   on alt-shift-f2 anywhere do:
      112     run proc-alt-shift-f2.
      113   end.
      114   on alt-shift-f3 anywhere do:
      115     run proc-alt-shift-f3 in this-procedure .
      116   end.
      117   on alt-shift-f4 anywhere do:
      118     run proc-alt-shift-f4 in this-procedure.
      119   end.
      120   on alt-f1 anywhere do:
      121     run proc-alt-f1 in this-procedure .
      122   end.
      123   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   define variable v-waitfram-action01         as character   no-undo .
      125   define variable v-waitfram-action02         as character   no-undo .
      126   define variable v-waitfram-action03         as character   no-undo .
      127   define variable mWaitFramTextBeg            as character   no-undo.
      128   define variable mWaitFramTextEnd            as character   no-undo.
      129   define variable mWaitFramView               as logical     no-undo.
      130   define variable mWaitProcEvent              as logical     no-undo init yes.
      131   define variable mWaitFramInterval           as integer     no-undo init 1 .
      132   define variable mWaitFramStop               as logical     no-undo.
      133   define variable mWaitFramStopUser           as logical     no-undo.
      134   define variable mWaitFramStopTimeOut        as logical     no-undo.
      135   define variable mWaitFramStartProc          as datetime-tz no-undo.
      136   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      137   define button B-WaitFramStop auto-end-key
      138        label "Стоп"
      139        size 10 by 1 tooltip "Остоновить процесс".
      140   define button B-viewProcInfo
      141        label "Информация"
      142        size 15 by 1 tooltip "Информация о процесс".
      143   define frame waitfram
      144     v-waitfram-action01 format "x(72)" no-label skip
      145     v-waitfram-action02 format "x(72)" no-label skip
      146     v-waitfram-action03 format "x(72)" no-label skip
      147     B-viewProcInfo
      148     B-WaitFramStop at row 4 col 30
      149     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      150     .
      151   define new global shared variable mBatchMode as logical no-undo init ?.
      152   define variable mFramBachModHandle as handle no-undo.
      153   mFramBachModHandle = frame waitfram:handle.
      154   define variable mFameOldVis as logical no-undo.
      155   define variable mVisCUrentVin as logical no-undo.
      156   if session:batch-mode
      157   then
      158      mBatchMode = yes.
      159   if mBatchMode = ? then do:
      160     mVisCUrentVin = current-window:visible.
      161     mFameOldVis = mFramBachModHandle:visible.
      162     mFramBachModHandle:visible  = yes.
      163     mBatchMode = mFramBachModHandle:visible ne yes.
      164     mFramBachModHandle:visible = mFameOldVis.
      165     current-window:visible = mVisCUrentVin.
      166   end.
      167    if  log-manager:logfile-name ne ?
      168     then DO:
      169         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      170         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      171         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      172     end.
      173   on choose of B-WaitFramStop in frame waitfram
      174   do:
      175     mWaitFramStop = yes.
      176     mWaitFramStopUser = yes.
      177   end.
      178   function waitfram-check-timeout returns logical():
      179      define variable vtime as int64 no-undo.
      180      if mWaitFramStopTimeOut
      181      then
      182         return yes.
      183      vtime = ( now - mWaitFramStartProc ) / 1000 .
      184      if     mWaitFramTimeOut ne ?
      185         and mWaitFramTimeOut ne 0
      186         and mWaitFramTimeOut lt vtime
      187      then do:
      188         mWaitFramStopTimeOut = yes.
      189      end.
      190      return mWaitFramStopTimeOut.
      191   end.
      192   procedure waitfram-hide :
      193     if not session:batch-mode
      194     then do
      195     on error undo, return error return-value
      196     :
      197       pause 0 before-hide .
      198       if not mBatchMode then
      199         hide frame waitfram .
      200     if     not mWaitFramView
      201        and mWaitProcEvent
      202     then
      203       process events .
      204     end.
      205   end procedure.
      206   procedure waitfram-show :
      207     define input  parameter p-message as character no-undo .
      208     define variable v-left-margin as integer   no-undo .
      209     if not session:batch-mode
      210     then do
      211     on error undo, return error return-value
      212     :
      213       if length(p-message) <= 70 then do:
      214         assign
      215           v-left-margin = integer((70 - length(p-message)) / 2)
      216         .
      217         assign
      218           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      219         .
      220         assign
      221           v-waitfram-action01 = " "
      222           v-waitfram-action02 = " "
      223                                    + fill(" ", v-left-margin)
      224                                    + p-message
      225           v-waitfram-action03 = " "
      226         .
      227       end.
      228       else do:
      229         define variable vRindex1 as integer no-undo.
      230         define variable vRindex2 as integer no-undo.
      231         vRindex1 = r-index(p-message," ",70).
      232         if vRindex1 = 0
      233         then
      234            vRindex1 = 70.
      235         if length(p-message)  <= vRindex1 + 70 then do:
      236           assign
      237             v-waitfram-action01 = " "
      238             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      239             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      240           .
      241         end.
      242         else do:
      243           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      244           if vRindex2 <= vRindex1
      245           then
      246              vRindex2 = vRindex1 + 70.
      247           assign
      248             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      249             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      250             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      251           .
      252         end.
      253       end.
      254       B-viewProcInfo:visible   in frame waitfram = no.
      255       B-viewProcInfo:sensitive in frame waitfram = no.
      256       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      257       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      258       if  (   mWaitFramView
      259          or  mWaitProcEvent)
      260          and not mBatchMode
      261       then
      262          display
      263             v-waitfram-action01 skip
      264             v-waitfram-action02 skip
      265             v-waitfram-action03 skip
      266          with frame waitfram .
      267       if     mWaitFramView
      268          then do:
      269             if     mWaitFramInterval ne ?
      270                and not mBatchMode
      271             then
      272                wait-for go of frame waitfram pause mWaitFramInterval.
      273          end.
      274          else
      275             if     mWaitProcEvent
      276                and not mBatchMode
      277             then
      278                process events .
      279     end.
      280   end procedure.
      281      procedure waitfram-show-this:
      282         define input  parameter iInterval as int64 no-undo.
      283         define variable vtime as int64 no-undo.
      284         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      285         mWaitFramInterval = iInterval.
      286         run waitfram-show (substitute("&1&2 &3&4" ,
      287                                       mWaitFramTextBeg ,
      288                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      289                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      290                                       mWaitFramTextEnd
      291                                      )
      292                           ).
      293      end.
      294      procedure WaitFramRunPause:
      295         define input  parameter iInterval as dec no-undo.
      296         define variable vStart  as datetime-tz no-undo.
      297         define variable vend    as datetime-tz no-undo.
      298         define variable vint as int64 no-undo.
      299         define variable vOk as logical no-undo.
      300         vStart = now.
      301         vend   = vStart.
      302         publish "WaitFramPause" (iInterval,output vOk).
      303         vend   =  now.
      304         vint = vend - vStart.
      305         vint = iInterval - vint / 1000.
      306         if     not mWaitFramStop
      307            and (   vint > 0
      308                 or (    not vOk
      309                     and iInterval eq ?
      310                     )
      311                 )
      312         then
      313            run waitfram-show-this (iInterval).
      314         vend   =  now.
      315         vint = vend - vStart.
      316         vint = iInterval - vint / 1000.
      317         if     not mWaitFramStop
      318            and vint > 0
      319         then do:
      320            run gbl/pause.p (vint * 1000).
      321         end.
      322         if iInterval ne ?
      323         then
      324            publish "WaitFramStop".
      325         waitfram-check-timeout().
      326      end.
      327      procedure WaitFramWaitFor:
      328         define input  parameter iInterval as dec no-undo.
      329         assign
      330            mWaitFramStartProc   = now
      331            mWaitFramStopUser    = no
      332            mWaitFramStopTimeOut = no
      333         .
      334         block-wait:
      335         do while not mWaitFramStop:
      336            run WaitFramRunPause (iInterval).
      337            if  waitfram-check-timeout()
      338            then do:
      339               leave block-wait.
      340            end.
      341         end.
      342         run waitfram-hide.
      343      end.
      344   procedure waitfram-join :
      345     define input  parameter p-line-1  as character no-undo .
      346     define input  parameter p-line-2  as character no-undo .
      347     define input  parameter p-line-3  as character no-undo .
      348     define output parameter p-message as character no-undo .
      349     do
      350     on error undo, return error return-value
      351     :
      352       assign
      353         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      354                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      355                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      356       .
      357     end.
      358   end procedure.
      359   function waitfram-join-function returns character
      360     (input p-line-1 as character
      361     ,input p-line-2 as character
      362     ,input p-line-3 as character
      363     ).
      364     define variable v-message as character no-undo .
      365     run waitfram-join in this-procedure
      366       (input  p-line-1
      367       ,input  p-line-2
      368       ,input  p-line-3
      369       ,output v-message
      370       ) .
      371     return v-message .
      372   end function .
      373   define variable vss-include-info1 as character format "X(65)" no-undo
      374   initial "@(#)$Workfile$ $Revision$".
      375   define temp-table temp_p-fmt_string-part no-undo
      376       field str-key       as integer
      377       field string-part   as character
      378       index pi is primary unique
      379           str-key
      380   .
      381   define variable v-p-fmt-1-str-key    as integer      no-undo.
      382   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      383                                     iInput AS INTEGER).
      384     def var v-start-print as integer no-undo .
      385     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      386     assign
      387       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      388     .
      389     RETURN v-start-print .
      390   END FUNCTION.
      391   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      392                                     iInput AS INTEGER).
      393     def var v-start-print as integer no-undo .
      394     assign
      395       v-start-print = INTEGER(iEndPix - 1 - iInput)
      396     .
      397     if v-start-print < 0 then return 0.
      398     RETURN v-start-print .
      399   END FUNCTION.
      400   function p-fmt-align-string returns character (
      401         p-in-string      as character
      402       , p-page-width     as integer
      403       , p-align-type     as character
      404   ).
      405       define variable v-string-length     as integer      no-undo.
      406       define variable v-out-string        as character    no-undo.
      407       assign
      408           v-string-length = length( trim( p-in-string ) )
      409       .
      410       if v-string-length >= p-page-width
      411       then do:
      412           assign
      413               v-out-string = trim( p-in-string )
      414           .
      415       end.
      416       else do:
      417           case p-align-type
      418           :
      419               when 'left':U
      420               then do:
      421                   assign
      422                       v-out-string = trim( p-in-string )
      423                   .
      424               end.
      425               when 'right':U
      426               then do:
      427                   assign
      428                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      429                   .
      430               end.
      431               when 'center':U
      432               then do:
      433                   assign
      434                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      435                   .
      436               end.
      437           end case.
      438       end.
      439       return v-out-string .
      440   end function.
      441   procedure p-fmt-split-string :
      442   define input parameter p-source-string  as character        no-undo.
      443   define input parameter p-split-length   as integer          no-undo.
      444   define output parameter p-string-1      as character        no-undo.
      445   define output parameter p-string-2      as character        no-undo.
      446   do
      447   on error undo, return error
      448   :
      449       define variable v-space-pos    as integer      no-undo.
      450       if length( p-source-string ) <= p-split-length
      451       then do:
      452           assign
      453               p-string-1 = p-source-string
      454           .
      455       end.
      456       else do:
      457           assign
      458               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      459           .
      460           if v-space-pos = 0
      461           then do:
      462               assign
      463                   v-space-pos = index( p-source-string, " ":U )
      464               .
      465           end.
      466           if v-space-pos = 0
      467           then do:
      468               assign
      469                   p-string-1 = substring( p-source-string, 1, p-split-length )
      470                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      471               .
      472           end.
      473           else do:
      474               assign
      475                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      476                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      477               .
      478           end.
      479       end.
      480   end.
      481   end procedure.
      482   procedure p-fmt-round :
      483   define input parameter p-qnty               as decimal          no-undo.
      484   define input parameter p-price-no-VAT       as decimal          no-undo.
      485   define input parameter p-VAT                as decimal          no-undo.
      486   define input parameter p-SLT                as decimal          no-undo.
      487   define input parameter p-road-tax           as decimal          no-undo.
      488   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      489   define output parameter p-new-VAT           as decimal          no-undo.
      490   define output parameter p-new-SLT           as decimal          no-undo.
      491   define output parameter p-new-sum-VAT       as decimal          no-undo.
      492   define output parameter p-new-sum-SLT       as decimal          no-undo.
      493   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      494   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      495   define output parameter p-new-sum-full      as decimal          no-undo.
      496       define variable v-vat-pc    as decimal      no-undo.
      497       define variable v-slt-pc    as decimal      no-undo.
      498   do
      499   on error undo, return error
      500   :
      501       if p-price-no-VAT = 0
      502       then do:
      503           assign
      504               p-new-price-no-VAT = 0.0
      505               p-new-VAT          = ?
      506               p-new-SLT          = ?
      507               p-new-sum-VAT      = 0.0
      508               p-new-sum-SLT      = 0.0
      509               p-new-sum-no-VAT   = 0.0
      510               p-new-sum-road-tax = 0.0
      511               p-new-sum-full     = 0.0
      512           .
      513       end.
      514       else do:
      515           assign
      516               v-vat-pc            = p-VAT / p-price-no-VAT
      517               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      518               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      519               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      520               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      521               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      522               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      523               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      524               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      525               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      526           .
      527       end.
      528   end.
      529   end procedure.
      530   procedure p-fmt-split :
      531   define input parameter p-in-string      as character        no-undo.
      532   define input parameter p-split-length   as integer          no-undo.
      533       define variable v-start-pos     as integer      no-undo.
      534       define variable v-end-pos       as integer      no-undo.
      535       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      536   do
      537   for buf_temp_p-fmt_string-part
      538   on error undo, return error
      539   :
      540       empty temp-table buf_temp_p-fmt_string-part.
      541       if p-split-length < 1
      542       then do:
      543           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      544       end.
      545       assign
      546           p-in-string                 = trim( p-in-string )
      547           v-p-fmt-1-str-key   = 0
      548           v-start-pos                 = 1
      549           v-end-pos                   = length( p-in-string )
      550       .
      551       run p-fmt-get-string-range in this-procedure (
      552             input p-in-string
      553           , input p-split-length
      554           , input v-start-pos
      555           , output v-start-pos
      556           , output v-end-pos
      557       ).
      558       do while v-end-pos <> 0
      559       :
      560           create buf_temp_p-fmt_string-part.
      561           assign
      562               v-p-fmt-1-str-key = v-p-fmt-1-str-key + 1
      563           .
      564           assign
      565               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-1-str-key
      566               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      567           .
      568           assign
      569               v-start-pos = v-end-pos + 1
      570           .
      571           run p-fmt-get-string-range in this-procedure (
      572                 input p-in-string
      573               , input p-split-length
      574               , input v-start-pos
      575               , output v-start-pos
      576               , output v-end-pos
      577           ).
      578       end.
      579   end.
      580   end procedure.
      581   procedure p-fmt-get-string-range :
      582   define input parameter p-in-string      as character        no-undo.
      583   define input parameter p-split-length   as integer          no-undo.
      584   define input parameter p-old-start-pos  as integer          no-undo.
      585   define output parameter p-start-pos     as integer          no-undo.
      586   define output parameter p-end-pos       as integer          no-undo.
      587       define variable v-init-string    as character    no-undo.
      588       define variable v-temp-char      as character    no-undo.
      589       define variable v-temp-pos       as integer      no-undo.
      590       define variable v-counter        as integer      no-undo.
      591   do
      592   on error undo, return error
      593   :
      594       assign
      595           p-start-pos   = p-old-start-pos
      596           v-init-string = substring( p-in-string, p-start-pos )
      597       no-error.
      598       if error-status :error
      599       or trim( v-init-string ) = "":U
      600       then do:
      601           assign
      602               p-end-pos = 0
      603           .
      604           undo, return .
      605       end.
      606       assign
      607           v-temp-char   = substring( v-init-string, 1, 1 )
      608       .
      609       do
      610       while trim( v-temp-char ) = "":U
      611       :
      612           assign
      613               p-start-pos     = p-start-pos + 1
      614               v-init-string   = substring( p-in-string, p-start-pos )
      615               v-temp-char     = substring( v-init-string, 1, 1 )
      616           .
      617       end.
      618       assign
      619           v-temp-pos  = p-split-length
      620           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      621           v-counter   = 0
      622       .
      623       search-word-end:
      624       do
      625       while trim( v-temp-char ) <> "":U
      626       :
      627           assign
      628               v-counter   = v-counter + 1
      629           .
      630           if v-counter > 20
      631           then do:
      632               assign
      633                   v-temp-pos  = p-split-length
      634               .
      635               leave search-word-end.
      636           end.
      637           assign
      638               v-temp-pos  = v-temp-pos - 1
      639               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      640           .
      641       end.
      642       assign
      643           p-end-pos = p-start-pos + v-temp-pos - 1
      644       .
      645   end.
      646   end procedure.
