      680   define  stream PrnLibStream.
      681   procedure prn-lib-prn-file :
      682     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      683     define input parameter p-DIsabledoptions as integer no-undo .
      684     define variable v-report-name as character no-undo .
      685     define variable v-user-action as character no-undo .
      686     define variable v-printed     as logical   no-undo .
      687     define variable v-exist       as logical   no-undo .
      688     do
      689       on error undo, return error
      690       :
      691       run prn-lib-get-report-name  in this-procedure (
      692         input parParentProc
      693         ,output v-report-name
      694         ).
      695   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      696   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      697     (input  v-report-name
      698     ,input  2
      699     ,output v-exist
      700     )  .
      701       if NOT v-exist then
      702       DO:
      703         Message
      704           "Нет заданий на печать ! "
      705           view-as alert-box .
      706         Return  .
      707       End.
      708       run gbl/prnfilen.w
      709         (input  ""
      710         ,input  p-DisabledOptions
      711         ,input  string(v-report-name )
      712         ,input  7
      713         ,output v-user-action
      714         ,output v-printed
      715         ) .
      716       if v-printed then
      717       do:
      718         return "YES" .
      719       end.
      720       else
      721       do:
      722         return "NO" .
      723       end.
      724     end.
      725   end procedure.
      726   procedure prn-lib-open-stream :
      727     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      728     define input parameter p-page-size    as integer no-undo .
      729     define input parameter p-is-stream    as logical no-undo .
      730     define input parameter p-append       as logical no-undo .
      731     define variable v-report-name as character no-undo .
      732     do
      733       on error undo, return error
      734       :
      735       run prn-lib-get-report-name  in this-procedure (
      736         input parParentProc
      737         ,output v-report-name
      738         ).
      739       if p-is-stream then
      740       do:
      741         if p-append then
      742         do:
      743           output stream PrnLibStream to value( v-report-name )
      744             page-size value(p-page-size) append .
      745         end.
      746         if not p-append then
      747         do:
      748           output stream PrnLibStream to value( v-report-name )
      749             page-size value(p-page-size) .
      750         end.
      751       end.
      752       if not p-is-stream then
      753       do:
      754         if p-append then
      755         do:
      756           output to value( v-report-name )
      757             page-size value(p-page-size) append .
      758         end.
      759         if not p-append then
      760         do:
      761           output to value( v-report-name )
      762             page-size value(p-page-size) .
      763         end.
      764       end.
      765     end.
      766   end procedure.
      767   procedure prn-lib-open-exp :
      768     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      769     define input parameter p-is-stream    as logical no-undo .
      770     define input parameter p-is-append    as logical no-undo .
      771     define output parameter p-ReportFileName as char init "report" no-undo.
      772     define output parameter p-process as logical no-undo .
      773     define variable glog as logical no-undo .
      774     do
      775       on error undo, return error
      776       :
      777       SYSTEM-DIALOG GET-FILE p-ReportFileName
      778         TITLE      "Укажите путь"
      779         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      780         ASK-OVERWRITE
      781         CREATE-TEST-FILE
      782         SAVE-AS
      783         USE-FILENAME
      784         DEFAULT-EXTENSION "txt"
      785         UPDATE glog
      786         .
      787       if not glog then  return.
      788       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      789       if p-is-stream then
      790       do:
      791         if p-is-append then
      792         do:
      793           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      794         end.
      795         else
      796         do:
      797           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      798         end.
      799       end.
      800       else
      801       do:
      802         if p-is-append then
      803         do:
      804           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      805         end.
      806         else
      807         do:
      808           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      809         end.
      810       end.
      811       p-process = yes.
      812     end.
      813   end procedure.
      814   procedure prn-lib-get-report-name :
      815     define input parameter parParentProc  as widget-handle no-undo.
      816     define output parameter p-report-name as character no-undo .
      817     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      818   end procedure.
      819   procedure prn-lib-reportviewer-report-name :
      820     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      821     define input parameter p-report-name-html as character no-undo .
      822     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      823   end procedure.
      824   procedure prn-lib-reportviewer :
      825     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      826     define input parameter p-report-name-html as character no-undo .
      827     define input parameter p-param        as character no-undo .
      828     define variable v-excel           as character no-undo init 'TRUE' .
      829     define variable v-value-character as character no-undo .
      830     define variable v-value-integer   as character no-undo .
      831     define variable v-value-date      as date      no-undo .
      832     define variable v-value-decimal   as decimal   no-undo .
      833     define variable rep-excel         as logical   no-undo .
      834     define variable excel-string      as character no-undo .
      835     define variable v-param-type      as character no-undo .
      836     define variable v-tth             as handle    no-undo .
      837     run adm/shattri.p (
      838       input "get":U
      839       ,input  ""
      840       ,input  0
      841       ,input  'report-glob':U
      842       ,input  'rep-excel':U
      843       ,output v-value-character
      844       ,output v-value-date
      845       ,output v-value-decimal
      846       ,output v-value-integer
      847       ,output rep-excel
      848       ,output v-param-type
      849       ,INPUT-OUTPUT table-handle v-tth
      850       )  .
      851     if rep-excel then v-excel = "TRUE" .
      852     else v-excel = "FALSE" .
      853     if p-param eq ""
      854     then
      855        p-param = "EXCEL:" + v-excel.
      856     else
      857        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      858     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      859   end procedure.
      860   define temp-table tt-norm-loss no-undo
      861     field clim-grp   as character
      862     field position   as character
      863     field oil-grp    as character
      864     field season     as character
      865     field value-loss as decimal
      866     field type-id    as integer
      867     field sec-vol    as character
      868     field id         as integer
      869     index pi id type-id
      870     .
      871   DEFINE BUTTON b-add
      872        LABEL "&Добавить"
      873        SIZE 10 BY 1
      874        BGCOLOR 8 .
      875   DEFINE BUTTON B-exit AUTO-END-KEY
      876        LABEL "&Выход"
      877        SIZE 10 BY 1
      878        BGCOLOR 8 .
      879   DEFINE BUTTON B-Help
      880        LABEL "Помо&щь"
      881        SIZE 10 BY 1
      882        BGCOLOR 8 .
      883   DEFINE BUTTON b-print
      884     LABEL "Печ&ать"
      885     SIZE 10 BY 1
      886     BGCOLOR 8 .
      887   DEFINE QUERY br-norm-loss FOR
      888     tt-norm-loss SCROLLING.
      889   DEFINE BROWSE BR-norm-loss
      890     QUERY br-norm-loss DISPLAY
      891     tt-norm-loss.sec-vol FORMAT "x(10)":U  label "Вместим."
      892     tt-norm-loss.clim-grp FORMAT "x(10)":U label "Клим.гр."
      893     tt-norm-loss.oil-grp FORMAT "x(10)":U label "Гр.НП"
      894     tt-norm-loss.season FORMAT "x(10)":U label "Сезон"
      895     tt-norm-loss.value-loss FORMAT "->>>>>>>9.999":U label "Норма потерь при сливе из АЦ"
      896       WITH SEPARATORS SIZE 87.75 BY 18.5 FIT-LAST-COLUMN.
      897   DEFINE FRAME Dialog-Frame
      898        B-exit AT ROW 1 COL 1 WIDGET-ID 2
      899        b-add AT ROW 1 COL 11 WIDGET-ID 14
      900        b-print AT ROW 1 COL 69.13 WIDGET-ID 12
      901        B-Help AT ROW 1 COL 79.13 WIDGET-ID 4
      902        BR-norm-loss AT ROW 2.25 COL 1.75 WIDGET-ID 200
      903        SPACE(0.99) SKIP(0.20)
      904       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      905            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      906            TITLE "Нормы технологических потерь НП при сливе из АЦ" WIDGET-ID 100.
      907   ASSIGN
      908          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      909          FRAME Dialog-Frame:HIDDEN           = TRUE.
      910   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      911   DO:
      912     run ref/normloss-add.w (parparentproc,
      913     input 1)no-error.
      914       run init-tt-table in this-procedure .
      915     OPEN QUERY BR-norm-loss FOR EACH tt-norm-loss NO-LOCK by tt-norm-loss.sec-vol by tt-norm-loss.clim-grp by tt-norm-loss.oil-grp by tt-norm-loss.season INDEXED-REPOSITION.
      916     END.
      917   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      918   DO:
      919   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      920   if lookup(self :type
      921            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      922            ) = 0
      923   then do:
      924     message
      925       "$Workfile$"
      926       "Указанному интерфейсному элементу фокус не может быть передан" skip
      927       "Интерфейсный элемент" self :name  skip
      928       "Тип" self :type  skip
      929       "Процедура" this-procedure :file-name skip
      930       view-as alert-box .
      931   end.
      932   else do:
      933     apply "entry":u to self  .
      934     if focus :handle <> self :handle  then do:
      935       return no-apply .
      936     end.
      937   end.
      938   END.
      939   ON CHOOSE OF b-print IN FRAME Dialog-Frame
      940   DO:
      941       if not available tt-norm-loss then return no-apply.
      942       run proc-b-print in this-procedure no-error.
      943       if error-status:error then
      944       do:
      945         return no-apply.
      946       end.
      947     END.
      948   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      949     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      950   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      951   on help of frame Dialog-Frame
      952   do:
      953     run gbl/app_help.p
      954       (input this-procedure :file-name
      955       ,input ''
      956       ,input ?
      957       ) no-error.
      958     if error-status :error then do:
      959       message
      960         "Ошибка при вызове помощи"
      961         error-status :get-message(1)
      962         view-as alert-box .
      963     end.
      964   end.
      965   run minbtn-set in this-procedure .
      966   on choose of b-help in frame Dialog-Frame
      967   do:
      968     apply "help":u to frame Dialog-Frame .
      969   end.
      970   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      971   procedure minbtn-set :
      972       do
      973           on error undo, return error return-value
      974           :
      975           define variable ii              as integer       no-undo .
      976           define variable fh              as widget-handle no-undo .
      977           define variable hh              as widget-handle no-undo .
      978           define variable v-h             as handle        extent 4 no-undo .
      979           define variable v-name-button   as character     no-undo .
      980           define variable v-help-old-x    as decimal       no-undo .
      981           define variable v-help-old-y    as decimal       no-undo .
      982           define variable v-help-old-size as decimal       no-undo .
      983           define variable v-frame-width   as decimal       no-undo .
      984           define variable jj              as integer       no-undo .
      985           do
      986               on error undo, return error
      987               :
      988               assign
      989                   v-frame-width = frame Dialog-Frame:width - 0.3
      990                   fh            = frame Dialog-Frame:first-child
      991                   hh            = fh:first-child
      992                   ii            = 1
      993                   .
      994               do while valid-handle(hh):
      995                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      996                   do:
      997                       case lc(hh:name) :
      998                           when "b-help" then
      999                               do:
     1000                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1001                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1002                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1003                                   hh:TOOLTIP = "Помощь" .
     1004                                   v-help-old-x = hh:column .
     1005                                   v-help-old-y = hh:row    .
     1006                                   v-help-old-size = hh:width .
     1007                                   hh:width-chars = 2.5 .
     1008                               end.
     1009                           when "b-print" then
     1010                               do:
     1011                                   hh:load-image("cmp/b-print.bmp":u) .
     1012                                   hh:TOOLTIP = "Печать" .
     1013                                   v-h[ii] = hh:handle .
     1014                                   ii = ii + 1 .
     1015                                   hh:width-chars = 3 .
     1016                               end.
     1017                           when "b-history" or
     1018                           when "b-hist" then
     1019                               do:
     1020                                   hh:load-image("cmp/b-hist.bmp":u) .
     1021                                   hh:TOOLTIP = "История" .
     1022                                   v-h[ii] = hh:handle .
     1023                                   ii = ii + 1 .
     1024                                   hh:width-chars = 3 .
     1025                               end.
     1026                           when "b-sch" then
     1027                               do:
     1028                                   hh:load-image("cmp/b-sch.bmp":u) .
     1029                                   hh:TOOLTIP = "Установка Фильтра" .
     1030                                   v-h[ii] = hh:handle .
     1031                                   ii = ii + 1 .
     1032                                   hh:width-chars = 3 .
     1033                               end.
     1034                           when "b-hist-user" then
     1035                               do:
     1036                                   hh:load-image("cmp/b-hist.bmp":u) .
     1037                                   hh:TOOLTIP = "История пользователя" .
     1038                                   ii = ii + 1 .
     1039                               end.
     1040                       end case.
     1041                   end.
     1042                   hh = hh:next-sibling.
     1043               end.
     1044               b-help:column = v-frame-width - b-help:width-chars.
     1045               jj = 0.
     1046               repeat ii = 4 to 1 by -1 :
     1047                   if valid-handle (v-h[ii] ) then
     1048                   do:
     1049                       jj  = jj + 1 .
     1050                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1051                       v-h[ii]:row    = v-help-old-y .
     1052                   end.
     1053               end.
     1054           end.
     1055       end.
     1056   end procedure.
     1057   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1058   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1059   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1060   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1061   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1062   define variable v-diasize-current-frame-height as decimal   no-undo .
     1063   define variable v-diasize-change-size          as logical   no-undo .
     1064   define variable v-diasize-resize-button        as handle    no-undo .
     1065   define variable v-diasize-wndmax               as logical   no-undo .
     1066   define variable v-diasize-wndstore             as logical   no-undo .
     1067   define variable v-diasize-proc-name            as character no-undo .
     1068   define variable v-diasize-browse-handle        as handle    no-undo .
     1069   define variable v-diasize-browse-number        as integer   no-undo .
     1070   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1071   define temp-table temp-diasize-handle no-undo
     1072     field handle-value  as handle
     1073     field save-position as decimal
     1074     index xpk is primary unique handle-value
     1075     .
     1076   define temp-table temp-browse-handle no-undo
     1077     field browse-type   as character
     1078     field browse-number as integer
     1079     field browse-handle as handle
     1080     field original-size as decimal
     1081     index xpk is primary unique browse-type browse-number
     1082     index xie browse-type browse-handle
     1083   .
     1084   procedure diasize_change-height :
     1085     define input  parameter p-change-value  as decimal   no-undo .
     1086     define input  parameter p-move-resize   as logical   no-undo .
     1087     define variable v-field-group-handle    as handle    no-undo .
     1088     define variable v-object-handle         as handle    no-undo .
     1089     define variable v-frame-height          as decimal   no-undo .
     1090     define variable v-frame-virtual-height  as decimal   no-undo .
     1091     define variable v-browse-height         as decimal   no-undo .
     1092     define variable v-window-height         as decimal   no-undo .
     1093     define variable v-window-virtual-height as decimal   no-undo .
     1094     define variable v-change-sign           as integer   no-undo .
     1095     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1096     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1097     if p-change-value > 0
     1098     then do:
     1099       if frame Dialog-Frame :height + p-change-value
     1100           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1101       then do:
     1102         assign
     1103           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1104                           - (frame Dialog-Frame :height-chars)
     1105         .
     1106         if p-change-value <= 0
     1107         then do:
     1108           run diasize_position-resize-button in this-procedure .
     1109           return .
     1110         end.
     1111       end.
     1112     end.
     1113     if p-change-value < 0
     1114     then do:
     1115       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1116       then do:
     1117         assign
     1118           p-change-value = v-diasize-orig-frame-height
     1119                          - (frame Dialog-Frame :height-chars)
     1120         .
     1121         if p-change-value >= 0
     1122         then do:
     1123           run diasize_position-resize-button in this-procedure .
     1124           return .
     1125         end.
     1126       end.
     1127     end.
     1128     if p-change-value >= 0
     1129     then do:
     1130       assign
     1131         v-change-sign = 1
     1132       .
     1133     end.
     1134     else do:
     1135       assign
     1136         v-change-sign = -1
     1137       .
     1138     end.
     1139     assign
     1140       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1141     .
     1142     if p-change-value = 0
     1143     then do:
     1144       run diasize_position-resize-button in this-procedure .
     1145       return .
     1146     end.
     1147     move_block:
     1148     do
     1149     on error undo move_block, retry move_block
     1150     :
     1151       if retry
     1152       then do:
     1153         do
     1154         on error undo move_block, leave move_block
     1155         :
     1156           if p-change-value > 0
     1157           then do:
     1158             for each buf_temp-diasize-handle
     1159             on error undo, next
     1160             :
     1161               assign
     1162                 v-object-handle = buf_temp-diasize-handle.handle-value
     1163               .
     1164               if v-object-handle <> v-diasize-resize-button
     1165               then do:
     1166                 assign
     1167                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1168                 .
     1169               end.
     1170             end.
     1171             assign
     1172               v-diasize-browse-handle :height = v-browse-height
     1173             .
     1174             for each buf_temp-browse-handle
     1175               where buf_temp-browse-handle.browse-type = 'height':u
     1176             on error undo, next
     1177             :
     1178               assign
     1179                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1180               .
     1181             end.
     1182             assign
     1183               frame Dialog-Frame :height = v-frame-height
     1184             .
     1185             if frame Dialog-Frame :scrollable = true
     1186             then do:
     1187               assign
     1188                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1189               .
     1190             end.
     1191             run diasize_position-resize-button in this-procedure .
     1192           end.
     1193           else do:
     1194             if frame Dialog-Frame :scrollable = true
     1195             then do:
     1196               assign
     1197                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1198               .
     1199             end.
     1200             assign
     1201               frame Dialog-Frame :height = v-frame-height
     1202             .
     1203             assign
     1204               v-diasize-browse-handle :height = v-browse-height
     1205             .
     1206             for each buf_temp-browse-handle
     1207               where buf_temp-browse-handle.browse-type = 'height':u
     1208             on error undo, next
     1209             :
     1210               assign
     1211                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1212               .
     1213             end.
     1214             for each buf_temp-diasize-handle
     1215             on error undo, next
     1216             :
     1217               assign
     1218                 v-object-handle = buf_temp-diasize-handle.handle-value
     1219               .
     1220               if v-object-handle <> v-diasize-resize-button
     1221               then do:
     1222                 assign
     1223                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1224                 .
     1225               end.
     1226             end.
     1227             run diasize_position-resize-button in this-procedure .
     1228           end.
     1229           assign
     1230             v-diasize-change-size = false
     1231           .
     1232           leave move_block .
     1233         end.
     1234       end.
     1235       assign
     1236         v-diasize-need-full-display = true
     1237       .
     1238       if v-diasize-change-size = false
     1239       then do:
     1240         assign
     1241           v-diasize-change-size = true
     1242         .
     1243       end.
     1244       else do:
     1245         return .
     1246       end.
     1247       assign
     1248         v-frame-height = frame Dialog-Frame :height
     1249         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1250         v-browse-height = v-diasize-browse-handle :height
     1251       .
     1252       for each buf_temp-browse-handle
     1253         where buf_temp-browse-handle.browse-type = 'height':u
     1254       :
     1255         assign
     1256           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1257         .
     1258       end.
     1259       for each buf_temp-diasize-handle
     1260       :
     1261         delete buf_temp-diasize-handle .
     1262       end.
     1263       assign
     1264         v-field-group-handle = frame Dialog-Frame :first-child
     1265       .
     1266       do while valid-handle(v-field-group-handle)
     1267       :
     1268         assign
     1269           v-object-handle = v-field-group-handle :first-child
     1270         .
     1271         do while valid-handle(v-object-handle)
     1272         :
     1273           if  v-object-handle <> v-diasize-browse-handle :handle
     1274           and can-query(v-object-handle, "row")
     1275           and can-query(v-object-handle, "height")
     1276           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1277           then do:
     1278             find first buf_temp-browse-handle
     1279               where buf_temp-browse-handle.browse-type   = 'height':u
     1280                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1281               no-error .
     1282             if available buf_temp-browse-handle
     1283             then do:
     1284             end.
     1285             else do:
     1286               create buf_temp-diasize-handle .
     1287               assign
     1288                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1289                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1290               .
     1291             end.
     1292           end.
     1293           assign
     1294             v-object-handle = v-object-handle :next-sibling
     1295           .
     1296         end.
     1297         assign
     1298           v-field-group-handle = v-field-group-handle :next-sibling
     1299         .
     1300       end.
     1301       do with frame Dialog-Frame
     1302       :
     1303         hide v-diasize-resize-button .
     1304         assign
     1305           v-diasize-resize-button :row    = 1
     1306           v-diasize-resize-button :column = 1
     1307         .
     1308       end.
     1309       if p-change-value > 0
     1310       then do:
     1311         if frame Dialog-Frame :scrollable = true
     1312         then do:
     1313           assign
     1314             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1315             no-error .
     1316           if error-status :error
     1317           or error-status :get-message(1) <> ""
     1318           then do:
     1319             undo move_block, retry move_block .
     1320           end.
     1321         end.
     1322         assign
     1323           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1324           no-error .
     1325         if error-status :error
     1326         or error-status :get-message(1) <> ""
     1327         then do:
     1328           undo move_block, retry move_block .
     1329         end.
     1330         assign
     1331           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1332           no-error .
     1333         if error-status :error
     1334         or error-status :get-message(1) <> ""
     1335         then do:
     1336           undo move_block, retry move_block .
     1337         end.
     1338         for each buf_temp-browse-handle
     1339           where buf_temp-browse-handle.browse-type = 'height':u
     1340         on error undo move_block, retry move_block
     1341         :
     1342           assign
     1343             buf_temp-browse-handle.browse-handle :height
     1344               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1345             no-error .
     1346           if error-status :error
     1347           or error-status :get-message(1) <> ""
     1348           then do:
     1349             undo move_block, retry move_block .
     1350           end.
     1351         end.
     1352         for each buf_temp-diasize-handle
     1353         on error undo move_block, retry move_block
     1354         :
     1355           assign
     1356             v-object-handle = buf_temp-diasize-handle.handle-value
     1357           .
     1358           if v-object-handle <> v-diasize-resize-button
     1359           then do:
     1360             assign
     1361               v-object-handle :row = v-object-handle :row + p-change-value
     1362               no-error .
     1363             if error-status :error
     1364             or error-status :get-message(1) <> ""
     1365             then do:
     1366               undo move_block, retry move_block .
     1367             end.
     1368           end.
     1369         end.
     1370       end.
     1371       else do:
     1372         for each buf_temp-diasize-handle
     1373         on error undo move_block, retry move_block
     1374         :
     1375           assign
     1376             v-object-handle = buf_temp-diasize-handle.handle-value
     1377           .
     1378           if v-object-handle <> v-diasize-resize-button
     1379           then do:
     1380             assign
     1381               v-object-handle :row = v-object-handle :row + p-change-value
     1382               no-error .
     1383             if error-status :error
     1384             or error-status :get-message(1) <> ""
     1385             then do:
     1386               undo move_block, retry move_block .
     1387             end.
     1388           end.
     1389         end.
     1390         assign
     1391           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1392           no-error .
     1393         if error-status :error
     1394         or error-status :get-message(1) <> ""
     1395         then do:
     1396           undo move_block, retry move_block .
     1397         end.
     1398         for each buf_temp-browse-handle
     1399           where buf_temp-browse-handle.browse-type = 'height':u
     1400         on error undo move_block, retry move_block
     1401         :
     1402           assign
     1403             buf_temp-browse-handle.browse-handle :height
     1404               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1405             no-error .
     1406           if error-status :error
     1407           or error-status :get-message(1) <> ""
     1408           then do:
     1409             undo move_block, retry move_block .
     1410           end.
     1411         end.
     1412         assign
     1413           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1414           no-error .
     1415         if error-status :error
     1416         or error-status :get-message(1) <> ""
     1417         then do:
     1418           undo move_block, retry move_block .
     1419         end.
     1420         if frame Dialog-Frame :scrollable = true
     1421         then do:
     1422           assign
     1423             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1424             no-error .
     1425           if error-status :error
     1426           or error-status :get-message(1) <> ""
     1427           then do:
     1428             undo move_block, retry move_block .
     1429           end.
     1430         end.
     1431       end.
     1432       if p-move-resize = true
     1433       then do:
     1434         run diasize_position-resize-button in this-procedure .
     1435       end.
     1436       if v-diasize-wndstore = true
     1437       then do:
     1438         if connected("ub") = true
     1439         then do:
     1440           define variable v-cntxt-db-num        as integer   no-undo .
     1441           define variable v-cntxt-userid        as character no-undo .
     1442           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1443                                             , OUTPUT v-cntxt-userid
     1444                                             ) .
     1445           run gbl/wndsizew.p
     1446             (input  v-cntxt-db-num
     1447             ,input  v-cntxt-userid
     1448             ,input  v-diasize-proc-name
     1449             ,input  'height':u
     1450             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1451             ) .
     1452         end.
     1453       end.
     1454     end.
     1455     assign
     1456       v-diasize-change-size = false
     1457     .
     1458   end procedure.
     1459   procedure diasize_set-height :
     1460     define input  parameter p-new-height  as decimal   no-undo .
     1461     define input  parameter p-move-resize as logical   no-undo .
     1462     do
     1463     on error undo, return error return-value
     1464     :
     1465       run diasize_change-height in this-procedure
     1466         (input  (p-new-height - frame Dialog-Frame :height)
     1467         ,input  p-move-resize
     1468         ) .
     1469     end.
     1470   end procedure.
     1471   procedure diasize_change-width :
     1472     define input  parameter p-change-value as decimal   no-undo .
     1473     define input  parameter p-move-resize  as logical   no-undo .
     1474     define variable v-field-group-handle   as handle    no-undo .
     1475     define variable v-object-handle        as handle    no-undo .
     1476     define variable v-frame-width          as decimal   no-undo .
     1477     define variable v-frame-virtual-width  as decimal   no-undo .
     1478     define variable v-browse-width         as decimal   no-undo .
     1479     define variable v-window-width         as decimal   no-undo .
     1480     define variable v-window-virtual-width as decimal   no-undo .
     1481     define variable v-change-sign          as integer   no-undo .
     1482     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1483     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1484     if p-change-value > 0
     1485     then do:
     1486       if frame Dialog-Frame :width + p-change-value >
     1487           session :width-chars
     1488       then do:
     1489         assign
     1490           p-change-value = session :width-chars - frame Dialog-Frame :width
     1491         .
     1492         if p-change-value <= 0
     1493         then do:
     1494           run diasize_position-resize-button in this-procedure .
     1495           return .
     1496         end.
     1497       end.
     1498     end.
     1499     if p-change-value < 0
     1500     then do:
     1501       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1502       then do:
     1503         assign
     1504           p-change-value = v-diasize-orig-frame-width
     1505                          - frame Dialog-Frame :width
     1506         .
     1507         if p-change-value >= 0
     1508         then do:
     1509           run diasize_position-resize-button in this-procedure .
     1510           return .
     1511         end.
     1512       end.
     1513     end.
     1514     if p-change-value >= 0
     1515     then do:
     1516       assign
     1517         v-change-sign = 1
     1518       .
     1519     end.
     1520     else do:
     1521       assign
     1522         v-change-sign = -1
     1523       .
     1524     end.
     1525     assign
     1526       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1527     .
     1528     if p-change-value = 0
     1529     then do:
     1530       run diasize_position-resize-button in this-procedure .
     1531       return .
     1532     end.
     1533     move_block:
     1534     do
     1535     on error undo move_block, leave move_block
     1536     :
     1537       if retry
     1538       then do:
     1539         do
     1540         on error undo move_block, leave move_block
     1541         :
     1542           if p-change-value > 0
     1543           then do:
     1544             for each buf_temp-diasize-handle
     1545             on error undo, next
     1546             :
     1547               assign
     1548                 v-object-handle = buf_temp-diasize-handle.handle-value
     1549               .
     1550               if v-object-handle <> v-diasize-resize-button
     1551               then do:
     1552                 assign
     1553                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1554                 .
     1555               end.
     1556             end.
     1557             assign
     1558               v-diasize-browse-handle :width = v-browse-width
     1559             .
     1560             for each buf_temp-browse-handle
     1561               where buf_temp-browse-handle.browse-type = 'width':u
     1562             on error undo, next
     1563             :
     1564               assign
     1565                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1566               .
     1567             end.
     1568             assign
     1569               frame Dialog-Frame :width = v-frame-width
     1570             .
     1571             if frame Dialog-Frame :scrollable = true
     1572             then do:
     1573               assign
     1574                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1575               .
     1576             end.
     1577             run diasize_position-resize-button in this-procedure .
     1578           end.
     1579           else do:
     1580             if frame Dialog-Frame :scrollable = true
     1581             then do:
     1582               assign
     1583                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1584               .
     1585             end.
     1586             assign
     1587               frame Dialog-Frame :width = v-frame-width
     1588             .
     1589             for each buf_temp-browse-handle
     1590               where buf_temp-browse-handle.browse-type = 'width':u
     1591             on error undo, next
     1592             :
     1593               assign
     1594                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1595               .
     1596             end.
     1597             assign
     1598               v-diasize-browse-handle :width = v-browse-width
     1599             .
     1600             for each buf_temp-diasize-handle
     1601             on error undo, next
     1602             :
     1603               assign
     1604                 v-object-handle = buf_temp-diasize-handle.handle-value
     1605               .
     1606               if v-object-handle <> v-diasize-resize-button
     1607               then do:
     1608                 assign
     1609                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1610                 .
     1611               end.
     1612             end.
     1613             run diasize_position-resize-button in this-procedure .
     1614           end.
     1615           assign
     1616             v-diasize-change-size = false
     1617           .
     1618           leave move_block .
     1619         end.
     1620       end.
     1621       assign
     1622         v-diasize-need-full-display = true
     1623       .
     1624       if v-diasize-change-size = false
     1625       then do:
     1626         assign
     1627           v-diasize-change-size = true
     1628         .
     1629       end.
     1630       else do:
     1631         return .
     1632       end.
     1633       assign
     1634         v-frame-width = frame Dialog-Frame :width
     1635         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1636         v-browse-width = v-diasize-browse-handle :width
     1637       .
     1638       for each buf_temp-browse-handle
     1639         where buf_temp-browse-handle.browse-type = 'width':u
     1640       :
     1641         assign
     1642           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1643         .
     1644       end.
     1645       for each buf_temp-diasize-handle
     1646       :
     1647         delete buf_temp-diasize-handle .
     1648       end.
     1649       assign
     1650         v-field-group-handle = frame Dialog-Frame :first-child
     1651       .
     1652       do while valid-handle(v-field-group-handle)
     1653       :
     1654         assign
     1655           v-object-handle = v-field-group-handle :first-child
     1656         .
     1657         do while valid-handle(v-object-handle)
     1658         :
     1659           if  v-object-handle <> v-diasize-browse-handle :handle
     1660           and v-object-handle <> v-diasize-resize-button
     1661           and can-query(v-object-handle, "row")
     1662           and can-query(v-object-handle, "height")
     1663           and ( v-object-handle :col + v-object-handle :width
     1664                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1665               )
     1666           then do:
     1667             find first buf_temp-browse-handle
     1668               where buf_temp-browse-handle.browse-type   = 'width':u
     1669                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1670               no-error .
     1671             if available buf_temp-browse-handle
     1672             then do:
     1673             end.
     1674             else do:
     1675               create buf_temp-diasize-handle .
     1676               assign
     1677                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1678                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1679               .
     1680             end.
     1681           end.
     1682           assign
     1683             v-object-handle = v-object-handle :next-sibling
     1684           .
     1685         end.
     1686         assign
     1687           v-field-group-handle = v-field-group-handle :next-sibling
     1688         .
     1689       end.
     1690       do with frame Dialog-Frame
     1691       :
     1692         hide v-diasize-resize-button .
     1693         v-diasize-resize-button :row = 1.
     1694         v-diasize-resize-button :column = 1.
     1695       end.
     1696       if p-change-value > 0
     1697       then do:
     1698         if frame Dialog-Frame :scrollable = true
     1699         then do:
     1700           assign
     1701             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1702             no-error .
     1703           if error-status :error
     1704           or error-status :get-message(1) <> ""
     1705           then do:
     1706             undo move_block, retry move_block.
     1707           end.
     1708         end.
     1709         assign
     1710           frame Dialog-Frame :width = v-frame-width + p-change-value
     1711           no-error .
     1712         if error-status :error
     1713         or error-status :get-message(1) <> ""
     1714         then do:
     1715           undo move_block, retry move_block.
     1716         end.
     1717         assign
     1718           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1719         no-error .
     1720         if error-status :error
     1721         or error-status :get-message(1) <> ""
     1722         then do:
     1723           undo move_block, retry move_block.
     1724         end.
     1725         for each buf_temp-browse-handle
     1726           where buf_temp-browse-handle.browse-type = 'width':u
     1727         on error undo move_block, retry move_block
     1728         :
     1729           assign
     1730             buf_temp-browse-handle.browse-handle :width
     1731               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1732             no-error .
     1733           if error-status :error
     1734           or error-status :get-message(1) <> ""
     1735           then do:
     1736             undo move_block, retry move_block .
     1737           end.
     1738         end.
     1739         for each buf_temp-diasize-handle
     1740         on error undo move_block, retry move_block
     1741         :
     1742           assign
     1743             v-object-handle = buf_temp-diasize-handle.handle-value
     1744           .
     1745           if v-object-handle <> v-diasize-resize-button
     1746           then do:
     1747             assign
     1748               v-object-handle :col = v-object-handle :col + p-change-value
     1749               no-error .
     1750             if error-status :error
     1751             or error-status :get-message(1) <> ""
     1752             then do:
     1753               undo move_block, retry move_block .
     1754             end.
     1755           end.
     1756         end.
     1757       end.
     1758       else do:
     1759         for each buf_temp-diasize-handle
     1760         on error undo move_block, retry move_block
     1761         :
     1762           assign
     1763             v-object-handle = buf_temp-diasize-handle.handle-value
     1764           .
     1765           if v-object-handle <> v-diasize-resize-button
     1766           then do:
     1767             assign
     1768               v-object-handle :col = v-object-handle :col + p-change-value
     1769               no-error .
     1770             if error-status :error
     1771             or error-status :get-message(1) <> ""
     1772             then do:
     1773               undo move_block, retry move_block .
     1774             end.
     1775           end.
     1776         end.
     1777         for each buf_temp-browse-handle
     1778           where buf_temp-browse-handle.browse-type = 'width':u
     1779         on error undo move_block, retry move_block
     1780         :
     1781           assign
     1782             buf_temp-browse-handle.browse-handle :width
     1783               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1784             no-error .
     1785           if error-status :error
     1786           or error-status :get-message(1) <> ""
     1787           then do:
     1788             undo move_block, retry move_block .
     1789           end.
     1790         end.
     1791         assign
     1792           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1793           no-error .
     1794         if error-status :error
     1795         or error-status :get-message(1) <> ""
     1796         then do:
     1797           undo move_block, retry move_block.
     1798         end.
     1799         assign
     1800           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1801         no-error .
     1802         if error-status :error
     1803         or error-status :get-message(1) <> ""
     1804         then do:
     1805           undo move_block, retry move_block.
     1806         end.
     1807         if frame Dialog-Frame :scrollable = true
     1808         then do:
     1809           assign
     1810             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1811           no-error .
     1812           if error-status :error
     1813           or error-status :get-message(1) <> ""
     1814           then do:
     1815             undo move_block, retry move_block.
     1816           end.
     1817         end.
     1818       end.
     1819       if p-move-resize
     1820       then do:
     1821         run diasize_position-resize-button in this-procedure .
     1822       end.
     1823       if v-diasize-wndstore = true
     1824       then do:
     1825         if connected("ub") = true
     1826         then do:
     1827           define variable v-cntxt-db-num        as integer   no-undo .
     1828           define variable v-cntxt-userid        as character no-undo .
     1829           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1830                                             , OUTPUT v-cntxt-userid
     1831                                             ) .
     1832           run gbl/wndsizew.p
     1833             (input  v-cntxt-db-num
     1834             ,input  v-cntxt-userid
     1835             ,input  v-diasize-proc-name
     1836             ,input  'width':u
     1837             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1838             ) .
     1839         end.
     1840       end.
     1841     end.
     1842     assign
     1843       v-diasize-change-size = false
     1844     .
     1845   end procedure.
     1846   procedure diasize_set-width :
     1847     define input  parameter p-new-width  as decimal   no-undo .
     1848     define input  parameter p-move-resize as logical   no-undo .
     1849     do
     1850     on error undo, return error return-value
     1851     :
     1852       run diasize_change-width in this-procedure
     1853         (input  (p-new-width - frame Dialog-Frame :width)
     1854         ,input  p-move-resize
     1855         ) .
     1856     end.
     1857   end procedure.
     1858   procedure diasize_position-resize-button :
     1859     do with frame Dialog-Frame
     1860     :
     1861       hide v-diasize-resize-button .
     1862       assign
     1863         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1864                     - 1
     1865                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1866         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1867                     - 1
     1868                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1869       .
     1870       view v-diasize-resize-button .
     1871     end.
     1872   end procedure.
     1873   on alt-right anywhere
     1874   do:
     1875     run diasize_change-width in this-procedure
     1876       (input 1
     1877       ,input true
     1878       ) .
     1879     return no-apply .
     1880   end.
     1881   on alt-left anywhere
     1882   do:
     1883     run diasize_change-width in this-procedure
     1884       (input -1
     1885       ,input true
     1886       ) .
     1887     return no-apply .
     1888   end.
     1889   on alt-down anywhere
     1890   do:
     1891     run diasize_change-height in this-procedure
     1892       (input 1
     1893       ,input true
     1894       ) .
     1895     return no-apply .
     1896   end.
     1897   on alt-up anywhere
     1898   do:
     1899     run diasize_change-height in this-procedure
     1900       (input -1
     1901       ,input true
     1902       ) .
     1903     return no-apply .
     1904   end.
     1905   on alt-enter of frame Dialog-Frame
     1906   do:
     1907     run diasize_maximize in this-procedure
     1908       (input  ?
     1909       ).
     1910     return no-apply .
     1911   end.
     1912   procedure diasize_end-move :
     1913     do
     1914     on error undo, return error return-value
     1915     :
     1916       define variable v-row-delta as decimal   no-undo .
     1917       define variable v-col-delta as decimal   no-undo .
     1918       define variable v-new-row as decimal   no-undo .
     1919       define variable v-new-col as decimal   no-undo .
     1920       assign
     1921         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1922         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1923       .
     1924       assign
     1925         v-row-delta = v-new-row - frame Dialog-Frame :height
     1926         v-col-delta = v-new-col - frame Dialog-Frame :width
     1927       .
     1928       run diasize_change-height in this-procedure
     1929         (input v-row-delta
     1930         ,input true
     1931         ) .
     1932       run diasize_change-width in this-procedure
     1933         (input v-col-delta
     1934         ,input true
     1935         ) .
     1936     end.
     1937   end procedure.
     1938   procedure diasize_maximize :
     1939     define input  parameter p-action as logical   no-undo .
     1940     do
     1941     on error undo, return error return-value
     1942     :
     1943       if p-action = ?
     1944       then do:
     1945         if v-diasize-need-maximize = true
     1946         then do:
     1947           assign
     1948             p-action = true
     1949           .
     1950         end.
     1951         else do:
     1952           assign
     1953             p-action = false
     1954           .
     1955         end.
     1956       end.
     1957       if p-action = true
     1958       then do:
     1959         run diasize_change-height in this-procedure
     1960           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1961               - frame Dialog-Frame :height-chars
     1962           ,input true
     1963           ) .
     1964         run diasize_change-width in this-procedure
     1965           (input session :width-chars
     1966               - frame Dialog-Frame :width-chars
     1967           ,input true
     1968           ) .
     1969         assign
     1970           v-diasize-need-maximize = false
     1971         .
     1972       end.
     1973       else do:
     1974         run diasize_change-width in this-procedure
     1975           (input v-diasize-orig-frame-width
     1976               - frame Dialog-Frame :width-chars
     1977           ,input true
     1978           ) .
     1979         run diasize_change-height in this-procedure
     1980           (input v-diasize-orig-frame-height
     1981               - frame Dialog-Frame :height-chars
     1982           ,input true
     1983           ) .
     1984         assign
     1985           v-diasize-need-maximize = true
     1986         .
     1987       end.
     1988     end.
     1989   end procedure.
     1990   procedure diasize_restore-orig-size :
     1991     do
     1992     on error undo, return error return-value
     1993     :
     1994       assign
     1995         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1996         v-diasize-current-frame-height = frame Dialog-Frame :height
     1997       .
     1998       run diasize_set-height in this-procedure
     1999         (input  v-diasize-orig-frame-height
     2000         ,input  true
     2001         ) .
     2002       run diasize_set-width in this-procedure
     2003         (input  v-diasize-orig-frame-width
     2004         ,input  true
     2005         ) .
     2006     end.
     2007   end procedure.
     2008   procedure diasize_restore-current-size :
     2009     do
     2010     on error undo, return error return-value
     2011     :
     2012       run diasize_set-height in this-procedure
     2013         (input  v-diasize-current-frame-height
     2014         ,input  true
     2015         ) .
     2016       run diasize_set-width in this-procedure
     2017         (input  v-diasize-current-frame-width
     2018         ,input  true
     2019         ) .
     2020     end.
     2021   end procedure.
     2022   procedure diasize_set-browse-handle :
     2023     define input  parameter p-browse-handle as handle   no-undo .
     2024     define buffer buf_temp-browse-handle for temp-browse-handle .
     2025     do
     2026     on error undo, return error return-value
     2027     :
     2028       assign
     2029         v-diasize-browse-handle = p-browse-handle
     2030       .
     2031       for each buf_temp-browse-handle
     2032       on error undo, return error return-value
     2033       :
     2034         delete buf_temp-browse-handle .
     2035       end.
     2036     end.
     2037   end procedure.
     2038   procedure diasize_add_browse :
     2039     define input  parameter p-browse-type   as character no-undo .
     2040     define input  parameter p-browse-handle as handle    no-undo .
     2041     define buffer buf_temp-browse-handle for temp-browse-handle .
     2042     do
     2043     on error undo, return error return-value
     2044     :
     2045       assign
     2046         v-diasize-browse-number = v-diasize-browse-number + 1
     2047       .
     2048       create buf_temp-browse-handle .
     2049       assign
     2050         buf_temp-browse-handle.browse-type   = p-browse-type
     2051         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2052         buf_temp-browse-handle.browse-handle = p-browse-handle
     2053       .
     2054     end.
     2055   end procedure.
     2056   procedure diasize_init :
     2057     define variable v-default-value    as logical   no-undo .
     2058     define variable v-restore-saved    as logical   no-undo .
     2059     define variable v-resize-value-str as character no-undo .
     2060     do
     2061     on error undo, return error return-value
     2062     :
     2063       do with frame Dialog-Frame
     2064       :
     2065         assign
     2066           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2067           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2068           v-diasize-browse-handle     = browse BR-norm-loss :handle
     2069         .
     2070         create button v-diasize-resize-button
     2071         assign
     2072           parent        = frame Dialog-Frame :first-child
     2073           label         = "s"
     2074           height-pixels = 16
     2075           width-pixels  = 16
     2076           visible       = true
     2077           sensitive     = true
     2078           movable       = true
     2079           triggers:
     2080             on end-move persistent run diasize_end-move in this-procedure .
     2081           end triggers.
     2082         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2083         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2084         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2085         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2086         assign
     2087           v-diasize-wndmax = false
     2088         .
     2089         if connected("ub") = true
     2090         then do:
     2091           define variable v-cntxt-db-num        as integer   no-undo .
     2092           define variable v-cntxt-userid        as character no-undo .
     2093           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2094                                             , OUTPUT v-cntxt-userid
     2095                                             ) .
     2096           run gbl/wndpar_r.p
     2097             (input  v-cntxt-db-num
     2098             ,input  v-cntxt-userid
     2099             ,input  'wndmax':U
     2100             ,output v-diasize-wndmax
     2101             ,output v-default-value
     2102             ) .
     2103         end.
     2104         assign
     2105           v-diasize-wndstore = false
     2106         .
     2107         if connected("ub") = true
     2108         then do:
     2109           run gbl/wndpar_r.p
     2110             (input  v-cntxt-db-num
     2111             ,input  v-cntxt-userid
     2112             ,input  'wndstore':U
     2113             ,output v-diasize-wndstore
     2114             ,output v-default-value
     2115             ) .
     2116         end.
     2117         assign
     2118           v-diasize-proc-name = entry(1, program-name(2), '.')
     2119         .
     2120         if v-diasize-wndstore = true
     2121         then do:
     2122           assign
     2123             v-restore-saved = false
     2124           .
     2125           if connected("ub") = true
     2126           then do:
     2127             run gbl/wndsizer.p
     2128               (input  v-cntxt-db-num
     2129               ,input  v-cntxt-userid
     2130               ,input  v-diasize-proc-name
     2131               ,input  'height':u
     2132               ,output v-resize-value-str
     2133               ) .
     2134             if v-resize-value-str <> '':U
     2135             then do:
     2136               run diasize_change-height in this-procedure
     2137                 (input  integer(v-resize-value-str)
     2138                 ,input  true
     2139                 ) .
     2140               assign
     2141                 v-restore-saved = true
     2142               .
     2143             end.
     2144           end.
     2145           if connected("ub") = true
     2146           then do:
     2147             run gbl/wndsizer.p
     2148               (input  v-cntxt-db-num
     2149               ,input  v-cntxt-userid
     2150               ,input  v-diasize-proc-name
     2151               ,input  'width':u
     2152               ,output v-resize-value-str
     2153               ) .
     2154             if v-resize-value-str <> '':U
     2155             then do:
     2156               run diasize_change-width in this-procedure
     2157                 (input  integer(v-resize-value-str)
     2158                 ,input  true
     2159                 ) .
     2160               assign
     2161                 v-restore-saved = true
     2162               .
     2163             end.
     2164           end.
     2165           if v-restore-saved <> true
     2166           then do:
     2167             if v-diasize-wndmax = true
     2168             then do:
     2169               run diasize_maximize in this-procedure
     2170                 (input  true
     2171                 ) .
     2172             end.
     2173           end.
     2174         end.
     2175         else do:
     2176           if v-diasize-wndmax = true
     2177           then do:
     2178             run diasize_maximize in this-procedure
     2179               (input  true
     2180               ) .
     2181           end.
     2182         end.
     2183       end.
     2184     end.
     2185   end procedure.
     2186   procedure diasize_need-full-display :
     2187     define output parameter p-need-full-display as logical   no-undo .
     2188     do
     2189     on error undo, return error return-value
     2190     :
     2191       assign
     2192         p-need-full-display = v-diasize-need-full-display
     2193       .
     2194       assign
     2195         v-diasize-need-full-display = false
     2196       .
     2197     end.
     2198   end procedure.
     2199   procedure get-context :
     2200      define output parameter p-db-num as integer          no-undo.
     2201      define output parameter p-user-id as character        no-undo.
     2202      define variable v-login               as character    no-undo.
     2203      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2204      define buffer buf_user-login  for ub.user-login .
     2205      do
     2206      on error undo, return error
     2207      :
     2208            FIND FIRST buf_sys-ctrl no-lock.
     2209            ASSIGN
     2210               v-login = USERID("ub")
     2211               p-db-num = buf_sys-ctrl.db-num
     2212            .
     2213            FIND FIRST buf_user-login
     2214                 WHERE buf_user-login.db-num = p-db-num
     2215                   AND buf_user-login.user-login = v-login
     2216                 no-lock
     2217                 no-error
     2218                 .
     2219            IF AVAILABLE buf_user-login
     2220            THEN DO:
     2221               assign
     2222                  p-user-id = buf_user-login.user-id
     2223               .
     2224            END.
     2225      end.
     2226   end procedure.
     2227       run diasize_init in this-procedure .
     2228   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2229   on F2 of frame Dialog-Frame anywhere do:
     2230     if b-exit :sensitive then DO: apply "CHOOSE":U to b-exit in frame Dialog-Frame. END.
     2231     return no-apply.
     2232   end.
     2233   MAIN-BLOCK:
     2234   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2235     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2236     run init-tt-table in this-procedure .
     2237     RUN my-enable in this-procedure .
     2238     WAIT-FOR GO OF FRAME Dialog-Frame.
     2239   END.
     2240   RUN my-disable.
     2241   PROCEDURE disable_UI :
     2242     HIDE FRAME Dialog-Frame.
     2243   END PROCEDURE.
     2244   PROCEDURE enable_UI :
     2245     ENABLE B-exit b-print B-Help
     2246         WITH FRAME Dialog-Frame.
     2247     VIEW FRAME Dialog-Frame.
     2248     OPEN QUERY BR-norm-loss FOR EACH tt-norm-loss NO-LOCK by tt-norm-loss.sec-vol by tt-norm-loss.clim-grp by tt-norm-loss.oil-grp by tt-norm-loss.season INDEXED-REPOSITION.
     2249   END PROCEDURE.
     2250   PROCEDURE init-tt-table :
     2251     for each buf_norm-loss no-lock where buf_norm-loss.type = 1:
     2252       create tt-norm-loss .
     2253       buffer-copy buf_norm-loss except buf_norm-loss.season buf_norm-loss.position buf_norm-loss.sec-vol1 buf_norm-loss.sec-vol2 to tt-norm-loss no-error .
     2254       if buf_norm-loss.season = 0 then tt-norm-loss.season = "В-Л" .
     2255       else tt-norm-loss.season = "О-З" .
     2256       if buf_norm-loss.position = "0" then tt-norm-loss.position = "наземный" .
     2257       else tt-norm-loss.position = "подземный" .
     2258       tt-norm-loss.sec-vol = string(buf_norm-loss.sec-vol1) +
     2259       if buf_norm-loss.sec-vol2 <> 0 then "-" + string(buf_norm-loss.sec-vol2) else "".
     2260     end.
     2261   END PROCEDURE.
     2262   PROCEDURE my-disable :
     2263     run disable_UI in this-procedure .
     2264   END PROCEDURE.
     2265   PROCEDURE my-enable :
     2266     enable
     2267       b-exit
     2268       b-help
     2269       b-print
     2270       br-norm-loss
     2271       with frame Dialog-Frame.
     2272     disable
     2273       b-add
     2274       with frame Dialog-Frame .
     2275     view frame Dialog-Frame.
     2276     OPEN QUERY BR-norm-loss FOR EACH tt-norm-loss NO-LOCK by tt-norm-loss.sec-vol by tt-norm-loss.clim-grp by tt-norm-loss.oil-grp by tt-norm-loss.season INDEXED-REPOSITION.
     2277   END PROCEDURE.
     2278   PROCEDURE proc-b-print :
     2279       run rep/print_NormLoss.p (
     2280             input parParentProc
     2281           , input 1
     2282       ) no-error .
     2283   END PROCEDURE.
