     1612   format "X(14)" label "Панировка"
     1613   view-as combo-box list-items "-", "панированные", "непанированные"  inner-lines 3 drop-down-list size-chars 20  by 1
     1614   field subkind-name-6 as character column-label "Фасовка" help "Полуфабрикаты, объединенные по технологии изготовления"
     1615   format "X(10)" label "Фасовка"
