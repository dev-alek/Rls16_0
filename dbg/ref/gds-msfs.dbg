     1637   .
     1638   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1639   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1640   procedure meatsemi_fill-msf :
     1641   define input parameter p-mode as character no-undo .
     1642   define parameter buffer buf_clob-bind for ub.clob-bind.
     1643   define buffer buf_clob-data for ub.clob-data.
     1644   define variable v-longchar as longchar no-undo .
     1645   define variable glog as logical no-undo .
     1646   case p-mode:
     1647     when  'ИЗМЕНЕНИЕ':U then do:
     1648      find first buf_clob-bind exclusive-lock where
     1649               buf_clob-bind.resource-type = 'ref':U
     1650          and buf_clob-bind.uniq-key-rec = "meat-semi-finished.xml"
     1651          and buf_clob-bind.field-name = "" no-error.
     1652     end.
     1653     otherwise do:
     1654       find first buf_clob-bind no-lock where
     1655               buf_clob-bind.resource-type = 'ref':U
     1656          and buf_clob-bind.uniq-key-rec = "meat-semi-finished.xml"
     1657          and buf_clob-bind.field-name = "" no-error.
     1658     end.
     1659   end case.
     1660   if available buf_clob-bind then do:
     1661     find first buf_clob-data no-lock where
     1662               buf_clob-data.db-num = buf_clob-bind.db-num
     1663           and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     1664     if available buf_clob-data then do:
     1665       v-longchar = buf_clob-data.cdata.
     1666       glog = DATASET meat-semi-finished-ds:HANDLE:read-XML("LONGCHAR"
     1667                                                   , v-longchar
     1668                                                   , "EMPTY"
     1669                                                   , ?
     1670                                                   , ?
     1671                                                   , ?
     1672                                                   , "loose"   )  no-error .
     1673       if error-status:error
     1674       or not glog then do:
     1675         MESSAGE
     1676         "НЕ удается прочитать из БД классификатор" skip
     1677         ERROR-STATUS:GET-MESSAGE(1) SKIP
     1678         RETURN-VALUE
     1679         VIEW-AS ALERT-BOX ERROR.
     1680         UNDO, RETURN ERROR.
     1681       end.
     1682     end.
     1683   end.
     1684   end procedure.
     1685   define variable sort-column-name as character no-undo.
     1686   define variable filter-point     as character NO-UNDO INIT "gds-msfs".
     1687   define variable filter-label     as character NO-UNDO INIT "Товары-мясные полуфабрикаты".
     1688   define variable filter-point0     as character NO-UNDO INIT "gds-msfs".
     1689   define variable filter-label0     as character NO-UNDO INIT "Товары-мясные полуфабрикаты".
     1690   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1691   define buffer buf_clob-bind for ub.clob-bind.
     1692   define variable v-tbl-row as rowid no-undo .
     1693   define variable v-tbl-name as character no-undo .
     1694   define buffer buf_goods for ub.goods.
     1695   define buffer buf_msf for meat-semi-finished.
     1696   FUNCTION get-cli-type-code RETURNS CHARACTER
     1697     ( INPUT p-uniq-key-rec AS character )  FORWARD.
     1698   FUNCTION get-gds-name RETURNS CHARACTER
     1699     ( INPUT p-uniq-key-rec AS CHARACTER )  FORWARD.
     1700   DEFINE BUTTON b-add
     1701        LABEL "&Добавить"
     1702        SIZE 10 BY 1.
     1703   DEFINE BUTTON b-del
     1704        LABEL "&Удалить"
     1705        SIZE 10 BY 1.
     1706   DEFINE BUTTON b-gds
     1707        LABEL "Товар"
     1708        SIZE 10 BY 1.
     1709   DEFINE BUTTON B-Help
     1710        LABEL "Помо&щь"
     1711        SIZE 3 BY 1
     1712        BGCOLOR 8 .
     1713   DEFINE BUTTON B-mark
     1714        LABEL "&*"
     1715        SIZE 3 BY 1.
     1716   DEFINE BUTTON b-print
     1717        LABEL "&Печать"
     1718        SIZE 3 BY 1.
     1719   DEFINE BUTTON b-quit AUTO-END-KEY
     1720        LABEL "&Выход"
     1721        SIZE 10 BY 1
     1722        BGCOLOR 8 .
     1723   DEFINE BUTTON b-sch
     1724        LABEL "Фильтр"
     1725        SIZE 3 BY 1.
     1726   DEFINE BUTTON B-sel AUTO-GO
     1727        LABEL "Вы&бор"
     1728        SIZE 10 BY 1.
     1729   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1730         VIEW-AS TEXT
     1731        SIZE 6 BY 1
     1732        FGCOLOR 4  NO-UNDO.
     1733   DEFINE QUERY br-msf-codes FOR X_ext-classif, X_goods SCROLLING.
     1734   DEFINE BROWSE br-msf-codes
     1735     QUERY br-msf-codes NO-LOCK DISPLAY
     1736         mark-string(recid(X_ext-classif), v-rid-list) COLUMN-LABEL "" FORMAT "X(1)"
     1737   X_ext-classif.KEY#_one  COLUMN-LABEL "Код в!класс-ре" FORMAT ">>>>>>>>9"
     1738   X_goods.gds-code COLUMN-LABEL "Код!Товара" FORMAT ">>>>>>>>9"
     1739   X_goods.gds-name COLUMN-LABEL "Название товара" FORMAT "X(60)"
     1740       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.3 BY 12 FIT-LAST-COLUMN.
     1741   DEFINE FRAME Dialog-Frame
     1742        b-quit AT ROW 1 COL 1
     1743        B-mark AT ROW 1 COL 11 WIDGET-ID 4
     1744        B-sel AT ROW 1 COL 21 WIDGET-ID 6
     1745        b-add AT ROW 1 COL 31 WIDGET-ID 14
     1746        b-del AT ROW 1 COL 41 WIDGET-ID 16
     1747        b-gds AT ROW 1 COL 61 WIDGET-ID 2
     1748        b-sch AT ROW 1 COL 86 WIDGET-ID 12
     1749        b-print AT ROW 1 COL 89 WIDGET-ID 10
     1750        B-Help AT ROW 1 COL 95
     1751        br-msf-codes AT ROW 2.87 COL 1.5 WIDGET-ID 100
     1752        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL WIDGET-ID 8
     1753        SPACE(79.30) SKIP(21.26)
     1754       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1755            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1756            TITLE ""
     1757            CANCEL-BUTTON b-quit.
     1758   ASSIGN
     1759          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1760          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1761   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1762   DO:
     1763     APPLY "END-ERROR":U TO SELF.
     1764   END.
     1765   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1766   DO:
     1767     RUN proc-b-add IN THIS-PROCEDURE NO-ERROR.
     1768     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1769   END.
     1770   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1771   DO:
     1772     IF NOT AVAILABLE X_ext-classif THEN RETURN NO-APPLY.
     1773     RUN proc-b-del IN THIS-PROCEDURE NO-ERROR.
     1774     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1775   END.
     1776   ON CHOOSE OF b-gds IN FRAME Dialog-Frame
     1777   DO:
     1778     IF NOT AVAILABLE X_goods THEN RETURN NO-APPLY.
     1779     run str/showgds.p ( input parparentproc
     1780                       ,input ?
     1781                       ,input X_goods.gds-code
     1782                       ,input 'ПРОСМОТР':U) no-error.
     1783     APPLY "entry" TO br-msf-codes.
     1784   END.
     1785   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1786   DO:
     1787     define variable loc#log as logical no-undo .
     1788     if available X_ext-classif then do:
     1789   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1790   define variable v-str-recid20 as character no-undo .
     1791   define variable v-num-entry20 as integer   no-undo .
     1792   assign
     1793     v-str-recid20 = trim( string( recid( X_ext-classif ) , "->>>>>>>>>>>9":U ) )
     1794     v-num-entry20 = lookup( v-str-recid20 , v-rid-list )
     1795   .
     1796   if v-num-entry20 > 0 then do:
     1797     assign
     1798       entry( v-num-entry20, v-rid-list ) = "":U
     1799       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1800     .
     1801   end.
     1802   else do:
     1803     assign
     1804       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid20
     1805     .
     1806   end.
     1807       loc#log = br-msf-codes:refresh() .
     1808       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1809           loc#log = br-msf-codes:select-next-row ().
     1810           apply "VALUE-CHANGED" to br-msf-codes in frame Dialog-Frame.
     1811       end.
     1812       if num-entries( v-rid-list ) = 0
     1813       then
     1814           hide mark-num in frame Dialog-Frame.
     1815       else
     1816           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1817     end.
     1818     apply "entry" to br-msf-codes in frame Dialog-Frame.
     1819   END.
     1820   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     1821   DO:
     1822     run proc-b-print IN THIS-PROCEDURE NO-ERROR.
     1823     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1824   END.
     1825   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1826   DO:
     1827     run proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1828     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1829   END.
     1830   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1831   DO:
     1832       if ( available X_ext-classif ) then do:
     1833       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1834       then
     1835       v-rid-list = string( recid( X_ext-classif ) ) .
     1836     end.
     1837   END.
     1838   ON VALUE-CHANGED OF br-msf-codes IN FRAME Dialog-Frame
     1839   DO:
     1840     IF AVAILABLE X_ext-classif THEN DO:
     1841       FIND FIRST meat-semi-finished WHERE
     1842                  meat-semi-finished.node-code = X_ext-classif.key#_one NO-ERROR.
     1843       IF AVAILABLE meat-semi-finished THEN DO:
     1844         ASSIGN
     1845         dop-msf.node-code =  meat-semi-finished.node-code
     1846         dop-msf.group-name =  meat-semi-finished.group-name
     1847         dop-msf.kind-name  =  meat-semi-finished.kind-name
     1848         dop-msf.subkind-name-1 = meat-semi-finished.subkind-name-1
     1849         dop-msf.subkind-name-2 = meat-semi-finished.subkind-name-2
     1850         dop-msf.subkind-name-3 = meat-semi-finished.subkind-name-3
     1851         dop-msf.subkind-name-4  = meat-semi-finished.subkind-name-4
     1852         dop-msf.subkind-name-5 = meat-semi-finished.subkind-name-5
     1853         dop-msf.subkind-name-6 = meat-semi-finished.subkind-name-6
     1854         dop-msf.category-name = meat-semi-finished.category-name
     1855         dop-msf.termic-condition-name = meat-semi-finished.termic-condition-name
     1856         .
     1857         DISPLAY dop-msf.node-code AT ROW 16 COL 5 COLON-ALIGN  dop-msf.group-name AT ROW 16 COL 17 COLON-ALIGN dop-msf.kind-name AT ROW 16 COL 54 COLON-ALIGN SKIP dop-msf.subkind-name-1 AT ROW 17 COL 17 COLON-ALIGN dop-msf.subkind-name-2 AT ROW 17 COL 54 COLON-ALIGN SKIP dop-msf.subkind-name-3 AT ROW 18 COL 17 colon-align dop-msf.subkind-name-4 AT ROW 18 COL 54 COLON-ALIGN SKIP dop-msf.subkind-name-5 AT ROW 19 COL 17 colon-align dop-msf.subkind-name-6 AT ROW 19 COL 54 COLON-ALIGN SKIP  dop-msf.category-name AT ROW 20 COL 17 COLON-ALIGN dop-msf.termic-condition-name AT ROW 20 COL 54 COLON-ALIGN with FRAME Dialog-Frame.
     1858       END.
     1859       ELSE DO:
     1860         disable dop-msf.node-code dop-msf.group-name dop-msf.kind-name dop-msf.subkind-name-1  dop-msf.subkind-name-2  dop-msf.subkind-name-3  dop-msf.subkind-name-4  dop-msf.subkind-name-5  dop-msf.subkind-name-6  dop-msf.category-name   dop-msf.termic-condition-name with FRAME Dialog-Frame. hide dop-msf.node-code in FRAME Dialog-Frame dop-msf.group-name dop-msf.kind-name dop-msf.subkind-name-1  dop-msf.subkind-name-2  dop-msf.subkind-name-3  dop-msf.subkind-name-4  dop-msf.subkind-name-5  dop-msf.subkind-name-6  dop-msf.category-name   dop-msf.termic-condition-name in FRAME Dialog-Frame.
     1861       END.
     1862     END.
     1863     ELSE DO:
     1864       disable dop-msf.node-code dop-msf.group-name dop-msf.kind-name dop-msf.subkind-name-1  dop-msf.subkind-name-2  dop-msf.subkind-name-3  dop-msf.subkind-name-4  dop-msf.subkind-name-5  dop-msf.subkind-name-6  dop-msf.category-name   dop-msf.termic-condition-name with FRAME Dialog-Frame. hide dop-msf.node-code in FRAME Dialog-Frame dop-msf.group-name dop-msf.kind-name dop-msf.subkind-name-1  dop-msf.subkind-name-2  dop-msf.subkind-name-3  dop-msf.subkind-name-4  dop-msf.subkind-name-5  dop-msf.subkind-name-6  dop-msf.category-name   dop-msf.termic-condition-name in FRAME Dialog-Frame.
     1865     END.
     1866   END.
     1867   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1868   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1869   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1870   on help of frame Dialog-Frame
     1871   do:
     1872     run gbl/app_help.p
     1873       (input this-procedure :file-name
     1874       ,input ''
     1875       ,input ?
     1876       ) no-error.
     1877     if error-status :error then do:
     1878       message
     1879         "Ошибка при вызове помощи"
     1880         error-status :get-message(1)
     1881         view-as alert-box .
     1882     end.
     1883   end.
     1884   run minbtn-set in this-procedure .
     1885   on choose of b-help in frame Dialog-Frame
     1886   do:
     1887     apply "help":u to frame Dialog-Frame .
     1888   end.
     1889   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1890   procedure minbtn-set :
     1891       do
     1892           on error undo, return error return-value
     1893           :
     1894           define variable ii              as integer       no-undo .
     1895           define variable fh              as widget-handle no-undo .
     1896           define variable hh              as widget-handle no-undo .
     1897           define variable v-h             as handle        extent 4 no-undo .
     1898           define variable v-name-button   as character     no-undo .
     1899           define variable v-help-old-x    as decimal       no-undo .
     1900           define variable v-help-old-y    as decimal       no-undo .
     1901           define variable v-help-old-size as decimal       no-undo .
     1902           define variable v-frame-width   as decimal       no-undo .
     1903           define variable jj              as integer       no-undo .
     1904           do
     1905               on error undo, return error
     1906               :
     1907               assign
     1908                   v-frame-width = frame Dialog-Frame:width - 0.3
     1909                   fh            = frame Dialog-Frame:first-child
     1910                   hh            = fh:first-child
     1911                   ii            = 1
     1912                   .
     1913               do while valid-handle(hh):
     1914                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1915                   do:
     1916                       case lc(hh:name) :
     1917                           when "b-help" then
     1918                               do:
     1919                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1920                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1921                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1922                                   hh:TOOLTIP = "Помощь" .
     1923                                   v-help-old-x = hh:column .
     1924                                   v-help-old-y = hh:row    .
     1925                                   v-help-old-size = hh:width .
     1926                                   hh:width-chars = 2.5 .
     1927                               end.
     1928                           when "b-print" then
     1929                               do:
     1930                                   hh:load-image("cmp/b-print.bmp":u) .
     1931                                   hh:TOOLTIP = "Печать" .
     1932                                   v-h[ii] = hh:handle .
     1933                                   ii = ii + 1 .
     1934                                   hh:width-chars = 3 .
     1935                               end.
     1936                           when "b-history" or
     1937                           when "b-hist" then
     1938                               do:
     1939                                   hh:load-image("cmp/b-hist.bmp":u) .
     1940                                   hh:TOOLTIP = "История" .
     1941                                   v-h[ii] = hh:handle .
     1942                                   ii = ii + 1 .
     1943                                   hh:width-chars = 3 .
     1944                               end.
     1945                           when "b-sch" then
     1946                               do:
     1947                                   hh:load-image("cmp/b-sch.bmp":u) .
     1948                                   hh:TOOLTIP = "Установка Фильтра" .
     1949                                   v-h[ii] = hh:handle .
     1950                                   ii = ii + 1 .
     1951                                   hh:width-chars = 3 .
     1952                               end.
     1953                           when "b-hist-user" then
     1954                               do:
     1955                                   hh:load-image("cmp/b-hist.bmp":u) .
     1956                                   hh:TOOLTIP = "История пользователя" .
     1957                                   ii = ii + 1 .
     1958                               end.
     1959                       end case.
     1960                   end.
     1961                   hh = hh:next-sibling.
     1962               end.
     1963               b-help:column = v-frame-width - b-help:width-chars.
     1964               jj = 0.
     1965               repeat ii = 4 to 1 by -1 :
     1966                   if valid-handle (v-h[ii] ) then
     1967                   do:
     1968                       jj  = jj + 1 .
     1969                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1970                       v-h[ii]:row    = v-help-old-y .
     1971                   end.
     1972               end.
     1973           end.
     1974       end.
     1975   end procedure.
     1976   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1977   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1978   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1979   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1980   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1981   define variable v-diasize-current-frame-height as decimal   no-undo .
     1982   define variable v-diasize-change-size          as logical   no-undo .
     1983   define variable v-diasize-resize-button        as handle    no-undo .
     1984   define variable v-diasize-wndmax               as logical   no-undo .
     1985   define variable v-diasize-wndstore             as logical   no-undo .
     1986   define variable v-diasize-proc-name            as character no-undo .
     1987   define variable v-diasize-browse-handle        as handle    no-undo .
     1988   define variable v-diasize-browse-number        as integer   no-undo .
     1989   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1990   define temp-table temp-diasize-handle no-undo
     1991     field handle-value  as handle
     1992     field save-position as decimal
     1993     index xpk is primary unique handle-value
     1994     .
     1995   define temp-table temp-browse-handle no-undo
     1996     field browse-type   as character
     1997     field browse-number as integer
     1998     field browse-handle as handle
     1999     field original-size as decimal
     2000     index xpk is primary unique browse-type browse-number
     2001     index xie browse-type browse-handle
     2002   .
     2003   procedure diasize_change-height :
     2004     define input  parameter p-change-value  as decimal   no-undo .
     2005     define input  parameter p-move-resize   as logical   no-undo .
     2006     define variable v-field-group-handle    as handle    no-undo .
     2007     define variable v-object-handle         as handle    no-undo .
     2008     define variable v-frame-height          as decimal   no-undo .
     2009     define variable v-frame-virtual-height  as decimal   no-undo .
     2010     define variable v-browse-height         as decimal   no-undo .
     2011     define variable v-window-height         as decimal   no-undo .
     2012     define variable v-window-virtual-height as decimal   no-undo .
     2013     define variable v-change-sign           as integer   no-undo .
     2014     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2015     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2016     if p-change-value > 0
     2017     then do:
     2018       if frame Dialog-Frame :height + p-change-value
     2019           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2020       then do:
     2021         assign
     2022           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2023                           - (frame Dialog-Frame :height-chars)
     2024         .
     2025         if p-change-value <= 0
     2026         then do:
     2027           run diasize_position-resize-button in this-procedure .
     2028           return .
     2029         end.
     2030       end.
     2031     end.
     2032     if p-change-value < 0
     2033     then do:
     2034       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2035       then do:
     2036         assign
     2037           p-change-value = v-diasize-orig-frame-height
     2038                          - (frame Dialog-Frame :height-chars)
     2039         .
     2040         if p-change-value >= 0
     2041         then do:
     2042           run diasize_position-resize-button in this-procedure .
     2043           return .
     2044         end.
     2045       end.
     2046     end.
     2047     if p-change-value >= 0
     2048     then do:
     2049       assign
     2050         v-change-sign = 1
     2051       .
     2052     end.
     2053     else do:
     2054       assign
     2055         v-change-sign = -1
     2056       .
     2057     end.
     2058     assign
     2059       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2060     .
     2061     if p-change-value = 0
     2062     then do:
     2063       run diasize_position-resize-button in this-procedure .
     2064       return .
     2065     end.
     2066     move_block:
     2067     do
     2068     on error undo move_block, retry move_block
     2069     :
     2070       if retry
     2071       then do:
     2072         do
     2073         on error undo move_block, leave move_block
     2074         :
     2075           if p-change-value > 0
     2076           then do:
     2077             for each buf_temp-diasize-handle
     2078             on error undo, next
     2079             :
     2080               assign
     2081                 v-object-handle = buf_temp-diasize-handle.handle-value
     2082               .
     2083               if v-object-handle <> v-diasize-resize-button
     2084               then do:
     2085                 assign
     2086                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2087                 .
     2088               end.
     2089             end.
     2090             assign
     2091               v-diasize-browse-handle :height = v-browse-height
     2092             .
     2093             for each buf_temp-browse-handle
     2094               where buf_temp-browse-handle.browse-type = 'height':u
     2095             on error undo, next
     2096             :
     2097               assign
     2098                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2099               .
     2100             end.
     2101             assign
     2102               frame Dialog-Frame :height = v-frame-height
     2103             .
     2104             if frame Dialog-Frame :scrollable = true
     2105             then do:
     2106               assign
     2107                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2108               .
     2109             end.
     2110             run diasize_position-resize-button in this-procedure .
     2111           end.
     2112           else do:
     2113             if frame Dialog-Frame :scrollable = true
     2114             then do:
     2115               assign
     2116                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2117               .
     2118             end.
     2119             assign
     2120               frame Dialog-Frame :height = v-frame-height
     2121             .
     2122             assign
     2123               v-diasize-browse-handle :height = v-browse-height
     2124             .
     2125             for each buf_temp-browse-handle
     2126               where buf_temp-browse-handle.browse-type = 'height':u
     2127             on error undo, next
     2128             :
     2129               assign
     2130                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2131               .
     2132             end.
     2133             for each buf_temp-diasize-handle
     2134             on error undo, next
     2135             :
     2136               assign
     2137                 v-object-handle = buf_temp-diasize-handle.handle-value
     2138               .
     2139               if v-object-handle <> v-diasize-resize-button
     2140               then do:
     2141                 assign
     2142                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2143                 .
     2144               end.
     2145             end.
     2146             run diasize_position-resize-button in this-procedure .
     2147           end.
     2148           assign
     2149             v-diasize-change-size = false
     2150           .
     2151           leave move_block .
     2152         end.
     2153       end.
     2154       assign
     2155         v-diasize-need-full-display = true
     2156       .
     2157       if v-diasize-change-size = false
     2158       then do:
     2159         assign
     2160           v-diasize-change-size = true
     2161         .
     2162       end.
     2163       else do:
     2164         return .
     2165       end.
     2166       assign
     2167         v-frame-height = frame Dialog-Frame :height
     2168         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2169         v-browse-height = v-diasize-browse-handle :height
     2170       .
     2171       for each buf_temp-browse-handle
     2172         where buf_temp-browse-handle.browse-type = 'height':u
     2173       :
     2174         assign
     2175           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2176         .
     2177       end.
     2178       for each buf_temp-diasize-handle
     2179       :
     2180         delete buf_temp-diasize-handle .
     2181       end.
     2182       assign
     2183         v-field-group-handle = frame Dialog-Frame :first-child
     2184       .
     2185       do while valid-handle(v-field-group-handle)
     2186       :
     2187         assign
     2188           v-object-handle = v-field-group-handle :first-child
     2189         .
     2190         do while valid-handle(v-object-handle)
     2191         :
     2192           if  v-object-handle <> v-diasize-browse-handle :handle
     2193           and can-query(v-object-handle, "row")
     2194           and can-query(v-object-handle, "height")
     2195           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2196           then do:
     2197             find first buf_temp-browse-handle
     2198               where buf_temp-browse-handle.browse-type   = 'height':u
     2199                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2200               no-error .
     2201             if available buf_temp-browse-handle
     2202             then do:
     2203             end.
     2204             else do:
     2205               create buf_temp-diasize-handle .
     2206               assign
     2207                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2208                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2209               .
     2210             end.
     2211           end.
     2212           assign
     2213             v-object-handle = v-object-handle :next-sibling
     2214           .
     2215         end.
     2216         assign
     2217           v-field-group-handle = v-field-group-handle :next-sibling
     2218         .
     2219       end.
     2220       do with frame Dialog-Frame
     2221       :
     2222         hide v-diasize-resize-button .
     2223         assign
     2224           v-diasize-resize-button :row    = 1
     2225           v-diasize-resize-button :column = 1
     2226         .
     2227       end.
     2228       if p-change-value > 0
     2229       then do:
     2230         if frame Dialog-Frame :scrollable = true
     2231         then do:
     2232           assign
     2233             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2234             no-error .
     2235           if error-status :error
     2236           or error-status :get-message(1) <> ""
     2237           then do:
     2238             undo move_block, retry move_block .
     2239           end.
     2240         end.
     2241         assign
     2242           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2243           no-error .
     2244         if error-status :error
     2245         or error-status :get-message(1) <> ""
     2246         then do:
     2247           undo move_block, retry move_block .
     2248         end.
     2249         assign
     2250           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2251           no-error .
     2252         if error-status :error
     2253         or error-status :get-message(1) <> ""
     2254         then do:
     2255           undo move_block, retry move_block .
     2256         end.
     2257         for each buf_temp-browse-handle
     2258           where buf_temp-browse-handle.browse-type = 'height':u
     2259         on error undo move_block, retry move_block
     2260         :
     2261           assign
     2262             buf_temp-browse-handle.browse-handle :height
     2263               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2264             no-error .
     2265           if error-status :error
     2266           or error-status :get-message(1) <> ""
     2267           then do:
     2268             undo move_block, retry move_block .
     2269           end.
     2270         end.
     2271         for each buf_temp-diasize-handle
     2272         on error undo move_block, retry move_block
     2273         :
     2274           assign
     2275             v-object-handle = buf_temp-diasize-handle.handle-value
     2276           .
     2277           if v-object-handle <> v-diasize-resize-button
     2278           then do:
     2279             assign
     2280               v-object-handle :row = v-object-handle :row + p-change-value
     2281               no-error .
     2282             if error-status :error
     2283             or error-status :get-message(1) <> ""
     2284             then do:
     2285               undo move_block, retry move_block .
     2286             end.
     2287           end.
     2288         end.
     2289       end.
     2290       else do:
     2291         for each buf_temp-diasize-handle
     2292         on error undo move_block, retry move_block
     2293         :
     2294           assign
     2295             v-object-handle = buf_temp-diasize-handle.handle-value
     2296           .
     2297           if v-object-handle <> v-diasize-resize-button
     2298           then do:
     2299             assign
     2300               v-object-handle :row = v-object-handle :row + p-change-value
     2301               no-error .
     2302             if error-status :error
     2303             or error-status :get-message(1) <> ""
     2304             then do:
     2305               undo move_block, retry move_block .
     2306             end.
     2307           end.
     2308         end.
     2309         assign
     2310           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2311           no-error .
     2312         if error-status :error
     2313         or error-status :get-message(1) <> ""
     2314         then do:
     2315           undo move_block, retry move_block .
     2316         end.
     2317         for each buf_temp-browse-handle
     2318           where buf_temp-browse-handle.browse-type = 'height':u
     2319         on error undo move_block, retry move_block
     2320         :
     2321           assign
     2322             buf_temp-browse-handle.browse-handle :height
     2323               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2324             no-error .
     2325           if error-status :error
     2326           or error-status :get-message(1) <> ""
     2327           then do:
     2328             undo move_block, retry move_block .
     2329           end.
     2330         end.
     2331         assign
     2332           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2333           no-error .
     2334         if error-status :error
     2335         or error-status :get-message(1) <> ""
     2336         then do:
     2337           undo move_block, retry move_block .
     2338         end.
     2339         if frame Dialog-Frame :scrollable = true
     2340         then do:
     2341           assign
     2342             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2343             no-error .
     2344           if error-status :error
     2345           or error-status :get-message(1) <> ""
     2346           then do:
     2347             undo move_block, retry move_block .
     2348           end.
     2349         end.
     2350       end.
     2351       if p-move-resize = true
     2352       then do:
     2353         run diasize_position-resize-button in this-procedure .
     2354       end.
     2355       if v-diasize-wndstore = true
     2356       then do:
     2357         if connected("ub") = true
     2358         then do:
     2359           define variable v-cntxt-db-num        as integer   no-undo .
     2360           define variable v-cntxt-userid        as character no-undo .
     2361           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2362                                             , OUTPUT v-cntxt-userid
     2363                                             ) .
     2364           run gbl/wndsizew.p
     2365             (input  v-cntxt-db-num
     2366             ,input  v-cntxt-userid
     2367             ,input  v-diasize-proc-name
     2368             ,input  'height':u
     2369             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2370             ) .
     2371         end.
     2372       end.
     2373     end.
     2374     assign
     2375       v-diasize-change-size = false
     2376     .
     2377   end procedure.
     2378   procedure diasize_set-height :
     2379     define input  parameter p-new-height  as decimal   no-undo .
     2380     define input  parameter p-move-resize as logical   no-undo .
     2381     do
     2382     on error undo, return error return-value
     2383     :
     2384       run diasize_change-height in this-procedure
     2385         (input  (p-new-height - frame Dialog-Frame :height)
     2386         ,input  p-move-resize
     2387         ) .
     2388     end.
     2389   end procedure.
     2390   procedure diasize_change-width :
     2391     define input  parameter p-change-value as decimal   no-undo .
     2392     define input  parameter p-move-resize  as logical   no-undo .
     2393     define variable v-field-group-handle   as handle    no-undo .
     2394     define variable v-object-handle        as handle    no-undo .
     2395     define variable v-frame-width          as decimal   no-undo .
     2396     define variable v-frame-virtual-width  as decimal   no-undo .
     2397     define variable v-browse-width         as decimal   no-undo .
     2398     define variable v-window-width         as decimal   no-undo .
     2399     define variable v-window-virtual-width as decimal   no-undo .
     2400     define variable v-change-sign          as integer   no-undo .
     2401     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2402     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2403     if p-change-value > 0
     2404     then do:
     2405       if frame Dialog-Frame :width + p-change-value >
     2406           session :width-chars
     2407       then do:
     2408         assign
     2409           p-change-value = session :width-chars - frame Dialog-Frame :width
     2410         .
     2411         if p-change-value <= 0
     2412         then do:
     2413           run diasize_position-resize-button in this-procedure .
     2414           return .
     2415         end.
     2416       end.
     2417     end.
     2418     if p-change-value < 0
     2419     then do:
     2420       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2421       then do:
     2422         assign
     2423           p-change-value = v-diasize-orig-frame-width
     2424                          - frame Dialog-Frame :width
     2425         .
     2426         if p-change-value >= 0
     2427         then do:
     2428           run diasize_position-resize-button in this-procedure .
     2429           return .
     2430         end.
     2431       end.
     2432     end.
     2433     if p-change-value >= 0
     2434     then do:
     2435       assign
     2436         v-change-sign = 1
     2437       .
     2438     end.
     2439     else do:
     2440       assign
     2441         v-change-sign = -1
     2442       .
     2443     end.
     2444     assign
     2445       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2446     .
     2447     if p-change-value = 0
     2448     then do:
     2449       run diasize_position-resize-button in this-procedure .
     2450       return .
     2451     end.
     2452     move_block:
     2453     do
     2454     on error undo move_block, leave move_block
     2455     :
     2456       if retry
     2457       then do:
     2458         do
     2459         on error undo move_block, leave move_block
     2460         :
     2461           if p-change-value > 0
     2462           then do:
     2463             for each buf_temp-diasize-handle
     2464             on error undo, next
     2465             :
     2466               assign
     2467                 v-object-handle = buf_temp-diasize-handle.handle-value
     2468               .
     2469               if v-object-handle <> v-diasize-resize-button
     2470               then do:
     2471                 assign
     2472                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2473                 .
     2474               end.
     2475             end.
     2476             assign
     2477               v-diasize-browse-handle :width = v-browse-width
     2478             .
     2479             for each buf_temp-browse-handle
     2480               where buf_temp-browse-handle.browse-type = 'width':u
     2481             on error undo, next
     2482             :
     2483               assign
     2484                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2485               .
     2486             end.
     2487             assign
     2488               frame Dialog-Frame :width = v-frame-width
     2489             .
     2490             if frame Dialog-Frame :scrollable = true
     2491             then do:
     2492               assign
     2493                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2494               .
     2495             end.
     2496             run diasize_position-resize-button in this-procedure .
     2497           end.
     2498           else do:
     2499             if frame Dialog-Frame :scrollable = true
     2500             then do:
     2501               assign
     2502                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2503               .
     2504             end.
     2505             assign
     2506               frame Dialog-Frame :width = v-frame-width
     2507             .
     2508             for each buf_temp-browse-handle
     2509               where buf_temp-browse-handle.browse-type = 'width':u
     2510             on error undo, next
     2511             :
     2512               assign
     2513                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2514               .
     2515             end.
     2516             assign
     2517               v-diasize-browse-handle :width = v-browse-width
     2518             .
     2519             for each buf_temp-diasize-handle
     2520             on error undo, next
     2521             :
     2522               assign
     2523                 v-object-handle = buf_temp-diasize-handle.handle-value
     2524               .
     2525               if v-object-handle <> v-diasize-resize-button
     2526               then do:
     2527                 assign
     2528                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2529                 .
     2530               end.
     2531             end.
     2532             run diasize_position-resize-button in this-procedure .
     2533           end.
     2534           assign
     2535             v-diasize-change-size = false
     2536           .
     2537           leave move_block .
     2538         end.
     2539       end.
     2540       assign
     2541         v-diasize-need-full-display = true
     2542       .
     2543       if v-diasize-change-size = false
     2544       then do:
     2545         assign
     2546           v-diasize-change-size = true
     2547         .
     2548       end.
     2549       else do:
     2550         return .
     2551       end.
     2552       assign
     2553         v-frame-width = frame Dialog-Frame :width
     2554         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2555         v-browse-width = v-diasize-browse-handle :width
     2556       .
     2557       for each buf_temp-browse-handle
     2558         where buf_temp-browse-handle.browse-type = 'width':u
     2559       :
     2560         assign
     2561           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2562         .
     2563       end.
     2564       for each buf_temp-diasize-handle
     2565       :
     2566         delete buf_temp-diasize-handle .
     2567       end.
     2568       assign
     2569         v-field-group-handle = frame Dialog-Frame :first-child
     2570       .
     2571       do while valid-handle(v-field-group-handle)
     2572       :
     2573         assign
     2574           v-object-handle = v-field-group-handle :first-child
     2575         .
     2576         do while valid-handle(v-object-handle)
     2577         :
     2578           if  v-object-handle <> v-diasize-browse-handle :handle
     2579           and v-object-handle <> v-diasize-resize-button
     2580           and can-query(v-object-handle, "row")
     2581           and can-query(v-object-handle, "height")
     2582           and ( v-object-handle :col + v-object-handle :width
     2583                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2584               )
     2585           then do:
     2586             find first buf_temp-browse-handle
     2587               where buf_temp-browse-handle.browse-type   = 'width':u
     2588                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2589               no-error .
     2590             if available buf_temp-browse-handle
     2591             then do:
     2592             end.
     2593             else do:
     2594               create buf_temp-diasize-handle .
     2595               assign
     2596                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2597                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2598               .
     2599             end.
     2600           end.
     2601           assign
     2602             v-object-handle = v-object-handle :next-sibling
     2603           .
     2604         end.
     2605         assign
     2606           v-field-group-handle = v-field-group-handle :next-sibling
     2607         .
     2608       end.
     2609       do with frame Dialog-Frame
     2610       :
     2611         hide v-diasize-resize-button .
     2612         v-diasize-resize-button :row = 1.
     2613         v-diasize-resize-button :column = 1.
     2614       end.
     2615       if p-change-value > 0
     2616       then do:
     2617         if frame Dialog-Frame :scrollable = true
     2618         then do:
     2619           assign
     2620             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2621             no-error .
     2622           if error-status :error
     2623           or error-status :get-message(1) <> ""
     2624           then do:
     2625             undo move_block, retry move_block.
     2626           end.
     2627         end.
     2628         assign
     2629           frame Dialog-Frame :width = v-frame-width + p-change-value
     2630           no-error .
     2631         if error-status :error
     2632         or error-status :get-message(1) <> ""
     2633         then do:
     2634           undo move_block, retry move_block.
     2635         end.
     2636         assign
     2637           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2638         no-error .
     2639         if error-status :error
     2640         or error-status :get-message(1) <> ""
     2641         then do:
     2642           undo move_block, retry move_block.
     2643         end.
     2644         for each buf_temp-browse-handle
     2645           where buf_temp-browse-handle.browse-type = 'width':u
     2646         on error undo move_block, retry move_block
     2647         :
     2648           assign
     2649             buf_temp-browse-handle.browse-handle :width
     2650               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2651             no-error .
     2652           if error-status :error
     2653           or error-status :get-message(1) <> ""
     2654           then do:
     2655             undo move_block, retry move_block .
     2656           end.
     2657         end.
     2658         for each buf_temp-diasize-handle
     2659         on error undo move_block, retry move_block
     2660         :
     2661           assign
     2662             v-object-handle = buf_temp-diasize-handle.handle-value
     2663           .
     2664           if v-object-handle <> v-diasize-resize-button
     2665           then do:
     2666             assign
     2667               v-object-handle :col = v-object-handle :col + p-change-value
     2668               no-error .
     2669             if error-status :error
     2670             or error-status :get-message(1) <> ""
     2671             then do:
     2672               undo move_block, retry move_block .
     2673             end.
     2674           end.
     2675         end.
     2676       end.
     2677       else do:
     2678         for each buf_temp-diasize-handle
     2679         on error undo move_block, retry move_block
     2680         :
     2681           assign
     2682             v-object-handle = buf_temp-diasize-handle.handle-value
     2683           .
     2684           if v-object-handle <> v-diasize-resize-button
     2685           then do:
     2686             assign
     2687               v-object-handle :col = v-object-handle :col + p-change-value
     2688               no-error .
     2689             if error-status :error
     2690             or error-status :get-message(1) <> ""
     2691             then do:
     2692               undo move_block, retry move_block .
     2693             end.
     2694           end.
     2695         end.
     2696         for each buf_temp-browse-handle
     2697           where buf_temp-browse-handle.browse-type = 'width':u
     2698         on error undo move_block, retry move_block
     2699         :
     2700           assign
     2701             buf_temp-browse-handle.browse-handle :width
     2702               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2703             no-error .
     2704           if error-status :error
     2705           or error-status :get-message(1) <> ""
     2706           then do:
     2707             undo move_block, retry move_block .
     2708           end.
     2709         end.
     2710         assign
     2711           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2712           no-error .
     2713         if error-status :error
     2714         or error-status :get-message(1) <> ""
     2715         then do:
     2716           undo move_block, retry move_block.
     2717         end.
     2718         assign
     2719           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2720         no-error .
     2721         if error-status :error
     2722         or error-status :get-message(1) <> ""
     2723         then do:
     2724           undo move_block, retry move_block.
     2725         end.
     2726         if frame Dialog-Frame :scrollable = true
     2727         then do:
     2728           assign
     2729             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2730           no-error .
     2731           if error-status :error
     2732           or error-status :get-message(1) <> ""
     2733           then do:
     2734             undo move_block, retry move_block.
     2735           end.
     2736         end.
     2737       end.
     2738       if p-move-resize
     2739       then do:
     2740         run diasize_position-resize-button in this-procedure .
     2741       end.
     2742       if v-diasize-wndstore = true
     2743       then do:
     2744         if connected("ub") = true
     2745         then do:
     2746           define variable v-cntxt-db-num        as integer   no-undo .
     2747           define variable v-cntxt-userid        as character no-undo .
     2748           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2749                                             , OUTPUT v-cntxt-userid
     2750                                             ) .
     2751           run gbl/wndsizew.p
     2752             (input  v-cntxt-db-num
     2753             ,input  v-cntxt-userid
     2754             ,input  v-diasize-proc-name
     2755             ,input  'width':u
     2756             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2757             ) .
     2758         end.
     2759       end.
     2760     end.
     2761     assign
     2762       v-diasize-change-size = false
     2763     .
     2764   end procedure.
     2765   procedure diasize_set-width :
     2766     define input  parameter p-new-width  as decimal   no-undo .
     2767     define input  parameter p-move-resize as logical   no-undo .
     2768     do
     2769     on error undo, return error return-value
     2770     :
     2771       run diasize_change-width in this-procedure
     2772         (input  (p-new-width - frame Dialog-Frame :width)
     2773         ,input  p-move-resize
     2774         ) .
     2775     end.
     2776   end procedure.
     2777   procedure diasize_position-resize-button :
     2778     do with frame Dialog-Frame
     2779     :
     2780       hide v-diasize-resize-button .
     2781       assign
     2782         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2783                     - 1
     2784                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2785         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2786                     - 1
     2787                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2788       .
     2789       view v-diasize-resize-button .
     2790     end.
     2791   end procedure.
     2792   on alt-right anywhere
     2793   do:
     2794     run diasize_change-width in this-procedure
     2795       (input 1
     2796       ,input true
     2797       ) .
     2798     return no-apply .
     2799   end.
     2800   on alt-left anywhere
     2801   do:
     2802     run diasize_change-width in this-procedure
     2803       (input -1
     2804       ,input true
     2805       ) .
     2806     return no-apply .
     2807   end.
     2808   on alt-down anywhere
     2809   do:
     2810     run diasize_change-height in this-procedure
     2811       (input 1
     2812       ,input true
     2813       ) .
     2814     return no-apply .
     2815   end.
     2816   on alt-up anywhere
     2817   do:
     2818     run diasize_change-height in this-procedure
     2819       (input -1
     2820       ,input true
     2821       ) .
     2822     return no-apply .
     2823   end.
     2824   on alt-enter of frame Dialog-Frame
     2825   do:
     2826     run diasize_maximize in this-procedure
     2827       (input  ?
     2828       ).
     2829     return no-apply .
     2830   end.
     2831   procedure diasize_end-move :
     2832     do
     2833     on error undo, return error return-value
     2834     :
     2835       define variable v-row-delta as decimal   no-undo .
     2836       define variable v-col-delta as decimal   no-undo .
     2837       define variable v-new-row as decimal   no-undo .
     2838       define variable v-new-col as decimal   no-undo .
     2839       assign
     2840         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2841         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2842       .
     2843       assign
     2844         v-row-delta = v-new-row - frame Dialog-Frame :height
     2845         v-col-delta = v-new-col - frame Dialog-Frame :width
     2846       .
     2847       run diasize_change-height in this-procedure
     2848         (input v-row-delta
     2849         ,input true
     2850         ) .
     2851       run diasize_change-width in this-procedure
     2852         (input v-col-delta
     2853         ,input true
     2854         ) .
     2855     end.
     2856   end procedure.
     2857   procedure diasize_maximize :
     2858     define input  parameter p-action as logical   no-undo .
     2859     do
     2860     on error undo, return error return-value
     2861     :
     2862       if p-action = ?
     2863       then do:
     2864         if v-diasize-need-maximize = true
     2865         then do:
     2866           assign
     2867             p-action = true
     2868           .
     2869         end.
     2870         else do:
     2871           assign
     2872             p-action = false
     2873           .
     2874         end.
     2875       end.
     2876       if p-action = true
     2877       then do:
     2878         run diasize_change-height in this-procedure
     2879           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2880               - frame Dialog-Frame :height-chars
     2881           ,input true
     2882           ) .
     2883         run diasize_change-width in this-procedure
     2884           (input session :width-chars
     2885               - frame Dialog-Frame :width-chars
     2886           ,input true
     2887           ) .
     2888         assign
     2889           v-diasize-need-maximize = false
     2890         .
     2891       end.
     2892       else do:
     2893         run diasize_change-width in this-procedure
     2894           (input v-diasize-orig-frame-width
     2895               - frame Dialog-Frame :width-chars
     2896           ,input true
     2897           ) .
     2898         run diasize_change-height in this-procedure
     2899           (input v-diasize-orig-frame-height
     2900               - frame Dialog-Frame :height-chars
     2901           ,input true
     2902           ) .
     2903         assign
     2904           v-diasize-need-maximize = true
     2905         .
     2906       end.
     2907     end.
     2908   end procedure.
     2909   procedure diasize_restore-orig-size :
     2910     do
     2911     on error undo, return error return-value
     2912     :
     2913       assign
     2914         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2915         v-diasize-current-frame-height = frame Dialog-Frame :height
     2916       .
     2917       run diasize_set-height in this-procedure
     2918         (input  v-diasize-orig-frame-height
     2919         ,input  true
     2920         ) .
     2921       run diasize_set-width in this-procedure
     2922         (input  v-diasize-orig-frame-width
     2923         ,input  true
     2924         ) .
     2925     end.
     2926   end procedure.
     2927   procedure diasize_restore-current-size :
     2928     do
     2929     on error undo, return error return-value
     2930     :
     2931       run diasize_set-height in this-procedure
     2932         (input  v-diasize-current-frame-height
     2933         ,input  true
     2934         ) .
     2935       run diasize_set-width in this-procedure
     2936         (input  v-diasize-current-frame-width
     2937         ,input  true
     2938         ) .
     2939     end.
     2940   end procedure.
     2941   procedure diasize_set-browse-handle :
     2942     define input  parameter p-browse-handle as handle   no-undo .
     2943     define buffer buf_temp-browse-handle for temp-browse-handle .
     2944     do
     2945     on error undo, return error return-value
     2946     :
     2947       assign
     2948         v-diasize-browse-handle = p-browse-handle
     2949       .
     2950       for each buf_temp-browse-handle
     2951       on error undo, return error return-value
     2952       :
     2953         delete buf_temp-browse-handle .
     2954       end.
     2955     end.
     2956   end procedure.
     2957   procedure diasize_add_browse :
     2958     define input  parameter p-browse-type   as character no-undo .
     2959     define input  parameter p-browse-handle as handle    no-undo .
     2960     define buffer buf_temp-browse-handle for temp-browse-handle .
     2961     do
     2962     on error undo, return error return-value
     2963     :
     2964       assign
     2965         v-diasize-browse-number = v-diasize-browse-number + 1
     2966       .
     2967       create buf_temp-browse-handle .
     2968       assign
     2969         buf_temp-browse-handle.browse-type   = p-browse-type
     2970         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2971         buf_temp-browse-handle.browse-handle = p-browse-handle
     2972       .
     2973     end.
     2974   end procedure.
     2975   procedure diasize_init :
     2976     define variable v-default-value    as logical   no-undo .
     2977     define variable v-restore-saved    as logical   no-undo .
     2978     define variable v-resize-value-str as character no-undo .
     2979     do
     2980     on error undo, return error return-value
     2981     :
     2982       do with frame Dialog-Frame
     2983       :
     2984         assign
     2985           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2986           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2987           v-diasize-browse-handle     = browse br-msf-codes :handle
     2988         .
     2989         create button v-diasize-resize-button
     2990         assign
     2991           parent        = frame Dialog-Frame :first-child
     2992           label         = "s"
     2993           height-pixels = 16
     2994           width-pixels  = 16
     2995           visible       = true
     2996           sensitive     = true
     2997           movable       = true
     2998           triggers:
     2999             on end-move persistent run diasize_end-move in this-procedure .
     3000           end triggers.
     3001         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3002         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3003         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3004         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3005         assign
     3006           v-diasize-wndmax = false
     3007         .
     3008         if connected("ub") = true
     3009         then do:
     3010           define variable v-cntxt-db-num        as integer   no-undo .
     3011           define variable v-cntxt-userid        as character no-undo .
     3012           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3013                                             , OUTPUT v-cntxt-userid
     3014                                             ) .
     3015           run gbl/wndpar_r.p
     3016             (input  v-cntxt-db-num
     3017             ,input  v-cntxt-userid
     3018             ,input  'wndmax':U
     3019             ,output v-diasize-wndmax
     3020             ,output v-default-value
     3021             ) .
     3022         end.
     3023         assign
     3024           v-diasize-wndstore = false
     3025         .
     3026         if connected("ub") = true
     3027         then do:
     3028           run gbl/wndpar_r.p
     3029             (input  v-cntxt-db-num
     3030             ,input  v-cntxt-userid
     3031             ,input  'wndstore':U
     3032             ,output v-diasize-wndstore
     3033             ,output v-default-value
     3034             ) .
     3035         end.
     3036         assign
     3037           v-diasize-proc-name = entry(1, program-name(2), '.')
     3038         .
     3039         if v-diasize-wndstore = true
     3040         then do:
     3041           assign
     3042             v-restore-saved = false
     3043           .
     3044           if connected("ub") = true
     3045           then do:
     3046             run gbl/wndsizer.p
     3047               (input  v-cntxt-db-num
     3048               ,input  v-cntxt-userid
     3049               ,input  v-diasize-proc-name
     3050               ,input  'height':u
     3051               ,output v-resize-value-str
     3052               ) .
     3053             if v-resize-value-str <> '':U
     3054             then do:
     3055               run diasize_change-height in this-procedure
     3056                 (input  integer(v-resize-value-str)
     3057                 ,input  true
     3058                 ) .
     3059               assign
     3060                 v-restore-saved = true
     3061               .
     3062             end.
     3063           end.
     3064           if connected("ub") = true
     3065           then do:
     3066             run gbl/wndsizer.p
     3067               (input  v-cntxt-db-num
     3068               ,input  v-cntxt-userid
     3069               ,input  v-diasize-proc-name
     3070               ,input  'width':u
     3071               ,output v-resize-value-str
     3072               ) .
     3073             if v-resize-value-str <> '':U
     3074             then do:
     3075               run diasize_change-width in this-procedure
     3076                 (input  integer(v-resize-value-str)
     3077                 ,input  true
     3078                 ) .
     3079               assign
     3080                 v-restore-saved = true
     3081               .
     3082             end.
     3083           end.
     3084           if v-restore-saved <> true
     3085           then do:
     3086             if v-diasize-wndmax = true
     3087             then do:
     3088               run diasize_maximize in this-procedure
     3089                 (input  true
     3090                 ) .
     3091             end.
     3092           end.
     3093         end.
     3094         else do:
     3095           if v-diasize-wndmax = true
     3096           then do:
     3097             run diasize_maximize in this-procedure
     3098               (input  true
     3099               ) .
     3100           end.
     3101         end.
     3102       end.
     3103     end.
     3104   end procedure.
     3105   procedure diasize_need-full-display :
     3106     define output parameter p-need-full-display as logical   no-undo .
     3107     do
     3108     on error undo, return error return-value
     3109     :
     3110       assign
     3111         p-need-full-display = v-diasize-need-full-display
     3112       .
     3113       assign
     3114         v-diasize-need-full-display = false
     3115       .
     3116     end.
     3117   end procedure.
     3118   procedure get-context :
     3119      define output parameter p-db-num as integer          no-undo.
     3120      define output parameter p-user-id as character        no-undo.
     3121      define variable v-login               as character    no-undo.
     3122      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3123      define buffer buf_user-login  for ub.user-login .
     3124      do
     3125      on error undo, return error
     3126      :
     3127            FIND FIRST buf_sys-ctrl no-lock.
     3128            ASSIGN
     3129               v-login = USERID("ub")
     3130               p-db-num = buf_sys-ctrl.db-num
     3131            .
     3132            FIND FIRST buf_user-login
     3133                 WHERE buf_user-login.db-num = p-db-num
     3134                   AND buf_user-login.user-login = v-login
     3135                 no-lock
     3136                 no-error
     3137                 .
     3138            IF AVAILABLE buf_user-login
     3139            THEN DO:
     3140               assign
     3141                  p-user-id = buf_user-login.user-id
     3142               .
     3143            END.
     3144      end.
     3145   end procedure.
     3146       run diasize_init in this-procedure .
     3147   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3148   procedure set-filter-name :
     3149   define input parameter p-filter-name as character no-undo .
     3150     do with frame Dialog-Frame:
     3151       if p-filter-name > "" then do:
     3152         assign
     3153           frame Dialog-Frame:title
     3154             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3155         .
     3156         assign
     3157           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3158         .
     3159       end.
     3160       else do:
     3161         assign
     3162           b-sch :tooltip = ""
     3163         .
     3164       end.
     3165     end.
     3166   end procedure.
     3167   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3168   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     3169     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     3170     return no-apply.
     3171   end.
     3172   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3173   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     3174     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     3175     return no-apply.
     3176   end.
     3177   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3178   on F8 of frame Dialog-Frame anywhere do:
