     3197   MAIN-BLOCK:
     3198   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3199      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3200   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3201     run mainmenu_getcntxt in parparentproc
     3202       (output v-cntxt-db-num
     3203       ,output v-cntxt-userid
     3204       ,output v-cntxt-level
     3205       ,output v-cntxt-host-code-obj
     3206       ,output v-cntxt-obj-type
     3207       ,output v-cntxt-obj-code
     3208       ,output v-cntxt-db-num-obj
     3209       ,output v-cntxt-is-admin
     3210       ) .
     3211     if lookup(p-list-mode, ('все':U + chr(44) +
     3212                       "node-code" + chr(44) +
     3213                       "uniq-key-rec")) = 0 then do:
     3214       message
     3215       substitute("Неверное значение параметра p-list-mode = &1", p-list-mode)
     3216       view-as alert-box error .
     3217     end.
     3218     run fill-tables in this-procedure .
     3219     case p-list-mode:
     3220       when "uniq-key-rec" then do:
     3221        run gen-row-keyr in this-procedure ( input p-uniq-key-rec
     3222                                            ,input ?
     3223                                            ,input "ub"
     3224                                            ,input ?
     3225                                            ,input no-lock
     3226                                            ,output v-tbl-row
     3227                                            ,output v-tbl-name).
     3228         find first buf_goods no-lock where
     3229                   rowid(buf_goods) = v-tbl-row.
     3230       end.
     3231       when "node-code" then do:
     3232          find first buf_msf no-lock where
     3233                   buf_msf.node-code = p-node-code.
     3234       end.
     3235     end case.
     3236     v-rid-list = p-rid-list.
     3237     RUN Myenable.
     3238     WAIT-FOR GO OF FRAME Dialog-Frame.
     3239   END.
     3240   RUN disable_UI.
     3241   PROCEDURE disable_UI :
     3242     HIDE FRAME Dialog-Frame.
     3243   END PROCEDURE.
     3244   PROCEDURE enable_UI :
     3245     DISPLAY mark-num
     3246         WITH FRAME Dialog-Frame.
     3247     ENABLE b-quit B-mark B-sel b-add b-del b-gds b-sch b-print B-Help
     3248            br-msf-codes mark-num
     3249         WITH FRAME Dialog-Frame.
     3250     VIEW FRAME Dialog-Frame.
     3251     OPEN QUERY br-msf-codes FOR EACH X_ext-classif NO-LOCK,        FIRST X_goods NO-LOCK INDEXED-REPOSITION.
     3252   END PROCEDURE.
     3253   PROCEDURE fill-tables :
     3254   run meatsemi_fill-msf in this-procedure ( input 'ПРОСМОТР':U
     3255                                           , buffer buf_clob-bind).
     3256   CREATE dop-msf.
     3257   RELEASE dop-msf.
     3258   END PROCEDURE.
     3259   PROCEDURE MyEnable :
     3260   FIND FIRST dop-msf.
     3261   ENABLE
     3262   b-quit
     3263   b-gds
     3264   b-print
     3265   b-add when (lookup("b-add", bttns) > 0 and not transaction)
     3266   b-del when (lookup("b-add", bttns) > 0 and not transaction)
     3267   b-sch
     3268   B-Help
     3269   br-msf-codes
     3270   WITH FRAME Dialog-Frame.
     3271   VIEW FRAME Dialog-Frame.
     3272   RUN Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3273   END PROCEDURE.
     3274   PROCEDURE OpenBr :
     3275   define input  parameter p-open-query     as logical   no-undo .
     3276   define input  parameter p-find-next      as logical   no-undo .
     3277   define input  parameter p-find-condition as character no-undo .
     3278   define variable sort-column-phrase as character no-undo .
     3279   define variable l-query-was-opened as logical no-undo .
     3280   define variable title0 as character no-undo .
     3281   define variable title1 as character no-undo .
     3282   case sort-column-name :
     3283     when "" then do:
     3284       assign
     3285         sort-column-phrase = ""
     3286       .
     3287     end.
     3288     otherwise do:
     3289       assign
     3290         sort-column-phrase = "by " + sort-column-name
     3291       .
     3292     end.
     3293   end case.
     3294   filter-point = filter-point0 + p-list-mode .
     3295   title0 = "Мясные полуфабрикаты".
     3296   case p-list-mode:
     3297     when 'все':U then do:
     3298       ASSIGN
     3299       title1 = substitute("&1", title0)
     3300       frame Dialog-Frame:title = title1
     3301       filter-label = title1
     3302       .
