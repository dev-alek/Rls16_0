     3553     ,output flt-rec-37
     3554     ,output filter-name-37
     3555     ,output where-phrase-37
     3556     ,output sort-phrase-37
     3557     ,output where-phrase-rus-37
     3558     ,output sort-phrase-rus-37
     3559     ).
     3560       run set-filter-name in this-procedure
     3561         (INPUT filter-name-37
     3562         ) no-error .
     3563     assign
     3564       l-filter-open-37 = false
     3565     .
     3566     if flt-rec-37 <> ?
     3567       or sort-column-phrase > ""
     3568     then do:
     3569       define variable  parameter-2-37 as character no-undo .
     3570       define variable  parameter-3-37 as character no-undo .
     3571       define variable  parameter-4-37 as character no-undo .
     3572       define variable  parameter-5-37 as character no-undo .
     3573       define variable  parameter-6-37 as character no-undo .
     3574       define variable  parameter-7-37 as character no-undo .
     3575         assign
     3576         parameter-3-37 =
     3577                                 "FOR EACH X_ext-classif"
     3578         parameter-4-37 =
     3579           (
     3580             if (" X_ext-classif.classif-subject = 'goods':U                       and X_ext-classif.classif-name = 'msf-code':U                       AND X_ext-classif.db-num = - 1                       and X_ext-classif.uniq-key-rec = p-uniq-key-rec " + " " + where-phrase-37) <> ""
     3581             then  substitute('X_ext-classif.classif-subject = &1&2&1                       and X_ext-classif.classif-name = &1&3&1                       AND X_ext-classif.db-num = - 1                       AND X_ext-classif.uniq-key-rec = &1&4&1 ', chr(34), 'goods':U, 'msf-code':U, p-uniq-key-rec)  + " " + where-phrase-37
     3582             else "true"
     3583           )
     3584         parameter-5-37 = (" " + "" + " " + substitute(', FIRST X_goods NO-LOCK WHERE                                   X_goods.gds-code = integer(ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)))'))
     3585         parameter-6-37 = if sort-phrase-37 = ''
     3586                              then
     3587           (
     3588           " " + "  " +
     3589             " " + sort-column-phrase +
     3590           " " + "  "
     3591           )
     3592                              else
     3593           (
     3594           " " + "  " +
     3595             " " + sort-column-phrase +
     3596           " " + sort-phrase-37
     3597           )
     3598         parameter-7-37 =
     3599           " INDEXED-REPOSITION  "
     3600       .
     3601       do
     3602       on stop undo, leave
     3603       on error undo, leave
     3604       :
     3605         assign
     3606           l-disable-where-37 =
     3607             (" X_ext-classif.classif-subject = 'goods':U                       and X_ext-classif.classif-name = 'msf-code':U                       AND X_ext-classif.db-num = - 1                       and X_ext-classif.uniq-key-rec = p-uniq-key-rec " + " " + where-phrase-37 = "")
     3608         .
     3609         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3610                             ,input QUERY br-msf-codes:handle
     3611                             ,input parameter-3-37
     3612                             ,input parameter-4-37
     3613                             ,input parameter-5-37
     3614                             ,input parameter-6-37
     3615                             ,input parameter-7-37
     3616                             )
     3617         .
     3618         assign
     3619           l-filter-open-37 = true
     3620         .
     3621       end.
     3622       if l-filter-open-37 = false then do:
     3623         message
     3624           "Ошибка при фильтрации / сортировке" skip
     3625           "Будут показаны записи без учета фильтра" skip
     3626           view-as alert-box .
     3627       end.
     3628       else do:
     3629           assign
     3630             l-query-was-opened = true
     3631           .
     3632       end.
     3633     end.
     3634     if l-filter-open-37 = false then do:
     3635       OPEN QUERY br-msf-codes FOR EACH X_ext-classif
     3636         where  X_ext-classif.classif-subject = 'goods':U                       and X_ext-classif.classif-name = 'msf-code':U                       AND X_ext-classif.db-num = - 1                       and X_ext-classif.uniq-key-rec = p-uniq-key-rec
     3637       , FIRST X_goods NO-LOCK WHERE                                   X_goods.gds-code = integer(ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)))
     3638         INDEXED-REPOSITION
     3639     .
     3640         assign
     3641           l-query-was-opened = true
     3642         .
     3643     end.
     3644     end.
     3645   end case.
     3646   APPLY "entry" TO br-msf-codes.
     3647   if available X_ext-classif then do:
     3648       APPLY "VALUE-CHANGED":U to br-msf-codes.
     3649   END.
     3650   END PROCEDURE.
     3651   PROCEDURE proc-b-add :
     3652   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     3653   define variable v-rid as recid no-undo .
     3654   DEFINE VARIABLE v-ok AS logical NO-UNDO.
     3655   DEFINE VARIABLE v-value-integer AS integer NO-UNDO.
     3656   define variable v-uniq-key-rec as character no-undo .
     3657   define variable v-ii as integer no-undo .
     3658   define buffer buf_ext-classif for ub.ext-classif.
     3659   if p-list-mode = "uniq-key-rec" then do:
     3660     v-uniq-key-rec = p-uniq-key-rec.
     3661     v-rid-list = string(recid(buf_goods)).
     3662   end.
     3663   else do:
     3664     message
     3665     "Выберите товар(-ы), для который Вы хотите классифицировать как мясной полуфабрикат"
     3666     view-as alert-box .
     3667     run ref/gds-ref.p ( input parparentproc
     3668                       , input "b-sel,b-mark"
     3669                       , input 'текущие':U
     3670                       , input 'все':U
     3671                       , input ?
     3672                       , input ?
     3673                       , input ?
     3674                       , input ?
     3675                       , input ?
     3676                       , input ?
     3677                       , input ?
     3678                       , input ?
     3679                       , output v-rid-list) no-error.
     3680     if v-rid-list = '':U then return no-apply.
     3681   end.
     3682   if p-list-mode = "node-code" then do:
     3683     v-value-integer = p-node-code.
     3684   end.
     3685   else do:
     3686     run ref/meatsemi.w ( input parparentproc
     3687                         ,input "b-sel"
     3688                         ,input 'ПРОСМОТР':U
     3689                         ,input-output v-value-integer) no-error.
     3690     if v-value-integer = 0  then return error.
     3691   end.
     3692   _v-ii:
     3693   do v-ii = 1 to num-entries(v-rid-list):
     3694     if p-list-mode <> "uniq-key-rec" then do:
     3695       find first buf_goods where recid (buf_goods) = integer (entry(v-ii, v-rid-list)) no-lock no-error.
     3696       run gen-key-rec IN THIS-PROCEDURE ( input 'goods':U
     3697                                     ,input (buffer buf_goods:handle)
     3698                                     ,output v-uniq-key-rec).
     3699     end.
     3700     find first buf_ext-classif no-lock where
     3701               buf_ext-classif.classif-subject = 'goods':U
     3702           and buf_ext-classif.classif-name = 'msf-code':U
     3703           AND buf_ext-classif.db-num = - 1
     3704           and buf_ext-classif.uniq-key-rec = v-uniq-key-rec no-error.
     3705     if available buf_ext-classif then do:
     3706       message
     3707       substitute("Товар с кодом &1 уже привязан к классификатору мясных полуфабрикатов", buf_goods.gds-code)
     3708       view-as alert-box error .
     3709       if num-entries(v-rid-list) = 1 then  undo, return error .
     3710       else next _v-ii.
     3711     end.
     3712     v-rid = ?.
     3713     run ref/extclas1.p ( INPUT 'ДОБАВЛЕНИЕ':U
     3714                         ,INPUT NO
     3715                         ,INPUT-OUTPUT v-rid
     3716                         ,INPUT 'goods':U
     3717                         ,INPUT 'msf-code':U
     3718                         ,input (-1)
     3719                         ,input v-value-integer
     3720                         ,input 0
     3721                         ,input 0
     3722                         ,input '':U
     3723                         ,input '':U
     3724                         ,input '':U
     3725                         ,input string(buf_goods.gds-code)
     3726                         ,input v-uniq-key-rec ) no-error.
     3727     if error-status:error then do:
     3728       message error-status:get-message(1) view-as alert-box .
     3729       undo, return error .
     3730     end.
     3731   end.
     3732   if v-rid <> ?
     3733   or num-entries(v-rid-list) > 1
     3734   then do:
     3735     run openbr in this-procedure ( input yes, input no, input '':U).
     3736     reposition br-msf-codes to recid v-rid no-error .
     3737     apply "entry" to br-msf-codes in frame Dialog-Frame .
     3738   end.
     3739   END PROCEDURE.
     3740   PROCEDURE proc-b-del :
     3741   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     3742   DEFINE VARIABLE glog AS logical NO-UNDO.
     3743   IF NOT AVAILABLE X_ext-classif THEN UNDO, RETURN ERROR.
     3744   v-rec = recid(X_ext-classif).
     3745   MESSAGE
     3746   "Вы действительно хотите удалить эту запись?"
     3747   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     3748   IF NOT glog THEN RETURN ERROR.
     3749   run ref/extclas3.p ( INPUT NO
     3750                       ,INPUT v-rec) NO-ERROR.
     3751   if not error-status:error then do:
     3752     run openbr in this-procedure ( input yes, input no, input '':U).
     3753     reposition br-msf-codes to row 1 no-error .
     3754     apply "entry" to br-msf-codes in frame Dialog-Frame .
     3755   end.
     3756   END PROCEDURE.
     3757   PROCEDURE proc-b-print :
     3758   DEFINE VARIABLE date_string              as   character no-undo .
     3759   DEFINE VARIABLE Line                     as   character no-undo .
     3760   DEFINE VARIABLE for-time                 as   character no-undo .
     3761   DEFINE VARIABLE accum-count              as   integer   no-undo .
     3762   define variable v-rid                    as   recid no-undo .
     3763   DEFINE FRAME list1
     3764   X_ext-classif.KEY#_one  COLUMN-LABEL "Код в!класс-ре" FORMAT ">>>>>>>>9"
     3765   X_goods.gds-code COLUMN-LABEL "Код!товара" FORMAT ">>>>>>>>9"
     3766   X_goods.gds-name COLUMN-LABEL "Название товара" FORMAT "X(60)"
     3767   HEADER  date_string AT 5 format "X(35)"
     3768   string( "Страница " ) format "X(9)" AT 75 PAGE-NUMBER(PrnLibStream) AT 85 FORMAT ">>9" SKIP
     3769   Line format "X(192)" AT 1
     3770   with width 232 down stream-io use-text    .
     3771   Line = fill("-", 121).
     3772   date_string = cur-time-print() .
     3773   run prn-lib-open-stream  in this-procedure (
     3774                                                input parParentProc
     3775                                               ,input  62
     3776                                               ,input yes
     3777                                               ,input no
     3778                                               ).
     3779   PUT  STREAM PrnLibStream
     3780   SPACE(25) ( frame Dialog-Frame:title )
     3781   format "x(90)" SKIP(1) .
     3782   FORM HEADER
     3783   Line format "X(177)" AT 1 SKIP
     3784   "Продолжение - на следующей странице" AT 30 SKIP
     3785   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3786   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3787   v-rid = recid(X_ext-classif).
     3788   FORM with FRAME List1.
     3789   run waitfram-show in this-procedure ( input "Ждите...").
     3790   DO WHILE available X_ext-classif :
     3791      GET prev br-msf-codes.
     3792   END.
     3793   GET next br-msf-codes.
     3794   DO WHILE available X_ext-classif :
     3795     Display STREAM PrnLibStream
     3796     X_ext-classif.KEY#_one
     3797     X_goods.gds-code
     3798     X_goods.gds-name
     3799     with FRAME List1.
     3800     DOWN STREAM PrnLibStream
     3801     1
     3802     with FRAME List1.
     3803     assign
     3804     accum-count = accum-count + 1
     3805     .
     3806     GET next br-msf-codes.
     3807   END.
     3808   UNDERLINE  STREAM PrnLibStream
     3809   X_ext-classif.KEY#_one
     3810   X_goods.gds-code
     3811   X_goods.gds-name
     3812   with FRAME List1.
     3813   DISPLAY STREAM PrnLibStream
     3814   accum-count @ X_ext-classif.key#_one
     3815   with frame List1.
     3816   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3817   HIDE  STREAM PrnLibStream FRAME List1.
     3818   output  STREAM PrnLibStream CLOSE.
     3819   reposition br-msf-codes to recid v-rid no-error .
     3820   apply "ENTRY" to br-msf-codes in frame Dialog-Frame .
     3821   run waitfram-hide in this-procedure .
     3822   run prn-lib-prn-file in this-procedure (
     3823                                             input parParentProc
     3824                                             ,input 0
     3825                                             ).
     3826   END PROCEDURE.
     3827   PROCEDURE proc-b-sch :
     3828   define variable v-ri as recid no-undo .
     3829   assign
     3830   v-ri = (if avail X_ext-classif then recid(X_ext-classif) else ?)
     3831   .
     3832   assign
     3833   tbl = 'ext-classif':U
     3834   join-tbl = 'X_ext-classif'
     3835   fld = ""
     3836   lab = ""
     3837   spr = ""
     3838   dim = '0'
     3839   .
     3840   run fltfield-add in this-procedure('key#_one', 'Код клиента ПАРУС', '',
     3841   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3842   DO on stop undo, leave:
     3843       run gbl/filter.w ( INPUT parparentproc
     3844                    ,INPUT filter-point + chr(4) + filter-label
     3845                    ,INPUT tbl
     3846                    ,INPUT join-tbl
     3847                    ,INPUT fld
     3848                    ,INput lab
     3849                    ,INPUT spr
     3850                    ,INPUT  dim).
     3851       run OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3852       if v-ri <> ? then do:
     3853         reposition br-msf-codes to recid v-ri no-error.
     3854       end.
     3855       APPLY "ENTRY" to br-msf-codes in frame Dialog-Frame .
     3856       APPLY "VALUE-CHANGED" to br-msf-codes.
     3857   END .
     3858   END PROCEDURE.
     3859   FUNCTION get-cli-type-code RETURNS CHARACTER
     3860     ( INPUT p-uniq-key-rec AS character ) :
     3861   DEFINE VARIABLE v-rowid AS ROWID NO-UNDO.
     3862   DEFINE VARIABLE v-tbl-name AS character NO-UNDO.
     3863   DEFINE BUFFER buf_goods FOR ub.goods.
     3864   END FUNCTION.
     3865   FUNCTION get-gds-name RETURNS CHARACTER
     3866     ( INPUT p-uniq-key-rec AS CHARACTER ) :
     3867   DEFINE VARIABLE v-rowid AS ROWID NO-UNDO.
     3868   DEFINE VARIABLE v-tbl-name AS character NO-UNDO.
     3869   DEFINE BUFFER buf_goods FOR ub.goods.
     3870   RUN gen-row-keyr IN THIS-PROCEDURE ( INPUT p-uniq-key-rec
     3871                                       ,input ?
     3872                                       ,INPUT "ub"
     3873                                       ,INPUT ?
     3874                                       ,INPUT NO-LOCK
     3875                                       ,OUTPUT v-rowid
     3876                                       ,OUTPUT v-tbl-name) no-error.
     3877   if error-status :error then do:
     3878     message
     3879       vss-workfile vss-revision vss-description skip
     3880       error-status :get-message(1)
     3881       error-status :get-message(2)
     3882     view-as alert-box error.
     3883     undo, return error.
     3884   end.
     3885   IF v-rowid = ? THEN RETURN 'НЕИЗВЕСТНЫЙ ТОВАР'.
     3886   FIND FIRST buf_goods NO-LOCK WHERE ROWID(buf_goods) = v-rowid.
     3887   RETURN buf_goods.gds-name.
     3888   END FUNCTION.
