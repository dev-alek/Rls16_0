     1553   field subkind-name-2 as character column-label "Дискретность"  help "Полуфабрикаты, объединенные по технологии изготовления"
     1554   format "X(15)" label "Дискретность"
     1555   view-as combo-box list-items "-", "крупнокусковые", "порционные" , "мелкокусковые"  inner-lines 4 drop-down-list size-chars 20  by 1
     1556   field subkind-name-3 as character column-label "Фаршировка" help "Полуфабрикаты, объединенные по технологии изготовления"
     1557   format "X(15)" label "Фаршировка"
     1558   view-as combo-box list-items "-", "фаршированные", "нефаршированные"  inner-lines 3 drop-down-list size-chars 20  by 1
     1559   field subkind-name-4 as character column-label "Формовка" help "Полуфабрикаты, объединенные по технологии изготовления"
     1560   format "X(13)" label "Формовка"
     1561   view-as combo-box list-items "-", "формованные", "неформованные"  inner-lines 3 drop-down-list size-chars 20  by 1
     1562   field subkind-name-5 as character column-label "Панировка" help "Полуфабрикаты, объединенные по технологии изготовления"
     1563   format "X(14)" label "Панировка"
     1564   view-as combo-box list-items "-", "панированные", "непанированные"  inner-lines 3 drop-down-list size-chars 20  by 1
     1565   field subkind-name-6 as character column-label "Фасовка" help "Полуфабрикаты, объединенные по технологии изготовления"
     1566   format "X(10)" label "Фасовка"
     1567   view-as combo-box list-items "весовые", "фасованные"  inner-lines 2 drop-down-list size-chars 20  by 1
     1568   field category-name as character  column-label "Категория" help "Полуфабрикаты, объединенные по массовой доле мышечной ткани в рецептуре"
     1569   format "X(11)" label "Категория"
     1570   view-as combo-box list-items "категория А", "категория Б", "категория В", "категория Г", "категория Д"  inner-lines 5 drop-down-list size-chars 20  by 1
     1571   field termic-condition-name as character  column-label "Терм.!состояние" help "Полуфабрикаты, объединенные по термическому состоянию"
     1572   format "X(15)" label "Терм.состояние"
     1573   view-as combo-box list-items "охлажденные", "подмороженные", "замороженные"  inner-lines 3 drop-down-list size-chars 20  by 1
     1574   field node-code as integer  column-label "Код"
     1575   format ">>>9" label "Код"
     1576   fgcolor RED_COLOR
     1577   field upper-node-code as integer
     1578   field subkind-name as character
     1579   field lvl-num as integer
     1580   index pi is unique primary
     1581   node-code
     1582   index iupper upper-node-code
     1583   index igroup group-name
