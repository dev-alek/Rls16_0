     3342             then  substitute('X_ext-classif.classif-subject = &1&2&1                       and X_ext-classif.classif-name = &1&3&1                       AND X_ext-classif.db-num = - 1', chr(34), 'goods':U, 'msf-code':U) + " " + where-phrase-33
     3343             else "true"
     3344           )
     3345         parameter-5-33 = (" " + "" + " " + substitute(', FIRST X_goods NO-LOCK WHERE                                   X_goods.gds-code = integer(ENTRY(2, X_eXt-classif.uniq-key-rec, chr(3)))'))
     3346         parameter-6-33 = if sort-phrase-33 = ''
     3347                              then
     3348           (
