     2166       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2167            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2168            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     2169   DEFINE FRAME Dialog-Frame
     2170        var-r-b-abbr AT ROW 18.25 COL 54.38 COLON-ALIGNED NO-LABEL
     2171        temp-dc-type.dcbyshop AT ROW 22 COL 2 NO-LABEL
     2172              VIEW-AS TEXT
     2173             SIZE 69.5 BY 1
     2174        "Использование процента скидки" VIEW-AS TEXT
     2175             SIZE 30.63 BY 1 AT ROW 6.58 COL 2.75
     2176        "Магазины, принимающие только СВОИ карты" VIEW-AS TEXT
     2177             SIZE 52.25 BY 1 TOOLTIP "Магазины, принимающие только карты, выданные в этом же магазине" AT ROW 21 COL 2
     2178        "Тип носителя" VIEW-AS TEXT
     2179             SIZE 21.5 BY .67 AT ROW 17.29 COL 77
     2180        "Платеж" VIEW-AS TEXT
     2181             SIZE 7 BY 1 AT ROW 19.5 COL 40
     2182        RECT-1 AT ROW 20.71 COL 1
     2183        RECT-3 AT ROW 17 COL 1
     2184        RECT-4 AT ROW 17 COL 76
     2185        SPACE(0.00) SKIP(1.53)
     2186       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2187            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2188            TITLE "Тип дисконтной карты"
     2189            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     2190   ASSIGN
     2191          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2192          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2193   ASSIGN
     2194          B-rule:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-rule:HANDLE.
     2195   ASSIGN
     2196          E-rule-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2197   ASSIGN
     2198          f-cash-pay-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2199   ASSIGN
     2200          f-dflt-cash-pcnt:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2201   ASSIGN
     2202          f-dflt-pcnt:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2203   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2204   DO:
     2205       rid = ?.
     2206     APPLY "END-ERROR":U TO SELF.
     2207   END.
     2208   ON CHOOSE OF b-addalgo IN FRAME Dialog-Frame
     2209   DO:
     2210   DEFINE VARIABLE v-ref-list AS CHARACTER NO-UNDO.
     2211   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
     2212   run ref/rulprofs.w (
     2213                        INPUT parparentproc
     2214                       ,INPUT "b-sel"
     2215                       ,INPUT 'dis-card-type':U
     2216                       ,INPUT-OUTPUT v-ref-list) NO-ERROR.
     2217   IF ERROR-STATUS:ERROR THEN DO:
     2218       RETURN NO-apply.
     2219   END.
     2220   FIND FIRST buf_rule-profile NO-LOCK WHERE
     2221             recid(buf_rule-profile) = INTEGER(v-ref-list) NO-ERROR.
     2222   IF NOT AVAILABLE buf_rule-profile THEN RETURN NO-APPLY.
     2223     RUN proc-b-addalgo IN THIS-PROCEDURE ( BUFFER buf_rule-profile) NO-ERROR.
     2224     IF ERROR-STATUS:ERROR THEN DO:
     2225         RETURN NO-APPLY.
     2226     END.
     2227   END.
     2228   ON CHOOSE OF B-cashpay IN FRAME Dialog-Frame
     2229   DO:
     2230     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2231     DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     2232    run ref/cashpays.w (
     2233                    input parparentproc
     2234                   ,input "b-sel":U
     2235                   ,input 'все':U
     2236                   ,input parhost-code
     2237                   ,input parobj-type
     2238                   ,input parobj-code
     2239                   ,output v-rid-list ) .
     2240     IF v-rid-list <> "":U THEN DO:
     2241         FIND FIRST buf_cash-pay NO-LOCK WHERE
     2242                   recid(buf_cash-pay) = INTEGER(v-rid-list) NO-ERROR.
     2243         IF NOT AVAILABLE buf_cash-pay THEN DO:
     2244             ASSIGN
     2245             temp-dc-type.pay-code = 0
     2246            f-cash-pay-name = "":U.
     2247         END.
     2248         ELSE DO:
     2249             IF AVAILABLE buf_cash-pay
     2250             AND buf_cash-pay.curr-code <> v-r-b-code THEN DO:
     2251                 MESSAGE
     2252                 substitute("Дебетовой или кредитовой карте для данного эмитента можно сопоставить тип кассового платежа только с кодом валюты &1", v-r-b-code)
     2253                 VIEW-AS ALERT-BOX ERROR.
     2254                 ASSIGN
     2255                 temp-dc-type.pay-code = 0
     2256                 f-cash-pay-name = "":U.
     2257             END.
     2258             ASSIGN
     2259             temp-dc-type.pay-code = buf_cash-pay.cdpay-code
     2260             f-cash-pay-name = buf_cash-pay.obj-name.
     2261         END.
     2262     END.
     2263     DISPLAY
     2264     f-cash-pay-name
     2265     WITH FRAME Dialog-Frame.
     2266   END.
     2267   ON CHOOSE OF b-cd IN FRAME Dialog-Frame
     2268   DO:
     2269     define variable glog as logical no-undo .
     2270     if p-mode <> 'ПРОСМОТР':U then do:
     2271       message
     2272       substitute("Внимание! Если Вы уже делали какие-либо изменения,&1" +
     2273                  "то перед настройкой данных, передаваемых на кассы&1"  +
     2274                  "рекомендуется сначала сохранить ТИП ДК&1&1" +
     2275                  "Все равно продолжить?"
     2276                  , chr(10))
     2277       view-as alert-box warning buttons YES-NO update glog.
     2278       if not glog then return no-apply.
     2279     end.
     2280     RUN proc-b-cd IN THIS-PROCEDURE NO-ERROR.
     2281     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2282   END.
     2283   ON CHOOSE OF b-d-pcnt-byshop IN FRAME Dialog-Frame
     2284   DO:
     2285     run ref/dis-dcti.w ( INPUt parparentproc
     2286                           ,INPUT p-mode
     2287                           ,INPUT temp-dc-type.TYPE
     2288                           ,INPUT temp-dc-type.emitent-host-code
     2289                           ,INPUT parhost-code
     2290                           ,INPUT parobj-type
     2291                           ,INPUT parobj-code
     2292                           ,INPUT 'bo':U
     2293                           ,input ('def-pcnt':U + chr(44) +
     2294                                   'def-cash-pcnt':U + chr(44) +
     2295                                   'def-categ':U
     2296                                  )
     2297                           ,INPUT-OUTPUT TABLE tt0-dis-dct-rule) NO-ERROR.
     2298   IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2299   run proc-b-dis-dct-rule ( INPUT 'def-pcnt':U, input 'ПРОСМОТР':U) NO-ERROR.
     2300   run proc-b-dis-dct-rule ( INPUT 'def-cash-pcnt':U, input 'ПРОСМОТР':U) NO-ERROR.
     2301   run proc-b-dis-dct-rule ( INPUT 'def-categ':U, input 'ПРОСМОТР':U) NO-ERROR.
     2302   run dpcnt-byshop-enable-disable in this-procedure .
     2303   END.
     2304   ON CHOOSE OF B-dcbyshop IN FRAME Dialog-Frame
     2305   DO:
     2306     run proc-dcbyshop no-error.
     2307       if error-status:error then return no-apply.
     2308   END.
     2309   ON CHOOSE OF B-def-cash-pcnt IN FRAME Dialog-Frame
     2310   DO:
     2311     run proc-b-dis-dct-rule ( INPUT 'def-cash-pcnt':U, input 'ИЗМЕНЕНИЕ':U) NO-ERROR.
     2312     if error-status:error then return no-apply.
     2313     APPLY "LEAVE" to temp-dc-type.emitent-host-code.
     2314   END.
     2315   ON CHOOSE OF B-def-categ IN FRAME Dialog-Frame
     2316   DO:
     2317     run proc-b-dis-dct-rule ( INPUT 'def-categ':U, input 'ИЗМЕНЕНИЕ':U) NO-ERROR.
     2318     if error-status:error then return no-apply.
     2319     APPLY "LEAVE" to temp-dc-type.emitent-host-code.
     2320   END.
     2321   ON CHOOSE OF B-def-pcnt IN FRAME Dialog-Frame
     2322   DO:
     2323     run proc-b-dis-dct-rule ( INPUT 'def-pcnt':U, input 'ИЗМЕНЕНИЕ':U) NO-ERROR.
     2324     if error-status:error then return no-apply.
     2325     APPLY "LEAVE" to temp-dc-type.emitent-host-code.
     2326   END.
     2327   ON CHOOSE OF b-delalgo IN FRAME Dialog-Frame
     2328   DO:
     2329     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     2330     IF NOT AVAILABLE tt0-rp-by-call THEN RETURN NO-APPLY.
     2331     run proc-b-delalgo IN THIS-PROCEDURE NO-ERROR.
     2332     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2333     APPLY "value-changed" TO br-rule-by-call.
     2334   END.
     2335   ON CHOOSE OF b-disc IN FRAME Dialog-Frame
     2336   DO:
     2337     DEFINE VARIABLE v-loc-rid-list AS CHARACTER NO-UNDO.
     2338     IF NOT AVAILABLE temp-dc-type THEN RETURN NO-APPLY.
     2339           run ref/dis-dcts.w (
     2340                                INPUT parparentproc
     2341                               ,INPUT '':U
     2342                               ,INPUT (if p-mode = 'ПРОСМОТР':U
     2343                                      then 'dis-card-type':U
     2344                                      else ('dis-card-type':U   + chr(44) + "temp")
     2345                                      )
     2346                               ,input temp-dc-type.emitent-host-code
     2347                               ,input temp-dc-type.type
     2348                               ,input 0
     2349                               ,input '':U
     2350                               ,input 0
     2351                               ,input 0
     2352                               ,input '':U
     2353                               ,input '':U
     2354                               ,input 0
     2355                               ,input-output v-loc-rid-list ) no-error.
     2356   END.
     2357   ON CHOOSE OF B-emitent IN FRAME Dialog-Frame
     2358   DO:
     2359     run proc-b-emitent no-error.
     2360     if error-status:error then return no-apply.
     2361     APPLY "LEAVE" to temp-dc-type.emitent-host-code.
     2362   END.
     2363   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     2364   DO:
     2365     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     2366     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2367   END.
     2368   ON CHOOSE OF B-history IN FRAME Dialog-Frame
     2369   DO:
     2370       DEFINE VARIABLE ri-list AS CHARACTER NO-UNDO.
     2371      run ref/dcctypes.w (
     2372                      input parparentproc
     2373                     ,input '':U
     2374                     ,input  ?
     2375                     ,input  ub.dis-card-type.emitent-host-code
     2376                     ,input  parhost-code
     2377                     ,input  parobj-type
     2378                     ,input  parobj-code
     2379                     ,input  dis-card-type.TYPE
     2380                     ,input "one":U
     2381                     ,input '':U
     2382                     ,output ri-list ).
     2383   END.
     2384   ON CHOOSE OF b-hn IN FRAME Dialog-Frame
     2385   DO:
     2386   DEFINE VARIABLE v-ok AS LOGICAL NO-UNDO.
     2387   define buffer last_tt0-hist-nws-option for tt0-hist-nws-option.
     2388   FOR EACH tt-2-hist-nws-option:
     2389     DELETE tt-2-hist-nws-option.
     2390   END.
     2391   FOR EACH tt0-hist-nws-option :
     2392     CREATE tt-2-hist-nws-option.
     2393     BUFFER-COPY tt0-hist-nws-option TO tt-2-hist-nws-option.
     2394   END.
     2395   run ref/dcta-1.w (
     2396                   INPUT parparentproc
     2397                  ,INPUT p-mode
     2398                  ,INPUT temp-dc-type.TYPE
     2399                  ,INPUT temp-dc-type.emitent-host-code
     2400                  ,INPUT-OUTPUT TABLE tt-2-hist-nws-option
     2401                  ,OUTPUT v-ok) NO-ERROR.
     2402   IF v-ok THEN DO:
     2403      FOR EACH tt-2-hist-nws-option:
     2404        FIND FIRST tt0-hist-nws-option WHERE
     2405              tt0-hist-nws-option.db-num = tt-2-hist-nws-option.db-num
     2406          and tt0-hist-nws-option.table-name = tt-2-hist-nws-option.table-name
     2407          AND tt0-hist-nws-option.host-code = tt-2-hist-nws-option.host-code
     2408          AND tt0-hist-nws-option.obj-type = tt-2-hist-nws-option.obj-type
     2409          AND tt0-hist-nws-option.obj-code = tt-2-hist-nws-option.obj-code
     2410          and tt0-hist-nws-option.key#_one = tt-2-hist-nws-option.key#_one
     2411          and tt0-hist-nws-option.charkey_one = tt-2-hist-nws-option.charkey_one no-error.
     2412        IF NOT AVAILABLE tt0-hist-nws-option THEN DO:
     2413          find last last_tt0-hist-nws-option where
     2414               last_tt0-hist-nws-option.db-num = tt-2-hist-nws-option.db-num no-error .
     2415          CREATE tt0-hist-nws-option.
     2416          ASSIGN
     2417          tt0-hist-nws-option.db-num = tt-2-hist-nws-option.db-num
     2418          tt0-hist-nws-option.table-name = tt-2-hist-nws-option.table-name
     2419          tt0-hist-nws-option.host-code = tt-2-hist-nws-option.host-code
     2420          tt0-hist-nws-option.obj-type = tt-2-hist-nws-option.obj-type
     2421          tt0-hist-nws-option.obj-code = tt-2-hist-nws-option.obj-code
     2422          tt0-hist-nws-option.key#_one = tt-2-hist-nws-option.key#_one
     2423          tt0-hist-nws-option.charkey_one = tt-2-hist-nws-option.charkey_one
     2424          tt0-hist-nws-option.option-descr = tt-2-hist-nws-option.option-descr
     2425          tt0-hist-nws-option.hn-id = (if available last_tt0-hist-nws-option
     2426                                       then (last_tt0-hist-nws-option.hn-id  + 1)
     2427                                       else 1)
     2428         .
     2429         END.
     2430         ASSIGN
     2431         tt0-hist-nws-option.hist-to-nws = tt-2-hist-nws-option.hist-to-nws
     2432         tt0-hist-nws-option.nws-to-hist = tt-2-hist-nws-option.nws-to-hist
     2433         tt0-hist-nws-option.hist-from-prim = tt-2-hist-nws-option.hist-from-prim
     2434         tt0-hist-nws-option.nws-to-cd = tt-2-hist-nws-option.nws-to-cd
     2435         tt0-hist-nws-option.smart-nws = tt-2-hist-nws-option.smart-nws
     2436         tt0-hist-nws-option.get-hist-from-nws = tt-2-hist-nws-option.get-hist-from-nws
     2437         .
     2438         release tt0-hist-nws-option.
     2439         delete tt-2-hist-nws-option.
     2440      END.
     2441    END.
     2442   END.
     2443   ON CHOOSE OF B-mask IN FRAME Dialog-Frame
     2444   DO:
     2445     define variable v-rid-list as character no-undo .
     2446     run ref/dc-masks.w (
     2447                       INPUT parparentproc
     2448                      ,INPUT parhost-code
     2449                      ,INPUT parobj-type
     2450                      ,INPUT parobj-code
     2451                      ,input "":U
     2452                      ,INPUT "one":U
     2453                      ,INPUT ub.dis-card-type.TYPE
     2454                      ,INPUT ub.dis-card-type.emitent-host-code
     2455                      ,INPUT ?
     2456                      ,input-output v-rid-list
     2457                       ) NO-ERROR.
     2458     IF ERROR-STATUS:error  THEN RETURN NO-APPLY.
     2459   END.
     2460   ON CHOOSE OF b-params IN FRAME Dialog-Frame
     2461   DO:
     2462     if tt0-rp-by-call.call_id = '' then do:
     2463       message
     2464       "Пожалуйста, заполните поле <тип ДК>"
     2465       view-as alert-box warning.
     2466       return no-apply.
     2467     end.
     2468     CASE Rs-algo-profile:
     2469       when 'rule-by-call':U then do:
     2470         IF NOT AVAILABLE tt0-rule-by-call THEN RETURN NO-APPLY.
     2471         run ref/rulercps.w (
     2472                                input parparentproc
     2473                               ,input this-procedure:handle
     2474                               ,input '':U
     2475                               ,input p-mode
     2476                               ,input 'rule-call-param':U
     2477                               ,input 0
     2478                               ,input ?
     2479                               ,input tt0-rule-by-call.call_id
     2480                               ,input tt0-rule-by-call.codex_id
     2481                               ,input tt0-rule-by-call.ruleset_id
     2482                               ,input tt0-rule-by-call.order_id
     2483                               ,input tt0-rule-by-call.RULE_id
     2484                               ,INput substitute("Правило &1 &2"
     2485                                                , tt0-rule-by-call.RULE_id
     2486                                                , calldscr(tt0-rule-by-call.call_id)
     2487                                                )
     2488                               ,input-output table tt0-rule-call-param  ) no-error.
     2489        end.
     2490        when 'rp-by-call':U then do:
     2491         IF NOT AVAILABLE tt0-rp-by-call THEN RETURN NO-APPLY.
     2492         define variable v-param-form as character no-undo .
     2493         define buffer buf_rule-profile for ub.rule-profile.
     2494         find first buf_rule-profile no-lock where
     2495                   buf_rule-profile.profile_id = tt0-rp-by-call.profile_id.
     2496         assign
     2497         v-param-form = (if buf_rule-profile.custom-param-form > 0
     2498                         then  substitute("rul/rcps-&1.w", buf_rule-profile.profile_id)
     2499                         else "ref/rulercps.w")
     2500         .
     2501         run value(v-param-form) (
     2502                               input parparentproc
     2503                               ,input this-procedure:handle
     2504                               ,input 'b-chg':U
     2505                               ,input p-mode
     2506                               ,input 'rp-rule-param':U
     2507                               ,input tt0-rp-by-call.profile_id
     2508                               ,input tt0-rp-by-call.once-more
     2509                               ,input tt0-rp-by-call.call_id
     2510                               ,input 0
     2511                               ,input 0
     2512                               ,input ?
     2513                               ,input 0
     2514                               ,INput substitute("Профайл &1 № привязки &2 &3"
     2515                                                 ,tt0-rp-by-call.profile
     2516                                                 ,tt0-rp-by-call.once-more
     2517                                                 ,calldscr(tt0-rp-by-call.call_id)
     2518                                                 )
     2519                               ,input-output table tt0-rule-call-param  ) no-error.
     2520        end.
     2521      end case.
     2522   END.
     2523   ON CHOOSE OF b-prop-ref IN FRAME Dialog-Frame
     2524   DO:
     2525     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2526     run ref/proprefs.w ( INPUT parparentproc
     2527                     ,INPUT "":U
     2528                     ,INPUT "call_id"
     2529                     ,INPUT 0
     2530                     ,input '':U
     2531                     ,INPUT temp-dc-type.uniq-key-rec
     2532                     ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2533   END.
     2534   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     2535   DO:
     2536     rid = ?.
     2537   END.
     2538   ON CHOOSE OF B-rule IN FRAME Dialog-Frame
     2539   DO:
     2540     IF NOT AVAILABLE tt0-rule-by-call THEN RETURN NO-APPLY.
     2541     IF rule-display-option = "" THEN DO:
     2542      run gbl/pop-up.p ( input self:handle, input no) no-error.
     2543     END.
     2544     IF rule-display-option = "" THEN DO:
     2545       RETURN NO-APPLY.
     2546     END.
     2547     RUN proc-display-rule IN THIS-PROCEDURE (
     2548                                                INPUT rule-display-option
     2549                                               ,input tt0-rule-by-call.codex_id
     2550                                               ,input tt0-rule-by-call.ruleset_id
     2551                                               ,input tt0-rule-by-call.call_id
     2552                                               ,input tt0-rule-by-call.order_id
     2553                                               ,INPUT tt0-rule-by-call.rule_id) NO-ERROR.
     2554     IF ERROR-STATUS:ERROR THEN DO:
     2555       ASSIGN
     2556       rule-display-option = "".
     2557       RETURN NO-APPLY.
     2558     END.
     2559     ASSIGN
     2560     rule-display-option = "".
     2561   END.
     2562   ON CHOOSE OF b-rule-on-off IN FRAME Dialog-Frame
     2563   DO:
     2564     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     2565     if Rs-algo-profile <> 'rule-by-call':U then return no-apply.
     2566     IF NOT AVAILABLE tt0-rule-by-call THEN RETURN NO-APPLY.
     2567     IF X_rule-profile.IS_dynamic = NO  THEN DO:
     2568        MESSAGE
     2569        substitute("Данное правило не может быть включено/выключено,&1" +
     2570                   "так как принадлежит алгоритму, приписанному к карте ПО УМОЛЧАНИЮ!"
     2571                   , chr(10))
     2572        VIEW-AS ALERT-BOX ERROR.
     2573        RETURN NO-APPLY.
     2574     END.
     2575     if tt0-rule-by-call.is_dynamic = no then do:
     2576        MESSAGE
     2577        substitute("Данное правило не может быть включено/выключено,&1" +
     2578                   "согласно определенной профайлом логике!"
     2579                   , chr(10))
     2580        VIEW-AS ALERT-BOX ERROR.
     2581        RETURN NO-APPLY.
     2582     end.
     2583     IF tt0-rule-by-call.can-calc THEN DO:
     2584       MESSAGE
     2585       "Вы уверены, что хотите выключить правило?"
     2586       VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE gLOG.
     2587       IF NOT glog THEN RETURN NO-APPLY.
     2588     END.
     2589     ELSE DO:
     2590         MESSAGE
     2591         "Вы уверены, что хотите включить правило?"
     2592         VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE gLOG.
     2593         IF NOT glog THEN RETURN NO-APPLY.
     2594     END.
     2595     ASSIGN
     2596     tt0-rule-by-call.can-calc = NOT (tt0-rule-by-call.can-calc).
     2597     glog = br-rule-by-call:REFRESH() IN FRAME Dialog-Frame.
     2598   END.
     2599   ON CHOOSE OF B-ruleset IN FRAME Dialog-Frame
     2600   DO:
     2601   DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     2602   define buffer buf_ruleset for ub.ruleset.
     2603     IF NOT AVAILABLe tt0-rule-by-call THEN DO:
     2604         RETURN NO-APPLY.
     2605     END.
     2606     FIND FIRST buf_ruleset NO-LOCK WHERE
     2607               buf_ruleset.codex_id = tt0-rule-by-call.codex_id
     2608           AND buf_ruleset.ruleset_id = tt0-rule-by-call.ruleset_id.
     2609     run rul/ruleset-i.w ( input parparentproc
     2610                          ,input 'ПРОСМОТР':U
     2611                          ,input buf_ruleset.codex_id
     2612                          ,input buf_ruleset.ruleset_id
     2613                          ,input-output v-rec) no-error.
     2614   END.
     2615   ON VALUE-CHANGED OF br-profile IN FRAME Dialog-Frame
     2616   DO:
     2617   if br-profile:visible in frame Dialog-Frame then do:
     2618     IF NOT AVAILABLE tt0-rp-by-call THEN DO:
     2619        e-rule-name:SCREEN-VALUE = ''.
     2620     END.
     2621     ELSE DO:
     2622       e-rule-name:SCREEN-VALUE = tt0-rp-by-call.ps.
     2623     END.
     2624   end.
     2625   END.
     2626   ON VALUE-CHANGED OF br-rule-by-call IN FRAME Dialog-Frame
     2627   DO:
     2628     DEFINE BUFFER buf_rule FOR ub.RULE.
     2629     define buffer buf_rule-profile for ub.rule-profile.
     2630     IF NOT AVAILABLE tt0-rule-by-call THEN RETURN NO-APPLY.
     2631     FIND FIRST buf_rule NO-LOCK WHERE
     2632               buf_rule.RULE_id = tt0-rule-by-call.RULE_id NO-ERROR.
     2633     IF NOT AVAILABLE buf_rule THEN DO:
     2634        e-rule-name:SCREEN-VALUE = SUBSTITUTE("!!!Правило &1 не найдено", tt0-rule-by-call.RULE_Id).
     2635     END.
     2636     ELSE DO:
     2637       e-rule-name:SCREEN-VALUE = buf_rule.name + chr(10) + buf_rule.documentation.
     2638     END.
     2639     find first buf_rule-profile no-lock where
     2640               buf_rule-profile.profile_id = tt0-rule-by-call.profile_id.
     2641     b-rule-on-off:sensitive in frame Dialog-Frame = (p-mode <> 'ПРОСМОТР':U)
     2642                                                  and buf_rule-profile.custom-param-form = 0
     2643                                                  and (Rs-algo-profile = 'rule-by-call':U).
     2644   END.
     2645   ON VALUE-CHANGED OF temp-dc-type.dflt-credit-card IN FRAME Dialog-Frame
     2646   DO:
     2647    RUN BUTTONS IN THIS-PROCEDURE NO-ERROR.
     2648   END.
     2649   ON VALUE-CHANGED OF temp-dc-type.dflt-debet-card IN FRAME Dialog-Frame
     2650   DO:
     2651     RUN BUTTONS IN THIS-PROCEDURE NO-ERROR.
     2652   END.
     2653   ON LEAVE OF E-rule-name IN FRAME Dialog-Frame
     2654   DO:
     2655     run local-notes in this-procedure no-error.
     2656   END.
     2657   ON ENTRY OF temp-dc-type.emitent-host-code IN FRAME Dialog-Frame
     2658   DO:
     2659     old-emitent-host-code = integer(temp-dc-type.emitent-host-code:screen-value).
     2660   END.
     2661   ON LEAVE OF temp-dc-type.emitent-host-code IN FRAME Dialog-Frame
     2662   DO:
     2663   if integer(temp-dc-type.emitent-host-code:screen-value) <>   old-emitent-host-code then do:
     2664     display
     2665     "":U @ temp-dc-type.dcbyshop
     2666     with frame Dialog-Frame.
     2667   end.
     2668   run display-r-b-abbr in this-procedure ( output v-r-b-code) no-error.
     2669   RUN proc-refresh-tt IN THIS-PROCEDURE NO-ERROR.
     2670   OPEN QUERY br-profile FOR EACH tt0-rp-by-call WHERE          tt0-rp-by-call.call_id = temp-dc-type.uniq-key-rec NO-LOCK INDEXED-REPOSITION.
     2671   APPLY "VALUE-CHANGED" to br-profile.
     2672   OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = temp-dc-type.uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   AND (rs-algo-types = 1 or X_rule-profile.is_dynamic = yes)  BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     2673   APPLY "VALUE-CHANGED" to br-rule-by-call.
     2674   END.
     2675   ON CHOOSE OF MENU-ITEM m_graph
     2676   DO:
     2677       IF NOT AVAILABLE tt0-rule-by-call THEN RETURN NO-APPLY.
     2678     ASSIGN
     2679     rule-display-option = "graph".
     2680     RUN proc-display-rule IN THIS-PROCEDURE (  INPUT rule-display-option
     2681                                               ,INPUT tt0-rule-by-call.codex_id
     2682                                               ,INPUT tt0-rule-by-call.ruleset_id
     2683                                               ,INPUT tt0-rule-by-call.call_id
     2684                                               ,INPUT tt0-rule-by-call.order_id
     2685                                               ,INPUT tt0-rule-by-call.rule_id) NO-ERROR.
     2686     ASSIGN
     2687     rule-display-option = "".
     2688   END.
     2689   ON CHOOSE OF MENU-ITEM m_text
     2690   DO:
     2691     IF NOT AVAILABLE tt0-rule-by-call THEN RETURN NO-APPLY.
     2692     ASSIGN
     2693     rule-display-option = "text".
     2694     RUN proc-display-rule IN THIS-PROCEDURE (  INPUT rule-display-option
     2695                                               ,INPUT tt0-rule-by-call.codex_id
     2696                                               ,INPUT tt0-rule-by-call.ruleset_id
     2697                                               ,INPUT tt0-rule-by-call.call_id
     2698                                               ,INPUT tt0-rule-by-call.order_id
     2699                                               ,INPUT tt0-rule-by-call.rule_id) NO-ERROR.
     2700     ASSIGN
     2701     rule-display-option = "".
     2702   END.
     2703   ON VALUE-CHANGED OF Rs-algo-profile IN FRAME Dialog-Frame
     2704   DO:
     2705     ASSIGN
     2706     rs-algo-profile.
     2707     CASE rs-algo-profile:
     2708       WHEN 'rule-by-call':U THEN DO:
     2709         e-rule-name:read-only = yes.
     2710         HIDE
     2711         br-profile
     2712         b-addalgo
     2713         b-delalgo
     2714         IN FRAME Dialog-Frame.
     2715         .
     2716         DISPLAY
     2717         rs-algo-types
     2718         br-rule-by-call
     2719         b-rule
     2720         b-ruleset
     2721         b-rule-on-off
     2722         WITH FRAME Dialog-Frame.
     2723         APPLY "VALUE-CHANGED" to br-rule-by-call.
     2724       END.
     2725       WHEN 'rp-by-call':U THEN DO:
     2726         e-rule-name:read-only = (if p-mode <> 'ПРОСМОТР':U then no else yes).
     2727         HIDE
     2728         br-rule-by-call
     2729         rs-algo-types
     2730         b-rule
     2731         b-ruleset
     2732         b-rule-on-off
     2733         IN FRAME Dialog-Frame.
     2734         DISPLAY
     2735         br-profile
     2736         b-addalgo
     2737         b-delalgo
     2738         WITH FRAME Dialog-Frame.
     2739         APPLY "VALUE-CHANGED" to br-profile.
     2740       END.
     2741     END CASE.
     2742   END.
     2743   ON VALUE-CHANGED OF rs-algo-types IN FRAME Dialog-Frame
     2744   DO:
     2745     ASSIGN
     2746     rs-algo-types.
     2747     OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = temp-dc-type.uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   AND (rs-algo-types = 1 or X_rule-profile.is_dynamic = yes)  BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     2748     APPLY "VALUE-CHANGED" TO br-rule-by-call IN FRAME Dialog-Frame.
     2749   END.
     2750   ON VALUE-CHANGED OF T-check-by-mask IN FRAME Dialog-Frame
     2751   DO:
     2752     ASSIGN
     2753     t-check-by-mask.
     2754     CASE t-check-by-mask:
     2755     WHEN YES THEN DO:
     2756       IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     2757         ENABLE
     2758         t-ho-join
     2759         WITH FRAME Dialog-Frame.
     2760       END.
     2761       else do:
     2762         disable
     2763         t-ho-join
     2764         WITH FRAME Dialog-Frame.
     2765       end.
     2766     END.
     2767     WHEN NO THEN DO:
     2768       ASSIGN
     2769       t-ho-join = NO.
     2770       display
     2771       t-ho-join
     2772       with frame Dialog-Frame .
     2773       DISABLE
     2774       t-ho-join
     2775       WITH FRAME Dialog-Frame.
     2776     END.
     2777   END CASE.
     2778   END.
     2779   ON LEAVE OF temp-dc-type.type IN FRAME Dialog-Frame
     2780   DO:
     2781     IF p-mode = 'ДОБАВЛЕНИЕ':U  THEN DO:
     2782        ASSIGN
     2783        temp-dc-type.TYPE.
     2784        RUN proc-refresh-tt IN THIS-PROCEDURE no-error.
     2785        OPEN QUERY br-profile FOR EACH tt0-rp-by-call WHERE          tt0-rp-by-call.call_id = temp-dc-type.uniq-key-rec NO-LOCK INDEXED-REPOSITION.
     2786        APPLY "VALUE-CHANGED" to br-profile.
     2787        OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = temp-dc-type.uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   AND (rs-algo-types = 1 or X_rule-profile.is_dynamic = yes)  BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     2788         APPLY "VALUE-CHANGED" to br-rule-by-call.
     2789     END.
     2790   END.
     2791   ON VALUE-CHANGED OF v-dflt-d-pcnt-method IN FRAME Dialog-Frame
     2792   DO:
     2793    ASSIGN
     2794     v-dflt-d-pcnt-method.
     2795     CASE v-dflt-d-pcnt-method:
     2796         WHEN '1':U THEN DO:
     2797            ASSIGN
     2798            v-mode[2] = 'ПРОСМОТР':U
     2799            v-mode[1] = p-mode
     2800            .
     2801         END.
     2802         WHEN '2':U THEN DO:
     2803             ASSIGN
     2804             v-mode[1] = 'ПРОСМОТР':U
     2805             v-mode[2] = p-mode
     2806             .
     2807         END.
     2808         WHEN '3':U THEN DO:
     2809             ASSIGN
     2810             v-mode[1] = p-mode
     2811             v-mode[2] = p-mode
     2812             .
     2813         END.
     2814     END CASE.
     2815   END.
     2816   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2817   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2818   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2819   on help of frame Dialog-Frame
     2820   do:
     2821     run gbl/app_help.p
     2822       (input this-procedure :file-name
     2823       ,input ''
     2824       ,input ?
     2825       ) no-error.
     2826     if error-status :error then do:
     2827       message
     2828         "Ошибка при вызове помощи"
     2829         error-status :get-message(1)
     2830         view-as alert-box .
     2831     end.
     2832   end.
     2833   run minbtn-set in this-procedure .
     2834   on choose of b-help in frame Dialog-Frame
     2835   do:
     2836     apply "help":u to frame Dialog-Frame .
     2837   end.
     2838   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2839   procedure minbtn-set :
     2840       do
     2841           on error undo, return error return-value
     2842           :
     2843           define variable ii              as integer       no-undo .
     2844           define variable fh              as widget-handle no-undo .
     2845           define variable hh              as widget-handle no-undo .
     2846           define variable v-h             as handle        extent 4 no-undo .
     2847           define variable v-name-button   as character     no-undo .
     2848           define variable v-help-old-x    as decimal       no-undo .
     2849           define variable v-help-old-y    as decimal       no-undo .
     2850           define variable v-help-old-size as decimal       no-undo .
     2851           define variable v-frame-width   as decimal       no-undo .
     2852           define variable jj              as integer       no-undo .
     2853           do
     2854               on error undo, return error
     2855               :
     2856               assign
     2857                   v-frame-width = frame Dialog-Frame:width - 0.3
     2858                   fh            = frame Dialog-Frame:first-child
     2859                   hh            = fh:first-child
     2860                   ii            = 1
     2861                   .
     2862               do while valid-handle(hh):
     2863                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2864                   do:
     2865                       case lc(hh:name) :
     2866                           when "b-help" then
     2867                               do:
     2868                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2869                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2870                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2871                                   hh:TOOLTIP = "Помощь" .
     2872                                   v-help-old-x = hh:column .
     2873                                   v-help-old-y = hh:row    .
     2874                                   v-help-old-size = hh:width .
     2875                                   hh:width-chars = 2.5 .
     2876                               end.
     2877                           when "b-print" then
     2878                               do:
     2879                                   hh:load-image("cmp/b-print.bmp":u) .
     2880                                   hh:TOOLTIP = "Печать" .
     2881                                   v-h[ii] = hh:handle .
     2882                                   ii = ii + 1 .
     2883                                   hh:width-chars = 3 .
     2884                               end.
     2885                           when "b-history" or
     2886                           when "b-hist" then
     2887                               do:
     2888                                   hh:load-image("cmp/b-hist.bmp":u) .
     2889                                   hh:TOOLTIP = "История" .
     2890                                   v-h[ii] = hh:handle .
     2891                                   ii = ii + 1 .
     2892                                   hh:width-chars = 3 .
     2893                               end.
     2894                           when "b-sch" then
     2895                               do:
     2896                                   hh:load-image("cmp/b-sch.bmp":u) .
     2897                                   hh:TOOLTIP = "Установка Фильтра" .
     2898                                   v-h[ii] = hh:handle .
     2899                                   ii = ii + 1 .
     2900                                   hh:width-chars = 3 .
     2901                               end.
     2902                           when "b-hist-user" then
     2903                               do:
     2904                                   hh:load-image("cmp/b-hist.bmp":u) .
     2905                                   hh:TOOLTIP = "История пользователя" .
     2906                                   ii = ii + 1 .
     2907                               end.
     2908                       end case.
     2909                   end.
     2910                   hh = hh:next-sibling.
     2911               end.
     2912               b-help:column = v-frame-width - b-help:width-chars.
     2913               jj = 0.
     2914               repeat ii = 4 to 1 by -1 :
     2915                   if valid-handle (v-h[ii] ) then
     2916                   do:
     2917                       jj  = jj + 1 .
     2918                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2919                       v-h[ii]:row    = v-help-old-y .
     2920                   end.
     2921               end.
     2922           end.
     2923       end.
     2924   end procedure.
     2925   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2926   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2927   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2928   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2929   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2930   define variable v-diasize-current-frame-height as decimal   no-undo .
     2931   define variable v-diasize-change-size          as logical   no-undo .
     2932   define variable v-diasize-resize-button        as handle    no-undo .
     2933   define variable v-diasize-wndmax               as logical   no-undo .
     2934   define variable v-diasize-wndstore             as logical   no-undo .
     2935   define variable v-diasize-proc-name            as character no-undo .
     2936   define variable v-diasize-browse-handle        as handle    no-undo .
     2937   define variable v-diasize-browse-number        as integer   no-undo .
     2938   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2939   define temp-table temp-diasize-handle no-undo
     2940     field handle-value  as handle
     2941     field save-position as decimal
     2942     index xpk is primary unique handle-value
     2943     .
     2944   define temp-table temp-browse-handle no-undo
     2945     field browse-type   as character
     2946     field browse-number as integer
     2947     field browse-handle as handle
     2948     field original-size as decimal
     2949     index xpk is primary unique browse-type browse-number
     2950     index xie browse-type browse-handle
     2951   .
     2952   procedure diasize_change-height :
     2953     define input  parameter p-change-value  as decimal   no-undo .
     2954     define input  parameter p-move-resize   as logical   no-undo .
     2955     define variable v-field-group-handle    as handle    no-undo .
     2956     define variable v-object-handle         as handle    no-undo .
     2957     define variable v-frame-height          as decimal   no-undo .
     2958     define variable v-frame-virtual-height  as decimal   no-undo .
     2959     define variable v-browse-height         as decimal   no-undo .
     2960     define variable v-window-height         as decimal   no-undo .
     2961     define variable v-window-virtual-height as decimal   no-undo .
     2962     define variable v-change-sign           as integer   no-undo .
     2963     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2964     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2965     if p-change-value > 0
     2966     then do:
     2967       if frame Dialog-Frame :height + p-change-value
     2968           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2969       then do:
     2970         assign
     2971           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2972                           - (frame Dialog-Frame :height-chars)
     2973         .
     2974         if p-change-value <= 0
     2975         then do:
     2976           run diasize_position-resize-button in this-procedure .
     2977           return .
     2978         end.
     2979       end.
     2980     end.
     2981     if p-change-value < 0
     2982     then do:
     2983       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2984       then do:
     2985         assign
     2986           p-change-value = v-diasize-orig-frame-height
     2987                          - (frame Dialog-Frame :height-chars)
     2988         .
     2989         if p-change-value >= 0
     2990         then do:
     2991           run diasize_position-resize-button in this-procedure .
     2992           return .
     2993         end.
     2994       end.
     2995     end.
     2996     if p-change-value >= 0
     2997     then do:
     2998       assign
     2999         v-change-sign = 1
     3000       .
     3001     end.
     3002     else do:
     3003       assign
     3004         v-change-sign = -1
     3005       .
     3006     end.
     3007     assign
     3008       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3009     .
     3010     if p-change-value = 0
     3011     then do:
     3012       run diasize_position-resize-button in this-procedure .
     3013       return .
     3014     end.
     3015     move_block:
     3016     do
     3017     on error undo move_block, retry move_block
     3018     :
     3019       if retry
     3020       then do:
     3021         do
     3022         on error undo move_block, leave move_block
     3023         :
     3024           if p-change-value > 0
     3025           then do:
     3026             for each buf_temp-diasize-handle
     3027             on error undo, next
     3028             :
     3029               assign
     3030                 v-object-handle = buf_temp-diasize-handle.handle-value
     3031               .
     3032               if v-object-handle <> v-diasize-resize-button
     3033               then do:
     3034                 assign
     3035                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3036                 .
     3037               end.
     3038             end.
     3039             assign
     3040               v-diasize-browse-handle :height = v-browse-height
     3041             .
     3042             for each buf_temp-browse-handle
     3043               where buf_temp-browse-handle.browse-type = 'height':u
     3044             on error undo, next
     3045             :
     3046               assign
     3047                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3048               .
     3049             end.
     3050             assign
     3051               frame Dialog-Frame :height = v-frame-height
     3052             .
     3053             if frame Dialog-Frame :scrollable = true
     3054             then do:
     3055               assign
     3056                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3057               .
     3058             end.
     3059             run diasize_position-resize-button in this-procedure .
     3060           end.
     3061           else do:
     3062             if frame Dialog-Frame :scrollable = true
     3063             then do:
     3064               assign
     3065                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3066               .
     3067             end.
     3068             assign
     3069               frame Dialog-Frame :height = v-frame-height
     3070             .
     3071             assign
     3072               v-diasize-browse-handle :height = v-browse-height
     3073             .
     3074             for each buf_temp-browse-handle
     3075               where buf_temp-browse-handle.browse-type = 'height':u
     3076             on error undo, next
     3077             :
     3078               assign
     3079                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3080               .
     3081             end.
     3082             for each buf_temp-diasize-handle
     3083             on error undo, next
     3084             :
     3085               assign
     3086                 v-object-handle = buf_temp-diasize-handle.handle-value
     3087               .
     3088               if v-object-handle <> v-diasize-resize-button
     3089               then do:
     3090                 assign
     3091                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3092                 .
     3093               end.
     3094             end.
     3095             run diasize_position-resize-button in this-procedure .
     3096           end.
     3097           assign
     3098             v-diasize-change-size = false
     3099           .
     3100           leave move_block .
     3101         end.
     3102       end.
     3103       assign
     3104         v-diasize-need-full-display = true
     3105       .
     3106       if v-diasize-change-size = false
     3107       then do:
     3108         assign
     3109           v-diasize-change-size = true
     3110         .
     3111       end.
     3112       else do:
     3113         return .
     3114       end.
     3115       assign
     3116         v-frame-height = frame Dialog-Frame :height
     3117         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3118         v-browse-height = v-diasize-browse-handle :height
     3119       .
     3120       for each buf_temp-browse-handle
     3121         where buf_temp-browse-handle.browse-type = 'height':u
     3122       :
     3123         assign
     3124           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3125         .
     3126       end.
     3127       for each buf_temp-diasize-handle
     3128       :
     3129         delete buf_temp-diasize-handle .
     3130       end.
     3131       assign
     3132         v-field-group-handle = frame Dialog-Frame :first-child
     3133       .
     3134       do while valid-handle(v-field-group-handle)
     3135       :
     3136         assign
