     3726   procedure diasize_position-resize-button :
     3727     do with frame Dialog-Frame
     3728     :
     3729       hide v-diasize-resize-button .
     3730       assign
     3731         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3732                     - 1
     3733                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3734         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3735                     - 1
     3736                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3737       .
     3738       view v-diasize-resize-button .
     3739     end.
     3740   end procedure.
     3741   on alt-right anywhere
     3742   do:
     3743     run diasize_change-width in this-procedure
     3744       (input 1
     3745       ,input true
     3746       ) .
     3747     return no-apply .
     3748   end.
     3749   on alt-left anywhere
     3750   do:
     3751     run diasize_change-width in this-procedure
     3752       (input -1
     3753       ,input true
     3754       ) .
     3755     return no-apply .
     3756   end.
     3757   on alt-down anywhere
     3758   do:
     3759     run diasize_change-height in this-procedure
     3760       (input 1
     3761       ,input true
     3762       ) .
     3763     return no-apply .
     3764   end.
     3765   on alt-up anywhere
     3766   do:
     3767     run diasize_change-height in this-procedure
     3768       (input -1
     3769       ,input true
     3770       ) .
     3771     return no-apply .
     3772   end.
     3773   on alt-enter of frame Dialog-Frame
     3774   do:
     3775     run diasize_maximize in this-procedure
     3776       (input  ?
     3777       ).
     3778     return no-apply .
     3779   end.
     3780   procedure diasize_end-move :
     3781     do
     3782     on error undo, return error return-value
     3783     :
     3784       define variable v-row-delta as decimal   no-undo .
     3785       define variable v-col-delta as decimal   no-undo .
     3786       define variable v-new-row as decimal   no-undo .
     3787       define variable v-new-col as decimal   no-undo .
     3788       assign
     3789         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3790         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3791       .
     3792       assign
     3793         v-row-delta = v-new-row - frame Dialog-Frame :height
     3794         v-col-delta = v-new-col - frame Dialog-Frame :width
     3795       .
     3796       run diasize_change-height in this-procedure
     3797         (input v-row-delta
     3798         ,input true
     3799         ) .
     3800       run diasize_change-width in this-procedure
     3801         (input v-col-delta
     3802         ,input true
     3803         ) .
     3804     end.
     3805   end procedure.
     3806   procedure diasize_maximize :
     3807     define input  parameter p-action as logical   no-undo .
     3808     do
     3809     on error undo, return error return-value
     3810     :
     3811       if p-action = ?
     3812       then do:
     3813         if v-diasize-need-maximize = true
     3814         then do:
     3815           assign
     3816             p-action = true
     3817           .
     3818         end.
     3819         else do:
     3820           assign
     3821             p-action = false
     3822           .
     3823         end.
     3824       end.
     3825       if p-action = true
     3826       then do:
     3827         run diasize_change-height in this-procedure
     3828           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3829               - frame Dialog-Frame :height-chars
     3830           ,input true
     3831           ) .
     3832         run diasize_change-width in this-procedure
     3833           (input session :width-chars
     3834               - frame Dialog-Frame :width-chars
     3835           ,input true
     3836           ) .
     3837         assign
     3838           v-diasize-need-maximize = false
     3839         .
     3840       end.
     3841       else do:
     3842         run diasize_change-width in this-procedure
     3843           (input v-diasize-orig-frame-width
     3844               - frame Dialog-Frame :width-chars
     3845           ,input true
     3846           ) .
     3847         run diasize_change-height in this-procedure
     3848           (input v-diasize-orig-frame-height
     3849               - frame Dialog-Frame :height-chars
     3850           ,input true
     3851           ) .
     3852         assign
     3853           v-diasize-need-maximize = true
     3854         .
     3855       end.
     3856     end.
     3857   end procedure.
     3858   procedure diasize_restore-orig-size :
     3859     do
     3860     on error undo, return error return-value
     3861     :
     3862       assign
     3863         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3864         v-diasize-current-frame-height = frame Dialog-Frame :height
     3865       .
     3866       run diasize_set-height in this-procedure
     3867         (input  v-diasize-orig-frame-height
     3868         ,input  true
     3869         ) .
     3870       run diasize_set-width in this-procedure
     3871         (input  v-diasize-orig-frame-width
     3872         ,input  true
     3873         ) .
     3874     end.
     3875   end procedure.
     3876   procedure diasize_restore-current-size :
     3877     do
     3878     on error undo, return error return-value
     3879     :
     3880       run diasize_set-height in this-procedure
     3881         (input  v-diasize-current-frame-height
     3882         ,input  true
     3883         ) .
     3884       run diasize_set-width in this-procedure
     3885         (input  v-diasize-current-frame-width
     3886         ,input  true
     3887         ) .
     3888     end.
     3889   end procedure.
     3890   procedure diasize_set-browse-handle :
     3891     define input  parameter p-browse-handle as handle   no-undo .
     3892     define buffer buf_temp-browse-handle for temp-browse-handle .
     3893     do
     3894     on error undo, return error return-value
     3895     :
     3896       assign
     3897         v-diasize-browse-handle = p-browse-handle
     3898       .
     3899       for each buf_temp-browse-handle
     3900       on error undo, return error return-value
     3901       :
     3902         delete buf_temp-browse-handle .
     3903       end.
     3904     end.
     3905   end procedure.
     3906   procedure diasize_add_browse :
     3907     define input  parameter p-browse-type   as character no-undo .
     3908     define input  parameter p-browse-handle as handle    no-undo .
     3909     define buffer buf_temp-browse-handle for temp-browse-handle .
     3910     do
     3911     on error undo, return error return-value
     3912     :
     3913       assign
     3914         v-diasize-browse-number = v-diasize-browse-number + 1
     3915       .
     3916       create buf_temp-browse-handle .
     3917       assign
     3918         buf_temp-browse-handle.browse-type   = p-browse-type
     3919         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3920         buf_temp-browse-handle.browse-handle = p-browse-handle
     3921       .
     3922     end.
     3923   end procedure.
     3924   procedure diasize_init :
     3925     define variable v-default-value    as logical   no-undo .
     3926     define variable v-restore-saved    as logical   no-undo .
     3927     define variable v-resize-value-str as character no-undo .
     3928     do
     3929     on error undo, return error return-value
     3930     :
     3931       do with frame Dialog-Frame
     3932       :
     3933         assign
     3934           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3935           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3936           v-diasize-browse-handle     = browse br-profile :handle
     3937         .
     3938         create button v-diasize-resize-button
     3939         assign
     3940           parent        = frame Dialog-Frame :first-child
     3941           label         = "s"
     3942           height-pixels = 16
     3943           width-pixels  = 16
     3944           visible       = true
     3945           sensitive     = true
     3946           movable       = true
     3947           triggers:
     3948             on end-move persistent run diasize_end-move in this-procedure .
     3949           end triggers.
     3950         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3951         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3952         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3953         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3954         assign
     3955           v-diasize-wndmax = false
     3956         .
     3957         if connected("ub") = true
     3958         then do:
     3959           define variable v-cntxt-db-num        as integer   no-undo .
     3960           define variable v-cntxt-userid        as character no-undo .
     3961           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3962                                             , OUTPUT v-cntxt-userid
     3963                                             ) .
     3964           run gbl/wndpar_r.p
     3965             (input  v-cntxt-db-num
     3966             ,input  v-cntxt-userid
     3967             ,input  'wndmax':U
     3968             ,output v-diasize-wndmax
     3969             ,output v-default-value
     3970             ) .
     3971         end.
     3972         assign
     3973           v-diasize-wndstore = false
     3974         .
     3975         if connected("ub") = true
     3976         then do:
     3977           run gbl/wndpar_r.p
     3978             (input  v-cntxt-db-num
     3979             ,input  v-cntxt-userid
     3980             ,input  'wndstore':U
     3981             ,output v-diasize-wndstore
     3982             ,output v-default-value
     3983             ) .
     3984         end.
     3985         assign
     3986           v-diasize-proc-name = entry(1, program-name(2), '.')
     3987         .
     3988         if v-diasize-wndstore = true
     3989         then do:
     3990           assign
     3991             v-restore-saved = false
     3992           .
     3993           if connected("ub") = true
     3994           then do:
     3995             run gbl/wndsizer.p
     3996               (input  v-cntxt-db-num
     3997               ,input  v-cntxt-userid
     3998               ,input  v-diasize-proc-name
     3999               ,input  'height':u
     4000               ,output v-resize-value-str
     4001               ) .
     4002             if v-resize-value-str <> '':U
     4003             then do:
     4004               run diasize_change-height in this-procedure
     4005                 (input  integer(v-resize-value-str)
     4006                 ,input  true
     4007                 ) .
     4008               assign
     4009                 v-restore-saved = true
     4010               .
     4011             end.
     4012           end.
     4013           if connected("ub") = true
     4014           then do:
     4015             run gbl/wndsizer.p
     4016               (input  v-cntxt-db-num
     4017               ,input  v-cntxt-userid
     4018               ,input  v-diasize-proc-name
     4019               ,input  'width':u
     4020               ,output v-resize-value-str
     4021               ) .
     4022             if v-resize-value-str <> '':U
     4023             then do:
     4024               run diasize_change-width in this-procedure
     4025                 (input  integer(v-resize-value-str)
     4026                 ,input  true
     4027                 ) .
     4028               assign
     4029                 v-restore-saved = true
     4030               .
     4031             end.
     4032           end.
     4033           if v-restore-saved <> true
     4034           then do:
     4035             if v-diasize-wndmax = true
     4036             then do:
     4037               run diasize_maximize in this-procedure
     4038                 (input  true
     4039                 ) .
     4040             end.
     4041           end.
     4042         end.
     4043         else do:
     4044           if v-diasize-wndmax = true
     4045           then do:
     4046             run diasize_maximize in this-procedure
     4047               (input  true
     4048               ) .
     4049           end.
     4050         end.
     4051       end.
     4052     end.
     4053   end procedure.
     4054   procedure diasize_need-full-display :
     4055     define output parameter p-need-full-display as logical   no-undo .
     4056     do
     4057     on error undo, return error return-value
     4058     :
     4059       assign
     4060         p-need-full-display = v-diasize-need-full-display
     4061       .
     4062       assign
     4063         v-diasize-need-full-display = false
     4064       .
     4065     end.
     4066   end procedure.
     4067   procedure get-context :
     4068      define output parameter p-db-num as integer          no-undo.
     4069      define output parameter p-user-id as character        no-undo.
     4070      define variable v-login               as character    no-undo.
     4071      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4072      define buffer buf_user-login  for ub.user-login .
     4073      do
     4074      on error undo, return error
     4075      :
     4076            FIND FIRST buf_sys-ctrl no-lock.
     4077            ASSIGN
     4078               v-login = USERID("ub")
     4079               p-db-num = buf_sys-ctrl.db-num
     4080            .
     4081            FIND FIRST buf_user-login
     4082                 WHERE buf_user-login.db-num = p-db-num
     4083                   AND buf_user-login.user-login = v-login
     4084                 no-lock
     4085                 no-error
     4086                 .
     4087            IF AVAILABLE buf_user-login
     4088            THEN DO:
     4089               assign
     4090                  p-user-id = buf_user-login.user-id
     4091               .
     4092            END.
     4093      end.
     4094   end procedure.
     4095       run diasize_init in this-procedure .
     4096   procedure rcpscont_get-rule-on-off :
     4097   define input parameter p-codex-id as integer no-undo .
     4098   define input parameter p-ruleset-id as integer no-undo .
     4099   define input parameter p-rule-id as integer no-undo .
     4100   define input parameter p-profile-id as integer no-undo .
     4101   define input parameter p-once-more as integer no-undo .
     4102   define output parameter p-on-off as logical no-undo .
     4103   define buffer buf_tt0-rule-by-call for tt0-rule-by-call.
     4104   find first buf_tt0-rule-by-call where
     4105            buf_tt0-rule-by-call.codex_id = p-codex-id
     4106        and buf_tt0-rule-by-call.ruleset_id = p-ruleset-id
     4107        and buf_tt0-rule-by-call.profile_id = p-profile-id
     4108        and buf_tt0-rule-by-call.once-more = p-once-more
     4109        and buf_tt0-rule-by-call.rule_id = p-rule-id
     4110        no-error .
     4111   if available buf_tt0-rule-by-call then do:
     4112      p-on-off = buf_tt0-rule-by-call.can-calc.
     4113   end.
     4114   end procedure.
     4115   procedure rcpscont_set-rule-on-off :
     4116   define input parameter p-codex-id as integer no-undo .
     4117   define input parameter p-ruleset-id as integer no-undo .
     4118   define input parameter p-rule-id as integer no-undo .
     4119   define input parameter p-profile-id as integer no-undo .
     4120   define input parameter p-once-more as integer no-undo .
     4121   define input parameter p-on-off as logical no-undo .
     4122   define variable v-h as handle no-undo .
     4123   define buffer buf_tt0-rule-by-call for tt0-rule-by-call.
     4124   v-h = buffer tt0-rule-by-call:handle.
     4125   if v-h:table <> ''
     4126   and v-h:table <> ? then do:
     4127     find first buf_tt0-rule-by-call where
     4128             buf_tt0-rule-by-call.codex_id = p-codex-id
     4129         and buf_tt0-rule-by-call.ruleset_id = p-ruleset-id
     4130         and buf_tt0-rule-by-call.profile_id = p-profile-id
     4131         and buf_tt0-rule-by-call.once-more = p-once-more
     4132         and buf_tt0-rule-by-call.rule_id = p-rule-id   no-error .
     4133     if not available buf_tt0-rule-by-call then do:
     4134       undo, return error .
     4135     end.
     4136     buf_tt0-rule-by-call.can-calc = p-on-off .
     4137     release buf_tt0-rule-by-call.
     4138   end.
     4139   OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = temp-dc-type.uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   AND (rs-algo-types = 1 or X_rule-profile.is_dynamic = yes)  BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     4140   end procedure.
     4141   MAIN-BLOCK:
     4142   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4143      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4144   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4145   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4146     (output v-curr-r-b
     4147     )  .
     4148     if p-mode <> 'ИЗМЕНЕНИЕ':U and p-mode <> 'ДОБАВЛЕНИЕ':U AND p-mode <> 'ПРОСМОТР':U then do:
     4149           message vss-workfile vss-revision vss-description skip
     4150                       "Неверный параметр вызова p-mode"
     4151           view-as alert-box ERROR.
     4152           return error.
     4153       end.
     4154       for each temp-dc-type:
     4155           delete temp-dc-type.
     4156       end.
     4157     if p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ПРОСМОТР':U then do:
     4158       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     4159         do transaction
     4160         on error undo, return error
     4161         on stop undo, return error
     4162         :
     4163           find first dis-card-type EXclusive-lock where recid(dis-card-type) = rid no-wait no-error.
     4164           if locked dis-card-type then do:
     4165             message vss-workfile vss-revision vss-description skip
     4166                     "Запись типа дисконтной карты занята"
     4167             view-as alert-box error .
     4168             return error.
     4169           end.
     4170         end.
     4171       end.
     4172       else do:
     4173         find first dis-card-type no-lock where recid(dis-card-type) = rid.
     4174       end.
     4175       if not available dis-card-type then do:
     4176         message vss-workfile vss-revision vss-description skip
     4177                 "Не найдена запись типа дисконтной карты"
     4178         view-as alert-box error .
     4179       end.
     4180       create temp-dc-type.
     4181       buffer-copy dis-card-type to temp-dc-type.
     4182     end.
     4183     ELSE DO:
     4184       CREATE temp-dc-type.
     4185       assign
     4186       temp-dc-type.cardname-sent = 'name':U
     4187       temp-dc-type.custom-sent = substitute("&1,&1"
     4188                                               ,chr(63) )
     4189       .
     4190     END.
     4191     RUN dc-typei_FILL-table IN THIS-PROCEDURE ( input p-mode
     4192                                                ,input no
     4193                                                ,output f-dflt-pcnt
     4194                                                ,output f-dflt-cash-pcnt
     4195                                                ,output f-dflt-pcnt-kat
     4196                                               ) no-error .
     4197     if error-status:error then do:
     4198       message
     4199       error-status:get-message(1) return-value
     4200       view-as alert-box error .
     4201       undo main-block, return error .
     4202     end.
     4203     OPEN QUERY br-profile FOR EACH tt0-rp-by-call WHERE          tt0-rp-by-call.call_id = temp-dc-type.uniq-key-rec NO-LOCK INDEXED-REPOSITION.
     4204     APPLY "VALUE-CHANGED" to br-profile IN FRAME Dialog-Frame.
     4205     OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = temp-dc-type.uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   AND (rs-algo-types = 1 or X_rule-profile.is_dynamic = yes)  BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     4206     APPLY "value-changed" TO br-rule-by-call IN FRAME Dialog-Frame.
     4207     RUN Myenable in this-procedure .
     4208     WAIT-FOR GO OF FRAME Dialog-Frame.
     4209   END.
     4210   RUN disable_UI.
     4211   PROCEDURE buttons :
     4212   define variable v-found as logical no-undo .
     4213   define buffer buf_tt0-dis-dct-rule for tt0-dis-dct-rule.
     4214   if temp-dc-type.dflt-credit-card:screen-value IN FRAME Dialog-Frame = "yes":U
     4215   AND p-mode <> 'ПРОСМОТР':U THEN DO:
     4216     enable
     4217     temp-dc-type.lim-kr
     4218     with frame Dialog-Frame.
     4219     assign
     4220     temp-dc-type.dflt-debet-card = no
     4221     .
     4222     display
     4223     temp-dc-type.dflt-debet-card
     4224     with frame Dialog-Frame.
     4225     DISABLE
     4226     temp-dc-type.dflt-debet-card
     4227     with frame Dialog-Frame.
     4228    END.
     4229     else do:
     4230       if p-mode <> 'ДОБАВЛЕНИЕ':U
     4231       and
     4232       ub.dis-card-type.emitent-host-code = 0
     4233       then do:
     4234         DISABLE
     4235         temp-dc-type.dflt-credit-card
     4236         with frame Dialog-Frame.
     4237       end.
     4238       if p-mode = 'ДОБАВЛЕНИЕ':U then
     4239       display
     4240       0 @ temp-dc-type.lim-kr
     4241       with frame Dialog-Frame.
     4242       disable
     4243       temp-dc-type.lim-kr
     4244       with frame Dialog-Frame.
     4245       IF p-mode <> 'ПРОСМОТР':U THEN
     4246       ENABLE
     4247       temp-dc-type.dflt-debet-card
     4248       with frame Dialog-Frame.
     4249       IF temp-dc-type.dflt-credit-card:screen-value = "no":U THEN DO:
     4250           DISABLE
     4251           temp-dc-type.fiscal-pay
     4252           with frame Dialog-Frame.
     4253       END.
     4254     end.
     4255     IF (temp-dc-type.dflt-credit-card:screen-value = "yes":U
     4256     OR    temp-dc-type.dflt-debet-card:screen-value = "yes":U)
     4257     THEN DO:
     4258         IF p-mode <> 'ПРОСМОТР':U THEN
     4259         ENABLE
     4260         temp-dc-type.fiscal-pay
     4261         temp-dc-type.mixed-pay
     4262         b-cashpay
     4263         WITH FRAME Dialog-Frame.
     4264     END.
     4265     ELSE DO:
     4266        DISABLE
     4267         temp-dc-type.fiscal-pay
     4268         temp-dc-type.mixed-pay
     4269         b-cashpay
     4270         WITH FRAME Dialog-Frame.
     4271         ASSIGN
     4272         f-cash-pay-name = "":U
     4273         temp-dc-type.pay-code = 0    .
     4274         DISPLAY
     4275         f-cash-pay-name
     4276         with frame Dialog-Frame .
     4277     END.
     4278   END PROCEDURE.
     4279   PROCEDURE disable_UI :
     4280     HIDE FRAME Dialog-Frame.
     4281   END PROCEDURE.
     4282   PROCEDURE display-r-b-abbr :
     4283   DEFINE OUTPUT PARAMETER p-r-b-curr-code LIKE ub.currency.curr-code NO-UNDO.
     4284   define var varemitent-host-code like ub.dis-card-type.emitent-host-code no-undo.
     4285   DEFINE BUFFER buf_sysconf FOR ub.sysconf.
     4286   varemitent-host-code = integer(temp-dc-type.emitent-host-code:screen-value in frame Dialog-Frame).
     4287   if varemitent-host-code = 0
     4288   and v-curr-r-b = 'base':U
     4289   then do:
     4290     ASSIGN
     4291     p-r-b-curr-code = 0
     4292     var-r-b-abbr = ?.
     4293   end.
     4294   else do:
     4295   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4296   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-abbr in g#library
     4297     (input  varemitent-host-code
     4298     ,output var-r-b-abbr
     4299     ) no-error .
     4300       IF varemitent-host-code = 0 or
     4301        v-curr-r-b = 'rubl':U
     4302        THEN DO:
     4303           ASSIGN
     4304           p-r-b-curr-code = 0
     4305           .
     4306       END.
     4307       ELSE DO:
     4308          FIND FIRST buf_sysconf NO-LOCK WHERE
     4309                    buf_sysconf.host-code = varemitent-host-code .
     4310          ASSIGN
     4311          p-r-b-curr-code = buf_sysconf.base-code
     4312           .
     4313     END.
     4314   end.
     4315   display
     4316   var-r-b-abbr
     4317   with frame Dialog-Frame.
     4318   END PROCEDURE.
     4319   PROCEDURE dpcnt-byshop-enable-disable :
     4320   define buffer buf_tt0-dis-dct-rule for tt0-dis-dct-rule.
     4321   define variable v-found as logical no-undo .
     4322   disable
     4323   temp-dc-type.d-pcnt-byshop
     4324   with frame Dialog-Frame .
     4325   for each buf_tt0-dis-dct-rule no-lock :
     4326     if not (buf_tt0-dis-dct-rule.discnt-role = 'def-pcnt':U
     4327             or
     4328             buf_tt0-dis-dct-rule.discnt-role = 'def-cash-pcnt':U
     4329             or
     4330             buf_tt0-dis-dct-rule.discnt-role = 'def-categ':U) then next.
     4331     if buf_tt0-dis-dct-rule.host-code = 0
     4332     and buf_tt0-dis-dct-rule.obj-type = '':U
     4333     and buf_tt0-dis-dct-rule.obj-code = 0 then next.
     4334     v-found = yes.
     4335   end.
     4336   if not v-found
     4337   and p-mode <> 'ПРОСМОТР':U then do:
     4338     enable
     4339     temp-dc-type.d-pcnt-byshop
     4340     with frame Dialog-Frame .
     4341   end.
     4342   END PROCEDURE.
     4343   PROCEDURE enable_UI :
     4344     OPEN QUERY Dialog-Frame FOR EACH temp-dc-type SHARE-LOCK.
     4345     GET FIRST Dialog-Frame.
     4346     DISPLAY T-check-by-mask T-ho-join f-dflt-pcnt f-dflt-cash-pcnt f-dflt-pcnt-kat
     4347             v-dflt-d-pcnt-method Rs-algo-profile rs-algo-types E-rule-name
     4348             f-cash-pay-name emitent-name var-r-b-abbr
     4349         WITH FRAME Dialog-Frame.
     4350     IF AVAILABLE temp-dc-type THEN
     4351       DISPLAY temp-dc-type.type temp-dc-type.emitent-host-code
     4352             temp-dc-type.d-pcnt-byshop temp-dc-type.dflt-credit-card
     4353             temp-dc-type.dflt-debet-card temp-dc-type.dflt-staff-card
     4354             temp-dc-type.card-media temp-dc-type.lim-kr temp-dc-type.fiscal-pay
     4355             temp-dc-type.mixed-pay temp-dc-type.dcbyshop
     4356         WITH FRAME Dialog-Frame.
     4357     ENABLE RECT-1 RECT-3 RECT-4 B-exit b-quit B-mask b-hn b-cd b-prop-ref b-disc
     4358            B-history B-Help temp-dc-type.type T-check-by-mask T-ho-join
     4359            temp-dc-type.emitent-host-code B-emitent f-dflt-pcnt
     4360            temp-dc-type.d-pcnt-byshop B-def-pcnt b-d-pcnt-byshop f-dflt-cash-pcnt
     4361            f-dflt-pcnt-kat B-def-cash-pcnt B-def-categ v-dflt-d-pcnt-method
     4362            b-addalgo b-delalgo b-params B-rule B-ruleset b-rule-on-off
     4363            Rs-algo-profile rs-algo-types br-rule-by-call br-profile E-rule-name
     4364            temp-dc-type.dflt-credit-card temp-dc-type.dflt-debet-card
     4365            temp-dc-type.dflt-staff-card temp-dc-type.card-media
     4366            temp-dc-type.lim-kr temp-dc-type.fiscal-pay temp-dc-type.mixed-pay
     4367            B-cashpay B-dcbyshop emitent-name var-r-b-abbr temp-dc-type.dcbyshop
     4368         WITH FRAME Dialog-Frame.
     4369     VIEW FRAME Dialog-Frame.
     4370     OPEN QUERY br-profile FOR EACH tt0-rp-by-call WHERE          tt0-rp-by-call.call_id = temp-dc-type.uniq-key-rec NO-LOCK INDEXED-REPOSITION.    OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = temp-dc-type.uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   AND (rs-algo-types = 1 or X_rule-profile.is_dynamic = yes)  BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     4371   END PROCEDURE.
     4372   PROCEDURE fill-tt0-dis-card-type :
     4373   define input parameter p-dis-card-type-bh as handle no-undo.
     4374   p-dis-card-type-bh:buffer-create().
     4375   p-dis-card-type-bh:buffer-copy(buffer temp-dc-type:handle).
     4376   p-dis-card-type-bh:buffer-release().
     4377   END PROCEDURE.
     4378   PROCEDURE fill-tt0-dis-dct-rule :
     4379   define input parameter p-dis-dct-rule-bh as handle no-undo.
     4380   define buffer buf_tt0-dis-dct-rule for tt0-dis-dct-rule.
     4381   for each buf_tt0-dis-dct-rule:
     4382     p-dis-dct-rule-bh:buffer-create().
     4383     p-dis-dct-rule-bh:buffer-copy(buffer buf_tt0-dis-dct-rule:handle).
     4384     p-dis-dct-rule-bh:buffer-release().
     4385   end.
     4386   END PROCEDURE.
     4387   PROCEDURE local-notes :
     4388   define variable v-updated as logical no-undo .
     4389   define buffer buf_tt0-rp-by-call for tt0-rp-by-call.
     4390   do on stop undo, return no-apply:
     4391     find buf_tt0-rp-by-call where recid (buf_tt0-rp-by-call) = recid(tt0-rp-by-call) exclusive no-error no-wait.
     4392     if not available buf_tt0-rp-by-call then do:
     4393     end.
     4394     else do:
     4395       assign
     4396       buf_tt0-rp-by-call.PS = input frame Dialog-Frame e-rule-name
     4397       v-updated = yes
     4398       .
     4399     end.
     4400     if not v-updated then do:
     4401       e-rule-name:edit-undo().
     4402     end.
     4403   end.
     4404   END PROCEDURE.
     4405   PROCEDURE MyEnable :
     4406   DEFINE VARIABLE v-check-by-mask AS CHARACTER NO-UNDO.
     4407   DEFINE VARIABLE v-type AS CHARACTER NO-UNDO.
     4408   DEFINE VARIABLE v-tooltip AS CHARACTER NO-UNDO.
     4409   DEFINE VARIABLE clh AS WIDGET-HANDLE NO-UNDO.
     4410   DEFINE VARIABLE ii AS integer NO-UNDO.
     4411   define buffer b_clients for ub.clients.
     4412   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
     4413   OPEN QUERY Dialog-Frame FOR EACH temp-dc-type SHARE-LOCK.
     4414     GET FIRST Dialog-Frame.
     4415   ASSIGN
     4416   v-mode[1] = p-mode
     4417   v-mode[2] = p-mode
     4418   v-mode[3] = p-mode
     4419   v-mode[1] = (IF temp-dc-type.dflt-d-pcnt-method = integer('2':U)
     4420                           THEN 'ПРОСМОТР':U
     4421                           ELSE p-mode)
     4422   v-mode[2] = (IF temp-dc-type.dflt-d-pcnt-method = integer('1':U)
     4423                           THEN 'ПРОСМОТР':U
     4424                           ELSE p-mode)
     4425   .
     4426   ASSIGN
     4427   rs-algo-profile:RADIO-BUTTONS IN FRAME Dialog-Frame = "Алгоритмы" + chr(44) +
     4428                                    'rp-by-call':U + chr(44) +
     4429                                   "Правила" + chr(44) + 'rule-by-call':U.
     4430   rs-algo-profile = 'rp-by-call':U.
     4431   ASSIGN
     4432   tt0-rule-by-call.algo-des:RESIZABLE IN BROWSE br-rule-by-call = YES .
     4433   DO ii = 1 TO br-profile:NUM-COLUMNS IN FRAME Dialog-Frame:
     4434       clh = BROWSE br-profile:get-browse-column(ii).
     4435       IF clh:LABEL BEGINS "Название" THEN DO:
     4436         ASSIGN
     4437         clh:RESIZABLE = YES
     4438         clh:width = 72
     4439         .
     4440       END.
     4441   END.
     4442     assign
     4443      v-dflt-d-pcnt-method:Radio-buttons in frame Dialog-Frame =
     4444        "Товар" + chr(44) + string('1':U) + chr(44) +
     4445        "Итог_чека" + chr(44) + string('2':U) + chr(44) +
     4446        "Товары_и_итог_чека" + chr(44) + string('3':U)
     4447       b-rule:MENU-MOUSE in frame Dialog-Frame = 1
     4448       temp-dc-type.card-media:RADIO-BUTTONS = mixlist('Карта c магн.полосой,ТМ ключ,Смарт карта,Радио карта,Карта со штрихкодом,EASY FUEL,EasyFuel2':U, '0,1,2,3,4,5,6':U, chr(44), chr(44))
     4449       .
     4450     if p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ПРОСМОТР':U then do:
     4451       if temp-dc-type.emitent-host-code > 0 then do:
     4452           find first b_clients No-LOCK WHERE
     4453                       b_clients.obj-type = 'орг':U and
     4454                       b_clients.obj-code = temp-dc-type.emitent-host-code No-ERROR.
     4455           if avail b_clients then
     4456           emitent-name = b_clients.obj-name.
     4457       end.
     4458       else do:
     4459           emitent-name = "Глобальная".
     4460       end.
     4461     end.
     4462     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     4463       display
     4464       0 @ temp-dc-type.emitent-host-code
     4465       0 @ f-dflt-pcnt
     4466       0 @ f-dflt-cash-pcnt
     4467       0 @ temp-dc-type.lim-kr
     4468       WITH FRAME Dialog-Frame.
     4469     end.
     4470     assign
     4471      v-dflt-d-pcnt-method = (if p-mode = 'ДОБАВЛЕНИЕ':U
     4472                               then string('1':U)
     4473                               else string(temp-dc-type.dflt-d-pcnt-method)
     4474                               ).
     4475   assign
     4476   T-check-by-mask  = (if temp-dc-type.check-by-mask = 1 then yes else no)
     4477   T-ho-join        = (if temp-dc-type.ho-join = 1 then yes else no)
     4478   T-check-by-mask:tooltip = v-tooltip
     4479   no-error .
     4480   DISPLAY
     4481   emitent-name
     4482   var-r-b-abbr
     4483   rs-algo-types
     4484   rs-algo-profile
     4485   WITH FRAME Dialog-Frame.
     4486   IF AVAILABLE temp-dc-type THEN DO:
     4487     DISPLAY
     4488     temp-dc-type.type
     4489     temp-dc-type.emitent-host-code
     4490     f-dflt-pcnt
     4491     f-dflt-pcnt-kat
     4492     f-dflt-cash-pcnt
     4493     temp-dc-type.dflt-credit-card
     4494     temp-dc-type.dflt-debet-card
     4495     temp-dc-type.dflt-staff-card
     4496     temp-dc-type.fiscal-pay
     4497     temp-dc-type.mixed-pay
     4498     temp-dc-type.card-media
     4499     temp-dc-type.lim-kr
     4500     temp-dc-type.dcbyshop
     4501     temp-dc-type.d-pcnt-byshop
     4502     v-dflt-d-pcnt-method
     4503     T-check-by-mask
     4504     t-ho-join
     4505     WITH FRAME Dialog-Frame.
     4506   END.
     4507   ENABLE
     4508   B-exit when p-mode <> 'ПРОСМОТР':U
     4509   b-quit
     4510   b-mask WHEN p-mode <> 'ДОБАВЛЕНИЕ':U
     4511   b-history WHEN p-mode <> 'ДОБАВЛЕНИЕ':U
     4512   b-cd WHEN p-mode <> 'ДОБАВЛЕНИЕ':U
     4513   b-hn
     4514   B-Help
     4515   rs-algo-profile
     4516   b-rule
     4517   b-ruleset
     4518   b-addalgo when p-mode <> 'ПРОСМОТР':U
     4519   b-delalgo when p-mode <> 'ПРОСМОТР':U
     4520   b-rule-on-off when p-mode <> 'ПРОСМОТР':U
     4521   b-cd when p-mode <> 'ПРОСМОТР':U
     4522   b-params
     4523   temp-dc-type.type when p-mode = 'ДОБАВЛЕНИЕ':U
     4524   temp-dc-type.emitent-host-code when p-mode = 'ДОБАВЛЕНИЕ':U
     4525   B-emitent when p-mode = 'ДОБАВЛЕНИЕ':U
     4526   b-def-pcnt when p-mode <> 'ПРОСМОТР':U
     4527   b-def-cash-pcnt when p-mode <> 'ПРОСМОТР':U
     4528   b-def-categ when p-mode <> 'ПРОСМОТР':U
     4529   temp-dc-type.dflt-credit-card when p-mode <> 'ПРОСМОТР':U
     4530   temp-dc-type.dflt-staff-card when p-mode <> 'ПРОСМОТР':U
     4531   temp-dc-type.lim-kr when p-mode <> 'ПРОСМОТР':U
     4532   temp-dc-type.dcbyshop when p-mode <> 'ПРОСМОТР':U
     4533   B-dcbyshop when p-mode <> 'ПРОСМОТР':U
     4534   temp-dc-type.d-pcnt-byshop when p-mode <> 'ПРОСМОТР':U AND (p-mode = 'ДОБАВЛЕНИЕ':U or not temp-dc-type.d-pcnt-byshop)
     4535   v-dflt-d-pcnt-method when p-mode <> 'ПРОСМОТР':U
     4536   temp-dc-type.card-media WHEN p-mode  <> 'ПРОСМОТР':U
     4537   t-check-by-mask WHEN p-mode  <> 'ПРОСМОТР':U
     4538   t-ho-join WHEN (p-mode  <> 'ПРОСМОТР':U and t-check-by-mask)
     4539   br-rule-by-call
     4540   br-profile
     4541   b-prop-ref WHEN p-mode  <> 'ДОБАВЛЕНИЕ':U
     4542   rs-algo-types
     4543   b-disc WHEN p-mode <> 'ДОБАВЛЕНИЕ':U
     4544   b-d-pcnt-byshop
     4545   e-rule-name
     4546   WITH FRAME Dialog-Frame.
     4547   if p-mode = 'ПРОСМОТР':U then do:
     4548       HIDE
     4549       b-exit in frame Dialog-Frame.
     4550       assign
     4551       b-quit:label in frame Dialog-Frame = "&Выход"
     4552       b-quit:column in frame Dialog-Frame = 1
     4553       e-rule-name:read-only in frame Dialog-Frame = yes
     4554       .
     4555   end.
     4556   VIEW FRAME Dialog-Frame.
     4557   RUN BUTTONS IN THIS-PROCEDURE NO-ERROR.
     4558   run display-r-b-abbr in this-procedure ( output v-r-b-code) no-error.
     4559   IF temp-dc-type.pay-code <> 0 THEN DO:
     4560   FIND FIRST buf_cash-pay NO-LOCK WHERE
     4561             buf_cash-pay.cdpay-code = temp-dc-type.pay-code
     4562          AND buf_cash-pay.curr-code = v-r-b-code NO-ERROR.
     4563     IF NOT AVAILABLE buf_cash-pay THEN DO:
     4564         ASSIGN
     4565        f-cash-pay-name = "":U.
     4566     END.
     4567     ELSE DO:
     4568         f-cash-pay-name = buf_cash-pay.obj-name.
     4569     END.
     4570     DISPLAY
     4571     f-cash-pay-name
     4572     WITH FRAME Dialog-Frame.
     4573   END.
     4574   OPEN QUERY br-profile FOR EACH tt0-rp-by-call WHERE          tt0-rp-by-call.call_id = temp-dc-type.uniq-key-rec NO-LOCK INDEXED-REPOSITION.    OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = temp-dc-type.uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   AND (rs-algo-types = 1 or X_rule-profile.is_dynamic = yes)  BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     4575   APPLY "VALUE-CHANGED" TO rs-algo-profile.
     4576   APPLY "VALUE-CHANGED" TO T-check-by-mask.
     4577   END PROCEDURE.
     4578   PROCEDURE proc-b-addalgo :
     4579   DEFINE PARAMETER BUFFER buf_rule-profile FOR ub.rule-profile.
     4580   run dc-typei_proc-b-addalgo in this-procedure (
     4581                                                    input no
     4582                                                   ,input v-start
     4583                                                   ,buffer buf_rule-profile) no-error .
     4584       if error-status:error then do:
     4585         message
     4586     return-value
     4587     view-as alert-box .
     4588     return.
     4589   end.
     4590   OPEN QUERY br-profile FOR EACH tt0-rp-by-call WHERE          tt0-rp-by-call.call_id = temp-dc-type.uniq-key-rec NO-LOCK INDEXED-REPOSITION.
     4591   APPLY "VALUE-CHANGED" to br-profile IN FRAME Dialog-Frame.
     4592   OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = temp-dc-type.uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   AND (rs-algo-types = 1 or X_rule-profile.is_dynamic = yes)  BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     4593   APPLY "value-changed" TO br-rule-by-call IN FRAME Dialog-Frame.
     4594   END PROCEDURE.
     4595   PROCEDURE proc-b-cd :
     4596   DEFINE VARIABLE v-ok AS LOGICAL NO-UNDO.
     4597   DEFINE VARIABLE v-cardname-sent AS character NO-UNDO.
     4598   DEFINE VARIABLE v-custom-sent AS character NO-UNDO.
     4599   ASSIGN
     4600   v-cardname-sent = temp-dc-type.cardname-sent
     4601   v-custom-sent = temp-dc-type.custom-sent
     4602   .
     4603   run ref/dctypecd.w ( INPUT parparentproc
     4604                       ,INPUT p-mode
     4605                       ,input temp-dc-type.emitent-host-code
     4606                       ,input temp-dc-type.type
     4607                       ,INPUT-OUTPUT v-cardname-sent
     4608                       ,INPUT-OUTPUT v-custom-sent
     4609                       ,OUTPUT v-ok) NO-ERROR.
     4610   IF NOT ERROR-STATUS:ERROR
     4611   AND v-ok THEN DO:
     4612      ASSIGN
     4613      temp-dc-type.cardname-sent = v-cardname-sent
     4614      temp-dc-type.custom-sent = v-custom-sent
     4615      .
     4616   END.
     4617   END PROCEDURE.
     4618   PROCEDURE proc-b-delalgo :
     4619   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     4620   DEFINE VARIABLE v-rule-nums AS INTEGER NO-UNDO.
     4621   DEFINE VARIABLE v-profile-id AS INTEGER NO-UNDO.
     4622   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
     4623   DEFINE BUFFER buf_tt0-rule-by-call FOR tt0-rule-by-call.
     4624   DEFINE BUFFER buf_rule-by-profile FOR ub.rule-by-profile.
     4625   DEFINE BUFFER buf_tt0-rp-by-call FOR tt0-rp-by-call.
     4626   define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     4627   IF NOT AVAILABLE tt0-rp-by-call THEN RETURN ERROR.
     4628   FIND FIRST buf_rule-profile NO-LOCK WHERE
     4629             buf_rule-profile.profile_id = tt0-rp-by-call.profile_id NO-ERROR.
     4630   IF NOT AVAILABLE buf_rule-profile THEN DO:
     4631      MESSAGE
     4632      substitute("Не найден алгоритм с кодом &1", tt0-rp-by-call.profile_id)
     4633      VIEW-AS ALERT-BOX ERROR.
     4634      RETURN ERROR.
     4635   END.
     4636   IF buf_rule-profile.IS_dynamic = NO THEN DO:
     4637      MESSAGE
     4638      "Привязку к данному алгоритму НЕЛЬЗЯ удалить!"
     4639      VIEW-AS ALERT-BOX ERROR.
     4640      RETURN ERROR.
     4641   END.
     4642   MESSAGE
     4643   "Вы уверены, что хотите удалить привязку к данному алгоритму?"
     4644   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     4645   IF NOT glog THEN RETURN ERROR.
     4646   FIND FIRST buf_rule-profile EXCLUSIVE-LOCK WHERE buf_rule-profile.profile_id = tt0-rp-by-call.profile_id.
     4647   FOR EACH buf_tt0-rule-by-call where
     4648         buf_tt0-rule-by-call.profile_id = tt0-rp-by-call.profile_id
     4649     and buf_tt0-rule-by-call.once-more = tt0-rp-by-call.once-more
     4650   ON error UNDO, RETURN ERROR:
     4651     for each buf_tt0-rule-call-param where
     4652             buf_tt0-rule-call-param.codex_id = buf_tt0-rule-by-call.codex_id
     4653       and buf_tt0-rule-call-param.ruleset_id = buf_tt0-rule-by-call.ruleset_id
     4654       and buf_tt0-rule-call-param.call_id  = buf_tt0-rule-by-call.call_id
     4655       and buf_tt0-rule-call-param.order_id = buf_tt0-rule-by-call.order_id
     4656       ON error UNDO, RETURN ERROR:
     4657       delete buf_tt0-rule-call-param.
     4658     end.
     4659     DELETE buf_tt0-rule-by-call.
     4660   END.
     4661   DELETE tt0-rp-by-call.
     4662   OPEN QUERY br-profile FOR EACH tt0-rp-by-call WHERE          tt0-rp-by-call.call_id = temp-dc-type.uniq-key-rec NO-LOCK INDEXED-REPOSITION.
     4663   APPLY "VALUE-CHANGED" to br-profile IN FRAME Dialog-Frame.
     4664   OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = temp-dc-type.uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   AND (rs-algo-types = 1 or X_rule-profile.is_dynamic = yes)  BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     4665   APPLY "value-changed" TO br-rule-by-call  IN FRAME Dialog-Frame.
     4666   END PROCEDURE.
     4667   PROCEDURE proc-b-dis-dct-rule :
     4668   DEFINE INPUT PARAMETER p-discnt-role AS CHARACTER NO-UNDO.
     4669   define input parameter p-mode as character no-undo .
     4670   DEFINE BUFFER buf_dis-dct-rule FOR ub.dis-dct-rule.
     4671   DEFINE BUFFER buf_dis-rule FOR ub.dis-rule.
     4672   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     4673   DEFINE VARIABLE v-sts AS integer NO-UNDO.
     4674   define variable glog as logical no-undo .
     4675   DEFINE BUFFER buf_tt0-dis-dct-rule FOR tt0-dis-dct-rule.
     4676   FIND FIRST buf_tt0-dis-dct-rule NO-LOCK WHERE
     4677             buf_tt0-dis-dct-rule.emitent-host-code = temp-dc-type.emitent-host-code
     4678         AND buf_tt0-dis-dct-rule.type = temp-dc-type.TYPE
     4679         AND buf_tt0-dis-dct-rule.host-code = 0
     4680         AND buf_tt0-dis-dct-rule.obj-type = '':U
     4681         AND buf_tt0-dis-dct-rule.obj-code = 0
     4682       AND buf_tt0-dis-dct-rule.pos-type = 'bo':U
     4683       AND buf_tt0-dis-dct-rule.discnt-role = p-discnt-role NO-ERROR.
     4684   IF AVAILABLE buf_tt0-dis-dct-rule  THEN DO:
     4685     FIND FIRST buf_dis-rule NO-LOCK WHERE
     4686               buf_Dis-rule.rule-num = buf_tt0-dis-dct-rule.rule-num NO-ERROR.
     4687     IF AVAILABLE buf_dis-rule THEN DO:
     4688       v-rid-list = STRING(recid(buf_Dis-rule)).
     4689     END.
     4690   END.
     4691   if p-mode <> 'ПРОСМОТР':U then do:
     4692     run ref/dis-ruls.w ( input  parparentproc
     4693                         ,input 0
     4694                         ,input '':U
     4695                         ,input 0
     4696                         ,input "b-sel,b-add"
     4697                         ,input 'dis-dct-rule':U + "=" + p-discnt-role
     4698                         ,input 0
     4699                         ,input ?
     4700                         ,input 0
     4701                         ,input-output v-sts
     4702                         ,input-OUTPUT v-rid-list) NO-ERROR.
     4703     if NOT ERROR-STATUS:ERROR
     4704     AND v-rid-list <> '':U then do:
     4705         find first buf_dis-rule no-lock where
     4706                   recid(buf_dis-rule) = integer(v-rid-list) no-error.
     4707         if not available buf_dis-rule then do:
     4708             message
     4709             substitute("Не найдено правило скидки c recid &1", v-rid-list)
     4710             VIEW-AS ALERT-BOX ERROR.
     4711             UNDO, RETURN ERROR.
     4712         END.
     4713         IF NOT AVAILABLE buf_tt0-dis-dct-rule THEN DO:
     4714           CREATE buf_tt0-dis-dct-rule.
     4715           assign
     4716           buf_tt0-dis-dct-rule.emitent-host-code = temp-dc-type.emitent-host-code
     4717           buf_tt0-dis-dct-rule.type = temp-dc-type.type
     4718           buf_tt0-dis-dct-rule.host-code = buf_dis-rule.host-code
     4719           buf_tt0-dis-dct-rule.obj-type = '':U
     4720           buf_tt0-dis-dct-rule.obj-code = 0
     4721           buf_tt0-dis-dct-rule.pos-type = 'bo':U
     4722           buf_tt0-dis-dct-rule.discnt-role = p-discnt-role
     4723           buf_tt0-dis-dct-rule.templ-rl-root = buf_dis-rule.templ-rl-root
     4724           buf_tt0-dis-dct-rule.time-templ-rl-root = buf_dis-rule.time-templ-rl-root
     4725           buf_tt0-dis-dct-rule.rule-num = buf_dis-rule.rule-num
     4726           buf_tt0-dis-dct-rule.rl-root = buf_dis-rule.rl-root
     4727           .
     4728       END.
     4729       ASSIGN
     4730       buf_tt0-dis-dct-rule.templ-rl-root = buf_dis-rule.templ-rl-root
     4731       buf_tt0-dis-dct-rule.time-templ-rl-root = buf_dis-rule.time-templ-rl-root
     4732       buf_tt0-dis-dct-rule.rule-num = buf_dis-rule.rule-num
     4733       buf_tt0-dis-dct-rule.rl-root = buf_dis-rule.rl-root
     4734       .
     4735     end.
     4736   end.
     4737   CASE p-discnt-role:
     4738     WHEN 'def-categ':U THEN DO:
     4739       DISPLAY
     4740       (if available buf_Dis-rule
     4741       then buf_dis-rule.dis-kat
     4742       else 0)
     4743       @ f-dflt-pcnt-kat
     4744       WITH FRAME Dialog-Frame.
     4745     END.
     4746     WHEN 'def-pcnt':U THEN DO:
     4747       DISPLAY
     4748       (if available buf_Dis-rule
     4749       then buf_dis-rule.discnt-value
     4750       else 0.0)
     4751       @ f-dflt-pcnt
     4752       WITH FRAME Dialog-Frame.
     4753     END.
     4754     WHEN 'def-cash-pcnt':U THEN DO:
     4755       DISPLAY
     4756       (if available buf_Dis-rule
     4757       then buf_dis-rule.discnt-value
     4758       else 0.0)
     4759       @ f-dflt-cash-pcnt
     4760       WITH FRAME Dialog-Frame.
     4761     END.
     4762   END CASE.
     4763   END PROCEDURE.
     4764   PROCEDURE proc-b-emitent :
     4765   define variable ref-list as char no-undo.
     4766   define variable v-host-code like ub.sysconf.host-code no-undo .
     4767   define buffer h-cli for ub.clients.
     4768   run adm/sconfs.w (
     4769                   INPUT parparentproc
     4770                   ,INPUT "b-sel":U
     4771                   ,input no
     4772                   ,input 0
     4773                   ,output v-host-code
     4774                   ,input-output ref-list
     4775                   ).
     4776   if v-host-code = 0
     4777   or v-host-code = ?
     4778   then do:
     4779     return error.
     4780   end.
     4781   find h-cli no-lock where
     4782         h-cli.obj-type = 'орг':U
     4783     AND h-cli.obj-code = v-host-code  .
     4784         .
     4785   if not can-find (ub.sysconf where ub.sysconf.host-code = v-host-code no-lock) then do:
     4786     message "Выбранная организация не является одной из фирм БД."
     4787             view-as alert-box error.
     4788     return error.
     4789   end.
     4790   old-emitent-host-code  = integer(temp-dc-type.emitent-host-code:screen-value in frame Dialog-Frame).
     4791     display
     4792   h-cli.obj-code @ temp-dc-type.emitent-host-code
     4793   with frame Dialog-Frame.
     4794   RUN proc-refresh-tt IN THIS-PROCEDURE NO-ERROR.
     4795   OPEN QUERY br-profile FOR EACH tt0-rp-by-call WHERE          tt0-rp-by-call.call_id = temp-dc-type.uniq-key-rec NO-LOCK INDEXED-REPOSITION.
     4796   APPLY "VALUE-CHANGED" to br-profile.
     4797   OPEN QUERY br-rule-by-call FOR EACH tt0-rule-by-call WHERE     tt0-rule-by-call.call_id = temp-dc-type.uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE         X_rule-profile.profile_id = tt0-rule-by-call.profile_id   AND (rs-algo-types = 1 or X_rule-profile.is_dynamic = yes)  BY tt0-rule-by-call.codex_id  BY tt0-rule-by-call.ruleset_id  BY tt0-rule-by-call.order_id  INDEXED-REPOSITION.
     4798   APPLY "VALUE-CHANGED" to br-rule-by-call.
     4799   END PROCEDURE.
     4800   PROCEDURE proc-dcbyshop :
     4801   define variable var-sel-value as char no-undo.
     4802   define variable var-input-value as char no-undo.
     4803   define variable var-output-value as char no-undo.
     4804   define variable var-labels as char no-undo.
     4805   define variable jj as integer no-undo.
     4806   do jj = 1 to num-entries(temp-dc-type.dcbyshop:screen-value in frame Dialog-Frame):
     4807   find first ub.clients No-LOCK WHERE
     4808               ub.clients.obj-type = 'маг':U and
     4809               ub.clients.obj-code = integer(entry(jj, temp-dc-type.dcbyshop:screen-value)) no-error.
     4810   if avail ub.clients then do:
     4811     assign
     4812     var-sel-value = var-sel-value + (if var-sel-value = "":U then "":U else chr(44)) + entry(jj, temp-dc-type.dcbyshop:screen-value)
     4813     .
     4814   end.
     4815   end.
     4816   for each ub.clients NO-LOCK WHERE
     4817               ub.clients.obj-type = 'маг':U,
     4818     first ub.shop no-lock where
     4819             ub.shop.obj-code = ub.clients.obj-code AND
     4820             (integer(temp-dc-type.emitent-host-code:screen-value) = 0 OR
     4821               ub.shop.host-code = integer(temp-dc-type.emitent-host-code:screen-value)):
     4822     assign
     4823     var-input-value = var-input-value + (if var-input-value = "":U then "":U else chr(44)) + string(clients.obj-code)
     4824     var-labels = var-labels + (if var-labels = "":U
     4825                                 then "":U
     4826                                 else chr(44)) +
     4827                   string(ub.shop.obj-code, "99999") + chr(32) +
     4828                   replace(ub.clients.obj-name, chr(44), "":U)
     4829     .
     4830   end.
     4831   run gbl/d-list.w (
     4832                      input "b-sel,b-mark":U
     4833                     ,input "Выберите магазины"
     4834                     ,input var-input-value
     4835                     ,input var-labels
     4836                     ,input chr(44)
     4837                     ,input var-sel-value
     4838                     ,output var-output-value) no-error.
     4839   if error-status:error then return error.
     4840   if var-output-value = var-sel-value  then do:
     4841     return error.
     4842   end.
     4843   else do:
     4844     display
     4845     var-output-value @ temp-dc-type.dcbyshop
     4846     with frame Dialog-Frame.
     4847   end.
     4848   END PROCEDURE.
     4849   PROCEDURE proc-display-rule :
     4850   DEFINE INPUT PARAMETER p-display-mode AS CHARACTER NO-UNDO.
     4851   define input parameter p-codex-id as integer no-undo .
     4852   define input parameter p-ruleset-id as integer no-undo .
     4853   define input parameter p-call-id as character no-undo .
     4854   define input parameter p-order-id as integer no-undo .
     4855   DEFINE INPUT PARAMETER p-rule-id AS INTEGER NO-UNDO.
     4856     run rul/disprule.p (
     4857                          input p-DISPLAY-MODE
     4858                         ,input p-rule-id
     4859                         ,input p-codex-id
     4860                         ,input p-ruleset-id
     4861                         ,input p-call-id
     4862                         ,input p-order-id
     4863                          ).
     4864   END PROCEDURE.
     4865   PROCEDURE proc-refresh-tt :
     4866   DEFINE VARIABLE v-old-call-id AS CHARACTER NO-UNDO.
     4867   DEFINE VARIABLE v-new-call-id AS CHARACTER NO-UNDO.
     4868   DEFINE BUFFER buf_tt0-rule-by-call FOR tt0-rule-by-call.
     4869   DEFINE BUFFER buf_tt0-rp-by-call FOR tt0-rp-by-call.
     4870   DEFINE BUFFER buf_tt0-rule-call-param FOR tt0-rule-call-param.
     4871   DEFINE BUFFER buf_tt0-hist-nws-option FOR tt0-hist-nws-option.
     4872   DEFINE BUFFER buf_tt0-dis-dct-rule FOR tt0-dis-dct-rule.
     4873   IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     4874      FOR EACH buf_tt0-dis-dct-rule:
     4875         buf_tt0-dis-dct-rule.emitent-host-code = temp-dc-type.emitent-host-code.
     4876      END.
     4877      run gen-key-rec in this-procedure (
     4878                                        input 'dis-card-type':U
     4879                                        ,input  BUFFER temp-dc-type:handle
     4880                                        ,output temp-dc-type.uniq-key-rec
     4881                                          ).
     4882       FOR EACH buf_tt0-rp-by-call:
     4883          buf_tt0-rp-by-call.CALL_id = temp-dc-type.uniq-key-rec.
     4884       END.
     4885       FOR EACH buf_tt0-rule-by-call:
     4886         v-old-call-id = buf_tt0-rule-by-call.call_id.
     4887         ASSIGN
     4888         buf_tt0-rule-by-call.call_id = temp-dc-type.uniq-key-rec
     4889         .
     4890          FOR EACH buf_tt0-rule-call-param WHERE
     4891                  buf_tt0-rule-call-param.codex_id = buf_tt0-rule-by-call.codex_id
     4892              AND buf_tt0-rule-call-param.ruleset_id = buf_tt0-rule-by-call.ruleset_id
     4893              AND buf_tt0-rule-call-param.call_id = v-old-call-id:
     4894             ASSIGN
     4895             buf_tt0-rule-call-param.CALL_id = buf_tt0-rule-by-call.call_id.
     4896          END.
     4897       END.
     4898   END.
     4899   FOR EACH buf_tt0-hist-nws-option:
     4900      ASSIGN
     4901      buf_tt0-hist-nws-option.charkey_one = temp-dc-type.TYPE
     4902      buf_tt0-hist-nws-option.host-code = temp-dc-type.emitent-host-code
     4903      .
     4904   END.
     4905   END PROCEDURE.
     4906   PROCEDURE proc-save :
     4907   DEFINE VARIABLE v-old-call-id AS CHARACTER NO-UNDO.
     4908   DEFINE VARIABLE v-new-call-id AS CHARACTER NO-UNDO.
     4909   define variable glog as logical no-undo .
     4910   define variable v-ok as logical no-undo .
     4911   define variable v-found-new as logical no-undo .
     4912   define variable v-found-d-pcnt-byshop as logical   no-undo .
     4913   define buffer buf_rp-by-call for ub.rp-by-call.
     4914   define buffer buf_tt0-rp-by-call for tt0-rp-by-call.
     4915   DEFINE BUFFER buf_tt0-dis-dct-rule FOR tt0-dis-dct-rule.
     4916   define buffer buf_rule-profile for ub.rule-profile.
     4917   find first temp-dc-type  no-error.
     4918   ASSIGN FRAME Dialog-Frame
     4919   temp-dc-type.emitent-host-code
     4920   temp-dc-type.type
     4921   temp-dc-type.host-code = 0
     4922   temp-dc-type.obj-type  = "":U
     4923   temp-dc-type.obj-code  = 0
     4924   .
     4925   assign
     4926   temp-dc-type.dflt-credit-card
     4927   temp-dc-type.lim-kr
     4928   temp-dc-type.d-pcnt-byshop
     4929   temp-dc-type.dcbyshop
     4930   temp-dc-type.dc-pfx  = "":U
     4931   v-dflt-d-pcnt-method
     4932   temp-dc-type.dflt-d-pcnt-method = integer(v-dflt-d-pcnt-method)
     4933   temp-dc-type.card-media
     4934   temp-dc-type.dflt-debet-card
     4935   temp-dc-type.fiscal-pay
     4936   temp-dc-type.mixed-pay
     4937   temp-dc-type.dflt-staff-card
     4938   t-check-by-mask
     4939   t-ho-join
     4940   .
     4941   RUN proc-refresh-tt IN this-procedure.
     4942     for each buf_tt0-dis-dct-rule no-lock where
     4943             buf_tt0-dis-dct-rule.emitent-host-code = temp-dc-type.emitent-host-code
     4944         and buf_tt0-dis-dct-rule.type = temp-dc-type.type
     4945         and (buf_tt0-dis-dct-rule.host-code > 0
     4946         or  buf_tt0-dis-dct-rule.obj-code  > 0)
     4947         and buf_tt0-dis-dct-rule.pos-type = 'bo':U:
     4948       if buf_tt0-dis-dct-rule.discnt-role = 'def-pcnt':U
     4949       or buf_tt0-dis-dct-rule.discnt-role = 'def-cash-pcnt':U
     4950       or buf_tt0-dis-dct-rule.discnt-role = 'def-categ':U then do:
     4951       v-found-d-pcnt-byshop = yes.
     4952       if temp-dc-type.d-pcnt-byshop = no then do:
     4953         message
     4954         "Для данного типа ДК НЕ установлен флаг СКИДКА/КАТЕГОРИЯ ПО ФИРМАМ/ОБЪЕКТАМ" skip
     4955         "но ЗАДАНЫ скидки по умолчанию для объектов" skip
     4956         "Данные скидки НЕ будут сохранены" skip
     4957         "Продолжать?"
     4958         view-as alert-box question buttons yes-no update glog.
     4959         if not glog then do:
     4960           undo, return error.
     4961         end.
     4962         else do:
     4963           leave.
     4964         end.
     4965       end.
     4966     end.
     4967   end.
     4968   if v-found-d-pcnt-byshop = no and
     4969   temp-dc-type.d-pcnt-byshop = yes then do:
     4970     message
     4971     "Для данного типа ДК УСТАНОВЛЕН флаг СКИДКА/КАТЕГОРИЯ ПО ФИРМАМ/ОБЪЕКТАМ," skip
     4972     "но НЕ заданы скидки по умолчанию для объектов" skip
     4973     "Продолжать?"
     4974     view-as alert-box question buttons yes-no update glog.
     4975     if not glog then do:
     4976       undo, return error.
     4977     end.
     4978   end.
     4979   if p-mode = 'ИЗМЕНЕНИЕ':U
     4980   and dis-card-type.d-pcnt-byshop <> temp-dc-type.d-pcnt-byshop then do:
     4981    message
     4982    "ВНИМАНИЕ! Вы изменили флаг СКИДКА/КАТЕГОРИЯ ПО ФИРМАМ/ОБЪЕКТАМ!" skip
     4983    "Для того, чтобы на кассах были корректные данные по скидкам по ДК (соответствующие текущему значению флага"
     4984    "рекомендуется послать ДК данного типу на кассу ВО ВСЕХ МАГАЗИНАХ СЕТИ!"
     4985    "Продолжить?"
     4986    view-as alert-box QUESTION buttons yes-no  update glog.
     4987    if not glog then do:
     4988      undo, return error.
     4989     end.
     4990   end.
     4991   for each buf_rp-by-call where
     4992             buf_rp-by-call.call_id = temp-dc-type.uniq-key-rec,
     4993       first buf_rule-profile no-lock where
     4994             buf_rule-profile.profile_id = buf_rp-by-call.profile_id
     4995         and buf_rule-profile.is_Dynamic = yes
     4996     on ERROR UNDO, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     4997     ON STOP undo, return error '':u:
     4998     find first buf_tt0-rp-by-call where
     4999               buf_tt0-rp-by-call.call_id = buf_rp-by-call.call_id
     5000           and buf_tt0-rp-by-call.profile_id =  buf_rp-by-call.profile_id
     5001           and buf_tt0-rp-by-call.once-more =  buf_rp-by-call.once-more no-error.
     5002     if not available buf_tt0-rp-by-call then do:
     5003        message
     5004        "ВНИМАНИЕ!!!" skip(0)
     5005        "Вы собираетесь удалить профайл(ы), привязанные к данному типу ДК" skip(0)
     5006        "ПРЕДУПРЕЖДЕНИЕ!!!" skip(0)
     5007        "1. Изменения в работе системы лояльности по данному типу ДК" skip(0)
     5008        "на УБД будут вступать в силу ПОСТЕПЕНЕННО - после получения пакета с данными изменениями по СПН" skip(0)
     5009        "Это может привести к РАССИНХРОНИЗАЦИИ данных по ДК данного типа - например, к несоответствию данных по объекту и фирме и т.д." skip(0)
     5010        "2. Даже если Вы передумаете и вновь добавите удаленные профайл(ы)," skip(0)
     5011        "данные по продажам(накладным), закрытым в этот период будут отсутствовать" skip(0)
     5012        "ПРОДОЛЖИТЬ СОХРАНЕНИЕ              ?"
     5013        view-as alert-box WARNING buttons yes-no update v-ok.
     5014        if not v-ok then do:
     5015          undo, return .
     5016        end.
     5017     end.
     5018   end.
     5019   for each tt0-rp-by-call where
     5020             tt0-rp-by-call.call_id = temp-dc-type.uniq-key-rec,
     5021       first buf_rule-profile no-lock where
     5022             buf_rule-profile.profile_id = tt0-rp-by-call.profile_id
     5023         and buf_rule-profile.is_Dynamic = yes
     5024     on ERROR UNDO, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     5025     ON STOP undo, return error '':u:
     5026     find first buf_rp-by-call where
     5027               buf_rp-by-call.call_id = buf_tt0-rp-by-call.call_id
     5028           and buf_rp-by-call.profile_id =  buf_tt0-rp-by-call.profile_id
     5029           and buf_rp-by-call.once-more =  buf_tt0-rp-by-call.once-more no-error.
     5030     if not available buf_rp-by-call then do:
     5031        v-found-new = yes.
     5032        message
     5033        "ВНИМАНИЕ!!!" skip(0)
     5034        "Вы собираетесь добавить профайл(ы) к данному типу ДК" skip(0)
     5035        "ПРЕДУПРЕЖДЕНИЕ!!!" skip(0)
     5036        "1. Изменения в работе системы лояльности по данному типу ДК" skip(0)
     5037        "на УБД будут вступать в силу ПОСТЕПЕНЕННО - после получения пакета с данными изменениями по СПН" skip(0)
     5038        "Это может привести к неполноте данных по некоторым объектам и т.д." skip(0)
     5039        "2. Для некоторых профайлов предусмотрено включение/выключение правил профайла в соответствии с их бизнес-логикой," skip(0)
     5040        "несвоевременное включение/выключение любого из этих правил МОЖЕТ ПРИВЕСТИ к непредсказуемой работе алгоритма" skip(0)
     5041        "3. Неверно выставленные параметры МОГУТ ПРИВЕСТИ к непредсказуемой работе алгоритма" skip(0)
     5042        "ПРОДОЛЖИТЬ СОХРАНЕНИЕ              ?"
     5043        view-as alert-box WARNING buttons yes-no update v-ok.
     5044        if not v-ok then do:
     5045          undo, return .
     5046        end.
     5047     end.
     5048   end.
     5049   if not v-found-new  then do:
     5050     message
     5051     "ВНИМАНИЕ!!!" skip(0)
     5052     "ПРЕДУПРЕЖДЕНИЕ!!!" skip(0)
     5053     "1. Изменения в работе системы лояльности по данному типу ДК" skip(0)
     5054     "на УБД будут вступать в силу ПОСТЕПЕНЕННО - после получения пакета с данными изменениями по СПН" skip(0)
     5055     "Это может привести к неполноте данных по некоторым объектам и т.д." skip(0)
     5056     "2. Для некоторых профайлов предусмотрено включение/выключение правил профайла в соответствии с их бизнес-логикой," skip(0)
     5057     "несвоевременное включение/выключение любого правил из этих МОЖЕТ ПРИВЕСТИ к непредсказуемой работе алгоритма" skip(0)
     5058     "3. Неверно выставленные параметры МОГУТ ПРИВЕСТИ к непредсказуемой работе алгоритма" skip(0)
     5059     "ПРОДОЛЖИТЬ СОХРАНЕНИЕ              ?"
     5060      view-as alert-box WARNING buttons yes-no update v-ok.
     5061     if not v-ok then do:
     5062       undo, return .
     5063     end.
     5064   end.
     5065   run ref/dctypei1.p (
     5066                    input-output rid
     5067                   ,input p-mode
     5068                   ,input temp-dc-type.emitent-host-code
     5069                   ,input temp-dc-type.type
     5070                   ,input temp-dc-type.uniq-key-rec
     5071                   ,input 0
     5072                   ,input "":U
     5073                   ,input 0
     5074                   ,INPUT temp-dc-type.d-pcnt-byshop
     5075                   ,input temp-dc-type.dflt-d-pcnt-method
     5076                   ,input temp-dc-type.dflt-credit-card
     5077                   ,input (if temp-dc-type.dflt-credit-card then temp-dc-type.lim-kr else 0)
     5078                   ,INPUT temp-dc-type.dflt-debet-card
     5079                   ,INPUT temp-dc-type.dflt-staff-card
     5080                   ,INPUT temp-dc-type.fiscal-pay
     5081                   ,INPUT temp-dc-type.mixed-pay
     5082                   ,INPUT temp-dc-type.pay-code
     5083                   ,INPUT temp-dc-type.card-media
     5084                   ,INPUT temp-dc-type.cardname-sent
     5085                   ,INPUT temp-dc-type.custom-sent
     5086                   ,input temp-dc-type.dcbyshop
     5087                   ,input temp-dc-type.dc-pfx
     5088                   ,INPUT t-check-by-mask
     5089                   ,input t-ho-join
     5090                   ,input table tt0-dis-dct-rule
     5091                   ,INPUT TABLE tt0-hist-nws-option
     5092                   ,INPUT TABLE tt0-rp-by-call
     5093                   ,INPUT TABLE tt0-rule-by-call
     5094                   ,INPUT TABLE tt0-rule-call-param) no-error .
     5095   if error-status:error then do:
     5096   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5097   define variable fh as widget-handle no-undo .
     5098   define variable hh as widget-handle no-undo .
     5099   define variable rv as character no-undo .
     5100   assign
     5101   rv = entry(1, return-value , chr(4)).
     5102   if rv <> "":U then do:
     5103     assign
     5104     fh = frame Dialog-Frame:first-child
     5105     hh = fh:first-child
     5106     .
     5107     do while valid-handle(hh):
     5108       if hh:name = rv then do:
     5109         APPLY "ENTRY" to hh.
     5110         undo ,
     5111         return error.
     5112       end.
     5113       hh = hh:next-sibling.
     5114     end.
     5115   end.
     5116   if return-value <> '':U then do:
     5117     message
     5118     error-status:get-message(1)
     5119     return-value
     5120     view-as alert-box .
     5121   end.
     5122   return error.
     5123   end.
     5124   END PROCEDURE.
     5125   FUNCTION get-profile-dynamic RETURNS LOGICAL
     5126     ( p-profile_id AS INTEGER ) :
     5127   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
     5128   FIND FIRST buf_rule-profile NO-LOCK WHERE
     5129             buf_rule-profile.profile_id = p-profile_id NO-ERROR.
     5130   IF NOT AVAILABLE buf_rule-profile THEN RETURN ?.
     5131   RETURN buf_rule-profile.is_dynamic.
     5132   END FUNCTION.
     5133   FUNCTION get-profile-name RETURNS CHARACTER
     5134     ( p-profile_id AS INTEGER ) :
     5135   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
     5136   FIND FIRST buf_rule-profile NO-LOCK WHERE
     5137             buf_rule-profile.profile_id = p-profile_id NO-ERROR.
     5138   IF NOT AVAILABLE buf_rule-profile THEN RETURN chr(63).
     5139   RETURN buf_rule-profile.NAME.
     5140   END FUNCTION.
