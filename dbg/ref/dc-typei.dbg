        1   DEFINE TEMP-TABLE temp-dc-type NO-UNDO LIKE ub.dis-card-type.
        2   DEFINE TEMP-TABLE tt-2-hist-nws-option NO-UNDO LIKE ub.hist-nws-option.
        3   DEFINE TEMP-TABLE tt-rp-by-call NO-UNDO LIKE ub.rp-by-call.
        4   DEFINE TEMP-TABLE tt-rule-by-call NO-UNDO LIKE ub.rule-by-call.
        5   DEFINE TEMP-TABLE tt-rule-call-param NO-UNDO LIKE ub.rule-call-param.
        6   DEFINE TEMP-TABLE tt0-dis-dct-rule NO-UNDO LIKE ub.dis-dct-rule.
        7   DEFINE TEMP-TABLE tt0-hist-nws-option NO-UNDO LIKE ub.hist-nws-option.
        8   DEFINE TEMP-TABLE tt0-rp-by-call NO-UNDO LIKE ub.rp-by-call.
        9   DEFINE TEMP-TABLE tt0-rule-by-call NO-UNDO LIKE ub.rule-by-call.
       10   DEFINE TEMP-TABLE tt0-rule-call-param NO-UNDO LIKE ub.rule-call-param.
       11   DEFINE TEMP-TABLE tt2-rule-call-param NO-UNDO LIKE ub.rule-call-param.
       12   DEFINE BUFFER X_rp-by-call FOR ub.rp-by-call.
       13   DEFINE BUFFER X_rule-profile FOR ub.rule-profile.
       14   define input parameter parparentproc as widget-handle no-undo .
       15   define input parameter p-mode as char no-undo.
       16   define input parameter parhost-code like ub.sysconf.host-code no-undo.
       17   define input parameter parobj-type like ub.clients.obj-type no-undo.
       18   define input parameter parobj-code like ub.clients.obj-code no-undo.
       19   define input-output param rid as recid init ? no-undo.
       20   define variable vss-revision    as character no-undo init "$Revision$":u .
       21   define variable vss-author      as character no-undo init "$Author$":u .
       22   define variable vss-date        as character no-undo init "$Date$":u .
       23   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       24   define variable vss-archive     as character no-undo init "$Archive$":u .
       25   define variable vss-description as character no-undo init "Карточка типа дисконтной карты" .
       26   procedure vss-get-info :
       27     define output parameter p-vss-revision    like vss-revision    no-undo .
       28     define output parameter p-vss-author      like vss-author      no-undo .
       29     define output parameter p-vss-date        like vss-date        no-undo .
       30     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       31     define output parameter p-vss-archive     like vss-archive     no-undo .
       32     define output parameter p-vss-description like vss-description no-undo .
       33     assign
       34       p-vss-revision    = vss-revision
       35       p-vss-author      = vss-author
       36       p-vss-date        = vss-date
       37       p-vss-workfile    = vss-workfile
       38       p-vss-archive     = vss-archive
       39       p-vss-description = vss-description
       40     .
       41   end procedure.
       42   procedure vss-get-parameters :
       43     define output parameter p-vss-parameters as character no-undo .
       44   end procedure.
       45   define new global shared variable g#vssrevis-logger as handle    no-undo .
       46   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       47   define variable v-vssrevis-logger                   as handle    no-undo .
       48   procedure vss-logevent :
       49     define input  parameter p-extra-paramters as character no-undo .
       50     define variable v-vssrevis-parameters as character no-undo .
       51     do
       52     on error undo, return error return-value
       53     :
       54       if  valid-handle(v-vssrevis-logger)
       55       and v-vssrevis-logger :get-signature("logevent") <> ""
       56       then do:
       57         run vss-get-parameters in this-procedure
       58           (output v-vssrevis-parameters
       59           ).
       60         run logevent in v-vssrevis-logger
       61           (input vss-workfile
       62           ,input vss-revision
       63           ,input v-vssrevis-parameters
       64           ,input p-extra-paramters
       65           ).
       66       end.
       67     end.
       68   end procedure.
       69   assign
       70     v-vssrevis-logger = g#vssrevis-logger
       71   .
       72   if  valid-handle(v-vssrevis-logger)
       73   and v-vssrevis-logger :get-signature("logevent") <> ""
       74   then do:
       75     assign
       76       v-vssrevis-logevent = true
       77     .
       78     run vss-logevent in this-procedure (input vss-description) .
       79   end.
       80   define new global shared variable g#language as character no-undo .
       81   if g#language <> '' and g#language <> 'rus':U then do:
       82     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       83   end.
       84   define new global shared variable g#library  as handle no-undo .
       85   define new global shared variable g#library2 as handle no-undo .
       86   define   shared variable g#auto as logical no-undo.
       87   define   shared variable g#news as logical no-undo.
       88   define   shared variable g#oxml as logical no-undo.
       89   define   shared variable g#esys as logical no-undo.
       90   define   shared variable g#news-source-db as integer no-undo.
       91   define   shared variable g#esys-source-esys as integer no-undo.
       92   define   shared variable g#db-num as integer   no-undo .
       93   define   shared variable g#userid as character no-undo .
       94   define   shared variable g#passwd as character no-undo .
       95   procedure proc-alt-shift-f2:
       96     if not ibs.th.gbl.gbl-var:rcode
       97   then
       98     run gbl\inidebug.p .
       99   end.
      100   procedure proc-alt-shift-f3:
      101     run gbl/prvssinf.p
      102       ( input this-procedure
      103       ) .
      104   end.
      105   define variable v-inform-launched as logical no-undo initial false .
      106   procedure proc-alt-shift-f4:
      107     define variable v-action as character no-undo .
      108     if v-inform-launched = false then do:
      109       assign
      110         v-inform-launched = true
      111       .
      112       run gbl/d-inform.w
      113         (  input self
      114         ,  input this-procedure
      115         , output v-action
      116         ) no-error .
      117       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      118       assign
      119         v-inform-launched = false
      120       .
      121     end.
      122   end.
      123   procedure proc-alt-f1:
      124     run gbl/corrhelp.p
      125       (input this-procedure
      126       ) .
      127   end .
      128   on alt-shift-f2 anywhere do:
      129     run proc-alt-shift-f2.
      130   end.
      131   on alt-shift-f3 anywhere do:
      132     run proc-alt-shift-f3 in this-procedure .
      133   end.
      134   on alt-shift-f4 anywhere do:
      135     run proc-alt-shift-f4 in this-procedure.
      136   end.
      137   on alt-f1 anywhere do:
      138     run proc-alt-f1 in this-procedure .
      139   end.
      140   function diff-list returns character (
      141     input parfirst-list  as character,
      142     input parsecond-list as character,
      143     input pardelim       as character).
      144     if pardelim = ""
      145     or pardelim = ?
      146     then do:
      147       assign
      148         pardelim = ","
      149       .
      150     end.
      151     def var ind as integer no-undo .
      152     def var v-elem as character no-undo .
      153     def var v-result-list as character no-undo init "".
      154     def var v-num-parfirst-list as integer no-undo .
      155     assign
      156       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      157     .
      158     do ind = 1 to v-num-parfirst-list
      159     :
      160       assign
      161         v-elem = entry(ind, parfirst-list, pardelim)
      162       .
      163       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      164         assign
      165           v-result-list = v-result-list
      166                         + (if v-result-list > "" then pardelim else "")
      167                         + v-elem
      168         .
      169       end.
      170     end.
      171     return v-result-list .
      172   end function.
      173   function add-list returns character (
      174    input parfirst-list  as character,
      175    input parsecond-list as character,
      176    input pardelim       as character).
      177     if pardelim = ""
      178     or pardelim = ?
      179     then do:
      180       assign
      181         pardelim = ","
      182       .
      183     end.
      184     def var ind as integer no-undo .
      185     def var v-elem as character no-undo .
      186     def var v-result-list as character no-undo init "".
      187     def var v-num-parfirst-list as integer no-undo .
      188     assign
      189       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      190     .
      191     do ind = 1 to v-num-parfirst-list
      192     :
      193       assign
      194         v-elem = entry(ind, parfirst-list, pardelim)
      195       .
      196       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      197         assign
      198           v-result-list = v-result-list
      199                         + (if v-result-list > "" then pardelim else "")
      200                         + v-elem
      201         .
      202       end.
      203     end.
      204     def var v-num-parsecond-list as integer no-undo .
      205     assign
      206       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      207     .
      208     do ind = 1 to v-num-parsecond-list
      209     :
      210       assign
      211         v-elem = entry(ind, parsecond-list, pardelim)
      212       .
      213       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      214         assign
      215           v-result-list = v-result-list
      216                         + (if v-result-list > "" then pardelim else "")
      217                         + v-elem
      218         .
      219       end.
      220     end.
      221     return v-result-list .
      222   end function.
      223   function cross-list returns character (
      224    input parfirst-list  as character,
      225    input parsecond-list as character,
      226    input pardelim       as character).
      227     if pardelim = ""
      228     or pardelim = ?
      229     then do:
      230       assign
      231         pardelim = ","
      232       .
      233     end.
      234     def var ind as integer no-undo .
      235     def var v-elem as character no-undo .
      236     def var v-result-list as character no-undo init "".
      237     def var v-num-parfirst-list as integer no-undo .
      238     assign
      239       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      240     .
      241     do ind = 1 to v-num-parfirst-list
      242     :
      243       assign
      244         v-elem = entry(ind, parfirst-list, pardelim)
      245       .
      246       if lookup(v-elem, v-result-list, pardelim) = 0
      247       and lookup(v-elem, parsecond-list, pardelim) > 0
      248       then do:
      249         assign
      250           v-result-list = v-result-list
      251                         + (if v-result-list > "" then pardelim else "")
      252                         + v-elem
      253         .
      254       end.
      255     end.
      256     return v-result-list .
      257   end function.
      258   function radio-label returns character (
      259    input par-rs-value  as character,
      260    input par-rs-radio-buttons as character)
      261    .
      262    DEFINE variable v-result-label as character no-undo.
      263    assign
      264    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      265                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      266                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      267                             ), par-rs-radio-buttons
      268                           )
      269    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      270    .
      271   return v-result-label.
      272   end function.
      273   function m-radio-label returns character (
      274    input par-rs-value  as character,
      275    input par-rs-radio-buttons as character,
      276    input par-delim as character
      277    )
      278    .
      279    DEFINE variable v-result-label as character no-undo.
      280    assign
      281    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      282                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      283                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      284                             ), par-rs-radio-buttons, par-delim
      285                           )
      286    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      287    .
      288   return v-result-label.
      289   end function.
      290   FUNCTION mixlist returns character
      291   (
      292    input parfirst-list  as character
      293    ,input parsecond-list as character
      294    ,input pardelim       as character
      295    ,input pardelim-result as character ) :
      296     if pardelim = ""
      297     or pardelim = ?
      298     then do:
      299       assign
      300         pardelim = ","
      301       .
      302     end.
      303     def var ind as integer no-undo .
      304     def var v-elem1 as character no-undo .
      305     def var v-elem2 as character no-undo .
      306     def var v-result-list as character no-undo init "".
      307     do ind = 1 to num-entries(parfirst-list, pardelim)
      308     :
      309       assign
      310         v-elem1 = entry(ind, parfirst-list, pardelim)
      311         v-elem2 = entry(ind, parsecond-list, pardelim)
      312       .
      313         assign
      314           v-result-list = v-result-list
      315                         + (if v-result-list > "" then pardelim-result else "")
      316                         + v-elem1 + pardelim-result + v-elem2
      317         .
      318     end.
      319     return v-result-list .
      320   END FUNCTION.
      321   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      322   PROCEDURE fill-tt0-hist-nws-option :
      323   define input parameter p-emitent-host-code as integer no-undo .
      324   define input parameter p-type as character no-undo .
      325   define buffer  buf_tt0-hist-nws-option for tt0-hist-nws-option.
      326   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
      327   DEFINE VARIABLE v-table-name AS CHARACTER NO-UNDO.
      328   DEFINE VARIABLE v-label0 AS CHARACTER NO-UNDO.
      329   define variable v-region as character no-undo .
      330   DEFINE VARIABLE v-label AS CHARACTER NO-UNDO.
      331   DEFINE VARIABLE v-done AS CHARACTER NO-UNDO.
      332   define variable v-hn-id as integer no-undo .
      333   DEFINE BUFFER buf_prop-head FOR ub.prop-head.
      334   FOR EACH buf_prop-head NO-LOCK WHERE
      335       buf_prop-head.general CONTAINS  'dis-card-type':U
      336       and
      337       buf_prop-head.general-view CONTAINS  'dis-card-type':U
      338   ON ERROR UNDO, RETURN ERROR :
      339       v-label0 = buf_prop-head.prop-label.
      340       v-done = '':U.
      341       v-table-name = '':U.
      342      _v-ii:
      343      DO v-ii = 1 TO 3:
      344        IF v-ii = 1 THEN do:
      345           v-table-name = buf_prop-head.storage-place.
      346           v-label = substitute("&1_", v-label0).
      347           v-region = "".
      348        END.
      349        IF v-ii = 2 THEN do:
      350           v-table-name = buf_prop-head.storage-place-host.
      351           v-label = substitute("&1_Фирма", v-label0).
      352           v-region = "Фирма".
      353        END.
      354        IF v-ii = 3 THEN do:
      355           v-table-name = buf_prop-head.storage-place-obj.
      356           v-label = substitute("&1_Объект", v-label0).
      357           v-region = "Объект".
      358        END.
      359        IF v-table-name = '':U
      360        OR v-table-name = ?
      361        OR v-table-name = chr(63) THEN NEXT _v-ii.
      362        IF v-table-name > '':U and LOOKUP(v-table-name, v-done) = 0
      363        THEN do:
      364          FIND FIRST buf_tt0-hist-nws-option WHERE
      365                   buf_tt0-hist-nws-option.db-num = 0
      366               AND buf_tt0-hist-nws-option.table-name = v-table-name
      367               and buf_tt0-hist-nws-option.host-code = p-emitent-host-code
      368               and buf_tt0-hist-nws-option.obj-type = '':U
      369               and buf_tt0-hist-nws-option.obj-code = 0
      370               and buf_tt0-hist-nws-option.key#_one = buf_prop-head.dtm-code
      371               and buf_tt0-hist-nws-option.charkey_one = p-type no-error.
      372          if not available buf_tt0-hist-nws-option then do:
      373            create buf_tt0-hist-nws-option.
      374            assign
      375            buf_tt0-hist-nws-option.db-num = 0
      376            buf_tt0-hist-nws-option.table-name = v-table-name
      377            buf_tt0-hist-nws-option.host-code = p-emitent-host-code
      378            buf_tt0-hist-nws-option.obj-type = '':U
      379            buf_tt0-hist-nws-option.obj-code = 0
      380            buf_tt0-hist-nws-option.key#_one = buf_prop-head.dtm-code
      381            buf_tt0-hist-nws-option.charkey_one = p-type
      382            buf_tt0-hist-nws-option.get-hist-from-nws = buf_prop-head.get-hist-from-nws
      383            buf_tt0-hist-nws-option.hist-to-nws = buf_prop-head.hist-to-nws
      384            buf_tt0-hist-nws-option.nws-to-hist = buf_prop-head.nws-to-hist
      385            buf_tt0-hist-nws-option.hist-from-prim = buf_prop-head.hist-from-prim
      386            buf_tt0-hist-nws-option.nws-to-cd = buf_prop-head.nws-to-cd
      387            buf_tt0-hist-nws-option.smart-nws = buf_prop-head.smart-nws
      388            buf_tt0-hist-nws-option.get-hist-from-nws = buf_prop-head.get-hist-from-nws
      389            buf_tt0-hist-nws-option.subject-group = 'c-dc-hist':U
      390            buf_tt0-hist-nws-option.option-desc = v-label
      391            buf_tt0-hist-nws-option.hn-id = v-hn-id
      392            v-hn-id = v-hn-id + 1
      393            .
      394         END.
      395         else do:
      396           if entry(num-entries(buf_tt0-hist-nws-option.option-desc, "_")
      397                     , buf_tt0-hist-nws-option.option-desc
      398                     , "_") <> v-region
      399             or v-ii = 1 then do:
      400             v-label = substitute("&1/&2"
      401                                   , buf_tt0-hist-nws-option.option-desc
      402                                   , (if v-ii = 1
      403                                       then "_Глобально"
      404                                       else (if v-ii = 2
      405                                           then "_Фирма"
      406                                           else "_Объект"
      407                                           )
      408                                     )
      409                                   ).
      410             assign
      411             buf_tt0-hist-nws-option.option-desc = v-label
      412             .
      413           end.
      414         end.
      415       end.
      416       IF v-table-name > '':U and LOOKUP(v-table-name, v-done) > 0
      417       THEN do:
      418          FIND FIRST buf_tt0-hist-nws-option WHERE
      419                   buf_tt0-hist-nws-option.db-num = 0
      420               AND buf_tt0-hist-nws-option.table-name = v-table-name
      421               and buf_tt0-hist-nws-option.host-code = p-emitent-host-code
      422               and buf_tt0-hist-nws-option.obj-type = '':U
      423               and buf_tt0-hist-nws-option.obj-code = 0
      424               and buf_tt0-hist-nws-option.key#_one = buf_prop-head.dtm-code
      425               and buf_tt0-hist-nws-option.charkey_one = p-type no-error.
      426          if available buf_tt0-hist-nws-option then do:
      427           if entry(num-entries(buf_tt0-hist-nws-option.option-desc, "_")
      428                   , buf_tt0-hist-nws-option.option-desc
      429                   , "_") <> v-region
      430           or v-ii = 1 then do:
      431             v-label = substitute("&1/&2"
      432                                   , buf_tt0-hist-nws-option.option-desc
      433                                   , (if v-ii = 1
      434                                       then "_Глобально"
      435                                       else (if v-ii = 2
      436                                           then "_Фирма"
      437                                           else "_Объект"
      438                                           )
      439                                     )
      440                                   ).
      441             assign
      442             buf_tt0-hist-nws-option.option-desc = v-label
      443             .
      444           end.
      445         end.
      446       end.
      447       v-done = v-done + chr(44) + v-table-name.
      448     END.
      449   END.
      450   END PROCEDURE.
      451   define variable old-emitent-host-code like ub.dis-card-type.emitent-host-code no-undo.
      452   define variable v-r-b-code like ub.currency.curr-code no-undo .
      453   define variable v-curr-r-b  as character no-undo .
      454   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      455   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      456   define variable dcard-algo-field-name as character no-undo extent 3 init [
      457    'd-pcnt':U
      458   ,'cash-d-pcnt':U
      459   ,'pcnt-kat':U].
      460   define variable algo-field-abbr as character no-undo extent 3 init [
      461    'ITEM%':U
      462   ,'TOTAL%':U
      463   ,'CATEG':U].
      464   FUNCTION dct-algo-Date-to-String returns character(input  p-date as date):
      465   define variable v-date-str as character no-undo .
      466   assign
      467   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
      468                string(Month(p-date), "99":U) + chr(47) +
      469                string(DAY(p-date), "99":U).
      470   return v-date-str.
      471   END FUNCTION.
      472   function dct-algo-string-to-date returns date ( input p-string  as character):
      473     define variable v-date as date no-undo .
      474     assign
      475     v-date = date(integer(substring(p-string, 6, 2))
      476                   ,integer(substring(p-string, 9, 2))
      477                   ,integer(substring(p-string, 1, 4))
      478                  ) no-error .
      479     if error-status:error then return ?.
      480     return v-date.
      481   END FUNCTION.
      482   FUNCTION dct-algo-get-sum-id-from-DT-CODE returns character ( input p-DT-CODE as integer):
      483   define buffer buf_prop-ref for ub.prop-ref.
      484   find first buf_prop-ref no-lock where
      485             buf_prop-ref.DT-CODE = p-DT-CODE no-error.
      486   if not available buf_prop-ref then do:
      487     return chr(63).
      488   end.
      489   return buf_prop-ref.sum-id.
      490   END FUNCTION.
      491   FUNCTION dct-algo-get-description-sum-id returns character ( input p-dt-code as integer):
      492   define variable v-des as character no-undo .
      493   define buffer buf_prop-ref for ub.prop-ref.
      494   define buffer buf_prop-head for ub.prop-head.
      495   find first buf_prop-ref no-lock where
      496             buf_prop-ref.dt-code = p-dt-code no-error.
      497   if not available buf_prop-ref then do:
      498     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
      499   end.
      500   find first buf_prop-head no-lock where
      501           buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error.
      502   if not available buf_prop-head then do:
      503     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, buf_prop-ref.dtm-code).
      504   end.
      505   assign
      506   v-des = substitute("&1  &2 &3"
      507                     , buf_prop-head.prop-name
      508                     , buf_prop-ref.sum-id
      509                     , buf_prop-ref.caller_id).
      510   return v-des.
      511   end FUNCTION.
      512   FUNCTION dct-algo-get-description-node-code returns character ( input p-dtm-code as integer
      513                                                               ,input p-dt-code as integer
      514                                                               ,input p-node-code as integer
      515                                                               ):
      516   define variable v-des as character no-undo .
      517   define buffer buf_prop-ref for ub.prop-ref.
      518   define buffer buf_prop-head for ub.prop-head.
      519   define buffer buf_prop-map for ub.prop-map.
      520   find first buf_prop-ref no-lock where
      521             buf_prop-ref.dt-code = p-dt-code no-error.
      522   if not available buf_prop-ref then do:
      523     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
      524   end.
      525   find first buf_prop-head no-lock where
      526           buf_prop-head.dtm-code = p-dtm-code no-error.
      527   if not available buf_prop-head then do:
      528     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, p-dtm-code).
      529   end.
      530   find first buf_prop-map no-lock where
      531           buf_prop-map.dtm-code = p-dtm-code
      532       and buf_prop-map.node-code = p-node-code no-error .
      533   if not available buf_prop-map then do:
      534     return substitute("Срез/итог по ДК &1, &2.&3 - неизвестно"
      535                       , p-dt-code
      536                       , buf_prop-head.prop-label
      537                       , p-node-code).
      538   end.
      539   assign
      540   v-des = substitute("&1.&2 &3 &4"
      541                     , buf_prop-head.prop-label
      542                     , buf_prop-map.node-label
      543                     , buf_prop-ref.sum-id
      544                     , buf_prop-ref.caller_id).
      545   return v-des.
      546   end FUNCTION.
      547   function dct-algo-get-prev-sum-id RETURNS integer (
      548                                                       input p-dt-code as integer
      549                                                      ):
      550   define variable v-dtm-code as integer no-undo .
      551   define variable v-sum-id as character no-undo .
      552   define variable v-caller-id as character no-undo .
      553   define buffer buf_prop-ref for ub.prop-ref.
      554   find first buf_prop-ref no-lock where
      555           buf_prop-ref.dt-code = p-dt-code no-error.
      556   if not available buf_prop-ref then return ?.
      557   assign
      558   v-dtm-code = buf_prop-ref.dtm-code
      559   v-sum-id = buf_prop-ref.sum-id.
      560   v-caller-id = buf_prop-ref.caller_id.
      561   find last buf_prop-ref no-lock where
      562             buf_prop-ref.dtm-code = v-dtm-code
      563        and  buf_prop-ref.sum-id < v-sum-id
      564        and  buf_prop-ref.caller_id = v-caller-id
      565        no-error.
      566   if available buf_prop-ref then return buf_prop-ref.dt-code.
      567   return -1 .
      568   END FUNCTION.
      569   FUNCTION dct-algo-get_dcproperty-value returns logical (
      570                                                             input p-prop-name as character
      571                                                           , input p-d-card    as character
      572                                                           , input p-host-code as integer
      573                                                           , input p-obj-type  as character
      574                                                           , input p-obj-code  as integer
      575                                                           , output p-value-character as character
      576                                                           , output p-value-date   as date
      577                                                           , output p-value-integer as integer
      578                                                           , output p-value-decimal as decimal
      579                                                           , output p-value-logical as logical):
      580     return no.
      581   END FUNCTION.
      582   FUNCTION dct-algo-get_dcproperty-value-chr returns logical (
      583                                                             input p-d-card    as character
      584                                                           , input p-emitent-host-code as integer
      585                                                           , input p-type as character
      586                                                           , input p-host-code as integer
      587                                                           , input p-obj-type  as character
      588                                                           , input p-obj-code  as integer
      589                                                           , output p-value-chr as character):
      590   define variable v-dt-code as integer no-undo .
      591   define variable v-node-code as integer no-undo .
      592   define variable v-field-name as character no-undo .
      593   define variable v-storage-place as character no-undo .
      594   define variable v-sum-id-value as character no-undo .
      595   define variable v-sum-id-output as logical no-undo .
      596   define variable v-value-chr as character no-undo .
      597   define variable v-ii as integer no-undo .
      598   define buffer buf_dis-card-property for ub.dis-card-property.
      599   define buffer buf_dis-host for ub.dis-host.
      600   define buffer buf_dis-obj for ub.dis-obj.
      601   run get-cd-sumid in this-procedure (
      602                                         input p-emitent-host-code
      603                                        ,input p-type
      604                                        ,input p-host-code
      605                                        ,input p-obj-type
      606                                        ,input p-obj-code
      607                                        ,output v-sum-id-value
      608                                        ,output v-sum-id-output
      609                                       ) no-error.
      610   if not v-sum-id-output then do:
      611     return no.
      612   end.
      613   do v-ii = 1 to num-entries(v-sum-id-value):
      614     assign
      615     v-storage-place = entry(1, entry(v-ii, v-sum-id-value), chr(4))
      616     v-dt-code = integer(entry(2, entry(v-ii, v-sum-id-value), chr(4)))
      617     v-node-code = integer(entry(3, entry(v-ii, v-sum-id-value), chr(4)))
      618     v-field-name = entry(4, entry(v-ii, v-sum-id-value), chr(4))
      619     no-error .
      620     if not error-status:error then do:
      621       case v-storage-place:
      622         when 'dis-card-property':U then do:
      623           find first buf_dis-card-property no-lock where
      624                     buf_dis-card-property.d-card = p-d-card
      625               and  buf_dis-card-property.host-code = p-host-code
      626               and  buf_dis-card-property.obj-type = p-obj-type
      627               and  buf_dis-card-property.obj-code = p-obj-code
      628               and  buf_dis-card-property.dt-code = v-dt-code
      629               and  buf_dis-card-property.node-code = v-node-code no-error .
      630           if available buf_dis-card-property then do:
      631             v-value-chr = buffer buf_dis-card-property:handle:buffer-field(v-field-name):string-value.
      632           end.
      633           else do:
      634             v-value-chr = chr(63).
      635           end.
      636         end.
      637         when 'dis-obj':U then do:
      638           find first buf_dis-obj no-lock where
      639                     buf_dis-obj.d-card = p-d-card
      640               and  buf_dis-obj.obj-type = p-obj-type
      641               and  buf_dis-obj.obj-code = p-obj-code
      642               and  buf_dis-obj.dt-code = v-dt-code no-error .
      643           if available buf_dis-obj then do:
      644             v-value-chr = buffer buf_dis-obj:handle:buffer-field(v-field-name):string-value.
      645           end.
      646           else do:
      647             v-value-chr = chr(63).
      648           end.
      649         end.
      650         when 'dis-host':U then do:
      651           find first buf_dis-host no-lock where
      652                     buf_dis-host.d-card = p-d-card
      653               and  buf_dis-host.host-code = p-host-code
      654               and  buf_dis-host.dt-code = v-dt-code no-error .
      655           if available buf_dis-host then do:
      656             v-value-chr = buffer buf_dis-host:handle:buffer-field(v-field-name):string-value.
      657           end.
      658           else do:
      659             v-value-chr = chr(63).
      660           end.
      661         end.
      662       end.
      663     end.
      664     p-value-chr = p-value-chr + (if v-ii = 1 then '':U else chr(44)) + v-value-chr.
      665   end.
      666   END FUNCTION.
      667   FUNCTION dct-algo_custom-sent-description RETURNS CHARACTER
      668     ( INPUT p-custom-sent as character ) :
      669   DEFINE VARIABLE v-storage-place AS CHARACTER NO-UNDO.
      670   DEFINE VARIABLE v-dtm-code AS integer NO-UNDO.
      671   DEFINE VARIABLE v-sum-id AS character NO-UNDO.
      672   DEFINE VARIABLE v-caller-id AS character NO-UNDO.
      673   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
      674   DEFINE VARIABLE v-sum-id-description AS CHARACTER.
      675   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
      676   IF p-custom-sent = chr(63) THEN RETURN "Не отсылать".
      677   assign
      678   v-storage-place = entry(1, p-custom-sent, chr(4))
      679   v-dtm-code = integer(entry(2, p-custom-sent, chr(4)))
      680   v-sum-id   = entry(3, p-custom-sent, chr(4))
      681   v-caller-id = entry(4, p-custom-sent, chr(4))
      682   v-node-code = integer(entry(5, p-custom-sent, chr(4)))
      683   no-error .
      684   IF ERROR-STATUS:ERROR THEN DO:
      685     MESSAGE
      686     "Не могу разобрать строку, описывающую итог"
      687      VIEW-AS ALERT-BOX WARNING.
      688     RETURN chr(63).
      689   END.
      690   FIND FIRST buf_prop-ref NO-LOCK WHERE
      691             buf_prop-ref.dtm-code = v-dtm-code
      692        AND  buf_prop-ref.sum-id = v-sum-id
      693        AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
      694   IF NOT AVAILABLE buf_prop-ref THEN DO:
      695     FIND FIRST buf_prop-ref NO-LOCK WHERE
      696               buf_prop-ref.dtm-code = v-dtm-code
      697         AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
      698     IF NOT AVAILABLE buf_prop-ref THEN DO:
      699         MESSAGE
      700         "Не могу разобрать строку, описывающую итог"
      701          VIEW-AS ALERT-BOX WARNING.
      702         RETURN chr(63).
      703      end.
      704   end.
      705   ASSIGN
      706   v-sum-id-description =  dct-algo-get-description-node-code ( v-dtm-code
      707                                                          ,buf_prop-ref.dt-code
      708                                                          ,v-node-code).
      709   RETURN v-sum-id-description.
      710   END FUNCTION.
      711   FUNCTION one-base-cur-for-objs  returns logical (output p-glob-curr-code as integer):
      712   define variable v-glob-val as logical no-undo init yes.
      713   define buffer buf_sysconf for ub.sysconf.
      714   define buffer buf_clients for ub.clients.
      715   assign
      716   p-glob-curr-code =  -1
      717   .
      718   FOR EACH buf_sysconf NO-LOCK,
      719       first buf_clients no-lock where
      720            buf_clients.host-code = buf_sysconf.host-code:
      721       if p-glob-curr-code = -1 then
      722       assign
      723       p-glob-curr-code = buf_sysconf.base-code
      724       .
      725       else if p-glob-curr-code <> buf_sysconf.base-code then do:
      726           assign
      727           v-glob-val = no
      728           p-glob-curr-code = ?
      729           .
      730           LEAVE.
      731       end.
      732   END.
      733   return v-glob-val.
      734   END FUNCTION.
      735   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      736   procedure gen-key-rec :
      737     define input  parameter p-tbl-name    as character no-undo.
      738     define input  parameter p-bh_tbl-name as handle    no-undo.
      739     define output parameter p-key-rec     as character no-undo.
      740     do
      741     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      742     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      743     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      744     :
      745       define variable fh               as handle    no-undo .
      746       define variable v-ok             as logical   no-undo .
      747       define variable v-inform         as character no-undo .
      748       define variable v-ind            as integer   no-undo .
      749       define variable v-idx-field-qnty as integer   no-undo .
      750       if p-tbl-name = ?
      751         or p-tbl-name = "":U
      752       then do:
      753         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      754       end.
      755       if not p-bh_tbl-name:available then do:
      756         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      757       end.
      758       assign
      759         p-key-rec = p-tbl-name
      760         v-inform  = p-bh_tbl-name:index-information(1)
      761         v-ind     = 2
      762       .
      763       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      764       on error undo, return error
      765       :
      766         assign
      767           v-inform = p-bh_tbl-name:index-information( v-ind )
      768           v-ind    = v-ind + 1
      769         .
      770       end.
      771       if v-inform = ?
      772         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      773         or entry( 3, v-inform, ",":U ) <> "1":U
      774       then do:
      775         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      776       end.
      777       else do:
      778         assign
      779           v-idx-field-qnty = num-entries( v-inform ) - 4
      780         .
      781         if v-idx-field-qnty < 2 then do:
      782           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      783         end.
      784         do v-ind = 1 to v-idx-field-qnty by 2
      785         on error undo, return error
      786         :
      787           assign
      788             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      789             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      790           .
      791         end.
      792       end.
      793       if p-key-rec = ? then do:
      794         assign
      795           p-key-rec = "":U
      796         .
      797         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      798       end.
      799     end.
      800     return.
      801   end procedure.
      802   procedure gen-where-keyr-tab :
      803     define input  parameter i-tableSerach as character no-undo.
      804     define input  parameter i-tablekey   as character  no-undo.
      805     define input  parameter p-key-rec    as character  no-undo.
      806     define input  parameter p-key-handle as handle     no-undo .
      807     define input  parameter p-db-name    as character  no-undo .
      808     define input  parameter p-tt-handle  as handle     no-undo .
      809     define output parameter o-Where      as character  no-undo.
      810     do
      811     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      812     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      813     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      814     :
      815       define variable v-full-tbl-name  as character no-undo .
      816       define variable bh_tbl-name      as handle    no-undo .
      817       define variable fh_key           as handle    no-undo .
      818       define variable fh_search        as handle    no-undo .
      819       define variable v-field-num      as integer   no-undo .
      820       define variable v-count-fld      as integer   no-undo .
      821       define variable v-inform         as character no-undo .
      822       define variable v-ind            as integer   no-undo .
      823       define variable v-idx-field-qnty as integer   no-undo .
      824       define variable v-field-name     as character no-undo .
      825       define variable v-field-val      as character no-undo .
      826       define variable v-word-link      as character no-undo .
      827       define variable vTable           as character no-undo.
      828       define variable bh_tbl-key       as handle    no-undo .
      829       assign
      830         p-key-rec = trim( p-key-rec )
      831       .
      832       if p-key-handle <> ? then do:
      833         if not valid-handle(p-key-handle)
      834            or p-key-handle:type <> "buffer"
      835         then do:
      836           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      837         end.
      838         if num-entries( p-key-rec, chr(3) ) > 1
      839           or p-key-rec = ?
      840           or p-key-rec = "":U
      841         then do:
      842           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      843         end.
      844       end.
      845       else do:
      846         if p-key-rec = ?
      847           or p-key-rec = "":U
      848         then do:
      849           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      850         end.
      851       end.
      852       assign
      853         vTable = entry( 1 , p-key-rec, chr(3) )
      854       .
      855       if p-tt-handle <> ?
      856         and ( not valid-handle(p-tt-handle)
      857               or p-tt-handle:type <> "buffer"
      858             )
      859       then do:
      860         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      861       end.
      862       if p-tt-handle = ? then do:
      863         assign
      864           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      865         .
      866         create buffer bh_tbl-name for table v-full-tbl-name .
      867       end.
      868       else do:
      869         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      870       end.
      871       assign
      872         v-inform = bh_tbl-name:index-information(1)
      873         v-ind    = 2
      874       .
      875       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      876       on error undo, return error
      877       :
      878         assign
      879           v-inform = bh_tbl-name:index-information( v-ind )
      880           v-ind    = v-ind + 1
      881         .
      882       end.
      883       if v-inform = ?
      884         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      885         or entry( 3, v-inform, ",":U ) <> "1":U
      886       then do:
      887         delete object bh_tbl-name no-error.
      888         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      889       end.
      890       assign
      891         v-idx-field-qnty = num-entries( v-inform ) - 4
      892       .
      893       if v-idx-field-qnty < 2 then do:
      894         delete object bh_tbl-name no-error.
      895         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      896       end.
      897       assign
      898         o-where     = "where":U
      899         v-word-link = "":U
      900         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      901         v-count-fld = 0
      902       .
      903       if i-tablekey ne "" and i-tablekey ne ?
      904       then do:
      905         assign
      906           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      907         .
      908         create buffer bh_tbl-key for table v-full-tbl-name .
      909       end.
      910       if i-tableSerach ne "" and i-tableSerach ne ?
      911       then do:
      912         delete object bh_tbl-name no-error.
      913         assign
      914           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      915         .
      916         create buffer bh_tbl-name for table v-full-tbl-name .
      917       end.
      918       block_where:
      919       do v-ind = 1 to v-idx-field-qnty by 2
      920       on error undo, return error
      921       :
      922         assign
      923           v-count-fld = v-count-fld + 1
      924         .
      925         if p-key-handle = ?
      926           and v-count-fld > v-field-num
      927         then do:
      928           leave block_where.
      929         end.
      930         define variable VfieldKeyTable as handle no-undo.
      931         assign
      932           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      933           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      934         .
      935         if     bh_tbl-key ne ?
      936         then do:
      937            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      938            if VfieldKeyTable eq ?
      939            then next block_where.
      940         end.
      941         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      942         then
      943            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      944         else
      945            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      946         if p-key-handle = ? then do:
      947           assign
      948             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      949           .
      950         end.
      951         else do:
      952           assign
      953             fh_key = p-key-handle:buffer-field( v-field-name )
      954           .
      955           if fh_key = ?
      956             or not valid-handle( fh_key )
      957           then do:
      958             delete object bh_tbl-name.
      959             if     bh_tbl-key ne ?
      960             then
      961                delete object bh_tbl-key.
      962             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      963           end.
      964           assign
      965             v-field-val = fh_key:buffer-value
      966           .
      967         end.
      968         if fh_search:data-type ="character":U then do:
      969           assign
      970             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      971             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      972             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      973             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      974             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      975             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      976             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      977             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      978             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      979             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      980             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      981             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      982             v-field-val = substitute( '"&1"', v-field-val )
      983           .
      984         end.
      985         assign
      986           o-where = substitute( "&1 &2", o-where, v-field-val )
      987         .
      988         if v-word-link = "":U then do:
      989           assign
      990             v-word-link = "and":U
      991           .
      992         end.
      993       end.
      994       delete object bh_tbl-name.
      995       if     bh_tbl-key ne ?
      996       then
      997          delete object bh_tbl-key.
      998       if p-key-handle = ?
      999         and v-count-fld <> v-field-num
     1000       then do:
     1001         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
     1002       end.
     1003     end.
     1004   end procedure.
     1005   procedure gen-hn-keyr-tab :
     1006     define input  parameter i-tableSerach as character no-undo.
     1007     define input  parameter i-tablekey   as character no-undo.
     1008     define input  parameter p-key-rec    as character no-undo.
     1009     define input  parameter p-key-handle as handle    no-undo .
     1010     define input  parameter p-db-name    as character no-undo .
     1011     define input  parameter p-tt-handle  as handle    no-undo .
     1012     define input  parameter p-stts-lock  as integer   no-undo .
     1013     define output parameter o-hn         as handle    no-undo.
     1014     define variable v-full-tbl-name as character no-undo.
     1015     define variable v-where         as character no-undo.
     1016     define variable bh_tbl-name     as handle    no-undo.
     1017     define variable vTable          as character no-undo.
     1018     do
     1019     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1020     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1021     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1022         run gen-where-keyr-tab(i-tableSerach,
     1023                                i-tablekey,
     1024                                p-key-rec,
     1025                                p-key-handle,
     1026                                p-db-name,
     1027                                p-tt-handle,
     1028                                output v-where).
     1029         if i-tableSerach ne "" and i-tableSerach ne ?
     1030         then do:
     1031            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1032            create buffer bh_tbl-name for table v-full-tbl-name .
     1033         end.
     1034         else do:
     1035            if p-tt-handle = ? then do:
     1036               assign
     1037                  vTable = entry( 1 , p-key-rec, chr(3) )
     1038               .
     1039               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1040               create buffer bh_tbl-name for table v-full-tbl-name .
     1041            end.
     1042            else do:
     1043               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1044            end.
     1045         end.
     1046         if p-tt-handle = ? then do:
     1047            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1048         end.
     1049         else do:
     1050            bh_tbl-name:find-first( v-where ) no-error .
     1051         end.
     1052         o-hn = bh_tbl-name.
     1053      end.
     1054   end procedure.
     1055   procedure gen-hn-keyr :
     1056     define input  parameter p-key-rec    as character no-undo.
     1057     define input  parameter p-key-handle as handle    no-undo .
     1058     define input  parameter p-db-name    as character no-undo .
     1059     define input  parameter p-tt-handle  as handle    no-undo .
     1060     define input  parameter p-stts-lock  as integer   no-undo .
     1061     define output parameter o-hn         as handle    no-undo.
     1062     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1063   end.
     1064   procedure gen-row-keyr :
     1065     define input  parameter p-key-rec    as character no-undo.
     1066     define input  parameter p-key-handle as handle    no-undo .
     1067     define input  parameter p-db-name    as character no-undo .
     1068     define input  parameter p-tt-handle  as handle    no-undo .
     1069     define input  parameter p-stts-lock  as integer   no-undo .
     1070     define output parameter p-tbl-row    as rowid     no-undo.
     1071     define output parameter p-tbl-name   as character no-undo.
     1072     define variable vHn as handle no-undo.
     1073       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1074       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1075       p-tbl-name =  vHn:table.
     1076       delete object vHn no-error.
     1077     if p-tbl-row = ? then do:
     1078       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
     1079     end.
     1080     else do:
     1081       return.
     1082     end.
     1083   end procedure.
     1084   procedure gen-key-fv :
     1085     define input  parameter p-key-rec    as character no-undo .
     1086     define output parameter p-field-list as character no-undo .
     1087     define output parameter p-value-list as character no-undo.
     1088     do
     1089     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1090     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1091     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1092     :
     1093       define variable v-full-tbl-name  as character no-undo .
     1094       define variable bh_tbl-name      as handle    no-undo .
     1095       define variable v-tbl-name       as character no-undo .
     1096       define variable v-field-num      as integer   no-undo .
     1097       define variable v-count-fld      as integer   no-undo .
     1098       define variable v-inform         as character no-undo .
     1099       define variable v-ind            as integer   no-undo .
     1100       define variable v-idx-field-qnty as integer   no-undo .
     1101       define variable v-delim-key      as character no-undo .
     1102       if p-key-rec = ?
     1103         or p-key-rec = "":U
     1104       then do:
     1105         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
     1106       end.
     1107       assign
     1108         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1109         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1110       .
     1111       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1112       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
     1113       assign
     1114         v-inform = bh_tbl-name:index-information(1)
     1115         v-ind    = 2
     1116       .
     1117       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1118       on error undo, return error
     1119       :
     1120         assign
     1121           v-inform = bh_tbl-name:index-information( v-ind )
     1122           v-ind    = v-ind + 1
     1123         .
     1124       end.
     1125       if v-inform = ?
     1126         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1127         or entry( 3, v-inform, ",":U ) <> "1":U
     1128       then do:
     1129         delete object bh_tbl-name no-error.
     1130         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
     1131       end.
     1132       assign
     1133         v-idx-field-qnty = num-entries( v-inform ) - 4
     1134       .
     1135       if v-idx-field-qnty < 2 then do:
     1136         delete object bh_tbl-name no-error.
     1137         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
     1138       end.
     1139       assign
     1140         p-field-list = "":U
     1141         p-value-list = "":U
     1142         v-delim-key  = "":U
     1143         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1144         v-count-fld  = 0
     1145       .
     1146       block_where:
     1147       do v-ind = 1 to v-idx-field-qnty by 2
     1148       on error undo, return error
     1149       :
     1150         assign
     1151           v-count-fld = v-count-fld + 1
     1152         .
     1153         if v-count-fld > v-field-num then do:
     1154           leave block_where.
     1155         end.
     1156         assign
     1157           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1158           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1159         .
     1160         if v-ind = 1 then do:
     1161           assign
     1162             v-delim-key = chr(3)
     1163           .
     1164         end.
     1165       end.
     1166       delete object bh_tbl-name.
     1167       if v-count-fld <> v-field-num then do:
     1168         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
     1169       end.
     1170     end.
     1171   end procedure.
     1172   procedure gen-key-field :
     1173     define input  parameter p-table      as character no-undo .
     1174     define output parameter p-field-list as character no-undo .
     1175     do
     1176     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1177     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1178     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1179     :
     1180       define variable v-full-tbl-name  as character no-undo .
     1181       define variable bh_tbl-name      as handle    no-undo .
     1182       define variable v-tbl-name       as character no-undo .
     1183       define variable v-field-num      as integer   no-undo .
     1184       define variable v-count-fld      as integer   no-undo .
     1185       define variable v-inform         as character no-undo .
     1186       define variable v-ind            as integer   no-undo .
     1187       define variable v-idx-field-qnty as integer   no-undo .
     1188       define variable v-delim-key      as character no-undo .
     1189       if p-table = ?
     1190         or p-table = "":U
     1191       then do:
     1192         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
     1193       end.
     1194       assign
     1195         v-tbl-name      = p-table
     1196         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1197       .
     1198       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1199       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
     1200       assign
     1201         v-inform = bh_tbl-name:index-information(1)
     1202         v-ind    = 2
     1203       .
     1204       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1205       on error undo, return error
     1206       :
     1207         assign
     1208           v-inform = bh_tbl-name:index-information( v-ind )
     1209           v-ind    = v-ind + 1
     1210         .
     1211       end.
     1212       if v-inform = ?
     1213         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1214         or entry( 3, v-inform, ",":U ) <> "1":U
     1215       then do:
     1216         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
     1217       end.
     1218       assign
     1219         v-idx-field-qnty = num-entries( v-inform ) - 4
     1220       .
     1221       if v-idx-field-qnty < 2 then do:
     1222         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
     1223       end.
     1224       assign
     1225         p-field-list = "":U
     1226         v-delim-key  = "":U
     1227         v-count-fld  = 0
     1228       .
     1229       block_where:
     1230       do v-ind = 1 to v-idx-field-qnty by 2
     1231       on error undo, return error
     1232       :
     1233         assign
     1234           v-count-fld = v-count-fld + 1
     1235         .
     1236         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1237         if v-ind = 1 then do:
     1238           assign
     1239             v-delim-key = chr(3)
     1240           .
     1241         end.
     1242       end.
     1243       delete object bh_tbl-name.
     1244     end.
     1245   end procedure.
     1246   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1247   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1248   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1249   FUNCTION get-region RETURNS CHARACTER
     1250     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1251     define variable par-region as character no-undo.
     1252     if parhost-code = 0 and
     1253          parobj-type = "":U and
     1254          parobj-code = 0 then do:
     1255          par-region = "Глобально".
     1256          return par-region.
     1257       end.
     1258       if parobj-type = 'орг':U then do:
     1259          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1260          return par-region.
     1261       end.
     1262       if parobj-type = 'регион':U
     1263       then do:
     1264          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1265          return par-region.
     1266       end.
     1267       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1268       return par-region.
     1269   END FUNCTION.
     1270   FUNCTION get-objregion RETURNS CHARACTER
     1271     (  input parobj-type as character, input parobj-code as integer ) :
     1272     define variable par-region as character no-undo.
     1273     if  parobj-type = "":U and
     1274         parobj-code = 0
     1275     then do:
     1276        par-region = "Глобально".
     1277     end.
     1278     else if parobj-type = 'орг':U
     1279     then do:
     1280        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1281     end.
     1282     else if parobj-type = 'регион':U
     1283     then do:
     1284        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1285     end.
     1286     else
     1287        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1288     return par-region.
     1289   END FUNCTION.
     1290   FUNCTION calldscr returns character ( input p-call-id as character):
     1291   define variable v-descr as character no-undo .
     1292   define variable v-field-list as character no-undo .
     1293   define variable v-value-list as character no-undo.
     1294   define variable v-prop-label as character no-undo .
     1295   define variable v-node-label as character no-undo .
     1296   define variable v-dt-code as integer no-undo .
     1297   define variable v-host-code as integer no-undo .
     1298   define variable v-obj-type as character no-undo .
     1299   define variable v-obj-code as integer no-undo .
     1300   define variable v-label as character no-undo .
     1301   define variable v-node-code as integer no-undo .
     1302   define buffer buf_prop-head for ub.prop-head.
     1303   define buffer buf_prop-ref for ub.prop-ref.
     1304   define buffer buf_prop-map for ub.prop-map.
     1305   run gen-key-fv in this-procedure ( input p-call-id
     1306                                     ,output v-field-list
     1307                                     ,output v-value-list) no-error .
     1308   if error-status:error then return p-call-id.
     1309   CASE entry(1, p-call-id, chr(3)):
     1310     when 'dis-card-type':U then do:
     1311       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     1312                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1313                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1314                            ).
     1315     end.
     1316     when 'dis-card':U then do:
     1317       v-descr = substitute("ДК: № &1"
     1318                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1319                            ).
     1320     end.
     1321     when 'dis-card-property':U then do:
     1322       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1323       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1324       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1325       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     1326       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1327       find first buf_prop-ref no-lock where
     1328                 buf_prop-ref.dt-code = v-dt-code no-error .
     1329       if available buf_prop-ref then do:
     1330         find first buf_prop-head no-lock where
     1331                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     1332         v-prop-label = buf_prop-head.prop-label.
     1333         find first buf_prop-map no-lock where
     1334                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     1335               and buf_prop-map.node-code = v-node-code no-error .
     1336         if available buf_prop-map then do:
     1337           v-label = buf_prop-map.node-label.
     1338         end.
     1339       end.
     1340       v-descr = substitute("ДК: № &1 &2:&3 &4"
     1341                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1342                            ,v-prop-label
     1343                            ,v-label
     1344                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     1345                            ).
     1346     end.
     1347     when 'clients':U then do:
     1348       v-descr = substitute("&1&2"
     1349                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1350                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1351                            ).
     1352     end.
     1353     when 'ext-system':U then do:
     1354       v-descr = substitute("Внешняя система &1"
     1355                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1356                            ).
     1357     end.
     1358     WHEN 'thbj-attr':U then do:
     1359       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1360       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1361       then do:
     1362         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1363           v-descr = "Операции с товарами".
     1364         end.
     1365         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1366           v-descr = "Операции с клиентами".
     1367         end.
     1368         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1369           v-descr = "Операции с группами товаров".
     1370         end.
     1371         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1372           v-descr = "Операции с группами клиентов".
     1373         end.
     1374         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1375           v-descr = "Операции с чеками на POS IBS-TH".
     1376         end.
     1377         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1378           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1379         end.
     1380         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1381           v-descr = "Операции в системе электронного документооборота".
     1382         end.
     1383         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1384           v-descr = "Операции со справочниками".
     1385         end.
     1386         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1387           v-descr = "Операции с ДНЦ и переоценками".
     1388         end.
     1389         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1390           v-descr = "Отчеты".
     1391         end.
     1392         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1393           v-descr = "Операции с заказами".
     1394         end.
     1395       end.
     1396     end.
     1397     when 'cash-desk':U then do:
     1398       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1399                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1400                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1401                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1402                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1403                            ).
     1404     end.
     1405     when 'ext-file':U then do:
     1406       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1407                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1408                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1409                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1410                            ).
     1411     end.
     1412   end case.
     1413   return v-descr.
     1414   end function.
     1415   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1416   PROCEDURE dc-typei_fill-table :
     1417   define input  parameter p-mode as character no-undo .
     1418   define input  parameter p-silent as logical   no-undo .
     1419   define output parameter f-dflt-pcnt as decimal no-undo .
     1420   define output parameter f-dflt-cash-pcnt as decimal no-undo .
     1421   define output parameter f-dflt-pcnt-kat as integer   no-undo .
     1422   DEFINE VARIABLE v-dct-algo-call-id AS CHARACTER NO-UNDO.
     1423   DEFINE BUFFER buf_hist-nws-option FOR ub.hist-nws-option.
     1424   DEFINE BUFFER buf_rule-by-call FOR ub.rule-by-call.
     1425   DEFINE BUFFER buf_rp-by-call FOR ub.rp-by-call.
     1426   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
     1427   DEFINE BUFFER buf_rule-by-profile FOR ub.rule-by-profile.
     1428   DEFINE BUFFER buf_rule-call-param FOR ub.rule-call-param.
     1429   DEFINE BUFFER buf_dis-dct-rule FOR ub.dis-dct-rule.
     1430   DEFINE BUFFER buf_dis-rule FOR ub.dis-rule.
     1431   fill-block:
     1432   do
     1433   on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1434   on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1435   on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1436   :
     1437   IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     1438     FOR EACH buf_hist-nws-option  NO-LOCK WHERE
     1439           buf_hist-nws-option.db-num = 0
     1440       AND buf_hist-nws-option.host-code = temp-dc-type.emitent-host-code
     1441       AND buf_hist-nws-option.obj-type = '':U
     1442       AND buf_hist-nws-option.obj-code = 0
     1443       and buf_hist-nws-option.charkey_one = temp-dc-type.TYPE
     1444       and buf_hist-nws-option.subject-group = 'c-dc-hist':U
     1445       and buf_hist-nws-option.host-code = temp-dc-type.emitent-host-code
     1446       on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1447       on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1448       on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1449       :
     1450       CREATE tt0-hist-nws-option.
     1451       BUFFER-COPY buf_hist-nws-option TO tt0-hist-nws-option.
     1452     END.
     1453     FOR EACH buf_dis-dct-rule NO-LOCK WHERE
     1454             buf_dis-dct-rule.TYPE = temp-dc-type.TYPE
     1455          AND buf_dis-dct-rule.emitent-host-code = temp-dc-type.emitent-host-code
     1456         on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1457         on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1458         on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1459         :
     1460       CREATE tt0-dis-dct-rule.
     1461       BUFFER-COPY buf_dis-dct-rule TO tt0-dis-dct-rule.
     1462       if (buf_dis-dct-rule.discnt-role = 'def-pcnt':U
     1463           or
     1464           buf_dis-dct-rule.discnt-role = 'def-cash-pcnt':U
     1465           or
     1466           buf_dis-dct-rule.discnt-role = 'def-categ':U) then do:
     1467         IF buf_dis-dct-rule.host-code = 0
     1468         AND buf_dis-dct-rule.obj-type = '':U
     1469         AND buf_dis-dct-rule.obj-code = 0 THEN DO:
     1470           FIND FIRST buf_dis-rule NO-LOCK WHERE
     1471                     buf_dis-rule.rule-num = buf_dis-dct-rule.rule-num NO-ERROR.
     1472           IF AVAILABLE buf_Dis-rule THEN DO:
     1473             CASE buf_dis-dct-rule.discnt-role:
     1474               WHEN 'def-pcnt':U THEN DO:
     1475                   f-dflt-pcnt = buf_Dis-rule.discnt-value.
     1476               END.
     1477                 WHEN 'def-cash-pcnt':U THEN DO:
     1478                   f-dflt-cash-pcnt = buf_Dis-rule.discnt-value.
     1479                 END.
     1480                 WHEN 'def-categ':U THEN DO:
     1481                   f-dflt-pcnt-kat = buf_Dis-rule.dis-kat.
     1482                 END.
     1483             END CASE.
     1484           END.
     1485         END.
     1486       end.
     1487       release tt0-dis-dct-rule.
     1488     END.
     1489     FOR EACH buf_rp-by-call NO-LOCK WHERE
     1490              buf_rp-by-call.call_id = temp-dc-type.uniq-key-rec
     1491       on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1492       on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1493       on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1494       :
     1495       CREATE tt0-rp-by-call.
     1496       BUFFER-COPY buf_rp-by-call TO tt0-rp-by-call.
     1497     END.
     1498     FOR EACH buf_rule-by-call  NO-LOCK WHERE
     1499               buf_rule-by-call.call_id = temp-dc-type.uniq-key-rec
     1500     on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1501     on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1502     on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1503     :
     1504       CREATE tt0-rule-by-call.
     1505       BUFFER-COPY buf_rule-by-call TO tt0-rule-by-call.
     1506       FOR EACH buf_rule-call-param NO-LOCK WHERE
     1507             buf_rule-call-param.codex_id = tt0-rule-by-call.codex_id
     1508         AND buf_rule-call-param.ruleset_id = tt0-rule-by-call.ruleset_id
     1509         AND buf_rule-call-param.call_id = tt0-rule-by-call.call_id
     1510         AND buf_rule-call-param.order_id = tt0-rule-by-call.order_id
     1511       on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1512       on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1513       on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1514       :
     1515         CREATE tt0-rule-call-param.
     1516         BUFFER-COPY buf_rule-call-param TO tt0-rule-call-param.
     1517       END.
     1518     END.
     1519   END.
     1520   IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     1521     FOR EACH buf_rule-profile NO-LOCK WHERE
     1522               buf_rule-profile.profile-type = 'dis-card-type':U
     1523          AND buf_rule-profile.IS_dynamic = no
     1524       on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1525       on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1526       on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1527       :
     1528       run dc-typei_proc-b-addalgo in this-procedure (  input p-silent
     1529                                                       ,input yes
     1530                                                       ,buffer buf_rule-profile) no-error .
     1531       if error-status:error then do:
     1532         undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1533       end.
     1534     END.
     1535     _rule-profile:
     1536     FOR EACH buf_rule-profile NO-LOCK WHERE
     1537               buf_rule-profile.profile-type = 'dis-card-type':U
     1538          AND buf_rule-profile.IS_dynamic = ?
     1539       on error  undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1540       on stop   undo fill-block, return error substitute( "&1. stop", vss-workfile )
     1541       on endkey undo fill-block, return error substitute( "&1. endkey", vss-workfile )
     1542       :
     1543       if buf_rule-profile.param-code <> '':U then do:
     1544         define variable v-par-val as character no-undo .
     1545         define variable v-par-type as character no-undo .
     1546         if buf_rule-profile.param-code = 'sys-key' then do:
     1547   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     1548   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     1549     (output v-par-val
     1550     ) no-error .
     1551           if error-status:error then do:
     1552             message
     1553             substitute("Ошибка при определении значения конфигурационного параметра &1,&2" +
     1554                         "который должен быть включен для работы профайла &3"
     1555                         ,buf_rule-profile.param-code
     1556                         ,chr(10)
     1557                         ,buf_rule-profile.profile_id)
     1558             view-as alert-box error .
     1559             next.
     1560           end.
     1561         end.
     1562         else do:
     1563   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1564     (input  buf_rule-profile.param-code
     1565     ,input  ''
     1566     ,input  ''
     1567     ,input  0
     1568     ,input  ''
     1569     ,input  ''
     1570     ,input  ''
     1571     ,input  no
     1572     ,output v-par-val
     1573     ,output v-par-type
     1574     ) no-error .
     1575           if error-status:error then do:
     1576             message
     1577             substitute("Ошибка при определении значения конфигурационного параметра &1,&2" +
     1578                         "который должен быть включен для работы профайла &3"
     1579                         ,buf_rule-profile.param-code
     1580                         ,chr(10)
     1581                         ,buf_rule-profile.profile_id)
     1582             view-as alert-box error .
     1583             next.
     1584           end.
     1585         end.
     1586         if lookup(v-par-val, buf_rule-profile.param-value, chr(4)) = 0
     1587         and not (buf_rule-profile.param-code = 'sys-key'
     1588                   and
     1589                   v-par-val = 'IBS')
     1590         then do:
     1591           next _rule-profile.
     1592         end.
     1593         if buf_rule-profile.param-code = 'sys-key'
     1594         and v-par-val = 'IBS' then next _rule-profile.
     1595       end.
     1596       run dc-typei_proc-b-addalgo in this-procedure (  input p-silent
     1597                                              ,input yes
     1598                                              ,buffer buf_rule-profile) no-error .
     1599       if error-status:error then do:
     1600         undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1601       end.
     1602     END.
     1603     run fill-tt0-hist-nws-option in this-procedure ( input 0
     1604                                                     ,input ''
     1605                                                     ) no-error .
     1606     if error-status:error then do:
     1607       undo fill-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     1608     end.
     1609   END.
     1610   end.
     1611   END PROCEDURE.
     1612   procedure dc-typei_proc-b-addalgo :
     1613   define input  parameter p-silent as logical   no-undo .
     1614   define input  parameter p-start as logical   no-undo .
     1615   DEFINE PARAMETER BUFFER buf_rule-profile FOR ub.rule-profile.
     1616   DEFINE VARIABLE v-order-id AS INTEGER NO-UNDO.
     1617   define variable v-rule-uniq-key-rec as character no-undo .
     1618   define variable v-dcta-uniq-key-rec as character no-undo .
     1619   define variable v-found-params as logical no-undo .
     1620   define variable v-found-can-calc as logical no-undo .
     1621   define variable v-disabled as logical no-undo .
     1622   define variable glog as logical no-undo .
     1623   define variable v-once-more as integer no-undo .
     1624   define variable v-par-val as character no-undo .
     1625   define variable v-par-type as character no-undo .
     1626   define variable v-rule-profile-uniq-key-rec as character no-undo .
     1627   DEFINE BUFFER buf_tt0-rp-by-call FOR tt0-rp-by-call.
     1628   DEFINE BUFFER buf_rule-by-profile FOR ub.rule-by-profile.
     1629   DEFINE BUFFER buf_rule FOR ub.RULE.
     1630   DEFINE BUFFER buf_tt0-rule-by-call FOR tt0-rule-by-call.
     1631   define buffer buf_ruledict for ub.ruledict.
     1632   define buffer buf_ruledict2 for ub.ruledict.
     1633   define buffer buf_tt0-rule-call-param for tt0-rule-call-param.
     1634   define buffer buf_ruledict-param for ub.ruledict-param.
     1635   define buffer buf_ruledict-param2 for ub.ruledict-param.
     1636   define buffer buf_rp-rule-param for ub.rp-rule-param.
     1637   main-block:
     1638   do
     1639   on error undo, return error return-value
     1640   :
     1641   FIND LAST buf_tt0-rp-by-call NO-LOCK WHERE
     1642             buf_tt0-rp-by-call.call_id = temp-dc-type.uniq-key-rec
     1643         AND buf_tt0-rp-by-call.profile_id = buf_rule-profile.profile_id NO-ERROR.
     1644   IF AVAILABLE buf_tt0-rp-by-call THEN DO:
     1645     v-once-more = buf_tt0-rp-by-call.once-more.
     1646     if buf_rule-profile.is_dynamic = no
     1647     or buf_rule-profile.reusable-params = '-':U
     1648     then do:
     1649      RETURN ERROR substitute("алгоритм &1 уже подключен к данному типу ДК", buf_rule-profile.is_dynamic).
     1650     end.
     1651     v-disabled = yes.
     1652     for each buf_rule-by-profile no-lock where
     1653            buf_rule-by-profile.profile_id = buf_rule-profile.profile_id,
     1654        first buf_rule no-lock where
     1655             buf_rule.rule_id = buf_rule-by-profile.rule_id:
     1656        v-disabled = v-disabled and (buf_rule.reusable-params = "-":U).
     1657     end.
     1658     if v-disabled then do:
     1659       RETURN ERROR substitute( "Алгоритм &1 уже подключен к типу ДК &2&3" +
     1660                                "В нем нет ни одного правила, которое можно выполнить повторно"
     1661                                , buf_rule-profile.is_dynamic
     1662                                , temp-dc-type.type
     1663                                , chr(10)
     1664                                ).
     1665     end.
     1666     else do:
     1667       if not p-silent then do:
     1668         MESSAGE
     1669         "Данный алгоритм уже подключен к данному типу ДК" skip
     1670         "Выполнение привязанных к нему правил повторно возможно только при указании соответствущих значений параметров" skip
     1671         "Все равно подключить алгоритм"
     1672         VIEW-AS ALERT-BOX question buttons YES-NO update glog.
     1673         if not glog then    RETURN ERROR.
     1674       end.
     1675       else do:
     1676         return error substitute("Алгоритм &1 уже подключен к типу ДК &2&3"  +
     1677                                 "Выполнение привязанных к нему правил повторно возможно только при указании соответствущих значений параметров"
     1678                                 ,buf_rule-profile.is_dynamic
     1679                                 ,temp-dc-type.type
     1680                                 , chr(10)
     1681                                 ).
     1682       end.
     1683     end.
     1684     if buf_rule-profile.param-code <> '':U then do:
     1685   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1686     (input  buf_rule-profile.param-code
     1687     ,input  ''
     1688     ,input  ''
     1689     ,input  0
     1690     ,input  ''
     1691     ,input  ''
     1692     ,input  ''
     1693     ,input  no
     1694     ,output v-par-val
     1695     ,output v-par-type
     1696     ) no-error .
     1697       if error-status:error then do:
     1698         undo main-block, return error
     1699         substitute("Ошибка при определении значения конфигурационного параметра &1,&2" +
     1700                     "который должен быть включен для работы профайла &3"
     1701                     ,buf_rule-profile.param-code
     1702                     ,chr(10)
     1703                     ,buf_rule-profile.profile_id).
     1704       end.
     1705       if lookup(v-par-val, buf_rule-profile.param-value, chr(4)) = 0 then do:
     1706         undo main-block, return error
     1707         substitute("Значения конфигурационного параметра &1=&2,&3" +
     1708                     "что не удовлетворяет условиям работы профайла &4"
     1709                     ,buf_rule-profile.param-code
     1710                     ,v-par-val
     1711                     ,chr(10)
     1712                     ,buf_rule-profile.profile_id).
     1713       end.
     1714     end.
     1715   END.
     1716   define variable v-ps as character no-undo .
     1717   if not p-silent then do:
     1718     run gbl/d-prompt.w (
     1719       'title=':u + "Комментарий к привязке" + '\':u
     1720     + 'text1=':u + "Вы можете добавить поясняющий комментарий"  + '\':u
     1721     + 'format=' + "X(256)" + '\':u
     1722     + 'type=' + 'EDIT' + '\':u
     1723     + 'fillin_row=2\':u
     1724     + 'fillin_col=4\':u
     1725     + 'fillin_width=70\':u
     1726     + 'fillin_height=4\':u
     1727     + 'max-chars=280\':u
     1728     + 'readonly=no' +  '\':u
     1729     , input-output v-ps
     1730         ).
     1731   end.
     1732   CREATE buf_tt0-rp-by-call.
     1733   BUFFER-COPY buf_rule-profile TO buf_tt0-rp-by-call
     1734   ASSIGN
     1735   buf_tt0-rp-by-call.CALL_id = temp-dc-type.uniq-key-rec
     1736   buf_tt0-rp-by-call.once-more = v-once-more + 1
     1737   buf_tt0-rp-by-call.ps = v-ps
     1738   .
     1739   for each tt2-rule-call-param:
     1740     delete tt2-rule-call-param.
     1741   end.
     1742   _rule-by-profile:
     1743   FOR EACH buf_rule-by-profile NO-LOCK WHERE
     1744           buf_rule-by-profile.profile_id = buf_tt0-rp-by-call.profile_id
     1745   BY buf_rule-by-profile.profile_id
     1746   BY buf_rule-by-profile.codex_id
     1747   BY buf_rule-by-profile.ruleset_id
     1748   BY buf_rule-by-profile.rp_order_id
     1749   ON error undo, return error :
     1750    FIND FIRST buf_rule NO-LOCK WHERE
     1751                   buf_rule.RULE_id = buf_rule-by-profile.RULE_id NO-ERROR.
     1752    IF NOT AVAILABLE buf_rule THEN DO:
     1753      undo main-block, return error
     1754      SUBSTITUTE("Не найдено правило &1, которое должно быть подключено по алгоритму &2&3" +
     1755                      "кодекс правил &4, свод правил &5"
     1756                      , buf_rule-by-profile.RULE_id
     1757                      , buf_rule-by-profile.profile_id
     1758                      , chr(10)
     1759                      , buf_rule-by-profile.codex_id
     1760                      , buf_rule-by-profile.ruleset_id).
     1761    END.
     1762     FIND LAST buf_tt0-rule-by-call WHERE
     1763               buf_tt0-rule-by-call.codex_id =  buf_rule-by-profile.codex_id
     1764           AND buf_tt0-rule-by-call.ruleset_id = buf_rule-by-profile.ruleset_id
     1765     USE-INDEX imain NO-ERROR.
     1766     IF AVAILABLE buf_tt0-rule-by-call THEN DO:
     1767        v-order-id = buf_tt0-rule-by-call.order_id + 1.
     1768     END.
     1769     ELSE DO:
     1770        v-order-id = 0.
     1771     END.
     1772     CREATE buf_tt0-rule-by-call.
     1773     BUFFER-COPY buf_rule-by-profile TO buf_tt0-rule-by-call
     1774     ASSIGN
     1775     buf_tt0-rule-by-call.order_id = v-order-id
     1776     buf_tt0-rule-by-call.algo-des = substitute("Профайл &1. &2", buf_rule-profile.profile_id, buf_rule.NAME)
     1777     buf_tt0-rule-by-call.is_dynamic = buf_rule-by-profile.IS_dynamic
     1778     buf_tt0-rule-by-call.can-calc = (IF buf_tt0-rule-by-call.is_dynamic
     1779                                        THEN buf_rule-by-profile.dflt-can-calc
     1780                                        ELSE YES)
     1781     buf_tt0-rule-by-call.call_id = temp-dc-type.uniq-key-rec
     1782     buf_tt0-rule-by-call.once-more = v-once-more + 1
     1783     v-found-can-calc = v-found-can-calc or buf_tt0-rule-by-call.can-calc
     1784     .
     1785     find first buf_ruledict no-lock where
     1786             buf_ruledict.entry-type = 'rule':U
     1787         and  buf_ruledict.uniq-key-rec = buf_rule.uniq-key-rec.
     1788     run gen-key-rec in this-procedure (
     1789                                        input  'rule-profile':U
     1790                                       ,input buffer buf_rule-profile:handle
     1791                                       ,output v-rule-profile-uniq-key-rec).
     1792     find first buf_ruledict2 no-lock where
     1793             buf_ruledict2.entry-type = 'rule-profile':U
     1794         and  buf_ruledict2.uniq-key-rec = v-rule-profile-uniq-key-rec.
     1795     for each buf_ruledict-param no-lock where
     1796             buf_ruledict-param.entry-id = buf_ruledict.entry-id
     1797     on error undo, return error:
     1798     find first buf_rp-rule-param no-lock where
     1799               buf_rp-rule-param.profile_id = buf_rule-profile.profile_id
     1800           and buf_rp-rule-param.rule-param-name = buf_ruledict-param.param-name
     1801           and buf_rp-rule-param.codex_id = buf_rule-by-profile.codex_id
     1802           and buf_rp-rule-param.ruleset_id = buf_rule-by-profile.ruleset_id
     1803           and buf_rp-rule-param.rule_id = buf_rule-by-profile.rule_id
     1804           and buf_rp-rule-param.rp_order_id = buf_rule-by-profile.rp_order_id.
     1805       find first buf_ruledict-param2 no-lock where
     1806             buf_ruledict-param2.entry-id = buf_ruledict2.entry-id
     1807         and buf_ruledict-param2.param-name = buf_rp-rule-param.rp-param-name.
     1808       create buf_tt0-rule-call-param.
     1809       assign
     1810       buf_tt0-rule-call-param.codex_id = buf_tt0-rule-by-call.codex_id
     1811       buf_tt0-rule-call-param.ruleset_id = buf_tt0-rule-by-call.ruleset_id
     1812       buf_tt0-rule-call-param.call_id  = buf_tt0-rule-by-call.call_id
     1813       buf_tt0-rule-call-param.order_id = buf_tt0-rule-by-call.order_id
     1814       buf_tt0-rule-call-param.rule_id = buf_rule.rule_id
     1815       buf_tt0-rule-call-param.param-name = buf_ruledict-param.param-name
     1816       buf_tt0-rule-call-param.p-index = 0
     1817       buf_tt0-rule-call-param.param-des = buf_ruledict-param.documentation
     1818       buf_tt0-rule-call-param.param-num = buf_ruledict-param.param-num
     1819       buf_tt0-rule-call-param.param-label = buf_ruledict-param.param-label
     1820       buf_tt0-rule-call-param.param-mode = buf_ruledict-param.param-mode
     1821       buf_tt0-rule-call-param.param-data-type = buf_ruledict-param.param-data-type
     1822       buf_tt0-rule-call-param.param-2-data-type = buf_ruledict-param.param-2-data-type
     1823       buf_tt0-rule-call-param.param-3-data-type = buf_ruledict-param.param-3-data-type
     1824       buf_tt0-rule-call-param.param-value-character = buf_ruledict-param2.init-value-character
     1825       buf_tt0-rule-call-param.param-value-date = buf_ruledict-param2.init-value-date
     1826       buf_tt0-rule-call-param.param-value-decimal = buf_ruledict-param2.init-value-decimal
     1827       buf_tt0-rule-call-param.param-value-integer = buf_ruledict-param2.init-value-integer
     1828       buf_tt0-rule-call-param.param-value-logical = buf_ruledict-param2.init-value-logical
     1829       buf_tt0-rule-call-param.profile_id          = buf_tt0-rule-by-call.profile_id
     1830       buf_tt0-rule-call-param.once-more           = buf_tt0-rule-by-call.once-more
     1831       .
     1832       if buf_ruledict-param.param-2-data-type = "r-b" then do:
     1833         buf_tt0-rule-call-param.param-value-character = (if v-curr-r-b = 'rubl':U
     1834                                                          then 'rubl':U
     1835                                                          else 'base':U).
     1836       end.
     1837       assign
     1838       v-found-params = yes.
     1839       create tt2-rule-call-param.
     1840       buffer-copy buf_tt0-rule-call-param to tt2-rule-call-param.
     1841       release tt2-rule-call-param.
     1842     end.
     1843   END.
     1844   if v-found-params
     1845   and v-found-can-calc = yes
     1846   and not p-start
     1847   and not p-silent
     1848   then do:
     1849    define variable v-param-form as character no-undo .
     1850     assign
     1851     v-param-form = (if buf_rule-profile.custom-param-form > 0
     1852                     then  substitute("rul/rcps-&1.w", buf_rule-profile.profile_id)
     1853                     else "ref/rulercps.w")
     1854     .
     1855     run value(v-param-form) (
     1856                          input parparentproc
     1857                         ,input this-procedure:handle
     1858                         ,input "b-chg":U
     1859                         ,input 'ДОБАВЛЕНИЕ':U
     1860                         ,input 'rp-rule-param':U
     1861                         ,input buf_tt0-rp-by-call.profile_id
     1862                         ,input buf_tt0-rp-by-call.once-more
     1863                         ,input buf_tt0-rp-by-call.call_id
     1864                         ,input 0
     1865                         ,input 0
     1866                         ,INPUT 0
     1867                         ,input 0
     1868                         ,INput substitute("алгоритм &1 &2"
     1869                                          , buf_rule-profile.name
     1870                                          , calldscr(buf_tt0-rp-by-call.call_id)
     1871                                          )
     1872                         ,input-output table tt2-rule-call-param) no-error.
     1873     if not error-status:error then do:
     1874       for each tt2-rule-call-param
     1875       on error undo, return error:
     1876         find first buf_tt0-rule-call-param where
     1877                   buf_tt0-rule-call-param.call_id = tt2-rule-call-param.call_id
     1878               and buf_tt0-rule-call-param.codex_id = tt2-rule-call-param.codex_id
     1879               and buf_tt0-rule-call-param.ruleset_id = tt2-rule-call-param.ruleset_id
     1880               and buf_tt0-rule-call-param.order_id = tt2-rule-call-param.order_id
     1881               and buf_tt0-rule-call-param.param-name = tt2-rule-call-param.param-name
     1882               and buf_tt0-rule-call-param.p-index = tt2-rule-call-param.p-index no-error .
     1883         if not available buf_tt0-rule-call-param
     1884         and lookup("LIST", tt2-rule-call-param.param-3-data-type) > 0
     1885         then do:
     1886           create buf_tt0-rule-call-param.
     1887         end.
     1888         buffer-copy tt2-rule-call-param to buf_tt0-rule-call-param.
     1889         delete tt2-rule-call-param.
     1890       end.
     1891     end.
     1892   end.
     1893   end.
     1894   end procedure.
     1895   define variable add-option as character no-undo.
     1896   DEFINE VARIABLE v-mode AS CHARACTER NO-UNDO EXTENT 3.
     1897   DEFINE VARIABLE rule-display-option AS CHARACTER NO-UNDO.
     1898   define variable v-start as logical no-undo .
