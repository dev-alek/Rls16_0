      365   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile: frmlib.i $ $Revision: aea5316774be, 0, rls $".
      366   FUNCTION Break-n-line RETURNS CHARACTER
      367     ( INPUT p-ost as char,
      368       INPUT p-lengths  as character,
      369       OUTPUT output-num-lines as integer
      370       ) :
      371   define variable ii as integer no-undo.
      372   define variable jj as integer no-undo.
      373   define variable linei as character no-undo extent 10.
      374   define variable line-length as integer no-undo extent 10.
      375   define variable num-line as integer no-undo .
      376   define variable v-line as character no-undo .
      377   do ii = 1 to MIN(num-entries(p-lengths), 10):
      378     assign
      379     line-length[ii] = integer(entry(ii, p-lengths))
      380     num-line = ii
      381     .
      382   end.
      383   do jj = 1 to num-line:
      384     if Length ( p-ost ) <= line-length[jj] then do:
      385       assign
      386       output-num-lines = jj
      387       v-line = v-line + (if jj = 1 then "":U else chr(4)) + p-ost
      388       .
      389       return v-line.
      390     end.
      391     assign
      392     ii = 1
      393     .
      394     if length( entry( ii, p-ost , chr(32)) ) > line-length[jj]
      395     then do:
      396       assign
      397       linei[jj] = substr( p-ost , 1 , line-length[jj] )
      398       p-ost = trim( substr( p-ost , line-length[jj] + 1 ) )
      399       .
      400     end.
      401     else do:
      402       DO WHILE length( linei[jj] + entry( ii, p-ost , chr(32)) ) < ( line-length[jj] + 1 ) :
      403         assign
      404         linei[jj] = linei[jj] + entry( ii, p-ost , chr(32)) + chr(32)
      405         ii = ii + 1
      406         .
      407         if length( entry( ii, p-ost, chr(32) ) ) > line-length[jj] then
      408         assign
      409         linei[jj] = linei[jj] + substr( p-ost , length( linei[jj] ) , line-length[jj] - length( linei[jj] ) + 1 )
      410         .
      411       END.
      412       assign
      413       p-ost = trim( substr( p-ost , length(linei[jj]) + 1  ))
      414       .
      415     end.
      416     assign
      417     v-line = v-line + (if jj = 1 then "":U else chr(4)) + linei[jj]
      418     .
      419     if p-ost = "":U then LEAVE.
      420   end.
      421   assign
      422   output-num-lines = jj.
      423   RETURN v-line.
      424   END FUNCTION.
      425   FUNCTION Center-Field RETURNS CHARACTER
      426     ( INPUT p-str as char,
      427       INPUT p-format as integer,
      428       INPUT p-Length as integer,
      429       INPUT p-fill as character
      430       ) :
      431   define variable v-str as character no-undo .
      432   define variable v-left as integer no-undo .
      433   define variable v-dop as integer no-undo .
      434   assign
      435   p-str = trim(p-str)
      436   .
      437   if p-str = "":U then return fill(p-fill, p-length).
      438   if length(p-str) >= p-format then
      439   p-str = substr(p-str, 1, p-format).
      440   else do:
      441     p-format = length(p-str).
      442   end.
      443   if p-format < p-length then do:
      444     assign
      445     v-left = (p-length - p-format )
      446     v-dop = (if v-left modulo 2 = 1
      447              then 1
      448              else 0)
      449     v-left = (if (v-left modulo 2 = 1)
      450              then (v-left - 1 ) / 2
      451              else v-left / 2)
      452     v-str =  fill(p-fill, v-left) +
      453              string(p-str, "X(":U + string(p-format) + ")":U) +
      454              fill(p-fill, v-left) + fill(p-fill, v-dop)
      455     .
      456     return v-str.
      457   end.
      458   else do:
      459     return string(p-str, "X(":U + string(p-length) + ")":U).
      460   end.
      461   END FUNCTION.
      462   FUNCTION Left-Field RETURNS CHARACTER
      463     ( INPUT p-str as char,
      464       INPUT p-format as integer,
      465       INPUT p-Length as integer,
      466       INPUT p-fill as character
      467       ) :
      468   define variable v-str as character no-undo .
      469   define variable v-left as integer no-undo .
      470   define variable v-dop as integer no-undo .
      471   assign
      472   p-str = trim(p-str)
      473   .
      474   if p-str = "":U then return fill(p-fill, p-length).
      475   if length(p-str) >= p-format then
      476   p-str = substr(p-str, 1, p-format).
      477   else do:
      478     p-format = length(p-str).
      479   end.
      480   if p-format < p-length then do:
      481     assign
      482     v-dop =  p-length - p-format
      483     v-str =  string(p-str, "X(":U + string(p-format) + ")":U) +
      484              fill(p-fill, v-dop)
      485     .
      486     return v-str.
      487   end.
      488   else do:
      489     return string(p-str, "X(":U + string(p-length) + ")":U).
      490   end.
      491   END FUNCTION.
      492   FUNCTION Sum-Rub-Kop-Digit RETURNS CHARACTER
      493     ( INPUT p-sum as decimal,
      494       INPUT p-rub-length as integer,
      495       INPUT p-kop-length as integer,
      496       INPUT p-fill as character,
      497       INPUT p-razr-delim as character,
      498       INPUT p-rub-str  as character,
      499       INPUT p-kop-str  as character
      500       ) :
      501   define variable v-str as character no-undo .
      502   define variable v-format as character no-undo .
      503   define variable v-dopi as integer no-undo .
      504   define variable v-dopi2 as integer no-undo .
      505   assign
      506   v-dopi = length(string(truncate(ABS(p-sum), 0)))
      507   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
      508   .
      509   if v-dopi > p-rub-length or p-kop-length < 2 then return "?".
      510   assign
      511   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9":U
      512   v-dopi = length(trim(string(truncate(p-sum, 0), v-format)))
      513   .
      514   assign
      515   v-str = fill(p-fill, p-rub-length - v-dopi) +
      516           string(truncate(p-sum, 0), v-format) +
      517           p-rub-str +
      518           fill(p-fill, p-kop-length - 2) +
      519           string(truncate((ABS(p-sum) - ABS(truncate(p-sum, 0))), 2) * 100, "99":U) + p-kop-str
      520   .
      521   return v-str.
      522   END FUNCTION.
      523   FUNCTION Sum-Invalut-Digit RETURNS CHARACTER
      524     ( INPUT p-sum as decimal,
      525       INPUT p-sum-length as integer,
      526       INPUT p-curr-code as integer,
      527       INPUT p-fill as character,
      528       INPUT p-razr-delim as character
      529       ) :
      530   define variable v-str as character no-undo .
      531   define variable v-format as character no-undo .
      532   define variable v-dopi as integer no-undo .
      533   define variable v-dopi2 as integer no-undo .
      534   define variable v-curr-name as character no-undo .
      535   define buffer buf_currency for ub.currency.
      536   find first buf_currency no-lock where
      537             buf_currency.curr-code = p-curr-code no-error .
      538   if not avail buf_currency
      539   then v-curr-name = "неизвестная валюта".
      540   else
      541   assign
      542   v-curr-name = buf_currency.curr-name
      543   .
      544   assign
      545   v-dopi = length(string(truncate(ABS(p-sum), 0)))
      546   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
      547   .
      548   if v-dopi > p-sum-length then return "?".
      549   assign
      550   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9.99":U
      551   v-dopi = length(trim(string(p-sum, v-format)))
      552   .
      553   assign
      554   v-str = "(":U + chr(32) + v-curr-name +  chr(32) + ")":U +
      555           fill(p-fill, p-sum-length - v-dopi - length(v-curr-name) - 4)  +
      556           trim(string(p-sum, v-format))
      557   .
      558   return v-str.
      559   END FUNCTION.
      560   FUNCTION Sum-in-Words-Without-Dec RETURNS CHARACTER
      561   (input v-sum as decimal
      562   ):
      563   define variable v-str as character no-undo .
      564   run gbl/num-rus.p ( input absolute( v-sum ) , output v-str).
      565   v-str = trim( caps( substring( v-str, 1, 1 ) ) ) + substring( v-str, 2 ).
      566   return v-str.
      567   END FUNCTION.
      568   FUNCTION Sum-in-Words-Invalut RETURNS CHARACTER
      569   (input p-sum as decimal
      570    ,input p-curr-code as integer
      571   ):
      572   define variable v-str as character no-undo .
      573   define variable Copeck as character no-undo.
      574   define variable Rouble as character no-undo.
      575   define variable v-Word as character no-undo.
      576   define variable ii as integer init 18 no-undo.
      577   define variable v-str-rubl as character no-undo .
      578   define variable v-kop as integer no-undo .
      579   define buffer buf_currency for ub.currency.
      580   assign
      581   v-Word = string( absolute( p-sum ) , "999999999999999.99" ).
      582   find first buf_currency no-lock where
      583             buf_currency.curr-code = p-curr-code no-error .
      584   if not available buf_currency then return chr(63).
      585   if decimal( substring(v-Word,1,ii - 3) ) <> 0 then do:
      586     CASE substring(v-Word, ii - 3,1):
      587       WHEN "1" THEN DO:
      588         if substring(v-Word, ii - 4,1) = "1" then
      589             Rouble = buf_currency.curr-name-five .
      590         else
      591             Rouble = buf_currency.curr-name-one .
      592       END.
      593       WHEN "2" OR WHEN "3" OR WHEN "4" THEN  DO:
      594         if substring(v-Word, ii - 4,1) = "1" then
      595            Rouble = buf_currency.curr-name-five .
      596            else
      597            Rouble = buf_currency.curr-name-three .
      598         END.
      599       WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN  DO:
      600          Rouble = buf_currency.curr-name-five .
      601       END.
      602     END CASE.
      603   end.
      604   CASE substring(v-Word, ii, 1):
      605     WHEN "1" THEN DO:
      606       if substring(v-Word, ii - 1, 1) = "1" then
      607           Copeck = buf_currency.part-name-five .
      608       else
      609           Copeck = buf_currency.part-name-one .
      610     END.
      611     WHEN "2" OR WHEN "3" OR WHEN "4" THEN DO:
      612       if substring(v-Word, ii - 1, 1) = "1" then
      613           Copeck = buf_currency.part-name-five .
      614       else
      615           Copeck = buf_currency.part-name-three .
      616     END.
      617     WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN DO:
      618       Copeck = buf_currency.part-name-five .
      619     END.
      620   END CASE.
      621   run gbl/num-rus.p ( input absolute( p-sum )
      622                , output v-str-rubl).
      623   assign
      624   v-kop = (absolute( p-sum ) - truncate(absolute(p-sum), 0)
      625           ) * 100
      626   .
      627   v-str = ( if p-Sum < 0 then "- " else "" ) +
      628               caps(substring(v-str-rubl, 1, 1)) +  substring(v-str-rubl, 2) + chr(32) + Rouble + chr(32) +
      629               string(v-kop, "99":U) + chr(32) + Copeck .
      630   return v-str.
      631   END FUNCTION.
      632   FUNCTION Sum-delim-with-defis RETURNS CHARACTER
      633   (input v-sum as decimal,
      634   input v-razr as integer
      635   ):
      636   define variable v-str as character no-undo .
      637   define variable v-dec-separ as character no-undo .
      638   case SESSION:NUMERIC-FORMAT:
      639     when "American":U then do:
      640       assign
      641       v-dec-separ = ".":U
      642       .
      643     end.
      644     when "European":U then do:
      645       assign
      646       v-dec-separ = ",":U
      647       .
      648     end.
      649   END CASE.
      650   assign
      651   v-str = replace(string(v-sum, fill(">":U, v-razr - 1) + "9.99"), v-dec-separ, "-":U)
      652   .
      653   return v-str.
      654   END FUNCTION.
      655   FUNCTION MonthNameRusGen RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
      656     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
      657     RUN get-month-name-gen IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
      658     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
      659   END FUNCTION.
      660   PROCEDURE get-month-name-gen :
      661     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
      662     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
      663     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Января,Февраля,Марта,Апреля,Мая,Июня,Июля,Августа,Сентября,Октября,Ноября,Декабря".
      664     DO ON ERROR UNDO, RETURN ERROR :
      665       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
      666     END.
      667   END PROCEDURE.
      668   DEFINE TEMP-TABLE temp-widget
      669   FIELD NAME_ AS CHARACTER
      670   FIELD LENGTH_ AS DECIMAL
      671   FIELD index_ AS INTEGER
      672   FIELD HANDLE_ AS HANDLE
      673   FIELD format_ AS CHARACTER
      674   FIELD width_ AS DECIMAL
      675   INDEX pi IS UNIQUE PRIMARY
      676   NAME_
      677   INDEX iindex
      678   INDEX_.
      679   DEFINE VARIABLE v-struct AS CHARACTER NO-UNDO.
      680   DEFINE BUTTON B-exit AUTO-GO
      681        LABEL "&Ввод"
      682        SIZE 10 BY 1
      683        BGCOLOR 8 .
      684   DEFINE BUTTON B-Help
      685        LABEL "Помо&щь"
      686        SIZE 3 BY 1
      687        BGCOLOR 8 .
      688   DEFINE BUTTON b-quit AUTO-END-KEY
      689        LABEL "&Отмена"
      690        SIZE 10 BY 1
      691        BGCOLOR 8 .
      692   DEFINE VARIABLE e-struct AS CHARACTER
      693        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      694        SIZE 72 BY 3.2 NO-UNDO.
      695   DEFINE FRAME Dialog-Frame
      696        B-exit AT ROW 1 COL 1
      697        b-quit AT ROW 1 COL 11
      698        B-Help AT ROW 1 COL 95
      699        e-struct AT ROW 2 COL 28 NO-LABEL WIDGET-ID 2
      700        "(текст из карточки товара)" VIEW-AS TEXT
      701             SIZE 26 BY 1.07 AT ROW 3.13 COL 1 WIDGET-ID 6
      702             FGCOLOR 12
      703        "Состав сырья" VIEW-AS TEXT
      704             SIZE 13 BY 1.07 AT ROW 2.07 COL 1 WIDGET-ID 4
      705        SPACE(85.70) SKIP(20.08)
      706       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      707            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      708            TITLE "Тескт поля СОСТАВ СЫРЬЯ - формат поля"
      709            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      710   ASSIGN
      711          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      712          FRAME Dialog-Frame:HIDDEN           = TRUE.
      713   ASSIGN
      714          e-struct:RETURN-INSERTED IN FRAME Dialog-Frame  = TRUE
      715          e-struct:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      716   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      717   DO:
      718     APPLY "END-ERROR":U TO SELF.
      719   END.
      720   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      721   DO:
      722     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      723     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      724   END.
      725   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      726   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      727   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      728   on help of frame Dialog-Frame
      729   do:
      730     run gbl/app_help.p
      731       (input this-procedure :file-name
      732       ,input ''
      733       ,input ?
      734       ) no-error.
      735     if error-status :error then do:
      736       message
      737         "Ошибка при вызове помощи"
      738         error-status :get-message(1)
      739         view-as alert-box .
      740     end.
      741   end.
      742   run minbtn-set in this-procedure .
      743   on choose of b-help in frame Dialog-Frame
      744   do:
      745     apply "help":u to frame Dialog-Frame .
      746   end.
      747   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      748   procedure minbtn-set :
      749       do
      750           on error undo, return error return-value
      751           :
      752           define variable ii              as integer       no-undo .
      753           define variable fh              as widget-handle no-undo .
      754           define variable hh              as widget-handle no-undo .
      755           define variable v-h             as handle        extent 4 no-undo .
      756           define variable v-name-button   as character     no-undo .
      757           define variable v-help-old-x    as decimal       no-undo .
      758           define variable v-help-old-y    as decimal       no-undo .
      759           define variable v-help-old-size as decimal       no-undo .
      760           define variable v-frame-width   as decimal       no-undo .
      761           define variable jj              as integer       no-undo .
      762           do
      763               on error undo, return error
      764               :
      765               assign
      766                   v-frame-width = frame Dialog-Frame:width - 0.3
      767                   fh            = frame Dialog-Frame:first-child
      768                   hh            = fh:first-child
      769                   ii            = 1
      770                   .
      771               do while valid-handle(hh):
      772                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      773                   do:
      774                       case lc(hh:name) :
      775                           when "b-help" then
      776                               do:
      777                                   hh:load-image-up("cmp/b-help.bmp":u) .
      778                                   hh:load-image-down("cmp/b-help.bmp":u) .
      779                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      780                                   hh:TOOLTIP = "Помощь" .
      781                                   v-help-old-x = hh:column .
      782                                   v-help-old-y = hh:row    .
      783                                   v-help-old-size = hh:width .
      784                                   hh:width-chars = 2.5 .
      785                               end.
      786                           when "b-print" then
      787                               do:
      788                                   hh:load-image("cmp/b-print.bmp":u) .
      789                                   hh:TOOLTIP = "Печать" .
      790                                   v-h[ii] = hh:handle .
      791                                   ii = ii + 1 .
      792                                   hh:width-chars = 3 .
      793                               end.
      794                           when "b-history" or
      795                           when "b-hist" then
      796                               do:
      797                                   hh:load-image("cmp/b-hist.bmp":u) .
      798                                   hh:TOOLTIP = "История" .
      799                                   v-h[ii] = hh:handle .
      800                                   ii = ii + 1 .
      801                                   hh:width-chars = 3 .
      802                               end.
      803                           when "b-sch" then
      804                               do:
      805                                   hh:load-image("cmp/b-sch.bmp":u) .
      806                                   hh:TOOLTIP = "Установка Фильтра" .
      807                                   v-h[ii] = hh:handle .
      808                                   ii = ii + 1 .
      809                                   hh:width-chars = 3 .
      810                               end.
      811                           when "b-hist-user" then
      812                               do:
      813                                   hh:load-image("cmp/b-hist.bmp":u) .
      814                                   hh:TOOLTIP = "История пользователя" .
      815                                   ii = ii + 1 .
      816                               end.
      817                       end case.
      818                   end.
      819                   hh = hh:next-sibling.
      820               end.
      821               b-help:column = v-frame-width - b-help:width-chars.
      822               jj = 0.
      823               repeat ii = 4 to 1 by -1 :
      824                   if valid-handle (v-h[ii] ) then
      825                   do:
      826                       jj  = jj + 1 .
      827                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      828                       v-h[ii]:row    = v-help-old-y .
      829                   end.
      830               end.
      831           end.
      832       end.
      833   end procedure.
      834   MAIN-BLOCK:
      835   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      836      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      837     RUN Myenable NO-ERROR.
      838     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
      839     WAIT-FOR GO OF FRAME Dialog-Frame.
      840   END.
      841   RUN disable_UI.
      842   FOR EACH temp-widget:
      843     delete widget temp-widget.handle_.
      844     delete temp-widget.
      845   END.
      846   PROCEDURE disable_UI :
      847     HIDE FRAME Dialog-Frame.
      848   END PROCEDURE.
      849   PROCEDURE enable_UI :
      850     DISPLAY e-struct
      851         WITH FRAME Dialog-Frame.
      852     ENABLE B-exit b-quit B-Help e-struct
      853         WITH FRAME Dialog-Frame.
      854     VIEW FRAME Dialog-Frame.
      855   END PROCEDURE.
      856   PROCEDURE MyEnable :
      857   DEFINE variable v-ii AS INTEGER NO-UNDO.
      858   DEFINE variable v-num-rows AS integer NO-UNDO.
      859   DEFINE variable v-length AS DECIMAL NO-UNDO.
      860   DEFINE variable output-num-lines AS integer NO-UNDO.
      861   DEFINE variable v-num-entries AS integer NO-UNDO.
      862   define variable v-uh as handle no-undo .
      863   define variable v-struct as character no-undo .
      864   define variable v-setted as logical no-undo .
      865   DEFINE BUFFER buf_goods FOR ub.goods.
      866     assign
      867     v-uh = this-procedure:instantiating-procedure.
      868     do while valid-handle(v-uh):
      869       if lookup("cb-for-struct-i", v-uh:internal-entries) > 0 then do:
      870         run cb-for-struct-i in v-uh ( output v-struct) no-error.
      871         ASSIGN
      872         e-struct:SCREEN-VALUE IN FRAME Dialog-Frame = v-struct
      873         v-setted = yes
      874         .
      875         if p-mode = 'ДОБАВЛЕНИЕ':U
      876         then do:
      877           case p-spr-param:
      878             when '15x80':U then do:
      879               p-attr-value = Break-n-line
      880               ( INPUT v-struct
      881                 ,INPUT right-trim(fill(string(80) + chr(44), 15), chr(44))
      882                 ,OUTPUT output-num-lines
      883                 ) .
      884             end.
      885             when '8x50':U then do:
      886               p-attr-value = Break-n-line
      887               ( INPUT v-struct
      888                 ,INPUT right-trim(fill(string(50) + chr(44), 8), chr(44))
      889                 ,OUTPUT output-num-lines
      890                 ) .
      891             end.
      892             when '6x50':U then do:
      893               p-attr-value = Break-n-line
      894               ( INPUT v-struct
      895                 ,INPUT right-trim(fill(string(50) + chr(44), 6), chr(44))
      896                 ,OUTPUT output-num-lines
      897                 ) .
      898             end.
      899           end case.
      900         end.
      901         leave.
      902       end.
      903       v-uh = v-uh:instantiating-procedure.
      904     end.
      905   IF p-gds-code > 0 THEN DO:
      906     if v-struct = ''
      907     then do:
      908       FIND FIRST buf_goods NO-LOCK WHERE
      909                 buf_goods.gds-code = p-gds-code.
      910       if not v-setted then
      911       ASSIGN
      912       e-struct:SCREEN-VALUE IN FRAME Dialog-Frame = buf_goods.struct.
      913     end.
      914   END.
      915   ASSIGN
      916   FRAME Dialog-Frame:TITLE = substitute("&1 &2"
      917                                          , FRAME Dialog-Frame:TITLE
      918                                          , p-spr-param).
      919   ASSIGN
      920   v-num-rows = integer(ENTRY(1, p-spr-param, "x"))
      921   v-length = decimal(ENTRY(2, p-spr-param, "x"))
      922   NO-ERROR.
      923   IF ERROR-STATUS:ERROR THEN DO:
      924     MESSAGE
      925      substitute("Неверный формат для задания поля СОСТАВ СЫРЬЯ = &1"
      926                 , p-spr-param)
      927     VIEW-AS ALERT-BOX ERROR.
      928     RETURN ERROR.
      929   END.
      930   ASSIGN
      931   v-num-entries = num-entries(p-attr-value, chr(4))
      932   .
      933   DO v-ii = 1 TO v-num-rows:
      934      CREATE temp-widget.
      935      ASSIGN
      936      temp-widget.NAME_ = SUBSTITUTE("fill-in-&1", v-ii)
      937      temp-widget.LENGTH_  = v-length
      938      temp-widget.index_  = v-ii
      939      temp-widget.format_  = substitute("X(&1)", v-length)
      940      temp-widget.width_  = v-length + 2
      941      .
      942      CREATE FILL-IN temp-widget.HANDLE_
      943      ASSIGN ROW = 6 + v-ii
      944      COLUMN = 1
      945      FORMAT = temp-widget.format_
      946      WIDTH = temp-widget.WIDTH_
      947      FRAME = FRAME Dialog-Frame:HANDLE
      948      SENSITIVE = (p-mode <> 'ПРОСМОТР':U)
      949      VISIBLE = TRUE
      950      SCREEN-VALUE = (IF v-num-entries >= v-ii
      951                      THEN ENTRY(v-ii, p-attr-value, chr(4))
      952                      ELSE '')
      953      .
      954   END.
      955   ENABLE
      956   B-exit when p-mode <> 'ПРОСМОТР':U
      957   b-quit
      958   B-Help
      959   e-struct
      960   WITH FRAME Dialog-Frame.
      961   VIEW FRAME Dialog-Frame.
      962   if p-mode = 'ПРОСМОТР':U then do:
      963     hide
      964     b-exit
      965     in frame Dialog-Frame .
      966     assign
      967     b-quit:label = "&Выход"
      968     b-quit:column = 1
      969     .
      970   end.
      971   END PROCEDURE.
      972   PROCEDURE proc-save :
      973   DEFINE VARIABLE v-struct AS CHARACTER NO-UNDO.
      974   if p-mode = 'ПРОСМОТР':U then return.
      975   FOR each temp-widget by index_:
      976     ASSIGN
      977     v-struct = v-struct + (IF temp-widget.INDEX_ = 1 THEN '':U ELSE chr(4)) + temp-widget.HANDLE_:SCREEN-VALUE.
      978   END.
      979   ASSIGN
      980   p-attr-value = v-struct
      981   p-setted = YES
      982   .
      983   END PROCEDURE.
