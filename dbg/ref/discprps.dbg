     2363   procedure diasize_set-height :
     2364     define input  parameter p-new-height  as decimal   no-undo .
     2365     define input  parameter p-move-resize as logical   no-undo .
     2366     do
     2367     on error undo, return error return-value
     2368     :
     2369       run diasize_change-height in this-procedure
     2370         (input  (p-new-height - frame Dialog-Frame :height)
     2371         ,input  p-move-resize
     2372         ) .
     2373     end.
     2374   end procedure.
     2375   procedure diasize_change-width :
     2376     define input  parameter p-change-value as decimal   no-undo .
     2377     define input  parameter p-move-resize  as logical   no-undo .
