      876   function diff-list returns character (
      877     input parfirst-list  as character,
      878     input parsecond-list as character,
      879     input pardelim       as character).
      880     if pardelim = ""
      881     or pardelim = ?
      882     then do:
      883       assign
      884         pardelim = ","
      885       .
      886     end.
      887     def var ind as integer no-undo .
      888     def var v-elem as character no-undo .
      889     def var v-result-list as character no-undo init "".
      890     def var v-num-parfirst-list as integer no-undo .
      891     assign
      892       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      893     .
      894     do ind = 1 to v-num-parfirst-list
      895     :
      896       assign
      897         v-elem = entry(ind, parfirst-list, pardelim)
      898       .
      899       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      900         assign
      901           v-result-list = v-result-list
      902                         + (if v-result-list > "" then pardelim else "")
      903                         + v-elem
      904         .
      905       end.
      906     end.
      907     return v-result-list .
      908   end function.
      909   function add-list returns character (
      910    input parfirst-list  as character,
      911    input parsecond-list as character,
      912    input pardelim       as character).
      913     if pardelim = ""
      914     or pardelim = ?
      915     then do:
      916       assign
      917         pardelim = ","
      918       .
      919     end.
      920     def var ind as integer no-undo .
      921     def var v-elem as character no-undo .
      922     def var v-result-list as character no-undo init "".
      923     def var v-num-parfirst-list as integer no-undo .
      924     assign
      925       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      926     .
      927     do ind = 1 to v-num-parfirst-list
      928     :
      929       assign
      930         v-elem = entry(ind, parfirst-list, pardelim)
      931       .
      932       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      933         assign
      934           v-result-list = v-result-list
      935                         + (if v-result-list > "" then pardelim else "")
      936                         + v-elem
      937         .
      938       end.
      939     end.
      940     def var v-num-parsecond-list as integer no-undo .
      941     assign
      942       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      943     .
      944     do ind = 1 to v-num-parsecond-list
      945     :
      946       assign
      947         v-elem = entry(ind, parsecond-list, pardelim)
      948       .
      949       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      950         assign
      951           v-result-list = v-result-list
      952                         + (if v-result-list > "" then pardelim else "")
      953                         + v-elem
      954         .
      955       end.
      956     end.
      957     return v-result-list .
      958   end function.
      959   function cross-list returns character (
      960    input parfirst-list  as character,
      961    input parsecond-list as character,
      962    input pardelim       as character).
      963     if pardelim = ""
      964     or pardelim = ?
      965     then do:
      966       assign
      967         pardelim = ","
      968       .
      969     end.
      970     def var ind as integer no-undo .
      971     def var v-elem as character no-undo .
      972     def var v-result-list as character no-undo init "".
      973     def var v-num-parfirst-list as integer no-undo .
      974     assign
      975       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      976     .
      977     do ind = 1 to v-num-parfirst-list
      978     :
      979       assign
      980         v-elem = entry(ind, parfirst-list, pardelim)
      981       .
      982       if lookup(v-elem, v-result-list, pardelim) = 0
      983       and lookup(v-elem, parsecond-list, pardelim) > 0
      984       then do:
      985         assign
      986           v-result-list = v-result-list
      987                         + (if v-result-list > "" then pardelim else "")
      988                         + v-elem
      989         .
      990       end.
      991     end.
      992     return v-result-list .
      993   end function.
      994   function radio-label returns character (
      995    input par-rs-value  as character,
      996    input par-rs-radio-buttons as character)
      997    .
      998    DEFINE variable v-result-label as character no-undo.
      999    assign
     1000    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
     1001                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
     1002                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
     1003                             ), par-rs-radio-buttons
     1004                           )
     1005    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1006    .
     1007   return v-result-label.
     1008   end function.
     1009   function m-radio-label returns character (
     1010    input par-rs-value  as character,
     1011    input par-rs-radio-buttons as character,
     1012    input par-delim as character
     1013    )
     1014    .
     1015    DEFINE variable v-result-label as character no-undo.
     1016    assign
     1017    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
     1018                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
     1019                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
     1020                             ), par-rs-radio-buttons, par-delim
     1021                           )
     1022    v-result-label = REPLACE(v-result-label, "&":U, "":U)
     1023    .
     1024   return v-result-label.
     1025   end function.
     1026   FUNCTION mixlist returns character
     1027   (
     1028    input parfirst-list  as character
     1029    ,input parsecond-list as character
     1030    ,input pardelim       as character
     1031    ,input pardelim-result as character ) :
     1032     if pardelim = ""
     1033     or pardelim = ?
     1034     then do:
     1035       assign
     1036         pardelim = ","
     1037       .
     1038     end.
     1039     def var ind as integer no-undo .
     1040     def var v-elem1 as character no-undo .
     1041     def var v-elem2 as character no-undo .
     1042     def var v-result-list as character no-undo init "".
     1043     do ind = 1 to num-entries(parfirst-list, pardelim)
     1044     :
     1045       assign
     1046         v-elem1 = entry(ind, parfirst-list, pardelim)
     1047         v-elem2 = entry(ind, parsecond-list, pardelim)
     1048       .
     1049         assign
     1050           v-result-list = v-result-list
     1051                         + (if v-result-list > "" then pardelim-result else "")
     1052                         + v-elem1 + pardelim-result + v-elem2
     1053         .
     1054     end.
     1055     return v-result-list .
     1056   END FUNCTION.
     1057   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1058   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1059   procedure fltopend_fltopend :
     1060   define input parameter p-parent-handle as handle no-undo .
     1061   define input parameter p-qh as handle no-undo .
     1062   define input parameter p-flt-open-open-query  as character no-undo .
     1063   define input parameter p-where-cond as character no-undo .
     1064   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1065   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1066   define input parameter p-indexed-reposition as character no-undo .
     1067     do
     1068     on error undo, return error
     1069     :
     1070   define variable v-prepare-string as character no-undo .
     1071   define variable glog as logical no-undo .
     1072   assign
     1073   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1074                      p-where-cond + chr(32)  +
     1075                      p-use-indFIRST-query-tail + chr(32) +
     1076                      p-use-ind-sort-clmn-by + chr(32) +
     1077                      p-indexed-reposition
     1078   .
     1079   assign
     1080   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1081   if not glog
     1082   or error-status:error then do:
     1083     message error-status:get-message(1) view-as alert-box .
     1084     undo, return error .
     1085   end.
     1086   assign
     1087   glog = p-qh:query-open no-error .
     1088   if not glog
     1089   or error-status:error then do:
     1090     message error-status:get-message(1) view-as alert-box .
     1091     undo, return error .
     1092   end.
     1093     end.
     1094   end procedure.
     1095   procedure fltopend_fltfindd :
     1096   define input parameter p-parent-handle as handle no-undo .
     1097   define input parameter p-qh as handle no-undo .
     1098   define input parameter p-rowid as rowid no-undo .
     1099   define input parameter p-next as logical no-undo .
     1100   define input parameter p-lock as integer no-undo .
     1101   define input parameter p-bh as handle no-undo .
     1102   define input parameter p-where-cond as character no-undo .
     1103   define input parameter p-use-index-phrase as character no-undo .
     1104   define variable glog as logical no-undo .
     1105   define variable v-qh as handle no-undo .
     1106   define variable v-bh as handle no-undo .
     1107   define variable v-recid as recid no-undo .
     1108   define variable v-prepare-string as character no-undo .
     1109   do
     1110   on error undo, return error
     1111   on stop undo, return error
     1112   :
     1113     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1114     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1115     create query v-qh.
     1116     v-qh:set-buffers(v-bh).
     1117     v-prepare-string = substitute("for each &1 &2 &3"
     1118                                     ,v-bh:name
     1119                                     ,p-where-cond
     1120                                     ,p-use-index-phrase).
     1121     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1122     if not glog then do:
     1123       delete object v-qh.
     1124       delete object v-bh.
     1125       undo, return error .
     1126     end.
     1127     glog = v-qh:query-open no-error .
     1128     if not glog then do:
     1129       delete object v-qh.
     1130       delete object v-bh.
     1131       undo, return error .
     1132     end.
     1133     if p-next then do:
     1134       v-qh:reposition-to-rowid(p-rowid) no-error .
     1135       glog = v-qh:get-next( p-lock) no-error .
     1136       glog = v-qh:get-next( p-lock) no-error .
     1137       if not glog or v-qh:query-off-end = yes then do:
     1138         glog = v-qh:get-first( p-lock) no-error .
     1139       end.
     1140     end.
     1141     else do:
     1142       glog = v-qh:get-first( p-lock) no-error .
     1143     end.
     1144     v-recid = v-bh:recid no-error .
     1145     delete object v-qh.
     1146     delete object v-bh.
     1147     return string(v-recid) .
     1148   end.
     1149   end procedure.
     1150   procedure fltopend_fltfindq :
     1151   define input parameter p-parent-handle as handle no-undo .
     1152   define input parameter p-qh as handle no-undo .
     1153   define input parameter p-next as logical no-undo .
     1154   define input parameter p-lock as integer no-undo .
     1155   define input parameter p-flt-open-open-query  as character no-undo .
     1156   define input parameter p-where-cond as character no-undo .
     1157   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1158   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1159   define input parameter p-indexed-reposition as character no-undo .
     1160   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1161   define variable glog as logical no-undo .
     1162   define variable v-qh as handle no-undo .
     1163   define variable v-bh as handle no-undo extent 18.
     1164   define variable v-rowid as rowid no-undo extent 18.
     1165   define variable v-ii as integer no-undo .
     1166   define variable v-prepare-string as character no-undo .
     1167   do
     1168   on error undo, return error
     1169   on stop undo, return error
     1170   :
     1171     create query v-qh.
     1172     do v-ii = 1 to p-qh:num-buffers:
     1173       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1174       assign
     1175       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1176       no-error.
     1177       v-qh:add-buffer(v-bh[v-ii]).
     1178     end.
     1179     assign
     1180     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1181                       p-where-cond + chr(32)  +
     1182                       p-use-indFIRST-query-tail + chr(32) +
     1183                       p-use-ind-sort-clmn-by + chr(32) +
     1184                       p-indexed-reposition
     1185     .
     1186     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1187     if not glog then do:
     1188       delete object v-qh.
     1189       do v-ii = 1 to p-qh:num-buffers:
     1190         delete object v-bh[v-ii].
     1191       end.
     1192       undo, return error .
     1193     end.
     1194     glog = v-qh:query-open no-error .
     1195     if not glog then do:
     1196       delete object v-qh.
     1197       do v-ii = 1 to p-qh:num-buffers:
     1198         delete object v-bh[v-ii].
     1199       end.
     1200       undo, return error .
     1201     end.
     1202     if p-next then do:
     1203       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1204       glog = v-qh:get-next( p-lock) no-error .
     1205       glog = v-qh:get-next( p-lock) no-error .
     1206       if not glog or v-qh:query-off-end = yes then do:
     1207         glog = v-qh:get-first( p-lock) no-error .
     1208       end.
     1209     end.
     1210     else do:
     1211       glog = v-qh:get-first( p-lock) no-error .
     1212     end.
     1213     do v-ii = 1 to p-qh:num-buffers:
     1214       assign
     1215       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1216       no-error.
     1217     end.
     1218     delete object v-qh.
     1219     do v-ii = 1 to p-qh:num-buffers:
     1220       delete object v-bh[v-ii].
     1221     end.
     1222   end.
     1223   end procedure.
     1224   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
     1225   DEFINE VARIABLE link-option AS CHARACTER NO-UNDO.
     1226   define variable v-rid-list as character no-undo .
     1227   define variable sort-column-name as character no-undo .
     1228   define variable filter-point-label as character no-undo init "Свойства ДК" .
     1229   define variable filter-point0 as character no-undo init "discprps" .
     1230   define variable filter-point as character no-undo init "discprps" .
     1231   define variable v-list-mode as character no-undo .
     1232   define variable v-short-mode as logical no-undo .
     1233   DEFINE BUFFER buf_prop-head FOR ub.prop-head.
     1234   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
     1235   DEFINE VARIABLE v-ch_ AS WIDGET-HANDLE NO-UNDO EXTENT 5.
     1236   DEFINE VARIABLE v-ch_host AS WIDGET-HANDLE NO-UNDO EXTENT 5.
     1237   DEFINE VARIABLE v-ch_obj AS WIDGET-HANDLE NO-UNDO EXTENT 5.
     1238   FUNCTION display-character RETURNS CHARACTER
     1239     (  INPUT p-character AS CHARACTER, INPUT p-format AS CHARACTER)  FORWARD.
     1240   DEFINE BUTTON b-card
     1241        LABEL "Карта"
     1242        SIZE 10 BY 1.
     1243   DEFINE BUTTON b-dt-code
     1244        IMAGE-UP FILE "btn-down-arrow":U
     1245        IMAGE-DOWN FILE "btn-down-arrow":U
     1246        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1247        LABEL "Btn 3"
     1248        SIZE 3 BY 1.
     1249   DEFINE BUTTON b-dtm-code
     1250        IMAGE-UP FILE "btn-down-arrow":U
     1251        IMAGE-DOWN FILE "btn-down-arrow":U
     1252        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1253        LABEL "Btn 3"
     1254        SIZE 3 BY 1.
     1255   DEFINE BUTTON B-Help
     1256        LABEL "Помо&щь"
     1257        SIZE 3 BY 1
     1258        BGCOLOR 8 .
     1259   DEFINE BUTTON b-history
     1260        LABEL "Ис&тория"
     1261        SIZE 3 BY 1
     1262        BGCOLOR 8 .
     1263   DEFINE BUTTON b-lkp
     1264        LABEL "&Просмотр"
     1265        SIZE 10 BY 1.
     1266   DEFINE BUTTON b-mark
     1267        LABEL "&*"
     1268        SIZE 4 BY 1.
     1269   DEFINE BUTTON b-node-code
     1270        IMAGE-UP FILE "btn-down-arrow":U
     1271        IMAGE-DOWN FILE "btn-down-arrow":U
     1272        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1273        LABEL "Btn 3"
     1274        SIZE 3 BY 1.
     1275   DEFINE BUTTON B-print
     1276        LABEL "Пе&чать"
     1277        SIZE 3 BY 1.
     1278   DEFINE BUTTON b-quit AUTO-END-KEY
     1279        LABEL "&Выход"
     1280        SIZE 10 BY 1
     1281        BGCOLOR 8 .
     1282   DEFINE BUTTON b-sch
     1283        LABEL "&Фильтр"
     1284        SIZE 3 BY 1.
     1285   DEFINE BUTTON b-sel AUTO-GO
     1286        LABEL "Выбор"
     1287        SIZE 10 BY 1.
     1288   DEFINE VARIABLE f-dt-code AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     1289        LABEL "Код среза"
     1290        VIEW-AS FILL-IN NATIVE
     1291        SIZE 8.5 BY 1 NO-UNDO.
     1292   DEFINE VARIABLE f-dtm-code AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     1293        LABEL "Код объекта"
     1294        VIEW-AS FILL-IN NATIVE
     1295        SIZE 8.5 BY 1 NO-UNDO.
     1296   DEFINE VARIABLE f-dtm-name AS CHARACTER FORMAT "X(256)":U
     1297        VIEW-AS FILL-IN NATIVE
     1298        SIZE 72.5 BY 1
     1299        FGCOLOR 4  NO-UNDO.
     1300   DEFINE VARIABLE f-node-code AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     1301        LABEL "Код св-ва"
     1302        VIEW-AS FILL-IN NATIVE
     1303        SIZE 8.5 BY 1 NO-UNDO.
     1304   DEFINE VARIABLE f-node-label AS CHARACTER FORMAT "X(256)":U
     1305        VIEW-AS FILL-IN NATIVE
     1306        SIZE 72.5 BY 1
     1307        FGCOLOR 4  NO-UNDO.
     1308   DEFINE VARIABLE f-sum-id AS CHARACTER FORMAT "X(256)":U
     1309        VIEW-AS FILL-IN NATIVE
     1310        SIZE 31.5 BY 1
     1311        FGCOLOR 4  NO-UNDO.
     1312   DEFINE VARIABLE mark-num AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
     1313         VIEW-AS TEXT
     1314        SIZE 9 BY .67
     1315        FGCOLOR 10  NO-UNDO.
     1316   DEFINE VARIABLE rs-region AS CHARACTER
     1317        VIEW-AS RADIO-SET HORIZONTAL
     1318        RADIO-BUTTONS
     1319             "Объекты", "1",
     1320   "Фирмы", "2",
     1321   "Глобально", "3"
