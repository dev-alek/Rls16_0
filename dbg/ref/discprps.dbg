     2667             v-object-handle = buf_temp-diasize-handle.handle-value
     2668           .
     2669           if v-object-handle <> v-diasize-resize-button
     2670           then do:
     2671             assign
     2672               v-object-handle :col = v-object-handle :col + p-change-value
     2673               no-error .
     2674             if error-status :error
     2675             or error-status :get-message(1) <> ""
     2676             then do:
     2677               undo move_block, retry move_block .
     2678             end.
     2679           end.
     2680         end.
     2681         for each buf_temp-browse-handle
     2682           where buf_temp-browse-handle.browse-type = 'width':u
     2683         on error undo move_block, retry move_block
     2684         :
     2685           assign
     2686             buf_temp-browse-handle.browse-handle :width
     2687               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2688             no-error .
     2689           if error-status :error
     2690           or error-status :get-message(1) <> ""
     2691           then do:
     2692             undo move_block, retry move_block .
     2693           end.
     2694         end.
     2695         assign
     2696           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2697           no-error .
     2698         if error-status :error
     2699         or error-status :get-message(1) <> ""
     2700         then do:
     2701           undo move_block, retry move_block.
     2702         end.
     2703         assign
     2704           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2705         no-error .
     2706         if error-status :error
     2707         or error-status :get-message(1) <> ""
     2708         then do:
     2709           undo move_block, retry move_block.
     2710         end.
     2711         if frame Dialog-Frame :scrollable = true
     2712         then do:
     2713           assign
     2714             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2715           no-error .
     2716           if error-status :error
     2717           or error-status :get-message(1) <> ""
     2718           then do:
     2719             undo move_block, retry move_block.
     2720           end.
     2721         end.
     2722       end.
     2723       if p-move-resize
     2724       then do:
     2725         run diasize_position-resize-button in this-procedure .
     2726       end.
     2727       if v-diasize-wndstore = true
     2728       then do:
     2729         if connected("ub") = true
     2730         then do:
     2731           define variable v-cntxt-db-num        as integer   no-undo .
     2732           define variable v-cntxt-userid        as character no-undo .
     2733           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2734                                             , OUTPUT v-cntxt-userid
     2735                                             ) .
     2736           run gbl/wndsizew.p
     2737             (input  v-cntxt-db-num
     2738             ,input  v-cntxt-userid
     2739             ,input  v-diasize-proc-name
     2740             ,input  'width':u
     2741             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2742             ) .
     2743         end.
     2744       end.
     2745     end.
     2746     assign
     2747       v-diasize-change-size = false
     2748     .
     2749   end procedure.
     2750   procedure diasize_set-width :
     2751     define input  parameter p-new-width  as decimal   no-undo .
     2752     define input  parameter p-move-resize as logical   no-undo .
     2753     do
     2754     on error undo, return error return-value
     2755     :
     2756       run diasize_change-width in this-procedure
     2757         (input  (p-new-width - frame Dialog-Frame :width)
     2758         ,input  p-move-resize
     2759         ) .
     2760     end.
     2761   end procedure.
     2762   procedure diasize_position-resize-button :
     2763     do with frame Dialog-Frame
     2764     :
     2765       hide v-diasize-resize-button .
     2766       assign
     2767         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2768                     - 1
     2769                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2770         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2771                     - 1
     2772                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2773       .
     2774       view v-diasize-resize-button .
     2775     end.
     2776   end procedure.
     2777   on alt-right anywhere
     2778   do:
     2779     run diasize_change-width in this-procedure
     2780       (input 1
     2781       ,input true
     2782       ) .
     2783     return no-apply .
     2784   end.
     2785   on alt-left anywhere
     2786   do:
     2787     run diasize_change-width in this-procedure
     2788       (input -1
     2789       ,input true
     2790       ) .
     2791     return no-apply .
     2792   end.
     2793   on alt-down anywhere
     2794   do:
     2795     run diasize_change-height in this-procedure
     2796       (input 1
     2797       ,input true
     2798       ) .
     2799     return no-apply .
     2800   end.
     2801   on alt-up anywhere
     2802   do:
     2803     run diasize_change-height in this-procedure
     2804       (input -1
     2805       ,input true
     2806       ) .
     2807     return no-apply .
     2808   end.
     2809   on alt-enter of frame Dialog-Frame
     2810   do:
     2811     run diasize_maximize in this-procedure
     2812       (input  ?
     2813       ).
     2814     return no-apply .
     2815   end.
     2816   procedure diasize_end-move :
     2817     do
     2818     on error undo, return error return-value
     2819     :
     2820       define variable v-row-delta as decimal   no-undo .
     2821       define variable v-col-delta as decimal   no-undo .
     2822       define variable v-new-row as decimal   no-undo .
     2823       define variable v-new-col as decimal   no-undo .
     2824       assign
     2825         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2826         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2827       .
     2828       assign
     2829         v-row-delta = v-new-row - frame Dialog-Frame :height
     2830         v-col-delta = v-new-col - frame Dialog-Frame :width
     2831       .
     2832       run diasize_change-height in this-procedure
     2833         (input v-row-delta
     2834         ,input true
     2835         ) .
     2836       run diasize_change-width in this-procedure
     2837         (input v-col-delta
     2838         ,input true
     2839         ) .
     2840     end.
     2841   end procedure.
     2842   procedure diasize_maximize :
     2843     define input  parameter p-action as logical   no-undo .
     2844     do
     2845     on error undo, return error return-value
     2846     :
     2847       if p-action = ?
     2848       then do:
     2849         if v-diasize-need-maximize = true
     2850         then do:
     2851           assign
     2852             p-action = true
     2853           .
     2854         end.
     2855         else do:
     2856           assign
     2857             p-action = false
     2858           .
     2859         end.
     2860       end.
     2861       if p-action = true
     2862       then do:
     2863         run diasize_change-height in this-procedure
     2864           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2865               - frame Dialog-Frame :height-chars
     2866           ,input true
     2867           ) .
     2868         run diasize_change-width in this-procedure
     2869           (input session :width-chars
     2870               - frame Dialog-Frame :width-chars
     2871           ,input true
     2872           ) .
     2873         assign
     2874           v-diasize-need-maximize = false
     2875         .
     2876       end.
     2877       else do:
     2878         run diasize_change-width in this-procedure
     2879           (input v-diasize-orig-frame-width
     2880               - frame Dialog-Frame :width-chars
     2881           ,input true
     2882           ) .
     2883         run diasize_change-height in this-procedure
     2884           (input v-diasize-orig-frame-height
     2885               - frame Dialog-Frame :height-chars
     2886           ,input true
     2887           ) .
     2888         assign
     2889           v-diasize-need-maximize = true
     2890         .
     2891       end.
     2892     end.
     2893   end procedure.
     2894   procedure diasize_restore-orig-size :
     2895     do
     2896     on error undo, return error return-value
     2897     :
     2898       assign
     2899         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2900         v-diasize-current-frame-height = frame Dialog-Frame :height
     2901       .
     2902       run diasize_set-height in this-procedure
     2903         (input  v-diasize-orig-frame-height
     2904         ,input  true
     2905         ) .
     2906       run diasize_set-width in this-procedure
     2907         (input  v-diasize-orig-frame-width
     2908         ,input  true
     2909         ) .
     2910     end.
     2911   end procedure.
     2912   procedure diasize_restore-current-size :
     2913     do
     2914     on error undo, return error return-value
     2915     :
     2916       run diasize_set-height in this-procedure
     2917         (input  v-diasize-current-frame-height
     2918         ,input  true
     2919         ) .
     2920       run diasize_set-width in this-procedure
     2921         (input  v-diasize-current-frame-width
     2922         ,input  true
     2923         ) .
     2924     end.
     2925   end procedure.
     2926   procedure diasize_set-browse-handle :
     2927     define input  parameter p-browse-handle as handle   no-undo .
     2928     define buffer buf_temp-browse-handle for temp-browse-handle .
     2929     do
     2930     on error undo, return error return-value
     2931     :
     2932       assign
     2933         v-diasize-browse-handle = p-browse-handle
     2934       .
     2935       for each buf_temp-browse-handle
     2936       on error undo, return error return-value
     2937       :
     2938         delete buf_temp-browse-handle .
     2939       end.
     2940     end.
     2941   end procedure.
     2942   procedure diasize_add_browse :
     2943     define input  parameter p-browse-type   as character no-undo .
     2944     define input  parameter p-browse-handle as handle    no-undo .
     2945     define buffer buf_temp-browse-handle for temp-browse-handle .
     2946     do
     2947     on error undo, return error return-value
     2948     :
     2949       assign
     2950         v-diasize-browse-number = v-diasize-browse-number + 1
     2951       .
     2952       create buf_temp-browse-handle .
     2953       assign
     2954         buf_temp-browse-handle.browse-type   = p-browse-type
     2955         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2956         buf_temp-browse-handle.browse-handle = p-browse-handle
     2957       .
     2958     end.
     2959   end procedure.
     2960   procedure diasize_init :
     2961     define variable v-default-value    as logical   no-undo .
     2962     define variable v-restore-saved    as logical   no-undo .
     2963     define variable v-resize-value-str as character no-undo .
     2964     do
     2965     on error undo, return error return-value
     2966     :
     2967       do with frame Dialog-Frame
     2968       :
     2969         assign
     2970           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2971           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2972           v-diasize-browse-handle     = browse br-dis-prop_ :handle
     2973         .
     2974         create button v-diasize-resize-button
     2975         assign
     2976           parent        = frame Dialog-Frame :first-child
     2977           label         = "s"
     2978           height-pixels = 16
     2979           width-pixels  = 16
     2980           visible       = true
     2981           sensitive     = true
     2982           movable       = true
     2983           triggers:
     2984             on end-move persistent run diasize_end-move in this-procedure .
     2985           end triggers.
     2986         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2987         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2988         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2989         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2990         assign
     2991           v-diasize-wndmax = false
     2992         .
     2993         if connected("ub") = true
     2994         then do:
     2995           define variable v-cntxt-db-num        as integer   no-undo .
     2996           define variable v-cntxt-userid        as character no-undo .
     2997           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2998                                             , OUTPUT v-cntxt-userid
     2999                                             ) .
     3000           run gbl/wndpar_r.p
     3001             (input  v-cntxt-db-num
     3002             ,input  v-cntxt-userid
     3003             ,input  'wndmax':U
     3004             ,output v-diasize-wndmax
     3005             ,output v-default-value
     3006             ) .
     3007         end.
     3008         assign
     3009           v-diasize-wndstore = false
     3010         .
     3011         if connected("ub") = true
     3012         then do:
     3013           run gbl/wndpar_r.p
     3014             (input  v-cntxt-db-num
     3015             ,input  v-cntxt-userid
     3016             ,input  'wndstore':U
     3017             ,output v-diasize-wndstore
     3018             ,output v-default-value
     3019             ) .
     3020         end.
     3021         assign
     3022           v-diasize-proc-name = entry(1, program-name(2), '.')
     3023         .
     3024         if v-diasize-wndstore = true
     3025         then do:
     3026           assign
     3027             v-restore-saved = false
     3028           .
     3029           if connected("ub") = true
     3030           then do:
     3031             run gbl/wndsizer.p
     3032               (input  v-cntxt-db-num
     3033               ,input  v-cntxt-userid
     3034               ,input  v-diasize-proc-name
     3035               ,input  'height':u
     3036               ,output v-resize-value-str
     3037               ) .
     3038             if v-resize-value-str <> '':U
     3039             then do:
     3040               run diasize_change-height in this-procedure
     3041                 (input  integer(v-resize-value-str)
     3042                 ,input  true
     3043                 ) .
     3044               assign
     3045                 v-restore-saved = true
     3046               .
     3047             end.
     3048           end.
     3049           if connected("ub") = true
     3050           then do:
     3051             run gbl/wndsizer.p
     3052               (input  v-cntxt-db-num
     3053               ,input  v-cntxt-userid
     3054               ,input  v-diasize-proc-name
     3055               ,input  'width':u
     3056               ,output v-resize-value-str
     3057               ) .
     3058             if v-resize-value-str <> '':U
     3059             then do:
     3060               run diasize_change-width in this-procedure
     3061                 (input  integer(v-resize-value-str)
     3062                 ,input  true
     3063                 ) .
     3064               assign
     3065                 v-restore-saved = true
     3066               .
     3067             end.
     3068           end.
     3069           if v-restore-saved <> true
     3070           then do:
     3071             if v-diasize-wndmax = true
     3072             then do:
     3073               run diasize_maximize in this-procedure
     3074                 (input  true
     3075                 ) .
     3076             end.
     3077           end.
     3078         end.
     3079         else do:
     3080           if v-diasize-wndmax = true
     3081           then do:
     3082             run diasize_maximize in this-procedure
     3083               (input  true
     3084               ) .
     3085           end.
     3086         end.
     3087       end.
     3088     end.
     3089   end procedure.
     3090   procedure diasize_need-full-display :
     3091     define output parameter p-need-full-display as logical   no-undo .
     3092     do
     3093     on error undo, return error return-value
     3094     :
     3095       assign
     3096         p-need-full-display = v-diasize-need-full-display
     3097       .
     3098       assign
     3099         v-diasize-need-full-display = false
     3100       .
     3101     end.
     3102   end procedure.
     3103   procedure get-context :
     3104      define output parameter p-db-num as integer          no-undo.
     3105      define output parameter p-user-id as character        no-undo.
     3106      define variable v-login               as character    no-undo.
     3107      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3108      define buffer buf_user-login  for ub.user-login .
     3109      do
     3110      on error undo, return error
     3111      :
     3112            FIND FIRST buf_sys-ctrl no-lock.
     3113            ASSIGN
     3114               v-login = USERID("ub")
     3115               p-db-num = buf_sys-ctrl.db-num
     3116            .
     3117            FIND FIRST buf_user-login
     3118                 WHERE buf_user-login.db-num = p-db-num
     3119                   AND buf_user-login.user-login = v-login
     3120                 no-lock
     3121                 no-error
     3122                 .
     3123            IF AVAILABLE buf_user-login
     3124            THEN DO:
     3125               assign
     3126                  p-user-id = buf_user-login.user-id
     3127               .
     3128            END.
     3129      end.
     3130   end procedure.
     3131       run diasize_init in this-procedure .
     3132   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3133   procedure set-filter-name :
     3134   define input parameter p-filter-name as character no-undo .
     3135     do with frame Dialog-Frame:
     3136       if p-filter-name > "" then do:
     3137         assign
     3138           frame Dialog-Frame:title
     3139             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3140         .
     3141         assign
     3142           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3143         .
     3144       end.
     3145       else do:
     3146         assign
     3147           b-sch :tooltip = ""
     3148         .
     3149       end.
     3150     end.
     3151   end procedure.
     3152   ON ROW-DISPLAY OF br-dis-prop_ IN frame Dialog-Frame
     3153   DO:
     3154     IF AVAIL X_dis-prop_ THEN DO:
     3155       RUN set-row-color_ IN THIS-PROCEDURE ( INPUT X_prop-map_.node-value-type).
     3156     END.
     3157   END.
     3158   ON ROW-DISPLAY OF br-dis-prop_host IN frame Dialog-Frame
     3159   DO:
     3160     IF AVAIL X_dis-prop_host THEN DO:
     3161       RUN set-row-color_host IN THIS-PROCEDURE ( INPUT X_prop-map_host.node-value-type).
     3162     END.
     3163   END.
     3164   ON ROW-DISPLAY OF br-dis-prop_obj IN frame Dialog-Frame
     3165   DO:
     3166     IF AVAIL X_dis-prop_obj THEN DO:
     3167       RUN set-row-color_obj IN THIS-PROCEDURE ( INPUT X_prop-map_obj.node-value-type).
     3168     END.
     3169   END.
     3170   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3171   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3172   MAIN-BLOCK:
     3173   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3174      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3175     IF lookup(p-list-mode, 'все':U + chr(44) + "dtm-code" + chr(44) + "dt-code") = 0  THEN DO:
     3176       MESSAGE
     3177       vss-workfile vss-revision vss-description SKIP
     3178       "Неверное значение параметра p-list-mode" p-list-mode
     3179       VIEW-AS ALERT-BOX.
     3180       UNDO, RETURN ERROR.
     3181     END.
     3182     if lookup(p-region, 'объект':U + chr(44) + 'фирма':U + chr(44) + "global")  = 0 then do:
     3183           MESSAGE
     3184           vss-workfile vss-revision vss-description SKIP
     3185           "Неверное значение параметра p-region" p-region SKIP
     3186           "Нет хранилища данных"  p-region
     3187           VIEW-AS ALERT-BOX.
     3188           UNDO, RETURN ERROR.
     3189     end.
     3190     IF p-list-mode = "dtm-code" THEN DO:
     3191       FIND FIRST buf_prop-head NO-LOCK WHERE
     3192                 buf_prop-head.dtm-code = p-dtm-code NO-ERROR.
     3193       IF NOT AVAILABLE buf_prop-head THEN DO:
     3194           MESSAGE
     3195           vss-workfile vss-revision vss-description SKIP
     3196           "Неверное значение параметра p-dtm-code" p-dtm-code SKIP
     3197           "Нет объекта-операнда c кодом"  p-dtm-code
     3198           VIEW-AS ALERT-BOX.
     3199           UNDO, RETURN ERROR.
     3200       END.
     3201     END.
     3202     IF p-list-mode = "dt-code"
     3203     OR (p-list-mode = "dtm-code" AND p-dt-code > 0) THEN DO:
     3204       FIND FIRST buf_prop-ref NO-LOCK WHERE
     3205                 buf_prop-ref.dt-code = p-dt-code NO-ERROR.
     3206       IF NOT AVAILABLE buf_prop-ref THEN DO:
     3207           MESSAGE
     3208           vss-workfile vss-revision vss-description SKIP
     3209           "Неверное значение параметра p-dt-code" p-dt-code SKIP
     3210           "Нет среза c кодом"  p-dt-code
     3211           VIEW-AS ALERT-BOX.
     3212           UNDO, RETURN ERROR.
     3213       END.
     3214       IF p-list-mode = "dtm-code"
     3215       AND p-dtm-code <> buf_prop-ref.dtm-code THEN DO:
     3216           MESSAGE
     3217           vss-workfile vss-revision vss-description SKIP
     3218           "Неверное значение параметра p-dt-code" p-dt-code SKIP
     3219           substitute("Код среза &1 соответствует  коду объекта &2, хотя p-dtm-code = &3"
     3220                      , p-dt-code
     3221                      , buf_prop-ref.dtm-code
     3222                      , p-dtm-code)
     3223           VIEW-AS ALERT-BOX.
     3224           UNDO, RETURN ERROR.
     3225       END.
     3226       FIND FIRST buf_prop-head NO-LOCK WHERE
     3227                 buf_prop-head.dtm-code = buf_prop-ref.dtm-code NO-ERROR.
     3228     END.
     3229     v-list-mode = p-list-mode.
     3230   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3231     run mainmenu_getcntxt in parparentproc
     3232       (output v-cntxt-db-num
     3233       ,output v-cntxt-userid
     3234       ,output v-cntxt-level
     3235       ,output v-cntxt-host-code-obj
     3236       ,output v-cntxt-obj-type
     3237       ,output v-cntxt-obj-code
     3238       ,output v-cntxt-db-num-obj
     3239       ,output v-cntxt-is-admin
     3240       ) .
     3241     run Myenable in this-procedure .
     3242     v-rid-list = p-rid-list.
     3243     WAIT-FOR GO OF FRAME Dialog-Frame.
     3244   END.
     3245   RUN disable_UI.
     3246   PROCEDURE disable_UI :
     3247     HIDE FRAME Dialog-Frame.
     3248   END PROCEDURE.
     3249   PROCEDURE enable_UI :
     3250     DISPLAY rs-region f-dtm-code f-dtm-name f-dt-code f-sum-id f-node-code
     3251             f-node-label mark-num
     3252         WITH FRAME Dialog-Frame.
     3253     ENABLE b-quit b-mark b-sel rs-region b-lkp b-card b-sch B-print b-history
     3254            B-Help b-dtm-code b-dt-code br-dis-prop_obj br-dis-prop_host
     3255            br-dis-prop_ mark-num
     3256         WITH FRAME Dialog-Frame.
     3257     VIEW FRAME Dialog-Frame.
     3258     OPEN QUERY br-dis-prop_ FOR EACH X_dis-prop_ NO-LOCK,            FIRST X_prop-ref_ NO-LOCK WHERE          X_prop-ref_.dt-code = X_dis-prop_.dt-code,            FIRST X_prop-map_  WHERE          X_prop-map_.dtm-code = X_dis-prop_.dtm-code     AND X_prop-map_.node-code = X_dis-prop_.node-code INDEXED-REPOSITION.    OPEN QUERY br-dis-prop_host FOR EACH X_dis-prop_host NO-LOCK,            FIRST X_prop-ref_host NO-LOCK WHERE          X_prop-ref_host.dt-code = X_dis-prop_host.dt-code ,            FIRST X_prop-map_host WHERE          X_prop-map_host.dtm-code = X_dis-prop_host.dtm-code     AND X_prop-map_host.node-code = X_dis-prop_host.node-code INDEXED-REPOSITION.    OPEN QUERY br-dis-prop_obj FOR EACH X_dis-prop_obj NO-LOCK,            FIRST X_prop-ref_obj NO-LOCK WHERE          X_prop-ref_obj.dt-code = X_dis-prop_obj.dt-code ,            FIRST X_prop-map_obj  WHERE           X_prop-map_obj.dtm-code = X_dis-prop_obj.dtm-code       AND X_prop-map_obj.node-code = X_dis-prop_obj.node-code INDEXED-REPOSITION.
     3259   END PROCEDURE.
     3260   PROCEDURE MyEnable :
     3261   DEFINE VARIABLE v-curr-r-b AS CHARACTER NO-UNDO.
     3262   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3263   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3264     (output v-curr-r-b
     3265     )  .
     3266   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     3267   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3268   if p-list-mode =  "dtm-code"
     3269   or p-list-mode = "dt-code"
     3270   or p-list-mode = "dt-node-code"
     3271   or p-list-mode = "node-code" then do:
     3272     assign
     3273     X_prop-ref_.dtm-code:visible in browse br-dis-prop_ = no
     3274     X_prop-ref_host.dtm-code:visible in browse br-dis-prop_host = no
     3275     X_prop-ref_obj.dtm-code:visible in browse br-dis-prop_obj = no
     3276     .
     3277   end.
     3278   ASSIGN
     3279   v-ch0 = br-dis-prop_:FIRST-COLUMN IN FRAME Dialog-Frame.
     3280   REPEAT WHILE valid-handle(v-ch0):
     3281      IF v-ch0:LABEL = "Значение!(строковое)" THEN
     3282      v-ch_[1] = v-ch0.
     3283      IF v-ch0:LABEL = "Значение!(Дата)" THEN
     3284      v-ch_[2] = v-ch0.
     3285      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN
     3286      v-ch_[3] = v-ch0.
     3287      IF v-ch0:LABEL = "Значение!(Целое)" THEN
     3288      v-ch_[4] = v-ch0.
     3289      IF v-ch0:LABEL = "Значение!(Логическое)" THEN
     3290      v-ch_[5] = v-ch0.
     3291      v-ch0 = v-ch0:NEXT-COLUMN.
     3292   END.
     3293   ASSIGN
     3294   v-ch0 = br-dis-prop_host:FIRST-COLUMN IN FRAME Dialog-Frame.
     3295   REPEAT WHILE valid-handle(v-ch0):
     3296      IF v-ch0:LABEL = "Значение!(строковое)" THEN
     3297      v-ch_host[1] = v-ch0.
     3298      IF v-ch0:LABEL = "Значение!(Дата)" THEN
     3299      v-ch_host[2] = v-ch0.
     3300      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN
     3301      v-ch_host[3] = v-ch0.
     3302      IF v-ch0:LABEL = "Значение!(Целое)" THEN
     3303      v-ch_host[4] = v-ch0.
     3304      IF v-ch0:LABEL = "Значение!(Логическое)" THEN
     3305      v-ch_host[5] = v-ch0.
     3306      v-ch0 = v-ch0:NEXT-COLUMN.
     3307   END.
     3308   ASSIGN
     3309   v-ch0 = br-dis-prop_obj:FIRST-COLUMN IN FRAME Dialog-Frame.
     3310   REPEAT WHILE valid-handle(v-ch0):
     3311      IF v-ch0:LABEL = "Значение!(строковое)" THEN
     3312      v-ch_obj[1] = v-ch0.
     3313      IF v-ch0:LABEL = "Значение!(Дата)" THEN
     3314      v-ch_obj[2] = v-ch0.
     3315      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN
     3316      v-ch_obj[3] = v-ch0.
     3317      IF v-ch0:LABEL = "Значение!(Целое)" THEN
     3318      v-ch_obj[4] = v-ch0.
     3319      IF v-ch0:LABEL = "Значение!(Логическое)" THEN
     3320      v-ch_obj[5] = v-ch0.
     3321      v-ch0 = v-ch0:NEXT-COLUMN.
     3322   END.
     3323   ASSIGN
     3324   rs-region:RADIO-BUTTONS IN FRAME Dialog-Frame  = "Объекты" + chr(44) + 'объект':U + chr(44) +
     3325                           "Фирмы" + chr(44) + 'фирма':U + chr(44) +
     3326                           "Глобально" + chr(44) + "global"
     3327   rs-region = (IF p-region = '':U
     3328                THEN 'объект':U
     3329                ELSE p-region)
     3330   .
     3331   if p-list-mode = "dtm-code"
     3332   or p-list-mode = "dt-code"
     3333   then do:
     3334     assign
     3335     f-dtm-code  = buf_prop-head.dtm-code
     3336     f-dtm-name  = buf_prop-head.prop-label
     3337     .
     3338   end.
     3339   else do:
     3340     f-dtm-code = ?.
     3341   end.
     3342   if p-list-mode = "dt-code"
     3343   or (p-list-mode = "dtm-code" and p-dt-code > 0)
     3344   then do:
     3345     assign
     3346     f-dt-code  = buf_prop-ref.dtm-code
     3347     f-sum-id   = buf_prop-ref.sum-id
     3348     .
     3349   end.
     3350   else do:
     3351     f-dt-code = ?.
     3352   end.
     3353   f-node-code = ?.
     3354   display
     3355   f-dtm-code
     3356   f-dtm-name
     3357   f-dt-code
     3358   f-sum-id
     3359   with frame Dialog-Frame .
     3360   ENABLE
     3361   rs-region
     3362   b-quit
     3363   b-lkp
     3364   B-Help
     3365   b-mark when lookup("b-mark", bttns) > 0
     3366   b-sel when lookup("b-sel", bttns) > 0
     3367   b-card
     3368   b-sch
     3369   b-print
     3370   b-history
     3371   b-dtm-code WHEN (p-list-mode <> "dtm-code")
     3372   b-dt-code WHEN (p-list-mode <> "dt-code"
     3373                   AND NOT (p-list-mode = "dtm-code" AND p-dt-code > 0)
     3374                   and NOT (p-list-mode = "dtm-code" AND p-dtm-code = 1)
     3375                   )
     3376   b-node-code WHEN (f-dtm-code <> 0 AND f-dtm-code <> ?)
     3377   br-dis-prop_obj
     3378   br-dis-prop_host
     3379   br-dis-prop_
     3380   WITH FRAME Dialog-Frame.
     3381   VIEW FRAME Dialog-Frame.
     3382   if available buf_prop-head then do:
     3383     if buf_prop-head.storage-place = '':U
     3384     or buf_prop-head.storage-place = chr(63)
     3385     or buf_prop-head.storage-place = ? then do:
     3386       rs-region:disable(radio-label("global", rs-region:radio-buttons)).
     3387     end.
     3388     if buf_prop-head.storage-place-host = '':U
     3389     or buf_prop-head.storage-place-host = chr(63)
     3390     or buf_prop-head.storage-place-host = ? then do:
     3391       rs-region:disable(radio-label('фирма':U, rs-region:radio-buttons)).
     3392     end.
     3393     if buf_prop-head.storage-place-obj = '':U
     3394     or buf_prop-head.storage-place-obj = chr(63)
     3395     or buf_prop-head.storage-place-obj = ? then do:
     3396       rs-region:disable(radio-label('объект':U, rs-region:radio-buttons)).
     3397     end.
     3398   end.
     3399   run Openbr in this-procedure ( input yes, input no, input '':U).
     3400   END PROCEDURE.
     3401   PROCEDURE Openbr :
     3402   define input  parameter p-open-query     as logical   no-undo .
     3403   define input  parameter p-find-next      as logical   no-undo .
     3404   define input  parameter p-find-condition as character no-undo .
     3405   define variable v-datatype as logical no-undo extent 5.
     3406   define buffer buf_prop-map for ub.prop-map.
     3407   CASE rs-region:
     3408     WHEN 'объект':U THEN DO:
     3409       RUN Openbr_obj ( INPUT p-open-query
     3410                       ,INPUT p-find-next
     3411                       ,INPUT p-find-condition).
     3412       br-dis-prop_obj:move-to-top() in frame Dialog-Frame .
     3413       if f-dtm-code > 0 then do:
     3414         for each buf_prop-map no-lock where
     3415                 buf_prop-map.dtm-code = f-dtm-code:
     3416           if entry(1, buf_prop-map.node-value-type) = 'character':U then do:
     3417             v-datatype[1] = yes.
     3418           end.
     3419           if entry(1, buf_prop-map.node-value-type) = 'date':U then do:
     3420             v-datatype[2] = yes.
     3421           end.
     3422           if entry(1, buf_prop-map.node-value-type) = 'decimal':U then do:
     3423             v-datatype[3] = yes.
     3424           end.
     3425           if entry(1, buf_prop-map.node-value-type) = 'integer':U then do:
     3426             v-datatype[4] = yes.
     3427           end.
     3428           if entry(1, buf_prop-map.node-value-type) = 'logical':U then do:
     3429             v-datatype[5] = yes.
     3430           end.
     3431         end.
     3432         assign
     3433         v-ch_obj[1]:visible = v-datatype[1]
     3434         v-ch_obj[2]:visible = v-datatype[2]
     3435         v-ch_obj[3]:visible = v-datatype[3]
     3436         v-ch_obj[4]:visible = v-datatype[4]
     3437         v-ch_obj[5]:visible = v-datatype[5]
     3438         .
     3439       end.
     3440       else do:
     3441         assign
     3442         v-ch_obj[1]:visible = yes
     3443         v-ch_obj[2]:visible = yes
     3444         v-ch_obj[3]:visible = yes
     3445         v-ch_obj[4]:visible = yes
     3446         v-ch_obj[5]:visible = yes
     3447         .
     3448       end.
     3449       apply "ENTRY" to br-dis-prop_obj.
     3450       apply "VALUE-CHANGED" to br-dis-prop_obj.
     3451     END.
     3452     WHEN 'фирма':U THEN DO:
     3453       RUN Openbr_host ( INPUT p-open-query
     3454                         ,INPUT p-find-next
     3455                         ,INPUT p-find-condition).
     3456       br-dis-prop_host:move-to-top().
     3457       if f-dtm-code > 0 then do:
     3458         for each buf_prop-map no-lock where
     3459                 buf_prop-map.dtm-code = f-dtm-code:
     3460           if entry(1, buf_prop-map.node-value-type) = 'character':U then do:
     3461             v-datatype[1] = yes.
     3462           end.
     3463           if entry(1, buf_prop-map.node-value-type) = 'date':U then do:
     3464             v-datatype[2] = yes.
     3465           end.
     3466           if entry(1, buf_prop-map.node-value-type) = 'decimal':U then do:
     3467             v-datatype[3] = yes.
     3468           end.
     3469           if entry(1, buf_prop-map.node-value-type) = 'integer':U then do:
     3470             v-datatype[4] = yes.
     3471           end.
     3472           if entry(1, buf_prop-map.node-value-type) = 'logical':U then do:
     3473             v-datatype[5] = yes.
     3474           end.
     3475         end.
     3476         assign
     3477         v-ch_host[1]:visible = v-datatype[1]
     3478         v-ch_host[2]:visible = v-datatype[2]
     3479         v-ch_host[3]:visible = v-datatype[3]
     3480         v-ch_host[4]:visible = v-datatype[4]
     3481         v-ch_host[5]:visible = v-datatype[5]
     3482         .
     3483       end.
     3484       else do:
     3485         assign
     3486         v-ch_obj[1]:visible = yes
     3487         v-ch_obj[2]:visible = yes
     3488         v-ch_obj[3]:visible = yes
     3489         v-ch_obj[4]:visible = yes
     3490         v-ch_obj[5]:visible = yes
     3491         .
     3492       end.
     3493       apply "ENTRY" to br-dis-prop_host.
     3494       apply "VALUE-CHANGED" to br-dis-prop_host.
     3495     END.
     3496     WHEN "global" THEN DO:
     3497       RUN Openbr_ ( INPUT p-open-query
     3498                         ,INPUT p-find-next
     3499                         ,INPUT p-find-condition).
     3500       br-dis-prop_:move-to-top().
     3501       if f-dtm-code > 0 then do:
     3502         for each buf_prop-map no-lock where
     3503                 buf_prop-map.dtm-code = f-dtm-code:
     3504           if entry(1, buf_prop-map.node-value-type) = 'character':U then do:
     3505             v-datatype[1] = yes.
     3506           end.
     3507           if entry(1, buf_prop-map.node-value-type) = 'date':U then do:
     3508             v-datatype[2] = yes.
     3509           end.
     3510           if entry(1, buf_prop-map.node-value-type) = 'decimal':U then do:
     3511             v-datatype[3] = yes.
     3512           end.
     3513           if entry(1, buf_prop-map.node-value-type) = 'integer':U then do:
     3514             v-datatype[4] = yes.
     3515           end.
     3516           if entry(1, buf_prop-map.node-value-type) = 'logical':U then do:
     3517             v-datatype[5] = yes.
     3518           end.
     3519         end.
     3520         assign
     3521         v-ch_[1]:visible = v-datatype[1]
     3522         v-ch_[2]:visible = v-datatype[2]
     3523         v-ch_[3]:visible = v-datatype[3]
     3524         v-ch_[4]:visible = v-datatype[4]
     3525         v-ch_[5]:visible = v-datatype[5]
     3526         .
     3527        end.
     3528        else do:
     3529         assign
     3530         v-ch_obj[1]:visible = yes
     3531         v-ch_obj[2]:visible = yes
     3532         v-ch_obj[3]:visible = yes
     3533         v-ch_obj[4]:visible = yes
     3534         v-ch_obj[5]:visible = yes
     3535         .
     3536       end.
     3537       apply "ENTRY" to br-dis-prop_.
     3538       apply "VALUE-CHANGED" to br-dis-prop_.
     3539     END.
     3540   END CASE.
     3541   END PROCEDURE.
     3542   PROCEDURE Openbr_ :
     3543   define input  parameter p-open-query     as logical   no-undo .
     3544   define input  parameter p-find-next      as logical   no-undo .
     3545   define input  parameter p-find-condition as character no-undo .
     3546   define variable l-query-was-opened as logical no-undo .
     3547   run waitfram-show in this-procedure ("Ждите...").
     3548   define variable sort-column-phrase as character no-undo .
     3549   case sort-column-name :
     3550     when "" then do:
     3551       assign
     3552         sort-column-phrase = ""
     3553       .
     3554     end.
     3555     otherwise do:
     3556       assign
     3557         sort-column-phrase = "by " + sort-column-name
     3558       .
     3559     end.
     3560   end case.
     3561   define variable l-open-query as logical   no-undo .
     3562   filter-point = filter-point0 + v-list-mode.
     3563   CASE v-list-mode :
     3564     WHEN 'все':U        THEN DO:
     3565       assign
     3566       filter-point-label = substitute("Все срезы по ДК по фирмам")
     3567       frame Dialog-Frame:title = filter-point-label
     3568       .
     3569   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3570   define variable  l-disable-where-22  as logical   no-undo .
     3571   define variable  l-filter-open-22    as logical   .
     3572   define variable  flt-rec-22       as recid     no-undo .
     3573   define variable  filter-name-22      as character no-undo .
     3574   define variable  where-phrase-22     as character no-undo .
     3575   define variable  sort-phrase-22      as character no-undo .
     3576   define variable  where-phrase-rus-22 as character no-undo .
     3577   define variable  sort-phrase-rus-22  as character no-undo .
     3578     run waitfram-show in this-procedure
     3579       (input "ЖДИТЕ ..."
     3580       ).
     3581   run gbl/flt-get.p
     3582     (input filter-point
     3583     ,output flt-rec-22
     3584     ,output filter-name-22
     3585     ,output where-phrase-22
     3586     ,output sort-phrase-22
     3587     ,output where-phrase-rus-22
     3588     ,output sort-phrase-rus-22
     3589     ).
     3590   if p-open-query then do:
     3591       run set-filter-name in this-procedure
     3592         (INPUT filter-name-22
     3593         ) no-error .
     3594     assign
     3595       l-filter-open-22 = false
     3596     .
     3597     if flt-rec-22 <> ?
     3598       or sort-column-phrase > ""
     3599     then do:
     3600       define variable  parameter-2-22 as character no-undo .
     3601       define variable  parameter-3-22 as character no-undo .
     3602       define variable  parameter-4-22 as character no-undo .
     3603       define variable  parameter-5-22 as character no-undo .
     3604       define variable  parameter-6-22 as character no-undo .
     3605       define variable  parameter-7-22 as character no-undo .
     3606         assign
     3607         parameter-3-22 =
     3608                                 "FOR EACH X_dis-prop_ NO-LOcK"
     3609         parameter-4-22 =
     3610           (
     3611             if (" X_dis-prop_.host-code = 0 " + " " + where-phrase-22) <> ""
     3612             then " X_dis-prop_.host-code = 0 " + " " + where-phrase-22
     3613             else "true"
     3614           )
     3615         parameter-5-22 = (" " + "" + " " + ", FIRST X_prop-ref_ NO-LOCK WHERE X_prop-ref_.dt-code = X_dis-prop_.dt-code                                     , FIRST X_prop-map_ no-lock where X_prop-map_.node-code = X_dis-prop_.node-code and                                                                       X_prop-map_.dtm-code = X_dis-prop_.dtm-code")
     3616         parameter-6-22 = if sort-phrase-22 = ''
     3617                              then
     3618           (
     3619           " " + "  " +
     3620             " " + sort-column-phrase +
     3621           " " + " by X_dis-prop_.d-card "
     3622           )
     3623                              else
     3624           (
     3625           " " + "  " +
     3626             " " + sort-column-phrase +
     3627           " " + sort-phrase-22
     3628           )
     3629         parameter-7-22 =
     3630           " indexed-reposition  "
     3631       .
     3632       do
     3633       on stop undo, leave
     3634       on error undo, leave
     3635       :
     3636         assign
     3637           l-disable-where-22 =
     3638             (" X_dis-prop_.host-code = 0 " + " " + where-phrase-22 = "")
     3639         .
     3640         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3641                             ,input QUERY br-dis-prop_:handle
     3642                             ,input parameter-3-22
     3643                             ,input parameter-4-22
     3644                             ,input parameter-5-22
     3645                             ,input parameter-6-22
     3646                             ,input parameter-7-22
     3647                             )
     3648         .
     3649         assign
     3650           l-filter-open-22 = true
     3651         .
     3652       end.
     3653       if l-filter-open-22 = false then do:
     3654         message
     3655           "Ошибка при фильтрации / сортировке" skip
     3656           "Будут показаны записи без учета фильтра" skip
     3657           view-as alert-box .
     3658       end.
     3659       else do:
     3660           assign
     3661             l-query-was-opened = true
     3662           .
     3663       end.
     3664     end.
     3665     if l-filter-open-22 = false then do:
     3666       OPEN QUERY br-dis-prop_ FOR EACH X_dis-prop_ NO-LOcK
     3667         where  X_dis-prop_.host-code = 0
     3668       , FIRST X_prop-ref_ NO-LOCK WHERE X_prop-ref_.dt-code = X_dis-prop_.dt-code                                     , FIRST X_prop-map_ no-lock where X_prop-map_.node-code = X_dis-prop_.node-code and                                                                       X_prop-map_.dtm-code = X_dis-prop_.dtm-code
     3669          by X_dis-prop_.d-card
     3670         indexed-reposition
     3671     .
     3672         assign
     3673           l-query-was-opened = true
     3674         .
     3675     end.
     3676   end.
     3677   else do:
     3678     assign
     3679       v-doc-rec = recid( X_dis-prop_ )
     3680     .
     3681     do
     3682     on stop undo, leave
     3683     on error undo, leave
     3684     :
     3685       if QUERY br-dis-prop_:handle:get-buffer-handle(1) = (buffer X_dis-prop_:handle) then do:
     3686         assign
     3687         parameter-2-22 = (if p-find-next then "true":u else "false":u )
     3688         parameter-4-22 =
     3689           "where ":u + " X_dis-prop_.host-code = 0 " + " ":u + where-phrase-22 + " ":u + p-find-condition + " " + ""
     3690         parameter-5-22 = "  "
     3691       .
     3692         run fltopend_fltfindd in this-procedure  (
     3693                             input this-procedure:handle
     3694                             ,input QUERY br-dis-prop_:handle
     3695                             ,input rowid(X_dis-prop_)
     3696                             ,input logical(parameter-2-22)
     3697                             ,input no-lock
     3698                             ,input (buffer X_dis-prop_:handle)
     3699                             ,input parameter-4-22
     3700                             ,input parameter-5-22
     3701                             ) no-error.
     3702         .
     3703         assign
     3704           v-doc-rec = integer(return-value)
     3705           v-fltopend-rowid[1] = ?
     3706         .
     3707       end.
     3708       else do:
