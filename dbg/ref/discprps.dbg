     2386     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2387     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2388     if p-change-value > 0
     2389     then do:
     2390       if frame Dialog-Frame :width + p-change-value >
     2391           session :width-chars
     2392       then do:
     2393         assign
     2394           p-change-value = session :width-chars - frame Dialog-Frame :width
     2395         .
     2396         if p-change-value <= 0
     2397         then do:
     2398           run diasize_position-resize-button in this-procedure .
     2399           return .
     2400         end.
     2401       end.
     2402     end.
     2403     if p-change-value < 0
     2404     then do:
     2405       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2406       then do:
     2407         assign
     2408           p-change-value = v-diasize-orig-frame-width
     2409                          - frame Dialog-Frame :width
     2410         .
     2411         if p-change-value >= 0
     2412         then do:
     2413           run diasize_position-resize-button in this-procedure .
     2414           return .
     2415         end.
     2416       end.
     2417     end.
     2418     if p-change-value >= 0
     2419     then do:
     2420       assign
     2421         v-change-sign = 1
     2422       .
     2423     end.
     2424     else do:
     2425       assign
     2426         v-change-sign = -1
     2427       .
     2428     end.
     2429     assign
     2430       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2431     .
     2432     if p-change-value = 0
     2433     then do:
     2434       run diasize_position-resize-button in this-procedure .
     2435       return .
     2436     end.
