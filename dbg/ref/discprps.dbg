      406   procedure fltfield-clear :
      407     define output parameter loc-fld as character no-undo.
      408     define output parameter loc-lab as character no-undo .
      409     define output parameter loc-spr as character no-undo .
      410     define output parameter loc-dim as character no-undo .
      411     assign
      412       loc-fld = ""
      413       loc-lab = ""
      414       loc-spr = ""
      415       loc-dim = "0"
      416     .
      417   end procedure .
      418   procedure fltfield-add :
      419     define input        parameter par-fld as character no-undo.
      420     define input        parameter par-lab as character no-undo .
      421     define input        parameter par-spr as character no-undo .
      422     define input-output parameter loc-fld as character no-undo.
      423     define input-output parameter loc-lab as character no-undo .
      424     define input-output parameter loc-spr as character no-undo .
      425     define input-output parameter loc-dim as character no-undo .
      426     do
      427     on error undo, return error
      428     :
      429       assign
      430       loc-fld = if loc-dim = '0'
      431                 then par-fld
      432                 else (loc-fld + chr(44) + par-fld)
      433       loc-lab = if loc-dim = '0'
      434                 then par-lab
      435                 else (loc-lab + chr(44) + par-lab)
      436       loc-spr = if loc-dim = '0'
      437                 then par-spr
      438                 else (loc-spr + chr(44) + par-spr)
      439       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      440                 string(integer(if num-entries(loc-dim) > 1
      441                               then entry(2, loc-dim)
      442                               else entry(1, loc-dim)
      443                               ) + 1)
      444       no-error
      445       .
      446     end.
      447   end procedure.
