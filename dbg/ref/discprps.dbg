     1323   DEFINE QUERY br-dis-prop_ FOR
     1324                   X_dis-prop_,
     1325                   X_prop-ref_,
     1326                   X_prop-map_ SCROLLING.
     1327   DEFINE QUERY br-dis-prop_host FOR
     1328                   X_dis-prop_host,
     1329                   X_prop-ref_host,
     1330                   X_prop-map_host SCROLLING.
     1331   DEFINE QUERY br-dis-prop_obj FOR
     1332                   X_dis-prop_obj,
     1333                   X_prop-ref_obj,
     1334                   X_prop-map_obj SCROLLING.
     1335   DEFINE BROWSE br-dis-prop_
     1336     QUERY br-dis-prop_ NO-LOCK DISPLAY
     1337         mark-string(recid(X_dis-prop_), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
     1338   X_prop-ref_.sum-id COLUMN-LABEL "Идентификатор"
     1339   X_prop-ref_.dtm-code COLUMN-LABEL "Код!объекта-!операнда" format ">>9"
     1340   X_dis-prop_.d-card COLUMN-LABEL "№ ДК" FORMAT "X(19)"
     1341   X_prop-map_.node-name COLUMN-LABEL "Свойство" FORMAT "X(20)"
     1342   (IF entry(1, X_prop-map_.node-value-type) = 'character':U
     1343   THEN display-character(X_dis-prop_.property-value-character, X_prop-map_.node-format)
     1344   ELSE '':U) COLUMN-LABEL "Значение!(строковое)" format "X(255)" WIDTH 40
     1345   (IF entry(1, X_prop-map_.node-value-type) = 'date':U
     1346   THEN STRING(X_dis-prop_.property-value-date,  X_prop-map_.node-format)
     1347   ELSE '':U) COLUMN-LABEL "Значение!(Дата)" format "X(10)"
     1348   (IF entry(1, X_prop-map_.node-value-type) = 'decimal':U
     1349   THEN STRING(X_dis-prop_.property-value-decimal, X_prop-map_.node-format)
     1350   ELSE '':U)  COLUMN-LABEL "Значение!(Десятичное)" format "X(24)"
     1351   (IF entry(1, X_prop-map_.node-value-type) = 'integer':U
     1352   THEN STRING(X_dis-prop_.property-value-integer, X_prop-map_.node-format)
     1353   ELSE '':U) COLUMN-LABEL "Значение!(Целое)" format "X(14)"
     1354   (IF entry(1, X_prop-map_.node-value-type) = 'logical':U
     1355   THEN STRING(X_dis-prop_.property-value-logical, X_prop-map_.node-format)
     1356   ELSE '':U) COLUMN-LABEL "Значение!(Логическое)" FORMAT "X(2)"
     1357   X_prop-ref_.caller_id COLUMN-LABEL "Доп!Идентификатор"
     1358       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 17.87
     1359            FONT 4 FIT-LAST-COLUMN.
     1360   DEFINE BROWSE br-dis-prop_host
     1361     QUERY br-dis-prop_host NO-LOCK DISPLAY
     1362         mark-string(recid(X_dis-prop_host), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
     1363   X_prop-ref_host.sum-id COLUMN-LABEL "Идентификатор"
     1364   X_prop-ref_host.dtm-code COLUMN-LABEL "Код!объекта-!операнда" format ">>9"
     1365   X_dis-prop_host.d-card COLUMN-LABEL "№ ДК" FORMAT "X(19)"
     1366   X_dis-prop_host.host-code COLUMN-LABEL "Код!фирмы" FORMAT ">>>>9"
     1367   X_prop-map_host.node-name COLUMN-LABEL "Свойство" FORMAT "X(20)"
     1368   (IF entry(1, X_prop-map_host.node-value-type) = 'character':U
     1369   THEN display-character(X_dis-prop_host.property-value-character, X_prop-map_host.node-format)
     1370   ELSE '':U) COLUMN-LABEL "Значение!(строковое)" format "X(255)" WIDTH 40
     1371   (IF entry(1, X_prop-map_host.node-value-type) = 'date':U
     1372   THEN STRING(X_dis-prop_host.property-value-date,  X_prop-map_host.node-format)
     1373   ELSE '':U) COLUMN-LABEL "Значение!(Дата)" format "X(10)"
     1374   (IF entry(1, X_prop-map_host.node-value-type) = 'decimal':U
     1375   THEN STRING(X_dis-prop_host.property-value-decimal, X_prop-map_host.node-format)
     1376   ELSE '':U)  COLUMN-LABEL "Значение!(Десятичное)" format "X(24)"
     1377   (IF entry(1, X_prop-map_host.node-value-type) = 'integer':U
     1378   THEN STRING(X_dis-prop_host.property-value-integer, X_prop-map_host.node-format)
     1379   ELSE '':U) COLUMN-LABEL "Значение!(Целое)" format "X(14)"
     1380   (IF entry(1, X_prop-map_host.node-value-type) = 'logical':U
     1381   THEN STRING(X_dis-prop_host.property-value-logical, X_prop-map_host.node-format)
     1382   ELSE '':U) COLUMN-LABEL "Значение!(Логическое)" FORMAT "X(2)"
     1383   X_prop-ref_host.caller_id COLUMN-LABEL "Доп!Идентификатор"
     1384       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 17.87
     1385            FONT 4 FIT-LAST-COLUMN.
     1386   DEFINE BROWSE br-dis-prop_obj
     1387     QUERY br-dis-prop_obj NO-LOCK DISPLAY
     1388         mark-string(recid(X_dis-prop_obj), v-rid-list) Format "X(1)" COLUMN-LABEL "*"
     1389   X_prop-ref_obj.sum-id COLUMN-LABEL "Идентификатор"
     1390   X_prop-ref_obj.dtm-code COLUMN-LABEL "Код!объекта-!операнда" format ">>9"
     1391   X_dis-prop_obj.d-card COLUMN-LABEL "№ ДК" FORMAT "X(19)"
     1392   X_dis-prop_obj.obj-code COLUMN-LABEL "Код!объекта" FORMAT ">>>>9"
     1393   X_dis-prop_obj.obj-type COLUMN-LABEL "Тип!объекта" FORMAT "X(3)"
     1394   X_prop-map_obj.node-name COLUMN-LABEL "Свойство" FORMAT "X(20)"
     1395   (IF entry(1, X_prop-map_obj.node-value-type) = 'character':U
     1396   THEN display-character(X_dis-prop_obj.property-value-character, X_prop-map_obj.node-format)
     1397   ELSE '':U) COLUMN-LABEL "Значение!(строковое)" format "X(255)" WIDTH 40
     1398   (IF entry(1, X_prop-map_obj.node-value-type) = 'date':U
     1399   THEN STRING(X_dis-prop_obj.property-value-date,  X_prop-map_obj.node-format)
     1400   ELSE '':U) COLUMN-LABEL "Значение!(Дата)" format "X(10)"
     1401   (IF entry(1, X_prop-map_obj.node-value-type) = 'decimal':U
     1402   THEN STRING(X_dis-prop_obj.property-value-decimal, X_prop-map_obj.node-format)
     1403   ELSE '':U)  COLUMN-LABEL "Значение!(Десятичное)" format "X(24)"
     1404   (IF entry(1, X_prop-map_obj.node-value-type) = 'integer':U
     1405   THEN STRING(X_dis-prop_obj.property-value-integer, X_prop-map_obj.node-format)
     1406   ELSE '':U) COLUMN-LABEL "Значение!(Целое)" format "X(14)"
     1407   (IF entry(1, X_prop-map_obj.node-value-type) = 'logical':U
     1408   THEN STRING(X_dis-prop_obj.property-value-logical, X_prop-map_obj.node-format)
     1409   ELSE '':U) COLUMN-LABEL "Значение!(Логическое)" FORMAT "X(2)"
     1410   X_prop-ref_obj.caller_id COLUMN-LABEL "Доп!Идентификатор"
     1411       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 17.87
     1412            FONT 4 FIT-LAST-COLUMN.
     1413   DEFINE FRAME Dialog-Frame
     1414        b-quit AT ROW 1 COL 1
     1415        b-mark AT ROW 1 COL 21 WIDGET-ID 12
     1416        b-sel AT ROW 1 COL 25 WIDGET-ID 10
     1417        rs-region AT ROW 1 COL 35 NO-LABEL WIDGET-ID 26
     1418        b-lkp AT ROW 1 COL 66 WIDGET-ID 6
     1419        b-card AT ROW 1 COL 76 WIDGET-ID 16
     1420        b-sch AT ROW 1 COL 86 WIDGET-ID 2
     1421        B-print AT ROW 1 COL 89 WIDGET-ID 20
     1422        b-history AT ROW 1 COL 92 WIDGET-ID 18
     1423        B-Help AT ROW 1 COL 95
     1424        f-dtm-code AT ROW 2 COL 1 WIDGET-ID 34
     1425        b-dtm-code AT ROW 2 COL 22.5 WIDGET-ID 32
     1426        f-dtm-name AT ROW 2 COL 25.5 NO-LABEL WIDGET-ID 30
     1427        f-dt-code AT ROW 3 COL 3 WIDGET-ID 36
     1428        b-dt-code AT ROW 3 COL 22.5 WIDGET-ID 38
     1429        f-sum-id AT ROW 3 COL 25.5 NO-LABEL WIDGET-ID 40
     1430        f-node-code AT ROW 4 COL 3 WIDGET-ID 44
     1431        b-node-code AT ROW 4 COL 22.5 WIDGET-ID 42
     1432        f-node-label AT ROW 4 COL 25.5 NO-LABEL WIDGET-ID 46
     1433        br-dis-prop_obj AT ROW 5 COL 1.5 WIDGET-ID 100
     1434        br-dis-prop_host AT ROW 5 COL 1.5 WIDGET-ID 200
     1435        br-dis-prop_ AT ROW 5 COL 1.5 WIDGET-ID 300
     1436        mark-num AT ROW 1 COL 9 COLON-ALIGNED NO-LABEL WIDGET-ID 14
     1437        SPACE(78.50) SKIP(21.21)
     1438       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1439            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1440            TITLE ""
     1441            CANCEL-BUTTON b-quit.
     1442   ASSIGN
     1443          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1444          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1445   ON GO OF FRAME Dialog-Frame
     1446   DO:
     1447     p-rid-list = v-rid-list.
     1448   END.
     1449   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1450   DO:
     1451     APPLY "END-ERROR":U TO SELF.
     1452   END.
     1453   ON CHOOSE OF b-card IN FRAME Dialog-Frame
     1454   DO:
     1455   DEFINE VARIABLE v-d-card AS CHARACTER NO-UNDO.
     1456   DEFINE variable v-ri as recid no-undo .
     1457   define buffer buf_dis-card for ub.dis-card.
     1458   CASE rs-region:
     1459     WHEN 'объект':U THEN DO:
     1460       IF NOT AVAILABLE X_dis-prop_obj THEN RETURN NO-APPLY.
     1461       v-d-card = X_dis-prop_obj.d-card.
     1462     END.
     1463     WHEN 'фирма':U THEN DO:
     1464       IF NOT AVAILABLE X_dis-prop_host THEN RETURN NO-APPLY.
     1465       v-d-card = X_dis-prop_host.d-card.
     1466     END.
     1467     WHEN "global" THEN DO:
     1468       IF NOT AVAILABLE X_dis-prop_ THEN RETURN NO-APPLY.
     1469       v-d-card = X_dis-prop_.d-card.
     1470     END.
     1471   END CASE.
     1472   find first buf_dis-card no-lock where
     1473              buf_dis-card.d-card = v-d-card no-error .
     1474   if avail buf_dis-card then do:
     1475     assign
     1476     v-ri = recid( buf_dis-card )
     1477    .
     1478     run ref/dcardi.w (
     1479                   input parparentproc
     1480                 , input 'ПРОСМОТР':U
     1481                 , input buf_dis-card.emitent-host-code
     1482                 , input p-curr-host-code
     1483                 , input p-curr-obj-type
     1484                 , input p-curr-obj-code
     1485                 , input ?
     1486                 , input-output v-ri ) .
     1487   END.
     1488   END.
     1489   ON CHOOSE OF b-dt-code IN FRAME Dialog-Frame
     1490   DO:
     1491   DEFINE variable v-ref-list AS CHARACTER NO-UNDO.
     1492   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
     1493   run ref/proprefs.w (
     1494                   input parparentproc
     1495                 ,input 'b-sel'
     1496                 ,input (if f-dtm-code = ?
     1497                         then 'dis-card-property':U
     1498                         else "dtm-code")
     1499                 ,input (if f-dtm-code = ? then 0 else f-dtm-code)
     1500                 ,input '':U
     1501                 ,input '':U
     1502                 ,input-output  v-ref-list) no-error.
     1503   if error-status:error or v-ref-list = '':u then do:
     1504     v-list-mode = p-list-mode.
     1505     assign
     1506     f-dt-code = ?
     1507     f-sum-id = '':U.
     1508     DISPLAY
     1509     f-sum-id
     1510     f-dt-code
     1511     WITH FRAME Dialog-Frame.
     1512     run openbr in this-procedure ( input yes, input no, input '':U).
     1513     return.
     1514   end.
     1515   find first buf_prop-ref no-lock where
     1516             recid(buf_prop-ref) = integer(v-ref-list) no-error.
     1517   if not available buf_prop-ref then return.
     1518   if buf_prop-ref.dt-code = f-dt-code then return no-apply.
     1519   ASSIGN
     1520   f-dt-code = buf_prop-ref.dt-code
     1521   f-sum-id = buf_prop-ref.sum-id.
     1522   DISPLAY
     1523   f-sum-id
     1524   f-dt-code
     1525   WITH FRAME Dialog-Frame.
     1526   if f-node-code = ? then do:
     1527     v-list-mode ="dt-code".
     1528   end.
     1529   else do:
     1530     v-list-mode ="dt-node-code".
     1531   end.
     1532   run openbr in this-procedure ( input yes, input no, input '':U).
     1533   END.
     1534   ON CHOOSE OF b-dtm-code IN FRAME Dialog-Frame
     1535   DO:
     1536   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1537   DEFINE BUFFER buf_prop-head FOR ub.prop-head.
     1538    run rul/prop-head-s.w ( INPUT parparentproc
     1539                            ,INPUT "b-sel"
     1540                            ,input "general-view"
     1541                            ,input 'dc-prop':U
     1542                            ,input-output v-rid-list ) NO-ERROR.
     1543    IF ERROR-STATUS:error OR v-rid-list = '':U THEN DO:
     1544       UNDO, RETURN NO-APPLY.
     1545    END.
     1546    FIND FIRST buf_prop-head NO-LOCK WHERE
     1547              recid(buf_prop-head) = INTEGER(v-rid-list) NO-ERROR.
     1548    IF NOT AVAILABLE buf_prop-head  THEN DO:
     1549       assign
     1550       f-dt-code = ?
     1551       f-sum-id = '':U
     1552       f-dtm-code = ?
     1553       f-dtm-name = '':U
     1554       f-node-code = ?
     1555       f-node-label = '':U
     1556       .
     1557       DISABLE
     1558       b-node-code
     1559       WITH FRAME Dialog-Frame.
     1560       DISPLAY
     1561       f-sum-id
     1562       f-dtm-code
     1563       f-dtm-name
     1564       f-dt-code
     1565       f-node-code
     1566       f-node-label
     1567       WITH FRAME Dialog-Frame.
     1568      v-list-mode = p-list-mode.
     1569      run openbr in this-procedure ( input yes, input no, input '':U).
     1570      RETURN.
     1571    END.
     1572    if buf_prop-head.dtm-code = f-dtm-code then return no-apply.
     1573    assign
     1574    f-dtm-code = buf_prop-head.dtm-code
     1575    f-dtm-name = buf_prop-head.prop-label
     1576    .
     1577    display
     1578    f-dtm-code
     1579    f-dtm-name
     1580    with frame Dialog-Frame .
     1581    ENABLE
     1582    b-node-code
     1583    WITH FRAME Dialog-Frame.
     1584    v-list-mode = "dtm-code".
     1585    run openbr in this-procedure ( input yes, input no, input '':U).
     1586   END.
     1587   ON CHOOSE OF b-history IN FRAME Dialog-Frame
     1588   DO:
     1589   define variable parref-list as character no-undo .
     1590   CASE rs-region:
     1591     when 'объект':U then do:
     1592       if available X_dis-prop_obj  then do:
     1593         run ref/cdchist.w (
     1594                           INPUT parparentproc
     1595                           ,input p-curr-host-code
     1596                           ,input p-curr-obj-type
     1597                           ,input p-curr-obj-code
     1598                           ,input "":U
     1599                           ,input "subject":U
     1600                           ,input X_dis-prop_obj.d-card
     1601                           ,input ?
     1602                           ,input X_dis-prop_obj.obj-type
     1603                           ,input X_dis-prop_obj.obj-code
     1604                           ,input X_dis-prop_obj.host-code
     1605                           ,input ?
     1606                           ,input "":U
     1607                           ,input 'dis-card-property':U
     1608                           ,input ?
     1609                           ,input-output parref-list
     1610                       ) no-error .
     1611           apply "entry" to br-dis-prop_obj.
     1612        end.
     1613      end.
     1614      when 'фирма':U then do:
     1615        if available X_dis-prop_host then do:
     1616         run ref/cdchist.w (
     1617                             INPUT parparentproc
     1618                             ,input p-curr-host-code
     1619                             ,input p-curr-obj-type
     1620                             ,input p-curr-obj-code
     1621                             ,input "":U
     1622                             ,input "subject"
     1623                             ,input X_dis-prop_host.d-card
     1624                             ,input ?
     1625                             ,input '':U
     1626                             ,input 0
     1627                             ,input X_dis-prop_host.host-code
     1628                             ,input ?
     1629                             ,input "":U
     1630                             ,input 'dis-card-property':U
     1631                             ,input ?
     1632                             ,input-output parref-list
     1633                         ) no-error .
     1634           apply "entry" to br-dis-prop_host.
     1635         end.
     1636       end.
     1637       when "global" then do:
     1638        if available X_dis-prop_ then do:
     1639         run ref/cdchist.w (
     1640                             INPUT parparentproc
     1641                             ,input p-curr-host-code
     1642                             ,input p-curr-obj-type
     1643                             ,input p-curr-obj-code
     1644                             ,input "":U
     1645                             ,input "subject"
     1646                             ,input X_dis-prop_.d-card
     1647                             ,input ?
     1648                             ,input '':U
     1649                             ,input 0
     1650                             ,input 0
     1651                             ,input ?
     1652                             ,input "":U
     1653                             ,input 'dis-card-property':U
     1654                             ,input ?
     1655                             ,input-output parref-list
     1656                         ) no-error .
     1657           apply "entry" to br-dis-prop_host.
     1658         end.
     1659       END.
     1660     END CASE.
     1661   END.
     1662   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1663   DO:
     1664   define variable v-rec as recid no-undo.
     1665   DEFINE VARIABLE v-d-card AS CHARACTER NO-UNDO.
     1666   DEFINE variable v-ri as recid no-undo .
     1667   define variable v-update-attr as logical no-undo .
     1668   define variable v-is-error as logical no-undo .
     1669   define buffer buf_dis-card for ub.dis-card.
     1670   CASE rs-region:
     1671       WHEN 'объект':U THEN DO:
     1672         IF NOT AVAILABLE X_dis-prop_obj THEN RETURN NO-APPLY.
     1673         v-d-card = X_dis-prop_obj.d-card.
     1674       END.
     1675       WHEN 'фирма':U THEN DO:
     1676         IF NOT AVAILABLE X_dis-prop_host THEN RETURN NO-APPLY.
     1677         v-d-card = X_dis-prop_host.d-card.
     1678       END.
     1679       WHEN "global" THEN DO:
     1680         IF NOT AVAILABLE X_dis-prop_ THEN RETURN NO-APPLY.
     1681         v-d-card = X_dis-prop_.d-card.
     1682       END.
     1683    END CASE.
     1684   find first buf_dis-card no-lock where
     1685              buf_dis-card.d-card = v-d-card no-error .
     1686   if avail buf_dis-card then do:
     1687     assign
     1688     v-ri = recid( buf_dis-card )
     1689    .
     1690     if buf_dis-card.emitent-host-code = p-curr-host-code
     1691     or buf_dis-card.emitent-host-code = 0 then do:
     1692         run ref/dc-propr.p ( input parparentproc
     1693                       ,input 'ПРОСМОТР':U
     1694                       ,input buf_dis-card.d-card
     1695                       ,input buf_dis-card.emitent-host-code
     1696                       ,input buf_dis-card.type
     1697                       ,input p-curr-host-code
     1698                       ,input p-curr-obj-type
     1699                       ,input p-curr-obj-code
     1700                       ,input no
     1701                       ,output v-update-attr
     1702                       ,output v-is-error
     1703                       ) no-error .
     1704     end.
     1705     else do:
     1706         message "Данная дисконтная карта принадлежит другой фирме - просмотр запрещен!"
     1707         view-as alert-box ERROR.
     1708     end.
     1709   end.
     1710   END.
     1711   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1712   DO:
     1713       define variable glog as logical no-undo .
     1714     if available X_dis-prop_obj then do:
     1715   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1716   define variable v-str-recid13 as character no-undo .
     1717   define variable v-num-entry13 as integer   no-undo .
     1718   assign
     1719     v-str-recid13 = trim( string( recid( X_dis-prop_obj ) , "->>>>>>>>>>>9":U ) )
     1720     v-num-entry13 = lookup( v-str-recid13 , v-rid-list )
     1721   .
     1722   if v-num-entry13 > 0 then do:
     1723     assign
     1724       entry( v-num-entry13, v-rid-list ) = "":U
     1725       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1726     .
     1727   end.
     1728   else do:
     1729     assign
     1730       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid13
     1731     .
     1732   end.
     1733     glog = br-dis-prop_obj:refresh() .
     1734     if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1735         glog = br-dis-prop_obj:select-next-row ().
     1736         apply "VALUE-CHANGED" to br-dis-prop_obj in frame Dialog-Frame.
     1737     end.
     1738     if num-entries( v-rid-list ) = 0
     1739     then
     1740         hide mark-num in frame Dialog-Frame.
     1741     else
     1742         disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1743   end.
     1744   apply "entry" to br-dis-prop_obj in frame Dialog-Frame.
     1745   END.
     1746   ON CHOOSE OF b-node-code IN FRAME Dialog-Frame
     1747   DO:
     1748   DEFINE variable v-ref-list AS CHARACTER NO-UNDO.
     1749   DEFINE BUFFER buf_prop-map FOR ub.prop-map.
     1750   IF f-dtm-code = ?
     1751   OR f-dtm-code = 0  THEN DO:
     1752     MESSAGE
     1753     "Не выбран объект-операнд"
     1754     VIEW-AS ALERT-BOX ERROR.
     1755     UNDO, RETURN NO-APPLY.
     1756   END.
     1757   run rul/prop-map-s.w (
     1758                   input parparentproc
     1759                 ,input 'b-sel'
     1760                 ,input "dtm-code"
     1761                 ,input f-dtm-code
     1762                 ,input-output  v-ref-list) no-error.
     1763   if error-status:error or v-ref-list = '':u then do:
     1764     v-list-mode = p-list-mode.
     1765     assign
     1766     f-node-code = ?
     1767     f-node-label = '':U.
     1768     DISPLAY
     1769     f-node-code
     1770     f-node-label
     1771     WITH FRAME Dialog-Frame.
     1772     run openbr in this-procedure ( input yes, input no, input '':U).
     1773     return.
     1774   end.
     1775   find first buf_prop-map no-lock where
     1776             recid(buf_prop-map) = integer(v-ref-list) no-error.
     1777   if not available buf_prop-map then return.
     1778   if buf_prop-map.dtm-code = f-dtm-code
     1779   AND buf_prop-map.node-code = f-node-code then return no-apply.
     1780   ASSIGN
     1781   f-node-code = buf_prop-map.node-code
     1782   f-node-label = buf_prop-map.node-label.
     1783   DISPLAY
     1784   f-node-code
     1785   f-node-label
     1786   WITH FRAME Dialog-Frame.
     1787   IF f-dt-code = ?
     1788   THEN DO:
     1789     v-list-mode ="node-code".
     1790   END.
     1791   ELSE DO:
     1792     v-list-mode ="dt-node-code".
     1793   END.
     1794   run openbr in this-procedure ( input yes, input no, input '':U).
     1795   END.
     1796   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1797   DO:
     1798   define variable v-doc-rec as recid no-undo .
     1799    CASE rs-region:
     1800        WHEN 'объект':U THEN DO:
     1801         v-doc-rec = recid( X_dis-prop_obj ).
     1802         DO WHILE available X_dis-prop_obj :
     1803           GET prev br-dis-prop_obj.
     1804         END.
     1805         run PrintProc IN THIS-PROCEDURE ( f-dtm-code, rs-region) .
     1806         reposition br-dis-prop_obj to recid v-doc-rec no-error.
     1807         apply "entry" to br-dis-prop_obj in frame Dialog-Frame.
     1808      END.
     1809      WHEN 'фирма':U THEN DO:
     1810         v-doc-rec = recid( X_dis-prop_host ).
     1811         DO WHILE available X_dis-prop_host :
     1812             GET prev br-dis-prop_host.
     1813         END.
     1814         run PrintProc IN THIS-PROCEDURE ( f-dtm-code, rs-region) .
     1815         reposition br-dis-prop_host to recid v-doc-rec no-error.
     1816         apply "entry" to br-dis-prop_host in frame Dialog-Frame.
     1817     END.
     1818     WHEN "global" THEN DO:
     1819         v-doc-rec = recid( X_dis-prop_ ).
     1820         DO WHILE available X_dis-prop_ :
     1821             GET prev br-dis-prop_.
     1822         END.
     1823         run PrintProc IN THIS-PROCEDURE ( f-dtm-code, rs-region) .
     1824         reposition br-dis-prop_ to recid v-doc-rec no-error.
     1825         apply "entry" to br-dis-prop_ in frame Dialog-Frame.
     1826     END.
     1827    END CASE.
     1828   END.
     1829   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1830   DO:
     1831     RUN proc-b-sch IN THIS-PROCEDURE (INPUT rs-region) NO-ERROR.
     1832     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1833   END.
     1834   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1835   DO:
     1836     if available X_dis-prop_obj then do:
     1837       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1838       then  v-rid-list = string( recid( X_dis-prop_obj ) ) .
     1839     end.
     1840   END.
     1841   ON VALUE-CHANGED OF rs-region IN FRAME Dialog-Frame
     1842   DO:
     1843     ASSIGN
     1844     rs-region.
     1845     v-list-mode = p-list-mode.
     1846     RUN Openbr IN THIS-PROCEDURE ( input YES, INPUT NO, INPUT '':U).
     1847   END.
     1848   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1849   on f5 of frame Dialog-Frame anywhere
     1850   do:
     1851      v-doc-rec = recid(X_dis-prop_obj).    RUn OpenBR in this-procedure ( input yes, input no, input '':U).  REPOSITION br-dis-prop_obj to recid v-doc-rec No-ERROR.   apply 'value-changed' to br-dis-prop_obj.
     1852       apply "VALUE-CHANGED" to br-dis-prop_.
     1853   end.
     1854   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1855   on help of frame Dialog-Frame
     1856   do:
     1857     run gbl/app_help.p
     1858       (input this-procedure :file-name
     1859       ,input ''
     1860       ,input ?
     1861       ) no-error.
     1862     if error-status :error then do:
     1863       message
     1864         "Ошибка при вызове помощи"
     1865         error-status :get-message(1)
     1866         view-as alert-box .
     1867     end.
     1868   end.
     1869   run minbtn-set in this-procedure .
     1870   on choose of b-help in frame Dialog-Frame
     1871   do:
     1872     apply "help":u to frame Dialog-Frame .
     1873   end.
     1874   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1875   procedure minbtn-set :
     1876       do
     1877           on error undo, return error return-value
     1878           :
     1879           define variable ii              as integer       no-undo .
     1880           define variable fh              as widget-handle no-undo .
     1881           define variable hh              as widget-handle no-undo .
     1882           define variable v-h             as handle        extent 4 no-undo .
     1883           define variable v-name-button   as character     no-undo .
     1884           define variable v-help-old-x    as decimal       no-undo .
     1885           define variable v-help-old-y    as decimal       no-undo .
     1886           define variable v-help-old-size as decimal       no-undo .
     1887           define variable v-frame-width   as decimal       no-undo .
     1888           define variable jj              as integer       no-undo .
     1889           do
     1890               on error undo, return error
     1891               :
     1892               assign
     1893                   v-frame-width = frame Dialog-Frame:width - 0.3
     1894                   fh            = frame Dialog-Frame:first-child
     1895                   hh            = fh:first-child
     1896                   ii            = 1
     1897                   .
     1898               do while valid-handle(hh):
     1899                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1900                   do:
     1901                       case lc(hh:name) :
     1902                           when "b-help" then
     1903                               do:
     1904                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1905                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1906                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1907                                   hh:TOOLTIP = "Помощь" .
     1908                                   v-help-old-x = hh:column .
     1909                                   v-help-old-y = hh:row    .
     1910                                   v-help-old-size = hh:width .
     1911                                   hh:width-chars = 2.5 .
     1912                               end.
     1913                           when "b-print" then
     1914                               do:
     1915                                   hh:load-image("cmp/b-print.bmp":u) .
     1916                                   hh:TOOLTIP = "Печать" .
     1917                                   v-h[ii] = hh:handle .
     1918                                   ii = ii + 1 .
     1919                                   hh:width-chars = 3 .
     1920                               end.
     1921                           when "b-history" or
     1922                           when "b-hist" then
     1923                               do:
     1924                                   hh:load-image("cmp/b-hist.bmp":u) .
     1925                                   hh:TOOLTIP = "История" .
     1926                                   v-h[ii] = hh:handle .
     1927                                   ii = ii + 1 .
     1928                                   hh:width-chars = 3 .
     1929                               end.
     1930                           when "b-sch" then
     1931                               do:
     1932                                   hh:load-image("cmp/b-sch.bmp":u) .
     1933                                   hh:TOOLTIP = "Установка Фильтра" .
     1934                                   v-h[ii] = hh:handle .
     1935                                   ii = ii + 1 .
     1936                                   hh:width-chars = 3 .
     1937                               end.
     1938                           when "b-hist-user" then
     1939                               do:
     1940                                   hh:load-image("cmp/b-hist.bmp":u) .
     1941                                   hh:TOOLTIP = "История пользователя" .
     1942                                   ii = ii + 1 .
     1943                               end.
     1944                       end case.
     1945                   end.
     1946                   hh = hh:next-sibling.
     1947               end.
     1948               b-help:column = v-frame-width - b-help:width-chars.
     1949               jj = 0.
     1950               repeat ii = 4 to 1 by -1 :
     1951                   if valid-handle (v-h[ii] ) then
     1952                   do:
     1953                       jj  = jj + 1 .
     1954                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1955                       v-h[ii]:row    = v-help-old-y .
     1956                   end.
     1957               end.
     1958           end.
     1959       end.
     1960   end procedure.
     1961   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1962   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1963   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1964   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1965   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1966   define variable v-diasize-current-frame-height as decimal   no-undo .
     1967   define variable v-diasize-change-size          as logical   no-undo .
     1968   define variable v-diasize-resize-button        as handle    no-undo .
     1969   define variable v-diasize-wndmax               as logical   no-undo .
     1970   define variable v-diasize-wndstore             as logical   no-undo .
     1971   define variable v-diasize-proc-name            as character no-undo .
     1972   define variable v-diasize-browse-handle        as handle    no-undo .
     1973   define variable v-diasize-browse-number        as integer   no-undo .
     1974   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1975   define temp-table temp-diasize-handle no-undo
     1976     field handle-value  as handle
     1977     field save-position as decimal
     1978     index xpk is primary unique handle-value
     1979     .
     1980   define temp-table temp-browse-handle no-undo
     1981     field browse-type   as character
     1982     field browse-number as integer
     1983     field browse-handle as handle
     1984     field original-size as decimal
     1985     index xpk is primary unique browse-type browse-number
     1986     index xie browse-type browse-handle
     1987   .
     1988   procedure diasize_change-height :
     1989     define input  parameter p-change-value  as decimal   no-undo .
     1990     define input  parameter p-move-resize   as logical   no-undo .
     1991     define variable v-field-group-handle    as handle    no-undo .
     1992     define variable v-object-handle         as handle    no-undo .
     1993     define variable v-frame-height          as decimal   no-undo .
     1994     define variable v-frame-virtual-height  as decimal   no-undo .
     1995     define variable v-browse-height         as decimal   no-undo .
     1996     define variable v-window-height         as decimal   no-undo .
     1997     define variable v-window-virtual-height as decimal   no-undo .
     1998     define variable v-change-sign           as integer   no-undo .
     1999     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2000     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2001     if p-change-value > 0
     2002     then do:
     2003       if frame Dialog-Frame :height + p-change-value
     2004           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2005       then do:
     2006         assign
     2007           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2008                           - (frame Dialog-Frame :height-chars)
     2009         .
     2010         if p-change-value <= 0
     2011         then do:
     2012           run diasize_position-resize-button in this-procedure .
     2013           return .
     2014         end.
     2015       end.
     2016     end.
     2017     if p-change-value < 0
     2018     then do:
     2019       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2020       then do:
     2021         assign
     2022           p-change-value = v-diasize-orig-frame-height
     2023                          - (frame Dialog-Frame :height-chars)
     2024         .
     2025         if p-change-value >= 0
     2026         then do:
     2027           run diasize_position-resize-button in this-procedure .
     2028           return .
     2029         end.
     2030       end.
     2031     end.
     2032     if p-change-value >= 0
     2033     then do:
     2034       assign
     2035         v-change-sign = 1
     2036       .
     2037     end.
     2038     else do:
     2039       assign
     2040         v-change-sign = -1
     2041       .
     2042     end.
     2043     assign
     2044       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2045     .
     2046     if p-change-value = 0
     2047     then do:
     2048       run diasize_position-resize-button in this-procedure .
     2049       return .
     2050     end.
