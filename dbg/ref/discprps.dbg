     6528         parameter-5-50 = (" " + "" + " " + ", FIRST X_prop-ref_obj WHERE                                              X_prop-ref_Obj.dt-code = X_dis-prop_obj.dt-code                                              , FIRST X_prop-map_obj no-lock where X_prop-map_obj.node-code = X_dis-prop_obj.node-code AND                                                                                   X_prop-map_obj.dtm-code = X_dis-prop_obj.dtm-code" + " " + p-find-condition)
     6529         parameter-6-50 = if sort-phrase-50 = ''
     6530                              then
     6531           (
     6532           " " + "  " +
     6533             " " + sort-column-phrase +
     6534           " " + " by X_dis-prop_obj.d-card "
     6535           )
     6536                              else
     6537           (
     6538           " " + "  " +
     6539             " " + sort-column-phrase +
     6540           " " + sort-phrase-50
     6541           )
     6542         parameter-7-50 =
     6543           " indexed-reposition  "
     6544       .
     6545         run fltopend_fltfindq in this-procedure  (
     6546                             input this-procedure:handle
     6547                             ,input QUERY br-dis-prop_obj:handle
     6548                             ,input logical(parameter-2-50)
     6549                             ,input no-lock
     6550                             ,input parameter-3-50
     6551                             ,input parameter-4-50
     6552                             ,input parameter-5-50
     6553                             ,input parameter-6-50
     6554                             ,input parameter-7-50
     6555                             ,output v-fltopend-rowid
     6556                             ) no-error.
     6557         .
     6558         v-doc-rec = ?.
     6559       end.
     6560       assign
     6561         l-query-was-opened = true
     6562       .
     6563     end.
     6564   end.
     6565     run waitfram-hide in this-procedure .
     6566       END.
     6567   END CASE.
     6568   if not p-open-query then
     6569   REPOSITION br-dis-prop_obj to recid v-doc-rec No-ERROR.
     6570   if not p-open-query and v-fltopend-rowid[1] <> ? then
     6571   query br-dis-prop_obj:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     6572   run waitfram-hide in this-procedure.
     6573   APPLY "ENTRY" TO br-dis-prop_obj.
     6574   APPLY "VALUE-CHANGED" TO br-dis-prop_obj in frame Dialog-Frame.
     6575   END PROCEDURE.
     6576   PROCEDURE PrintProc :
     6577   DEFINE INPUT PARAMETER p-dtm-code AS INTEGER NO-UNDO.
     6578   DEFINE INPUT PARAMETER p-region AS CHARACTER NO-UNDO.
     6579   define variable  date_string        as character no-undo.
     6580   define variable  Line               as character no-undo.
     6581   define variable  for-time           as character no-undo .
     6582   define variable  accum-count        as integer   no-undo .
     6583   define variable v-character as character no-undo .
     6584   Line = fill("-", 198).
     6585   date_string = cur-time-print() .
     6586   define frame dis-prop_
     6587   X_prop-ref_.sum-id COLUMN-LABEL "Идентификатор"
     6588   X_prop-ref_.caller_id COLUMN-LABEL "Доп!Идентификатор"
     6589   X_prop-ref_.dtm-code COLUMN-LABEL "Код!объекта-!операнда" format ">>9"
     6590   X_dis-prop_.d-card COLUMN-LABEL "№ ДК" FORMAT "X(19)"
     6591   X_prop-map_.node-name COLUMN-LABEL "Свойство" FORMAT "X(20)"
     6592   X_dis-prop_.property-value-character COLUMN-LABEL "Значение" format "X(44)"
     6593   X_dis-prop_.property-value-date COLUMN-LABEL "Значение" format "99/99/9999"
     6594   X_dis-prop_.property-value-decimal COLUMN-LABEL "Значение" format "->>,>>>,>>>,>>>,>>>.99"
     6595   X_dis-prop_.property-value-integer COLUMN-LABEL "Значение" format "->,>>>,>>>,>>9"
     6596   X_dis-prop_.property-value-logical COLUMN-LABEL "Знач" format "+/"
     6597   HEADER  date_string AT 5 format "X(35)"
     6598   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>>>9" SKIP
     6599   Line format "X(198)" AT 1
     6600   with width 232 down stream-io use-text    .
     6601   DEFINE frame dis-prop_host
     6602   X_prop-ref_host.sum-id COLUMN-LABEL "Идентификатор"
     6603   X_prop-ref_host.caller_id COLUMN-LABEL "Доп!Идентификатор"
     6604   X_prop-ref_host.dtm-code COLUMN-LABEL "Код!объекта-!операнда" format ">>9"
     6605   X_dis-prop_host.d-card COLUMN-LABEL "№ ДК" FORMAT "X(19)"
     6606   X_dis-prop_host.host-code COLUMN-LABEL "Код!фирмы" FORMAT ">>>>9"
     6607   X_prop-map_host.node-name COLUMN-LABEL "Свойство" FORMAT "X(20)"
     6608   X_dis-prop_host.property-value-character COLUMN-LABEL "Значение" format "X(44)"
     6609   X_dis-prop_host.property-value-date COLUMN-LABEL "Значение" format "99/99/9999"
     6610   X_dis-prop_host.property-value-decimal COLUMN-LABEL "Значение" format "->>,>>>,>>>,>>>,>>>.99"
     6611   X_dis-prop_host.property-value-integer COLUMN-LABEL "Значение" format "->,>>>,>>>,>>9"
     6612   X_dis-prop_host.property-value-logical COLUMN-LABEL "Знач" format "+/"
     6613   HEADER  date_string AT 5 format "X(35)"
     6614   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>>>9" SKIP
     6615   Line format "X(198)" AT 1
     6616   with width 232 down stream-io use-text    .
     6617   DEFINE frame dis-prop_obj
     6618   X_prop-ref_obj.sum-id COLUMN-LABEL "Идентификатор"
     6619   X_prop-ref_obj.caller_id COLUMN-LABEL "Доп!Идентификатор"
     6620   X_prop-ref_obj.dtm-code COLUMN-LABEL "Код!объекта-!операнда" format ">>9"
     6621   X_dis-prop_obj.d-card COLUMN-LABEL "№ ДК" FORMAT "X(19)"
     6622   X_dis-prop_obj.obj-code COLUMN-LABEL "Код!объекта" FORMAT ">>>>9"
     6623   X_dis-prop_obj.obj-type COLUMN-LABEL "Тип!объекта" FORMAT "X(3)"
     6624   X_prop-map_obj.node-name COLUMN-LABEL "Свойство" FORMAT "X(20)"
     6625   X_dis-prop_obj.property-value-character COLUMN-LABEL "Значение" format "X(44)"
     6626   X_dis-prop_obj.property-value-date COLUMN-LABEL "Значение" format "99/99/9999"
     6627   X_dis-prop_obj.property-value-decimal COLUMN-LABEL "Значение" format "->>,>>>,>>>,>>>,>>>.99"
     6628   X_dis-prop_obj.property-value-integer COLUMN-LABEL "Значение" format "->,>>>,>>>,>>9"
     6629   X_dis-prop_obj.property-value-logical COLUMN-LABEL "Знач" format "+/"
     6630   HEADER  date_string AT 5 format "X(35)"
     6631   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>>>9" SKIP
     6632   Line format "X(198)" AT 1
     6633   with width 232 down stream-io use-text    .
     6634   run prn-lib-open-stream  in this-procedure (
     6635                                                input parParentProc
     6636                                               ,input 43
     6637                                               ,input yes
     6638                                               ,input no
     6639                                               ).
     6640   PUT  STREAM PrnLibStream unformatted
     6641   SPACE(25) ( frame Dialog-Frame:title )
     6642   format "x(90)" SKIP(0)
     6643   (if f-dtm-code <> 0 then f-dtm-name else '':U) skip(0)
     6644   (if f-dt-code <> ? then f-sum-id else '':U)
     6645   .
     6646   FORM HEADER
     6647   Line format "X(177)" AT 1 SKIP
     6648   "Продолжение - на следующей странице" AT 30 SKIP
     6649   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     6650   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     6651   CASE p-region:
     6652     WHEN "global" THEN DO:
     6653       FORM with FRAME dis-prop_ .
     6654       run waitfram-show in this-procedure ( input "Ждите...").
     6655       GET next br-dis-prop_  no-lock.
     6656       DO WHILE available X_dis-prop_:
     6657         Display STREAM PrnLibStream
     6658         X_prop-ref_.sum-id
     6659         X_prop-ref_.caller_id
     6660         X_prop-ref_.dtm-code
     6661         X_dis-prop_.d-card
     6662         X_prop-map_.node-name
     6663         X_dis-prop_.property-value-character when entry(1, X_prop-map_.node-value-type) = 'character':U
     6664         X_dis-prop_.property-value-date when entry(1, X_prop-map_.node-value-type) = 'date':U
     6665         X_dis-prop_.property-value-decimal when entry(1, X_prop-map_.node-value-type) = 'decimal':U
     6666         X_dis-prop_.property-value-integer when entry(1, X_prop-map_.node-value-type) = 'integer':U
     6667         X_dis-prop_.property-value-logical when entry(1, X_prop-map_.node-value-type) = 'logical':U
     6668         with FRAME dis-prop_ .
     6669         DOWN STREAM PrnLibStream 1 with FRAME dis-prop_ .
     6670         assign
     6671         accum-count = accum-count + 1 .
     6672         GET next br-dis-prop_ no-lock.
     6673       END.
     6674       UNDERLINE  STREAM PrnLibStream
     6675       X_prop-ref_.sum-id
     6676       X_prop-ref_.caller_id
     6677       X_prop-ref_.dtm-code
     6678       X_dis-prop_.d-card
     6679       X_prop-map_.node-name
     6680       X_dis-prop_.property-value-character
     6681       X_dis-prop_.property-value-date
     6682       X_dis-prop_.property-value-decimal
     6683       X_dis-prop_.property-value-integer
     6684       X_dis-prop_.property-value-logical
     6685       with FRAME dis-prop_ .
     6686       DISPLAY STREAM PrnLibStream
     6687       "Итого" @ X_prop-ref_.sum-id
     6688       accum-count @ X_dis-prop_.d-card
     6689       with frame dis-prop_.
     6690     END.
     6691     WHEN 'фирма':U THEN DO:
     6692       FORM with FRAME dis-prop_host .
     6693       run waitfram-show in this-procedure ( input "Ждите...").
     6694       GET next br-dis-prop_host  no-lock.
     6695       DO WHILE available X_dis-prop_host:
     6696         Display STREAM PrnLibStream
     6697         X_prop-ref_host.sum-id
     6698         X_prop-ref_host.caller_id
     6699         X_prop-ref_host.dtm-code
     6700         X_dis-prop_host.d-card
     6701         X_prop-map_host.node-name
     6702         X_dis-prop_host.property-value-character when entry(1, X_prop-map_host.node-value-type) = 'character':U
     6703         X_dis-prop_host.property-value-date when entry(1, X_prop-map_host.node-value-type) = 'date':U
     6704         X_dis-prop_host.property-value-decimal when entry(1, X_prop-map_host.node-value-type) = 'decimal':U
     6705         X_dis-prop_host.property-value-integer when entry(1, X_prop-map_host.node-value-type) = 'integer':U
     6706         X_dis-prop_host.property-value-logical when entry(1, X_prop-map_host.node-value-type) = 'logical':U
     6707         with FRAME dis-prop_host .
     6708         DOWN STREAM PrnLibStream 1 with FRAME dis-prop_host .
     6709         assign
     6710         accum-count = accum-count + 1.
     6711         GET next br-dis-prop_host no-lock.
     6712       END.
     6713       UNDERLINE  STREAM PrnLibStream
     6714       X_prop-ref_host.sum-id
     6715       X_prop-ref_host.caller_id
     6716       X_prop-ref_host.dtm-code
     6717       X_dis-prop_host.d-card
     6718       X_prop-map_host.node-name
     6719       X_dis-prop_host.property-value-character
     6720       X_dis-prop_host.property-value-date
     6721       X_dis-prop_host.property-value-decimal
     6722       X_dis-prop_host.property-value-integer
     6723       X_dis-prop_host.property-value-logical
     6724       with FRAME dis-prop_host .
     6725       DISPLAY STREAM PrnLibStream
     6726       "Итого" @ X_prop-ref_host.sum-id
     6727       accum-count @ X_dis-prop_host.d-card
     6728       with frame dis-prop_host.
     6729     END.
     6730     WHEN 'объект':U THEN DO:
     6731       FORM with FRAME dis-prop_obj .
     6732       run waitfram-show in this-procedure ( input "Ждите...").
     6733       GET next br-dis-prop_obj  no-lock.
     6734       DO WHILE available X_dis-prop_obj:
     6735         Display STREAM PrnLibStream
     6736         X_prop-ref_obj.sum-id
     6737         X_prop-ref_obj.caller_id
     6738         X_prop-ref_obj.dtm-code
     6739         X_dis-prop_obj.d-card
     6740         X_prop-map_obj.node-name
     6741         X_dis-prop_obj.property-value-character when entry(1, X_prop-map_obj.node-value-type) = 'character':U
     6742         X_dis-prop_obj.property-value-date when entry(1, X_prop-map_obj.node-value-type) = 'date':U
     6743         X_dis-prop_obj.property-value-decimal when entry(1, X_prop-map_obj.node-value-type) = 'decimal':U
     6744         X_dis-prop_obj.property-value-integer when entry(1, X_prop-map_obj.node-value-type) = 'integer':U
     6745         X_dis-prop_obj.property-value-logical when entry(1, X_prop-map_obj.node-value-type) = 'logical':U
     6746         with FRAME dis-prop_obj .
     6747         DOWN STREAM PrnLibStream 1 with FRAME dis-prop_obj .
     6748         assign
     6749         accum-count = accum-count + 1.
     6750         GET next br-dis-prop_obj no-lock.
     6751       END.
     6752       UNDERLINE  STREAM PrnLibStream
     6753       X_prop-ref_obj.sum-id
     6754       X_prop-ref_obj.caller_id
     6755       X_prop-ref_obj.dtm-code
     6756       X_dis-prop_obj.d-card
     6757       X_prop-map_obj.node-name
     6758       X_dis-prop_obj.property-value-character
     6759       X_dis-prop_obj.property-value-date
     6760       X_dis-prop_obj.property-value-decimal
     6761       X_dis-prop_obj.property-value-integer
     6762       X_dis-prop_obj.property-value-logical
     6763       with FRAME dis-prop_obj .
     6764       DISPLAY STREAM PrnLibStream
     6765       "Итого" @ X_prop-ref_obj.sum-id
     6766       accum-count @ X_dis-prop_obj.d-card
     6767       with frame dis-prop_obj.
     6768     END.
     6769   end case.
     6770   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     6771   HIDE  STREAM PrnLibStream FRAME CheckList.
     6772   output  STREAM PrnLibStream CLOSE.
     6773   run waitfram-hide in this-procedure .
     6774   run prn-lib-prn-file in this-procedure (
     6775                                             input parParentProc
     6776                                             ,input 8
     6777                                             ).
     6778   END PROCEDURE.
     6779   PROCEDURE proc-b-link :
     6780   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     6781   DEFINE variable v-rid-list AS CHARACTER NO-undo.
     6782   CASE p-option:
     6783   END CASE.
     6784   END PROCEDURE.
     6785   PROCEDURE proc-b-sch :
     6786   DEFINE INPUT PARAMETER p-region AS CHARACTER NO-UNDO.
     6787   define variable loc-point as character no-undo .
     6788   define variable loc-label as character no-undo .
     6789   CASE p-region:
     6790     WHEN 'объект':U THEN DO:
     6791       run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     6792       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6793       run fltfield-add in this-procedure('host-code', 'Фирма', '',
     6794       input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6795       assign
     6796         tbl = 'dis-card-property'
     6797         join-tbl = 'X_dis-prop_obj'
     6798         fld = ""
     6799         lab = ""
     6800         spr = ""
     6801         dim = '0'
     6802         loc-point = substitute('&1_obj', filter-point)
     6803         loc-label = substitute('&1 ОБъект', filter-point-label)
     6804         .
     6805     END.
     6806     WHEN 'фирма':U THEN DO:
     6807        run fltfield-add in this-procedure('host-code', 'Фирма', '',
     6808        input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6809        assign
     6810          tbl = 'dis-card-property'
     6811          join-tbl = 'X_dis-prop_host'
     6812          fld = ""
     6813          lab = ""
     6814          spr = ""
     6815          dim = '0'
     6816         loc-point = substitute('&1_host', filter-point)
     6817         loc-label = substitute('&1 Фирма', filter-point-label)
     6818          .
     6819     END.
     6820     WHEN "global" THEN DO:
     6821         assign
     6822           tbl = 'dis-card-property'
     6823           join-tbl = 'X_dis-prop_'
     6824           fld = ""
     6825           lab = ""
     6826           spr = ""
     6827           dim = '0'
     6828         loc-point = substitute('&1', filter-point)
     6829         loc-label = substitute('&1', filter-point-label)
     6830           .
     6831     END.
     6832   END CASE.
     6833   run fltfield-add in this-procedure('d-card', '№ карты', '',
     6834   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6835   run fltfield-add in this-procedure('node-code', 'Свойство', 'dcp-node-code',
     6836   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6837   run fltfield-add in this-procedure('property-value-character', 'Значение(строковое)', '',
     6838   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6839   run fltfield-add in this-procedure('property-value-date', 'Значение(дата)', '',
     6840   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6841   run fltfield-add in this-procedure('property-value-decimal', 'Значение(десятичное)', '',
     6842   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6843   run fltfield-add in this-procedure('property-value-integer', 'Значение(целое)', '',
     6844   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6845   run fltfield-add in this-procedure('property-value-logical', 'Значение(логич)', '',
     6846   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6847   Filter-Block:
     6848   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     6849       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     6850       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     6851     run gbl/filter.w ( input parparentproc
     6852                      , INPUT (loc-point + chr(4) + loc-label)
     6853                      , INPUT tbl
     6854                      , INPUT join-tbl
     6855                      , INPUT fld
     6856                      , INPUT lab
     6857                      , INPUT spr
     6858                      , INPUT dim ).
     6859     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     6860   END.
     6861   END PROCEDURE.
     6862   PROCEDURE set-row-color_ :
     6863   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     6864   ASSIGN
     6865   v-ch_[1]:FGCOLOR = GREY_COLOR
     6866   v-ch_[1]:BGCOLOR = GREY_Color
     6867   v-ch_[1]:PFCOLOR = GREY_Color
     6868   v-ch_[2]:FGCOLOR = GREY_COLOR
     6869   v-ch_[2]:BGCOLOR = GREY_Color
     6870   v-ch_[2]:PFCOLOR = GREY_Color
     6871   v-ch_[3]:FGCOLOR = GREY_COLOR
     6872   v-ch_[3]:BGCOLOR = GREY_Color
     6873   v-ch_[3]:PFCOLOR = GREY_Color
     6874   v-ch_[4]:FGCOLOR = GREY_COLOR
     6875   v-ch_[4]:BGCOLOR = GREY_Color
     6876   v-ch_[4]:PFCOLOR = GREY_Color
     6877   v-ch_[5]:FGCOLOR = GREY_COLOR
     6878   v-ch_[5]:BGCOLOR = GREY_Color
     6879   v-ch_[5]:PFCOLOR = GREY_Color
     6880   .
     6881   CASE entry(1, p-data-type):
     6882        WHEN 'character':U THEN DO:
     6883         ASSIGN
     6884         v-ch_[1]:FGCOLOR = BLACK_COLOR
     6885         v-ch_[1]:BGCOLOR = WHITE_Color.
     6886       END.
     6887       WHEN 'decimal':U THEN DO:
     6888         ASSIGN
     6889         v-ch_[3]:FGCOLOR = BLACK_COLOR
     6890         v-ch_[3]:BGCOLOR = WHITE_Color.
     6891       END.
     6892       WHEN 'integer':U THEN DO:
     6893         ASSIGN
     6894         v-ch_[4]:FGCOLOR = BLACK_COLOR
     6895         v-ch_[4]:BGCOLOR = WHITE_Color.
     6896       END.
     6897       WHEN 'date':U THEN DO:
     6898         ASSIGN
     6899         v-ch_[2]:FGCOLOR = BLACK_COLOR
     6900         v-ch_[2]:BGCOLOR = WHITE_Color.
     6901        END.
     6902        WHEN 'logical':U THEN DO:
     6903          ASSIGN
     6904          v-ch_[5]:FGCOLOR = BLACK_COLOR
     6905          v-ch_[5]:BGCOLOR = WHITE_Color.
     6906        END.
     6907   END CASE.
     6908   END PROCEDURE.
     6909   PROCEDURE set-row-color_host :
     6910   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     6911   ASSIGN
     6912   v-ch_host[1]:FGCOLOR = GREY_COLOR
     6913   v-ch_host[1]:BGCOLOR = GREY_Color
     6914   v-ch_host[1]:PFCOLOR = GREY_Color
     6915   v-ch_host[2]:FGCOLOR = GREY_COLOR
     6916   v-ch_host[2]:BGCOLOR = GREY_Color
     6917   v-ch_host[2]:PFCOLOR = GREY_Color
     6918   v-ch_host[3]:FGCOLOR = GREY_COLOR
     6919   v-ch_host[3]:BGCOLOR = GREY_Color
     6920   v-ch_host[3]:PFCOLOR = GREY_Color
     6921   v-ch_host[4]:FGCOLOR = GREY_COLOR
     6922   v-ch_host[4]:BGCOLOR = GREY_Color
     6923   v-ch_host[4]:PFCOLOR = GREY_Color
     6924   v-ch_host[5]:FGCOLOR = GREY_COLOR
     6925   v-ch_host[5]:BGCOLOR = GREY_Color
     6926   v-ch_host[5]:PFCOLOR = GREY_Color
     6927   .
     6928   CASE entry(1, p-data-type):
     6929        WHEN 'character':U THEN DO:
     6930         ASSIGN
     6931         v-ch_host[1]:FGCOLOR = BLACK_COLOR
     6932         v-ch_host[1]:BGCOLOR = WHITE_Color.
     6933       END.
     6934       WHEN 'decimal':U THEN DO:
     6935         ASSIGN
     6936         v-ch_host[3]:FGCOLOR = BLACK_COLOR
     6937         v-ch_host[3]:BGCOLOR = WHITE_Color.
     6938       END.
     6939       WHEN 'integer':U THEN DO:
     6940         ASSIGN
     6941         v-ch_host[4]:FGCOLOR = BLACK_COLOR
     6942         v-ch_host[4]:BGCOLOR = WHITE_Color.
     6943       END.
     6944       WHEN 'date':U THEN DO:
     6945         ASSIGN
     6946         v-ch_host[2]:FGCOLOR = BLACK_COLOR
     6947         v-ch_host[2]:BGCOLOR = WHITE_Color.
     6948        END.
     6949        WHEN 'logical':U THEN DO:
     6950          ASSIGN
     6951          v-ch_host[5]:FGCOLOR = BLACK_COLOR
     6952          v-ch_host[5]:BGCOLOR = WHITE_Color.
     6953        END.
     6954   END CASE.
     6955   END PROCEDURE.
     6956   PROCEDURE set-row-color_obj :
     6957   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     6958   ASSIGN
     6959   v-ch_[1]:FGCOLOR = GREY_COLOR
     6960   v-ch_[1]:BGCOLOR = GREY_Color
     6961   v-ch_[1]:PFCOLOR = GREY_Color
     6962   v-ch_[2]:FGCOLOR = GREY_COLOR
     6963   v-ch_[2]:BGCOLOR = GREY_Color
     6964   v-ch_[2]:PFCOLOR = GREY_Color
     6965   v-ch_[3]:FGCOLOR = GREY_COLOR
     6966   v-ch_[3]:BGCOLOR = GREY_Color
     6967   v-ch_[3]:PFCOLOR = GREY_Color
     6968   v-ch_[4]:FGCOLOR = GREY_COLOR
     6969   v-ch_[4]:BGCOLOR = GREY_Color
     6970   v-ch_[4]:PFCOLOR = GREY_Color
     6971   v-ch_[5]:FGCOLOR = GREY_COLOR
     6972   v-ch_[5]:BGCOLOR = GREY_Color
     6973   v-ch_[5]:PFCOLOR = GREY_Color
     6974   .
     6975   CASE entry(1, p-data-type):
     6976        WHEN 'character':U THEN DO:
     6977         ASSIGN
     6978         v-ch_[1]:FGCOLOR = BLACK_COLOR
     6979         v-ch_[1]:BGCOLOR = WHITE_Color.
     6980       END.
     6981       WHEN 'decimal':U THEN DO:
     6982         ASSIGN
     6983         v-ch_[3]:FGCOLOR = BLACK_COLOR
     6984         v-ch_[3]:BGCOLOR = WHITE_Color.
     6985       END.
     6986       WHEN 'integer':U THEN DO:
     6987         ASSIGN
     6988         v-ch_[4]:FGCOLOR = BLACK_COLOR
     6989         v-ch_[4]:BGCOLOR = WHITE_Color.
     6990       END.
     6991       WHEN 'date':U THEN DO:
     6992         ASSIGN
     6993         v-ch_[2]:FGCOLOR = BLACK_COLOR
     6994         v-ch_[2]:BGCOLOR = WHITE_Color.
     6995        END.
     6996        WHEN 'logical':U THEN DO:
     6997          ASSIGN
     6998          v-ch_[5]:FGCOLOR = BLACK_COLOR
     6999          v-ch_[5]:BGCOLOR = WHITE_Color.
     7000        END.
     7001   END CASE.
     7002   END PROCEDURE.
     7003   FUNCTION display-character RETURNS CHARACTER
     7004     (  INPUT p-character AS CHARACTER, INPUT p-format AS CHARACTER) :
     7005   DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
     7006   IF trim(p-format, "*") = "" THEN
     7007   v-string = string(p-character, p-format).
     7008   ELSE DO:
     7009   v-string = p-character.
     7010   END.
     7011   RETURN v-string.
     7012   END FUNCTION.
