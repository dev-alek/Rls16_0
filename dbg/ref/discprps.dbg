      453   define  stream PrnLibStream.
      454   procedure prn-lib-prn-file :
      455     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      456     define input parameter p-DIsabledoptions as integer no-undo .
      457     define variable v-report-name as character no-undo .
      458     define variable v-user-action as character no-undo .
      459     define variable v-printed     as logical   no-undo .
      460     define variable v-exist       as logical   no-undo .
      461     do
      462       on error undo, return error
      463       :
      464       run prn-lib-get-report-name  in this-procedure (
      465         input parParentProc
      466         ,output v-report-name
      467         ).
      468   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      469   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      470     (input  v-report-name
      471     ,input  2
      472     ,output v-exist
      473     )  .
      474       if NOT v-exist then
      475       DO:
      476         Message
      477           "Нет заданий на печать ! "
      478           view-as alert-box .
      479         Return  .
      480       End.
      481       run gbl/prnfilen.w
      482         (input  ""
      483         ,input  p-DisabledOptions
      484         ,input  string(v-report-name )
      485         ,input  7
      486         ,output v-user-action
      487         ,output v-printed
      488         ) .
      489       if v-printed then
      490       do:
      491         return "YES" .
      492       end.
      493       else
      494       do:
      495         return "NO" .
      496       end.
      497     end.
      498   end procedure.
      499   procedure prn-lib-open-stream :
      500     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      501     define input parameter p-page-size    as integer no-undo .
      502     define input parameter p-is-stream    as logical no-undo .
      503     define input parameter p-append       as logical no-undo .
      504     define variable v-report-name as character no-undo .
      505     do
      506       on error undo, return error
      507       :
      508       run prn-lib-get-report-name  in this-procedure (
      509         input parParentProc
      510         ,output v-report-name
      511         ).
      512       if p-is-stream then
      513       do:
      514         if p-append then
      515         do:
      516           output stream PrnLibStream to value( v-report-name )
      517             page-size value(p-page-size) append .
      518         end.
      519         if not p-append then
      520         do:
      521           output stream PrnLibStream to value( v-report-name )
      522             page-size value(p-page-size) .
      523         end.
      524       end.
      525       if not p-is-stream then
      526       do:
      527         if p-append then
      528         do:
      529           output to value( v-report-name )
      530             page-size value(p-page-size) append .
      531         end.
      532         if not p-append then
      533         do:
      534           output to value( v-report-name )
      535             page-size value(p-page-size) .
      536         end.
      537       end.
      538     end.
      539   end procedure.
      540   procedure prn-lib-open-exp :
      541     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      542     define input parameter p-is-stream    as logical no-undo .
      543     define input parameter p-is-append    as logical no-undo .
      544     define output parameter p-ReportFileName as char init "report" no-undo.
      545     define output parameter p-process as logical no-undo .
      546     define variable glog as logical no-undo .
      547     do
      548       on error undo, return error
      549       :
      550       SYSTEM-DIALOG GET-FILE p-ReportFileName
      551         TITLE      "Укажите путь"
      552         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      553         ASK-OVERWRITE
      554         CREATE-TEST-FILE
      555         SAVE-AS
      556         USE-FILENAME
      557         DEFAULT-EXTENSION "txt"
      558         UPDATE glog
      559         .
      560       if not glog then  return.
      561       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      562       if p-is-stream then
      563       do:
      564         if p-is-append then
      565         do:
      566           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      567         end.
      568         else
      569         do:
      570           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      571         end.
      572       end.
      573       else
      574       do:
      575         if p-is-append then
      576         do:
      577           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      578         end.
      579         else
      580         do:
      581           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      582         end.
      583       end.
      584       p-process = yes.
      585     end.
      586   end procedure.
      587   procedure prn-lib-get-report-name :
      588     define input parameter parParentProc  as widget-handle no-undo.
      589     define output parameter p-report-name as character no-undo .
      590     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      591   end procedure.
      592   procedure prn-lib-reportviewer-report-name :
      593     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      594     define input parameter p-report-name-html as character no-undo .
      595     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      596   end procedure.
      597   procedure prn-lib-reportviewer :
      598     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      599     define input parameter p-report-name-html as character no-undo .
      600     define input parameter p-param        as character no-undo .
      601     define variable v-excel           as character no-undo init 'TRUE' .
      602     define variable v-value-character as character no-undo .
      603     define variable v-value-integer   as character no-undo .
      604     define variable v-value-date      as date      no-undo .
      605     define variable v-value-decimal   as decimal   no-undo .
      606     define variable rep-excel         as logical   no-undo .
      607     define variable excel-string      as character no-undo .
      608     define variable v-param-type      as character no-undo .
      609     define variable v-tth             as handle    no-undo .
      610     run adm/shattri.p (
      611       input "get":U
      612       ,input  ""
      613       ,input  0
      614       ,input  'report-glob':U
      615       ,input  'rep-excel':U
      616       ,output v-value-character
      617       ,output v-value-date
      618       ,output v-value-decimal
      619       ,output v-value-integer
      620       ,output rep-excel
      621       ,output v-param-type
      622       ,INPUT-OUTPUT table-handle v-tth
      623       )  .
      624     if rep-excel then v-excel = "TRUE" .
      625     else v-excel = "FALSE" .
      626     if p-param eq ""
      627     then
      628        p-param = "EXCEL:" + v-excel.
      629     else
      630        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      631     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      632   end procedure.
      633   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      634   procedure cur-time :
      635      define output parameter p-today as date      no-undo .
      636      define output parameter p-time  as integer   no-undo .
      637     do
      638     on error undo, return error
      639     :
      640       define variable v-date1 as date      no-undo .
      641       define variable v-date2 as date      no-undo .
      642       define variable v-time  as integer   no-undo .
      643       assign
      644         v-date1 = today
      645         v-time  = time
      646         v-date2 = today
      647       .
      648       if v-date1 <> v-date2
      649       then do:
      650         assign
      651           v-date1 = today
      652           v-time  = v-time
      653         .
      654       end.
      655       assign
      656         p-today = v-date1
      657         p-time  = v-time
      658       .
      659     end.
      660   end.
      661   function cur-time-date returns character
      662   :
      663     return string(today, '99/99/9999':U) .
      664   end.
      665   function cur-time-mjd returns decimal
      666   :
      667     define variable v-date as date      no-undo .
      668     define variable v-time as integer   no-undo .
      669     run cur-time in this-procedure
      670       (output v-date
      671       ,output v-time
      672       ) .
      673     return integer(v-date) - 2400002 + (v-time / 86400) .
      674   end.
      675   function cur-time-get-ending-index returns integer
      676   (input p-number as integer
      677   )
      678   :
      679     if p-number < 0
      680     or p-number = ?
      681     then do:
      682       return 1 .
      683     end.
      684     define variable v-rest as integer   no-undo .
      685     assign
      686       p-number = p-number modulo 100
      687     .
      688     if p-number < 20
      689     then do:
      690       assign
      691         v-rest = p-number
      692       .
      693     end.
      694     else do:
      695       assign
      696         v-rest = p-number modulo 10
      697       .
      698     end.
      699     case v-rest :
      700       when 1
      701       then do:
      702         return 2 .
      703       end.
      704       when 2 or
      705       when 3 or
      706       when 4
      707       then do:
      708         return 3 .
      709       end.
      710       otherwise do:
      711         return 1 .
      712       end.
      713     end case .
      714   end.
      715   procedure cur-time-mjd-to-date :
      716      define input  parameter i-mjd-diff as decimal no-undo.
      717      define output parameter o-Date     as date    no-undo.
      718      define output parameter o-Time     as integer no-undo.
      719      define variable v-day-number as integer   no-undo .
      720      if    i-mjd-diff < 0
      721         or i-mjd-diff = ?
      722      then do:
      723         return "?" .
      724      end.
      725      assign
      726         v-day-number = truncate(i-mjd-diff,0).
      727         o-Date = date(v-day-number + 2400002).
      728         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      729     .
      730   end.
      731   function cur-time-mjd-to-string returns character
      732   (input p-mjd-diff as decimal
      733   )
      734   :
      735     define variable v-day-number as integer   no-undo .
      736     define variable v-seconds    as integer   no-undo .
      737     define variable v-hour       as integer   no-undo .
      738     define variable v-min        as integer   no-undo .
      739     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      740     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      741     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      742     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      743     if p-mjd-diff < 0
      744     or p-mjd-diff = ?
      745     then do:
      746       return "?" .
      747     end.
      748     assign
      749       v-day-number = integer(truncate(p-mjd-diff,0))
      750       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      751     .
      752     if v-seconds > 86400
      753     then do:
      754       assign
      755         v-seconds = 86400 - 1
      756       .
      757     end.
      758     if v-seconds < 0
      759     then do:
      760       assign
      761         v-seconds = 0
      762       .
      763     end.
      764     assign
      765       v-hour = truncate(v-seconds / 3600, 0)
      766     .
      767     assign
      768       v-seconds = v-seconds modulo 3600
      769     .
      770     assign
      771       v-min = truncate(v-seconds / 60, 0)
      772     .
      773     assign
      774       v-seconds = v-seconds modulo 60
      775     .
      776     return
      777         (if v-day-number <> 0
      778           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      779           else ""
      780         )
      781       + (if v-day-number <> 0 or v-hour <> 0
      782           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      783           else ""
      784         )
      785       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      786           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      787           else ""
      788         )
      789       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      790       .
      791   end.
      792   function cur-time-string returns character
      793   :
      794     define variable v-date as date      no-undo .
      795     define variable v-time as integer   no-undo .
      796     run cur-time in this-procedure
      797       (output v-date
      798       ,output v-time
      799       ) .
      800     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      801   end.
      802   function cur-time-string-sec returns character
      803   :
      804     define variable v-date as date      no-undo .
      805     define variable v-time as integer   no-undo .
      806     run cur-time in this-procedure
      807       (output v-date
      808       ,output v-time
      809       ) .
      810     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      811   end.
      812   function cur-time-custom  returns character
      813   (input p-prefix as character
      814   ,input p-date-format as character
      815   ,input p-delimiter as character
      816   ,input p-time-format as character
      817   ,input p-suffix as character
      818   )
      819   :
      820     define variable v-date as date      no-undo .
      821     define variable v-time as integer   no-undo .
      822     run cur-time in this-procedure
      823       (output v-date
      824       ,output v-time
      825       ) .
      826     return
      827       p-prefix
      828       + string(v-date, p-date-format)
      829       + p-delimiter
      830       + string(v-time, p-time-format)
      831       + p-suffix
      832       .
      833   end.
      834   function cur-time-print  returns character
      835   :
      836     define variable v-date as date      no-undo .
      837     define variable v-time as integer   no-undo .
      838     run cur-time in this-procedure
      839       (output v-date
      840       ,output v-time
      841       ) .
      842     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      843   end.
      844   function cur-time-datetime returns datetime
      845   :
      846     define variable v-char as character no-undo .
      847     define variable v-datetime as datetime no-undo .
      848     v-char = cur-time-string().
      849     v-datetime = datetime(v-char).
      850     return  v-datetime.
      851   end.
      852   function cur-time-string-msec returns character
      853   :
      854     define variable v-date as datetime  no-undo .
      855     v-date = now.
      856     return string(v-date) .
      857   end.
      858   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
