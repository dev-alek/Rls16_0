        1   block-level on error undo, throw.
        2   DEFINE TEMP-TABLE tt-tax-units NO-UNDO LIKE ub.tax-units
        3          field is-found as logical column-label ""
        4          index pi is unique primary tax-code type.
        5   define input-output parameter par-rid as recid no-undo .
        6   define input parameter par-mode as character no-undo .
        7   define input parameter partax-code like ub.tax.tax-code no-undo .
        8   define input parameter partax-name like ub.tax.tax-name no-undo .
        9   define input parameter partax-type like ub.tax.tax-type no-undo .
       10   define input parameter par-individual like ub.tax.individual no-undo .
       11   define input parameter parto-cashdesk like ub.tax.to-cashdesk no-undo .
       12   define input parameter table for tt-tax-units.
       13   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   def var vss-author      as character no-undo init "$Author: expertek $":U .
       15   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   def var vss-workfile    as character no-undo init "$Workfile: taxesi01.p $":U .
       17   def var vss-archive     as character no-undo init "$Archive: ref/taxesi01.p $":U .
       18   def var vss-description as character no-undo init "Сохранение изменений в карточке налога".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   DEFINE VARIABLE II AS INTEGER NO-UNDO.
       89   define variable var-entry as character no-undo .
       90   def var update-recid as recid no-undo.
       91   if g#db-num > 0 then do:
       92     message  vss-workfile vss-revision vss-description skip
       93             "Вызов процедуры в УБД запрещен"
       94     view-as alert-box ERROR.
       95     return error '':U.
       96   end.
       97   if partax-name = "" then do:
       98     message "Укажите полное наименование." view-as alert-box WARNING .
       99     var-entry = "tax-name":U.
      100     return error var-entry.
      101   end.
      102   if partax-code = 0 or
      103       partax-code = ? then do:
      104     message "Укажите код." view-as alert-box WARNING .
      105     var-entry =  "tax-code":U.
      106     return error var-entry.
      107   end.
      108   if integer(partax-code) < 4 + 1 then do:
      109     message "Значения кодов меньшие" (4 + 1) "зарезервированы," SKip
      110             "можно изменить только параметр отсылки на кассу"
      111     view-as alert-box WARNING .
      112   end.
      113   if par-mode = 'ДОБАВЛЕНИЕ':U then do:
      114     if can-find( ub.tax where
      115                  ub.tax.tax-code = integer(partax-code )) then  do:
      116       message "Налог с таким кодом уже есть." view-as alert-box ERROR .
      117       var-entry =  "tax-code":U.
      118       return error var-entry.
      119     end.
      120     if parto-cashdesk =  yes and
      121        par-individual = yes  AND
      122        can-find(first ub.tax No-LOCK WHERE
      123                       ub.tax.to-cashdesk = yes AND
      124                       ub.tax.individual = yes) then  do:
      125       message "В связи с особенностями работы POS IBM" skip
      126               "количество определенных в системе " skip
      127               "индивидуальных налогов, пересылаемых на кассу"
      128               "не может быть больше одного" view-as alert-box ERROR .
      129       var-entry =  "individual":U.
      130       return error var-entry.
      131     end.
      132     CREATE ub.tax.
      133     assign
      134     ub.tax.tax-code = partax-code
      135     ub.tax.tax-name = partax-name
      136     ub.tax.tax-type = if (parTAX-TYPE = 'процентный':U)
      137                   then '%':U
      138                   else 'abs':U
      139     ub.tax.to-cashdesk = parto-cashdesk
      140     ub.tax.individual = par-individual
      141     ub.tax.status_ = 'тек':U
      142     par-rid = recid( ub.tax )
      143     .
      144     for each tt-tax-units where
      145             tt-tax-units.tax-code = partax-code:
      146         if tt-tax-units.is-found then do:
      147           create ub.tax-units.
      148           assign
      149           ub.tax-units.tax-code = partax-code
      150           ub.tax-units.type = tt-tax-units.type
      151           .
      152         end.
      153     END.
      154   end.
      155   if par-mode = 'ИЗМЕНЕНИЕ':U then do:
      156     FIND FIRST tax where
      157                recid(tax) = par-rid No-ERROR.
      158     if error-status:error then return error '':U.
      159     if parto-cashdesk =  yes and
      160        par-individual = yes  AND
      161        can-find(first tax No-LOCK WHERE
      162                       tax.to-cashdesk = yes AND
      163                       tax.individual = yes AND
      164                       recid(tax) <> par-rid) then  do:
      165       message "В связи с особенностями работы POS IBM" skip
      166               "количество определенных в системе " skip
      167               "индивидуальных налогов, пересылаемых на кассу"
      168               "не может быть больше одного" view-as alert-box ERROR .
      169       var-entry =  "individual":U.
      170       return error var-entry.
      171     end.
      172     if  integer(partax-code) < 4 + 1 then do:
      173       assign
      174       tax.to-cashdesk = parto-cashdesk
      175       par-rid = recid(tax).
      176     end.
      177     else do:
      178       assign
      179       tax.to-cashdesk = parto-cashdesk
      180       tax.tax-name = partax-name
      181       par-rid = recid(tax).
      182     end.
      183     if integer(partax-code) > 4 + 1 then do:
      184       for each tt-tax-units where
      185               tt-tax-units.tax-code = partax-code:
      186         if tt-tax-units.is-found then do:
      187           find first ub.tax-units where
      188                 ub.tax-units.tax-code = partax-code AND
      189                 ub.tax-units.type= tt-tax-units.type No-ERROR.
      190           if not avail ub.tax-units then do:
      191             create ub.tax-units.
      192             assign
      193             ub.tax-units.tax-code = partax-code
      194             ub.tax-units.type = tt-tax-units.type
      195             .
      196           end.
      197         end.
      198         else do:
      199           find first ub.tax-units where
      200                 ub.tax-units.tax-code = partax-code AND
      201                 ub.tax-units.type= tt-tax-units.type No-ERROR.
      202           if avail ub.tax-units then do:
      203             delete ub.tax-units.
      204           end.
      205         end.
      206       END.
      207     END.
      208   end.
      209   return '':U.
