      541   def new shared var bc-frmt as character no-undo .
      542   def new shared var bc-pfx  as character no-undo .
      543   def var bc-par-type as character no-undo .
      544       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      545       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      546           do:
      547               message "Не задан или не верно задан ТИП собственного бар-кода!"
      548                   view-as alert-box ERROR TITLE "".
      549               return error.
      550           end.
      551       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      552       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      553           do:
      554               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      555                   view-as alert-box ERROR TITLE "".
      556               return error.
      557           end.
      558   PROCEDURE gen-bc:
      559     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      560     def output parameter full-b-code     as character init ""    no-undo .
      561   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      562     define variable tmp-str10  as character no-undo.
      563     define variable tmp-num10  as character no-undo.
      564     define variable i10        as integer   no-undo.
      565     define variable sum10      as integer   no-undo.
      566     define variable len-code10 as integer   no-undo.
      567     define variable varcont10  as logical   initial yes no-undo.
      568     CASE bc-frmt :
      569       WHEN "EAN13" THEN do:
      570         assign
      571           tmp-str10 = string( internal-b-code, "999999999999" )
      572         .
      573       end.
      574       WHEN "EAN8" THEN do:
      575         assign
      576           tmp-str10 = string( internal-b-code, "9999999" )
      577         .
      578       end.
      579       OTHERWISE DO:
      580           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      581           view-as alert-box error.
      582           return error.
      583       END.
      584     END CASE.
      585     if varcont10 = yes then do:
      586       if integer( substring( tmp-str10, 1, length( bc-pfx ) ) ) <> 0
      587       then do:
      588         message
      589           "Невозможно сформировать бар-код" SKIP
      590           "для товара с кодом: " internal-b-code
      591           view-as alert-box error title "подрезание кода".
      592         return error.
      593       end.
      594       else do:
      595         assign
      596           full-b-code = bc-pfx + substring( tmp-str10, length( bc-pfx ) + 1, length( tmp-str10 ) - length( bc-pfx ) )
      597           len-code10    = length( full-b-code )
      598         .
      599         define variable v-sum-char10 as character no-undo .
      600         assign
      601           sum10 = 0
      602         .
      603         do i10 = 1 to len-code10 by 2
      604         :
      605           assign
      606             v-sum-char10 = substr(full-b-code, len-code10 - i10 + 1, 1)
      607           .
      608           if v-sum-char10 < "0"
      609           or v-sum-char10 > "9"
      610           then do:
      611             message
      612               "Невозможно сформировать бар-код" skip
      613               "для товара с кодом: " internal-b-code skip
      614               view-as alert-box error title "подсчет контрольной суммы".
      615             return error.
      616           end.
      617           assign
      618             sum10 = sum10 + integer(v-sum-char10)
      619           .
      620         end.
      621         if varcont10 = yes then do:
      622           assign
      623             sum10 = sum10 * 3
      624           .
      625           do i10 = 2 to len-code10 by 2
      626           :
      627             assign
      628               v-sum-char10 = substr(full-b-code, len-code10 - i10 + 1, 1)
      629             .
      630             if v-sum-char10 < "0"
      631             or v-sum-char10 > "9"
      632             then do:
      633               message
      634                 "Невозможно сформировать бар-код" skip
      635                 "для товара с кодом: " internal-b-code skip
      636                 view-as alert-box error title "подсчет контрольной суммы".
      637               return error.
      638             end.
      639             assign
      640               sum10 = sum10 + integer(v-sum-char10)
      641             .
      642           end.
      643           if varcont10 = yes then do:
      644              if sum10 mod 10 = 0 then do:
      645                assign
      646                  full-b-code = full-b-code + '0'
      647                .
      648              end.
      649              else do:
      650                assign
      651                  full-b-code = full-b-code + string(10 - sum10 mod 10)
      652                .
      653              end.
      654           end.
      655         end.
      656       end.
      657     end.
      658   END PROCEDURE.
      659   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      660   procedure cr_dis-gds-rule-attr :
      661   def input parameter v-recid-rule-gds as int no-undo .
      662   def buffer buf_dis-gds-rule-attr for dis-gds-rule-attr .
      663   def buffer buf_dis-gds-rule for dis-gds-rule .
      664   def buffer buf_bar-code for ub.bar-code .
      665   def buffer buf_prod-bc  for prod-bc .
      666   def buffer buf_templ-dis-rule for dis-rule .
      667   def buffer buf_templ-dis-time-rule for dis-time-rule .
      668   def buffer buf_dis-cfg-rule   for dis-cfg-rule .
      669   def buffer buf_dis-rule   for dis-rule .
      670   define variable v-upd as character no-undo .
      671   define variable v-number-action as character no-undo .
      672   define variable v-bar-code as character no-undo .
      673   find buf_dis-gds-rule no-lock where recid(buf_dis-gds-rule) = v-recid-rule-gds  no-error.
      674   if avail buf_dis-gds-rule then
      675   do:
      676     find first buf_dis-rule no-lock where buf_dis-rule.rule-num = buf_dis-gds-rule.rule-num  no-error .
      677     find first buf_templ-dis-rule no-lock where buf_templ-dis-rule.rule-num = buf_dis-rule.templ-rl-root  no-error .
      678     if avail buf_templ-dis-rule and avail buf_dis-rule then
      679     do:
      680        find first buf_dis-cfg-rule no-lock where
      681                   buf_dis-cfg-rule.table-name = "dis-gds-rule"
      682               and buf_dis-cfg-rule.pos-type = buf_dis-gds-rule.pos-type
      683               and buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      684               and buf_dis-cfg-rule.time-templ-rl-root =  buf_dis-rule.time-templ-rl-root
      685               and buf_dis-cfg-rule.self-nonunique = ""
      686               and buf_dis-cfg-rule.nonunique = "bar-code.b-code"
      687               no-error.
      688        if avail buf_dis-cfg-rule then
      689        do:
      690          find first buf_bar-code no-lock where buf_bar-code.b-code = integer(buf_dis-gds-rule.nonunique) no-error.
      691          if avail buf_bar-code then
      692          do:
      693             run gen-bc(input buf_bar-code.b-code,output v-bar-code) .
      694             for each buf_prod-bc no-lock where buf_prod-bc.b-code = buf_bar-code.b-code :
      695               if buf_prod-bc.bc-on = yes then
      696               do:
      697                  v-upd = 'A' .
      698               end.
      699               else
      700               do:
      701                  v-upd = "D" .
      702               end.
      703               find first  buf_dis-gds-rule-attr WHERE
      704                   buf_dis-gds-rule-attr.gds-code = buf_dis-gds-rule.gds-code
      705               AND buf_dis-gds-rule-attr.obj-type = buf_dis-gds-rule.obj-type
      706               AND buf_dis-gds-rule-attr.obj-code = buf_dis-gds-rule.obj-code
      707               AND buf_dis-gds-rule-attr.pos-type = buf_dis-gds-rule.pos-type
      708               AND buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
      709               and buf_dis-gds-rule-attr.nonunique = buf_dis-gds-rule.nonunique
      710               and entry(1,buf_dis-gds-rule-attr.attr-value,",") = buf_prod-bc.b-str
      711                    exclusive-lock no-error .
      712               if (not avail buf_dis-gds-rule-attr) and (not locked buf_dis-gds-rule-attr) then
      713               do:
      714                   if v-upd = "A" then
      715                   do:
      716                       run def-number-action(buf_templ-dis-rule.rule-num,output v-number-action) .
      717                       create buf_dis-gds-rule-attr .
      718                       assign
      719                        buf_dis-gds-rule-attr.gds-code = buf_dis-gds-rule.gds-code
      720                        buf_dis-gds-rule-attr.obj-type = buf_dis-gds-rule.obj-type
      721                        buf_dis-gds-rule-attr.obj-code = buf_dis-gds-rule.obj-code
      722                        buf_dis-gds-rule-attr.pos-type = buf_dis-gds-rule.pos-type
      723                        buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
      724                        buf_dis-gds-rule-attr.nonunique = buf_dis-gds-rule.nonunique
      725                        buf_dis-gds-rule-attr.attr-code = v-number-action
      726                        buf_dis-gds-rule-attr.attr-value = buf_prod-bc.b-str + "," + v-upd
      727                       .
      728                   end.
      729               end.
      730               else
      731               do:
      732                 if avail buf_dis-gds-rule-attr and  buf_dis-gds-rule-attr.attr-value <> v-upd then
      733                 do:
      734                  assign
      735                   buf_dis-gds-rule-attr.attr-value = buf_prod-bc.b-str + "," + v-upd
      736                   .
      737                 end.
      738               end.
      739             end.
      740             if v-bar-code <> '' then
      741             do:
      742               find first  buf_dis-gds-rule-attr WHERE
      743                   buf_dis-gds-rule-attr.gds-code = buf_dis-gds-rule.gds-code
      744               AND buf_dis-gds-rule-attr.obj-type = buf_dis-gds-rule.obj-type
      745               AND buf_dis-gds-rule-attr.obj-code = buf_dis-gds-rule.obj-code
      746               AND buf_dis-gds-rule-attr.pos-type = buf_dis-gds-rule.pos-type
      747               AND buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
      748               and buf_dis-gds-rule-attr.nonunique = buf_dis-gds-rule.nonunique
      749               and entry(1,buf_dis-gds-rule-attr.attr-value,",") = v-bar-code
      750                    exclusive-lock no-error .
      751               if not avail buf_dis-gds-rule-attr  then
      752               do:
      753                       run def-number-action(buf_templ-dis-rule.rule-num,output v-number-action) .
      754                       create buf_dis-gds-rule-attr .
      755                       assign
      756                        buf_dis-gds-rule-attr.gds-code = buf_dis-gds-rule.gds-code
      757                        buf_dis-gds-rule-attr.obj-type = buf_dis-gds-rule.obj-type
      758                        buf_dis-gds-rule-attr.obj-code = buf_dis-gds-rule.obj-code
      759                        buf_dis-gds-rule-attr.pos-type = buf_dis-gds-rule.pos-type
      760                        buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
      761                        buf_dis-gds-rule-attr.nonunique = buf_dis-gds-rule.nonunique
      762                        buf_dis-gds-rule-attr.attr-code = v-number-action
      763                        buf_dis-gds-rule-attr.attr-value = v-bar-code + "," + "A"
      764                       .
      765               end.
      766             end.
      767             for each  buf_dis-gds-rule-attr WHERE
      768                   buf_dis-gds-rule-attr.gds-code = buf_dis-gds-rule.gds-code
      769               AND buf_dis-gds-rule-attr.obj-type = buf_dis-gds-rule.obj-type
      770               AND buf_dis-gds-rule-attr.obj-code = buf_dis-gds-rule.obj-code
      771               AND buf_dis-gds-rule-attr.pos-type = buf_dis-gds-rule.pos-type
      772               AND buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
      773               and buf_dis-gds-rule-attr.nonunique = buf_dis-gds-rule.nonunique
      774                     :
      775                find first buf_prod-bc no-lock where
      776                     buf_prod-bc.b-str = entry(1,buf_dis-gds-rule-attr.attr-value,",")
      777                        and can-find(first buf_bar-code where buf_bar-code.b-code = int(buf_dis-gds-rule.nonunique))
      778                        no-error.
      779                if not avail buf_prod-bc or (avail buf_prod-bc and buf_prod-bc.bc-on = no) then
      780                do:
      781                  if entry(1,buf_dis-gds-rule-attr.attr-value,",") <> v-bar-code then
      782                  do:
      783                    v-upd = "D" .
      784                    if buf_dis-gds-rule-attr.attr-value <> v-upd then
      785                    do:
      786                      assign
      787                      buf_dis-gds-rule-attr.attr-value = buf_prod-bc.b-str + "," + v-upd
      788                      .
      789                    end.
      790                  end.
      791                end.
      792             end.
      793          end.
      794        end.
      795     end.
      796   end.
      797   end procedure .
      798   procedure def-number-action :
      799     define input  parameter p-templ-rl-root as int no-undo .
      800     define output parameter p-number-action as char no-undo .
      801     define variable v-action as integer   no-undo .
      802     def buffer buf_dis-rule-attr for dis-rule-attr .
      803     find first buf_dis-rule-attr exclusive-lock where buf_dis-rule-attr.rule-num = p-templ-rl-root
      804                                          and buf_dis-rule-attr.attr-code =  "NCR bonus-qnty"
      805                                          no-error.
      806     if not avail buf_dis-rule-attr then
      807     do:
      808       create buf_dis-rule-attr .
      809       assign
      810          buf_dis-rule-attr.rule-num = p-templ-rl-root
      811          buf_dis-rule-attr.attr-code =  "NCR bonus-qnty"
      812          buf_dis-rule-attr.attr-value = "3100101"
      813          p-number-action = buf_dis-rule-attr.attr-value
      814          .
      815     end.
      816     else
      817     do:
      818        v-action = integer(buf_dis-rule-attr.attr-value) no-error .
      819        if error-status:error = no then
      820        do:
      821          assign
      822             v-action = v-action + 1
      823             buf_dis-rule-attr.attr-value = string(v-action)
      824             p-number-action = buf_dis-rule-attr.attr-value
      825             .
      826        end.
      827     end.
      828   end procedure.
      829   define variable p-obj-type like ub.clients.obj-type no-undo .
      830   define variable p-obj-code like ub.clients.obj-code no-undo .
      831   define variable pardelete-ok as logical no-undo .
      832   define variable p-list-name as character no-undo .
      833   DEFINE VARIABLE var-object as character no-undo init 'dis-gds-rule':U.
      834   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      835   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
      836   def var vl_bin as char no-undo init "".
      837   if vl_int < 0 OR vl_int = ? then return ?.
      838   do while vl_int > 0:
      839     assign
      840     vl_bin = (if vl_int modulo 2 = 0
      841                 then "0":U
      842                 else "1":U) + vl_bin
      843     vl_int = truncate(vl_int / 2,0).
      844   end.
      845   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
      846   END FUNCTION.
      847   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
      848                                    input vl_binm as character):
      849   DEFINE VARIABLE vl_bin as character no-undo.
      850   DEFINE VARIABLE ii as integer no-undo.
      851   DEFINE VARIABLE ii-len as integer no-undo.
      852   DEFINE VARIABLE ii-lenm as integer no-undo.
      853   DEFINE VARIABLE mchar as character no-undo.
      854   DEFINE VARIABLE ichar as character no-undo.
      855   if vl_binm = ? then return ?.
      856   vl_bin = CIntBinS(vl_int).
      857   if vl_bin = ? then return ?.
      858   assign
      859   vl_binm = LEFT-TRIM(vl_binm, "X":U)
      860   ii-lenm = LENGTH(vl_binm)
      861   ii-len = LENGTH(vl_bin) - ii-lenm
      862   .
      863   if II-LENM > 32 THEN RETURN ?.
      864   DO II = 1 to II-LENm:
      865     assign
      866     mchar = SUBSTR(vl_binm, ii, 1)
      867     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
      868     .
      869     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
      870     IF ichar <> mchar AND mchar <> "X":U then return no.
      871   END.
      872   return yes.
      873   END FUNCTION.
      874   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      875   define SHARED temp-table temp-disc no-undo
