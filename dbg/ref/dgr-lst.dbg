       90   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   define temp-table temp-drt-prop no-undo like ub.drt-prop.
       93   procedure disrules-fill-properties:
       94   define input  parameter p-templ-rl-root as integer   no-undo .
       95   define buffer buf_drt-prop for ub.drt-prop.
       96   define buffer buf_temp-drt-prop for temp-drt-prop.
       97   do
       98   on error undo, return error return-value
       99   :
      100     for each buf_temp-drt-prop:
      101       delete buf_temp-drt-prop.
      102     end.
      103     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      104       create buf_temp-drt-prop.
      105       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      106     end.
      107   end.
      108   end procedure.
      109   ~
      110   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111   procedure discfgru-check :
      112   define input parameter p-table-name as character no-undo .
      113   define input parameter p-templ-rl-root as integer no-undo .
      114   define input parameter p-time-templ-rl-root as integer no-undo .
      115   define input parameter p-pos-type as character no-undo .
      116   define output parameter p-disnct-role as character no-undo .
      117   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      118     do
      119     on error undo, return error return-value
      120     :
      121       find first buf_dis-cfg-rule no-lock where
      122               buf_dis-cfg-rule.table-name = p-table-name
      123           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      124           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      125           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      126       if not available buf_dis-cfg-rule
      127       or p-pos-type = "":U
      128       then do:
      129          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      130                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      131                                  , p-templ-rl-root
      132                                  , (if p-time-templ-rl-root = ?
      133                                     then '':U
      134                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      135                                     )
      136                                  ).
      137       end.
      138       assign
      139       p-disnct-role = buf_dis-cfg-rule.discnt-role
      140       .
      141     end.
      142   end procedure.
      143   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      144   FUNCTION get-region RETURNS CHARACTER
      145     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      146     define variable par-region as character no-undo.
      147     if parhost-code = 0 and
      148          parobj-type = "":U and
      149          parobj-code = 0 then do:
      150          par-region = "Глобально".
      151          return par-region.
      152       end.
      153       if parobj-type = 'орг':U then do:
      154          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      155          return par-region.
      156       end.
      157       if parobj-type = 'регион':U
      158       then do:
      159          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      160          return par-region.
      161       end.
      162       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      163       return par-region.
      164   END FUNCTION.
      165   FUNCTION get-objregion RETURNS CHARACTER
      166     (  input parobj-type as character, input parobj-code as integer ) :
      167     define variable par-region as character no-undo.
      168     if  parobj-type = "":U and
      169         parobj-code = 0
      170     then do:
      171        par-region = "Глобально".
      172     end.
      173     else if parobj-type = 'орг':U
      174     then do:
      175        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      176     end.
      177     else if parobj-type = 'регион':U
      178     then do:
      179        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      180     end.
      181     else
      182        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      183     return par-region.
      184   END FUNCTION.
      185   procedure disgdsru-name :
      186   define buffer buf_dis-rule for ub.dis-rule.
      187   do
      188     on error undo, return error
      189     :
      190     define input  parameter p-templ-rl-root  as integer no-undo .
      191     define output parameter p-label          as character no-undo .
      192     find first buf_dis-rule no-lock where
      193               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      194     if available buf_dis-rule
      195     then do:
      196       if buf_dis-rule.rule-num > 0 then
      197       p-label = buf_dis-rule.des.
      198     end.
      199     else do:
      200       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
      201     end.
      202   end.
      203   end procedure.
      204   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
      205   define variable v-rule-label as character no-undo .
      206   run disgdsru-name in this-procedure ( input p-templ-rl-root
      207                                        ,output v-rule-label) no-error.
      208   return v-rule-label.
      209   end function.
      210   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
      211   define variable v-rule-label as character no-undo .
      212   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
      213   end function.
      214   procedure disgdsru-write :
      215     do
      216     on error undo, return error
      217     :
      218       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
      219       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
      220       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
      221       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
      222       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
      223       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
      224       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
      225       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
      226       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
      227       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
      228       define buffer buf_dis-rule for ub.dis-rule.
      229       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
      230       define variable v-label          as character no-undo .
      231       define variable v-discnt-role as character no-undo .
      232       run discfgru-check in this-procedure (
      233                                             input 'dis-gds-rule':U
      234                                            ,input p-templ-rl-root
      235                                            ,input p-time-templ-rl-root
      236                                            ,input p-pos-type
      237                                            ,output v-discnt-role
      238                                             ) no-error .
      239       if error-status :error then do:
      240         undo, return error return-value .
      241       end.
      242       if p-discnt-role = ? then do:
      243         p-discnt-role = v-discnt-role.
      244       end.
      245       if p-discnt-role <> v-discnt-role then do:
      246         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
      247                                 ,p-gds-code
      248                                 ,p-obj-type
      249                                 ,p-obj-code
      250                                 ,p-pos-type
      251                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      252                                 ,chr(10)
      253                                 ,p-templ-rl-root
      254                                 ,p-rule-num).
      255       end.
      256       if p-pos-type = ? then do:
      257   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      258   define variable v-param-type5 as character no-undo .
      259   define variable v-value-date5 as date no-undo .
      260   define variable v-value-decimal5 as decimal no-undo .
      261   define variable v-value-integer5 as INTEGER no-undo .
      262   define variable v-value-logical5 AS LOGICAL no-undo .
      263   define variable v-tth5 as handle no-undo .
      264   run adm/shattri.p (
      265       input "get":U
      266       ,input  p-obj-type
      267       ,input  p-obj-code
      268       ,input  'cd-sending':U
      269       ,input  'dflt-cd':U
      270       ,output p-pos-type
      271       ,output v-value-date5
      272       ,output v-value-decimal5
      273       ,output v-value-integer5
      274       ,output v-value-logical5
      275       ,output v-param-type5
      276       ,INPUT-OUTPUT table-handle v-tth5
      277       )  .
      278   delete object v-tth5 no-error.
      279       end.
      280       find first buf_dis-rule no-lock where
      281                 buf_dis-rule.rule-num = p-rule-num no-error.
      282       if not available buf_Dis-rule then do:
      283         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
      284                                 ,p-gds-code
      285                                 ,p-obj-type
      286                                 ,p-obj-code
      287                                 ,p-pos-type
      288                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      289                                 ,chr(10)
      290                                 ,p-rule-num).
      291       end.
      292       if buf_dis-rule.root <> yes then do:
      293         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
      294                                 ,p-gds-code
      295                                 ,p-obj-type
      296                                 ,p-obj-code
      297                                 ,p-pos-type
      298                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      299                                 ,chr(10)
      300                                 ,p-rule-num).
      301       end.
      302       if not (p-obj-type = buf_dis-rule.obj-type
      303           and p-obj-code = buf_dis-rule.obj-code)
      304       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
      305                and
      306                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
      307        then do:
      308         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
      309                                 ,p-gds-code
      310                                 ,p-obj-type
      311                                 ,p-obj-code
      312                                 ,p-pos-type
      313                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      314                                 ,chr(10)
      315                                 ) +
      316                             substitute("Правило скидки &1 определено для &2&3" +
      317                                        "а привязка к товару для &4"
      318                                        ,buf_dis-rule.rule-num
      319                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
      320                                        ,chr(10)
      321                                        ,get-objregion( p-obj-type, p-obj-code)
      322                                        ))
      323                                 .
      324       end.
      325       find first buf_dis-gds-rule exclusive-lock where
      326                  buf_dis-gds-rule.gds-code  = p-gds-code
      327              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
      328              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
      329              AND buf_dis-gds-rule.pos-type  = p-pos-type
      330              AND buf_dis-gds-rule.discnt-role = p-discnt-role
      331              and buf_dis-gds-rule.nonunique = p-nonunique
      332              no-error .
      333       if not available buf_dis-gds-rule then do:
      334         find first buf_dis-gds-rule exclusive-lock where
      335                   buf_dis-gds-rule.gds-code  = p-gds-code
      336               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
      337               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
      338               AND buf_dis-gds-rule.pos-type  = p-pos-type
      339               AND buf_dis-gds-rule.discnt-role = p-discnt-role
      340               no-error .
      341         if available buf_Dis-gds-rule then do:
      342           if p-nonunique = ''
      343           and available buf_dis-gds-rule
      344           then do:
      345             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
      346                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      347                                      , p-gds-code
      348                                      , buf_Dis-rule.obj-type
      349                                      , buf_Dis-rule.obj-code
      350                                      , p-nonunique
      351                                     ).
      352           end.
      353           if available buf_dis-gds-rule
      354           and buf_dis-gds-rule.nonunique = ''
      355           and p-nonunique <> ''then do:
      356             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
      357                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      358                                      , p-gds-code
      359                                      , buf_Dis-rule.obj-type
      360                                      , buf_Dis-rule.obj-code
      361                                     ).
      362           end.
      363         end.
      364         create buf_dis-gds-rule .
      365         assign
      366         buf_dis-gds-rule.gds-code  = p-gds-code
      367         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
      368         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
      369         buf_dis-gds-rule.pos-type = p-pos-type
      370         buf_dis-gds-rule.discnt-role = v-discnt-role
      371         buf_dis-gds-rule.rule-num = p-rule-num
      372         buf_dis-gds-rule.nonunique = p-nonunique
      373         no-error
      374         .
      375       end.
      376       ASSIGN
      377       buf_dis-gds-rule.rule-num = p-rule-num
      378       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
      379       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
      380       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
      381       buf_dis-gds-rule.nonunique = p-nonunique
      382       no-error.
      383     end.
      384   end procedure.
      385   PROCEDURE cmp-disgdsru-write :
      386   do
      387   on error undo, return error
      388   :
      389     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
      390     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
      391     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
      392     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
      393     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
      394     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
      395     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
      396     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
      397     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
      398     define variable v-rule-label          as character no-undo .
      399     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
      400     define buffer buf_dis-rule     for ub.dis-rule.
      401     run disgdsru-name in this-procedure (
      402                                         input  p-templ-rl-root
      403                                         ,output v-rule-label
      404                                         ) no-error .
      405     if error-status :error then do:
      406       undo, return error return-value .
      407     end.
      408     find first buf_tt0-dis-gds-rule exclusive-lock where
      409                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
      410             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
      411             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
      412             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
      413             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
      414             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
      415             no-error .
      416     if not available buf_tt0-dis-gds-rule then do:
      417       create buf_tt0-dis-gds-rule .
      418       assign
      419       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
      420       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
      421       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
      422       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
      423       buf_tt0-dis-gds-rule.nonunique = p-nonunique
      424       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
      425       no-error
      426       .
      427     end.
      428     find first buf_dis-rule no-lock where
      429               buf_dis-rule.rule-num = p-rule-num.
      430     ASSIGN
      431     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
      432     buf_tt0-dis-gds-rule.rule-num = p-rule-num
      433     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
      434     buf_tt0-dis-gds-rule.nonunique = p-nonunique
      435     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
      436     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
      437     no-error.
      438     release buf_tt0-dis-gds-rule no-error .
      439     if error-status:error then do:
      440       undo, return error return-value .
      441     end.
      442   end.
      443   END PROCEDURE.
