      895   procedure temp-dsc-value :
      896   define input  parameter p-pos-type  as character  no-undo .
      897   define input  parameter p-templ-rl-root as integer  no-undo .
      898   define input  parameter p-time-templ-rl-root as integer no-undo .
      899   define input  parameter p-discnt-role  as character  no-undo .
      900   define input  parameter p-cfg-nonunique as character no-undo .
      901   define input  parameter p-host-code as integer no-undo .
      902   define input  parameter p-obj-type  as character no-undo .
      903   define input  parameter p-obj-code as integer no-undo .
      904   define input  parameter p-0mode as character no-undo .
      905   define input  parameter p-mode      as character no-undo .
      906   define input  parameter p-rec as recid no-undo .
      907   define output parameter p-rule-num    as integer no-undo .
      908   define output parameter p-nonunique   as character no-undo .
      909   define buffer buf_temp-disc for temp-disc .
      910   define variable v-discnt-role as character no-undo .
      911   define variable v-rule-num as integer no-undo .
      912   define variable v-nonunique as character no-undo .
      913   define variable v-templ-rl-root as integer no-undo .
      914   define variable v-time-templ-rl-root as integer no-undo .
      915   define variable v-setted         as logical   no-undo .
      916   define variable choice as integer no-undo .
      917   do
      918   on error undo, return error
      919   :
      920     case var-object:
      921       when 'dis-gds-rule':U
      922       then do:
      923         run discfgru-check  in this-procedure (
      924                                                  input 'dis-gds-rule':U
      925                                                 ,input p-templ-rl-root
      926                                                 ,input p-time-templ-rl-root
      927                                                 ,input p-pos-type
      928                                                 ,output v-discnt-role) no-error.
      929       end.
      930       when 'dis-dc-rule':U then do:
      931         run discfgru-check  in this-procedure (
      932                                                  input 'dis-dc-rule':U
      933                                                 ,input p-templ-rl-root
      934                                                 ,input p-time-templ-rl-root
      935                                                 ,input p-pos-type
      936                                                 ,output v-discnt-role) no-error.
      937       end.
      938       when 'dis-cp-rule':U then do:
      939         run discfgru-check  in this-procedure (
      940                                                  input 'dis-cp-rule':U
      941                                                 ,input p-templ-rl-root
      942                                                 ,input p-time-templ-rl-root
      943                                                 ,input p-pos-type
      944                                                 ,output v-discnt-role) no-error.
      945       end.
      946       otherwise do:
      947         undo, return error .
      948       end.
      949     end case.
      950     if error-status :error
      951     then do:
      952       undo, return error return-value .
      953     end.
      954     if p-mode = "change":U
      955     then do:
      956       if p-rec <> ? then do:
      957         find first buf_temp-disc no-lock where
      958               recid(buf_temp-disc) = p-rec
      959           no-error .
      960       end.
      961       else do:
      962         find first buf_temp-disc no-lock where
      963                   buf_temp-disc.pos-type = p-pos-type
      964               and buf_temp-disc.discnt-role = p-discnt-role
      965               and buf_temp-disc.nonunique  = p-nonunique
      966               and buf_temp-disc.host-code = p-host-code
      967               and buf_temp-disc.obj-type = p-obj-type
      968               and buf_temp-disc.obj-code = p-obj-code
      969           no-error .
      970       end.
      971       if avail buf_temp-disc then do:
      972         assign
      973         v-rule-num =  buf_temp-disc.rule-num
      974         v-nonunique = buf_temp-disc.nonunique
      975         v-templ-rl-root = buf_temp-disc.templ-rl-root
      976         v-time-templ-rl-root = buf_temp-disc.time-templ-rl-root
      977         .
      978       end.
      979     end.
      980     CASE var-object:
      981     END CASE.
      982     if v-setted = no then do:
      983       return "not-set":U.
      984     end.
      985     p-rule-num = v-rule-num.
      986     p-nonunique = v-nonunique.
      987   end.
      988   end procedure.
      989   procedure temp-dsc-write :
      990     do
      991     on error undo, return error
      992     :
      993       define input parameter p-add      as logical no-undo .
      994       define input parameter p-pos-type as character  no-undo .
      995       define input parameter p-templ-rl-root as integer  no-undo .
      996       define input parameter p-time-templ-rl-root as integer  no-undo .
      997       define input parameter p-discnt-role as character  no-undo .
      998       define input parameter p-cfg-nonunique as character no-undo .
      999       define input parameter p-host-code as integer no-undo .
     1000       define input parameter p-obj-type as character no-undo .
     1001       define input parameter p-obj-code as integer no-undo .
     1002       define input parameter p-rule-num  as integer no-undo .
     1003       define input parameter p-action   like temp-disc.action no-undo .
     1004       define input-output parameter p-rec as recid no-undo .
     1005       define buffer buf_temp-disc for temp-disc .
     1006       define variable v-discnt-role as character no-undo .
     1007       define variable varhost-code like ub.clients.host-code no-undo.
     1008       define variable varobj-type like ub.clients.obj-type no-undo.
     1009       define variable varobj-code like ub.clients.obj-code no-undo.
     1010       define variable choice as integer no-undo .
     1011       define var loc#log as logical no-undo.
     1012       define variable loc-action as logical no-undo.
     1013       define variable v-nonunique as character no-undo .
     1014       define buffer buf_dis-rule for ub.dis-rule.
     1015       case var-object:
     1016         when 'dis-gds-rule':U
     1017         then do:
     1018           run discfgru-check  in this-procedure (
     1019                                                   input 'dis-gds-rule':U
     1020                                                  ,input p-templ-rl-root
     1021                                                  ,input p-time-templ-rl-root
     1022                                                  ,input p-pos-type
     1023                                                  ,output v-discnt-role) no-error.
     1024         end.
     1025         when 'dis-dc-rule':U
     1026         then do:
     1027           run discfgru-check  in this-procedure (
     1028                                                   input 'dis-dc-rule':U
     1029                                                  ,input p-templ-rl-root
     1030                                                  ,input p-time-templ-rl-root
     1031                                                  ,input p-pos-type
     1032                                                  ,output v-discnt-role) no-error.
     1033         end.
     1034         when 'dis-cp-rule':U
     1035         then do:
     1036           run discfgru-check  in this-procedure (
     1037                                                   input 'dis-cp-rule':U
     1038                                                  ,input p-templ-rl-root
     1039                                                  ,input p-time-templ-rl-root
     1040                                                  ,input p-pos-type
     1041                                                  ,output v-discnt-role) no-error.
     1042         end.
     1043         otherwise do:
     1044           undo, return error .
     1045         end.
     1046       END CASE.
     1047       if error-status :error then do:
     1048         undo, return error return-value .
     1049       end.
     1050       if p-cfg-nonunique <> '':U
     1051       and p-rule-num <> 0
     1052       and p-rule-num <> ?
     1053       then do:
     1054         find first buf_dis-rule no-lock where
     1055                 buf_dis-rule.rule-num = p-rule-num no-error.
     1056         if not available buf_dis-rule then do:
     1057           undo, return error substitute("Не найдено правило скидок &1", p-rule-num).
     1058         end.
     1059         assign
     1060         v-nonunique = (if p-cfg-nonunique = '':U
     1061                       then '':U
     1062                       else (if p-cfg-nonunique begins "@"
     1063                             then left-trim(p-cfg-nonunique, "@")
     1064                             else string(buffer buf_Dis-rule:handle:buffer-field(p-cfg-nonunique):buffer-value)
     1065                             ))
     1066         .
     1067       end.
     1068       if p-rec <> ? then do:
     1069         find first buf_temp-disc exclusive-lock where
     1070                   recid(buf_temp-disc) = p-rec no-error .
     1071       end.
     1072       else do:
     1073         find first buf_temp-disc exclusive-lock where
     1074                   buf_temp-disc.pos-type = p-pos-type
     1075                 and buf_temp-disc.discnt-role = p-discnt-role
     1076                 and buf_temp-disc.host-code = p-host-code
     1077                 and buf_temp-disc.obj-type = p-obj-type
     1078                 and buf_temp-disc.obj-code = p-obj-code
     1079                 and buf_temp-disc.nonunique = v-nonunique
     1080                 no-error .
     1081       end.
     1082       if not available buf_temp-disc then do:
     1083         create buf_temp-disc .
     1084         assign
     1085         buf_temp-disc.host-code = p-host-code
     1086         buf_temp-disc.obj-type = p-obj-type
     1087         buf_temp-disc.obj-code = p-obj-code
     1088         buf_temp-disc.rule-num = p-rule-num
     1089         buf_temp-disc.action = p-action
     1090         buf_temp-disc.pos-type = p-pos-type
     1091         buf_temp-disc.discnt-role = p-discnt-role
     1092         buf_temp-disc.cfg-nonunique = p-cfg-nonunique
     1093         buf_temp-disc.rule-num = p-rule-num
     1094         buf_temp-disc.nonunique = v-nonunique
     1095         buf_temp-disc.time-templ-rl-root = p-time-templ-rl-root
     1096         buf_temp-disc.templ-rl-root = p-templ-rl-root
     1097         p-rec = recid(buf_temp-disc)
     1098         no-error
     1099         .
     1100       end.
     1101       ELSE do:
     1102         if p-add then do:
     1103            message
     1104            substitute("Такая скидка уже добавлена&1"
     1105                       ,chr(10)
     1106                   )
     1107            view-as alert-box error .
     1108           undo, return error "not-set" .
     1109         end.
     1110         ASSIGN
     1111         buf_temp-disc.rule-num = p-rule-num
     1112         buf_temp-disc.nonunique = v-nonunique
     1113         buf_temp-disc.time-templ-rl-root = p-time-templ-rl-root
     1114         buf_temp-disc.templ-rl-root = p-templ-rl-root
     1115         p-rec = recid(buf_temp-disc)
     1116         no-error.
     1117       end.
     1118     end.
     1119   end procedure.
     1120   procedure temp-dsc-exist :
     1121   define input parameter p-pos-type as character  no-undo .
     1122   define input parameter p-templ-rl-root as integer  no-undo .
     1123   define input parameter p-time-templ-rl-root as integer no-undo .
     1124   define input parameter p-discnt-role as character  no-undo .
     1125   define input parameter p-nonunique as character no-undo .
     1126   define input parameter p-host-code as integer no-undo .
     1127   define input parameter p-obj-type as character no-undo .
     1128   define input parameter p-obj-code as integer no-undo .
     1129   define output parameter p-exist    as logical no-undo .
     1130   define output parameter p-action as logical no-undo .
     1131   define variable v-discnt-role as character no-undo .
     1132   define buffer buf_temp-disc for temp-disc .
     1133     do
     1134     on error undo, return error
     1135     :
     1136       case var-object:
     1137         when 'dis-gds-rule':U then do:
     1138           run discfgru-check  in this-procedure (
     1139                                                   input 'dis-gds-rule':U
     1140                                                  ,input p-templ-rl-root
     1141                                                  ,input p-time-templ-rl-root
     1142                                                  ,input p-pos-type
     1143                                                  ,output v-discnt-role) no-error.
     1144         end.
     1145         when 'dis-dc-rule':U then do:
     1146           run discfgru-check  in this-procedure (
     1147                                                   input 'dis-dc-rule':U
     1148                                                  ,input p-templ-rl-root
     1149                                                  ,input p-time-templ-rl-root
     1150                                                  ,input p-pos-type
     1151                                                  ,output v-discnt-role) no-error.
     1152         end.
     1153         otherwise do:
     1154           undo, return error .
     1155         end.
     1156       end case.
     1157       if error-status :error
     1158       then do:
     1159         undo, return error return-value .
     1160       end.
     1161       find first buf_temp-disc no-lock where
     1162                  buf_temp-disc.pos-type = p-pos-type
     1163               and buf_temp-disc.discnt-role = p-discnt-role
     1164               and buf_temp-disc.host-code = p-host-code
     1165               and buf_temp-disc.obj-type = p-obj-type
     1166               and buf_temp-disc.obj-code = p-obj-code
     1167               and buf_temp-disc.nonunique = p-nonunique no-error .
     1168       if available buf_temp-disc then do:
     1169         P-EXIST = YES.
     1170         p-action = buf_temp-disc.action.
     1171       end.
     1172     end.
     1173   end procedure.
     1174   procedure temp-dsc-delete :
     1175   define input parameter p-pos-type as character  no-undo .
     1176   define input parameter p-discnt-role as character no-undo .
     1177   define input parameter p-nonunique as character no-undo .
     1178   define input parameter p-host-code  as integer no-undo .
     1179   define input parameter p-obj-type as character no-undo .
     1180   define input parameter p-obj-code as integer no-undo .
     1181   define input parameter p-action as logical no-undo .
     1182   define output parameter p-deleted  as logical no-undo .
     1183   define buffer buf_temp-disc for temp-disc .
     1184     do
     1185     on error undo, return error :
     1186       case var-object:
     1187         when 'dis-gds-rule':U
     1188         then do:
     1189           error-status:error = no.
     1190         end.
     1191         when 'dis-dc-rule':U
     1192         then do:
     1193           error-status:error = no.
     1194         end.
     1195         when 'dis-cp-rule':U
     1196         then do:
     1197           error-status:error = no.
     1198         end.
     1199         otherwise do:
     1200           undo, return error .
     1201         end.
     1202       END CASE.
     1203       if error-status :error then do:
     1204         undo, return error return-value .
     1205       end.
     1206       find first buf_temp-disc exclusive-lock where
     1207                  buf_temp-disc.pos-type = p-pos-type
     1208              and buf_temp-disc.discnt-role = p-discnt-role
     1209              and buf_temp-disc.host-code = p-host-code
     1210              and buf_temp-disc.obj-type = p-obj-type
     1211              and buf_temp-disc.obj-code = p-obj-code
     1212              and buf_temp-disc.nonunique = p-nonunique
     1213              and buf_temp-disc.action = p-action
     1214              no-error .
     1215       if not available buf_temp-disc then do:
     1216         P-DELETED = NO.
     1217       end.
     1218       ELSE DO:
     1219          delete buf_temp-disc.
     1220          P-DELETED = YES.
     1221       END.
     1222     end.
     1223   end procedure.
     1224   define variable v-no-ask as logical no-undo .
     1225   define variable v-view-log as logical no-undo .
     1226   define variable log-file-name                as character      no-undo init "dgr-lst.txt".
     1227   define variable v-stop                       as logical        no-undo .
     1228   define variable v-choice as integer no-undo .
     1229   DEFINE VARIABLE num-rec as integer no-undo .
     1230   DEFINE VARIABLE num-rec-ok as integer no-undo .
     1231   define variable v-mes as character no-undo .
     1232   define variable v-ok as logical no-undo .
     1233   define variable loc-glob as logical no-undo.
     1234   define variable loc-firm as logical no-undo.
     1235   define variable loc-object as logical no-undo.
     1236   assign
     1237   p-obj-type  = entry(1, p-parameter, chr(4))
     1238   p-obj-code = integer(entry(2, p-parameter, chr(4)))
     1239   pardelete-ok = logical(entry(3, p-parameter, chr(4)))
     1240   p-list-name = entry(4, p-parameter, chr(4))
     1241   no-error
     1242   .
     1243   if error-status:error then do:
     1244    run write-log-and-file in p-log-handle (
     1245           input 1
     1246         , input log-file-name
     1247         , input 1
     1248         , input substitute("Ошибка входных параметров &1:&2&3&4"
     1249                            , p-parameter
     1250                            , chr(10)
     1251                            , error-status:get-message(1)
     1252                            , return-value
     1253                            )).
     1254     assign
     1255     v-view-log = yes.
     1256   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1257   if v-view-log
     1258   and not g#news
     1259   and not g#auto
     1260   then do:
     1261     message
     1262     '!!!При изменении скидок товара на объекте по списку товаров произошли ошибки!!!'  skip
     1263     "!!!Внимательно прочитайте Log-file!!"
     1264     view-as alert-box error .
     1265        define variable v-user-action15   as character no-undo .
     1266     define variable v-printed15       as logical   no-undo .
     1267     run gbl/prnfilen.w
     1268       (input  ('!!!При изменении скидок товара на объекте по списку товаров произошли ошибки!!!')
     1269       ,input  0
     1270       ,input  (string("./":U) + 'dgr-lst.txt')
     1271       ,input  7
     1272       ,output v-user-action15
     1273       ,output v-printed15
     1274       ) .
     1275   end.
     1276   if v-view-log = true
     1277   and (g#news
     1278   or g#auto)
     1279   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     1280   then do:
     1281      run cb_set-view-log in p-parent-handle ( input yes).
     1282   end.
     1283   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     1284     OS-DELETE value(string("./":U) + 'dgr-lst.txt').
     1285   end.
     1286     return .
     1287   end.
     1288   run write-log  in p-log-handle(
     1289                                    input 0
     1290                                  , "&DLine").
     1291   run write-log-and-file in p-log-handle (
     1292         input 1
     1293       , input log-file-name
     1294       , input 1
     1295       , input substitute("Изменение скидок товара на объекте &1&2 по списку товаров", p-obj-type, p-obj-code)).
     1296   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1297     run mainmenu_getcntxt in parparentproc
     1298       (output v-cntxt-db-num
     1299       ,output v-cntxt-userid
     1300       ,output v-cntxt-level
     1301       ,output v-cntxt-host-code-obj
     1302       ,output v-cntxt-obj-type
     1303       ,output v-cntxt-obj-code
     1304       ,output v-cntxt-db-num-obj
     1305       ,output v-cntxt-is-admin
     1306       ) .
     1307   if p-list-name = "gds-list" then do:
     1308     _gds-list:
     1309     for each gds-list
     1310       ON ERROR undo, NEXT:
     1311         num-rec = num-rec + 1.
     1312         v-ok = false.
     1313         run check-actg in this-procedure (
     1314                                           input gds-list.grp-code
     1315                                           ,input gds-list.gds-code
     1316                                           ,output v-ok ) no-error.
     1317         if v-ok = true then do :
     1318             run do-changes in this-procedure (
     1319                                       input gds-list.gds-code
     1320                                       ,input p-obj-type
     1321                                       ,input p-obj-code) no-error .
     1322         end.
     1323         if error-status:error then do:
     1324           run write-log-and-file in p-log-handle (
     1325                     input 1
     1326                   , input log-file-name
     1327                   , input 1
     1328                   , input return-value
     1329                                               ).
     1330           assign
     1331           v-view-log = yes.
     1332           if v-no-ask  then do:
     1333             run gbl/d-askw.w (
     1334                           input "Изменение скидок товара на объекте по списку товаров"
     1335                           ,input substitute("Товар с кодом &1 &2&3 - не удалось провести изменение скидок товара на объекте"
     1336                                           , gds-list.gds-code
     1337                                           , p-obj-type
     1338                                           , p-obj-code
     1339                                           )
     1340                           ,input "|"
     1341                           ,input ("Продолжить|" +
     1342                                 "Продолжить и больше не запрашивать подтверждения на продолжение|" +
     1343                                 "Прекратить")
     1344                           ,input "||"
     1345                           ,input 1
     1346                           ,input 3
     1347                           ,output v-choice).
     1348             if v-choice = 3 then do:
     1349               leave.
     1350             end.
     1351             if v-choice = 2 then do:
     1352               assign
     1353               v-no-ask = yes.
     1354             end.
     1355           end.
     1356         end.
     1357         else do:
     1358           num-rec-ok = num-rec-ok + 1.
     1359           if pardelete-ok then delete gds-list.
     1360         end.
     1361         run show-counter in p-log-handle .
     1362         run write-counter in p-log-handle (substitute("Обработано &1 из них успешно &2"
     1363                                                     , num-rec
     1364                                                     , num-rec-ok
     1365                                                     )) no-error.
     1366         run get-stop-state in p-log-handle (
     1367             output v-stop
     1368         ).
     1369         if v-stop then do:
     1370           leave _gds-list.
     1371         end.
     1372     END.
     1373   end.
     1374   if p-list-name = "bb-list" then do:
     1375     _bb-list:
     1376     for each bb-list no-lock
     1377     group by bb-list.b-code
     1378       ON ERROR undo, NEXT:
     1379         if not first-of(bb-list.b-code) then next _bb-list .
     1380         num-rec = num-rec + 1.
     1381         v-ok = false.
     1382         run check-actg in this-procedure (
     1383                                           input bb-list.grp-code
     1384                                           ,input bb-list.gds-code
     1385                                           ,output v-ok ) no-error.
     1386         if v-ok = true then do :
     1387               run do-changes-bb in this-procedure (
     1388                                             input bb-list.gds-code
     1389                                             ,input bb-list.b-code
     1390                                             ,input p-obj-type
     1391                                             ,input p-obj-code) no-error .
     1392         end.
     1393         if error-status:error then do:
     1394           run write-log-and-file in p-log-handle (
     1395                     input 1
     1396                   , input log-file-name
     1397                   , input 1
     1398                   , input return-value
     1399                                               ).
     1400           assign
     1401           v-view-log = yes.
     1402           if v-no-ask  then do:
     1403             run gbl/d-askw.w (
     1404                           input "Изменение скидок товара на объекте по списку бар-кодов"
     1405                           ,input substitute("Товар с кодом &1 бар-код &2 &3&4 - не удалось провести изменение скидок товара на объекте"
     1406                                           , bb-list.gds-code
     1407                                           , bb-list.b-code
     1408                                           , p-obj-type
     1409                                           , p-obj-code
     1410                                           )
     1411                           ,input "|"
     1412                           ,input ("Продолжить|" +
     1413                                 "Продолжить и больше не запрашивать подтверждения на продолжение|" +
     1414                                 "Прекратить")
     1415                           ,input "||"
     1416                           ,input 1
     1417                           ,input 3
     1418                           ,output v-choice).
     1419             if v-choice = 3 then do:
     1420               leave.
     1421             end.
     1422             if v-choice = 2 then do:
     1423               assign
     1424               v-no-ask = yes.
     1425             end.
     1426           end.
     1427         end.
     1428         else do:
     1429           num-rec-ok = num-rec-ok + 1.
     1430           if pardelete-ok then delete bb-list.
     1431         end.
     1432         run show-counter in p-log-handle .
     1433         run write-counter in p-log-handle (substitute("Обработано &1 из них успешно &2"
     1434                                                     , num-rec
     1435                                                     , num-rec-ok
     1436                                                     )) no-error.
     1437         run get-stop-state in p-log-handle (
     1438             output v-stop
     1439         ).
     1440         if v-stop then do:
     1441           leave _bb-list.
     1442         end.
     1443     END.
     1444   end.
     1445   run write-log-and-file in p-log-handle (
     1446         input 1
     1447       , input log-file-name
     1448       , input 1
     1449       , input substitute("Пакетное изменение скидок по списку завершено: из &1 элементов списка успешно изменено &2", num-rec, num-rec-ok )).
     1450   .
     1451   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1452   if v-view-log
     1453   and not g#news
     1454   and not g#auto
     1455   then do:
     1456     message
     1457     '!!!При изменении скидок товара на объекте по списку произошли ошибки!!!'  skip
     1458     "!!!Внимательно прочитайте Log-file!!"
     1459     view-as alert-box error .
     1460        define variable v-user-action18   as character no-undo .
     1461     define variable v-printed18       as logical   no-undo .
     1462     run gbl/prnfilen.w
     1463       (input  ('!!!При изменении скидок товара на объекте по списку произошли ошибки!!!')
     1464       ,input  0
     1465       ,input  (string("./":U) + 'dgr-lst.txt')
     1466       ,input  7
     1467       ,output v-user-action18
     1468       ,output v-printed18
     1469       ) .
     1470   end.
     1471   if v-view-log = true
     1472   and (g#news
     1473   or g#auto)
     1474   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     1475   then do:
     1476      run cb_set-view-log in p-parent-handle ( input yes).
     1477   end.
     1478   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     1479     OS-DELETE value(string("./":U) + 'dgr-lst.txt').
     1480   end.
     1481   procedure do-changes :
     1482   define input parameter pargds-code like ub.gds-obj.gds-code no-undo .
     1483   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1484   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1485   DEFINE VARIABLE loc#log as logical no-undo .
     1486   DEFINE VARIABLE var-deleted as logical no-undo .
     1487   define variable v-check as character no-undo .
     1488   define variable v-correct as logical no-undo .
     1489   define variable v-error-code as character no-undo .
     1490   define variable v-rule-num as integer no-undo .
     1491   define variable v-obj-type like ub.clients.obj-type no-undo .
     1492   define variable v-obj-code like ub.clients.obj-code no-undo .
     1493   define variable v-host-code  as integer   no-undo .
     1494   define buffer buf_dis-gds-rule for ub.dis-gds-rule.
     1495   define buffer buf_del-dis-gds-rule for ub.dis-gds-rule.
     1496   define buffer buf_dis-rule         for ub.dis-rule.
     1497   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1498   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1499     (input  p-obj-type
     1500     ,input  p-obj-code
     1501     ,output v-host-code
     1502     )  .
     1503       _main:
     1504     do
     1505     on error undo, return error
     1506     :
     1507       _temp-disc:
     1508       for each temp-disc no-lock
     1509           on error undo _main, return error:
     1510         find first buf_dis-rule no-lock where buf_dis-rule.rule-num = temp-disc.rule-num no-error.
     1511         if avail buf_dis-rule then do:
     1512             if buf_dis-rule.host-code = 0 then     assign v-obj-type = ''         v-obj-code = 0 .
     1513             else if buf_dis-rule.obj-code = 0 then assign v-obj-type = 'орг':U     v-obj-code = v-host-code .
     1514             else                                   assign v-obj-type = p-obj-type v-obj-code = p-obj-code .
     1515         end.
     1516         CASE temp-disc.action:
     1517           when yes then do:
     1518             if v-obj-type = p-obj-type then do:
     1519             run disgdsru-write in this-procedure (
     1520                                                    input p-obj-type
     1521                                                   ,input p-obj-code
     1522                                                   ,input pargds-code
     1523                                                   ,input temp-disc.pos-type
     1524                                                   ,input temp-disc.discnt-role
     1525                                                   ,input temp-disc.templ-rl-root
     1526                                                   ,input temp-disc.time-templ-rl-root
     1527                                                   ,input temp-disc.rule-num
     1528                                                   ,input temp-disc.nonunique
     1529                                                       )  no-error.
     1530             end.
     1531             else do:
     1532                 run cmp-disgdsru-write in this-procedure (
     1533                                                    input pargds-code
     1534                                                   ,input v-obj-type
     1535                                                   ,input v-obj-code
     1536                                                   ,input temp-disc.pos-type
     1537                                                   ,input temp-disc.templ-rl-root
     1538                                                   ,input temp-disc.time-templ-rl-root
     1539                                                   ,input temp-disc.discnt-role
     1540                                                   ,input temp-disc.rule-num
     1541                                                   ,input temp-disc.nonunique
     1542                                                       )  no-error.
     1543             end.
     1544             if error-status:error then do:
     1545               assign v-mes = substitute("товар с кодом &1, &2, POS &3, тип скидки &4: ошибка при записи скидки товара на объекте:&5&6&5&7"                      , gds-list.gds-code                    , (p-obj-type  + string(p-obj-code))                      , entry (lookup (temp-disc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)                    , entry (lookup (temp-disc.discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)                   , chr(10)                        , error-status:get-message(1)                    , return-value ).
     1546               undo _main, return error v-mes.
     1547             end.
     1548           end.
     1549           when no then do:
     1550             var-deleted = no.
     1551             for each buf_dis-gds-rule no-lock where
     1552                       ( buf_dis-gds-rule.obj-type = p-obj-type or buf_dis-gds-rule.obj-type = 'орг':U      or buf_dis-gds-rule.obj-type = '' )
     1553                   and ( buf_dis-gds-rule.obj-code = p-obj-code or buf_dis-gds-rule.obj-code = v-host-code or buf_dis-gds-rule.obj-code = 0 )
     1554                   and buf_dis-gds-rule.gds-code = pargds-code
     1555                   and buf_dis-gds-rule.pos-type = temp-disc.pos-type
     1556                   and buf_dis-gds-rule.discnt-role = temp-disc.discnt-role
     1557                   and ( if buf_dis-gds-rule.rule-num = temp-disc.rule-num then buf_dis-gds-rule.nonunique = temp-disc.nonunique else true )
     1558             and buf_dis-gds-rule.time-templ-rl-root = temp-disc.time-templ-rl-root
     1559             and buf_dis-gds-rule.templ-rl-root = temp-disc.templ-rl-root
     1560             and (temp-disc.rule-num = ? or temp-disc.rule-num = 0 or buf_dis-gds-rule.rule-num = temp-disc.rule-num )
     1561             :
     1562               assign
     1563               v-rule-num = buf_dis-gds-rule.rule-num
     1564               .
     1565               find first buf_del-dis-gds-rule exclusive-lock where
     1566                 recid(buf_del-dis-gds-rule) = recid(buf_dis-gds-rule)
     1567               no-wait no-error.
     1568               if not available buf_del-dis-gds-rule then do:
     1569                 undo _main, return error substitute( "Товар &1 &2 POS &3 шаблон правила &4, правило &5&6" +
     1570                                                      "занята запись скидки на объекте"
     1571                                                      , pargds-code
     1572                                                      , (p-obj-type  + string(p-obj-code))
     1573                                                      , entry (lookup (temp-disc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1574                                                      , temp-disc.templ-rl-root
     1575                                                      , v-rule-num
     1576                                                      , chr(10)
     1577                                                      ).
     1578               end.
     1579               delete buf_del-dis-gds-rule no-error.
     1580               if error-status:error then do:
     1581                 assign v-mes = substitute("товар с кодом &1, &2, POS &3, тип скидки &4: ошибка при удалении скидки товара на объекте:&5&6&5&7"                    , gds-list.gds-code                    , (p-obj-type  + string(p-obj-code))                      , entry (lookup (temp-disc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)                    , entry (lookup (temp-disc.discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)                   , chr(10)                        , error-status:get-message(1)                    , return-value ).
     1582                 undo _main, return error v-mes.
     1583               end.
     1584             end.
     1585           end.
     1586         END CASE.
     1587       end.
     1588     end.
     1589   end procedure.
     1590   procedure do-changes-bb :
     1591   define input parameter pargds-code like ub.gds-obj.gds-code no-undo .
     1592   define input parameter parb-code like ub.bar-code.b-code no-undo .
     1593   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     1594   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     1595   DEFINE VARIABLE loc#log as logical no-undo .
     1596   DEFINE VARIABLE var-deleted as logical no-undo .
     1597   define variable v-check as character no-undo .
     1598   define variable v-correct as logical no-undo .
     1599   define variable v-error-code as character no-undo .
     1600   define variable v-rule-num as integer no-undo .
     1601   define variable v-number-action as character no-undo .
     1602   define variable v-bar-code as character no-undo .
     1603   define variable v-obj-type like ub.clients.obj-type no-undo .
     1604   define variable v-obj-code like ub.clients.obj-code no-undo .
     1605   define variable v-host-code  as integer             no-undo .
     1606   define buffer buf_dis-rule          for ub.dis-rule.
     1607   define buffer buf_dis-gds-rule for ub.dis-gds-rule.
     1608   define buffer buf_del-dis-gds-rule  for ub.dis-gds-rule.
     1609   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1610   define buffer buf_dis-gds-rule-attr for ub.dis-gds-rule-attr.
     1611   define buffer buf_bb-list           for bb-list.
     1612   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1613   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1614     (input  p-obj-type
     1615     ,input  p-obj-code
     1616     ,output v-host-code
     1617     )  .
     1618       _main:
     1619     do
     1620     on error undo, return error
     1621     :
     1622       _temp-disc:
     1623       for each temp-disc no-lock
     1624           on error undo _main, return error:
     1625         find first buf_dis-rule no-lock where buf_dis-rule.rule-num = temp-disc.rule-num no-error.
     1626         if avail buf_dis-rule then do:
     1627             if buf_dis-rule.host-code = 0 then     assign v-obj-type = ''         v-obj-code = 0 .
     1628             else if buf_dis-rule.obj-code = 0 then assign v-obj-type = 'орг':U     v-obj-code = v-host-code .
     1629             else                                   assign v-obj-type = p-obj-type v-obj-code = p-obj-code .
     1630         end.
     1631         CASE temp-disc.action:
     1632           when yes then do:
     1633             if v-obj-type = p-obj-type then do:
     1634             run disgdsru-write in this-procedure (
     1635                                                    input p-obj-type
     1636                                                   ,input p-obj-code
     1637                                                   ,input pargds-code
     1638                                                   ,input temp-disc.pos-type
     1639                                                   ,input temp-disc.discnt-role
     1640                                                   ,input temp-disc.templ-rl-root
     1641                                                   ,input temp-disc.time-templ-rl-root
     1642                                                   ,input temp-disc.rule-num
     1643                                                   ,input string(parb-code)
     1644                                                       )  no-error.
     1645             end.
     1646             else do:
     1647                 run cmp-disgdsru-write in this-procedure (
     1648                                                    input pargds-code
     1649                                                   ,input v-obj-type
     1650                                                   ,input v-obj-code
     1651                                                   ,input temp-disc.pos-type
     1652                                                   ,input temp-disc.templ-rl-root
     1653                                                   ,input temp-disc.time-templ-rl-root
     1654                                                   ,input temp-disc.discnt-role
     1655                                                   ,input temp-disc.rule-num
     1656                                                   ,input string(parb-code)
     1657                                                       )  no-error.
     1658             end.
     1659             if error-status:error then do:
     1660               assign v-mes = substitute("товар с кодом &1, &2, POS &3, тип скидки &4: ошибка при записи скидки товара на объекте:&5&6&5&7"                      , bb-list.gds-code                    , (p-obj-type  + string(p-obj-code))                      , entry (lookup (temp-disc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)                    , entry (lookup (temp-disc.discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)                   , chr(10)                        , error-status:get-message(1)                    , return-value ).
     1661               undo _main, return error v-mes.
     1662             end.
     1663             find first buf_dis-gds-rule no-lock where
     1664                   ( buf_dis-gds-rule.obj-type = v-obj-type )
     1665               and ( buf_dis-gds-rule.obj-code = v-obj-code )
     1666               and buf_dis-gds-rule.gds-code           = pargds-code
     1667               and buf_dis-gds-rule.pos-type           = temp-disc.pos-type
     1668               and buf_dis-gds-rule.discnt-role        = temp-disc.discnt-role
     1669               and buf_dis-gds-rule.templ-rl-root      = temp-disc.templ-rl-root
     1670               and buf_dis-gds-rule.time-templ-rl-root = temp-disc.time-templ-rl-root
     1671               and buf_dis-gds-rule.rule-num           = temp-disc.rule-num
     1672               and buf_dis-gds-rule.nonunique          = string(parb-code)
     1673             no-error .
     1674             if avail buf_dis-gds-rule then do:
     1675                  find first buf_dis-cfg-rule no-lock
     1676                  where buf_dis-cfg-rule.table-name    = 'dis-gds-rule':U
     1677                    and buf_dis-cfg-rule.templ-rl-root = temp-disc.templ-rl-root
     1678                    and buf_dis-cfg-rule.pos-type      = temp-disc.pos-type
     1679                    and buf_dis-cfg-rule.time-templ-rl-root = temp-disc.time-templ-rl-root
     1680                  no-error .
     1681                  if avail buf_dis-cfg-rule and
     1682                     buf_dis-cfg-rule.discnt-role = 'bonus-qnty' and
     1683                     buf_dis-cfg-rule.nonunique   = 'bar-code.b-code'
     1684                  then do:
     1685                    for each buf_bb-list no-lock where buf_bb-list.b-code = parb-code :
     1686                      if buf_bb-list.b-str = '' then v-bar-code = string(buf_bb-list.b-code) .
     1687                      else v-bar-code = buf_bb-list.b-str .
     1688                      find first buf_dis-gds-rule-attr exclusive-lock
     1689                      where buf_dis-gds-rule-attr.gds-code    = buf_dis-gds-rule.gds-code
     1690                        and buf_dis-gds-rule-attr.obj-type    = buf_dis-gds-rule.obj-type
     1691                        and buf_dis-gds-rule-attr.obj-code    = buf_dis-gds-rule.obj-code
     1692                        and buf_dis-gds-rule-attr.pos-type    = buf_dis-gds-rule.pos-type
     1693                        and buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
     1694                        and buf_dis-gds-rule-attr.nonunique   = buf_dis-gds-rule.nonunique
     1695                        and entry(1,buf_dis-gds-rule-attr.attr-value,",") = v-bar-code
     1696                      no-error.
     1697                      if not avail buf_dis-gds-rule-attr then do:
     1698                         create buf_dis-gds-rule-attr .
     1699                      end.
     1700                         run def-number-action(temp-disc.templ-rl-root, output v-number-action) .
     1701                         assign
     1702                          buf_dis-gds-rule-attr.gds-code    = buf_dis-gds-rule.gds-code
     1703                          buf_dis-gds-rule-attr.obj-type    = buf_dis-gds-rule.obj-type
     1704                          buf_dis-gds-rule-attr.obj-code    = buf_dis-gds-rule.obj-code
     1705                          buf_dis-gds-rule-attr.pos-type    = buf_dis-gds-rule.pos-type
     1706                          buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
     1707                          buf_dis-gds-rule-attr.nonunique   = buf_dis-gds-rule.nonunique
     1708                          buf_dis-gds-rule-attr.attr-code   = v-number-action
     1709                          buf_dis-gds-rule-attr.attr-value  = v-bar-code + ",A"
     1710                         .
     1711                    end.
     1712                  end.
     1713             end.
     1714           end.
     1715           when no then do:
     1716             var-deleted = no.
     1717             for each buf_dis-gds-rule no-lock where
     1718                       ( buf_dis-gds-rule.obj-type = p-obj-type or buf_dis-gds-rule.obj-type = 'орг':U      or buf_dis-gds-rule.obj-type = '' )
     1719                   and ( buf_dis-gds-rule.obj-code = p-obj-code or buf_dis-gds-rule.obj-code = v-host-code or buf_dis-gds-rule.obj-code = 0 )
     1720                   and buf_dis-gds-rule.gds-code = pargds-code
     1721                   and buf_dis-gds-rule.pos-type = temp-disc.pos-type
     1722                   and buf_dis-gds-rule.discnt-role = temp-disc.discnt-role
     1723                   and buf_dis-gds-rule.nonunique = string(parb-code)
     1724             and buf_dis-gds-rule.time-templ-rl-root = temp-disc.time-templ-rl-root
     1725             and buf_dis-gds-rule.templ-rl-root = temp-disc.templ-rl-root
     1726             and (temp-disc.rule-num = ? or temp-disc.rule-num = 0 or buf_dis-gds-rule.rule-num = temp-disc.rule-num)
     1727             :
     1728               assign
     1729               v-rule-num = buf_dis-gds-rule.rule-num
     1730               .
     1731               find first buf_del-dis-gds-rule exclusive-lock where
     1732                 recid(buf_del-dis-gds-rule) = recid(buf_dis-gds-rule)
     1733               no-wait no-error.
     1734               if not available buf_del-dis-gds-rule then do:
     1735                 undo _main, return error substitute( "Товар &1 бар-код &2 &3 POS &4 шаблон правила &5, правило &6&7" +
     1736                                                      "занята запись скидки на объекте"
     1737                                                      , pargds-code
     1738                                                      , parb-code
     1739                                                      , (p-obj-type  + string(p-obj-code))
     1740                                                      , entry (lookup (temp-disc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1741                                                      , temp-disc.templ-rl-root
     1742                                                      , v-rule-num
     1743                                                      , chr(10)
     1744                                                      ).
     1745               end.
     1746               for each buf_dis-gds-rule-attr exclusive-lock
     1747               where buf_dis-gds-rule-attr.gds-code    = buf_dis-gds-rule.gds-code
     1748                 and buf_dis-gds-rule-attr.obj-type    = buf_dis-gds-rule.obj-type
     1749                 and buf_dis-gds-rule-attr.obj-code    = buf_dis-gds-rule.obj-code
     1750                 and buf_dis-gds-rule-attr.pos-type    = buf_dis-gds-rule.pos-type
     1751                 and buf_dis-gds-rule-attr.discnt-role = buf_dis-gds-rule.discnt-role
     1752                 and buf_dis-gds-rule-attr.nonunique   = buf_dis-gds-rule.nonunique
     1753               :
     1754                   delete buf_dis-gds-rule-attr no-error .
     1755                   if error-status:error then do:
     1756                       assign v-mes = substitute("товар с кодом &1, &2, POS &3, тип скидки &4: ошибка при удалении атрибутов скидки товара на объекте:&5&6&5&7"                    , bb-list.gds-code                    , (p-obj-type  + string(p-obj-code))                      , entry (lookup (temp-disc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)                    , entry (lookup (temp-disc.discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)                   , chr(10)                        , error-status:get-message(1)                    , return-value ).
     1757                       undo _main, return error v-mes.
     1758                   end.
     1759               end.
     1760               delete buf_del-dis-gds-rule no-error.
     1761               if error-status:error then do:
     1762                 assign v-mes = substitute("товар с кодом &1, &2, POS &3, тип скидки &4: ошибка при удалении скидки товара на объекте:&5&6&5&7"                    , bb-list.gds-code                    , (p-obj-type  + string(p-obj-code))                      , entry (lookup (temp-disc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)                    , entry (lookup (temp-disc.discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)                   , chr(10)                        , error-status:get-message(1)                    , return-value ).
     1763                 undo _main, return error v-mes.
     1764               end.
     1765             end.
     1766           end.
     1767         END CASE.
     1768       end.
     1769     end.
     1770   end procedure.
     1771   procedure check-actg :
     1772   define input parameter p-grp-code as integer no-undo.
     1773   define input parameter p-gds-code as integer no-undo.
     1774   define output parameter p-ok as logical no-undo.
     1775   do
     1776   on error undo, return error
     1777   :
     1778         if v-cntxt-db-num = 0 then do:
     1779   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1780   do:
     1781     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1782       (input  v-cntxt-db-num
     1783       ,input  v-cntxt-userid
     1784       ,input  0
     1785       ,input  'actn_gds-discount_global_work':U
     1786       ,input  'global':U
     1787       ,input  0
     1788       ,input  '':U
     1789       ,input  0
     1790       ,input  0
     1791       ,input  p-grp-code
     1792       ,input  0
     1793       ,input  false
     1794       ,output loc-glob
     1795       )  .
     1796   end.
     1797   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1798   do:
     1799     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1800       (input  v-cntxt-db-num
     1801       ,input  v-cntxt-userid
     1802       ,input  0
     1803       ,input  'actn_gds-discount_firm_work':U
     1804       ,input  'firm':U
     1805       ,input  v-cntxt-host-code-obj
     1806       ,input  '':U
     1807       ,input  0
     1808       ,input  0
     1809       ,input  p-grp-code
     1810       ,input  0
     1811       ,input  false
     1812       ,output loc-firm
     1813       )  .
     1814   end.
     1815         end.
     1816   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1817   do:
     1818     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1819       (input  v-cntxt-db-num
     1820       ,input  v-cntxt-userid
     1821       ,input  0
     1822       ,input  'actn_gds-discount_object_work':U
     1823       ,input  'object':U
     1824       ,input  v-cntxt-host-code-obj
     1825       ,input  v-cntxt-obj-type
     1826       ,input  v-cntxt-obj-code
     1827       ,input  0
     1828       ,input  p-grp-code
     1829       ,input  0
     1830       ,input  false
     1831       ,output loc-object
     1832       )  .
     1833   end.
     1834         if ((if v-cntxt-db-num = 0 and loc-glob then 1 else 0) +
     1835         (if v-cntxt-db-num = 0 and loc-firm then 1 else 0) +
     1836         (if loc-object then 1 else 0)) <> 0 then do:
     1837           p-ok = true.
     1838         end.
     1839         else do :
     1840           find first gds-grp no-lock
     1841                where gds-grp.node-code = p-grp-code no-error.
     1842           v-mes = substitute("товар с кодом &1, &2,группа товаров &3 : У Вас отсутствуют права на назначение скидки на товар как по объекту,"
     1843                             + "так и глобально либо Вы находитесь в БД, в которой их назначить невозможно"
     1844                             , p-gds-code
     1845                             , (p-obj-type  + string(p-obj-code))
     1846                             , (string(gds-grp.node-code) + " " + gds-grp.node-name)
     1847                             ).
     1848            undo,return error v-mes.
     1849         end.
     1850   end.
     1851   end procedure.
