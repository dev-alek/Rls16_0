        1   DEFINE BUFFER buf_cash-desk FOR ub.cash-desk.
        2   DEFINE BUFFER buf_obj FOR ub.clients.
        3   DEFINE BUFFER buf_sysconf FOR ub.sysconf.
        4   DEFINE BUFFER locked_wth-place FOR ub.wth-place.
        5   DEFINE TEMP-TABLE tt-wth-place NO-UNDO LIKE ub.wth-place.
        6   define input parameter parparentproc as widget-handle no-undo .
        7   define input parameter par-mode as character no-undo.
        8   define input parameter parhost-code like ub.clients.obj-code no-undo.
        9   define input parameter parobj-type like ub.clients.obj-type no-undo.
       10   define input parameter parobj-code like ub.clients.obj-code no-undo.
       11   define input-output parameter par-ri as recid no-undo.
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Карточка места хранения МЦ ".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   procedure proc-alt-shift-f2:
       77     if not ibs.th.gbl.gbl-var:rcode
       78   then
       79     run gbl\inidebug.p .
       80   end.
       81   procedure proc-alt-shift-f3:
       82     run gbl/prvssinf.p
       83       ( input this-procedure
       84       ) .
       85   end.
       86   define variable v-inform-launched as logical no-undo initial false .
       87   procedure proc-alt-shift-f4:
       88     define variable v-action as character no-undo .
       89     if v-inform-launched = false then do:
       90       assign
       91         v-inform-launched = true
       92       .
       93       run gbl/d-inform.w
       94         (  input self
       95         ,  input this-procedure
       96         , output v-action
       97         ) no-error .
       98       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       99       assign
      100         v-inform-launched = false
      101       .
      102     end.
      103   end.
      104   procedure proc-alt-f1:
      105     run gbl/corrhelp.p
      106       (input this-procedure
      107       ) .
      108   end .
      109   on alt-shift-f2 anywhere do:
      110     run proc-alt-shift-f2.
      111   end.
      112   on alt-shift-f3 anywhere do:
      113     run proc-alt-shift-f3 in this-procedure .
      114   end.
      115   on alt-shift-f4 anywhere do:
      116     run proc-alt-shift-f4 in this-procedure.
      117   end.
      118   on alt-f1 anywhere do:
      119     run proc-alt-f1 in this-procedure .
      120   end.
      121   DEFINE VARIABLE vardb-num like ub.clients.db-num.
      122   DEFINE BUTTON b-cash-desk
      123        IMAGE-UP FILE "btn-down-arrow":U
      124        IMAGE-DOWN FILE "btn-down-arrow":U
      125        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      126        LABEL "":L
      127        SIZE 3 BY 1
      128        BGCOLOR 8 FGCOLOR 0 .
      129   DEFINE BUTTON B-exit AUTO-GO
      130        LABEL "&Ввод"
      131        SIZE 10 BY 1
      132        BGCOLOR 8 .
      133   DEFINE BUTTON B-Help
      134        LABEL "Помо&щь"
      135        SIZE 10 BY 1
      136        BGCOLOR 8 .
      137   DEFINE BUTTON B-hist
      138        LABEL "Ис&тория"
      139        SIZE 10 BY 1.
      140   DEFINE BUTTON b-quit AUTO-END-KEY
      141        LABEL "&Отмена"
      142        SIZE 10 BY 1
      143        BGCOLOR 8 .
      144   DEFINE VARIABLE for-obj-name AS CHARACTER FORMAT "X(256)":U
      145         VIEW-AS TEXT
      146        SIZE 36.25 BY .67
      147        FGCOLOR 4  NO-UNDO.
      148   DEFINE QUERY Dialog-Frame FOR
      149         tt-wth-place SCROLLING.
      150   DEFINE FRAME Dialog-Frame
      151        B-exit AT ROW 1 COL 1
      152        b-quit AT ROW 1 COL 11
      153        B-hist AT ROW 1 COL 41
      154        B-Help AT ROW 1 COL 61
      155        tt-wth-place.obj-code AT ROW 3.67 COL 20.75 COLON-ALIGNED NO-LABEL
      156             VIEW-AS FILL-IN
      157             SIZE 10 BY 1
      158        tt-wth-place.obj-type AT ROW 3.71 COL 13.75 NO-LABEL
      159             VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
      160             SIZE 7.88 BY 1
      161        tt-wth-place.w-p-code AT ROW 5.04 COL 20.88 COLON-ALIGNED
      162             LABEL "Код места хранения"
      163             VIEW-AS FILL-IN
      164             SIZE 13 BY 1
      165             FGCOLOR 4
      166        tt-wth-place.w-p-name AT ROW 6.42 COL 20.88 COLON-ALIGNED
      167             LABEL "Название" FORMAT "X(100)"
      168             VIEW-AS FILL-IN
      169             SIZE 37.75 BY 1
      170        b-cash-desk AT ROW 7.67 COL 30.75
      171        tt-wth-place.cash-desk AT ROW 7.75 COL 20.88 COLON-ALIGNED
      172             LABEL "Номер кассы" FORMAT ">>>9"
      173             VIEW-AS FILL-IN
      174             SIZE 6.75 BY 1
      175        tt-wth-place.main-cash-desk AT ROW 9.08 COL 22.75
      176             LABEL "Главная касса"
      177             VIEW-AS TOGGLE-BOX
      178             SIZE 26.75 BY 1
      179        tt-wth-place.PS AT ROW 11.25 COL 1.63 NO-LABEL
      180             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      181             SIZE 75.13 BY 2.75
      182        tt-wth-place.host-code AT ROW 2.46 COL 12.25 COLON-ALIGNED
      183             LABEL "Фирма"
      184              VIEW-AS TEXT
      185             SIZE 10 BY .67
      186        for-obj-name AT ROW 3.83 COL 37.63 COLON-ALIGNED NO-LABEL
      187        "Примечание" VIEW-AS TEXT
      188             SIZE 12.63 BY .75 AT ROW 10.13 COL 1.5
      189        SPACE(63.86) SKIP(3.36)
      190       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      191            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      192            TITLE "Место хранения МЦ"
      193            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      194   ASSIGN
      195          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      196          FRAME Dialog-Frame:HIDDEN           = TRUE.
      197   ASSIGN
      198          tt-wth-place.PS:RETURN-INSERTED IN FRAME Dialog-Frame  = TRUE.
      199   ON GO OF FRAME Dialog-Frame
      200   DO:
      201    run proc-save-record in this-procedure No-ERROR.
      202     if error-status:error then return no-apply.
      203   END.
      204   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      205   DO:
      206     APPLY "END-ERROR":U TO SELF.
      207   END.
      208   ON CHOOSE OF b-cash-desk IN FRAME Dialog-Frame
      209   DO:
      210    define variable rid-list as character no-undo .
      211     run ref/cashlist.w (
      212                    input parparentproc
      213                   ,input "b-sel":U
      214                   ,input 'объект':U
      215                   ,input vardb-num
      216                   ,input parhost-code
      217                   ,input parobj-type
      218                   ,input parobj-code
      219                   ,input ?
      220                   ,output rid-list).
      221     if rid-list <> "":U then do:
      222         FIND FIRST buf_cash-desk WHERE
      223                     recid(buf_cash-desk) = integer(entry(1, rid-list)) NO-LOCK .
      224         if buf_cash-desk.obj-code <> parobj-code then do:
      225           message "Выбранная касса принадлежит другому магазину"
      226           view-as alert-box.
      227           return no-apply.
      228         end.
      229         if buf_cash-desk.db-num <> vardb-num then do:
      230             message "Выбранная касса принадлежит другой БД"
      231             view-as alert-box.
      232             return no-apply.
      233         end.
      234         DISPLAY
      235         buf_cash-desk.cash-num @ tt-wth-place.cash-desk
      236         with frame Dialog-Frame .
      237     end.
      238   END.
      239   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      240   DO:
      241     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      242     run ref/wthc-pls.w (
      243                       INPUT parParentProc
      244                      ,input '':U
      245                      ,input 'one':U
      246                      ,input parobj-type
      247                      ,input parobj-code
      248                      ,INPUT tt-wth-place.w-p-code
      249                      ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      250   END.
      251   ON LEAVE OF tt-wth-place.cash-desk IN FRAME Dialog-Frame
      252   DO:
      253     if INPUT FRAME Dialog-Frame tt-WTH-PLACE.cash-desk = 0 then return.
      254     FIND FIRST buf_CASH-DESK NO-LOCK WHERE
      255                buf_CASH-DESK.CASH-NUM = INPUT FRAME Dialog-Frame tt-WTH-PLACE.cash-desk AND
      256                buf_cash-desk.obj-code = tt-wth-place.obj-code AND
      257                buf_cash-desk.db-num = vardb-num NO-ERROR.
      258     if not avail buf_cash-desk then do:
      259       message
      260       "Нет кассы с N" INPUT FRAME Dialog-Frame tt-WTH-PLACE.cash-desk
      261       view-as alert-box ERROR.
      262     end.
      263     else if buf_cash-desk.obj-code <> tt-wth-place.obj-code then do:
      264       message
      265       "Выбранная касса принадлежит другому магазину"
      266       view-as alert-box ERROR.
      267     end.
      268   END.
      269   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      270   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      271   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      272   on help of frame Dialog-Frame
      273   do:
      274     run gbl/app_help.p
      275       (input this-procedure :file-name
      276       ,input ''
      277       ,input ?
      278       ) no-error.
      279     if error-status :error then do:
      280       message
      281         "Ошибка при вызове помощи"
      282         error-status :get-message(1)
      283         view-as alert-box .
      284     end.
      285   end.
      286   run minbtn-set in this-procedure .
      287   on choose of b-help in frame Dialog-Frame
      288   do:
      289     apply "help":u to frame Dialog-Frame .
      290   end.
      291   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      292   procedure minbtn-set :
      293       do
      294           on error undo, return error return-value
      295           :
      296           define variable ii              as integer       no-undo .
      297           define variable fh              as widget-handle no-undo .
      298           define variable hh              as widget-handle no-undo .
      299           define variable v-h             as handle        extent 4 no-undo .
      300           define variable v-name-button   as character     no-undo .
      301           define variable v-help-old-x    as decimal       no-undo .
      302           define variable v-help-old-y    as decimal       no-undo .
      303           define variable v-help-old-size as decimal       no-undo .
      304           define variable v-frame-width   as decimal       no-undo .
      305           define variable jj              as integer       no-undo .
      306           do
      307               on error undo, return error
      308               :
      309               assign
      310                   v-frame-width = frame Dialog-Frame:width - 0.3
      311                   fh            = frame Dialog-Frame:first-child
      312                   hh            = fh:first-child
      313                   ii            = 1
      314                   .
      315               do while valid-handle(hh):
      316                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      317                   do:
      318                       case lc(hh:name) :
      319                           when "b-help" then
      320                               do:
      321                                   hh:load-image-up("cmp/b-help.bmp":u) .
      322                                   hh:load-image-down("cmp/b-help.bmp":u) .
      323                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      324                                   hh:TOOLTIP = "Помощь" .
      325                                   v-help-old-x = hh:column .
      326                                   v-help-old-y = hh:row    .
      327                                   v-help-old-size = hh:width .
      328                                   hh:width-chars = 2.5 .
      329                               end.
      330                           when "b-print" then
      331                               do:
      332                                   hh:load-image("cmp/b-print.bmp":u) .
      333                                   hh:TOOLTIP = "Печать" .
      334                                   v-h[ii] = hh:handle .
      335                                   ii = ii + 1 .
      336                                   hh:width-chars = 3 .
      337                               end.
      338                           when "b-history" or
      339                           when "b-hist" then
      340                               do:
      341                                   hh:load-image("cmp/b-hist.bmp":u) .
      342                                   hh:TOOLTIP = "История" .
      343                                   v-h[ii] = hh:handle .
      344                                   ii = ii + 1 .
      345                                   hh:width-chars = 3 .
      346                               end.
      347                           when "b-sch" then
      348                               do:
      349                                   hh:load-image("cmp/b-sch.bmp":u) .
      350                                   hh:TOOLTIP = "Установка Фильтра" .
      351                                   v-h[ii] = hh:handle .
      352                                   ii = ii + 1 .
      353                                   hh:width-chars = 3 .
      354                               end.
      355                           when "b-hist-user" then
      356                               do:
      357                                   hh:load-image("cmp/b-hist.bmp":u) .
      358                                   hh:TOOLTIP = "История пользователя" .
      359                                   ii = ii + 1 .
      360                               end.
      361                       end case.
      362                   end.
      363                   hh = hh:next-sibling.
      364               end.
      365               b-help:column = v-frame-width - b-help:width-chars.
      366               jj = 0.
      367               repeat ii = 4 to 1 by -1 :
      368                   if valid-handle (v-h[ii] ) then
      369                   do:
      370                       jj  = jj + 1 .
      371                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      372                       v-h[ii]:row    = v-help-old-y .
      373                   end.
      374               end.
      375           end.
      376       end.
      377   end procedure.
      378   MAIN-BLOCK:
      379   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      380      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      381       if par-mode <> 'ИЗМЕНЕНИЕ':U and par-mode <> 'ДОБАВЛЕНИЕ':U and par-mode <> 'ПРОСМОТР':U then do:
      382           message vss-workfile vss-revision vss-description skip
      383                       "Неверный параметр вызова par-mode"
      384           view-as alert-box ERROR.
      385           return error.
      386       end.
      387       find first ub.sysconf No-LOCK WHERE
      388                        ub.sysconf.host-code = parhost-code No-ERROR.
      389       if not avail ub.sysconf then do:
      390           message vss-workfile vss-revision vss-description skip
      391                           "Неверный параметр вызова parhost-code"
      392               view-as alert-box ERROR.
      393               return error.
      394       end.
      395       find first ub.clients No-LOCK WHERE
      396                   ub.clients.obj-type = parobj-type AND
      397                   ub.clients.obj-code = parobj-code No-ERROR.
      398       if not avail ub.clients then do:
      399           message vss-workfile vss-revision vss-description skip
      400                           "Неверный параметр вызова parobj-type/parobj-code"
      401               view-as alert-box ERROR.
      402               return error.
      403       end.
      404       vardb-num = ub.clients.db-num.
      405       find first ub.sys-ctrl No-LOCK.
      406       if vardb-num <> ub.sys-ctrl.db-num then do:
      407         if par-mode <> 'ПРОСМОТР':U then do:
      408           message
      409           vss-workfile vss-revision vss-description skip
      410           "Неверный параметр вызова par-mode" par-mode
      411           "для объекта, принадлежащего другой БД"
      412           view-as alert-box error .
      413           return error .
      414         end.
      415       end.
      416       tt-wth-place.obj-type:list-items =
      417                                       'маг':U + chr(44) +
      418                                       'скл':U + chr(44).
      419     Run fill-tables in this-procedure no-error.
      420     if error-status:error then return error.
      421     RUN MYenable.
      422     WAIT-FOR GO OF FRAME Dialog-Frame FOCUS tt-wth-place.w-p-name.
      423   END.
      424   RUN disable_UI.
      425   PROCEDURE disable_UI :
      426     HIDE FRAME Dialog-Frame.
      427   END PROCEDURE.
      428   PROCEDURE enable_UI :
      429     OPEN QUERY Dialog-Frame FOR EACH tt-wth-place SHARE-LOCK.
      430     GET FIRST Dialog-Frame.
      431     DISPLAY for-obj-name
      432         WITH FRAME Dialog-Frame.
      433     IF AVAILABLE tt-wth-place THEN
      434       DISPLAY tt-wth-place.obj-code tt-wth-place.obj-type tt-wth-place.w-p-code
      435             tt-wth-place.w-p-name tt-wth-place.cash-desk
      436             tt-wth-place.main-cash-desk tt-wth-place.PS tt-wth-place.host-code
      437         WITH FRAME Dialog-Frame.
      438     ENABLE B-exit b-quit B-hist B-Help tt-wth-place.obj-code
      439            tt-wth-place.obj-type tt-wth-place.w-p-code tt-wth-place.w-p-name
      440            b-cash-desk tt-wth-place.cash-desk tt-wth-place.main-cash-desk
      441            tt-wth-place.PS tt-wth-place.host-code for-obj-name
      442         WITH FRAME Dialog-Frame.
      443     VIEW FRAME Dialog-Frame.
      444   END PROCEDURE.
      445   PROCEDURE fill-tables :
      446   for each tt-wth-place:
      447       delete tt-wth-place.
      448   end.
      449   IF par-mode = 'ДОБАВЛЕНИЕ':U then do:
      450       DO TRANSACTION ON ERROR UNDO, RETURN ERROR return-value :
      451         create tt-wth-place.
      452         assign
      453         tt-wth-place.host-code = parhost-code
      454         tt-wth-place.obj-type = parobj-type
      455         tt-wth-place.obj-code = parobj-code
      456         tt-wth-place.status_ = 'тек':U
      457         .
      458       END.
      459       FIND FIRST buf_obj No-LOCK WHERe
      460                   buf_obj.obj-type = parobj-type AND
      461                   buf_obj.obj-code = parobj-code No-ERROR.
      462   end.
      463   else do:
      464     if par-mode = 'ПРОСМОТР':U then do:
      465       FIND FIRST locked_wth-place NO-LOCK WHERE
      466                   recid(locked_wth-place) = par-ri.
      467     end.
      468     ELSE do:
      469       DO TRANSACTION
      470         ON ERROR UNDO, RETURN ERROR:
      471              FIND FIRST locked_wth-place NO-LOCK WHERE
      472                   recid(locked_wth-place) = par-ri.
      473       END.
      474     END.
      475     if
      476     locked_wth-place.host-code <> parhost-code or
      477     locked_wth-place.obj-type<> parobj-type or
      478     locked_wth-place.obj-code <> parobj-code then do:
      479       message vss-workfile vss-revision vss-description skip
      480                           "Неверный параметр вызова parhost-code и/или"
      481                           "parobj-type/parobj-code"
      482               view-as alert-box ERROR.
      483               return error.
      484   end.
      485     IF NOT AVAIL locked_wth-place then
      486     return error.
      487     create tt-wth-place.
      488     buffer-copy locked_wth-place to tt-wth-place.
      489       FIND FIRST buf_obj No-LOCK WHERe
      490                   buf_obj.obj-type = tt-wth-place.obj-type AND
      491                   buf_obj.obj-code = tt-wth-place.obj-code No-ERROR.
      492       if not avail buf_obj then do:
      493         message "Место хранения" locked_wth-place.w-p-code  skip
      494                 "Неверный объект" locked_wth-place.obj-type locked_wth-place.obj-code
      495         view-as alert-box ERROR.
      496         return error.
      497       end.
      498       if tt-wth-place.obj-type = 'скл':U then do:
      499           if tt-wth-place.cash-desk <>  0 then do:
      500           FIND FIRST buf_cash-desk No-LOCK WHERE
      501                   buf_cash-desk.db-num = vardb-num AND
      502                   buf_cash-desk.obj-code = tt-wth-place.obj-code AND
      503                   buf_cash-desk.cash-num = tt-wth-place.cash-desk No-ERROR.
      504               if not avail buf_cash-desk then do:
      505                 message "Место хранения" locked_wth-place.w-p-code  skip
      506                         "Неверный номер кассы" locked_wth-place.cash-desk
      507                 view-as alert-box ERROR.
      508                 return error.
      509               end.
      510       end.
      511       end.
      512   end.
      513   END PROCEDURE.
      514   PROCEDURE MyEnable :
      515     DISPLAY for-obj-name
      516         WITH FRAME Dialog-Frame.
      517     IF AVAILABLE tt-wth-place THEN
      518       DISPLAY
      519       tt-wth-place.obj-type
      520       tt-wth-place.obj-code
      521       tt-wth-place.w-p-code
      522       tt-wth-place.w-p-name
      523       tt-wth-place.cash-desk
      524       tt-wth-place.main-cash-desk
      525       tt-wth-place.PS
      526       tt-wth-place.host-code
      527       WITH FRAME Dialog-Frame.
      528       if available buf_obj then
      529       display
      530       buf_obj.obj-name @ for-obj-name
      531       WITH FRAME Dialog-Frame.
      532       CASE par-mode:
      533           when 'ДОБАВЛЕНИЕ':U then do:
      534               ENABLE
      535               B-exit
      536               b-quit
      537               B-Help
      538               tt-wth-place.w-p-name
      539               b-cash-desk when tt-wth-place.obj-type = 'маг':U
      540               tt-wth-place.cash-desk when tt-wth-place.obj-type = 'маг':U
      541               tt-wth-place.main-cash-desk  when tt-wth-place.obj-type = 'маг':U
      542               tt-wth-place.PS
      543               WITH FRAME Dialog-Frame.
      544           end.
      545           when 'ИЗМЕНЕНИЕ':U then do:
      546                       ENABLE
      547                       B-exit
      548                       b-quit
      549                       B-Help
      550                       tt-wth-place.w-p-name
      551                       b-cash-desk when tt-wth-place.obj-type = 'маг':U
      552                       tt-wth-place.cash-desk when tt-wth-place.obj-type = 'маг':U
      553                       tt-wth-place.main-cash-desk  when tt-wth-place.obj-type = 'маг':U
      554                       tt-wth-place.PS
      555                       WITH FRAME Dialog-Frame.
      556           end.
      557           when 'ПРОСМОТР':U then do:
      558               b-quit:label = "&Выход".
      559                           HIDE
      560                           b-exit
      561                           in frame Dialog-Frame.
      562           end.
      563       END CASE.
      564     ENABLE
      565     b-quit
      566     B-Help
      567     b-hist WHEN par-mode <> 'ДОБАВЛЕНИЕ':U
      568     WITH FRAME Dialog-Frame.
      569     VIEW FRAME Dialog-Frame.
      570   END PROCEDURE.
      571   PROCEDURE proc-save-record :
      572    IF par-mode = 'ПРОСМОТР':U THEN DO:
      573       RETURN error.
      574    END.
      575    assign
      576   tt-wth-place.w-p-code frame Dialog-Frame
      577   tt-wth-place.host-code
      578   tt-wth-place.obj-type
      579   tt-wth-place.obj-code
      580   tt-wth-place.w-p-name
      581   tt-wth-place.cash-desk
      582   tt-wth-place.main-cash-desk
      583   tt-wth-place.PS
      584    .
      585    if par-mode <> 'ДОБАВЛЕНИЕ':U then
      586    par-ri = recid(locked_wth-place).
      587    else par-ri = ?.
      588    run ref/wthplfr1.p (
      589                     input-output par-ri
      590                    ,input        par-mode
      591                    ,input tt-wth-place.w-p-code
      592                    ,input tt-wth-place.host-code
      593                    ,input tt-wth-place.obj-type
      594                    ,input tt-wth-place.obj-code
      595                    ,input tt-wth-place.w-p-name
      596                    ,input tt-wth-place.status_
      597                    ,input tt-wth-place.cash-desk
      598                    ,input tt-wth-place.main-cash-desk
      599                    ,input tt-wth-place.PS
      600                    ) no-error .
      601       IF ERROR-STATUS:ERROR THEN DO:
      602       if return-value <> '':U then do:
      603         CASE return-value:
      604           when "obj-code":U then do:
      605             APPLY "ENTRY":U TO tt-wth-place.obj-code IN FRAME Dialog-Frame.
      606           end.
      607           when "cash-desk":U then do:
      608             APPLY "ENTRY":U TO tt-wth-place.cash-desk IN FRAME Dialog-Frame.
      609           end.
      610           when "main-cash-desk":U then do:
      611             APPLY "ENTRY":U TO tt-wth-place.main-cash-desk IN FRAME Dialog-Frame.
      612           end.
      613         END CASE.
      614       end.
      615       RETURN error.
      616     END.
      617   END PROCEDURE.
