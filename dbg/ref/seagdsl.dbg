      174   PROCEDURE chk-gdssea :
      175   define input  parameter p-gds-code as integer no-undo.
      176   define input  parameter p-seaobj as character no-undo.
      177   define input  parameter p-i-date1 as integer no-undo.
      178   define input  parameter p-i-date2 as integer no-undo.
      179   define input  parameter p-rowid as rowid no-undo.
      180   define output parameter p-sea-code as integer no-undo.
      181   define output parameter p-db-num as integer no-undo.
      182   define output parameter p-ok as logical no-undo init yes.
      183   define buffer buf_season for ub.season.
      184   define buffer buf1_season for ub.season.
      185   define buffer buf1_gds-season for ub.gds-season.
      186   define buffer buf_season-attr for ub.season-attr.
      187   define buffer buf1_season-attr for ub.season-attr.
      188     for each buf1_season no-lock where ((buf1_season.sea-month-1 <= p-i-date1 and buf1_season.sea-month-2 >= p-i-date1)
      189       or (buf1_season.sea-month-1 <= p-i-date2 and buf1_season.sea-month-2 >= p-i-date2)
      190       or (buf1_season.sea-month-1 <= p-i-date1 and buf1_season.sea-month-2 >= p-i-date1))
      191       and (rowid (buf1_season) <> p-rowid or p-rowid = ?):
      192         if can-find (first buf1_season-attr where buf1_season-attr.sea-code = buf1_season.sea-code
      193                                               and buf1_season-attr.db-num = buf1_season.db-num
      194                                               and buf1_season-attr.attr-code = 'sea-obj':U
      195                                               and buf1_season-attr.attr-value = p-seaobj
      196                                               )
      197           or
      198           (not can-find (first buf1_season-attr where buf1_season-attr.sea-code = buf1_season.sea-code
      199                                                 and buf1_season-attr.db-num = buf1_season.db-num
      200                                                 and buf1_season-attr.attr-code = 'sea-obj':U
      201                                                 )
      202           and p-seaobj = "")
      203         then do:
      204           if can-find (first buf1_gds-season where  buf1_gds-season.sea-code = buf1_season.sea-code
      205                                                 and buf1_gds-season.db-num = buf1_gds-season.db-num
      206                                                 and buf1_gds-season.gds-code = p-gds-code)
      207           then do:
      208           assign
      209             p-ok = false
      210             p-sea-code = buf1_season.sea-code
      211             p-db-num = buf1_season.db-num.
      212             leave.
      213           end.
      214         end.
      215     end.
      216   END PROCEDURE.
      217   define buffer buf_season      for ub.season.
      218   define buffer buf_season-attr for ub.season-attr.
      219   define variable rid-list   as character no-undo .
      220   define variable log-res    as log       no-undo.
      221   define variable rr         as recid     no-undo.
