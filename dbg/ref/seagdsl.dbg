      286   DEFINE VARIABLE FILL-IN-2  AS CHARACTER FORMAT "X(256)":U INITIAL "Поиск по"
      287       VIEW-AS TEXT
      288       SIZE 8.88 BY .67
      289       FGCOLOR 4 NO-UNDO.
