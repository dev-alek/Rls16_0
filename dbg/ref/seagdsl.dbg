      321       tt-gds-sea.season-coef FORMAT ">>,>>9.999":U LABEL-FGCOLOR 1
      322       tt-gds-sea.gds-code FORMAT "999999999":U
      323     ENABLE
      324         tt-gds-sea.min-stock
      325         tt-gds-sea.season-coef
      326       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 18.33
      327            BGCOLOR 15 .
      328   DEFINE FRAME Dialog-Frame
      329       b-exit AT ROW 1 COL 1
      330       b-sel AT ROW 1 COL 11
      331       B-mark AT ROW 1 COL 21
      332       b-add AT ROW 1 COL 24
      333       b-upd AT ROW 1 COL 34
      334       b-del AT ROW 1 COL 44
      335       b-print AT ROW 1 COL 54
      336       b-list AT ROW 1 COL 64.13
      337       b-help AT ROW 1 COL 78
