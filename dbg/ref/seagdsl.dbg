      476                       buf_gds-season-attr.gds-code   = tt-gds-sea.gds-code
      477                       buf_gds-season-attr.attr-code  = 'gdssea-season-coef':U
      478                       buf_gds-season-attr.attr-value = string (tt-gds-sea.season-coef)
      479                       .
