      488   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      489       DO:
      490           define variable g-log as logical no-undo .
      491   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      492   do:
      493     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      494       (input  v-cntxt-db-num
      495       ,input  v-cntxt-userid
      496       ,input  0
      497       ,input  'actn_collection_deletion':U
      498       ,input  'global':U
      499       ,input  0
      500       ,input  '':U
      501       ,input  0
      502       ,input  0
      503       ,input  0
      504       ,input  0
      505       ,input  true
      506       ,output v-log
      507       )  .
      508   end.
      509           if not v-log then return no-apply .
      510           if not available tt-gds-sea then  return no-apply.
      511           message "Удалить запись ? "
      512               view-as alert-box question
      513               buttons yes-no
      514               update g-log.
      515           if g-log = false then return no-apply.
      516           define variable v-recid as integer no-undo .
      517           define variable ii      as integer no-undo .
      518           find first buf_gds-season exclusive-lock where buf_gds-season.sea-code = p-sea-code
      519               and buf_gds-season.db-num = p-db-num
      520               and buf_gds-season.gds-code = tt-gds-sea.gds-code no-error .
      521           if available buf_gds-season then delete buf_gds-season.
      522           find current tt-gds-sea.
      523           delete tt-gds-sea.
      524           BROWSE-2:delete-current-row().
      525       END.
      526   ON CHOOSE OF b-list IN FRAME Dialog-Frame
      527       DO:
