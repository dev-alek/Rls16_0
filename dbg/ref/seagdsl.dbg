      225   define variable doc-rec    as recid     no-undo .
      226   define variable gds-rec    as recid     no-undo .
      227   define variable lns-cnt    as integer   no-undo .
      228   define variable g#log      as logical   no-undo .
      229   define variable v-value    as character no-undo .
      230   define variable v-type     as character no-undo .
