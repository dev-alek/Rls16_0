      598   ON VALUE-CHANGED OF R-sort IN FRAME Dialog-Frame
      599       DO:
      600           Assign frame Dialog-Frame r-sort.
      601           case r-sort :
      602               when 1 then
      603                   do:
      604                       if sch-field = "s-name-cnt" then
      605                       do:
      606                           assign
      607                               frame Dialog-Frame:title = "Товары >> Сезон - " + p-name.
      608                           OPEN QUERY BROWSE-2 FOR EACH tt-gds-sea       NO-LOCK     .
      609                       end.
      610                       enable s-artic with frame Dialog-Frame.
      611                       Hide s-name  s-name-cnt in frame Dialog-Frame.
      612                       display s-artic with frame Dialog-Frame.
      613                   end.
      614               when 2 then
      615                   do:
      616                       if sch-field = "s-name-cnt" then
      617                       do:
      618                           assign
      619                               frame Dialog-Frame:title = "Товары >> Сезон - " + p-name.
      620                           OPEN QUERY BROWSE-2 FOR EACH tt-gds-sea       NO-LOCK     .
      621                       end.
      622                       enable s-name with frame Dialog-Frame.
      623                       hide s-artic  s-name-cnt in frame Dialog-Frame.
      624                       display s-name with frame Dialog-Frame.
      625                   end.
      626               when 3 then
      627                   do:
      628                       enable s-name-cnt with frame Dialog-Frame.
      629                       hide s-artic  s-name in frame Dialog-Frame.
      630                       display s-name-cnt with frame Dialog-Frame.
      631                   end.
      632           end case.
      633       END.
      634   ON MOUSE-SELECT-DBLCLICK OF s-artic IN FRAME Dialog-Frame
      635       OR  RETURN OF s-artic IN FRAME Dialog-Frame
      636       DO:
      637           if s-artic <> input frame Dialog-Frame s-artic or sch-field <> "s-artic" then
      638           do:
      639               sch-field = "s-artic".
      640               assign
      641                   s-artic = input frame Dialog-Frame s-artic.
      642               doc-rec = ?.
      643               for each tt-gds-sea no-lock,
      644                   first buf_goods no-lock where
      645                   buf_goods.gds-code = tt-gds-sea.gds-code and
      646                   buf_goods.artic begins s-artic :
      647                   doc-rec = recid ( tt-gds-sea ) .
      648                   leave.
      649               end.
      650               if doc-rec = ? then message "Товар не найден !"  .
      651               else
      652                   reposition BROWSE-2 to recid doc-rec no-error.
      653               return no-apply.
      654           end.
      655       END.
      656   ON MOUSE-SELECT-DBLCLICK OF s-name IN FRAME Dialog-Frame
      657       OR  RETURN OF s-name IN FRAME Dialog-Frame
      658       DO:
      659           if s-name <> input frame Dialog-Frame s-name or sch-field <> "s-name" then
      660           do:
      661               sch-field = "s-name".
      662               assign
      663                   s-name = input frame Dialog-Frame s-name.
      664               doc-rec = ?.
      665               for each tt-gds-sea no-lock,
      666                   first buf_goods no-lock where
      667                   buf_goods.gds-code = tt-gds-sea.gds-code and
      668                   buf_goods.gds-name begins s-name
      669                   :
      670                   doc-rec = recid(tt-gds-sea) .
      671                   leave.
      672               end.
      673               if doc-rec = ? then message "Товар не найден !"  .
      674               else
      675                   reposition BROWSE-2 to recid doc-rec no-error.
      676               return no-apply.
      677           end.
      678       END.
      679   ON MOUSE-SELECT-DBLCLICK OF s-name-cnt IN FRAME Dialog-Frame
      680       OR  RETURN OF s-name-cnt IN FRAME Dialog-Frame
      681       DO:
      682           if s-name-cnt <> input frame Dialog-Frame s-name-cnt or sch-field <> "s-name-cnt" then
      683           do:
      684               sch-field = "s-name-cnt".
      685               assign
      686                   s-name-cnt = input frame Dialog-Frame s-name-cnt.
      687               doc-rec = ?.
      688               for each tt-gds-sea no-lock,
      689                   first buf_goods no-lock where
      690                   buf_goods.gds-code = tt-gds-sea.gds-code  and
      691               INDEX (buf_goods.gds-name,s-name-cnt) > 0
      692                   :
      693                   doc-rec = recid(tt-gds-sea) .
      694                   leave.
      695               end.
      696               if doc-rec = ? then message "Товар не найден !"  .
      697               else
      698               do:
      699                   assign
      700                       frame Dialog-Frame:title = "Товары >> Сезон - " + p-name + " , содержащие в названии " + s-name-cnt .
      701                   OPEN QUERY BROWSE-2 FOR EACH tt-gds-sea       WHERE INDEX(tt-gds-sea.gds-name,s-name-cnt) > 0       NO-LOCK .
      702               end.
      703               return no-apply.
      704           end.
      705       END.
      706   ON ROW-DISPLAY OF BROWSE-2 IN FRAME Dialog-Frame
      707       DO:
      708           if available tt-gds-sea then
      709           do:
      710               if tt-gds-sea.is-inter
      711                   then tt-gds-sea.artic:bgcolor in browse BROWSE-2  = 12.
      712               else tt-gds-sea.artic:bgcolor in browse BROWSE-2  = ?.
      713           end.
      714       END.
      715   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      716       THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      717   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      718   on help of frame Dialog-Frame
      719   do:
      720     run gbl/app_help.p
      721       (input this-procedure :file-name
      722       ,input ''
      723       ,input ?
      724       ) no-error.
      725     if error-status :error then do:
      726       message
      727         "Ошибка при вызове помощи"
      728         error-status :get-message(1)
      729         view-as alert-box .
      730     end.
      731   end.
      732   run minbtn-set in this-procedure .
      733   on choose of b-help in frame Dialog-Frame
      734   do:
      735     apply "help":u to frame Dialog-Frame .
      736   end.
      737   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      738   procedure minbtn-set :
      739       do
      740           on error undo, return error return-value
      741           :
      742           define variable ii              as integer       no-undo .
      743           define variable fh              as widget-handle no-undo .
      744           define variable hh              as widget-handle no-undo .
      745           define variable v-h             as handle        extent 4 no-undo .
      746           define variable v-name-button   as character     no-undo .
      747           define variable v-help-old-x    as decimal       no-undo .
      748           define variable v-help-old-y    as decimal       no-undo .
      749           define variable v-help-old-size as decimal       no-undo .
      750           define variable v-frame-width   as decimal       no-undo .
      751           define variable jj              as integer       no-undo .
      752           do
      753               on error undo, return error
      754               :
      755               assign
      756                   v-frame-width = frame Dialog-Frame:width - 0.3
      757                   fh            = frame Dialog-Frame:first-child
      758                   hh            = fh:first-child
      759                   ii            = 1
      760                   .
      761               do while valid-handle(hh):
      762                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      763                   do:
      764                       case lc(hh:name) :
      765                           when "b-help" then
      766                               do:
      767                                   hh:load-image-up("cmp/b-help.bmp":u) .
      768                                   hh:load-image-down("cmp/b-help.bmp":u) .
      769                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      770                                   hh:TOOLTIP = "Помощь" .
      771                                   v-help-old-x = hh:column .
      772                                   v-help-old-y = hh:row    .
      773                                   v-help-old-size = hh:width .
      774                                   hh:width-chars = 2.5 .
      775                               end.
      776                           when "b-print" then
      777                               do:
      778                                   hh:load-image("cmp/b-print.bmp":u) .
      779                                   hh:TOOLTIP = "Печать" .
      780                                   v-h[ii] = hh:handle .
      781                                   ii = ii + 1 .
      782                                   hh:width-chars = 3 .
      783                               end.
      784                           when "b-history" or
      785                           when "b-hist" then
      786                               do:
      787                                   hh:load-image("cmp/b-hist.bmp":u) .
      788                                   hh:TOOLTIP = "История" .
      789                                   v-h[ii] = hh:handle .
      790                                   ii = ii + 1 .
      791                                   hh:width-chars = 3 .
      792                               end.
      793                           when "b-sch" then
      794                               do:
      795                                   hh:load-image("cmp/b-sch.bmp":u) .
      796                                   hh:TOOLTIP = "Установка Фильтра" .
      797                                   v-h[ii] = hh:handle .
      798                                   ii = ii + 1 .
      799                                   hh:width-chars = 3 .
      800                               end.
      801                           when "b-hist-user" then
      802                               do:
      803                                   hh:load-image("cmp/b-hist.bmp":u) .
      804                                   hh:TOOLTIP = "История пользователя" .
      805                                   ii = ii + 1 .
      806                               end.
      807                       end case.
      808                   end.
      809                   hh = hh:next-sibling.
      810               end.
      811               b-help:column = v-frame-width - b-help:width-chars.
      812               jj = 0.
      813               repeat ii = 4 to 1 by -1 :
      814                   if valid-handle (v-h[ii] ) then
      815                   do:
      816                       jj  = jj + 1 .
      817                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      818                       v-h[ii]:row    = v-help-old-y .
      819                   end.
      820               end.
      821           end.
      822       end.
      823   end procedure.
      824   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      825   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      826   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      827   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      828   define variable v-diasize-current-frame-width  as decimal   no-undo .
      829   define variable v-diasize-current-frame-height as decimal   no-undo .
      830   define variable v-diasize-change-size          as logical   no-undo .
      831   define variable v-diasize-resize-button        as handle    no-undo .
      832   define variable v-diasize-wndmax               as logical   no-undo .
      833   define variable v-diasize-wndstore             as logical   no-undo .
      834   define variable v-diasize-proc-name            as character no-undo .
      835   define variable v-diasize-browse-handle        as handle    no-undo .
      836   define variable v-diasize-browse-number        as integer   no-undo .
      837   define variable v-diasize-need-full-display    as logical   no-undo init false .
      838   define temp-table temp-diasize-handle no-undo
      839     field handle-value  as handle
      840     field save-position as decimal
      841     index xpk is primary unique handle-value
      842     .
      843   define temp-table temp-browse-handle no-undo
      844     field browse-type   as character
      845     field browse-number as integer
      846     field browse-handle as handle
      847     field original-size as decimal
      848     index xpk is primary unique browse-type browse-number
      849     index xie browse-type browse-handle
      850   .
      851   procedure diasize_change-height :
      852     define input  parameter p-change-value  as decimal   no-undo .
      853     define input  parameter p-move-resize   as logical   no-undo .
      854     define variable v-field-group-handle    as handle    no-undo .
      855     define variable v-object-handle         as handle    no-undo .
      856     define variable v-frame-height          as decimal   no-undo .
      857     define variable v-frame-virtual-height  as decimal   no-undo .
      858     define variable v-browse-height         as decimal   no-undo .
      859     define variable v-window-height         as decimal   no-undo .
      860     define variable v-window-virtual-height as decimal   no-undo .
      861     define variable v-change-sign           as integer   no-undo .
      862     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      863     define buffer buf_temp-browse-handle  for temp-browse-handle .
      864     if p-change-value > 0
      865     then do:
      866       if frame Dialog-Frame :height + p-change-value
      867           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      868       then do:
      869         assign
      870           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      871                           - (frame Dialog-Frame :height-chars)
      872         .
      873         if p-change-value <= 0
      874         then do:
      875           run diasize_position-resize-button in this-procedure .
      876           return .
      877         end.
      878       end.
      879     end.
      880     if p-change-value < 0
      881     then do:
      882       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      883       then do:
      884         assign
      885           p-change-value = v-diasize-orig-frame-height
      886                          - (frame Dialog-Frame :height-chars)
      887         .
      888         if p-change-value >= 0
      889         then do:
      890           run diasize_position-resize-button in this-procedure .
      891           return .
      892         end.
      893       end.
      894     end.
      895     if p-change-value >= 0
      896     then do:
      897       assign
      898         v-change-sign = 1
      899       .
      900     end.
      901     else do:
      902       assign
      903         v-change-sign = -1
      904       .
      905     end.
      906     assign
      907       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      908     .
      909     if p-change-value = 0
      910     then do:
      911       run diasize_position-resize-button in this-procedure .
      912       return .
      913     end.
      914     move_block:
      915     do
      916     on error undo move_block, retry move_block
      917     :
      918       if retry
      919       then do:
      920         do
      921         on error undo move_block, leave move_block
      922         :
      923           if p-change-value > 0
      924           then do:
      925             for each buf_temp-diasize-handle
      926             on error undo, next
      927             :
      928               assign
      929                 v-object-handle = buf_temp-diasize-handle.handle-value
      930               .
      931               if v-object-handle <> v-diasize-resize-button
      932               then do:
      933                 assign
      934                   v-object-handle :row = buf_temp-diasize-handle.save-position
      935                 .
      936               end.
      937             end.
      938             assign
      939               v-diasize-browse-handle :height = v-browse-height
      940             .
      941             for each buf_temp-browse-handle
      942               where buf_temp-browse-handle.browse-type = 'height':u
      943             on error undo, next
      944             :
      945               assign
      946                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      947               .
      948             end.
      949             assign
      950               frame Dialog-Frame :height = v-frame-height
      951             .
      952             if frame Dialog-Frame :scrollable = true
      953             then do:
      954               assign
      955                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      956               .
      957             end.
      958             run diasize_position-resize-button in this-procedure .
      959           end.
      960           else do:
      961             if frame Dialog-Frame :scrollable = true
      962             then do:
      963               assign
      964                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      965               .
      966             end.
      967             assign
      968               frame Dialog-Frame :height = v-frame-height
      969             .
      970             assign
      971               v-diasize-browse-handle :height = v-browse-height
      972             .
      973             for each buf_temp-browse-handle
      974               where buf_temp-browse-handle.browse-type = 'height':u
      975             on error undo, next
      976             :
      977               assign
      978                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      979               .
      980             end.
      981             for each buf_temp-diasize-handle
      982             on error undo, next
      983             :
      984               assign
      985                 v-object-handle = buf_temp-diasize-handle.handle-value
      986               .
      987               if v-object-handle <> v-diasize-resize-button
      988               then do:
      989                 assign
      990                   v-object-handle :row = buf_temp-diasize-handle.save-position
      991                 .
      992               end.
      993             end.
      994             run diasize_position-resize-button in this-procedure .
      995           end.
      996           assign
      997             v-diasize-change-size = false
      998           .
      999           leave move_block .
     1000         end.
     1001       end.
     1002       assign
     1003         v-diasize-need-full-display = true
     1004       .
     1005       if v-diasize-change-size = false
     1006       then do:
     1007         assign
     1008           v-diasize-change-size = true
     1009         .
     1010       end.
     1011       else do:
     1012         return .
     1013       end.
     1014       assign
     1015         v-frame-height = frame Dialog-Frame :height
     1016         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1017         v-browse-height = v-diasize-browse-handle :height
     1018       .
     1019       for each buf_temp-browse-handle
     1020         where buf_temp-browse-handle.browse-type = 'height':u
     1021       :
     1022         assign
     1023           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1024         .
     1025       end.
     1026       for each buf_temp-diasize-handle
     1027       :
     1028         delete buf_temp-diasize-handle .
     1029       end.
     1030       assign
     1031         v-field-group-handle = frame Dialog-Frame :first-child
     1032       .
     1033       do while valid-handle(v-field-group-handle)
     1034       :
     1035         assign
     1036           v-object-handle = v-field-group-handle :first-child
     1037         .
     1038         do while valid-handle(v-object-handle)
     1039         :
     1040           if  v-object-handle <> v-diasize-browse-handle :handle
     1041           and can-query(v-object-handle, "row")
     1042           and can-query(v-object-handle, "height")
     1043           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1044           then do:
     1045             find first buf_temp-browse-handle
     1046               where buf_temp-browse-handle.browse-type   = 'height':u
     1047                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1048               no-error .
     1049             if available buf_temp-browse-handle
     1050             then do:
     1051             end.
     1052             else do:
     1053               create buf_temp-diasize-handle .
     1054               assign
     1055                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1056                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1057               .
     1058             end.
     1059           end.
     1060           assign
     1061             v-object-handle = v-object-handle :next-sibling
     1062           .
     1063         end.
     1064         assign
     1065           v-field-group-handle = v-field-group-handle :next-sibling
     1066         .
     1067       end.
     1068       do with frame Dialog-Frame
     1069       :
     1070         hide v-diasize-resize-button .
     1071         assign
     1072           v-diasize-resize-button :row    = 1
     1073           v-diasize-resize-button :column = 1
     1074         .
     1075       end.
     1076       if p-change-value > 0
     1077       then do:
     1078         if frame Dialog-Frame :scrollable = true
     1079         then do:
     1080           assign
     1081             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1082             no-error .
     1083           if error-status :error
     1084           or error-status :get-message(1) <> ""
     1085           then do:
     1086             undo move_block, retry move_block .
     1087           end.
     1088         end.
     1089         assign
     1090           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1091           no-error .
     1092         if error-status :error
     1093         or error-status :get-message(1) <> ""
     1094         then do:
     1095           undo move_block, retry move_block .
     1096         end.
     1097         assign
     1098           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1099           no-error .
     1100         if error-status :error
     1101         or error-status :get-message(1) <> ""
     1102         then do:
     1103           undo move_block, retry move_block .
     1104         end.
     1105         for each buf_temp-browse-handle
     1106           where buf_temp-browse-handle.browse-type = 'height':u
     1107         on error undo move_block, retry move_block
     1108         :
     1109           assign
     1110             buf_temp-browse-handle.browse-handle :height
     1111               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1112             no-error .
     1113           if error-status :error
     1114           or error-status :get-message(1) <> ""
     1115           then do:
     1116             undo move_block, retry move_block .
     1117           end.
     1118         end.
     1119         for each buf_temp-diasize-handle
     1120         on error undo move_block, retry move_block
     1121         :
     1122           assign
     1123             v-object-handle = buf_temp-diasize-handle.handle-value
     1124           .
     1125           if v-object-handle <> v-diasize-resize-button
     1126           then do:
     1127             assign
     1128               v-object-handle :row = v-object-handle :row + p-change-value
     1129               no-error .
     1130             if error-status :error
     1131             or error-status :get-message(1) <> ""
     1132             then do:
     1133               undo move_block, retry move_block .
     1134             end.
     1135           end.
     1136         end.
     1137       end.
     1138       else do:
     1139         for each buf_temp-diasize-handle
     1140         on error undo move_block, retry move_block
     1141         :
     1142           assign
     1143             v-object-handle = buf_temp-diasize-handle.handle-value
     1144           .
     1145           if v-object-handle <> v-diasize-resize-button
     1146           then do:
     1147             assign
     1148               v-object-handle :row = v-object-handle :row + p-change-value
     1149               no-error .
     1150             if error-status :error
     1151             or error-status :get-message(1) <> ""
     1152             then do:
     1153               undo move_block, retry move_block .
     1154             end.
     1155           end.
     1156         end.
     1157         assign
     1158           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1159           no-error .
     1160         if error-status :error
     1161         or error-status :get-message(1) <> ""
     1162         then do:
     1163           undo move_block, retry move_block .
     1164         end.
     1165         for each buf_temp-browse-handle
     1166           where buf_temp-browse-handle.browse-type = 'height':u
     1167         on error undo move_block, retry move_block
     1168         :
     1169           assign
     1170             buf_temp-browse-handle.browse-handle :height
     1171               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1172             no-error .
     1173           if error-status :error
     1174           or error-status :get-message(1) <> ""
     1175           then do:
     1176             undo move_block, retry move_block .
     1177           end.
     1178         end.
     1179         assign
     1180           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1181           no-error .
     1182         if error-status :error
     1183         or error-status :get-message(1) <> ""
     1184         then do:
     1185           undo move_block, retry move_block .
     1186         end.
     1187         if frame Dialog-Frame :scrollable = true
     1188         then do:
     1189           assign
     1190             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1191             no-error .
     1192           if error-status :error
     1193           or error-status :get-message(1) <> ""
     1194           then do:
     1195             undo move_block, retry move_block .
     1196           end.
     1197         end.
     1198       end.
     1199       if p-move-resize = true
     1200       then do:
     1201         run diasize_position-resize-button in this-procedure .
     1202       end.
     1203       if v-diasize-wndstore = true
     1204       then do:
     1205         if connected("ub") = true
     1206         then do:
     1207           define variable v-cntxt-db-num        as integer   no-undo .
     1208           define variable v-cntxt-userid        as character no-undo .
     1209           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1210                                             , OUTPUT v-cntxt-userid
     1211                                             ) .
     1212           run gbl/wndsizew.p
     1213             (input  v-cntxt-db-num
     1214             ,input  v-cntxt-userid
     1215             ,input  v-diasize-proc-name
     1216             ,input  'height':u
     1217             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1218             ) .
     1219         end.
     1220       end.
     1221     end.
     1222     assign
     1223       v-diasize-change-size = false
     1224     .
     1225   end procedure.
     1226   procedure diasize_set-height :
     1227     define input  parameter p-new-height  as decimal   no-undo .
     1228     define input  parameter p-move-resize as logical   no-undo .
     1229     do
     1230     on error undo, return error return-value
     1231     :
     1232       run diasize_change-height in this-procedure
     1233         (input  (p-new-height - frame Dialog-Frame :height)
     1234         ,input  p-move-resize
     1235         ) .
     1236     end.
     1237   end procedure.
     1238   procedure diasize_change-width :
     1239     define input  parameter p-change-value as decimal   no-undo .
     1240     define input  parameter p-move-resize  as logical   no-undo .
     1241     define variable v-field-group-handle   as handle    no-undo .
     1242     define variable v-object-handle        as handle    no-undo .
     1243     define variable v-frame-width          as decimal   no-undo .
     1244     define variable v-frame-virtual-width  as decimal   no-undo .
     1245     define variable v-browse-width         as decimal   no-undo .
     1246     define variable v-window-width         as decimal   no-undo .
     1247     define variable v-window-virtual-width as decimal   no-undo .
     1248     define variable v-change-sign          as integer   no-undo .
     1249     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1250     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1251     if p-change-value > 0
     1252     then do:
     1253       if frame Dialog-Frame :width + p-change-value >
     1254           session :width-chars
     1255       then do:
     1256         assign
     1257           p-change-value = session :width-chars - frame Dialog-Frame :width
     1258         .
     1259         if p-change-value <= 0
     1260         then do:
     1261           run diasize_position-resize-button in this-procedure .
     1262           return .
     1263         end.
     1264       end.
     1265     end.
     1266     if p-change-value < 0
     1267     then do:
     1268       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1269       then do:
     1270         assign
     1271           p-change-value = v-diasize-orig-frame-width
     1272                          - frame Dialog-Frame :width
     1273         .
     1274         if p-change-value >= 0
     1275         then do:
     1276           run diasize_position-resize-button in this-procedure .
     1277           return .
     1278         end.
     1279       end.
     1280     end.
     1281     if p-change-value >= 0
     1282     then do:
     1283       assign
     1284         v-change-sign = 1
     1285       .
     1286     end.
     1287     else do:
     1288       assign
     1289         v-change-sign = -1
     1290       .
     1291     end.
     1292     assign
     1293       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1294     .
     1295     if p-change-value = 0
     1296     then do:
     1297       run diasize_position-resize-button in this-procedure .
     1298       return .
     1299     end.
     1300     move_block:
     1301     do
     1302     on error undo move_block, leave move_block
     1303     :
     1304       if retry
     1305       then do:
     1306         do
     1307         on error undo move_block, leave move_block
     1308         :
     1309           if p-change-value > 0
     1310           then do:
     1311             for each buf_temp-diasize-handle
     1312             on error undo, next
     1313             :
     1314               assign
     1315                 v-object-handle = buf_temp-diasize-handle.handle-value
     1316               .
     1317               if v-object-handle <> v-diasize-resize-button
     1318               then do:
     1319                 assign
     1320                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1321                 .
     1322               end.
     1323             end.
     1324             assign
     1325               v-diasize-browse-handle :width = v-browse-width
     1326             .
     1327             for each buf_temp-browse-handle
     1328               where buf_temp-browse-handle.browse-type = 'width':u
     1329             on error undo, next
     1330             :
     1331               assign
     1332                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1333               .
     1334             end.
     1335             assign
     1336               frame Dialog-Frame :width = v-frame-width
     1337             .
     1338             if frame Dialog-Frame :scrollable = true
     1339             then do:
     1340               assign
     1341                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1342               .
     1343             end.
     1344             run diasize_position-resize-button in this-procedure .
     1345           end.
     1346           else do:
     1347             if frame Dialog-Frame :scrollable = true
     1348             then do:
     1349               assign
     1350                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1351               .
     1352             end.
     1353             assign
     1354               frame Dialog-Frame :width = v-frame-width
     1355             .
     1356             for each buf_temp-browse-handle
     1357               where buf_temp-browse-handle.browse-type = 'width':u
     1358             on error undo, next
     1359             :
     1360               assign
     1361                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1362               .
     1363             end.
     1364             assign
     1365               v-diasize-browse-handle :width = v-browse-width
     1366             .
     1367             for each buf_temp-diasize-handle
     1368             on error undo, next
     1369             :
     1370               assign
     1371                 v-object-handle = buf_temp-diasize-handle.handle-value
     1372               .
     1373               if v-object-handle <> v-diasize-resize-button
     1374               then do:
     1375                 assign
     1376                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1377                 .
     1378               end.
     1379             end.
     1380             run diasize_position-resize-button in this-procedure .
     1381           end.
     1382           assign
     1383             v-diasize-change-size = false
     1384           .
     1385           leave move_block .
     1386         end.
     1387       end.
     1388       assign
     1389         v-diasize-need-full-display = true
     1390       .
     1391       if v-diasize-change-size = false
     1392       then do:
     1393         assign
     1394           v-diasize-change-size = true
     1395         .
     1396       end.
     1397       else do:
     1398         return .
     1399       end.
     1400       assign
     1401         v-frame-width = frame Dialog-Frame :width
     1402         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1403         v-browse-width = v-diasize-browse-handle :width
     1404       .
     1405       for each buf_temp-browse-handle
     1406         where buf_temp-browse-handle.browse-type = 'width':u
     1407       :
     1408         assign
     1409           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1410         .
     1411       end.
     1412       for each buf_temp-diasize-handle
     1413       :
     1414         delete buf_temp-diasize-handle .
     1415       end.
     1416       assign
     1417         v-field-group-handle = frame Dialog-Frame :first-child
     1418       .
     1419       do while valid-handle(v-field-group-handle)
     1420       :
     1421         assign
     1422           v-object-handle = v-field-group-handle :first-child
     1423         .
     1424         do while valid-handle(v-object-handle)
     1425         :
     1426           if  v-object-handle <> v-diasize-browse-handle :handle
     1427           and v-object-handle <> v-diasize-resize-button
     1428           and can-query(v-object-handle, "row")
     1429           and can-query(v-object-handle, "height")
     1430           and ( v-object-handle :col + v-object-handle :width
     1431                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1432               )
     1433           then do:
     1434             find first buf_temp-browse-handle
     1435               where buf_temp-browse-handle.browse-type   = 'width':u
     1436                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1437               no-error .
     1438             if available buf_temp-browse-handle
     1439             then do:
     1440             end.
     1441             else do:
     1442               create buf_temp-diasize-handle .
     1443               assign
     1444                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1445                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1446               .
     1447             end.
     1448           end.
     1449           assign
     1450             v-object-handle = v-object-handle :next-sibling
     1451           .
     1452         end.
     1453         assign
     1454           v-field-group-handle = v-field-group-handle :next-sibling
     1455         .
     1456       end.
     1457       do with frame Dialog-Frame
     1458       :
     1459         hide v-diasize-resize-button .
     1460         v-diasize-resize-button :row = 1.
     1461         v-diasize-resize-button :column = 1.
     1462       end.
     1463       if p-change-value > 0
     1464       then do:
     1465         if frame Dialog-Frame :scrollable = true
     1466         then do:
     1467           assign
     1468             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1469             no-error .
     1470           if error-status :error
     1471           or error-status :get-message(1) <> ""
     1472           then do:
     1473             undo move_block, retry move_block.
     1474           end.
     1475         end.
     1476         assign
     1477           frame Dialog-Frame :width = v-frame-width + p-change-value
     1478           no-error .
     1479         if error-status :error
     1480         or error-status :get-message(1) <> ""
     1481         then do:
     1482           undo move_block, retry move_block.
     1483         end.
     1484         assign
     1485           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1486         no-error .
     1487         if error-status :error
     1488         or error-status :get-message(1) <> ""
     1489         then do:
     1490           undo move_block, retry move_block.
     1491         end.
     1492         for each buf_temp-browse-handle
     1493           where buf_temp-browse-handle.browse-type = 'width':u
     1494         on error undo move_block, retry move_block
     1495         :
     1496           assign
     1497             buf_temp-browse-handle.browse-handle :width
     1498               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1499             no-error .
     1500           if error-status :error
     1501           or error-status :get-message(1) <> ""
     1502           then do:
     1503             undo move_block, retry move_block .
     1504           end.
     1505         end.
     1506         for each buf_temp-diasize-handle
     1507         on error undo move_block, retry move_block
     1508         :
     1509           assign
     1510             v-object-handle = buf_temp-diasize-handle.handle-value
     1511           .
     1512           if v-object-handle <> v-diasize-resize-button
     1513           then do:
     1514             assign
     1515               v-object-handle :col = v-object-handle :col + p-change-value
     1516               no-error .
     1517             if error-status :error
     1518             or error-status :get-message(1) <> ""
     1519             then do:
     1520               undo move_block, retry move_block .
     1521             end.
     1522           end.
     1523         end.
     1524       end.
     1525       else do:
     1526         for each buf_temp-diasize-handle
     1527         on error undo move_block, retry move_block
     1528         :
     1529           assign
     1530             v-object-handle = buf_temp-diasize-handle.handle-value
     1531           .
     1532           if v-object-handle <> v-diasize-resize-button
     1533           then do:
     1534             assign
     1535               v-object-handle :col = v-object-handle :col + p-change-value
     1536               no-error .
     1537             if error-status :error
     1538             or error-status :get-message(1) <> ""
     1539             then do:
     1540               undo move_block, retry move_block .
     1541             end.
     1542           end.
     1543         end.
     1544         for each buf_temp-browse-handle
     1545           where buf_temp-browse-handle.browse-type = 'width':u
     1546         on error undo move_block, retry move_block
     1547         :
     1548           assign
     1549             buf_temp-browse-handle.browse-handle :width
     1550               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1551             no-error .
     1552           if error-status :error
     1553           or error-status :get-message(1) <> ""
     1554           then do:
     1555             undo move_block, retry move_block .
     1556           end.
     1557         end.
     1558         assign
     1559           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1560           no-error .
     1561         if error-status :error
     1562         or error-status :get-message(1) <> ""
     1563         then do:
     1564           undo move_block, retry move_block.
     1565         end.
     1566         assign
     1567           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1568         no-error .
     1569         if error-status :error
     1570         or error-status :get-message(1) <> ""
     1571         then do:
     1572           undo move_block, retry move_block.
     1573         end.
     1574         if frame Dialog-Frame :scrollable = true
     1575         then do:
     1576           assign
     1577             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1578           no-error .
     1579           if error-status :error
     1580           or error-status :get-message(1) <> ""
     1581           then do:
     1582             undo move_block, retry move_block.
     1583           end.
     1584         end.
     1585       end.
     1586       if p-move-resize
     1587       then do:
     1588         run diasize_position-resize-button in this-procedure .
     1589       end.
     1590       if v-diasize-wndstore = true
     1591       then do:
     1592         if connected("ub") = true
     1593         then do:
     1594           define variable v-cntxt-db-num        as integer   no-undo .
     1595           define variable v-cntxt-userid        as character no-undo .
     1596           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1597                                             , OUTPUT v-cntxt-userid
     1598                                             ) .
     1599           run gbl/wndsizew.p
     1600             (input  v-cntxt-db-num
     1601             ,input  v-cntxt-userid
     1602             ,input  v-diasize-proc-name
     1603             ,input  'width':u
     1604             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1605             ) .
     1606         end.
     1607       end.
     1608     end.
     1609     assign
     1610       v-diasize-change-size = false
     1611     .
     1612   end procedure.
     1613   procedure diasize_set-width :
     1614     define input  parameter p-new-width  as decimal   no-undo .
     1615     define input  parameter p-move-resize as logical   no-undo .
     1616     do
     1617     on error undo, return error return-value
     1618     :
     1619       run diasize_change-width in this-procedure
     1620         (input  (p-new-width - frame Dialog-Frame :width)
     1621         ,input  p-move-resize
     1622         ) .
     1623     end.
     1624   end procedure.
     1625   procedure diasize_position-resize-button :
     1626     do with frame Dialog-Frame
     1627     :
     1628       hide v-diasize-resize-button .
     1629       assign
     1630         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1631                     - 1
     1632                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1633         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1634                     - 1
     1635                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1636       .
     1637       view v-diasize-resize-button .
     1638     end.
     1639   end procedure.
     1640   on alt-right anywhere
     1641   do:
     1642     run diasize_change-width in this-procedure
     1643       (input 1
     1644       ,input true
     1645       ) .
     1646     return no-apply .
     1647   end.
     1648   on alt-left anywhere
     1649   do:
     1650     run diasize_change-width in this-procedure
     1651       (input -1
     1652       ,input true
     1653       ) .
     1654     return no-apply .
     1655   end.
     1656   on alt-down anywhere
     1657   do:
     1658     run diasize_change-height in this-procedure
     1659       (input 1
     1660       ,input true
     1661       ) .
     1662     return no-apply .
     1663   end.
     1664   on alt-up anywhere
     1665   do:
     1666     run diasize_change-height in this-procedure
     1667       (input -1
     1668       ,input true
     1669       ) .
     1670     return no-apply .
     1671   end.
     1672   on alt-enter of frame Dialog-Frame
     1673   do:
     1674     run diasize_maximize in this-procedure
     1675       (input  ?
     1676       ).
     1677     return no-apply .
     1678   end.
     1679   procedure diasize_end-move :
     1680     do
     1681     on error undo, return error return-value
     1682     :
     1683       define variable v-row-delta as decimal   no-undo .
     1684       define variable v-col-delta as decimal   no-undo .
     1685       define variable v-new-row as decimal   no-undo .
     1686       define variable v-new-col as decimal   no-undo .
     1687       assign
     1688         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1689         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1690       .
     1691       assign
     1692         v-row-delta = v-new-row - frame Dialog-Frame :height
     1693         v-col-delta = v-new-col - frame Dialog-Frame :width
     1694       .
     1695       run diasize_change-height in this-procedure
     1696         (input v-row-delta
     1697         ,input true
     1698         ) .
     1699       run diasize_change-width in this-procedure
     1700         (input v-col-delta
     1701         ,input true
     1702         ) .
     1703     end.
     1704   end procedure.
     1705   procedure diasize_maximize :
     1706     define input  parameter p-action as logical   no-undo .
     1707     do
     1708     on error undo, return error return-value
     1709     :
     1710       if p-action = ?
     1711       then do:
     1712         if v-diasize-need-maximize = true
     1713         then do:
     1714           assign
     1715             p-action = true
     1716           .
     1717         end.
     1718         else do:
     1719           assign
     1720             p-action = false
     1721           .
     1722         end.
     1723       end.
     1724       if p-action = true
     1725       then do:
     1726         run diasize_change-height in this-procedure
     1727           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1728               - frame Dialog-Frame :height-chars
     1729           ,input true
     1730           ) .
     1731         run diasize_change-width in this-procedure
     1732           (input session :width-chars
     1733               - frame Dialog-Frame :width-chars
     1734           ,input true
     1735           ) .
     1736         assign
     1737           v-diasize-need-maximize = false
     1738         .
     1739       end.
     1740       else do:
     1741         run diasize_change-width in this-procedure
     1742           (input v-diasize-orig-frame-width
     1743               - frame Dialog-Frame :width-chars
     1744           ,input true
     1745           ) .
     1746         run diasize_change-height in this-procedure
     1747           (input v-diasize-orig-frame-height
     1748               - frame Dialog-Frame :height-chars
     1749           ,input true
     1750           ) .
     1751         assign
     1752           v-diasize-need-maximize = true
     1753         .
     1754       end.
     1755     end.
     1756   end procedure.
     1757   procedure diasize_restore-orig-size :
     1758     do
     1759     on error undo, return error return-value
     1760     :
     1761       assign
     1762         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1763         v-diasize-current-frame-height = frame Dialog-Frame :height
     1764       .
     1765       run diasize_set-height in this-procedure
     1766         (input  v-diasize-orig-frame-height
     1767         ,input  true
     1768         ) .
     1769       run diasize_set-width in this-procedure
     1770         (input  v-diasize-orig-frame-width
     1771         ,input  true
     1772         ) .
     1773     end.
     1774   end procedure.
     1775   procedure diasize_restore-current-size :
     1776     do
     1777     on error undo, return error return-value
     1778     :
     1779       run diasize_set-height in this-procedure
     1780         (input  v-diasize-current-frame-height
     1781         ,input  true
     1782         ) .
     1783       run diasize_set-width in this-procedure
     1784         (input  v-diasize-current-frame-width
     1785         ,input  true
     1786         ) .
     1787     end.
     1788   end procedure.
     1789   procedure diasize_set-browse-handle :
     1790     define input  parameter p-browse-handle as handle   no-undo .
     1791     define buffer buf_temp-browse-handle for temp-browse-handle .
     1792     do
     1793     on error undo, return error return-value
     1794     :
     1795       assign
     1796         v-diasize-browse-handle = p-browse-handle
     1797       .
     1798       for each buf_temp-browse-handle
     1799       on error undo, return error return-value
     1800       :
     1801         delete buf_temp-browse-handle .
     1802       end.
     1803     end.
     1804   end procedure.
     1805   procedure diasize_add_browse :
     1806     define input  parameter p-browse-type   as character no-undo .
     1807     define input  parameter p-browse-handle as handle    no-undo .
     1808     define buffer buf_temp-browse-handle for temp-browse-handle .
     1809     do
     1810     on error undo, return error return-value
     1811     :
     1812       assign
     1813         v-diasize-browse-number = v-diasize-browse-number + 1
     1814       .
     1815       create buf_temp-browse-handle .
     1816       assign
     1817         buf_temp-browse-handle.browse-type   = p-browse-type
     1818         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1819         buf_temp-browse-handle.browse-handle = p-browse-handle
     1820       .
     1821     end.
     1822   end procedure.
     1823   procedure diasize_init :
     1824     define variable v-default-value    as logical   no-undo .
     1825     define variable v-restore-saved    as logical   no-undo .
     1826     define variable v-resize-value-str as character no-undo .
     1827     do
     1828     on error undo, return error return-value
     1829     :
     1830       do with frame Dialog-Frame
     1831       :
     1832         assign
     1833           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1834           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1835           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1836         .
     1837         create button v-diasize-resize-button
     1838         assign
     1839           parent        = frame Dialog-Frame :first-child
     1840           label         = "s"
     1841           height-pixels = 16
     1842           width-pixels  = 16
     1843           visible       = true
     1844           sensitive     = true
     1845           movable       = true
     1846           triggers:
     1847             on end-move persistent run diasize_end-move in this-procedure .
     1848           end triggers.
     1849         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1850         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1851         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1852         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1853         assign
     1854           v-diasize-wndmax = false
     1855         .
     1856         if connected("ub") = true
     1857         then do:
     1858           define variable v-cntxt-db-num        as integer   no-undo .
     1859           define variable v-cntxt-userid        as character no-undo .
     1860           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1861                                             , OUTPUT v-cntxt-userid
     1862                                             ) .
     1863           run gbl/wndpar_r.p
     1864             (input  v-cntxt-db-num
     1865             ,input  v-cntxt-userid
     1866             ,input  'wndmax':U
     1867             ,output v-diasize-wndmax
     1868             ,output v-default-value
     1869             ) .
     1870         end.
     1871         assign
     1872           v-diasize-wndstore = false
     1873         .
     1874         if connected("ub") = true
     1875         then do:
     1876           run gbl/wndpar_r.p
     1877             (input  v-cntxt-db-num
     1878             ,input  v-cntxt-userid
     1879             ,input  'wndstore':U
     1880             ,output v-diasize-wndstore
     1881             ,output v-default-value
     1882             ) .
     1883         end.
     1884         assign
     1885           v-diasize-proc-name = entry(1, program-name(2), '.')
     1886         .
     1887         if v-diasize-wndstore = true
     1888         then do:
     1889           assign
     1890             v-restore-saved = false
     1891           .
     1892           if connected("ub") = true
     1893           then do:
     1894             run gbl/wndsizer.p
     1895               (input  v-cntxt-db-num
     1896               ,input  v-cntxt-userid
     1897               ,input  v-diasize-proc-name
     1898               ,input  'height':u
     1899               ,output v-resize-value-str
     1900               ) .
     1901             if v-resize-value-str <> '':U
     1902             then do:
     1903               run diasize_change-height in this-procedure
     1904                 (input  integer(v-resize-value-str)
     1905                 ,input  true
     1906                 ) .
     1907               assign
     1908                 v-restore-saved = true
     1909               .
     1910             end.
     1911           end.
     1912           if connected("ub") = true
     1913           then do:
     1914             run gbl/wndsizer.p
     1915               (input  v-cntxt-db-num
     1916               ,input  v-cntxt-userid
     1917               ,input  v-diasize-proc-name
     1918               ,input  'width':u
     1919               ,output v-resize-value-str
     1920               ) .
     1921             if v-resize-value-str <> '':U
     1922             then do:
     1923               run diasize_change-width in this-procedure
     1924                 (input  integer(v-resize-value-str)
     1925                 ,input  true
     1926                 ) .
     1927               assign
     1928                 v-restore-saved = true
     1929               .
     1930             end.
     1931           end.
     1932           if v-restore-saved <> true
     1933           then do:
     1934             if v-diasize-wndmax = true
     1935             then do:
     1936               run diasize_maximize in this-procedure
     1937                 (input  true
     1938                 ) .
     1939             end.
     1940           end.
     1941         end.
     1942         else do:
     1943           if v-diasize-wndmax = true
     1944           then do:
     1945             run diasize_maximize in this-procedure
     1946               (input  true
     1947               ) .
     1948           end.
     1949         end.
     1950       end.
     1951     end.
     1952   end procedure.
     1953   procedure diasize_need-full-display :
     1954     define output parameter p-need-full-display as logical   no-undo .
     1955     do
     1956     on error undo, return error return-value
     1957     :
     1958       assign
     1959         p-need-full-display = v-diasize-need-full-display
     1960       .
     1961       assign
     1962         v-diasize-need-full-display = false
     1963       .
     1964     end.
     1965   end procedure.
     1966   procedure get-context :
     1967      define output parameter p-db-num as integer          no-undo.
     1968      define output parameter p-user-id as character        no-undo.
     1969      define variable v-login               as character    no-undo.
     1970      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1971      define buffer buf_user-login  for ub.user-login .
     1972      do
     1973      on error undo, return error
     1974      :
     1975            FIND FIRST buf_sys-ctrl no-lock.
     1976            ASSIGN
     1977               v-login = USERID("ub")
     1978               p-db-num = buf_sys-ctrl.db-num
     1979            .
     1980            FIND FIRST buf_user-login
     1981                 WHERE buf_user-login.db-num = p-db-num
     1982                   AND buf_user-login.user-login = v-login
     1983                 no-lock
     1984                 no-error
     1985                 .
     1986            IF AVAILABLE buf_user-login
     1987            THEN DO:
     1988               assign
     1989                  p-user-id = buf_user-login.user-id
     1990               .
     1991            END.
     1992      end.
     1993   end procedure.
     1994       run diasize_init in this-procedure .
     1995   assign
     1996       frame Dialog-Frame:title = "Товары >>-  " + p-name.
     1997   def var sort-labelBROWSE-2   as character no-undo .
     1998   def var sort-clmnBROWSE-2    as handle    no-undo .
     1999   def var cur-clmnBROWSE-2     as handle    no-undo .
     2000   def var cur-clmn-locBROWSE-2 as integer   no-undo .
     2001   def var re-queryBROWSE-2     as logical   initial no no-undo .
     2002   on start-search, ctrl-o of BROWSE-2 in frame Dialog-Frame do:
     2003      run sort-brBROWSE-2
     2004        (input (if available tt-gds-sea
     2005                then recid(tt-gds-sea)
     2006                else ?
     2007               )
     2008        ).
     2009   end.
     2010   PROCEDURE sort-brBROWSE-2 :
     2011     define input parameter p-recid as recid no-undo .
     2012     if re-queryBROWSE-2 = no then do:
     2013       assign
     2014          cur-clmnBROWSE-2 = BROWSE-2:current-column in frame Dialog-Frame
     2015       .
     2016       if sort-clmnBROWSE-2 <> ? then sort-clmnBROWSE-2:column-fgcolor = 0.
     2017       if cur-clmnBROWSE-2 = sort-clmnBROWSE-2 then do:
     2018         assign
     2019            sort-labelBROWSE-2 = ""
     2020            sort-clmnBROWSE-2 = ?
     2021         .
     2022        end.
     2023        else do:
     2024          assign
     2025            sort-labelBROWSE-2 = cur-clmnBROWSE-2:label
     2026            sort-clmnBROWSE-2  = cur-clmnBROWSE-2
     2027            sort-clmnBROWSE-2:column-fgcolor = 4
     2028          .
     2029        end.
     2030      end.
     2031     assign
     2032       cur-clmn-locBROWSE-2 = 1
     2033     .
     2034     def var column-handle as handle no-undo .
     2035     column-handle = BROWSE-2:first-column.
     2036     do while valid-handle(column-handle) :
     2037       if column-handle = cur-clmnBROWSE-2 then do:
     2038         leave .
     2039       end.
     2040       column-handle = column-handle:NEXT-COLUMN.
     2041       assign
     2042         cur-clmn-locBROWSE-2 = cur-clmn-locBROWSE-2 + 1
     2043       .
     2044     end.
     2045     case sort-labelBROWSE-2:
     2046           when tt-gds-sea.artic:label in browse BROWSE-2 then DO:   assign     sort-column-name = "tt-gds-sea.artic"   .   run OpenBr.   . END.
     2047           when tt-gds-sea.gds-name:label in browse BROWSE-2 then DO:   assign     sort-column-name = "tt-gds-sea.gds-name"   .   run OpenBr.   . END.
     2048           when tt-gds-sea.unit-base:label in browse BROWSE-2 then DO:   assign     sort-column-name = "tt-gds-sea.unit-base"   .   run OpenBr.   . END.
     2049           when tt-gds-sea.min-stock:label in browse BROWSE-2 then DO:   assign     sort-column-name = "tt-gds-sea.min-stock"   .   run OpenBr.   . END.
     2050       otherwise do:
     2051         assign
     2052           sort-column-name = ""
     2053         .
     2054         run OpenBr.
     2055         if sort-labelBROWSE-2 <> "" then do:
     2056           assign
     2057             cur-clmnBROWSE-2:column-fgcolor = 0
     2058           .
     2059         end.
     2060         assign
     2061           cur-clmn-locBROWSE-2 = ?
     2062         .
     2063       end.
     2064     end case.
     2065     if p-recid <> ? then do:
     2066       reposition BROWSE-2 to recid p-recid no-error.
     2067       apply "value-changed" to BROWSE-2 in frame Dialog-Frame.
     2068     end.
     2069     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     2070   END PROCEDURE.
     2071   procedure re-open-query-srt-clmnBROWSE-2:
     2072   if cur-clmnBROWSE-2 = ? then do:
     2073      run OpenBr.
     2074   end.
     2075   else do:
     2076      assign re-queryBROWSE-2 = yes.
     2077      run sort-brBROWSE-2
     2078        (input (if available tt-gds-sea
     2079                then recid(tt-gds-sea)
     2080                else ?
     2081               )
     2082        ).
     2083      assign re-queryBROWSE-2 = no.
     2084   end.
     2085   end.
     2086   ASSIGN
     2087       b-list:POPUP-MENU IN FRAME Dialog-Frame = MENU POPUP-MENU-b-list:HANDLE.
     2088   ASSIGN
     2089       b-list:MENU-MOUSE = 1.
     2090   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2091   on F9 of frame Dialog-Frame anywhere do:
     2092     if not available ub.goods then
     2093       return no-apply.
     2094     gds-rec = recid (ub.goods).
     2095     run ref/gds-form.w ( input parParentProc
     2096                         ,input 'ПРОСМОТР':U
     2097                         ,input ?
     2098                         ,input ?
     2099                         ,input ?
     2100                         ,input-output gds-rec).
     2101     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     2102     return no-apply.
     2103   end.
     2104   MAIN-BLOCK:
     2105   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2106       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2107       define variable v-seaobj   as character no-undo.
     2108       define variable v-sea-code as integer   no-undo.
     2109       define variable v-db-num   as integer   no-undo.
     2110       define variable v-longchar as longchar  no-undo .
     2111       define variable v-ok       as logical   no-undo init yes.
     2112       define buffer buf1_season for ub.season.
     2113       find first  buf_season no-lock where
     2114           buf_season.sea-code = p-sea-code and
     2115           buf_season.db-num   = p-db-num
     2116           no-error .
     2117       if not available buf_season  then return error .
     2118       find first buf_season-attr no-lock where buf_season-attr.sea-code = p-sea-code
     2119           and buf_season-attr.db-num = p-db-num
     2120           and buf_season-attr.attr-code = 'sea-obj':U
     2121           no-error.
     2122       if available buf_season-attr then
     2123           assign
     2124               v-seaobj = buf_season-attr.attr-value
     2125               .
     2126       for each buf_gds-season no-lock where buf_gds-season.sea-code = p-sea-code and buf_gds-season.db-num = p-db-num,
     2127           each buf_goods where buf_goods.gds-code = buf_gds-season.gds-code:
     2128           find first buf_gds-season-attr no-lock where buf_gds-season-attr.db-num = buf_gds-season.db-num
     2129               and buf_gds-season-attr.sea-code = buf_gds-season.sea-code
     2130               and buf_gds-season-attr.gds-code = buf_gds-season.gds-code
     2131               and buf_gds-season-attr.attr-code = 'gdssea-season-coef':U no-error.
     2132           create tt-gds-sea.
     2133           assign
     2134               tt-gds-sea.artic       = buf_goods.artic
     2135               tt-gds-sea.gds-code    = buf_goods.gds-code
     2136               tt-gds-sea.gds-name    = buf_goods.gds-name
     2137               tt-gds-sea.season-coef = if available buf_gds-season-attr then decimal (buf_gds-season-attr.attr-value) else 1
     2138               tt-gds-sea.min-stock   = buf_gds-season.min-stock
     2139               tt-gds-sea.unit-base   = buf_goods.unit-base
     2140               .
     2141           run chk-gdssea in this-procedure
     2142               ( input tt-gds-sea.gds-code,
     2143               input v-seaobj,
     2144               input buf_season.sea-month-1,
     2145               input buf_season.sea-month-2,
     2146               input rowid (buf_season),
     2147               output v-sea-code,
     2148               output v-db-num,
     2149               output v-ok) no-error.
     2150           if not v-ok then
     2151           do:
     2152               find first buf1_season no-lock where buf1_season.sea-code = v-sea-code
     2153                   and buf1_season.db-num = v-db-num
     2154                   no-error.
     2155               assign
     2156                   v-longchar          = v-longchar +
     2157             substitute ("Товар &1 &2 пересекается с сезоном &3 &4.&5", buf_goods.gds-code, buf_goods.gds-name, v-sea-code, buf1_season.sea-name, chr(10))
     2158                   v-ok                = true
     2159                   tt-gds-sea.is-inter = true
     2160                   .
     2161           end.
     2162       end.
     2163       if v-longchar <> "" then
     2164       do:
     2165           run gbl/d-longchar.w (
     2166               ?,
     2167               'Editor_row=2\':u
     2168               + 'title=Проверка товарного наполнения сезона: есть пересечения\':u
     2169               + 'Editor_col=1\':u
     2170               + 'Editor_width=96\':u
     2171               + 'Editor_height=21\':u
     2172               + 'readonly=yes\':u
     2173               ,input-output v-longchar
     2174               ,output v-ok ) no-error .
     2175           if error-status :error then message
     2176                   vss-workfile vss-revision vss-description skip
     2177                   error-status :get-message(1) skip
     2178                   return-value skip
     2179                   "4"
     2180                   view-as alert-box error
     2181                   .
     2182           assign
     2183               v-longchar = "".
     2184       end.
     2185       run enable_UI in this-procedure .
     2186       if can-find (first tt-gds-sea) then BROWSE-2:refresh().
     2187       IF BUF_SEASON.SEA-MONTH-1 = 0 THEN hide tt-gds-sea.min-stock tt-gds-sea.season-coef in browse  BROWSE-2  .
     2188       enable  s-artic with frame Dialog-Frame.
     2189       Hide      s-name  s-name-cnt in frame Dialog-Frame.
     2190       display s-artic with frame Dialog-Frame.
     2191       WAIT-FOR GO OF FRAME Dialog-Frame.
     2192   END.
     2193   run disable_UI in this-procedure .
     2194   PROCEDURE cycle-add :
     2195       define variable dct-type as character no-undo .
     2196       define variable stp-cycl as logical   no-undo .
     2197       define variable v-num    as integer   no-undo .
     2198       define variable v-flag   as logical   no-undo init false .
     2199       define buffer bb_gds-season for gds-season.
     2200       define buffer old_season    for season.
     2201       stp-cycl = false .
     2202       if buf_season.sea-month-1 = 0 then dct-type = "coll".
     2203       else dct-type = "season" .
     2204       if dct-type = "coll" then
     2205       do:
     2206           run gbl/d-askw.w
     2207               (input "Вопрос"
     2208               ,input "Если товар уже прикреплен к коллекции, пропускаем его?"
     2209               ,input "|^"
     2210               ,input "Не добавлять|Добавлять|Остановка"
     2211               ,input "Не добавляем товар в новую коллекцию, товар остается в старой коллекции|"
     2212               + "Добавляем товар в новую коллекцию и удаляем в старой коллекции|"
     2213               + "Остановить добавление товаров, если встречаются товары прикрепленные к другим коллекциям."
     2214               ,input 1
     2215               ,input 2
     2216               ,output v-num
     2217               ).
     2218           case v-num :
     2219               when 1 then
     2220                   do:
     2221                       for each tt-gds-list no-lock  by tt-gds-list.nn :
     2222                           lns-cnt  =  lns-cnt + 1 .
     2223                           if lns-cnt > 1 then assign line-mode = "ЦИКЛ":U.
     2224                           v-flag = false .
     2225                           for each   bb_gds-season no-lock where
     2226                               bb_gds-season.gds-code = tt-gds-list.gds-code  ,
     2227                               each old_season no-lock where
     2228                               old_season.sea-code = bb_gds-season.sea-code and
     2229                               old_season.db-num   = bb_gds-season.db-num   and
     2230                               old_season.sea-month-1 = 0
     2231                               :
     2232                               v-flag = true .
     2233                               leave.
     2234                           end.
     2235                           if  v-flag = false then
     2236                           do :
     2237                               find first tt-gds-sea no-lock
     2238                                   where tt-gds-sea.gds-code = tt-gds-list.gds-code
     2239                                   and tt-gds-sea.min-stock = 0 no-error.
     2240                               if not available tt-gds-sea then
     2241                               do :
     2242                                   create tt-gds-sea.
     2243                                   assign
     2244                                       tt-gds-sea.gds-code  = tt-gds-list.gds-code
     2245                                       tt-gds-sea.artic     = tt-gds-list.artic
     2246                                       tt-gds-sea.gds-name  = tt-gds-list.gds-name
     2247                                       tt-gds-sea.unit-base = tt-gds-list.unit-base
     2248                                       tt-gds-sea.min-stock = 0
     2249                                       .
     2250                               end.
     2251                           end.
     2252                           if  stp-cycl = true then leave.
     2253                       end.
     2254                   end.
     2255               when 2 then
     2256                   do:
     2257                       for each tt-gds-list no-lock  by tt-gds-list.nn :
     2258                           lns-cnt  =  lns-cnt + 1 .
     2259                           if lns-cnt > 1 then assign line-mode = "ЦИКЛ":U.
     2260                           v-flag = false .
     2261                           for each  bb_gds-season exclusive-lock  where
     2262                               bb_gds-season.gds-code = tt-gds-list.gds-code ,
     2263                               each old_season no-lock where
     2264                               old_season.sea-code = bb_gds-season.sea-code and
     2265                               old_season.db-num   = bb_gds-season.db-num   and
     2266                               old_season.sea-month-1 = 0
     2267                               :
     2268                               delete bb_gds-season .
     2269                           end.
     2270                           find first tt-gds-sea no-lock
     2271                               where tt-gds-sea.gds-code = tt-gds-list.gds-code
     2272                               and tt-gds-sea.min-stock = 0 no-error.
     2273                           if not available tt-gds-sea then
     2274                           do :
     2275                               create tt-gds-sea.
     2276                               assign
     2277                                   tt-gds-sea.gds-code  = tt-gds-list.gds-code
     2278                                   tt-gds-sea.artic     = tt-gds-list.artic
     2279                                   tt-gds-sea.gds-name  = tt-gds-list.gds-name
     2280                                   tt-gds-sea.unit-base = tt-gds-list.unit-base
     2281                                   tt-gds-sea.min-stock = 0
     2282                                   .
     2283                           end.
     2284                           if  stp-cycl = true then leave.
     2285                       end.
     2286                   end.
     2287               when 3 then
     2288                   do:
     2289                       for each tt-gds-list no-lock  by tt-gds-list.nn :
     2290                           lns-cnt  =  lns-cnt + 1 .
     2291                           if lns-cnt > 1 then assign line-mode = "ЦИКЛ":U.
     2292                           v-flag = false .
     2293                           for each   bb_gds-season no-lock where
     2294                               bb_gds-season.gds-code = tt-gds-list.gds-code  ,
     2295                               each old_season no-lock where
     2296                               old_season.sea-code = bb_gds-season.sea-code and
     2297                               old_season.db-num   = bb_gds-season.db-num   and
     2298                               old_season.sea-month-1 = 0 :
     2299                               v-flag = true .
     2300                               leave.
     2301                           end.
     2302                           if  v-flag = true  then
     2303                           do:
     2304                               leave .
     2305                           end.
     2306                           if  stp-cycl = true then leave.
     2307                       end.
     2308                       if v-flag <> true then
     2309                       do :
     2310                           for each tt-gds-list no-lock  by tt-gds-list.nn :
     2311                               find first tt-gds-sea no-lock
     2312                                   where tt-gds-sea.gds-code = tt-gds-list.gds-code
     2313                                   and tt-gds-sea.min-stock = 0 no-error.
     2314                               if not available tt-gds-sea then
     2315                               do :
     2316                                   create tt-gds-sea.
     2317                                   assign
     2318                                       tt-gds-sea.gds-code  = tt-gds-list.gds-code
     2319                                       tt-gds-sea.artic     = tt-gds-list.artic
     2320                                       tt-gds-sea.gds-name  = tt-gds-list.gds-name
     2321                                       tt-gds-sea.unit-base = tt-gds-list.unit-base
     2322                                       tt-gds-sea.min-stock = 0
     2323                                       .
     2324                               end.
     2325                           end.
     2326                       end.
     2327                   end.
     2328           end case.
     2329       end.
     2330       else
     2331       do:
     2332           define variable v-ok       as logical   no-undo.
     2333           define variable v-seaobj   as character no-undo.
     2334           define variable v-sea-code as integer   no-undo.
     2335           define variable v-db-num   as integer   no-undo.
     2336           define variable v-longchar as longchar  no-undo .
     2337           define buffer buf1_season for ub.season.
     2338           if not available buf_season then
     2339               return no-apply.
     2340           find first buf_season-attr no-lock where buf_season-attr.sea-code = p-sea-code
     2341               and buf_season-attr.db-num = p-db-num
     2342               and buf_season-attr.attr-code = 'sea-obj':U
     2343               no-error.
     2344           if available buf_season-attr then
     2345               assign
     2346                   v-seaobj = buf_season-attr.attr-value
     2347                   .
     2348           for each tt-gds-list no-lock  by tt-gds-list.nn :
     2349               lns-cnt  =  lns-cnt + 1 .
     2350               if lns-cnt > 1 then assign line-mode = "ЦИКЛ":U.
     2351               if not can-find (first tt-gds-sea where
     2352                   tt-gds-sea.gds-code = tt-gds-list.gds-code no-lock
     2353                   ) then
     2354               do:
     2355                   run chk-gdssea in this-procedure
     2356                       ( input tt-gds-list.gds-code,
     2357                       input v-seaobj,
     2358                       input buf_season.sea-month-1,
     2359                       input buf_season.sea-month-2,
     2360                       input rowid(buf_season),
     2361                       output v-sea-code,
     2362                       output v-db-num,
     2363                       output v-ok) no-error.
     2364                   if not v-ok then
     2365                   do:
     2366                       find first buf_goods no-lock where buf_goods.gds-code = tt-gds-list.gds-code no-error.
     2367                       find first buf1_season no-lock where buf1_season.sea-code = v-sea-code
     2368                           and buf1_season.db-num = v-db-num
     2369                           no-error.
     2370                       assign
     2371                           v-longchar = v-longchar +
     2372               substitute ("Товар &1 &2 пересекается с сезоном &3 &4.&5", buf_goods.gds-code, buf_goods.gds-name, v-sea-code, buf1_season.sea-name, chr(10))
     2373                           v-ok       = true
     2374                           .
     2375                       next.
     2376                   end.
     2377                   create tt-gds-sea.
     2378                   assign
     2379                       tt-gds-sea.gds-code    = tt-gds-list.gds-code
     2380                       tt-gds-sea.artic       = tt-gds-list.artic
     2381                       tt-gds-sea.gds-name    = tt-gds-list.gds-name
     2382                       tt-gds-sea.unit-base   = tt-gds-list.unit-base
     2383                       tt-gds-sea.min-stock   = 0
     2384                       tt-gds-sea.season-coef = 1
     2385                       .
     2386               end.
     2387               if  stp-cycl = true then leave.
     2388           end.
     2389           if v-longchar <> "" then
     2390           do:
     2391               run gbl/d-longchar.w (
     2392                   ?,
     2393                   'Editor_row=2\':u
     2394                   + 'title=Проверка товарного наполнения сезона: невозможно добавить товары\':u
     2395                   + 'Editor_col=1\':u
     2396                   + 'Editor_width=96\':u
     2397                   + 'Editor_height=21\':u
     2398                   + 'readonly=yes\':u
     2399                   ,input-output v-longchar
     2400                   ,output v-ok ) no-error .
     2401               if error-status :error then message
     2402                       vss-workfile vss-revision vss-description skip
     2403                       error-status :get-message(1) skip
     2404                       return-value skip
     2405                       "4"
     2406                       view-as alert-box error
     2407                       .
     2408               assign
     2409                   v-longchar = "".
     2410           end.
     2411       end.
     2412       ASSIGN
     2413           lns-cnt = lns-cnt + 1 .
     2414   end procedure.
     2415   PROCEDURE disable_UI :
     2416       HIDE FRAME Dialog-Frame.
     2417   END PROCEDURE.
     2418   PROCEDURE enable_UI :
     2419       DISPLAY R-sort s-name s-name-cnt s-artic FILL-IN-2 mark-num
     2420           WITH FRAME Dialog-Frame.
     2421       ENABLE b-exit b-add b-del b-list b-help R-sort s-artic BROWSE-2 FILL-IN-2
     2422           mark-num b-print
     2423           WITH FRAME Dialog-Frame.
     2424       VIEW FRAME Dialog-Frame.
     2425       OPEN QUERY BROWSE-2 FOR EACH tt-gds-sea       NO-LOCK     .
     2426   END PROCEDURE.
     2427   PROCEDURE OpenBr :
     2428       define variable t-ret as logical no-undo .
     2429       t-ret =  session:SET-WAIT-STATE("GENERAL") .
     2430       case sort-column-name :
     2431           when "" then
     2432               do:
     2433                       if r-sort = 3 and sch-field = "s-name-cnt" then do:     assign frame Dialog-Frame:title = "Товары >> Сезон - " + p-name + " , содержащие в названии " + s-name-cnt .    OPEN QUERY BROWSE-2 FOR EACH tt-gds-sea       WHERE INDEX(tt-gds-sea.gds-name,s-name-cnt) > 0       NO-LOCK .     end.    else DO:     assign frame Dialog-Frame:title = "Товары >> Сезон - " + p-name.    OPEN QUERY BROWSE-2 FOR EACH tt-gds-sea       NO-LOCK     .    end.
     2434               end.
     2435           when "tt-gds-sea.artic" then
     2436               do:
     2437                       if r-sort = 3 and sch-field = "s-name-cnt" then do:     assign frame Dialog-Frame:title = "Товары >> Сезон - " + p-name + " , содержащие в названии " + s-name-cnt .    OPEN QUERY BROWSE-2 FOR EACH tt-gds-sea       WHERE INDEX(tt-gds-sea.gds-name,s-name-cnt) > 0       NO-LOCK by tt-gds-sea.artic.     end.    else DO:     assign frame Dialog-Frame:title = "Товары >> Сезон - " + p-name.    OPEN QUERY BROWSE-2 FOR EACH tt-gds-sea       NO-LOCK     by tt-gds-sea.artic.    end.
     2438               end.
     2439           when "tt-gds-sea.gds-name" then
     2440               do:
     2441                       if r-sort = 3 and sch-field = "s-name-cnt" then do:     assign frame Dialog-Frame:title = "Товары >> Сезон - " + p-name + " , содержащие в названии " + s-name-cnt .    OPEN QUERY BROWSE-2 FOR EACH tt-gds-sea       WHERE INDEX(tt-gds-sea.gds-name,s-name-cnt) > 0       NO-LOCK by tt-gds-sea.gds-name.     end.    else DO:     assign frame Dialog-Frame:title = "Товары >> Сезон - " + p-name.    OPEN QUERY BROWSE-2 FOR EACH tt-gds-sea       NO-LOCK     by tt-gds-sea.gds-name.    end.
     2442               end.
     2443           when "tt-gds-sea.unit-base" then
     2444               do:
     2445                       if r-sort = 3 and sch-field = "s-name-cnt" then do:     assign frame Dialog-Frame:title = "Товары >> Сезон - " + p-name + " , содержащие в названии " + s-name-cnt .    OPEN QUERY BROWSE-2 FOR EACH tt-gds-sea       WHERE INDEX(tt-gds-sea.gds-name,s-name-cnt) > 0       NO-LOCK by tt-gds-sea.unit-base.     end.    else DO:     assign frame Dialog-Frame:title = "Товары >> Сезон - " + p-name.    OPEN QUERY BROWSE-2 FOR EACH tt-gds-sea       NO-LOCK     by tt-gds-sea.unit-base.    end.
     2446               end.
     2447           when "tt-gds-sea.min-stock" then
     2448               do:
     2449                       if r-sort = 3 and sch-field = "s-name-cnt" then do:     assign frame Dialog-Frame:title = "Товары >> Сезон - " + p-name + " , содержащие в названии " + s-name-cnt .    OPEN QUERY BROWSE-2 FOR EACH tt-gds-sea       WHERE INDEX(tt-gds-sea.gds-name,s-name-cnt) > 0       NO-LOCK by tt-gds-sea.min-stock.     end.    else DO:     assign frame Dialog-Frame:title = "Товары >> Сезон - " + p-name.    OPEN QUERY BROWSE-2 FOR EACH tt-gds-sea       NO-LOCK     by tt-gds-sea.min-stock.    end.
     2450               end.
     2451           otherwise
     2452           do:
     2453                   if r-sort = 3 and sch-field = "s-name-cnt" then do:     assign frame Dialog-Frame:title = "Товары >> Сезон - " + p-name + " , содержащие в названии " + s-name-cnt .    OPEN QUERY BROWSE-2 FOR EACH tt-gds-sea       WHERE INDEX(tt-gds-sea.gds-name,s-name-cnt) > 0       NO-LOCK .     end.    else DO:     assign frame Dialog-Frame:title = "Товары >> Сезон - " + p-name.    OPEN QUERY BROWSE-2 FOR EACH tt-gds-sea       NO-LOCK     .    end.
     2454           end.
     2455       end case.
     2456       t-ret =  session:SET-WAIT-STATE("") .
     2457       apply "HOME" to BROWSE-2 in frame Dialog-Frame.
     2458   END PROCEDURE.
     2459   PROCEDURE proc-b-list :
     2460       define input parameter loc-list-option as character no-undo.
     2461       define buffer loc-gds-season for ub.gds-season.
     2462       define variable v-sea-code        like ub.gds-season.sea-code no-undo.
     2463       define variable jj                as integer   no-undo.
     2464       define variable varrid-gds-season as recid     no-undo.
     2465       define variable f-name            as character init "default.cli" no-undo.
     2466       define variable imp-type          like ub.goods.prod-type no-undo.
     2467       define variable imp-code          like ub.goods.prod-code no-undo.
     2468       define variable loc-gds-code      like ub.gds-season.gds-code no-undo.
     2469       define variable loc-min-stock     like ub.gds-season.min-stock no-undo.
     2470       define variable loc-sea-code      like ub.gds-season.sea-code no-undo.
     2471       define variable loc-db-num        like ub.gds-season.db-num no-undo.
     2472       v-sea-code =  p-sea-code .
     2473       case loc-list-option:
     2474           when "save":U then
     2475               do:
     2476                   g#log = yes.
     2477                   message "Сохранить все товары в файле списка"
     2478                       view-as alert-box question buttons OK-Cancel update g#log.
     2479                   if not g#log then
     2480                   do:
     2481                       list-option = "":U.
     2482                       return.
     2483                   end.
     2484                   assign
     2485                       f-name = "default.sea"
     2486                       g#log  = yes
     2487                       .
     2488                   system-dialog get-file f-name
     2489                       filters "Списки товаров  *.sea" "*.sea"
     2490                       ask-overwrite
     2491                       save-as
     2492                       use-filename
     2493                       update g#log
     2494                       default-extension "sea".
     2495                   if not g#log then
     2496                   do:
     2497                       list-option = "":U.
     2498                       return.
     2499                   end.
     2500                   g#log =  session:SET-WAIT-STATE("GENERAL") .
     2501                   output stream sout to value (f-name).
     2502                   for each loc-gds-season No-LOCK WHERE
     2503                       loc-gds-season.sea-code = v-sea-code and
     2504                       loc-gds-season.db-num   = p-db-num
     2505                       :
     2506                       export stream sout
     2507                           loc-gds-season.gds-code
     2508                           loc-gds-season.min-stock
     2509                           loc-gds-season.sea-code
     2510                           loc-gds-season.db-num
     2511                           .
     2512                   END.
     2513                   output stream sout close.
     2514                   g#log =  session:SET-WAIT-STATE("") .
     2515               end.
     2516           when "load":U then
     2517               do:
     2518                   system-dialog get-file f-name
     2519                       filters "Списки клиентов *.sea" "*.sea"
     2520                       title "Выберите файл списка"
     2521                       INITIAL-DIR "."
     2522                       return-to-start-dir
     2523                       must-exist
     2524                       update g#log
     2525                       default-extension "sea".
     2526                   if not g#log then
     2527                   do:
     2528                       list-option = "":U.
     2529                       return.
     2530                   end.
     2531                   g#log =  session:SET-WAIT-STATE("GENERAL") .
     2532                   input stream sout from value (f-name).
     2533                   _repeat:
     2534                   repeat:
     2535                       import stream sout
     2536                           loc-gds-code
     2537                           loc-min-stock
     2538                           loc-sea-code
     2539                           loc-db-num
     2540                           no-error.
     2541                       find first loc-gds-season exclusive-LOCK WHERE
     2542                           loc-gds-season.gds-code = loc-gds-code  and
     2543                           loc-gds-season.sea-code = v-sea-code and
     2544                           loc-gds-season.db-num   = p-db-num
     2545                           no-error.
     2546                       if not available loc-gds-season then create loc-gds-season.
     2547                       assign
     2548                           loc-gds-season.gds-code  = loc-gds-code
     2549                           loc-gds-season.min-stock = loc-min-stock
     2550                           loc-gds-season.sea-code  = v-sea-code
     2551                           loc-gds-season.db-num    = p-db-num
     2552                           .
     2553                   end.
     2554                   run loadbrowse (input loc-gds-season.sea-code, input loc-gds-season.db-num, input '').
     2555                   input stream sout close.
     2556                   g#log =  session:SET-WAIT-STATE("") .
     2557                   OPEN QUERY BROWSE-2 FOR EACH tt-gds-sea       NO-LOCK     .
     2558               end.
     2559       END CASE.
     2560       loc-list-option = "":U.
     2561   END PROCEDURE.
     2562   procedure create-rep:
     2563       define output parameter p-filename as character no-undo.
     2564       define variable v-rls-file  as character no-undo.
     2565       define variable v-data-file as character no-undo.
     2566       define variable v-xsl-file  as character no-undo.
     2567       define variable v-tmp-file  as character no-undo.
     2568       define variable hw          as handle    no-undo.
     2569       define variable rep-out     as class     Rep-Out no-undo.
     2570       assign
     2571           v-xsl-file  = search("exe/goods-seas.xsl.html")
     2572           v-data-file = session:temp-directory + string(time) + ".xml"
     2573           v-tmp-file  = session:temp-directory + string(time) + ".html"
     2574           .
     2575       create sax-writer hw.
     2576       hw:formatted = true.
     2577       hw:set-output-destination ("file", v-data-file).
     2578       run write-data(hw) .
     2579       rep-out = new rep-out().
     2580       v-rls-file = rep-out:xsl-transform(v-data-file, v-xsl-file).
     2581       os-delete value(v-tmp-file).
     2582       os-copy value(v-rls-file) value(v-tmp-file).
     2583       os-delete value(v-rls-file).
     2584       delete object rep-out.
     2585       p-filename = v-tmp-file.
     2586   end.
     2587   procedure write-data:
     2588       define input parameter hw as handle no-undo.
     2589       hw:start-document ().
     2590       hw:start-element ("rep").
     2591       hw:start-element ("card").
     2592       hw:insert-attribute ("sea-code", if p-sea-code = ? then "" else  string(p-sea-code) ).
     2593       hw:insert-attribute ("db-num", if p-db-num = ? then "" else  string(p-db-num) ).
     2594       hw:insert-attribute ("name", if p-name = ? then "" else  string(p-name) ).
     2595       for each tt-gds-sea no-lock:
     2596           hw:start-element ("line").
     2597           hw:insert-attribute ("gds-artic",if tt-gds-sea.artic = ? then "" else string(tt-gds-sea.artic)).
     2598           hw:insert-attribute ("gds-name",if tt-gds-sea.gds-name = ? then "" else  string(tt-gds-sea.gds-name) ).
     2599           hw:insert-attribute ("unit-base",if tt-gds-sea.unit-base = ? then "" else string(tt-gds-sea.unit-base)).
     2600           hw:insert-attribute ("min-stock",if tt-gds-sea.min-stock = ? then "" else string(tt-gds-sea.min-stock,"->>>,>>9.999")).
     2601           hw:insert-attribute ("season-coef",if tt-gds-sea.season-coef = ? then "" else string(tt-gds-sea.season-coef,"->>>,>>9.999")).
     2602           hw:insert-attribute ("gds-code",if tt-gds-sea.gds-code = ? then "" else string(tt-gds-sea.gds-code)).
     2603           hw:end-element ("line").
     2604       end.
     2605       hw:end-element ("card").
     2606       hw:end-element ("rep").
     2607       hw:end-document ().
     2608   end.
     2609   procedure loadbrowse :
     2610       define input parameter p2-sea-code   like ub.season.sea-code no-undo.
     2611       define input parameter p2-db-num like ub.season.db-num no-undo.
     2612       define input parameter p2-name   like ub.season.sea-name no-undo.
     2613       define buffer tt-gds-sea2 for tt-gds-sea.
     2614       define variable v2-sea-code as integer.
     2615       define variable v2-db-num   as integer.
     2616       define variable v2-ok       as logical.
     2617       define variable v2-longchar as char.
     2618       define buffer buf2_season for season.
     2619      for each tt-gds-sea:
     2620          delete tt-gds-sea.
     2621          end.
     2622       find first  buf2_season no-lock where
     2623           buf2_season.sea-code = p2-sea-code and
     2624           buf2_season.db-num   = p2-db-num
     2625           no-error .
     2626       if not available buf2_season  then return error .
     2627       find first buf_season-attr no-lock where buf_season-attr.sea-code = p2-sea-code
     2628           and buf_season-attr.db-num = p2-db-num
     2629           and buf_season-attr.attr-code = 'sea-obj':U
     2630           no-error.
     2631       if available buf_season-attr then
     2632           assign
     2633               v-seaobj = buf_season-attr.attr-value
     2634               .
     2635       for each buf_gds-season no-lock where buf_gds-season.sea-code = p2-sea-code and buf_gds-season.db-num = p2-db-num,
     2636           each buf_goods where buf_goods.gds-code = buf_gds-season.gds-code:
     2637           find first buf_gds-season-attr no-lock where buf_gds-season-attr.db-num = buf_gds-season.db-num
     2638               and buf_gds-season-attr.sea-code = buf_gds-season.sea-code
     2639               and buf_gds-season-attr.gds-code = buf_gds-season.gds-code
     2640               and buf_gds-season-attr.attr-code = 'gdssea-season-coef':U no-error.
     2641           if not available buf_gds-season-attr then
     2642           do:
     2643               create tt-gds-sea2.
     2644               assign
     2645                   tt-gds-sea2.artic       = buf_goods.artic
     2646                   tt-gds-sea2.gds-code    = buf_goods.gds-code
     2647                   tt-gds-sea2.gds-name    = buf_goods.gds-name
     2648                   tt-gds-sea2.season-coef = if available buf_gds-season-attr then decimal (buf_gds-season-attr.attr-value) else 1
     2649                   tt-gds-sea2.min-stock   = buf_gds-season.min-stock
     2650                   tt-gds-sea2.unit-base   = buf_goods.unit-base
     2651                   .
     2652           end.
     2653           run chk-gdssea in this-procedure
     2654               ( input tt-gds-sea2.gds-code,
     2655               input v-seaobj,
     2656               input buf2_season.sea-month-1,
     2657               input buf2_season.sea-month-2,
     2658               input rowid (buf2_season),
     2659               output v2-sea-code,
     2660               output v2-db-num,
     2661               output v2-ok) no-error.
     2662           if not v2-ok then
     2663           do:
     2664               find first buf2_season no-lock where buf2_season.sea-code = v2-sea-code
     2665                   and buf2_season.db-num = v2-db-num
     2666                   no-error.
     2667               assign
     2668                   v2-longchar         = v2-longchar +
     2669             substitute ("Товар &1 &2 пересекается с сезоном &3 &4.&5", buf_goods.gds-code, buf_goods.gds-name, v2-sea-code, buf2_season.sea-name, chr(10))
     2670                   v2-ok               = true
     2671                   tt-gds-sea2.is-inter = true
     2672                   .
     2673           end.
     2674       end.
     2675   end procedure.
     2676   procedure open-ie:
     2677       define input parameter p-filename as character no-undo.
     2678       define variable o-IE as com-handle no-undo.
     2679       create "InternetExplorer.Application" o-IE.
     2680       o-IE:addressbar = false.
     2681       o-IE:Navigate(p-filename).
     2682       o-IE:visible = true.
     2683       release object o-IE.
     2684   end.
