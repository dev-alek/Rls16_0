      357       END.
      358   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      359       DO:
      360   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   do:
      362     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      363       (input  v-cntxt-db-num
      364       ,input  v-cntxt-userid
      365       ,input  0
      366       ,input  'actn_collection_add-def':U
      367       ,input  'global':U
      368       ,input  0
      369       ,input  '':U
      370       ,input  0
      371       ,input  0
      372       ,input  0
      373       ,input  0
      374       ,input  true
      375       ,output v-log
      376       )  .
      377   end.
      378           if not v-log then return no-apply .
      379           assign
      380               line-mode = 'ДОБАВЛЕНИЕ':U
      381               .
      382           run str/chsgdsls.w
      383               (   input parParentProc ,
      384               input "season" ,
      385               input "Сезон " + p-name  ,
      386               input ? ,
      387               input ? ,
      388               input v-cntxt-host-code-obj,
      389               input-output varschartic,
      390               output ref-list,
      391               output table tt-gds-list,
      392               false )
      393               .
      394           if ref-list <> "" then
      395           do:
      396               run cycle-add in this-procedure no-error.
      397               if error-status:error then
      398               do:
      399                   message
      400                       vss-workfile vss-revision vss-description skip
      401                       "Ошибка при вызове процедуры создания товара" skip
      402                       error-status :get-message(1) skip
      403                       return-value skip
      404                       view-as alert-box error .
      405                   return no-apply.
      406               end.
      407               OPEN QUERY BROWSE-2 FOR EACH tt-gds-sea       NO-LOCK     .
      408           end.
      409           for each tt-gds-sea no-lock:
      410               find first buf_gds-season exclusive-lock where buf_gds-season.sea-code = p-sea-code
      411                   and buf_gds-season.db-num = p-db-num
      412                   and buf_gds-season.gds-code = tt-gds-sea.gds-code no-error.
      413               find first buf_gds-season-attr exclusive-lock where buf_gds-season-attr.sea-code = p-sea-code
      414                   and buf_gds-season-attr.db-num = p-db-num
      415                   and buf_gds-season-attr.gds-code = tt-gds-sea.gds-code
      416                   and buf_gds-season-attr.attr-code = 'gdssea-season-coef':U no-error.
      417               if not available buf_gds-season then
      418               do:
      419                   create buf_gds-season.
      420                   assign
      421                       buf_gds-season.sea-code = p-sea-code
      422                       buf_gds-season.db-num   = p-db-num
      423                       buf_gds-season.gds-code = tt-gds-sea.gds-code
      424                       .
      425               end.
      426               assign
      427                   buf_gds-season.min-stock = tt-gds-sea.min-stock
      428                   .
      429               if tt-gds-sea.season-coef <> 0 and tt-gds-sea.season-coef <> ? and tt-gds-sea.season-coef <> 1 then
      430               do:
      431                   if not available buf_gds-season-attr then
      432                       create buf_gds-season-attr.
      433                   assign
      434                       buf_gds-season-attr.sea-code   = p-sea-code
      435                       buf_gds-season-attr.db-num     = p-db-num
      436                       buf_gds-season-attr.gds-code   = tt-gds-sea.gds-code
      437                       buf_gds-season-attr.attr-code  = 'gdssea-season-coef':U
      438                       buf_gds-season-attr.attr-value = string (tt-gds-sea.season-coef)
      439                       .
      440               end.
      441               else
      442               do:
      443                   if available buf_gds-season-attr then delete buf_gds-season-attr.
      444               end.
      445           end.
      446       END.
