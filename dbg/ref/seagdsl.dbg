      451                   and buf_gds-season.db-num = p-db-num
      452                   and buf_gds-season.gds-code = tt-gds-sea.gds-code no-error.
      453               find first buf_gds-season-attr exclusive-lock where buf_gds-season-attr.sea-code = p-sea-code
      454                   and buf_gds-season-attr.db-num = p-db-num
      455                   and buf_gds-season-attr.gds-code = tt-gds-sea.gds-code
      456                   and buf_gds-season-attr.attr-code = 'gdssea-season-coef':U no-error.
