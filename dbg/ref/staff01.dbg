        1   block-level on error undo, throw.
        2   define input-output parameter p-rid      as recid no-undo.
        3   define input parameter p-mode            as character no-undo .
        4   define input parameter p-silent          as logical no-undo .
        5   define input parameter p-role            as character no-undo .
        6   define input parameter p-staff-code      as integer no-undo .
        7   define input parameter p-psn-code        like  ub.person.psn-code      no-undo .
        8   define input parameter p-level           as character no-undo .
        9   define input parameter p-date-start      like ub.staff.date-start no-undo .
       10   define input parameter p-date-end        like ub.staff.date-end no-undo .
       11   define input parameter p-db-num          like ub.db.db-num no-undo .
       12   define input parameter p-host-code       like ub.sysconf.host-code no-undo .
       13   define input parameter p-obj-type        like ub.clients.obj-type no-undo .
       14   define input parameter p-obj-code        like ub.clients.obj-code no-undo .
       15   define input parameter p-work-place      as character no-undo .
       16   define input parameter p-password        as character no-undo .
       17   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       18   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       19   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       20   define variable vss-workfile    as character no-undo init "$Workfile: staff01.p $":U .
       21   define variable vss-archive     as character no-undo init "$Archive: ref/staff01.p $":U .
       22   define variable vss-description as character no-undo init "Сохранение изменений в карточке персонала".
       23   procedure vss-get-info :
       24     define output parameter p-vss-revision    like vss-revision    no-undo .
       25     define output parameter p-vss-author      like vss-author      no-undo .
       26     define output parameter p-vss-date        like vss-date        no-undo .
       27     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       28     define output parameter p-vss-archive     like vss-archive     no-undo .
       29     define output parameter p-vss-description like vss-description no-undo .
       30     assign
       31       p-vss-revision    = vss-revision
       32       p-vss-author      = vss-author
       33       p-vss-date        = vss-date
       34       p-vss-workfile    = vss-workfile
       35       p-vss-archive     = vss-archive
       36       p-vss-description = vss-description
       37     .
       38   end procedure.
       39   procedure vss-get-parameters :
       40     define output parameter p-vss-parameters as character no-undo .
       41   end procedure.
       42   define new global shared variable g#vssrevis-logger as handle    no-undo .
       43   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       44   define variable v-vssrevis-logger                   as handle    no-undo .
       45   procedure vss-logevent :
       46     define input  parameter p-extra-paramters as character no-undo .
       47     define variable v-vssrevis-parameters as character no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51       if  valid-handle(v-vssrevis-logger)
       52       and v-vssrevis-logger :get-signature("logevent") <> ""
       53       then do:
       54         run vss-get-parameters in this-procedure
       55           (output v-vssrevis-parameters
       56           ).
       57         run logevent in v-vssrevis-logger
       58           (input vss-workfile
       59           ,input vss-revision
       60           ,input v-vssrevis-parameters
       61           ,input p-extra-paramters
       62           ).
       63       end.
       64     end.
       65   end procedure.
       66   assign
       67     v-vssrevis-logger = g#vssrevis-logger
       68   .
       69   if  valid-handle(v-vssrevis-logger)
       70   and v-vssrevis-logger :get-signature("logevent") <> ""
       71   then do:
       72     assign
       73       v-vssrevis-logevent = true
       74     .
       75     run vss-logevent in this-procedure (input vss-description) .
       76   end.
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   define new global shared variable g#library  as handle no-undo .
       82   define new global shared variable g#library2 as handle no-undo .
       83   define   shared variable g#auto as logical no-undo.
       84   define   shared variable g#news as logical no-undo.
       85   define   shared variable g#oxml as logical no-undo.
       86   define   shared variable g#esys as logical no-undo.
       87   define   shared variable g#news-source-db as integer no-undo.
       88   define   shared variable g#esys-source-esys as integer no-undo.
       89   define   shared variable g#db-num as integer   no-undo .
       90   define   shared variable g#userid as character no-undo .
       91   define   shared variable g#passwd as character no-undo .
       92   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   define variable v-waitfram-action01         as character   no-undo .
       94   define variable v-waitfram-action02         as character   no-undo .
       95   define variable v-waitfram-action03         as character   no-undo .
       96   define variable mWaitFramTextBeg            as character   no-undo.
       97   define variable mWaitFramTextEnd            as character   no-undo.
       98   define variable mWaitFramView               as logical     no-undo.
       99   define variable mWaitProcEvent              as logical     no-undo init yes.
      100   define variable mWaitFramInterval           as integer     no-undo init 1 .
      101   define variable mWaitFramStop               as logical     no-undo.
      102   define variable mWaitFramStopUser           as logical     no-undo.
      103   define variable mWaitFramStopTimeOut        as logical     no-undo.
      104   define variable mWaitFramStartProc          as datetime-tz no-undo.
      105   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      106   define button B-WaitFramStop auto-end-key
      107        label "Стоп"
      108        size 10 by 1 tooltip "Остоновить процесс".
      109   define button B-viewProcInfo
      110        label "Информация"
      111        size 15 by 1 tooltip "Информация о процесс".
      112   define frame waitfram
      113     v-waitfram-action01 format "x(72)" no-label skip
      114     v-waitfram-action02 format "x(72)" no-label skip
      115     v-waitfram-action03 format "x(72)" no-label skip
      116     B-viewProcInfo
      117     B-WaitFramStop at row 4 col 30
      118     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      119     .
      120   define new global shared variable mBatchMode as logical no-undo init ?.
      121   define variable mFramBachModHandle as handle no-undo.
      122   mFramBachModHandle = frame waitfram:handle.
      123   define variable mFameOldVis as logical no-undo.
      124   define variable mVisCUrentVin as logical no-undo.
      125   if session:batch-mode
      126   then
      127      mBatchMode = yes.
      128   if mBatchMode = ? then do:
      129     mVisCUrentVin = current-window:visible.
      130     mFameOldVis = mFramBachModHandle:visible.
      131     mFramBachModHandle:visible  = yes.
      132     mBatchMode = mFramBachModHandle:visible ne yes.
      133     mFramBachModHandle:visible = mFameOldVis.
      134     current-window:visible = mVisCUrentVin.
      135   end.
      136    if  log-manager:logfile-name ne ?
      137     then DO:
      138         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      139         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      140         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      141     end.
      142   on choose of B-WaitFramStop in frame waitfram
      143   do:
      144     mWaitFramStop = yes.
      145     mWaitFramStopUser = yes.
      146   end.
      147   function waitfram-check-timeout returns logical():
      148      define variable vtime as int64 no-undo.
      149      if mWaitFramStopTimeOut
      150      then
      151         return yes.
      152      vtime = ( now - mWaitFramStartProc ) / 1000 .
      153      if     mWaitFramTimeOut ne ?
      154         and mWaitFramTimeOut ne 0
      155         and mWaitFramTimeOut lt vtime
      156      then do:
      157         mWaitFramStopTimeOut = yes.
      158      end.
      159      return mWaitFramStopTimeOut.
      160   end.
      161   procedure waitfram-hide :
      162     if not session:batch-mode
      163     then do
      164     on error undo, return error return-value
      165     :
      166       pause 0 before-hide .
      167       if not mBatchMode then
      168         hide frame waitfram .
      169     if     not mWaitFramView
      170        and mWaitProcEvent
      171     then
      172       process events .
      173     end.
      174   end procedure.
      175   procedure waitfram-show :
      176     define input  parameter p-message as character no-undo .
      177     define variable v-left-margin as integer   no-undo .
      178     if not session:batch-mode
      179     then do
      180     on error undo, return error return-value
      181     :
      182       if length(p-message) <= 70 then do:
      183         assign
      184           v-left-margin = integer((70 - length(p-message)) / 2)
      185         .
      186         assign
      187           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      188         .
      189         assign
      190           v-waitfram-action01 = " "
      191           v-waitfram-action02 = " "
      192                                    + fill(" ", v-left-margin)
      193                                    + p-message
      194           v-waitfram-action03 = " "
      195         .
      196       end.
      197       else do:
      198         define variable vRindex1 as integer no-undo.
      199         define variable vRindex2 as integer no-undo.
      200         vRindex1 = r-index(p-message," ",70).
      201         if vRindex1 = 0
      202         then
      203            vRindex1 = 70.
      204         if length(p-message)  <= vRindex1 + 70 then do:
      205           assign
      206             v-waitfram-action01 = " "
      207             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      208             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      209           .
      210         end.
      211         else do:
      212           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      213           if vRindex2 <= vRindex1
      214           then
      215              vRindex2 = vRindex1 + 70.
      216           assign
      217             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      218             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      219             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      220           .
      221         end.
      222       end.
      223       B-viewProcInfo:visible   in frame waitfram = no.
      224       B-viewProcInfo:sensitive in frame waitfram = no.
      225       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      226       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      227       if  (   mWaitFramView
      228          or  mWaitProcEvent)
      229          and not mBatchMode
      230       then
      231          display
      232             v-waitfram-action01 skip
      233             v-waitfram-action02 skip
      234             v-waitfram-action03 skip
      235          with frame waitfram .
      236       if     mWaitFramView
      237          then do:
      238             if     mWaitFramInterval ne ?
      239                and not mBatchMode
      240             then
      241                wait-for go of frame waitfram pause mWaitFramInterval.
      242          end.
      243          else
      244             if     mWaitProcEvent
      245                and not mBatchMode
      246             then
      247                process events .
      248     end.
      249   end procedure.
      250      procedure waitfram-show-this:
      251         define input  parameter iInterval as int64 no-undo.
      252         define variable vtime as int64 no-undo.
      253         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      254         mWaitFramInterval = iInterval.
      255         run waitfram-show (substitute("&1&2 &3&4" ,
      256                                       mWaitFramTextBeg ,
      257                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      258                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      259                                       mWaitFramTextEnd
      260                                      )
      261                           ).
      262      end.
      263      procedure WaitFramRunPause:
      264         define input  parameter iInterval as dec no-undo.
      265         define variable vStart  as datetime-tz no-undo.
      266         define variable vend    as datetime-tz no-undo.
      267         define variable vint as int64 no-undo.
      268         define variable vOk as logical no-undo.
      269         vStart = now.
      270         vend   = vStart.
      271         publish "WaitFramPause" (iInterval,output vOk).
      272         vend   =  now.
      273         vint = vend - vStart.
      274         vint = iInterval - vint / 1000.
      275         if     not mWaitFramStop
      276            and (   vint > 0
      277                 or (    not vOk
      278                     and iInterval eq ?
      279                     )
      280                 )
      281         then
      282            run waitfram-show-this (iInterval).
      283         vend   =  now.
      284         vint = vend - vStart.
      285         vint = iInterval - vint / 1000.
      286         if     not mWaitFramStop
      287            and vint > 0
      288         then do:
      289            run gbl/pause.p (vint * 1000).
      290         end.
      291         if iInterval ne ?
      292         then
      293            publish "WaitFramStop".
      294         waitfram-check-timeout().
      295      end.
      296      procedure WaitFramWaitFor:
      297         define input  parameter iInterval as dec no-undo.
      298         assign
      299            mWaitFramStartProc   = now
      300            mWaitFramStopUser    = no
      301            mWaitFramStopTimeOut = no
      302         .
      303         block-wait:
      304         do while not mWaitFramStop:
      305            run WaitFramRunPause (iInterval).
      306            if  waitfram-check-timeout()
      307            then do:
      308               leave block-wait.
      309            end.
      310         end.
      311         run waitfram-hide.
      312      end.
      313   procedure waitfram-join :
      314     define input  parameter p-line-1  as character no-undo .
      315     define input  parameter p-line-2  as character no-undo .
      316     define input  parameter p-line-3  as character no-undo .
      317     define output parameter p-message as character no-undo .
      318     do
      319     on error undo, return error return-value
      320     :
      321       assign
      322         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      323                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      324                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      325       .
      326     end.
      327   end procedure.
      328   function waitfram-join-function returns character
      329     (input p-line-1 as character
      330     ,input p-line-2 as character
      331     ,input p-line-3 as character
      332     ).
      333     define variable v-message as character no-undo .
      334     run waitfram-join in this-procedure
      335       (input  p-line-1
      336       ,input  p-line-2
      337       ,input  p-line-3
      338       ,output v-message
      339       ) .
      340     return v-message .
      341   end function .
      342   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      343   procedure cur-time :
      344      define output parameter p-today as date      no-undo .
      345      define output parameter p-time  as integer   no-undo .
      346     do
      347     on error undo, return error
      348     :
      349       define variable v-date1 as date      no-undo .
      350       define variable v-date2 as date      no-undo .
      351       define variable v-time  as integer   no-undo .
      352       assign
      353         v-date1 = today
      354         v-time  = time
      355         v-date2 = today
      356       .
      357       if v-date1 <> v-date2
      358       then do:
      359         assign
      360           v-date1 = today
      361           v-time  = v-time
      362         .
      363       end.
      364       assign
      365         p-today = v-date1
      366         p-time  = v-time
      367       .
      368     end.
      369   end.
      370   function cur-time-date returns character
      371   :
      372     return string(today, '99/99/9999':U) .
      373   end.
      374   function cur-time-mjd returns decimal
      375   :
      376     define variable v-date as date      no-undo .
      377     define variable v-time as integer   no-undo .
      378     run cur-time in this-procedure
      379       (output v-date
      380       ,output v-time
      381       ) .
      382     return integer(v-date) - 2400002 + (v-time / 86400) .
      383   end.
      384   function cur-time-get-ending-index returns integer
      385   (input p-number as integer
      386   )
      387   :
      388     if p-number < 0
      389     or p-number = ?
      390     then do:
      391       return 1 .
      392     end.
      393     define variable v-rest as integer   no-undo .
      394     assign
      395       p-number = p-number modulo 100
      396     .
      397     if p-number < 20
      398     then do:
      399       assign
      400         v-rest = p-number
      401       .
      402     end.
      403     else do:
      404       assign
      405         v-rest = p-number modulo 10
      406       .
      407     end.
      408     case v-rest :
      409       when 1
      410       then do:
      411         return 2 .
      412       end.
      413       when 2 or
      414       when 3 or
      415       when 4
      416       then do:
      417         return 3 .
      418       end.
      419       otherwise do:
      420         return 1 .
      421       end.
      422     end case .
      423   end.
      424   procedure cur-time-mjd-to-date :
      425      define input  parameter i-mjd-diff as decimal no-undo.
      426      define output parameter o-Date     as date    no-undo.
      427      define output parameter o-Time     as integer no-undo.
      428      define variable v-day-number as integer   no-undo .
      429      if    i-mjd-diff < 0
      430         or i-mjd-diff = ?
      431      then do:
      432         return "?" .
      433      end.
      434      assign
      435         v-day-number = truncate(i-mjd-diff,0).
      436         o-Date = date(v-day-number + 2400002).
      437         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      438     .
      439   end.
      440   function cur-time-mjd-to-string returns character
      441   (input p-mjd-diff as decimal
      442   )
      443   :
      444     define variable v-day-number as integer   no-undo .
      445     define variable v-seconds    as integer   no-undo .
      446     define variable v-hour       as integer   no-undo .
      447     define variable v-min        as integer   no-undo .
      448     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      449     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      450     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      451     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      452     if p-mjd-diff < 0
      453     or p-mjd-diff = ?
      454     then do:
      455       return "?" .
      456     end.
      457     assign
      458       v-day-number = integer(truncate(p-mjd-diff,0))
      459       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      460     .
      461     if v-seconds > 86400
      462     then do:
      463       assign
      464         v-seconds = 86400 - 1
      465       .
      466     end.
      467     if v-seconds < 0
      468     then do:
      469       assign
      470         v-seconds = 0
      471       .
      472     end.
      473     assign
      474       v-hour = truncate(v-seconds / 3600, 0)
      475     .
      476     assign
      477       v-seconds = v-seconds modulo 3600
      478     .
      479     assign
      480       v-min = truncate(v-seconds / 60, 0)
      481     .
      482     assign
      483       v-seconds = v-seconds modulo 60
      484     .
      485     return
      486         (if v-day-number <> 0
      487           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      488           else ""
      489         )
      490       + (if v-day-number <> 0 or v-hour <> 0
      491           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      492           else ""
      493         )
      494       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      495           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      496           else ""
      497         )
      498       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      499       .
      500   end.
      501   function cur-time-string returns character
      502   :
      503     define variable v-date as date      no-undo .
      504     define variable v-time as integer   no-undo .
      505     run cur-time in this-procedure
      506       (output v-date
      507       ,output v-time
      508       ) .
      509     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      510   end.
      511   function cur-time-string-sec returns character
      512   :
      513     define variable v-date as date      no-undo .
      514     define variable v-time as integer   no-undo .
      515     run cur-time in this-procedure
      516       (output v-date
      517       ,output v-time
      518       ) .
      519     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      520   end.
      521   function cur-time-custom  returns character
      522   (input p-prefix as character
      523   ,input p-date-format as character
      524   ,input p-delimiter as character
      525   ,input p-time-format as character
      526   ,input p-suffix as character
      527   )
      528   :
      529     define variable v-date as date      no-undo .
      530     define variable v-time as integer   no-undo .
      531     run cur-time in this-procedure
      532       (output v-date
      533       ,output v-time
      534       ) .
      535     return
      536       p-prefix
      537       + string(v-date, p-date-format)
      538       + p-delimiter
      539       + string(v-time, p-time-format)
      540       + p-suffix
      541       .
      542   end.
      543   function cur-time-print  returns character
      544   :
      545     define variable v-date as date      no-undo .
      546     define variable v-time as integer   no-undo .
      547     run cur-time in this-procedure
      548       (output v-date
      549       ,output v-time
      550       ) .
      551     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      552   end.
      553   function cur-time-datetime returns datetime
      554   :
      555     define variable v-char as character no-undo .
      556     define variable v-datetime as datetime no-undo .
      557     v-char = cur-time-string().
      558     v-datetime = datetime(v-char).
      559     return  v-datetime.
      560   end.
      561   function cur-time-string-msec returns character
      562   :
      563     define variable v-date as datetime  no-undo .
      564     v-date = now.
      565     return string(v-date) .
      566   end.
      567   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      568   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      569                                                       ,input p-range-type as character
      570                                                       ,input p-code as integer):
      571   define variable v-seq-val as integer no-undo .
      572   define buffer buf_code-range for ub.code-range.
      573   find first buf_code-range no-lock where
      574             buf_code-range.db-num = p-db-num
      575       and  buf_code-range.range-type = p-range-type
      576       and  buf_code-range.stts = 'u'
      577       and buf_code-range.first-code <= p-code
      578       and buf_code-range.last-code >= p-code no-error .
      579   if available buf_code-range then return yes.
      580   CASE p-range-type:
      581     when 'pngb':U then do:
      582       v-seq-val = current-value(s-pngb-code, ub).
      583     end.
      584     when 'fmgb':U then do:
      585       v-seq-val = current-value(s-fmgb-code, ub).
      586     end.
      587   END CASE.
      588   if p-code <= v-seq-val then do:
      589     find first buf_code-range no-lock where
      590               buf_code-range.db-num = p-db-num
      591         and  buf_code-range.range-type = p-range-type
      592         and  buf_code-range.stts = 'a'
      593         and buf_code-range.first-code <= p-code
      594         no-error .
      595    if available buf_code-range then return yes.
      596   end.
      597   find first buf_code-range no-lock where
      598             buf_code-range.db-num = p-db-num
      599       and  buf_code-range.range-type = p-range-type
      600       and  buf_code-range.stts = 'f'
      601       and buf_code-range.first-code <= p-code
      602       and buf_code-range.last-code >= p-code
      603       no-error .
      604   if available buf_code-range then return yes.
      605   return no.
      606   END FUNCTION.
      607   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      608                                                       ,input p-range-type as character
      609                                                       ,input p-code as integer):
      610   define variable v-seq-val as integer no-undo .
      611   define buffer buf_code-range for ub.code-range.
      612   CASE p-range-type:
      613     when 'pngb':U then do:
      614       v-seq-val = current-value(s-pngb-code, ub).
      615     end.
      616     when 'fmgb':U then do:
      617       v-seq-val = current-value(s-fmgb-code, ub).
      618     end.
      619   END CASE.
      620   if p-code <= v-seq-val then do:
      621     find first buf_code-range no-lock where
      622               buf_code-range.db-num = p-db-num
      623         and  buf_code-range.range-type = p-range-type
      624         and buf_code-range.first-code <= p-code
      625         and buf_code-range.last-code >= p-code no-error .
      626     if available buf_code-range then return yes.
      627   end.
      628   return no.
      629   END FUNCTION.
      630   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      631                                                       ,input p-db-num as integer
      632                                                       ,input p-staff-code as integer
      633                                                       ,input p-date as date
      634                                                        ):
      635   define buffer buf_staff for ub.staff.
      636   if p-date = ? then do:
      637     p-date = today .
      638   end.
      639   find first buf_staff no-lock where
      640             buf_staff.role = p-role
      641         and buf_staff.role-level = 'db':U
      642         and buf_staff.db-num = p-db-num
      643         and buf_staff.staff-code = p-staff-code
      644         and buf_staff.date-end >= p-date use-index pi  no-error .
      645   if available buf_staff then do:
      646     return buf_staff.psn-code.
      647   end.
      648   return 0.
      649   end FUNCTION.
      650   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      651                                                             ,input p-db-num as integer
      652                                                             ,input p-date as date
      653                                                                 ):
      654   define buffer buf_staff for ub.staff.
      655   define buffer buf2_staff for ub.staff.
      656   if p-date = ? then do:
      657     p-date = today .
      658   end.
      659   for each  buf_staff no-lock where
      660             buf_staff.role = p-role
      661         and buf_staff.db-num = p-db-num,
      662   first buf2_staff no-lock where
      663         buf2_staff.role = p-role
      664     and buf2_staff.role-level = 'db':U
      665     and buf2_staff.staff-code = buf_staff.staff-code
      666     and buf2_staff.date-start <= p-date
      667     and buf2_staff.date-end >= p-date
      668   by buf_staff.staff-code
      669   by date-start descending:
      670     return buf_staff.staff-code.
      671   end.
      672   end FUNCTION.
      673   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      674                                                  ,input p-db-num as integer
      675                                                  ,input p-psn-code as integer
      676                                                  ,input p-date as date
      677                                                  ,output p-c-password as character
      678                                                        ):
      679   define buffer buf_staff for ub.staff.
      680   if p-date = ? then do:
      681     p-date = today .
      682   end.
      683   find first buf_staff no-lock where
      684             buf_staff.role = p-role
      685         and buf_staff.role-level = 'db':U
      686         and buf_staff.db-num = p-db-num
      687        and buf_staff.date-end >= p-date
      688        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      689   if available buf_staff
      690   then do:
      691     assign
      692     p-c-password = buf_staff.password.
      693     return buf_staff.staff-code.
      694   end.
      695   p-c-password = ''.
      696   return 0.
      697   end FUNCTION.
      698   FUNCTION gbclcode-is-psn-role returns integer (
      699                                                 input p-role as character
      700                                                 ,input p-psn-code as integer
      701                                                 ,input p-date as date
      702                                                     ):
      703   define buffer buf_staff for ub.staff.
      704   if p-date = ? then do:
      705     p-date = today .
      706   end.
      707   for each buf_staff no-lock where
      708             buf_staff.psn-code = p-psn-code
      709        and  buf_staff.role = p-role
      710   by buf_staff.role-level
      711   by buf_staff.date-start
      712        :
      713     if  buf_staff.date-start <= p-date and
      714     buf_staff.date-end >= p-date  then do:
      715       return buf_staff.staff-code.
      716     end.
      717   end.
      718   return 0.
      719   end FUNCTION.
      720   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      721   define variable v-role-name as character no-undo .
      722   assign
      723   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      724   no-error .
      725   return v-role-name.
      726   END.
      727   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      728   FUNCTION gbclcode-get-position returns character ( input p-role as character
      729                                                     ,input p-role-level as character
      730                                                     ,input p-work-place as character
      731                                                     ,input p-staff-code as integer
      732                                                                ):
      733   define variable v-role-name as character no-undo .
      734   define variable v-role-level as character no-undo .
      735   define variable v-staff-code as integer no-undo .
      736   assign
      737   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      738   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      739   v-staff-code = p-staff-code
      740   no-error .
      741   return substitute("&1, &2, Код &3"
      742                   ,v-role-name
      743                   ,v-role-level
      744                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      745   END.
      746   FUNCTION gbclcode-get-work-place returns character (
      747                                                   input p-role as character
      748                                                  ,input p-role-level as character
      749                                                  ,input p-db-num as integer
      750                                                  ,input p-host-code as integer
      751                                                  ,input p-obj-type as character
      752                                                  ,input p-obj-code as integer
      753                                                  ) :
      754   define variable v-work-place as character no-undo .
      755   define variable v-obj-type as character no-undo .
      756     case p-role-level:
      757       when 'db':U then do:
      758         v-work-place = string(p-db-num, "99999").
      759       end.
      760       when 'firm':U then do:
      761         v-work-place = string(p-host-code, "99999").
      762       end.
      763       when 'object':U then do:
      764         assign
      765         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      766         .
      767       end.
      768     END CASE.
      769     return v-work-place.
      770   END FUNCTION.
      771   FUNCTION gbclcode-get-level-last-code returns integer (
      772                                                           input p-role as character
      773                                                         , input p-role-level as character
      774                                                         , input p-work-place as character
      775                                                         , input p-date-start as date
      776                                                         ):
      777   DEFINE VARIABLE v-today as date no-undo .
      778   define buffer buf_staff for ub.staff.
      779   if p-work-place = chr(63) then return ?.
      780   if p-date-start = ? then do:
      781     v-today = today .
      782   end.
      783   else do:
      784     v-today = p-date-start.
      785   end.
      786   find last buf_staff no-lock where
      787             buf_staff.role = p-role
      788        and  buf_staff.role-level = p-role-level
      789        and  buf_staff.work-place = p-work-place
      790        and  buf_staff.date-start <= v-today + 1
      791        and  buf_staff.date-end >= v-today + 1
      792        use-index pi  no-error .
      793   if available buf_staff
      794   then return buf_staff.staff-code.
      795   return 0.
      796   end FUNCTION.
      797   define variable v-curr-db-num like ub.db.db-num no-undo .
      798   define variable v-err-mess as character no-undo .
      799   define variable v-role-name as character no-undo .
      800   define variable conf-par as character no-undo .
      801   define variable par-type as character no-undo .
      802   define variable v-host-code like ub.sysconf.host-code no-undo .
      803   define variable v-obj-type like ub.clients.obj-type no-undo .
      804   define variable v-obj-code like ub.clients.obj-code no-undo .
      805   define variable v-role-level as character no-undo .
      806   DEFINE VARIABLE v-today as date no-undo .
      807   DEFINE VARIABLE v-time as integer no-undo .
      808   define variable v-work-place as character no-undo .
      809   define variable v-no-uniq as logical no-undo .
      810   define buffer buf_staff for ub.staff.
      811   define buffer main_staff for ub.staff .
      812   define temp-table tt-staff no-undo like ub.staff.
      813   if p-mode <> 'ДОБАВЛЕНИЕ':U
      814   AND p-mode <> 'ИЗМЕНЕНИЕ':U
      815   and p-mode <> 'удаление':U
      816   then do:
      817     message
      818     vss-workfile vss-revision vss-description skip
      819     "Неверный параметр p-mode" p-mode
      820     view-as alert-box error .
      821     return error '':u.
      822   end.
      823   main-block:
      824   do
      825   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      826   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      827   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      828   :
      829   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      830   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      831     (output v-curr-db-num
      832     )  .
      833     if lookup( p-role, 'C,S':U) = 0 then do:
      834       assign
      835       v-err-mess = substitute("Неизвестная роль персонала &1", p-role).
      836       run err-mess in this-procedure ( input-output v-err-mess ).
      837       undo main-block, return error '':U.
      838     end.
      839         assign
      840         v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      841         no-error.
      842     if v-curr-db-num  <> 0
      843     and v-curr-db-num <> p-db-num
      844     and p-level = 'db':U  then do:
      845       assign
      846       v-err-mess = substitute("Нельзя изменять запись &1 в чужой БД&2БД для &1 - &3, текущая БД &4"
      847                              , p-role
      848                              , chr(10)
      849                              , v-role-name
      850                              , p-db-num
      851                              , v-curr-db-num
      852                              ).
      853       run err-mess in this-procedure ( input-output v-err-mess ).
      854       undo main-block, return error '':U.
      855     end.
      856     if p-staff-code = 0
      857     or p-staff-code = ? then do:
      858       assign
      859       v-err-mess = substitute("Код персонала для роли типа &1 должен быть > 0 "
      860                               , v-role-name).
      861       run err-mess in this-procedure ( input-output v-err-mess ).
      862       undo main-block, return error (if p-silent then v-err-mess else "staff-code":U).
      863     end.
      864     if p-date-start > p-date-end
      865     or (p-mode = 'удаление':U
      866        and p-date-start > v-today
      867        )
      868     then do:
      869       assign
      870       v-err-mess = substitute("Дата начала работы &1 в данной должности должна быть меньше даты окончания работы &1 "
      871                               , string(p-date-start, "99/99/9999")
      872                               , string(p-date-end, "99/99/9999")
      873                               ).
      874       run err-mess in this-procedure ( input-output v-err-mess ).
      875       undo main-block, return error (if p-silent then v-err-mess else "date-start":U).
      876     end.
      877     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      878       v-work-place = gbclcode-get-work-place (
      879                                                input p-role
      880                                               ,input p-level
      881                                               ,input p-db-num
      882                                               ,input p-host-code
      883                                               ,input p-obj-type
      884                                               ,input p-obj-code
      885                                                  ) .
      886     end.
      887     else do:
      888       FIND FIRST main_staff EXCLUSIVE-lock where
      889                 recid(main_staff) = p-rid No-ERROR.
      890       if not available main_staff then do:
      891         message
      892         vss-workfile vss-revision vss-description skip
      893         "Не найдена запись ПЕРСОНАЛА - p-rid" p-rid
      894         view-as alert-box error .
      895         undo main-block, return error '':u.
      896       end.
      897     end.
      898     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      899       if not available tt-staff then create tt-staff.
      900       ASSIGN
      901       tt-staff.role       = p-role
      902       tt-staff.role-level = p-level
      903       tt-staff.work-place = v-work-place
      904       tt-staff.staff-code = p-staff-code
      905       tt-staff.date-start = p-date-start
      906       tt-staff.date-end   = p-date-end
      907       .
      908   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      909   if (p-mode = 'ДОБАВЛЕНИЕ':U) then do:
      910     find first buf_staff no-lock where
      911               buf_staff.role = tt-staff.role
      912           and buf_staff.role-level = tt-staff.role-level
      913           and buf_staff.work-place = tt-staff.work-place
      914           and buf_staff.staff-code = tt-staff.staff-code
      915           and buf_staff.date-start >= tt-staff.date-start no-error .
      916     if available buf_staff
      917     and recid(buf_staff) <> recid(tt-staff)
      918     then do:
      919         v-no-uniq = yes.
      920     end.
      921   end.
      922   if not v-no-uniq then do:
      923     find first buf_staff no-lock where
      924               buf_staff.role = tt-staff.role
      925           and buf_staff.role-level = tt-staff.role-level
      926           and buf_staff.work-place = tt-staff.work-place
      927           and buf_staff.staff-code = tt-staff.staff-code
      928           and buf_staff.date-start = tt-staff.date-start no-error .
      929     if available buf_staff
      930     and recid(buf_staff) <> recid(tt-staff)
      931     then do:
      932         v-no-uniq = yes.
      933     end.
      934   end.
      935   if not v-no-uniq then do:
      936     find first buf_staff no-lock where
      937               buf_staff.role = tt-staff.role
      938           and buf_staff.role-level = tt-staff.role-level
      939           and buf_staff.work-place = tt-staff.work-place
      940           and buf_staff.staff-code = tt-staff.staff-code
      941           and buf_staff.date-start <= tt-staff.date-start
      942           and buf_staff.date-end >= tt-staff.date-start
      943           no-error .
      944     if available buf_staff
      945     and recid(buf_staff) <> recid(tt-staff)
      946     then do:
      947         v-no-uniq = yes.
      948     end.
      949   end.
      950   if not v-no-uniq then do:
      951     find first buf_staff no-lock where
      952               buf_staff.role = tt-staff.role
      953           and buf_staff.role-level = tt-staff.role-level
      954           and buf_staff.work-place = tt-staff.work-place
      955           and buf_staff.staff-code = tt-staff.staff-code
      956           and buf_staff.date-start <= tt-staff.date-end
      957           and buf_staff.date-end >= tt-staff.date-end
      958           no-error .
      959     if available buf_staff
      960     and recid(buf_staff) <> recid(tt-staff)
      961     then do:
      962         v-no-uniq = yes.
      963     end.
      964   end.
      965   if not v-no-uniq then do:
      966     find first buf_staff no-lock where
      967               buf_staff.role = tt-staff.role
      968           and buf_staff.role-level = tt-staff.role-level
      969           and buf_staff.work-place = tt-staff.work-place
      970           and buf_staff.staff-code = tt-staff.staff-code
      971           and buf_staff.date-start >= tt-staff.date-start
      972           and buf_staff.date-start <= tt-staff.date-end
      973           no-error .
      974     if available buf_staff and
      975     recid(buf_staff) <> recid(tt-staff)
      976     then do:
      977         v-no-uniq = yes.
      978     end.
      979   end.
      980   if not v-no-uniq then do:
      981     find first buf_staff no-lock where
      982               buf_staff.role = tt-staff.role
      983           and buf_staff.role-level = tt-staff.role-level
      984           and buf_staff.work-place = tt-staff.work-place
      985           and buf_staff.staff-code = tt-staff.staff-code
      986           and buf_staff.date-end >= tt-staff.date-start
      987           and buf_staff.date-end <= tt-staff.date-end
      988           no-error .
      989     if available buf_staff
      990     and recid(buf_staff) <> recid(tt-staff)
      991     then do:
      992         v-no-uniq = yes.
      993     end.
      994   end.
      995   if v-no-uniq then do:
      996     v-err-mess =  substitute("Запись ПЕРСОНАЛА с определенным кодом должна быть уникальна&1" +
      997                 "в пределах БД или фирмы или объекта во всем периоде действия&1" +
      998                 "(Добавлять можно только если начиная с текущего момента других таких записей нет)&1" +
      999                 "Попытка сохранить запись - &2 Действует с &3 по &4&1" +
     1000                 "Найдена уже существующая запись - &5 Действует с &6 по &7"
     1001                 ,chr(10)
     1002                 ,gbclcode-get-position  ( input tt-staff.role
     1003                                           ,input tt-staff.role-level
     1004                                           ,input tt-staff.work-place
     1005                                           ,input tt-staff.staff-code )
     1006                 ,string(tt-staff.date-start, "99/99/9999")
     1007                 ,(if tt-staff.date-end = 12/31/9999 then "настоящее время" else string(tt-staff.date-end, "99/99/9999"))
     1008                 ,gbclcode-get-position  ( input buf_staff.role
     1009                                           ,input buf_staff.role-level
     1010                                           ,input buf_staff.work-place
     1011                                           ,input buf_staff.staff-code )
     1012                 ,string(buf_staff.date-start, "99/99/9999")
     1013                 ,(if buf_staff.date-end = 12/31/9999 then "настоящее время" else string(buf_staff.date-end, "99/99/9999"))
     1014                 ).
     1015   end.
     1016     end.
     1017     else do:
     1018   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1019   if (p-mode = 'ДОБАВЛЕНИЕ':U) then do:
     1020     find first buf_staff no-lock where
     1021               buf_staff.role = main_staff.role
     1022           and buf_staff.role-level = main_staff.role-level
     1023           and buf_staff.work-place = main_staff.work-place
     1024           and buf_staff.staff-code = main_staff.staff-code
     1025           and buf_staff.date-start >= main_staff.date-start no-error .
     1026     if available buf_staff
     1027     and recid(buf_staff) <> recid(main_staff)
     1028     then do:
     1029         v-no-uniq = yes.
     1030     end.
     1031   end.
     1032   if not v-no-uniq then do:
     1033     find first buf_staff no-lock where
     1034               buf_staff.role = main_staff.role
     1035           and buf_staff.role-level = main_staff.role-level
     1036           and buf_staff.work-place = main_staff.work-place
     1037           and buf_staff.staff-code = main_staff.staff-code
     1038           and buf_staff.date-start = main_staff.date-start no-error .
     1039     if available buf_staff
     1040     and recid(buf_staff) <> recid(main_staff)
     1041     then do:
     1042         v-no-uniq = yes.
     1043     end.
     1044   end.
     1045   if not v-no-uniq then do:
     1046     find first buf_staff no-lock where
     1047               buf_staff.role = main_staff.role
     1048           and buf_staff.role-level = main_staff.role-level
     1049           and buf_staff.work-place = main_staff.work-place
     1050           and buf_staff.staff-code = main_staff.staff-code
     1051           and buf_staff.date-start <= main_staff.date-start
     1052           and buf_staff.date-end >= main_staff.date-start
     1053           no-error .
     1054     if available buf_staff
     1055     and recid(buf_staff) <> recid(main_staff)
     1056     then do:
     1057         v-no-uniq = yes.
     1058     end.
     1059   end.
     1060   if not v-no-uniq then do:
     1061     find first buf_staff no-lock where
     1062               buf_staff.role = main_staff.role
     1063           and buf_staff.role-level = main_staff.role-level
     1064           and buf_staff.work-place = main_staff.work-place
     1065           and buf_staff.staff-code = main_staff.staff-code
     1066           and buf_staff.date-start <= main_staff.date-end
     1067           and buf_staff.date-end >= main_staff.date-end
     1068           no-error .
     1069     if available buf_staff
     1070     and recid(buf_staff) <> recid(main_staff)
     1071     then do:
     1072         v-no-uniq = yes.
     1073     end.
     1074   end.
     1075   if not v-no-uniq then do:
     1076     find first buf_staff no-lock where
     1077               buf_staff.role = main_staff.role
     1078           and buf_staff.role-level = main_staff.role-level
     1079           and buf_staff.work-place = main_staff.work-place
     1080           and buf_staff.staff-code = main_staff.staff-code
     1081           and buf_staff.date-start >= main_staff.date-start
     1082           and buf_staff.date-start <= main_staff.date-end
     1083           no-error .
     1084     if available buf_staff and
     1085     recid(buf_staff) <> recid(main_staff)
     1086     then do:
     1087         v-no-uniq = yes.
     1088     end.
     1089   end.
     1090   if not v-no-uniq then do:
     1091     find first buf_staff no-lock where
     1092               buf_staff.role = main_staff.role
     1093           and buf_staff.role-level = main_staff.role-level
     1094           and buf_staff.work-place = main_staff.work-place
     1095           and buf_staff.staff-code = main_staff.staff-code
     1096           and buf_staff.date-end >= main_staff.date-start
     1097           and buf_staff.date-end <= main_staff.date-end
     1098           no-error .
     1099     if available buf_staff
     1100     and recid(buf_staff) <> recid(main_staff)
     1101     then do:
     1102         v-no-uniq = yes.
     1103     end.
     1104   end.
     1105   if v-no-uniq then do:
     1106     v-err-mess =  substitute("Запись ПЕРСОНАЛА с определенным кодом должна быть уникальна&1" +
     1107                 "в пределах БД или фирмы или объекта во всем периоде действия&1" +
     1108                 "(Добавлять можно только если начиная с текущего момента других таких записей нет)&1" +
     1109                 "Попытка сохранить запись - &2 Действует с &3 по &4&1" +
     1110                 "Найдена уже существующая запись - &5 Действует с &6 по &7"
     1111                 ,chr(10)
     1112                 ,gbclcode-get-position  ( input main_staff.role
     1113                                           ,input main_staff.role-level
     1114                                           ,input main_staff.work-place
     1115                                           ,input main_staff.staff-code )
     1116                 ,string(main_staff.date-start, "99/99/9999")
     1117                 ,(if main_staff.date-end = 12/31/9999 then "настоящее время" else string(main_staff.date-end, "99/99/9999"))
     1118                 ,gbclcode-get-position  ( input buf_staff.role
     1119                                           ,input buf_staff.role-level
     1120                                           ,input buf_staff.work-place
     1121                                           ,input buf_staff.staff-code )
     1122                 ,string(buf_staff.date-start, "99/99/9999")
     1123                 ,(if buf_staff.date-end = 12/31/9999 then "настоящее время" else string(buf_staff.date-end, "99/99/9999"))
     1124                 ).
     1125   end.
     1126     end.
     1127     if v-no-uniq then do:
     1128       undo main-block, return error v-err-mess.
     1129     end.
     1130     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1131       create main_staff.
     1132       assign
     1133       main_staff.role = p-role
     1134       main_staff.role-level = p-level
     1135       main_staff.work-place = v-work-place
     1136       main_staff.date-start = p-date-start
     1137       main_staff.staff-code = p-staff-code
     1138       main_staff.db-num = p-db-num
     1139       main_staff.host-code = p-host-code
     1140       main_staff.obj-type = p-obj-type
     1141       main_staff.obj-code = p-obj-code
     1142       main_staff.obj-code = p-obj-code
     1143       p-rid = recid(main_staff)
     1144       .
     1145     end.
     1146     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1147       v-work-place = p-work-place.
     1148       if p-mode <> 'удаление':U
     1149       then do:
     1150         if main_staff.psn-code <>  p-psn-code
     1151         or main_staff.role <>  p-role
     1152         or main_staff.role-level <>  p-level
     1153         or main_staff.work-place <>  v-work-place
     1154         or main_staff.date-start <>  p-date-start
     1155         or main_staff.db-num     <>  p-db-num
     1156         or main_staff.host-code  <>  p-host-code
     1157         or main_staff.obj-type   <>  p-obj-type
     1158         or main_staff.obj-code   <>  p-obj-code
     1159         then do:
     1160           message
     1161           vss-workfile vss-revision vss-description skip
     1162           "Для уже имеющейся записи нельзя изменить"
     1163           "код физ.лица и/или" skip
     1164           "роль" skip
     1165           "место работы и/или" skip
     1166           "дату начала работы в данной роли и/или" skip
     1167           "№ БД, код фирмы, объект" skip
     1168           view-as alert-box ERROR.
     1169           undo main-block, return error '':U.
     1170         end.
     1171       end.
     1172     end.
     1173     if p-mode = 'удаление':U then do:
     1174       run cur-time in this-procedure ( output v-today, output v-time).
     1175       assign
     1176       main_staff.date-end = v-today
     1177       .
     1178     end.
     1179     else do:
     1180       assign
     1181       main_staff.psn-code = p-psn-code
     1182       main_staff.password = p-password
     1183       main_staff.date-end = p-date-end
     1184       .
     1185     end.
     1186     release main_staff no-error.
     1187     if error-status:error then do:
     1188       message
     1189       vss-workfile vss-revision vss-description skip
     1190       "Ошибка при сохранении записи ПЕРСОНАЛА" skip
     1191       ERROR-STATUS:GET-NUMBER(1) skip
     1192       return-value
     1193       view-as alert-box .
     1194       undo main-block, return error "":U.
     1195     end.
     1196   end.
     1197   PROCEDURE err-mess:
     1198   DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
     1199     CASE p-silent:
     1200       when yes then do:
     1201         p-mess = substitute("&1 чел&2: &3", v-role-name, p-psn-code,  p-mess).
     1202       end.
     1203       when no then do:
     1204         message
     1205         p-mess
     1206         view-as alert-box error .
     1207       end.
     1208     end.
     1209   END PROCEDURE.
