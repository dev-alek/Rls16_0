     2720       ,input  0
     2721       ,input  'actn_main-barcode_deletion':U
     2722       ,input  'global':U
     2723       ,input  0
     2724       ,input  '':U
     2725       ,input  0
     2726       ,input  0
     2727       ,input  X_goods.grp-code
     2728       ,input  0
     2729       ,input  true
     2730       ,output glog
     2731       )  .
     2732   end.
     2733   if not glog then return no-apply.
     2734   if can-find(first ub.db no-lock where ub.db.db-num > 0 ) then do:
     2735     run gen-key-rec( input 'bar-code':U
     2736                     ,input ( buffer X_bar-code:handle )
     2737                     ,output v-key-rec
     2738                   ) no-error.
     2739     assign
     2740     v-param = string(X_bar-code.b-code) + chr(4)  +
     2741               string(X_bar-code.gds-code) + chr(4) +
     2742               string(X_bar-code.node-code) + chr(4) +
     2743               X_bar-code.part-code + chr(4) +
     2744               X_bar-code.in-code + chr(4) +
     2745               X_bar-code.unit-cli + chr(4) +
     2746               string(X_bar-code.cli-base-rate) + chr(4) +
     2747               string(X_bar-code.stts_)
     2748     .
     2749    if v-cntxt-db-num > 0 then do:
     2750       define buffer buf_route for ub.route.
     2751       find first buf_route no-lock where
     2752                 buf_route.name-rec = ("command":U + chr(1)
     2753                                       + "inquiry-two-commit":U + chr(1)
     2754                                       + 'delete_nu-ucli-bar-code':U + chr(1)
     2755                                       + v-key-rec + chr(1)
     2756                                       + v-param) no-error.
     2757       if available buf_route then do:
     2758         message
     2759         substitute("Команда <Запуск удаления кода &1 из ГБД> уже отослана", X_bar-code.b-code)
     2760         view-as alert-box warning.
     2761         return no-apply.
     2762       end.
     2763     end.
     2764     message
     2765     "Удалить код:" X_bar-code.b-code
     2766     "и все привязанные к нему дополнительные бар-коды? Вы уверены?" skip(0)
     2767     (if v-cntxt-db-num = 0
     2768      then  substitute("(Доп.БК будут удалены сразу же, а&1" +
     2769                       "удаление собственного кода будет проведено только после подтверждения от всех БД)&1"
     2770                       , chr(10))
     2771      else  substitute("(Будет отослана в ГБД команда <Запуск удаления кода &1 из ГБД>)&1", chr(10))
     2772      )
     2773     view-as alert-box question buttons OK-Cancel update glog.
     2774   end.
     2775   else do:
     2776     message "Удалить код:" X_bar-code.b-code
     2777     "и все привязанные к нему дополнительные бар-коды? Вы уверены?"
     2778     view-as alert-box question buttons OK-Cancel update glog.
     2779   end.
     2780   if not glog then return no-apply.
     2781   del-bc:
     2782   do on stop undo del-bc, return no-apply on error undo del-bc, return no-apply:
     2783     find locked_bar-code EXCLUSIVE-LOCK WHERE recid(LOCKED_bar-code) = RECID(X_bar-code) no-error .
     2784     if not available locked_bar-code then do:
     2785       message
     2786       "Запись уже отсутствует или недоступна"
     2787       view-as alert-box warning.
     2788       return no-apply.
     2789     end.
     2790     for each buf_prod-bc where
     2791               buf_prod-bc.b-code = X_bar-code.b-code
     2792         on stop undo del-bc, return no-apply on error undo del-bc, return no-apply:
     2793         if buf_prod-bc.bc-on and send-ref then
     2794           run str/diallog.w ( parparentproc
     2795                       , this-procedure
     2796                       , 'str/s-prodbc.p':U
     2797                       , string(recid(buf_prod-bc)) + chr(4) + "D":U
     2798                       , yes
     2799                       , '':U
     2800                       , 'Удаление ДопБК с кассы') .
     2801       delete buf_prod-bc.
     2802     end.
