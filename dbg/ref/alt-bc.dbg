     3087                   , input-output v-rid-list  ) no-error .
     3088     apply "entry" to br-pbc in frame Dialog-Frame.
     3089   END.
     3090   ON CHOOSE OF b-hist-2 IN FRAME Dialog-Frame
     3091   DO:
     3092   define variable v-rid-list as character no-undo .
     3093   if not avail X_prod-bc then return no-apply.
     3094   run ref/cprodbcs.w (
     3095                     input parparentproc
     3096                   , input "":U
     3097                   , 'все':U
     3098                   , input X_prod-bc.b-str
     3099                   , input X_prod-bc.b-code
     3100                   , input ?
     3101                   , input "":U
     3102                   , input v-cntxt-db-num
     3103                   , input-output v-rid-list  ) no-error .
     3104     apply "entry" to br-pbc in frame Dialog-Frame.
     3105   END.
     3106   ON CHOOSE OF b-on IN FRAME Dialog-Frame
     3107   DO:
     3108   define variable glog as logical no-undo .
     3109     if not available X_prod-bc then do:
     3110       message "Неправильно выбран дополнительный бар-код."
     3111               view-as alert-box error.
     3112       return no-apply.
     3113     end.
     3114   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3115   do:
     3116     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3117       (input  v-cntxt-db-num
     3118       ,input  v-cntxt-userid
     3119       ,input  0
     3120       ,input  'actn_alt-barcode_turn-on':U
     3121       ,input  'global':U
     3122       ,input  0
     3123       ,input  '':U
     3124       ,input  0
     3125       ,input  0
     3126       ,input  X_goods.grp-code
     3127       ,input  0
     3128       ,input  true
     3129       ,output glog
     3130       )  .
     3131   end.
     3132     if not glog then return no-apply.
     3133     run trg/bc-upd.p (
     3134                   input parparentproc
     3135                  ,input X_prod-bc.b-code
     3136                  ,input X_prod-bc.b-str
     3137                  ,input (NOT X_prod-bc.bc-on)
     3138                  ,input no
     3139                  ,input send-ref
     3140                  ,input ?
     3141                  ,input ?
     3142                  ) no-error  .
     3143     if error-status:error then do:
     3144       if return-value <> "":U then do:
     3145         message
     3146         return-value
     3147         view-as alert-box .
     3148         return no-apply.
     3149       end.
     3150     end.
     3151     display X_prod-bc.bc-on with browse br-pbc.
     3152     apply "entry" to br-pbc in frame Dialog-Frame.
     3153   END.
     3154   ON CHOOSE OF b-print-1 IN FRAME Dialog-Frame
     3155   DO:
     3156   DEFINE VARIABLE loc#log as logical no-undo .
     3157   define buffer buf_prod-bc for ub.prod-bc.
     3158   if not available X_prod-bc then return no-apply.
     3159   find first buf_prod-bc no-lock where
     3160               recid(buf_prod-bc) = recid(X_prod-bc) no-error.
     3161   if not available buf_prod-bc then return no-apply.
     3162   if buf_prod-bc.bc-on = no then do:
     3163       message
     3164       "Данный ДопБК выключен" skip
     3165       "Вы действительно хотите напечать этикетку на него?"
     3166       view-as alert-box QUestion buttons YEs-No update loc#log.
     3167       if not loc#log then return no-apply.
     3168   end.
     3169   run rep/tick-pbc.p (       input parparentproc
     3170                        ,input p-curr-obj-type
     3171                        ,input p-curr-obj-code
     3172                        ,input recid(buf_prod-bc)
     3173                        ,input buf_prod-bc.b-code
     3174                       ) no-error.
     3175   if error-status:error then return no-apply.
     3176   apply "entry" to br-pbc in frame Dialog-Frame.
     3177   END.
     3178   ON CHOOSE OF b-print-2 IN FRAME Dialog-Frame
     3179   DO:
     3180     if not available X_bar-code then  return no-apply.
     3181     run rep/tick-one.p (input parparentproc, input p-curr-obj-type, input p-curr-obj-code, recid (X_bar-code)).
     3182     apply "entry" to br-bc in frame Dialog-Frame.
     3183   END.
     3184   ON VALUE-CHANGED OF br-bc IN FRAME Dialog-Frame
     3185   DO:
     3186       open query br-pbc
     3187     for each X_prod-bc no-lock where
     3188              X_prod-bc.b-code = X_bar-code.b-code.
     3189   apply "value-changed" to br-pbc.
     3190   run openbr-bc-attr in this-procedure ( input attr-mode) no-error.
     3191   END.
     3192   ON VALUE-CHANGED OF BR-pbc IN FRAME Dialog-Frame
     3193   DO:
     3194   if available X_prod-bc then
     3195     display X_prod-bc.b-str with frame Dialog-Frame.
     3196   else
     3197     display "" @ X_prod-bc.b-str with frame Dialog-Frame.
     3198   END.
     3199   ON VALUE-CHANGED OF Rs-attr-mode IN FRAME Dialog-Frame
     3200   DO:
     3201     assign
     3202     rs-attr-mode.
     3203     attr-mode = rs-attr-mode.
     3204     case rs-attr-mode:
     3205       when 'все':U then do:
     3206         disable
     3207         b-add-attr when (ub.db.add-goods and v-cntxt-level = 'object':U )
     3208         b-chg-attr when (ub.db.add-goods and v-cntxt-level = 'object':U )
     3209         b-del-attr when (ub.db.add-goods and v-cntxt-level = 'object':U )
     3210         with frame Dialog-Frame .
     3211       end.
     3212       when "b-code" then do:
     3213         enable
     3214         b-add-attr when (ub.db.add-goods and v-cntxt-level = 'object':U )
     3215         b-chg-attr when (ub.db.add-goods and v-cntxt-level = 'object':U )
     3216         b-del-attr when (ub.db.add-goods and v-cntxt-level = 'object':U )
     3217         with frame Dialog-Frame .
     3218       end.
     3219     end case.
     3220     run openbr-bc-attr in this-procedure ( input  attr-mode) no-error.
     3221   END.
     3222   browse br-bc :SET-REPOSITIONED-ROW (5, "CONDITIONAL").
     3223   browse br-pbc :SET-REPOSITIONED-ROW (5, "CONDITIONAL").
     3224   browse br-bc-attr :SET-REPOSITIONED-ROW (5, "CONDITIONAL").
     3225   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3226   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3227   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3228   on help of frame Dialog-Frame
     3229   do:
     3230     run gbl/app_help.p
     3231       (input this-procedure :file-name
     3232       ,input ''
     3233       ,input ?
     3234       ) no-error.
     3235     if error-status :error then do:
     3236       message
     3237         "Ошибка при вызове помощи"
     3238         error-status :get-message(1)
     3239         view-as alert-box .
     3240     end.
     3241   end.
     3242   run minbtn-set in this-procedure .
     3243   on choose of b-help in frame Dialog-Frame
     3244   do:
     3245     apply "help":u to frame Dialog-Frame .
     3246   end.
     3247   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3248   procedure minbtn-set :
     3249       do
     3250           on error undo, return error return-value
     3251           :
     3252           define variable ii              as integer       no-undo .
     3253           define variable fh              as widget-handle no-undo .
     3254           define variable hh              as widget-handle no-undo .
     3255           define variable v-h             as handle        extent 4 no-undo .
     3256           define variable v-name-button   as character     no-undo .
     3257           define variable v-help-old-x    as decimal       no-undo .
     3258           define variable v-help-old-y    as decimal       no-undo .
     3259           define variable v-help-old-size as decimal       no-undo .
     3260           define variable v-frame-width   as decimal       no-undo .
     3261           define variable jj              as integer       no-undo .
     3262           do
     3263               on error undo, return error
     3264               :
     3265               assign
     3266                   v-frame-width = frame Dialog-Frame:width - 0.3
     3267                   fh            = frame Dialog-Frame:first-child
     3268                   hh            = fh:first-child
     3269                   ii            = 1
     3270                   .
     3271               do while valid-handle(hh):
     3272                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3273                   do:
     3274                       case lc(hh:name) :
     3275                           when "b-help" then
     3276                               do:
     3277                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3278                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3279                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3280                                   hh:TOOLTIP = "Помощь" .
     3281                                   v-help-old-x = hh:column .
     3282                                   v-help-old-y = hh:row    .
     3283                                   v-help-old-size = hh:width .
     3284                                   hh:width-chars = 2.5 .
     3285                               end.
     3286                           when "b-print" then
     3287                               do:
     3288                                   hh:load-image("cmp/b-print.bmp":u) .
     3289                                   hh:TOOLTIP = "Печать" .
     3290                                   v-h[ii] = hh:handle .
     3291                                   ii = ii + 1 .
     3292                                   hh:width-chars = 3 .
     3293                               end.
     3294                           when "b-history" or
     3295                           when "b-hist" then
     3296                               do:
     3297                                   hh:load-image("cmp/b-hist.bmp":u) .
     3298                                   hh:TOOLTIP = "История" .
     3299                                   v-h[ii] = hh:handle .
     3300                                   ii = ii + 1 .
     3301                                   hh:width-chars = 3 .
     3302                               end.
     3303                           when "b-sch" then
     3304                               do:
     3305                                   hh:load-image("cmp/b-sch.bmp":u) .
     3306                                   hh:TOOLTIP = "Установка Фильтра" .
     3307                                   v-h[ii] = hh:handle .
     3308                                   ii = ii + 1 .
     3309                                   hh:width-chars = 3 .
     3310                               end.
     3311                           when "b-hist-user" then
     3312                               do:
     3313                                   hh:load-image("cmp/b-hist.bmp":u) .
     3314                                   hh:TOOLTIP = "История пользователя" .
     3315                                   ii = ii + 1 .
     3316                               end.
     3317                       end case.
     3318                   end.
     3319                   hh = hh:next-sibling.
     3320               end.
     3321               b-help:column = v-frame-width - b-help:width-chars.
     3322               jj = 0.
     3323               repeat ii = 4 to 1 by -1 :
     3324                   if valid-handle (v-h[ii] ) then
     3325                   do:
     3326                       jj  = jj + 1 .
     3327                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3328                       v-h[ii]:row    = v-help-old-y .
     3329                   end.
     3330               end.
     3331           end.
     3332       end.
     3333   end procedure.
     3334   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3335   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3336   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3337   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3338   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3339   define variable v-diasize-current-frame-height as decimal   no-undo .
     3340   define variable v-diasize-change-size          as logical   no-undo .
     3341   define variable v-diasize-resize-button        as handle    no-undo .
     3342   define variable v-diasize-wndmax               as logical   no-undo .
     3343   define variable v-diasize-wndstore             as logical   no-undo .
     3344   define variable v-diasize-proc-name            as character no-undo .
     3345   define variable v-diasize-browse-handle        as handle    no-undo .
     3346   define variable v-diasize-browse-number        as integer   no-undo .
     3347   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3348   define temp-table temp-diasize-handle no-undo
     3349     field handle-value  as handle
     3350     field save-position as decimal
     3351     index xpk is primary unique handle-value
     3352     .
     3353   define temp-table temp-browse-handle no-undo
     3354     field browse-type   as character
     3355     field browse-number as integer
     3356     field browse-handle as handle
     3357     field original-size as decimal
     3358     index xpk is primary unique browse-type browse-number
     3359     index xie browse-type browse-handle
     3360   .
     3361   procedure diasize_change-height :
     3362     define input  parameter p-change-value  as decimal   no-undo .
     3363     define input  parameter p-move-resize   as logical   no-undo .
     3364     define variable v-field-group-handle    as handle    no-undo .
     3365     define variable v-object-handle         as handle    no-undo .
     3366     define variable v-frame-height          as decimal   no-undo .
     3367     define variable v-frame-virtual-height  as decimal   no-undo .
     3368     define variable v-browse-height         as decimal   no-undo .
     3369     define variable v-window-height         as decimal   no-undo .
     3370     define variable v-window-virtual-height as decimal   no-undo .
     3371     define variable v-change-sign           as integer   no-undo .
     3372     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3373     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3374     if p-change-value > 0
     3375     then do:
     3376       if frame Dialog-Frame :height + p-change-value
     3377           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3378       then do:
     3379         assign
     3380           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3381                           - (frame Dialog-Frame :height-chars)
     3382         .
     3383         if p-change-value <= 0
     3384         then do:
     3385           run diasize_position-resize-button in this-procedure .
     3386           return .
     3387         end.
     3388       end.
     3389     end.
     3390     if p-change-value < 0
     3391     then do:
     3392       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3393       then do:
     3394         assign
     3395           p-change-value = v-diasize-orig-frame-height
     3396                          - (frame Dialog-Frame :height-chars)
     3397         .
     3398         if p-change-value >= 0
     3399         then do:
     3400           run diasize_position-resize-button in this-procedure .
     3401           return .
     3402         end.
     3403       end.
     3404     end.
     3405     if p-change-value >= 0
     3406     then do:
     3407       assign
     3408         v-change-sign = 1
     3409       .
     3410     end.
     3411     else do:
     3412       assign
     3413         v-change-sign = -1
     3414       .
     3415     end.
     3416     assign
     3417       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3418     .
     3419     if p-change-value = 0
     3420     then do:
     3421       run diasize_position-resize-button in this-procedure .
     3422       return .
     3423     end.
     3424     move_block:
     3425     do
     3426     on error undo move_block, retry move_block
     3427     :
     3428       if retry
     3429       then do:
     3430         do
     3431         on error undo move_block, leave move_block
     3432         :
     3433           if p-change-value > 0
     3434           then do:
     3435             for each buf_temp-diasize-handle
     3436             on error undo, next
     3437             :
     3438               assign
     3439                 v-object-handle = buf_temp-diasize-handle.handle-value
     3440               .
     3441               if v-object-handle <> v-diasize-resize-button
     3442               then do:
     3443                 assign
     3444                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3445                 .
     3446               end.
     3447             end.
     3448             assign
     3449               v-diasize-browse-handle :height = v-browse-height
     3450             .
     3451             for each buf_temp-browse-handle
     3452               where buf_temp-browse-handle.browse-type = 'height':u
     3453             on error undo, next
     3454             :
     3455               assign
     3456                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3457               .
     3458             end.
     3459             assign
     3460               frame Dialog-Frame :height = v-frame-height
     3461             .
     3462             if frame Dialog-Frame :scrollable = true
     3463             then do:
     3464               assign
     3465                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3466               .
     3467             end.
     3468             run diasize_position-resize-button in this-procedure .
     3469           end.
     3470           else do:
     3471             if frame Dialog-Frame :scrollable = true
     3472             then do:
     3473               assign
     3474                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3475               .
     3476             end.
     3477             assign
     3478               frame Dialog-Frame :height = v-frame-height
     3479             .
     3480             assign
     3481               v-diasize-browse-handle :height = v-browse-height
     3482             .
     3483             for each buf_temp-browse-handle
     3484               where buf_temp-browse-handle.browse-type = 'height':u
     3485             on error undo, next
     3486             :
     3487               assign
     3488                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3489               .
     3490             end.
     3491             for each buf_temp-diasize-handle
     3492             on error undo, next
     3493             :
     3494               assign
     3495                 v-object-handle = buf_temp-diasize-handle.handle-value
     3496               .
     3497               if v-object-handle <> v-diasize-resize-button
     3498               then do:
     3499                 assign
     3500                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3501                 .
     3502               end.
     3503             end.
     3504             run diasize_position-resize-button in this-procedure .
     3505           end.
     3506           assign
     3507             v-diasize-change-size = false
     3508           .
     3509           leave move_block .
     3510         end.
     3511       end.
     3512       assign
     3513         v-diasize-need-full-display = true
     3514       .
     3515       if v-diasize-change-size = false
     3516       then do:
     3517         assign
     3518           v-diasize-change-size = true
     3519         .
     3520       end.
     3521       else do:
     3522         return .
     3523       end.
     3524       assign
     3525         v-frame-height = frame Dialog-Frame :height
     3526         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3527         v-browse-height = v-diasize-browse-handle :height
     3528       .
     3529       for each buf_temp-browse-handle
     3530         where buf_temp-browse-handle.browse-type = 'height':u
     3531       :
     3532         assign
     3533           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3534         .
     3535       end.
     3536       for each buf_temp-diasize-handle
     3537       :
     3538         delete buf_temp-diasize-handle .
     3539       end.
     3540       assign
     3541         v-field-group-handle = frame Dialog-Frame :first-child
     3542       .
     3543       do while valid-handle(v-field-group-handle)
     3544       :
     3545         assign
     3546           v-object-handle = v-field-group-handle :first-child
     3547         .
     3548         do while valid-handle(v-object-handle)
     3549         :
     3550           if  v-object-handle <> v-diasize-browse-handle :handle
     3551           and can-query(v-object-handle, "row")
     3552           and can-query(v-object-handle, "height")
     3553           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3554           then do:
     3555             find first buf_temp-browse-handle
     3556               where buf_temp-browse-handle.browse-type   = 'height':u
     3557                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3558               no-error .
     3559             if available buf_temp-browse-handle
     3560             then do:
     3561             end.
     3562             else do:
     3563               create buf_temp-diasize-handle .
     3564               assign
     3565                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3566                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3567               .
     3568             end.
     3569           end.
     3570           assign
     3571             v-object-handle = v-object-handle :next-sibling
     3572           .
     3573         end.
     3574         assign
     3575           v-field-group-handle = v-field-group-handle :next-sibling
     3576         .
     3577       end.
     3578       do with frame Dialog-Frame
     3579       :
     3580         hide v-diasize-resize-button .
     3581         assign
     3582           v-diasize-resize-button :row    = 1
     3583           v-diasize-resize-button :column = 1
     3584         .
     3585       end.
     3586       if p-change-value > 0
     3587       then do:
     3588         if frame Dialog-Frame :scrollable = true
     3589         then do:
     3590           assign
     3591             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3592             no-error .
     3593           if error-status :error
     3594           or error-status :get-message(1) <> ""
     3595           then do:
     3596             undo move_block, retry move_block .
     3597           end.
     3598         end.
     3599         assign
     3600           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3601           no-error .
     3602         if error-status :error
     3603         or error-status :get-message(1) <> ""
     3604         then do:
     3605           undo move_block, retry move_block .
     3606         end.
     3607         assign
     3608           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3609           no-error .
     3610         if error-status :error
     3611         or error-status :get-message(1) <> ""
     3612         then do:
     3613           undo move_block, retry move_block .
     3614         end.
     3615         for each buf_temp-browse-handle
     3616           where buf_temp-browse-handle.browse-type = 'height':u
     3617         on error undo move_block, retry move_block
     3618         :
     3619           assign
     3620             buf_temp-browse-handle.browse-handle :height
     3621               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3622             no-error .
     3623           if error-status :error
     3624           or error-status :get-message(1) <> ""
     3625           then do:
     3626             undo move_block, retry move_block .
     3627           end.
     3628         end.
     3629         for each buf_temp-diasize-handle
     3630         on error undo move_block, retry move_block
     3631         :
     3632           assign
     3633             v-object-handle = buf_temp-diasize-handle.handle-value
     3634           .
     3635           if v-object-handle <> v-diasize-resize-button
     3636           then do:
     3637             assign
     3638               v-object-handle :row = v-object-handle :row + p-change-value
     3639               no-error .
     3640             if error-status :error
     3641             or error-status :get-message(1) <> ""
     3642             then do:
     3643               undo move_block, retry move_block .
     3644             end.
     3645           end.
     3646         end.
     3647       end.
     3648       else do:
     3649         for each buf_temp-diasize-handle
     3650         on error undo move_block, retry move_block
     3651         :
     3652           assign
     3653             v-object-handle = buf_temp-diasize-handle.handle-value
     3654           .
     3655           if v-object-handle <> v-diasize-resize-button
     3656           then do:
     3657             assign
     3658               v-object-handle :row = v-object-handle :row + p-change-value
     3659               no-error .
     3660             if error-status :error
     3661             or error-status :get-message(1) <> ""
     3662             then do:
     3663               undo move_block, retry move_block .
     3664             end.
     3665           end.
     3666         end.
     3667         assign
     3668           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3669           no-error .
     3670         if error-status :error
     3671         or error-status :get-message(1) <> ""
     3672         then do:
     3673           undo move_block, retry move_block .
     3674         end.
     3675         for each buf_temp-browse-handle
     3676           where buf_temp-browse-handle.browse-type = 'height':u
     3677         on error undo move_block, retry move_block
     3678         :
     3679           assign
     3680             buf_temp-browse-handle.browse-handle :height
     3681               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3682             no-error .
     3683           if error-status :error
     3684           or error-status :get-message(1) <> ""
     3685           then do:
     3686             undo move_block, retry move_block .
     3687           end.
     3688         end.
     3689         assign
     3690           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3691           no-error .
     3692         if error-status :error
     3693         or error-status :get-message(1) <> ""
     3694         then do:
     3695           undo move_block, retry move_block .
     3696         end.
     3697         if frame Dialog-Frame :scrollable = true
     3698         then do:
     3699           assign
     3700             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3701             no-error .
     3702           if error-status :error
     3703           or error-status :get-message(1) <> ""
     3704           then do:
     3705             undo move_block, retry move_block .
     3706           end.
     3707         end.
     3708       end.
     3709       if p-move-resize = true
     3710       then do:
     3711         run diasize_position-resize-button in this-procedure .
     3712       end.
     3713       if v-diasize-wndstore = true
     3714       then do:
     3715         if connected("ub") = true
     3716         then do:
     3717           define variable v-cntxt-db-num        as integer   no-undo .
     3718           define variable v-cntxt-userid        as character no-undo .
     3719           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3720                                             , OUTPUT v-cntxt-userid
     3721                                             ) .
     3722           run gbl/wndsizew.p
     3723             (input  v-cntxt-db-num
     3724             ,input  v-cntxt-userid
     3725             ,input  v-diasize-proc-name
     3726             ,input  'height':u
     3727             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3728             ) .
     3729         end.
     3730       end.
     3731     end.
     3732     assign
     3733       v-diasize-change-size = false
     3734     .
     3735   end procedure.
     3736   procedure diasize_set-height :
     3737     define input  parameter p-new-height  as decimal   no-undo .
     3738     define input  parameter p-move-resize as logical   no-undo .
     3739     do
     3740     on error undo, return error return-value
     3741     :
     3742       run diasize_change-height in this-procedure
     3743         (input  (p-new-height - frame Dialog-Frame :height)
     3744         ,input  p-move-resize
     3745         ) .
     3746     end.
     3747   end procedure.
     3748   procedure diasize_change-width :
     3749     define input  parameter p-change-value as decimal   no-undo .
     3750     define input  parameter p-move-resize  as logical   no-undo .
     3751     define variable v-field-group-handle   as handle    no-undo .
     3752     define variable v-object-handle        as handle    no-undo .
     3753     define variable v-frame-width          as decimal   no-undo .
     3754     define variable v-frame-virtual-width  as decimal   no-undo .
     3755     define variable v-browse-width         as decimal   no-undo .
     3756     define variable v-window-width         as decimal   no-undo .
     3757     define variable v-window-virtual-width as decimal   no-undo .
     3758     define variable v-change-sign          as integer   no-undo .
     3759     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3760     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3761     if p-change-value > 0
     3762     then do:
     3763       if frame Dialog-Frame :width + p-change-value >
     3764           session :width-chars
     3765       then do:
     3766         assign
     3767           p-change-value = session :width-chars - frame Dialog-Frame :width
     3768         .
     3769         if p-change-value <= 0
     3770         then do:
     3771           run diasize_position-resize-button in this-procedure .
     3772           return .
     3773         end.
     3774       end.
     3775     end.
     3776     if p-change-value < 0
     3777     then do:
     3778       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3779       then do:
     3780         assign
     3781           p-change-value = v-diasize-orig-frame-width
     3782                          - frame Dialog-Frame :width
     3783         .
     3784         if p-change-value >= 0
     3785         then do:
     3786           run diasize_position-resize-button in this-procedure .
     3787           return .
     3788         end.
     3789       end.
     3790     end.
     3791     if p-change-value >= 0
     3792     then do:
     3793       assign
     3794         v-change-sign = 1
     3795       .
     3796     end.
     3797     else do:
     3798       assign
     3799         v-change-sign = -1
     3800       .
     3801     end.
     3802     assign
     3803       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3804     .
     3805     if p-change-value = 0
     3806     then do:
     3807       run diasize_position-resize-button in this-procedure .
     3808       return .
     3809     end.
     3810     move_block:
     3811     do
     3812     on error undo move_block, leave move_block
     3813     :
     3814       if retry
     3815       then do:
     3816         do
     3817         on error undo move_block, leave move_block
     3818         :
     3819           if p-change-value > 0
     3820           then do:
     3821             for each buf_temp-diasize-handle
     3822             on error undo, next
     3823             :
     3824               assign
     3825                 v-object-handle = buf_temp-diasize-handle.handle-value
     3826               .
     3827               if v-object-handle <> v-diasize-resize-button
     3828               then do:
     3829                 assign
     3830                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3831                 .
     3832               end.
     3833             end.
     3834             assign
     3835               v-diasize-browse-handle :width = v-browse-width
     3836             .
     3837             for each buf_temp-browse-handle
     3838               where buf_temp-browse-handle.browse-type = 'width':u
     3839             on error undo, next
     3840             :
     3841               assign
     3842                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3843               .
     3844             end.
     3845             assign
     3846               frame Dialog-Frame :width = v-frame-width
     3847             .
     3848             if frame Dialog-Frame :scrollable = true
     3849             then do:
     3850               assign
     3851                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3852               .
     3853             end.
     3854             run diasize_position-resize-button in this-procedure .
     3855           end.
     3856           else do:
     3857             if frame Dialog-Frame :scrollable = true
     3858             then do:
     3859               assign
     3860                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3861               .
     3862             end.
     3863             assign
     3864               frame Dialog-Frame :width = v-frame-width
     3865             .
     3866             for each buf_temp-browse-handle
     3867               where buf_temp-browse-handle.browse-type = 'width':u
     3868             on error undo, next
     3869             :
     3870               assign
     3871                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3872               .
     3873             end.
     3874             assign
     3875               v-diasize-browse-handle :width = v-browse-width
     3876             .
     3877             for each buf_temp-diasize-handle
     3878             on error undo, next
     3879             :
     3880               assign
     3881                 v-object-handle = buf_temp-diasize-handle.handle-value
     3882               .
     3883               if v-object-handle <> v-diasize-resize-button
     3884               then do:
     3885                 assign
     3886                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3887                 .
     3888               end.
     3889             end.
     3890             run diasize_position-resize-button in this-procedure .
     3891           end.
     3892           assign
     3893             v-diasize-change-size = false
     3894           .
     3895           leave move_block .
     3896         end.
     3897       end.
     3898       assign
     3899         v-diasize-need-full-display = true
     3900       .
     3901       if v-diasize-change-size = false
     3902       then do:
     3903         assign
     3904           v-diasize-change-size = true
     3905         .
     3906       end.
     3907       else do:
     3908         return .
     3909       end.
     3910       assign
     3911         v-frame-width = frame Dialog-Frame :width
     3912         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3913         v-browse-width = v-diasize-browse-handle :width
     3914       .
     3915       for each buf_temp-browse-handle
     3916         where buf_temp-browse-handle.browse-type = 'width':u
     3917       :
     3918         assign
     3919           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3920         .
     3921       end.
     3922       for each buf_temp-diasize-handle
     3923       :
     3924         delete buf_temp-diasize-handle .
     3925       end.
     3926       assign
     3927         v-field-group-handle = frame Dialog-Frame :first-child
     3928       .
     3929       do while valid-handle(v-field-group-handle)
     3930       :
     3931         assign
     3932           v-object-handle = v-field-group-handle :first-child
     3933         .
     3934         do while valid-handle(v-object-handle)
     3935         :
     3936           if  v-object-handle <> v-diasize-browse-handle :handle
     3937           and v-object-handle <> v-diasize-resize-button
     3938           and can-query(v-object-handle, "row")
     3939           and can-query(v-object-handle, "height")
     3940           and ( v-object-handle :col + v-object-handle :width
     3941                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3942               )
     3943           then do:
     3944             find first buf_temp-browse-handle
     3945               where buf_temp-browse-handle.browse-type   = 'width':u
     3946                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3947               no-error .
     3948             if available buf_temp-browse-handle
     3949             then do:
     3950             end.
     3951             else do:
     3952               create buf_temp-diasize-handle .
     3953               assign
     3954                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3955                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3956               .
     3957             end.
     3958           end.
     3959           assign
     3960             v-object-handle = v-object-handle :next-sibling
     3961           .
     3962         end.
     3963         assign
     3964           v-field-group-handle = v-field-group-handle :next-sibling
     3965         .
     3966       end.
     3967       do with frame Dialog-Frame
     3968       :
     3969         hide v-diasize-resize-button .
     3970         v-diasize-resize-button :row = 1.
     3971         v-diasize-resize-button :column = 1.
     3972       end.
     3973       if p-change-value > 0
     3974       then do:
     3975         if frame Dialog-Frame :scrollable = true
     3976         then do:
     3977           assign
     3978             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3979             no-error .
     3980           if error-status :error
     3981           or error-status :get-message(1) <> ""
     3982           then do:
     3983             undo move_block, retry move_block.
     3984           end.
     3985         end.
     3986         assign
     3987           frame Dialog-Frame :width = v-frame-width + p-change-value
     3988           no-error .
     3989         if error-status :error
     3990         or error-status :get-message(1) <> ""
     3991         then do:
     3992           undo move_block, retry move_block.
     3993         end.
     3994         assign
     3995           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3996         no-error .
     3997         if error-status :error
     3998         or error-status :get-message(1) <> ""
     3999         then do:
     4000           undo move_block, retry move_block.
     4001         end.
     4002         for each buf_temp-browse-handle
     4003           where buf_temp-browse-handle.browse-type = 'width':u
     4004         on error undo move_block, retry move_block
     4005         :
     4006           assign
     4007             buf_temp-browse-handle.browse-handle :width
     4008               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4009             no-error .
     4010           if error-status :error
     4011           or error-status :get-message(1) <> ""
     4012           then do:
     4013             undo move_block, retry move_block .
     4014           end.
     4015         end.
     4016         for each buf_temp-diasize-handle
     4017         on error undo move_block, retry move_block
     4018         :
     4019           assign
     4020             v-object-handle = buf_temp-diasize-handle.handle-value
     4021           .
     4022           if v-object-handle <> v-diasize-resize-button
     4023           then do:
     4024             assign
     4025               v-object-handle :col = v-object-handle :col + p-change-value
     4026               no-error .
     4027             if error-status :error
     4028             or error-status :get-message(1) <> ""
     4029             then do:
     4030               undo move_block, retry move_block .
     4031             end.
     4032           end.
     4033         end.
     4034       end.
     4035       else do:
     4036         for each buf_temp-diasize-handle
     4037         on error undo move_block, retry move_block
     4038         :
     4039           assign
     4040             v-object-handle = buf_temp-diasize-handle.handle-value
     4041           .
     4042           if v-object-handle <> v-diasize-resize-button
     4043           then do:
     4044             assign
     4045               v-object-handle :col = v-object-handle :col + p-change-value
     4046               no-error .
     4047             if error-status :error
     4048             or error-status :get-message(1) <> ""
     4049             then do:
     4050               undo move_block, retry move_block .
     4051             end.
     4052           end.
     4053         end.
     4054         for each buf_temp-browse-handle
     4055           where buf_temp-browse-handle.browse-type = 'width':u
     4056         on error undo move_block, retry move_block
     4057         :
     4058           assign
     4059             buf_temp-browse-handle.browse-handle :width
     4060               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4061             no-error .
     4062           if error-status :error
     4063           or error-status :get-message(1) <> ""
     4064           then do:
     4065             undo move_block, retry move_block .
     4066           end.
     4067         end.
     4068         assign
     4069           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     4070           no-error .
     4071         if error-status :error
     4072         or error-status :get-message(1) <> ""
     4073         then do:
     4074           undo move_block, retry move_block.
     4075         end.
     4076         assign
     4077           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     4078         no-error .
     4079         if error-status :error
     4080         or error-status :get-message(1) <> ""
     4081         then do:
     4082           undo move_block, retry move_block.
     4083         end.
     4084         if frame Dialog-Frame :scrollable = true
     4085         then do:
     4086           assign
     4087             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4088           no-error .
     4089           if error-status :error
     4090           or error-status :get-message(1) <> ""
     4091           then do:
     4092             undo move_block, retry move_block.
     4093           end.
     4094         end.
     4095       end.
     4096       if p-move-resize
     4097       then do:
     4098         run diasize_position-resize-button in this-procedure .
     4099       end.
     4100       if v-diasize-wndstore = true
     4101       then do:
     4102         if connected("ub") = true
     4103         then do:
     4104           define variable v-cntxt-db-num        as integer   no-undo .
     4105           define variable v-cntxt-userid        as character no-undo .
     4106           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4107                                             , OUTPUT v-cntxt-userid
     4108                                             ) .
     4109           run gbl/wndsizew.p
     4110             (input  v-cntxt-db-num
     4111             ,input  v-cntxt-userid
     4112             ,input  v-diasize-proc-name
     4113             ,input  'width':u
     4114             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     4115             ) .
     4116         end.
     4117       end.
     4118     end.
     4119     assign
     4120       v-diasize-change-size = false
     4121     .
     4122   end procedure.
     4123   procedure diasize_set-width :
     4124     define input  parameter p-new-width  as decimal   no-undo .
     4125     define input  parameter p-move-resize as logical   no-undo .
     4126     do
     4127     on error undo, return error return-value
     4128     :
     4129       run diasize_change-width in this-procedure
     4130         (input  (p-new-width - frame Dialog-Frame :width)
     4131         ,input  p-move-resize
     4132         ) .
     4133     end.
     4134   end procedure.
     4135   procedure diasize_position-resize-button :
     4136     do with frame Dialog-Frame
     4137     :
     4138       hide v-diasize-resize-button .
     4139       assign
     4140         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     4141                     - 1
     4142                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     4143         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     4144                     - 1
     4145                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     4146       .
     4147       view v-diasize-resize-button .
     4148     end.
     4149   end procedure.
     4150   on alt-right anywhere
     4151   do:
     4152     run diasize_change-width in this-procedure
     4153       (input 1
     4154       ,input true
     4155       ) .
     4156     return no-apply .
     4157   end.
     4158   on alt-left anywhere
     4159   do:
     4160     run diasize_change-width in this-procedure
     4161       (input -1
     4162       ,input true
     4163       ) .
     4164     return no-apply .
     4165   end.
     4166   on alt-down anywhere
     4167   do:
     4168     run diasize_change-height in this-procedure
     4169       (input 1
     4170       ,input true
     4171       ) .
     4172     return no-apply .
     4173   end.
     4174   on alt-up anywhere
     4175   do:
     4176     run diasize_change-height in this-procedure
     4177       (input -1
     4178       ,input true
     4179       ) .
     4180     return no-apply .
     4181   end.
     4182   on alt-enter of frame Dialog-Frame
     4183   do:
     4184     run diasize_maximize in this-procedure
     4185       (input  ?
     4186       ).
     4187     return no-apply .
     4188   end.
     4189   procedure diasize_end-move :
     4190     do
     4191     on error undo, return error return-value
     4192     :
     4193       define variable v-row-delta as decimal   no-undo .
     4194       define variable v-col-delta as decimal   no-undo .
     4195       define variable v-new-row as decimal   no-undo .
     4196       define variable v-new-col as decimal   no-undo .
     4197       assign
     4198         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4199         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4200       .
     4201       assign
     4202         v-row-delta = v-new-row - frame Dialog-Frame :height
     4203         v-col-delta = v-new-col - frame Dialog-Frame :width
     4204       .
     4205       run diasize_change-height in this-procedure
     4206         (input v-row-delta
     4207         ,input true
     4208         ) .
     4209       run diasize_change-width in this-procedure
     4210         (input v-col-delta
     4211         ,input true
     4212         ) .
     4213     end.
     4214   end procedure.
     4215   procedure diasize_maximize :
     4216     define input  parameter p-action as logical   no-undo .
     4217     do
     4218     on error undo, return error return-value
     4219     :
     4220       if p-action = ?
     4221       then do:
     4222         if v-diasize-need-maximize = true
     4223         then do:
     4224           assign
     4225             p-action = true
     4226           .
     4227         end.
     4228         else do:
     4229           assign
     4230             p-action = false
     4231           .
     4232         end.
     4233       end.
     4234       if p-action = true
     4235       then do:
     4236         run diasize_change-height in this-procedure
     4237           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4238               - frame Dialog-Frame :height-chars
     4239           ,input true
     4240           ) .
     4241         run diasize_change-width in this-procedure
     4242           (input session :width-chars
     4243               - frame Dialog-Frame :width-chars
     4244           ,input true
     4245           ) .
     4246         assign
     4247           v-diasize-need-maximize = false
     4248         .
     4249       end.
     4250       else do:
     4251         run diasize_change-width in this-procedure
     4252           (input v-diasize-orig-frame-width
     4253               - frame Dialog-Frame :width-chars
     4254           ,input true
     4255           ) .
     4256         run diasize_change-height in this-procedure
     4257           (input v-diasize-orig-frame-height
     4258               - frame Dialog-Frame :height-chars
     4259           ,input true
     4260           ) .
     4261         assign
     4262           v-diasize-need-maximize = true
     4263         .
     4264       end.
     4265     end.
     4266   end procedure.
     4267   procedure diasize_restore-orig-size :
     4268     do
     4269     on error undo, return error return-value
     4270     :
     4271       assign
     4272         v-diasize-current-frame-width  = frame Dialog-Frame :width
     4273         v-diasize-current-frame-height = frame Dialog-Frame :height
     4274       .
     4275       run diasize_set-height in this-procedure
     4276         (input  v-diasize-orig-frame-height
     4277         ,input  true
     4278         ) .
     4279       run diasize_set-width in this-procedure
     4280         (input  v-diasize-orig-frame-width
     4281         ,input  true
     4282         ) .
     4283     end.
     4284   end procedure.
     4285   procedure diasize_restore-current-size :
     4286     do
     4287     on error undo, return error return-value
     4288     :
     4289       run diasize_set-height in this-procedure
     4290         (input  v-diasize-current-frame-height
     4291         ,input  true
     4292         ) .
     4293       run diasize_set-width in this-procedure
     4294         (input  v-diasize-current-frame-width
     4295         ,input  true
     4296         ) .
     4297     end.
     4298   end procedure.
     4299   procedure diasize_set-browse-handle :
     4300     define input  parameter p-browse-handle as handle   no-undo .
     4301     define buffer buf_temp-browse-handle for temp-browse-handle .
     4302     do
     4303     on error undo, return error return-value
     4304     :
     4305       assign
     4306         v-diasize-browse-handle = p-browse-handle
     4307       .
     4308       for each buf_temp-browse-handle
     4309       on error undo, return error return-value
     4310       :
     4311         delete buf_temp-browse-handle .
     4312       end.
     4313     end.
     4314   end procedure.
     4315   procedure diasize_add_browse :
     4316     define input  parameter p-browse-type   as character no-undo .
     4317     define input  parameter p-browse-handle as handle    no-undo .
     4318     define buffer buf_temp-browse-handle for temp-browse-handle .
     4319     do
     4320     on error undo, return error return-value
     4321     :
     4322       assign
     4323         v-diasize-browse-number = v-diasize-browse-number + 1
     4324       .
     4325       create buf_temp-browse-handle .
     4326       assign
     4327         buf_temp-browse-handle.browse-type   = p-browse-type
     4328         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4329         buf_temp-browse-handle.browse-handle = p-browse-handle
     4330       .
     4331     end.
     4332   end procedure.
     4333   procedure diasize_init :
     4334     define variable v-default-value    as logical   no-undo .
     4335     define variable v-restore-saved    as logical   no-undo .
     4336     define variable v-resize-value-str as character no-undo .
     4337     do
     4338     on error undo, return error return-value
     4339     :
     4340       do with frame Dialog-Frame
     4341       :
     4342         assign
     4343           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4344           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4345           v-diasize-browse-handle     = browse br-bc :handle
     4346         .
     4347         create button v-diasize-resize-button
     4348         assign
     4349           parent        = frame Dialog-Frame :first-child
     4350           label         = "s"
     4351           height-pixels = 16
     4352           width-pixels  = 16
     4353           visible       = true
     4354           sensitive     = true
     4355           movable       = true
     4356           triggers:
     4357             on end-move persistent run diasize_end-move in this-procedure .
     4358           end triggers.
     4359         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4360         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4361         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4362         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4363         assign
     4364           v-diasize-wndmax = false
     4365         .
     4366         if connected("ub") = true
     4367         then do:
     4368           define variable v-cntxt-db-num        as integer   no-undo .
     4369           define variable v-cntxt-userid        as character no-undo .
     4370           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4371                                             , OUTPUT v-cntxt-userid
     4372                                             ) .
     4373           run gbl/wndpar_r.p
     4374             (input  v-cntxt-db-num
     4375             ,input  v-cntxt-userid
     4376             ,input  'wndmax':U
     4377             ,output v-diasize-wndmax
     4378             ,output v-default-value
     4379             ) .
     4380         end.
     4381         assign
     4382           v-diasize-wndstore = false
     4383         .
     4384         if connected("ub") = true
     4385         then do:
     4386           run gbl/wndpar_r.p
     4387             (input  v-cntxt-db-num
     4388             ,input  v-cntxt-userid
     4389             ,input  'wndstore':U
     4390             ,output v-diasize-wndstore
     4391             ,output v-default-value
     4392             ) .
     4393         end.
     4394         assign
     4395           v-diasize-proc-name = entry(1, program-name(2), '.')
     4396         .
     4397         if v-diasize-wndstore = true
     4398         then do:
     4399           assign
     4400             v-restore-saved = false
     4401           .
     4402           if connected("ub") = true
     4403           then do:
     4404             run gbl/wndsizer.p
     4405               (input  v-cntxt-db-num
     4406               ,input  v-cntxt-userid
     4407               ,input  v-diasize-proc-name
     4408               ,input  'height':u
     4409               ,output v-resize-value-str
     4410               ) .
     4411             if v-resize-value-str <> '':U
     4412             then do:
     4413               run diasize_change-height in this-procedure
     4414                 (input  integer(v-resize-value-str)
     4415                 ,input  true
     4416                 ) .
     4417               assign
     4418                 v-restore-saved = true
     4419               .
     4420             end.
     4421           end.
     4422           if connected("ub") = true
     4423           then do:
     4424             run gbl/wndsizer.p
     4425               (input  v-cntxt-db-num
     4426               ,input  v-cntxt-userid
     4427               ,input  v-diasize-proc-name
     4428               ,input  'width':u
     4429               ,output v-resize-value-str
     4430               ) .
     4431             if v-resize-value-str <> '':U
     4432             then do:
     4433               run diasize_change-width in this-procedure
     4434                 (input  integer(v-resize-value-str)
     4435                 ,input  true
     4436                 ) .
     4437               assign
     4438                 v-restore-saved = true
     4439               .
     4440             end.
     4441           end.
     4442           if v-restore-saved <> true
     4443           then do:
     4444             if v-diasize-wndmax = true
     4445             then do:
     4446               run diasize_maximize in this-procedure
     4447                 (input  true
     4448                 ) .
     4449             end.
     4450           end.
     4451         end.
     4452         else do:
     4453           if v-diasize-wndmax = true
     4454           then do:
     4455             run diasize_maximize in this-procedure
     4456               (input  true
     4457               ) .
     4458           end.
     4459         end.
     4460       end.
     4461     end.
     4462   end procedure.
     4463   procedure diasize_need-full-display :
     4464     define output parameter p-need-full-display as logical   no-undo .
     4465     do
     4466     on error undo, return error return-value
     4467     :
     4468       assign
     4469         p-need-full-display = v-diasize-need-full-display
     4470       .
     4471       assign
     4472         v-diasize-need-full-display = false
     4473       .
     4474     end.
     4475   end procedure.
     4476   procedure get-context :
     4477      define output parameter p-db-num as integer          no-undo.
     4478      define output parameter p-user-id as character        no-undo.
     4479      define variable v-login               as character    no-undo.
     4480      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4481      define buffer buf_user-login  for ub.user-login .
     4482      do
     4483      on error undo, return error
     4484      :
     4485            FIND FIRST buf_sys-ctrl no-lock.
     4486            ASSIGN
     4487               v-login = USERID("ub")
     4488               p-db-num = buf_sys-ctrl.db-num
     4489            .
     4490            FIND FIRST buf_user-login
     4491                 WHERE buf_user-login.db-num = p-db-num
     4492                   AND buf_user-login.user-login = v-login
     4493                 no-lock
     4494                 no-error
     4495                 .
     4496            IF AVAILABLE buf_user-login
     4497            THEN DO:
     4498               assign
     4499                  p-user-id = buf_user-login.user-id
     4500               .
     4501            END.
     4502      end.
     4503   end procedure.
     4504   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4505   do:
     4506     br-bc :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     4507   end.
     4508   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4509   do:
     4510     br-pbc :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     4511   end.
     4512   MAIN-BLOCK:
     4513   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4514      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4515   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4516     run mainmenu_getcntxt in parparentproc
     4517       (output v-cntxt-db-num
     4518       ,output v-cntxt-userid
     4519       ,output v-cntxt-level
     4520       ,output v-cntxt-host-code-obj
     4521       ,output v-cntxt-obj-type
     4522       ,output v-cntxt-obj-code
     4523       ,output v-cntxt-db-num-obj
     4524       ,output v-cntxt-is-admin
     4525       ) .
     4526     find base-bar-code no-lock where
     4527          base-bar-code.b-code = base-bc no-error .
     4528     if not available base-bar-code then do:
     4529       message
     4530       "Отсутствует бар-код" base-bc
     4531       view-as alert-box error .
     4532       undo, return error .
     4533     end.
     4534     find X_goods no-lock where
     4535          X_goods.gds-code = base-bar-code.gds-code.
     4536     find X_gds-prt no-lock where
     4537          X_gds-prt.node-code = base-bar-code.node-code.
     4538     DISPLAY X_goods.artic X_goods.gds-name WITH FRAME Dialog-Frame.
     4539     find first base_units no-lock where
     4540               base_units.unit-name = X_goods.unit-base no-error.
     4541     find ub.db where
     4542          ub.db.db-num = v-cntxt-db-num no-lock.
     4543   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4544     RUN Myenable IN THIS-PROCEDURE NO-ERROR.
     4545     run UI-on in this-procedure .
     4546     run diasize_add_browse in this-procedure
     4547       (input  'height':u
     4548       ,input  browse br-pbc :handle
     4549       ) .
     4550     run diasize_init in this-procedure .
     4551     WAIT-FOR GO OF FRAME Dialog-Frame.
     4552   END.
     4553   RUN disable_UI.
     4554   run attr-pop-clean-up in this-procedure ( input 'bar-code-attr':U ).
     4555   PROCEDURE choose-to-edit :
     4556   define input parameter p-attr-code as character no-undo .
     4557   assign
     4558   add-option = p-attr-code
     4559   .
     4560   APPLY "CHOOSE" to b-add-attr in frame Dialog-Frame .
     4561   END PROCEDURE.
     4562   PROCEDURE disable_UI :
     4563     HIDE FRAME Dialog-Frame.
     4564   END PROCEDURE.
     4565   PROCEDURE enable_UI :
     4566     DISPLAY Rs-attr-mode
     4567         WITH FRAME Dialog-Frame.
     4568     IF AVAILABLE X_goods THEN
     4569       DISPLAY X_goods.artic X_goods.gds-name
     4570         WITH FRAME Dialog-Frame.
     4571     IF AVAILABLE X_prod-bc THEN
     4572       DISPLAY X_prod-bc.b-str
     4573         WITH FRAME Dialog-Frame.
     4574     ENABLE b-quit B-Help X_goods.artic X_goods.gds-name b-chg-1 b-add b-chg b-del
     4575            b-print-2 b-hist-0 b-on b-dpl b-add-1 b-chg-1 b-del-1 b-gtin-1 b-print-1
     4576            b-hist-2 br-bc BR-pbc Rs-attr-mode b-add-attr b-chg-attr b-del-attr
     4577            br-bc-attr X_prod-bc.b-str
     4578         WITH FRAME Dialog-Frame.
     4579     VIEW FRAME Dialog-Frame.
     4580     OPEN QUERY br-bc FOR EACH X_bar-code NO-LOCK INDEXED-REPOSITION.    OPEN QUERY br-bc-attr FOR EACH temp-bar-code-attr NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BR-pbc FOR EACH X_prod-bc NO-LOCK INDEXED-REPOSITION.
     4581   END PROCEDURE.
     4582   PROCEDURE init-attr-proc :
     4583   define variable attr-type as character no-undo .
     4584   define variable attr-format as character no-undo .
     4585   define variable attr-label as character no-undo .
     4586   define variable attr-value as character no-undo .
     4587   define variable attr-range as integer no-undo .
     4588   define variable attr-user-can-edit as logical no-undo .
     4589   define variable attr-output-display as logical no-undo .
     4590   define variable attr-other as char no-undo .
     4591   define buffer buf_bar-code for ub.bar-code.
     4592   define buffer buf_bar-code-obj-attr for ub.bar-code-obj-attr.
     4593   for each  Temp-bar-code-attr share-lock:
     4594      delete Temp-bar-code-attr.
     4595    end.
     4596   add-option = "".
     4597   For each buf_bar-code-obj-attr where
     4598           buf_bar-code-obj-attr.gds-code  = base-bar-code.gds-code
     4599           no-lock :
     4600     run bc-oattr_name in this-procedure (
     4601                                          input  buf_bar-code-obj-attr.attr-code
     4602                                         ,output attr-type
     4603                                         ,output attr-format
     4604                                         ,output attr-label
     4605                                         ,output attr-range
     4606                                         ,output attr-user-can-edit
     4607                                         ,output attr-output-display
     4608                                         ,output attr-other ).
     4609     if attr-output-display = true then DO:
     4610       find first buf_bar-code no-lock where
     4611                 buf_bar-code.b-code = buf_bar-code-obj-attr.b-code no-error.
     4612       create temp-bar-code-attr.
     4613       buffer-copy buf_bar-code-obj-attr
     4614       to temp-bar-code-attr
     4615       assign
     4616       temp-bar-code-attr.attr-label = attr-label
     4617       temp-bar-code-attr.user-can-edit = attr-user-can-edit
     4618       temp-bar-code-attr.unit-cli = (if available buf_bar-code
     4619                                      then buf_bar-code.unit-cli
     4620                                      else chr(63))
     4621       temp-bar-code-attr.cli-base-rate = (if available buf_bar-code
     4622                                      then buf_bar-code.cli-base-rate
     4623                                      else ?)
     4624       .
     4625       release temp-bar-code-attr.
     4626     End.
     4627   End.
     4628   END PROCEDURE.
     4629   PROCEDURE MyEnable :
     4630   do:
     4631       define variable v-tth as handle no-undo.
     4632       define variable v-chg-bcod as logical no-undo.
     4633       define variable v-value-character as character no-undo.
     4634       define variable v-value-date as date no-undo.
     4635       define variable v-value-decimal as decimal no-undo.
     4636       define variable v-value-integer as INTEGER no-undo.
     4637       define variable v-value-logical AS LOGICAL no-undo.
     4638       define variable v-param-type as character no-undo.
     4639       define buffer buf_goods-attr for goods-attr.
     4640       assign v-tth = buffer thbjattr_thbj-attr:table-handle.
     4641       FOR EACH thbjattr_thbj-attr:
     4642           delete thbjattr_thbj-attr.
     4643       end.
     4644       run adm/shattri.p (
     4645                 input "get":U
     4646               , input v-cntxt-obj-type
     4647               , input v-cntxt-obj-code
     4648               , input 'gds-ref_obj':U
     4649               , input 'chg-bcod':U
     4650               , output v-value-character
     4651               , output v-value-date
     4652               , output v-value-decimal
     4653               , output v-value-integer
     4654               , output v-value-logical
     4655               , output v-param-type
     4656               , INPUT-OUTPUT table-handle v-tth
     4657               ) no-error .
     4658        v-chg-bcod = v-value-logical.
     4659   end.
     4660   ENABLE
     4661   b-print-2 br-bc br-pbc b-quit b-help b-hist-2 b-hist-0
     4662   b-add-1 when v-cntxt-level = 'object':U and v-chg-bcod = no
     4663   b-gtin-1 when v-cntxt-level = 'object':U and v-chg-bcod = no
     4664   b-del-1 when v-cntxt-level = 'object':U and v-chg-bcod = no
     4665   b-chg-1 when v-cntxt-level = 'object':U and v-chg-bcod = no
     4666   b-on    when v-cntxt-level = 'object':U and v-chg-bcod = no
     4667   b-dpl   when v-chg-bcod = no
     4668   b-print-1 WITH FRAME Dialog-Frame.
     4669   X_prod-bc.b-str:COLUMN-READ-ONLY IN BROWSE br-pbc = YES.
     4670   if not transaction then do:
     4671       if ub.db.add-goods and v-cntxt-level = 'object':U then do:
     4672         ENABLE
     4673         b-add
     4674         b-del
     4675         b-chg
     4676         WITH FRAME Dialog-Frame.
     4677       end.
     4678   end.
     4679   define variable hh as widget-handle no-undo .
     4680   assign
     4681   hh = b-print-1:handle in frame Dialog-Frame.
     4682   hh:load-image("cmp/b-print.bmp":u).
     4683   hh:TOOLTIP = "Печать".
     4684   hh = b-print-2:handle in frame Dialog-Frame.
     4685   hh:load-image("cmp/b-print.bmp":u).
     4686   hh:TOOLTIP = "Печать".
     4687   hh = b-hist-0:handle in frame Dialog-Frame.
     4688   hh:load-image("cmp/b-hist.bmp":u).
     4689   hh:TOOLTIP = "История собственных кодов".
     4690   hh = b-hist-2:handle in frame Dialog-Frame.
     4691   hh:load-image("cmp/b-hist.bmp":u).
     4692   hh:TOOLTIP = "История дополнительных кодов" .
     4693   ASSIGN
     4694   b-add-attr:POPUP-MENU IN FRAME Dialog-Frame = MENU MENU-b-add-attr:HANDLE
     4695   b-add-attr:MENU-MOUSE = 1
     4696   .
     4697   if base-bar-code.unit-cli = X_goods.unit-base
     4698   and lookup(base_units.type, 'вес':U) > 0 then do:
     4699     run init-attr-proc in this-procedure.
     4700     rs-attr-mode:radio-buttons in frame Dialog-Frame = "Бар-код" + chr(44) + "b-code" + chr(44) +
     4701                                                         "Все бар-коды" + chr(44) + 'все':U.
     4702     enable
     4703     b-add-attr when (ub.db.add-goods and v-cntxt-level = 'object':U )
     4704     b-chg-attr when (ub.db.add-goods and v-cntxt-level = 'object':U )
     4705     b-del-attr when (ub.db.add-goods and v-cntxt-level = 'object':U )
     4706     br-bc-attr
     4707     rs-attr-mode
     4708     with frame Dialog-Frame .
     4709     ASSIGN
     4710     temp-bar-code-attr.attr-label:resizable in browse br-bc-attr = yes
     4711     temp-bar-code-attr.attr-value:resizable in browse br-bc-attr = yes
     4712     browse br-bc:height = 9
     4713     browse br-pbc:height = 9
     4714     .
     4715     if ub.db.add-goods
     4716     ThEN do:
     4717       run attr-pop-create-items in this-procedure  (
     4718                                                     input 'bar-code-attr':U
     4719                                                     ,input 'bc-oattr_manual-edit'
     4720                                                     ,input 'bc-oattr_tooltip'
     4721                                                     ,input 'choose-to-edit'
     4722                                                     ,input menu menu-b-add-attr:handle
     4723                                                     ,input 'taracode-bc':U
     4724                                                   ).
     4725     end.
     4726   end.
     4727   else do:
     4728     hide
     4729     b-add-attr in frame Dialog-Frame
     4730     b-chg-attr in frame Dialog-Frame
     4731     b-del-attr in frame Dialog-Frame
     4732     br-bc-attr in frame Dialog-Frame
     4733     rs-attr-mode in frame Dialog-Frame
     4734     .
     4735   end.
     4736   if base-bar-code.in-code = "" then
     4737     if X_gds-prt.upper-code = X_goods.prt-root then
     4738       frame Dialog-Frame:title = "Коды: ТОВАР".
     4739     else
     4740       frame Dialog-Frame:title = "Коды: ПРИЗНАК: " + X_gds-prt.f-name.
     4741   else
     4742     frame Dialog-Frame:title = "Коды: ПАРТИЯ: ПН: " + base-bar-code.in-code +
     4743                                 " Номер: " + base-bar-code.part-code.
     4744   view frame Dialog-Frame .
     4745   END PROCEDURE.
     4746   PROCEDURE Openbr-bc :
     4747   OPEN QUERY br-bc
     4748     FOR EACH  X_bar-code no-lock WHERE
     4749               X_bar-code.gds-code  = base-bar-code.gds-code and
     4750               X_bar-code.node-code = base-bar-code.node-code and
     4751               X_bar-code.part-code = base-bar-code.part-code and
     4752               X_bar-code.in-code   = base-bar-code.in-code.
     4753   END PROCEDURE.
     4754   PROCEDURE Openbr-bc-attr :
     4755   define input parameter p-bc-attr-mode as character no-undo .
     4756   case p-bc-attr-mode:
     4757     when 'все':U then do:
     4758       open query br-bc-attr
     4759       for each temp-bar-code-attr no-lock.
     4760     end.
     4761     when "b-code" then do:
     4762       if available X_bar-code then do:
     4763         open query br-bc-attr
     4764         for each temp-bar-code-attr where
     4765         temp-bar-code-attr.b-code = X_bar-code.b-code no-lock.
     4766       end.
     4767       else do:
     4768         open query br-bc-attr
     4769         for each temp-bar-code-attr where
     4770         false no-lock.
     4771       end.
     4772     end.
     4773   end case.
     4774   END PROCEDURE.
     4775   PROCEDURE proc-add-attr :
     4776   define variable attr-type as character no-undo .
     4777   define variable attr-format as character no-undo .
     4778   define variable attr-label as character no-undo .
     4779   define variable attr-range as integer no-undo .
     4780   define variable attr-user-can-edit as logical no-undo .
     4781   define variable attr-output-display as logical no-undo .
     4782   define variable attr-other as char no-undo .
     4783   define variable loc#log as logical no-undo.
     4784   define buffer buf_temp-bar-code-attr for temp-bar-code-attr.
     4785   if add-option = "" then do:
     4786     run gbl/pop-up.p ( input self:handle, input no) no-error.
     4787   end.
     4788   if add-option = "":U then return no-apply.
     4789   run proc-attr-add-chg in this-procedure ( input yes
     4790                                       ,input ?
     4791                                       ,input ?
     4792                                      ) no-error .
     4793   if error-status:error then do:
     4794     add-option = "":U.
     4795     return no-apply.
     4796   end.
     4797   Run init-attr-proc in this-procedure .
     4798   run openbr-bc-attr in this-procedure ( input attr-mode) no-error.
     4799   find first buf_temp-bar-code-attr no-lock where
     4800                           buf_temp-bar-code-attr.attr-code = add-option no-error.
     4801   add-option = "":U.
     4802   if avail buf_temp-bar-code-attr then
     4803       temp-doc-rec = recid(buf_temp-bar-code-attr).
     4804       else temp-doc-rec = ?.
     4805   reposition br-bc-attr to recid temp-doc-rec no-error.
     4806   if error-status:error then return no-apply.
     4807   END PROCEDURE.
     4808   PROCEDURE proc-attr-add-chg :
     4809   define input parameter p-add as logical no-undo.
     4810   define input parameter p-obj-type as character no-undo .
     4811   define input parameter p-obj-code as integer no-undo .
     4812   define variable attr-type as character no-undo .
     4813   define variable attr-format as character no-undo .
     4814   define variable attr-label as character no-undo .
     4815   define variable attr-range as integer no-undo .
     4816   define variable attr-user-can-edit as logical no-undo .
     4817   define variable attr-output-display as logical no-undo .
     4818   define variable attr-other as char no-undo .
     4819   define variable attr-value as char no-undo .
     4820   DEFINE VARIABLE v-attr-value as character no-undo .
     4821   define var loc#log as logical no-undo.
     4822   DEFINE VARIABLE v-init as character no-undo .
     4823   define variable jj as integer no-undo.
     4824   DEFINE VARIABLE v-spr as character no-undo .
     4825   define variable v-spr-param as character no-undo .
     4826   DEFINE VARIABLE v-setted as logical no-undo .
     4827   DEFINE VARIABLE v-deleted as logical no-undo .
     4828   define variable v-check as character no-undo .
     4829   define variable v-error-code as character no-undo .
     4830   define variable v-correct as logical no-undo .
     4831   define variable v-local-option as character no-undo .
     4832   CASE p-add:
     4833     when yes then do:
     4834       v-local-option = add-option.
     4835       run bc-oattr_name in this-procedure
     4836         (input  v-local-option
     4837         ,output attr-type
     4838         ,output attr-format
     4839         ,output attr-label
     4840         ,output attr-range
     4841         ,output attr-user-can-edit
     4842         ,output attr-output-display
     4843         ,output attr-other
     4844         ) no-error .
     4845       if error-status :error then do:
     4846         return error .
     4847       end.
     4848       case attr-range:
     4849         when  0 then do:
     4850           assign
     4851           p-obj-type = ''
     4852           p-obj-code = 0
     4853           .
     4854         end.
     4855         when  2 then do:
     4856           assign
     4857           p-obj-type = v-cntxt-obj-type
     4858           p-obj-code = v-cntxt-obj-code
     4859           .
     4860         end.
     4861        end case.
     4862        run bc-oattr_exist in this-procedure(
     4863                                        input X_bar-code.b-code
     4864                                       ,input v-local-option
     4865                                       ,input p-obj-type
     4866                                       ,input p-obj-code
     4867                                       ,output loc#log)  no-error.
     4868       if error-status:error then return error.
     4869       if loc#log then do:
     4870         message
     4871         "Данный атрибут уже существует"
     4872         view-as alert-box error .
     4873         return error.
     4874       end.
     4875       do jj = 1 to num-entries(attr-other, chr(47)):
     4876         if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "init":U then do:
     4877           assign
     4878           v-init = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     4879           .
     4880         end.
     4881       end.
     4882       if  v-init <> "":U then do:
     4883         run  value(v-init)
     4884                     in this-procedure ( input X_bar-code.b-code
     4885                                       , input p-obj-type
     4886                                       , input p-obj-code
     4887                                       , output attr-value) no-error .
     4888         if error-status:error then do:
     4889           assign
     4890           attr-value = "":U
     4891           .
     4892         end.
     4893       end.
     4894       CASE attr-type:
     4895         when 'L':U then do:
     4896           assign
     4897           v-attr-value = "yes":U
     4898           .
     4899         end.
     4900         when 'I':U or when 'D':U then do:
     4901           assign
     4902           v-attr-value = if v-init <> "":U
     4903                         then attr-value
     4904                         else string(0)
     4905           .
     4906         end.
     4907         when 'T':U then do:
     4908           assign
     4909           v-attr-value = ?
     4910           .
     4911         end.
     4912         when 'C':U then do:
     4913           assign
     4914           v-attr-value = if v-init <> "":U
     4915                         then attr-value
     4916                         else "":U
     4917           .
     4918         end.
     4919       END CASE.
     4920       assign
     4921       attr-value = v-attr-value
     4922       .
     4923     end.
     4924     when no then do:
     4925       v-local-option = temp-bar-code-attr.attr-code.
     4926       run bc-oattr_name in this-procedure ( input temp-bar-code-attr.attr-code
     4927                                          ,output attr-type
     4928                                          ,output attr-format
     4929                                          ,output attr-label
     4930                                          ,output attr-range
     4931                                          ,output attr-user-can-edit
     4932                                          ,output attr-output-display
     4933                                          ,output attr-other) no-error.
     4934       IF ERROR-STATUS:ERROR THEN DO:
     4935         return error.
     4936       END.
     4937       attr-value  = temp-bar-code-attr.attr-value.
     4938     end.
     4939   END CASE.
     4940   IF attr-user-can-edit Then DO:
     4941     do jj = 1 to num-entries(attr-other, chr(47)):
     4942       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr-ext":U
     4943       or entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr":U
     4944       then do:
     4945         assign
     4946         v-spr = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     4947         .
     4948       end.
     4949       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "spr-param":U then do:
     4950         assign
     4951         v-spr-param = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     4952         .
     4953       end.
     4954       if entry(1, entry(jj, attr-other, chr(47)), "=":U) = "check-ext":U then do:
     4955         assign
     4956         v-check = string(entry(2, entry(jj, attr-other, chr(47)), "=":U))
     4957         .
     4958       end.
     4959     end.
     4960     if v-spr = "":U then do:
     4961       run gbl/d-prompt.w (
     4962         'title=':u + "Изменение атрибута бар-кода" + '\':u
     4963       + 'text1=':u + attr-label + '\':u
     4964       + 'format=' + (if attr-type = 'L':U then "yes/no" else attr-format) + '\':u
     4965       + 'type=' + attr-type + '\':u
     4966       + 'fillin_row=2\':u
     4967       + 'fillin_col=4\':u
     4968       + 'fillin_width=20\':u
     4969       + 'fillin_height=1\':u
     4970       + 'max-chars=70\':u
     4971       + 'readonly=' + 'no':u + '\':u
     4972       , input-output attr-value
     4973       ).
     4974       if return-value = 'false':u then return error.
     4975     end.
     4976     else do:
     4977       if v-spr-param = "":U then do:
     4978         run  value(v-spr) in this-procedure
     4979                                       (
     4980                                          input parparentproc
     4981                                         ,input X_bar-code.b-code
     4982                                         ,input p-obj-type
     4983                                         ,input p-obj-code
     4984                                         ,input-output attr-value
     4985                                         ,output v-setted) no-error .
     4986       end.
     4987       else do:
     4988         run  value(v-spr) in this-procedure
     4989                                      (
     4990                                          input parparentproc
     4991                                         ,input X_bar-code.b-code
     4992                                         ,input p-obj-type
     4993                                         ,input p-obj-code
     4994                                         ,input v-spr-param
     4995                                         ,input-output attr-value
     4996                                         ,output v-setted) no-error .
     4997       end.
     4998      if not v-setted then return error.
     4999     end.
     5000     if v-check <> "":U then do:
     5001       run value(v-check)(
     5002                          input X_bar-code.b-code
     5003                         ,input p-obj-type
     5004                         ,input p-obj-code
     5005                         ,input attr-value
     5006                         ,input (if p-add then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     5007                         ,output v-correct
     5008                         ,output v-error-code) no-error.
     5009       if error-status:error then do:
     5010         message
     5011         "Ошибка при проверке корректности задаваемого значения атрибута" skip
     5012         error-status:get-message(1) skip
     5013         view-as alert-box error .
     5014         undo, return error .
     5015       end.
     5016       if not v-correct then do:
     5017         message
     5018         "Задаваемое значение атрибута некорректно" skip
     5019         return-value
     5020         view-as alert-box error .
     5021         undo, return error .
     5022       end.
     5023     end.
     5024     run bc-oattr_write in this-procedure (
     5025          input X_bar-code.b-code
     5026         ,input v-local-option
     5027         ,input p-obj-type
     5028         ,input p-obj-code
     5029         ,input attr-value) no-error .
     5030     IF not error-status:error then do:
     5031        br-bc-attr:refresh() in frame Dialog-Frame no-error .
     5032     END.
     5033     else do:
     5034       message
     5035       "Ошибка при сохранении атрибута бар-кодв" skip
     5036       "бар-код" X_bar-code.b-code skip
     5037       "Атрибут" v-local-option
     5038       view-as alert-box  error .
     5039       undo, return error  .
     5040     end.
     5041   End.
     5042   Else message "Изменение атрибута невозможно !" view-as alert-box error.
     5043   END PROCEDURE.
     5044   PROCEDURE ui-on :
     5045   RUN Openbr-bc IN THIS-PROCEDURE.
     5046   apply "entry"         to br-bc in frame Dialog-Frame.
     5047   apply "value-changed" to br-bc in frame Dialog-Frame.
     5048   if br-bc-attr:visible in frame Dialog-Frame then do:
     5049     run openbr-bc-attr in this-procedure ( input attr-mode) no-error.
     5050   end.
     5051   END PROCEDURE.
