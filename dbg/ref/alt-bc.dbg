     2536       then do:
     2537         if case-num = 1 then v-cdrg-type = 'sslc':U.
     2538         if case-num = 2 then v-cdrg-type = 'ssgb':U.
     2539         FOR EACH buf2_code-range No-LOCK WHERE
     2540             buf2_code-range.range-type = (if case-num = 1 then 'sslc':U else 'ssgb':U)
     2541         and buf2_code-range.db-num = (if case-num = 1 then 0 else v-cntxt-db-num):
     2542           assign
     2543           vattr-labels = vattr-labels +
     2544                         (if vattr-labels = "":U
     2545                           then "":U
     2546                           else chr(44)) +
     2547                           string(buf2_code-range.first-code, "999999999") + "-":U + string(buf2_code-range.last-code, "999999999") +
     2548                           fill(chr(32), 5) + "----->":U +
     2549                           fill(chr(32), 5) +
     2550                           MakeShbl(buf2_code-range.first-code , buf2_code-range.last-code)
     2551           vattr-codes =  vattr-codes +
     2552                         (if vattr-codes = "":U
     2553                           then "":U
     2554                           else chr(44)) +
     2555                           chr(32) +
     2556                           MakeShbl(buf2_code-range.first-code , buf2_code-range.last-code)
     2557           .
