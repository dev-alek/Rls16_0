     2109         X_bar-code SCROLLING.
     2110   DEFINE QUERY br-bc-attr FOR
     2111         temp-bar-code-attr SCROLLING.
     2112   DEFINE QUERY BR-pbc FOR
     2113         X_prod-bc SCROLLING.
     2114   DEFINE BROWSE br-bc
     2115     QUERY br-bc NO-LOCK DISPLAY
     2116         X_bar-code.b-code FORMAT "9999999999":U
     2117         X_bar-code.unit-cli COLUMN-LABEL "Изм."
     2118         X_bar-code.cli-base-rate COLUMN-LABEL "Коэф." FORMAT ">,>>9.<<<"
