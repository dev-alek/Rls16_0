     2813                     , this-procedure
     2814                     , 'str/send-bc.p':U
     2815                     , string(recid(X_bar-code)) + chr(4) + "D":U
     2816                     , yes
     2817                     , '':U
     2818                     , 'Удаление бар-кода с кассы') .
     2819       end.
     2820       else do:
     2821         message
     2822         "Не удается послать на все БД команду удаления бар-кода" skip
     2823         string(if error-status:error
     2824         then (error-status:get-message(1) + chr(10) + return-value )
     2825         else return-value )
     2826         view-as alert-box error .
     2827      end.
     2828     end.
     2829     else do:
     2830         if send-ref then
     2831         run str/diallog.w ( parparentproc
     2832                     , this-procedure
     2833                     , 'str/send-bc.p':U
     2834                     , string(recid(X_bar-code)) + chr(4) + "D":U
     2835                     , yes
     2836                     , '':U
     2837                     , 'Удаление бар-кода с кассы') .
     2838         delete locked_bar-code .
     2839     end.
     2840   end.
     2841   run ui-on IN THIS-PROCEDURE .
     2842   apply "entry" to br-bc in frame Dialog-Frame.
     2843   END.
     2844   ON CHOOSE OF b-del-1 IN FRAME Dialog-Frame
     2845   DO:
     2846    define variable glog as logical no-undo .
     2847   define buffer buf_prod-bc for ub.prod-bc.
     2848   define buffer buf_bar-code for ub.bar-code.
     2849   define buffer buf_units for ub.units.
     2850   if not available X_prod-bc then
     2851     return no-apply.
     2852   find buf_bar-code where
     2853        buf_bar-code.b-code = X_prod-bc.b-code no-lock.
     2854   find buf_units where
     2855        buf_units.unit-name = buf_bar-code.unit-cli no-lock.
     2856   find first buf_prod-bc exclusive-lock where
     2857             buf_prod-bc.b-str = X_prod-bc.b-str
     2858         and buf_prod-bc.b-code = X_prod-bc.b-code .
     2859   if lookup ('вес':U, buf_units.type) > 0 then do:
     2860     if IS-GLOBAL(buffer buf_prod-bc) then do:
     2861       message
     2862       "Нельзя удалить ГЛОБАЛЬНЫЙ весовой код"
     2863               view-as alert-box error.
     2864       return no-apply.
     2865     end.
     2866   end.
     2867   if buf_prod-bc.bc-on-type = 'pglc':U
     2868   or (lookup ('вес':U, buf_units.type) > 0
     2869       and  IS-GLOBAL(buffer buf_prod-bc) = no)
     2870   and buf_prod-bc.bc-on = yes
     2871   then do:
     2872     message
     2873     "Нельзя удалить ВКЛЮЧЕННЫЙ весовой код или штучный код для весов."
     2874             view-as alert-box error.
     2875     return no-apply.
     2876   end.
     2877   if (buf_prod-bc.bc-on-type = 'pglc':U
     2878   or buf_prod-bc.bc-on-type = 'sclc':U
     2879   or buf_prod-bc.bc-on-type = 'scgb':U
     2880   or lookup ('вес':U, buf_units.type) > 0)
     2881   and buf_prod-bc.cr-db-num <> v-cntxt-db-num
     2882   then do:
     2883     message
     2884     "Нельзя удалить весовой код или штучный код для весов, созданный в другой БД."
     2885      view-as alert-box error.
     2886     return no-apply.
     2887   end.
     2888   glog = no.
     2889   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2890   do:
     2891     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2892       (input  v-cntxt-db-num
     2893       ,input  v-cntxt-userid
     2894       ,input  0
     2895       ,input  'actn_alt-barcode_deletion':U
     2896       ,input  'global':U
     2897       ,input  0
     2898       ,input  '':U
     2899       ,input  0
     2900       ,input  0
     2901       ,input  X_goods.grp-code
     2902       ,input  0
     2903       ,input  true
     2904       ,output glog
     2905       )  .
     2906   end.
     2907   if not glog then return no-apply.
     2908   glog = no.
     2909   message
     2910   "Удалить дополнительный бар-код:" X_prod-bc.b-str "? Вы уверены ?"
     2911   view-as alert-box question buttons OK-Cancel update glog.
     2912   if not glog then  return no-apply.
     2913   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2914   do:
