     1748   :
     1749       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     1750       (input  p-upper-code
     1751       ,input  p-code
     1752       ,output p-label
     1753       ,output p-user-can-edit
     1754       ,output p-output-display
     1755       ,output p-other
