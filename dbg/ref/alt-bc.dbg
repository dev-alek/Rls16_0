     2522                         , (if glog then "" else "^disable")
     2523                         , (if glog2 then "" else "^disable")
     2524                            )
     2525         ,input ("Локальный Код, по которому товар будет взвешиваться на сканер-весах кассы - ИХ КОЛИЧЕСТВО ОГРАНИЧЕНО|"
     2526             +  "Глобальный Код, по которому товар будет взвешиваться на сканер-весах кассы - ИХ КОЛИЧЕСТВО ОГРАНИЧЕНО|"
