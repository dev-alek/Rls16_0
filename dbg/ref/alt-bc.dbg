     2102   DEFINE VARIABLE Rs-attr-mode AS CHARACTER
     2103        VIEW-AS RADIO-SET HORIZONTAL
     2104        RADIO-BUTTONS
     2105             "Бар-код", "1",
     2106   "Все бар-коды", "2"
     2107        SIZE 24 BY 1 NO-UNDO.
