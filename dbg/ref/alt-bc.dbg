     2947   ON CHOOSE OF b-del-attr IN FRAME Dialog-Frame
     2948   DO:
     2949   define variable loc#log as logical no-undo.
     2950   define variable attr-type as character no-undo .
     2951   define variable attr-format as character no-undo .
     2952   define variable attr-label as character no-undo .
     2953   define variable attr-range as integer no-undo .
     2954   define variable attr-user-can-edit as logical no-undo .
     2955   define variable attr-output-display as logical no-undo .
     2956   define variable attr-other as char no-undo .
     2957   define variable glog as logical no-undo .
     2958   DEFINE VARIABLE v-check AS CHARACTER NO-UNDO.
     2959   define variable v-correct as logical no-undo .
     2960   define variable v-error-code as character no-undo .
     2961   DEFINE VARIABLE jj AS INTEGER NO-UNDO.
     2962   if attr-mode = 'все':U then return no-apply.
     2963   if not avail temp-bar-code-attr then return no-apply.
     2964   run bc-oattr_name (
     2965    input  temp-bar-code-attr.attr-code
     2966   ,output attr-type
     2967   ,output attr-format
     2968   ,output attr-label
     2969   ,output attr-range
     2970   ,output attr-user-can-edit
     2971   ,output attr-output-display
     2972   ,output attr-other
     2973   ) .
     2974   if not attr-user-can-edit then do:
     2975   message
     2976   "Атрибут нельзя удалить вручную"
     2977   view-as alert-box error .
     2978   return no-apply.
     2979   end.
     2980   glog = no.
     2981   message
     2982   substitute("Вы уверены, что хотите удалить атрибут &1 для бар-кода &2"
     2983             ,temp-bar-code-attr.attr-label
     2984             ,X_bar-code.b-code)
     2985   view-as alert-box QUESTIOn buttons YES-NO update glog.
     2986   if NOT glog then return no-apply.
     2987   run bc-oattr_delete in this-procedure(
     2988                                    input X_bar-code.b-code
     2989                                   ,input temp-bar-code-attr.attr-code
     2990                                   ,input temp-bar-code-attr.obj-type
     2991                                   ,input temp-bar-code-attr.obj-code
     2992                                   ,output loc#log) no-error .
     2993   if error-status:error or not loc#log then do:
     2994     message
     2995     "Ошибка при удалении атрибута бар-кода" skip
     2996     error-status:get-message(1) skip
     2997     return-value
     2998     view-as alert-box error .
     2999     return no-apply.
     3000   end.
     3001   delete temp-bar-code-attr.
     3002   run init-attr-proc in this-procedure .
     3003   run openbr-bc-attr in this-procedure ( input attr-mode) no-error.
     3004   END.
     3005   ON CHOOSE OF b-dpl IN FRAME Dialog-Frame
     3006   DO:
     3007   def buffer prod-on for ub.prod-bc.
     3008   def buffer bc-on   for ub.bar-code.
     3009   define variable rid as recid no-undo.
     3010   define variable v-rep-rec as recid no-undo .
     3011     if not available X_prod-bc then do:
     3012       message "Неправильно выбран дополнительный бар-код."
     3013               view-as alert-box error.
     3014       return no-apply.
     3015     end.
     3016     v-rep-rec = recid (X_prod-bc).
     3017     if not can-find (first prod-on where
     3018                            prod-on.b-str = X_prod-bc.b-str and
     3019                            recid (prod-on) <> v-rep-rec no-lock) then do:
     3020       message "Для данного доп. бар-кода нет повторных."
     3021               view-as alert-box .
     3022       return no-apply.
     3023     end.
     3024     rid = recid (X_prod-bc).
     3025     run ref/bc-rcnz.w (
     3026                    input parparentproc,
     3027                    input p-curr-obj-type,
     3028                    input p-curr-obj-code,
     3029                    input X_prod-bc.b-str,
     3030                    input 0,
     3031                    input (if transaction then 'ПРОСМОТР':U else 'ИЗМЕНЕНИЕ':U),
     3032                    input-output rid).
     3033     run UI-on.
     3034     apply "entry" to br-pbc in frame Dialog-Frame.
     3035     reposition br-pbc to recid v-rep-rec no-error.
     3036   END.
     3037   ON CHOOSE OF b-gtin-1 IN FRAME Dialog-Frame
     3038   DO:
     3039       define variable glog as logical no-undo .
     3040   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
