     2563                               else "Диапазоны и шаблоны глобальных взвешиваемых кодов")
     2564                      ,INPUT vattr-codes
     2565                      ,INPUT vattr-labels
     2566                      ,INPUT chr(44)
     2567                      ,INPUT "":U
     2568                      ,output voutput).
     2569         IF voutput = "":u THEN RETURN NO-APPLY.
