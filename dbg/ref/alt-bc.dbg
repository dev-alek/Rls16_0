     1514   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1515   define temp-table tt-attr-property  no-undo
     1516   field upper-attr-code as character
     1517   field attr-code as character
     1518   field table-name as character
     1519   field edit-menu-section-num as integer
     1520   field attr-label as character
     1521   field menu-item-handle as widget-handle
     1522   field user-can-edit as logical
     1523   field menu-name as character
     1524   field parent-handle as handle
     1525   index pi is unique primary
     1526   table-name
     1527   menu-name
     1528   upper-attr-code
     1529   attr-code
     1530   index i-section
     1531   edit-menu-section-num
     1532   .
     1533   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1534   procedure attr-pop-create-items :
     1535   define input parameter p-table-name as character no-undo .
     1536   define input parameter p-get-section-num-proc-name as character no-undo .
     1537   define input parameter p-get-attr-label-proc-name as character no-undo .
     1538   define input parameter p-attr-choose-proc-name as character no-undo .
     1539   define input parameter p-menu-handle as widget-handle no-undo .
     1540   define input parameter p-attr-list as character no-undo .
     1541   define variable ii as integer no-undo .
     1542   define variable V-CREATED as logical no-undo .
     1543   define variable v-tool-tip as character no-undo .
     1544   define variable v-dop as character no-undo .
     1545   define variable v-attr-item as character no-undo .
     1546   define variable p-upper-attr-code as character no-undo .
     1547   define buffer buf_tt-attr-property for tt-attr-property.
     1548     do
     1549     on error undo, return error return-value
     1550     :
     1551        do ii = 1 to num-entries (p-attr-list):
     1552          v-attr-item = entry(ii, p-attr-list) .
     1553          find first tt-attr-property where
     1554                    tt-attr-property.table-name = p-table-name
     1555                and tt-attr-property.attr-code = v-attr-item
     1556                and tt-attr-property.upper-attr-code = p-upper-attr-code
     1557                and tt-attr-property.menu-name = p-menu-handle:name  no-error .
     1558          if not available tt-attr-property then do:
     1559            create tt-attr-property.
     1560            assign
     1561            tt-attr-property.table-name = p-table-name
     1562            tt-attr-property.attr-code = v-attr-item
     1563            tt-attr-property.upper-attr-code = p-upper-attr-code
     1564            tt-attr-property.menu-name = p-menu-handle:name
     1565            .
     1566            run value ( p-get-section-num-proc-name) (
     1567                                                      input tt-attr-property.attr-code
     1568                                                     ,output tt-attr-property.edit-menu-section-num ) no-error .
     1569            run value ( p-get-attr-label-proc-name ) (
     1570                                           input tt-attr-property.attr-code
     1571                                          ,output v-tool-tip
     1572                                          ,output tt-attr-property.attr-label
     1573                                         ) no-error .
     1574            release tt-attr-property.
     1575          end.
     1576        end.
     1577        for each tt-attr-property where tt-attr-property.menu-name = p-menu-handle:name
     1578        break
     1579        by  tt-attr-property.edit-menu-section-num
     1580        by  tt-attr-property.attr-label
     1581        :
     1582          if tt-attr-property.edit-menu-section-num > 0
     1583          then do:
     1584             if not valid-handle(tt-attr-property.menu-item-handle) then do:
     1585               if num-entries(tt-attr-property.attr-code, chr(4)) > 1
     1586               and entry(2, tt-attr-property.attr-code, chr(4)) <> '':U
     1587               then do:
     1588                 find first buf_tt-attr-property where
     1589                           buf_tt-attr-property.table-name = p-table-name
     1590                       and buf_tt-attr-property.menu-name = p-menu-handle:name
     1591                       and buf_tt-attr-property.upper-attr-code = p-upper-attr-code
     1592                       and buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4)) no-error .
     1593                 if not available buf_tt-attr-property then do:
     1594                   create buf_tt-attr-property.
     1595                   assign
     1596                   buf_tt-attr-property.table-name = p-table-name
     1597                   buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4))
     1598                   buf_tt-attr-property.upper-attr-code = p-upper-attr-code
     1599                   buf_tt-attr-property.menu-name = p-menu-handle:name
     1600                   .
     1601                   create sub-menu buf_tt-attr-property.menu-item-handle
     1602                   assign
     1603                   name = entry(1, tt-attr-property.attr-code, chr(4))  + chr(4)  + p-menu-handle:name
     1604                   parent = p-menu-handle.
     1605                 end.
     1606                 create menu-item tt-attr-property.menu-item-handle
     1607                 assign
     1608                 label = tt-attr-property.attr-label
     1609                 name = tt-attr-property.attr-code  + chr(4)  + p-menu-handle:name
     1610                 parent = buf_tt-attr-property.menu-item-handle
     1611                 triggers:
     1612                   on choose
     1613                     persistent run value(p-attr-choose-proc-name + "-2") (
     1614                                                                            input  entry(1, tt-attr-property.attr-code, chr(4) )
     1615                                                                           ,input entry(2, tt-attr-property.attr-code, chr(4) )
     1616                                                                             ) .
     1617                 end triggers.
     1618                 assign
     1619                 v-created = yes.
     1620               end.
     1621               else do:
     1622                 create menu-item tt-attr-property.menu-item-handle
     1623                 assign
     1624                 label = tt-attr-property.attr-label
     1625                 name = entry(1, tt-attr-property.attr-code, chr(4)) + chr(4)  + p-menu-handle:name
     1626                 parent = p-menu-handle
     1627                 triggers:
     1628                   on choose
     1629                     persistent run value(p-attr-choose-proc-name) (
     1630                                                                    input  entry(1, tt-attr-property.attr-code, chr(4) )) .
     1631                 end triggers.
     1632                 assign
     1633                 v-created = yes.
     1634               end.
     1635             end.
     1636             if last-of(tt-attr-property.edit-menu-section-num)
     1637               then do:
     1638               find first buf_tt-attr-property where
     1639                         buf_tt-attr-property.table-name = p-table-name
     1640                    and  buf_tt-attr-property.attr-code = substitute("&1&2&3"
     1641                                                            , p-table-name
     1642                                                            , tt-attr-property.edit-menu-section-num
     1643                                                            , p-menu-handle:name
     1644                                                            )
     1645                     and buf_tt-attr-property.menu-name = p-menu-handle:name  no-error .
     1646               if not available buf_tt-attr-property then do:
     1647                 create buf_tt-attr-property.
     1648                 assign
     1649                 buf_tt-attr-property.table-name = p-table-name
     1650                 buf_tt-attr-property.edit-menu-section-num =  - 1
     1651                 buf_tt-attr-property.menu-name = p-menu-handle:name
     1652                 buf_tt-attr-property.upper-attr-code = ''
     1653                 buf_tt-attr-property.attr-code = substitute("&1&2&3"
     1654                                                             , p-table-name
     1655                                                             , tt-attr-property.edit-menu-section-num
     1656                                                             , p-menu-handle:name
     1657                                                             )
     1658                 .
     1659                 create menu-item buf_tt-attr-property.menu-item-handle
     1660                 assign
     1661                 subtype = "rule"
     1662                 parent = p-menu-handle
     1663                 .
     1664               end.
     1665             end.
     1666          end.
     1667        end.
     1668        if not v-created then do:
     1669           run attr-pop-clean-up in this-procedure ( input p-table-name).
     1670        end.
     1671     end.
     1672   end procedure.
     1673   procedure attr-pop-clean-up :
     1674   define input parameter p-table-name as character no-undo .
     1675     for each tt-attr-property where
     1676             tt-attr-property.table-name = p-table-name
     1677       and tt-attr-property.edit-menu-section-num > 0:
     1678       if valid-handle ( tt-attr-property.menu-item-handle) then do:
     1679         delete widget tt-attr-property.menu-item-handle.
     1680       end.
     1681       delete tt-attr-property.
     1682     end.
     1683     for each tt-attr-property where
     1684              tt-attr-property.table-name = p-table-name
     1685          and tt-attr-property.edit-menu-section-num =  - 1:
     1686       if valid-handle ( tt-attr-property.menu-item-handle) then do:
     1687         delete widget tt-attr-property.menu-item-handle.
     1688       end.
     1689       delete tt-attr-property.
     1690     end.
     1691   end procedure.
     1692   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1693   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1694   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1695   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1696   procedure thbjattr_code :
     1697      define input  parameter p-upper-code     as character no-undo .
     1698      define input  parameter p-code           as character no-undo .
     1699      define output parameter p-label          as character no-undo .
     1700      define output parameter p-user-can-edit  as logical   no-undo .
     1701      define output parameter p-output-display as logical   no-undo .
     1702      define output parameter p-other          as character no-undo .
     1703      define output parameter p-prop-list      as character no-undo .
     1704      define output parameter p-prop-type-list as character no-undo .
     1705      define output parameter p-prop-label-list as character no-undo .
