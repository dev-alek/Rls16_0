     1982   define variable rid as recid no-undo.
     1983   define variable add-option as character no-undo .
     1984   define variable attr-mode as character no-undo init "b-code".
     1985   define variable temp-doc-rec as recid no-undo.
     1986   define variable v-start as logical no-undo init yes.
     1987   define buffer base-bar-code for ub.bar-code.
     1988   define buffer lb-goods for ub.goods .
     1989   define buffer lb-gds-prt for ub.gds-prt .
     1990   define buffer lb-bar-code for ub.bar-code .
     1991   define buffer base_units for ub.units.
     1992   DEFINE MENU MENU-b-add-attr.
     1993   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1994   define variable send-ref as logical no-undo.
     1995     define variable dops as character no-undo format "X(250)".
     1996     define variable dopst as character no-undo format "X(1)".
     1997   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1998     (input  'send-ref'
     1999     ,input  0
     2000     ,input  ''
     2001     ,input  0
     2002     ,input  ''
     2003     ,input  ''
     2004     ,input  ''
     2005     ,input  no
     2006     ,output dops
     2007     ,output dopst
     2008     ) no-error .
     2009     send-ref = (IF error-status:error or dops <> "yes" then no else yes).
     2010   FUNCTION stts-string RETURNS CHARACTER
     2011     ( p-stts_ as integer):
     2012   define variable dops as character no-undo.
     2013   assign dops = entry (lookup (string(p-stts_), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     2014   RETURN dops.
     2015   END FUNCTION.
     2016   FUNCTION get-cr-db-num RETURNS INTEGER
     2017     ( input p-b-code AS INTEGER, INPUT p-cr-db-num AS INTEGER):
     2018     DEFINE BUFFER buf_code-range FOR ub.code-range.
     2019     IF p-cr-db-num <> ? THEN
     2020     RETURN p-cr-db-num.
     2021     FIND FIRST buf_code-range NO-LOCK WHERE
     2022               buf_code-range.first-code <= p-b-code
     2023          AND  buf_code-range.last-code >= p-b-code NO-ERROR.
     2024     IF AVAILABLE buf_code-range THEN RETURN buf_code-range.db-num.
     2025     RETURN ?.
     2026   END FUNCTION.
     2027   FUNCTION IS-GLOBAL returns logical ( buffer buf_prod-bc for ub.prod-bc):
     2028   define variable v-is-global as logical no-undo .
     2029   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2030   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prodbcat in g#library
     2031     (buffer buf_prod-bc
     2032     ,input  'global=request'
     2033     ,output v-is-global
     2034     ) no-error .
     2035   if error-status:error then return ?.
     2036   return v-is-global.
     2037   end function.
     2038   FUNCTION IS-NeedMark returns logical ( buffer buf_prod-bc for ub.prod-bc):
     2039       DEFINE BUFFER buf_prod-bc-attr FOR ub.prod-bc-attr.
     2040   find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq buf_prod-bc.b-code
     2041                                 and buf_prod-bc-attr.b-str eq buf_prod-bc.b-str
     2042                                 and buf_prod-bc-attr.attr-code eq 'mark':U
     2043     no-lock no-error.
     2044   return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     2045   end function.
