     1707      define output parameter p-host           as logical no-undo .
     1708      define output parameter p-shop           as logical no-undo .
     1709      define output parameter p-store          as logical no-undo .
     1710      define output parameter p-db             as logical no-undo .
     1711      define variable p-region as logical no-undo.
     1712      run thbjattr_code_reg in this-procedure (
     1713                                               p-upper-code,
     1714                                               p-code,
     1715                                               output p-label,
     1716                                               output p-user-can-edit,
     1717                                               output p-output-display,
     1718                                               output p-other,
     1719                                               output p-prop-list,
     1720                                               output p-prop-type-list,
     1721                                               output p-prop-label-list,
     1722                                               output p-global,
     1723                                               output p-host,
     1724                                               output p-shop,
     1725                                               output p-store,
     1726                                               output p-db,
     1727                                               output p-region
     1728                                               ).
     1729   end procedure.
     1730   procedure thbjattr_code_reg :
     1731   define input  parameter p-upper-code     as character no-undo .
     1732   define input  parameter p-code           as character no-undo .
     1733   define output parameter p-label          as character no-undo .
     1734   define output parameter p-user-can-edit  as logical   no-undo .
     1735   define output parameter p-output-display as logical   no-undo .
