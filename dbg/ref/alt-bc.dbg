     1757       ,output p-prop-type-list
     1758       ,output p-prop-label-list
     1759       ,output p-global
     1760       ,output p-host
     1761       ,output p-shop
     1762       ,output p-store
     1763       ,output p-db
     1764       ,output p-region
     1765       ) no-error .
     1766     if error-status :error
     1767     then do:
