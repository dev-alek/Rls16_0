        1   DEFINE TEMP-TABLE temp-bar-code-attr NO-UNDO LIKE ub.bar-code-obj-attr
        2          field user-can-edit as logical
        3          field unit-cli like ub.bar-code.unit-cli
        4          field cli-base-rate like ub.bar-code.cli-base-rate
        5          field attr-label as character
        6          index pi is unique primary
        7          b-code
        8          attr-code
        9          obj-type
       10          obj-code
       11          index iattrc
       12          attr-code
       13          index iattrv
       14          attr-value.
       15   DEFINE BUFFER X_bar-code FOR ub.bar-code.
       16   DEFINE BUFFER X_gds-prt FOR ub.gds-prt.
       17   DEFINE BUFFER X_goods FOR ub.goods.
       18   DEFINE BUFFER X_prod-bc FOR ub.prod-bc.
       19   define input parameter parparentproc AS WIDGET-HANDLE NO-UNDO.
       20   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo .
       21   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo .
       22   define input parameter base-bc like ub.bar-code.b-code no-undo.
       23   define variable vss-revision    as character no-undo init "$Revision$":U .
       24   define variable vss-author      as character no-undo init "$Author$":U .
       25   define variable vss-date        as character no-undo init "$Date$":U .
       26   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       27   define variable vss-archive     as character no-undo init "$Archive$":U .
       28   define variable vss-description as character no-undo init "Бар-коды и ДопБК для товара".
       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47   end procedure.
       48   define new global shared variable g#vssrevis-logger as handle    no-undo .
       49   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       50   define variable v-vssrevis-logger                   as handle    no-undo .
       51   procedure vss-logevent :
       52     define input  parameter p-extra-paramters as character no-undo .
       53     define variable v-vssrevis-parameters as character no-undo .
       54     do
       55     on error undo, return error return-value
       56     :
       57       if  valid-handle(v-vssrevis-logger)
       58       and v-vssrevis-logger :get-signature("logevent") <> ""
       59       then do:
       60         run vss-get-parameters in this-procedure
       61           (output v-vssrevis-parameters
       62           ).
       63         run logevent in v-vssrevis-logger
       64           (input vss-workfile
       65           ,input vss-revision
       66           ,input v-vssrevis-parameters
       67           ,input p-extra-paramters
       68           ).
       69       end.
       70     end.
       71   end procedure.
       72   assign
       73     v-vssrevis-logger = g#vssrevis-logger
       74   .
       75   if  valid-handle(v-vssrevis-logger)
       76   and v-vssrevis-logger :get-signature("logevent") <> ""
       77   then do:
       78     assign
       79       v-vssrevis-logevent = true
       80     .
       81     run vss-logevent in this-procedure (input vss-description) .
       82   end.
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   define variable v-waitfram-action01         as character   no-undo .
       85   define variable v-waitfram-action02         as character   no-undo .
       86   define variable v-waitfram-action03         as character   no-undo .
       87   define variable mWaitFramTextBeg            as character   no-undo.
       88   define variable mWaitFramTextEnd            as character   no-undo.
       89   define variable mWaitFramView               as logical     no-undo.
       90   define variable mWaitProcEvent              as logical     no-undo init yes.
       91   define variable mWaitFramInterval           as integer     no-undo init 1 .
       92   define variable mWaitFramStop               as logical     no-undo.
       93   define variable mWaitFramStopUser           as logical     no-undo.
       94   define variable mWaitFramStopTimeOut        as logical     no-undo.
       95   define variable mWaitFramStartProc          as datetime-tz no-undo.
       96   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       97   define button B-WaitFramStop auto-end-key
       98        label "Стоп"
       99        size 10 by 1 tooltip "Остоновить процесс".
      100   define button B-viewProcInfo
      101        label "Информация"
      102        size 15 by 1 tooltip "Информация о процесс".
      103   define frame waitfram
      104     v-waitfram-action01 format "x(72)" no-label skip
      105     v-waitfram-action02 format "x(72)" no-label skip
      106     v-waitfram-action03 format "x(72)" no-label skip
      107     B-viewProcInfo
      108     B-WaitFramStop at row 4 col 30
      109     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      110     .
      111   define new global shared variable mBatchMode as logical no-undo init ?.
      112   define variable mFramBachModHandle as handle no-undo.
      113   mFramBachModHandle = frame waitfram:handle.
      114   define variable mFameOldVis as logical no-undo.
      115   define variable mVisCUrentVin as logical no-undo.
      116   if session:batch-mode
      117   then
      118      mBatchMode = yes.
      119   if mBatchMode = ? then do:
      120     mVisCUrentVin = current-window:visible.
      121     mFameOldVis = mFramBachModHandle:visible.
      122     mFramBachModHandle:visible  = yes.
      123     mBatchMode = mFramBachModHandle:visible ne yes.
      124     mFramBachModHandle:visible = mFameOldVis.
      125     current-window:visible = mVisCUrentVin.
      126   end.
      127    if  log-manager:logfile-name ne ?
      128     then DO:
      129         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      130         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      131         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      132     end.
      133   on choose of B-WaitFramStop in frame waitfram
      134   do:
      135     mWaitFramStop = yes.
      136     mWaitFramStopUser = yes.
      137   end.
      138   function waitfram-check-timeout returns logical():
      139      define variable vtime as int64 no-undo.
      140      if mWaitFramStopTimeOut
      141      then
      142         return yes.
      143      vtime = ( now - mWaitFramStartProc ) / 1000 .
      144      if     mWaitFramTimeOut ne ?
      145         and mWaitFramTimeOut ne 0
      146         and mWaitFramTimeOut lt vtime
      147      then do:
      148         mWaitFramStopTimeOut = yes.
      149      end.
      150      return mWaitFramStopTimeOut.
      151   end.
      152   procedure waitfram-hide :
      153     if not session:batch-mode
      154     then do
      155     on error undo, return error return-value
      156     :
      157       pause 0 before-hide .
      158       if not mBatchMode then
      159         hide frame waitfram .
      160     if     not mWaitFramView
      161        and mWaitProcEvent
      162     then
      163       process events .
      164     end.
      165   end procedure.
      166   procedure waitfram-show :
      167     define input  parameter p-message as character no-undo .
      168     define variable v-left-margin as integer   no-undo .
      169     if not session:batch-mode
      170     then do
      171     on error undo, return error return-value
      172     :
      173       if length(p-message) <= 70 then do:
      174         assign
      175           v-left-margin = integer((70 - length(p-message)) / 2)
      176         .
      177         assign
      178           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      179         .
      180         assign
      181           v-waitfram-action01 = " "
      182           v-waitfram-action02 = " "
      183                                    + fill(" ", v-left-margin)
      184                                    + p-message
      185           v-waitfram-action03 = " "
      186         .
      187       end.
      188       else do:
      189         define variable vRindex1 as integer no-undo.
      190         define variable vRindex2 as integer no-undo.
      191         vRindex1 = r-index(p-message," ",70).
      192         if vRindex1 = 0
      193         then
      194            vRindex1 = 70.
      195         if length(p-message)  <= vRindex1 + 70 then do:
      196           assign
      197             v-waitfram-action01 = " "
      198             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      199             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      200           .
      201         end.
      202         else do:
      203           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      204           if vRindex2 <= vRindex1
      205           then
      206              vRindex2 = vRindex1 + 70.
      207           assign
      208             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      209             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      210             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      211           .
      212         end.
      213       end.
      214       B-viewProcInfo:visible   in frame waitfram = no.
      215       B-viewProcInfo:sensitive in frame waitfram = no.
      216       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      217       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      218       if  (   mWaitFramView
      219          or  mWaitProcEvent)
      220          and not mBatchMode
      221       then
      222          display
      223             v-waitfram-action01 skip
      224             v-waitfram-action02 skip
      225             v-waitfram-action03 skip
      226          with frame waitfram .
      227       if     mWaitFramView
      228          then do:
      229             if     mWaitFramInterval ne ?
      230                and not mBatchMode
      231             then
      232                wait-for go of frame waitfram pause mWaitFramInterval.
      233          end.
      234          else
      235             if     mWaitProcEvent
      236                and not mBatchMode
      237             then
      238                process events .
      239     end.
      240   end procedure.
      241      procedure waitfram-show-this:
      242         define input  parameter iInterval as int64 no-undo.
      243         define variable vtime as int64 no-undo.
      244         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      245         mWaitFramInterval = iInterval.
      246         run waitfram-show (substitute("&1&2 &3&4" ,
      247                                       mWaitFramTextBeg ,
      248                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      249                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      250                                       mWaitFramTextEnd
      251                                      )
      252                           ).
      253      end.
      254      procedure WaitFramRunPause:
      255         define input  parameter iInterval as dec no-undo.
      256         define variable vStart  as datetime-tz no-undo.
      257         define variable vend    as datetime-tz no-undo.
      258         define variable vint as int64 no-undo.
      259         define variable vOk as logical no-undo.
      260         vStart = now.
      261         vend   = vStart.
      262         publish "WaitFramPause" (iInterval,output vOk).
      263         vend   =  now.
      264         vint = vend - vStart.
      265         vint = iInterval - vint / 1000.
      266         if     not mWaitFramStop
      267            and (   vint > 0
      268                 or (    not vOk
      269                     and iInterval eq ?
      270                     )
      271                 )
      272         then
      273            run waitfram-show-this (iInterval).
      274         vend   =  now.
      275         vint = vend - vStart.
      276         vint = iInterval - vint / 1000.
      277         if     not mWaitFramStop
      278            and vint > 0
      279         then do:
      280            run gbl/pause.p (vint * 1000).
      281         end.
      282         if iInterval ne ?
      283         then
      284            publish "WaitFramStop".
      285         waitfram-check-timeout().
      286      end.
      287      procedure WaitFramWaitFor:
      288         define input  parameter iInterval as dec no-undo.
      289         assign
      290            mWaitFramStartProc   = now
      291            mWaitFramStopUser    = no
      292            mWaitFramStopTimeOut = no
      293         .
      294         block-wait:
      295         do while not mWaitFramStop:
      296            run WaitFramRunPause (iInterval).
      297            if  waitfram-check-timeout()
      298            then do:
      299               leave block-wait.
      300            end.
      301         end.
      302         run waitfram-hide.
      303      end.
      304   procedure waitfram-join :
      305     define input  parameter p-line-1  as character no-undo .
      306     define input  parameter p-line-2  as character no-undo .
      307     define input  parameter p-line-3  as character no-undo .
      308     define output parameter p-message as character no-undo .
      309     do
      310     on error undo, return error return-value
      311     :
      312       assign
      313         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      314                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      315                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      316       .
      317     end.
      318   end procedure.
      319   function waitfram-join-function returns character
      320     (input p-line-1 as character
      321     ,input p-line-2 as character
      322     ,input p-line-3 as character
      323     ).
      324     define variable v-message as character no-undo .
      325     run waitfram-join in this-procedure
      326       (input  p-line-1
      327       ,input  p-line-2
      328       ,input  p-line-3
      329       ,output v-message
      330       ) .
      331     return v-message .
      332   end function .
      333   define new global shared variable g#language as character no-undo .
      334   if g#language <> '' and g#language <> 'rus':U then do:
      335     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      336   end.
      337   procedure proc-alt-shift-f2:
      338     if not ibs.th.gbl.gbl-var:rcode
      339   then
      340     run gbl\inidebug.p .
      341   end.
      342   procedure proc-alt-shift-f3:
      343     run gbl/prvssinf.p
      344       ( input this-procedure
      345       ) .
      346   end.
      347   define variable v-inform-launched as logical no-undo initial false .
      348   procedure proc-alt-shift-f4:
      349     define variable v-action as character no-undo .
      350     if v-inform-launched = false then do:
      351       assign
      352         v-inform-launched = true
      353       .
      354       run gbl/d-inform.w
      355         (  input self
      356         ,  input this-procedure
      357         , output v-action
      358         ) no-error .
      359       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      360       assign
      361         v-inform-launched = false
      362       .
      363     end.
      364   end.
      365   procedure proc-alt-f1:
      366     run gbl/corrhelp.p
      367       (input this-procedure
      368       ) .
      369   end .
      370   on alt-shift-f2 anywhere do:
      371     run proc-alt-shift-f2.
      372   end.
      373   on alt-shift-f3 anywhere do:
      374     run proc-alt-shift-f3 in this-procedure .
      375   end.
      376   on alt-shift-f4 anywhere do:
      377     run proc-alt-shift-f4 in this-procedure.
      378   end.
      379   on alt-f1 anywhere do:
      380     run proc-alt-f1 in this-procedure .
      381   end.
      382   define new global shared variable g#library  as handle no-undo .
      383   define new global shared variable g#library2 as handle no-undo .
      384   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      385   FUNCTION MakeShbl RETURNS CHARACTER(input par-int1 as integer, input par-int2 as integer):
      386   DEFINE VARIABLE ii as integer no-undo init 1.
      387   DEFINE VARIABLE var-char1 as character no-undo .
      388   DEFINE VARIABLE var-char2 as character no-undo .
      389   DEFINE VARIABLE par-shbl as character no-undo .
      390   assign
      391   var-char1 = string(par-int1)
      392   var-char2 = string(par-int2)
      393   .
      394   if length(var-char1) <> length(var-char2) then return error.
      395   do while ii <= length(var-char1):
      396     if substring(var-char1, ii, 1) = substring(var-char2, ii, 1) then do:
      397       par-shbl = par-shbl + substring(var-char1, ii, 1).
      398     end.
      399     else do:
      400       par-shbl = par-shbl + fill("?", length(var-char1) - length(par-shbl)).
      401       return par-shbl.
      402     end.
      403     ii = ii + 1.
      404   end.
      405   END FUNCTION.
      406   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      407   procedure progs-name :
      408     define input  parameter p-action-code         as character no-undo .
      409     define output parameter p-main-prog-name      as character no-undo .
      410     define output parameter p-list-db-proc-name   as character no-undo .
      411     define output parameter p-commit-proc-name    as character no-undo .
      412     define output parameter p-execution-proc-name as character no-undo .
      413     define output parameter p-recover-proc-name   as character no-undo .
      414     define output parameter p-after-proc-name     as character no-undo .
      415     do
      416     on error undo, return error
      417     :
      418       case p-action-code :
      419               when 'crush_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-crush-cdrg':U       p-execution-proc-name = 'exec-crush-cdrg':U       p-recover-proc-name   = 'rcvr-crush-cdrg':U       p-after-proc-name     = '':U     .   end.
      420               when 'delete_code-range':U then do:     assign       p-main-prog-name      = 'trg/code-rgt.p':U       p-list-db-proc-name   = 'utl/cdrg-dbl.p':U       p-commit-proc-name    = 'comm-del-cdrg':U       p-execution-proc-name = 'exec-del-cdrg':U       p-recover-proc-name   = 'rcvr-del-cdrg':U       p-after-proc-name     = '':U     .   end.
      421               when 'delete_nu-prt-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-prt-bar-code':U       p-execution-proc-name = 'delete-prt-bar-code':U       p-recover-proc-name   = 'undo-delete-prt-bar-code':U       p-after-proc-name     = '':U     .   end.
      422               when 'delete_nu-part-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-part-bar-code':U       p-execution-proc-name = 'delete-part-bar-code':U       p-recover-proc-name   = 'undo-delete-part-bar-code':U       p-after-proc-name     = '':U     .   end.
      423               when 'delete_nu-ucli-bar-code':U then do:     assign       p-main-prog-name      = 'trg/bar-codt.p':U       p-list-db-proc-name   = 'str/barcddb.p':U       p-commit-proc-name    = 'block-del-ucli-bar-code':U       p-execution-proc-name = 'delete-ucli-bar-code':U       p-recover-proc-name   = 'undo-delete-ucli-bar-code':U       p-after-proc-name     = '':U     .   end.
      424               when 'delete_nu-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-del-dis-card':U       p-execution-proc-name = 'delete-dis-card':U       p-recover-proc-name   = 'undo-delete-dis-card':U       p-after-proc-name     = '':U     .   end.
      425               when 'chown-dis-card':U then do:     assign       p-main-prog-name      = 'trg/discardt.p':U       p-list-db-proc-name   = 'trg/discardb.p':U       p-commit-proc-name    = 'block-chown-dis-card':U       p-execution-proc-name = 'chown-dis-card':U       p-recover-proc-name   = 'undo-chown-dis-card':U       p-after-proc-name     = 'after-chown-dis-card':U     .   end.
      426               when 'delete_nu-dis-rule':U then do:     assign       p-main-prog-name      = 'trg/dis-rult.p':U       p-list-db-proc-name   = 'trg/disruldb.p':U       p-commit-proc-name    = 'block-del-dis-rule':U       p-execution-proc-name = 'delete-dis-rule':U       p-recover-proc-name   = 'undo-delete-dis-rule':U       p-after-proc-name     = '':U     .   end.
      427               when 'ren-art':U then do:     assign       p-main-prog-name      = 'trg/goodst.p':U       p-list-db-proc-name   = 'utl/renartcd.p':U       p-commit-proc-name    = 'comm-ren-art':U       p-execution-proc-name = 'exec-ren-art':U       p-recover-proc-name   = 'rcvr-ren-art':U       p-after-proc-name     = 'after-ren-art':U     .   end.
      428               when 'delete_nu-clob-data':U then do:     assign       p-main-prog-name      = 'trg/clobdatt.p':U       p-list-db-proc-name   = 'trg/clbdatdb.p':U       p-commit-proc-name    = 'block-del-clob-data':U       p-execution-proc-name = 'delete-clob-data':U       p-recover-proc-name   = 'undo-delete-clob-data':U       p-after-proc-name     = '':U     .   end.
      429               when 'delete_nu-layout':U then do:     assign       p-main-prog-name      = 'trg/layoutt.p':U       p-list-db-proc-name   = 'trg/layoutdb.p':U       p-commit-proc-name    = 'block-del-layout':U       p-execution-proc-name = 'delete-layout':U       p-recover-proc-name   = 'undo-delete-layout':U       p-after-proc-name     = '':U     .   end.
      430               otherwise do:
      431           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info2, p-action-code ).
      432         end.
      433       end case.
      434     end.
      435     return.
      436   end procedure.
      437   procedure progs-title :
      438     define input  parameter p-action-code         as character no-undo .
      439     define output parameter p-action-title      as character no-undo .
      440     do
      441     on error undo, return error
      442     :
      443       case p-action-code :
      444               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      445               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      446               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      447               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      448               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      449               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      450               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      451               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      452               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      453               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      454               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      455               otherwise do:
      456           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info2, p-action-code ).
      457         end.
      458       end case.
      459     end.
      460     return.
      461   end procedure.
      462   FUNCTION progs-title-function returns character(
      463      input  p-action-code         as character):
      464   define variable p-action-title      as character no-undo .
      465     do
      466     on error undo, return error
      467     :
      468       case p-action-code :
      469               when 'crush_code-range':U then do:     assign       p-action-title        = "Разбиение диапазона кодов (code-range)"     .   end.
      470               when 'delete_code-range':U then do:     assign       p-action-title        = "Удаление диапазона кодов (code-range)"     .   end.
      471               when 'delete_nu-prt-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода признака"     .   end.
      472               when 'delete_nu-part-bar-code':U then do:     assign       p-action-title        = "Удаление неисп. бар-кода партиии"     .   end.
      473               when 'delete_nu-ucli-bar-code':U then do:     assign       p-action-title        = "Удаление неисп.бар-кода на доп ед.изм."     .   end.
      474               when 'delete_nu-dis-card':U then do:     assign       p-action-title        = "Удаление неиспользуемой ДК"     .   end.
      475               when 'chown-dis-card':U then do:     assign       p-action-title        = "Смена владельца ДК"     .   end.
      476               when 'delete_nu-dis-rule':U then do:     assign       p-action-title        = "Удаление правила скидки по фирме и глобального правила скидки"     .   end.
      477               when 'ren-art':U then do:     assign       p-action-title        = "Изм. артикула и(или) произв. товара"     .   end.
      478               when 'delete_nu-clob-data':U then do:     assign       p-action-title        = "Удаление неиспользуемой clob-data"     .   end.
      479               when 'delete_nu-layout':U then do:     assign       p-action-title        = "Удаление РАСКЛАДКИ"     .   end.
      480               otherwise do:
      481           return error substitute( "&1. Неизвестный тип операции: &2", vss-include-info2, p-action-code ).
      482         end.
      483       end case.
      484     end.
      485     return p-action-title.
      486   end FUNCTION.
      487   procedure get-row-keyr-string :
      488    define input  parameter p-key-rec  as character no-undo.
      489    define output parameter p-tbl-title as character no-undo.
      490    define output parameter p-rec-string  as character no-undo.
      491     do
      492     on error undo, return error
      493     :
      494       define variable v-full-tbl-name as character no-undo .
      495       define variable bh_tbl-name     as handle    no-undo .
      496       define variable fh              as handle    no-undo .
      497       define variable v-ok            as logical   no-undo .
      498       define variable v-field-num     as integer   no-undo .
      499       define variable v-count-fld     as integer   no-undo .
      500       define variable v-tbl-name as character no-undo.
      501       if p-key-rec = ?
      502         or p-key-rec = "":U
      503       then do:
      504         return error substitute( "&1 (get-row-keyr-string). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info2 ).
      505       end.
      506       assign
      507         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      508         v-full-tbl-name = "ub.":U + v-tbl-name
      509         v-field-num     = num-entries( p-key-rec, chr(3) ) - 1
      510         p-rec-string         = "":U
      511         v-count-fld     = 0
      512       .
      513       find ub._file
      514         where ub._file._file-name = v-tbl-name
      515         no-error.
      516       if not available ub._file then do:
      517         return error substitute( "&1. Таблица &2 отсутствует в БД", vss-include-info2, v-tbl-name ).
      518       end.
      519       assign
      520       p-tbl-title = ub._file._file-label
      521       .
      522       find ub._index
      523         where recid( ub._index  ) = ub._file._prime-index
      524         no-error.
      525       if not available ub._index
      526         or LC( ub._index._index-name ) = "default":U
      527       then do:
      528         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info2, v-tbl-name ).
      529       end.
      530       block_where :
      531       for each ub._index-field of ub._index  ,
      532           each ub._field of _index-field
      533           break by _index-seq
      534       on error undo, return error
      535       :
      536         assign
      537           v-count-fld = v-count-fld + 1
      538         .
      539         if v-count-fld > v-field-num then do:
      540           leave block_where.
      541         end.
      542         if p-rec-string = "":U then do:
      543           assign
      544             p-rec-string = "":U
      545           .
      546         end.
      547         else do:
      548           assign
      549             p-rec-string = p-rec-string + chr(32) + chr(44)
      550           .
      551         end.
      552         assign
      553           p-rec-string = p-rec-string + (if p-rec-string = "":u then "":U else chr(32)) + substitute( "&1 = &2":U, ub._field._label, entry( v-count-fld + 1 , p-key-rec, chr(3) ) )
      554         .
      555       end.
      556       if v-count-fld <> v-field-num then do:
      557         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info2, v-tbl-name ).
      558       end.
      559     end.
      560     return.
      561   end procedure.
      562   FUNCTION uniq-key-rec-string-f returns character(
      563      input  p-uniq-key-rec         as character):
      564   define variable v-tbl-title as character no-undo .
      565   define variable v-rec-string as character no-undo .
      566     do
      567     on error undo, return error
      568     :
      569       run get-row-keyr-string in this-procedure (
      570                                                 input p-uniq-key-rec
      571                                                 ,output v-tbl-title
      572                                                 ,output v-rec-string).
      573       assign
      574       v-rec-string = (if v-tbl-title <> ? and
      575                       v-tbl-title <> "":U
      576                       then (v-tbl-title + ":")
      577                      else "":U) + chr(32) + v-rec-string
      578       .
      579     end.
      580     return v-rec-string.
      581   end FUNCTION.
      582   procedure create_db-rec_route :
      583     define input parameter p1-uniq-key-rec as character no-undo .
      584     define input parameter p1-action       as character no-undo .
      585     define input parameter p1-operation    as character no-undo .
      586     define input parameter p1-send-db-list as character no-undo .
      587     define input parameter p1-db-init      as integer   no-undo .
      588     define input parameter p1-parameters   as character no-undo .
      589     define input parameter p1-answer-code  as integer   no-undo .
      590     define input parameter p1-answer-msg   as character no-undo .
      591     do
      592     on error undo, return error
      593     :
      594       define variable v-command     as character no-undo .
      595       define variable v-ind         as integer   no-undo .
      596       define variable v-num-entries as integer   no-undo .
      597       define variable v-curr-db     as integer   no-undo .
      598       define variable v-db-for-send as character no-undo .
      599       define variable v-db-num      as integer   no-undo .
      600       define variable v-db-num-char as character no-undo .
      601       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      602       find first buf_sys-ctrl no-lock .
      603       assign
      604         v-curr-db     = buf_sys-ctrl.db-num
      605         v-db-for-send = "":U
      606       .
      607       if v-curr-db = 0 then do:
      608         if p1-answer-code >= 0 then do:
      609           if v-curr-db <> p1-db-init then do:
      610             assign
      611               v-db-for-send = string( p1-db-init )
      612             .
      613           end.
      614         end.
      615         else do:
      616           assign
      617             v-num-entries = num-entries( p1-send-db-list, chr(44) )
      618           .
      619           do v-ind = 1 to v-num-entries:
      620             assign
      621               v-db-num-char = entry( v-ind, p1-send-db-list, chr(44) )
      622               v-db-num      = integer( v-db-num-char )
      623             .
      624             if v-db-num <> v-curr-db
      625               and v-db-num <> p1-db-init
      626             then do:
      627               if v-db-for-send = "":U then do:
      628                 assign
      629                   v-db-for-send = v-db-num-char
      630                 .
      631               end.
      632               else do:
      633                 assign
      634                   v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      635                 .
      636               end.
      637             end.
      638           end.
      639         end.
      640       end.
      641       else do:
      642         assign
      643           v-db-for-send = "0":U
      644         .
      645       end.
      646       if v-db-for-send <> "":U then do:
      647         assign
      648           v-command = "command":U + chr(1)
      649                       + "two-commit":U + chr(1)
      650                       + p1-action + chr(1)
      651                       + p1-operation + chr(1)
      652                       + p1-uniq-key-rec + chr(1)
      653                       + string( p1-db-init ) + chr(1)
      654                       + p1-parameters + chr(1)
      655                       + string( p1-answer-code ) + chr(1)
      656                       + p1-answer-msg
      657         .
      658         run nws/cr-route.p ( input 'send-cmd':U
      659                       ,input v-command
      660                       ,input ?
      661                       ,input v-db-for-send
      662                       ) no-error .
      663         if error-status :error then do:
      664           return error return-value.
      665         end.
      666       end.
      667     end.
      668     return.
      669   end procedure.
      670   procedure create_msg_route :
      671     define input parameter p2-send-db-list as character no-undo .
      672     define input parameter p2-msg          as character no-undo .
      673     do
      674     on error undo, return error
      675     :
      676       define variable v-msg-command as character no-undo .
      677       define variable v-ind         as integer   no-undo .
      678       define variable v-num-entries as integer   no-undo .
      679       define variable v-curr-db     as integer   no-undo .
      680       define variable v-db-for-send as character no-undo .
      681       define variable v-db-num      as integer   no-undo .
      682       define variable v-db-num-char as character no-undo .
      683       define buffer buf_sys-ctrl    for ub.sys-ctrl .
      684       find first buf_sys-ctrl no-lock .
      685       assign
      686         v-curr-db     = buf_sys-ctrl.db-num
      687         v-db-for-send = "":U
      688       .
      689       if v-curr-db = 0 then do:
      690         assign
      691           v-num-entries = num-entries( p2-send-db-list, chr(44) )
      692         .
      693         do v-ind = 1 to v-num-entries:
      694           assign
      695             v-db-num-char = entry( v-ind, p2-send-db-list, chr(44) )
      696             v-db-num      = integer( v-db-num-char )
      697           .
      698           if v-db-num <> v-curr-db then do:
      699             if v-db-for-send = "":U then do:
      700               assign
      701                 v-db-for-send = v-db-num-char
      702               .
      703             end.
      704             else do:
      705               assign
      706                 v-db-for-send =  v-db-for-send + chr(1) + v-db-num-char
      707               .
      708             end.
      709           end.
      710         end.
      711       end.
      712       else do:
      713         assign
      714           v-db-for-send = "0":U
      715         .
      716       end.
      717       if v-db-for-send <> "":U then do:
      718         assign
      719           v-msg-command = "command":U + chr(1)
      720                           + "message-to-log":U + chr(1)
      721                           + p2-msg
      722         .
      723         run nws/cr-route.p ( input 'send-cmd':U
      724                       ,input v-msg-command
      725                       ,input ?
      726                       ,input v-db-for-send
      727                       ) no-error .
      728         if error-status :error then do:
      729           return error substitute( "&1&2&3"
      730                                     , return-value
      731                                     , chr(10)
      732                                     , error-status :get-message(1)
      733                                   ).
      734         end.
      735       end.
      736     end.
      737     return.
      738   end procedure.
      739   function get-send-db-list returns character
      740     ( input p-curr-db     as integer
      741      ,input p-all-db-list as character
      742     )
      743   :
      744     define variable v-send-db-list as character no-undo .
      745     if p-curr-db = 0 then do:
      746       assign
      747         v-send-db-list = p-all-db-list
      748       .
      749     end.
      750     else do:
      751       assign
      752         v-send-db-list = string(p-curr-db)
      753       .
      754     end.
      755     return v-send-db-list .
      756   end function .
      757   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      758   procedure gen-key-rec :
      759     define input  parameter p-tbl-name    as character no-undo.
      760     define input  parameter p-bh_tbl-name as handle    no-undo.
      761     define output parameter p-key-rec     as character no-undo.
      762     do
      763     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      764     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      765     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      766     :
      767       define variable fh               as handle    no-undo .
      768       define variable v-ok             as logical   no-undo .
      769       define variable v-inform         as character no-undo .
      770       define variable v-ind            as integer   no-undo .
      771       define variable v-idx-field-qnty as integer   no-undo .
      772       if p-tbl-name = ?
      773         or p-tbl-name = "":U
      774       then do:
      775         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      776       end.
      777       if not p-bh_tbl-name:available then do:
      778         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      779       end.
      780       assign
      781         p-key-rec = p-tbl-name
      782         v-inform  = p-bh_tbl-name:index-information(1)
      783         v-ind     = 2
      784       .
      785       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      786       on error undo, return error
      787       :
      788         assign
      789           v-inform = p-bh_tbl-name:index-information( v-ind )
      790           v-ind    = v-ind + 1
      791         .
      792       end.
      793       if v-inform = ?
      794         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      795         or entry( 3, v-inform, ",":U ) <> "1":U
      796       then do:
      797         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      798       end.
      799       else do:
      800         assign
      801           v-idx-field-qnty = num-entries( v-inform ) - 4
      802         .
      803         if v-idx-field-qnty < 2 then do:
      804           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      805         end.
      806         do v-ind = 1 to v-idx-field-qnty by 2
      807         on error undo, return error
      808         :
      809           assign
      810             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      811             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      812           .
      813         end.
      814       end.
      815       if p-key-rec = ? then do:
      816         assign
      817           p-key-rec = "":U
      818         .
      819         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      820       end.
      821     end.
      822     return.
      823   end procedure.
      824   procedure gen-where-keyr-tab :
      825     define input  parameter i-tableSerach as character no-undo.
      826     define input  parameter i-tablekey   as character  no-undo.
      827     define input  parameter p-key-rec    as character  no-undo.
      828     define input  parameter p-key-handle as handle     no-undo .
      829     define input  parameter p-db-name    as character  no-undo .
      830     define input  parameter p-tt-handle  as handle     no-undo .
      831     define output parameter o-Where      as character  no-undo.
      832     do
      833     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      834     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      835     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      836     :
      837       define variable v-full-tbl-name  as character no-undo .
      838       define variable bh_tbl-name      as handle    no-undo .
      839       define variable fh_key           as handle    no-undo .
      840       define variable fh_search        as handle    no-undo .
      841       define variable v-field-num      as integer   no-undo .
      842       define variable v-count-fld      as integer   no-undo .
      843       define variable v-inform         as character no-undo .
      844       define variable v-ind            as integer   no-undo .
      845       define variable v-idx-field-qnty as integer   no-undo .
      846       define variable v-field-name     as character no-undo .
      847       define variable v-field-val      as character no-undo .
      848       define variable v-word-link      as character no-undo .
      849       define variable vTable           as character no-undo.
      850       define variable bh_tbl-key       as handle    no-undo .
      851       assign
      852         p-key-rec = trim( p-key-rec )
      853       .
      854       if p-key-handle <> ? then do:
      855         if not valid-handle(p-key-handle)
      856            or p-key-handle:type <> "buffer"
      857         then do:
      858           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      859         end.
      860         if num-entries( p-key-rec, chr(3) ) > 1
      861           or p-key-rec = ?
      862           or p-key-rec = "":U
      863         then do:
      864           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      865         end.
      866       end.
      867       else do:
      868         if p-key-rec = ?
      869           or p-key-rec = "":U
      870         then do:
      871           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      872         end.
      873       end.
      874       assign
      875         vTable = entry( 1 , p-key-rec, chr(3) )
      876       .
      877       if p-tt-handle <> ?
      878         and ( not valid-handle(p-tt-handle)
      879               or p-tt-handle:type <> "buffer"
      880             )
      881       then do:
      882         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      883       end.
      884       if p-tt-handle = ? then do:
      885         assign
      886           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      887         .
      888         create buffer bh_tbl-name for table v-full-tbl-name .
      889       end.
      890       else do:
      891         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      892       end.
      893       assign
      894         v-inform = bh_tbl-name:index-information(1)
      895         v-ind    = 2
      896       .
      897       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      898       on error undo, return error
      899       :
      900         assign
      901           v-inform = bh_tbl-name:index-information( v-ind )
      902           v-ind    = v-ind + 1
      903         .
      904       end.
      905       if v-inform = ?
      906         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      907         or entry( 3, v-inform, ",":U ) <> "1":U
      908       then do:
      909         delete object bh_tbl-name no-error.
      910         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      911       end.
      912       assign
      913         v-idx-field-qnty = num-entries( v-inform ) - 4
      914       .
      915       if v-idx-field-qnty < 2 then do:
      916         delete object bh_tbl-name no-error.
      917         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      918       end.
      919       assign
      920         o-where     = "where":U
      921         v-word-link = "":U
      922         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      923         v-count-fld = 0
      924       .
      925       if i-tablekey ne "" and i-tablekey ne ?
      926       then do:
      927         assign
      928           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      929         .
      930         create buffer bh_tbl-key for table v-full-tbl-name .
      931       end.
      932       if i-tableSerach ne "" and i-tableSerach ne ?
      933       then do:
      934         delete object bh_tbl-name no-error.
      935         assign
      936           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      937         .
      938         create buffer bh_tbl-name for table v-full-tbl-name .
      939       end.
      940       block_where:
      941       do v-ind = 1 to v-idx-field-qnty by 2
      942       on error undo, return error
      943       :
      944         assign
      945           v-count-fld = v-count-fld + 1
      946         .
      947         if p-key-handle = ?
      948           and v-count-fld > v-field-num
      949         then do:
      950           leave block_where.
      951         end.
      952         define variable VfieldKeyTable as handle no-undo.
      953         assign
      954           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      955           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      956         .
      957         if     bh_tbl-key ne ?
      958         then do:
      959            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      960            if VfieldKeyTable eq ?
      961            then next block_where.
      962         end.
      963         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      964         then
      965            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      966         else
      967            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      968         if p-key-handle = ? then do:
      969           assign
      970             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      971           .
      972         end.
      973         else do:
      974           assign
      975             fh_key = p-key-handle:buffer-field( v-field-name )
      976           .
      977           if fh_key = ?
      978             or not valid-handle( fh_key )
      979           then do:
      980             delete object bh_tbl-name.
      981             if     bh_tbl-key ne ?
      982             then
      983                delete object bh_tbl-key.
      984             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      985           end.
      986           assign
      987             v-field-val = fh_key:buffer-value
      988           .
      989         end.
      990         if fh_search:data-type ="character":U then do:
      991           assign
      992             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      993             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      994             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      995             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      996             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      997             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      998             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      999             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1000             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1001             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1002             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1003             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1004             v-field-val = substitute( '"&1"', v-field-val )
     1005           .
     1006         end.
     1007         assign
     1008           o-where = substitute( "&1 &2", o-where, v-field-val )
     1009         .
     1010         if v-word-link = "":U then do:
     1011           assign
     1012             v-word-link = "and":U
     1013           .
     1014         end.
     1015       end.
     1016       delete object bh_tbl-name.
     1017       if     bh_tbl-key ne ?
     1018       then
     1019          delete object bh_tbl-key.
     1020       if p-key-handle = ?
     1021         and v-count-fld <> v-field-num
     1022       then do:
     1023         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
     1024       end.
     1025     end.
     1026   end procedure.
     1027   procedure gen-hn-keyr-tab :
     1028     define input  parameter i-tableSerach as character no-undo.
     1029     define input  parameter i-tablekey   as character no-undo.
     1030     define input  parameter p-key-rec    as character no-undo.
     1031     define input  parameter p-key-handle as handle    no-undo .
     1032     define input  parameter p-db-name    as character no-undo .
     1033     define input  parameter p-tt-handle  as handle    no-undo .
     1034     define input  parameter p-stts-lock  as integer   no-undo .
     1035     define output parameter o-hn         as handle    no-undo.
     1036     define variable v-full-tbl-name as character no-undo.
     1037     define variable v-where         as character no-undo.
     1038     define variable bh_tbl-name     as handle    no-undo.
     1039     define variable vTable          as character no-undo.
     1040     do
     1041     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1042     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1043     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1044         run gen-where-keyr-tab(i-tableSerach,
     1045                                i-tablekey,
     1046                                p-key-rec,
     1047                                p-key-handle,
     1048                                p-db-name,
     1049                                p-tt-handle,
     1050                                output v-where).
     1051         if i-tableSerach ne "" and i-tableSerach ne ?
     1052         then do:
     1053            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1054            create buffer bh_tbl-name for table v-full-tbl-name .
     1055         end.
     1056         else do:
     1057            if p-tt-handle = ? then do:
     1058               assign
     1059                  vTable = entry( 1 , p-key-rec, chr(3) )
     1060               .
     1061               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1062               create buffer bh_tbl-name for table v-full-tbl-name .
     1063            end.
     1064            else do:
     1065               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1066            end.
     1067         end.
     1068         if p-tt-handle = ? then do:
     1069            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1070         end.
     1071         else do:
     1072            bh_tbl-name:find-first( v-where ) no-error .
     1073         end.
     1074         o-hn = bh_tbl-name.
     1075      end.
     1076   end procedure.
     1077   procedure gen-hn-keyr :
     1078     define input  parameter p-key-rec    as character no-undo.
     1079     define input  parameter p-key-handle as handle    no-undo .
     1080     define input  parameter p-db-name    as character no-undo .
     1081     define input  parameter p-tt-handle  as handle    no-undo .
     1082     define input  parameter p-stts-lock  as integer   no-undo .
     1083     define output parameter o-hn         as handle    no-undo.
     1084     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1085   end.
     1086   procedure gen-row-keyr :
     1087     define input  parameter p-key-rec    as character no-undo.
     1088     define input  parameter p-key-handle as handle    no-undo .
     1089     define input  parameter p-db-name    as character no-undo .
     1090     define input  parameter p-tt-handle  as handle    no-undo .
     1091     define input  parameter p-stts-lock  as integer   no-undo .
     1092     define output parameter p-tbl-row    as rowid     no-undo.
     1093     define output parameter p-tbl-name   as character no-undo.
     1094     define variable vHn as handle no-undo.
     1095       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1096       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1097       p-tbl-name =  vHn:table.
     1098       delete object vHn no-error.
     1099     if p-tbl-row = ? then do:
     1100       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
     1101     end.
     1102     else do:
     1103       return.
     1104     end.
     1105   end procedure.
     1106   procedure gen-key-fv :
     1107     define input  parameter p-key-rec    as character no-undo .
     1108     define output parameter p-field-list as character no-undo .
     1109     define output parameter p-value-list as character no-undo.
     1110     do
     1111     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1112     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1113     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1114     :
     1115       define variable v-full-tbl-name  as character no-undo .
     1116       define variable bh_tbl-name      as handle    no-undo .
     1117       define variable v-tbl-name       as character no-undo .
     1118       define variable v-field-num      as integer   no-undo .
     1119       define variable v-count-fld      as integer   no-undo .
     1120       define variable v-inform         as character no-undo .
     1121       define variable v-ind            as integer   no-undo .
     1122       define variable v-idx-field-qnty as integer   no-undo .
     1123       define variable v-delim-key      as character no-undo .
     1124       if p-key-rec = ?
     1125         or p-key-rec = "":U
     1126       then do:
     1127         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
     1128       end.
     1129       assign
     1130         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1131         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1132       .
     1133       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1134       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
     1135       assign
     1136         v-inform = bh_tbl-name:index-information(1)
     1137         v-ind    = 2
     1138       .
     1139       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1140       on error undo, return error
     1141       :
     1142         assign
     1143           v-inform = bh_tbl-name:index-information( v-ind )
     1144           v-ind    = v-ind + 1
     1145         .
     1146       end.
     1147       if v-inform = ?
     1148         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1149         or entry( 3, v-inform, ",":U ) <> "1":U
     1150       then do:
     1151         delete object bh_tbl-name no-error.
     1152         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
     1153       end.
     1154       assign
     1155         v-idx-field-qnty = num-entries( v-inform ) - 4
     1156       .
     1157       if v-idx-field-qnty < 2 then do:
     1158         delete object bh_tbl-name no-error.
     1159         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
     1160       end.
     1161       assign
     1162         p-field-list = "":U
     1163         p-value-list = "":U
     1164         v-delim-key  = "":U
     1165         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1166         v-count-fld  = 0
     1167       .
     1168       block_where:
     1169       do v-ind = 1 to v-idx-field-qnty by 2
     1170       on error undo, return error
     1171       :
     1172         assign
     1173           v-count-fld = v-count-fld + 1
     1174         .
     1175         if v-count-fld > v-field-num then do:
     1176           leave block_where.
     1177         end.
     1178         assign
     1179           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1180           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1181         .
     1182         if v-ind = 1 then do:
     1183           assign
     1184             v-delim-key = chr(3)
     1185           .
     1186         end.
     1187       end.
     1188       delete object bh_tbl-name.
     1189       if v-count-fld <> v-field-num then do:
     1190         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
     1191       end.
     1192     end.
     1193   end procedure.
     1194   procedure gen-key-field :
     1195     define input  parameter p-table      as character no-undo .
     1196     define output parameter p-field-list as character no-undo .
     1197     do
     1198     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1199     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1200     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1201     :
     1202       define variable v-full-tbl-name  as character no-undo .
     1203       define variable bh_tbl-name      as handle    no-undo .
     1204       define variable v-tbl-name       as character no-undo .
     1205       define variable v-field-num      as integer   no-undo .
     1206       define variable v-count-fld      as integer   no-undo .
     1207       define variable v-inform         as character no-undo .
     1208       define variable v-ind            as integer   no-undo .
     1209       define variable v-idx-field-qnty as integer   no-undo .
     1210       define variable v-delim-key      as character no-undo .
     1211       if p-table = ?
     1212         or p-table = "":U
     1213       then do:
     1214         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
     1215       end.
     1216       assign
     1217         v-tbl-name      = p-table
     1218         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1219       .
     1220       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1221       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
     1222       assign
     1223         v-inform = bh_tbl-name:index-information(1)
     1224         v-ind    = 2
     1225       .
     1226       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1227       on error undo, return error
     1228       :
     1229         assign
     1230           v-inform = bh_tbl-name:index-information( v-ind )
     1231           v-ind    = v-ind + 1
     1232         .
     1233       end.
     1234       if v-inform = ?
     1235         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1236         or entry( 3, v-inform, ",":U ) <> "1":U
     1237       then do:
     1238         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
     1239       end.
     1240       assign
     1241         v-idx-field-qnty = num-entries( v-inform ) - 4
     1242       .
     1243       if v-idx-field-qnty < 2 then do:
     1244         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
     1245       end.
     1246       assign
     1247         p-field-list = "":U
     1248         v-delim-key  = "":U
     1249         v-count-fld  = 0
     1250       .
     1251       block_where:
     1252       do v-ind = 1 to v-idx-field-qnty by 2
     1253       on error undo, return error
     1254       :
     1255         assign
     1256           v-count-fld = v-count-fld + 1
     1257         .
     1258         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1259         if v-ind = 1 then do:
     1260           assign
     1261             v-delim-key = chr(3)
     1262           .
     1263         end.
     1264       end.
     1265       delete object bh_tbl-name.
     1266     end.
     1267   end procedure.
     1268   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1269     define variable v-cntxt-db-num        as integer   no-undo .
     1270     define variable v-cntxt-userid        as character no-undo .
     1271     define variable v-cntxt-level         as character no-undo .
     1272     define variable v-cntxt-host-code-obj as integer   no-undo .
     1273     define variable v-cntxt-obj-type      as character no-undo .
     1274     define variable v-cntxt-obj-code      as integer   no-undo .
     1275     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1276     define variable v-cntxt-is-admin      as logical   no-undo .
     1277   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1278   FUNCTION get-region RETURNS CHARACTER
     1279     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1280     define variable par-region as character no-undo.
     1281     if parhost-code = 0 and
     1282          parobj-type = "":U and
     1283          parobj-code = 0 then do:
     1284          par-region = "Глобально".
     1285          return par-region.
     1286       end.
     1287       if parobj-type = 'орг':U then do:
     1288          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1289          return par-region.
     1290       end.
     1291       if parobj-type = 'регион':U
     1292       then do:
     1293          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1294          return par-region.
     1295       end.
     1296       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1297       return par-region.
     1298   END FUNCTION.
     1299   FUNCTION get-objregion RETURNS CHARACTER
     1300     (  input parobj-type as character, input parobj-code as integer ) :
     1301     define variable par-region as character no-undo.
     1302     if  parobj-type = "":U and
     1303         parobj-code = 0
     1304     then do:
     1305        par-region = "Глобально".
     1306     end.
     1307     else if parobj-type = 'орг':U
     1308     then do:
     1309        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1310     end.
     1311     else if parobj-type = 'регион':U
     1312     then do:
     1313        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1314     end.
     1315     else
     1316        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1317     return par-region.
     1318   END FUNCTION.
     1319   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1320   define new global shared variable g#attr-lib  as handle no-undo .
     1321   define variable v-attr-lib-variable as handle no-undo .
     1322   procedure bc-oattr_name :
     1323     define input  parameter p-code           as character no-undo .
     1324     define output parameter p-type           as character no-undo .
     1325     define output parameter p-format         as character no-undo .
     1326     define output parameter p-label          as character no-undo .
     1327     define output parameter p-range          as integer   no-undo .
     1328     define output parameter p-user-can-edit  as logical   no-undo .
     1329     define output parameter p-output-display as logical   no-undo .
     1330     define output parameter p-other          as character no-undo .
     1331     do
     1332     on error undo, return error
     1333     :
     1334           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bc-oattr_name in g#attr-lib
     1335         (input  p-code
     1336         ,output p-type
     1337         ,output p-format
     1338         ,output p-label
     1339         ,output p-range
     1340         ,output p-user-can-edit
     1341         ,output p-output-display
     1342         ,output p-other
     1343         ) no-error .
     1344       if error-status :error
     1345       then do:
     1346         undo, return error return-value .
     1347       end.
     1348     end.
     1349   end procedure.
     1350   procedure bc-oattr_tooltip :
     1351     define input  parameter p-code    as character no-undo .
     1352     define output parameter p-tooltip as character no-undo .
     1353     define output parameter p-label   as character no-undo .
     1354     do
