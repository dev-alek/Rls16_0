      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   def
      119   new shared
      120   temp-table  obj-list no-undo
      121     field obj-type like ub.clients.obj-type
      122     field obj-code like ub.clients.obj-code
      123     field obj-name like ub.clients.obj-name
      124     field obj-id   as integer
      125     field db-num   as integer
      126     index pi is primary unique obj-id
      127     index ie1 obj-type obj-code
      128     index ie2 obj-name
      129   .
      130   procedure create_obj-list :
      131      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      132      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      133      do
      134      on error undo, return error return-value
      135      :
      136         define buffer cli-obj for ub.clients .
      137         define variable p-var as integer no-undo .
      138         define buffer buf_obj-list for obj-list .
      139         find last buf_obj-list  use-index pi no-error .
      140         if available buf_obj-list
      141         then
      142            p-var = buf_obj-list.obj-id + 1.
      143         else
      144            p-var = 1.
      145         find first cli-obj where
      146                   cli-obj.obj-type = p-obj-type
      147               and cli-obj.obj-code = p-obj-code
      148         no-lock no-error.
      149         if available cli-obj
      150         then do:
      151            create buf_obj-list.
      152            assign
      153               buf_obj-list.obj-id   = p-var
      154               buf_obj-list.obj-code = cli-obj.obj-code
      155               buf_obj-list.obj-type = cli-obj.obj-type
      156               buf_obj-list.obj-name = cli-obj.obj-name
      157               buf_obj-list.db-num   = cli-obj.db-num
      158            .
      159         end.
      160      end.
      161   end.
