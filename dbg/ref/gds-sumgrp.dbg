      182   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      183   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      184     (input  v-report-name
      185     ,input  2
      186     ,output v-exist
      187     )  .
      188       if NOT v-exist then
      189       DO:
      190         Message
      191           "Нет заданий на печать ! "
      192           view-as alert-box .
      193         Return  .
      194       End.
      195       run gbl/prnfilen.w
      196         (input  ""
      197         ,input  p-DisabledOptions
      198         ,input  string(v-report-name )
      199         ,input  7
      200         ,output v-user-action
      201         ,output v-printed
      202         ) .
      203       if v-printed then
      204       do:
      205         return "YES" .
      206       end.
      207       else
      208       do:
      209         return "NO" .
      210       end.
      211     end.
      212   end procedure.
      213   procedure prn-lib-open-stream :
      214     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      215     define input parameter p-page-size    as integer no-undo .
      216     define input parameter p-is-stream    as logical no-undo .
      217     define input parameter p-append       as logical no-undo .
      218     define variable v-report-name as character no-undo .
      219     do
      220       on error undo, return error
      221       :
      222       run prn-lib-get-report-name  in this-procedure (
      223         input parParentProc
      224         ,output v-report-name
      225         ).
      226       if p-is-stream then
      227       do:
      228         if p-append then
      229         do:
      230           output stream PrnLibStream to value( v-report-name )
      231             page-size value(p-page-size) append .
      232         end.
      233         if not p-append then
      234         do:
      235           output stream PrnLibStream to value( v-report-name )
      236             page-size value(p-page-size) .
      237         end.
      238       end.
      239       if not p-is-stream then
      240       do:
      241         if p-append then
      242         do:
      243           output to value( v-report-name )
      244             page-size value(p-page-size) append .
      245         end.
      246         if not p-append then
      247         do:
      248           output to value( v-report-name )
      249             page-size value(p-page-size) .
      250         end.
      251       end.
      252     end.
      253   end procedure.
      254   procedure prn-lib-open-exp :
      255     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      256     define input parameter p-is-stream    as logical no-undo .
      257     define input parameter p-is-append    as logical no-undo .
      258     define output parameter p-ReportFileName as char init "report" no-undo.
      259     define output parameter p-process as logical no-undo .
      260     define variable glog as logical no-undo .
      261     do
      262       on error undo, return error
      263       :
      264       SYSTEM-DIALOG GET-FILE p-ReportFileName
      265         TITLE      "Укажите путь"
      266         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      267         ASK-OVERWRITE
      268         CREATE-TEST-FILE
      269         SAVE-AS
      270         USE-FILENAME
      271         DEFAULT-EXTENSION "txt"
      272         UPDATE glog
      273         .
      274       if not glog then  return.
      275       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      276       if p-is-stream then
      277       do:
      278         if p-is-append then
      279         do:
      280           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      281         end.
      282         else
      283         do:
      284           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      285         end.
      286       end.
      287       else
      288       do:
      289         if p-is-append then
      290         do:
      291           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      292         end.
      293         else
      294         do:
      295           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      296         end.
      297       end.
      298       p-process = yes.
      299     end.
      300   end procedure.
      301   procedure prn-lib-get-report-name :
      302     define input parameter parParentProc  as widget-handle no-undo.
      303     define output parameter p-report-name as character no-undo .
      304     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      305   end procedure.
      306   procedure prn-lib-reportviewer-report-name :
      307     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      308     define input parameter p-report-name-html as character no-undo .
      309     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      310   end procedure.
      311   procedure prn-lib-reportviewer :
      312     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      313     define input parameter p-report-name-html as character no-undo .
      314     define input parameter p-param        as character no-undo .
      315     define variable v-excel           as character no-undo init 'TRUE' .
      316     define variable v-value-character as character no-undo .
      317     define variable v-value-integer   as character no-undo .
      318     define variable v-value-date      as date      no-undo .
      319     define variable v-value-decimal   as decimal   no-undo .
      320     define variable rep-excel         as logical   no-undo .
      321     define variable excel-string      as character no-undo .
      322     define variable v-param-type      as character no-undo .
      323     define variable v-tth             as handle    no-undo .
      324     run adm/shattri.p (
      325       input "get":U
      326       ,input  ""
      327       ,input  0
      328       ,input  'report-glob':U
      329       ,input  'rep-excel':U
      330       ,output v-value-character
      331       ,output v-value-date
      332       ,output v-value-decimal
      333       ,output v-value-integer
      334       ,output rep-excel
      335       ,output v-param-type
      336       ,INPUT-OUTPUT table-handle v-tth
      337       )  .
      338     if rep-excel then v-excel = "TRUE" .
      339     else v-excel = "FALSE" .
      340     if p-param eq ""
      341     then
      342        p-param = "EXCEL:" + v-excel.
      343     else
      344        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      345     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      346   end procedure.
      347   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      348   procedure cur-time :
      349      define output parameter p-today as date      no-undo .
      350      define output parameter p-time  as integer   no-undo .
      351     do
      352     on error undo, return error
      353     :
      354       define variable v-date1 as date      no-undo .
      355       define variable v-date2 as date      no-undo .
      356       define variable v-time  as integer   no-undo .
      357       assign
      358         v-date1 = today
      359         v-time  = time
      360         v-date2 = today
      361       .
      362       if v-date1 <> v-date2
      363       then do:
      364         assign
      365           v-date1 = today
      366           v-time  = v-time
      367         .
      368       end.
      369       assign
      370         p-today = v-date1
      371         p-time  = v-time
      372       .
      373     end.
      374   end.
      375   function cur-time-date returns character
      376   :
      377     return string(today, '99/99/9999':U) .
      378   end.
      379   function cur-time-mjd returns decimal
      380   :
      381     define variable v-date as date      no-undo .
      382     define variable v-time as integer   no-undo .
      383     run cur-time in this-procedure
      384       (output v-date
      385       ,output v-time
      386       ) .
      387     return integer(v-date) - 2400002 + (v-time / 86400) .
      388   end.
      389   function cur-time-get-ending-index returns integer
      390   (input p-number as integer
      391   )
      392   :
      393     if p-number < 0
      394     or p-number = ?
      395     then do:
      396       return 1 .
      397     end.
      398     define variable v-rest as integer   no-undo .
      399     assign
      400       p-number = p-number modulo 100
      401     .
      402     if p-number < 20
      403     then do:
      404       assign
      405         v-rest = p-number
      406       .
      407     end.
      408     else do:
      409       assign
      410         v-rest = p-number modulo 10
      411       .
      412     end.
      413     case v-rest :
      414       when 1
      415       then do:
      416         return 2 .
      417       end.
      418       when 2 or
      419       when 3 or
      420       when 4
      421       then do:
      422         return 3 .
      423       end.
      424       otherwise do:
      425         return 1 .
      426       end.
      427     end case .
      428   end.
      429   procedure cur-time-mjd-to-date :
      430      define input  parameter i-mjd-diff as decimal no-undo.
      431      define output parameter o-Date     as date    no-undo.
      432      define output parameter o-Time     as integer no-undo.
      433      define variable v-day-number as integer   no-undo .
      434      if    i-mjd-diff < 0
      435         or i-mjd-diff = ?
      436      then do:
      437         return "?" .
      438      end.
      439      assign
      440         v-day-number = truncate(i-mjd-diff,0).
      441         o-Date = date(v-day-number + 2400002).
      442         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      443     .
      444   end.
      445   function cur-time-mjd-to-string returns character
      446   (input p-mjd-diff as decimal
      447   )
      448   :
      449     define variable v-day-number as integer   no-undo .
      450     define variable v-seconds    as integer   no-undo .
      451     define variable v-hour       as integer   no-undo .
      452     define variable v-min        as integer   no-undo .
      453     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      454     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      455     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      456     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      457     if p-mjd-diff < 0
      458     or p-mjd-diff = ?
      459     then do:
      460       return "?" .
      461     end.
      462     assign
      463       v-day-number = integer(truncate(p-mjd-diff,0))
      464       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      465     .
      466     if v-seconds > 86400
      467     then do:
      468       assign
      469         v-seconds = 86400 - 1
      470       .
      471     end.
      472     if v-seconds < 0
      473     then do:
      474       assign
      475         v-seconds = 0
      476       .
      477     end.
      478     assign
      479       v-hour = truncate(v-seconds / 3600, 0)
      480     .
      481     assign
      482       v-seconds = v-seconds modulo 3600
      483     .
      484     assign
      485       v-min = truncate(v-seconds / 60, 0)
      486     .
      487     assign
      488       v-seconds = v-seconds modulo 60
      489     .
      490     return
      491         (if v-day-number <> 0
      492           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      493           else ""
      494         )
      495       + (if v-day-number <> 0 or v-hour <> 0
      496           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      497           else ""
      498         )
      499       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      500           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      501           else ""
      502         )
      503       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      504       .
      505   end.
      506   function cur-time-string returns character
      507   :
      508     define variable v-date as date      no-undo .
      509     define variable v-time as integer   no-undo .
      510     run cur-time in this-procedure
      511       (output v-date
      512       ,output v-time
      513       ) .
      514     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      515   end.
      516   function cur-time-string-sec returns character
      517   :
      518     define variable v-date as date      no-undo .
      519     define variable v-time as integer   no-undo .
      520     run cur-time in this-procedure
      521       (output v-date
      522       ,output v-time
      523       ) .
      524     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      525   end.
      526   function cur-time-custom  returns character
      527   (input p-prefix as character
      528   ,input p-date-format as character
      529   ,input p-delimiter as character
      530   ,input p-time-format as character
      531   ,input p-suffix as character
      532   )
      533   :
      534     define variable v-date as date      no-undo .
      535     define variable v-time as integer   no-undo .
      536     run cur-time in this-procedure
      537       (output v-date
      538       ,output v-time
      539       ) .
      540     return
      541       p-prefix
      542       + string(v-date, p-date-format)
      543       + p-delimiter
      544       + string(v-time, p-time-format)
      545       + p-suffix
      546       .
      547   end.
      548   function cur-time-print  returns character
      549   :
      550     define variable v-date as date      no-undo .
      551     define variable v-time as integer   no-undo .
      552     run cur-time in this-procedure
      553       (output v-date
      554       ,output v-time
      555       ) .
      556     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      557   end.
      558   function cur-time-datetime returns datetime
      559   :
      560     define variable v-char as character no-undo .
      561     define variable v-datetime as datetime no-undo .
      562     v-char = cur-time-string().
      563     v-datetime = datetime(v-char).
      564     return  v-datetime.
      565   end.
      566   function cur-time-string-msec returns character
      567   :
      568     define variable v-date as datetime  no-undo .
      569     v-date = now.
      570     return string(v-date) .
      571   end.
      572   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      573   define variable v-waitfram-action01         as character   no-undo .
      574   define variable v-waitfram-action02         as character   no-undo .
      575   define variable v-waitfram-action03         as character   no-undo .
      576   define variable mWaitFramTextBeg            as character   no-undo.
      577   define variable mWaitFramTextEnd            as character   no-undo.
      578   define variable mWaitFramView               as logical     no-undo.
      579   define variable mWaitProcEvent              as logical     no-undo init yes.
      580   define variable mWaitFramInterval           as integer     no-undo init 1 .
      581   define variable mWaitFramStop               as logical     no-undo.
      582   define variable mWaitFramStopUser           as logical     no-undo.
      583   define variable mWaitFramStopTimeOut        as logical     no-undo.
      584   define variable mWaitFramStartProc          as datetime-tz no-undo.
      585   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      586   define button B-WaitFramStop auto-end-key
      587        label "Стоп"
      588        size 10 by 1 tooltip "Остоновить процесс".
      589   define button B-viewProcInfo
      590        label "Информация"
      591        size 15 by 1 tooltip "Информация о процесс".
      592   define frame waitfram
      593     v-waitfram-action01 format "x(72)" no-label skip
      594     v-waitfram-action02 format "x(72)" no-label skip
      595     v-waitfram-action03 format "x(72)" no-label skip
      596     B-viewProcInfo
      597     B-WaitFramStop at row 4 col 30
      598     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      599     .
      600   define new global shared variable mBatchMode as logical no-undo init ?.
      601   define variable mFramBachModHandle as handle no-undo.
      602   mFramBachModHandle = frame waitfram:handle.
      603   define variable mFameOldVis as logical no-undo.
      604   define variable mVisCUrentVin as logical no-undo.
      605   if session:batch-mode
      606   then
      607      mBatchMode = yes.
      608   if mBatchMode = ? then do:
      609     mVisCUrentVin = current-window:visible.
      610     mFameOldVis = mFramBachModHandle:visible.
      611     mFramBachModHandle:visible  = yes.
      612     mBatchMode = mFramBachModHandle:visible ne yes.
      613     mFramBachModHandle:visible = mFameOldVis.
      614     current-window:visible = mVisCUrentVin.
      615   end.
      616    if  log-manager:logfile-name ne ?
      617     then DO:
      618         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      619         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      620         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      621     end.
      622   on choose of B-WaitFramStop in frame waitfram
      623   do:
      624     mWaitFramStop = yes.
      625     mWaitFramStopUser = yes.
      626   end.
      627   function waitfram-check-timeout returns logical():
      628      define variable vtime as int64 no-undo.
      629      if mWaitFramStopTimeOut
      630      then
      631         return yes.
      632      vtime = ( now - mWaitFramStartProc ) / 1000 .
      633      if     mWaitFramTimeOut ne ?
      634         and mWaitFramTimeOut ne 0
      635         and mWaitFramTimeOut lt vtime
      636      then do:
      637         mWaitFramStopTimeOut = yes.
      638      end.
      639      return mWaitFramStopTimeOut.
      640   end.
      641   procedure waitfram-hide :
      642     if not session:batch-mode
      643     then do
      644     on error undo, return error return-value
      645     :
      646       pause 0 before-hide .
      647       if not mBatchMode then
      648         hide frame waitfram .
      649     if     not mWaitFramView
      650        and mWaitProcEvent
      651     then
      652       process events .
      653     end.
      654   end procedure.
      655   procedure waitfram-show :
      656     define input  parameter p-message as character no-undo .
      657     define variable v-left-margin as integer   no-undo .
      658     if not session:batch-mode
      659     then do
      660     on error undo, return error return-value
      661     :
      662       if length(p-message) <= 70 then do:
      663         assign
      664           v-left-margin = integer((70 - length(p-message)) / 2)
      665         .
      666         assign
      667           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      668         .
      669         assign
      670           v-waitfram-action01 = " "
      671           v-waitfram-action02 = " "
      672                                    + fill(" ", v-left-margin)
      673                                    + p-message
      674           v-waitfram-action03 = " "
      675         .
      676       end.
      677       else do:
      678         define variable vRindex1 as integer no-undo.
      679         define variable vRindex2 as integer no-undo.
      680         vRindex1 = r-index(p-message," ",70).
      681         if vRindex1 = 0
      682         then
      683            vRindex1 = 70.
      684         if length(p-message)  <= vRindex1 + 70 then do:
      685           assign
      686             v-waitfram-action01 = " "
      687             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      688             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      689           .
      690         end.
      691         else do:
      692           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      693           if vRindex2 <= vRindex1
      694           then
      695              vRindex2 = vRindex1 + 70.
      696           assign
      697             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      698             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      699             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      700           .
      701         end.
      702       end.
      703       B-viewProcInfo:visible   in frame waitfram = no.
      704       B-viewProcInfo:sensitive in frame waitfram = no.
      705       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      706       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      707       if  (   mWaitFramView
      708          or  mWaitProcEvent)
      709          and not mBatchMode
      710       then
      711          display
      712             v-waitfram-action01 skip
      713             v-waitfram-action02 skip
      714             v-waitfram-action03 skip
      715          with frame waitfram .
      716       if     mWaitFramView
      717          then do:
      718             if     mWaitFramInterval ne ?
      719                and not mBatchMode
      720             then
      721                wait-for go of frame waitfram pause mWaitFramInterval.
      722          end.
      723          else
      724             if     mWaitProcEvent
      725                and not mBatchMode
      726             then
      727                process events .
      728     end.
      729   end procedure.
      730      procedure waitfram-show-this:
      731         define input  parameter iInterval as int64 no-undo.
      732         define variable vtime as int64 no-undo.
      733         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      734         mWaitFramInterval = iInterval.
      735         run waitfram-show (substitute("&1&2 &3&4" ,
      736                                       mWaitFramTextBeg ,
      737                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      738                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      739                                       mWaitFramTextEnd
      740                                      )
      741                           ).
      742      end.
      743      procedure WaitFramRunPause:
      744         define input  parameter iInterval as dec no-undo.
      745         define variable vStart  as datetime-tz no-undo.
      746         define variable vend    as datetime-tz no-undo.
      747         define variable vint as int64 no-undo.
      748         define variable vOk as logical no-undo.
      749         vStart = now.
      750         vend   = vStart.
      751         publish "WaitFramPause" (iInterval,output vOk).
      752         vend   =  now.
      753         vint = vend - vStart.
      754         vint = iInterval - vint / 1000.
      755         if     not mWaitFramStop
      756            and (   vint > 0
      757                 or (    not vOk
      758                     and iInterval eq ?
      759                     )
      760                 )
      761         then
      762            run waitfram-show-this (iInterval).
      763         vend   =  now.
      764         vint = vend - vStart.
      765         vint = iInterval - vint / 1000.
      766         if     not mWaitFramStop
      767            and vint > 0
      768         then do:
      769            run gbl/pause.p (vint * 1000).
      770         end.
      771         if iInterval ne ?
      772         then
      773            publish "WaitFramStop".
      774         waitfram-check-timeout().
      775      end.
      776      procedure WaitFramWaitFor:
      777         define input  parameter iInterval as dec no-undo.
      778         assign
      779            mWaitFramStartProc   = now
      780            mWaitFramStopUser    = no
      781            mWaitFramStopTimeOut = no
      782         .
      783         block-wait:
      784         do while not mWaitFramStop:
      785            run WaitFramRunPause (iInterval).
      786            if  waitfram-check-timeout()
      787            then do:
      788               leave block-wait.
      789            end.
      790         end.
      791         run waitfram-hide.
      792      end.
      793   procedure waitfram-join :
      794     define input  parameter p-line-1  as character no-undo .
      795     define input  parameter p-line-2  as character no-undo .
      796     define input  parameter p-line-3  as character no-undo .
      797     define output parameter p-message as character no-undo .
      798     do
      799     on error undo, return error return-value
      800     :
      801       assign
      802         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      803                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      804                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      805       .
      806     end.
      807   end procedure.
      808   function waitfram-join-function returns character
      809     (input p-line-1 as character
      810     ,input p-line-2 as character
      811     ,input p-line-3 as character
      812     ).
      813     define variable v-message as character no-undo .
      814     run waitfram-join in this-procedure
      815       (input  p-line-1
      816       ,input  p-line-2
      817       ,input  p-line-3
      818       ,output v-message
      819       ) .
      820     return v-message .
      821   end function .
      822   define variable log-res as log no-undo.
      823   define variable rr as recid no-undo.
      824   define variable dops as character no-undo.
      825   define variable dopst as character no-undo.
      826   define variable glog as logical no-undo .
      827   DEFINE VARIABLE dgrpr-option AS CHARACTER NO-UNDO.
      828   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      829   define buffer b_sum-grp for ub.sum-grp.
      830   DEFINE MENU MENU-b-disc
      831          MENU-ITEM m_lookup-disc  LABEL "Просмотр"
      832          MENU-ITEM m_update-disc  LABEL "Изменение"     .
      833   DEFINE BUTTON b-add
      834        LABEL "&Добавить":L
      835        SIZE 10 BY 1.
      836   DEFINE BUTTON b-chg
      837        LABEL "&Изменить":L
      838        SIZE 10 BY 1.
      839   DEFINE BUTTON b-del
      840        LABEL "&Удалить":L
      841        SIZE 10 BY 1.
      842   DEFINE BUTTON b-disc
      843        LABEL "&Скидки"
      844        SIZE 10 BY 1.
      845   DEFINE BUTTON b-help
      846        LABEL "&Помощь":L
      847        SIZE 3 BY 1.
      848   DEFINE BUTTON b-hist
      849        LABEL "Истори&я"
      850        SIZE 3 BY 1.
      851   DEFINE BUTTON b-mark
      852        LABEL "&*":L
      853        SIZE 3 BY 1.
      854   DEFINE BUTTON b-print
      855        LABEL "П&ечать":L
      856        SIZE 3 BY 1.
      857   DEFINE BUTTON b-quit AUTO-GO
      858        LABEL "&Выход ":L
      859        SIZE 10 BY 1.
      860   DEFINE BUTTON b-sel AUTO-GO
      861        LABEL "Вы&бор ":L
      862        SIZE 10 BY 1.
      863   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>9":U INITIAL 0
      864        VIEW-AS FILL-IN
      865        SIZE 6.3 BY 1
      866        FGCOLOR 10  NO-UNDO.
      867   DEFINE QUERY br-sumgrps FOR
      868         X_sum-grp SCROLLING.
      869   DEFINE BROWSE br-sumgrps
      870     QUERY br-sumgrps NO-LOCK DISPLAY
      871         if lookup(string(recid(X_sum-grp)), v-rid-list) > 0 then "*" else "":U FORMAT "X(1)":U
      872     X_sum-grp.grp-code FORMAT "999":U width 10
      873     X_sum-grp.grp-name COLUMN-LABEL "Наименование группы" FORMAT "X(65)":U
      874       WITH SEPARATORS SIZE 80 BY 17
      875            BGCOLOR 15 FGCOLOR 0 .
      876   DEFINE FRAME d-sum-grp
      877        b-quit AT ROW 1 COL 1
      878        b-mark AT ROW 1 COL 15
      879        b-sel AT ROW 1 COL 18
      880        b-add AT ROW 1 COL 28
      881        b-chg AT ROW 1 COL 38
      882        b-del AT ROW 1 COL 48
      883        b-disc AT ROW 1 COL 58 WIDGET-ID 2
      884        b-hist AT ROW 1 COL 73
      885        b-print AT ROW 1 COL 76
      886        b-help AT ROW 1 COL 79
      887        mark-num AT ROW 1.03 COL 9.1 COLON-ALIGNED NO-LABEL
      888        br-sumgrps AT ROW 2.9 COL 2.5
      889        SPACE(0.9) SKIP(0.3)
      890       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      891            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      892            TITLE "ГРУППЫ ТОВАРОВ НА КАССАХ":L.
      893   ASSIGN
      894          FRAME d-sum-grp:SCROLLABLE       = FALSE.
      895   ASSIGN
      896          b-disc:POPUP-MENU IN FRAME d-sum-grp       = MENU MENU-b-disc:HANDLE.
      897   ON END-ERROR OF FRAME d-sum-grp
      898   OR ENDKEY OF FRAME d-sum-grp DO:
      899      run gbl/markqwa.p (
      900                              input b-mark:sensitive
      901                             , input v-rid-list) no-error.
      902       if error-status:error then return no-apply.
      903     run proc-send in this-procedure no-error.
      904   END.
      905   ON GO OF FRAME d-sum-grp
      906   DO:
      907     p-rid-list = v-rid-list.
      908     run proc-send in this-procedure no-error.
      909   END.
      910   ON CHOOSE OF b-add IN FRAME d-sum-grp
      911   DO:
      912   END.
      913   ON CHOOSE OF b-chg IN FRAME d-sum-grp
      914   DO:
      915   END.
      916   ON CHOOSE OF b-del IN FRAME d-sum-grp
      917   DO:
      918   END.
      919   ON CHOOSE OF b-disc IN FRAME d-sum-grp
      920   DO:
      921   END.
      922   ON CHOOSE OF b-hist IN FRAME d-sum-grp
      923   DO:
      924   END.
      925   ON CHOOSE OF b-mark IN FRAME d-sum-grp
      926   DO:
      927     if available X_sum-grp then do:
      928   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      929   define variable v-str-recid7 as character no-undo .
      930   define variable v-num-entry7 as integer   no-undo .
      931   assign
      932     v-str-recid7 = trim( string( recid( X_sum-grp ) , "->>>>>>>>>>>9":U ) )
      933     v-num-entry7 = lookup( v-str-recid7 , v-rid-list )
      934   .
      935   if v-num-entry7 > 0 then do:
      936     assign
      937       entry( v-num-entry7, v-rid-list ) = "":U
      938       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      939     .
      940   end.
      941   else do:
      942     assign
      943       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid7
      944     .
      945   end.
      946       glog = br-sumgrps:refresh() .
      947       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      948               glog = br-sumgrps:select-next-row ().
      949               apply "iteration-changed" to br-sumgrps in frame d-sum-grp.
      950         end.
      951       if num-entries( v-rid-list ) = 0 then
      952           hide mark-num in frame d-sum-grp.
      953       else
      954           disp num-entries( v-rid-list ) @ mark-num with frame d-sum-grp.
      955     end.
      956     apply "entry" to br-sumgrps in frame d-sum-grp.
      957   END.
      958   ON CHOOSE OF b-print IN FRAME d-sum-grp
      959   DO:
      960   END.
      961   ON CHOOSE OF b-sel IN FRAME d-sum-grp
      962   DO:
      963       if ( available X_sum-grp ) AND (( v-rid-list = "" ) or b-mark:sensitive = no) then
      964           v-rid-list = string( recid( X_sum-grp ) ) .
      965   END.
      966   ON DEFAULT-ACTION OF br-sumgrps IN FRAME d-sum-grp
      967   DO:
      968     case yes:
      969         when  b-chg:sensitive THEN apply "CHOOSE":U to b-chg.
      970     end case.
      971   END.
      972   ON INSERT-MODE OF br-sumgrps IN FRAME d-sum-grp
      973   OR MOUSE-SELECT-DBLCLICK OF br-sumgrps
      974   DO:
      975       if can-do(bttns, "b-mark") then
      976       apply "choose" to b-mark in frame d-sum-grp .
      977       else if can-do( bttns, "b-sel" ) then
      978           apply "choose" to b-sel in frame d-sum-grp .
      979       else dO:
      980       end.
      981   END.
      982   ON MOUSE-SELECT-DBLCLICK OF br-sumgrps IN FRAME d-sum-grp
      983   DO:
      984     if can-do( bttns, "b-sel" ) then do:
      985       apply "choose" to b-sel in frame d-sum-grp .
      986       return no-apply .
      987     end.
      988   END.
      989   ON RETURN OF br-sumgrps IN FRAME d-sum-grp
      990   DO:
      991       if can-do( bttns, "b-sel" ) then
      992           apply "choose" to b-sel in frame d-sum-grp .
      993       else
      994            apply "DEFAULT-ACTION":U to self.
      995   END.
      996   ON CHOOSE OF MENU-ITEM m_lookup-disc
      997   DO:
      998   END.
      999   ON CHOOSE OF MENU-ITEM m_update-disc
     1000   DO:
     1001   END.
     1002   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-sum-grp:PARENT eq ?
     1003   THEN FRAME d-sum-grp:PARENT = ACTIVE-WINDOW.
     1004   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1005   on help of frame d-sum-grp
     1006   do:
     1007     run gbl/app_help.p
     1008       (input this-procedure :file-name
     1009       ,input ''
     1010       ,input ?
     1011       ) no-error.
     1012     if error-status :error then do:
     1013       message
     1014         "Ошибка при вызове помощи"
     1015         error-status :get-message(1)
     1016         view-as alert-box .
     1017     end.
     1018   end.
     1019   run minbtn-set in this-procedure .
     1020   on choose of b-help in frame d-sum-grp
     1021   do:
     1022     apply "help":u to frame d-sum-grp .
     1023   end.
     1024   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1025   procedure minbtn-set :
     1026       do
     1027           on error undo, return error return-value
     1028           :
     1029           define variable ii              as integer       no-undo .
     1030           define variable fh              as widget-handle no-undo .
     1031           define variable hh              as widget-handle no-undo .
     1032           define variable v-h             as handle        extent 4 no-undo .
     1033           define variable v-name-button   as character     no-undo .
     1034           define variable v-help-old-x    as decimal       no-undo .
     1035           define variable v-help-old-y    as decimal       no-undo .
     1036           define variable v-help-old-size as decimal       no-undo .
     1037           define variable v-frame-width   as decimal       no-undo .
     1038           define variable jj              as integer       no-undo .
     1039           do
     1040               on error undo, return error
     1041               :
     1042               assign
     1043                   v-frame-width = frame d-sum-grp:width - 0.3
     1044                   fh            = frame d-sum-grp:first-child
     1045                   hh            = fh:first-child
     1046                   ii            = 1
     1047                   .
     1048               do while valid-handle(hh):
     1049                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1050                   do:
     1051                       case lc(hh:name) :
     1052                           when "b-help" then
     1053                               do:
     1054                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1055                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1056                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1057                                   hh:TOOLTIP = "Помощь" .
     1058                                   v-help-old-x = hh:column .
     1059                                   v-help-old-y = hh:row    .
     1060                                   v-help-old-size = hh:width .
     1061                                   hh:width-chars = 2.5 .
     1062                               end.
     1063                           when "b-print" then
     1064                               do:
     1065                                   hh:load-image("cmp/b-print.bmp":u) .
     1066                                   hh:TOOLTIP = "Печать" .
     1067                                   v-h[ii] = hh:handle .
     1068                                   ii = ii + 1 .
     1069                                   hh:width-chars = 3 .
     1070                               end.
     1071                           when "b-history" or
     1072                           when "b-hist" then
     1073                               do:
     1074                                   hh:load-image("cmp/b-hist.bmp":u) .
     1075                                   hh:TOOLTIP = "История" .
     1076                                   v-h[ii] = hh:handle .
     1077                                   ii = ii + 1 .
     1078                                   hh:width-chars = 3 .
     1079                               end.
     1080                           when "b-sch" then
     1081                               do:
     1082                                   hh:load-image("cmp/b-sch.bmp":u) .
     1083                                   hh:TOOLTIP = "Установка Фильтра" .
     1084                                   v-h[ii] = hh:handle .
     1085                                   ii = ii + 1 .
     1086                                   hh:width-chars = 3 .
     1087                               end.
     1088                           when "b-hist-user" then
     1089                               do:
     1090                                   hh:load-image("cmp/b-hist.bmp":u) .
     1091                                   hh:TOOLTIP = "История пользователя" .
     1092                                   ii = ii + 1 .
     1093                               end.
     1094                       end case.
     1095                   end.
     1096                   hh = hh:next-sibling.
     1097               end.
     1098               b-help:column = v-frame-width - b-help:width-chars.
     1099               jj = 0.
     1100               repeat ii = 4 to 1 by -1 :
     1101                   if valid-handle (v-h[ii] ) then
     1102                   do:
     1103                       jj  = jj + 1 .
     1104                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1105                       v-h[ii]:row    = v-help-old-y .
     1106                   end.
     1107               end.
     1108           end.
     1109       end.
     1110   end procedure.
     1111   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1112   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1113   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1114   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1115   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1116   define variable v-diasize-current-frame-height as decimal   no-undo .
     1117   define variable v-diasize-change-size          as logical   no-undo .
     1118   define variable v-diasize-resize-button        as handle    no-undo .
     1119   define variable v-diasize-wndmax               as logical   no-undo .
     1120   define variable v-diasize-wndstore             as logical   no-undo .
     1121   define variable v-diasize-proc-name            as character no-undo .
     1122   define variable v-diasize-browse-handle        as handle    no-undo .
     1123   define variable v-diasize-browse-number        as integer   no-undo .
     1124   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1125   define temp-table temp-diasize-handle no-undo
     1126     field handle-value  as handle
     1127     field save-position as decimal
     1128     index xpk is primary unique handle-value
     1129     .
     1130   define temp-table temp-browse-handle no-undo
     1131     field browse-type   as character
     1132     field browse-number as integer
     1133     field browse-handle as handle
     1134     field original-size as decimal
     1135     index xpk is primary unique browse-type browse-number
     1136     index xie browse-type browse-handle
     1137   .
     1138   procedure diasize_change-height :
     1139     define input  parameter p-change-value  as decimal   no-undo .
     1140     define input  parameter p-move-resize   as logical   no-undo .
     1141     define variable v-field-group-handle    as handle    no-undo .
     1142     define variable v-object-handle         as handle    no-undo .
     1143     define variable v-frame-height          as decimal   no-undo .
     1144     define variable v-frame-virtual-height  as decimal   no-undo .
     1145     define variable v-browse-height         as decimal   no-undo .
     1146     define variable v-window-height         as decimal   no-undo .
     1147     define variable v-window-virtual-height as decimal   no-undo .
     1148     define variable v-change-sign           as integer   no-undo .
     1149     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1150     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1151     if p-change-value > 0
     1152     then do:
     1153       if frame d-sum-grp :height + p-change-value
     1154           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1155       then do:
     1156         assign
     1157           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1158                           - (frame d-sum-grp :height-chars)
     1159         .
     1160         if p-change-value <= 0
     1161         then do:
     1162           run diasize_position-resize-button in this-procedure .
     1163           return .
     1164         end.
     1165       end.
     1166     end.
     1167     if p-change-value < 0
     1168     then do:
     1169       if frame d-sum-grp :height + p-change-value < v-diasize-orig-frame-height
     1170       then do:
     1171         assign
     1172           p-change-value = v-diasize-orig-frame-height
     1173                          - (frame d-sum-grp :height-chars)
     1174         .
     1175         if p-change-value >= 0
     1176         then do:
     1177           run diasize_position-resize-button in this-procedure .
     1178           return .
     1179         end.
     1180       end.
     1181     end.
     1182     if p-change-value >= 0
     1183     then do:
     1184       assign
     1185         v-change-sign = 1
     1186       .
     1187     end.
     1188     else do:
     1189       assign
     1190         v-change-sign = -1
     1191       .
     1192     end.
     1193     assign
     1194       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1195     .
     1196     if p-change-value = 0
     1197     then do:
     1198       run diasize_position-resize-button in this-procedure .
     1199       return .
     1200     end.
     1201     move_block:
     1202     do
     1203     on error undo move_block, retry move_block
     1204     :
     1205       if retry
     1206       then do:
     1207         do
     1208         on error undo move_block, leave move_block
     1209         :
     1210           if p-change-value > 0
     1211           then do:
     1212             for each buf_temp-diasize-handle
     1213             on error undo, next
     1214             :
     1215               assign
     1216                 v-object-handle = buf_temp-diasize-handle.handle-value
     1217               .
     1218               if v-object-handle <> v-diasize-resize-button
     1219               then do:
     1220                 assign
     1221                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1222                 .
     1223               end.
     1224             end.
     1225             assign
     1226               v-diasize-browse-handle :height = v-browse-height
     1227             .
     1228             for each buf_temp-browse-handle
     1229               where buf_temp-browse-handle.browse-type = 'height':u
     1230             on error undo, next
     1231             :
     1232               assign
     1233                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1234               .
     1235             end.
     1236             assign
     1237               frame d-sum-grp :height = v-frame-height
     1238             .
     1239             if frame d-sum-grp :scrollable = true
     1240             then do:
     1241               assign
     1242                 frame d-sum-grp :virtual-height = v-frame-virtual-height
     1243               .
     1244             end.
     1245             run diasize_position-resize-button in this-procedure .
     1246           end.
     1247           else do:
     1248             if frame d-sum-grp :scrollable = true
     1249             then do:
     1250               assign
     1251                 frame d-sum-grp :virtual-height = v-frame-virtual-height
     1252               .
     1253             end.
     1254             assign
     1255               frame d-sum-grp :height = v-frame-height
     1256             .
     1257             assign
     1258               v-diasize-browse-handle :height = v-browse-height
     1259             .
     1260             for each buf_temp-browse-handle
     1261               where buf_temp-browse-handle.browse-type = 'height':u
     1262             on error undo, next
     1263             :
     1264               assign
     1265                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1266               .
     1267             end.
     1268             for each buf_temp-diasize-handle
     1269             on error undo, next
     1270             :
     1271               assign
     1272                 v-object-handle = buf_temp-diasize-handle.handle-value
     1273               .
     1274               if v-object-handle <> v-diasize-resize-button
     1275               then do:
     1276                 assign
     1277                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1278                 .
     1279               end.
     1280             end.
     1281             run diasize_position-resize-button in this-procedure .
     1282           end.
     1283           assign
     1284             v-diasize-change-size = false
     1285           .
     1286           leave move_block .
     1287         end.
     1288       end.
     1289       assign
     1290         v-diasize-need-full-display = true
     1291       .
     1292       if v-diasize-change-size = false
     1293       then do:
     1294         assign
     1295           v-diasize-change-size = true
     1296         .
     1297       end.
     1298       else do:
     1299         return .
     1300       end.
     1301       assign
     1302         v-frame-height = frame d-sum-grp :height
     1303         v-frame-virtual-height = frame d-sum-grp :virtual-height
     1304         v-browse-height = v-diasize-browse-handle :height
     1305       .
     1306       for each buf_temp-browse-handle
     1307         where buf_temp-browse-handle.browse-type = 'height':u
     1308       :
     1309         assign
     1310           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1311         .
     1312       end.
     1313       for each buf_temp-diasize-handle
     1314       :
     1315         delete buf_temp-diasize-handle .
     1316       end.
     1317       assign
     1318         v-field-group-handle = frame d-sum-grp :first-child
     1319       .
     1320       do while valid-handle(v-field-group-handle)
     1321       :
     1322         assign
     1323           v-object-handle = v-field-group-handle :first-child
     1324         .
     1325         do while valid-handle(v-object-handle)
     1326         :
     1327           if  v-object-handle <> v-diasize-browse-handle :handle
     1328           and can-query(v-object-handle, "row")
     1329           and can-query(v-object-handle, "height")
     1330           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1331           then do:
     1332             find first buf_temp-browse-handle
     1333               where buf_temp-browse-handle.browse-type   = 'height':u
     1334                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1335               no-error .
     1336             if available buf_temp-browse-handle
     1337             then do:
     1338             end.
     1339             else do:
     1340               create buf_temp-diasize-handle .
     1341               assign
     1342                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1343                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1344               .
     1345             end.
     1346           end.
     1347           assign
     1348             v-object-handle = v-object-handle :next-sibling
     1349           .
     1350         end.
     1351         assign
     1352           v-field-group-handle = v-field-group-handle :next-sibling
     1353         .
     1354       end.
     1355       do with frame d-sum-grp
     1356       :
     1357         hide v-diasize-resize-button .
     1358         assign
     1359           v-diasize-resize-button :row    = 1
     1360           v-diasize-resize-button :column = 1
     1361         .
     1362       end.
     1363       if p-change-value > 0
     1364       then do:
     1365         if frame d-sum-grp :scrollable = true
     1366         then do:
     1367           assign
     1368             frame d-sum-grp :virtual-height = frame d-sum-grp :virtual-height + p-change-value
     1369             no-error .
     1370           if error-status :error
     1371           or error-status :get-message(1) <> ""
     1372           then do:
     1373             undo move_block, retry move_block .
     1374           end.
     1375         end.
     1376         assign
     1377           frame d-sum-grp :height = frame d-sum-grp :height + p-change-value
     1378           no-error .
     1379         if error-status :error
     1380         or error-status :get-message(1) <> ""
     1381         then do:
     1382           undo move_block, retry move_block .
     1383         end.
     1384         assign
     1385           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1386           no-error .
     1387         if error-status :error
     1388         or error-status :get-message(1) <> ""
     1389         then do:
     1390           undo move_block, retry move_block .
     1391         end.
     1392         for each buf_temp-browse-handle
     1393           where buf_temp-browse-handle.browse-type = 'height':u
     1394         on error undo move_block, retry move_block
     1395         :
     1396           assign
     1397             buf_temp-browse-handle.browse-handle :height
     1398               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1399             no-error .
     1400           if error-status :error
     1401           or error-status :get-message(1) <> ""
     1402           then do:
     1403             undo move_block, retry move_block .
     1404           end.
     1405         end.
     1406         for each buf_temp-diasize-handle
     1407         on error undo move_block, retry move_block
     1408         :
     1409           assign
     1410             v-object-handle = buf_temp-diasize-handle.handle-value
     1411           .
     1412           if v-object-handle <> v-diasize-resize-button
     1413           then do:
     1414             assign
     1415               v-object-handle :row = v-object-handle :row + p-change-value
     1416               no-error .
     1417             if error-status :error
     1418             or error-status :get-message(1) <> ""
     1419             then do:
     1420               undo move_block, retry move_block .
     1421             end.
     1422           end.
     1423         end.
     1424       end.
     1425       else do:
     1426         for each buf_temp-diasize-handle
     1427         on error undo move_block, retry move_block
     1428         :
     1429           assign
     1430             v-object-handle = buf_temp-diasize-handle.handle-value
     1431           .
     1432           if v-object-handle <> v-diasize-resize-button
     1433           then do:
     1434             assign
     1435               v-object-handle :row = v-object-handle :row + p-change-value
     1436               no-error .
     1437             if error-status :error
     1438             or error-status :get-message(1) <> ""
     1439             then do:
     1440               undo move_block, retry move_block .
     1441             end.
     1442           end.
     1443         end.
     1444         assign
     1445           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1446           no-error .
     1447         if error-status :error
     1448         or error-status :get-message(1) <> ""
     1449         then do:
     1450           undo move_block, retry move_block .
     1451         end.
     1452         for each buf_temp-browse-handle
     1453           where buf_temp-browse-handle.browse-type = 'height':u
     1454         on error undo move_block, retry move_block
     1455         :
     1456           assign
     1457             buf_temp-browse-handle.browse-handle :height
     1458               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1459             no-error .
     1460           if error-status :error
     1461           or error-status :get-message(1) <> ""
     1462           then do:
     1463             undo move_block, retry move_block .
     1464           end.
     1465         end.
     1466         assign
     1467           frame d-sum-grp :height = frame d-sum-grp :height + p-change-value
     1468           no-error .
     1469         if error-status :error
     1470         or error-status :get-message(1) <> ""
     1471         then do:
     1472           undo move_block, retry move_block .
     1473         end.
     1474         if frame d-sum-grp :scrollable = true
     1475         then do:
     1476           assign
     1477             frame d-sum-grp :virtual-height = frame d-sum-grp :virtual-height + p-change-value
     1478             no-error .
     1479           if error-status :error
     1480           or error-status :get-message(1) <> ""
     1481           then do:
     1482             undo move_block, retry move_block .
     1483           end.
     1484         end.
     1485       end.
     1486       if p-move-resize = true
     1487       then do:
     1488         run diasize_position-resize-button in this-procedure .
     1489       end.
     1490       if v-diasize-wndstore = true
     1491       then do:
     1492         if connected("ub") = true
     1493         then do:
     1494           define variable v-cntxt-db-num        as integer   no-undo .
     1495           define variable v-cntxt-userid        as character no-undo .
     1496           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1497                                             , OUTPUT v-cntxt-userid
     1498                                             ) .
     1499           run gbl/wndsizew.p
     1500             (input  v-cntxt-db-num
     1501             ,input  v-cntxt-userid
     1502             ,input  v-diasize-proc-name
     1503             ,input  'height':u
     1504             ,input  string(frame d-sum-grp :height - v-diasize-orig-frame-height)
     1505             ) .
     1506         end.
     1507       end.
     1508     end.
     1509     assign
     1510       v-diasize-change-size = false
     1511     .
     1512   end procedure.
     1513   procedure diasize_set-height :
     1514     define input  parameter p-new-height  as decimal   no-undo .
     1515     define input  parameter p-move-resize as logical   no-undo .
     1516     do
     1517     on error undo, return error return-value
     1518     :
     1519       run diasize_change-height in this-procedure
     1520         (input  (p-new-height - frame d-sum-grp :height)
     1521         ,input  p-move-resize
     1522         ) .
     1523     end.
     1524   end procedure.
     1525   procedure diasize_change-width :
     1526     define input  parameter p-change-value as decimal   no-undo .
     1527     define input  parameter p-move-resize  as logical   no-undo .
     1528     define variable v-field-group-handle   as handle    no-undo .
     1529     define variable v-object-handle        as handle    no-undo .
     1530     define variable v-frame-width          as decimal   no-undo .
     1531     define variable v-frame-virtual-width  as decimal   no-undo .
     1532     define variable v-browse-width         as decimal   no-undo .
     1533     define variable v-window-width         as decimal   no-undo .
     1534     define variable v-window-virtual-width as decimal   no-undo .
     1535     define variable v-change-sign          as integer   no-undo .
     1536     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1537     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1538     if p-change-value > 0
     1539     then do:
     1540       if frame d-sum-grp :width + p-change-value >
     1541           session :width-chars
     1542       then do:
     1543         assign
     1544           p-change-value = session :width-chars - frame d-sum-grp :width
     1545         .
     1546         if p-change-value <= 0
     1547         then do:
     1548           run diasize_position-resize-button in this-procedure .
     1549           return .
     1550         end.
     1551       end.
     1552     end.
     1553     if p-change-value < 0
     1554     then do:
     1555       if frame d-sum-grp :width + p-change-value < v-diasize-orig-frame-width
     1556       then do:
     1557         assign
     1558           p-change-value = v-diasize-orig-frame-width
     1559                          - frame d-sum-grp :width
     1560         .
     1561         if p-change-value >= 0
     1562         then do:
     1563           run diasize_position-resize-button in this-procedure .
     1564           return .
     1565         end.
     1566       end.
     1567     end.
     1568     if p-change-value >= 0
     1569     then do:
     1570       assign
     1571         v-change-sign = 1
     1572       .
     1573     end.
     1574     else do:
     1575       assign
     1576         v-change-sign = -1
     1577       .
     1578     end.
     1579     assign
     1580       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1581     .
     1582     if p-change-value = 0
     1583     then do:
     1584       run diasize_position-resize-button in this-procedure .
     1585       return .
     1586     end.
     1587     move_block:
     1588     do
     1589     on error undo move_block, leave move_block
     1590     :
     1591       if retry
     1592       then do:
     1593         do
     1594         on error undo move_block, leave move_block
     1595         :
     1596           if p-change-value > 0
     1597           then do:
     1598             for each buf_temp-diasize-handle
     1599             on error undo, next
     1600             :
     1601               assign
     1602                 v-object-handle = buf_temp-diasize-handle.handle-value
     1603               .
     1604               if v-object-handle <> v-diasize-resize-button
     1605               then do:
     1606                 assign
     1607                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1608                 .
     1609               end.
     1610             end.
     1611             assign
     1612               v-diasize-browse-handle :width = v-browse-width
     1613             .
     1614             for each buf_temp-browse-handle
     1615               where buf_temp-browse-handle.browse-type = 'width':u
     1616             on error undo, next
     1617             :
     1618               assign
     1619                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1620               .
     1621             end.
     1622             assign
     1623               frame d-sum-grp :width = v-frame-width
     1624             .
     1625             if frame d-sum-grp :scrollable = true
     1626             then do:
     1627               assign
     1628                 frame d-sum-grp :virtual-width = v-frame-virtual-width
     1629               .
     1630             end.
     1631             run diasize_position-resize-button in this-procedure .
     1632           end.
     1633           else do:
     1634             if frame d-sum-grp :scrollable = true
     1635             then do:
     1636               assign
     1637                 frame d-sum-grp :virtual-width = v-frame-virtual-width
     1638               .
     1639             end.
     1640             assign
     1641               frame d-sum-grp :width = v-frame-width
     1642             .
     1643             for each buf_temp-browse-handle
     1644               where buf_temp-browse-handle.browse-type = 'width':u
     1645             on error undo, next
     1646             :
     1647               assign
     1648                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1649               .
     1650             end.
     1651             assign
     1652               v-diasize-browse-handle :width = v-browse-width
     1653             .
     1654             for each buf_temp-diasize-handle
     1655             on error undo, next
     1656             :
     1657               assign
     1658                 v-object-handle = buf_temp-diasize-handle.handle-value
     1659               .
     1660               if v-object-handle <> v-diasize-resize-button
     1661               then do:
     1662                 assign
     1663                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1664                 .
     1665               end.
     1666             end.
     1667             run diasize_position-resize-button in this-procedure .
     1668           end.
     1669           assign
     1670             v-diasize-change-size = false
     1671           .
     1672           leave move_block .
     1673         end.
     1674       end.
     1675       assign
     1676         v-diasize-need-full-display = true
     1677       .
     1678       if v-diasize-change-size = false
     1679       then do:
     1680         assign
     1681           v-diasize-change-size = true
     1682         .
     1683       end.
     1684       else do:
     1685         return .
     1686       end.
     1687       assign
     1688         v-frame-width = frame d-sum-grp :width
     1689         v-frame-virtual-width = frame d-sum-grp :virtual-width
     1690         v-browse-width = v-diasize-browse-handle :width
     1691       .
     1692       for each buf_temp-browse-handle
     1693         where buf_temp-browse-handle.browse-type = 'width':u
     1694       :
     1695         assign
     1696           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1697         .
     1698       end.
     1699       for each buf_temp-diasize-handle
     1700       :
     1701         delete buf_temp-diasize-handle .
     1702       end.
     1703       assign
     1704         v-field-group-handle = frame d-sum-grp :first-child
     1705       .
     1706       do while valid-handle(v-field-group-handle)
     1707       :
     1708         assign
     1709           v-object-handle = v-field-group-handle :first-child
     1710         .
     1711         do while valid-handle(v-object-handle)
     1712         :
     1713           if  v-object-handle <> v-diasize-browse-handle :handle
     1714           and v-object-handle <> v-diasize-resize-button
     1715           and can-query(v-object-handle, "row")
     1716           and can-query(v-object-handle, "height")
     1717           and ( v-object-handle :col + v-object-handle :width
     1718                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1719               )
     1720           then do:
     1721             find first buf_temp-browse-handle
     1722               where buf_temp-browse-handle.browse-type   = 'width':u
     1723                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1724               no-error .
     1725             if available buf_temp-browse-handle
     1726             then do:
     1727             end.
     1728             else do:
     1729               create buf_temp-diasize-handle .
     1730               assign
     1731                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1732                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1733               .
     1734             end.
     1735           end.
     1736           assign
     1737             v-object-handle = v-object-handle :next-sibling
     1738           .
     1739         end.
     1740         assign
     1741           v-field-group-handle = v-field-group-handle :next-sibling
     1742         .
     1743       end.
     1744       do with frame d-sum-grp
     1745       :
     1746         hide v-diasize-resize-button .
     1747         v-diasize-resize-button :row = 1.
     1748         v-diasize-resize-button :column = 1.
     1749       end.
     1750       if p-change-value > 0
     1751       then do:
     1752         if frame d-sum-grp :scrollable = true
     1753         then do:
     1754           assign
     1755             frame d-sum-grp :virtual-width = frame d-sum-grp :virtual-width + p-change-value
     1756             no-error .
     1757           if error-status :error
     1758           or error-status :get-message(1) <> ""
     1759           then do:
     1760             undo move_block, retry move_block.
     1761           end.
     1762         end.
     1763         assign
     1764           frame d-sum-grp :width = v-frame-width + p-change-value
     1765           no-error .
     1766         if error-status :error
     1767         or error-status :get-message(1) <> ""
     1768         then do:
     1769           undo move_block, retry move_block.
     1770         end.
     1771         assign
     1772           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1773         no-error .
     1774         if error-status :error
     1775         or error-status :get-message(1) <> ""
     1776         then do:
     1777           undo move_block, retry move_block.
     1778         end.
     1779         for each buf_temp-browse-handle
     1780           where buf_temp-browse-handle.browse-type = 'width':u
     1781         on error undo move_block, retry move_block
     1782         :
     1783           assign
     1784             buf_temp-browse-handle.browse-handle :width
     1785               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1786             no-error .
     1787           if error-status :error
     1788           or error-status :get-message(1) <> ""
     1789           then do:
     1790             undo move_block, retry move_block .
     1791           end.
     1792         end.
     1793         for each buf_temp-diasize-handle
     1794         on error undo move_block, retry move_block
     1795         :
     1796           assign
     1797             v-object-handle = buf_temp-diasize-handle.handle-value
     1798           .
     1799           if v-object-handle <> v-diasize-resize-button
     1800           then do:
     1801             assign
     1802               v-object-handle :col = v-object-handle :col + p-change-value
     1803               no-error .
     1804             if error-status :error
     1805             or error-status :get-message(1) <> ""
     1806             then do:
     1807               undo move_block, retry move_block .
     1808             end.
     1809           end.
     1810         end.
     1811       end.
     1812       else do:
     1813         for each buf_temp-diasize-handle
     1814         on error undo move_block, retry move_block
     1815         :
     1816           assign
     1817             v-object-handle = buf_temp-diasize-handle.handle-value
     1818           .
     1819           if v-object-handle <> v-diasize-resize-button
     1820           then do:
     1821             assign
     1822               v-object-handle :col = v-object-handle :col + p-change-value
     1823               no-error .
     1824             if error-status :error
     1825             or error-status :get-message(1) <> ""
     1826             then do:
     1827               undo move_block, retry move_block .
     1828             end.
     1829           end.
     1830         end.
     1831         for each buf_temp-browse-handle
     1832           where buf_temp-browse-handle.browse-type = 'width':u
     1833         on error undo move_block, retry move_block
     1834         :
     1835           assign
     1836             buf_temp-browse-handle.browse-handle :width
     1837               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1838             no-error .
     1839           if error-status :error
     1840           or error-status :get-message(1) <> ""
     1841           then do:
     1842             undo move_block, retry move_block .
     1843           end.
     1844         end.
     1845         assign
     1846           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1847           no-error .
     1848         if error-status :error
     1849         or error-status :get-message(1) <> ""
     1850         then do:
     1851           undo move_block, retry move_block.
     1852         end.
     1853         assign
     1854           frame d-sum-grp :width = frame d-sum-grp :width + p-change-value
     1855         no-error .
     1856         if error-status :error
     1857         or error-status :get-message(1) <> ""
     1858         then do:
     1859           undo move_block, retry move_block.
     1860         end.
     1861         if frame d-sum-grp :scrollable = true
     1862         then do:
     1863           assign
     1864             frame d-sum-grp :virtual-width = frame d-sum-grp :virtual-width + p-change-value
     1865           no-error .
     1866           if error-status :error
     1867           or error-status :get-message(1) <> ""
     1868           then do:
     1869             undo move_block, retry move_block.
     1870           end.
     1871         end.
     1872       end.
     1873       if p-move-resize
     1874       then do:
     1875         run diasize_position-resize-button in this-procedure .
     1876       end.
     1877       if v-diasize-wndstore = true
     1878       then do:
     1879         if connected("ub") = true
     1880         then do:
     1881           define variable v-cntxt-db-num        as integer   no-undo .
     1882           define variable v-cntxt-userid        as character no-undo .
     1883           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1884                                             , OUTPUT v-cntxt-userid
     1885                                             ) .
     1886           run gbl/wndsizew.p
     1887             (input  v-cntxt-db-num
     1888             ,input  v-cntxt-userid
     1889             ,input  v-diasize-proc-name
     1890             ,input  'width':u
     1891             ,input  string(frame d-sum-grp :width - v-diasize-orig-frame-width)
     1892             ) .
     1893         end.
     1894       end.
     1895     end.
     1896     assign
     1897       v-diasize-change-size = false
     1898     .
     1899   end procedure.
     1900   procedure diasize_set-width :
     1901     define input  parameter p-new-width  as decimal   no-undo .
     1902     define input  parameter p-move-resize as logical   no-undo .
     1903     do
     1904     on error undo, return error return-value
     1905     :
     1906       run diasize_change-width in this-procedure
     1907         (input  (p-new-width - frame d-sum-grp :width)
     1908         ,input  p-move-resize
     1909         ) .
     1910     end.
     1911   end procedure.
     1912   procedure diasize_position-resize-button :
     1913     do with frame d-sum-grp
     1914     :
     1915       hide v-diasize-resize-button .
     1916       assign
     1917         v-diasize-resize-button :row = frame d-sum-grp :height - v-diasize-resize-button :height
     1918                     - 1
     1919                     - (frame d-sum-grp :border-bottom-pixels / session :pixels-per-row)
     1920         v-diasize-resize-button :col = frame d-sum-grp :width - v-diasize-resize-button :width
     1921                     - 1
     1922                     - (frame d-sum-grp :border-right-pixels / session :pixels-per-column)
     1923       .
     1924       view v-diasize-resize-button .
     1925     end.
     1926   end procedure.
     1927   on alt-right anywhere
     1928   do:
     1929     run diasize_change-width in this-procedure
     1930       (input 1
     1931       ,input true
     1932       ) .
     1933     return no-apply .
     1934   end.
     1935   on alt-left anywhere
     1936   do:
     1937     run diasize_change-width in this-procedure
     1938       (input -1
     1939       ,input true
     1940       ) .
     1941     return no-apply .
     1942   end.
     1943   on alt-down anywhere
     1944   do:
     1945     run diasize_change-height in this-procedure
     1946       (input 1
     1947       ,input true
     1948       ) .
     1949     return no-apply .
     1950   end.
     1951   on alt-up anywhere
     1952   do:
     1953     run diasize_change-height in this-procedure
     1954       (input -1
     1955       ,input true
     1956       ) .
     1957     return no-apply .
     1958   end.
     1959   on alt-enter of frame d-sum-grp
     1960   do:
     1961     run diasize_maximize in this-procedure
     1962       (input  ?
     1963       ).
     1964     return no-apply .
     1965   end.
     1966   procedure diasize_end-move :
     1967     do
     1968     on error undo, return error return-value
     1969     :
     1970       define variable v-row-delta as decimal   no-undo .
     1971       define variable v-col-delta as decimal   no-undo .
     1972       define variable v-new-row as decimal   no-undo .
     1973       define variable v-new-col as decimal   no-undo .
     1974       assign
     1975         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1976         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1977       .
     1978       assign
     1979         v-row-delta = v-new-row - frame d-sum-grp :height
     1980         v-col-delta = v-new-col - frame d-sum-grp :width
     1981       .
     1982       run diasize_change-height in this-procedure
     1983         (input v-row-delta
     1984         ,input true
     1985         ) .
     1986       run diasize_change-width in this-procedure
     1987         (input v-col-delta
     1988         ,input true
     1989         ) .
     1990     end.
     1991   end procedure.
     1992   procedure diasize_maximize :
     1993     define input  parameter p-action as logical   no-undo .
     1994     do
     1995     on error undo, return error return-value
     1996     :
     1997       if p-action = ?
     1998       then do:
     1999         if v-diasize-need-maximize = true
     2000         then do:
     2001           assign
     2002             p-action = true
     2003           .
     2004         end.
     2005         else do:
     2006           assign
     2007             p-action = false
     2008           .
     2009         end.
     2010       end.
     2011       if p-action = true
     2012       then do:
     2013         run diasize_change-height in this-procedure
     2014           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2015               - frame d-sum-grp :height-chars
     2016           ,input true
     2017           ) .
     2018         run diasize_change-width in this-procedure
     2019           (input session :width-chars
     2020               - frame d-sum-grp :width-chars
     2021           ,input true
     2022           ) .
     2023         assign
     2024           v-diasize-need-maximize = false
     2025         .
     2026       end.
     2027       else do:
     2028         run diasize_change-width in this-procedure
     2029           (input v-diasize-orig-frame-width
     2030               - frame d-sum-grp :width-chars
     2031           ,input true
     2032           ) .
     2033         run diasize_change-height in this-procedure
     2034           (input v-diasize-orig-frame-height
     2035               - frame d-sum-grp :height-chars
     2036           ,input true
     2037           ) .
     2038         assign
     2039           v-diasize-need-maximize = true
     2040         .
     2041       end.
     2042     end.
     2043   end procedure.
     2044   procedure diasize_restore-orig-size :
     2045     do
     2046     on error undo, return error return-value
     2047     :
     2048       assign
     2049         v-diasize-current-frame-width  = frame d-sum-grp :width
     2050         v-diasize-current-frame-height = frame d-sum-grp :height
     2051       .
     2052       run diasize_set-height in this-procedure
     2053         (input  v-diasize-orig-frame-height
     2054         ,input  true
     2055         ) .
     2056       run diasize_set-width in this-procedure
     2057         (input  v-diasize-orig-frame-width
     2058         ,input  true
     2059         ) .
     2060     end.
     2061   end procedure.
     2062   procedure diasize_restore-current-size :
     2063     do
     2064     on error undo, return error return-value
     2065     :
     2066       run diasize_set-height in this-procedure
     2067         (input  v-diasize-current-frame-height
     2068         ,input  true
     2069         ) .
     2070       run diasize_set-width in this-procedure
     2071         (input  v-diasize-current-frame-width
     2072         ,input  true
     2073         ) .
     2074     end.
     2075   end procedure.
     2076   procedure diasize_set-browse-handle :
     2077     define input  parameter p-browse-handle as handle   no-undo .
     2078     define buffer buf_temp-browse-handle for temp-browse-handle .
     2079     do
     2080     on error undo, return error return-value
     2081     :
     2082       assign
     2083         v-diasize-browse-handle = p-browse-handle
     2084       .
     2085       for each buf_temp-browse-handle
     2086       on error undo, return error return-value
     2087       :
     2088         delete buf_temp-browse-handle .
     2089       end.
     2090     end.
     2091   end procedure.
     2092   procedure diasize_add_browse :
     2093     define input  parameter p-browse-type   as character no-undo .
     2094     define input  parameter p-browse-handle as handle    no-undo .
     2095     define buffer buf_temp-browse-handle for temp-browse-handle .
     2096     do
     2097     on error undo, return error return-value
     2098     :
     2099       assign
     2100         v-diasize-browse-number = v-diasize-browse-number + 1
     2101       .
     2102       create buf_temp-browse-handle .
     2103       assign
     2104         buf_temp-browse-handle.browse-type   = p-browse-type
     2105         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2106         buf_temp-browse-handle.browse-handle = p-browse-handle
     2107       .
     2108     end.
     2109   end procedure.
     2110   procedure diasize_init :
     2111     define variable v-default-value    as logical   no-undo .
     2112     define variable v-restore-saved    as logical   no-undo .
     2113     define variable v-resize-value-str as character no-undo .
     2114     do
     2115     on error undo, return error return-value
     2116     :
     2117       do with frame d-sum-grp
     2118       :
     2119         assign
     2120           v-diasize-orig-frame-height = frame d-sum-grp :height
     2121           v-diasize-orig-frame-width  = frame d-sum-grp :width
     2122           v-diasize-browse-handle     = browse br-sumgrps :handle
     2123         .
     2124         create button v-diasize-resize-button
     2125         assign
     2126           parent        = frame d-sum-grp :first-child
     2127           label         = "s"
     2128           height-pixels = 16
     2129           width-pixels  = 16
     2130           visible       = true
     2131           sensitive     = true
     2132           movable       = true
     2133           triggers:
     2134             on end-move persistent run diasize_end-move in this-procedure .
     2135           end triggers.
     2136         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2137         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2138         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2139         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2140         assign
     2141           v-diasize-wndmax = false
     2142         .
     2143         if connected("ub") = true
     2144         then do:
     2145           define variable v-cntxt-db-num        as integer   no-undo .
     2146           define variable v-cntxt-userid        as character no-undo .
     2147           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2148                                             , OUTPUT v-cntxt-userid
     2149                                             ) .
     2150           run gbl/wndpar_r.p
     2151             (input  v-cntxt-db-num
     2152             ,input  v-cntxt-userid
     2153             ,input  'wndmax':U
     2154             ,output v-diasize-wndmax
     2155             ,output v-default-value
     2156             ) .
     2157         end.
     2158         assign
     2159           v-diasize-wndstore = false
     2160         .
     2161         if connected("ub") = true
     2162         then do:
     2163           run gbl/wndpar_r.p
     2164             (input  v-cntxt-db-num
     2165             ,input  v-cntxt-userid
     2166             ,input  'wndstore':U
     2167             ,output v-diasize-wndstore
     2168             ,output v-default-value
     2169             ) .
     2170         end.
     2171         assign
     2172           v-diasize-proc-name = entry(1, program-name(2), '.')
     2173         .
     2174         if v-diasize-wndstore = true
     2175         then do:
     2176           assign
     2177             v-restore-saved = false
     2178           .
     2179           if connected("ub") = true
     2180           then do:
     2181             run gbl/wndsizer.p
     2182               (input  v-cntxt-db-num
     2183               ,input  v-cntxt-userid
     2184               ,input  v-diasize-proc-name
     2185               ,input  'height':u
     2186               ,output v-resize-value-str
     2187               ) .
     2188             if v-resize-value-str <> '':U
     2189             then do:
     2190               run diasize_change-height in this-procedure
     2191                 (input  integer(v-resize-value-str)
     2192                 ,input  true
     2193                 ) .
     2194               assign
     2195                 v-restore-saved = true
     2196               .
     2197             end.
     2198           end.
     2199           if connected("ub") = true
     2200           then do:
     2201             run gbl/wndsizer.p
     2202               (input  v-cntxt-db-num
     2203               ,input  v-cntxt-userid
     2204               ,input  v-diasize-proc-name
     2205               ,input  'width':u
     2206               ,output v-resize-value-str
     2207               ) .
     2208             if v-resize-value-str <> '':U
     2209             then do:
     2210               run diasize_change-width in this-procedure
     2211                 (input  integer(v-resize-value-str)
     2212                 ,input  true
     2213                 ) .
     2214               assign
     2215                 v-restore-saved = true
     2216               .
     2217             end.
     2218           end.
     2219           if v-restore-saved <> true
     2220           then do:
     2221             if v-diasize-wndmax = true
     2222             then do:
     2223               run diasize_maximize in this-procedure
     2224                 (input  true
     2225                 ) .
     2226             end.
     2227           end.
     2228         end.
     2229         else do:
     2230           if v-diasize-wndmax = true
     2231           then do:
     2232             run diasize_maximize in this-procedure
     2233               (input  true
     2234               ) .
     2235           end.
     2236         end.
     2237       end.
     2238     end.
     2239   end procedure.
     2240   procedure diasize_need-full-display :
     2241     define output parameter p-need-full-display as logical   no-undo .
     2242     do
     2243     on error undo, return error return-value
     2244     :
     2245       assign
     2246         p-need-full-display = v-diasize-need-full-display
     2247       .
     2248       assign
     2249         v-diasize-need-full-display = false
     2250       .
     2251     end.
     2252   end procedure.
     2253   procedure get-context :
     2254      define output parameter p-db-num as integer          no-undo.
     2255      define output parameter p-user-id as character        no-undo.
     2256      define variable v-login               as character    no-undo.
     2257      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2258      define buffer buf_user-login  for ub.user-login .
     2259      do
     2260      on error undo, return error
     2261      :
     2262            FIND FIRST buf_sys-ctrl no-lock.
     2263            ASSIGN
     2264               v-login = USERID("ub")
     2265               p-db-num = buf_sys-ctrl.db-num
     2266            .
     2267            FIND FIRST buf_user-login
     2268                 WHERE buf_user-login.db-num = p-db-num
     2269                   AND buf_user-login.user-login = v-login
     2270                 no-lock
     2271                 no-error
     2272                 .
     2273            IF AVAILABLE buf_user-login
     2274            THEN DO:
     2275               assign
     2276                  p-user-id = buf_user-login.user-id
     2277               .
     2278            END.
     2279      end.
     2280   end procedure.
     2281       run diasize_init in this-procedure .
     2282   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2283   on INS of frame d-sum-grp anywhere do:
     2284     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame d-sum-grp. END.
     2285     return no-apply.
     2286   end.
     2287   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2288   on CTRL-N, CTRL-Т of frame d-sum-grp anywhere do:
     2289     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame d-sum-grp. END.
     2290     return no-apply.
     2291   end.
     2292   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2293   on F4 of frame d-sum-grp anywhere do:
     2294     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame d-sum-grp. END.
     2295     return no-apply.
     2296   end.
     2297   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2298   on F8 of frame d-sum-grp anywhere do:
     2299     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame d-sum-grp. END.
     2300     return no-apply.
     2301   end.
     2302   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2303   on F2 of frame d-sum-grp anywhere do:
     2304     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame d-sum-grp. END.
     2305     return no-apply.
     2306   end.
     2307   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2308   on F2 of frame d-sum-grp anywhere do:
     2309     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame d-sum-grp. END.
     2310     return no-apply.
     2311   end.
     2312   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2313   on CTRL-P, CTRL-З of frame d-sum-grp anywhere do:
     2314     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame d-sum-grp. END.
     2315     return no-apply.
     2316   end.
     2317   ON WINDOW-CLOSE OF FRAME d-sum-grp APPLY "END-ERROR":U TO SELF.
     2318   MAIN-BLOCK:
     2319   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2320      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2321      v-rid-list = p-rid-list.
     2322      RUN enable_UI.
     2323      HIDE mark-num in frame d-sum-grp.
     2324      if v-rid-list <> "":U then do:
     2325       assign
     2326       rr = integer(v-rid-list) no-error .
     2327       .
     2328       if not error-status:error then do:
     2329         reposition br-sumgrps to recid rr no-error .
     2330       end.
     2331       APPLY "ENTRY" to br-sumgrps.
     2332      end.
     2333      WAIT-FOR GO OF FRAME d-sum-grp.
     2334   END.
     2335   RUN disable_UI.
     2336   PROCEDURE disable_UI :
     2337     HIDE FRAME d-sum-grp.
     2338   END PROCEDURE.
     2339   PROCEDURE enable_UI :
     2340   assign
     2341   b-disc:menu-mouse in frame d-sum-grp = 1
     2342   menu-item m_update-disc:sensitive in menu menu-b-disc = lookup("b-add", bttns) > 0
     2343   .
     2344   ENABLE br-sumgrps b-quit
     2345   b-add WHEN lookup("b-add", bttns) > 0 and not transaction
     2346   b-del WHEN lookup("b-add", bttns) > 0 and not transaction
     2347   b-sel WHEN lookup("b-sel", bttns) > 0
     2348   b-chg WHEN lookup("b-add", bttns) > 0 and not transaction
     2349   b-disc WHEN lookup("b-add", bttns) > 0
     2350   b-mark when lookup("b-mark", bttns) > 0
     2351   b-hist
     2352   b-print
     2353   b-help
     2354   WITH FRAME d-sum-grp.
     2355   OPEN QUERY br-sumgrps FOR EACH X_sum-grp NO-LOCK     BY X_sum-grp.grp-code INDEXED-REPOSITION.
     2356   APPLY "ENTRY" to br-sumgrps.
     2357   END PROCEDURE.
     2358   PROCEDURE grp-sending :
     2359   END PROCEDURE.
     2360   PROCEDURE proc-send :
     2361   END PROCEDURE.
