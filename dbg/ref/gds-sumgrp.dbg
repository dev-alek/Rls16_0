      167   define  stream PrnLibStream.
      168   procedure prn-lib-prn-file :
      169     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      170     define input parameter p-DIsabledoptions as integer no-undo .
      171     define variable v-report-name as character no-undo .
      172     define variable v-user-action as character no-undo .
      173     define variable v-printed     as logical   no-undo .
      174     define variable v-exist       as logical   no-undo .
      175     do
      176       on error undo, return error
      177       :
      178       run prn-lib-get-report-name  in this-procedure (
      179         input parParentProc
