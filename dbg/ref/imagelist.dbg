      851   RUN imagelist_loaddef IN THIS-PROCEDURE NO-ERROR.
      852   PROCEDURE imagelist_loaddef:
      853       DEFINE VARIABLE vPar-val       AS CHARACTER   NO-UNDO.
      854       DEFINE VARIABLE vPar-type      AS CHARACTER   NO-UNDO.
      855       ASSIGN
      856           vPar-val  = "":U
      857           vPar-type = "":U
      858           .
      859   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      860     (input  'photo':u
      861     ,input  '':u
      862     ,input  '':u
      863     ,input  0
      864     ,input  '':u
      865     ,input  '':u
      866     ,input  '':u
      867     ,input  no
      868     ,output vPar-val
      869     ,output vPar-type
      870     ) no-error .
      871           mImagePh = LOOKUP (vPar-val, "true,yes":U) > 0.
      872       IF mImagePh THEN .
      873       ELSE RETURN.
      874       ASSIGN
      875           vPar-val  = "":U
      876           vPar-type = "":U
      877           .
      878   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      879     (input  'ph-dir':u
      880     ,input  '':u
      881     ,input  '':u
      882     ,input  0
      883     ,input  '':u
      884     ,input  '':u
      885     ,input  '':u
      886     ,input  NO
      887     ,output vPar-val
      888     ,output vPar-type
      889     ) no-error .
      890       IF LENGTH (vPar-val) = 0 THEN
      891           RUN verify-ini-entry("ph-dir":U, "REP-SETS":U, "":U, YES, OUTPUT vPar-val) NO-ERROR.
      892       IF LENGTH (vPar-val) = 0 THEN vPar-val = "c:\temp\":U.
      893       ASSIGN
      894           mImagePath   = RIGHT-TRIM (vPar-val, "~\~/":U)
      895           mImagePath   = mImagePath + (IF LENGTH (mImagePath) > 0 THEN "\":U ELSE "":U)
      896           mImagePreDir = mImagePath
      897           mImageDir    = mImagePreDir
      898           mImageTrash  = mImagePath + "trash\":U
      899           .
      900       ASSIGN
      901           vPar-val  = "":U
      902           vPar-type = "":U
      903           .
      904               run adm/shattri.p (
      905           input "get":U
      906           ,input  '':U
      907           ,input  0
      908           ,input  'gds-ref':U
      909           ,input  'shema-foto':U
      910           ,output v-value-char
      911           ,output v-val-date
      912           ,output v-val-decimal
      913           ,output v-val-integer
      914           ,output v-val-logical
      915           ,output v-param-types
      916           ,INPUT-OUTPUT table-handle v-tthd
      917           ) no-error.
      918           delete object v-tthd.
      919           mPhotomgd = IF v-val-integer = 2 then yes else no.
      920   END PROCEDURE.
      921   PROCEDURE imagelist_decode:
      922       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
      923       DEFINE INPUT  PARAMETER iImageGdsCode AS int    NO-UNDO.
      924       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
      925       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
      926       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
      927       ASSIGN
      928           oImageList = iImageList
      929           .
      930       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
      931           vCh =ENTRY (vInt, iImageList, ",":U).
      932           IF SUBSTRING (vCh, 1, 2) = "~\~\":U THEN .
      933           ELSE
      934           DO:
      935               ASSIGN
      936                   vCh = REPLACE (vCh, "~/":U, "\":U)
      937                   vCh = REPLACE (vCh, "~\":U, "\":U)
      938                   .
      939               IF SUBSTRING (vCh, 2, 2) = ":\":U OR vCh BEGINS mImageDir THEN .
      940               ELSE vCh = mImagePreDir + (if mPhotomgd then string(iImageGdsCode) + "\":U else '':U ) +  vCh.
      941               ENTRY (vInt, oImageList, ",":U) = vCh.
      942           END.
      943       END.
      944   END PROCEDURE.
      945   PROCEDURE imagelist_encode:
      946       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
      947       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
      948       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
      949       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
      950       DEFINE VARIABLE vLen               AS INTEGER   NO-UNDO.
      951       ASSIGN
      952           oImageList = iImageList
      953           vLen       = LENGTH (mImageDir)
      954           .
      955       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
      956           vCh =ENTRY (vInt, iImageList, ",":U).
      957           IF LENGTH (vCh) > 0 AND vLen > 0 AND vCh BEGINS mImageDir THEN
      958               ENTRY (vInt, oImageList, ",":U) =
      959                   SUBSTRING (vCh, vLen + 1).
      960       END.
      961   END PROCEDURE.
      962   IF mImagePh THEN .
      963       ELSE RETURN.
      964   IF mPhotomgd THEN
      965       mImageDir = SUBSTITUTE ("&1&2\":U, mImagePreDir, iGds-code).
      966   RUN verify-file (mImagePath,
      967       "Не найден каталог " + mImagePath + chr(10) +
      968       "параметр конфигурации ph-dir",
      969       NO, OUTPUT mLogical) NO-ERROR.
      970   IF ERROR-STATUS:ERROR OR NOT mLogical THEN RETURN ERROR.
      971   FUNCTION ImgXPix RETURNS INTEGER
      972     (iNum AS INTEGER)  FORWARD.
      973   DEFINE BUTTON b-add
      974        LABEL "&Добавить":L
      975        SIZE 9 BY 1.
      976   DEFINE BUTTON b-del
      977        LABEL "&Удалить"
      978        SIZE 10 BY 1.
      979   DEFINE BUTTON b-exit AUTO-GO
      980        LABEL "&Выход ":L
      981        SIZE 12 BY 1.
      982   DEFINE VARIABLE F-FileName AS CHARACTER FORMAT "X(256)":U
      983        VIEW-AS FILL-IN NATIVE
      984        SIZE 63.5 BY 1 NO-UNDO.
      985   DEFINE IMAGE CurrentImage
      986        STRETCH-TO-FIT RETAIN-SHAPE
      987        SIZE 62.5 BY 15.5.
      988   DEFINE RECTANGLE f-Marker
      989        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      990        SIZE 4.25 BY .13.
      991   DEFINE VARIABLE t-preview AS LOGICAL INITIAL no
      992        LABEL "Preview"
      993        VIEW-AS TOGGLE-BOX
      994        SIZE 11.5 BY .58 NO-UNDO.
      995   DEFINE FRAME d-images
      996        b-exit AT ROW 1 COL 1
      997        b-add AT ROW 1 COL 13
      998        b-del AT ROW 1 COL 22.13
      999        t-preview AT ROW 20.25 COL 52.5 WIDGET-ID 20
     1000        F-FileName AT ROW 21 COL 1 NO-LABEL WIDGET-ID 12
     1001        CurrentImage AT ROW 5.25 COL 1.5 WIDGET-ID 2
     1002        f-Marker AT ROW 2.08 COL 1.13 WIDGET-ID 16
     1003        SPACE(59.86) SKIP(19.86)
     1004       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1005            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1006            TITLE "Изображения":L.
     1007   DEFINE FRAME FrameX
     1008       WITH 1 DOWN KEEP-TAB-ORDER OVERLAY
     1009            SIDE-LABELS NO-UNDERLINE THREE-D
     1010            AT COL 1 ROW 2.25
     1011            SIZE 5 BY .75 WIDGET-ID 100.
     1012   ASSIGN FRAME FrameX:FRAME = FRAME d-images:HANDLE.
     1013   ASSIGN
     1014          FRAME d-images:SCROLLABLE       = FALSE.
     1015   ASSIGN
     1016          F-FileName:READ-ONLY IN FRAME d-images        = TRUE.
     1017   ON CURSOR-LEFT OF FRAME d-images
     1018   ANYWHERE DO:
     1019       mImgSlider:SCREEN-VALUE = STRING (INTEGER (mImgSlider:SCREEN-VALUE) - 1) NO-ERROR.
     1020       APPLY "VALUE-CHANGED":U TO mImgSlider.
     1021       RETURN NO-APPLY.
     1022   END.
     1023   ON CURSOR-RIGHT OF FRAME d-images
     1024   ANYWHERE DO:
     1025       mImgSlider:SCREEN-VALUE = STRING (INTEGER (mImgSlider:SCREEN-VALUE) + 1) NO-ERROR.
     1026       APPLY "VALUE-CHANGED":U TO mImgSlider.
     1027       RETURN NO-APPLY.
     1028   END.
     1029   ON BACK-TAB OF FRAME FrameX
     1030   ANYWHERE DO:
     1031     APPLY "ENTRY":U    TO SELF.
     1032     APPLY "TAB":U      TO b-del IN FRAME d-images.
     1033     APPLY "BACK-TAB":U TO FOCUS.
     1034     RETURN NO-APPLY.
     1035   END.
     1036   ON TAB OF FRAME FrameX
     1037   ANYWHERE DO:
     1038     APPLY "ENTRY":U TO SELF.
     1039     APPLY "TAB":U   TO b-del IN FRAME d-images.
     1040     RETURN NO-APPLY.
     1041   END.
     1042   ON CHOOSE OF b-add IN FRAME d-images
     1043   DO:
     1044     IF NOT mF_update_photo THEN RETURN NO-APPLY.
     1045     DEFINE VARIABLE vFile AS CHARACTER   NO-UNDO.
     1046     DEFINE VARIABLE vLog  AS LOGICAL     NO-UNDO.
     1047     SYSTEM-DIALOG GET-FILE vFile
     1048         FILTERS         "Картинки" "*.jpg,*.png,*.bmp,*.gif":U,         "Картинки *.jpg" "*.jpg":U,         "Картинки *.png" "*.png":U,         "Картинки *.bmp" "*.bmp":U,         "Картинки *.gif" "*.gif":U,         "Все файлы" "*.*":U
     1049         MUST-EXIST
     1050         TITLE "Выбор файла"
     1051         UPDATE vLog
     1052         .
     1053     IF NOT vLog THEN RETURN NO-APPLY.
     1054     RUN ImageAdd IN THIS-PROCEDURE (vFile).
     1055   END.
     1056   ON CHOOSE OF b-del IN FRAME d-images
     1057   DO:
     1058     IF NOT mF_update_photo THEN RETURN NO-APPLY.
     1059     RUN ImageDel IN THIS-PROCEDURE.
     1060   END.
     1061   ON VALUE-CHANGED OF t-preview IN FRAME d-images
     1062   DO:
     1063     DEFINE BUFFER ttImgBar FOR ttImgBar.
     1064     IF SELF:CHECKED = NO THEN RETURN NO-APPLY.
     1065     IF SELF:SENSITIVE THEN
     1066     DO:
     1067         MESSAGE
     1068             "Установить выбранное изображение в качестве используемого для предварительного просмотра?" SKIP (1)
     1069             "(Изображение будет перемещено в начало списка)"
     1070             VIEW-AS ALERT-BOX QUESTION BUTTONS OK-CANCEL TITLE "Вопрос" UPDATE vLog AS LOGICAL.
     1071         IF vLog <> YES THEN
     1072         DO:
     1073             SELF:CHECKED = NO.
     1074             RETURN NO-APPLY.
     1075         END.
     1076     END.
     1077     FOR FIRST ttImgBar WHERE ttImgBar.fID = mImageCurID:
     1078         ttImgBar.fFrame:X = 0.
     1079         RUN DynaTrig IN THIS-PROCEDURE (ttImgBar.fFrame, "END-MOVE":U) NO-ERROR.
     1080     END.
     1081   END.
     1082   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-images:PARENT eq ?
     1083   THEN FRAME d-images:PARENT = ACTIVE-WINDOW.
     1084   ON WINDOW-CLOSE OF FRAME d-images APPLY "END-ERROR":U TO SELF.
     1085   MAIN-BLOCK:
     1086   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1087      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1088   if mF_select_photo <> no or mF_update_photo <> no then do:
     1089       RUN enable_ui.
     1090       WAIT-FOR GO OF FRAME d-images.
     1091   end.
     1092   END.
     1093   DELETE PROCEDURE mImgSliderTrgs NO-ERROR.
     1094   FOR EACH ttImgBar:
     1095       DELETE PROCEDURE ttImgBar.fTrgs NO-ERROR.
     1096       DELETE OBJECT ttImgBar.fImage   NO-ERROR.
     1097       DELETE OBJECT ttImgBar.fFrame   NO-ERROR.
     1098       DELETE ttImgBar.
     1099   END.
     1100   RUN disable_ui.
     1101   PROCEDURE disable_UI :
     1102     HIDE FRAME d-images.
     1103     HIDE FRAME FrameX.
     1104   END PROCEDURE.
     1105   PROCEDURE DynaTrig :
     1106       DEFINE INPUT PARAMETER iHandle  AS HANDLE    NO-UNDO.
     1107       DEFINE INPUT PARAMETER iTrigger AS CHARACTER NO-UNDO.
     1108       DEFINE VARIABLE vInt AS INTEGER NO-UNDO.
     1109       DEFINE BUFFER ttImgBar FOR ttImgBar.
     1110       CASE iHandle:NAME:
     1111           WHEN "ImgSlider":U THEN
     1112               CASE iTrigger:
     1113                   WHEN "VALUE-CHANGED":U THEN
     1114                       FOR FIRST ttImgBar NO-LOCK WHERE ttImgBar.fNum = INTEGER (iHandle:SCREEN-VALUE):
     1115                           RUN DynaTrig IN THIS-PROCEDURE (ttImgBar.fFrame, "SELECTION":U) NO-ERROR.
     1116                       END.
     1117               END CASE.
     1118           WHEN "Image":U THEN
     1119               CASE iTrigger:
     1120                   WHEN "END-MOVE":U THEN
     1121                   DO:
     1122                       FOR FIRST ttImgBar WHERE ttImgBar.fID = iHandle:PRIVATE-DATA:
     1123                           ttImgBar.fXPix = iHandle:X.
     1124                       END.
     1125                       ASSIGN
     1126                           vInt       = mImageMax
     1127                           mImageList = "":U
     1128                           .
     1129                       FOR EACH ttImgBar BY ttImgBar.fXPix DESCENDING:
     1130                           ASSIGN
     1131                               ttImgBar.fFrame:X = ImgXPix (vInt)
     1132                               ttImgBar.fNum     = vInt
     1133                               vInt              = vInt - 1
     1134                               .
     1135                       END.
     1136                       FOR EACH ttImgBar:
     1137                           ttImgBar.fXPix = ttImgBar.fFrame:X.
     1138                       END.
     1139                       ASSIGN
     1140                           mImageCurID  = "":U
     1141                           mImageCurNum = 0
     1142                           .
     1143                       RUN DynaTrig IN THIS-PROCEDURE (iHandle, "SELECTION":U) NO-ERROR.
     1144                       RUN ImageListDump IN THIS-PROCEDURE.
     1145                   END.
     1146                   WHEN "SELECTION":U THEN
     1147                       IF mImageCurID <> iHandle:PRIVATE-DATA THEN
     1148                           RUN SelectImage IN THIS-PROCEDURE (?, iHandle:PRIVATE-DATA) NO-ERROR.
     1149                   WHEN "MOUSE-SELECT-DBLCLICK":U THEN
     1150                   DO:
     1151                       IF mImageCurID <> iHandle:PRIVATE-DATA THEN
     1152                           RUN SelectImage IN THIS-PROCEDURE (?, iHandle:PRIVATE-DATA) NO-ERROR.
     1153                       IF f-FileName:SCREEN-VALUE IN FRAME d-images = "":U THEN
     1154                           APPLY "CHOOSE":U TO b-add.
     1155                       RETURN NO-APPLY.
     1156                   END.
     1157               END CASE.
     1158       END CASE.
     1159   END PROCEDURE.
     1160   PROCEDURE enable_UI :
     1161       ENABLE
     1162           b-exit
     1163           b-add     WHEN loc-mode <> 'ПРОСМОТР':U
     1164           b-del     WHEN loc-mode <> 'ПРОСМОТР':U
     1165           f-marker
     1166           t-preview WHEN loc-mode <> 'ПРОСМОТР':U
     1167           WITH FRAME  d-images.
     1168       DISPLAY f-marker WITH FRAME d-images.
     1169       RUN ImgBarInit IN THIS-PROCEDURE.
     1170       RUN ImageListLoad IN THIS-PROCEDURE.
     1171       RUN SensButtons   IN THIS-PROCEDURE.
     1172       IF mBoxForAdd = 8 OR (mBoxForAdd = 0 AND mImageMax = 0) THEN
     1173       RUN ImgBarAdd IN THIS-PROCEDURE ("":U).
     1174       RUN ImgSlider IN THIS-PROCEDURE.
     1175       RUN SelectImage IN THIS-PROCEDURE (1, ?) NO-ERROR.
     1176    END PROCEDURE.
     1177   PROCEDURE ImageAdd :
     1178   DEFINE INPUT PARAMETER iFile AS CHARACTER NO-UNDO.
     1179       DEFINE BUFFER ttImgBar FOR ttImgBar.
     1180       DEFINE VARIABLE vNum  AS INTEGER     NO-UNDO.
     1181       DEFINE VARIABLE vFile AS CHARACTER   NO-UNDO.
     1182       DEFINE VARIABLE vTmp  AS CHARACTER   NO-UNDO.
     1183       DEFINE VARIABLE vInt  AS INTEGER     NO-UNDO.
     1184       DEFINE VARIABLE vCh2  AS CHARACTER   NO-UNDO.
     1185       DEFINE VARIABLE vExt  AS CHARACTER   NO-UNDO.
     1186       RUN verify-file (mImagePreDir, "":U, YES, OUTPUT mLogical) NO-ERROR.
     1187       IF ERROR-STATUS:ERROR OR NOT mLogical THEN
     1188       DO:
     1189           OS-CREATE-DIR VALUE (mImagePreDir).
     1190           IF OS-ERROR <> 0 THEN
     1191           DO:
     1192               MESSAGE SUBSTITUTE ("Ошибка &1 создания поддиректории~n&2",
     1193                                   OS-ERROR, mImagePreDir)
     1194                   VIEW-AS ALERT-BOX ERROR.
     1195               RETURN NO-APPLY.
     1196           END.
     1197       END.
     1198       RUN verify-file (mImageDir, "":U, YES, OUTPUT mLogical) NO-ERROR.
     1199       IF ERROR-STATUS:ERROR OR NOT mLogical THEN
     1200       DO:
     1201           OS-CREATE-DIR VALUE (mImageDir).
     1202           IF OS-ERROR <> 0 THEN
     1203           DO:
     1204               MESSAGE SUBSTITUTE ("Ошибка &1 создания поддиректории~n&2",
     1205                                   OS-ERROR, mImageDir)
     1206                   VIEW-AS ALERT-BOX ERROR.
     1207               RETURN NO-APPLY.
     1208           END.
     1209       END.
     1210       IF iFile BEGINS mImageDir THEN vFile = iFile.
     1211       ELSE
     1212       DO:
     1213           ASSIGN
     1214               vTmp = SUBSTRING (iFile, 1 +
     1215                   MAXIMUM (R-INDEX (iFile, "~\":U), R-INDEX (iFile, "~/":U)))
     1216               vInt = R-INDEX (vTmp, ".":U)
     1217               vExt = SUBSTRING (vTmp, vInt)
     1218               vTmp = SUBSTRING (vTmp, 1, vInt - 1)
     1219               vFile = mImageDir + vTmp + vExt
     1220               .
     1221           IF SEARCH (vFile) <> ? THEN
     1222           bl0:
     1223           DO:
     1224               MESSAGE
     1225                   "Файл с таким именем уже существует" SKIP
     1226                   vFile SKIP (1)
     1227                   "Сгенерировать новое имя файла и продолжить?"
     1228                   VIEW-AS ALERT-BOX WARNING BUTTONS OK-CANCEL
     1229                   TITLE "Предупреждение" UPDATE mLogical.
     1230               IF mLogical = NO THEN RETURN NO-APPLY.
     1231               DO WHILE YES:
     1232                   bl1:
     1233                   DO:
     1234                       vInt = R-INDEX (vTmp, "#":U).
     1235                       IF vInt > 0 THEN
     1236                       DO:
     1237                           vCh2 = SUBSTRING (vTmp, vInt + 1).
     1238                           IF LENGTH (TRIM (vCh2, "0123456789":U)) = 0 THEN
     1239                           DO:
     1240                               ASSIGN
     1241                                   vTmp  = SUBSTRING (vTmp, 1, vInt) +
     1242                                       STRING (INTEGER (vCh2) + 1)
     1243                                   vFile = mImageDir + vTmp + vExt
     1244                                   .
     1245                               LEAVE bl1.
     1246                           END.
     1247                       END.
     1248                       ASSIGN
     1249                           vTmp  = vTmp + "#1":U
     1250                           vFile = mImageDir + vTmp + vExt
     1251                           .
     1252                   END.
     1253                   IF SEARCH (vFile) = ? THEN LEAVE bl0.
     1254               END.
     1255           END.
     1256           OS-COPY VALUE (iFile) VALUE (vFile).
     1257           IF OS-ERROR <> 0 THEN
     1258           DO:
     1259               MESSAGE SUBSTITUTE ("Ошибка &1 копирования файла~n&2~n&3",
     1260                                   OS-ERROR, iFile, vFile)
     1261                   VIEW-AS ALERT-BOX ERROR.
     1262               RETURN NO-APPLY.
     1263           END.
     1264       END.
     1265       FOR LAST ttImgBar WHERE ttImgBar.fFile = "":U:
     1266           ASSIGN
     1267               vNum           = ttImgBar.fNum
     1268               ttImgBar.fFile = vFile
     1269               .
     1270           ttImgBar.fImage:LOAD-IMAGE (vFile) NO-ERROR.
     1271       END.
     1272       IF vNum = 0 THEN
     1273       DO:
     1274           RUN ImgBarAdd IN THIS-PROCEDURE (vFile).
     1275           vNum = mImageMax.
     1276       END.
     1277       IF mBoxForAdd = 8 OR (mBoxForAdd = 0 AND mImageMax = 0) THEN
     1278           RUN ImgBarAdd IN THIS-PROCEDURE ("":U).
     1279       RUN ImgSlider IN THIS-PROCEDURE.
     1280       RUN SelectImage IN THIS-PROCEDURE (vNum, ?).
     1281       RUN ImageListDump IN THIS-PROCEDURE.
     1282       RUN SensButtons IN THIS-PROCEDURE.
     1283   END PROCEDURE.
     1284   PROCEDURE ImageDel :
     1285   DEFINE VARIABLE vNum   AS INTEGER     NO-UNDO.
     1286   DEFINE VARIABLE vFile1 AS CHARACTER   NO-UNDO.
     1287   DEFINE VARIABLE vFile2 AS CHARACTER   NO-UNDO.
     1288   DEFINE VARIABLE vExt   AS CHARACTER   NO-UNDO.
     1289   DEFINE VARIABLE vInt   AS INTEGER     NO-UNDO.
     1290       DEFINE BUFFER ttImgBar FOR ttImgBar.
     1291       MESSAGE
     1292           "Удалить изображение?" SKIP
     1293           VIEW-AS ALERT-BOX QUESTION BUTTONS OK-CANCEL
     1294           TITLE "Вопрос" UPDATE mLogical.
     1295       IF mLogical = NO THEN RETURN NO-APPLY.
     1296       RUN verify-file (mImageTrash, "":U, YES, OUTPUT mLogical) NO-ERROR.
     1297       IF ERROR-STATUS:ERROR OR NOT mLogical THEN
     1298       DO:
     1299           OS-CREATE-DIR VALUE (mImageTrash).
     1300           IF OS-ERROR <> 0 THEN
     1301           DO:
     1302               MESSAGE SUBSTITUTE ("Ошибка &1 создания поддиректории~n&2",
     1303                                   OS-ERROR, mImageTrash)
     1304                   VIEW-AS ALERT-BOX ERROR.
     1305               RETURN NO-APPLY.
     1306           END.
     1307       END.
     1308       ASSIGN
     1309           vFile1 = F-FileName:SCREEN-VALUE IN FRAME d-images
     1310           vFile2 = SUBSTRING (vFile1, 1 +
     1311                   MAXIMUM (R-INDEX (vFile1, "~\":U), R-INDEX (vFile1, "~/":U)))
     1312           vInt   = R-INDEX (vFile2, ".":U)
     1313           vExt   = SUBSTRING (vFile2, vInt)
     1314           vFile2 = SUBSTRING (vFile2, 1, vInt - 1)
     1315           vFile2 = mImageTrash + vFile2 + " ":U +
     1316                   REPLACE (STRING (NOW, "99999999 hh:mm:ss":U), ":":U, "":U) + vExt
     1317           .
     1318       OS-RENAME VALUE (vFile1) VALUE (vFile2).
     1319       IF OS-ERROR <> 0 AND LENGTH (SEARCH (vFile1)) > 0 THEN
     1320       DO:
     1321           MESSAGE SUBSTITUTE ("Ошибка &1 перемещения файла~n&2~n&3",
     1322                                   OS-ERROR, vFile1, vFile2)
     1323               VIEW-AS ALERT-BOX ERROR.
     1324           RETURN NO-APPLY.
     1325       END.
     1326       FOR FIRST ttImgBar WHERE ttImgBar.fID = mImageCurID:
     1327           DELETE PROCEDURE ttImgBar.fTrgs NO-ERROR.
     1328           DELETE OBJECT ttImgBar.fImage   NO-ERROR.
     1329           DELETE OBJECT ttImgBar.fFrame   NO-ERROR.
     1330           IF ttImgBar.fNum = mImageMax THEN vNum = mImageMax - 1.
     1331           ELSE vNum = ttImgBar.fNum + 1.
     1332           mImageMax = mImageMax - 1.
     1333           DELETE ttImgBar.
     1334       END.
     1335       IF mImageMax = 0 THEN
     1336       DO:
     1337           IF mBoxForAdd = 8 OR (mBoxForAdd = 0 AND mImageMax = 0) THEN
     1338           RUN ImgBarAdd IN THIS-PROCEDURE ("":U).
     1339           vNum = mImageMax.
     1340       END.
     1341       RUN ImgSlider IN THIS-PROCEDURE.
     1342       ASSIGN
     1343           mImageCurID  = "":U
     1344           mImageCurNum = 0
     1345           .
     1346       RUN SelectImage IN THIS-PROCEDURE (vNum, ?).
     1347       FOR FIRST ttImgBar NO-LOCK WHERE ttImgBar.fNum = vNum:
     1348           RUN DynaTrig IN THIS-PROCEDURE (ttImgBar.fFrame, "END-MOVE":U) NO-ERROR.
     1349       END.
     1350       IF mImageMax = 0 THEN
     1351       DO:
     1352           CurrentImage:LOAD-IMAGE ("":U) IN FRAME d-images NO-ERROR.
     1353           RUN ImageListDump IN THIS-PROCEDURE.
     1354       END.
     1355       RUN SensButtons IN THIS-PROCEDURE.
     1356   END PROCEDURE.
     1357   PROCEDURE ImageListDump :
     1358     IF NOT mF_update_photo THEN RETURN.
     1359       DEFINE BUFFER ttImgBar FOR ttImgBar.
     1360       mImageList = "":U.
     1361       FOR EACH ttImgBar NO-LOCK:
     1362           IF LENGTH (ttImgBar.fFile) > 0 THEN
     1363               mImageList =
     1364                   (IF LENGTH (mImageList) > 0 THEN
     1365                       mImageList + ",":U ELSE "":U)
     1366                   + ttImgBar.fFile
     1367               .
     1368       END.
     1369       RUN imagelist_encode IN THIS-PROCEDURE (INPUT mImageList, OUTPUT mImageList).
     1370       RUN gds-attr-write (iGds-code, "image-list":U, mImageList).
     1371   END PROCEDURE.
     1372   PROCEDURE ImageListLoad :
     1373       DEFINE VARIABLE vImageList AS CHARACTER   NO-UNDO.
     1374       DEFINE VARIABLE vCh        AS CHARACTER   NO-UNDO.
     1375       DEFINE VARIABLE vInt       AS INTEGER     NO-UNDO.
     1376       RUN gds-attr-value (iGds-code, "image-list":U, OUTPUT vImageList, OUTPUT vCh).
     1377       mImageList = "":U.
     1378       RUN imagelist_decode IN THIS-PROCEDURE (INPUT vImageList, iGds-code, OUTPUT vImageList).
     1379       DO vInt = 1 TO NUM-ENTRIES (vImageList, ",":U):
     1380           vCh =ENTRY (vInt, vImageList, ",":U).
     1381           RUN ImgBarAdd IN THIS-PROCEDURE (vCh).
     1382       END.
     1383   END PROCEDURE.
     1384   PROCEDURE ImgBarAdd PRIVATE :
     1385       DEFINE INPUT PARAMETER iFile AS CHARACTER NO-UNDO.
     1386       DEFINE BUFFER ttImgBar FOR ttImgBar.
     1387       CREATE ttImgBar.
     1388       ASSIGN
     1389           mImageSID      = mImageSID + 1
     1390           mImageMax      = mImageMax + 1
     1391           ttImgBar.fXPix = ImgXPix (mImageMax)
     1392           ttImgBar.fID   = STRING (mImageSID)
     1393           ttImgBar.fNum  = mImageMax
     1394           ttImgBar.fFile = iFile
     1395           .
     1396       RUN ref\dynatrig.p PERSISTENT SET ttImgBar.fTrgs.
     1397       CREATE FRAME ttImgBar.fFrame ASSIGN
     1398           NAME             = "Image":U
     1399           THREE-D          = YES
     1400           FRAME            = mImgBarFrame
     1401           PRIVATE-DATA     = ttImgBar.fID
     1402           WIDTH-PIXELS     = 34
     1403           HEIGHT-PIXELS    = mImgBarFrame:HEIGHT-PIXELS - 2
     1404           Y                = 0
     1405           X                = ttImgBar.fXPix
     1406           MOVABLE          = YES AND mEnab
     1407           SELECTABLE       = YES
     1408           MANUAL-HIGHLIGHT = YES
     1409           HIDDEN           = NO
     1410           SENSITIVE        = YES
     1411           VISIBLE          = YES
     1412       TRIGGERS:
     1413           ON "END-MOVE":U  ANYWHERE PERSISTENT RUN DynaTrig IN ttImgBar.fTrgs
     1414               ("END-MOVE":U ).
     1415           ON "SELECTION":U ANYWHERE PERSISTENT RUN DynaTrig IN ttImgBar.fTrgs
     1416               ("SELECTION":U).
     1417           ON "MOUSE-SELECT-DBLCLICK":U ANYWHERE PERSISTENT RUN DynaTrig IN ttImgBar.fTrgs
     1418               ("MOUSE-SELECT-DBLCLICK":U).
     1419       END TRIGGERS.
     1420       RUN SetHandle IN ttImgBar.fTrgs (ttImgBar.fFrame).
     1421       CREATE IMAGE ttImgBar.fImage ASSIGN
     1422           FRAME          = ttImgBar.fFrame
     1423           WIDTH-PIXELS   = 32
     1424           HEIGHT-PIXELS  = 32
     1425           STRETCH-TO-FIT = YES
     1426           RETAIN-SHAPE   = YES
     1427           VISIBLE        = YES
     1428           .
     1429       ttImgBar.fImage:LOAD-IMAGE (ttImgBar.fFile) NO-ERROR.
     1430       IF LENGTH (ttImgBar.fFile) > 0 THEN
     1431           mImageList =
     1432               (IF LENGTH (mImageList) > 0 THEN mImageList + ",":U ELSE "":U)
     1433               + ttImgBar.fFile.
     1434       RELEASE ttImgBar.
     1435   END PROCEDURE.
     1436   PROCEDURE ImgBarInit PRIVATE :
     1437       DEFINE VARIABLE vBorderTop     AS INTEGER   NO-UNDO.
     1438       IF NOT VALID-HANDLE (mImgBarFrame) THEN
     1439       DO:
     1440           RUN ref\dynatrig.p PERSISTENT SET mImgSliderTrgs.
     1441           mImgBarFrame = FRAME FrameX:HANDLE.
     1442           ASSIGN
     1443               mImgBarFrame:WIDTH-PIXELS  = FRAME d-images:VIRTUAL-WIDTH-PIXELS - 16
     1444               mImgBarFrame:HEIGHT-PIXELS = 2 + (34) + vBorderTop
     1445               mImgBarFrame:HIDDEN        = NO
     1446               mImgBarFrame:SENSITIVE     = YES
     1447               mImgBarFrame:VISIBLE       = YES
     1448               .
     1449           DO WITH FRAME d-images:
     1450               ASSIGN
     1451                   f-marker:WIDTH-PIXELS = 34
     1452                   f-marker:X            = 1
     1453                   f-marker:Y            = MAX (1, mImgBarFrame:Y - f-marker:HEIGHT-PIXELS)
     1454                   .
     1455           END.
     1456       END.
     1457   END PROCEDURE.
     1458   PROCEDURE ImgSlider :
     1459       DEFINE VARIABLE vMax AS INTEGER INITIAL 2 NO-UNDO.
     1460       IF mImageMax > 1 THEN
     1461       DO:
     1462           IF VALID-HANDLE (mImgSlider) THEN DELETE OBJECT mImgSlider.
     1463           vMax = mImageMax.
     1464       END.
     1465       IF NOT VALID-HANDLE (mImgSlider) THEN
     1466       DO:
     1467           CREATE SLIDER mImgSlider ASSIGN
     1468               NAME             = "ImgSlider":U
     1469               TIC-MARKS        = "TOP":U
     1470               FREQUENCY        = 1
     1471               HORIZONTAL       = TRUE
     1472               FRAME            = FRAME d-images:HANDLE
     1473               MAX-VALUE        = vMax
     1474               MIN-VALUE        = 1
     1475               HEIGHT-PIXELS    = mImgBarFrame:HEIGHT-PIXELS + 26
     1476               WIDTH-PIXELS     = ImgXPix (vMax) + 34
     1477               X                = mImgBarFrame:X
     1478               Y                = mImgBarFrame:Y
     1479               NO-CURRENT-VALUE = YES
     1480               TRIGGERS:
     1481                   ON "VALUE-CHANGED":U  ANYWHERE PERSISTENT RUN DynaTrig IN mImgSliderTrgs
     1482                       ("VALUE-CHANGED":U).
     1483               END TRIGGERS.
     1484           RUN SetHandle IN mImgSliderTrgs (mImgSlider:HANDLE).
     1485       END.
     1486       IF mImageMax > 1 THEN
     1487           ASSIGN
     1488               mImgSlider:HIDDEN    = NO
     1489               mImgSlider:SENSITIVE = YES
     1490               mImgSlider:VISIBLE   = YES
     1491               .
     1492       ELSE
     1493           ASSIGN
     1494               mImgSlider:HIDDEN    = YES
     1495               mImgSlider:SENSITIVE = NO
     1496               mImgSlider:VISIBLE   = NO
     1497               .
     1498       mImgSlider:MOVE-TO-BOTTOM ().
     1499   END PROCEDURE.
     1500   PROCEDURE SelectImage :
     1501       DEFINE INPUT PARAMETER iNum AS INTEGER   NO-UNDO.
     1502       DEFINE INPUT PARAMETER iID  AS CHARACTER NO-UNDO.
     1503       DEFINE BUFFER ttImgBar FOR ttImgBar.
     1504       FOR EACH ttImgBar NO-LOCK:
     1505           IF ttImgBar.fNum = iNum OR ttImgBar.fID = iID THEN
     1506           DO WITH FRAME d-images:
     1507               ASSIGN
     1508                   f-marker:X               = ttImgBar.fFrame:X
     1509                   f-FileName:SCREEN-VALUE  = ttImgBar.fFile
     1510                   mImgSlider:SCREEN-VALUE  = STRING (ttImgBar.fNum)
     1511                   ttImgBar.fFrame:SELECTED = NO
     1512                   mImageCurID              = ttImgBar.fID
     1513                   mImageCurNum             = ttImgBar.fNum
     1514                   t-preview:CHECKED        = (ttImgBar.fNum = 1)
     1515                   t-preview:SENSITIVE      = (ttImgBar.fNum > 1) AND mEnab
     1516                   .
     1517               CurrentImage:LOAD-IMAGE (ttImgBar.fFile) NO-ERROR.
     1518           END.
     1519           ELSE
     1520               ttImgBar.fFrame:SELECTED = NO.
     1521       END.
     1522   END PROCEDURE.
     1523   PROCEDURE SensButtons :
     1524       DO WITH FRAME d-images:
     1525           ASSIGN
     1526               b-add:SENSITIVE = (ImgXPix (mImageMax + 1) + 34 < mImgBarFrame:WIDTH-PIXELS)
     1527                   AND mEnab
     1528               b-del:SENSITIVE = mImageMax > 0
     1529                   AND mEnab
     1530               .
     1531       END.
     1532   END PROCEDURE.
     1533   FUNCTION ImgXPix RETURNS INTEGER
     1534     (iNum AS INTEGER) :
     1535     RETURN 1 + (iNum - 1) * (34 + 3).
     1536   END FUNCTION.
