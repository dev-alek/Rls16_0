      718   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      719   PROCEDURE verify-ini-entry:
      720   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
      721   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
      722   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
      723   DEFINE INPUT  PARAMETER silence          as logical no-undo.
      724   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
      725   define variable v-mess as character no-undo .
      726   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
      727   if ini-entry-value = ? and ini-key-name begins "spl"
      728   then
      729   get-key-value section ini-section-name key "splall" value ini-entry-value.
      730   if ini-entry-value = ? and ini-key-name begins "sav"
      731   then
      732   get-key-value section ini-section-name key "savall" value ini-entry-value.
      733   if ini-entry-value = ? then do:
      734     assign
      735     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
      736                       , chr(10)
      737                       , ini-section-name
      738                       , ini-key-name
      739                       , error-msg-text).
      740       if not silence then do:
      741         message
      742         v-mess
      743         view-as alert-box ERROR  .
      744         return error.
      745       end.
      746       else do:
      747         return error v-mess.
      748       end.
      749   end.
      750   END PROCEDURE.
      751   PROCEDURE verify-file:
      752   DEFINE INPUT  PARAMETER filename       as character no-undo.
      753   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
      754   DEFINE INPUT  PARAMETER silence        as logical no-undo.
      755   DEFINE OUTPUT PARAMETER found          as logical no-undo.
      756   file-info:file-name = filename.
      757   found = NOT (file-info:full-pathname = ?).
      758   if NOT found  then do:
      759     if not silence then do:
      760       message error-msg-text
      761       view-as alert-box ERROR.
      762       return error.
      763     end.
      764     else return error error-msg-text.
      765   end.
      766   END PROCEDURE.
