      129   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   procedure cur-time :
      131      define output parameter p-today as date      no-undo .
      132      define output parameter p-time  as integer   no-undo .
      133     do
      134     on error undo, return error
      135     :
      136       define variable v-date1 as date      no-undo .
      137       define variable v-date2 as date      no-undo .
      138       define variable v-time  as integer   no-undo .
      139       assign
      140         v-date1 = today
      141         v-time  = time
      142         v-date2 = today
      143       .
      144       if v-date1 <> v-date2
      145       then do:
      146         assign
      147           v-date1 = today
      148           v-time  = v-time
      149         .
      150       end.
      151       assign
      152         p-today = v-date1
      153         p-time  = v-time
      154       .
      155     end.
      156   end.
      157   function cur-time-date returns character
      158   :
      159     return string(today, '99/99/9999':U) .
      160   end.
      161   function cur-time-mjd returns decimal
      162   :
      163     define variable v-date as date      no-undo .
      164     define variable v-time as integer   no-undo .
      165     run cur-time in this-procedure
      166       (output v-date
      167       ,output v-time
      168       ) .
      169     return integer(v-date) - 2400002 + (v-time / 86400) .
      170   end.
      171   function cur-time-get-ending-index returns integer
      172   (input p-number as integer
      173   )
      174   :
      175     if p-number < 0
      176     or p-number = ?
      177     then do:
      178       return 1 .
      179     end.
      180     define variable v-rest as integer   no-undo .
      181     assign
      182       p-number = p-number modulo 100
      183     .
      184     if p-number < 20
      185     then do:
      186       assign
      187         v-rest = p-number
      188       .
      189     end.
      190     else do:
      191       assign
      192         v-rest = p-number modulo 10
      193       .
      194     end.
      195     case v-rest :
      196       when 1
      197       then do:
      198         return 2 .
      199       end.
      200       when 2 or
      201       when 3 or
      202       when 4
      203       then do:
      204         return 3 .
      205       end.
      206       otherwise do:
      207         return 1 .
      208       end.
      209     end case .
      210   end.
      211   procedure cur-time-mjd-to-date :
      212      define input  parameter i-mjd-diff as decimal no-undo.
      213      define output parameter o-Date     as date    no-undo.
      214      define output parameter o-Time     as integer no-undo.
      215      define variable v-day-number as integer   no-undo .
      216      if    i-mjd-diff < 0
      217         or i-mjd-diff = ?
      218      then do:
      219         return "?" .
      220      end.
      221      assign
      222         v-day-number = truncate(i-mjd-diff,0).
      223         o-Date = date(v-day-number + 2400002).
      224         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      225     .
      226   end.
      227   function cur-time-mjd-to-string returns character
      228   (input p-mjd-diff as decimal
      229   )
      230   :
      231     define variable v-day-number as integer   no-undo .
      232     define variable v-seconds    as integer   no-undo .
      233     define variable v-hour       as integer   no-undo .
      234     define variable v-min        as integer   no-undo .
      235     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      236     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      237     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      238     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      239     if p-mjd-diff < 0
      240     or p-mjd-diff = ?
      241     then do:
      242       return "?" .
      243     end.
      244     assign
      245       v-day-number = integer(truncate(p-mjd-diff,0))
      246       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      247     .
      248     if v-seconds > 86400
      249     then do:
      250       assign
      251         v-seconds = 86400 - 1
      252       .
      253     end.
      254     if v-seconds < 0
      255     then do:
      256       assign
      257         v-seconds = 0
      258       .
      259     end.
      260     assign
      261       v-hour = truncate(v-seconds / 3600, 0)
      262     .
      263     assign
      264       v-seconds = v-seconds modulo 3600
      265     .
      266     assign
      267       v-min = truncate(v-seconds / 60, 0)
      268     .
      269     assign
      270       v-seconds = v-seconds modulo 60
      271     .
      272     return
      273         (if v-day-number <> 0
      274           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      275           else ""
      276         )
      277       + (if v-day-number <> 0 or v-hour <> 0
      278           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      279           else ""
      280         )
      281       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      282           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      283           else ""
      284         )
      285       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      286       .
      287   end.
      288   function cur-time-string returns character
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      297   end.
      298   function cur-time-string-sec returns character
      299   :
      300     define variable v-date as date      no-undo .
      301     define variable v-time as integer   no-undo .
      302     run cur-time in this-procedure
      303       (output v-date
      304       ,output v-time
      305       ) .
      306     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      307   end.
      308   function cur-time-custom  returns character
      309   (input p-prefix as character
      310   ,input p-date-format as character
      311   ,input p-delimiter as character
      312   ,input p-time-format as character
      313   ,input p-suffix as character
      314   )
      315   :
      316     define variable v-date as date      no-undo .
      317     define variable v-time as integer   no-undo .
      318     run cur-time in this-procedure
      319       (output v-date
      320       ,output v-time
      321       ) .
      322     return
      323       p-prefix
      324       + string(v-date, p-date-format)
      325       + p-delimiter
      326       + string(v-time, p-time-format)
      327       + p-suffix
      328       .
      329   end.
      330   function cur-time-print  returns character
      331   :
      332     define variable v-date as date      no-undo .
      333     define variable v-time as integer   no-undo .
      334     run cur-time in this-procedure
      335       (output v-date
      336       ,output v-time
      337       ) .
      338     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      339   end.
      340   function cur-time-datetime returns datetime
      341   :
      342     define variable v-char as character no-undo .
      343     define variable v-datetime as datetime no-undo .
      344     v-char = cur-time-string().
      345     v-datetime = datetime(v-char).
      346     return  v-datetime.
      347   end.
      348   function cur-time-string-msec returns character
      349   :
      350     define variable v-date as datetime  no-undo .
      351     v-date = now.
      352     return string(v-date) .
      353   end.
