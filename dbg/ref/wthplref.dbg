     1423                   ,input parobj-type
     1424                   ,input parobj-code
     1425                   ,input 'Место хранения МЦ':U
     1426                   ,input 'ПРОСМОТР':U
     1427                   ,input 0
     1428                   ,input 0
     1429                   ,INPUT 0
     1430                   ,INPUT 0
     1431                   ,INPUT '':U
     1432                   ,input X_wth-place.w-p-code
     1433                   ,INPUT '':U
     1434                   ,INPUT 0
     1435                   ,INPUT '':U )  no-error.
