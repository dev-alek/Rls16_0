     1409         AND (v-rid-list = ""
     1410            or b-mark:sensitive = no
     1411         )) then
     1412           v-rid-list = string( recid( X_wth-place ) ) .
     1413   END.
     1414   ON CHOOSE OF B-wthparts IN FRAME Dialog-Frame
