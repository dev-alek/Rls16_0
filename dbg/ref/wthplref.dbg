     1298   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1299   DO:
     1300    define variable del-rec as recid no-undo.
     1301    define variable rep-rec as recid no-undo .
     1302    define variable glog as logical no-undo .
     1303   if not available X_wth-place then do:
     1304     message "Неправильно выбрана строка.".
     1305     return no-apply.
     1306   end.
     1307   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1308   do:
     1309     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1310       (input  v-cntxt-db-num
     1311       ,input  v-cntxt-userid
     1312       ,input  0
     1313       ,input  'actn_wth-place-reference_work':U
     1314       ,input  'object':U
     1315       ,input  parhost-code
     1316       ,input  parobj-type
     1317       ,input  parobj-code
     1318       ,input  0
     1319       ,input  0
     1320       ,input  0
     1321       ,input  true
     1322       ,output glog
     1323       )  .
     1324   end.
     1325   if NOT glog then return no-apply.
     1326   rep-rec = recid ( X_wth-place).
     1327   glog = no.
     1328   message
     1329   "Удалить место хранения материальной ценности ?   Вы уверены ?"
     1330   view-as alert-box question buttons OK-Cancel update glog.
     1331   if glog <> yes then return no-apply.
     1332   glog = br-wthpl:select-next-row().
     1333   if not glog then glog = br-wthpl:select-prev-row().
     1334   del-rec = recid ( X_wth-place).
     1335   find X_wth-place where recid ( X_wth-place) = rep-rec.
     1336   _deletion:
