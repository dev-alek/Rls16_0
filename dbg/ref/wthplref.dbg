     1352                      ,INPUT X_wth-place.w-p-code
     1353                      ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     1354     END.
     1355   END.
     1356   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1357   DO:
     1358   define variable glog as logical no-undo .
     1359     if available X_wth-place then do:
     1360   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1361   define variable v-str-recid16 as character no-undo .
     1362   define variable v-num-entry16 as integer   no-undo .
     1363   assign
     1364     v-str-recid16 = trim( string( recid( X_wth-place ) , "->>>>>>>>>>>9":U ) )
     1365     v-num-entry16 = lookup( v-str-recid16 , v-rid-list )
     1366   .
     1367   if v-num-entry16 > 0 then do:
     1368     assign
     1369       entry( v-num-entry16, v-rid-list ) = "":U
     1370       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1371     .
     1372   end.
     1373   else do:
     1374     assign
     1375       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid16
     1376     .
     1377   end.
     1378       br-wthpl:refresh().
     1379       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1380               glog = br-wthpl:select-next-row ().
     1381               apply "iteration-changed" to br-wthpl in frame Dialog-Frame.
     1382           end.
     1383       if num-entries( v-rid-list ) = 0 then
     1384           hide mark-num in frame Dialog-Frame.
     1385       else
     1386           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1387     end.
     1388     apply "entry" to br-wthpl in frame Dialog-Frame.
     1389   END.
     1390   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1391   DO:
     1392   define variable doc-rec as recid no-undo .
     1393       doc-rec = recid( X_wth-place ).
     1394       DO WHILE available X_wth-place :
