      618   FUNCTION get-curr RETURNS CHARACTER
      619     (buffer loc-wealth for ub.wealth ) :
      620   define buffer buf_currency for ub.currency.
      621   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
      622   return loc-wealth.unit-base.
      623   FIND FIRST buf_currency no-lock where
      624             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
      625   if avail buf_currency then
      626     RETURN buf_currency.curr-abbr.
      627   else return "".
      628   END FUNCTION.
      629   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      630   procedure fltfield-clear :
      631     define output parameter loc-fld as character no-undo.
      632     define output parameter loc-lab as character no-undo .
      633     define output parameter loc-spr as character no-undo .
      634     define output parameter loc-dim as character no-undo .
      635     assign
      636       loc-fld = ""
      637       loc-lab = ""
      638       loc-spr = ""
      639       loc-dim = "0"
      640     .
      641   end procedure .
      642   procedure fltfield-add :
      643     define input        parameter par-fld as character no-undo.
      644     define input        parameter par-lab as character no-undo .
      645     define input        parameter par-spr as character no-undo .
      646     define input-output parameter loc-fld as character no-undo.
      647     define input-output parameter loc-lab as character no-undo .
      648     define input-output parameter loc-spr as character no-undo .
      649     define input-output parameter loc-dim as character no-undo .
      650     do
      651     on error undo, return error
      652     :
      653       assign
      654       loc-fld = if loc-dim = '0'
      655                 then par-fld
      656                 else (loc-fld + chr(44) + par-fld)
      657       loc-lab = if loc-dim = '0'
      658                 then par-lab
      659                 else (loc-lab + chr(44) + par-lab)
      660       loc-spr = if loc-dim = '0'
      661                 then par-spr
      662                 else (loc-spr + chr(44) + par-spr)
      663       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      664                 string(integer(if num-entries(loc-dim) > 1
      665                               then entry(2, loc-dim)
      666                               else entry(1, loc-dim)
      667                               ) + 1)
      668       no-error
      669       .
      670     end.
      671   end procedure.
      672   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      673   define variable v-waitfram-action01         as character   no-undo .
      674   define variable v-waitfram-action02         as character   no-undo .
      675   define variable v-waitfram-action03         as character   no-undo .
      676   define variable mWaitFramTextBeg            as character   no-undo.
      677   define variable mWaitFramTextEnd            as character   no-undo.
      678   define variable mWaitFramView               as logical     no-undo.
      679   define variable mWaitProcEvent              as logical     no-undo init yes.
      680   define variable mWaitFramInterval           as integer     no-undo init 1 .
      681   define variable mWaitFramStop               as logical     no-undo.
      682   define variable mWaitFramStopUser           as logical     no-undo.
      683   define variable mWaitFramStopTimeOut        as logical     no-undo.
      684   define variable mWaitFramStartProc          as datetime-tz no-undo.
      685   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      686   define button B-WaitFramStop auto-end-key
      687        label "Стоп"
      688        size 10 by 1 tooltip "Остоновить процесс".
      689   define button B-viewProcInfo
      690        label "Информация"
      691        size 15 by 1 tooltip "Информация о процесс".
      692   define frame waitfram
      693     v-waitfram-action01 format "x(72)" no-label skip
      694     v-waitfram-action02 format "x(72)" no-label skip
      695     v-waitfram-action03 format "x(72)" no-label skip
      696     B-viewProcInfo
      697     B-WaitFramStop at row 4 col 30
      698     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      699     .
      700   define new global shared variable mBatchMode as logical no-undo init ?.
      701   define variable mFramBachModHandle as handle no-undo.
      702   mFramBachModHandle = frame waitfram:handle.
      703   define variable mFameOldVis as logical no-undo.
      704   define variable mVisCUrentVin as logical no-undo.
      705   if session:batch-mode
      706   then
      707      mBatchMode = yes.
      708   if mBatchMode = ? then do:
      709     mVisCUrentVin = current-window:visible.
      710     mFameOldVis = mFramBachModHandle:visible.
      711     mFramBachModHandle:visible  = yes.
      712     mBatchMode = mFramBachModHandle:visible ne yes.
      713     mFramBachModHandle:visible = mFameOldVis.
      714     current-window:visible = mVisCUrentVin.
      715   end.
      716    if  log-manager:logfile-name ne ?
      717     then DO:
      718         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      719         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      720         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      721     end.
      722   on choose of B-WaitFramStop in frame waitfram
      723   do:
      724     mWaitFramStop = yes.
      725     mWaitFramStopUser = yes.
      726   end.
      727   function waitfram-check-timeout returns logical():
      728      define variable vtime as int64 no-undo.
      729      if mWaitFramStopTimeOut
      730      then
      731         return yes.
      732      vtime = ( now - mWaitFramStartProc ) / 1000 .
      733      if     mWaitFramTimeOut ne ?
      734         and mWaitFramTimeOut ne 0
      735         and mWaitFramTimeOut lt vtime
      736      then do:
      737         mWaitFramStopTimeOut = yes.
      738      end.
      739      return mWaitFramStopTimeOut.
      740   end.
      741   procedure waitfram-hide :
      742     if not session:batch-mode
      743     then do
      744     on error undo, return error return-value
      745     :
      746       pause 0 before-hide .
      747       if not mBatchMode then
      748         hide frame waitfram .
      749     if     not mWaitFramView
      750        and mWaitProcEvent
      751     then
      752       process events .
      753     end.
      754   end procedure.
      755   procedure waitfram-show :
      756     define input  parameter p-message as character no-undo .
      757     define variable v-left-margin as integer   no-undo .
      758     if not session:batch-mode
      759     then do
      760     on error undo, return error return-value
      761     :
      762       if length(p-message) <= 70 then do:
      763         assign
      764           v-left-margin = integer((70 - length(p-message)) / 2)
      765         .
      766         assign
      767           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      768         .
      769         assign
      770           v-waitfram-action01 = " "
      771           v-waitfram-action02 = " "
      772                                    + fill(" ", v-left-margin)
      773                                    + p-message
      774           v-waitfram-action03 = " "
      775         .
      776       end.
      777       else do:
      778         define variable vRindex1 as integer no-undo.
      779         define variable vRindex2 as integer no-undo.
      780         vRindex1 = r-index(p-message," ",70).
      781         if vRindex1 = 0
      782         then
      783            vRindex1 = 70.
      784         if length(p-message)  <= vRindex1 + 70 then do:
      785           assign
      786             v-waitfram-action01 = " "
      787             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      788             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      789           .
      790         end.
      791         else do:
      792           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      793           if vRindex2 <= vRindex1
      794           then
      795              vRindex2 = vRindex1 + 70.
      796           assign
      797             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      798             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      799             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      800           .
      801         end.
      802       end.
      803       B-viewProcInfo:visible   in frame waitfram = no.
      804       B-viewProcInfo:sensitive in frame waitfram = no.
      805       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      806       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      807       if  (   mWaitFramView
      808          or  mWaitProcEvent)
      809          and not mBatchMode
      810       then
      811          display
      812             v-waitfram-action01 skip
      813             v-waitfram-action02 skip
      814             v-waitfram-action03 skip
      815          with frame waitfram .
      816       if     mWaitFramView
      817          then do:
      818             if     mWaitFramInterval ne ?
      819                and not mBatchMode
      820             then
      821                wait-for go of frame waitfram pause mWaitFramInterval.
      822          end.
      823          else
      824             if     mWaitProcEvent
      825                and not mBatchMode
      826             then
      827                process events .
      828     end.
      829   end procedure.
      830      procedure waitfram-show-this:
      831         define input  parameter iInterval as int64 no-undo.
      832         define variable vtime as int64 no-undo.
      833         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      834         mWaitFramInterval = iInterval.
      835         run waitfram-show (substitute("&1&2 &3&4" ,
      836                                       mWaitFramTextBeg ,
      837                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      838                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      839                                       mWaitFramTextEnd
      840                                      )
      841                           ).
      842      end.
      843      procedure WaitFramRunPause:
      844         define input  parameter iInterval as dec no-undo.
      845         define variable vStart  as datetime-tz no-undo.
      846         define variable vend    as datetime-tz no-undo.
      847         define variable vint as int64 no-undo.
      848         define variable vOk as logical no-undo.
      849         vStart = now.
      850         vend   = vStart.
      851         publish "WaitFramPause" (iInterval,output vOk).
      852         vend   =  now.
      853         vint = vend - vStart.
      854         vint = iInterval - vint / 1000.
      855         if     not mWaitFramStop
      856            and (   vint > 0
      857                 or (    not vOk
      858                     and iInterval eq ?
      859                     )
      860                 )
      861         then
      862            run waitfram-show-this (iInterval).
      863         vend   =  now.
      864         vint = vend - vStart.
      865         vint = iInterval - vint / 1000.
      866         if     not mWaitFramStop
      867            and vint > 0
      868         then do:
      869            run gbl/pause.p (vint * 1000).
      870         end.
      871         if iInterval ne ?
      872         then
      873            publish "WaitFramStop".
      874         waitfram-check-timeout().
      875      end.
      876      procedure WaitFramWaitFor:
      877         define input  parameter iInterval as dec no-undo.
      878         assign
      879            mWaitFramStartProc   = now
      880            mWaitFramStopUser    = no
      881            mWaitFramStopTimeOut = no
      882         .
      883         block-wait:
      884         do while not mWaitFramStop:
      885            run WaitFramRunPause (iInterval).
      886            if  waitfram-check-timeout()
      887            then do:
      888               leave block-wait.
      889            end.
      890         end.
      891         run waitfram-hide.
      892      end.
      893   procedure waitfram-join :
      894     define input  parameter p-line-1  as character no-undo .
      895     define input  parameter p-line-2  as character no-undo .
      896     define input  parameter p-line-3  as character no-undo .
      897     define output parameter p-message as character no-undo .
      898     do
      899     on error undo, return error return-value
      900     :
      901       assign
      902         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      903                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      904                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      905       .
      906     end.
      907   end procedure.
      908   function waitfram-join-function returns character
      909     (input p-line-1 as character
      910     ,input p-line-2 as character
      911     ,input p-line-3 as character
      912     ).
      913     define variable v-message as character no-undo .
      914     run waitfram-join in this-procedure
      915       (input  p-line-1
      916       ,input  p-line-2
      917       ,input  p-line-3
      918       ,output v-message
      919       ) .
      920     return v-message .
      921   end function .
      922   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      923     define variable v-cntxt-db-num        as integer   no-undo .
      924     define variable v-cntxt-userid        as character no-undo .
      925     define variable v-cntxt-level         as character no-undo .
      926     define variable v-cntxt-host-code-obj as integer   no-undo .
      927     define variable v-cntxt-obj-type      as character no-undo .
      928     define variable v-cntxt-obj-code      as integer   no-undo .
      929     define variable v-cntxt-db-num-obj    as integer   no-undo .
      930     define variable v-cntxt-is-admin      as logical   no-undo .
      931   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      932   FUNCTION mark-string RETURNS CHARACTER
      933     ( input p-recid as recid, input mark-list as character  ) :
      934     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      935   END FUNCTION.
      936   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      937   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      938   procedure fltopend_fltopend :
      939   define input parameter p-parent-handle as handle no-undo .
      940   define input parameter p-qh as handle no-undo .
      941   define input parameter p-flt-open-open-query  as character no-undo .
      942   define input parameter p-where-cond as character no-undo .
      943   define input parameter p-use-indFIRST-query-tail as character no-undo .
      944   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      945   define input parameter p-indexed-reposition as character no-undo .
      946     do
      947     on error undo, return error
      948     :
      949   define variable v-prepare-string as character no-undo .
      950   define variable glog as logical no-undo .
      951   assign
      952   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      953                      p-where-cond + chr(32)  +
      954                      p-use-indFIRST-query-tail + chr(32) +
      955                      p-use-ind-sort-clmn-by + chr(32) +
      956                      p-indexed-reposition
      957   .
      958   assign
      959   glog = p-qh:query-prepare(v-prepare-string) no-error .
      960   if not glog
      961   or error-status:error then do:
      962     message error-status:get-message(1) view-as alert-box .
      963     undo, return error .
      964   end.
      965   assign
      966   glog = p-qh:query-open no-error .
      967   if not glog
      968   or error-status:error then do:
      969     message error-status:get-message(1) view-as alert-box .
      970     undo, return error .
      971   end.
      972     end.
      973   end procedure.
      974   procedure fltopend_fltfindd :
      975   define input parameter p-parent-handle as handle no-undo .
      976   define input parameter p-qh as handle no-undo .
      977   define input parameter p-rowid as rowid no-undo .
      978   define input parameter p-next as logical no-undo .
      979   define input parameter p-lock as integer no-undo .
      980   define input parameter p-bh as handle no-undo .
      981   define input parameter p-where-cond as character no-undo .
      982   define input parameter p-use-index-phrase as character no-undo .
      983   define variable glog as logical no-undo .
      984   define variable v-qh as handle no-undo .
      985   define variable v-bh as handle no-undo .
      986   define variable v-recid as recid no-undo .
      987   define variable v-prepare-string as character no-undo .
      988   do
      989   on error undo, return error
      990   on stop undo, return error
      991   :
      992     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      993     create buffer v-bh for table p-bh buffer-name p-bh:name.
      994     create query v-qh.
      995     v-qh:set-buffers(v-bh).
      996     v-prepare-string = substitute("for each &1 &2 &3"
      997                                     ,v-bh:name
      998                                     ,p-where-cond
      999                                     ,p-use-index-phrase).
     1000     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1001     if not glog then do:
     1002       delete object v-qh.
     1003       delete object v-bh.
     1004       undo, return error .
     1005     end.
     1006     glog = v-qh:query-open no-error .
     1007     if not glog then do:
     1008       delete object v-qh.
     1009       delete object v-bh.
     1010       undo, return error .
     1011     end.
     1012     if p-next then do:
     1013       v-qh:reposition-to-rowid(p-rowid) no-error .
     1014       glog = v-qh:get-next( p-lock) no-error .
     1015       glog = v-qh:get-next( p-lock) no-error .
     1016       if not glog or v-qh:query-off-end = yes then do:
     1017         glog = v-qh:get-first( p-lock) no-error .
     1018       end.
     1019     end.
     1020     else do:
     1021       glog = v-qh:get-first( p-lock) no-error .
     1022     end.
     1023     v-recid = v-bh:recid no-error .
     1024     delete object v-qh.
     1025     delete object v-bh.
     1026     return string(v-recid) .
     1027   end.
     1028   end procedure.
     1029   procedure fltopend_fltfindq :
     1030   define input parameter p-parent-handle as handle no-undo .
     1031   define input parameter p-qh as handle no-undo .
     1032   define input parameter p-next as logical no-undo .
     1033   define input parameter p-lock as integer no-undo .
     1034   define input parameter p-flt-open-open-query  as character no-undo .
     1035   define input parameter p-where-cond as character no-undo .
     1036   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1037   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1038   define input parameter p-indexed-reposition as character no-undo .
     1039   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1040   define variable glog as logical no-undo .
     1041   define variable v-qh as handle no-undo .
     1042   define variable v-bh as handle no-undo extent 18.
     1043   define variable v-rowid as rowid no-undo extent 18.
     1044   define variable v-ii as integer no-undo .
     1045   define variable v-prepare-string as character no-undo .
     1046   do
     1047   on error undo, return error
     1048   on stop undo, return error
     1049   :
     1050     create query v-qh.
     1051     do v-ii = 1 to p-qh:num-buffers:
     1052       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1053       assign
     1054       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1055       no-error.
     1056       v-qh:add-buffer(v-bh[v-ii]).
     1057     end.
     1058     assign
     1059     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1060                       p-where-cond + chr(32)  +
     1061                       p-use-indFIRST-query-tail + chr(32) +
     1062                       p-use-ind-sort-clmn-by + chr(32) +
     1063                       p-indexed-reposition
     1064     .
     1065     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1066     if not glog then do:
     1067       delete object v-qh.
     1068       do v-ii = 1 to p-qh:num-buffers:
     1069         delete object v-bh[v-ii].
     1070       end.
     1071       undo, return error .
     1072     end.
     1073     glog = v-qh:query-open no-error .
     1074     if not glog then do:
     1075       delete object v-qh.
     1076       do v-ii = 1 to p-qh:num-buffers:
     1077         delete object v-bh[v-ii].
     1078       end.
     1079       undo, return error .
     1080     end.
     1081     if p-next then do:
     1082       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1083       glog = v-qh:get-next( p-lock) no-error .
     1084       glog = v-qh:get-next( p-lock) no-error .
     1085       if not glog or v-qh:query-off-end = yes then do:
     1086         glog = v-qh:get-first( p-lock) no-error .
     1087       end.
     1088     end.
     1089     else do:
     1090       glog = v-qh:get-first( p-lock) no-error .
     1091     end.
     1092     do v-ii = 1 to p-qh:num-buffers:
     1093       assign
     1094       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1095       no-error.
     1096     end.
     1097     delete object v-qh.
     1098     do v-ii = 1 to p-qh:num-buffers:
     1099       delete object v-bh[v-ii].
     1100     end.
     1101   end.
     1102   end procedure.
