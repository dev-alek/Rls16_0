     2757         assign
     2758           frame Dialog-Frame:title
     2759             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2760         .
     2761         assign
     2762           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2763         .
     2764       end.
     2765       else do:
     2766         assign
     2767           b-sch :tooltip = ""
     2768         .
     2769       end.
     2770     end.
     2771   end procedure.
     2772   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2773   on INS of frame Dialog-Frame anywhere do:
     2774     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2775     return no-apply.
     2776   end.
     2777   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2778   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     2779     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     2780     return no-apply.
     2781   end.
     2782   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2783   on F4 of frame Dialog-Frame anywhere do:
     2784     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame Dialog-Frame. END.
     2785     return no-apply.
     2786   end.
     2787   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2788   on F8 of frame Dialog-Frame anywhere do:
     2789     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     2790     return no-apply.
     2791   end.
     2792   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2793   on F2 of frame Dialog-Frame anywhere do:
     2794     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2795     return no-apply.
     2796   end.
     2797   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2798   on F2 of frame Dialog-Frame anywhere do:
     2799     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2800     return no-apply.
     2801   end.
     2802   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2803   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     2804     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     2805     return no-apply.
     2806   end.
     2807   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2808   do:
     2809     br-wthpl :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2810   end.
     2811   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2812   on f5 of frame Dialog-Frame anywhere
     2813   do:
     2814      v-doc-rec = ?. if available X_wth-place then assign v-doc-rec = recid( X_wth-place). run openbr in this-procedure ( input yes, input no, input '':U).                reposition br-wthpl to recid v-doc-rec no-error. APPLY 'ENTRY' to br-wthpl. APPLY 'VALUe-CHANGED' to br-wthpl.
     2815       apply "VALUE-CHANGED" to BR-wthpl.
     2816   end.
     2817   MAIN-BLOCK:
     2818   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2819      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2820   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2821     run mainmenu_getcntxt in parparentproc
     2822       (output v-cntxt-db-num
     2823       ,output v-cntxt-userid
     2824       ,output v-cntxt-level
     2825       ,output v-cntxt-host-code-obj
     2826       ,output v-cntxt-obj-type
     2827       ,output v-cntxt-obj-code
     2828       ,output v-cntxt-db-num-obj
     2829       ,output v-cntxt-is-admin
     2830       ) .
     2831     v-rid-list = p-rid-list.
     2832     RUN Myenable.
     2833     if v-rid-list <> "":U then do:
     2834       assign
     2835       v-doc-rec = integer(entry(1,v-rid-list))
     2836       no-error .
     2837     end.
     2838     RUN OpenBR in this-procedure ( input yes, input no, input '':U).
     2839     WAIT-FOR GO OF FRAME Dialog-Frame.
     2840   END.
     2841   RUN disable_UI.
     2842   PROCEDURE disable_UI :
     2843     HIDE FRAME Dialog-Frame.
     2844   END PROCEDURE.
     2845   PROCEDURE enable_UI :
     2846     DISPLAY E-PS mark-num
     2847         WITH FRAME Dialog-Frame.
     2848     ENABLE b-quit B-mark B-sel B-add B-chg B-del B-wthpobj B-wthparts B-print
     2849            B-hist B-sch B-Help BR-wthpl E-PS mark-num
     2850         WITH FRAME Dialog-Frame.
     2851     VIEW FRAME Dialog-Frame.
     2852   END PROCEDURE.
     2853   PROCEDURE MyEnable :
     2854   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2855     (input  'ser-wth'
     2856     ,input  0
     2857     ,input  ''
     2858     ,input  0
     2859     ,input  ''
     2860     ,input  ''
     2861     ,input  ''
     2862     ,input  NO
     2863     ,output conf-par
     2864     ,output par-type
     2865     ) no-error .
     2866     IF not error-status:error then
     2867     assign
     2868     ser-wth = (conf-par = "yes":U).
     2869   ENABLE b-quit b-help br-wthpl E-PS
     2870   b-sel when lookup ("b-sel", bttns) > 0
     2871   b-mark when lookup ("b-mark", bttns) > 0
     2872   b-add when lookup ("b-add", bttns) > 0   and v-cntxt-db-num = v-cntxt-db-num-obj
     2873   b-chg when lookup ("b-add", bttns) > 0  and v-cntxt-db-num = v-cntxt-db-num-obj
     2874   b-print
     2875   b-wthpobj
     2876   b-hist
     2877   b-wthparts when ser-wth
     2878   b-sch
     2879   WITH FRAME Dialog-Frame.
     2880   VIEW FRAME Dialog-Frame.
     2881   HIDE
     2882   b-del
     2883   in frame Dialog-Frame.
     2884   END PROCEDURE.
     2885   PROCEDURE OpenBr :
     2886   define input  parameter p-open-query     as logical   no-undo .
     2887   define input  parameter p-find-next      as logical   no-undo .
     2888   define input  parameter p-find-condition as character no-undo .
     2889   define variable l-query-was-opened as logical no-undo .
     2890   define buffer buf_clients for ub.clients.
     2891   run waitfram-show in this-procedure ("Ждите...").
     2892   define variable sort-column-phrase as character no-undo .
     2893   case sort-column-name :
     2894     when "" then do:
     2895       assign
     2896         sort-column-phrase = ""
     2897       .
     2898     end.
     2899     otherwise do:
     2900       assign
     2901         sort-column-phrase = "by " + sort-column-name
     2902       .
     2903     end.
     2904   end case.
     2905   CASE p-list-mode:
     2906       when 'все':U then do:
     2907           ASSIGN frame Dialog-Frame:TITLE = "Места хранения МЦ "
     2908           filter-point = "Места хранения МЦ " + p-list-mode
     2909           filter-label = substitute("&1", filter-label0)
     2910           .
     2911   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2912   define variable  l-disable-where-32  as logical   no-undo .
     2913   define variable  l-filter-open-32    as logical   .
     2914   define variable  flt-rec-32       as recid     no-undo .
     2915   define variable  filter-name-32      as character no-undo .
     2916   define variable  where-phrase-32     as character no-undo .
     2917   define variable  sort-phrase-32      as character no-undo .
     2918   define variable  where-phrase-rus-32 as character no-undo .
     2919   define variable  sort-phrase-rus-32  as character no-undo .
     2920     run waitfram-show in this-procedure
     2921       (input "ЖДИТЕ ..."
     2922       ).
     2923   run gbl/flt-get.p
     2924     (input filter-point
     2925     ,output flt-rec-32
     2926     ,output filter-name-32
     2927     ,output where-phrase-32
     2928     ,output sort-phrase-32
     2929     ,output where-phrase-rus-32
     2930     ,output sort-phrase-rus-32
     2931     ).
     2932       run set-filter-name in this-procedure
     2933         (INPUT filter-name-32
     2934         ) no-error .
     2935     assign
     2936       l-filter-open-32 = false
     2937     .
     2938     if flt-rec-32 <> ?
     2939       or sort-column-phrase > ""
     2940     then do:
     2941       define variable  parameter-2-32 as character no-undo .
     2942       define variable  parameter-3-32 as character no-undo .
     2943       define variable  parameter-4-32 as character no-undo .
     2944       define variable  parameter-5-32 as character no-undo .
     2945       define variable  parameter-6-32 as character no-undo .
     2946       define variable  parameter-7-32 as character no-undo .
     2947         assign
     2948         parameter-3-32 =
     2949                                 "FOR EACH X_wth-place"
     2950         parameter-4-32 =
     2951           (
     2952             if (" TRUE " + " " + where-phrase-32) <> ""
     2953             then " TRUE " + " " + where-phrase-32
     2954             else "true"
     2955           )
     2956         parameter-5-32 = (" " + "" + " " + "")
     2957         parameter-6-32 = if sort-phrase-32 = ''
     2958                              then
     2959           (
     2960           " " + "  " +
     2961             " " + sort-column-phrase +
