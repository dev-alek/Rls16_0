     1468     E-PS:screen-value = X_wth-place.PS  .
     1469     else
     1470     E-PS:screen-value = "".
     1471   END.
     1472   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1473   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1474   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1475   on help of frame Dialog-Frame
     1476   do:
     1477     run gbl/app_help.p
     1478       (input this-procedure :file-name
     1479       ,input ''
     1480       ,input ?
     1481       ) no-error.
     1482     if error-status :error then do:
     1483       message
     1484         "Ошибка при вызове помощи"
     1485         error-status :get-message(1)
     1486         view-as alert-box .
     1487     end.
     1488   end.
     1489   run minbtn-set in this-procedure .
     1490   on choose of b-help in frame Dialog-Frame
     1491   do:
     1492     apply "help":u to frame Dialog-Frame .
     1493   end.
     1494   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1495   procedure minbtn-set :
     1496       do
     1497           on error undo, return error return-value
     1498           :
     1499           define variable ii              as integer       no-undo .
     1500           define variable fh              as widget-handle no-undo .
     1501           define variable hh              as widget-handle no-undo .
     1502           define variable v-h             as handle        extent 4 no-undo .
     1503           define variable v-name-button   as character     no-undo .
     1504           define variable v-help-old-x    as decimal       no-undo .
     1505           define variable v-help-old-y    as decimal       no-undo .
     1506           define variable v-help-old-size as decimal       no-undo .
     1507           define variable v-frame-width   as decimal       no-undo .
     1508           define variable jj              as integer       no-undo .
     1509           do
     1510               on error undo, return error
     1511               :
     1512               assign
     1513                   v-frame-width = frame Dialog-Frame:width - 0.3
     1514                   fh            = frame Dialog-Frame:first-child
     1515                   hh            = fh:first-child
     1516                   ii            = 1
     1517                   .
     1518               do while valid-handle(hh):
     1519                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1520                   do:
     1521                       case lc(hh:name) :
     1522                           when "b-help" then
     1523                               do:
     1524                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1525                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1526                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1527                                   hh:TOOLTIP = "Помощь" .
     1528                                   v-help-old-x = hh:column .
     1529                                   v-help-old-y = hh:row    .
     1530                                   v-help-old-size = hh:width .
     1531                                   hh:width-chars = 2.5 .
     1532                               end.
     1533                           when "b-print" then
     1534                               do:
     1535                                   hh:load-image("cmp/b-print.bmp":u) .
     1536                                   hh:TOOLTIP = "Печать" .
     1537                                   v-h[ii] = hh:handle .
     1538                                   ii = ii + 1 .
     1539                                   hh:width-chars = 3 .
     1540                               end.
     1541                           when "b-history" or
     1542                           when "b-hist" then
     1543                               do:
     1544                                   hh:load-image("cmp/b-hist.bmp":u) .
     1545                                   hh:TOOLTIP = "История" .
     1546                                   v-h[ii] = hh:handle .
     1547                                   ii = ii + 1 .
     1548                                   hh:width-chars = 3 .
     1549                               end.
     1550                           when "b-sch" then
     1551                               do:
     1552                                   hh:load-image("cmp/b-sch.bmp":u) .
     1553                                   hh:TOOLTIP = "Установка Фильтра" .
     1554                                   v-h[ii] = hh:handle .
     1555                                   ii = ii + 1 .
     1556                                   hh:width-chars = 3 .
     1557                               end.
     1558                           when "b-hist-user" then
     1559                               do:
     1560                                   hh:load-image("cmp/b-hist.bmp":u) .
     1561                                   hh:TOOLTIP = "История пользователя" .
     1562                                   ii = ii + 1 .
     1563                               end.
     1564                       end case.
     1565                   end.
     1566                   hh = hh:next-sibling.
     1567               end.
     1568               b-help:column = v-frame-width - b-help:width-chars.
     1569               jj = 0.
     1570               repeat ii = 4 to 1 by -1 :
     1571                   if valid-handle (v-h[ii] ) then
     1572                   do:
     1573                       jj  = jj + 1 .
     1574                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1575                       v-h[ii]:row    = v-help-old-y .
     1576                   end.
     1577               end.
     1578           end.
     1579       end.
     1580   end procedure.
     1581   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1582   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1583   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1584   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1585   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1586   define variable v-diasize-current-frame-height as decimal   no-undo .
     1587   define variable v-diasize-change-size          as logical   no-undo .
     1588   define variable v-diasize-resize-button        as handle    no-undo .
     1589   define variable v-diasize-wndmax               as logical   no-undo .
     1590   define variable v-diasize-wndstore             as logical   no-undo .
     1591   define variable v-diasize-proc-name            as character no-undo .
     1592   define variable v-diasize-browse-handle        as handle    no-undo .
     1593   define variable v-diasize-browse-number        as integer   no-undo .
     1594   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1595   define temp-table temp-diasize-handle no-undo
     1596     field handle-value  as handle
     1597     field save-position as decimal
     1598     index xpk is primary unique handle-value
     1599     .
     1600   define temp-table temp-browse-handle no-undo
     1601     field browse-type   as character
     1602     field browse-number as integer
     1603     field browse-handle as handle
     1604     field original-size as decimal
     1605     index xpk is primary unique browse-type browse-number
     1606     index xie browse-type browse-handle
     1607   .
     1608   procedure diasize_change-height :
     1609     define input  parameter p-change-value  as decimal   no-undo .
     1610     define input  parameter p-move-resize   as logical   no-undo .
     1611     define variable v-field-group-handle    as handle    no-undo .
     1612     define variable v-object-handle         as handle    no-undo .
     1613     define variable v-frame-height          as decimal   no-undo .
     1614     define variable v-frame-virtual-height  as decimal   no-undo .
     1615     define variable v-browse-height         as decimal   no-undo .
     1616     define variable v-window-height         as decimal   no-undo .
     1617     define variable v-window-virtual-height as decimal   no-undo .
     1618     define variable v-change-sign           as integer   no-undo .
     1619     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1620     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1621     if p-change-value > 0
     1622     then do:
     1623       if frame Dialog-Frame :height + p-change-value
     1624           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1625       then do:
     1626         assign
     1627           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1628                           - (frame Dialog-Frame :height-chars)
     1629         .
     1630         if p-change-value <= 0
     1631         then do:
     1632           run diasize_position-resize-button in this-procedure .
     1633           return .
     1634         end.
     1635       end.
     1636     end.
     1637     if p-change-value < 0
     1638     then do:
     1639       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1640       then do:
     1641         assign
     1642           p-change-value = v-diasize-orig-frame-height
     1643                          - (frame Dialog-Frame :height-chars)
     1644         .
     1645         if p-change-value >= 0
     1646         then do:
     1647           run diasize_position-resize-button in this-procedure .
     1648           return .
     1649         end.
     1650       end.
     1651     end.
     1652     if p-change-value >= 0
     1653     then do:
     1654       assign
     1655         v-change-sign = 1
     1656       .
     1657     end.
     1658     else do:
     1659       assign
     1660         v-change-sign = -1
     1661       .
     1662     end.
     1663     assign
     1664       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1665     .
     1666     if p-change-value = 0
     1667     then do:
     1668       run diasize_position-resize-button in this-procedure .
     1669       return .
     1670     end.
     1671     move_block:
     1672     do
     1673     on error undo move_block, retry move_block
     1674     :
     1675       if retry
     1676       then do:
     1677         do
     1678         on error undo move_block, leave move_block
     1679         :
     1680           if p-change-value > 0
     1681           then do:
     1682             for each buf_temp-diasize-handle
     1683             on error undo, next
     1684             :
     1685               assign
     1686                 v-object-handle = buf_temp-diasize-handle.handle-value
     1687               .
     1688               if v-object-handle <> v-diasize-resize-button
     1689               then do:
     1690                 assign
     1691                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1692                 .
     1693               end.
     1694             end.
     1695             assign
     1696               v-diasize-browse-handle :height = v-browse-height
     1697             .
     1698             for each buf_temp-browse-handle
     1699               where buf_temp-browse-handle.browse-type = 'height':u
     1700             on error undo, next
     1701             :
     1702               assign
     1703                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1704               .
     1705             end.
     1706             assign
     1707               frame Dialog-Frame :height = v-frame-height
     1708             .
     1709             if frame Dialog-Frame :scrollable = true
     1710             then do:
     1711               assign
     1712                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1713               .
     1714             end.
     1715             run diasize_position-resize-button in this-procedure .
     1716           end.
     1717           else do:
     1718             if frame Dialog-Frame :scrollable = true
     1719             then do:
     1720               assign
     1721                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1722               .
     1723             end.
     1724             assign
     1725               frame Dialog-Frame :height = v-frame-height
     1726             .
     1727             assign
     1728               v-diasize-browse-handle :height = v-browse-height
     1729             .
     1730             for each buf_temp-browse-handle
     1731               where buf_temp-browse-handle.browse-type = 'height':u
     1732             on error undo, next
     1733             :
     1734               assign
     1735                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1736               .
     1737             end.
     1738             for each buf_temp-diasize-handle
     1739             on error undo, next
     1740             :
     1741               assign
     1742                 v-object-handle = buf_temp-diasize-handle.handle-value
     1743               .
     1744               if v-object-handle <> v-diasize-resize-button
     1745               then do:
     1746                 assign
     1747                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1748                 .
     1749               end.
     1750             end.
     1751             run diasize_position-resize-button in this-procedure .
     1752           end.
     1753           assign
     1754             v-diasize-change-size = false
     1755           .
     1756           leave move_block .
     1757         end.
     1758       end.
     1759       assign
     1760         v-diasize-need-full-display = true
     1761       .
     1762       if v-diasize-change-size = false
     1763       then do:
     1764         assign
     1765           v-diasize-change-size = true
     1766         .
     1767       end.
     1768       else do:
     1769         return .
     1770       end.
     1771       assign
     1772         v-frame-height = frame Dialog-Frame :height
     1773         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1774         v-browse-height = v-diasize-browse-handle :height
     1775       .
     1776       for each buf_temp-browse-handle
     1777         where buf_temp-browse-handle.browse-type = 'height':u
     1778       :
     1779         assign
     1780           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1781         .
     1782       end.
     1783       for each buf_temp-diasize-handle
     1784       :
     1785         delete buf_temp-diasize-handle .
     1786       end.
     1787       assign
     1788         v-field-group-handle = frame Dialog-Frame :first-child
     1789       .
     1790       do while valid-handle(v-field-group-handle)
     1791       :
     1792         assign
     1793           v-object-handle = v-field-group-handle :first-child
     1794         .
     1795         do while valid-handle(v-object-handle)
     1796         :
     1797           if  v-object-handle <> v-diasize-browse-handle :handle
     1798           and can-query(v-object-handle, "row")
     1799           and can-query(v-object-handle, "height")
     1800           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1801           then do:
     1802             find first buf_temp-browse-handle
     1803               where buf_temp-browse-handle.browse-type   = 'height':u
     1804                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1805               no-error .
     1806             if available buf_temp-browse-handle
     1807             then do:
     1808             end.
     1809             else do:
     1810               create buf_temp-diasize-handle .
     1811               assign
     1812                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1813                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1814               .
     1815             end.
     1816           end.
     1817           assign
     1818             v-object-handle = v-object-handle :next-sibling
     1819           .
     1820         end.
     1821         assign
     1822           v-field-group-handle = v-field-group-handle :next-sibling
     1823         .
     1824       end.
     1825       do with frame Dialog-Frame
     1826       :
     1827         hide v-diasize-resize-button .
     1828         assign
     1829           v-diasize-resize-button :row    = 1
     1830           v-diasize-resize-button :column = 1
     1831         .
     1832       end.
     1833       if p-change-value > 0
     1834       then do:
     1835         if frame Dialog-Frame :scrollable = true
     1836         then do:
     1837           assign
     1838             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1839             no-error .
     1840           if error-status :error
     1841           or error-status :get-message(1) <> ""
     1842           then do:
     1843             undo move_block, retry move_block .
     1844           end.
     1845         end.
     1846         assign
     1847           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1848           no-error .
     1849         if error-status :error
     1850         or error-status :get-message(1) <> ""
     1851         then do:
     1852           undo move_block, retry move_block .
     1853         end.
     1854         assign
     1855           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1856           no-error .
     1857         if error-status :error
     1858         or error-status :get-message(1) <> ""
     1859         then do:
     1860           undo move_block, retry move_block .
     1861         end.
     1862         for each buf_temp-browse-handle
     1863           where buf_temp-browse-handle.browse-type = 'height':u
     1864         on error undo move_block, retry move_block
     1865         :
     1866           assign
     1867             buf_temp-browse-handle.browse-handle :height
     1868               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1869             no-error .
     1870           if error-status :error
     1871           or error-status :get-message(1) <> ""
     1872           then do:
     1873             undo move_block, retry move_block .
     1874           end.
     1875         end.
     1876         for each buf_temp-diasize-handle
     1877         on error undo move_block, retry move_block
     1878         :
     1879           assign
     1880             v-object-handle = buf_temp-diasize-handle.handle-value
     1881           .
     1882           if v-object-handle <> v-diasize-resize-button
     1883           then do:
     1884             assign
     1885               v-object-handle :row = v-object-handle :row + p-change-value
     1886               no-error .
     1887             if error-status :error
     1888             or error-status :get-message(1) <> ""
     1889             then do:
     1890               undo move_block, retry move_block .
     1891             end.
     1892           end.
     1893         end.
     1894       end.
     1895       else do:
     1896         for each buf_temp-diasize-handle
     1897         on error undo move_block, retry move_block
     1898         :
     1899           assign
     1900             v-object-handle = buf_temp-diasize-handle.handle-value
     1901           .
     1902           if v-object-handle <> v-diasize-resize-button
     1903           then do:
     1904             assign
     1905               v-object-handle :row = v-object-handle :row + p-change-value
     1906               no-error .
     1907             if error-status :error
     1908             or error-status :get-message(1) <> ""
     1909             then do:
     1910               undo move_block, retry move_block .
     1911             end.
     1912           end.
     1913         end.
     1914         assign
     1915           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1916           no-error .
     1917         if error-status :error
     1918         or error-status :get-message(1) <> ""
     1919         then do:
     1920           undo move_block, retry move_block .
     1921         end.
     1922         for each buf_temp-browse-handle
     1923           where buf_temp-browse-handle.browse-type = 'height':u
     1924         on error undo move_block, retry move_block
     1925         :
     1926           assign
     1927             buf_temp-browse-handle.browse-handle :height
     1928               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1929             no-error .
     1930           if error-status :error
     1931           or error-status :get-message(1) <> ""
     1932           then do:
     1933             undo move_block, retry move_block .
     1934           end.
     1935         end.
     1936         assign
     1937           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1938           no-error .
     1939         if error-status :error
     1940         or error-status :get-message(1) <> ""
     1941         then do:
     1942           undo move_block, retry move_block .
     1943         end.
     1944         if frame Dialog-Frame :scrollable = true
     1945         then do:
     1946           assign
     1947             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1948             no-error .
     1949           if error-status :error
     1950           or error-status :get-message(1) <> ""
     1951           then do:
     1952             undo move_block, retry move_block .
     1953           end.
     1954         end.
     1955       end.
     1956       if p-move-resize = true
     1957       then do:
     1958         run diasize_position-resize-button in this-procedure .
     1959       end.
     1960       if v-diasize-wndstore = true
     1961       then do:
     1962         if connected("ub") = true
     1963         then do:
     1964           define variable v-cntxt-db-num        as integer   no-undo .
     1965           define variable v-cntxt-userid        as character no-undo .
     1966           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1967                                             , OUTPUT v-cntxt-userid
     1968                                             ) .
     1969           run gbl/wndsizew.p
     1970             (input  v-cntxt-db-num
     1971             ,input  v-cntxt-userid
     1972             ,input  v-diasize-proc-name
     1973             ,input  'height':u
     1974             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1975             ) .
     1976         end.
     1977       end.
     1978     end.
     1979     assign
     1980       v-diasize-change-size = false
     1981     .
     1982   end procedure.
     1983   procedure diasize_set-height :
     1984     define input  parameter p-new-height  as decimal   no-undo .
     1985     define input  parameter p-move-resize as logical   no-undo .
     1986     do
     1987     on error undo, return error return-value
     1988     :
     1989       run diasize_change-height in this-procedure
     1990         (input  (p-new-height - frame Dialog-Frame :height)
     1991         ,input  p-move-resize
     1992         ) .
     1993     end.
     1994   end procedure.
     1995   procedure diasize_change-width :
     1996     define input  parameter p-change-value as decimal   no-undo .
     1997     define input  parameter p-move-resize  as logical   no-undo .
     1998     define variable v-field-group-handle   as handle    no-undo .
     1999     define variable v-object-handle        as handle    no-undo .
     2000     define variable v-frame-width          as decimal   no-undo .
     2001     define variable v-frame-virtual-width  as decimal   no-undo .
     2002     define variable v-browse-width         as decimal   no-undo .
     2003     define variable v-window-width         as decimal   no-undo .
     2004     define variable v-window-virtual-width as decimal   no-undo .
     2005     define variable v-change-sign          as integer   no-undo .
     2006     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2007     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2008     if p-change-value > 0
     2009     then do:
     2010       if frame Dialog-Frame :width + p-change-value >
     2011           session :width-chars
     2012       then do:
     2013         assign
     2014           p-change-value = session :width-chars - frame Dialog-Frame :width
     2015         .
     2016         if p-change-value <= 0
     2017         then do:
     2018           run diasize_position-resize-button in this-procedure .
     2019           return .
     2020         end.
     2021       end.
     2022     end.
     2023     if p-change-value < 0
     2024     then do:
     2025       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2026       then do:
     2027         assign
     2028           p-change-value = v-diasize-orig-frame-width
     2029                          - frame Dialog-Frame :width
     2030         .
     2031         if p-change-value >= 0
     2032         then do:
     2033           run diasize_position-resize-button in this-procedure .
     2034           return .
     2035         end.
     2036       end.
     2037     end.
     2038     if p-change-value >= 0
     2039     then do:
     2040       assign
     2041         v-change-sign = 1
     2042       .
     2043     end.
     2044     else do:
     2045       assign
     2046         v-change-sign = -1
     2047       .
     2048     end.
     2049     assign
     2050       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2051     .
     2052     if p-change-value = 0
     2053     then do:
     2054       run diasize_position-resize-button in this-procedure .
     2055       return .
     2056     end.
     2057     move_block:
     2058     do
     2059     on error undo move_block, leave move_block
     2060     :
     2061       if retry
     2062       then do:
     2063         do
     2064         on error undo move_block, leave move_block
     2065         :
     2066           if p-change-value > 0
     2067           then do:
     2068             for each buf_temp-diasize-handle
     2069             on error undo, next
     2070             :
     2071               assign
     2072                 v-object-handle = buf_temp-diasize-handle.handle-value
     2073               .
     2074               if v-object-handle <> v-diasize-resize-button
     2075               then do:
     2076                 assign
     2077                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2078                 .
     2079               end.
     2080             end.
     2081             assign
     2082               v-diasize-browse-handle :width = v-browse-width
     2083             .
     2084             for each buf_temp-browse-handle
     2085               where buf_temp-browse-handle.browse-type = 'width':u
     2086             on error undo, next
     2087             :
     2088               assign
     2089                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2090               .
     2091             end.
     2092             assign
     2093               frame Dialog-Frame :width = v-frame-width
     2094             .
     2095             if frame Dialog-Frame :scrollable = true
     2096             then do:
     2097               assign
     2098                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2099               .
     2100             end.
     2101             run diasize_position-resize-button in this-procedure .
     2102           end.
     2103           else do:
     2104             if frame Dialog-Frame :scrollable = true
     2105             then do:
     2106               assign
     2107                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2108               .
     2109             end.
     2110             assign
     2111               frame Dialog-Frame :width = v-frame-width
     2112             .
     2113             for each buf_temp-browse-handle
     2114               where buf_temp-browse-handle.browse-type = 'width':u
     2115             on error undo, next
     2116             :
     2117               assign
     2118                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2119               .
     2120             end.
     2121             assign
     2122               v-diasize-browse-handle :width = v-browse-width
     2123             .
     2124             for each buf_temp-diasize-handle
     2125             on error undo, next
     2126             :
     2127               assign
     2128                 v-object-handle = buf_temp-diasize-handle.handle-value
     2129               .
     2130               if v-object-handle <> v-diasize-resize-button
     2131               then do:
     2132                 assign
     2133                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2134                 .
     2135               end.
     2136             end.
     2137             run diasize_position-resize-button in this-procedure .
     2138           end.
     2139           assign
     2140             v-diasize-change-size = false
     2141           .
     2142           leave move_block .
     2143         end.
     2144       end.
     2145       assign
     2146         v-diasize-need-full-display = true
     2147       .
     2148       if v-diasize-change-size = false
     2149       then do:
     2150         assign
     2151           v-diasize-change-size = true
     2152         .
     2153       end.
     2154       else do:
     2155         return .
     2156       end.
     2157       assign
     2158         v-frame-width = frame Dialog-Frame :width
     2159         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2160         v-browse-width = v-diasize-browse-handle :width
     2161       .
     2162       for each buf_temp-browse-handle
     2163         where buf_temp-browse-handle.browse-type = 'width':u
     2164       :
     2165         assign
     2166           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2167         .
     2168       end.
     2169       for each buf_temp-diasize-handle
     2170       :
     2171         delete buf_temp-diasize-handle .
     2172       end.
     2173       assign
     2174         v-field-group-handle = frame Dialog-Frame :first-child
     2175       .
     2176       do while valid-handle(v-field-group-handle)
     2177       :
     2178         assign
     2179           v-object-handle = v-field-group-handle :first-child
     2180         .
     2181         do while valid-handle(v-object-handle)
     2182         :
     2183           if  v-object-handle <> v-diasize-browse-handle :handle
     2184           and v-object-handle <> v-diasize-resize-button
     2185           and can-query(v-object-handle, "row")
     2186           and can-query(v-object-handle, "height")
     2187           and ( v-object-handle :col + v-object-handle :width
     2188                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2189               )
     2190           then do:
     2191             find first buf_temp-browse-handle
     2192               where buf_temp-browse-handle.browse-type   = 'width':u
     2193                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2194               no-error .
     2195             if available buf_temp-browse-handle
     2196             then do:
     2197             end.
     2198             else do:
     2199               create buf_temp-diasize-handle .
     2200               assign
     2201                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2202                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2203               .
     2204             end.
     2205           end.
     2206           assign
     2207             v-object-handle = v-object-handle :next-sibling
     2208           .
     2209         end.
     2210         assign
     2211           v-field-group-handle = v-field-group-handle :next-sibling
     2212         .
     2213       end.
     2214       do with frame Dialog-Frame
     2215       :
     2216         hide v-diasize-resize-button .
     2217         v-diasize-resize-button :row = 1.
     2218         v-diasize-resize-button :column = 1.
     2219       end.
     2220       if p-change-value > 0
     2221       then do:
     2222         if frame Dialog-Frame :scrollable = true
     2223         then do:
     2224           assign
     2225             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2226             no-error .
     2227           if error-status :error
     2228           or error-status :get-message(1) <> ""
     2229           then do:
     2230             undo move_block, retry move_block.
     2231           end.
     2232         end.
     2233         assign
     2234           frame Dialog-Frame :width = v-frame-width + p-change-value
     2235           no-error .
     2236         if error-status :error
     2237         or error-status :get-message(1) <> ""
     2238         then do:
     2239           undo move_block, retry move_block.
     2240         end.
     2241         assign
     2242           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2243         no-error .
     2244         if error-status :error
     2245         or error-status :get-message(1) <> ""
     2246         then do:
     2247           undo move_block, retry move_block.
     2248         end.
     2249         for each buf_temp-browse-handle
     2250           where buf_temp-browse-handle.browse-type = 'width':u
     2251         on error undo move_block, retry move_block
     2252         :
     2253           assign
     2254             buf_temp-browse-handle.browse-handle :width
     2255               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2256             no-error .
     2257           if error-status :error
     2258           or error-status :get-message(1) <> ""
     2259           then do:
     2260             undo move_block, retry move_block .
     2261           end.
     2262         end.
     2263         for each buf_temp-diasize-handle
     2264         on error undo move_block, retry move_block
     2265         :
     2266           assign
     2267             v-object-handle = buf_temp-diasize-handle.handle-value
     2268           .
     2269           if v-object-handle <> v-diasize-resize-button
     2270           then do:
     2271             assign
     2272               v-object-handle :col = v-object-handle :col + p-change-value
     2273               no-error .
     2274             if error-status :error
     2275             or error-status :get-message(1) <> ""
     2276             then do:
     2277               undo move_block, retry move_block .
     2278             end.
     2279           end.
     2280         end.
     2281       end.
     2282       else do:
     2283         for each buf_temp-diasize-handle
     2284         on error undo move_block, retry move_block
     2285         :
     2286           assign
     2287             v-object-handle = buf_temp-diasize-handle.handle-value
     2288           .
     2289           if v-object-handle <> v-diasize-resize-button
     2290           then do:
     2291             assign
     2292               v-object-handle :col = v-object-handle :col + p-change-value
     2293               no-error .
     2294             if error-status :error
     2295             or error-status :get-message(1) <> ""
     2296             then do:
     2297               undo move_block, retry move_block .
     2298             end.
     2299           end.
     2300         end.
     2301         for each buf_temp-browse-handle
     2302           where buf_temp-browse-handle.browse-type = 'width':u
     2303         on error undo move_block, retry move_block
     2304         :
     2305           assign
     2306             buf_temp-browse-handle.browse-handle :width
     2307               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2308             no-error .
     2309           if error-status :error
     2310           or error-status :get-message(1) <> ""
     2311           then do:
     2312             undo move_block, retry move_block .
     2313           end.
     2314         end.
     2315         assign
     2316           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2317           no-error .
     2318         if error-status :error
     2319         or error-status :get-message(1) <> ""
     2320         then do:
     2321           undo move_block, retry move_block.
     2322         end.
     2323         assign
     2324           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2325         no-error .
     2326         if error-status :error
     2327         or error-status :get-message(1) <> ""
     2328         then do:
     2329           undo move_block, retry move_block.
     2330         end.
     2331         if frame Dialog-Frame :scrollable = true
     2332         then do:
     2333           assign
     2334             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2335           no-error .
     2336           if error-status :error
     2337           or error-status :get-message(1) <> ""
     2338           then do:
     2339             undo move_block, retry move_block.
     2340           end.
     2341         end.
     2342       end.
     2343       if p-move-resize
     2344       then do:
     2345         run diasize_position-resize-button in this-procedure .
     2346       end.
     2347       if v-diasize-wndstore = true
     2348       then do:
     2349         if connected("ub") = true
     2350         then do:
     2351           define variable v-cntxt-db-num        as integer   no-undo .
     2352           define variable v-cntxt-userid        as character no-undo .
     2353           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2354                                             , OUTPUT v-cntxt-userid
     2355                                             ) .
     2356           run gbl/wndsizew.p
     2357             (input  v-cntxt-db-num
     2358             ,input  v-cntxt-userid
     2359             ,input  v-diasize-proc-name
     2360             ,input  'width':u
     2361             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2362             ) .
     2363         end.
     2364       end.
     2365     end.
     2366     assign
     2367       v-diasize-change-size = false
     2368     .
     2369   end procedure.
     2370   procedure diasize_set-width :
     2371     define input  parameter p-new-width  as decimal   no-undo .
     2372     define input  parameter p-move-resize as logical   no-undo .
     2373     do
     2374     on error undo, return error return-value
     2375     :
     2376       run diasize_change-width in this-procedure
     2377         (input  (p-new-width - frame Dialog-Frame :width)
     2378         ,input  p-move-resize
     2379         ) .
     2380     end.
     2381   end procedure.
     2382   procedure diasize_position-resize-button :
     2383     do with frame Dialog-Frame
     2384     :
     2385       hide v-diasize-resize-button .
     2386       assign
     2387         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2388                     - 1
     2389                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2390         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2391                     - 1
     2392                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2393       .
     2394       view v-diasize-resize-button .
     2395     end.
     2396   end procedure.
     2397   on alt-right anywhere
     2398   do:
     2399     run diasize_change-width in this-procedure
     2400       (input 1
     2401       ,input true
     2402       ) .
     2403     return no-apply .
     2404   end.
     2405   on alt-left anywhere
     2406   do:
     2407     run diasize_change-width in this-procedure
     2408       (input -1
     2409       ,input true
     2410       ) .
     2411     return no-apply .
     2412   end.
     2413   on alt-down anywhere
     2414   do:
     2415     run diasize_change-height in this-procedure
     2416       (input 1
     2417       ,input true
     2418       ) .
     2419     return no-apply .
     2420   end.
     2421   on alt-up anywhere
     2422   do:
     2423     run diasize_change-height in this-procedure
     2424       (input -1
     2425       ,input true
     2426       ) .
     2427     return no-apply .
     2428   end.
     2429   on alt-enter of frame Dialog-Frame
     2430   do:
     2431     run diasize_maximize in this-procedure
     2432       (input  ?
     2433       ).
     2434     return no-apply .
     2435   end.
     2436   procedure diasize_end-move :
     2437     do
     2438     on error undo, return error return-value
     2439     :
     2440       define variable v-row-delta as decimal   no-undo .
     2441       define variable v-col-delta as decimal   no-undo .
     2442       define variable v-new-row as decimal   no-undo .
     2443       define variable v-new-col as decimal   no-undo .
     2444       assign
     2445         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2446         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2447       .
     2448       assign
     2449         v-row-delta = v-new-row - frame Dialog-Frame :height
     2450         v-col-delta = v-new-col - frame Dialog-Frame :width
     2451       .
     2452       run diasize_change-height in this-procedure
     2453         (input v-row-delta
     2454         ,input true
     2455         ) .
     2456       run diasize_change-width in this-procedure
     2457         (input v-col-delta
     2458         ,input true
     2459         ) .
     2460     end.
     2461   end procedure.
     2462   procedure diasize_maximize :
     2463     define input  parameter p-action as logical   no-undo .
     2464     do
     2465     on error undo, return error return-value
     2466     :
     2467       if p-action = ?
     2468       then do:
     2469         if v-diasize-need-maximize = true
     2470         then do:
     2471           assign
     2472             p-action = true
     2473           .
     2474         end.
     2475         else do:
     2476           assign
     2477             p-action = false
     2478           .
     2479         end.
     2480       end.
     2481       if p-action = true
     2482       then do:
     2483         run diasize_change-height in this-procedure
     2484           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2485               - frame Dialog-Frame :height-chars
     2486           ,input true
     2487           ) .
     2488         run diasize_change-width in this-procedure
     2489           (input session :width-chars
     2490               - frame Dialog-Frame :width-chars
     2491           ,input true
     2492           ) .
     2493         assign
     2494           v-diasize-need-maximize = false
     2495         .
     2496       end.
     2497       else do:
     2498         run diasize_change-width in this-procedure
     2499           (input v-diasize-orig-frame-width
     2500               - frame Dialog-Frame :width-chars
     2501           ,input true
     2502           ) .
     2503         run diasize_change-height in this-procedure
     2504           (input v-diasize-orig-frame-height
     2505               - frame Dialog-Frame :height-chars
     2506           ,input true
     2507           ) .
     2508         assign
     2509           v-diasize-need-maximize = true
     2510         .
     2511       end.
     2512     end.
     2513   end procedure.
     2514   procedure diasize_restore-orig-size :
     2515     do
     2516     on error undo, return error return-value
     2517     :
     2518       assign
     2519         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2520         v-diasize-current-frame-height = frame Dialog-Frame :height
     2521       .
     2522       run diasize_set-height in this-procedure
     2523         (input  v-diasize-orig-frame-height
     2524         ,input  true
     2525         ) .
     2526       run diasize_set-width in this-procedure
     2527         (input  v-diasize-orig-frame-width
     2528         ,input  true
     2529         ) .
     2530     end.
     2531   end procedure.
     2532   procedure diasize_restore-current-size :
     2533     do
     2534     on error undo, return error return-value
     2535     :
     2536       run diasize_set-height in this-procedure
     2537         (input  v-diasize-current-frame-height
     2538         ,input  true
     2539         ) .
     2540       run diasize_set-width in this-procedure
     2541         (input  v-diasize-current-frame-width
     2542         ,input  true
     2543         ) .
     2544     end.
     2545   end procedure.
     2546   procedure diasize_set-browse-handle :
     2547     define input  parameter p-browse-handle as handle   no-undo .
     2548     define buffer buf_temp-browse-handle for temp-browse-handle .
     2549     do
     2550     on error undo, return error return-value
     2551     :
     2552       assign
     2553         v-diasize-browse-handle = p-browse-handle
     2554       .
     2555       for each buf_temp-browse-handle
     2556       on error undo, return error return-value
     2557       :
     2558         delete buf_temp-browse-handle .
     2559       end.
     2560     end.
     2561   end procedure.
     2562   procedure diasize_add_browse :
     2563     define input  parameter p-browse-type   as character no-undo .
     2564     define input  parameter p-browse-handle as handle    no-undo .
     2565     define buffer buf_temp-browse-handle for temp-browse-handle .
     2566     do
     2567     on error undo, return error return-value
     2568     :
     2569       assign
     2570         v-diasize-browse-number = v-diasize-browse-number + 1
     2571       .
     2572       create buf_temp-browse-handle .
     2573       assign
     2574         buf_temp-browse-handle.browse-type   = p-browse-type
     2575         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2576         buf_temp-browse-handle.browse-handle = p-browse-handle
     2577       .
     2578     end.
     2579   end procedure.
     2580   procedure diasize_init :
     2581     define variable v-default-value    as logical   no-undo .
     2582     define variable v-restore-saved    as logical   no-undo .
     2583     define variable v-resize-value-str as character no-undo .
     2584     do
     2585     on error undo, return error return-value
     2586     :
     2587       do with frame Dialog-Frame
     2588       :
     2589         assign
     2590           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2591           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2592           v-diasize-browse-handle     = browse BR-wthpl :handle
     2593         .
     2594         create button v-diasize-resize-button
     2595         assign
     2596           parent        = frame Dialog-Frame :first-child
     2597           label         = "s"
     2598           height-pixels = 16
     2599           width-pixels  = 16
     2600           visible       = true
     2601           sensitive     = true
     2602           movable       = true
     2603           triggers:
     2604             on end-move persistent run diasize_end-move in this-procedure .
     2605           end triggers.
     2606         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2607         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2608         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2609         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2610         assign
     2611           v-diasize-wndmax = false
     2612         .
     2613         if connected("ub") = true
     2614         then do:
     2615           define variable v-cntxt-db-num        as integer   no-undo .
     2616           define variable v-cntxt-userid        as character no-undo .
     2617           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2618                                             , OUTPUT v-cntxt-userid
     2619                                             ) .
     2620           run gbl/wndpar_r.p
     2621             (input  v-cntxt-db-num
     2622             ,input  v-cntxt-userid
     2623             ,input  'wndmax':U
     2624             ,output v-diasize-wndmax
     2625             ,output v-default-value
     2626             ) .
     2627         end.
     2628         assign
     2629           v-diasize-wndstore = false
     2630         .
     2631         if connected("ub") = true
     2632         then do:
     2633           run gbl/wndpar_r.p
     2634             (input  v-cntxt-db-num
     2635             ,input  v-cntxt-userid
     2636             ,input  'wndstore':U
     2637             ,output v-diasize-wndstore
     2638             ,output v-default-value
     2639             ) .
     2640         end.
     2641         assign
     2642           v-diasize-proc-name = entry(1, program-name(2), '.')
     2643         .
     2644         if v-diasize-wndstore = true
     2645         then do:
     2646           assign
     2647             v-restore-saved = false
     2648           .
     2649           if connected("ub") = true
     2650           then do:
     2651             run gbl/wndsizer.p
     2652               (input  v-cntxt-db-num
     2653               ,input  v-cntxt-userid
     2654               ,input  v-diasize-proc-name
     2655               ,input  'height':u
     2656               ,output v-resize-value-str
     2657               ) .
     2658             if v-resize-value-str <> '':U
     2659             then do:
     2660               run diasize_change-height in this-procedure
     2661                 (input  integer(v-resize-value-str)
     2662                 ,input  true
     2663                 ) .
     2664               assign
     2665                 v-restore-saved = true
     2666               .
     2667             end.
     2668           end.
     2669           if connected("ub") = true
     2670           then do:
     2671             run gbl/wndsizer.p
     2672               (input  v-cntxt-db-num
     2673               ,input  v-cntxt-userid
     2674               ,input  v-diasize-proc-name
     2675               ,input  'width':u
     2676               ,output v-resize-value-str
     2677               ) .
     2678             if v-resize-value-str <> '':U
     2679             then do:
     2680               run diasize_change-width in this-procedure
     2681                 (input  integer(v-resize-value-str)
     2682                 ,input  true
     2683                 ) .
     2684               assign
     2685                 v-restore-saved = true
     2686               .
     2687             end.
     2688           end.
     2689           if v-restore-saved <> true
     2690           then do:
     2691             if v-diasize-wndmax = true
     2692             then do:
     2693               run diasize_maximize in this-procedure
     2694                 (input  true
     2695                 ) .
     2696             end.
     2697           end.
     2698         end.
     2699         else do:
     2700           if v-diasize-wndmax = true
     2701           then do:
     2702             run diasize_maximize in this-procedure
     2703               (input  true
     2704               ) .
     2705           end.
     2706         end.
     2707       end.
     2708     end.
     2709   end procedure.
     2710   procedure diasize_need-full-display :
     2711     define output parameter p-need-full-display as logical   no-undo .
     2712     do
     2713     on error undo, return error return-value
     2714     :
     2715       assign
     2716         p-need-full-display = v-diasize-need-full-display
     2717       .
     2718       assign
     2719         v-diasize-need-full-display = false
     2720       .
     2721     end.
     2722   end procedure.
     2723   procedure get-context :
     2724      define output parameter p-db-num as integer          no-undo.
     2725      define output parameter p-user-id as character        no-undo.
     2726      define variable v-login               as character    no-undo.
     2727      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2728      define buffer buf_user-login  for ub.user-login .
     2729      do
     2730      on error undo, return error
     2731      :
     2732            FIND FIRST buf_sys-ctrl no-lock.
     2733            ASSIGN
     2734               v-login = USERID("ub")
     2735               p-db-num = buf_sys-ctrl.db-num
     2736            .
     2737            FIND FIRST buf_user-login
     2738                 WHERE buf_user-login.db-num = p-db-num
     2739                   AND buf_user-login.user-login = v-login
     2740                 no-lock
     2741                 no-error
     2742                 .
     2743            IF AVAILABLE buf_user-login
     2744            THEN DO:
     2745               assign
     2746                  p-user-id = buf_user-login.user-id
     2747               .
     2748            END.
     2749      end.
     2750   end procedure.
     2751       run diasize_init in this-procedure .
     2752   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2753   procedure set-filter-name :
     2754   define input parameter p-filter-name as character no-undo .
     2755     do with frame Dialog-Frame:
