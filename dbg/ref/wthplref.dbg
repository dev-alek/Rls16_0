      367   define  stream PrnLibStream.
      368   procedure prn-lib-prn-file :
      369     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      370     define input parameter p-DIsabledoptions as integer no-undo .
      371     define variable v-report-name as character no-undo .
      372     define variable v-user-action as character no-undo .
      373     define variable v-printed     as logical   no-undo .
      374     define variable v-exist       as logical   no-undo .
      375     do
      376       on error undo, return error
      377       :
      378       run prn-lib-get-report-name  in this-procedure (
      379         input parParentProc
      380         ,output v-report-name
      381         ).
      382   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      383   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      384     (input  v-report-name
      385     ,input  2
      386     ,output v-exist
      387     )  .
      388       if NOT v-exist then
      389       DO:
      390         Message
      391           "Нет заданий на печать ! "
      392           view-as alert-box .
      393         Return  .
      394       End.
      395       run gbl/prnfilen.w
      396         (input  ""
      397         ,input  p-DisabledOptions
      398         ,input  string(v-report-name )
      399         ,input  7
      400         ,output v-user-action
      401         ,output v-printed
      402         ) .
      403       if v-printed then
      404       do:
      405         return "YES" .
      406       end.
      407       else
      408       do:
      409         return "NO" .
      410       end.
      411     end.
      412   end procedure.
      413   procedure prn-lib-open-stream :
      414     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      415     define input parameter p-page-size    as integer no-undo .
      416     define input parameter p-is-stream    as logical no-undo .
      417     define input parameter p-append       as logical no-undo .
      418     define variable v-report-name as character no-undo .
      419     do
      420       on error undo, return error
      421       :
      422       run prn-lib-get-report-name  in this-procedure (
      423         input parParentProc
      424         ,output v-report-name
      425         ).
      426       if p-is-stream then
      427       do:
      428         if p-append then
      429         do:
      430           output stream PrnLibStream to value( v-report-name )
      431             page-size value(p-page-size) append .
      432         end.
      433         if not p-append then
      434         do:
      435           output stream PrnLibStream to value( v-report-name )
      436             page-size value(p-page-size) .
      437         end.
      438       end.
      439       if not p-is-stream then
      440       do:
      441         if p-append then
      442         do:
      443           output to value( v-report-name )
      444             page-size value(p-page-size) append .
      445         end.
      446         if not p-append then
      447         do:
      448           output to value( v-report-name )
      449             page-size value(p-page-size) .
      450         end.
      451       end.
      452     end.
      453   end procedure.
      454   procedure prn-lib-open-exp :
      455     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      456     define input parameter p-is-stream    as logical no-undo .
      457     define input parameter p-is-append    as logical no-undo .
      458     define output parameter p-ReportFileName as char init "report" no-undo.
      459     define output parameter p-process as logical no-undo .
      460     define variable glog as logical no-undo .
      461     do
      462       on error undo, return error
      463       :
      464       SYSTEM-DIALOG GET-FILE p-ReportFileName
      465         TITLE      "Укажите путь"
      466         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      467         ASK-OVERWRITE
      468         CREATE-TEST-FILE
      469         SAVE-AS
      470         USE-FILENAME
      471         DEFAULT-EXTENSION "txt"
      472         UPDATE glog
      473         .
      474       if not glog then  return.
      475       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      476       if p-is-stream then
      477       do:
      478         if p-is-append then
      479         do:
      480           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      481         end.
      482         else
      483         do:
      484           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      485         end.
      486       end.
      487       else
      488       do:
      489         if p-is-append then
      490         do:
      491           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      492         end.
      493         else
      494         do:
      495           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      496         end.
      497       end.
      498       p-process = yes.
      499     end.
      500   end procedure.
      501   procedure prn-lib-get-report-name :
      502     define input parameter parParentProc  as widget-handle no-undo.
      503     define output parameter p-report-name as character no-undo .
      504     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      505   end procedure.
      506   procedure prn-lib-reportviewer-report-name :
      507     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      508     define input parameter p-report-name-html as character no-undo .
      509     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      510   end procedure.
      511   procedure prn-lib-reportviewer :
      512     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      513     define input parameter p-report-name-html as character no-undo .
      514     define input parameter p-param        as character no-undo .
      515     define variable v-excel           as character no-undo init 'TRUE' .
      516     define variable v-value-character as character no-undo .
      517     define variable v-value-integer   as character no-undo .
      518     define variable v-value-date      as date      no-undo .
      519     define variable v-value-decimal   as decimal   no-undo .
      520     define variable rep-excel         as logical   no-undo .
      521     define variable excel-string      as character no-undo .
      522     define variable v-param-type      as character no-undo .
      523     define variable v-tth             as handle    no-undo .
      524     run adm/shattri.p (
      525       input "get":U
      526       ,input  ""
      527       ,input  0
      528       ,input  'report-glob':U
      529       ,input  'rep-excel':U
      530       ,output v-value-character
      531       ,output v-value-date
      532       ,output v-value-decimal
      533       ,output v-value-integer
      534       ,output rep-excel
      535       ,output v-param-type
      536       ,INPUT-OUTPUT table-handle v-tth
      537       )  .
      538     if rep-excel then v-excel = "TRUE" .
      539     else v-excel = "FALSE" .
      540     if p-param eq ""
      541     then
      542        p-param = "EXCEL:" + v-excel.
      543     else
      544        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      545     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      546   end procedure.
      547   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      548   procedure wth-lib_cur-stock-place:
      549   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      550   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      551   define input  parameter parw-p-code like ub.wth-pobj.w-p-code  no-undo.
      552   define input  parameter parwth-code like ub.wth-pobj.wth-code  no-undo.
      553   define output parameter parstock    like ub.wth-pobj.income-pl no-undo.
      554   define buffer bf_wth-pobj for ub.wth-pobj.
      555   find first bf_wth-pobj where bf_wth-pobj.obj-type = parobj-type and
      556                                bf_wth-pobj.obj-code = parobj-code and
      557                                bf_wth-pobj.w-p-code = parw-p-code and
      558                                bf_wth-pobj.wth-code = parwth-code no-lock no-error.
      559   if available bf_wth-pobj then assign parstock = bf_wth-pobj.income-pl - bf_wth-pobj.incass-pl.
      560                            else assign parstock = 0.
      561   end procedure.
      562   procedure wth-lib_cur-stock-obj:
      563   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      564   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      565   define input  parameter parwth-code like ub.wth-obj.wth-code   no-undo.
      566   define output parameter parstock    like ub.wth-obj.income     no-undo.
      567   define buffer bf_wth-obj for ub.wth-obj.
      568   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      569                               bf_wth-obj.obj-code = parobj-code and
      570                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      571   if available bf_wth-obj then assign parstock = bf_wth-obj.income - bf_wth-obj.incass.
      572                           else assign parstock = 0.
      573   end.
      574   FUNCTION wth-lib_cur-stock-obj-func RETURNS DECIMAL (INPUT parobj-type AS CHARACTER,
      575                                                        INPUT parobj-code AS INTEGER,
      576                                                        INPUT parwth-code AS INTEGER):
      577   define buffer bf_wth-obj for ub.wth-obj.
      578   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      579                               bf_wth-obj.obj-code = parobj-code and
      580                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      581   if available bf_wth-obj then return (bf_wth-obj.income - bf_wth-obj.incass).
      582                           else return 0.00.
      583   end function.
      584   FUNCTION wth-lib_cur-stock-host-func RETURNS DECIMAL (INPUT parhost-code AS INTEGER,
      585                                                         INPUT parwth-code  AS INTEGER):
      586   define buffer bf_wth-obj for ub.wth-obj.
      587   define variable v-stock like ub.wth-obj.income no-undo.
      588   for each bf_wth-obj no-lock where bf_wth-obj.host-code = parhost-code and
      589                                     bf_wth-obj.wth-code = parwth-code :
      590     v-stock = v-stock +  bf_wth-obj.income - bf_wth-obj.incass.
      591   end.
      592   return v-stock.
      593   end function.
      594   procedure wth-lib_full-inf-shift:
      595   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.shift-date = parshift-date and                        cur_wth-line.shift-num  = parshift-num  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-sdn no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                (start_wth-line.shift-date = parshift-date and                           start_wth-line.shift-num  < parshift-num  or                            start_wth-line.shift-date < parshift-date ) and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-sdn no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      596   end procedure.
