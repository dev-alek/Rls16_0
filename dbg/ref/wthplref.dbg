     1116   FUNCTION get-all-on-place RETURNS DECIMAL
     1117     ( buffer loc-wth-place for ub.wth-place)  FORWARD.
     1118   DEFINE BUTTON B-add
     1119        LABEL "&Добавить"
     1120        SIZE 10 BY 1.
     1121   DEFINE BUTTON B-chg
     1122        LABEL "&Изменить"
     1123        SIZE 10 BY 1.
     1124   DEFINE BUTTON B-del
     1125        LABEL "&Удалить"
     1126        SIZE 10 BY 1.
     1127   DEFINE BUTTON B-Help
     1128        LABEL "Помо&щь"
     1129        SIZE 3 BY 1
     1130        BGCOLOR 8 .
     1131   DEFINE BUTTON B-hist
     1132        LABEL "Ис&тория"
     1133        SIZE 3 BY 1.
     1134   DEFINE BUTTON B-mark
     1135        LABEL "&*"
     1136        SIZE 3 BY 1.
     1137   DEFINE BUTTON B-print
     1138        LABEL "Пе&чать"
     1139        SIZE 3 BY 1.
     1140   DEFINE BUTTON b-quit AUTO-END-KEY
     1141        LABEL "&Выход"
     1142        SIZE 10 BY 1
     1143        BGCOLOR 8 .
     1144   DEFINE BUTTON B-sch
     1145        LABEL "&Фильтр"
     1146        SIZE 3 BY 1.
     1147   DEFINE BUTTON B-sel AUTO-GO
     1148        LABEL "Вы&бор"
     1149        SIZE 10 BY 1.
     1150   DEFINE BUTTON B-wthparts
     1151        LABEL "&Партии"
     1152        SIZE 10 BY 1 TOOLTIP "Партии серийных МЦ".
     1153   DEFINE BUTTON B-wthpobj
     1154        LABEL "&Остатки"
     1155        SIZE 10 BY 1.
     1156   DEFINE VARIABLE E-PS AS CHARACTER
     1157        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1158        SIZE 97.13 BY 2.88 NO-UNDO.
     1159   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1160         VIEW-AS TEXT
     1161        SIZE 4.25 BY 1
     1162        FGCOLOR 4  NO-UNDO.
     1163   DEFINE QUERY BR-wthpl FOR
     1164         X_wth-place SCROLLING.
     1165   DEFINE BROWSE BR-wthpl
     1166     QUERY BR-wthpl DISPLAY
     1167         mark-string(recid(X_wth-place), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1168   X_wth-place.w-p-code FORMAT ">>>>>>>>9":U
     1169   X_wth-place.w-p-name COLUMN-LABEL "Название" FORMAT "X(21)":U
     1170   X_wth-place.status_ COLUMN-LABEL "Статус" FORMAT "X(10)":U
     1171   X_wth-place.obj-type FORMAT "X(3)":U
     1172   X_wth-place.obj-code FORMAT "999999999":U
     1173   X_wth-place.host-code COLUMN-LABEL "Фирма" FORMAT "999999999":U
     1174   X_wth-place.main-cash-desk COLUMN-LABEL "Гл.!касса" FORMAT "+/":U
     1175   X_wth-place.cash-desk COLUMN-LABEL "Номер!кассы" FORMAT ">>>9":U
     1176   get-all-on-place(buffer X_wth-place) COLUMN-LABEL "Всего на месте!МЦ, имеющих!ден.эквив.!на сумму" FORMAT "->>>,>>>,>>9.99":U
     1177       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.38 BY 16.
     1178   DEFINE FRAME Dialog-Frame
     1179        b-quit AT ROW 1 COL 1
     1180        B-mark AT ROW 1 COL 16
     1181        B-sel AT ROW 1 COL 19
     1182        B-add AT ROW 1 COL 29
     1183        B-chg AT ROW 1 COL 39
     1184        B-del AT ROW 1 COL 49
     1185        B-wthpobj AT ROW 1 COL 59
     1186        B-wthparts AT ROW 1 COL 69 WIDGET-ID 2
     1187        B-print AT ROW 1 COL 86
     1188        B-hist AT ROW 1 COL 89
     1189        B-sch AT ROW 1 COL 92
     1190        B-Help AT ROW 1 COL 95
     1191        BR-wthpl AT ROW 2.5 COL 1.13
     1192        E-PS AT ROW 18.92 COL 1.38 NO-LABEL
     1193        mark-num AT ROW 1 COL 11 NO-LABEL
     1194        SPACE(83.26) SKIP(20.07)
     1195       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1196            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1197            TITLE "Места хранения материальных ценностей"
     1198            CANCEL-BUTTON b-quit.
     1199   ASSIGN
     1200          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1201          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1202   ASSIGN
     1203          E-PS:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1204   ON GO OF FRAME Dialog-Frame
     1205   DO:
     1206     p-rid-list = v-rid-list.
     1207   END.
     1208   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1209   DO:
     1210     APPLY "END-ERROR":U TO SELF.
     1211   END.
     1212   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1213   DO:
     1214   define variable rep-rec as recid no-undo .
     1215   define variable glog as logical no-undo .
     1216   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1217   do:
     1218     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1219       (input  v-cntxt-db-num
     1220       ,input  v-cntxt-userid
     1221       ,input  0
     1222       ,input  'actn_wth-place-reference_work':U
     1223       ,input  'object':U
     1224       ,input  parhost-code
     1225       ,input  parobj-type
     1226       ,input  parobj-code
     1227       ,input  0
     1228       ,input  0
     1229       ,input  0
     1230       ,input  true
     1231       ,output glog
     1232       )  .
     1233   end.
     1234   if NOT glog then return no-apply.
     1235   rep-rec = ?.
     1236   run ref/wthplfrm.w (
     1237                      input parparentproc
     1238                    , input 'ДОБАВЛЕНИЕ':U
     1239                    , input parhost-code
     1240                    , input parobj-type
     1241                    , input parobj-code
     1242                    , input-output rep-rec).
     1243   if rep-rec <> ? then do:
     1244      v-doc-rec = rep-rec.
     1245      RUn OpenBr in this-procedure ( input yes, input no, input '':U).
     1246     apply "entry" to br-wthpl in frame Dialog-Frame.
     1247   end.
     1248   else do:
     1249     apply "entry" to br-wthpl in frame Dialog-Frame.
     1250     return no-apply.
     1251   end.
     1252   END.
     1253   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1254   DO:
     1255   define variable rep-rec as recid no-undo .
     1256   define variable glog as logical no-undo .
     1257       if not available X_wth-place then do:
     1258     message "Неправильно выбрана строка.".
     1259     return no-apply.
     1260   end.
     1261   rep-rec = recid ( X_wth-place).
     1262   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1263   do:
     1264     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1265       (input  v-cntxt-db-num
     1266       ,input  v-cntxt-userid
     1267       ,input  0
     1268       ,input  'actn_wth-place-reference_work':U
