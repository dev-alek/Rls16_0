     3260   PROCEDURE PrintProc :
     3261   define variable date_string     as      char    no-undo.
     3262   define variable Line                as      char    no-undo.
     3263   define variable for-time as char.
     3264   define variable var-on-obj as decimal no-undo.
     3265   DEFINE FRAME Wthpl-List
     3266   X_wth-place.w-p-code     column-label "Код места"
     3267   X_wth-place.w-p-name     column-label "Название"
     3268   X_wth-place.status_      column-label "Статус"
     3269   X_wth-place.obj-type     column-label "Объект"
     3270   X_wth-place.obj-code     column-label "Код!объекта"
     3271   X_wth-place.host-code    column-label "Код!фирмы"
     3272   var-on-obj             column-label "Всего на месте!MЦ, имеющих!ден.эквив.!на сумму" format "->>>,>>>,>>9.99"
     3273   HEADER  date_string AT 5 format "X(35)"
     3274   string( "Страница " ) format "X(9)" AT 100 PAGE-NUMBER(PrnLibStream) AT 110 FORMAT ">>9" SKIP
     3275   Line format "X(138)" AT 1
     3276   with width 160 down stream-io use-text    .
     3277   Line = fill("-", 90).
     3278   date_string = cur-time-print() .
     3279   run prn-lib-open-stream  in this-procedure (
     3280                                                input parParentProc
     3281                                               ,input 62
     3282                                               ,input yes
     3283                                               ,input no
     3284                                               ).
     3285       PUT  STREAM PrnLibStream
     3286       SPACE(25) ( frame Dialog-Frame:title )
     3287       format "x(90)" SKIP(1) .
     3288       FORM HEADER
     3289       Line AT 1 SKIP
     3290       "Продолжение - на следующей странице" AT 30 SKIP
     3291       with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
     3292       VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3293       FORM with FRAME Wthpl-List  .
     3294       run waitfram-show in this-procedure ("Ждите...").
     3295       GET next br-wthpl.
     3296        DO WHILE available X_wth-place :
     3297           var-on-obj = get-all-on-place(buffer X_wth-place).
     3298           Display STREAM PrnLibStream
     3299           X_wth-place.w-p-code
     3300           X_wth-place.w-p-name
     3301           X_wth-place.status_
     3302           X_wth-place.obj-type
     3303           X_wth-place.obj-code
     3304           X_wth-place.host-code
     3305           var-on-obj
     3306           with FRAME Wthpl-List .
     3307           DOWN STREAM PrnLibStream 1 with FRAME Wthpl-List  .
     3308           GET next br-wthpl.
     3309         END.
     3310         UNDERLINE  STREAM PrnLibStream
     3311           X_wth-place.w-p-code
     3312           X_wth-place.w-p-name
     3313           X_wth-place.status_
     3314           X_wth-place.obj-type
     3315           X_wth-place.obj-code
     3316           X_wth-place.host-code
     3317           var-on-obj
     3318           with FRAME Wthpl-List .
     3319       HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3320       HIDE  STREAM PrnLibStream FRAME CheckList.
     3321       output  STREAM PrnLibStream CLOSE.
     3322       run waitfram-hide in this-procedure .
     3323   run prn-lib-prn-file in this-procedure (
     3324                                             input parParentProc
     3325                                             ,input 0
     3326                                             ).
     3327   END PROCEDURE.
     3328   PROCEDURE proc-b-sch :
     3329   assign
     3330   tbl = 'wth-place'
     3331   join-tbl = 'X_wth-place'
     3332   fld = ""
     3333   lab = ""
     3334   spr = ""
     3335   dim = '0'
     3336   .
     3337   run fltfield-add in this-procedure('w-p-code', 'Код места хранения', '',
     3338   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3339   run fltfield-add in this-procedure('w-p-name', 'Название', '',
     3340   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3341   run fltfield-add in this-procedure('host-code', 'Код фирмы', '',
     3342   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3343   run fltfield-add in this-procedure('obj-code', 'Код объект', '',
     3344   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3345   run fltfield-add in this-procedure('obj-type', 'Тип объекта', '',
     3346   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3347   run fltfield-add in this-procedure('status_', 'Статус', '',
     3348   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3349   run fltfield-add in this-procedure('cash-desk', 'Номер кассы', '',
     3350   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3351   run fltfield-add in this-procedure('main-cash-desk', 'Главная касса', '',
     3352   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3353   run fltfield-add in this-procedure('PS', 'Примечание', '',
     3354   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3355       DO on stop undo, leave:
     3356           run gbl/filter.w ( input parparentproc
     3357                            , input (filter-point + chr(4) + filter-label)
     3358                            , input tbl
     3359                            , input join-tbl
     3360                            , input fld
     3361                            , input lab
     3362                            , input spr
     3363                            , input dim).
     3364           RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     3365       END .
     3366   END PROCEDURE.
     3367   FUNCTION get-all-on-place RETURNS DECIMAL
     3368     ( buffer loc-wth-place for ub.wth-place) :
     3369   def buffer loc-wealth for ub.wealth.
     3370   define variable parstock as decimal no-undo.
     3371   define variable varstock as decimal no-undo.
     3372   DEFINE VARIABLE v-today as date no-undo .
     3373   DEFINE VARIABLE v-time as integer no-undo .
     3374     FOR EACH ub.wth-pobj No-LOCK WHERE
     3375              ub.wth-pobj.obj-type = loc-wth-place.obj-type AND
     3376              ub.wth-pobj.obj-code = loc-wth-place.obj-code AND
     3377              ub.wth-pobj.w-p-code = loc-wth-place.w-p-code:
     3378       FIND FIRST loc-wealth No-LOCK WHERE
     3379                  loc-wealth.wth-code = ub.wth-pobj.wth-code No-ERROR.
     3380       if not avail loc-wealth then do:
     3381           parstock = ?.
     3382       end.
     3383       else do:
     3384           if loc-wealth.is-money then do:
     3385               RUN wth-lib_cur-stock-place(
     3386                                           input  loc-wth-place.obj-type,
     3387                                           input  loc-wth-place.obj-code,
     3388                                           input  loc-wth-place.w-p-code,
     3389                                           input  ub.wth-pobj.wth-code,
     3390                                           output parstock) no-error.
     3391               if error-status:error then do:
     3392                   parstock = ?.
     3393               end.
     3394               if loc-wealth.curr-code <> 0 then do:
     3395   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3396   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3397     (input  loc-wth-place.obj-type
     3398     ,input  loc-wth-place.obj-code
     3399     ,output v-today
     3400     )  .
     3401                   FIND FIRST ub.curr-bank NO-LOCK WHERE
     3402                             curr-bank.curr-code = loc-wealth.curr-code and
     3403                             curr-bank.exch-date <= v-today use-index i1 no-error .
     3404                   if avail curr-bank then
     3405                   parstock = parstock * curr-bank.exch-rate / exch-scale.
     3406                   else do:
     3407                       parstock = ?.
     3408                   end.
     3409               end.
     3410           end.
     3411           else parstock = 0.
     3412       end.
     3413       varstock = varstock + parstock.
     3414     END.
     3415     RETURN varstock.
     3416   END FUNCTION.
