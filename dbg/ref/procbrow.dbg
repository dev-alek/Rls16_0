        1   define temp-table procAsunc no-undo
        2       field procid            as character
        3       field procval           as character
        4       field procname          as character
        5       field proctyperun       as character
        6       index pi is primary unique
        7           procid
        8   .
        9   define temp-table procParam no-undo
       10       field procid                as character
       11       field paramName             as character
       12       field numparam              as integer
       13       field ParamValue            as character
       14       field ParamType             as character
       15       field ParamHiden            as logical
       16       index pi is primary unique
       17           procid numparam
       18   .
       19   define temp-table SesParam no-undo
       20       field parCheck          as logical
       21       field parCode           as character
       22       field parname           as character
       23       field parvalue          as character
       24       field parWaitFile       as character
       25       index pi is primary unique
       26           parCode
       27   .
       28   define dataset ds-asuncProc xml-node-name "root" for procAsunc, procParam  , SesParam
       29   data-relation  relver  for procAsunc, procParam relation-fields (procid,procid) nested.
       30   define buffer tt-proc for procAsunc.
       31   define input  parameter parparentproc as handle no-undo.
       32   define button b-edit
       33        label "Выполнить"
       34        size 15 by 1.13.
       35   define button b-exit AUTO-GO
       36        label "Выход"
       37        size 15 by 1.13.
       38   define query BROWSE-2 for
       39         tt-proc scrolling.
       40   define browse BROWSE-2
       41     query BROWSE-2 no-lock display
       42         tt-proc.procid column-label "Процедура" format "X(30)":U
       43         tt-proc.procname column-label "Наименование" format "X(60)":U
       44       WITH NO-ROW-MARKERS SEPARATORS SIZE 78.5 BY 14 FIT-LAST-COLUMN.
       45   define frame Dialog-Frame
       46        b-exit at row 1.25 col 3 widget-id 2
       47        b-edit at row 1.25 col 20 widget-id 4
       48        BROWSE-2 at row 2.5 col 1.5 widget-id 200
       49       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
       50            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
       51            TITLE "Процесы"
       52            DEFAULT-BUTTON b-exit  WIDGET-ID 100.
       53   ASSIGN
       54          FRAME Dialog-Frame:SCROLLABLE       = FALSE
       55          FRAME Dialog-Frame:HIDDEN           = TRUE.
       56   ON WINDOW-CLOSE OF FRAME Dialog-Frame
       57   DO:
       58     APPLY "END-ERROR":U TO SELF.
       59   END.
       60   on choose of b-edit in frame Dialog-Frame
       61     do:
       62       if available (tt-proc) then
       63       do:
       64          run ref\procfrm.w (parparentproc,tt-proc.procid,input dataset ds-asuncProc).
       65       end.
       66     end.
       67   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
       68   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
       69   define variable mfile as character no-undo.
       70   define variable v-md5-signature  as character no-undo.
       71   mfile = search("cmp/procasunc.xml").
       72   run gbl/md5.p (
       73          input  mfile
       74         ,output v-md5-signature
       75         ) .
       76   if "ipgldjbdKDdkWjtY13
       77    " ne encode(v-md5-signature + "sysadm" ) + string(index(encode(string(v-md5-signature)), "k"))
       78   then do:
       79      message substitute("Файл &1 имеет не правильную сигнатуру md5.", mfile)
       80      view-as alert-box.
       81      return error substitute("Файл &1 имеет не правильную сигнатуру md5.", mfile).
       82   end.
       83   MAIN-BLOCK:
       84   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
       85      on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
       86      dataset ds-asuncProc:read-xml ("file", mfile,"empty",?,?).
       87     run enable_UI.
       88     WAIT-FOR GO OF FRAME Dialog-Frame.
       89   end.
       90   RUN disable_UI.
       91   PROCEDURE disable_UI :
       92     HIDE FRAME Dialog-Frame.
       93   END PROCEDURE.
       94   PROCEDURE enable_UI :
       95     enable b-exit b-edit BROWSE-2
       96         WITH FRAME Dialog-Frame.
       97     VIEW FRAME Dialog-Frame.
       98     OPEN QUERY BROWSE-2 FOR EACH tt-proc NO-LOCK INDEXED-REPOSITION.
       99   END PROCEDURE.
