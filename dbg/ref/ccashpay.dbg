     2207     .
     2208   end procedure.
     2209   procedure diasize_set-width :
     2210     define input  parameter p-new-width  as decimal   no-undo .
     2211     define input  parameter p-move-resize as logical   no-undo .
     2212     do
     2213     on error undo, return error return-value
     2214     :
     2215       run diasize_change-width in this-procedure
     2216         (input  (p-new-width - frame Dialog-Frame :width)
     2217         ,input  p-move-resize
     2218         ) .
     2219     end.
     2220   end procedure.
     2221   procedure diasize_position-resize-button :
     2222     do with frame Dialog-Frame
     2223     :
     2224       hide v-diasize-resize-button .
     2225       assign
     2226         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2227                     - 1
     2228                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2229         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2230                     - 1
     2231                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2232       .
     2233       view v-diasize-resize-button .
     2234     end.
     2235   end procedure.
     2236   on alt-right anywhere
     2237   do:
     2238     run diasize_change-width in this-procedure
     2239       (input 1
     2240       ,input true
     2241       ) .
     2242     return no-apply .
     2243   end.
     2244   on alt-left anywhere
     2245   do:
     2246     run diasize_change-width in this-procedure
     2247       (input -1
     2248       ,input true
     2249       ) .
     2250     return no-apply .
     2251   end.
     2252   on alt-down anywhere
     2253   do:
     2254     run diasize_change-height in this-procedure
     2255       (input 1
     2256       ,input true
     2257       ) .
     2258     return no-apply .
     2259   end.
     2260   on alt-up anywhere
     2261   do:
     2262     run diasize_change-height in this-procedure
     2263       (input -1
     2264       ,input true
     2265       ) .
     2266     return no-apply .
     2267   end.
     2268   on alt-enter of frame Dialog-Frame
     2269   do:
     2270     run diasize_maximize in this-procedure
     2271       (input  ?
     2272       ).
     2273     return no-apply .
     2274   end.
     2275   procedure diasize_end-move :
     2276     do
     2277     on error undo, return error return-value
     2278     :
     2279       define variable v-row-delta as decimal   no-undo .
     2280       define variable v-col-delta as decimal   no-undo .
     2281       define variable v-new-row as decimal   no-undo .
     2282       define variable v-new-col as decimal   no-undo .
     2283       assign
     2284         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2285         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2286       .
     2287       assign
     2288         v-row-delta = v-new-row - frame Dialog-Frame :height
     2289         v-col-delta = v-new-col - frame Dialog-Frame :width
     2290       .
     2291       run diasize_change-height in this-procedure
     2292         (input v-row-delta
     2293         ,input true
     2294         ) .
     2295       run diasize_change-width in this-procedure
     2296         (input v-col-delta
     2297         ,input true
     2298         ) .
     2299     end.
     2300   end procedure.
     2301   procedure diasize_maximize :
     2302     define input  parameter p-action as logical   no-undo .
     2303     do
     2304     on error undo, return error return-value
     2305     :
     2306       if p-action = ?
     2307       then do:
     2308         if v-diasize-need-maximize = true
     2309         then do:
     2310           assign
     2311             p-action = true
     2312           .
     2313         end.
     2314         else do:
     2315           assign
     2316             p-action = false
     2317           .
     2318         end.
     2319       end.
     2320       if p-action = true
     2321       then do:
     2322         run diasize_change-height in this-procedure
     2323           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2324               - frame Dialog-Frame :height-chars
     2325           ,input true
     2326           ) .
     2327         run diasize_change-width in this-procedure
     2328           (input session :width-chars
     2329               - frame Dialog-Frame :width-chars
     2330           ,input true
     2331           ) .
     2332         assign
     2333           v-diasize-need-maximize = false
     2334         .
     2335       end.
     2336       else do:
     2337         run diasize_change-width in this-procedure
     2338           (input v-diasize-orig-frame-width
     2339               - frame Dialog-Frame :width-chars
     2340           ,input true
     2341           ) .
     2342         run diasize_change-height in this-procedure
     2343           (input v-diasize-orig-frame-height
     2344               - frame Dialog-Frame :height-chars
     2345           ,input true
     2346           ) .
     2347         assign
     2348           v-diasize-need-maximize = true
     2349         .
     2350       end.
     2351     end.
     2352   end procedure.
     2353   procedure diasize_restore-orig-size :
     2354     do
     2355     on error undo, return error return-value
     2356     :
     2357       assign
     2358         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2359         v-diasize-current-frame-height = frame Dialog-Frame :height
     2360       .
     2361       run diasize_set-height in this-procedure
     2362         (input  v-diasize-orig-frame-height
     2363         ,input  true
     2364         ) .
     2365       run diasize_set-width in this-procedure
     2366         (input  v-diasize-orig-frame-width
     2367         ,input  true
     2368         ) .
     2369     end.
     2370   end procedure.
     2371   procedure diasize_restore-current-size :
     2372     do
     2373     on error undo, return error return-value
     2374     :
     2375       run diasize_set-height in this-procedure
     2376         (input  v-diasize-current-frame-height
     2377         ,input  true
     2378         ) .
     2379       run diasize_set-width in this-procedure
     2380         (input  v-diasize-current-frame-width
     2381         ,input  true
     2382         ) .
     2383     end.
     2384   end procedure.
     2385   procedure diasize_set-browse-handle :
     2386     define input  parameter p-browse-handle as handle   no-undo .
     2387     define buffer buf_temp-browse-handle for temp-browse-handle .
     2388     do
     2389     on error undo, return error return-value
     2390     :
     2391       assign
     2392         v-diasize-browse-handle = p-browse-handle
     2393       .
     2394       for each buf_temp-browse-handle
     2395       on error undo, return error return-value
     2396       :
     2397         delete buf_temp-browse-handle .
     2398       end.
     2399     end.
     2400   end procedure.
     2401   procedure diasize_add_browse :
     2402     define input  parameter p-browse-type   as character no-undo .
     2403     define input  parameter p-browse-handle as handle    no-undo .
     2404     define buffer buf_temp-browse-handle for temp-browse-handle .
     2405     do
     2406     on error undo, return error return-value
     2407     :
     2408       assign
     2409         v-diasize-browse-number = v-diasize-browse-number + 1
     2410       .
     2411       create buf_temp-browse-handle .
     2412       assign
     2413         buf_temp-browse-handle.browse-type   = p-browse-type
     2414         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2415         buf_temp-browse-handle.browse-handle = p-browse-handle
     2416       .
     2417     end.
     2418   end procedure.
     2419   procedure diasize_init :
     2420     define variable v-default-value    as logical   no-undo .
     2421     define variable v-restore-saved    as logical   no-undo .
     2422     define variable v-resize-value-str as character no-undo .
     2423     do
     2424     on error undo, return error return-value
     2425     :
     2426       do with frame Dialog-Frame
     2427       :
     2428         assign
     2429           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2430           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2431           v-diasize-browse-handle     = browse br-c-cash-pay :handle
     2432         .
     2433         create button v-diasize-resize-button
     2434         assign
     2435           parent        = frame Dialog-Frame :first-child
     2436           label         = "s"
     2437           height-pixels = 16
     2438           width-pixels  = 16
     2439           visible       = true
     2440           sensitive     = true
     2441           movable       = true
     2442           triggers:
     2443             on end-move persistent run diasize_end-move in this-procedure .
     2444           end triggers.
     2445         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2446         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2447         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2448         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2449         assign
     2450           v-diasize-wndmax = false
     2451         .
     2452         if connected("ub") = true
     2453         then do:
     2454           define variable v-cntxt-db-num        as integer   no-undo .
     2455           define variable v-cntxt-userid        as character no-undo .
     2456           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2457                                             , OUTPUT v-cntxt-userid
     2458                                             ) .
     2459           run gbl/wndpar_r.p
     2460             (input  v-cntxt-db-num
     2461             ,input  v-cntxt-userid
     2462             ,input  'wndmax':U
     2463             ,output v-diasize-wndmax
     2464             ,output v-default-value
     2465             ) .
     2466         end.
     2467         assign
     2468           v-diasize-wndstore = false
     2469         .
     2470         if connected("ub") = true
     2471         then do:
     2472           run gbl/wndpar_r.p
     2473             (input  v-cntxt-db-num
     2474             ,input  v-cntxt-userid
     2475             ,input  'wndstore':U
     2476             ,output v-diasize-wndstore
     2477             ,output v-default-value
     2478             ) .
     2479         end.
     2480         assign
     2481           v-diasize-proc-name = entry(1, program-name(2), '.')
     2482         .
     2483         if v-diasize-wndstore = true
     2484         then do:
     2485           assign
     2486             v-restore-saved = false
     2487           .
     2488           if connected("ub") = true
     2489           then do:
     2490             run gbl/wndsizer.p
     2491               (input  v-cntxt-db-num
     2492               ,input  v-cntxt-userid
     2493               ,input  v-diasize-proc-name
     2494               ,input  'height':u
     2495               ,output v-resize-value-str
     2496               ) .
     2497             if v-resize-value-str <> '':U
     2498             then do:
     2499               run diasize_change-height in this-procedure
     2500                 (input  integer(v-resize-value-str)
     2501                 ,input  true
     2502                 ) .
     2503               assign
     2504                 v-restore-saved = true
     2505               .
     2506             end.
     2507           end.
     2508           if connected("ub") = true
     2509           then do:
     2510             run gbl/wndsizer.p
     2511               (input  v-cntxt-db-num
     2512               ,input  v-cntxt-userid
     2513               ,input  v-diasize-proc-name
     2514               ,input  'width':u
     2515               ,output v-resize-value-str
     2516               ) .
     2517             if v-resize-value-str <> '':U
     2518             then do:
     2519               run diasize_change-width in this-procedure
     2520                 (input  integer(v-resize-value-str)
     2521                 ,input  true
     2522                 ) .
     2523               assign
     2524                 v-restore-saved = true
     2525               .
     2526             end.
     2527           end.
     2528           if v-restore-saved <> true
     2529           then do:
     2530             if v-diasize-wndmax = true
     2531             then do:
     2532               run diasize_maximize in this-procedure
     2533                 (input  true
     2534                 ) .
     2535             end.
     2536           end.
     2537         end.
     2538         else do:
     2539           if v-diasize-wndmax = true
     2540           then do:
     2541             run diasize_maximize in this-procedure
     2542               (input  true
     2543               ) .
     2544           end.
     2545         end.
     2546       end.
     2547     end.
     2548   end procedure.
     2549   procedure diasize_need-full-display :
     2550     define output parameter p-need-full-display as logical   no-undo .
     2551     do
     2552     on error undo, return error return-value
     2553     :
     2554       assign
     2555         p-need-full-display = v-diasize-need-full-display
     2556       .
     2557       assign
     2558         v-diasize-need-full-display = false
     2559       .
     2560     end.
     2561   end procedure.
     2562   procedure get-context :
     2563      define output parameter p-db-num as integer          no-undo.
     2564      define output parameter p-user-id as character        no-undo.
     2565      define variable v-login               as character    no-undo.
     2566      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2567      define buffer buf_user-login  for ub.user-login .
     2568      do
     2569      on error undo, return error
     2570      :
     2571            FIND FIRST buf_sys-ctrl no-lock.
     2572            ASSIGN
     2573               v-login = USERID("ub")
     2574               p-db-num = buf_sys-ctrl.db-num
     2575            .
     2576            FIND FIRST buf_user-login
     2577                 WHERE buf_user-login.db-num = p-db-num
     2578                   AND buf_user-login.user-login = v-login
     2579                 no-lock
     2580                 no-error
     2581                 .
     2582            IF AVAILABLE buf_user-login
     2583            THEN DO:
     2584               assign
     2585                  p-user-id = buf_user-login.user-id
     2586               .
     2587            END.
     2588      end.
     2589   end procedure.
     2590   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2591   on f5 of frame Dialog-Frame anywhere
     2592   do:
     2593     rep-rec = recid(X_c-cash-pay). run openbr in this-procedure  ( input yes, input no, input '':U). reposition br-c-cash-pay to recid rep-rec no-error.                APPLY 'ENTRY' to br-c-cash-pay. APPLY 'VALUE-CHANGED' to br-c-cash-pay.
     2594       apply "VALUE-CHANGED" to BR-c-cash-pay.
     2595   end.
     2596   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2597   on INS of frame Dialog-Frame anywhere do:
     2598     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2599     return no-apply.
     2600   end.
     2601   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2602   on F2 of frame Dialog-Frame anywhere do:
     2603     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2604     return no-apply.
     2605   end.
     2606   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2607   procedure set-filter-name :
     2608   define input parameter p-filter-name as character no-undo .
     2609     do with frame Dialog-Frame:
     2610       if p-filter-name > "" then do:
     2611         assign
     2612           frame Dialog-Frame:title
     2613             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2614         .
     2615         assign
     2616           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2617         .
     2618       end.
     2619       else do:
     2620         assign
     2621           b-sch :tooltip = ""
     2622         .
     2623       end.
     2624     end.
     2625   end procedure.
     2626   MAIN-BLOCK:
     2627   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2628      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2629     CASE parref-mode:
     2630      WHEN 'все':U        THEN DO:
     2631      END.
     2632      WHEN "one":U
     2633      or
     2634      when "one-subject":U
     2635      THEN DO:
     2636        find first X_cash-pay no-lock where
     2637                   X_cash-pay.cdpay-code = p-cdpay-code
     2638              AND  X_cash-pay.curr-code = p-curr-code  no-error .
     2639        if not available X_cash-pay then do:
     2640           message
     2641           vss-workfile vss-revision vss-description skip
     2642           "Неверное значение параметров p-cdpay-code p-curr-code"
     2643           view-as alert-box ERROR.
     2644           return.
     2645        end.
     2646      END.
     2647      otherwise do:
     2648         message vss-workfile vss-revision vss-description skip
     2649         "Неверный вызов - parref-mode=" parref-mode
     2650         view-as alert-box ERROR.
     2651         return.
     2652       end.
     2653     end case.
     2654     RUN MyEnable in this-procedure .
     2655     HIDE mark-num in frame Dialog-Frame .
     2656     run OpenBR in this-procedure  ( input yes, input no, input '':U).
     2657     run diasize_add_browse in this-procedure
     2658       (input  'width':u
     2659       ,input  browse br-changes :handle
     2660       ) .
     2661     run diasize_init in this-procedure .
     2662     WAIT-FOR GO OF FRAME Dialog-Frame.
     2663   END.
     2664   RUN disable_UI.
     2665   PROCEDURE disable_UI :
     2666     HIDE FRAME Dialog-Frame.
     2667   END PROCEDURE.
     2668   PROCEDURE enable_UI :
     2669     DISPLAY mark-num
     2670         WITH FRAME Dialog-Frame.
     2671     ENABLE b-quit B-mark b-sel B-sch B-Help mark-num BR-c-cash-pay BR-changes
     2672         WITH FRAME Dialog-Frame.
     2673     VIEW FRAME Dialog-Frame.
     2674   END PROCEDURE.
     2675   PROCEDURE MyEnable :
     2676   br-changes:title in frame Dialog-Frame  = "":U.
     2677   assign
     2678   temp-changes.l_name:resizable in browse br-changes = true
     2679   temp-changes.v_old:resizable in browse br-changes = true
     2680   temp-changes.v_new:resizable in browse br-changes = true
     2681   temp-changes.l_name:width in browse br-changes = 30
     2682   temp-changes.v_old:width in browse br-changes = 40
     2683   temp-changes.v_new:width in browse br-changes = 40
     2684   .
     2685   DISPLAY
     2686   mark-num
     2687   br-changes
     2688   WITH FRAME Dialog-Frame .
     2689   ENABLE
     2690   B-quit
     2691   B-mark when lookup('b-mark':U, bttns) >0
     2692   B-sel when lookup('b-sel':U, bttns) >0
     2693   B-sch
     2694   B-Help
     2695   BR-c-cash-pay
     2696   br-changes
     2697   mark-num
     2698   WITH FRAME Dialog-Frame .
     2699   VIEW FRAME Dialog-Frame .
     2700   END PROCEDURE.
     2701   PROCEDURE OpenBr :
     2702   define input  parameter p-open-query     as logical   no-undo .
     2703   define input  parameter p-find-next      as logical   no-undo .
     2704   define input  parameter p-find-condition as character no-undo .
     2705   define variable l-query-was-opened as logical no-undo .
     2706   run waitfram-show in this-procedure ( input "Ждите...").
     2707   define variable sort-column-phrase as character no-undo .
     2708   case sort-column-name :
     2709     when "" then do:
     2710       assign
     2711         sort-column-phrase = ""
     2712       .
     2713     end.
     2714     otherwise do:
     2715       assign
     2716         sort-column-phrase = "by " + sort-column-name
     2717       .
     2718     end.
     2719   end case.
     2720   CASE parref-mode:
     2721       when 'все':U then do:
     2722           ASSIGN frame Dialog-Frame:TITLE = "Справочник истории кассовых платежей"
     2723           filter-point = filter-point0 + parref-mode
     2724           filter-label = filter-label0
     2725           .
     2726   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2727   define variable  l-disable-where-21  as logical   no-undo .
     2728   define variable  l-filter-open-21    as logical   .
     2729   define variable  flt-rec-21       as recid     no-undo .
     2730   define variable  filter-name-21      as character no-undo .
     2731   define variable  where-phrase-21     as character no-undo .
     2732   define variable  sort-phrase-21      as character no-undo .
     2733   define variable  where-phrase-rus-21 as character no-undo .
     2734   define variable  sort-phrase-rus-21  as character no-undo .
     2735     run waitfram-show in this-procedure
     2736       (input "ЖДИТЕ ..."
     2737       ).
     2738   run gbl/flt-get.p
     2739     (input filter-point
     2740     ,output flt-rec-21
     2741     ,output filter-name-21
     2742     ,output where-phrase-21
     2743     ,output sort-phrase-21
     2744     ,output where-phrase-rus-21
     2745     ,output sort-phrase-rus-21
     2746     ).
     2747       run set-filter-name in this-procedure
     2748         (INPUT filter-name-21
     2749         ) no-error .
     2750     assign
     2751       l-filter-open-21 = false
     2752     .
     2753     if flt-rec-21 <> ?
     2754       or sort-column-phrase > ""
     2755     then do:
     2756       define variable  parameter-2-21 as character no-undo .
     2757       define variable  parameter-3-21 as character no-undo .
     2758       define variable  parameter-4-21 as character no-undo .
     2759       define variable  parameter-5-21 as character no-undo .
     2760       define variable  parameter-6-21 as character no-undo .
     2761       define variable  parameter-7-21 as character no-undo .
     2762         assign
     2763         parameter-3-21 =
     2764                                 "FOR EACH X_c-cash-pay"
     2765         parameter-4-21 =
     2766           (
     2767             if (" TRUE " + " " + where-phrase-21) <> ""
     2768             then " TRUE " + " " + where-phrase-21
     2769             else "true"
     2770           )
     2771         parameter-5-21 = (" " + "" + " " + "")
     2772         parameter-6-21 = if sort-phrase-21 = ''
     2773                              then
     2774           (
     2775           " " + "  " +
     2776             " " + sort-column-phrase +
     2777           " " + "  "
     2778           )
     2779                              else
     2780           (
     2781           " " + "  " +
     2782             " " + sort-column-phrase +
     2783           " " + sort-phrase-21
     2784           )
     2785         parameter-7-21 =
     2786           "   "
     2787       .
     2788       do
     2789       on stop undo, leave
     2790       on error undo, leave
     2791       :
     2792         assign
     2793           l-disable-where-21 =
     2794             (" TRUE " + " " + where-phrase-21 = "")
     2795         .
     2796         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2797                             ,input query br-c-cash-pay:handle
     2798                             ,input parameter-3-21
     2799                             ,input parameter-4-21
     2800                             ,input parameter-5-21
     2801                             ,input parameter-6-21
     2802                             ,input parameter-7-21
