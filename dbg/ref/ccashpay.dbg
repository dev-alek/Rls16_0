     2109           then do:
     2110             assign
     2111               v-object-handle :col = v-object-handle :col + p-change-value
     2112               no-error .
     2113             if error-status :error
     2114             or error-status :get-message(1) <> ""
     2115             then do:
     2116               undo move_block, retry move_block .
     2117             end.
     2118           end.
     2119         end.
     2120       end.
     2121       else do:
     2122         for each buf_temp-diasize-handle
     2123         on error undo move_block, retry move_block
     2124         :
     2125           assign
     2126             v-object-handle = buf_temp-diasize-handle.handle-value
     2127           .
     2128           if v-object-handle <> v-diasize-resize-button
     2129           then do:
     2130             assign
     2131               v-object-handle :col = v-object-handle :col + p-change-value
     2132               no-error .
     2133             if error-status :error
     2134             or error-status :get-message(1) <> ""
     2135             then do:
     2136               undo move_block, retry move_block .
     2137             end.
     2138           end.
     2139         end.
     2140         for each buf_temp-browse-handle
     2141           where buf_temp-browse-handle.browse-type = 'width':u
     2142         on error undo move_block, retry move_block
     2143         :
     2144           assign
     2145             buf_temp-browse-handle.browse-handle :width
     2146               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2147             no-error .
     2148           if error-status :error
     2149           or error-status :get-message(1) <> ""
     2150           then do:
     2151             undo move_block, retry move_block .
