     1799       if v-diasize-wndstore = true
     1800       then do:
     1801         if connected("ub") = true
     1802         then do:
     1803           define variable v-cntxt-db-num        as integer   no-undo .
     1804           define variable v-cntxt-userid        as character no-undo .
     1805           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1806                                             , OUTPUT v-cntxt-userid
     1807                                             ) .
     1808           run gbl/wndsizew.p
     1809             (input  v-cntxt-db-num
     1810             ,input  v-cntxt-userid
     1811             ,input  v-diasize-proc-name
     1812             ,input  'height':u
     1813             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1814             ) .
     1815         end.
     1816       end.
     1817     end.
     1818     assign
     1819       v-diasize-change-size = false
     1820     .
     1821   end procedure.
     1822   procedure diasize_set-height :
     1823     define input  parameter p-new-height  as decimal   no-undo .
     1824     define input  parameter p-move-resize as logical   no-undo .
     1825     do
     1826     on error undo, return error return-value
     1827     :
     1828       run diasize_change-height in this-procedure
     1829         (input  (p-new-height - frame Dialog-Frame :height)
     1830         ,input  p-move-resize
     1831         ) .
     1832     end.
     1833   end procedure.
     1834   procedure diasize_change-width :
     1835     define input  parameter p-change-value as decimal   no-undo .
     1836     define input  parameter p-move-resize  as logical   no-undo .
     1837     define variable v-field-group-handle   as handle    no-undo .
     1838     define variable v-object-handle        as handle    no-undo .
     1839     define variable v-frame-width          as decimal   no-undo .
     1840     define variable v-frame-virtual-width  as decimal   no-undo .
     1841     define variable v-browse-width         as decimal   no-undo .
     1842     define variable v-window-width         as decimal   no-undo .
     1843     define variable v-window-virtual-width as decimal   no-undo .
     1844     define variable v-change-sign          as integer   no-undo .
     1845     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1846     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1847     if p-change-value > 0
     1848     then do:
     1849       if frame Dialog-Frame :width + p-change-value >
     1850           session :width-chars
     1851       then do:
     1852         assign
     1853           p-change-value = session :width-chars - frame Dialog-Frame :width
     1854         .
     1855         if p-change-value <= 0
     1856         then do:
     1857           run diasize_position-resize-button in this-procedure .
     1858           return .
     1859         end.
     1860       end.
     1861     end.
     1862     if p-change-value < 0
     1863     then do:
     1864       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1865       then do:
     1866         assign
     1867           p-change-value = v-diasize-orig-frame-width
     1868                          - frame Dialog-Frame :width
     1869         .
     1870         if p-change-value >= 0
     1871         then do:
     1872           run diasize_position-resize-button in this-procedure .
     1873           return .
     1874         end.
     1875       end.
     1876     end.
     1877     if p-change-value >= 0
     1878     then do:
     1879       assign
     1880         v-change-sign = 1
     1881       .
     1882     end.
     1883     else do:
     1884       assign
     1885         v-change-sign = -1
     1886       .
     1887     end.
     1888     assign
     1889       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1890     .
     1891     if p-change-value = 0
     1892     then do:
     1893       run diasize_position-resize-button in this-procedure .
     1894       return .
     1895     end.
     1896     move_block:
     1897     do
     1898     on error undo move_block, leave move_block
     1899     :
     1900       if retry
     1901       then do:
     1902         do
     1903         on error undo move_block, leave move_block
     1904         :
     1905           if p-change-value > 0
     1906           then do:
     1907             for each buf_temp-diasize-handle
     1908             on error undo, next
     1909             :
     1910               assign
     1911                 v-object-handle = buf_temp-diasize-handle.handle-value
     1912               .
     1913               if v-object-handle <> v-diasize-resize-button
     1914               then do:
     1915                 assign
     1916                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1917                 .
     1918               end.
     1919             end.
     1920             assign
     1921               v-diasize-browse-handle :width = v-browse-width
     1922             .
     1923             for each buf_temp-browse-handle
     1924               where buf_temp-browse-handle.browse-type = 'width':u
     1925             on error undo, next
     1926             :
     1927               assign
     1928                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1929               .
     1930             end.
     1931             assign
     1932               frame Dialog-Frame :width = v-frame-width
     1933             .
     1934             if frame Dialog-Frame :scrollable = true
     1935             then do:
     1936               assign
     1937                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1938               .
     1939             end.
     1940             run diasize_position-resize-button in this-procedure .
     1941           end.
     1942           else do:
     1943             if frame Dialog-Frame :scrollable = true
     1944             then do:
     1945               assign
     1946                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1947               .
     1948             end.
     1949             assign
     1950               frame Dialog-Frame :width = v-frame-width
     1951             .
     1952             for each buf_temp-browse-handle
     1953               where buf_temp-browse-handle.browse-type = 'width':u
     1954             on error undo, next
     1955             :
     1956               assign
     1957                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1958               .
     1959             end.
     1960             assign
     1961               v-diasize-browse-handle :width = v-browse-width
     1962             .
     1963             for each buf_temp-diasize-handle
     1964             on error undo, next
     1965             :
     1966               assign
     1967                 v-object-handle = buf_temp-diasize-handle.handle-value
     1968               .
     1969               if v-object-handle <> v-diasize-resize-button
     1970               then do:
     1971                 assign
     1972                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1973                 .
     1974               end.
     1975             end.
     1976             run diasize_position-resize-button in this-procedure .
     1977           end.
     1978           assign
     1979             v-diasize-change-size = false
     1980           .
     1981           leave move_block .
     1982         end.
     1983       end.
     1984       assign
     1985         v-diasize-need-full-display = true
     1986       .
     1987       if v-diasize-change-size = false
     1988       then do:
     1989         assign
     1990           v-diasize-change-size = true
     1991         .
     1992       end.
     1993       else do:
     1994         return .
     1995       end.
     1996       assign
     1997         v-frame-width = frame Dialog-Frame :width
     1998         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1999         v-browse-width = v-diasize-browse-handle :width
     2000       .
     2001       for each buf_temp-browse-handle
     2002         where buf_temp-browse-handle.browse-type = 'width':u
     2003       :
     2004         assign
     2005           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2006         .
     2007       end.
     2008       for each buf_temp-diasize-handle
     2009       :
     2010         delete buf_temp-diasize-handle .
     2011       end.
     2012       assign
     2013         v-field-group-handle = frame Dialog-Frame :first-child
     2014       .
     2015       do while valid-handle(v-field-group-handle)
     2016       :
     2017         assign
     2018           v-object-handle = v-field-group-handle :first-child
     2019         .
     2020         do while valid-handle(v-object-handle)
     2021         :
     2022           if  v-object-handle <> v-diasize-browse-handle :handle
     2023           and v-object-handle <> v-diasize-resize-button
     2024           and can-query(v-object-handle, "row")
     2025           and can-query(v-object-handle, "height")
     2026           and ( v-object-handle :col + v-object-handle :width
     2027                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2028               )
     2029           then do:
     2030             find first buf_temp-browse-handle
     2031               where buf_temp-browse-handle.browse-type   = 'width':u
     2032                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2033               no-error .
     2034             if available buf_temp-browse-handle
     2035             then do:
     2036             end.
     2037             else do:
     2038               create buf_temp-diasize-handle .
     2039               assign
     2040                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2041                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2042               .
     2043             end.
     2044           end.
     2045           assign
     2046             v-object-handle = v-object-handle :next-sibling
     2047           .
     2048         end.
     2049         assign
     2050           v-field-group-handle = v-field-group-handle :next-sibling
     2051         .
     2052       end.
     2053       do with frame Dialog-Frame
     2054       :
     2055         hide v-diasize-resize-button .
     2056         v-diasize-resize-button :row = 1.
     2057         v-diasize-resize-button :column = 1.
     2058       end.
     2059       if p-change-value > 0
     2060       then do:
     2061         if frame Dialog-Frame :scrollable = true
     2062         then do:
     2063           assign
     2064             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2065             no-error .
     2066           if error-status :error
     2067           or error-status :get-message(1) <> ""
     2068           then do:
     2069             undo move_block, retry move_block.
     2070           end.
     2071         end.
     2072         assign
     2073           frame Dialog-Frame :width = v-frame-width + p-change-value
     2074           no-error .
     2075         if error-status :error
     2076         or error-status :get-message(1) <> ""
     2077         then do:
     2078           undo move_block, retry move_block.
     2079         end.
     2080         assign
     2081           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2082         no-error .
     2083         if error-status :error
     2084         or error-status :get-message(1) <> ""
     2085         then do:
     2086           undo move_block, retry move_block.
     2087         end.
     2088         for each buf_temp-browse-handle
     2089           where buf_temp-browse-handle.browse-type = 'width':u
     2090         on error undo move_block, retry move_block
     2091         :
     2092           assign
     2093             buf_temp-browse-handle.browse-handle :width
     2094               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2095             no-error .
     2096           if error-status :error
     2097           or error-status :get-message(1) <> ""
     2098           then do:
     2099             undo move_block, retry move_block .
     2100           end.
     2101         end.
     2102         for each buf_temp-diasize-handle
     2103         on error undo move_block, retry move_block
     2104         :
     2105           assign
     2106             v-object-handle = buf_temp-diasize-handle.handle-value
     2107           .
