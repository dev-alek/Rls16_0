     2156           no-error .
     2157         if error-status :error
     2158         or error-status :get-message(1) <> ""
     2159         then do:
     2160           undo move_block, retry move_block.
     2161         end.
     2162         assign
     2163           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2164         no-error .
