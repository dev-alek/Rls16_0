     3068   PROCEDURE proc-b-sch :
     3069   assign
     3070   tbl = 'c-cash-pay'
     3071   join-tbl = 'X_c-cash-pay'
     3072   fld = ""
     3073   lab = ""
     3074   spr = ""
     3075   dim = '0'
     3076   .
     3077   run fltfield-add in this-procedure('cdpay-code', 'Код платежат', '',
     3078   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3079   run fltfield-add in this-procedure('curr-code', 'Код валюты', '',
     3080   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3081   run fltfield-add in this-procedure('attr-code', 'Атрибут', '',
     3082   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3083   run fltfield-add in this-procedure('corr-date', 'Дата изменений', '',
     3084   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3085   run fltfield-add in this-procedure('corr-time', 'Время изменений', 'time',
     3086   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3087   run fltfield-add in this-procedure('corr-user-db-num', 'БД изменений', '',
     3088   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3089   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     3090   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3091   DO on stop undo, leave:
     3092       run gbl/filter.w ( input parparentproc
     3093                         ,input filter-point + chr(4) + filter-label
     3094                         ,input tbl
     3095                         ,input join-tbl
     3096                         ,input fld
     3097                         ,input lab
     3098                         ,input spr
     3099                         ,input dim).
     3100       RUN OpenBr in this-procedure  ( input yes, input no, input '':U).
     3101   END .
     3102   END PROCEDURE.
     3103   PROCEDURE proc-view-changes :
     3104   define variable v-description as character no-undo .
     3105   for each temp-changes:
     3106       delete temp-changes.
     3107   END.
     3108   if not available X_c-cash-pay then do:
     3109     Open QUery br-changes for each temp-changes.
     3110     return.
     3111   end.
     3112   run ref/ccshpayv.p (
     3113                      input X_c-cash-pay.cdpay-code
     3114                     ,input X_c-cash-pay.curr-code
     3115                     ,input X_c-cash-pay.attr-code
     3116                     ,input X_c-cash-pay.corr-user-db-num
     3117                     ,input X_c-cash-pay.chip-num
     3118                     ,input X_c-cash-pay.subject
     3119                     ,input 0
     3120                     ,input no
     3121                     ,input "":U
     3122                     ,output v-description
     3123                  ) no-error .
     3124   Open QUery br-changes for each temp-changes.
     3125   assign
     3126   br-changes:title in frame Dialog-Frame = v-description
     3127   .
     3128   END PROCEDURE.
     3129   FUNCTION get-action RETURNS CHARACTER
     3130     (  p-action as integer ) :
     3131     define variable dops as character no-undo.
     3132   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     3133   RETURN dops.
     3134   END FUNCTION.
