      879   FUNCTION get-all-fields returns character (p-file-name as character ):
      880   define variable v-dop as character no-undo .
      881     find first _file no-lock where _file._file-name = p-file-name no-error .
      882     if not available _file then return "":U.
      883     for each _field no-lock where
      884              _field._file-recid = recid(_file) :
      885       assign
      886       v-dop = v-dop + _field._field-name + chr(44)
      887       .
      888     end.
      889     return trim(v-dop).
      890   END FUNCTION.
      891   PROCEDURE proc-full-temp-changes :
      892     define input  parameter p-hst-handle as handle    no-undo .
      893     define input  parameter p-main-table as character no-undo .
      894     define input  parameter p-field-list as character no-undo .
      895     define input  parameter p-label-form as character no-undo .
      896     define variable h-new-buf         as handle    no-undo .
      897     define variable h-main-buf        as handle    no-undo .
      898     define variable h-for-comp        as handle    no-undo .
      899     define variable v-inform          as character no-undo .
      900     define variable v-ind             as integer   no-undo .
      901     define variable v-idx-field-qnty  as integer   no-undo .
      902     define variable v-num-entries     as integer   no-undo .
      903     define variable fh                as handle    no-undo .
      904     define variable fh-main           as handle    no-undo .
      905     define variable fh-old            as handle    no-undo .
      906     define variable fh-new            as handle    no-undo .
      907     define variable v-field-name      as character no-undo .
      908     define variable v-field-lvl       as character no-undo .
      909     define variable v-field-form      as character no-undo .
      910     define variable v-search-exp      as character no-undo .
      911     define variable v-srch-main       as character no-undo .
      912     define variable v-word-link       as character no-undo .
      913     define variable v-av-chip-num     as logical   no-undo .
      914     define variable v-main-pi-fld-lst as character no-undo .
      915     define variable v-main-fld-lst    as character no-undo .
      916     define variable v-delim-list      as character no-undo .
      917     define variable v-label           as character no-undo .
      918     define variable v-old-value       as character no-undo case-sensitive.
      919     define variable v-new-value       as character no-undo case-sensitive.
      920     define variable v-chg-fields as character no-undo.
      921     for each temp-changes:
      922       delete temp-changes.
      923     end.
      924     if not p-hst-handle:available then do:
      925       return .
      926     end.
      927     create buffer h-new-buf  for table p-hst-handle .
      928     create buffer h-main-buf for table p-main-table .
      929     assign
      930       v-inform = h-main-buf:index-information(1)
      931       v-ind    = 2
      932     .
      933     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      934     on error undo, return error
      935     :
      936       assign
      937         v-inform = h-main-buf:index-information( v-ind )
      938         v-ind    = v-ind + 1
      939       .
      940     end.
      941     if v-inform = ?
      942       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      943       or entry( 3, v-inform, ",":U ) <> "1":U
      944     then do:
      945       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      946     end.
      947     assign
      948       v-idx-field-qnty = num-entries( v-inform ) - 4
      949     .
      950     if v-idx-field-qnty < 2 then do:
      951       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      952     end.
      953     assign
      954       v-srch-main   = "where":U
      955       v-word-link   = "":U
      956       v-av-chip-num = false
      957       v-delim-list  = "":U
      958     .
      959     do v-ind = 1 to v-idx-field-qnty by 2
      960     on error undo, return error
      961     :
      962       assign
      963         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      964         fh                = p-hst-handle:buffer-field( v-field-name )
      965         fh-main           = h-main-buf:buffer-field( v-field-name )
      966         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      967         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      968       .
      969       if fh:data-type ="character":U then do:
      970         assign
      971           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      972         .
      973       end.
      974       else do:
      975         assign
      976           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      977         .
      978       end.
      979       if v-delim-list = "":U then do:
      980         assign
      981           v-delim-list = ",":U
      982         .
      983       end.
      984       if v-word-link = "":U then do:
      985         assign
      986           v-word-link = "and":U
      987         .
      988       end.
      989     end.
      990     assign
      991       v-delim-list  = "":U
      992     .
      993     do v-ind = 1 to h-main-buf:num-fields
      994     on error undo, return error
      995     :
      996       assign
      997         fh-main      = h-main-buf:buffer-field( v-ind )
      998         v-field-name = fh-main:name
      999       .
     1000         assign
     1001           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1002         .
     1003         if v-delim-list = "":U then do:
     1004           assign
     1005             v-delim-list = ",":U
     1006           .
     1007         end.
     1008     end.
     1009     assign
     1010       v-inform = p-hst-handle:index-information(1)
     1011       v-ind    = 2
     1012     .
     1013     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1014     on error undo, return error
     1015     :
     1016       assign
     1017         v-inform = p-hst-handle:index-information( v-ind )
     1018         v-ind    = v-ind + 1
     1019       .
     1020     end.
     1021     if v-inform = ?
     1022       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1023       or entry( 3, v-inform, ",":U ) <> "1":U
     1024     then do:
     1025       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1026     end.
     1027     assign
     1028       v-idx-field-qnty = num-entries( v-inform ) - 4
     1029     .
     1030     if v-idx-field-qnty < 2 then do:
     1031       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1032     end.
     1033     assign
     1034       v-search-exp  = "where":U
     1035       v-word-link   = "":U
     1036       v-av-chip-num = false
     1037     .
     1038     do v-ind = 1 to v-idx-field-qnty by 2
     1039     on error undo, return error
     1040     :
     1041       assign
     1042         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1043         fh           = p-hst-handle:buffer-field( v-field-name )
     1044         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1045       .
     1046       if v-field-name = "chip-num":U then do:
     1047         assign
     1048           v-search-exp  = substitute( "&1 >", v-search-exp )
     1049           v-av-chip-num = true
     1050         .
     1051       end.
     1052       else do:
     1053         assign
     1054           v-search-exp = substitute( "&1 =", v-search-exp )
     1055         .
     1056       end.
     1057       if fh:data-type ="character":U then do:
     1058         assign
     1059           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1060         .
     1061       end.
     1062       else do:
     1063         assign
     1064           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1065         .
     1066       end.
     1067       if v-word-link = "":U then do:
     1068         assign
     1069           v-word-link = "and":U
     1070         .
     1071       end.
     1072     end.
     1073     if v-av-chip-num = false then do:
     1074       message
     1075         vss-workfile vss-revision vss-description skip
     1076         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1077         "Использование данной процедуры невозможно!" skip
     1078         view-as alert-box error .
     1079       return error .
     1080     end.
     1081     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1082     if not h-new-buf:available then do:
     1083       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1084       if not h-main-buf:available then do:
     1085         assign
     1086           h-for-comp = ?
     1087         .
     1088       end.
     1089       else do:
     1090         assign
     1091           h-for-comp = h-main-buf
     1092         .
     1093       end.
     1094     end.
     1095     else do:
     1096       assign
     1097         h-for-comp = h-new-buf
     1098       .
     1099     end.
     1100     assign
     1101       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1102     .
     1103     do v-ind = 1 to v-num-entries
     1104     on error undo, return error return-value
     1105     :
     1106       assign
     1107         v-field-name = entry( v-ind, v-main-fld-lst )
     1108         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1109         v-old-value  = fh-old:buffer-value()
     1110         v-label      = trim( fh-old:label )
     1111       .
     1112       if ( trim( p-field-list ) <> "":U
     1113            and lookup( v-field-name, p-field-list ) > 0
     1114          )
     1115          or trim( p-field-list ) = "":U
     1116       then do:
     1117         if h-for-comp <> ? then do:
     1118           assign
     1119             fh-new      = h-for-comp:buffer-field( v-field-name )
     1120             v-new-value = fh-new:buffer-value()
     1121           .
     1122         end.
     1123         else do:
     1124           assign
     1125             v-new-value = "":U
     1126           .
     1127         end.
     1128         if v-old-value <> v-new-value
     1129         then do:
     1130           create temp-changes.
     1131           assign
     1132             temp-changes.t_name = p-main-table
     1133             temp-changes.f_name = v-field-name
     1134             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1135             temp-changes.v_old  = trim( v-old-value )
     1136             temp-changes.v_new  = trim( v-new-value )
     1137             temp-changes.num_   = 0
     1138             temp-changes.fNotChange = v-old-value eq v-new-value
     1139           .
     1140         end.
     1141       end.
     1142     end.
     1143     assign
     1144       v-num-entries = num-entries( p-label-form, chr(8) )
     1145     .
     1146     do v-ind = 1 to v-num-entries
     1147     on error undo, return error return-value
     1148     :
     1149       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1150         assign
     1151           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1152           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1153           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1154         .
     1155         find first temp-changes
     1156           where temp-changes.f_name = v-field-name
     1157           no-error .
     1158         if available temp-changes then do:
     1159           if trim( v-field-lvl ) <> "":U then do:
     1160             assign
     1161               temp-changes.l_name = v-field-lvl
     1162             .
     1163           end.
     1164           if trim( v-field-form ) <> "":U then do:
     1165             assign
     1166               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1167             .
     1168             if h-for-comp <> ? then do:
     1169               assign
     1170                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1171               .
     1172             end.
     1173           end.
     1174         end.
     1175       end.
     1176       else do:
     1177         message
     1178           vss-workfile vss-revision vss-description skip
     1179           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1180           substitute( "список для поля '&1': '&2'"
     1181                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1182                       ,entry( v-ind, p-label-form, chr(8) )
     1183                     ) skip
     1184           substitute( "полный список: &2", p-label-form ) skip
     1185           view-as alert-box error .
     1186       end.
     1187     end.
     1188     delete object h-new-buf .
     1189     delete object h-main-buf .
     1190   END PROCEDURE.
     1191   FUNCTION get-action RETURNS CHARACTER
     1192     (  p-action as integer )  FORWARD.
     1193   DEFINE BUTTON B-Help
     1194        LABEL "Помо&щь"
     1195        SIZE 3 BY 1
     1196        BGCOLOR 8 .
     1197   DEFINE BUTTON B-mark
     1198        LABEL "&*"
     1199        SIZE 3 BY 1.
     1200   DEFINE BUTTON b-quit AUTO-END-KEY
     1201        LABEL "&Выход"
     1202        SIZE 10 BY 1
     1203        BGCOLOR 8 .
     1204   DEFINE BUTTON B-sch
     1205        LABEL "&Фильтр"
     1206        SIZE 3 BY 1.
     1207   DEFINE BUTTON b-sel AUTO-GO
     1208        LABEL "Вы&бор"
     1209        SIZE 10 BY 1.
     1210   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1211        VIEW-AS FILL-IN
     1212        SIZE 9 BY 1
     1213        FGCOLOR 4  NO-UNDO.
     1214   DEFINE QUERY BR-c-cash-pay FOR X_c-cash-pay SCROLLING.
     1215   DEFINE QUERY BR-changes FOR
     1216         temp-changes SCROLLING.
     1217   DEFINE BROWSE BR-c-cash-pay
     1218     QUERY BR-c-cash-pay DISPLAY
     1219         mark-string( recid(X_c-cash-pay), v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     1220         entry (lookup (X_c-cash-pay.subject, 'cash-pay,cash-pay-attr,dis-cp-rule':U), 'Касс.платеж,Аттр.касс.пл-жа,Скидки на платеж':U) COLUMN-LABEL "Предмет изменений" FORMAT "X(12)":U
     1221         get-action(X_c-cash-pay.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1222         X_c-cash-pay.corr-date COLUMN-LABEL "Дата корр" FORMAT "99/99/9999":U
     1223         usrfulnf(X_c-cash-pay.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1224         string(X_c-cash-pay.corr-time, "HH:MM")
     1225       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 12.33.
     1226   DEFINE BROWSE BR-changes
     1227     QUERY BR-changes DISPLAY
     1228         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1229   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1230   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1231       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.
     1232   DEFINE FRAME Dialog-Frame
     1233        b-quit AT ROW 1 COL 1
     1234        B-mark AT ROW 1 COL 11
     1235        b-sel AT ROW 1 COL 14
     1236        B-sch AT ROW 1 COL 92
     1237        B-Help AT ROW 1 COL 95
     1238        mark-num AT ROW 1.92 COL 9 COLON-ALIGNED NO-LABEL
     1239        BR-c-cash-pay AT ROW 3.42 COL 1
     1240        BR-changes AT ROW 16.04 COL 1
     1241        SPACE(0.24) SKIP(0.00)
     1242       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1243            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1244            TITLE "Справочник истории кассвых платежей"
     1245            CANCEL-BUTTON b-quit.
     1246   ASSIGN
     1247          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1248          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1249   ASSIGN
     1250          BR-c-cash-pay:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1251   ON GO OF FRAME Dialog-Frame
     1252   DO:
     1253     p-rid-list = v-rid-list.
     1254   END.
     1255   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1256   DO:
     1257     APPLY "END-ERROR":U TO SELF.
     1258   END.
     1259   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1260   DO:
     1261   define variable glog as logical no-undo .
     1262   if not available X_c-cash-pay then return no-apply.
     1263   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1264   define variable v-str-recid12 as character no-undo .
     1265   define variable v-num-entry12 as integer   no-undo .
     1266   assign
     1267     v-str-recid12 = trim( string( recid( X_c-cash-pay ) , "->>>>>>>>>>>9":U ) )
     1268     v-num-entry12 = lookup( v-str-recid12 , v-rid-list )
     1269   .
     1270   if v-num-entry12 > 0 then do:
     1271     assign
     1272       entry( v-num-entry12, v-rid-list ) = "":U
     1273       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1274     .
     1275   end.
     1276   else do:
     1277     assign
     1278       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid12
     1279     .
     1280   end.
     1281    glog = br-c-cash-pay :refresh( )  in frame Dialog-Frame.
     1282     if not can-do ("MOUSE-SELECT-DBLCLICK,Return", last-event:function) then do:
     1283             glog = br-c-cash-pay:select-next-row () in frame Dialog-Frame.
     1284             apply "value-changed" to br-c-cash-pay in frame Dialog-Frame.
     1285     end.
     1286     if num-entries (v-rid-list) = 0 then
     1287         hide mark-num in frame Dialog-Frame.
     1288     else
     1289     disp num-entries (v-rid-list) @ mark-num
     1290     with frame Dialog-Frame.
     1291     apply "entry" to br-c-cash-pay in frame Dialog-Frame.
     1292   END.
     1293   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1294   DO:
     1295     run proc-b-sch in this-procedure no-error.
     1296     if error-status:error then return no-apply.
     1297   END.
     1298   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1299   DO:
     1300       if ( available X_c-cash-pay ) AND ( v-rid-list = "" ) then
     1301           v-rid-list = string( recid( X_c-cash-pay ) ) .
     1302   END.
     1303   ON RETURN OF BR-c-cash-pay IN FRAME Dialog-Frame
     1304   DO:
     1305         apply "DEFAULT-ACTION":U to self.
     1306   END.
     1307   ON VALUE-CHANGED OF BR-c-cash-pay IN FRAME Dialog-Frame
     1308   DO:
     1309     run proc-view-changes in this-procedure no-error.
     1310   END.
     1311   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1312   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1313   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1314   on help of frame Dialog-Frame
     1315   do:
     1316     run gbl/app_help.p
     1317       (input this-procedure :file-name
     1318       ,input ''
     1319       ,input ?
     1320       ) no-error.
     1321     if error-status :error then do:
     1322       message
     1323         "Ошибка при вызове помощи"
     1324         error-status :get-message(1)
     1325         view-as alert-box .
     1326     end.
     1327   end.
     1328   run minbtn-set in this-procedure .
     1329   on choose of b-help in frame Dialog-Frame
     1330   do:
     1331     apply "help":u to frame Dialog-Frame .
     1332   end.
     1333   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1334   procedure minbtn-set :
     1335       do
     1336           on error undo, return error return-value
     1337           :
     1338           define variable ii              as integer       no-undo .
     1339           define variable fh              as widget-handle no-undo .
     1340           define variable hh              as widget-handle no-undo .
     1341           define variable v-h             as handle        extent 4 no-undo .
     1342           define variable v-name-button   as character     no-undo .
     1343           define variable v-help-old-x    as decimal       no-undo .
     1344           define variable v-help-old-y    as decimal       no-undo .
     1345           define variable v-help-old-size as decimal       no-undo .
     1346           define variable v-frame-width   as decimal       no-undo .
     1347           define variable jj              as integer       no-undo .
     1348           do
     1349               on error undo, return error
     1350               :
     1351               assign
     1352                   v-frame-width = frame Dialog-Frame:width - 0.3
     1353                   fh            = frame Dialog-Frame:first-child
     1354                   hh            = fh:first-child
     1355                   ii            = 1
     1356                   .
     1357               do while valid-handle(hh):
     1358                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1359                   do:
     1360                       case lc(hh:name) :
     1361                           when "b-help" then
     1362                               do:
     1363                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1364                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1365                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1366                                   hh:TOOLTIP = "Помощь" .
     1367                                   v-help-old-x = hh:column .
     1368                                   v-help-old-y = hh:row    .
     1369                                   v-help-old-size = hh:width .
     1370                                   hh:width-chars = 2.5 .
     1371                               end.
     1372                           when "b-print" then
     1373                               do:
     1374                                   hh:load-image("cmp/b-print.bmp":u) .
     1375                                   hh:TOOLTIP = "Печать" .
     1376                                   v-h[ii] = hh:handle .
     1377                                   ii = ii + 1 .
     1378                                   hh:width-chars = 3 .
     1379                               end.
     1380                           when "b-history" or
     1381                           when "b-hist" then
     1382                               do:
     1383                                   hh:load-image("cmp/b-hist.bmp":u) .
     1384                                   hh:TOOLTIP = "История" .
     1385                                   v-h[ii] = hh:handle .
     1386                                   ii = ii + 1 .
     1387                                   hh:width-chars = 3 .
     1388                               end.
     1389                           when "b-sch" then
     1390                               do:
     1391                                   hh:load-image("cmp/b-sch.bmp":u) .
     1392                                   hh:TOOLTIP = "Установка Фильтра" .
     1393                                   v-h[ii] = hh:handle .
     1394                                   ii = ii + 1 .
     1395                                   hh:width-chars = 3 .
     1396                               end.
     1397                           when "b-hist-user" then
     1398                               do:
     1399                                   hh:load-image("cmp/b-hist.bmp":u) .
     1400                                   hh:TOOLTIP = "История пользователя" .
     1401                                   ii = ii + 1 .
     1402                               end.
     1403                       end case.
     1404                   end.
     1405                   hh = hh:next-sibling.
     1406               end.
     1407               b-help:column = v-frame-width - b-help:width-chars.
     1408               jj = 0.
     1409               repeat ii = 4 to 1 by -1 :
     1410                   if valid-handle (v-h[ii] ) then
     1411                   do:
     1412                       jj  = jj + 1 .
     1413                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1414                       v-h[ii]:row    = v-help-old-y .
     1415                   end.
     1416               end.
     1417           end.
     1418       end.
     1419   end procedure.
     1420   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1421   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1422   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1423   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1424   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1425   define variable v-diasize-current-frame-height as decimal   no-undo .
     1426   define variable v-diasize-change-size          as logical   no-undo .
     1427   define variable v-diasize-resize-button        as handle    no-undo .
     1428   define variable v-diasize-wndmax               as logical   no-undo .
     1429   define variable v-diasize-wndstore             as logical   no-undo .
     1430   define variable v-diasize-proc-name            as character no-undo .
     1431   define variable v-diasize-browse-handle        as handle    no-undo .
     1432   define variable v-diasize-browse-number        as integer   no-undo .
     1433   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1434   define temp-table temp-diasize-handle no-undo
     1435     field handle-value  as handle
     1436     field save-position as decimal
     1437     index xpk is primary unique handle-value
     1438     .
     1439   define temp-table temp-browse-handle no-undo
     1440     field browse-type   as character
     1441     field browse-number as integer
     1442     field browse-handle as handle
     1443     field original-size as decimal
     1444     index xpk is primary unique browse-type browse-number
     1445     index xie browse-type browse-handle
     1446   .
     1447   procedure diasize_change-height :
     1448     define input  parameter p-change-value  as decimal   no-undo .
     1449     define input  parameter p-move-resize   as logical   no-undo .
     1450     define variable v-field-group-handle    as handle    no-undo .
     1451     define variable v-object-handle         as handle    no-undo .
     1452     define variable v-frame-height          as decimal   no-undo .
     1453     define variable v-frame-virtual-height  as decimal   no-undo .
     1454     define variable v-browse-height         as decimal   no-undo .
     1455     define variable v-window-height         as decimal   no-undo .
     1456     define variable v-window-virtual-height as decimal   no-undo .
     1457     define variable v-change-sign           as integer   no-undo .
     1458     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1459     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1460     if p-change-value > 0
     1461     then do:
     1462       if frame Dialog-Frame :height + p-change-value
     1463           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1464       then do:
     1465         assign
     1466           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1467                           - (frame Dialog-Frame :height-chars)
     1468         .
     1469         if p-change-value <= 0
     1470         then do:
     1471           run diasize_position-resize-button in this-procedure .
     1472           return .
     1473         end.
     1474       end.
     1475     end.
     1476     if p-change-value < 0
     1477     then do:
     1478       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1479       then do:
     1480         assign
     1481           p-change-value = v-diasize-orig-frame-height
     1482                          - (frame Dialog-Frame :height-chars)
     1483         .
     1484         if p-change-value >= 0
     1485         then do:
     1486           run diasize_position-resize-button in this-procedure .
     1487           return .
     1488         end.
     1489       end.
     1490     end.
     1491     if p-change-value >= 0
     1492     then do:
     1493       assign
     1494         v-change-sign = 1
     1495       .
     1496     end.
     1497     else do:
     1498       assign
     1499         v-change-sign = -1
     1500       .
     1501     end.
     1502     assign
     1503       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1504     .
     1505     if p-change-value = 0
     1506     then do:
     1507       run diasize_position-resize-button in this-procedure .
     1508       return .
     1509     end.
     1510     move_block:
     1511     do
     1512     on error undo move_block, retry move_block
     1513     :
     1514       if retry
     1515       then do:
     1516         do
     1517         on error undo move_block, leave move_block
     1518         :
     1519           if p-change-value > 0
     1520           then do:
     1521             for each buf_temp-diasize-handle
     1522             on error undo, next
     1523             :
     1524               assign
     1525                 v-object-handle = buf_temp-diasize-handle.handle-value
     1526               .
     1527               if v-object-handle <> v-diasize-resize-button
     1528               then do:
     1529                 assign
     1530                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1531                 .
     1532               end.
     1533             end.
     1534             assign
     1535               v-diasize-browse-handle :height = v-browse-height
     1536             .
     1537             for each buf_temp-browse-handle
     1538               where buf_temp-browse-handle.browse-type = 'height':u
     1539             on error undo, next
     1540             :
     1541               assign
     1542                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1543               .
     1544             end.
     1545             assign
     1546               frame Dialog-Frame :height = v-frame-height
     1547             .
     1548             if frame Dialog-Frame :scrollable = true
     1549             then do:
     1550               assign
     1551                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1552               .
     1553             end.
     1554             run diasize_position-resize-button in this-procedure .
     1555           end.
     1556           else do:
     1557             if frame Dialog-Frame :scrollable = true
     1558             then do:
     1559               assign
     1560                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1561               .
     1562             end.
     1563             assign
     1564               frame Dialog-Frame :height = v-frame-height
     1565             .
     1566             assign
     1567               v-diasize-browse-handle :height = v-browse-height
     1568             .
     1569             for each buf_temp-browse-handle
     1570               where buf_temp-browse-handle.browse-type = 'height':u
     1571             on error undo, next
     1572             :
     1573               assign
     1574                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1575               .
     1576             end.
     1577             for each buf_temp-diasize-handle
     1578             on error undo, next
     1579             :
     1580               assign
     1581                 v-object-handle = buf_temp-diasize-handle.handle-value
     1582               .
     1583               if v-object-handle <> v-diasize-resize-button
     1584               then do:
     1585                 assign
     1586                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1587                 .
     1588               end.
     1589             end.
     1590             run diasize_position-resize-button in this-procedure .
     1591           end.
     1592           assign
     1593             v-diasize-change-size = false
     1594           .
     1595           leave move_block .
     1596         end.
     1597       end.
     1598       assign
     1599         v-diasize-need-full-display = true
     1600       .
     1601       if v-diasize-change-size = false
     1602       then do:
     1603         assign
     1604           v-diasize-change-size = true
     1605         .
     1606       end.
     1607       else do:
     1608         return .
     1609       end.
     1610       assign
     1611         v-frame-height = frame Dialog-Frame :height
     1612         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1613         v-browse-height = v-diasize-browse-handle :height
     1614       .
     1615       for each buf_temp-browse-handle
     1616         where buf_temp-browse-handle.browse-type = 'height':u
     1617       :
     1618         assign
     1619           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1620         .
     1621       end.
     1622       for each buf_temp-diasize-handle
     1623       :
     1624         delete buf_temp-diasize-handle .
     1625       end.
     1626       assign
     1627         v-field-group-handle = frame Dialog-Frame :first-child
     1628       .
     1629       do while valid-handle(v-field-group-handle)
     1630       :
     1631         assign
     1632           v-object-handle = v-field-group-handle :first-child
     1633         .
     1634         do while valid-handle(v-object-handle)
     1635         :
     1636           if  v-object-handle <> v-diasize-browse-handle :handle
     1637           and can-query(v-object-handle, "row")
     1638           and can-query(v-object-handle, "height")
     1639           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1640           then do:
     1641             find first buf_temp-browse-handle
     1642               where buf_temp-browse-handle.browse-type   = 'height':u
     1643                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1644               no-error .
     1645             if available buf_temp-browse-handle
     1646             then do:
     1647             end.
     1648             else do:
     1649               create buf_temp-diasize-handle .
     1650               assign
     1651                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1652                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1653               .
     1654             end.
     1655           end.
     1656           assign
     1657             v-object-handle = v-object-handle :next-sibling
     1658           .
     1659         end.
     1660         assign
     1661           v-field-group-handle = v-field-group-handle :next-sibling
     1662         .
     1663       end.
     1664       do with frame Dialog-Frame
     1665       :
     1666         hide v-diasize-resize-button .
     1667         assign
     1668           v-diasize-resize-button :row    = 1
     1669           v-diasize-resize-button :column = 1
     1670         .
     1671       end.
     1672       if p-change-value > 0
     1673       then do:
     1674         if frame Dialog-Frame :scrollable = true
     1675         then do:
     1676           assign
     1677             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1678             no-error .
     1679           if error-status :error
     1680           or error-status :get-message(1) <> ""
     1681           then do:
     1682             undo move_block, retry move_block .
     1683           end.
     1684         end.
     1685         assign
     1686           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1687           no-error .
     1688         if error-status :error
     1689         or error-status :get-message(1) <> ""
     1690         then do:
     1691           undo move_block, retry move_block .
     1692         end.
     1693         assign
     1694           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1695           no-error .
     1696         if error-status :error
     1697         or error-status :get-message(1) <> ""
     1698         then do:
     1699           undo move_block, retry move_block .
     1700         end.
     1701         for each buf_temp-browse-handle
     1702           where buf_temp-browse-handle.browse-type = 'height':u
     1703         on error undo move_block, retry move_block
     1704         :
     1705           assign
     1706             buf_temp-browse-handle.browse-handle :height
     1707               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1708             no-error .
     1709           if error-status :error
     1710           or error-status :get-message(1) <> ""
     1711           then do:
     1712             undo move_block, retry move_block .
     1713           end.
     1714         end.
     1715         for each buf_temp-diasize-handle
     1716         on error undo move_block, retry move_block
     1717         :
     1718           assign
     1719             v-object-handle = buf_temp-diasize-handle.handle-value
     1720           .
     1721           if v-object-handle <> v-diasize-resize-button
     1722           then do:
     1723             assign
     1724               v-object-handle :row = v-object-handle :row + p-change-value
     1725               no-error .
     1726             if error-status :error
     1727             or error-status :get-message(1) <> ""
     1728             then do:
     1729               undo move_block, retry move_block .
     1730             end.
     1731           end.
     1732         end.
     1733       end.
     1734       else do:
     1735         for each buf_temp-diasize-handle
     1736         on error undo move_block, retry move_block
     1737         :
     1738           assign
     1739             v-object-handle = buf_temp-diasize-handle.handle-value
     1740           .
     1741           if v-object-handle <> v-diasize-resize-button
     1742           then do:
     1743             assign
     1744               v-object-handle :row = v-object-handle :row + p-change-value
     1745               no-error .
     1746             if error-status :error
     1747             or error-status :get-message(1) <> ""
     1748             then do:
     1749               undo move_block, retry move_block .
     1750             end.
     1751           end.
     1752         end.
     1753         assign
     1754           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1755           no-error .
     1756         if error-status :error
     1757         or error-status :get-message(1) <> ""
     1758         then do:
     1759           undo move_block, retry move_block .
     1760         end.
     1761         for each buf_temp-browse-handle
     1762           where buf_temp-browse-handle.browse-type = 'height':u
     1763         on error undo move_block, retry move_block
     1764         :
     1765           assign
     1766             buf_temp-browse-handle.browse-handle :height
     1767               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1768             no-error .
     1769           if error-status :error
     1770           or error-status :get-message(1) <> ""
     1771           then do:
     1772             undo move_block, retry move_block .
     1773           end.
     1774         end.
     1775         assign
     1776           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1777           no-error .
     1778         if error-status :error
     1779         or error-status :get-message(1) <> ""
     1780         then do:
     1781           undo move_block, retry move_block .
     1782         end.
     1783         if frame Dialog-Frame :scrollable = true
     1784         then do:
     1785           assign
     1786             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1787             no-error .
     1788           if error-status :error
     1789           or error-status :get-message(1) <> ""
     1790           then do:
     1791             undo move_block, retry move_block .
     1792           end.
     1793         end.
     1794       end.
     1795       if p-move-resize = true
     1796       then do:
     1797         run diasize_position-resize-button in this-procedure .
