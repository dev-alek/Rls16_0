     2196             (input  v-cntxt-db-num
     2197             ,input  v-cntxt-userid
     2198             ,input  v-diasize-proc-name
     2199             ,input  'width':u
     2200             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
