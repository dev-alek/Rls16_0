        1   block-level on error undo, throw.
        2   define input parameter parparentproc  as widget-handle no-undo.
        3   define parameter buffer b-clients for ub.clients .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: cli-ph.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: ref/cli-ph.p $":U .
        9   define variable vss-description as character no-undo init "Показать изображение клиента".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   PROCEDURE verify-ini-entry:
       70   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
       71   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
       72   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
       73   DEFINE INPUT  PARAMETER silence          as logical no-undo.
       74   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
       75   define variable v-mess as character no-undo .
       76   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
       77   if ini-entry-value = ? and ini-key-name begins "spl"
       78   then
       79   get-key-value section ini-section-name key "splall" value ini-entry-value.
       80   if ini-entry-value = ? and ini-key-name begins "sav"
       81   then
       82   get-key-value section ini-section-name key "savall" value ini-entry-value.
       83   if ini-entry-value = ? then do:
       84     assign
       85     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
       86                       , chr(10)
       87                       , ini-section-name
       88                       , ini-key-name
       89                       , error-msg-text).
       90       if not silence then do:
       91         message
       92         v-mess
       93         view-as alert-box ERROR  .
       94         return error.
       95       end.
       96       else do:
       97         return error v-mess.
       98       end.
       99   end.
      100   END PROCEDURE.
      101   PROCEDURE verify-file:
      102   DEFINE INPUT  PARAMETER filename       as character no-undo.
      103   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
      104   DEFINE INPUT  PARAMETER silence        as logical no-undo.
      105   DEFINE OUTPUT PARAMETER found          as logical no-undo.
      106   file-info:file-name = filename.
      107   found = NOT (file-info:full-pathname = ?).
      108   if NOT found  then do:
      109     if not silence then do:
      110       message error-msg-text
      111       view-as alert-box ERROR.
      112       return error.
      113     end.
      114     else return error error-msg-text.
      115   end.
      116   END PROCEDURE.
      117   define new global shared variable g#library  as handle no-undo .
      118   define new global shared variable g#library2 as handle no-undo .
      119   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120     define variable v-cntxt-db-num        as integer   no-undo .
      121     define variable v-cntxt-userid        as character no-undo .
      122     define variable v-cntxt-level         as character no-undo .
      123     define variable v-cntxt-host-code-obj as integer   no-undo .
      124     define variable v-cntxt-obj-type      as character no-undo .
      125     define variable v-cntxt-obj-code      as integer   no-undo .
      126     define variable v-cntxt-db-num-obj    as integer   no-undo .
      127     define variable v-cntxt-is-admin      as logical   no-undo .
      128   define variable loc#log as logical no-undo.
      129   define variable v-can-edit as logical no-undo .
      130   define variable v-long-obj-code as integer no-undo .
      131   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132     run mainmenu_getcntxt in parparentproc
      133       (output v-cntxt-db-num
      134       ,output v-cntxt-userid
      135       ,output v-cntxt-level
      136       ,output v-cntxt-host-code-obj
      137       ,output v-cntxt-obj-type
      138       ,output v-cntxt-obj-code
      139       ,output v-cntxt-db-num-obj
      140       ,output v-cntxt-is-admin
      141       ) .
      142   case b-clients.obj-type
      143   :
      144     when 'орг':U
      145     then do:
      146   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      147   do:
      148     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      149       (input  v-cntxt-db-num
      150       ,input  v-cntxt-userid
      151       ,input  0
      152       ,input  'actn_client-reference_add-del':U
      153       ,input  'global':U
      154       ,input  0
      155       ,input  '':U
      156       ,input  0
      157       ,input  0
      158       ,input  0
      159       ,input  0
      160       ,input  true
      161       ,output v-can-edit
      162       )  .
      163   end.
      164     end.
      165     when 'чел':U
      166     then do:
      167   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      168   do:
      169     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      170       (input  v-cntxt-db-num
      171       ,input  v-cntxt-userid
      172       ,input  0
      173       ,input  'actn_client-reference-prs_add-del':U
      174       ,input  'global':U
      175       ,input  0
      176       ,input  '':U
      177       ,input  0
      178       ,input  0
      179       ,input  0
      180       ,input  0
      181       ,input  true
      182       ,output v-can-edit
      183       )  .
      184   end.
      185     end.
      186     otherwise do:
      187       message
      188         vss-workfile vss-revision vss-description skip
      189         "Неизестное значение типа клиента" skip
      190         "Тип клиента" b-clients.obj-type skip
      191         "Код клиента" b-clients.obj-code skip
      192         view-as alert-box error .
      193       return.
      194     end.
      195   end case.
      196   assign
      197     v-long-obj-code = (if b-clients.obj-type = 'орг':U
      198                        then exp(10, 9)
      199                        else 0
      200                       )
      201                     + b-clients.obj-code
      202   .
      203   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      204   define variable stat                 as character no-undo .
      205   define variable Path-To-Dir-Pictures as character no-undo .
      206   define variable Path-To-Pictures     as character no-undo .
      207   define variable v-ii                 as integer no-undo .
      208   define variable v-param-type as character no-undo .
      209   define variable v-value-date as date no-undo .
      210   define variable v-value-decimal as decimal no-undo .
      211   define variable v-value-integer as INTEGER no-undo .
      212   define variable v-value-logical AS LOGICAL no-undo .
      213   define variable v-tth as handle no-undo .
      214   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      215   DEFINE VARIABLE v-image-order      AS CHARACTER NO-UNDO INIT "jpg,bmp":U.
      216   define variable v-image-format     as character extent 62 init
      217   [
      218    "Windows bitmap                                                          ", "*.bmp"
      219   ,"Computer-aided Acquisition and Logistics Support                        ", "*.cal"
      220   ,"Microsoft Windows Clipboard                                             ", "*.clp"
      221   ,"Halo CUT                                                                ", "*.cut"
      222   ,"Intel FAX format                                                        ", "*.dcx"
      223   ,"Windows device-independent bitmap                                       ", "*.dib"
      224   ,"Encapsulated PostScript                                                 ", "*.eps"
      225   ,"1 Graphics Interchange Format                                           ", "*.gif"
      226   ,"IBM IOCA                                                                ", "*.ica"
      227   ,"Microsoft Icon File format                                              ", "*.ico"
      228   ,"Amiga IFF                                                               ", "*.iff"
      229   ,"GEM bitmap                                                              ", "*.img"
      230   ,"Joint Bi-level Image Experts Group                                      ", "*.jbig"
      231   ,"JPEG                                                                    ", "*.jpg"
      232   ,"serView                                                                 ", "*.lv "
      233   ,"Macintosh MacPaint                                                      ", "*.mac"
      234   ,"Microsoft Windows Paint                                                 ", "*.msp"
      235   ,"Kodak Photo CD                                                          ", "*.pcd"
      236   ,"Macintosh PICT                                                          ", "*.pct"
      237   ,"PC Paintbrush                                                           ", "*.pcx"
      238   ,"GIF (Graphics Interchange Format) replacement                           ", "*.png"
      239   ,"Adobe Photoshop                                                         ", "*.psd"
      240   ,"Sun Raster (1-, 8-, 24-, or 32-bit Standard, BGR, RGB, and byte encoded)", "*.ras"
      241   ,"TARGA                                                                   ", "*.tga"
      242   ,"Tag image file format                                                   ", "*.tif"
      243   ,"Windows bitmap for wireless devices                                     ", "*.wbmp"
      244   ,"Windows metafiles                                                       ", "*.wmf"
      245   ,"WordPerfect graphics                                                    ", "*.wpg"
      246   ,"(also .bm) X bitmap                                                     ", "*.xbm"
      247   ,"Pixmap                                                                  ", "*.xpm"
      248   ,"UNIX X Window Dump File format                                          ", "*.xwd"
      249   ] no-undo.
      250   procedure get-custom-img-order :
      251   define output parameter p-descriptions as character no-undo .
      252   define output parameter p-extensiond   as character no-undo .
      253   define output parameter p-extensiont   as character no-undo .
      254   define variable ii as integer no-undo .
      255   define variable v-entry as integer no-undo .
      256     do
      257     on error undo, return error
      258     :
      259       assign
      260       p-descriptions = fill(chr(4), 30)
      261       p-extensiond   = fill(chr(4), 30)
      262       p-extensiont   = fill(chr(4), 30)
      263       .
      264       do ii = 2 to 62 by 2:
      265         assign
      266         v-entry = lookup(left-trim(v-image-format[ii], ".*"), v-image-order)
      267         .
      268         if v-entry > 0 then do:
      269           assign
      270           entry(v-entry, p-descriptions, chr(4)) = substitute("&1 &2", trim(v-image-format[ii - 1]), v-image-format[ii])
      271           entry(v-entry, p-extensiond, chr(4)) = v-image-format[ii]
      272           entry(v-entry, p-extensiont, chr(4)) = left-trim(v-image-format[ii], ".*")
      273           .
      274         end.
      275       end.
      276       assign
      277       p-descriptions = trim(p-descriptions, chr(4))
      278       p-extensiond   = trim(p-extensiond, chr(4))
      279       p-extensiont   = trim(p-extensiont, chr(4))
      280       p-descriptions = replace(p-descriptions, (chr(4) + chr(4)), chr(4))
      281       p-extensiond   = replace(p-extensiond, (chr(4) + chr(4)),  chr(4))
      282       p-extensiont   = replace(p-extensiont, (chr(4) + chr(4)), chr(4))
      283       .
      284     end.
      285   end procedure.
      286   do:
      287     RUN verify-ini-entry("pict_path":U,
      288                           "REP-SETS":U,
      289                           "не определен путь к подкаталогу для хранения фото товара" + chr(10) +
      290                           "отсутствует параметр pict_path, секция [REP-SETS] ini-файла",
      291                           no,
      292                           output Path-To-Dir-Pictures) no-error.
      293     if error-status:error or Path-To-Dir-Pictures = ? then return error.
      294     RUN verify-file(Path-To-Dir-Pictures,
      295                     "Не найден каталог " + Path-To-Dir-Pictures + chr(10) +
      296                     "параметр pict_path, секция [REP-SETS] ini-файла",
      297                     no,
      298                     output loc#log) no-error.
      299     if error-status:error or not loc#log then return error.
      300     RUN verify-file((Path-To-Dir-Pictures + "cli\"),
      301                     "Не найден подкаталог " + Path-To-Dir-Pictures + "cli\",
      302                     no,
      303                     output loc#log) no-error.
      304     if error-status:error or not loc#log then return error.
      305     run adm/shattri.p (
      306         input "get":U
      307         ,input  ''
      308         ,input  0
      309         ,input  'images':U
      310         ,input  'imgorder':U
      311         ,output v-image-order
      312         ,output v-value-date
      313         ,output v-value-decimal
      314         ,output v-value-integer
      315         ,output v-value-logical
      316         ,output v-param-type
      317         ,INPUT-OUTPUT table-handle v-tth
      318         ) no-error .
      319     delete object v-tth.
      320     if error-status:error
      321     or v-image-order = '':U then
      322     v-image-order = "jpg,bmp".
      323      assign
      324      Path-To-Pictures = Path-To-Dir-Pictures + "cli\" + string( b-clients.obj-code )
      325      .
      326     if length( Path-To-Pictures ) > 56 then do:
      327       message
      328         "Слишком длинное имя файла ( с учетом полного пути )."
      329         view-as alert-box error .
      330     end.
      331     do v-ii = 1 to num-entries(v-image-order):
      332       assign
      333         stat = search( Path-To-Pictures  + "." + entry(v-ii, v-image-order) )
      334       .
      335       if stat <> ? then leave.
      336     end.
      337     if stat <> ? then do:
      338       run ref/view-pic.w ( Path-To-Pictures, entry(v-ii, v-image-order), if v-can-edit then "b-update" else "":U ) .
      339     end.
      340     else do:
      341       if not v-can-edit then do:
      342         message
      343         "Изображение отсутствует"
      344         view-as alert-box .
      345         RETURN.
      346       end.
      347       run ref/photo-n.w ( Path-To-Pictures, 'ДОБАВЛЕНИЕ':U  ) .
      348     end.
      349   end.
