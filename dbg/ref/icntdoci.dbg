      738   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      739   DO:
      740   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      741   if lookup(self :type
      742            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      743            ) = 0
      744   then do:
      745     message
      746       "$Workfile$"
      747       "Указанному интерфейсному элементу фокус не может быть передан" skip
      748       "Интерфейсный элемент" self :name  skip
      749       "Тип" self :type  skip
      750       "Процедура" this-procedure :file-name skip
      751       view-as alert-box .
      752   end.
      753   else do:
      754     apply "entry":u to self  .
      755     if focus :handle <> self :handle  then do:
      756       return no-apply .
      757     end.
      758   end.
      759     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      760     case p-mode:
      761       when 'ДОБАВЛЕНИЕ':U then do:
      762         MESSAGE
      763         "Выйти не сохранив все сделанные изменения?"
      764          VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
      765          IF NOT glog THEN RETURN NO-APPLY.
      766         if available locked_icnt-doc then
      767          delete locked_icnt-doc.
      768          p-recid = ?.
      769       end.
      770       WHEN 'ИЗМЕНЕНИЕ':U THEN DO:
      771         MESSAGE
      772         "Выйти не сохранив все сделанные изменения?"
      773         VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
      774         IF NOT glog THEN RETURN NO-APPLY.
      775       END.
      776     END CASE.
      777     p-next-prev = "quit".
      778   END.
      779   ON CHOOSE OF B-read IN FRAME Dialog-Frame
      780   DO:
      781   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      782   if lookup(self :type
      783            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      784            ) = 0
      785   then do:
      786     message
      787       "$Workfile$"
      788       "Указанному интерфейсному элементу фокус не может быть передан" skip
      789       "Интерфейсный элемент" self :name  skip
      790       "Тип" self :type  skip
      791       "Процедура" this-procedure :file-name skip
      792       view-as alert-box .
      793   end.
      794   else do:
      795     apply "entry":u to self  .
      796     if focus :handle <> self :handle  then do:
      797       return no-apply .
      798     end.
      799   end.
      800      run read-pump IN THIS-PROCEDURE NO-ERROR.
      801      IF ERROR-STATUS:ERROR THEN DO:
      802        message
      803        "Ошибка при чтении счетчиков ТРК" skip
      804        error-status:get-message(1) skip
      805        return-value view-as alert-box  error.
      806        return no-apply.
      807      END.
      808      RUN OpenBr IN THIS-PROCEDURE NO-ERROR.
      809   END.
      810   ON LEAVE OF tt-icnt-doc.boss IN FRAME Dialog-Frame
      811   DO:
      812     if input frame Dialog-Frame tt-icnt-doc.boss <> tt-icnt-doc.boss then do:
      813       run local-psn-chk in this-procedure ( input "boss", input "leave").
      814     end.
      815   END.
      816   ON MOUSE-SELECT-DBLCLICK OF tt-icnt-doc.boss IN FRAME Dialog-Frame
      817   OR RETURN OF tt-icnt-doc.boss IN FRAME Dialog-Frame DO:
      818     run local-psn-chk in this-procedure ( input "boss", input "ret-mouse").
      819     apply "entry" to tt-icnt-doc.boss in frame Dialog-Frame.
      820     return no-apply.
      821   END.
      822   ON CHOOSE OF r-agnt IN FRAME Dialog-Frame
      823   DO:
      824     run local-psn-chk in this-procedure ( input "agnt", input "button").
      825     apply "entry" to tt-icnt-doc.agnt in FRAME Dialog-Frame.
      826     return no-apply.
      827   END.
      828   ON CHOOSE OF r-boss IN FRAME Dialog-Frame
      829   DO:
      830     run local-psn-chk in this-procedure ( input "boss", input "button").
      831     apply "entry" to tt-icnt-doc.boss in FRAME Dialog-Frame.
      832     return no-apply.
      833   END.
      834   ON CHOOSE OF r-wrkr IN FRAME Dialog-Frame
      835   DO:
      836     run local-psn-chk in this-procedure ( input "wrkr", input "button").
      837     apply "entry" to tt-icnt-doc.wrkr in FRAME Dialog-Frame.
      838     return no-apply.
      839   END.
      840   ON LEAVE OF tt-icnt-doc.wrkr IN FRAME Dialog-Frame
      841   DO:
      842     if input frame Dialog-Frame tt-icnt-doc.wrkr <> tt-icnt-doc.wrkr then do:
      843       run local-psn-chk in this-procedure ( input "wrkr", input "leave").
      844     end.
      845   END.
      846   ON MOUSE-SELECT-DBLCLICK OF tt-icnt-doc.wrkr IN FRAME Dialog-Frame
      847   OR RETURN OF tt-icnt-doc.wrkr IN FRAME Dialog-Frame DO:
      848     run local-psn-chk in this-procedure ( input "wrkr", input "ret-mouse").
      849     apply "entry" to tt-icnt-doc.wrkr in frame Dialog-Frame.
      850     return no-apply.
      851   END.
      852   ON value-changed OF br-line do:
      853   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      854   if lookup(self :type
      855            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      856            ) = 0
      857   then do:
      858     message
      859       "$Workfile$"
      860       "Указанному интерфейсному элементу фокус не может быть передан" skip
      861       "Интерфейсный элемент" self :name  skip
      862       "Тип" self :type  skip
      863       "Процедура" this-procedure :file-name skip
      864       view-as alert-box .
      865   end.
      866   else do:
      867     apply "entry":u to self  .
      868     if focus :handle <> self :handle  then do:
      869       return no-apply .
      870     end.
      871   end.
      872   end.
      873   ON RETURN OF tt-icnt-line.state-mh-cnt IN BROWSE br-line,
      874               tt-icnt-line.state-el-cnt IN BROWSE br-line do:
      875     APPLY "LEAVE" to self.
      876   end.
      877   ON LEAVE OF tt-icnt-line.state-mh-cnt IN BROWSE br-line DO:
      878   define buffer buf_tt-icnt-line for tt-icnt-line.
      879   if tt-icnt-line.state-mh-cnt <> DECIMAL(tt-icnt-line.state-mh-cnt:SCREEN-VALUE IN BROWSE br-line) then do transaction:
      880      find first buf_tt-icnt-line exclusive-lock where
      881                 recid(buf_tt-icnt-line) = recid(tt-icnt-line).
      882      ASSIGN
      883      buf_tt-icnt-line.state-mh-cnt = DECIMAL(tt-icnt-line.state-mh-cnt:SCREEN-VALUE IN BROWSE br-line).
      884      display
      885      (tt-icnt-line.state-el-cnt - tt-icnt-line.state-mh-cnt) @ v-delta-line
      886      with  browse br-line.
      887      run recalc-icnt in this-procedure .
      888   end.
      889   run display-value in this-procedure .
      890   END.
      891   ON LEAVE OF tt-icnt-line.state-el-cnt IN BROWSE br-line DO:
      892   define buffer buf_tt-icnt-line for tt-icnt-line.
      893   if tt-icnt-line.state-el-cnt <> DECIMAL(tt-icnt-line.state-el-cnt:SCREEN-VALUE IN BROWSE br-line) then do transaction:
      894     find first buf_tt-icnt-line  exclusive-lock where
      895             recid(buf_tt-icnt-line) = recid(tt-icnt-line).
      896     ASSIGN
      897     buf_tt-icnt-line.state-el-cnt = DECIMAL(tt-icnt-line.state-el-cnt:SCREEN-VALUE IN BROWSE br-line).
      898     display
      899     (tt-icnt-line.state-el-cnt - tt-icnt-line.state-mh-cnt) @ v-delta-line
      900     with  browse br-line.
      901     run recalc-icnt in this-procedure .
      902   end.
      903   run display-value in this-procedure .
      904   END.
      905   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      906   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      907   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      908   on help of frame Dialog-Frame
      909   do:
      910     run gbl/app_help.p
      911       (input this-procedure :file-name
      912       ,input ''
      913       ,input ?
      914       ) no-error.
      915     if error-status :error then do:
      916       message
      917         "Ошибка при вызове помощи"
      918         error-status :get-message(1)
      919         view-as alert-box .
      920     end.
      921   end.
      922   run minbtn-set in this-procedure .
      923   on choose of b-help in frame Dialog-Frame
      924   do:
      925     apply "help":u to frame Dialog-Frame .
      926   end.
      927   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      928   procedure minbtn-set :
      929       do
      930           on error undo, return error return-value
      931           :
      932           define variable ii              as integer       no-undo .
      933           define variable fh              as widget-handle no-undo .
      934           define variable hh              as widget-handle no-undo .
      935           define variable v-h             as handle        extent 4 no-undo .
      936           define variable v-name-button   as character     no-undo .
      937           define variable v-help-old-x    as decimal       no-undo .
      938           define variable v-help-old-y    as decimal       no-undo .
      939           define variable v-help-old-size as decimal       no-undo .
      940           define variable v-frame-width   as decimal       no-undo .
      941           define variable jj              as integer       no-undo .
      942           do
      943               on error undo, return error
      944               :
      945               assign
      946                   v-frame-width = frame Dialog-Frame:width - 0.3
      947                   fh            = frame Dialog-Frame:first-child
      948                   hh            = fh:first-child
      949                   ii            = 1
      950                   .
      951               do while valid-handle(hh):
      952                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      953                   do:
      954                       case lc(hh:name) :
      955                           when "b-help" then
      956                               do:
      957                                   hh:load-image-up("cmp/b-help.bmp":u) .
      958                                   hh:load-image-down("cmp/b-help.bmp":u) .
      959                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      960                                   hh:TOOLTIP = "Помощь" .
      961                                   v-help-old-x = hh:column .
      962                                   v-help-old-y = hh:row    .
      963                                   v-help-old-size = hh:width .
      964                                   hh:width-chars = 2.5 .
      965                               end.
      966                           when "b-print" then
      967                               do:
      968                                   hh:load-image("cmp/b-print.bmp":u) .
      969                                   hh:TOOLTIP = "Печать" .
      970                                   v-h[ii] = hh:handle .
      971                                   ii = ii + 1 .
      972                                   hh:width-chars = 3 .
      973                               end.
      974                           when "b-history" or
      975                           when "b-hist" then
      976                               do:
      977                                   hh:load-image("cmp/b-hist.bmp":u) .
      978                                   hh:TOOLTIP = "История" .
      979                                   v-h[ii] = hh:handle .
      980                                   ii = ii + 1 .
      981                                   hh:width-chars = 3 .
      982                               end.
      983                           when "b-sch" then
      984                               do:
      985                                   hh:load-image("cmp/b-sch.bmp":u) .
      986                                   hh:TOOLTIP = "Установка Фильтра" .
      987                                   v-h[ii] = hh:handle .
      988                                   ii = ii + 1 .
      989                                   hh:width-chars = 3 .
      990                               end.
      991                           when "b-hist-user" then
      992                               do:
      993                                   hh:load-image("cmp/b-hist.bmp":u) .
      994                                   hh:TOOLTIP = "История пользователя" .
      995                                   ii = ii + 1 .
      996                               end.
      997                       end case.
      998                   end.
      999                   hh = hh:next-sibling.
     1000               end.
     1001               b-help:column = v-frame-width - b-help:width-chars.
     1002               jj = 0.
     1003               repeat ii = 4 to 1 by -1 :
     1004                   if valid-handle (v-h[ii] ) then
     1005                   do:
     1006                       jj  = jj + 1 .
     1007                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1008                       v-h[ii]:row    = v-help-old-y .
     1009                   end.
     1010               end.
     1011           end.
     1012       end.
     1013   end procedure.
     1014   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1015   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1016   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1017   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1018   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1019   define variable v-diasize-current-frame-height as decimal   no-undo .
     1020   define variable v-diasize-change-size          as logical   no-undo .
     1021   define variable v-diasize-resize-button        as handle    no-undo .
     1022   define variable v-diasize-wndmax               as logical   no-undo .
     1023   define variable v-diasize-wndstore             as logical   no-undo .
     1024   define variable v-diasize-proc-name            as character no-undo .
     1025   define variable v-diasize-browse-handle        as handle    no-undo .
     1026   define variable v-diasize-browse-number        as integer   no-undo .
     1027   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1028   define temp-table temp-diasize-handle no-undo
     1029     field handle-value  as handle
     1030     field save-position as decimal
     1031     index xpk is primary unique handle-value
     1032     .
     1033   define temp-table temp-browse-handle no-undo
     1034     field browse-type   as character
     1035     field browse-number as integer
     1036     field browse-handle as handle
     1037     field original-size as decimal
     1038     index xpk is primary unique browse-type browse-number
     1039     index xie browse-type browse-handle
     1040   .
     1041   procedure diasize_change-height :
     1042     define input  parameter p-change-value  as decimal   no-undo .
     1043     define input  parameter p-move-resize   as logical   no-undo .
     1044     define variable v-field-group-handle    as handle    no-undo .
     1045     define variable v-object-handle         as handle    no-undo .
     1046     define variable v-frame-height          as decimal   no-undo .
     1047     define variable v-frame-virtual-height  as decimal   no-undo .
     1048     define variable v-browse-height         as decimal   no-undo .
     1049     define variable v-window-height         as decimal   no-undo .
     1050     define variable v-window-virtual-height as decimal   no-undo .
     1051     define variable v-change-sign           as integer   no-undo .
     1052     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1053     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1054     if p-change-value > 0
     1055     then do:
     1056       if frame Dialog-Frame :height + p-change-value
     1057           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1058       then do:
     1059         assign
     1060           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1061                           - (frame Dialog-Frame :height-chars)
     1062         .
     1063         if p-change-value <= 0
     1064         then do:
     1065           run diasize_position-resize-button in this-procedure .
     1066           return .
     1067         end.
     1068       end.
     1069     end.
     1070     if p-change-value < 0
     1071     then do:
     1072       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1073       then do:
     1074         assign
     1075           p-change-value = v-diasize-orig-frame-height
     1076                          - (frame Dialog-Frame :height-chars)
     1077         .
     1078         if p-change-value >= 0
     1079         then do:
     1080           run diasize_position-resize-button in this-procedure .
     1081           return .
     1082         end.
     1083       end.
     1084     end.
     1085     if p-change-value >= 0
     1086     then do:
     1087       assign
     1088         v-change-sign = 1
     1089       .
     1090     end.
     1091     else do:
     1092       assign
     1093         v-change-sign = -1
     1094       .
     1095     end.
     1096     assign
     1097       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1098     .
     1099     if p-change-value = 0
     1100     then do:
     1101       run diasize_position-resize-button in this-procedure .
     1102       return .
     1103     end.
     1104     move_block:
     1105     do
     1106     on error undo move_block, retry move_block
     1107     :
     1108       if retry
     1109       then do:
     1110         do
     1111         on error undo move_block, leave move_block
     1112         :
     1113           if p-change-value > 0
     1114           then do:
     1115             for each buf_temp-diasize-handle
     1116             on error undo, next
     1117             :
     1118               assign
     1119                 v-object-handle = buf_temp-diasize-handle.handle-value
     1120               .
     1121               if v-object-handle <> v-diasize-resize-button
     1122               then do:
     1123                 assign
     1124                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1125                 .
     1126               end.
     1127             end.
     1128             assign
     1129               v-diasize-browse-handle :height = v-browse-height
     1130             .
     1131             for each buf_temp-browse-handle
     1132               where buf_temp-browse-handle.browse-type = 'height':u
     1133             on error undo, next
     1134             :
     1135               assign
     1136                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1137               .
     1138             end.
     1139             assign
     1140               frame Dialog-Frame :height = v-frame-height
     1141             .
     1142             if frame Dialog-Frame :scrollable = true
     1143             then do:
     1144               assign
     1145                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1146               .
     1147             end.
     1148             run diasize_position-resize-button in this-procedure .
     1149           end.
     1150           else do:
     1151             if frame Dialog-Frame :scrollable = true
     1152             then do:
     1153               assign
     1154                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1155               .
     1156             end.
     1157             assign
     1158               frame Dialog-Frame :height = v-frame-height
     1159             .
     1160             assign
     1161               v-diasize-browse-handle :height = v-browse-height
     1162             .
     1163             for each buf_temp-browse-handle
     1164               where buf_temp-browse-handle.browse-type = 'height':u
     1165             on error undo, next
     1166             :
     1167               assign
     1168                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1169               .
     1170             end.
     1171             for each buf_temp-diasize-handle
     1172             on error undo, next
     1173             :
     1174               assign
     1175                 v-object-handle = buf_temp-diasize-handle.handle-value
     1176               .
     1177               if v-object-handle <> v-diasize-resize-button
     1178               then do:
     1179                 assign
     1180                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1181                 .
     1182               end.
     1183             end.
     1184             run diasize_position-resize-button in this-procedure .
     1185           end.
     1186           assign
     1187             v-diasize-change-size = false
     1188           .
     1189           leave move_block .
     1190         end.
     1191       end.
     1192       assign
     1193         v-diasize-need-full-display = true
     1194       .
     1195       if v-diasize-change-size = false
     1196       then do:
     1197         assign
     1198           v-diasize-change-size = true
     1199         .
     1200       end.
     1201       else do:
     1202         return .
     1203       end.
     1204       assign
     1205         v-frame-height = frame Dialog-Frame :height
     1206         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1207         v-browse-height = v-diasize-browse-handle :height
     1208       .
     1209       for each buf_temp-browse-handle
     1210         where buf_temp-browse-handle.browse-type = 'height':u
     1211       :
     1212         assign
     1213           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1214         .
     1215       end.
     1216       for each buf_temp-diasize-handle
     1217       :
     1218         delete buf_temp-diasize-handle .
     1219       end.
     1220       assign
     1221         v-field-group-handle = frame Dialog-Frame :first-child
     1222       .
     1223       do while valid-handle(v-field-group-handle)
     1224       :
     1225         assign
     1226           v-object-handle = v-field-group-handle :first-child
     1227         .
     1228         do while valid-handle(v-object-handle)
     1229         :
     1230           if  v-object-handle <> v-diasize-browse-handle :handle
     1231           and can-query(v-object-handle, "row")
     1232           and can-query(v-object-handle, "height")
     1233           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1234           then do:
     1235             find first buf_temp-browse-handle
     1236               where buf_temp-browse-handle.browse-type   = 'height':u
     1237                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1238               no-error .
     1239             if available buf_temp-browse-handle
     1240             then do:
     1241             end.
     1242             else do:
     1243               create buf_temp-diasize-handle .
     1244               assign
     1245                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1246                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1247               .
     1248             end.
     1249           end.
     1250           assign
     1251             v-object-handle = v-object-handle :next-sibling
     1252           .
     1253         end.
     1254         assign
     1255           v-field-group-handle = v-field-group-handle :next-sibling
     1256         .
     1257       end.
     1258       do with frame Dialog-Frame
     1259       :
     1260         hide v-diasize-resize-button .
     1261         assign
     1262           v-diasize-resize-button :row    = 1
     1263           v-diasize-resize-button :column = 1
     1264         .
     1265       end.
     1266       if p-change-value > 0
     1267       then do:
     1268         if frame Dialog-Frame :scrollable = true
     1269         then do:
     1270           assign
     1271             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1272             no-error .
     1273           if error-status :error
     1274           or error-status :get-message(1) <> ""
     1275           then do:
     1276             undo move_block, retry move_block .
     1277           end.
     1278         end.
     1279         assign
     1280           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1281           no-error .
     1282         if error-status :error
     1283         or error-status :get-message(1) <> ""
     1284         then do:
     1285           undo move_block, retry move_block .
     1286         end.
     1287         assign
     1288           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1289           no-error .
     1290         if error-status :error
     1291         or error-status :get-message(1) <> ""
     1292         then do:
     1293           undo move_block, retry move_block .
     1294         end.
     1295         for each buf_temp-browse-handle
     1296           where buf_temp-browse-handle.browse-type = 'height':u
     1297         on error undo move_block, retry move_block
     1298         :
     1299           assign
     1300             buf_temp-browse-handle.browse-handle :height
     1301               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1302             no-error .
     1303           if error-status :error
     1304           or error-status :get-message(1) <> ""
     1305           then do:
     1306             undo move_block, retry move_block .
     1307           end.
     1308         end.
     1309         for each buf_temp-diasize-handle
     1310         on error undo move_block, retry move_block
     1311         :
     1312           assign
     1313             v-object-handle = buf_temp-diasize-handle.handle-value
     1314           .
     1315           if v-object-handle <> v-diasize-resize-button
     1316           then do:
     1317             assign
     1318               v-object-handle :row = v-object-handle :row + p-change-value
     1319               no-error .
     1320             if error-status :error
     1321             or error-status :get-message(1) <> ""
     1322             then do:
     1323               undo move_block, retry move_block .
     1324             end.
     1325           end.
     1326         end.
     1327       end.
     1328       else do:
     1329         for each buf_temp-diasize-handle
     1330         on error undo move_block, retry move_block
     1331         :
     1332           assign
     1333             v-object-handle = buf_temp-diasize-handle.handle-value
     1334           .
     1335           if v-object-handle <> v-diasize-resize-button
     1336           then do:
     1337             assign
     1338               v-object-handle :row = v-object-handle :row + p-change-value
     1339               no-error .
     1340             if error-status :error
     1341             or error-status :get-message(1) <> ""
     1342             then do:
     1343               undo move_block, retry move_block .
     1344             end.
     1345           end.
     1346         end.
     1347         assign
     1348           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1349           no-error .
     1350         if error-status :error
     1351         or error-status :get-message(1) <> ""
     1352         then do:
     1353           undo move_block, retry move_block .
     1354         end.
     1355         for each buf_temp-browse-handle
     1356           where buf_temp-browse-handle.browse-type = 'height':u
     1357         on error undo move_block, retry move_block
     1358         :
     1359           assign
     1360             buf_temp-browse-handle.browse-handle :height
     1361               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1362             no-error .
     1363           if error-status :error
     1364           or error-status :get-message(1) <> ""
     1365           then do:
     1366             undo move_block, retry move_block .
     1367           end.
     1368         end.
     1369         assign
     1370           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1371           no-error .
     1372         if error-status :error
     1373         or error-status :get-message(1) <> ""
     1374         then do:
     1375           undo move_block, retry move_block .
     1376         end.
     1377         if frame Dialog-Frame :scrollable = true
     1378         then do:
     1379           assign
     1380             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1381             no-error .
     1382           if error-status :error
     1383           or error-status :get-message(1) <> ""
     1384           then do:
     1385             undo move_block, retry move_block .
     1386           end.
     1387         end.
     1388       end.
     1389       if p-move-resize = true
     1390       then do:
     1391         run diasize_position-resize-button in this-procedure .
     1392       end.
     1393       if v-diasize-wndstore = true
     1394       then do:
     1395         if connected("ub") = true
     1396         then do:
     1397           define variable v-cntxt-db-num        as integer   no-undo .
     1398           define variable v-cntxt-userid        as character no-undo .
     1399           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1400                                             , OUTPUT v-cntxt-userid
     1401                                             ) .
     1402           run gbl/wndsizew.p
     1403             (input  v-cntxt-db-num
     1404             ,input  v-cntxt-userid
     1405             ,input  v-diasize-proc-name
     1406             ,input  'height':u
     1407             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1408             ) .
     1409         end.
     1410       end.
     1411     end.
     1412     assign
     1413       v-diasize-change-size = false
     1414     .
     1415   end procedure.
     1416   procedure diasize_set-height :
     1417     define input  parameter p-new-height  as decimal   no-undo .
     1418     define input  parameter p-move-resize as logical   no-undo .
     1419     do
     1420     on error undo, return error return-value
     1421     :
     1422       run diasize_change-height in this-procedure
     1423         (input  (p-new-height - frame Dialog-Frame :height)
     1424         ,input  p-move-resize
     1425         ) .
     1426     end.
     1427   end procedure.
     1428   procedure diasize_change-width :
     1429     define input  parameter p-change-value as decimal   no-undo .
     1430     define input  parameter p-move-resize  as logical   no-undo .
     1431     define variable v-field-group-handle   as handle    no-undo .
     1432     define variable v-object-handle        as handle    no-undo .
     1433     define variable v-frame-width          as decimal   no-undo .
     1434     define variable v-frame-virtual-width  as decimal   no-undo .
     1435     define variable v-browse-width         as decimal   no-undo .
     1436     define variable v-window-width         as decimal   no-undo .
     1437     define variable v-window-virtual-width as decimal   no-undo .
     1438     define variable v-change-sign          as integer   no-undo .
     1439     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1440     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1441     if p-change-value > 0
     1442     then do:
     1443       if frame Dialog-Frame :width + p-change-value >
     1444           session :width-chars
     1445       then do:
     1446         assign
     1447           p-change-value = session :width-chars - frame Dialog-Frame :width
     1448         .
     1449         if p-change-value <= 0
     1450         then do:
     1451           run diasize_position-resize-button in this-procedure .
     1452           return .
     1453         end.
     1454       end.
     1455     end.
     1456     if p-change-value < 0
     1457     then do:
     1458       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1459       then do:
     1460         assign
     1461           p-change-value = v-diasize-orig-frame-width
     1462                          - frame Dialog-Frame :width
     1463         .
     1464         if p-change-value >= 0
     1465         then do:
     1466           run diasize_position-resize-button in this-procedure .
     1467           return .
     1468         end.
     1469       end.
     1470     end.
     1471     if p-change-value >= 0
     1472     then do:
     1473       assign
     1474         v-change-sign = 1
     1475       .
     1476     end.
     1477     else do:
     1478       assign
     1479         v-change-sign = -1
     1480       .
     1481     end.
     1482     assign
     1483       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1484     .
     1485     if p-change-value = 0
     1486     then do:
     1487       run diasize_position-resize-button in this-procedure .
     1488       return .
     1489     end.
     1490     move_block:
     1491     do
     1492     on error undo move_block, leave move_block
     1493     :
     1494       if retry
     1495       then do:
     1496         do
     1497         on error undo move_block, leave move_block
     1498         :
     1499           if p-change-value > 0
     1500           then do:
     1501             for each buf_temp-diasize-handle
     1502             on error undo, next
     1503             :
     1504               assign
     1505                 v-object-handle = buf_temp-diasize-handle.handle-value
     1506               .
     1507               if v-object-handle <> v-diasize-resize-button
     1508               then do:
     1509                 assign
     1510                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1511                 .
     1512               end.
     1513             end.
     1514             assign
     1515               v-diasize-browse-handle :width = v-browse-width
     1516             .
     1517             for each buf_temp-browse-handle
     1518               where buf_temp-browse-handle.browse-type = 'width':u
     1519             on error undo, next
     1520             :
     1521               assign
     1522                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1523               .
     1524             end.
     1525             assign
     1526               frame Dialog-Frame :width = v-frame-width
     1527             .
     1528             if frame Dialog-Frame :scrollable = true
     1529             then do:
     1530               assign
     1531                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1532               .
     1533             end.
     1534             run diasize_position-resize-button in this-procedure .
     1535           end.
     1536           else do:
     1537             if frame Dialog-Frame :scrollable = true
     1538             then do:
     1539               assign
     1540                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1541               .
     1542             end.
     1543             assign
     1544               frame Dialog-Frame :width = v-frame-width
     1545             .
     1546             for each buf_temp-browse-handle
     1547               where buf_temp-browse-handle.browse-type = 'width':u
     1548             on error undo, next
     1549             :
     1550               assign
     1551                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1552               .
     1553             end.
     1554             assign
     1555               v-diasize-browse-handle :width = v-browse-width
     1556             .
     1557             for each buf_temp-diasize-handle
     1558             on error undo, next
     1559             :
     1560               assign
     1561                 v-object-handle = buf_temp-diasize-handle.handle-value
     1562               .
     1563               if v-object-handle <> v-diasize-resize-button
     1564               then do:
     1565                 assign
     1566                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1567                 .
     1568               end.
     1569             end.
     1570             run diasize_position-resize-button in this-procedure .
     1571           end.
     1572           assign
     1573             v-diasize-change-size = false
     1574           .
     1575           leave move_block .
     1576         end.
     1577       end.
     1578       assign
     1579         v-diasize-need-full-display = true
     1580       .
     1581       if v-diasize-change-size = false
     1582       then do:
     1583         assign
     1584           v-diasize-change-size = true
     1585         .
     1586       end.
     1587       else do:
     1588         return .
     1589       end.
     1590       assign
     1591         v-frame-width = frame Dialog-Frame :width
     1592         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1593         v-browse-width = v-diasize-browse-handle :width
     1594       .
     1595       for each buf_temp-browse-handle
     1596         where buf_temp-browse-handle.browse-type = 'width':u
     1597       :
     1598         assign
     1599           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1600         .
     1601       end.
     1602       for each buf_temp-diasize-handle
     1603       :
     1604         delete buf_temp-diasize-handle .
     1605       end.
     1606       assign
     1607         v-field-group-handle = frame Dialog-Frame :first-child
     1608       .
     1609       do while valid-handle(v-field-group-handle)
     1610       :
     1611         assign
     1612           v-object-handle = v-field-group-handle :first-child
     1613         .
     1614         do while valid-handle(v-object-handle)
     1615         :
     1616           if  v-object-handle <> v-diasize-browse-handle :handle
     1617           and v-object-handle <> v-diasize-resize-button
     1618           and can-query(v-object-handle, "row")
     1619           and can-query(v-object-handle, "height")
     1620           and ( v-object-handle :col + v-object-handle :width
     1621                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1622               )
     1623           then do:
     1624             find first buf_temp-browse-handle
     1625               where buf_temp-browse-handle.browse-type   = 'width':u
     1626                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1627               no-error .
     1628             if available buf_temp-browse-handle
     1629             then do:
     1630             end.
     1631             else do:
     1632               create buf_temp-diasize-handle .
     1633               assign
     1634                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1635                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1636               .
     1637             end.
     1638           end.
     1639           assign
     1640             v-object-handle = v-object-handle :next-sibling
     1641           .
     1642         end.
     1643         assign
     1644           v-field-group-handle = v-field-group-handle :next-sibling
     1645         .
     1646       end.
     1647       do with frame Dialog-Frame
     1648       :
     1649         hide v-diasize-resize-button .
     1650         v-diasize-resize-button :row = 1.
     1651         v-diasize-resize-button :column = 1.
     1652       end.
     1653       if p-change-value > 0
     1654       then do:
     1655         if frame Dialog-Frame :scrollable = true
     1656         then do:
     1657           assign
     1658             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1659             no-error .
     1660           if error-status :error
     1661           or error-status :get-message(1) <> ""
     1662           then do:
     1663             undo move_block, retry move_block.
     1664           end.
     1665         end.
     1666         assign
     1667           frame Dialog-Frame :width = v-frame-width + p-change-value
     1668           no-error .
     1669         if error-status :error
     1670         or error-status :get-message(1) <> ""
     1671         then do:
     1672           undo move_block, retry move_block.
     1673         end.
     1674         assign
     1675           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1676         no-error .
     1677         if error-status :error
     1678         or error-status :get-message(1) <> ""
     1679         then do:
     1680           undo move_block, retry move_block.
     1681         end.
     1682         for each buf_temp-browse-handle
     1683           where buf_temp-browse-handle.browse-type = 'width':u
     1684         on error undo move_block, retry move_block
     1685         :
     1686           assign
     1687             buf_temp-browse-handle.browse-handle :width
     1688               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1689             no-error .
     1690           if error-status :error
     1691           or error-status :get-message(1) <> ""
     1692           then do:
     1693             undo move_block, retry move_block .
     1694           end.
     1695         end.
     1696         for each buf_temp-diasize-handle
     1697         on error undo move_block, retry move_block
     1698         :
     1699           assign
     1700             v-object-handle = buf_temp-diasize-handle.handle-value
     1701           .
     1702           if v-object-handle <> v-diasize-resize-button
     1703           then do:
     1704             assign
     1705               v-object-handle :col = v-object-handle :col + p-change-value
     1706               no-error .
     1707             if error-status :error
     1708             or error-status :get-message(1) <> ""
     1709             then do:
     1710               undo move_block, retry move_block .
     1711             end.
     1712           end.
     1713         end.
     1714       end.
     1715       else do:
     1716         for each buf_temp-diasize-handle
     1717         on error undo move_block, retry move_block
     1718         :
     1719           assign
     1720             v-object-handle = buf_temp-diasize-handle.handle-value
     1721           .
     1722           if v-object-handle <> v-diasize-resize-button
     1723           then do:
     1724             assign
     1725               v-object-handle :col = v-object-handle :col + p-change-value
     1726               no-error .
     1727             if error-status :error
     1728             or error-status :get-message(1) <> ""
     1729             then do:
     1730               undo move_block, retry move_block .
     1731             end.
     1732           end.
     1733         end.
     1734         for each buf_temp-browse-handle
     1735           where buf_temp-browse-handle.browse-type = 'width':u
     1736         on error undo move_block, retry move_block
     1737         :
     1738           assign
     1739             buf_temp-browse-handle.browse-handle :width
     1740               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1741             no-error .
     1742           if error-status :error
     1743           or error-status :get-message(1) <> ""
     1744           then do:
     1745             undo move_block, retry move_block .
     1746           end.
     1747         end.
     1748         assign
     1749           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1750           no-error .
     1751         if error-status :error
     1752         or error-status :get-message(1) <> ""
     1753         then do:
     1754           undo move_block, retry move_block.
     1755         end.
     1756         assign
     1757           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1758         no-error .
     1759         if error-status :error
     1760         or error-status :get-message(1) <> ""
     1761         then do:
     1762           undo move_block, retry move_block.
     1763         end.
     1764         if frame Dialog-Frame :scrollable = true
     1765         then do:
     1766           assign
     1767             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1768           no-error .
     1769           if error-status :error
     1770           or error-status :get-message(1) <> ""
     1771           then do:
     1772             undo move_block, retry move_block.
     1773           end.
     1774         end.
     1775       end.
     1776       if p-move-resize
     1777       then do:
     1778         run diasize_position-resize-button in this-procedure .
     1779       end.
     1780       if v-diasize-wndstore = true
     1781       then do:
     1782         if connected("ub") = true
     1783         then do:
     1784           define variable v-cntxt-db-num        as integer   no-undo .
     1785           define variable v-cntxt-userid        as character no-undo .
     1786           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1787                                             , OUTPUT v-cntxt-userid
     1788                                             ) .
     1789           run gbl/wndsizew.p
     1790             (input  v-cntxt-db-num
     1791             ,input  v-cntxt-userid
     1792             ,input  v-diasize-proc-name
     1793             ,input  'width':u
     1794             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1795             ) .
     1796         end.
     1797       end.
     1798     end.
     1799     assign
     1800       v-diasize-change-size = false
     1801     .
     1802   end procedure.
     1803   procedure diasize_set-width :
     1804     define input  parameter p-new-width  as decimal   no-undo .
     1805     define input  parameter p-move-resize as logical   no-undo .
     1806     do
     1807     on error undo, return error return-value
     1808     :
     1809       run diasize_change-width in this-procedure
     1810         (input  (p-new-width - frame Dialog-Frame :width)
     1811         ,input  p-move-resize
     1812         ) .
     1813     end.
     1814   end procedure.
     1815   procedure diasize_position-resize-button :
     1816     do with frame Dialog-Frame
     1817     :
     1818       hide v-diasize-resize-button .
     1819       assign
     1820         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1821                     - 1
     1822                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1823         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1824                     - 1
     1825                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1826       .
     1827       view v-diasize-resize-button .
     1828     end.
     1829   end procedure.
     1830   on alt-right anywhere
     1831   do:
     1832     run diasize_change-width in this-procedure
     1833       (input 1
     1834       ,input true
     1835       ) .
     1836     return no-apply .
     1837   end.
     1838   on alt-left anywhere
     1839   do:
     1840     run diasize_change-width in this-procedure
     1841       (input -1
     1842       ,input true
     1843       ) .
     1844     return no-apply .
     1845   end.
     1846   on alt-down anywhere
     1847   do:
     1848     run diasize_change-height in this-procedure
     1849       (input 1
     1850       ,input true
     1851       ) .
     1852     return no-apply .
     1853   end.
     1854   on alt-up anywhere
     1855   do:
     1856     run diasize_change-height in this-procedure
     1857       (input -1
     1858       ,input true
     1859       ) .
     1860     return no-apply .
     1861   end.
     1862   on alt-enter of frame Dialog-Frame
     1863   do:
     1864     run diasize_maximize in this-procedure
     1865       (input  ?
     1866       ).
     1867     return no-apply .
     1868   end.
     1869   procedure diasize_end-move :
     1870     do
     1871     on error undo, return error return-value
     1872     :
     1873       define variable v-row-delta as decimal   no-undo .
     1874       define variable v-col-delta as decimal   no-undo .
     1875       define variable v-new-row as decimal   no-undo .
     1876       define variable v-new-col as decimal   no-undo .
     1877       assign
     1878         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1879         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1880       .
     1881       assign
     1882         v-row-delta = v-new-row - frame Dialog-Frame :height
     1883         v-col-delta = v-new-col - frame Dialog-Frame :width
     1884       .
     1885       run diasize_change-height in this-procedure
     1886         (input v-row-delta
     1887         ,input true
     1888         ) .
     1889       run diasize_change-width in this-procedure
     1890         (input v-col-delta
     1891         ,input true
     1892         ) .
     1893     end.
     1894   end procedure.
     1895   procedure diasize_maximize :
     1896     define input  parameter p-action as logical   no-undo .
     1897     do
     1898     on error undo, return error return-value
     1899     :
     1900       if p-action = ?
     1901       then do:
     1902         if v-diasize-need-maximize = true
     1903         then do:
     1904           assign
     1905             p-action = true
     1906           .
     1907         end.
     1908         else do:
     1909           assign
     1910             p-action = false
     1911           .
     1912         end.
     1913       end.
     1914       if p-action = true
     1915       then do:
     1916         run diasize_change-height in this-procedure
     1917           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1918               - frame Dialog-Frame :height-chars
     1919           ,input true
     1920           ) .
     1921         run diasize_change-width in this-procedure
     1922           (input session :width-chars
     1923               - frame Dialog-Frame :width-chars
     1924           ,input true
     1925           ) .
     1926         assign
     1927           v-diasize-need-maximize = false
     1928         .
     1929       end.
     1930       else do:
     1931         run diasize_change-width in this-procedure
     1932           (input v-diasize-orig-frame-width
     1933               - frame Dialog-Frame :width-chars
     1934           ,input true
     1935           ) .
     1936         run diasize_change-height in this-procedure
     1937           (input v-diasize-orig-frame-height
     1938               - frame Dialog-Frame :height-chars
     1939           ,input true
     1940           ) .
     1941         assign
     1942           v-diasize-need-maximize = true
     1943         .
     1944       end.
     1945     end.
     1946   end procedure.
     1947   procedure diasize_restore-orig-size :
     1948     do
     1949     on error undo, return error return-value
     1950     :
     1951       assign
     1952         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1953         v-diasize-current-frame-height = frame Dialog-Frame :height
     1954       .
     1955       run diasize_set-height in this-procedure
     1956         (input  v-diasize-orig-frame-height
     1957         ,input  true
     1958         ) .
     1959       run diasize_set-width in this-procedure
     1960         (input  v-diasize-orig-frame-width
     1961         ,input  true
     1962         ) .
     1963     end.
     1964   end procedure.
     1965   procedure diasize_restore-current-size :
     1966     do
     1967     on error undo, return error return-value
     1968     :
     1969       run diasize_set-height in this-procedure
     1970         (input  v-diasize-current-frame-height
     1971         ,input  true
     1972         ) .
     1973       run diasize_set-width in this-procedure
     1974         (input  v-diasize-current-frame-width
     1975         ,input  true
     1976         ) .
     1977     end.
     1978   end procedure.
     1979   procedure diasize_set-browse-handle :
     1980     define input  parameter p-browse-handle as handle   no-undo .
     1981     define buffer buf_temp-browse-handle for temp-browse-handle .
     1982     do
     1983     on error undo, return error return-value
     1984     :
     1985       assign
     1986         v-diasize-browse-handle = p-browse-handle
     1987       .
     1988       for each buf_temp-browse-handle
     1989       on error undo, return error return-value
     1990       :
     1991         delete buf_temp-browse-handle .
     1992       end.
     1993     end.
     1994   end procedure.
     1995   procedure diasize_add_browse :
     1996     define input  parameter p-browse-type   as character no-undo .
     1997     define input  parameter p-browse-handle as handle    no-undo .
     1998     define buffer buf_temp-browse-handle for temp-browse-handle .
     1999     do
     2000     on error undo, return error return-value
     2001     :
     2002       assign
     2003         v-diasize-browse-number = v-diasize-browse-number + 1
     2004       .
     2005       create buf_temp-browse-handle .
     2006       assign
     2007         buf_temp-browse-handle.browse-type   = p-browse-type
     2008         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2009         buf_temp-browse-handle.browse-handle = p-browse-handle
     2010       .
     2011     end.
     2012   end procedure.
     2013   procedure diasize_init :
     2014     define variable v-default-value    as logical   no-undo .
     2015     define variable v-restore-saved    as logical   no-undo .
     2016     define variable v-resize-value-str as character no-undo .
     2017     do
     2018     on error undo, return error return-value
     2019     :
     2020       do with frame Dialog-Frame
     2021       :
     2022         assign
     2023           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2024           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2025           v-diasize-browse-handle     = browse br-line :handle
     2026         .
     2027         create button v-diasize-resize-button
     2028         assign
     2029           parent        = frame Dialog-Frame :first-child
     2030           label         = "s"
     2031           height-pixels = 16
     2032           width-pixels  = 16
     2033           visible       = true
     2034           sensitive     = true
     2035           movable       = true
     2036           triggers:
     2037             on end-move persistent run diasize_end-move in this-procedure .
     2038           end triggers.
     2039         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2040         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2041         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2042         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2043         assign
     2044           v-diasize-wndmax = false
     2045         .
     2046         if connected("ub") = true
     2047         then do:
     2048           define variable v-cntxt-db-num        as integer   no-undo .
     2049           define variable v-cntxt-userid        as character no-undo .
     2050           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2051                                             , OUTPUT v-cntxt-userid
     2052                                             ) .
     2053           run gbl/wndpar_r.p
     2054             (input  v-cntxt-db-num
     2055             ,input  v-cntxt-userid
     2056             ,input  'wndmax':U
     2057             ,output v-diasize-wndmax
     2058             ,output v-default-value
     2059             ) .
     2060         end.
     2061         assign
     2062           v-diasize-wndstore = false
     2063         .
     2064         if connected("ub") = true
     2065         then do:
     2066           run gbl/wndpar_r.p
     2067             (input  v-cntxt-db-num
     2068             ,input  v-cntxt-userid
     2069             ,input  'wndstore':U
     2070             ,output v-diasize-wndstore
     2071             ,output v-default-value
     2072             ) .
     2073         end.
     2074         assign
     2075           v-diasize-proc-name = entry(1, program-name(2), '.')
     2076         .
     2077         if v-diasize-wndstore = true
     2078         then do:
     2079           assign
     2080             v-restore-saved = false
     2081           .
     2082           if connected("ub") = true
     2083           then do:
     2084             run gbl/wndsizer.p
     2085               (input  v-cntxt-db-num
     2086               ,input  v-cntxt-userid
     2087               ,input  v-diasize-proc-name
     2088               ,input  'height':u
     2089               ,output v-resize-value-str
     2090               ) .
     2091             if v-resize-value-str <> '':U
     2092             then do:
     2093               run diasize_change-height in this-procedure
     2094                 (input  integer(v-resize-value-str)
     2095                 ,input  true
     2096                 ) .
     2097               assign
     2098                 v-restore-saved = true
     2099               .
     2100             end.
     2101           end.
     2102           if connected("ub") = true
     2103           then do:
     2104             run gbl/wndsizer.p
     2105               (input  v-cntxt-db-num
     2106               ,input  v-cntxt-userid
     2107               ,input  v-diasize-proc-name
     2108               ,input  'width':u
     2109               ,output v-resize-value-str
     2110               ) .
     2111             if v-resize-value-str <> '':U
     2112             then do:
     2113               run diasize_change-width in this-procedure
     2114                 (input  integer(v-resize-value-str)
     2115                 ,input  true
     2116                 ) .
     2117               assign
     2118                 v-restore-saved = true
     2119               .
     2120             end.
     2121           end.
     2122           if v-restore-saved <> true
     2123           then do:
     2124             if v-diasize-wndmax = true
     2125             then do:
     2126               run diasize_maximize in this-procedure
     2127                 (input  true
     2128                 ) .
     2129             end.
     2130           end.
     2131         end.
     2132         else do:
     2133           if v-diasize-wndmax = true
     2134           then do:
     2135             run diasize_maximize in this-procedure
     2136               (input  true
     2137               ) .
     2138           end.
     2139         end.
     2140       end.
     2141     end.
     2142   end procedure.
     2143   procedure diasize_need-full-display :
     2144     define output parameter p-need-full-display as logical   no-undo .
     2145     do
     2146     on error undo, return error return-value
     2147     :
     2148       assign
     2149         p-need-full-display = v-diasize-need-full-display
     2150       .
     2151       assign
     2152         v-diasize-need-full-display = false
     2153       .
     2154     end.
     2155   end procedure.
     2156   procedure get-context :
     2157      define output parameter p-db-num as integer          no-undo.
     2158      define output parameter p-user-id as character        no-undo.
     2159      define variable v-login               as character    no-undo.
     2160      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2161      define buffer buf_user-login  for ub.user-login .
     2162      do
     2163      on error undo, return error
     2164      :
     2165            FIND FIRST buf_sys-ctrl no-lock.
     2166            ASSIGN
     2167               v-login = USERID("ub")
     2168               p-db-num = buf_sys-ctrl.db-num
     2169            .
     2170            FIND FIRST buf_user-login
     2171                 WHERE buf_user-login.db-num = p-db-num
     2172                   AND buf_user-login.user-login = v-login
     2173                 no-lock
     2174                 no-error
     2175                 .
     2176            IF AVAILABLE buf_user-login
     2177            THEN DO:
     2178               assign
     2179                  p-user-id = buf_user-login.user-id
     2180               .
     2181            END.
     2182      end.
     2183   end procedure.
     2184       run diasize_init in this-procedure .
     2185   def var sort-labelbr-line   as character no-undo .
     2186   def var sort-clmnbr-line    as handle    no-undo .
     2187   def var cur-clmnbr-line     as handle    no-undo .
     2188   def var cur-clmn-locbr-line as integer   no-undo .
     2189   def var re-querybr-line     as logical   initial no no-undo .
     2190   on start-search, ctrl-o of br-line in frame Dialog-Frame do:
     2191      run sort-brbr-line
     2192        (input (if available tt-icnt-line
     2193                then recid(tt-icnt-line)
     2194                else ?
     2195               )
     2196        ).
     2197   end.
     2198   PROCEDURE sort-brbr-line :
     2199     define input parameter p-recid as recid no-undo .
     2200     if re-querybr-line = no then do:
     2201       assign
     2202          cur-clmnbr-line = br-line:current-column in frame Dialog-Frame
     2203       .
     2204       if sort-clmnbr-line <> ? then sort-clmnbr-line:column-fgcolor = 0.
     2205       if cur-clmnbr-line = sort-clmnbr-line then do:
     2206         assign
     2207            sort-labelbr-line = ""
     2208            sort-clmnbr-line = ?
     2209         .
     2210        end.
     2211        else do:
     2212          assign
     2213            sort-labelbr-line = cur-clmnbr-line:label
     2214            sort-clmnbr-line  = cur-clmnbr-line
     2215            sort-clmnbr-line:column-fgcolor = 4
     2216          .
     2217        end.
     2218      end.
     2219     assign
     2220       cur-clmn-locbr-line = 1
     2221     .
     2222     def var column-handle as handle no-undo .
     2223     column-handle = br-line:first-column.
     2224     do while valid-handle(column-handle) :
     2225       if column-handle = cur-clmnbr-line then do:
     2226         leave .
     2227       end.
     2228       column-handle = column-handle:NEXT-COLUMN.
     2229       assign
     2230         cur-clmn-locbr-line = cur-clmn-locbr-line + 1
     2231       .
     2232     end.
     2233     case sort-labelbr-line:
     2234           when 'ТРК'  then DO:   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code BY tt-icnt-line.pump-code .   . END.
     2235           when 'Пис!то!лет'  then DO:   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code BY tt-icnt-line.nozzle-code .   . END.
     2236           when 'Артикул'  then DO:   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code BY buf_goods.artic .   . END.
     2237           when 'Показания!электронного!счетчика'  then DO:   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code BY tt-icnt-line.state-el-cnt .   . END.
     2238           when 'Показания!механического!счетчика'  then DO:   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code BY tt-icnt-line.state-mh-cnt .   . END.
     2239           when 'Разница'  then DO:   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code BY (tt-icnt-line.state-el-cnt - tt-icnt-line.state-mh-cnt) .   . END.
     2240           when 'Измерение!электронного!счетчика'  then DO:   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code BY tt-icnt-line.meas-el-cnt .   . END.
     2241           when 'Название товара'  then DO:   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code BY buf_goods.gds-name .   . END.
     2242           when 'Резервуар'  then DO:   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code BY tt-icnt-line.pl-code .   . END.
     2243       otherwise do:
     2244         run Openbr in this-procedure .
     2245           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-line') then do:
     2246             run mv-brw-defaultbr-line.
     2247           end.
     2248         if sort-labelbr-line <> "" then do:
     2249           assign
     2250             cur-clmnbr-line:column-fgcolor = 0
     2251           .
     2252         end.
     2253         assign
     2254           cur-clmn-locbr-line = ?
     2255         .
     2256       end.
     2257     end case.
     2258       if cur-clmn-locbr-line <> ? then do:
     2259         if can-do( this-procedure:internal-entries, 'ch-clmnbr-line') then do:
     2260           run ch-clmnbr-line in this-procedure (cur-clmn-locbr-line).
     2261         end.
     2262       end.
     2263     if p-recid <> ? then do:
     2264       reposition br-line to recid p-recid no-error.
     2265       apply "value-changed" to br-line in frame Dialog-Frame.
     2266     end.
     2267     apply "entry" to br-line in frame Dialog-Frame.
     2268   END PROCEDURE.
     2269   procedure re-open-query-srt-clmnbr-line:
     2270   if cur-clmnbr-line = ? then do:
     2271      run Openbr in this-procedure .
     2272   end.
     2273   else do:
     2274      assign re-querybr-line = yes.
     2275      run sort-brbr-line
     2276        (input (if available tt-icnt-line
     2277                then recid(tt-icnt-line)
     2278                else ?
     2279               )
     2280        ).
     2281      assign re-querybr-line = no.
     2282   end.
     2283   end.
     2284   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2285   on F9 of frame Dialog-Frame anywhere do:
     2286     run get-gds-rec.
     2287     if gds-rec = ? then
     2288       return no-apply.
     2289     run ref/gds-form.w ( input parparentproc
     2290                         ,input 'ПРОСМОТР':U
     2291                         ,input ?
     2292                         ,input ?
     2293                         ,input ?
     2294                         ,input-output gds-rec).
     2295     apply "entry" to br-line in frame Dialog-Frame.
     2296     return no-apply.
     2297   end.
     2298   p-next-prev = '':U.
     2299   v-mode = p-mode.
     2300   n-p:
     2301   do while p-next-prev = '':U :
     2302     MAIN-BLOCK:
     2303     DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2304        ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2305   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2306     run mainmenu_getcntxt in parparentproc
     2307       (output v-cntxt-db-num
     2308       ,output v-cntxt-userid
     2309       ,output v-cntxt-level
     2310       ,output v-cntxt-host-code-obj
     2311       ,output v-cntxt-obj-type
     2312       ,output v-cntxt-obj-code
     2313       ,output v-cntxt-db-num-obj
     2314       ,output v-cntxt-is-admin
     2315       ) .
     2316        if LOOKUP(p-mode, ('ИЗМЕНЕНИЕ':U  + chr(4) + 'ДОБАВЛЕНИЕ':U + chr(4) + 'ПРОСМОТР':U), chr(4) ) = 0 then do:
     2317             message
     2318             vss-workfile vss-revision vss-description skip
     2319             substitute("Неверный параметр вызова p-mode=&1", p-mode)
     2320             view-as alert-box ERROR.
     2321             undo, return error.
     2322         end.
     2323         if p-obj-type <> 'маг':U then DO:
     2324             message
     2325             vss-workfile vss-revision vss-description skip
     2326             substitute("Неверный параметр вызова p-obj-type=&1", p-obj-type)
     2327             view-as alert-box ERROR.
     2328             undo, return error.
     2329         end.
     2330         FIND FIRST buf_clients NO-LOCK WHERE
     2331                   buf_Clients.obj-type = p-obj-type
     2332              AND buf_clients.obj-code = p-obj-code NO-ERROR.
     2333         IF NOT AVAILABLE buf_clients THEN DO:
     2334           MESSAGE
     2335           substitute("Неверное значение параметров p-obj-type = &1 и/или p-obj-code=&2"
     2336                     , p-obj-type
     2337                     , p-obj-code)
     2338           VIEW-AS ALERT-BOX ERROR.
     2339           UNDO, RETURN ERROR.
     2340         END.
     2341   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2342   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2343     (input  p-obj-type
     2344     ,input  p-obj-code
     2345     ,output v-host-code
     2346     )  .
     2347         if not p-mode = 'ПРОСМОТР':U THEN DO:
     2348            p-next-prev = '':U.
     2349           IF buf_clients.db-num <> v-cntxt-db-num THEN DO:
     2350               MESSAGE
     2351               substitute("Неверное значение параметров p-obj-type = &1 и/или p-obj-code=&2&3" +
     2352                         "Добавление и изменение документа счетчиков ТРК возможно только в БД объекта&3" +
     2353                         "БД для &1&2 - &4, текущая БД - &5"
     2354                         , p-obj-type
     2355                         , p-obj-code
     2356                         , chr(10)
     2357                         , buf_clients.db-num
     2358                         , v-cntxt-db-num)
     2359               VIEW-AS ALERT-BOX ERROR.
     2360               UNDO, RETURN ERROR.
     2361           END.
     2362         END.
     2363         if p-mode <> 'ПРОСМОТР':U then do:
     2364           p-next-prev = "quit".
     2365         end.
     2366         run fill-tables in this-procedure no-error.
     2367         if error-status:error then return error.
     2368         RUN Myenable IN THIS-PROCEDURE.
     2369         IF new-opened THEN DO:
     2370   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2371   DEF VAR cur-clmn-numbr-line as INT EXTENT 9 no-undo.
     2372   DEF VAR varmvibr-line       as INT no-undo.
     2373   DEF VAR varmvjbr-line       as INT no-undo.
     2374   DEF VAR varmvkbr-line       as INT no-undo.
     2375   DEF VAR varmvlbr-line       as INT no-undo.
     2376   DEF VAR move-elementbr-line as INT no-undo.
     2377   def var jjbr-line           as int no-undo.
     2378   do varmvibr-line = 1 to EXTENT(cur-clmn-numbr-line):
     2379     ASSIGN cur-clmn-numbr-line[varmvibr-line] = varmvibr-line.
     2380   END.
     2381   RUN start-mv-clmnbr-line.
     2382   PROCEDURE start-mv-clmnbr-line:
     2383   def var old-session as logical no-undo.
     2384      old-session = SESSION:IMMEDIATE-DISPLAY.
     2385      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2386      SESSION:IMMEDIATE-DISPLAY = old-session.
     2387   END.
     2388   ON ctrl-cursor-right OF BROWSE br-line do:
     2389     RUN re-move-clmnbr-line ( 4, 9).
     2390   END.
     2391   ON ctrl-cursor-left OF BROWSE br-line do:
     2392     RUN re-move-clmnbr-line (9, 4).
     2393   END.
     2394   PROCEDURE re-move-clmnbr-line:
     2395     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2396     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2397     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     2398       if cur-clmn-numbr-line[varmvibr-line] = source-column THEN cur-clmn-numbr-line[varmvibr-line] = -1.
     2399     END.
     2400     if br-line:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2401     if source-column > target-column THEN
     2402     DO varmvjbr-line = source-column - 1 to target-column BY -1:
     2403       DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     2404           if cur-clmn-numbr-line[varmvibr-line] = varmvjbr-line THEN DO:
     2405             cur-clmn-numbr-line[varmvibr-line] = cur-clmn-numbr-line[varmvibr-line] + 1.
     2406           END.
     2407       END.
     2408     END.
     2409     ELSE
     2410     DO varmvjbr-line = source-column + 1 to target-column:
     2411       DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     2412         if cur-clmn-numbr-line[varmvibr-line] = varmvjbr-line THEN DO:
     2413           cur-clmn-numbr-line[varmvibr-line] = cur-clmn-numbr-line[varmvibr-line] - 1.
     2414         END.
     2415       END.
     2416     END.
     2417     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     2418       if cur-clmn-numbr-line[varmvibr-line] = -1 THEN cur-clmn-numbr-line[varmvibr-line] = target-column.
     2419     END.
     2420   END PROCEDURE.
     2421   PROCEDURE ch-clmnbr-line:
     2422     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2423     if cur-clmn-loc <= 4 then do:
     2424       return .
     2425     end.
     2426     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     2427       if cur-clmn-numbr-line[varmvibr-line] = cur-clmn-loc THEN move-elementbr-line = varmvibr-line.
     2428     END.
     2429     RUN re-move-clmnbr-line (cur-clmn-loc, 4).
     2430   END PROCEDURE.
     2431   PROCEDURE mv-brw-defaultbr-line:
     2432   def var old-session as logical no-undo.
     2433     old-session = SESSION:IMMEDIATE-DISPLAY.
     2434     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2435     do varmvlbr-line = 4 to EXTENT(cur-clmn-numbr-line):
     2436       RUN re-move-clmnbr-line (cur-clmn-numbr-line[varmvlbr-line], varmvlbr-line).
     2437     END.
     2438     RUN start-mv-clmnbr-line.
     2439     SESSION:IMMEDIATE-DISPLAY = old-session.
     2440   END PROCEDURE.
     2441   .
     2442           new-opened = no.
     2443         END.
     2444         run waitfram-hide in this-procedure .
     2445         WAIT-FOR GO OF FRAME Dialog-Frame.
     2446       END.
     2447   END.
     2448   RUN disable_UI.
     2449   PROCEDURE disable_UI :
     2450     HIDE FRAME Dialog-Frame.
     2451   END PROCEDURE.
     2452   PROCEDURE display-value :
     2453   display
     2454   tt-icnt-doc.state-el-cnt
     2455   tt-icnt-doc.state-mh-cnt
     2456   (tt-icnt-doc.state-el-cnt - tt-icnt-doc.state-mh-cnt) @ v-delta
     2457   tt-icnt-doc.meas-el-cnt
     2458   with frame Dialog-Frame.
     2459   END PROCEDURE.
     2460   PROCEDURE enable_UI :
     2461     DISPLAY wrkr-name agnt-name boss-name v-delta
     2462         WITH FRAME Dialog-Frame.
     2463     IF AVAILABLE buf_clients THEN
     2464       DISPLAY buf_clients.obj-name
     2465         WITH FRAME Dialog-Frame.
     2466     IF AVAILABLE tt-icnt-doc THEN
     2467       DISPLAY tt-icnt-doc.doc-date tt-icnt-doc.fact-date tt-icnt-doc.shift-date
     2468             tt-icnt-doc.shift-num tt-icnt-doc.shift-name tt-icnt-doc.wrkr
     2469             tt-icnt-doc.agnt tt-icnt-doc.boss tt-icnt-doc.obj-code
     2470             tt-icnt-doc.obj-type tt-icnt-doc.state-el-cnt tt-icnt-doc.state-mh-cnt
     2471             tt-icnt-doc.meas-el-cnt
     2472         WITH FRAME Dialog-Frame.
     2473     ENABLE B-exit b-quit b-prev b-next B-read B-notes B-hist B-Help
     2474            tt-icnt-doc.doc-date tt-icnt-doc.fact-date tt-icnt-doc.shift-date
     2475            tt-icnt-doc.shift-num tt-icnt-doc.shift-name tt-icnt-doc.wrkr r-wrkr
     2476            tt-icnt-doc.agnt r-agnt tt-icnt-doc.boss r-boss br-line
     2477            tt-icnt-doc.obj-code tt-icnt-doc.obj-type buf_clients.obj-name
     2478            wrkr-name tt-icnt-doc.state-el-cnt agnt-name tt-icnt-doc.state-mh-cnt
     2479            boss-name v-delta tt-icnt-doc.meas-el-cnt
     2480         WITH FRAME Dialog-Frame.
     2481     VIEW FRAME Dialog-Frame.
     2482     OPEN QUERY br-line FOR EACH tt-icnt-line NO-LOCK WHERE     tt-icnt-line.doc-code = tt-icnt-doc.doc-code ,                     FIRST buf_goods OUTER-JOIN WHERE             buf_goods.gds-code        = tt-icnt-line.gds-code NO-LOCK.
     2483   END PROCEDURE.
     2484   PROCEDURE fill-tables :
     2485   define variable v-today as date      no-undo.
     2486   define buffer buf_pump-nozzle    for ub.pump-nozzle.
     2487   define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
     2488   define buffer buf_pl-gds         for ub.pl-gds.
     2489   define buffer old_icnt-doc for ub.icnt-doc.
     2490   define buffer buf_rvs-doc   for ub.rvs-doc.
     2491   FOR EACH tt-icnt-line:
     2492       DELETE tt-icnt-line.
     2493   END.
     2494   FOR EACH tt-icnt-doc:
     2495       DELETE tt-icnt-doc.
     2496   END.
     2497   IF p-mode = 'ДОБАВЛЕНИЕ':U then do:
     2498     find first buf_rvs-doc where
     2499               buf_rvs-doc.obj-type =  p-obj-type
     2500         and  buf_rvs-doc.obj-code =  p-obj-code
     2501         and  buf_rvs-doc.status_  <> 'факт':U
     2502         and  buf_rvs-doc.rvs-type <> 'перед_док':U
     2503         and  buf_rvs-doc.rvs-type <> 'после_док':U
     2504         and  buf_rvs-doc.rvs-type <> 'проверка':U no-lock no-error.
     2505     if available buf_rvs-doc then do:
     2506       message
     2507       substitute("Имеется открытый документ сверки под номером &1", buf_rvs-doc.rvs-code)
     2508       view-as alert-box error.
     2509       undo, return error .
     2510     end.
     2511     find first old_icnt-doc where old_icnt-doc.obj-type =  p-obj-type and
     2512                                   old_icnt-doc.obj-code =  p-obj-code and
     2513                                   old_icnt-doc.status_  <> 'факт':U    no-lock no-error.
     2514     if available old_icnt-doc then do:
     2515       message
     2516       SUBSTITuTE("Уже есть открытый документ инвентаризации счетчиков ТРК под номером &1"
     2517                   ,old_icnt-doc.doc-code)
     2518       view-as alert-box error.
     2519       undo, return error.
     2520     end.
     2521       tr:
     2522       do transaction on error undo tr, return error return-value
     2523                      on stop  undo tr, return error return-value
     2524                      on quit  undo tr, return error return-value :
     2525          run waitfram-show in this-procedure ( INPUT "Создаем документ." ).
     2526          create tt-icnt-doc.
     2527   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2528   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2529     (input  p-obj-type
     2530     ,input  p-obj-code
     2531     ,output v-today
     2532     )  .
     2533          assign
     2534          tt-icnt-doc.ext-doc-type = 'em':U
     2535          tt-icnt-doc.doc-type  = 'сч-трк-погр':U
     2536          tt-icnt-doc.host-code = v-host-code
     2537          tt-icnt-doc.obj-type  = p-obj-type
     2538          tt-icnt-doc.obj-code  = p-obj-code
     2539          tt-icnt-doc.status_   = 'новый':U
     2540          tt-icnt-doc.flag_     = no
     2541          tt-icnt-doc.creid     = v-cntxt-userid
     2542          tt-icnt-doc.PS        = "@"
     2543          tt-icnt-doc.doc-date  = v-today
     2544          .
     2545          for each buf_pump-nozzle where
     2546                  buf_pump-nozzle.obj-type = tt-icnt-doc.obj-type
     2547              AND buf_pump-nozzle.obj-code = tt-icnt-doc.obj-code
     2548              AND buf_pump-nozzle.is-meas  = yes
     2549              no-lock
     2550              on error undo tr, return error return-value:
     2551              find first buf_pl-pump-nozzle where
     2552                       buf_pl-pump-nozzle.obj-type    = buf_pump-nozzle.obj-type
     2553                  AND  buf_pl-pump-nozzle.obj-code    = buf_pump-nozzle.obj-code
     2554                  AND  buf_pl-pump-nozzle.pump-code   = buf_pump-nozzle.pump-code
     2555                  AND  buf_pl-pump-nozzle.nozzle-code = buf_pump-nozzle.nozzle-code no-lock no-error.
     2556              if available buf_pl-pump-nozzle then do:
     2557                 find first buf_pl-gds where
     2558                          buf_pl-gds.obj-type  = buf_pl-pump-nozzle.obj-type
     2559                      AND buf_pl-gds.obj-code  = buf_pl-pump-nozzle.obj-code
     2560                     AND buf_pl-gds.pl-code   = buf_pl-pump-nozzle.pl-code  no-lock no-error.
     2561              end.
     2562              create tt-icnt-line.
     2563              assign
     2564              tt-icnt-line.doc-code     = tt-icnt-doc.doc-code
     2565              tt-icnt-line.obj-type     = tt-icnt-doc.obj-type
     2566              tt-icnt-line.obj-code     = tt-icnt-doc.obj-code
     2567              tt-icnt-line.pump-code    = buf_pump-nozzle.pump-code
     2568              tt-icnt-line.nozzle-code  = buf_pump-nozzle.nozzle-code
     2569              tt-icnt-line.pl-code      = (if available buf_pl-pump-nozzle
     2570                                              then buf_pl-pump-nozzle.pl-code
     2571                                              else ?)
     2572              tt-icnt-line.gds-code     = (if available buf_pl-gds
     2573                                              then buf_pl-gds.gds-code
     2574                                               else ?)
     2575              tt-icnt-line.meas-el-cnt  = ?
     2576              tt-icnt-line.state-el-cnt = ?
     2577              tt-icnt-line.state-mh-cnt = ?
     2578             .
     2579          end.
     2580          find first tt-icnt-line no-error.
     2581          if available tt-icnt-line then do:
     2582            run waitfram-show in this-procedure ( INPUT "Считываем данные со счетчиков ТРК.").
     2583            run read-pump IN THIS-PROCEDURE NO-ERROR.
     2584            if error-status:error then do:
     2585              run waitfram-hide in this-procedure .
     2586              MESSAGE
     2587              SUBSTITUTE("Ошибка при чтении счетчиков ТРК&1&2&1&3"
     2588                        , chr(10)
     2589                        , error-status:get-message(1)
     2590                        , return-value
     2591              )
     2592              view-as alert-box error .
     2593              undo tr, return error.
     2594            END.
     2595            run waitfram-hide in this-procedure .
     2596          end.
     2597       end.
     2598      run waitfram-hide in this-procedure .
     2599   END.
     2600   ELSE DO:
     2601     if p-mode = 'ПРОСМОТР':U then do:
     2602       FIND FIRST locked_icnt-doc NO-LOCK WHERE
     2603                   recid(locked_icnt-doc) = p-recid.
     2604     end.
     2605     ELSE do:
     2606       DO TRANSACTION
     2607         ON ERROR UNDO, RETURN ERROR:
     2608         FIND FIRST locked_icnt-doc EXCLUSIVE-LOCK WHERE
     2609                    recid(locked_icnt-doc) = p-recid.
     2610       END.
     2611     END.
     2612     IF NOT AVAIL locked_icnt-doc THEN return error.
     2613     if locked_icnt-doc.status_ = 'факт':U and p-mode <> 'ПРОСМОТР':U then do:
     2614        message
     2615        substitute("Документ счетчиков ТРК &1 закрыт до статуса &2&3Изменения не допускаются"
     2616                   ,locked_icnt-doc.doc-code
     2617                   ,LOCKED_icnt-doc.STATUS_
     2618                   , chr(10)
     2619                   )
     2620        view-as alert-box error.
     2621        return error.
     2622     end.
     2623     CREATE tt-icnt-doc.
     2624     BUFFER-COPY LOCKED_icnt-doc TO tt-icnt-doc.
     2625     FOR EACH LOCKED_icnt-line NO-LOCK WHERE
     2626             LOCKED_icnt-line.doc-code = LOCKED_icnt-doc.doc-code:
     2627        CREATE tt-icnt-line.
     2628        BUFFER-COPY LOCKED_icnt-line TO tt-icnt-line.
     2629     END.
     2630   END.
     2631   END PROCEDURE.
     2632   PROCEDURE get-gds-rec :
     2633   IF AVAILABLE buf_goods then
     2634   gds-rec = recid(buf_goods).
     2635   ELSE BELL.
     2636   END PROCEDURE.
     2637   PROCEDURE local-psn-chk :
     2638   define input parameter p-man    as character no-undo.
     2639   define input parameter p-action as character no-undo.
     2640   DEFINE VARIABLE ref-list AS CHARACTER NO-UNDO.
     2641   if p-man = "wrkr" and p-action = "ret-mouse" then do:
     2642     define variable v-ref-rec16   as recid no-undo .
     2643     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-icnt-doc.wrkr
     2644                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     2645     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     2646       if input frame Dialog-Frame tt-icnt-doc.wrkr <> ""
     2647          and input frame Dialog-Frame tt-icnt-doc.wrkr <> ? then
     2648         message "Из справочника клиентов Вы должны выбрать человека.".
     2649       run ref/cli-all.w (  input parparentproc
     2650                     ,  input "b-sel"
     2651                     ,  input 'чел':U
     2652                     ,  input ?
     2653                     ,  input ?
     2654                     ,  input v-ref-rec
     2655                     ,  input ",,,,,,NO"
     2656                     ,  input "lock-cli-type"
     2657                     , output ref-list ) .
     2658       assign v-ref-rec16 = integer( ref-list ).
     2659       v-ref-rec = integer( ref-list ) .
     2660       find cli-buf where recid (cli-buf) =
     2661          v-ref-rec
     2662          no-lock no-error.
     2663       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     2664         find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-icnt-doc.wrkr
     2665                              and cli-buf.obj-type = 'чел':U no-lock no-error.
     2666     end.
