      712   END.
      713   ON CHOOSE OF b-prev IN FRAME Dialog-Frame
      714   DO:
      715   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      716   if lookup(self :type
      717            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      718            ) = 0
      719   then do:
      720     message
      721       "$Workfile$"
