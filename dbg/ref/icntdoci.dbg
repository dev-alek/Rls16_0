      520   (tt-icnt-line.state-el-cnt - tt-icnt-line.state-mh-cnt)  @ v-delta-line COLUMN-LABEL 'Разница' FORMAT "->>>,>>>,>>>,>>9.999"
      521   tt-icnt-line.meas-el-cnt                 COLUMN-LABEL 'Измерение!электронного!счетчика' FORMAT "->>>,>>>,>>>,>>9.999"
      522   buf_goods.gds-name                 COLUMN-LABEL 'Название товара'
      523   tt-icnt-line.pl-code                 COLUMN-LABEL 'Резервуар' FORMAT "999999999999"
      524   ENABLE
      525   tt-icnt-line.state-el-cnt
      526   tt-icnt-line.state-mh-cnt
      527       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 14 FIT-LAST-COLUMN.
      528   DEFINE FRAME Dialog-Frame
      529        B-exit AT ROW 1 COL 1
      530        b-quit AT ROW 1 COL 11
      531        b-prev AT ROW 1 COL 24
      532        b-next AT ROW 1 COL 28
      533        B-read AT ROW 1 COL 44
      534        B-notes AT ROW 1 COL 68
      535        B-hist AT ROW 1 COL 92
      536        B-Help AT ROW 1 COL 95
      537        tt-icnt-doc.doc-date AT ROW 3 COL 20 COLON-ALIGNED
      538             LABEL "Дата" FORMAT "99/99/9999"
      539             VIEW-AS FILL-IN
      540             SIZE 10 BY 1
      541        tt-icnt-doc.fact-date AT ROW 3 COL 39 COLON-ALIGNED
      542             LABEL "Факт" FORMAT "99/99/99"
      543             VIEW-AS FILL-IN
      544             SIZE 10 BY 1
      545        tt-icnt-doc.shift-date AT ROW 3 COL 58 COLON-ALIGNED
      546             LABEL "Смена" FORMAT "99/99/9999"
      547             VIEW-AS FILL-IN
      548             SIZE 10 BY 1
      549        tt-icnt-doc.shift-num AT ROW 3 COL 72 COLON-ALIGNED
      550             LABEL "П" FORMAT ">9"
      551             VIEW-AS FILL-IN
      552             SIZE 3 BY 1
      553        tt-icnt-doc.shift-name AT ROW 3 COL 82 COLON-ALIGNED
      554             LABEL "№"
      555             VIEW-AS FILL-IN
      556             SIZE 3 BY 1
      557        tt-icnt-doc.wrkr AT ROW 4 COL 5 COLON-ALIGNED
      558             LABEL "К&л-к" FORMAT "999999999"
      559             VIEW-AS FILL-IN
      560             SIZE 10 BY 1
      561        r-wrkr AT ROW 4 COL 33.13
      562        tt-icnt-doc.agnt AT ROW 5 COL 5 COLON-ALIGNED
      563             LABEL "И&сп" FORMAT "999999999"
      564             VIEW-AS FILL-IN
      565             SIZE 10 BY 1
      566        r-agnt AT ROW 5.33 COL 33
      567        tt-icnt-doc.boss AT ROW 6 COL 5 COLON-ALIGNED
      568             LABEL "&М-р" FORMAT "999999999"
      569             VIEW-AS FILL-IN
      570             SIZE 10 BY 1
      571        r-boss AT ROW 6.33 COL 33
      572        br-line AT ROW 8 COL 1
      573        tt-icnt-doc.obj-code AT ROW 2 COL 16 COLON-ALIGNED
      574             LABEL "Объект" FORMAT "99999"
      575              VIEW-AS TEXT
      576             SIZE 7 BY .67
      577        tt-icnt-doc.obj-type AT ROW 2 COL 23.5 COLON-ALIGNED NO-LABEL
      578              VIEW-AS TEXT
      579             SIZE 4 BY .67
      580        buf_clients.obj-name AT ROW 2 COL 33 COLON-ALIGNED NO-LABEL FORMAT "X(40)"
      581              VIEW-AS TEXT
      582             SIZE 40 BY .67
      583             FGCOLOR 4
      584        wrkr-name AT ROW 4 COL 16 COLON-ALIGNED NO-LABEL
      585        tt-icnt-doc.state-el-cnt AT ROW 4 COL 75 COLON-ALIGNED FORMAT "->>>,>>>,>>>,>>>,>>9.999"
      586             LABEL "Показания электронных счетчиков"
      587              VIEW-AS TEXT
      588             SIZE 23 BY .67
      589        agnt-name AT ROW 5 COL 16 COLON-ALIGNED NO-LABEL
      590        tt-icnt-doc.state-mh-cnt AT ROW 5 COL 75 COLON-ALIGNED FORMAT "->>>,>>>,>>>,>>>,>>9.999"
      591             LABEL "Показания механических счетчиков"
      592              VIEW-AS TEXT
      593             SIZE 23 BY .67
      594        boss-name AT ROW 6 COL 16 COLON-ALIGNED NO-LABEL
      595        v-delta AT ROW 6 COL 75 COLON-ALIGNED
      596        tt-icnt-doc.meas-el-cnt AT ROW 7 COL 75 COLON-ALIGNED FORMAT "->>>,>>>,>>>,>>>,>>9.999"
      597             LABEL "Измерения электронных счетчиков"
      598              VIEW-AS TEXT
      599             SIZE 23 BY .67
      600        SPACE(3.89) SKIP(14.59)
      601       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      602            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      603            TITLE ""
      604            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      605   ASSIGN
      606          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      607          FRAME Dialog-Frame:HIDDEN           = TRUE.
      608   ON END-ERROR OF FRAME Dialog-Frame
      609   OR STOP OF FRAME Dialog-Frame DO:
      610     apply "choose" to b-quit in frame Dialog-Frame.
      611     return no-apply.
      612   END.
      613   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      614   DO:
      615     APPLY "END-ERROR":U TO SELF.
      616   END.
      617   ON LEAVE OF tt-icnt-doc.agnt IN FRAME Dialog-Frame
      618   DO:
      619     if input frame Dialog-Frame tt-icnt-doc.agnt <> tt-icnt-doc.agnt then do:
      620       run local-psn-chk in this-procedure ( input "agnt", input "leave").
      621     end.
      622   END.
      623   ON MOUSE-SELECT-DBLCLICK OF tt-icnt-doc.agnt IN FRAME Dialog-Frame
      624   OR RETURN OF tt-icnt-doc.agnt IN FRAME Dialog-Frame DO:
      625     run local-psn-chk in this-procedure ( input "agnt", input "ret-mouse").
      626     apply "entry" to tt-icnt-doc.agnt in frame Dialog-Frame.
      627     return no-apply.
      628   END.
      629   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      630   DO:
      631   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      632   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      633   if lookup(self :type
      634            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      635            ) = 0
      636   then do:
      637     message
      638       "$Workfile$"
      639       "Указанному интерфейсному элементу фокус не может быть передан" skip
      640       "Интерфейсный элемент" self :name  skip
      641       "Тип" self :type  skip
      642       "Процедура" this-procedure :file-name skip
      643       view-as alert-box .
      644   end.
      645   else do:
      646     apply "entry":u to self  .
      647     if focus :handle <> self :handle  then do:
      648       return no-apply .
      649     end.
      650   end.
      651     if p-mode = 'ПРОСМОТР':U then.
      652     else do:
      653       if p-mode = 'ИЗМЕНЕНИЕ':U  OR
      654       p-mode = 'ДОБАВЛЕНИЕ':U then do:
      655       if not can-find (first tt-icnt-line where tt-icnt-line.doc-code = tt-icnt-doc.doc-code no-lock) then do:
      656         glog = yes.
      657         message
      658         "В документе нет строк, поэтому он удаляется."
      659         view-as alert-box
      660         question buttons OK-Cancel update glog.
      661         if glog then do:
      662           if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      663             delete LOCKED_icnt-doc.
      664             assign p-recid = ?.
      665             return.
      666           end.
      667           else do:
      668             assign p-recid = ?.
      669             return.
      670           end.
      671         end.
      672         else return no-apply.
      673       end.
      674       run proc-save IN THIS-PROCEDURE NO-ERROR.
      675       IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      676     end.
      677   end.
      678   END.
      679   ON CHOOSE OF b-next IN FRAME Dialog-Frame
      680   DO:
      681   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      682   if lookup(self :type
      683            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      684            ) = 0
      685   then do:
      686     message
      687       "$Workfile$"
      688       "Указанному интерфейсному элементу фокус не может быть передан" skip
      689       "Интерфейсный элемент" self :name  skip
      690       "Тип" self :type  skip
      691       "Процедура" this-procedure :file-name skip
      692       view-as alert-box .
      693   end.
      694   else do:
      695     apply "entry":u to self  .
      696     if focus :handle <> self :handle  then do:
      697       return no-apply .
      698     end.
      699   end.
      700     run reposition-icnt-doc in this-procedure
      701     (input 'next':U
      702     ).
      703   END.
      704   ON CHOOSE OF B-notes IN FRAME Dialog-Frame
      705   DO:
      706   DEFINE VARIABLE v-notes AS CHARACTER NO-UNDO.
      707   v-notes = tt-icnt-doc.PS.
      708   run gbl/notes.w ( input p-mode, input-output v-notes ).
      709   if tt-icnt-doc.PS <> v-notes then do:
      710      tt-icnt-doc.PS = v-notes.
