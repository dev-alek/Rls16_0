     2914   PROCEDURE MyEnable :
     2915   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     2916   ASSIGN
     2917   br-line:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 3
     2918   frame Dialog-Frame:title = substitute("(&1) :   ДОКУМЕНТ ИНВЕНТАРИЗАЦИИ СЧЕТЧИКОВ ТРК - &2 № &3 - &4"
     2919                                          , substring (buf_clients.obj-name, 1, 35)
     2920                                          , tt-icnt-doc.STATUS_
     2921                                          , tt-icnt-doc.doc-code
     2922                                          , p-mode).
     2923   disable
     2924   all with frame Dialog-Frame.
     2925   enable
     2926   b-exit WHEN p-mode <> 'ПРОСМОТР':U
     2927   b-quit
     2928   b-help
     2929   br-line
     2930   b-hist
     2931   b-notes
     2932   b-next WHEN p-mode = 'ПРОСМОТР':U
     2933   b-prev WHEN p-mode = 'ПРОСМОТР':U
     2934   tt-icnt-doc.wrkr WHEN (p-mode <> 'ПРОСМОТР':U AND tt-icnt-doc.STATUS_ = 'новый':U)
     2935   tt-icnt-doc.agnt WHEN (p-mode <> 'ПРОСМОТР':U AND tt-icnt-doc.STATUS_ = 'новый':U)
     2936   tt-icnt-doc.boss WHEN (p-mode <> 'ПРОСМОТР':U AND tt-icnt-doc.STATUS_ = 'новый':U)
     2937   r-wrkr WHEN (p-mode <> 'ПРОСМОТР':U AND tt-icnt-doc.STATUS_ = 'новый':U)
     2938   r-agnt WHEN (p-mode <> 'ПРОСМОТР':U AND tt-icnt-doc.STATUS_ = 'новый':U)
     2939   r-boss WHEN (p-mode <> 'ПРОСМОТР':U AND tt-icnt-doc.STATUS_ = 'новый':U)
     2940   b-read WHEN (p-mode <> 'ПРОСМОТР':U AND tt-icnt-doc.STATUS_ = 'новый':U)
     2941   WITH frame Dialog-Frame.
     2942   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2943   do:
     2944     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2945       (input  v-cntxt-db-num
     2946       ,input  v-cntxt-userid
     2947       ,input  0
     2948       ,input  'actn_icnt-doc_upd-el-cnt':U
     2949       ,input  'object':U
     2950       ,input  buf_clients.host-code
     2951       ,input  buf_clients.obj-type
     2952       ,input  buf_clients.obj-code
     2953       ,input  0
     2954       ,input  0
     2955       ,input  0
     2956       ,input  false
     2957       ,output glog
     2958       )  .
     2959   end.
     2960   if not glog then do:
     2961       ASSIGN tt-icnt-line.state-el-cnt:READ-ONLY in browse br-line = YES.
     2962   end.
     2963   if p-mode = 'ПРОСМОТР':U then do:
     2964      ASSIGN
     2965      tt-icnt-line.state-el-cnt:READ-ONLY in browse br-line = YES
     2966      tt-icnt-line.state-mh-cnt:READ-ONLY in browse br-line = YES
     2967      .
     2968     assign
     2969     b-quit:label = "&Выход"
     2970     b-quit:column = 1
     2971     .
     2972     hide b-exit in frame Dialog-Frame .
     2973   end.
     2974   DISPLAY
     2975   tt-icnt-doc.obj-code
     2976   tt-icnt-doc.obj-type
     2977   tt-icnt-doc.fact-date
     2978   tt-icnt-doc.doc-date
     2979   tt-icnt-doc.shift-date
     2980   tt-icnt-doc.shift-num
     2981   tt-icnt-doc.shift-name
     2982   tt-icnt-doc.wrkr
     2983   tt-icnt-doc.agnt
     2984   tt-icnt-doc.boss
     2985   with frame Dialog-Frame.
     2986   run display-value in this-procedure .
     2987     define variable v-ref-rec26   as recid no-undo .
     2988     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-icnt-doc.wrkr
     2989                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     2990   if not available cli-buf then do:
     2991     display tt-icnt-doc.wrkr with frame Dialog-Frame.
     2992     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-icnt-doc.wrkr
     2993                            and cli-buf.obj-type = 'чел':U no-error.
     2994   end.
     2995   if available cli-buf then do:
     2996         display cli-buf.obj-code @ tt-icnt-doc.wrkr cli-buf.obj-name @ wrkr-name with frame Dialog-Frame.
     2997     end.
     2998     else display ? @ tt-icnt-doc.wrkr ? @ wrkr-name with frame Dialog-Frame.
     2999     define variable v-ref-rec27   as recid no-undo .
     3000     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-icnt-doc.agnt
     3001                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3002   if not available cli-buf then do:
     3003     display tt-icnt-doc.agnt with frame Dialog-Frame.
     3004     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-icnt-doc.agnt
     3005                            and cli-buf.obj-type = 'чел':U no-error.
     3006   end.
     3007   if available cli-buf then do:
     3008         display cli-buf.obj-code @ tt-icnt-doc.agnt cli-buf.obj-name @ agnt-name with frame Dialog-Frame.
     3009     end.
     3010     else display ? @ tt-icnt-doc.agnt ? @ agnt-name with frame Dialog-Frame.
     3011     define variable v-ref-rec28   as recid no-undo .
     3012     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-icnt-doc.boss
     3013                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3014   if not available cli-buf then do:
     3015     display tt-icnt-doc.boss with frame Dialog-Frame.
     3016     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-icnt-doc.boss
     3017                            and cli-buf.obj-type = 'чел':U no-error.
     3018   end.
     3019   if available cli-buf then do:
     3020         display cli-buf.obj-code @ tt-icnt-doc.boss cli-buf.obj-name @ boss-name with frame Dialog-Frame.
     3021     end.
     3022     else display ? @ tt-icnt-doc.boss ? @ boss-name with frame Dialog-Frame.
     3023   RUN Openbr IN THIS-PROCEDURE .
     3024   if p-mode = 'ПРОСМОТР':U then do:
     3025   if p-icnt-line-rec <> ? then reposition br-line to recid p-icnt-line-rec no-error.
     3026     apply "entry" to br-line in frame Dialog-Frame.
     3027   end.
     3028   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     3029     apply "entry" to br-line in frame Dialog-Frame.
     3030   end.
     3031   if num-results("br-line") > 0 then do:
     3032      if br-line:refresh() then.
     3033   end.
     3034   hide
     3035   b-hist
     3036   in frame Dialog-Frame .
     3037   END PROCEDURE.
     3038   PROCEDURE OpenBr :
     3039   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code.
     3040   END PROCEDURE.
     3041   PROCEDURE proc-save :
     3042   define variable v-recid as recid no-undo .
     3043   if p-mode = 'ПРОСМОТР':U then return .
     3044   assign
     3045   frame Dialog-Frame
     3046   tt-icnt-doc.wrkr
     3047   tt-icnt-doc.agnt
     3048   tt-icnt-doc.boss.
     3049   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     3050     v-recid = recid(locked_icnt-doc).
     3051   end.
     3052   run str/icntdoc1.p (
     3053                    INPUT p-mode
     3054                   ,input no
     3055                   ,input-output v-recid
     3056                   ,INPUT tt-icnt-doc.doc-code
     3057                   ,input tt-icnt-doc.obj-type
     3058                   ,input tt-icnt-doc.obj-code
     3059                   ,input tt-icnt-doc.host-code
     3060                   ,input 'инв-сч-трк':U
     3061                   ,input 'ip':U
     3062                   ,INPUT tt-icnt-doc.wrkr
     3063                   ,INPUT tt-icnt-doc.agnt
     3064                   ,INPUT tt-icnt-doc.boss
     3065                   ,INPUT tt-icnt-doc.doc-date
     3066                   ,input tt-icnt-doc.meas-el-cnt
     3067                   ,input tt-icnt-doc.state-el-cnt
     3068                   ,input tt-icnt-doc.state-mh-cnt
     3069                   ,input tt-icnt-doc.PS
     3070                   ,input tt-icnt-doc.creid
     3071                   ,input '':U
     3072                   ,input table tt-icnt-line
     3073                    ) NO-ERROR.
     3074   if error-status:error then do:
     3075   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3076   define variable fh as widget-handle no-undo .
     3077   define variable hh as widget-handle no-undo .
     3078   define variable rv as character no-undo .
     3079   assign
     3080   rv = entry(1, return-value , chr(4)).
     3081   if rv <> "":U then do:
     3082     assign
     3083     fh = frame Dialog-Frame:first-child
     3084     hh = fh:first-child
     3085     .
     3086     do while valid-handle(hh):
     3087       if hh:name = rv then do:
     3088         APPLY "ENTRY" to hh.
     3089         undo ,
     3090         return error.
     3091       end.
     3092       hh = hh:next-sibling.
     3093     end.
     3094   end.
     3095     undo, return error.
     3096   end.
     3097   p-recid = v-recid.
     3098   END PROCEDURE.
     3099   PROCEDURE read-pump :
     3100   define buffer buf_tt-icnt-line for tt-icnt-line.
     3101   define variable varcur-pump as logical no-undo.
     3102   define variable varnum      as integer no-undo.
     3103   define variable ptoldfilvalue as character no-undo.
     3104   define variable ptoldfiltype  as character no-undo.
     3105   for each tt-pump-nozzle:
     3106       delete tt-pump-nozzle.
     3107   end.
     3108   for each buf_tt-icnt-line where
     3109       buf_tt-icnt-line.doc-code = tt-icnt-doc.doc-code:
     3110       create tt-pump-nozzle.
     3111       assign tt-pump-nozzle.obj-type    = buf_tt-icnt-line.obj-type
     3112              tt-pump-nozzle.obj-code    = buf_tt-icnt-line.obj-code
     3113              tt-pump-nozzle.pump-code   = buf_tt-icnt-line.pump-code
     3114              tt-pump-nozzle.nozzle-code = buf_tt-icnt-line.nozzle-code
     3115              tt-pump-nozzle.gds-code    = buf_tt-icnt-line.gds-code.
     3116   end.
     3117   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3118     (input  'ptoldfil':u
     3119     ,input  v-host-code
     3120     ,input  p-obj-type
     3121     ,input  p-obj-code
     3122     ,input  ''
     3123     ,input  ''
     3124     ,input  ''
     3125     ,input  no
     3126     ,output ptoldfilvalue
     3127     ,output ptoldfiltype
     3128     ) no-error .
     3129   if ptoldfilvalue = "yes":u then do:
     3130     run gbl/d-askw.w ( input "Выбор источника данных с информацией по ТРК"
     3131                        ,input "Будем читать текущие данные с ТРК или возьмем данные из файла?"
     3132                        ,input "|^"
     3133                        ,input "Текущие данные|Из файлов|Отмена"
     3134                        ,input "Запускается программа для обращения к датчикам ТРК|Берутся уже сохраненные данные из файла|Ничего не делаем"
     3135                        ,input 1
     3136                        ,input 3
     3137                        ,output varnum
     3138                   ).
     3139     case varnum:
     3140     when 3 then do:
     3141       undo, return error.
     3142     end.
     3143     when 2 then do:
     3144       assign
     3145         varcur-pump = no.
     3146     end.
     3147     when 1 then do:
     3148       assign
     3149         varcur-pump = yes.
     3150     end.
     3151     end case.
     3152   end.
     3153   else do:
     3154     assign
     3155       varcur-pump = yes.
     3156   end.
     3157   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_anls-pmp in g#lib-rvs ( input              parparentproc ,
     3158                         input              tt-icnt-doc.obj-type ,
     3159                         input              tt-icnt-doc.obj-code ,
     3160                         input              yes ,
     3161                         input-output table tt-pump-nozzle-file ,
     3162                         input-output table tt-pump-nozzle ,
     3163                         input              varcur-pump ,
     3164                         input              yes ,
     3165                         input              no) no-error .
     3166   if error-status :error then do:
     3167      return error return-value.
     3168   end.
     3169   if return-value <> "":U then do:
     3170     message
     3171       substitute("&1", return-value ) skip
     3172       view-as alert-box information .
     3173   end.
     3174   do transaction on error undo, return error :
     3175     for each buf_tt-icnt-line where
     3176           buf_tt-icnt-line.doc-code = tt-icnt-doc.doc-code:
     3177         find first tt-pump-nozzle where
     3178                    tt-pump-nozzle.obj-type    = buf_tt-icnt-line.obj-type
     3179                 AND tt-pump-nozzle.obj-code    = buf_tt-icnt-line.obj-code
     3180                 AND tt-pump-nozzle.pump-code   = buf_tt-icnt-line.pump-code
     3181                 AND tt-pump-nozzle.nozzle-code = buf_tt-icnt-line.nozzle-code.
     3182         assign
     3183         buf_tt-icnt-line.meas-el-cnt  = tt-pump-nozzle.meas-el-cnt
     3184         buf_tt-icnt-line.state-el-cnt = buf_tt-icnt-line.meas-el-cnt
     3185         .
     3186     end.
     3187     RUN recalc-icnt IN THIS-PROCEDURE NO-ERROR.
     3188   end.
     3189   END PROCEDURE.
     3190   PROCEDURE recalc-icnt :
     3191   DEFINE VARIABLE v-meas-el-cnt AS DECIMAL NO-UNDO.
     3192   DEFINE VARIABLE v-state-el-cnt AS DECIMAL NO-UNDO.
     3193   DEFINE VARIABLE v-state-mh-cnt AS DECIMAL NO-UNDO.
     3194   define buffer buf_tt-icnt-line for tt-icnt-line.
     3195   for each buf_tt-icnt-line where buf_tt-icnt-line.doc-code = tt-icnt-doc.doc-code:
     3196     ASSIGN
     3197     v-meas-el-cnt = v-meas-el-cnt + buf_tt-icnt-line.meas-el-cnt
     3198     v-state-el-cnt = v-state-el-cnt + buf_tt-icnt-line.state-el-cnt
     3199     v-state-mh-cnt = v-state-mh-cnt + buf_tt-icnt-line.state-mh-cnt
     3200     .
     3201   end.
     3202   assign
     3203   tt-icnt-doc.meas-el-cnt  = v-meas-el-cnt
     3204   tt-icnt-doc.state-el-cnt = v-state-el-cnt
     3205   tt-icnt-doc.state-mh-cnt = v-state-mh-cnt
     3206   .
     3207   END PROCEDURE.
     3208   PROCEDURE reposition-icnt-doc :
     3209   define input parameter p-direction as character no-undo .
     3210   define variable v-new-icnt-doc-recid as recid no-undo .
     3211   do
     3212   on error undo, return error
     3213   :
     3214     if valid-handle(p-call-prog)
     3215     then do:
     3216       run reposition-icnt-doc in p-call-prog
     3217         (input  p-direction
     3218         ,output v-new-icnt-doc-recid
     3219         ).
     3220       if v-new-icnt-doc-recid <> ?
     3221       then do:
     3222         define buffer buf_icnt-doc for ub.icnt-doc .
     3223         find first buf_icnt-doc no-lock
     3224           where recid(buf_icnt-doc) = v-new-icnt-doc-recid
     3225           no-error .
     3226         assign
     3227         p-recid = v-new-icnt-doc-recid
     3228         p-next-prev = '':U
     3229         .
     3230       end.
     3231     end.
     3232     else do:
     3233       message "Список документов не определен." view-as alert-box INFORMATION .
     3234       return no-apply.
     3235     end.
     3236     END.
     3237   END PROCEDURE.
