      412   end.
      413   define variable v-db-num like ub.db.db-num no-undo.
      414   DEFINE BUTTON B-exit AUTO-GO
      415        LABEL "&Ввод"
      416        SIZE 10 BY 1
      417        BGCOLOR 8 .
      418   DEFINE BUTTON b-gds
      419        IMAGE-UP FILE "btn-down-arrow":U
      420        IMAGE-DOWN FILE "btn-down-arrow":U
      421        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      422        LABEL "Btn 2"
      423        SIZE 3 BY 1.
      424   DEFINE BUTTON B-Help
      425        LABEL "Помо&щь"
      426        SIZE 10 BY 1
      427        BGCOLOR 8 .
      428   DEFINE BUTTON B-printer
      429        IMAGE-UP FILE "btn-down-arrow":U
      430        IMAGE-DOWN FILE "btn-down-arrow":U
      431        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      432        LABEL "Btn 2"
      433        SIZE 3 BY 1.
      434   DEFINE BUTTON b-quit AUTO-END-KEY
      435        LABEL "&Отмена"
      436        SIZE 10 BY 1
      437        BGCOLOR 8 .
      438   DEFINE BUTTON B-shop
      439        IMAGE-UP FILE "btn-down-arrow":U
      440        IMAGE-DOWN FILE "btn-down-arrow":U
      441        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      442        LABEL "Btn 2"
      443        SIZE 3 BY 1.
      444   DEFINE VARIABLE f-obj-name AS CHARACTER FORMAT "X(256)":U
      445         VIEW-AS TEXT
      446        SIZE 45.75 BY .67 NO-UNDO.
      447   DEFINE VARIABLE f-prn-name AS CHARACTER FORMAT "X(40)":U
      448         VIEW-AS TEXT
      449        SIZE 35.88 BY .67 NO-UNDO.
      450   DEFINE VARIABLE fbr-obj-name AS CHARACTER FORMAT "X(256)":U
      451         VIEW-AS TEXT
      452        SIZE 42.38 BY .67 NO-UNDO.
      453   DEFINE VARIABLE gds-name AS CHARACTER FORMAT "X(256)":U
      454         VIEW-AS TEXT
      455        SIZE 59.5 BY .67 NO-UNDO.
      456   DEFINE QUERY Dialog-Frame FOR
      457         tt-fbr-prn-gds SCROLLING.
      458   DEFINE FRAME Dialog-Frame
      459        b-quit AT ROW 1 COL 1
      460        B-exit AT ROW 1 COL 11
      461        B-Help AT ROW 1 COL 54.88
      462        b-gds AT ROW 4.17 COL 62.38
      463        B-shop AT ROW 6.67 COL 19.25
      464        B-printer AT ROW 10.08 COL 47.13
      465        gds-name AT ROW 4.25 COL 1.88 NO-LABEL
      466        tt-fbr-prn-gds.obj-type AT ROW 6.71 COL 2 NO-LABEL
      467              VIEW-AS TEXT
      468             SIZE 7 BY .67
      469        tt-fbr-prn-gds.obj-code AT ROW 6.75 COL 8.5 COLON-ALIGNED NO-LABEL
      470              VIEW-AS TEXT
      471             SIZE 7.13 BY .67
      472        f-obj-name AT ROW 7.83 COL 2.25 NO-LABEL
      473        tt-fbr-prn-gds.prn-num AT ROW 10.25 COL 2.25 NO-LABEL
      474              VIEW-AS TEXT
      475             SIZE 5.5 BY .67
      476        f-prn-name AT ROW 10.29 COL 7.88 COLON-ALIGNED NO-LABEL
      477        fbr-obj-name AT ROW 11.67 COL 22.75 NO-LABEL
      478        "Установлен:" VIEW-AS TEXT
      479             SIZE 18.63 BY .67 AT ROW 11.58 COL 2.25
      480             FGCOLOR 4
      481        "Принтер" VIEW-AS TEXT
      482             SIZE 18.63 BY .67 AT ROW 9.17 COL 2.25
      483             FGCOLOR 4
      484        "Объект" VIEW-AS TEXT
      485             SIZE 17.88 BY .67 AT ROW 5.42 COL 2.13
      486             FGCOLOR 4
      487        "Товар" VIEW-AS TEXT
      488             SIZE 17.88 BY .67 AT ROW 2.83 COL 2.38
      489             FGCOLOR 4
      490        SPACE(45.61) SKIP(9.28)
      491       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      492            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      493            TITLE "Принтер для товара"
      494            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      495   ASSIGN
      496          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      497          FRAME Dialog-Frame:HIDDEN           = TRUE.
      498   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      499   DO:
      500     APPLY "END-ERROR":U TO SELF.
      501   END.
      502   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      503   DO:
      504     run proc-save in this-procedure no-error.
      505     if error-status:error then return no-apply.
      506   END.
      507   ON CHOOSE OF b-gds IN FRAME Dialog-Frame
      508   DO:
      509   define variable rec-list as character no-undo.
      510     run ref/gds-ref.p (parparentproc
      511                    ,"b-sel":U
      512                    ,?
      513                    ,?
      514                    ,?
      515                    ,?
      516                    ,?
      517                    ,?
      518                    ,?
      519                    ,p-obj-type
      520                    ,p-obj-code
      521                    ,?
      522                    , output rec-list).
      523    if rec-list = "" then do:
      524        return no-apply.
      525     end.
      526      find buf_goods where recid (buf_goods) = integer (rec-list) no-lock no-error.
      527     if not avail buf_goods then do:
      528       return no-apply.
      529     end.
      530     assign
      531     tt-fbr-prn-gds.gds-code = buf_goods.gds-code
      532     .
      533   display buf_goods.gds-name @ gds-name
      534   with frame Dialog-Frame.
      535   END.
      536   ON CHOOSE OF B-printer IN FRAME Dialog-Frame
      537   DO:
      538   define variable v-recid as recid no-undo.
      539   run ref/fbr-prns.w (
      540                           input parparentproc
      541                          ,input "db":U
      542                          ,input v-db-num
      543                          ,input "b-sel":U
      544                          ,input-output v-recid
      545   ) no-error.
      546   if error-status:error then return no-apply.
      547   find first buf_fbr-prn where
      548               recid(buf_fbr-prn) = v-recid no-error.
      549   if error-status:error or buf_fbr-prn.db-num <> v-db-num then return no-apply.
      550   find first fbr_clients no-lock where
      551               fbr_clients.obj-type = buf_fbr-prn.fbr-obj-type
      552          AND fbr_clients.obj-code = buf_fbr-prn.fbr-obj-code no-error.
      553   assign
      554   tt-fbr-prn-gds.prn-num = buf_fbr-prn.prn-num
      555   f-prn-name = buf_fbr-prn.prn-name
      556   fbr-obj-name = (if available fbr_clients
      557                            then fbr_clients.obj-name
      558                            else (buf_fbr-prn.fbr-obj-type + string(buf_fbr-prn.fbr-obj-code)))
      559   .
      560   display
      561   f-obj-name
      562   f-prn-name
      563   tt-fbr-prn-gds.prn-num
      564   with frame Dialog-Frame.
      565   END.
      566   ON CHOOSE OF B-shop IN FRAME Dialog-Frame
      567   DO:
      568     define variable v-host-code   as integer   no-undo .
      569     define variable v-user-select as logical   no-undo .
      570     define variable v-obj-type    as character no-undo .
      571     define variable v-obj-code    as integer   no-undo .
      572   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      573   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      574     (input  p-obj-type
      575     ,input  p-obj-code
      576     ,output v-host-code
      577     )  .
      578   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      579   run userobjs_select-one in this-procedure
      580     (input  parparentproc
      581     ,input  v-cntxt-db-num
      582     ,input  v-cntxt-userid
      583     ,input  v-host-code
      584     ,input  p-obj-type
      585     ,input  p-obj-code
      586     ,output v-user-select
      587     ,output v-obj-type
      588     ,output v-obj-code
      589     )  .
      590     if v-user-select = true
      591     then do:
      592       find first buf_clients no-lock
      593         where buf_clients.obj-type = v-obj-type
      594           and buf_clients.obj-code = v-obj-code
      595         no-error .
      596       if not available buf_clients then return no-apply.
      597       if buf_clients.db-num <> v-db-num
      598       then do:
      599         message
      600           "Можно выбать только объект текущей БД" skip
      601           view-as alert-box error.
      602         return no-apply.
      603       end.
      604       assign
      605       f-obj-name:screen-value = buf_clients.obj-name
      606       tt-fbr-prn-gds.obj-code = buf_clients.obj-code
      607       tt-fbr-prn-gds.obj-type = buf_clients.obj-type
      608       .
      609       display
      610       tt-fbr-prn-gds.obj-code
      611       tt-fbr-prn-gds.obj-type
      612       f-obj-name
      613       with frame Dialog-Frame.
      614     end.
      615   END.
      616   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      617   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      618   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      619   on help of frame Dialog-Frame
      620   do:
      621     run gbl/app_help.p
      622       (input this-procedure :file-name
      623       ,input ''
      624       ,input ?
      625       ) no-error.
      626     if error-status :error then do:
      627       message
      628         "Ошибка при вызове помощи"
      629         error-status :get-message(1)
      630         view-as alert-box .
      631     end.
      632   end.
      633   run minbtn-set in this-procedure .
      634   on choose of b-help in frame Dialog-Frame
      635   do:
      636     apply "help":u to frame Dialog-Frame .
      637   end.
      638   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      639   procedure minbtn-set :
      640       do
      641           on error undo, return error return-value
      642           :
      643           define variable ii              as integer       no-undo .
      644           define variable fh              as widget-handle no-undo .
      645           define variable hh              as widget-handle no-undo .
      646           define variable v-h             as handle        extent 4 no-undo .
      647           define variable v-name-button   as character     no-undo .
      648           define variable v-help-old-x    as decimal       no-undo .
      649           define variable v-help-old-y    as decimal       no-undo .
      650           define variable v-help-old-size as decimal       no-undo .
      651           define variable v-frame-width   as decimal       no-undo .
      652           define variable jj              as integer       no-undo .
      653           do
      654               on error undo, return error
      655               :
      656               assign
      657                   v-frame-width = frame Dialog-Frame:width - 0.3
      658                   fh            = frame Dialog-Frame:first-child
      659                   hh            = fh:first-child
      660                   ii            = 1
      661                   .
      662               do while valid-handle(hh):
      663                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      664                   do:
      665                       case lc(hh:name) :
      666                           when "b-help" then
      667                               do:
      668                                   hh:load-image-up("cmp/b-help.bmp":u) .
      669                                   hh:load-image-down("cmp/b-help.bmp":u) .
      670                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      671                                   hh:TOOLTIP = "Помощь" .
      672                                   v-help-old-x = hh:column .
      673                                   v-help-old-y = hh:row    .
      674                                   v-help-old-size = hh:width .
      675                                   hh:width-chars = 2.5 .
      676                               end.
      677                           when "b-print" then
      678                               do:
      679                                   hh:load-image("cmp/b-print.bmp":u) .
      680                                   hh:TOOLTIP = "Печать" .
      681                                   v-h[ii] = hh:handle .
      682                                   ii = ii + 1 .
      683                                   hh:width-chars = 3 .
      684                               end.
      685                           when "b-history" or
      686                           when "b-hist" then
      687                               do:
      688                                   hh:load-image("cmp/b-hist.bmp":u) .
      689                                   hh:TOOLTIP = "История" .
      690                                   v-h[ii] = hh:handle .
      691                                   ii = ii + 1 .
      692                                   hh:width-chars = 3 .
      693                               end.
      694                           when "b-sch" then
      695                               do:
      696                                   hh:load-image("cmp/b-sch.bmp":u) .
      697                                   hh:TOOLTIP = "Установка Фильтра" .
      698                                   v-h[ii] = hh:handle .
      699                                   ii = ii + 1 .
      700                                   hh:width-chars = 3 .
      701                               end.
      702                           when "b-hist-user" then
      703                               do:
      704                                   hh:load-image("cmp/b-hist.bmp":u) .
      705                                   hh:TOOLTIP = "История пользователя" .
      706                                   ii = ii + 1 .
      707                               end.
      708                       end case.
      709                   end.
      710                   hh = hh:next-sibling.
      711               end.
      712               b-help:column = v-frame-width - b-help:width-chars.
      713               jj = 0.
      714               repeat ii = 4 to 1 by -1 :
      715                   if valid-handle (v-h[ii] ) then
      716                   do:
      717                       jj  = jj + 1 .
      718                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      719                       v-h[ii]:row    = v-help-old-y .
      720                   end.
      721               end.
      722           end.
      723       end.
      724   end procedure.
      725   MAIN-BLOCK:
      726   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      727      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      728   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      729     run mainmenu_getcntxt in parparentproc
      730       (output v-cntxt-db-num
      731       ,output v-cntxt-userid
      732       ,output v-cntxt-level
      733       ,output v-cntxt-host-code-obj
      734       ,output v-cntxt-obj-type
      735       ,output v-cntxt-obj-code
      736       ,output v-cntxt-db-num-obj
      737       ,output v-cntxt-is-admin
      738       ) .
      739      if par-mode <> 'ИЗМЕНЕНИЕ':U and par-mode <> 'ДОБАВЛЕНИЕ':U then do:
      740       message
      741       vss-workfile vss-revision vss-description skip
      742        "Неверный параметр вызова par-mode" par-mode
      743       view-as alert-box ERROR.
      744       return error.
      745     end.
      746     if par-mode = 'ДОБАВЛЕНИЕ':U
      747     AND  (par-call-mode <> "goods":U
      748           and par-call-mode <> "printer":U )
      749     then do:
      750         message
      751           vss-workfile vss-revision vss-description skip
      752            "Неверный параметр вызова par-call-mode" par-call-mode
      753           view-as alert-box ERROR.
      754           return error.
      755     end.
      756   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      757   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      758     (output v-db-num
      759     )  .
      760     run fill-tables in this-procedure.
      761     RUN Myenable in this-procedure.
      762     WAIT-FOR GO OF FRAME Dialog-Frame.
      763   END.
      764   RUN disable_UI.
      765   PROCEDURE disable_UI :
      766     HIDE FRAME Dialog-Frame.
      767   END PROCEDURE.
      768   PROCEDURE enable_UI :
      769     OPEN QUERY Dialog-Frame FOR EACH tt-fbr-prn-gds SHARE-LOCK.
      770     GET FIRST Dialog-Frame.
      771     DISPLAY gds-name f-obj-name f-prn-name fbr-obj-name
      772         WITH FRAME Dialog-Frame.
      773     IF AVAILABLE tt-fbr-prn-gds THEN
      774       DISPLAY tt-fbr-prn-gds.obj-type tt-fbr-prn-gds.obj-code tt-fbr-prn-gds.prn-num
      775         WITH FRAME Dialog-Frame.
      776     ENABLE b-quit B-exit B-Help b-gds B-shop B-printer gds-name
      777            tt-fbr-prn-gds.obj-type tt-fbr-prn-gds.obj-code f-obj-name
      778            tt-fbr-prn-gds.prn-num f-prn-name fbr-obj-name
      779         WITH FRAME Dialog-Frame.
      780     VIEW FRAME Dialog-Frame.
      781   END PROCEDURE.
      782   PROCEDURE Fill-tables :
      783   CASE par-mode:
      784     when 'ДОБАВЛЕНИЕ':U then do:
      785       CASE par-call-mode:
      786         when "goods":U then do:
      787           create tt-fbr-prn-gds .
      788           assign
      789           tt-fbr-prn-gds.gds-code = p-gds-code
      790           .
      791         end.
      792         when "printer":U then do:
      793           create tt-fbr-prn-gds.
      794           assign
      795           tt-fbr-prn-gds.prn-num = p-prn-num.
      796         end.
      797       END CASE.
      798     end.
      799     when 'ИЗМЕНЕНИЕ':U then do:
      800       find first loc_fbr-prn-gds exclusive-lock where
      801                   recid(loc_fbr-prn-gds ) = p-rec no-error.
      802       if not available loc_fbr-prn-gds then do:
      803         message
      804         vss-workfile vss-revision vss-description skip
      805         "Неверное значение параметра p-rec" p-rec
      806         view-as alert-box error.
      807         return error.
      808       end.
      809       find first buf_goods no-lock where
      810                  buf_goods.gds-code = p-gds-code no-error .
      811       if not available buf_goods then do:
      812         message
      813         vss-workfile vss-revision vss-description skip
      814         "Неверное значение параметра p-gds-code" p-rec
      815         view-as alert-box error.
      816         return error.
      817       end.
      818       find first buf_clients no-lock where
      819                 buf_clients.obj-type = loc_fbr-prn-gds.obj-type
      820             AND buf_clients.obj-code = loc_fbr-prn-gds.obj-code no-error.
      821       if buf_clients.db-num <> v-db-num then do:
      822         message
      823         vss-workfile vss-revision vss-description skip
      824         "Нельзя редактировать запись, принадлежащую другой БД"
      825         "номер узла групп товаров" loc_fbr-prn-gds.gds-code skip
      826         "объект" loc_fbr-prn-gds.obj-type loc_fbr-prn-gds.obj-code skip
      827         "принтер" loc_fbr-prn-gds.prn-num
      828         view-as alert-box error.
      829         return error.
      830       end.
      831       create tt-fbr-prn-gds.
      832       buffer-copy loc_fbr-prn-gds to tt-fbr-prn-gds.
      833     end.
      834   END CASE.
      835   END PROCEDURE.
      836   PROCEDURE MyEnable :
      837   assign
      838   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + par-mode
      839   .
      840   CASE par-mode:
      841     when 'ДОБАВЛЕНИЕ':U then do:
      842       CASE par-call-mode:
      843         when "goods":U then do:
      844         end.
      845         when "printer":U then do:
      846           find first buf_fbr-prn where
      847                       buf_fbr-prn.prn-num = tt-fbr-prn-gds.prn-num
      848                   AND buf_fbr-prn.db-num = v-db-num .
      849           assign
      850           f-prn-name = buf_fbr-prn.prn-name
      851           .
      852           find first fbr_clients no-lock where
      853                     fbr_clients.obj-type = buf_fbr-prn.fbr-obj-type
      854                 AND fbr_clients.obj-code = buf_fbr-prn.fbr-obj-code.
      855           assign
      856           fbr-obj-name = fbr_clients.obj-name
      857           .
      858         end.
      859       END CASE.
      860     end.
      861     when 'ИЗМЕНЕНИЕ':U then do:
      862       find first buf_fbr-prn where
      863                 buf_fbr-prn.prn-num = tt-fbr-prn-gds.prn-num
      864             AND buf_fbr-prn.db-num = v-db-num.
      865       assign
      866       f-prn-name = buf_fbr-prn.prn-name
      867       .
      868       find first fbr_clients no-lock where
      869                 fbr_clients.obj-type = buf_fbr-prn.fbr-obj-type
      870             AND fbr_clients.obj-code = buf_fbr-prn.fbr-obj-code.
      871       assign
      872       fbr-obj-name = fbr_clients.obj-name
      873       .
      874       assign
      875       frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + buf_goods.gds-name
      876       .
      877     end.
      878   END CASE.
      879     DISPLAY
      880     buf_goods.gds-name @ gds-name
      881     f-obj-name
      882     f-prn-name
      883     fbr-obj-name
      884     WITH FRAME Dialog-Frame.
      885     IF AVAILABLE tt-fbr-prn-gds THEN
      886     DISPLAY
      887     tt-fbr-prn-gds.obj-type
      888     tt-fbr-prn-gds.obj-code
      889     tt-fbr-prn-gds.prn-num
      890     WITH FRAME Dialog-Frame.
      891     ENABLE
      892     b-quit
      893     B-exit
      894     B-Help
      895     b-gds when par-mode = 'ДОБАВЛЕНИЕ':U and par-call-mode = "printer":U
      896     B-shop when par-mode = 'ДОБАВЛЕНИЕ':U
      897     B-printer when par-call-mode = "goods"
      898     WITH FRAME Dialog-Frame.
      899     VIEW FRAME Dialog-Frame.
      900   END PROCEDURE.
      901   PROCEDURE proc-save :
      902   run ref/fprngrp1.p (
      903                       input-output p-rec
      904                       ,input par-mode
      905                       ,input tt-fbr-prn-gds.db-num
      906                       ,input tt-fbr-prn-gds.prn-num
      907                       ,input tt-fbr-prn-gds.obj-type
      908                       ,input tt-fbr-prn-gds.obj-code
      909                       ,input tt-fbr-prn-gds.gds-code
      910                       ) no-error.
      911   if error-status:error then do:
      912       CASE return-value:
      913           when "gds-code":U then do:
      914               APPLY "ENTRY" to b-gds in frame Dialog-Frame.
      915           end.
      916           when "obj-type":U or when "obj-code":U then do:
      917              APPLY "ENTRY" to b-shop.
      918           end.
      919           when "prn-num" then do:
      920                APPLY "ENTRY" to b-printer.
      921           end.
      922       END CASE.
      923       return error.
      924   end.
      925   END PROCEDURE.
