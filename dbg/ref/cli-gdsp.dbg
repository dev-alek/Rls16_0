      425   procedure create_obj-list :
      426      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      427      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      428      do
      429      on error undo, return error return-value
      430      :
      431         define buffer cli-obj for ub.clients .
      432         define variable p-var as integer no-undo .
      433         define buffer buf_obj-list for obj-list .
      434         find last buf_obj-list  use-index pi no-error .
      435         if available buf_obj-list
      436         then
      437            p-var = buf_obj-list.obj-id + 1.
      438         else
      439            p-var = 1.
      440         find first cli-obj where
      441                   cli-obj.obj-type = p-obj-type
      442               and cli-obj.obj-code = p-obj-code
      443         no-lock no-error.
      444         if available cli-obj
      445         then do:
      446            create buf_obj-list.
      447            assign
      448               buf_obj-list.obj-id   = p-var
      449               buf_obj-list.obj-code = cli-obj.obj-code
      450               buf_obj-list.obj-type = cli-obj.obj-type
      451               buf_obj-list.obj-name = cli-obj.obj-name
      452               buf_obj-list.db-num   = cli-obj.db-num
      453            .
      454         end.
      455      end.
      456   end.
