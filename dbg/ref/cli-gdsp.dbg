      413   def
      414   new shared
      415   temp-table  obj-list no-undo
      416     field obj-type like ub.clients.obj-type
      417     field obj-code like ub.clients.obj-code
      418     field obj-name like ub.clients.obj-name
      419     field obj-id   as integer
