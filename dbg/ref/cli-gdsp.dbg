      860   define variable var-report-r-b as character no-undo .
      861   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      862   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      863     (output var-report-r-b
      864     )  .
      865   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      866   define  stream PrnLibStream.
      867   procedure prn-lib-prn-file :
      868     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      869     define input parameter p-DIsabledoptions as integer no-undo .
      870     define variable v-report-name as character no-undo .
      871     define variable v-user-action as character no-undo .
      872     define variable v-printed     as logical   no-undo .
      873     define variable v-exist       as logical   no-undo .
      874     do
      875       on error undo, return error
      876       :
      877       run prn-lib-get-report-name  in this-procedure (
      878         input parParentProc
      879         ,output v-report-name
      880         ).
      881   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      882   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      883     (input  v-report-name
      884     ,input  2
      885     ,output v-exist
      886     )  .
      887       if NOT v-exist then
      888       DO:
      889         Message
      890           "Нет заданий на печать ! "
      891           view-as alert-box .
      892         Return  .
      893       End.
      894       run gbl/prnfilen.w
      895         (input  ""
      896         ,input  p-DisabledOptions
      897         ,input  string(v-report-name )
      898         ,input  7
      899         ,output v-user-action
      900         ,output v-printed
      901         ) .
      902       if v-printed then
      903       do:
      904         return "YES" .
      905       end.
      906       else
      907       do:
      908         return "NO" .
      909       end.
      910     end.
      911   end procedure.
      912   procedure prn-lib-open-stream :
      913     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      914     define input parameter p-page-size    as integer no-undo .
      915     define input parameter p-is-stream    as logical no-undo .
      916     define input parameter p-append       as logical no-undo .
      917     define variable v-report-name as character no-undo .
      918     do
      919       on error undo, return error
      920       :
      921       run prn-lib-get-report-name  in this-procedure (
      922         input parParentProc
      923         ,output v-report-name
      924         ).
      925       if p-is-stream then
      926       do:
      927         if p-append then
      928         do:
      929           output stream PrnLibStream to value( v-report-name )
      930             page-size value(p-page-size) append .
      931         end.
      932         if not p-append then
      933         do:
      934           output stream PrnLibStream to value( v-report-name )
      935             page-size value(p-page-size) .
      936         end.
      937       end.
      938       if not p-is-stream then
      939       do:
      940         if p-append then
      941         do:
      942           output to value( v-report-name )
      943             page-size value(p-page-size) append .
      944         end.
      945         if not p-append then
      946         do:
      947           output to value( v-report-name )
      948             page-size value(p-page-size) .
      949         end.
      950       end.
      951     end.
      952   end procedure.
      953   procedure prn-lib-open-exp :
      954     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      955     define input parameter p-is-stream    as logical no-undo .
      956     define input parameter p-is-append    as logical no-undo .
      957     define output parameter p-ReportFileName as char init "report" no-undo.
      958     define output parameter p-process as logical no-undo .
      959     define variable glog as logical no-undo .
      960     do
      961       on error undo, return error
      962       :
      963       SYSTEM-DIALOG GET-FILE p-ReportFileName
      964         TITLE      "Укажите путь"
      965         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      966         ASK-OVERWRITE
      967         CREATE-TEST-FILE
      968         SAVE-AS
      969         USE-FILENAME
      970         DEFAULT-EXTENSION "txt"
      971         UPDATE glog
      972         .
      973       if not glog then  return.
      974       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      975       if p-is-stream then
      976       do:
      977         if p-is-append then
      978         do:
      979           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      980         end.
      981         else
      982         do:
      983           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      984         end.
      985       end.
      986       else
      987       do:
      988         if p-is-append then
      989         do:
      990           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      991         end.
      992         else
      993         do:
      994           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      995         end.
      996       end.
      997       p-process = yes.
      998     end.
      999   end procedure.
     1000   procedure prn-lib-get-report-name :
     1001     define input parameter parParentProc  as widget-handle no-undo.
     1002     define output parameter p-report-name as character no-undo .
     1003     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1004   end procedure.
     1005   procedure prn-lib-reportviewer-report-name :
     1006     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1007     define input parameter p-report-name-html as character no-undo .
     1008     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1009   end procedure.
     1010   procedure prn-lib-reportviewer :
     1011     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1012     define input parameter p-report-name-html as character no-undo .
     1013     define input parameter p-param        as character no-undo .
     1014     define variable v-excel           as character no-undo init 'TRUE' .
     1015     define variable v-value-character as character no-undo .
     1016     define variable v-value-integer   as character no-undo .
     1017     define variable v-value-date      as date      no-undo .
     1018     define variable v-value-decimal   as decimal   no-undo .
     1019     define variable rep-excel         as logical   no-undo .
     1020     define variable excel-string      as character no-undo .
     1021     define variable v-param-type      as character no-undo .
     1022     define variable v-tth             as handle    no-undo .
     1023     run adm/shattri.p (
     1024       input "get":U
     1025       ,input  ""
     1026       ,input  0
     1027       ,input  'report-glob':U
     1028       ,input  'rep-excel':U
     1029       ,output v-value-character
     1030       ,output v-value-date
     1031       ,output v-value-decimal
     1032       ,output v-value-integer
     1033       ,output rep-excel
     1034       ,output v-param-type
     1035       ,INPUT-OUTPUT table-handle v-tth
     1036       )  .
     1037     if rep-excel then v-excel = "TRUE" .
     1038     else v-excel = "FALSE" .
     1039     if p-param eq ""
     1040     then
     1041        p-param = "EXCEL:" + v-excel.
     1042     else
     1043        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1044     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1045   end procedure.
     1046   define variable g#report-num as integer no-undo .
     1047   procedure OpenForExcel :
     1048      define variable v-ch#ExcelApplication as com-handle no-undo .
     1049      define variable v-ch#Workbook         as com-handle no-undo .
     1050      define variable v-ch#Worksheet        as com-handle no-undo .
     1051      os-delete value( string( session:temp-directory ) +
     1052                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     1053      os-delete value( string( session:temp-directory ) +
     1054                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     1055      os-delete value( string( session:temp-directory ) +
     1056                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     1057      if Make-Excel
     1058      then do:
     1059         output stream ForExcel to value( string( session:temp-directory +
     1060                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     1061         assign
     1062            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     1063            number-list = 1
     1064         .
     1065         if make-excel-com
     1066         then do:
     1067   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1068   if valid-handle(ch#WorkSheet) then
     1069   RELEASE OBJECT ch#WorkSheet no-error.
     1070   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1071   if valid-handle(ch#Workbook) then
     1072   RELEASE OBJECT ch#Workbook no-error.
     1073   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1074   if valid-handle(ch#ExcelApplication) then
     1075   RELEASE OBJECT ch#ExcelApplication no-error.
     1076            create "Excel.Application" ch#excelApplication connect no-error.
     1077            if error-status:error
     1078            then do :
     1079           create "Excel.Application" ch#excelApplication no-error.
     1080       if error-status :error then do:
     1081           message
     1082           "Ошибка при запуске Excel" skip
     1083           error-status :get-message(1) skip
     1084           view-as alert-box error .
     1085           undo, return error .
     1086       end.
     1087            end.
     1088            assign
     1089               num#str#  = 0.
     1090               v-ch#excelApplication  = ch#excelApplication.
     1091               v-ch#excelApplication:Interactive = false.
     1092               v-ch#excelApplication:ScreenUpdating = false.
     1093               v-ch#excelApplication:Visible = false.
     1094               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     1095               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     1096               v-ch#Worksheet = ch#WorkSheet.
     1097               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     1098               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     1099               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     1100               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     1101            no-error .
     1102            if error-status:error
     1103            then do:
     1104               Make-Excel-com = false .
     1105               Make-Excel = false .
     1106               output Stream  ForExcel close.
     1107               os-delete value( string( session:temp-directory ) +
     1108                              "rpt" + string( g#report-num ) + ".txt":U ) .
     1109               os-delete value( string( session:temp-directory ) +
     1110                              "rpt" + string( g#report-num ) + ".frm":U ) .
     1111               return.
     1112            end.
     1113         end.
     1114      end.
     1115   end.
     1116   procedure CloseForExcel :
     1117      define variable ii as integer no-undo .
     1118      define variable vsheet-num as integer no-undo.
     1119      if Make-Excel
     1120      then  do:
     1121         output Stream  ForExcel close.
     1122         os-delete value( string( session:temp-directory ) +
     1123                                "rpt" + string( g#report-num ) + ".txt":U ) .
     1124         os-delete value( string( session:temp-directory ) +
     1125                                "rpt" + string( g#report-num ) + ".frm":U ) .
     1126         define buffer buf_sheetf for sheetf.
     1127         find last buf_sheetf no-error .
     1128         if available buf_sheetf
     1129         then
     1130            vsheet-num = buf_sheetf.sheet-num.
     1131         if vsheet-num > 1
     1132         then do:
     1133            do ii = 2 to vsheet-num:
     1134               os-delete value( string( session:temp-directory ) +
     1135                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     1136            end.
     1137         end.
     1138   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1139   if valid-handle(ch#WorkSheet) then
     1140   RELEASE OBJECT ch#WorkSheet no-error.
     1141   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1142   if valid-handle(ch#Workbook) then
     1143   RELEASE OBJECT ch#Workbook no-error.
     1144   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1145   if valid-handle(ch#ExcelApplication) then
     1146   RELEASE OBJECT ch#ExcelApplication no-error.
     1147      end.
     1148   end.
     1149   define variable l-col-type         as character no-undo .
     1150   define variable l-col-pos          as integer no-undo .
     1151   define variable l-col-len          as integer no-undo .
     1152   define variable l-col-format       as character no-undo .
     1153   define variable l-col-lable        as character no-undo .
     1154   define variable v-dec-sep          as character no-undo init ? .
     1155   define variable v-th-sep           as character no-undo init ? .
     1156   define variable v-r-col-num        as integer no-undo .
     1157   define variable v-reg-replace      as logical no-undo .
     1158   define variable v-date-col-format  as character no-undo .
     1159   DEFINE VARIABLE last-col-num as integer no-undo.
     1160   run gbl/getlocal.p (
     1161                     output v-dec-sep
     1162                    ,output v-th-sep
     1163                    ,output v-sdate
     1164                    ,output v-shortdate
     1165                    ) no-error .
     1166   assign
     1167   v-reg-replace = NOT (v-dec-sep = ".":U and v-th-sep = chr(44))
     1168                   AND (v-dec-sep <> ? and v-th-sep <> ?)
     1169   .
     1170     FUNCTION supress-null RETURNS CHARACTER ( INPUT p-string  AS CHARACTER,
     1171                                               INPUT p-dec-sep AS CHARACTER  ) :
     1172       DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
     1173       IF TRIM( p-string ) = "0"                    OR
     1174          TRIM( p-string ) = "0" + p-dec-sep + "00" OR
     1175          TRIM( p-string ) =       p-dec-sep + "00" OR
     1176          TRIM( p-string ) =       p-dec-sep + "0"  OR
     1177          TRIM( p-string ) = "0" + p-dec-sep + "0"  THEN DO: ASSIGN v-string = "":U.     END.
     1178                                                    ELSE DO: ASSIGN v-string = p-string. END.
     1179       RETURN ( TRIM( v-string ) ).
     1180     END FUNCTION.
     1181   FUNCTION reg-output returns character( input p-string as character
     1182                                         ,input p-private-data as character
     1183                                         ,input p-replace as logical
     1184                                         ,input p-supress as logical
     1185                                         ,input p-dec-sep as character
     1186                                         ,input p-th-sep as character
     1187                                         ):
     1188   DEFINE VARIABLE v-reg-output as character no-undo .
     1189   DEFINE VARIABLE v-data-type as character no-undo .
     1190   DEFINE VARIABLE v-progress-format as character no-undo .
     1191   assign
     1192   v-progress-format = entry(1, p-private-data, chr(4))
     1193   v-data-type = entry(2, p-private-data, chr(4))
     1194   .
     1195   if p-string = ? then return chr(63).
     1196   if (v-data-type = "INTEGER"
     1197       OR v-data-type = "DECIMAL" ) THEN DO:
     1198     IF p-replace THEN DO:
     1199       assign
     1200         v-reg-output = replace( p-string
     1201                                         ,chr(44)
     1202                                         ,"":U
     1203                                       )
     1204         v-reg-output = trim(v-reg-output)
     1205       .
     1206     END.
     1207     else do:
     1208       v-reg-output = p-string.
     1209     end.
     1210     IF p-supress THEN DO: ASSIGN v-reg-output = supress-null( TRIM( v-reg-output ), p-dec-sep ). END.
     1211     return v-reg-output.
     1212   end.
     1213     return p-string.
     1214   END FUNCTION.
     1215   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1216   define variable v-waitfram-action01         as character   no-undo .
     1217   define variable v-waitfram-action02         as character   no-undo .
     1218   define variable v-waitfram-action03         as character   no-undo .
     1219   define variable mWaitFramTextBeg            as character   no-undo.
     1220   define variable mWaitFramTextEnd            as character   no-undo.
     1221   define variable mWaitFramView               as logical     no-undo.
     1222   define variable mWaitProcEvent              as logical     no-undo init yes.
     1223   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1224   define variable mWaitFramStop               as logical     no-undo.
     1225   define variable mWaitFramStopUser           as logical     no-undo.
     1226   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1227   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1228   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1229   define button B-WaitFramStop auto-end-key
     1230        label "Стоп"
     1231        size 10 by 1 tooltip "Остоновить процесс".
     1232   define button B-viewProcInfo
     1233        label "Информация"
     1234        size 15 by 1 tooltip "Информация о процесс".
     1235   define frame waitfram
     1236     v-waitfram-action01 format "x(72)" no-label skip
     1237     v-waitfram-action02 format "x(72)" no-label skip
     1238     v-waitfram-action03 format "x(72)" no-label skip
     1239     B-viewProcInfo
     1240     B-WaitFramStop at row 4 col 30
     1241     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1242     .
     1243   define new global shared variable mBatchMode as logical no-undo init ?.
     1244   define variable mFramBachModHandle as handle no-undo.
     1245   mFramBachModHandle = frame waitfram:handle.
     1246   define variable mFameOldVis as logical no-undo.
     1247   define variable mVisCUrentVin as logical no-undo.
     1248   if session:batch-mode
     1249   then
     1250      mBatchMode = yes.
     1251   if mBatchMode = ? then do:
     1252     mVisCUrentVin = current-window:visible.
     1253     mFameOldVis = mFramBachModHandle:visible.
     1254     mFramBachModHandle:visible  = yes.
     1255     mBatchMode = mFramBachModHandle:visible ne yes.
     1256     mFramBachModHandle:visible = mFameOldVis.
     1257     current-window:visible = mVisCUrentVin.
     1258   end.
     1259    if  log-manager:logfile-name ne ?
     1260     then DO:
     1261         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1262         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1263         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1264     end.
     1265   on choose of B-WaitFramStop in frame waitfram
     1266   do:
     1267     mWaitFramStop = yes.
     1268     mWaitFramStopUser = yes.
     1269   end.
     1270   function waitfram-check-timeout returns logical():
     1271      define variable vtime as int64 no-undo.
     1272      if mWaitFramStopTimeOut
     1273      then
     1274         return yes.
     1275      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1276      if     mWaitFramTimeOut ne ?
     1277         and mWaitFramTimeOut ne 0
     1278         and mWaitFramTimeOut lt vtime
     1279      then do:
     1280         mWaitFramStopTimeOut = yes.
     1281      end.
     1282      return mWaitFramStopTimeOut.
     1283   end.
     1284   procedure waitfram-hide :
     1285     if not session:batch-mode
     1286     then do
     1287     on error undo, return error return-value
     1288     :
     1289       pause 0 before-hide .
     1290       if not mBatchMode then
     1291         hide frame waitfram .
     1292     if     not mWaitFramView
     1293        and mWaitProcEvent
     1294     then
     1295       process events .
     1296     end.
     1297   end procedure.
     1298   procedure waitfram-show :
     1299     define input  parameter p-message as character no-undo .
     1300     define variable v-left-margin as integer   no-undo .
     1301     if not session:batch-mode
     1302     then do
     1303     on error undo, return error return-value
     1304     :
     1305       if length(p-message) <= 70 then do:
     1306         assign
     1307           v-left-margin = integer((70 - length(p-message)) / 2)
     1308         .
     1309         assign
     1310           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1311         .
     1312         assign
     1313           v-waitfram-action01 = " "
     1314           v-waitfram-action02 = " "
     1315                                    + fill(" ", v-left-margin)
     1316                                    + p-message
     1317           v-waitfram-action03 = " "
     1318         .
     1319       end.
     1320       else do:
     1321         define variable vRindex1 as integer no-undo.
     1322         define variable vRindex2 as integer no-undo.
     1323         vRindex1 = r-index(p-message," ",70).
     1324         if vRindex1 = 0
     1325         then
     1326            vRindex1 = 70.
     1327         if length(p-message)  <= vRindex1 + 70 then do:
     1328           assign
     1329             v-waitfram-action01 = " "
     1330             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1331             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1332           .
     1333         end.
     1334         else do:
     1335           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1336           if vRindex2 <= vRindex1
     1337           then
     1338              vRindex2 = vRindex1 + 70.
     1339           assign
     1340             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1341             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1342             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1343           .
     1344         end.
     1345       end.
     1346       B-viewProcInfo:visible   in frame waitfram = no.
     1347       B-viewProcInfo:sensitive in frame waitfram = no.
     1348       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1349       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1350       if  (   mWaitFramView
     1351          or  mWaitProcEvent)
     1352          and not mBatchMode
     1353       then
     1354          display
     1355             v-waitfram-action01 skip
     1356             v-waitfram-action02 skip
     1357             v-waitfram-action03 skip
     1358          with frame waitfram .
     1359       if     mWaitFramView
     1360          then do:
     1361             if     mWaitFramInterval ne ?
     1362                and not mBatchMode
     1363             then
     1364                wait-for go of frame waitfram pause mWaitFramInterval.
     1365          end.
     1366          else
     1367             if     mWaitProcEvent
     1368                and not mBatchMode
     1369             then
     1370                process events .
     1371     end.
     1372   end procedure.
     1373      procedure waitfram-show-this:
     1374         define input  parameter iInterval as int64 no-undo.
     1375         define variable vtime as int64 no-undo.
     1376         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1377         mWaitFramInterval = iInterval.
     1378         run waitfram-show (substitute("&1&2 &3&4" ,
     1379                                       mWaitFramTextBeg ,
     1380                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1381                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1382                                       mWaitFramTextEnd
     1383                                      )
     1384                           ).
     1385      end.
     1386      procedure WaitFramRunPause:
     1387         define input  parameter iInterval as dec no-undo.
     1388         define variable vStart  as datetime-tz no-undo.
     1389         define variable vend    as datetime-tz no-undo.
     1390         define variable vint as int64 no-undo.
     1391         define variable vOk as logical no-undo.
     1392         vStart = now.
     1393         vend   = vStart.
     1394         publish "WaitFramPause" (iInterval,output vOk).
     1395         vend   =  now.
     1396         vint = vend - vStart.
     1397         vint = iInterval - vint / 1000.
     1398         if     not mWaitFramStop
     1399            and (   vint > 0
     1400                 or (    not vOk
     1401                     and iInterval eq ?
     1402                     )
     1403                 )
     1404         then
     1405            run waitfram-show-this (iInterval).
     1406         vend   =  now.
     1407         vint = vend - vStart.
     1408         vint = iInterval - vint / 1000.
     1409         if     not mWaitFramStop
     1410            and vint > 0
     1411         then do:
     1412            run gbl/pause.p (vint * 1000).
     1413         end.
     1414         if iInterval ne ?
     1415         then
     1416            publish "WaitFramStop".
     1417         waitfram-check-timeout().
     1418      end.
     1419      procedure WaitFramWaitFor:
     1420         define input  parameter iInterval as dec no-undo.
     1421         assign
     1422            mWaitFramStartProc   = now
     1423            mWaitFramStopUser    = no
     1424            mWaitFramStopTimeOut = no
     1425         .
     1426         block-wait:
     1427         do while not mWaitFramStop:
     1428            run WaitFramRunPause (iInterval).
     1429            if  waitfram-check-timeout()
     1430            then do:
     1431               leave block-wait.
     1432            end.
     1433         end.
     1434         run waitfram-hide.
     1435      end.
     1436   procedure waitfram-join :
     1437     define input  parameter p-line-1  as character no-undo .
     1438     define input  parameter p-line-2  as character no-undo .
     1439     define input  parameter p-line-3  as character no-undo .
     1440     define output parameter p-message as character no-undo .
     1441     do
     1442     on error undo, return error return-value
     1443     :
     1444       assign
     1445         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1446                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1447                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1448       .
     1449     end.
     1450   end procedure.
     1451   function waitfram-join-function returns character
     1452     (input p-line-1 as character
     1453     ,input p-line-2 as character
     1454     ,input p-line-3 as character
     1455     ).
     1456     define variable v-message as character no-undo .
     1457     run waitfram-join in this-procedure
     1458       (input  p-line-1
     1459       ,input  p-line-2
     1460       ,input  p-line-3
     1461       ,output v-message
     1462       ) .
     1463     return v-message .
     1464   end function .
