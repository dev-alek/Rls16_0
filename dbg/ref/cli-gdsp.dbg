      324   function breakstr returns character ( input        for-name    as character,
      325                                         input        line-length as integer,
      326                                         input-output line1       as character,
      327                                         input-output line2       as character ) :
      328     define variable ii as integer no-undo.
      329     if length( for-name ) > line-length then do:
      330       assign ii    = 1
      331              line1 = "":u
      332              line2 = "":u.
      333       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      334         assign line1 =       substring( for-name, 1, line-length     )
      335                line2 = trim( substring( for-name,    line-length + 1 ) ).
      336       end.                                                     else do:
      337         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      338           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      339                  ii    = ii    + 1.
      340           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      341             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      342           end.
      343         end.
      344         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      345       end.
      346     end.                                else do:
      347       assign line1 = for-name
      348              line2 = "":u.
      349     end.
      350     return ( line1 ).
      351   end function.
