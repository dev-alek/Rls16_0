     2988   MAIN-BLOCK:
     2989   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2990      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2991     run check-parameters in this-procedure
     2992       no-error .
     2993     if error-status :error
     2994     then do:
     2995       undo, return error return-value .
     2996     end.
     2997     RUN Myenable in this-procedure .
     2998     RUn OpenBR IN THIS-PROCEDURE ( input yes, input no, input '':U).
     2999     run display-record in this-procedure .
     3000     WAIT-FOR GO OF FRAME Dialog-Frame.
     3001   END.
     3002   RUN disable_UI.
     3003   PROCEDURE check-parameters :
     3004     define variable v-obj-type like ub.clients.obj-type no-undo .
     3005     define variable v-obj-code like ub.clients.obj-code no-undo .
     3006     define buffer buf_clients for ub.clients .
     3007     define buffer buf_goods   for ub.goods .
     3008     define variable v-host-code   as integer   no-undo .
     3009     define variable v-user-select as logical   no-undo .
     3010     do for buf_clients, buf_goods
     3011     on error undo, return error return-value
     3012     :
     3013       if  p-obj-type = ""
     3014       and p-obj-code = 0
     3015       then do:
     3016         message
     3017           "Текущий объект не задан" skip
     3018           "Выберите объект" skip
     3019           view-as alert-box information .
     3020   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3021   run userobjs_select-one in this-procedure
     3022     (input  parparentproc
     3023     ,input  v-cntxt-db-num
     3024     ,input  v-cntxt-userid
     3025     ,input  v-host-code
     3026     ,input  p-obj-type
     3027     ,input  p-obj-code
     3028     ,output v-user-select
     3029     ,output v-obj-type
     3030     ,output v-obj-code
     3031     )  .
     3032         if v-user-select <> true
     3033         then do:
     3034           undo, return error "Объект не выбран" .
     3035         end.
     3036         assign
     3037         p-obj-type = v-obj-type
     3038         p-obj-code = v-obj-code
     3039         .
     3040       end.
     3041       find first buf_clients no-lock
     3042         where buf_clients.obj-type = p-obj-type
     3043           and buf_clients.obj-code = p-obj-code
     3044         no-error .
     3045       if not available buf_clients
     3046       then do:
     3047         message
     3048           vss-workfile vss-revision vss-description skip
     3049           "Ошибка задания входных параметров" skip
     3050           "Объект не найден" skip
     3051           "Объект" p-obj-type p-obj-code skip
     3052           "Код товара" p-gds-code skip
     3053           view-as alert-box error .
     3054         undo, return error return-value .
     3055       end.
     3056       find first buf_goods no-lock
     3057         where buf_goods.gds-code = p-gds-code
     3058         no-error .
     3059       if not available buf_goods
     3060       then do:
     3061         message
     3062           vss-workfile vss-revision vss-description skip
     3063           "Ошибка задания входных параметров" skip
     3064           "Объект" p-obj-type p-obj-code skip
     3065           "Код товара" p-gds-code skip
     3066           view-as alert-box error .
     3067         undo, return error return-value .
     3068       end.
     3069       do with frame Dialog-Frame:
     3070         assign
     3071           fi-obj = substitute('&1 &2 &3':u
     3072                              ,buf_clients.obj-type
     3073                              ,buf_clients.obj-code
     3074                              ,buf_clients.obj-name
     3075                              )
     3076           fi-gds = substitute('&1 &2 &3 &4':u
     3077                              ,buf_goods.artic
     3078                              ,buf_goods.prod-type
     3079                              ,buf_goods.prod-code
     3080                              ,buf_goods.gds-name
     3081                              )
     3082         .
     3083       end.
     3084     end.
     3085   END PROCEDURE.
     3086   PROCEDURE disable_UI :
     3087     HIDE FRAME Dialog-Frame.
     3088   END PROCEDURE.
     3089   PROCEDURE display-doc :
     3090     define input  parameter p-doc-type as character no-undo .
     3091     define input  parameter p-doc-code as character no-undo .
     3092     define buffer buf_goods for ub.goods .
     3093     define buffer buf_trn-doc for ub.trn-doc.
     3094     define buffer buf_c-trn-doc for ub.c-trn-doc.
     3095     do
     3096     on error undo, return error return-value
     3097     :
     3098       find first buf_goods no-lock
     3099         where buf_goods.gds-code = p-gds-code
     3100         no-error .
     3101       if not available buf_goods
     3102       then do:
     3103         message
     3104           vss-workfile vss-revision vss-description skip
     3105           "Внутренняя ошибка" skip
     3106           "Не найден товар" skip
     3107           "Код товара" p-gds-code skip
     3108           view-as alert-box error .
     3109         undo, return error return-value .
     3110       end.
     3111       case p-doc-type
     3112       :
     3113         when 'trn-doc':U
     3114         then do:
     3115           find first buf_trn-doc no-lock where buF_trn-doc.doc-code = p-doc-code no-error.
     3116           if available buf_trn-doc then do:
     3117             run str/showdoc.p
     3118               (input parparentproc
     3119               ,input p-doc-code
     3120               ,input buf_goods.artic
     3121               ,input buf_goods.prod-type
     3122               ,input buf_goods.prod-code
     3123               ,input true
     3124               ) .
     3125           end.
     3126           else do:
     3127             for each buf_c-trn-doc no-lock where
     3128                     buf_c-trn-doc.doc-code = p-doc-code
     3129                 AND buf_c-trn-doc.is-del = yes:
     3130                 run str/c-doc.w ( input parparentproc, input buf_c-trn-doc.doc-code, input buf_c-trn-doc.chip-num ).
     3131                 leave.
     3132             end.
     3133             if not available buf_c-trn-doc then do:
     3134               message
     3135                 vss-workfile vss-revision vss-description skip
     3136                 "Документ не может быть показан" skip
     3137                 "Тип документа" p-doc-type skip
     3138                 "Код документа" p-doc-code skip
     3139                 view-as alert-box error .
     3140             end.
     3141           end.
     3142         end.
     3143         when 'price-doc':U
     3144         then do:
     3145           run str/showdoc.p
     3146             (input parparentproc
     3147             ,input p-doc-code
     3148             ,input buf_goods.artic
     3149             ,input buf_goods.prod-type
     3150             ,input buf_goods.prod-code
     3151             ,input false
     3152             ) .
     3153         end.
     3154         otherwise do:
     3155           message
     3156             vss-workfile vss-revision vss-description skip
     3157             "Документ не может быть показан" skip
     3158             "Тип документа" p-doc-type skip
     3159             "Код документа" p-doc-code skip
     3160             view-as alert-box error .
     3161         end.
     3162       end.
     3163     end.
     3164   END PROCEDURE.
     3165   PROCEDURE display-record :
     3166     define variable v-gds-is-twounit as logical   no-undo .
     3167     define buffer buf_goods for ub.goods .
     3168     define buffer buf_currency for ub.currency .
     3169     define variable v-host-code as integer   no-undo .
     3170     define variable v-base-code as integer   no-undo .
     3171     define variable v-curr-base as character no-undo .
     3172     define variable v-curr-rubl as character no-undo .
     3173     define variable v-curr-sale as character no-undo .
     3174     do
     3175     on error undo, return error return-value
     3176     :
     3177   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     3178     (input  p-gds-code
