     1052   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1053   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1054   procedure fltopend_fltopend :
     1055   define input parameter p-parent-handle as handle no-undo .
     1056   define input parameter p-qh as handle no-undo .
     1057   define input parameter p-flt-open-open-query  as character no-undo .
     1058   define input parameter p-where-cond as character no-undo .
     1059   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1060   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1061   define input parameter p-indexed-reposition as character no-undo .
     1062     do
     1063     on error undo, return error
     1064     :
     1065   define variable v-prepare-string as character no-undo .
     1066   define variable glog as logical no-undo .
     1067   assign
     1068   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1069                      p-where-cond + chr(32)  +
     1070                      p-use-indFIRST-query-tail + chr(32) +
     1071                      p-use-ind-sort-clmn-by + chr(32) +
     1072                      p-indexed-reposition
     1073   .
     1074   assign
     1075   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1076   if not glog
     1077   or error-status:error then do:
     1078     message error-status:get-message(1) view-as alert-box .
     1079     undo, return error .
     1080   end.
     1081   assign
     1082   glog = p-qh:query-open no-error .
     1083   if not glog
     1084   or error-status:error then do:
     1085     message error-status:get-message(1) view-as alert-box .
     1086     undo, return error .
     1087   end.
     1088     end.
     1089   end procedure.
     1090   procedure fltopend_fltfindd :
     1091   define input parameter p-parent-handle as handle no-undo .
     1092   define input parameter p-qh as handle no-undo .
     1093   define input parameter p-rowid as rowid no-undo .
     1094   define input parameter p-next as logical no-undo .
     1095   define input parameter p-lock as integer no-undo .
     1096   define input parameter p-bh as handle no-undo .
     1097   define input parameter p-where-cond as character no-undo .
     1098   define input parameter p-use-index-phrase as character no-undo .
     1099   define variable glog as logical no-undo .
     1100   define variable v-qh as handle no-undo .
     1101   define variable v-bh as handle no-undo .
     1102   define variable v-recid as recid no-undo .
     1103   define variable v-prepare-string as character no-undo .
     1104   do
     1105   on error undo, return error
     1106   on stop undo, return error
     1107   :
     1108     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1109     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1110     create query v-qh.
     1111     v-qh:set-buffers(v-bh).
     1112     v-prepare-string = substitute("for each &1 &2 &3"
     1113                                     ,v-bh:name
     1114                                     ,p-where-cond
     1115                                     ,p-use-index-phrase).
     1116     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1117     if not glog then do:
     1118       delete object v-qh.
     1119       delete object v-bh.
     1120       undo, return error .
     1121     end.
     1122     glog = v-qh:query-open no-error .
     1123     if not glog then do:
     1124       delete object v-qh.
     1125       delete object v-bh.
     1126       undo, return error .
     1127     end.
     1128     if p-next then do:
     1129       v-qh:reposition-to-rowid(p-rowid) no-error .
     1130       glog = v-qh:get-next( p-lock) no-error .
     1131       glog = v-qh:get-next( p-lock) no-error .
     1132       if not glog or v-qh:query-off-end = yes then do:
     1133         glog = v-qh:get-first( p-lock) no-error .
     1134       end.
     1135     end.
     1136     else do:
     1137       glog = v-qh:get-first( p-lock) no-error .
     1138     end.
     1139     v-recid = v-bh:recid no-error .
     1140     delete object v-qh.
     1141     delete object v-bh.
     1142     return string(v-recid) .
     1143   end.
     1144   end procedure.
     1145   procedure fltopend_fltfindq :
     1146   define input parameter p-parent-handle as handle no-undo .
     1147   define input parameter p-qh as handle no-undo .
     1148   define input parameter p-next as logical no-undo .
     1149   define input parameter p-lock as integer no-undo .
     1150   define input parameter p-flt-open-open-query  as character no-undo .
     1151   define input parameter p-where-cond as character no-undo .
     1152   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1153   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1154   define input parameter p-indexed-reposition as character no-undo .
     1155   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1156   define variable glog as logical no-undo .
     1157   define variable v-qh as handle no-undo .
     1158   define variable v-bh as handle no-undo extent 18.
     1159   define variable v-rowid as rowid no-undo extent 18.
     1160   define variable v-ii as integer no-undo .
     1161   define variable v-prepare-string as character no-undo .
     1162   do
     1163   on error undo, return error
     1164   on stop undo, return error
     1165   :
     1166     create query v-qh.
     1167     do v-ii = 1 to p-qh:num-buffers:
     1168       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1169       assign
     1170       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1171       no-error.
     1172       v-qh:add-buffer(v-bh[v-ii]).
     1173     end.
     1174     assign
     1175     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1176                       p-where-cond + chr(32)  +
     1177                       p-use-indFIRST-query-tail + chr(32) +
     1178                       p-use-ind-sort-clmn-by + chr(32) +
     1179                       p-indexed-reposition
     1180     .
     1181     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1182     if not glog then do:
     1183       delete object v-qh.
     1184       do v-ii = 1 to p-qh:num-buffers:
     1185         delete object v-bh[v-ii].
     1186       end.
     1187       undo, return error .
     1188     end.
     1189     glog = v-qh:query-open no-error .
     1190     if not glog then do:
     1191       delete object v-qh.
     1192       do v-ii = 1 to p-qh:num-buffers:
     1193         delete object v-bh[v-ii].
     1194       end.
     1195       undo, return error .
     1196     end.
     1197     if p-next then do:
     1198       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1199       glog = v-qh:get-next( p-lock) no-error .
     1200       glog = v-qh:get-next( p-lock) no-error .
     1201       if not glog or v-qh:query-off-end = yes then do:
     1202         glog = v-qh:get-first( p-lock) no-error .
     1203       end.
     1204     end.
     1205     else do:
     1206       glog = v-qh:get-first( p-lock) no-error .
     1207     end.
     1208     do v-ii = 1 to p-qh:num-buffers:
     1209       assign
     1210       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1211       no-error.
     1212     end.
     1213     delete object v-qh.
     1214     do v-ii = 1 to p-qh:num-buffers:
     1215       delete object v-bh[v-ii].
     1216     end.
     1217   end.
     1218   end procedure.
