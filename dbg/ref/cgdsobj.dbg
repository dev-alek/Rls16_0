     3305     end.
     3306   END PROCEDURE.
     3307   PROCEDURE enable_UI :
     3308     OPEN QUERY Dialog-Frame FOR EACH X_c-gds-obj NO-LOCK.
     3309     GET FIRST Dialog-Frame.
     3310     DISPLAY sch-corr-date sch-source-ref sch-corr-user-name fi-obj fi-gds
     3311             fi-fact-qnty-descr fi-fact-base-descr fi-fact-rubl-descr
     3312             fi-fact-sale-descr fi-fact-cli-qnty-descr
     3313         WITH FRAME Dialog-Frame.
     3314     IF AVAILABLE ub.c-gds-obj THEN
     3315       DISPLAY c-gds-obj.fact-qnty c-gds-obj.old-fact-qnty c-gds-obj.fact-base
     3316             c-gds-obj.old-fact-base c-gds-obj.fact-rubl c-gds-obj.old-fact-rubl
     3317             c-gds-obj.fact-sale c-gds-obj.old-fact-sale c-gds-obj.fact-cli-qnty
     3318             c-gds-obj.old-fact-cli-qnty
     3319         WITH FRAME Dialog-Frame.
     3320     ENABLE b-exit b-show-doc B-print B-sch b-help BR-cgdsobj sch-corr-date
     3321            sch-source-ref sch-corr-user-name fi-obj fi-gds c-gds-obj.fact-qnty
     3322            fi-fact-qnty-descr c-gds-obj.old-fact-qnty fi-fact-base-descr
     3323            c-gds-obj.fact-base c-gds-obj.old-fact-base fi-fact-rubl-descr
     3324            c-gds-obj.fact-rubl c-gds-obj.old-fact-rubl c-gds-obj.fact-sale
     3325            fi-fact-sale-descr c-gds-obj.old-fact-sale c-gds-obj.fact-cli-qnty
     3326            c-gds-obj.old-fact-cli-qnty fi-fact-cli-qnty-descr
     3327         WITH FRAME Dialog-Frame.
     3328     VIEW FRAME Dialog-Frame.
     3329     run OpenBr in THIS-PROCEDURE (INPUT YES,        INPUT NO,        INPUT NO) .
     3330   END PROCEDURE.
     3331   PROCEDURE MyEnable :
     3332   DISPLAY
     3333   sch-corr-date
     3334   sch-source-ref
     3335   sch-corr-user-name
     3336   fi-obj fi-gds
     3337   fi-fact-qnty-descr
     3338   fi-fact-base-descr
     3339   fi-fact-rubl-descr
     3340   fi-fact-sale-descr
     3341   fi-fact-cli-qnty-descr
     3342   WITH FRAME Dialog-Frame.
     3343     IF AVAILABLE ub.c-gds-obj THEN
     3344       DISPLAY ub.c-gds-obj.fact-qnty ub.c-gds-obj.old-fact-qnty
     3345             ub.c-gds-obj.fact-base ub.c-gds-obj.old-fact-base
     3346             ub.c-gds-obj.fact-rubl ub.c-gds-obj.old-fact-rubl
     3347             ub.c-gds-obj.fact-sale ub.c-gds-obj.old-fact-sale
     3348             ub.c-gds-obj.fact-cli-qnty ub.c-gds-obj.old-fact-cli-qnty
     3349         WITH FRAME Dialog-Frame.
     3350     ENABLE
     3351     b-exit
     3352     b-show-doc
     3353     B-print
     3354     B-sch
     3355     b-help
     3356     BR-cgdsobj
     3357     sch-corr-date
     3358     sch-source-ref
     3359     sch-corr-user-name fi-obj fi-gds ub.c-gds-obj.fact-qnty
     3360            fi-fact-qnty-descr ub.c-gds-obj.old-fact-qnty fi-fact-base-descr
     3361            ub.c-gds-obj.fact-base ub.c-gds-obj.old-fact-base fi-fact-rubl-descr
     3362            ub.c-gds-obj.fact-rubl ub.c-gds-obj.old-fact-rubl
     3363            ub.c-gds-obj.fact-sale fi-fact-sale-descr ub.c-gds-obj.old-fact-sale
     3364            ub.c-gds-obj.fact-cli-qnty ub.c-gds-obj.old-fact-cli-qnty
     3365            fi-fact-cli-qnty-descr
     3366     WITH FRAME Dialog-Frame.
     3367     VIEW FRAME Dialog-Frame.
     3368     HIDE sch-corr-user-name IN FRAME Dialog-Frame.
     3369     END PROCEDURE.
     3370   PROCEDURE OpenBr :
     3371   define input  parameter p-open-query     as logical   no-undo .
     3372   define input  parameter p-find-next      as logical   no-undo .
     3373   define input  parameter p-find-condition as character no-undo .
     3374   define variable l-query-was-opened as logical no-undo .
     3375   define variable v-title as character no-undo .
     3376   define variable title0 as character no-undo.
     3377   title0 = "История остатков по товарам" + chr(32).
     3378   define variable sort-column-phrase as character no-undo .
     3379   case sort-column-name :
     3380     when "" then do:
     3381       assign
     3382         sort-column-phrase = ""
     3383       .
     3384     end.
     3385     otherwise do:
     3386       assign
     3387         sort-column-phrase = "by " + sort-column-name
     3388       .
     3389     end.
     3390   end case.
     3391   define variable l-open-query as logical   no-undo .
     3392   if p-open-query then do:
     3393     ASSIGN
     3394     frame Dialog-Frame:TITLE = title0 + substitute("Объект &1&2 Остатки товара с кодом &3"
     3395                                                     ,p-obj-type, p-obj-code
     3396                                                     , p-gds-code
     3397                                                   ).
     3398   end.
     3399   assign
     3400   filter-point = filter-point0
     3401   .
     3402   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3403   define variable  l-disable-where-26  as logical   no-undo .
     3404   define variable  l-filter-open-26    as logical   .
     3405   define variable  flt-rec-26       as recid     no-undo .
     3406   define variable  filter-name-26      as character no-undo .
     3407   define variable  where-phrase-26     as character no-undo .
     3408   define variable  sort-phrase-26      as character no-undo .
     3409   define variable  where-phrase-rus-26 as character no-undo .
     3410   define variable  sort-phrase-rus-26  as character no-undo .
     3411     run waitfram-show in this-procedure
     3412       (input "ЖДИТЕ ..."
     3413       ).
     3414   run gbl/flt-get.p
     3415     (input filter-point
     3416     ,output flt-rec-26
     3417     ,output filter-name-26
     3418     ,output where-phrase-26
     3419     ,output sort-phrase-26
     3420     ,output where-phrase-rus-26
     3421     ,output sort-phrase-rus-26
     3422     ).
     3423   if p-open-query then do:
     3424       run set-filter-name in this-procedure
     3425         (INPUT filter-name-26
     3426         ) no-error .
     3427     assign
     3428       l-filter-open-26 = false
     3429     .
     3430     if flt-rec-26 <> ?
     3431       or sort-column-phrase > ""
     3432     then do:
     3433       define variable  parameter-2-26 as character no-undo .
     3434       define variable  parameter-3-26 as character no-undo .
     3435       define variable  parameter-4-26 as character no-undo .
     3436       define variable  parameter-5-26 as character no-undo .
     3437       define variable  parameter-6-26 as character no-undo .
     3438       define variable  parameter-7-26 as character no-undo .
     3439         assign
     3440         parameter-3-26 =
     3441                                 "FOR EACH X_c-gds-obj"
     3442         parameter-4-26 =
     3443           (
     3444             if ("           X_c-gds-obj.obj-type = p-obj-type and X_c-gds-obj.obj-code = p-obj-code             and X_c-gds-obj.gds-code = p-gds-code " + " " + where-phrase-26) <> ""
     3445             then  substitute(' X_c-gds-obj.obj-type = &1&2&1 and X_c-gds-obj.obj-code = &3             and X_c-gds-obj.gds-code = &4 ', chr(34), p-obj-type, p-obj-code, p-gds-code)  + " " + where-phrase-26
     3446             else "true"
     3447           )
     3448         parameter-5-26 = (" " + "" + " " + "")
     3449         parameter-6-26 = if sort-phrase-26 = ''
     3450                              then
     3451           (
     3452           " " + "  " +
     3453             " " + sort-column-phrase +
     3454           " " + " by X_c-gds-obj.chip-num descending "
     3455           )
     3456                              else
     3457           (
     3458           " " + "  " +
     3459             " " + sort-column-phrase +
     3460           " " + sort-phrase-26
     3461           )
     3462         parameter-7-26 =
     3463           " indexed-reposition  "
     3464       .
     3465       do
     3466       on stop undo, leave
     3467       on error undo, leave
     3468       :
     3469         assign
     3470           l-disable-where-26 =
     3471             ("           X_c-gds-obj.obj-type = p-obj-type and X_c-gds-obj.obj-code = p-obj-code             and X_c-gds-obj.gds-code = p-gds-code " + " " + where-phrase-26 = "")
     3472         .
     3473         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3474                             ,input query br-cgdsobj:handle
     3475                             ,input parameter-3-26
     3476                             ,input parameter-4-26
     3477                             ,input parameter-5-26
     3478                             ,input parameter-6-26
     3479                             ,input parameter-7-26
     3480                             )
     3481         .
     3482         assign
     3483           l-filter-open-26 = true
     3484         .
     3485       end.
     3486       if l-filter-open-26 = false then do:
     3487         message
     3488           "Ошибка при фильтрации / сортировке" skip
     3489           "Будут показаны записи без учета фильтра" skip
     3490           view-as alert-box .
     3491       end.
     3492       else do:
     3493           assign
     3494             l-query-was-opened = true
     3495           .
     3496       end.
     3497     end.
     3498     if l-filter-open-26 = false then do:
     3499       OPEN QUERY br-cgdsobj FOR EACH X_c-gds-obj
     3500         where            X_c-gds-obj.obj-type = p-obj-type and X_c-gds-obj.obj-code = p-obj-code             and X_c-gds-obj.gds-code = p-gds-code
     3501          by X_c-gds-obj.chip-num descending
     3502         indexed-reposition
     3503     .
     3504         assign
     3505           l-query-was-opened = true
     3506         .
     3507     end.
     3508   end.
     3509   else do:
     3510     assign
     3511       v-doc-rec = recid( X_c-gds-obj )
     3512     .
     3513     do
     3514     on stop undo, leave
     3515     on error undo, leave
     3516     :
     3517       if query br-cgdsobj:handle:get-buffer-handle(1) = (buffer X_c-gds-obj:handle) then do:
     3518         assign
     3519         parameter-2-26 = (if p-find-next then "true":u else "false":u )
     3520         parameter-4-26 =
     3521           "where ":u +  substitute(' X_c-gds-obj.obj-type = &1&2&1 and X_c-gds-obj.obj-code = &3             and X_c-gds-obj.gds-code = &4 ', chr(34), p-obj-type, p-obj-code, p-gds-code)  + " ":u + where-phrase-26 + " ":u + p-find-condition + " " + ""
     3522         parameter-5-26 = "  "
     3523       .
     3524         run fltopend_fltfindd in this-procedure  (
     3525                             input this-procedure:handle
     3526                             ,input query br-cgdsobj:handle
     3527                             ,input rowid(X_c-gds-obj)
     3528                             ,input logical(parameter-2-26)
     3529                             ,input no-lock
     3530                             ,input (buffer X_c-gds-obj:handle)
     3531                             ,input parameter-4-26
     3532                             ,input parameter-5-26
     3533                             ) no-error.
     3534         .
     3535         assign
     3536           v-doc-rec = integer(return-value)
     3537           v-fltopend-rowid[1] = ?
     3538         .
     3539       end.
     3540       else do:
     3541         assign
     3542         parameter-2-26 = (if p-find-next then "true":u else "false":u )
     3543         parameter-3-26 =  "FOR EACH X_c-gds-obj"
     3544         parameter-4-26 =
     3545           (
     3546             if ("           X_c-gds-obj.obj-type = p-obj-type and X_c-gds-obj.obj-code = p-obj-code             and X_c-gds-obj.gds-code = p-gds-code " + " " + where-phrase-26) <> ""
     3547             then  substitute(' X_c-gds-obj.obj-type = &1&2&1 and X_c-gds-obj.obj-code = &3             and X_c-gds-obj.gds-code = &4 ', chr(34), p-obj-type, p-obj-code, p-gds-code)  + " " + where-phrase-26
     3548             else "true"
     3549           )
     3550         parameter-5-26 = (" " + "" + " " + "" + " " + p-find-condition)
     3551         parameter-6-26 = if sort-phrase-26 = ''
     3552                              then
     3553           (
     3554           " " + "  " +
     3555             " " + sort-column-phrase +
     3556           " " + " by X_c-gds-obj.chip-num descending "
     3557           )
     3558                              else
     3559           (
     3560           " " + "  " +
     3561             " " + sort-column-phrase +
     3562           " " + sort-phrase-26
     3563           )
     3564         parameter-7-26 =
     3565           " indexed-reposition  "
     3566       .
     3567         run fltopend_fltfindq in this-procedure  (
     3568                             input this-procedure:handle
     3569                             ,input query br-cgdsobj:handle
     3570                             ,input logical(parameter-2-26)
     3571                             ,input no-lock
     3572                             ,input parameter-3-26
     3573                             ,input parameter-4-26
     3574                             ,input parameter-5-26
     3575                             ,input parameter-6-26
     3576                             ,input parameter-7-26
     3577                             ,output v-fltopend-rowid
     3578                             ) no-error.
     3579         .
     3580         v-doc-rec = ?.
     3581       end.
     3582       assign
     3583         l-query-was-opened = true
     3584       .
     3585     end.
     3586   end.
     3587     run waitfram-hide in this-procedure .
     3588   if not p-open-query  and v-doc-rec <> ? then
     3589   REPOSITION br-cgdsobj to recid v-doc-rec No-ERROR.
     3590   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3591   query br-cgdsobj:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3592   run waitfram-hide in this-procedure .
     3593   APPLY "VALUE-CHANGED" TO br-cgdsobj in frame Dialog-Frame.
     3594   APPLY "ENTRY" TO br-cgdsobj.
     3595   END PROCEDURE.
     3596   PROCEDURE proc-b-print :
     3597   define variable date_string     as      char    no-undo.
     3598   define variable Line                as      char    no-undo.
     3599   define variable for-time as char.
     3600   define variable accum-count as integer.
     3601   define variable v-doc-rec as recid no-undo.
     3602   define variable v-prod as character no-undo .
     3603   define variable v-upd-time as character no-undo .
     3604   define variable v-obj as character no-undo .
     3605   define variable v-action-chr as character no-undo .
     3606   DEFINE VARIABLE v-for-user-name AS CHARACTER NO-UNDO.
     3607   DEFINE FRAME HistoryList
     3608   X_c-gds-obj.gds-code COLUMN-LABEL "Код товара"
     3609   X_c-gds-obj.old-fact-qnty COLUMN-LABEL "Количество!было"
     3610   X_c-gds-obj.fact-qnty COLUMN-LABEL "Количество!стало"
     3611   v-action-chr FORMAT "X(10)" COLUMn-LABEL "Действие"
     3612   X_c-gds-obj.source-ref COLUMn-LABEL "№"
     3613   X_c-gds-obj.corr-date
     3614   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     3615   v-for-user-name COLUMN-LABEL "Изменил" FORMAT "X(18)"
     3616   X_c-gds-obj.corr-user-db-num
     3617   v-obj COLUMN-LABEL "Объект" FORMAT "X(8)"
     3618   HEADER  date_string AT 5 format "X(35)"
     3619   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3620   Line format "X(195)" AT 1
     3621   with width 232 down stream-io use-text    .
     3622   Line = fill("-", 195).
     3623   date_string = cur-time-print() .
     3624   assign
     3625   v-doc-rec = recid( X_c-gds-obj ).
     3626   DO WHILE available X_c-gds-obj :
     3627         GET prev br-cgdsobj.
     3628   END.
     3629   run prn-lib-open-stream  in this-procedure (
     3630                                                input parparentProc
     3631                                               ,input 43
     3632                                               ,input yes
     3633                                               ,input no
     3634                                               ).
     3635   PUT  STREAM PrnLibStream
     3636   SPACE(25) ( frame Dialog-Frame:title )
     3637   format "x(90)" SKIP(1) .
     3638   FORM HEADER
     3639   Line format "X(180)" AT 1 SKIP
     3640   "Продолжение - на следующей странице" AT 30 SKIP
     3641   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3642   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3643   FORM with FRAME HistoryList  .
     3644   run waitfram-show in this-procedure ("Ждите...").
     3645     GET next br-cgdsobj.
     3646       DO WHILE available X_c-gds-obj :
     3647         Display STREAM PrnLibStream
     3648         X_c-gds-obj.gds-code
     3649         X_c-gds-obj.old-fact-qnty COLUMN-LABEL "Количество!было"
     3650         X_c-gds-obj.fact-qnty COLUMN-LABEL "Количество!стало"
     3651         get-action(X_c-gds-obj.action-type) @ v-action-chr
     3652         X_c-gds-obj.source-ref
     3653         X_c-gds-obj.corr-date
     3654         string(X_c-gds-obj.corr-time, "HH:MM:SS":U) @ v-upd-time
     3655         usrfulnf(X_c-gds-obj.corr-user-name) @ v-for-user-name
     3656         X_c-gds-obj.corr-user-db-num
     3657         X_c-gds-obj.obj-type + string(X_c-gds-obj.obj-code) @ v-obj
     3658         with FRAME HistoryList .
     3659     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     3660     assign
     3661     accum-count = accum-count + 1
     3662     .
     3663     GET next br-cgdsobj.
     3664   END.
     3665   UNDERLINE  STREAM PrnLibStream
     3666   X_c-gds-obj.gds-code
     3667   X_c-gds-obj.old-fact-qnty
     3668   X_c-gds-obj.fact-qnty
     3669   v-action-chr
     3670   X_c-gds-obj.source-ref
     3671   X_c-gds-obj.corr-date
     3672   v-upd-time
     3673   v-for-user-name
     3674   X_c-gds-obj.corr-user-db-num
     3675   v-obj
     3676   with FRAME HistoryList .
     3677   DISPLAY STREAM PrnLibStream
     3678   "ИТОГО"  @ X_c-gds-obj.gds-code
     3679   string(accum-count)  @ v-action-chr
     3680   with frame HistoryList.
     3681   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3682   HIDE  STREAM PrnLibStream FRAME CheckList.
     3683   output  STREAM PrnLibStream CLOSE.
     3684   run waitfram-hide in this-procedure.
     3685   run prn-lib-prn-file in this-procedure (
     3686                                             input parparentproc
     3687                                             ,input 8
     3688                                             ).
     3689   reposition br-cgdsobj to recid v-doc-rec no-error.
     3690   apply "entry" to br-cgdsobj in frame Dialog-Frame.
     3691   END PROCEDURE.
     3692   PROCEDURE proc-b-sch :
     3693   assign
     3694     tbl = 'c-gds-obj'
     3695     join-tbl = 'X_c-gds-obj'
     3696     fld = ""
     3697     lab = ""
     3698     spr = ""
     3699     dim = '0'
     3700     .
     3701   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', '',
     3702   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3703   run fltfield-add in this-procedure('corr-date', '', '',
     3704   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3705   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     3706   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3707   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     3708   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3709   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     3710   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3711   run fltfield-add in this-procedure('action-type', 'Действие', 'hist-action',
     3712   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3713   run fltfield-add in this-procedure('source-type', 'Источник_измен-я', 'hist-source-type',
     3714   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3715   run fltfield-add in this-procedure('source-ref', '', '',
     3716   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3717   Filter-Block:
     3718   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3719       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     3720       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     3721     run gbl/filter.w ( INPUT parparentproc
     3722                       ,INPUT (filter-point0 + chr(4) + "История остатков товаров" + chr(4) + 'yes':U)
     3723                       ,INPUT tbl
     3724                       ,INPUT join-tbl
     3725                       ,INPUT fld
     3726                       ,INPUT lab
     3727                       ,INPUT spr
     3728                       ,INPUT dim ).
     3729     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     3730   END.
     3731   END PROCEDURE.
     3732   PROCEDURE proc-find-corr-date :
     3733   define input parameter p-next as logical no-undo.
     3734   define input parameter p-date AS DATE no-undo.
     3735   define variable v-date-chr as character no-undo.
     3736   if p-date = ? then return .
     3737   display
     3738   "":U @ sch-corr-user-name
     3739   '':U @ sch-source-ref
     3740   with frame Dialog-Frame.
     3741   assign
     3742   v-date-chr = string(day(p-date)) + chr(47) +
     3743                    string(month(p-date)) + chr(47) +
     3744                    string(year(p-date)).
     3745          run OpenBr in this-procedure
     3746           (input false
     3747           ,input true
     3748           ,input substitute("and X_c-gds-obj.corr-date = &1 "
     3749             , v-date-chr)
     3750           ).
     3751         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     3752   END PROCEDURE.
     3753   PROCEDURE proc-find-source-ref :
     3754   define input parameter p-next as logical no-undo.
     3755   define input parameter p-user like ub.c-gds-obj.corr-user-name no-undo.
     3756   assign
     3757   sch-corr-date = ?
     3758   .
     3759   display
     3760   sch-corr-date
     3761   '':U @ sch-corr-user-name
     3762   with frame Dialog-Frame.
     3763   p-user = chr(34) + p-user + chr(34).
     3764   run OpenBr in this-procedure
     3765       (input false
     3766       ,input p-next
     3767       ,input substitute(" and  X_c-gds-obj.source-ref begins &1 "
     3768         , p-user)
     3769       ).
     3770   apply "entry":u to sch-source-ref in frame Dialog-Frame .
     3771   END PROCEDURE.
     3772   PROCEDURE proc-find-user :
     3773   define input parameter p-next as logical no-undo.
     3774   define input parameter p-user like ub.c-gds-obj.corr-user-name no-undo.
     3775   assign
     3776   sch-corr-date = ?.
     3777   display
     3778   sch-corr-date
     3779   '':U @ sch-source-ref
     3780   with frame Dialog-Frame.
     3781   p-user = chr(34) + p-user + chr(34).
     3782   run OpenBr in this-procedure
     3783       (input false
     3784       ,input p-next
     3785       ,input substitute("and X_c-gds-obj.corr-user-name = &1 "
     3786         , p-user)
     3787       ).
     3788   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     3789   END PROCEDURE.
     3790   FUNCTION get-action RETURNS CHARACTER
     3791     ( INPUT p-action AS CHARACTER ) :
     3792   define variable dops as character no-undo.
     3793   CASE p-action:
     3794      when 'close':U then do:
     3795         return "Закр.на факт".
     3796      end.
     3797      when 'delete':U then do:
     3798         return "Удаление".
     3799      end.
     3800   END CASE.
     3801   END FUNCTION.
     3802   FUNCTION get-doc-type RETURNS CHARACTER
     3803     ( BUFFER buf_c-gds-obj FOR c-gds-obj ) :
     3804     if available buf_c-gds-obj
     3805     then do:
     3806       case buf_c-gds-obj.source-type
     3807       :
     3808         when 'trn-doc':U
     3809         then do:
     3810           return "документ" .
     3811         end.
     3812         when 'price-doc':U
     3813         then do:
     3814           return "переоценка" .
     3815         end.
     3816         otherwise do:
     3817           return buf_c-gds-obj.source-type .
     3818         end.
     3819       end case.
     3820     end.
     3821     RETURN "".
     3822   END FUNCTION.
