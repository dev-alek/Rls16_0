      873   procedure userobjs_append :
      874      define input  parameter p-obj-type as character no-undo .
      875      define input  parameter p-obj-code as integer   no-undo .
      876     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      877     do
      878     on error undo, return error return-value
      879     :
      880       find first buf_userobjs_temp-user-obj
      881         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      882           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      883         no-error .
      884       if not available buf_userobjs_temp-user-obj
      885       then do:
      886         create buf_userobjs_temp-user-obj .
      887         assign
      888           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      889           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      890         .
      891       end.
      892     end.
      893   end.
      894   procedure userobjs_object-exist :
      895     define output parameter p-object-exist as logical   no-undo .
      896     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      897     do
      898     on error undo, return error return-value
      899     :
      900       find first buf_userobjs_temp-user-obj
      901         no-error .
      902       if not available buf_userobjs_temp-user-obj
      903       then do:
      904         assign
      905           p-object-exist = false
      906         .
      907       end.
      908       else do:
      909         assign
      910           p-object-exist = true
      911         .
      912       end.
      913     end.
      914   end.
      915   procedure userobjs_transfer :
      916     define input  parameter p-callback-handle as handle no-undo .
      917     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      918     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      919     do
      920     on error undo, return error return-value
      921     :
      922       if valid-handle(p-callback-handle) <> true
      923       then do:
      924         message
      925           vss-workfile vss-revision vss-description skip
      926           "Ошибка задания входных параметров" skip
      927           "Неизвестный указатель на процедуру" skip
      928           view-as alert-box error .
      929         undo, return error return-value .
      930       end.
      931       if p-callback-handle :get-signature("userobjs_append") = ""
      932       then do:
      933         message
      934           vss-workfile vss-revision vss-description skip
      935           "Ошибка задания входных параметров" skip
      936           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      937                     ,p-callback-handle :file-name
      938                     ) skip
      939           view-as alert-box error .
      940         undo, return error return-value .
      941       end.
      942       for each buf_userobjs_temp-user-obj
      943       on error undo, return error return-value
      944       :
      945         run userobjs_append in p-callback-handle
      946           (input  buf_userobjs_temp-user-obj.obj-type
      947           ,input  buf_userobjs_temp-user-obj.obj-code
      948           ) .
      949       end.
      950     end.
      951   end procedure.
