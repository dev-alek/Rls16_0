     1354             FGCOLOR 4
     1355        ub.c-gds-obj.fact-cli-qnty AT ROW 20.63 COL 16.38 COLON-ALIGNED
     1356             LABEL "Факт (пост)"
     1357              VIEW-AS TEXT
     1358             SIZE 13 BY .67
     1359             FGCOLOR 4
     1360        ub.c-gds-obj.old-fact-cli-qnty AT ROW 20.67 COL 48 COLON-ALIGNED NO-LABEL
     1361              VIEW-AS TEXT
     1362             SIZE 13 BY .67
     1363             FGCOLOR 4
     1364        fi-fact-cli-qnty-descr AT ROW 20.71 COL 40.5 COLON-ALIGNED NO-LABEL
     1365        "ПОИСК ПО" VIEW-AS TEXT
     1366             SIZE 8.38 BY 1 AT ROW 14.25 COL 1
     1367             FGCOLOR 4
     1368        "Стало:" VIEW-AS TEXT
     1369             SIZE 8 BY .67 AT ROW 15.75 COL 18.5
     1370        "Было:" VIEW-AS TEXT
     1371             SIZE 8 BY .67 AT ROW 15.75 COL 50
     1372        SPACE(40.49) SKIP(5.15)
     1373       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1374            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1375            TITLE "История остатков товара на объекте"
     1376            DEFAULT-BUTTON b-exit.
     1377   ASSIGN
     1378          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1379          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1380   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1381   DO:
     1382     APPLY "END-ERROR":U TO SELF.
     1383   END.
     1384   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1385   DO:
     1386     run proc-b-print in this-procedure no-error.
     1387     if error-status:error then return no-apply.
     1388   END.
     1389   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1390   DO:
     1391     run proc-b-sch in this-procedure no-error.
     1392     if error-status:error then return no-apply.
     1393   END.
     1394   ON CHOOSE OF b-show-doc IN FRAME Dialog-Frame
     1395   DO:
     1396     if available X_c-gds-obj
     1397     then do:
     1398       run display-doc in this-procedure
     1399         (input X_c-gds-obj.source-type
     1400         ,input X_c-gds-obj.source-ref
     1401         ) .
     1402     end.
     1403   END.
     1404   ON DEFAULT-ACTION OF BR-cgdsobj IN FRAME Dialog-Frame
     1405   DO:
     1406     if available X_c-gds-obj
     1407     then do:
     1408       run display-doc in this-procedure
     1409         (input X_c-gds-obj.source-type
     1410         ,input X_c-gds-obj.source-ref
     1411         ) .
     1412     end.
     1413   END.
     1414   ON VALUE-CHANGED OF BR-cgdsobj IN FRAME Dialog-Frame
     1415   DO:
     1416     run display-record in this-procedure .
     1417   END.
     1418   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1419   DO:
     1420      run proc-find-corr-date in this-procedure(yes, input frame Dialog-Frame sch-corr-date) no-error.
     1421     if error-status:error then return no-apply.
     1422   END.
     1423   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1424   DO:
     1425     run proc-find-corr-date in this-procedure(no, input frame Dialog-Frame sch-corr-date) no-error.
     1426     if error-status:error then return no-apply.
     1427   END.
     1428   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
     1429   DO:
     1430     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1431     if error-status:error then return no-apply.
     1432   END.
     1433   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1434   DO:
     1435     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1436     if error-status:error then return no-apply.
     1437   END.
     1438   ON CTRL-J OF sch-source-ref IN FRAME Dialog-Frame
     1439   DO:
     1440     run proc-find-source-ref in this-procedure(yes, input frame Dialog-Frame sch-source-ref) no-error.
     1441     if error-status:error then return no-apply.
     1442   END.
     1443   ON RETURN OF sch-source-ref IN FRAME Dialog-Frame
     1444   DO:
     1445     run proc-find-source-ref in this-procedure(no, input frame Dialog-Frame sch-source-ref) no-error.
     1446     if error-status:error then return no-apply.
     1447   END.
     1448   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1449   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1450   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1451   on help of frame Dialog-Frame
     1452   do:
     1453     run gbl/app_help.p
     1454       (input this-procedure :file-name
     1455       ,input ''
     1456       ,input ?
     1457       ) no-error.
     1458     if error-status :error then do:
     1459       message
     1460         "Ошибка при вызове помощи"
     1461         error-status :get-message(1)
     1462         view-as alert-box .
     1463     end.
     1464   end.
     1465   run minbtn-set in this-procedure .
     1466   on choose of b-help in frame Dialog-Frame
     1467   do:
     1468     apply "help":u to frame Dialog-Frame .
     1469   end.
     1470   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1471   procedure minbtn-set :
     1472       do
     1473           on error undo, return error return-value
     1474           :
     1475           define variable ii              as integer       no-undo .
     1476           define variable fh              as widget-handle no-undo .
     1477           define variable hh              as widget-handle no-undo .
     1478           define variable v-h             as handle        extent 4 no-undo .
     1479           define variable v-name-button   as character     no-undo .
     1480           define variable v-help-old-x    as decimal       no-undo .
     1481           define variable v-help-old-y    as decimal       no-undo .
     1482           define variable v-help-old-size as decimal       no-undo .
     1483           define variable v-frame-width   as decimal       no-undo .
     1484           define variable jj              as integer       no-undo .
     1485           do
     1486               on error undo, return error
     1487               :
     1488               assign
     1489                   v-frame-width = frame Dialog-Frame:width - 0.3
     1490                   fh            = frame Dialog-Frame:first-child
     1491                   hh            = fh:first-child
     1492                   ii            = 1
     1493                   .
     1494               do while valid-handle(hh):
     1495                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1496                   do:
     1497                       case lc(hh:name) :
     1498                           when "b-help" then
     1499                               do:
     1500                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1501                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1502                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1503                                   hh:TOOLTIP = "Помощь" .
     1504                                   v-help-old-x = hh:column .
     1505                                   v-help-old-y = hh:row    .
     1506                                   v-help-old-size = hh:width .
     1507                                   hh:width-chars = 2.5 .
     1508                               end.
     1509                           when "b-print" then
     1510                               do:
     1511                                   hh:load-image("cmp/b-print.bmp":u) .
     1512                                   hh:TOOLTIP = "Печать" .
     1513                                   v-h[ii] = hh:handle .
     1514                                   ii = ii + 1 .
     1515                                   hh:width-chars = 3 .
     1516                               end.
     1517                           when "b-history" or
     1518                           when "b-hist" then
     1519                               do:
     1520                                   hh:load-image("cmp/b-hist.bmp":u) .
     1521                                   hh:TOOLTIP = "История" .
     1522                                   v-h[ii] = hh:handle .
     1523                                   ii = ii + 1 .
     1524                                   hh:width-chars = 3 .
     1525                               end.
     1526                           when "b-sch" then
     1527                               do:
     1528                                   hh:load-image("cmp/b-sch.bmp":u) .
     1529                                   hh:TOOLTIP = "Установка Фильтра" .
     1530                                   v-h[ii] = hh:handle .
     1531                                   ii = ii + 1 .
     1532                                   hh:width-chars = 3 .
     1533                               end.
     1534                           when "b-hist-user" then
     1535                               do:
     1536                                   hh:load-image("cmp/b-hist.bmp":u) .
     1537                                   hh:TOOLTIP = "История пользователя" .
     1538                                   ii = ii + 1 .
     1539                               end.
     1540                       end case.
     1541                   end.
     1542                   hh = hh:next-sibling.
     1543               end.
     1544               b-help:column = v-frame-width - b-help:width-chars.
     1545               jj = 0.
     1546               repeat ii = 4 to 1 by -1 :
     1547                   if valid-handle (v-h[ii] ) then
     1548                   do:
     1549                       jj  = jj + 1 .
     1550                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1551                       v-h[ii]:row    = v-help-old-y .
     1552                   end.
     1553               end.
     1554           end.
     1555       end.
     1556   end procedure.
     1557   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1558   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1559   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1560   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1561   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1562   define variable v-diasize-current-frame-height as decimal   no-undo .
     1563   define variable v-diasize-change-size          as logical   no-undo .
     1564   define variable v-diasize-resize-button        as handle    no-undo .
     1565   define variable v-diasize-wndmax               as logical   no-undo .
     1566   define variable v-diasize-wndstore             as logical   no-undo .
     1567   define variable v-diasize-proc-name            as character no-undo .
     1568   define variable v-diasize-browse-handle        as handle    no-undo .
     1569   define variable v-diasize-browse-number        as integer   no-undo .
     1570   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1571   define temp-table temp-diasize-handle no-undo
     1572     field handle-value  as handle
     1573     field save-position as decimal
     1574     index xpk is primary unique handle-value
     1575     .
     1576   define temp-table temp-browse-handle no-undo
     1577     field browse-type   as character
     1578     field browse-number as integer
     1579     field browse-handle as handle
     1580     field original-size as decimal
     1581     index xpk is primary unique browse-type browse-number
     1582     index xie browse-type browse-handle
     1583   .
     1584   procedure diasize_change-height :
     1585     define input  parameter p-change-value  as decimal   no-undo .
     1586     define input  parameter p-move-resize   as logical   no-undo .
     1587     define variable v-field-group-handle    as handle    no-undo .
     1588     define variable v-object-handle         as handle    no-undo .
     1589     define variable v-frame-height          as decimal   no-undo .
     1590     define variable v-frame-virtual-height  as decimal   no-undo .
     1591     define variable v-browse-height         as decimal   no-undo .
     1592     define variable v-window-height         as decimal   no-undo .
     1593     define variable v-window-virtual-height as decimal   no-undo .
     1594     define variable v-change-sign           as integer   no-undo .
     1595     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1596     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1597     if p-change-value > 0
     1598     then do:
     1599       if frame Dialog-Frame :height + p-change-value
     1600           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1601       then do:
     1602         assign
     1603           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1604                           - (frame Dialog-Frame :height-chars)
     1605         .
     1606         if p-change-value <= 0
     1607         then do:
     1608           run diasize_position-resize-button in this-procedure .
     1609           return .
     1610         end.
     1611       end.
     1612     end.
     1613     if p-change-value < 0
     1614     then do:
     1615       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1616       then do:
     1617         assign
     1618           p-change-value = v-diasize-orig-frame-height
     1619                          - (frame Dialog-Frame :height-chars)
     1620         .
     1621         if p-change-value >= 0
     1622         then do:
     1623           run diasize_position-resize-button in this-procedure .
     1624           return .
     1625         end.
     1626       end.
     1627     end.
     1628     if p-change-value >= 0
     1629     then do:
     1630       assign
     1631         v-change-sign = 1
     1632       .
     1633     end.
     1634     else do:
     1635       assign
     1636         v-change-sign = -1
     1637       .
     1638     end.
     1639     assign
     1640       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1641     .
     1642     if p-change-value = 0
     1643     then do:
     1644       run diasize_position-resize-button in this-procedure .
     1645       return .
     1646     end.
     1647     move_block:
     1648     do
     1649     on error undo move_block, retry move_block
     1650     :
     1651       if retry
     1652       then do:
     1653         do
     1654         on error undo move_block, leave move_block
     1655         :
     1656           if p-change-value > 0
     1657           then do:
     1658             for each buf_temp-diasize-handle
     1659             on error undo, next
     1660             :
     1661               assign
     1662                 v-object-handle = buf_temp-diasize-handle.handle-value
     1663               .
     1664               if v-object-handle <> v-diasize-resize-button
     1665               then do:
     1666                 assign
     1667                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1668                 .
     1669               end.
     1670             end.
     1671             assign
     1672               v-diasize-browse-handle :height = v-browse-height
     1673             .
     1674             for each buf_temp-browse-handle
     1675               where buf_temp-browse-handle.browse-type = 'height':u
     1676             on error undo, next
     1677             :
     1678               assign
     1679                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1680               .
     1681             end.
     1682             assign
     1683               frame Dialog-Frame :height = v-frame-height
     1684             .
     1685             if frame Dialog-Frame :scrollable = true
     1686             then do:
     1687               assign
     1688                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1689               .
     1690             end.
     1691             run diasize_position-resize-button in this-procedure .
     1692           end.
     1693           else do:
     1694             if frame Dialog-Frame :scrollable = true
     1695             then do:
     1696               assign
     1697                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1698               .
     1699             end.
     1700             assign
     1701               frame Dialog-Frame :height = v-frame-height
     1702             .
     1703             assign
     1704               v-diasize-browse-handle :height = v-browse-height
     1705             .
     1706             for each buf_temp-browse-handle
     1707               where buf_temp-browse-handle.browse-type = 'height':u
     1708             on error undo, next
     1709             :
     1710               assign
     1711                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1712               .
     1713             end.
     1714             for each buf_temp-diasize-handle
     1715             on error undo, next
     1716             :
     1717               assign
     1718                 v-object-handle = buf_temp-diasize-handle.handle-value
     1719               .
     1720               if v-object-handle <> v-diasize-resize-button
     1721               then do:
     1722                 assign
     1723                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1724                 .
     1725               end.
     1726             end.
     1727             run diasize_position-resize-button in this-procedure .
     1728           end.
     1729           assign
     1730             v-diasize-change-size = false
     1731           .
     1732           leave move_block .
     1733         end.
     1734       end.
     1735       assign
     1736         v-diasize-need-full-display = true
     1737       .
     1738       if v-diasize-change-size = false
     1739       then do:
     1740         assign
     1741           v-diasize-change-size = true
     1742         .
     1743       end.
     1744       else do:
     1745         return .
     1746       end.
     1747       assign
     1748         v-frame-height = frame Dialog-Frame :height
     1749         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1750         v-browse-height = v-diasize-browse-handle :height
     1751       .
     1752       for each buf_temp-browse-handle
     1753         where buf_temp-browse-handle.browse-type = 'height':u
     1754       :
     1755         assign
     1756           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1757         .
     1758       end.
     1759       for each buf_temp-diasize-handle
     1760       :
     1761         delete buf_temp-diasize-handle .
     1762       end.
     1763       assign
     1764         v-field-group-handle = frame Dialog-Frame :first-child
     1765       .
     1766       do while valid-handle(v-field-group-handle)
     1767       :
     1768         assign
     1769           v-object-handle = v-field-group-handle :first-child
     1770         .
     1771         do while valid-handle(v-object-handle)
     1772         :
     1773           if  v-object-handle <> v-diasize-browse-handle :handle
     1774           and can-query(v-object-handle, "row")
     1775           and can-query(v-object-handle, "height")
     1776           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1777           then do:
     1778             find first buf_temp-browse-handle
     1779               where buf_temp-browse-handle.browse-type   = 'height':u
     1780                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1781               no-error .
     1782             if available buf_temp-browse-handle
     1783             then do:
     1784             end.
     1785             else do:
     1786               create buf_temp-diasize-handle .
     1787               assign
     1788                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1789                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1790               .
     1791             end.
     1792           end.
     1793           assign
     1794             v-object-handle = v-object-handle :next-sibling
     1795           .
     1796         end.
     1797         assign
     1798           v-field-group-handle = v-field-group-handle :next-sibling
     1799         .
     1800       end.
     1801       do with frame Dialog-Frame
     1802       :
     1803         hide v-diasize-resize-button .
     1804         assign
     1805           v-diasize-resize-button :row    = 1
     1806           v-diasize-resize-button :column = 1
     1807         .
     1808       end.
     1809       if p-change-value > 0
     1810       then do:
     1811         if frame Dialog-Frame :scrollable = true
     1812         then do:
     1813           assign
     1814             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1815             no-error .
     1816           if error-status :error
     1817           or error-status :get-message(1) <> ""
     1818           then do:
     1819             undo move_block, retry move_block .
     1820           end.
     1821         end.
     1822         assign
     1823           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1824           no-error .
     1825         if error-status :error
     1826         or error-status :get-message(1) <> ""
     1827         then do:
     1828           undo move_block, retry move_block .
     1829         end.
     1830         assign
     1831           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1832           no-error .
     1833         if error-status :error
     1834         or error-status :get-message(1) <> ""
     1835         then do:
     1836           undo move_block, retry move_block .
     1837         end.
     1838         for each buf_temp-browse-handle
     1839           where buf_temp-browse-handle.browse-type = 'height':u
     1840         on error undo move_block, retry move_block
     1841         :
     1842           assign
     1843             buf_temp-browse-handle.browse-handle :height
     1844               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1845             no-error .
     1846           if error-status :error
     1847           or error-status :get-message(1) <> ""
     1848           then do:
     1849             undo move_block, retry move_block .
     1850           end.
     1851         end.
     1852         for each buf_temp-diasize-handle
     1853         on error undo move_block, retry move_block
     1854         :
     1855           assign
     1856             v-object-handle = buf_temp-diasize-handle.handle-value
     1857           .
     1858           if v-object-handle <> v-diasize-resize-button
     1859           then do:
     1860             assign
     1861               v-object-handle :row = v-object-handle :row + p-change-value
     1862               no-error .
     1863             if error-status :error
     1864             or error-status :get-message(1) <> ""
     1865             then do:
     1866               undo move_block, retry move_block .
     1867             end.
     1868           end.
     1869         end.
     1870       end.
     1871       else do:
     1872         for each buf_temp-diasize-handle
     1873         on error undo move_block, retry move_block
     1874         :
     1875           assign
     1876             v-object-handle = buf_temp-diasize-handle.handle-value
     1877           .
     1878           if v-object-handle <> v-diasize-resize-button
     1879           then do:
     1880             assign
     1881               v-object-handle :row = v-object-handle :row + p-change-value
     1882               no-error .
     1883             if error-status :error
     1884             or error-status :get-message(1) <> ""
     1885             then do:
     1886               undo move_block, retry move_block .
     1887             end.
     1888           end.
     1889         end.
     1890         assign
     1891           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1892           no-error .
     1893         if error-status :error
     1894         or error-status :get-message(1) <> ""
     1895         then do:
     1896           undo move_block, retry move_block .
     1897         end.
     1898         for each buf_temp-browse-handle
     1899           where buf_temp-browse-handle.browse-type = 'height':u
     1900         on error undo move_block, retry move_block
     1901         :
     1902           assign
     1903             buf_temp-browse-handle.browse-handle :height
     1904               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1905             no-error .
     1906           if error-status :error
     1907           or error-status :get-message(1) <> ""
     1908           then do:
     1909             undo move_block, retry move_block .
     1910           end.
     1911         end.
     1912         assign
     1913           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1914           no-error .
     1915         if error-status :error
     1916         or error-status :get-message(1) <> ""
     1917         then do:
     1918           undo move_block, retry move_block .
     1919         end.
     1920         if frame Dialog-Frame :scrollable = true
     1921         then do:
     1922           assign
     1923             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1924             no-error .
     1925           if error-status :error
     1926           or error-status :get-message(1) <> ""
     1927           then do:
     1928             undo move_block, retry move_block .
     1929           end.
     1930         end.
     1931       end.
     1932       if p-move-resize = true
     1933       then do:
     1934         run diasize_position-resize-button in this-procedure .
     1935       end.
     1936       if v-diasize-wndstore = true
     1937       then do:
     1938         if connected("ub") = true
     1939         then do:
     1940           define variable v-cntxt-db-num        as integer   no-undo .
     1941           define variable v-cntxt-userid        as character no-undo .
     1942           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1943                                             , OUTPUT v-cntxt-userid
     1944                                             ) .
     1945           run gbl/wndsizew.p
     1946             (input  v-cntxt-db-num
     1947             ,input  v-cntxt-userid
     1948             ,input  v-diasize-proc-name
     1949             ,input  'height':u
     1950             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1951             ) .
     1952         end.
     1953       end.
     1954     end.
     1955     assign
     1956       v-diasize-change-size = false
     1957     .
     1958   end procedure.
     1959   procedure diasize_set-height :
     1960     define input  parameter p-new-height  as decimal   no-undo .
     1961     define input  parameter p-move-resize as logical   no-undo .
     1962     do
     1963     on error undo, return error return-value
     1964     :
     1965       run diasize_change-height in this-procedure
     1966         (input  (p-new-height - frame Dialog-Frame :height)
     1967         ,input  p-move-resize
     1968         ) .
     1969     end.
     1970   end procedure.
     1971   procedure diasize_change-width :
     1972     define input  parameter p-change-value as decimal   no-undo .
     1973     define input  parameter p-move-resize  as logical   no-undo .
     1974     define variable v-field-group-handle   as handle    no-undo .
     1975     define variable v-object-handle        as handle    no-undo .
     1976     define variable v-frame-width          as decimal   no-undo .
     1977     define variable v-frame-virtual-width  as decimal   no-undo .
     1978     define variable v-browse-width         as decimal   no-undo .
     1979     define variable v-window-width         as decimal   no-undo .
     1980     define variable v-window-virtual-width as decimal   no-undo .
     1981     define variable v-change-sign          as integer   no-undo .
     1982     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1983     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1984     if p-change-value > 0
     1985     then do:
     1986       if frame Dialog-Frame :width + p-change-value >
     1987           session :width-chars
     1988       then do:
     1989         assign
     1990           p-change-value = session :width-chars - frame Dialog-Frame :width
     1991         .
     1992         if p-change-value <= 0
     1993         then do:
     1994           run diasize_position-resize-button in this-procedure .
     1995           return .
     1996         end.
     1997       end.
     1998     end.
     1999     if p-change-value < 0
     2000     then do:
     2001       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2002       then do:
     2003         assign
     2004           p-change-value = v-diasize-orig-frame-width
     2005                          - frame Dialog-Frame :width
     2006         .
     2007         if p-change-value >= 0
     2008         then do:
     2009           run diasize_position-resize-button in this-procedure .
     2010           return .
     2011         end.
     2012       end.
     2013     end.
     2014     if p-change-value >= 0
     2015     then do:
     2016       assign
     2017         v-change-sign = 1
     2018       .
     2019     end.
     2020     else do:
     2021       assign
     2022         v-change-sign = -1
     2023       .
     2024     end.
     2025     assign
     2026       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2027     .
     2028     if p-change-value = 0
     2029     then do:
     2030       run diasize_position-resize-button in this-procedure .
     2031       return .
     2032     end.
     2033     move_block:
     2034     do
     2035     on error undo move_block, leave move_block
     2036     :
     2037       if retry
     2038       then do:
     2039         do
     2040         on error undo move_block, leave move_block
     2041         :
     2042           if p-change-value > 0
     2043           then do:
     2044             for each buf_temp-diasize-handle
     2045             on error undo, next
     2046             :
     2047               assign
     2048                 v-object-handle = buf_temp-diasize-handle.handle-value
     2049               .
     2050               if v-object-handle <> v-diasize-resize-button
     2051               then do:
     2052                 assign
     2053                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2054                 .
     2055               end.
     2056             end.
     2057             assign
     2058               v-diasize-browse-handle :width = v-browse-width
     2059             .
     2060             for each buf_temp-browse-handle
     2061               where buf_temp-browse-handle.browse-type = 'width':u
     2062             on error undo, next
     2063             :
     2064               assign
     2065                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2066               .
     2067             end.
     2068             assign
     2069               frame Dialog-Frame :width = v-frame-width
     2070             .
     2071             if frame Dialog-Frame :scrollable = true
     2072             then do:
     2073               assign
     2074                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2075               .
     2076             end.
     2077             run diasize_position-resize-button in this-procedure .
     2078           end.
     2079           else do:
     2080             if frame Dialog-Frame :scrollable = true
     2081             then do:
     2082               assign
     2083                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2084               .
     2085             end.
     2086             assign
     2087               frame Dialog-Frame :width = v-frame-width
     2088             .
     2089             for each buf_temp-browse-handle
     2090               where buf_temp-browse-handle.browse-type = 'width':u
     2091             on error undo, next
     2092             :
     2093               assign
     2094                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2095               .
     2096             end.
     2097             assign
     2098               v-diasize-browse-handle :width = v-browse-width
     2099             .
     2100             for each buf_temp-diasize-handle
     2101             on error undo, next
     2102             :
     2103               assign
     2104                 v-object-handle = buf_temp-diasize-handle.handle-value
     2105               .
     2106               if v-object-handle <> v-diasize-resize-button
     2107               then do:
     2108                 assign
     2109                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2110                 .
     2111               end.
     2112             end.
     2113             run diasize_position-resize-button in this-procedure .
     2114           end.
     2115           assign
     2116             v-diasize-change-size = false
     2117           .
     2118           leave move_block .
     2119         end.
     2120       end.
     2121       assign
     2122         v-diasize-need-full-display = true
     2123       .
     2124       if v-diasize-change-size = false
     2125       then do:
     2126         assign
     2127           v-diasize-change-size = true
     2128         .
     2129       end.
     2130       else do:
     2131         return .
     2132       end.
     2133       assign
     2134         v-frame-width = frame Dialog-Frame :width
     2135         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2136         v-browse-width = v-diasize-browse-handle :width
     2137       .
     2138       for each buf_temp-browse-handle
     2139         where buf_temp-browse-handle.browse-type = 'width':u
     2140       :
     2141         assign
     2142           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2143         .
     2144       end.
     2145       for each buf_temp-diasize-handle
     2146       :
     2147         delete buf_temp-diasize-handle .
     2148       end.
     2149       assign
     2150         v-field-group-handle = frame Dialog-Frame :first-child
     2151       .
     2152       do while valid-handle(v-field-group-handle)
     2153       :
     2154         assign
     2155           v-object-handle = v-field-group-handle :first-child
     2156         .
     2157         do while valid-handle(v-object-handle)
     2158         :
     2159           if  v-object-handle <> v-diasize-browse-handle :handle
     2160           and v-object-handle <> v-diasize-resize-button
     2161           and can-query(v-object-handle, "row")
     2162           and can-query(v-object-handle, "height")
     2163           and ( v-object-handle :col + v-object-handle :width
     2164                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2165               )
     2166           then do:
     2167             find first buf_temp-browse-handle
     2168               where buf_temp-browse-handle.browse-type   = 'width':u
     2169                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2170               no-error .
     2171             if available buf_temp-browse-handle
     2172             then do:
     2173             end.
     2174             else do:
     2175               create buf_temp-diasize-handle .
     2176               assign
     2177                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2178                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2179               .
     2180             end.
     2181           end.
     2182           assign
     2183             v-object-handle = v-object-handle :next-sibling
     2184           .
     2185         end.
     2186         assign
     2187           v-field-group-handle = v-field-group-handle :next-sibling
     2188         .
     2189       end.
     2190       do with frame Dialog-Frame
     2191       :
     2192         hide v-diasize-resize-button .
     2193         v-diasize-resize-button :row = 1.
     2194         v-diasize-resize-button :column = 1.
     2195       end.
     2196       if p-change-value > 0
     2197       then do:
     2198         if frame Dialog-Frame :scrollable = true
     2199         then do:
     2200           assign
     2201             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2202             no-error .
     2203           if error-status :error
     2204           or error-status :get-message(1) <> ""
     2205           then do:
     2206             undo move_block, retry move_block.
     2207           end.
     2208         end.
     2209         assign
     2210           frame Dialog-Frame :width = v-frame-width + p-change-value
     2211           no-error .
     2212         if error-status :error
     2213         or error-status :get-message(1) <> ""
     2214         then do:
     2215           undo move_block, retry move_block.
     2216         end.
     2217         assign
     2218           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2219         no-error .
     2220         if error-status :error
     2221         or error-status :get-message(1) <> ""
     2222         then do:
     2223           undo move_block, retry move_block.
     2224         end.
     2225         for each buf_temp-browse-handle
     2226           where buf_temp-browse-handle.browse-type = 'width':u
     2227         on error undo move_block, retry move_block
     2228         :
     2229           assign
     2230             buf_temp-browse-handle.browse-handle :width
     2231               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2232             no-error .
     2233           if error-status :error
     2234           or error-status :get-message(1) <> ""
     2235           then do:
     2236             undo move_block, retry move_block .
     2237           end.
     2238         end.
     2239         for each buf_temp-diasize-handle
     2240         on error undo move_block, retry move_block
     2241         :
     2242           assign
     2243             v-object-handle = buf_temp-diasize-handle.handle-value
     2244           .
     2245           if v-object-handle <> v-diasize-resize-button
     2246           then do:
     2247             assign
     2248               v-object-handle :col = v-object-handle :col + p-change-value
     2249               no-error .
     2250             if error-status :error
     2251             or error-status :get-message(1) <> ""
     2252             then do:
     2253               undo move_block, retry move_block .
     2254             end.
     2255           end.
     2256         end.
     2257       end.
     2258       else do:
     2259         for each buf_temp-diasize-handle
     2260         on error undo move_block, retry move_block
     2261         :
     2262           assign
     2263             v-object-handle = buf_temp-diasize-handle.handle-value
     2264           .
     2265           if v-object-handle <> v-diasize-resize-button
     2266           then do:
     2267             assign
     2268               v-object-handle :col = v-object-handle :col + p-change-value
     2269               no-error .
     2270             if error-status :error
     2271             or error-status :get-message(1) <> ""
     2272             then do:
     2273               undo move_block, retry move_block .
     2274             end.
     2275           end.
     2276         end.
     2277         for each buf_temp-browse-handle
     2278           where buf_temp-browse-handle.browse-type = 'width':u
     2279         on error undo move_block, retry move_block
     2280         :
     2281           assign
     2282             buf_temp-browse-handle.browse-handle :width
     2283               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2284             no-error .
     2285           if error-status :error
     2286           or error-status :get-message(1) <> ""
     2287           then do:
     2288             undo move_block, retry move_block .
     2289           end.
     2290         end.
     2291         assign
     2292           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2293           no-error .
     2294         if error-status :error
     2295         or error-status :get-message(1) <> ""
     2296         then do:
     2297           undo move_block, retry move_block.
     2298         end.
     2299         assign
     2300           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2301         no-error .
     2302         if error-status :error
     2303         or error-status :get-message(1) <> ""
     2304         then do:
     2305           undo move_block, retry move_block.
     2306         end.
     2307         if frame Dialog-Frame :scrollable = true
     2308         then do:
     2309           assign
     2310             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2311           no-error .
     2312           if error-status :error
     2313           or error-status :get-message(1) <> ""
     2314           then do:
     2315             undo move_block, retry move_block.
     2316           end.
     2317         end.
     2318       end.
     2319       if p-move-resize
     2320       then do:
     2321         run diasize_position-resize-button in this-procedure .
     2322       end.
     2323       if v-diasize-wndstore = true
     2324       then do:
     2325         if connected("ub") = true
     2326         then do:
     2327           define variable v-cntxt-db-num        as integer   no-undo .
     2328           define variable v-cntxt-userid        as character no-undo .
     2329           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2330                                             , OUTPUT v-cntxt-userid
     2331                                             ) .
     2332           run gbl/wndsizew.p
     2333             (input  v-cntxt-db-num
     2334             ,input  v-cntxt-userid
     2335             ,input  v-diasize-proc-name
     2336             ,input  'width':u
     2337             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2338             ) .
     2339         end.
     2340       end.
     2341     end.
     2342     assign
     2343       v-diasize-change-size = false
     2344     .
     2345   end procedure.
     2346   procedure diasize_set-width :
     2347     define input  parameter p-new-width  as decimal   no-undo .
     2348     define input  parameter p-move-resize as logical   no-undo .
     2349     do
     2350     on error undo, return error return-value
     2351     :
     2352       run diasize_change-width in this-procedure
     2353         (input  (p-new-width - frame Dialog-Frame :width)
     2354         ,input  p-move-resize
     2355         ) .
     2356     end.
     2357   end procedure.
     2358   procedure diasize_position-resize-button :
     2359     do with frame Dialog-Frame
     2360     :
     2361       hide v-diasize-resize-button .
     2362       assign
     2363         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2364                     - 1
     2365                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2366         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2367                     - 1
     2368                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2369       .
     2370       view v-diasize-resize-button .
     2371     end.
     2372   end procedure.
     2373   on alt-right anywhere
     2374   do:
     2375     run diasize_change-width in this-procedure
     2376       (input 1
     2377       ,input true
     2378       ) .
     2379     return no-apply .
     2380   end.
     2381   on alt-left anywhere
     2382   do:
     2383     run diasize_change-width in this-procedure
     2384       (input -1
     2385       ,input true
     2386       ) .
     2387     return no-apply .
     2388   end.
     2389   on alt-down anywhere
     2390   do:
     2391     run diasize_change-height in this-procedure
     2392       (input 1
     2393       ,input true
     2394       ) .
     2395     return no-apply .
     2396   end.
     2397   on alt-up anywhere
     2398   do:
     2399     run diasize_change-height in this-procedure
     2400       (input -1
     2401       ,input true
     2402       ) .
     2403     return no-apply .
     2404   end.
     2405   on alt-enter of frame Dialog-Frame
     2406   do:
     2407     run diasize_maximize in this-procedure
     2408       (input  ?
     2409       ).
     2410     return no-apply .
     2411   end.
     2412   procedure diasize_end-move :
     2413     do
     2414     on error undo, return error return-value
     2415     :
     2416       define variable v-row-delta as decimal   no-undo .
     2417       define variable v-col-delta as decimal   no-undo .
     2418       define variable v-new-row as decimal   no-undo .
     2419       define variable v-new-col as decimal   no-undo .
     2420       assign
     2421         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2422         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2423       .
     2424       assign
     2425         v-row-delta = v-new-row - frame Dialog-Frame :height
     2426         v-col-delta = v-new-col - frame Dialog-Frame :width
     2427       .
     2428       run diasize_change-height in this-procedure
     2429         (input v-row-delta
     2430         ,input true
     2431         ) .
     2432       run diasize_change-width in this-procedure
     2433         (input v-col-delta
     2434         ,input true
     2435         ) .
     2436     end.
     2437   end procedure.
     2438   procedure diasize_maximize :
     2439     define input  parameter p-action as logical   no-undo .
     2440     do
     2441     on error undo, return error return-value
     2442     :
     2443       if p-action = ?
     2444       then do:
     2445         if v-diasize-need-maximize = true
     2446         then do:
     2447           assign
     2448             p-action = true
     2449           .
     2450         end.
     2451         else do:
     2452           assign
     2453             p-action = false
     2454           .
     2455         end.
     2456       end.
     2457       if p-action = true
     2458       then do:
     2459         run diasize_change-height in this-procedure
     2460           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2461               - frame Dialog-Frame :height-chars
     2462           ,input true
     2463           ) .
     2464         run diasize_change-width in this-procedure
     2465           (input session :width-chars
     2466               - frame Dialog-Frame :width-chars
     2467           ,input true
     2468           ) .
     2469         assign
     2470           v-diasize-need-maximize = false
     2471         .
     2472       end.
     2473       else do:
     2474         run diasize_change-width in this-procedure
     2475           (input v-diasize-orig-frame-width
     2476               - frame Dialog-Frame :width-chars
     2477           ,input true
     2478           ) .
     2479         run diasize_change-height in this-procedure
     2480           (input v-diasize-orig-frame-height
     2481               - frame Dialog-Frame :height-chars
     2482           ,input true
     2483           ) .
     2484         assign
     2485           v-diasize-need-maximize = true
     2486         .
     2487       end.
     2488     end.
     2489   end procedure.
     2490   procedure diasize_restore-orig-size :
     2491     do
     2492     on error undo, return error return-value
     2493     :
     2494       assign
     2495         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2496         v-diasize-current-frame-height = frame Dialog-Frame :height
     2497       .
     2498       run diasize_set-height in this-procedure
     2499         (input  v-diasize-orig-frame-height
     2500         ,input  true
     2501         ) .
     2502       run diasize_set-width in this-procedure
     2503         (input  v-diasize-orig-frame-width
     2504         ,input  true
     2505         ) .
     2506     end.
     2507   end procedure.
     2508   procedure diasize_restore-current-size :
     2509     do
     2510     on error undo, return error return-value
     2511     :
     2512       run diasize_set-height in this-procedure
     2513         (input  v-diasize-current-frame-height
     2514         ,input  true
     2515         ) .
     2516       run diasize_set-width in this-procedure
     2517         (input  v-diasize-current-frame-width
     2518         ,input  true
     2519         ) .
     2520     end.
     2521   end procedure.
     2522   procedure diasize_set-browse-handle :
     2523     define input  parameter p-browse-handle as handle   no-undo .
     2524     define buffer buf_temp-browse-handle for temp-browse-handle .
     2525     do
     2526     on error undo, return error return-value
     2527     :
     2528       assign
     2529         v-diasize-browse-handle = p-browse-handle
     2530       .
     2531       for each buf_temp-browse-handle
     2532       on error undo, return error return-value
     2533       :
     2534         delete buf_temp-browse-handle .
     2535       end.
     2536     end.
     2537   end procedure.
     2538   procedure diasize_add_browse :
     2539     define input  parameter p-browse-type   as character no-undo .
     2540     define input  parameter p-browse-handle as handle    no-undo .
     2541     define buffer buf_temp-browse-handle for temp-browse-handle .
     2542     do
     2543     on error undo, return error return-value
     2544     :
     2545       assign
     2546         v-diasize-browse-number = v-diasize-browse-number + 1
     2547       .
     2548       create buf_temp-browse-handle .
     2549       assign
     2550         buf_temp-browse-handle.browse-type   = p-browse-type
     2551         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2552         buf_temp-browse-handle.browse-handle = p-browse-handle
     2553       .
     2554     end.
     2555   end procedure.
     2556   procedure diasize_init :
     2557     define variable v-default-value    as logical   no-undo .
     2558     define variable v-restore-saved    as logical   no-undo .
     2559     define variable v-resize-value-str as character no-undo .
     2560     do
     2561     on error undo, return error return-value
     2562     :
     2563       do with frame Dialog-Frame
     2564       :
     2565         assign
     2566           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2567           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2568           v-diasize-browse-handle     = browse BR-cgdsobj :handle
     2569         .
     2570         create button v-diasize-resize-button
     2571         assign
     2572           parent        = frame Dialog-Frame :first-child
     2573           label         = "s"
     2574           height-pixels = 16
     2575           width-pixels  = 16
     2576           visible       = true
     2577           sensitive     = true
     2578           movable       = true
     2579           triggers:
     2580             on end-move persistent run diasize_end-move in this-procedure .
     2581           end triggers.
     2582         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2583         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2584         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2585         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2586         assign
     2587           v-diasize-wndmax = false
     2588         .
     2589         if connected("ub") = true
     2590         then do:
     2591           define variable v-cntxt-db-num        as integer   no-undo .
     2592           define variable v-cntxt-userid        as character no-undo .
     2593           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2594                                             , OUTPUT v-cntxt-userid
     2595                                             ) .
     2596           run gbl/wndpar_r.p
     2597             (input  v-cntxt-db-num
     2598             ,input  v-cntxt-userid
     2599             ,input  'wndmax':U
     2600             ,output v-diasize-wndmax
     2601             ,output v-default-value
     2602             ) .
     2603         end.
     2604         assign
     2605           v-diasize-wndstore = false
     2606         .
     2607         if connected("ub") = true
     2608         then do:
     2609           run gbl/wndpar_r.p
     2610             (input  v-cntxt-db-num
     2611             ,input  v-cntxt-userid
     2612             ,input  'wndstore':U
     2613             ,output v-diasize-wndstore
     2614             ,output v-default-value
     2615             ) .
     2616         end.
     2617         assign
     2618           v-diasize-proc-name = entry(1, program-name(2), '.')
     2619         .
     2620         if v-diasize-wndstore = true
     2621         then do:
     2622           assign
     2623             v-restore-saved = false
     2624           .
     2625           if connected("ub") = true
     2626           then do:
     2627             run gbl/wndsizer.p
     2628               (input  v-cntxt-db-num
     2629               ,input  v-cntxt-userid
     2630               ,input  v-diasize-proc-name
     2631               ,input  'height':u
     2632               ,output v-resize-value-str
     2633               ) .
     2634             if v-resize-value-str <> '':U
     2635             then do:
     2636               run diasize_change-height in this-procedure
     2637                 (input  integer(v-resize-value-str)
     2638                 ,input  true
     2639                 ) .
     2640               assign
     2641                 v-restore-saved = true
     2642               .
     2643             end.
     2644           end.
     2645           if connected("ub") = true
     2646           then do:
     2647             run gbl/wndsizer.p
     2648               (input  v-cntxt-db-num
     2649               ,input  v-cntxt-userid
     2650               ,input  v-diasize-proc-name
     2651               ,input  'width':u
     2652               ,output v-resize-value-str
     2653               ) .
     2654             if v-resize-value-str <> '':U
     2655             then do:
     2656               run diasize_change-width in this-procedure
     2657                 (input  integer(v-resize-value-str)
     2658                 ,input  true
     2659                 ) .
     2660               assign
     2661                 v-restore-saved = true
     2662               .
     2663             end.
     2664           end.
     2665           if v-restore-saved <> true
     2666           then do:
     2667             if v-diasize-wndmax = true
     2668             then do:
     2669               run diasize_maximize in this-procedure
     2670                 (input  true
     2671                 ) .
     2672             end.
     2673           end.
     2674         end.
     2675         else do:
     2676           if v-diasize-wndmax = true
     2677           then do:
     2678             run diasize_maximize in this-procedure
     2679               (input  true
     2680               ) .
     2681           end.
     2682         end.
     2683       end.
     2684     end.
     2685   end procedure.
     2686   procedure diasize_need-full-display :
     2687     define output parameter p-need-full-display as logical   no-undo .
     2688     do
     2689     on error undo, return error return-value
     2690     :
     2691       assign
     2692         p-need-full-display = v-diasize-need-full-display
     2693       .
     2694       assign
     2695         v-diasize-need-full-display = false
     2696       .
     2697     end.
     2698   end procedure.
     2699   procedure get-context :
     2700      define output parameter p-db-num as integer          no-undo.
     2701      define output parameter p-user-id as character        no-undo.
     2702      define variable v-login               as character    no-undo.
     2703      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2704      define buffer buf_user-login  for ub.user-login .
     2705      do
     2706      on error undo, return error
     2707      :
     2708            FIND FIRST buf_sys-ctrl no-lock.
     2709            ASSIGN
     2710               v-login = USERID("ub")
     2711               p-db-num = buf_sys-ctrl.db-num
     2712            .
     2713            FIND FIRST buf_user-login
     2714                 WHERE buf_user-login.db-num = p-db-num
     2715                   AND buf_user-login.user-login = v-login
     2716                 no-lock
     2717                 no-error
     2718                 .
     2719            IF AVAILABLE buf_user-login
     2720            THEN DO:
     2721               assign
     2722                  p-user-id = buf_user-login.user-id
     2723               .
     2724            END.
     2725      end.
     2726   end procedure.
     2727       run diasize_init in this-procedure .
     2728   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2729   procedure set-filter-name :
     2730   define input parameter p-filter-name as character no-undo .
     2731     do with frame Dialog-Frame:
     2732       if p-filter-name > "" then do:
     2733         assign
     2734           frame Dialog-Frame:title
     2735             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2736         .
     2737         assign
     2738           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2739         .
     2740       end.
     2741       else do:
     2742         assign
     2743           b-sch :tooltip = ""
     2744         .
     2745       end.
     2746     end.
     2747   end procedure.
     2748   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2749   on ' ' of sch-corr-date in frame Dialog-Frame
     2750   do:
     2751     if (can-query (self, "sensitive")
     2752        and
     2753        self :sensitive = true
     2754        )
     2755     or (can-query (self, "read-only")
     2756        and
     2757        self :read-only = false
     2758        )
     2759     then do:
     2760       assign
     2761         self :screen-value = ?
     2762       .
     2763     end.
     2764     return no-apply.
     2765   end.
     2766   on delete-character of sch-corr-date in frame Dialog-Frame
     2767   do:
     2768     if (can-query (self, "sensitive")
     2769        and
     2770        self :sensitive = true
     2771        )
     2772     or (can-query (self, "read-only")
     2773        and
     2774        self :read-only = false
     2775        )
     2776     then do:
     2777       assign
     2778         self :screen-value = ?
     2779       .
     2780     end.
     2781     return no-apply.
     2782   end.
     2783   on ctrl-d of sch-corr-date in frame Dialog-Frame
     2784   do:
     2785     define variable v-curr-sv-date as date no-undo .
     2786     if (can-query (self, "sensitive")
     2787        and
     2788        self :sensitive = true
     2789        )
     2790     or (can-query (self, "read-only")
     2791        and
     2792        self :read-only = false
     2793        )
     2794     then do:
     2795       if self :handle <> focus :handle
     2796       then do:
     2797         apply "entry":u to self .
     2798       end.
     2799       run gbl/getcurdt.p
     2800         (output v-curr-sv-date
     2801         ) .
     2802       assign
     2803         self :screen-value = string(v-curr-sv-date) .
     2804       .
     2805     end.
     2806     return no-apply.
     2807   end.
     2808   on ctrl-b of sch-corr-date in frame Dialog-Frame
     2809   do:
     2810     if (can-query (self, "sensitive")
     2811        and
     2812        self :sensitive = true
     2813        )
     2814     or (can-query (self, "read-only")
     2815        and
     2816        self :read-only = false
     2817        )
     2818     then do:
     2819       if self :handle <> focus :handle
     2820       then do:
     2821         apply "entry":u to self .
     2822       end.
     2823       define variable v-curr-sv-date as date no-undo .
     2824       define variable v-new-sv-date  as date no-undo .
     2825       assign
     2826         v-curr-sv-date = date(self :screen-value) no-error
     2827       .
     2828       if v-curr-sv-date = ?
     2829       then do:
     2830         run gbl/getcurdt.p
     2831           (output v-curr-sv-date
     2832           ) .
     2833       end.
     2834       if v-curr-sv-date <> ?
     2835       then do:
     2836         assign
     2837           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     2838         .
     2839         assign
     2840           self :screen-value = string(v-new-sv-date) .
     2841         .
     2842       end.
     2843     end.
     2844     return no-apply .
     2845   end.
     2846   on ctrl-e of sch-corr-date in frame Dialog-Frame
     2847   do:
     2848     if (can-query (self, "sensitive")
     2849        and
     2850        self :sensitive = true
     2851        )
     2852     or (can-query (self, "read-only")
     2853        and
     2854        self :read-only = false
     2855        )
     2856     then do:
     2857       if self :handle <> focus :handle
     2858       then do:
     2859         apply "entry":u to self .
     2860       end.
     2861       define variable v-curr-sv-date as date no-undo .
     2862       define variable v-new-sv-date  as date no-undo .
     2863       assign
     2864         v-curr-sv-date = date(self :screen-value) no-error
     2865       .
     2866       if v-curr-sv-date = ?
     2867       then do:
     2868         run gbl/getcurdt.p
     2869           (output v-curr-sv-date
     2870           ) .
     2871       end.
     2872       if v-curr-sv-date <> ?
     2873       then do:
     2874         run gbl/lastdate.p
     2875           (input  v-curr-sv-date
     2876           ,output v-new-sv-date
     2877           ).
     2878         assign
     2879           self :screen-value = string(v-new-sv-date) .
     2880         .
     2881       end.
     2882     end.
     2883     return no-apply .
     2884   end.
     2885   on ctrl-f of sch-corr-date in frame Dialog-Frame
     2886   do:
     2887     if (can-query (self, "sensitive")
     2888        and
     2889        self :sensitive = true
     2890        )
     2891     or (can-query (self, "read-only")
     2892        and
     2893        self :read-only = false
     2894        )
     2895     then do:
     2896       if self :handle <> focus :handle
     2897       then do:
     2898         apply "entry":u to self .
     2899       end.
     2900       define variable v-ok            as logical   no-undo .
     2901       define variable v-curr-sv-date  as date      no-undo .
     2902       define variable v-description   as character no-undo .
     2903       assign
     2904         v-curr-sv-date = date(self :screen-value) no-error
     2905       .
     2906       if v-curr-sv-date = ?
     2907       then do:
     2908         run gbl/getcurdt.p
     2909           (output v-curr-sv-date
     2910           ) .
     2911       end.
     2912       if v-curr-sv-date <> ?
     2913       then do:
     2914         run gbl/d-inpday.w
     2915           (input ?
     2916           ,input "Выбор даты"
     2917           ,input v-description
     2918           ,input ""
     2919           ,input-output v-curr-sv-date
     2920           ,output v-ok
     2921           ).
     2922         if v-ok = true
     2923         then do:
     2924           assign
     2925             self :screen-value = string(v-curr-sv-date) .
     2926           .
     2927         end.
     2928       end.
     2929     end.
     2930     return no-apply .
     2931   end.
