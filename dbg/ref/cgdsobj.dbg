        1   DEFINE BUFFER X_c-gds-obj FOR ub.c-gds-obj.
        2   define input  parameter parparentproc as WIDGET-HANDLE no-undo .
        3   define input  parameter p-obj-type as character no-undo .
        4   define input  parameter p-obj-code as integer   no-undo .
        5   define input  parameter p-gds-code as integer   no-undo .
        6   define variable vss-revision    as character no-undo initial "$Revision$":U .
        7   define variable vss-author      as character no-undo initial "$Author$":U .
        8   define variable vss-date        as character no-undo initial "$Date$":U .
        9   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
       10   define variable vss-archive     as character no-undo initial "$Archive$":U .
       11   define variable vss-description as character no-undo initial "История изменения товара на объекте".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   procedure proc-alt-shift-f2:
       82     if not ibs.th.gbl.gbl-var:rcode
       83   then
       84     run gbl\inidebug.p .
       85   end.
       86   procedure proc-alt-shift-f3:
       87     run gbl/prvssinf.p
       88       ( input this-procedure
       89       ) .
       90   end.
       91   define variable v-inform-launched as logical no-undo initial false .
       92   procedure proc-alt-shift-f4:
       93     define variable v-action as character no-undo .
       94     if v-inform-launched = false then do:
       95       assign
       96         v-inform-launched = true
       97       .
       98       run gbl/d-inform.w
       99         (  input self
      100         ,  input this-procedure
      101         , output v-action
      102         ) no-error .
      103       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      104       assign
      105         v-inform-launched = false
      106       .
      107     end.
      108   end.
      109   procedure proc-alt-f1:
      110     run gbl/corrhelp.p
      111       (input this-procedure
      112       ) .
      113   end .
      114   on alt-shift-f2 anywhere do:
      115     run proc-alt-shift-f2.
      116   end.
      117   on alt-shift-f3 anywhere do:
      118     run proc-alt-shift-f3 in this-procedure .
      119   end.
      120   on alt-shift-f4 anywhere do:
      121     run proc-alt-shift-f4 in this-procedure.
      122   end.
      123   on alt-f1 anywhere do:
      124     run proc-alt-f1 in this-procedure .
      125   end.
      126   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define variable v-waitfram-action01         as character   no-undo .
      128   define variable v-waitfram-action02         as character   no-undo .
      129   define variable v-waitfram-action03         as character   no-undo .
      130   define variable mWaitFramTextBeg            as character   no-undo.
      131   define variable mWaitFramTextEnd            as character   no-undo.
      132   define variable mWaitFramView               as logical     no-undo.
      133   define variable mWaitProcEvent              as logical     no-undo init yes.
      134   define variable mWaitFramInterval           as integer     no-undo init 1 .
      135   define variable mWaitFramStop               as logical     no-undo.
      136   define variable mWaitFramStopUser           as logical     no-undo.
      137   define variable mWaitFramStopTimeOut        as logical     no-undo.
      138   define variable mWaitFramStartProc          as datetime-tz no-undo.
      139   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      140   define button B-WaitFramStop auto-end-key
      141        label "Стоп"
      142        size 10 by 1 tooltip "Остоновить процесс".
      143   define button B-viewProcInfo
      144        label "Информация"
      145        size 15 by 1 tooltip "Информация о процесс".
      146   define frame waitfram
      147     v-waitfram-action01 format "x(72)" no-label skip
      148     v-waitfram-action02 format "x(72)" no-label skip
      149     v-waitfram-action03 format "x(72)" no-label skip
      150     B-viewProcInfo
      151     B-WaitFramStop at row 4 col 30
      152     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      153     .
      154   define new global shared variable mBatchMode as logical no-undo init ?.
      155   define variable mFramBachModHandle as handle no-undo.
      156   mFramBachModHandle = frame waitfram:handle.
      157   define variable mFameOldVis as logical no-undo.
      158   define variable mVisCUrentVin as logical no-undo.
      159   if session:batch-mode
      160   then
      161      mBatchMode = yes.
      162   if mBatchMode = ? then do:
      163     mVisCUrentVin = current-window:visible.
      164     mFameOldVis = mFramBachModHandle:visible.
      165     mFramBachModHandle:visible  = yes.
      166     mBatchMode = mFramBachModHandle:visible ne yes.
      167     mFramBachModHandle:visible = mFameOldVis.
      168     current-window:visible = mVisCUrentVin.
      169   end.
      170    if  log-manager:logfile-name ne ?
      171     then DO:
      172         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      173         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      174         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      175     end.
      176   on choose of B-WaitFramStop in frame waitfram
      177   do:
      178     mWaitFramStop = yes.
      179     mWaitFramStopUser = yes.
      180   end.
      181   function waitfram-check-timeout returns logical():
      182      define variable vtime as int64 no-undo.
      183      if mWaitFramStopTimeOut
      184      then
      185         return yes.
      186      vtime = ( now - mWaitFramStartProc ) / 1000 .
      187      if     mWaitFramTimeOut ne ?
      188         and mWaitFramTimeOut ne 0
      189         and mWaitFramTimeOut lt vtime
      190      then do:
      191         mWaitFramStopTimeOut = yes.
      192      end.
      193      return mWaitFramStopTimeOut.
      194   end.
      195   procedure waitfram-hide :
      196     if not session:batch-mode
      197     then do
      198     on error undo, return error return-value
      199     :
      200       pause 0 before-hide .
      201       if not mBatchMode then
      202         hide frame waitfram .
      203     if     not mWaitFramView
      204        and mWaitProcEvent
      205     then
      206       process events .
      207     end.
      208   end procedure.
      209   procedure waitfram-show :
      210     define input  parameter p-message as character no-undo .
      211     define variable v-left-margin as integer   no-undo .
      212     if not session:batch-mode
      213     then do
      214     on error undo, return error return-value
      215     :
      216       if length(p-message) <= 70 then do:
      217         assign
      218           v-left-margin = integer((70 - length(p-message)) / 2)
      219         .
      220         assign
      221           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      222         .
      223         assign
      224           v-waitfram-action01 = " "
      225           v-waitfram-action02 = " "
      226                                    + fill(" ", v-left-margin)
      227                                    + p-message
      228           v-waitfram-action03 = " "
      229         .
      230       end.
      231       else do:
      232         define variable vRindex1 as integer no-undo.
      233         define variable vRindex2 as integer no-undo.
      234         vRindex1 = r-index(p-message," ",70).
      235         if vRindex1 = 0
      236         then
      237            vRindex1 = 70.
      238         if length(p-message)  <= vRindex1 + 70 then do:
      239           assign
      240             v-waitfram-action01 = " "
      241             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      242             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      243           .
      244         end.
      245         else do:
      246           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      247           if vRindex2 <= vRindex1
      248           then
      249              vRindex2 = vRindex1 + 70.
      250           assign
      251             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      252             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      253             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      254           .
      255         end.
      256       end.
      257       B-viewProcInfo:visible   in frame waitfram = no.
      258       B-viewProcInfo:sensitive in frame waitfram = no.
      259       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      260       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      261       if  (   mWaitFramView
      262          or  mWaitProcEvent)
      263          and not mBatchMode
      264       then
      265          display
      266             v-waitfram-action01 skip
      267             v-waitfram-action02 skip
      268             v-waitfram-action03 skip
      269          with frame waitfram .
      270       if     mWaitFramView
      271          then do:
      272             if     mWaitFramInterval ne ?
      273                and not mBatchMode
      274             then
      275                wait-for go of frame waitfram pause mWaitFramInterval.
      276          end.
      277          else
      278             if     mWaitProcEvent
      279                and not mBatchMode
      280             then
      281                process events .
      282     end.
      283   end procedure.
      284      procedure waitfram-show-this:
      285         define input  parameter iInterval as int64 no-undo.
      286         define variable vtime as int64 no-undo.
      287         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      288         mWaitFramInterval = iInterval.
      289         run waitfram-show (substitute("&1&2 &3&4" ,
      290                                       mWaitFramTextBeg ,
      291                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      292                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      293                                       mWaitFramTextEnd
      294                                      )
      295                           ).
      296      end.
      297      procedure WaitFramRunPause:
      298         define input  parameter iInterval as dec no-undo.
      299         define variable vStart  as datetime-tz no-undo.
      300         define variable vend    as datetime-tz no-undo.
      301         define variable vint as int64 no-undo.
      302         define variable vOk as logical no-undo.
      303         vStart = now.
      304         vend   = vStart.
      305         publish "WaitFramPause" (iInterval,output vOk).
      306         vend   =  now.
      307         vint = vend - vStart.
      308         vint = iInterval - vint / 1000.
      309         if     not mWaitFramStop
      310            and (   vint > 0
      311                 or (    not vOk
      312                     and iInterval eq ?
      313                     )
      314                 )
      315         then
      316            run waitfram-show-this (iInterval).
      317         vend   =  now.
      318         vint = vend - vStart.
      319         vint = iInterval - vint / 1000.
      320         if     not mWaitFramStop
      321            and vint > 0
      322         then do:
      323            run gbl/pause.p (vint * 1000).
      324         end.
      325         if iInterval ne ?
      326         then
      327            publish "WaitFramStop".
      328         waitfram-check-timeout().
      329      end.
      330      procedure WaitFramWaitFor:
      331         define input  parameter iInterval as dec no-undo.
      332         assign
      333            mWaitFramStartProc   = now
      334            mWaitFramStopUser    = no
      335            mWaitFramStopTimeOut = no
      336         .
      337         block-wait:
      338         do while not mWaitFramStop:
      339            run WaitFramRunPause (iInterval).
      340            if  waitfram-check-timeout()
      341            then do:
      342               leave block-wait.
      343            end.
      344         end.
      345         run waitfram-hide.
      346      end.
      347   procedure waitfram-join :
      348     define input  parameter p-line-1  as character no-undo .
      349     define input  parameter p-line-2  as character no-undo .
      350     define input  parameter p-line-3  as character no-undo .
      351     define output parameter p-message as character no-undo .
      352     do
      353     on error undo, return error return-value
      354     :
      355       assign
      356         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      357                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      358                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      359       .
      360     end.
      361   end procedure.
      362   function waitfram-join-function returns character
      363     (input p-line-1 as character
      364     ,input p-line-2 as character
      365     ,input p-line-3 as character
      366     ).
      367     define variable v-message as character no-undo .
      368     run waitfram-join in this-procedure
      369       (input  p-line-1
      370       ,input  p-line-2
      371       ,input  p-line-3
      372       ,output v-message
      373       ) .
      374     return v-message .
      375   end function .
      376   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      378   define new shared variable RepPathName        as character no-undo .
      379   define new shared variable PrintRubl          as logical   no-undo .
      380   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   define  stream PrnLibStream.
      382   procedure prn-lib-prn-file :
      383     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      384     define input parameter p-DIsabledoptions as integer no-undo .
      385     define variable v-report-name as character no-undo .
      386     define variable v-user-action as character no-undo .
      387     define variable v-printed     as logical   no-undo .
      388     define variable v-exist       as logical   no-undo .
      389     do
      390       on error undo, return error
      391       :
      392       run prn-lib-get-report-name  in this-procedure (
      393         input parParentProc
      394         ,output v-report-name
      395         ).
      396   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      397   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      398     (input  v-report-name
      399     ,input  2
      400     ,output v-exist
      401     )  .
      402       if NOT v-exist then
      403       DO:
      404         Message
      405           "Нет заданий на печать ! "
      406           view-as alert-box .
      407         Return  .
      408       End.
      409       run gbl/prnfilen.w
      410         (input  ""
      411         ,input  p-DisabledOptions
      412         ,input  string(v-report-name )
      413         ,input  7
      414         ,output v-user-action
      415         ,output v-printed
      416         ) .
      417       if v-printed then
      418       do:
      419         return "YES" .
      420       end.
      421       else
      422       do:
      423         return "NO" .
      424       end.
      425     end.
      426   end procedure.
      427   procedure prn-lib-open-stream :
      428     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      429     define input parameter p-page-size    as integer no-undo .
      430     define input parameter p-is-stream    as logical no-undo .
      431     define input parameter p-append       as logical no-undo .
      432     define variable v-report-name as character no-undo .
      433     do
      434       on error undo, return error
      435       :
      436       run prn-lib-get-report-name  in this-procedure (
      437         input parParentProc
      438         ,output v-report-name
      439         ).
      440       if p-is-stream then
      441       do:
      442         if p-append then
      443         do:
      444           output stream PrnLibStream to value( v-report-name )
      445             page-size value(p-page-size) append .
      446         end.
      447         if not p-append then
      448         do:
      449           output stream PrnLibStream to value( v-report-name )
      450             page-size value(p-page-size) .
      451         end.
      452       end.
      453       if not p-is-stream then
      454       do:
      455         if p-append then
      456         do:
      457           output to value( v-report-name )
      458             page-size value(p-page-size) append .
      459         end.
      460         if not p-append then
      461         do:
      462           output to value( v-report-name )
      463             page-size value(p-page-size) .
      464         end.
      465       end.
      466     end.
      467   end procedure.
      468   procedure prn-lib-open-exp :
      469     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      470     define input parameter p-is-stream    as logical no-undo .
      471     define input parameter p-is-append    as logical no-undo .
      472     define output parameter p-ReportFileName as char init "report" no-undo.
      473     define output parameter p-process as logical no-undo .
      474     define variable glog as logical no-undo .
      475     do
      476       on error undo, return error
      477       :
      478       SYSTEM-DIALOG GET-FILE p-ReportFileName
      479         TITLE      "Укажите путь"
      480         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      481         ASK-OVERWRITE
      482         CREATE-TEST-FILE
      483         SAVE-AS
      484         USE-FILENAME
      485         DEFAULT-EXTENSION "txt"
      486         UPDATE glog
      487         .
      488       if not glog then  return.
      489       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      490       if p-is-stream then
      491       do:
      492         if p-is-append then
      493         do:
      494           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      495         end.
      496         else
      497         do:
      498           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      499         end.
      500       end.
      501       else
      502       do:
      503         if p-is-append then
      504         do:
      505           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      506         end.
      507         else
      508         do:
      509           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      510         end.
      511       end.
      512       p-process = yes.
      513     end.
      514   end procedure.
      515   procedure prn-lib-get-report-name :
      516     define input parameter parParentProc  as widget-handle no-undo.
      517     define output parameter p-report-name as character no-undo .
      518     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      519   end procedure.
      520   procedure prn-lib-reportviewer-report-name :
      521     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      522     define input parameter p-report-name-html as character no-undo .
      523     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      524   end procedure.
      525   procedure prn-lib-reportviewer :
      526     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      527     define input parameter p-report-name-html as character no-undo .
      528     define input parameter p-param        as character no-undo .
      529     define variable v-excel           as character no-undo init 'TRUE' .
      530     define variable v-value-character as character no-undo .
      531     define variable v-value-integer   as character no-undo .
      532     define variable v-value-date      as date      no-undo .
      533     define variable v-value-decimal   as decimal   no-undo .
      534     define variable rep-excel         as logical   no-undo .
      535     define variable excel-string      as character no-undo .
      536     define variable v-param-type      as character no-undo .
      537     define variable v-tth             as handle    no-undo .
      538     run adm/shattri.p (
      539       input "get":U
      540       ,input  ""
      541       ,input  0
      542       ,input  'report-glob':U
      543       ,input  'rep-excel':U
      544       ,output v-value-character
      545       ,output v-value-date
      546       ,output v-value-decimal
      547       ,output v-value-integer
      548       ,output rep-excel
      549       ,output v-param-type
      550       ,INPUT-OUTPUT table-handle v-tth
      551       )  .
      552     if rep-excel then v-excel = "TRUE" .
      553     else v-excel = "FALSE" .
      554     if p-param eq ""
      555     then
      556        p-param = "EXCEL:" + v-excel.
      557     else
      558        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      559     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      560   end procedure.
      561   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      562   define variable c-point  as character no-undo .
      563   define variable tbl      as character no-undo .
      564   define variable join-tbl as character no-undo .
      565   define variable fld      as character no-undo .
      566   define variable lab      as character no-undo .
      567   define variable spr      as character no-undo .
      568   define variable dim      as character no-undo .
      569   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   procedure fltfield-clear :
      571     define output parameter loc-fld as character no-undo.
      572     define output parameter loc-lab as character no-undo .
      573     define output parameter loc-spr as character no-undo .
      574     define output parameter loc-dim as character no-undo .
      575     assign
      576       loc-fld = ""
      577       loc-lab = ""
      578       loc-spr = ""
      579       loc-dim = "0"
      580     .
      581   end procedure .
      582   procedure fltfield-add :
      583     define input        parameter par-fld as character no-undo.
      584     define input        parameter par-lab as character no-undo .
      585     define input        parameter par-spr as character no-undo .
      586     define input-output parameter loc-fld as character no-undo.
      587     define input-output parameter loc-lab as character no-undo .
      588     define input-output parameter loc-spr as character no-undo .
      589     define input-output parameter loc-dim as character no-undo .
      590     do
      591     on error undo, return error
      592     :
      593       assign
      594       loc-fld = if loc-dim = '0'
      595                 then par-fld
      596                 else (loc-fld + chr(44) + par-fld)
      597       loc-lab = if loc-dim = '0'
      598                 then par-lab
      599                 else (loc-lab + chr(44) + par-lab)
      600       loc-spr = if loc-dim = '0'
      601                 then par-spr
      602                 else (loc-spr + chr(44) + par-spr)
      603       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      604                 string(integer(if num-entries(loc-dim) > 1
      605                               then entry(2, loc-dim)
      606                               else entry(1, loc-dim)
      607                               ) + 1)
      608       no-error
      609       .
      610     end.
      611   end procedure.
      612   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      613   procedure cur-time :
      614      define output parameter p-today as date      no-undo .
      615      define output parameter p-time  as integer   no-undo .
      616     do
      617     on error undo, return error
      618     :
      619       define variable v-date1 as date      no-undo .
      620       define variable v-date2 as date      no-undo .
      621       define variable v-time  as integer   no-undo .
      622       assign
      623         v-date1 = today
      624         v-time  = time
      625         v-date2 = today
      626       .
      627       if v-date1 <> v-date2
      628       then do:
      629         assign
      630           v-date1 = today
      631           v-time  = v-time
      632         .
      633       end.
      634       assign
      635         p-today = v-date1
      636         p-time  = v-time
      637       .
      638     end.
      639   end.
      640   function cur-time-date returns character
      641   :
      642     return string(today, '99/99/9999':U) .
      643   end.
      644   function cur-time-mjd returns decimal
      645   :
      646     define variable v-date as date      no-undo .
      647     define variable v-time as integer   no-undo .
      648     run cur-time in this-procedure
      649       (output v-date
      650       ,output v-time
      651       ) .
      652     return integer(v-date) - 2400002 + (v-time / 86400) .
      653   end.
      654   function cur-time-get-ending-index returns integer
      655   (input p-number as integer
      656   )
      657   :
      658     if p-number < 0
      659     or p-number = ?
      660     then do:
      661       return 1 .
      662     end.
      663     define variable v-rest as integer   no-undo .
      664     assign
      665       p-number = p-number modulo 100
      666     .
      667     if p-number < 20
      668     then do:
      669       assign
      670         v-rest = p-number
      671       .
      672     end.
      673     else do:
      674       assign
      675         v-rest = p-number modulo 10
      676       .
      677     end.
      678     case v-rest :
      679       when 1
      680       then do:
      681         return 2 .
      682       end.
      683       when 2 or
      684       when 3 or
      685       when 4
      686       then do:
      687         return 3 .
      688       end.
      689       otherwise do:
      690         return 1 .
      691       end.
      692     end case .
      693   end.
      694   procedure cur-time-mjd-to-date :
      695      define input  parameter i-mjd-diff as decimal no-undo.
      696      define output parameter o-Date     as date    no-undo.
      697      define output parameter o-Time     as integer no-undo.
      698      define variable v-day-number as integer   no-undo .
      699      if    i-mjd-diff < 0
      700         or i-mjd-diff = ?
      701      then do:
      702         return "?" .
      703      end.
      704      assign
      705         v-day-number = truncate(i-mjd-diff,0).
      706         o-Date = date(v-day-number + 2400002).
      707         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      708     .
      709   end.
      710   function cur-time-mjd-to-string returns character
      711   (input p-mjd-diff as decimal
      712   )
      713   :
      714     define variable v-day-number as integer   no-undo .
      715     define variable v-seconds    as integer   no-undo .
      716     define variable v-hour       as integer   no-undo .
      717     define variable v-min        as integer   no-undo .
      718     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      719     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      720     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      721     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      722     if p-mjd-diff < 0
      723     or p-mjd-diff = ?
      724     then do:
      725       return "?" .
      726     end.
      727     assign
      728       v-day-number = integer(truncate(p-mjd-diff,0))
      729       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      730     .
      731     if v-seconds > 86400
      732     then do:
      733       assign
      734         v-seconds = 86400 - 1
      735       .
      736     end.
      737     if v-seconds < 0
      738     then do:
      739       assign
      740         v-seconds = 0
      741       .
      742     end.
      743     assign
      744       v-hour = truncate(v-seconds / 3600, 0)
      745     .
      746     assign
      747       v-seconds = v-seconds modulo 3600
      748     .
      749     assign
      750       v-min = truncate(v-seconds / 60, 0)
      751     .
      752     assign
      753       v-seconds = v-seconds modulo 60
      754     .
      755     return
      756         (if v-day-number <> 0
      757           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      758           else ""
      759         )
      760       + (if v-day-number <> 0 or v-hour <> 0
      761           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      762           else ""
      763         )
      764       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      765           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      766           else ""
      767         )
      768       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      769       .
      770   end.
      771   function cur-time-string returns character
      772   :
      773     define variable v-date as date      no-undo .
      774     define variable v-time as integer   no-undo .
      775     run cur-time in this-procedure
      776       (output v-date
      777       ,output v-time
      778       ) .
      779     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      780   end.
      781   function cur-time-string-sec returns character
      782   :
      783     define variable v-date as date      no-undo .
      784     define variable v-time as integer   no-undo .
      785     run cur-time in this-procedure
      786       (output v-date
      787       ,output v-time
      788       ) .
      789     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      790   end.
      791   function cur-time-custom  returns character
      792   (input p-prefix as character
      793   ,input p-date-format as character
      794   ,input p-delimiter as character
      795   ,input p-time-format as character
      796   ,input p-suffix as character
      797   )
      798   :
      799     define variable v-date as date      no-undo .
      800     define variable v-time as integer   no-undo .
      801     run cur-time in this-procedure
      802       (output v-date
      803       ,output v-time
      804       ) .
      805     return
      806       p-prefix
      807       + string(v-date, p-date-format)
      808       + p-delimiter
      809       + string(v-time, p-time-format)
      810       + p-suffix
      811       .
      812   end.
      813   function cur-time-print  returns character
      814   :
      815     define variable v-date as date      no-undo .
      816     define variable v-time as integer   no-undo .
      817     run cur-time in this-procedure
      818       (output v-date
      819       ,output v-time
      820       ) .
      821     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      822   end.
      823   function cur-time-datetime returns datetime
      824   :
      825     define variable v-char as character no-undo .
      826     define variable v-datetime as datetime no-undo .
      827     v-char = cur-time-string().
      828     v-datetime = datetime(v-char).
      829     return  v-datetime.
      830   end.
      831   function cur-time-string-msec returns character
      832   :
      833     define variable v-date as datetime  no-undo .
      834     v-date = now.
      835     return string(v-date) .
      836   end.
