      838   define temp-table userobjs_temp-user-obj no-undo
      839     field obj-type as character
      840     field obj-code as integer
      841     index xpk is primary unique obj-type obj-code
      842     .
      843   procedure userobjs_clear :
      844     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      845     do
      846     on error undo, return error return-value
      847     :
      848       for each buf_userobjs_temp-user-obj
      849       on error undo, return error return-value
      850       :
      851         delete buf_userobjs_temp-user-obj .
      852       end.
      853     end.
      854   end .
      855   procedure userobjs_object-count :
      856     define output parameter p-total-count as integer   no-undo .
