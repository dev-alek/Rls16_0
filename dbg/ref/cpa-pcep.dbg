        1   DEFINE BUFFER locked_cash-pay-attr FOR ub.cash-pay-attr.
        2   DEFINE TEMP-TABLE tt-cash-pay-attr NO-UNDO LIKE ub.cash-pay-attr.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
        5   define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
        6   define INPUT parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
        7   define INPUT parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
        8   define INPUT parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
        9   DEFINE INPUT-OUTPUT PARAMETER p-attr-value AS character NO-UNDO.
       10   DEFINE OUTPUT PARAMETER p-ok AS logical NO-UNDO.
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Задание атрибута ПРЕФЕКСЫ ПЛАТЕЖНОЙ КАРТЫ ДЛЯ ЭКСПОРТА В XML".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define variable v-waitfram-action01         as character   no-undo .
       73   define variable v-waitfram-action02         as character   no-undo .
       74   define variable v-waitfram-action03         as character   no-undo .
       75   define variable mWaitFramTextBeg            as character   no-undo.
       76   define variable mWaitFramTextEnd            as character   no-undo.
       77   define variable mWaitFramView               as logical     no-undo.
       78   define variable mWaitProcEvent              as logical     no-undo init yes.
       79   define variable mWaitFramInterval           as integer     no-undo init 1 .
       80   define variable mWaitFramStop               as logical     no-undo.
       81   define variable mWaitFramStopUser           as logical     no-undo.
       82   define variable mWaitFramStopTimeOut        as logical     no-undo.
       83   define variable mWaitFramStartProc          as datetime-tz no-undo.
       84   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       85   define button B-WaitFramStop auto-end-key
       86        label "Стоп"
       87        size 10 by 1 tooltip "Остоновить процесс".
       88   define button B-viewProcInfo
       89        label "Информация"
       90        size 15 by 1 tooltip "Информация о процесс".
       91   define frame waitfram
       92     v-waitfram-action01 format "x(72)" no-label skip
       93     v-waitfram-action02 format "x(72)" no-label skip
       94     v-waitfram-action03 format "x(72)" no-label skip
       95     B-viewProcInfo
       96     B-WaitFramStop at row 4 col 30
       97     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       98     .
       99   define new global shared variable mBatchMode as logical no-undo init ?.
      100   define variable mFramBachModHandle as handle no-undo.
      101   mFramBachModHandle = frame waitfram:handle.
      102   define variable mFameOldVis as logical no-undo.
      103   define variable mVisCUrentVin as logical no-undo.
      104   if session:batch-mode
      105   then
      106      mBatchMode = yes.
      107   if mBatchMode = ? then do:
      108     mVisCUrentVin = current-window:visible.
      109     mFameOldVis = mFramBachModHandle:visible.
      110     mFramBachModHandle:visible  = yes.
      111     mBatchMode = mFramBachModHandle:visible ne yes.
      112     mFramBachModHandle:visible = mFameOldVis.
      113     current-window:visible = mVisCUrentVin.
      114   end.
      115    if  log-manager:logfile-name ne ?
      116     then DO:
      117         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      118         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      119         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      120     end.
      121   on choose of B-WaitFramStop in frame waitfram
      122   do:
      123     mWaitFramStop = yes.
      124     mWaitFramStopUser = yes.
      125   end.
      126   function waitfram-check-timeout returns logical():
      127      define variable vtime as int64 no-undo.
      128      if mWaitFramStopTimeOut
      129      then
      130         return yes.
      131      vtime = ( now - mWaitFramStartProc ) / 1000 .
      132      if     mWaitFramTimeOut ne ?
      133         and mWaitFramTimeOut ne 0
      134         and mWaitFramTimeOut lt vtime
      135      then do:
      136         mWaitFramStopTimeOut = yes.
      137      end.
      138      return mWaitFramStopTimeOut.
      139   end.
      140   procedure waitfram-hide :
      141     if not session:batch-mode
      142     then do
      143     on error undo, return error return-value
      144     :
      145       pause 0 before-hide .
      146       if not mBatchMode then
      147         hide frame waitfram .
      148     if     not mWaitFramView
      149        and mWaitProcEvent
      150     then
      151       process events .
      152     end.
      153   end procedure.
      154   procedure waitfram-show :
      155     define input  parameter p-message as character no-undo .
      156     define variable v-left-margin as integer   no-undo .
      157     if not session:batch-mode
      158     then do
      159     on error undo, return error return-value
      160     :
      161       if length(p-message) <= 70 then do:
      162         assign
      163           v-left-margin = integer((70 - length(p-message)) / 2)
      164         .
      165         assign
      166           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      167         .
      168         assign
      169           v-waitfram-action01 = " "
      170           v-waitfram-action02 = " "
      171                                    + fill(" ", v-left-margin)
      172                                    + p-message
      173           v-waitfram-action03 = " "
      174         .
      175       end.
      176       else do:
      177         define variable vRindex1 as integer no-undo.
      178         define variable vRindex2 as integer no-undo.
      179         vRindex1 = r-index(p-message," ",70).
      180         if vRindex1 = 0
      181         then
      182            vRindex1 = 70.
      183         if length(p-message)  <= vRindex1 + 70 then do:
      184           assign
      185             v-waitfram-action01 = " "
      186             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      187             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      188           .
      189         end.
      190         else do:
      191           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      192           if vRindex2 <= vRindex1
      193           then
      194              vRindex2 = vRindex1 + 70.
      195           assign
      196             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      197             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      198             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      199           .
      200         end.
      201       end.
      202       B-viewProcInfo:visible   in frame waitfram = no.
      203       B-viewProcInfo:sensitive in frame waitfram = no.
      204       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      205       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      206       if  (   mWaitFramView
      207          or  mWaitProcEvent)
      208          and not mBatchMode
      209       then
      210          display
      211             v-waitfram-action01 skip
      212             v-waitfram-action02 skip
      213             v-waitfram-action03 skip
      214          with frame waitfram .
      215       if     mWaitFramView
      216          then do:
      217             if     mWaitFramInterval ne ?
      218                and not mBatchMode
      219             then
      220                wait-for go of frame waitfram pause mWaitFramInterval.
      221          end.
      222          else
      223             if     mWaitProcEvent
      224                and not mBatchMode
      225             then
      226                process events .
      227     end.
      228   end procedure.
      229      procedure waitfram-show-this:
      230         define input  parameter iInterval as int64 no-undo.
      231         define variable vtime as int64 no-undo.
      232         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      233         mWaitFramInterval = iInterval.
      234         run waitfram-show (substitute("&1&2 &3&4" ,
      235                                       mWaitFramTextBeg ,
      236                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      237                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      238                                       mWaitFramTextEnd
      239                                      )
      240                           ).
      241      end.
      242      procedure WaitFramRunPause:
      243         define input  parameter iInterval as dec no-undo.
      244         define variable vStart  as datetime-tz no-undo.
      245         define variable vend    as datetime-tz no-undo.
      246         define variable vint as int64 no-undo.
      247         define variable vOk as logical no-undo.
      248         vStart = now.
      249         vend   = vStart.
      250         publish "WaitFramPause" (iInterval,output vOk).
      251         vend   =  now.
      252         vint = vend - vStart.
      253         vint = iInterval - vint / 1000.
      254         if     not mWaitFramStop
      255            and (   vint > 0
      256                 or (    not vOk
      257                     and iInterval eq ?
      258                     )
      259                 )
      260         then
      261            run waitfram-show-this (iInterval).
      262         vend   =  now.
      263         vint = vend - vStart.
      264         vint = iInterval - vint / 1000.
      265         if     not mWaitFramStop
      266            and vint > 0
      267         then do:
      268            run gbl/pause.p (vint * 1000).
      269         end.
      270         if iInterval ne ?
      271         then
      272            publish "WaitFramStop".
      273         waitfram-check-timeout().
      274      end.
      275      procedure WaitFramWaitFor:
      276         define input  parameter iInterval as dec no-undo.
      277         assign
      278            mWaitFramStartProc   = now
      279            mWaitFramStopUser    = no
      280            mWaitFramStopTimeOut = no
      281         .
      282         block-wait:
      283         do while not mWaitFramStop:
      284            run WaitFramRunPause (iInterval).
      285            if  waitfram-check-timeout()
      286            then do:
      287               leave block-wait.
      288            end.
      289         end.
      290         run waitfram-hide.
      291      end.
      292   procedure waitfram-join :
      293     define input  parameter p-line-1  as character no-undo .
      294     define input  parameter p-line-2  as character no-undo .
      295     define input  parameter p-line-3  as character no-undo .
      296     define output parameter p-message as character no-undo .
      297     do
      298     on error undo, return error return-value
      299     :
      300       assign
      301         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      302                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      303                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      304       .
      305     end.
      306   end procedure.
      307   function waitfram-join-function returns character
      308     (input p-line-1 as character
      309     ,input p-line-2 as character
      310     ,input p-line-3 as character
      311     ).
      312     define variable v-message as character no-undo .
      313     run waitfram-join in this-procedure
      314       (input  p-line-1
      315       ,input  p-line-2
      316       ,input  p-line-3
      317       ,output v-message
      318       ) .
      319     return v-message .
      320   end function .
      321   define new global shared variable g#language as character no-undo .
      322   if g#language <> '' and g#language <> 'rus':U then do:
      323     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      324   end.
      325   define new global shared variable g#library  as handle no-undo .
      326   define new global shared variable g#library2 as handle no-undo .
      327   define   shared variable g#auto as logical no-undo.
      328   define   shared variable g#news as logical no-undo.
      329   define   shared variable g#oxml as logical no-undo.
      330   define   shared variable g#esys as logical no-undo.
      331   define   shared variable g#news-source-db as integer no-undo.
      332   define   shared variable g#esys-source-esys as integer no-undo.
      333   define   shared variable g#db-num as integer   no-undo .
      334   define   shared variable g#userid as character no-undo .
      335   define   shared variable g#passwd as character no-undo .
      336   procedure proc-alt-shift-f2:
      337     if not ibs.th.gbl.gbl-var:rcode
      338   then
      339     run gbl\inidebug.p .
      340   end.
      341   procedure proc-alt-shift-f3:
      342     run gbl/prvssinf.p
      343       ( input this-procedure
      344       ) .
      345   end.
      346   define variable v-inform-launched as logical no-undo initial false .
      347   procedure proc-alt-shift-f4:
      348     define variable v-action as character no-undo .
      349     if v-inform-launched = false then do:
      350       assign
      351         v-inform-launched = true
      352       .
      353       run gbl/d-inform.w
      354         (  input self
      355         ,  input this-procedure
      356         , output v-action
      357         ) no-error .
      358       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      359       assign
      360         v-inform-launched = false
      361       .
      362     end.
      363   end.
      364   procedure proc-alt-f1:
      365     run gbl/corrhelp.p
      366       (input this-procedure
      367       ) .
      368   end .
      369   on alt-shift-f2 anywhere do:
      370     run proc-alt-shift-f2.
      371   end.
      372   on alt-shift-f3 anywhere do:
      373     run proc-alt-shift-f3 in this-procedure .
      374   end.
      375   on alt-shift-f4 anywhere do:
      376     run proc-alt-shift-f4 in this-procedure.
      377   end.
      378   on alt-f1 anywhere do:
      379     run proc-alt-f1 in this-procedure .
      380   end.
      381   DEFINE TEMP-TABLE tt-prefix NO-UNDO
      382   FIELD prefix AS CHARACTER
      383   INDEX pi IS UNIQUE PRIMARY
      384   prefix.
      385   DEFINE BUTTON B-add  NO-FOCUS
      386        LABEL "&Добавить"
      387        SIZE 10 BY 1.
      388   DEFINE BUTTON B-del
      389        LABEL "&Удалить"
      390        SIZE 10 BY 1.
      391   DEFINE BUTTON B-exit AUTO-GO
      392        LABEL "&Ввод"
      393        SIZE 10 BY 1
      394        BGCOLOR 8 .
      395   DEFINE BUTTON B-Help
      396        LABEL "Помо&щь"
      397        SIZE 10 BY 1
      398        BGCOLOR 8 .
      399   DEFINE BUTTON b-quit AUTO-END-KEY
      400        LABEL "&Отмена"
      401        SIZE 10 BY 1
      402        BGCOLOR 8 .
      403   DEFINE VARIABLE for-obj-name AS CHARACTER FORMAT "X(256)":U
      404         VIEW-AS TEXT
      405        SIZE 37.88 BY 1 NO-UNDO.
      406   DEFINE VARIABLE v-host-name AS CHARACTER FORMAT "X(256)":U
      407         VIEW-AS TEXT
      408        SIZE 51.5 BY 1 NO-UNDO.
      409   DEFINE VARIABLE var-region AS CHARACTER FORMAT "X(256)":U
      410         VIEW-AS TEXT
      411        SIZE 24 BY 1 NO-UNDO.
      412   DEFINE VARIABLE RS-region AS INTEGER
      413        VIEW-AS RADIO-SET HORIZONTAL
      414        RADIO-BUTTONS
      415             "Глобально", 0,
      416   "Фирма", 1,
      417   "Объект", 2
      418        SIZE 63 BY 1 NO-UNDO.
      419   DEFINE RECTANGLE RECT-region
      420        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      421        SIZE 72 BY 6.46.
      422   DEFINE QUERY BR-prefix FOR
      423         tt-prefix SCROLLING.
      424   DEFINE BROWSE BR-prefix
      425     QUERY BR-prefix DISPLAY
      426         tt-prefix.prefix FORMAT "X(19)" COLUMN-LABEL "Префикс"
      427       WITH NO-ROW-MARKERS SEPARATORS SIZE 30 BY 6.67
      428            TITLE "Префиксы платежных карт" ROW-HEIGHT-CHARS .67 EXPANDABLE.
      429   DEFINE FRAME Dialog-Frame
      430        B-add AT ROW 9.25 COL 34
      431        B-exit AT ROW 1 COL 1
      432        b-quit AT ROW 1 COL 11
      433        B-Help AT ROW 1 COL 54.88
      434        RS-region AT ROW 2.75 COL 3 NO-LABEL
      435        BR-prefix AT ROW 9.08 COL 2
      436        B-del AT ROW 9.25 COL 44
      437        var-region AT ROW 4.5 COL 18 COLON-ALIGNED NO-LABEL
      438        v-host-name AT ROW 6 COL 18 COLON-ALIGNED NO-LABEL
      439        for-obj-name AT ROW 7.5 COL 20.5 COLON-ALIGNED NO-LABEL
      440        RECT-region AT ROW 2.5 COL 1.5
      441        SPACE(3.62) SKIP(6.99)
      442       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      443            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      444            TITLE "Префиксы типа кассового платежа для экспорта в XML"
      445            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      446   ASSIGN
      447          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      448          FRAME Dialog-Frame:HIDDEN           = TRUE.
      449   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      450   DO:
      451     APPLY "END-ERROR":U TO SELF.
      452   END.
      453   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      454   DO:
      455     DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
      456     DEFINE VARIABLE v-log AS logical NO-UNDO.
      457     DEFINE variable v-rid AS RECID NO-UNDO.
      458     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      459     define variable v-dopi as decimal no-undo .
      460     DEFINE BUFFER buf_tt-prefix FOR tt-prefix.
      461    run gbl/d-prompt.w (
      462         'title=':u + "Добавить префикс платежной карты" + '\':u
      463       + 'format=' + "X(19)" + '\':u
      464       + 'type=' + 'C':U + '\':u
      465       + 'fillin_row=2\':u
      466       + 'fillin_col=4\':u
      467       + 'fillin_width=19\':u
      468       + 'fillin_height=1\':u
      469       + 'max-chars=5\':u
      470       + 'readonly=no\':u
      471       , input-output v-value
      472       ).
      473       if return-value = 'false':u then return NO-apply.
      474   assign
      475   v-dopi = decimal(v-value) no-error .
      476   if error-status:error or
      477   v-dopi < 0 or
      478   v-dopi <> round(v-dopi, 0) or
      479   index(v-value, chr(44)) > 0 then do:
      480     message
      481     "Вы должны ввесте целое положительное число длиной до 19 знаков"
      482     view-as alert-box error .
      483     return no-apply.
      484   end.
      485   FIND FIRST buf_tt-prefix NO-LOCK WHERE
      486             buf_tt-prefix.prefix = v-value NO-ERROR.
      487   IF AVAILABLE buf_tt-prefix THEN DO:
      488        MESSAGE
      489           substitute("Вы уже задали префикс &1",  v-value)
      490           VIEW-AS ALERT-BOX.
      491           RETURN NO-APPLY.
      492   END.
      493   CREATE tt-prefix.
      494   ASSIGN
      495   tt-prefix.prefix = v-value
      496   v-rid = RECID(tt-prefix)
      497   .
      498   open query br-prefix for each tt-prefix.
      499   REPOSITION br-prefix TO RECID v-rid.
      500   END.
      501   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      502   DO:
      503     IF NOT AVAILABLE tt-prefix THEN RETURN NO-APPLY.
      504     DELETE tt-prefix.
      505     open query br-prefix for each tt-prefix.
      506     REPOSITION br-prefix TO ROW 1.
      507   END.
      508   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      509   DO:
      510     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      511     IF ERROR-STATUS:ERROR THEN DO:
      512         RETURN NO-APPLY.
      513     END.
      514   END.
      515   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      516   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      517   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      518   on help of frame Dialog-Frame
      519   do:
      520     run gbl/app_help.p
      521       (input this-procedure :file-name
      522       ,input ''
      523       ,input ?
      524       ) no-error.
      525     if error-status :error then do:
      526       message
      527         "Ошибка при вызове помощи"
      528         error-status :get-message(1)
      529         view-as alert-box .
      530     end.
      531   end.
      532   run minbtn-set in this-procedure .
      533   on choose of b-help in frame Dialog-Frame
      534   do:
      535     apply "help":u to frame Dialog-Frame .
      536   end.
      537   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      538   procedure minbtn-set :
      539       do
      540           on error undo, return error return-value
      541           :
      542           define variable ii              as integer       no-undo .
      543           define variable fh              as widget-handle no-undo .
      544           define variable hh              as widget-handle no-undo .
      545           define variable v-h             as handle        extent 4 no-undo .
      546           define variable v-name-button   as character     no-undo .
      547           define variable v-help-old-x    as decimal       no-undo .
      548           define variable v-help-old-y    as decimal       no-undo .
      549           define variable v-help-old-size as decimal       no-undo .
      550           define variable v-frame-width   as decimal       no-undo .
      551           define variable jj              as integer       no-undo .
      552           do
      553               on error undo, return error
      554               :
      555               assign
      556                   v-frame-width = frame Dialog-Frame:width - 0.3
      557                   fh            = frame Dialog-Frame:first-child
      558                   hh            = fh:first-child
      559                   ii            = 1
      560                   .
      561               do while valid-handle(hh):
      562                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      563                   do:
      564                       case lc(hh:name) :
      565                           when "b-help" then
      566                               do:
      567                                   hh:load-image-up("cmp/b-help.bmp":u) .
      568                                   hh:load-image-down("cmp/b-help.bmp":u) .
      569                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      570                                   hh:TOOLTIP = "Помощь" .
      571                                   v-help-old-x = hh:column .
      572                                   v-help-old-y = hh:row    .
      573                                   v-help-old-size = hh:width .
      574                                   hh:width-chars = 2.5 .
      575                               end.
      576                           when "b-print" then
      577                               do:
      578                                   hh:load-image("cmp/b-print.bmp":u) .
      579                                   hh:TOOLTIP = "Печать" .
      580                                   v-h[ii] = hh:handle .
      581                                   ii = ii + 1 .
      582                                   hh:width-chars = 3 .
      583                               end.
      584                           when "b-history" or
      585                           when "b-hist" then
      586                               do:
      587                                   hh:load-image("cmp/b-hist.bmp":u) .
      588                                   hh:TOOLTIP = "История" .
      589                                   v-h[ii] = hh:handle .
      590                                   ii = ii + 1 .
      591                                   hh:width-chars = 3 .
      592                               end.
      593                           when "b-sch" then
      594                               do:
      595                                   hh:load-image("cmp/b-sch.bmp":u) .
      596                                   hh:TOOLTIP = "Установка Фильтра" .
      597                                   v-h[ii] = hh:handle .
      598                                   ii = ii + 1 .
      599                                   hh:width-chars = 3 .
      600                               end.
      601                           when "b-hist-user" then
      602                               do:
      603                                   hh:load-image("cmp/b-hist.bmp":u) .
      604                                   hh:TOOLTIP = "История пользователя" .
      605                                   ii = ii + 1 .
      606                               end.
      607                       end case.
      608                   end.
      609                   hh = hh:next-sibling.
      610               end.
      611               b-help:column = v-frame-width - b-help:width-chars.
      612               jj = 0.
      613               repeat ii = 4 to 1 by -1 :
      614                   if valid-handle (v-h[ii] ) then
      615                   do:
      616                       jj  = jj + 1 .
      617                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      618                       v-h[ii]:row    = v-help-old-y .
      619                   end.
      620               end.
      621           end.
      622       end.
      623   end procedure.
      624   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      625   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      626   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      627   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      628   define variable v-diasize-current-frame-width  as decimal   no-undo .
      629   define variable v-diasize-current-frame-height as decimal   no-undo .
      630   define variable v-diasize-change-size          as logical   no-undo .
      631   define variable v-diasize-resize-button        as handle    no-undo .
      632   define variable v-diasize-wndmax               as logical   no-undo .
      633   define variable v-diasize-wndstore             as logical   no-undo .
      634   define variable v-diasize-proc-name            as character no-undo .
      635   define variable v-diasize-browse-handle        as handle    no-undo .
      636   define variable v-diasize-browse-number        as integer   no-undo .
      637   define variable v-diasize-need-full-display    as logical   no-undo init false .
      638   define temp-table temp-diasize-handle no-undo
      639     field handle-value  as handle
      640     field save-position as decimal
      641     index xpk is primary unique handle-value
      642     .
      643   define temp-table temp-browse-handle no-undo
      644     field browse-type   as character
      645     field browse-number as integer
      646     field browse-handle as handle
      647     field original-size as decimal
      648     index xpk is primary unique browse-type browse-number
      649     index xie browse-type browse-handle
      650   .
      651   procedure diasize_change-height :
      652     define input  parameter p-change-value  as decimal   no-undo .
      653     define input  parameter p-move-resize   as logical   no-undo .
      654     define variable v-field-group-handle    as handle    no-undo .
      655     define variable v-object-handle         as handle    no-undo .
      656     define variable v-frame-height          as decimal   no-undo .
      657     define variable v-frame-virtual-height  as decimal   no-undo .
      658     define variable v-browse-height         as decimal   no-undo .
      659     define variable v-window-height         as decimal   no-undo .
      660     define variable v-window-virtual-height as decimal   no-undo .
      661     define variable v-change-sign           as integer   no-undo .
      662     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      663     define buffer buf_temp-browse-handle  for temp-browse-handle .
      664     if p-change-value > 0
      665     then do:
      666       if frame Dialog-Frame :height + p-change-value
      667           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      668       then do:
      669         assign
      670           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      671                           - (frame Dialog-Frame :height-chars)
      672         .
      673         if p-change-value <= 0
      674         then do:
      675           run diasize_position-resize-button in this-procedure .
      676           return .
      677         end.
      678       end.
      679     end.
      680     if p-change-value < 0
      681     then do:
      682       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      683       then do:
      684         assign
      685           p-change-value = v-diasize-orig-frame-height
      686                          - (frame Dialog-Frame :height-chars)
      687         .
      688         if p-change-value >= 0
      689         then do:
      690           run diasize_position-resize-button in this-procedure .
      691           return .
      692         end.
      693       end.
      694     end.
      695     if p-change-value >= 0
      696     then do:
      697       assign
      698         v-change-sign = 1
      699       .
      700     end.
      701     else do:
      702       assign
      703         v-change-sign = -1
      704       .
      705     end.
      706     assign
      707       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      708     .
      709     if p-change-value = 0
      710     then do:
      711       run diasize_position-resize-button in this-procedure .
      712       return .
      713     end.
      714     move_block:
      715     do
      716     on error undo move_block, retry move_block
      717     :
      718       if retry
      719       then do:
      720         do
      721         on error undo move_block, leave move_block
      722         :
      723           if p-change-value > 0
      724           then do:
      725             for each buf_temp-diasize-handle
      726             on error undo, next
      727             :
      728               assign
      729                 v-object-handle = buf_temp-diasize-handle.handle-value
      730               .
      731               if v-object-handle <> v-diasize-resize-button
      732               then do:
      733                 assign
      734                   v-object-handle :row = buf_temp-diasize-handle.save-position
      735                 .
      736               end.
      737             end.
      738             assign
      739               v-diasize-browse-handle :height = v-browse-height
      740             .
      741             for each buf_temp-browse-handle
      742               where buf_temp-browse-handle.browse-type = 'height':u
      743             on error undo, next
      744             :
      745               assign
      746                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      747               .
      748             end.
      749             assign
      750               frame Dialog-Frame :height = v-frame-height
      751             .
      752             if frame Dialog-Frame :scrollable = true
      753             then do:
      754               assign
      755                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      756               .
      757             end.
      758             run diasize_position-resize-button in this-procedure .
      759           end.
      760           else do:
      761             if frame Dialog-Frame :scrollable = true
      762             then do:
      763               assign
      764                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      765               .
      766             end.
      767             assign
      768               frame Dialog-Frame :height = v-frame-height
      769             .
      770             assign
      771               v-diasize-browse-handle :height = v-browse-height
      772             .
      773             for each buf_temp-browse-handle
      774               where buf_temp-browse-handle.browse-type = 'height':u
      775             on error undo, next
      776             :
      777               assign
      778                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      779               .
      780             end.
      781             for each buf_temp-diasize-handle
      782             on error undo, next
      783             :
      784               assign
      785                 v-object-handle = buf_temp-diasize-handle.handle-value
      786               .
      787               if v-object-handle <> v-diasize-resize-button
      788               then do:
      789                 assign
      790                   v-object-handle :row = buf_temp-diasize-handle.save-position
      791                 .
      792               end.
      793             end.
      794             run diasize_position-resize-button in this-procedure .
      795           end.
      796           assign
      797             v-diasize-change-size = false
      798           .
      799           leave move_block .
      800         end.
      801       end.
      802       assign
      803         v-diasize-need-full-display = true
      804       .
      805       if v-diasize-change-size = false
      806       then do:
      807         assign
      808           v-diasize-change-size = true
      809         .
      810       end.
      811       else do:
      812         return .
      813       end.
      814       assign
      815         v-frame-height = frame Dialog-Frame :height
      816         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      817         v-browse-height = v-diasize-browse-handle :height
      818       .
      819       for each buf_temp-browse-handle
      820         where buf_temp-browse-handle.browse-type = 'height':u
      821       :
      822         assign
      823           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      824         .
      825       end.
      826       for each buf_temp-diasize-handle
      827       :
      828         delete buf_temp-diasize-handle .
      829       end.
      830       assign
      831         v-field-group-handle = frame Dialog-Frame :first-child
      832       .
      833       do while valid-handle(v-field-group-handle)
      834       :
      835         assign
      836           v-object-handle = v-field-group-handle :first-child
      837         .
      838         do while valid-handle(v-object-handle)
      839         :
      840           if  v-object-handle <> v-diasize-browse-handle :handle
      841           and can-query(v-object-handle, "row")
      842           and can-query(v-object-handle, "height")
      843           and ( v-object-handle :row > v-diasize-browse-handle :row )
      844           then do:
      845             find first buf_temp-browse-handle
      846               where buf_temp-browse-handle.browse-type   = 'height':u
      847                 and buf_temp-browse-handle.browse-handle = v-object-handle
      848               no-error .
      849             if available buf_temp-browse-handle
      850             then do:
      851             end.
      852             else do:
      853               create buf_temp-diasize-handle .
      854               assign
      855                 buf_temp-diasize-handle.handle-value  = v-object-handle
      856                 buf_temp-diasize-handle.save-position = v-object-handle :row
      857               .
      858             end.
      859           end.
      860           assign
      861             v-object-handle = v-object-handle :next-sibling
      862           .
      863         end.
      864         assign
      865           v-field-group-handle = v-field-group-handle :next-sibling
      866         .
      867       end.
      868       do with frame Dialog-Frame
      869       :
      870         hide v-diasize-resize-button .
      871         assign
      872           v-diasize-resize-button :row    = 1
      873           v-diasize-resize-button :column = 1
      874         .
      875       end.
      876       if p-change-value > 0
      877       then do:
      878         if frame Dialog-Frame :scrollable = true
      879         then do:
      880           assign
      881             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      882             no-error .
      883           if error-status :error
      884           or error-status :get-message(1) <> ""
      885           then do:
      886             undo move_block, retry move_block .
      887           end.
      888         end.
      889         assign
      890           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      891           no-error .
      892         if error-status :error
      893         or error-status :get-message(1) <> ""
      894         then do:
      895           undo move_block, retry move_block .
      896         end.
      897         assign
      898           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      899           no-error .
      900         if error-status :error
      901         or error-status :get-message(1) <> ""
      902         then do:
      903           undo move_block, retry move_block .
      904         end.
      905         for each buf_temp-browse-handle
      906           where buf_temp-browse-handle.browse-type = 'height':u
      907         on error undo move_block, retry move_block
      908         :
      909           assign
      910             buf_temp-browse-handle.browse-handle :height
      911               = buf_temp-browse-handle.browse-handle :height + p-change-value
      912             no-error .
      913           if error-status :error
      914           or error-status :get-message(1) <> ""
      915           then do:
      916             undo move_block, retry move_block .
      917           end.
      918         end.
      919         for each buf_temp-diasize-handle
      920         on error undo move_block, retry move_block
      921         :
      922           assign
      923             v-object-handle = buf_temp-diasize-handle.handle-value
      924           .
      925           if v-object-handle <> v-diasize-resize-button
      926           then do:
      927             assign
      928               v-object-handle :row = v-object-handle :row + p-change-value
      929               no-error .
      930             if error-status :error
      931             or error-status :get-message(1) <> ""
      932             then do:
      933               undo move_block, retry move_block .
      934             end.
      935           end.
      936         end.
      937       end.
      938       else do:
      939         for each buf_temp-diasize-handle
      940         on error undo move_block, retry move_block
      941         :
      942           assign
      943             v-object-handle = buf_temp-diasize-handle.handle-value
      944           .
      945           if v-object-handle <> v-diasize-resize-button
      946           then do:
      947             assign
      948               v-object-handle :row = v-object-handle :row + p-change-value
      949               no-error .
      950             if error-status :error
      951             or error-status :get-message(1) <> ""
      952             then do:
      953               undo move_block, retry move_block .
      954             end.
      955           end.
      956         end.
      957         assign
      958           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      959           no-error .
      960         if error-status :error
      961         or error-status :get-message(1) <> ""
      962         then do:
      963           undo move_block, retry move_block .
      964         end.
      965         for each buf_temp-browse-handle
      966           where buf_temp-browse-handle.browse-type = 'height':u
      967         on error undo move_block, retry move_block
      968         :
      969           assign
      970             buf_temp-browse-handle.browse-handle :height
      971               = buf_temp-browse-handle.browse-handle :height + p-change-value
      972             no-error .
      973           if error-status :error
      974           or error-status :get-message(1) <> ""
      975           then do:
      976             undo move_block, retry move_block .
      977           end.
      978         end.
      979         assign
      980           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      981           no-error .
      982         if error-status :error
      983         or error-status :get-message(1) <> ""
      984         then do:
      985           undo move_block, retry move_block .
      986         end.
      987         if frame Dialog-Frame :scrollable = true
      988         then do:
      989           assign
      990             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      991             no-error .
      992           if error-status :error
      993           or error-status :get-message(1) <> ""
      994           then do:
      995             undo move_block, retry move_block .
      996           end.
      997         end.
      998       end.
      999       if p-move-resize = true
     1000       then do:
     1001         run diasize_position-resize-button in this-procedure .
     1002       end.
     1003       if v-diasize-wndstore = true
     1004       then do:
     1005         if connected("ub") = true
     1006         then do:
     1007           define variable v-cntxt-db-num        as integer   no-undo .
     1008           define variable v-cntxt-userid        as character no-undo .
     1009           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1010                                             , OUTPUT v-cntxt-userid
     1011                                             ) .
     1012           run gbl/wndsizew.p
     1013             (input  v-cntxt-db-num
     1014             ,input  v-cntxt-userid
     1015             ,input  v-diasize-proc-name
     1016             ,input  'height':u
     1017             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1018             ) .
     1019         end.
     1020       end.
     1021     end.
     1022     assign
     1023       v-diasize-change-size = false
     1024     .
     1025   end procedure.
     1026   procedure diasize_set-height :
     1027     define input  parameter p-new-height  as decimal   no-undo .
     1028     define input  parameter p-move-resize as logical   no-undo .
     1029     do
     1030     on error undo, return error return-value
     1031     :
     1032       run diasize_change-height in this-procedure
     1033         (input  (p-new-height - frame Dialog-Frame :height)
     1034         ,input  p-move-resize
     1035         ) .
     1036     end.
     1037   end procedure.
     1038   procedure diasize_change-width :
     1039     define input  parameter p-change-value as decimal   no-undo .
     1040     define input  parameter p-move-resize  as logical   no-undo .
     1041     define variable v-field-group-handle   as handle    no-undo .
     1042     define variable v-object-handle        as handle    no-undo .
     1043     define variable v-frame-width          as decimal   no-undo .
     1044     define variable v-frame-virtual-width  as decimal   no-undo .
     1045     define variable v-browse-width         as decimal   no-undo .
     1046     define variable v-window-width         as decimal   no-undo .
     1047     define variable v-window-virtual-width as decimal   no-undo .
     1048     define variable v-change-sign          as integer   no-undo .
     1049     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1050     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1051     if p-change-value > 0
     1052     then do:
     1053       if frame Dialog-Frame :width + p-change-value >
     1054           session :width-chars
     1055       then do:
     1056         assign
     1057           p-change-value = session :width-chars - frame Dialog-Frame :width
     1058         .
     1059         if p-change-value <= 0
     1060         then do:
     1061           run diasize_position-resize-button in this-procedure .
     1062           return .
     1063         end.
     1064       end.
     1065     end.
     1066     if p-change-value < 0
     1067     then do:
     1068       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1069       then do:
     1070         assign
     1071           p-change-value = v-diasize-orig-frame-width
     1072                          - frame Dialog-Frame :width
     1073         .
     1074         if p-change-value >= 0
     1075         then do:
     1076           run diasize_position-resize-button in this-procedure .
     1077           return .
     1078         end.
     1079       end.
     1080     end.
     1081     if p-change-value >= 0
     1082     then do:
     1083       assign
     1084         v-change-sign = 1
     1085       .
     1086     end.
     1087     else do:
     1088       assign
     1089         v-change-sign = -1
     1090       .
     1091     end.
     1092     assign
     1093       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1094     .
     1095     if p-change-value = 0
     1096     then do:
     1097       run diasize_position-resize-button in this-procedure .
     1098       return .
     1099     end.
     1100     move_block:
     1101     do
     1102     on error undo move_block, leave move_block
     1103     :
     1104       if retry
     1105       then do:
     1106         do
     1107         on error undo move_block, leave move_block
     1108         :
     1109           if p-change-value > 0
     1110           then do:
     1111             for each buf_temp-diasize-handle
     1112             on error undo, next
     1113             :
     1114               assign
     1115                 v-object-handle = buf_temp-diasize-handle.handle-value
     1116               .
     1117               if v-object-handle <> v-diasize-resize-button
     1118               then do:
     1119                 assign
     1120                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1121                 .
     1122               end.
     1123             end.
     1124             assign
     1125               v-diasize-browse-handle :width = v-browse-width
     1126             .
     1127             for each buf_temp-browse-handle
     1128               where buf_temp-browse-handle.browse-type = 'width':u
     1129             on error undo, next
     1130             :
     1131               assign
     1132                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1133               .
     1134             end.
     1135             assign
     1136               frame Dialog-Frame :width = v-frame-width
     1137             .
     1138             if frame Dialog-Frame :scrollable = true
     1139             then do:
     1140               assign
     1141                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1142               .
     1143             end.
     1144             run diasize_position-resize-button in this-procedure .
     1145           end.
     1146           else do:
     1147             if frame Dialog-Frame :scrollable = true
     1148             then do:
     1149               assign
     1150                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1151               .
     1152             end.
     1153             assign
     1154               frame Dialog-Frame :width = v-frame-width
     1155             .
     1156             for each buf_temp-browse-handle
     1157               where buf_temp-browse-handle.browse-type = 'width':u
     1158             on error undo, next
     1159             :
     1160               assign
     1161                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1162               .
     1163             end.
     1164             assign
     1165               v-diasize-browse-handle :width = v-browse-width
     1166             .
     1167             for each buf_temp-diasize-handle
     1168             on error undo, next
     1169             :
     1170               assign
     1171                 v-object-handle = buf_temp-diasize-handle.handle-value
     1172               .
     1173               if v-object-handle <> v-diasize-resize-button
     1174               then do:
     1175                 assign
     1176                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1177                 .
     1178               end.
     1179             end.
     1180             run diasize_position-resize-button in this-procedure .
     1181           end.
     1182           assign
     1183             v-diasize-change-size = false
     1184           .
     1185           leave move_block .
     1186         end.
     1187       end.
     1188       assign
     1189         v-diasize-need-full-display = true
     1190       .
     1191       if v-diasize-change-size = false
     1192       then do:
     1193         assign
     1194           v-diasize-change-size = true
     1195         .
     1196       end.
     1197       else do:
     1198         return .
     1199       end.
     1200       assign
     1201         v-frame-width = frame Dialog-Frame :width
     1202         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1203         v-browse-width = v-diasize-browse-handle :width
     1204       .
     1205       for each buf_temp-browse-handle
     1206         where buf_temp-browse-handle.browse-type = 'width':u
     1207       :
     1208         assign
     1209           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1210         .
     1211       end.
     1212       for each buf_temp-diasize-handle
     1213       :
     1214         delete buf_temp-diasize-handle .
     1215       end.
     1216       assign
     1217         v-field-group-handle = frame Dialog-Frame :first-child
     1218       .
     1219       do while valid-handle(v-field-group-handle)
     1220       :
     1221         assign
     1222           v-object-handle = v-field-group-handle :first-child
     1223         .
     1224         do while valid-handle(v-object-handle)
     1225         :
     1226           if  v-object-handle <> v-diasize-browse-handle :handle
     1227           and v-object-handle <> v-diasize-resize-button
     1228           and can-query(v-object-handle, "row")
     1229           and can-query(v-object-handle, "height")
     1230           and ( v-object-handle :col + v-object-handle :width
     1231                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1232               )
     1233           then do:
     1234             find first buf_temp-browse-handle
     1235               where buf_temp-browse-handle.browse-type   = 'width':u
     1236                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1237               no-error .
     1238             if available buf_temp-browse-handle
     1239             then do:
     1240             end.
     1241             else do:
     1242               create buf_temp-diasize-handle .
     1243               assign
     1244                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1245                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1246               .
     1247             end.
     1248           end.
     1249           assign
     1250             v-object-handle = v-object-handle :next-sibling
     1251           .
     1252         end.
     1253         assign
     1254           v-field-group-handle = v-field-group-handle :next-sibling
     1255         .
     1256       end.
     1257       do with frame Dialog-Frame
     1258       :
     1259         hide v-diasize-resize-button .
     1260         v-diasize-resize-button :row = 1.
     1261         v-diasize-resize-button :column = 1.
     1262       end.
     1263       if p-change-value > 0
     1264       then do:
     1265         if frame Dialog-Frame :scrollable = true
     1266         then do:
     1267           assign
     1268             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1269             no-error .
     1270           if error-status :error
     1271           or error-status :get-message(1) <> ""
     1272           then do:
     1273             undo move_block, retry move_block.
     1274           end.
     1275         end.
     1276         assign
     1277           frame Dialog-Frame :width = v-frame-width + p-change-value
     1278           no-error .
     1279         if error-status :error
     1280         or error-status :get-message(1) <> ""
     1281         then do:
     1282           undo move_block, retry move_block.
     1283         end.
     1284         assign
     1285           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1286         no-error .
     1287         if error-status :error
     1288         or error-status :get-message(1) <> ""
     1289         then do:
     1290           undo move_block, retry move_block.
     1291         end.
     1292         for each buf_temp-browse-handle
     1293           where buf_temp-browse-handle.browse-type = 'width':u
     1294         on error undo move_block, retry move_block
     1295         :
     1296           assign
     1297             buf_temp-browse-handle.browse-handle :width
     1298               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1299             no-error .
     1300           if error-status :error
     1301           or error-status :get-message(1) <> ""
     1302           then do:
     1303             undo move_block, retry move_block .
     1304           end.
     1305         end.
     1306         for each buf_temp-diasize-handle
     1307         on error undo move_block, retry move_block
     1308         :
     1309           assign
     1310             v-object-handle = buf_temp-diasize-handle.handle-value
     1311           .
     1312           if v-object-handle <> v-diasize-resize-button
     1313           then do:
     1314             assign
     1315               v-object-handle :col = v-object-handle :col + p-change-value
     1316               no-error .
     1317             if error-status :error
     1318             or error-status :get-message(1) <> ""
     1319             then do:
     1320               undo move_block, retry move_block .
     1321             end.
     1322           end.
     1323         end.
     1324       end.
     1325       else do:
     1326         for each buf_temp-diasize-handle
     1327         on error undo move_block, retry move_block
     1328         :
     1329           assign
     1330             v-object-handle = buf_temp-diasize-handle.handle-value
     1331           .
     1332           if v-object-handle <> v-diasize-resize-button
     1333           then do:
     1334             assign
     1335               v-object-handle :col = v-object-handle :col + p-change-value
     1336               no-error .
     1337             if error-status :error
     1338             or error-status :get-message(1) <> ""
     1339             then do:
     1340               undo move_block, retry move_block .
     1341             end.
     1342           end.
     1343         end.
     1344         for each buf_temp-browse-handle
     1345           where buf_temp-browse-handle.browse-type = 'width':u
     1346         on error undo move_block, retry move_block
     1347         :
     1348           assign
     1349             buf_temp-browse-handle.browse-handle :width
     1350               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1351             no-error .
     1352           if error-status :error
     1353           or error-status :get-message(1) <> ""
     1354           then do:
     1355             undo move_block, retry move_block .
     1356           end.
     1357         end.
     1358         assign
     1359           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1360           no-error .
     1361         if error-status :error
     1362         or error-status :get-message(1) <> ""
     1363         then do:
     1364           undo move_block, retry move_block.
     1365         end.
     1366         assign
     1367           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1368         no-error .
     1369         if error-status :error
     1370         or error-status :get-message(1) <> ""
     1371         then do:
     1372           undo move_block, retry move_block.
     1373         end.
     1374         if frame Dialog-Frame :scrollable = true
     1375         then do:
     1376           assign
     1377             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1378           no-error .
     1379           if error-status :error
     1380           or error-status :get-message(1) <> ""
     1381           then do:
     1382             undo move_block, retry move_block.
     1383           end.
     1384         end.
     1385       end.
     1386       if p-move-resize
     1387       then do:
     1388         run diasize_position-resize-button in this-procedure .
     1389       end.
     1390       if v-diasize-wndstore = true
     1391       then do:
     1392         if connected("ub") = true
     1393         then do:
     1394           define variable v-cntxt-db-num        as integer   no-undo .
     1395           define variable v-cntxt-userid        as character no-undo .
     1396           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1397                                             , OUTPUT v-cntxt-userid
     1398                                             ) .
     1399           run gbl/wndsizew.p
     1400             (input  v-cntxt-db-num
     1401             ,input  v-cntxt-userid
     1402             ,input  v-diasize-proc-name
     1403             ,input  'width':u
     1404             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1405             ) .
     1406         end.
     1407       end.
     1408     end.
     1409     assign
     1410       v-diasize-change-size = false
     1411     .
     1412   end procedure.
     1413   procedure diasize_set-width :
     1414     define input  parameter p-new-width  as decimal   no-undo .
     1415     define input  parameter p-move-resize as logical   no-undo .
     1416     do
     1417     on error undo, return error return-value
     1418     :
     1419       run diasize_change-width in this-procedure
     1420         (input  (p-new-width - frame Dialog-Frame :width)
     1421         ,input  p-move-resize
     1422         ) .
     1423     end.
     1424   end procedure.
     1425   procedure diasize_position-resize-button :
     1426     do with frame Dialog-Frame
     1427     :
     1428       hide v-diasize-resize-button .
     1429       assign
     1430         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1431                     - 1
     1432                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1433         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1434                     - 1
     1435                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1436       .
     1437       view v-diasize-resize-button .
     1438     end.
     1439   end procedure.
     1440   on alt-right anywhere
     1441   do:
     1442     run diasize_change-width in this-procedure
     1443       (input 1
     1444       ,input true
     1445       ) .
     1446     return no-apply .
     1447   end.
     1448   on alt-left anywhere
     1449   do:
     1450     run diasize_change-width in this-procedure
     1451       (input -1
     1452       ,input true
     1453       ) .
     1454     return no-apply .
     1455   end.
     1456   on alt-down anywhere
     1457   do:
     1458     run diasize_change-height in this-procedure
     1459       (input 1
     1460       ,input true
     1461       ) .
     1462     return no-apply .
     1463   end.
     1464   on alt-up anywhere
     1465   do:
     1466     run diasize_change-height in this-procedure
     1467       (input -1
     1468       ,input true
     1469       ) .
     1470     return no-apply .
     1471   end.
     1472   on alt-enter of frame Dialog-Frame
     1473   do:
     1474     run diasize_maximize in this-procedure
     1475       (input  ?
     1476       ).
     1477     return no-apply .
     1478   end.
     1479   procedure diasize_end-move :
     1480     do
     1481     on error undo, return error return-value
     1482     :
     1483       define variable v-row-delta as decimal   no-undo .
     1484       define variable v-col-delta as decimal   no-undo .
     1485       define variable v-new-row as decimal   no-undo .
     1486       define variable v-new-col as decimal   no-undo .
     1487       assign
     1488         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1489         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1490       .
     1491       assign
     1492         v-row-delta = v-new-row - frame Dialog-Frame :height
     1493         v-col-delta = v-new-col - frame Dialog-Frame :width
     1494       .
     1495       run diasize_change-height in this-procedure
     1496         (input v-row-delta
     1497         ,input true
     1498         ) .
     1499       run diasize_change-width in this-procedure
     1500         (input v-col-delta
     1501         ,input true
     1502         ) .
     1503     end.
     1504   end procedure.
     1505   procedure diasize_maximize :
     1506     define input  parameter p-action as logical   no-undo .
     1507     do
     1508     on error undo, return error return-value
     1509     :
     1510       if p-action = ?
     1511       then do:
     1512         if v-diasize-need-maximize = true
     1513         then do:
     1514           assign
     1515             p-action = true
     1516           .
     1517         end.
     1518         else do:
     1519           assign
     1520             p-action = false
     1521           .
     1522         end.
     1523       end.
     1524       if p-action = true
     1525       then do:
     1526         run diasize_change-height in this-procedure
     1527           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1528               - frame Dialog-Frame :height-chars
     1529           ,input true
     1530           ) .
     1531         run diasize_change-width in this-procedure
     1532           (input session :width-chars
     1533               - frame Dialog-Frame :width-chars
     1534           ,input true
     1535           ) .
     1536         assign
     1537           v-diasize-need-maximize = false
     1538         .
     1539       end.
     1540       else do:
     1541         run diasize_change-width in this-procedure
     1542           (input v-diasize-orig-frame-width
     1543               - frame Dialog-Frame :width-chars
     1544           ,input true
     1545           ) .
     1546         run diasize_change-height in this-procedure
     1547           (input v-diasize-orig-frame-height
     1548               - frame Dialog-Frame :height-chars
     1549           ,input true
     1550           ) .
     1551         assign
     1552           v-diasize-need-maximize = true
     1553         .
     1554       end.
     1555     end.
     1556   end procedure.
     1557   procedure diasize_restore-orig-size :
     1558     do
     1559     on error undo, return error return-value
     1560     :
     1561       assign
     1562         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1563         v-diasize-current-frame-height = frame Dialog-Frame :height
     1564       .
     1565       run diasize_set-height in this-procedure
     1566         (input  v-diasize-orig-frame-height
     1567         ,input  true
     1568         ) .
     1569       run diasize_set-width in this-procedure
     1570         (input  v-diasize-orig-frame-width
     1571         ,input  true
     1572         ) .
     1573     end.
     1574   end procedure.
     1575   procedure diasize_restore-current-size :
     1576     do
     1577     on error undo, return error return-value
     1578     :
     1579       run diasize_set-height in this-procedure
     1580         (input  v-diasize-current-frame-height
     1581         ,input  true
     1582         ) .
     1583       run diasize_set-width in this-procedure
     1584         (input  v-diasize-current-frame-width
     1585         ,input  true
     1586         ) .
     1587     end.
     1588   end procedure.
     1589   procedure diasize_set-browse-handle :
     1590     define input  parameter p-browse-handle as handle   no-undo .
     1591     define buffer buf_temp-browse-handle for temp-browse-handle .
     1592     do
     1593     on error undo, return error return-value
     1594     :
     1595       assign
     1596         v-diasize-browse-handle = p-browse-handle
     1597       .
     1598       for each buf_temp-browse-handle
     1599       on error undo, return error return-value
     1600       :
     1601         delete buf_temp-browse-handle .
     1602       end.
     1603     end.
     1604   end procedure.
     1605   procedure diasize_add_browse :
     1606     define input  parameter p-browse-type   as character no-undo .
     1607     define input  parameter p-browse-handle as handle    no-undo .
     1608     define buffer buf_temp-browse-handle for temp-browse-handle .
     1609     do
     1610     on error undo, return error return-value
     1611     :
     1612       assign
     1613         v-diasize-browse-number = v-diasize-browse-number + 1
     1614       .
     1615       create buf_temp-browse-handle .
     1616       assign
     1617         buf_temp-browse-handle.browse-type   = p-browse-type
     1618         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1619         buf_temp-browse-handle.browse-handle = p-browse-handle
     1620       .
     1621     end.
     1622   end procedure.
     1623   procedure diasize_init :
     1624     define variable v-default-value    as logical   no-undo .
     1625     define variable v-restore-saved    as logical   no-undo .
     1626     define variable v-resize-value-str as character no-undo .
     1627     do
     1628     on error undo, return error return-value
     1629     :
     1630       do with frame Dialog-Frame
     1631       :
     1632         assign
     1633           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1634           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1635           v-diasize-browse-handle     = browse BR-prefix :handle
     1636         .
     1637         create button v-diasize-resize-button
     1638         assign
     1639           parent        = frame Dialog-Frame :first-child
     1640           label         = "s"
     1641           height-pixels = 16
     1642           width-pixels  = 16
     1643           visible       = true
     1644           sensitive     = true
     1645           movable       = true
     1646           triggers:
     1647             on end-move persistent run diasize_end-move in this-procedure .
     1648           end triggers.
     1649         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1650         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1651         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1652         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1653         assign
     1654           v-diasize-wndmax = false
     1655         .
     1656         if connected("ub") = true
     1657         then do:
     1658           define variable v-cntxt-db-num        as integer   no-undo .
     1659           define variable v-cntxt-userid        as character no-undo .
     1660           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1661                                             , OUTPUT v-cntxt-userid
     1662                                             ) .
     1663           run gbl/wndpar_r.p
     1664             (input  v-cntxt-db-num
     1665             ,input  v-cntxt-userid
     1666             ,input  'wndmax':U
     1667             ,output v-diasize-wndmax
     1668             ,output v-default-value
     1669             ) .
     1670         end.
     1671         assign
     1672           v-diasize-wndstore = false
     1673         .
     1674         if connected("ub") = true
     1675         then do:
     1676           run gbl/wndpar_r.p
     1677             (input  v-cntxt-db-num
     1678             ,input  v-cntxt-userid
     1679             ,input  'wndstore':U
     1680             ,output v-diasize-wndstore
     1681             ,output v-default-value
     1682             ) .
     1683         end.
     1684         assign
     1685           v-diasize-proc-name = entry(1, program-name(2), '.')
     1686         .
     1687         if v-diasize-wndstore = true
     1688         then do:
     1689           assign
     1690             v-restore-saved = false
     1691           .
     1692           if connected("ub") = true
     1693           then do:
     1694             run gbl/wndsizer.p
     1695               (input  v-cntxt-db-num
     1696               ,input  v-cntxt-userid
     1697               ,input  v-diasize-proc-name
     1698               ,input  'height':u
     1699               ,output v-resize-value-str
     1700               ) .
     1701             if v-resize-value-str <> '':U
     1702             then do:
     1703               run diasize_change-height in this-procedure
     1704                 (input  integer(v-resize-value-str)
     1705                 ,input  true
     1706                 ) .
     1707               assign
     1708                 v-restore-saved = true
     1709               .
     1710             end.
     1711           end.
     1712           if connected("ub") = true
     1713           then do:
     1714             run gbl/wndsizer.p
     1715               (input  v-cntxt-db-num
     1716               ,input  v-cntxt-userid
     1717               ,input  v-diasize-proc-name
     1718               ,input  'width':u
     1719               ,output v-resize-value-str
     1720               ) .
     1721             if v-resize-value-str <> '':U
     1722             then do:
     1723               run diasize_change-width in this-procedure
     1724                 (input  integer(v-resize-value-str)
     1725                 ,input  true
     1726                 ) .
     1727               assign
     1728                 v-restore-saved = true
     1729               .
     1730             end.
     1731           end.
     1732           if v-restore-saved <> true
     1733           then do:
     1734             if v-diasize-wndmax = true
     1735             then do:
     1736               run diasize_maximize in this-procedure
     1737                 (input  true
     1738                 ) .
     1739             end.
     1740           end.
     1741         end.
     1742         else do:
     1743           if v-diasize-wndmax = true
     1744           then do:
     1745             run diasize_maximize in this-procedure
     1746               (input  true
     1747               ) .
     1748           end.
     1749         end.
     1750       end.
     1751     end.
     1752   end procedure.
     1753   procedure diasize_need-full-display :
     1754     define output parameter p-need-full-display as logical   no-undo .
     1755     do
     1756     on error undo, return error return-value
     1757     :
     1758       assign
     1759         p-need-full-display = v-diasize-need-full-display
     1760       .
     1761       assign
     1762         v-diasize-need-full-display = false
     1763       .
     1764     end.
     1765   end procedure.
     1766   procedure get-context :
     1767      define output parameter p-db-num as integer          no-undo.
     1768      define output parameter p-user-id as character        no-undo.
     1769      define variable v-login               as character    no-undo.
     1770      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1771      define buffer buf_user-login  for ub.user-login .
     1772      do
     1773      on error undo, return error
     1774      :
     1775            FIND FIRST buf_sys-ctrl no-lock.
     1776            ASSIGN
     1777               v-login = USERID("ub")
     1778               p-db-num = buf_sys-ctrl.db-num
     1779            .
     1780            FIND FIRST buf_user-login
     1781                 WHERE buf_user-login.db-num = p-db-num
     1782                   AND buf_user-login.user-login = v-login
     1783                 no-lock
     1784                 no-error
     1785                 .
     1786            IF AVAILABLE buf_user-login
     1787            THEN DO:
     1788               assign
     1789                  p-user-id = buf_user-login.user-id
     1790               .
     1791            END.
     1792      end.
     1793   end procedure.
     1794       run diasize_init in this-procedure .
     1795   MAIN-BLOCK:
     1796   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1797      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1798     RUN fill-table IN THIS-PROCEDURE.
     1799     RUN Myenable in this-procedure .
     1800     WAIT-FOR GO OF FRAME Dialog-Frame.
     1801   END.
     1802   RUN disable_UI.
     1803   PROCEDURE disable_UI :
     1804     HIDE FRAME Dialog-Frame.
     1805   END PROCEDURE.
     1806   PROCEDURE display-region :
     1807   DEFINE buffer buf_clients FOR ub.clients.
     1808   DEFINE buffer buf_objects FOR ub.clients.
     1809       assign
     1810       var-region = "Глобально"
     1811       v-host-name = "":U
     1812       for-obj-name = "":U.
     1813       if p-host-code <> 0 then do:
     1814           find first buf_clients No-LOCK WHERE
     1815                   buf_clients.obj-type = 'орг':U and
     1816                   buf_clients.obj-code = p-host-code No-ERROR.
     1817           ASSIGN
     1818           var-region = "Фирма: "
     1819           v-host-name = buf_Clients.obj-name
     1820           .
     1821       end.
     1822       if p-obj-code <> 0 then do:
     1823           find first buf_objects No-LOCK WHERE
     1824                   buf_objects.obj-type = p-obj-type and
     1825                   buf_objects.obj-code = p-obj-code No-ERROR.
     1826           ASSIGN
     1827           var-region = "Объект: "
     1828           for-obj-name = buf_objects.obj-name
     1829           .
     1830    end.
     1831    DISPLAY
     1832    var-region
     1833    WITH FRAME Dialog-Frame.
     1834    IF p-host-code <> 0 THEN DO:
     1835        DISPLAY
     1836        v-host-name
     1837        WITH FRAME Dialog-Frame.
     1838    END.
     1839    ELSE DO:
     1840        HIDE
     1841        v-host-name
     1842        IN FRAME Dialog-Frame.
     1843   END.
     1844    IF p-obj-code <> 0 THEN DO:
     1845        DISPLAY
     1846        for-obj-name
     1847        WITH FRAME Dialog-Frame.
     1848    END.
     1849    ELSE DO:
     1850        HIDE
     1851        for-obj-name
     1852        IN FRAME Dialog-Frame.
     1853   END.
     1854   END PROCEDURE.
     1855   PROCEDURE enable_UI :
     1856     DISPLAY RS-region var-region v-host-name for-obj-name
     1857         WITH FRAME Dialog-Frame.
     1858     ENABLE B-exit b-quit B-Help RECT-region RS-region BR-prefix var-region
     1859            v-host-name for-obj-name
     1860         WITH FRAME Dialog-Frame.
     1861     VIEW FRAME Dialog-Frame.
     1862   END PROCEDURE.
     1863   PROCEDURE fill-table :
     1864   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1865   DO ii = 1 TO NUM-ENTRIES(p-attr-value):
     1866       CREATE tt-prefix.
     1867       ASSIGN
     1868       tt-prefix.prefix = ENTRY(ii, p-attr-value)
     1869       .
     1870   END.
     1871   END PROCEDURE.
     1872   PROCEDURE MyEnable :
     1873   assign
     1874   rs-region = (if p-host-code = 0
     1875                then 0
     1876                else (if p-obj-type = '':U then 1 else 2)
     1877                )
     1878   .
     1879   display rs-region
     1880   with frame Dialog-Frame .
     1881    ENABLE
     1882    B-exit
     1883    RECT-region
     1884    b-quit
     1885    B-Help
     1886    BR-prefix
     1887    b-add
     1888    b-del
     1889    WITH FRAME Dialog-Frame.
     1890    VIEW FRAME Dialog-Frame.
     1891    RUN display-region IN THIS-PROCEDURE.
     1892    open query br-prefix for each tt-prefix.
     1893   END PROCEDURE.
     1894   PROCEDURE proc-save :
     1895   DEFINE VARIABLE v-dop AS character NO-UNDO.
     1896   FOR EACH tt-prefix:
     1897       ASSIGN
     1898       v-dop = v-dop + (IF v-dop = '':U THEN '':U ELSE chr(44)) + tt-prefix.prefix.
     1899   END.
     1900   ASSIGN
     1901   p-attr-value = v-dop
     1902   p-ok = yes
     1903   .
     1904   END PROCEDURE.
