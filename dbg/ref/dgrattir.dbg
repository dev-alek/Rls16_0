        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-mode      as character no-undo .
        4   define input parameter p-mode-obj  as character no-undo .
        5   define input parameter p-gds-code  like ub.goods.gds-code no-undo .
        6   define input parameter p-obj-type  like ub.dis-gds-rule.obj-type  no-undo .
        7   define input parameter p-obj-code  like ub.dis-gds-rule.obj-code  no-undo .
        8   define input parameter p-update-on-exit as logical no-undo .
        9   define output parameter p-modified as logical no-undo .
       10   define output parameter p-is-error as logical no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: dgrattir.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: ref/dgrattir.p $":U .
       16   define variable vss-description as character no-undo init "Запуск интерфейса редактирования скидок товара, действующих на объекте".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable v-update-attr as logical no-undo .
       87   define variable dflt-cd as character no-undo .
       88   define temp-table tt0-dis-gds-rule no-undo like ub.dis-gds-rule.
       89   define buffer buf_dis-gds-rule for ub.dis-gds-rule.
       90   define buffer locked_dis-gds-rule for ub.dis-gds-rule.
       91   do
       92   on stop undo, return error return-value
       93   :
       94     for each tt0-dis-gds-rule:
       95       delete tt0-dis-gds-rule.
       96     end.
       97     CASE p-mode:
       98       when 'ИЗМЕНЕНИЕ':U then do:
       99         do on error undo, return error :
      100           Find first locked_dis-gds-rule exclusive-lock  where
      101                   locked_dis-gds-rule.gds-code = p-gds-code
      102               AND locked_dis-gds-rule.obj-type = (if g#db-num = 0 then '':U else p-obj-type)
      103               AND locked_dis-gds-rule.obj-code = (if g#db-num = 0 then 0 else p-obj-code)
      104               AND locked_dis-gds-rule.pos-type = '':U
      105               and locked_dis-gds-rule.discnt-role = '':U
      106               and locked_dis-gds-rule.nonunique = '':U
      107               no-error no-wait.
      108           if not available locked_dis-gds-rule
      109           and not locked locked_dis-gds-rule then do:
      110             create locked_dis-gds-rule.
      111             assign
      112             locked_dis-gds-rule.obj-type =  (if g#db-num = 0 then '':U else p-obj-type)
      113             locked_dis-gds-rule.obj-code = (if g#db-num = 0 then 0 else p-obj-code)
      114             locked_dis-gds-rule.gds-code = p-gds-code
      115             locked_dis-gds-rule.pos-type = '':U
      116             locked_dis-gds-rule.discnt-role = '':U
      117             locked_dis-gds-rule.nonunique = '':U
      118             .
      119           end.
      120           if locked locked_dis-gds-rule then do:
      121             Find first locked_dis-gds-rule exclusive-lock  where
      122                   locked_dis-gds-rule.gds-code = p-gds-code
      123               AND locked_dis-gds-rule.obj-type = (if g#db-num = 0 then '':U else p-obj-type)
      124               AND locked_dis-gds-rule.obj-code = (if g#db-num = 0 then 0 else p-obj-code)
      125               AND locked_dis-gds-rule.pos-type = '':U
      126               and locked_dis-gds-rule.discnt-role = '':U
      127               and locked_dis-gds-rule.nonunique = '':U
      128               no-error .
      129           end.
      130         end.
      131         FOR EACH buf_dis-gds-rule no-lock  where
      132                 buf_dis-gds-rule.gds-code = p-gds-code
      133         on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      134         on stop   undo , return error substitute( "&1. stop", vss-workfile )
      135         on endkey undo , return error substitute( "&1. endkey", vss-workfile )
      136         :
      137           if buf_dis-gds-rule.pos-type = '':U
      138           and buf_dis-gds-rule.discnt-role = '':U
      139           and buf_dis-gds-rule.nonunique = '':U  then next.
      140           CREATE tt0-dis-gds-rule.
      141           BUFFER-COPY buf_dis-gds-rule TO tt0-dis-gds-rule.
      142         END.
      143         run ref/dis-gdsi.w (
      144                         input parparentproc
      145                       , input p-mode
      146                       , input p-mode-obj
      147                       , input p-gds-code
      148                       , input p-obj-type
      149                       , input p-obj-code
      150                       , input (if p-mode-obj = 'объект':U then dflt-cd else '':U)
      151                       , input p-update-on-exit
      152                       , output p-modified
      153                       , input-output table tt0-dis-gds-rule
      154                             ) no-error.
      155         if error-status:error then do:
      156           assign
      157           p-is-error = yes
      158           .
      159         end.
      160         for each tt0-dis-gds-rule:
      161           delete tt0-dis-gds-rule.
      162         end.
      163         if p-is-error then do:
      164           return error substitute("&1 &2", error-status:get-message(1) , return-value ).
      165         end.
      166       end.
      167       when 'ПРОСМОТР':U then do:
      168         FOR EACH buf_dis-gds-rule no-lock where
      169                 buf_dis-gds-rule.gds-code = p-gds-code:
      170           if buf_dis-gds-rule.pos-type = '':U
      171           and buf_dis-gds-rule.discnt-role = '':U
      172           and buf_dis-gds-rule.nonunique = '':U  then next.
      173           CREATE tt0-dis-gds-rule.
      174           BUFFER-COPY buf_dis-gds-rule TO tt0-dis-gds-rule.
      175         END.
      176         run ref/dis-gdsi.w (
      177                         input parparentproc
      178                       , input p-mode
      179                       , input p-mode-obj
      180                       , input p-gds-code
      181                       , input p-obj-type
      182                       , input p-obj-code
      183                       , input (if p-mode-obj = 'объект':U then dflt-cd else '':U)
      184                       , input p-update-on-exit
      185                       , output p-modified
      186                       , input-output table tt0-dis-gds-rule
      187                             ) no-error.
      188         if error-status:error then do:
      189           assign
      190           p-is-error = yes.
      191         end.
      192         for each tt0-dis-gds-rule:
      193           delete tt0-dis-gds-rule.
      194         end.
      195         if p-is-error then do:
      196           return error substitute("&1 &2", error-status:get-message(1) , return-value ).
      197         end.
      198       end.
      199     end CASE.
      200   end.
