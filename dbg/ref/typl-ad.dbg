        1   block-level on error undo, throw.
        2   define variable vss-revision    as character no-undo init "$Revision: cb37b650f92a, 1185, rls $":U .
        3   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
        4   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:20:27 2017 +0300 $":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile: typl-ad.p $":U .
        6   define variable vss-archive     as character no-undo init "$Archive: ref/typl-ad.p $":U .
        7   define variable vss-description as character no-undo init "Процедуры довавления и удаления типов прайс-листов".
        8   define new global shared variable g#language as character no-undo .
        9   if g#language <> '' and g#language <> 'rus':U then do:
       10     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       11   end.
       12   DEFINE TEMP-TABLE TT_cassa NO-UNDO LIKE ub.price-list-type-cassa.
       13   DEFINE TEMP-TABLE TT_grp   NO-UNDO LIKE ub.price-list-type-gds-grp.
       14   DEFINE TEMP-TABLE TT_pay-type NO-UNDO LIKE ub.price-list-type-pay-type.
       15   DEFINE TEMP-TABLE TT_cash-pay NO-UNDO LIKE ub.price-list-type-cash-pay.
       16   PROCEDURE type-price-list-ADD :
       17   define input  parameter p-db-num                       as integer   no-undo .
       18   define input  parameter p-id                           as integer   no-undo .
       19   define input  parameter p-name                         as character no-undo .
       20   define input  parameter p-ban-discnt                   like   ub.price-list-type.ban-discnt          no-undo .
       21   define input  parameter p-calc-round-method            like   ub.price-list-type.calc-round-method    no-undo .
       22   define input  parameter p-calc-round-base              like   ub.price-list-type.calc-round-base      no-undo .
       23   define input  parameter p-calc-increase-pc             like   ub.price-list-type.calc-increase-pc     no-undo .
       24   define input  parameter p-calc-method                  like   ub.price-list-type.calc-method          no-undo .
       25   define input  parameter p-create-price-doc             like   ub.price-list-type.create-price-doc     no-undo .
       26   define input  parameter p-fix-cource-crc-base          like   ub.price-list-type.fix-cource-crc-base  no-undo .
       27   define input  parameter p-fix-cource-crc-doc           like   ub.price-list-type.fix-cource-crc-doc   no-undo .
       28   define input  parameter p-have-rs-qnty-group           like   ub.price-list-type.have-rs-qnty-group   no-undo .
       29   define input  parameter p-have-rs-sum-group            like   ub.price-list-type.have-rs-sum-group    no-undo .
       30   define input  parameter p-main                         like   ub.price-list-type.main                 no-undo .
       31   define input  parameter p-only-gbd                     like   ub.price-list-type.only-gbd             no-undo .
       32   define input  parameter p-plt-main-db-num              like   ub.price-list-type.plt-main-db-num      no-undo .
       33   define input  parameter p-plt-main-id                  like   ub.price-list-type.plt-main-id          no-undo .
       34   define input  parameter p-priority                     like   ub.price-list-type.priority             no-undo .
       35   define input  parameter p-rs-buyer                     like   ub.price-list-type.rs-buyer             no-undo .
       36   define input  parameter p-send-cassa                   like   ub.price-list-type.send-cassa           no-undo .
       37   define input  parameter p-under-hand-corr              like   ub.price-list-type.under-hand-corr      no-undo .
       38   define input  parameter p-under-round-method           like   ub.price-list-type.under-round-method         no-undo .
       39   define input  parameter p-under-perc                   like   ub.price-list-type.under-perc           no-undo .
       40   define input  parameter p-under-type-list              like   ub.price-list-type.under-type-list      no-undo .
       41   define input  parameter p-use-cassa                    like   ub.price-list-type.use-cassa            no-undo .
       42   define input  parameter p-use-gds-group                like   ub.price-list-type.use-gds-group        no-undo .
       43   define input  parameter p-use-obj                      like   ub.price-list-type.use-obj              no-undo .
       44   define input  parameter p-work-date                    like   ub.price-list-type.work-date            no-undo .
       45   define input  parameter p-bgr-db-num                   like   ub.price-list-type.bgr-db-num           no-undo .
       46   define input  parameter p-bgr-id                       like   ub.price-list-type.bgr-id               no-undo .
       47   define input  parameter p-curr-code                    like   ub.price-list-type.curr-code            no-undo .
       48   define input  parameter p-gop-db-num                   like   ub.price-list-type.gop-db-num           no-undo .
       49   define input  parameter p-gop-db-num-for-calc-turnover like   ub.price-list-type.gop-db-num-for-calc-turnover  no-undo .
       50   define input  parameter p-gop-id                       like   ub.price-list-type.gop-id                        no-undo .
       51   define input  parameter p-gop-id-for-calc-turnover     like   ub.price-list-type.gop-id-for-calc-turnover      no-undo .
       52   define input  parameter p-qgr-db-num                   like   ub.price-list-type.qgr-db-num                    no-undo .
       53   define input  parameter p-qgr-id                       like   ub.price-list-type.qgr-id                        no-undo .
       54   define input  parameter p-sgr-db-num                   like   ub.price-list-type.sgr-db-num                    no-undo .
       55   define input  parameter p-sgr-id                       like   ub.price-list-type.sgr-id                        no-undo .
       56   define input  parameter p-tog-db-num                   like   ub.price-list-type.tog-db-num                    no-undo .
       57   define input  parameter p-tog-id                       like   ub.price-list-type.tog-id                        no-undo .
       58   define input  parameter p-obj-turnover                 like   ub.price-list-type.obj-turnover                  no-undo .
       59   define input  parameter p-ttg-summa                    like   ub.price-list-type.ttg-summa                     no-undo .
       60   define input  parameter p-userid                       as character no-undo .
       61   define input  parameter p-db-num-usr                   as integer   no-undo .
       62   define input  parameter p-have-rs-turn-group           like   ub.price-list-type.have-rs-turn-group no-undo .
       63   define input  parameter p-have-tog-db-num              like   ub.price-list-type.have-tog-db-num    no-undo .
       64   define input  parameter p-have-tog-id                  like   ub.price-list-type.have-tog-id        no-undo .
       65   define input  parameter p-use-cash-pay                 like   ub.price-list-type.use-cash-pay no-undo .
       66   define input  parameter p-use-pay-type                 like   ub.price-list-type.use-pay-type no-undo .
       67   define output parameter p-recid                        as recid no-undo .
       68   define input  parameter table for tt_cassa .
       69   define input  parameter table for tt_grp   .
       70   define input  parameter table for tt_pay-type .
       71   define input  parameter table for tt_cash-pay .
       72   define variable v-text as character no-undo .
       73   define buffer buf_price-list-type for ub.price-list-type  .
       74     do
       75     on error undo, return error return-value
       76     :
       77   if p-plt-main-id                     = ? then p-plt-main-id = 0 .
       78   if p-bgr-id                          = ? then p-bgr-id                        = 0 .
       79   if p-gop-id                          = ? then p-gop-id                        = 0 .
       80   if p-gop-id-for-calc-turnover        = ? then p-gop-id-for-calc-turnover      = 0 .
       81   if p-qgr-db-num                      = ? then p-qgr-db-num                    = 0 .
       82   if p-qgr-id                          = ? then p-qgr-id                        = 0 .
       83   if p-sgr-db-num                      = ? then p-sgr-db-num                    = 0 .
       84   if p-sgr-id                          = ? then p-sgr-id                        = 0 .
       85   if p-tog-db-num                      = ? then p-tog-db-num                    = 0 .
       86   if p-tog-id                          = ? then p-tog-id                        = 0 .
       87   if p-gop-db-num                      = ? then p-gop-db-num                    = 0 .
       88   if p-gop-db-num-for-calc-turnover    = ? then p-gop-db-num-for-calc-turnover  = 0 .
       89   if p-have-tog-db-num                 = ? then p-have-tog-db-num  = 0 .
       90   if p-have-tog-id                     = ? then p-have-tog-id      = 0 .
       91   if p-gop-id = 0  then  p-use-obj = 1 .
       92   if p-gop-id-for-calc-turnover  = 0  then  p-obj-turnover = false  .
       93   if p-tog-id = 0   then  p-obj-turnover = false  .
       94   if p-tog-id = 0 and  p-bgr-id = 0   then  p-rs-buyer = 0.
       95   if p-name = ? or p-name = ""  then do:
       96     return error "Название типа прайс-листа не должно быть пустым!" .
       97   end.
       98   if logical(p-have-rs-qnty-group) = true and  ( p-qgr-id = 0 or p-qgr-id = ? ) then do:
       99     return error "Не задана количественная группа!" .
      100   end.
      101   if p-have-rs-sum-group = true and  ( p-sgr-id = 0 or p-sgr-id = ? ) then do:
      102     return error "Не задана суммовая группа!" .
      103   end.
      104   if logical(p-under-type-list) = true and  ( p-plt-main-id = 0 or p-plt-main-id = ? ) then do:
      105     return error "Не задан родительский прайс-лист !" .
      106   end.
      107   define buffer parent_price-list-type for ub.price-list-type  .
      108   if  logical(p-under-type-list) = true and p-main = true  then do:
      109       find first parent_price-list-type  no-lock where
      110                  parent_price-list-type.plt-id = p-plt-main-id  and
      111                  parent_price-list-type.plt-db-num =  p-plt-main-db-num no-error .
      112       if not available parent_price-list-type then  return error "Родительский прайс-лист не найден !" .
      113       if parent_price-list-type.stts <> integer('0':U) then  return error "Родительский прайс-лист удален !" .
      114       if parent_price-list-type.main = false  then  return error "Родительский прайс-лист должен быть ГЛАВНЫМ !" .
      115       if parent_price-list-type.under-type-list <> 0  then return error "Родительский прайс-лист не должен быть подчиненным !"  .
      116   end.
      117   if  logical(p-under-type-list) = true and p-main = false   then do:
      118       find first parent_price-list-type  no-lock where
      119                  parent_price-list-type.plt-id = p-plt-main-id  and
      120                  parent_price-list-type.plt-db-num =  p-plt-main-db-num no-error .
      121       if not available parent_price-list-type then  return error "Родительский прайс-лист не найден !" .
      122       if parent_price-list-type.stts <> integer('0':U) then  return error "Родительский прайс-лист удален !" .
      123       if parent_price-list-type.under-type-list <> 0  then return error "Родительский прайс-лист не должен быть подчиненным !"  .
      124   end.
      125   if logical(p-have-rs-qnty-group) = false  and not ( p-qgr-id = 0 or p-qgr-id = ? ) then do:
      126      p-qgr-id = 0.
      127      p-qgr-db-num = 0.
      128   end.
      129   if p-have-rs-sum-group = false  and  not( p-sgr-id = 0 or p-sgr-id = ? ) then do:
      130     p-sgr-id = 0.
      131     p-sgr-db-num = 0.
      132   end.
      133   if logical(p-have-rs-turn-group) = false  and not ( p-have-tog-id = 0 or p-have-tog-id = ? ) then do:
      134      p-have-tog-id = 0.
      135      p-have-tog-db-num = 0.
      136   end.
      137   if p-priority  = 0  and p-main = false  and p-under-type-list = 0 then do:
      138      return error "Не задан ПРИОРИТЕТ типа прайс-листа"   .
      139   end.
      140   if p-priority > 0 and p-main = false and p-under-type-list = 0 then do:
      141       if can-find (
      142             first buf_price-list-type no-lock where
      143                   buf_price-list-type.under-type-list = 0          and
      144                   buf_price-list-type.priority        = p-priority and
      145                   buf_price-list-type.main            = false      and
      146                   buf_price-list-type.stts            = integer('0':U)          and
      147               not
      148                 ( buf_price-list-type.plt-db-num = p-db-num and
      149                   buf_price-list-type.plt-id     = p-id )
      150                 ) then
      151       return error "Уже есть тип прайс-листа с приоритетом " + string ( p-priority ) .
      152   end.
      153   find first ub.price-list-type exclusive-lock where
      154              ub.price-list-type.plt-db-num   = p-db-num and
      155              ub.price-list-type.plt-id       = p-id
      156              no-error .
      157       if not available ub.price-list-type then do:
      158         if p-main = true and p-only-gbd = 1 then do:
      159           if can-find ( first buf_price-list-type no-lock where
      160                             buf_price-list-type.main = true and
      161                             buf_price-list-type.only-gbd = 1 and
      162                             buf_price-list-type.stts = integer('0':U) and
      163                             buf_price-list-type.gop-id = p-gop-id and
      164                             buf_price-list-type.gop-db-num = p-gop-db-num ) then  do:
      165               if p-gop-id = 0 or p-gop-id = ? then do:
      166                 v-text  = "для всех объектов" .
      167                 end.
      168                 else do:
      169                 v-text  = "для объектов из группы №"  + string(p-gop-id) + " БД:" + string(p-gop-db-num).
      170                 end.
      171               release ub.price-list-type no-error .
      172               return error "Уже существует ГЛАВНЫЙ ПРАЙС-ЛИСТ для автопереоценок " + v-text .
      173               end.
      174         end.
      175         create ub.price-list-type .
      176         assign
      177             ub.price-list-type.plt-db-num   = p-db-num
      178             ub.price-list-type.plt-id       = p-id
      179         .
      180       end.
      181          assign
      182             ub.price-list-type.plt-db-num                     = p-db-num
      183             ub.price-list-type.plt-id                         = p-id
      184             ub.price-list-type.name                           = p-name
      185             ub.price-list-type.ban-discnt                     = p-ban-discnt
      186             ub.price-list-type.calc-round-method              = p-calc-round-method
      187             ub.price-list-type.calc-round-base                = p-calc-round-base
      188             ub.price-list-type.calc-increase-pc               = p-calc-increase-pc
      189             ub.price-list-type.calc-method                    = p-calc-method
      190             ub.price-list-type.create-price-doc               = p-create-price-doc
      191             ub.price-list-type.fix-cource-crc-base            = p-fix-cource-crc-base
      192             ub.price-list-type.fix-cource-crc-doc             = p-fix-cource-crc-doc
      193             ub.price-list-type.have-rs-qnty-group             = p-have-rs-qnty-group
      194             ub.price-list-type.have-rs-sum-group              = p-have-rs-sum-group
      195             ub.price-list-type.main                           = p-main
      196             ub.price-list-type.only-gbd                       = p-only-gbd
      197             ub.price-list-type.plt-main-db-num                = if p-plt-main-id = 0 then p-db-num else p-plt-main-db-num
      198             ub.price-list-type.plt-main-id                    = if p-plt-main-id = 0 then p-id else p-plt-main-id
      199             ub.price-list-type.priority                       = p-priority
      200             ub.price-list-type.rs-buyer                       = p-rs-buyer
      201             ub.price-list-type.send-cassa                     = p-send-cassa
      202             ub.price-list-type.under-hand-corr                = p-under-hand-corr
      203             ub.price-list-type.under-round-method             = p-under-round-method
      204             ub.price-list-type.under-perc                     = p-under-perc
      205             ub.price-list-type.under-type-list                = p-under-type-list
      206             ub.price-list-type.use-cassa                      = p-use-cassa
      207             ub.price-list-type.use-gds-group                  = p-use-gds-group
      208             ub.price-list-type.use-obj                        = p-use-obj
      209             ub.price-list-type.work-date                      = p-work-date
      210             ub.price-list-type.bgr-db-num                     = p-bgr-db-num
      211             ub.price-list-type.bgr-id                         = p-bgr-id
      212             ub.price-list-type.curr-code                      = p-curr-code
      213             ub.price-list-type.gop-db-num                     = p-gop-db-num
      214             ub.price-list-type.gop-db-num-for-calc-turnover   = p-gop-db-num-for-calc-turnover
      215             ub.price-list-type.gop-id                         = p-gop-id
      216             ub.price-list-type.gop-id-for-calc-turnover       = p-gop-id-for-calc-turnover
      217             ub.price-list-type.qgr-db-num                     = p-qgr-db-num
      218             ub.price-list-type.qgr-id                         = p-qgr-id
      219             ub.price-list-type.sgr-db-num                     = p-sgr-db-num
      220             ub.price-list-type.sgr-id                         = p-sgr-id
      221             ub.price-list-type.tog-db-num                     = p-tog-db-num
      222             ub.price-list-type.tog-id                         = p-tog-id
      223             ub.price-list-type.obj-turnover                   = p-obj-turnover
      224             ub.price-list-type.ttg-summa                      = p-ttg-summa
      225             ub.price-list-type.have-rs-turn-group             =   p-have-rs-turn-group
      226             ub.price-list-type.have-tog-db-num                =   p-have-tog-db-num
      227             ub.price-list-type.have-tog-id                    =   p-have-tog-id
      228             ub.price-list-type.use-cash-pay                   =   p-use-cash-pay
      229             ub.price-list-type.use-pay-type                   =   p-use-pay-type
      230             ub.price-list-type.stts                           = integer('0':U)
      231             ub.price-list-type.sys-date                       = today
      232             ub.price-list-type.sys-time                       = time
      233             ub.price-list-type.sys-time-chr                   = string ( ub.price-list-type.sys-time,"hh:mm" )
      234             ub.price-list-type.who                            = p-userid
      235             ub.price-list-type.db-num-chg                     = p-db-num-usr
      236             p-recid = recid ( ub.price-list-type )
      237         .
      238     if p-use-cassa < 3 then do:
      239        for each tt_cassa : delete tt_cassa . end.
      240     end.
      241     if p-use-gds-group = 0  then do:
      242        for each tt_grp : delete tt_grp . end.
      243     end.
      244     for each ub.price-list-type-gds-grp exclusive-lock where
      245              ub.price-list-type-gds-grp.plt-db-num  = p-db-num and
      246              ub.price-list-type-gds-grp.plt-id      = p-id :
      247          if not can-find (first  tt_grp where tt_grp.node-code = ub.price-list-type-gds-grp.node-code ) then
      248          ub.price-list-type-gds-grp.stts   = integer('1':U) .
      249     end.
      250     for each tt_grp :
      251         find first  ub.price-list-type-gds-grp exclusive-lock where
      252                 ub.price-list-type-gds-grp.node-code  = tt_grp.node-code and
      253                 ub.price-list-type-gds-grp.plt-db-num  = p-db-num and
      254                 ub.price-list-type-gds-grp.plt-id      = p-id no-error .
      255         if not available ub.price-list-type-gds-grp then do:
      256                create ub.price-list-type-gds-grp.
      257                 assign
      258                   ub.price-list-type-gds-grp.node-code  = tt_grp.node-code
      259                   ub.price-list-type-gds-grp.plt-db-num     = p-db-num
      260                   ub.price-list-type-gds-grp.plt-id         = p-id
      261                   ub.price-list-type-gds-grp.stts       = integer('0':U)
      262                   ub.price-list-type-gds-grp.sys-date     = today
      263                   ub.price-list-type-gds-grp.sys-time     = time
      264                   ub.price-list-type-gds-grp.sys-time-chr = string ( ub.price-list-type-gds-grp.sys-time,"hh:mm" )
      265                   ub.price-list-type-gds-grp.who          = p-userid
      266                   ub.price-list-type-gds-grp.db-num-chg   = p-db-num-usr
      267                 .
      268                end.
      269         else do:
      270            assign
      271             ub.price-list-type-gds-grp.stts   = integer('0':U)
      272             ub.price-list-type-gds-grp.sys-date     = today
      273             ub.price-list-type-gds-grp.sys-time     = time
      274             ub.price-list-type-gds-grp.sys-time-chr = string ( ub.price-list-type-gds-grp.sys-time,"hh:mm" )
      275             ub.price-list-type-gds-grp.who          = p-userid
      276             ub.price-list-type-gds-grp.db-num-chg   = p-db-num-usr
      277            .
      278         end.
      279     end.
      280     for each ub.price-list-type-cassa exclusive-lock where
      281              ub.price-list-type-cassa.plt-db-num  = p-db-num and
      282              ub.price-list-type-cassa.plt-id      = p-id :
      283          if not can-find (first tt_cassa where
      284                                 tt_cassa.cash-num = ub.price-list-type-cassa.cash-num and
      285                                 tt_cassa.obj-code = ub.price-list-type-cassa.obj-code and
      286                                 tt_cassa.pos-type = ub.price-list-type-cassa.pos-type
      287                                 ) then
      288          ub.price-list-type-cassa.stts   = integer('1':U)  .
      289     end.
      290     for each tt_cassa :
      291         find first  ub.price-list-type-cassa exclusive-lock where
      292                     ub.price-list-type-cassa.cash-num = tt_cassa.cash-num and
      293                     ub.price-list-type-cassa.obj-code = tt_cassa.obj-code and
      294                     ub.price-list-type-cassa.pos-type = tt_cassa.pos-type and
      295                     ub.price-list-type-cassa.plt-db-num        = p-db-num and
      296                     ub.price-list-type-cassa.plt-id            = p-id     no-error .
      297         if not available ub.price-list-type-cassa then do :
      298                create ub.price-list-type-cassa.
      299                 assign
      300                   ub.price-list-type-cassa.cash-num     = tt_cassa.cash-num
      301                   ub.price-list-type-cassa.obj-code     = tt_cassa.obj-code
      302                   ub.price-list-type-cassa.pos-type     = tt_cassa.pos-type
      303                   ub.price-list-type-cassa.plt-db-num   = p-db-num
      304                   ub.price-list-type-cassa.plt-id       = p-id
      305                   ub.price-list-type-cassa.stts         = integer('0':U)
      306                   ub.price-list-type-cassa.sys-date     = today
      307                   ub.price-list-type-cassa.sys-time     = time
      308                   ub.price-list-type-cassa.sys-time-chr = string ( ub.price-list-type-cassa.sys-time,"hh:mm" )
      309                   ub.price-list-type-cassa.who          = p-userid
      310                   ub.price-list-type-cassa.db-num-chg   = p-db-num-usr
      311                   ub.price-list-type-cassa.db-num       = p-db-num-usr
      312                 .
      313                end.
      314         else do:
      315            assign
      316             ub.price-list-type-cassa.stts   = integer('0':U)
      317             ub.price-list-type-cassa.sys-date     = today
      318             ub.price-list-type-cassa.sys-time     = time
      319             ub.price-list-type-cassa.sys-time-chr = string ( ub.price-list-type-cassa.sys-time,"hh:mm" )
      320             ub.price-list-type-cassa.who          = p-userid
      321             ub.price-list-type-cassa.db-num-chg   = p-db-num-usr
      322            .
      323         end.
      324     end.
      325     for each ub.price-list-type-pay-type exclusive-lock where
      326              ub.price-list-type-pay-type.plt-db-num  = p-db-num and
      327              ub.price-list-type-pay-type.plt-id      = p-id :
      328          if not can-find (first tt_pay-type where
      329                                 tt_pay-type.pay-code = ub.price-list-type-pay-type.pay-code
      330                                 ) then
      331          ub.price-list-type-pay-type.stts   = integer('1':U)  .
      332     end.
      333     for each tt_pay-type :
      334         find first  ub.price-list-type-pay-type exclusive-lock where
      335                     ub.price-list-type-pay-type.pay-code = tt_pay-type.pay-code and
      336                     ub.price-list-type-pay-type.plt-db-num        = p-db-num and
      337                     ub.price-list-type-pay-type.plt-id            = p-id     no-error .
      338         if not available ub.price-list-type-pay-type then do :
      339                create ub.price-list-type-pay-type.
      340                 assign
      341                   ub.price-list-type-pay-type.pay-code     = tt_pay-type.pay-code
      342                   ub.price-list-type-pay-type.plt-db-num   = p-db-num
      343                   ub.price-list-type-pay-type.plt-id       = p-id
      344                   ub.price-list-type-pay-type.stts         = integer('0':U)
      345                   ub.price-list-type-pay-type.sys-date     = today
      346                   ub.price-list-type-pay-type.sys-time     = time
      347                   ub.price-list-type-pay-type.sys-time-chr = string ( ub.price-list-type-pay-type.sys-time,"hh:mm" )
      348                   ub.price-list-type-pay-type.who          = p-userid
      349                   ub.price-list-type-pay-type.db-num-chg   = p-db-num-usr
      350                   ub.price-list-type-pay-type.db-num       = p-db-num-usr
      351                 .
      352                end.
      353         else do:
      354            assign
      355             ub.price-list-type-pay-type.stts   = integer('0':U)
      356             ub.price-list-type-pay-type.sys-date     = today
      357             ub.price-list-type-pay-type.sys-time     = time
      358             ub.price-list-type-pay-type.sys-time-chr = string ( ub.price-list-type-pay-type.sys-time,"hh:mm" )
      359             ub.price-list-type-pay-type.who          = p-userid
      360             ub.price-list-type-pay-type.db-num-chg   = p-db-num-usr
      361            .
      362         end.
      363     end.
      364     for each ub.price-list-type-cash-pay exclusive-lock where
      365              ub.price-list-type-cash-pay.plt-db-num  = p-db-num and
      366              ub.price-list-type-cash-pay.plt-id      = p-id :
      367          if not can-find (first tt_cash-pay where
      368                                 tt_cash-pay.cdpay-code = ub.price-list-type-cash-pay.cdpay-code and
      369                                 tt_cash-pay.curr-code  = ub.price-list-type-cash-pay.curr-code
      370                                 ) then
      371          ub.price-list-type-cash-pay.stts   = 1 .
      372     end.
      373     for each tt_cash-pay :
      374         find first  ub.price-list-type-cash-pay exclusive-lock where
      375                     ub.price-list-type-cash-pay.cdpay-code = tt_cash-pay.cdpay-code and
      376                     ub.price-list-type-cash-pay.curr-code  = tt_cash-pay.curr-code and
      377                     ub.price-list-type-cash-pay.plt-db-num        = p-db-num and
      378                     ub.price-list-type-cash-pay.plt-id            = p-id     no-error .
      379         if not available ub.price-list-type-cash-pay then do :
      380                create ub.price-list-type-cash-pay.
      381                 assign
      382                   ub.price-list-type-cash-pay.cdpay-code     = tt_cash-pay.cdpay-code
      383                   ub.price-list-type-cash-pay.curr-code     = tt_cash-pay.curr-code
      384                   ub.price-list-type-cash-pay.plt-db-num   = p-db-num
      385                   ub.price-list-type-cash-pay.plt-id       = p-id
      386                   ub.price-list-type-cash-pay.stts         = integer('0':U)
      387                   ub.price-list-type-cash-pay.sys-date     = today
      388                   ub.price-list-type-cash-pay.sys-time     = time
      389                   ub.price-list-type-cash-pay.sys-time-chr = string ( ub.price-list-type-cash-pay.sys-time,"hh:mm" )
      390                   ub.price-list-type-cash-pay.who          = p-userid
      391                   ub.price-list-type-cash-pay.db-num-chg   = p-db-num-usr
      392                   ub.price-list-type-cash-pay.db-num       = p-db-num-usr
      393                 .
      394                end.
      395         else do:
      396            assign
      397             ub.price-list-type-cash-pay.stts   = integer('0':U)
      398             ub.price-list-type-cash-pay.sys-date     = today
      399             ub.price-list-type-cash-pay.sys-time     = time
      400             ub.price-list-type-cash-pay.sys-time-chr = string ( ub.price-list-type-cash-pay.sys-time,"hh:mm" )
      401             ub.price-list-type-cash-pay.who          = p-userid
      402             ub.price-list-type-cash-pay.db-num-chg   = p-db-num-usr
      403            .
      404         end.
      405     end.
      406     end.
      407   end procedure.
      408   PROCEDURE type-price-list-delete :
      409   define input  parameter p-db-num       as integer   no-undo .
      410   define input  parameter p-id           as integer   no-undo .
      411   define input  parameter p-db-num-usr   as integer   no-undo .
      412   define input  parameter p-userid       as character no-undo .
      413   define buffer child_price-list-type for ub.price-list-type  .
      414     do
      415     on error undo, return error return-value
      416     :
      417   find first ub.price-list-type exclusive-lock where
      418           ub.price-list-type.plt-db-num   = p-db-num  and
      419           ub.price-list-type.plt-id       = p-id
      420           no-error .
      421    if not available ub.price-list-type then  return error .
      422    if ub.price-list-type.ban-discnt > 0 then do:
      423    define buffer buf_dis-rule for ub.dis-rule  .
      424    find first buf_dis-rule no-lock where
      425               buf_dis-rule.templ-rl-root = ub.price-list-type.ban-discnt and
      426               buf_dis-rule.charkey_one   = substitute("&1-&2", ub.price-list-type.plt-id, ub.price-list-type.plt-db-num)
      427               no-error .
      428        if available buf_dis-rule then do:
      429           message  substitute
      430             ( "Удалить этот тип нельзя, так как есть ссылка на ПРАВИЛО СКИДОК &1 &2" ,
      431                ub.price-list-type.ban-discnt  ,
      432                buf_dis-rule.des
      433               ) view-as alert-box error .
      434           return .
      435        end.
      436    end.
      437    find first ub.price-doc-forming no-lock where
      438               ub.price-doc-forming.plt-id = ub.price-list-type.plt-id and
      439               ub.price-doc-forming.plt-db-num = ub.price-list-type.plt-db-num and
      440               ub.price-doc-forming.stts = integer('0':U) no-error .
      441    if available ub.price-doc-forming then do:
      442           message "Удалить этот тип нельзя, так как есть незакрытые ДНЦ " ub.price-doc-forming.pdf-id "БД:" ub.price-doc-forming.pdf-db
      443           view-as alert-box error .
      444           return .
      445    end.
      446         assign
      447           ub.price-list-type.db-num-chg    = p-db-num-usr
      448           ub.price-list-type.stts          = integer('1':U)
      449           ub.price-list-type.sys-date      = today
      450           ub.price-list-type.sys-time      = time
      451           ub.price-list-type.sys-time-chr  = string ( ub.price-list-type.sys-time,"hh:mm" )
      452           ub.price-list-type.who           = p-userid
      453         .
      454         for each child_price-list-type exclusive-lock where
      455                  child_price-list-type.plt-main-db-num = p-db-num  and
      456                  child_price-list-type.plt-main-id     = p-id
      457                  :
      458               assign
      459                 child_price-list-type.db-num-chg    = p-db-num-usr
      460                 child_price-list-type.stts          = integer('1':U)
      461                 child_price-list-type.sys-date      = today
      462                 child_price-list-type.sys-time      = time
      463                 child_price-list-type.sys-time-chr  = string ( child_price-list-type.sys-time , "hh:mm" )
      464                 child_price-list-type.who           = p-userid
      465               .
      466         end.
      467     end.
      468   end procedure.
      469   define variable v-sec as integer   no-undo .
      470   PROCEDURE obji-add :
      471   define input  parameter p-db-num       as integer   no-undo .
      472   define input  parameter p-id           as integer   no-undo .
      473   define input  parameter p-dgo-db-num   as integer   no-undo .
      474   define input  parameter p-stts         as integer   no-undo .
      475   define input  parameter p-db-num-usr   as integer   no-undo .
      476   define input  parameter p-userid       as character no-undo .
      477   define output parameter p-recid as recid no-undo .
      478     do
      479     on error undo, return error return-value
      480     :
      481   find first ub.grp-obj-price exclusive-lock where
      482           ub.grp-obj-price.gop-db-num   = p-db-num  and
      483           ub.grp-obj-price.gop-id       = p-id
      484           no-error .
      485     if error-status :error then do:
      486         message
      487           vss-workfile vss-revision vss-description skip
      488           error-status :get-message(1) skip
      489           return-value skip
      490           ""
      491           view-as alert-box error
      492         .
      493         return error .
      494     end.
      495   find first ub.db-grp-obj-price exclusive-lock where
      496           ub.db-grp-obj-price.gop-db-num   = p-db-num  and
      497           ub.db-grp-obj-price.gop-id       = p-id      and
      498           ub.db-grp-obj-price.dgo-db-num   = p-dgo-db-num
      499           no-error .
      500         if not available ub.db-grp-obj-price then do:
      501             create ub.db-grp-obj-price.
      502               assign
      503                   ub.db-grp-obj-price.gop-db-num = p-db-num
      504                   ub.db-grp-obj-price.gop-id     = p-id
      505                   ub.db-grp-obj-price.dgo-db-num = p-dgo-db-num
      506               .
      507         end.
      508         assign
      509           ub.db-grp-obj-price.num-chg    = p-db-num-usr
      510           ub.db-grp-obj-price.stts          = p-stts
      511           ub.db-grp-obj-price.sys-date      = today
      512           ub.db-grp-obj-price.sys-time      = time
      513           ub.db-grp-obj-price.sys-time-chr  = string ( ub.db-grp-obj-price.sys-time,"hh:mm" )
      514           ub.db-grp-obj-price.who           = p-userid
      515           p-recid = recid ( ub.db-grp-obj-price )
      516         .
      517         ub.grp-obj-price.sys-time = time .
      518         run ref/h-grpo.p (buffer ub.db-grp-obj-price , input-output v-sec )  .
      519     end.
      520   end procedure.
      521   PROCEDURE obji-del :
      522   define input  parameter p-db-num       as integer   no-undo .
      523   define input  parameter p-id           as integer   no-undo .
      524   define input  parameter p-dgo-db-num   as integer   no-undo .
      525   define input  parameter p-db-num-usr   as integer   no-undo .
      526   define input  parameter p-userid       as character no-undo .
      527     do
      528     on error undo, return error return-value
      529     :
      530   find first ub.grp-obj-price exclusive-lock where
      531           ub.grp-obj-price.gop-db-num   = p-db-num  and
      532           ub.grp-obj-price.gop-id       = p-id
      533           .
      534   find first ub.db-grp-obj-price exclusive-lock where
      535           ub.db-grp-obj-price.gop-db-num   = p-db-num  and
      536           ub.db-grp-obj-price.gop-id       = p-id      and
      537           ub.db-grp-obj-price.dgo-db-num = p-dgo-db-num
      538           no-error .
      539    if not available ub.db-grp-obj-price then  return error .
      540         assign
      541           ub.db-grp-obj-price.num-chg    = p-db-num-usr
      542           ub.db-grp-obj-price.stts          = 1
      543           ub.db-grp-obj-price.sys-date      = today
      544           ub.db-grp-obj-price.sys-time      = time
      545           ub.db-grp-obj-price.sys-time-chr  = string(ub.db-grp-obj-price.sys-time,"hh:mm")
      546           ub.db-grp-obj-price.who           = p-userid
      547         .
      548         run ref/h-grpo.p (buffer ub.db-grp-obj-price , input-output v-sec )  .
      549         ub.grp-obj-price.sys-time = time .
      550     end.
      551   end procedure.
      552   PROCEDURE objf-add :
      553   define input  parameter p-db-num       as integer   no-undo .
      554   define input  parameter p-id           as integer   no-undo .
      555   define input  parameter p-host-code    as integer   no-undo .
      556   define input  parameter p-stts         as integer   no-undo .
      557   define input  parameter p-db-num-usr   as integer   no-undo .
      558   define input  parameter p-userid       as character no-undo .
      559   define output parameter p-recid as recid no-undo .
      560     do
      561     on error undo, return error return-value
      562     :
      563   find first ub.sysconf no-lock where recid(ub.sysconf) = p-host-code .
      564   if available ub.sysconf then do:
      565      p-host-code = ub.sysconf.host-code .
      566   end.
      567   find first ub.grp-obj-price exclusive-lock where
      568           ub.grp-obj-price.gop-db-num   = p-db-num  and
      569           ub.grp-obj-price.gop-id       = p-id
      570           .
      571   find first ub.host-grp-obj-price exclusive-lock where
      572           ub.host-grp-obj-price.gop-db-num   = p-db-num  and
      573           ub.host-grp-obj-price.gop-id       = p-id      and
      574           ub.host-grp-obj-price.host-code    = p-host-code
      575           no-error .
      576         if not available ub.host-grp-obj-price then do:
      577             create ub.host-grp-obj-price.
      578               assign
      579                   ub.host-grp-obj-price.gop-db-num   = p-db-num
      580                   ub.host-grp-obj-price.gop-id       = p-id
      581                   ub.host-grp-obj-price.host-code    = p-host-code
      582               .
      583         end.
      584         assign
      585           ub.host-grp-obj-price.db-num-chg    = p-db-num-usr
      586           ub.host-grp-obj-price.stts          = p-stts
      587           ub.host-grp-obj-price.sys-date      = today
      588           ub.host-grp-obj-price.sys-time      = time
      589           ub.host-grp-obj-price.sys-time-chr  = string ( ub.host-grp-obj-price.sys-time,"hh:mm" )
      590           ub.host-grp-obj-price.who           = p-userid
      591           p-recid = recid ( ub.host-grp-obj-price )
      592         .
      593         ub.grp-obj-price.sys-time = time .
      594         run ref/h-grph.p (buffer ub.host-grp-obj-price , input-output v-sec )  .
      595     end.
      596   end procedure.
      597   PROCEDURE objf-del :
      598   define input  parameter p-db-num       as integer   no-undo .
      599   define input  parameter p-id           as integer   no-undo .
      600   define input  parameter p-host-code   as integer   no-undo .
