      618   define variable Types      as ibs.th.str.cash.CashDevice no-undo.
      619   Types = new ibs.th.str.cash.CashDevice().
      620    do:
      621      define variable objType    as ibs.th.gbl.propmap no-undo.
      622      define buffer cashcode for ub.code .
      623      define buffer cashobj  for ub.code .
      624      define buffer cashgrp  for ub.code .
      625      define buffer cashkey  for ub.code .
      626      find first cashcode where cashcode.parent eq ""
      627                            and cashcode.code   eq "cash-param"
      628         exclusive-lock no-error.
      629      if not available cashcode
      630      then do:
      631         create cashcode.
      632         assign
      633             cashcode.parent   = ""
      634             cashcode.code     = "Cash-param"
      635         .
      636      end.
      637      assign
      638          cashcode.Codename = "Справочник параметров кассы"
      639          cashcode.nwsgbd   = yes
      640          cashcode.export_  = yes
      641          cashcode.procview = "ibs/th/ref/code/cashparams.p"
      642      .
      643      define variable v-ii as integer no-undo.
      644      do v-ii = 1 to Types:mapType:GetItem(v-ii):
      645         objType = Types:CurrProp.
      646         find first cashcode where cashcode.parent eq "cash-param"
      647                               and cashcode.code   eq string(objType:KeyInt)
      648         exclusive-lock no-error.
      649         if not available cashcode
      650         then do:
      651            create cashcode.
      652            assign
      653              cashcode.parent  = "cash-param"
      654              cashcode.code    = string(objType:KeyInt)
      655            .
      656         end.
      657         assign
      658            cashcode.nwsgbd  = yes
      659            cashcode.export_ = yes
      660         .
      661         cashcode.CodeName = objType:Label_.
      662         find first cashobj where cashobj.parent    = cashcode.parent + chr(4) + cashcode.code
      663                              and cashobj.code      = "1"
      664         exclusive-lock no-error.
      665         if not available cashobj
      666         then do:
      667            create cashobj.
      668            assign
      669              cashobj.parent    = cashcode.parent + chr(4) + cashcode.code
      670              cashobj.code      = "1"
      671            .
      672         end.
      673         assign
      674           cashobj.CodeName  = "Параметры"
      675           cashobj.nwsgbd    = yes
      676           cashobj.export_   = yes
      677           cashobj.procview     = "ref/cashparamg.w"
      678         .
      679         find first cashobj where cashobj.parent    = cashcode.parent + chr(4) + cashcode.code
      680                              and cashobj.code      = "2"
      681         exclusive-lock no-error.
      682         if not available cashobj
      683         then do:
      684            create cashobj.
      685            assign
      686              cashobj.parent    = cashcode.parent + chr(4) + cashcode.code
      687              cashobj.code      = "2"
      688            .
      689         end.
      690         assign
      691           cashobj.CodeName  = "Клавиатура"
      692           cashobj.nwsgbd    = yes
      693           cashobj.export_   = yes
      694           cashobj.procview     = "ref/cashparkey.w"
      695         .
      696         for each cashkey where cashkey.parent eq "CashFunKey"
      697         no-lock:
      698            find first cashgrp where cashgrp.parent    = cashobj.parent + chr(4) + cashobj.code
      699                                 and cashgrp.code      = cashkey.code
      700            exclusive-lock no-error.
      701            if not available cashgrp
      702            then do:
      703               create cashgrp.
      704               assign
      705                  cashgrp.parent    = cashobj.parent + chr(4) + cashobj.code
      706                  cashgrp.code      = cashkey.code
      707               .
      708            end.
      709            assign
      710               cashgrp.nwsgbd    = yes
      711               cashgrp.export_   = yes
      712               cashgrp.procview     = "ref/codeparam.w"
      713            .
      714         end.
      715      end.
      716   end.
      717    do:
      718      define buffer cash-desk for ub.cash-desk.
      719      for each cash-desk where cash-desk.db-num   eq g#db-num
      720                           and cash-desk.pos-type eq 'Autotank':U
      721      exclusive-lock:
      722         define variable v-attr-value as character no-undo .
      723         define variable v-attr-type  as character no-undo .
      724         define variable v-device-kind as integer no-undo.
      725         define variable v-date as date no-undo.
      726         define variable v-decimal as decimal no-undo.
      727         define variable v-logical as logical no-undo.
      728         define variable v-dop as character no-undo.
      729         if cash-desk.device-kind = 0
      730         then do:
      731            define variable mport as integer  no-undo.
      732            assign
      733            mport = ?
      734            mport = integer(entry(2
      735                                  ,entry(4
      736                                         ,entry(2, cash-desk.addr-path, chr(4))
      737                                         ,".":U)
      738                                 , ":"
      739                                 )
      740                           ) no-error.
      741            if    mport eq ?
      742               or mport eq 0
      743               or mport eq 8000
      744            then
      745               v-device-kind = Types:Tanker:KeyIntDB.
      746            else
      747               v-device-kind = Types:TankerIntegr:KeyIntDB.
      748               cash-desk.device-kind = v-device-kind .
      749         end.
      750      end.
      751   end.
      752   delete object Types.
