       85     define output parameter p-format         as character no-undo .
       86     define output parameter p-label          as character no-undo .
       87     define output parameter p-user-can-edit  as logical   no-undo .
       88     define output parameter p-output-display as logical   no-undo .
       89     define output parameter p-other          as character no-undo .
       90     define output parameter p-prop-list      as character no-undo .
       91     do
       92     on error undo, return error return-value
       93     :
       94           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr-code in g#attr-lib
