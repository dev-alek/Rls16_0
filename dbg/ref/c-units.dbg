      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      122   define new shared variable RepPathName        as character no-undo .
      123   define new shared variable PrintRubl          as logical   no-undo .
      124   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define variable v-waitfram-action01         as character   no-undo .
      126   define variable v-waitfram-action02         as character   no-undo .
      127   define variable v-waitfram-action03         as character   no-undo .
      128   define variable mWaitFramTextBeg            as character   no-undo.
      129   define variable mWaitFramTextEnd            as character   no-undo.
      130   define variable mWaitFramView               as logical     no-undo.
      131   define variable mWaitProcEvent              as logical     no-undo init yes.
      132   define variable mWaitFramInterval           as integer     no-undo init 1 .
      133   define variable mWaitFramStop               as logical     no-undo.
      134   define variable mWaitFramStopUser           as logical     no-undo.
      135   define variable mWaitFramStopTimeOut        as logical     no-undo.
      136   define variable mWaitFramStartProc          as datetime-tz no-undo.
      137   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      138   define button B-WaitFramStop auto-end-key
      139        label "Стоп"
      140        size 10 by 1 tooltip "Остоновить процесс".
      141   define button B-viewProcInfo
      142        label "Информация"
      143        size 15 by 1 tooltip "Информация о процесс".
      144   define frame waitfram
      145     v-waitfram-action01 format "x(72)" no-label skip
      146     v-waitfram-action02 format "x(72)" no-label skip
      147     v-waitfram-action03 format "x(72)" no-label skip
      148     B-viewProcInfo
      149     B-WaitFramStop at row 4 col 30
      150     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      151     .
      152   define new global shared variable mBatchMode as logical no-undo init ?.
      153   define variable mFramBachModHandle as handle no-undo.
      154   mFramBachModHandle = frame waitfram:handle.
      155   define variable mFameOldVis as logical no-undo.
      156   define variable mVisCUrentVin as logical no-undo.
      157   if session:batch-mode
      158   then
      159      mBatchMode = yes.
      160   if mBatchMode = ? then do:
      161     mVisCUrentVin = current-window:visible.
      162     mFameOldVis = mFramBachModHandle:visible.
      163     mFramBachModHandle:visible  = yes.
      164     mBatchMode = mFramBachModHandle:visible ne yes.
      165     mFramBachModHandle:visible = mFameOldVis.
      166     current-window:visible = mVisCUrentVin.
      167   end.
      168    if  log-manager:logfile-name ne ?
      169     then DO:
      170         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      171         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      172         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      173     end.
      174   on choose of B-WaitFramStop in frame waitfram
      175   do:
      176     mWaitFramStop = yes.
      177     mWaitFramStopUser = yes.
      178   end.
      179   function waitfram-check-timeout returns logical():
      180      define variable vtime as int64 no-undo.
      181      if mWaitFramStopTimeOut
      182      then
      183         return yes.
      184      vtime = ( now - mWaitFramStartProc ) / 1000 .
      185      if     mWaitFramTimeOut ne ?
      186         and mWaitFramTimeOut ne 0
      187         and mWaitFramTimeOut lt vtime
      188      then do:
      189         mWaitFramStopTimeOut = yes.
      190      end.
      191      return mWaitFramStopTimeOut.
      192   end.
      193   procedure waitfram-hide :
      194     if not session:batch-mode
      195     then do
      196     on error undo, return error return-value
      197     :
      198       pause 0 before-hide .
      199       if not mBatchMode then
      200         hide frame waitfram .
      201     if     not mWaitFramView
      202        and mWaitProcEvent
      203     then
      204       process events .
      205     end.
      206   end procedure.
      207   procedure waitfram-show :
      208     define input  parameter p-message as character no-undo .
      209     define variable v-left-margin as integer   no-undo .
      210     if not session:batch-mode
      211     then do
      212     on error undo, return error return-value
      213     :
      214       if length(p-message) <= 70 then do:
      215         assign
      216           v-left-margin = integer((70 - length(p-message)) / 2)
      217         .
      218         assign
      219           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      220         .
      221         assign
      222           v-waitfram-action01 = " "
      223           v-waitfram-action02 = " "
      224                                    + fill(" ", v-left-margin)
      225                                    + p-message
      226           v-waitfram-action03 = " "
      227         .
      228       end.
      229       else do:
      230         define variable vRindex1 as integer no-undo.
      231         define variable vRindex2 as integer no-undo.
      232         vRindex1 = r-index(p-message," ",70).
      233         if vRindex1 = 0
      234         then
      235            vRindex1 = 70.
      236         if length(p-message)  <= vRindex1 + 70 then do:
      237           assign
      238             v-waitfram-action01 = " "
      239             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      240             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      241           .
      242         end.
      243         else do:
      244           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      245           if vRindex2 <= vRindex1
      246           then
      247              vRindex2 = vRindex1 + 70.
      248           assign
      249             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      250             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      251             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      252           .
      253         end.
      254       end.
      255       B-viewProcInfo:visible   in frame waitfram = no.
      256       B-viewProcInfo:sensitive in frame waitfram = no.
      257       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      258       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      259       if  (   mWaitFramView
      260          or  mWaitProcEvent)
      261          and not mBatchMode
      262       then
      263          display
      264             v-waitfram-action01 skip
      265             v-waitfram-action02 skip
      266             v-waitfram-action03 skip
      267          with frame waitfram .
      268       if     mWaitFramView
      269          then do:
      270             if     mWaitFramInterval ne ?
      271                and not mBatchMode
      272             then
      273                wait-for go of frame waitfram pause mWaitFramInterval.
      274          end.
      275          else
      276             if     mWaitProcEvent
      277                and not mBatchMode
      278             then
      279                process events .
      280     end.
      281   end procedure.
      282      procedure waitfram-show-this:
      283         define input  parameter iInterval as int64 no-undo.
      284         define variable vtime as int64 no-undo.
      285         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      286         mWaitFramInterval = iInterval.
      287         run waitfram-show (substitute("&1&2 &3&4" ,
      288                                       mWaitFramTextBeg ,
      289                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      290                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      291                                       mWaitFramTextEnd
      292                                      )
      293                           ).
      294      end.
      295      procedure WaitFramRunPause:
      296         define input  parameter iInterval as dec no-undo.
      297         define variable vStart  as datetime-tz no-undo.
      298         define variable vend    as datetime-tz no-undo.
      299         define variable vint as int64 no-undo.
      300         define variable vOk as logical no-undo.
      301         vStart = now.
      302         vend   = vStart.
      303         publish "WaitFramPause" (iInterval,output vOk).
      304         vend   =  now.
      305         vint = vend - vStart.
      306         vint = iInterval - vint / 1000.
      307         if     not mWaitFramStop
      308            and (   vint > 0
      309                 or (    not vOk
      310                     and iInterval eq ?
      311                     )
      312                 )
      313         then
      314            run waitfram-show-this (iInterval).
      315         vend   =  now.
      316         vint = vend - vStart.
      317         vint = iInterval - vint / 1000.
      318         if     not mWaitFramStop
      319            and vint > 0
      320         then do:
      321            run gbl/pause.p (vint * 1000).
      322         end.
      323         if iInterval ne ?
      324         then
      325            publish "WaitFramStop".
      326         waitfram-check-timeout().
      327      end.
      328      procedure WaitFramWaitFor:
      329         define input  parameter iInterval as dec no-undo.
      330         assign
      331            mWaitFramStartProc   = now
      332            mWaitFramStopUser    = no
      333            mWaitFramStopTimeOut = no
      334         .
      335         block-wait:
      336         do while not mWaitFramStop:
      337            run WaitFramRunPause (iInterval).
      338            if  waitfram-check-timeout()
      339            then do:
      340               leave block-wait.
      341            end.
      342         end.
      343         run waitfram-hide.
      344      end.
      345   procedure waitfram-join :
      346     define input  parameter p-line-1  as character no-undo .
      347     define input  parameter p-line-2  as character no-undo .
      348     define input  parameter p-line-3  as character no-undo .
      349     define output parameter p-message as character no-undo .
      350     do
      351     on error undo, return error return-value
      352     :
      353       assign
      354         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      355                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      356                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      357       .
      358     end.
      359   end procedure.
      360   function waitfram-join-function returns character
      361     (input p-line-1 as character
      362     ,input p-line-2 as character
      363     ,input p-line-3 as character
      364     ).
      365     define variable v-message as character no-undo .
      366     run waitfram-join in this-procedure
      367       (input  p-line-1
      368       ,input  p-line-2
      369       ,input  p-line-3
      370       ,output v-message
      371       ) .
      372     return v-message .
      373   end function .
      374   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      375   define  stream PrnLibStream.
      376   procedure prn-lib-prn-file :
      377     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      378     define input parameter p-DIsabledoptions as integer no-undo .
      379     define variable v-report-name as character no-undo .
      380     define variable v-user-action as character no-undo .
      381     define variable v-printed     as logical   no-undo .
      382     define variable v-exist       as logical   no-undo .
      383     do
      384       on error undo, return error
      385       :
      386       run prn-lib-get-report-name  in this-procedure (
      387         input parParentProc
      388         ,output v-report-name
      389         ).
      390   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      391   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      392     (input  v-report-name
      393     ,input  2
      394     ,output v-exist
      395     )  .
      396       if NOT v-exist then
      397       DO:
      398         Message
      399           "Нет заданий на печать ! "
      400           view-as alert-box .
      401         Return  .
      402       End.
      403       run gbl/prnfilen.w
      404         (input  ""
      405         ,input  p-DisabledOptions
      406         ,input  string(v-report-name )
      407         ,input  7
      408         ,output v-user-action
      409         ,output v-printed
      410         ) .
      411       if v-printed then
      412       do:
      413         return "YES" .
      414       end.
      415       else
      416       do:
      417         return "NO" .
      418       end.
      419     end.
      420   end procedure.
      421   procedure prn-lib-open-stream :
      422     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      423     define input parameter p-page-size    as integer no-undo .
      424     define input parameter p-is-stream    as logical no-undo .
      425     define input parameter p-append       as logical no-undo .
      426     define variable v-report-name as character no-undo .
      427     do
      428       on error undo, return error
      429       :
      430       run prn-lib-get-report-name  in this-procedure (
      431         input parParentProc
      432         ,output v-report-name
      433         ).
      434       if p-is-stream then
      435       do:
      436         if p-append then
      437         do:
      438           output stream PrnLibStream to value( v-report-name )
      439             page-size value(p-page-size) append .
      440         end.
      441         if not p-append then
      442         do:
      443           output stream PrnLibStream to value( v-report-name )
      444             page-size value(p-page-size) .
      445         end.
      446       end.
      447       if not p-is-stream then
      448       do:
      449         if p-append then
      450         do:
      451           output to value( v-report-name )
      452             page-size value(p-page-size) append .
      453         end.
      454         if not p-append then
      455         do:
      456           output to value( v-report-name )
      457             page-size value(p-page-size) .
      458         end.
      459       end.
      460     end.
      461   end procedure.
      462   procedure prn-lib-open-exp :
      463     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      464     define input parameter p-is-stream    as logical no-undo .
      465     define input parameter p-is-append    as logical no-undo .
      466     define output parameter p-ReportFileName as char init "report" no-undo.
      467     define output parameter p-process as logical no-undo .
      468     define variable glog as logical no-undo .
      469     do
      470       on error undo, return error
      471       :
      472       SYSTEM-DIALOG GET-FILE p-ReportFileName
      473         TITLE      "Укажите путь"
      474         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      475         ASK-OVERWRITE
      476         CREATE-TEST-FILE
      477         SAVE-AS
      478         USE-FILENAME
      479         DEFAULT-EXTENSION "txt"
      480         UPDATE glog
      481         .
      482       if not glog then  return.
      483       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      484       if p-is-stream then
      485       do:
      486         if p-is-append then
      487         do:
      488           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      489         end.
      490         else
      491         do:
      492           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      493         end.
      494       end.
      495       else
      496       do:
      497         if p-is-append then
      498         do:
      499           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      500         end.
      501         else
      502         do:
      503           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      504         end.
      505       end.
      506       p-process = yes.
      507     end.
      508   end procedure.
      509   procedure prn-lib-get-report-name :
      510     define input parameter parParentProc  as widget-handle no-undo.
      511     define output parameter p-report-name as character no-undo .
      512     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      513   end procedure.
      514   procedure prn-lib-reportviewer-report-name :
      515     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      516     define input parameter p-report-name-html as character no-undo .
      517     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      518   end procedure.
      519   procedure prn-lib-reportviewer :
      520     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      521     define input parameter p-report-name-html as character no-undo .
      522     define input parameter p-param        as character no-undo .
      523     define variable v-excel           as character no-undo init 'TRUE' .
      524     define variable v-value-character as character no-undo .
      525     define variable v-value-integer   as character no-undo .
      526     define variable v-value-date      as date      no-undo .
      527     define variable v-value-decimal   as decimal   no-undo .
      528     define variable rep-excel         as logical   no-undo .
      529     define variable excel-string      as character no-undo .
      530     define variable v-param-type      as character no-undo .
      531     define variable v-tth             as handle    no-undo .
      532     run adm/shattri.p (
      533       input "get":U
      534       ,input  ""
      535       ,input  0
      536       ,input  'report-glob':U
      537       ,input  'rep-excel':U
      538       ,output v-value-character
      539       ,output v-value-date
      540       ,output v-value-decimal
      541       ,output v-value-integer
      542       ,output rep-excel
      543       ,output v-param-type
      544       ,INPUT-OUTPUT table-handle v-tth
      545       )  .
      546     if rep-excel then v-excel = "TRUE" .
      547     else v-excel = "FALSE" .
      548     if p-param eq ""
      549     then
      550        p-param = "EXCEL:" + v-excel.
      551     else
      552        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      553     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      554   end procedure.
      555   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      556   procedure cur-time :
      557      define output parameter p-today as date      no-undo .
      558      define output parameter p-time  as integer   no-undo .
      559     do
      560     on error undo, return error
      561     :
      562       define variable v-date1 as date      no-undo .
      563       define variable v-date2 as date      no-undo .
      564       define variable v-time  as integer   no-undo .
      565       assign
      566         v-date1 = today
      567         v-time  = time
      568         v-date2 = today
      569       .
      570       if v-date1 <> v-date2
      571       then do:
      572         assign
      573           v-date1 = today
      574           v-time  = v-time
      575         .
      576       end.
      577       assign
      578         p-today = v-date1
      579         p-time  = v-time
      580       .
      581     end.
      582   end.
      583   function cur-time-date returns character
      584   :
      585     return string(today, '99/99/9999':U) .
      586   end.
      587   function cur-time-mjd returns decimal
      588   :
      589     define variable v-date as date      no-undo .
      590     define variable v-time as integer   no-undo .
      591     run cur-time in this-procedure
      592       (output v-date
      593       ,output v-time
      594       ) .
      595     return integer(v-date) - 2400002 + (v-time / 86400) .
      596   end.
      597   function cur-time-get-ending-index returns integer
      598   (input p-number as integer
      599   )
      600   :
      601     if p-number < 0
      602     or p-number = ?
      603     then do:
      604       return 1 .
      605     end.
      606     define variable v-rest as integer   no-undo .
      607     assign
      608       p-number = p-number modulo 100
      609     .
      610     if p-number < 20
      611     then do:
      612       assign
      613         v-rest = p-number
      614       .
      615     end.
      616     else do:
      617       assign
      618         v-rest = p-number modulo 10
      619       .
      620     end.
      621     case v-rest :
      622       when 1
      623       then do:
      624         return 2 .
      625       end.
      626       when 2 or
      627       when 3 or
      628       when 4
      629       then do:
      630         return 3 .
      631       end.
      632       otherwise do:
      633         return 1 .
      634       end.
      635     end case .
      636   end.
      637   procedure cur-time-mjd-to-date :
      638      define input  parameter i-mjd-diff as decimal no-undo.
      639      define output parameter o-Date     as date    no-undo.
      640      define output parameter o-Time     as integer no-undo.
      641      define variable v-day-number as integer   no-undo .
      642      if    i-mjd-diff < 0
      643         or i-mjd-diff = ?
      644      then do:
      645         return "?" .
      646      end.
      647      assign
      648         v-day-number = truncate(i-mjd-diff,0).
      649         o-Date = date(v-day-number + 2400002).
      650         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      651     .
      652   end.
      653   function cur-time-mjd-to-string returns character
      654   (input p-mjd-diff as decimal
      655   )
      656   :
      657     define variable v-day-number as integer   no-undo .
      658     define variable v-seconds    as integer   no-undo .
      659     define variable v-hour       as integer   no-undo .
      660     define variable v-min        as integer   no-undo .
      661     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      662     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      663     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      664     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      665     if p-mjd-diff < 0
      666     or p-mjd-diff = ?
      667     then do:
      668       return "?" .
      669     end.
      670     assign
      671       v-day-number = integer(truncate(p-mjd-diff,0))
      672       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      673     .
      674     if v-seconds > 86400
      675     then do:
      676       assign
      677         v-seconds = 86400 - 1
      678       .
      679     end.
      680     if v-seconds < 0
      681     then do:
      682       assign
      683         v-seconds = 0
      684       .
      685     end.
      686     assign
      687       v-hour = truncate(v-seconds / 3600, 0)
      688     .
      689     assign
      690       v-seconds = v-seconds modulo 3600
      691     .
      692     assign
      693       v-min = truncate(v-seconds / 60, 0)
      694     .
      695     assign
      696       v-seconds = v-seconds modulo 60
      697     .
      698     return
      699         (if v-day-number <> 0
      700           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      701           else ""
      702         )
      703       + (if v-day-number <> 0 or v-hour <> 0
      704           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      705           else ""
      706         )
      707       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      708           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      709           else ""
      710         )
      711       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      712       .
      713   end.
      714   function cur-time-string returns character
      715   :
      716     define variable v-date as date      no-undo .
      717     define variable v-time as integer   no-undo .
      718     run cur-time in this-procedure
      719       (output v-date
      720       ,output v-time
      721       ) .
      722     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      723   end.
      724   function cur-time-string-sec returns character
      725   :
      726     define variable v-date as date      no-undo .
      727     define variable v-time as integer   no-undo .
      728     run cur-time in this-procedure
      729       (output v-date
      730       ,output v-time
      731       ) .
      732     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      733   end.
      734   function cur-time-custom  returns character
      735   (input p-prefix as character
      736   ,input p-date-format as character
      737   ,input p-delimiter as character
      738   ,input p-time-format as character
      739   ,input p-suffix as character
      740   )
      741   :
      742     define variable v-date as date      no-undo .
      743     define variable v-time as integer   no-undo .
      744     run cur-time in this-procedure
      745       (output v-date
      746       ,output v-time
      747       ) .
      748     return
      749       p-prefix
      750       + string(v-date, p-date-format)
      751       + p-delimiter
      752       + string(v-time, p-time-format)
      753       + p-suffix
      754       .
      755   end.
      756   function cur-time-print  returns character
      757   :
      758     define variable v-date as date      no-undo .
      759     define variable v-time as integer   no-undo .
      760     run cur-time in this-procedure
      761       (output v-date
      762       ,output v-time
      763       ) .
      764     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      765   end.
      766   function cur-time-datetime returns datetime
      767   :
      768     define variable v-char as character no-undo .
      769     define variable v-datetime as datetime no-undo .
      770     v-char = cur-time-string().
      771     v-datetime = datetime(v-char).
      772     return  v-datetime.
      773   end.
      774   function cur-time-string-msec returns character
      775   :
      776     define variable v-date as datetime  no-undo .
      777     v-date = now.
      778     return string(v-date) .
      779   end.
      780   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      781   FUNCTION mark-string RETURNS CHARACTER
      782     ( input p-recid as recid, input mark-list as character  ) :
      783     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      784   END FUNCTION.
      785   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      786   define variable sort-column-name as character no-undo .
      787   define variable v-db-num LIKE ub.db.db-num no-undo.
      788   DEFINE variable v-rid-list AS CHARACTER NO-UNDO.
      789   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      790   define  temp-table temp-changes no-undo
      791   field f_name as character
      792   field l_name as character
      793   field v_old as character
      794   field v_new as character
      795   field t_name as character
      796   field num_ as integer
      797   field uniq-key-rec as character
      798   field action as integer
      799   field fNotChange as logical
      800   index pi is unique primary
      801   num_
      802   t_name
      803   f_name
      804   index
      805   Chan
      806   fnotChange
      807   t_name
      808   f_name
      809   index imain uniq-key-rec
      810   .
      811   FUNCTION get-all-fields returns character (p-file-name as character ):
      812   define variable v-dop as character no-undo .
      813     find first _file no-lock where _file._file-name = p-file-name no-error .
      814     if not available _file then return "":U.
      815     for each _field no-lock where
      816              _field._file-recid = recid(_file) :
      817       assign
      818       v-dop = v-dop + _field._field-name + chr(44)
      819       .
      820     end.
      821     return trim(v-dop).
      822   END FUNCTION.
      823   PROCEDURE proc-full-temp-changes :
      824     define input  parameter p-hst-handle as handle    no-undo .
      825     define input  parameter p-main-table as character no-undo .
      826     define input  parameter p-field-list as character no-undo .
      827     define input  parameter p-label-form as character no-undo .
      828     define variable h-new-buf         as handle    no-undo .
      829     define variable h-main-buf        as handle    no-undo .
      830     define variable h-for-comp        as handle    no-undo .
      831     define variable v-inform          as character no-undo .
      832     define variable v-ind             as integer   no-undo .
      833     define variable v-idx-field-qnty  as integer   no-undo .
      834     define variable v-num-entries     as integer   no-undo .
      835     define variable fh                as handle    no-undo .
      836     define variable fh-main           as handle    no-undo .
      837     define variable fh-old            as handle    no-undo .
      838     define variable fh-new            as handle    no-undo .
      839     define variable v-field-name      as character no-undo .
      840     define variable v-field-lvl       as character no-undo .
      841     define variable v-field-form      as character no-undo .
      842     define variable v-search-exp      as character no-undo .
      843     define variable v-srch-main       as character no-undo .
      844     define variable v-word-link       as character no-undo .
      845     define variable v-av-chip-num     as logical   no-undo .
      846     define variable v-main-pi-fld-lst as character no-undo .
      847     define variable v-main-fld-lst    as character no-undo .
      848     define variable v-delim-list      as character no-undo .
      849     define variable v-label           as character no-undo .
      850     define variable v-old-value       as character no-undo case-sensitive.
      851     define variable v-new-value       as character no-undo case-sensitive.
      852     define variable v-chg-fields as character no-undo.
      853     for each temp-changes:
      854       delete temp-changes.
      855     end.
      856     if not p-hst-handle:available then do:
      857       return .
      858     end.
      859     create buffer h-new-buf  for table p-hst-handle .
      860     create buffer h-main-buf for table p-main-table .
      861     assign
      862       v-inform = h-main-buf:index-information(1)
      863       v-ind    = 2
      864     .
      865     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      866     on error undo, return error
      867     :
      868       assign
      869         v-inform = h-main-buf:index-information( v-ind )
      870         v-ind    = v-ind + 1
      871       .
      872     end.
      873     if v-inform = ?
      874       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      875       or entry( 3, v-inform, ",":U ) <> "1":U
      876     then do:
      877       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      878     end.
      879     assign
      880       v-idx-field-qnty = num-entries( v-inform ) - 4
      881     .
      882     if v-idx-field-qnty < 2 then do:
      883       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      884     end.
      885     assign
      886       v-srch-main   = "where":U
      887       v-word-link   = "":U
      888       v-av-chip-num = false
      889       v-delim-list  = "":U
      890     .
      891     do v-ind = 1 to v-idx-field-qnty by 2
      892     on error undo, return error
      893     :
      894       assign
      895         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      896         fh                = p-hst-handle:buffer-field( v-field-name )
      897         fh-main           = h-main-buf:buffer-field( v-field-name )
      898         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      899         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      900       .
      901       if fh:data-type ="character":U then do:
      902         assign
      903           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      904         .
      905       end.
      906       else do:
      907         assign
      908           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      909         .
      910       end.
      911       if v-delim-list = "":U then do:
      912         assign
      913           v-delim-list = ",":U
      914         .
      915       end.
      916       if v-word-link = "":U then do:
      917         assign
      918           v-word-link = "and":U
      919         .
      920       end.
      921     end.
      922     assign
      923       v-delim-list  = "":U
      924     .
      925     do v-ind = 1 to h-main-buf:num-fields
      926     on error undo, return error
      927     :
      928       assign
      929         fh-main      = h-main-buf:buffer-field( v-ind )
      930         v-field-name = fh-main:name
      931       .
      932         assign
      933           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      934         .
      935         if v-delim-list = "":U then do:
      936           assign
      937             v-delim-list = ",":U
      938           .
      939         end.
      940     end.
      941     assign
      942       v-inform = p-hst-handle:index-information(1)
      943       v-ind    = 2
      944     .
      945     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      946     on error undo, return error
      947     :
      948       assign
      949         v-inform = p-hst-handle:index-information( v-ind )
      950         v-ind    = v-ind + 1
      951       .
      952     end.
      953     if v-inform = ?
      954       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      955       or entry( 3, v-inform, ",":U ) <> "1":U
      956     then do:
      957       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      958     end.
      959     assign
      960       v-idx-field-qnty = num-entries( v-inform ) - 4
      961     .
      962     if v-idx-field-qnty < 2 then do:
      963       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      964     end.
      965     assign
      966       v-search-exp  = "where":U
      967       v-word-link   = "":U
      968       v-av-chip-num = false
      969     .
      970     do v-ind = 1 to v-idx-field-qnty by 2
      971     on error undo, return error
      972     :
      973       assign
      974         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      975         fh           = p-hst-handle:buffer-field( v-field-name )
      976         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      977       .
      978       if v-field-name = "chip-num":U then do:
      979         assign
      980           v-search-exp  = substitute( "&1 >", v-search-exp )
      981           v-av-chip-num = true
      982         .
      983       end.
      984       else do:
      985         assign
      986           v-search-exp = substitute( "&1 =", v-search-exp )
      987         .
      988       end.
      989       if fh:data-type ="character":U then do:
      990         assign
      991           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      992         .
      993       end.
      994       else do:
      995         assign
      996           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      997         .
      998       end.
      999       if v-word-link = "":U then do:
     1000         assign
     1001           v-word-link = "and":U
     1002         .
     1003       end.
     1004     end.
     1005     if v-av-chip-num = false then do:
     1006       message
     1007         vss-workfile vss-revision vss-description skip
     1008         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1009         "Использование данной процедуры невозможно!" skip
     1010         view-as alert-box error .
     1011       return error .
     1012     end.
     1013     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1014     if not h-new-buf:available then do:
     1015       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1016       if not h-main-buf:available then do:
     1017         assign
     1018           h-for-comp = ?
     1019         .
     1020       end.
     1021       else do:
     1022         assign
     1023           h-for-comp = h-main-buf
     1024         .
     1025       end.
     1026     end.
     1027     else do:
     1028       assign
     1029         h-for-comp = h-new-buf
     1030       .
     1031     end.
     1032     assign
     1033       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1034     .
     1035     do v-ind = 1 to v-num-entries
     1036     on error undo, return error return-value
     1037     :
     1038       assign
     1039         v-field-name = entry( v-ind, v-main-fld-lst )
     1040         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1041         v-old-value  = fh-old:buffer-value()
     1042         v-label      = trim( fh-old:label )
     1043       .
     1044       if ( trim( p-field-list ) <> "":U
     1045            and lookup( v-field-name, p-field-list ) > 0
     1046          )
     1047          or trim( p-field-list ) = "":U
     1048       then do:
     1049         if h-for-comp <> ? then do:
     1050           assign
     1051             fh-new      = h-for-comp:buffer-field( v-field-name )
     1052             v-new-value = fh-new:buffer-value()
     1053           .
     1054         end.
     1055         else do:
     1056           assign
     1057             v-new-value = "":U
     1058           .
     1059         end.
     1060         if v-old-value <> v-new-value
     1061         then do:
     1062           create temp-changes.
     1063           assign
     1064             temp-changes.t_name = p-main-table
     1065             temp-changes.f_name = v-field-name
     1066             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1067             temp-changes.v_old  = trim( v-old-value )
     1068             temp-changes.v_new  = trim( v-new-value )
     1069             temp-changes.num_   = 0
     1070             temp-changes.fNotChange = v-old-value eq v-new-value
     1071           .
     1072         end.
     1073       end.
     1074     end.
     1075     assign
     1076       v-num-entries = num-entries( p-label-form, chr(8) )
     1077     .
     1078     do v-ind = 1 to v-num-entries
     1079     on error undo, return error return-value
     1080     :
     1081       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1082         assign
     1083           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1084           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1085           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1086         .
     1087         find first temp-changes
     1088           where temp-changes.f_name = v-field-name
     1089           no-error .
     1090         if available temp-changes then do:
     1091           if trim( v-field-lvl ) <> "":U then do:
     1092             assign
     1093               temp-changes.l_name = v-field-lvl
     1094             .
     1095           end.
     1096           if trim( v-field-form ) <> "":U then do:
     1097             assign
     1098               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1099             .
     1100             if h-for-comp <> ? then do:
     1101               assign
     1102                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1103               .
     1104             end.
     1105           end.
     1106         end.
     1107       end.
     1108       else do:
     1109         message
     1110           vss-workfile vss-revision vss-description skip
     1111           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1112           substitute( "список для поля '&1': '&2'"
     1113                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1114                       ,entry( v-ind, p-label-form, chr(8) )
     1115                     ) skip
     1116           substitute( "полный список: &2", p-label-form ) skip
     1117           view-as alert-box error .
     1118       end.
     1119     end.
     1120     delete object h-new-buf .
     1121     delete object h-main-buf .
     1122   END PROCEDURE.
     1123   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1124   function usrfulnf returns character ( input p-user-id as character):
     1125   define variable v-user-name as character no-undo .
     1126   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1127   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1128     (input  p-user-id
     1129     ,output v-user-name
     1130     ) no-error .
     1131   if error-status:error
     1132   or v-user-name = ""
     1133   then do:
     1134     return p-user-id.
     1135   end.
     1136   else do:
     1137     return v-user-name.
     1138   end.
     1139   end function.
     1140   DEFINE BUTTON B-Help
     1141        LABEL "Помо&щь"
     1142        SIZE 3 BY 1
     1143        BGCOLOR 8 .
     1144   DEFINE BUTTON B-lookup
     1145        LABEL "&Просмотр"
     1146        SIZE 10 BY 1.
     1147   DEFINE BUTTON B-mark
     1148        LABEL "&*"
     1149        SIZE 3 BY 1.
     1150   DEFINE BUTTON b-quit AUTO-END-KEY
     1151        LABEL "&Выход"
     1152        SIZE 10 BY 1
     1153        BGCOLOR 8 .
     1154   DEFINE BUTTON B-sel AUTO-GO
     1155        LABEL "Вы&бор"
     1156        SIZE 10 BY 1.
     1157   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1158         VIEW-AS TEXT
     1159        SIZE 6 BY 1
     1160        FGCOLOR 4  NO-UNDO.
     1161   DEFINE QUERY BR-changes FOR
     1162         temp-changes SCROLLING.
     1163   DEFINE QUERY br-cunits FOR
     1164         X_c-units SCROLLING.
     1165   DEFINE BROWSE BR-changes
     1166     QUERY BR-changes DISPLAY
     1167         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1168   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1169   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1170       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.04.
     1171   DEFINE BROWSE br-cunits
     1172     QUERY br-cunits NO-LOCK DISPLAY
     1173         X_c-units.unit-name COLUMN-LABEL "Название"
     1174   X_c-units.long-name FORMAT "X(40)":U
     1175   string(X_c-units.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1176   X_c-units.corr-date COLUMN-LABEL "Дата!измен" FORMAT "99/99/9999":U
     1177   usrfulnf( X_c-units.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1178   WIDTH 18
     1179   mark-string(recid(X_c-units), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1180       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.25 FIT-LAST-COLUMN.
     1181   DEFINE FRAME Dialog-Frame
     1182        b-quit AT ROW 1 COL 1
     1183        B-mark AT ROW 1 COL 11
     1184        B-sel AT ROW 1 COL 21
     1185        B-lookup AT ROW 1 COL 61
     1186        B-Help AT ROW 1 COL 95
     1187        br-cunits AT ROW 3 COL 1
     1188        BR-changes AT ROW 13 COL 1
     1189        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1190        SPACE(78.62) SKIP(20.04)
     1191       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1192            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1193            TITLE "История единиц измерения"
     1194            CANCEL-BUTTON b-quit.
     1195   ASSIGN
     1196          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1197          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1198   ASSIGN
     1199          B-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1200   ASSIGN
     1201          br-cunits:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1202   ON GO OF FRAME Dialog-Frame
     1203   DO:
     1204     p-rid-list = v-rid-list.
     1205   END.
     1206   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1207   DO:
     1208     APPLY "END-ERROR":U TO SELF.
     1209   END.
     1210   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1211   DO:
     1212     define variable loc#log as logical no-undo .
     1213     if available X_c-units then do:
     1214   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1215   define variable v-str-recid10 as character no-undo .
     1216   define variable v-num-entry10 as integer   no-undo .
     1217   assign
     1218     v-str-recid10 = trim( string( recid( X_c-units ) , "->>>>>>>>>>>9":U ) )
     1219     v-num-entry10 = lookup( v-str-recid10 , v-rid-list )
     1220   .
     1221   if v-num-entry10 > 0 then do:
     1222     assign
     1223       entry( v-num-entry10, v-rid-list ) = "":U
     1224       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1225     .
     1226   end.
     1227   else do:
     1228     assign
     1229       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid10
     1230     .
     1231   end.
     1232       loc#log = br-cunits:refresh() .
     1233       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1234           loc#log = br-cunits:select-next-row ().
     1235           apply "VALUE-CHANGED" to br-cunits in frame Dialog-Frame.
     1236       end.
     1237       if num-entries( v-rid-list ) = 0
     1238       then
     1239           hide mark-num in frame Dialog-Frame.
     1240       else
     1241           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1242     end.
     1243     apply "entry" to br-cunits in frame Dialog-Frame.
     1244   END.
     1245   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1246   DO:
     1247       if ( available X_c-units ) then do:
     1248       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1249       then
     1250       v-rid-list = string( recid( X_c-units ) ) .
     1251     end.
     1252   END.
     1253   ON RETURN OF br-cunits IN FRAME Dialog-Frame
     1254   or MOUSE-SELECT-DBLCLICK OF br-cunits IN FRAME Dialog-Frame
     1255       DO:
     1256       run proc-br-cunits no-error.
     1257     if error-status:error then return no-apply.
     1258   END.
     1259   ON VALUE-CHANGED OF br-cunits IN FRAME Dialog-Frame
     1260   DO:
     1261     run proc-view-changes in this-procedure no-error.
     1262   END.
     1263   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1264   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1265   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1266   on help of frame Dialog-Frame
     1267   do:
     1268     run gbl/app_help.p
     1269       (input this-procedure :file-name
     1270       ,input ''
     1271       ,input ?
     1272       ) no-error.
     1273     if error-status :error then do:
     1274       message
     1275         "Ошибка при вызове помощи"
     1276         error-status :get-message(1)
     1277         view-as alert-box .
     1278     end.
     1279   end.
     1280   run minbtn-set in this-procedure .
     1281   on choose of b-help in frame Dialog-Frame
     1282   do:
     1283     apply "help":u to frame Dialog-Frame .
     1284   end.
     1285   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1286   procedure minbtn-set :
     1287       do
     1288           on error undo, return error return-value
     1289           :
     1290           define variable ii              as integer       no-undo .
     1291           define variable fh              as widget-handle no-undo .
     1292           define variable hh              as widget-handle no-undo .
     1293           define variable v-h             as handle        extent 4 no-undo .
     1294           define variable v-name-button   as character     no-undo .
     1295           define variable v-help-old-x    as decimal       no-undo .
     1296           define variable v-help-old-y    as decimal       no-undo .
     1297           define variable v-help-old-size as decimal       no-undo .
     1298           define variable v-frame-width   as decimal       no-undo .
     1299           define variable jj              as integer       no-undo .
     1300           do
     1301               on error undo, return error
     1302               :
     1303               assign
     1304                   v-frame-width = frame Dialog-Frame:width - 0.3
     1305                   fh            = frame Dialog-Frame:first-child
     1306                   hh            = fh:first-child
     1307                   ii            = 1
     1308                   .
     1309               do while valid-handle(hh):
     1310                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1311                   do:
     1312                       case lc(hh:name) :
     1313                           when "b-help" then
     1314                               do:
     1315                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1316                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1317                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1318                                   hh:TOOLTIP = "Помощь" .
     1319                                   v-help-old-x = hh:column .
     1320                                   v-help-old-y = hh:row    .
     1321                                   v-help-old-size = hh:width .
     1322                                   hh:width-chars = 2.5 .
     1323                               end.
     1324                           when "b-print" then
     1325                               do:
     1326                                   hh:load-image("cmp/b-print.bmp":u) .
     1327                                   hh:TOOLTIP = "Печать" .
     1328                                   v-h[ii] = hh:handle .
     1329                                   ii = ii + 1 .
     1330                                   hh:width-chars = 3 .
     1331                               end.
     1332                           when "b-history" or
     1333                           when "b-hist" then
     1334                               do:
     1335                                   hh:load-image("cmp/b-hist.bmp":u) .
     1336                                   hh:TOOLTIP = "История" .
     1337                                   v-h[ii] = hh:handle .
     1338                                   ii = ii + 1 .
     1339                                   hh:width-chars = 3 .
     1340                               end.
     1341                           when "b-sch" then
     1342                               do:
     1343                                   hh:load-image("cmp/b-sch.bmp":u) .
     1344                                   hh:TOOLTIP = "Установка Фильтра" .
     1345                                   v-h[ii] = hh:handle .
     1346                                   ii = ii + 1 .
     1347                                   hh:width-chars = 3 .
     1348                               end.
     1349                           when "b-hist-user" then
     1350                               do:
     1351                                   hh:load-image("cmp/b-hist.bmp":u) .
     1352                                   hh:TOOLTIP = "История пользователя" .
     1353                                   ii = ii + 1 .
     1354                               end.
     1355                       end case.
     1356                   end.
     1357                   hh = hh:next-sibling.
     1358               end.
     1359               b-help:column = v-frame-width - b-help:width-chars.
     1360               jj = 0.
     1361               repeat ii = 4 to 1 by -1 :
     1362                   if valid-handle (v-h[ii] ) then
     1363                   do:
     1364                       jj  = jj + 1 .
     1365                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1366                       v-h[ii]:row    = v-help-old-y .
     1367                   end.
     1368               end.
     1369           end.
     1370       end.
     1371   end procedure.
     1372   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1373   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1374   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1375   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1376   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1377   define variable v-diasize-current-frame-height as decimal   no-undo .
     1378   define variable v-diasize-change-size          as logical   no-undo .
     1379   define variable v-diasize-resize-button        as handle    no-undo .
     1380   define variable v-diasize-wndmax               as logical   no-undo .
     1381   define variable v-diasize-wndstore             as logical   no-undo .
     1382   define variable v-diasize-proc-name            as character no-undo .
     1383   define variable v-diasize-browse-handle        as handle    no-undo .
     1384   define variable v-diasize-browse-number        as integer   no-undo .
     1385   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1386   define temp-table temp-diasize-handle no-undo
     1387     field handle-value  as handle
     1388     field save-position as decimal
     1389     index xpk is primary unique handle-value
     1390     .
     1391   define temp-table temp-browse-handle no-undo
     1392     field browse-type   as character
     1393     field browse-number as integer
     1394     field browse-handle as handle
     1395     field original-size as decimal
     1396     index xpk is primary unique browse-type browse-number
     1397     index xie browse-type browse-handle
     1398   .
     1399   procedure diasize_change-height :
     1400     define input  parameter p-change-value  as decimal   no-undo .
     1401     define input  parameter p-move-resize   as logical   no-undo .
     1402     define variable v-field-group-handle    as handle    no-undo .
     1403     define variable v-object-handle         as handle    no-undo .
     1404     define variable v-frame-height          as decimal   no-undo .
     1405     define variable v-frame-virtual-height  as decimal   no-undo .
     1406     define variable v-browse-height         as decimal   no-undo .
     1407     define variable v-window-height         as decimal   no-undo .
     1408     define variable v-window-virtual-height as decimal   no-undo .
     1409     define variable v-change-sign           as integer   no-undo .
     1410     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1411     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1412     if p-change-value > 0
     1413     then do:
     1414       if frame Dialog-Frame :height + p-change-value
     1415           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1416       then do:
     1417         assign
     1418           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1419                           - (frame Dialog-Frame :height-chars)
     1420         .
     1421         if p-change-value <= 0
     1422         then do:
     1423           run diasize_position-resize-button in this-procedure .
     1424           return .
     1425         end.
     1426       end.
     1427     end.
     1428     if p-change-value < 0
     1429     then do:
     1430       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1431       then do:
     1432         assign
     1433           p-change-value = v-diasize-orig-frame-height
     1434                          - (frame Dialog-Frame :height-chars)
     1435         .
     1436         if p-change-value >= 0
     1437         then do:
     1438           run diasize_position-resize-button in this-procedure .
     1439           return .
     1440         end.
     1441       end.
     1442     end.
     1443     if p-change-value >= 0
     1444     then do:
     1445       assign
     1446         v-change-sign = 1
     1447       .
     1448     end.
     1449     else do:
     1450       assign
     1451         v-change-sign = -1
     1452       .
     1453     end.
     1454     assign
     1455       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1456     .
     1457     if p-change-value = 0
     1458     then do:
     1459       run diasize_position-resize-button in this-procedure .
     1460       return .
     1461     end.
     1462     move_block:
     1463     do
     1464     on error undo move_block, retry move_block
     1465     :
     1466       if retry
     1467       then do:
     1468         do
     1469         on error undo move_block, leave move_block
     1470         :
     1471           if p-change-value > 0
     1472           then do:
     1473             for each buf_temp-diasize-handle
     1474             on error undo, next
     1475             :
     1476               assign
     1477                 v-object-handle = buf_temp-diasize-handle.handle-value
     1478               .
     1479               if v-object-handle <> v-diasize-resize-button
     1480               then do:
     1481                 assign
     1482                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1483                 .
     1484               end.
     1485             end.
     1486             assign
     1487               v-diasize-browse-handle :height = v-browse-height
     1488             .
     1489             for each buf_temp-browse-handle
     1490               where buf_temp-browse-handle.browse-type = 'height':u
     1491             on error undo, next
     1492             :
     1493               assign
     1494                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1495               .
     1496             end.
     1497             assign
     1498               frame Dialog-Frame :height = v-frame-height
     1499             .
     1500             if frame Dialog-Frame :scrollable = true
     1501             then do:
     1502               assign
     1503                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1504               .
     1505             end.
     1506             run diasize_position-resize-button in this-procedure .
     1507           end.
     1508           else do:
     1509             if frame Dialog-Frame :scrollable = true
     1510             then do:
     1511               assign
     1512                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1513               .
     1514             end.
     1515             assign
     1516               frame Dialog-Frame :height = v-frame-height
     1517             .
     1518             assign
     1519               v-diasize-browse-handle :height = v-browse-height
     1520             .
     1521             for each buf_temp-browse-handle
     1522               where buf_temp-browse-handle.browse-type = 'height':u
     1523             on error undo, next
     1524             :
     1525               assign
     1526                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1527               .
     1528             end.
     1529             for each buf_temp-diasize-handle
     1530             on error undo, next
     1531             :
     1532               assign
     1533                 v-object-handle = buf_temp-diasize-handle.handle-value
     1534               .
     1535               if v-object-handle <> v-diasize-resize-button
     1536               then do:
     1537                 assign
     1538                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1539                 .
     1540               end.
     1541             end.
     1542             run diasize_position-resize-button in this-procedure .
     1543           end.
     1544           assign
     1545             v-diasize-change-size = false
     1546           .
     1547           leave move_block .
     1548         end.
     1549       end.
     1550       assign
     1551         v-diasize-need-full-display = true
     1552       .
     1553       if v-diasize-change-size = false
     1554       then do:
     1555         assign
     1556           v-diasize-change-size = true
     1557         .
     1558       end.
     1559       else do:
     1560         return .
     1561       end.
     1562       assign
     1563         v-frame-height = frame Dialog-Frame :height
     1564         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1565         v-browse-height = v-diasize-browse-handle :height
     1566       .
     1567       for each buf_temp-browse-handle
     1568         where buf_temp-browse-handle.browse-type = 'height':u
     1569       :
     1570         assign
     1571           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1572         .
     1573       end.
     1574       for each buf_temp-diasize-handle
     1575       :
     1576         delete buf_temp-diasize-handle .
     1577       end.
     1578       assign
     1579         v-field-group-handle = frame Dialog-Frame :first-child
     1580       .
     1581       do while valid-handle(v-field-group-handle)
     1582       :
     1583         assign
     1584           v-object-handle = v-field-group-handle :first-child
     1585         .
     1586         do while valid-handle(v-object-handle)
     1587         :
     1588           if  v-object-handle <> v-diasize-browse-handle :handle
     1589           and can-query(v-object-handle, "row")
     1590           and can-query(v-object-handle, "height")
     1591           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1592           then do:
     1593             find first buf_temp-browse-handle
     1594               where buf_temp-browse-handle.browse-type   = 'height':u
     1595                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1596               no-error .
     1597             if available buf_temp-browse-handle
     1598             then do:
     1599             end.
     1600             else do:
     1601               create buf_temp-diasize-handle .
     1602               assign
     1603                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1604                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1605               .
     1606             end.
     1607           end.
     1608           assign
     1609             v-object-handle = v-object-handle :next-sibling
     1610           .
     1611         end.
     1612         assign
     1613           v-field-group-handle = v-field-group-handle :next-sibling
     1614         .
     1615       end.
     1616       do with frame Dialog-Frame
     1617       :
     1618         hide v-diasize-resize-button .
     1619         assign
     1620           v-diasize-resize-button :row    = 1
     1621           v-diasize-resize-button :column = 1
     1622         .
     1623       end.
     1624       if p-change-value > 0
     1625       then do:
     1626         if frame Dialog-Frame :scrollable = true
     1627         then do:
     1628           assign
     1629             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1630             no-error .
     1631           if error-status :error
     1632           or error-status :get-message(1) <> ""
     1633           then do:
     1634             undo move_block, retry move_block .
     1635           end.
     1636         end.
     1637         assign
     1638           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1639           no-error .
     1640         if error-status :error
     1641         or error-status :get-message(1) <> ""
     1642         then do:
     1643           undo move_block, retry move_block .
     1644         end.
     1645         assign
     1646           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1647           no-error .
     1648         if error-status :error
     1649         or error-status :get-message(1) <> ""
     1650         then do:
     1651           undo move_block, retry move_block .
     1652         end.
     1653         for each buf_temp-browse-handle
     1654           where buf_temp-browse-handle.browse-type = 'height':u
     1655         on error undo move_block, retry move_block
     1656         :
     1657           assign
     1658             buf_temp-browse-handle.browse-handle :height
     1659               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1660             no-error .
     1661           if error-status :error
     1662           or error-status :get-message(1) <> ""
     1663           then do:
     1664             undo move_block, retry move_block .
     1665           end.
     1666         end.
     1667         for each buf_temp-diasize-handle
     1668         on error undo move_block, retry move_block
     1669         :
     1670           assign
     1671             v-object-handle = buf_temp-diasize-handle.handle-value
     1672           .
     1673           if v-object-handle <> v-diasize-resize-button
     1674           then do:
     1675             assign
     1676               v-object-handle :row = v-object-handle :row + p-change-value
     1677               no-error .
     1678             if error-status :error
     1679             or error-status :get-message(1) <> ""
     1680             then do:
     1681               undo move_block, retry move_block .
     1682             end.
     1683           end.
     1684         end.
     1685       end.
     1686       else do:
     1687         for each buf_temp-diasize-handle
     1688         on error undo move_block, retry move_block
     1689         :
     1690           assign
     1691             v-object-handle = buf_temp-diasize-handle.handle-value
     1692           .
     1693           if v-object-handle <> v-diasize-resize-button
     1694           then do:
     1695             assign
     1696               v-object-handle :row = v-object-handle :row + p-change-value
     1697               no-error .
     1698             if error-status :error
     1699             or error-status :get-message(1) <> ""
     1700             then do:
     1701               undo move_block, retry move_block .
     1702             end.
     1703           end.
     1704         end.
     1705         assign
     1706           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1707           no-error .
     1708         if error-status :error
     1709         or error-status :get-message(1) <> ""
     1710         then do:
     1711           undo move_block, retry move_block .
     1712         end.
     1713         for each buf_temp-browse-handle
     1714           where buf_temp-browse-handle.browse-type = 'height':u
     1715         on error undo move_block, retry move_block
     1716         :
     1717           assign
     1718             buf_temp-browse-handle.browse-handle :height
     1719               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1720             no-error .
     1721           if error-status :error
     1722           or error-status :get-message(1) <> ""
     1723           then do:
     1724             undo move_block, retry move_block .
     1725           end.
     1726         end.
     1727         assign
     1728           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1729           no-error .
     1730         if error-status :error
     1731         or error-status :get-message(1) <> ""
     1732         then do:
     1733           undo move_block, retry move_block .
     1734         end.
     1735         if frame Dialog-Frame :scrollable = true
     1736         then do:
     1737           assign
     1738             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1739             no-error .
     1740           if error-status :error
     1741           or error-status :get-message(1) <> ""
     1742           then do:
     1743             undo move_block, retry move_block .
     1744           end.
     1745         end.
     1746       end.
     1747       if p-move-resize = true
     1748       then do:
     1749         run diasize_position-resize-button in this-procedure .
     1750       end.
     1751       if v-diasize-wndstore = true
     1752       then do:
     1753         if connected("ub") = true
     1754         then do:
     1755           define variable v-cntxt-db-num        as integer   no-undo .
     1756           define variable v-cntxt-userid        as character no-undo .
     1757           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1758                                             , OUTPUT v-cntxt-userid
     1759                                             ) .
     1760           run gbl/wndsizew.p
     1761             (input  v-cntxt-db-num
     1762             ,input  v-cntxt-userid
     1763             ,input  v-diasize-proc-name
     1764             ,input  'height':u
     1765             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1766             ) .
     1767         end.
     1768       end.
     1769     end.
     1770     assign
     1771       v-diasize-change-size = false
     1772     .
     1773   end procedure.
     1774   procedure diasize_set-height :
     1775     define input  parameter p-new-height  as decimal   no-undo .
     1776     define input  parameter p-move-resize as logical   no-undo .
     1777     do
     1778     on error undo, return error return-value
     1779     :
     1780       run diasize_change-height in this-procedure
     1781         (input  (p-new-height - frame Dialog-Frame :height)
     1782         ,input  p-move-resize
     1783         ) .
     1784     end.
     1785   end procedure.
     1786   procedure diasize_change-width :
     1787     define input  parameter p-change-value as decimal   no-undo .
     1788     define input  parameter p-move-resize  as logical   no-undo .
     1789     define variable v-field-group-handle   as handle    no-undo .
     1790     define variable v-object-handle        as handle    no-undo .
     1791     define variable v-frame-width          as decimal   no-undo .
     1792     define variable v-frame-virtual-width  as decimal   no-undo .
     1793     define variable v-browse-width         as decimal   no-undo .
     1794     define variable v-window-width         as decimal   no-undo .
     1795     define variable v-window-virtual-width as decimal   no-undo .
     1796     define variable v-change-sign          as integer   no-undo .
     1797     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1798     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1799     if p-change-value > 0
     1800     then do:
     1801       if frame Dialog-Frame :width + p-change-value >
     1802           session :width-chars
     1803       then do:
     1804         assign
     1805           p-change-value = session :width-chars - frame Dialog-Frame :width
     1806         .
     1807         if p-change-value <= 0
     1808         then do:
     1809           run diasize_position-resize-button in this-procedure .
     1810           return .
     1811         end.
     1812       end.
     1813     end.
     1814     if p-change-value < 0
     1815     then do:
     1816       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1817       then do:
     1818         assign
     1819           p-change-value = v-diasize-orig-frame-width
     1820                          - frame Dialog-Frame :width
     1821         .
     1822         if p-change-value >= 0
     1823         then do:
     1824           run diasize_position-resize-button in this-procedure .
     1825           return .
     1826         end.
     1827       end.
     1828     end.
     1829     if p-change-value >= 0
     1830     then do:
     1831       assign
     1832         v-change-sign = 1
     1833       .
     1834     end.
     1835     else do:
     1836       assign
     1837         v-change-sign = -1
     1838       .
     1839     end.
     1840     assign
     1841       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1842     .
     1843     if p-change-value = 0
     1844     then do:
     1845       run diasize_position-resize-button in this-procedure .
     1846       return .
     1847     end.
     1848     move_block:
     1849     do
     1850     on error undo move_block, leave move_block
     1851     :
     1852       if retry
     1853       then do:
     1854         do
     1855         on error undo move_block, leave move_block
     1856         :
     1857           if p-change-value > 0
     1858           then do:
     1859             for each buf_temp-diasize-handle
     1860             on error undo, next
     1861             :
     1862               assign
     1863                 v-object-handle = buf_temp-diasize-handle.handle-value
     1864               .
     1865               if v-object-handle <> v-diasize-resize-button
     1866               then do:
     1867                 assign
     1868                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1869                 .
     1870               end.
     1871             end.
     1872             assign
     1873               v-diasize-browse-handle :width = v-browse-width
     1874             .
     1875             for each buf_temp-browse-handle
     1876               where buf_temp-browse-handle.browse-type = 'width':u
     1877             on error undo, next
     1878             :
     1879               assign
     1880                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1881               .
     1882             end.
     1883             assign
     1884               frame Dialog-Frame :width = v-frame-width
     1885             .
     1886             if frame Dialog-Frame :scrollable = true
     1887             then do:
     1888               assign
     1889                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1890               .
     1891             end.
     1892             run diasize_position-resize-button in this-procedure .
     1893           end.
     1894           else do:
     1895             if frame Dialog-Frame :scrollable = true
     1896             then do:
     1897               assign
     1898                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1899               .
     1900             end.
     1901             assign
     1902               frame Dialog-Frame :width = v-frame-width
     1903             .
     1904             for each buf_temp-browse-handle
     1905               where buf_temp-browse-handle.browse-type = 'width':u
     1906             on error undo, next
     1907             :
     1908               assign
     1909                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1910               .
     1911             end.
     1912             assign
     1913               v-diasize-browse-handle :width = v-browse-width
     1914             .
     1915             for each buf_temp-diasize-handle
     1916             on error undo, next
     1917             :
     1918               assign
     1919                 v-object-handle = buf_temp-diasize-handle.handle-value
     1920               .
     1921               if v-object-handle <> v-diasize-resize-button
     1922               then do:
     1923                 assign
     1924                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1925                 .
     1926               end.
     1927             end.
     1928             run diasize_position-resize-button in this-procedure .
     1929           end.
     1930           assign
     1931             v-diasize-change-size = false
     1932           .
     1933           leave move_block .
     1934         end.
     1935       end.
     1936       assign
     1937         v-diasize-need-full-display = true
     1938       .
     1939       if v-diasize-change-size = false
     1940       then do:
     1941         assign
     1942           v-diasize-change-size = true
     1943         .
     1944       end.
     1945       else do:
     1946         return .
     1947       end.
     1948       assign
     1949         v-frame-width = frame Dialog-Frame :width
     1950         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1951         v-browse-width = v-diasize-browse-handle :width
     1952       .
     1953       for each buf_temp-browse-handle
     1954         where buf_temp-browse-handle.browse-type = 'width':u
     1955       :
     1956         assign
     1957           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1958         .
     1959       end.
     1960       for each buf_temp-diasize-handle
     1961       :
     1962         delete buf_temp-diasize-handle .
     1963       end.
     1964       assign
     1965         v-field-group-handle = frame Dialog-Frame :first-child
     1966       .
     1967       do while valid-handle(v-field-group-handle)
     1968       :
     1969         assign
     1970           v-object-handle = v-field-group-handle :first-child
     1971         .
     1972         do while valid-handle(v-object-handle)
     1973         :
     1974           if  v-object-handle <> v-diasize-browse-handle :handle
     1975           and v-object-handle <> v-diasize-resize-button
     1976           and can-query(v-object-handle, "row")
     1977           and can-query(v-object-handle, "height")
     1978           and ( v-object-handle :col + v-object-handle :width
     1979                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1980               )
     1981           then do:
     1982             find first buf_temp-browse-handle
     1983               where buf_temp-browse-handle.browse-type   = 'width':u
     1984                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1985               no-error .
     1986             if available buf_temp-browse-handle
     1987             then do:
     1988             end.
     1989             else do:
     1990               create buf_temp-diasize-handle .
     1991               assign
     1992                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1993                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1994               .
     1995             end.
     1996           end.
     1997           assign
     1998             v-object-handle = v-object-handle :next-sibling
     1999           .
     2000         end.
     2001         assign
     2002           v-field-group-handle = v-field-group-handle :next-sibling
     2003         .
     2004       end.
     2005       do with frame Dialog-Frame
     2006       :
     2007         hide v-diasize-resize-button .
     2008         v-diasize-resize-button :row = 1.
     2009         v-diasize-resize-button :column = 1.
     2010       end.
     2011       if p-change-value > 0
     2012       then do:
     2013         if frame Dialog-Frame :scrollable = true
     2014         then do:
     2015           assign
     2016             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2017             no-error .
     2018           if error-status :error
     2019           or error-status :get-message(1) <> ""
     2020           then do:
     2021             undo move_block, retry move_block.
     2022           end.
     2023         end.
     2024         assign
     2025           frame Dialog-Frame :width = v-frame-width + p-change-value
     2026           no-error .
     2027         if error-status :error
     2028         or error-status :get-message(1) <> ""
     2029         then do:
     2030           undo move_block, retry move_block.
     2031         end.
     2032         assign
     2033           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2034         no-error .
     2035         if error-status :error
     2036         or error-status :get-message(1) <> ""
     2037         then do:
     2038           undo move_block, retry move_block.
     2039         end.
     2040         for each buf_temp-browse-handle
     2041           where buf_temp-browse-handle.browse-type = 'width':u
     2042         on error undo move_block, retry move_block
     2043         :
     2044           assign
     2045             buf_temp-browse-handle.browse-handle :width
     2046               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2047             no-error .
     2048           if error-status :error
     2049           or error-status :get-message(1) <> ""
     2050           then do:
     2051             undo move_block, retry move_block .
     2052           end.
     2053         end.
     2054         for each buf_temp-diasize-handle
     2055         on error undo move_block, retry move_block
     2056         :
     2057           assign
     2058             v-object-handle = buf_temp-diasize-handle.handle-value
     2059           .
     2060           if v-object-handle <> v-diasize-resize-button
     2061           then do:
     2062             assign
     2063               v-object-handle :col = v-object-handle :col + p-change-value
     2064               no-error .
     2065             if error-status :error
     2066             or error-status :get-message(1) <> ""
     2067             then do:
     2068               undo move_block, retry move_block .
     2069             end.
     2070           end.
     2071         end.
     2072       end.
     2073       else do:
     2074         for each buf_temp-diasize-handle
     2075         on error undo move_block, retry move_block
     2076         :
     2077           assign
     2078             v-object-handle = buf_temp-diasize-handle.handle-value
     2079           .
     2080           if v-object-handle <> v-diasize-resize-button
     2081           then do:
     2082             assign
     2083               v-object-handle :col = v-object-handle :col + p-change-value
     2084               no-error .
     2085             if error-status :error
     2086             or error-status :get-message(1) <> ""
     2087             then do:
     2088               undo move_block, retry move_block .
     2089             end.
     2090           end.
     2091         end.
     2092         for each buf_temp-browse-handle
     2093           where buf_temp-browse-handle.browse-type = 'width':u
     2094         on error undo move_block, retry move_block
     2095         :
     2096           assign
     2097             buf_temp-browse-handle.browse-handle :width
     2098               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2099             no-error .
     2100           if error-status :error
     2101           or error-status :get-message(1) <> ""
     2102           then do:
     2103             undo move_block, retry move_block .
     2104           end.
     2105         end.
     2106         assign
     2107           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2108           no-error .
     2109         if error-status :error
     2110         or error-status :get-message(1) <> ""
     2111         then do:
     2112           undo move_block, retry move_block.
     2113         end.
     2114         assign
     2115           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2116         no-error .
     2117         if error-status :error
     2118         or error-status :get-message(1) <> ""
     2119         then do:
     2120           undo move_block, retry move_block.
     2121         end.
     2122         if frame Dialog-Frame :scrollable = true
     2123         then do:
     2124           assign
     2125             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2126           no-error .
     2127           if error-status :error
     2128           or error-status :get-message(1) <> ""
     2129           then do:
     2130             undo move_block, retry move_block.
     2131           end.
     2132         end.
     2133       end.
     2134       if p-move-resize
     2135       then do:
     2136         run diasize_position-resize-button in this-procedure .
     2137       end.
     2138       if v-diasize-wndstore = true
     2139       then do:
     2140         if connected("ub") = true
     2141         then do:
     2142           define variable v-cntxt-db-num        as integer   no-undo .
     2143           define variable v-cntxt-userid        as character no-undo .
     2144           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2145                                             , OUTPUT v-cntxt-userid
     2146                                             ) .
     2147           run gbl/wndsizew.p
     2148             (input  v-cntxt-db-num
     2149             ,input  v-cntxt-userid
     2150             ,input  v-diasize-proc-name
     2151             ,input  'width':u
     2152             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2153             ) .
     2154         end.
     2155       end.
     2156     end.
     2157     assign
     2158       v-diasize-change-size = false
     2159     .
     2160   end procedure.
     2161   procedure diasize_set-width :
     2162     define input  parameter p-new-width  as decimal   no-undo .
     2163     define input  parameter p-move-resize as logical   no-undo .
     2164     do
     2165     on error undo, return error return-value
     2166     :
     2167       run diasize_change-width in this-procedure
     2168         (input  (p-new-width - frame Dialog-Frame :width)
     2169         ,input  p-move-resize
     2170         ) .
     2171     end.
     2172   end procedure.
     2173   procedure diasize_position-resize-button :
     2174     do with frame Dialog-Frame
     2175     :
     2176       hide v-diasize-resize-button .
     2177       assign
     2178         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2179                     - 1
     2180                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2181         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2182                     - 1
     2183                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2184       .
     2185       view v-diasize-resize-button .
     2186     end.
     2187   end procedure.
     2188   on alt-right anywhere
     2189   do:
     2190     run diasize_change-width in this-procedure
     2191       (input 1
     2192       ,input true
     2193       ) .
     2194     return no-apply .
     2195   end.
     2196   on alt-left anywhere
     2197   do:
     2198     run diasize_change-width in this-procedure
     2199       (input -1
     2200       ,input true
     2201       ) .
     2202     return no-apply .
     2203   end.
     2204   on alt-down anywhere
     2205   do:
     2206     run diasize_change-height in this-procedure
     2207       (input 1
     2208       ,input true
     2209       ) .
     2210     return no-apply .
     2211   end.
     2212   on alt-up anywhere
     2213   do:
     2214     run diasize_change-height in this-procedure
     2215       (input -1
     2216       ,input true
     2217       ) .
     2218     return no-apply .
     2219   end.
     2220   on alt-enter of frame Dialog-Frame
     2221   do:
     2222     run diasize_maximize in this-procedure
     2223       (input  ?
     2224       ).
     2225     return no-apply .
     2226   end.
     2227   procedure diasize_end-move :
     2228     do
     2229     on error undo, return error return-value
     2230     :
     2231       define variable v-row-delta as decimal   no-undo .
     2232       define variable v-col-delta as decimal   no-undo .
     2233       define variable v-new-row as decimal   no-undo .
     2234       define variable v-new-col as decimal   no-undo .
     2235       assign
     2236         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2237         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2238       .
     2239       assign
     2240         v-row-delta = v-new-row - frame Dialog-Frame :height
     2241         v-col-delta = v-new-col - frame Dialog-Frame :width
     2242       .
     2243       run diasize_change-height in this-procedure
     2244         (input v-row-delta
     2245         ,input true
     2246         ) .
     2247       run diasize_change-width in this-procedure
     2248         (input v-col-delta
     2249         ,input true
     2250         ) .
     2251     end.
     2252   end procedure.
     2253   procedure diasize_maximize :
     2254     define input  parameter p-action as logical   no-undo .
     2255     do
     2256     on error undo, return error return-value
     2257     :
     2258       if p-action = ?
     2259       then do:
     2260         if v-diasize-need-maximize = true
     2261         then do:
     2262           assign
     2263             p-action = true
     2264           .
     2265         end.
     2266         else do:
     2267           assign
     2268             p-action = false
     2269           .
     2270         end.
     2271       end.
     2272       if p-action = true
     2273       then do:
     2274         run diasize_change-height in this-procedure
     2275           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2276               - frame Dialog-Frame :height-chars
     2277           ,input true
     2278           ) .
     2279         run diasize_change-width in this-procedure
     2280           (input session :width-chars
     2281               - frame Dialog-Frame :width-chars
     2282           ,input true
     2283           ) .
     2284         assign
     2285           v-diasize-need-maximize = false
     2286         .
     2287       end.
     2288       else do:
     2289         run diasize_change-width in this-procedure
     2290           (input v-diasize-orig-frame-width
     2291               - frame Dialog-Frame :width-chars
     2292           ,input true
     2293           ) .
     2294         run diasize_change-height in this-procedure
     2295           (input v-diasize-orig-frame-height
     2296               - frame Dialog-Frame :height-chars
     2297           ,input true
     2298           ) .
     2299         assign
     2300           v-diasize-need-maximize = true
     2301         .
     2302       end.
     2303     end.
     2304   end procedure.
     2305   procedure diasize_restore-orig-size :
     2306     do
     2307     on error undo, return error return-value
     2308     :
     2309       assign
     2310         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2311         v-diasize-current-frame-height = frame Dialog-Frame :height
     2312       .
     2313       run diasize_set-height in this-procedure
     2314         (input  v-diasize-orig-frame-height
     2315         ,input  true
     2316         ) .
     2317       run diasize_set-width in this-procedure
     2318         (input  v-diasize-orig-frame-width
     2319         ,input  true
     2320         ) .
     2321     end.
     2322   end procedure.
     2323   procedure diasize_restore-current-size :
     2324     do
     2325     on error undo, return error return-value
     2326     :
     2327       run diasize_set-height in this-procedure
     2328         (input  v-diasize-current-frame-height
     2329         ,input  true
     2330         ) .
     2331       run diasize_set-width in this-procedure
     2332         (input  v-diasize-current-frame-width
     2333         ,input  true
     2334         ) .
     2335     end.
     2336   end procedure.
     2337   procedure diasize_set-browse-handle :
     2338     define input  parameter p-browse-handle as handle   no-undo .
     2339     define buffer buf_temp-browse-handle for temp-browse-handle .
     2340     do
     2341     on error undo, return error return-value
     2342     :
     2343       assign
     2344         v-diasize-browse-handle = p-browse-handle
     2345       .
     2346       for each buf_temp-browse-handle
     2347       on error undo, return error return-value
     2348       :
     2349         delete buf_temp-browse-handle .
     2350       end.
     2351     end.
     2352   end procedure.
     2353   procedure diasize_add_browse :
     2354     define input  parameter p-browse-type   as character no-undo .
     2355     define input  parameter p-browse-handle as handle    no-undo .
     2356     define buffer buf_temp-browse-handle for temp-browse-handle .
     2357     do
     2358     on error undo, return error return-value
     2359     :
     2360       assign
     2361         v-diasize-browse-number = v-diasize-browse-number + 1
     2362       .
     2363       create buf_temp-browse-handle .
     2364       assign
     2365         buf_temp-browse-handle.browse-type   = p-browse-type
     2366         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2367         buf_temp-browse-handle.browse-handle = p-browse-handle
     2368       .
     2369     end.
     2370   end procedure.
     2371   procedure diasize_init :
     2372     define variable v-default-value    as logical   no-undo .
     2373     define variable v-restore-saved    as logical   no-undo .
     2374     define variable v-resize-value-str as character no-undo .
     2375     do
     2376     on error undo, return error return-value
     2377     :
     2378       do with frame Dialog-Frame
     2379       :
     2380         assign
     2381           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2382           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2383           v-diasize-browse-handle     = browse br-cunits :handle
     2384         .
     2385         create button v-diasize-resize-button
     2386         assign
     2387           parent        = frame Dialog-Frame :first-child
     2388           label         = "s"
     2389           height-pixels = 16
     2390           width-pixels  = 16
     2391           visible       = true
     2392           sensitive     = true
     2393           movable       = true
     2394           triggers:
     2395             on end-move persistent run diasize_end-move in this-procedure .
     2396           end triggers.
     2397         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2398         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2399         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2400         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2401         assign
     2402           v-diasize-wndmax = false
     2403         .
     2404         if connected("ub") = true
     2405         then do:
     2406           define variable v-cntxt-db-num        as integer   no-undo .
     2407           define variable v-cntxt-userid        as character no-undo .
     2408           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2409                                             , OUTPUT v-cntxt-userid
     2410                                             ) .
     2411           run gbl/wndpar_r.p
     2412             (input  v-cntxt-db-num
     2413             ,input  v-cntxt-userid
     2414             ,input  'wndmax':U
     2415             ,output v-diasize-wndmax
     2416             ,output v-default-value
     2417             ) .
     2418         end.
     2419         assign
     2420           v-diasize-wndstore = false
     2421         .
     2422         if connected("ub") = true
     2423         then do:
     2424           run gbl/wndpar_r.p
     2425             (input  v-cntxt-db-num
     2426             ,input  v-cntxt-userid
     2427             ,input  'wndstore':U
     2428             ,output v-diasize-wndstore
     2429             ,output v-default-value
     2430             ) .
     2431         end.
     2432         assign
     2433           v-diasize-proc-name = entry(1, program-name(2), '.')
     2434         .
     2435         if v-diasize-wndstore = true
     2436         then do:
     2437           assign
     2438             v-restore-saved = false
     2439           .
     2440           if connected("ub") = true
     2441           then do:
     2442             run gbl/wndsizer.p
     2443               (input  v-cntxt-db-num
     2444               ,input  v-cntxt-userid
     2445               ,input  v-diasize-proc-name
     2446               ,input  'height':u
     2447               ,output v-resize-value-str
     2448               ) .
     2449             if v-resize-value-str <> '':U
     2450             then do:
     2451               run diasize_change-height in this-procedure
     2452                 (input  integer(v-resize-value-str)
     2453                 ,input  true
     2454                 ) .
     2455               assign
     2456                 v-restore-saved = true
     2457               .
     2458             end.
     2459           end.
     2460           if connected("ub") = true
     2461           then do:
     2462             run gbl/wndsizer.p
     2463               (input  v-cntxt-db-num
     2464               ,input  v-cntxt-userid
     2465               ,input  v-diasize-proc-name
     2466               ,input  'width':u
     2467               ,output v-resize-value-str
     2468               ) .
     2469             if v-resize-value-str <> '':U
     2470             then do:
     2471               run diasize_change-width in this-procedure
     2472                 (input  integer(v-resize-value-str)
     2473                 ,input  true
     2474                 ) .
     2475               assign
     2476                 v-restore-saved = true
     2477               .
     2478             end.
     2479           end.
     2480           if v-restore-saved <> true
     2481           then do:
     2482             if v-diasize-wndmax = true
     2483             then do:
     2484               run diasize_maximize in this-procedure
     2485                 (input  true
     2486                 ) .
     2487             end.
     2488           end.
     2489         end.
     2490         else do:
     2491           if v-diasize-wndmax = true
     2492           then do:
     2493             run diasize_maximize in this-procedure
     2494               (input  true
     2495               ) .
     2496           end.
     2497         end.
     2498       end.
     2499     end.
     2500   end procedure.
     2501   procedure diasize_need-full-display :
     2502     define output parameter p-need-full-display as logical   no-undo .
     2503     do
     2504     on error undo, return error return-value
     2505     :
     2506       assign
     2507         p-need-full-display = v-diasize-need-full-display
     2508       .
     2509       assign
     2510         v-diasize-need-full-display = false
     2511       .
     2512     end.
     2513   end procedure.
     2514   procedure get-context :
     2515      define output parameter p-db-num as integer          no-undo.
     2516      define output parameter p-user-id as character        no-undo.
     2517      define variable v-login               as character    no-undo.
     2518      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2519      define buffer buf_user-login  for ub.user-login .
     2520      do
     2521      on error undo, return error
     2522      :
     2523            FIND FIRST buf_sys-ctrl no-lock.
     2524            ASSIGN
     2525               v-login = USERID("ub")
     2526               p-db-num = buf_sys-ctrl.db-num
     2527            .
     2528            FIND FIRST buf_user-login
     2529                 WHERE buf_user-login.db-num = p-db-num
     2530                   AND buf_user-login.user-login = v-login
     2531                 no-lock
     2532                 no-error
     2533                 .
     2534            IF AVAILABLE buf_user-login
     2535            THEN DO:
     2536               assign
     2537                  p-user-id = buf_user-login.user-id
     2538               .
     2539            END.
     2540      end.
     2541   end procedure.
     2542   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2543   on f5 of frame Dialog-Frame anywhere
     2544   do:
     2545     v-doc-rec = recid(X_units). run openbr in this-procedure. reposition br-cunits to recid v-doc-rec no-error.               apply 'value-changed' to br-cunits.
     2546       apply "VALUE-CHANGED" to BR-changes.
     2547   end.
     2548   def var sort-labelbr-cunits   as character no-undo .
     2549   def var sort-clmnbr-cunits    as handle    no-undo .
     2550   def var cur-clmnbr-cunits     as handle    no-undo .
     2551   def var cur-clmn-locbr-cunits as integer   no-undo .
     2552   def var re-querybr-cunits     as logical   initial no no-undo .
     2553   on start-search, ctrl-o of br-cunits in frame Dialog-Frame do:
     2554      run sort-brbr-cunits
     2555        (input (if available temp-changes
     2556                then recid(temp-changes)
     2557                else ?
     2558               )
     2559        ).
     2560   end.
     2561   PROCEDURE sort-brbr-cunits :
     2562     define input parameter p-recid as recid no-undo .
     2563     if re-querybr-cunits = no then do:
     2564       assign
     2565          cur-clmnbr-cunits = br-cunits:current-column in frame Dialog-Frame
     2566       .
     2567       if sort-clmnbr-cunits <> ? then sort-clmnbr-cunits:column-fgcolor = 0.
     2568       if cur-clmnbr-cunits = sort-clmnbr-cunits then do:
     2569         assign
     2570            sort-labelbr-cunits = ""
     2571            sort-clmnbr-cunits = ?
     2572         .
     2573        end.
     2574        else do:
     2575          assign
     2576            sort-labelbr-cunits = cur-clmnbr-cunits:label
     2577            sort-clmnbr-cunits  = cur-clmnbr-cunits
     2578            sort-clmnbr-cunits:column-fgcolor = 4
     2579          .
     2580        end.
     2581      end.
     2582     assign
     2583       cur-clmn-locbr-cunits = 1
     2584     .
     2585     def var column-handle as handle no-undo .
     2586     column-handle = br-cunits:first-column.
     2587     do while valid-handle(column-handle) :
     2588       if column-handle = cur-clmnbr-cunits then do:
     2589         leave .
     2590       end.
     2591       column-handle = column-handle:NEXT-COLUMN.
     2592       assign
     2593         cur-clmn-locbr-cunits = cur-clmn-locbr-cunits + 1
     2594       .
     2595     end.
     2596     case sort-labelbr-cunits:
     2597           when X_c-units.unit-name:label in browse br-cunits then DO:   assign     sort-column-name = "X_c-units.unit-name"   .   run OpenBr.   . END.
     2598           when X_c-units.corr-date:label in browse br-cunits then DO:   assign     sort-column-name = "X_c-units.corr-date"   .   run OpenBr.   . END.
     2599       otherwise do:
     2600         assign
     2601           sort-column-name = ""
     2602         .
     2603         run OpenBr.
     2604           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-cunits') then do:
     2605             run mv-brw-defaultbr-cunits.
     2606           end.
     2607         if sort-labelbr-cunits <> "" then do:
     2608           assign
     2609             cur-clmnbr-cunits:column-fgcolor = 0
     2610           .
     2611         end.
     2612         assign
     2613           cur-clmn-locbr-cunits = ?
     2614         .
     2615       end.
     2616     end case.
     2617       if cur-clmn-locbr-cunits <> ? then do:
     2618         if can-do( this-procedure:internal-entries, 'ch-clmnbr-cunits') then do:
     2619           run ch-clmnbr-cunits in this-procedure (cur-clmn-locbr-cunits).
     2620         end.
     2621       end.
     2622     if p-recid <> ? then do:
     2623       reposition br-cunits to recid p-recid no-error.
     2624       apply "value-changed" to br-cunits in frame Dialog-Frame.
     2625     end.
     2626     apply "entry" to br-cunits in frame Dialog-Frame.
     2627   END PROCEDURE.
     2628   procedure re-open-query-srt-clmnbr-cunits:
     2629   if cur-clmnbr-cunits = ? then do:
     2630      run OpenBr.
     2631   end.
     2632   else do:
     2633      assign re-querybr-cunits = yes.
     2634      run sort-brbr-cunits
     2635        (input (if available temp-changes
     2636                then recid(temp-changes)
     2637                else ?
     2638               )
     2639        ).
     2640      assign re-querybr-cunits = no.
     2641   end.
     2642   end.
     2643   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2644   do:
     2645     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2646   end.
     2647   MAIN-BLOCK:
     2648   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2649      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2650    if LOOKUP(p-mode, 'one':U,
     2651                   chr(4)) = 0
     2652        then dO:
     2653       message
     2654       vss-workfile vss-revision vss-description skip
     2655       "Неверное значение параметров вызова p-mode"
     2656       p-mode
     2657       view-as alert-box ERROR.
     2658       return error .
     2659    end.
     2660    if p-mode = "one":U then do:
     2661     find first X_units no-lock where
     2662                   X_units.unit-name = p-unit-name no-error.
     2663       if not available X_units then do:
     2664           message
     2665           vss-workfile vss-revision vss-description skip
     2666           "Неверное значение параметра вызова p-unit-name"
     2667           p-unit-name
     2668           view-as alert-box ERROR.
     2669           return.
     2670       end.
     2671     end.
     2672     v-rid-list = p-rid-list.
     2673   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2674   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2675     (output v-db-num
     2676     )  .
     2677     RUN MyEnable.
     2678     RUn OpenBR.
     2679     HIDE mark-num in frame Dialog-Frame .
     2680     if v-doc-rec <> ? then
     2681     REPOSITION br-cunits to recid v-doc-rec No-ERROR.
     2682   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2683   DEF VAR cur-clmn-numbr-cunits as INT EXTENT 6 no-undo.
     2684   DEF VAR varmvibr-cunits       as INT no-undo.
     2685   DEF VAR varmvjbr-cunits       as INT no-undo.
     2686   DEF VAR varmvkbr-cunits       as INT no-undo.
     2687   DEF VAR varmvlbr-cunits       as INT no-undo.
     2688   DEF VAR move-elementbr-cunits as INT no-undo.
     2689   def var jjbr-cunits           as int no-undo.
     2690   do varmvibr-cunits = 1 to EXTENT(cur-clmn-numbr-cunits):
     2691     ASSIGN cur-clmn-numbr-cunits[varmvibr-cunits] = varmvibr-cunits.
     2692   END.
     2693   RUN start-mv-clmnbr-cunits.
     2694   PROCEDURE start-mv-clmnbr-cunits:
     2695   def var old-session as logical no-undo.
     2696      old-session = SESSION:IMMEDIATE-DISPLAY.
     2697      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2698          IF  p-mode = 'one'  THEN DO:
     2699      DO jjbr-cunits = NUM-ENTRIES('1,2,3,4,5,6') TO 1 BY -1:
     2700        RUN re-move-clmnbr-cunits ( cur-clmn-numbr-cunits[INTEGER(ENTRY (jjbr-cunits, '1,2,3,4,5,6'))] , 1).
     2701      END.
     2702          END.
     2703      SESSION:IMMEDIATE-DISPLAY = old-session.
     2704   END.
     2705   ON ctrl-cursor-right OF BROWSE br-cunits do:
     2706     RUN re-move-clmnbr-cunits ( 1, 6).
     2707   END.
     2708   ON ctrl-cursor-left OF BROWSE br-cunits do:
     2709     RUN re-move-clmnbr-cunits (6, 1).
     2710   END.
     2711   PROCEDURE re-move-clmnbr-cunits:
     2712     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2713     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2714     DO varmvibr-cunits = 1 TO EXTENT(cur-clmn-numbr-cunits):
     2715       if cur-clmn-numbr-cunits[varmvibr-cunits] = source-column THEN cur-clmn-numbr-cunits[varmvibr-cunits] = -1.
     2716     END.
     2717     if br-cunits:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2718     if source-column > target-column THEN
     2719     DO varmvjbr-cunits = source-column - 1 to target-column BY -1:
     2720       DO varmvibr-cunits = 1 TO EXTENT(cur-clmn-numbr-cunits):
     2721           if cur-clmn-numbr-cunits[varmvibr-cunits] = varmvjbr-cunits THEN DO:
     2722             cur-clmn-numbr-cunits[varmvibr-cunits] = cur-clmn-numbr-cunits[varmvibr-cunits] + 1.
     2723           END.
     2724       END.
     2725     END.
     2726     ELSE
     2727     DO varmvjbr-cunits = source-column + 1 to target-column:
     2728       DO varmvibr-cunits = 1 TO EXTENT(cur-clmn-numbr-cunits):
     2729         if cur-clmn-numbr-cunits[varmvibr-cunits] = varmvjbr-cunits THEN DO:
     2730           cur-clmn-numbr-cunits[varmvibr-cunits] = cur-clmn-numbr-cunits[varmvibr-cunits] - 1.
     2731         END.
     2732       END.
     2733     END.
     2734     DO varmvibr-cunits = 1 TO EXTENT(cur-clmn-numbr-cunits):
     2735       if cur-clmn-numbr-cunits[varmvibr-cunits] = -1 THEN cur-clmn-numbr-cunits[varmvibr-cunits] = target-column.
     2736     END.
     2737   END PROCEDURE.
     2738   PROCEDURE ch-clmnbr-cunits:
     2739     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2740     if cur-clmn-loc <= 1 then do:
     2741       return .
     2742     end.
     2743     DO varmvibr-cunits = 1 TO EXTENT(cur-clmn-numbr-cunits):
     2744       if cur-clmn-numbr-cunits[varmvibr-cunits] = cur-clmn-loc THEN move-elementbr-cunits = varmvibr-cunits.
     2745     END.
     2746     RUN re-move-clmnbr-cunits (cur-clmn-loc, 1).
     2747   END PROCEDURE.
     2748   PROCEDURE mv-brw-defaultbr-cunits:
     2749   def var old-session as logical no-undo.
     2750     old-session = SESSION:IMMEDIATE-DISPLAY.
     2751     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2752     do varmvlbr-cunits = 1 to EXTENT(cur-clmn-numbr-cunits):
     2753       RUN re-move-clmnbr-cunits (cur-clmn-numbr-cunits[varmvlbr-cunits], varmvlbr-cunits).
     2754     END.
     2755     RUN start-mv-clmnbr-cunits.
     2756     SESSION:IMMEDIATE-DISPLAY = old-session.
     2757   END PROCEDURE.
     2758   .
     2759    run diasize_add_browse in this-procedure
     2760       (input  'width':u
     2761       ,input  browse br-changes :handle
     2762       ) .
     2763    run diasize_init in this-procedure .
     2764   WAIT-FOR GO OF FRAME Dialog-Frame.
     2765   END.
     2766   RUN disable_UI.
     2767   PROCEDURE disable_UI :
     2768     HIDE FRAME Dialog-Frame.
     2769   END PROCEDURE.
     2770   PROCEDURE enable_UI :
     2771     DISPLAY mark-num
     2772         WITH FRAME Dialog-Frame.
     2773     ENABLE b-quit B-mark B-sel B-Help br-cunits BR-changes mark-num
     2774         WITH FRAME Dialog-Frame.
     2775     VIEW FRAME Dialog-Frame.
     2776     OPEN QUERY br-cunits FOR EACH X_c-units NO-LOCK INDEXED-REPOSITION.
     2777   END PROCEDURE.
     2778   PROCEDURE MyEnable :
     2779   assign
     2780   temp-changes.l_name:resizable in browse br-changes = true
     2781   temp-changes.v_old:resizable in browse br-changes = true
     2782   temp-changes.v_new:resizable in browse br-changes = true
     2783   temp-changes.l_name:width in browse br-changes = 30
     2784   temp-changes.v_old:width in browse br-changes = 40
     2785   temp-changes.v_new:width in browse br-changes = 40
     2786   .
     2787   DISPLAY mark-num
     2788   WITH FRAME Dialog-Frame.
     2789   ENABLE
     2790   b-quit
     2791   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2792   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2793   B-Help
     2794   br-cunits mark-num
     2795   br-changes
     2796   with FRAME Dialog-Frame.
     2797   VIEW FRAME Dialog-Frame.
     2798   END PROCEDURE.
     2799   PROCEDURE OpenBr :
     2800   OPEN QUERY br-cunits FOR EACH X_c-units NO-LOCK where
     2801                                  X_c-units.unit-name = p-unit-name
     2802                                 INDEXED-REPOSITION.
     2803   APPLY "VALUE-CHANGED" TO br-cunits in frame Dialog-Frame.
     2804   APPLY "ENTRY" TO br-cunits.
     2805   END PROCEDURE.
     2806   PROCEDURE proc-br-cunits :
     2807   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2808   if b-sel:sensitive in frame Dialog-Frame then dO:
     2809       if b-mark:sensitive then do:
     2810           apply "choose" to b-mark in frame Dialog-Frame.
     2811       end.
     2812       else do:
     2813           apply "choose" to b-sel in frame Dialog-Frame.
     2814       end.
     2815   end.
     2816   else do:
     2817       if b-lookup:sensitive then
     2818       apply "choose" to b-lookup in frame Dialog-Frame.
     2819   end.
     2820   END PROCEDURE.
     2821   PROCEDURE proc-view-changes :
     2822   for each temp-changes:
     2823       delete temp-changes.
     2824   END.
     2825   if not available X_c-units then do:
     2826     Open QUery br-changes for each temp-changes.
     2827     return.
     2828   end.
     2829   define variable v-label-param as character no-undo .
     2830   v-label-param =
     2831     "unit-name" + chr(4) + "Название" + chr(4) + "" + chr(8)
     2832    + "OKEI" + chr(4) + "ОКЕИ" + chr(4) + "" + chr(8)
     2833    + "type" + chr(4) + "Тип" + chr(4) + "" + chr(8)
     2834    + "long-name" + chr(4) + "Длинное названи" + chr(4) + ""  .
     2835    run proc-full-temp-changes in this-procedure (
     2836                                                input  buffer X_c-units:handle
     2837                                               ,input  'units':U
     2838                                               ,input  "unit-name,OKEI,type,long-name"
     2839                                               ,input  v-label-param).
     2840   Open QUery br-changes for each temp-changes.
     2841   END PROCEDURE.
