     1510   define temp-table temp-browse-handle no-undo
     1511     field browse-type   as character
     1512     field browse-number as integer
     1513     field browse-handle as handle
     1514     field original-size as decimal
     1515     index xpk is primary unique browse-type browse-number
     1516     index xie browse-type browse-handle
     1517   .
     1518   procedure diasize_change-height :
     1519     define input  parameter p-change-value  as decimal   no-undo .
     1520     define input  parameter p-move-resize   as logical   no-undo .
     1521     define variable v-field-group-handle    as handle    no-undo .
     1522     define variable v-object-handle         as handle    no-undo .
     1523     define variable v-frame-height          as decimal   no-undo .
     1524     define variable v-frame-virtual-height  as decimal   no-undo .
     1525     define variable v-browse-height         as decimal   no-undo .
     1526     define variable v-window-height         as decimal   no-undo .
     1527     define variable v-window-virtual-height as decimal   no-undo .
     1528     define variable v-change-sign           as integer   no-undo .
     1529     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1530     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1531     if p-change-value > 0
     1532     then do:
     1533       if frame Dialog-Frame :height + p-change-value
     1534           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1535       then do:
     1536         assign
     1537           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1538                           - (frame Dialog-Frame :height-chars)
     1539         .
     1540         if p-change-value <= 0
     1541         then do:
     1542           run diasize_position-resize-button in this-procedure .
     1543           return .
     1544         end.
     1545       end.
     1546     end.
     1547     if p-change-value < 0
     1548     then do:
     1549       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1550       then do:
     1551         assign
     1552           p-change-value = v-diasize-orig-frame-height
     1553                          - (frame Dialog-Frame :height-chars)
     1554         .
     1555         if p-change-value >= 0
     1556         then do:
     1557           run diasize_position-resize-button in this-procedure .
     1558           return .
     1559         end.
     1560       end.
     1561     end.
     1562     if p-change-value >= 0
     1563     then do:
     1564       assign
     1565         v-change-sign = 1
     1566       .
     1567     end.
     1568     else do:
     1569       assign
     1570         v-change-sign = -1
     1571       .
     1572     end.
     1573     assign
     1574       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1575     .
     1576     if p-change-value = 0
     1577     then do:
     1578       run diasize_position-resize-button in this-procedure .
     1579       return .
     1580     end.
     1581     move_block:
     1582     do
     1583     on error undo move_block, retry move_block
     1584     :
     1585       if retry
     1586       then do:
     1587         do
     1588         on error undo move_block, leave move_block
     1589         :
     1590           if p-change-value > 0
     1591           then do:
     1592             for each buf_temp-diasize-handle
     1593             on error undo, next
     1594             :
     1595               assign
     1596                 v-object-handle = buf_temp-diasize-handle.handle-value
     1597               .
     1598               if v-object-handle <> v-diasize-resize-button
     1599               then do:
     1600                 assign
     1601                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1602                 .
     1603               end.
     1604             end.
     1605             assign
     1606               v-diasize-browse-handle :height = v-browse-height
     1607             .
     1608             for each buf_temp-browse-handle
     1609               where buf_temp-browse-handle.browse-type = 'height':u
     1610             on error undo, next
     1611             :
     1612               assign
     1613                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1614               .
     1615             end.
     1616             assign
     1617               frame Dialog-Frame :height = v-frame-height
     1618             .
     1619             if frame Dialog-Frame :scrollable = true
     1620             then do:
     1621               assign
     1622                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1623               .
     1624             end.
     1625             run diasize_position-resize-button in this-procedure .
     1626           end.
     1627           else do:
     1628             if frame Dialog-Frame :scrollable = true
     1629             then do:
     1630               assign
     1631                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1632               .
     1633             end.
     1634             assign
     1635               frame Dialog-Frame :height = v-frame-height
     1636             .
     1637             assign
     1638               v-diasize-browse-handle :height = v-browse-height
     1639             .
     1640             for each buf_temp-browse-handle
     1641               where buf_temp-browse-handle.browse-type = 'height':u
     1642             on error undo, next
     1643             :
     1644               assign
     1645                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1646               .
     1647             end.
     1648             for each buf_temp-diasize-handle
     1649             on error undo, next
     1650             :
     1651               assign
     1652                 v-object-handle = buf_temp-diasize-handle.handle-value
     1653               .
     1654               if v-object-handle <> v-diasize-resize-button
     1655               then do:
     1656                 assign
     1657                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1658                 .
     1659               end.
     1660             end.
     1661             run diasize_position-resize-button in this-procedure .
     1662           end.
     1663           assign
     1664             v-diasize-change-size = false
     1665           .
     1666           leave move_block .
     1667         end.
     1668       end.
     1669       assign
     1670         v-diasize-need-full-display = true
     1671       .
     1672       if v-diasize-change-size = false
     1673       then do:
     1674         assign
     1675           v-diasize-change-size = true
     1676         .
     1677       end.
     1678       else do:
     1679         return .
     1680       end.
     1681       assign
     1682         v-frame-height = frame Dialog-Frame :height
     1683         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1684         v-browse-height = v-diasize-browse-handle :height
     1685       .
     1686       for each buf_temp-browse-handle
     1687         where buf_temp-browse-handle.browse-type = 'height':u
     1688       :
     1689         assign
     1690           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1691         .
     1692       end.
     1693       for each buf_temp-diasize-handle
     1694       :
     1695         delete buf_temp-diasize-handle .
     1696       end.
     1697       assign
     1698         v-field-group-handle = frame Dialog-Frame :first-child
     1699       .
     1700       do while valid-handle(v-field-group-handle)
     1701       :
     1702         assign
     1703           v-object-handle = v-field-group-handle :first-child
     1704         .
     1705         do while valid-handle(v-object-handle)
     1706         :
     1707           if  v-object-handle <> v-diasize-browse-handle :handle
     1708           and can-query(v-object-handle, "row")
     1709           and can-query(v-object-handle, "height")
     1710           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1711           then do:
     1712             find first buf_temp-browse-handle
     1713               where buf_temp-browse-handle.browse-type   = 'height':u
     1714                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1715               no-error .
     1716             if available buf_temp-browse-handle
     1717             then do:
     1718             end.
     1719             else do:
     1720               create buf_temp-diasize-handle .
     1721               assign
     1722                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1723                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1724               .
     1725             end.
     1726           end.
     1727           assign
     1728             v-object-handle = v-object-handle :next-sibling
     1729           .
     1730         end.
     1731         assign
     1732           v-field-group-handle = v-field-group-handle :next-sibling
     1733         .
     1734       end.
     1735       do with frame Dialog-Frame
     1736       :
     1737         hide v-diasize-resize-button .
     1738         assign
     1739           v-diasize-resize-button :row    = 1
     1740           v-diasize-resize-button :column = 1
     1741         .
     1742       end.
     1743       if p-change-value > 0
     1744       then do:
     1745         if frame Dialog-Frame :scrollable = true
     1746         then do:
     1747           assign
     1748             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1749             no-error .
     1750           if error-status :error
     1751           or error-status :get-message(1) <> ""
     1752           then do:
     1753             undo move_block, retry move_block .
     1754           end.
     1755         end.
     1756         assign
     1757           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1758           no-error .
     1759         if error-status :error
     1760         or error-status :get-message(1) <> ""
     1761         then do:
     1762           undo move_block, retry move_block .
     1763         end.
     1764         assign
     1765           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1766           no-error .
     1767         if error-status :error
     1768         or error-status :get-message(1) <> ""
     1769         then do:
     1770           undo move_block, retry move_block .
     1771         end.
     1772         for each buf_temp-browse-handle
     1773           where buf_temp-browse-handle.browse-type = 'height':u
     1774         on error undo move_block, retry move_block
     1775         :
     1776           assign
     1777             buf_temp-browse-handle.browse-handle :height
     1778               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1779             no-error .
     1780           if error-status :error
     1781           or error-status :get-message(1) <> ""
     1782           then do:
     1783             undo move_block, retry move_block .
     1784           end.
     1785         end.
     1786         for each buf_temp-diasize-handle
     1787         on error undo move_block, retry move_block
     1788         :
     1789           assign
     1790             v-object-handle = buf_temp-diasize-handle.handle-value
     1791           .
     1792           if v-object-handle <> v-diasize-resize-button
     1793           then do:
     1794             assign
     1795               v-object-handle :row = v-object-handle :row + p-change-value
     1796               no-error .
     1797             if error-status :error
     1798             or error-status :get-message(1) <> ""
     1799             then do:
     1800               undo move_block, retry move_block .
     1801             end.
     1802           end.
     1803         end.
     1804       end.
     1805       else do:
     1806         for each buf_temp-diasize-handle
     1807         on error undo move_block, retry move_block
     1808         :
     1809           assign
     1810             v-object-handle = buf_temp-diasize-handle.handle-value
     1811           .
     1812           if v-object-handle <> v-diasize-resize-button
     1813           then do:
     1814             assign
     1815               v-object-handle :row = v-object-handle :row + p-change-value
     1816               no-error .
     1817             if error-status :error
     1818             or error-status :get-message(1) <> ""
     1819             then do:
     1820               undo move_block, retry move_block .
     1821             end.
     1822           end.
     1823         end.
     1824         assign
     1825           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1826           no-error .
     1827         if error-status :error
     1828         or error-status :get-message(1) <> ""
     1829         then do:
     1830           undo move_block, retry move_block .
     1831         end.
     1832         for each buf_temp-browse-handle
     1833           where buf_temp-browse-handle.browse-type = 'height':u
     1834         on error undo move_block, retry move_block
     1835         :
     1836           assign
     1837             buf_temp-browse-handle.browse-handle :height
     1838               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1839             no-error .
     1840           if error-status :error
     1841           or error-status :get-message(1) <> ""
     1842           then do:
     1843             undo move_block, retry move_block .
     1844           end.
     1845         end.
     1846         assign
     1847           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1848           no-error .
     1849         if error-status :error
     1850         or error-status :get-message(1) <> ""
     1851         then do:
     1852           undo move_block, retry move_block .
     1853         end.
     1854         if frame Dialog-Frame :scrollable = true
     1855         then do:
     1856           assign
     1857             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1858             no-error .
     1859           if error-status :error
     1860           or error-status :get-message(1) <> ""
     1861           then do:
     1862             undo move_block, retry move_block .
     1863           end.
     1864         end.
     1865       end.
     1866       if p-move-resize = true
     1867       then do:
     1868         run diasize_position-resize-button in this-procedure .
     1869       end.
     1870       if v-diasize-wndstore = true
     1871       then do:
     1872         if connected("ub") = true
     1873         then do:
     1874           define variable v-cntxt-db-num        as integer   no-undo .
     1875           define variable v-cntxt-userid        as character no-undo .
     1876           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1877                                             , OUTPUT v-cntxt-userid
     1878                                             ) .
     1879           run gbl/wndsizew.p
     1880             (input  v-cntxt-db-num
     1881             ,input  v-cntxt-userid
     1882             ,input  v-diasize-proc-name
     1883             ,input  'height':u
     1884             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1885             ) .
     1886         end.
     1887       end.
     1888     end.
     1889     assign
     1890       v-diasize-change-size = false
     1891     .
     1892   end procedure.
     1893   procedure diasize_set-height :
     1894     define input  parameter p-new-height  as decimal   no-undo .
     1895     define input  parameter p-move-resize as logical   no-undo .
     1896     do
     1897     on error undo, return error return-value
     1898     :
     1899       run diasize_change-height in this-procedure
     1900         (input  (p-new-height - frame Dialog-Frame :height)
     1901         ,input  p-move-resize
     1902         ) .
     1903     end.
     1904   end procedure.
     1905   procedure diasize_change-width :
     1906     define input  parameter p-change-value as decimal   no-undo .
     1907     define input  parameter p-move-resize  as logical   no-undo .
     1908     define variable v-field-group-handle   as handle    no-undo .
     1909     define variable v-object-handle        as handle    no-undo .
     1910     define variable v-frame-width          as decimal   no-undo .
     1911     define variable v-frame-virtual-width  as decimal   no-undo .
     1912     define variable v-browse-width         as decimal   no-undo .
     1913     define variable v-window-width         as decimal   no-undo .
     1914     define variable v-window-virtual-width as decimal   no-undo .
     1915     define variable v-change-sign          as integer   no-undo .
     1916     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1917     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1918     if p-change-value > 0
     1919     then do:
     1920       if frame Dialog-Frame :width + p-change-value >
     1921           session :width-chars
     1922       then do:
     1923         assign
     1924           p-change-value = session :width-chars - frame Dialog-Frame :width
     1925         .
     1926         if p-change-value <= 0
     1927         then do:
     1928           run diasize_position-resize-button in this-procedure .
     1929           return .
     1930         end.
     1931       end.
     1932     end.
     1933     if p-change-value < 0
     1934     then do:
     1935       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1936       then do:
     1937         assign
     1938           p-change-value = v-diasize-orig-frame-width
     1939                          - frame Dialog-Frame :width
     1940         .
     1941         if p-change-value >= 0
     1942         then do:
     1943           run diasize_position-resize-button in this-procedure .
     1944           return .
     1945         end.
     1946       end.
     1947     end.
     1948     if p-change-value >= 0
     1949     then do:
     1950       assign
     1951         v-change-sign = 1
     1952       .
     1953     end.
     1954     else do:
     1955       assign
     1956         v-change-sign = -1
     1957       .
     1958     end.
     1959     assign
     1960       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1961     .
     1962     if p-change-value = 0
     1963     then do:
     1964       run diasize_position-resize-button in this-procedure .
     1965       return .
     1966     end.
     1967     move_block:
     1968     do
     1969     on error undo move_block, leave move_block
     1970     :
     1971       if retry
     1972       then do:
     1973         do
     1974         on error undo move_block, leave move_block
     1975         :
     1976           if p-change-value > 0
     1977           then do:
     1978             for each buf_temp-diasize-handle
     1979             on error undo, next
     1980             :
     1981               assign
     1982                 v-object-handle = buf_temp-diasize-handle.handle-value
     1983               .
     1984               if v-object-handle <> v-diasize-resize-button
     1985               then do:
     1986                 assign
     1987                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1988                 .
     1989               end.
     1990             end.
     1991             assign
     1992               v-diasize-browse-handle :width = v-browse-width
     1993             .
     1994             for each buf_temp-browse-handle
     1995               where buf_temp-browse-handle.browse-type = 'width':u
     1996             on error undo, next
     1997             :
     1998               assign
     1999                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2000               .
     2001             end.
     2002             assign
     2003               frame Dialog-Frame :width = v-frame-width
     2004             .
     2005             if frame Dialog-Frame :scrollable = true
     2006             then do:
     2007               assign
     2008                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2009               .
     2010             end.
     2011             run diasize_position-resize-button in this-procedure .
     2012           end.
     2013           else do:
     2014             if frame Dialog-Frame :scrollable = true
     2015             then do:
     2016               assign
     2017                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2018               .
     2019             end.
     2020             assign
     2021               frame Dialog-Frame :width = v-frame-width
     2022             .
     2023             for each buf_temp-browse-handle
     2024               where buf_temp-browse-handle.browse-type = 'width':u
     2025             on error undo, next
     2026             :
     2027               assign
     2028                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2029               .
     2030             end.
     2031             assign
     2032               v-diasize-browse-handle :width = v-browse-width
     2033             .
     2034             for each buf_temp-diasize-handle
     2035             on error undo, next
     2036             :
     2037               assign
     2038                 v-object-handle = buf_temp-diasize-handle.handle-value
     2039               .
     2040               if v-object-handle <> v-diasize-resize-button
     2041               then do:
     2042                 assign
     2043                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2044                 .
     2045               end.
     2046             end.
     2047             run diasize_position-resize-button in this-procedure .
     2048           end.
     2049           assign
     2050             v-diasize-change-size = false
     2051           .
     2052           leave move_block .
     2053         end.
     2054       end.
     2055       assign
     2056         v-diasize-need-full-display = true
     2057       .
     2058       if v-diasize-change-size = false
     2059       then do:
     2060         assign
     2061           v-diasize-change-size = true
     2062         .
     2063       end.
     2064       else do:
     2065         return .
     2066       end.
     2067       assign
     2068         v-frame-width = frame Dialog-Frame :width
     2069         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2070         v-browse-width = v-diasize-browse-handle :width
     2071       .
     2072       for each buf_temp-browse-handle
     2073         where buf_temp-browse-handle.browse-type = 'width':u
     2074       :
     2075         assign
     2076           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2077         .
     2078       end.
     2079       for each buf_temp-diasize-handle
     2080       :
     2081         delete buf_temp-diasize-handle .
     2082       end.
     2083       assign
     2084         v-field-group-handle = frame Dialog-Frame :first-child
     2085       .
     2086       do while valid-handle(v-field-group-handle)
     2087       :
     2088         assign
     2089           v-object-handle = v-field-group-handle :first-child
     2090         .
     2091         do while valid-handle(v-object-handle)
     2092         :
     2093           if  v-object-handle <> v-diasize-browse-handle :handle
     2094           and v-object-handle <> v-diasize-resize-button
     2095           and can-query(v-object-handle, "row")
     2096           and can-query(v-object-handle, "height")
     2097           and ( v-object-handle :col + v-object-handle :width
     2098                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2099               )
     2100           then do:
     2101             find first buf_temp-browse-handle
     2102               where buf_temp-browse-handle.browse-type   = 'width':u
     2103                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2104               no-error .
     2105             if available buf_temp-browse-handle
     2106             then do:
     2107             end.
     2108             else do:
     2109               create buf_temp-diasize-handle .
     2110               assign
     2111                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2112                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2113               .
     2114             end.
     2115           end.
     2116           assign
     2117             v-object-handle = v-object-handle :next-sibling
     2118           .
     2119         end.
     2120         assign
     2121           v-field-group-handle = v-field-group-handle :next-sibling
     2122         .
     2123       end.
     2124       do with frame Dialog-Frame
     2125       :
     2126         hide v-diasize-resize-button .
     2127         v-diasize-resize-button :row = 1.
     2128         v-diasize-resize-button :column = 1.
     2129       end.
     2130       if p-change-value > 0
     2131       then do:
     2132         if frame Dialog-Frame :scrollable = true
     2133         then do:
     2134           assign
     2135             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2136             no-error .
     2137           if error-status :error
     2138           or error-status :get-message(1) <> ""
     2139           then do:
     2140             undo move_block, retry move_block.
     2141           end.
     2142         end.
     2143         assign
     2144           frame Dialog-Frame :width = v-frame-width + p-change-value
     2145           no-error .
     2146         if error-status :error
     2147         or error-status :get-message(1) <> ""
     2148         then do:
     2149           undo move_block, retry move_block.
     2150         end.
     2151         assign
     2152           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2153         no-error .
     2154         if error-status :error
     2155         or error-status :get-message(1) <> ""
     2156         then do:
     2157           undo move_block, retry move_block.
     2158         end.
     2159         for each buf_temp-browse-handle
     2160           where buf_temp-browse-handle.browse-type = 'width':u
     2161         on error undo move_block, retry move_block
     2162         :
     2163           assign
     2164             buf_temp-browse-handle.browse-handle :width
     2165               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2166             no-error .
     2167           if error-status :error
     2168           or error-status :get-message(1) <> ""
     2169           then do:
     2170             undo move_block, retry move_block .
     2171           end.
     2172         end.
     2173         for each buf_temp-diasize-handle
     2174         on error undo move_block, retry move_block
     2175         :
     2176           assign
     2177             v-object-handle = buf_temp-diasize-handle.handle-value
     2178           .
     2179           if v-object-handle <> v-diasize-resize-button
     2180           then do:
     2181             assign
     2182               v-object-handle :col = v-object-handle :col + p-change-value
     2183               no-error .
     2184             if error-status :error
     2185             or error-status :get-message(1) <> ""
     2186             then do:
     2187               undo move_block, retry move_block .
     2188             end.
     2189           end.
     2190         end.
     2191       end.
     2192       else do:
     2193         for each buf_temp-diasize-handle
     2194         on error undo move_block, retry move_block
     2195         :
     2196           assign
     2197             v-object-handle = buf_temp-diasize-handle.handle-value
     2198           .
     2199           if v-object-handle <> v-diasize-resize-button
     2200           then do:
     2201             assign
     2202               v-object-handle :col = v-object-handle :col + p-change-value
     2203               no-error .
     2204             if error-status :error
     2205             or error-status :get-message(1) <> ""
     2206             then do:
     2207               undo move_block, retry move_block .
     2208             end.
     2209           end.
     2210         end.
     2211         for each buf_temp-browse-handle
     2212           where buf_temp-browse-handle.browse-type = 'width':u
     2213         on error undo move_block, retry move_block
     2214         :
     2215           assign
     2216             buf_temp-browse-handle.browse-handle :width
     2217               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2218             no-error .
     2219           if error-status :error
     2220           or error-status :get-message(1) <> ""
     2221           then do:
     2222             undo move_block, retry move_block .
     2223           end.
     2224         end.
     2225         assign
     2226           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2227           no-error .
     2228         if error-status :error
     2229         or error-status :get-message(1) <> ""
     2230         then do:
     2231           undo move_block, retry move_block.
     2232         end.
     2233         assign
     2234           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2235         no-error .
     2236         if error-status :error
     2237         or error-status :get-message(1) <> ""
     2238         then do:
     2239           undo move_block, retry move_block.
     2240         end.
     2241         if frame Dialog-Frame :scrollable = true
     2242         then do:
     2243           assign
     2244             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2245           no-error .
     2246           if error-status :error
     2247           or error-status :get-message(1) <> ""
     2248           then do:
     2249             undo move_block, retry move_block.
     2250           end.
     2251         end.
     2252       end.
     2253       if p-move-resize
     2254       then do:
     2255         run diasize_position-resize-button in this-procedure .
     2256       end.
     2257       if v-diasize-wndstore = true
     2258       then do:
     2259         if connected("ub") = true
     2260         then do:
     2261           define variable v-cntxt-db-num        as integer   no-undo .
     2262           define variable v-cntxt-userid        as character no-undo .
     2263           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2264                                             , OUTPUT v-cntxt-userid
     2265                                             ) .
     2266           run gbl/wndsizew.p
     2267             (input  v-cntxt-db-num
     2268             ,input  v-cntxt-userid
     2269             ,input  v-diasize-proc-name
     2270             ,input  'width':u
     2271             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2272             ) .
     2273         end.
     2274       end.
     2275     end.
     2276     assign
     2277       v-diasize-change-size = false
     2278     .
     2279   end procedure.
     2280   procedure diasize_set-width :
     2281     define input  parameter p-new-width  as decimal   no-undo .
     2282     define input  parameter p-move-resize as logical   no-undo .
     2283     do
     2284     on error undo, return error return-value
     2285     :
     2286       run diasize_change-width in this-procedure
     2287         (input  (p-new-width - frame Dialog-Frame :width)
     2288         ,input  p-move-resize
     2289         ) .
     2290     end.
     2291   end procedure.
     2292   procedure diasize_position-resize-button :
     2293     do with frame Dialog-Frame
     2294     :
     2295       hide v-diasize-resize-button .
     2296       assign
     2297         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2298                     - 1
     2299                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2300         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2301                     - 1
     2302                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2303       .
     2304       view v-diasize-resize-button .
     2305     end.
     2306   end procedure.
     2307   on alt-right anywhere
     2308   do:
     2309     run diasize_change-width in this-procedure
     2310       (input 1
     2311       ,input true
     2312       ) .
     2313     return no-apply .
     2314   end.
     2315   on alt-left anywhere
     2316   do:
     2317     run diasize_change-width in this-procedure
     2318       (input -1
     2319       ,input true
     2320       ) .
     2321     return no-apply .
     2322   end.
     2323   on alt-down anywhere
     2324   do:
     2325     run diasize_change-height in this-procedure
     2326       (input 1
     2327       ,input true
     2328       ) .
     2329     return no-apply .
     2330   end.
     2331   on alt-up anywhere
     2332   do:
     2333     run diasize_change-height in this-procedure
     2334       (input -1
     2335       ,input true
     2336       ) .
     2337     return no-apply .
     2338   end.
     2339   on alt-enter of frame Dialog-Frame
     2340   do:
     2341     run diasize_maximize in this-procedure
     2342       (input  ?
     2343       ).
     2344     return no-apply .
     2345   end.
     2346   procedure diasize_end-move :
     2347     do
     2348     on error undo, return error return-value
     2349     :
     2350       define variable v-row-delta as decimal   no-undo .
     2351       define variable v-col-delta as decimal   no-undo .
     2352       define variable v-new-row as decimal   no-undo .
     2353       define variable v-new-col as decimal   no-undo .
     2354       assign
     2355         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2356         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2357       .
     2358       assign
     2359         v-row-delta = v-new-row - frame Dialog-Frame :height
     2360         v-col-delta = v-new-col - frame Dialog-Frame :width
     2361       .
     2362       run diasize_change-height in this-procedure
     2363         (input v-row-delta
     2364         ,input true
     2365         ) .
     2366       run diasize_change-width in this-procedure
     2367         (input v-col-delta
     2368         ,input true
     2369         ) .
     2370     end.
     2371   end procedure.
     2372   procedure diasize_maximize :
     2373     define input  parameter p-action as logical   no-undo .
     2374     do
     2375     on error undo, return error return-value
     2376     :
     2377       if p-action = ?
     2378       then do:
     2379         if v-diasize-need-maximize = true
     2380         then do:
     2381           assign
     2382             p-action = true
     2383           .
     2384         end.
     2385         else do:
     2386           assign
     2387             p-action = false
     2388           .
     2389         end.
     2390       end.
     2391       if p-action = true
     2392       then do:
     2393         run diasize_change-height in this-procedure
     2394           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2395               - frame Dialog-Frame :height-chars
     2396           ,input true
     2397           ) .
     2398         run diasize_change-width in this-procedure
     2399           (input session :width-chars
     2400               - frame Dialog-Frame :width-chars
     2401           ,input true
     2402           ) .
     2403         assign
     2404           v-diasize-need-maximize = false
     2405         .
     2406       end.
     2407       else do:
     2408         run diasize_change-width in this-procedure
     2409           (input v-diasize-orig-frame-width
     2410               - frame Dialog-Frame :width-chars
     2411           ,input true
     2412           ) .
     2413         run diasize_change-height in this-procedure
     2414           (input v-diasize-orig-frame-height
     2415               - frame Dialog-Frame :height-chars
     2416           ,input true
     2417           ) .
     2418         assign
     2419           v-diasize-need-maximize = true
     2420         .
     2421       end.
     2422     end.
     2423   end procedure.
     2424   procedure diasize_restore-orig-size :
     2425     do
     2426     on error undo, return error return-value
     2427     :
     2428       assign
     2429         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2430         v-diasize-current-frame-height = frame Dialog-Frame :height
     2431       .
     2432       run diasize_set-height in this-procedure
     2433         (input  v-diasize-orig-frame-height
     2434         ,input  true
     2435         ) .
     2436       run diasize_set-width in this-procedure
     2437         (input  v-diasize-orig-frame-width
     2438         ,input  true
     2439         ) .
     2440     end.
     2441   end procedure.
     2442   procedure diasize_restore-current-size :
     2443     do
     2444     on error undo, return error return-value
     2445     :
     2446       run diasize_set-height in this-procedure
     2447         (input  v-diasize-current-frame-height
     2448         ,input  true
     2449         ) .
     2450       run diasize_set-width in this-procedure
     2451         (input  v-diasize-current-frame-width
     2452         ,input  true
     2453         ) .
     2454     end.
     2455   end procedure.
     2456   procedure diasize_set-browse-handle :
     2457     define input  parameter p-browse-handle as handle   no-undo .
     2458     define buffer buf_temp-browse-handle for temp-browse-handle .
     2459     do
     2460     on error undo, return error return-value
     2461     :
     2462       assign
     2463         v-diasize-browse-handle = p-browse-handle
     2464       .
     2465       for each buf_temp-browse-handle
     2466       on error undo, return error return-value
     2467       :
     2468         delete buf_temp-browse-handle .
     2469       end.
     2470     end.
     2471   end procedure.
     2472   procedure diasize_add_browse :
     2473     define input  parameter p-browse-type   as character no-undo .
     2474     define input  parameter p-browse-handle as handle    no-undo .
     2475     define buffer buf_temp-browse-handle for temp-browse-handle .
     2476     do
     2477     on error undo, return error return-value
     2478     :
     2479       assign
     2480         v-diasize-browse-number = v-diasize-browse-number + 1
     2481       .
     2482       create buf_temp-browse-handle .
     2483       assign
     2484         buf_temp-browse-handle.browse-type   = p-browse-type
     2485         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2486         buf_temp-browse-handle.browse-handle = p-browse-handle
     2487       .
     2488     end.
     2489   end procedure.
     2490   procedure diasize_init :
     2491     define variable v-default-value    as logical   no-undo .
     2492     define variable v-restore-saved    as logical   no-undo .
     2493     define variable v-resize-value-str as character no-undo .
     2494     do
     2495     on error undo, return error return-value
     2496     :
     2497       do with frame Dialog-Frame
     2498       :
     2499         assign
     2500           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2501           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2502           v-diasize-browse-handle     = browse BROWSE-ABC :handle
     2503         .
     2504         create button v-diasize-resize-button
     2505         assign
     2506           parent        = frame Dialog-Frame :first-child
     2507           label         = "s"
     2508           height-pixels = 16
     2509           width-pixels  = 16
     2510           visible       = true
     2511           sensitive     = true
     2512           movable       = true
     2513           triggers:
     2514             on end-move persistent run diasize_end-move in this-procedure .
     2515           end triggers.
     2516         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2517         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2518         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2519         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2520         assign
     2521           v-diasize-wndmax = false
     2522         .
     2523         if connected("ub") = true
     2524         then do:
     2525           define variable v-cntxt-db-num        as integer   no-undo .
     2526           define variable v-cntxt-userid        as character no-undo .
     2527           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2528                                             , OUTPUT v-cntxt-userid
     2529                                             ) .
     2530           run gbl/wndpar_r.p
     2531             (input  v-cntxt-db-num
     2532             ,input  v-cntxt-userid
     2533             ,input  'wndmax':U
     2534             ,output v-diasize-wndmax
     2535             ,output v-default-value
     2536             ) .
     2537         end.
     2538         assign
     2539           v-diasize-wndstore = false
     2540         .
     2541         if connected("ub") = true
     2542         then do:
     2543           run gbl/wndpar_r.p
     2544             (input  v-cntxt-db-num
     2545             ,input  v-cntxt-userid
     2546             ,input  'wndstore':U
     2547             ,output v-diasize-wndstore
     2548             ,output v-default-value
     2549             ) .
     2550         end.
     2551         assign
     2552           v-diasize-proc-name = entry(1, program-name(2), '.')
     2553         .
     2554         if v-diasize-wndstore = true
     2555         then do:
     2556           assign
     2557             v-restore-saved = false
     2558           .
     2559           if connected("ub") = true
     2560           then do:
     2561             run gbl/wndsizer.p
     2562               (input  v-cntxt-db-num
     2563               ,input  v-cntxt-userid
     2564               ,input  v-diasize-proc-name
     2565               ,input  'height':u
     2566               ,output v-resize-value-str
     2567               ) .
     2568             if v-resize-value-str <> '':U
     2569             then do:
     2570               run diasize_change-height in this-procedure
     2571                 (input  integer(v-resize-value-str)
     2572                 ,input  true
     2573                 ) .
     2574               assign
     2575                 v-restore-saved = true
     2576               .
     2577             end.
     2578           end.
     2579           if connected("ub") = true
     2580           then do:
     2581             run gbl/wndsizer.p
     2582               (input  v-cntxt-db-num
     2583               ,input  v-cntxt-userid
     2584               ,input  v-diasize-proc-name
     2585               ,input  'width':u
     2586               ,output v-resize-value-str
     2587               ) .
     2588             if v-resize-value-str <> '':U
     2589             then do:
     2590               run diasize_change-width in this-procedure
     2591                 (input  integer(v-resize-value-str)
     2592                 ,input  true
     2593                 ) .
     2594               assign
     2595                 v-restore-saved = true
     2596               .
     2597             end.
     2598           end.
     2599           if v-restore-saved <> true
     2600           then do:
     2601             if v-diasize-wndmax = true
     2602             then do:
     2603               run diasize_maximize in this-procedure
     2604                 (input  true
     2605                 ) .
     2606             end.
     2607           end.
     2608         end.
     2609         else do:
     2610           if v-diasize-wndmax = true
     2611           then do:
     2612             run diasize_maximize in this-procedure
     2613               (input  true
     2614               ) .
     2615           end.
     2616         end.
     2617       end.
     2618     end.
     2619   end procedure.
     2620   procedure diasize_need-full-display :
     2621     define output parameter p-need-full-display as logical   no-undo .
     2622     do
     2623     on error undo, return error return-value
     2624     :
     2625       assign
     2626         p-need-full-display = v-diasize-need-full-display
     2627       .
     2628       assign
     2629         v-diasize-need-full-display = false
     2630       .
     2631     end.
     2632   end procedure.
     2633   procedure get-context :
     2634      define output parameter p-db-num as integer          no-undo.
     2635      define output parameter p-user-id as character        no-undo.
     2636      define variable v-login               as character    no-undo.
     2637      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2638      define buffer buf_user-login  for ub.user-login .
     2639      do
     2640      on error undo, return error
     2641      :
     2642            FIND FIRST buf_sys-ctrl no-lock.
     2643            ASSIGN
     2644               v-login = USERID("ub")
     2645               p-db-num = buf_sys-ctrl.db-num
     2646            .
     2647            FIND FIRST buf_user-login
     2648                 WHERE buf_user-login.db-num = p-db-num
     2649                   AND buf_user-login.user-login = v-login
     2650                 no-lock
     2651                 no-error
     2652                 .
     2653            IF AVAILABLE buf_user-login
     2654            THEN DO:
     2655               assign
     2656                  p-user-id = buf_user-login.user-id
     2657               .
     2658            END.
     2659      end.
     2660   end procedure.
     2661       run diasize_init in this-procedure .
     2662   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2663   do:
     2664     BROWSE-ABC :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2665   end.
     2666   MAIN-BLOCK:
     2667   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2668      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2669   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2670   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2671     (output v-db-num
     2672     )  .
     2673     RUN my_enable.
     2674     WAIT-FOR GO OF FRAME Dialog-Frame focus BROWSE-ABC.
     2675   END.
     2676   RUN disable_UI.
     2677   PROCEDURE disable_UI :
     2678     HIDE FRAME Dialog-Frame.
     2679   END PROCEDURE.
     2680   PROCEDURE enable_UI :
     2681     DISPLAY mark-num v-user-name
     2682         WITH FRAME Dialog-Frame.
     2683     IF AVAILABLE x-abcxyz-analysis THEN
     2684       DISPLAY x-abcxyz-analysis.abcx-name
     2685         WITH FRAME Dialog-Frame.
     2686     ENABLE b-quit B-mark B-sel B-add B-lookup B-lookup-2 B-print B-Help
     2687            B-lookup-3 BROWSE-ABC mark-num v-user-name x-abcxyz-analysis.abcx-name
     2688         WITH FRAME Dialog-Frame.
     2689     VIEW FRAME Dialog-Frame.
     2690     OPEN QUERY BROWSE-ABC FOR EACH x-abcxyz-analysis NO-LOCK INDEXED-REPOSITION.
     2691   END PROCEDURE.
     2692   PROCEDURE my_enable :
     2693   define variable par-type as character no-undo .
     2694     ENABLE b-quit
     2695            B-mark      when LOOKUP("b-mark":U, p-bttn ) > 0
     2696            mark-num
     2697            B-sel       when LOOKUP("b-sel":U, p-bttn ) > 0
     2698            B-add       when LOOKUP("b-add":U, p-bttn ) > 0
     2699            B-del       when LOOKUP("b-del":U, p-bttn ) > 0
     2700            B-lookup
     2701            B-lookup-2
     2702            B-lookup-3
     2703            B-print
     2704            B-Help
     2705            browse-abc
     2706         WITH FRAME Dialog-Frame.
     2707     VIEW FRAME Dialog-Frame.
     2708     RUN OpenBR.
     2709   END PROCEDURE.
     2710   PROCEDURE OpenBR :
     2711   define variable p-open-query     as logical   no-undo init true .
     2712   def var l-query-was-opened as logical no-undo .
     2713   define variable doc-rec  as recid     no-undo .
     2714   define variable  p-find-next      as logical   no-undo .
     2715   define variable  p-find-condition as character no-undo .
     2716   def var sort-column-phrase as character no-undo .
     2717   case sort-column-name :
     2718     when "" then do:
     2719       assign
     2720         sort-column-phrase = ""
     2721       .
     2722     end.
     2723     otherwise do:
     2724       assign
     2725         sort-column-phrase = "by " + sort-column-name
     2726       .
     2727     end.
     2728   end case.
     2729   define variable title0 as character no-undo init "Список Ассортиментных матриц".
     2730   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2731   define variable  l-disable-where-27  as logical   no-undo .
     2732   define variable  l-filter-open-27    as logical   .
     2733   define variable  flt-rec-27       as recid     no-undo .
     2734   define variable  filter-name-27      as character no-undo .
     2735   define variable  where-phrase-27     as character no-undo .
     2736   define variable  sort-phrase-27      as character no-undo .
     2737   define variable  where-phrase-rus-27 as character no-undo .
     2738   define variable  sort-phrase-rus-27  as character no-undo .
     2739     run waitfram-show in this-procedure
     2740       (input "ЖДИТЕ ..."
     2741       ).
     2742   run gbl/flt-get.p
     2743     (input filter-point
     2744     ,output flt-rec-27
     2745     ,output filter-name-27
     2746     ,output where-phrase-27
     2747     ,output sort-phrase-27
     2748     ,output where-phrase-rus-27
     2749     ,output sort-phrase-rus-27
     2750     ).
     2751   if p-open-query then do:
     2752       run set-filter-name in this-procedure
     2753         (INPUT filter-name-27
     2754         ) no-error .
     2755     assign
     2756       l-filter-open-27 = false
     2757     .
     2758     if flt-rec-27 <> ?
     2759       or sort-column-phrase > ""
     2760     then do:
     2761       define variable  parameter-2-27 as character no-undo .
     2762       define variable  parameter-3-27 as character no-undo .
     2763       define variable  parameter-4-27 as character no-undo .
     2764       define variable  parameter-5-27 as character no-undo .
     2765       define variable  parameter-6-27 as character no-undo .
     2766       define variable  parameter-7-27 as character no-undo .
     2767         assign
     2768         parameter-3-27 =
     2769                                 "FOR EACH x-abcxyz-analysis"
     2770         parameter-4-27 =
     2771           (
     2772             if (" true   " + " " + where-phrase-27) <> ""
     2773             then " true   " + " " + where-phrase-27
     2774             else "true"
     2775           )
     2776         parameter-5-27 = (" " + "" + " " + "")
     2777         parameter-6-27 = if sort-phrase-27 = ''
     2778                              then
     2779           (
     2780           " " + " " +
     2781             " " + sort-column-phrase +
     2782           " " + " "
     2783           )
     2784                              else
     2785           (
     2786           " " + " " +
     2787             " " + sort-column-phrase +
     2788           " " + sort-phrase-27
     2789           )
     2790         parameter-7-27 =
     2791           " indexed-reposition  "
     2792       .
     2793       do
     2794       on stop undo, leave
     2795       on error undo, leave
     2796       :
     2797         assign
     2798           l-disable-where-27 =
     2799             (" true   " + " " + where-phrase-27 = "")
     2800         .
     2801         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2802                             ,input query BROWSE-ABC:handle
     2803                             ,input parameter-3-27
     2804                             ,input parameter-4-27
     2805                             ,input parameter-5-27
     2806                             ,input parameter-6-27
     2807                             ,input parameter-7-27
     2808                             )
     2809         .
     2810         assign
     2811           l-filter-open-27 = true
     2812         .
     2813       end.
     2814       if l-filter-open-27 = false then do:
     2815         message
     2816           "Ошибка при фильтрации / сортировке" skip
     2817           "Будут показаны записи без учета фильтра" skip
     2818           view-as alert-box .
     2819       end.
     2820       else do:
     2821           assign
     2822             l-query-was-opened = true
     2823           .
     2824       end.
     2825     end.
     2826     if l-filter-open-27 = false then do:
     2827       OPEN QUERY BROWSE-Abc FOR EACH x-abcxyz-analysis
     2828         where  true
     2829         indexed-reposition
     2830     .
     2831         assign
     2832           l-query-was-opened = true
     2833         .
     2834     end.
     2835   end.
     2836   else do:
     2837     assign
     2838       doc-rec = recid( x-abcxyz-analysis )
     2839     .
     2840     do
     2841     on stop undo, leave
     2842     on error undo, leave
     2843     :
     2844       if query BROWSE-ABC:handle:get-buffer-handle(1) = (buffer x-abcxyz-analysis:handle) then do:
     2845         assign
     2846         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     2847         parameter-4-27 =
     2848           "where ":u + " true   " + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     2849         parameter-5-27 = " "
     2850       .
     2851         run fltopend_fltfindd in this-procedure  (
     2852                             input this-procedure:handle
     2853                             ,input query BROWSE-ABC:handle
     2854                             ,input rowid(x-abcxyz-analysis)
     2855                             ,input logical(parameter-2-27)
     2856                             ,input no-lock
     2857                             ,input (buffer x-abcxyz-analysis:handle)
     2858                             ,input parameter-4-27
     2859                             ,input parameter-5-27
     2860                             ) no-error.
     2861         .
     2862         assign
     2863           doc-rec = integer(return-value)
     2864           v-fltopend-rowid[1] = ?
     2865         .
     2866       end.
     2867       else do:
     2868         assign
     2869         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     2870         parameter-3-27 =  "FOR EACH x-abcxyz-analysis"
     2871         parameter-4-27 =
     2872           (
     2873             if (" true   " + " " + where-phrase-27) <> ""
     2874             then " true   " + " " + where-phrase-27
     2875             else "true"
     2876           )
     2877         parameter-5-27 = (" " + "" + " " + "" + " " + p-find-condition)
     2878         parameter-6-27 = if sort-phrase-27 = ''
     2879                              then
     2880           (
     2881           " " + " " +
     2882             " " + sort-column-phrase +
     2883           " " + " "
     2884           )
     2885                              else
     2886           (
     2887           " " + " " +
     2888             " " + sort-column-phrase +
     2889           " " + sort-phrase-27
     2890           )
     2891         parameter-7-27 =
     2892           " indexed-reposition  "
     2893       .
     2894         run fltopend_fltfindq in this-procedure  (
     2895                             input this-procedure:handle
     2896                             ,input query BROWSE-ABC:handle
     2897                             ,input logical(parameter-2-27)
     2898                             ,input no-lock
     2899                             ,input parameter-3-27
     2900                             ,input parameter-4-27
     2901                             ,input parameter-5-27
     2902                             ,input parameter-6-27
     2903                             ,input parameter-7-27
     2904                             ,output v-fltopend-rowid
     2905                             ) no-error.
     2906         .
     2907         doc-rec = ?.
     2908       end.
     2909       assign
     2910         l-query-was-opened = true
     2911       .
     2912     end.
     2913   end.
     2914     run waitfram-hide in this-procedure .
     2915   APPLY "ENTRY" TO BROWSE-ABC in frame Dialog-Frame.
     2916   APPLY "VALUE-CHANGED" TO BROWSE-ABC in frame Dialog-Frame.
     2917   END PROCEDURE.
     2918   PROCEDURE proc-add :
     2919   define output  parameter p-doc-rec as recid     no-undo .
     2920   run ref/abcxyzc.p ( INPUT parParentProc , output p-doc-rec ) .
     2921   END PROCEDURE.
     2922   PROCEDURE proc-b-del :
     2923   DEFINE VARIABLE loc-doc-rec AS RECID NO-UNDO.
     2924   define variable br-handle as handle NO-UNDO.
     2925   define variable g#log  as logical   no-undo .
     2926   if not available x-abcxyz-analysis then return error.
     2927    find current x-abcxyz-analysis exclusive-lock no-error .
     2928           if not available x-abcxyz-analysis then do:
     2929             message vss-workfile vss-revision vss-description skip
     2930                       error-status :get-message(1)   skip
     2931                       "Ошибка при определении записи x-abcxyz-analysis"
     2932                       view-as alert-box error .
     2933             return .
     2934           end.
     2935     delete x-abcxyz-analysis .
     2936     br-handle = BROWSE-ABC:handle in frame Dialog-Frame .
     2937     if valid-handle (br-handle) then do:
     2938       g#log = br-handle:select-next-row().
     2939       if not g#log then g#log = br-handle:select-prev-row().
     2940       loc-doc-rec = RECID(x-abcxyz-analysis) .
     2941     end.
     2942      RUN OpenBr.
     2943      apply "VALUE-CHANGED" to BROWSE-ABC in frame Dialog-Frame.
     2944      reposition BROWSE-ABC to recid loc-doc-rec no-error.
     2945   END PROCEDURE.
     2946   PROCEDURE proc-b-print :
     2947   def var sym1  as char format "X(1)" init ":".
     2948   def var sym2  as char format "X(1)" init ":".
     2949   def var sym3  as char format "X(1)" init ":".
     2950   def var sym4  as char format "X(1)" init ":".
     2951   def var sym5  as char format "X(1)" init ":".
     2952   def var sym6  as char format "X(1)" init ":".
     2953   def var sym7  as char format "X(1)" init ":".
     2954   def var sym8  as char format "X(1)" init ":".
     2955   def var sym9  as char format "X(1)" init ":".
     2956   def var sym10 as char format "X(1)" init ":".
     2957   def var sym11 as char format "X(1)" init ":".
     2958   def var sym12 as char format "X(1)" init ":".
     2959   def var date_string     as      char    no-undo.
     2960   def var Line                as      char    no-undo.
     2961   def var for-time as char.
     2962   define variable v-time  as character no-undo .
     2963   DEFINE FRAME prt-frame
     2964         x-abcxyz-analysis.abcx-name                         COLUMN-LABEL "Наименование! " FORMAT "x(60)":U
     2965         x-abcxyz-analysis.abcx-date-create                  COLUMN-LABEL "Дата!создания" FORMAT "99/99/99":U
     2966         v-time COLUMN-LABEL "Время!созд" FORMAT "x(5)":U
     2967         x-abcxyz-analysis.abcx-db-num-create                COLUMN-LABEL "БД" FORMAT ">>>>9":U
     2968         x-abcxyz-analysis.abcx-who-create                   COLUMN-LABEL "Кто провел!сравнение" FORMAT "X(10)":U
     2969         HEADER  date_string AT 5 format "X(35)"
     2970         string( "Страница " ) format "X(9)" AT 50 PAGE-NUMBER( PrnLibStream) AT 70 FORMAT ">>>>9" SKIP
     2971         Line format "X(199)" AT 1
     2972       with width 232 down stream-io use-text    .
     2973       Line = fill("-", 255).
     2974       date_string = cur-time-print() .
     2975       run prn-lib-open-stream  in this-procedure (
     2976          input parParentProc
     2977         ,input 43
     2978         ,input yes
     2979         ,input no
     2980         ).
     2981       PUT  STREAM PrnLibStream
     2982       SPACE(25) ( frame Dialog-Frame:title )
     2983       format "x(232)" SKIP(1) .
     2984       FORM HEADER
     2985               Line format "X(199)" AT 1 SKIP
     2986               "Продолжение - на следующей странице" AT 30 SKIP
     2987               with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2988       VIEW  STREAM PrnLibStream FRAME BottomFrame .
     2989       FORM with FRAME prt-frame  .
     2990       run waitfram-show in this-procedure ("Ждите печатаю...").
     2991       run OpenBR.
     2992        DO WHILE available x-abcxyz-analysis :
     2993           Display STREAM PrnLibStream
     2994               x-abcxyz-analysis.abcx-name
     2995               x-abcxyz-analysis.abcx-date-create
     2996               STRING (x-abcxyz-analysis.abcx-time-create,'HH:MM') @ v-time
     2997               x-abcxyz-analysis.abcx-db-num-create
     2998               x-abcxyz-analysis.abcx-who-create
     2999               with FRAME prt-frame .
     3000               DOWN STREAM PrnLibStream 1 with FRAME prt-frame  .
     3001               GET next BROWSE-ABC.
     3002         END.
     3003         UNDERLINE  STREAM PrnLibStream
     3004               x-abcxyz-analysis.abcx-name
     3005               x-abcxyz-analysis.abcx-date-create
     3006               v-time
     3007               x-abcxyz-analysis.abcx-db-num-create
     3008               x-abcxyz-analysis.abcx-who-create
     3009       with FRAME prt-frame .
     3010       HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3011       HIDE  STREAM PrnLibStream FRAME CheckList.
     3012       output  STREAM PrnLibStream CLOSE.
     3013       run waitfram-hide in this-procedure .
     3014       run prn-lib-prn-file in this-procedure (
     3015           input parParentProc
     3016          ,input 8
     3017           ).
     3018   END PROCEDURE.
