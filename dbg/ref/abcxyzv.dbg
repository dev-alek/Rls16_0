      804   function func-get-name-from-ext-type   returns char
      805     ( p-ext-type as character   ,
      806       p-caps     as logical ).
      807   define variable v-ext-name as character no-undo .
      808   run get-name-from-ext-type in this-procedure (
      809       input p-ext-type  ,
      810       input p-caps  ,
      811       output v-ext-name )
      812       no-error .
      813       if error-status :error then do:
      814          assign
      815            v-ext-name = p-ext-type
      816          .
      817       end.
      818    return (v-ext-name) .
      819   end.
      820   procedure get-name-from-ext-type :
      821    do
      822    on error undo, return error return-value
      823    :
      824   define input  parameter p-ext-type as character no-undo .
      825   define input  parameter p-caps     as logical no-undo   .
      826   define output parameter p-ext-name as character no-undo .
      827   define variable v-num as integer no-undo .
      828     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
      829       message
      830         vss-include-info6 skip
      831         "Неправильно задано значение входящего параметра! "
      832         "Нет такого типа документов " p-ext-type
      833         view-as alert-box error .
      834         undo, return error .
      835     end.
      836     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
      837     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
      838     if p-caps  = true then do :
      839        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
      840     end .
      841     end.
      842   end procedure.
