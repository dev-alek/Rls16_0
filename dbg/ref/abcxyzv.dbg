     1071        LABEL "Просмотр ABC+XYZ"
     1072        SIZE 27 BY 1 TOOLTIP "Просмотр анализа ABC+XYZ".
     1073   DEFINE BUTTON B-mark
     1074        LABEL "&*"
     1075        SIZE 3 BY 1.
     1076   DEFINE BUTTON B-print
     1077        LABEL "Пе&чать"
     1078        SIZE 10 BY 1.
