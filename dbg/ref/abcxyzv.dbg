     1370   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1371   procedure set-filter-name :
     1372   define input parameter p-filter-name as character no-undo .
     1373     do with frame Dialog-Frame:
     1374       if p-filter-name > "" then do:
     1375         assign
     1376           frame Dialog-Frame:title
     1377             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     1378         .
     1379       end.
     1380       else do:
     1381       end.
     1382     end.
     1383   end procedure.
     1384   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1385   on help of frame Dialog-Frame
     1386   do:
     1387     run gbl/app_help.p
     1388       (input this-procedure :file-name
     1389       ,input ''
     1390       ,input ?
     1391       ) no-error.
     1392     if error-status :error then do:
     1393       message
     1394         "Ошибка при вызове помощи"
     1395         error-status :get-message(1)
     1396         view-as alert-box .
     1397     end.
     1398   end.
     1399   run minbtn-set in this-procedure .
     1400   on choose of b-help in frame Dialog-Frame
     1401   do:
     1402     apply "help":u to frame Dialog-Frame .
     1403   end.
     1404   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1405   procedure minbtn-set :
     1406       do
     1407           on error undo, return error return-value
     1408           :
     1409           define variable ii              as integer       no-undo .
     1410           define variable fh              as widget-handle no-undo .
     1411           define variable hh              as widget-handle no-undo .
     1412           define variable v-h             as handle        extent 4 no-undo .
     1413           define variable v-name-button   as character     no-undo .
     1414           define variable v-help-old-x    as decimal       no-undo .
     1415           define variable v-help-old-y    as decimal       no-undo .
     1416           define variable v-help-old-size as decimal       no-undo .
     1417           define variable v-frame-width   as decimal       no-undo .
     1418           define variable jj              as integer       no-undo .
     1419           do
     1420               on error undo, return error
     1421               :
     1422               assign
     1423                   v-frame-width = frame Dialog-Frame:width - 0.3
     1424                   fh            = frame Dialog-Frame:first-child
     1425                   hh            = fh:first-child
     1426                   ii            = 1
     1427                   .
     1428               do while valid-handle(hh):
     1429                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1430                   do:
     1431                       case lc(hh:name) :
     1432                           when "b-help" then
     1433                               do:
     1434                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1435                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1436                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1437                                   hh:TOOLTIP = "Помощь" .
     1438                                   v-help-old-x = hh:column .
     1439                                   v-help-old-y = hh:row    .
     1440                                   v-help-old-size = hh:width .
     1441                                   hh:width-chars = 2.5 .
     1442                               end.
     1443                           when "b-print" then
     1444                               do:
     1445                                   hh:load-image("cmp/b-print.bmp":u) .
     1446                                   hh:TOOLTIP = "Печать" .
     1447                                   v-h[ii] = hh:handle .
     1448                                   ii = ii + 1 .
     1449                                   hh:width-chars = 3 .
     1450                               end.
     1451                           when "b-history" or
     1452                           when "b-hist" then
     1453                               do:
     1454                                   hh:load-image("cmp/b-hist.bmp":u) .
     1455                                   hh:TOOLTIP = "История" .
     1456                                   v-h[ii] = hh:handle .
     1457                                   ii = ii + 1 .
     1458                                   hh:width-chars = 3 .
     1459                               end.
     1460                           when "b-sch" then
     1461                               do:
     1462                                   hh:load-image("cmp/b-sch.bmp":u) .
     1463                                   hh:TOOLTIP = "Установка Фильтра" .
     1464                                   v-h[ii] = hh:handle .
     1465                                   ii = ii + 1 .
     1466                                   hh:width-chars = 3 .
     1467                               end.
     1468                           when "b-hist-user" then
     1469                               do:
     1470                                   hh:load-image("cmp/b-hist.bmp":u) .
     1471                                   hh:TOOLTIP = "История пользователя" .
     1472                                   ii = ii + 1 .
     1473                               end.
     1474                       end case.
     1475                   end.
     1476                   hh = hh:next-sibling.
     1477               end.
     1478               b-help:column = v-frame-width - b-help:width-chars.
     1479               jj = 0.
     1480               repeat ii = 4 to 1 by -1 :
     1481                   if valid-handle (v-h[ii] ) then
     1482                   do:
     1483                       jj  = jj + 1 .
     1484                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1485                       v-h[ii]:row    = v-help-old-y .
     1486                   end.
     1487               end.
     1488           end.
     1489       end.
     1490   end procedure.
     1491   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1492   define variable v-diasize-need-maximize        as logical   no-undo init true  .
