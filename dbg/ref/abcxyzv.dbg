     1305   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1306   DO:
     1307     define variable loc#log as logical no-undo .
     1308     if AVAILABLE x-abcxyz-analysis  then do:
     1309   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1310   define variable v-str-recid18 as character no-undo .
     1311   define variable v-num-entry18 as integer   no-undo .
     1312   assign
     1313     v-str-recid18 = trim( string( recid( x-abcxyz-analysis ) , "->>>>>>>>>>>9":U ) )
     1314     v-num-entry18 = lookup( v-str-recid18 , p-rid-list )
     1315   .
     1316   if v-num-entry18 > 0 then do:
     1317     assign
     1318       entry( v-num-entry18, p-rid-list ) = "":U
     1319       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1320     .
     1321   end.
     1322   else do:
     1323     assign
     1324       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid18
     1325     .
     1326   end.
     1327       loc#log = BROWSE-ABC:refresh() .
     1328       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1329           loc#log = BROWSE-ABC:select-next-row ().
     1330           apply "VALUE-CHANGED" to BROWSE-ABC in frame Dialog-Frame.
     1331       end.
     1332       if num-entries( p-rid-list ) = 0
     1333       then
     1334           hide mark-num in frame Dialog-Frame.
     1335       else
     1336           disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
     1337     end.
     1338     apply "entry" to BROWSE-ABC in frame Dialog-Frame.
     1339   END.
