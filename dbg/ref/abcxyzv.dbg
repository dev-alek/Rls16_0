     1098     QUERY BROWSE-ABC NO-LOCK DISPLAY
     1099         mark-string(recid( x-abcxyz-analysis), p-rid-list)  COLUMN-LABEL "*" FORMAT "X(1)":U
     1100         x-abcxyz-analysis.abcx-name                         COLUMN-LABEL "Наименование" FORMAT "x(60)":U
     1101         x-abcxyz-analysis.abcx-date-create                  COLUMN-LABEL "Дата!создания" FORMAT "99/99/99":U
     1102         STRING (x-abcxyz-analysis.abcx-time-create,'HH:MM') COLUMN-LABEL "Время!созд" FORMAT "x(5)":U WIDTH 5
     1103         x-abcxyz-analysis.abcx-db-num-create                COLUMN-LABEL "БД" FORMAT ">>>>9":U
     1104         x-abcxyz-analysis.abcx-who-create                   COLUMN-LABEL "Кто провел!сравнение" FORMAT "X(15)":U WIDTH 10
     1105       WITH NO-ROW-MARKERS SEPARATORS SIZE 97 BY 17.25 FIT-LAST-COLUMN.
     1106   DEFINE FRAME Dialog-Frame
     1107        b-quit AT ROW 1 COL 1
     1108        B-mark AT ROW 1 COL 14
     1109        B-sel AT ROW 1 COL 17
     1110        B-add AT ROW 1 COL 27
     1111        B-del AT ROW 1 COL 37
