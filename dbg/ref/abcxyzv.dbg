      864   FUNCTION mark-string RETURNS CHARACTER
      865     ( input p-recid as recid, input mark-list as character  ) :
      866     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
