     1762           v-diasize-resize-button :column = 1
     1763         .
     1764       end.
     1765       if p-change-value > 0
     1766       then do:
     1767         if frame Dialog-Frame :scrollable = true
     1768         then do:
     1769           assign
     1770             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1771             no-error .
     1772           if error-status :error
     1773           or error-status :get-message(1) <> ""
     1774           then do:
