     1420   end.
     1421   run minbtn-set in this-procedure .
     1422   on choose of b-help in frame Dialog-Frame
     1423   do:
     1424     apply "help":u to frame Dialog-Frame .
     1425   end.
     1426   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1427   procedure minbtn-set :
     1428       do
     1429           on error undo, return error return-value
     1430           :
     1431           define variable ii              as integer       no-undo .
     1432           define variable fh              as widget-handle no-undo .
     1433           define variable hh              as widget-handle no-undo .
     1434           define variable v-h             as handle        extent 4 no-undo .
     1435           define variable v-name-button   as character     no-undo .
     1436           define variable v-help-old-x    as decimal       no-undo .
     1437           define variable v-help-old-y    as decimal       no-undo .
     1438           define variable v-help-old-size as decimal       no-undo .
     1439           define variable v-frame-width   as decimal       no-undo .
     1440           define variable jj              as integer       no-undo .
     1441           do
     1442               on error undo, return error
     1443               :
     1444               assign
     1445                   v-frame-width = frame Dialog-Frame:width - 0.3
     1446                   fh            = frame Dialog-Frame:first-child
     1447                   hh            = fh:first-child
     1448                   ii            = 1
     1449                   .
     1450               do while valid-handle(hh):
     1451                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1452                   do:
     1453                       case lc(hh:name) :
     1454                           when "b-help" then
     1455                               do:
     1456                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1457                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1458                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1459                                   hh:TOOLTIP = "Помощь" .
     1460                                   v-help-old-x = hh:column .
     1461                                   v-help-old-y = hh:row    .
     1462                                   v-help-old-size = hh:width .
     1463                                   hh:width-chars = 2.5 .
     1464                               end.
     1465                           when "b-print" then
     1466                               do:
     1467                                   hh:load-image("cmp/b-print.bmp":u) .
     1468                                   hh:TOOLTIP = "Печать" .
     1469                                   v-h[ii] = hh:handle .
     1470                                   ii = ii + 1 .
     1471                                   hh:width-chars = 3 .
     1472                               end.
     1473                           when "b-history" or
     1474                           when "b-hist" then
     1475                               do:
     1476                                   hh:load-image("cmp/b-hist.bmp":u) .
     1477                                   hh:TOOLTIP = "История" .
     1478                                   v-h[ii] = hh:handle .
     1479                                   ii = ii + 1 .
     1480                                   hh:width-chars = 3 .
     1481                               end.
     1482                           when "b-sch" then
     1483                               do:
     1484                                   hh:load-image("cmp/b-sch.bmp":u) .
     1485                                   hh:TOOLTIP = "Установка Фильтра" .
     1486                                   v-h[ii] = hh:handle .
     1487                                   ii = ii + 1 .
     1488                                   hh:width-chars = 3 .
     1489                               end.
     1490                           when "b-hist-user" then
     1491                               do:
     1492                                   hh:load-image("cmp/b-hist.bmp":u) .
     1493                                   hh:TOOLTIP = "История пользователя" .
     1494                                   ii = ii + 1 .
     1495                               end.
     1496                       end case.
     1497                   end.
     1498                   hh = hh:next-sibling.
     1499               end.
     1500               b-help:column = v-frame-width - b-help:width-chars.
     1501               jj = 0.
     1502               repeat ii = 4 to 1 by -1 :
     1503                   if valid-handle (v-h[ii] ) then
     1504                   do:
     1505                       jj  = jj + 1 .
     1506                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1507                       v-h[ii]:row    = v-help-old-y .
     1508                   end.
     1509               end.
     1510           end.
     1511       end.
     1512   end procedure.
     1513   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1514   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1515   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1516   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1517   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1518   define variable v-diasize-current-frame-height as decimal   no-undo .
     1519   define variable v-diasize-change-size          as logical   no-undo .
     1520   define variable v-diasize-resize-button        as handle    no-undo .
     1521   define variable v-diasize-wndmax               as logical   no-undo .
     1522   define variable v-diasize-wndstore             as logical   no-undo .
     1523   define variable v-diasize-proc-name            as character no-undo .
     1524   define variable v-diasize-browse-handle        as handle    no-undo .
     1525   define variable v-diasize-browse-number        as integer   no-undo .
     1526   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1527   define temp-table temp-diasize-handle no-undo
     1528     field handle-value  as handle
     1529     field save-position as decimal
     1530     index xpk is primary unique handle-value
     1531     .
     1532   define temp-table temp-browse-handle no-undo
     1533     field browse-type   as character
     1534     field browse-number as integer
     1535     field browse-handle as handle
     1536     field original-size as decimal
     1537     index xpk is primary unique browse-type browse-number
     1538     index xie browse-type browse-handle
     1539   .
     1540   procedure diasize_change-height :
     1541     define input  parameter p-change-value  as decimal   no-undo .
     1542     define input  parameter p-move-resize   as logical   no-undo .
     1543     define variable v-field-group-handle    as handle    no-undo .
     1544     define variable v-object-handle         as handle    no-undo .
     1545     define variable v-frame-height          as decimal   no-undo .
     1546     define variable v-frame-virtual-height  as decimal   no-undo .
     1547     define variable v-browse-height         as decimal   no-undo .
     1548     define variable v-window-height         as decimal   no-undo .
     1549     define variable v-window-virtual-height as decimal   no-undo .
     1550     define variable v-change-sign           as integer   no-undo .
     1551     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1552     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1553     if p-change-value > 0
     1554     then do:
     1555       if frame Dialog-Frame :height + p-change-value
     1556           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1557       then do:
     1558         assign
     1559           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1560                           - (frame Dialog-Frame :height-chars)
     1561         .
     1562         if p-change-value <= 0
     1563         then do:
     1564           run diasize_position-resize-button in this-procedure .
     1565           return .
     1566         end.
     1567       end.
     1568     end.
     1569     if p-change-value < 0
     1570     then do:
     1571       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1572       then do:
     1573         assign
     1574           p-change-value = v-diasize-orig-frame-height
     1575                          - (frame Dialog-Frame :height-chars)
     1576         .
     1577         if p-change-value >= 0
     1578         then do:
     1579           run diasize_position-resize-button in this-procedure .
     1580           return .
     1581         end.
     1582       end.
     1583     end.
     1584     if p-change-value >= 0
     1585     then do:
     1586       assign
     1587         v-change-sign = 1
     1588       .
     1589     end.
     1590     else do:
     1591       assign
     1592         v-change-sign = -1
     1593       .
     1594     end.
     1595     assign
     1596       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1597     .
     1598     if p-change-value = 0
     1599     then do:
     1600       run diasize_position-resize-button in this-procedure .
     1601       return .
     1602     end.
     1603     move_block:
     1604     do
     1605     on error undo move_block, retry move_block
     1606     :
     1607       if retry
     1608       then do:
     1609         do
     1610         on error undo move_block, leave move_block
     1611         :
     1612           if p-change-value > 0
     1613           then do:
     1614             for each buf_temp-diasize-handle
     1615             on error undo, next
     1616             :
     1617               assign
     1618                 v-object-handle = buf_temp-diasize-handle.handle-value
     1619               .
     1620               if v-object-handle <> v-diasize-resize-button
     1621               then do:
     1622                 assign
     1623                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1624                 .
     1625               end.
     1626             end.
     1627             assign
     1628               v-diasize-browse-handle :height = v-browse-height
     1629             .
     1630             for each buf_temp-browse-handle
     1631               where buf_temp-browse-handle.browse-type = 'height':u
