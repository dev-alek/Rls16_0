     2187               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2188             no-error .
     2189           if error-status :error
     2190           or error-status :get-message(1) <> ""
     2191           then do:
     2192             undo move_block, retry move_block .
     2193           end.
     2194         end.
     2195         for each buf_temp-diasize-handle
     2196         on error undo move_block, retry move_block
     2197         :
     2198           assign
     2199             v-object-handle = buf_temp-diasize-handle.handle-value
     2200           .
     2201           if v-object-handle <> v-diasize-resize-button
     2202           then do:
     2203             assign
     2204               v-object-handle :col = v-object-handle :col + p-change-value
     2205               no-error .
     2206             if error-status :error
     2207             or error-status :get-message(1) <> ""
     2208             then do:
     2209               undo move_block, retry move_block .
     2210             end.
     2211           end.
     2212         end.
     2213       end.
     2214       else do:
     2215         for each buf_temp-diasize-handle
     2216         on error undo move_block, retry move_block
     2217         :
     2218           assign
     2219             v-object-handle = buf_temp-diasize-handle.handle-value
     2220           .
     2221           if v-object-handle <> v-diasize-resize-button
     2222           then do:
     2223             assign
     2224               v-object-handle :col = v-object-handle :col + p-change-value
     2225               no-error .
     2226             if error-status :error
     2227             or error-status :get-message(1) <> ""
     2228             then do:
     2229               undo move_block, retry move_block .
     2230             end.
     2231           end.
     2232         end.
     2233         for each buf_temp-browse-handle
     2234           where buf_temp-browse-handle.browse-type = 'width':u
     2235         on error undo move_block, retry move_block
     2236         :
     2237           assign
     2238             buf_temp-browse-handle.browse-handle :width
     2239               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2240             no-error .
     2241           if error-status :error
     2242           or error-status :get-message(1) <> ""
     2243           then do:
     2244             undo move_block, retry move_block .
     2245           end.
     2246         end.
     2247         assign
     2248           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2249           no-error .
     2250         if error-status :error
     2251         or error-status :get-message(1) <> ""
     2252         then do:
     2253           undo move_block, retry move_block.
     2254         end.
     2255         assign
     2256           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2257         no-error .
     2258         if error-status :error
     2259         or error-status :get-message(1) <> ""
     2260         then do:
     2261           undo move_block, retry move_block.
     2262         end.
     2263         if frame Dialog-Frame :scrollable = true
     2264         then do:
     2265           assign
     2266             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2267           no-error .
     2268           if error-status :error
     2269           or error-status :get-message(1) <> ""
     2270           then do:
     2271             undo move_block, retry move_block.
     2272           end.
     2273         end.
     2274       end.
     2275       if p-move-resize
     2276       then do:
     2277         run diasize_position-resize-button in this-procedure .
     2278       end.
     2279       if v-diasize-wndstore = true
     2280       then do:
     2281         if connected("ub") = true
     2282         then do:
     2283           define variable v-cntxt-db-num        as integer   no-undo .
     2284           define variable v-cntxt-userid        as character no-undo .
     2285           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2286                                             , OUTPUT v-cntxt-userid
     2287                                             ) .
     2288           run gbl/wndsizew.p
     2289             (input  v-cntxt-db-num
     2290             ,input  v-cntxt-userid
     2291             ,input  v-diasize-proc-name
     2292             ,input  'width':u
     2293             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2294             ) .
     2295         end.
     2296       end.
     2297     end.
     2298     assign
     2299       v-diasize-change-size = false
     2300     .
     2301   end procedure.
     2302   procedure diasize_set-width :
     2303     define input  parameter p-new-width  as decimal   no-undo .
     2304     define input  parameter p-move-resize as logical   no-undo .
     2305     do
     2306     on error undo, return error return-value
     2307     :
     2308       run diasize_change-width in this-procedure
     2309         (input  (p-new-width - frame Dialog-Frame :width)
     2310         ,input  p-move-resize
     2311         ) .
     2312     end.
     2313   end procedure.
     2314   procedure diasize_position-resize-button :
     2315     do with frame Dialog-Frame
     2316     :
     2317       hide v-diasize-resize-button .
     2318       assign
     2319         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2320                     - 1
     2321                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2322         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2323                     - 1
     2324                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2325       .
     2326       view v-diasize-resize-button .
     2327     end.
     2328   end procedure.
     2329   on alt-right anywhere
     2330   do:
     2331     run diasize_change-width in this-procedure
     2332       (input 1
     2333       ,input true
     2334       ) .
     2335     return no-apply .
     2336   end.
     2337   on alt-left anywhere
     2338   do:
     2339     run diasize_change-width in this-procedure
     2340       (input -1
     2341       ,input true
     2342       ) .
     2343     return no-apply .
     2344   end.
     2345   on alt-down anywhere
     2346   do:
     2347     run diasize_change-height in this-procedure
     2348       (input 1
     2349       ,input true
     2350       ) .
     2351     return no-apply .
     2352   end.
     2353   on alt-up anywhere
     2354   do:
     2355     run diasize_change-height in this-procedure
     2356       (input -1
     2357       ,input true
     2358       ) .
     2359     return no-apply .
     2360   end.
     2361   on alt-enter of frame Dialog-Frame
     2362   do:
     2363     run diasize_maximize in this-procedure
     2364       (input  ?
     2365       ).
     2366     return no-apply .
     2367   end.
     2368   procedure diasize_end-move :
     2369     do
     2370     on error undo, return error return-value
     2371     :
     2372       define variable v-row-delta as decimal   no-undo .
     2373       define variable v-col-delta as decimal   no-undo .
     2374       define variable v-new-row as decimal   no-undo .
     2375       define variable v-new-col as decimal   no-undo .
     2376       assign
     2377         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2378         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2379       .
     2380       assign
     2381         v-row-delta = v-new-row - frame Dialog-Frame :height
     2382         v-col-delta = v-new-col - frame Dialog-Frame :width
     2383       .
     2384       run diasize_change-height in this-procedure
     2385         (input v-row-delta
     2386         ,input true
     2387         ) .
     2388       run diasize_change-width in this-procedure
     2389         (input v-col-delta
     2390         ,input true
     2391         ) .
     2392     end.
     2393   end procedure.
     2394   procedure diasize_maximize :
     2395     define input  parameter p-action as logical   no-undo .
     2396     do
     2397     on error undo, return error return-value
     2398     :
     2399       if p-action = ?
     2400       then do:
     2401         if v-diasize-need-maximize = true
     2402         then do:
     2403           assign
     2404             p-action = true
     2405           .
     2406         end.
     2407         else do:
     2408           assign
     2409             p-action = false
     2410           .
     2411         end.
     2412       end.
     2413       if p-action = true
     2414       then do:
     2415         run diasize_change-height in this-procedure
     2416           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2417               - frame Dialog-Frame :height-chars
     2418           ,input true
     2419           ) .
     2420         run diasize_change-width in this-procedure
     2421           (input session :width-chars
     2422               - frame Dialog-Frame :width-chars
     2423           ,input true
     2424           ) .
     2425         assign
     2426           v-diasize-need-maximize = false
     2427         .
     2428       end.
     2429       else do:
     2430         run diasize_change-width in this-procedure
     2431           (input v-diasize-orig-frame-width
     2432               - frame Dialog-Frame :width-chars
     2433           ,input true
     2434           ) .
     2435         run diasize_change-height in this-procedure
     2436           (input v-diasize-orig-frame-height
     2437               - frame Dialog-Frame :height-chars
     2438           ,input true
     2439           ) .
     2440         assign
     2441           v-diasize-need-maximize = true
     2442         .
     2443       end.
     2444     end.
     2445   end procedure.
     2446   procedure diasize_restore-orig-size :
     2447     do
     2448     on error undo, return error return-value
     2449     :
     2450       assign
     2451         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2452         v-diasize-current-frame-height = frame Dialog-Frame :height
     2453       .
     2454       run diasize_set-height in this-procedure
     2455         (input  v-diasize-orig-frame-height
     2456         ,input  true
     2457         ) .
     2458       run diasize_set-width in this-procedure
     2459         (input  v-diasize-orig-frame-width
     2460         ,input  true
     2461         ) .
     2462     end.
     2463   end procedure.
     2464   procedure diasize_restore-current-size :
     2465     do
     2466     on error undo, return error return-value
     2467     :
     2468       run diasize_set-height in this-procedure
     2469         (input  v-diasize-current-frame-height
     2470         ,input  true
     2471         ) .
     2472       run diasize_set-width in this-procedure
     2473         (input  v-diasize-current-frame-width
     2474         ,input  true
     2475         ) .
     2476     end.
     2477   end procedure.
     2478   procedure diasize_set-browse-handle :
     2479     define input  parameter p-browse-handle as handle   no-undo .
     2480     define buffer buf_temp-browse-handle for temp-browse-handle .
     2481     do
     2482     on error undo, return error return-value
     2483     :
     2484       assign
     2485         v-diasize-browse-handle = p-browse-handle
     2486       .
     2487       for each buf_temp-browse-handle
     2488       on error undo, return error return-value
     2489       :
     2490         delete buf_temp-browse-handle .
     2491       end.
     2492     end.
     2493   end procedure.
     2494   procedure diasize_add_browse :
     2495     define input  parameter p-browse-type   as character no-undo .
     2496     define input  parameter p-browse-handle as handle    no-undo .
     2497     define buffer buf_temp-browse-handle for temp-browse-handle .
     2498     do
     2499     on error undo, return error return-value
     2500     :
     2501       assign
     2502         v-diasize-browse-number = v-diasize-browse-number + 1
     2503       .
     2504       create buf_temp-browse-handle .
     2505       assign
     2506         buf_temp-browse-handle.browse-type   = p-browse-type
     2507         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2508         buf_temp-browse-handle.browse-handle = p-browse-handle
     2509       .
     2510     end.
     2511   end procedure.
     2512   procedure diasize_init :
     2513     define variable v-default-value    as logical   no-undo .
     2514     define variable v-restore-saved    as logical   no-undo .
     2515     define variable v-resize-value-str as character no-undo .
     2516     do
     2517     on error undo, return error return-value
     2518     :
     2519       do with frame Dialog-Frame
     2520       :
     2521         assign
     2522           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2523           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2524           v-diasize-browse-handle     = browse BR-tax-rate-gds :handle
     2525         .
     2526         create button v-diasize-resize-button
     2527         assign
     2528           parent        = frame Dialog-Frame :first-child
     2529           label         = "s"
     2530           height-pixels = 16
     2531           width-pixels  = 16
     2532           visible       = true
     2533           sensitive     = true
     2534           movable       = true
     2535           triggers:
     2536             on end-move persistent run diasize_end-move in this-procedure .
     2537           end triggers.
     2538         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2539         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2540         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2541         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2542         assign
     2543           v-diasize-wndmax = false
     2544         .
     2545         if connected("ub") = true
     2546         then do:
     2547           define variable v-cntxt-db-num        as integer   no-undo .
     2548           define variable v-cntxt-userid        as character no-undo .
     2549           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2550                                             , OUTPUT v-cntxt-userid
     2551                                             ) .
     2552           run gbl/wndpar_r.p
     2553             (input  v-cntxt-db-num
     2554             ,input  v-cntxt-userid
     2555             ,input  'wndmax':U
     2556             ,output v-diasize-wndmax
     2557             ,output v-default-value
     2558             ) .
     2559         end.
     2560         assign
     2561           v-diasize-wndstore = false
     2562         .
     2563         if connected("ub") = true
     2564         then do:
     2565           run gbl/wndpar_r.p
     2566             (input  v-cntxt-db-num
     2567             ,input  v-cntxt-userid
     2568             ,input  'wndstore':U
     2569             ,output v-diasize-wndstore
     2570             ,output v-default-value
     2571             ) .
     2572         end.
     2573         assign
     2574           v-diasize-proc-name = entry(1, program-name(2), '.')
     2575         .
     2576         if v-diasize-wndstore = true
     2577         then do:
     2578           assign
     2579             v-restore-saved = false
     2580           .
     2581           if connected("ub") = true
     2582           then do:
     2583             run gbl/wndsizer.p
     2584               (input  v-cntxt-db-num
     2585               ,input  v-cntxt-userid
     2586               ,input  v-diasize-proc-name
     2587               ,input  'height':u
     2588               ,output v-resize-value-str
     2589               ) .
     2590             if v-resize-value-str <> '':U
     2591             then do:
     2592               run diasize_change-height in this-procedure
     2593                 (input  integer(v-resize-value-str)
     2594                 ,input  true
     2595                 ) .
     2596               assign
     2597                 v-restore-saved = true
     2598               .
     2599             end.
     2600           end.
     2601           if connected("ub") = true
     2602           then do:
     2603             run gbl/wndsizer.p
     2604               (input  v-cntxt-db-num
     2605               ,input  v-cntxt-userid
     2606               ,input  v-diasize-proc-name
     2607               ,input  'width':u
     2608               ,output v-resize-value-str
     2609               ) .
     2610             if v-resize-value-str <> '':U
     2611             then do:
     2612               run diasize_change-width in this-procedure
     2613                 (input  integer(v-resize-value-str)
     2614                 ,input  true
     2615                 ) .
     2616               assign
     2617                 v-restore-saved = true
     2618               .
     2619             end.
     2620           end.
     2621           if v-restore-saved <> true
     2622           then do:
     2623             if v-diasize-wndmax = true
     2624             then do:
     2625               run diasize_maximize in this-procedure
     2626                 (input  true
     2627                 ) .
     2628             end.
     2629           end.
     2630         end.
     2631         else do:
     2632           if v-diasize-wndmax = true
     2633           then do:
     2634             run diasize_maximize in this-procedure
     2635               (input  true
     2636               ) .
     2637           end.
     2638         end.
     2639       end.
     2640     end.
     2641   end procedure.
     2642   procedure diasize_need-full-display :
     2643     define output parameter p-need-full-display as logical   no-undo .
     2644     do
     2645     on error undo, return error return-value
     2646     :
     2647       assign
     2648         p-need-full-display = v-diasize-need-full-display
     2649       .
     2650       assign
     2651         v-diasize-need-full-display = false
     2652       .
     2653     end.
     2654   end procedure.
     2655   procedure get-context :
     2656      define output parameter p-db-num as integer          no-undo.
     2657      define output parameter p-user-id as character        no-undo.
     2658      define variable v-login               as character    no-undo.
     2659      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2660      define buffer buf_user-login  for ub.user-login .
     2661      do
     2662      on error undo, return error
     2663      :
     2664            FIND FIRST buf_sys-ctrl no-lock.
     2665            ASSIGN
     2666               v-login = USERID("ub")
     2667               p-db-num = buf_sys-ctrl.db-num
     2668            .
     2669            FIND FIRST buf_user-login
     2670                 WHERE buf_user-login.db-num = p-db-num
     2671                   AND buf_user-login.user-login = v-login
     2672                 no-lock
     2673                 no-error
     2674                 .
     2675            IF AVAILABLE buf_user-login
     2676            THEN DO:
     2677               assign
     2678                  p-user-id = buf_user-login.user-id
     2679               .
     2680            END.
     2681      end.
     2682   end procedure.
     2683       run diasize_init in this-procedure .
     2684   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2685   on F9 of frame Dialog-Frame anywhere do:
     2686     if not available X_goods then
     2687       return no-apply.
     2688     gds-rec = recid (X_goods).
     2689     run ref/gds-form.w ( input parparentproc
     2690                         ,input 'ПРОСМОТР':U
     2691                         ,input ?
     2692                         ,input ?
     2693                         ,input ?
     2694                         ,input-output gds-rec).
     2695     apply "entry" to br-tax-rate-gds in frame Dialog-Frame.
     2696     return no-apply.
     2697   end.
     2698   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2699   on F2 of frame Dialog-Frame anywhere do:
     2700     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2701     return no-apply.
     2702   end.
     2703   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2704   on F2 of frame Dialog-Frame anywhere do:
     2705     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2706     return no-apply.
     2707   end.
     2708   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2709   procedure set-filter-name :
     2710   define input parameter p-filter-name as character no-undo .
     2711     do with frame Dialog-Frame:
     2712       if p-filter-name > "" then do:
     2713         assign
     2714           frame Dialog-Frame:title
     2715             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2716         .
     2717         assign
     2718           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2719         .
     2720       end.
     2721       else do:
     2722         assign
     2723           b-sch :tooltip = ""
     2724         .
     2725       end.
     2726     end.
     2727   end procedure.
     2728   MAIN-BLOCK:
     2729   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2730      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2731     v-rid-list = p-rid-list.
     2732     RUN MyEnable in this-procedure .
     2733     WAIT-FOR GO OF FRAME Dialog-Frame.
     2734   END.
     2735   RUN disable_UI.
     2736   PROCEDURE disable_UI :
     2737     HIDE FRAME Dialog-Frame.
     2738   END PROCEDURE.
     2739   PROCEDURE enable_UI :
     2740     ENABLE b-quit B-sel B-save B-sch B-Help BR-tax-rate-gds
     2741         WITH FRAME Dialog-Frame.
     2742     VIEW FRAME Dialog-Frame.
     2743     OPEN QUERY BR-tax-rate-gds FOR EACH X_goods NO-LOCK,              FIRST X_tax-rate-gds OF X_goods NO-LOCK,              FIRST LAST_tax-rate-gds OF X_goods NO-LOCK.
     2744   END PROCEDURE.
     2745   PROCEDURE MyEnable :
     2746   CASE p-list-mode:
     2747       when "TAX":U then do:
     2748           FIND FIRST ub.tax NO-LOCK where ub.tax.tax-code = p-tax-code NO-ERROR.
     2749       END.
     2750       when "TAX-RATE":U then do:
     2751           FIND FIRST ub.tax-rate NO-LOCK
     2752                    where ub.tax-rate.rate-code = p-rate-code
     2753                    and ub.tax-rate.tax-code = p-tax-code
     2754                    NO-ERROR.
     2755       END.
     2756   END case.
     2757   ENABLE
     2758   b-quit
     2759   B-sel when can-do(bttns, "b-sel")
     2760   B-Help
     2761   b-sch
     2762   b-save
     2763   BR-tax-rate-gds
     2764   WITH FRAME Dialog-Frame.
     2765   VIEW FRAME Dialog-Frame.
     2766   Run OpenBr in this-procedure  ( input yes, input no, input '':U).
     2767   END PROCEDURE.
     2768   PROCEDURE Openbr :
     2769   define input  parameter p-open-query     as logical   no-undo .
     2770   define input  parameter p-find-next      as logical   no-undo .
     2771   define input  parameter p-find-condition as character no-undo .
     2772   DEFINE VARIABLE v-today as date no-undo .
     2773   DEFINE VARIABLE v-time as integer no-undo .
     2774   run cur-time in this-procedure(output v-today, output v-time).
     2775   run factord-end-day in this-procedure (input v-today, output my-fact-order).
     2776   define variable l-query-was-opened as logical no-undo .
     2777   run waitfram-show in this-procedure ( input "Ждите...").
     2778   CASE p-list-mode:
     2779       when "TAX":U then do:
     2780           ASSIGN
     2781           frame Dialog-Frame:TITLE = substitute("Товары по налогу с кодом &1 (&2)"
     2782                                                  ,p-tax-code
