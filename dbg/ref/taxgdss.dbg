     1896           define variable v-cntxt-db-num        as integer   no-undo .
     1897           define variable v-cntxt-userid        as character no-undo .
     1898           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1899                                             , OUTPUT v-cntxt-userid
     1900                                             ) .
     1901           run gbl/wndsizew.p
     1902             (input  v-cntxt-db-num
     1903             ,input  v-cntxt-userid
     1904             ,input  v-diasize-proc-name
     1905             ,input  'height':u
     1906             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1907             ) .
