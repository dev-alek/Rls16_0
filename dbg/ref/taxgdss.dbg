     3007   PROCEDURE proc-b-list :
     3008   define variable f-name as character no-undo.
     3009   define variable v-gds-rec as recid no-undo.
     3010   define variable glog as logical no-undo .
     3011   define buffer buf_goods for ub.goods.
     3012   message
     3013   "Сохранить список товаров в файл в формате списка товаров?"
     3014   view-as alert-box question buttons YEs-NO update glog.
     3015   if not glog then return error.
     3016   assign
     3017   v-gds-rec = recid(X_tax-rate-gds).
     3018   assign
     3019     f-name = "default.gds"
     3020     glog = yes
     3021     .
     3022   system-dialog get-file f-name
     3023     filters "Списки товаров *.gds" "*.gds"
     3024     ask-overwrite
     3025     save-as
     3026     use-filename
     3027     update glog
     3028     default-extension "gds".
     3029   if not glog then do:
     3030     return.
     3031   end.
     3032   run waitfram-show in this-procedure ("Ждите...").
     3033   DO WHILE available X_tax-rate-gds :
     3034       GET prev br-tax-rate-gds.
     3035   END.
     3036   GET next br-tax-rate-gds.
     3037   output to value (f-name).
     3038   output close.
     3039   DO WHILE available X_tax-rate-gds :
     3040       find first buf_goods no-lock where
     3041                    buf_goods.gds-code = X_tax-rate-gds.gds-code no-error.
     3042       if available buf_goods then do:
     3043   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3044   find gds-list
     3045     where gds-list.prod-type = buf_goods.prod-type
     3046       and gds-list.prod-code = buf_goods.prod-code
     3047       and gds-list.artic     = buf_goods.artic
     3048     no-error .
     3049   if available gds-list then do:
     3050     assign
     3051       gds-list.to-del = no
     3052     .
     3053   end.
     3054   else do:
     3055     define variable v-last22 as integer no-undo .
     3056     find last gds-list use-index oi no-error.
     3057     if available gds-list then do:
     3058       v-last22 = gds-list.order-num .
     3059     end.
     3060     else do:
     3061       v-last22 = 0 .
     3062     end.
     3063     create gds-list .
     3064     buffer-copy buf_goods to gds-list
     3065     assign
     3066       gds-list.to-del = no
     3067       gds-list.order-num = v-last22 + 1
     3068     .
     3069     assign
     3070       lns-cnt = lns-cnt + 1
     3071       line-rec = recid (gds-list)
     3072     .
     3073   end.
     3074         output to value (f-name) append.
     3075         export
     3076         gds-list.prod-type
     3077         gds-list.prod-code
     3078         gds-list.artic
     3079         .
     3080         output close.
     3081         delete gds-list.
     3082       end.
     3083     GET next br-tax-rate-gds.
     3084   END.
     3085   run waitfram-hide in this-procedure .
     3086   reposition br-tax-rate-gds to recid v-gds-rec no-error .
     3087   APPLY "ENTRY" to br-tax-rate-gds in frame Dialog-Frame.
     3088   END PROCEDURE.
