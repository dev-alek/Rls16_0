     1933     define variable v-frame-virtual-width  as decimal   no-undo .
     1934     define variable v-browse-width         as decimal   no-undo .
     1935     define variable v-window-width         as decimal   no-undo .
     1936     define variable v-window-virtual-width as decimal   no-undo .
     1937     define variable v-change-sign          as integer   no-undo .
     1938     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1939     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1940     if p-change-value > 0
     1941     then do:
     1942       if frame Dialog-Frame :width + p-change-value >
     1943           session :width-chars
     1944       then do:
     1945         assign
     1946           p-change-value = session :width-chars - frame Dialog-Frame :width
     1947         .
     1948         if p-change-value <= 0
     1949         then do:
     1950           run diasize_position-resize-button in this-procedure .
     1951           return .
     1952         end.
     1953       end.
     1954     end.
     1955     if p-change-value < 0
     1956     then do:
     1957       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1958       then do:
     1959         assign
     1960           p-change-value = v-diasize-orig-frame-width
     1961                          - frame Dialog-Frame :width
     1962         .
     1963         if p-change-value >= 0
     1964         then do:
     1965           run diasize_position-resize-button in this-procedure .
     1966           return .
     1967         end.
     1968       end.
     1969     end.
     1970     if p-change-value >= 0
     1971     then do:
     1972       assign
     1973         v-change-sign = 1
     1974       .
     1975     end.
     1976     else do:
     1977       assign
     1978         v-change-sign = -1
     1979       .
     1980     end.
     1981     assign
     1982       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1983     .
     1984     if p-change-value = 0
     1985     then do:
     1986       run diasize_position-resize-button in this-procedure .
     1987       return .
     1988     end.
