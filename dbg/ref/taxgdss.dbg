     1913     .
     1914   end procedure.
     1915   procedure diasize_set-height :
     1916     define input  parameter p-new-height  as decimal   no-undo .
     1917     define input  parameter p-move-resize as logical   no-undo .
     1918     do
     1919     on error undo, return error return-value
     1920     :
     1921       run diasize_change-height in this-procedure
     1922         (input  (p-new-height - frame Dialog-Frame :height)
     1923         ,input  p-move-resize
     1924         ) .
     1925     end.
     1926   end procedure.
     1927   procedure diasize_change-width :
     1928     define input  parameter p-change-value as decimal   no-undo .
     1929     define input  parameter p-move-resize  as logical   no-undo .
     1930     define variable v-field-group-handle   as handle    no-undo .
