        1   DEFINE BUFFER LAST_tax-rate-gds FOR ub.tax-rate-gds.
        2   DEFINE NEW SHARED BUFFER X_goods FOR ub.goods.
        3   DEFINE BUFFER X_tax-rate-gds FOR ub.tax-rate-gds.
        4   define input parameter parparentproc as widget-handle no-undo .
        5   DEFINE INPUT PARAMETER BTTNS AS CHAR NO-UNDO.
        6   define input parameter p-list-mode as character no-undo .
        7   define input parameter p-tax-code as integer no-undo .
        8   define input parameter p-rate-code as integer no-undo .
        9   DEFINE INPUT-OUTPUT PARAMETER p-rid-list As character NO-UNDO.
       10   define variable vss-revision    as character no-undo init "$Revision$":u .
       11   define variable vss-author      as character no-undo init "$Author$":u .
       12   define variable vss-date        as character no-undo init "$Date$":u .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       14   define variable vss-archive     as character no-undo init "$Archive$":u .
       15   define variable vss-description as character no-undo init "Справочник ставки-товары по налогу" .
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   procedure proc-alt-shift-f2:
       77     if not ibs.th.gbl.gbl-var:rcode
       78   then
       79     run gbl\inidebug.p .
       80   end.
       81   procedure proc-alt-shift-f3:
       82     run gbl/prvssinf.p
       83       ( input this-procedure
       84       ) .
       85   end.
       86   define variable v-inform-launched as logical no-undo initial false .
       87   procedure proc-alt-shift-f4:
       88     define variable v-action as character no-undo .
       89     if v-inform-launched = false then do:
       90       assign
       91         v-inform-launched = true
       92       .
       93       run gbl/d-inform.w
       94         (  input self
       95         ,  input this-procedure
       96         , output v-action
       97         ) no-error .
       98       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       99       assign
      100         v-inform-launched = false
      101       .
      102     end.
      103   end.
      104   procedure proc-alt-f1:
      105     run gbl/corrhelp.p
      106       (input this-procedure
      107       ) .
      108   end .
      109   on alt-shift-f2 anywhere do:
      110     run proc-alt-shift-f2.
      111   end.
      112   on alt-shift-f3 anywhere do:
      113     run proc-alt-shift-f3 in this-procedure .
      114   end.
      115   on alt-shift-f4 anywhere do:
      116     run proc-alt-shift-f4 in this-procedure.
      117   end.
      118   on alt-f1 anywhere do:
      119     run proc-alt-f1 in this-procedure .
      120   end.
      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   define variable c-point  as character no-undo .
      123   define variable tbl      as character no-undo .
      124   define variable join-tbl as character no-undo .
      125   define variable fld      as character no-undo .
      126   define variable lab      as character no-undo .
      127   define variable spr      as character no-undo .
      128   define variable dim      as character no-undo .
      129   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   procedure cur-time :
      131      define output parameter p-today as date      no-undo .
      132      define output parameter p-time  as integer   no-undo .
      133     do
      134     on error undo, return error
      135     :
      136       define variable v-date1 as date      no-undo .
      137       define variable v-date2 as date      no-undo .
      138       define variable v-time  as integer   no-undo .
      139       assign
      140         v-date1 = today
      141         v-time  = time
      142         v-date2 = today
      143       .
      144       if v-date1 <> v-date2
      145       then do:
      146         assign
      147           v-date1 = today
      148           v-time  = v-time
      149         .
      150       end.
      151       assign
      152         p-today = v-date1
      153         p-time  = v-time
      154       .
      155     end.
      156   end.
      157   function cur-time-date returns character
      158   :
      159     return string(today, '99/99/9999':U) .
      160   end.
      161   function cur-time-mjd returns decimal
      162   :
      163     define variable v-date as date      no-undo .
      164     define variable v-time as integer   no-undo .
      165     run cur-time in this-procedure
      166       (output v-date
      167       ,output v-time
      168       ) .
      169     return integer(v-date) - 2400002 + (v-time / 86400) .
      170   end.
      171   function cur-time-get-ending-index returns integer
      172   (input p-number as integer
      173   )
      174   :
      175     if p-number < 0
      176     or p-number = ?
      177     then do:
      178       return 1 .
      179     end.
      180     define variable v-rest as integer   no-undo .
      181     assign
      182       p-number = p-number modulo 100
      183     .
      184     if p-number < 20
      185     then do:
      186       assign
      187         v-rest = p-number
      188       .
      189     end.
      190     else do:
      191       assign
      192         v-rest = p-number modulo 10
      193       .
      194     end.
      195     case v-rest :
      196       when 1
      197       then do:
      198         return 2 .
      199       end.
      200       when 2 or
      201       when 3 or
      202       when 4
      203       then do:
      204         return 3 .
      205       end.
      206       otherwise do:
      207         return 1 .
      208       end.
      209     end case .
      210   end.
      211   procedure cur-time-mjd-to-date :
      212      define input  parameter i-mjd-diff as decimal no-undo.
      213      define output parameter o-Date     as date    no-undo.
      214      define output parameter o-Time     as integer no-undo.
      215      define variable v-day-number as integer   no-undo .
      216      if    i-mjd-diff < 0
      217         or i-mjd-diff = ?
      218      then do:
      219         return "?" .
      220      end.
      221      assign
      222         v-day-number = truncate(i-mjd-diff,0).
      223         o-Date = date(v-day-number + 2400002).
      224         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      225     .
      226   end.
      227   function cur-time-mjd-to-string returns character
      228   (input p-mjd-diff as decimal
      229   )
      230   :
      231     define variable v-day-number as integer   no-undo .
      232     define variable v-seconds    as integer   no-undo .
      233     define variable v-hour       as integer   no-undo .
      234     define variable v-min        as integer   no-undo .
      235     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      236     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      237     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      238     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      239     if p-mjd-diff < 0
      240     or p-mjd-diff = ?
      241     then do:
      242       return "?" .
      243     end.
      244     assign
      245       v-day-number = integer(truncate(p-mjd-diff,0))
      246       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      247     .
      248     if v-seconds > 86400
      249     then do:
      250       assign
      251         v-seconds = 86400 - 1
      252       .
      253     end.
      254     if v-seconds < 0
      255     then do:
      256       assign
      257         v-seconds = 0
      258       .
      259     end.
      260     assign
      261       v-hour = truncate(v-seconds / 3600, 0)
      262     .
      263     assign
      264       v-seconds = v-seconds modulo 3600
      265     .
      266     assign
      267       v-min = truncate(v-seconds / 60, 0)
      268     .
      269     assign
      270       v-seconds = v-seconds modulo 60
      271     .
      272     return
      273         (if v-day-number <> 0
      274           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      275           else ""
      276         )
      277       + (if v-day-number <> 0 or v-hour <> 0
      278           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      279           else ""
      280         )
      281       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      282           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      283           else ""
      284         )
      285       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      286       .
      287   end.
      288   function cur-time-string returns character
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      297   end.
      298   function cur-time-string-sec returns character
      299   :
      300     define variable v-date as date      no-undo .
      301     define variable v-time as integer   no-undo .
      302     run cur-time in this-procedure
      303       (output v-date
      304       ,output v-time
      305       ) .
      306     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      307   end.
      308   function cur-time-custom  returns character
      309   (input p-prefix as character
      310   ,input p-date-format as character
      311   ,input p-delimiter as character
      312   ,input p-time-format as character
      313   ,input p-suffix as character
      314   )
      315   :
      316     define variable v-date as date      no-undo .
      317     define variable v-time as integer   no-undo .
      318     run cur-time in this-procedure
      319       (output v-date
      320       ,output v-time
      321       ) .
      322     return
      323       p-prefix
      324       + string(v-date, p-date-format)
      325       + p-delimiter
      326       + string(v-time, p-time-format)
      327       + p-suffix
      328       .
      329   end.
      330   function cur-time-print  returns character
      331   :
      332     define variable v-date as date      no-undo .
      333     define variable v-time as integer   no-undo .
      334     run cur-time in this-procedure
      335       (output v-date
      336       ,output v-time
      337       ) .
      338     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      339   end.
      340   function cur-time-datetime returns datetime
      341   :
      342     define variable v-char as character no-undo .
      343     define variable v-datetime as datetime no-undo .
      344     v-char = cur-time-string().
      345     v-datetime = datetime(v-char).
      346     return  v-datetime.
      347   end.
      348   function cur-time-string-msec returns character
      349   :
      350     define variable v-date as datetime  no-undo .
      351     v-date = now.
      352     return string(v-date) .
      353   end.
      354   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      355   procedure factord :
      356     define input  parameter p-fact-date            as date    no-undo .
      357     define input  parameter p-fact-time            as integer no-undo .
      358     define input  parameter p-fact-num             as integer no-undo .
      359     define input  parameter p-shift-date           as date    no-undo .
      360     define input  parameter p-shift-num            as integer no-undo .
      361     define input  parameter p-shift-on             as logical no-undo .
      362     define output parameter p-fact-order           as decimal no-undo .
      363     define output parameter p-shift-end-fact-order as decimal no-undo .
      364     define output parameter p-day-end-fact-order   as decimal no-undo .
      365     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      366     if p-fact-date = ?
      367     then do:
      368       return error "Не указана фактическая дата" .
      369     end.
      370     define variable v-fact-date-num as integer no-undo .
      371     assign
      372       v-fact-date-num = integer(p-fact-date)
      373     .
      374     if p-fact-num = ?
      375     or p-fact-num = 0
      376     then do:
      377       return error "Не задан p-fact-num " + string(p-fact-num) .
      378     end.
      379     if p-fact-num < 0
      380     then do:
      381       return error "Отрицательный fact-num " + string(p-fact-num) .
      382     end.
      383     if p-fact-num >= 100000000
      384     then do:
      385       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      386     end.
      387     if p-shift-on = true
      388     then do:
      389       if p-shift-date = ?
      390       then do:
      391         return error "Не задана дата смены" .
      392       end.
      393       if p-shift-num = ?
      394       or p-shift-num = 0
      395       then do:
      396         return error "Не задан номер смены" .
      397       end.
      398     end.
      399     else do:
      400       assign
      401         p-shift-date = p-fact-date
      402         p-shift-num  = 24
      403       .
      404     end.
      405     define variable v-shift-offset as integer no-undo .
      406     if p-shift-date = p-fact-date
      407     then do:
      408       assign
      409         v-shift-offset = 1
      410       .
      411     end.
      412     if p-shift-date < p-fact-date
      413     then do:
      414       assign
      415         v-shift-offset = 0
      416       .
      417     end.
      418     if p-shift-date > p-fact-date
      419     then do:
      420       message
      421         vss-workfile vss-revision vss-description skip
      422         "Неправильная дата закрытия смены" skip
      423         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      424         view-as alert-box error .
      425       undo, return error
      426         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      427           ,string(p-fact-date, '99/99/9999':U)
      428           ,string(p-shift-date, '99/99/9999':U)
      429           )
      430       .
      431     end.
      432     if p-shift-num < 1
      433     or p-shift-num > 24
      434     then do:
      435       message
      436         vss-workfile vss-revision vss-description skip
      437         "Неправильный номер смены" skip
      438         "p-shift-num" p-shift-num skip
      439         view-as alert-box error .
      440       undo, return error return-value .
      441     end.
      442     assign
      443       p-fact-order           = v-fact-date-num
      444                              + v-shift-offset * 0.5
      445                              + p-shift-num    * 0.02 - 0.01
      446                              + p-fact-num     * 0.0000000001
      447       p-shift-end-fact-order = v-fact-date-num
      448                              + v-shift-offset * 0.5
      449                              + p-shift-num    * 0.02
      450       p-day-end-fact-order   = v-fact-date-num
      451                              + 0.99
      452     .
      453     if p-fact-order           <= v-fact-date-num
      454     or p-shift-end-fact-order <= v-fact-date-num
      455     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      456     or p-shift-end-fact-order >= p-day-end-fact-order
      457     then do:
      458       message
      459         vss-workfile vss-revision vss-description skip
      460         "Внутренняя ошибка при генерации фактического номера" skip
      461         "p-fact-date"            p-fact-date            skip
      462         "p-fact-time"            p-fact-time            skip
      463         "p-fact-num"             p-fact-num             skip
      464         "p-shift-date"           p-shift-date           skip
      465         "p-shift-num"            p-shift-num            skip
      466         "p-shift-on"             p-shift-on             skip
      467         "p-shift-end-fact-order" p-shift-end-fact-order skip
      468         "p-day-end-fact-order"   p-day-end-fact-order   skip
      469         "v-fact-date-num"        v-fact-date-num        skip
      470         view-as alert-box error .
      471       undo, return error return-value .
      472     end.
      473   end procedure.
      474   procedure day-begin-fact-order :
      475     define input  parameter p-fact-date            as date    no-undo .
      476     define output parameter p-day-begin-fact-order as decimal no-undo .
      477     do
      478     on error undo, return error return-value
      479     :
      480       if p-fact-date = ?
      481       then do:
      482         assign
      483           p-day-begin-fact-order = 0
      484         .
      485       end.
      486       else do:
      487         assign
      488           p-day-begin-fact-order = integer(p-fact-date)
      489         .
      490       end.
      491     end.
      492   end procedure.
      493   procedure factord-max-fact-order :
      494     define output parameter p-max-fact-order as decimal   no-undo .
      495     do
      496     on error undo, return error return-value
      497     :
      498       run day-begin-fact-order in this-procedure
      499         (input  date(1, 1, 5000)
      500         ,output p-max-fact-order
      501         ) .
      502     end.
      503   end procedure.
      504   procedure factord-cut-archive :
      505     define input  parameter p-obj-type             as character no-undo .
      506     define input  parameter p-obj-code             as integer   no-undo .
      507     define input  parameter p-fact-date            as date      no-undo .
      508     define output parameter p-shift-on             as logical   no-undo .
      509     define output parameter p-shift-date           as date      no-undo .
      510     define output parameter p-shift-num            as integer   no-undo .
      511     define output parameter p-day-end-fact-order   as decimal   no-undo .
      512     define output parameter p-shift-end-fact-order as decimal   no-undo .
      513     define variable v-fact-order as decimal   no-undo .
      514     define buffer buf_shift-obj for ub.shift-obj .
      515     do
      516     on error undo, return error return-value
      517     :
      518   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      519   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      520     (input  p-obj-type
      521     ,input  p-obj-code
      522     ,input  'shift-on=request'
      523     ,output p-shift-on
      524     ) no-error .
      525       if error-status :error
      526       then do:
      527         message
      528           vss-workfile vss-revision vss-description skip
      529           "Ошибка при определении атрибута объекта" skip
      530           "Объект" p-obj-type p-obj-code skip
      531           error-status :get-message(1) skip
      532           return-value skip
      533           view-as alert-box error .
      534         undo, return error return-value .
      535       end.
      536       if p-shift-on = false
      537       then do:
      538         assign
      539           p-shift-date               = ?
      540           p-shift-num                = 0
      541         .
      542       end.
      543       else do:
      544         find first buf_shift-obj share-lock
      545           where buf_shift-obj.obj-type   = p-obj-type
      546             and buf_shift-obj.obj-code   = p-obj-code
      547             and buf_shift-obj.shift-date > p-fact-date
      548           use-index pi
      549           no-error .
      550         if not available buf_shift-obj
      551         or buf_shift-obj.status_ <> 'зкр':U
      552         then do:
      553           message
      554             vss-workfile vss-revision vss-description skip
      555             "Невозможно вычислить последнюю смену" skip
      556             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      557             "Объект" p-obj-type p-obj-code skip
      558             "Дата" p-fact-date skip
      559             view-as alert-box error .
      560           undo, return error return-value .
      561         end.
      562         find last buf_shift-obj share-lock
      563           where buf_shift-obj.obj-type = p-obj-type
      564             and buf_shift-obj.obj-code = p-obj-code
      565             and buf_shift-obj.shift-date <= p-fact-date
      566           use-index pi
      567           no-error .
      568         if available buf_shift-obj
      569         then do:
      570           if  buf_shift-obj.status_ = 'зкр':U
      571           then do:
      572             assign
      573               p-shift-date = buf_shift-obj.shift-date
      574               p-shift-num  = buf_shift-obj.shift-num
      575             .
      576           end.
      577           else do:
      578             message
      579               vss-workfile vss-revision vss-description skip
      580               "Невозможно вычислить последнюю смену" skip
      581               "Статус смены отличен от статуса" 'зкр':U skip
      582               "Объект" p-obj-type p-obj-code skip
      583               "Дата" p-fact-date skip
      584               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      585               view-as alert-box error .
      586             undo, return error return-value .
      587           end.
      588         end.
      589         else do:
      590           assign
      591             p-shift-date = p-fact-date - 1
      592             p-shift-num  = 1
      593           .
      594         end.
      595       end.
      596       run factord in this-procedure
      597         (input  p-fact-date
      598         ,input  1
      599         ,input  1
      600         ,input  p-shift-date
      601         ,input  p-shift-num
      602         ,input  p-shift-on
      603         ,output v-fact-order
      604         ,output p-shift-end-fact-order
      605         ,output p-day-end-fact-order
      606         ) no-error .
      607       if error-status :error
      608       then do:
      609         message
      610           vss-workfile vss-revision vss-description skip
      611           "Ошибка при вызове процедуры factord"
      612           error-status :get-message(1) skip
      613           return-value skip
      614           view-as alert-box error .
      615         undo, return error return-value .
      616       end.
      617     end.
      618   end procedure.
      619   procedure factord-lock-shift :
      620     define input  parameter p-obj-type  as character no-undo .
      621     define input  parameter p-obj-code  as integer   no-undo .
      622     define input  parameter p-fact-date as date      no-undo .
      623     define parameter buffer buf_shift-obj for ub.shift-obj .
      624     define variable v-shift-on      as logical   no-undo .
      625     define variable v-extra-message as character no-undo .
      626     define variable v-error as character no-undo .
      627     do
      628     on error undo, return error return-value
      629     :
      630   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      631   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      632     (input  p-obj-type
      633     ,input  p-obj-code
      634     ,input  'shift-on=request'
      635     ,output v-shift-on
      636     ) no-error .
      637       if error-status :error
      638       then do:
      639         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      640         undo, return error v-error .
      641       end.
      642       if v-shift-on = true
      643       then do:
      644         find first buf_shift-obj share-lock
      645           where buf_shift-obj.obj-type   = p-obj-type
      646             and buf_shift-obj.obj-code   = p-obj-code
      647             and buf_shift-obj.shift-date > p-fact-date
      648           use-index pi
      649           no-error .
      650         if not available buf_shift-obj
      651         or buf_shift-obj.status_ <> 'зкр':U
      652         then do:
      653           find last buf_shift-obj
      654             where buf_shift-obj.obj-type = p-obj-type
      655               and buf_shift-obj.obj-code = p-obj-code
      656               and buf_shift-obj.status_  = 'зкр':U
      657             use-index stts
      658             no-error .
      659           if available buf_shift-obj
      660           then do:
      661             assign
      662               v-extra-message =
      663                     substitute("Дата начала последеней закрытой смены на объекте &1"
      664                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      665                               )
      666             .
      667           end.
      668           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      669           undo, return error v-error .
      670         end.
      671       end.
      672     end.
      673   end procedure.
      674   procedure factord-end-day :
      675     define input  parameter p-fact-date            as date    no-undo .
      676     define output parameter p-day-end-fact-order   as decimal no-undo .
      677     do
      678     on error undo, return error return-value
      679     :
      680       if p-fact-date = ?
      681       then do:
      682         return error "Не указана фактическая дата" .
      683       end.
      684       assign
      685         p-day-end-fact-order = integer(p-fact-date) + 0.99
      686       .
      687     end.
      688   end procedure.
      689   procedure factord-to-date :
      690     define input  parameter p-fact-order as decimal no-undo .
      691     define output parameter p-fact-date  as date    no-undo .
      692     define variable v-ref-date  as date      no-undo .
      693     define variable v-ref-delta as integer   no-undo .
      694     do
      695     on error undo, return error return-value
      696     :
      697       if p-fact-order = ?
      698       or p-fact-order = 0
      699       then do:
      700         return error "Не указан fact-order" .
      701       end.
      702       assign
      703         v-ref-date  = date(1, 1, 2000)
      704       .
      705       assign
      706         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      707       .
      708       assign
      709         p-fact-date = v-ref-date + v-ref-delta
      710       .
      711     end.
      712   end procedure.
      713   procedure factord-to-fact-num :
      714     define input  parameter p-fact-order as decimal no-undo .
      715     define output parameter p-fact-num   as integer no-undo .
      716     define variable v-fact-order-trunc as decimal no-undo .
      717     do
      718     on error undo, return error return-value
      719     :
      720       if p-fact-order = ?
      721       or p-fact-order = 0
      722       then do:
      723         return error "Не указан fact-order" .
      724       end.
      725       assign
      726        v-fact-order-trunc = truncate(p-fact-order, 2)
      727       .
      728       assign
      729         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      730       .
      731     end.
      732   end procedure.
      733   procedure factord-to-shift-num :
      734     define input  parameter p-fact-order as decimal no-undo .
      735     define output parameter p-shift-num   as integer no-undo .
      736     define variable  p-shift-numd  as decimal   no-undo .
      737     define variable v-fact-order-trunc as decimal no-undo .
      738     do
      739     on error undo, return error return-value
      740     :
      741       if p-fact-order = ?
      742       or p-fact-order = 0
      743       then do:
      744         return error "Не указан fact-order" .
      745       end.
      746       assign
      747        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      748       .
      749       if v-fact-order-trunc < 0.5 then do:
      750         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      751       end.
      752       assign
      753         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      754         .
      755        assign
      756         p-shift-num = truncate (p-shift-numd , 0)
      757       .
      758     end.
      759   end procedure.
      760   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      761   procedure fltfield-clear :
      762     define output parameter loc-fld as character no-undo.
      763     define output parameter loc-lab as character no-undo .
      764     define output parameter loc-spr as character no-undo .
      765     define output parameter loc-dim as character no-undo .
      766     assign
      767       loc-fld = ""
      768       loc-lab = ""
      769       loc-spr = ""
      770       loc-dim = "0"
      771     .
      772   end procedure .
      773   procedure fltfield-add :
      774     define input        parameter par-fld as character no-undo.
      775     define input        parameter par-lab as character no-undo .
      776     define input        parameter par-spr as character no-undo .
      777     define input-output parameter loc-fld as character no-undo.
      778     define input-output parameter loc-lab as character no-undo .
      779     define input-output parameter loc-spr as character no-undo .
      780     define input-output parameter loc-dim as character no-undo .
      781     do
      782     on error undo, return error
      783     :
      784       assign
      785       loc-fld = if loc-dim = '0'
      786                 then par-fld
      787                 else (loc-fld + chr(44) + par-fld)
      788       loc-lab = if loc-dim = '0'
      789                 then par-lab
      790                 else (loc-lab + chr(44) + par-lab)
      791       loc-spr = if loc-dim = '0'
      792                 then par-spr
      793                 else (loc-spr + chr(44) + par-spr)
      794       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      795                 string(integer(if num-entries(loc-dim) > 1
      796                               then entry(2, loc-dim)
      797                               else entry(1, loc-dim)
      798                               ) + 1)
      799       no-error
      800       .
      801     end.
      802   end procedure.
      803   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      804   define variable v-waitfram-action01         as character   no-undo .
      805   define variable v-waitfram-action02         as character   no-undo .
      806   define variable v-waitfram-action03         as character   no-undo .
      807   define variable mWaitFramTextBeg            as character   no-undo.
      808   define variable mWaitFramTextEnd            as character   no-undo.
      809   define variable mWaitFramView               as logical     no-undo.
      810   define variable mWaitProcEvent              as logical     no-undo init yes.
      811   define variable mWaitFramInterval           as integer     no-undo init 1 .
      812   define variable mWaitFramStop               as logical     no-undo.
      813   define variable mWaitFramStopUser           as logical     no-undo.
      814   define variable mWaitFramStopTimeOut        as logical     no-undo.
      815   define variable mWaitFramStartProc          as datetime-tz no-undo.
      816   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      817   define button B-WaitFramStop auto-end-key
      818        label "Стоп"
      819        size 10 by 1 tooltip "Остоновить процесс".
      820   define button B-viewProcInfo
      821        label "Информация"
      822        size 15 by 1 tooltip "Информация о процесс".
      823   define frame waitfram
      824     v-waitfram-action01 format "x(72)" no-label skip
      825     v-waitfram-action02 format "x(72)" no-label skip
      826     v-waitfram-action03 format "x(72)" no-label skip
      827     B-viewProcInfo
      828     B-WaitFramStop at row 4 col 30
      829     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      830     .
      831   define new global shared variable mBatchMode as logical no-undo init ?.
      832   define variable mFramBachModHandle as handle no-undo.
      833   mFramBachModHandle = frame waitfram:handle.
      834   define variable mFameOldVis as logical no-undo.
      835   define variable mVisCUrentVin as logical no-undo.
      836   if session:batch-mode
      837   then
      838      mBatchMode = yes.
      839   if mBatchMode = ? then do:
      840     mVisCUrentVin = current-window:visible.
      841     mFameOldVis = mFramBachModHandle:visible.
      842     mFramBachModHandle:visible  = yes.
      843     mBatchMode = mFramBachModHandle:visible ne yes.
      844     mFramBachModHandle:visible = mFameOldVis.
      845     current-window:visible = mVisCUrentVin.
      846   end.
      847    if  log-manager:logfile-name ne ?
      848     then DO:
      849         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      850         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      851         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      852     end.
      853   on choose of B-WaitFramStop in frame waitfram
      854   do:
      855     mWaitFramStop = yes.
      856     mWaitFramStopUser = yes.
      857   end.
      858   function waitfram-check-timeout returns logical():
      859      define variable vtime as int64 no-undo.
      860      if mWaitFramStopTimeOut
      861      then
      862         return yes.
      863      vtime = ( now - mWaitFramStartProc ) / 1000 .
      864      if     mWaitFramTimeOut ne ?
      865         and mWaitFramTimeOut ne 0
      866         and mWaitFramTimeOut lt vtime
      867      then do:
      868         mWaitFramStopTimeOut = yes.
      869      end.
      870      return mWaitFramStopTimeOut.
      871   end.
      872   procedure waitfram-hide :
      873     if not session:batch-mode
      874     then do
      875     on error undo, return error return-value
      876     :
      877       pause 0 before-hide .
      878       if not mBatchMode then
      879         hide frame waitfram .
      880     if     not mWaitFramView
      881        and mWaitProcEvent
      882     then
      883       process events .
      884     end.
      885   end procedure.
      886   procedure waitfram-show :
      887     define input  parameter p-message as character no-undo .
      888     define variable v-left-margin as integer   no-undo .
      889     if not session:batch-mode
      890     then do
      891     on error undo, return error return-value
      892     :
      893       if length(p-message) <= 70 then do:
      894         assign
      895           v-left-margin = integer((70 - length(p-message)) / 2)
      896         .
      897         assign
      898           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      899         .
      900         assign
      901           v-waitfram-action01 = " "
      902           v-waitfram-action02 = " "
      903                                    + fill(" ", v-left-margin)
      904                                    + p-message
      905           v-waitfram-action03 = " "
      906         .
      907       end.
      908       else do:
      909         define variable vRindex1 as integer no-undo.
      910         define variable vRindex2 as integer no-undo.
      911         vRindex1 = r-index(p-message," ",70).
      912         if vRindex1 = 0
      913         then
      914            vRindex1 = 70.
      915         if length(p-message)  <= vRindex1 + 70 then do:
      916           assign
      917             v-waitfram-action01 = " "
      918             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      919             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      920           .
      921         end.
      922         else do:
      923           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      924           if vRindex2 <= vRindex1
      925           then
      926              vRindex2 = vRindex1 + 70.
      927           assign
      928             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      929             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      930             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      931           .
      932         end.
      933       end.
      934       B-viewProcInfo:visible   in frame waitfram = no.
      935       B-viewProcInfo:sensitive in frame waitfram = no.
      936       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      937       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      938       if  (   mWaitFramView
      939          or  mWaitProcEvent)
      940          and not mBatchMode
      941       then
      942          display
      943             v-waitfram-action01 skip
      944             v-waitfram-action02 skip
      945             v-waitfram-action03 skip
      946          with frame waitfram .
      947       if     mWaitFramView
      948          then do:
      949             if     mWaitFramInterval ne ?
      950                and not mBatchMode
      951             then
      952                wait-for go of frame waitfram pause mWaitFramInterval.
      953          end.
      954          else
      955             if     mWaitProcEvent
      956                and not mBatchMode
      957             then
      958                process events .
      959     end.
      960   end procedure.
      961      procedure waitfram-show-this:
      962         define input  parameter iInterval as int64 no-undo.
      963         define variable vtime as int64 no-undo.
      964         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      965         mWaitFramInterval = iInterval.
      966         run waitfram-show (substitute("&1&2 &3&4" ,
      967                                       mWaitFramTextBeg ,
      968                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      969                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      970                                       mWaitFramTextEnd
      971                                      )
      972                           ).
      973      end.
      974      procedure WaitFramRunPause:
      975         define input  parameter iInterval as dec no-undo.
      976         define variable vStart  as datetime-tz no-undo.
      977         define variable vend    as datetime-tz no-undo.
      978         define variable vint as int64 no-undo.
      979         define variable vOk as logical no-undo.
      980         vStart = now.
      981         vend   = vStart.
      982         publish "WaitFramPause" (iInterval,output vOk).
      983         vend   =  now.
      984         vint = vend - vStart.
      985         vint = iInterval - vint / 1000.
      986         if     not mWaitFramStop
      987            and (   vint > 0
      988                 or (    not vOk
      989                     and iInterval eq ?
      990                     )
      991                 )
      992         then
      993            run waitfram-show-this (iInterval).
      994         vend   =  now.
      995         vint = vend - vStart.
      996         vint = iInterval - vint / 1000.
      997         if     not mWaitFramStop
      998            and vint > 0
      999         then do:
     1000            run gbl/pause.p (vint * 1000).
     1001         end.
     1002         if iInterval ne ?
     1003         then
     1004            publish "WaitFramStop".
     1005         waitfram-check-timeout().
     1006      end.
     1007      procedure WaitFramWaitFor:
     1008         define input  parameter iInterval as dec no-undo.
     1009         assign
     1010            mWaitFramStartProc   = now
     1011            mWaitFramStopUser    = no
     1012            mWaitFramStopTimeOut = no
     1013         .
     1014         block-wait:
     1015         do while not mWaitFramStop:
     1016            run WaitFramRunPause (iInterval).
     1017            if  waitfram-check-timeout()
     1018            then do:
     1019               leave block-wait.
     1020            end.
     1021         end.
     1022         run waitfram-hide.
     1023      end.
     1024   procedure waitfram-join :
     1025     define input  parameter p-line-1  as character no-undo .
     1026     define input  parameter p-line-2  as character no-undo .
     1027     define input  parameter p-line-3  as character no-undo .
     1028     define output parameter p-message as character no-undo .
     1029     do
     1030     on error undo, return error return-value
     1031     :
     1032       assign
     1033         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1034                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1035                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1036       .
     1037     end.
     1038   end procedure.
     1039   function waitfram-join-function returns character
     1040     (input p-line-1 as character
     1041     ,input p-line-2 as character
     1042     ,input p-line-3 as character
     1043     ).
     1044     define variable v-message as character no-undo .
     1045     run waitfram-join in this-procedure
     1046       (input  p-line-1
     1047       ,input  p-line-2
     1048       ,input  p-line-3
     1049       ,output v-message
     1050       ) .
     1051     return v-message .
     1052   end function .
     1053   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1054   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1055   procedure fltopend_fltopend :
     1056   define input parameter p-parent-handle as handle no-undo .
     1057   define input parameter p-qh as handle no-undo .
     1058   define input parameter p-flt-open-open-query  as character no-undo .
     1059   define input parameter p-where-cond as character no-undo .
     1060   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1061   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1062   define input parameter p-indexed-reposition as character no-undo .
     1063     do
     1064     on error undo, return error
     1065     :
     1066   define variable v-prepare-string as character no-undo .
     1067   define variable glog as logical no-undo .
     1068   assign
     1069   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1070                      p-where-cond + chr(32)  +
     1071                      p-use-indFIRST-query-tail + chr(32) +
     1072                      p-use-ind-sort-clmn-by + chr(32) +
     1073                      p-indexed-reposition
     1074   .
     1075   assign
     1076   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1077   if not glog
     1078   or error-status:error then do:
     1079     message error-status:get-message(1) view-as alert-box .
     1080     undo, return error .
     1081   end.
     1082   assign
     1083   glog = p-qh:query-open no-error .
     1084   if not glog
     1085   or error-status:error then do:
     1086     message error-status:get-message(1) view-as alert-box .
     1087     undo, return error .
     1088   end.
     1089     end.
     1090   end procedure.
     1091   procedure fltopend_fltfindd :
     1092   define input parameter p-parent-handle as handle no-undo .
     1093   define input parameter p-qh as handle no-undo .
     1094   define input parameter p-rowid as rowid no-undo .
     1095   define input parameter p-next as logical no-undo .
     1096   define input parameter p-lock as integer no-undo .
     1097   define input parameter p-bh as handle no-undo .
     1098   define input parameter p-where-cond as character no-undo .
     1099   define input parameter p-use-index-phrase as character no-undo .
     1100   define variable glog as logical no-undo .
     1101   define variable v-qh as handle no-undo .
     1102   define variable v-bh as handle no-undo .
     1103   define variable v-recid as recid no-undo .
     1104   define variable v-prepare-string as character no-undo .
     1105   do
     1106   on error undo, return error
     1107   on stop undo, return error
     1108   :
     1109     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1110     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1111     create query v-qh.
     1112     v-qh:set-buffers(v-bh).
     1113     v-prepare-string = substitute("for each &1 &2 &3"
     1114                                     ,v-bh:name
     1115                                     ,p-where-cond
     1116                                     ,p-use-index-phrase).
     1117     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1118     if not glog then do:
     1119       delete object v-qh.
     1120       delete object v-bh.
     1121       undo, return error .
     1122     end.
     1123     glog = v-qh:query-open no-error .
     1124     if not glog then do:
     1125       delete object v-qh.
     1126       delete object v-bh.
     1127       undo, return error .
     1128     end.
     1129     if p-next then do:
     1130       v-qh:reposition-to-rowid(p-rowid) no-error .
     1131       glog = v-qh:get-next( p-lock) no-error .
     1132       glog = v-qh:get-next( p-lock) no-error .
     1133       if not glog or v-qh:query-off-end = yes then do:
     1134         glog = v-qh:get-first( p-lock) no-error .
     1135       end.
     1136     end.
     1137     else do:
     1138       glog = v-qh:get-first( p-lock) no-error .
     1139     end.
     1140     v-recid = v-bh:recid no-error .
     1141     delete object v-qh.
     1142     delete object v-bh.
     1143     return string(v-recid) .
     1144   end.
     1145   end procedure.
     1146   procedure fltopend_fltfindq :
     1147   define input parameter p-parent-handle as handle no-undo .
     1148   define input parameter p-qh as handle no-undo .
     1149   define input parameter p-next as logical no-undo .
     1150   define input parameter p-lock as integer no-undo .
     1151   define input parameter p-flt-open-open-query  as character no-undo .
     1152   define input parameter p-where-cond as character no-undo .
     1153   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1154   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1155   define input parameter p-indexed-reposition as character no-undo .
     1156   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1157   define variable glog as logical no-undo .
     1158   define variable v-qh as handle no-undo .
     1159   define variable v-bh as handle no-undo extent 18.
     1160   define variable v-rowid as rowid no-undo extent 18.
     1161   define variable v-ii as integer no-undo .
     1162   define variable v-prepare-string as character no-undo .
     1163   do
     1164   on error undo, return error
     1165   on stop undo, return error
     1166   :
     1167     create query v-qh.
     1168     do v-ii = 1 to p-qh:num-buffers:
     1169       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1170       assign
     1171       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1172       no-error.
     1173       v-qh:add-buffer(v-bh[v-ii]).
     1174     end.
     1175     assign
     1176     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1177                       p-where-cond + chr(32)  +
     1178                       p-use-indFIRST-query-tail + chr(32) +
     1179                       p-use-ind-sort-clmn-by + chr(32) +
     1180                       p-indexed-reposition
     1181     .
     1182     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1183     if not glog then do:
     1184       delete object v-qh.
     1185       do v-ii = 1 to p-qh:num-buffers:
     1186         delete object v-bh[v-ii].
     1187       end.
     1188       undo, return error .
     1189     end.
     1190     glog = v-qh:query-open no-error .
     1191     if not glog then do:
     1192       delete object v-qh.
     1193       do v-ii = 1 to p-qh:num-buffers:
     1194         delete object v-bh[v-ii].
     1195       end.
     1196       undo, return error .
     1197     end.
     1198     if p-next then do:
     1199       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1200       glog = v-qh:get-next( p-lock) no-error .
     1201       glog = v-qh:get-next( p-lock) no-error .
     1202       if not glog or v-qh:query-off-end = yes then do:
     1203         glog = v-qh:get-first( p-lock) no-error .
     1204       end.
     1205     end.
     1206     else do:
     1207       glog = v-qh:get-first( p-lock) no-error .
     1208     end.
     1209     do v-ii = 1 to p-qh:num-buffers:
     1210       assign
     1211       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1212       no-error.
     1213     end.
     1214     delete object v-qh.
     1215     do v-ii = 1 to p-qh:num-buffers:
     1216       delete object v-bh[v-ii].
     1217     end.
     1218   end.
     1219   end procedure.
