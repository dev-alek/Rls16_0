      283   procedure userobjs_select-many :
      284     define input  parameter parparentproc   as widget-handle no-undo .
      285     define input  parameter p-db-num        as integer   no-undo .
      286     define input  parameter p-user-id       as character no-undo .
      287     define input  parameter p-host-code-obj as integer   no-undo .
      288     define input  parameter p-obj-type      as character no-undo .
      289     define input  parameter p-obj-code      as integer   no-undo .
      290     define output parameter p-user-select   as logical   no-undo .
