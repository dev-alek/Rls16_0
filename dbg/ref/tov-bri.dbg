      141   define temp-table userobjs_temp-user-obj no-undo
      142     field obj-type as character
      143     field obj-code as integer
      144     index xpk is primary unique obj-type obj-code
      145     .
      146   procedure userobjs_clear :
      147     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      148     do
      149     on error undo, return error return-value
      150     :
      151       for each buf_userobjs_temp-user-obj
      152       on error undo, return error return-value
      153       :
      154         delete buf_userobjs_temp-user-obj .
      155       end.
      156     end.
      157   end .
      158   procedure userobjs_object-count :
      159     define output parameter p-total-count as integer   no-undo .
      160     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      161     do
      162     on error undo, return error return-value
      163     :
      164       assign
      165         p-total-count = 0
      166       .
      167       for each buf_userobjs_temp-user-obj
      168       on error undo, return error return-value
      169       :
      170         assign
      171           p-total-count = p-total-count + 1
      172         .
      173       end.
      174     end.
      175   end.
      176   procedure userobjs_append :
      177      define input  parameter p-obj-type as character no-undo .
      178      define input  parameter p-obj-code as integer   no-undo .
      179     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      180     do
      181     on error undo, return error return-value
      182     :
      183       find first buf_userobjs_temp-user-obj
      184         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      185           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      186         no-error .
      187       if not available buf_userobjs_temp-user-obj
      188       then do:
      189         create buf_userobjs_temp-user-obj .
      190         assign
      191           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      192           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      193         .
      194       end.
      195     end.
      196   end.
      197   procedure userobjs_object-exist :
      198     define output parameter p-object-exist as logical   no-undo .
      199     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      200     do
      201     on error undo, return error return-value
      202     :
      203       find first buf_userobjs_temp-user-obj
      204         no-error .
      205       if not available buf_userobjs_temp-user-obj
      206       then do:
      207         assign
      208           p-object-exist = false
      209         .
      210       end.
      211       else do:
      212         assign
      213           p-object-exist = true
      214         .
      215       end.
      216     end.
      217   end.
      218   procedure userobjs_transfer :
      219     define input  parameter p-callback-handle as handle no-undo .
      220     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      221     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      222     do
      223     on error undo, return error return-value
      224     :
      225       if valid-handle(p-callback-handle) <> true
      226       then do:
      227         message
      228           vss-workfile vss-revision vss-description skip
      229           "Ошибка задания входных параметров" skip
      230           "Неизвестный указатель на процедуру" skip
      231           view-as alert-box error .
      232         undo, return error return-value .
      233       end.
      234       if p-callback-handle :get-signature("userobjs_append") = ""
      235       then do:
      236         message
      237           vss-workfile vss-revision vss-description skip
      238           "Ошибка задания входных параметров" skip
      239           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      240                     ,p-callback-handle :file-name
      241                     ) skip
      242           view-as alert-box error .
      243         undo, return error return-value .
      244       end.
      245       for each buf_userobjs_temp-user-obj
      246       on error undo, return error return-value
      247       :
      248         run userobjs_append in p-callback-handle
      249           (input  buf_userobjs_temp-user-obj.obj-type
      250           ,input  buf_userobjs_temp-user-obj.obj-code
      251           ) .
      252       end.
      253     end.
      254   end procedure.
      255   procedure userobjs_select-one :
      256      define input  parameter parparentproc     as widget-handle no-undo .
      257      define input  parameter p-db-num          as integer   no-undo .
      258      define input  parameter p-user-id         as character no-undo .
      259      define input  parameter p-host-code-obj   as integer   no-undo .
      260      define input  parameter p-obj-type        as character no-undo .
      261      define input  parameter p-obj-code        as integer   no-undo .
      262      define output parameter p-user-select     as logical   no-undo .
      263      define output parameter p-select-obj-type as character no-undo .
