      311   procedure thobjs :
      312      define input        parameter parparentproc     as widget-handle no-undo .
      313      define input        parameter i-bttns           as character     no-undo .
      314      define input        parameter i-list-mode       as character     no-undo.
      315      define input        parameter i-obj-type        as character     no-undo.
      316      define input        parameter i-db-num          as integer       no-undo.
      317      define input        parameter i-host-code       as integer       no-undo.
      318      define input-output parameter p-rid-list        as character     no-undo .
      319   run ref/thobjs.p
      320           ( input parparentproc
      321            ,input  this-procedure :handle
      322           , input i-bttns
      323           , input i-list-mode
      324           , input i-obj-type
      325           , input i-db-num
      326           , input i-host-code
      327           , input-output p-rid-list ) no-error .
      328   end.
      329   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      330   procedure factord :
      331     define input  parameter p-fact-date            as date    no-undo .
      332     define input  parameter p-fact-time            as integer no-undo .
      333     define input  parameter p-fact-num             as integer no-undo .
      334     define input  parameter p-shift-date           as date    no-undo .
      335     define input  parameter p-shift-num            as integer no-undo .
      336     define input  parameter p-shift-on             as logical no-undo .
      337     define output parameter p-fact-order           as decimal no-undo .
      338     define output parameter p-shift-end-fact-order as decimal no-undo .
      339     define output parameter p-day-end-fact-order   as decimal no-undo .
      340     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      341     if p-fact-date = ?
      342     then do:
      343       return error "Не указана фактическая дата" .
      344     end.
      345     define variable v-fact-date-num as integer no-undo .
      346     assign
      347       v-fact-date-num = integer(p-fact-date)
      348     .
      349     if p-fact-num = ?
      350     or p-fact-num = 0
      351     then do:
      352       return error "Не задан p-fact-num " + string(p-fact-num) .
      353     end.
      354     if p-fact-num < 0
      355     then do:
      356       return error "Отрицательный fact-num " + string(p-fact-num) .
      357     end.
      358     if p-fact-num >= 100000000
      359     then do:
      360       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      361     end.
      362     if p-shift-on = true
      363     then do:
      364       if p-shift-date = ?
      365       then do:
      366         return error "Не задана дата смены" .
      367       end.
      368       if p-shift-num = ?
      369       or p-shift-num = 0
      370       then do:
      371         return error "Не задан номер смены" .
      372       end.
      373     end.
      374     else do:
      375       assign
      376         p-shift-date = p-fact-date
      377         p-shift-num  = 24
      378       .
      379     end.
      380     define variable v-shift-offset as integer no-undo .
      381     if p-shift-date = p-fact-date
      382     then do:
      383       assign
      384         v-shift-offset = 1
      385       .
      386     end.
      387     if p-shift-date < p-fact-date
      388     then do:
      389       assign
      390         v-shift-offset = 0
      391       .
      392     end.
      393     if p-shift-date > p-fact-date
      394     then do:
      395       message
      396         vss-workfile vss-revision vss-description skip
      397         "Неправильная дата закрытия смены" skip
      398         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      399         view-as alert-box error .
      400       undo, return error
      401         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      402           ,string(p-fact-date, '99/99/9999':U)
      403           ,string(p-shift-date, '99/99/9999':U)
      404           )
      405       .
      406     end.
      407     if p-shift-num < 1
      408     or p-shift-num > 24
      409     then do:
      410       message
      411         vss-workfile vss-revision vss-description skip
      412         "Неправильный номер смены" skip
      413         "p-shift-num" p-shift-num skip
      414         view-as alert-box error .
      415       undo, return error return-value .
      416     end.
      417     assign
      418       p-fact-order           = v-fact-date-num
      419                              + v-shift-offset * 0.5
      420                              + p-shift-num    * 0.02 - 0.01
      421                              + p-fact-num     * 0.0000000001
      422       p-shift-end-fact-order = v-fact-date-num
      423                              + v-shift-offset * 0.5
      424                              + p-shift-num    * 0.02
      425       p-day-end-fact-order   = v-fact-date-num
      426                              + 0.99
      427     .
      428     if p-fact-order           <= v-fact-date-num
      429     or p-shift-end-fact-order <= v-fact-date-num
      430     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      431     or p-shift-end-fact-order >= p-day-end-fact-order
      432     then do:
      433       message
      434         vss-workfile vss-revision vss-description skip
      435         "Внутренняя ошибка при генерации фактического номера" skip
      436         "p-fact-date"            p-fact-date            skip
      437         "p-fact-time"            p-fact-time            skip
      438         "p-fact-num"             p-fact-num             skip
      439         "p-shift-date"           p-shift-date           skip
      440         "p-shift-num"            p-shift-num            skip
      441         "p-shift-on"             p-shift-on             skip
      442         "p-shift-end-fact-order" p-shift-end-fact-order skip
      443         "p-day-end-fact-order"   p-day-end-fact-order   skip
      444         "v-fact-date-num"        v-fact-date-num        skip
      445         view-as alert-box error .
      446       undo, return error return-value .
      447     end.
      448   end procedure.
      449   procedure day-begin-fact-order :
      450     define input  parameter p-fact-date            as date    no-undo .
      451     define output parameter p-day-begin-fact-order as decimal no-undo .
      452     do
      453     on error undo, return error return-value
      454     :
      455       if p-fact-date = ?
      456       then do:
      457         assign
      458           p-day-begin-fact-order = 0
      459         .
      460       end.
      461       else do:
      462         assign
      463           p-day-begin-fact-order = integer(p-fact-date)
      464         .
      465       end.
      466     end.
      467   end procedure.
      468   procedure factord-max-fact-order :
      469     define output parameter p-max-fact-order as decimal   no-undo .
      470     do
      471     on error undo, return error return-value
      472     :
      473       run day-begin-fact-order in this-procedure
      474         (input  date(1, 1, 5000)
      475         ,output p-max-fact-order
      476         ) .
      477     end.
      478   end procedure.
      479   procedure factord-cut-archive :
      480     define input  parameter p-obj-type             as character no-undo .
      481     define input  parameter p-obj-code             as integer   no-undo .
      482     define input  parameter p-fact-date            as date      no-undo .
      483     define output parameter p-shift-on             as logical   no-undo .
      484     define output parameter p-shift-date           as date      no-undo .
      485     define output parameter p-shift-num            as integer   no-undo .
      486     define output parameter p-day-end-fact-order   as decimal   no-undo .
      487     define output parameter p-shift-end-fact-order as decimal   no-undo .
      488     define variable v-fact-order as decimal   no-undo .
      489     define buffer buf_shift-obj for ub.shift-obj .
      490     do
      491     on error undo, return error return-value
      492     :
      493   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      494   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      495     (input  p-obj-type
      496     ,input  p-obj-code
      497     ,input  'shift-on=request'
      498     ,output p-shift-on
      499     ) no-error .
      500       if error-status :error
      501       then do:
      502         message
      503           vss-workfile vss-revision vss-description skip
      504           "Ошибка при определении атрибута объекта" skip
      505           "Объект" p-obj-type p-obj-code skip
      506           error-status :get-message(1) skip
      507           return-value skip
      508           view-as alert-box error .
      509         undo, return error return-value .
      510       end.
      511       if p-shift-on = false
      512       then do:
      513         assign
      514           p-shift-date               = ?
      515           p-shift-num                = 0
      516         .
      517       end.
      518       else do:
      519         find first buf_shift-obj share-lock
      520           where buf_shift-obj.obj-type   = p-obj-type
      521             and buf_shift-obj.obj-code   = p-obj-code
      522             and buf_shift-obj.shift-date > p-fact-date
      523           use-index pi
      524           no-error .
      525         if not available buf_shift-obj
      526         or buf_shift-obj.status_ <> 'зкр':U
      527         then do:
      528           message
      529             vss-workfile vss-revision vss-description skip
      530             "Невозможно вычислить последнюю смену" skip
      531             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      532             "Объект" p-obj-type p-obj-code skip
      533             "Дата" p-fact-date skip
      534             view-as alert-box error .
      535           undo, return error return-value .
      536         end.
      537         find last buf_shift-obj share-lock
      538           where buf_shift-obj.obj-type = p-obj-type
      539             and buf_shift-obj.obj-code = p-obj-code
      540             and buf_shift-obj.shift-date <= p-fact-date
      541           use-index pi
      542           no-error .
      543         if available buf_shift-obj
      544         then do:
      545           if  buf_shift-obj.status_ = 'зкр':U
      546           then do:
      547             assign
      548               p-shift-date = buf_shift-obj.shift-date
      549               p-shift-num  = buf_shift-obj.shift-num
      550             .
      551           end.
      552           else do:
      553             message
      554               vss-workfile vss-revision vss-description skip
      555               "Невозможно вычислить последнюю смену" skip
      556               "Статус смены отличен от статуса" 'зкр':U skip
      557               "Объект" p-obj-type p-obj-code skip
      558               "Дата" p-fact-date skip
      559               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      560               view-as alert-box error .
      561             undo, return error return-value .
      562           end.
      563         end.
      564         else do:
      565           assign
      566             p-shift-date = p-fact-date - 1
      567             p-shift-num  = 1
      568           .
      569         end.
      570       end.
      571       run factord in this-procedure
      572         (input  p-fact-date
      573         ,input  1
      574         ,input  1
      575         ,input  p-shift-date
      576         ,input  p-shift-num
      577         ,input  p-shift-on
      578         ,output v-fact-order
      579         ,output p-shift-end-fact-order
      580         ,output p-day-end-fact-order
      581         ) no-error .
      582       if error-status :error
      583       then do:
      584         message
      585           vss-workfile vss-revision vss-description skip
      586           "Ошибка при вызове процедуры factord"
      587           error-status :get-message(1) skip
      588           return-value skip
      589           view-as alert-box error .
      590         undo, return error return-value .
      591       end.
      592     end.
      593   end procedure.
      594   procedure factord-lock-shift :
      595     define input  parameter p-obj-type  as character no-undo .
      596     define input  parameter p-obj-code  as integer   no-undo .
      597     define input  parameter p-fact-date as date      no-undo .
      598     define parameter buffer buf_shift-obj for ub.shift-obj .
      599     define variable v-shift-on      as logical   no-undo .
      600     define variable v-extra-message as character no-undo .
      601     define variable v-error as character no-undo .
      602     do
      603     on error undo, return error return-value
      604     :
      605   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      606   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      607     (input  p-obj-type
      608     ,input  p-obj-code
      609     ,input  'shift-on=request'
      610     ,output v-shift-on
      611     ) no-error .
      612       if error-status :error
      613       then do:
      614         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      615         undo, return error v-error .
      616       end.
      617       if v-shift-on = true
      618       then do:
      619         find first buf_shift-obj share-lock
      620           where buf_shift-obj.obj-type   = p-obj-type
      621             and buf_shift-obj.obj-code   = p-obj-code
      622             and buf_shift-obj.shift-date > p-fact-date
      623           use-index pi
      624           no-error .
      625         if not available buf_shift-obj
      626         or buf_shift-obj.status_ <> 'зкр':U
      627         then do:
      628           find last buf_shift-obj
      629             where buf_shift-obj.obj-type = p-obj-type
      630               and buf_shift-obj.obj-code = p-obj-code
      631               and buf_shift-obj.status_  = 'зкр':U
      632             use-index stts
      633             no-error .
      634           if available buf_shift-obj
      635           then do:
      636             assign
      637               v-extra-message =
      638                     substitute("Дата начала последеней закрытой смены на объекте &1"
      639                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      640                               )
      641             .
      642           end.
      643           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      644           undo, return error v-error .
      645         end.
      646       end.
      647     end.
      648   end procedure.
      649   procedure factord-end-day :
      650     define input  parameter p-fact-date            as date    no-undo .
      651     define output parameter p-day-end-fact-order   as decimal no-undo .
      652     do
      653     on error undo, return error return-value
      654     :
      655       if p-fact-date = ?
      656       then do:
      657         return error "Не указана фактическая дата" .
      658       end.
      659       assign
      660         p-day-end-fact-order = integer(p-fact-date) + 0.99
      661       .
      662     end.
      663   end procedure.
      664   procedure factord-to-date :
      665     define input  parameter p-fact-order as decimal no-undo .
      666     define output parameter p-fact-date  as date    no-undo .
      667     define variable v-ref-date  as date      no-undo .
      668     define variable v-ref-delta as integer   no-undo .
      669     do
      670     on error undo, return error return-value
      671     :
      672       if p-fact-order = ?
      673       or p-fact-order = 0
      674       then do:
      675         return error "Не указан fact-order" .
      676       end.
      677       assign
      678         v-ref-date  = date(1, 1, 2000)
      679       .
      680       assign
      681         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      682       .
      683       assign
      684         p-fact-date = v-ref-date + v-ref-delta
      685       .
      686     end.
      687   end procedure.
      688   procedure factord-to-fact-num :
      689     define input  parameter p-fact-order as decimal no-undo .
      690     define output parameter p-fact-num   as integer no-undo .
      691     define variable v-fact-order-trunc as decimal no-undo .
      692     do
      693     on error undo, return error return-value
      694     :
      695       if p-fact-order = ?
      696       or p-fact-order = 0
      697       then do:
      698         return error "Не указан fact-order" .
      699       end.
      700       assign
      701        v-fact-order-trunc = truncate(p-fact-order, 2)
      702       .
      703       assign
      704         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      705       .
      706     end.
      707   end procedure.
      708   procedure factord-to-shift-num :
      709     define input  parameter p-fact-order as decimal no-undo .
      710     define output parameter p-shift-num   as integer no-undo .
      711     define variable  p-shift-numd  as decimal   no-undo .
      712     define variable v-fact-order-trunc as decimal no-undo .
      713     do
      714     on error undo, return error return-value
      715     :
      716       if p-fact-order = ?
      717       or p-fact-order = 0
      718       then do:
      719         return error "Не указан fact-order" .
      720       end.
      721       assign
      722        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      723       .
      724       if v-fact-order-trunc < 0.5 then do:
      725         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      726       end.
      727       assign
      728         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      729         .
      730        assign
      731         p-shift-num = truncate (p-shift-numd , 0)
      732       .
      733     end.
      734   end procedure.
