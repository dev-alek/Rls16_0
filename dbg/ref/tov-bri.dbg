     1479     define variable v-use-qnty-group        as logical   no-undo .
     1480     define variable v-use-sum-group         as logical   no-undo .
     1481     define variable v-use-add-code          as logical   no-undo .
     1482     define variable v-use-sys-date-time     as logical   no-undo .
     1483     define variable v-use-shift-date-num    as logical   no-undo .
     1484     define variable v-use-cassa             as logical   no-undo .
     1485     define variable v-use-val               as logical   no-undo .
     1486     define variable v-use-pay-type          as logical   no-undo .
     1487     define variable v-use-cash-pay          as logical   no-undo .
     1488     define variable v-use-child as logical   no-undo .
     1489   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1490   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run glstall in g#library
     1491   (  output v-use-grp-buy
     1492    , output v-use-oborot-buy
     1493    , output v-use-qnty-group
     1494    , output v-use-sum-group
     1495    , output v-use-add-code
     1496    , output v-use-sys-date-time
     1497    , output v-use-shift-date-num
     1498    , output v-use-cassa
     1499    , output v-use-val
     1500    , output v-use-pay-type
     1501    , output v-use-cash-pay
     1502    , output v-use-child
     1503           )  .
     1504   if not ( v-use-grp-buy or v-use-oborot-buy )  then do:
     1505          message "Не заданы глобальные настройки ценообразования !!!" view-as alert-box error .
     1506          return error return-value .
     1507       end.
     1508     for each tt-turnover-buyer : delete tt-turnover-buyer . end.
     1509     if p-mode = 'ПРОСМОТР':U
     1510       then  find first buf_turnover-buyer no-lock where        recid(buf_turnover-buyer) = p-recid no-error .
     1511       else  find first buf_turnover-buyer exclusive-lock where recid(buf_turnover-buyer) = p-recid no-error .
     1512     create tt-turnover-buyer.
     1513        BUFFER-COPY buf_turnover-buyer TO tt-turnover-buyer
     1514     .
     1515   define variable v-host-code as integer   no-undo .
     1516   define variable v-base-code as integer   no-undo .
     1517   v-rubl-abbr = "РУБ" .
     1518   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1519   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1520     (input  tt-turnover-buyer.obj-type
     1521     ,input  tt-turnover-buyer.obj-code
     1522     ,output v-host-code
     1523     )  .
     1524   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1525   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1526     (input  v-host-code
     1527     ,output v-base-code
     1528     )  .
     1529   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1530   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1531     (input  v-base-code
     1532     ,input  today
     1533     ,output v-base-rate
     1534     ,output v-base-scale
     1535     ,output v-base-abbr
     1536     )  .
     1537     OPEN QUERY Dialog-Frame FOR EACH tt-turnover-buyer NO-LOCK,              EACH buy-clients WHERE buy-clients.obj-code =  tt-turnover-buyer.cli-code                          AND buy-clients.obj-type = tt-turnover-buyer.cli-type                          NO-LOCK,              EACH obj-clients WHERE obj-clients.obj-code = tt-turnover-buyer.obj-code                          AND obj-clients.obj-type = tt-turnover-buyer.obj-type                          OUTER-JOIN NO-LOCK.
     1538     GET FIRST Dialog-Frame.
     1539     DISPLAY v-rubl-abbr v-base-abbr v-base-rate v-base-scale
     1540         WITH FRAME Dialog-Frame.
     1541     IF AVAILABLE buy-clients THEN
     1542       DISPLAY buy-clients.obj-name
     1543         WITH FRAME Dialog-Frame.
     1544     IF AVAILABLE obj-clients THEN
     1545       DISPLAY obj-clients.obj-name
     1546         WITH FRAME Dialog-Frame.
     1547     IF AVAILABLE tt-turnover-buyer THEN do:
     1548       DISPLAY tt-turnover-buyer.des tt-turnover-buyer.fact-date
     1549             tt-turnover-buyer.shift-date tt-turnover-buyer.shift-num
     1550             tt-turnover-buyer.shift-name
     1551             tt-turnover-buyer.sum-acc-rubl tt-turnover-buyer.sum-acc-base
     1552             tt-turnover-buyer.sum-doc-rubl tt-turnover-buyer.sum-doc-base
     1553             tt-turnover-buyer.sum-vat-acc-rubl tt-turnover-buyer.sum-vat-acc-base
     1554             tt-turnover-buyer.sum-vat-doc-base tt-turnover-buyer.sum-vat-doc-rubl
     1555             tt-turnover-buyer.cli-code tt-turnover-buyer.cli-type
     1556             tt-turnover-buyer.obj-code tt-turnover-buyer.obj-type
     1557         WITH FRAME Dialog-Frame.
     1558     end.
     1559     if p-mode = 'ИЗМЕНЕНИЕ':U  then
     1560     ENABLE B-Cancel RECT-1 B-save B-Help tt-turnover-buyer.des
     1561            tt-turnover-buyer.sum-acc-rubl
     1562            tt-turnover-buyer.sum-acc-base tt-turnover-buyer.sum-doc-rubl
     1563            tt-turnover-buyer.sum-doc-base tt-turnover-buyer.sum-vat-acc-rubl
     1564            tt-turnover-buyer.sum-vat-acc-base tt-turnover-buyer.sum-vat-doc-base
     1565            tt-turnover-buyer.sum-vat-doc-rubl
     1566            v-rubl-abbr v-base-abbr v-base-rate v-base-scale
     1567         b-r-b b-b-r
     1568         WITH FRAME Dialog-Frame.
     1569         else do:
     1570     ENABLE B-Cancel B-Help
     1571         WITH FRAME Dialog-Frame.
     1572         B-Cancel:label = "&Выход" .
     1573         hide B-save in frame Dialog-Frame .
     1574         end.
     1575     if tt-turnover-buyer.shift-date <> ? then do:
     1576        display
     1577        tt-turnover-buyer.shift-date
     1578        tt-turnover-buyer.shift-num
     1579        tt-turnover-buyer.shift-name
     1580        with frame Dialog-Frame .
     1581     end.
     1582     else do:
     1583        hide
     1584        tt-turnover-buyer.shift-date
     1585        tt-turnover-buyer.shift-num
     1586        tt-turnover-buyer.shift-name
     1587        in frame Dialog-Frame .
     1588     end.
     1589      ASSIGN frame Dialog-Frame:TITLE = "Обороты покупателя  "   + buy-clients.obj-name
     1590      + " - " + caps(p-mode).
     1591     VIEW FRAME Dialog-Frame.
     1592   END PROCEDURE.
     1593   PROCEDURE my-enable-add :
     1594   define buffer buf_global-state for ub.global-state  .
     1595   define variable g-log as logical   no-undo .
     1596   define buffer buf_turnover-buyer for ub.turnover-buyer  .
     1597   find last buf_global-state no-lock  no-error .
     1598       if error-status :error then do:
     1599          message "Не заданы глобальные настройки ценообразования !!!" view-as alert-box error .
     1600          return error return-value .
     1601       end.
     1602      find first buf_turnover-buyer no-lock where recid(buf_turnover-buyer) = p-recid no-error .
     1603   for each tt-turnover-buyer : delete tt-turnover-buyer . end.
     1604     create tt-turnover-buyer.
     1605        assign
     1606           tt-turnover-buyer.cli-code  = p-cli-code
     1607           tt-turnover-buyer.cli-type  = p-cli-type
     1608           tt-turnover-buyer.sum-type   = ""
     1609           tt-turnover-buyer.type       = 1
     1610        .
     1611     OPEN QUERY Dialog-Frame FOR EACH tt-turnover-buyer NO-LOCK,              EACH buy-clients WHERE buy-clients.obj-code =  tt-turnover-buyer.cli-code                          AND buy-clients.obj-type = tt-turnover-buyer.cli-type                          NO-LOCK,              EACH obj-clients WHERE obj-clients.obj-code = tt-turnover-buyer.obj-code                          AND obj-clients.obj-type = tt-turnover-buyer.obj-type                          OUTER-JOIN NO-LOCK.
     1612     GET FIRST Dialog-Frame.
     1613   define variable v-host-code as integer   no-undo .
     1614   define variable v-base-code as integer   no-undo .
     1615   v-rubl-abbr = "РУБ" .
     1616     DISPLAY v-rubl-abbr v-base-abbr v-base-rate v-base-scale
     1617         WITH FRAME Dialog-Frame.
     1618     IF AVAILABLE buy-clients THEN
     1619       DISPLAY buy-clients.obj-name
     1620         WITH FRAME Dialog-Frame.
     1621     IF AVAILABLE obj-clients THEN
     1622       DISPLAY obj-clients.obj-name
     1623         WITH FRAME Dialog-Frame.
     1624     IF AVAILABLE tt-turnover-buyer THEN do:
     1625       DISPLAY tt-turnover-buyer.des tt-turnover-buyer.fact-date
     1626             tt-turnover-buyer.shift-date tt-turnover-buyer.shift-num
     1627             tt-turnover-buyer.shift-name
     1628             tt-turnover-buyer.sum-acc-rubl tt-turnover-buyer.sum-acc-base
     1629             tt-turnover-buyer.sum-doc-rubl tt-turnover-buyer.sum-doc-base
     1630             tt-turnover-buyer.sum-vat-acc-rubl tt-turnover-buyer.sum-vat-acc-base
     1631             tt-turnover-buyer.sum-vat-doc-base tt-turnover-buyer.sum-vat-doc-rubl
     1632             tt-turnover-buyer.cli-code tt-turnover-buyer.cli-type
     1633             tt-turnover-buyer.obj-code tt-turnover-buyer.obj-type
     1634         WITH FRAME Dialog-Frame.
     1635     end.
     1636     ENABLE B-Cancel RECT-1 B-save B-Help tt-turnover-buyer.des r-shift
     1637            tt-turnover-buyer.fact-date
     1638            r-cli tt-turnover-buyer.sum-acc-rubl
     1639            tt-turnover-buyer.sum-acc-base tt-turnover-buyer.sum-doc-rubl
     1640            tt-turnover-buyer.sum-doc-base tt-turnover-buyer.sum-vat-acc-rubl
     1641            tt-turnover-buyer.sum-vat-acc-base tt-turnover-buyer.sum-vat-doc-base
     1642            tt-turnover-buyer.sum-vat-doc-rubl tt-turnover-buyer.cli-code
     1643            tt-turnover-buyer.cli-type buy-clients.obj-name
     1644            tt-turnover-buyer.obj-code tt-turnover-buyer.obj-type
     1645             b-r-b b-b-r
     1646            obj-clients.obj-name v-rubl-abbr v-base-abbr v-base-rate v-base-scale
     1647         WITH FRAME Dialog-Frame.
     1648     if buf_global-state.pl-use-shift-date-num  = false then do:
     1649        tt-turnover-buyer.shift-date = ? .
     1650        tt-turnover-buyer.shift-num  = ? .
     1651        tt-turnover-buyer.shift-name = ? .
     1652        hide
     1653        tt-turnover-buyer.shift-date
     1654        tt-turnover-buyer.shift-num
     1655        tt-turnover-buyer.shift-name
     1656         r-shift
     1657        in frame Dialog-Frame .
     1658     end.
     1659      ASSIGN frame Dialog-Frame:TITLE = "Обороты покупателя  "   + buy-clients.obj-name
     1660      + " - " + caps(p-mode).
     1661     VIEW FRAME Dialog-Frame.
     1662   END PROCEDURE.
     1663   PROCEDURE save-proc :
     1664   ASSIGN frame Dialog-Frame
     1665    tt-turnover-buyer.des tt-turnover-buyer.fact-date tt-turnover-buyer.obj-code tt-turnover-buyer.obj-type tt-turnover-buyer.shift-date tt-turnover-buyer.shift-num tt-turnover-buyer.sum-acc-base tt-turnover-buyer.sum-acc-rubl tt-turnover-buyer.sum-doc-base tt-turnover-buyer.sum-doc-rubl tt-turnover-buyer.sum-vat-acc-base tt-turnover-buyer.sum-vat-acc-rubl tt-turnover-buyer.sum-vat-doc-base tt-turnover-buyer.sum-vat-doc-rubl
     1666    tt-turnover-buyer.shift-name
     1667    .
     1668      define variable v-fact-order  as decimal   no-undo .
     1669      define variable v-fact-time as decimal   no-undo .
     1670      define variable v-shift-end-fact-order as decimal   no-undo .
     1671      define variable v-day-end-fact-order  as decimal   no-undo .
     1672      define variable l-shift-on as logical   no-undo .
     1673   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1674   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1675     (input  tt-turnover-buyer.obj-type
     1676     ,input  tt-turnover-buyer.obj-code
     1677     ,input  'shift-on=request'
     1678     ,output l-shift-on
     1679     ) no-error .
     1680         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     1681         v-fact-time = time .
     1682         run factord in this-procedure
     1683           (input  tt-turnover-buyer.fact-date
     1684           ,input  v-fact-time
     1685           ,input  1
     1686           ,input  tt-turnover-buyer.shift-date
     1687           ,input  tt-turnover-buyer.shift-num
     1688           ,input  l-shift-on
     1689           ,output v-fact-order
     1690           ,output v-shift-end-fact-order
     1691           ,output v-day-end-fact-order
     1692           ) no-error .
     1693       if p-mode = 'ДОБАВЛЕНИЕ':U  then do:
     1694             find first ub.shift-obj where ub.shift-obj.obj-type   = tt-turnover-buyer.obj-type   and
     1695                                           ub.shift-obj.obj-code   = tt-turnover-buyer.obj-code   and
     1696                                           ub.shift-obj.shift-date = tt-turnover-buyer.shift-date and
     1697                                           ub.shift-obj.shift-num  = tt-turnover-buyer.shift-num  no-lock no-error .
     1698          find first ub.turnover-buyer no-lock WHERE
     1699                 ub.turnover-buyer.cli-code    = tt-turnover-buyer.cli-code AND
     1700                 ub.turnover-buyer.cli-type    = tt-turnover-buyer.cli-type AND
     1701                 ub.turnover-buyer.obj-code    = tt-turnover-buyer.obj-code and
     1702                 ub.turnover-buyer.obj-type    = tt-turnover-buyer.obj-type and
     1703                 ub.turnover-buyer.fact-order  = v-fact-order  no-error .
     1704            if available ub.turnover-buyer then do:
     1705               if l-shift-on then return error "На начало смены " + string(ub.turnover-buyer.shift-date) + "№ " + string(ub.turnover-buyer.shift-name) +  " уже есть оборот " .
     1706               else return error "На начало дня  " + string(ub.turnover-buyer.fact-date) + " уже есть оборот " .
     1707            end.
     1708             create ub.turnover-buyer.
     1709             assign
     1710                 ub.turnover-buyer.cli-code    = tt-turnover-buyer.cli-code
     1711                 ub.turnover-buyer.cli-type    = tt-turnover-buyer.cli-type
     1712                 ub.turnover-buyer.fact-date   = tt-turnover-buyer.fact-date
     1713                 ub.turnover-buyer.fact-order  = v-fact-order
     1714                 ub.turnover-buyer.obj-code    = tt-turnover-buyer.obj-code
     1715                 ub.turnover-buyer.obj-type    = tt-turnover-buyer.obj-type
     1716                 ub.turnover-buyer.shift-date  = tt-turnover-buyer.shift-date
     1717                 ub.turnover-buyer.shift-num   = tt-turnover-buyer.shift-num
     1718                 ub.turnover-buyer.shift-name  = if available ub.shift-obj then ub.shift-obj.shift-name else ""
     1719                 ub.turnover-buyer.type        = 1
     1720                 ub.turnover-buyer.qnty-check  = 0
     1721                 ub.turnover-buyer.qnty-check-itog  = 0
     1722                 ub.turnover-buyer.qnty-doc-itog  = 0
     1723                 ub.turnover-buyer.d-card    = ""
     1724                 ub.turnover-buyer.inkas-code = ""
     1725             .
     1726       end.
     1727       else do:
     1728         find first ub.turnover-buyer exclusive-lock where recid(ub.turnover-buyer) = p-recid no-error .
     1729         if error-status :error then message
     1730           vss-workfile vss-revision vss-description skip
     1731           error-status :get-message(1) skip
     1732           return-value skip
     1733           ""
     1734           view-as alert-box error
     1735         .
     1736       end.
     1737   assign
     1738     ub.turnover-buyer.sum-acc-base     = tt-turnover-buyer.sum-acc-base
     1739     ub.turnover-buyer.sum-acc-rubl     = tt-turnover-buyer.sum-acc-rubl
     1740     ub.turnover-buyer.sum-doc-base     = tt-turnover-buyer.sum-doc-base
     1741     ub.turnover-buyer.sum-doc-rubl     = tt-turnover-buyer.sum-doc-rubl
     1742     ub.turnover-buyer.sum-vat-acc-base = tt-turnover-buyer.sum-vat-acc-base
     1743     ub.turnover-buyer.sum-vat-acc-rubl = tt-turnover-buyer.sum-vat-acc-rubl
     1744     ub.turnover-buyer.sum-vat-doc-base = tt-turnover-buyer.sum-vat-doc-base
     1745     ub.turnover-buyer.sum-vat-doc-rubl = tt-turnover-buyer.sum-vat-doc-rubl
     1746     ub.turnover-buyer.sys-date         = today
     1747     ub.turnover-buyer.sys-time         = time
     1748     ub.turnover-buyer.sys-time-char    = string ( ub.turnover-buyer.sys-time,"hh:mm" )
     1749     ub.turnover-buyer.des              = tt-turnover-buyer.des
     1750     p-recid                            = recid ( ub.turnover-buyer )
     1751   .
     1752   END PROCEDURE.
