      269         (input  parparentproc
      270         ,input  this-procedure :handle
      271         ,input  p-db-num
      272         ,input  p-user-id
      273         ,input  p-host-code-obj
      274         ,input  p-obj-type
      275         ,input  p-obj-code
      276         ,INPUT  "b-sel"
      277         ,output p-user-select
