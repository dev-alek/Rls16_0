     1432   RUN disable_UI.
     1433   PROCEDURE disable_UI :
     1434     HIDE FRAME Dialog-Frame.
     1435   END PROCEDURE.
     1436   PROCEDURE enable_UI :
     1437     OPEN QUERY Dialog-Frame FOR EACH tt-turnover-buyer NO-LOCK,              EACH buy-clients WHERE buy-clients.obj-code =  tt-turnover-buyer.cli-code                          AND buy-clients.obj-type = tt-turnover-buyer.cli-type                          NO-LOCK,              EACH obj-clients WHERE obj-clients.obj-code = tt-turnover-buyer.obj-code                          AND obj-clients.obj-type = tt-turnover-buyer.obj-type                          OUTER-JOIN NO-LOCK.
     1438     GET FIRST Dialog-Frame.
     1439     DISPLAY v-rubl-abbr v-base-abbr v-base-rate v-base-scale
     1440         WITH FRAME Dialog-Frame.
     1441     IF AVAILABLE buy-clients THEN
     1442       DISPLAY buy-clients.obj-name
     1443         WITH FRAME Dialog-Frame.
     1444     IF AVAILABLE obj-clients THEN
     1445       DISPLAY obj-clients.obj-name
     1446         WITH FRAME Dialog-Frame.
     1447     IF AVAILABLE tt-turnover-buyer THEN
     1448       DISPLAY tt-turnover-buyer.des tt-turnover-buyer.fact-date
     1449             tt-turnover-buyer.shift-date tt-turnover-buyer.shift-num
     1450             tt-turnover-buyer.shift-name tt-turnover-buyer.sum-doc-rubl
     1451             tt-turnover-buyer.sum-doc-base tt-turnover-buyer.sum-acc-rubl
     1452             tt-turnover-buyer.sum-acc-base tt-turnover-buyer.sum-vat-doc-rubl
     1453             tt-turnover-buyer.sum-vat-doc-base tt-turnover-buyer.sum-vat-acc-rubl
     1454             tt-turnover-buyer.sum-vat-acc-base tt-turnover-buyer.cli-code
     1455             tt-turnover-buyer.cli-type tt-turnover-buyer.obj-code
     1456             tt-turnover-buyer.obj-type
     1457         WITH FRAME Dialog-Frame.
     1458     ENABLE B-Cancel B-save B-Help RECT-1 tt-turnover-buyer.des r-cli
     1459            tt-turnover-buyer.fact-date tt-turnover-buyer.sum-doc-rubl
     1460            tt-turnover-buyer.sum-doc-base B-r-b tt-turnover-buyer.sum-acc-rubl
     1461            tt-turnover-buyer.sum-acc-base B-b-r
     1462            tt-turnover-buyer.sum-vat-doc-rubl tt-turnover-buyer.sum-vat-doc-base
     1463            tt-turnover-buyer.sum-vat-acc-rubl tt-turnover-buyer.sum-vat-acc-base
     1464            tt-turnover-buyer.cli-code tt-turnover-buyer.cli-type
     1465            buy-clients.obj-name tt-turnover-buyer.obj-code
     1466            tt-turnover-buyer.obj-type obj-clients.obj-name v-rubl-abbr
     1467            v-base-abbr v-base-rate v-base-scale
     1468         WITH FRAME Dialog-Frame.
     1469     VIEW FRAME Dialog-Frame.
     1470   END PROCEDURE.
     1471   PROCEDURE my-enable :
     1472   define variable g-log as logical   no-undo .
     1473   define buffer buf_turnover-buyer for ub.turnover-buyer  .
     1474   define variable v-shift-date  as date     no-undo .
     1475   define variable v-shift-num   as integer  no-undo .
