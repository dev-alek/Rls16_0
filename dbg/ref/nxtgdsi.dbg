        1   block-level on error undo, throw.
        2   DEFINE INPUT PARAMETER vattaxcd     AS integer NO-UNDO.
        3   DEFINE INPUT PARAMETER slttaxcd     AS integer NO-UNDO.
        4   define input parameter custvalue    as character no-undo .
        5   DEFINE INPUT PARAMETER p-artic     AS integer NO-UNDO.
        6   define input parameter p-prod      as integer no-undo .
        7   DEFINE INPUT PARAMETER p-name      AS integer NO-UNDO.
        8   DEFINE INPUT PARAMETER p-engl-name AS integer NO-UNDO.
        9   DEFINE INPUT PARAMETER p-unit-base AS integer NO-UNDO.
       10   DEFINE INPUT PARAMETER p-VAT-code  AS integer NO-UNDO.
       11   DEFINE INPUT PARAMETER p-SLT-code  AS integer NO-UNDO.
       12   DEFINE INPUT PARAMETER p-Struct  AS integer NO-UNDO.
       13   define input parameter p-tnved    as integer no-undo .
       14   define input parameter p-attrib    as integer no-undo .
       15   define input parameter p-destin    as integer no-undo .
       16   define input parameter p-sert    as integer no-undo .
       17   define input parameter p-user-rule    as integer no-undo .
       18   define input parameter p-alpha1       as integer no-undo .
       19   define input parameter p-grp-code     as integer no-undo .
       20   define input parameter p-service      as integer no-undo .
       21   define input parameter p-gds-code      as integer no-undo .
       22   define input parameter p-mark      as integer no-undo .
       23   DEFINE INPUT PARAMETER ii as integer No-UNDO.
       24   DEFINE INPUT-OUTPUT PARAMETER i-artic as char NO-UNDO.
       25   DEFINE INPUT-OUTPUT PARAMETER i-prod-type as char NO-UNDO.
       26   DEFINE INPUT-OUTPUT PARAMETER i-prod-code as integer NO-UNDO.
       27   DEFINE INPUT-OUTPUT PARAMETER i-name as char NO-UNDO.
       28   DEFINE INPUT-OUTPUT PARAMETER i-engl-name as char NO-UNDO.
       29   DEFINE INPUT-OUTPUT PARAMETER i-unit-base as char NO-UNDO.
       30   DEFINE INPUT-OUTPUT PARAMETER i-VAT-code as integer NO-UNDO.
       31   DEFINE INPUT-OUTPUT PARAMETER i-SLT-code as integer NO-UNDO.
       32   DEFINE INPUT-OUTPUT PARAMETER i-Struct as character NO-UNDO.
       33   define input-output parameter i-tnved like ub.goods.tnved no-undo .
       34   define input-output parameter i-attrib like ub.goods.attrib no-undo .
       35   define input-output parameter i-destin like ub.goods.destin no-undo .
       36   define input-output parameter i-sert like ub.goods.sert no-undo .
       37   define input-output parameter i-user-rule like ub.goods.user-rule no-undo .
       38   define input-output parameter i-alpha1 like ub.goods.alpha1 no-undo .
       39   define input-output parameter i-grp-code like ub.goods.grp-code no-undo .
       40   define input-output parameter i-service as logical no-undo .
       41   define input-output parameter i-gds-code like ub.goods.gds-code no-undo .
       42   define input-output parameter i-mark as integer  no-undo .
       43   define variable vss-revision    as character no-undo init "$Revision: f5e72f13272f, 2363, rls $":U .
       44   define variable vss-author      as character no-undo init "$Author: druban $":U .
       45   define variable vss-date        as character no-undo init "$Date: Ср июн 10 21:13:42 2020 +0300 $":U .
       46   define variable vss-workfile    as character no-undo init "$Workfile: nxtgdsi.p $":U .
       47   define variable vss-archive     as character no-undo init "$Archive: ref/nxtgdsi.p $":U .
       48   define variable vss-description as character no-undo init "Импорт из файла следующего товара в карточку товара".
       49   procedure vss-get-info :
       50     define output parameter p-vss-revision    like vss-revision    no-undo .
       51     define output parameter p-vss-author      like vss-author      no-undo .
       52     define output parameter p-vss-date        like vss-date        no-undo .
       53     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       54     define output parameter p-vss-archive     like vss-archive     no-undo .
       55     define output parameter p-vss-description like vss-description no-undo .
       56     assign
       57       p-vss-revision    = vss-revision
       58       p-vss-author      = vss-author
       59       p-vss-date        = vss-date
       60       p-vss-workfile    = vss-workfile
       61       p-vss-archive     = vss-archive
       62       p-vss-description = vss-description
       63     .
       64   end procedure.
       65   procedure vss-get-parameters :
       66     define output parameter p-vss-parameters as character no-undo .
       67   end procedure.
       68   define new global shared variable g#vssrevis-logger as handle    no-undo .
       69   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       70   define variable v-vssrevis-logger                   as handle    no-undo .
       71   procedure vss-logevent :
       72     define input  parameter p-extra-paramters as character no-undo .
       73     define variable v-vssrevis-parameters as character no-undo .
       74     do
       75     on error undo, return error return-value
       76     :
       77       if  valid-handle(v-vssrevis-logger)
       78       and v-vssrevis-logger :get-signature("logevent") <> ""
       79       then do:
       80         run vss-get-parameters in this-procedure
       81           (output v-vssrevis-parameters
       82           ).
       83         run logevent in v-vssrevis-logger
       84           (input vss-workfile
       85           ,input vss-revision
       86           ,input v-vssrevis-parameters
       87           ,input p-extra-paramters
       88           ).
       89       end.
       90     end.
       91   end procedure.
       92   assign
       93     v-vssrevis-logger = g#vssrevis-logger
       94   .
       95   if  valid-handle(v-vssrevis-logger)
       96   and v-vssrevis-logger :get-signature("logevent") <> ""
       97   then do:
       98     assign
       99       v-vssrevis-logevent = true
      100     .
      101     run vss-logevent in this-procedure (input vss-description) .
      102   end.
      103   define new global shared variable g#language as character no-undo .
      104   if g#language <> '' and g#language <> 'rus':U then do:
      105     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      106   end.
      107   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      108   DEFINE  SHARED TEMP-TABLE TT-tnved NO-UNDO
      109   FIELD tnved  AS CHAR FORMAT "X(10)"  LABEL 'Код ТНВЭД':U
      110   FIELD f-name AS CHAR FORMAT "X(255)" LABEL 'Полное наименование':U
      111   INDEX tnved IS UNIQUE PRIMARY  tnved.
      112   DEFINE SHARED stream gds-file.
      113   DEFINE var text-string as char no-undo.
      114   define variable i-prod as character no-undo .
      115   IMPORT stream gds-file UNFORMATTED text-string NO-ERROR.
      116   if text-string = ? or text-string = "" then return "END" .
      117   if error-status:error then return error.
      118   if p-artic > 0
      119   then
      120   assign
      121   i-artic = ENTRY(p-artic, text-string, ";").
      122   else
      123   assign
      124   i-artic = "".
      125   if p-name > 0
      126   then
      127   assign
      128   i-name = ENTRY(p-name, text-string, ";").
      129   else
      130   assign
      131   i-name = "".
      132   if p-engl-name > 0
      133   then
      134   assign
      135   i-engl-name = ENTRY(p-engl-name, text-string, ";").
      136   else
      137   assign
      138   i-engl-name = "".
      139   if p-SLT-code > 0
      140   then do:
      141           assign
      142           i-SLT-code = integer(ENTRY(p-SLT-code, text-string, ";"))
      143           no-error.
      144           if error-status:error then do:
      145               message "Неверное значение кода ставки НП "
      146                       ENTRY(p-SLT-code, text-string, ";") skip
      147                       " - поле N " p-SLT-code
      148                       "   строчка N " ii
      149               view-as alert-box ERROR .
      150               return ERROR.
      151           end.
      152           else do:
      153               FIND FIRST ub.tax-rate NO-LOCK where
      154                          ub.tax-rate.rate-code = i-SLT-code
      155                          No-ERROR.
      156               IF NOT avail ub.tax-rate then do:
      157                   message "Нет в БД ставки налога с кодом "
      158                           ENTRY(p-SLT-code, text-string, ";") skip
      159                           " - поле N " p-SLT-code
      160                           "   строчка N " ii
      161                   view-as alert-box ERROR.
      162                   i-SLT-code = 0.
      163                   return error.
      164               END.
      165               ELSE DO:
      166                   if ub.tax-rate.tax-code <> slttaxcd then do:
      167                       message "Для ставки налога с кодом "
      168                               ENTRY(p-SLT-code, text-string, ";")
      169                               "код налога отличается от кода НП" skip
      170                               " - поле N " p-SLT-code
      171                               "   строчка N " ii
      172                       view-as alert-box ERROR .
      173                       i-SLT-code = 0.
      174                       return ERROR.
      175                   end.
      176               END.
      177           end.
      178   end.
      179   else do:
      180       assign
      181       i-SLT-code = 0.
      182   end.
      183   if p-unit-base > 0
      184   then do:
      185       FIND FIRST ub.units NO-LOCK where
      186                           ub.units.unit-name = ENTRY(p-unit-base, text-string, ";")
      187                          No-ERROR.
      188           IF NOT avail ub.units then do:
      189               message "Нет в БД единицы измерения "
      190                       ENTRY(p-unit-base, text-string, ";") skip
      191                       " - поле N " p-unit-base
      192                       "   строчка N " ii
      193               view-as alert-box ERROR.
      194               return error.
      195           END.
      196       assign
      197       i-unit-base = ENTRY(p-unit-base, text-string, ";").
      198   end.
      199   else
      200   assign
      201   i-unit-base = "".
      202   if p-VAT-code > 0
      203   then do:
      204           assign
      205           i-vat-code = integer(ENTRY(p-vat-code, text-string, ";"))
      206           no-error.
      207           if error-status:error then do:
      208               message "Неверное значение кода ставки НП "
      209                       ENTRY(p-vat-code, text-string, ";") skip
      210                       " - поле N " p-vat-code
      211                       "   строчка N " ii
      212               view-as alert-box ERROR .
      213               return ERROR.
      214           end.
      215           else do:
      216               FIND FIRST ub.tax-rate NO-LOCK where
      217                          ub.tax-rate.rate-code = i-vat-code
      218                          No-ERROR.
      219               IF NOT avail ub.tax-rate then do:
      220                   message "Нет в БД ставки налога с кодом "
      221                           ENTRY(p-vat-code, text-string, ";") skip
      222                           " - поле N " p-vat-code
      223                           "   строчка N " ii
      224                   view-as alert-box ERROR.
      225                   i-vat-code = 0.
      226                   return error.
      227               END.
      228               ELSE DO:
      229                   if tax-rate.tax-code <> vattaxcd then do:
      230                       message "Для ставки налога с кодом "
      231                               ENTRY(p-vat-code, text-string, ";")
      232                               "код налога отличается от кода НДС" skip
      233                               " - поле N " p-vat-code
      234                               "   строчка N " ii
      235                       view-as alert-box ERROR .
      236                       i-vat-code = 0.
      237                       return ERROR.
      238                   end.
      239               END.
      240           end.
      241   end.
      242   else do:
      243       assign
      244       i-VAT-code = 0.
      245   end.
      246   if p-struct > 0
      247   then
      248   assign
      249   i-struct = ENTRY(p-struct, text-string, ";").
      250   else
      251   assign
      252   i-struct = "".
      253   if p-tnved > 0 then do:
      254     assign
      255     i-tnved = ENTRY(p-tnved, text-string, ";")
      256     no-error
      257     .
      258     if custvalue = "yes":U then do:
      259       FIND FIRST TT-tnved WHERE
      260                 TT-tnved.tnved = i-tnved no-error.
      261       if not available TT-tnved then do:
      262         message
      263         "Код ТНВЭД не найден в справочнике."
      264         view-as alert-box error.
      265         assign
      266         i-tnved = "":U.
      267         return error.
      268       end.
      269     end.
      270     if length(trim(i-tnved)) <> 10 then do:
      271       message
      272       "Код ТНВЭД для товару должен быть 10-ти символьный."
      273       view-as alert-box error.
      274       assign
      275       i-tnved = "":U.
      276       return error.
      277     end.
      278   end.
      279   else
      280   assign
      281   i-tnved = "".
      282   if p-attrib > 0
      283   then
      284   assign
      285   i-attrib = ENTRY(p-attrib, text-string, ";").
      286   else
      287   assign
      288   i-attrib = "".
      289   if p-destin > 0
      290   then
      291   assign
      292   i-destin = ENTRY(p-destin, text-string, ";").
      293   else
      294   assign
      295   i-destin = "".
      296   if p-sert > 0
      297   then
      298   assign
      299   i-sert = ENTRY(p-sert, text-string, ";").
      300   else
      301   assign
      302   i-sert = "".
      303   if p-user-rule > 0
      304   then
      305   assign
      306   i-user-rule = ENTRY(p-user-rule, text-string, ";").
      307   else
      308   assign
      309   i-user-rule = "".
      310   if p-prod > 0
      311   then do:
      312     assign
      313     i-prod = ENTRY(p-prod, text-string, ";").
      314     assign
      315     i-prod-type = substring(i-prod, 1, 3)
      316     i-prod-code = integer(substring(i-prod, 4))
      317     no-error .
      318     if error-status:error then do:
      319       message
      320       substitute("Неверный формат поля ПРОИЗВОДИТЕЛЬ для товара: &1", i-prod)
      321       view-as alert-box error.
      322       assign
      323       i-prod-type = "":U
      324       i-prod-code = 0
      325       .
      326       return error.
      327     end.
      328   end.
      329   else
      330   assign
      331   i-prod-type = ""
      332   i-prod-code = 0
      333   .
      334   if p-alpha1 > 0
      335   then
      336   assign
      337   i-alpha1 = ENTRY(p-alpha1, text-string, ";").
      338   else
      339   assign
      340   i-alpha1 = ""
      341   .
      342   if p-grp-code > 0
      343   then
      344   assign
      345   i-grp-code = integer(ENTRY(p-grp-code, text-string, ";")).
      346   else
      347   assign
      348   i-grp-code = 0
      349   .
      350   if p-service > 0
      351   then
      352   assign
      353   i-service = logical(ENTRY(p-service, text-string, ";")).
      354   else
      355   assign
      356   i-service = no
      357   .
      358   if p-gds-code > 0
      359   then do :
      360     assign
      361       i-gds-code = integer(ENTRY(p-gds-code, text-string, ";"))
      362     no-error .
      363     if error-status:error
      364     or i-gds-code <= 0
      365     then do:
      366         message "Неверное значение кода товара "
      367                 ENTRY(p-gds-code, text-string, ";") skip
      368                 " - поле N " p-gds-code
      369                 "   строчка N " ii
      370         view-as alert-box ERROR .
      371         return ERROR.
      372     end.
      373   end.
      374   else
      375   assign
      376   i-gds-code = 0
      377   .
      378   if p-mark > 0
      379   then do :
      380     assign
      381       i-mark = int(ENTRY(p-mark, text-string, ";"))
      382     no-error .
      383     end.
      384   else
      385   assign
      386   i-mark = 0
      387   .
