      891           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-copy in g#attr-lib
      892         (input  p-code
      893         ,output p-copy
      894         ) no-error .
      895       if error-status :error
      896       then do:
      897         undo, return error return-value .
      898       end.
      899     end.
      900   end.
      901   procedure gds-attr_check-code-dt-seasons :
      902     define input  parameter p-code     like ub.goods.gds-code   no-undo .
      903     define input  parameter p-obj-type like ub.clients.obj-type no-undo .
      904     define input  parameter p-obj-code like ub.clients.obj-code no-undo .
      905     define output parameter p-gds-code like ub.goods.gds-code   no-undo .
      906     define output parameter p-dt-code  as   integer             no-undo .
      907     do
      908     on error undo, return error
      909     :
      910           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr_check-code-dt-seasons in g#attr-lib
      911         (input p-code
      912         ,input p-obj-type
      913         ,input p-obj-code
      914         ,output p-gds-code
      915         ,output p-dt-code
      916         ) no-error .
      917       if error-status :error
      918       then do:
      919         undo, return error return-value .
      920       end.
      921     end.
      922   end.
      923   define variable v-ii as integer no-undo .
      924   define variable jj as integer no-undo .
      925   DEFINE BUTTON B-exit AUTO-GO
      926        LABEL "&Ввод"
      927        SIZE 10 BY 1
      928        BGCOLOR 8 .
      929   DEFINE BUTTON B-Help
      930        LABEL "Помо&щь"
      931        SIZE 10 BY 1
      932        BGCOLOR 8 .
      933   DEFINE BUTTON B-Hist
      934        LABEL "Ис&тория"
      935        SIZE 10 BY 1
      936        BGCOLOR 8 .
      937   DEFINE BUTTON b-quit AUTO-END-KEY
      938        LABEL "&Отмена"
      939        SIZE 10 BY 1
      940        BGCOLOR 8 .
      941   DEFINE VARIABLE F-time AS CHARACTER FORMAT "X(5)":U
      942        LABEL "Время изменения"
      943         VIEW-AS TEXT
      944        SIZE 14 BY .67 NO-UNDO.
      945   DEFINE QUERY Dialog-Frame FOR
      946         tt-gds-obj-prop,
      947         buf_goods SCROLLING.
      948   DEFINE FRAME Dialog-Frame
      949        B-exit AT ROW 1 COL 1
      950        b-quit AT ROW 1 COL 11
      951        B-Hist AT ROW 1 COL 78.5
      952        B-Help AT ROW 1 COL 88.5
      953        tt-gds-obj-prop.gdop-min-stock AT ROW 5.77 COL 35.5 COLON-ALIGNED FORMAT "->>>,>>9.999"
      954             VIEW-AS FILL-IN
      955             SIZE 11 BY 1
      956        tt-gds-obj-prop.grop-max-stock AT ROW 6.77 COL 35.5 COLON-ALIGNED FORMAT "->>>,>>9.999"
      957             VIEW-AS FILL-IN
      958             SIZE 11 BY 1
      959        tt-gds-obj-prop.grop-min-order AT ROW 7.77 COL 35.5 COLON-ALIGNED FORMAT "->>>,>>9.999"
      960             VIEW-AS FILL-IN
      961             SIZE 11 BY 1
      962        tt-gds-obj-prop.grop-level-always-presence AT ROW 8.77 COL 35.5 COLON-ALIGNED FORMAT ">.9999"
      963             VIEW-AS FILL-IN
      964             SIZE 11 BY 1
      965        buf_goods.artic AT ROW 2.77 COL 24 COLON-ALIGNED
      966              VIEW-AS TEXT
      967             SIZE 17 BY .67
      968        buf_goods.prod-type AT ROW 2.77 COL 41.5 COLON-ALIGNED NO-LABEL
      969              VIEW-AS TEXT
      970             SIZE 4 BY .67
      971        buf_goods.prod-code AT ROW 2.77 COL 46 COLON-ALIGNED NO-LABEL
      972              VIEW-AS TEXT
      973             SIZE 10 BY .67
      974        buf_goods.gds-code AT ROW 3.5 COL 24 COLON-ALIGNED
      975              VIEW-AS TEXT
      976             SIZE 10 BY .67
      977        buf_goods.gds-name AT ROW 4.5 COL 24 COLON-ALIGNED
      978              VIEW-AS TEXT
      979             SIZE 71.5 BY 1
      980             BGCOLOR 3 FGCOLOR 15
      981        tt-gds-obj-prop.grop-date-update AT ROW 11.27 COL 75.5 COLON-ALIGNED
      982              VIEW-AS TEXT
      983             SIZE 9 BY .67
      984        F-time AT ROW 12.27 COL 75.5 COLON-ALIGNED
      985        tt-gds-obj-prop.grop-who-update AT ROW 13.27 COL 75.5 COLON-ALIGNED
      986              VIEW-AS TEXT
      987             SIZE 19.5 BY .67
      988        tt-gds-obj-prop.grop-db-num-update AT ROW 14.27 COL 75.5 COLON-ALIGNED
      989              VIEW-AS TEXT
      990             SIZE 5 BY .67
      991        SPACE(16.00) SKIP(0.55)
      992       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      993            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      994            TITLE "Атрибуты товара на объекте для заказов".
      995   ASSIGN
      996          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      997          FRAME Dialog-Frame:HIDDEN           = TRUE.
      998   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      999   DO:
     1000     APPLY "END-ERROR":U TO SELF.
     1001   END.
     1002   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1003   DO:
     1004     run proc-save in this-procedure no-error.
     1005     if error-status:error then return no-apply.
     1006   END.
     1007   ON CHOOSE OF B-Hist IN FRAME Dialog-Frame
     1008   DO:
     1009   define variable pp-rid-list as character no-undo .
     1010    run ref/cgds-ind.w (
     1011     input  parparentproc ,
     1012     input  tt-gds-obj-prop.gds-code ,
     1013     input  tt-gds-obj-prop.obj-type ,
     1014     input  tt-gds-obj-prop.obj-code ,
     1015     input-output pp-rid-list    ).
     1016   END.
     1017   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1018   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1019   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1020   on help of frame Dialog-Frame
     1021   do:
     1022     run gbl/app_help.p
     1023       (input this-procedure :file-name
     1024       ,input ''
     1025       ,input ?
     1026       ) no-error.
     1027     if error-status :error then do:
     1028       message
     1029         "Ошибка при вызове помощи"
     1030         error-status :get-message(1)
     1031         view-as alert-box .
     1032     end.
     1033   end.
     1034   run minbtn-set in this-procedure .
     1035   on choose of b-help in frame Dialog-Frame
     1036   do:
     1037     apply "help":u to frame Dialog-Frame .
     1038   end.
     1039   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1040   procedure minbtn-set :
     1041       do
     1042           on error undo, return error return-value
     1043           :
     1044           define variable ii              as integer       no-undo .
     1045           define variable fh              as widget-handle no-undo .
     1046           define variable hh              as widget-handle no-undo .
     1047           define variable v-h             as handle        extent 4 no-undo .
     1048           define variable v-name-button   as character     no-undo .
     1049           define variable v-help-old-x    as decimal       no-undo .
     1050           define variable v-help-old-y    as decimal       no-undo .
     1051           define variable v-help-old-size as decimal       no-undo .
     1052           define variable v-frame-width   as decimal       no-undo .
     1053           define variable jj              as integer       no-undo .
     1054           do
     1055               on error undo, return error
     1056               :
     1057               assign
     1058                   v-frame-width = frame Dialog-Frame:width - 0.3
     1059                   fh            = frame Dialog-Frame:first-child
     1060                   hh            = fh:first-child
     1061                   ii            = 1
     1062                   .
     1063               do while valid-handle(hh):
     1064                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1065                   do:
     1066                       case lc(hh:name) :
     1067                           when "b-help" then
     1068                               do:
     1069                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1070                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1071                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1072                                   hh:TOOLTIP = "Помощь" .
     1073                                   v-help-old-x = hh:column .
     1074                                   v-help-old-y = hh:row    .
     1075                                   v-help-old-size = hh:width .
     1076                                   hh:width-chars = 2.5 .
     1077                               end.
     1078                           when "b-print" then
     1079                               do:
     1080                                   hh:load-image("cmp/b-print.bmp":u) .
     1081                                   hh:TOOLTIP = "Печать" .
     1082                                   v-h[ii] = hh:handle .
     1083                                   ii = ii + 1 .
     1084                                   hh:width-chars = 3 .
     1085                               end.
     1086                           when "b-history" or
     1087                           when "b-hist" then
     1088                               do:
     1089                                   hh:load-image("cmp/b-hist.bmp":u) .
     1090                                   hh:TOOLTIP = "История" .
     1091                                   v-h[ii] = hh:handle .
     1092                                   ii = ii + 1 .
     1093                                   hh:width-chars = 3 .
     1094                               end.
     1095                           when "b-sch" then
     1096                               do:
     1097                                   hh:load-image("cmp/b-sch.bmp":u) .
     1098                                   hh:TOOLTIP = "Установка Фильтра" .
     1099                                   v-h[ii] = hh:handle .
     1100                                   ii = ii + 1 .
     1101                                   hh:width-chars = 3 .
     1102                               end.
     1103                           when "b-hist-user" then
     1104                               do:
     1105                                   hh:load-image("cmp/b-hist.bmp":u) .
     1106                                   hh:TOOLTIP = "История пользователя" .
     1107                                   ii = ii + 1 .
     1108                               end.
     1109                       end case.
     1110                   end.
     1111                   hh = hh:next-sibling.
     1112               end.
     1113               b-help:column = v-frame-width - b-help:width-chars.
     1114               jj = 0.
     1115               repeat ii = 4 to 1 by -1 :
     1116                   if valid-handle (v-h[ii] ) then
     1117                   do:
     1118                       jj  = jj + 1 .
     1119                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1120                       v-h[ii]:row    = v-help-old-y .
     1121                   end.
     1122               end.
     1123           end.
     1124       end.
     1125   end procedure.
     1126   MAIN-BLOCK:
     1127   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1128      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1129     run init-proc no-error .
     1130     if error-status :error then return error return-value .
     1131     define variable v-user-name as character no-undo .
     1132     run enable_ui.
     1133     if available tt-gds-obj-prop then do:
     1134   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1135   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1136     (input  tt-gds-obj-prop.grop-who-update
     1137     ,output v-user-name
     1138     )  .
     1139     end.
     1140     display v-user-name @ tt-gds-obj-prop.grop-who-update with frame Dialog-Frame .
     1141     if p-mode = 'ПРОСМОТР':U then do:
     1142         assign
     1143           b-quit:label = "&Выход"
     1144           b-quit:col = 1
     1145         .
     1146         hide b-exit in frame Dialog-Frame.
     1147     end.
     1148   find first tt-gds-obj-prop no-error .
     1149   DISPLAY string(tt-gds-obj-prop.grop-time-update,"hh:mm") @ f-time WITH FRAME Dialog-Frame.
     1150   enable
     1151   b-exit when p-mode <> 'ПРОСМОТР':U
     1152   b-quit
     1153   b-hist when p-mode = 'ПРОСМОТР':U
     1154   b-help
     1155   tt-gds-obj-prop.gdop-min-stock               when p-mode <> 'ПРОСМОТР':U
     1156   tt-gds-obj-prop.grop-level-always-presence   when p-mode <> 'ПРОСМОТР':U
     1157   tt-gds-obj-prop.grop-max-stock               when p-mode <> 'ПРОСМОТР':U
     1158   tt-gds-obj-prop.grop-min-order               when p-mode <> 'ПРОСМОТР':U
     1159   with frame dialog-frame.
     1160   if p-obj-type = 'орг':U  then do:
     1161      hide
     1162      tt-gds-obj-prop.grop-max-stock
     1163      in frame Dialog-Frame .
     1164   end.
     1165   view frame dialog-frame.
     1166     WAIT-FOR GO OF FRAME Dialog-Frame FOCUS tt-gds-obj-prop.gdop-min-stock.
     1167   END.
     1168   run disable_ui.
     1169   PROCEDURE disable_UI :
     1170     HIDE FRAME Dialog-Frame.
     1171   END PROCEDURE.
     1172   PROCEDURE enable_UI :
     1173     OPEN QUERY Dialog-Frame FOR EACH tt-gds-obj-prop NO-LOCK,              EACH buf_goods OF tt-gds-obj-prop NO-LOCK.
     1174     GET FIRST Dialog-Frame.
     1175     DISPLAY F-time
     1176         WITH FRAME Dialog-Frame.
     1177     IF AVAILABLE buf_goods THEN
     1178       DISPLAY buf_goods.artic buf_goods.prod-type buf_goods.prod-code
     1179             buf_goods.gds-code buf_goods.gds-name
     1180         WITH FRAME Dialog-Frame.
     1181     IF AVAILABLE tt-gds-obj-prop THEN
     1182       DISPLAY tt-gds-obj-prop.gdop-min-stock tt-gds-obj-prop.grop-max-stock
     1183             tt-gds-obj-prop.grop-min-order
     1184             tt-gds-obj-prop.grop-level-always-presence
     1185             tt-gds-obj-prop.grop-date-update tt-gds-obj-prop.grop-who-update
     1186             tt-gds-obj-prop.grop-db-num-update
     1187         WITH FRAME Dialog-Frame.
     1188     ENABLE B-exit b-quit B-Help buf_goods.artic buf_goods.prod-type
     1189            buf_goods.prod-code buf_goods.gds-code buf_goods.gds-name
     1190            tt-gds-obj-prop.grop-date-update F-time
     1191            tt-gds-obj-prop.grop-who-update tt-gds-obj-prop.grop-db-num-update
     1192         WITH FRAME Dialog-Frame.
     1193     VIEW FRAME Dialog-Frame.
     1194   END PROCEDURE.
     1195   PROCEDURE init-proc :
     1196   define variable v-date as date no-undo .
     1197   define variable v-time as integer no-undo .
     1198     if p-obj-type = 'орг':U  then do:
     1199        assign
     1200          frame Dialog-Frame:title = "Атрибуты товара для ЗАКАЗА на фирме "  + string(p-obj-code)
     1201        .
     1202     end.
     1203     else frame Dialog-Frame:title = "Атрибуты товара для ЗАКАЗА на объекте " + string(p-obj-type)  + string(p-obj-code) .
     1204   if p-mode = 'ПРОСМОТР':U then
     1205      find first tt0-gds-obj-prop no-lock where
     1206                 tt0-gds-obj-prop.gds-code =  p-gds-code and
     1207                 tt0-gds-obj-prop.obj-type =  p-obj-type and
     1208                 tt0-gds-obj-prop.obj-code =  p-obj-code no-error .
     1209   else
     1210      find first tt0-gds-obj-prop exclusive-lock  where
     1211                 tt0-gds-obj-prop.gds-code =  p-gds-code and
     1212                 tt0-gds-obj-prop.obj-type =  p-obj-type and
     1213                 tt0-gds-obj-prop.obj-code =  p-obj-code no-error .
     1214    for each tt-gds-obj-prop :
     1215      delete tt-gds-obj-prop.
     1216    end.
     1217    for each tt-gds-obj-prop-attr :
     1218      delete tt-gds-obj-prop-attr.
     1219    end.
     1220     CREATE tt-gds-obj-prop.
     1221     if available tt0-gds-obj-prop then
     1222        BUFFER-COPY tt0-gds-obj-prop TO tt-gds-obj-prop .
     1223     else do:
     1224       run cur-time in this-procedure(output v-date, output v-time).
     1225       if p-gds-code = 0 then p-gds-code = -1.
     1226       assign
     1227       tt-gds-obj-prop.gdop-assort-min    = no
     1228       tt-gds-obj-prop.gdop-igt           = 'Пусто':U
     1229       tt-gds-obj-prop.gds-code           = p-gds-code
     1230       tt-gds-obj-prop.grop-date-update   = v-date
     1231       tt-gds-obj-prop.grop-time-update   = v-time
     1232       tt-gds-obj-prop.grop-db-num-update = g#db-num
     1233       tt-gds-obj-prop.grop-who-update    = g#userid
     1234       tt-gds-obj-prop.obj-code           = p-obj-code
     1235       tt-gds-obj-prop.obj-type           = p-obj-type
     1236       .
     1237     end.
     1238     for each tt0-gds-obj-prop-attr :
     1239       create tt-gds-obj-prop-attr.
     1240       buffer-copy tt0-gds-obj-prop-attr
     1241       to tt-gds-obj-prop-attr.
     1242     end.
     1243     if p-obj-type = 'маг':U
     1244     or p-obj-type = 'скл':U then do:
     1245       do v-ii = 1 to num-entries('corrcoeff-po,CorrIztDel':u):
     1246         if lookup(entry(v-ii, 'corrcoeff-po,CorrIztDel':u), 'CorrIztDel':u) = 0 then do:
     1247         find first tt-gds-obj-prop-attr where
     1248                  tt-gds-obj-prop-attr.obj-type = p-obj-type
     1249              and tt-gds-obj-prop-attr.obj-code = p-obj-code
     1250              and tt-gds-obj-prop-attr.attr-code = entry(v-ii, 'corrcoeff-po,CorrIztDel':u) no-error.
     1251         if not available tt-gds-obj-prop-attr then do:
     1252           create tt-gds-obj-prop-attr.
     1253           assign
     1254           tt-gds-obj-prop-attr.obj-type = p-obj-type
     1255           tt-gds-obj-prop-attr.obj-code = p-obj-code
     1256           tt-gds-obj-prop-attr.attr-code = entry(v-ii, 'corrcoeff-po,CorrIztDel':u)
     1257           .
     1258           define variable v-format         as character no-undo .
     1259           define variable v-label          as character no-undo .
     1260           define variable v-user-can-edit  as logical   no-undo .
     1261           define variable v-output-display as logical   no-undo .
     1262           define variable v-other          as character no-undo .
     1263           define variable v-type           as character no-undo .
     1264           run gdspoatr-name in this-procedure
     1265             (input  entry(v-ii, 'corrcoeff-po,CorrIztDel':u)
     1266             ,output v-type
     1267             ,output v-format
     1268             ,output v-label
     1269             ,output v-user-can-edit
     1270             ,output v-output-display
     1271             ,output v-other
     1272             ) no-error .
     1273           if error-status :error then do:
     1274             undo, return error return-value .
     1275           end.
     1276           do jj = 1 to num-entries(v-other, chr(47)):
     1277             if entry(1, entry(jj, v-other, chr(47)), "=":U) = "init-value":U then do:
     1278               assign
     1279               tt-gds-obj-prop-attr.attr-value = string(entry(2, entry(jj, v-other, chr(47)), "=":U))
     1280               .
     1281             end.
     1282           end.
     1283         end.
     1284         release tt-gds-obj-prop-attr.
     1285         end.
     1286       end.
     1287     end.
     1288   END PROCEDURE.
     1289   PROCEDURE proc-save :
     1290   assign frame Dialog-Frame  tt-gds-obj-prop.gdop-min-stock .
     1291   assign frame Dialog-Frame  tt-gds-obj-prop.grop-level-always-presence .
     1292   assign frame Dialog-Frame  tt-gds-obj-prop.grop-max-stock  .
     1293   assign frame Dialog-Frame  tt-gds-obj-prop.grop-min-order .
     1294   define variable p-recid as recid no-undo.
     1295   define variable v-ident as logical no-undo .
     1296   if p-update-instantly then do:
     1297       run gds-ind1
     1298           (input-output p-recid
     1299           ,tt-gds-obj-prop.gds-code
     1300           ,tt-gds-obj-prop.obj-type
     1301           ,tt-gds-obj-prop.obj-code
     1302           ,tt-gds-obj-prop.gdop-igt
     1303           ,tt-gds-obj-prop.gdop-assort-min
     1304           ,tt-gds-obj-prop.gdop-min-stock
     1305           ,tt-gds-obj-prop.grop-level-always-presence
     1306           ,tt-gds-obj-prop.grop-max-stock
     1307           ,tt-gds-obj-prop.grop-min-order
     1308           ,input table tt-gds-obj-prop-attr
     1309           ) no-error .
     1310       if error-status :error then  do:
     1311          message error-status :get-message(1) skip return-value .
     1312          return error return-value .
     1313       end.
     1314   END.
     1315   ELSE DO:
     1316      if not available tt0-gds-obj-prop then
     1317      create tt0-gds-obj-prop.
     1318       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1319         p-updated = yes.
     1320       end.
     1321       else do:
     1322         if available tt0-gds-obj-prop then do:
     1323           buffer-compare tt0-gds-obj-prop
     1324           to
     1325           tt-gds-obj-prop save result in v-ident.
     1326           assign
     1327           p-updated = not v-ident.
     1328         end.
     1329         else do:
     1330           if available tt-gds-obj-prop then p-updated = yes.
     1331         end.
     1332       end.
     1333      buffer-copy tt-gds-obj-prop
     1334      except gds-code
     1335      to tt0-gds-obj-prop
     1336      .
     1337      if p-obj-type = 'маг':U
     1338      or p-obj-type = 'скл':U then do:
     1339        for each tt-gds-obj-prop-attr:
     1340          find first tt0-gds-obj-prop-attr where
     1341                     tt0-gds-obj-prop-attr.obj-type = p-obj-type
     1342                 and tt0-gds-obj-prop-attr.obj-code = p-obj-code
     1343                 and tt0-gds-obj-prop-attr.attr-code = tt-gds-obj-prop-attr.attr-code no-error .
     1344          if not available tt0-gds-obj-prop-attr then do:
     1345            create tt0-gds-obj-prop-attr.
     1346            p-updated = yes.
     1347          end.
     1348           buffer-compare tt0-gds-obj-prop-attr
     1349           to
     1350           tt-gds-obj-prop-attr save result in v-ident.
     1351           assign
     1352           p-updated = (p-updated or not v-ident).
     1353          buffer-copy tt-gds-obj-prop-attr
     1354          except gds-code
     1355          to
     1356          tt0-gds-obj-prop-attr .
     1357        end.
     1358      end.
     1359   END.
     1360   END PROCEDURE.
