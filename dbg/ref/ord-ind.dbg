      515   procedure gds-ind1 :
      516   main-block:
      517     do
      518   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      519   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      520   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      521     :
      522   define input-output parameter p-doc-rec  as recid no-undo.
      523   define input  parameter p-gds-code                   like  ub.gds-obj-prop.gds-code no-undo.
      524   define input  parameter p-obj-type                   like  ub.gds-obj-prop.obj-type no-undo.
      525   define input  parameter p-obj-code                   like  ub.gds-obj-prop.obj-code no-undo.
      526   define input  parameter p-gdop-igt                   like  ub.gds-obj-prop.gdop-igt no-undo.
      527   define input  parameter p-gdop-assort-min            like  ub.gds-obj-prop.gdop-assort-min  no-undo.
      528   define input  parameter p-gdop-min-stock             like  ub.gds-obj-prop.gdop-min-stock   no-undo.
      529   define input  parameter p-grop-level-always-presence like  ub.gds-obj-prop.grop-level-always-presence  no-undo.
      530   define input  parameter p-grop-max-stock             like  ub.gds-obj-prop.grop-max-stock              no-undo.
      531   define input  parameter p-grop-min-order             like  ub.gds-obj-prop.grop-min-order              no-undo.
      532   DEFINE INPUT  PARAMETER TABLE  FOR tt0-gds-obj-prop-attr.
      533   define buffer buf_tt0-gds-obj-prop-attr for tt0-gds-obj-prop-attr.
      534   define buffer bufs_gds-obj-prop for ub.gds-obj-prop.
      535   define variable v-db-num like ub.db.db-num no-undo .
      536   define variable v-db-num-obj like ub.db.db-num no-undo .
      537   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      538   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      539     (output v-db-num
      540     )  .
      541   define variable v-date as date no-undo .
      542   define variable v-time as integer no-undo .
      543   run cur-time in this-procedure(output v-date, output v-time).
      544     find first bufs_gds-obj-prop exclusive-lock where
      545               bufs_gds-obj-prop.gds-code          = p-gds-code   and
      546               bufs_gds-obj-prop.obj-type          = p-obj-type   and
      547               bufs_gds-obj-prop.obj-code          = p-obj-code  no-error .
      548       if not available bufs_gds-obj-prop then do:
      549           create bufs_gds-obj-prop.
      550           assign
      551               bufs_gds-obj-prop.gds-code           = p-gds-code
      552               bufs_gds-obj-prop.grop-date-update   = v-date
      553               bufs_gds-obj-prop.grop-time-update   = v-time
      554               bufs_gds-obj-prop.grop-db-num-update = v-db-num
      555               bufs_gds-obj-prop.obj-type           = p-obj-type
      556               bufs_gds-obj-prop.obj-code           = p-obj-code
      557           no-error .
      558           if error-status :error then message "Ошибка при создании записи" error-status :error error-status :get-message(1) .
      559       end.
      560   if  p-gdop-igt                     <> ? then    bufs_gds-obj-prop.gdop-igt                   = p-gdop-igt.
      561   if  p-gdop-assort-min              <> ? then    bufs_gds-obj-prop.gdop-assort-min            = p-gdop-assort-min.
      562   if  p-gdop-min-stock               <> ? then    bufs_gds-obj-prop.gdop-min-stock             = p-gdop-min-stock  .
      563   if  p-grop-level-always-presence   <> ? then    bufs_gds-obj-prop.grop-level-always-presence = p-grop-level-always-presence.
      564   if  p-grop-max-stock               <> ? then    bufs_gds-obj-prop.grop-max-stock             = p-grop-max-stock           .
      565   if  p-grop-min-order               <> ? then    bufs_gds-obj-prop.grop-min-order             = p-grop-min-order           .
      566         p-doc-rec = recid(bufs_gds-obj-prop)    .
      567   for each buf_tt0-gds-obj-prop-attr
      568   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      569   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      570   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      571   :
      572     if buf_tt0-gds-obj-prop-attr.attr-value <> ?
      573     and lookup(buf_tt0-gds-obj-prop-attr.attr-code, 'CorrIztDel':u) = 0
      574     then do:
      575       run gdspoatr-write in this-procedure (
      576                                               input p-gds-code
      577                                               ,input p-obj-type
      578                                               ,input p-obj-code
      579                                               ,input buf_tt0-gds-obj-prop-attr.attr-code
      580                                               ,input buf_tt0-gds-obj-prop-attr.attr-value
      581                                               ).
      582     end.
      583   end.
      584   end.
      585   end procedure.
