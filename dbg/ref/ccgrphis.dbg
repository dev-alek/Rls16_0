      855   procedure grp-attr-obj-value :
      856   do
      857   on error undo, return error
      858   :
      859   define input parameter p-node-code as integer      no-undo.
      860   define input parameter p-obj-type  as character    no-undo.
      861   define input parameter p-obj-code  as integer      no-undo.
      862   define input parameter p-attr-code as character    no-undo .
      863   define output parameter p-attr-value     as character   no-undo.
      864   define output parameter p-range     as integer      no-undo.
      865   define output parameter p-exists    as logical      no-undo.
      866   define variable v-host-code as integer      no-undo.
      867   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      868   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      869     (input  p-obj-type
      870     ,input  p-obj-code
      871     ,output v-host-code
      872     ) no-error .
      873   if error-status :error
      874   then do:
      875       message
      876         vss-workfile vss-revision vss-description
      877         skip "Не удалось найти фирму объекта"
      878         skip p-obj-type p-obj-code
      879         skip return-value
      880         skip trim(error-status :get-message(1))
      881              trim(error-status :get-message(2))
      882              trim(error-status :get-message(3))
      883              trim(error-status :get-message(4))
      884              trim(error-status :get-message(5))
      885       view-as alert-box error.
      886       undo, return error .
      887   end.
      888   define buffer buf_gds-grp-attr      for ub.gds-grp-attr.
      889   find first buf_gds-grp-attr no-lock
      890        where buf_gds-grp-attr.node-code = p-node-code
      891          and buf_gds-grp-attr.attr-code = p-attr-code
      892          and buf_gds-grp-attr.host-code = v-host-code
      893          and buf_gds-grp-attr.obj-type  = p-obj-type
      894          and buf_gds-grp-attr.obj-code  = p-obj-code
      895   no-error .
      896   if not available buf_gds-grp-attr
      897   then do:
      898       find first buf_gds-grp-attr no-lock
      899            where buf_gds-grp-attr.node-code = p-node-code
      900              and buf_gds-grp-attr.attr-code = p-attr-code
      901              and buf_gds-grp-attr.host-code = v-host-code
      902              and buf_gds-grp-attr.obj-type  = ""
      903              and buf_gds-grp-attr.obj-code  = 0
      904       no-error .
      905       if not available buf_gds-grp-attr
      906       then do:
      907           find first buf_gds-grp-attr no-lock
      908               where buf_gds-grp-attr.node-code = p-node-code
      909               and buf_gds-grp-attr.attr-code = p-attr-code
      910               and buf_gds-grp-attr.host-code = 0
      911               and buf_gds-grp-attr.obj-type  = ""
      912               and buf_gds-grp-attr.obj-code  = 0
      913           no-error .
      914           if not available buf_gds-grp-attr
      915           then do:
      916               assign
      917                   p-exists = no
      918               .
      919           end.
      920           else do:
      921               assign
      922                   p-exists = yes
      923                   p-range  = 1
      924               .
      925           end.
      926       end.
      927       else do:
      928           assign
      929               p-exists = yes
      930               p-range  = 2
      931           .
      932       end.
      933   end.
      934   else do:
      935       assign
      936           p-exists = yes
      937           p-range  = 3
      938       .
      939   end.
      940   if available buf_gds-grp-attr
      941   then do:
      942     assign
      943     p-attr-value = buf_gds-grp-attr.attr-value
      944     .
      945   end.
      946   end.
      947   end procedure.
      948   procedure ver-gds-grp-nabor :
      949   do
      950   on error undo, return error return-value
      951   :
      952   define input  parameter p-gds-code as integer   no-undo .
      953   define output parameter p-nabor as logical   no-undo .
      954   define buffer buf_goods for ub.goods.
      955   p-nabor = false .
      956   find first  buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
      957   if error-status :error then return error .
      958   define variable v-value       as character  no-undo.
      959   define variable v-type        as character  no-undo.
      960     run grp-attr-value (
      961        input   buf_goods.grp-code
      962       ,input   'gds-grp-nabor':U
      963       ,input   0
      964       ,input   ""
      965       ,input   0
      966       ,output  v-value
      967       ,output  v-type       ) no-error .
      968       if error-status :error then return error .
      969     if v-value = "yes" then p-nabor = true  .
      970   end.
      971   end procedure.
      972   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      973   FUNCTION mark-string RETURNS CHARACTER
      974     ( input p-recid as recid, input mark-list as character  ) :
      975     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      976   END FUNCTION.
      977   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      978   function usrfulnf returns character ( input p-user-id as character):
      979   define variable v-user-name as character no-undo .
      980   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      981   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      982     (input  p-user-id
      983     ,output v-user-name
      984     ) no-error .
      985   if error-status:error
      986   or v-user-name = ""
      987   then do:
      988     return p-user-id.
      989   end.
      990   else do:
      991     return v-user-name.
      992   end.
      993   end function.
      994   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      995   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      996   procedure fltopend_fltopend :
      997   define input parameter p-parent-handle as handle no-undo .
      998   define input parameter p-qh as handle no-undo .
      999   define input parameter p-flt-open-open-query  as character no-undo .
     1000   define input parameter p-where-cond as character no-undo .
     1001   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1002   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1003   define input parameter p-indexed-reposition as character no-undo .
     1004     do
     1005     on error undo, return error
     1006     :
     1007   define variable v-prepare-string as character no-undo .
     1008   define variable glog as logical no-undo .
     1009   assign
     1010   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1011                      p-where-cond + chr(32)  +
     1012                      p-use-indFIRST-query-tail + chr(32) +
     1013                      p-use-ind-sort-clmn-by + chr(32) +
     1014                      p-indexed-reposition
     1015   .
     1016   assign
     1017   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1018   if not glog
     1019   or error-status:error then do:
     1020     message error-status:get-message(1) view-as alert-box .
     1021     undo, return error .
     1022   end.
     1023   assign
     1024   glog = p-qh:query-open no-error .
     1025   if not glog
     1026   or error-status:error then do:
     1027     message error-status:get-message(1) view-as alert-box .
     1028     undo, return error .
     1029   end.
     1030     end.
     1031   end procedure.
     1032   procedure fltopend_fltfindd :
     1033   define input parameter p-parent-handle as handle no-undo .
     1034   define input parameter p-qh as handle no-undo .
     1035   define input parameter p-rowid as rowid no-undo .
     1036   define input parameter p-next as logical no-undo .
     1037   define input parameter p-lock as integer no-undo .
     1038   define input parameter p-bh as handle no-undo .
     1039   define input parameter p-where-cond as character no-undo .
     1040   define input parameter p-use-index-phrase as character no-undo .
     1041   define variable glog as logical no-undo .
     1042   define variable v-qh as handle no-undo .
     1043   define variable v-bh as handle no-undo .
     1044   define variable v-recid as recid no-undo .
     1045   define variable v-prepare-string as character no-undo .
     1046   do
     1047   on error undo, return error
     1048   on stop undo, return error
     1049   :
     1050     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1051     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1052     create query v-qh.
     1053     v-qh:set-buffers(v-bh).
     1054     v-prepare-string = substitute("for each &1 &2 &3"
     1055                                     ,v-bh:name
     1056                                     ,p-where-cond
     1057                                     ,p-use-index-phrase).
     1058     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1059     if not glog then do:
     1060       delete object v-qh.
     1061       delete object v-bh.
     1062       undo, return error .
     1063     end.
     1064     glog = v-qh:query-open no-error .
     1065     if not glog then do:
     1066       delete object v-qh.
     1067       delete object v-bh.
     1068       undo, return error .
     1069     end.
     1070     if p-next then do:
     1071       v-qh:reposition-to-rowid(p-rowid) no-error .
     1072       glog = v-qh:get-next( p-lock) no-error .
     1073       glog = v-qh:get-next( p-lock) no-error .
     1074       if not glog or v-qh:query-off-end = yes then do:
     1075         glog = v-qh:get-first( p-lock) no-error .
     1076       end.
     1077     end.
     1078     else do:
     1079       glog = v-qh:get-first( p-lock) no-error .
     1080     end.
     1081     v-recid = v-bh:recid no-error .
     1082     delete object v-qh.
     1083     delete object v-bh.
     1084     return string(v-recid) .
     1085   end.
     1086   end procedure.
     1087   procedure fltopend_fltfindq :
     1088   define input parameter p-parent-handle as handle no-undo .
     1089   define input parameter p-qh as handle no-undo .
     1090   define input parameter p-next as logical no-undo .
     1091   define input parameter p-lock as integer no-undo .
     1092   define input parameter p-flt-open-open-query  as character no-undo .
     1093   define input parameter p-where-cond as character no-undo .
     1094   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1095   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1096   define input parameter p-indexed-reposition as character no-undo .
     1097   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1098   define variable glog as logical no-undo .
     1099   define variable v-qh as handle no-undo .
     1100   define variable v-bh as handle no-undo extent 18.
     1101   define variable v-rowid as rowid no-undo extent 18.
     1102   define variable v-ii as integer no-undo .
     1103   define variable v-prepare-string as character no-undo .
     1104   do
     1105   on error undo, return error
     1106   on stop undo, return error
     1107   :
     1108     create query v-qh.
     1109     do v-ii = 1 to p-qh:num-buffers:
     1110       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1111       assign
     1112       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1113       no-error.
     1114       v-qh:add-buffer(v-bh[v-ii]).
     1115     end.
     1116     assign
     1117     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1118                       p-where-cond + chr(32)  +
     1119                       p-use-indFIRST-query-tail + chr(32) +
     1120                       p-use-ind-sort-clmn-by + chr(32) +
     1121                       p-indexed-reposition
     1122     .
     1123     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1124     if not glog then do:
     1125       delete object v-qh.
     1126       do v-ii = 1 to p-qh:num-buffers:
     1127         delete object v-bh[v-ii].
     1128       end.
     1129       undo, return error .
     1130     end.
     1131     glog = v-qh:query-open no-error .
     1132     if not glog then do:
     1133       delete object v-qh.
     1134       do v-ii = 1 to p-qh:num-buffers:
     1135         delete object v-bh[v-ii].
     1136       end.
     1137       undo, return error .
     1138     end.
     1139     if p-next then do:
     1140       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1141       glog = v-qh:get-next( p-lock) no-error .
     1142       glog = v-qh:get-next( p-lock) no-error .
     1143       if not glog or v-qh:query-off-end = yes then do:
     1144         glog = v-qh:get-first( p-lock) no-error .
     1145       end.
     1146     end.
     1147     else do:
     1148       glog = v-qh:get-first( p-lock) no-error .
     1149     end.
     1150     do v-ii = 1 to p-qh:num-buffers:
     1151       assign
     1152       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1153       no-error.
     1154     end.
     1155     delete object v-qh.
     1156     do v-ii = 1 to p-qh:num-buffers:
     1157       delete object v-bh[v-ii].
     1158     end.
     1159   end.
     1160   end procedure.
     1161   define variable log-res as log no-undo.
     1162   define variable rr as recid no-undo.
     1163   define variable jj as integer no-undo .
     1164   define variable str as char no-undo.
     1165   define variable vartbl-name as char no-undo.
     1166   define variable varact      as char no-undo.
     1167   define variable filter-point0 as character no-undo init "cggrphist":U .
     1168   define variable filter-point as character no-undo init "cggrphist":U .
     1169   define variable sort-column-name as character no-undo .
     1170   define variable v-doc-rec as recid no-undo .
     1171   define variable v-rid-list as character no-undo .
     1172   define buffer X_cli-grp for ub.cli-grp.
     1173   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1174   define NEW SHARED temp-table temp-changes no-undo
     1175   field f_name as character
     1176   field l_name as character
     1177   field v_old as character
     1178   field v_new as character
     1179   field t_name as character
     1180   field num_ as integer
     1181   field uniq-key-rec as character
     1182   field action as integer
     1183   field fNotChange as logical
     1184   index pi is unique primary
     1185   num_
     1186   t_name
     1187   f_name
     1188   index
     1189   Chan
     1190   fnotChange
     1191   t_name
     1192   f_name
     1193   index imain uniq-key-rec
     1194   .
     1195   FUNCTION get-all-fields returns character (p-file-name as character ):
     1196   define variable v-dop as character no-undo .
     1197     find first _file no-lock where _file._file-name = p-file-name no-error .
     1198     if not available _file then return "":U.
     1199     for each _field no-lock where
     1200              _field._file-recid = recid(_file) :
     1201       assign
     1202       v-dop = v-dop + _field._field-name + chr(44)
     1203       .
     1204     end.
     1205     return trim(v-dop).
     1206   END FUNCTION.
     1207   PROCEDURE proc-full-temp-changes :
     1208     define input  parameter p-hst-handle as handle    no-undo .
     1209     define input  parameter p-main-table as character no-undo .
     1210     define input  parameter p-field-list as character no-undo .
     1211     define input  parameter p-label-form as character no-undo .
     1212     define variable h-new-buf         as handle    no-undo .
     1213     define variable h-main-buf        as handle    no-undo .
     1214     define variable h-for-comp        as handle    no-undo .
     1215     define variable v-inform          as character no-undo .
     1216     define variable v-ind             as integer   no-undo .
     1217     define variable v-idx-field-qnty  as integer   no-undo .
     1218     define variable v-num-entries     as integer   no-undo .
     1219     define variable fh                as handle    no-undo .
     1220     define variable fh-main           as handle    no-undo .
     1221     define variable fh-old            as handle    no-undo .
     1222     define variable fh-new            as handle    no-undo .
     1223     define variable v-field-name      as character no-undo .
     1224     define variable v-field-lvl       as character no-undo .
     1225     define variable v-field-form      as character no-undo .
     1226     define variable v-search-exp      as character no-undo .
     1227     define variable v-srch-main       as character no-undo .
     1228     define variable v-word-link       as character no-undo .
     1229     define variable v-av-chip-num     as logical   no-undo .
     1230     define variable v-main-pi-fld-lst as character no-undo .
     1231     define variable v-main-fld-lst    as character no-undo .
     1232     define variable v-delim-list      as character no-undo .
     1233     define variable v-label           as character no-undo .
     1234     define variable v-old-value       as character no-undo case-sensitive.
     1235     define variable v-new-value       as character no-undo case-sensitive.
     1236     define variable v-chg-fields as character no-undo.
     1237     for each temp-changes:
     1238       delete temp-changes.
     1239     end.
     1240     if not p-hst-handle:available then do:
     1241       return .
     1242     end.
     1243     create buffer h-new-buf  for table p-hst-handle .
     1244     create buffer h-main-buf for table p-main-table .
     1245     assign
     1246       v-inform = h-main-buf:index-information(1)
     1247       v-ind    = 2
     1248     .
     1249     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1250     on error undo, return error
     1251     :
     1252       assign
     1253         v-inform = h-main-buf:index-information( v-ind )
     1254         v-ind    = v-ind + 1
     1255       .
     1256     end.
     1257     if v-inform = ?
     1258       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1259       or entry( 3, v-inform, ",":U ) <> "1":U
     1260     then do:
     1261       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1262     end.
     1263     assign
     1264       v-idx-field-qnty = num-entries( v-inform ) - 4
     1265     .
     1266     if v-idx-field-qnty < 2 then do:
     1267       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1268     end.
     1269     assign
     1270       v-srch-main   = "where":U
     1271       v-word-link   = "":U
     1272       v-av-chip-num = false
     1273       v-delim-list  = "":U
     1274     .
     1275     do v-ind = 1 to v-idx-field-qnty by 2
     1276     on error undo, return error
     1277     :
     1278       assign
     1279         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1280         fh                = p-hst-handle:buffer-field( v-field-name )
     1281         fh-main           = h-main-buf:buffer-field( v-field-name )
     1282         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1283         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1284       .
     1285       if fh:data-type ="character":U then do:
     1286         assign
     1287           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1288         .
     1289       end.
     1290       else do:
     1291         assign
     1292           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1293         .
     1294       end.
     1295       if v-delim-list = "":U then do:
     1296         assign
     1297           v-delim-list = ",":U
     1298         .
     1299       end.
     1300       if v-word-link = "":U then do:
     1301         assign
     1302           v-word-link = "and":U
     1303         .
     1304       end.
     1305     end.
     1306     assign
     1307       v-delim-list  = "":U
     1308     .
     1309     do v-ind = 1 to h-main-buf:num-fields
     1310     on error undo, return error
     1311     :
     1312       assign
     1313         fh-main      = h-main-buf:buffer-field( v-ind )
     1314         v-field-name = fh-main:name
     1315       .
     1316         assign
     1317           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1318         .
     1319         if v-delim-list = "":U then do:
     1320           assign
     1321             v-delim-list = ",":U
     1322           .
     1323         end.
     1324     end.
     1325     assign
     1326       v-inform = p-hst-handle:index-information(1)
     1327       v-ind    = 2
     1328     .
     1329     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1330     on error undo, return error
     1331     :
     1332       assign
     1333         v-inform = p-hst-handle:index-information( v-ind )
     1334         v-ind    = v-ind + 1
     1335       .
     1336     end.
     1337     if v-inform = ?
     1338       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1339       or entry( 3, v-inform, ",":U ) <> "1":U
     1340     then do:
     1341       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1342     end.
     1343     assign
     1344       v-idx-field-qnty = num-entries( v-inform ) - 4
     1345     .
     1346     if v-idx-field-qnty < 2 then do:
     1347       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1348     end.
     1349     assign
     1350       v-search-exp  = "where":U
     1351       v-word-link   = "":U
     1352       v-av-chip-num = false
     1353     .
     1354     do v-ind = 1 to v-idx-field-qnty by 2
     1355     on error undo, return error
     1356     :
     1357       assign
     1358         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1359         fh           = p-hst-handle:buffer-field( v-field-name )
     1360         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1361       .
     1362       if v-field-name = "chip-num":U then do:
     1363         assign
     1364           v-search-exp  = substitute( "&1 >", v-search-exp )
     1365           v-av-chip-num = true
     1366         .
     1367       end.
     1368       else do:
     1369         assign
     1370           v-search-exp = substitute( "&1 =", v-search-exp )
     1371         .
     1372       end.
     1373       if fh:data-type ="character":U then do:
     1374         assign
     1375           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1376         .
     1377       end.
     1378       else do:
     1379         assign
     1380           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1381         .
     1382       end.
     1383       if v-word-link = "":U then do:
     1384         assign
     1385           v-word-link = "and":U
     1386         .
     1387       end.
     1388     end.
     1389     if v-av-chip-num = false then do:
     1390       message
     1391         vss-workfile vss-revision vss-description skip
     1392         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1393         "Использование данной процедуры невозможно!" skip
     1394         view-as alert-box error .
     1395       return error .
     1396     end.
     1397     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1398     if not h-new-buf:available then do:
     1399       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1400       if not h-main-buf:available then do:
     1401         assign
     1402           h-for-comp = ?
     1403         .
     1404       end.
     1405       else do:
     1406         assign
     1407           h-for-comp = h-main-buf
     1408         .
     1409       end.
     1410     end.
     1411     else do:
     1412       assign
     1413         h-for-comp = h-new-buf
     1414       .
     1415     end.
     1416     assign
     1417       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1418     .
     1419     do v-ind = 1 to v-num-entries
     1420     on error undo, return error return-value
     1421     :
     1422       assign
     1423         v-field-name = entry( v-ind, v-main-fld-lst )
     1424         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1425         v-old-value  = fh-old:buffer-value()
     1426         v-label      = trim( fh-old:label )
     1427       .
     1428       if ( trim( p-field-list ) <> "":U
     1429            and lookup( v-field-name, p-field-list ) > 0
     1430          )
     1431          or trim( p-field-list ) = "":U
     1432       then do:
     1433         if h-for-comp <> ? then do:
     1434           assign
     1435             fh-new      = h-for-comp:buffer-field( v-field-name )
     1436             v-new-value = fh-new:buffer-value()
     1437           .
     1438         end.
     1439         else do:
     1440           assign
     1441             v-new-value = "":U
     1442           .
     1443         end.
     1444         if v-old-value <> v-new-value
     1445         then do:
     1446           create temp-changes.
     1447           assign
     1448             temp-changes.t_name = p-main-table
     1449             temp-changes.f_name = v-field-name
     1450             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1451             temp-changes.v_old  = trim( v-old-value )
     1452             temp-changes.v_new  = trim( v-new-value )
     1453             temp-changes.num_   = 0
     1454             temp-changes.fNotChange = v-old-value eq v-new-value
     1455           .
     1456         end.
     1457       end.
     1458     end.
     1459     assign
     1460       v-num-entries = num-entries( p-label-form, chr(8) )
     1461     .
     1462     do v-ind = 1 to v-num-entries
     1463     on error undo, return error return-value
     1464     :
     1465       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1466         assign
     1467           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1468           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1469           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1470         .
     1471         find first temp-changes
     1472           where temp-changes.f_name = v-field-name
     1473           no-error .
     1474         if available temp-changes then do:
     1475           if trim( v-field-lvl ) <> "":U then do:
     1476             assign
     1477               temp-changes.l_name = v-field-lvl
     1478             .
     1479           end.
     1480           if trim( v-field-form ) <> "":U then do:
     1481             assign
     1482               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1483             .
     1484             if h-for-comp <> ? then do:
     1485               assign
     1486                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1487               .
     1488             end.
     1489           end.
     1490         end.
     1491       end.
     1492       else do:
     1493         message
     1494           vss-workfile vss-revision vss-description skip
     1495           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1496           substitute( "список для поля '&1': '&2'"
     1497                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1498                       ,entry( v-ind, p-label-form, chr(8) )
     1499                     ) skip
     1500           substitute( "полный список: &2", p-label-form ) skip
     1501           view-as alert-box error .
     1502       end.
     1503     end.
     1504     delete object h-new-buf .
     1505     delete object h-main-buf .
     1506   END PROCEDURE.
     1507   FUNCTION get-action RETURNS CHARACTER
     1508     (  p-action as integer )  FORWARD.
     1509   FUNCTION get-subject RETURNS CHARACTER
     1510     ( p-subject as character )  FORWARD.
     1511   DEFINE BUTTON B-Help
     1512        LABEL "Помо&щь"
     1513        SIZE 3 BY 1
     1514        BGCOLOR 8 .
     1515   DEFINE BUTTON B-mark
     1516        LABEL "&*"
     1517        SIZE 3 BY 1.
     1518   DEFINE BUTTON b-quit AUTO-END-KEY
     1519        LABEL "&Выход"
     1520        SIZE 10 BY 1
     1521        BGCOLOR 8 .
     1522   DEFINE BUTTON B-sch
     1523        LABEL "&Фильтр"
     1524        SIZE 3 BY 1.
     1525   DEFINE BUTTON b-sel AUTO-GO
     1526        LABEL "Вы&бор"
     1527        SIZE 10 BY 1.
     1528   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1529        VIEW-AS FILL-IN
     1530        SIZE 9 BY 1
     1531        FGCOLOR 4  NO-UNDO.
     1532   DEFINE VARIABLE v-full-name-new AS CHARACTER FORMAT "X(256)":U
     1533        LABEL "Стало"
     1534        VIEW-AS FILL-IN
     1535        SIZE 91 BY 1 NO-UNDO.
     1536   DEFINE VARIABLE v-full-name-old AS CHARACTER FORMAT "X(256)":U
     1537        LABEL "Было"
     1538        VIEW-AS FILL-IN
     1539        SIZE 91 BY 1 NO-UNDO.
     1540   DEFINE QUERY BR-c-cli-grp FOR
     1541         X_c-cli-grp SCROLLING.
     1542   DEFINE QUERY BR-changes FOR
     1543         temp-changes SCROLLING.
     1544   DEFINE BROWSE BR-c-cli-grp
     1545     QUERY BR-c-cli-grp DISPLAY
     1546         mark-string( recid(X_c-cli-grp), v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     1547         get-subject(X_c-cli-grp.subject) column-label "Предмет изменений" format "X(20)"
     1548         X_c-cli-grp.corr-date COLUMN-LABEL "Дата корр"
     1549         usrfulnf(X_c-cli-grp.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)"
     1550         X_c-cli-grp.corr-user-db-num COLUMN-LABEL "БД" WIDTH 3
     1551         string(X_c-cli-grp.corr-time, "HH:MM") COLUMN-LABEL "Время!корр" FORMAT "X(5)":U
     1552               WIDTH 6
     1553         get-action(X_c-cli-grp.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1554               WIDTH 12
     1555       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.25.
     1556   DEFINE BROWSE BR-changes
     1557     QUERY BR-changes DISPLAY
     1558         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1559   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1560   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1561       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 5.25.
     1562   DEFINE FRAME Dialog-Frame
     1563        b-quit AT ROW 1 COL 1
     1564        B-mark AT ROW 1 COL 11
     1565        b-sel AT ROW 1 COL 14
     1566        B-sch AT ROW 1 COL 92
     1567        B-Help AT ROW 1 COL 95
     1568        mark-num AT ROW 1.92 COL 9 COLON-ALIGNED NO-LABEL
     1569        BR-c-cli-grp AT ROW 3 COL 1
     1570        BR-changes AT ROW 14.5 COL 1
     1571        v-full-name-old AT ROW 20 COL 2
     1572        v-full-name-new AT ROW 21 COL 1
     1573        SPACE(0.24) SKIP(0.04)
     1574       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1575            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1576            TITLE "Справочник истории групп клиентов"
     1577            CANCEL-BUTTON b-quit.
     1578   ASSIGN
     1579          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1580          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1581   ASSIGN
     1582          BR-c-cli-grp:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1583   ON GO OF FRAME Dialog-Frame
     1584   DO:
     1585     p-rid-list = v-rid-list.
     1586   END.
     1587   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1588   DO:
     1589     APPLY "END-ERROR":U TO SELF.
     1590   END.
     1591   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1592   DO:
     1593   define variable g#log as logical no-undo .
     1594   if not available X_c-cli-grp then return no-apply .
     1595   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1596   define variable v-str-recid14 as character no-undo .
     1597   define variable v-num-entry14 as integer   no-undo .
     1598   assign
     1599     v-str-recid14 = trim( string( recid( X_c-cli-grp ) , "->>>>>>>>>>>9":U ) )
     1600     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1601   .
     1602   if v-num-entry14 > 0 then do:
     1603     assign
     1604       entry( v-num-entry14, v-rid-list ) = "":U
     1605       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1606     .
     1607   end.
     1608   else do:
     1609     assign
     1610       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1611     .
     1612   end.
     1613    g#log = br-c-cli-grp :refresh( )  in frame Dialog-Frame.
     1614     if not can-do ("MOUSE-SELECT-DBLCLICK,Return", last-event:function) then do:
     1615             g#log = br-c-cli-grp:select-next-row () in frame Dialog-Frame.
     1616             apply "value-changed" to br-c-cli-grp in frame Dialog-Frame.
     1617     end.
     1618     if num-entries (v-rid-list) = 0 then
     1619         hide mark-num in frame Dialog-Frame.
     1620     else
     1621     disp num-entries (v-rid-list) @ mark-num
     1622     with frame Dialog-Frame.
     1623     apply "entry" to br-c-cli-grp in frame Dialog-Frame.
     1624   END.
     1625   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1626   DO:
     1627     run proc-b-sch in this-procedure no-error.
     1628     if error-status:error then return no-apply.
     1629   END.
     1630   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1631   DO:
     1632       if ( available X_c-cli-grp ) AND ( v-rid-list = "" ) then
     1633           v-rid-list = string( recid( X_c-cli-grp ) ) .
     1634   END.
     1635   ON RETURN OF BR-c-cli-grp IN FRAME Dialog-Frame
     1636   DO:
     1637         apply "DEFAULT-ACTION":U to self.
     1638   END.
     1639   ON VALUE-CHANGED OF BR-c-cli-grp IN FRAME Dialog-Frame
     1640   DO:
     1641     run proc-view-changes in this-procedure no-error.
     1642   END.
     1643   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1644   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1645   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1646   on help of frame Dialog-Frame
     1647   do:
     1648     run gbl/app_help.p
     1649       (input this-procedure :file-name
     1650       ,input ''
     1651       ,input ?
     1652       ) no-error.
     1653     if error-status :error then do:
     1654       message
     1655         "Ошибка при вызове помощи"
     1656         error-status :get-message(1)
     1657         view-as alert-box .
     1658     end.
     1659   end.
     1660   run minbtn-set in this-procedure .
     1661   on choose of b-help in frame Dialog-Frame
     1662   do:
     1663     apply "help":u to frame Dialog-Frame .
     1664   end.
     1665   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1666   procedure minbtn-set :
     1667       do
     1668           on error undo, return error return-value
     1669           :
     1670           define variable ii              as integer       no-undo .
     1671           define variable fh              as widget-handle no-undo .
     1672           define variable hh              as widget-handle no-undo .
     1673           define variable v-h             as handle        extent 4 no-undo .
     1674           define variable v-name-button   as character     no-undo .
     1675           define variable v-help-old-x    as decimal       no-undo .
     1676           define variable v-help-old-y    as decimal       no-undo .
     1677           define variable v-help-old-size as decimal       no-undo .
     1678           define variable v-frame-width   as decimal       no-undo .
     1679           define variable jj              as integer       no-undo .
     1680           do
     1681               on error undo, return error
     1682               :
     1683               assign
     1684                   v-frame-width = frame Dialog-Frame:width - 0.3
     1685                   fh            = frame Dialog-Frame:first-child
     1686                   hh            = fh:first-child
     1687                   ii            = 1
     1688                   .
     1689               do while valid-handle(hh):
     1690                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1691                   do:
     1692                       case lc(hh:name) :
     1693                           when "b-help" then
     1694                               do:
     1695                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1696                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1697                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1698                                   hh:TOOLTIP = "Помощь" .
     1699                                   v-help-old-x = hh:column .
     1700                                   v-help-old-y = hh:row    .
     1701                                   v-help-old-size = hh:width .
     1702                                   hh:width-chars = 2.5 .
     1703                               end.
     1704                           when "b-print" then
     1705                               do:
     1706                                   hh:load-image("cmp/b-print.bmp":u) .
     1707                                   hh:TOOLTIP = "Печать" .
     1708                                   v-h[ii] = hh:handle .
     1709                                   ii = ii + 1 .
     1710                                   hh:width-chars = 3 .
     1711                               end.
     1712                           when "b-history" or
     1713                           when "b-hist" then
     1714                               do:
     1715                                   hh:load-image("cmp/b-hist.bmp":u) .
     1716                                   hh:TOOLTIP = "История" .
     1717                                   v-h[ii] = hh:handle .
     1718                                   ii = ii + 1 .
     1719                                   hh:width-chars = 3 .
     1720                               end.
     1721                           when "b-sch" then
     1722                               do:
     1723                                   hh:load-image("cmp/b-sch.bmp":u) .
     1724                                   hh:TOOLTIP = "Установка Фильтра" .
     1725                                   v-h[ii] = hh:handle .
     1726                                   ii = ii + 1 .
     1727                                   hh:width-chars = 3 .
     1728                               end.
     1729                           when "b-hist-user" then
     1730                               do:
     1731                                   hh:load-image("cmp/b-hist.bmp":u) .
     1732                                   hh:TOOLTIP = "История пользователя" .
     1733                                   ii = ii + 1 .
     1734                               end.
     1735                       end case.
     1736                   end.
     1737                   hh = hh:next-sibling.
     1738               end.
     1739               b-help:column = v-frame-width - b-help:width-chars.
     1740               jj = 0.
     1741               repeat ii = 4 to 1 by -1 :
     1742                   if valid-handle (v-h[ii] ) then
     1743                   do:
     1744                       jj  = jj + 1 .
     1745                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1746                       v-h[ii]:row    = v-help-old-y .
     1747                   end.
     1748               end.
     1749           end.
     1750       end.
     1751   end procedure.
     1752   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1753   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1754   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1755   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1756   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1757   define variable v-diasize-current-frame-height as decimal   no-undo .
     1758   define variable v-diasize-change-size          as logical   no-undo .
     1759   define variable v-diasize-resize-button        as handle    no-undo .
     1760   define variable v-diasize-wndmax               as logical   no-undo .
     1761   define variable v-diasize-wndstore             as logical   no-undo .
     1762   define variable v-diasize-proc-name            as character no-undo .
     1763   define variable v-diasize-browse-handle        as handle    no-undo .
     1764   define variable v-diasize-browse-number        as integer   no-undo .
     1765   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1766   define temp-table temp-diasize-handle no-undo
     1767     field handle-value  as handle
     1768     field save-position as decimal
     1769     index xpk is primary unique handle-value
     1770     .
     1771   define temp-table temp-browse-handle no-undo
     1772     field browse-type   as character
     1773     field browse-number as integer
     1774     field browse-handle as handle
     1775     field original-size as decimal
     1776     index xpk is primary unique browse-type browse-number
     1777     index xie browse-type browse-handle
     1778   .
     1779   procedure diasize_change-height :
     1780     define input  parameter p-change-value  as decimal   no-undo .
     1781     define input  parameter p-move-resize   as logical   no-undo .
     1782     define variable v-field-group-handle    as handle    no-undo .
     1783     define variable v-object-handle         as handle    no-undo .
     1784     define variable v-frame-height          as decimal   no-undo .
     1785     define variable v-frame-virtual-height  as decimal   no-undo .
     1786     define variable v-browse-height         as decimal   no-undo .
     1787     define variable v-window-height         as decimal   no-undo .
     1788     define variable v-window-virtual-height as decimal   no-undo .
     1789     define variable v-change-sign           as integer   no-undo .
     1790     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1791     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1792     if p-change-value > 0
     1793     then do:
     1794       if frame Dialog-Frame :height + p-change-value
     1795           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1796       then do:
     1797         assign
     1798           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1799                           - (frame Dialog-Frame :height-chars)
     1800         .
     1801         if p-change-value <= 0
     1802         then do:
     1803           run diasize_position-resize-button in this-procedure .
     1804           return .
     1805         end.
     1806       end.
     1807     end.
     1808     if p-change-value < 0
     1809     then do:
     1810       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1811       then do:
     1812         assign
     1813           p-change-value = v-diasize-orig-frame-height
     1814                          - (frame Dialog-Frame :height-chars)
     1815         .
     1816         if p-change-value >= 0
     1817         then do:
     1818           run diasize_position-resize-button in this-procedure .
     1819           return .
     1820         end.
     1821       end.
     1822     end.
     1823     if p-change-value >= 0
     1824     then do:
     1825       assign
     1826         v-change-sign = 1
     1827       .
     1828     end.
     1829     else do:
     1830       assign
     1831         v-change-sign = -1
     1832       .
     1833     end.
     1834     assign
     1835       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1836     .
     1837     if p-change-value = 0
     1838     then do:
     1839       run diasize_position-resize-button in this-procedure .
     1840       return .
     1841     end.
     1842     move_block:
     1843     do
     1844     on error undo move_block, retry move_block
     1845     :
     1846       if retry
     1847       then do:
     1848         do
     1849         on error undo move_block, leave move_block
     1850         :
     1851           if p-change-value > 0
     1852           then do:
     1853             for each buf_temp-diasize-handle
     1854             on error undo, next
     1855             :
     1856               assign
     1857                 v-object-handle = buf_temp-diasize-handle.handle-value
     1858               .
     1859               if v-object-handle <> v-diasize-resize-button
     1860               then do:
     1861                 assign
     1862                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1863                 .
     1864               end.
     1865             end.
     1866             assign
     1867               v-diasize-browse-handle :height = v-browse-height
     1868             .
     1869             for each buf_temp-browse-handle
     1870               where buf_temp-browse-handle.browse-type = 'height':u
     1871             on error undo, next
     1872             :
     1873               assign
     1874                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1875               .
     1876             end.
     1877             assign
     1878               frame Dialog-Frame :height = v-frame-height
     1879             .
     1880             if frame Dialog-Frame :scrollable = true
     1881             then do:
     1882               assign
     1883                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1884               .
     1885             end.
     1886             run diasize_position-resize-button in this-procedure .
     1887           end.
     1888           else do:
     1889             if frame Dialog-Frame :scrollable = true
     1890             then do:
     1891               assign
     1892                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1893               .
     1894             end.
     1895             assign
     1896               frame Dialog-Frame :height = v-frame-height
     1897             .
     1898             assign
     1899               v-diasize-browse-handle :height = v-browse-height
     1900             .
     1901             for each buf_temp-browse-handle
     1902               where buf_temp-browse-handle.browse-type = 'height':u
     1903             on error undo, next
     1904             :
     1905               assign
     1906                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1907               .
     1908             end.
     1909             for each buf_temp-diasize-handle
     1910             on error undo, next
     1911             :
     1912               assign
     1913                 v-object-handle = buf_temp-diasize-handle.handle-value
     1914               .
     1915               if v-object-handle <> v-diasize-resize-button
     1916               then do:
     1917                 assign
     1918                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1919                 .
     1920               end.
     1921             end.
     1922             run diasize_position-resize-button in this-procedure .
     1923           end.
     1924           assign
     1925             v-diasize-change-size = false
     1926           .
     1927           leave move_block .
     1928         end.
     1929       end.
     1930       assign
     1931         v-diasize-need-full-display = true
     1932       .
     1933       if v-diasize-change-size = false
     1934       then do:
     1935         assign
     1936           v-diasize-change-size = true
     1937         .
     1938       end.
     1939       else do:
     1940         return .
     1941       end.
     1942       assign
     1943         v-frame-height = frame Dialog-Frame :height
     1944         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1945         v-browse-height = v-diasize-browse-handle :height
     1946       .
     1947       for each buf_temp-browse-handle
     1948         where buf_temp-browse-handle.browse-type = 'height':u
     1949       :
     1950         assign
     1951           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1952         .
     1953       end.
     1954       for each buf_temp-diasize-handle
     1955       :
     1956         delete buf_temp-diasize-handle .
     1957       end.
     1958       assign
     1959         v-field-group-handle = frame Dialog-Frame :first-child
     1960       .
     1961       do while valid-handle(v-field-group-handle)
     1962       :
     1963         assign
     1964           v-object-handle = v-field-group-handle :first-child
     1965         .
     1966         do while valid-handle(v-object-handle)
     1967         :
     1968           if  v-object-handle <> v-diasize-browse-handle :handle
     1969           and can-query(v-object-handle, "row")
     1970           and can-query(v-object-handle, "height")
     1971           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1972           then do:
     1973             find first buf_temp-browse-handle
     1974               where buf_temp-browse-handle.browse-type   = 'height':u
     1975                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1976               no-error .
     1977             if available buf_temp-browse-handle
     1978             then do:
     1979             end.
     1980             else do:
     1981               create buf_temp-diasize-handle .
     1982               assign
     1983                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1984                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1985               .
     1986             end.
     1987           end.
     1988           assign
     1989             v-object-handle = v-object-handle :next-sibling
     1990           .
     1991         end.
     1992         assign
     1993           v-field-group-handle = v-field-group-handle :next-sibling
     1994         .
     1995       end.
     1996       do with frame Dialog-Frame
     1997       :
     1998         hide v-diasize-resize-button .
     1999         assign
     2000           v-diasize-resize-button :row    = 1
     2001           v-diasize-resize-button :column = 1
     2002         .
     2003       end.
     2004       if p-change-value > 0
     2005       then do:
     2006         if frame Dialog-Frame :scrollable = true
     2007         then do:
     2008           assign
     2009             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2010             no-error .
     2011           if error-status :error
     2012           or error-status :get-message(1) <> ""
     2013           then do:
     2014             undo move_block, retry move_block .
     2015           end.
     2016         end.
     2017         assign
     2018           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2019           no-error .
     2020         if error-status :error
     2021         or error-status :get-message(1) <> ""
     2022         then do:
     2023           undo move_block, retry move_block .
     2024         end.
     2025         assign
     2026           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2027           no-error .
     2028         if error-status :error
     2029         or error-status :get-message(1) <> ""
     2030         then do:
     2031           undo move_block, retry move_block .
     2032         end.
     2033         for each buf_temp-browse-handle
     2034           where buf_temp-browse-handle.browse-type = 'height':u
     2035         on error undo move_block, retry move_block
     2036         :
     2037           assign
     2038             buf_temp-browse-handle.browse-handle :height
     2039               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2040             no-error .
     2041           if error-status :error
     2042           or error-status :get-message(1) <> ""
     2043           then do:
     2044             undo move_block, retry move_block .
     2045           end.
     2046         end.
     2047         for each buf_temp-diasize-handle
     2048         on error undo move_block, retry move_block
     2049         :
     2050           assign
     2051             v-object-handle = buf_temp-diasize-handle.handle-value
     2052           .
     2053           if v-object-handle <> v-diasize-resize-button
     2054           then do:
     2055             assign
     2056               v-object-handle :row = v-object-handle :row + p-change-value
     2057               no-error .
     2058             if error-status :error
     2059             or error-status :get-message(1) <> ""
     2060             then do:
     2061               undo move_block, retry move_block .
     2062             end.
     2063           end.
     2064         end.
     2065       end.
     2066       else do:
     2067         for each buf_temp-diasize-handle
     2068         on error undo move_block, retry move_block
     2069         :
     2070           assign
     2071             v-object-handle = buf_temp-diasize-handle.handle-value
     2072           .
     2073           if v-object-handle <> v-diasize-resize-button
     2074           then do:
     2075             assign
     2076               v-object-handle :row = v-object-handle :row + p-change-value
     2077               no-error .
     2078             if error-status :error
     2079             or error-status :get-message(1) <> ""
     2080             then do:
     2081               undo move_block, retry move_block .
     2082             end.
     2083           end.
     2084         end.
     2085         assign
     2086           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2087           no-error .
     2088         if error-status :error
     2089         or error-status :get-message(1) <> ""
     2090         then do:
     2091           undo move_block, retry move_block .
     2092         end.
     2093         for each buf_temp-browse-handle
     2094           where buf_temp-browse-handle.browse-type = 'height':u
     2095         on error undo move_block, retry move_block
     2096         :
     2097           assign
     2098             buf_temp-browse-handle.browse-handle :height
     2099               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2100             no-error .
     2101           if error-status :error
     2102           or error-status :get-message(1) <> ""
     2103           then do:
     2104             undo move_block, retry move_block .
     2105           end.
     2106         end.
     2107         assign
     2108           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2109           no-error .
     2110         if error-status :error
     2111         or error-status :get-message(1) <> ""
     2112         then do:
     2113           undo move_block, retry move_block .
     2114         end.
     2115         if frame Dialog-Frame :scrollable = true
     2116         then do:
     2117           assign
     2118             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2119             no-error .
     2120           if error-status :error
     2121           or error-status :get-message(1) <> ""
     2122           then do:
     2123             undo move_block, retry move_block .
     2124           end.
     2125         end.
     2126       end.
     2127       if p-move-resize = true
     2128       then do:
     2129         run diasize_position-resize-button in this-procedure .
     2130       end.
     2131       if v-diasize-wndstore = true
     2132       then do:
     2133         if connected("ub") = true
     2134         then do:
     2135           define variable v-cntxt-db-num        as integer   no-undo .
     2136           define variable v-cntxt-userid        as character no-undo .
     2137           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2138                                             , OUTPUT v-cntxt-userid
     2139                                             ) .
     2140           run gbl/wndsizew.p
     2141             (input  v-cntxt-db-num
     2142             ,input  v-cntxt-userid
     2143             ,input  v-diasize-proc-name
     2144             ,input  'height':u
     2145             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2146             ) .
     2147         end.
     2148       end.
     2149     end.
     2150     assign
     2151       v-diasize-change-size = false
     2152     .
     2153   end procedure.
     2154   procedure diasize_set-height :
     2155     define input  parameter p-new-height  as decimal   no-undo .
     2156     define input  parameter p-move-resize as logical   no-undo .
     2157     do
     2158     on error undo, return error return-value
     2159     :
     2160       run diasize_change-height in this-procedure
     2161         (input  (p-new-height - frame Dialog-Frame :height)
     2162         ,input  p-move-resize
     2163         ) .
     2164     end.
     2165   end procedure.
     2166   procedure diasize_change-width :
     2167     define input  parameter p-change-value as decimal   no-undo .
     2168     define input  parameter p-move-resize  as logical   no-undo .
     2169     define variable v-field-group-handle   as handle    no-undo .
     2170     define variable v-object-handle        as handle    no-undo .
     2171     define variable v-frame-width          as decimal   no-undo .
     2172     define variable v-frame-virtual-width  as decimal   no-undo .
     2173     define variable v-browse-width         as decimal   no-undo .
     2174     define variable v-window-width         as decimal   no-undo .
     2175     define variable v-window-virtual-width as decimal   no-undo .
     2176     define variable v-change-sign          as integer   no-undo .
     2177     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2178     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2179     if p-change-value > 0
     2180     then do:
     2181       if frame Dialog-Frame :width + p-change-value >
     2182           session :width-chars
     2183       then do:
     2184         assign
     2185           p-change-value = session :width-chars - frame Dialog-Frame :width
     2186         .
     2187         if p-change-value <= 0
     2188         then do:
     2189           run diasize_position-resize-button in this-procedure .
     2190           return .
     2191         end.
     2192       end.
     2193     end.
     2194     if p-change-value < 0
     2195     then do:
     2196       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2197       then do:
     2198         assign
     2199           p-change-value = v-diasize-orig-frame-width
     2200                          - frame Dialog-Frame :width
     2201         .
     2202         if p-change-value >= 0
     2203         then do:
     2204           run diasize_position-resize-button in this-procedure .
     2205           return .
     2206         end.
     2207       end.
     2208     end.
     2209     if p-change-value >= 0
     2210     then do:
     2211       assign
     2212         v-change-sign = 1
     2213       .
     2214     end.
     2215     else do:
     2216       assign
     2217         v-change-sign = -1
     2218       .
     2219     end.
     2220     assign
     2221       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2222     .
     2223     if p-change-value = 0
     2224     then do:
     2225       run diasize_position-resize-button in this-procedure .
     2226       return .
     2227     end.
     2228     move_block:
     2229     do
     2230     on error undo move_block, leave move_block
     2231     :
     2232       if retry
     2233       then do:
     2234         do
     2235         on error undo move_block, leave move_block
     2236         :
     2237           if p-change-value > 0
     2238           then do:
     2239             for each buf_temp-diasize-handle
     2240             on error undo, next
     2241             :
     2242               assign
     2243                 v-object-handle = buf_temp-diasize-handle.handle-value
     2244               .
     2245               if v-object-handle <> v-diasize-resize-button
     2246               then do:
     2247                 assign
     2248                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2249                 .
     2250               end.
     2251             end.
     2252             assign
     2253               v-diasize-browse-handle :width = v-browse-width
     2254             .
     2255             for each buf_temp-browse-handle
     2256               where buf_temp-browse-handle.browse-type = 'width':u
     2257             on error undo, next
     2258             :
     2259               assign
     2260                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2261               .
     2262             end.
     2263             assign
     2264               frame Dialog-Frame :width = v-frame-width
     2265             .
     2266             if frame Dialog-Frame :scrollable = true
     2267             then do:
     2268               assign
     2269                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2270               .
     2271             end.
     2272             run diasize_position-resize-button in this-procedure .
     2273           end.
     2274           else do:
     2275             if frame Dialog-Frame :scrollable = true
     2276             then do:
     2277               assign
     2278                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2279               .
     2280             end.
     2281             assign
     2282               frame Dialog-Frame :width = v-frame-width
     2283             .
     2284             for each buf_temp-browse-handle
     2285               where buf_temp-browse-handle.browse-type = 'width':u
     2286             on error undo, next
     2287             :
     2288               assign
     2289                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2290               .
     2291             end.
     2292             assign
     2293               v-diasize-browse-handle :width = v-browse-width
     2294             .
     2295             for each buf_temp-diasize-handle
     2296             on error undo, next
     2297             :
     2298               assign
     2299                 v-object-handle = buf_temp-diasize-handle.handle-value
     2300               .
     2301               if v-object-handle <> v-diasize-resize-button
     2302               then do:
     2303                 assign
     2304                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2305                 .
     2306               end.
     2307             end.
     2308             run diasize_position-resize-button in this-procedure .
     2309           end.
     2310           assign
     2311             v-diasize-change-size = false
     2312           .
     2313           leave move_block .
     2314         end.
     2315       end.
     2316       assign
     2317         v-diasize-need-full-display = true
     2318       .
     2319       if v-diasize-change-size = false
     2320       then do:
     2321         assign
     2322           v-diasize-change-size = true
     2323         .
     2324       end.
     2325       else do:
     2326         return .
     2327       end.
     2328       assign
     2329         v-frame-width = frame Dialog-Frame :width
     2330         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2331         v-browse-width = v-diasize-browse-handle :width
     2332       .
     2333       for each buf_temp-browse-handle
     2334         where buf_temp-browse-handle.browse-type = 'width':u
     2335       :
     2336         assign
     2337           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2338         .
     2339       end.
     2340       for each buf_temp-diasize-handle
     2341       :
     2342         delete buf_temp-diasize-handle .
     2343       end.
     2344       assign
     2345         v-field-group-handle = frame Dialog-Frame :first-child
     2346       .
     2347       do while valid-handle(v-field-group-handle)
     2348       :
     2349         assign
     2350           v-object-handle = v-field-group-handle :first-child
     2351         .
     2352         do while valid-handle(v-object-handle)
     2353         :
     2354           if  v-object-handle <> v-diasize-browse-handle :handle
     2355           and v-object-handle <> v-diasize-resize-button
     2356           and can-query(v-object-handle, "row")
     2357           and can-query(v-object-handle, "height")
     2358           and ( v-object-handle :col + v-object-handle :width
     2359                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2360               )
     2361           then do:
     2362             find first buf_temp-browse-handle
     2363               where buf_temp-browse-handle.browse-type   = 'width':u
     2364                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2365               no-error .
     2366             if available buf_temp-browse-handle
     2367             then do:
     2368             end.
     2369             else do:
     2370               create buf_temp-diasize-handle .
     2371               assign
     2372                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2373                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2374               .
     2375             end.
     2376           end.
     2377           assign
     2378             v-object-handle = v-object-handle :next-sibling
     2379           .
     2380         end.
     2381         assign
     2382           v-field-group-handle = v-field-group-handle :next-sibling
     2383         .
     2384       end.
     2385       do with frame Dialog-Frame
     2386       :
     2387         hide v-diasize-resize-button .
     2388         v-diasize-resize-button :row = 1.
     2389         v-diasize-resize-button :column = 1.
     2390       end.
     2391       if p-change-value > 0
     2392       then do:
     2393         if frame Dialog-Frame :scrollable = true
     2394         then do:
     2395           assign
     2396             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2397             no-error .
     2398           if error-status :error
     2399           or error-status :get-message(1) <> ""
     2400           then do:
     2401             undo move_block, retry move_block.
     2402           end.
     2403         end.
     2404         assign
     2405           frame Dialog-Frame :width = v-frame-width + p-change-value
     2406           no-error .
     2407         if error-status :error
     2408         or error-status :get-message(1) <> ""
     2409         then do:
     2410           undo move_block, retry move_block.
     2411         end.
     2412         assign
     2413           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2414         no-error .
     2415         if error-status :error
     2416         or error-status :get-message(1) <> ""
     2417         then do:
     2418           undo move_block, retry move_block.
     2419         end.
     2420         for each buf_temp-browse-handle
     2421           where buf_temp-browse-handle.browse-type = 'width':u
     2422         on error undo move_block, retry move_block
     2423         :
     2424           assign
     2425             buf_temp-browse-handle.browse-handle :width
     2426               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2427             no-error .
     2428           if error-status :error
     2429           or error-status :get-message(1) <> ""
     2430           then do:
     2431             undo move_block, retry move_block .
     2432           end.
     2433         end.
     2434         for each buf_temp-diasize-handle
     2435         on error undo move_block, retry move_block
     2436         :
     2437           assign
     2438             v-object-handle = buf_temp-diasize-handle.handle-value
     2439           .
     2440           if v-object-handle <> v-diasize-resize-button
     2441           then do:
     2442             assign
     2443               v-object-handle :col = v-object-handle :col + p-change-value
     2444               no-error .
     2445             if error-status :error
     2446             or error-status :get-message(1) <> ""
     2447             then do:
     2448               undo move_block, retry move_block .
     2449             end.
     2450           end.
     2451         end.
     2452       end.
     2453       else do:
     2454         for each buf_temp-diasize-handle
     2455         on error undo move_block, retry move_block
     2456         :
     2457           assign
     2458             v-object-handle = buf_temp-diasize-handle.handle-value
     2459           .
     2460           if v-object-handle <> v-diasize-resize-button
     2461           then do:
     2462             assign
     2463               v-object-handle :col = v-object-handle :col + p-change-value
     2464               no-error .
     2465             if error-status :error
     2466             or error-status :get-message(1) <> ""
     2467             then do:
     2468               undo move_block, retry move_block .
     2469             end.
     2470           end.
     2471         end.
     2472         for each buf_temp-browse-handle
     2473           where buf_temp-browse-handle.browse-type = 'width':u
     2474         on error undo move_block, retry move_block
     2475         :
     2476           assign
     2477             buf_temp-browse-handle.browse-handle :width
     2478               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2479             no-error .
     2480           if error-status :error
     2481           or error-status :get-message(1) <> ""
     2482           then do:
     2483             undo move_block, retry move_block .
     2484           end.
     2485         end.
     2486         assign
     2487           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2488           no-error .
     2489         if error-status :error
     2490         or error-status :get-message(1) <> ""
     2491         then do:
     2492           undo move_block, retry move_block.
     2493         end.
     2494         assign
     2495           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2496         no-error .
     2497         if error-status :error
     2498         or error-status :get-message(1) <> ""
     2499         then do:
     2500           undo move_block, retry move_block.
     2501         end.
     2502         if frame Dialog-Frame :scrollable = true
     2503         then do:
     2504           assign
     2505             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2506           no-error .
     2507           if error-status :error
     2508           or error-status :get-message(1) <> ""
     2509           then do:
     2510             undo move_block, retry move_block.
     2511           end.
     2512         end.
     2513       end.
     2514       if p-move-resize
     2515       then do:
     2516         run diasize_position-resize-button in this-procedure .
     2517       end.
     2518       if v-diasize-wndstore = true
     2519       then do:
     2520         if connected("ub") = true
     2521         then do:
     2522           define variable v-cntxt-db-num        as integer   no-undo .
     2523           define variable v-cntxt-userid        as character no-undo .
     2524           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2525                                             , OUTPUT v-cntxt-userid
     2526                                             ) .
     2527           run gbl/wndsizew.p
     2528             (input  v-cntxt-db-num
     2529             ,input  v-cntxt-userid
     2530             ,input  v-diasize-proc-name
     2531             ,input  'width':u
     2532             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2533             ) .
     2534         end.
     2535       end.
     2536     end.
     2537     assign
     2538       v-diasize-change-size = false
     2539     .
     2540   end procedure.
     2541   procedure diasize_set-width :
     2542     define input  parameter p-new-width  as decimal   no-undo .
     2543     define input  parameter p-move-resize as logical   no-undo .
     2544     do
     2545     on error undo, return error return-value
     2546     :
     2547       run diasize_change-width in this-procedure
     2548         (input  (p-new-width - frame Dialog-Frame :width)
     2549         ,input  p-move-resize
     2550         ) .
     2551     end.
     2552   end procedure.
     2553   procedure diasize_position-resize-button :
     2554     do with frame Dialog-Frame
     2555     :
     2556       hide v-diasize-resize-button .
     2557       assign
     2558         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2559                     - 1
     2560                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2561         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2562                     - 1
     2563                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2564       .
     2565       view v-diasize-resize-button .
     2566     end.
     2567   end procedure.
     2568   on alt-right anywhere
     2569   do:
     2570     run diasize_change-width in this-procedure
     2571       (input 1
     2572       ,input true
     2573       ) .
     2574     return no-apply .
     2575   end.
     2576   on alt-left anywhere
     2577   do:
     2578     run diasize_change-width in this-procedure
     2579       (input -1
     2580       ,input true
     2581       ) .
     2582     return no-apply .
     2583   end.
     2584   on alt-down anywhere
     2585   do:
     2586     run diasize_change-height in this-procedure
     2587       (input 1
     2588       ,input true
     2589       ) .
     2590     return no-apply .
     2591   end.
     2592   on alt-up anywhere
     2593   do:
     2594     run diasize_change-height in this-procedure
     2595       (input -1
     2596       ,input true
     2597       ) .
     2598     return no-apply .
     2599   end.
     2600   on alt-enter of frame Dialog-Frame
     2601   do:
     2602     run diasize_maximize in this-procedure
     2603       (input  ?
     2604       ).
     2605     return no-apply .
     2606   end.
     2607   procedure diasize_end-move :
     2608     do
     2609     on error undo, return error return-value
     2610     :
     2611       define variable v-row-delta as decimal   no-undo .
     2612       define variable v-col-delta as decimal   no-undo .
     2613       define variable v-new-row as decimal   no-undo .
     2614       define variable v-new-col as decimal   no-undo .
     2615       assign
     2616         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2617         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2618       .
     2619       assign
     2620         v-row-delta = v-new-row - frame Dialog-Frame :height
     2621         v-col-delta = v-new-col - frame Dialog-Frame :width
     2622       .
     2623       run diasize_change-height in this-procedure
     2624         (input v-row-delta
     2625         ,input true
     2626         ) .
     2627       run diasize_change-width in this-procedure
     2628         (input v-col-delta
     2629         ,input true
     2630         ) .
     2631     end.
     2632   end procedure.
     2633   procedure diasize_maximize :
     2634     define input  parameter p-action as logical   no-undo .
     2635     do
     2636     on error undo, return error return-value
     2637     :
     2638       if p-action = ?
     2639       then do:
     2640         if v-diasize-need-maximize = true
     2641         then do:
     2642           assign
     2643             p-action = true
     2644           .
     2645         end.
     2646         else do:
     2647           assign
     2648             p-action = false
     2649           .
     2650         end.
     2651       end.
     2652       if p-action = true
     2653       then do:
     2654         run diasize_change-height in this-procedure
     2655           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2656               - frame Dialog-Frame :height-chars
     2657           ,input true
     2658           ) .
     2659         run diasize_change-width in this-procedure
     2660           (input session :width-chars
     2661               - frame Dialog-Frame :width-chars
     2662           ,input true
     2663           ) .
     2664         assign
     2665           v-diasize-need-maximize = false
     2666         .
     2667       end.
     2668       else do:
     2669         run diasize_change-width in this-procedure
     2670           (input v-diasize-orig-frame-width
     2671               - frame Dialog-Frame :width-chars
     2672           ,input true
     2673           ) .
     2674         run diasize_change-height in this-procedure
     2675           (input v-diasize-orig-frame-height
     2676               - frame Dialog-Frame :height-chars
     2677           ,input true
     2678           ) .
     2679         assign
     2680           v-diasize-need-maximize = true
     2681         .
     2682       end.
     2683     end.
     2684   end procedure.
     2685   procedure diasize_restore-orig-size :
     2686     do
     2687     on error undo, return error return-value
     2688     :
     2689       assign
     2690         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2691         v-diasize-current-frame-height = frame Dialog-Frame :height
     2692       .
     2693       run diasize_set-height in this-procedure
     2694         (input  v-diasize-orig-frame-height
     2695         ,input  true
     2696         ) .
     2697       run diasize_set-width in this-procedure
     2698         (input  v-diasize-orig-frame-width
     2699         ,input  true
     2700         ) .
     2701     end.
     2702   end procedure.
     2703   procedure diasize_restore-current-size :
     2704     do
     2705     on error undo, return error return-value
     2706     :
     2707       run diasize_set-height in this-procedure
     2708         (input  v-diasize-current-frame-height
     2709         ,input  true
     2710         ) .
     2711       run diasize_set-width in this-procedure
     2712         (input  v-diasize-current-frame-width
     2713         ,input  true
     2714         ) .
     2715     end.
     2716   end procedure.
     2717   procedure diasize_set-browse-handle :
     2718     define input  parameter p-browse-handle as handle   no-undo .
     2719     define buffer buf_temp-browse-handle for temp-browse-handle .
     2720     do
     2721     on error undo, return error return-value
     2722     :
     2723       assign
     2724         v-diasize-browse-handle = p-browse-handle
     2725       .
     2726       for each buf_temp-browse-handle
     2727       on error undo, return error return-value
     2728       :
     2729         delete buf_temp-browse-handle .
     2730       end.
     2731     end.
     2732   end procedure.
     2733   procedure diasize_add_browse :
     2734     define input  parameter p-browse-type   as character no-undo .
     2735     define input  parameter p-browse-handle as handle    no-undo .
     2736     define buffer buf_temp-browse-handle for temp-browse-handle .
     2737     do
     2738     on error undo, return error return-value
     2739     :
     2740       assign
     2741         v-diasize-browse-number = v-diasize-browse-number + 1
     2742       .
     2743       create buf_temp-browse-handle .
     2744       assign
     2745         buf_temp-browse-handle.browse-type   = p-browse-type
     2746         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2747         buf_temp-browse-handle.browse-handle = p-browse-handle
     2748       .
     2749     end.
     2750   end procedure.
     2751   procedure diasize_init :
     2752     define variable v-default-value    as logical   no-undo .
     2753     define variable v-restore-saved    as logical   no-undo .
     2754     define variable v-resize-value-str as character no-undo .
     2755     do
     2756     on error undo, return error return-value
     2757     :
     2758       do with frame Dialog-Frame
     2759       :
     2760         assign
     2761           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2762           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2763           v-diasize-browse-handle     = browse br-c-cli-grp :handle
     2764         .
     2765         create button v-diasize-resize-button
     2766         assign
     2767           parent        = frame Dialog-Frame :first-child
     2768           label         = "s"
     2769           height-pixels = 16
     2770           width-pixels  = 16
     2771           visible       = true
     2772           sensitive     = true
     2773           movable       = true
     2774           triggers:
     2775             on end-move persistent run diasize_end-move in this-procedure .
     2776           end triggers.
     2777         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2778         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2779         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2780         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2781         assign
     2782           v-diasize-wndmax = false
     2783         .
     2784         if connected("ub") = true
     2785         then do:
     2786           define variable v-cntxt-db-num        as integer   no-undo .
     2787           define variable v-cntxt-userid        as character no-undo .
     2788           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2789                                             , OUTPUT v-cntxt-userid
     2790                                             ) .
     2791           run gbl/wndpar_r.p
     2792             (input  v-cntxt-db-num
     2793             ,input  v-cntxt-userid
     2794             ,input  'wndmax':U
     2795             ,output v-diasize-wndmax
     2796             ,output v-default-value
     2797             ) .
     2798         end.
     2799         assign
     2800           v-diasize-wndstore = false
     2801         .
     2802         if connected("ub") = true
     2803         then do:
     2804           run gbl/wndpar_r.p
     2805             (input  v-cntxt-db-num
     2806             ,input  v-cntxt-userid
     2807             ,input  'wndstore':U
     2808             ,output v-diasize-wndstore
     2809             ,output v-default-value
     2810             ) .
     2811         end.
     2812         assign
     2813           v-diasize-proc-name = entry(1, program-name(2), '.')
     2814         .
     2815         if v-diasize-wndstore = true
     2816         then do:
     2817           assign
     2818             v-restore-saved = false
     2819           .
     2820           if connected("ub") = true
     2821           then do:
     2822             run gbl/wndsizer.p
     2823               (input  v-cntxt-db-num
     2824               ,input  v-cntxt-userid
     2825               ,input  v-diasize-proc-name
     2826               ,input  'height':u
     2827               ,output v-resize-value-str
     2828               ) .
     2829             if v-resize-value-str <> '':U
     2830             then do:
     2831               run diasize_change-height in this-procedure
     2832                 (input  integer(v-resize-value-str)
     2833                 ,input  true
     2834                 ) .
     2835               assign
     2836                 v-restore-saved = true
     2837               .
     2838             end.
     2839           end.
     2840           if connected("ub") = true
     2841           then do:
     2842             run gbl/wndsizer.p
     2843               (input  v-cntxt-db-num
     2844               ,input  v-cntxt-userid
     2845               ,input  v-diasize-proc-name
     2846               ,input  'width':u
     2847               ,output v-resize-value-str
     2848               ) .
     2849             if v-resize-value-str <> '':U
     2850             then do:
     2851               run diasize_change-width in this-procedure
     2852                 (input  integer(v-resize-value-str)
     2853                 ,input  true
     2854                 ) .
     2855               assign
     2856                 v-restore-saved = true
     2857               .
     2858             end.
     2859           end.
     2860           if v-restore-saved <> true
     2861           then do:
     2862             if v-diasize-wndmax = true
     2863             then do:
     2864               run diasize_maximize in this-procedure
     2865                 (input  true
     2866                 ) .
     2867             end.
     2868           end.
     2869         end.
     2870         else do:
     2871           if v-diasize-wndmax = true
     2872           then do:
     2873             run diasize_maximize in this-procedure
     2874               (input  true
     2875               ) .
     2876           end.
     2877         end.
     2878       end.
     2879     end.
     2880   end procedure.
     2881   procedure diasize_need-full-display :
     2882     define output parameter p-need-full-display as logical   no-undo .
     2883     do
     2884     on error undo, return error return-value
     2885     :
     2886       assign
     2887         p-need-full-display = v-diasize-need-full-display
     2888       .
     2889       assign
     2890         v-diasize-need-full-display = false
     2891       .
     2892     end.
     2893   end procedure.
     2894   procedure get-context :
     2895      define output parameter p-db-num as integer          no-undo.
     2896      define output parameter p-user-id as character        no-undo.
     2897      define variable v-login               as character    no-undo.
     2898      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2899      define buffer buf_user-login  for ub.user-login .
     2900      do
     2901      on error undo, return error
     2902      :
     2903            FIND FIRST buf_sys-ctrl no-lock.
     2904            ASSIGN
     2905               v-login = USERID("ub")
     2906               p-db-num = buf_sys-ctrl.db-num
     2907            .
     2908            FIND FIRST buf_user-login
     2909                 WHERE buf_user-login.db-num = p-db-num
     2910                   AND buf_user-login.user-login = v-login
     2911                 no-lock
     2912                 no-error
     2913                 .
     2914            IF AVAILABLE buf_user-login
     2915            THEN DO:
     2916               assign
     2917                  p-user-id = buf_user-login.user-id
     2918               .
     2919            END.
     2920      end.
     2921   end procedure.
     2922   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2923   on f5 of frame Dialog-Frame anywhere
     2924   do:
     2925     v-doc-rec = recid(X_c-cli-grp). run openbr in this-procedure. reposition br-c-cli-grp to recid v-doc-rec no-error.
     2926       apply "VALUE-CHANGED" to BR-c-cli-grp.
     2927   end.
     2928   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2929   do:
     2930     BR-c-cli-grp :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2931   end.
     2932   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2933   procedure set-filter-name :
     2934   define input parameter p-filter-name as character no-undo .
     2935     do with frame Dialog-Frame:
     2936       if p-filter-name > "" then do:
     2937         assign
     2938           frame Dialog-Frame:title
     2939             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2940         .
     2941         assign
     2942           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2943         .
     2944       end.
     2945       else do:
     2946         assign
     2947           b-sch :tooltip = ""
     2948         .
     2949       end.
     2950     end.
     2951   end procedure.
     2952   def var sort-labelbr-c-cli-grp   as character no-undo .
     2953   def var sort-clmnbr-c-cli-grp    as handle    no-undo .
     2954   def var cur-clmnbr-c-cli-grp     as handle    no-undo .
     2955   def var cur-clmn-locbr-c-cli-grp as integer   no-undo .
     2956   def var re-querybr-c-cli-grp     as logical   initial no no-undo .
     2957   on start-search, ctrl-o of br-c-cli-grp in frame Dialog-Frame do:
     2958      run sort-brbr-c-cli-grp
     2959        (input (if available X_c-cli-grp
     2960                then recid(X_c-cli-grp)
     2961                else ?
     2962               )
     2963        ).
     2964   end.
     2965   PROCEDURE sort-brbr-c-cli-grp :
     2966     define input parameter p-recid as recid no-undo .
     2967     if re-querybr-c-cli-grp = no then do:
     2968       assign
     2969          cur-clmnbr-c-cli-grp = br-c-cli-grp:current-column in frame Dialog-Frame
     2970       .
     2971       if sort-clmnbr-c-cli-grp <> ? then sort-clmnbr-c-cli-grp:column-fgcolor = 0.
     2972       if cur-clmnbr-c-cli-grp = sort-clmnbr-c-cli-grp then do:
     2973         assign
     2974            sort-labelbr-c-cli-grp = ""
     2975            sort-clmnbr-c-cli-grp = ?
     2976         .
     2977        end.
     2978        else do:
     2979          assign
     2980            sort-labelbr-c-cli-grp = cur-clmnbr-c-cli-grp:label
     2981            sort-clmnbr-c-cli-grp  = cur-clmnbr-c-cli-grp
     2982            sort-clmnbr-c-cli-grp:column-fgcolor = 4
     2983          .
     2984        end.
     2985      end.
     2986     assign
     2987       cur-clmn-locbr-c-cli-grp = 1
     2988     .
     2989     def var column-handle as handle no-undo .
     2990     column-handle = br-c-cli-grp:first-column.
     2991     do while valid-handle(column-handle) :
     2992       if column-handle = cur-clmnbr-c-cli-grp then do:
     2993         leave .
     2994       end.
     2995       column-handle = column-handle:NEXT-COLUMN.
     2996       assign
     2997         cur-clmn-locbr-c-cli-grp = cur-clmn-locbr-c-cli-grp + 1
     2998       .
     2999     end.
     3000     case sort-labelbr-c-cli-grp:
     3001           when X_c-cli-grp.corr-date:label in browse br-c-cli-grp then DO:    assign       sort-column-name = "X_c-cli-grp.corr-date"     .     run OpenBr in this-procedure.   . END.
     3002           when X_c-cli-grp.corr-user-db-num:label in browse br-c-cli-grp then DO:    assign       sort-column-name = "X_c-cli-grp.corr-user-db-num"     .     run OpenBr in this-procedure.   . END.
     3003       otherwise do:
     3004         assign
     3005           sort-column-name = ""
     3006         .
     3007         run OpenBr in this-procedure.
     3008         if sort-labelbr-c-cli-grp <> "" then do:
     3009           assign
     3010             cur-clmnbr-c-cli-grp:column-fgcolor = 0
     3011           .
     3012         end.
     3013         assign
     3014           cur-clmn-locbr-c-cli-grp = ?
     3015         .
     3016       end.
     3017     end case.
     3018     if p-recid <> ? then do:
     3019       reposition br-c-cli-grp to recid p-recid no-error.
     3020       apply "value-changed" to br-c-cli-grp in frame Dialog-Frame.
     3021     end.
     3022     apply "entry" to br-c-cli-grp in frame Dialog-Frame.
     3023   END PROCEDURE.
     3024   procedure re-open-query-srt-clmnbr-c-cli-grp:
     3025   if cur-clmnbr-c-cli-grp = ? then do:
     3026      run OpenBr in this-procedure.
     3027   end.
     3028   else do:
     3029      assign re-querybr-c-cli-grp = yes.
     3030      run sort-brbr-c-cli-grp
     3031        (input (if available X_c-cli-grp
     3032                then recid(X_c-cli-grp)
     3033                else ?
     3034               )
     3035        ).
     3036      assign re-querybr-c-cli-grp = no.
     3037   end.
     3038   end.
     3039   MAIN-BLOCK:
     3040   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3041      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3042      if LOOKUP(p-mode, ("cli-grp":U  + chr(4) +
     3043                        'все':U),
     3044                        chr(4)
     3045                        ) > 0
     3046      THEN DO:
     3047        find first X_cli-grp no-lock where
     3048                   X_cli-grp.node-code = p-node-code
     3049               no-error .
     3050        if not available X_cli-grp
     3051        and not p-is-del
     3052        then do:
     3053           message
     3054           vss-workfile vss-revision vss-description skip
     3055           "Неверное значение параметра p-node-code и/или p-is-del" p-node-code p-is-del
     3056           view-as alert-box ERROR.
     3057           return.
     3058        end.
     3059     END.
     3060     else do:
     3061         message vss-workfile vss-revision vss-description skip
     3062         "Неверный вызов - p-mode=" p-mode
     3063         view-as alert-box ERROR.
     3064         return.
     3065     end.
     3066     RUN MyEnable.
     3067     HIDE mark-num in frame Dialog-Frame .
     3068     run OpenBR in this-procedure.
     3069     run diasize_add_browse in this-procedure
     3070       (input  'width':u
     3071       ,input  browse br-changes :handle
     3072       ) .
     3073     run diasize_add_browse in this-procedure
     3074       (input  'width':u
     3075       ,input  v-full-name-old:handle
     3076       ) .
     3077     run diasize_add_browse in this-procedure
     3078       (input  'width':u
     3079       ,input  v-full-name-new:handle
     3080       ) .
     3081     run diasize_init in this-procedure .
     3082     WAIT-FOR GO OF FRAME Dialog-Frame.
     3083   END.
     3084   RUN disable_UI.
     3085   PROCEDURE disable_UI :
     3086     HIDE FRAME Dialog-Frame.
     3087   END PROCEDURE.
     3088   PROCEDURE enable_UI :
     3089     DISPLAY mark-num v-full-name-old v-full-name-new
     3090         WITH FRAME Dialog-Frame.
     3091     ENABLE b-quit B-mark b-sel B-sch B-Help mark-num BR-c-cli-grp BR-changes
     3092            v-full-name-old v-full-name-new
     3093         WITH FRAME Dialog-Frame.
     3094     VIEW FRAME Dialog-Frame.
     3095     OPEN QUERY BR-c-cli-grp FOR EACH X_c-cli-grp NO-LOCK.
     3096   END PROCEDURE.
     3097   PROCEDURE MyEnable :
     3098   br-changes:title in frame Dialog-Frame  = "":U.
     3099   assign
     3100   temp-changes.l_name:resizable in browse br-changes = true
     3101   temp-changes.v_old:resizable in browse br-changes = true
     3102   temp-changes.v_new:resizable in browse br-changes = true
     3103   temp-changes.l_name:width in browse br-changes = 30
     3104   temp-changes.v_old:width in browse br-changes = 40
     3105   temp-changes.v_new:width in browse br-changes = 40
     3106   .
     3107   DISPLAY
     3108   mark-num
     3109   br-changes
     3110   WITH FRAME Dialog-Frame.
     3111   ENABLE
     3112   B-quit
     3113   B-mark when lookup('b-mark':U, bttns) >0
     3114   B-sel when lookup('b-sel':U, bttns) >0
     3115   B-sch
     3116   B-Help
     3117   BR-c-cli-grp
     3118   br-changes
     3119   mark-num
     3120   WITH FRAME Dialog-Frame.
     3121   VIEW FRAME Dialog-Frame.
     3122   END PROCEDURE.
     3123   PROCEDURE OpenBr :
     3124   define variable l-query-was-opened as logical no-undo .
     3125   run waitfram-show in this-procedure ("Ждите...").
     3126   define variable sort-column-phrase as character no-undo .
     3127   case sort-column-name :
     3128     when "" then do:
     3129       assign
     3130         sort-column-phrase = ""
     3131       .
     3132     end.
     3133     otherwise do:
     3134       assign
     3135         sort-column-phrase = "by " + sort-column-name
     3136       .
     3137     end.
     3138   end case.
     3139   CASE p-mode:
     3140     when 'все':U then do:
     3141       ASSIGN frame Dialog-Frame:TITLE = "Справочник истории групп клиентов"
     3142       filter-point = filter-point0 + p-mode.
     3143   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3144   define variable  l-disable-where-22  as logical   no-undo .
     3145   define variable  l-filter-open-22    as logical   .
     3146   define variable  flt-rec-22       as recid     no-undo .
     3147   define variable  filter-name-22      as character no-undo .
     3148   define variable  where-phrase-22     as character no-undo .
     3149   define variable  sort-phrase-22      as character no-undo .
     3150   define variable  where-phrase-rus-22 as character no-undo .
     3151   define variable  sort-phrase-rus-22  as character no-undo .
     3152     run waitfram-show in this-procedure
     3153       (input "ЖДИТЕ ..."
     3154       ).
     3155   run gbl/flt-get.p
     3156     (input filter-point
     3157     ,output flt-rec-22
     3158     ,output filter-name-22
     3159     ,output where-phrase-22
     3160     ,output sort-phrase-22
     3161     ,output where-phrase-rus-22
     3162     ,output sort-phrase-rus-22
     3163     ).
     3164       run set-filter-name in this-procedure
     3165         (INPUT filter-name-22
     3166         ) no-error .
     3167     assign
     3168       l-filter-open-22 = false
     3169     .
     3170     if flt-rec-22 <> ?
     3171       or sort-column-phrase > ""
     3172     then do:
     3173       define variable  parameter-2-22 as character no-undo .
     3174       define variable  parameter-3-22 as character no-undo .
     3175       define variable  parameter-4-22 as character no-undo .
     3176       define variable  parameter-5-22 as character no-undo .
     3177       define variable  parameter-6-22 as character no-undo .
     3178       define variable  parameter-7-22 as character no-undo .
     3179         assign
     3180         parameter-3-22 =
     3181                                 "FOR EACH X_c-cli-grp"
     3182         parameter-4-22 =
     3183           (
     3184             if (" TRUE " + " " + where-phrase-22) <> ""
     3185             then " TRUE " + " " + where-phrase-22
     3186             else "true"
     3187           )
     3188         parameter-5-22 = (" " + "" + " " + "")
     3189         parameter-6-22 = if sort-phrase-22 = ''
     3190                              then
     3191           (
     3192           " " + "  " +
     3193             " " + sort-column-phrase +
     3194           " " + "  "
     3195           )
     3196                              else
     3197           (
     3198           " " + "  " +
     3199             " " + sort-column-phrase +
     3200           " " + sort-phrase-22
     3201           )
     3202         parameter-7-22 =
     3203           "   "
     3204       .
     3205       do
     3206       on stop undo, leave
     3207       on error undo, leave
     3208       :
     3209         assign
     3210           l-disable-where-22 =
     3211             (" TRUE " + " " + where-phrase-22 = "")
     3212         .
     3213         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3214                             ,input query br-c-cli-grp:handle
     3215                             ,input parameter-3-22
     3216                             ,input parameter-4-22
     3217                             ,input parameter-5-22
     3218                             ,input parameter-6-22
     3219                             ,input parameter-7-22
     3220                             )
     3221         .
     3222         assign
     3223           l-filter-open-22 = true
     3224         .
     3225       end.
     3226       if l-filter-open-22 = false then do:
     3227         message
     3228           "Ошибка при фильтрации / сортировке" skip
     3229           "Будут показаны записи без учета фильтра" skip
     3230           view-as alert-box .
     3231       end.
     3232       else do:
     3233           assign
     3234             l-query-was-opened = true
     3235           .
     3236       end.
     3237     end.
     3238     if l-filter-open-22 = false then do:
     3239       OPEN QUERY br-c-cli-grp FOR EACH X_c-cli-grp
     3240         where  TRUE
     3241     .
     3242         assign
     3243           l-query-was-opened = true
     3244         .
     3245     end.
     3246     run waitfram-hide in this-procedure .
     3247     end.
     3248     when "cli-grp":U then do:
     3249       ASSIGN frame Dialog-Frame:TITLE = substitute("Справочник истории групп клиентов: вн № группы &1",
     3250                                                       p-node-code)
     3251       filter-point = filter-point0 + p-mode.
     3252   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3253   define variable  l-disable-where-24  as logical   no-undo .
     3254   define variable  l-filter-open-24    as logical   .
     3255   define variable  flt-rec-24       as recid     no-undo .
     3256   define variable  filter-name-24      as character no-undo .
     3257   define variable  where-phrase-24     as character no-undo .
     3258   define variable  sort-phrase-24      as character no-undo .
     3259   define variable  where-phrase-rus-24 as character no-undo .
     3260   define variable  sort-phrase-rus-24  as character no-undo .
     3261     run waitfram-show in this-procedure
     3262       (input "ЖДИТЕ ..."
     3263       ).
     3264   run gbl/flt-get.p
     3265     (input filter-point
     3266     ,output flt-rec-24
     3267     ,output filter-name-24
     3268     ,output where-phrase-24
     3269     ,output sort-phrase-24
     3270     ,output where-phrase-rus-24
     3271     ,output sort-phrase-rus-24
     3272     ).
     3273       run set-filter-name in this-procedure
     3274         (INPUT filter-name-24
     3275         ) no-error .
     3276     assign
     3277       l-filter-open-24 = false
     3278     .
     3279     if flt-rec-24 <> ?
     3280       or sort-column-phrase > ""
     3281     then do:
     3282       define variable  parameter-2-24 as character no-undo .
     3283       define variable  parameter-3-24 as character no-undo .
     3284       define variable  parameter-4-24 as character no-undo .
     3285       define variable  parameter-5-24 as character no-undo .
     3286       define variable  parameter-6-24 as character no-undo .
     3287       define variable  parameter-7-24 as character no-undo .
     3288         assign
     3289         parameter-3-24 =
     3290                                 "FOR EACH X_c-cli-grp"
     3291         parameter-4-24 =
     3292           (
     3293             if (" X_c-cli-grp.node-code = p-node-code " + " " + where-phrase-24) <> ""
     3294             then  substitute('X_c-cli-grp.node-code = &1', p-node-code)  + " " + where-phrase-24
     3295             else "true"
     3296           )
     3297         parameter-5-24 = (" " + "" + " " + "")
     3298         parameter-6-24 = if sort-phrase-24 = ''
     3299                              then
     3300           (
     3301           " " + "  " +
     3302             " " + sort-column-phrase +
     3303           " " + "  "
     3304           )
     3305                              else
     3306           (
     3307           " " + "  " +
     3308             " " + sort-column-phrase +
     3309           " " + sort-phrase-24
     3310           )
     3311         parameter-7-24 =
     3312           "   "
     3313       .
     3314       do
     3315       on stop undo, leave
     3316       on error undo, leave
     3317       :
     3318         assign
     3319           l-disable-where-24 =
     3320             (" X_c-cli-grp.node-code = p-node-code " + " " + where-phrase-24 = "")
     3321         .
     3322         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3323                             ,input query br-c-cli-grp:handle
     3324                             ,input parameter-3-24
     3325                             ,input parameter-4-24
     3326                             ,input parameter-5-24
     3327                             ,input parameter-6-24
     3328                             ,input parameter-7-24
     3329                             )
     3330         .
     3331         assign
     3332           l-filter-open-24 = true
     3333         .
     3334       end.
     3335       if l-filter-open-24 = false then do:
     3336         message
     3337           "Ошибка при фильтрации / сортировке" skip
     3338           "Будут показаны записи без учета фильтра" skip
     3339           view-as alert-box .
     3340       end.
     3341       else do:
     3342           assign
     3343             l-query-was-opened = true
     3344           .
     3345       end.
     3346     end.
     3347     if l-filter-open-24 = false then do:
     3348       OPEN QUERY br-c-cli-grp FOR EACH X_c-cli-grp
     3349         where  X_c-cli-grp.node-code = p-node-code
     3350     .
     3351         assign
     3352           l-query-was-opened = true
     3353         .
     3354     end.
     3355     run waitfram-hide in this-procedure .
     3356     end.
     3357   END CASE.
     3358   apply "entry" to br-c-cli-grp in frame Dialog-Frame.
     3359   reposition br-c-cli-grp to row 1 no-error.
     3360   run waitfram-hide in this-procedure .
     3361   if avail X_c-cli-grp then
     3362   APPLY "VALUE-CHANGED":U to br-c-cli-grp.
     3363   END PROCEDURE.
     3364   PROCEDURE proc-b-sch :
     3365   assign
     3366   tbl = 'c-cli-grp'
     3367   join-tbl = 'X_c-cli-grp'
     3368   fld = ""
     3369   lab = ""
     3370   spr = ""
     3371   dim = '0'
     3372   .
     3373   run fltfield-add in this-procedure('corr-date', 'Дата изменений', '',
     3374   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3375   run fltfield-add in this-procedure('corr-time', 'Время изменений', 'time',
     3376   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3377   run fltfield-add in this-procedure('corr-user-db-num', 'БД изменений', '',
     3378   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3379   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     3380   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3381   run fltfield-add in this-procedure('subject', 'Предмет изменений', 'cli-grp-hist-subject',
     3382   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3383   DO on stop undo, leave:
     3384       run gbl/filter.w ( input parparentproc
     3385                         ,input filter-point + chr(4) + "Справочник истории групп клиентов"
     3386                         ,input tbl
     3387                         ,input join-tbl
     3388                         ,input fld
     3389                         ,input lab
     3390                         ,input spr
     3391                         ,input dim).
     3392       RUN OpenBr in this-procedure.
     3393   END .
     3394   END PROCEDURE.
     3395   PROCEDURE proc-view-changes :
     3396   define variable v-description as character no-undo .
     3397   for each temp-changes:
     3398       delete temp-changes.
     3399   END.
     3400   if not available X_c-cli-grp then do:
     3401     Open QUery br-changes for each temp-changes.
     3402     return.
     3403   end.
     3404   assign
     3405   v-full-name-old = "":U
     3406   v-full-name-new = "":U
     3407   .
     3408   run ref/ccgrhisv.p (
     3409                      input X_c-cli-grp.node-code
     3410                     ,input X_c-cli-grp.corr-user-db-num
     3411                     ,input X_c-cli-grp.chip-num
     3412                     ,input X_c-cli-grp.subject
     3413                     ,input no
     3414                     ,output v-description
     3415                     ,OUTPUT v-full-name-old
     3416                     ,OUTPUT v-full-name-new
     3417                  ) no-error .
     3418   Open QUery br-changes for each temp-changes.
     3419   assign
     3420   br-changes:title in frame Dialog-Frame = v-description
     3421   .
     3422   if v-full-name-old <> "":U
     3423   or v-full-name-new <> "":U  then do:
     3424     DISPLAY
     3425     v-full-name-old
     3426     v-full-name-new
     3427     WITH FRAME Dialog-Frame.
     3428   end.
     3429   else do:
     3430     hide
     3431     v-full-name-old
     3432     v-full-name-new
     3433     IN FRAME Dialog-Frame.
     3434   end.
     3435   END PROCEDURE.
     3436   FUNCTION get-action RETURNS CHARACTER
     3437     (  p-action as integer ) :
     3438     define variable dops as character no-undo.
     3439   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     3440   RETURN dops.
     3441   END FUNCTION.
     3442   FUNCTION get-subject RETURNS CHARACTER
     3443     ( p-subject as character ) :
     3444     RETURN entry (lookup (p-subject, 'cli-grp,dis-grp-rule':U), 'Группа клиентов,Скидки по группе':U).
     3445   END FUNCTION.
