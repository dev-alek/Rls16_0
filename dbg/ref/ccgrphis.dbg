        1   DEFINE BUFFER buf_cli FOR clients.
        2   DEFINE BUFFER X_c-cli-grp FOR c-cli-grp.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   DEFINE INPUT PARAMETER bttns  as character  no-undo .
        5   DEFINE INPUT PARAMETER p-mode as character no-undo.
        6   DEFINE INPUT PARAMETER p-node-code like ub.c-cli-grp.node-code no-undo.
        7   define input parameter p-is-del    as logical no-undo .
        8   DEFINE OUTPUT PARAMETER  p-rid-list    as  char no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":u .
       10   define variable vss-author      as character no-undo init "$Author$":u .
       11   define variable vss-date        as character no-undo init "$Date$":u .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       13   define variable vss-archive     as character no-undo init "$Archive$":u .
       14   define variable vss-description as character no-undo init "Справочник истории групп клиентов" .
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   procedure proc-alt-shift-f2:
       76     if not ibs.th.gbl.gbl-var:rcode
       77   then
       78     run gbl\inidebug.p .
       79   end.
       80   procedure proc-alt-shift-f3:
       81     run gbl/prvssinf.p
       82       ( input this-procedure
       83       ) .
       84   end.
       85   define variable v-inform-launched as logical no-undo initial false .
       86   procedure proc-alt-shift-f4:
       87     define variable v-action as character no-undo .
       88     if v-inform-launched = false then do:
       89       assign
       90         v-inform-launched = true
       91       .
       92       run gbl/d-inform.w
       93         (  input self
       94         ,  input this-procedure
       95         , output v-action
       96         ) no-error .
       97       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       98       assign
       99         v-inform-launched = false
      100       .
      101     end.
      102   end.
      103   procedure proc-alt-f1:
      104     run gbl/corrhelp.p
      105       (input this-procedure
      106       ) .
      107   end .
      108   on alt-shift-f2 anywhere do:
      109     run proc-alt-shift-f2.
      110   end.
      111   on alt-shift-f3 anywhere do:
      112     run proc-alt-shift-f3 in this-procedure .
      113   end.
      114   on alt-shift-f4 anywhere do:
      115     run proc-alt-shift-f4 in this-procedure.
      116   end.
      117   on alt-f1 anywhere do:
      118     run proc-alt-f1 in this-procedure .
      119   end.
      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   procedure cur-time :
      122      define output parameter p-today as date      no-undo .
      123      define output parameter p-time  as integer   no-undo .
      124     do
      125     on error undo, return error
      126     :
      127       define variable v-date1 as date      no-undo .
      128       define variable v-date2 as date      no-undo .
      129       define variable v-time  as integer   no-undo .
      130       assign
      131         v-date1 = today
      132         v-time  = time
      133         v-date2 = today
      134       .
      135       if v-date1 <> v-date2
      136       then do:
      137         assign
      138           v-date1 = today
      139           v-time  = v-time
      140         .
      141       end.
      142       assign
      143         p-today = v-date1
      144         p-time  = v-time
      145       .
      146     end.
      147   end.
      148   function cur-time-date returns character
      149   :
      150     return string(today, '99/99/9999':U) .
      151   end.
      152   function cur-time-mjd returns decimal
      153   :
      154     define variable v-date as date      no-undo .
      155     define variable v-time as integer   no-undo .
      156     run cur-time in this-procedure
      157       (output v-date
      158       ,output v-time
      159       ) .
      160     return integer(v-date) - 2400002 + (v-time / 86400) .
      161   end.
      162   function cur-time-get-ending-index returns integer
      163   (input p-number as integer
      164   )
      165   :
      166     if p-number < 0
      167     or p-number = ?
      168     then do:
      169       return 1 .
      170     end.
      171     define variable v-rest as integer   no-undo .
      172     assign
      173       p-number = p-number modulo 100
      174     .
      175     if p-number < 20
      176     then do:
      177       assign
      178         v-rest = p-number
      179       .
      180     end.
      181     else do:
      182       assign
      183         v-rest = p-number modulo 10
      184       .
      185     end.
      186     case v-rest :
      187       when 1
      188       then do:
      189         return 2 .
      190       end.
      191       when 2 or
      192       when 3 or
      193       when 4
      194       then do:
      195         return 3 .
      196       end.
      197       otherwise do:
      198         return 1 .
      199       end.
      200     end case .
      201   end.
      202   procedure cur-time-mjd-to-date :
      203      define input  parameter i-mjd-diff as decimal no-undo.
      204      define output parameter o-Date     as date    no-undo.
      205      define output parameter o-Time     as integer no-undo.
      206      define variable v-day-number as integer   no-undo .
      207      if    i-mjd-diff < 0
      208         or i-mjd-diff = ?
      209      then do:
      210         return "?" .
      211      end.
      212      assign
      213         v-day-number = truncate(i-mjd-diff,0).
      214         o-Date = date(v-day-number + 2400002).
      215         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      216     .
      217   end.
      218   function cur-time-mjd-to-string returns character
      219   (input p-mjd-diff as decimal
      220   )
      221   :
      222     define variable v-day-number as integer   no-undo .
      223     define variable v-seconds    as integer   no-undo .
      224     define variable v-hour       as integer   no-undo .
      225     define variable v-min        as integer   no-undo .
      226     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      227     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      228     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      229     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      230     if p-mjd-diff < 0
      231     or p-mjd-diff = ?
      232     then do:
      233       return "?" .
      234     end.
      235     assign
      236       v-day-number = integer(truncate(p-mjd-diff,0))
      237       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      238     .
      239     if v-seconds > 86400
      240     then do:
      241       assign
      242         v-seconds = 86400 - 1
      243       .
      244     end.
      245     if v-seconds < 0
      246     then do:
      247       assign
      248         v-seconds = 0
      249       .
      250     end.
      251     assign
      252       v-hour = truncate(v-seconds / 3600, 0)
      253     .
      254     assign
      255       v-seconds = v-seconds modulo 3600
      256     .
      257     assign
      258       v-min = truncate(v-seconds / 60, 0)
      259     .
      260     assign
      261       v-seconds = v-seconds modulo 60
      262     .
      263     return
      264         (if v-day-number <> 0
      265           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      266           else ""
      267         )
      268       + (if v-day-number <> 0 or v-hour <> 0
      269           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      270           else ""
      271         )
      272       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      273           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      274           else ""
      275         )
      276       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      277       .
      278   end.
      279   function cur-time-string returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-string-sec returns character
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      298   end.
      299   function cur-time-custom  returns character
      300   (input p-prefix as character
      301   ,input p-date-format as character
      302   ,input p-delimiter as character
      303   ,input p-time-format as character
      304   ,input p-suffix as character
      305   )
      306   :
      307     define variable v-date as date      no-undo .
      308     define variable v-time as integer   no-undo .
      309     run cur-time in this-procedure
      310       (output v-date
      311       ,output v-time
      312       ) .
      313     return
      314       p-prefix
      315       + string(v-date, p-date-format)
      316       + p-delimiter
      317       + string(v-time, p-time-format)
      318       + p-suffix
      319       .
      320   end.
      321   function cur-time-print  returns character
      322   :
      323     define variable v-date as date      no-undo .
      324     define variable v-time as integer   no-undo .
      325     run cur-time in this-procedure
      326       (output v-date
      327       ,output v-time
      328       ) .
      329     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      330   end.
      331   function cur-time-datetime returns datetime
      332   :
      333     define variable v-char as character no-undo .
      334     define variable v-datetime as datetime no-undo .
      335     v-char = cur-time-string().
      336     v-datetime = datetime(v-char).
      337     return  v-datetime.
      338   end.
      339   function cur-time-string-msec returns character
      340   :
      341     define variable v-date as datetime  no-undo .
      342     v-date = now.
      343     return string(v-date) .
      344   end.
      345   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      346   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      347   define new shared variable RepPathName        as character no-undo .
      348   define new shared variable PrintRubl          as logical   no-undo .
      349   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      350   define variable c-point  as character no-undo .
      351   define variable tbl      as character no-undo .
      352   define variable join-tbl as character no-undo .
      353   define variable fld      as character no-undo .
      354   define variable lab      as character no-undo .
      355   define variable spr      as character no-undo .
      356   define variable dim      as character no-undo .
      357   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      358   procedure fltfield-clear :
      359     define output parameter loc-fld as character no-undo.
      360     define output parameter loc-lab as character no-undo .
      361     define output parameter loc-spr as character no-undo .
      362     define output parameter loc-dim as character no-undo .
      363     assign
      364       loc-fld = ""
      365       loc-lab = ""
      366       loc-spr = ""
      367       loc-dim = "0"
      368     .
      369   end procedure .
      370   procedure fltfield-add :
      371     define input        parameter par-fld as character no-undo.
      372     define input        parameter par-lab as character no-undo .
      373     define input        parameter par-spr as character no-undo .
      374     define input-output parameter loc-fld as character no-undo.
      375     define input-output parameter loc-lab as character no-undo .
      376     define input-output parameter loc-spr as character no-undo .
      377     define input-output parameter loc-dim as character no-undo .
      378     do
      379     on error undo, return error
      380     :
      381       assign
      382       loc-fld = if loc-dim = '0'
      383                 then par-fld
      384                 else (loc-fld + chr(44) + par-fld)
      385       loc-lab = if loc-dim = '0'
      386                 then par-lab
      387                 else (loc-lab + chr(44) + par-lab)
      388       loc-spr = if loc-dim = '0'
      389                 then par-spr
      390                 else (loc-spr + chr(44) + par-spr)
      391       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      392                 string(integer(if num-entries(loc-dim) > 1
      393                               then entry(2, loc-dim)
      394                               else entry(1, loc-dim)
      395                               ) + 1)
      396       no-error
      397       .
      398     end.
      399   end procedure.
      400   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      401   define variable v-waitfram-action01         as character   no-undo .
      402   define variable v-waitfram-action02         as character   no-undo .
      403   define variable v-waitfram-action03         as character   no-undo .
      404   define variable mWaitFramTextBeg            as character   no-undo.
      405   define variable mWaitFramTextEnd            as character   no-undo.
      406   define variable mWaitFramView               as logical     no-undo.
      407   define variable mWaitProcEvent              as logical     no-undo init yes.
      408   define variable mWaitFramInterval           as integer     no-undo init 1 .
      409   define variable mWaitFramStop               as logical     no-undo.
      410   define variable mWaitFramStopUser           as logical     no-undo.
      411   define variable mWaitFramStopTimeOut        as logical     no-undo.
      412   define variable mWaitFramStartProc          as datetime-tz no-undo.
      413   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      414   define button B-WaitFramStop auto-end-key
      415        label "Стоп"
      416        size 10 by 1 tooltip "Остоновить процесс".
      417   define button B-viewProcInfo
      418        label "Информация"
      419        size 15 by 1 tooltip "Информация о процесс".
      420   define frame waitfram
      421     v-waitfram-action01 format "x(72)" no-label skip
      422     v-waitfram-action02 format "x(72)" no-label skip
      423     v-waitfram-action03 format "x(72)" no-label skip
      424     B-viewProcInfo
      425     B-WaitFramStop at row 4 col 30
      426     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      427     .
      428   define new global shared variable mBatchMode as logical no-undo init ?.
      429   define variable mFramBachModHandle as handle no-undo.
      430   mFramBachModHandle = frame waitfram:handle.
      431   define variable mFameOldVis as logical no-undo.
      432   define variable mVisCUrentVin as logical no-undo.
      433   if session:batch-mode
      434   then
      435      mBatchMode = yes.
      436   if mBatchMode = ? then do:
      437     mVisCUrentVin = current-window:visible.
      438     mFameOldVis = mFramBachModHandle:visible.
      439     mFramBachModHandle:visible  = yes.
      440     mBatchMode = mFramBachModHandle:visible ne yes.
      441     mFramBachModHandle:visible = mFameOldVis.
      442     current-window:visible = mVisCUrentVin.
      443   end.
      444    if  log-manager:logfile-name ne ?
      445     then DO:
      446         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      447         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      448         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      449     end.
      450   on choose of B-WaitFramStop in frame waitfram
      451   do:
      452     mWaitFramStop = yes.
      453     mWaitFramStopUser = yes.
      454   end.
      455   function waitfram-check-timeout returns logical():
      456      define variable vtime as int64 no-undo.
      457      if mWaitFramStopTimeOut
      458      then
      459         return yes.
      460      vtime = ( now - mWaitFramStartProc ) / 1000 .
      461      if     mWaitFramTimeOut ne ?
      462         and mWaitFramTimeOut ne 0
      463         and mWaitFramTimeOut lt vtime
      464      then do:
      465         mWaitFramStopTimeOut = yes.
      466      end.
      467      return mWaitFramStopTimeOut.
      468   end.
      469   procedure waitfram-hide :
      470     if not session:batch-mode
      471     then do
      472     on error undo, return error return-value
      473     :
      474       pause 0 before-hide .
      475       if not mBatchMode then
      476         hide frame waitfram .
      477     if     not mWaitFramView
      478        and mWaitProcEvent
      479     then
      480       process events .
      481     end.
      482   end procedure.
      483   procedure waitfram-show :
      484     define input  parameter p-message as character no-undo .
      485     define variable v-left-margin as integer   no-undo .
      486     if not session:batch-mode
      487     then do
      488     on error undo, return error return-value
      489     :
      490       if length(p-message) <= 70 then do:
      491         assign
      492           v-left-margin = integer((70 - length(p-message)) / 2)
      493         .
      494         assign
      495           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      496         .
      497         assign
      498           v-waitfram-action01 = " "
      499           v-waitfram-action02 = " "
      500                                    + fill(" ", v-left-margin)
      501                                    + p-message
      502           v-waitfram-action03 = " "
      503         .
      504       end.
      505       else do:
      506         define variable vRindex1 as integer no-undo.
      507         define variable vRindex2 as integer no-undo.
      508         vRindex1 = r-index(p-message," ",70).
      509         if vRindex1 = 0
      510         then
      511            vRindex1 = 70.
      512         if length(p-message)  <= vRindex1 + 70 then do:
      513           assign
      514             v-waitfram-action01 = " "
      515             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      516             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      517           .
      518         end.
      519         else do:
      520           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      521           if vRindex2 <= vRindex1
      522           then
      523              vRindex2 = vRindex1 + 70.
      524           assign
      525             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      526             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      527             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      528           .
      529         end.
      530       end.
      531       B-viewProcInfo:visible   in frame waitfram = no.
      532       B-viewProcInfo:sensitive in frame waitfram = no.
      533       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      534       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      535       if  (   mWaitFramView
      536          or  mWaitProcEvent)
      537          and not mBatchMode
      538       then
      539          display
      540             v-waitfram-action01 skip
      541             v-waitfram-action02 skip
      542             v-waitfram-action03 skip
      543          with frame waitfram .
      544       if     mWaitFramView
      545          then do:
      546             if     mWaitFramInterval ne ?
      547                and not mBatchMode
      548             then
      549                wait-for go of frame waitfram pause mWaitFramInterval.
      550          end.
      551          else
      552             if     mWaitProcEvent
      553                and not mBatchMode
      554             then
      555                process events .
      556     end.
      557   end procedure.
      558      procedure waitfram-show-this:
      559         define input  parameter iInterval as int64 no-undo.
      560         define variable vtime as int64 no-undo.
      561         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      562         mWaitFramInterval = iInterval.
      563         run waitfram-show (substitute("&1&2 &3&4" ,
      564                                       mWaitFramTextBeg ,
      565                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      566                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      567                                       mWaitFramTextEnd
      568                                      )
      569                           ).
      570      end.
      571      procedure WaitFramRunPause:
      572         define input  parameter iInterval as dec no-undo.
      573         define variable vStart  as datetime-tz no-undo.
      574         define variable vend    as datetime-tz no-undo.
      575         define variable vint as int64 no-undo.
      576         define variable vOk as logical no-undo.
      577         vStart = now.
      578         vend   = vStart.
      579         publish "WaitFramPause" (iInterval,output vOk).
      580         vend   =  now.
      581         vint = vend - vStart.
      582         vint = iInterval - vint / 1000.
      583         if     not mWaitFramStop
      584            and (   vint > 0
      585                 or (    not vOk
      586                     and iInterval eq ?
      587                     )
      588                 )
      589         then
      590            run waitfram-show-this (iInterval).
      591         vend   =  now.
      592         vint = vend - vStart.
      593         vint = iInterval - vint / 1000.
      594         if     not mWaitFramStop
      595            and vint > 0
      596         then do:
      597            run gbl/pause.p (vint * 1000).
      598         end.
      599         if iInterval ne ?
      600         then
      601            publish "WaitFramStop".
      602         waitfram-check-timeout().
      603      end.
      604      procedure WaitFramWaitFor:
      605         define input  parameter iInterval as dec no-undo.
      606         assign
      607            mWaitFramStartProc   = now
      608            mWaitFramStopUser    = no
      609            mWaitFramStopTimeOut = no
      610         .
      611         block-wait:
      612         do while not mWaitFramStop:
      613            run WaitFramRunPause (iInterval).
      614            if  waitfram-check-timeout()
      615            then do:
      616               leave block-wait.
      617            end.
      618         end.
      619         run waitfram-hide.
      620      end.
      621   procedure waitfram-join :
      622     define input  parameter p-line-1  as character no-undo .
      623     define input  parameter p-line-2  as character no-undo .
      624     define input  parameter p-line-3  as character no-undo .
      625     define output parameter p-message as character no-undo .
      626     do
      627     on error undo, return error return-value
      628     :
      629       assign
      630         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      631                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      632                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      633       .
      634     end.
      635   end procedure.
      636   function waitfram-join-function returns character
      637     (input p-line-1 as character
      638     ,input p-line-2 as character
      639     ,input p-line-3 as character
      640     ).
      641     define variable v-message as character no-undo .
      642     run waitfram-join in this-procedure
      643       (input  p-line-1
      644       ,input  p-line-2
      645       ,input  p-line-3
      646       ,output v-message
      647       ) .
      648     return v-message .
      649   end function .
      650   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      651   procedure grp-attr-name :
      652   do
      653     on error undo, return error
      654     :
      655     define input  parameter p-code           as character no-undo .
      656     define output parameter p-type           as character no-undo .
      657     define output parameter p-format         as character no-undo .
      658     define output parameter p-label          as character no-undo .
      659     define output parameter p-user-can-edit  as logical   no-undo .
      660     define output parameter p-output-display as logical   no-undo .
      661     define output parameter p-other          as character no-undo .
      662       case p-code :
      663               when 'gds-grp-nabor':U then do:     assign     p-label = "Набор"     p-type = 'L':U      p-format = "yes/no"     p-label = "Набор"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      664         otherwise do:
      665           undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
      666         end.
      667       end.
      668     end.
      669   end procedure.
      670   procedure grp-attr-tooltip :
      671   do
      672     on error undo, return error
      673     :
      674       define input  parameter p-code    as character no-undo .
      675       define output parameter p-tooltip as character no-undo .
      676       define output parameter p-label   as character no-undo .
      677       case p-code :
      678               when 'gds-grp-nabor':U then do:     assign     p-tooltip = "Набор - не товарные позиции"     p-label = "Набор" .   end.
      679         otherwise do:
      680               undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
      681         end.
      682       end.
      683     end.
      684   end procedure.
      685   procedure grp-attr-value :
      686   do
      687   on error undo, return error
      688   :
      689   define input  parameter p-node-code   as integer    no-undo.
      690   define input  parameter p-code        as character  no-undo.
      691   define input  parameter p-host-code   as integer    no-undo.
      692   define input  parameter p-obj-type    as character  no-undo.
      693   define input  parameter p-obj-code    as integer    no-undo.
      694   define output parameter p-value       as character  no-undo.
      695   define output parameter p-type        as character  no-undo.
      696       define variable v-format         as character no-undo .
      697       define variable v-label          as character no-undo .
      698       define variable v-user-can-edit  as logical   no-undo .
      699       define variable v-output-display as logical   no-undo .
      700       define variable v-other          as character no-undo .
      701       define buffer buf_gds-grp-attr for ub.gds-grp-attr.
      702       run grp-attr-name in this-procedure (
      703             input  p-code
      704           , output p-type
      705           , output v-format
      706           , output v-label
      707           , output v-user-can-edit
      708           , output v-output-display
      709           , output v-other
      710       ) no-error .
      711       if error-status :error
      712       then do:
      713           undo, return error return-value .
      714       end.
      715       find first buf_gds-grp-attr no-lock
      716            where buf_gds-grp-attr.node-code = p-node-code
      717              and buf_gds-grp-attr.attr-code = p-code
      718              and buf_gds-grp-attr.host-code = p-host-code
      719              and buf_gds-grp-attr.obj-type  = p-obj-type
      720              and buf_gds-grp-attr.obj-code  = p-obj-code
      721       no-error .
      722       if available buf_gds-grp-attr
      723       then do:
      724           assign
      725               p-value = buf_gds-grp-attr.attr-value
      726           .
      727       end.
      728       else do:
      729           assign
      730               p-value = if p-type = 'L':U then "no":U else ""
      731           .
      732       end.
      733   end.
      734   end procedure.
      735   procedure grp-attr-write :
      736   do
      737   on error undo, return error
      738   :
      739   define input parameter p-node-code  like ub.gds-grp-attr.node-code      no-undo.
      740   define input parameter p-code       like ub.gds-grp-attr.attr-code      no-undo.
      741   define input parameter p-host-code  as integer                          no-undo.
      742   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      743   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      744   define input parameter p-value      like ub.gds-grp-attr.attr-value     no-undo.
      745       define variable v-type              as character                no-undo.
      746       define variable v-format            as character                no-undo.
      747       define variable v-label             as character                no-undo.
      748       define variable v-user-can-edit     as logical                  no-undo.
      749       define variable v-output-display    as logical                  no-undo.
      750       define variable v-other             as character                no-undo.
      751       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      752       run grp-attr-name in this-procedure (
      753                         input  p-code
      754                       , output v-type
      755                       , output v-format
      756                       , output v-label
      757                       , output v-user-can-edit
      758                       , output v-output-display
      759                       , output v-other
      760       ) no-error.
      761       if error-status :error
      762       then do:
      763           undo, return error return-value.
      764       end.
      765       find first buf_gds-grp-attr exclusive-lock
      766            where buf_gds-grp-attr.node-code  = p-node-code
      767              and buf_gds-grp-attr.attr-code  = p-code
      768              and buf_gds-grp-attr.host-code  = p-host-code
      769              and buf_gds-grp-attr.obj-type   = p-obj-type
      770              and buf_gds-grp-attr.obj-code   = p-obj-code
      771       no-error.
      772       if not available buf_gds-grp-attr
      773       then do:
      774           create buf_gds-grp-attr.
      775           assign
      776                   buf_gds-grp-attr.node-code  = p-node-code
      777                   buf_gds-grp-attr.attr-code  = p-code
      778                   buf_gds-grp-attr.host-code  = p-host-code
      779                   buf_gds-grp-attr.obj-type   = p-obj-type
      780                   buf_gds-grp-attr.obj-code   = p-obj-code
      781                   buf_gds-grp-attr.attr-value = p-value
      782           .
      783       end.
      784       else do:
      785           assign
      786               buf_gds-grp-attr.attr-value = p-value
      787           .
      788       end.
      789   end.
      790   end procedure.
      791   procedure grp-attr-delete :
      792   do
      793   on error undo, return error
      794   :
      795   define input parameter p-node-code  like ub.gds-grp-attr.node-code  no-undo.
      796   define input parameter p-code       like ub.gds-grp-attr.attr-code  no-undo.
      797   define input parameter p-host-code  as integer                      no-undo.
      798   define input parameter p-obj-type   like ub.clients.obj-type        no-undo.
      799   define input parameter p-obj-code   like ub.clients.obj-code        no-undo.
      800   define output parameter p-deleted   as logical                      no-undo.
      801       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      802       define variable v-type              as character                no-undo.
      803       define variable v-format            as character                no-undo.
      804       define variable v-label             as character                no-undo.
      805       define variable v-user-can-edit     as logical                  no-undo.
      806       define variable v-output-display    as logical                  no-undo.
      807       define variable v-other             as character                no-undo.
      808       run grp-attr-name in this-procedure
      809       ( input  p-code
      810       , output v-type
      811       , output v-format
      812       , output v-label
      813       , output v-user-can-edit
      814       , output v-output-display
      815       , output v-other
      816       ) no-error .
      817       if error-status :error then do:
      818           undo, return error return-value .
      819       end.
      820       find first buf_gds-grp-attr exclusive-lock
      821            where buf_gds-grp-attr.node-code  = p-node-code
      822              and buf_gds-grp-attr.attr-code  = p-code
      823              and buf_gds-grp-attr.host-code  = p-host-code
      824              and buf_gds-grp-attr.obj-type   = p-obj-type
      825              and buf_gds-grp-attr.obj-code   = p-obj-code
      826       no-error.
      827       if not available buf_gds-grp-attr
      828       then do:
      829           assign
      830               p-deleted = no
      831           .
      832       end.
      833       else do:
      834          delete buf_gds-grp-attr.
      835          assign
      836               p-deleted = yes
      837           .
      838       end.
      839   end.
      840   end procedure.
      841   procedure grp-attr-news :
      842   do
      843   on error undo, return error
      844   :
