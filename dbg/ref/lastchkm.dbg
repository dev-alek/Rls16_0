      988   MAIN-BLOCK:
      989   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      990      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      991     RUN Myenable.
      992     WAIT-FOR GO OF FRAME Dialog-Frame.
      993   END.
      994   RUN disable_UI.
      995   PROCEDURE disable_UI :
      996     HIDE FRAME Dialog-Frame.
      997   END PROCEDURE.
      998   PROCEDURE enable_UI :
      999     DISPLAY f-date f-p-date f-z-num f-p-z-num f-num-recs f-p-num-recs
     1000         WITH FRAME Dialog-Frame.
     1001     ENABLE B-exit b-quit B-Help f-date f-p-date f-z-num f-p-z-num f-num-recs
     1002            f-p-num-recs
     1003         WITH FRAME Dialog-Frame.
     1004     VIEW FRAME Dialog-Frame.
     1005   END PROCEDURE.
     1006   PROCEDURE MyEnable :
     1007   ASSIGN
     1008   f-date = p-date
     1009   f-p-date = p-p-date
     1010   f-z-num = p-z-num
     1011   f-p-z-num = p-p-z-num
     1012   f-num-recs = p-num-recs
     1013   f-p-num-recs = p-p-num-recs
     1014   FRAME Dialog-Frame:TITLE = ENTRY(1, p-title, chr(4))
     1015   f-date:LABEL IN FRAME Dialog-Frame = (IF NUM-ENTRIES(p-title, chr(4)) > 1
     1016                                            THEN ENTRY(2, p-title, chr(4))
     1017                                            ELSE f-date:LABEL IN FRAME Dialog-Frame)
     1018   f-p-date:LABEL IN FRAME Dialog-Frame = (IF NUM-ENTRIES(p-title, chr(4)) > 2
     1019                                           THEN ENTRY(3, p-title, chr(4))
     1020                                           ELSE f-p-date:LABEL IN FRAME Dialog-Frame)
     1021   f-z-num:LABEL IN FRAME Dialog-Frame = (IF NUM-ENTRIES(p-title, chr(4)) > 3
     1022                                            THEN ENTRY(4, p-title, chr(4))
     1023                                            ELSE f-z-num:LABEL IN FRAME Dialog-Frame)
     1024   f-p-z-num:LABEL IN FRAME Dialog-Frame = (IF NUM-ENTRIES(p-title, chr(4)) > 4
     1025                                           THEN ENTRY(5, p-title, chr(4))
     1026                                           ELSE f-p-z-num:LABEL IN FRAME Dialog-Frame)
     1027   .
     1028   DISPLAY
     1029   f-date
     1030   f-p-date
     1031   f-z-num
     1032   f-p-z-num
     1033   f-num-recs
     1034   f-p-num-recs
     1035   WITH FRAME Dialog-Frame.
     1036   ENABLE
     1037   B-exit
     1038   b-quit
     1039   B-Help
     1040   f-date
     1041   f-p-date
     1042   f-z-num
     1043   f-p-z-num
     1044   WITH FRAME Dialog-Frame.
     1045   VIEW FRAME Dialog-Frame.
     1046   END PROCEDURE.
     1047   PROCEDURE proc-save :
     1048   define variable v-ok as logical no-undo .
     1049   define variable v-mes as character no-undo .
     1050   ASSIGN
     1051   f-date FRAME Dialog-Frame
     1052   f-p-date
     1053   f-z-num
     1054   f-p-z-num
     1055   .
     1056   IF f-date = ?
     1057   OR f-p-date = ? THEN DO:
     1058       MESSAGE
     1059       "Дата чека должна быть определена"
     1060       VIEW-AS ALERT-BOX ERROR.
     1061       RETURN ERROR.
     1062   END.
     1063   IF f-z-num = 0
     1064   OR f-p-z-num = 0
     1065   OR f-z-num > 100
     1066   OR f-p-z-num > 100
     1067   THEN DO:
     1068       MESSAGE
     1069       "№ смены (для кассы MARIA - это последние две цифры z-отчета - или 100)" SKIP
     1070       "не может быть равен 0"
     1071       VIEW-AS ALERT-BOX ERROR.
     1072       RETURN ERROR.
     1073   END.
     1074   IF p-date <> f-date
     1075   OR p-z-num <> f-z-num
     1076   THEN DO:
     1077       p-num-recs = 0.0.
     1078   END.
     1079   IF p-p-date <> f-p-date
     1080   OR p-p-z-num <> f-p-z-num THEN DO:
     1081       p-p-num-recs = 0.
     1082   END.
     1083   ASSIGN
     1084   p-date = f-date
     1085   p-p-date = f-p-date
     1086   p-z-num = f-z-num
     1087   p-p-z-num = f-p-z-num
     1088   p-ok = yes.
     1089   END PROCEDURE.
