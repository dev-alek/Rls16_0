        1   DEFINE TEMP-TABLE temp-cpdisc NO-UNDO LIKE ub.dis-cp-rule
        2          field rule-label as character.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-mode as char no-undo.
        5   define input parameter p-cdpay-code like ub.dis-cp-rule.cdpay-code no-undo.
        6   define input parameter p-curr-code  like ub.dis-cp-rule.curr-code no-undo .
        7   define input parameter p-host-code like ub.dis-cp-rule.host-code no-undo.
        8   define input parameter p-obj-type like ub.dis-cp-rule.obj-type no-undo.
        9   define input parameter p-obj-code like ub.dis-cp-rule.obj-code no-undo.
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Скидки на платеж".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77     define variable v-cntxt-db-num        as integer   no-undo .
       78     define variable v-cntxt-userid        as character no-undo .
       79     define variable v-cntxt-level         as character no-undo .
       80     define variable v-cntxt-host-code-obj as integer   no-undo .
       81     define variable v-cntxt-obj-type      as character no-undo .
       82     define variable v-cntxt-obj-code      as integer   no-undo .
       83     define variable v-cntxt-db-num-obj    as integer   no-undo .
       84     define variable v-cntxt-is-admin      as logical   no-undo .
       85   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       87   define temp-table temp-drt-prop no-undo like ub.drt-prop.
       88   procedure disrules-fill-properties:
       89   define input  parameter p-templ-rl-root as integer   no-undo .
       90   define buffer buf_drt-prop for ub.drt-prop.
       91   define buffer buf_temp-drt-prop for temp-drt-prop.
       92   do
       93   on error undo, return error return-value
       94   :
       95     for each buf_temp-drt-prop:
       96       delete buf_temp-drt-prop.
       97     end.
       98     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
       99       create buf_temp-drt-prop.
      100       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      101     end.
      102   end.
      103   end procedure.
      104   ~
      105   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      106   procedure discfgru-check :
      107   define input parameter p-table-name as character no-undo .
      108   define input parameter p-templ-rl-root as integer no-undo .
      109   define input parameter p-time-templ-rl-root as integer no-undo .
      110   define input parameter p-pos-type as character no-undo .
      111   define output parameter p-disnct-role as character no-undo .
      112   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      113     do
      114     on error undo, return error return-value
      115     :
      116       find first buf_dis-cfg-rule no-lock where
      117               buf_dis-cfg-rule.table-name = p-table-name
      118           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      119           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      120           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      121       if not available buf_dis-cfg-rule
      122       or p-pos-type = "":U
      123       then do:
      124          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      125                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      126                                  , p-templ-rl-root
      127                                  , (if p-time-templ-rl-root = ?
      128                                     then '':U
      129                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      130                                     )
      131                                  ).
      132       end.
      133       assign
      134       p-disnct-role = buf_dis-cfg-rule.discnt-role
      135       .
      136     end.
      137   end procedure.
      138   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   FUNCTION get-region RETURNS CHARACTER
      140     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      141     define variable par-region as character no-undo.
      142     if parhost-code = 0 and
      143          parobj-type = "":U and
      144          parobj-code = 0 then do:
      145          par-region = "Глобально".
      146          return par-region.
      147       end.
      148       if parobj-type = 'орг':U then do:
      149          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      150          return par-region.
      151       end.
      152       if parobj-type = 'регион':U
      153       then do:
      154          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      155          return par-region.
      156       end.
      157       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      158       return par-region.
      159   END FUNCTION.
      160   FUNCTION get-objregion RETURNS CHARACTER
      161     (  input parobj-type as character, input parobj-code as integer ) :
      162     define variable par-region as character no-undo.
      163     if  parobj-type = "":U and
      164         parobj-code = 0
      165     then do:
      166        par-region = "Глобально".
      167     end.
      168     else if parobj-type = 'орг':U
      169     then do:
      170        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      171     end.
      172     else if parobj-type = 'регион':U
      173     then do:
      174        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      175     end.
      176     else
      177        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      178     return par-region.
      179   END FUNCTION.
      180   procedure discpru-name :
      181   define buffer buf_dis-rule for ub.dis-rule.
      182   do
      183     on error undo, return error
      184     :
      185     define input  parameter p-templ-rl-root  as integer no-undo .
      186     define output parameter p-label          as character no-undo .
      187     find first buf_dis-rule no-lock where
      188               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      189     if available buf_dis-rule then do:
      190       if buf_dis-rule.rule-num > 0 then
      191       p-label = buf_dis-rule.des.
      192     end.
      193     else do:
      194       p-label = substitute("Неизвестный шаблон правила скидки &1", p-templ-rl-root).
      195     end.
      196   end.
      197   end procedure.
      198   function discpru-get-disc-label returns character ( input p-templ-rl-root as integer):
      199   define variable v-rule-label as character no-undo .
      200   run discpru-name in this-procedure ( input p-templ-rl-root
      201                                        ,output v-rule-label) no-error.
      202   return v-rule-label.
      203   end function.
      204   function discpru-get-disc-role-label returns character ( input p-discnt-role as character):
      205   define variable v-rule-label as character no-undo .
      206   return entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u).
      207   end function.
      208   procedure discpru-write :
      209     do
      210     on error undo, return error
      211     :
      212       define input parameter p-cdpay-code     like ub.dis-cp-rule.cdpay-code  no-undo .
      213       define input parameter p-curr-code      like ub.dis-cp-rule.curr-code  no-undo .
      214       define input parameter p-host-code      like ub.dis-cp-rule.host-code   no-undo .
      215       define input parameter p-obj-type       like ub.dis-cp-rule.obj-type   no-undo .
      216       define input parameter p-obj-code       like ub.dis-cp-rule.obj-code   no-undo .
      217       define input parameter p-pos-type       like ub.dis-cp-rule.pos-type   no-undo .
      218       define input parameter p-discnt-role    like ub.dis-cp-rule.discnt-role no-undo .
      219       define input parameter p-templ-rl-root  like ub.dis-cp-rule.templ-rl-root  no-undo .
      220       define input parameter p-time-templ-rl-root  like ub.dis-cp-rule.time-templ-rl-root  no-undo .
      221       define input parameter p-rule-num       like ub.dis-cp-rule.rule-num    no-undo .
      222       define input parameter p-nonunique      like ub.dis-cp-rule.nonunique   no-undo .
      223       define buffer buf_dis-rule for ub.dis-rule.
      224       define buffer buf_dis-cp-rule for ub.dis-cp-rule .
      225       define buffer lock_dis-cp-rule for ub.dis-cp-rule .
      226       define variable v-label          as character no-undo .
      227       define variable v-discnt-role as character no-undo .
      228       run discfgru-check in this-procedure (
      229                                             input 'dis-cp-rule':U
      230                                            ,input p-templ-rl-root
      231                                            ,input p-time-templ-rl-root
      232                                            ,input p-pos-type
      233                                            ,output v-discnt-role
      234                                             ) no-error .
      235       if error-status :error then do:
      236         undo, return error return-value .
      237       end.
      238       if p-discnt-role = ? then do:
      239         p-discnt-role = v-discnt-role.
      240       end.
      241       if p-discnt-role <> v-discnt-role then do:
      242         undo, return error substitute("Тип платежа &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7не может быть по шаблону &8 и расписанию &9"
      243                                 ,p-cdpay-code
      244                                 ,p-curr-code
      245                                 ,p-host-code
      246                                 ,(p-obj-type + string(p-obj-code))
      247                                 ,p-pos-type
      248                                 ,entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u)
      249                                 ,chr(10)
      250                                 ,p-templ-rl-root
      251                                 ,p-rule-num).
      252       end.
      253       if p-pos-type = ? then do:
      254   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      255   define variable v-param-type5 as character no-undo .
      256   define variable v-value-date5 as date no-undo .
      257   define variable v-value-decimal5 as decimal no-undo .
      258   define variable v-value-integer5 as INTEGER no-undo .
      259   define variable v-value-logical5 AS LOGICAL no-undo .
      260   define variable v-tth5 as handle no-undo .
      261   run adm/shattri.p (
      262       input "get":U
      263       ,input  p-obj-type
      264       ,input  p-obj-code
      265       ,input  'cd-sending':U
      266       ,input  'dflt-cd':U
      267       ,output p-pos-type
      268       ,output v-value-date5
      269       ,output v-value-decimal5
      270       ,output v-value-integer5
      271       ,output v-value-logical5
      272       ,output v-param-type5
      273       ,INPUT-OUTPUT table-handle v-tth5
      274       )  .
      275   delete object v-tth5 no-error.
      276       end.
      277       find first buf_dis-rule no-lock where
      278                 buf_dis-rule.rule-num = p-rule-num no-error.
      279       if not available buf_Dis-rule then do:
      280         undo, return error substitute("Тип платежа &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7не найдено правило скидки &8"
      281                                 ,p-cdpay-code
      282                                 ,p-curr-code
      283                                 ,p-host-code
      284                                 ,(p-obj-type + string(p-obj-code))
      285                                 ,p-pos-type
      286                                 ,entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u)
      287                                 ,chr(10)
      288                                 ,p-rule-num).
      289       end.
      290       if buf_dis-rule.root <> yes then do:
      291         undo, return error substitute("Тип платежа &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7правило скидки &8 - некорневое"
      292                                 ,p-cdpay-code
      293                                 ,p-curr-code
      294                                 ,p-host-code
      295                                 ,(p-obj-type + string(p-obj-code))
      296                                 ,p-pos-type
      297                                 ,entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u)
      298                                 ,chr(10)
      299                                 ,p-rule-num).
      300       end.
      301       if not (p-obj-type = buf_dis-rule.obj-type
      302           and p-obj-code = buf_dis-rule.obj-code) then do:
      303         undo, return error (substitute("Тип платежа &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7правило скидки &8"
      304                                 ,p-cdpay-code
      305                                 ,p-curr-code
      306                                 ,p-host-code
      307                                 ,(p-obj-type + string(p-obj-code))
      308                                 ,p-pos-type
      309                                 ,entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u)
      310                                 ,chr(10)
      311                                 ,p-rule-num)
      312                             +
      313                             substitute("Правило скидки &1 определено для &1&2" +
      314                                        "а привязка к ДК для &3"
      315                                        ,get-region( buf_Dis-rule.host-code, buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
      316                                        ,chr(10)
      317                                        ,get-region( p-host-code, p-obj-type, p-obj-code)
      318                                        ))
      319                                 .
      320       end.
      321       find first buf_dis-cp-rule exclusive-lock where
      322                  buf_dis-cp-rule.cdpay-code  = p-cdpay-code
      323              AND buf_dis-cp-rule.curr-code  = p-curr-code
      324              AND buf_dis-cp-rule.obj-type  = p-obj-type
      325              AND buf_dis-cp-rule.host-code = p-host-code
      326              AND buf_dis-cp-rule.obj-code  = p-obj-code
      327              AND buf_dis-cp-rule.pos-type  = p-pos-type
      328              AND buf_dis-cp-rule.discnt-role = p-discnt-role
      329              and buf_dis-cp-rule.nonunique = p-nonunique
      330              no-error .
      331       if not available buf_dis-cp-rule then do:
      332         create buf_dis-cp-rule .
      333         assign
      334         buf_dis-cp-rule.cdpay-code  = p-cdpay-code
      335         buf_dis-cp-rule.curr-code  = p-curr-code
      336         buf_dis-cp-rule.host-code  = p-host-code
      337         buf_dis-cp-rule.obj-type  = p-obj-type
      338         buf_dis-cp-rule.obj-code  = p-obj-code
      339         buf_dis-cp-rule.pos-type = p-pos-type
      340         buf_dis-cp-rule.discnt-role = v-discnt-role
      341         buf_dis-cp-rule.rule-num = p-rule-num
      342         buf_dis-cp-rule.nonunique = p-nonunique
      343         no-error
      344         .
      345       end.
      346       ASSIGN
      347       buf_dis-cp-rule.rule-num = p-rule-num
      348       buf_dis-cp-rule.rl-root = buf_Dis-rule.rl-root
      349       buf_dis-cp-rule.templ-rl-root = p-templ-rl-root
      350       buf_dis-cp-rule.time-templ-rl-root = p-time-templ-rl-root
      351       buf_dis-cp-rule.nonunique = p-nonunique
      352       no-error.
      353     end.
      354   end procedure.
      355   procedure discpru-delete :
      356   define input parameter p-cdpay-code     like ub.dis-cp-rule.cdpay-code  no-undo .
      357   define input parameter p-curr-code      like ub.dis-cp-rule.curr-code  no-undo .
      358   define input parameter p-host-code      like ub.dis-cp-rule.host-code   no-undo .
      359   define input parameter p-obj-type       like ub.dis-cp-rule.obj-type   no-undo .
      360   define input parameter p-obj-code       like ub.dis-cp-rule.obj-code   no-undo .
      361   define input parameter p-pos-type       like ub.dis-cp-rule.pos-type   no-undo .
      362   define input parameter p-discnt-role    like ub.dis-cp-rule.discnt-role no-undo .
      363   define input parameter p-nonunique      like ub.dis-cp-rule.nonunique   no-undo .
      364   define output parameter p-deleted       as logical no-undo .
      365   define variable v-rule-label as character no-undo .
      366   define buffer buf_dis-cp-rule for ub.dis-cp-rule.
      367   do
      368   on error undo, return error
      369   :
      370   find first buf_dis-cp-rule exclusive-lock where
      371               buf_dis-cp-rule.cdpay-code  = p-cdpay-code
      372           AND buf_dis-cp-rule.curr-code  = p-curr-code
      373           AND buf_dis-cp-rule.obj-type  = p-obj-type
      374           AND buf_dis-cp-rule.host-code = p-host-code
      375           AND buf_dis-cp-rule.obj-code  = p-obj-code
      376           AND buf_dis-cp-rule.pos-type  = p-pos-type
      377           AND buf_dis-cp-rule.discnt-role = p-discnt-role
      378           and buf_dis-cp-rule.nonunique = p-nonunique
      379           no-error .
      380   if not available buf_dis-cp-rule then do:
      381     return '':U.
      382   end.
      383   delete buf_dis-cp-rule no-error.
      384   if error-status:error then do:
      385     run discpru-name in this-procedure
      386       (input  buf_dis-cp-rule.templ-rl-root
      387       ,output v-rule-label
      388       ) no-error .
      389     undo, return error substitute("Ошибка при удалении скидки по типу касс. платежа:&1" +
      390                                  "скидка &2 (POS &3) на фирме &4 &5&6 для платежа&1&7&1&8"
      391                                   ,chr(10)
      392                                   ,v-rule-label
      393                                   ,p-pos-type
      394                                   ,p-host-code
      395                                   ,p-obj-type
      396                                   ,p-obj-code
      397                                   ,error-status:get-message(1)
      398                                   ,return-value ).
      399   end.
      400   p-deleted = yes.
      401   return '':U.
      402   end.
      403   end procedure.
      404   procedure discpru-edit :
      405   define input parameter p-mode as character no-undo .
      406   define input parameter p-cdpay-code   like ub.dis-cp-rule.cdpay-code no-undo .
      407   define input parameter p-curr-code   like ub.dis-cp-rule.curr-code no-undo .
      408   define input parameter p-host-code like ub.dis-cp-rule.host-code no-undo .
      409   define input parameter p-obj-type like ub.dis-cp-rule.obj-type no-undo .
      410   define input parameter p-obj-code like ub.dis-cp-rule.obj-code no-undo .
      411   define input parameter p-pos-type like ub.dis-cp-rule.pos-type no-undo .
      412   define input parameter p-discnt-role    like ub.dis-cp-rule.discnt-role no-undo .
      413   define input parameter p-templ-rl-root like ub.dis-cp-rule.templ-rl-root no-undo .
      414   define input parameter p-time-templ-rl-root like ub.dis-cp-rule.time-templ-rl-root no-undo .
      415   define input parameter p-cfg-NONUNIQUE as character no-undo .
      416   define input parameter p-check as integer no-undo .
      417   define input-output parameter p-rule-num as integer no-undo .
      418   define input-output parameter p-nonunique as character no-undo .
      419   define output parameter p-setted as logical no-undo .
      420   DEFINE VARIABLE v-value as character no-undo .
      421   define variable v-sts as integer no-undo .
      422   define variable v-rid-list as character no-undo .
      423   DEFINE VARIABLE v-rule-num as integer no-undo .
      424   define variable v-cd-dr-correct  as logical no-undo .
      425   define variable jj as integer no-undo .
      426   define variable conf-par as character no-undo .
      427   define variable conf-attr as character no-undo .
      428   define variable par-type as character no-undo .
      429   define variable dflt-cd as character no-undo .
      430   define variable v-cd-list as character no-undo .
      431   define variable v-is-time-rule as logical no-undo .
      432   define variable v-label as character no-undo .
      433   define variable v-nonunique as character no-undo .
      434   define variable v-mode as character no-undo .
      435   define buffer buf_dis-rule for ub.dis-rule.
      436   define buffer buf_dis-time-rule for ub.dis-time-rule .
      437   define buffer term_dis-rule for ub.dis-rule.
      438   define buffer buf_dis-cp-rule for ub.dis-cp-rule.
      439   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      440   define buffer buf_temp-cpdisc for temp-cpdisc.
      441   assign
      442   v-rule-num = p-rule-num.
      443   v-sts = integer('0':U).
      444   if v-rule-num <> 0
      445   and v-rule-num <> ?
      446   then do:
      447     find first buf_dis-rule no-lock where
      448               buf_dis-rule.rule-num = v-rule-num no-error .
      449     if error-status:error then do:
      450       message
      451       "Ошибка при поиске правила с номером" v-rule-num
      452       view-as alert-box error .
      453       return .
      454     end.
      455     assign
      456     v-rid-list = string(recid(buf_dis-rule))
      457     .
      458   end.
      459     run discpru-name in this-procedure (
      460                                   input p-templ-rl-root
      461                                   ,output v-label) no-error.
      462   if p-pos-type = ?
      463   or p-pos-type = '':U then do:
      464   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      465   define variable v-param-type6 as character no-undo .
      466   define variable v-value-date6 as date no-undo .
      467   define variable v-value-decimal6 as decimal no-undo .
      468   define variable v-value-integer6 as INTEGER no-undo .
      469   define variable v-value-logical6 AS LOGICAL no-undo .
      470   define variable v-tth6 as handle no-undo .
      471   run adm/shattri.p (
      472       input "get":U
      473       ,input  p-obj-type
      474       ,input  p-obj-code
      475       ,input  'cd-sending':U
      476       ,input  'dflt-cd':U
      477       ,output dflt-cd
      478       ,output v-value-date6
      479       ,output v-value-decimal6
      480       ,output v-value-integer6
      481       ,output v-value-logical6
      482       ,output v-param-type6
      483       ,INPUT-OUTPUT table-handle v-tth6
      484       )  .
      485   delete object v-tth6 no-error.
      486   end.
      487   else do:
      488     dflt-cd = p-pos-type.
      489   end.
      490   v-mode =  'dis-cp-rule':U + "=" + p-discnt-role + "=" + (if p-host-code = 0
      491                                                                then "global"
      492                                                                else (if p-obj-type = ''
      493                                                                     then "host"
      494                                                                     else "object")
      495                                                                ) .
      496   run ref/dis-ruls.w (
      497               input parparentproc
      498               ,input p-host-code
      499               ,input p-obj-type
      500               ,input p-obj-code
      501               ,input "b-add,b-sel":U
      502               ,input "upper-rule-num-object":u
      503               ,input p-templ-rl-root
      504               ,input p-time-templ-rl-root
      505               ,input 0
      506               ,input-output v-sts
      507               ,input-output v-rid-list ) no-error .
      508   do
      509   on error undo, return error return-value
      510   :
      511     if v-rid-list <> "":U then do:
      512       find first buf_dis-rule exclusive-lock where
      513                   recid(buf_dis-rule) = integer(v-rid-list) no-wait no-error .
      514       if not available buf_dis-rule
      515       then do:
      516         message
      517         "Ошибка при поиске правила с recid" v-rid-list
      518         view-as alert-box error .
      519         return .
      520       end.
      521       if buf_dis-rule.sts <> integer('0':U) then do:
      522         message
      523         "Правило скидки имеет статус" entry (lookup (string(buf_dis-rule.sts), '0,1,2,99,98':U), 'исп,не-исп,детализ,удаление,запр.удал':U) skip
      524         "Нельзя привязать к нему скидку на платеж"
      525         view-as alert-box error .
      526         return .
      527       end.
      528       find first buf_dis-cfg-rule no-lock where
      529               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      530           and buf_dis-cfg-rule.time-templ-rl-root = (if buf_dis-rule.time-templ-rl-root = -1
      531                                                      then 0
      532                                                      else buf_dis-rule.time-templ-rl-root)
      533           and buf_dis-cfg-rule.table-name = 'dis-cp-rule':U
      534           and buf_dis-cfg-rule.pos-type = dflt-cd no-error.
      535       if available buf_dis-cfg-rule then do:
      536         assign
      537         v-cd-dr-correct = yes
      538         .
      539       end.
      540       if not v-cd-dr-correct
      541       then do:
      542         message
      543         substitute("Правило скидки &1 неприменимо для касс &2.&3" +
      544                   "(АРМ АДМИНИСТРАТОР-Магазины(Фирмы)-Параметры-Общие опции коммуникации с кассами)"
      545                   ,buf_dis-rule.rule-num
      546                   ,dflt-cd
      547                   ,chr(10)
      548                   )
      549         view-as alert-box error .
      550         undo, return error .
      551       end.
      552      assign
      553       v-nonunique = if p-cfg-nonunique = '':U
      554                     then '':U
      555                     else string(buffer buf_Dis-rule:handle:buffer-field(p-cfg-nonunique):buffer-value).
      556       if p-check = 0
      557       or p-check = 2
      558       then do:
      559         find first buf_dis-cp-rule no-lock where
      560                    buf_dis-cp-rule.host-code = p-host-code
      561                 and buf_dis-cp-rule.obj-type = p-obj-type
      562                 and buf_dis-cp-rule.obj-code = p-obj-code
      563                 and buf_dis-cp-rule.curr-code = p-curr-code
      564                 and buf_dis-cp-rule.cdpay-code = p-cdpay-code
      565                 and buf_dis-cp-rule.pos-type = p-pos-type
      566                 and buf_dis-cp-rule.discnt-role = p-discnt-role
      567                 and buf_dis-cp-rule.nonunique = v-nonunique no-error .
      568         if available buf_dis-cp-rule
      569         and p-mode <> 'ИЗМЕНЕНИЕ':U
      570         then do:
      571           message
      572           "Скидка такого типа на данный тип платежа уже существует"
      573           view-as alert-box error .
      574           return error.
      575         end.
      576       end.
      577       if p-check = 1
      578       or p-check = 2
      579       then do:
      580         find first buf_temp-cpdisc no-lock where
      581                    buf_temp-cpdisc.host-code = p-host-code
      582                 and buf_temp-cpdisc.obj-type = p-obj-type
      583                 and buf_temp-cpdisc.obj-code = p-obj-code
      584                 and buf_temp-cpdisc.cdpay-code = p-cdpay-code
      585                 and buf_temp-cpdisc.curr-code = p-curr-code
      586                 and buf_temp-cpdisc.pos-type = p-pos-type
      587                 and buf_temp-cpdisc.discnt-role = p-discnt-role
      588                 and buf_temp-cpdisc.nonunique = v-nonunique no-error .
      589         if available buf_temp-cpdisc
      590         and buf_temp-cpdisc.rule-num <> 0
      591         and p-mode <> 'ИЗМЕНЕНИЕ':U
      592         then do:
      593           message
      594         "Скидка такого типа на данный тип платежа уже существует"
      595           view-as alert-box error .
      596           return error.
      597         end.
      598       end.
      599       if p-rule-num <> buf_dis-rule.rule-num then do:
      600         assign
      601         p-setted = yes
      602         p-rule-num = buf_dis-rule.rule-num
      603         p-nonunique = v-nonunique
      604         .
      605       end.
      606     end.
      607   end.
      608   end procedure.
      609   procedure proc-alt-shift-f2:
      610     if not ibs.th.gbl.gbl-var:rcode
      611   then
      612     run gbl\inidebug.p .
      613   end.
      614   procedure proc-alt-shift-f3:
      615     run gbl/prvssinf.p
      616       ( input this-procedure
      617       ) .
      618   end.
      619   define variable v-inform-launched as logical no-undo initial false .
      620   procedure proc-alt-shift-f4:
      621     define variable v-action as character no-undo .
      622     if v-inform-launched = false then do:
      623       assign
      624         v-inform-launched = true
      625       .
      626       run gbl/d-inform.w
      627         (  input self
      628         ,  input this-procedure
      629         , output v-action
      630         ) no-error .
      631       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      632       assign
      633         v-inform-launched = false
      634       .
      635     end.
      636   end.
      637   procedure proc-alt-f1:
      638     run gbl/corrhelp.p
      639       (input this-procedure
      640       ) .
      641   end .
      642   on alt-shift-f2 anywhere do:
      643     run proc-alt-shift-f2.
      644   end.
      645   on alt-shift-f3 anywhere do:
      646     run proc-alt-shift-f3 in this-procedure .
      647   end.
      648   on alt-shift-f4 anywhere do:
      649     run proc-alt-shift-f4 in this-procedure.
      650   end.
      651   on alt-f1 anywhere do:
      652     run proc-alt-f1 in this-procedure .
      653   end.
      654   define variable updated as logical no-undo.
      655   DEFINE VARIABLE added  as logical no-undo .
      656   define variable add-option as char no-undo.
      657   define variable temp-doc-rec as recid no-undo.
      658   DEFINE VARIABLE dflt-cd AS CHARACTER NO-UNDO.
      659   define variable v-tab-order as character no-undo .
      660   define variable loc-glob as logical no-undo .
      661   define variable loc-firm as logical no-undo .
      662   define variable loc-object as logical no-undo .
      663   DEFINE MENU MENU-b-ins
      664          MENU-ITEM m_pos-type     LABEL "m_pos-type"
      665          MENU-ITEM m_bo           LABEL "Бэкофис"      .
      666   DEFINE BUTTON b-chg
      667        LABEL "&Изменить":L
      668        SIZE 10 BY 1 TOOLTIP "Изменить скидку на платеж".
      669   DEFINE BUTTON b-del
      670        LABEL "&Удалить":L
      671        SIZE 10 BY 1 TOOLTIP "Удалить скидку на платеж".
      672   DEFINE BUTTON b-help
      673        LABEL "Помо&щь":L
      674        SIZE 3 BY 1.
      675   DEFINE BUTTON b-ins
      676        LABEL "&Добавить":L
      677        SIZE 10 BY 1 TOOLTIP "Добавить скидку на платеж".
      678   DEFINE BUTTON b-lkp
      679        LABEL "&Просмотр":L
      680        SIZE 10 BY 1 TOOLTIP "Просмотр скидки на платеж".
      681   DEFINE BUTTON b-quit AUTO-GO
      682        LABEL "&Выход ":L
      683        SIZE 10 BY 1 TOOLTIP "Выход из режима".
      684   DEFINE VARIABLE cd-cdpay-code AS INTEGER FORMAT ">>>9":U INITIAL 0
      685        LABEL "Код типа платежа"
      686         VIEW-AS TEXT
      687        SIZE 9.6 BY 1
      688        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      689   DEFINE VARIABLE cd-curr-code AS INTEGER FORMAT ">>9":U INITIAL 0
      690        LABEL "Код валюты"
      691         VIEW-AS TEXT
      692        SIZE 6 BY 1
      693        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      694   DEFINE VARIABLE v-obj-name AS CHARACTER FORMAT "X(256)":U
      695         VIEW-AS TEXT
      696        SIZE 55 BY 1
      697        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
      698   DEFINE QUERY BR-dis-cp FOR
      699         temp-cpdisc SCROLLING.
      700   DEFINE BROWSE BR-dis-cp
      701     QUERY BR-dis-cp DISPLAY
      702         temp-cpdisc.templ-rl-root COLUMN-LABEL "" FORMAT ">9":U
      703   discpru-get-disc-label(temp-cpdisc.templ-rl-root) COLUMN-LABEL "Тип скидки" FORMAT "X(50)":U
      704   get-region(temp-cpdisc.host-code, temp-cpdisc.obj-type, temp-cpdisc.obj-code) COLUMN-LABEL "Действует" FORMAT "X(12)":U
      705       WIDTH 13
      706   temp-cpdisc.rule-num COLUMN-LABEL "№ правила" FORMAT ">>>>>>>>9":U
      707   temp-cpdisc.rl-root COLUMN-LABEL "№ корн.!правила" FORMAT ">>>>>>>>9":U
      708   entry (lookup (temp-cpdisc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) FORMAT "X(20)":U COLUMN-LABEL "Место использ."
      709       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 15.33.
      710   DEFINE FRAME Dialog-Frame
      711        b-quit AT ROW 1 COL 1
      712        b-ins AT ROW 1 COL 21
      713        b-lkp AT ROW 1 COL 31
      714        b-chg AT ROW 1 COL 41
      715        b-del AT ROW 1 COL 51
      716        b-help AT ROW 1 COL 95
      717        BR-dis-cp AT ROW 4.47 COL 1
      718        v-obj-name AT ROW 2 COL 2.5 NO-LABEL
      719        cd-cdpay-code AT ROW 3.27 COL 2.5
      720        cd-curr-code AT ROW 3.27 COL 33.5
      721        SPACE(47.59) SKIP(15.69)
      722       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      723            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      724            TITLE "Скидки на платеж".
      725   ASSIGN
      726          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      727          FRAME Dialog-Frame:HIDDEN           = TRUE.
      728   ASSIGN
      729          b-ins:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-ins:HANDLE.
      730   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      731   DO:
      732     APPLY "END-ERROR":U TO SELF.
      733   END.
      734   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      735   DO:
      736     if not avail temp-cpdisc then return no-apply.
      737     run proc-add-chg in this-procedure ( input no, input temp-cpdisc.pos-type) no-error .
      738     if error-status:error then return no-apply.
      739     RUN init-proc in this-procedure .
      740   END.
      741   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      742   DO:
      743   define variable v-deleted as logical no-undo.
      744   define variable loc#log as logical no-undo .
      745   define variable v-rule-label as character no-undo .
      746     if not avail temp-cpdisc then return no-apply.
      747       run discpru-name in this-procedure
      748         (input  temp-cpdisc.templ-rl-root
      749         ,output v-rule-label
      750         ) no-error .
      751       if error-status :error then do:
      752         return no-apply .
      753       end.
      754     loc#log = no.
      755     message
      756     substitute("Вы уверены, что хотите удалить скидку &1 (POS &2) на фирме &3 &4&5 для платежа"
      757              ,v-rule-label
      758              ,entry (lookup (temp-cpdisc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      759              ,temp-cpdisc.host-code
      760              ,temp-cpdisc.obj-type
      761              ,temp-cpdisc.obj-code
      762              )
      763             view-as alert-box QUESTIOn buttons YES-NO update loc#log.
      764     if NOT loc#log then return no-apply.
      765     run discpru-delete in this-procedure(
      766                                      input p-cdpay-code
      767                                     ,input p-curr-code
      768                                     ,input temp-cpdisc.host-code
      769                                     ,input temp-cpdisc.obj-type
      770                                     ,input temp-cpdisc.obj-code
      771                                     ,input temp-cpdisc.pos-type
      772                                     ,input temp-cpdisc.discnt-role
      773                                     ,input temp-cpdisc.nonunique
      774                                     ,output v-deleted
      775                                     ) no-error .
      776     if error-status:error then do:
      777       return no-apply.
      778     end.
      779     delete temp-cpdisc.
      780     updated = yes.
      781     run init-proc in this-procedure .
      782   END.
      783   ON CHOOSE OF b-ins IN FRAME Dialog-Frame
      784   DO:
      785    if add-option = '':U then do:
      786          run gbl/pop-up.p ( input self:handle, input no) no-error.
      787     end.
      788     if add-option = '':U then return no-apply.
      789     run proc-add-chg in this-procedure ( input yes, input add-option ) no-error.
      790     if error-status:error then do:
      791       add-option = '':U.
      792       return no-apply.
      793     end.
      794     add-option = '':U.
      795   END.
      796   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      797   DO:
      798     IF not AVAILABLE temp-cpdisc then return no-apply.
      799     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
      800     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      801   END.
      802   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      803   DO:
      804   END.
      805   ON MOUSE-SELECT-DBLCLICK OF BR-dis-cp IN FRAME Dialog-Frame
      806   DO:
      807     IF not AVAILABLE temp-cpdisc then return no-apply.
      808     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
      809     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      810   END.
      811   ON RETURN OF BR-dis-cp IN FRAME Dialog-Frame
      812   DO:
      813     IF not AVAILABLE temp-cpdisc then return no-apply.
      814     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
      815     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      816   END.
      817   ON VALUE-CHANGED OF BR-dis-cp IN FRAME Dialog-Frame
      818   DO:
      819     IF v-cntxt-db-num > 0
      820     AND (temp-cpdisc.obj-type = 'орг':U
      821     OR temp-cpdisc.obj-type = '':U) THEN DO:
      822        DISABLE
      823        b-chg
      824        with FRAME Dialog-Frame.
      825     END.
      826     ELSE DO:
      827         enable
      828         b-chg WHEN (p-mode <> 'ПРОСМОТР':U)
      829         with FRAME Dialog-Frame.
      830     END.
      831   END.
      832   ON CHOOSE OF MENU-ITEM m_pos-type
      833   DO:
      834       add-option = dflt-cd.
      835     run proc-add-chg in this-procedure ( input yes, input add-option ) no-error.
      836     if error-status:error then do:
      837       add-option = '':U.
      838       return no-apply.
      839     end.
      840     add-option = '':U.
      841   END.
      842   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      843   on help of frame Dialog-Frame
      844   do:
      845     run gbl/app_help.p
      846       (input this-procedure :file-name
      847       ,input ''
      848       ,input ?
      849       ) no-error.
      850     if error-status :error then do:
      851       message
      852         "Ошибка при вызове помощи"
      853         error-status :get-message(1)
      854         view-as alert-box .
      855     end.
      856   end.
      857   run minbtn-set in this-procedure .
      858   on choose of b-help in frame Dialog-Frame
      859   do:
      860     apply "help":u to frame Dialog-Frame .
      861   end.
      862   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      863   procedure minbtn-set :
      864       do
      865           on error undo, return error return-value
      866           :
      867           define variable ii              as integer       no-undo .
      868           define variable fh              as widget-handle no-undo .
      869           define variable hh              as widget-handle no-undo .
      870           define variable v-h             as handle        extent 4 no-undo .
      871           define variable v-name-button   as character     no-undo .
      872           define variable v-help-old-x    as decimal       no-undo .
      873           define variable v-help-old-y    as decimal       no-undo .
      874           define variable v-help-old-size as decimal       no-undo .
      875           define variable v-frame-width   as decimal       no-undo .
      876           define variable jj              as integer       no-undo .
      877           do
      878               on error undo, return error
      879               :
      880               assign
      881                   v-frame-width = frame Dialog-Frame:width - 0.3
      882                   fh            = frame Dialog-Frame:first-child
      883                   hh            = fh:first-child
      884                   ii            = 1
      885                   .
      886               do while valid-handle(hh):
      887                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      888                   do:
      889                       case lc(hh:name) :
      890                           when "b-help" then
      891                               do:
      892                                   hh:load-image-up("cmp/b-help.bmp":u) .
      893                                   hh:load-image-down("cmp/b-help.bmp":u) .
      894                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      895                                   hh:TOOLTIP = "Помощь" .
      896                                   v-help-old-x = hh:column .
      897                                   v-help-old-y = hh:row    .
      898                                   v-help-old-size = hh:width .
      899                                   hh:width-chars = 2.5 .
      900                               end.
      901                           when "b-print" then
      902                               do:
      903                                   hh:load-image("cmp/b-print.bmp":u) .
      904                                   hh:TOOLTIP = "Печать" .
      905                                   v-h[ii] = hh:handle .
      906                                   ii = ii + 1 .
      907                                   hh:width-chars = 3 .
      908                               end.
      909                           when "b-history" or
      910                           when "b-hist" then
      911                               do:
      912                                   hh:load-image("cmp/b-hist.bmp":u) .
      913                                   hh:TOOLTIP = "История" .
      914                                   v-h[ii] = hh:handle .
      915                                   ii = ii + 1 .
      916                                   hh:width-chars = 3 .
      917                               end.
      918                           when "b-sch" then
      919                               do:
      920                                   hh:load-image("cmp/b-sch.bmp":u) .
      921                                   hh:TOOLTIP = "Установка Фильтра" .
      922                                   v-h[ii] = hh:handle .
      923                                   ii = ii + 1 .
      924                                   hh:width-chars = 3 .
      925                               end.
      926                           when "b-hist-user" then
      927                               do:
      928                                   hh:load-image("cmp/b-hist.bmp":u) .
      929                                   hh:TOOLTIP = "История пользователя" .
      930                                   ii = ii + 1 .
      931                               end.
      932                       end case.
      933                   end.
      934                   hh = hh:next-sibling.
      935               end.
      936               b-help:column = v-frame-width - b-help:width-chars.
      937               jj = 0.
      938               repeat ii = 4 to 1 by -1 :
      939                   if valid-handle (v-h[ii] ) then
      940                   do:
      941                       jj  = jj + 1 .
      942                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      943                       v-h[ii]:row    = v-help-old-y .
      944                   end.
      945               end.
      946           end.
      947       end.
      948   end procedure.
      949   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      950   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      951   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      952   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      953   define variable v-diasize-current-frame-width  as decimal   no-undo .
      954   define variable v-diasize-current-frame-height as decimal   no-undo .
      955   define variable v-diasize-change-size          as logical   no-undo .
      956   define variable v-diasize-resize-button        as handle    no-undo .
      957   define variable v-diasize-wndmax               as logical   no-undo .
      958   define variable v-diasize-wndstore             as logical   no-undo .
      959   define variable v-diasize-proc-name            as character no-undo .
      960   define variable v-diasize-browse-handle        as handle    no-undo .
      961   define variable v-diasize-browse-number        as integer   no-undo .
      962   define variable v-diasize-need-full-display    as logical   no-undo init false .
      963   define temp-table temp-diasize-handle no-undo
      964     field handle-value  as handle
      965     field save-position as decimal
      966     index xpk is primary unique handle-value
      967     .
      968   define temp-table temp-browse-handle no-undo
      969     field browse-type   as character
      970     field browse-number as integer
      971     field browse-handle as handle
      972     field original-size as decimal
      973     index xpk is primary unique browse-type browse-number
      974     index xie browse-type browse-handle
      975   .
      976   procedure diasize_change-height :
      977     define input  parameter p-change-value  as decimal   no-undo .
      978     define input  parameter p-move-resize   as logical   no-undo .
      979     define variable v-field-group-handle    as handle    no-undo .
      980     define variable v-object-handle         as handle    no-undo .
      981     define variable v-frame-height          as decimal   no-undo .
      982     define variable v-frame-virtual-height  as decimal   no-undo .
      983     define variable v-browse-height         as decimal   no-undo .
      984     define variable v-window-height         as decimal   no-undo .
      985     define variable v-window-virtual-height as decimal   no-undo .
      986     define variable v-change-sign           as integer   no-undo .
      987     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      988     define buffer buf_temp-browse-handle  for temp-browse-handle .
      989     if p-change-value > 0
      990     then do:
      991       if frame Dialog-Frame :height + p-change-value
      992           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      993       then do:
      994         assign
      995           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      996                           - (frame Dialog-Frame :height-chars)
      997         .
      998         if p-change-value <= 0
      999         then do:
     1000           run diasize_position-resize-button in this-procedure .
     1001           return .
     1002         end.
     1003       end.
     1004     end.
     1005     if p-change-value < 0
     1006     then do:
     1007       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1008       then do:
     1009         assign
     1010           p-change-value = v-diasize-orig-frame-height
     1011                          - (frame Dialog-Frame :height-chars)
     1012         .
     1013         if p-change-value >= 0
     1014         then do:
     1015           run diasize_position-resize-button in this-procedure .
     1016           return .
     1017         end.
     1018       end.
     1019     end.
     1020     if p-change-value >= 0
     1021     then do:
     1022       assign
     1023         v-change-sign = 1
     1024       .
     1025     end.
     1026     else do:
     1027       assign
     1028         v-change-sign = -1
     1029       .
     1030     end.
     1031     assign
     1032       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1033     .
     1034     if p-change-value = 0
     1035     then do:
     1036       run diasize_position-resize-button in this-procedure .
     1037       return .
     1038     end.
     1039     move_block:
     1040     do
     1041     on error undo move_block, retry move_block
     1042     :
     1043       if retry
     1044       then do:
     1045         do
     1046         on error undo move_block, leave move_block
     1047         :
     1048           if p-change-value > 0
     1049           then do:
     1050             for each buf_temp-diasize-handle
     1051             on error undo, next
     1052             :
     1053               assign
     1054                 v-object-handle = buf_temp-diasize-handle.handle-value
     1055               .
     1056               if v-object-handle <> v-diasize-resize-button
     1057               then do:
     1058                 assign
     1059                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1060                 .
     1061               end.
     1062             end.
     1063             assign
     1064               v-diasize-browse-handle :height = v-browse-height
     1065             .
     1066             for each buf_temp-browse-handle
     1067               where buf_temp-browse-handle.browse-type = 'height':u
     1068             on error undo, next
     1069             :
     1070               assign
     1071                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1072               .
     1073             end.
     1074             assign
     1075               frame Dialog-Frame :height = v-frame-height
     1076             .
     1077             if frame Dialog-Frame :scrollable = true
     1078             then do:
     1079               assign
     1080                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1081               .
     1082             end.
     1083             run diasize_position-resize-button in this-procedure .
     1084           end.
     1085           else do:
     1086             if frame Dialog-Frame :scrollable = true
     1087             then do:
     1088               assign
     1089                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1090               .
     1091             end.
     1092             assign
     1093               frame Dialog-Frame :height = v-frame-height
     1094             .
     1095             assign
     1096               v-diasize-browse-handle :height = v-browse-height
     1097             .
     1098             for each buf_temp-browse-handle
     1099               where buf_temp-browse-handle.browse-type = 'height':u
     1100             on error undo, next
     1101             :
     1102               assign
     1103                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1104               .
     1105             end.
     1106             for each buf_temp-diasize-handle
     1107             on error undo, next
     1108             :
     1109               assign
     1110                 v-object-handle = buf_temp-diasize-handle.handle-value
     1111               .
     1112               if v-object-handle <> v-diasize-resize-button
     1113               then do:
     1114                 assign
     1115                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1116                 .
     1117               end.
     1118             end.
     1119             run diasize_position-resize-button in this-procedure .
     1120           end.
     1121           assign
     1122             v-diasize-change-size = false
     1123           .
     1124           leave move_block .
     1125         end.
     1126       end.
     1127       assign
     1128         v-diasize-need-full-display = true
     1129       .
     1130       if v-diasize-change-size = false
     1131       then do:
     1132         assign
     1133           v-diasize-change-size = true
     1134         .
     1135       end.
     1136       else do:
     1137         return .
     1138       end.
     1139       assign
     1140         v-frame-height = frame Dialog-Frame :height
     1141         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1142         v-browse-height = v-diasize-browse-handle :height
     1143       .
     1144       for each buf_temp-browse-handle
     1145         where buf_temp-browse-handle.browse-type = 'height':u
     1146       :
     1147         assign
     1148           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1149         .
     1150       end.
     1151       for each buf_temp-diasize-handle
     1152       :
     1153         delete buf_temp-diasize-handle .
     1154       end.
     1155       assign
     1156         v-field-group-handle = frame Dialog-Frame :first-child
     1157       .
     1158       do while valid-handle(v-field-group-handle)
     1159       :
     1160         assign
     1161           v-object-handle = v-field-group-handle :first-child
     1162         .
     1163         do while valid-handle(v-object-handle)
     1164         :
     1165           if  v-object-handle <> v-diasize-browse-handle :handle
     1166           and can-query(v-object-handle, "row")
     1167           and can-query(v-object-handle, "height")
     1168           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1169           then do:
     1170             find first buf_temp-browse-handle
     1171               where buf_temp-browse-handle.browse-type   = 'height':u
     1172                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1173               no-error .
     1174             if available buf_temp-browse-handle
     1175             then do:
     1176             end.
     1177             else do:
     1178               create buf_temp-diasize-handle .
     1179               assign
     1180                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1181                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1182               .
     1183             end.
     1184           end.
     1185           assign
     1186             v-object-handle = v-object-handle :next-sibling
     1187           .
     1188         end.
     1189         assign
     1190           v-field-group-handle = v-field-group-handle :next-sibling
     1191         .
     1192       end.
     1193       do with frame Dialog-Frame
     1194       :
     1195         hide v-diasize-resize-button .
     1196         assign
     1197           v-diasize-resize-button :row    = 1
     1198           v-diasize-resize-button :column = 1
     1199         .
     1200       end.
     1201       if p-change-value > 0
     1202       then do:
     1203         if frame Dialog-Frame :scrollable = true
     1204         then do:
     1205           assign
     1206             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1207             no-error .
     1208           if error-status :error
     1209           or error-status :get-message(1) <> ""
     1210           then do:
     1211             undo move_block, retry move_block .
     1212           end.
     1213         end.
     1214         assign
     1215           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1216           no-error .
     1217         if error-status :error
     1218         or error-status :get-message(1) <> ""
     1219         then do:
     1220           undo move_block, retry move_block .
     1221         end.
     1222         assign
     1223           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1224           no-error .
     1225         if error-status :error
     1226         or error-status :get-message(1) <> ""
     1227         then do:
     1228           undo move_block, retry move_block .
     1229         end.
     1230         for each buf_temp-browse-handle
     1231           where buf_temp-browse-handle.browse-type = 'height':u
     1232         on error undo move_block, retry move_block
     1233         :
     1234           assign
     1235             buf_temp-browse-handle.browse-handle :height
     1236               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1237             no-error .
     1238           if error-status :error
     1239           or error-status :get-message(1) <> ""
     1240           then do:
     1241             undo move_block, retry move_block .
     1242           end.
     1243         end.
     1244         for each buf_temp-diasize-handle
     1245         on error undo move_block, retry move_block
     1246         :
     1247           assign
     1248             v-object-handle = buf_temp-diasize-handle.handle-value
     1249           .
     1250           if v-object-handle <> v-diasize-resize-button
     1251           then do:
     1252             assign
     1253               v-object-handle :row = v-object-handle :row + p-change-value
     1254               no-error .
     1255             if error-status :error
     1256             or error-status :get-message(1) <> ""
     1257             then do:
     1258               undo move_block, retry move_block .
     1259             end.
     1260           end.
     1261         end.
     1262       end.
     1263       else do:
     1264         for each buf_temp-diasize-handle
     1265         on error undo move_block, retry move_block
     1266         :
     1267           assign
     1268             v-object-handle = buf_temp-diasize-handle.handle-value
     1269           .
     1270           if v-object-handle <> v-diasize-resize-button
     1271           then do:
     1272             assign
     1273               v-object-handle :row = v-object-handle :row + p-change-value
     1274               no-error .
     1275             if error-status :error
     1276             or error-status :get-message(1) <> ""
     1277             then do:
     1278               undo move_block, retry move_block .
     1279             end.
     1280           end.
     1281         end.
     1282         assign
     1283           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1284           no-error .
     1285         if error-status :error
     1286         or error-status :get-message(1) <> ""
     1287         then do:
     1288           undo move_block, retry move_block .
     1289         end.
     1290         for each buf_temp-browse-handle
     1291           where buf_temp-browse-handle.browse-type = 'height':u
     1292         on error undo move_block, retry move_block
     1293         :
     1294           assign
     1295             buf_temp-browse-handle.browse-handle :height
     1296               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1297             no-error .
     1298           if error-status :error
     1299           or error-status :get-message(1) <> ""
     1300           then do:
     1301             undo move_block, retry move_block .
     1302           end.
     1303         end.
     1304         assign
     1305           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1306           no-error .
     1307         if error-status :error
     1308         or error-status :get-message(1) <> ""
     1309         then do:
     1310           undo move_block, retry move_block .
     1311         end.
     1312         if frame Dialog-Frame :scrollable = true
     1313         then do:
     1314           assign
     1315             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1316             no-error .
     1317           if error-status :error
     1318           or error-status :get-message(1) <> ""
     1319           then do:
     1320             undo move_block, retry move_block .
     1321           end.
     1322         end.
     1323       end.
     1324       if p-move-resize = true
     1325       then do:
     1326         run diasize_position-resize-button in this-procedure .
     1327       end.
     1328       if v-diasize-wndstore = true
     1329       then do:
     1330         if connected("ub") = true
     1331         then do:
     1332           define variable v-cntxt-db-num        as integer   no-undo .
     1333           define variable v-cntxt-userid        as character no-undo .
     1334           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1335                                             , OUTPUT v-cntxt-userid
     1336                                             ) .
     1337           run gbl/wndsizew.p
     1338             (input  v-cntxt-db-num
     1339             ,input  v-cntxt-userid
     1340             ,input  v-diasize-proc-name
     1341             ,input  'height':u
     1342             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1343             ) .
     1344         end.
     1345       end.
     1346     end.
     1347     assign
     1348       v-diasize-change-size = false
     1349     .
     1350   end procedure.
     1351   procedure diasize_set-height :
     1352     define input  parameter p-new-height  as decimal   no-undo .
     1353     define input  parameter p-move-resize as logical   no-undo .
     1354     do
     1355     on error undo, return error return-value
     1356     :
     1357       run diasize_change-height in this-procedure
     1358         (input  (p-new-height - frame Dialog-Frame :height)
     1359         ,input  p-move-resize
     1360         ) .
     1361     end.
     1362   end procedure.
     1363   procedure diasize_change-width :
     1364     define input  parameter p-change-value as decimal   no-undo .
     1365     define input  parameter p-move-resize  as logical   no-undo .
     1366     define variable v-field-group-handle   as handle    no-undo .
     1367     define variable v-object-handle        as handle    no-undo .
     1368     define variable v-frame-width          as decimal   no-undo .
     1369     define variable v-frame-virtual-width  as decimal   no-undo .
     1370     define variable v-browse-width         as decimal   no-undo .
     1371     define variable v-window-width         as decimal   no-undo .
     1372     define variable v-window-virtual-width as decimal   no-undo .
     1373     define variable v-change-sign          as integer   no-undo .
     1374     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1375     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1376     if p-change-value > 0
     1377     then do:
     1378       if frame Dialog-Frame :width + p-change-value >
     1379           session :width-chars
     1380       then do:
     1381         assign
     1382           p-change-value = session :width-chars - frame Dialog-Frame :width
     1383         .
     1384         if p-change-value <= 0
     1385         then do:
     1386           run diasize_position-resize-button in this-procedure .
     1387           return .
     1388         end.
     1389       end.
     1390     end.
     1391     if p-change-value < 0
     1392     then do:
     1393       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1394       then do:
     1395         assign
     1396           p-change-value = v-diasize-orig-frame-width
     1397                          - frame Dialog-Frame :width
     1398         .
     1399         if p-change-value >= 0
     1400         then do:
     1401           run diasize_position-resize-button in this-procedure .
     1402           return .
     1403         end.
     1404       end.
     1405     end.
     1406     if p-change-value >= 0
     1407     then do:
     1408       assign
     1409         v-change-sign = 1
     1410       .
     1411     end.
     1412     else do:
     1413       assign
     1414         v-change-sign = -1
     1415       .
     1416     end.
     1417     assign
     1418       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1419     .
     1420     if p-change-value = 0
     1421     then do:
     1422       run diasize_position-resize-button in this-procedure .
     1423       return .
     1424     end.
     1425     move_block:
     1426     do
     1427     on error undo move_block, leave move_block
     1428     :
     1429       if retry
     1430       then do:
     1431         do
     1432         on error undo move_block, leave move_block
     1433         :
     1434           if p-change-value > 0
     1435           then do:
     1436             for each buf_temp-diasize-handle
     1437             on error undo, next
     1438             :
     1439               assign
     1440                 v-object-handle = buf_temp-diasize-handle.handle-value
     1441               .
     1442               if v-object-handle <> v-diasize-resize-button
     1443               then do:
     1444                 assign
     1445                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1446                 .
     1447               end.
     1448             end.
     1449             assign
     1450               v-diasize-browse-handle :width = v-browse-width
     1451             .
     1452             for each buf_temp-browse-handle
     1453               where buf_temp-browse-handle.browse-type = 'width':u
     1454             on error undo, next
     1455             :
     1456               assign
     1457                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1458               .
     1459             end.
     1460             assign
     1461               frame Dialog-Frame :width = v-frame-width
     1462             .
     1463             if frame Dialog-Frame :scrollable = true
     1464             then do:
     1465               assign
     1466                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1467               .
     1468             end.
     1469             run diasize_position-resize-button in this-procedure .
     1470           end.
     1471           else do:
     1472             if frame Dialog-Frame :scrollable = true
     1473             then do:
     1474               assign
     1475                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1476               .
     1477             end.
     1478             assign
     1479               frame Dialog-Frame :width = v-frame-width
     1480             .
     1481             for each buf_temp-browse-handle
     1482               where buf_temp-browse-handle.browse-type = 'width':u
     1483             on error undo, next
     1484             :
     1485               assign
     1486                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1487               .
     1488             end.
     1489             assign
     1490               v-diasize-browse-handle :width = v-browse-width
     1491             .
     1492             for each buf_temp-diasize-handle
     1493             on error undo, next
     1494             :
     1495               assign
     1496                 v-object-handle = buf_temp-diasize-handle.handle-value
     1497               .
     1498               if v-object-handle <> v-diasize-resize-button
     1499               then do:
     1500                 assign
     1501                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1502                 .
     1503               end.
     1504             end.
     1505             run diasize_position-resize-button in this-procedure .
     1506           end.
     1507           assign
     1508             v-diasize-change-size = false
     1509           .
     1510           leave move_block .
     1511         end.
     1512       end.
     1513       assign
     1514         v-diasize-need-full-display = true
     1515       .
     1516       if v-diasize-change-size = false
     1517       then do:
     1518         assign
     1519           v-diasize-change-size = true
     1520         .
     1521       end.
     1522       else do:
     1523         return .
     1524       end.
     1525       assign
     1526         v-frame-width = frame Dialog-Frame :width
     1527         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1528         v-browse-width = v-diasize-browse-handle :width
     1529       .
     1530       for each buf_temp-browse-handle
     1531         where buf_temp-browse-handle.browse-type = 'width':u
     1532       :
     1533         assign
     1534           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1535         .
     1536       end.
     1537       for each buf_temp-diasize-handle
     1538       :
     1539         delete buf_temp-diasize-handle .
     1540       end.
     1541       assign
     1542         v-field-group-handle = frame Dialog-Frame :first-child
     1543       .
     1544       do while valid-handle(v-field-group-handle)
     1545       :
     1546         assign
     1547           v-object-handle = v-field-group-handle :first-child
     1548         .
     1549         do while valid-handle(v-object-handle)
     1550         :
     1551           if  v-object-handle <> v-diasize-browse-handle :handle
     1552           and v-object-handle <> v-diasize-resize-button
     1553           and can-query(v-object-handle, "row")
     1554           and can-query(v-object-handle, "height")
     1555           and ( v-object-handle :col + v-object-handle :width
     1556                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1557               )
     1558           then do:
     1559             find first buf_temp-browse-handle
     1560               where buf_temp-browse-handle.browse-type   = 'width':u
     1561                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1562               no-error .
     1563             if available buf_temp-browse-handle
     1564             then do:
     1565             end.
     1566             else do:
     1567               create buf_temp-diasize-handle .
     1568               assign
     1569                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1570                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1571               .
     1572             end.
     1573           end.
     1574           assign
     1575             v-object-handle = v-object-handle :next-sibling
     1576           .
     1577         end.
     1578         assign
     1579           v-field-group-handle = v-field-group-handle :next-sibling
     1580         .
     1581       end.
     1582       do with frame Dialog-Frame
     1583       :
     1584         hide v-diasize-resize-button .
     1585         v-diasize-resize-button :row = 1.
     1586         v-diasize-resize-button :column = 1.
     1587       end.
     1588       if p-change-value > 0
     1589       then do:
     1590         if frame Dialog-Frame :scrollable = true
     1591         then do:
     1592           assign
     1593             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1594             no-error .
     1595           if error-status :error
     1596           or error-status :get-message(1) <> ""
     1597           then do:
     1598             undo move_block, retry move_block.
     1599           end.
     1600         end.
     1601         assign
     1602           frame Dialog-Frame :width = v-frame-width + p-change-value
     1603           no-error .
     1604         if error-status :error
     1605         or error-status :get-message(1) <> ""
     1606         then do:
     1607           undo move_block, retry move_block.
     1608         end.
     1609         assign
     1610           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1611         no-error .
     1612         if error-status :error
     1613         or error-status :get-message(1) <> ""
     1614         then do:
     1615           undo move_block, retry move_block.
     1616         end.
     1617         for each buf_temp-browse-handle
     1618           where buf_temp-browse-handle.browse-type = 'width':u
     1619         on error undo move_block, retry move_block
     1620         :
     1621           assign
     1622             buf_temp-browse-handle.browse-handle :width
     1623               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1624             no-error .
     1625           if error-status :error
     1626           or error-status :get-message(1) <> ""
     1627           then do:
     1628             undo move_block, retry move_block .
     1629           end.
     1630         end.
     1631         for each buf_temp-diasize-handle
     1632         on error undo move_block, retry move_block
     1633         :
     1634           assign
     1635             v-object-handle = buf_temp-diasize-handle.handle-value
     1636           .
     1637           if v-object-handle <> v-diasize-resize-button
     1638           then do:
     1639             assign
     1640               v-object-handle :col = v-object-handle :col + p-change-value
     1641               no-error .
     1642             if error-status :error
     1643             or error-status :get-message(1) <> ""
     1644             then do:
     1645               undo move_block, retry move_block .
     1646             end.
     1647           end.
     1648         end.
     1649       end.
     1650       else do:
     1651         for each buf_temp-diasize-handle
     1652         on error undo move_block, retry move_block
     1653         :
     1654           assign
     1655             v-object-handle = buf_temp-diasize-handle.handle-value
     1656           .
     1657           if v-object-handle <> v-diasize-resize-button
     1658           then do:
     1659             assign
     1660               v-object-handle :col = v-object-handle :col + p-change-value
     1661               no-error .
     1662             if error-status :error
     1663             or error-status :get-message(1) <> ""
     1664             then do:
     1665               undo move_block, retry move_block .
     1666             end.
     1667           end.
     1668         end.
     1669         for each buf_temp-browse-handle
     1670           where buf_temp-browse-handle.browse-type = 'width':u
     1671         on error undo move_block, retry move_block
     1672         :
     1673           assign
     1674             buf_temp-browse-handle.browse-handle :width
     1675               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1676             no-error .
     1677           if error-status :error
     1678           or error-status :get-message(1) <> ""
     1679           then do:
     1680             undo move_block, retry move_block .
     1681           end.
     1682         end.
     1683         assign
     1684           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1685           no-error .
     1686         if error-status :error
     1687         or error-status :get-message(1) <> ""
     1688         then do:
     1689           undo move_block, retry move_block.
     1690         end.
     1691         assign
     1692           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1693         no-error .
     1694         if error-status :error
     1695         or error-status :get-message(1) <> ""
     1696         then do:
     1697           undo move_block, retry move_block.
     1698         end.
     1699         if frame Dialog-Frame :scrollable = true
     1700         then do:
     1701           assign
     1702             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1703           no-error .
     1704           if error-status :error
     1705           or error-status :get-message(1) <> ""
     1706           then do:
     1707             undo move_block, retry move_block.
     1708           end.
     1709         end.
     1710       end.
     1711       if p-move-resize
     1712       then do:
     1713         run diasize_position-resize-button in this-procedure .
     1714       end.
     1715       if v-diasize-wndstore = true
     1716       then do:
     1717         if connected("ub") = true
     1718         then do:
     1719           define variable v-cntxt-db-num        as integer   no-undo .
     1720           define variable v-cntxt-userid        as character no-undo .
     1721           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1722                                             , OUTPUT v-cntxt-userid
     1723                                             ) .
     1724           run gbl/wndsizew.p
     1725             (input  v-cntxt-db-num
     1726             ,input  v-cntxt-userid
     1727             ,input  v-diasize-proc-name
     1728             ,input  'width':u
     1729             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1730             ) .
     1731         end.
     1732       end.
     1733     end.
     1734     assign
     1735       v-diasize-change-size = false
     1736     .
     1737   end procedure.
     1738   procedure diasize_set-width :
     1739     define input  parameter p-new-width  as decimal   no-undo .
     1740     define input  parameter p-move-resize as logical   no-undo .
     1741     do
     1742     on error undo, return error return-value
     1743     :
     1744       run diasize_change-width in this-procedure
     1745         (input  (p-new-width - frame Dialog-Frame :width)
     1746         ,input  p-move-resize
     1747         ) .
     1748     end.
     1749   end procedure.
     1750   procedure diasize_position-resize-button :
     1751     do with frame Dialog-Frame
     1752     :
     1753       hide v-diasize-resize-button .
     1754       assign
     1755         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1756                     - 1
     1757                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1758         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1759                     - 1
     1760                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1761       .
     1762       view v-diasize-resize-button .
     1763     end.
     1764   end procedure.
     1765   on alt-right anywhere
     1766   do:
     1767     run diasize_change-width in this-procedure
     1768       (input 1
     1769       ,input true
     1770       ) .
     1771     return no-apply .
     1772   end.
     1773   on alt-left anywhere
     1774   do:
     1775     run diasize_change-width in this-procedure
     1776       (input -1
     1777       ,input true
     1778       ) .
     1779     return no-apply .
     1780   end.
     1781   on alt-down anywhere
     1782   do:
     1783     run diasize_change-height in this-procedure
     1784       (input 1
     1785       ,input true
     1786       ) .
     1787     return no-apply .
     1788   end.
     1789   on alt-up anywhere
     1790   do:
     1791     run diasize_change-height in this-procedure
     1792       (input -1
     1793       ,input true
     1794       ) .
     1795     return no-apply .
     1796   end.
     1797   on alt-enter of frame Dialog-Frame
     1798   do:
     1799     run diasize_maximize in this-procedure
     1800       (input  ?
     1801       ).
     1802     return no-apply .
     1803   end.
     1804   procedure diasize_end-move :
     1805     do
     1806     on error undo, return error return-value
     1807     :
     1808       define variable v-row-delta as decimal   no-undo .
     1809       define variable v-col-delta as decimal   no-undo .
     1810       define variable v-new-row as decimal   no-undo .
     1811       define variable v-new-col as decimal   no-undo .
     1812       assign
     1813         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1814         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1815       .
     1816       assign
     1817         v-row-delta = v-new-row - frame Dialog-Frame :height
     1818         v-col-delta = v-new-col - frame Dialog-Frame :width
     1819       .
     1820       run diasize_change-height in this-procedure
     1821         (input v-row-delta
     1822         ,input true
     1823         ) .
     1824       run diasize_change-width in this-procedure
     1825         (input v-col-delta
     1826         ,input true
     1827         ) .
     1828     end.
     1829   end procedure.
     1830   procedure diasize_maximize :
     1831     define input  parameter p-action as logical   no-undo .
     1832     do
     1833     on error undo, return error return-value
     1834     :
     1835       if p-action = ?
     1836       then do:
     1837         if v-diasize-need-maximize = true
     1838         then do:
     1839           assign
     1840             p-action = true
     1841           .
     1842         end.
     1843         else do:
     1844           assign
     1845             p-action = false
     1846           .
     1847         end.
     1848       end.
     1849       if p-action = true
     1850       then do:
     1851         run diasize_change-height in this-procedure
     1852           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1853               - frame Dialog-Frame :height-chars
     1854           ,input true
     1855           ) .
     1856         run diasize_change-width in this-procedure
     1857           (input session :width-chars
     1858               - frame Dialog-Frame :width-chars
     1859           ,input true
     1860           ) .
     1861         assign
     1862           v-diasize-need-maximize = false
     1863         .
     1864       end.
     1865       else do:
     1866         run diasize_change-width in this-procedure
     1867           (input v-diasize-orig-frame-width
     1868               - frame Dialog-Frame :width-chars
     1869           ,input true
     1870           ) .
     1871         run diasize_change-height in this-procedure
     1872           (input v-diasize-orig-frame-height
     1873               - frame Dialog-Frame :height-chars
     1874           ,input true
     1875           ) .
     1876         assign
     1877           v-diasize-need-maximize = true
     1878         .
     1879       end.
     1880     end.
     1881   end procedure.
     1882   procedure diasize_restore-orig-size :
     1883     do
     1884     on error undo, return error return-value
     1885     :
     1886       assign
     1887         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1888         v-diasize-current-frame-height = frame Dialog-Frame :height
     1889       .
     1890       run diasize_set-height in this-procedure
     1891         (input  v-diasize-orig-frame-height
     1892         ,input  true
     1893         ) .
     1894       run diasize_set-width in this-procedure
     1895         (input  v-diasize-orig-frame-width
     1896         ,input  true
     1897         ) .
     1898     end.
     1899   end procedure.
     1900   procedure diasize_restore-current-size :
     1901     do
     1902     on error undo, return error return-value
     1903     :
     1904       run diasize_set-height in this-procedure
     1905         (input  v-diasize-current-frame-height
     1906         ,input  true
     1907         ) .
     1908       run diasize_set-width in this-procedure
     1909         (input  v-diasize-current-frame-width
     1910         ,input  true
     1911         ) .
     1912     end.
     1913   end procedure.
     1914   procedure diasize_set-browse-handle :
     1915     define input  parameter p-browse-handle as handle   no-undo .
     1916     define buffer buf_temp-browse-handle for temp-browse-handle .
     1917     do
     1918     on error undo, return error return-value
     1919     :
     1920       assign
     1921         v-diasize-browse-handle = p-browse-handle
     1922       .
     1923       for each buf_temp-browse-handle
     1924       on error undo, return error return-value
     1925       :
     1926         delete buf_temp-browse-handle .
     1927       end.
     1928     end.
     1929   end procedure.
     1930   procedure diasize_add_browse :
     1931     define input  parameter p-browse-type   as character no-undo .
     1932     define input  parameter p-browse-handle as handle    no-undo .
     1933     define buffer buf_temp-browse-handle for temp-browse-handle .
     1934     do
     1935     on error undo, return error return-value
     1936     :
     1937       assign
     1938         v-diasize-browse-number = v-diasize-browse-number + 1
     1939       .
     1940       create buf_temp-browse-handle .
     1941       assign
     1942         buf_temp-browse-handle.browse-type   = p-browse-type
     1943         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1944         buf_temp-browse-handle.browse-handle = p-browse-handle
     1945       .
     1946     end.
     1947   end procedure.
     1948   procedure diasize_init :
     1949     define variable v-default-value    as logical   no-undo .
     1950     define variable v-restore-saved    as logical   no-undo .
     1951     define variable v-resize-value-str as character no-undo .
     1952     do
     1953     on error undo, return error return-value
     1954     :
     1955       do with frame Dialog-Frame
     1956       :
     1957         assign
     1958           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1959           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1960           v-diasize-browse-handle     = browse BR-dis-cp :handle
     1961         .
     1962         create button v-diasize-resize-button
     1963         assign
     1964           parent        = frame Dialog-Frame :first-child
     1965           label         = "s"
     1966           height-pixels = 16
     1967           width-pixels  = 16
     1968           visible       = true
     1969           sensitive     = true
     1970           movable       = true
     1971           triggers:
     1972             on end-move persistent run diasize_end-move in this-procedure .
     1973           end triggers.
     1974         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1975         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1976         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1977         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1978         assign
     1979           v-diasize-wndmax = false
     1980         .
     1981         if connected("ub") = true
     1982         then do:
     1983           define variable v-cntxt-db-num        as integer   no-undo .
     1984           define variable v-cntxt-userid        as character no-undo .
     1985           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1986                                             , OUTPUT v-cntxt-userid
     1987                                             ) .
     1988           run gbl/wndpar_r.p
     1989             (input  v-cntxt-db-num
     1990             ,input  v-cntxt-userid
     1991             ,input  'wndmax':U
     1992             ,output v-diasize-wndmax
     1993             ,output v-default-value
     1994             ) .
     1995         end.
     1996         assign
     1997           v-diasize-wndstore = false
     1998         .
     1999         if connected("ub") = true
     2000         then do:
     2001           run gbl/wndpar_r.p
     2002             (input  v-cntxt-db-num
     2003             ,input  v-cntxt-userid
     2004             ,input  'wndstore':U
     2005             ,output v-diasize-wndstore
     2006             ,output v-default-value
     2007             ) .
     2008         end.
     2009         assign
     2010           v-diasize-proc-name = entry(1, program-name(2), '.')
     2011         .
     2012         if v-diasize-wndstore = true
     2013         then do:
     2014           assign
     2015             v-restore-saved = false
     2016           .
     2017           if connected("ub") = true
     2018           then do:
     2019             run gbl/wndsizer.p
     2020               (input  v-cntxt-db-num
     2021               ,input  v-cntxt-userid
     2022               ,input  v-diasize-proc-name
     2023               ,input  'height':u
     2024               ,output v-resize-value-str
     2025               ) .
     2026             if v-resize-value-str <> '':U
     2027             then do:
     2028               run diasize_change-height in this-procedure
     2029                 (input  integer(v-resize-value-str)
     2030                 ,input  true
     2031                 ) .
     2032               assign
     2033                 v-restore-saved = true
     2034               .
     2035             end.
     2036           end.
     2037           if connected("ub") = true
     2038           then do:
     2039             run gbl/wndsizer.p
     2040               (input  v-cntxt-db-num
     2041               ,input  v-cntxt-userid
     2042               ,input  v-diasize-proc-name
     2043               ,input  'width':u
     2044               ,output v-resize-value-str
     2045               ) .
     2046             if v-resize-value-str <> '':U
     2047             then do:
     2048               run diasize_change-width in this-procedure
     2049                 (input  integer(v-resize-value-str)
     2050                 ,input  true
     2051                 ) .
     2052               assign
     2053                 v-restore-saved = true
     2054               .
     2055             end.
     2056           end.
     2057           if v-restore-saved <> true
     2058           then do:
     2059             if v-diasize-wndmax = true
     2060             then do:
     2061               run diasize_maximize in this-procedure
     2062                 (input  true
     2063                 ) .
     2064             end.
     2065           end.
     2066         end.
     2067         else do:
     2068           if v-diasize-wndmax = true
     2069           then do:
     2070             run diasize_maximize in this-procedure
     2071               (input  true
     2072               ) .
     2073           end.
     2074         end.
     2075       end.
     2076     end.
     2077   end procedure.
     2078   procedure diasize_need-full-display :
     2079     define output parameter p-need-full-display as logical   no-undo .
     2080     do
     2081     on error undo, return error return-value
     2082     :
     2083       assign
     2084         p-need-full-display = v-diasize-need-full-display
     2085       .
     2086       assign
     2087         v-diasize-need-full-display = false
     2088       .
     2089     end.
     2090   end procedure.
     2091   procedure get-context :
     2092      define output parameter p-db-num as integer          no-undo.
     2093      define output parameter p-user-id as character        no-undo.
     2094      define variable v-login               as character    no-undo.
     2095      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2096      define buffer buf_user-login  for ub.user-login .
     2097      do
     2098      on error undo, return error
     2099      :
     2100            FIND FIRST buf_sys-ctrl no-lock.
     2101            ASSIGN
     2102               v-login = USERID("ub")
     2103               p-db-num = buf_sys-ctrl.db-num
     2104            .
     2105            FIND FIRST buf_user-login
     2106                 WHERE buf_user-login.db-num = p-db-num
     2107                   AND buf_user-login.user-login = v-login
     2108                 no-lock
     2109                 no-error
     2110                 .
     2111            IF AVAILABLE buf_user-login
     2112            THEN DO:
     2113               assign
     2114                  p-user-id = buf_user-login.user-id
     2115               .
     2116            END.
     2117      end.
     2118   end procedure.
     2119       run diasize_init in this-procedure .
     2120    frame Dialog-Frame:TITLE = frame Dialog-Frame:TITLE.
     2121   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2122   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2123   MAIN-BLOCK:
     2124   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2125      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2126   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2127     run mainmenu_getcntxt in parparentproc
     2128       (output v-cntxt-db-num
     2129       ,output v-cntxt-userid
     2130       ,output v-cntxt-level
     2131       ,output v-cntxt-host-code-obj
     2132       ,output v-cntxt-obj-type
     2133       ,output v-cntxt-obj-code
     2134       ,output v-cntxt-db-num-obj
     2135       ,output v-cntxt-is-admin
     2136       ) .
     2137     if v-cntxt-db-num = 0 then do:
     2138   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2139   do:
     2140     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2141       (input  v-cntxt-db-num
     2142       ,input  v-cntxt-userid
     2143       ,input  0
     2144       ,input  'actn_сp-discount_global_work':U
     2145       ,input  'global':U
     2146       ,input  0
     2147       ,input  '':U
     2148       ,input  0
     2149       ,input  0
     2150       ,input  0
     2151       ,input  0
     2152       ,input  false
     2153       ,output loc-glob
     2154       )  .
     2155   end.
     2156   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2157   do:
     2158     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2159       (input  v-cntxt-db-num
     2160       ,input  v-cntxt-userid
     2161       ,input  0
     2162       ,input  'actn_cp-discount_firm_work':U
     2163       ,input  'firm':U
     2164       ,input  p-host-code
     2165       ,input  '':U
     2166       ,input  0
     2167       ,input  0
     2168       ,input  0
     2169       ,input  0
     2170       ,input  false
     2171       ,output loc-firm
     2172       )  .
     2173   end.
     2174      end.
     2175   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2176   do:
     2177     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2178       (input  v-cntxt-db-num
     2179       ,input  v-cntxt-userid
     2180       ,input  0
     2181       ,input  'actn_cp-discount_object_work':U
     2182       ,input  'object':U
     2183       ,input  p-host-code
     2184       ,input  p-obj-type
     2185       ,input  p-obj-code
     2186       ,input  0
     2187       ,input  0
     2188       ,input  0
     2189       ,input  false
     2190       ,output loc-object
     2191       )  .
     2192   end.
     2193     if ((if v-cntxt-db-num = 0 and loc-glob then 1 else 0) +
     2194     (if v-cntxt-db-num = 0 and loc-firm then 1 else 0) +
     2195     (if loc-object then 1 else 0)) = 0 then do:
     2196       message
     2197       "У Вас отсутствуют права на назначение скидки на тип платежа как по объекту, так и по фирме и глобально" skip
     2198       "либо Вы находитесь в БД, в которой их назначить невозможно"
     2199       view-as alert-box error .
     2200       undo, return.
     2201     end.
     2202     RUN MyEnable in this-procedure no-error.
     2203     if error-status:error then return error.
     2204     Run init-proc in this-procedure .
     2205     view frame Dialog-Frame .
     2206     WAIT-FOR GO OF FRAME Dialog-Frame.
     2207   END.
     2208   RUN disable_UI in this-procedure .
     2209   if updated then return 'ИЗМЕНЕНИЕ':U.
     2210   PROCEDURE disable_UI :
     2211     HIDE FRAME Dialog-Frame.
     2212   END PROCEDURE.
     2213   PROCEDURE enable_UI :
     2214     DISPLAY v-obj-name cd-cdpay-code cd-curr-code
     2215         WITH FRAME Dialog-Frame.
     2216     ENABLE b-quit b-ins b-lkp b-chg b-del b-help v-obj-name cd-cdpay-code
     2217            cd-curr-code
     2218         WITH FRAME Dialog-Frame.
     2219     VIEW FRAME Dialog-Frame.
     2220     OPEN QUERY BR-dis-cp FOR EACH temp-cpdisc NO-LOCK.
     2221   END PROCEDURE.
     2222   PROCEDURE init-proc :
     2223   define variable v-rule-label as character no-undo .
     2224   define buffer buf_cash-pay for ub.cash-pay.
     2225   define buffer buf_dis-cp-rule for ub.dis-cp-rule.
     2226   for each temp-cpdisc:
     2227     if p-mode = 'ИЗМЕНЕНИЕ':U
     2228     and (temp-cpdisc.obj-type = p-obj-type
     2229       and
     2230       temp-cpdisc.obj-code = p-obj-code)
     2231     or (v-cntxt-db-num = 0
     2232       and temp-cpdisc.obj-type = '':U
     2233       and
     2234       temp-cpdisc.obj-code = 0)
     2235     or (v-cntxt-db-num = 0
     2236       and temp-cpdisc.obj-type = 'орг':U
     2237       and temp-cpdisc.obj-code = p-host-code)
     2238       then do:
     2239     end.
     2240     else do:
     2241       delete temp-cpdisc.
     2242     end.
     2243   end.
     2244   add-option = "".
     2245   find first buf_cash-pay where
     2246           buf_cash-pay.cdpay-code =  p-cdpay-code
     2247       AND buf_cash-pay.curr-code = p-curr-code   no-lock no-error .
     2248   Assign
     2249   cd-cdpay-code = buf_cash-pay.cdpay-code
     2250   cd-curr-code = buf_cash-pay.curr-code
     2251   .
     2252   display
     2253   cd-cdpay-code
     2254   cd-curr-code
     2255   with frame Dialog-Frame  .
     2256   For each buf_dis-cp-rule where
     2257           buf_dis-cp-rule.cdpay-code  = p-cdpay-code
     2258       and  buf_dis-cp-rule.curr-code  = p-curr-code no-lock
     2259   on error undo, return error
     2260       :
     2261     find first temp-cpdisc where
     2262               temp-cpdisc.cdpay-code = buf_dis-cp-rule.cdpay-code
     2263          and  temp-cpdisc.curr-code = buf_dis-cp-rule.curr-code
     2264          and  temp-cpdisc.host-code = buf_dis-cp-rule.host-code
     2265          and  temp-cpdisc.obj-type = buf_dis-cp-rule.obj-type
     2266          and  temp-cpdisc.obj-code = buf_dis-cp-rule.obj-code
     2267          and  temp-cpdisc.pos-type = buf_dis-cp-rule.pos-type
     2268          and  temp-cpdisc.discnt-role = buf_dis-cp-rule.discnt-role
     2269          and  temp-cpdisc.nonunique = buf_dis-cp-rule.nonunique no-error.
     2270     if not available temp-cpdisc then do:
     2271       create temp-cpdisc.
     2272       assign
     2273       temp-cpdisc.cdpay-code = buf_dis-cp-rule.cdpay-code
     2274       temp-cpdisc.curr-code = buf_dis-cp-rule.curr-code
     2275       temp-cpdisc.host-code = buf_dis-cp-rule.host-code
     2276       temp-cpdisc.obj-type = buf_dis-cp-rule.obj-type
     2277       temp-cpdisc.obj-code = buf_dis-cp-rule.obj-code
     2278       temp-cpdisc.pos-type = buf_dis-cp-rule.pos-type
     2279       temp-cpdisc.discnt-role = buf_dis-cp-rule.discnt-role
     2280       temp-cpdisc.nonunique = buf_dis-cp-rule.nonunique
     2281       .
     2282     end.
     2283     assign
     2284     temp-cpdisc.rule-num = buf_Dis-cp-rule.rule-num
     2285     temp-cpdisc.rl-root = buf_Dis-cp-rule.rl-root
     2286     temp-cpdisc.templ-rl-root = buf_Dis-cp-rule.templ-rl-root
     2287     temp-cpdisc.time-templ-rl-root = buf_Dis-cp-rule.time-templ-rl-root
     2288     .
     2289     run discpru-name ( input buf_dis-cp-rule.templ-rl-root
     2290                         ,output v-rule-label
     2291                           ).
     2292     assign
     2293     temp-cpdisc.rule-label = v-rule-label
     2294     .
     2295   End.
     2296   OPEN QUERY BR-dis-cp FOR EACH temp-cpdisc NO-LOCK.
     2297   END PROCEDURE.
     2298   PROCEDURE MyEnable :
     2299   DEFINE BUFFER buf_Cash-pay FOR ub.cash-pay.
     2300   DEFINE VARIABLE v-h AS WIDGET-HANDLE NO-UNDO.
     2301   v-h = br-dis-cp:FIRST-COLUMN IN FRAME Dialog-Frame.
     2302   DO while valid-handle(v-h) :
     2303     if v-h:LABEL = 'Тип скидки' then do:
     2304       v-h:RESIZABLE = YES.
     2305       leave.
     2306     end.
     2307     ELSE DO:
     2308       v-h = v-h:NEXT-COLUMN.
     2309     END.
     2310   END.
     2311   IF p-obj-type = 'маг':U THEN DO:
     2312   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2313   define variable v-param-type14 as character no-undo .
     2314   define variable v-value-date14 as date no-undo .
     2315   define variable v-value-decimal14 as decimal no-undo .
     2316   define variable v-value-integer14 as INTEGER no-undo .
     2317   define variable v-value-logical14 AS LOGICAL no-undo .
     2318   define variable v-tth14 as handle no-undo .
     2319   run adm/shattri.p (
     2320       input "get":U
     2321       ,input  p-obj-type
     2322       ,input  p-obj-code
     2323       ,input  'cd-sending':U
     2324       ,input  'dflt-cd':U
     2325       ,output dflt-cd
     2326       ,output v-value-date14
     2327       ,output v-value-decimal14
     2328       ,output v-value-integer14
     2329       ,output v-value-logical14
     2330       ,output v-param-type14
     2331       ,INPUT-OUTPUT table-handle v-tth14
     2332       )  .
     2333   delete object v-tth14 no-error.
     2334   END.
     2335   if p-obj-type = 'скл':U then do:
     2336     dflt-cd = '-':U.
     2337   end.
     2338   ASSIGN
     2339   b-ins:POPUP-MENU IN FRAME Dialog-Frame = MENU MENU-b-ins:HANDLE
     2340   b-ins:MENU-MOUSE = 1
     2341   MENU-ITEM m_pos-type:LABEL IN MENU menu-b-ins  = dflt-cd
     2342   MENU-ITEM m_pos-type:sensitive IN MENU menu-b-ins  = ((dflt-cd <> '':U) and (dflt-cd <> '-':U))
     2343   MENU-ITEM m_bo:sensitive IN MENU menu-b-ins  = no
     2344   .
     2345   assign
     2346   v-tab-order = "b-quit,b-ins,b-lkp,b-chg,b-del,b-help,br-dis-cp".
     2347   FIND FIRST buf_Cash-pay NO-LOCK WHERE
     2348               buf_Cash-pay.cdpay-code = p-cdpay-code
     2349         AND   buf_Cash-pay.curr-code = p-curr-code NO-ERROR.
     2350   IF AVAILABLE buf_cash-pay THEN DO:
     2351       ASSIGN
     2352       v-obj-name = buf_cash-pay.obj-name.
     2353   END.
     2354   ASSIGN b-ins:MENU-MOUSE in frame Dialog-Frame  = 1.
     2355   DISPLAY
     2356   v-obj-name
     2357   WITH FRAME Dialog-Frame .
     2358   ENABLE
     2359   b-quit
     2360   b-del when p-mode = 'ИЗМЕНЕНИЕ':U
     2361   b-ins when p-mode = 'ИЗМЕНЕНИЕ':U
     2362   b-chg when p-mode = 'ИЗМЕНЕНИЕ':U
     2363   b-lkp
     2364   b-help BR-dis-cp
     2365   WITH FRAME Dialog-Frame .
     2366   VIEW FRAME Dialog-Frame .
     2367   OPEN QUERY BR-dis-cp FOR EACH temp-cpdisc NO-LOCK.
     2368   APPLY "ENTRY" to br-dis-cp.
     2369   END PROCEDURE.
     2370   PROCEDURE proc-add-chg :
     2371   define input parameter p-add as logical no-undo .
     2372   define input parameter p-pos-type as character no-undo .
     2373   define variable v-rule-label as character no-undo .
     2374   DEFINE VARIABLE v-rule-num as integer no-undo .
     2375   define variable v-setted as logical no-undo .
     2376   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2377   define variable v-templ-rl-root as integer no-undo .
     2378   define variable v-time-templ-rl-root as integer no-undo .
     2379   define variable v-cfg-nonunique as character no-undo .
     2380   define variable v-nonunique as character no-undo .
     2381   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     2382   define buffer buf_dis-cp-rule for ub.dis-cp-rule.
     2383   define buffer buf_temp-cpdisc for temp-cpdisc.
     2384   DEFINE VARIABLE v-deleted as logical no-undo .
     2385   define variable v-check as character no-undo .
     2386   define variable v-error-code as character no-undo .
     2387   define variable v-correct as logical no-undo .
     2388   define variable v-host-code like ub.sysconf.host-code no-undo .
     2389   define variable v-obj-type like ub.clients.obj-type no-undo .
     2390   define variable v-obj-code like ub.clients.obj-code no-undo .
     2391   define variable v-ask-labels as character no-undo .
     2392   define variable choice as integer no-undo .
     2393   define variable v-discnt-role as character no-undo .
     2394   define var loc#log as logical no-undo.
     2395   CASE p-add:
     2396     when yes then do:
     2397       run ref/dis-pos.w ( INPUT parparentproc
     2398                           ,INPUT "b-sel":U
     2399                           ,INPUT "cd-type-list"
     2400                           ,INPUT (if v-cntxt-db-num = 0 and loc-glob  then 1 else 0)
     2401                           ,INPUT (if v-cntxt-db-num = 0 and loc-firm  then 1 else 0)
     2402                           ,INPUT (if loc-object then 1 else 0)
     2403                           ,input 'dis-cp-rule':U
     2404                           ,input '':U
     2405                           ,input ?
     2406                           ,INPUT p-pos-type
     2407                           ,input '':U
     2408                           ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2409      IF ERROR-STATUS:ERROR
     2410      OR v-rid-list = '':U THEN DO:
     2411         RETURN.
     2412      END.
     2413      FIND FIRST buf_dis-cfg-rule NO-LOCK where
     2414                recid(buf_dis-cfg-rule) = INTEGER(v-rid-list).
     2415       assign
     2416       v-templ-rl-root = buf_dis-cfg-rule.templ-rl-root
     2417       v-time-templ-rl-root = buf_dis-cfg-rule.time-templ-rl-root
     2418       V-cfg-NONUNIQUE = buf_dis-cfg-rule.nonunique
     2419       v-discnt-role = buf_dis-cfg-rule.discnt-role
     2420       .
     2421       assign
     2422       added = yes.
     2423       v-rule-num = 0.
     2424      if (buf_dis-cfg-rule.has-global +
     2425          buf_dis-cfg-rule.has-host +
     2426          buf_dis-cfg-rule.has-obj) > 1 then do:
     2427         define variable v-sel-vals as character no-undo .
     2428         define variable v-sel-labels as character no-undo .
     2429         define variable var-region as character no-undo .
     2430         assign
     2431         v-sel-vals = v-sel-vals +
     2432                       (if buf_dis-cfg-rule.has-global = 1
     2433                       then (fill(chr(32), 3)  + string(0) + chr(44))
     2434                       else "":U)
     2435         v-sel-labels = v-sel-labels +
     2436                       (if buf_dis-cfg-rule.has-global  = 1
     2437                       then ("Глобально" + chr(44))
     2438                       else "":U)
     2439         .
     2440         assign
     2441         v-sel-vals = v-sel-vals +
     2442                       (if buf_dis-cfg-rule.has-host = 1
     2443                       then ('орг':U  + string(v-cntxt-host-code-obj)  + chr(44))
     2444                       else "":U)
     2445         v-sel-labels = v-sel-labels +
     2446                       (if buf_dis-cfg-rule.has-host = 1
     2447                       then ("Фирма"  + string(v-cntxt-host-code-obj) + chr(44))
     2448                       else "":U)
     2449         .
     2450         assign
     2451         v-sel-vals = v-sel-vals +
     2452                       (if buf_dis-cfg-rule.has-obj = 1
     2453                       then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(44))
     2454                       else "":U)
     2455         v-sel-labels = v-sel-labels +
     2456                       (if buf_dis-cfg-rule.has-obj = 1
     2457                       then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(44))
     2458                       else "":U)
     2459         .
     2460         run gbl/d-list.w (
     2461                             input "b-sel":U
     2462                             ,input "Выберите область действия"
     2463                             ,input v-sel-vals
     2464                             ,input v-sel-labels
     2465                             ,input chr(44)
     2466                             ,input "":U
     2467                             ,output var-region) no-error.
     2468         if error-status:error then do:
     2469           return error.
     2470         end.
     2471         assign
     2472         v-obj-type = trim(substring(var-region, 1, 3))
     2473         v-obj-code = integer(substring(var-region, 4))
     2474         v-host-code = (if var-region begins 'орг':U
     2475                        then integer(substring(var-region, 4))
     2476                        else 0)
     2477         v-obj-code = (if v-obj-type = 'орг':U then 0 else v-obj-code)
     2478         v-obj-type = (if v-obj-type = 'орг':U then "" else v-obj-type)
     2479       .
     2480         if v-host-code = 0
     2481          and v-obj-type <> '':U then do:
     2482   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2483   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2484     (input  v-obj-type
     2485     ,input  v-obj-code
     2486     ,output v-host-code
     2487     )  .
     2488         end.
     2489       end.
     2490       else do:
     2491         if buf_dis-cfg-rule.has-obj = 1 then do:
     2492           assign
     2493           v-obj-type = p-obj-type
     2494           v-obj-code = p-obj-code
     2495           .
     2496   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2497   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2498     (input  p-obj-type
     2499     ,input  p-obj-code
     2500     ,output v-host-code
     2501     )  .
     2502         end.
     2503         if buf_dis-cfg-rule.has-host = 1 then do:
     2504   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2505   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2506     (input  p-obj-type
     2507     ,input  p-obj-code
     2508     ,output v-host-code
     2509     )  .
     2510           assign
     2511           v-obj-type = ""
     2512           v-obj-code = 0
     2513           .
     2514         end.
     2515         if buf_dis-cfg-rule.has-glob = 1 then do:
     2516           assign
     2517           v-host-code = 0
     2518           v-obj-type = '':U
     2519           v-obj-code = 0
     2520           .
     2521         end.
     2522       end.
     2523     end.
     2524     when no then do:
     2525           find first buf_dis-cfg-rule no-lock where
     2526                 buf_dis-cfg-rule.table-name = 'dis-cp-rule':U
     2527             and buf_dis-cfg-rule.discnt-role = temp-cpdisc.discnt-role
     2528             and buf_dis-cfg-rule.pos-type = temp-cpdisc.pos-type
     2529             no-error .
     2530       if available buf_dis-cfg-rule then do:
     2531         assign
     2532         v-nonunique = buf_dis-cfg-rule.nonunique.
     2533       end.
     2534       v-rule-num  = temp-cpdisc.rule-num.
     2535     end.
     2536   END CASE.
     2537   run discpru-edit in this-procedure (   input (if p-add then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     2538                                         ,input p-cdpay-code
     2539                                         ,input p-curr-code
     2540                                         ,input (if p-add then v-host-code else temp-cpdisc.host-code)
     2541                                         ,input (if p-add then v-obj-type  else temp-cpdisc.obj-type)
     2542                                         ,input (if p-add then v-obj-code  else temp-cpdisc.obj-code)
     2543                                         ,INPUT (if p-add then p-pos-type else temp-cpdisc.pos-type)
     2544                                         ,INPUT (if p-add then v-discnt-role else temp-cpdisc.discnt-role)
     2545                                         ,input (if p-add then v-templ-rl-root else temp-cpdisc.templ-rl-root)
     2546                                         ,input (if p-add then v-time-templ-rl-root else temp-cpdisc.time-templ-rl-root)
     2547                                         ,input v-cfg-nonunique
     2548                                         ,input 1
     2549                                         ,input-output v-rule-num
     2550                                         ,input-output v-nonunique
     2551                                         ,output v-setted ) no-error.
     2552   if not v-setted then return error.
     2553   run discpru-write in this-procedure (
     2554                                           input p-cdpay-code
     2555                                           ,input p-curr-code
     2556                                           ,input (if p-add then v-host-code else temp-cpdisc.host-code)
     2557                                           ,input (if p-add then v-obj-type else temp-cpdisc.obj-type)
     2558                                           ,input (if p-add then v-obj-code else temp-cpdisc.obj-code)
     2559                                           ,input (if p-add then add-option else temp-cpdisc.pos-type)
     2560                                           ,input (if p-add then v-discnt-role else temp-cpdisc.discnt-role)
     2561                                           ,input (if p-add then v-templ-rl-root else temp-cpdisc.templ-rl-root)
     2562                                           ,input (if p-add then v-time-templ-rl-root else temp-cpdisc.time-templ-rl-root)
     2563                                           ,input v-rule-num
     2564                                           ,input v-nonunique
     2565                                         ) no-error .
     2566     IF NOT error-status:error then do:
     2567         assign
     2568         updated = yes
     2569         .
     2570     END.
     2571   Run init-proc in this-procedure .
     2572   find first buf_temp-cpdisc no-lock where
     2573             buf_temp-cpdisc.host-code =  (if p-add then v-host-code else temp-cpdisc.host-code)
     2574         AND buf_temp-cpdisc.obj-type = (if p-add then v-obj-type else temp-cpdisc.obj-type)
     2575         AND buf_temp-cpdisc.obj-code = (if p-add then v-obj-code else temp-cpdisc.obj-code)
     2576         AND buf_temp-cpdisc.pos-type = (if p-add then add-option else temp-cpdisc.pos-type)
     2577         AND buf_temp-cpdisc.pos-type = (if p-add then add-option else temp-cpdisc.pos-type)
     2578         AND buf_temp-cpdisc.discnt-role = (if p-add then v-discnt-role else temp-cpdisc.discnt-role)
     2579         AND buf_temp-cpdisc.nonunique = (if p-add then v-nonunique else temp-cpdisc.nonunique)
     2580         no-error.
     2581   add-option = "":U.
     2582   if avail buf_temp-cpdisc then
     2583   temp-doc-rec = recid(buf_temp-cpdisc).
     2584   else temp-doc-rec = ?.
     2585   reposition BR-dis-cp to recid temp-doc-rec no-error.
     2586   if error-status:error then return no-apply.
     2587   END PROCEDURE.
     2588   PROCEDURE proc-b-lkp :
     2589   define variable disc-label as character no-undo .
     2590   run discpru-name in this-procedure (
     2591                                         input temp-cpdisc.templ-rl-root
     2592                                       , output disc-label
     2593                                   ) no-error.
     2594   IF ERROR-STATUS:ERROR THEN DO:
     2595       return error.
     2596   END.
     2597   run ref/show-dr.p ( input parparentproc
     2598                      ,input temp-cpdisc.rule-num) no-error.
     2599   END PROCEDURE.
