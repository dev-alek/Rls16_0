        1   BLOCK-LEVEL ON ERROR UNDO, THROW.
        2   define input parameter p-node-code  like ub.cli-grp.node-code .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Удаление группы клиентов из базы данных".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   define variable vss-include-info0 as character format "X(65)" no-undo
       68   initial "@(#)$Workfile$ $Revision$".
       69   define temp-table temp_cgrplib_grp no-undo
       70       field sel           as character
       71       field full-name     as character
       72       field sort-name     as character
       73       field node-code     as integer
       74       field upper-code    as integer
       75       field d-pcnt        as decimal
       76       field name          as character
       77       field level         as integer
       78       field mark          as character
       79       index pi is primary unique sort-name
       80       index fn full-name
       81       index nc is unique node-code
       82       index sl sel
       83       index uc upper-code
       84   .
       85   define temp-table temp_cgrplib_found-grp no-undo
       86       field full-name   as character
       87       field sort-name   as character
       88       field node-code   as integer
       89       field level       as integer
       90       field is-terminal as logical
       91       field d-pcnt      as decimal
       92       index pi is primary unique sort-name
       93       index fn full-name
       94       index lv level
       95       index it is-terminal
       96   .
       97   define temp-table temp_cfound-result-nodelist no-undo
       98       field node-code     as recid
       99       field processed     as logical
      100       field full-name     as character
      101       field sort-name     as character
      102       index pi is primary unique node-code
      103       index ps processed
      104   .
      105   procedure cli-grplib-get-sort-name :
      106   do
      107   on error undo, return error
      108   :
      109   define input parameter p-node-code  as integer      no-undo.
      110   define output parameter p-sort-name as character    no-undo.
      111       define variable v-upper-code    as integer           no-undo.
      112       define buffer buf_cli-grp       for ub.cli-grp.
      113       define buffer buf_upper_cli-grp for ub.cli-grp.
      114       find first buf_cli-grp no-lock
      115            where buf_cli-grp.node-code = p-node-code
      116       no-error.
      117       if not available buf_cli-grp
      118       then do:
      119           undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      120       end.
      121       assign
      122           p-sort-name  = ""
      123           v-upper-code = 1
      124       .
      125       do while buf_cli-grp.upper-code <> 0
      126       on error undo, return error "cli-grplib-get-sort-name: Ошибка составления полного имени группы"
      127       :
      128           assign
      129               p-sort-name  = buf_cli-grp.node-name
      130                            + (if p-sort-name <> "" then chr(2) else "")
      131                            + p-sort-name
      132               v-upper-code = buf_cli-grp.upper-code
      133           .
      134           find first buf_cli-grp no-lock
      135                where buf_cli-grp.node-code = v-upper-code
      136           no-error.
      137           if not available buf_cli-grp
      138           then do:
      139               undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом "
      140                                   + string( v-upper-code )
      141                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      142           end.
      143       end.
      144   end.
      145   end procedure.
      146   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      147   procedure cli-grplib-get-full-name :
      148      define input parameter  p-node-code  as integer      no-undo.
      149      define output parameter p-full-name as character    no-undo.
      150   do
      151   on error undo, return error
      152   :
      153       define variable v-upper-code    as integer           no-undo.
      154       define buffer buf_cli-grp       for ub.cli-grp.
      155       define buffer buf_upper_cli-grp for ub.cli-grp.
      156       find first buf_cli-grp no-lock
      157            where buf_cli-grp.node-code = p-node-code
      158       no-error.
      159       if not available buf_cli-grp
      160       then do:
      161           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      162       end.
      163       assign
      164           p-full-name  = ""
      165           v-upper-code = 1
      166       .
      167       do while buf_cli-grp.upper-code <> 0
      168       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      169       :
      170           assign
      171               p-full-name  = buf_cli-grp.node-name
      172                            + (if p-full-name <> "" then chr(47) else "")
      173                            + p-full-name
      174               v-upper-code = buf_cli-grp.upper-code
      175           .
      176           find first buf_cli-grp no-lock
      177                where buf_cli-grp.node-code = v-upper-code
      178           no-error.
      179           if not available buf_cli-grp
      180           then do:
      181               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
      182                                   + string( v-upper-code )
      183                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      184           end.
      185       end.
      186       assign
      187       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      188       .
      189   end.
      190   end .
      191   procedure cgrplib-get-node-from-full-name :
      192   define input parameter p-full-name as character no-undo .
      193   define output parameter p-node-code as integer no-undo .
      194   define variable v-ii as integer no-undo .
      195   define variable v-upper-code as integer no-undo .
      196   define variable v-root-code as integer no-undo .
      197   define variable v-entry as character no-undo .
      198   define buffer buf_cli-grp       for ub.cli-grp.
      199   do
      200   on error undo, return error
      201   :
      202     find first buf_cli-grp no-lock
      203         where buf_cli-grp.upper-code = 0
      204     no-error .
      205     if not available buf_cli-grp
      206     then do:
      207         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
      208     end.
      209     else do:
      210       assign
      211       v-root-code = buf_cli-grp.node-code
      212       .
      213     end.
      214     v-upper-code = v-root-code.
      215     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      216       assign
      217       v-entry = entry(v-ii, p-full-name, chr(47)).
      218       if v-entry = '' then leave.
      219       find first buf_cli-grp no-lock where
      220                 buf_cli-grp.node-name = v-entry
      221             and buf_cli-grp.upper-code = v-upper-code
      222             no-error.
      223       if not available buf_cli-grp then do:
      224         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      225       end.
      226       else do:
      227         p-node-code = buf_cli-grp.node-code.
      228         v-upper-code = buf_cli-grp.node-code.
      229       end.
      230     end.
      231   end.
      232   end .
      233   procedure cgrplib-get-root-code :
      234   do
      235   on error undo, return error
      236   :
      237   define output parameter p-root-code as integer      no-undo.
      238       define buffer buf_cli-grp       for ub.cli-grp.
      239       find first buf_cli-grp no-lock
      240           where buf_cli-grp.upper-code = 0
      241       no-error .
      242       if not available buf_cli-grp
      243       then do:
      244           undo, return error .
      245       end.
      246       else do:
      247           assign
      248               p-root-code = buf_cli-grp.node-code
      249           .
      250       end.
      251   end.
      252   end procedure.
      253   procedure cgrplib-find-grp-by-full-name :
      254   do
      255   on error undo, return error
      256   :
      257   define input parameter p-search-name  as character    no-undo.
      258   define input parameter p-fill-path    as logical      no-undo.
      259       define variable v-upper-code    as integer          no-undo.
      260       define variable v-not-found     as logical init yes no-undo.
      261       define variable v-counter       as integer           no-undo.
      262       define variable v-level         as integer           no-undo.
      263       define variable v-full-name     as character         no-undo.
      264       define variable v-sort-name     as character         no-undo.
      265       define buffer buf_cli-grp       for ub.cli-grp.
      266       assign
      267           p-search-name = replace( p-search-name, chr(47), chr(2) )
      268       .
      269       run cgrplib-get-root-code ( output v-upper-code ) no-error .
      270       if error-status :error
      271       then do:
      272           undo, return error "cgrplib-expand-name: Ошибка при поиске корневого узла".
      273       end.
      274       assign
      275           v-full-name  = ""
      276           v-level      = num-entries( p-search-name, chr(2) )
      277       .
      278       for each temp_cgrplib_found-grp
      279       :
      280           delete temp_cgrplib_found-grp.
      281       end.
      282       start-name-analyze:
      283       do v-counter = 1 to v-level
      284       :
      285           if v-counter < v-level
      286           then do:
      287               find first buf_cli-grp no-lock
      288                    where buf_cli-grp.upper-code = v-upper-code
      289                      and buf_cli-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      290               no-error .
      291               if not available buf_cli-grp
      292               then do:
      293                   assign
      294                       v-full-name  = p-search-name
      295                       v-sort-name  = p-search-name
      296                   .
      297                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      298               end.
      299               else do:
      300                   assign
      301                       v-full-name = v-full-name + (if v-full-name = "" then "" else chr(47) )         + buf_cli-grp.node-name
      302                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_cli-grp.node-name
      303                       v-upper-code = buf_cli-grp.node-code
      304                   .
      305                   if p-fill-path = yes
      306                   then do:
      307                       create temp_cgrplib_found-grp.
      308                       assign
      309                           temp_cgrplib_found-grp.full-name = v-full-name + chr(47)
      310                           temp_cgrplib_found-grp.sort-name = v-sort-name
      311                           temp_cgrplib_found-grp.node-code = v-upper-code
      312                           temp_cgrplib_found-grp.level     = v-counter
      313                       .
      314                   end.
      315               end.
      316           end.
      317           else do:
      318               for each buf_cli-grp no-lock
      319                  where buf_cli-grp.upper-code = v-upper-code
      320                    and buf_cli-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      321               :
      322                   assign
      323                       v-not-found = no
      324                   .
      325                   create temp_cgrplib_found-grp.
      326                   assign
      327                       temp_cgrplib_found-grp.full-name = v-full-name
      328                                                           + ( if v-full-name = "" then "" else chr(47) )
      329                                                           + buf_cli-grp.node-name + chr(47)
      330                       temp_cgrplib_found-grp.sort-name = v-sort-name
      331                                                           + ( if v-sort-name = "" then "" else chr(2) )
      332                                                           + buf_cli-grp.node-name
      333                       temp_cgrplib_found-grp.node-code = buf_cli-grp.node-code
      334                       temp_cgrplib_found-grp.level     = v-level
      335                   .
      336               end.
      337               if v-not-found = yes
      338               then do:
      339                   assign
      340                       v-full-name  = p-search-name
      341                       v-sort-name  = p-search-name
      342                   .
      343                   for each temp_cgrplib_found-grp
      344                   :
      345                       delete temp_cgrplib_found-grp.
      346                   end.
      347                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      348               end.
      349           end.
      350       end.
      351   end.
      352   end procedure.
      353   procedure cgrplib-find-all-subgroup :
      354   do
      355   on error undo, return error
      356   :
      357   define input parameter p-start-node-code    as integer      no-undo.
      358   define input parameter p-terminal-only      as logical      no-undo.
      359       define variable v-start-full-name   as character     no-undo.
      360       define variable v-start-sort-name   as character     no-undo.
      361       define variable v-not-found         as logical       no-undo.
      362       define variable v-is-terminal       as logical       no-undo.
      363       define variable v-d-pcnt            as decimal       no-undo.
      364       define buffer buf_cli-grp           for ub.cli-grp.
      365       create temp_cfound-result-nodelist.
      366       assign
      367           temp_cfound-result-nodelist.node-code = p-start-node-code
      368           temp_cfound-result-nodelist.processed = no
      369       .
      370       run cli-grplib-get-full-name in this-procedure (
      371             input p-start-node-code
      372           , output v-start-full-name
      373       ).
      374       run cli-grplib-get-sort-name in this-procedure (
      375             input p-start-node-code
      376           , output v-start-sort-name
      377       ).
      378       process-nodes:
      379       do while yes
      380       :
      381           find first temp_cfound-result-nodelist
      382                where temp_cfound-result-nodelist.node-code = p-start-node-code
      383           .
      384           assign
      385               temp_cfound-result-nodelist.processed = yes
      386           .
      387           for each buf_cli-grp no-lock
      388              where buf_cli-grp.upper-code = p-start-node-code
      389           on error undo, return error
      390           :
      391               run cgrplib-is-terminal in this-procedure (
      392                     input buf_cli-grp.node-code
      393                   , output v-is-terminal
      394               ).
      395               if v-is-terminal = yes
      396               then do:
      397                   create temp_cgrplib_found-grp.
      398                   assign
      399                       temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      400                                                           chr(47) + buf_cli-grp.node-name + chr(47)
      401                       temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      402                                                           chr(2) + buf_cli-grp.node-name + chr(2)
      403                       temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
      404                       temp_cgrplib_found-grp.is-terminal = yes
      405                   .
      406                  run cgrplib-get-pcnt-value in this-procedure ( input temp_cgrplib_found-grp.node-code , output v-d-pcnt) no-error .
      407                  if not error-status:error then do:
      408                    temp_cgrplib_found-grp.d-pcnt = v-d-pcnt.
      409                  end.
      410                  else do:
      411                    temp_cgrplib_found-grp.d-pcnt = ?.
      412                  end.
      413               end.
      414               else do:
      415                   create temp_cfound-result-nodelist.
      416                   assign
      417                       temp_cfound-result-nodelist.node-code = buf_cli-grp.node-code
      418                       temp_cfound-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      419                                                              chr(47) + buf_cli-grp.node-name + chr(47)
      420                       temp_cfound-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      421                                                              chr(2) + buf_cli-grp.node-name + chr(2)
      422                       temp_cfound-result-nodelist.processed = no
      423                   .
      424                   if p-terminal-only = no
      425                   then do:
      426                       create temp_cgrplib_found-grp.
      427                       assign
      428                           temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      429                                                               chr(47) + buf_cli-grp.node-name + chr(47)
      430                           temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      431                                                               chr(2) + buf_cli-grp.node-name + chr(2)
      432                           temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
      433                           temp_cgrplib_found-grp.is-terminal = no
      434                       .
      435                   end.
      436               end.
      437           end.
      438           find first temp_cfound-result-nodelist
      439                where temp_cfound-result-nodelist.processed = no
      440           no-error.
      441           if not available temp_cfound-result-nodelist
      442           then do:
      443               leave process-nodes.
      444           end.
      445           else do:
      446               assign
      447                   p-start-node-code = temp_cfound-result-nodelist.node-code
      448                   v-start-full-name = temp_cfound-result-nodelist.full-name
      449                   v-start-sort-name = temp_cfound-result-nodelist.sort-name
      450               .
      451           end.
      452       end.
      453   end.
      454   end procedure.
      455   procedure cgrplib-expand-name :
      456   do
      457   on error undo, return error
      458   :
      459   define input parameter p-start-name as character        no-undo.
      460   define output parameter p-end-name  as character        no-undo.
      461       define variable v-is-terminal     as logical           no-undo.
      462       define buffer buf_temp_cgrplib_found-grp     for temp_cgrplib_found-grp.
      463       run cgrplib-find-grp-by-full-name in this-procedure (
      464             input p-start-name
      465           , input no
      466       ) no-error.
      467       run cgrplib-get-max-substring in this-procedure (
      468                   input length( p-start-name )
      469                 , output p-end-name
      470       ) no-error .
      471       if error-status :error
      472       then do:
      473           assign
      474               p-end-name = ""
      475           .
      476       end.
      477       else do:
      478           find first temp_cgrplib_found-grp
      479               where temp_cgrplib_found-grp.full-name = p-end-name
      480           no-error.
      481           if available temp_cgrplib_found-grp
      482           then do:
      483               find first buf_temp_cgrplib_found-grp
      484                   where buf_temp_cgrplib_found-grp.full-name begins p-end-name
      485                   and recid( buf_temp_cgrplib_found-grp ) <> recid( temp_cgrplib_found-grp )
      486               no-error.
      487               if not available buf_temp_cgrplib_found-grp
      488               then do:
      489                   run cgrplib-is-terminal in this-procedure (
      490                       input temp_cgrplib_found-grp.node-code
      491                       , output v-is-terminal
      492                   ).
      493               end.
      494           end.
      495       end.
      496   end.
      497   end procedure.
      498   procedure cgrplib-get-max-substring :
      499   do
      500   on error undo, return error
      501   :
      502   define input parameter p-min-substring-length   as integer      no-undo.
      503   define output parameter p-substring             as character    no-undo.
      504           define variable v-char-counter  as integer           no-undo.
      505           define variable v-current-char  as character         no-undo.
      506           define variable v-names-counter  as integer           no-undo.
      507           define variable v-base-string   as character         no-undo.
      508           assign
      509               v-char-counter  = p-min-substring-length
      510           .
      511           find first temp_cgrplib_found-grp no-error.
      512           if not available temp_cgrplib_found-grp
      513           then do:
      514               undo, return error "cgrplib-get-max-substring: Нет строк для вычисления общей подстроки".
      515           end.
      516           else do:
      517               assign
      518                   v-base-string = temp_cgrplib_found-grp.full-name
      519               .
      520               counter-block:
      521               do while yes
      522               on error undo, return error "cgrplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      523               :
      524                   assign
      525                       v-char-counter  = v-char-counter + 1
      526                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      527                       v-names-counter = 0
      528                   .
      529                   compare-block:
      530                   for each temp_cgrplib_found-grp
      531                   :
      532                       assign
      533                           v-names-counter = v-names-counter + 1
      534                       .
      535                       if v-names-counter = 1
      536                       then do:
      537                           next compare-block.
      538                       end.
      539                       if substring( temp_cgrplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      540                       then do:
      541                           leave counter-block.
      542                       end.
      543                   end.
      544                   if v-names-counter = 1
      545                   then do:
      546                       assign
      547                           p-substring = v-base-string
      548                       .
      549                       return.
      550                   end.
      551               end.
      552               assign
      553                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      554               .
      555           end.
      556   end.
      557   end procedure.
      558   procedure cgrplib-is-terminal :
      559   do
      560   on error undo, return error "Ошибка процедуры cgrplib-is-terminal"
      561   :
      562   define input parameter p-node-code      as integer      no-undo.
      563   define output parameter p-is-terminal   as logical      no-undo.
      564       define buffer buf_cli-grp       for ub.cli-grp.
      565       find first buf_cli-grp no-lock
      566           where buf_cli-grp.upper-code = p-node-code
      567       no-error .
      568       if not available buf_cli-grp
      569       then do:
      570           assign
      571               p-is-terminal = yes
      572           .
      573       end.
      574       else do:
      575           assign
      576               p-is-terminal = no
      577           .
      578       end.
      579   end.
      580   end procedure.
      581   procedure cgrplib-have-clients :
      582   do
      583   on error undo, return error
      584   :
      585   define input parameter p-node-code      as integer      no-undo.
      586   define output parameter p-have-clients   as logical      no-undo.
      587       define buffer buf_clients         for ub.clients.
      588       find first buf_clients no-lock
      589            where buf_clients.grp-code = p-node-code
      590       no-error .
      591       if available buf_clients
      592       then do:
      593           assign
      594               p-have-clients = yes
      595           .
      596       end.
      597       else do:
      598           assign
      599               p-have-clients = no
      600           .
      601       end.
      602   end.
      603   end procedure.
      604   procedure cgrplib-find-by-substring :
      605   do
      606   on error undo, return error
      607   :
      608   define input parameter p-start-code         as integer      no-undo.
      609   define input parameter p-full-search-string as character    no-undo.
      610   define output parameter p-found-code        as integer      no-undo.
      611   define output parameter p-full-name         as character    no-undo.
      612       define variable v-start-code     as integer           no-undo.
      613       define variable v-found          as logical  init no  no-undo.
      614       define buffer buf_cli-grp       for ub.cli-grp.
      615       search-grp:
      616       for each buf_cli-grp no-lock
      617           where buf_cli-grp.node-code > p-start-code
      618       :
      619           if index( buf_cli-grp.node-name, p-full-search-string ) <> 0
      620           then do:
      621               assign
      622                   p-found-code = buf_cli-grp.node-code
      623                   v-found      = yes
      624               .
      625               run cli-grplib-get-full-name in this-procedure (
      626                     input p-found-code
      627                   , output p-full-name
      628               ) no-error .
      629               if error-status :error
      630               then do:
      631                   undo, return error "cgrplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      632               end.
      633               leave search-grp.
      634           end.
      635       end.
      636       if v-found = yes
      637       then do:
      638       end.
      639       else do:
      640           assign
      641               p-full-name  = ""
      642               p-found-code = 0
      643           .
      644       end.
      645   end.
      646   end procedure.
      647   procedure cgrplib-analyze-grp-name :
      648   do
      649   on error undo, return error
      650   :
      651   define input parameter p-grp-name       as character            no-undo.
      652   define input parameter p-upper-code     as integer              no-undo.
      653   define output parameter p-error-message as character init ""    no-undo.
      654       define variable v-char-list     as character    no-undo.
      655       define variable v-char-counter  as integer      no-undo.
      656       define variable v-full-name     as character    no-undo.
      657       if p-grp-name = "" then do:
      658           assign
      659               p-error-message = "Название группы не может быть пустым.".
      660           .
      661       end.
      662       else do:
      663           assign
      664               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      665           .
      666           do v-char-counter = 1 to num-entries( v-char-list )
      667           :
      668               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      669               then do:
      670                   assign
      671                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      672                   .
      673                   return.
      674               end.
      675           end.
      676           run cli-grplib-get-full-name in this-procedure (
      677                 input p-upper-code
      678               , output v-full-name
      679           ) no-error .
      680           if error-status :error
      681           then do:
      682               undo, return error "cgrplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      683           end.
      684           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
      685           then do:
      686               assign
      687                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
      688               .
      689           end.
      690       end.
      691   end.
      692   end procedure.
      693   procedure cgrplib-get-lvl-num :
      694   define input parameter p-node-code  as integer      no-undo.
      695   define output parameter p-lvl-num   as integer      no-undo.
      696       define variable v-full-name    as character    no-undo.
      697   do
      698   on error undo, return error
      699   :
      700       run cli-grplib-get-full-name in this-procedure (
      701             input p-node-code
      702           , output v-full-name
      703       ).
      704       assign
      705           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
      706       .
      707       if p-lvl-num = -1
      708       then do:
      709           assign
      710               p-lvl-num = 0
      711           .
      712       end.
      713   end.
      714   end procedure.
      715   PROCEDURE cgrplib-get-pcnt-value :
      716   DEFINE INPUT PARAMETER p-node-code AS INTEGER NO-UNDO.
      717   DEFINE output PARAMETER p-pcnt-value AS DECIMAL NO-UNDO.
      718   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
      719   define buffer buf_dis-rule for ub.dis-rule.
      720   find first buf_dis-grp-rule no-lock where
      721             buf_dis-grp-rule.classif-type = 'cli-grp':U
      722         and buf_dis-grp-rule.node-code = p-node-code
      723         and buf_dis-grp-rule.host-code = 0
      724         and buf_dis-grp-rule.obj-type = '':U
      725         and buf_dis-grp-rule.obj-code = 0
      726         and buf_dis-grp-rule.pos-type = '-':U
      727         and buf_dis-grp-rule.discnt-role = 'cli-grp-pcnt':U no-error.
      728   if available buf_dis-grp-rule then do:
      729     find first buf_dis-rule no-lock where
      730               buf_dis-rule.rule-num = buf_dis-grp-rule.rule-num no-error.
      731     if available buf_dis-rule then do:
      732       assign
      733       p-pcnt-value        = buf_dis-rule.discnt-value.
      734       .
      735     end.
      736   end.
      737   END PROCEDURE.
      738   define variable v-root-code    as integer no-undo .
      739   define variable v-is-terminal  as logical no-undo.
      740   define variable v-have-clients as logical no-undo .
      741   define buffer      buf_cli-grp for ub.cli-grp .
      742   define buffer     buf2_cli-grp for ub.cli-grp .
      743   define buffer buf_same_cli-grp for ub.cli-grp .
      744       run cgrplib-get-root-code in this-procedure ( output v-root-code ) no-error .
      745       if error-status :error then do:
      746         undo, throw new Progress.Lang.AppError(
      747           substitute("&1 &2 &3&4Не найден корневой узел",
      748                      vss-workfile, vss-revision, vss-description, chr(10))
      749         ) .
      750       end.
      751       if p-node-code = v-root-code then do:
      752         undo, throw new Progress.Lang.AppError(
      753           substitute("&1 &2 &3&4Запись о группе клиентов с кодом [&5] корневая. Нельзя удалить корневую группу",
      754                      vss-workfile, vss-revision, vss-description, chr(10),
      755                      p-node-code )
      756         ) .
      757       end.
      758       find first buf_cli-grp exclusive-lock where buf_cli-grp.node-code = p-node-code no-error no-wait .
      759       if locked(buf_cli-grp) then do:
      760         undo, throw new Progress.Lang.AppError(
      761           substitute("&1 &2 &3&4Запись о группе клиентов с кодом [&5] занята другим пользователем",
      762                      vss-workfile, vss-revision, vss-description, chr(10),
      763                      p-node-code )
      764         ) .
      765       end .
      766       if not available buf_cli-grp then do:
      767         undo, throw new Progress.Lang.AppError(
      768           substitute("&1 &2 &3&4Запись о группе клиентов с кодом [&5] отсутствует",
      769                      vss-workfile, vss-revision, vss-description, chr(10),
      770                      p-node-code )
      771         ) .
      772       end .
      773       if buf_cli-grp.upper-code = v-root-code then do:
      774         if can-find (buf2_cli-grp where buf2_cli-grp.upper-code = v-root-code) then do:
      775           undo, throw new Progress.Lang.AppError(
      776             substitute("&1 &2 &3&4группа клиентов с кодом [&5] является единственной группой первого уровня.&4Нельзя удалить последнюю группу первого уровня.",
      777                      vss-workfile, vss-revision, vss-description, chr(10),
      778                      p-node-code )
      779           ) .
      780         end .
      781       end .
      782       run cgrplib-is-terminal in this-procedure ( input p-node-code , output v-is-terminal ) no-error .
      783       if error-status :error then do:
      784         undo, throw new Progress.Lang.AppError(
      785           substitute("&1 &2 &3&4&6&4Ошибка определения типа группы (терм/корн) для группы [&5]",
      786                      vss-workfile, vss-revision, vss-description, chr(10),
      787                      p-node-code, return-value)
      788         ) .
      789       end .
      790       if v-is-terminal then do:
      791         run cgrplib-have-clients in this-procedure ( input p-node-code, output v-have-clients ) no-error .
      792         if error-status :error then do:
      793           undo, throw new Progress.Lang.AppError(
      794             substitute("&1 &2 &3&4Ошибка определения наличия клиентов в группе [&5]",
      795                        vss-workfile, vss-revision, vss-description, chr(10),
      796                        p-node-code )
      797           ) .
      798         end.
      799         if v-have-clients then do:
      800           if can-find (first buf2_cli-grp
      801                        where buf2_cli-grp.upper-code = buf_cli-grp.upper-code
      802                          and buf2_cli-grp.node-code <> p-node-code) then do:
      803             undo, throw new Progress.Lang.AppError(
      804               substitute("&1 &2 &3&4Группа [&5] является терминальной и содержит клиентов." +
      805                          "&4После удаления клиенты группы [&5] будут перенесены на уровень выше, в группу [&6]." +
      806                          "&4Удаление не допустимо, т.к. группа [&6] содержит другие группы." +
      807                          "&4В одной группе не могут быть одновременно подгруппы и клиенты." +
      808                          "&4Группа [&5] не может быть слита с вышестоящей группой [&6].",
      809                          vss-workfile, vss-revision, vss-description, chr(10),
      810                          p-node-code, buf_cli-grp.upper-code )
      811             ) .
      812           end.
      813         end.
      814       end .
      815       else do:
      816         for each buf2_cli-grp no-lock
      817            where buf2_cli-grp.upper-code = buf_cli-grp.upper-code
      818              and buf2_cli-grp.node-code <> p-node-code :
      819           find first buf_same_cli-grp no-lock
      820                where buf_same_cli-grp.upper-code = p-node-code
      821                  and buf_same_cli-grp.node-name  = buf2_cli-grp.node-name no-error .
      822           if available buf_same_cli-grp then do:
      823             undo, throw new Progress.Lang.AppError(
      824               substitute("&1 &2 &3&4Подгруппа [&6] группв [&5] имеет название такое же, как соседняя с удаляемой группой группа [&7]." +
      825                          "&4После удаления две группы на одном уровне будут иметь одинаковые названия [&8], что запрещено.",
      826                          vss-workfile, vss-revision, vss-description, chr(10),
      827                          p-node-code, buf_same_cli-grp.node-code, buf2_cli-grp.node-code, buf2_cli-grp.node-name )
      828             ) .
      829           end .
      830         end .
      831       end .
      832       delete buf_cli-grp .
