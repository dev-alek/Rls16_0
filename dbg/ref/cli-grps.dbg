        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter        p-button-list as character no-undo.
        3   define input-output parameter p-recid-list  as character no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Управление деревом групп клиентов".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "X(65)" no-undo
      114   initial "@(#)$Workfile$ $Revision$".
      115   define temp-table temp_cgrplib_grp no-undo
      116       field sel           as character
      117       field full-name     as character
      118       field sort-name     as character
      119       field node-code     as integer
      120       field upper-code    as integer
      121       field d-pcnt        as decimal
      122       field name          as character
      123       field level         as integer
      124       field mark          as character
      125       index pi is primary unique sort-name
      126       index fn full-name
      127       index nc is unique node-code
      128       index sl sel
      129       index uc upper-code
      130   .
      131   define temp-table temp_cgrplib_found-grp no-undo
      132       field full-name   as character
      133       field sort-name   as character
      134       field node-code   as integer
      135       field level       as integer
      136       field is-terminal as logical
      137       field d-pcnt      as decimal
      138       index pi is primary unique sort-name
      139       index fn full-name
      140       index lv level
      141       index it is-terminal
      142   .
      143   define temp-table temp_cfound-result-nodelist no-undo
      144       field node-code     as recid
      145       field processed     as logical
      146       field full-name     as character
      147       field sort-name     as character
      148       index pi is primary unique node-code
      149       index ps processed
      150   .
      151   procedure cli-grplib-get-sort-name :
      152   do
      153   on error undo, return error
      154   :
      155   define input parameter p-node-code  as integer      no-undo.
      156   define output parameter p-sort-name as character    no-undo.
      157       define variable v-upper-code    as integer           no-undo.
      158       define buffer buf_cli-grp       for ub.cli-grp.
      159       define buffer buf_upper_cli-grp for ub.cli-grp.
      160       find first buf_cli-grp no-lock
      161            where buf_cli-grp.node-code = p-node-code
      162       no-error.
      163       if not available buf_cli-grp
      164       then do:
      165           undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      166       end.
      167       assign
      168           p-sort-name  = ""
      169           v-upper-code = 1
      170       .
      171       do while buf_cli-grp.upper-code <> 0
      172       on error undo, return error "cli-grplib-get-sort-name: Ошибка составления полного имени группы"
      173       :
      174           assign
      175               p-sort-name  = buf_cli-grp.node-name
      176                            + (if p-sort-name <> "" then chr(2) else "")
      177                            + p-sort-name
      178               v-upper-code = buf_cli-grp.upper-code
      179           .
      180           find first buf_cli-grp no-lock
      181                where buf_cli-grp.node-code = v-upper-code
      182           no-error.
      183           if not available buf_cli-grp
      184           then do:
      185               undo, return error "cli-grplib-get-sort-name: Не найдена группа клиентов с кодом "
      186                                   + string( v-upper-code )
      187                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      188           end.
      189       end.
      190   end.
      191   end procedure.
      192   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      193   procedure cli-grplib-get-full-name :
      194      define input parameter  p-node-code  as integer      no-undo.
      195      define output parameter p-full-name as character    no-undo.
      196   do
      197   on error undo, return error
      198   :
      199       define variable v-upper-code    as integer           no-undo.
      200       define buffer buf_cli-grp       for ub.cli-grp.
      201       define buffer buf_upper_cli-grp for ub.cli-grp.
      202       find first buf_cli-grp no-lock
      203            where buf_cli-grp.node-code = p-node-code
      204       no-error.
      205       if not available buf_cli-grp
      206       then do:
      207           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      208       end.
      209       assign
      210           p-full-name  = ""
      211           v-upper-code = 1
      212       .
      213       do while buf_cli-grp.upper-code <> 0
      214       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      215       :
      216           assign
      217               p-full-name  = buf_cli-grp.node-name
      218                            + (if p-full-name <> "" then chr(47) else "")
      219                            + p-full-name
      220               v-upper-code = buf_cli-grp.upper-code
      221           .
      222           find first buf_cli-grp no-lock
      223                where buf_cli-grp.node-code = v-upper-code
      224           no-error.
      225           if not available buf_cli-grp
      226           then do:
      227               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
      228                                   + string( v-upper-code )
      229                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      230           end.
      231       end.
      232       assign
      233       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      234       .
      235   end.
      236   end .
      237   procedure cgrplib-get-node-from-full-name :
      238   define input parameter p-full-name as character no-undo .
      239   define output parameter p-node-code as integer no-undo .
      240   define variable v-ii as integer no-undo .
      241   define variable v-upper-code as integer no-undo .
      242   define variable v-root-code as integer no-undo .
      243   define variable v-entry as character no-undo .
      244   define buffer buf_cli-grp       for ub.cli-grp.
      245   do
      246   on error undo, return error
      247   :
      248     find first buf_cli-grp no-lock
      249         where buf_cli-grp.upper-code = 0
      250     no-error .
      251     if not available buf_cli-grp
      252     then do:
      253         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
      254     end.
      255     else do:
      256       assign
      257       v-root-code = buf_cli-grp.node-code
      258       .
      259     end.
      260     v-upper-code = v-root-code.
      261     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      262       assign
      263       v-entry = entry(v-ii, p-full-name, chr(47)).
      264       if v-entry = '' then leave.
      265       find first buf_cli-grp no-lock where
      266                 buf_cli-grp.node-name = v-entry
      267             and buf_cli-grp.upper-code = v-upper-code
      268             no-error.
      269       if not available buf_cli-grp then do:
      270         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      271       end.
      272       else do:
      273         p-node-code = buf_cli-grp.node-code.
      274         v-upper-code = buf_cli-grp.node-code.
      275       end.
      276     end.
      277   end.
      278   end .
      279   procedure cgrplib-get-root-code :
      280   do
      281   on error undo, return error
      282   :
      283   define output parameter p-root-code as integer      no-undo.
      284       define buffer buf_cli-grp       for ub.cli-grp.
      285       find first buf_cli-grp no-lock
      286           where buf_cli-grp.upper-code = 0
      287       no-error .
      288       if not available buf_cli-grp
      289       then do:
      290           undo, return error .
      291       end.
      292       else do:
      293           assign
      294               p-root-code = buf_cli-grp.node-code
      295           .
      296       end.
      297   end.
      298   end procedure.
      299   procedure cgrplib-find-grp-by-full-name :
      300   do
      301   on error undo, return error
      302   :
      303   define input parameter p-search-name  as character    no-undo.
      304   define input parameter p-fill-path    as logical      no-undo.
      305       define variable v-upper-code    as integer          no-undo.
      306       define variable v-not-found     as logical init yes no-undo.
      307       define variable v-counter       as integer           no-undo.
      308       define variable v-level         as integer           no-undo.
      309       define variable v-full-name     as character         no-undo.
      310       define variable v-sort-name     as character         no-undo.
      311       define buffer buf_cli-grp       for ub.cli-grp.
      312       assign
      313           p-search-name = replace( p-search-name, chr(47), chr(2) )
      314       .
      315       run cgrplib-get-root-code ( output v-upper-code ) no-error .
      316       if error-status :error
      317       then do:
      318           undo, return error "cgrplib-expand-name: Ошибка при поиске корневого узла".
      319       end.
      320       assign
      321           v-full-name  = ""
      322           v-level      = num-entries( p-search-name, chr(2) )
      323       .
      324       for each temp_cgrplib_found-grp
      325       :
      326           delete temp_cgrplib_found-grp.
      327       end.
      328       start-name-analyze:
      329       do v-counter = 1 to v-level
      330       :
      331           if v-counter < v-level
      332           then do:
      333               find first buf_cli-grp no-lock
      334                    where buf_cli-grp.upper-code = v-upper-code
      335                      and buf_cli-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      336               no-error .
      337               if not available buf_cli-grp
      338               then do:
      339                   assign
      340                       v-full-name  = p-search-name
      341                       v-sort-name  = p-search-name
      342                   .
      343                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      344               end.
      345               else do:
      346                   assign
      347                       v-full-name = v-full-name + (if v-full-name = "" then "" else chr(47) )         + buf_cli-grp.node-name
      348                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_cli-grp.node-name
      349                       v-upper-code = buf_cli-grp.node-code
      350                   .
      351                   if p-fill-path = yes
      352                   then do:
      353                       create temp_cgrplib_found-grp.
      354                       assign
      355                           temp_cgrplib_found-grp.full-name = v-full-name + chr(47)
      356                           temp_cgrplib_found-grp.sort-name = v-sort-name
      357                           temp_cgrplib_found-grp.node-code = v-upper-code
      358                           temp_cgrplib_found-grp.level     = v-counter
      359                       .
      360                   end.
      361               end.
      362           end.
      363           else do:
      364               for each buf_cli-grp no-lock
      365                  where buf_cli-grp.upper-code = v-upper-code
      366                    and buf_cli-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      367               :
      368                   assign
      369                       v-not-found = no
      370                   .
      371                   create temp_cgrplib_found-grp.
      372                   assign
      373                       temp_cgrplib_found-grp.full-name = v-full-name
      374                                                           + ( if v-full-name = "" then "" else chr(47) )
      375                                                           + buf_cli-grp.node-name + chr(47)
      376                       temp_cgrplib_found-grp.sort-name = v-sort-name
      377                                                           + ( if v-sort-name = "" then "" else chr(2) )
      378                                                           + buf_cli-grp.node-name
      379                       temp_cgrplib_found-grp.node-code = buf_cli-grp.node-code
      380                       temp_cgrplib_found-grp.level     = v-level
      381                   .
      382               end.
      383               if v-not-found = yes
      384               then do:
      385                   assign
      386                       v-full-name  = p-search-name
      387                       v-sort-name  = p-search-name
      388                   .
      389                   for each temp_cgrplib_found-grp
      390                   :
      391                       delete temp_cgrplib_found-grp.
      392                   end.
      393                   return error "cgrplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      394               end.
      395           end.
      396       end.
      397   end.
      398   end procedure.
      399   procedure cgrplib-find-all-subgroup :
      400   do
      401   on error undo, return error
      402   :
      403   define input parameter p-start-node-code    as integer      no-undo.
      404   define input parameter p-terminal-only      as logical      no-undo.
      405       define variable v-start-full-name   as character     no-undo.
      406       define variable v-start-sort-name   as character     no-undo.
      407       define variable v-not-found         as logical       no-undo.
      408       define variable v-is-terminal       as logical       no-undo.
      409       define variable v-d-pcnt            as decimal       no-undo.
      410       define buffer buf_cli-grp           for ub.cli-grp.
      411       create temp_cfound-result-nodelist.
      412       assign
      413           temp_cfound-result-nodelist.node-code = p-start-node-code
      414           temp_cfound-result-nodelist.processed = no
      415       .
      416       run cli-grplib-get-full-name in this-procedure (
      417             input p-start-node-code
      418           , output v-start-full-name
      419       ).
      420       run cli-grplib-get-sort-name in this-procedure (
      421             input p-start-node-code
      422           , output v-start-sort-name
      423       ).
      424       process-nodes:
      425       do while yes
      426       :
      427           find first temp_cfound-result-nodelist
      428                where temp_cfound-result-nodelist.node-code = p-start-node-code
      429           .
      430           assign
      431               temp_cfound-result-nodelist.processed = yes
      432           .
      433           for each buf_cli-grp no-lock
      434              where buf_cli-grp.upper-code = p-start-node-code
      435           on error undo, return error
      436           :
      437               run cgrplib-is-terminal in this-procedure (
      438                     input buf_cli-grp.node-code
      439                   , output v-is-terminal
      440               ).
      441               if v-is-terminal = yes
      442               then do:
      443                   create temp_cgrplib_found-grp.
      444                   assign
      445                       temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      446                                                           chr(47) + buf_cli-grp.node-name + chr(47)
      447                       temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      448                                                           chr(2) + buf_cli-grp.node-name + chr(2)
      449                       temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
      450                       temp_cgrplib_found-grp.is-terminal = yes
      451                   .
      452                  run cgrplib-get-pcnt-value in this-procedure ( input temp_cgrplib_found-grp.node-code , output v-d-pcnt) no-error .
      453                  if not error-status:error then do:
      454                    temp_cgrplib_found-grp.d-pcnt = v-d-pcnt.
      455                  end.
      456                  else do:
      457                    temp_cgrplib_found-grp.d-pcnt = ?.
      458                  end.
      459               end.
      460               else do:
      461                   create temp_cfound-result-nodelist.
      462                   assign
      463                       temp_cfound-result-nodelist.node-code = buf_cli-grp.node-code
      464                       temp_cfound-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      465                                                              chr(47) + buf_cli-grp.node-name + chr(47)
      466                       temp_cfound-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      467                                                              chr(2) + buf_cli-grp.node-name + chr(2)
      468                       temp_cfound-result-nodelist.processed = no
      469                   .
      470                   if p-terminal-only = no
      471                   then do:
      472                       create temp_cgrplib_found-grp.
      473                       assign
      474                           temp_cgrplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      475                                                               chr(47) + buf_cli-grp.node-name + chr(47)
      476                           temp_cgrplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      477                                                               chr(2) + buf_cli-grp.node-name + chr(2)
      478                           temp_cgrplib_found-grp.node-code   = buf_cli-grp.node-code
      479                           temp_cgrplib_found-grp.is-terminal = no
      480                       .
      481                   end.
      482               end.
      483           end.
      484           find first temp_cfound-result-nodelist
      485                where temp_cfound-result-nodelist.processed = no
      486           no-error.
      487           if not available temp_cfound-result-nodelist
      488           then do:
      489               leave process-nodes.
      490           end.
      491           else do:
      492               assign
      493                   p-start-node-code = temp_cfound-result-nodelist.node-code
      494                   v-start-full-name = temp_cfound-result-nodelist.full-name
      495                   v-start-sort-name = temp_cfound-result-nodelist.sort-name
      496               .
      497           end.
      498       end.
      499   end.
      500   end procedure.
      501   procedure cgrplib-expand-name :
      502   do
      503   on error undo, return error
      504   :
      505   define input parameter p-start-name as character        no-undo.
      506   define output parameter p-end-name  as character        no-undo.
      507       define variable v-is-terminal     as logical           no-undo.
      508       define buffer buf_temp_cgrplib_found-grp     for temp_cgrplib_found-grp.
      509       run cgrplib-find-grp-by-full-name in this-procedure (
      510             input p-start-name
      511           , input no
      512       ) no-error.
      513       run cgrplib-get-max-substring in this-procedure (
      514                   input length( p-start-name )
      515                 , output p-end-name
      516       ) no-error .
      517       if error-status :error
      518       then do:
      519           assign
      520               p-end-name = ""
      521           .
      522       end.
      523       else do:
      524           find first temp_cgrplib_found-grp
      525               where temp_cgrplib_found-grp.full-name = p-end-name
      526           no-error.
      527           if available temp_cgrplib_found-grp
      528           then do:
      529               find first buf_temp_cgrplib_found-grp
      530                   where buf_temp_cgrplib_found-grp.full-name begins p-end-name
      531                   and recid( buf_temp_cgrplib_found-grp ) <> recid( temp_cgrplib_found-grp )
      532               no-error.
      533               if not available buf_temp_cgrplib_found-grp
      534               then do:
      535                   run cgrplib-is-terminal in this-procedure (
      536                       input temp_cgrplib_found-grp.node-code
      537                       , output v-is-terminal
      538                   ).
      539               end.
      540           end.
      541       end.
      542   end.
      543   end procedure.
      544   procedure cgrplib-get-max-substring :
      545   do
      546   on error undo, return error
      547   :
      548   define input parameter p-min-substring-length   as integer      no-undo.
      549   define output parameter p-substring             as character    no-undo.
      550           define variable v-char-counter  as integer           no-undo.
      551           define variable v-current-char  as character         no-undo.
      552           define variable v-names-counter  as integer           no-undo.
      553           define variable v-base-string   as character         no-undo.
      554           assign
      555               v-char-counter  = p-min-substring-length
      556           .
      557           find first temp_cgrplib_found-grp no-error.
      558           if not available temp_cgrplib_found-grp
      559           then do:
      560               undo, return error "cgrplib-get-max-substring: Нет строк для вычисления общей подстроки".
      561           end.
      562           else do:
      563               assign
      564                   v-base-string = temp_cgrplib_found-grp.full-name
      565               .
      566               counter-block:
      567               do while yes
      568               on error undo, return error "cgrplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      569               :
      570                   assign
      571                       v-char-counter  = v-char-counter + 1
      572                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      573                       v-names-counter = 0
      574                   .
      575                   compare-block:
      576                   for each temp_cgrplib_found-grp
      577                   :
      578                       assign
      579                           v-names-counter = v-names-counter + 1
      580                       .
      581                       if v-names-counter = 1
      582                       then do:
      583                           next compare-block.
      584                       end.
      585                       if substring( temp_cgrplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      586                       then do:
      587                           leave counter-block.
      588                       end.
      589                   end.
      590                   if v-names-counter = 1
      591                   then do:
      592                       assign
      593                           p-substring = v-base-string
      594                       .
      595                       return.
      596                   end.
      597               end.
      598               assign
      599                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      600               .
      601           end.
      602   end.
      603   end procedure.
      604   procedure cgrplib-is-terminal :
      605   do
      606   on error undo, return error "Ошибка процедуры cgrplib-is-terminal"
      607   :
      608   define input parameter p-node-code      as integer      no-undo.
      609   define output parameter p-is-terminal   as logical      no-undo.
      610       define buffer buf_cli-grp       for ub.cli-grp.
      611       find first buf_cli-grp no-lock
      612           where buf_cli-grp.upper-code = p-node-code
      613       no-error .
      614       if not available buf_cli-grp
      615       then do:
      616           assign
      617               p-is-terminal = yes
      618           .
      619       end.
      620       else do:
      621           assign
      622               p-is-terminal = no
      623           .
      624       end.
      625   end.
      626   end procedure.
      627   procedure cgrplib-have-clients :
      628   do
      629   on error undo, return error
      630   :
      631   define input parameter p-node-code      as integer      no-undo.
      632   define output parameter p-have-clients   as logical      no-undo.
      633       define buffer buf_clients         for ub.clients.
      634       find first buf_clients no-lock
      635            where buf_clients.grp-code = p-node-code
      636       no-error .
      637       if available buf_clients
      638       then do:
      639           assign
      640               p-have-clients = yes
      641           .
      642       end.
      643       else do:
      644           assign
      645               p-have-clients = no
      646           .
      647       end.
      648   end.
      649   end procedure.
      650   procedure cgrplib-find-by-substring :
      651   do
      652   on error undo, return error
      653   :
      654   define input parameter p-start-code         as integer      no-undo.
      655   define input parameter p-full-search-string as character    no-undo.
      656   define output parameter p-found-code        as integer      no-undo.
      657   define output parameter p-full-name         as character    no-undo.
      658       define variable v-start-code     as integer           no-undo.
      659       define variable v-found          as logical  init no  no-undo.
      660       define buffer buf_cli-grp       for ub.cli-grp.
      661       search-grp:
      662       for each buf_cli-grp no-lock
      663           where buf_cli-grp.node-code > p-start-code
      664       :
      665           if index( buf_cli-grp.node-name, p-full-search-string ) <> 0
      666           then do:
      667               assign
      668                   p-found-code = buf_cli-grp.node-code
      669                   v-found      = yes
      670               .
      671               run cli-grplib-get-full-name in this-procedure (
      672                     input p-found-code
      673                   , output p-full-name
      674               ) no-error .
      675               if error-status :error
      676               then do:
      677                   undo, return error "cgrplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      678               end.
      679               leave search-grp.
      680           end.
      681       end.
      682       if v-found = yes
      683       then do:
      684       end.
      685       else do:
      686           assign
      687               p-full-name  = ""
      688               p-found-code = 0
      689           .
      690       end.
      691   end.
      692   end procedure.
      693   procedure cgrplib-analyze-grp-name :
      694   do
      695   on error undo, return error
      696   :
      697   define input parameter p-grp-name       as character            no-undo.
      698   define input parameter p-upper-code     as integer              no-undo.
      699   define output parameter p-error-message as character init ""    no-undo.
      700       define variable v-char-list     as character    no-undo.
      701       define variable v-char-counter  as integer      no-undo.
      702       define variable v-full-name     as character    no-undo.
      703       if p-grp-name = "" then do:
      704           assign
      705               p-error-message = "Название группы не может быть пустым.".
      706           .
      707       end.
      708       else do:
      709           assign
      710               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      711           .
      712           do v-char-counter = 1 to num-entries( v-char-list )
      713           :
      714               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      715               then do:
      716                   assign
      717                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      718                   .
      719                   return.
      720               end.
      721           end.
      722           run cli-grplib-get-full-name in this-procedure (
      723                 input p-upper-code
      724               , output v-full-name
      725           ) no-error .
      726           if error-status :error
      727           then do:
      728               undo, return error "cgrplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      729           end.
      730           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
      731           then do:
      732               assign
      733                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
      734               .
      735           end.
      736       end.
      737   end.
      738   end procedure.
      739   procedure cgrplib-get-lvl-num :
      740   define input parameter p-node-code  as integer      no-undo.
      741   define output parameter p-lvl-num   as integer      no-undo.
      742       define variable v-full-name    as character    no-undo.
      743   do
      744   on error undo, return error
      745   :
      746       run cli-grplib-get-full-name in this-procedure (
      747             input p-node-code
      748           , output v-full-name
      749       ).
      750       assign
      751           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
      752       .
      753       if p-lvl-num = -1
      754       then do:
      755           assign
      756               p-lvl-num = 0
      757           .
      758       end.
      759   end.
      760   end procedure.
      761   PROCEDURE cgrplib-get-pcnt-value :
      762   DEFINE INPUT PARAMETER p-node-code AS INTEGER NO-UNDO.
      763   DEFINE output PARAMETER p-pcnt-value AS DECIMAL NO-UNDO.
      764   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
      765   define buffer buf_dis-rule for ub.dis-rule.
      766   find first buf_dis-grp-rule no-lock where
      767             buf_dis-grp-rule.classif-type = 'cli-grp':U
      768         and buf_dis-grp-rule.node-code = p-node-code
      769         and buf_dis-grp-rule.host-code = 0
      770         and buf_dis-grp-rule.obj-type = '':U
      771         and buf_dis-grp-rule.obj-code = 0
      772         and buf_dis-grp-rule.pos-type = '-':U
      773         and buf_dis-grp-rule.discnt-role = 'cli-grp-pcnt':U no-error.
      774   if available buf_dis-grp-rule then do:
      775     find first buf_dis-rule no-lock where
      776               buf_dis-rule.rule-num = buf_dis-grp-rule.rule-num no-error.
      777     if available buf_dis-rule then do:
      778       assign
      779       p-pcnt-value        = buf_dis-rule.discnt-value.
      780       .
      781     end.
      782   end.
      783   END PROCEDURE.
      784   define new global shared variable g#library  as handle no-undo .
      785   define new global shared variable g#library2 as handle no-undo .
      786   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      787   procedure cur-time :
      788      define output parameter p-today as date      no-undo .
      789      define output parameter p-time  as integer   no-undo .
      790     do
      791     on error undo, return error
      792     :
      793       define variable v-date1 as date      no-undo .
      794       define variable v-date2 as date      no-undo .
      795       define variable v-time  as integer   no-undo .
      796       assign
      797         v-date1 = today
      798         v-time  = time
      799         v-date2 = today
      800       .
      801       if v-date1 <> v-date2
      802       then do:
      803         assign
      804           v-date1 = today
      805           v-time  = v-time
      806         .
      807       end.
      808       assign
      809         p-today = v-date1
      810         p-time  = v-time
      811       .
      812     end.
      813   end.
      814   function cur-time-date returns character
      815   :
      816     return string(today, '99/99/9999':U) .
      817   end.
      818   function cur-time-mjd returns decimal
      819   :
      820     define variable v-date as date      no-undo .
      821     define variable v-time as integer   no-undo .
      822     run cur-time in this-procedure
      823       (output v-date
      824       ,output v-time
      825       ) .
      826     return integer(v-date) - 2400002 + (v-time / 86400) .
      827   end.
      828   function cur-time-get-ending-index returns integer
      829   (input p-number as integer
      830   )
      831   :
      832     if p-number < 0
      833     or p-number = ?
      834     then do:
      835       return 1 .
      836     end.
      837     define variable v-rest as integer   no-undo .
      838     assign
      839       p-number = p-number modulo 100
      840     .
      841     if p-number < 20
      842     then do:
      843       assign
      844         v-rest = p-number
      845       .
      846     end.
      847     else do:
      848       assign
      849         v-rest = p-number modulo 10
      850       .
      851     end.
      852     case v-rest :
      853       when 1
      854       then do:
      855         return 2 .
      856       end.
      857       when 2 or
      858       when 3 or
      859       when 4
      860       then do:
      861         return 3 .
      862       end.
      863       otherwise do:
      864         return 1 .
      865       end.
      866     end case .
      867   end.
      868   procedure cur-time-mjd-to-date :
      869      define input  parameter i-mjd-diff as decimal no-undo.
      870      define output parameter o-Date     as date    no-undo.
      871      define output parameter o-Time     as integer no-undo.
      872      define variable v-day-number as integer   no-undo .
      873      if    i-mjd-diff < 0
      874         or i-mjd-diff = ?
      875      then do:
      876         return "?" .
      877      end.
      878      assign
      879         v-day-number = truncate(i-mjd-diff,0).
      880         o-Date = date(v-day-number + 2400002).
      881         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      882     .
      883   end.
      884   function cur-time-mjd-to-string returns character
      885   (input p-mjd-diff as decimal
      886   )
      887   :
      888     define variable v-day-number as integer   no-undo .
      889     define variable v-seconds    as integer   no-undo .
      890     define variable v-hour       as integer   no-undo .
      891     define variable v-min        as integer   no-undo .
      892     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      893     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      894     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      895     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      896     if p-mjd-diff < 0
      897     or p-mjd-diff = ?
      898     then do:
      899       return "?" .
      900     end.
      901     assign
      902       v-day-number = integer(truncate(p-mjd-diff,0))
      903       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      904     .
      905     if v-seconds > 86400
      906     then do:
      907       assign
      908         v-seconds = 86400 - 1
      909       .
      910     end.
      911     if v-seconds < 0
      912     then do:
      913       assign
      914         v-seconds = 0
      915       .
      916     end.
      917     assign
      918       v-hour = truncate(v-seconds / 3600, 0)
      919     .
      920     assign
      921       v-seconds = v-seconds modulo 3600
      922     .
      923     assign
      924       v-min = truncate(v-seconds / 60, 0)
      925     .
      926     assign
      927       v-seconds = v-seconds modulo 60
      928     .
      929     return
      930         (if v-day-number <> 0
      931           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      932           else ""
      933         )
      934       + (if v-day-number <> 0 or v-hour <> 0
      935           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      936           else ""
      937         )
      938       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      939           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      940           else ""
      941         )
      942       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      943       .
      944   end.
      945   function cur-time-string returns character
      946   :
      947     define variable v-date as date      no-undo .
      948     define variable v-time as integer   no-undo .
      949     run cur-time in this-procedure
      950       (output v-date
      951       ,output v-time
      952       ) .
      953     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      954   end.
      955   function cur-time-string-sec returns character
      956   :
      957     define variable v-date as date      no-undo .
      958     define variable v-time as integer   no-undo .
      959     run cur-time in this-procedure
      960       (output v-date
      961       ,output v-time
      962       ) .
      963     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      964   end.
      965   function cur-time-custom  returns character
      966   (input p-prefix as character
      967   ,input p-date-format as character
      968   ,input p-delimiter as character
      969   ,input p-time-format as character
      970   ,input p-suffix as character
      971   )
      972   :
      973     define variable v-date as date      no-undo .
      974     define variable v-time as integer   no-undo .
      975     run cur-time in this-procedure
      976       (output v-date
      977       ,output v-time
      978       ) .
      979     return
      980       p-prefix
      981       + string(v-date, p-date-format)
      982       + p-delimiter
      983       + string(v-time, p-time-format)
      984       + p-suffix
      985       .
      986   end.
      987   function cur-time-print  returns character
      988   :
      989     define variable v-date as date      no-undo .
      990     define variable v-time as integer   no-undo .
      991     run cur-time in this-procedure
      992       (output v-date
      993       ,output v-time
      994       ) .
      995     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      996   end.
      997   function cur-time-datetime returns datetime
      998   :
      999     define variable v-char as character no-undo .
     1000     define variable v-datetime as datetime no-undo .
     1001     v-char = cur-time-string().
     1002     v-datetime = datetime(v-char).
     1003     return  v-datetime.
     1004   end.
     1005   function cur-time-string-msec returns character
     1006   :
     1007     define variable v-date as datetime  no-undo .
     1008     v-date = now.
     1009     return string(v-date) .
     1010   end.
     1011   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1012   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1013   define new shared variable RepPathName        as character no-undo .
     1014   define new shared variable PrintRubl          as logical   no-undo .
     1015   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1016   define variable v-waitfram-action01         as character   no-undo .
     1017   define variable v-waitfram-action02         as character   no-undo .
     1018   define variable v-waitfram-action03         as character   no-undo .
     1019   define variable mWaitFramTextBeg            as character   no-undo.
     1020   define variable mWaitFramTextEnd            as character   no-undo.
     1021   define variable mWaitFramView               as logical     no-undo.
     1022   define variable mWaitProcEvent              as logical     no-undo init yes.
     1023   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1024   define variable mWaitFramStop               as logical     no-undo.
     1025   define variable mWaitFramStopUser           as logical     no-undo.
     1026   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1027   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1028   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1029   define button B-WaitFramStop auto-end-key
     1030        label "Стоп"
     1031        size 10 by 1 tooltip "Остоновить процесс".
     1032   define button B-viewProcInfo
     1033        label "Информация"
     1034        size 15 by 1 tooltip "Информация о процесс".
     1035   define frame waitfram
     1036     v-waitfram-action01 format "x(72)" no-label skip
     1037     v-waitfram-action02 format "x(72)" no-label skip
     1038     v-waitfram-action03 format "x(72)" no-label skip
     1039     B-viewProcInfo
     1040     B-WaitFramStop at row 4 col 30
     1041     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1042     .
     1043   define new global shared variable mBatchMode as logical no-undo init ?.
     1044   define variable mFramBachModHandle as handle no-undo.
     1045   mFramBachModHandle = frame waitfram:handle.
     1046   define variable mFameOldVis as logical no-undo.
     1047   define variable mVisCUrentVin as logical no-undo.
     1048   if session:batch-mode
     1049   then
     1050      mBatchMode = yes.
     1051   if mBatchMode = ? then do:
     1052     mVisCUrentVin = current-window:visible.
     1053     mFameOldVis = mFramBachModHandle:visible.
     1054     mFramBachModHandle:visible  = yes.
     1055     mBatchMode = mFramBachModHandle:visible ne yes.
     1056     mFramBachModHandle:visible = mFameOldVis.
     1057     current-window:visible = mVisCUrentVin.
     1058   end.
     1059    if  log-manager:logfile-name ne ?
     1060     then DO:
     1061         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1062         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1063         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1064     end.
     1065   on choose of B-WaitFramStop in frame waitfram
     1066   do:
     1067     mWaitFramStop = yes.
     1068     mWaitFramStopUser = yes.
     1069   end.
     1070   function waitfram-check-timeout returns logical():
     1071      define variable vtime as int64 no-undo.
     1072      if mWaitFramStopTimeOut
     1073      then
     1074         return yes.
     1075      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1076      if     mWaitFramTimeOut ne ?
     1077         and mWaitFramTimeOut ne 0
     1078         and mWaitFramTimeOut lt vtime
     1079      then do:
     1080         mWaitFramStopTimeOut = yes.
     1081      end.
     1082      return mWaitFramStopTimeOut.
     1083   end.
     1084   procedure waitfram-hide :
     1085     if not session:batch-mode
     1086     then do
     1087     on error undo, return error return-value
     1088     :
     1089       pause 0 before-hide .
     1090       if not mBatchMode then
     1091         hide frame waitfram .
     1092     if     not mWaitFramView
     1093        and mWaitProcEvent
     1094     then
     1095       process events .
     1096     end.
     1097   end procedure.
     1098   procedure waitfram-show :
     1099     define input  parameter p-message as character no-undo .
     1100     define variable v-left-margin as integer   no-undo .
     1101     if not session:batch-mode
     1102     then do
     1103     on error undo, return error return-value
     1104     :
     1105       if length(p-message) <= 70 then do:
     1106         assign
     1107           v-left-margin = integer((70 - length(p-message)) / 2)
     1108         .
     1109         assign
     1110           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1111         .
     1112         assign
     1113           v-waitfram-action01 = " "
     1114           v-waitfram-action02 = " "
     1115                                    + fill(" ", v-left-margin)
     1116                                    + p-message
     1117           v-waitfram-action03 = " "
     1118         .
     1119       end.
     1120       else do:
     1121         define variable vRindex1 as integer no-undo.
     1122         define variable vRindex2 as integer no-undo.
     1123         vRindex1 = r-index(p-message," ",70).
     1124         if vRindex1 = 0
     1125         then
     1126            vRindex1 = 70.
     1127         if length(p-message)  <= vRindex1 + 70 then do:
     1128           assign
     1129             v-waitfram-action01 = " "
     1130             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1131             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1132           .
     1133         end.
     1134         else do:
     1135           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1136           if vRindex2 <= vRindex1
     1137           then
     1138              vRindex2 = vRindex1 + 70.
     1139           assign
     1140             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1141             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1142             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1143           .
     1144         end.
     1145       end.
     1146       B-viewProcInfo:visible   in frame waitfram = no.
     1147       B-viewProcInfo:sensitive in frame waitfram = no.
     1148       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1149       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1150       if  (   mWaitFramView
     1151          or  mWaitProcEvent)
     1152          and not mBatchMode
     1153       then
     1154          display
     1155             v-waitfram-action01 skip
     1156             v-waitfram-action02 skip
     1157             v-waitfram-action03 skip
     1158          with frame waitfram .
     1159       if     mWaitFramView
     1160          then do:
     1161             if     mWaitFramInterval ne ?
     1162                and not mBatchMode
     1163             then
     1164                wait-for go of frame waitfram pause mWaitFramInterval.
     1165          end.
     1166          else
     1167             if     mWaitProcEvent
     1168                and not mBatchMode
     1169             then
     1170                process events .
     1171     end.
     1172   end procedure.
     1173      procedure waitfram-show-this:
     1174         define input  parameter iInterval as int64 no-undo.
     1175         define variable vtime as int64 no-undo.
     1176         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1177         mWaitFramInterval = iInterval.
     1178         run waitfram-show (substitute("&1&2 &3&4" ,
     1179                                       mWaitFramTextBeg ,
     1180                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1181                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1182                                       mWaitFramTextEnd
     1183                                      )
     1184                           ).
     1185      end.
     1186      procedure WaitFramRunPause:
     1187         define input  parameter iInterval as dec no-undo.
     1188         define variable vStart  as datetime-tz no-undo.
     1189         define variable vend    as datetime-tz no-undo.
     1190         define variable vint as int64 no-undo.
     1191         define variable vOk as logical no-undo.
     1192         vStart = now.
     1193         vend   = vStart.
     1194         publish "WaitFramPause" (iInterval,output vOk).
     1195         vend   =  now.
     1196         vint = vend - vStart.
     1197         vint = iInterval - vint / 1000.
     1198         if     not mWaitFramStop
     1199            and (   vint > 0
     1200                 or (    not vOk
     1201                     and iInterval eq ?
     1202                     )
     1203                 )
     1204         then
     1205            run waitfram-show-this (iInterval).
     1206         vend   =  now.
     1207         vint = vend - vStart.
     1208         vint = iInterval - vint / 1000.
     1209         if     not mWaitFramStop
     1210            and vint > 0
     1211         then do:
     1212            run gbl/pause.p (vint * 1000).
     1213         end.
     1214         if iInterval ne ?
     1215         then
     1216            publish "WaitFramStop".
     1217         waitfram-check-timeout().
     1218      end.
     1219      procedure WaitFramWaitFor:
     1220         define input  parameter iInterval as dec no-undo.
     1221         assign
     1222            mWaitFramStartProc   = now
     1223            mWaitFramStopUser    = no
     1224            mWaitFramStopTimeOut = no
     1225         .
     1226         block-wait:
     1227         do while not mWaitFramStop:
     1228            run WaitFramRunPause (iInterval).
     1229            if  waitfram-check-timeout()
     1230            then do:
     1231               leave block-wait.
     1232            end.
     1233         end.
     1234         run waitfram-hide.
     1235      end.
     1236   procedure waitfram-join :
     1237     define input  parameter p-line-1  as character no-undo .
     1238     define input  parameter p-line-2  as character no-undo .
     1239     define input  parameter p-line-3  as character no-undo .
     1240     define output parameter p-message as character no-undo .
     1241     do
     1242     on error undo, return error return-value
     1243     :
     1244       assign
     1245         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1246                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1247                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1248       .
     1249     end.
     1250   end procedure.
     1251   function waitfram-join-function returns character
     1252     (input p-line-1 as character
     1253     ,input p-line-2 as character
     1254     ,input p-line-3 as character
     1255     ).
     1256     define variable v-message as character no-undo .
     1257     run waitfram-join in this-procedure
     1258       (input  p-line-1
     1259       ,input  p-line-2
     1260       ,input  p-line-3
     1261       ,output v-message
     1262       ) .
     1263     return v-message .
     1264   end function .
     1265   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
