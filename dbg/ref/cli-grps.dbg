     2461   ON VALUE-CHANGED OF br-list IN FRAME Dlg-grp
     2462   DO:
     2463       if temp_cgrplib_grp.level <> 0
     2464       then do:
     2465           assign
     2466               fi-search :screen-value = right-trim( temp_cgrplib_grp.full-name, chr(47) )
     2467           .
     2468       end.
     2469       IF (temp_cgrplib_grp.mark = "•"
     2470       or temp_cgrplib_grp.mark = " " )
     2471       and b-chg:sensitive in frame Dlg-grp = yes
     2472       then do:
     2473          ENABLE b-disc
     2474          WITH FRAME Dlg-grp.
     2475       END.
     2476       ELSE DO:
     2477           disable b-disc
     2478           WITH FRAME Dlg-grp.
     2479       END.
     2480   END.
     2481   ON CTRL-D OF fi-search IN FRAME Dlg-grp
     2482   DO:
     2483       define variable v-new-name as character no-undo.
     2484       run cgrplib-expand-name in this-procedure (
     2485           input fi-search :screen-value
     2486           , output v-new-name
     2487       ) no-error.
     2488       if error-status :error
     2489       then do:
     2490           message return-value.
     2491           undo, return no-apply.
     2492       end.
     2493       if v-new-name = ""
     2494       then do:
     2495           message
     2496               "Не найдена группа с полным именем, начинающимся на"
     2497               skip "'" + fi-search :screen-value + "'"
     2498           view-as alert-box information.
     2499           assign
     2500               v-new-name = fi-search :screen-value
     2501           .
     2502       end.
     2503       assign
     2504           fi-search :screen-value  = right-trim( v-new-name, chr(47) )
     2505           fi-search :cursor-offset = length( v-new-name ) + 1
     2506       .
     2507   END.
     2508   ON CTRL-S OF fi-search IN FRAME Dlg-grp
     2509   DO:
     2510       define variable v-new-name as character no-undo.
     2511       define variable v-new-code as integer   no-undo.
     2512       if v-full-search-next = no
     2513       then do:
     2514           assign
     2515               v-full-search-string     = fi-search :screen-value
     2516               v-full-search-next       = yes
     2517               v-full-search-start-code = 0
     2518           .
     2519       end.
     2520   if session :set-wait-state( "compiler" ) then.
     2521       run cgrplib-find-by-substring in this-procedure (
     2522                             input v-full-search-start-code
     2523                           , input v-full-search-string
     2524                           , output v-new-code
     2525                           , output v-new-name
     2526       ) no-error.
     2527       if error-status :error
     2528       then do:
     2529   if session :set-wait-state( "" ) then.
     2530           message return-value.
     2531           undo, return no-apply.
     2532       end.
     2533   if session :set-wait-state( "" ) then.
     2534       if v-new-code = 0
     2535       then do:
     2536           message
     2537               skip "Не найдена строка '" v-full-search-string "' в имени группы."
     2538           view-as alert-box information
     2539           title "Поиск завершен".
     2540           assign
     2541               v-new-name               = fi-search :screen-value
     2542               v-full-search-string     = ""
     2543               v-full-search-next       = no
     2544               v-full-search-start-code = 0
     2545           .
     2546       end.
     2547       else do:
     2548           assign
     2549               v-full-search-start-code = v-new-code
     2550           .
     2551       end.
     2552       assign
     2553           fi-search :screen-value  = right-trim( v-new-name, chr(47) )
     2554           fi-search :cursor-offset = length( v-new-name ) + 1
     2555       .
     2556   END.
     2557   ON LEAVE OF fi-search IN FRAME Dlg-grp
     2558   DO:
     2559       if fi-search :screen-value <> v-full-search-string
     2560       then do:
     2561           assign
     2562               v-full-search-string     = ""
     2563               v-full-search-next       = no
     2564               v-full-search-start-code = 0
     2565           .
     2566       end.
     2567   END.
     2568   ON RETURN OF fi-search IN FRAME Dlg-grp
     2569   DO:
     2570       if fi-search :screen-value = ""
     2571       or fi-search :screen-value = ?
     2572       then do:
     2573           return no-apply.
     2574       end.
     2575       run find-grp-in-browse in this-procedure (
     2576           input fi-search :screen-value
     2577       ) no-error.
     2578       if error-status :error
     2579       then do:
     2580           message
     2581             skip "Группа не найдена."
     2582             skip return-value
     2583             skip trim(error-status :get-message(1))
     2584                  trim(error-status :get-message(2))
     2585                  trim(error-status :get-message(3))
     2586                  trim(error-status :get-message(4))
     2587                  trim(error-status :get-message(5))
     2588           view-as alert-box warning.
     2589           undo, return no-apply.
     2590       end.
     2591       apply "ENTRY" to b-search in frame Dlg-grp.
     2592       return no-apply.
     2593   END.
     2594   ON CHOOSE OF MENU-ITEM m_all
     2595   DO:
     2596     rum-option = "all".
     2597     RUN proc-b-rum IN THIS-PROCEDURE ( INPUT rum-option) NO-ERROR.
     2598     IF ERROR-STATUS:ERROR THEN DO:
     2599         rum-option = "".
     2600         RETURN NO-APPLY.
     2601     END.
     2602     rum-option = "".
     2603   END.
