     1721   define variable v-from-b-cli as logical no-undo .
     1722   define variable v-old-recid-list as character no-undo .
     1723   define variable v-old-recid as recid no-undo .
     1724   define variable v-is-deploy as logical no-undo .
     1725   DEFINE VARIABLE rum-option   AS CHARACTER NO-UNDO.
     1726   DEFINE MENU MENU-b-print
     1727          MENU-ITEM m_classificator LABEL "Классификатор"
     1728          MENU-ITEM m_browse       LABEL "Справочник"
     1729          MENU-ITEM m_term         LABEL "Содержимое терминальных групп".
     1730   DEFINE MENU MENU-B-rum
     1731          MENU-ITEM m_current      LABEL "Текущая"
     1732          MENU-ITEM m_current_plus_childs LABEL "Текущая (с группами нижних уровней)"
     1733          MENU-ITEM m_selected     LABEL "Выбранные"
     1734          MENU-ITEM m_selected_plus_childs LABEL "Выбранные (с группами нижних уровней)"
     1735          MENU-ITEM m_all          LABEL "Все"
     1736          RULE
     1737          MENU-ITEM m_xml-file-import LABEL "Импорт из XML-файла".
     1738   DEFINE BUTTON b-add
     1739        LABEL "&Добавить"
     1740        SIZE 10 BY 1 TOOLTIP "Добавить группу"
     1741        BGCOLOR 8 .
     1742   DEFINE BUTTON b-chg
     1743        LABEL "&Изменить"
     1744        SIZE 10 BY 1 TOOLTIP "Изменить название и характеристики группы"
     1745        BGCOLOR 8 .
     1746   DEFINE BUTTON B-cli
     1747        LABEL "&Клиенты"
     1748        SIZE 10 BY 1.
     1749   DEFINE BUTTON b-del
     1750        LABEL "&Удалить"
     1751        SIZE 10 BY 1 TOOLTIP "Удалить группу"
     1752        BGCOLOR 8 .
     1753   DEFINE BUTTON b-disc
     1754        LABEL "Скидка"
     1755        SIZE 10 BY 1.
     1756   DEFINE BUTTON b-exit
     1757        LABEL "&Выход"
     1758        SIZE 10 BY 1 TOOLTIP "Выход"
     1759        BGCOLOR 8 .
     1760   DEFINE BUTTON b-expand
     1761        LABEL ">>"
     1762        SIZE 3.5 BY 1.13.
     1763   DEFINE BUTTON b-expand-all
     1764        LABEL ">>-->>"
     1765        SIZE 7.5 BY 1.13.
     1766   DEFINE BUTTON b-find-by-full-name
     1767        LABEL "+"
     1768        SIZE 3 BY 1 TOOLTIP "Продолжить до полного имени (CTRL-D)"
     1769        BGCOLOR 8 .
     1770   DEFINE BUTTON b-find-by-substring
     1771        LABEL "?"
     1772        SIZE 3 BY 1 TOOLTIP "Найти подстроку во всех группах (CTRL-S)"
     1773        BGCOLOR 8 .
     1774   DEFINE BUTTON b-help
     1775        LABEL "&Помощь"
     1776        SIZE 3 BY 1 TOOLTIP "Помощь"
     1777        BGCOLOR 8 .
     1778   DEFINE BUTTON B-history
     1779        LABEL "Ис&тория"
     1780        SIZE 3 BY 1.
     1781   DEFINE BUTTON b-mark
     1782        LABEL "&*"
     1783        SIZE 3 BY 1.
     1784   DEFINE BUTTON b-move
     1785        LABEL "П&еренести"
     1786        SIZE 10 BY 1 TOOLTIP "Переместить группу"
     1787        BGCOLOR 8 .
     1788   DEFINE BUTTON b-print
     1789        LABEL "Пе&чать"
     1790        SIZE 3 BY 1 TOOLTIP "Печать списка групп".
     1791   DEFINE BUTTON B-rum
     1792        LABEL "&Операции над группами"
     1793        SIZE 30 BY 1.
     1794   DEFINE BUTTON b-search
     1795        LABEL "Поиск"
     1796        SIZE 10 BY 1.03
     1797        BGCOLOR 8 .
     1798   DEFINE BUTTON b-sel
     1799        LABEL "Вы&бор"
     1800        SIZE 10 BY 1
     1801        BGCOLOR 8 .
     1802   DEFINE VARIABLE fi-search AS CHARACTER FORMAT "X(256)":U
     1803        VIEW-AS FILL-IN
     1804        SIZE 69.8 BY 1
     1805        FGCOLOR 1  NO-UNDO.
     1806   DEFINE QUERY br-list FOR
     1807         temp_cgrplib_grp SCROLLING.
     1808   DEFINE BROWSE br-list
     1809     QUERY br-list DISPLAY
     1810         temp_cgrplib_grp.sel           format  "X(1)" no-label
     1811         temp_cgrplib_grp.name          format "X(71)"      label " Наименование группы"
     1812         temp_cgrplib_grp.d-pcnt        format  ">9.99"      label " Скидка"
     1813         temp_cgrplib_grp.node-code     FORMAT ">>>,>>>,>>9" LABEL "Вн №"
     1814       WITH NO-ROW-MARKERS SEPARATORS SIZE 93.1 BY 18.
     1815   DEFINE FRAME Dlg-grp
     1816        b-exit AT ROW 1 COL 1
     1817        b-mark AT ROW 1 COL 11
     1818        b-sel AT ROW 1 COL 18
     1819        b-add AT ROW 1 COL 28
     1820        b-chg AT ROW 1 COL 38
     1821        b-del AT ROW 1 COL 48
     1822        b-move AT ROW 1 COL 58
     1823        B-cli AT ROW 1 COL 68
     1824        b-disc AT ROW 1 COL 78 WIDGET-ID 2
     1825        b-print AT ROW 1 COL 89
     1826        B-history AT ROW 1 COL 92
     1827        b-help AT ROW 1 COL 95
     1828        B-rum AT ROW 2 COL 68 WIDGET-ID 4
     1829        b-expand AT ROW 3 COL 1
     1830        b-expand-all AT ROW 3 COL 4.5
     1831        fi-search AT ROW 3 COL 12.5 NO-LABEL
     1832        b-find-by-full-name AT ROW 3 COL 82.5
     1833        b-find-by-substring AT ROW 3 COL 85.5
     1834        b-search AT ROW 3 COL 88.5
     1835        br-list AT ROW 4 COL 1
     1836        SPACE(4.79) SKIP(0.34)
     1837       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1838            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1839            TITLE "Группы клиентов".
     1840   ASSIGN
     1841          FRAME Dlg-grp:SCROLLABLE       = FALSE
     1842          FRAME Dlg-grp:HIDDEN           = TRUE.
     1843   ASSIGN
     1844          b-print:POPUP-MENU IN FRAME Dlg-grp       = MENU MENU-b-print:HANDLE.
     1845   ASSIGN
     1846          B-rum:POPUP-MENU IN FRAME Dlg-grp       = MENU MENU-B-rum:HANDLE.
     1847   ON ENDKEY OF FRAME Dlg-grp
     1848   DO:
     1849         run gbl/markqwa.p (
     1850                              input b-mark:visible
     1851                             , input p-recid-list) no-error.
     1852       if error-status:error then return no-apply.
     1853   END.
     1854   ON WINDOW-CLOSE OF FRAME Dlg-grp
     1855   DO:
     1856     apply "end-error":U to self.
     1857   END.
     1858   ON CHOOSE OF b-add IN FRAME Dlg-grp
     1859   DO:
     1860       run add-grp in this-procedure (
     1861           input temp_cgrplib_grp.node-code
     1862       ) no-error .
     1863       if error-status :error
     1864       then do:
     1865           message
     1866           vss-workfile vss-revision vss-description
     1867           skip "Ошибка добавления группы клиентов."
     1868           skip return-value
     1869           skip trim(error-status :get-message(1))
     1870           trim(error-status :get-message(2))
     1871           trim(error-status :get-message(3))
     1872           trim(error-status :get-message(4))
     1873           trim(error-status :get-message(5))
     1874           view-as alert-box error.
     1875           undo, return no-apply.
     1876       end.
     1877   END.
     1878   ON CHOOSE OF b-chg IN FRAME Dlg-grp
     1879   DO:
     1880       run change-grp in this-procedure (
     1881           input temp_cgrplib_grp.node-code
     1882       ) no-error .
     1883       if error-status :error
     1884       then do:
     1885           message
     1886           vss-workfile vss-revision vss-description
     1887           skip "Ошибка изменения группы клиентов."
     1888           skip return-value
     1889           skip trim(error-status :get-message(1))
     1890           trim(error-status :get-message(2))
     1891           trim(error-status :get-message(3))
     1892           trim(error-status :get-message(4))
     1893           trim(error-status :get-message(5))
     1894           view-as alert-box error.
     1895           undo, return no-apply .
     1896       end.
     1897   END.
     1898   ON CHOOSE OF B-cli IN FRAME Dlg-grp
     1899   DO:
     1900    DEFINE VARIABLE cli-list AS CHARACTER NO-UNDO.
     1901    DEFINE VARIABLE v-grp-list AS CHARACTER NO-UNDO.
     1902    define buffer buf_cli-grp for ub.cli-grp.
     1903   IF AVAILABLE temp_cgrplib_grp THEN DO:
     1904       RUN cli-grplib-get-full-name in this-procedure (input temp_cgrplib_grp.node-code, output v-grp-list) no-error .
     1905       if error-status :error
     1906       then do:
     1907           message
     1908             vss-workfile vss-revision vss-description
     1909             skip "Не найдена группа для показа"
     1910             skip "справочника клиентов."
     1911             skip return-value
     1912             skip trim(error-status :get-message(1))
     1913                  trim(error-status :get-message(2))
     1914                  trim(error-status :get-message(3))
     1915                  trim(error-status :get-message(4))
     1916                  trim(error-status :get-message(5))
     1917           view-as alert-box error.
     1918           undo, return no-apply .
     1919       end.
     1920     find first buf_cli-grp no-lock where
     1921               buf_cli-grp.node-code = temp_cgrplib_grp.node-code no-error.
     1922     assign
     1923     v-old-recid-list = p-recid-list
     1924     v-from-b-cli = yes
     1925     v-old-recid = (if available buf_cli-grp then recid(buf_cli-grp) else ?)
     1926     .
     1927     run ref/cli-all.w (  parparentproc
     1928                         ,input ""
     1929                         ,input ""
     1930                         ,input ('группа':U + chr(3) + v-grp-list)
     1931                         ,input ?
     1932                         ,input ?
     1933                         ,input ?
     1934                         ,input ?
     1935                         ,output cli-list ) .
     1936     run UI-on in this-procedure no-error .
     1937   END.
     1938   END.
     1939   ON CHOOSE OF b-del IN FRAME Dlg-grp
     1940   DO:
     1941       run delete-grp in this-procedure (
     1942             input temp_cgrplib_grp.node-code
     1943           , input yes
     1944       ) no-error .
     1945       if error-status :error
     1946       then do:
     1947           message
     1948           vss-workfile vss-revision vss-description
     1949           skip "Ошибка удаления группы клиентов."
     1950           skip return-value
     1951           skip trim(error-status :get-message(1))
     1952           trim(error-status :get-message(2))
     1953           trim(error-status :get-message(3))
     1954           trim(error-status :get-message(4))
     1955           trim(error-status :get-message(5))
     1956           view-as alert-box error.
     1957           undo, return no-apply .
     1958       end.
     1959   END.
     1960   ON CHOOSE OF b-disc IN FRAME Dlg-grp
     1961   DO:
     1962     IF NOT AVAILABLE temp_cgrplib_grp THEN RETURN NO-APPLY.
     1963     run proc-b-disc IN THIS-PROCEDURE NO-ERROR.
     1964     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1965   END.
     1966   ON CHOOSE OF b-exit IN FRAME Dlg-grp
     1967   DO:
     1968       define variable v-cli-grp-recid     as recid             no-undo.
     1969       run get-current-recid in this-procedure (
     1970             input temp_cgrplib_grp.node-code
     1971           , output v-cli-grp-recid
     1972       ) no-error .
     1973       if error-status :error
     1974       then do:
     1975           message
     1976             vss-workfile vss-revision vss-description
     1977             skip "Не найдена группа для восстановления"
     1978             skip "предыдущего состояния справочника групп."
     1979             skip return-value
     1980             skip trim(error-status :get-message(1))
     1981                  trim(error-status :get-message(2))
     1982                  trim(error-status :get-message(3))
     1983                  trim(error-status :get-message(4))
     1984                  trim(error-status :get-message(5))
     1985           view-as alert-box error.
     1986           undo, return no-apply .
     1987       end.
     1988           run gbl/markqwa.p (
     1989                              input b-mark:visible
     1990                             , input p-recid-list) no-error.
     1991       if error-status:error then return no-apply.
     1992       assign
     1993           cli-grp-row  = v-cli-grp-recid
     1994           p-recid-list = ""
     1995       .
     1996       assign
     1997       v-uf-List_ = (if cli-grp-row = ? then chr(63) else string(cli-grp-row))
     1998       .
     1999       run uf-set in this-procedure(
     2000           input  'cli-grp-p':U
     2001           ,input  v-cntxt-userid
     2002           ,input v-uf-List_
     2003           ,input v-uf-Naim
     2004           ,input v-uf-print-graft
     2005           ,input v-uf-sort-gr
     2006           ,input v-uf-type-price
     2007           ,input v-uf-type-val
     2008       )  no-error .
     2009       apply "WINDOW-CLOSE" TO FRAME Dlg-grp .
     2010   END.
     2011   ON CHOOSE OF b-expand IN FRAME Dlg-grp
     2012   DO:
     2013       if temp_cgrplib_grp.node-code = v-root-code
     2014       then do:
     2015           run collapse-all-on-first-level in this-procedure no-error .
     2016           if error-status :error
     2017           then do:
     2018               message
     2019               vss-workfile vss-revision vss-description
     2020               skip "Ошибка операции с деревом групп."
     2021               skip return-value
     2022               skip trim(error-status :get-message(1))
     2023                   trim(error-status :get-message(2))
     2024                   trim(error-status :get-message(3))
     2025                   trim(error-status :get-message(4))
     2026                   trim(error-status :get-message(5))
     2027               view-as alert-box error.
     2028               undo, return no-apply .
     2029           end.
     2030       end.
     2031       if temp_cgrplib_grp.mark <> "»"
     2032       and temp_cgrplib_grp.mark <> "«"
     2033       then do:
     2034           return no-apply.
     2035       end.
     2036       run expand-or-collapse-item in this-procedure no-error .
     2037       if error-status :error
     2038       then do:
     2039           message
     2040             vss-workfile vss-revision vss-description
     2041             skip "Ошибка операции с деревом групп."
     2042             skip return-value
     2043             skip trim(error-status :get-message(1))
     2044                  trim(error-status :get-message(2))
     2045                  trim(error-status :get-message(3))
     2046                  trim(error-status :get-message(4))
     2047                  trim(error-status :get-message(5))
     2048           view-as alert-box error.
     2049           undo, return no-apply .
     2050       end.
     2051   END.
     2052   ON CHOOSE OF b-expand-all IN FRAME Dlg-grp
     2053   DO:
     2054       run expand-all-from-current in this-procedure (
     2055               input temp_cgrplib_grp.node-code
     2056       ) no-error .
     2057       if error-status :error
     2058       then do:
     2059           message
     2060             vss-workfile vss-revision vss-description
     2061             skip "Ошибка при раскрытии дерева групп."
     2062             skip return-value
     2063             skip trim(error-status :get-message(1))
     2064                  trim(error-status :get-message(2))
     2065                  trim(error-status :get-message(3))
     2066                  trim(error-status :get-message(4))
     2067                  trim(error-status :get-message(5))
     2068           view-as alert-box error.
     2069           undo, return no-apply .
     2070       end.
     2071   END.
     2072   ON CHOOSE OF b-find-by-full-name IN FRAME Dlg-grp
     2073   DO:
     2074       define variable v-new-name as character no-undo.
     2075       run cgrplib-expand-name in this-procedure (
     2076           input fi-search :screen-value
     2077           , output v-new-name
     2078       ) no-error.
     2079       if error-status :error
     2080       then do:
     2081           message return-value.
     2082           undo, return no-apply.
     2083       end.
     2084       if v-new-name = ""
     2085       then do:
     2086           message
     2087               "Не найдена группа с полным именем, начинающимся на"
     2088               skip "'" + fi-search :screen-value + "'"
     2089           view-as alert-box information.
     2090           assign
     2091               v-new-name = fi-search :screen-value
     2092           .
     2093       end.
     2094       assign
     2095           fi-search :screen-value  = right-trim( v-new-name, chr(47) )
     2096           fi-search :cursor-offset = length( v-new-name ) + 1
     2097       .
     2098   END.
     2099   ON LEAVE OF b-find-by-full-name IN FRAME Dlg-grp
     2100   DO:
     2101       assign
     2102           v-found-grp-num  = 0
     2103           b-search :label = "Поиск"
     2104       .
     2105   END.
     2106   ON CHOOSE OF b-find-by-substring IN FRAME Dlg-grp
     2107   DO:
     2108       define variable v-new-name as character no-undo.
     2109       define variable v-new-code as integer   no-undo.
     2110       if v-full-search-next = no
     2111       then do:
     2112           assign
     2113               v-full-search-string     = fi-search :screen-value
     2114               v-full-search-next       = yes
     2115               v-full-search-start-code = 0
     2116           .
     2117       end.
     2118   if session :set-wait-state( "compiler" ) then.
     2119       run cgrplib-find-by-substring in this-procedure (
     2120                             input v-full-search-start-code
     2121                           , input v-full-search-string
     2122                           , output v-new-code
     2123                           , output v-new-name
     2124       ) no-error.
     2125       if error-status :error
     2126       then do:
     2127   if session :set-wait-state( "" ) then.
     2128           message return-value.
     2129           undo, return no-apply.
     2130       end.
     2131   if session :set-wait-state( "" ) then.
     2132       if v-new-code = 0
     2133       then do:
     2134           message
     2135               skip "Не найдена строка '" v-full-search-string "' в имени группы."
     2136           view-as alert-box information
     2137           title "Поиск завершен".
     2138           assign
     2139               v-new-name               = fi-search :screen-value
     2140               v-full-search-string     = ""
     2141               v-full-search-next       = no
     2142               v-full-search-start-code = 0
     2143           .
     2144       end.
     2145       else do:
     2146           assign
     2147               v-full-search-start-code = v-new-code
     2148           .
     2149       end.
     2150       assign
     2151           fi-search :screen-value  = right-trim( v-new-name, chr(47) )
     2152           fi-search :cursor-offset = length( v-new-name ) + 1
     2153       .
     2154   END.
     2155   ON LEAVE OF b-find-by-substring IN FRAME Dlg-grp
     2156   DO:
     2157       assign
     2158           v-found-grp-num  = 0
     2159           b-search :label = "Поиск"
     2160       .
     2161   END.
     2162   ON CHOOSE OF B-history IN FRAME Dlg-grp
     2163   DO:
     2164      define variable rid-list as character no-undo .
     2165       if available temp_cgrplib_grp THEN
     2166      run ref/ccgrphis.w (
     2167                        input parparentproc
     2168                       ,INPUT "":U
     2169                       ,INPUT "cli-grp":U
     2170                       ,INPUT temp_cgrplib_grp.node-code
     2171                       ,INPUT NO
     2172                       ,OUTPUT rid-list
     2173          ) .
     2174       apply "entry" to br-list.
     2175   END.
     2176   ON CHOOSE OF b-mark IN FRAME Dlg-grp
     2177   DO:
     2178       run b-mark-press ( input temp_cgrplib_grp.node-code ) no-error .
     2179       if error-status :error
     2180       then do:
     2181           message
     2182           vss-workfile vss-revision vss-description
     2183           skip "Ошибка выбора в списке групп"
     2184           skip return-value
     2185           skip trim(error-status :get-message(1))
     2186           trim(error-status :get-message(2))
     2187           trim(error-status :get-message(3))
     2188           trim(error-status :get-message(4))
     2189           trim(error-status :get-message(5))
     2190           view-as alert-box error.
     2191           undo, return no-apply .
     2192       end.
     2193   END.
     2194   ON CHOOSE OF b-move IN FRAME Dlg-grp
     2195   DO:
     2196       run select-and-move-item in this-procedure (
     2197               input temp_cgrplib_grp.node-code
     2198       ) no-error .
     2199       if error-status :error
     2200       then do:
     2201           message
     2202             vss-workfile vss-revision vss-description
     2203             skip "Ошибка перемещения группы."
     2204             skip return-value
     2205             skip trim(error-status :get-message(1))
     2206                  trim(error-status :get-message(2))
     2207                  trim(error-status :get-message(3))
     2208                  trim(error-status :get-message(4))
     2209                  trim(error-status :get-message(5))
     2210           view-as alert-box error.
     2211           undo, return no-apply .
     2212       end.
     2213   END.
     2214   ON CHOOSE OF b-print IN FRAME Dlg-grp
     2215   DO:
     2216       run print-grp in this-procedure ( input temp_cgrplib_grp.node-code ) no-error .
     2217       if error-status :error
     2218       then do:
     2219           message
     2220             vss-workfile vss-revision vss-description
     2221             skip "Ошибка печати."
     2222             skip return-value
     2223             skip trim(error-status :get-message(1))
     2224                  trim(error-status :get-message(2))
     2225                  trim(error-status :get-message(3))
     2226                  trim(error-status :get-message(4))
     2227                  trim(error-status :get-message(5))
     2228           view-as alert-box error.
     2229           undo, return no-apply .
     2230       end.
     2231   END.
     2232   ON CHOOSE OF B-rum IN FRAME Dlg-grp
     2233   DO:
     2234     if rum-option = "":U then do:
     2235       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     2236       if error-status :error then do: return no-apply. end.
     2237     end.
     2238     if rum-option = "":U then do:
     2239         return no-apply.
     2240     end.
     2241     RUN proc-b-rum IN THIS-PROCEDURE ( INPUT rum-option) NO-ERROR.
     2242     IF ERROR-STATUS:ERROR THEN DO:
     2243         rum-option = "".
     2244         RETURN NO-APPLY.
     2245     END.
     2246     rum-option = "".
     2247   END.
     2248   ON CHOOSE OF b-search IN FRAME Dlg-grp
     2249   DO:
     2250       run find-grp-in-browse in this-procedure (
     2251           input fi-search :screen-value
     2252       ) no-error.
     2253       if error-status :error
     2254       then do:
     2255           message
     2256             vss-workfile vss-revision vss-description
     2257             skip "Ошибка поиска группы в списке."
     2258             skip return-value
     2259             skip trim(error-status :get-message(1))
     2260                  trim(error-status :get-message(2))
     2261                  trim(error-status :get-message(3))
     2262                  trim(error-status :get-message(4))
     2263                  trim(error-status :get-message(5))
     2264           view-as alert-box error.
     2265           undo, return no-apply.
     2266       end.
     2267   END.
     2268   ON LEAVE OF b-search IN FRAME Dlg-grp
     2269   DO:
     2270       assign
     2271           v-found-grp-num  = 0
     2272           b-search :label = "Поиск"
     2273       .
     2274   END.
     2275   ON CHOOSE OF b-sel IN FRAME Dlg-grp
     2276   DO:
     2277       define variable v-yesno     as logical     init no      no-undo.
     2278       run fill-output-parameters-on-exit in this-procedure ( input temp_cgrplib_grp.node-code ) no-error .
     2279       if error-status :error
     2280       then do:
     2281           message
     2282             vss-workfile vss-revision vss-description
     2283             skip "Ошибка передачи параметров списка групп."
     2284             skip return-value
     2285             skip trim(error-status :get-message(1))
     2286                  trim(error-status :get-message(2))
     2287                  trim(error-status :get-message(3))
     2288                  trim(error-status :get-message(4))
     2289                  trim(error-status :get-message(5))
     2290             skip (1) "Закрыть список групп?"
     2291           view-as alert-box error buttons yes-no update v-yesno.
     2292           if v-yesno = no
     2293           then do:
     2294               undo, return no-apply .
     2295           end.
     2296       end.
     2297       if return-value = "no-term" then return no-apply.
     2298       apply "WINDOW-CLOSE" TO FRAME Dlg-grp .
     2299   END.
     2300   ON + OF br-list IN FRAME Dlg-grp
     2301   DO:
     2302       if temp_cgrplib_grp.mark = "»"
     2303       then do:
     2304           run expand-item in this-procedure ( input temp_cgrplib_grp.node-code, input yes ) no-error .
     2305           if error-status :error
     2306           then do:
     2307               message
     2308                 vss-workfile vss-revision vss-description
     2309                 skip "Не удалось раскрыть подуровни группы."
     2310                 skip return-value
