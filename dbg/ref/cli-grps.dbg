     1367       end CASE.
     1368     end.
     1369   end procedure.
     1370   procedure uf-get :
     1371     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1372     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1373     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1374     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1375     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1376     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1377     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1378     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1379     do
     1380     on error undo, return error
     1381     :
     1382       define buffer buf_usr-flt for ubflt.usr-flt .
     1383       define variable v-use-List_     as logical   no-undo .
     1384       define variable v-type-List_     as character no-undo .
     1385       define variable v-format-List_   as character no-undo .
     1386       define variable v-use-Naim      as logical   no-undo .
     1387       define variable v-type-Naim      as character no-undo .
     1388       define variable v-format-Naim    as character no-undo .
     1389       define variable v-use-print-graft as logical   no-undo .
     1390       define variable v-use-sort-gr     as logical   no-undo .
     1391       define variable v-use-type-price  as logical   no-undo .
     1392       define variable v-use-type-val    as logical   no-undo .
     1393       define variable v-label          as character no-undo .
     1394       define variable v-tooltip        as character no-undo .
     1395       define variable v-user-can-edit  as logical   no-undo .
     1396       define variable v-output-display as logical   no-undo .
     1397       define variable v-other          as character no-undo .
     1398       run uf-name in this-procedure
     1399          (input  entry(1, p-code, chr(4))
     1400         ,output v-use-List_
     1401         ,output v-type-List_
     1402         ,output v-format-List_
     1403         ,output v-use-Naim
     1404         ,output v-type-Naim
     1405         ,output v-format-Naim
     1406         ,output v-use-print-graft
     1407         ,output v-use-sort-gr
     1408         ,output v-use-type-price
     1409         ,output v-use-type-val
     1410         ,output v-label
     1411         ,output v-tooltip
     1412         ,output v-user-can-edit
     1413         ,output v-output-display
     1414         ,output v-other
     1415         ) no-error .
     1416       if error-status :error then do:
     1417         undo, return error return-value .
     1418       end.
     1419       find first buf_usr-flt no-lock where
     1420                  buf_usr-flt.Call-point     = p-code AND
     1421                  buf_usr-flt.user-name       = p-user-name
     1422         no-error .
     1423       if avail buf_usr-flt then do:
     1424         assign
     1425         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1426         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1427         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1428         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1429         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1430         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1431         .
     1432       end.
     1433       else do:
     1434         assign
     1435         p-List_        = (if v-use-List_       then "":U                    else ?)
     1436         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1437         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1438         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1439         p-type-price   = (if v-use-type-price  then no                      else ?)
     1440         p-type-val     = (if v-use-List_       then no                      else ?)
     1441         .
     1442       end.
     1443     end.
     1444   end procedure.
     1445   procedure uf-set :
     1446     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1447     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1448     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1449     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1450     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1451     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1452     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1453     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1454     do
     1455     on error undo, return error
     1456     :
     1457       define buffer buf_usr-flt for ubflt.usr-flt .
     1458       define variable v-use-List_     as logical   no-undo .
     1459       define variable v-type-List_     as character no-undo .
     1460       define variable v-format-List_   as character no-undo .
     1461       define variable v-use-Naim      as logical   no-undo .
     1462       define variable v-type-Naim      as character no-undo .
     1463       define variable v-format-Naim    as character no-undo .
     1464       define variable v-use-print-graft as logical   no-undo .
     1465       define variable v-use-sort-gr   as logical   no-undo .
     1466       define variable v-use-type-price as logical   no-undo .
     1467       define variable v-use-type-val  as logical   no-undo .
     1468       define variable v-tooltip        as character no-undo .
     1469       define variable v-label          as character no-undo .
     1470       define variable v-user-can-edit  as logical   no-undo .
     1471       define variable v-output-display as logical   no-undo .
     1472       define variable v-other          as character no-undo .
     1473       run uf-name in this-procedure
     1474         (input  entry(1, p-code, chr(4))
     1475         ,output v-use-List_
     1476         ,output v-type-List_
     1477         ,output v-format-List_
     1478         ,output v-use-Naim
     1479         ,output v-type-Naim
     1480         ,output v-format-Naim
     1481         ,output v-use-print-graft
     1482         ,output v-use-sort-gr
     1483         ,output v-use-type-price
     1484         ,output v-use-type-val
     1485         ,output v-label
     1486         ,output v-tooltip
     1487         ,output v-user-can-edit
     1488         ,output v-output-display
     1489         ,output v-other
     1490         ) no-error .
     1491       if error-status :error then do:
     1492         undo, return error return-value .
     1493       end.
     1494       find first buf_usr-flt where
     1495                  buf_usr-flt.Call-point     = p-code AND
     1496                  buf_usr-flt.user-name       = p-user-name
     1497         no-error .
     1498       if not avail buf_usr-flt then do:
     1499           create buf_usr-flt .
     1500           assign
     1501           buf_usr-flt.call-point = p-code
     1502           buf_usr-flt.user-name  = p-user-name
     1503           .
     1504       end.
     1505       if avail buf_usr-flt then do:
     1506        assign
     1507        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1508        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1509        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1510        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1511        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1512        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1513       .
     1514       release buf_usr-flt.
     1515       end.
     1516       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1517     end.
     1518   end procedure.
     1519   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1520   define  stream PrnLibStream.
     1521   procedure prn-lib-prn-file :
     1522     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1523     define input parameter p-DIsabledoptions as integer no-undo .
     1524     define variable v-report-name as character no-undo .
     1525     define variable v-user-action as character no-undo .
     1526     define variable v-printed     as logical   no-undo .
     1527     define variable v-exist       as logical   no-undo .
     1528     do
     1529       on error undo, return error
     1530       :
     1531       run prn-lib-get-report-name  in this-procedure (
     1532         input parParentProc
     1533         ,output v-report-name
     1534         ).
     1535   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1536   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1537     (input  v-report-name
     1538     ,input  2
     1539     ,output v-exist
     1540     )  .
     1541       if NOT v-exist then
     1542       DO:
     1543         Message
     1544           "Нет заданий на печать ! "
     1545           view-as alert-box .
     1546         Return  .
     1547       End.
     1548       run gbl/prnfilen.w
     1549         (input  ""
     1550         ,input  p-DisabledOptions
     1551         ,input  string(v-report-name )
     1552         ,input  7
     1553         ,output v-user-action
     1554         ,output v-printed
     1555         ) .
     1556       if v-printed then
     1557       do:
     1558         return "YES" .
     1559       end.
     1560       else
     1561       do:
     1562         return "NO" .
     1563       end.
     1564     end.
     1565   end procedure.
     1566   procedure prn-lib-open-stream :
     1567     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1568     define input parameter p-page-size    as integer no-undo .
     1569     define input parameter p-is-stream    as logical no-undo .
     1570     define input parameter p-append       as logical no-undo .
     1571     define variable v-report-name as character no-undo .
     1572     do
     1573       on error undo, return error
     1574       :
     1575       run prn-lib-get-report-name  in this-procedure (
     1576         input parParentProc
     1577         ,output v-report-name
     1578         ).
     1579       if p-is-stream then
     1580       do:
     1581         if p-append then
     1582         do:
     1583           output stream PrnLibStream to value( v-report-name )
     1584             page-size value(p-page-size) append .
     1585         end.
     1586         if not p-append then
     1587         do:
     1588           output stream PrnLibStream to value( v-report-name )
     1589             page-size value(p-page-size) .
     1590         end.
     1591       end.
     1592       if not p-is-stream then
     1593       do:
     1594         if p-append then
     1595         do:
     1596           output to value( v-report-name )
     1597             page-size value(p-page-size) append .
     1598         end.
     1599         if not p-append then
     1600         do:
     1601           output to value( v-report-name )
     1602             page-size value(p-page-size) .
     1603         end.
     1604       end.
     1605     end.
     1606   end procedure.
     1607   procedure prn-lib-open-exp :
     1608     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1609     define input parameter p-is-stream    as logical no-undo .
     1610     define input parameter p-is-append    as logical no-undo .
     1611     define output parameter p-ReportFileName as char init "report" no-undo.
     1612     define output parameter p-process as logical no-undo .
     1613     define variable glog as logical no-undo .
     1614     do
     1615       on error undo, return error
     1616       :
     1617       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1618         TITLE      "Укажите путь"
     1619         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1620         ASK-OVERWRITE
     1621         CREATE-TEST-FILE
     1622         SAVE-AS
     1623         USE-FILENAME
     1624         DEFAULT-EXTENSION "txt"
     1625         UPDATE glog
     1626         .
     1627       if not glog then  return.
     1628       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1629       if p-is-stream then
     1630       do:
     1631         if p-is-append then
     1632         do:
     1633           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1634         end.
     1635         else
     1636         do:
     1637           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1638         end.
     1639       end.
     1640       else
     1641       do:
     1642         if p-is-append then
     1643         do:
     1644           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1645         end.
     1646         else
     1647         do:
     1648           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1649         end.
     1650       end.
     1651       p-process = yes.
     1652     end.
     1653   end procedure.
     1654   procedure prn-lib-get-report-name :
     1655     define input parameter parParentProc  as widget-handle no-undo.
     1656     define output parameter p-report-name as character no-undo .
     1657     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1658   end procedure.
     1659   procedure prn-lib-reportviewer-report-name :
     1660     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1661     define input parameter p-report-name-html as character no-undo .
     1662     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1663   end procedure.
     1664   procedure prn-lib-reportviewer :
     1665     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1666     define input parameter p-report-name-html as character no-undo .
     1667     define input parameter p-param        as character no-undo .
     1668     define variable v-excel           as character no-undo init 'TRUE' .
     1669     define variable v-value-character as character no-undo .
     1670     define variable v-value-integer   as character no-undo .
     1671     define variable v-value-date      as date      no-undo .
     1672     define variable v-value-decimal   as decimal   no-undo .
     1673     define variable rep-excel         as logical   no-undo .
     1674     define variable excel-string      as character no-undo .
     1675     define variable v-param-type      as character no-undo .
     1676     define variable v-tth             as handle    no-undo .
     1677     run adm/shattri.p (
     1678       input "get":U
     1679       ,input  ""
     1680       ,input  0
     1681       ,input  'report-glob':U
     1682       ,input  'rep-excel':U
     1683       ,output v-value-character
     1684       ,output v-value-date
     1685       ,output v-value-decimal
     1686       ,output v-value-integer
     1687       ,output rep-excel
     1688       ,output v-param-type
     1689       ,INPUT-OUTPUT table-handle v-tth
     1690       )  .
     1691     if rep-excel then v-excel = "TRUE" .
     1692     else v-excel = "FALSE" .
     1693     if p-param eq ""
     1694     then
     1695        p-param = "EXCEL:" + v-excel.
     1696     else
     1697        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1698     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1699   end procedure.
