     2684   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dlg-grp:PARENT eq ?
     2685   THEN FRAME Dlg-grp:PARENT = ACTIVE-WINDOW.
     2686   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2687   on help of frame Dlg-grp
     2688   do:
     2689     run gbl/app_help.p
     2690       (input this-procedure :file-name
     2691       ,input ''
     2692       ,input ?
     2693       ) no-error.
     2694     if error-status :error then do:
     2695       message
     2696         "Ошибка при вызове помощи"
     2697         error-status :get-message(1)
     2698         view-as alert-box .
     2699     end.
     2700   end.
     2701   run minbtn-set in this-procedure .
     2702   on choose of b-help in frame Dlg-grp
     2703   do:
     2704     apply "help":u to frame Dlg-grp .
     2705   end.
     2706   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2707   procedure minbtn-set :
     2708       do
     2709           on error undo, return error return-value
     2710           :
     2711           define variable ii              as integer       no-undo .
     2712           define variable fh              as widget-handle no-undo .
     2713           define variable hh              as widget-handle no-undo .
     2714           define variable v-h             as handle        extent 4 no-undo .
     2715           define variable v-name-button   as character     no-undo .
     2716           define variable v-help-old-x    as decimal       no-undo .
     2717           define variable v-help-old-y    as decimal       no-undo .
     2718           define variable v-help-old-size as decimal       no-undo .
     2719           define variable v-frame-width   as decimal       no-undo .
     2720           define variable jj              as integer       no-undo .
     2721           do
     2722               on error undo, return error
     2723               :
     2724               assign
     2725                   v-frame-width = frame Dlg-grp:width - 0.3
     2726                   fh            = frame Dlg-grp:first-child
     2727                   hh            = fh:first-child
     2728                   ii            = 1
     2729                   .
     2730               do while valid-handle(hh):
     2731                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2732                   do:
     2733                       case lc(hh:name) :
     2734                           when "b-help" then
     2735                               do:
     2736                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2737                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2738                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2739                                   hh:TOOLTIP = "Помощь" .
     2740                                   v-help-old-x = hh:column .
     2741                                   v-help-old-y = hh:row    .
     2742                                   v-help-old-size = hh:width .
     2743                                   hh:width-chars = 2.5 .
     2744                               end.
     2745                           when "b-print" then
     2746                               do:
     2747                                   hh:load-image("cmp/b-print.bmp":u) .
     2748                                   hh:TOOLTIP = "Печать" .
     2749                                   v-h[ii] = hh:handle .
     2750                                   ii = ii + 1 .
     2751                                   hh:width-chars = 3 .
     2752                               end.
     2753                           when "b-history" or
     2754                           when "b-hist" then
     2755                               do:
     2756                                   hh:load-image("cmp/b-hist.bmp":u) .
     2757                                   hh:TOOLTIP = "История" .
     2758                                   v-h[ii] = hh:handle .
     2759                                   ii = ii + 1 .
     2760                                   hh:width-chars = 3 .
     2761                               end.
     2762                           when "b-sch" then
     2763                               do:
     2764                                   hh:load-image("cmp/b-sch.bmp":u) .
     2765                                   hh:TOOLTIP = "Установка Фильтра" .
     2766                                   v-h[ii] = hh:handle .
     2767                                   ii = ii + 1 .
     2768                                   hh:width-chars = 3 .
     2769                               end.
     2770                           when "b-hist-user" then
     2771                               do:
     2772                                   hh:load-image("cmp/b-hist.bmp":u) .
     2773                                   hh:TOOLTIP = "История пользователя" .
     2774                                   ii = ii + 1 .
     2775                               end.
     2776                       end case.
     2777                   end.
     2778                   hh = hh:next-sibling.
     2779               end.
     2780               b-help:column = v-frame-width - b-help:width-chars.
     2781               jj = 0.
     2782               repeat ii = 4 to 1 by -1 :
     2783                   if valid-handle (v-h[ii] ) then
     2784                   do:
     2785                       jj  = jj + 1 .
     2786                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2787                       v-h[ii]:row    = v-help-old-y .
     2788                   end.
     2789               end.
     2790           end.
     2791       end.
     2792   end procedure.
     2793   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2794   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2795   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2796   define variable v-diasize-orig-frame-width     as decimal   no-undo .
