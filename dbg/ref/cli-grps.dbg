     3153         then do:
     3154           undo move_block, retry move_block .
     3155         end.
     3156         if frame Dlg-grp :scrollable = true
     3157         then do:
     3158           assign
     3159             frame Dlg-grp :virtual-height = frame Dlg-grp :virtual-height + p-change-value
     3160             no-error .
     3161           if error-status :error
     3162           or error-status :get-message(1) <> ""
     3163           then do:
     3164             undo move_block, retry move_block .
     3165           end.
     3166         end.
     3167       end.
     3168       if p-move-resize = true
     3169       then do:
     3170         run diasize_position-resize-button in this-procedure .
     3171       end.
     3172       if v-diasize-wndstore = true
     3173       then do:
     3174         if connected("ub") = true
     3175         then do:
     3176           define variable v-cntxt-db-num        as integer   no-undo .
     3177           define variable v-cntxt-userid        as character no-undo .
     3178           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3179                                             , OUTPUT v-cntxt-userid
     3180                                             ) .
     3181           run gbl/wndsizew.p
     3182             (input  v-cntxt-db-num
     3183             ,input  v-cntxt-userid
     3184             ,input  v-diasize-proc-name
     3185             ,input  'height':u
     3186             ,input  string(frame Dlg-grp :height - v-diasize-orig-frame-height)
     3187             ) .
     3188         end.
     3189       end.
     3190     end.
     3191     assign
     3192       v-diasize-change-size = false
     3193     .
     3194   end procedure.
     3195   procedure diasize_set-height :
     3196     define input  parameter p-new-height  as decimal   no-undo .
     3197     define input  parameter p-move-resize as logical   no-undo .
     3198     do
     3199     on error undo, return error return-value
     3200     :
     3201       run diasize_change-height in this-procedure
     3202         (input  (p-new-height - frame Dlg-grp :height)
     3203         ,input  p-move-resize
     3204         ) .
     3205     end.
     3206   end procedure.
     3207   procedure diasize_change-width :
     3208     define input  parameter p-change-value as decimal   no-undo .
     3209     define input  parameter p-move-resize  as logical   no-undo .
     3210     define variable v-field-group-handle   as handle    no-undo .
     3211     define variable v-object-handle        as handle    no-undo .
