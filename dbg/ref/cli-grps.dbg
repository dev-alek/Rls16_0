     3124           end.
     3125         end.
     3126         assign
     3127           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3128           no-error .
     3129         if error-status :error
     3130         or error-status :get-message(1) <> ""
     3131         then do:
     3132           undo move_block, retry move_block .
     3133         end.
     3134         for each buf_temp-browse-handle
     3135           where buf_temp-browse-handle.browse-type = 'height':u
     3136         on error undo move_block, retry move_block
     3137         :
     3138           assign
     3139             buf_temp-browse-handle.browse-handle :height
     3140               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3141             no-error .
     3142           if error-status :error
     3143           or error-status :get-message(1) <> ""
     3144           then do:
     3145             undo move_block, retry move_block .
     3146           end.
     3147         end.
     3148         assign
