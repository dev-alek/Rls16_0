     3387       .
     3388       do while valid-handle(v-field-group-handle)
     3389       :
     3390         assign
     3391           v-object-handle = v-field-group-handle :first-child
     3392         .
     3393         do while valid-handle(v-object-handle)
     3394         :
     3395           if  v-object-handle <> v-diasize-browse-handle :handle
     3396           and v-object-handle <> v-diasize-resize-button
     3397           and can-query(v-object-handle, "row")
     3398           and can-query(v-object-handle, "height")
     3399           and ( v-object-handle :col + v-object-handle :width
     3400                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3401               )
     3402           then do:
     3403             find first buf_temp-browse-handle
     3404               where buf_temp-browse-handle.browse-type   = 'width':u
     3405                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3406               no-error .
     3407             if available buf_temp-browse-handle
     3408             then do:
     3409             end.
     3410             else do:
     3411               create buf_temp-diasize-handle .
     3412               assign
     3413                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3414                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3415               .
     3416             end.
     3417           end.
     3418           assign
     3419             v-object-handle = v-object-handle :next-sibling
     3420           .
     3421         end.
     3422         assign
     3423           v-field-group-handle = v-field-group-handle :next-sibling
     3424         .
     3425       end.
     3426       do with frame Dlg-grp
     3427       :
     3428         hide v-diasize-resize-button .
     3429         v-diasize-resize-button :row = 1.
     3430         v-diasize-resize-button :column = 1.
     3431       end.
     3432       if p-change-value > 0
     3433       then do:
     3434         if frame Dlg-grp :scrollable = true
     3435         then do:
     3436           assign
     3437             frame Dlg-grp :virtual-width = frame Dlg-grp :virtual-width + p-change-value
     3438             no-error .
     3439           if error-status :error
     3440           or error-status :get-message(1) <> ""
     3441           then do:
     3442             undo move_block, retry move_block.
     3443           end.
     3444         end.
     3445         assign
     3446           frame Dlg-grp :width = v-frame-width + p-change-value
     3447           no-error .
     3448         if error-status :error
     3449         or error-status :get-message(1) <> ""
     3450         then do:
     3451           undo move_block, retry move_block.
     3452         end.
     3453         assign
     3454           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3455         no-error .
     3456         if error-status :error
     3457         or error-status :get-message(1) <> ""
     3458         then do:
     3459           undo move_block, retry move_block.
     3460         end.
     3461         for each buf_temp-browse-handle
     3462           where buf_temp-browse-handle.browse-type = 'width':u
     3463         on error undo move_block, retry move_block
     3464         :
     3465           assign
     3466             buf_temp-browse-handle.browse-handle :width
     3467               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3468             no-error .
     3469           if error-status :error
     3470           or error-status :get-message(1) <> ""
     3471           then do:
     3472             undo move_block, retry move_block .
     3473           end.
     3474         end.
     3475         for each buf_temp-diasize-handle
     3476         on error undo move_block, retry move_block
     3477         :
     3478           assign
     3479             v-object-handle = buf_temp-diasize-handle.handle-value
     3480           .
     3481           if v-object-handle <> v-diasize-resize-button
     3482           then do:
     3483             assign
     3484               v-object-handle :col = v-object-handle :col + p-change-value
     3485               no-error .
     3486             if error-status :error
     3487             or error-status :get-message(1) <> ""
     3488             then do:
     3489               undo move_block, retry move_block .
     3490             end.
     3491           end.
     3492         end.
     3493       end.
     3494       else do:
     3495         for each buf_temp-diasize-handle
     3496         on error undo move_block, retry move_block
     3497         :
     3498           assign
     3499             v-object-handle = buf_temp-diasize-handle.handle-value
     3500           .
     3501           if v-object-handle <> v-diasize-resize-button
     3502           then do:
     3503             assign
     3504               v-object-handle :col = v-object-handle :col + p-change-value
     3505               no-error .
     3506             if error-status :error
     3507             or error-status :get-message(1) <> ""
     3508             then do:
     3509               undo move_block, retry move_block .
     3510             end.
     3511           end.
     3512         end.
     3513         for each buf_temp-browse-handle
     3514           where buf_temp-browse-handle.browse-type = 'width':u
     3515         on error undo move_block, retry move_block
     3516         :
     3517           assign
     3518             buf_temp-browse-handle.browse-handle :width
     3519               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3520             no-error .
     3521           if error-status :error
     3522           or error-status :get-message(1) <> ""
     3523           then do:
     3524             undo move_block, retry move_block .
     3525           end.
     3526         end.
     3527         assign
     3528           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3529           no-error .
     3530         if error-status :error
     3531         or error-status :get-message(1) <> ""
     3532         then do:
     3533           undo move_block, retry move_block.
     3534         end.
     3535         assign
     3536           frame Dlg-grp :width = frame Dlg-grp :width + p-change-value
     3537         no-error .
     3538         if error-status :error
     3539         or error-status :get-message(1) <> ""
     3540         then do:
     3541           undo move_block, retry move_block.
     3542         end.
     3543         if frame Dlg-grp :scrollable = true
     3544         then do:
     3545           assign
     3546             frame Dlg-grp :virtual-width = frame Dlg-grp :virtual-width + p-change-value
     3547           no-error .
     3548           if error-status :error
     3549           or error-status :get-message(1) <> ""
     3550           then do:
     3551             undo move_block, retry move_block.
     3552           end.
     3553         end.
     3554       end.
     3555       if p-move-resize
     3556       then do:
     3557         run diasize_position-resize-button in this-procedure .
     3558       end.
     3559       if v-diasize-wndstore = true
     3560       then do:
     3561         if connected("ub") = true
     3562         then do:
     3563           define variable v-cntxt-db-num        as integer   no-undo .
     3564           define variable v-cntxt-userid        as character no-undo .
     3565           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3566                                             , OUTPUT v-cntxt-userid
     3567                                             ) .
     3568           run gbl/wndsizew.p
     3569             (input  v-cntxt-db-num
     3570             ,input  v-cntxt-userid
     3571             ,input  v-diasize-proc-name
     3572             ,input  'width':u
     3573             ,input  string(frame Dlg-grp :width - v-diasize-orig-frame-width)
     3574             ) .
     3575         end.
     3576       end.
     3577     end.
     3578     assign
     3579       v-diasize-change-size = false
     3580     .
     3581   end procedure.
     3582   procedure diasize_set-width :
     3583     define input  parameter p-new-width  as decimal   no-undo .
     3584     define input  parameter p-move-resize as logical   no-undo .
     3585     do
     3586     on error undo, return error return-value
     3587     :
     3588       run diasize_change-width in this-procedure
     3589         (input  (p-new-width - frame Dlg-grp :width)
     3590         ,input  p-move-resize
     3591         ) .
     3592     end.
     3593   end procedure.
     3594   procedure diasize_position-resize-button :
     3595     do with frame Dlg-grp
     3596     :
     3597       hide v-diasize-resize-button .
     3598       assign
     3599         v-diasize-resize-button :row = frame Dlg-grp :height - v-diasize-resize-button :height
     3600                     - 1
     3601                     - (frame Dlg-grp :border-bottom-pixels / session :pixels-per-row)
     3602         v-diasize-resize-button :col = frame Dlg-grp :width - v-diasize-resize-button :width
     3603                     - 1
     3604                     - (frame Dlg-grp :border-right-pixels / session :pixels-per-column)
     3605       .
     3606       view v-diasize-resize-button .
     3607     end.
     3608   end procedure.
     3609   on alt-right anywhere
     3610   do:
     3611     run diasize_change-width in this-procedure
     3612       (input 1
     3613       ,input true
     3614       ) .
     3615     return no-apply .
     3616   end.
     3617   on alt-left anywhere
     3618   do:
     3619     run diasize_change-width in this-procedure
     3620       (input -1
     3621       ,input true
     3622       ) .
     3623     return no-apply .
     3624   end.
     3625   on alt-down anywhere
     3626   do:
     3627     run diasize_change-height in this-procedure
     3628       (input 1
     3629       ,input true
     3630       ) .
     3631     return no-apply .
     3632   end.
     3633   on alt-up anywhere
     3634   do:
     3635     run diasize_change-height in this-procedure
     3636       (input -1
     3637       ,input true
     3638       ) .
     3639     return no-apply .
     3640   end.
     3641   on alt-enter of frame Dlg-grp
     3642   do:
     3643     run diasize_maximize in this-procedure
     3644       (input  ?
     3645       ).
     3646     return no-apply .
     3647   end.
     3648   procedure diasize_end-move :
     3649     do
     3650     on error undo, return error return-value
     3651     :
     3652       define variable v-row-delta as decimal   no-undo .
     3653       define variable v-col-delta as decimal   no-undo .
     3654       define variable v-new-row as decimal   no-undo .
     3655       define variable v-new-col as decimal   no-undo .
     3656       assign
     3657         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3658         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3659       .
     3660       assign
     3661         v-row-delta = v-new-row - frame Dlg-grp :height
     3662         v-col-delta = v-new-col - frame Dlg-grp :width
     3663       .
     3664       run diasize_change-height in this-procedure
     3665         (input v-row-delta
     3666         ,input true
     3667         ) .
     3668       run diasize_change-width in this-procedure
     3669         (input v-col-delta
     3670         ,input true
     3671         ) .
     3672     end.
     3673   end procedure.
     3674   procedure diasize_maximize :
     3675     define input  parameter p-action as logical   no-undo .
     3676     do
     3677     on error undo, return error return-value
     3678     :
     3679       if p-action = ?
     3680       then do:
     3681         if v-diasize-need-maximize = true
     3682         then do:
     3683           assign
     3684             p-action = true
     3685           .
     3686         end.
     3687         else do:
     3688           assign
     3689             p-action = false
     3690           .
     3691         end.
     3692       end.
     3693       if p-action = true
     3694       then do:
     3695         run diasize_change-height in this-procedure
     3696           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3697               - frame Dlg-grp :height-chars
     3698           ,input true
     3699           ) .
     3700         run diasize_change-width in this-procedure
     3701           (input session :width-chars
     3702               - frame Dlg-grp :width-chars
     3703           ,input true
     3704           ) .
     3705         assign
     3706           v-diasize-need-maximize = false
     3707         .
     3708       end.
     3709       else do:
     3710         run diasize_change-width in this-procedure
     3711           (input v-diasize-orig-frame-width
     3712               - frame Dlg-grp :width-chars
     3713           ,input true
     3714           ) .
     3715         run diasize_change-height in this-procedure
     3716           (input v-diasize-orig-frame-height
     3717               - frame Dlg-grp :height-chars
     3718           ,input true
     3719           ) .
     3720         assign
     3721           v-diasize-need-maximize = true
     3722         .
     3723       end.
     3724     end.
     3725   end procedure.
     3726   procedure diasize_restore-orig-size :
     3727     do
     3728     on error undo, return error return-value
     3729     :
     3730       assign
     3731         v-diasize-current-frame-width  = frame Dlg-grp :width
     3732         v-diasize-current-frame-height = frame Dlg-grp :height
     3733       .
     3734       run diasize_set-height in this-procedure
     3735         (input  v-diasize-orig-frame-height
     3736         ,input  true
     3737         ) .
     3738       run diasize_set-width in this-procedure
     3739         (input  v-diasize-orig-frame-width
     3740         ,input  true
     3741         ) .
     3742     end.
     3743   end procedure.
     3744   procedure diasize_restore-current-size :
     3745     do
     3746     on error undo, return error return-value
     3747     :
     3748       run diasize_set-height in this-procedure
     3749         (input  v-diasize-current-frame-height
     3750         ,input  true
     3751         ) .
     3752       run diasize_set-width in this-procedure
     3753         (input  v-diasize-current-frame-width
     3754         ,input  true
     3755         ) .
     3756     end.
     3757   end procedure.
     3758   procedure diasize_set-browse-handle :
     3759     define input  parameter p-browse-handle as handle   no-undo .
     3760     define buffer buf_temp-browse-handle for temp-browse-handle .
     3761     do
     3762     on error undo, return error return-value
     3763     :
     3764       assign
     3765         v-diasize-browse-handle = p-browse-handle
     3766       .
     3767       for each buf_temp-browse-handle
     3768       on error undo, return error return-value
     3769       :
     3770         delete buf_temp-browse-handle .
     3771       end.
     3772     end.
     3773   end procedure.
     3774   procedure diasize_add_browse :
     3775     define input  parameter p-browse-type   as character no-undo .
     3776     define input  parameter p-browse-handle as handle    no-undo .
     3777     define buffer buf_temp-browse-handle for temp-browse-handle .
     3778     do
     3779     on error undo, return error return-value
     3780     :
     3781       assign
     3782         v-diasize-browse-number = v-diasize-browse-number + 1
     3783       .
     3784       create buf_temp-browse-handle .
     3785       assign
     3786         buf_temp-browse-handle.browse-type   = p-browse-type
     3787         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3788         buf_temp-browse-handle.browse-handle = p-browse-handle
     3789       .
     3790     end.
     3791   end procedure.
     3792   procedure diasize_init :
     3793     define variable v-default-value    as logical   no-undo .
     3794     define variable v-restore-saved    as logical   no-undo .
     3795     define variable v-resize-value-str as character no-undo .
     3796     do
     3797     on error undo, return error return-value
     3798     :
     3799       do with frame Dlg-grp
     3800       :
     3801         assign
     3802           v-diasize-orig-frame-height = frame Dlg-grp :height
     3803           v-diasize-orig-frame-width  = frame Dlg-grp :width
     3804           v-diasize-browse-handle     = browse br-list :handle
     3805         .
     3806         create button v-diasize-resize-button
     3807         assign
     3808           parent        = frame Dlg-grp :first-child
     3809           label         = "s"
     3810           height-pixels = 16
     3811           width-pixels  = 16
     3812           visible       = true
     3813           sensitive     = true
     3814           movable       = true
     3815           triggers:
     3816             on end-move persistent run diasize_end-move in this-procedure .
     3817           end triggers.
     3818         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3819         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3820         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3821         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3822         assign
     3823           v-diasize-wndmax = false
     3824         .
     3825         if connected("ub") = true
     3826         then do:
     3827           define variable v-cntxt-db-num        as integer   no-undo .
     3828           define variable v-cntxt-userid        as character no-undo .
     3829           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3830                                             , OUTPUT v-cntxt-userid
     3831                                             ) .
     3832           run gbl/wndpar_r.p
     3833             (input  v-cntxt-db-num
     3834             ,input  v-cntxt-userid
     3835             ,input  'wndmax':U
     3836             ,output v-diasize-wndmax
     3837             ,output v-default-value
     3838             ) .
     3839         end.
     3840         assign
     3841           v-diasize-wndstore = false
     3842         .
     3843         if connected("ub") = true
     3844         then do:
     3845           run gbl/wndpar_r.p
     3846             (input  v-cntxt-db-num
     3847             ,input  v-cntxt-userid
     3848             ,input  'wndstore':U
     3849             ,output v-diasize-wndstore
     3850             ,output v-default-value
     3851             ) .
     3852         end.
     3853         assign
     3854           v-diasize-proc-name = entry(1, program-name(2), '.')
     3855         .
     3856         if v-diasize-wndstore = true
     3857         then do:
     3858           assign
     3859             v-restore-saved = false
     3860           .
     3861           if connected("ub") = true
     3862           then do:
     3863             run gbl/wndsizer.p
     3864               (input  v-cntxt-db-num
     3865               ,input  v-cntxt-userid
     3866               ,input  v-diasize-proc-name
     3867               ,input  'height':u
     3868               ,output v-resize-value-str
     3869               ) .
     3870             if v-resize-value-str <> '':U
     3871             then do:
     3872               run diasize_change-height in this-procedure
     3873                 (input  integer(v-resize-value-str)
     3874                 ,input  true
     3875                 ) .
     3876               assign
     3877                 v-restore-saved = true
     3878               .
     3879             end.
     3880           end.
     3881           if connected("ub") = true
     3882           then do:
     3883             run gbl/wndsizer.p
     3884               (input  v-cntxt-db-num
     3885               ,input  v-cntxt-userid
     3886               ,input  v-diasize-proc-name
     3887               ,input  'width':u
     3888               ,output v-resize-value-str
     3889               ) .
     3890             if v-resize-value-str <> '':U
     3891             then do:
     3892               run diasize_change-width in this-procedure
     3893                 (input  integer(v-resize-value-str)
     3894                 ,input  true
     3895                 ) .
     3896               assign
     3897                 v-restore-saved = true
     3898               .
     3899             end.
     3900           end.
     3901           if v-restore-saved <> true
     3902           then do:
     3903             if v-diasize-wndmax = true
     3904             then do:
     3905               run diasize_maximize in this-procedure
     3906                 (input  true
     3907                 ) .
     3908             end.
     3909           end.
     3910         end.
     3911         else do:
     3912           if v-diasize-wndmax = true
     3913           then do:
     3914             run diasize_maximize in this-procedure
     3915               (input  true
     3916               ) .
     3917           end.
     3918         end.
     3919       end.
     3920     end.
     3921   end procedure.
     3922   procedure diasize_need-full-display :
     3923     define output parameter p-need-full-display as logical   no-undo .
     3924     do
     3925     on error undo, return error return-value
     3926     :
     3927       assign
     3928         p-need-full-display = v-diasize-need-full-display
     3929       .
     3930       assign
     3931         v-diasize-need-full-display = false
     3932       .
     3933     end.
     3934   end procedure.
     3935   procedure get-context :
     3936      define output parameter p-db-num as integer          no-undo.
     3937      define output parameter p-user-id as character        no-undo.
     3938      define variable v-login               as character    no-undo.
     3939      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3940      define buffer buf_user-login  for ub.user-login .
     3941      do
     3942      on error undo, return error
     3943      :
     3944            FIND FIRST buf_sys-ctrl no-lock.
     3945            ASSIGN
     3946               v-login = USERID("ub")
     3947               p-db-num = buf_sys-ctrl.db-num
     3948            .
     3949            FIND FIRST buf_user-login
     3950                 WHERE buf_user-login.db-num = p-db-num
     3951                   AND buf_user-login.user-login = v-login
     3952                 no-lock
     3953                 no-error
     3954                 .
     3955            IF AVAILABLE buf_user-login
     3956            THEN DO:
     3957               assign
     3958                  p-user-id = buf_user-login.user-id
     3959               .
     3960            END.
     3961      end.
     3962   end procedure.
     3963       run diasize_init in this-procedure .
     3964   MAIN-BLOCK:
     3965   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3966      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3967   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3968     run mainmenu_getcntxt in parparentproc
     3969       (output v-cntxt-db-num
     3970       ,output v-cntxt-userid
     3971       ,output v-cntxt-level
     3972       ,output v-cntxt-host-code-obj
     3973       ,output v-cntxt-obj-type
     3974       ,output v-cntxt-obj-code
     3975       ,output v-cntxt-db-num-obj
     3976       ,output v-cntxt-is-admin
     3977       ) .
     3978     run UI-on in this-procedure no-error .
     3979     if error-status :error
     3980     then do:
     3981         message
     3982           vss-workfile vss-revision vss-description
     3983           skip "Ошибка при загрузке дерева групп."
     3984           skip return-value
     3985           skip trim(error-status :get-message(1))
     3986                trim(error-status :get-message(2))
     3987                trim(error-status :get-message(3))
     3988                trim(error-status :get-message(4))
     3989                trim(error-status :get-message(5))
     3990         view-as alert-box error.
     3991         undo, return error .
     3992     end.
     3993     apply "entry" to br-list.
     3994     WAIT-FOR GO OF FRAME Dlg-grp.
     3995   END.
     3996   RUN disable_UI.
     3997   PROCEDURE add-grp :
     3998   do
     3999   on error undo, return error
     4000   :
     4001   define input parameter p-node-code  as integer      no-undo.
     4002       define variable v-cli-grp-recid     as recid    no-undo.
     4003       define variable v-focused-row       as integer  no-undo.
     4004       define variable v-repositioned-row  as integer  no-undo.
     4005       define variable v-have-clients        as logical  no-undo.
     4006       define variable v-have-rights       as logical       no-undo.
     4007       define buffer buf_cli-grp           for ub.cli-grp.
     4008       define buffer buf_temp_cgrplib_grp   for temp_cgrplib_grp.
     4009       run check-rights-for-change-grp in this-procedure (
     4010            input p-node-code
     4011           ,output v-have-rights
     4012       ) no-error.
     4013       if error-status :error
     4014       or v-have-rights = no
     4015       then do:
     4016           message
     4017             vss-workfile vss-revision vss-description
     4018             skip "Нет прав на изменение справочника групп клиентов."
     4019             skip "Удаление группы невозможно."
     4020             skip return-value
     4021             skip trim(error-status :get-message(1))
     4022                  trim(error-status :get-message(2))
     4023                  trim(error-status :get-message(3))
     4024           view-as alert-box error.
     4025           undo, return error .
     4026       end.
     4027       assign
     4028           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     4029           v-repositioned-row = current-result-row( "br-list" )
     4030       .
     4031       run cgrplib-have-clients in this-procedure ( input p-node-code, output v-have-clients ) no-error .
     4032       if error-status :error
     4033       then do:
     4034           undo, return error "add-grp: Ошибка определения наличия клиентов в группе." + chr(10) + return-value.
     4035       end.
     4036       if v-have-clients = yes
     4037       then do:
     4038           message "В данной группе есть клиенты. Добавить в нее подгруппу,"
     4039                   "включающую этих клиентов ?"
     4040           view-as alert-box question
     4041           buttons OK-Cancel
     4042           update v-yesno as logical.
     4043           if v-yesno = no
     4044           then do:
     4045               apply "entry" to br-list in frame Dlg-grp.
     4046               return no-apply.
     4047           end.
     4048       end.
     4049       find first buf_temp_cgrplib_grp
     4050            where buf_temp_cgrplib_grp.node-code = p-node-code
     4051       no-error .
     4052       if not available buf_temp_cgrplib_grp
     4053       then do:
     4054           undo, return error "add-grp: Не найдена группа в browse.".
     4055       end.
     4056       if buf_temp_cgrplib_grp.mark = "»"
     4057       then do:
     4058           run expand-item in this-procedure ( input p-node-code, input no ) no-error.
     4059           if error-status :error
     4060           then do:
     4061               undo, return error "add-grp: Не удается раскрыть группу.".
     4062           end.
     4063       end.
     4064       run ref/c-grp-f.w (   input parparentproc
     4065                       , input 'ДОБАВЛЕНИЕ':U
     4066                       , input p-node-code
     4067                       , input-output v-cli-grp-recid
     4068                     ) no-error .
     4069       if v-cli-grp-recid = ?
     4070       then do:
     4071           apply "entry" to br-list in frame Dlg-grp.
     4072           return no-apply.
     4073       end.
     4074       find first buf_cli-grp
     4075            where recid ( buf_cli-grp ) =  v-cli-grp-recid
     4076       no-error.
     4077       if not available buf_cli-grp
     4078       then do:
     4079           undo, return error "add-grp: Ошибка добавления группы.".
     4080       end.
     4081       run create-new-line in this-procedure (
     4082                             input buf_cli-grp.node-code
     4083                           , input buf_cli-grp.upper-code
     4084                           , input buf_temp_cgrplib_grp.level + 1
     4085                           , input buf_cli-grp.node-name
     4086       ) no-error .
     4087       if error-status :error
     4088       then do:
     4089           undo, return error "add-grp: Ошибка добавления строки в список групп.".
     4090       end.
     4091       if buf_temp_cgrplib_grp.level > 0
     4092       then do:
     4093           assign
     4094           buf_temp_cgrplib_grp.mark = "«"
     4095           buf_temp_cgrplib_grp.name = substring( buf_temp_cgrplib_grp.name, 1, buf_temp_cgrplib_grp.level * 4 )
     4096                               + "«"
     4097                               + substring( buf_temp_cgrplib_grp.name, buf_temp_cgrplib_grp.level * 4 + 2 )
     4098           buf_temp_cgrplib_grp.d-pcnt = 0
     4099           .
     4100       end.
     4101       OPEN QUERY br-list FOR EACH temp_cgrplib_grp NO-LOCK by temp_cgrplib_grp.sort-name.
     4102       br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     4103       reposition br-list to row v-repositioned-row.
     4104   end.
     4105   END PROCEDURE.
     4106   PROCEDURE b-mark-press :
     4107   do
     4108   on error undo, return error
     4109   :
     4110   define input parameter p-node-code as integer      no-undo.
     4111       define variable v-focused-row       as integer              no-undo.
     4112       define variable v-repositioned-row  as integer              no-undo.
     4113       define buffer buf_temp_cgrplib_grp       for temp_cgrplib_grp.
     4114       define buffer buf_upper_temp_cgrplib_grp for temp_cgrplib_grp.
     4115       find first buf_temp_cgrplib_grp
     4116            where buf_temp_cgrplib_grp.node-code = p-node-code
     4117       no-error .
     4118       if not available buf_temp_cgrplib_grp
     4119       then do:
     4120           undo, return error "b-mark-press: Ошибка поиска группы".
     4121       end.
     4122       assign
     4123           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     4124           v-repositioned-row = current-result-row( "br-list" )
     4125       .
     4126       if buf_temp_cgrplib_grp.sel = "*"
     4127       or p-node-code = v-root-code
     4128       then do:
     4129           assign
     4130               buf_temp_cgrplib_grp.sel = ""
     4131           .
     4132       end.
     4133       else do:
     4134           assign
     4135               buf_temp_cgrplib_grp.sel = "*"
     4136           .
     4137           for each buf_upper_temp_cgrplib_grp
     4138               where buf_upper_temp_cgrplib_grp.level < buf_temp_cgrplib_grp.level
     4139                 and buf_upper_temp_cgrplib_grp.full-name = substring( buf_temp_cgrplib_grp.full-name, 1
     4140                                                           , length( buf_upper_temp_cgrplib_grp.full-name ) )
     4141           :
     4142               assign
     4143                   buf_upper_temp_cgrplib_grp.sel = ""
     4144               .
     4145           end.
     4146           for each buf_upper_temp_cgrplib_grp
     4147              where buf_upper_temp_cgrplib_grp.node-code <> buf_temp_cgrplib_grp.node-code
     4148                and buf_upper_temp_cgrplib_grp.full-name begins buf_temp_cgrplib_grp.full-name
     4149           :
     4150               assign
     4151                   buf_upper_temp_cgrplib_grp.sel = ""
     4152               .
     4153           end.
     4154       end.
     4155       OPEN QUERY br-list FOR EACH temp_cgrplib_grp NO-LOCK by temp_cgrplib_grp.sort-name.
     4156       if v-focused-row > br-list :height - 2
     4157       then do:
     4158           assign
     4159               v-repositioned-row  = v-repositioned-row + 1
     4160           .
     4161       end.
     4162       else do:
     4163           assign
     4164               v-focused-row       = v-focused-row + 1
     4165               v-repositioned-row  = v-repositioned-row + 1
     4166           .
     4167       end.
     4168       br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     4169       reposition br-list to row v-repositioned-row no-error.
     4170   end.
     4171   END PROCEDURE.
     4172   PROCEDURE change-grp :
     4173   do
     4174   on error undo, return error
     4175   :
     4176   define input parameter p-node-code  as integer      no-undo.
     4177       define variable v-cli-grp-recid     as recid    no-undo.
     4178       define variable v-focused-row       as integer  no-undo.
     4179       define variable v-repositioned-row  as integer  no-undo.
     4180       define variable v-have-rights       as logical       no-undo.
     4181       define variable v-d-pcnt            as decimal           no-undo.
     4182       define variable v-old-full-name     as character     no-undo.
     4183       define buffer buf_cli-grp                   for ub.cli-grp.
     4184       define buffer buf_temp_cgrplib_grp          for temp_cgrplib_grp.
     4185       define buffer buf_child_temp_cgrplib_grp    for temp_cgrplib_grp.
     4186       run check-rights-for-change-grp in this-procedure (
     4187            input p-node-code
     4188           ,output v-have-rights
     4189       ) no-error.
     4190       if error-status :error
     4191       or v-have-rights = no
     4192       then do:
     4193           message
     4194             vss-workfile vss-revision vss-description
     4195             skip "Нет прав на изменение справочника групп клиентов."
     4196             skip "Удаление группы невозможно."
     4197             skip return-value
     4198             skip trim(error-status :get-message(1))
     4199                  trim(error-status :get-message(2))
     4200                  trim(error-status :get-message(3))
     4201           view-as alert-box error.
     4202           undo, return error .
     4203       end.
     4204       assign
     4205           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     4206           v-repositioned-row = current-result-row( "br-list" )
     4207       .
     4208       find first buf_cli-grp no-lock
     4209            where buf_cli-grp.node-code = p-node-code
     4210       no-error.
     4211       if error-status :error
     4212       then do:
     4213           undo, return error "change-grp: Неверный выбор группы.".
     4214       end.
     4215       assign
     4216           v-cli-grp-recid = recid( buf_cli-grp )
     4217       .
     4218       run ref/c-grp-f.w ( input parparentproc, input 'ИЗМЕНЕНИЕ':U, input p-node-code, input-output v-cli-grp-recid ).
     4219       if v-cli-grp-recid = ?
     4220       then do:
     4221           find first buf_temp_cgrplib_grp
     4222               where buf_temp_cgrplib_grp.node-code = p-node-code
     4223           no-error.
     4224           if not available buf_temp_cgrplib_grp
     4225           then do:
     4226               undo, return error "change-grp: Ошибка поиска группы в списке.".
     4227           end.
     4228           browse br-list:refresh().
     4229           apply "entry" to br-list in frame Dlg-grp.
     4230           return no-apply.
     4231       end.
     4232       find first buf_temp_cgrplib_grp
     4233            where buf_temp_cgrplib_grp.node-code = p-node-code
     4234       no-error.
     4235       if not available buf_temp_cgrplib_grp
     4236       then do:
     4237           undo, return error "change-grp: Ошибка поиска группы в списке.".
     4238       end.
     4239       find first buf_cli-grp no-lock
     4240            where buf_cli-grp.node-code = p-node-code
     4241       no-error.
     4242       if error-status :error
     4243       then do:
     4244           undo, return error "change-grp: Неверный выбор группы.".
     4245       end.
     4246       if buf_temp_cgrplib_grp.level > 0
     4247       then do:
     4248           assign
     4249               buf_temp_cgrplib_grp.name    = substring( buf_temp_cgrplib_grp.name
     4250                                                       , 1
     4251                                                       , buf_temp_cgrplib_grp.level * 4 + 2 )
     4252                                               + buf_cli-grp.node-name
     4253           .
     4254       end.
     4255       else do:
     4256           assign
     4257               buf_temp_cgrplib_grp.name    = buf_cli-grp.node-name
     4258           .
     4259       end.
     4260       assign
     4261           v-old-full-name             = buf_temp_cgrplib_grp.full-name
     4262       .
     4263       run cli-grplib-get-full-name in this-procedure (
     4264             input p-node-code
     4265           , output buf_temp_cgrplib_grp.full-name
     4266       ) no-error .
     4267       if error-status :error
     4268       then do:
     4269           undo, return error "Ошибка вычисления полного имени группы в списке".
     4270       end.
     4271       run cli-grplib-get-sort-name in this-procedure (
     4272             input p-node-code
     4273           , output buf_temp_cgrplib_grp.sort-name
     4274       ) no-error .
     4275       if error-status :error
     4276       then do:
     4277           undo, return error "Ошибка вычисления полного имени группы в списке".
     4278       end.
     4279       if buf_temp_cgrplib_grp.level <> 0
     4280       then do:
     4281           assign
     4282               fi-search :screen-value = right-trim( buf_temp_cgrplib_grp.full-name, chr(47) )
     4283           .
     4284       end.
     4285       for each buf_child_temp_cgrplib_grp
     4286          where buf_child_temp_cgrplib_grp.full-name begins v-old-full-name
     4287            and buf_child_temp_cgrplib_grp.full-name <> v-old-full-name
     4288            and buf_child_temp_cgrplib_grp.level <> buf_temp_cgrplib_grp.level
     4289       :
     4290           run cli-grplib-get-full-name in this-procedure (
     4291                 input buf_child_temp_cgrplib_grp.node-code
     4292               , output buf_child_temp_cgrplib_grp.full-name
     4293           ) no-error .
     4294           if error-status :error
     4295           then do:
     4296               undo, return error "Ошибка вычисления полного имени группы в списке".
     4297           end.
     4298           run cli-grplib-get-sort-name in this-procedure (
     4299                 input buf_child_temp_cgrplib_grp.node-code
     4300               , output buf_child_temp_cgrplib_grp.sort-name
     4301           ) no-error .
     4302           if error-status :error
     4303           then do:
     4304               undo, return error "Ошибка вычисления полного имени группы в списке".
     4305           end.
     4306       end.
     4307       OPEN QUERY br-list FOR EACH temp_cgrplib_grp NO-LOCK by temp_cgrplib_grp.sort-name.
     4308       br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     4309       reposition br-list to row v-repositioned-row.
     4310   end.
     4311   END PROCEDURE.
     4312   PROCEDURE check-rights-for-change-grp :
     4313   do
     4314   on error undo, return error
     4315   :
     4316   define input parameter p-node-code as integer no-undo.
     4317   define output parameter p-have-rights   as logical      no-undo.
     4318       define variable v-enable-change-grp as logical       no-undo.
     4319       if v-cntxt-db-num <> 0
     4320       then do:
     4321           message
     4322             vss-workfile vss-revision vss-description
     4323             skip "Операция определена только в ГБД."
     4324             skip return-value
     4325             skip trim(error-status :get-message(1))
     4326                  trim(error-status :get-message(2))
     4327                  trim(error-status :get-message(3))
     4328           view-as alert-box error.
     4329           assign
     4330               p-have-rights = no
     4331           .
     4332       end.
     4333       else do:
     4334   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4335   do:
     4336     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4337       (input  v-cntxt-db-num
     4338       ,input  v-cntxt-userid
     4339       ,input  0
     4340       ,input  'actn_reference_groups-edit':U
     4341       ,input  'firm':U
     4342       ,input  v-cntxt-host-code-obj
     4343       ,input  '':U
     4344       ,input  0
     4345       ,input  0
     4346       ,input  p-node-code
     4347       ,input  0
     4348       ,input  no
     4349       ,output p-have-rights
     4350       )  .
     4351   end.
     4352       end.
     4353   end.
     4354   END PROCEDURE.
     4355   PROCEDURE cli-grps_rum-fill_cb :
     4356   DEFINE INPUT PARAMETER p-target-bh AS handle NO-UNDO.
     4357   define input parameter p-processed-bh as handle no-undo .
     4358   define variable v-start-node-code as integer no-undo .
     4359   define variable v-full-name as character no-undo .
     4360   define buffer buf_temp_cgrplib_grp for temp_cgrplib_grp.
     4361   define buffer buf_cli-grp for ub.cli-grp.
     4362   define buffer child_cli-grp for ub.cli-grp.
     4363   CASE rum-option:
     4364     WHEN "all" THEN DO:
     4365        FOR EACH buf_cli-grp:
     4366           p-target-bh:BUFFER-CREATE.
     4367           p-target-bh:BUFFER-COPY(BUFFER buf_cli-grp:HANDLE).
     4368           run cli-grplib-get-full-name in this-procedure ( input buf_cli-grp.node-code, output v-full-name) no-error.
     4369           p-target-bh::full-name = v-full-name.
     4370           p-target-bh:BUFFER-RELEASE.
     4371        END.
     4372     END.
     4373     WHEN "current" THEN DO:
     4374       if available temp_cgrplib_grp then do:
     4375         find first buf_cli-grp no-lock
     4376               where buf_cli-grp.node-code = temp_cgrplib_grp.node-code
     4377         no-error .
     4378         if error-status :error
     4379         then do:
     4380             undo, return error "cli-grps_rum-fill_cb: Не найдена запись выбранной группы '"
     4381                                 + "'" + temp_cgrplib_grp.full-name + "'".
     4382         end.
     4383         p-target-bh:find-first ( substitute("where node-code = &1", buf_cli-grp.node-code)) no-error .
     4384         if not p-target-bh:available then do:
     4385           p-target-bh:BUFFER-CREATE.
     4386           p-target-bh:BUFFER-COPY(BUFFER buf_cli-grp:HANDLE).
     4387           run cli-grplib-get-full-name in this-procedure ( input buf_cli-grp.node-code, output v-full-name) no-error.
     4388           p-target-bh::full-name = v-full-name.
     4389           p-target-bh:BUFFER-RELEASE.
     4390         end.
     4391       END.
     4392     END.
     4393     WHEN "current+childs" THEN DO:
     4394       if available temp_cgrplib_grp then do:
     4395         find first buf_cli-grp no-lock
     4396               where buf_cli-grp.node-code = temp_cgrplib_grp.node-code
     4397         no-error .
     4398         if error-status :error
     4399         then do:
     4400             undo, return error "cli-grps_rum-fill_cb: Не найдена запись выбранной группы '"
     4401                                 + "'" + temp_cgrplib_grp.full-name + "'".
     4402         end.
     4403         v-start-node-code = buf_cli-grp.node-code.
     4404         p-target-bh:find-first ( substitute("where node-code = &1", buf_cli-grp.node-code)) no-error .
     4405         if not p-target-bh:available then do:
     4406           p-target-bh:BUFFER-CREATE.
     4407           p-target-bh:BUFFER-COPY(BUFFER buf_cli-grp:HANDLE).
     4408           run cli-grplib-get-full-name in this-procedure ( input buf_cli-grp.node-code, output v-full-name) no-error.
     4409           p-target-bh::full-name = v-full-name.
     4410           p-target-bh:BUFFER-RELEASE.
     4411           p-processed-bh:BUFFER-CREATE.
     4412           p-processed-bh::node-code = buf_cli-grp.node-code.
     4413           p-processed-bh:BUFFER-COPY(BUFFER buf_cli-grp:HANDLE).
     4414           p-processed-bh::processed = no.
     4415           p-processed-bh:BUFFER-RELEASE.
     4416         end.
     4417         process-nodes:
     4418         do while yes
     4419         :
     4420             p-processed-bh:find-first( substitute(" where node-code = &1", v-start-node-code)).
     4421             p-processed-bh::processed = yes.
     4422             for each child_cli-grp no-lock
     4423               where child_cli-grp.upper-code = v-start-node-code
     4424             on error undo, return error
     4425             :
     4426               p-target-bh:find-first ( substitute("where node-code = &1", child_cli-grp.node-code)) no-error .
     4427               if not p-target-bh:available then do:
     4428                 p-target-bh:BUFFER-CREATE.
     4429                 p-target-bh:BUFFER-COPY(BUFFER child_cli-grp:HANDLE).
     4430                 run cli-grplib-get-full-name in this-procedure ( input child_cli-grp.node-code, output v-full-name) no-error.
     4431                 p-target-bh::full-name = v-full-name.
     4432                 p-target-bh:BUFFER-RELEASE.
     4433               end.
     4434               p-processed-bh:BUFFER-CREATE.
     4435               p-processed-bh::node-code = child_cli-grp.node-code.
     4436               p-processed-bh::processed = no.
     4437               p-processed-bh:BUFFER-RELEASE.
     4438             end.
     4439             p-processed-bh:find-first( "where processed = no") no-error.
     4440             if not p-processed-bh:available
     4441             then do:
     4442               leave process-nodes.
     4443             end.
     4444             else do:
     4445               assign
     4446               v-start-node-code = p-processed-bh::node-code
     4447               .
     4448             end.
     4449         end.
     4450       END.
     4451     END.
     4452     WHEN "selected" THEN DO:
     4453       FOR EACH buf_temp_cgrplib_grp
     4454          where buf_temp_cgrplib_grp.sel = "*"
     4455       :
     4456           find first buf_cli-grp no-lock
     4457                where buf_cli-grp.node-code = buf_temp_cgrplib_grp.node-code
     4458           no-error .
     4459           if error-status :error
     4460           then do:
     4461               undo, return error "cli-grps_rum-fill_cb: Не найдена запись выбранной группы '"
     4462                                   + "'" + buf_temp_cgrplib_grp.full-name + "'".
     4463           end.
     4464         p-target-bh:find-first ( substitute("where node-code = &1", buf_cli-grp.node-code)) no-error .
     4465         if not p-target-bh:available then do:
     4466            p-target-bh:BUFFER-CREATE.
     4467            p-target-bh:BUFFER-COPY(BUFFER buf_cli-grp:HANDLE).
     4468            run cli-grplib-get-full-name in this-procedure ( input buf_cli-grp.node-code, output v-full-name) no-error.
     4469            p-target-bh::full-name = v-full-name.
     4470            p-target-bh:BUFFER-RELEASE.
     4471         end.
     4472       END.
     4473     END.
     4474     WHEN "selected+child" THEN DO:
     4475       FOR EACH buf_temp_cgrplib_grp
     4476          where buf_temp_cgrplib_grp.sel = "*"
     4477       :
     4478         find first buf_cli-grp no-lock
     4479               where buf_cli-grp.node-code = buf_temp_cgrplib_grp.node-code
     4480         no-error .
     4481         if error-status :error
     4482         then do:
     4483             undo, return error "cli-grps_rum-fill_cb: Не найдена запись выбранной группы '"
     4484                                 + "'" + buf_temp_cgrplib_grp.full-name + "'".
     4485         end.
     4486         p-target-bh:find-first ( substitute("where node-code = &1", buf_cli-grp.node-code)) no-error .
     4487         if not p-target-bh:available then do:
     4488           p-target-bh:BUFFER-CREATE.
     4489           p-target-bh:BUFFER-COPY(BUFFER buf_cli-grp:HANDLE).
     4490           run cli-grplib-get-full-name in this-procedure ( input buf_cli-grp.node-code, output v-full-name) no-error.
     4491           p-target-bh::full-name = v-full-name.
     4492           p-target-bh:BUFFER-RELEASE.
     4493           p-processed-bh:BUFFER-CREATE.
     4494           p-processed-bh::node-code = buf_cli-grp.node-code.
     4495           p-processed-bh::processed = no.
     4496           p-processed-bh:BUFFER-RELEASE.
     4497         end.
     4498         process-nodes:
     4499         do while yes
     4500         :
     4501             p-processed-bh:find-first( substitute(" where node-code = &1", v-start-node-code)).
     4502             p-processed-bh::processed = yes.
     4503             for each child_cli-grp no-lock
     4504               where child_cli-grp.upper-code = v-start-node-code
     4505             on error undo, return error
     4506             :
     4507               p-target-bh:find-first ( substitute("where node-code = &1", child_cli-grp.node-code)) no-error .
     4508               if not p-target-bh:available then do:
     4509                 p-target-bh:BUFFER-CREATE.
     4510                 p-target-bh:BUFFER-COPY(BUFFER child_cli-grp:HANDLE).
     4511                 run cli-grplib-get-full-name in this-procedure ( input child_cli-grp.node-code, output v-full-name) no-error.
     4512                 p-target-bh::full-name = v-full-name.
     4513                 p-target-bh:BUFFER-RELEASE.
     4514               end.
     4515               p-processed-bh:BUFFER-CREATE.
     4516               p-processed-bh::node-code = child_cli-grp.node-code.
     4517               p-processed-bh::processed = no.
     4518               p-processed-bh:BUFFER-RELEASE.
     4519             end.
     4520             p-processed-bh:find-first( "where processed = no") no-error.
     4521             if not p-processed-bh:available
     4522             then do:
     4523               leave process-nodes.
     4524             end.
     4525             else do:
     4526               assign
     4527               v-start-node-code = p-processed-bh::node-code
     4528               .
     4529             end.
     4530         end.
     4531       END.
     4532     END.
     4533   END CASE.
     4534   END PROCEDURE.
     4535   PROCEDURE collapse-all-on-first-level :
     4536   do
     4537   on error undo, return error
     4538   :
     4539       define buffer buf_cli-grp       for ub.cli-grp.
     4540       define buffer buf_temp_cgrplib_grp       for temp_cgrplib_grp.
     4541       for each buf_temp_cgrplib_grp no-lock
     4542          where buf_temp_cgrplib_grp.upper-code = v-root-code
     4543       :
     4544           run collapse-item in this-procedure (
     4545                 input buf_temp_cgrplib_grp.node-code
     4546               , input no
     4547           ) no-error .
     4548           if error-status :error
     4549           then do:
     4550               undo, return error "Не удалось закрыть подуровни группы "
     4551                                   + chr(10) + "'" + buf_temp_cgrplib_grp.full-name + "'"
     4552                                   + chr(10) + return-value.
     4553           end.
     4554       end.
     4555       OPEN QUERY br-list FOR EACH temp_cgrplib_grp NO-LOCK by temp_cgrplib_grp.sort-name.
     4556   end.
     4557   END PROCEDURE.
     4558   PROCEDURE collapse-item :
     4559   do
     4560   on error undo, return error
     4561   :
     4562   define input parameter p-node-code as integer      no-undo.
     4563   define input parameter p-refresh    as logical      no-undo.
     4564       define variable v-focused-row       as integer              no-undo.
     4565       define variable v-repositioned-row  as integer              no-undo.
     4566       define buffer buf_del_temp_cgrplib_grp   for temp_cgrplib_grp.
     4567       define buffer buf_temp_cgrplib_grp       for temp_cgrplib_grp.
     4568       find first buf_temp_cgrplib_grp
     4569            where buf_temp_cgrplib_grp.node-code = p-node-code
     4570       no-error.
     4571       if error-status :error
     4572       then do:
     4573           undo, return error "collapse-item: Неверно передан код группы. Нет группы с кодом " + string( p-node-code ).
     4574       end.
     4575       assign
     4576           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     4577           v-repositioned-row = current-result-row( "br-list" )
     4578       .
     4579       for each buf_del_temp_cgrplib_grp
     4580          where buf_del_temp_cgrplib_grp.full-name begins buf_temp_cgrplib_grp.full-name
     4581            and buf_del_temp_cgrplib_grp.full-name <> buf_temp_cgrplib_grp.full-name
     4582            and buf_del_temp_cgrplib_grp.level     <> buf_temp_cgrplib_grp.level
     4583       :
     4584           delete buf_del_temp_cgrplib_grp.
     4585       end.
     4586       assign
     4587           buf_temp_cgrplib_grp.mark = "»"
     4588           buf_temp_cgrplib_grp.name = replace( buf_temp_cgrplib_grp.name
     4589                                           , "«"
     4590                                           , "»"
     4591                                           )
     4592       .
     4593       if p-refresh = yes
     4594       then do:
     4595           OPEN QUERY br-list FOR EACH temp_cgrplib_grp NO-LOCK by temp_cgrplib_grp.sort-name.
     4596           br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     4597           reposition br-list to row v-repositioned-row.
     4598       end.
     4599   end.
     4600   END PROCEDURE.
     4601   PROCEDURE create-new-line :
     4602   do
     4603   on error undo, return error
     4604   :
     4605   define input parameter p-node-code      as integer      no-undo.
     4606   define input parameter p-upper-code     as integer      no-undo.
     4607   define input parameter p-level          as integer      no-undo.
     4608   define input parameter p-node-name      as character    no-undo.
     4609   define variable v-full-name         as character         no-undo.
     4610   define variable v-sort-name         as character         no-undo.
     4611   define buffer buf_temp_cgrplib_grp       for temp_cgrplib_grp.
     4612       run cli-grplib-get-full-name in this-procedure (
     4613                 input p-node-code
     4614               , output v-full-name
     4615       ) no-error .
     4616       if error-status :error
     4617       then do:
     4618           undo, return error "create-new-line: Ошибка вычисления полного имени группы." .
     4619       end.
     4620       run cli-grplib-get-sort-name in this-procedure (
     4621                 input p-node-code
     4622               , output v-sort-name
     4623       ) no-error .
     4624       if error-status :error
     4625       then do:
     4626           undo, return error "create-new-line: Ошибка вычисления полного имени группы." .
     4627       end.
     4628       create buf_temp_cgrplib_grp.
     4629       assign
     4630           buf_temp_cgrplib_grp.node-code   = p-node-code
     4631           buf_temp_cgrplib_grp.upper-code  = p-upper-code
     4632           buf_temp_cgrplib_grp.level       = p-level
     4633           buf_temp_cgrplib_grp.full-name   = v-full-name
     4634           buf_temp_cgrplib_grp.sort-name   = v-sort-name
     4635       .
     4636       run get-first-char in this-procedure (
     4637                                                 input p-node-code
     4638                                               , output buf_temp_cgrplib_grp.mark
     4639                                            ) no-error.
     4640       if error-status :error
     4641       then do:
     4642           undo, return error "create-new-line: Ошибка вычисления первого символа для отображения группы." .
     4643       end.
     4644       assign
     4645           buf_temp_cgrplib_grp.name = fill( " ", 4 * p-level )
     4646                                           + buf_temp_cgrplib_grp.mark
     4647                                           + " "
     4648                                           + p-node-name
     4649       .
     4650       run cgrplib-get-pcnt-value in this-procedure ( input p-node-code, output buf_temp_cgrplib_grp.d-pcnt) no-error.
     4651       if error-status :error
     4652       then do:
     4653           undo, return error "create-new-line: Ошибка вычисления скидки для группы." .
     4654       end.
     4655   end.
     4656   END PROCEDURE.
     4657   PROCEDURE delete-grp :
     4658   do
     4659   on error undo, return error
     4660   :
     4661   define input parameter p-node-code  as integer      no-undo.
     4662   define input parameter p-refresh    as logical      no-undo.
     4663       define variable v-cli-grp-recid     as recid    no-undo.
     4664       define variable v-focused-row       as integer  no-undo.
     4665       define variable v-repositioned-row  as integer  no-undo.
     4666       define variable v-upper-code        as integer  no-undo.
     4667       define variable v-answer            as logical  no-undo.
     4668       define variable v-is-terminal       as logical  no-undo.
     4669       define variable v-have-clients      as logical  no-undo.
     4670       define variable v-counter           as integer  no-undo.
     4671       define variable v-have-rights       as logical  no-undo.
     4672       define buffer buf_cli-grp           for ub.cli-grp.
     4673       define buffer buf_same_cli-grp      for ub.cli-grp.
     4674       define buffer buf_temp_cgrplib_grp   for temp_cgrplib_grp.
     4675       run check-rights-for-change-grp in this-procedure (
     4676            input p-node-code
     4677           ,output v-have-rights
     4678       ) no-error.
     4679       if error-status :error
     4680       or v-have-rights = no
     4681       then do:
     4682           message
     4683             vss-workfile vss-revision vss-description
     4684             skip "Нет прав на изменение справочника групп клиентов."
     4685             skip "Удаление группы невозможно."
     4686             skip return-value
     4687             skip trim(error-status :get-message(1))
     4688                  trim(error-status :get-message(2))
     4689                  trim(error-status :get-message(3))
     4690           view-as alert-box error.
     4691           undo, return error .
     4692       end.
     4693       assign
     4694           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     4695           v-repositioned-row = current-result-row( "br-list" )
     4696       .
     4697       if p-node-code = v-root-code
     4698       then do:
     4699           message
     4700               "Нельзя удалить корневую группу."
     4701           view-as alert-box.
     4702           undo, return.
     4703       end.
     4704       find first buf_temp_cgrplib_grp
     4705            where buf_temp_cgrplib_grp.node-code = p-node-code
     4706       no-error .
     4707       if error-status :error
     4708       then do:
     4709           undo, return error "Неверно выбрана группа." .
     4710       end.
     4711       if buf_temp_cgrplib_grp.upper-code = v-root-code
     4712       then do:
     4713           assign
     4714               v-counter = v-counter + 1
     4715           .
     4716           count-first-level-grp:
     4717           for each buf_cli-grp no-lock
     4718              where buf_cli-grp.upper-code = v-root-code
     4719           :
     4720               assign
     4721                   v-counter = v-counter + 1
     4722               .
     4723               if v-counter > 1
     4724               then do:
     4725                   leave count-first-level-grp.
     4726               end.
     4727               else do:
     4728                   message
     4729                       "Нельзя удалить последнюю группу первого уровня."
     4730                   view-as alert-box.
     4731                   return error.
     4732               end.
     4733           end.
     4734       end.
     4735       find first buf_cli-grp no-lock
     4736            where buf_cli-grp.node-code = p-node-code
     4737       no-error.
     4738       if error-status :error
     4739       then do:
     4740           undo, return error "change-grp: Нет группы БД, соответствующей значению в списке.".
     4741       end.
     4742       assign
     4743           v-upper-code    = buf_cli-grp.upper-code
     4744           v-answer        = no
     4745       .
     4746       run cgrplib-is-terminal in this-procedure ( input p-node-code, output v-is-terminal ) no-error.
     4747       if error-status :error
     4748       then do:
     4749           undo, return error return-value.
     4750       end.
     4751       if v-is-terminal = no
     4752       then do:
     4753           for each buf_cli-grp
     4754           where buf_cli-grp.upper-code = v-upper-code
     4755             and buf_cli-grp.node-code <> p-node-code
     4756           :
     4757               find first buf_same_cli-grp no-lock
     4758                   where buf_same_cli-grp.upper-code  = p-node-code
     4759                   and buf_same_cli-grp.node-name   = buf_cli-grp.node-name
     4760               no-error.
     4761               if available buf_same_cli-grp
     4762               then do:
     4763                   message
     4764                       "Одна из подгрупп удаляемой группы имеет название:" buf_cli-grp.node-name "-" skip
     4765                       "такое же, как одна из соседних к удаляемой групп." skip
     4766                       "После удаления получились бы 2 группы на одном уровне, имеющие одинаковые названия, что запрещено."
     4767                   view-as alert-box error.
     4768                   return no-apply.
     4769               end.
     4770           end.
     4771           message "Текущая группа будет удалена."
     4772               skip "Ее подгруппы будут перенесены в вышестоящую группу."
     4773               skip (1) "Слить группу с вышестоящей?"
     4774           view-as alert-box question buttons yes-no update v-answer.
     4775       end.
     4776       if v-is-terminal = yes
     4777       then do:
     4778           run cgrplib-have-clients in this-procedure ( input p-node-code, output v-have-clients ) no-error .
     4779           if error-status :error
     4780           then do:
     4781               undo, return error "delete-grp: Ошибка определения наличия клиентов в группе." + chr(10) + return-value.
     4782           end.
     4783           if v-have-clients = yes
     4784           then do:
     4785               find first buf_cli-grp no-lock
     4786                    where buf_cli-grp.upper-code = v-upper-code
     4787                      and buf_cli-grp.node-code <> p-node-code
     4788               no-error .
     4789               if available buf_cli-grp
     4790               then do:
     4791                   message "В одной группе не могут быть одновременно подгруппы и клиенты."
     4792                       skip "Эта группа не может быть слита с вышестоящей."
     4793                   view-as alert-box error.
     4794                   apply "entry" to br-list in frame Dlg-grp.
     4795                   return no-apply.
     4796               end.
     4797               message "Текущая группа будет удалена."
     4798                   skip "Товары будут перенесены в вышестоящую группу."
     4799                   skip (1) "Слить группу с вышестоящей?"
     4800               view-as alert-box question buttons yes-no update v-answer.
     4801           end.
     4802           else do:
     4803               message "Удалить группу ? Вы уверены ?"
     4804               view-as alert-box question buttons yes-no update v-answer.
     4805           end.
     4806       end.
     4807       if not v-answer
     4808       then do:
     4809           apply "entry" to br-list in frame Dlg-grp.
     4810           return no-apply.
     4811       end.
     4812       delete-from-base:
     4813       do
     4814       ON ERROR UNDO delete-from-base, return no-apply
     4815       ON stop UNDO delete-from-base, return no-apply:
     4816           find first buf_cli-grp exclusive-lock
     4817                where buf_cli-grp.node-code = p-node-code
     4818           no-error.
     4819           if error-status :error
     4820           then do:
     4821               undo, return error "change-grp: Нет группы БД, соответствующей значению в списке.".
     4822           end.
     4823           delete buf_cli-grp.
     4824       end.
     4825       if p-refresh = yes
     4826       then do:
     4827           find first buf_cli-grp no-lock
     4828                where buf_cli-grp.node-code = v-upper-code
     4829           no-error.
     4830           if not available buf_cli-grp
     4831           then do:
     4832               undo, return error "delete-grp: Не найдена группа в БД".
     4833           end.
     4834           assign
     4835               p-recid-list = string( recid( buf_cli-grp ) )
     4836               cli-grp-row  = recid( buf_cli-grp )
     4837           .
     4838           run UI-on in this-procedure no-error .
     4839           if error-status :error
     4840           then do:
     4841               undo, return error "delete-grp: Ошибка при загрузке дерева групп.".
     4842           end.
     4843       end.
     4844   end.
     4845   END PROCEDURE.
     4846   PROCEDURE disable_UI :
     4847     HIDE FRAME Dlg-grp.
     4848   END PROCEDURE.
     4849   PROCEDURE enable_UI :
     4850     DISPLAY fi-search
     4851         WITH FRAME Dlg-grp.
     4852     ENABLE b-exit b-mark b-sel b-add b-chg b-del b-move B-cli b-disc b-print
     4853            B-history b-help B-rum b-expand b-expand-all fi-search
     4854            b-find-by-full-name b-find-by-substring b-search br-list
     4855         WITH FRAME Dlg-grp.
     4856     VIEW FRAME Dlg-grp.
     4857     OPEN QUERY br-list FOR EACH temp_cgrplib_grp NO-LOCK by temp_cgrplib_grp.sort-name.
     4858   END PROCEDURE.
     4859   PROCEDURE expand-all-from-current :
     4860   do
     4861   on error undo, return error
     4862   :
     4863   define input parameter p-node-code as integer      no-undo.
     4864       define variable v-full-name     as character         no-undo.
     4865       define variable v-focused-row       as integer              no-undo.
     4866       define variable v-repositioned-row  as integer              no-undo.
     4867       define buffer buf_temp_cgrplib_grp       for temp_cgrplib_grp.
     4868       assign
     4869           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     4870           v-repositioned-row = current-result-row( "br-list" )
     4871       .
     4872       run cli-grplib-get-full-name in this-procedure (
     4873                 input p-node-code
     4874               , output v-full-name
     4875       ) no-error .
     4876       if error-status :error
     4877       then do:
     4878           undo, return error "expand-all-from-current: Ошибка вычисления полного имени группы".
     4879       end.
     4880       for each buf_temp_cgrplib_grp
     4881          where buf_temp_cgrplib_grp.full-name begins v-full-name
     4882       :
     4883           run expand-item in this-procedure ( input buf_temp_cgrplib_grp.node-code, input no ) no-error .
     4884           if error-status :error
     4885           then do:
     4886               undo, return error "expand-all-from-current: Не удалось раскрыть подуровни группы.".
     4887           end.
     4888       end.
     4889       OPEN QUERY br-list FOR EACH temp_cgrplib_grp NO-LOCK by temp_cgrplib_grp.sort-name.
     4890       br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     4891       reposition br-list to row v-repositioned-row.
     4892   end.
     4893   END PROCEDURE.
     4894   PROCEDURE expand-item :
     4895   do
     4896   on error undo, return error
     4897   :
     4898   define input parameter p-node-code  as integer      no-undo.
     4899   define input parameter p-refresh    as logical      no-undo.
     4900       define variable v-focused-row       as integer              no-undo.
     4901       define variable v-repositioned-row  as integer              no-undo.
     4902       define buffer buf_cli-grp           for ub.cli-grp.
     4903       define buffer buf_temp_cgrplib_grp   for temp_cgrplib_grp.
     4904       assign
     4905           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     4906           v-repositioned-row = current-result-row( "br-list" )
     4907       .
     4908       find first buf_temp_cgrplib_grp
     4909            where buf_temp_cgrplib_grp.node-code = p-node-code
     4910       no-error .
     4911       if not available buf_temp_cgrplib_grp
     4912       then do:
     4913           undo, return error "expand-item: Неверно задан код группы.".
     4914       end.
     4915       if buf_temp_cgrplib_grp.mark <> "»"
     4916       then do:
     4917       end.
     4918       else do:
     4919           for each buf_cli-grp no-lock
     4920              where buf_cli-grp.upper-code = p-node-code
     4921           on error undo, return error
     4922           :
     4923               run create-new-line in this-procedure (
     4924                                     input buf_cli-grp.node-code
     4925                                   , input buf_cli-grp.upper-code
     4926                                   , input buf_temp_cgrplib_grp.level + 1
     4927                                   , input buf_cli-grp.node-name
     4928               ) no-error .
     4929               if error-status :error
     4930               then do:
     4931                   message
     4932                   vss-workfile vss-revision vss-description
     4933                   skip "expand-item: Ошибка добавления строки в список групп."
     4934                   skip return-value
     4935                   skip trim(error-status :get-message(1))
     4936                       trim(error-status :get-message(2))
     4937                       trim(error-status :get-message(3))
     4938                       trim(error-status :get-message(4))
     4939                       trim(error-status :get-message(5))
     4940                   view-as alert-box error.
     4941                   undo, return error .
     4942               end.
     4943           end.
     4944           assign
     4945               buf_temp_cgrplib_grp.mark = "«"
     4946               buf_temp_cgrplib_grp.name = replace( buf_temp_cgrplib_grp.name
     4947                                               , "»"
     4948                                               , "«"
     4949                                               )
     4950           .
     4951           if p-refresh = yes
     4952           then do:
     4953               OPEN QUERY br-list FOR EACH temp_cgrplib_grp NO-LOCK by temp_cgrplib_grp.sort-name.
     4954               if v-focused-row > br-list :height - 2
     4955               then do:
     4956                   assign
     4957                       v-focused-row       = br-list :height - 2
     4958                   .
     4959               end.
     4960               br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     4961               reposition br-list to row v-repositioned-row.
     4962           end.
     4963       end.
     4964   end.
     4965   END PROCEDURE.
     4966   PROCEDURE expand-or-collapse-item :
     4967   do
     4968   on error undo, return error
     4969   :
     4970       case temp_cgrplib_grp.mark
     4971       :
     4972       when "»"
     4973       then do:
     4974           run expand-item in this-procedure ( input temp_cgrplib_grp.node-code, input yes ) no-error .
     4975           if error-status :error
     4976           then do:
     4977               undo, return error "Не удалось раскрыть подуровни группы.".
     4978           end.
     4979       end.
     4980       when "«"
     4981       then do:
     4982           run collapse-item in this-procedure ( input temp_cgrplib_grp.node-code, input yes ) no-error .
     4983           if error-status :error
     4984           then do:
     4985               undo, return error "Не удалось закрыть подуровни группы.".
     4986           end.
     4987       end.
     4988       end case.
     4989   end.
     4990   END PROCEDURE.
     4991   PROCEDURE expand-tree-for-grp :
     4992   do
     4993   on error undo, return error
     4994   :
     4995   define input parameter p-node-code              as integer          no-undo.
     4996   define output parameter p-focused-row           as integer          no-undo.
     4997   define output parameter p-reposition-row        as integer          no-undo.
     4998   define output parameter p-reposition-to-recid   as logical init no  no-undo.
     4999   define variable v-full-name             as character        no-undo.
     5000   define buffer buf_temp_cgrplib_grp       for temp_cgrplib_grp.
     5001       run cli-grplib-get-full-name in this-procedure ( input p-node-code, output v-full-name ) no-error .
     5002       if error-status :error
     5003       then do:
     5004       end.
     5005       else do:
     5006           run cgrplib-find-grp-by-full-name in this-procedure ( input right-trim( v-full-name, chr(47) ), input yes ) no-error .
     5007           if error-status :error
     5008           then do:
     5009           end.
     5010           else do:
     5011               process-initial-grp:
     5012               for each temp_cgrplib_found-grp
     5013               break by temp_cgrplib_found-grp.level
     5014               on error undo, leave process-initial-grp :
     5015                   if last ( temp_cgrplib_found-grp.level )
     5016                   then do:
     5017                       assign
     5018                           p-focused-row       = integer( br-list :height in frame Dlg-grp / 2 ) + 1
     5019                       .
     5020                       find first buf_temp_cgrplib_grp
     5021                            where buf_temp_cgrplib_grp.node-code = temp_cgrplib_found-grp.node-code
     5022                       no-error .
     5023                       if error-status :error
     5024                       then do:
     5025                           leave process-initial-grp.
     5026                       end.
     5027                       assign
     5028                           p-reposition-row = recid( buf_temp_cgrplib_grp )
     5029                           p-reposition-to-recid = yes
     5030                       .
     5031                       leave process-initial-grp.
     5032                   end.
     5033                   else do:
     5034                       run expand-item in this-procedure ( input temp_cgrplib_found-grp.node-code, input no ) no-error .
     5035                       if error-status :error
     5036                       then do:
     5037                           leave process-initial-grp.
     5038                       end.
     5039                       find first buf_temp_cgrplib_grp
     5040                               where buf_temp_cgrplib_grp.node-code = temp_cgrplib_found-grp.node-code
     5041                       no-error .
     5042                       if error-status :error
     5043                       then do:
     5044                           leave process-initial-grp.
     5045                       end.
     5046                       assign
     5047                           p-reposition-row = recid( buf_temp_cgrplib_grp )
     5048                           p-reposition-to-recid = yes
     5049                       .
     5050                   end.
     5051               end.
     5052           end.
     5053       end.
     5054   end.
     5055   END PROCEDURE.
     5056   PROCEDURE fill-output-parameters-on-exit :
     5057   do
     5058   on error undo, return error
     5059   :
     5060   define input parameter p-node-code as integer      no-undo.
     5061       define variable v-selected      as logical  init no  no-undo.
     5062       define variable v-is-terminal    as logical           no-undo.
     5063       define buffer buf_cli-grp           for ub.cli-grp.
     5064       define buffer buf_temp_cgrplib_grp   for temp_cgrplib_grp.
     5065       run cgrplib-is-terminal in this-procedure ( input p-node-code, output v-is-terminal ) no-error.
     5066       if error-status :error
     5067       then do:
     5068           undo, return error "fill-output-parameters-on-exit: Не удается определить, корневая группа или терминальная." + chr(10) + return-value.
     5069       end.
     5070       if lookup ( 'терм':U, p-button-list ) <> 0 and v-is-terminal = no
     5071       then do:
     5072               message "Требуется выбрать группу клиентов, в которой нет других групп.".
     5073               apply "entry" to br-list in frame Dlg-grp.
     5074               undo, return "no-term".
     5075       end.
     5076       assign
     5077           p-recid-list = ""
     5078       .
     5079       for each buf_temp_cgrplib_grp
     5080          where buf_temp_cgrplib_grp.sel = "*"
     5081       :
     5082           find first buf_cli-grp no-lock
     5083                where buf_cli-grp.node-code = buf_temp_cgrplib_grp.node-code
     5084           no-error .
     5085           if error-status :error
     5086           then do:
     5087               undo, return error "fill-output-parameters-on-exit: Не найдена запись выбранной группы '"
     5088                                   + "'" + buf_temp_cgrplib_grp.full-name + "'".
     5089           end.
     5090           assign
     5091               p-recid-list = p-recid-list + ( if p-recid-list = "" then "" else "," ) + string( recid( buf_cli-grp ) )
     5092               v-selected = yes
     5093           .
     5094       end.
     5095       if v-selected = no
     5096       then do:
     5097           find first buf_cli-grp no-lock
     5098                where buf_cli-grp.node-code = p-node-code
     5099           no-error .
     5100           if not available buf_cli-grp
     5101           then do:
     5102               find first buf_temp_cgrplib_grp
     5103                    where buf_temp_cgrplib_grp.node-code = p-node-code
     5104               no-error .
     5105               if not available buf_temp_cgrplib_grp
     5106               then do:
     5107                   undo, return error "fill-output-parameters-on-exit: Неверно выбрана группа с кодом "
     5108                                       + string( p-node-code ).
     5109               end.
     5110               undo, return error "fill-output-parameters-on-exit: Не найдена запись выбранной группы '"
     5111                               + buf_temp_cgrplib_grp.full-name + "'".
     5112           end.
     5113           assign
     5114               p-recid-list = string( recid( buf_cli-grp ) )
     5115           .
     5116       end.
     5117       assign
     5118           cli-grp-row  = integer( entry( 1, p-recid-list ) )
     5119       .
     5120       assign
     5121       v-uf-List_ = (if cli-grp-row = ? then chr(63) else string(cli-grp-row))
     5122       .
     5123       run uf-set in this-procedure(
     5124           input  'cli-grp-p':U
     5125           ,input  v-cntxt-userid
     5126           ,input v-uf-List_
     5127           ,input v-uf-Naim
     5128           ,input v-uf-print-graft
     5129           ,input v-uf-sort-gr
     5130           ,input v-uf-type-price
     5131           ,input v-uf-type-val
     5132       )  no-error .
     5133   end.
     5134   END PROCEDURE.
     5135   PROCEDURE fill-tt :
     5136   do
     5137   on error undo, return error
     5138   :
     5139   define input parameter parnode-code like ub.cli-grp.node-code no-undo .
     5140   define input parameter parupper-code like ub.cli-grp.node-code no-undo .
     5141   end.
     5142   END PROCEDURE.
     5143   PROCEDURE find-grp-in-browse :
     5144   do
     5145   on error undo, return error
     5146   :
     5147   define input parameter p-search-grp-full-name as character    no-undo.
     5148       define variable v-focused-row       as integer              no-undo.
     5149       define variable v-repositioned-row  as integer              no-undo.
     5150       define variable v-counter           as integer              no-undo.
     5151       define variable v-level             as integer              no-undo.
     5152       define buffer buf_temp_cgrplib_grp       for temp_cgrplib_grp.
     5153       assign
     5154           v-focused-row      = br-list :focused-row in frame Dlg-grp.
     5155           v-repositioned-row = current-result-row( "br-list" )
     5156       .
     5157       assign
     5158       v-level = num-entries( right-trim(p-search-grp-full-name, chr(47) ) , chr(47))
     5159       .
     5160       if v-found-grp-num  <> 0
     5161       then do:
     5162           assign
     5163               v-counter = 0
     5164           .
     5165           find first temp_cgrplib_found-grp
     5166                where temp_cgrplib_found-grp.level = v-level
     5167           no-error .
     5168           if not available temp_cgrplib_found-grp
     5169           then do:
     5170               undo, return error "Не найдено ни одной группы уровня " + string( v-level ).
     5171           end.
     5172           do v-counter = 1 to v-found-grp-num
     5173           :
     5174               find next temp_cgrplib_found-grp
     5175                   where temp_cgrplib_found-grp.level = v-level
     5176               no-error .
     5177               if not available temp_cgrplib_found-grp
     5178               then do:
     5179                   undo, return error "Не найдена следующая группа уровня " + string( v-level ).
     5180               end.
     5181           end.
     5182           find first buf_temp_cgrplib_grp
     5183                   where buf_temp_cgrplib_grp.node-code = temp_cgrplib_found-grp.node-code
     5184           no-error .
     5185           if not available buf_temp_cgrplib_grp
     5186           then do:
     5187               undo, return error "Найденной группы нет в списке групп".
     5188           end.
     5189           OPEN QUERY br-list FOR EACH temp_cgrplib_grp NO-LOCK by temp_cgrplib_grp.sort-name.
     5190           br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     5191           reposition br-list to recid recid( buf_temp_cgrplib_grp ).
     5192       end.
     5193       else do:
     5194           run cgrplib-find-grp-by-full-name (
     5195               input fi-search :screen-value in frame Dlg-grp
     5196               , input yes
     5197           ) no-error.
     5198           if error-status :error
     5199           then do:
     5200               undo, return error "Не удалось найти группу '" + fi-search :screen-value in frame Dlg-grp + "'".
     5201           end.
     5202           found-group:
     5203           for each temp_cgrplib_found-grp no-lock
     5204           by temp_cgrplib_found-grp.level
     5205           :
     5206               if temp_cgrplib_found-grp.level = v-level
     5207               then do:
     5208                   leave.
     5209               end.
     5210               run expand-item in this-procedure ( input temp_cgrplib_found-grp.node-code, input no ).
     5211           end.
     5212           find first temp_cgrplib_found-grp
     5213               where temp_cgrplib_found-grp.level = v-level
     5214           no-error .
     5215           if not available temp_cgrplib_found-grp
     5216           then do:
     5217               undo, return error "Нет последней найденной группы для уровня " + string( v-level ).
     5218           end.
     5219           find first buf_temp_cgrplib_grp
     5220               where buf_temp_cgrplib_grp.node-code = temp_cgrplib_found-grp.node-code
     5221           no-error .
     5222           if not available buf_temp_cgrplib_grp
     5223           then do:
     5224               undo, return error "Найденной группы нет в списке групп".
     5225           end.
     5226           OPEN QUERY br-list FOR EACH temp_cgrplib_grp NO-LOCK by temp_cgrplib_grp.sort-name.
     5227           br-list :set-repositioned-row(v-focused-row, "ALWAYS") in frame Dlg-grp.
     5228           reposition br-list to recid recid( buf_temp_cgrplib_grp ).
     5229       end.
     5230       find next temp_cgrplib_found-grp
     5231           where temp_cgrplib_found-grp.level = v-level
     5232       no-error .
     5233       if available temp_cgrplib_found-grp
     5234       then do:
     5235           assign
     5236               v-found-grp-num  = v-found-grp-num + 1
     5237               b-search :label = "Далее"
     5238           .
     5239       end.
     5240       else do:
     5241           assign
     5242               v-found-grp-num  = 0
     5243               b-search :label = "Поиск"
     5244           .
     5245       end.
     5246   end.
     5247   END PROCEDURE.
     5248   PROCEDURE get-current-recid :
     5249   do
     5250   on error undo, return error
     5251   :
     5252   define input parameter p-node-code as integer      no-undo.
     5253   define output parameter p-cli-grp-recid as recid   no-undo.
     5254       define buffer buf_cli-grp       for ub.cli-grp.
     5255       find first buf_cli-grp no-lock
     5256            where buf_cli-grp.node-code = p-node-code
     5257       no-error .
     5258       if not available buf_cli-grp
     5259       then do:
     5260           undo, return error "get-current-recid: Не найдена группа." .
     5261       end.
     5262       assign
     5263           p-cli-grp-recid = recid( buf_cli-grp )
     5264       .
     5265   end.
     5266   END PROCEDURE.
     5267   PROCEDURE get-first-char :
     5268   do
     5269   on error undo, return error
     5270   :
     5271   define input parameter p-node-code  as integer      no-undo.
     5272   define output parameter p-prefix    as character    no-undo.
     5273   define variable v-name          as character    no-undo.
     5274   define variable v-is-terminal   as logical      no-undo.
     5275   define variable v-have-clients  as logical      no-undo.
     5276   define buffer buf_cli-grp               for ub.cli-grp.
     5277   define buffer buf_temp_cgrplib_grp       for temp_cgrplib_grp.
     5278   run cgrplib-is-terminal in this-procedure (
     5279                 input p-node-code
     5280               , output v-is-terminal
     5281   ) no-error .
     5282   if error-status :error
     5283   then do:
     5284       undo, return error "get-first-char: Ошибка при определении типа группы (терм/корн).".
     5285   end.
     5286   if v-is-terminal = yes
     5287   then do:
     5288       run cgrplib-have-clients in this-procedure ( input p-node-code, output v-have-clients ) no-error .
     5289       if error-status :error
     5290       then do:
     5291           undo, return error "get-first-char: Ошибка определения наличия клиентов в группе." + chr(10) + return-value.
     5292       end.
     5293       if v-have-clients = yes
     5294       then do:
     5295           assign
     5296               p-prefix = "•"
     5297           .
     5298       end.
     5299       else do:
     5300           assign
     5301               p-prefix = " "
     5302           .
     5303       end.
     5304   end.
     5305   else do:
     5306       find first buf_temp_cgrplib_grp no-lock
     5307            where buf_temp_cgrplib_grp.upper-code = p-node-code
     5308       no-error.
     5309       if available buf_temp_cgrplib_grp
     5310       then do:
     5311           assign
     5312               p-prefix = "«"
     5313           .
     5314       end.
     5315       else do:
     5316           assign
     5317               p-prefix = "»"
     5318           .
     5319       end.
     5320   end.
     5321   end.
     5322   END PROCEDURE.
     5323   PROCEDURE get-row-amount :
     5324   do
     5325   on error undo, return error
     5326   :
     5327   define output parameter p-row-amount as integer      no-undo.
     5328       define buffer buf_temp_cgrplib_grp       for temp_cgrplib_grp.
     5329       for each buf_temp_cgrplib_grp
     5330       :
     5331           assign
     5332               p-row-amount = p-row-amount + 1
     5333           .
     5334       end.
     5335   end.
     5336   END PROCEDURE.
     5337   PROCEDURE move-item :
     5338   do
     5339   on error undo, return error
     5340   :
     5341   define input parameter p-node-code  as integer      no-undo.
     5342   define input parameter p-upper-code as integer      no-undo.
     5343       define variable v-node-full-name    as character    no-undo.
     5344       define variable v-upper-full-name   as character    no-undo.
     5345       define variable v-focused-row       as integer      no-undo.
     5346       define variable v-repositioned-row  as integer      no-undo.
     5347       define variable v-have-clients      as logical      no-undo.
     5348       define buffer buf_cli-grp           for ub.cli-grp.
     5349       define buffer buf_upper_cli-grp     for ub.cli-grp.
     5350       define buffer buf_temp_cgrplib_grp   for temp_cgrplib_grp.
     5351   if session :set-wait-state( "compiler" ) then.
     5352       run cgrplib-have-clients in this-procedure ( input p-upper-code, output v-have-clients ) no-error .
     5353       if error-status :error
     5354       then do:
     5355           undo, return error "move-item: Ошибка определения наличия клиентов в группе." + chr(10) + return-value.
     5356       end.
     5357       if v-have-clients = yes
     5358       then do:
     5359               message
     5360                   "В эту группу переместить нельзя, т.к. в одной группе"
     5361                   skip "не могут быть одновременно подгруппы и клиенты.".
     5362               apply "entry" to br-list in frame Dlg-grp.
     5363               return no-apply.
     5364       end.
     5365       run cli-grplib-get-full-name in this-procedure (
     5366               input p-node-code
     5367               , output v-node-full-name
     5368       ) no-error .
     5369       if error-status :error
     5370       then do:
     5371           undo, return error "move-item: Ошибка вычисления полного имени перемещаемой группы".
     5372       end.
     5373       run cli-grplib-get-full-name in this-procedure (
     5374               input p-upper-code
     5375               , output v-upper-full-name
     5376       ) no-error .
     5377       if error-status :error
     5378       then do:
     5379           undo, return error "move-item: Ошибка вычисления полного имени группы".
     5380       end.
     5381       if v-upper-full-name begins v-node-full-name
     5382       then do:
     5383           message
     5384           "Группу нельзя переместить в ее собственную подгруппу."
     5385           view-as alert-box.
     5386           undo, return.
     5387       end.
     5388       do transaction
     5389       on error undo, return error "move-item: Ошибка перемещения группы.".
     5390           find first buf_cli-grp exclusive-lock
     5391               where buf_cli-grp.node-code = p-node-code
     5392           no-error .
     5393           if not available buf_cli-grp
     5394           then do:
     5395               undo, return error "move-item: Не найдена группа для перемещения.".
     5396           end.
     5397           assign
     5398               buf_cli-grp.upper-code = p-upper-code
     5399           .
     5400       end.
     5401       assign
     5402           p-recid-list = string( recid( buf_cli-grp ) )
     5403           cli-grp-row  = recid( buf_cli-grp )
     5404       .
     5405       run UI-on in this-procedure no-error .
     5406       if error-status :error
     5407       then do:
     5408           undo, return error "move-item: Ошибка при загрузке дерева групп." + chr(10) + return-value.
     5409       end.
     5410   end.
     5411   END PROCEDURE.
     5412   PROCEDURE print-browse :
     5413   define variable Line as character no-undo.
     5414   define variable date_string as character no-undo.
     5415   define buffer buf_temp_cgrplib_grp for temp_cgrplib_grp.
     5416   DEFINE FRAME brFrame
     5417   buf_temp_cgrplib_grp.name          format "X(71)"      column-label " Наименование группы"
     5418   buf_temp_cgrplib_grp.d-pcnt        format ">9.99"      column-label " Скидка"
     5419   HEADER  date_string AT 5 format "X(35)"
     5420   string( "Страница " ) format "X(9)" AT 55 PAGE-NUMBER(PrnLibStream) AT 75 FORMAT ">>9" SKIP
     5421   Line format "X(79)" AT 1
     5422   with width 136 down stream-io use-text    .
     5423   Line = fill("-", 79).
     5424   date_string = cur-time-print() .
     5425   run prn-lib-open-stream  in this-procedure (
     5426                                                input parParentProc
     5427                                               ,input 62
     5428                                               ,input yes
     5429                                               ,input no
     5430                                               ).
     5431   PUT  STREAM PrnLibStream
     5432   SPACE(25) ( frame Dlg-grp:title )
     5433   format "x(90)" SKIP(1) .
     5434   FORM HEADER
     5435   Line format "X(79)" AT 1 SKIP
     5436   "Продолжение - на следующей странице" AT 30 SKIP
     5437   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5438   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5439   FORM with FRAME BrFrame  .
     5440   run waitfram-show in this-procedure ("Ждите...").
     5441   FOR EACH buf_temp_cgrplib_grp :
     5442       DISPLAY stream PrnLibStream
     5443       buf_temp_cgrplib_grp.name
     5444       buf_temp_cgrplib_grp.d-pcnt
     5445       with frame BrFrame.
     5446       DOwn stream PrnLibStream
     5447       with frame BrFrame.
     5448   END.
     5449   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5450   HIDE  STREAM PrnLibStream FRAME BrFrame.
     5451   output  STREAM PrnLibStream CLOSE.
     5452   run waitfram-hide in this-procedure .
     5453   run prn-lib-prn-file in this-procedure (
     5454                                             input parParentProc
     5455                                             ,input 0
     5456                                             ).
     5457   END PROCEDURE.
     5458   PROCEDURE print-grp :
     5459   do
     5460   on error undo, return error
     5461   :
     5462   define input parameter p-node-code as integer      no-undo.
     5463   define buffer buf_cli-grp       for ub.cli-grp.
     5464   if print-option = "":U then do:
     5465       run gbl/pop-up.p (b-print:handle in frame Dlg-grp, no) no-error.
     5466       if error-status:error then do:
     5467           assign print-option = "":U.
     5468           return no-apply.
     5469        end.
     5470   end.
     5471       find first buf_cli-grp no-lock
     5472           where buf_cli-grp.node-code = p-node-code
     5473       no-error.
     5474       if not available buf_cli-grp
     5475       then do:
     5476           undo, return error "Неверно выбрана группа.".
     5477       end.
     5478       if print-option = "browse":U then do:
     5479               run print-browse in this-procedure no-error.
     5480       end.
     5481           else do:
     5482       run rep/r-cligrp.p ( input parparentproc, input recid( buf_cli-grp ), input print-option ) no-error .
     5483       end.
     5484       if error-status :error
     5485       then do:
     5486           assign
     5487                   print-option = "":U
     5488                   .
     5489           undo, return error "Ошибка печати групп клиентов.".
     5490       end.
     5491       apply "entry" to br-list in frame Dlg-grp.
     5492   end.
     5493   END PROCEDURE.
     5494   PROCEDURE proc-b-disc :
     5495   define variable glog as logical no-undo .
     5496   IF not (temp_cgrplib_grp.mark = "•"
     5497   or temp_cgrplib_grp.mark = " " ) then do:
     5498     message
     5499     "Скидка может быть только для терминальной группы"
     5500     view-as alert-box error .
     5501     undo, return error .
     5502   end.
     5503   run ref/disgrpui.w ( input parparentproc
     5504                   ,input 'ИЗМЕНЕНИЕ':U
     5505                   ,input 'cli-grp':U
     5506                   ,input v-cntxt-host-code-obj
     5507                   ,input v-cntxt-obj-type
     5508                   ,input v-cntxt-obj-code
     5509                   ,input temp_cgrplib_grp.node-code
     5510                  ) NO-ERROR.
     5511   run cgrplib-get-pcnt-value  in this-procedure ( input temp_cgrplib_grp.node-code, output temp_cgrplib_grp.d-pcnt) no-error .
     5512   glog = br-list:refresh() in frame Dlg-grp .
     5513   END PROCEDURE.
     5514   PROCEDURE proc-b-rum :
     5515   define input parameter p-rum-option as character no-undo .
     5516   define variable v-radio-button-parameter as character no-undo .
     5517   define variable v-node-code as integer no-undo .
     5518   define buffer buf_cli-grp for ub.cli-grp.
     5519   if available temp_cgrplib_grp then do:
     5520     v-node-code = temp_cgrplib_grp.node-code.
     5521   end.
     5522   if p-rum-option = 'xml-file-import':U then do:
     5523     v-radio-button-parameter = 'xml-file-import':U.
     5524   end.
     5525   else do:
     5526     v-radio-button-parameter = ('batchwork-export':U + chr(44) + 'batchwork-routing':U) .
     5527   end.
     5528   run str/diallog.w (
     5529         input parParentProc
     5530       , input this-procedure
     5531       , input "utl/thbjrumr.w":U
     5532       , input 'cli-grp':U + chr(4) + v-radio-button-parameter
     5533       , input no
     5534       , input "&Стоп"
     5535       , input substitute("Операции над группами клиентов") ) no-error .
     5536   if p-rum-option = 'xml-file-import':U then do:
     5537     if v-node-code > 0 then do:
     5538       find first buf_cli-grp no-lock
     5539             where buf_cli-grp.node-code = v-node-code
     5540       no-error.
     5541     end.
     5542     else do:
     5543       find first buf_cli-grp no-lock.
     5544     end.
     5545     if not available buf_cli-grp
     5546     then do:
     5547         undo, return error "proc-b-rum: Не найдена группа в БД".
     5548     end.
     5549     assign
     5550     p-recid-list = string( recid( buf_cli-grp ) )
     5551     cli-grp-row  = recid( buf_cli-grp )
     5552     .
     5553     run UI-on in this-procedure no-error .
     5554     if error-status :error
     5555     then do:
     5556         undo, return error "proc-b-rum: Ошибка при загрузке дерева групп.".
     5557     end.
     5558   end.
     5559   END PROCEDURE.
     5560   PROCEDURE select-and-move-item :
     5561   do
     5562   on error undo, return error
     5563   :
     5564   define input parameter p-node-code as integer      no-undo.
     5565       define variable v-upper-code        as integer           no-undo.
     5566       define variable v-upper-recid-list  as character         no-undo.
     5567       define variable v-yesno             as logical           no-undo.
     5568       define variable v-node-full-name    as character         no-undo.
     5569       define variable v-upper-full-name   as character         no-undo.
     5570       define buffer buf_cli-grp       for ub.cli-grp.
     5571       if p-node-code = v-root-code
     5572       then do:
     5573           message
     5574           "Корневую группу переместить невозможно."
     5575           view-as alert-box warning.
     5576           undo, return .
     5577       end.
     5578       find first buf_cli-grp no-lock
     5579            where buf_cli-grp.node-code = p-node-code
     5580       no-error .
     5581       if error-status :error
     5582       then do:
     5583           undo, return error "select-and-move-item: Группа не найдена в базе данных.".
     5584       end.
     5585       assign
     5586           v-upper-recid-list = string( recid( buf_cli-grp ) )
     5587       .
     5588       run ref/cli-grps.w (
     5589           input parparentproc
     5590         , input "buttons-for-move"
     5591         , input-output v-upper-recid-list
     5592       ) no-error .
     5593       if error-status :error
     5594       then do:
     5595           message
     5596             vss-workfile vss-revision vss-description
     5597             skip "Ошибка выбора группы для перемещения."
     5598             skip return-value
     5599             skip trim(error-status :get-message(1))
     5600                  trim(error-status :get-message(2))
     5601                  trim(error-status :get-message(3))
     5602                  trim(error-status :get-message(4))
     5603                  trim(error-status :get-message(5))
     5604           view-as alert-box error.
     5605           undo, return no-apply .
     5606       end.
     5607       find first buf_cli-grp no-lock
     5608            where recid( buf_cli-grp ) = integer( entry( 1, v-upper-recid-list ) )
     5609       no-error .
     5610       if error-status :error
     5611       then do:
     5612           undo, return error "Группа не найдена.".
     5613       end.
     5614       run cli-grplib-get-full-name in this-procedure (  input p-node-code
     5615                                                   , output v-node-full-name
     5616       ) no-error .
     5617       if error-status :error
     5618       then do:
     5619           undo, return error "Ошибка вычисления полного имени перемещаемой группы.".
     5620       end.
     5621       run cli-grplib-get-full-name in this-procedure (  input buf_cli-grp.node-code
     5622                                                   , output v-upper-full-name
     5623       ) no-error .
     5624       if error-status :error
     5625       then do:
     5626           undo, return error "Ошибка вычисления полного имени новой группы".
     5627       end.
     5628       message
     5629           "Переместить группу"
     5630           skip "    '" + v-node-full-name + "'"
     5631           skip "в группу"
     5632           skip "    '" + v-upper-full-name + "'"
     5633       view-as alert-box question
     5634       buttons yes-no
     5635       title "Перемещение группы"
     5636       update v-yesno.
     5637       if v-yesno = no
     5638       then do:
     5639       end.
     5640       else do:
     5641           run move-item in this-procedure ( input p-node-code
     5642                                           , input buf_cli-grp.node-code
     5643           ) no-error.
     5644           if error-status :error
     5645           then do:
     5646               message
     5647               vss-workfile vss-revision vss-description
     5648               skip "Ошибка перемещения группы."
     5649               skip return-value
     5650               skip trim(error-status :get-message(1))
     5651                   trim(error-status :get-message(2))
     5652                   trim(error-status :get-message(3))
     5653                   trim(error-status :get-message(4))
     5654                   trim(error-status :get-message(5))
     5655               view-as alert-box error.
     5656               undo, return no-apply .
     5657           end.
     5658       end.
     5659   end.
     5660   END PROCEDURE.
     5661   PROCEDURE UI-on :
     5662   do
     5663   on error undo, return error
     5664   :
     5665   define variable v-reposition-row        as integer          no-undo.
     5666   define variable v-focused-row           as integer          no-undo.
     5667   define variable v-reposition-to-recid   as logical init no  no-undo.
     5668   define variable v-enable-change-grp     as logical          no-undo.
     5669   define variable v-have-clients          as logical          no-undo.
     5670   define variable v-dop                   as character        no-undo .
     5671   define buffer buf_cli-grp           for ub.cli-grp.
     5672   define buffer buf_temp_cgrplib_grp   for temp_cgrplib_grp.
     5673   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5674   do:
     5675     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5676       (input  v-cntxt-db-num
     5677       ,input  v-cntxt-userid
     5678       ,input  0
     5679       ,input  'actn_reference_groups-edit-cli':U
     5680       ,input  'firm':U
     5681       ,input  v-cntxt-host-code-obj
     5682       ,input  '':U
     5683       ,input  0
     5684       ,input  0
     5685       ,input  0
     5686       ,input  0
     5687       ,input  no
     5688       ,output v-enable-change-grp
     5689       )  .
     5690   end.
     5691   run cgrplib-get-root-code in this-procedure ( output v-root-code ) no-error.
     5692   if error-status :error
     5693   then do:
     5694       undo, return error "Не найден корневой узел." + chr(10) + return-value.
     5695   end.
     5696   if v-from-b-cli then do:
     5697     run uf-get in this-procedure(
     5698         input  'cli-grp-p':U
     5699         ,input  v-cntxt-userid
     5700         ,output v-uf-List_
     5701         ,output v-uf-Naim
     5702         ,output v-uf-print-graft
     5703         ,output v-uf-sort-gr
     5704         ,output v-uf-type-price
     5705         ,output v-uf-type-val
     5706     )  no-error .
     5707     if not error-status:error then
     5708     assign
     5709     v-dop = string((if v-uf-List_ =  chr(63) then ? else integer(v-uf-LIst_)))
     5710     .
     5711     if v-dop = v-old-recid-list then do:
     5712       assign
     5713       cli-grp-row = v-old-recid
     5714       .
     5715     end.
     5716     else do:
     5717       assign
     5718       cli-grp-row = (if v-uf-List_ =  chr(63) then ? else integer(v-uf-LIst_))
     5719       .
     5720     end.
     5721     assign
     5722         p-recid-list = string( cli-grp-row )
     5723     .
     5724     assign
     5725     v-from-b-cli = no
     5726     v-old-recid-list = "":U.
     5727   end.
     5728   else do:
     5729     if p-recid-list = '' then do:
     5730     run uf-get in this-procedure(
     5731         input  'cli-grp-p':U
     5732         ,input  v-cntxt-userid
     5733         ,output v-uf-List_
     5734         ,output v-uf-Naim
     5735         ,output v-uf-print-graft
     5736         ,output v-uf-sort-gr
     5737         ,output v-uf-type-price
     5738         ,output v-uf-type-val
     5739     )  no-error .
     5740     if not error-status:error then
     5741     assign
     5742     cli-grp-row = (if v-uf-List_ =  chr(63) then ? else integer(v-uf-LIst_))
     5743     .
     5744     assign
     5745         p-recid-list = string( cli-grp-row )
     5746     .
     5747   end.
     5748   end.
     5749   find first buf_cli-grp no-lock
     5750      where buf_cli-grp.node-code = v-root-code
     5751   no-error .
     5752   if error-status :error
     5753   then do:
     5754       message
     5755         vss-workfile vss-revision vss-description
     5756         skip "Не найдена запись корневого узла."
     5757         skip return-value
     5758         skip trim(error-status :get-message(1))
     5759              trim(error-status :get-message(2))
     5760              trim(error-status :get-message(3))
     5761              trim(error-status :get-message(4))
     5762              trim(error-status :get-message(5))
     5763       view-as alert-box error.
     5764       undo, return error .
     5765   end.
     5766   run cgrplib-have-clients in this-procedure ( input buf_cli-grp.node-code, output v-have-clients ) no-error .
     5767   if error-status :error
     5768   then do:
     5769       undo, return error "move-item: Ошибка определения наличия клиентов в группе." + chr(10) + return-value.
     5770   end.
     5771   for each buf_temp_cgrplib_grp
     5772   :
     5773       delete buf_temp_cgrplib_grp.
     5774   end.
     5775   create buf_temp_cgrplib_grp.
     5776   assign
     5777       buf_temp_cgrplib_grp.node-code   = buf_cli-grp.node-code
     5778       buf_temp_cgrplib_grp.upper-code  = buf_cli-grp.upper-code
     5779       buf_temp_cgrplib_grp.level       = 0
     5780       buf_temp_cgrplib_grp.mark        = ( if v-have-clients = yes then "•" else " " )
     5781       buf_temp_cgrplib_grp.full-name   = chr(4)
     5782       buf_temp_cgrplib_grp.sort-name   = chr(4)
     5783       buf_temp_cgrplib_grp.name        = buf_cli-grp.node-name
     5784   .
     5785   for each buf_cli-grp no-lock
     5786      where buf_cli-grp.upper-code = v-root-code
     5787   :
     5788       run create-new-line in this-procedure (
     5789                               input buf_cli-grp.node-code
     5790                             , input buf_cli-grp.upper-code
     5791                             , input 1
     5792                             , input buf_cli-grp.node-name
     5793       ) no-error .
     5794       if error-status :error
     5795       then do:
     5796           message
     5797             vss-workfile vss-revision vss-description
     5798             skip "UI-on: Ошибка добавления строки в список групп."
     5799             skip return-value
     5800             skip trim(error-status :get-message(1))
     5801                  trim(error-status :get-message(2))
     5802                  trim(error-status :get-message(3))
     5803                  trim(error-status :get-message(4))
     5804                  trim(error-status :get-message(5))
     5805           view-as alert-box error.
     5806           undo, return error .
     5807       end.
     5808   end.
     5809   if p-recid-list <> "" and p-recid-list <> ?
     5810   then do:
     5811     if lookup("b-mark", p-button-list) > 0 then do:
     5812       define variable v-ii as integer no-undo .
     5813       assign
     5814           v-reposition-row = 1
     5815           v-focused-row    = 1
     5816       .
     5817       do v-ii = 1 to num-entries(p-recid-list):
     5818       find first buf_cli-grp no-lock
     5819             where recid( buf_cli-grp ) = integer( entry( v-ii, p-recid-list ) )
     5820       no-error .
     5821       if not available buf_cli-grp
     5822       then do:
     5823       end.
     5824       else do:
     5825           run expand-tree-for-grp in this-procedure (
     5826               input buf_cli-grp.node-code
     5827               , output v-focused-row
     5828               , output v-reposition-row
     5829               , output v-reposition-to-recid
     5830           ) no-error .
     5831           if error-status :error
     5832           then do:
     5833               undo, return error "UI-on: Не удалось раскрыть дерево групп." + chr(10) + return-value.
     5834           end.
     5835           run b-mark-press ( input buf_cli-grp.node-code ) no-error .
     5836       end.
     5837   end.
     5838     end.
     5839     else do:
     5840       assign
     5841           v-reposition-row = 1
     5842           v-focused-row    = 1
     5843   .
     5844       find first buf_cli-grp no-lock
     5845            where recid( buf_cli-grp ) = integer( entry( num-entries( p-recid-list ), p-recid-list ) )
     5846       no-error .
     5847       if not available buf_cli-grp
     5848       then do:
     5849       end.
     5850       else do:
     5851           run expand-tree-for-grp in this-procedure (
     5852               input buf_cli-grp.node-code
     5853               , output v-focused-row
     5854               , output v-reposition-row
     5855               , output v-reposition-to-recid
     5856           ) no-error .
     5857           if error-status :error
     5858           then do:
     5859               undo, return error "UI-on: Не удалось раскрыть дерево групп." + chr(10) + return-value.
     5860           end.
     5861       end.
     5862     end.
     5863   end.
     5864   ASSIGN
     5865   b-print:MENU-MOUSE in frame Dlg-grp =  1.
     5866   run enable_UI.
     5867   if not valid-handle (parparentproc)
     5868   or v-is-deploy
     5869   then
     5870   disable b-print with frame Dlg-grp .
     5871   hide    b-sel       in frame Dlg-grp
     5872           b-mark      in frame Dlg-grp
     5873           b-add       in frame Dlg-grp
     5874           b-chg       in frame Dlg-grp
     5875           b-disc      in frame Dlg-grp
     5876           b-del       in frame Dlg-grp
     5877           b-move      in frame Dlg-grp
     5878   .
     5879   if lookup("s-deploy", p-button-list) > 0 then do:
     5880     assign
     5881     v-is-deploy  = yes
     5882     p-button-list = trim(replace(p-button-list, "s-deploy", '':U), chr(44)).
     5883   end.
     5884   case p-button-list
     5885   :
     5886   when "buttons-for-move"
     5887   then do:
     5888       disable
     5889           b-exit    with frame Dlg-grp
     5890       .
     5891       view
     5892           b-sel    in frame Dlg-grp
     5893       .
     5894   end.
     5895   when "buttons-for-admin"
     5896   then do:
     5897       view
     5898           b-add    in frame Dlg-grp
     5899           b-chg in frame Dlg-grp
     5900           b-disc in frame Dlg-grp
     5901           b-del in frame Dlg-grp
     5902           b-move   in frame Dlg-grp
     5903       .
     5904       if v-enable-change-grp = no
     5905       then do:
     5906           disable
     5907               b-add
     5908               b-chg
     5909               b-disc
     5910               b-del
     5911               b-move
     5912           with frame Dlg-grp.
     5913       end.
     5914   end.
     5915   when 'терм':U + ",b-sel" or when "b-sel"
     5916   then do:
     5917       view
     5918           b-sel    in frame Dlg-grp
     5919       .
     5920   end.
     5921   when "b-sel,b-mark"
     5922   then do:
     5923       view
     5924           b-sel    in frame Dlg-grp
     5925           b-mark in frame Dlg-grp
     5926       .
     5927   end.
     5928   end case.
     5929   assign
     5930   menu-item m_selected:sensitive  in menu menu-b-rum = (b-mark:sensitive in frame Dlg-grp and b-mark:visible in frame Dlg-grp)
     5931   menu-item m_selected_plus_childs:sensitive  in menu menu-b-rum = (b-mark:sensitive in frame Dlg-grp and b-mark:visible in frame Dlg-grp)
     5932   .
     5933   br-list :set-repositioned-row( v-focused-row, "ALWAYS" ) in frame Dlg-grp.
     5934   if v-reposition-to-recid = no
     5935   then do:
     5936       reposition br-list to row v-reposition-row.
     5937   end.
     5938   else do:
     5939       reposition br-list to recid v-reposition-row.
     5940   end.
     5941   end.
     5942   END PROCEDURE.
