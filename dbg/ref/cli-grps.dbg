     3213     define variable v-frame-virtual-width  as decimal   no-undo .
     3214     define variable v-browse-width         as decimal   no-undo .
     3215     define variable v-window-width         as decimal   no-undo .
     3216     define variable v-window-virtual-width as decimal   no-undo .
     3217     define variable v-change-sign          as integer   no-undo .
     3218     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3219     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3220     if p-change-value > 0
     3221     then do:
     3222       if frame Dlg-grp :width + p-change-value >
     3223           session :width-chars
     3224       then do:
     3225         assign
     3226           p-change-value = session :width-chars - frame Dlg-grp :width
     3227         .
     3228         if p-change-value <= 0
