     2819   .
     2820   procedure diasize_change-height :
     2821     define input  parameter p-change-value  as decimal   no-undo .
     2822     define input  parameter p-move-resize   as logical   no-undo .
     2823     define variable v-field-group-handle    as handle    no-undo .
     2824     define variable v-object-handle         as handle    no-undo .
     2825     define variable v-frame-height          as decimal   no-undo .
     2826     define variable v-frame-virtual-height  as decimal   no-undo .
     2827     define variable v-browse-height         as decimal   no-undo .
     2828     define variable v-window-height         as decimal   no-undo .
     2829     define variable v-window-virtual-height as decimal   no-undo .
     2830     define variable v-change-sign           as integer   no-undo .
     2831     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2832     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2833     if p-change-value > 0
     2834     then do:
     2835       if frame Dlg-grp :height + p-change-value
     2836           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2837       then do:
     2838         assign
     2839           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2840                           - (frame Dlg-grp :height-chars)
     2841         .
     2842         if p-change-value <= 0
     2843         then do:
     2844           run diasize_position-resize-button in this-procedure .
     2845           return .
     2846         end.
     2847       end.
     2848     end.
     2849     if p-change-value < 0
     2850     then do:
     2851       if frame Dlg-grp :height + p-change-value < v-diasize-orig-frame-height
     2852       then do:
     2853         assign
     2854           p-change-value = v-diasize-orig-frame-height
     2855                          - (frame Dlg-grp :height-chars)
     2856         .
     2857         if p-change-value >= 0
     2858         then do:
     2859           run diasize_position-resize-button in this-procedure .
     2860           return .
     2861         end.
     2862       end.
     2863     end.
     2864     if p-change-value >= 0
     2865     then do:
     2866       assign
     2867         v-change-sign = 1
     2868       .
     2869     end.
     2870     else do:
     2871       assign
     2872         v-change-sign = -1
     2873       .
     2874     end.
     2875     assign
     2876       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2877     .
     2878     if p-change-value = 0
     2879     then do:
     2880       run diasize_position-resize-button in this-procedure .
     2881       return .
     2882     end.
     2883     move_block:
     2884     do
     2885     on error undo move_block, retry move_block
     2886     :
     2887       if retry
     2888       then do:
     2889         do
     2890         on error undo move_block, leave move_block
     2891         :
     2892           if p-change-value > 0
     2893           then do:
     2894             for each buf_temp-diasize-handle
     2895             on error undo, next
     2896             :
     2897               assign
     2898                 v-object-handle = buf_temp-diasize-handle.handle-value
     2899               .
     2900               if v-object-handle <> v-diasize-resize-button
     2901               then do:
     2902                 assign
     2903                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2904                 .
     2905               end.
     2906             end.
     2907             assign
     2908               v-diasize-browse-handle :height = v-browse-height
     2909             .
     2910             for each buf_temp-browse-handle
     2911               where buf_temp-browse-handle.browse-type = 'height':u
     2912             on error undo, next
     2913             :
     2914               assign
     2915                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2916               .
     2917             end.
     2918             assign
     2919               frame Dlg-grp :height = v-frame-height
     2920             .
     2921             if frame Dlg-grp :scrollable = true
     2922             then do:
     2923               assign
     2924                 frame Dlg-grp :virtual-height = v-frame-virtual-height
     2925               .
     2926             end.
     2927             run diasize_position-resize-button in this-procedure .
     2928           end.
     2929           else do:
     2930             if frame Dlg-grp :scrollable = true
     2931             then do:
     2932               assign
     2933                 frame Dlg-grp :virtual-height = v-frame-virtual-height
     2934               .
     2935             end.
     2936             assign
     2937               frame Dlg-grp :height = v-frame-height
     2938             .
     2939             assign
     2940               v-diasize-browse-handle :height = v-browse-height
     2941             .
     2942             for each buf_temp-browse-handle
     2943               where buf_temp-browse-handle.browse-type = 'height':u
     2944             on error undo, next
     2945             :
     2946               assign
     2947                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2948               .
     2949             end.
     2950             for each buf_temp-diasize-handle
     2951             on error undo, next
     2952             :
     2953               assign
     2954                 v-object-handle = buf_temp-diasize-handle.handle-value
     2955               .
     2956               if v-object-handle <> v-diasize-resize-button
     2957               then do:
     2958                 assign
     2959                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2960                 .
     2961               end.
     2962             end.
     2963             run diasize_position-resize-button in this-procedure .
     2964           end.
     2965           assign
     2966             v-diasize-change-size = false
     2967           .
     2968           leave move_block .
     2969         end.
     2970       end.
     2971       assign
     2972         v-diasize-need-full-display = true
     2973       .
     2974       if v-diasize-change-size = false
     2975       then do:
     2976         assign
     2977           v-diasize-change-size = true
     2978         .
     2979       end.
     2980       else do:
     2981         return .
     2982       end.
     2983       assign
     2984         v-frame-height = frame Dlg-grp :height
     2985         v-frame-virtual-height = frame Dlg-grp :virtual-height
     2986         v-browse-height = v-diasize-browse-handle :height
     2987       .
     2988       for each buf_temp-browse-handle
     2989         where buf_temp-browse-handle.browse-type = 'height':u
     2990       :
     2991         assign
     2992           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2993         .
     2994       end.
     2995       for each buf_temp-diasize-handle
     2996       :
     2997         delete buf_temp-diasize-handle .
     2998       end.
     2999       assign
     3000         v-field-group-handle = frame Dlg-grp :first-child
     3001       .
     3002       do while valid-handle(v-field-group-handle)
     3003       :
     3004         assign
     3005           v-object-handle = v-field-group-handle :first-child
     3006         .
     3007         do while valid-handle(v-object-handle)
     3008         :
     3009           if  v-object-handle <> v-diasize-browse-handle :handle
     3010           and can-query(v-object-handle, "row")
     3011           and can-query(v-object-handle, "height")
     3012           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3013           then do:
     3014             find first buf_temp-browse-handle
     3015               where buf_temp-browse-handle.browse-type   = 'height':u
     3016                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3017               no-error .
     3018             if available buf_temp-browse-handle
     3019             then do:
     3020             end.
     3021             else do:
     3022               create buf_temp-diasize-handle .
     3023               assign
     3024                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3025                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3026               .
     3027             end.
     3028           end.
     3029           assign
     3030             v-object-handle = v-object-handle :next-sibling
     3031           .
     3032         end.
     3033         assign
     3034           v-field-group-handle = v-field-group-handle :next-sibling
     3035         .
     3036       end.
     3037       do with frame Dlg-grp
     3038       :
     3039         hide v-diasize-resize-button .
     3040         assign
     3041           v-diasize-resize-button :row    = 1
     3042           v-diasize-resize-button :column = 1
     3043         .
     3044       end.
     3045       if p-change-value > 0
     3046       then do:
     3047         if frame Dlg-grp :scrollable = true
     3048         then do:
     3049           assign
     3050             frame Dlg-grp :virtual-height = frame Dlg-grp :virtual-height + p-change-value
     3051             no-error .
     3052           if error-status :error
     3053           or error-status :get-message(1) <> ""
     3054           then do:
     3055             undo move_block, retry move_block .
     3056           end.
     3057         end.
     3058         assign
     3059           frame Dlg-grp :height = frame Dlg-grp :height + p-change-value
     3060           no-error .
     3061         if error-status :error
     3062         or error-status :get-message(1) <> ""
     3063         then do:
     3064           undo move_block, retry move_block .
     3065         end.
     3066         assign
     3067           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3068           no-error .
     3069         if error-status :error
     3070         or error-status :get-message(1) <> ""
     3071         then do:
     3072           undo move_block, retry move_block .
     3073         end.
     3074         for each buf_temp-browse-handle
     3075           where buf_temp-browse-handle.browse-type = 'height':u
     3076         on error undo move_block, retry move_block
     3077         :
     3078           assign
     3079             buf_temp-browse-handle.browse-handle :height
     3080               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3081             no-error .
     3082           if error-status :error
     3083           or error-status :get-message(1) <> ""
     3084           then do:
     3085             undo move_block, retry move_block .
     3086           end.
     3087         end.
     3088         for each buf_temp-diasize-handle
     3089         on error undo move_block, retry move_block
     3090         :
     3091           assign
     3092             v-object-handle = buf_temp-diasize-handle.handle-value
     3093           .
     3094           if v-object-handle <> v-diasize-resize-button
     3095           then do:
     3096             assign
     3097               v-object-handle :row = v-object-handle :row + p-change-value
     3098               no-error .
     3099             if error-status :error
     3100             or error-status :get-message(1) <> ""
     3101             then do:
     3102               undo move_block, retry move_block .
     3103             end.
     3104           end.
     3105         end.
     3106       end.
     3107       else do:
     3108         for each buf_temp-diasize-handle
     3109         on error undo move_block, retry move_block
     3110         :
     3111           assign
     3112             v-object-handle = buf_temp-diasize-handle.handle-value
     3113           .
     3114           if v-object-handle <> v-diasize-resize-button
     3115           then do:
     3116             assign
