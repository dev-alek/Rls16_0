        1   block-level on error undo, throw.
        2   define input parameter p-obj-type like ub.c-fbr-gds-grp-hist.obj-type no-undo .
        3   define input parameter p-obj-code like ub.c-fbr-gds-grp-hist.obj-code no-undo .
        4   define input parameter p-node-code  like ub.c-fbr-gds-grp-hist.node-code no-undo .
        5   define input parameter p-corr-user-db-num  like ub.c-fbr-gds-grp-hist.corr-user-db-num no-undo .
        6   define input parameter p-chip-num  like ub.c-fbr-gds-grp-hist.chip-num no-undo .
        7   define input parameter p-subject like ub.c-fbr-gds-grp-hist.subject no-undo .
        8   define input parameter p-action   like ub.c-fbr-gds-grp-hist.action no-undo .
        9   define input parameter p-silent  as logical no-undo .
       10   define output parameter p-description as character no-undo .
       11   define output parameter p-full-name-old as character no-undo .
       12   define output parameter p-full-name-new as character no-undo .
       13   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       15   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   define variable vss-workfile    as character no-undo init "$Workfile: cfggrhiv.p $":U .
       17   define variable vss-archive     as character no-undo init "$Archive: ref/cfggrhiv.p $":U .
       18   define variable vss-description as character no-undo init "Заполнение временной таблицы для показа изменений по таблицам истории групп блюд".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   procedure fbr-grp-attr-name :
       90   do
       91     on error undo, return error
       92     :
       93     define input  parameter p-code           as character no-undo .
       94     define output parameter p-type           as character no-undo .
       95     define output parameter p-format         as character no-undo .
       96     define output parameter p-label          as character no-undo .
       97     define output parameter p-user-can-edit  as logical   no-undo .
       98     define output parameter p-output-display as logical   no-undo .
       99     define output parameter p-other          as character no-undo .
      100       case p-code :
      101         otherwise do:
      102           undo, return error "Неизвестный атрибут группы блюд" + " " + p-code .
      103         end.
      104       end.
      105     end.
      106   end procedure.
      107   procedure fbr-grp-attr-tooltip :
      108   do
      109     on error undo, return error
      110     :
      111       define input  parameter p-code    as character no-undo .
      112       define output parameter p-tooltip as character no-undo .
      113       define output parameter p-label   as character no-undo .
      114       case p-code :
      115         otherwise do:
      116               undo, return error "Неизвестный атрибут группы блюд" + " " + p-code .
      117         end.
      118       end.
      119     end.
      120   end procedure.
      121   procedure fbr-grp-attr-value :
      122   do
      123   on error undo, return error
      124   :
      125   define input  parameter p-obj-type    as character  no-undo.
      126   define input  parameter p-obj-code    as integer    no-undo.
      127   define input  parameter p-node-code   as integer    no-undo.
      128   define input  parameter p-code        as character  no-undo.
      129   define output parameter p-value       as character  no-undo.
      130   define output parameter p-type        as character  no-undo.
      131       define variable v-format         as character no-undo .
      132       define variable v-label          as character no-undo .
      133       define variable v-user-can-edit  as logical   no-undo .
      134       define variable v-output-display as logical   no-undo .
      135       define variable v-other          as character no-undo .
      136       define buffer buf_fbr-gds-grp-attr for ub.fbr-gds-grp-attr.
      137       run fbr-grp-attr-name in this-procedure (
      138             input  p-code
      139           , output p-type
      140           , output v-format
      141           , output v-label
      142           , output v-user-can-edit
      143           , output v-output-display
      144           , output v-other
      145       ) no-error .
      146       if error-status :error
      147       then do:
      148           undo, return error return-value .
      149       end.
      150       find first buf_fbr-gds-grp-attr no-lock
      151            where buf_fbr-gds-grp-attr.obj-type  = p-obj-type
      152              and buf_fbr-gds-grp-attr.obj-code  = p-obj-code
      153              and buf_fbr-gds-grp-attr.node-code = p-node-code
      154              and buf_fbr-gds-grp-attr.attr-code = p-code
      155       no-error .
      156       if available buf_fbr-gds-grp-attr
      157       then do:
      158           assign
      159               p-value = buf_fbr-gds-grp-attr.attr-value
      160           .
      161       end.
      162       else do:
      163           assign
      164           p-value = (if p-type = 'L':U then "no":U else "")
      165           .
      166       end.
      167   end.
      168   end procedure.
      169   procedure fbr-grp-attr-write :
      170   do
      171   on error undo, return error
      172   :
      173   define input parameter p-obj-type   like ub.fbr-gds-grp-attr.obj-type            no-undo.
      174   define input parameter p-obj-code   like ub.fbr-gds-grp-attr.obj-code            no-undo.
      175   define input parameter p-node-code  like ub.fbr-gds-grp-attr.node-code      no-undo.
      176   define input parameter p-code       like ub.fbr-gds-grp-attr.attr-code      no-undo.
      177   define input parameter p-value      like ub.fbr-gds-grp-attr.attr-value     no-undo.
      178       define variable v-type              as character                no-undo.
      179       define variable v-format            as character                no-undo.
      180       define variable v-label             as character                no-undo.
      181       define variable v-user-can-edit     as logical                  no-undo.
      182       define variable v-output-display    as logical                  no-undo.
      183       define variable v-other             as character                no-undo.
      184       define buffer buf_fbr-gds-grp-attr for ub.fbr-gds-grp-attr .
      185       run fbr-grp-attr-name in this-procedure (
      186                         input  p-code
      187                       , output v-type
      188                       , output v-format
      189                       , output v-label
      190                       , output v-user-can-edit
      191                       , output v-output-display
      192                       , output v-other
      193       ) no-error.
      194       if error-status :error
      195       then do:
      196           undo, return error return-value.
      197       end.
      198       find first buf_fbr-gds-grp-attr exclusive-lock
      199            where buf_fbr-gds-grp-attr.obj-type   = p-obj-type
      200              and buf_fbr-gds-grp-attr.obj-code   = p-obj-code
      201              and buf_fbr-gds-grp-attr.node-code  = p-node-code
      202              and buf_fbr-gds-grp-attr.attr-code  = p-code
      203       no-error.
      204       if not available buf_fbr-gds-grp-attr
      205       then do:
      206           create buf_fbr-gds-grp-attr.
      207           assign
      208           buf_fbr-gds-grp-attr.node-code  = p-node-code
      209           buf_fbr-gds-grp-attr.attr-code  = p-code
      210           buf_fbr-gds-grp-attr.obj-type   = p-obj-type
      211           buf_fbr-gds-grp-attr.obj-code   = p-obj-code
      212           buf_fbr-gds-grp-attr.attr-value = p-value
      213           .
      214       end.
      215       else do:
      216           assign
      217               buf_fbr-gds-grp-attr.attr-value = p-value
      218           .
      219       end.
      220   end.
      221   end procedure.
      222   procedure fbr-grp-attr-delete :
      223   do
      224   on error undo, return error
      225   :
      226   define input parameter p-obj-type   like ub.fbr-gds-grp-attr.obj-type        no-undo.
      227   define input parameter p-obj-code   like ub.fbr-gds-grp-attr.obj-code        no-undo.
      228   define input parameter p-node-code  like ub.fbr-gds-grp-attr.node-code  no-undo.
      229   define input parameter p-code       like ub.fbr-gds-grp-attr.attr-code  no-undo.
      230   define output parameter p-deleted   as logical                      no-undo.
      231       define buffer buf_fbr-gds-grp-attr for ub.fbr-gds-grp-attr .
      232       define variable v-type              as character                no-undo.
      233       define variable v-format            as character                no-undo.
      234       define variable v-label             as character                no-undo.
      235       define variable v-user-can-edit     as logical                  no-undo.
      236       define variable v-output-display    as logical                  no-undo.
      237       define variable v-other             as character                no-undo.
      238       run fbr-grp-attr-name in this-procedure
      239       ( input  p-code
      240       , output v-type
      241       , output v-format
      242       , output v-label
      243       , output v-user-can-edit
      244       , output v-output-display
      245       , output v-other
      246       ) no-error .
      247       if error-status :error then do:
      248           undo, return error return-value .
      249       end.
      250       find first buf_fbr-gds-grp-attr exclusive-lock
      251            where buf_fbr-gds-grp-attr.obj-type   = p-obj-type
      252              and buf_fbr-gds-grp-attr.obj-code   = p-obj-code
      253              and buf_fbr-gds-grp-attr.node-code  = p-node-code
      254              and buf_fbr-gds-grp-attr.attr-code  = p-code
      255       no-error.
      256       if not available buf_fbr-gds-grp-attr
      257       then do:
      258           assign
      259               p-deleted = no
      260           .
      261       end.
      262       else do:
      263          delete buf_fbr-gds-grp-attr.
      264          assign
      265               p-deleted = yes
      266           .
      267       end.
      268   end.
      269   end procedure.
      270   procedure fbr-grp-attr-news :
      271   do
      272   on error undo, return error
      273   :
      274       define input  parameter p-code           as character no-undo .
      275       define output parameter p-news           as logical   no-undo .
      276       case p-code :
      277         otherwise do:
      278           undo, return error "неизвестный атрибут группы блюд" + " " + p-code .
      279         end.
      280       end.
      281   end.
      282   end procedure.
      283   define variable v-chg-fields as character no-undo.
      284   define variable v-old-fields as character no-undo.
      285   define variable v-new-fields as character no-undo.
      286   define variable ii as integer no-undo.
      287   define variable v-mess as character no-undo .
      288   define buffer buf_c-fbr-gds-grp-hist for ub.c-fbr-gds-grp-hist.
      289   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      290   define SHARED temp-table temp-changes no-undo
      291   field f_name as character
      292   field l_name as character
      293   field v_old as character
      294   field v_new as character
      295   field t_name as character
      296   field num_ as integer
      297   field uniq-key-rec as character
      298   field action as integer
      299   field fNotChange as logical
      300   index pi is unique primary
      301   num_
      302   t_name
      303   f_name
      304   index
      305   Chan
      306   fnotChange
      307   t_name
      308   f_name
      309   index imain uniq-key-rec
      310   .
      311   FUNCTION get-all-fields returns character (p-file-name as character ):
      312   define variable v-dop as character no-undo .
      313     find first _file no-lock where _file._file-name = p-file-name no-error .
      314     if not available _file then return "":U.
      315     for each _field no-lock where
      316              _field._file-recid = recid(_file) :
      317       assign
      318       v-dop = v-dop + _field._field-name + chr(44)
      319       .
      320     end.
      321     return trim(v-dop).
      322   END FUNCTION.
      323   PROCEDURE proc-full-temp-changes :
      324     define input  parameter p-act-create as logical   no-undo .
      325     define input  parameter p-act-delete as logical   no-undo .
      326     define input  parameter p-hst-handle as handle    no-undo .
      327     define input  parameter p-main-table as character no-undo .
      328     define input  parameter p-field-list as character no-undo .
      329     define input  parameter p-label-form as character no-undo .
      330     define variable h-new-buf         as handle    no-undo .
      331     define variable h-main-buf        as handle    no-undo .
      332     define variable h-for-comp        as handle    no-undo .
      333     define variable v-inform          as character no-undo .
      334     define variable v-ind             as integer   no-undo .
      335     define variable v-idx-field-qnty  as integer   no-undo .
      336     define variable v-num-entries     as integer   no-undo .
      337     define variable fh                as handle    no-undo .
      338     define variable fh-main           as handle    no-undo .
      339     define variable fh-old            as handle    no-undo .
      340     define variable fh-new            as handle    no-undo .
      341     define variable v-field-name      as character no-undo .
      342     define variable v-field-lvl       as character no-undo .
      343     define variable v-field-form      as character no-undo .
      344     define variable v-search-exp      as character no-undo .
      345     define variable v-srch-main       as character no-undo .
      346     define variable v-word-link       as character no-undo .
      347     define variable v-av-chip-num     as logical   no-undo .
      348     define variable v-main-pi-fld-lst as character no-undo .
      349     define variable v-main-fld-lst    as character no-undo .
      350     define variable v-delim-list      as character no-undo .
      351     define variable v-label           as character no-undo .
      352     define variable v-old-value       as character no-undo case-sensitive.
      353     define variable v-new-value       as character no-undo case-sensitive.
      354     define variable v-chg-fields as character no-undo.
      355     for each temp-changes:
      356       delete temp-changes.
      357     end.
      358     if not p-hst-handle:available then do:
      359       return .
      360     end.
      361     create buffer h-new-buf  for table p-hst-handle .
      362     create buffer h-main-buf for table p-main-table .
      363     assign
      364       v-inform = h-main-buf:index-information(1)
      365       v-ind    = 2
      366     .
      367     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      368     on error undo, return error
      369     :
      370       assign
      371         v-inform = h-main-buf:index-information( v-ind )
      372         v-ind    = v-ind + 1
      373       .
      374     end.
      375     if v-inform = ?
      376       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      377       or entry( 3, v-inform, ",":U ) <> "1":U
      378     then do:
      379       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      380     end.
      381     assign
      382       v-idx-field-qnty = num-entries( v-inform ) - 4
      383     .
      384     if v-idx-field-qnty < 2 then do:
      385       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      386     end.
      387     assign
      388       v-srch-main   = "where":U
      389       v-word-link   = "":U
      390       v-av-chip-num = false
      391       v-delim-list  = "":U
      392     .
      393     do v-ind = 1 to v-idx-field-qnty by 2
      394     on error undo, return error
      395     :
      396       assign
      397         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      398         fh                = p-hst-handle:buffer-field( v-field-name )
      399         fh-main           = h-main-buf:buffer-field( v-field-name )
      400         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      401         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      402       .
      403       if fh:data-type ="character":U then do:
      404         assign
      405           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      406         .
      407       end.
      408       else do:
      409         assign
      410           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      411         .
      412       end.
      413       if v-delim-list = "":U then do:
      414         assign
      415           v-delim-list = ",":U
      416         .
      417       end.
      418       if v-word-link = "":U then do:
      419         assign
      420           v-word-link = "and":U
      421         .
      422       end.
      423     end.
      424     assign
      425       v-delim-list  = "":U
      426     .
      427     do v-ind = 1 to h-main-buf:num-fields
      428     on error undo, return error
      429     :
      430       assign
      431         fh-main      = h-main-buf:buffer-field( v-ind )
      432         v-field-name = fh-main:name
      433       .
      434         assign
      435           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      436         .
      437         if v-delim-list = "":U then do:
      438           assign
      439             v-delim-list = ",":U
      440           .
      441         end.
      442     end.
      443     assign
      444       v-inform = p-hst-handle:index-information(1)
      445       v-ind    = 2
      446     .
      447     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      448     on error undo, return error
      449     :
      450       assign
      451         v-inform = p-hst-handle:index-information( v-ind )
      452         v-ind    = v-ind + 1
      453       .
      454     end.
      455     if v-inform = ?
      456       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      457       or entry( 3, v-inform, ",":U ) <> "1":U
      458     then do:
      459       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      460     end.
      461     assign
      462       v-idx-field-qnty = num-entries( v-inform ) - 4
      463     .
      464     if v-idx-field-qnty < 2 then do:
      465       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      466     end.
      467     assign
      468       v-search-exp  = "where":U
      469       v-word-link   = "":U
      470       v-av-chip-num = false
      471     .
      472     do v-ind = 1 to v-idx-field-qnty by 2
      473     on error undo, return error
      474     :
      475       assign
      476         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      477         fh           = p-hst-handle:buffer-field( v-field-name )
      478         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      479       .
      480       if v-field-name = "chip-num":U then do:
      481         assign
      482           v-search-exp  = substitute( "&1 >", v-search-exp )
      483           v-av-chip-num = true
      484         .
      485       end.
      486       else do:
      487         assign
      488           v-search-exp = substitute( "&1 =", v-search-exp )
      489         .
      490       end.
      491       if fh:data-type ="character":U then do:
      492         assign
      493           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      494         .
      495       end.
      496       else do:
      497         assign
      498           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      499         .
      500       end.
      501       if v-word-link = "":U then do:
      502         assign
      503           v-word-link = "and":U
      504         .
      505       end.
      506     end.
      507     if v-av-chip-num = false then do:
      508       message
      509         vss-workfile vss-revision vss-description skip
      510         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      511         "Использование данной процедуры невозможно!" skip
      512         view-as alert-box error .
      513       return error .
      514     end.
      515     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      516     if not h-new-buf:available then do:
      517       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      518       if not h-main-buf:available then do:
      519         assign
      520           h-for-comp = ?
      521         .
      522       end.
      523       else do:
      524         assign
      525           h-for-comp = h-main-buf
      526         .
      527       end.
      528     end.
      529     else do:
      530       assign
      531         h-for-comp = h-new-buf
      532       .
      533     end.
      534     assign
      535       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      536     .
      537     do v-ind = 1 to v-num-entries
      538     on error undo, return error return-value
      539     :
      540       assign
      541         v-field-name = entry( v-ind, v-main-fld-lst )
      542         fh-old       = p-hst-handle:buffer-field( v-field-name )
      543         v-old-value  = fh-old:buffer-value()
      544         v-label      = trim( fh-old:label )
      545       .
      546       if ( trim( p-field-list ) <> "":U
      547            and lookup( v-field-name, p-field-list ) > 0
      548          )
      549          or trim( p-field-list ) = "":U
      550       then do:
      551         if h-for-comp <> ? then do:
      552           assign
      553             fh-new      = h-for-comp:buffer-field( v-field-name )
      554             v-new-value = fh-new:buffer-value()
      555           .
      556         end.
      557         else do:
      558           assign
      559             v-new-value = "":U
      560           .
      561         end.
      562           if p-act-create = true then do:
      563             assign
      564               v-old-value = "":U
      565             .
      566           end.
      567           if p-act-delete = true then do:
      568             assign
      569               v-new-value = "":U
      570             .
      571           end.
      572         if v-old-value <> v-new-value
      573         then do:
      574           create temp-changes.
      575           assign
      576             temp-changes.t_name = p-main-table
      577             temp-changes.f_name = v-field-name
      578             temp-changes.l_name = replace( v-label, "&":U, "":U )
      579             temp-changes.v_old  = trim( v-old-value )
      580             temp-changes.v_new  = trim( v-new-value )
      581             temp-changes.num_   = 0
      582             temp-changes.fNotChange = v-old-value eq v-new-value
      583           .
      584         end.
      585       end.
      586     end.
      587     assign
      588       v-num-entries = num-entries( p-label-form, chr(8) )
      589     .
      590     do v-ind = 1 to v-num-entries
      591     on error undo, return error return-value
      592     :
      593       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      594         assign
      595           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      596           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      597           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      598         .
      599         find first temp-changes
      600           where temp-changes.f_name = v-field-name
      601           no-error .
      602         if available temp-changes then do:
      603           if trim( v-field-lvl ) <> "":U then do:
      604             assign
      605               temp-changes.l_name = v-field-lvl
      606             .
      607           end.
      608           if trim( v-field-form ) <> "":U then do:
      609             assign
      610               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      611             .
      612             if h-for-comp <> ? then do:
      613               assign
      614                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      615               .
      616             end.
      617           end.
      618         end.
      619       end.
      620       else do:
      621         message
      622           vss-workfile vss-revision vss-description skip
      623           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      624           substitute( "список для поля '&1': '&2'"
      625                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      626                       ,entry( v-ind, p-label-form, chr(8) )
      627                     ) skip
      628           substitute( "полный список: &2", p-label-form ) skip
      629           view-as alert-box error .
      630       end.
      631     end.
      632     delete object h-new-buf .
      633     delete object h-main-buf .
      634   END PROCEDURE.
      635   find first buf_c-fbr-gds-grp-hist no-lock where
      636            buf_c-fbr-gds-grp-hist.obj-type = p-obj-type
      637         AND buf_c-fbr-gds-grp-hist.obj-code = p-obj-code
      638         AND buf_c-fbr-gds-grp-hist.node-code = p-node-code
      639         AND buf_c-fbr-gds-grp-hist.chip-num = p-chip-num
      640         AND buf_c-fbr-gds-grp-hist.corr-user-db-num = p-corr-user-db-num
      641         AND buf_c-fbr-gds-grp-hist.subject  = p-subject no-error .
      642   if not available buf_c-fbr-gds-grp-hist then do:
      643     return error .
      644   end.
      645   CASE p-subject:
      646     when 'fbr-gds-grp':U then do:
      647       run fbr-gds-grp-proc in this-procedure(output p-description) no-error .
      648     end.
      649     when 'fbr-gds-grp-attr':U then do:
      650       run fbr-gds-grp-attr-proc in this-procedure(output p-description) no-error .
      651     end.
      652   END CASE.
      653   if error-status:error then do:
      654     return error .
      655   end.
      656   procedure fbr-gds-grp-proc :
      657   define output parameter p-description as character no-undo .
      658   define variable v-is-created as logical no-undo .
      659   define variable v-is-deleted as logical no-undo .
      660   define variable v-field-name as character no-undo .
      661   define variable v-field-label as character no-undo .
      662   define variable jj as integer no-undo.
      663   define buffer current_fbr-gds-grp for ub.fbr-gds-grp  .
      664   define buffer current_c-fbr-gds-grp for ub.c-fbr-gds-grp  .
      665   define buffer new_c-fbr-gds-grp for ub.c-fbr-gds-grp  .
      666     do
      667     on error undo, return error
      668     :
      669       find first current_c-fbr-gds-grp no-lock where
      670                  current_c-fbr-gds-grp.obj-type = p-obj-type
      671              AND current_c-fbr-gds-grp.obj-code = p-obj-code
      672              AND current_c-fbr-gds-grp.node-code = p-node-code
      673              AND current_c-fbr-gds-grp.chip-num = p-chip-num
      674              AND current_c-fbr-gds-grp.corr-user-db-num = p-corr-user-db-num
      675              no-error .
      676       if not avail current_c-fbr-gds-grp then do:
      677          v-mess = "Неверная ссылка на c-fbr-gds-grp в таблице c-fbr-gds-grp-hist".
      678          run err-mess in this-procedure ( input-output v-mess).
      679          return error v-mess.
      680       end.
      681       if buf_c-fbr-gds-grp-hist.action = integer('1':U) then do:
      682         assign
      683         v-is-created = yes
      684         v-chg-fields = get-all-fields ("fbr-gds-grp")
      685         .
      686       end.
      687       if buf_c-fbr-gds-grp-hist.action = integer('99':U) then do:
      688         assign
      689         v-is-deleted = yes
      690         v-chg-fields = get-all-fields ("fbr-gds-grp")
      691         .
      692       end.
      693       find first new_c-fbr-gds-grp no-lock where
      694                 new_c-fbr-gds-grp.obj-type = p-obj-type
      695              AND new_c-fbr-gds-grp.obj-code = p-obj-code
      696              AND new_c-fbr-gds-grp.node-code = p-node-code
      697              AND new_c-fbr-gds-grp.chip-num > p-chip-num
      698              AND new_c-fbr-gds-grp.corr-user-db-num = p-corr-user-db-num
      699               no-error .
      700       if not available new_c-fbr-gds-grp then do:
      701           find first current_fbr-gds-grp no-lock where
      702                  current_fbr-gds-grp.node-code = p-node-code no-error .
      703           if not available current_fbr-gds-grp
      704           and not  v-is-deleted
      705           then do:
      706               return error.
      707           end.
      708           if available current_fbr-gds-grp then
      709           buffer-compare current_fbr-gds-grp to current_c-fbr-gds-grp
      710           case-sensitive
      711           save result in v-chg-fields.
      712       end.
      713       else do:
      714           buffer-compare new_c-fbr-gds-grp
      715           except chip-num corr-date corr-time corr-user-name corr-user-db-num
      716           to current_c-fbr-gds-grp
      717           case-sensitive
      718           save result in v-chg-fields.
      719       end.
      720       if lookup("node-code", v-chg-fields ) > 0
      721       or lookup("upper-code", v-chg-fields ) > 0 then do:
      722          if not v-is-created then
      723          run c-get-full-name  in this-procedure (
      724                                                     input  yes
      725                                                    ,input p-obj-type
      726                                                    ,input p-obj-code
      727                                                    ,input p-node-code
      728                                                    ,input p-chip-num
      729                                                    ,input p-corr-user-db-num
      730                                                    ,output p-full-name-old
      731                                                   ) no-error .
      732          if not v-is-deleted then
      733          run c-get-full-name  in this-procedure (
      734                                                     input  (if available new_c-fbr-gds-grp
      735                                                             then yes
      736                                                             else no)
      737                                                    ,input p-obj-type
      738                                                    ,input p-obj-code
      739                                                    ,input p-node-code
      740                                                    ,input (if available new_c-fbr-gds-grp
      741                                                            then new_c-fbr-gds-grp.chip-num
      742                                                            else 0)
      743                                                    ,input p-corr-user-db-num
      744                                                    ,output p-full-name-new
      745                                                   ) no-error .
      746       end.
      747     _ii:
      748     do ii = 1 to num-entries(v-chg-fields):
      749       assign
      750       v-field-name = entry(ii, v-chg-fields)
      751       jj = lookup(v-field-name, "global-code,host-code,is-modificator,is-term,lvl-num,node-code,node-name,obj-code,obj-type,out-code,upper-code").
      752       if jj = 0 then next _ii.
      753       assign
      754       v-field-label = entry(jj, "Код Рубрикатора,Код фирмы,Модификаторы блюд,Терминальная группа,Уровень,Код,Наименование,Код объекта,Тип объекта,Код на кассе,Вн № выш.группы")
      755       .
      756       create temp-changes.
      757       assign
      758       temp-changes.f_name = v-field-name
      759       temp-changes.l_name = v-field-label
      760       temp-changes.v_old =  (if v-is-created
      761                             then "":U
      762                             else string(buffer current_c-fbr-gds-grp:buffer-field(v-field-name):buffer-value))
      763       temp-changes.v_new = (if available new_c-fbr-gds-grp
      764                             then string(buffer new_c-fbr-gds-grp:buffer-field(v-field-name):buffer-value)
      765                             else  (if v-is-deleted
      766                                   then '':U
      767                                   else  string(buffer current_fbr-gds-grp:buffer-field(v-field-name):buffer-value))
      768                             )
      769       .
      770     end.
      771   end.
      772   end procedure.
      773   procedure fbr-gds-grp-attr-proc :
      774   define output parameter p-description as character no-undo .
      775   define variable v-tooltip as character no-undo .
      776   define variable v-label as character no-undo .
      777   define buffer current_c-fbr-gds-grp-attr for ub.c-fbr-gds-grp-attr  .
      778     do
      779     on error undo, return error
      780     :
      781       find first current_c-fbr-gds-grp-attr no-lock where
      782                 current_c-fbr-gds-grp-attr.obj-type  = p-obj-type
      783              AND current_c-fbr-gds-grp-attr.obj-code = p-obj-code
      784              AND current_c-fbr-gds-grp-attr.node-code = p-node-code
      785              AND current_c-fbr-gds-grp-attr.chip-num = p-chip-num
      786              AND current_c-fbr-gds-grp-attr.corr-user-db-num = p-corr-user-db-num
      787              no-error .
      788       if not avail current_c-fbr-gds-grp-attr then do:
      789         v-mess = "Неверная ссылка на c-fbr-gds-grp-attr в таблице c-fbr-gds-grp-attr-hist".
      790         run err-mess in this-procedure ( input-output v-mess).
      791         return error v-mess.
      792       end.
      793       run fbr-grp-attr-tooltip in this-procedure (
      794                   input  string(current_c-fbr-gds-grp-attr.attr-code)
      795                   ,output v-tooltip
      796                   ,output v-label
      797                   ) no-error .
      798       assign
      799       p-description = "Атрибут" + chr(32) + v-label
      800       .
      801   define variable v-label-param as character no-undo .
      802   v-label-param =
      803     "attr-code" + chr(4) + "Атрибут" + chr(4) + "" + chr(8)
      804    + "attr-value" + chr(4) + "Значение" + chr(4) + "" + chr(8)
      805    + "node-code" + chr(4) + "Вн Код" + chr(4) + "" + chr(8)
      806    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
      807    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + ""  .
      808    run proc-full-temp-changes in this-procedure (
      809                                                input (buf_c-fbr-gds-grp-hist.action = integer('1':U))
      810                                               ,input (buf_c-fbr-gds-grp-hist.action = integer('99':U))
      811                                               ,input  buffer current_c-fbr-gds-grp-attr:handle
      812                                               ,input  'fbr-gds-grp-attr':U
      813                                               ,input  "attr-code,attr-value,node-code,obj-code,obj-type"
      814                                               ,input  v-label-param).
      815   end.
      816   end procedure.
      817   procedure c-get-full-name :
      818   do
      819   on error undo, return error
      820   :
      821   define input parameter p-c          as logical no-undo .
      822   define input parameter p-obj-type  as character no-undo .
      823   define input parameter p-obj-code  as integer no-undo .
      824   define input parameter p-node-code  as integer      no-undo.
      825   define input parameter p-chip-num  as integer no-undo .
      826   define input parameter p-corr-user-db-num as integer no-undo .
      827   define output parameter p-full-name as character    no-undo.
      828       define variable v-upper-code    as integer           no-undo.
      829       define variable v-c as logical no-undo .
      830       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      831       define buffer buf_upper_gds-grp for ub.fbr-gds-grp.
      832       define buffer buf_c-fbr-gds-grp       for ub.c-fbr-gds-grp.
      833       define buffer buf_c-upper_gds-grp for ub.c-fbr-gds-grp.
      834       if p-c then do:
      835         find first buf_c-fbr-gds-grp no-lock
      836             where buf_c-fbr-gds-grp.obj-type = p-obj-type
      837               AND buf_c-fbr-gds-grp.obj-code = p-obj-code
      838               AND buf_c-fbr-gds-grp.node-code = p-node-code
      839               AND buf_c-fbr-gds-grp.chip-num  = p-chip-num
      840               AND buf_c-fbr-gds-grp.corr-user-db-num  = p-corr-user-db-num
      841         no-error.
      842         if not available buf_c-fbr-gds-grp
      843         then do:
      844             undo, return error substitute("Не найдена запись истории для группы блюд: объеккт &1&2, вн № &3, chip-num &4, БД-корректор &5"
      845                                           , p-obj-type
      846                                           , p-obj-code
      847                                           , p-node-code
      848                                           , p-chip-num
      849                                           , p-corr-user-db-num
      850                                           ).
      851         end.
      852       end.
      853       else do:
      854         find first buf_fbr-gds-grp no-lock
      855             where buf_fbr-gds-grp.obj-type = p-obj-type
      856                AND buf_fbr-gds-grp.obj-code = p-obj-code
      857                AND buf_fbr-gds-grp.node-code = p-node-code
      858         no-error.
      859         if not available buf_fbr-gds-grp
      860         then do:
      861             undo, return error substitute("Не найдена запись группы блюд: объект &1&2 вн № &1"
      862                                           , p-obj-type
      863                                           , p-obj-code
      864                                           , p-node-code
      865                                           ).
      866         end.
      867       end.
      868       assign
      869           p-full-name  = ""
      870           v-upper-code = 1
      871           v-c = p-c
      872       .
      873       do while
      874       ( v-c = no and buf_fbr-gds-grp.upper-code <> 0)
      875       or ( v-c = yes and  buf_c-fbr-gds-grp.upper-code <> 0)
      876       on error undo, return error "Ошибка составления полного имени группы"
      877       :
      878           assign
      879               p-full-name  = (if v-c = yes
      880                               then buf_c-fbr-gds-grp.node-name
      881                               else buf_fbr-gds-grp.node-name)
      882                            + (if p-full-name <> "" then chr(47) else "")
      883                            + p-full-name
      884               v-upper-code = (if v-c
      885                               then buf_c-fbr-gds-grp.upper-code
      886                               else buf_fbr-gds-grp.upper-code)
      887           .
      888           find first buf_c-fbr-gds-grp no-lock
      889                where buf_c-fbr-gds-grp.obj-type  = p-obj-type
      890                  AND buf_c-fbr-gds-grp.obj-code = p-obj-code
      891                  AND buf_c-fbr-gds-grp.node-code = v-upper-code
      892                  AND buf_c-fbr-gds-grp.chip-num  > p-chip-num
      893                  AND buf_c-fbr-gds-grp.corr-user-db-num  = p-corr-user-db-num no-error .
      894           if not available buf_c-fbr-gds-grp then do:
      895             assign
      896             v-c = no
      897             .
      898             find first buf_fbr-gds-grp no-lock
      899                 where buf_fbr-gds-grp.obj-type = p-obj-type
      900                 AND buf_fbr-gds-grp.obj-code = p-obj-code
      901                 AND buf_fbr-gds-grp.node-code = v-upper-code
      902             no-error.
      903             if not available buf_fbr-gds-grp
      904             then do:
      905                 undo, return error substitute("Не найдена группа блюд с кодом &1 на объекте &2&3" +
      906                                                ". Ошибка ссылки в дереве товаров для записи истории групп товаров:" +
      907                                                "вн № &4, chip-num &5, БД-корректор &6"
      908                                               ,  v-upper-code
      909                                               , p-obj-type
      910                                               , p-obj-code
      911                                               , p-node-code
      912                                               , p-chip-num
      913                                               , p-corr-user-db-num).
      914             end.
      915           end.
      916           else do:
      917             assign
      918             v-c = yes
      919             .
      920           end.
      921       end.
      922       assign
      923       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      924       .
      925   end.
      926   end procedure.
      927   PROCEDURE err-mess:
      928     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
      929     CASE p-silent:
      930       when yes then do:
      931         p-mess =
      932         substitute("История группы блюд  с вн кодом &1 &2&3: щепка &4 БД:&5 Предмет изменений &6&7&8"
      933                     ,p-node-code, p-obj-type, p-obj-code, p-chip-num, p-corr-user-db-num, p-subject
      934                     ,chr(10)
      935                     ,p-mess
      936                     ).
      937       end.
      938       otherwise do:
      939         message
      940         p-mess
      941         view-as alert-box error .
      942       end.
      943     end.
      944   END PROCEDURE.
