      402   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      403   procedure thbjattr_code :
      404      define input  parameter p-upper-code     as character no-undo .
      405      define input  parameter p-code           as character no-undo .
      406      define output parameter p-label          as character no-undo .
      407      define output parameter p-user-can-edit  as logical   no-undo .
      408      define output parameter p-output-display as logical   no-undo .
      409      define output parameter p-other          as character no-undo .
      410      define output parameter p-prop-list      as character no-undo .
      411      define output parameter p-prop-type-list as character no-undo .
      412      define output parameter p-prop-label-list as character no-undo .
      413      define output parameter p-global          as logical no-undo .
      414      define output parameter p-host           as logical no-undo .
      415      define output parameter p-shop           as logical no-undo .
      416      define output parameter p-store          as logical no-undo .
      417      define output parameter p-db             as logical no-undo .
      418      define variable p-region as logical no-undo.
      419      run thbjattr_code_reg in this-procedure (
      420                                               p-upper-code,
      421                                               p-code,
      422                                               output p-label,
      423                                               output p-user-can-edit,
      424                                               output p-output-display,
      425                                               output p-other,
      426                                               output p-prop-list,
      427                                               output p-prop-type-list,
      428                                               output p-prop-label-list,
      429                                               output p-global,
      430                                               output p-host,
      431                                               output p-shop,
      432                                               output p-store,
      433                                               output p-db,
      434                                               output p-region
      435                                               ).
      436   end procedure.
      437   procedure thbjattr_code_reg :
      438   define input  parameter p-upper-code     as character no-undo .
      439   define input  parameter p-code           as character no-undo .
      440   define output parameter p-label          as character no-undo .
      441   define output parameter p-user-can-edit  as logical   no-undo .
      442   define output parameter p-output-display as logical   no-undo .
      443   define output parameter p-other          as character no-undo .
      444   define output parameter p-prop-list      as character no-undo .
      445   define output parameter p-prop-type-list as character no-undo .
      446   define output parameter p-prop-label-list as character no-undo .
      447   define output parameter p-global          as logical no-undo .
      448   define output parameter p-host           as logical no-undo .
      449   define output parameter p-shop           as logical no-undo .
      450   define output parameter p-store          as logical no-undo .
      451   define output parameter p-db             as logical no-undo .
      452   define output parameter p-region         as logical no-undo .
      453   do
      454   on error undo, return error return-value
      455   :
      456       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      457       (input  p-upper-code
      458       ,input  p-code
      459       ,output p-label
      460       ,output p-user-can-edit
      461       ,output p-output-display
      462       ,output p-other
      463       ,output p-prop-list
      464       ,output p-prop-type-list
      465       ,output p-prop-label-list
      466       ,output p-global
      467       ,output p-host
      468       ,output p-shop
      469       ,output p-store
      470       ,output p-db
      471       ,output p-region
      472       ) no-error .
      473     if error-status :error
      474     then do:
      475       undo, return error substitute( "&1. &2&3&4", vss-include-info3, return-value, chr(10), error-status :get-message (1)).
      476     end.
      477   end.
      478   end procedure.
      479   procedure thbjattr_tooltip :
