      689   define temp-table tt-gds-merq no-undo
      690     field ID             as integer
      691     field merc-name      like ub.goods.gds-name label "Полное наименование" format "X(100)"
      692     field UUID           as character label "UUID"
      693     field GUID_          as character label "GUID"
      694     field units          as character label "Ед.измерения"
      695     field units_th       as character label "Ед.измерения в ТН"
      696     field status_        as integer   label "Статус"
      697     field crDate         as date      label "Дата создания" format "99.99.9999"
      698     field update_Date    as date      label "Дата изменени" format "99.99.9999"
      699     field prod-type      as integer   label "Тип продукции" format ">>>>9"
      700     field prod-type-name as character label "Тип продукции"
      701     field GUID-type      as character label "GUID-type"
      702     field GUID-subtype   as character label "GUID-subtype"
      703     index pi as primary
      704     ID
      705     index name_ as word-index
      706     merc-name
      707     index merq
      708     GUID_
      709     .
      710   PROCEDURE checkguid :
      711     define INPUT-output parameter guid_ as CHARACTER NO-UNDO .
      712     define OUTPUT parameter Msg as CHARACTER  NO-UNDO .
      713     def var ii      as int       no-undo.
      714     def var err     as logical   no-undo.
      715     def var str     as character no-undo.
      716     def var numentr as integer   no-undo.
      717     numentr = num-entries (guid_, "-") no-error.
      718     if numentr = 8
      719       then
      720     do:
      721       do ii = 1 to numentr:
      722         if length (trim (entry (ii, guid_, "-"))) <> 4
      723           then err = true.
      724         str = str + trim (entry (ii, guid_, "-")).
      725         if ii = 2 or ii = 3 or ii = 4 or ii = 5
      726           then
      727         do:
      728           str = str + "-".
      729         end.
      730       end.
      731       guid_ = str.
      732     end.
      733     numentr = num-entries (guid_, "-") no-error.
      734     do ii = 1 to numentr:
      735       case ii:
      736         when 1 then
      737           do:
      738             if length (trim (entry (ii, guid_, "-"))) <> 8
      739               then err = true.
      740           end.
      741         when 2 or
      742         when 3 or
      743         when 4 then
      744           do:
      745             if length (entry (ii, guid_, "-")) <> 4
      746               then err = true.
      747           end.
      748         when 5 then
      749           do:
      750             if length (entry (ii, guid_, "-")) <> 12
      751               then err = true.
      752           end.
      753       end case.
      754     end.
      755     if ii <> 6
      756       then err = true.
      757     if err then Msg = "Неверный формат GUID".
      758   END PROCEDURE.
      759   DEFINE BUFFER buf_gds-mercury for ub.gds-mercury .
      760   DEFINE BUFFER buf_goods       for ub.goods .
      761   define variable v-login           as character no-undo .
      762   define variable v-password        as character no-undo .
      763   define variable v-server          as character no-undo .
      764   define variable v-proxy-login     as character no-undo .
      765   define variable v-proxy-pswd      as character no-undo .
      766   define variable v-proxy-addres    as character no-undo .
      767   define variable v-proxy-ssl       as logical   no-undo .
      768   define variable par-type          as character no-undo.
      769   define variable gdsMercsubsObj    as class     gdsmercsubs.
      770   define variable gdsMercObj        as class     gdsmercsub.
      771   define variable gdsmercstrObj     as class     gdsmercstr.
      772   define variable parser            as class     ParserXMLGds.
      773   define variable v-value-character as character no-undo .
      774   define variable v-value-decimal   as decimal   no-undo .
      775   define variable v-value-integer   as integer   no-undo .
      776   define variable v-value-logical   as logical   no-undo .
      777   define variable v-value-type      as character no-undo .
      778   define variable v-value-date      as date      no-undo .
      779   DEFINE BUTTON B-exit AUTO-GO
      780     LABEL "&Ввод"
      781     SIZE 10 BY 1
      782     BGCOLOR 8 .
      783   DEFINE BUTTON B-Help
      784     LABEL "Помо&щь"
      785     SIZE 3 BY 1
      786     BGCOLOR 8 .
      787   DEFINE BUTTON B-prod-type
      788     IMAGE-UP FILE "btn-down-arrow":U
      789     IMAGE-DOWN FILE "btn-down-arrow":U
      790     IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      791     LABEL ""
      792     SIZE 3 BY 1.
      793   DEFINE BUTTON b-quit AUTO-END-KEY
      794     LABEL "&Отмена"
      795     SIZE 10 BY 1
      796     BGCOLOR 8 .
      797   DEFINE VARIABLE f-gds-name     AS CHARACTER FORMAT "X(256)":U
      798     LABEL "Наим. товара в ТН"
      799     VIEW-AS FILL-IN
      800     SIZE 45 BY 1 NO-UNDO.
      801   DEFINE VARIABLE f-guid         AS CHARACTER FORMAT "X(256)":U
      802     LABEL "GUID"
      803     VIEW-AS FILL-IN
      804     SIZE 45 BY 1 NO-UNDO.
      805   DEFINE VARIABLE f-guid-subtype AS CHARACTER FORMAT "X(256)":U
      806     LABEL "GUID подгруппы"
      807     VIEW-AS FILL-IN
      808     SIZE 45 BY 1 NO-UNDO.
      809   DEFINE VARIABLE f-guid-type    AS CHARACTER FORMAT "X(256)":U
      810     LABEL "GUID группы"
      811     VIEW-AS FILL-IN
      812     SIZE 45 BY 1 NO-UNDO.
      813   DEFINE VARIABLE f-merc-name    AS CHARACTER FORMAT "X(256)":U
      814     LABEL "Наим. товара"
      815     VIEW-AS FILL-IN
      816     SIZE 45 BY 1 NO-UNDO.
      817   DEFINE VARIABLE f-prod-type    AS CHARACTER FORMAT "X(256)":U
      818     LABEL "Тип продукции"
      819     VIEW-AS FILL-IN
      820     SIZE 41.75 BY 1 NO-UNDO.
      821   DEFINE VARIABLE f-uuid         AS CHARACTER FORMAT "X(256)":U
      822     LABEL "UUID"
      823     VIEW-AS FILL-IN
      824     SIZE 45 BY 1 NO-UNDO.
      825   DEFINE FRAME Dialog-Frame
      826     B-exit AT ROW 1 COL 1
      827     b-quit AT ROW 1 COL 11
      828     B-Help AT ROW 1 COL 68
      829     f-gds-name AT ROW 2.29 COL 3 WIDGET-ID 24
      830     f-merc-name AT ROW 3.58 COL 8 WIDGET-ID 34
      831     f-guid AT ROW 4.92 COL 16 WIDGET-ID 14
      832     f-uuid AT ROW 6.13 COL 16 WIDGET-ID 22
      833     f-prod-type AT ROW 7.33 COL 7.13 WIDGET-ID 26
      834     B-prod-type AT ROW 7.33 COL 64.38 WIDGET-ID 32
      835     f-guid-type AT ROW 8.54 COL 9.13 WIDGET-ID 28
      836     f-guid-subtype AT ROW 9.75 COL 6.25 WIDGET-ID 30
      837     SPACE(4.37) SKIP(0.49)
      838     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      839     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      840     TITLE "Товары из Меркурия"
      841     DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      842   ASSIGN
      843     FRAME Dialog-Frame:SCROLLABLE = FALSE
      844     FRAME Dialog-Frame:HIDDEN     = TRUE.
      845   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      846     DO:
      847       APPLY "END-ERROR":U TO SELF.
      848     END.
      849   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      850     DO:
      851       RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      852       IF ERROR-STATUS:error THEN RETURN NO-APPLY.
      853     END.
      854   ON CHOOSE OF B-prod-type IN FRAME Dialog-Frame
      855     DO:
      856       run bge/merq-ref-tnved.w (parparentproc, 'ПРОСМОТР':U, "") no-error.
      857       if RETURN-VALUE = "" then
      858       do:
      859         MESSAGE "Не выбран тип продукции"
      860           VIEW-AS ALERT-BOX.
      861         return no-apply.
      862       end.
      863       assign
      864         f-prod-type    = entry(1,RETURN-VALUE)
      865         f-guid-type    = entry(3,RETURN-VALUE)
      866         f-guid-subtype = entry(4,RETURN-VALUE)
      867         .
      868       DISPLAY
      869         f-guid-subtype
      870         f-guid-type
      871         f-prod-type
      872         with frame Dialog-Frame .
      873     END.
      874   ON return, MOUSE-SELECT-DBLCLICK OF f-guid IN FRAME Dialog-Frame DO:
      875   apply "leave" to f-guid in frame Dialog-Frame.
      876   apply "choose" to B-exit in frame Dialog-Frame.
      877   END.
      878   ON LEAVE OF f-guid IN FRAME Dialog-Frame
      879     DO:
      880       define variable Msg as character no-undo .
      881       ASSIGN f-guid .
      882       run checkguid(INPUT-OUTPUT f-guid,OUTPUT Msg) no-error .
      883       if Msg <> "" then
      884       do:
      885         MESSAGE Msg
      886           VIEW-AS ALERT-BOX.
      887         return NO-APPLY .
      888       end.
      889     END.
      890   ON LEAVE OF f-uuid IN FRAME Dialog-Frame
      891     DO:
      892     END.
      893   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      894     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      895   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      896   on help of frame Dialog-Frame
      897   do:
      898     run gbl/app_help.p
      899       (input this-procedure :file-name
      900       ,input ''
      901       ,input ?
      902       ) no-error.
      903     if error-status :error then do:
      904       message
      905         "Ошибка при вызове помощи"
      906         error-status :get-message(1)
      907         view-as alert-box .
      908     end.
      909   end.
      910   run minbtn-set in this-procedure .
      911   on choose of b-help in frame Dialog-Frame
      912   do:
      913     apply "help":u to frame Dialog-Frame .
      914   end.
      915   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      916   procedure minbtn-set :
      917       do
      918           on error undo, return error return-value
      919           :
      920           define variable ii              as integer       no-undo .
      921           define variable fh              as widget-handle no-undo .
      922           define variable hh              as widget-handle no-undo .
      923           define variable v-h             as handle        extent 4 no-undo .
      924           define variable v-name-button   as character     no-undo .
      925           define variable v-help-old-x    as decimal       no-undo .
      926           define variable v-help-old-y    as decimal       no-undo .
      927           define variable v-help-old-size as decimal       no-undo .
      928           define variable v-frame-width   as decimal       no-undo .
      929           define variable jj              as integer       no-undo .
      930           do
      931               on error undo, return error
      932               :
      933               assign
      934                   v-frame-width = frame Dialog-Frame:width - 0.3
      935                   fh            = frame Dialog-Frame:first-child
      936                   hh            = fh:first-child
      937                   ii            = 1
      938                   .
      939               do while valid-handle(hh):
      940                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      941                   do:
      942                       case lc(hh:name) :
      943                           when "b-help" then
      944                               do:
      945                                   hh:load-image-up("cmp/b-help.bmp":u) .
      946                                   hh:load-image-down("cmp/b-help.bmp":u) .
      947                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      948                                   hh:TOOLTIP = "Помощь" .
      949                                   v-help-old-x = hh:column .
      950                                   v-help-old-y = hh:row    .
      951                                   v-help-old-size = hh:width .
      952                                   hh:width-chars = 2.5 .
      953                               end.
      954                           when "b-print" then
      955                               do:
      956                                   hh:load-image("cmp/b-print.bmp":u) .
      957                                   hh:TOOLTIP = "Печать" .
      958                                   v-h[ii] = hh:handle .
      959                                   ii = ii + 1 .
      960                                   hh:width-chars = 3 .
      961                               end.
      962                           when "b-history" or
      963                           when "b-hist" then
      964                               do:
      965                                   hh:load-image("cmp/b-hist.bmp":u) .
      966                                   hh:TOOLTIP = "История" .
      967                                   v-h[ii] = hh:handle .
      968                                   ii = ii + 1 .
      969                                   hh:width-chars = 3 .
      970                               end.
      971                           when "b-sch" then
      972                               do:
      973                                   hh:load-image("cmp/b-sch.bmp":u) .
      974                                   hh:TOOLTIP = "Установка Фильтра" .
      975                                   v-h[ii] = hh:handle .
      976                                   ii = ii + 1 .
      977                                   hh:width-chars = 3 .
      978                               end.
      979                           when "b-hist-user" then
      980                               do:
      981                                   hh:load-image("cmp/b-hist.bmp":u) .
      982                                   hh:TOOLTIP = "История пользователя" .
      983                                   ii = ii + 1 .
      984                               end.
      985                       end case.
      986                   end.
      987                   hh = hh:next-sibling.
      988               end.
      989               b-help:column = v-frame-width - b-help:width-chars.
      990               jj = 0.
      991               repeat ii = 4 to 1 by -1 :
      992                   if valid-handle (v-h[ii] ) then
      993                   do:
      994                       jj  = jj + 1 .
      995                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      996                       v-h[ii]:row    = v-help-old-y .
      997                   end.
      998               end.
      999           end.
     1000       end.
     1001   end procedure.
     1002   MAIN-BLOCK:
     1003   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1004     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1005     RUN Myenable IN THIS-PROCEDURE.
     1006     WAIT-FOR GO OF FRAME Dialog-Frame.
     1007   END.
     1008   RUN disable_UI.
     1009   PROCEDURE disable_UI :
     1010     HIDE FRAME Dialog-Frame.
     1011   END PROCEDURE.
     1012   PROCEDURE enable_UI :
     1013     DISPLAY f-gds-name f-merc-name f-guid f-uuid f-prod-type f-guid-type
     1014       f-guid-subtype
     1015       WITH FRAME Dialog-Frame.
     1016     ENABLE B-exit b-quit B-Help f-uuid
     1017       WITH FRAME Dialog-Frame.
     1018     VIEW FRAME Dialog-Frame.
     1019   END PROCEDURE.
     1020   PROCEDURE fill-tt :
     1021     define variable ii             as integer no-undo .
     1022     define variable gdsMercsubsObj as class   gdsmercsubs.
     1023     define variable gdsmercstrObj  as class   gdsmercstr.
     1024     gdsMercsubsObj = new gdsmercsubs ().
     1025     gdsmercstrObj = new gdsmercstr ().
     1026     gdsMercsubsObj = gdsmercstrObj:getgdsmercs(p-gds-code).
     1027     if VALID-OBJECT (gdsMercsubsObj:GdsMercsubsCurr) then
     1028     do:
     1029       do ii = 1 to gdsMercsubsObj:GetItem (ii):
     1030         gdsMercObj = gdsMercsubsObj:GdsMercsubsCurr.
     1031         assign
     1032           f-merc-name    = gdsMercObj:MercName
     1033           f-uuid         = gdsMercObj:UUID
     1034           f-guid         = gdsMercObj:GUID_
     1035           f-prod-type    = gdsMercObj:ProdType
     1036           f-guid-type    = gdsMercObj:GUIDType
     1037           f-guid-subtype = gdsMercObj:GUIDSubType
     1038           .
     1039       end.
     1040     end.
     1041     find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
     1042     if AVAILABLE (buf_goods) then
     1043     do:
     1044       ASSIGN
     1045         f-gds-name = buf_goods.gds-name
     1046         .
     1047     end.
     1048   END PROCEDURE.
     1049   PROCEDURE enable_UI_fill :
     1050     DISPLAY
     1051       f-gds-name
     1052       f-merc-name
     1053       f-guid
     1054       f-guid-subtype
     1055       f-guid-type
     1056       f-prod-type
     1057       f-uuid
     1058       with frame Dialog-Frame.
     1059   END PROCEDURE.
     1060   PROCEDURE MyEnable :
     1061     if p-mode = 'ИЗМЕНЕНИЕ':U then
     1062     do:
     1063       enable
     1064         f-guid
     1065         B-prod-type
     1066         B-exit b-quit B-Help
     1067         with frame Dialog-Frame .
     1068       SECURITY-POLICY:SYMMETRIC-ENCRYPTION-KEY = GENERATE-PBE-KEY("sysadm").
     1069   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1070   empty temp-table thbjattr_thbj-attr.
     1071   run adm/shattri.p (
     1072      input "get":U
     1073     ,input v-cntxt-obj-type
     1074     ,input v-cntxt-obj-code
     1075     ,input 'mercur':U
     1076     ,input  ""
     1077     ,output v-value-character
     1078     ,output v-value-date
     1079     ,output v-value-decimal
     1080     ,output v-value-integer
     1081     ,output v-value-logical
     1082     ,output par-type
     1083     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1084     ) no-error .
     1085       for each thbjattr_thbj-attr :
     1086         case thbjattr_thbj-attr.prop-code :
     1087           when "login" then
     1088             v-login = thbjattr_thbj-attr.property-value-character .
     1089           when "password" then
     1090             v-password = thbjattr_thbj-attr.property-value-character .
     1091           when "server" then
     1092             do:
     1093               case thbjattr_thbj-attr.property-value-integer :
     1094                 when 1 then
     1095                   do:
     1096                     v-server = "https://api2.vetrf.ru:8002" .
     1097                   end.
     1098                 when 2 then
     1099                   do:
     1100                     v-server = "https://api.vetrf.ru" .
     1101                   end.
     1102               end case .
     1103             end.
     1104           when "proxy-addres" then
     1105             v-proxy-addres = thbjattr_thbj-attr.property-value-character .
     1106           when "proxy-login" then
     1107             do:
     1108               if thbjattr_thbj-attr.property-value-character <> ""
     1109               then do :
     1110   define variable vss-include-info8 as character format "X(65)" no-undo
     1111   initial "@(#)$Workfile$ $Revision$".
     1112   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
     1113     (input  thbjattr_thbj-attr.property-value-character
     1114     ,output v-proxy-login
     1115     ) no-error .
     1116               end.
     1117             end.
     1118           when "proxy-pswd" then
     1119             do:
     1120               if thbjattr_thbj-attr.property-value-character <> ""
     1121               then do :
     1122   define variable vss-include-info9 as character format "X(65)" no-undo
     1123   initial "@(#)$Workfile$ $Revision$".
     1124   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pdecrypt in g#library2
     1125     (input  thbjattr_thbj-attr.property-value-character
     1126     ,output v-proxy-pswd
     1127     ) no-error .
     1128               end.
     1129             end.
     1130           when "proxy-ssl" then
     1131             v-proxy-ssl = thbjattr_thbj-attr.property-value-logical .
     1132         end case.
     1133       end.
     1134     end.
     1135     else
     1136     do:
     1137       enable
     1138         B-exit b-quit B-Help
     1139         with frame Dialog-Frame .
     1140     end.
     1141     VIEW FRAME Dialog-Frame.
     1142     run fill-tt .
     1143     run enable_UI_fill .
     1144   END PROCEDURE.
     1145   PROCEDURE proc-save :
     1146     define variable ii              as integer   no-undo .
     1147     define variable cmd             as character no-undo .
     1148     define variable sw              as handle    no-undo .
     1149     define variable v-file-gds      as character no-undo initial "getItemList_.xml".
     1150     define variable Msg             as character no-undo .
     1151     define variable choice          as logical   no-undo .
     1152     define variable gdsMercsubsObj  as class     gdsmercsubs.
     1153     define variable gdsmercstrObj   as class     gdsmercstr.
     1154     define variable GuidMercsubsObj as class     gdsmercsubs.
     1155     gdsMercsubsObj = new gdsmercsubs ().
     1156     gdsmercstrObj = new gdsmercstr ().
     1157     gdsMercsubsObj = gdsmercstrObj:getgdsmercs(p-gds-code).
     1158     if p-mode = 'ИЗМЕНЕНИЕ':U then
     1159     do:
     1160       if f-guid <> "" then
     1161       do:
     1162         GuidMercsubsObj = gdsmercstrObj:getguidmercs(f-guid).
     1163         if VALID-OBJECT (GuidMercsubsObj:GdsMercsubsCurr) then
     1164         do:
     1165         if GuidMercsubsObj:iCounter >= 1 then do:
     1166           message
     1167             "Товар с таким GUID уже есть"
     1168             view-as alert-box.
     1169             RETURN NO-APPLY .
     1170           end.
     1171         end.
     1172         create sax-writer sw .
     1173         sw:formatted = true.
     1174         sw:set-output-destination ("file", v-file-gds).
     1175         sw:encoding = "UTF-8".
     1176         sw:start-document () .
     1177         sw:start-element ("se:Envelope") .
     1178         sw:insert-attribute ("xmlns:se", "http://schemas.xmlsoap.org/soap/envelope/") .
     1179         sw:insert-attribute ("xmlns:ws", "http://api.vetrf.ru/schema/cdm/registry/ws-definitions/v2") .
     1180         sw:insert-attribute ("xmlns:bs", "http://api.vetrf.ru/schema/cdm/base") .
     1181         sw:insert-attribute ("xmlns:dt", "http://api.vetrf.ru/schema/cdm/dictionary/v2") .
     1182         sw:start-element ("se:Body") .
     1183         sw:start-element ("ws:getProductItemByGuidRequest") .
     1184         sw:write-data-element ("bs:guid", f-guid) .
     1185         sw:end-element ("ws:getProductItemByGuidRequest") .
     1186         sw:end-element ("se:Body") .
     1187         sw:end-element ("se:Envelope") .
     1188         sw:end-document () .
     1189         if trim(v-proxy-addres) <> "" and v-proxy-addres <> ?
     1190         then do :
     1191           if v-proxy-ssl
     1192           then do :
     1193             cmd = substitute ("&1 -k --proxy-negotiate -x &7 -U : -u &4:&5 -d @&2 &6/platform/services/2.1/ProductService >&3",
     1194                             search ("exe/curl.exe"), search (v-file-gds), "ItemList_.xml", v-login, v-password, v-server, v-proxy-addres).
     1195           end.
     1196           else do :
     1197             cmd = substitute ("&1 -x &7 -U &8:&9 -u &4:&5 -d @&2 &6/platform/services/2.1/ProductService >&3",
     1198                             search ("exe/curl.exe"), search (v-file-gds), "ItemList_.xml", v-login, v-password, v-server, v-proxy-addres, v-proxy-login, v-proxy-pswd).
     1199           end.
     1200         end.
     1201         else do :
     1202           cmd = substitute ("&1 -u &4:&5 -d @&2 &6/platform/services/2.1/ProductService >&3", search ("exe/curl.exe"), search (v-file-gds), "ItemList_.xml", v-login, v-password, v-server).
     1203         end.
     1204         os-command silent value (cmd).
     1205         parser = new parserXmlGDS().
     1206         parser:ParseResponse
     1207           (search("ItemList_.xml")
     1208           ,input-output TABLE tt-gds-merq
     1209           ,output Msg) no-error.
     1210         if Msg <> "" then
     1211         do:
     1212           MESSAGE Msg
     1213             VIEW-AS ALERT-BOX.
     1214         end.
     1215         if Msg = "" then
     1216         do:
     1217           find first tt-gds-merq no-lock no-error .
     1218           if AVAILABLE (tt-gds-merq) then
     1219           do:
     1220             if VALID-OBJECT (gdsMercsubsObj:GdsMercsubsCurr) then
     1221             do:
     1222               do ii = 1 to gdsMercsubsObj:GetItem (ii):
     1223                 gdsMercObj = gdsMercsubsObj:GdsMercsubsCurr.
     1224                 assign
     1225                   gdsMercObj:MercName    = tt-gds-merq.merc-name
     1226                   gdsMercObj:UUID        = tt-gds-merq.UUID
     1227                   gdsMercObj:GUID_       = tt-gds-merq.GUID_
     1228                   gdsMercObj:ProdType    = STRING (tt-gds-merq.prod-type)
     1229                   gdsMercObj:GUIDType    = tt-gds-merq.GUID-type
     1230                   gdsMercObj:GUIDSubType = tt-gds-merq.GUID-subtype
     1231                   .
     1232               end.
     1233               gdsmercstrObj:updateDB(gdsMercObj).
     1234             end.
     1235             else
     1236             do:
     1237               gdsMercObj = new gdsmercsub().
     1238               assign
     1239                 gdsMercObj:GdsCode     = p-gds-code
     1240                 gdsMercObj:MercName    = tt-gds-merq.merc-name
     1241                 gdsMercObj:UUID        = tt-gds-merq.UUID
     1242                 gdsMercObj:GUID_       = tt-gds-merq.GUID_
     1243                 gdsMercObj:ProdType    = STRING (tt-gds-merq.prod-type)
     1244                 gdsMercObj:GUIDType    = tt-gds-merq.GUID-type
     1245                 gdsMercObj:GUIDSubType = tt-gds-merq.GUID-subtype
     1246                 .
     1247               gdsmercstrObj:insertDB(gdsMercObj).
     1248             end.
     1249           end.
     1250         end.
     1251       end.
     1252       if f-guid = "" or Msg <> "" then
     1253       do:
     1254         if VALID-OBJECT (gdsMercsubsObj:GdsMercsubsCurr) then
     1255         do:
     1256           do ii = 1 to gdsMercsubsObj:GetItem (ii):
     1257             gdsMercObj = gdsMercsubsObj:GdsMercsubsCurr.
     1258             assign
     1259               gdsMercObj:MercName    = f-merc-name
     1260               gdsMercObj:UUID        = f-uuid
     1261               gdsMercObj:GUID_       = f-guid
     1262               gdsMercObj:ProdType    = f-prod-type
     1263               gdsMercObj:GUIDType    = f-guid-type
     1264               gdsMercObj:GUIDSubType = f-guid-subtype
     1265               .
     1266           end.
     1267           gdsmercstrObj:updateDB(gdsMercObj).
     1268         end.
     1269         else
     1270         do:
     1271           gdsMercObj = new gdsmercsub().
     1272           assign
     1273             gdsMercObj:GdsCode     = p-gds-code
     1274             gdsMercObj:MercName    = f-merc-name
     1275             gdsMercObj:UUID        = f-uuid
     1276             gdsMercObj:GUID_       = f-guid
     1277             gdsMercObj:ProdType    = f-prod-type
     1278             gdsMercObj:GUIDType    = f-guid-type
     1279             gdsMercObj:GUIDSubType = f-guid-subtype
     1280             .
     1281           gdsmercstrObj:insertDB(gdsMercObj).
     1282         end.
     1283       end.
     1284     end.
     1285     delete object gdsMercObj no-error .
     1286     delete object gdsmercstrObj no-error .
     1287     delete object gdsMercsubsObj no-error .
     1288   END PROCEDURE.
