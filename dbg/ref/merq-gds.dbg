      398   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      399   define new global shared variable g#attr-lib  as handle no-undo .
      400   define variable v-attr-lib-variable as handle no-undo .
