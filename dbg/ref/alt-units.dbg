        1   using Progress.Lang.*.
        2   using ibs.th.str.gds.*.
        3   using ibs.th.str.mercury.*.
        4   using ibs.th.gbl.storage.*.
        5   define input parameter parparentproc as handle no-undo .
        6   define input parameter p-mode        as character no-undo .
        7   define input parameter p-gds-code    as integer no-undo .
        8   define input parameter p-unit-list   as character no-undo .
        9   define output parameter p-unit-name  as character no-undo .
       10   define output parameter p-coeff      as decimal no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision$":u .
       12   define variable vss-author      as character no-undo init "$Author$":u .
       13   define variable vss-date        as character no-undo init "$Date$":u .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       15   define variable vss-archive     as character no-undo init "$Archive$":u .
       16   define variable vss-description as character no-undo init "Справочник единиц измерения" .
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123     define variable v-cntxt-db-num        as integer   no-undo .
      124     define variable v-cntxt-userid        as character no-undo .
      125     define variable v-cntxt-level         as character no-undo .
      126     define variable v-cntxt-host-code-obj as integer   no-undo .
      127     define variable v-cntxt-obj-type      as character no-undo .
      128     define variable v-cntxt-obj-code      as integer   no-undo .
      129     define variable v-cntxt-db-num-obj    as integer   no-undo .
      130     define variable v-cntxt-is-admin      as logical   no-undo .
      131   define variable ri as recid no-undo.
      132   define variable glog as logical no-undo .
      133   define variable ii as integer no-undo .
      134   define variable v-unit-name as character no-undo .
      135   define variable v-value as character no-undo .
      136   define variable v-coeff as decimal no-undo .
      137   define variable unitsObj as class unitsubs .
      138   define variable unitObj as class unitsub .
      139   define variable unitsObj2 as class unitsubs .
      140   define variable unitsStr as class unitmercstr .
      141   define buffer buf_units for ub.units .
      142   define buffer buf_units-attr for ub.units-attr .
      143   define buffer buf_goods for ub.goods .
      144   define temp-table tt-units like ub.units
      145     field guid_ as character format "X(40)"
      146     field coeff as decimal
      147   .
      148   define buffer buf_tt-units for tt-units .
      149   DEFINE BUTTON b-add-unit
      150        LABEL "&Добавить":L
      151        SIZE 10 BY 1.
      152   DEFINE BUTTON b-change
      153        LABEL "&Изменить":L
      154        SIZE 10 BY 1.
      155   DEFINE BUTTON b-exit AUTO-END-KEY
      156        LABEL "&Выход ":L
      157        SIZE 10 BY 1.
      158   DEFINE BUTTON b-select
      159        LABEL "Вы&брать":L
      160        SIZE 10 BY 1.
      161   DEFINE BUTTON b-del
      162        LABEL "Удалить":L
      163        SIZE 10 BY 1.
      164   DEFINE QUERY br-units FOR tt-units SCROLLING.
      165   DEFINE BROWSE br-units QUERY br-units NO-LOCK DISPLAY
      166         tt-units.unit-name
      167         tt-units.long-name FORMAT "X(30)"
      168         tt-units.coeff COLUMn-LABEL "Коэфф." format ">>>>>>>>9.<<<<<<<<"
      169         tt-units.guid_ column-label "GUID в ФГИС Меркурий" format "X(40)"
      170       WITH SEPARATORS
      171              size 90.25 by 12.58
      172            .
      173            .
      174   DEFINE FRAME d-units
      175        br-units at row 2.5 col 3
      176        b-exit at row 1 col 1
      177        b-select at row 1 col 11
      178        b-add-unit at row 1 col 21
      179        b-change at row 1 col 31
      180        b-del at row 1 col 41
      181       WITH VIEW-AS DIALOG-BOX
      182            SIDE-LABELS THREE-D
      183            SCROLLABLE size 93.5 by 16.25
      184            TITLE "ДОПОЛНИТЕЛЬНЫЕ ЕДИНИЦЫ  ИЗМЕРЕНИЯ":L.
      185   ASSIGN
      186          FRAME d-units:SCROLLABLE       = FALSE.
      187   ON CHOOSE OF b-add-unit IN FRAME d-units
      188   DO:
      189     run bge\units-merc.w (input parparentproc,
      190                           input yes,
      191                           output v-unit-name) .
      192     if v-unit-name <> ? and v-unit-name <> ""
      193     then do :
      194       find first ub.goods no-lock where ub.goods.gds-code = p-gds-code .
      195       if ub.goods.unit-base = v-unit-name
      196       then do :
      197         message "Данная ед. изм. совпадает с учётной." view-as alert-box .
      198         return no-apply .
      199       end.
      200       find first buf_tt-units no-lock where buf_tt-units.unit-name = v-unit-name no-error .
      201       if available buf_tt-units
      202       then do :
      203         message "Данная ед. изм. уже добавлена." view-as alert-box .
      204         return no-apply .
      205       end.
      206       run gbl/d-prompt.w (
      207           'title=':u + "ВВЕДИТЕ КОЭФФИЦИЕНТ" + '\':u
      208         + 'text1=' + substitute("Коэффициент") + '\':u
      209         + 'format=' + ">>>>>>>>9.<<<<<<<<" + '\':u
      210         + 'type=' + 'D':U + '\':u
      211         + 'fillin_row=2\':u
      212         + 'fillin_col=4\':u
      213         + 'fillin_width=30\':u
      214         + 'fillin_height=1\':u
      215         + 'max-chars=70\':u
      216         + 'readonly=no\':u
      217         , input-output v-value
      218         ).
      219       if v-value <> ? and v-value <> ""
      220       then do :
      221         v-coeff = decimal(v-value) no-error.
      222         if error-status:error
      223         then do :
      224           message "Введен неверный коэффициент" view-as alert-box .
      225           return no-apply .
      226         end.
      227         find first buf_units no-lock where buf_units.unit-name = v-unit-name .
      228         find first buf_units-attr no-lock where buf_units-attr.unit-name = v-unit-name no-error .
      229         create tt-units.
      230         assign
      231           tt-units.unit-name = buf_units.unit-name
      232           tt-units.long-name = buf_units.long-name
      233           tt-units.guid_     = if available buf_units-attr then buf_units-attr.attr-value else ""
      234           tt-units.coeff     = v-coeff
      235         .
      236         OPEN QUERY br-units FOR EACH tt-units exclusive-LOCK  .
      237       end.
      238     end.
      239   END.
      240   ON CHOOSE OF b-change IN FRAME d-units
      241   DO:
      242     if not available tt-units then return no-apply .
      243     run gbl/d-prompt.w (
      244         'title=':u + "ВВЕДИТЕ КОЭФФИЦИЕНТ" + '\':u
      245       + 'text1=' + substitute("Коэффициент") + '\':u
      246       + 'format=' + ">>>>>>>>9.<<<<<<<<" + '\':u
      247       + 'type=' + 'D':U + '\':u
      248       + 'fillin_row=2\':u
      249       + 'fillin_col=4\':u
      250       + 'fillin_width=30\':u
      251       + 'fillin_height=1\':u
      252       + 'max-chars=70\':u
      253       + 'readonly=no\':u
      254       , input-output v-value
      255       ).
      256     if v-value <> ? and v-value <> ""
      257     then do :
      258       v-coeff = decimal(v-value) no-error.
      259       if error-status:error
      260       then do :
      261         message "Введен неверный коэффициент" view-as alert-box .
      262         return no-apply .
      263       end.
      264       assign
      265         tt-units.coeff     = v-coeff
      266       .
      267       br-units:refresh () .
      268     end.
      269   END.
      270   ON CHOOSE OF b-del IN FRAME d-units
      271   DO:
      272     if not available tt-units then return no-apply .
      273     delete tt-units .
      274     br-units:refresh () .
      275   END.
      276   ON CHOOSE OF b-select IN FRAME d-units
      277   DO:
      278       // @FUTU вместо идент.ЕИ можно возвращать класс, содержащий выбранную единицу измерения
      279       if available tt-units then do:
      280         assign
      281           p-unit-name = tt-units.unit-name
      282           p-coeff     = tt-units.coeff
      283         .
      284         apply  "GO" to FRAME d-units.
      285       end.
      286   END.
      287   ON DEFAULT-ACTION OF br-units IN FRAME d-units
      288   DO:
      289       if p-mode = 'ВЫБОР':U then
      290         apply "CHOOSE":U to b-select.
      291   END.
      292   ON RETURN OF br-units IN FRAME d-units
      293   DO:
      294       if p-mode = 'ВЫБОР':U then
      295         apply "CHOOSE":U to b-select.
      296   END.
      297   ON CHOOSE OF b-exit IN FRAME d-units
      298   DO:
      299     if (p-mode <> 'ВЫБОР':U) then do :
      300     find first tt-units no-lock no-error.
      301     if available tt-units
      302     then do :
      303       unitsObj2 = new unitsubs () .
      304       for each tt-units no-lock :
      305         unitObj = new unitsub () .
      306         unitObj:UnitName = tt-units.unit-name .
      307         unitObj:UnitFullName = tt-units.long-name .
      308         unitObj:UnitGuid = tt-units.guid_ .
      309         unitObj:UnitCoef = tt-units.coeff .
      310         unitsObj2:AddItem(unitObj) .
      311       end.
      312       unitsStr:writeDB(unitsObj2, p-gds-code) .
      313     end.
      314     else do :
      315       unitsStr:deleteDB(p-gds-code) .
      316     end.
      317     delete object unitsObj2 no-error .
      318     delete object unitsObj no-error .
      319     delete object unitsStr no-error .
      320     delete object unitObj no-error .
      321     end . // end_of not_mode_select
      322   END.
      323   IF CURRENT-WINDOW:WINDOW-STATE = WINDOW-MINIMIZED
      324   THEN CURRENT-WINDOW:WINDOW-STATE = WINDOW-NORMAL.
      325   ON WINDOW-CLOSE OF FRAME d-units APPLY "END-ERROR":U TO SELF.
      326   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      327     run mainmenu_getcntxt in parparentproc
      328       (output v-cntxt-db-num
      329       ,output v-cntxt-userid
      330       ,output v-cntxt-level
      331       ,output v-cntxt-host-code-obj
      332       ,output v-cntxt-obj-type
      333       ,output v-cntxt-obj-code
      334       ,output v-cntxt-db-num-obj
      335       ,output v-cntxt-is-admin
      336       ) .
      337     unitsObj = new unitsubs () .
      338     unitsStr = new unitmercstr () .
      339     unitsObj = unitsStr:getunitmercs(p-gds-code) .
      340     do ii = 1 to unitsObj:GetItem(ii) :
      341       v-unit-name = unitsObj:UnitObjCurr:UnitName .
      342       if p-unit-list > "" then do :
      343         if not can-do (p-unit-list, v-unit-name) then next .
      344       end .
      345       create tt-units .
      346       tt-units.unit-name  = v-unit-name .
      347       tt-units.long-name  = unitsObj:UnitObjCurr:UnitFullName .
      348       tt-units.guid_      = unitsObj:UnitObjCurr:UnitGuid .
      349       tt-units.coeff      = unitsObj:UnitObjCurr:UnitCoef .
      350     end.
      351     if (p-mode = 'ВЫБОР':U) then do :
      352       assign
      353         p-unit-name = ""
      354         p-coeff     = 0.0
      355       .
      356       find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
      357       if available buf_goods then do :
      358         if not can-find (first tt-units where tt-units.unit-name = buf_goods.unit-base) then do :
      359           create tt-units .
      360           assign
      361             tt-units.unit-name  = buf_goods.unit-base
      362             tt-units.long-name  = " БАЗОВАЯ "
      363             tt-units.guid_      = ""
      364             tt-units.coeff      = 1
      365           .
      366         end .
      367       end .
      368     end .
      369     RUN enable_UI.
      370     if available tt-units then
      371         glog = br-units:select-focused-row( ).
      372   do  on endkey undo, leave  on error undo, leave:
      373     WAIT-FOR GO OF FRAME d-units.
      374   end.
      375   RUN disable_UI.
      376   PROCEDURE disable_UI :
      377     HIDE FRAME d-units.
      378   END PROCEDURE.
      379   PROCEDURE enable_UI :
      380   define variable v-is-editable as logical no-undo .
      381       v-is-editable = (ibs.th.gbl.gbl-var:g#db-num = 0) and
      382                       (p-mode <> 'ПРОСМОТР':U) and
      383                       (p-mode <> 'ВЫБОР':U) .
      384       b-select:visible   IN FRAME d-units = (p-mode = 'ВЫБОР':U) .
      385       ENABLE  br-units b-exit
      386                       b-select    WHEN b-select:visible
      387                       b-add-unit  when v-is-editable
      388                       b-change    when v-is-editable
      389                       b-del       when v-is-editable
      390           WITH FRAME d-units.
      391       OPEN QUERY br-units FOR EACH tt-units exclusive-LOCK  .
      392   END PROCEDURE.
