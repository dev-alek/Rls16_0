        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   define input parameter p-mode as character no-undo.
        3   define input-output parameter p-rid as recid init ? no-undo.
        4   define buffer b3-code for code .
        5   define input parameter p-parent as character no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision: $":U .
        7   define variable vss-author      as character no-undo init "$Author: $":U .
        8   define variable vss-date        as character no-undo init "$Date: $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: $":U .
       11   define variable vss-description as character no-undo init "Карточка Код ОКЕИ код ККТ".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   procedure sel-date :
      119     define input  parameter p-date-handle as handle    no-undo .
      120     define input  parameter p-description as character no-undo .
      121     do
      122     on error undo, return error return-value
      123     :
      124       if (can-query (p-date-handle, "sensitive")
      125         and
      126         p-date-handle :sensitive = true
      127         )
      128       or (can-query (p-date-handle, "read-only")
      129         and
      130         p-date-handle :read-only = false
      131         )
      132       then do:
      133         if p-date-handle :handle <> focus :handle
      134         then do:
      135           apply "entry":u to p-date-handle .
      136         end.
      137         define variable v-ok            as logical no-undo .
      138         define variable v-curr-sv-date as date no-undo .
      139         assign
      140           v-curr-sv-date = date(p-date-handle :screen-value) no-error
      141         .
      142         if v-curr-sv-date = ?
      143         then do:
      144           run gbl/getcurdt.p
      145             (output v-curr-sv-date
      146             ) .
      147         end.
      148         if v-curr-sv-date <> ?
      149         then do:
      150           run gbl/d-inpday.w
      151             (input ?
      152             ,input "Выбор даты"
      153             ,input p-description
      154             ,input ""
      155             ,input-output v-curr-sv-date
      156             ,output v-ok
      157             ).
      158           if v-ok = true
      159           then do:
      160             assign
      161               p-date-handle :screen-value = string(v-curr-sv-date) .
      162             .
      163           end.
      164         end.
      165       end.
      166     end.
      167   end procedure.
      168   define variable v-db-num like ub.db.db-num no-undo .
      169   define variable v-name   as character no-undo .
      170   define variable vDateIsoOld as character no-undo.
      171   DEFINE BUTTON B-Help
      172      LABEL "Помо&щь"
      173      SIZE 10 BY 1
      174      BGCOLOR 8 .
      175   DEFINE BUTTON b-quit AUTO-END-KEY
      176      LABEL "&Отмена"
      177      SIZE 10 BY 1
      178      BGCOLOR 8 .
      179   DEFINE BUTTON B-save AUTO-GO
      180      LABEL "&Ввод"
      181      SIZE 10 BY 1
      182      BGCOLOR 8 .
      183   DEFINE VARIABLE mDATA   AS DATE      FORMAT "99/99/9999":U INITIAL ?
      184      LABEL "Дата н.а."
      185      VIEW-AS FILL-IN
      186      SIZE 11 BY 1 NO-UNDO.
      187   DEFINE VARIABLE mZNACH  AS decimal   FORMAT ">>>>>>>9.99":U INITIAL 0
      188      LABEL "Значение"
      189      VIEW-AS FILL-IN
      190      SIZE 20 BY 1 NO-UNDO.
      191   DEFINE VARIABLE mDoc    AS CHARACTER FORMAT "X(256)":U
      192      LABEL "Номер документа"
      193      VIEW-AS FILL-IN
      194      SIZE 40 BY 1 NO-UNDO.
      195   DEFINE VARIABLE fStatus AS integer   init '0':U
      196      LABEL "Статус"
      197      VIEW-AS COMBO-BOX INNER-LINES 2
      198      LIST-ITEM-PAIRS "Активный",'0':U,
      199      "Деактивирован",'1':U
      200      DROP-DOWN-LIST
      201      SIZE 20 BY 1 NO-UNDO.
      202   DEFINE FRAME Dialog-Frame
      203      B-save AT ROW 1 COL 1
      204      b-quit AT ROW 1 COL 11
      205      B-Help AT ROW 1 COL 36
      206      mDATA AT ROW 2.5 COL 18 COLON-ALIGNED WIDGET-ID 8
      207      mZNACH AT ROW 4 COL 18 COLON-ALIGNED WIDGET-ID 12
      208      fStatus AT ROW 5.5 COL 18 COLON-ALIGNED WIDGET-ID 14
      209      WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      210      SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      211      TITLE "Редактирование ЕМЦ"
      212      DEFAULT-BUTTON B-save CANCEL-BUTTON b-quit.
      213   ASSIGN
      214      FRAME Dialog-Frame:SCROLLABLE = FALSE
      215      FRAME Dialog-Frame:HIDDEN     = TRUE.
      216   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      217      DO:
      218         APPLY "END-ERROR":U TO SELF.
      219      END.
      220   ON CHOOSE OF B-save IN FRAME Dialog-Frame
      221      DO:
      222         run proc-save in this-procedure no-error.
      223         if error-status:error then return no-apply.
      224      END.
      225   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      226      THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      227   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      228   on help of frame Dialog-Frame
      229   do:
      230     run gbl/app_help.p
      231       (input this-procedure :file-name
      232       ,input ''
      233       ,input ?
      234       ) no-error.
      235     if error-status :error then do:
      236       message
      237         "Ошибка при вызове помощи"
      238         error-status :get-message(1)
      239         view-as alert-box .
      240     end.
      241   end.
      242   run minbtn-set in this-procedure .
      243   on choose of b-help in frame Dialog-Frame
      244   do:
      245     apply "help":u to frame Dialog-Frame .
      246   end.
      247   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      248   procedure minbtn-set :
      249       do
      250           on error undo, return error return-value
      251           :
      252           define variable ii              as integer       no-undo .
      253           define variable fh              as widget-handle no-undo .
      254           define variable hh              as widget-handle no-undo .
      255           define variable v-h             as handle        extent 4 no-undo .
      256           define variable v-name-button   as character     no-undo .
      257           define variable v-help-old-x    as decimal       no-undo .
      258           define variable v-help-old-y    as decimal       no-undo .
      259           define variable v-help-old-size as decimal       no-undo .
      260           define variable v-frame-width   as decimal       no-undo .
      261           define variable jj              as integer       no-undo .
      262           do
      263               on error undo, return error
      264               :
      265               assign
      266                   v-frame-width = frame Dialog-Frame:width - 0.3
      267                   fh            = frame Dialog-Frame:first-child
      268                   hh            = fh:first-child
      269                   ii            = 1
      270                   .
      271               do while valid-handle(hh):
      272                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      273                   do:
      274                       case lc(hh:name) :
      275                           when "b-help" then
      276                               do:
      277                                   hh:load-image-up("cmp/b-help.bmp":u) .
      278                                   hh:load-image-down("cmp/b-help.bmp":u) .
      279                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      280                                   hh:TOOLTIP = "Помощь" .
      281                                   v-help-old-x = hh:column .
      282                                   v-help-old-y = hh:row    .
      283                                   v-help-old-size = hh:width .
      284                                   hh:width-chars = 2.5 .
      285                               end.
      286                           when "b-print" then
      287                               do:
      288                                   hh:load-image("cmp/b-print.bmp":u) .
      289                                   hh:TOOLTIP = "Печать" .
      290                                   v-h[ii] = hh:handle .
      291                                   ii = ii + 1 .
      292                                   hh:width-chars = 3 .
      293                               end.
      294                           when "b-history" or
      295                           when "b-hist" then
      296                               do:
      297                                   hh:load-image("cmp/b-hist.bmp":u) .
      298                                   hh:TOOLTIP = "История" .
      299                                   v-h[ii] = hh:handle .
      300                                   ii = ii + 1 .
      301                                   hh:width-chars = 3 .
      302                               end.
      303                           when "b-sch" then
      304                               do:
      305                                   hh:load-image("cmp/b-sch.bmp":u) .
      306                                   hh:TOOLTIP = "Установка Фильтра" .
      307                                   v-h[ii] = hh:handle .
      308                                   ii = ii + 1 .
      309                                   hh:width-chars = 3 .
      310                               end.
      311                           when "b-hist-user" then
      312                               do:
      313                                   hh:load-image("cmp/b-hist.bmp":u) .
      314                                   hh:TOOLTIP = "История пользователя" .
      315                                   ii = ii + 1 .
      316                               end.
      317                       end case.
      318                   end.
      319                   hh = hh:next-sibling.
      320               end.
      321               b-help:column = v-frame-width - b-help:width-chars.
      322               jj = 0.
      323               repeat ii = 4 to 1 by -1 :
      324                   if valid-handle (v-h[ii] ) then
      325                   do:
      326                       jj  = jj + 1 .
      327                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      328                       v-h[ii]:row    = v-help-old-y .
      329                   end.
      330               end.
      331           end.
      332       end.
      333   end procedure.
      334   MAIN-BLOCK:
      335   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      336      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      337      if p-mode <> 'ДОБАВЛЕНИЕ':U and
      338         p-mode <> 'ИЗМЕНЕНИЕ':U
