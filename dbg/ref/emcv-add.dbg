      581      end.
      582      find first b3-code where
      583         b3-code.parent  = entry(1,p-parent,chr(4))
      584         and b3-code.code    = entry(2,p-parent,chr(4)) no-lock no-error.
      585      if available b3-code
      586         then
      587      do:
      588         FRAME Dialog-Frame:TITLE = "Редактирование ЕМЦ " + b3-code.codename.
      589         v-name = b3-code.CodeName .
      590      end.
      591      if p-mode = 'ИЗМЕНЕНИЕ':U then
      592      do:
      593         find first b3-code where
      594            recid(b3-code) = p-rid exclusive-lock no-wait no-error.
      595         if not available b3-code then
      596         do:
      597            message
      598               vss-workfile vss-revision vss-description skip
      599               "Не найдена запись <Тип ЕМЦ - Код>"
      600               view-as alert-box error .
      601            undo, return error.
      602         end.
      603         assign
      604            mDATA   = date(b3-code.misc1)
      605            mZNACH  = dec(b3-code.CodeValue)
      606            mDoc    = b3-code.misc2
      607            Fstatus = b3-code.status_
      608            .
      609         vDateIsoOld = iso-date(mDATA).
      610      end.
      611      run enable_UI in this-procedure .
      612      if p-mode = 'ДОБАВЛЕНИЕ':U then
      613      do:
      614         ENABLE mDATA WITH FRAME Dialog-Frame.
      615         apply "entry" to mDATA in FRAME Dialog-Frame.
      616      end.
      617      WAIT-FOR GO OF FRAME Dialog-Frame.
      618   END.
      619   session:data-entry-return = no .
      620   RUN disable_UI.
      621   PROCEDURE disable_UI :
      622      HIDE FRAME Dialog-Frame.
      623   END PROCEDURE.
      624   PROCEDURE enable_UI :
      625      DISPLAY mDATA mZNACH fStatus
      626         WITH FRAME Dialog-Frame.
      627      ENABLE B-save b-quit B-Help mDATA mZNACH fStatus
      628         WITH FRAME Dialog-Frame.
      629      VIEW FRAME Dialog-Frame.
      630   END PROCEDURE.
      631   PROCEDURE proc-save :
      632      define buffer b3-code for code.
      633      define buffer b2-code for code.
      634      assign frame Dialog-Frame
      635         mDATA
      636         mZNACH
      637         fStatus
      638         .
      639      define variable vDateIsoNew   as character no-undo.
      640      define variable vDateIsoToday as character no-undo.
      641      vDateIsoNew = iso-date(mDATA).
      642      do on error undo, return error
      643         on stop undo, return error:
      644         if mdata eq ?
      645         then do:
      646            message "Дата не сожет быть пустой"
      647            view-as alert-box.
      648            return error.
      649         end.
      650         find first b3-code where
      651            b3-code.parent = p-parent
      652            and b3-code.code   = vDateIsoNew
      653            and if p-rid eq ? then yes else recid(b3-code) ne p-rid
      654            no-lock no-error.
      655         if avail b3-code then
      656         do:
      657            message
      658               "Уже есть такая запись Тип ЕМЦ Дата :" string(mDATA,"99/99/9999")
      659               view-as alert-box error .
      660            return error.
      661         end.
      662         if fStatus <> 0 then
      663         do:
      664            find first b2-code where b2-code.parent = p-parent and
      665               b2-code.status_ = 0 and recid(b2-code) <> p-rid and b2-code.codevalue <> "0" no-error .
      666            if not available (b2-code) then
      667            do:
      668               message "Для типа ЕМЦ - " + string(v-name) + " отсутствуют другие значения." skip
      669                  "При деактивации значения прослеживаемость данного типа ЕМЦ для всех товаров будет отключена"
      670                  view-as alert-box question buttons yes-no update choice as logical .
      671               case choice:
      672                  when yes then
      673                     do:
      674                        for each ub.gds-grp-obj-attr exclusive-lock where ub.gds-grp-obj-attr.attr-code = 'emrc-type':U
      675                           and ub.gds-grp-obj-attr.attr-value = string(entry(2,p-parent,chr(4))):
      676                           delete ub.gds-grp-obj-attr .
      677                        end.
      678                        for each ub.goods-attr exclusive-lock where ub.goods-attr.attr-code = 'emrc-type':U and
      679                        ub.goods-attr.attr-value = string(entry(2,p-parent,chr(4))):
      680                           delete ub.goods-attr .
      681                        end.
      682                        fStatus = 1 .
      683                     end.
      684                     otherwise do:
      685                        fStatus = 0 .
      686                     end.
      687               end case.
      688            end.
      689         end.
      690         find first b3-code where
      691            b3-code.parent = p-parent
      692            and b3-code.code   = vDateIsoOld
      693            exclusive-lock no-error.
      694         if not avail b3-code then
      695         do:
      696            create b3-code.
      697         end.
      698         assign
      699            b3-code.parent    = p-parent
      700            b3-code.code      = vDateIsoNew
      701            b3-code.misc1     = string(mDATA,"99/99/9999")
      702            b3-code.codevalue = string(mZNACH)
      703            b3-code.misc2     = mDoc
      704            b3-code.status_   = fStatus
      705            b3-code.nwsgbd    = yes
      706            .
      707         p-rid = recid(b3-code).
      708         if mDATA > today
      709            then
      710         do:
      711            find b3-code where
      712               b3-code.parent = p-parent
      713               and b3-code.code   < vDateIsoNew
      714               and b3-code.status_  = 0
      715               no-lock no-error.
      716            if not avail b3-code
      717               then
      718            do:
      719               if not AMBIGUOUS b3-code
      720               then do:
      721                  vDateIsoToday = iso-date(today).
      722                  find first b3-code where
      723                     b3-code.parent = p-parent
      724                     and b3-code.code   = vDateIsotoday
      725                     exclusive-lock no-error.
      726                  if not avail b3-code
      727                     then
      728                  do:
      729                     create b3-code.
      730                     assign
      731                        b3-code.parent    = p-parent
      732                        b3-code.code      = vDateIsoToday
      733                        b3-code.misc1     = string(today,"99/99/9999")
      734                        b3-code.codevalue = "0"
      735                        b3-code.status_   = fStatus
      736                        b3-code.nwsgbd    = yes
      737                     .
      738                  end.
      739                  b3-code.status_   = fStatus.
      740               end.
      741            end.
      742            else do:
      743               if b3-code.codevalue = "0"
      744               then do:
      745                  find current b3-code exclusive-lock.
      746                  b3-code.status_   = fStatus.
      747               end.
      748            end.
      749         end.
      750      end.
      751   END PROCEDURE.
