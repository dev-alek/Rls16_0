     1190   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1191   procedure factord :
     1192     define input  parameter p-fact-date            as date    no-undo .
     1193     define input  parameter p-fact-time            as integer no-undo .
     1194     define input  parameter p-fact-num             as integer no-undo .
     1195     define input  parameter p-shift-date           as date    no-undo .
     1196     define input  parameter p-shift-num            as integer no-undo .
     1197     define input  parameter p-shift-on             as logical no-undo .
     1198     define output parameter p-fact-order           as decimal no-undo .
     1199     define output parameter p-shift-end-fact-order as decimal no-undo .
     1200     define output parameter p-day-end-fact-order   as decimal no-undo .
     1201     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1202     if p-fact-date = ?
     1203     then do:
     1204       return error "Не указана фактическая дата" .
     1205     end.
     1206     define variable v-fact-date-num as integer no-undo .
     1207     assign
     1208       v-fact-date-num = integer(p-fact-date)
     1209     .
     1210     if p-fact-num = ?
     1211     or p-fact-num = 0
     1212     then do:
     1213       return error "Не задан p-fact-num " + string(p-fact-num) .
     1214     end.
     1215     if p-fact-num < 0
     1216     then do:
     1217       return error "Отрицательный fact-num " + string(p-fact-num) .
     1218     end.
     1219     if p-fact-num >= 100000000
     1220     then do:
     1221       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1222     end.
     1223     if p-shift-on = true
     1224     then do:
     1225       if p-shift-date = ?
     1226       then do:
     1227         return error "Не задана дата смены" .
     1228       end.
     1229       if p-shift-num = ?
     1230       or p-shift-num = 0
     1231       then do:
     1232         return error "Не задан номер смены" .
     1233       end.
     1234     end.
     1235     else do:
     1236       assign
     1237         p-shift-date = p-fact-date
     1238         p-shift-num  = 24
     1239       .
     1240     end.
     1241     define variable v-shift-offset as integer no-undo .
     1242     if p-shift-date = p-fact-date
     1243     then do:
     1244       assign
     1245         v-shift-offset = 1
     1246       .
     1247     end.
     1248     if p-shift-date < p-fact-date
     1249     then do:
     1250       assign
     1251         v-shift-offset = 0
     1252       .
     1253     end.
     1254     if p-shift-date > p-fact-date
     1255     then do:
     1256       message
     1257         vss-workfile vss-revision vss-description skip
     1258         "Неправильная дата закрытия смены" skip
     1259         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1260         view-as alert-box error .
     1261       undo, return error
     1262         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1263           ,string(p-fact-date, '99/99/9999':U)
     1264           ,string(p-shift-date, '99/99/9999':U)
     1265           )
     1266       .
     1267     end.
     1268     if p-shift-num < 1
     1269     or p-shift-num > 24
     1270     then do:
     1271       message
     1272         vss-workfile vss-revision vss-description skip
     1273         "Неправильный номер смены" skip
     1274         "p-shift-num" p-shift-num skip
     1275         view-as alert-box error .
     1276       undo, return error return-value .
     1277     end.
     1278     assign
     1279       p-fact-order           = v-fact-date-num
     1280                              + v-shift-offset * 0.5
     1281                              + p-shift-num    * 0.02 - 0.01
     1282                              + p-fact-num     * 0.0000000001
     1283       p-shift-end-fact-order = v-fact-date-num
     1284                              + v-shift-offset * 0.5
     1285                              + p-shift-num    * 0.02
     1286       p-day-end-fact-order   = v-fact-date-num
     1287                              + 0.99
     1288     .
     1289     if p-fact-order           <= v-fact-date-num
     1290     or p-shift-end-fact-order <= v-fact-date-num
     1291     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1292     or p-shift-end-fact-order >= p-day-end-fact-order
     1293     then do:
     1294       message
     1295         vss-workfile vss-revision vss-description skip
     1296         "Внутренняя ошибка при генерации фактического номера" skip
     1297         "p-fact-date"            p-fact-date            skip
     1298         "p-fact-time"            p-fact-time            skip
     1299         "p-fact-num"             p-fact-num             skip
     1300         "p-shift-date"           p-shift-date           skip
     1301         "p-shift-num"            p-shift-num            skip
     1302         "p-shift-on"             p-shift-on             skip
     1303         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1304         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1305         "v-fact-date-num"        v-fact-date-num        skip
     1306         view-as alert-box error .
     1307       undo, return error return-value .
     1308     end.
     1309   end procedure.
     1310   procedure day-begin-fact-order :
     1311     define input  parameter p-fact-date            as date    no-undo .
     1312     define output parameter p-day-begin-fact-order as decimal no-undo .
     1313     do
     1314     on error undo, return error return-value
     1315     :
     1316       if p-fact-date = ?
     1317       then do:
     1318         assign
     1319           p-day-begin-fact-order = 0
     1320         .
     1321       end.
     1322       else do:
     1323         assign
     1324           p-day-begin-fact-order = integer(p-fact-date)
     1325         .
     1326       end.
     1327     end.
     1328   end procedure.
     1329   procedure factord-max-fact-order :
     1330     define output parameter p-max-fact-order as decimal   no-undo .
     1331     do
     1332     on error undo, return error return-value
     1333     :
     1334       run day-begin-fact-order in this-procedure
     1335         (input  date(1, 1, 5000)
     1336         ,output p-max-fact-order
     1337         ) .
     1338     end.
     1339   end procedure.
     1340   procedure factord-cut-archive :
     1341     define input  parameter p-obj-type             as character no-undo .
     1342     define input  parameter p-obj-code             as integer   no-undo .
     1343     define input  parameter p-fact-date            as date      no-undo .
     1344     define output parameter p-shift-on             as logical   no-undo .
     1345     define output parameter p-shift-date           as date      no-undo .
     1346     define output parameter p-shift-num            as integer   no-undo .
     1347     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1348     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1349     define variable v-fact-order as decimal   no-undo .
     1350     define buffer buf_shift-obj for ub.shift-obj .
     1351     do
     1352     on error undo, return error return-value
     1353     :
     1354   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1355   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1356     (input  p-obj-type
     1357     ,input  p-obj-code
     1358     ,input  'shift-on=request'
     1359     ,output p-shift-on
     1360     ) no-error .
     1361       if error-status :error
     1362       then do:
     1363         message
     1364           vss-workfile vss-revision vss-description skip
     1365           "Ошибка при определении атрибута объекта" skip
     1366           "Объект" p-obj-type p-obj-code skip
     1367           error-status :get-message(1) skip
     1368           return-value skip
     1369           view-as alert-box error .
     1370         undo, return error return-value .
     1371       end.
     1372       if p-shift-on = false
     1373       then do:
     1374         assign
     1375           p-shift-date               = ?
     1376           p-shift-num                = 0
     1377         .
     1378       end.
     1379       else do:
     1380         find first buf_shift-obj share-lock
     1381           where buf_shift-obj.obj-type   = p-obj-type
     1382             and buf_shift-obj.obj-code   = p-obj-code
     1383             and buf_shift-obj.shift-date > p-fact-date
     1384           use-index pi
     1385           no-error .
     1386         if not available buf_shift-obj
     1387         or buf_shift-obj.status_ <> 'зкр':U
     1388         then do:
     1389           message
     1390             vss-workfile vss-revision vss-description skip
     1391             "Невозможно вычислить последнюю смену" skip
     1392             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1393             "Объект" p-obj-type p-obj-code skip
     1394             "Дата" p-fact-date skip
     1395             view-as alert-box error .
     1396           undo, return error return-value .
     1397         end.
     1398         find last buf_shift-obj share-lock
     1399           where buf_shift-obj.obj-type = p-obj-type
     1400             and buf_shift-obj.obj-code = p-obj-code
     1401             and buf_shift-obj.shift-date <= p-fact-date
     1402           use-index pi
     1403           no-error .
     1404         if available buf_shift-obj
     1405         then do:
     1406           if  buf_shift-obj.status_ = 'зкр':U
     1407           then do:
     1408             assign
     1409               p-shift-date = buf_shift-obj.shift-date
     1410               p-shift-num  = buf_shift-obj.shift-num
     1411             .
     1412           end.
     1413           else do:
     1414             message
     1415               vss-workfile vss-revision vss-description skip
     1416               "Невозможно вычислить последнюю смену" skip
     1417               "Статус смены отличен от статуса" 'зкр':U skip
     1418               "Объект" p-obj-type p-obj-code skip
     1419               "Дата" p-fact-date skip
     1420               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1421               view-as alert-box error .
     1422             undo, return error return-value .
     1423           end.
     1424         end.
     1425         else do:
     1426           assign
     1427             p-shift-date = p-fact-date - 1
     1428             p-shift-num  = 1
     1429           .
     1430         end.
     1431       end.
     1432       run factord in this-procedure
     1433         (input  p-fact-date
     1434         ,input  1
     1435         ,input  1
     1436         ,input  p-shift-date
     1437         ,input  p-shift-num
     1438         ,input  p-shift-on
     1439         ,output v-fact-order
     1440         ,output p-shift-end-fact-order
     1441         ,output p-day-end-fact-order
     1442         ) no-error .
     1443       if error-status :error
     1444       then do:
     1445         message
     1446           vss-workfile vss-revision vss-description skip
     1447           "Ошибка при вызове процедуры factord"
     1448           error-status :get-message(1) skip
     1449           return-value skip
     1450           view-as alert-box error .
     1451         undo, return error return-value .
     1452       end.
     1453     end.
     1454   end procedure.
     1455   procedure factord-lock-shift :
     1456     define input  parameter p-obj-type  as character no-undo .
     1457     define input  parameter p-obj-code  as integer   no-undo .
     1458     define input  parameter p-fact-date as date      no-undo .
     1459     define parameter buffer buf_shift-obj for ub.shift-obj .
     1460     define variable v-shift-on      as logical   no-undo .
     1461     define variable v-extra-message as character no-undo .
     1462     define variable v-error as character no-undo .
     1463     do
     1464     on error undo, return error return-value
     1465     :
     1466   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1467   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1468     (input  p-obj-type
     1469     ,input  p-obj-code
     1470     ,input  'shift-on=request'
     1471     ,output v-shift-on
     1472     ) no-error .
     1473       if error-status :error
     1474       then do:
     1475         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1476         undo, return error v-error .
     1477       end.
     1478       if v-shift-on = true
     1479       then do:
     1480         find first buf_shift-obj share-lock
     1481           where buf_shift-obj.obj-type   = p-obj-type
     1482             and buf_shift-obj.obj-code   = p-obj-code
     1483             and buf_shift-obj.shift-date > p-fact-date
     1484           use-index pi
     1485           no-error .
     1486         if not available buf_shift-obj
     1487         or buf_shift-obj.status_ <> 'зкр':U
     1488         then do:
     1489           find last buf_shift-obj
     1490             where buf_shift-obj.obj-type = p-obj-type
     1491               and buf_shift-obj.obj-code = p-obj-code
     1492               and buf_shift-obj.status_  = 'зкр':U
     1493             use-index stts
     1494             no-error .
     1495           if available buf_shift-obj
     1496           then do:
     1497             assign
     1498               v-extra-message =
     1499                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1500                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1501                               )
     1502             .
     1503           end.
     1504           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1505           undo, return error v-error .
     1506         end.
     1507       end.
     1508     end.
     1509   end procedure.
     1510   procedure factord-end-day :
     1511     define input  parameter p-fact-date            as date    no-undo .
     1512     define output parameter p-day-end-fact-order   as decimal no-undo .
     1513     do
     1514     on error undo, return error return-value
     1515     :
     1516       if p-fact-date = ?
     1517       then do:
     1518         return error "Не указана фактическая дата" .
     1519       end.
     1520       assign
     1521         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1522       .
     1523     end.
     1524   end procedure.
     1525   procedure factord-to-date :
     1526     define input  parameter p-fact-order as decimal no-undo .
     1527     define output parameter p-fact-date  as date    no-undo .
     1528     define variable v-ref-date  as date      no-undo .
     1529     define variable v-ref-delta as integer   no-undo .
     1530     do
     1531     on error undo, return error return-value
     1532     :
     1533       if p-fact-order = ?
     1534       or p-fact-order = 0
     1535       then do:
     1536         return error "Не указан fact-order" .
     1537       end.
     1538       assign
     1539         v-ref-date  = date(1, 1, 2000)
     1540       .
     1541       assign
     1542         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1543       .
     1544       assign
     1545         p-fact-date = v-ref-date + v-ref-delta
     1546       .
     1547     end.
     1548   end procedure.
     1549   procedure factord-to-fact-num :
     1550     define input  parameter p-fact-order as decimal no-undo .
     1551     define output parameter p-fact-num   as integer no-undo .
     1552     define variable v-fact-order-trunc as decimal no-undo .
     1553     do
     1554     on error undo, return error return-value
     1555     :
     1556       if p-fact-order = ?
     1557       or p-fact-order = 0
     1558       then do:
     1559         return error "Не указан fact-order" .
     1560       end.
     1561       assign
     1562        v-fact-order-trunc = truncate(p-fact-order, 2)
     1563       .
     1564       assign
     1565         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1566       .
     1567     end.
     1568   end procedure.
     1569   procedure factord-to-shift-num :
     1570     define input  parameter p-fact-order as decimal no-undo .
     1571     define output parameter p-shift-num   as integer no-undo .
     1572     define variable  p-shift-numd  as decimal   no-undo .
     1573     define variable v-fact-order-trunc as decimal no-undo .
     1574     do
     1575     on error undo, return error return-value
     1576     :
     1577       if p-fact-order = ?
     1578       or p-fact-order = 0
     1579       then do:
     1580         return error "Не указан fact-order" .
     1581       end.
     1582       assign
     1583        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1584       .
     1585       if v-fact-order-trunc < 0.5 then do:
     1586         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1587       end.
     1588       assign
     1589         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1590         .
     1591        assign
     1592         p-shift-num = truncate (p-shift-numd , 0)
     1593       .
     1594     end.
     1595   end procedure.
     1596   define variable v-chg-fields as character no-undo.
     1597   define variable v-old-fields as character no-undo.
     1598   define variable v-new-fields as character no-undo.
     1599   define variable ii as integer no-undo.
     1600   define variable v-mess as character no-undo .
     1601   define buffer buf_c-wth-hist for ub.c-wth-hist.
     1602   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1603   define SHARED temp-table temp-changes no-undo
     1604   field f_name as character
     1605   field l_name as character
     1606   field v_old as character
     1607   field v_new as character
     1608   field t_name as character
     1609   field num_ as integer
     1610   field uniq-key-rec as character
     1611   field action as integer
     1612   field fNotChange as logical
     1613   index pi is unique primary
     1614   num_
     1615   t_name
     1616   f_name
     1617   index
     1618   Chan
     1619   fnotChange
     1620   t_name
     1621   f_name
     1622   index imain uniq-key-rec
     1623   .
     1624   FUNCTION get-all-fields returns character (p-file-name as character ):
     1625   define variable v-dop as character no-undo .
     1626     find first _file no-lock where _file._file-name = p-file-name no-error .
     1627     if not available _file then return "":U.
     1628     for each _field no-lock where
     1629              _field._file-recid = recid(_file) :
     1630       assign
     1631       v-dop = v-dop + _field._field-name + chr(44)
     1632       .
     1633     end.
     1634     return trim(v-dop).
     1635   END FUNCTION.
     1636   PROCEDURE proc-full-temp-changes :
     1637     define input  parameter p-act-create as logical   no-undo .
     1638     define input  parameter p-act-delete as logical   no-undo .
     1639     define input  parameter p-hst-handle as handle    no-undo .
     1640     define input  parameter p-main-table as character no-undo .
     1641     define input  parameter p-field-list as character no-undo .
     1642     define input  parameter p-label-form as character no-undo .
     1643     define variable h-new-buf         as handle    no-undo .
     1644     define variable h-main-buf        as handle    no-undo .
     1645     define variable h-for-comp        as handle    no-undo .
     1646     define variable v-inform          as character no-undo .
     1647     define variable v-ind             as integer   no-undo .
     1648     define variable v-idx-field-qnty  as integer   no-undo .
     1649     define variable v-num-entries     as integer   no-undo .
     1650     define variable fh                as handle    no-undo .
     1651     define variable fh-main           as handle    no-undo .
     1652     define variable fh-old            as handle    no-undo .
     1653     define variable fh-new            as handle    no-undo .
     1654     define variable v-field-name      as character no-undo .
     1655     define variable v-field-lvl       as character no-undo .
     1656     define variable v-field-form      as character no-undo .
     1657     define variable v-search-exp      as character no-undo .
     1658     define variable v-srch-main       as character no-undo .
     1659     define variable v-word-link       as character no-undo .
     1660     define variable v-av-chip-num     as logical   no-undo .
     1661     define variable v-main-pi-fld-lst as character no-undo .
     1662     define variable v-main-fld-lst    as character no-undo .
     1663     define variable v-delim-list      as character no-undo .
     1664     define variable v-label           as character no-undo .
     1665     define variable v-old-value       as character no-undo case-sensitive.
     1666     define variable v-new-value       as character no-undo case-sensitive.
     1667     define variable v-chg-fields as character no-undo.
     1668     for each temp-changes:
     1669       delete temp-changes.
     1670     end.
     1671     if not p-hst-handle:available then do:
     1672       return .
     1673     end.
     1674     create buffer h-new-buf  for table p-hst-handle .
     1675     create buffer h-main-buf for table p-main-table .
     1676     assign
     1677       v-inform = h-main-buf:index-information(1)
     1678       v-ind    = 2
     1679     .
     1680     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1681     on error undo, return error
     1682     :
     1683       assign
     1684         v-inform = h-main-buf:index-information( v-ind )
     1685         v-ind    = v-ind + 1
     1686       .
     1687     end.
     1688     if v-inform = ?
     1689       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1690       or entry( 3, v-inform, ",":U ) <> "1":U
     1691     then do:
     1692       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1693     end.
     1694     assign
     1695       v-idx-field-qnty = num-entries( v-inform ) - 4
     1696     .
     1697     if v-idx-field-qnty < 2 then do:
     1698       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1699     end.
     1700     assign
     1701       v-srch-main   = "where":U
     1702       v-word-link   = "":U
     1703       v-av-chip-num = false
     1704       v-delim-list  = "":U
     1705     .
     1706     do v-ind = 1 to v-idx-field-qnty by 2
     1707     on error undo, return error
     1708     :
     1709       assign
     1710         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1711         fh                = p-hst-handle:buffer-field( v-field-name )
     1712         fh-main           = h-main-buf:buffer-field( v-field-name )
     1713         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1714         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1715       .
     1716       if fh:data-type ="character":U then do:
     1717         assign
     1718           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1719         .
     1720       end.
     1721       else do:
     1722         assign
     1723           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1724         .
     1725       end.
     1726       if v-delim-list = "":U then do:
     1727         assign
     1728           v-delim-list = ",":U
     1729         .
     1730       end.
     1731       if v-word-link = "":U then do:
     1732         assign
     1733           v-word-link = "and":U
     1734         .
     1735       end.
     1736     end.
     1737     assign
     1738       v-delim-list  = "":U
     1739     .
     1740     do v-ind = 1 to h-main-buf:num-fields
     1741     on error undo, return error
     1742     :
     1743       assign
     1744         fh-main      = h-main-buf:buffer-field( v-ind )
     1745         v-field-name = fh-main:name
     1746       .
     1747         assign
     1748           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1749         .
     1750         if v-delim-list = "":U then do:
     1751           assign
     1752             v-delim-list = ",":U
     1753           .
     1754         end.
     1755     end.
     1756     assign
     1757       v-inform = p-hst-handle:index-information(1)
     1758       v-ind    = 2
     1759     .
     1760     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1761     on error undo, return error
     1762     :
     1763       assign
     1764         v-inform = p-hst-handle:index-information( v-ind )
     1765         v-ind    = v-ind + 1
     1766       .
     1767     end.
     1768     if v-inform = ?
     1769       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1770       or entry( 3, v-inform, ",":U ) <> "1":U
     1771     then do:
     1772       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1773     end.
     1774     assign
     1775       v-idx-field-qnty = num-entries( v-inform ) - 4
     1776     .
     1777     if v-idx-field-qnty < 2 then do:
     1778       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1779     end.
     1780     assign
     1781       v-search-exp  = "where":U
     1782       v-word-link   = "":U
     1783       v-av-chip-num = false
     1784     .
     1785     do v-ind = 1 to v-idx-field-qnty by 2
     1786     on error undo, return error
     1787     :
     1788       assign
     1789         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1790         fh           = p-hst-handle:buffer-field( v-field-name )
     1791         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1792       .
     1793       if v-field-name = "chip-num":U then do:
     1794         assign
     1795           v-search-exp  = substitute( "&1 >", v-search-exp )
     1796           v-av-chip-num = true
     1797         .
     1798       end.
     1799       else do:
     1800         assign
     1801           v-search-exp = substitute( "&1 =", v-search-exp )
     1802         .
     1803       end.
     1804       if fh:data-type ="character":U then do:
     1805         assign
     1806           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1807         .
     1808       end.
     1809       else do:
     1810         assign
     1811           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1812         .
     1813       end.
     1814       if v-word-link = "":U then do:
     1815         assign
     1816           v-word-link = "and":U
     1817         .
     1818       end.
     1819     end.
     1820     if v-av-chip-num = false then do:
     1821       message
     1822         vss-workfile vss-revision vss-description skip
     1823         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1824         "Использование данной процедуры невозможно!" skip
     1825         view-as alert-box error .
     1826       return error .
     1827     end.
     1828     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1829     if not h-new-buf:available then do:
     1830       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1831       if not h-main-buf:available then do:
     1832         assign
     1833           h-for-comp = ?
     1834         .
     1835       end.
     1836       else do:
     1837         assign
     1838           h-for-comp = h-main-buf
     1839         .
     1840       end.
     1841     end.
     1842     else do:
     1843       assign
     1844         h-for-comp = h-new-buf
     1845       .
     1846     end.
     1847     assign
     1848       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1849     .
     1850     do v-ind = 1 to v-num-entries
     1851     on error undo, return error return-value
     1852     :
     1853       assign
     1854         v-field-name = entry( v-ind, v-main-fld-lst )
     1855         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1856         v-old-value  = fh-old:buffer-value()
     1857         v-label      = trim( fh-old:label )
     1858       .
     1859       if ( trim( p-field-list ) <> "":U
     1860            and lookup( v-field-name, p-field-list ) > 0
     1861          )
     1862          or trim( p-field-list ) = "":U
     1863       then do:
     1864         if h-for-comp <> ? then do:
     1865           assign
     1866             fh-new      = h-for-comp:buffer-field( v-field-name )
     1867             v-new-value = fh-new:buffer-value()
     1868           .
     1869         end.
     1870         else do:
     1871           assign
     1872             v-new-value = "":U
     1873           .
     1874         end.
     1875           if p-act-create = true then do:
     1876             assign
     1877               v-old-value = "":U
     1878             .
     1879           end.
     1880           if p-act-delete = true then do:
     1881             assign
     1882               v-new-value = "":U
     1883             .
     1884           end.
     1885         if v-old-value <> v-new-value
     1886         then do:
     1887           create temp-changes.
     1888           assign
     1889             temp-changes.t_name = p-main-table
     1890             temp-changes.f_name = v-field-name
     1891             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1892             temp-changes.v_old  = trim( v-old-value )
     1893             temp-changes.v_new  = trim( v-new-value )
     1894             temp-changes.num_   = 0
     1895             temp-changes.fNotChange = v-old-value eq v-new-value
     1896           .
     1897         end.
     1898       end.
     1899     end.
     1900     assign
     1901       v-num-entries = num-entries( p-label-form, chr(8) )
     1902     .
     1903     do v-ind = 1 to v-num-entries
     1904     on error undo, return error return-value
     1905     :
     1906       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1907         assign
     1908           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1909           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1910           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1911         .
     1912         find first temp-changes
     1913           where temp-changes.f_name = v-field-name
     1914           no-error .
     1915         if available temp-changes then do:
     1916           if trim( v-field-lvl ) <> "":U then do:
     1917             assign
     1918               temp-changes.l_name = v-field-lvl
     1919             .
     1920           end.
     1921           if trim( v-field-form ) <> "":U then do:
     1922             assign
     1923               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1924             .
     1925             if h-for-comp <> ? then do:
     1926               assign
     1927                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1928               .
     1929             end.
     1930           end.
     1931         end.
     1932       end.
     1933       else do:
     1934         message
     1935           vss-workfile vss-revision vss-description skip
     1936           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1937           substitute( "список для поля '&1': '&2'"
     1938                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1939                       ,entry( v-ind, p-label-form, chr(8) )
     1940                     ) skip
     1941           substitute( "полный список: &2", p-label-form ) skip
     1942           view-as alert-box error .
     1943       end.
     1944     end.
     1945     delete object h-new-buf .
     1946     delete object h-main-buf .
     1947   END PROCEDURE.
     1948   find first buf_c-wth-hist no-lock where
     1949             buf_c-wth-hist.wth-code = p-wth-code
     1950         AND buf_c-wth-hist.chip-num = p-chip-num
     1951         AND buf_c-wth-hist.corr-user-db-num = p-corr-user-db-num
     1952         AND buf_c-wth-hist.obj-type = p-obj-type
     1953         AND buf_c-wth-hist.obj-code = p-obj-code
     1954         AND buf_c-wth-hist.subject  = p-subject no-error .
     1955   if not available buf_c-wth-hist then do:
     1956     return error .
     1957   end.
     1958   CASE p-subject:
     1959     when 'wealth':U then do:
     1960       run wealth-proc in this-procedure(output p-description) no-error .
     1961     end.
     1962     when 'wth-par':U then do:
     1963       run wth-par-proc in this-procedure(output p-description) no-error .
     1964     end.
     1965     when 'wth-ser':U then do:
     1966       run wth-ser-proc in this-procedure(output p-description) no-error .
     1967     end.
     1968     when 'wth-gds':U then do:
     1969       run wth-gds-proc in this-procedure(output p-description) no-error .
     1970     end.
     1971   END CASE.
     1972   if error-status:error then do:
     1973     return error .
     1974   end.
     1975   procedure wealth-proc :
     1976   define output parameter p-description as character no-undo .
     1977   define buffer current_c-wealth for ub.c-wealth  .
     1978   do
     1979   on error undo, return error
     1980   :
     1981       find first current_c-wealth no-lock where
     1982                  current_c-wealth.wth-code = p-wth-code
     1983              AND current_c-wealth.chip-num = p-chip-num
     1984              AND current_c-wealth.corr-user-db-num = p-corr-user-db-num no-error .
     1985       if not avail current_c-wealth then do:
     1986          v-mess = "Неверная ссылка на c-wealth в таблице c-wth-hist".
     1987          run err-mess in this-procedure ( input-output v-mess).
     1988          return error (if p-silent then v-mess else '':U).
     1989       end.
     1990   define variable v-label-param as character no-undo .
     1991   v-label-param =
     1992     "curr-code" + chr(4) + "Код валюты" + chr(4) + "" + chr(8)
     1993    + "is-money" + chr(4) + "Наличные" + chr(4) + "" + chr(8)
     1994    + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
     1995    + "stts" + chr(4) + "Статус" + chr(4) + "" + chr(8)
     1996    + "unit-base" + chr(4) + "Ед.изм" + chr(4) + "" + chr(8)
     1997    + "wth-code" + chr(4) + "Код МЦ" + chr(4) + "" + chr(8)
     1998    + "wth-name" + chr(4) + "Название" + chr(4) + ""  + chr(8)
     1999    + "is-ser" + chr(4) + "Серийный" + chr(4) + ""
     2000     .
     2001    run proc-full-temp-changes in this-procedure (input (buf_c-wth-hist.action = 1 )
     2002                                                ,input (buf_c-wth-hist.action = 99 )
     2003                                               ,input  buffer current_c-wealth:handle
     2004                                               ,input  'wealth':U
     2005                                               ,input  "curr-code,is-money,PS,stts,unit-base,wth-code,wth-name,is-ser"
     2006                                               ,input  v-label-param).
     2007   end.
     2008   end procedure.
     2009   procedure wth-par-proc :
     2010   define output parameter p-description as character no-undo .
     2011   define buffer current_c-wth-par for ub.c-wth-par  .
     2012     do
     2013     on error undo, return error
     2014     :
     2015       find first current_c-wth-par no-lock where
     2016                  current_c-wth-par.wth-code = p-wth-code
     2017              AND current_c-wth-par.par-code = p-par-code
     2018              AND current_c-wth-par.chip-num = p-chip-num
     2019              AND current_c-wth-par.corr-user-db-num = p-corr-user-db-num no-error .
     2020       if not avail current_c-wth-par then do:
     2021          v-mess = "Неверная ссылка на c-wth-par в таблице c-wth-hist".
     2022          run err-mess in this-procedure ( input-output v-mess).
     2023          return error (if p-silent then v-mess else '':U).
     2024       end.
     2025   define variable v-label-param as character no-undo .
     2026   v-label-param =
     2027     "par-code" + chr(4) + "Код номинала" + chr(4) + "" + chr(8)
     2028    + "par-feat" + chr(4) + "Доп. признак" + chr(4) + "" + chr(8)
     2029    + "par-rate" + chr(4) + "Коэффициент" + chr(4) + "" + chr(8)
     2030    + "par-unit" + chr(4) + "Ед изм" + chr(4) + "" + chr(8)
     2031    + "par-val" + chr(4) + "Номинал" + chr(4) + "" + chr(8)
     2032    + "wth-code" + chr(4) + "Код МЦ" + chr(4) + ""  .
     2033    run proc-full-temp-changes in this-procedure ( input (buf_c-wth-hist.action = 1 )
     2034                                                ,input (buf_c-wth-hist.action = 99 )
     2035                                               ,input  buffer current_c-wth-par:handle
     2036                                               ,input  'wth-par':U
     2037                                               ,input  "par-code,par-feat,par-rate,par-unit,par-val,wth-code"
     2038                                               ,input  v-label-param).
     2039   end.
     2040   end procedure.
     2041   procedure wth-ser-proc :
     2042   define output parameter p-description as character no-undo .
     2043   define buffer current_c-wth-ser for ub.c-wth-ser .
     2044     do
     2045     on error undo, return error
     2046     :
     2047       find first current_c-wth-ser no-lock where
     2048                  current_c-wth-ser.wth-code = p-wth-code
     2049              AND current_c-wth-ser.chip-num = p-chip-num
     2050              AND current_c-wth-ser.ser-code = p-ser-code
     2051              AND current_c-wth-ser.db-num   = p-serdb-num
     2052              AND current_c-wth-ser.corr-user-db-num = p-corr-user-db-num no-error .
     2053       if not avail current_c-wth-ser then do:
     2054          v-mess = "Неверная ссылка на c-wth-ser в таблице c-wth-hist".
     2055          run err-mess in this-procedure ( input-output v-mess).
     2056          return error (if p-silent then v-mess else '':U).
     2057       end.
     2058   define variable v-label-param as character no-undo .
     2059   v-label-param =
     2060     "ser-code" + chr(4) + "Код серии" + chr(4) + "" + chr(8)
     2061     + "db-num" + chr(4) + "№ БД" + chr(4) + "" + chr(8)
     2062     + "wth-code" + chr(4) + "Код МЦ" + chr(4) + "" + chr(8)
     2063     + "authr" + chr(4) + "Авторизация" + chr(4) + "" + chr(8)
     2064     + "chk-ser" + chr(4) + "Проверка по серии" + chr(4) + "" + chr(8)
     2065     +  "beg-dd" + chr(4) + "Проверка дня начала с симв." + chr(4) + "" + chr(8)
     2066     + "beg-dt" + chr(4) + "Дата начала" + chr(4) + "" + chr(8)
     2067     + "beg-mm" + chr(4) + "Проверка месяца начала с симв." + chr(4) + "" + chr(8)
     2068     + "beg-yy-smb" + chr(4) + "Кол-во симв. в годе срока начала" + chr(4) + "" + chr(8)
     2069     + "beg-yy" + chr(4) + "Проверка года начала с симв." + chr(4) + "" + chr(8)
     2070     + "end-dd" + chr(4) + "Проверка дня оконч. с симв." + chr(4) + "" + chr(8)
     2071     + "end-yy-smb" + chr(4) + "Кол-во симв. в годе срока оконч." + chr(4) + "" + chr(8)
     2072     + "end-yy" + chr(4) + "Проверка года оконч. с симв." + chr(4) + "" + chr(8)
     2073     + "ser-rule" + chr(4) + "Проверка серии с символа" + chr(4) + "" + chr(8)
     2074     + "ser-smb" + chr(4) + "Значение для проверки серии" + chr(4) + "" + chr(8)
     2075     + "gds-rule" + chr(4) + "Проверка кода товара с символа" + chr(4) + "" + chr(8)
     2076     + "gds-smb" + chr(4) + "Значение товара в штрих-коде" + chr(4) + "" + chr(8)
     2077     + "par-rule" + chr(4) + "Проверка номинала товара с символа" + chr(4) + "" + chr(8)
     2078     + "par-smb" + chr(4) + "Значение номинала в штрих-коде" + chr(4) + "" + chr(8)
     2079     + "range-rule" + chr(4) + "Проверка диапазона с симв." + chr(4) + "" + chr(8)
     2080     + "range-smb" + chr(4) + "Проверка диапазона по симв." + chr(4) + "" + chr(8)
     2081     + "gds-smb" + chr(4) + "Кол-во симв. в коде товара" + chr(4) + "" + chr(8)
     2082     + "chk-bdt" + chr(4) + "Проверка по сроку начала" + chr(4) + "" + chr(8)
     2083     + "stts" + chr(4) + "Статус" + chr(4) + ""
     2084     .
     2085    run proc-full-temp-changes in this-procedure (input (buf_c-wth-hist.action = 1 )
     2086                                                ,input (buf_c-wth-hist.action = 99 )
     2087                                               ,input  buffer current_c-wth-ser:handle
     2088                                               ,input  'wth-ser':U
     2089                                               ,input  "ser-code,db-num,wth-code,authr,chk-ser,stts,beg-dd,beg-dt,beg-mm,beg-yy-smb,beg-yy,chk-bdt,chk-edt,chk-gds,chk-par,end-dd,end-dt,end-mm,end-yy-smb,end-yy,gds-rule,gds-smb,maska,par-code,par-rule,par-smb,PS,qnty,range-rule,range-smb,ser-rule,ser-smb"
     2090                                               ,input  v-label-param).
     2091   end.
     2092   end procedure.
     2093   procedure wth-gds-proc :
     2094   define output parameter p-description as character no-undo .
     2095   define buffer current_c-wth-gds for ub.c-wth-gds .
     2096     do
     2097     on error undo, return error
     2098     :
     2099       find first current_c-wth-gds no-lock where
     2100                  current_c-wth-gds.wth-code = p-wth-code
     2101              AND current_c-wth-gds.chip-num = p-chip-num
     2102              AND current_c-wth-gds.corr-user-db-num = p-corr-user-db-num no-error .
     2103       if not avail current_c-wth-gds then do:
     2104          v-mess = "Неверная ссылка на c-wth-ser в таблице c-wth-hist".
     2105          run err-mess in this-procedure ( input-output v-mess).
     2106          return error (if p-silent then v-mess else '':U).
     2107       end.
     2108   define variable v-label-param as character no-undo .
     2109   v-label-param =
     2110     "gds-code" + chr(4) + "Код товара" + chr(4) + "" + chr(8)
     2111     + "wth-code" + chr(4) + "Код МЦ" + chr(4)  + "" + chr(8)
     2112     + "stts" + chr(4) + "Статус" + chr(4) + "" .
     2113    run proc-full-temp-changes in this-procedure (  input (buf_c-wth-hist.action = 1 )
     2114                                                ,input (buf_c-wth-hist.action = 99 )
     2115                                               , input  buffer current_c-wth-gds:handle
     2116                                               ,input  'wth-gds':U
     2117                                               ,input  "gds-code,wth-code,stts"
     2118                                               ,input  v-label-param).
     2119   end.
     2120   end procedure.
     2121   PROCEDURE err-mess:
     2122     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
     2123     CASE p-silent:
     2124       when yes then do:
     2125         assign
     2126         p-mess = substitute("История МЦ с кодом &1 номинал &2: щепка &3 БД:&4 фирма: &5 объект: &6 Предмет изменений &7"
     2127                    ,p-wth-code
     2128                    ,p-par-code
     2129                    ,p-chip-num
     2130                    ,p-corr-user-db-num
     2131                    ,p-host-code
     2132                    ,(p-obj-type + string(p-obj-code))
     2133                    ,p-subject) + chr(10) + p-mess.
     2134       end.
     2135       otherwise do:
     2136         message
     2137         p-mess
     2138         view-as alert-box error .
     2139       end.
     2140     end.
     2141   END PROCEDURE.
