        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter        p-classif-subject as character no-undo .
        6   define input parameter        p-classif-name    as character no-undo .
        7   define input parameter        p-db-num as integer no-undo .
        8   define input parameter        p-Key#_One as integer no-undo .
        9   define input parameter        p-Key#_Two as integer no-undo .
       10   define input parameter        p-key#_Three as integer no-undo .
       11   define input parameter        p-CharKey_One as character no-undo .
       12   define input parameter        p-CharKey_two as character no-undo .
       13   define input parameter        p-CharKey_Three as character no-undo .
       14   define input parameter        p-nonunique as integer no-undo .
       15   define input parameter        p-uniq-key-rec as character no-undo .
       16   define variable vss-revision    as character no-undo init "$Revision: 7e2ad33a7a6f, 2391, rls $":U .
       17   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       18   define variable vss-date        as character no-undo init "$Date: 2020/06/10 18:13:43 $":U .
       19   define variable vss-workfile    as character no-undo init "$Workfile: extclas1.p $":U .
       20   define variable vss-archive     as character no-undo init "$Archive: ref/extclas1.p $":U .
       21   define variable vss-description as character no-undo init "Сохранение записи во внешнем классификаторе".
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define new global shared variable g#library  as handle no-undo .
       81   define new global shared variable g#library2 as handle no-undo .
       82   define   shared variable g#auto as logical no-undo.
       83   define   shared variable g#news as logical no-undo.
       84   define   shared variable g#oxml as logical no-undo.
       85   define   shared variable g#esys as logical no-undo.
       86   define   shared variable g#news-source-db as integer no-undo.
       87   define   shared variable g#esys-source-esys as integer no-undo.
       88   define   shared variable g#db-num as integer   no-undo .
       89   define   shared variable g#userid as character no-undo .
       90   define   shared variable g#passwd as character no-undo .
       91   define new global shared variable g#lib-trn  as handle no-undo .
       92   define new global shared variable g#lib-trn2 as handle no-undo .
       93   define new global shared variable g#lib-trn3 as handle no-undo .
       94   define new global shared variable g#lib-trn4 as handle no-undo .
       95   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       96   procedure gen-key-rec :
       97     define input  parameter p-tbl-name    as character no-undo.
       98     define input  parameter p-bh_tbl-name as handle    no-undo.
       99     define output parameter p-key-rec     as character no-undo.
      100     do
      101     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      102     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      103     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      104     :
      105       define variable fh               as handle    no-undo .
      106       define variable v-ok             as logical   no-undo .
      107       define variable v-inform         as character no-undo .
      108       define variable v-ind            as integer   no-undo .
      109       define variable v-idx-field-qnty as integer   no-undo .
      110       if p-tbl-name = ?
      111         or p-tbl-name = "":U
      112       then do:
      113         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
      114       end.
      115       if not p-bh_tbl-name:available then do:
      116         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      117       end.
      118       assign
      119         p-key-rec = p-tbl-name
      120         v-inform  = p-bh_tbl-name:index-information(1)
      121         v-ind     = 2
      122       .
      123       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      124       on error undo, return error
      125       :
      126         assign
      127           v-inform = p-bh_tbl-name:index-information( v-ind )
      128           v-ind    = v-ind + 1
      129         .
      130       end.
      131       if v-inform = ?
      132         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      133         or entry( 3, v-inform, ",":U ) <> "1":U
      134       then do:
      135         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      136       end.
      137       else do:
      138         assign
      139           v-idx-field-qnty = num-entries( v-inform ) - 4
      140         .
      141         if v-idx-field-qnty < 2 then do:
      142           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      143         end.
      144         do v-ind = 1 to v-idx-field-qnty by 2
      145         on error undo, return error
      146         :
      147           assign
      148             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      149             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      150           .
      151         end.
      152       end.
      153       if p-key-rec = ? then do:
      154         assign
      155           p-key-rec = "":U
      156         .
      157         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      158       end.
      159     end.
      160     return.
      161   end procedure.
      162   procedure gen-where-keyr-tab :
      163     define input  parameter i-tableSerach as character no-undo.
      164     define input  parameter i-tablekey   as character  no-undo.
      165     define input  parameter p-key-rec    as character  no-undo.
      166     define input  parameter p-key-handle as handle     no-undo .
      167     define input  parameter p-db-name    as character  no-undo .
      168     define input  parameter p-tt-handle  as handle     no-undo .
      169     define output parameter o-Where      as character  no-undo.
      170     do
      171     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      172     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      173     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      174     :
      175       define variable v-full-tbl-name  as character no-undo .
      176       define variable bh_tbl-name      as handle    no-undo .
      177       define variable fh_key           as handle    no-undo .
      178       define variable fh_search        as handle    no-undo .
      179       define variable v-field-num      as integer   no-undo .
      180       define variable v-count-fld      as integer   no-undo .
      181       define variable v-inform         as character no-undo .
      182       define variable v-ind            as integer   no-undo .
      183       define variable v-idx-field-qnty as integer   no-undo .
      184       define variable v-field-name     as character no-undo .
      185       define variable v-field-val      as character no-undo .
      186       define variable v-word-link      as character no-undo .
      187       define variable vTable           as character no-undo.
      188       define variable bh_tbl-key       as handle    no-undo .
      189       assign
      190         p-key-rec = trim( p-key-rec )
      191       .
      192       if p-key-handle <> ? then do:
      193         if not valid-handle(p-key-handle)
      194            or p-key-handle:type <> "buffer"
      195         then do:
      196           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      197         end.
      198         if num-entries( p-key-rec, chr(3) ) > 1
      199           or p-key-rec = ?
      200           or p-key-rec = "":U
      201         then do:
      202           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      203         end.
      204       end.
      205       else do:
      206         if p-key-rec = ?
      207           or p-key-rec = "":U
      208         then do:
      209           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      210         end.
      211       end.
      212       assign
      213         vTable = entry( 1 , p-key-rec, chr(3) )
      214       .
      215       if p-tt-handle <> ?
      216         and ( not valid-handle(p-tt-handle)
      217               or p-tt-handle:type <> "buffer"
      218             )
      219       then do:
      220         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      221       end.
      222       if p-tt-handle = ? then do:
      223         assign
      224           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      225         .
      226         create buffer bh_tbl-name for table v-full-tbl-name .
      227       end.
      228       else do:
      229         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      230       end.
      231       assign
      232         v-inform = bh_tbl-name:index-information(1)
      233         v-ind    = 2
      234       .
      235       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      236       on error undo, return error
      237       :
      238         assign
      239           v-inform = bh_tbl-name:index-information( v-ind )
      240           v-ind    = v-ind + 1
      241         .
      242       end.
      243       if v-inform = ?
      244         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      245         or entry( 3, v-inform, ",":U ) <> "1":U
      246       then do:
      247         delete object bh_tbl-name no-error.
      248         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      249       end.
      250       assign
      251         v-idx-field-qnty = num-entries( v-inform ) - 4
      252       .
      253       if v-idx-field-qnty < 2 then do:
      254         delete object bh_tbl-name no-error.
      255         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      256       end.
      257       assign
      258         o-where     = "where":U
      259         v-word-link = "":U
      260         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      261         v-count-fld = 0
      262       .
      263       if i-tablekey ne "" and i-tablekey ne ?
      264       then do:
      265         assign
      266           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      267         .
      268         create buffer bh_tbl-key for table v-full-tbl-name .
      269       end.
      270       if i-tableSerach ne "" and i-tableSerach ne ?
      271       then do:
      272         delete object bh_tbl-name no-error.
      273         assign
      274           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      275         .
      276         create buffer bh_tbl-name for table v-full-tbl-name .
      277       end.
      278       block_where:
      279       do v-ind = 1 to v-idx-field-qnty by 2
      280       on error undo, return error
      281       :
      282         assign
      283           v-count-fld = v-count-fld + 1
      284         .
      285         if p-key-handle = ?
      286           and v-count-fld > v-field-num
      287         then do:
      288           leave block_where.
      289         end.
      290         define variable VfieldKeyTable as handle no-undo.
      291         assign
      292           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      293           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      294         .
      295         if     bh_tbl-key ne ?
      296         then do:
      297            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      298            if VfieldKeyTable eq ?
      299            then next block_where.
      300         end.
      301         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      302         then
      303            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      304         else
      305            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      306         if p-key-handle = ? then do:
      307           assign
      308             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      309           .
      310         end.
      311         else do:
      312           assign
      313             fh_key = p-key-handle:buffer-field( v-field-name )
      314           .
      315           if fh_key = ?
      316             or not valid-handle( fh_key )
      317           then do:
      318             delete object bh_tbl-name.
      319             if     bh_tbl-key ne ?
      320             then
      321                delete object bh_tbl-key.
      322             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      323           end.
      324           assign
      325             v-field-val = fh_key:buffer-value
      326           .
      327         end.
      328         if fh_search:data-type ="character":U then do:
      329           assign
      330             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      331             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      332             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      333             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      334             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      335             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      336             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      337             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      338             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      339             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      340             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      341             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      342             v-field-val = substitute( '"&1"', v-field-val )
      343           .
      344         end.
      345         assign
      346           o-where = substitute( "&1 &2", o-where, v-field-val )
      347         .
      348         if v-word-link = "":U then do:
      349           assign
      350             v-word-link = "and":U
      351           .
      352         end.
      353       end.
      354       delete object bh_tbl-name.
      355       if     bh_tbl-key ne ?
      356       then
      357          delete object bh_tbl-key.
      358       if p-key-handle = ?
      359         and v-count-fld <> v-field-num
      360       then do:
      361         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      362       end.
      363     end.
      364   end procedure.
      365   procedure gen-hn-keyr-tab :
      366     define input  parameter i-tableSerach as character no-undo.
      367     define input  parameter i-tablekey   as character no-undo.
      368     define input  parameter p-key-rec    as character no-undo.
      369     define input  parameter p-key-handle as handle    no-undo .
      370     define input  parameter p-db-name    as character no-undo .
      371     define input  parameter p-tt-handle  as handle    no-undo .
      372     define input  parameter p-stts-lock  as integer   no-undo .
      373     define output parameter o-hn         as handle    no-undo.
      374     define variable v-full-tbl-name as character no-undo.
      375     define variable v-where         as character no-undo.
      376     define variable bh_tbl-name     as handle    no-undo.
      377     define variable vTable          as character no-undo.
      378     do
      379     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      380     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      381     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      382         run gen-where-keyr-tab(i-tableSerach,
      383                                i-tablekey,
      384                                p-key-rec,
      385                                p-key-handle,
      386                                p-db-name,
      387                                p-tt-handle,
      388                                output v-where).
      389         if i-tableSerach ne "" and i-tableSerach ne ?
      390         then do:
      391            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      392            create buffer bh_tbl-name for table v-full-tbl-name .
      393         end.
      394         else do:
      395            if p-tt-handle = ? then do:
      396               assign
      397                  vTable = entry( 1 , p-key-rec, chr(3) )
      398               .
      399               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      400               create buffer bh_tbl-name for table v-full-tbl-name .
      401            end.
      402            else do:
      403               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      404            end.
      405         end.
      406         if p-tt-handle = ? then do:
      407            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      408         end.
      409         else do:
      410            bh_tbl-name:find-first( v-where ) no-error .
      411         end.
      412         o-hn = bh_tbl-name.
      413      end.
      414   end procedure.
      415   procedure gen-hn-keyr :
      416     define input  parameter p-key-rec    as character no-undo.
      417     define input  parameter p-key-handle as handle    no-undo .
      418     define input  parameter p-db-name    as character no-undo .
      419     define input  parameter p-tt-handle  as handle    no-undo .
      420     define input  parameter p-stts-lock  as integer   no-undo .
      421     define output parameter o-hn         as handle    no-undo.
      422     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      423   end.
      424   procedure gen-row-keyr :
      425     define input  parameter p-key-rec    as character no-undo.
      426     define input  parameter p-key-handle as handle    no-undo .
      427     define input  parameter p-db-name    as character no-undo .
      428     define input  parameter p-tt-handle  as handle    no-undo .
      429     define input  parameter p-stts-lock  as integer   no-undo .
      430     define output parameter p-tbl-row    as rowid     no-undo.
      431     define output parameter p-tbl-name   as character no-undo.
      432     define variable vHn as handle no-undo.
      433       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      434       p-tbl-row = if vHn:available then vHn:rowid else ?.
      435       p-tbl-name =  vHn:table.
      436       delete object vHn no-error.
      437     if p-tbl-row = ? then do:
      438       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      439     end.
      440     else do:
      441       return.
      442     end.
      443   end procedure.
      444   procedure gen-key-fv :
      445     define input  parameter p-key-rec    as character no-undo .
      446     define output parameter p-field-list as character no-undo .
      447     define output parameter p-value-list as character no-undo.
      448     do
      449     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      450     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      451     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      452     :
      453       define variable v-full-tbl-name  as character no-undo .
      454       define variable bh_tbl-name      as handle    no-undo .
      455       define variable v-tbl-name       as character no-undo .
      456       define variable v-field-num      as integer   no-undo .
      457       define variable v-count-fld      as integer   no-undo .
      458       define variable v-inform         as character no-undo .
      459       define variable v-ind            as integer   no-undo .
      460       define variable v-idx-field-qnty as integer   no-undo .
      461       define variable v-delim-key      as character no-undo .
      462       if p-key-rec = ?
      463         or p-key-rec = "":U
      464       then do:
      465         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      466       end.
      467       assign
      468         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      469         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      470       .
      471       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      472       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      473       assign
      474         v-inform = bh_tbl-name:index-information(1)
      475         v-ind    = 2
      476       .
      477       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      478       on error undo, return error
      479       :
      480         assign
      481           v-inform = bh_tbl-name:index-information( v-ind )
      482           v-ind    = v-ind + 1
      483         .
      484       end.
      485       if v-inform = ?
      486         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      487         or entry( 3, v-inform, ",":U ) <> "1":U
      488       then do:
      489         delete object bh_tbl-name no-error.
      490         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      491       end.
      492       assign
      493         v-idx-field-qnty = num-entries( v-inform ) - 4
      494       .
      495       if v-idx-field-qnty < 2 then do:
      496         delete object bh_tbl-name no-error.
      497         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      498       end.
      499       assign
      500         p-field-list = "":U
      501         p-value-list = "":U
      502         v-delim-key  = "":U
      503         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      504         v-count-fld  = 0
      505       .
      506       block_where:
      507       do v-ind = 1 to v-idx-field-qnty by 2
      508       on error undo, return error
      509       :
      510         assign
      511           v-count-fld = v-count-fld + 1
      512         .
      513         if v-count-fld > v-field-num then do:
      514           leave block_where.
      515         end.
      516         assign
      517           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      518           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      519         .
      520         if v-ind = 1 then do:
      521           assign
      522             v-delim-key = chr(3)
      523           .
      524         end.
      525       end.
      526       delete object bh_tbl-name.
      527       if v-count-fld <> v-field-num then do:
      528         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      529       end.
      530     end.
      531   end procedure.
      532   procedure gen-key-field :
      533     define input  parameter p-table      as character no-undo .
      534     define output parameter p-field-list as character no-undo .
      535     do
      536     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      537     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      538     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      539     :
      540       define variable v-full-tbl-name  as character no-undo .
      541       define variable bh_tbl-name      as handle    no-undo .
      542       define variable v-tbl-name       as character no-undo .
      543       define variable v-field-num      as integer   no-undo .
      544       define variable v-count-fld      as integer   no-undo .
      545       define variable v-inform         as character no-undo .
      546       define variable v-ind            as integer   no-undo .
      547       define variable v-idx-field-qnty as integer   no-undo .
      548       define variable v-delim-key      as character no-undo .
      549       if p-table = ?
      550         or p-table = "":U
      551       then do:
      552         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      553       end.
      554       assign
      555         v-tbl-name      = p-table
      556         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      557       .
      558       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      559       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      560       assign
      561         v-inform = bh_tbl-name:index-information(1)
      562         v-ind    = 2
      563       .
      564       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      565       on error undo, return error
      566       :
      567         assign
      568           v-inform = bh_tbl-name:index-information( v-ind )
      569           v-ind    = v-ind + 1
      570         .
      571       end.
      572       if v-inform = ?
      573         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      574         or entry( 3, v-inform, ",":U ) <> "1":U
      575       then do:
      576         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      577       end.
      578       assign
      579         v-idx-field-qnty = num-entries( v-inform ) - 4
      580       .
      581       if v-idx-field-qnty < 2 then do:
      582         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      583       end.
      584       assign
      585         p-field-list = "":U
      586         v-delim-key  = "":U
      587         v-count-fld  = 0
      588       .
      589       block_where:
      590       do v-ind = 1 to v-idx-field-qnty by 2
      591       on error undo, return error
      592       :
      593         assign
      594           v-count-fld = v-count-fld + 1
      595         .
      596         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      597         if v-ind = 1 then do:
      598           assign
      599             v-delim-key = chr(3)
      600           .
      601         end.
      602       end.
      603       delete object bh_tbl-name.
      604     end.
      605   end procedure.
      606   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      607   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      608   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      609     define variable v-cntxt-db-num        as integer   no-undo .
      610     define variable v-cntxt-userid        as character no-undo .
      611     define variable v-cntxt-level         as character no-undo .
      612     define variable v-cntxt-host-code-obj as integer   no-undo .
      613     define variable v-cntxt-obj-type      as character no-undo .
      614     define variable v-cntxt-obj-code      as integer   no-undo .
      615     define variable v-cntxt-db-num-obj    as integer   no-undo .
      616     define variable v-cntxt-is-admin      as logical   no-undo .
      617   define variable v-mess as character no-undo .
      618   define variable v-field-list as character no-undo .
      619   define variable v-value-list as character no-undo .
      620   define variable v-obj-type as character no-undo .
      621   define variable v-obj-code as integer no-undo .
      622   define variable v-obj-db-num as integer no-undo .
      623   define variable v-gds-code as integer no-undo .
      624   define variable v-tbl-rid as rowid no-undo .
      625   define variable v-tbl-name as character no-undo .
      626   define variable v-guid1      as character no-undo .
      627   define variable v-guid2      as character no-undo .
      628   define variable v-guid1_     as character no-undo .
      629   define variable v-guid2_     as character no-undo .
      630   define buffer buf_ext-classif for ub.ext-classif.
      631   define buffer buf_ext-system for ub.ext-system.
      632   define variable choice         as LOGICAL   NO-UNDO .
      633   define buffer bf_ext-system   for ub.ext-system.
      634   define buffer buf2_ext-classif for ub.ext-classif.
      635   define buffer buf2_ext-system for ub.ext-system.
      636   define buffer bf_ext-classif  for ub.ext-classif.
      637   if p-mode <> 'ДОБАВЛЕНИЕ':U
      638   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      639     message vss-workfile vss-revision vss-description skip
      640             "Неверный параметр p-mode - " p-mode
      641     view-as alert-box error .
      642     return error '':u.
      643   end.
      644   _main:
      645   do for buf_ext-classif
      646   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      647   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      648   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      649   :
      650     if lookup(p-classif-subject, ('clients':U + chr(44) + 'goods':U + chr(44) + 'cli-grp':U + chr(44) + 'gds-grp':U + chr(44) + 'EGAIS':U)) = 0 then do:
      651       v-mess = substitute("Неверное значение типа внешнего классификатора = &1", p-classif-subject).
      652       run err-mess in this-procedure ( input-output v-mess).
      653       undo _main, return error (if p-silent = yes then v-mess else 'classif-subject':U).
      654     end.
      655     if lookup(p-classif-name, 'inn,exp-parus-code,exp-parus-2-code,GLN,th-th150_clients,th-th14_clients,exite-edi,th-th150_goods,th-th14_goods,exp-accor-gds-code,exp-esys-gds-code,msf-code,clients-esys,exp-easyfuel-talon-gds-code,clients-edoc-nn,gds-grp,th-th_gds-grp,rpm_gds-grp,goods_fib,code_firm_ext,code_org_client,id_diadok_client,oss-ref,egais-transId,FormF1-esys':U) = 0
      656     or p-classif-name = ''
      657     then do:
      658       v-mess = substitute("Неверное значение названия внешнего классификатора = &1", p-classif-name).
      659       run err-mess in this-procedure ( input-output v-mess).
      660       undo _main, return error (if p-silent = yes then v-mess else 'classif-name':U).
      661     end.
      662     if p-uniq-key-rec <> '' then do:
      663     run gen-key-fv in this-procedure (
      664                                         input p-uniq-key-rec
      665                                         ,output v-field-list
      666                                         ,output v-value-list).
      667     end.
      668     case p-classif-subject:
      669       when 'clients':U then do:
      670         case p-classif-name:
      671           when 'exp-parus-code':U then do:
      672             if g#db-num > 0 then do:
      673               v-mess = substitute("Запрещено добавлять коды клиента системы ПАРУС в УБД").
      674               run err-mess in this-procedure ( input-output v-mess).
      675               undo _main, return error (if p-silent = yes then v-mess else '':U).
      676             end.
      677             assign
      678             v-obj-type = entry(lookup("obj-type":U
      679                                               , v-field-list
      680                                               , chr(3))
      681                                         , v-value-list, chr(3))
      682             v-obj-code = integer(entry(lookup("obj-code":U
      683                                               , v-field-list
      684                                               , chr(3))
      685                                         , v-value-list, chr(3)))
      686             no-error .
      687             if not (v-obj-type = 'орг':U
      688                     or
      689                     v-obj-type = 'чел':U) then do:
      690               v-mess = substitute("В классификатор Клиенты системы ПАРУС можно добавлять только &1 или &2", 'орг':U, 'чел':U).
      691               run err-mess in this-procedure ( input-output v-mess).
      692               undo _main, return error (if p-silent = yes then v-mess else '':U).
      693           end.
      694           end.
      695           when 'exp-parus-2-code':U then do:
      696             if g#db-num > 0 then do:
      697               v-mess = substitute("Запрещено добавлять коды клиента системы ПАРУС-2 в УБД").
      698               run err-mess in this-procedure ( input-output v-mess).
      699               undo _main, return error (if p-silent = yes then v-mess else '':U).
      700             end.
      701             assign
      702             v-obj-type = entry(lookup("obj-type":U
      703                                               , v-field-list
      704                                               , chr(3))
      705                                         , v-value-list, chr(3))
      706             v-obj-code = integer(entry(lookup("obj-code":U
      707                                               , v-field-list
      708                                               , chr(3))
      709                                         , v-value-list, chr(3)))
      710             no-error .
      711             if not (v-obj-type = 'орг':U
      712                     or
      713                     v-obj-type = 'чел':U) then do:
      714               v-mess = substitute("В классификатор Клиенты системы ПАРУС-2 можно добавлять только &1 или &2", 'орг':U, 'чел':U).
      715               run err-mess in this-procedure ( input-output v-mess).
      716               undo _main, return error (if p-silent = yes then v-mess else '':U).
      717             end.
      718             if trim(p-charkey_one, "0123456789") <> "" then do:
      719               v-mess = substitute("Код в классификаторе Клиенты системы ПАРУС-2 может содержать только цифры").
      720               run err-mess in this-procedure ( input-output v-mess).
      721               undo _main, return error (if p-silent = yes then v-mess else '':U).
      722             end.
      723           end.
      724           when 'clients-esys':U then do:
      725             find first buf_ext-system no-lock where
      726                       buf_Ext-system.esys-id = p-key#_one
      727                   and buf_Ext-system.db-num = 0 no-error.
      728             if available buf_Ext-system and buf_Ext-system.whole-send-news <> integer('10':U) then do :
      729                 if g#db-num > 0 then do:
      730                   v-mess = substitute("Запрещено добавлять коды объектов внешних систем в УБД").
      731                   run err-mess in this-procedure ( input-output v-mess).
      732                   undo _main, return error (if p-silent = yes then v-mess else '':U).
      733                 end.
      734       find first buf_ext-classif no-lock where
      735                 buf_ext-classif.classif-subject = p-classif-subject
      736             and buf_ext-classif.classif-name = p-classif-name
      737             and buf_ext-classif.db-num = p-db-num
      738             and buf_ext-classif.uniq-key-rec  = p-uniq-key-rec
      739             and buf_ext-classif.key#_one = p-key#_one
      740             and buf_ext-classif.nonunique = p-nonunique
      741             and buf_ext-system.esys-type <> integer('10':U)  no-error.
      742       if available buf_ext-classif then do:
      743        v-mess = substitute("Вн.система &1 с таким объектом/контрагентом &2 &3 уже существует", buf_ext-system.esys-name, string(ENTRY(2, p-uniq-key-rec, chr(3))), string(ENTRY(3, p-uniq-key-rec, chr(3)))).
      744         run err-mess in this-procedure ( input-output v-mess).
      745         undo _main, return error (if p-silent = yes then v-mess else '':U).
      746       end.
      747       if buf_ext-system.esys-type = integer('10':U) then do:
      748       for each buf_ext-classif no-lock where
      749                 buf_ext-system.esys-type = integer('10':U)
      750             and buf_ext-classif.classif-subject = p-classif-subject
      751             and buf_ext-classif.classif-name = p-classif-name
      752             and buf_ext-classif.db-num = p-db-num
      753             and buf_ext-classif.key#_one = p-key#_one
      754             and buf_ext-classif.key#_two = p-key#_two
      755             and buf_ext-classif.nonunique = p-nonunique  :
      756         v-guid1 = entry(1,buf_ext-classif.charkey_two,chr(6)) .
      757         v-guid2 = entry(2,buf_ext-classif.charkey_two,chr(6)) .
      758         v-guid1_ = entry(1,p-charkey_two,chr(6)) .
      759         v-guid2_ = entry(2,p-charkey_two,chr(6)) .
      760         if entry(2,p-uniq-key-rec,chr(3)) = 'орг':U then do:
      761           find first bf_ext-classif no-lock where
      762                 bf_ext-classif.classif-subject = p-classif-subject
      763             and bf_ext-classif.classif-name = p-classif-name
      764             and bf_ext-classif.db-num = p-db-num
      765             and bf_ext-classif.uniq-key-rec  = p-uniq-key-rec
      766             and bf_ext-classif.key#_one = p-key#_one
      767             and bf_ext-classif.nonunique = p-nonunique
      768             and buf_ext-system.esys-type = integer('10':U)  no-error.
      769           if available (bf_ext-classif) then do:
      770             if bf_ext-classif.CharKey_Two <> "" and entry(2,bf_ext-classif.charkey_two,chr(6)) = "" then do:
      771               v-mess = substitute("Уже есть запись c GUID хоз Субъекта для этой фирмы").
      772               run err-mess in this-procedure ( input-output v-mess).
      773               undo _main, return error (if p-silent = yes then v-mess else '':U).
      774             end.
      775           end.
      776         end.
      777         if v-guid1 <> "" and v-guid1 = v-guid1_ and v-guid2 = v-guid2_ and v-guid2 <> ""
      778         then do:
      779           v-mess = substitute("Уже есть запись c GUID хоз Субъекта: &1 и GUID площадки: &2", v-guid1, v-guid2).
      780           run err-mess in this-procedure ( input-output v-mess).
      781           undo _main, return error (if p-silent = yes then v-mess else '':U).
      782         end.
      783       end.
      784       end.
      785             end.
      786             if not available buf_ext-system then do:
      787               v-mess = substitute("Не найдена внешняя система &1 для БД &2"
      788                                  , p-key#_one
      789                                  , 0).
      790               run err-mess in this-procedure ( input-output v-mess).
      791               undo _main, return error (if p-silent = yes then v-mess else '':U).
      792             end.
      793             assign
      794             v-obj-type = entry(lookup("obj-type":U
      795                                               , v-field-list
      796                                               , chr(3))
      797                                         , v-value-list, chr(3))
      798             v-obj-code = integer(entry(lookup("obj-code":U
      799                                               , v-field-list
      800                                               , chr(3))
      801                                         , v-value-list, chr(3)))
      802             no-error .
      803             if not (v-obj-type = 'маг':U
      804                     or
      805                     v-obj-type = 'орг':U
      806                     or
      807                     v-obj-type = 'скл':U
      808                     or
      809                     v-obj-type = ''
      810                     or v-obj-type = 'чел':U
      811                     ) then do:
      812               v-mess = substitute("В классификатор Объекты внешних систем можно добавлять только <&1> или <&2> или <>", 'маг':U, 'скл':U).
      813               run err-mess in this-procedure ( input-output v-mess).
      814               undo _main, return error (if p-silent = yes then v-mess else '':U).
      815             end.
      816           end.
      817           when 'clients-edoc-nn':U then do:
      818             if g#db-num > 0 then do:
      819               v-mess = substitute("Запрещено добавлять привязку поставщиков к внешним системам в УБД").
      820               run err-mess in this-procedure ( input-output v-mess).
      821               undo _main, return error (if p-silent = yes then v-mess else '':U).
      822             end.
      823             find first buf_ext-system no-lock where
      824                       buf_Ext-system.esys-id = p-key#_one
      825                   and buf_Ext-system.db-num = 0 no-error.
      826             if not available buf_ext-system then do:
      827               v-mess = substitute("Не найдена внешняя система &1 для БД &2"
      828                                  , p-key#_one
      829                                  , 0).
      830               run err-mess in this-procedure ( input-output v-mess).
      831               undo _main, return error (if p-silent = yes then v-mess else '':U).
      832             end.
      833             for each buf2_ext-classif no-lock where
      834                          buf2_ext-classif.classif-subject = p-classif-subject
      835                      and buf2_ext-classif.classif-name = p-classif-name
      836                      and buf2_ext-classif.uniq-key-rec = p-uniq-key-rec,
      837                first buf2_ext-system no-lock where
      838                       buf2_Ext-system.esys-id = buf2_ext-classif.key#_one
      839                   and buf2_Ext-system.db-num = 0 :
      840               if buf2_ext-system.esys-db-num-exp = buf_ext-system.esys-db-num-exp
      841               and recid(buf_ext-system) <> recid(buf2_ext-system)
      842               and (p-mode = 'ДОБАВЛЕНИЕ':U or recid(buf_ext-classif) <> recid(buf2_ext-classif))
      843               then do:
      844                 v-mess = substitute("Для данного поставщика уже определена внешняя система &2 с экспортом в БД &1"
      845                                   , buf2_ext-system.esys-id
      846                                   , buf2_ext-system.esys-db-num-exp).
      847                 run err-mess in this-procedure ( input-output v-mess).
      848                 undo _main, return error (if p-silent = yes then v-mess else '':U).
      849               end.
      850             end.
      851           end.
      852           when 'exite-edi':U then do:
      853             if g#db-num > 0 then do:
      854               v-mess = substitute("Запрещено добавлять привязку к EDI в УБД").
      855               run err-mess in this-procedure ( input-output v-mess).
      856               undo _main, return error (if p-silent = yes then v-mess else '':U).
      857             end.
