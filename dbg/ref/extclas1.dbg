     1254   end.
     1255   PROCEDURE err-mess:
     1256   DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
     1257   CASE p-silent:
     1258     when yes then do:
     1259       case p-classif-subject:
     1260         when 'clients':U then do:
     1261           case p-classif-name:
     1262             when 'inn':U then do:
     1263               assign
     1264             p-mess = substitute("ИНН &1 для клиента &2&3&4&5"
     1265                                 , p-key#_one
     1266                                 , v-obj-type
     1267                                 , v-obj-code
     1268                                 , chr(10)
     1269                                 , p-mess)
     1270               .
     1271             end.
     1272             when 'exp-parus-code':U then do:
     1273               assign
     1274             p-mess = substitute("Код клиента в системе ПАРУС: &1 для клиента &2&3&4&5"
     1275                                 , p-key#_one
     1276                                 , v-obj-type
     1277                                 , v-obj-code
     1278                                 , chr(10)
     1279                                 , p-mess)
     1280               .
     1281             end.
     1282           when 'exp-parus-2-code':U then do:
     1283             assign
     1284             p-mess = substitute("Код клиента в системе ПАРУС-2: &1 для клиента &2&3&4&5"
     1285                               , p-charkey_one
     1286                               , v-obj-type
     1287                               , v-obj-code
     1288                               , chr(10)
     1289                               , p-mess)
     1290             .
     1291           end.
     1292             when 'clients-esys':U then do:
     1293               assign
     1294               p-mess = substitute("Объект во внешней системе &1: &2&3 для объекта &4&5 &6&7"
     1295                                 , p-key#_one
     1296                                 , p-charkey_one
     1297                               , p-charkey_three
     1298                                 , v-obj-type
     1299                                 , v-obj-code
     1300                                 , chr(10)
     1301                                 , p-mess)
     1302               .
     1303             end.
     1304           end.
     1305         end.
     1306         when 'goods':U then do:
     1307           case p-classif-name:
     1308             when  'exp-accor-gds-code':U then do:
     1309               assign
     1310             p-mess = substitute("Код товара &1&2&3"
     1311                                 , v-gds-code
     1312                                 , chr(10)
     1313                                 , p-mess)
     1314               .
     1315             end.
     1316             when  'msf-code':U then do:
     1317               assign
     1318             p-mess = substitute("Код товара &1&2&3"
     1319                               , v-gds-code
     1320                               , chr(10)
     1321                               , p-mess)
     1322               .
     1323             end.
     1324             when  'exp-easyfuel-talon-gds-code':U then do:
     1325               assign
     1326               p-mess = substitute("Код товара &1&2&3"
     1327                                 , v-gds-code
     1328                                 , chr(10)
     1329                                 , p-mess)
     1330               .
     1331             end.
     1332           end case.
     1333         end.
     1334       when 'gds-grp':U then do:
     1335         case p-classif-name:
     1336           when 'rpm_gds-grp':U then do:
     1337             assign
     1338             p-mess = substitute("Узел товарного классификатора RPM &1/&2/&3/&4&5&6&5&7"
     1339                                , p-charkey_one
     1340                                , p-key#_one
     1341                                , p-key#_two
     1342                                , p-key#_three
     1343                                ,chr(10)
     1344                                , error-status:get-message(1)
     1345                                , p-mess ).
     1346           end.
     1347         end case.
     1348       end.
     1349       end case.
     1350     end.
     1351     when no then do:
     1352       message
     1353       p-mess
     1354       view-as alert-box error .
     1355     end.
     1356   end case.
     1357   END PROCEDURE.
