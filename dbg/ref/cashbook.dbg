        1   block-level on error undo, throw.
        2   SESSION:ERROR-STACK-TRACE=YES.
        3   define input  parameter parparentproc as handle no-undo .
        4   define input  parameter pMode as character  no-undo .
        5     define variable v-brw as class ibs.th.ref.cashbookbrw no-undo .
        6     v-brw = new ibs.th.ref.cashbookbrw ( pMode, parparentproc ).
        7     wait-for  v-brw:ShowDialog() .
        8   define variable v-err-msg as character no-undo .
        9     catch exAppErrors as class Progress.Lang.AppError :
       10       v-err-msg = exAppErrors:ReturnValue .
       11       if v-err-msg > "" then . else do :
       12         v-err-msg = exAppErrors:GetMessage(1) .
       13         if v-err-msg > "" then . else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\cashbook.p" .
       14       end .
       15       message v-err-msg  view-as alert-box.
       16     end catch .
       17     catch exProErrors as class Progress.Lang.ProError :
       18       v-err-msg = exProErrors:GetMessage(1) .
       19       if v-err-msg > "" then . else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\cashbook.p" .
       20       message "ProError" skip(1) v-err-msg  view-as alert-box.
       21     end catch .
       22     catch exAnyErrors as class Progress.Lang.Error:
       23       v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\cashbook.p " + exAnyErrors:GetMessage(1).
       24       message "LangError" skip(1) v-err-msg  view-as alert-box.
       25     end catch .
       26   finally:
       27       SESSION:ERROR-STACK-TRACE=no.
       28      if valid-object(v-brw) then delete object v-brw no-error .
       29   end finally.
