        1   block-level on error undo, throw.
        2   define input  parameter parParentProc as handle no-undo .
        3   define input  parameter p-obj-type as character no-undo .
        4   define input  parameter p-obj-code as integer   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: c-tppr.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: ref/c-tppr.p $":U .
       10   define variable vss-description as character no-undo init "Процедура вызова и сбора recid по типам прайс-листов по одному клиенту".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72     define variable v-cntxt-db-num        as integer   no-undo .
       73     define variable v-cntxt-userid        as character no-undo .
       74     define variable v-cntxt-level         as character no-undo .
       75     define variable v-cntxt-host-code-obj as integer   no-undo .
       76     define variable v-cntxt-obj-type      as character no-undo .
       77     define variable v-cntxt-obj-code      as integer   no-undo .
       78     define variable v-cntxt-db-num-obj    as integer   no-undo .
       79     define variable v-cntxt-is-admin      as logical   no-undo .
       80   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81     run mainmenu_getcntxt in parparentproc
       82       (output v-cntxt-db-num
       83       ,output v-cntxt-userid
       84       ,output v-cntxt-level
       85       ,output v-cntxt-host-code-obj
       86       ,output v-cntxt-obj-type
       87       ,output v-cntxt-obj-code
       88       ,output v-cntxt-db-num-obj
       89       ,output v-cntxt-is-admin
       90       ) .
       91   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   define temp-table x_obj-group no-undo like ub.clients  .
       93   define temp-table x_grp-obj-price no-undo like ub.grp-obj-price .
       94   procedure metod-gop-obj :
       95     do
       96     on error undo, return error return-value
       97     :
       98   define input  parameter p-cntxt-db-num as integer   no-undo .
       99   define input  parameter p-gop-id       as integer   no-undo .
      100   define input  parameter p-gop-db-num   as integer   no-undo .
      101   define buffer buf1_clients for ub.clients  .
      102   define buffer buf_db-grp-obj-price   for ub.db-grp-obj-price  .
      103   define buffer buf_host-grp-obj-price for ub.host-grp-obj-price  .
      104   define buffer buf_obj-grp-obj-price  for ub.obj-grp-obj-price  .
      105   for each  x_obj-group : delete x_obj-group. end.
      106   if p-gop-id = 0 or p-gop-id = ?  then do:
      107      if p-cntxt-db-num = 0  then do:
      108           for each buf1_clients no-lock where
      109                   (buf1_clients.obj-type = 'маг':U  or
      110                    buf1_clients.obj-type = 'скл':U  )
      111                   and
      112                   buf1_clients.db-num >= 0  and
      113                   buf1_clients.stts = 0
      114                   :
      115             create x_obj-group .
      116             assign
      117               x_obj-group.obj-code   = buf1_clients.obj-code
      118               x_obj-group.obj-type   = buf1_clients.obj-type
      119               x_obj-group.obj-name   = buf1_clients.obj-name
      120               x_obj-group.db-num     = buf1_clients.db-num
      121             .
      122           end.
      123      end.
      124      else do:
      125           for each buf1_clients no-lock where
      126                   (buf1_clients.obj-type = 'маг':U  or
      127                    buf1_clients.obj-type = 'скл':U  ) and
      128                    buf1_clients.db-num = p-cntxt-db-num  and
      129                    buf1_clients.stts = 0
      130                   :
      131             create x_obj-group .
      132             assign
      133               x_obj-group.obj-code   = buf1_clients.obj-code
      134               x_obj-group.obj-type   = buf1_clients.obj-type
      135               x_obj-group.obj-name   = buf1_clients.obj-name
      136               x_obj-group.db-num     = buf1_clients.db-num
      137             .
      138           end.
      139      end.
      140   end.
      141   else do:
      142         for each buf_db-grp-obj-price  where
      143                 buf_db-grp-obj-price.gop-id     = p-gop-id and
      144                 buf_db-grp-obj-price.gop-db-num = p-gop-db-num and
      145                 buf_db-grp-obj-price.stts = 0  no-lock :
      146           for each buf1_clients no-lock where
      147                  (buf1_clients.obj-type = 'маг':U  or
      148                   buf1_clients.obj-type = 'скл':U  ) and
      149                   buf1_clients.db-num = buf_db-grp-obj-price.dgo-db-num  and
      150                   buf1_clients.stts = 0
      151                   :
      152             create x_obj-group .
      153             assign
      154               x_obj-group.obj-code   = buf1_clients.obj-code
      155               x_obj-group.obj-type   = buf1_clients.obj-type
      156               x_obj-group.obj-name   = buf1_clients.obj-name
      157               x_obj-group.db-num     = buf1_clients.db-num
      158             .
      159           end.
      160         end.
      161       for each buf_host-grp-obj-price where
      162               buf_host-grp-obj-price.gop-id     = p-gop-id and
      163               buf_host-grp-obj-price.gop-db-num = p-gop-db-num and
      164               buf_host-grp-obj-price.stts = 0
      165               no-lock :
      166         for each buf1_clients no-lock where
      167                (buf1_clients.obj-type = 'маг':U  or
      168                 buf1_clients.obj-type = 'скл':U  ) and
      169                 buf1_clients.host-code = buf_host-grp-obj-price.host-code and
      170                 buf1_clients.stts = 0
      171                 :
      172             find first x_obj-group no-lock  where
      173                       x_obj-group.obj-code   = buf1_clients.obj-code and
      174                       x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      175             if not available  x_obj-group then   create x_obj-group .
      176             assign
      177               x_obj-group.obj-code   = buf1_clients.obj-code
      178               x_obj-group.obj-type   = buf1_clients.obj-type
      179               x_obj-group.obj-name   = buf1_clients.obj-name
      180               x_obj-group.db-num     = buf1_clients.db-num
      181             .
      182         end.
      183       end.
      184       for each buf_obj-grp-obj-price where
      185               buf_obj-grp-obj-price.gop-id     = p-gop-id and
      186               buf_obj-grp-obj-price.gop-db-num = p-gop-db-num and
      187               buf_obj-grp-obj-price.stts = 0
      188               no-lock :
      189         for each buf1_clients no-lock where
      190                   buf1_clients.obj-type = buf_obj-grp-obj-price.obj-type and
      191                   buf1_clients.obj-code = buf_obj-grp-obj-price.obj-code and
      192                   buf1_clients.stts     = 0
      193                   :
      194             find first  x_obj-group no-lock  where
      195                         x_obj-group.obj-code   = buf1_clients.obj-code and
      196                         x_obj-group.obj-type   = buf1_clients.obj-type no-error .
      197             if not available  x_obj-group then   create x_obj-group .
      198             assign
      199               x_obj-group.obj-code   = buf1_clients.obj-code
      200               x_obj-group.obj-type   = buf1_clients.obj-type
      201               x_obj-group.obj-name   = buf1_clients.obj-name
      202               x_obj-group.db-num     = buf1_clients.db-num
      203             .
      204         end.
      205       end.
      206   end.
      207   end.
      208   end procedure.
      209   procedure metod-obj-in-gop :
      210   define input  parameter p-curr-db-num as integer   no-undo .
      211   define input  parameter p-obj-type as character no-undo .
      212   define input  parameter p-obj-code as integer   no-undo .
      213   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      214     do
      215     on error undo, return error return-value
      216     :
      217       empty temp-table x_grp-obj-price.
      218       for each buf_grp-obj-price where
      219                buf_grp-obj-price.stts = 0
      220                no-lock :
      221                  run metod-gop-obj (p-curr-db-num , buf_grp-obj-price.gop-id ,buf_grp-obj-price.gop-db-num) .
      222                  for each x_obj-group where
      223                           x_obj-group.obj-type = p-obj-type and
      224                           x_obj-group.obj-code = p-obj-code :
      225                       create  x_grp-obj-price.
      226                       buffer-copy buf_grp-obj-price to x_grp-obj-price .
      227                  end.
      228       end.
      229     end.
      230   end procedure.
      231   procedure metod-delobj-usr :
      232   define input  parameter p-pdf-id  as integer   no-undo .
      233   define input  parameter p-pdf-db  as integer   no-undo .
      234   define input  parameter p-plt-id  as integer   no-undo .
      235   define input  parameter p-plt-db-num as integer   no-undo .
      236   define buffer buf_price-doc-forming-attr for ub.price-doc-forming-attr  .
      237     do
      238     on error undo, return error return-value
      239     :
      240   for each buf_price-doc-forming-attr no-lock  where
      241            buf_price-doc-forming-attr.pdf-id =     p-pdf-id and
      242            buf_price-doc-forming-attr.pdf-db =     p-pdf-db and
      243            buf_price-doc-forming-attr.plt-id =     p-plt-id and
      244            buf_price-doc-forming-attr.plt-db-num = p-plt-db-num and
      245            buf_price-doc-forming-attr.attr-code begins "obj" :
      246      for each x_obj-group  where
      247               x_obj-group.obj-type = substring(buf_price-doc-forming-attr.attr-code,4,3) and
      248               x_obj-group.obj-code = int(substring(buf_price-doc-forming-attr.attr-code,7,20)) :
      249        delete x_obj-group.
      250      end.
      251   end.
      252     if not can-find (first x_obj-group) then do:
      253        return "nullobj" .
      254     end.
      255   end.
      256   end procedure.
      257   procedure metod-obj-pdf :
      258   define input  parameter p-cntxt-db-num as integer   no-undo .
      259   define input  parameter p-pdf-id     like ub.price-doc-forming.pdf-id   no-undo .
      260   define input  parameter p-pdf-db-num like ub.price-doc-forming.pdf-db   no-undo .
      261   define input  parameter p-plt-id     like ub.price-doc-forming.plt-id   no-undo .
      262   define input  parameter p-plt-db-num like ub.price-doc-forming.plt-db-num  no-undo .
      263   define buffer buf_price-list-type for ub.price-list-type  .
      264   define buffer buf_price-doc-forming for ub.price-doc-forming  .
      265     do
      266     on error undo, return error return-value
      267     :
      268    for each  x_obj-group : delete x_obj-group. end.
      269    find first buf_price-list-type no-lock where
      270               buf_price-list-type.plt-id = p-plt-id and
      271               buf_price-list-type.plt-db-num = p-plt-db-num no-error .
      272   if error-status :error then return error return-value .
      273    find first buf_price-doc-forming no-lock where
      274               buf_price-doc-forming.plt-id     = p-plt-id and
      275               buf_price-doc-forming.plt-db-num = p-plt-db-num and
      276               buf_price-doc-forming.pdf-id     = p-pdf-id and
      277               buf_price-doc-forming.pdf-db     = p-pdf-db-num
      278               no-error .
      279   if error-status :error then return error return-value .
      280     run metod-gop-obj in this-procedure (
      281         p-cntxt-db-num,
      282         buf_price-list-type.gop-id ,
      283         buf_price-list-type.gop-db-num
      284         ) no-error .
      285     run metod-delobj-usr in this-procedure (
      286       buf_price-doc-forming.pdf-id ,
      287       buf_price-doc-forming.pdf-db ,
      288       buf_price-doc-forming.plt-id ,
      289       buf_price-doc-forming.plt-db-num
      290       ) no-error .
      291     end.
      292   end procedure.
      293   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      294   define variable v-waitfram-action01         as character   no-undo .
      295   define variable v-waitfram-action02         as character   no-undo .
      296   define variable v-waitfram-action03         as character   no-undo .
      297   define variable mWaitFramTextBeg            as character   no-undo.
      298   define variable mWaitFramTextEnd            as character   no-undo.
      299   define variable mWaitFramView               as logical     no-undo.
      300   define variable mWaitProcEvent              as logical     no-undo init yes.
      301   define variable mWaitFramInterval           as integer     no-undo init 1 .
      302   define variable mWaitFramStop               as logical     no-undo.
      303   define variable mWaitFramStopUser           as logical     no-undo.
      304   define variable mWaitFramStopTimeOut        as logical     no-undo.
      305   define variable mWaitFramStartProc          as datetime-tz no-undo.
      306   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      307   define button B-WaitFramStop auto-end-key
      308        label "Стоп"
      309        size 10 by 1 tooltip "Остоновить процесс".
      310   define button B-viewProcInfo
      311        label "Информация"
      312        size 15 by 1 tooltip "Информация о процесс".
      313   define frame waitfram
      314     v-waitfram-action01 format "x(72)" no-label skip
      315     v-waitfram-action02 format "x(72)" no-label skip
      316     v-waitfram-action03 format "x(72)" no-label skip
      317     B-viewProcInfo
      318     B-WaitFramStop at row 4 col 30
      319     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      320     .
      321   define new global shared variable mBatchMode as logical no-undo init ?.
      322   define variable mFramBachModHandle as handle no-undo.
      323   mFramBachModHandle = frame waitfram:handle.
      324   define variable mFameOldVis as logical no-undo.
      325   define variable mVisCUrentVin as logical no-undo.
      326   if session:batch-mode
      327   then
      328      mBatchMode = yes.
      329   if mBatchMode = ? then do:
      330     mVisCUrentVin = current-window:visible.
      331     mFameOldVis = mFramBachModHandle:visible.
      332     mFramBachModHandle:visible  = yes.
      333     mBatchMode = mFramBachModHandle:visible ne yes.
      334     mFramBachModHandle:visible = mFameOldVis.
      335     current-window:visible = mVisCUrentVin.
      336   end.
      337    if  log-manager:logfile-name ne ?
      338     then DO:
      339         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      340         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      341         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      342     end.
      343   on choose of B-WaitFramStop in frame waitfram
      344   do:
      345     mWaitFramStop = yes.
      346     mWaitFramStopUser = yes.
      347   end.
      348   function waitfram-check-timeout returns logical():
      349      define variable vtime as int64 no-undo.
      350      if mWaitFramStopTimeOut
      351      then
      352         return yes.
      353      vtime = ( now - mWaitFramStartProc ) / 1000 .
      354      if     mWaitFramTimeOut ne ?
      355         and mWaitFramTimeOut ne 0
      356         and mWaitFramTimeOut lt vtime
      357      then do:
      358         mWaitFramStopTimeOut = yes.
      359      end.
      360      return mWaitFramStopTimeOut.
      361   end.
      362   procedure waitfram-hide :
      363     if not session:batch-mode
      364     then do
      365     on error undo, return error return-value
      366     :
      367       pause 0 before-hide .
      368       if not mBatchMode then
      369         hide frame waitfram .
      370     if     not mWaitFramView
      371        and mWaitProcEvent
      372     then
      373       process events .
      374     end.
      375   end procedure.
      376   procedure waitfram-show :
      377     define input  parameter p-message as character no-undo .
      378     define variable v-left-margin as integer   no-undo .
      379     if not session:batch-mode
      380     then do
      381     on error undo, return error return-value
      382     :
      383       if length(p-message) <= 70 then do:
      384         assign
      385           v-left-margin = integer((70 - length(p-message)) / 2)
      386         .
      387         assign
      388           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      389         .
      390         assign
      391           v-waitfram-action01 = " "
      392           v-waitfram-action02 = " "
      393                                    + fill(" ", v-left-margin)
      394                                    + p-message
      395           v-waitfram-action03 = " "
      396         .
      397       end.
      398       else do:
      399         define variable vRindex1 as integer no-undo.
      400         define variable vRindex2 as integer no-undo.
      401         vRindex1 = r-index(p-message," ",70).
      402         if vRindex1 = 0
      403         then
      404            vRindex1 = 70.
      405         if length(p-message)  <= vRindex1 + 70 then do:
      406           assign
      407             v-waitfram-action01 = " "
      408             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      409             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      410           .
      411         end.
      412         else do:
      413           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      414           if vRindex2 <= vRindex1
      415           then
      416              vRindex2 = vRindex1 + 70.
      417           assign
      418             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      419             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      420             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      421           .
      422         end.
      423       end.
      424       B-viewProcInfo:visible   in frame waitfram = no.
      425       B-viewProcInfo:sensitive in frame waitfram = no.
      426       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      427       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      428       if  (   mWaitFramView
      429          or  mWaitProcEvent)
      430          and not mBatchMode
      431       then
      432          display
      433             v-waitfram-action01 skip
      434             v-waitfram-action02 skip
      435             v-waitfram-action03 skip
      436          with frame waitfram .
      437       if     mWaitFramView
      438          then do:
      439             if     mWaitFramInterval ne ?
      440                and not mBatchMode
      441             then
      442                wait-for go of frame waitfram pause mWaitFramInterval.
      443          end.
      444          else
      445             if     mWaitProcEvent
      446                and not mBatchMode
      447             then
      448                process events .
      449     end.
      450   end procedure.
      451      procedure waitfram-show-this:
      452         define input  parameter iInterval as int64 no-undo.
      453         define variable vtime as int64 no-undo.
      454         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      455         mWaitFramInterval = iInterval.
      456         run waitfram-show (substitute("&1&2 &3&4" ,
      457                                       mWaitFramTextBeg ,
      458                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      459                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      460                                       mWaitFramTextEnd
      461                                      )
      462                           ).
      463      end.
      464      procedure WaitFramRunPause:
      465         define input  parameter iInterval as dec no-undo.
      466         define variable vStart  as datetime-tz no-undo.
      467         define variable vend    as datetime-tz no-undo.
      468         define variable vint as int64 no-undo.
      469         define variable vOk as logical no-undo.
      470         vStart = now.
      471         vend   = vStart.
      472         publish "WaitFramPause" (iInterval,output vOk).
      473         vend   =  now.
      474         vint = vend - vStart.
      475         vint = iInterval - vint / 1000.
      476         if     not mWaitFramStop
      477            and (   vint > 0
      478                 or (    not vOk
      479                     and iInterval eq ?
      480                     )
      481                 )
      482         then
      483            run waitfram-show-this (iInterval).
      484         vend   =  now.
      485         vint = vend - vStart.
      486         vint = iInterval - vint / 1000.
      487         if     not mWaitFramStop
      488            and vint > 0
      489         then do:
      490            run gbl/pause.p (vint * 1000).
      491         end.
      492         if iInterval ne ?
      493         then
      494            publish "WaitFramStop".
      495         waitfram-check-timeout().
      496      end.
      497      procedure WaitFramWaitFor:
      498         define input  parameter iInterval as dec no-undo.
      499         assign
      500            mWaitFramStartProc   = now
      501            mWaitFramStopUser    = no
      502            mWaitFramStopTimeOut = no
      503         .
      504         block-wait:
      505         do while not mWaitFramStop:
      506            run WaitFramRunPause (iInterval).
      507            if  waitfram-check-timeout()
      508            then do:
      509               leave block-wait.
      510            end.
      511         end.
      512         run waitfram-hide.
      513      end.
      514   procedure waitfram-join :
      515     define input  parameter p-line-1  as character no-undo .
      516     define input  parameter p-line-2  as character no-undo .
      517     define input  parameter p-line-3  as character no-undo .
      518     define output parameter p-message as character no-undo .
      519     do
      520     on error undo, return error return-value
      521     :
      522       assign
      523         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      524                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      525                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      526       .
      527     end.
      528   end procedure.
      529   function waitfram-join-function returns character
      530     (input p-line-1 as character
      531     ,input p-line-2 as character
      532     ,input p-line-3 as character
      533     ).
      534     define variable v-message as character no-undo .
      535     run waitfram-join in this-procedure
      536       (input  p-line-1
      537       ,input  p-line-2
      538       ,input  p-line-3
      539       ,output v-message
      540       ) .
      541     return v-message .
      542   end function .
      543   define buffer buf_clients for ub.clients  .
      544   define buffer buf_price-list-type for ub.price-list-type  .
      545   find first buf_clients no-lock where
      546              buf_clients.obj-type  = p-obj-type and
      547              buf_clients.obj-code  = p-obj-code no-error .
      548   if error-status :error then return error error-status :get-message(1)  .
      549   run waitfram-show in this-procedure ("Выборка типов прайс-листов...") .
      550   define variable v-par as character no-undo  init "" .
      551   if p-obj-type = 'орг':U or p-obj-type = 'чел':U then do:
      552   define buffer buf_buyer-in-buyer-group for ub.buyer-in-buyer-group  .
      553   define buffer buf_buyer-group          for ub.buyer-group  .
      554   for each buf_buyer-in-buyer-group no-lock where
      555            buf_buyer-in-buyer-group.bbg-obj-type = p-obj-type and
      556            buf_buyer-in-buyer-group.bbg-obj-code = p-obj-code,
      557       first buf_price-list-type no-lock where
      558             buf_price-list-type.bgr-id     = buf_buyer-in-buyer-group.bgr-id and
      559             buf_price-list-type.bgr-db-num = buf_buyer-in-buyer-group.bgr-db-num
      560             :
      561             v-par = v-par + string(recid(buf_price-list-type)) +  "," .
      562   end.
      563   for each buf_price-list-type no-lock where
      564            buf_price-list-type.rs-buyer  = 0
      565             :
      566             v-par = v-par + string(recid(buf_price-list-type)) +  "," .
      567   end.
      568   define buffer buf_turnover-buyer-main for ub.turnover-buyer-main  .
      569   define variable v-summa as decimal   no-undo init 0 .
      570   for each   buf_turnover-buyer-main no-lock WHERE
      571       buf_turnover-buyer-main.cli-type =  p-obj-type AND
      572       buf_turnover-buyer-main.cli-code =  p-obj-code
      573       :
      574       v-summa = v-summa + buf_turnover-buyer-main.sum-doc-rubl-itog .
      575   end.
      576   define buffer buf_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
      577   define buffer buf_tnv-group for ub.turnover-group  .
      578   define buffer last_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
      579   define variable v-tog-db-num as integer   no-undo init 0.
      580   define variable v-tog-id    as integer   no-undo init 0.
      581   for each buf_tnv-group no-lock :
      582       for each buf_tnv-in-turnover-group no-lock where
      583                 buf_tnv-in-turnover-group.tog-db-num  = buf_tnv-group.tog-db-num  and
      584                 buf_tnv-in-turnover-group.tog-id      = buf_tnv-group.tog-id       and
      585                 buf_tnv-in-turnover-group.stts        = 0
      586                 break by buf_tnv-in-turnover-group.ttg-summa
      587                 :
      588                 find first  last_tnv-in-turnover-group no-lock  where
      589                             last_tnv-in-turnover-group.stts       = 0 and
      590                             last_tnv-in-turnover-group.tog-db-num = buf_tnv-in-turnover-group.tog-db-num and
      591                             last_tnv-in-turnover-group.tog-id     = buf_tnv-in-turnover-group.tog-id      and
      592                             last_tnv-in-turnover-group.ttg-summa   > buf_tnv-in-turnover-group.ttg-summa
      593                             use-index pi no-error .
      594              if available last_tnv-in-turnover-group  then do:
      595                   if v-summa >= buf_tnv-in-turnover-group.ttg-summa and  v-summa < last_tnv-in-turnover-group.ttg-summa then do:
      596                       v-tog-db-num = buf_tnv-in-turnover-group.tog-db-num .
      597                       v-tog-id     = buf_tnv-in-turnover-group.tog-id     .
      598                       leave.
      599                   end.
      600              end.
      601              else do:
      602                 if v-summa >= buf_tnv-in-turnover-group.ttg-summa then do:
      603                 v-tog-db-num = buf_tnv-in-turnover-group.tog-db-num .
      604                 v-tog-id     = buf_tnv-in-turnover-group.tog-id     .
      605                 leave.
      606                 end.
      607              end.
      608       end.
      609       if v-tog-id <> 0 then do:
      610          for each buf_price-list-type no-lock where
      611                 buf_price-list-type.tog-id     = v-tog-id and
      612                 buf_price-list-type.tog-db-num = v-tog-db-num
      613                 :
      614                 v-par = v-par + string(recid(buf_price-list-type)) +  "," .
      615          end.
      616       end.
      617   end.
      618   end.
      619   else do:
      620   define buffer buf_grp-obj-price for ub.grp-obj-price  .
      621   for each buf_price-list-type no-lock where
      622             buf_price-list-type.use-obj  = 1
      623             :
      624             v-par = v-par + string(recid(buf_price-list-type)) +  "," .
      625   end.
      626   for each buf_grp-obj-price no-lock :
      627           empty temp-table x_obj-group.
      628           run metod-gop-obj in this-procedure ( v-cntxt-db-num,  buf_grp-obj-price.gop-id , buf_grp-obj-price.gop-db-num) .
      629           if can-find( first x_obj-group where
      630                     x_obj-group.obj-type = p-obj-type and
      631                     x_obj-group.obj-code = p-obj-code ) then do
      632                     :
      633                     for each buf_price-list-type no-lock where
      634                         buf_price-list-type.use-obj     = 2 and
      635                         buf_price-list-type.gop-id      = buf_grp-obj-price.gop-id and
      636                         buf_price-list-type.gop-db-num  = buf_grp-obj-price.gop-db-num
      637                         :
      638                         v-par = v-par + string(recid(buf_price-list-type)) +  "," .
      639                     end.
      640           end.
      641   end.
      642   end.
      643   run waitfram-hide in this-procedure .
      644   run ref/typepric.w (
      645       input parParentProc     ,
      646       input "mode=plt-id,b-del,b-chg,title=Типы прайс-листов для " + caps(buf_clients.obj-name) + " endtitle" ,
      647       input-output v-par
      648       ) no-error .
