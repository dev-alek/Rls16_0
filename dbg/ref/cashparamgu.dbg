        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   define input parameter p-mode as character no-undo.
        3   define input parameter p-parent as character no-undo.
        4   define input-output parameter p-rid as recid init ? no-undo.
        5   define buffer codeupdate for code .
        6   define variable vss-revision    as character no-undo init "$Revision: $":U .
        7   define variable vss-author      as character no-undo init "$Author: $":U .
        8   define variable vss-date        as character no-undo init "$Date: $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: $":U .
       11   define variable vss-description as character no-undo init "Карточка редактирование групп параметров".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   function is-numeral return logical
      119     (input p-string   as character ,
      120      input char-avail as character) :
      121     define variable p-replace-string as character no-undo .
      122     define variable log-result       as logical  no-undo .
      123     if p-string = ? then
      124       return false .
      125     p-replace-string = p-string.
      126     if lookup ("*", char-avail) > 0 then
      127         p-replace-string = replace (p-replace-string, '*', '9').
      128     if lookup ("digit", char-avail) > 0 then
      129       assign
      130         p-replace-string = replace (p-replace-string, '0', '9')
      131         p-replace-string = replace (p-replace-string, '1', '9')
      132         p-replace-string = replace (p-replace-string, '2', '9')
      133         p-replace-string = replace (p-replace-string, '3', '9')
      134         p-replace-string = replace (p-replace-string, '4', '9')
      135         p-replace-string = replace (p-replace-string, '5', '9')
      136         p-replace-string = replace (p-replace-string, '6', '9')
      137         p-replace-string = replace (p-replace-string, '7', '9')
      138         p-replace-string = replace (p-replace-string, '8', '9')
      139         .
      140     else
      141        p-replace-string = replace (p-replace-string, '9', chr(15))
      142         .
      143     if lookup ("letter", char-avail) > 0 then
      144       assign
      145         p-replace-string = replace (p-replace-string, 'A', '9')
      146         p-replace-string = replace (p-replace-string, 'B', '9')
      147         p-replace-string = replace (p-replace-string, 'C', '9')
      148         p-replace-string = replace (p-replace-string, 'D', '9')
      149         p-replace-string = replace (p-replace-string, 'E', '9')
      150         p-replace-string = replace (p-replace-string, 'F', '9')
      151         p-replace-string = replace (p-replace-string, 'G', '9')
      152         p-replace-string = replace (p-replace-string, 'H', '9')
      153         p-replace-string = replace (p-replace-string, 'I', '9')
      154         p-replace-string = replace (p-replace-string, 'J', '9')
      155         p-replace-string = replace (p-replace-string, 'K', '9')
      156         p-replace-string = replace (p-replace-string, 'L', '9')
      157         p-replace-string = replace (p-replace-string, 'M', '9')
      158         p-replace-string = replace (p-replace-string, 'N', '9')
      159         p-replace-string = replace (p-replace-string, 'O', '9')
      160         p-replace-string = replace (p-replace-string, 'P', '9')
      161         p-replace-string = replace (p-replace-string, 'Q', '9')
      162         p-replace-string = replace (p-replace-string, 'R', '9')
      163         p-replace-string = replace (p-replace-string, 'S', '9')
      164         p-replace-string = replace (p-replace-string, 'T', '9')
      165         p-replace-string = replace (p-replace-string, 'U', '9')
      166         p-replace-string = replace (p-replace-string, 'V', '9')
      167         p-replace-string = replace (p-replace-string, 'W', '9')
      168         p-replace-string = replace (p-replace-string, 'X', '9')
      169         p-replace-string = replace (p-replace-string, 'Y', '9')
      170         p-replace-string = replace (p-replace-string, 'Z', '9')
      171         p-replace-string = replace (p-replace-string, '_', '9')
      172         .
      173     return p-replace-string = fill ('9', length (p-string)).
      174   end.
      175   define variable v-db-num like ub.db.db-num no-undo .
      176   .
      177   DEFINE BUTTON B-Help
      178        LABEL "Помо&щь"
      179        SIZE 10 BY 1
      180        BGCOLOR 8 .
      181   DEFINE BUTTON b-quit AUTO-END-KEY
      182        LABEL "&Отмена"
      183        SIZE 10 BY 1
      184        BGCOLOR 8 .
      185   DEFINE BUTTON B-save AUTO-GO
      186        LABEL "&Ввод"
      187        SIZE 10 BY 1
      188        BGCOLOR 8 .
      189   DEFINE VARIABLE mNAIM AS CHARACTER FORMAT "X(4000)":U
      190        LABEL "Описание группы"
      191        VIEW-AS FILL-IN
      192        SIZE 90 BY 1 NO-UNDO.
      193   DEFINE VARIABLE mcode AS character  FORMAT "x(20)":U
      194        LABEL "Название группы"
      195        VIEW-AS FILL-IN
      196        SIZE 14 BY 1 NO-UNDO.
      197   DEFINE FRAME Dialog-Frame
      198        B-save AT ROW 1 COL 1
      199        b-quit AT ROW 1 COL 11
      200        B-Help AT ROW 1 COL 36
      201        mcode AT ROW 2.5 COL 18 COLON-ALIGNED WIDGET-ID 2
      202        mNAIM AT ROW 5 COL 18 COLON-ALIGNED WIDGET-ID 8
      203        SKIP(0.62)
      204       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      205            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      206            TITLE "Редактирование группы параметров"
      207            DEFAULT-BUTTON B-save CANCEL-BUTTON b-quit.
      208   ASSIGN
      209          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      210          FRAME Dialog-Frame:HIDDEN           = TRUE.
      211   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      212   DO:
      213     APPLY "END-ERROR":U TO SELF.
      214   END.
      215   ON CHOOSE OF B-save IN FRAME Dialog-Frame
      216   DO:
      217     Assign
      218     mcode
      219     mNAIM
      220         .
      221       if mcode = "" then do:
      222         message "Введите название группы ! " view-as  alert-box  error.
      223         apply "entry"  to mcode .
      224         return no-apply.
      225       end.
      226       if not is-numeral (mcode,
      227                      "letter,digit"
      228                      )
      229       then do:
      230         message "Название группы может содержать латинские буквы и цифры! " view-as  alert-box  error.
      231         apply "entry"  to mcode .
      232         return no-apply.
      233       end.
      234       if mNAIM = "" then do:
      235         message "Введите описание ! " view-as  alert-box  error.
      236         apply "entry"  to mNAIM .
      237         return no-apply.
      238       end.
      239       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      240          define buffer buf-code for ub.code.
      241         find first buf-code where buf-code.parent eq p-parent
      242                               and buf-code.code   eq mcode
      243         no-lock no-error.
      244         if available buf-code
      245         then do:
      246            message "Такое название группы уже есть ! " view-as  alert-box  error.
      247            apply "entry"  to mcode .
      248            return no-apply.
      249         end.
      250         create code.
      251       end.
      252       else do:
      253             find first buf-code where buf-code.parent eq p-parent
      254                                   and buf-code.code   eq mcode
      255                                   and recid(buf-code) ne p-rid
      256             no-lock no-error.
      257             if available buf-code
      258             then do:
      259                message "Такое название группы уже есть ! " view-as  alert-box  error.
      260                apply "entry"  to mcode .
      261                return no-apply.
      262             end.
      263       end.
      264       if p-mode = 'ДОБАВЛЕНИЕ':U OR p-mode = 'ИЗМЕНЕНИЕ':U  then
      265          Assign
      266             code.code     = mcode
      267             code.codename = mNAIM
      268             Code.parent   = p-parent
      269             p-rid         = recid(code)
      270             Code.nwsgbd   = yes
      271             .
      272        else p-rid = ? .
      273   END.
      274   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      275   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      276   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      277   on help of frame Dialog-Frame
      278   do:
      279     run gbl/app_help.p
      280       (input this-procedure :file-name
      281       ,input ''
      282       ,input ?
      283       ) no-error.
      284     if error-status :error then do:
      285       message
      286         "Ошибка при вызове помощи"
      287         error-status :get-message(1)
      288         view-as alert-box .
      289     end.
      290   end.
      291   run minbtn-set in this-procedure .
      292   on choose of b-help in frame Dialog-Frame
      293   do:
      294     apply "help":u to frame Dialog-Frame .
      295   end.
      296   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      297   procedure minbtn-set :
      298       do
      299           on error undo, return error return-value
      300           :
      301           define variable ii              as integer       no-undo .
      302           define variable fh              as widget-handle no-undo .
      303           define variable hh              as widget-handle no-undo .
      304           define variable v-h             as handle        extent 4 no-undo .
      305           define variable v-name-button   as character     no-undo .
      306           define variable v-help-old-x    as decimal       no-undo .
      307           define variable v-help-old-y    as decimal       no-undo .
      308           define variable v-help-old-size as decimal       no-undo .
      309           define variable v-frame-width   as decimal       no-undo .
      310           define variable jj              as integer       no-undo .
      311           do
      312               on error undo, return error
      313               :
      314               assign
      315                   v-frame-width = frame Dialog-Frame:width - 0.3
      316                   fh            = frame Dialog-Frame:first-child
      317                   hh            = fh:first-child
      318                   ii            = 1
      319                   .
      320               do while valid-handle(hh):
      321                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      322                   do:
      323                       case lc(hh:name) :
      324                           when "b-help" then
      325                               do:
      326                                   hh:load-image-up("cmp/b-help.bmp":u) .
      327                                   hh:load-image-down("cmp/b-help.bmp":u) .
      328                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      329                                   hh:TOOLTIP = "Помощь" .
      330                                   v-help-old-x = hh:column .
      331                                   v-help-old-y = hh:row    .
      332                                   v-help-old-size = hh:width .
      333                                   hh:width-chars = 2.5 .
      334                               end.
      335                           when "b-print" then
      336                               do:
      337                                   hh:load-image("cmp/b-print.bmp":u) .
      338                                   hh:TOOLTIP = "Печать" .
      339                                   v-h[ii] = hh:handle .
      340                                   ii = ii + 1 .
      341                                   hh:width-chars = 3 .
      342                               end.
      343                           when "b-history" or
      344                           when "b-hist" then
      345                               do:
      346                                   hh:load-image("cmp/b-hist.bmp":u) .
      347                                   hh:TOOLTIP = "История" .
      348                                   v-h[ii] = hh:handle .
      349                                   ii = ii + 1 .
      350                                   hh:width-chars = 3 .
      351                               end.
      352                           when "b-sch" then
      353                               do:
      354                                   hh:load-image("cmp/b-sch.bmp":u) .
      355                                   hh:TOOLTIP = "Установка Фильтра" .
      356                                   v-h[ii] = hh:handle .
      357                                   ii = ii + 1 .
      358                                   hh:width-chars = 3 .
      359                               end.
      360                           when "b-hist-user" then
      361                               do:
      362                                   hh:load-image("cmp/b-hist.bmp":u) .
      363                                   hh:TOOLTIP = "История пользователя" .
      364                                   ii = ii + 1 .
      365                               end.
      366                       end case.
      367                   end.
      368                   hh = hh:next-sibling.
      369               end.
      370               b-help:column = v-frame-width - b-help:width-chars.
      371               jj = 0.
      372               repeat ii = 4 to 1 by -1 :
      373                   if valid-handle (v-h[ii] ) then
      374                   do:
      375                       jj  = jj + 1 .
      376                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      377                       v-h[ii]:row    = v-help-old-y .
      378                   end.
      379               end.
      380           end.
      381       end.
      382   end procedure.
      383   MAIN-BLOCK:
      384   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      385      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      386      if p-mode <> 'ДОБАВЛЕНИЕ':U and
      387         p-mode <> 'ИЗМЕНЕНИЕ':U
      388      then do:
      389         message
      390         vss-workfile vss-revision vss-description skip
      391         "Неверное значение параметров вызова p-mode"  p-mode
      392         view-as alert-box ERROR.
      393         undo, return error.
      394      end.
      395   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      397     (output v-db-num
      398     )  .
      399      if v-db-num <> 0 then do:
      400         message
      401         vss-workfile vss-revision vss-description skip
      402         "Неверное значение параметров вызова p-mode - нельзя изменять/добавлять записи группы в УБД"
      403         view-as alert-box ERROR.
      404         undo, return error.
      405      end.
      406      if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      407         find first code where
      408                    recid(code) = p-rid exclusive-lock no-wait no-error.
      409         if locked code then do:
      410            message
      411               vss-workfile vss-revision vss-description skip
      412               "Группа параметров занята"
      413            view-as alert-box error .
      414            undo, return error.
      415         end.
      416         if not available code then do:
      417            message
      418               vss-workfile vss-revision vss-description skip
      419               "Не найдена группа параметров"
      420            view-as alert-box error .
      421            undo, return error.
      422         end.
      423         assign
      424            mcode = code.code
      425            mNAIM = Code.CodeName
      426         .
      427      end.
      428      run enable_UI in this-procedure .
      429      if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      430         ENABLE mcode WITH FRAME Dialog-Frame.
      431         apply "entry" to mcode in FRAME Dialog-Frame.
      432      end.
      433      WAIT-FOR GO OF FRAME Dialog-Frame.
      434   END.
      435   session:data-entry-return = no .
      436   RUN disable_UI.
      437   PROCEDURE disable_UI :
      438     HIDE FRAME Dialog-Frame.
      439   END PROCEDURE.
      440   PROCEDURE enable_UI :
      441     DISPLAY mcode mNAIM
      442         WITH FRAME Dialog-Frame.
      443     ENABLE B-save b-quit B-Help mNAIM
      444         WITH FRAME Dialog-Frame.
      445     VIEW FRAME Dialog-Frame.
      446     if p-mode = 'ДОБАВЛЕНИЕ':U
      447     then ENABLE  mcode
      448         WITH FRAME Dialog-Frame.
      449     VIEW FRAME Dialog-Frame.
      450   END PROCEDURE.
