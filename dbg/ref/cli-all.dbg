     2865                  input parparentproc
     2866                 ,input v-cntxt-host-code-obj
     2867                 ,input v-cntxt-obj-type
     2868                 ,input v-cntxt-obj-code
     2869                 ,input v-list-mode
     2870                 ,input ?
     2871                 ,input ?
     2872                 ,input ?
     2873                 ,input ?
     2874                 ,input '':U
     2875                 ,input '':U
     2876                 ,input ?
     2877                 ,input recid(X_clients)
     2878                 ,output loc-ref-list
     2879                 ) no-error .
     2880                 if error-status :error then message
     2881                   vss-workfile vss-revision vss-description skip
     2882                   error-status :get-message(1) skip
     2883                   return-value skip
