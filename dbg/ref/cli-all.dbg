        1   DEFINE NEW SHARED BUFFER X_clients FOR ub.clients.
        2   DEFINE NEW SHARED BUFFER X_clients-attr FOR ub.clients-attr.
        3   DEFINE NEW SHARED BUFFER X_firm FOR ub.firm.
        4   DEFINE NEW SHARED BUFFER X_person FOR ub.person.
        5   DEFINE NEW SHARED BUFFER X_shop FOR ub.shop.
        6   DEFINE NEW SHARED BUFFER X_store FOR ub.store.
        7   define new shared buffer X_contract-attr for ub.contract-attr .
        8   define new shared buffer X_contractr for ub.contract .
        9   define input parameter parparentproc  as widget-handle no-undo.
       10   define input parameter p-bttns     as   character no-undo.
       11   define input parameter c-types     as character no-undo .
       12   define input parameter c-group    like ub.clients.grp-name no-undo .
       13   define input parameter c-status   as character no-undo .
       14   define input parameter c-recid    as recid no-undo .
       15   define input parameter c-added    as character no-undo .
       16   define input parameter c-other    as character no-undo .
       17   define output parameter  p-rid-list    as  character no-undo .
       18   define variable vss-revision    as character no-undo init "$Revision$":u .
       19   define variable vss-author      as character no-undo init "$Author$":u .
       20   define variable vss-date        as character no-undo init "$Date$":u .
       21   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       22   define variable vss-archive     as character no-undo init "$Archive$":u .
       23   define variable vss-description as character no-undo init "Список клиентов" .
       24   procedure vss-get-info :
       25     define output parameter p-vss-revision    like vss-revision    no-undo .
       26     define output parameter p-vss-author      like vss-author      no-undo .
       27     define output parameter p-vss-date        like vss-date        no-undo .
       28     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       29     define output parameter p-vss-archive     like vss-archive     no-undo .
       30     define output parameter p-vss-description like vss-description no-undo .
       31     assign
       32       p-vss-revision    = vss-revision
       33       p-vss-author      = vss-author
       34       p-vss-date        = vss-date
       35       p-vss-workfile    = vss-workfile
       36       p-vss-archive     = vss-archive
       37       p-vss-description = vss-description
       38     .
       39   end procedure.
       40   procedure vss-get-parameters :
       41     define output parameter p-vss-parameters as character no-undo .
       42       assign
       43         p-vss-parameters = substitute('&1|&2|&3|&4|&5|&6|&7|&8':u,parparentproc,p-bttns,c-types,c-group,c-status,c-recid,c-added,c-other)
       44       .
       45   end procedure.
       46   define new global shared variable g#vssrevis-logger as handle    no-undo .
       47   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       48   define variable v-vssrevis-logger                   as handle    no-undo .
       49   procedure vss-logevent :
       50     define input  parameter p-extra-paramters as character no-undo .
       51     define variable v-vssrevis-parameters as character no-undo .
       52     do
       53     on error undo, return error return-value
       54     :
       55       if  valid-handle(v-vssrevis-logger)
       56       and v-vssrevis-logger :get-signature("logevent") <> ""
       57       then do:
       58         run vss-get-parameters in this-procedure
       59           (output v-vssrevis-parameters
       60           ).
       61         run logevent in v-vssrevis-logger
       62           (input vss-workfile
       63           ,input vss-revision
       64           ,input v-vssrevis-parameters
       65           ,input p-extra-paramters
       66           ).
       67       end.
       68     end.
       69   end procedure.
       70   assign
       71     v-vssrevis-logger = g#vssrevis-logger
       72   .
       73   if  valid-handle(v-vssrevis-logger)
       74   and v-vssrevis-logger :get-signature("logevent") <> ""
       75   then do:
       76     assign
       77       v-vssrevis-logevent = true
       78     .
       79     run vss-logevent in this-procedure (input vss-description) .
       80   end.
       81   define new global shared variable g#language as character no-undo .
       82   if g#language <> '' and g#language <> 'rus':U then do:
       83     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       84   end.
       85   define new global shared variable g#library  as handle no-undo .
       86   define new global shared variable g#library2 as handle no-undo .
       87   procedure proc-alt-shift-f2:
       88     if not ibs.th.gbl.gbl-var:rcode
       89   then
       90     run gbl\inidebug.p .
       91   end.
       92   procedure proc-alt-shift-f3:
       93     run gbl/prvssinf.p
       94       ( input this-procedure
       95       ) .
       96   end.
       97   define variable v-inform-launched as logical no-undo initial false .
       98   procedure proc-alt-shift-f4:
       99     define variable v-action as character no-undo .
      100     if v-inform-launched = false then do:
      101       assign
      102         v-inform-launched = true
      103       .
      104       run gbl/d-inform.w
      105         (  input self
      106         ,  input this-procedure
      107         , output v-action
      108         ) no-error .
      109       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      110       assign
      111         v-inform-launched = false
      112       .
      113     end.
      114   end.
      115   procedure proc-alt-f1:
      116     run gbl/corrhelp.p
      117       (input this-procedure
      118       ) .
      119   end .
      120   on alt-shift-f2 anywhere do:
      121     run proc-alt-shift-f2.
      122   end.
      123   on alt-shift-f3 anywhere do:
      124     run proc-alt-shift-f3 in this-procedure .
      125   end.
      126   on alt-shift-f4 anywhere do:
      127     run proc-alt-shift-f4 in this-procedure.
      128   end.
      129   on alt-f1 anywhere do:
