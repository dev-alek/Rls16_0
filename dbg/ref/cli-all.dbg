     2540   ON CHOOSE OF B-attr IN FRAME Dialog-Frame
     2541   DO:
     2542    define variable v-updated as logical no-undo .
     2543    define variable v-is-error as logical no-undo .
     2544    define variable ri as recid no-undo  .
     2545     if not available X_clients then do:
     2546           return no-apply.
     2547     end.
     2548     ri = recid(X_clients).
     2549     if attr-option = "":U then do:
     2550       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     2551       if error-status :error then do: return no-apply. end.
     2552     end.
     2553     if attr-option = "":U then do:
     2554         return no-apply.
     2555     end.
     2556     if attr-option = 'ПРОСМОТР':U
     2557     then do :
     2558       g#log = NO.
     2559     end .
     2560     else do :
     2561       CASE X_clients.obj-type :
     2562         when 'орг':U
     2563         then do:
     2564   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2565   do:
     2566     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2567       (input  v-cntxt-db-num
     2568       ,input  v-cntxt-userid
     2569       ,input  0
     2570       ,input  'actn_client-reference_add-del':U
     2571       ,input  'global':U
     2572       ,input  0
     2573       ,input  '':U
     2574       ,input  0
     2575       ,input  0
     2576       ,input  0
     2577       ,input  0
     2578       ,input  true
     2579       ,output g#log
     2580       )  .
     2581   end.
     2582         end.
     2583         when 'чел':U
     2584         then do:
     2585   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2586   do:
     2587     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2588       (input  v-cntxt-db-num
     2589       ,input  v-cntxt-userid
     2590       ,input  0
     2591       ,input  'actn_client-reference-prs_add-del':U
     2592       ,input  'global':U
     2593       ,input  0
     2594       ,input  '':U
     2595       ,input  0
     2596       ,input  0
     2597       ,input  0
     2598       ,input  0
     2599       ,input  true
     2600       ,output g#log
     2601       )  .
     2602   end.
     2603         end.
     2604         WHEN 'маг':U OR WHEN 'скл':U THEN DO:
     2605             g#log = NO.
     2606         END.
     2607       END CASE.
     2608     end .
     2609     run ref/ca-attrr.p (
     2610                       input parparentproc
     2611                      ,input (if  NOT can-do( 'удаленные':U , Cli-Status )
     2612                             then (if can-do( p-bttns, "b-add")
     2613                                  AND attr-option = 'ИЗМЕНЕНИЕ':U
     2614                                  AND g#log
     2615                                  then 'ИЗМЕНЕНИЕ':U
     2616                                  else 'ПРОСМОТР':U)
     2617                             else 'ПРОСМОТР':U
     2618                           )
     2619                      ,input X_clients.obj-type
     2620                      ,input X_clients.obj-code
     2621                      ,input yes
     2622                      ,output v-updated
     2623                      ,output v-is-error
     2624                      ) no-error.
     2625     if error-status:error
     2626     or v-is-error then do:
     2627       message
     2628       "Ошибка при вызове списка атрибутов клиента" skip
     2629       error-status:get-message(1) skip
     2630       return-value
     2631       view-as alert-box .
     2632       assign
     2633       attr-option = "":U
     2634       .
     2635       undo, return no-apply.
     2636     end.
     2637     if attr-option = 'ИЗМЕНЕНИЕ':U and v-updated then do:
     2638      if find-by = 'название':U then do:
     2639         apply "RETURN" to Nameorcode.
     2640       end.
     2641       else do:
     2642         assign
     2643         find-by = 'все':U
     2644         getc-recid = yes
     2645         .
     2646         display
     2647         find-by
     2648         with frame Dialog-Frame .
     2649         run proc-vc-find-by in this-procedure ( input no) no-error.
     2650         if (X_clients.obj-type = 'чел':U
     2651                   or X_clients.obj-type = 'орг':U
     2652                 )
     2653               AND ri <> ? then do:
     2654           case var-br-name :         when "cli-list":U then do:            Run OpenBR in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listA":U then do:            Run OpenBRA in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listB":U then do:            Run OpenBRB in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         end case.
     2655           case var-br-name :         when "cli-list":U then do:            reposition Cli-List to recid ri no-error .         end.         when "cli-listA":U then do:            reposition Cli-ListA to recid ri no-error .         end.         when "cli-listB":U then do:            reposition Cli-ListB to recid ri no-error .          end.         end case.
     2656           if error-status:error then do:
     2657                     find first pos_clients no-lock where       recid( pos_clients ) = ri no-error .   message  substitute("Невозможно позиционироваться на клиенте &1&2Клиент был добавлен (или изменен или удален)&2и теперь не попадает в текущую выборку"             ,(if available pos_clients then (pos_clients.obj-type + string(pos_clients.obj-code)) else '':U)              , chr(10)) view-as alert-box WARNING.
     2658           end.
     2659         end.
     2660       end.
     2661     end.
     2662     attr-option = "":U.
     2663     case var-br-name :         when "cli-list":U then do:            apply "entry" to Cli-List in frame Dialog-Frame.         end.         when "cli-listA":U then do:            apply "entry" to Cli-ListA in frame Dialog-Frame.         end.         when "cli-listB":U then do:            apply "entry" to Cli-ListB in frame Dialog-Frame.         end.         end case.
     2664   END.
     2665   ON CHOOSE OF B-bank IN FRAME Dialog-Frame
