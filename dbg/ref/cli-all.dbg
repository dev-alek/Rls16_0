     6765         if  entry(1, entry(ii, c-other, ";":U), "=":U) = "tank-farm-for-supp":U then do :
     6766           if entry(2, entry(ii, c-other, ";":U), "=":U) <> "":U
     6767           then do:
     6768             v-tank-farm-for-supp = entry(2, entry(ii, c-other, ";":U), "=":U).
     6769             do jj = 1 to num-entries(v-tank-farm-for-supp) :
     6770               v-str = entry(jj,v-tank-farm-for-supp).
     6771               for each X_clients-attr no-lock where X_clients-attr.attr-code = 'tank-farm-for':U
     6772                                                 and X_clients-attr.attr-value = v-str :
     6773                 if not can-find (first x_temp-list-buyer where x_temp-list-buyer.obj-type = X_clients-attr.obj-type
     6774                                                             and x_temp-list-buyer.obj-code = X_clients-attr.obj-code)
     6775                 then do :
     6776                   create x_temp-list-buyer.
     6777                   assign
     6778                     x_temp-list-buyer.obj-type = X_clients-attr.obj-type
     6779                     x_temp-list-buyer.obj-code = X_clients-attr.obj-code
     6780                   .
     6781                 end.
     6782               end.
     6783             end .
     6784           end.
     6785           else do :
     6786             for each X_clients-attr no-lock where X_clients-attr.attr-code = 'tank-farm-for':U
     6787                                               and X_clients-attr.attr-value > "" :
     6788               if not can-find (first x_temp-list-buyer where x_temp-list-buyer.obj-type = X_clients-attr.obj-type
     6789                                                           and x_temp-list-buyer.obj-code = X_clients-attr.obj-code)
     6790               then do :
     6791                 create x_temp-list-buyer.
     6792                 assign
     6793                   x_temp-list-buyer.obj-type = X_clients-attr.obj-type
     6794                   x_temp-list-buyer.obj-code = X_clients-attr.obj-code
     6795                 .
     6796               end.
     6797             end.
     6798           end .
     6799         end.
     6800         if entry(1, entry(ii, c-other, ";":U), "=":U) = "contract-edi_orders":U then do:
     6801           for each x_temp-list-buyer :
     6802             delete x_temp-list-buyer.
     6803           end.
     6804           for each X_contract-attr no-lock where X_contract-attr.attr-code = "contract-edi_orders" and
     6805           X_contract-attr.host-code = v-cntxt-host-code-obj and
     6806           X_contract-attr.attr-value = string(true):
     6807               for first X_contractr no-lock where
     6808                         X_contractr.contract-code = X_contract-attr.contract-code
     6809                     and X_contractr.host-code = X_contract-attr.host-code
     6810                     and X_contractr.doc-type = 'при':U
     6811                     and X_contractr.status_ = 'тек':U
     6812                     and (X_contractr.contract-date-end >= today or X_contractr.contract-date-end = ?)
     6813                     and X_contractr.contract-date-beg <= today
     6814                 :
     6815                 if not can-find (first x_temp-list-buyer where x_temp-list-buyer.obj-type = X_contractr.cli-type
     6816                                                            and x_temp-list-buyer.obj-code = X_contractr.cli-code)
     6817                 then do :
