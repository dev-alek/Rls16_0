     6848   end.
     6849   if v-other begins "tank-farm-for" or v-other begins "auto-tank-for" or v-other begins "supp-np" or v-other begins "supp-lgas" or v-other begins "contract-edi_orders" then v-other = "".
     6850   if c-types = 'про':U then do :
     6851     c-types = ? .
     6852     v-is-prod = true.
     6853   end.
     6854   assign
     6855   c-types  =  (if c-types = ? then v-types else c-types)
     6856   c-group  =  (if c-group = ? then v-group else c-group)
     6857   c-status =  (if c-status = ? then v-status else c-status)
     6858   c-recid  =  (if c-recid = ? then v-recid else c-recid)
     6859   c-added  =  (if c-added = ? then v-added else c-added)
     6860   c-other  =  (if c-other = ? then v-other else c-other)
     6861   .
     6862   DISABLE
     6863   b-Photo
     6864   b-sel   when (lookup("b-sel", p-bttns) = 0)
     6865   b-add   when (lookup("b-add", p-bttns) = 0)
     6866   b-add-prs   when (lookup("b-add", p-bttns) = 0)
     6867   b-chg   when (lookup("b-add", p-bttns) = 0)
     6868   b-grp   when (lookup("b-add", p-bttns) = 0)
     6869   b-sert  when ((lookup("b-add", p-bttns) = 0) and v-cntxt-db-num <> 0)
     6870   b-del   when (lookup("b-add", p-bttns) = 0)
     6871   b-bank  when (lookup("b-bank", p-bttns) = 0)
     6872   b-mark  when (lookup("b-mark", p-bttns) = 0)
     6873   cli-types when v-lock-cli-type
     6874   b-edi     when not is-edi
     6875   b-cont    when not is-fin
     6876   b-price-type   when not is-price-buyer
     6877   WITH FRAME Dialog-Frame.
     6878   CASE entry( 1, c-added ) :
     6879           when "yes" then
     6880               SupGds = yes .
     6881           when "no" OR when "" then
     6882               SupGds = no .
     6883           when "?" then
     6884               SupGds = ? .
     6885   END CASE .
     6886   CASE entry( 2, c-added ) :
     6887           when "yes" then
     6888               SupCons = yes .
     6889           when "no" OR when "" then
     6890               SupCons = no .
     6891           when "?" then
     6892               SupCons = ? .
     6893   END CASE .
     6894   CASE entry( 3, c-added ) :
     6895           when "yes" then
     6896               SupServ = yes .
     6897           when "no" OR when "" then
     6898               SupServ = no .
     6899           when "?" then
     6900               SupServ = ? .
     6901   END CASE .
     6902   CASE entry( 4, c-added ) :
     6903           when "yes" then
     6904               BuyGds = yes .
     6905           when "no" OR when "" then
     6906               BuyGds = no .
     6907           when "?" then
     6908               BuyGds = ? .
     6909   END CASE .
     6910   CASE entry( 5, c-added ) :
     6911           when "yes" then
     6912               BuyCons = yes .
     6913           when "no" OR when "" then
     6914               BuyCons = no .
     6915           when "?" then
     6916               BuyCons = ? .
     6917   END CASE .
     6918   CASE entry( 6, c-added ) :
     6919           when "yes" then
     6920               BuyServ = yes .
     6921           when "no" OR when "" then
     6922               BuyServ = no .
     6923           when "?" then
     6924               BuyServ = ? .
     6925   END CASE .
     6926   list-buf = entry( 9, c-added ) NO-ERROR .
     6927   if error-status:error OR ( list-buf = "yes" ) then
     6928       WLim-kr = TRUE .
     6929   else
     6930       WLim-kr = FALSE .
     6931   assign
     6932   JoinType = entry( 7, c-added )
     6933   All-Or-Group = if num-entries(c-group, chr(3)) > 1
     6934                  then entry(1, c-group, chr(3))
     6935                  else 'все':U
     6936   Curr-Grp-Name = if num-entries(c-group, chr(3)) > 1
     6937                   then entry(2, c-group, chr(3))
     6938                   else ""
     6939   attr-option_ = (if all-or-group = 'АТР':U
     6940                   and num-entries(c-group, chr(3)) > 1
     6941                   and entry(2, c-group, chr(3)) <> "":U
     6942                   then entry(2, c-group, chr(3))
     6943                   else "")
     6944   Cli-Status = c-status
     6945   Cli-Types = c-types
     6946   All-Suppliers = ( SupGds OR SupCons OR SupServ )
     6947   All-Buyers = ( BuyGds OR BuyCons OR BuyServ ) .
     6948   do ii = 1 to num-entries(c-other, ";":U):
     6949     if entry(1, entry(ii, c-other, ";":U), "=":U) = "auto-tank-for":U or entry(1, entry(ii, c-other, ";":U), "=":U) = "tank-farm-for":U  then do :
     6950       if entry(2, entry(ii, c-other, ";":U), "=":U) = "":U then v-rid-list = "".
     6951     end.
     6952     else do :
     6953       v-total-select-num = num-entries(v-rid-list).
     6954     end.
     6955   end.
     6956   DISPLAY
     6957   All-Or-Group
     6958   Cli-Status
     6959   Cli-Types
     6960   WITH FRAME Dialog-Frame .
     6961   case cli-types:
     6962     when 'маг':U
     6963     or when 'скл':U
     6964     or when 'объект':U
     6965     then do:
     6966       assign
     6967       X_clients.db-num:visible in browse cli-list = yes
     6968       X_clients.host-code:visible in browse cli-list = yes
     6969       X_clients.db-num:visible in browse cli-lista = yes
     6970       X_clients.host-code:visible in browse cli-lista = yes
     6971       X_clients.db-num:visible in browse cli-listb = yes
     6972       X_clients.host-code:visible in browse cli-listb = yes
     6973       .
     6974     end.
     6975     when "db" then do:
     6976       assign
     6977       X_clients.db-num:visible in browse cli-list = no
     6978       X_clients.host-code:visible in browse cli-list = yes
     6979       X_clients.db-num:visible in browse cli-lista = no
     6980       X_clients.host-code:visible in browse cli-lista = yes
     6981       X_clients.db-num:visible in browse cli-listb = no
     6982       X_clients.host-code:visible in browse cli-listb = yes
     6983       .
     6984     end.
     6985     otherwise do:
     6986       assign
     6987       X_clients.db-num:visible in browse cli-list = no
     6988       X_clients.host-code:visible in browse cli-list = no
     6989       X_clients.db-num:visible in browse cli-lista = no
     6990       X_clients.host-code:visible in browse cli-lista = no
     6991       X_clients.db-num:visible in browse cli-listb = no
     6992       X_clients.host-code:visible in browse cli-listb = no
     6993       .
     6994     end.
     6995   end case.
     6996   if attr-option_ = "":U then do:
     6997       HIDE
     6998       cli-listA
     6999       in frame Dialog-Frame.
     7000   end.
     7001   else do:
     7002       HIDE
     7003       cli-list
     7004       in frame Dialog-Frame.
     7005   end.
     7006   if v-total-select-num = 0 then do:
     7007     HIDE
     7008     mark-num
     7009     in frame Dialog-Frame .
     7010   end.
     7011   HIDE
     7012   NameOrCode
     7013   in frame Dialog-Frame .
     7014   if attr-option_ = "":U then do:
     7015     var-prev-br-name = var-br-name.
     7016     var-Br-Name = "cli-list":U.
     7017   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7018   do:
     7019     cli-list :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     7020   end.
     7021   end.
     7022   else do:
     7023     var-prev-br-name = var-br-name.
     7024     var-Br-Name = "cli-listA":U.
     7025   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7026   do:
     7027     cli-listA :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     7028   end.
     7029   end.
     7030   if entry(1,c-other,"=":U) = "supp-lgas"
     7031   or entry(1,c-other,"=":U) = "supp-np"
     7032   or entry(1,c-other,"=":U) = "supp-np-lgas"
     7033   or entry(1,c-other,"=":U) = "auto-tank-for-supp"
     7034   or entry(1,c-other,"=":U) = "tank-farm-for-supp"
     7035   or entry(1,c-other,"=":U) = "contract-edi_orders"
     7036   then do :
     7037     HIDE
     7038     CLi-list in frame Dialog-Frame
     7039     CLi-listA
     7040     in frame Dialog-Frame.
     7041     enable Del-Filters
     7042     with frame Dialog-Frame .
     7043     g-log = ALL-Or-GROUP:disable ( radio-label ( 'АТР':U, ALL-Or-GROUP:radio-buttons) ).
     7044     var-prev-br-name = var-br-name.
     7045     var-Br-Name = "cli-listB":U.
     7046     v-list-b = true .
     7047   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7048   do:
     7049     cli-listB :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     7050   end.
     7051   end.
     7052   case var-br-name :         when "cli-list":U then do:            Run OpenBR in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listA":U then do:            Run OpenBRA in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listB":U then do:            Run OpenBRB in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         end case.
     7053   END PROCEDURE.
     7054   PROCEDURE Switch-Buttons :
     7055   define input  parameter p-needmes as logical no-undo .
     7056   define variable titleStr as character no-undo.
     7057   titleStr = "Клиенты".
     7058   if session :set-wait-state( "compiler" ) then.
     7059   VIEW
     7060   b-add in frame Dialog-Frame
     7061   b-add-prs in frame Dialog-Frame
     7062   b-bank b-del b-grp b-mark b-sel b-chg
     7063   b-Docs Goods-By-Prod b-Hist b-Photo b-Print b-lkp b-help b-dc b-attr b-cont
     7064   in frame Dialog-Frame .
     7065   if p-NeedMes then
     7066   run waitfram-show in this-procedure (  input "Подождите : таблица ОБНОВЛЯЕТСЯ." ) .
     7067   assign frame Dialog-Frame
     7068   All-Or-Group Cli-Types Cli-Status Find-By
     7069   .
     7070   CASE Cli-Types :
     7071       when 'все':U then
     7072           TitleStr = "Все клиенты " .
     7073       when 'орг':U then
     7074           TitleStr = "Все организации  " .
     7075       when 'чел':U then
     7076           TitleStr = "Все физич. лица " .
     7077       when 'скл':U then
     7078           TitleStr = "Все склады " .
     7079       when 'маг':U then
     7080           TitleStr = "Все магазины " .
     7081       when 'объект':U then
     7082           TitleStr = "Все объекты " .
     7083       when "db" then
     7084           TitleStr = "Все объекты текущей БД" .
     7085   END CASE .
     7086   if v-is-prod then TitleStr = "Все производители" .
     7087   if can-do( 'группа':U , All-Or-Group ) then
     7088       TitleStr = TitleStr + "группы " + substr( Curr-Grp-Name, 1, 40 ) + chr(32).
     7089   if can-do( 'АТР':U , All-Or-Group ) then
     7090       TitleStr = TitleStr + "Атрибут " + attr-option_.
     7091   CASE Cli-Status :
     7092       when 'текущие':U then
     7093           TitleStr = TitleStr + "( текущие )" .
     7094       when 'удаленные':U then
     7095           TitleStr = TitleStr + "( удаленные )" .
     7096   END CASE .
     7097   if JoinType <> "NO" then
     7098       TitleStr = TitleStr + ". С доп. фильтром." .
     7099   if entry(1,c-other,"=":U) = "supp-np"
     7100   then TitleStr = TitleStr + chr(32) + "Поставщики НП" .
     7101   else
     7102   if entry(1,c-other,"=":U) = "supp-lgas"
     7103   then TitleStr = TitleStr + chr(32) + "Поставщики СУГ" .
     7104   else
     7105   if entry(1,c-other,"=":U) = "contract-edi_orders"
     7106   then TitleStr = TitleStr + chr(32) + "Поставщики с контрактом EDI" .
     7107   else
     7108   if entry(1,c-other,"=":U) = "supp-np-lgas"
     7109   then TitleStr = TitleStr + chr(32) + "Поставщики НП и СУГ" .
     7110   if entry(1,c-other,"=":U) = "auto-tank-for-supp"
     7111   then TitleStr = TitleStr + chr(32) + "Является перевозчиком для:" + v-auto-tank-for-supp .
     7112   if entry(1,c-other,"=":U) = "tank-farm-for-supp"
     7113   then TitleStr = TitleStr + chr(32) + "Является нефтебазой/ГНС для:" + v-tank-farm-for-supp.
     7114   frame Dialog-Frame:title = TitleStr .
     7115   show-as = Cli-Types + "-" + Find-By + "-" + All-Or-Group + "-" + Cli-Status .
     7116   if ub.db.add-clients   AND NOT TRANSACTION then do:
     7117    ENABLE
     7118    b-add   when can-do( p-bttns, "b-add")
     7119    b-add-prs   when can-do( p-bttns, "b-add")
     7120    b-chg   when can-do( p-bttns, "b-add")
     7121    b-grp   when can-do( p-bttns, "b-add")
     7122    b-del   when can-do( p-bttns, "b-add")
     7123    b-attr  when can-do( p-bttns, "b-add")
     7124    WITH FRAME Dialog-Frame .
     7125    end.
     7126   else do:
     7127    DISABLE
     7128    b-add
     7129    b-add-prs
     7130    b-chg
     7131    b-grp
     7132    b-del
     7133    b-attr
     7134    WITH FRAME Dialog-Frame .
     7135   end.
     7136   if db.add-clients AND
     7137   ( NOT can-do( 'удаленные':U , Cli-Status ) ) AND
     7138   can-do( "NO", JoinType ) AND NOT TRANSACTION then do:
     7139    ENABLE
     7140    b-chg   when can-do( p-bttns, "b-add")
     7141    b-grp   when can-do( p-bttns, "b-add") AND not can-do( 'группа':U , Cli-Types )
     7142    WITH FRAME Dialog-Frame .
     7143    if lookup("b-add", p-bttns) > 0 then menu-item m_update-attr:sensitive in menu menu-b-attr = yes .
     7144   end.
     7145   else do:
     7146    DISABLE
     7147    b-chg
     7148    b-grp
     7149    WITH FRAME Dialog-Frame .
     7150    menu-item m_update-attr:sensitive in menu menu-b-attr = no .
     7151   end.
     7152   if NOT TRANSACTION
     7153   then do:
     7154       ENABLE
     7155       b-attr
     7156       WITH FRAME Dialog-Frame .
     7157   end.
     7158   else do:
     7159       DISABLE
     7160       b-attr
     7161       WITH FRAME Dialog-Frame .
     7162   end.
     7163   if v-without-obj and not v-s-deploy then do:
     7164     DISABLE
     7165     b-dc
     7166     b-del
     7167     b-docs
     7168     b-grp
     7169     b-sert
     7170     b-zak
     7171     goods-by-prod
     7172     b-edi
     7173     WITH FRAME Dialog-Frame.
     7174     assign
     7175     b-bank:label = "&Счета".
     7176   end.
     7177   if v-s-deploy or v-is-news then do:
     7178     DISABLE
     7179     b-add-prs
     7180     b-dc
     7181     b-del
     7182     b-docs
     7183     b-sert
     7184     b-zak
     7185     goods-by-prod
     7186     b-edi
     7187     b-sch
     7188     b-attr
     7189     all-or-group
     7190     b-bank
     7191     b-cont
     7192     WITH FRAME Dialog-Frame.
     7193   end.
     7194   END PROCEDURE.
     7195   procedure proc-find-inn:
     7196   define input parameter par-inn as character no-undo.
     7197   define output parameter par-recid as recid no-undo.
     7198   define buffer b_clients for ub.clients.
     7199   define buffer b_firm for ub.firm.
     7200   if v-last-inn-rec <> ? then do:
     7201       find first b_firm no-lock
     7202           where recid(b_firm) = v-last-inn-rec
     7203           no-error.
     7204       if not available b_firm then do:
     7205           v-last-inn-rec = ?.
     7206           par-recid = ?.
     7207           return.
     7208       end.
     7209       find next b_firm no-lock
     7210           where b_firm.inn = par-inn
     7211           no-error.
     7212       if not available b_firm then do:
     7213           find first b_firm no-lock
     7214               where b_firm.inn = par-inn
     7215               no-error.
     7216           find first b_clients no-lock
     7217               where b_clients.obj-code = b_firm.firm-code
     7218               and b_clients.obj-type = 'орг':U
     7219               no-error.
     7220           v-last-inn-rec = recid(b_firm).
     7221           par-recid = recid(b_clients).
     7222       end.
     7223   end.
     7224   else do:
     7225       find first b_firm no-lock
     7226           where b_firm.inn = par-inn
     7227           no-error.
     7228       if not available b_firm then do:
     7229           v-last-inn-rec = ?.
     7230           par-recid = ?.
     7231           return.
     7232       end.
     7233   end.
     7234   find first b_clients no-lock
     7235       where b_clients.obj-type = 'орг':U
     7236       and b_clients.obj-code = b_firm.firm-code
     7237       no-error.
     7238   if not available b_clients then do:
     7239       v-last-inn-rec = ?.
     7240       par-recid = ?.
     7241       return.
     7242   end.
     7243   par-recid = recid(b_clients).
     7244   v-last-inn-rec = recid(b_firm).
     7245   end procedure.
     7246   FUNCTION get-client RETURNS CHARACTER
     7247     (buffer loc_clients for clients  ) :
     7248   define variable var-cli-name as character no-undo.
     7249   define buffer buf_dis-card             for ub.dis-card.
     7250   define buffer buf_buyer-in-buyer-group for ub.buyer-in-buyer-group  .
     7251   define buffer buf_buyer-group          for ub.buyer-group  .
     7252   var-cli-name = (IF (loc_clients.stts = 0)
     7253                          THEN (loc_clients.obj-name)
     7254                          ELSE (substring (
     7255                                                   loc_clients.obj-name, 1, 25) +
     7256                                                   FILL (" " , 25 - LENGTH (substring (loc_clients.obj-name, 1, 25)) )) +
     7257                                                   '---  УДАЛЕН  ---':U
     7258                                    ).
     7259       FIND buf_dis-card WHERE
     7260            buf_dis-card.cli-type = X_clients.obj-type AND
     7261            buf_dis-card.cli-code = X_clients.obj-code NO-LOCK NO-ERROR .
     7262       if available buf_dis-card then
     7263           assign
     7264               cli-dcard = buf_dis-card.d-card
     7265               cli-dpcnt = buf_dis-card.d-pcnt .
     7266       else
     7267           assign
     7268               cli-dcard = ""
     7269               cli-dpcnt = 0 .
     7270   RETURN var-cli-name.
     7271   END FUNCTION.
     7272   FUNCTION mark-string RETURNS CHARACTER
     7273     ( buffer loc_clients for clients, input mark-list as character ) :
     7274   define buffer buf_dis-card for ub.dis-card.
     7275   define buffer buf_buyer-in-buyer-group for ub.buyer-in-buyer-group  .
     7276   define buffer buf_buyer-group          for ub.buyer-group  .
     7277   define variable v-mark-string as character no-undo .
     7278   var-cli-name = (IF (loc_clients.stts = 0)
     7279                          THEN (loc_clients.obj-name)
     7280                          ELSE (substring (
     7281                                                   loc_clients.obj-name, 1, 25) +
     7282                                                   FILL (" " , 25 - LENGTH (substring (loc_clients.obj-name, 1, 25)) )) +
     7283                                                   '---  УДАЛЕН  ---':U
     7284                                    ).
     7285       FIND buf_dis-card WHERE
     7286            buf_dis-card.cli-type = X_clients.obj-type AND
     7287            buf_dis-card.cli-code = X_clients.obj-code NO-LOCK NO-ERROR .
     7288       if available buf_dis-card then
     7289           assign
     7290               cli-dcard = buf_dis-card.d-card
     7291               cli-dpcnt = buf_dis-card.d-pcnt .
     7292       else
     7293           assign
     7294               cli-dcard = ""
     7295               cli-dpcnt = 0 .
     7296       find first buf_buyer-in-buyer-group no-lock where
     7297                  buf_buyer-in-buyer-group.stts = 0 and
     7298                  buf_buyer-in-buyer-group.bbg-obj-type = X_clients.obj-type and
     7299                  buf_buyer-in-buyer-group.bbg-obj-code = X_clients.obj-code no-error .
     7300       if available buf_buyer-in-buyer-group then do:
     7301       find first buf_buyer-group no-lock where
     7302                  buf_buyer-group.stts = 0 and
     7303                  buf_buyer-group.bgr-db-num = buf_buyer-in-buyer-group.bgr-db-num and
     7304                  buf_buyer-group.bgr-id     = buf_buyer-in-buyer-group.bgr-id no-error .
     7305       assign
     7306        price-grp = buf_buyer-group.name
     7307       .
     7308       end.
     7309       else assign
     7310        price-grp = ""
     7311       .
     7312     if v-new-selection-flag then do:
     7313       run get-mark-string in this-procedure
     7314         (input  loc_clients.obj-type
     7315         ,input  loc_clients.obj-code
     7316         ,output v-mark-string
     7317         ) .
     7318       return v-mark-string .
     7319     end.
     7320   RETURN ( IF LOOKUP( STRING( recid(loc_clients)), mark-list ) > 0 THEN "*" ELSE "":U ).
     7321   END FUNCTION.
     7322   FUNCTION prep-nameorcode RETURNS CHARACTER
     7323     ( input p-nameorcode as character ) :
     7324   define variable v-nameorcode as character no-undo .
     7325   if trim(p-nameorcode) = '' then  return ''.
     7326   v-nameorcode = trim( trim( p-NameOrCode) , "*" ) .
     7327   if index(v-NameOrCode, chr(34) ,1 ) = 1
     7328   and R-index(v-NameOrCode, chr(34) ,1 ) = 1 then do:
     7329     assign
     7330     v-NameOrCode = trim(v-NameOrCode, chr(34))
     7331     .
     7332     nameorcode = v-nameorcode.
     7333     display NameOrCode with frame Dialog-Frame.
     7334   end.
     7335   define variable v-dopi as character no-undo .
     7336   assign
     7337   v-dopi = substring(v-NameOrCode, length(v-NameOrCode), 1)
     7338   .
     7339   if index("abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя", v-dopi) > 0
     7340   or index("1234567890", v-dopi) > 0
     7341   then do:
     7342     v-NameOrCode = v-NameOrCOde + "*".
     7343   end.
     7344   v-NameOrCode = LC(v-NameOrCode).
     7345   RETURN v-nameorcode.
     7346   END FUNCTION.
