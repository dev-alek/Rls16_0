     6831         .
     6832       end.
     6833       if (lookup("b-mark", p-bttns) > 0
     6834        or lookup("b-mark-hidden", p-bttns) > 0)
     6835       and valid-handle(p-callback-handle)
     6836       and lookup( "userobjs_transfer", p-callback-handle:internal-entries ) > 0
     6837       then do:
