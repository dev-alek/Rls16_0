     5764     run ref/cli-alla.p (input  p-open-query , input  p-find-next ,  input  p-find-condition ,  INPUT parParentProc ,  input attr-option_ ,  input show-as ,  input JoinType ,  input Cli-Types ,  input Curr-Grp-Name ,  input NameOrCode ,  input SupGds     ,  input SupCons    ,  input SupServ    ,  input BuyGds     ,  input BuyCons    ,  input BuyServ    ,  input WLim-kr    ,  input true     ,  input-output v-rid-list ,  input filter-point  ,  input filter-point0 ,  input sort-column-name ,  output v-filter-name ,  input-output v-doc-rec ) .
     5765   end.
     5766   if show-as begins ('все':U + "-" + 'название':U) then do:
     5767     run ref/cli-allj.p (input  p-open-query , input  p-find-next ,  input  p-find-condition ,  INPUT parParentProc ,  input attr-option_ ,  input show-as ,  input JoinType ,  input Cli-Types ,  input Curr-Grp-Name ,  input NameOrCode ,  input SupGds     ,  input SupCons    ,  input SupServ    ,  input BuyGds     ,  input BuyCons    ,  input BuyServ    ,  input WLim-kr    ,  input true     ,  input-output v-rid-list ,  input filter-point  ,  input filter-point0 ,  input sort-column-name ,  output v-filter-name ,  input-output v-doc-rec ) .
     5768   end.
     5769   if show-as begins ("db" + "-") then do:
     5770     if find-by = 'все':U then do:
     5771       run ref/cli-allp.p (input  p-open-query , input  p-find-next ,  input  p-find-condition ,  INPUT parParentProc ,  input attr-option_ ,  input show-as ,  input JoinType ,  input Cli-Types ,  input Curr-Grp-Name ,  input NameOrCode ,  input SupGds     ,  input SupCons    ,  input SupServ    ,  input BuyGds     ,  input BuyCons    ,  input BuyServ    ,  input WLim-kr    ,  input true     ,  input-output v-rid-list ,  input filter-point  ,  input filter-point0 ,  input sort-column-name ,  output v-filter-name ,  input-output v-doc-rec ) .
     5772     end.
     5773     else do:
     5774       run ref/cli-allr.p (input  p-open-query , input  p-find-next ,  input  p-find-condition ,  INPUT parParentProc ,  input attr-option_ ,  input show-as ,  input JoinType ,  input Cli-Types ,  input Curr-Grp-Name ,  input NameOrCode ,  input SupGds     ,  input SupCons    ,  input SupServ    ,  input BuyGds     ,  input BuyCons    ,  input BuyServ    ,  input WLim-kr    ,  input true     ,  input-output v-rid-list ,  input filter-point  ,  input filter-point0 ,  input sort-column-name ,  output v-filter-name ,  input-output v-doc-rec ) .
     5775     end.
     5776   end.
     5777   if show-as begins ('объект':U + "-") then do:
     5778     if find-by = 'все':U then do:
     5779       run ref/cli-alli.p (input  p-open-query , input  p-find-next ,  input  p-find-condition ,  INPUT parParentProc ,  input attr-option_ ,  input show-as ,  input JoinType ,  input Cli-Types ,  input Curr-Grp-Name ,  input NameOrCode ,  input SupGds     ,  input SupCons    ,  input SupServ    ,  input BuyGds     ,  input BuyCons    ,  input BuyServ    ,  input WLim-kr    ,  input true     ,  input-output v-rid-list ,  input filter-point  ,  input filter-point0 ,  input sort-column-name ,  output v-filter-name ,  input-output v-doc-rec ) .
     5780     end.
     5781     else do:
     5782       run ref/cli-alls.p (input  p-open-query , input  p-find-next ,  input  p-find-condition ,  INPUT parParentProc ,  input attr-option_ ,  input show-as ,  input JoinType ,  input Cli-Types ,  input Curr-Grp-Name ,  input NameOrCode ,  input SupGds     ,  input SupCons    ,  input SupServ    ,  input BuyGds     ,  input BuyCons    ,  input BuyServ    ,  input WLim-kr    ,  input true     ,  input-output v-rid-list ,  input filter-point  ,  input filter-point0 ,  input sort-column-name ,  output v-filter-name ,  input-output v-doc-rec ) .
     5783     end.
     5784   end.
     5785   else do:
     5786     if (Cli-Types <> 'все':U
     5787     and Cli-Types <> "db"
     5788     )
     5789     and find-by = 'все':U then do:
     5790       run ref/cli-allf.p (input  p-open-query , input  p-find-next ,  input  p-find-condition ,  INPUT parParentProc ,  input attr-option_ ,  input show-as ,  input JoinType ,  input Cli-Types ,  input Curr-Grp-Name ,  input NameOrCode ,  input SupGds     ,  input SupCons    ,  input SupServ    ,  input BuyGds     ,  input BuyCons    ,  input BuyServ    ,  input WLim-kr    ,  input true     ,  input-output v-rid-list ,  input filter-point  ,  input filter-point0 ,  input sort-column-name ,  output v-filter-name ,  input-output v-doc-rec ) .
     5791     end.
     5792     if (Cli-Types <> 'все':U
     5793     and Cli-Types <> "db"
     5794     )
     5795     AND find-by = 'название':U  then do:
     5796       run ref/cli-allg.p (input  p-open-query , input  p-find-next ,  input  p-find-condition ,  INPUT parParentProc ,  input attr-option_ ,  input show-as ,  input JoinType ,  input Cli-Types ,  input Curr-Grp-Name ,  input NameOrCode ,  input SupGds     ,  input SupCons    ,  input SupServ    ,  input BuyGds     ,  input BuyCons    ,  input BuyServ    ,  input WLim-kr    ,  input true     ,  input-output v-rid-list ,  input filter-point  ,  input filter-point0 ,  input sort-column-name ,  output v-filter-name ,  input-output v-doc-rec ) .
     5797     end.
     5798   end.
     5799   if session :set-wait-state( "compiler" ) then.
     5800   HIDE
     5801   CLi-list in frame Dialog-Frame
     5802   CLi-listA
     5803   in frame Dialog-Frame.
     5804   assign
     5805   var-cli-name:width in browse cli-listb = var-cli-name:width in browse cli-list
     5806   X_clients.grp-name:width in browse cli-listb = X_clients.grp-name:width in browse cli-list
     5807   .
     5808   DISPLAY
     5809   CLi-listb
     5810   with frame Dialog-Frame.
     5811   run diasize_restore-orig-size in this-procedure .
     5812   run diasize_set-browse-handle in this-procedure
     5813     (input browse CLi-listb :handle
     5814     ) .
     5815   run diasize_restore-current-size in this-procedure .
     5816   run set-filter-name in this-procedure ( INPUT v-filter-name) no-error .
     5817   if num-results( "Cli-Listb" ) <> 0 then do:
     5818       if c-recid <> ? then do:
     5819          if not p-open-query then
     5820          reposition CLi-listb to recid( c-recid ) no-error .
     5821       end.
     5822       else do:
     5823          if not p-open-query then
     5824          reposition CLi-listb to row 1 no-error .
     5825          log-res = CLi-listb:select-row( 1 ) in frame Dialog-Frame .
     5826       end.
     5827   end.
     5828   APPLY "VALUE-CHANGED" TO CLi-Listb  in frame Dialog-Frame.
     5829   apply "entry" to CLi-listb in frame Dialog-Frame .
     5830   if session :set-wait-state( "" ) then.
     5831   END PROCEDURE.
     5832   PROCEDURE proc-b-add :
     5833   define input parameter p-is-firm as logical no-undo.
     5834   DEFINE VARIABLE ri          as      recid   no-undo     init ? .
     5835   DEFINE VARIABLE to-grp      like  ub.cli-grp.node-code     no-undo .
     5836   define variable g-grp as character no-undo .
     5837   define buffer b-cli-grp for ub.cli-grp.
     5838   assign
     5839   Find-By:screen-value in frame Dialog-Frame = 'все':U  .
     5840   apply "value-changed" to Find-By in frame Dialog-Frame .
     5841   CASE p-is-firm :
     5842       when yes
     5843       then do:
     5844   define variable vss-include-info41 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5845   do:
     5846     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5847       (input  v-cntxt-db-num
     5848       ,input  v-cntxt-userid
     5849       ,input  0
     5850       ,input  'actn_client-reference_add-del':U
     5851       ,input  'global':U
     5852       ,input  0
     5853       ,input  '':U
     5854       ,input  0
     5855       ,input  0
     5856       ,input  0
     5857       ,input  0
     5858       ,input  true
     5859       ,output g#log
     5860       )  .
     5861   end.
     5862       end.
     5863       when no
     5864       then do:
     5865   define variable vss-include-info42 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5866   do:
     5867     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5868       (input  v-cntxt-db-num
     5869       ,input  v-cntxt-userid
     5870       ,input  0
     5871       ,input  'actn_client-reference-prs_add-del':U
     5872       ,input  'global':U
     5873       ,input  0
     5874       ,input  '':U
     5875       ,input  0
     5876       ,input  0
     5877       ,input  0
     5878       ,input  0
     5879       ,input  true
     5880       ,output g#log
     5881       )  .
     5882   end.
     5883       end.
     5884   END CASE.
     5885   if not g#log then return error.
     5886   g-grp = "".
     5887   run ref/cli-grps.w (
     5888                      input parparentproc
     5889                     ,input "b-sel":U
     5890                     ,input-output g-grp ) .
     5891   if g-grp <> "" then do:
     5892     FIND ub.cli-grp where recid( ub.cli-grp ) = integer( g-grp ) .
     5893     if can-find( FIRST b-cli-grp where b-cli-grp.upper-code = ub.cli-grp.node-code ) then do:
     5894       message "Добавлять можно только в группы," skip
     5895               "у которых нет подгрупп." skip
     5896               "Выбирайте другую группу !"
     5897       view-as alert-box WARNING .
     5898       return no-apply .
     5899     end.
     5900     to-grp = ub.cli-grp.node-code .
     5901     if p-is-firm then
     5902         run ref/firmi.w (
     5903                     input parParentProc
     5904                    ,input ('ДОБАВЛЕНИЕ':U + (if v-s-deploy then (";":U + "s-deploy":U) else "":U))
     5905                    ,input 0
     5906                    ,input to-grp
     5907                    ,input "cli-all"
     5908                    ,input-output ri ) .
     5909     else
     5910         run ref/personi.w (
     5911                       input parParentProc
     5912                      ,input 'ДОБАВЛЕНИЕ':U
     5913                      ,input 0
     5914                      ,input to-grp
     5915                      ,input "cli-all"
     5916                      ,input-output ri ) .
     5917     if ri <> ? then do:
     5918       if find-by <> 'все':U then do:
     5919         apply "RETURN" to Nameorcode.
     5920       end.
     5921       else do:
     5922         case var-br-name :         when "cli-list":U then do:            Run OpenBR in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listA":U then do:            Run OpenBRA in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listB":U then do:            Run OpenBRB in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         end case.
     5923         case var-br-name :         when "cli-list":U then do:            reposition Cli-List to recid ri no-error .         end.         when "cli-listA":U then do:            reposition Cli-ListA to recid ri no-error .         end.         when "cli-listB":U then do:            reposition Cli-ListB to recid ri no-error .          end.         end case.
     5924         if error-status:error then do:
     5925           find first pos_clients no-lock where       recid( pos_clients ) = ri no-error .   message  substitute("Невозможно позиционироваться на клиенте &1&2Клиент был добавлен (или изменен или удален)&2и теперь не попадает в текущую выборку"             ,(if available pos_clients then (pos_clients.obj-type + string(pos_clients.obj-code)) else '':U)              , chr(10)) view-as alert-box WARNING.
     5926         end.
     5927         case var-br-name :         when "cli-list":U then do:            apply "entry" to Cli-List in frame Dialog-Frame.         end.         when "cli-listA":U then do:            apply "entry" to Cli-ListA in frame Dialog-Frame.         end.         when "cli-listB":U then do:            apply "entry" to Cli-ListB in frame Dialog-Frame.         end.         end case.
     5928       end.
     5929     end.
     5930   end.
     5931   else do:
     5932     case var-br-name :         when "cli-list":U then do:            apply "entry" to Cli-List in frame Dialog-Frame.         end.         when "cli-listA":U then do:            apply "entry" to Cli-ListA in frame Dialog-Frame.         end.         when "cli-listB":U then do:            apply "entry" to Cli-ListB in frame Dialog-Frame.         end.         end case.
     5933     return no-apply.
     5934   end.
     5935   END PROCEDURE.
     5936   PROCEDURE proc-b-print :
     5937   define variable sym1 as char init ":"   no-undo.
     5938   define variable sym2 as char init ":"   no-undo.
     5939   define variable sym3 as char init ":"   no-undo.
     5940   define variable sym4 as char init ":"   no-undo.
     5941   define variable sym5 as char init ":"   no-undo.
     5942   define variable Line                as char         no-undo.
     5943   define variable CurrGroupName as char        no-undo.
     5944   define variable ii      as integer   no-undo.
     5945   define variable ri      as recid   no-undo.
     5946   DEFINE FRAME List
     5947   sym1 column-label ":" format "x(1)"
     5948   X_clients.obj-name column-label "Наименование" format "x(59)"
     5949   sym2 column-label ":" format "x(1)"
     5950   X_clients.obj-type column-label "Тип" format "x(8)"
     5951   sym3 column-label ":" format "x(1)"
     5952   X_clients.obj-code column-label "Код" format ">>>>>>>>>9"
     5953   sym4 column-label ":" format "x(1)"
     5954   X_clients.PS column-label "Примечание" format "x(40)"
     5955   sym5 column-label ":" format "x(1)"
     5956   HEADER
     5957   cur-time-print() AT 5 format "X(35)"
     5958   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>9") )
     5959   AT 86 format "X(15)" SKIP
     5960   Line format "x(130)" AT 1
     5961   with width 235 down use-text stream-io no-box .
     5962   if num-results( var-br-name ) = 0 then do:
     5963     message "Список  П У С Т !" skip view-as alert-box information .
     5964     return no-apply .
     5965   end.
     5966   define variable vss-include-info43 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5967   do:
     5968     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5969       (input  v-cntxt-db-num
     5970       ,input  v-cntxt-userid
     5971       ,input  0
     5972       ,input  'actn_reference-lists_print':U
     5973       ,input  'firm':U
     5974       ,input  v-cntxt-host-code-obj
     5975       ,input  '':U
     5976       ,input  0
     5977       ,input  0
     5978       ,input  0
     5979       ,input  0
     5980       ,input  false
     5981       ,output g#log
     5982       )  .
     5983   end.
     5984   if not g#log then do:
     5985       message
     5986       "У Вас недостаточно прав для" skip
     5987       "выполнения данного действия." skip
     5988       "Обратитесь к администратору" skip
     5989       "системы."
     5990       view-as alert-box error title "Недостаточно прав !".
     5991     return error .
     5992   end.
     5993   Line = fill( "-" , 140 ) .
     5994   assign frame Dialog-Frame
     5995   All-Or-Group Cli-Types Cli-Status .
     5996   run waitfram-show in this-procedure ( 'Подождите ...' ) .
     5997   ri = recid( X_clients ) .
     5998   case var-br-name :
     5999   when  "cli-list":U then do:
     6000     DO WHILE available X_clients :
     6001         GET prev Cli-List NO-LOCK .
     6002     END.
     6003     GET next Cli-List NO-LOCK .
     6004   end.
     6005   when "cli-listA":U then  do:
     6006     DO WHILE available X_clients :
     6007         GET prev Cli-ListA NO-LOCK .
     6008     END.
     6009     GET next Cli-ListA NO-LOCK .
     6010   end.
     6011   when "cli-listB":U then  do:
     6012     DO WHILE available X_clients :
     6013         GET prev Cli-ListB NO-LOCK .
     6014     END.
     6015     GET next Cli-ListB NO-LOCK .
     6016   end.
     6017   end case.
     6018   ii = 1 .
     6019   if All-Or-Group = 'группа':U then
     6020   CurrGroupName = X_clients.grp-name .
     6021   run prn-lib-open-stream  in this-procedure (
     6022                                                input parParentProc
     6023                                               ,input 43
     6024                                               ,input yes
     6025                                               ,input no
     6026                                               ).
     6027   FORM HEADER
     6028   Line format "X(130)" SKIP
     6029   "Продолжение - на следующей странице" AT 30 SKIP
     6030   with FRAME CliBottomFrame width 160 PAGE-BOTTOM NO-LABELS no-box.
     6031   VIEW stream PrnLibStream FRAME CliBottomFrame .
     6032   PUT stream PrnLibStream space(30)
     6033   "С П И С О К   К Л И Е Н Т О В" format "X(100)" SKIP(2) .
     6034   FORM with frame List .
     6035   DO WHILE available X_clients :
     6036       DISPLAY stream PrnLibStream
     6037       sym1 X_clients.obj-name sym2 X_clients.obj-type
     6038       sym3 X_clients.obj-code sym4 X_clients.PS sym5
     6039       with frame List .
     6040       DOWN stream PrnLibStream 1 with frame List .
     6041       ii =  ii + 1 .
     6042       if ( ( ii modulo 10 ) = 0 ) AND ( ii >= 10 ) then
     6043       run waitfram-show in this-procedure ( input ("Просмотрено строк : " + string( ii )) ) .
     6044       if var-br-name = "cli-list":U then do:
     6045           GET next Cli-List .
     6046       end.
     6047       else do:
     6048           GET next Cli-ListA .
     6049       end.
     6050   END.
     6051   run waitfram-hide in this-procedure .
     6052   PUT stream PrnLibStream Line format "X(130)" SKIP.
     6053   HIDE stream PrnLibStream FRAME CliBottomFrame .
     6054   output stream PrnLibStream close .
     6055   run prn-lib-prn-file in this-procedure (
     6056                                             input parParentProc
     6057                                             ,input 0
     6058                                             ).
     6059   case var-br-name :         when "cli-list":U then do:            reposition Cli-List to recid ri no-error .         end.         when "cli-listA":U then do:            reposition Cli-ListA to recid ri no-error .         end.         when "cli-listB":U then do:            reposition Cli-ListB to recid ri no-error .          end.         end case.
     6060   if error-status:error then do:
     6061         find first pos_clients no-lock where       recid( pos_clients ) = ri no-error .   message  substitute("Невозможно позиционироваться на клиенте &1&2Клиент был добавлен (или изменен или удален)&2и теперь не попадает в текущую выборку"             ,(if available pos_clients then (pos_clients.obj-type + string(pos_clients.obj-code)) else '':U)              , chr(10)) view-as alert-box WARNING.
     6062   end.
     6063   case var-br-name :         when "cli-list":U then do:            Run OpenBR in this-procedure (yes, no, ' ':U, no) no-error  .         end.         when "cli-listA":U then do:            Run OpenBRA in this-procedure (yes, no, ' ':U, no) no-error  .         end.         when "cli-listB":U then do:            Run OpenBRB in this-procedure (yes, no, ' ':U, no) no-error  .         end.         end case.
     6064   END PROCEDURE.
     6065   PROCEDURE proc-b-sch :
     6066   assign
     6067     tbl = 'clients'
     6068     join-tbl = 'X_clients'
     6069     fld = ""
     6070     lab = ""
     6071     spr = ""
     6072     dim = '0'
     6073     .
     6074   run fltfield-add in this-procedure('obj-type*obj-code', 'Клиент', 'cli',
     6075   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6076   run fltfield-add in this-procedure('obj-name', 'Название', '',
     6077   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6078   run fltfield-add in this-procedure('is-prod', 'Пр-ль', '',
     6079   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6080   run fltfield-add in this-procedure('sup-gds', 'Пост-к/т', '',
     6081   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6082   run fltfield-add in this-procedure('sup-cons', 'Пост-к/к', '',
     6083   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6084   run fltfield-add in this-procedure('buy-gds', 'Пок-ль/т', '',
     6085   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6086   run fltfield-add in this-procedure('buy-cons', 'Пок-ль/к', '',
     6087   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6088   run fltfield-add in this-procedure('buy-serv', 'Пок-ль/у', '',
     6089   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6090   run fltfield-add in this-procedure('db-num', 'БД', 'db',
     6091   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6092   run fltfield-add in this-procedure('host-code', 'Своя фирма', '',
     6093   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6094   run fltfield-add in this-procedure('grp-name', '', 'cligrp',
     6095   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6096   run fltfield-add in this-procedure('PS', '', '',
     6097   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6098   Filter-Block:
     6099   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     6100       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     6101       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     6102     run gbl/filter.w ( INPUT parparentproc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     6103     if var-br-name = "" or var-br-name = ? then do:
     6104       var-prev-br-name = var-br-name.
     6105       var-br-name = "cli-list"  .
     6106     end.
     6107     case var-br-name :         when "cli-list":U then do:            Run OpenBR in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listA":U then do:            Run OpenBRA in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listB":U then do:            Run OpenBRB in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         end case.
     6108   END.
     6109   END PROCEDURE.
     6110   PROCEDURE proc-find :
     6111   define input parameter cli-code like ub.clients.obj-code no-undo.
     6112   define output parameter par-recid as recid no-undo.
     6113   define buffer b-cli for ub.clients.
     6114   CASE Cli-Types :
     6115     when 'все':U then do:
     6116       CASE JoinType :
     6117         when "Или" then do:
     6118            FIND FIRST b-cli WHERE
     6119                  b-cli.obj-code = cli-code AND
     6120                  ( if Cli-Status = 'текущие':U
     6121                     then b-cli.stts = 0
     6122                     else if Cli-Status = 'удаленные':U
     6123                        then b-cli.stts <> 0
     6124                        else TRUE ) AND
     6125                  ( if All-Or-Group = 'группа':U
     6126                  then b-cli.grp-name begins Curr-Grp-Name
     6127                  else TRUE ) AND
     6128   (
     6129     ( if SupGds = yes AND b-cli.sup-gds = yes     then yes else no ) OR
     6130     ( if SupCons = yes AND b-cli.sup-cons = yes     then yes else no ) OR
     6131     ( if SupServ = yes AND b-cli.sup-serv = yes     then yes else no ) OR
     6132     ( if BuyGds = yes AND b-cli.buy-gds = yes     then yes else no ) OR
     6133     ( if BuyCons = yes AND b-cli.buy-cons = yes     then yes else no ) OR
     6134     ( if BuyServ = yes AND b-cli.buy-serv = yes     then yes else no ) OR
     6135     ( if WLim-kr = yes AND b-cli.lim-kr <> 0    then yes else no )
     6136   )
     6137       NO-LOCK no-error .
     6138         end.
     6139         when "NO" then do:
     6140           FIND FIRST b-cli WHERE
     6141                  b-cli.obj-code = cli-code AND
     6142                  ( if Cli-Status = 'текущие':U
     6143                     then b-cli.stts = 0
     6144                     else if Cli-Status = 'удаленные':U then b-cli.stts <> 0 else TRUE ) AND
     6145                  (if All-Or-Group = 'группа':U
     6146                     then b-cli.grp-name begins Curr-Grp-Name
     6147                     else TRUE )
     6148            NO-LOCK no-error.
     6149         end.
     6150       END CASE .
     6151     end.
     6152     otherwise do:
     6153       CASE JoinType :
     6154         when "Или" then do:
     6155            FIND FIRST b-cli WHERE
     6156                  (cli-types = 'объект':U or b-cli.obj-type = Cli-Types) AND
     6157                  b-cli.obj-code = cli-code AND
     6158                  ( if Cli-Status = 'текущие':U
     6159                     then b-cli.stts = 0
     6160                     else if Cli-Status = 'удаленные':U then b-cli.stts <> 0 else TRUE ) AND
     6161                  ( if All-Or-Group = 'группа':U
     6162                     then b-cli.grp-name begins Curr-Grp-Name
     6163                     else TRUE ) AND
     6164   (
     6165     ( if SupGds = yes AND b-cli.sup-gds = yes     then yes else no ) OR
     6166     ( if SupCons = yes AND b-cli.sup-cons = yes     then yes else no ) OR
     6167     ( if SupServ = yes AND b-cli.sup-serv = yes     then yes else no ) OR
     6168     ( if BuyGds = yes AND b-cli.buy-gds = yes     then yes else no ) OR
     6169     ( if BuyCons = yes AND b-cli.buy-cons = yes     then yes else no ) OR
     6170     ( if BuyServ = yes AND b-cli.buy-serv = yes     then yes else no ) OR
     6171     ( if WLim-kr = yes AND b-cli.lim-kr <> 0    then yes else no )
     6172   )
     6173            NO-LOCK no-error.
     6174         end.
     6175         when "NO" then do:
     6176            FIND FIRST b-cli WHERE
     6177               (cli-types = 'объект':U or b-cli.obj-type = Cli-Types) AND
     6178               b-cli.obj-code = cli-code AND
     6179               ( if Cli-Status = 'текущие':U
     6180                  then b-cli.stts = 0
     6181                  else if Cli-Status = 'удаленные':U then b-cli.stts <> 0 else TRUE ) AND
     6182               ( if All-Or-Group = 'группа':U
     6183                  then b-cli.grp-name begins Curr-Grp-Name
     6184                  else TRUE )
     6185            NO-LOCK no-error.
     6186         end.
     6187       END CASE .
     6188     end.
     6189   END CASE .
     6190   if available b-cli then par-recid = recid(b-cli).
     6191   END PROCEDURE.
     6192   PROCEDURE proc-findA :
     6193   define input parameter cli-code like ub.clients.obj-code no-undo.
     6194   define output parameter par-recid as recid no-undo.
     6195   define buffer b-cli for ub.clients.
     6196   CASE Cli-Types :
     6197     when 'все':U then do:
     6198       CASE JoinType :
     6199         when "Или" then do:
     6200            _ff1:
     6201            FOR EACH b-cli WHERE
     6202                  b-cli.obj-code = cli-code AND
     6203                  ( if Cli-Status = 'текущие':U
     6204                     then b-cli.stts = 0
     6205                     else if Cli-Status = 'удаленные':U
     6206                        then b-cli.stts <> 0
     6207                        else TRUE ) AND
     6208                  ( if All-Or-Group = 'группа':U
     6209                  then b-cli.grp-name begins Curr-Grp-Name
     6210                  else TRUE ) AND
     6211   (
     6212     ( if SupGds = yes AND b-cli.sup-gds = yes     then yes else no ) OR
     6213     ( if SupCons = yes AND b-cli.sup-cons = yes     then yes else no ) OR
     6214     ( if SupServ = yes AND b-cli.sup-serv = yes     then yes else no ) OR
     6215     ( if BuyGds = yes AND b-cli.buy-gds = yes     then yes else no ) OR
     6216     ( if BuyCons = yes AND b-cli.buy-cons = yes     then yes else no ) OR
     6217     ( if BuyServ = yes AND b-cli.buy-serv = yes     then yes else no ) OR
     6218     ( if WLim-kr = yes AND b-cli.lim-kr <> 0    then yes else no )
     6219   )
     6220            NO-LOCK:
     6221               IF CAN-FIND(first clients-attr No-LOCK WHERE
     6222                                 clients-attr.obj-type = b-cli.obj-type AND
     6223                                 clients-attr.obj-code = b-cli.obj-code AND
     6224                                 clients-attr.attr-code = attr-option_) then LEAVE _ff1.
     6225           end.
     6226         end.
     6227         when "NO" then do:
     6228           _ff2:
     6229           FOR EACH b-cli WHERE
     6230                  b-cli.obj-code = cli-code AND
     6231                  ( if Cli-Status = 'текущие':U
     6232                     then b-cli.stts = 0
     6233                     else if Cli-Status = 'удаленные':U then b-cli.stts <> 0 else TRUE ) AND
     6234                  (if All-Or-Group = 'группа':U
     6235                     then b-cli.grp-name begins Curr-Grp-Name
     6236                     else TRUE )
     6237           NO-LOCK:
     6238             IF CAN-FIND(first clients-attr No-LOCK WHERE
     6239                              clients-attr.obj-type = b-cli.obj-type AND
     6240                              clients-attr.obj-code = b-cli.obj-code AND
     6241                              clients-attr.attr-code = attr-option_) then LEAVE _ff2.
     6242           END.
     6243         end.
     6244         END CASE .
     6245      end.
     6246      otherwise do:
     6247        CASE JoinType :
     6248          when "Или" then do:
     6249            _ff5:
     6250            FOR EACH b-cli WHERE
     6251                  b-cli.obj-type = Cli-Types AND
     6252                  b-cli.obj-code = cli-code AND
     6253                  ( if Cli-Status = 'текущие':U
     6254                     then b-cli.stts = 0
     6255                     else if Cli-Status = 'удаленные':U then b-cli.stts <> 0 else TRUE ) AND
     6256                  ( if All-Or-Group = 'группа':U
     6257                     then b-cli.grp-name begins Curr-Grp-Name
     6258                     else TRUE ) AND
     6259   (
     6260     ( if SupGds = yes AND b-cli.sup-gds = yes     then yes else no ) OR
     6261     ( if SupCons = yes AND b-cli.sup-cons = yes     then yes else no ) OR
     6262     ( if SupServ = yes AND b-cli.sup-serv = yes     then yes else no ) OR
     6263     ( if BuyGds = yes AND b-cli.buy-gds = yes     then yes else no ) OR
     6264     ( if BuyCons = yes AND b-cli.buy-cons = yes     then yes else no ) OR
     6265     ( if BuyServ = yes AND b-cli.buy-serv = yes     then yes else no ) OR
     6266     ( if WLim-kr = yes AND b-cli.lim-kr <> 0    then yes else no )
     6267   )
     6268            NO-LOCK:
     6269               IF CAN-FIND(first clients-attr No-LOCK WHERE
     6270                                 clients-attr.obj-type = b-cli.obj-type AND
     6271                                 clients-attr.obj-code = b-cli.obj-code AND
     6272                                 clients-attr.attr-code = attr-option_) then LEAVE _ff5.
     6273            END.
     6274          end.
     6275          when "NO" then do:
     6276            _ff6:
     6277            FOR b-cli WHERE
     6278               b-cli.obj-type = Cli-Types AND
     6279               b-cli.obj-code = cli-code AND
     6280               ( if Cli-Status = 'текущие':U
     6281                  then b-cli.stts = 0
     6282                  else if Cli-Status = 'удаленные':U then b-cli.stts <> 0 else TRUE ) AND
     6283               ( if All-Or-Group = 'группа':U
     6284                  then b-cli.grp-name begins Curr-Grp-Name
     6285                  else TRUE )
     6286            NO-LOCK:
     6287               IF CAN-FIND(first clients-attr No-LOCK WHERE
     6288                                 clients-attr.obj-type = b-cli.obj-type AND
     6289                                 clients-attr.obj-code = b-cli.obj-code AND
     6290                                 clients-attr.attr-code = attr-option_) then LEAVE _ff6.
     6291            END.
     6292          end.
     6293        END CASE .
     6294     end.
     6295   END CASE .
     6296   if available b-cli then par-recid = recid(b-cli).
     6297   END PROCEDURE.
     6298   PROCEDURE proc-return-nameorcode :
     6299     do
     6300     on error undo, return error
     6301     :
     6302       define variable cli-code like ub.clients.obj-code no-undo.
     6303       define variable cli-name like ub.clients.obj-name no-undo.
     6304       define variable ri as recid no-undo.
     6305       assign
     6306       frame Dialog-Frame All-Or-Group
     6307       Cli-Status Cli-Types Find-By NameOrCode
     6308       .
     6309       if NameOrCode = "" then
     6310           return no-apply .
     6311       if can-do( 'код':U , Find-By ) then  do:
     6312         assign
     6313         cli-code = integer( trim( NameOrCode ) ) no-error
     6314         .
     6315         if error-status:error then do:
     6316           message
     6317           "Неверный код" skip
     6318           "Введите цифровой код клиента длиной до 9 знаков включительно"
     6319           view-as alert-box error .
     6320           return error .
     6321         end.
     6322         if var-br-name = "cli-list" then do:
     6323           run proc-find in this-procedure ( input cli-code, output ri) no-error.
     6324         end.
     6325         else do:
     6326           run proc-findA in this-procedure ( input cli-code, output ri) no-error.
     6327         end.
     6328         if ri = ? then do:
     6329             message "Клиент с кодом : " NameOrCode skip
     6330                     "при текущих параметрах" skip
     6331                     "просмотра справочника" skip
     6332                     "НЕ  НАЙДЕН.".
     6333             return no-apply.
     6334          end.
     6335          else  do:
     6336             apply "entry" to NameOrCOde in frame Dialog-Frame .
     6337             run proc-vc-find-by in this-procedure ( input  no).
     6338             case var-br-name :         when "cli-list":U then do:            reposition Cli-List to recid ri no-error .         end.         when "cli-listA":U then do:            reposition Cli-ListA to recid ri no-error .         end.         when "cli-listB":U then do:            reposition Cli-ListB to recid ri no-error .          end.         end case.
     6339             if error-status:error then do:
     6340               find first pos_clients no-lock where       recid( pos_clients ) = ri no-error .   message  substitute("Невозможно позиционироваться на клиенте &1&2Клиент был добавлен (или изменен или удален)&2и теперь не попадает в текущую выборку"             ,(if available pos_clients then (pos_clients.obj-type + string(pos_clients.obj-code)) else '':U)              , chr(10)) view-as alert-box WARNING.
     6341             end.
     6342             case var-br-name :         when "cli-list":U then do:            g#log = Cli-List:select-focused-row ().         end.         when "cli-listA":U then do:            g#log = Cli-ListA:select-focused-row ().         end.         when "cli-listB":U then do:            g#log = Cli-ListB:select-focused-row ().          end.         end case.
     6343          end.
     6344       end.
     6345       else if Find-By = "ИНН" then do:
     6346         if var-br-name = "cli-list" then do:
     6347           run proc-find-inn in this-procedure ( input trim( NameOrCode ), output ri) no-error.
     6348           apply "entry" to NameOrCOde in frame Dialog-Frame .
     6349           case var-br-name :         when "cli-list":U then do:            reposition Cli-List to recid ri no-error .         end.         when "cli-listA":U then do:            reposition Cli-ListA to recid ri no-error .         end.         when "cli-listB":U then do:            reposition Cli-ListB to recid ri no-error .          end.         end case.
     6350           if error-status:error then do:
     6351             if ri <> ? then do:
     6352                           find first pos_clients no-lock where       recid( pos_clients ) = ri no-error .   message  substitute("Невозможно позиционироваться на клиенте &1&2Клиент был добавлен (или изменен или удален)&2и теперь не попадает в текущую выборку"             ,(if available pos_clients then (pos_clients.obj-type + string(pos_clients.obj-code)) else '':U)              , chr(10)) view-as alert-box WARNING.
     6353             end.
     6354             else do:
     6355               message subst("Организации с ИНН &1 нет в справочнике", trim( NameOrCode ))
     6356               view-as alert-box.
     6357             end.
     6358           end.
     6359           case var-br-name :         when "cli-list":U then do:            g#log = Cli-List:select-focused-row ().         end.         when "cli-listA":U then do:            g#log = Cli-ListA:select-focused-row ().         end.         when "cli-listB":U then do:            g#log = Cli-ListB:select-focused-row ().          end.         end case.
     6360         end.
     6361       end.
     6362       else do:
     6363           NameOrCode = prep-nameorcode (nameorcode).
     6364           case var-br-name :         when "cli-list":U then do:            Run OpenBR in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listA":U then do:            Run OpenBRA in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listB":U then do:            Run OpenBRB in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         end case.
     6365           if available X_clients AND num-results( var-br-name ) <> 0 then do:
     6366               case var-br-name :         when "cli-list":U then do:            reposition Cli-List to row 1 no-error .         end.         when "cli-listA":U then do:            reposition Cli-ListA to row 1 no-error .         end.         when "cli-listB":U then do:            reposition Cli-ListB to row 1 no-error .          end.         end case.
     6367               case var-br-name :         when "cli-list":U then do:            g#log = Cli-List:select-row (1).         end.         when "cli-listA":U then do:            g#log = Cli-ListA:select-row (1).         end.         when "cli-listB":U then do:            g#log = Cli-ListB:select-row (1).          end.         end case.
     6368           end.
     6369       end.
     6370     end.
     6371     if b-mark:sensitive then apply "choose" to b-mark in frame Dialog-Frame.
     6372   END PROCEDURE.
     6373   PROCEDURE proc-value-change-All-or-Group :
     6374   define variable g-grp as character no-undo .
     6375     assign
     6376     frame Dialog-Frame ALL-Or-GROUP
     6377     getc-recid = yes
     6378     .
     6379       CASE ALL-Or-GROUP:
     6380         when 'группа':U then do:
     6381           assign
     6382             attr-option_ = ""
     6383             var-prev-br-name = var-br-name
     6384             var-br-name  = ( if var-br-name = "cli-listB":U then  "cli-listB":U else  "cli-list":U )
     6385             g-grp        = "".
     6386           run ref/cli-grps.w (  input parparentproc
     6387                               ,input  "b-sel"
     6388                               ,input-output g-grp ) .
     6389           if g-grp = "" then do:
     6390             assign All-Or-Group = 'все':U .
     6391             DISPLAY All-Or-Group with frame Dialog-Frame .
     6392           end.
     6393           else do:
     6394             FIND ub.cli-grp where recid( ub.cli-grp ) = integer( g-grp ) no-lock.
     6395             RUN cli-grplib-get-full-name in this-procedure ( input ub.cli-grp.node-code, output Curr-Grp-Name ) .
     6396             assign
     6397             Find-By:screen-value = 'все':U
     6398             NameOrCode = "" .
     6399             apply "value-changed" to Find-By in frame Dialog-Frame .
     6400           end.
     6401         end.
     6402         when 'АТР':U then do:
     6403           assign
     6404           attr-option_ = 'db':U
     6405           var-prev-br-name = var-br-name
     6406           var-br-name = ( if var-br-name = "cli-listB":U then  "cli-listB":U else  "cli-listA":U )
     6407           g-grp = ""
     6408           .
     6409           assign
     6410           Find-By:screen-value = 'все':U
     6411           NameOrCode = "" .
     6412           apply "value-changed" to Find-By in frame Dialog-Frame .
     6413         end.
     6414         when 'все':U then do:
     6415           assign
     6416           Find-By:screen-value = 'все':U
     6417           NameOrCode = ""
     6418           attr-option_ = ""
     6419           var-prev-br-name = var-br-name
     6420           var-br-name =  ( if var-br-name = "cli-listB":U then  "cli-listB":U else  "cli-list":U )
     6421           g-grp = ""
     6422           .
     6423           apply "value-changed" to Find-By in frame Dialog-Frame .
     6424         end.
     6425       END CASE.
     6426   END PROCEDURE.
     6427   PROCEDURE proc-vc-find-by :
     6428   define input parameter p-openquery as logical no-undo .
     6429   define variable PrevValue as char no-undo .
     6430   run waitfram-show in this-procedure ( input "Ждите..." ).
     6431     do
     6432     on error undo, return error
     6433     :
     6434       run waitfram-show in this-procedure ( input "Ждите..." ).
     6435       PrevValue = Find-By .
     6436       v-last-inn-rec = ?.
     6437       assign
     6438       frame Dialog-Frame
     6439       Find-By .
     6440       c-recid = ( if available X_clients and getc-recid then recid( X_clients ) else ? ) .
     6441       CASE Find-By :
     6442         when 'все':U then do:
     6443           g#log = Find-By:enable(radio-label('название':U, Find-by:radio-buttons)).
     6444           g#log = Find-By:enable(radio-label('код':U, Find-by:radio-buttons)) .
     6445           g#log = Find-By:enable(radio-label('ИНН':U, Find-by:radio-buttons)) .
     6446           if p-openquery then do:
     6447             case var-br-name :         when "cli-list":U then do:            Run OpenBR in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listA":U then do:            Run OpenBRA in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listB":U then do:            Run OpenBRB in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         end case. .
     6448           end.
     6449           DISABLE
     6450           NameOrCode
     6451           with frame Dialog-Frame .
     6452           HIDE
     6453           NameOrCode .
     6454           run waitfram-hide in this-procedure .
     6455           case var-br-name :         when "cli-list":U then do:            apply "entry" to Cli-List in frame Dialog-Frame.         end.         when "cli-listA":U then do:            apply "entry" to Cli-ListA in frame Dialog-Frame.         end.         when "cli-listB":U then do:            apply "entry" to Cli-ListB in frame Dialog-Frame.         end.         end case.
     6456         end.
     6457         when 'название':U OR when 'код':U OR when 'ИНН' then do:
     6458           VIEW
     6459           NameOrCode .
     6460           ENABLE
     6461           NameOrCode
     6462           with frame Dialog-Frame .
     6463           if can-do( 'код':U, Find-By ) AND
     6464              can-do( 'название':U, PrevValue ) AND ( NameOrCode <> "" ) then do:
     6465             if p-openquery then do:
     6466               case var-br-name :         when "cli-list":U then do:            Run OpenBR in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listA":U then do:            Run OpenBRA in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listB":U then do:            Run OpenBRB in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         end case.
     6467             end.
     6468           end.
     6469           if can-do( 'код':U, Find-By ) then  do:
     6470             assign
     6471             NameOrCode:width-chars = 10
     6472             NameOrCode:format = "x(9)" .
     6473             g#log = Find-By:disable(radio-label('название':U, Find-by:radio-buttons)) .
     6474             g#log = Find-By:disable(radio-label('ИНН':U, Find-by:radio-buttons)) .
     6475           end.
     6476           else if can-do( 'ИНН':U, Find-by ) then do:
     6477               assign
     6478               NameOrCode:width-chars = 15
     6479               NameOrCode:format = "x(15)"
     6480               .
     6481               g#log = Find-by:disable (radio-label('название':U, Find-by:radio-buttons)) .
     6482               g#log = Find-By:disable(radio-label('код':U, Find-by:radio-buttons)) .
     6483           end.
     6484           else do:
     6485             assign
     6486             NameOrCode:width-chars = 24.63
     6487             NameOrCode:format = "X(40)"
     6488             .
     6489             g#log = Find-By:disable(radio-label('код':U, Find-by:radio-buttons)) .
     6490             g#log = Find-By:disable(radio-label('ИНН':U, Find-by:radio-buttons)) .
     6491           end.
     6492           run waitfram-hide in this-procedure .
     6493           apply "entry" to NameOrCode in frame Dialog-Frame .
     6494         end.
     6495      END CASE .
     6496     end.
     6497   END PROCEDURE.
     6498   PROCEDURE reopen-query :
     6499   define variable ri as recid no-undo .
     6500   if available X_clients then
     6501   ri = recid(X_clients).
     6502   case var-br-name :         when "cli-list":U then do:            Run OpenBR in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listA":U then do:            Run OpenBRA in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listB":U then do:            Run OpenBRB in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         end case.
     6503   case var-br-name :         when "cli-list":U then do:            reposition Cli-List to recid ri no-error .         end.         when "cli-listA":U then do:            reposition Cli-ListA to recid ri no-error .         end.         when "cli-listB":U then do:            reposition Cli-ListB to recid ri no-error .          end.         end case.
     6504   if error-status:error then do:
     6505         find first pos_clients no-lock where       recid( pos_clients ) = ri no-error .   message  substitute("Невозможно позиционироваться на клиенте &1&2Клиент был добавлен (или изменен или удален)&2и теперь не попадает в текущую выборку"             ,(if available pos_clients then (pos_clients.obj-type + string(pos_clients.obj-code)) else '':U)              , chr(10)) view-as alert-box WARNING.
     6506   end.
     6507   case var-br-name :         when "cli-list":U then do:            apply "entry" to Cli-List in frame Dialog-Frame.         end.         when "cli-listA":U then do:            apply "entry" to Cli-ListA in frame Dialog-Frame.         end.         when "cli-listB":U then do:            apply "entry" to Cli-ListB in frame Dialog-Frame.         end.         end case.
     6508   case var-br-name :         when "cli-list":U then do:            apply "value-changed" to Cli-List in frame Dialog-Frame .         end.         when "cli-listA":U then do:            apply "value-changed" to Cli-ListA in frame Dialog-Frame .         end.         when "cli-listB":U then do:             apply "value-changed" to Cli-ListB in frame Dialog-Frame .         end.         end case.
     6509   END PROCEDURE.
     6510   PROCEDURE StartProc :
     6511   define input parameter p-step as integer no-undo .
