     5550   define variable log-res as logical no-undo.
     5551   RUn Switch-Buttons in this-procedure ( input p-needmes) No-ERROR.
     5552   if v-is-prod then do :
     5553     show-as = 'про':U + left-trim(show-as,entry(1,show-as,"-")) .
     5554   end.
     5555   if show-as begins ('про':U + "-" + 'все':U) then do:
     5556      run ref/cli-all1.p (input  p-open-query , input  p-find-next ,  input  p-find-condition ,  INPUT parParentProc ,  input attr-option_ ,  input show-as ,  input JoinType ,  input Cli-Types ,  input Curr-Grp-Name ,  input NameOrCode ,  input SupGds     ,  input SupCons    ,  input SupServ    ,  input BuyGds     ,  input BuyCons    ,  input BuyServ    ,  input WLim-kr    ,  input false      ,  input-output v-rid-list ,  input filter-point  ,  input filter-point0 ,  input sort-column-name ,  output v-filter-name ,  input-output v-doc-rec ) . .
     5557   end.
