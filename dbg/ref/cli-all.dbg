     5238   .
     5239   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5240   on f5 of frame Dialog-Frame anywhere
     5241   do:
     5242     run reopen-query in this-procedure no-error.
     5243       apply "VALUE-CHANGED" to CLi-List.
     5244   end.
     5245   MAIN-BLOCK:
     5246   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     5247      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     5248       run gbl/dftempl.p ( input "clients-attr":U, output template-recid) no-error.
     5249       if error-status:error then dO:
     5250         message
     5251         vss-workfile vss-revision vss-description skip
     5252         "Невозможно найти recid template записи в таблице clients-attr"
     5253         view-as alert-box error .
     5254         return error.
     5255       end.
     5256     assign
     5257     filter-point0 = "cli-all"  + chr(4) + "Клиенты" + chr(4) + string(no)
     5258     filter-point = filter-point0
     5259     .
     5260     v-rid-list = p-rid-list.
     5261     FIND FIRST ub.sys-ctrl No-LOCK no-error.
     5262     FIND FIRST ub.db WHERE ub.db.db-num = ub.sys-ctrl.db-num NO-LOCK .
     5263     if lookup(c-other, "s-deploy":U, ";":U) > 0
     5264     or lookup(c-other, "news":U, ";":U) > 0
     5265     then do:
     5266   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5267     run mainmenu_getcntxt in parparentproc
     5268       (output v-cntxt-db-num
     5269       ,output v-cntxt-userid
     5270       ,output v-cntxt-level
     5271       ,output v-cntxt-host-code-obj
     5272       ,output v-cntxt-obj-type
     5273       ,output v-cntxt-obj-code
     5274       ,output v-cntxt-db-num-obj
     5275       ,output v-cntxt-is-admin
     5276       ) .
     5277     end.
     5278     else do:
     5279   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5280     run mainmenu_getcntxt in parparentproc
     5281       (output v-cntxt-db-num
     5282       ,output v-cntxt-userid
     5283       ,output v-cntxt-level
     5284       ,output v-cntxt-host-code-obj
     5285       ,output v-cntxt-obj-type
     5286       ,output v-cntxt-obj-code
     5287       ,output v-cntxt-db-num-obj
     5288       ,output v-cntxt-is-admin
     5289       ) .
     5290     end.
     5291     RUN StartProc  in this-procedure ( input 1).
     5292     RUN Myenable.
     5293     RUN StartProc  in this-procedure ( input 2).
     5294     WAIT-FOR GO OF FRAME Dialog-Frame.
     5295   END.
     5296   RUN disable_UI.
     5297   PROCEDURE br-mouse-select :
     5298   if b-sel:sensitive in frame Dialog-Frame then
     5299     if b-mark:sensitive then
     5300         apply "choose" to b-mark in frame Dialog-Frame.
     5301     else
     5302         apply "choose" to b-sel in frame Dialog-Frame.
     5303     else
     5304     if b-lkp:sensitive then
     5305         apply "choose" to b-lkp in frame Dialog-Frame.
     5306   END PROCEDURE.
     5307   PROCEDURE br-return :
     5308       if b-sel:sensitive in frame Dialog-Frame then
     5309           apply "choose" to b-sel in frame Dialog-Frame.
     5310       else
     5311           if b-lkp:sensitive then
     5312               apply "choose" to b-lkp in frame Dialog-Frame.
     5313   END PROCEDURE.
     5314   PROCEDURE disable_UI :
     5315     HIDE FRAME Dialog-Frame.
     5316   END PROCEDURE.
     5317   PROCEDURE enable_UI :
     5318     DISPLAY Find-by NameOrCode All-Or-Group Cli-Types Cli-Status mark-num
     5319         WITH FRAME Dialog-Frame.
     5320     ENABLE b-quit B-mark B-sel B-bank B-docs Goods-by-prod b-dc b-zak b-sert
     5321            B-attr b-hist b-print B-sch B-Help RECT-status RECT-types
     5322            RECT-All-or-Group B-add B-add-prs B-lkp b-chg b-del B-price-type
     5323            B-cont B-grp B-edi B-photo Find-by NameOrCode CLi-ListB CLi-ListA
     5324            CLi-List All-Or-Group Del-Filters Cli-Types Cli-Status mark-num
     5325         WITH FRAME Dialog-Frame.
     5326     VIEW FRAME Dialog-Frame.
     5327   END PROCEDURE.
     5328   PROCEDURE gdsbypr :
     5329   DEFINE INPUT PARAMETER rc as recid.
     5330   DEFINE INPUT PARAMETER calling as character.
     5331   define variable v-ri-list as character no-undo .
     5332   DEFINE VARIABLE v-output as character no-undo.
     5333   define variable v-input-output as character no-undo .
     5334   define variable v-from-date as date no-undo .
     5335   define variable v-to-date as date no-undo .
     5336   define variable glog as logical no-undo .
     5337   define buffer g-producer for ub.clients.
     5338   CASE calling:
     5339     WHEN "Товары по производителю" THEN  do:
     5340       if not X_clients.is-prod then do:
     5341           message "Клиент не является производителем!" view-as alert-box WARNING.
     5342           return error.
     5343       end.
     5344       FIND g-producer WHERE recid( g-producer ) = rc no-lock .
     5345       run ref/gds-ref.p (
     5346                      input  parparentproc
     5347                     ,input  ""
     5348                     ,input 'все':U
     5349                     ,input 'Производитель':U
     5350                     ,input 'все':U
     5351                     ,input ?
     5352                     ,input ?
     5353                     ,input g-producer.obj-type
     5354                     ,input g-producer.obj-code
     5355                     ,input ?
     5356                     ,input ?
     5357                     ,input ?
     5358                     ,output v-ri-list ).
     5359     end.
     5360     WHEN "Остатки по поставщику (партии)" THEN DO:
     5361       if not (X_clients.sup-gds OR X_clients.sup-cons) then do:
     5362             message "Клиент не является поставщиком!" view-as alert-box WARNING.
     5363             return error.
     5364       end.
     5365       run rep/supp-gds.w (
     5366                             input parparentproc
     5367                           ,input v-cntxt-obj-type
     5368                           ,input v-cntxt-obj-code
     5369                           ,input "stock"
     5370                           ,input "current"
     5371                           ,input X_clients.obj-type
     5372                           ,input X_clients.obj-code).
     5373     END.
     5374     WHEN "Остатки по поставщику (товары)" THEN DO:
     5375       if not (X_clients.sup-gds OR X_clients.sup-cons) then do:
     5376         message "Клиент не является поставщиком!"
     5377         view-as alert-box WARNING.
     5378         return error.
     5379       end.
     5380       run ref/cli-gdss.w (
     5381                       input parparentproc
     5382                      ,input 'Контрагент,Остатки':U
     5383                      ,input ?
     5384                      ,input rc
     5385                      ) .
     5386     END.
     5387     WHEN "Обороты по поставщику (партии)" THEN DO:
     5388       if not (X_clients.sup-gds OR X_clients.sup-cons) then do:
     5389         message
     5390         "Клиент не является поставщиком!"
     5391         view-as alert-box WARNING.
     5392         return error.
     5393       end.
     5394       run gbl/get-per.w ( output glog, input-output v-from-date, input-output v-to-date) .
     5395       if not glog then return.
     5396       run ref/vspartsr.p (
     5397                       input parparentproc
     5398                      ,input v-cntxt-obj-type
     5399                      ,input v-cntxt-obj-code
     5400                      ,input v-from-date
     5401                      ,input v-to-date
     5402                      ,input 'все':U
     5403                      ,input '':U
     5404                      ,input recid(X_clients)
     5405                      ) no-error .
     5406     END.
     5407     WHEN "Обороты по поставщику (товары)" THEN DO:
     5408       if not (X_clients.sup-gds OR X_clients.sup-cons) then do:
     5409         message
     5410         "Клиент не является поставщиком!"
     5411         view-as alert-box WARNING.
     5412         return error.
     5413       end.
     5414       assign
     5415       v-from-date = ?
     5416       v-to-date = ?
     5417       .
     5418       run gbl/get-per.w ( output glog, input-output v-from-date, input-output v-to-date) .
     5419       if not glog then return.
     5420       run rep/v-suppl.w (
     5421                      input parparentproc
     5422                     ,input v-cntxt-obj-type
     5423                     ,input v-cntxt-obj-code
     5424                     ,input v-from-date
     5425                     ,input v-to-date
     5426                     ,input string(rc)
     5427                     ).
     5428     END.
     5429     WHEN "Обороты по контрагенту" THEN DO:
     5430       run ref/cli-gdss.w (
     5431                       input parparentproc
     5432                      ,input 'Контрагент,Обороты':U
     5433                      ,input ?
     5434                      ,input rc
     5435                      ).
     5436     END.
     5437   END CASE.
     5438   END PROCEDURE.
     5439   PROCEDURE lkp-rec :
     5440     define parameter buffer bp-clients for ub.clients.
     5441     if not available bp-clients THEN do:
     5442       return.
     5443     end.
     5444     run ref/showcli.p (
     5445        input parParentProc
     5446       ,input bp-clients.obj-type
     5447       ,input bp-clients.obj-code
     5448       ).
     5449   END PROCEDURE.
     5450   PROCEDURE MyEnable :
     5451   ASSIGN  Cli-List:MAX-DATA-GUESS IN FRAME Dialog-Frame     = 200.
     5452   ASSIGN  Cli-ListA:MAX-DATA-GUESS IN FRAME Dialog-Frame     = 200.
     5453   ASSIGN  Cli-ListB:MAX-DATA-GUESS IN FRAME Dialog-Frame     = 200.
     5454   ASSIGN
     5455   Goods-By-Prod:MENU-MOUSE = 1
     5456   b-attr:MENU-MOUSE in frame Dialog-Frame = 1
     5457   b-sert:MENU-MOUSE in frame Dialog-Frame = 1
     5458   .
     5459   assign
     5460   var-cli-name:resizable in browse cli-list = true
