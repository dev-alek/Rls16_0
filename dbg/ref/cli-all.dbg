     2523   case var-br-name :         when "cli-list":U then do:            apply "entry" to Cli-List in frame Dialog-Frame.         end.         when "cli-listA":U then do:            apply "entry" to Cli-ListA in frame Dialog-Frame.         end.         when "cli-listB":U then do:            apply "entry" to Cli-ListB in frame Dialog-Frame.         end.         end case.
     2524   END.
