     4396           end.
     4397           assign
     4398             v-diasize-change-size = false
     4399           .
     4400           leave move_block .
     4401         end.
     4402       end.
     4403       assign
     4404         v-diasize-need-full-display = true
     4405       .
     4406       if v-diasize-change-size = false
     4407       then do:
     4408         assign
     4409           v-diasize-change-size = true
     4410         .
     4411       end.
     4412       else do:
     4413         return .
     4414       end.
     4415       assign
     4416         v-frame-width = frame Dialog-Frame :width
     4417         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     4418         v-browse-width = v-diasize-browse-handle :width
     4419       .
     4420       for each buf_temp-browse-handle
     4421         where buf_temp-browse-handle.browse-type = 'width':u
     4422       :
     4423         assign
     4424           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     4425         .
     4426       end.
     4427       for each buf_temp-diasize-handle
     4428       :
     4429         delete buf_temp-diasize-handle .
     4430       end.
     4431       assign
     4432         v-field-group-handle = frame Dialog-Frame :first-child
     4433       .
     4434       do while valid-handle(v-field-group-handle)
     4435       :
     4436         assign
     4437           v-object-handle = v-field-group-handle :first-child
     4438         .
     4439         do while valid-handle(v-object-handle)
     4440         :
     4441           if  v-object-handle <> v-diasize-browse-handle :handle
     4442           and v-object-handle <> v-diasize-resize-button
     4443           and can-query(v-object-handle, "row")
     4444           and can-query(v-object-handle, "height")
     4445           and ( v-object-handle :col + v-object-handle :width
     4446                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     4447               )
     4448           then do:
     4449             find first buf_temp-browse-handle
     4450               where buf_temp-browse-handle.browse-type   = 'width':u
     4451                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4452               no-error .
     4453             if available buf_temp-browse-handle
     4454             then do:
     4455             end.
     4456             else do:
     4457               create buf_temp-diasize-handle .
     4458               assign
     4459                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4460                 buf_temp-diasize-handle.save-position = v-object-handle :col
     4461               .
     4462             end.
     4463           end.
     4464           assign
     4465             v-object-handle = v-object-handle :next-sibling
     4466           .
     4467         end.
     4468         assign
     4469           v-field-group-handle = v-field-group-handle :next-sibling
     4470         .
     4471       end.
     4472       do with frame Dialog-Frame
     4473       :
     4474         hide v-diasize-resize-button .
     4475         v-diasize-resize-button :row = 1.
     4476         v-diasize-resize-button :column = 1.
     4477       end.
     4478       if p-change-value > 0
     4479       then do:
     4480         if frame Dialog-Frame :scrollable = true
     4481         then do:
     4482           assign
     4483             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4484             no-error .
     4485           if error-status :error
     4486           or error-status :get-message(1) <> ""
     4487           then do:
     4488             undo move_block, retry move_block.
     4489           end.
     4490         end.
     4491         assign
     4492           frame Dialog-Frame :width = v-frame-width + p-change-value
     4493           no-error .
     4494         if error-status :error
     4495         or error-status :get-message(1) <> ""
     4496         then do:
     4497           undo move_block, retry move_block.
     4498         end.
     4499         assign
     4500           v-diasize-browse-handle :width = v-browse-width + p-change-value
     4501         no-error .
     4502         if error-status :error
     4503         or error-status :get-message(1) <> ""
     4504         then do:
     4505           undo move_block, retry move_block.
     4506         end.
     4507         for each buf_temp-browse-handle
     4508           where buf_temp-browse-handle.browse-type = 'width':u
     4509         on error undo move_block, retry move_block
     4510         :
     4511           assign
     4512             buf_temp-browse-handle.browse-handle :width
     4513               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4514             no-error .
     4515           if error-status :error
     4516           or error-status :get-message(1) <> ""
     4517           then do:
     4518             undo move_block, retry move_block .
     4519           end.
     4520         end.
     4521         for each buf_temp-diasize-handle
     4522         on error undo move_block, retry move_block
     4523         :
     4524           assign
     4525             v-object-handle = buf_temp-diasize-handle.handle-value
     4526           .
     4527           if v-object-handle <> v-diasize-resize-button
     4528           then do:
     4529             assign
     4530               v-object-handle :col = v-object-handle :col + p-change-value
     4531               no-error .
     4532             if error-status :error
     4533             or error-status :get-message(1) <> ""
     4534             then do:
     4535               undo move_block, retry move_block .
     4536             end.
     4537           end.
     4538         end.
     4539       end.
     4540       else do:
     4541         for each buf_temp-diasize-handle
     4542         on error undo move_block, retry move_block
     4543         :
     4544           assign
     4545             v-object-handle = buf_temp-diasize-handle.handle-value
     4546           .
     4547           if v-object-handle <> v-diasize-resize-button
     4548           then do:
     4549             assign
     4550               v-object-handle :col = v-object-handle :col + p-change-value
     4551               no-error .
     4552             if error-status :error
     4553             or error-status :get-message(1) <> ""
     4554             then do:
     4555               undo move_block, retry move_block .
     4556             end.
     4557           end.
     4558         end.
     4559         for each buf_temp-browse-handle
     4560           where buf_temp-browse-handle.browse-type = 'width':u
     4561         on error undo move_block, retry move_block
     4562         :
     4563           assign
     4564             buf_temp-browse-handle.browse-handle :width
     4565               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4566             no-error .
     4567           if error-status :error
     4568           or error-status :get-message(1) <> ""
     4569           then do:
     4570             undo move_block, retry move_block .
     4571           end.
     4572         end.
     4573         assign
     4574           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     4575           no-error .
     4576         if error-status :error
     4577         or error-status :get-message(1) <> ""
     4578         then do:
     4579           undo move_block, retry move_block.
     4580         end.
     4581         assign
     4582           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     4583         no-error .
     4584         if error-status :error
     4585         or error-status :get-message(1) <> ""
     4586         then do:
     4587           undo move_block, retry move_block.
     4588         end.
     4589         if frame Dialog-Frame :scrollable = true
     4590         then do:
     4591           assign
     4592             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4593           no-error .
     4594           if error-status :error
     4595           or error-status :get-message(1) <> ""
     4596           then do:
     4597             undo move_block, retry move_block.
     4598           end.
     4599         end.
     4600       end.
     4601       if p-move-resize
     4602       then do:
     4603         run diasize_position-resize-button in this-procedure .
     4604       end.
     4605       if v-diasize-wndstore = true
     4606       then do:
     4607         if connected("ub") = true
     4608         then do:
     4609           define variable v-cntxt-db-num        as integer   no-undo .
     4610           define variable v-cntxt-userid        as character no-undo .
     4611           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4612                                             , OUTPUT v-cntxt-userid
     4613                                             ) .
     4614           run gbl/wndsizew.p
     4615             (input  v-cntxt-db-num
     4616             ,input  v-cntxt-userid
     4617             ,input  v-diasize-proc-name
     4618             ,input  'width':u
     4619             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     4620             ) .
     4621         end.
     4622       end.
     4623     end.
     4624     assign
     4625       v-diasize-change-size = false
     4626     .
     4627   end procedure.
     4628   procedure diasize_set-width :
     4629     define input  parameter p-new-width  as decimal   no-undo .
     4630     define input  parameter p-move-resize as logical   no-undo .
     4631     do
     4632     on error undo, return error return-value
     4633     :
     4634       run diasize_change-width in this-procedure
     4635         (input  (p-new-width - frame Dialog-Frame :width)
     4636         ,input  p-move-resize
     4637         ) .
     4638     end.
     4639   end procedure.
     4640   procedure diasize_position-resize-button :
     4641     do with frame Dialog-Frame
     4642     :
     4643       hide v-diasize-resize-button .
     4644       assign
     4645         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     4646                     - 1
     4647                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     4648         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     4649                     - 1
     4650                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     4651       .
     4652       view v-diasize-resize-button .
     4653     end.
     4654   end procedure.
     4655   on alt-right anywhere
     4656   do:
     4657     run diasize_change-width in this-procedure
     4658       (input 1
     4659       ,input true
     4660       ) .
     4661     return no-apply .
     4662   end.
     4663   on alt-left anywhere
     4664   do:
     4665     run diasize_change-width in this-procedure
     4666       (input -1
     4667       ,input true
     4668       ) .
     4669     return no-apply .
     4670   end.
     4671   on alt-down anywhere
     4672   do:
     4673     run diasize_change-height in this-procedure
     4674       (input 1
     4675       ,input true
     4676       ) .
     4677     return no-apply .
     4678   end.
     4679   on alt-up anywhere
     4680   do:
     4681     run diasize_change-height in this-procedure
     4682       (input -1
     4683       ,input true
     4684       ) .
     4685     return no-apply .
     4686   end.
     4687   on alt-enter of frame Dialog-Frame
     4688   do:
     4689     run diasize_maximize in this-procedure
     4690       (input  ?
     4691       ).
     4692     return no-apply .
     4693   end.
     4694   procedure diasize_end-move :
     4695     do
     4696     on error undo, return error return-value
     4697     :
     4698       define variable v-row-delta as decimal   no-undo .
     4699       define variable v-col-delta as decimal   no-undo .
     4700       define variable v-new-row as decimal   no-undo .
     4701       define variable v-new-col as decimal   no-undo .
     4702       assign
     4703         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4704         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4705       .
     4706       assign
     4707         v-row-delta = v-new-row - frame Dialog-Frame :height
     4708         v-col-delta = v-new-col - frame Dialog-Frame :width
     4709       .
     4710       run diasize_change-height in this-procedure
     4711         (input v-row-delta
     4712         ,input true
     4713         ) .
     4714       run diasize_change-width in this-procedure
     4715         (input v-col-delta
     4716         ,input true
     4717         ) .
     4718     end.
     4719   end procedure.
     4720   procedure diasize_maximize :
     4721     define input  parameter p-action as logical   no-undo .
     4722     do
     4723     on error undo, return error return-value
     4724     :
     4725       if p-action = ?
     4726       then do:
     4727         if v-diasize-need-maximize = true
     4728         then do:
     4729           assign
     4730             p-action = true
     4731           .
     4732         end.
     4733         else do:
     4734           assign
     4735             p-action = false
     4736           .
     4737         end.
     4738       end.
     4739       if p-action = true
     4740       then do:
     4741         run diasize_change-height in this-procedure
     4742           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4743               - frame Dialog-Frame :height-chars
     4744           ,input true
     4745           ) .
     4746         run diasize_change-width in this-procedure
     4747           (input session :width-chars
     4748               - frame Dialog-Frame :width-chars
     4749           ,input true
     4750           ) .
     4751         assign
     4752           v-diasize-need-maximize = false
     4753         .
     4754       end.
     4755       else do:
     4756         run diasize_change-width in this-procedure
     4757           (input v-diasize-orig-frame-width
     4758               - frame Dialog-Frame :width-chars
     4759           ,input true
     4760           ) .
     4761         run diasize_change-height in this-procedure
     4762           (input v-diasize-orig-frame-height
     4763               - frame Dialog-Frame :height-chars
     4764           ,input true
     4765           ) .
     4766         assign
     4767           v-diasize-need-maximize = true
     4768         .
     4769       end.
     4770     end.
     4771   end procedure.
     4772   procedure diasize_restore-orig-size :
     4773     do
     4774     on error undo, return error return-value
     4775     :
     4776       assign
     4777         v-diasize-current-frame-width  = frame Dialog-Frame :width
     4778         v-diasize-current-frame-height = frame Dialog-Frame :height
     4779       .
     4780       run diasize_set-height in this-procedure
     4781         (input  v-diasize-orig-frame-height
     4782         ,input  true
     4783         ) .
     4784       run diasize_set-width in this-procedure
     4785         (input  v-diasize-orig-frame-width
     4786         ,input  true
     4787         ) .
     4788     end.
     4789   end procedure.
     4790   procedure diasize_restore-current-size :
     4791     do
     4792     on error undo, return error return-value
     4793     :
     4794       run diasize_set-height in this-procedure
     4795         (input  v-diasize-current-frame-height
     4796         ,input  true
     4797         ) .
     4798       run diasize_set-width in this-procedure
     4799         (input  v-diasize-current-frame-width
     4800         ,input  true
     4801         ) .
     4802     end.
     4803   end procedure.
     4804   procedure diasize_set-browse-handle :
     4805     define input  parameter p-browse-handle as handle   no-undo .
     4806     define buffer buf_temp-browse-handle for temp-browse-handle .
     4807     do
     4808     on error undo, return error return-value
     4809     :
     4810       assign
     4811         v-diasize-browse-handle = p-browse-handle
     4812       .
     4813       for each buf_temp-browse-handle
     4814       on error undo, return error return-value
     4815       :
     4816         delete buf_temp-browse-handle .
     4817       end.
     4818     end.
     4819   end procedure.
     4820   procedure diasize_add_browse :
     4821     define input  parameter p-browse-type   as character no-undo .
     4822     define input  parameter p-browse-handle as handle    no-undo .
     4823     define buffer buf_temp-browse-handle for temp-browse-handle .
     4824     do
     4825     on error undo, return error return-value
     4826     :
     4827       assign
     4828         v-diasize-browse-number = v-diasize-browse-number + 1
     4829       .
     4830       create buf_temp-browse-handle .
     4831       assign
     4832         buf_temp-browse-handle.browse-type   = p-browse-type
     4833         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4834         buf_temp-browse-handle.browse-handle = p-browse-handle
     4835       .
     4836     end.
     4837   end procedure.
     4838   procedure diasize_init :
     4839     define variable v-default-value    as logical   no-undo .
     4840     define variable v-restore-saved    as logical   no-undo .
     4841     define variable v-resize-value-str as character no-undo .
     4842     do
     4843     on error undo, return error return-value
     4844     :
     4845       do with frame Dialog-Frame
     4846       :
     4847         assign
     4848           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4849           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4850           v-diasize-browse-handle     = browse CLi-List :handle
     4851         .
     4852         create button v-diasize-resize-button
     4853         assign
     4854           parent        = frame Dialog-Frame :first-child
     4855           label         = "s"
     4856           height-pixels = 16
     4857           width-pixels  = 16
     4858           visible       = true
     4859           sensitive     = true
     4860           movable       = true
     4861           triggers:
     4862             on end-move persistent run diasize_end-move in this-procedure .
     4863           end triggers.
     4864         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4865         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4866         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4867         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4868         assign
     4869           v-diasize-wndmax = false
     4870         .
     4871         if connected("ub") = true
     4872         then do:
     4873           define variable v-cntxt-db-num        as integer   no-undo .
     4874           define variable v-cntxt-userid        as character no-undo .
     4875           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4876                                             , OUTPUT v-cntxt-userid
     4877                                             ) .
     4878           run gbl/wndpar_r.p
     4879             (input  v-cntxt-db-num
     4880             ,input  v-cntxt-userid
     4881             ,input  'wndmax':U
     4882             ,output v-diasize-wndmax
     4883             ,output v-default-value
     4884             ) .
     4885         end.
     4886         assign
     4887           v-diasize-wndstore = false
     4888         .
     4889         if connected("ub") = true
     4890         then do:
     4891           run gbl/wndpar_r.p
     4892             (input  v-cntxt-db-num
     4893             ,input  v-cntxt-userid
     4894             ,input  'wndstore':U
     4895             ,output v-diasize-wndstore
     4896             ,output v-default-value
     4897             ) .
     4898         end.
     4899         assign
     4900           v-diasize-proc-name = entry(1, program-name(2), '.')
     4901         .
     4902         if v-diasize-wndstore = true
     4903         then do:
     4904           assign
     4905             v-restore-saved = false
     4906           .
     4907           if connected("ub") = true
     4908           then do:
     4909             run gbl/wndsizer.p
     4910               (input  v-cntxt-db-num
     4911               ,input  v-cntxt-userid
     4912               ,input  v-diasize-proc-name
     4913               ,input  'height':u
     4914               ,output v-resize-value-str
     4915               ) .
     4916             if v-resize-value-str <> '':U
     4917             then do:
     4918               run diasize_change-height in this-procedure
     4919                 (input  integer(v-resize-value-str)
     4920                 ,input  true
     4921                 ) .
     4922               assign
     4923                 v-restore-saved = true
     4924               .
     4925             end.
     4926           end.
     4927           if connected("ub") = true
     4928           then do:
     4929             run gbl/wndsizer.p
     4930               (input  v-cntxt-db-num
     4931               ,input  v-cntxt-userid
     4932               ,input  v-diasize-proc-name
     4933               ,input  'width':u
     4934               ,output v-resize-value-str
     4935               ) .
     4936             if v-resize-value-str <> '':U
     4937             then do:
     4938               run diasize_change-width in this-procedure
     4939                 (input  integer(v-resize-value-str)
     4940                 ,input  true
     4941                 ) .
     4942               assign
     4943                 v-restore-saved = true
     4944               .
     4945             end.
     4946           end.
     4947           if v-restore-saved <> true
     4948           then do:
     4949             if v-diasize-wndmax = true
     4950             then do:
     4951               run diasize_maximize in this-procedure
     4952                 (input  true
     4953                 ) .
     4954             end.
     4955           end.
     4956         end.
     4957         else do:
     4958           if v-diasize-wndmax = true
     4959           then do:
     4960             run diasize_maximize in this-procedure
     4961               (input  true
     4962               ) .
     4963           end.
     4964         end.
     4965       end.
     4966     end.
     4967   end procedure.
     4968   procedure diasize_need-full-display :
     4969     define output parameter p-need-full-display as logical   no-undo .
     4970     do
     4971     on error undo, return error return-value
     4972     :
     4973       assign
     4974         p-need-full-display = v-diasize-need-full-display
     4975       .
     4976       assign
     4977         v-diasize-need-full-display = false
     4978       .
     4979     end.
     4980   end procedure.
     4981   procedure get-context :
     4982      define output parameter p-db-num as integer          no-undo.
     4983      define output parameter p-user-id as character        no-undo.
     4984      define variable v-login               as character    no-undo.
     4985      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4986      define buffer buf_user-login  for ub.user-login .
     4987      do
     4988      on error undo, return error
     4989      :
     4990            FIND FIRST buf_sys-ctrl no-lock.
     4991            ASSIGN
     4992               v-login = USERID("ub")
     4993               p-db-num = buf_sys-ctrl.db-num
     4994            .
     4995            FIND FIRST buf_user-login
     4996                 WHERE buf_user-login.db-num = p-db-num
     4997                   AND buf_user-login.user-login = v-login
     4998                 no-lock
     4999                 no-error
     5000                 .
     5001            IF AVAILABLE buf_user-login
     5002            THEN DO:
     5003               assign
     5004                  p-user-id = buf_user-login.user-id
     5005               .
     5006            END.
     5007      end.
     5008   end procedure.
     5009       run diasize_init in this-procedure .
     5010   g#log = cli-list:SET-REPOSITIONED-ROW(5, "CONDITIONAL").
     5011   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5012   DEF VAR cur-clmn-numcli-list as INT EXTENT 16 no-undo.
     5013   DEF VAR varmvicli-list       as INT no-undo.
     5014   DEF VAR varmvjcli-list       as INT no-undo.
     5015   DEF VAR varmvkcli-list       as INT no-undo.
     5016   DEF VAR varmvlcli-list       as INT no-undo.
     5017   DEF VAR move-elementcli-list as INT no-undo.
     5018   def var jjcli-list           as int no-undo.
     5019   do varmvicli-list = 1 to EXTENT(cur-clmn-numcli-list):
     5020     ASSIGN cur-clmn-numcli-list[varmvicli-list] = varmvicli-list.
     5021   END.
     5022   RUN start-mv-clmncli-list.
     5023   PROCEDURE start-mv-clmncli-list:
     5024   def var old-session as logical no-undo.
     5025      old-session = SESSION:IMMEDIATE-DISPLAY.
     5026      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     5027      SESSION:IMMEDIATE-DISPLAY = old-session.
     5028   END.
     5029   ON ctrl-cursor-right OF BROWSE cli-list do:
     5030     RUN re-move-clmncli-list ( 1, 16).
     5031   END.
     5032   ON ctrl-cursor-left OF BROWSE cli-list do:
     5033     RUN re-move-clmncli-list (16, 1).
     5034   END.
     5035   PROCEDURE re-move-clmncli-list:
     5036     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     5037     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     5038     DO varmvicli-list = 1 TO EXTENT(cur-clmn-numcli-list):
     5039       if cur-clmn-numcli-list[varmvicli-list] = source-column THEN cur-clmn-numcli-list[varmvicli-list] = -1.
     5040     END.
     5041     if cli-list:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     5042     if source-column > target-column THEN
     5043     DO varmvjcli-list = source-column - 1 to target-column BY -1:
     5044       DO varmvicli-list = 1 TO EXTENT(cur-clmn-numcli-list):
     5045           if cur-clmn-numcli-list[varmvicli-list] = varmvjcli-list THEN DO:
     5046             cur-clmn-numcli-list[varmvicli-list] = cur-clmn-numcli-list[varmvicli-list] + 1.
     5047           END.
     5048       END.
     5049     END.
     5050     ELSE
     5051     DO varmvjcli-list = source-column + 1 to target-column:
     5052       DO varmvicli-list = 1 TO EXTENT(cur-clmn-numcli-list):
     5053         if cur-clmn-numcli-list[varmvicli-list] = varmvjcli-list THEN DO:
     5054           cur-clmn-numcli-list[varmvicli-list] = cur-clmn-numcli-list[varmvicli-list] - 1.
     5055         END.
     5056       END.
     5057     END.
     5058     DO varmvicli-list = 1 TO EXTENT(cur-clmn-numcli-list):
     5059       if cur-clmn-numcli-list[varmvicli-list] = -1 THEN cur-clmn-numcli-list[varmvicli-list] = target-column.
     5060     END.
     5061   END PROCEDURE.
     5062   PROCEDURE ch-clmncli-list:
     5063     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     5064     if cur-clmn-loc <= 1 then do:
     5065       return .
     5066     end.
     5067     DO varmvicli-list = 1 TO EXTENT(cur-clmn-numcli-list):
     5068       if cur-clmn-numcli-list[varmvicli-list] = cur-clmn-loc THEN move-elementcli-list = varmvicli-list.
     5069     END.
     5070     RUN re-move-clmncli-list (cur-clmn-loc, 1).
     5071   END PROCEDURE.
     5072   PROCEDURE mv-brw-defaultcli-list:
     5073   def var old-session as logical no-undo.
     5074     old-session = SESSION:IMMEDIATE-DISPLAY.
     5075     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     5076     do varmvlcli-list = 1 to EXTENT(cur-clmn-numcli-list):
     5077       RUN re-move-clmncli-list (cur-clmn-numcli-list[varmvlcli-list], varmvlcli-list).
     5078     END.
     5079     RUN start-mv-clmncli-list.
     5080     SESSION:IMMEDIATE-DISPLAY = old-session.
     5081   END PROCEDURE.
