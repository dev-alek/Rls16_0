     5532   with frame Dialog-Frame.
     5533   if var-prev-br-name <> var-br-name then do:
     5534     CASE var-prev-br-name:
     5535       when '':U then do:
     5536       end.
     5537       when "cli-list" then do:
     5538          close query cli-list.
     5539       end.
     5540       when "cli-lista" then do:
     5541          close query cli-lista.
     5542       end.
     5543       when "cli-listb" then do:
     5544          close query cli-listb.
     5545       end.
     5546     end case.
     5547   end.
     5548   entry(1, filter-point, chr(4))  = entry(1, filter-point0 , chr(4)) + cli-types.
