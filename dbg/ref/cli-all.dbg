     6609             v-grp-name-width = decimal(entry(2, v-uf-Naim, chr(4)))
     6610             .
     6611           end.
     6612         end.
     6613       end.
     6614       do ii = 1 to num-entries(c-other, ";":U):
     6615         if entry(1, entry(ii, c-other, ";":U), "=":U) = "without-obj":U then do:
