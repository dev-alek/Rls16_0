     2498         var-prev-br-name = var-br-name
     2499         var-br-name = "cli-list"
     2500         v-list-b = false
     2501         ALL-Or-GROUP
     2502         .
     2503         g-log = ALL-Or-GROUP:enable ( radio-label ( 'АТР':U, ALL-Or-GROUP:radio-buttons) ).
     2504     disable Del-Filters
     2505     with frame Dialog-Frame .
     2506     assign
     2507     All-Suppliers = FALSE
     2508     SupGds = FALSE
     2509     SupCons = FALSE
     2510     SupServ = FALSE
     2511     All-Buyers = FALSE
     2512     BuyGds = FALSE
     2513     BuyCons = FALSE
     2514     BuyServ = FALSE
     2515     JoinType = "NO"
     2516     WLim-kr = FALSE
     2517     f-turn-buyer =  false
     2518     f-grp-buyer  =  false
     2519     Find-By:screen-value = 'все':U
     2520     NameOrCode = ""
     2521     .
