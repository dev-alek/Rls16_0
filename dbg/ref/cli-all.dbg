     3287   ON VALUE-CHANGED OF Cli-Types IN FRAME Dialog-Frame
     3288   DO:
     3289       assign
     3290       v-is-prod = false
     3291       Find-By:screen-value = 'все':U
     3292       NameOrCode = ""
     3293       cli-types
     3294       getc-recid = if (
     3295                        cli-types = 'все':U or
     3296                        (avail X_clients and X_clients.is-prod and v-is-prod) OR
     3297                        (avail X_clients and cli-types = X_clients.obj-type) or
     3298                        (avail X_clients and (cli-types = 'объект':U or cli-types = "db") and (X_clients.obj-type = 'маг':U or X_clients.obj-type = 'скл':U))
     3299                       ) then yes else no
     3300       .
     3301       case cli-types:
     3302         when 'маг':U
     3303         or when 'скл':U
     3304         or when 'объект':U
     3305         then do:
     3306           assign
     3307           X_clients.db-num:visible in browse cli-list = yes
     3308           X_clients.host-code:visible in browse cli-list = yes
     3309           X_clients.db-num:visible in browse cli-lista = yes
     3310           X_clients.host-code:visible in browse cli-lista = yes
     3311           X_clients.db-num:visible in browse cli-listb = yes
     3312           X_clients.host-code:visible in browse cli-listb = yes
     3313           .
     3314         end.
     3315         when "db" then do:
     3316           assign
