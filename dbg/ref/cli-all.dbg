      131   end.
      132   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      134   define new shared variable RepPathName        as character no-undo .
      135   define new shared variable PrintRubl          as logical   no-undo .
      136   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137   define  stream PrnLibStream.
      138   procedure prn-lib-prn-file :
      139     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      140     define input parameter p-DIsabledoptions as integer no-undo .
      141     define variable v-report-name as character no-undo .
      142     define variable v-user-action as character no-undo .
      143     define variable v-printed     as logical   no-undo .
      144     define variable v-exist       as logical   no-undo .
      145     do
      146       on error undo, return error
      147       :
      148       run prn-lib-get-report-name  in this-procedure (
      149         input parParentProc
      150         ,output v-report-name
      151         ).
      152   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      153   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      154     (input  v-report-name
      155     ,input  2
      156     ,output v-exist
      157     )  .
      158       if NOT v-exist then
      159       DO:
      160         Message
      161           "Нет заданий на печать ! "
      162           view-as alert-box .
      163         Return  .
      164       End.
      165       run gbl/prnfilen.w
      166         (input  ""
      167         ,input  p-DisabledOptions
      168         ,input  string(v-report-name )
      169         ,input  7
      170         ,output v-user-action
      171         ,output v-printed
      172         ) .
      173       if v-printed then
      174       do:
      175         return "YES" .
      176       end.
      177       else
      178       do:
      179         return "NO" .
      180       end.
      181     end.
      182   end procedure.
      183   procedure prn-lib-open-stream :
      184     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      185     define input parameter p-page-size    as integer no-undo .
      186     define input parameter p-is-stream    as logical no-undo .
      187     define input parameter p-append       as logical no-undo .
      188     define variable v-report-name as character no-undo .
      189     do
      190       on error undo, return error
      191       :
      192       run prn-lib-get-report-name  in this-procedure (
      193         input parParentProc
      194         ,output v-report-name
      195         ).
      196       if p-is-stream then
      197       do:
      198         if p-append then
      199         do:
      200           output stream PrnLibStream to value( v-report-name )
      201             page-size value(p-page-size) append .
      202         end.
      203         if not p-append then
      204         do:
      205           output stream PrnLibStream to value( v-report-name )
      206             page-size value(p-page-size) .
      207         end.
      208       end.
      209       if not p-is-stream then
      210       do:
      211         if p-append then
      212         do:
      213           output to value( v-report-name )
      214             page-size value(p-page-size) append .
      215         end.
      216         if not p-append then
      217         do:
      218           output to value( v-report-name )
      219             page-size value(p-page-size) .
      220         end.
      221       end.
      222     end.
      223   end procedure.
      224   procedure prn-lib-open-exp :
      225     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      226     define input parameter p-is-stream    as logical no-undo .
      227     define input parameter p-is-append    as logical no-undo .
      228     define output parameter p-ReportFileName as char init "report" no-undo.
      229     define output parameter p-process as logical no-undo .
      230     define variable glog as logical no-undo .
      231     do
      232       on error undo, return error
      233       :
      234       SYSTEM-DIALOG GET-FILE p-ReportFileName
      235         TITLE      "Укажите путь"
      236         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      237         ASK-OVERWRITE
      238         CREATE-TEST-FILE
      239         SAVE-AS
      240         USE-FILENAME
      241         DEFAULT-EXTENSION "txt"
      242         UPDATE glog
      243         .
      244       if not glog then  return.
      245       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      246       if p-is-stream then
      247       do:
      248         if p-is-append then
      249         do:
      250           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      251         end.
      252         else
      253         do:
      254           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      255         end.
      256       end.
      257       else
      258       do:
      259         if p-is-append then
      260         do:
      261           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      262         end.
      263         else
      264         do:
      265           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      266         end.
      267       end.
      268       p-process = yes.
      269     end.
      270   end procedure.
      271   procedure prn-lib-get-report-name :
      272     define input parameter parParentProc  as widget-handle no-undo.
      273     define output parameter p-report-name as character no-undo .
      274     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      275   end procedure.
      276   procedure prn-lib-reportviewer-report-name :
      277     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      278     define input parameter p-report-name-html as character no-undo .
      279     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      280   end procedure.
      281   procedure prn-lib-reportviewer :
      282     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      283     define input parameter p-report-name-html as character no-undo .
      284     define input parameter p-param        as character no-undo .
      285     define variable v-excel           as character no-undo init 'TRUE' .
      286     define variable v-value-character as character no-undo .
      287     define variable v-value-integer   as character no-undo .
      288     define variable v-value-date      as date      no-undo .
      289     define variable v-value-decimal   as decimal   no-undo .
      290     define variable rep-excel         as logical   no-undo .
      291     define variable excel-string      as character no-undo .
      292     define variable v-param-type      as character no-undo .
      293     define variable v-tth             as handle    no-undo .
      294     run adm/shattri.p (
      295       input "get":U
      296       ,input  ""
      297       ,input  0
      298       ,input  'report-glob':U
      299       ,input  'rep-excel':U
      300       ,output v-value-character
      301       ,output v-value-date
      302       ,output v-value-decimal
      303       ,output v-value-integer
      304       ,output rep-excel
      305       ,output v-param-type
      306       ,INPUT-OUTPUT table-handle v-tth
      307       )  .
      308     if rep-excel then v-excel = "TRUE" .
      309     else v-excel = "FALSE" .
      310     if p-param eq ""
      311     then
      312        p-param = "EXCEL:" + v-excel.
      313     else
      314        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      315     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      316   end procedure.
      317   function diff-list returns character (
      318     input parfirst-list  as character,
      319     input parsecond-list as character,
      320     input pardelim       as character).
      321     if pardelim = ""
      322     or pardelim = ?
      323     then do:
      324       assign
      325         pardelim = ","
      326       .
      327     end.
      328     def var ind as integer no-undo .
      329     def var v-elem as character no-undo .
      330     def var v-result-list as character no-undo init "".
      331     def var v-num-parfirst-list as integer no-undo .
      332     assign
      333       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      334     .
      335     do ind = 1 to v-num-parfirst-list
      336     :
      337       assign
      338         v-elem = entry(ind, parfirst-list, pardelim)
      339       .
      340       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      341         assign
      342           v-result-list = v-result-list
      343                         + (if v-result-list > "" then pardelim else "")
      344                         + v-elem
      345         .
      346       end.
      347     end.
      348     return v-result-list .
      349   end function.
      350   function add-list returns character (
      351    input parfirst-list  as character,
      352    input parsecond-list as character,
      353    input pardelim       as character).
      354     if pardelim = ""
      355     or pardelim = ?
      356     then do:
      357       assign
      358         pardelim = ","
      359       .
      360     end.
      361     def var ind as integer no-undo .
      362     def var v-elem as character no-undo .
      363     def var v-result-list as character no-undo init "".
      364     def var v-num-parfirst-list as integer no-undo .
      365     assign
      366       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      367     .
      368     do ind = 1 to v-num-parfirst-list
      369     :
      370       assign
      371         v-elem = entry(ind, parfirst-list, pardelim)
      372       .
      373       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      374         assign
      375           v-result-list = v-result-list
      376                         + (if v-result-list > "" then pardelim else "")
      377                         + v-elem
      378         .
      379       end.
      380     end.
      381     def var v-num-parsecond-list as integer no-undo .
      382     assign
      383       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      384     .
      385     do ind = 1 to v-num-parsecond-list
      386     :
      387       assign
      388         v-elem = entry(ind, parsecond-list, pardelim)
      389       .
      390       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      391         assign
      392           v-result-list = v-result-list
      393                         + (if v-result-list > "" then pardelim else "")
      394                         + v-elem
      395         .
      396       end.
      397     end.
      398     return v-result-list .
      399   end function.
      400   function cross-list returns character (
      401    input parfirst-list  as character,
      402    input parsecond-list as character,
      403    input pardelim       as character).
      404     if pardelim = ""
      405     or pardelim = ?
      406     then do:
      407       assign
      408         pardelim = ","
      409       .
      410     end.
      411     def var ind as integer no-undo .
      412     def var v-elem as character no-undo .
      413     def var v-result-list as character no-undo init "".
      414     def var v-num-parfirst-list as integer no-undo .
      415     assign
      416       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      417     .
      418     do ind = 1 to v-num-parfirst-list
      419     :
      420       assign
      421         v-elem = entry(ind, parfirst-list, pardelim)
      422       .
      423       if lookup(v-elem, v-result-list, pardelim) = 0
      424       and lookup(v-elem, parsecond-list, pardelim) > 0
      425       then do:
      426         assign
      427           v-result-list = v-result-list
      428                         + (if v-result-list > "" then pardelim else "")
      429                         + v-elem
      430         .
      431       end.
      432     end.
      433     return v-result-list .
      434   end function.
      435   function radio-label returns character (
      436    input par-rs-value  as character,
      437    input par-rs-radio-buttons as character)
      438    .
      439    DEFINE variable v-result-label as character no-undo.
      440    assign
      441    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      442                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      443                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      444                             ), par-rs-radio-buttons
      445                           )
      446    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      447    .
      448   return v-result-label.
      449   end function.
      450   function m-radio-label returns character (
      451    input par-rs-value  as character,
      452    input par-rs-radio-buttons as character,
      453    input par-delim as character
      454    )
      455    .
      456    DEFINE variable v-result-label as character no-undo.
      457    assign
      458    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      459                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      460                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      461                             ), par-rs-radio-buttons, par-delim
      462                           )
      463    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      464    .
      465   return v-result-label.
      466   end function.
      467   FUNCTION mixlist returns character
      468   (
      469    input parfirst-list  as character
      470    ,input parsecond-list as character
      471    ,input pardelim       as character
      472    ,input pardelim-result as character ) :
      473     if pardelim = ""
      474     or pardelim = ?
      475     then do:
      476       assign
      477         pardelim = ","
      478       .
      479     end.
      480     def var ind as integer no-undo .
      481     def var v-elem1 as character no-undo .
      482     def var v-elem2 as character no-undo .
      483     def var v-result-list as character no-undo init "".
      484     do ind = 1 to num-entries(parfirst-list, pardelim)
      485     :
      486       assign
      487         v-elem1 = entry(ind, parfirst-list, pardelim)
      488         v-elem2 = entry(ind, parsecond-list, pardelim)
      489       .
      490         assign
      491           v-result-list = v-result-list
      492                         + (if v-result-list > "" then pardelim-result else "")
      493                         + v-elem1 + pardelim-result + v-elem2
      494         .
      495     end.
      496     return v-result-list .
      497   END FUNCTION.
