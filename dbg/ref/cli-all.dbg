     2694   END.
     2695   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     2696   DO:
     2697   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2698   if lookup(self :type
     2699            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2700            ) = 0
     2701   then do:
     2702     message
     2703       "$Workfile$"
     2704       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2705       "Интерфейсный элемент" self :name  skip
     2706       "Тип" self :type  skip
     2707       "Процедура" this-procedure :file-name skip
     2708       view-as alert-box .
     2709   end.
     2710   else do:
     2711     apply "entry":u to self  .
     2712     if focus :handle <> self :handle  then do:
     2713       return no-apply .
     2714     end.
     2715   end.
     2716   define variable ri as recid no-undo.
     2717   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2718   do:
     2719     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2720       (input  v-cntxt-db-num
     2721       ,input  v-cntxt-userid
     2722       ,input  0
     2723       ,input  'actn_client-reference_update':U
     2724       ,input  'global':U
     2725       ,input  0
     2726       ,input  '':U
     2727       ,input  0
     2728       ,input  0
     2729       ,input  0
     2730       ,input  0
     2731       ,input  true
     2732       ,output g#log
     2733       )  .
     2734   end.
     2735   if not g#log then return no-apply.
     2736   if not available X_clients then return no-apply.
     2737   ri = recid( X_clients ) .
     2738   c-recid = ri .
     2739   CASE X_clients.obj-type:
     2740     when 'орг':U  then
     2741         run ref/firmi.w (
     2742                      input parParentProc
