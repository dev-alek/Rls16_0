     1447   procedure uf-get :
     1448     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1449     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1450     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1451     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1452     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1453     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1454     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1455     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1456     do
     1457     on error undo, return error
     1458     :
     1459       define buffer buf_usr-flt for ubflt.usr-flt .
     1460       define variable v-use-List_     as logical   no-undo .
     1461       define variable v-type-List_     as character no-undo .
     1462       define variable v-format-List_   as character no-undo .
     1463       define variable v-use-Naim      as logical   no-undo .
     1464       define variable v-type-Naim      as character no-undo .
     1465       define variable v-format-Naim    as character no-undo .
     1466       define variable v-use-print-graft as logical   no-undo .
     1467       define variable v-use-sort-gr     as logical   no-undo .
     1468       define variable v-use-type-price  as logical   no-undo .
     1469       define variable v-use-type-val    as logical   no-undo .
     1470       define variable v-label          as character no-undo .
     1471       define variable v-tooltip        as character no-undo .
     1472       define variable v-user-can-edit  as logical   no-undo .
     1473       define variable v-output-display as logical   no-undo .
     1474       define variable v-other          as character no-undo .
     1475       run uf-name in this-procedure
     1476          (input  entry(1, p-code, chr(4))
     1477         ,output v-use-List_
     1478         ,output v-type-List_
     1479         ,output v-format-List_
     1480         ,output v-use-Naim
     1481         ,output v-type-Naim
     1482         ,output v-format-Naim
     1483         ,output v-use-print-graft
     1484         ,output v-use-sort-gr
     1485         ,output v-use-type-price
     1486         ,output v-use-type-val
     1487         ,output v-label
     1488         ,output v-tooltip
     1489         ,output v-user-can-edit
     1490         ,output v-output-display
     1491         ,output v-other
     1492         ) no-error .
     1493       if error-status :error then do:
     1494         undo, return error return-value .
     1495       end.
     1496       find first buf_usr-flt no-lock where
     1497                  buf_usr-flt.Call-point     = p-code AND
     1498                  buf_usr-flt.user-name       = p-user-name
     1499         no-error .
     1500       if avail buf_usr-flt then do:
     1501         assign
     1502         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1503         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1504         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1505         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1506         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1507         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1508         .
     1509       end.
     1510       else do:
     1511         assign
     1512         p-List_        = (if v-use-List_       then "":U                    else ?)
     1513         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1514         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1515         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1516         p-type-price   = (if v-use-type-price  then no                      else ?)
     1517         p-type-val     = (if v-use-List_       then no                      else ?)
     1518         .
     1519       end.
     1520     end.
     1521   end procedure.
     1522   procedure uf-set :
     1523     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1524     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1525     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1526     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1527     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1528     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1529     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1530     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1531     do
     1532     on error undo, return error
     1533     :
     1534       define buffer buf_usr-flt for ubflt.usr-flt .
     1535       define variable v-use-List_     as logical   no-undo .
     1536       define variable v-type-List_     as character no-undo .
     1537       define variable v-format-List_   as character no-undo .
     1538       define variable v-use-Naim      as logical   no-undo .
     1539       define variable v-type-Naim      as character no-undo .
     1540       define variable v-format-Naim    as character no-undo .
     1541       define variable v-use-print-graft as logical   no-undo .
     1542       define variable v-use-sort-gr   as logical   no-undo .
     1543       define variable v-use-type-price as logical   no-undo .
     1544       define variable v-use-type-val  as logical   no-undo .
     1545       define variable v-tooltip        as character no-undo .
     1546       define variable v-label          as character no-undo .
     1547       define variable v-user-can-edit  as logical   no-undo .
     1548       define variable v-output-display as logical   no-undo .
     1549       define variable v-other          as character no-undo .
     1550       run uf-name in this-procedure
     1551         (input  entry(1, p-code, chr(4))
     1552         ,output v-use-List_
     1553         ,output v-type-List_
     1554         ,output v-format-List_
     1555         ,output v-use-Naim
     1556         ,output v-type-Naim
     1557         ,output v-format-Naim
     1558         ,output v-use-print-graft
     1559         ,output v-use-sort-gr
     1560         ,output v-use-type-price
     1561         ,output v-use-type-val
     1562         ,output v-label
     1563         ,output v-tooltip
     1564         ,output v-user-can-edit
     1565         ,output v-output-display
     1566         ,output v-other
     1567         ) no-error .
     1568       if error-status :error then do:
     1569         undo, return error return-value .
     1570       end.
     1571       find first buf_usr-flt where
     1572                  buf_usr-flt.Call-point     = p-code AND
     1573                  buf_usr-flt.user-name       = p-user-name
     1574         no-error .
     1575       if not avail buf_usr-flt then do:
     1576           create buf_usr-flt .
     1577           assign
     1578           buf_usr-flt.call-point = p-code
     1579           buf_usr-flt.user-name  = p-user-name
     1580           .
     1581       end.
     1582       if avail buf_usr-flt then do:
     1583        assign
     1584        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1585        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1586        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1587        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1588        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1589        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1590       .
     1591       release buf_usr-flt.
     1592       end.
     1593       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1594     end.
     1595   end procedure.
     1596   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1597     define variable v-cntxt-db-num        as integer   no-undo .
     1598     define variable v-cntxt-userid        as character no-undo .
     1599     define variable v-cntxt-level         as character no-undo .
     1600     define variable v-cntxt-host-code-obj as integer   no-undo .
     1601     define variable v-cntxt-obj-type      as character no-undo .
     1602     define variable v-cntxt-obj-code      as integer   no-undo .
     1603     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1604     define variable v-cntxt-is-admin      as logical   no-undo .
     1605   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1606   define variable c-point  as character no-undo .
     1607   define variable tbl      as character no-undo .
     1608   define variable join-tbl as character no-undo .
     1609   define variable fld      as character no-undo .
     1610   define variable lab      as character no-undo .
     1611   define variable spr      as character no-undo .
     1612   define variable dim      as character no-undo .
     1613   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1614   procedure fltfield-clear :
     1615     define output parameter loc-fld as character no-undo.
     1616     define output parameter loc-lab as character no-undo .
     1617     define output parameter loc-spr as character no-undo .
     1618     define output parameter loc-dim as character no-undo .
     1619     assign
     1620       loc-fld = ""
     1621       loc-lab = ""
     1622       loc-spr = ""
     1623       loc-dim = "0"
     1624     .
     1625   end procedure .
     1626   procedure fltfield-add :
     1627     define input        parameter par-fld as character no-undo.
     1628     define input        parameter par-lab as character no-undo .
     1629     define input        parameter par-spr as character no-undo .
     1630     define input-output parameter loc-fld as character no-undo.
     1631     define input-output parameter loc-lab as character no-undo .
     1632     define input-output parameter loc-spr as character no-undo .
     1633     define input-output parameter loc-dim as character no-undo .
     1634     do
     1635     on error undo, return error
     1636     :
     1637       assign
     1638       loc-fld = if loc-dim = '0'
     1639                 then par-fld
     1640                 else (loc-fld + chr(44) + par-fld)
     1641       loc-lab = if loc-dim = '0'
     1642                 then par-lab
     1643                 else (loc-lab + chr(44) + par-lab)
     1644       loc-spr = if loc-dim = '0'
     1645                 then par-spr
     1646                 else (loc-spr + chr(44) + par-spr)
     1647       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1648                 string(integer(if num-entries(loc-dim) > 1
     1649                               then entry(2, loc-dim)
     1650                               else entry(1, loc-dim)
     1651                               ) + 1)
     1652       no-error
     1653       .
     1654     end.
     1655   end procedure.
     1656    define NEW SHARED temp-table temp-list-buyer no-undo ~
     1657   field obj-type as character ~
     1658   field obj-code as integer   ~
     1659   index pi is primary unique  ~
     1660   obj-type ~
     1661   obj-code.
     1662   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1663   procedure gen-key-rec :
     1664     define input  parameter p-tbl-name    as character no-undo.
     1665     define input  parameter p-bh_tbl-name as handle    no-undo.
     1666     define output parameter p-key-rec     as character no-undo.
     1667     do
     1668     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1669     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1670     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1671     :
     1672       define variable fh               as handle    no-undo .
     1673       define variable v-ok             as logical   no-undo .
     1674       define variable v-inform         as character no-undo .
     1675       define variable v-ind            as integer   no-undo .
     1676       define variable v-idx-field-qnty as integer   no-undo .
     1677       if p-tbl-name = ?
     1678         or p-tbl-name = "":U
     1679       then do:
     1680         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info11 ).
     1681       end.
     1682       if not p-bh_tbl-name:available then do:
     1683         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info11, p-tbl-name ).
     1684       end.
     1685       assign
     1686         p-key-rec = p-tbl-name
     1687         v-inform  = p-bh_tbl-name:index-information(1)
     1688         v-ind     = 2
     1689       .
     1690       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1691       on error undo, return error
     1692       :
     1693         assign
     1694           v-inform = p-bh_tbl-name:index-information( v-ind )
     1695           v-ind    = v-ind + 1
     1696         .
     1697       end.
     1698       if v-inform = ?
     1699         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1700         or entry( 3, v-inform, ",":U ) <> "1":U
     1701       then do:
     1702         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, p-tbl-name ).
     1703       end.
     1704       else do:
     1705         assign
     1706           v-idx-field-qnty = num-entries( v-inform ) - 4
     1707         .
     1708         if v-idx-field-qnty < 2 then do:
     1709           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, p-tbl-name ).
     1710         end.
     1711         do v-ind = 1 to v-idx-field-qnty by 2
     1712         on error undo, return error
     1713         :
     1714           assign
     1715             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1716             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1717           .
     1718         end.
     1719       end.
     1720       if p-key-rec = ? then do:
     1721         assign
     1722           p-key-rec = "":U
     1723         .
     1724         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info11, p-tbl-name ).
     1725       end.
     1726     end.
     1727     return.
     1728   end procedure.
     1729   procedure gen-where-keyr-tab :
     1730     define input  parameter i-tableSerach as character no-undo.
     1731     define input  parameter i-tablekey   as character  no-undo.
     1732     define input  parameter p-key-rec    as character  no-undo.
     1733     define input  parameter p-key-handle as handle     no-undo .
     1734     define input  parameter p-db-name    as character  no-undo .
     1735     define input  parameter p-tt-handle  as handle     no-undo .
     1736     define output parameter o-Where      as character  no-undo.
     1737     do
     1738     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1739     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1740     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1741     :
     1742       define variable v-full-tbl-name  as character no-undo .
     1743       define variable bh_tbl-name      as handle    no-undo .
     1744       define variable fh_key           as handle    no-undo .
     1745       define variable fh_search        as handle    no-undo .
     1746       define variable v-field-num      as integer   no-undo .
     1747       define variable v-count-fld      as integer   no-undo .
     1748       define variable v-inform         as character no-undo .
     1749       define variable v-ind            as integer   no-undo .
     1750       define variable v-idx-field-qnty as integer   no-undo .
     1751       define variable v-field-name     as character no-undo .
     1752       define variable v-field-val      as character no-undo .
     1753       define variable v-word-link      as character no-undo .
     1754       define variable vTable           as character no-undo.
     1755       define variable bh_tbl-key       as handle    no-undo .
     1756       assign
     1757         p-key-rec = trim( p-key-rec )
     1758       .
     1759       if p-key-handle <> ? then do:
     1760         if not valid-handle(p-key-handle)
     1761            or p-key-handle:type <> "buffer"
     1762         then do:
     1763           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info11 ).
     1764         end.
     1765         if num-entries( p-key-rec, chr(3) ) > 1
     1766           or p-key-rec = ?
     1767           or p-key-rec = "":U
     1768         then do:
     1769           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info11, p-key-rec ).
     1770         end.
     1771       end.
     1772       else do:
     1773         if p-key-rec = ?
     1774           or p-key-rec = "":U
     1775         then do:
     1776           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info11 ).
     1777         end.
     1778       end.
     1779       assign
     1780         vTable = entry( 1 , p-key-rec, chr(3) )
     1781       .
     1782       if p-tt-handle <> ?
     1783         and ( not valid-handle(p-tt-handle)
     1784               or p-tt-handle:type <> "buffer"
     1785             )
     1786       then do:
     1787         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info11, vTable, chr(10) ).
     1788       end.
     1789       if p-tt-handle = ? then do:
     1790         assign
     1791           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1792         .
     1793         create buffer bh_tbl-name for table v-full-tbl-name .
     1794       end.
     1795       else do:
     1796         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1797       end.
     1798       assign
     1799         v-inform = bh_tbl-name:index-information(1)
     1800         v-ind    = 2
     1801       .
     1802       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1803       on error undo, return error
     1804       :
     1805         assign
     1806           v-inform = bh_tbl-name:index-information( v-ind )
     1807           v-ind    = v-ind + 1
     1808         .
     1809       end.
     1810       if v-inform = ?
     1811         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1812         or entry( 3, v-inform, ",":U ) <> "1":U
     1813       then do:
     1814         delete object bh_tbl-name no-error.
     1815         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info11, vTable ).
     1816       end.
     1817       assign
     1818         v-idx-field-qnty = num-entries( v-inform ) - 4
     1819       .
     1820       if v-idx-field-qnty < 2 then do:
     1821         delete object bh_tbl-name no-error.
     1822         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, vTable ).
     1823       end.
     1824       assign
     1825         o-where     = "where":U
     1826         v-word-link = "":U
     1827         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1828         v-count-fld = 0
     1829       .
     1830       if i-tablekey ne "" and i-tablekey ne ?
     1831       then do:
     1832         assign
     1833           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1834         .
     1835         create buffer bh_tbl-key for table v-full-tbl-name .
     1836       end.
     1837       if i-tableSerach ne "" and i-tableSerach ne ?
     1838       then do:
     1839         delete object bh_tbl-name no-error.
     1840         assign
     1841           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1842         .
     1843         create buffer bh_tbl-name for table v-full-tbl-name .
     1844       end.
     1845       block_where:
     1846       do v-ind = 1 to v-idx-field-qnty by 2
     1847       on error undo, return error
     1848       :
     1849         assign
     1850           v-count-fld = v-count-fld + 1
     1851         .
     1852         if p-key-handle = ?
     1853           and v-count-fld > v-field-num
     1854         then do:
     1855           leave block_where.
     1856         end.
     1857         define variable VfieldKeyTable as handle no-undo.
     1858         assign
     1859           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1860           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1861         .
     1862         if     bh_tbl-key ne ?
     1863         then do:
     1864            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1865            if VfieldKeyTable eq ?
     1866            then next block_where.
     1867         end.
     1868         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1869         then
     1870            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1871         else
     1872            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1873         if p-key-handle = ? then do:
     1874           assign
     1875             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1876           .
     1877         end.
     1878         else do:
     1879           assign
     1880             fh_key = p-key-handle:buffer-field( v-field-name )
     1881           .
     1882           if fh_key = ?
     1883             or not valid-handle( fh_key )
     1884           then do:
     1885             delete object bh_tbl-name.
     1886             if     bh_tbl-key ne ?
     1887             then
     1888                delete object bh_tbl-key.
     1889             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info11, p-key-handle:name, v-field-name ).
     1890           end.
     1891           assign
     1892             v-field-val = fh_key:buffer-value
     1893           .
     1894         end.
     1895         if fh_search:data-type ="character":U then do:
     1896           assign
     1897             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1898             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1899             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1900             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1901             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1902             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1903             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1904             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1905             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1906             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1907             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1908             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1909             v-field-val = substitute( '"&1"', v-field-val )
     1910           .
     1911         end.
     1912         assign
     1913           o-where = substitute( "&1 &2", o-where, v-field-val )
     1914         .
     1915         if v-word-link = "":U then do:
     1916           assign
     1917             v-word-link = "and":U
     1918           .
     1919         end.
     1920       end.
     1921       delete object bh_tbl-name.
     1922       if     bh_tbl-key ne ?
     1923       then
     1924          delete object bh_tbl-key.
     1925       if p-key-handle = ?
     1926         and v-count-fld <> v-field-num
     1927       then do:
     1928         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info11, vTable ).
     1929       end.
     1930     end.
     1931   end procedure.
     1932   procedure gen-hn-keyr-tab :
     1933     define input  parameter i-tableSerach as character no-undo.
     1934     define input  parameter i-tablekey   as character no-undo.
     1935     define input  parameter p-key-rec    as character no-undo.
     1936     define input  parameter p-key-handle as handle    no-undo .
     1937     define input  parameter p-db-name    as character no-undo .
     1938     define input  parameter p-tt-handle  as handle    no-undo .
     1939     define input  parameter p-stts-lock  as integer   no-undo .
     1940     define output parameter o-hn         as handle    no-undo.
     1941     define variable v-full-tbl-name as character no-undo.
     1942     define variable v-where         as character no-undo.
     1943     define variable bh_tbl-name     as handle    no-undo.
     1944     define variable vTable          as character no-undo.
     1945     do
     1946     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1947     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1948     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1949         run gen-where-keyr-tab(i-tableSerach,
     1950                                i-tablekey,
     1951                                p-key-rec,
     1952                                p-key-handle,
     1953                                p-db-name,
     1954                                p-tt-handle,
     1955                                output v-where).
     1956         if i-tableSerach ne "" and i-tableSerach ne ?
     1957         then do:
     1958            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1959            create buffer bh_tbl-name for table v-full-tbl-name .
     1960         end.
     1961         else do:
     1962            if p-tt-handle = ? then do:
     1963               assign
     1964                  vTable = entry( 1 , p-key-rec, chr(3) )
     1965               .
     1966               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1967               create buffer bh_tbl-name for table v-full-tbl-name .
     1968            end.
     1969            else do:
     1970               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1971            end.
     1972         end.
     1973         if p-tt-handle = ? then do:
     1974            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1975         end.
     1976         else do:
     1977            bh_tbl-name:find-first( v-where ) no-error .
     1978         end.
     1979         o-hn = bh_tbl-name.
     1980      end.
     1981   end procedure.
     1982   procedure gen-hn-keyr :
     1983     define input  parameter p-key-rec    as character no-undo.
     1984     define input  parameter p-key-handle as handle    no-undo .
     1985     define input  parameter p-db-name    as character no-undo .
     1986     define input  parameter p-tt-handle  as handle    no-undo .
     1987     define input  parameter p-stts-lock  as integer   no-undo .
     1988     define output parameter o-hn         as handle    no-undo.
     1989     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1990   end.
     1991   procedure gen-row-keyr :
     1992     define input  parameter p-key-rec    as character no-undo.
     1993     define input  parameter p-key-handle as handle    no-undo .
     1994     define input  parameter p-db-name    as character no-undo .
     1995     define input  parameter p-tt-handle  as handle    no-undo .
     1996     define input  parameter p-stts-lock  as integer   no-undo .
     1997     define output parameter p-tbl-row    as rowid     no-undo.
     1998     define output parameter p-tbl-name   as character no-undo.
     1999     define variable vHn as handle no-undo.
     2000       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     2001       p-tbl-row = if vHn:available then vHn:rowid else ?.
     2002       p-tbl-name =  vHn:table.
     2003       delete object vHn no-error.
     2004     if p-tbl-row = ? then do:
     2005       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info11, p-tbl-name, p-key-rec ).
     2006     end.
     2007     else do:
     2008       return.
     2009     end.
     2010   end procedure.
     2011   procedure gen-key-fv :
     2012     define input  parameter p-key-rec    as character no-undo .
     2013     define output parameter p-field-list as character no-undo .
     2014     define output parameter p-value-list as character no-undo.
     2015     do
     2016     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2017     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2018     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2019     :
     2020       define variable v-full-tbl-name  as character no-undo .
     2021       define variable bh_tbl-name      as handle    no-undo .
     2022       define variable v-tbl-name       as character no-undo .
     2023       define variable v-field-num      as integer   no-undo .
     2024       define variable v-count-fld      as integer   no-undo .
     2025       define variable v-inform         as character no-undo .
     2026       define variable v-ind            as integer   no-undo .
     2027       define variable v-idx-field-qnty as integer   no-undo .
     2028       define variable v-delim-key      as character no-undo .
     2029       if p-key-rec = ?
     2030         or p-key-rec = "":U
     2031       then do:
     2032         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info11 ).
     2033       end.
     2034       assign
     2035         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     2036         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2037       .
     2038       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2039       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info11 ).
     2040       assign
     2041         v-inform = bh_tbl-name:index-information(1)
     2042         v-ind    = 2
     2043       .
     2044       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2045       on error undo, return error
     2046       :
     2047         assign
     2048           v-inform = bh_tbl-name:index-information( v-ind )
     2049           v-ind    = v-ind + 1
     2050         .
     2051       end.
     2052       if v-inform = ?
     2053         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2054         or entry( 3, v-inform, ",":U ) <> "1":U
     2055       then do:
     2056         delete object bh_tbl-name no-error.
     2057         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, v-tbl-name ).
     2058       end.
     2059       assign
     2060         v-idx-field-qnty = num-entries( v-inform ) - 4
     2061       .
     2062       if v-idx-field-qnty < 2 then do:
     2063         delete object bh_tbl-name no-error.
     2064         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, v-tbl-name ).
     2065       end.
     2066       assign
     2067         p-field-list = "":U
     2068         p-value-list = "":U
     2069         v-delim-key  = "":U
     2070         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2071         v-count-fld  = 0
     2072       .
     2073       block_where:
     2074       do v-ind = 1 to v-idx-field-qnty by 2
     2075       on error undo, return error
     2076       :
     2077         assign
     2078           v-count-fld = v-count-fld + 1
     2079         .
     2080         if v-count-fld > v-field-num then do:
     2081           leave block_where.
     2082         end.
     2083         assign
     2084           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2085           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2086         .
     2087         if v-ind = 1 then do:
     2088           assign
     2089             v-delim-key = chr(3)
     2090           .
     2091         end.
     2092       end.
     2093       delete object bh_tbl-name.
     2094       if v-count-fld <> v-field-num then do:
     2095         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info11, v-tbl-name ).
     2096       end.
     2097     end.
     2098   end procedure.
     2099   procedure gen-key-field :
     2100     define input  parameter p-table      as character no-undo .
     2101     define output parameter p-field-list as character no-undo .
     2102     do
     2103     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2104     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2105     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2106     :
     2107       define variable v-full-tbl-name  as character no-undo .
     2108       define variable bh_tbl-name      as handle    no-undo .
     2109       define variable v-tbl-name       as character no-undo .
     2110       define variable v-field-num      as integer   no-undo .
     2111       define variable v-count-fld      as integer   no-undo .
     2112       define variable v-inform         as character no-undo .
     2113       define variable v-ind            as integer   no-undo .
     2114       define variable v-idx-field-qnty as integer   no-undo .
     2115       define variable v-delim-key      as character no-undo .
     2116       if p-table = ?
     2117         or p-table = "":U
     2118       then do:
     2119         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info11 ).
     2120       end.
     2121       assign
     2122         v-tbl-name      = p-table
     2123         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2124       .
     2125       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2126       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info11 ).
     2127       assign
     2128         v-inform = bh_tbl-name:index-information(1)
     2129         v-ind    = 2
     2130       .
     2131       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2132       on error undo, return error
     2133       :
     2134         assign
     2135           v-inform = bh_tbl-name:index-information( v-ind )
     2136           v-ind    = v-ind + 1
     2137         .
     2138       end.
     2139       if v-inform = ?
     2140         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2141         or entry( 3, v-inform, ",":U ) <> "1":U
     2142       then do:
     2143         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info11, v-tbl-name ).
     2144       end.
     2145       assign
     2146         v-idx-field-qnty = num-entries( v-inform ) - 4
     2147       .
     2148       if v-idx-field-qnty < 2 then do:
     2149         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info11, v-inform, v-tbl-name ).
     2150       end.
     2151       assign
     2152         p-field-list = "":U
     2153         v-delim-key  = "":U
     2154         v-count-fld  = 0
     2155       .
     2156       block_where:
     2157       do v-ind = 1 to v-idx-field-qnty by 2
     2158       on error undo, return error
     2159       :
     2160         assign
     2161           v-count-fld = v-count-fld + 1
     2162         .
     2163         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2164         if v-ind = 1 then do:
     2165           assign
     2166             v-delim-key = chr(3)
     2167           .
     2168         end.
     2169       end.
     2170       delete object bh_tbl-name.
     2171     end.
     2172   end procedure.
