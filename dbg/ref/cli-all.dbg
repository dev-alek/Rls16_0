     6684                   assign
     6685                     x_temp-list-buyer.obj-type = X_clients-attr.obj-type
     6686                     x_temp-list-buyer.obj-code = X_clients-attr.obj-code
     6687                   .
     6688                 end.
     6689           end.
     6690           for each X_clients-attr no-lock where X_clients-attr.attr-code = 'supp-lgas':U
     6691                                             and X_clients-attr.attr-value = "yes" :
     6692                 if not can-find (first x_temp-list-buyer where x_temp-list-buyer.obj-type = X_clients-attr.obj-type
     6693                                                            and x_temp-list-buyer.obj-code = X_clients-attr.obj-code)
     6694                 then do :
