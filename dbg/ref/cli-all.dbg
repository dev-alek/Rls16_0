     2753                       ,input X_clients.grp-code
     2754                       ,input "cli-all"
     2755                       ,input-output  ri) .
     2756     when 'маг':U OR when 'скл':U  then
     2757         message "Изменение объектов типа ~"склад~" или ~"магазин~" "
     2758                         "возможно только из АРМа ~"Администратор~"."
     2759                         view-as alert-box INFORMATION .
     2760   END CASE .
     2761   if find-by = 'название':U then do:
     2762     apply "RETURN" to Nameorcode.
     2763   end.
     2764   else do:
     2765     assign
     2766     find-by = 'все':U
     2767     getc-recid = yes
     2768     .
     2769     display
     2770     find-by
     2771     with frame Dialog-Frame .
     2772     run proc-vc-find-by in this-procedure ( input no) no-error.
     2773     if (X_clients.obj-type = 'чел':U
     2774               or X_clients.obj-type = 'орг':U
     2775             )
     2776           AND ri <> ? then do:
     2777       case var-br-name :         when "cli-list":U then do:            Run OpenBR in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listA":U then do:            Run OpenBRA in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listB":U then do:            Run OpenBRB in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         end case.
     2778       case var-br-name :         when "cli-list":U then do:            reposition Cli-List to recid ri no-error .         end.         when "cli-listA":U then do:            reposition Cli-ListA to recid ri no-error .         end.         when "cli-listB":U then do:            reposition Cli-ListB to recid ri no-error .          end.         end case.
     2779       if error-status:error then do:
     2780             find first pos_clients no-lock where       recid( pos_clients ) = ri no-error .   message  substitute("Невозможно позиционироваться на клиенте &1&2Клиент был добавлен (или изменен или удален)&2и теперь не попадает в текущую выборку"             ,(if available pos_clients then (pos_clients.obj-type + string(pos_clients.obj-code)) else '':U)              , chr(10)) view-as alert-box WARNING.
     2781       end.
     2782     end.
     2783   end.
     2784   case var-br-name :         when "cli-list":U then do:            apply "entry" to Cli-List in frame Dialog-Frame.         end.         when "cli-listA":U then do:            apply "entry" to Cli-ListA in frame Dialog-Frame.         end.         when "cli-listB":U then do:            apply "entry" to Cli-ListB in frame Dialog-Frame.         end.         end case.
     2785   END.
