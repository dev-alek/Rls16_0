     2904   ON CHOOSE OF B-grp IN FRAME Dialog-Frame
     2905   DO:
     2906   define variable lns-cnt as integer no-undo .
     2907   define variable g-grp as character no-undo .
     2908   define variable v-gds-rec as recid no-undo.
     2909   define variable ri as recid no-undo .
     2910   define buffer buf_clients for ub.clients.
     2911   if not available X_clients then return no-apply.
     2912   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2913   do:
     2914     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2915       (input  v-cntxt-db-num
     2916       ,input  v-cntxt-userid
     2917       ,input  0
     2918       ,input  'actn_client-reference_update':U
     2919       ,input  'global':U
     2920       ,input  0
     2921       ,input  '':U
     2922       ,input  0
     2923       ,input  0
     2924       ,input  0
     2925       ,input  0
     2926       ,input  true
     2927       ,output g#log
     2928       )  .
     2929   end.
     2930   if not g#log then return no-apply.
     2931   g#log = yes.
     2932   message
     2933   "Выберите группу, в которую нужно" skip
     2934   "переместить клиента(ов)."
     2935   view-as alert-box question buttons OK-Cancel update g#log.
     2936   if not g#log then   do:
     2937           apply "entry" to Cli-List in frame Dialog-Frame.
     2938           return no-apply.
     2939       end.
     2940   g-grp = "".
     2941   run ref/cli-grps.w (
     2942                      input parparentproc
     2943                    , input 'терм':U + ",b-sel"
     2944                    , input-output g-grp ) .
     2945   if g-grp = "" then  do:
     2946       case var-br-name :         when "cli-list":U then do:            apply "entry" to Cli-List in frame Dialog-Frame.         end.         when "cli-listA":U then do:            apply "entry" to Cli-ListA in frame Dialog-Frame.         end.         when "cli-listB":U then do:            apply "entry" to Cli-ListB in frame Dialog-Frame.         end.         end case.
     2947       return no-apply.
     2948    end.
     2949   else do transaction:
     2950       FIND ub.cli-grp where recid( ub.cli-grp ) = integer( g-grp ) .
     2951       if v-rid-list = "" then
     2952       v-rid-list = string( recid( X_clients ) ) .
     2953       lns-cnt = 1.
     2954       DO WHILE lns-cnt <= num-entries( v-rid-list ) :
     2955           v-gds-rec = integer( entry( lns-cnt, v-rid-list ) ) .
     2956           if lns-cnt = 1 then ri = v-gds-rec.
     2957           FIND buf_clients where recid( buf_clients ) = v-gds-rec.
     2958           buf_clients.grp-code = ub.cli-grp.node-code.
     2959           lns-cnt = lns-cnt + 1.
     2960       END .
     2961       v-rid-list = "".
     2962       mark-num = 0.
     2963       hide mark-num in frame Dialog-Frame.
     2964   end.
     2965   case var-br-name :         when "cli-list":U then do:            Run OpenBR in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listA":U then do:            Run OpenBRA in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         when "cli-listB":U then do:            Run OpenBRB in this-procedure (yes, no, ' ':U, yes) no-error  .         end.         end case.
     2966   case var-br-name :         when "cli-list":U then do:            reposition Cli-List to recid ri no-error .         end.         when "cli-listA":U then do:            reposition Cli-ListA to recid ri no-error .         end.         when "cli-listB":U then do:            reposition Cli-ListB to recid ri no-error .          end.         end case.
     2967   if error-status:error then do:
     2968     find first pos_clients no-lock where       recid( pos_clients ) = ri no-error .   message  substitute("Невозможно позиционироваться на клиенте &1&2Клиент был добавлен (или изменен или удален)&2и теперь не попадает в текущую выборку"             ,(if available pos_clients then (pos_clients.obj-type + string(pos_clients.obj-code)) else '':U)              , chr(10)) view-as alert-box WARNING.
     2969   end.
     2970   END.
