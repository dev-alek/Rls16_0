     6748           if entry(2, entry(ii, c-other, ";":U), "=":U) <> "":U
     6749           then do:
     6750             v-auto-tank-for-supp = entry(2, entry(ii, c-other, ";":U), "=":U).
     6751             for each X_clients-attr no-lock where X_clients-attr.attr-code = 'auto-tank-for':U
     6752                                               and lookup(v-auto-tank-for-supp,X_clients-attr.attr-value) <> 0 :
     6753               if not can-find (first x_temp-list-buyer where x_temp-list-buyer.obj-type = X_clients-attr.obj-type
     6754                                                           and x_temp-list-buyer.obj-code = X_clients-attr.obj-code)
     6755               then do :
     6756                 create x_temp-list-buyer.
