     6601                     then ?
     6602                     else   integer(entry(4, v-uf-List_, chr(4)))
     6603           v-added  = entry(5, v-uf-List_, chr(4))
     6604           v-other  = entry(6, v-uf-List_, chr(4))
     6605           .
