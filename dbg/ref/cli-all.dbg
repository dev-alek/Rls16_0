     3507   procedure set-filter-name :
     3508   define input parameter p-filter-name as character no-undo .
     3509     do with frame Dialog-Frame:
     3510       if p-filter-name > "" then do:
     3511         assign
     3512           frame Dialog-Frame:title
     3513             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3514         .
     3515         assign
     3516           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3517         .
     3518       end.
     3519       else do:
     3520         assign
     3521           b-sch :tooltip = ""
     3522         .
     3523       end.
     3524     end.
     3525   end procedure.
     3526   define variable v-total-select-num as integer   no-undo .
     3527   define temp-table temp-user-obj no-undo
     3528     field obj-type as character
     3529     field obj-code as integer
     3530     index xpk is primary unique obj-type obj-code
     3531     .
     3532   PROCEDURE userobjs_append :
     3533     define input  parameter p-obj-type as character no-undo .
     3534     define input  parameter p-obj-code as integer   no-undo .
     3535     define buffer buf_temp-user-obj for temp-user-obj .
     3536     do
     3537     on error undo, return error return-value
     3538     :
     3539       find first buf_temp-user-obj
     3540         where buf_temp-user-obj.obj-type = p-obj-type
     3541           and buf_temp-user-obj.obj-code = p-obj-code
     3542         no-error .
     3543       if not available buf_temp-user-obj
     3544       then do:
     3545         create buf_temp-user-obj .
     3546         assign
     3547           buf_temp-user-obj.obj-type = p-obj-type
     3548           buf_temp-user-obj.obj-code = p-obj-code
     3549         .
     3550         assign
     3551           v-total-select-num = v-total-select-num + 1
     3552         .
     3553       end.
     3554     end.
     3555   END PROCEDURE.
     3556   PROCEDURE userobjs_delete :
     3557     define input  parameter p-obj-type as character no-undo .
     3558     define input  parameter p-obj-code as integer   no-undo .
     3559     define buffer buf_temp-user-obj for temp-user-obj .
     3560     do
     3561     on error undo, return error return-value
     3562     :
     3563       find first buf_temp-user-obj
     3564         where buf_temp-user-obj.obj-type = p-obj-type
     3565           and buf_temp-user-obj.obj-code = p-obj-code
     3566         no-error .
     3567       if available buf_temp-user-obj
     3568       then do:
     3569         delete buf_temp-user-obj .
     3570         assign
     3571           v-total-select-num = v-total-select-num - 1
     3572         .
     3573       end.
     3574     end.
     3575   END PROCEDURE.
     3576   PROCEDURE display-select-num :
     3577     do
     3578     on error undo, return error return-value
     3579     :
     3580       assign
     3581         mark-num = v-total-select-num
     3582       .
     3583       display
     3584         mark-num
     3585         with frame Dialog-Frame.
     3586       if v-total-select-num = 0
     3587       then do:
     3588         hide
     3589           mark-num
     3590           in frame Dialog-Frame.
     3591       end.
     3592       else do:
     3593         display
     3594           mark-num
     3595           with frame Dialog-Frame.
     3596       end.
     3597     end.
     3598   END PROCEDURE.
     3599   PROCEDURE check-selection :
     3600     define variable v-ok as logical   no-undo .
     3601     define buffer buf_temp-user-obj for temp-user-obj .
     3602     do
     3603     on error undo, return error return-value
     3604     :
     3605       do with frame Dialog-Frame
     3606       :
     3607         if can-do (p-bttns, "b-mark")
     3608         then do:
     3609           find first buf_temp-user-obj
     3610             no-error .
     3611           if available buf_temp-user-obj
     3612           then do:
     3613             message
     3614               "Информация о выбранных элементах будет потеряна" Skip
     3615               "Продолжить?" Skip
     3616               view-as alert-box question buttons yes-no update v-ok .
     3617             if v-ok = true
     3618             then do:
     3619               for each buf_temp-user-obj
     3620               on error undo, return error return-value
     3621               :
     3622                 delete buf_temp-user-obj .
     3623               end.
     3624             end.
     3625             else do:
     3626               undo, return error return-value .
     3627             end.
     3628           end.
     3629         end.
     3630       end.
     3631     end.
     3632   END PROCEDURE.
     3633   PROCEDURE choose-mark :
     3634     define variable v-log as logical no-undo .
     3635     define buffer buf_temp-user-obj for temp-user-obj .
     3636     do
     3637     on error undo, return error return-value
     3638     :
     3639       if available X_clients
     3640       then do:
     3641         find first buf_temp-user-obj
     3642           where buf_temp-user-obj.obj-type = X_clients.obj-type
     3643             and buf_temp-user-obj.obj-code = X_clients.obj-code
     3644           no-error .
     3645         if available buf_temp-user-obj
     3646         then do:
     3647           run userobjs_delete in this-procedure
     3648             (input  X_clients.obj-type
     3649             ,input  X_clients.obj-code
     3650             ) .
     3651         end.
     3652         else do:
     3653           run userobjs_append in this-procedure
     3654             (input  X_clients.obj-type
     3655             ,input  X_clients.obj-code
     3656             ) .
     3657         end.
     3658         case var-br-name :         when "cli-list":U then do:            g#log = Cli-List:refresh() in frame Dialog-Frame .         end.         when "cli-listA":U then do:            g#log = Cli-ListA:refresh() .         end.         when "cli-listB":U then do:            g#log = Cli-ListB:refresh() .          end.         end case.
     3659         if last-event :function <> "MOUSE-SELECT-DBLCLICK"
     3660         then do:
     3661           case var-br-name :         when "cli-list":U then do:            g#log = Cli-List:select-next-row ().         end.         when "cli-listA":U then do:            g#log = Cli-ListA:select-next-row ().         end.         when "cli-listB":U then do:            g#log = Cli-ListB:select-next-row ().          end.         end case.
     3662           case var-br-name :         when "cli-list":U then do:            apply "value-changed" to Cli-List in frame Dialog-Frame .         end.         when "cli-listA":U then do:            apply "value-changed" to Cli-ListA in frame Dialog-Frame .         end.         when "cli-listB":U then do:             apply "value-changed" to Cli-ListB in frame Dialog-Frame .         end.         end case.
     3663         end.
     3664         run display-select-num in this-procedure .
     3665         case var-br-name :         when "cli-list":U then do:            apply "entry" to Cli-List in frame Dialog-Frame.         end.         when "cli-listA":U then do:            apply "entry" to Cli-ListA in frame Dialog-Frame.         end.         when "cli-listB":U then do:            apply "entry" to Cli-ListB in frame Dialog-Frame.         end.         end case.
     3666       end.
     3667     end.
     3668   END PROCEDURE.
     3669   PROCEDURE choose-select :
     3670     define buffer buf_temp-user-obj for temp-user-obj .
     3671     do
     3672     on error undo, return error return-value
     3673     :
     3674       do with frame Dialog-Frame
     3675       :
     3676         if available X_clients
     3677         then do:
     3678           if NOT can-do (p-bttns, "b-mark")
     3679           then do:
     3680           end.
     3681           else do:
     3682             find first buf_temp-user-obj
     3683               no-error .
     3684             if not available buf_temp-user-obj
     3685             then do:
     3686               run userobjs_append in this-procedure
     3687                 (input  X_clients.obj-type
     3688                 ,input  X_clients.obj-code
     3689                 ) .
     3690             end.
     3691             run userobjs_clear in p-callback-handle .
     3692             for each buf_temp-user-obj
     3693             on error undo, return error return-value
     3694             :
     3695               run userobjs_append in p-callback-handle
     3696                 (input  buf_temp-user-obj.obj-type
     3697                 ,input  buf_temp-user-obj.obj-code
     3698                 ) .
     3699             end.
     3700           end.
     3701         end.
     3702       end.
     3703     end.
     3704   END PROCEDURE.
     3705   PROCEDURE get-mark-string :
     3706     define input  parameter p-obj-type    as character no-undo .
     3707     define input  parameter p-obj-code    as integer   no-undo .
     3708     define output parameter p-mark-string as character no-undo .
     3709     define buffer buf_temp-user-obj for temp-user-obj .
     3710     do
     3711     on error undo, return error return-value
     3712     :
     3713       find first buf_temp-user-obj
     3714         where buf_temp-user-obj.obj-type = p-obj-type
     3715           and buf_temp-user-obj.obj-code = p-obj-code
     3716         no-error .
     3717       if available buf_temp-user-obj
     3718       then do:
     3719         assign
     3720           p-mark-string = '*':U
     3721         .
     3722       end.
     3723       else do:
     3724         assign
     3725           p-mark-string = '':U
     3726         .
     3727       end.
     3728     end.
     3729   END PROCEDURE.
     3730   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3731   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3732   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3733   on help of frame Dialog-Frame
     3734   do:
     3735     run gbl/app_help.p
     3736       (input this-procedure :file-name
     3737       ,input ''
     3738       ,input ?
     3739       ) no-error.
     3740     if error-status :error then do:
     3741       message
     3742         "Ошибка при вызове помощи"
     3743         error-status :get-message(1)
     3744         view-as alert-box .
     3745     end.
     3746   end.
     3747   run minbtn-set in this-procedure .
     3748   on choose of b-help in frame Dialog-Frame
     3749   do:
     3750     apply "help":u to frame Dialog-Frame .
     3751   end.
     3752   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3753   procedure minbtn-set :
     3754       do
     3755           on error undo, return error return-value
     3756           :
     3757           define variable ii              as integer       no-undo .
     3758           define variable fh              as widget-handle no-undo .
     3759           define variable hh              as widget-handle no-undo .
     3760           define variable v-h             as handle        extent 4 no-undo .
     3761           define variable v-name-button   as character     no-undo .
     3762           define variable v-help-old-x    as decimal       no-undo .
     3763           define variable v-help-old-y    as decimal       no-undo .
     3764           define variable v-help-old-size as decimal       no-undo .
     3765           define variable v-frame-width   as decimal       no-undo .
     3766           define variable jj              as integer       no-undo .
     3767           do
     3768               on error undo, return error
     3769               :
     3770               assign
     3771                   v-frame-width = frame Dialog-Frame:width - 0.3
     3772                   fh            = frame Dialog-Frame:first-child
     3773                   hh            = fh:first-child
     3774                   ii            = 1
     3775                   .
     3776               do while valid-handle(hh):
     3777                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3778                   do:
     3779                       case lc(hh:name) :
     3780                           when "b-help" then
     3781                               do:
     3782                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3783                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3784                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3785                                   hh:TOOLTIP = "Помощь" .
     3786                                   v-help-old-x = hh:column .
     3787                                   v-help-old-y = hh:row    .
     3788                                   v-help-old-size = hh:width .
     3789                                   hh:width-chars = 2.5 .
     3790                               end.
     3791                           when "b-print" then
     3792                               do:
     3793                                   hh:load-image("cmp/b-print.bmp":u) .
     3794                                   hh:TOOLTIP = "Печать" .
     3795                                   v-h[ii] = hh:handle .
     3796                                   ii = ii + 1 .
     3797                                   hh:width-chars = 3 .
     3798                               end.
     3799                           when "b-history" or
     3800                           when "b-hist" then
     3801                               do:
     3802                                   hh:load-image("cmp/b-hist.bmp":u) .
     3803                                   hh:TOOLTIP = "История" .
     3804                                   v-h[ii] = hh:handle .
     3805                                   ii = ii + 1 .
     3806                                   hh:width-chars = 3 .
     3807                               end.
     3808                           when "b-sch" then
     3809                               do:
     3810                                   hh:load-image("cmp/b-sch.bmp":u) .
     3811                                   hh:TOOLTIP = "Установка Фильтра" .
     3812                                   v-h[ii] = hh:handle .
     3813                                   ii = ii + 1 .
     3814                                   hh:width-chars = 3 .
     3815                               end.
     3816                           when "b-hist-user" then
     3817                               do:
     3818                                   hh:load-image("cmp/b-hist.bmp":u) .
     3819                                   hh:TOOLTIP = "История пользователя" .
     3820                                   ii = ii + 1 .
     3821                               end.
     3822                       end case.
     3823                   end.
     3824                   hh = hh:next-sibling.
     3825               end.
     3826               b-help:column = v-frame-width - b-help:width-chars.
     3827               jj = 0.
     3828               repeat ii = 4 to 1 by -1 :
     3829                   if valid-handle (v-h[ii] ) then
     3830                   do:
     3831                       jj  = jj + 1 .
     3832                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3833                       v-h[ii]:row    = v-help-old-y .
     3834                   end.
     3835               end.
     3836           end.
     3837       end.
     3838   end procedure.
     3839   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3840   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3841   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3842   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3843   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3844   define variable v-diasize-current-frame-height as decimal   no-undo .
     3845   define variable v-diasize-change-size          as logical   no-undo .
     3846   define variable v-diasize-resize-button        as handle    no-undo .
     3847   define variable v-diasize-wndmax               as logical   no-undo .
     3848   define variable v-diasize-wndstore             as logical   no-undo .
     3849   define variable v-diasize-proc-name            as character no-undo .
     3850   define variable v-diasize-browse-handle        as handle    no-undo .
     3851   define variable v-diasize-browse-number        as integer   no-undo .
     3852   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3853   define temp-table temp-diasize-handle no-undo
     3854     field handle-value  as handle
     3855     field save-position as decimal
     3856     index xpk is primary unique handle-value
     3857     .
     3858   define temp-table temp-browse-handle no-undo
     3859     field browse-type   as character
     3860     field browse-number as integer
     3861     field browse-handle as handle
     3862     field original-size as decimal
     3863     index xpk is primary unique browse-type browse-number
     3864     index xie browse-type browse-handle
     3865   .
     3866   procedure diasize_change-height :
     3867     define input  parameter p-change-value  as decimal   no-undo .
     3868     define input  parameter p-move-resize   as logical   no-undo .
     3869     define variable v-field-group-handle    as handle    no-undo .
     3870     define variable v-object-handle         as handle    no-undo .
     3871     define variable v-frame-height          as decimal   no-undo .
     3872     define variable v-frame-virtual-height  as decimal   no-undo .
     3873     define variable v-browse-height         as decimal   no-undo .
     3874     define variable v-window-height         as decimal   no-undo .
     3875     define variable v-window-virtual-height as decimal   no-undo .
     3876     define variable v-change-sign           as integer   no-undo .
     3877     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3878     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3879     if p-change-value > 0
     3880     then do:
     3881       if frame Dialog-Frame :height + p-change-value
     3882           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3883       then do:
     3884         assign
     3885           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3886                           - (frame Dialog-Frame :height-chars)
     3887         .
     3888         if p-change-value <= 0
     3889         then do:
     3890           run diasize_position-resize-button in this-procedure .
     3891           return .
     3892         end.
     3893       end.
     3894     end.
     3895     if p-change-value < 0
     3896     then do:
     3897       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3898       then do:
     3899         assign
     3900           p-change-value = v-diasize-orig-frame-height
     3901                          - (frame Dialog-Frame :height-chars)
     3902         .
     3903         if p-change-value >= 0
     3904         then do:
     3905           run diasize_position-resize-button in this-procedure .
     3906           return .
     3907         end.
     3908       end.
     3909     end.
     3910     if p-change-value >= 0
     3911     then do:
     3912       assign
     3913         v-change-sign = 1
     3914       .
     3915     end.
     3916     else do:
     3917       assign
     3918         v-change-sign = -1
     3919       .
     3920     end.
     3921     assign
     3922       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3923     .
     3924     if p-change-value = 0
     3925     then do:
     3926       run diasize_position-resize-button in this-procedure .
     3927       return .
     3928     end.
     3929     move_block:
     3930     do
     3931     on error undo move_block, retry move_block
     3932     :
     3933       if retry
     3934       then do:
     3935         do
     3936         on error undo move_block, leave move_block
     3937         :
     3938           if p-change-value > 0
     3939           then do:
     3940             for each buf_temp-diasize-handle
     3941             on error undo, next
     3942             :
     3943               assign
     3944                 v-object-handle = buf_temp-diasize-handle.handle-value
     3945               .
     3946               if v-object-handle <> v-diasize-resize-button
     3947               then do:
     3948                 assign
     3949                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3950                 .
     3951               end.
     3952             end.
     3953             assign
     3954               v-diasize-browse-handle :height = v-browse-height
     3955             .
     3956             for each buf_temp-browse-handle
     3957               where buf_temp-browse-handle.browse-type = 'height':u
     3958             on error undo, next
     3959             :
     3960               assign
     3961                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3962               .
     3963             end.
     3964             assign
     3965               frame Dialog-Frame :height = v-frame-height
     3966             .
     3967             if frame Dialog-Frame :scrollable = true
     3968             then do:
     3969               assign
     3970                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3971               .
     3972             end.
     3973             run diasize_position-resize-button in this-procedure .
     3974           end.
     3975           else do:
     3976             if frame Dialog-Frame :scrollable = true
     3977             then do:
     3978               assign
     3979                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3980               .
     3981             end.
     3982             assign
     3983               frame Dialog-Frame :height = v-frame-height
     3984             .
     3985             assign
     3986               v-diasize-browse-handle :height = v-browse-height
     3987             .
     3988             for each buf_temp-browse-handle
     3989               where buf_temp-browse-handle.browse-type = 'height':u
     3990             on error undo, next
     3991             :
     3992               assign
     3993                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3994               .
     3995             end.
     3996             for each buf_temp-diasize-handle
     3997             on error undo, next
     3998             :
     3999               assign
     4000                 v-object-handle = buf_temp-diasize-handle.handle-value
     4001               .
     4002               if v-object-handle <> v-diasize-resize-button
     4003               then do:
     4004                 assign
     4005                   v-object-handle :row = buf_temp-diasize-handle.save-position
     4006                 .
     4007               end.
     4008             end.
     4009             run diasize_position-resize-button in this-procedure .
     4010           end.
     4011           assign
     4012             v-diasize-change-size = false
     4013           .
     4014           leave move_block .
     4015         end.
     4016       end.
     4017       assign
     4018         v-diasize-need-full-display = true
     4019       .
     4020       if v-diasize-change-size = false
     4021       then do:
     4022         assign
     4023           v-diasize-change-size = true
     4024         .
     4025       end.
     4026       else do:
     4027         return .
     4028       end.
     4029       assign
     4030         v-frame-height = frame Dialog-Frame :height
     4031         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     4032         v-browse-height = v-diasize-browse-handle :height
     4033       .
     4034       for each buf_temp-browse-handle
     4035         where buf_temp-browse-handle.browse-type = 'height':u
     4036       :
     4037         assign
     4038           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     4039         .
     4040       end.
     4041       for each buf_temp-diasize-handle
     4042       :
     4043         delete buf_temp-diasize-handle .
     4044       end.
     4045       assign
     4046         v-field-group-handle = frame Dialog-Frame :first-child
     4047       .
     4048       do while valid-handle(v-field-group-handle)
     4049       :
     4050         assign
     4051           v-object-handle = v-field-group-handle :first-child
     4052         .
     4053         do while valid-handle(v-object-handle)
     4054         :
     4055           if  v-object-handle <> v-diasize-browse-handle :handle
     4056           and can-query(v-object-handle, "row")
     4057           and can-query(v-object-handle, "height")
     4058           and ( v-object-handle :row > v-diasize-browse-handle :row )
     4059           then do:
     4060             find first buf_temp-browse-handle
     4061               where buf_temp-browse-handle.browse-type   = 'height':u
     4062                 and buf_temp-browse-handle.browse-handle = v-object-handle
     4063               no-error .
     4064             if available buf_temp-browse-handle
     4065             then do:
     4066             end.
     4067             else do:
     4068               create buf_temp-diasize-handle .
     4069               assign
     4070                 buf_temp-diasize-handle.handle-value  = v-object-handle
     4071                 buf_temp-diasize-handle.save-position = v-object-handle :row
     4072               .
     4073             end.
     4074           end.
     4075           assign
     4076             v-object-handle = v-object-handle :next-sibling
     4077           .
     4078         end.
     4079         assign
     4080           v-field-group-handle = v-field-group-handle :next-sibling
     4081         .
     4082       end.
     4083       do with frame Dialog-Frame
     4084       :
     4085         hide v-diasize-resize-button .
     4086         assign
     4087           v-diasize-resize-button :row    = 1
     4088           v-diasize-resize-button :column = 1
     4089         .
     4090       end.
     4091       if p-change-value > 0
     4092       then do:
     4093         if frame Dialog-Frame :scrollable = true
     4094         then do:
     4095           assign
     4096             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     4097             no-error .
     4098           if error-status :error
     4099           or error-status :get-message(1) <> ""
     4100           then do:
     4101             undo move_block, retry move_block .
     4102           end.
     4103         end.
     4104         assign
     4105           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     4106           no-error .
     4107         if error-status :error
     4108         or error-status :get-message(1) <> ""
     4109         then do:
     4110           undo move_block, retry move_block .
     4111         end.
     4112         assign
     4113           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     4114           no-error .
     4115         if error-status :error
     4116         or error-status :get-message(1) <> ""
     4117         then do:
     4118           undo move_block, retry move_block .
     4119         end.
     4120         for each buf_temp-browse-handle
     4121           where buf_temp-browse-handle.browse-type = 'height':u
     4122         on error undo move_block, retry move_block
     4123         :
     4124           assign
     4125             buf_temp-browse-handle.browse-handle :height
     4126               = buf_temp-browse-handle.browse-handle :height + p-change-value
     4127             no-error .
     4128           if error-status :error
     4129           or error-status :get-message(1) <> ""
     4130           then do:
     4131             undo move_block, retry move_block .
     4132           end.
     4133         end.
     4134         for each buf_temp-diasize-handle
     4135         on error undo move_block, retry move_block
     4136         :
     4137           assign
     4138             v-object-handle = buf_temp-diasize-handle.handle-value
     4139           .
     4140           if v-object-handle <> v-diasize-resize-button
     4141           then do:
     4142             assign
     4143               v-object-handle :row = v-object-handle :row + p-change-value
     4144               no-error .
     4145             if error-status :error
     4146             or error-status :get-message(1) <> ""
     4147             then do:
     4148               undo move_block, retry move_block .
     4149             end.
     4150           end.
     4151         end.
     4152       end.
     4153       else do:
     4154         for each buf_temp-diasize-handle
     4155         on error undo move_block, retry move_block
     4156         :
     4157           assign
     4158             v-object-handle = buf_temp-diasize-handle.handle-value
     4159           .
     4160           if v-object-handle <> v-diasize-resize-button
     4161           then do:
     4162             assign
     4163               v-object-handle :row = v-object-handle :row + p-change-value
     4164               no-error .
     4165             if error-status :error
     4166             or error-status :get-message(1) <> ""
     4167             then do:
     4168               undo move_block, retry move_block .
     4169             end.
     4170           end.
     4171         end.
     4172         assign
     4173           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     4174           no-error .
     4175         if error-status :error
     4176         or error-status :get-message(1) <> ""
     4177         then do:
     4178           undo move_block, retry move_block .
     4179         end.
     4180         for each buf_temp-browse-handle
     4181           where buf_temp-browse-handle.browse-type = 'height':u
     4182         on error undo move_block, retry move_block
     4183         :
     4184           assign
     4185             buf_temp-browse-handle.browse-handle :height
     4186               = buf_temp-browse-handle.browse-handle :height + p-change-value
     4187             no-error .
     4188           if error-status :error
     4189           or error-status :get-message(1) <> ""
     4190           then do:
     4191             undo move_block, retry move_block .
     4192           end.
     4193         end.
     4194         assign
     4195           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     4196           no-error .
     4197         if error-status :error
     4198         or error-status :get-message(1) <> ""
     4199         then do:
     4200           undo move_block, retry move_block .
     4201         end.
     4202         if frame Dialog-Frame :scrollable = true
     4203         then do:
     4204           assign
     4205             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     4206             no-error .
     4207           if error-status :error
     4208           or error-status :get-message(1) <> ""
     4209           then do:
     4210             undo move_block, retry move_block .
     4211           end.
     4212         end.
     4213       end.
     4214       if p-move-resize = true
     4215       then do:
     4216         run diasize_position-resize-button in this-procedure .
     4217       end.
     4218       if v-diasize-wndstore = true
     4219       then do:
     4220         if connected("ub") = true
     4221         then do:
     4222           define variable v-cntxt-db-num        as integer   no-undo .
     4223           define variable v-cntxt-userid        as character no-undo .
     4224           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4225                                             , OUTPUT v-cntxt-userid
     4226                                             ) .
     4227           run gbl/wndsizew.p
     4228             (input  v-cntxt-db-num
     4229             ,input  v-cntxt-userid
     4230             ,input  v-diasize-proc-name
     4231             ,input  'height':u
     4232             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     4233             ) .
     4234         end.
     4235       end.
     4236     end.
     4237     assign
     4238       v-diasize-change-size = false
     4239     .
     4240   end procedure.
     4241   procedure diasize_set-height :
     4242     define input  parameter p-new-height  as decimal   no-undo .
     4243     define input  parameter p-move-resize as logical   no-undo .
     4244     do
     4245     on error undo, return error return-value
     4246     :
     4247       run diasize_change-height in this-procedure
     4248         (input  (p-new-height - frame Dialog-Frame :height)
     4249         ,input  p-move-resize
     4250         ) .
     4251     end.
     4252   end procedure.
     4253   procedure diasize_change-width :
     4254     define input  parameter p-change-value as decimal   no-undo .
     4255     define input  parameter p-move-resize  as logical   no-undo .
     4256     define variable v-field-group-handle   as handle    no-undo .
     4257     define variable v-object-handle        as handle    no-undo .
     4258     define variable v-frame-width          as decimal   no-undo .
     4259     define variable v-frame-virtual-width  as decimal   no-undo .
     4260     define variable v-browse-width         as decimal   no-undo .
     4261     define variable v-window-width         as decimal   no-undo .
     4262     define variable v-window-virtual-width as decimal   no-undo .
     4263     define variable v-change-sign          as integer   no-undo .
     4264     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     4265     define buffer buf_temp-browse-handle  for temp-browse-handle .
     4266     if p-change-value > 0
     4267     then do:
     4268       if frame Dialog-Frame :width + p-change-value >
     4269           session :width-chars
     4270       then do:
     4271         assign
     4272           p-change-value = session :width-chars - frame Dialog-Frame :width
     4273         .
     4274         if p-change-value <= 0
     4275         then do:
     4276           run diasize_position-resize-button in this-procedure .
     4277           return .
     4278         end.
     4279       end.
     4280     end.
     4281     if p-change-value < 0
     4282     then do:
     4283       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     4284       then do:
     4285         assign
     4286           p-change-value = v-diasize-orig-frame-width
     4287                          - frame Dialog-Frame :width
     4288         .
     4289         if p-change-value >= 0
     4290         then do:
     4291           run diasize_position-resize-button in this-procedure .
     4292           return .
     4293         end.
     4294       end.
     4295     end.
     4296     if p-change-value >= 0
     4297     then do:
     4298       assign
     4299         v-change-sign = 1
     4300       .
     4301     end.
     4302     else do:
     4303       assign
     4304         v-change-sign = -1
     4305       .
     4306     end.
     4307     assign
     4308       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     4309     .
     4310     if p-change-value = 0
     4311     then do:
     4312       run diasize_position-resize-button in this-procedure .
     4313       return .
     4314     end.
     4315     move_block:
     4316     do
     4317     on error undo move_block, leave move_block
     4318     :
     4319       if retry
     4320       then do:
     4321         do
     4322         on error undo move_block, leave move_block
     4323         :
     4324           if p-change-value > 0
     4325           then do:
     4326             for each buf_temp-diasize-handle
     4327             on error undo, next
     4328             :
     4329               assign
     4330                 v-object-handle = buf_temp-diasize-handle.handle-value
     4331               .
     4332               if v-object-handle <> v-diasize-resize-button
     4333               then do:
     4334                 assign
     4335                   v-object-handle :col = buf_temp-diasize-handle.save-position
     4336                 .
     4337               end.
     4338             end.
     4339             assign
     4340               v-diasize-browse-handle :width = v-browse-width
     4341             .
     4342             for each buf_temp-browse-handle
     4343               where buf_temp-browse-handle.browse-type = 'width':u
     4344             on error undo, next
     4345             :
     4346               assign
     4347                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4348               .
     4349             end.
     4350             assign
     4351               frame Dialog-Frame :width = v-frame-width
     4352             .
     4353             if frame Dialog-Frame :scrollable = true
     4354             then do:
     4355               assign
     4356                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     4357               .
     4358             end.
     4359             run diasize_position-resize-button in this-procedure .
     4360           end.
     4361           else do:
     4362             if frame Dialog-Frame :scrollable = true
     4363             then do:
     4364               assign
     4365                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     4366               .
     4367             end.
     4368             assign
     4369               frame Dialog-Frame :width = v-frame-width
     4370             .
     4371             for each buf_temp-browse-handle
     4372               where buf_temp-browse-handle.browse-type = 'width':u
     4373             on error undo, next
     4374             :
     4375               assign
     4376                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     4377               .
     4378             end.
     4379             assign
     4380               v-diasize-browse-handle :width = v-browse-width
     4381             .
     4382             for each buf_temp-diasize-handle
     4383             on error undo, next
     4384             :
     4385               assign
     4386                 v-object-handle = buf_temp-diasize-handle.handle-value
     4387               .
     4388               if v-object-handle <> v-diasize-resize-button
     4389               then do:
