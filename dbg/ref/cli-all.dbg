     6698                     x_temp-list-buyer.obj-code = X_clients-attr.obj-code
     6699                   .
     6700                 end.
     6701           end.
     6702         end.
     6703         if  entry(1, entry(ii, c-other, ";":U), "=":U) = "tank-farm-for":U then do :
     6704           if entry(2, entry(ii, c-other, ";":U), "=":U) <> "":U
     6705           then do:
     6706             v-tank-farm-for = entry(2, entry(ii, c-other, ";":U), "=":U).
     6707             do jj = 1 to num-entries(v-tank-farm-for)  :
     6708               v-str = entry(jj,v-tank-farm-for).
     6709               v-cli-type = substring(v-str,1,3).
     6710               v-cli-code = integer(trim(v-str,v-cli-type)).
     6711               find first X_clients no-lock
     6712                   where X_clients.obj-type = v-cli-type
     6713                     and X_clients.obj-code = v-cli-code no-error.
     6714               if available X_clients then do :
     6715                 if v-rid-list = "" then do :
     6716                   v-rid-list = string( recid(X_clients) ).
     6717                 end.
     6718                 else do :
     6719                   v-rid-list = v-rid-list + "," + string( recid(X_clients) ).
     6720                 end.
     6721               end.
     6722             end.
     6723           end.
     6724         end.
     6725         if  entry(1, entry(ii, c-other, ";":U), "=":U) = "auto-tank-for":U then do :
     6726           if entry(2, entry(ii, c-other, ";":U), "=":U) <> "":U
     6727           then do:
     6728             v-auto-tank-for = entry(2, entry(ii, c-other, ";":U), "=":U).
     6729             do jj = 1 to num-entries(v-auto-tank-for) :
     6730               v-str = entry(jj,v-auto-tank-for).
     6731               v-cli-type = substring(v-str,1,3).
     6732               v-cli-code = integer(trim(v-str,v-cli-type)).
     6733               find first X_clients no-lock
     6734                   where X_clients.obj-type = v-cli-type
     6735                     and X_clients.obj-code = v-cli-code no-error.
     6736               if available X_clients then do :
     6737                 if v-rid-list = "" then do :
