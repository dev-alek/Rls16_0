      780   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      781   procedure cur-time :
      782      define output parameter p-today as date      no-undo .
      783      define output parameter p-time  as integer   no-undo .
      784     do
      785     on error undo, return error
      786     :
      787       define variable v-date1 as date      no-undo .
      788       define variable v-date2 as date      no-undo .
      789       define variable v-time  as integer   no-undo .
      790       assign
      791         v-date1 = today
      792         v-time  = time
      793         v-date2 = today
      794       .
      795       if v-date1 <> v-date2
      796       then do:
      797         assign
      798           v-date1 = today
      799           v-time  = v-time
      800         .
      801       end.
      802       assign
      803         p-today = v-date1
      804         p-time  = v-time
      805       .
      806     end.
      807   end.
      808   function cur-time-date returns character
      809   :
      810     return string(today, '99/99/9999':U) .
      811   end.
      812   function cur-time-mjd returns decimal
      813   :
      814     define variable v-date as date      no-undo .
      815     define variable v-time as integer   no-undo .
      816     run cur-time in this-procedure
      817       (output v-date
      818       ,output v-time
      819       ) .
      820     return integer(v-date) - 2400002 + (v-time / 86400) .
      821   end.
      822   function cur-time-get-ending-index returns integer
      823   (input p-number as integer
      824   )
      825   :
      826     if p-number < 0
      827     or p-number = ?
      828     then do:
      829       return 1 .
      830     end.
      831     define variable v-rest as integer   no-undo .
      832     assign
      833       p-number = p-number modulo 100
      834     .
      835     if p-number < 20
      836     then do:
      837       assign
      838         v-rest = p-number
      839       .
      840     end.
      841     else do:
      842       assign
      843         v-rest = p-number modulo 10
      844       .
      845     end.
      846     case v-rest :
      847       when 1
      848       then do:
      849         return 2 .
      850       end.
      851       when 2 or
      852       when 3 or
      853       when 4
      854       then do:
      855         return 3 .
      856       end.
      857       otherwise do:
      858         return 1 .
      859       end.
      860     end case .
      861   end.
      862   procedure cur-time-mjd-to-date :
      863      define input  parameter i-mjd-diff as decimal no-undo.
      864      define output parameter o-Date     as date    no-undo.
      865      define output parameter o-Time     as integer no-undo.
      866      define variable v-day-number as integer   no-undo .
      867      if    i-mjd-diff < 0
      868         or i-mjd-diff = ?
      869      then do:
      870         return "?" .
      871      end.
      872      assign
      873         v-day-number = truncate(i-mjd-diff,0).
      874         o-Date = date(v-day-number + 2400002).
      875         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      876     .
      877   end.
      878   function cur-time-mjd-to-string returns character
      879   (input p-mjd-diff as decimal
      880   )
      881   :
      882     define variable v-day-number as integer   no-undo .
      883     define variable v-seconds    as integer   no-undo .
      884     define variable v-hour       as integer   no-undo .
      885     define variable v-min        as integer   no-undo .
      886     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      887     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      888     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      889     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      890     if p-mjd-diff < 0
      891     or p-mjd-diff = ?
      892     then do:
      893       return "?" .
      894     end.
      895     assign
      896       v-day-number = integer(truncate(p-mjd-diff,0))
      897       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      898     .
      899     if v-seconds > 86400
      900     then do:
      901       assign
      902         v-seconds = 86400 - 1
      903       .
      904     end.
      905     if v-seconds < 0
      906     then do:
      907       assign
      908         v-seconds = 0
      909       .
      910     end.
      911     assign
      912       v-hour = truncate(v-seconds / 3600, 0)
      913     .
      914     assign
      915       v-seconds = v-seconds modulo 3600
      916     .
      917     assign
      918       v-min = truncate(v-seconds / 60, 0)
      919     .
      920     assign
      921       v-seconds = v-seconds modulo 60
      922     .
      923     return
      924         (if v-day-number <> 0
      925           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      926           else ""
      927         )
      928       + (if v-day-number <> 0 or v-hour <> 0
      929           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      930           else ""
      931         )
      932       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      933           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      934           else ""
      935         )
      936       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      937       .
      938   end.
      939   function cur-time-string returns character
      940   :
      941     define variable v-date as date      no-undo .
      942     define variable v-time as integer   no-undo .
      943     run cur-time in this-procedure
      944       (output v-date
      945       ,output v-time
      946       ) .
      947     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      948   end.
      949   function cur-time-string-sec returns character
      950   :
      951     define variable v-date as date      no-undo .
      952     define variable v-time as integer   no-undo .
      953     run cur-time in this-procedure
      954       (output v-date
      955       ,output v-time
      956       ) .
      957     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      958   end.
      959   function cur-time-custom  returns character
      960   (input p-prefix as character
      961   ,input p-date-format as character
      962   ,input p-delimiter as character
      963   ,input p-time-format as character
      964   ,input p-suffix as character
      965   )
      966   :
      967     define variable v-date as date      no-undo .
      968     define variable v-time as integer   no-undo .
      969     run cur-time in this-procedure
      970       (output v-date
      971       ,output v-time
      972       ) .
      973     return
      974       p-prefix
      975       + string(v-date, p-date-format)
      976       + p-delimiter
      977       + string(v-time, p-time-format)
      978       + p-suffix
      979       .
      980   end.
      981   function cur-time-print  returns character
      982   :
      983     define variable v-date as date      no-undo .
      984     define variable v-time as integer   no-undo .
      985     run cur-time in this-procedure
      986       (output v-date
      987       ,output v-time
      988       ) .
      989     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      990   end.
      991   function cur-time-datetime returns datetime
      992   :
      993     define variable v-char as character no-undo .
      994     define variable v-datetime as datetime no-undo .
      995     v-char = cur-time-string().
      996     v-datetime = datetime(v-char).
      997     return  v-datetime.
      998   end.
      999   function cur-time-string-msec returns character
     1000   :
     1001     define variable v-date as datetime  no-undo .
     1002     v-date = now.
     1003     return string(v-date) .
     1004   end.
     1005   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1006   procedure cli-grplib-get-full-name :
     1007      define input parameter  p-node-code  as integer      no-undo.
     1008      define output parameter p-full-name as character    no-undo.
     1009   do
     1010   on error undo, return error
     1011   :
     1012       define variable v-upper-code    as integer           no-undo.
     1013       define buffer buf_cli-grp       for ub.cli-grp.
     1014       define buffer buf_upper_cli-grp for ub.cli-grp.
     1015       find first buf_cli-grp no-lock
     1016            where buf_cli-grp.node-code = p-node-code
     1017       no-error.
     1018       if not available buf_cli-grp
     1019       then do:
     1020           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
     1021       end.
     1022       assign
     1023           p-full-name  = ""
     1024           v-upper-code = 1
     1025       .
     1026       do while buf_cli-grp.upper-code <> 0
     1027       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1028       :
     1029           assign
     1030               p-full-name  = buf_cli-grp.node-name
     1031                            + (if p-full-name <> "" then chr(47) else "")
     1032                            + p-full-name
     1033               v-upper-code = buf_cli-grp.upper-code
     1034           .
     1035           find first buf_cli-grp no-lock
     1036                where buf_cli-grp.node-code = v-upper-code
     1037           no-error.
     1038           if not available buf_cli-grp
     1039           then do:
     1040               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
     1041                                   + string( v-upper-code )
     1042                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1043           end.
     1044       end.
     1045       assign
     1046       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1047       .
     1048   end.
     1049   end .
     1050   procedure cgrplib-get-node-from-full-name :
     1051   define input parameter p-full-name as character no-undo .
     1052   define output parameter p-node-code as integer no-undo .
     1053   define variable v-ii as integer no-undo .
     1054   define variable v-upper-code as integer no-undo .
     1055   define variable v-root-code as integer no-undo .
     1056   define variable v-entry as character no-undo .
     1057   define buffer buf_cli-grp       for ub.cli-grp.
     1058   do
     1059   on error undo, return error
     1060   :
     1061     find first buf_cli-grp no-lock
     1062         where buf_cli-grp.upper-code = 0
     1063     no-error .
     1064     if not available buf_cli-grp
     1065     then do:
     1066         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
     1067     end.
     1068     else do:
     1069       assign
     1070       v-root-code = buf_cli-grp.node-code
     1071       .
     1072     end.
     1073     v-upper-code = v-root-code.
     1074     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1075       assign
     1076       v-entry = entry(v-ii, p-full-name, chr(47)).
     1077       if v-entry = '' then leave.
     1078       find first buf_cli-grp no-lock where
     1079                 buf_cli-grp.node-name = v-entry
     1080             and buf_cli-grp.upper-code = v-upper-code
     1081             no-error.
     1082       if not available buf_cli-grp then do:
     1083         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1084       end.
     1085       else do:
     1086         p-node-code = buf_cli-grp.node-code.
     1087         v-upper-code = buf_cli-grp.node-code.
     1088       end.
     1089     end.
     1090   end.
     1091   end .
     1092   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1093   define variable v-waitfram-action01         as character   no-undo .
     1094   define variable v-waitfram-action02         as character   no-undo .
     1095   define variable v-waitfram-action03         as character   no-undo .
     1096   define variable mWaitFramTextBeg            as character   no-undo.
     1097   define variable mWaitFramTextEnd            as character   no-undo.
     1098   define variable mWaitFramView               as logical     no-undo.
     1099   define variable mWaitProcEvent              as logical     no-undo init yes.
     1100   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1101   define variable mWaitFramStop               as logical     no-undo.
     1102   define variable mWaitFramStopUser           as logical     no-undo.
     1103   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1104   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1105   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1106   define button B-WaitFramStop auto-end-key
     1107        label "Стоп"
     1108        size 10 by 1 tooltip "Остоновить процесс".
     1109   define button B-viewProcInfo
     1110        label "Информация"
     1111        size 15 by 1 tooltip "Информация о процесс".
     1112   define frame waitfram
     1113     v-waitfram-action01 format "x(72)" no-label skip
     1114     v-waitfram-action02 format "x(72)" no-label skip
     1115     v-waitfram-action03 format "x(72)" no-label skip
     1116     B-viewProcInfo
     1117     B-WaitFramStop at row 4 col 30
     1118     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1119     .
     1120   define new global shared variable mBatchMode as logical no-undo init ?.
     1121   define variable mFramBachModHandle as handle no-undo.
     1122   mFramBachModHandle = frame waitfram:handle.
     1123   define variable mFameOldVis as logical no-undo.
     1124   define variable mVisCUrentVin as logical no-undo.
     1125   if session:batch-mode
     1126   then
     1127      mBatchMode = yes.
     1128   if mBatchMode = ? then do:
     1129     mVisCUrentVin = current-window:visible.
     1130     mFameOldVis = mFramBachModHandle:visible.
     1131     mFramBachModHandle:visible  = yes.
     1132     mBatchMode = mFramBachModHandle:visible ne yes.
     1133     mFramBachModHandle:visible = mFameOldVis.
     1134     current-window:visible = mVisCUrentVin.
     1135   end.
     1136    if  log-manager:logfile-name ne ?
     1137     then DO:
     1138         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1139         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1140         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1141     end.
     1142   on choose of B-WaitFramStop in frame waitfram
     1143   do:
     1144     mWaitFramStop = yes.
     1145     mWaitFramStopUser = yes.
     1146   end.
     1147   function waitfram-check-timeout returns logical():
     1148      define variable vtime as int64 no-undo.
     1149      if mWaitFramStopTimeOut
     1150      then
     1151         return yes.
     1152      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1153      if     mWaitFramTimeOut ne ?
     1154         and mWaitFramTimeOut ne 0
     1155         and mWaitFramTimeOut lt vtime
     1156      then do:
     1157         mWaitFramStopTimeOut = yes.
     1158      end.
     1159      return mWaitFramStopTimeOut.
     1160   end.
     1161   procedure waitfram-hide :
     1162     if not session:batch-mode
     1163     then do
     1164     on error undo, return error return-value
     1165     :
     1166       pause 0 before-hide .
     1167       if not mBatchMode then
     1168         hide frame waitfram .
     1169     if     not mWaitFramView
     1170        and mWaitProcEvent
     1171     then
     1172       process events .
     1173     end.
     1174   end procedure.
     1175   procedure waitfram-show :
     1176     define input  parameter p-message as character no-undo .
     1177     define variable v-left-margin as integer   no-undo .
     1178     if not session:batch-mode
     1179     then do
     1180     on error undo, return error return-value
     1181     :
     1182       if length(p-message) <= 70 then do:
     1183         assign
     1184           v-left-margin = integer((70 - length(p-message)) / 2)
     1185         .
     1186         assign
     1187           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1188         .
     1189         assign
     1190           v-waitfram-action01 = " "
     1191           v-waitfram-action02 = " "
     1192                                    + fill(" ", v-left-margin)
     1193                                    + p-message
     1194           v-waitfram-action03 = " "
     1195         .
     1196       end.
     1197       else do:
     1198         define variable vRindex1 as integer no-undo.
     1199         define variable vRindex2 as integer no-undo.
     1200         vRindex1 = r-index(p-message," ",70).
     1201         if vRindex1 = 0
     1202         then
     1203            vRindex1 = 70.
     1204         if length(p-message)  <= vRindex1 + 70 then do:
     1205           assign
     1206             v-waitfram-action01 = " "
     1207             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1208             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1209           .
     1210         end.
     1211         else do:
     1212           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1213           if vRindex2 <= vRindex1
     1214           then
     1215              vRindex2 = vRindex1 + 70.
     1216           assign
     1217             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1218             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1219             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1220           .
     1221         end.
     1222       end.
     1223       B-viewProcInfo:visible   in frame waitfram = no.
     1224       B-viewProcInfo:sensitive in frame waitfram = no.
     1225       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1226       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1227       if  (   mWaitFramView
     1228          or  mWaitProcEvent)
     1229          and not mBatchMode
     1230       then
     1231          display
     1232             v-waitfram-action01 skip
     1233             v-waitfram-action02 skip
     1234             v-waitfram-action03 skip
     1235          with frame waitfram .
     1236       if     mWaitFramView
     1237          then do:
     1238             if     mWaitFramInterval ne ?
     1239                and not mBatchMode
     1240             then
     1241                wait-for go of frame waitfram pause mWaitFramInterval.
     1242          end.
     1243          else
     1244             if     mWaitProcEvent
     1245                and not mBatchMode
     1246             then
     1247                process events .
     1248     end.
     1249   end procedure.
     1250      procedure waitfram-show-this:
     1251         define input  parameter iInterval as int64 no-undo.
     1252         define variable vtime as int64 no-undo.
     1253         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1254         mWaitFramInterval = iInterval.
     1255         run waitfram-show (substitute("&1&2 &3&4" ,
     1256                                       mWaitFramTextBeg ,
     1257                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1258                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1259                                       mWaitFramTextEnd
     1260                                      )
     1261                           ).
     1262      end.
     1263      procedure WaitFramRunPause:
     1264         define input  parameter iInterval as dec no-undo.
     1265         define variable vStart  as datetime-tz no-undo.
     1266         define variable vend    as datetime-tz no-undo.
     1267         define variable vint as int64 no-undo.
     1268         define variable vOk as logical no-undo.
     1269         vStart = now.
     1270         vend   = vStart.
     1271         publish "WaitFramPause" (iInterval,output vOk).
     1272         vend   =  now.
     1273         vint = vend - vStart.
     1274         vint = iInterval - vint / 1000.
     1275         if     not mWaitFramStop
     1276            and (   vint > 0
     1277                 or (    not vOk
     1278                     and iInterval eq ?
     1279                     )
     1280                 )
     1281         then
     1282            run waitfram-show-this (iInterval).
     1283         vend   =  now.
     1284         vint = vend - vStart.
     1285         vint = iInterval - vint / 1000.
     1286         if     not mWaitFramStop
     1287            and vint > 0
     1288         then do:
     1289            run gbl/pause.p (vint * 1000).
     1290         end.
     1291         if iInterval ne ?
     1292         then
     1293            publish "WaitFramStop".
     1294         waitfram-check-timeout().
     1295      end.
     1296      procedure WaitFramWaitFor:
     1297         define input  parameter iInterval as dec no-undo.
     1298         assign
     1299            mWaitFramStartProc   = now
     1300            mWaitFramStopUser    = no
     1301            mWaitFramStopTimeOut = no
     1302         .
     1303         block-wait:
     1304         do while not mWaitFramStop:
     1305            run WaitFramRunPause (iInterval).
     1306            if  waitfram-check-timeout()
     1307            then do:
     1308               leave block-wait.
     1309            end.
     1310         end.
     1311         run waitfram-hide.
     1312      end.
     1313   procedure waitfram-join :
     1314     define input  parameter p-line-1  as character no-undo .
     1315     define input  parameter p-line-2  as character no-undo .
     1316     define input  parameter p-line-3  as character no-undo .
     1317     define output parameter p-message as character no-undo .
     1318     do
     1319     on error undo, return error return-value
     1320     :
     1321       assign
     1322         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1323                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1324                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1325       .
     1326     end.
     1327   end procedure.
     1328   function waitfram-join-function returns character
     1329     (input p-line-1 as character
     1330     ,input p-line-2 as character
     1331     ,input p-line-3 as character
     1332     ).
     1333     define variable v-message as character no-undo .
     1334     run waitfram-join in this-procedure
     1335       (input  p-line-1
     1336       ,input  p-line-2
     1337       ,input  p-line-3
     1338       ,output v-message
     1339       ) .
     1340     return v-message .
     1341   end function .
     1342   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1343   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
     1344   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
     1345   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1346   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1347   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
     1348   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
     1349   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
     1350   procedure uf-name :
     1351     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1352     define output parameter p-use-List_     as logical   no-undo .
     1353     define output parameter p-type-List_     as character no-undo .
     1354     define output parameter p-format-List_   as character no-undo .
     1355     define output parameter p-use-Naim      as logical   no-undo .
     1356     define output parameter p-type-Naim      as character no-undo .
     1357     define output parameter p-format-Naim    as character no-undo .
     1358     define output parameter p-use-print-graft as logical   no-undo .
     1359     define output parameter p-use-sort-gr   as logical   no-undo .
     1360     define output parameter p-use-type-price as logical   no-undo .
     1361     define output parameter p-use-type-val  as logical   no-undo .
     1362     define output parameter p-label          as character no-undo .
     1363     define output parameter p-tooltip        as character no-undo .
     1364     define output parameter p-user-can-edit  as logical   no-undo .
     1365     define output parameter p-output-display as logical   no-undo .
     1366     define output parameter p-other          as character no-undo .
     1367     do
     1368     on error undo, return error
     1369     :
     1370       case p-code :
     1371               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1372               when 'oldscode':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника неиспользуемых весовых кодов"     p-tooltip = "Настройки справочника неиспользуемых весовых кодов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1373               when 'gds-ref-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(8)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = yes      p-label = "Параметры вызова справочника товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1374               when 'gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1375               when 'fbr-gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп блюд"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп блюд"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1376               when 'cli-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1377               when 'findoci-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова карточки платежа"     p-tooltip = "Параметры по умолчанию, используемые для вызова карточки платежа"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1378               when 'findocs-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника платежей"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника платежей"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1379               when 'fin-obi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова карточки платежа"     p-tooltip = "Параметры по умолчанию, используемые для вызова карточки платежа"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1380               when 'seqeallo':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Порядок колонок в АВТО-ЗАКАЗЕ"     p-tooltip = "Порядок колонок в РАСЧЕТЕ потребности заказа и его импорте"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
