     3424   ON LEAVE OF NameOrCode IN FRAME Dialog-Frame
     3425   DO:
     3426   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3427   if lookup(self :type
     3428            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3429            ) = 0
     3430   then do:
     3431     message
     3432       "$Workfile$"
     3433       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3434       "Интерфейсный элемент" self :name  skip
     3435       "Тип" self :type  skip
     3436       "Процедура" this-procedure :file-name skip
     3437       view-as alert-box .
     3438   end.
     3439   else do:
     3440     apply "entry":u to self  .
     3441     if focus :handle <> self :handle  then do:
     3442       return no-apply .
     3443     end.
     3444   end.
     3445       assign
     3446       NameOrCode
     3447       .
     3448    if last-event:function <> "RETURN" then  do:
     3449      if ( NameOrCode = "" ) OR ( num-results( var-br-name ) = 0 ) then   do:
     3450         assign
     3451         Find-By:screen-value = 'все':U
     3452         NameOrCode = ""
     3453         .
     3454         DISABLE NameOrCode
     3455         with frame Dialog-Frame .
     3456         HIDE NameOrCode .
     3457         apply "value-changed" to Find-By in frame Dialog-Frame .
     3458     end.
     3459   end.
     3460   END.
     3461   ON RETURN OF NameOrCode IN FRAME Dialog-Frame
