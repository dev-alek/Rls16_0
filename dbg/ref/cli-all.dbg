      545   procedure clntattr-value :
      546     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      547     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
      548     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
      549     define output parameter p-value    like ub.clients-attr.attr-value no-undo .
      550     define output parameter p-type     as character no-undo .
