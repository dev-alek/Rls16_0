      513   get-full-name(X_scales-grp.node-code) COLUMN-LABEL "Название группы" FORMAT "X(255)":U  WIDTH 80
      514       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 20
      515            BGCOLOR 15 FGCOLOR 0 .
      516   DEFINE FRAME Dialog-Frame
      517        b-quit AT ROW 1 COL 1
      518        b-add AT ROW 1 COL 21
      519        b-del AT ROW 1 COL 31
      520        b-help AT ROW 1 COL 95
      521        br-scal-grp AT ROW 3.3 COL 1
      522        SPACE(0.00) SKIP(0.26)
      523       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      524            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      525            BGCOLOR 8 FGCOLOR 0
      526            TITLE " Весы по группе".
      527   ASSIGN
      528          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      529          FRAME Dialog-Frame:HIDDEN           = TRUE.
      530   ASSIGN
      531          br-scal-grp:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 3.
      532   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      533   DO:
      534     APPLY "END-ERROR":U TO SELF.
      535   END.
      536   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      537   DO:
      538   RUN proc-b-add IN THIS-PROCEDURE NO-ERROR.
      539   IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
      540   END.
      541   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      542   DO:
      543   define variable glog as logical no-undo .
      544   define variable v-doc-rec as recid no-undo .
      545   define buffer buf_scales-grp for ub.scales-grp.
      546   if not available X_scales-grp then  do:
      547     message "Весы не выбраны."
      548     view-as alert-box ERROR .
      549     return no-apply.
      550   end.
      551   glog = no.
      552   IF X_scales-grp.db-num <> g#db-num THEN DO:
      553     MESSAGE
      554     SUBSTITUTE("Нельзя удалить группу товаров для весов чужой БД &1"
      555                  , X_scales.db-num)
      556     VIEW-AS ALERT-BOX.
      557   END.
      558   message
      559   substitute("Удаление весов из списка весов,&1" +
      560              "привязанных к группе товаров.&1"  +
      561              "Товары данной группы НЕ БУДУТ&1"  +
      562              "автоматически изменяться в списке товаров&1" +
      563              "ЭТИХ весов ( с номером &2 (БД &3)&1)" +
      564              "при появлении их в наличии на каком-либо объекте.&1" +
      565              "Вы уверены ?&1"
      566              ,chr(10)
      567              ,X_scales.scales-num
      568              ,X_scales.db-num
      569              )
      570   view-as alert-box question buttons OK-Cancel update glog.
      571   if not glog then  return no-apply.
      572   glog = no.
      573   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      574   do:
      575     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      576       (input  v-cntxt-db-num
      577       ,input  v-cntxt-userid
      578       ,input  0
      579       ,input  'actn_scales-goods-groups_adding-deletion':U
      580       ,input  'global':U
      581       ,input  0
      582       ,input  '':U
      583       ,input  0
      584       ,input  0
      585       ,input  0
      586       ,input  0
      587       ,input  true
      588       ,output glog
      589       )  .
      590   end.
      591   if NOT glog then return no-apply.
      592   v-doc-rec = recid( X_scales-grp ).
      593   FIND buf_scales-grp WHERE recid( buf_scales-grp ) = v-doc-rec exclusive.
      594   delete buf_scales-grp no-error .
      595   if error-status:error then do:
      596     message
      597     substitute("Ошибки при удалении привязки группы к весам&1&2&1&3"
      598               , chr(10)
      599               , error-status:get-message(1)
      600               , return-value )
      601     view-as alert-box .
      602     return no-apply.
      603   end.
      604   RUN Openbr in this-procedure .
      605   END.
      606   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      607   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      608   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      609   on help of frame Dialog-Frame
      610   do:
      611     run gbl/app_help.p
      612       (input this-procedure :file-name
      613       ,input ''
      614       ,input ?
      615       ) no-error.
      616     if error-status :error then do:
      617       message
      618         "Ошибка при вызове помощи"
      619         error-status :get-message(1)
      620         view-as alert-box .
      621     end.
      622   end.
      623   run minbtn-set in this-procedure .
      624   on choose of b-help in frame Dialog-Frame
      625   do:
      626     apply "help":u to frame Dialog-Frame .
      627   end.
      628   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      629   procedure minbtn-set :
      630       do
      631           on error undo, return error return-value
      632           :
      633           define variable ii              as integer       no-undo .
      634           define variable fh              as widget-handle no-undo .
      635           define variable hh              as widget-handle no-undo .
      636           define variable v-h             as handle        extent 4 no-undo .
      637           define variable v-name-button   as character     no-undo .
      638           define variable v-help-old-x    as decimal       no-undo .
      639           define variable v-help-old-y    as decimal       no-undo .
      640           define variable v-help-old-size as decimal       no-undo .
      641           define variable v-frame-width   as decimal       no-undo .
      642           define variable jj              as integer       no-undo .
      643           do
      644               on error undo, return error
      645               :
      646               assign
      647                   v-frame-width = frame Dialog-Frame:width - 0.3
      648                   fh            = frame Dialog-Frame:first-child
      649                   hh            = fh:first-child
      650                   ii            = 1
      651                   .
      652               do while valid-handle(hh):
      653                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      654                   do:
      655                       case lc(hh:name) :
      656                           when "b-help" then
      657                               do:
      658                                   hh:load-image-up("cmp/b-help.bmp":u) .
      659                                   hh:load-image-down("cmp/b-help.bmp":u) .
      660                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      661                                   hh:TOOLTIP = "Помощь" .
      662                                   v-help-old-x = hh:column .
      663                                   v-help-old-y = hh:row    .
      664                                   v-help-old-size = hh:width .
      665                                   hh:width-chars = 2.5 .
      666                               end.
      667                           when "b-print" then
      668                               do:
      669                                   hh:load-image("cmp/b-print.bmp":u) .
      670                                   hh:TOOLTIP = "Печать" .
      671                                   v-h[ii] = hh:handle .
      672                                   ii = ii + 1 .
      673                                   hh:width-chars = 3 .
      674                               end.
      675                           when "b-history" or
      676                           when "b-hist" then
      677                               do:
      678                                   hh:load-image("cmp/b-hist.bmp":u) .
      679                                   hh:TOOLTIP = "История" .
      680                                   v-h[ii] = hh:handle .
      681                                   ii = ii + 1 .
      682                                   hh:width-chars = 3 .
      683                               end.
      684                           when "b-sch" then
      685                               do:
      686                                   hh:load-image("cmp/b-sch.bmp":u) .
      687                                   hh:TOOLTIP = "Установка Фильтра" .
      688                                   v-h[ii] = hh:handle .
      689                                   ii = ii + 1 .
      690                                   hh:width-chars = 3 .
      691                               end.
      692                           when "b-hist-user" then
      693                               do:
      694                                   hh:load-image("cmp/b-hist.bmp":u) .
      695                                   hh:TOOLTIP = "История пользователя" .
      696                                   ii = ii + 1 .
      697                               end.
      698                       end case.
      699                   end.
      700                   hh = hh:next-sibling.
      701               end.
      702               b-help:column = v-frame-width - b-help:width-chars.
      703               jj = 0.
      704               repeat ii = 4 to 1 by -1 :
      705                   if valid-handle (v-h[ii] ) then
      706                   do:
      707                       jj  = jj + 1 .
      708                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      709                       v-h[ii]:row    = v-help-old-y .
      710                   end.
      711               end.
      712           end.
      713       end.
      714   end procedure.
      715   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      716   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      717   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      718   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      719   define variable v-diasize-current-frame-width  as decimal   no-undo .
      720   define variable v-diasize-current-frame-height as decimal   no-undo .
      721   define variable v-diasize-change-size          as logical   no-undo .
      722   define variable v-diasize-resize-button        as handle    no-undo .
      723   define variable v-diasize-wndmax               as logical   no-undo .
      724   define variable v-diasize-wndstore             as logical   no-undo .
      725   define variable v-diasize-proc-name            as character no-undo .
      726   define variable v-diasize-browse-handle        as handle    no-undo .
      727   define variable v-diasize-browse-number        as integer   no-undo .
      728   define variable v-diasize-need-full-display    as logical   no-undo init false .
      729   define temp-table temp-diasize-handle no-undo
      730     field handle-value  as handle
      731     field save-position as decimal
      732     index xpk is primary unique handle-value
      733     .
      734   define temp-table temp-browse-handle no-undo
      735     field browse-type   as character
      736     field browse-number as integer
      737     field browse-handle as handle
      738     field original-size as decimal
      739     index xpk is primary unique browse-type browse-number
      740     index xie browse-type browse-handle
      741   .
      742   procedure diasize_change-height :
      743     define input  parameter p-change-value  as decimal   no-undo .
      744     define input  parameter p-move-resize   as logical   no-undo .
      745     define variable v-field-group-handle    as handle    no-undo .
      746     define variable v-object-handle         as handle    no-undo .
      747     define variable v-frame-height          as decimal   no-undo .
      748     define variable v-frame-virtual-height  as decimal   no-undo .
      749     define variable v-browse-height         as decimal   no-undo .
      750     define variable v-window-height         as decimal   no-undo .
      751     define variable v-window-virtual-height as decimal   no-undo .
      752     define variable v-change-sign           as integer   no-undo .
      753     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      754     define buffer buf_temp-browse-handle  for temp-browse-handle .
      755     if p-change-value > 0
      756     then do:
      757       if frame Dialog-Frame :height + p-change-value
      758           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      759       then do:
      760         assign
      761           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      762                           - (frame Dialog-Frame :height-chars)
      763         .
      764         if p-change-value <= 0
      765         then do:
      766           run diasize_position-resize-button in this-procedure .
      767           return .
      768         end.
      769       end.
      770     end.
      771     if p-change-value < 0
      772     then do:
      773       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      774       then do:
      775         assign
      776           p-change-value = v-diasize-orig-frame-height
      777                          - (frame Dialog-Frame :height-chars)
      778         .
      779         if p-change-value >= 0
      780         then do:
      781           run diasize_position-resize-button in this-procedure .
      782           return .
      783         end.
      784       end.
      785     end.
      786     if p-change-value >= 0
      787     then do:
      788       assign
      789         v-change-sign = 1
      790       .
      791     end.
      792     else do:
      793       assign
      794         v-change-sign = -1
      795       .
      796     end.
      797     assign
      798       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      799     .
      800     if p-change-value = 0
      801     then do:
      802       run diasize_position-resize-button in this-procedure .
      803       return .
      804     end.
      805     move_block:
      806     do
      807     on error undo move_block, retry move_block
      808     :
      809       if retry
      810       then do:
      811         do
      812         on error undo move_block, leave move_block
      813         :
      814           if p-change-value > 0
      815           then do:
      816             for each buf_temp-diasize-handle
      817             on error undo, next
      818             :
      819               assign
      820                 v-object-handle = buf_temp-diasize-handle.handle-value
      821               .
      822               if v-object-handle <> v-diasize-resize-button
      823               then do:
      824                 assign
      825                   v-object-handle :row = buf_temp-diasize-handle.save-position
      826                 .
      827               end.
      828             end.
      829             assign
      830               v-diasize-browse-handle :height = v-browse-height
      831             .
      832             for each buf_temp-browse-handle
      833               where buf_temp-browse-handle.browse-type = 'height':u
      834             on error undo, next
      835             :
      836               assign
      837                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      838               .
      839             end.
      840             assign
      841               frame Dialog-Frame :height = v-frame-height
      842             .
      843             if frame Dialog-Frame :scrollable = true
      844             then do:
      845               assign
      846                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      847               .
      848             end.
      849             run diasize_position-resize-button in this-procedure .
      850           end.
      851           else do:
      852             if frame Dialog-Frame :scrollable = true
      853             then do:
      854               assign
      855                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      856               .
      857             end.
      858             assign
      859               frame Dialog-Frame :height = v-frame-height
      860             .
      861             assign
      862               v-diasize-browse-handle :height = v-browse-height
      863             .
      864             for each buf_temp-browse-handle
      865               where buf_temp-browse-handle.browse-type = 'height':u
      866             on error undo, next
      867             :
      868               assign
      869                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      870               .
      871             end.
      872             for each buf_temp-diasize-handle
      873             on error undo, next
      874             :
      875               assign
      876                 v-object-handle = buf_temp-diasize-handle.handle-value
      877               .
      878               if v-object-handle <> v-diasize-resize-button
      879               then do:
      880                 assign
      881                   v-object-handle :row = buf_temp-diasize-handle.save-position
      882                 .
      883               end.
      884             end.
      885             run diasize_position-resize-button in this-procedure .
      886           end.
      887           assign
      888             v-diasize-change-size = false
      889           .
      890           leave move_block .
      891         end.
      892       end.
      893       assign
      894         v-diasize-need-full-display = true
      895       .
      896       if v-diasize-change-size = false
      897       then do:
      898         assign
      899           v-diasize-change-size = true
      900         .
      901       end.
      902       else do:
      903         return .
      904       end.
      905       assign
      906         v-frame-height = frame Dialog-Frame :height
      907         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      908         v-browse-height = v-diasize-browse-handle :height
      909       .
      910       for each buf_temp-browse-handle
      911         where buf_temp-browse-handle.browse-type = 'height':u
      912       :
      913         assign
      914           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      915         .
      916       end.
      917       for each buf_temp-diasize-handle
      918       :
      919         delete buf_temp-diasize-handle .
      920       end.
      921       assign
      922         v-field-group-handle = frame Dialog-Frame :first-child
      923       .
      924       do while valid-handle(v-field-group-handle)
      925       :
      926         assign
      927           v-object-handle = v-field-group-handle :first-child
      928         .
      929         do while valid-handle(v-object-handle)
      930         :
      931           if  v-object-handle <> v-diasize-browse-handle :handle
      932           and can-query(v-object-handle, "row")
      933           and can-query(v-object-handle, "height")
      934           and ( v-object-handle :row > v-diasize-browse-handle :row )
      935           then do:
      936             find first buf_temp-browse-handle
      937               where buf_temp-browse-handle.browse-type   = 'height':u
      938                 and buf_temp-browse-handle.browse-handle = v-object-handle
      939               no-error .
      940             if available buf_temp-browse-handle
      941             then do:
      942             end.
      943             else do:
      944               create buf_temp-diasize-handle .
      945               assign
      946                 buf_temp-diasize-handle.handle-value  = v-object-handle
      947                 buf_temp-diasize-handle.save-position = v-object-handle :row
      948               .
      949             end.
      950           end.
      951           assign
      952             v-object-handle = v-object-handle :next-sibling
      953           .
      954         end.
      955         assign
      956           v-field-group-handle = v-field-group-handle :next-sibling
      957         .
      958       end.
      959       do with frame Dialog-Frame
      960       :
      961         hide v-diasize-resize-button .
      962         assign
      963           v-diasize-resize-button :row    = 1
      964           v-diasize-resize-button :column = 1
      965         .
      966       end.
      967       if p-change-value > 0
      968       then do:
      969         if frame Dialog-Frame :scrollable = true
      970         then do:
      971           assign
      972             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      973             no-error .
      974           if error-status :error
      975           or error-status :get-message(1) <> ""
      976           then do:
      977             undo move_block, retry move_block .
      978           end.
      979         end.
      980         assign
      981           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      982           no-error .
      983         if error-status :error
      984         or error-status :get-message(1) <> ""
      985         then do:
      986           undo move_block, retry move_block .
      987         end.
      988         assign
      989           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      990           no-error .
      991         if error-status :error
      992         or error-status :get-message(1) <> ""
      993         then do:
      994           undo move_block, retry move_block .
      995         end.
      996         for each buf_temp-browse-handle
      997           where buf_temp-browse-handle.browse-type = 'height':u
      998         on error undo move_block, retry move_block
      999         :
     1000           assign
     1001             buf_temp-browse-handle.browse-handle :height
     1002               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1003             no-error .
     1004           if error-status :error
     1005           or error-status :get-message(1) <> ""
     1006           then do:
     1007             undo move_block, retry move_block .
     1008           end.
     1009         end.
     1010         for each buf_temp-diasize-handle
     1011         on error undo move_block, retry move_block
     1012         :
     1013           assign
     1014             v-object-handle = buf_temp-diasize-handle.handle-value
     1015           .
     1016           if v-object-handle <> v-diasize-resize-button
     1017           then do:
     1018             assign
     1019               v-object-handle :row = v-object-handle :row + p-change-value
     1020               no-error .
     1021             if error-status :error
     1022             or error-status :get-message(1) <> ""
     1023             then do:
     1024               undo move_block, retry move_block .
     1025             end.
     1026           end.
     1027         end.
     1028       end.
     1029       else do:
     1030         for each buf_temp-diasize-handle
     1031         on error undo move_block, retry move_block
     1032         :
     1033           assign
     1034             v-object-handle = buf_temp-diasize-handle.handle-value
     1035           .
     1036           if v-object-handle <> v-diasize-resize-button
     1037           then do:
     1038             assign
     1039               v-object-handle :row = v-object-handle :row + p-change-value
     1040               no-error .
     1041             if error-status :error
     1042             or error-status :get-message(1) <> ""
     1043             then do:
     1044               undo move_block, retry move_block .
     1045             end.
     1046           end.
     1047         end.
     1048         assign
     1049           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1050           no-error .
     1051         if error-status :error
     1052         or error-status :get-message(1) <> ""
     1053         then do:
     1054           undo move_block, retry move_block .
     1055         end.
     1056         for each buf_temp-browse-handle
     1057           where buf_temp-browse-handle.browse-type = 'height':u
     1058         on error undo move_block, retry move_block
     1059         :
     1060           assign
     1061             buf_temp-browse-handle.browse-handle :height
     1062               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1063             no-error .
     1064           if error-status :error
     1065           or error-status :get-message(1) <> ""
     1066           then do:
     1067             undo move_block, retry move_block .
     1068           end.
     1069         end.
     1070         assign
     1071           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1072           no-error .
     1073         if error-status :error
     1074         or error-status :get-message(1) <> ""
     1075         then do:
     1076           undo move_block, retry move_block .
     1077         end.
     1078         if frame Dialog-Frame :scrollable = true
     1079         then do:
     1080           assign
     1081             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1082             no-error .
     1083           if error-status :error
     1084           or error-status :get-message(1) <> ""
     1085           then do:
     1086             undo move_block, retry move_block .
     1087           end.
     1088         end.
     1089       end.
     1090       if p-move-resize = true
     1091       then do:
     1092         run diasize_position-resize-button in this-procedure .
     1093       end.
     1094       if v-diasize-wndstore = true
     1095       then do:
     1096         if connected("ub") = true
     1097         then do:
     1098           define variable v-cntxt-db-num        as integer   no-undo .
     1099           define variable v-cntxt-userid        as character no-undo .
     1100           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1101                                             , OUTPUT v-cntxt-userid
     1102                                             ) .
     1103           run gbl/wndsizew.p
     1104             (input  v-cntxt-db-num
     1105             ,input  v-cntxt-userid
     1106             ,input  v-diasize-proc-name
     1107             ,input  'height':u
     1108             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1109             ) .
     1110         end.
     1111       end.
     1112     end.
     1113     assign
     1114       v-diasize-change-size = false
     1115     .
     1116   end procedure.
     1117   procedure diasize_set-height :
     1118     define input  parameter p-new-height  as decimal   no-undo .
     1119     define input  parameter p-move-resize as logical   no-undo .
     1120     do
     1121     on error undo, return error return-value
     1122     :
     1123       run diasize_change-height in this-procedure
     1124         (input  (p-new-height - frame Dialog-Frame :height)
     1125         ,input  p-move-resize
     1126         ) .
     1127     end.
     1128   end procedure.
     1129   procedure diasize_change-width :
     1130     define input  parameter p-change-value as decimal   no-undo .
     1131     define input  parameter p-move-resize  as logical   no-undo .
     1132     define variable v-field-group-handle   as handle    no-undo .
     1133     define variable v-object-handle        as handle    no-undo .
     1134     define variable v-frame-width          as decimal   no-undo .
     1135     define variable v-frame-virtual-width  as decimal   no-undo .
     1136     define variable v-browse-width         as decimal   no-undo .
     1137     define variable v-window-width         as decimal   no-undo .
     1138     define variable v-window-virtual-width as decimal   no-undo .
     1139     define variable v-change-sign          as integer   no-undo .
     1140     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1141     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1142     if p-change-value > 0
     1143     then do:
     1144       if frame Dialog-Frame :width + p-change-value >
     1145           session :width-chars
     1146       then do:
     1147         assign
     1148           p-change-value = session :width-chars - frame Dialog-Frame :width
     1149         .
     1150         if p-change-value <= 0
     1151         then do:
     1152           run diasize_position-resize-button in this-procedure .
     1153           return .
     1154         end.
     1155       end.
     1156     end.
     1157     if p-change-value < 0
     1158     then do:
     1159       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1160       then do:
     1161         assign
     1162           p-change-value = v-diasize-orig-frame-width
     1163                          - frame Dialog-Frame :width
     1164         .
     1165         if p-change-value >= 0
     1166         then do:
     1167           run diasize_position-resize-button in this-procedure .
     1168           return .
     1169         end.
     1170       end.
     1171     end.
     1172     if p-change-value >= 0
     1173     then do:
     1174       assign
     1175         v-change-sign = 1
     1176       .
     1177     end.
     1178     else do:
     1179       assign
     1180         v-change-sign = -1
     1181       .
     1182     end.
     1183     assign
     1184       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1185     .
     1186     if p-change-value = 0
     1187     then do:
     1188       run diasize_position-resize-button in this-procedure .
     1189       return .
     1190     end.
     1191     move_block:
     1192     do
     1193     on error undo move_block, leave move_block
     1194     :
     1195       if retry
     1196       then do:
     1197         do
     1198         on error undo move_block, leave move_block
     1199         :
     1200           if p-change-value > 0
     1201           then do:
     1202             for each buf_temp-diasize-handle
     1203             on error undo, next
     1204             :
     1205               assign
     1206                 v-object-handle = buf_temp-diasize-handle.handle-value
     1207               .
     1208               if v-object-handle <> v-diasize-resize-button
     1209               then do:
     1210                 assign
     1211                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1212                 .
     1213               end.
     1214             end.
     1215             assign
     1216               v-diasize-browse-handle :width = v-browse-width
     1217             .
     1218             for each buf_temp-browse-handle
     1219               where buf_temp-browse-handle.browse-type = 'width':u
     1220             on error undo, next
     1221             :
     1222               assign
     1223                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1224               .
     1225             end.
     1226             assign
     1227               frame Dialog-Frame :width = v-frame-width
     1228             .
     1229             if frame Dialog-Frame :scrollable = true
     1230             then do:
     1231               assign
     1232                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1233               .
     1234             end.
     1235             run diasize_position-resize-button in this-procedure .
     1236           end.
     1237           else do:
     1238             if frame Dialog-Frame :scrollable = true
     1239             then do:
     1240               assign
     1241                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1242               .
     1243             end.
     1244             assign
     1245               frame Dialog-Frame :width = v-frame-width
     1246             .
     1247             for each buf_temp-browse-handle
     1248               where buf_temp-browse-handle.browse-type = 'width':u
     1249             on error undo, next
     1250             :
     1251               assign
     1252                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1253               .
     1254             end.
     1255             assign
     1256               v-diasize-browse-handle :width = v-browse-width
     1257             .
     1258             for each buf_temp-diasize-handle
     1259             on error undo, next
     1260             :
     1261               assign
     1262                 v-object-handle = buf_temp-diasize-handle.handle-value
     1263               .
     1264               if v-object-handle <> v-diasize-resize-button
     1265               then do:
     1266                 assign
     1267                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1268                 .
     1269               end.
     1270             end.
     1271             run diasize_position-resize-button in this-procedure .
     1272           end.
     1273           assign
     1274             v-diasize-change-size = false
     1275           .
     1276           leave move_block .
     1277         end.
     1278       end.
     1279       assign
     1280         v-diasize-need-full-display = true
     1281       .
     1282       if v-diasize-change-size = false
     1283       then do:
     1284         assign
     1285           v-diasize-change-size = true
     1286         .
     1287       end.
     1288       else do:
     1289         return .
     1290       end.
     1291       assign
     1292         v-frame-width = frame Dialog-Frame :width
     1293         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1294         v-browse-width = v-diasize-browse-handle :width
     1295       .
     1296       for each buf_temp-browse-handle
     1297         where buf_temp-browse-handle.browse-type = 'width':u
     1298       :
     1299         assign
     1300           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1301         .
     1302       end.
     1303       for each buf_temp-diasize-handle
     1304       :
     1305         delete buf_temp-diasize-handle .
     1306       end.
     1307       assign
     1308         v-field-group-handle = frame Dialog-Frame :first-child
     1309       .
     1310       do while valid-handle(v-field-group-handle)
     1311       :
     1312         assign
     1313           v-object-handle = v-field-group-handle :first-child
     1314         .
     1315         do while valid-handle(v-object-handle)
     1316         :
     1317           if  v-object-handle <> v-diasize-browse-handle :handle
     1318           and v-object-handle <> v-diasize-resize-button
     1319           and can-query(v-object-handle, "row")
     1320           and can-query(v-object-handle, "height")
     1321           and ( v-object-handle :col + v-object-handle :width
     1322                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1323               )
     1324           then do:
     1325             find first buf_temp-browse-handle
     1326               where buf_temp-browse-handle.browse-type   = 'width':u
     1327                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1328               no-error .
     1329             if available buf_temp-browse-handle
     1330             then do:
     1331             end.
     1332             else do:
     1333               create buf_temp-diasize-handle .
     1334               assign
     1335                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1336                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1337               .
     1338             end.
     1339           end.
     1340           assign
     1341             v-object-handle = v-object-handle :next-sibling
     1342           .
     1343         end.
     1344         assign
     1345           v-field-group-handle = v-field-group-handle :next-sibling
     1346         .
     1347       end.
     1348       do with frame Dialog-Frame
     1349       :
     1350         hide v-diasize-resize-button .
     1351         v-diasize-resize-button :row = 1.
     1352         v-diasize-resize-button :column = 1.
     1353       end.
     1354       if p-change-value > 0
     1355       then do:
     1356         if frame Dialog-Frame :scrollable = true
     1357         then do:
     1358           assign
     1359             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1360             no-error .
     1361           if error-status :error
     1362           or error-status :get-message(1) <> ""
     1363           then do:
     1364             undo move_block, retry move_block.
     1365           end.
     1366         end.
     1367         assign
     1368           frame Dialog-Frame :width = v-frame-width + p-change-value
     1369           no-error .
     1370         if error-status :error
     1371         or error-status :get-message(1) <> ""
     1372         then do:
     1373           undo move_block, retry move_block.
     1374         end.
     1375         assign
     1376           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1377         no-error .
     1378         if error-status :error
     1379         or error-status :get-message(1) <> ""
     1380         then do:
     1381           undo move_block, retry move_block.
     1382         end.
     1383         for each buf_temp-browse-handle
     1384           where buf_temp-browse-handle.browse-type = 'width':u
     1385         on error undo move_block, retry move_block
     1386         :
     1387           assign
     1388             buf_temp-browse-handle.browse-handle :width
     1389               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1390             no-error .
     1391           if error-status :error
     1392           or error-status :get-message(1) <> ""
     1393           then do:
     1394             undo move_block, retry move_block .
     1395           end.
     1396         end.
     1397         for each buf_temp-diasize-handle
     1398         on error undo move_block, retry move_block
     1399         :
     1400           assign
     1401             v-object-handle = buf_temp-diasize-handle.handle-value
     1402           .
     1403           if v-object-handle <> v-diasize-resize-button
     1404           then do:
     1405             assign
     1406               v-object-handle :col = v-object-handle :col + p-change-value
     1407               no-error .
     1408             if error-status :error
     1409             or error-status :get-message(1) <> ""
     1410             then do:
     1411               undo move_block, retry move_block .
     1412             end.
     1413           end.
     1414         end.
     1415       end.
     1416       else do:
     1417         for each buf_temp-diasize-handle
     1418         on error undo move_block, retry move_block
     1419         :
     1420           assign
     1421             v-object-handle = buf_temp-diasize-handle.handle-value
     1422           .
     1423           if v-object-handle <> v-diasize-resize-button
     1424           then do:
     1425             assign
     1426               v-object-handle :col = v-object-handle :col + p-change-value
     1427               no-error .
     1428             if error-status :error
     1429             or error-status :get-message(1) <> ""
     1430             then do:
     1431               undo move_block, retry move_block .
     1432             end.
     1433           end.
     1434         end.
     1435         for each buf_temp-browse-handle
     1436           where buf_temp-browse-handle.browse-type = 'width':u
     1437         on error undo move_block, retry move_block
     1438         :
     1439           assign
     1440             buf_temp-browse-handle.browse-handle :width
     1441               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1442             no-error .
     1443           if error-status :error
     1444           or error-status :get-message(1) <> ""
     1445           then do:
     1446             undo move_block, retry move_block .
     1447           end.
     1448         end.
     1449         assign
     1450           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1451           no-error .
     1452         if error-status :error
     1453         or error-status :get-message(1) <> ""
     1454         then do:
     1455           undo move_block, retry move_block.
     1456         end.
     1457         assign
     1458           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1459         no-error .
     1460         if error-status :error
     1461         or error-status :get-message(1) <> ""
     1462         then do:
     1463           undo move_block, retry move_block.
     1464         end.
     1465         if frame Dialog-Frame :scrollable = true
     1466         then do:
     1467           assign
     1468             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1469           no-error .
     1470           if error-status :error
     1471           or error-status :get-message(1) <> ""
     1472           then do:
     1473             undo move_block, retry move_block.
     1474           end.
     1475         end.
     1476       end.
     1477       if p-move-resize
     1478       then do:
     1479         run diasize_position-resize-button in this-procedure .
     1480       end.
     1481       if v-diasize-wndstore = true
     1482       then do:
     1483         if connected("ub") = true
     1484         then do:
     1485           define variable v-cntxt-db-num        as integer   no-undo .
     1486           define variable v-cntxt-userid        as character no-undo .
     1487           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1488                                             , OUTPUT v-cntxt-userid
     1489                                             ) .
     1490           run gbl/wndsizew.p
     1491             (input  v-cntxt-db-num
     1492             ,input  v-cntxt-userid
     1493             ,input  v-diasize-proc-name
     1494             ,input  'width':u
     1495             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1496             ) .
     1497         end.
     1498       end.
     1499     end.
     1500     assign
     1501       v-diasize-change-size = false
     1502     .
     1503   end procedure.
     1504   procedure diasize_set-width :
     1505     define input  parameter p-new-width  as decimal   no-undo .
     1506     define input  parameter p-move-resize as logical   no-undo .
     1507     do
     1508     on error undo, return error return-value
     1509     :
     1510       run diasize_change-width in this-procedure
     1511         (input  (p-new-width - frame Dialog-Frame :width)
     1512         ,input  p-move-resize
     1513         ) .
     1514     end.
     1515   end procedure.
     1516   procedure diasize_position-resize-button :
     1517     do with frame Dialog-Frame
     1518     :
     1519       hide v-diasize-resize-button .
     1520       assign
     1521         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1522                     - 1
     1523                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1524         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1525                     - 1
     1526                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1527       .
     1528       view v-diasize-resize-button .
     1529     end.
     1530   end procedure.
     1531   on alt-right anywhere
     1532   do:
     1533     run diasize_change-width in this-procedure
     1534       (input 1
     1535       ,input true
     1536       ) .
     1537     return no-apply .
     1538   end.
     1539   on alt-left anywhere
     1540   do:
     1541     run diasize_change-width in this-procedure
     1542       (input -1
     1543       ,input true
     1544       ) .
     1545     return no-apply .
     1546   end.
     1547   on alt-down anywhere
     1548   do:
     1549     run diasize_change-height in this-procedure
     1550       (input 1
     1551       ,input true
     1552       ) .
     1553     return no-apply .
     1554   end.
     1555   on alt-up anywhere
     1556   do:
     1557     run diasize_change-height in this-procedure
     1558       (input -1
     1559       ,input true
     1560       ) .
     1561     return no-apply .
     1562   end.
     1563   on alt-enter of frame Dialog-Frame
     1564   do:
     1565     run diasize_maximize in this-procedure
     1566       (input  ?
     1567       ).
     1568     return no-apply .
     1569   end.
     1570   procedure diasize_end-move :
     1571     do
     1572     on error undo, return error return-value
     1573     :
     1574       define variable v-row-delta as decimal   no-undo .
     1575       define variable v-col-delta as decimal   no-undo .
     1576       define variable v-new-row as decimal   no-undo .
     1577       define variable v-new-col as decimal   no-undo .
     1578       assign
     1579         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1580         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1581       .
     1582       assign
     1583         v-row-delta = v-new-row - frame Dialog-Frame :height
     1584         v-col-delta = v-new-col - frame Dialog-Frame :width
     1585       .
     1586       run diasize_change-height in this-procedure
     1587         (input v-row-delta
     1588         ,input true
     1589         ) .
     1590       run diasize_change-width in this-procedure
     1591         (input v-col-delta
     1592         ,input true
     1593         ) .
     1594     end.
     1595   end procedure.
     1596   procedure diasize_maximize :
     1597     define input  parameter p-action as logical   no-undo .
     1598     do
     1599     on error undo, return error return-value
     1600     :
     1601       if p-action = ?
     1602       then do:
     1603         if v-diasize-need-maximize = true
     1604         then do:
     1605           assign
     1606             p-action = true
     1607           .
     1608         end.
     1609         else do:
     1610           assign
     1611             p-action = false
     1612           .
     1613         end.
     1614       end.
     1615       if p-action = true
     1616       then do:
     1617         run diasize_change-height in this-procedure
     1618           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1619               - frame Dialog-Frame :height-chars
     1620           ,input true
     1621           ) .
     1622         run diasize_change-width in this-procedure
     1623           (input session :width-chars
     1624               - frame Dialog-Frame :width-chars
     1625           ,input true
     1626           ) .
     1627         assign
     1628           v-diasize-need-maximize = false
     1629         .
     1630       end.
     1631       else do:
     1632         run diasize_change-width in this-procedure
     1633           (input v-diasize-orig-frame-width
     1634               - frame Dialog-Frame :width-chars
     1635           ,input true
     1636           ) .
     1637         run diasize_change-height in this-procedure
     1638           (input v-diasize-orig-frame-height
     1639               - frame Dialog-Frame :height-chars
     1640           ,input true
     1641           ) .
     1642         assign
     1643           v-diasize-need-maximize = true
     1644         .
     1645       end.
     1646     end.
     1647   end procedure.
     1648   procedure diasize_restore-orig-size :
     1649     do
     1650     on error undo, return error return-value
     1651     :
     1652       assign
     1653         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1654         v-diasize-current-frame-height = frame Dialog-Frame :height
     1655       .
     1656       run diasize_set-height in this-procedure
     1657         (input  v-diasize-orig-frame-height
     1658         ,input  true
     1659         ) .
     1660       run diasize_set-width in this-procedure
     1661         (input  v-diasize-orig-frame-width
     1662         ,input  true
     1663         ) .
     1664     end.
     1665   end procedure.
     1666   procedure diasize_restore-current-size :
     1667     do
     1668     on error undo, return error return-value
     1669     :
     1670       run diasize_set-height in this-procedure
     1671         (input  v-diasize-current-frame-height
     1672         ,input  true
     1673         ) .
     1674       run diasize_set-width in this-procedure
     1675         (input  v-diasize-current-frame-width
     1676         ,input  true
     1677         ) .
     1678     end.
     1679   end procedure.
     1680   procedure diasize_set-browse-handle :
     1681     define input  parameter p-browse-handle as handle   no-undo .
     1682     define buffer buf_temp-browse-handle for temp-browse-handle .
     1683     do
     1684     on error undo, return error return-value
     1685     :
     1686       assign
     1687         v-diasize-browse-handle = p-browse-handle
     1688       .
     1689       for each buf_temp-browse-handle
     1690       on error undo, return error return-value
     1691       :
     1692         delete buf_temp-browse-handle .
     1693       end.
     1694     end.
     1695   end procedure.
     1696   procedure diasize_add_browse :
     1697     define input  parameter p-browse-type   as character no-undo .
     1698     define input  parameter p-browse-handle as handle    no-undo .
     1699     define buffer buf_temp-browse-handle for temp-browse-handle .
     1700     do
     1701     on error undo, return error return-value
     1702     :
     1703       assign
     1704         v-diasize-browse-number = v-diasize-browse-number + 1
     1705       .
     1706       create buf_temp-browse-handle .
     1707       assign
     1708         buf_temp-browse-handle.browse-type   = p-browse-type
     1709         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1710         buf_temp-browse-handle.browse-handle = p-browse-handle
     1711       .
     1712     end.
     1713   end procedure.
     1714   procedure diasize_init :
     1715     define variable v-default-value    as logical   no-undo .
     1716     define variable v-restore-saved    as logical   no-undo .
     1717     define variable v-resize-value-str as character no-undo .
     1718     do
     1719     on error undo, return error return-value
     1720     :
     1721       do with frame Dialog-Frame
     1722       :
     1723         assign
     1724           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1725           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1726           v-diasize-browse-handle     = browse br-scal-grp :handle
     1727         .
     1728         create button v-diasize-resize-button
     1729         assign
     1730           parent        = frame Dialog-Frame :first-child
     1731           label         = "s"
     1732           height-pixels = 16
     1733           width-pixels  = 16
     1734           visible       = true
     1735           sensitive     = true
     1736           movable       = true
     1737           triggers:
     1738             on end-move persistent run diasize_end-move in this-procedure .
     1739           end triggers.
     1740         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1741         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1742         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1743         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1744         assign
     1745           v-diasize-wndmax = false
     1746         .
     1747         if connected("ub") = true
     1748         then do:
     1749           define variable v-cntxt-db-num        as integer   no-undo .
     1750           define variable v-cntxt-userid        as character no-undo .
     1751           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1752                                             , OUTPUT v-cntxt-userid
     1753                                             ) .
     1754           run gbl/wndpar_r.p
     1755             (input  v-cntxt-db-num
     1756             ,input  v-cntxt-userid
     1757             ,input  'wndmax':U
     1758             ,output v-diasize-wndmax
     1759             ,output v-default-value
     1760             ) .
     1761         end.
     1762         assign
     1763           v-diasize-wndstore = false
     1764         .
     1765         if connected("ub") = true
     1766         then do:
     1767           run gbl/wndpar_r.p
     1768             (input  v-cntxt-db-num
     1769             ,input  v-cntxt-userid
     1770             ,input  'wndstore':U
     1771             ,output v-diasize-wndstore
     1772             ,output v-default-value
     1773             ) .
     1774         end.
     1775         assign
     1776           v-diasize-proc-name = entry(1, program-name(2), '.')
     1777         .
     1778         if v-diasize-wndstore = true
     1779         then do:
     1780           assign
     1781             v-restore-saved = false
     1782           .
     1783           if connected("ub") = true
     1784           then do:
     1785             run gbl/wndsizer.p
     1786               (input  v-cntxt-db-num
     1787               ,input  v-cntxt-userid
     1788               ,input  v-diasize-proc-name
     1789               ,input  'height':u
     1790               ,output v-resize-value-str
     1791               ) .
     1792             if v-resize-value-str <> '':U
     1793             then do:
     1794               run diasize_change-height in this-procedure
     1795                 (input  integer(v-resize-value-str)
     1796                 ,input  true
     1797                 ) .
     1798               assign
     1799                 v-restore-saved = true
     1800               .
     1801             end.
     1802           end.
     1803           if connected("ub") = true
     1804           then do:
     1805             run gbl/wndsizer.p
     1806               (input  v-cntxt-db-num
     1807               ,input  v-cntxt-userid
     1808               ,input  v-diasize-proc-name
     1809               ,input  'width':u
     1810               ,output v-resize-value-str
     1811               ) .
     1812             if v-resize-value-str <> '':U
     1813             then do:
     1814               run diasize_change-width in this-procedure
     1815                 (input  integer(v-resize-value-str)
     1816                 ,input  true
     1817                 ) .
     1818               assign
     1819                 v-restore-saved = true
     1820               .
     1821             end.
     1822           end.
     1823           if v-restore-saved <> true
     1824           then do:
     1825             if v-diasize-wndmax = true
     1826             then do:
     1827               run diasize_maximize in this-procedure
     1828                 (input  true
     1829                 ) .
     1830             end.
     1831           end.
     1832         end.
     1833         else do:
     1834           if v-diasize-wndmax = true
     1835           then do:
     1836             run diasize_maximize in this-procedure
     1837               (input  true
     1838               ) .
     1839           end.
     1840         end.
     1841       end.
     1842     end.
     1843   end procedure.
     1844   procedure diasize_need-full-display :
     1845     define output parameter p-need-full-display as logical   no-undo .
     1846     do
     1847     on error undo, return error return-value
     1848     :
     1849       assign
     1850         p-need-full-display = v-diasize-need-full-display
     1851       .
     1852       assign
     1853         v-diasize-need-full-display = false
     1854       .
     1855     end.
     1856   end procedure.
     1857   procedure get-context :
     1858      define output parameter p-db-num as integer          no-undo.
     1859      define output parameter p-user-id as character        no-undo.
     1860      define variable v-login               as character    no-undo.
     1861      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1862      define buffer buf_user-login  for ub.user-login .
     1863      do
     1864      on error undo, return error
     1865      :
     1866            FIND FIRST buf_sys-ctrl no-lock.
     1867            ASSIGN
     1868               v-login = USERID("ub")
     1869               p-db-num = buf_sys-ctrl.db-num
     1870            .
     1871            FIND FIRST buf_user-login
     1872                 WHERE buf_user-login.db-num = p-db-num
     1873                   AND buf_user-login.user-login = v-login
     1874                 no-lock
     1875                 no-error
     1876                 .
     1877            IF AVAILABLE buf_user-login
     1878            THEN DO:
     1879               assign
     1880                  p-user-id = buf_user-login.user-id
     1881               .
     1882            END.
     1883      end.
     1884   end procedure.
     1885       run diasize_init in this-procedure .
     1886   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1887   do:
     1888     br-scal-grp :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     1889   end.
     1890   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1891   on f5 of frame Dialog-Frame anywhere
     1892   do:
     1893     v-doc-rec = recid(X_scales-grp). run Openbr in this-procedure. reposition br-scal-grp to recid v-doc-rec NO-ERROR. v-doc-rec = ?.
     1894       apply "VALUE-CHANGED" to br-scal-grp.
     1895   end.
     1896   MAIN-BLOCK:
     1897   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1898      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1899   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1900     run mainmenu_getcntxt in parparentproc
     1901       (output v-cntxt-db-num
     1902       ,output v-cntxt-userid
     1903       ,output v-cntxt-level
     1904       ,output v-cntxt-host-code-obj
     1905       ,output v-cntxt-obj-type
     1906       ,output v-cntxt-obj-code
     1907       ,output v-cntxt-db-num-obj
     1908       ,output v-cntxt-is-admin
     1909       ) .
     1910       CASE p-mode:
     1911         WHEN 'gds-grp':U
     1912         OR
     1913         WHEN ('db':U + chr(44) + 'gds-grp':U) THEN DO:
     1914           RUN grplib-get-full-name in this-procedure( input n-code, output full-grpname ) .
     1915         END.
     1916         WHEN 'scales':U THEN DO:
     1917            FIND FIRST locked_scales EXCLUSIVE-LOCK WHERE
     1918                       locked_scales.db-num = p-db-num
     1919                   AND locked_scales.scales-num = p-scales-num.
     1920            IF NOT AVAILABLE locked_scales THEN DO:
     1921              MESSAGE
     1922              vss-workfile vss-revision vss-description skip
     1923              substitute("Неверное значение параметра p-db-num=&1 или p-scales-num=&2"
     1924                         , p-db-num
     1925                         , p-scales-num)
     1926              view-as alert-box error .
     1927              undo, return error .
     1928           END.
     1929           if locked_scales.master > 0 then do:
     1930              MESSAGE
     1931              vss-workfile vss-revision vss-description skip
     1932              substitute("Нельзя привязывать группы к подчиненным весам!"
     1933                         , p-db-num
     1934                         , p-scales-num)
     1935              view-as alert-box error .
     1936              undo, return error .
     1937           end.
     1938         END.
     1939       END CASE.
     1940       RUN MYenable in this-procedure .
     1941       RUN Openbr IN THIS-PROCEDURE.
     1942       WAIT-FOR GO OF FRAME Dialog-Frame.
     1943   END.
     1944   RUN disable_UI.
     1945   PROCEDURE disable_UI :
     1946     HIDE FRAME Dialog-Frame.
     1947   END PROCEDURE.
     1948   PROCEDURE enable_UI :
     1949     ENABLE b-quit b-add b-del b-help br-scal-grp
     1950         WITH FRAME Dialog-Frame.
     1951     VIEW FRAME Dialog-Frame.
     1952     OPEN QUERY br-scal-grp FOR EACH X_scales-grp       WHERE X_scales-grp.node-code = n-code NO-LOCK,              EACH X_gds-grp WHERE X_gds-grp.node-code = X_scales-grp.node-code NO-LOCK,              EACH X_scales WHERE X_scales.scales-num = X_scales-grp.scales-num            AND X_scales.db-num = X_scales-grp.db-num     NO-LOCK     BY X_scales-grp.scales-num.
     1953   END PROCEDURE.
     1954   PROCEDURE MyEnable :
     1955   define variable v-h as handle no-undo .
     1956   v-h = br-scal-grp:FIRST-COLUMN IN FRAME Dialog-Frame.
     1957       DO while valid-handle(v-h) :
     1958         if v-h:LABEL = "Название группы" then do:
     1959           v-h:resizable = yes.
     1960           leave.
     1961         end.
     1962         ELSE DO:
     1963           v-h = v-h:NEXT-COLUMN.
     1964         END.
     1965       END.
     1966   ENABLE
     1967   b-quit
     1968   b-add WHEN (LOOKUP('b-add', bttns) > 0
     1969          AND (p-mode = 'db':U + chr(44) + 'gds-grp':U
     1970               or
     1971               p-mode = 'scales':U)
     1972          AND p-db-num = v-cntxt-db-num)
     1973   b-del WHEN (LOOKUP('b-add', bttns) > 0
     1974          AND (p-mode = 'db':U + chr(44) + 'gds-grp':U
     1975               or
     1976               p-mode = 'scales':U)
     1977          AND p-db-num = v-cntxt-db-num)
     1978   b-help
     1979   br-scal-grp
     1980   WITH FRAME Dialog-Frame.
     1981   VIEW FRAME Dialog-Frame.
     1982   CASE p-mode:
     1983     WHEN ('db':U + chr(44) + 'gds-grp':U)
     1984     or
     1985     when 'gds-grp':U
     1986     tHEN DO:
     1987       ASSIGN
     1988       X_scales-grp.node-code:VISIBLE IN BROWSE br-scal-grp = NO
     1989       .
     1990       DO while valid-handle(v-h) :
     1991         if v-h:LABEL = "Название группы" then do:
     1992           v-h:visible = no.
     1993           leave.
     1994         end.
     1995         ELSE DO:
     1996           v-h = v-h:NEXT-COLUMN.
     1997         END.
     1998       END.
     1999     END.
     2000     WHEN 'scales':U THEN DO:
     2001       ASSIGN
     2002       X_scales-grp.db-num:VISIBLE IN BROWSE br-scal-grp = NO
     2003       X_scales-grp.scales-num:VISIBLE IN BROWSE br-scal-grp = NO
     2004       X_scales.scales-name:VISIBLE IN BROWSE br-scal-grp = NO
     2005       X_scales.unit-base:VISIBLE IN BROWSE br-scal-grp = NO
     2006       X_scales.tot-gds:VISIBLE IN BROWSE br-scal-grp = NO
     2007       .
     2008     END.
     2009   END CASE.
     2010   END PROCEDURE.
     2011   PROCEDURE Openbr :
     2012   CASE p-mode:
     2013     WHEN ('db':U + chr(44) + 'gds-grp':U) THEN DO:
     2014       frame Dialog-Frame:title = substitute("Привязка группы товаров &1 к весам для БД &2"
     2015                                             , full-grpname
     2016                                             , p-db-num).
     2017       OPEN QUERY br-scal-grp FOR EACH X_scales-grp
     2018           WHERE X_scales-grp.db-num = p-db-num
     2019               AND X_scales-grp.node-code = n-code NO-LOCK,
     2020           EACH X_gds-grp WHERE X_gds-grp.node-code = X_scales-grp.node-code NO-LOCK, ~
     2021           EACH X_scales WHERE
     2022                 X_scales.db-num = X_scales-grp.db-num AND
     2023                 X_scales.scales-num = X_scales-grp.scales-num NO-LOCK
     2024         BY X_scales-grp.scales-num.
     2025     END.
     2026     WHEN 'db':U THEN DO:
     2027       frame Dialog-Frame:title = substitute("Привязка групп товаров к весам для БД &1", p-db-num).
     2028       OPEN QUERY br-scal-grp FOR EACH X_scales-grp
     2029           WHERE X_scales-grp.db-num = p-db-num NO-LOCK,
     2030           EACH X_gds-grp WHERE X_gds-grp.node-code = X_scales-grp.node-code NO-LOCK, ~
     2031           EACH X_scales WHERE
     2032                 X_scales.db-num = X_scales-grp.db-num AND
     2033                 X_scales.scales-num = X_scales-grp.scales-num NO-LOCK
     2034         BY X_scales-grp.scales-num.
     2035     END.
     2036     WHEN 'все':U  THEN DO:
     2037       frame Dialog-Frame:title = substitute("Привязка групп товаров к весам").
     2038       OPEN QUERY br-scal-grp FOR EACH X_scales-grp NO-LOCK,
     2039           EACH X_gds-grp WHERE
     2040               X_gds-grp.node-code = X_scales-grp.node-code NO-LOCK,
     2041           EACH X_scales WHERE
     2042                 X_scales.scales-num = X_scales-grp.scales-num NO-LOCK
     2043         BY X_scales-grp.db-num
     2044         BY X_scales-grp.scales-num
     2045           .
     2046     END.
     2047     WHEN 'gds-grp':U  THEN DO:
     2048       frame Dialog-Frame:title = substitute("Привязка группы товаров &1 к весам", full-grpname).
     2049       OPEN QUERY br-scal-grp FOR EACH X_scales-grp
     2050           WHERE X_scales-grp.db-num >= 0
     2051             AND X_scales-grp.node-code = n-code NO-LOCK,
     2052           EACH X_gds-grp WHERE X_gds-grp.node-code = X_scales-grp.node-code NO-LOCK, ~
     2053           EACH X_scales WHERE
     2054                 X_scales.scales-num = X_scales-grp.scales-num NO-LOCK
     2055         BY X_scales-grp.db-num
     2056         BY X_scales-grp.scales-num
     2057         .
     2058     END.
     2059     WHEN 'scales':U  THEN DO:
     2060       frame Dialog-Frame:title = substitute("Привязка групп товаров к весам: БД &1 весы № &2", p-db-num, p-scales-num).
     2061         OPEN QUERY br-scal-grp FOR EACH X_scales-grp
     2062             WHERE X_scales-grp.db-num >= p-db-num
     2063               AND X_scales-grp.scales-num = p-scales-num
     2064               NO-LOCK,
     2065             EACH X_gds-grp WHERE X_gds-grp.node-code = X_scales-grp.node-code NO-LOCK, ~
     2066             EACH X_scales WHERE
     2067                   X_scales.scales-num = X_scales-grp.scales-num NO-LOCK
     2068           BY X_scales-grp.db-num
     2069           BY X_scales-grp.scales-num
     2070           .
     2071     END.
     2072   END CASE.
     2073   END PROCEDURE.
     2074   PROCEDURE proc-b-add :
     2075   define variable glog as logical no-undo .
     2076   define buffer buf_scales for ub.scales.
     2077   define buffer buf_gds-grp for ub.gds-grp.
     2078   define buffer buf2_gds-grp for ub.gds-grp.
     2079   define buffer buf_scales-grp for ub.scales-grp.
     2080   assign
     2081   jj = br-scal-grp:FOCUSED-ROW IN FRAME Dialog-Frame
     2082   rec-list = "" .
     2083   CASE p-mode:
     2084     WHEN ('db':U + chr(44) + 'gds-grp':U) THEN DO:
     2085       run ref/scales.w ( input parparentproc
     2086                       ,input p-obj-type
     2087                       ,input p-obj-code
     2088                       ,input "b-sel,b-mark"
     2089                       ,input 'db':U
     2090                       ,output rec-list ) no-error .
     2091       if ( NOT error-status:error )
     2092       AND ( rec-list <> "" ) then do:
     2093         run waitfram-show in this-procedure ( input "Ждите..." ).
     2094         _II:
     2095         DO ii = 1 TO num-entries( rec-list ) TRANSACTION
     2096                 ON ERROR UNDO, return NO-APPLY
     2097                 ON END-KEY UNDO, return NO-APPLY
     2098                 ON STOP UNDO, return NO-APPLY :
     2099           FIND buf_scales WHERE recid ( buf_scales ) = integer( entry( ii, rec-list ) ) .
     2100           if buf_scales.master > 0 then do:
     2101               message
     2102               substitute("Нельзя привязывать группы к подчиненным весам: игнорируем выбор весов № &1", buf_scales.scales-num)
     2103               view-as alert-box warning .
     2104               next _ii.
     2105           end.
     2106           if NOT can-find( first ub.scales-grp where
     2107                                 ub.scales-grp.db-num = buf_scales.db-num AND
     2108                                 ub.scales-grp.node-code = n-code AND
     2109                                 ub.scales-grp.scales-num = buf_scales.scales-num ) then do:
     2110             CREATE buf_scales-grp .
     2111             assign
     2112             buf_scales-grp.db-num = buf_scales.db-num
     2113             buf_scales-grp.node-code = n-code
     2114             buf_scales-grp.scales-num = buf_scales.scales-num .
     2115           end.
     2116         END .
     2117         run waitfram-hide in this-procedure .
     2118         RUN Openbr in this-procedure .
     2119         glog = br-scal-grp:SET-REPOSITIONED-ROW( jj, "ALWAYS" ).
     2120         REPOSITION br-scal-grp FORWARDS -1.
     2121       end.
     2122     END.
     2123     WHEN 'scales':U THEN DO:
     2124       run ref/gds-grp.w (
     2125                         input parparentproc
     2126                       , input "b-sel,b-mark"
     2127                       , input p-obj-type
     2128                       , input p-obj-code
     2129                       , input-output rec-list).
     2130       if ( NOT error-status:error )
     2131       AND ( rec-list <> "" ) then do:
     2132         run waitfram-show in this-procedure ( input "Ждите..." ).
     2133         _ii:
     2134         DO ii = 1 TO num-entries( rec-list ) TRANSACTION
     2135                 ON ERROR UNDO, return NO-APPLY
     2136                 ON END-KEY UNDO, return NO-APPLY
     2137                 ON STOP UNDO, return NO-APPLY :
     2138           FIND buf_gds-grp WHERE recid ( buf_gds-grp ) = integer( entry( ii, rec-list ) ) .
     2139           find first buf2_gds-grp no-lock where
     2140                     buf2_gds-grp.upper-code = buf_gds-grp.node-code no-error.
     2141           if available buf2_gds-grp then do:
     2142             message
     2143             substitute("Нельзя привязывать к весам нетерминальные группы: игнорируем выбор группы &1", buf2_gds-grp.node-code)
     2144             view-as alert-box warning .
     2145             next _ii.
     2146           end.
     2147           if NOT can-find( first ub.scales-grp where
     2148                                 ub.scales-grp.db-num = locked_scales.db-num AND
     2149                                 ub.scales-grp.node-code = buf_gds-grp.node-code AND
     2150                                 ub.scales-grp.scales-num = locked_scales.scales-num ) then do:
     2151             CREATE buf_scales-grp .
     2152             assign
     2153             buf_scales-grp.db-num = locked_scales.db-num
     2154             buf_scales-grp.node-code = buf_gds-grp.node-code
     2155             buf_scales-grp.scales-num = locked_scales.scales-num .
     2156           end.
     2157         END .
     2158         run waitfram-hide in this-procedure .
     2159         RUN Openbr in this-procedure .
     2160         glog = br-scal-grp:SET-REPOSITIONED-ROW( jj, "ALWAYS" ).
     2161         REPOSITION br-scal-grp FORWARDS -1.
     2162       end.
     2163     END.
     2164   END CASE.
     2165   END PROCEDURE.
     2166   FUNCTION get-full-name RETURNS CHARACTER
     2167     ( INPUT p-node-code AS INTEGER ) :
     2168   DEFINE VARIABLE v-full-grpname AS CHARACTER NO-UNDO.
     2169   RUN grplib-get-full-name in this-procedure( input p-node-code, output v-full-grpname ) NO-ERROR.
     2170   IF ERROR-STATUS:ERROR THEN DO:
     2171      v-full-grpname = "!!!НЕИЗВЕСТНАЯ ГРУППА".
     2172   END.
     2173   RETURN v-full-grpname.
     2174   END FUNCTION.
