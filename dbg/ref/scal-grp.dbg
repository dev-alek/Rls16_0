      132   define variable vss-include-info0 as character format "X(65)" no-undo
      133   initial "@(#)$Workfile$ $Revision$".
      134   procedure grplib-get-full-name :
      135      define input parameter p-node-code  as integer      no-undo.
      136      define output parameter p-full-name as character    no-undo.
      137      do
      138   on error undo, return error
      139   :
      140       define variable v-upper-code    as integer           no-undo.
      141       define buffer buf_gds-grp       for ub.gds-grp.
      142       define buffer buf_upper_gds-grp for ub.gds-grp.
      143       find first buf_gds-grp no-lock
      144            where buf_gds-grp.node-code = p-node-code
      145       no-error.
      146       if not available buf_gds-grp
      147       then do:
      148           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      149       end.
      150       assign
      151           p-full-name  = ""
      152           v-upper-code = 1
      153       .
      154       do while buf_gds-grp.upper-code <> 0
      155       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      156       :
      157           assign
      158               p-full-name  = buf_gds-grp.node-name
      159                            + (if p-full-name <> "" then chr(47) else "")
      160                            + p-full-name
      161               v-upper-code = buf_gds-grp.upper-code
      162           .
      163           find first buf_gds-grp no-lock
      164                where buf_gds-grp.node-code = v-upper-code
      165           no-error.
      166           if not available buf_gds-grp
      167           then do:
      168               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      169                                   + string( v-upper-code )
      170                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      171           end.
      172       end.
      173       assign
      174       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      175       .
      176   end.
      177   end .
      178   procedure grplib-get-node-from-full-name :
      179   define input parameter p-full-name as character no-undo .
      180   define output parameter p-node-code as integer no-undo .
      181   define variable v-ii as integer no-undo .
      182   define variable v-upper-code as integer no-undo .
      183   define variable v-root-code as integer no-undo .
      184   define variable v-entry as character no-undo .
      185   define buffer buf_gds-grp       for ub.gds-grp.
      186   do
      187   on error undo, return error
      188   :
      189     find first buf_gds-grp no-lock
      190         where buf_gds-grp.upper-code = 0
      191     no-error .
      192     if not available buf_gds-grp
      193     then do:
      194         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      195     end.
      196     else do:
      197       assign
      198       v-root-code = buf_gds-grp.node-code
      199       .
      200     end.
      201     v-upper-code = v-root-code.
      202     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      203       assign
      204       v-entry = entry(v-ii, p-full-name, chr(47)).
      205       if v-entry = '' then leave.
      206       find first buf_gds-grp no-lock where
      207                 buf_gds-grp.node-name = v-entry
      208             and buf_gds-grp.upper-code = v-upper-code
      209             no-error.
      210       if not available buf_gds-grp then do:
      211         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      212       end.
      213       else do:
      214         p-node-code = buf_gds-grp.node-code.
      215         v-upper-code = buf_gds-grp.node-code.
      216       end.
      217     end.
      218   end.
      219   end .
      220   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      221     define variable v-cntxt-db-num        as integer   no-undo .
      222     define variable v-cntxt-userid        as character no-undo .
      223     define variable v-cntxt-level         as character no-undo .
      224     define variable v-cntxt-host-code-obj as integer   no-undo .
      225     define variable v-cntxt-obj-type      as character no-undo .
      226     define variable v-cntxt-obj-code      as integer   no-undo .
      227     define variable v-cntxt-db-num-obj    as integer   no-undo .
      228     define variable v-cntxt-is-admin      as logical   no-undo .
      229   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      230   define variable v-waitfram-action01         as character   no-undo .
      231   define variable v-waitfram-action02         as character   no-undo .
      232   define variable v-waitfram-action03         as character   no-undo .
      233   define variable mWaitFramTextBeg            as character   no-undo.
      234   define variable mWaitFramTextEnd            as character   no-undo.
      235   define variable mWaitFramView               as logical     no-undo.
      236   define variable mWaitProcEvent              as logical     no-undo init yes.
      237   define variable mWaitFramInterval           as integer     no-undo init 1 .
      238   define variable mWaitFramStop               as logical     no-undo.
      239   define variable mWaitFramStopUser           as logical     no-undo.
      240   define variable mWaitFramStopTimeOut        as logical     no-undo.
      241   define variable mWaitFramStartProc          as datetime-tz no-undo.
      242   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      243   define button B-WaitFramStop auto-end-key
      244        label "Стоп"
      245        size 10 by 1 tooltip "Остоновить процесс".
      246   define button B-viewProcInfo
      247        label "Информация"
      248        size 15 by 1 tooltip "Информация о процесс".
      249   define frame waitfram
      250     v-waitfram-action01 format "x(72)" no-label skip
      251     v-waitfram-action02 format "x(72)" no-label skip
      252     v-waitfram-action03 format "x(72)" no-label skip
      253     B-viewProcInfo
      254     B-WaitFramStop at row 4 col 30
      255     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      256     .
      257   define new global shared variable mBatchMode as logical no-undo init ?.
      258   define variable mFramBachModHandle as handle no-undo.
      259   mFramBachModHandle = frame waitfram:handle.
      260   define variable mFameOldVis as logical no-undo.
      261   define variable mVisCUrentVin as logical no-undo.
      262   if session:batch-mode
      263   then
      264      mBatchMode = yes.
      265   if mBatchMode = ? then do:
      266     mVisCUrentVin = current-window:visible.
      267     mFameOldVis = mFramBachModHandle:visible.
      268     mFramBachModHandle:visible  = yes.
      269     mBatchMode = mFramBachModHandle:visible ne yes.
      270     mFramBachModHandle:visible = mFameOldVis.
      271     current-window:visible = mVisCUrentVin.
      272   end.
      273    if  log-manager:logfile-name ne ?
      274     then DO:
      275         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      276         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      277         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      278     end.
      279   on choose of B-WaitFramStop in frame waitfram
      280   do:
      281     mWaitFramStop = yes.
      282     mWaitFramStopUser = yes.
      283   end.
      284   function waitfram-check-timeout returns logical():
      285      define variable vtime as int64 no-undo.
      286      if mWaitFramStopTimeOut
      287      then
      288         return yes.
      289      vtime = ( now - mWaitFramStartProc ) / 1000 .
      290      if     mWaitFramTimeOut ne ?
      291         and mWaitFramTimeOut ne 0
      292         and mWaitFramTimeOut lt vtime
      293      then do:
      294         mWaitFramStopTimeOut = yes.
      295      end.
      296      return mWaitFramStopTimeOut.
      297   end.
      298   procedure waitfram-hide :
      299     if not session:batch-mode
      300     then do
      301     on error undo, return error return-value
      302     :
      303       pause 0 before-hide .
      304       if not mBatchMode then
      305         hide frame waitfram .
      306     if     not mWaitFramView
      307        and mWaitProcEvent
      308     then
      309       process events .
      310     end.
      311   end procedure.
      312   procedure waitfram-show :
      313     define input  parameter p-message as character no-undo .
      314     define variable v-left-margin as integer   no-undo .
      315     if not session:batch-mode
      316     then do
      317     on error undo, return error return-value
      318     :
      319       if length(p-message) <= 70 then do:
      320         assign
      321           v-left-margin = integer((70 - length(p-message)) / 2)
      322         .
      323         assign
      324           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      325         .
      326         assign
      327           v-waitfram-action01 = " "
      328           v-waitfram-action02 = " "
      329                                    + fill(" ", v-left-margin)
      330                                    + p-message
      331           v-waitfram-action03 = " "
      332         .
      333       end.
      334       else do:
      335         define variable vRindex1 as integer no-undo.
      336         define variable vRindex2 as integer no-undo.
      337         vRindex1 = r-index(p-message," ",70).
      338         if vRindex1 = 0
      339         then
      340            vRindex1 = 70.
      341         if length(p-message)  <= vRindex1 + 70 then do:
      342           assign
      343             v-waitfram-action01 = " "
      344             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      345             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      346           .
      347         end.
      348         else do:
      349           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      350           if vRindex2 <= vRindex1
      351           then
      352              vRindex2 = vRindex1 + 70.
      353           assign
      354             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      355             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      356             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      357           .
      358         end.
      359       end.
      360       B-viewProcInfo:visible   in frame waitfram = no.
      361       B-viewProcInfo:sensitive in frame waitfram = no.
      362       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      363       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      364       if  (   mWaitFramView
      365          or  mWaitProcEvent)
      366          and not mBatchMode
      367       then
      368          display
      369             v-waitfram-action01 skip
      370             v-waitfram-action02 skip
      371             v-waitfram-action03 skip
      372          with frame waitfram .
      373       if     mWaitFramView
      374          then do:
      375             if     mWaitFramInterval ne ?
      376                and not mBatchMode
      377             then
      378                wait-for go of frame waitfram pause mWaitFramInterval.
      379          end.
      380          else
      381             if     mWaitProcEvent
      382                and not mBatchMode
      383             then
      384                process events .
      385     end.
      386   end procedure.
      387      procedure waitfram-show-this:
      388         define input  parameter iInterval as int64 no-undo.
      389         define variable vtime as int64 no-undo.
      390         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      391         mWaitFramInterval = iInterval.
      392         run waitfram-show (substitute("&1&2 &3&4" ,
      393                                       mWaitFramTextBeg ,
      394                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      395                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      396                                       mWaitFramTextEnd
      397                                      )
      398                           ).
      399      end.
      400      procedure WaitFramRunPause:
      401         define input  parameter iInterval as dec no-undo.
      402         define variable vStart  as datetime-tz no-undo.
      403         define variable vend    as datetime-tz no-undo.
      404         define variable vint as int64 no-undo.
      405         define variable vOk as logical no-undo.
      406         vStart = now.
      407         vend   = vStart.
      408         publish "WaitFramPause" (iInterval,output vOk).
      409         vend   =  now.
      410         vint = vend - vStart.
      411         vint = iInterval - vint / 1000.
      412         if     not mWaitFramStop
      413            and (   vint > 0
      414                 or (    not vOk
      415                     and iInterval eq ?
      416                     )
      417                 )
      418         then
      419            run waitfram-show-this (iInterval).
      420         vend   =  now.
      421         vint = vend - vStart.
      422         vint = iInterval - vint / 1000.
      423         if     not mWaitFramStop
      424            and vint > 0
      425         then do:
      426            run gbl/pause.p (vint * 1000).
      427         end.
      428         if iInterval ne ?
      429         then
      430            publish "WaitFramStop".
      431         waitfram-check-timeout().
      432      end.
      433      procedure WaitFramWaitFor:
      434         define input  parameter iInterval as dec no-undo.
      435         assign
      436            mWaitFramStartProc   = now
      437            mWaitFramStopUser    = no
      438            mWaitFramStopTimeOut = no
      439         .
      440         block-wait:
      441         do while not mWaitFramStop:
      442            run WaitFramRunPause (iInterval).
      443            if  waitfram-check-timeout()
      444            then do:
      445               leave block-wait.
      446            end.
      447         end.
      448         run waitfram-hide.
      449      end.
      450   procedure waitfram-join :
      451     define input  parameter p-line-1  as character no-undo .
      452     define input  parameter p-line-2  as character no-undo .
      453     define input  parameter p-line-3  as character no-undo .
      454     define output parameter p-message as character no-undo .
      455     do
      456     on error undo, return error return-value
      457     :
      458       assign
      459         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      460                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      461                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      462       .
      463     end.
      464   end procedure.
      465   function waitfram-join-function returns character
      466     (input p-line-1 as character
      467     ,input p-line-2 as character
      468     ,input p-line-3 as character
      469     ).
      470     define variable v-message as character no-undo .
      471     run waitfram-join in this-procedure
      472       (input  p-line-1
      473       ,input  p-line-2
      474       ,input  p-line-3
      475       ,output v-message
      476       ) .
      477     return v-message .
      478   end function .
      479   define variable  full-grpname as char no-undo .
      480   define variable  rec-list as char no-undo .
      481   define variable  jj                  as integer no-undo .
      482   define variable  ii                  as integer no-undo .
      483   define variable  v-doc-rec           as integer no-undo .
      484   define buffer locked_scales for ub.scales.
      485   FUNCTION get-full-name RETURNS CHARACTER
      486     ( INPUT p-node-code AS INTEGER )  FORWARD.
      487   DEFINE BUTTON b-add
      488        LABEL "&Добавить"
      489        SIZE 10 BY 1.
      490   DEFINE BUTTON b-del
      491        LABEL "&Удалить"
      492        SIZE 10 BY 1.
      493   DEFINE BUTTON b-help
      494        LABEL "Помо&щь"
      495        SIZE 3 BY 1
      496        BGCOLOR 8 .
      497   DEFINE BUTTON b-quit AUTO-GO
      498        LABEL "&Выход "
      499        SIZE 10 BY 1
      500        BGCOLOR 8 .
      501   DEFINE QUERY br-scal-grp FOR
      502         X_scales-grp,
      503         X_gds-grp,
      504         X_scales SCROLLING.
      505   DEFINE BROWSE br-scal-grp
      506     QUERY br-scal-grp NO-LOCK DISPLAY
      507         X_scales-grp.db-num FORMAT ">>>>9":U
      508   X_scales-grp.scales-num FORMAT ">>9":U
