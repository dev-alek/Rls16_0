     2676       (input "ЖДИТЕ ..."
     2677       ).
     2678   run gbl/flt-get.p
     2679     (input filter-point
     2680     ,output flt-rec-27
     2681     ,output filter-name-27
     2682     ,output where-phrase-27
     2683     ,output sort-phrase-27
     2684     ,output where-phrase-rus-27
     2685     ,output sort-phrase-rus-27
     2686     ).
     2687   if p-open-query then do:
     2688       run set-filter-name in this-procedure
     2689         (INPUT filter-name-27
     2690         ) no-error .
     2691     assign
     2692       l-filter-open-27 = false
     2693     .
     2694     if flt-rec-27 <> ?
     2695       or sort-column-phrase > ""
     2696     then do:
     2697       define variable  parameter-2-27 as character no-undo .
     2698       define variable  parameter-3-27 as character no-undo .
     2699       define variable  parameter-4-27 as character no-undo .
     2700       define variable  parameter-5-27 as character no-undo .
     2701       define variable  parameter-6-27 as character no-undo .
     2702       define variable  parameter-7-27 as character no-undo .
     2703         assign
     2704         parameter-3-27 =
     2705                                 "FOR EACH X_clients"
     2706         parameter-4-27 =
     2707           (
     2708             if (" X_clients.obj-name contains NameOrCode                             AND X_clients.obj-type = Cli-Types                             AND X_clients.grp-name begins Curr-Grp-Name                             AND X_clients.stts <> 0 " + " " + where-phrase-27) <> ""
     2709             then  substitute('X_clients.obj-name contains &1&2&1                             AND X_clients.obj-type = &1&3&1                             AND X_clients.grp-name begins &1&4&1                             AND X_clients.stts <> 0 ', chr(34), NameOrCode, Cli-Types, Curr-Grp-Name) + " " + where-phrase-27
     2710             else "true"
     2711           )
     2712         parameter-5-27 = (" " + "" + " " + "")
     2713         parameter-6-27 = if sort-phrase-27 = ''
     2714                              then
     2715           (
     2716           " " + " " +
     2717             " " + sort-column-phrase +
     2718           " " + " BY X_clients.obj-name  "
     2719           )
     2720                              else
     2721           (
     2722           " " + " " +
     2723             " " + sort-column-phrase +
     2724           " " + sort-phrase-27
     2725           )
     2726         parameter-7-27 =
     2727           " indexed-reposition  "
     2728       .
     2729       do
     2730       on stop undo, leave
     2731       on error undo, leave
     2732       :
     2733         assign
     2734           l-disable-where-27 =
     2735             (" X_clients.obj-name contains NameOrCode                             AND X_clients.obj-type = Cli-Types                             AND X_clients.grp-name begins Curr-Grp-Name                             AND X_clients.stts <> 0 " + " " + where-phrase-27 = "")
     2736         .
     2737         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2738                             ,input query cli-list:handle
     2739                             ,input parameter-3-27
     2740                             ,input parameter-4-27
     2741                             ,input parameter-5-27
     2742                             ,input parameter-6-27
     2743                             ,input parameter-7-27
     2744                             )
     2745         .
     2746         assign
     2747           l-filter-open-27 = true
     2748         .
     2749       end.
     2750       if l-filter-open-27 = false then do:
     2751         message
     2752           "Ошибка при фильтрации / сортировке" skip
     2753           "Будут показаны записи без учета фильтра" skip
     2754           view-as alert-box .
     2755       end.
     2756       else do:
     2757           assign
     2758             l-query-was-opened = true
     2759           .
     2760       end.
     2761     end.
     2762     if l-filter-open-27 = false then do:
     2763       OPEN QUERY CLi-List FOR EACH X_clients no-lock
     2764         where  X_clients.obj-name contains NameOrCode                             AND X_clients.obj-type = Cli-Types                             AND X_clients.grp-name begins Curr-Grp-Name                             AND X_clients.stts <> 0
     2765          BY X_clients.obj-name
     2766         indexed-reposition
     2767     .
     2768         assign
     2769           l-query-was-opened = true
     2770         .
     2771     end.
     2772   end.
     2773   else do:
     2774     assign
     2775       v-doc-rec = recid( ub.clients )
     2776     .
     2777     do
     2778     on stop undo, leave
     2779     on error undo, leave
     2780     :
     2781       if query cli-list:handle:get-buffer-handle(1) = (buffer X_clients:handle) then do:
     2782         assign
     2783         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     2784         parameter-4-27 =
     2785           "where ":u +  substitute('X_clients.obj-name contains &1&2&1                             AND X_clients.obj-type = &1&3&1                             AND X_clients.grp-name begins &1&4&1                             AND X_clients.stts <> 0 ', chr(34), NameOrCode, Cli-Types, Curr-Grp-Name) + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     2786         parameter-5-27 = " "
     2787       .
     2788         run fltopend_fltfindd in this-procedure  (
     2789                             input this-procedure:handle
     2790                             ,input query cli-list:handle
     2791                             ,input rowid(ub.clients)
     2792                             ,input logical(parameter-2-27)
     2793                             ,input no-lock
     2794                             ,input (buffer ub.clients:handle)
     2795                             ,input parameter-4-27
     2796                             ,input parameter-5-27
     2797                             ) no-error.
     2798         .
     2799         assign
     2800           v-doc-rec = integer(return-value)
     2801           v-fltopend-rowid[1] = ?
     2802         .
     2803       end.
     2804       else do:
     2805         assign
     2806         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     2807         parameter-3-27 =  "FOR EACH X_clients"
     2808         parameter-4-27 =
     2809           (
     2810             if (" X_clients.obj-name contains NameOrCode                             AND X_clients.obj-type = Cli-Types                             AND X_clients.grp-name begins Curr-Grp-Name                             AND X_clients.stts <> 0 " + " " + where-phrase-27) <> ""
     2811             then  substitute('X_clients.obj-name contains &1&2&1                             AND X_clients.obj-type = &1&3&1                             AND X_clients.grp-name begins &1&4&1                             AND X_clients.stts <> 0 ', chr(34), NameOrCode, Cli-Types, Curr-Grp-Name) + " " + where-phrase-27
     2812             else "true"
     2813           )
     2814         parameter-5-27 = (" " + "" + " " + "" + " " + p-find-condition)
     2815         parameter-6-27 = if sort-phrase-27 = ''
     2816                              then
     2817           (
     2818           " " + " " +
     2819             " " + sort-column-phrase +
     2820           " " + " BY X_clients.obj-name  "
     2821           )
     2822                              else
     2823           (
     2824           " " + " " +
     2825             " " + sort-column-phrase +
     2826           " " + sort-phrase-27
     2827           )
     2828         parameter-7-27 =
     2829           " indexed-reposition  "
     2830       .
     2831         run fltopend_fltfindq in this-procedure  (
     2832                             input this-procedure:handle
     2833                             ,input query cli-list:handle
     2834                             ,input logical(parameter-2-27)
     2835                             ,input no-lock
     2836                             ,input parameter-3-27
     2837                             ,input parameter-4-27
     2838                             ,input parameter-5-27
     2839                             ,input parameter-6-27
     2840                             ,input parameter-7-27
     2841                             ,output v-fltopend-rowid
     2842                             ) no-error.
     2843         .
     2844         v-doc-rec = ?.
     2845       end.
     2846       assign
     2847         l-query-was-opened = true
     2848       .
     2849     end.
     2850   end.
     2851     run waitfram-hide in this-procedure .
     2852         end.
     2853       END CASE .
     2854     end.
     2855   END CASE.
     2856     end.
     2857   end procedure.
