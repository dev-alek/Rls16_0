        1   block-level on error undo, throw.
        2   define temp-table tt0-root-dis-card-type no-undo like ub.dis-card-type.
        3   define temp-table tt0-dis-dct-rule no-undo like ub.dis-dct-rule.
        4   define temp-table tt0-hist-nws-option no-undo like ub.hist-nws-option.
        5   define temp-table tt0-rp-by-call no-undo like ub.rp-by-call.
        6   define temp-table tt0-rule-by-call no-undo like ub.rule-by-call.
        7   define temp-table tt0-rule-call-param no-undo like ub.rule-call-param.
        8   define input-output parameter par-rid as recid no-undo .
        9   define input parameter par-mode as character no-undo .
       10   define input parameter p-emitent-host-code like ub.dis-card-type.emitent-host-code no-undo .
       11   define input parameter p-type like ub.dis-card-type.type no-undo .
       12   define input parameter p-uniq-key-rec as character no-undo .
       13   define input parameter parhost-code like ub.dis-card-type.host-code no-undo .
       14   define input parameter parobj-type like ub.dis-card-type.obj-type no-undo .
       15   define input parameter parobj-code like ub.dis-card-type.obj-code no-undo .
       16   define input parameter pard-pcnt-byshop  like ub.dis-card-type.d-pcnt-byshop no-undo .
       17   define input parameter pardflt-d-pcnt-method like ub.dis-card-type.dflt-d-pcnt-method no-undo .
       18   define input parameter pardflt-credit-card like ub.dis-card-type.dflt-credit-card no-undo .
       19   define input parameter parlim-kr like ub.dis-card-type.lim-kr no-undo .
       20   define input parameter pardflt-debet-card like  ub.dis-card-type.dflt-debet-card  no-undo .
       21   define input parameter pardflt-staff-card like  ub.dis-card-type.dflt-staff-card  no-undo .
       22   define input parameter parfiscal-pay      like  ub.dis-card-type.fiscal-pay       no-undo .
       23   define input parameter parmixed-pay       like  ub.dis-card-type.mixed-pay        no-undo .
       24   define input parameter parpay-code        like  ub.dis-card-type.pay-code         no-undo .
       25   define input parameter parcard-media      like  ub.dis-card-type.card-media       no-undo .
       26   define input parameter parcardname-sent   like  ub.dis-card-type.cardname-sent    no-undo .
       27   define input parameter parcustom-sent     like  ub.dis-card-type.custom-sent      no-undo .
       28   define input parameter pardcbyshop like ub.dis-card-type.dcbyshop no-undo .
       29   define input parameter pardc-pfx like ub.dis-card-type.dc-pfx no-undo .
       30   define input parameter parcheck-by-mask    as logical no-undo .
       31   define input parameter parho-join          as logical no-undo .
       32   define input parameter table for tt0-dis-dct-rule.
       33   define input parameter table for tt0-hist-nws-option.
       34   define input parameter table for tt0-rp-by-call.
       35   define input parameter table for tt0-rule-by-call.
       36   define input parameter table for tt0-rule-call-param.
       37   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       38   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       39   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       40   define variable vss-workfile    as character no-undo init "$Workfile: dctypei1.p $":U .
       41   define variable vss-archive     as character no-undo init "$Archive: ref/dctypei1.p $":U .
       42   define variable vss-description as character no-undo init "Сохранение изменений в карточке типа дисконтной карты".
       43   procedure vss-get-info :
       44     define output parameter p-vss-revision    like vss-revision    no-undo .
       45     define output parameter p-vss-author      like vss-author      no-undo .
       46     define output parameter p-vss-date        like vss-date        no-undo .
       47     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       48     define output parameter p-vss-archive     like vss-archive     no-undo .
       49     define output parameter p-vss-description like vss-description no-undo .
       50     assign
       51       p-vss-revision    = vss-revision
       52       p-vss-author      = vss-author
       53       p-vss-date        = vss-date
       54       p-vss-workfile    = vss-workfile
       55       p-vss-archive     = vss-archive
       56       p-vss-description = vss-description
       57     .
       58   end procedure.
       59   procedure vss-get-parameters :
       60     define output parameter p-vss-parameters as character no-undo .
       61   end procedure.
       62   define new global shared variable g#vssrevis-logger as handle    no-undo .
       63   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       64   define variable v-vssrevis-logger                   as handle    no-undo .
       65   procedure vss-logevent :
       66     define input  parameter p-extra-paramters as character no-undo .
       67     define variable v-vssrevis-parameters as character no-undo .
       68     do
       69     on error undo, return error return-value
       70     :
       71       if  valid-handle(v-vssrevis-logger)
       72       and v-vssrevis-logger :get-signature("logevent") <> ""
       73       then do:
       74         run vss-get-parameters in this-procedure
       75           (output v-vssrevis-parameters
       76           ).
       77         run logevent in v-vssrevis-logger
       78           (input vss-workfile
       79           ,input vss-revision
       80           ,input v-vssrevis-parameters
       81           ,input p-extra-paramters
       82           ).
       83       end.
       84     end.
       85   end procedure.
       86   assign
       87     v-vssrevis-logger = g#vssrevis-logger
       88   .
       89   if  valid-handle(v-vssrevis-logger)
       90   and v-vssrevis-logger :get-signature("logevent") <> ""
       91   then do:
       92     assign
       93       v-vssrevis-logevent = true
       94     .
       95     run vss-logevent in this-procedure (input vss-description) .
       96   end.
       97   define new global shared variable g#language as character no-undo .
       98   if g#language <> '' and g#language <> 'rus':U then do:
       99     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      100   end.
      101   define new global shared variable g#library  as handle no-undo .
      102   define new global shared variable g#library2 as handle no-undo .
      103   define   shared variable g#auto as logical no-undo.
      104   define   shared variable g#news as logical no-undo.
      105   define   shared variable g#oxml as logical no-undo.
      106   define   shared variable g#esys as logical no-undo.
      107   define   shared variable g#news-source-db as integer no-undo.
      108   define   shared variable g#esys-source-esys as integer no-undo.
      109   define   shared variable g#db-num as integer   no-undo .
      110   define   shared variable g#userid as character no-undo .
      111   define   shared variable g#passwd as character no-undo .
      112   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   define variable dcard-algo-field-name as character no-undo extent 3 init [
      115    'd-pcnt':U
      116   ,'cash-d-pcnt':U
      117   ,'pcnt-kat':U].
      118   define variable algo-field-abbr as character no-undo extent 3 init [
      119    'ITEM%':U
      120   ,'TOTAL%':U
      121   ,'CATEG':U].
      122   FUNCTION dct-algo-Date-to-String returns character(input  p-date as date):
      123   define variable v-date-str as character no-undo .
      124   assign
      125   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
      126                string(Month(p-date), "99":U) + chr(47) +
      127                string(DAY(p-date), "99":U).
      128   return v-date-str.
      129   END FUNCTION.
      130   function dct-algo-string-to-date returns date ( input p-string  as character):
      131     define variable v-date as date no-undo .
      132     assign
      133     v-date = date(integer(substring(p-string, 6, 2))
      134                   ,integer(substring(p-string, 9, 2))
      135                   ,integer(substring(p-string, 1, 4))
      136                  ) no-error .
      137     if error-status:error then return ?.
      138     return v-date.
      139   END FUNCTION.
      140   FUNCTION dct-algo-get-sum-id-from-DT-CODE returns character ( input p-DT-CODE as integer):
      141   define buffer buf_prop-ref for ub.prop-ref.
      142   find first buf_prop-ref no-lock where
      143             buf_prop-ref.DT-CODE = p-DT-CODE no-error.
      144   if not available buf_prop-ref then do:
      145     return chr(63).
      146   end.
      147   return buf_prop-ref.sum-id.
      148   END FUNCTION.
      149   FUNCTION dct-algo-get-description-sum-id returns character ( input p-dt-code as integer):
      150   define variable v-des as character no-undo .
      151   define buffer buf_prop-ref for ub.prop-ref.
      152   define buffer buf_prop-head for ub.prop-head.
      153   find first buf_prop-ref no-lock where
      154             buf_prop-ref.dt-code = p-dt-code no-error.
      155   if not available buf_prop-ref then do:
      156     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
      157   end.
      158   find first buf_prop-head no-lock where
      159           buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error.
      160   if not available buf_prop-head then do:
      161     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, buf_prop-ref.dtm-code).
      162   end.
      163   assign
      164   v-des = substitute("&1  &2 &3"
      165                     , buf_prop-head.prop-name
      166                     , buf_prop-ref.sum-id
      167                     , buf_prop-ref.caller_id).
      168   return v-des.
      169   end FUNCTION.
      170   FUNCTION dct-algo-get-description-node-code returns character ( input p-dtm-code as integer
      171                                                               ,input p-dt-code as integer
      172                                                               ,input p-node-code as integer
      173                                                               ):
      174   define variable v-des as character no-undo .
      175   define buffer buf_prop-ref for ub.prop-ref.
      176   define buffer buf_prop-head for ub.prop-head.
      177   define buffer buf_prop-map for ub.prop-map.
      178   find first buf_prop-ref no-lock where
      179             buf_prop-ref.dt-code = p-dt-code no-error.
      180   if not available buf_prop-ref then do:
      181     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
      182   end.
      183   find first buf_prop-head no-lock where
      184           buf_prop-head.dtm-code = p-dtm-code no-error.
      185   if not available buf_prop-head then do:
      186     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, p-dtm-code).
      187   end.
      188   find first buf_prop-map no-lock where
      189           buf_prop-map.dtm-code = p-dtm-code
      190       and buf_prop-map.node-code = p-node-code no-error .
      191   if not available buf_prop-map then do:
      192     return substitute("Срез/итог по ДК &1, &2.&3 - неизвестно"
      193                       , p-dt-code
      194                       , buf_prop-head.prop-label
      195                       , p-node-code).
      196   end.
      197   assign
      198   v-des = substitute("&1.&2 &3 &4"
      199                     , buf_prop-head.prop-label
      200                     , buf_prop-map.node-label
      201                     , buf_prop-ref.sum-id
      202                     , buf_prop-ref.caller_id).
      203   return v-des.
      204   end FUNCTION.
      205   function dct-algo-get-prev-sum-id RETURNS integer (
      206                                                       input p-dt-code as integer
      207                                                      ):
      208   define variable v-dtm-code as integer no-undo .
      209   define variable v-sum-id as character no-undo .
      210   define variable v-caller-id as character no-undo .
      211   define buffer buf_prop-ref for ub.prop-ref.
      212   find first buf_prop-ref no-lock where
      213           buf_prop-ref.dt-code = p-dt-code no-error.
      214   if not available buf_prop-ref then return ?.
      215   assign
      216   v-dtm-code = buf_prop-ref.dtm-code
      217   v-sum-id = buf_prop-ref.sum-id.
      218   v-caller-id = buf_prop-ref.caller_id.
      219   find last buf_prop-ref no-lock where
      220             buf_prop-ref.dtm-code = v-dtm-code
      221        and  buf_prop-ref.sum-id < v-sum-id
      222        and  buf_prop-ref.caller_id = v-caller-id
      223        no-error.
      224   if available buf_prop-ref then return buf_prop-ref.dt-code.
      225   return -1 .
      226   END FUNCTION.
      227   FUNCTION dct-algo-get_dcproperty-value returns logical (
      228                                                             input p-prop-name as character
      229                                                           , input p-d-card    as character
      230                                                           , input p-host-code as integer
      231                                                           , input p-obj-type  as character
      232                                                           , input p-obj-code  as integer
      233                                                           , output p-value-character as character
      234                                                           , output p-value-date   as date
      235                                                           , output p-value-integer as integer
      236                                                           , output p-value-decimal as decimal
      237                                                           , output p-value-logical as logical):
      238     return no.
      239   END FUNCTION.
      240   FUNCTION dct-algo-get_dcproperty-value-chr returns logical (
      241                                                             input p-d-card    as character
      242                                                           , input p-emitent-host-code as integer
      243                                                           , input p-type as character
      244                                                           , input p-host-code as integer
      245                                                           , input p-obj-type  as character
      246                                                           , input p-obj-code  as integer
      247                                                           , output p-value-chr as character):
      248   define variable v-dt-code as integer no-undo .
      249   define variable v-node-code as integer no-undo .
      250   define variable v-field-name as character no-undo .
      251   define variable v-storage-place as character no-undo .
      252   define variable v-sum-id-value as character no-undo .
      253   define variable v-sum-id-output as logical no-undo .
      254   define variable v-value-chr as character no-undo .
      255   define variable v-ii as integer no-undo .
      256   define buffer buf_dis-card-property for ub.dis-card-property.
      257   define buffer buf_dis-host for ub.dis-host.
      258   define buffer buf_dis-obj for ub.dis-obj.
      259   run get-cd-sumid in this-procedure (
      260                                         input p-emitent-host-code
      261                                        ,input p-type
      262                                        ,input p-host-code
      263                                        ,input p-obj-type
      264                                        ,input p-obj-code
      265                                        ,output v-sum-id-value
      266                                        ,output v-sum-id-output
      267                                       ) no-error.
      268   if not v-sum-id-output then do:
      269     return no.
      270   end.
      271   do v-ii = 1 to num-entries(v-sum-id-value):
      272     assign
      273     v-storage-place = entry(1, entry(v-ii, v-sum-id-value), chr(4))
      274     v-dt-code = integer(entry(2, entry(v-ii, v-sum-id-value), chr(4)))
      275     v-node-code = integer(entry(3, entry(v-ii, v-sum-id-value), chr(4)))
      276     v-field-name = entry(4, entry(v-ii, v-sum-id-value), chr(4))
      277     no-error .
      278     if not error-status:error then do:
      279       case v-storage-place:
      280         when 'dis-card-property':U then do:
      281           find first buf_dis-card-property no-lock where
      282                     buf_dis-card-property.d-card = p-d-card
      283               and  buf_dis-card-property.host-code = p-host-code
      284               and  buf_dis-card-property.obj-type = p-obj-type
      285               and  buf_dis-card-property.obj-code = p-obj-code
      286               and  buf_dis-card-property.dt-code = v-dt-code
      287               and  buf_dis-card-property.node-code = v-node-code no-error .
      288           if available buf_dis-card-property then do:
      289             v-value-chr = buffer buf_dis-card-property:handle:buffer-field(v-field-name):string-value.
      290           end.
      291           else do:
      292             v-value-chr = chr(63).
      293           end.
      294         end.
      295         when 'dis-obj':U then do:
      296           find first buf_dis-obj no-lock where
      297                     buf_dis-obj.d-card = p-d-card
      298               and  buf_dis-obj.obj-type = p-obj-type
      299               and  buf_dis-obj.obj-code = p-obj-code
      300               and  buf_dis-obj.dt-code = v-dt-code no-error .
      301           if available buf_dis-obj then do:
      302             v-value-chr = buffer buf_dis-obj:handle:buffer-field(v-field-name):string-value.
      303           end.
      304           else do:
      305             v-value-chr = chr(63).
      306           end.
      307         end.
      308         when 'dis-host':U then do:
      309           find first buf_dis-host no-lock where
      310                     buf_dis-host.d-card = p-d-card
      311               and  buf_dis-host.host-code = p-host-code
      312               and  buf_dis-host.dt-code = v-dt-code no-error .
      313           if available buf_dis-host then do:
      314             v-value-chr = buffer buf_dis-host:handle:buffer-field(v-field-name):string-value.
      315           end.
      316           else do:
      317             v-value-chr = chr(63).
      318           end.
      319         end.
      320       end.
      321     end.
      322     p-value-chr = p-value-chr + (if v-ii = 1 then '':U else chr(44)) + v-value-chr.
      323   end.
      324   END FUNCTION.
      325   FUNCTION dct-algo_custom-sent-description RETURNS CHARACTER
      326     ( INPUT p-custom-sent as character ) :
      327   DEFINE VARIABLE v-storage-place AS CHARACTER NO-UNDO.
      328   DEFINE VARIABLE v-dtm-code AS integer NO-UNDO.
      329   DEFINE VARIABLE v-sum-id AS character NO-UNDO.
      330   DEFINE VARIABLE v-caller-id AS character NO-UNDO.
      331   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
      332   DEFINE VARIABLE v-sum-id-description AS CHARACTER.
      333   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
      334   IF p-custom-sent = chr(63) THEN RETURN "Не отсылать".
      335   assign
      336   v-storage-place = entry(1, p-custom-sent, chr(4))
      337   v-dtm-code = integer(entry(2, p-custom-sent, chr(4)))
      338   v-sum-id   = entry(3, p-custom-sent, chr(4))
      339   v-caller-id = entry(4, p-custom-sent, chr(4))
      340   v-node-code = integer(entry(5, p-custom-sent, chr(4)))
      341   no-error .
      342   IF ERROR-STATUS:ERROR THEN DO:
      343     MESSAGE
      344     "Не могу разобрать строку, описывающую итог"
      345      VIEW-AS ALERT-BOX WARNING.
      346     RETURN chr(63).
      347   END.
      348   FIND FIRST buf_prop-ref NO-LOCK WHERE
      349             buf_prop-ref.dtm-code = v-dtm-code
      350        AND  buf_prop-ref.sum-id = v-sum-id
      351        AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
      352   IF NOT AVAILABLE buf_prop-ref THEN DO:
      353     FIND FIRST buf_prop-ref NO-LOCK WHERE
      354               buf_prop-ref.dtm-code = v-dtm-code
      355         AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
      356     IF NOT AVAILABLE buf_prop-ref THEN DO:
      357         MESSAGE
      358         "Не могу разобрать строку, описывающую итог"
      359          VIEW-AS ALERT-BOX WARNING.
      360         RETURN chr(63).
      361      end.
      362   end.
      363   ASSIGN
      364   v-sum-id-description =  dct-algo-get-description-node-code ( v-dtm-code
      365                                                          ,buf_prop-ref.dt-code
      366                                                          ,v-node-code).
      367   RETURN v-sum-id-description.
      368   END FUNCTION.
      369   FUNCTION one-base-cur-for-objs  returns logical (output p-glob-curr-code as integer):
      370   define variable v-glob-val as logical no-undo init yes.
      371   define buffer buf_sysconf for ub.sysconf.
      372   define buffer buf_clients for ub.clients.
      373   assign
      374   p-glob-curr-code =  -1
      375   .
      376   FOR EACH buf_sysconf NO-LOCK,
      377       first buf_clients no-lock where
      378            buf_clients.host-code = buf_sysconf.host-code:
      379       if p-glob-curr-code = -1 then
      380       assign
      381       p-glob-curr-code = buf_sysconf.base-code
      382       .
      383       else if p-glob-curr-code <> buf_sysconf.base-code then do:
      384           assign
      385           v-glob-val = no
      386           p-glob-curr-code = ?
      387           .
      388           LEAVE.
      389       end.
      390   END.
      391   return v-glob-val.
      392   END FUNCTION.
      393   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      394   define temp-table temp-mask-range no-undo
      395   field mask-original   like ub.dis-card-mask.mask
      396   field mask      like ub.dis-card-mask.mask
      397   field mask-num as integer
      398   field lvl-decompose as integer
      399   field host-code like ub.sysconf.host-code
      400   field obj-type like ub.clients.obj-type
      401   field obj-code like ub.clients.obj-code
      402   field first-code as decimal
      403   field last-code as decimal
      404   field to-check as logical
      405   index pi is unique mask-num lvl-decompose first-code last-code
      406   index iobj to-check first-code last-code host-code obj-type obj-code
      407   .
      408   procedure decompose-mask :
      409   define input parameter p-mask-num  like ub.dis-card-mask.mask-num no-undo .
      410   define input parameter p-mask      like ub.dis-card-mask.mask     no-undo .
      411   define input parameter p-mask-original like ub.dis-card-mask.mask     no-undo .
      412   define input parameter p-lvl-decompose  as integer no-undo .
      413   define input parameter p-host-code like ub.sysconf.host-code      no-undo .
      414   define input parameter p-obj-type  like ub.clients.obj-type       no-undo .
      415   define input parameter p-obj-code  like ub.clients.obj-code       no-undo .
      416   define variable v-ii as integer no-undo .
      417   define variable v-jj as integer no-undo .
      418   define variable v-kk as integer no-undo .
      419   define variable v-max as integer no-undo .
      420   define variable v-mask as character no-undo .
      421   define variable v-mask0 as character no-undo .
      422   define variable v-mask9 as character no-undo .
      423   define variable v-mask-char as character no-undo .
      424   define variable v-dec       as decimal no-undo .
      425     do
      426     on error undo, return error return-value
      427     :
      428       assign
      429       v-mask = p-mask
      430       v-max = length (p-mask).
      431       _do:
      432       do v-ii = 1 to v-max:
      433         assign
      434         v-mask-char = substring(p-mask, v-ii, 1)
      435         .
      436         if v-mask-char = chr(63) then do:
      437           do v-kk = 0 to 9:
      438             create temp-mask-range.
      439             assign
      440             substring(v-mask, v-ii, 1) = string(v-kk)
      441             temp-mask-range.mask     = v-mask
      442             temp-mask-range.mask-original = p-mask-original
      443             temp-mask-range.mask-num = p-mask-num
      444             temp-mask-range.host-code = p-host-code
      445             temp-mask-range.obj-type  = p-obj-type
      446             temp-mask-range.obj-code  = p-obj-code
      447             temp-mask-range.lvl-decompose = p-lvl-decompose + 1
      448             .
      449             assign
      450             v-dec = decimal(v-mask + "." ) no-error .
      451             if not error-status:error then
      452             assign
      453             temp-mask-range.first-code = decimal(v-mask + ".")
      454             temp-mask-range.last-code = decimal(v-mask + ".")
      455             temp-mask-range.to-check  = yes
      456             .
      457             else do:
      458               assign
      459               temp-mask-range.first-code = ?
      460               temp-mask-range.last-code = ?
      461               temp-mask-range.to-check  = no
      462               .
      463             end.
      464           end.
      465         end.
      466         if v-mask-char = "*":U then do:
      467           assign
      468           v-mask =  trim(v-mask, "*":U)
      469           v-mask0 = trim(v-mask, "*":U)
      470           v-mask9 = trim(v-mask, "*":U)
      471           .
      472           do v-jj = 1 to (19 - v-ii + 1) :
      473             create temp-mask-range.
      474             assign
      475             temp-mask-range.mask     = v-mask
      476             temp-mask-range.mask-original = p-mask-original
      477             temp-mask-range.mask-num = p-mask-num
      478             temp-mask-range.host-code = p-host-code
      479             temp-mask-range.obj-type  = p-obj-type
      480             temp-mask-range.obj-code  = p-obj-code
      481             temp-mask-range.lvl-decompose = p-lvl-decompose + 1
      482             v-mask  = v-mask + "0"
      483             v-mask0 = v-mask0 + "0"
      484             v-mask9 = v-mask9 + "9"
      485             .
      486             assign
      487             v-dec = decimal(v-mask0 + ".") no-error .
      488             if not error-status:error then
      489             assign
      490             temp-mask-range.first-code = decimal(v-mask0 + ".":U)
      491             temp-mask-range.last-code = decimal(v-mask9 + ".")
      492             temp-mask-range.to-check  = yes
      493             .
      494           end.
      495         end.
      496       end.
      497       for each temp-mask-range no-lock where
      498               temp-mask-range.mask-num = p-mask-num
      499           AND temp-mask-range.lvl-decompose = p-lvl-decompose + 1:
      500         if index(temp-mask-range.mask, "*":U) > 0 then
      501         run decompose-mask in this-procedure (
      502                                                  input temp-mask-range.mask-num
      503                                                 ,input temp-mask-range.mask
      504                                                 ,input temp-mask-range.mask-original
      505                                                 ,input temp-mask-range.lvl-decompose
      506                                                 ,input temp-mask-range.host-code
      507                                                 ,input temp-mask-range.obj-type
      508                                                 ,input temp-mask-range.obj-code  ).
      509       end.
      510     end.
      511   end procedure.
      512   procedure check-mask-correct-ho-join :
      513   define input parameter p-emitent-host-code like ub.dis-card-mask.emitent-host-code no-undo .
      514   define input parameter p-type              like ub.dis-card-mask.type no-undo .
      515   define input parameter p-new-mask          like ub.dis-card-mask.mask      no-undo .
      516   define input parameter p-new-host-code     like ub.dis-card-mask.host-code no-undo .
      517   define input parameter p-new-obj-type      like ub.dis-card-mask.obj-type  no-undo .
      518   define input parameter p-new-obj-code      like ub.dis-card-mask.obj-code  no-undo .
      519   define output parameter p-is-correct as logical no-undo .
      520   define variable v-found as logical no-undo .
      521   define buffer buf_temp-mask-range for temp-mask-range.
      522   define buffer buf_dis-card-mask for ub.dis-card-mask.
      523     do
      524     on error undo, return error
      525     :
      526       for each temp-mask-range:
      527         delete temp-mask-range.
      528       end.
      529       for each buf_dis-card-mask no-lock where
      530               buf_dis-card-mask.emitent-host-code = p-emitent-host-code
      531           AND buf_dis-card-mask.type = p-type
      532           AND buf_dis-card-mask.stts = integer('0':U)
      533           :
      534         if buf_dis-card-mask.use-on = integer('1':U) then NEXT.
      535         run decompose-mask in this-procedure (
      536                                                  input buf_dis-card-mask.mask-num
      537                                                 ,input buf_dis-card-mask.mask
      538                                                 ,input buf_dis-card-mask.mask
      539                                                 ,input 0
      540                                                 ,input buf_dis-card-mask.host-code
      541                                                 ,input buf_dis-card-mask.obj-type
      542                                                 ,input buf_dis-card-mask.obj-code  ).
      543       end.
      544       if p-new-mask <> "":U then do:
      545         run decompose-mask in this-procedure (
      546                                                  input 0
      547                                                 ,input p-new-mask
      548                                                 ,input p-new-mask
      549                                                 ,input 0
      550                                                 ,input p-new-host-code
      551                                                 ,input p-new-obj-type
      552                                                 ,input p-new-obj-code   ).
      553       end.
      554       for each temp-mask-range no-lock where
      555               temp-mask-range.to-check = yes
      556       break
      557       by temp-mask-range.host-code
      558       by temp-mask-range.obj-type
      559       by temp-mask-range.obj-code:
      560         for each buf_temp-mask-range where
      561                buf_temp-mask-range.to-check = yes
      562            AND
      563                (buf_temp-mask-range.first-code >= temp-mask-range.first-code
      564            AND buf_temp-mask-range.first-code <= temp-mask-range.last-code)
      565            OR
      566                (buf_temp-mask-range.last-code >= temp-mask-range.first-code
      567            AND buf_temp-mask-range.last-code <= temp-mask-range.last-code):
      568           if recid(buf_temp-mask-range) = recid(temp-mask-range) then Next.
      569           if temp-mask-range.host-code <> 0
      570           and (buf_temp-mask-range.host-code = temp-mask-range.host-code
      571           AND buf_temp-mask-range.obj-type = temp-mask-range.obj-type
      572           AND buf_temp-mask-range.obj-code = temp-mask-range.obj-code) then NEXT.
      573           assign
      574           v-found = yes.
      575           return substitute("Могут существовать номера карт, удовлетворяющих маске &1 по фирме &2 объект &3 и маске &4 по фирме &5 объект &6"
      576                              , temp-mask-range.mask-original
      577                              , temp-mask-range.host-code
      578                              , (temp-mask-range.obj-type + string(temp-mask-range.obj-code))
      579                              , buf_temp-mask-range.mask-original
      580                              , buf_temp-mask-range.host-code
      581                              , (buf_temp-mask-range.obj-type + string(buf_temp-mask-range.obj-code))
      582                                 ).
      583         end.
      584       end.
      585       assign
      586       p-is-correct = yes.
      587     end.
      588   end procedure.
      589   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      590   procedure gen-key-rec :
      591     define input  parameter p-tbl-name    as character no-undo.
      592     define input  parameter p-bh_tbl-name as handle    no-undo.
      593     define output parameter p-key-rec     as character no-undo.
      594     do
      595     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      596     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      597     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      598     :
      599       define variable fh               as handle    no-undo .
      600       define variable v-ok             as logical   no-undo .
      601       define variable v-inform         as character no-undo .
      602       define variable v-ind            as integer   no-undo .
      603       define variable v-idx-field-qnty as integer   no-undo .
      604       if p-tbl-name = ?
      605         or p-tbl-name = "":U
      606       then do:
      607         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      608       end.
      609       if not p-bh_tbl-name:available then do:
      610         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      611       end.
      612       assign
      613         p-key-rec = p-tbl-name
      614         v-inform  = p-bh_tbl-name:index-information(1)
      615         v-ind     = 2
      616       .
      617       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      618       on error undo, return error
      619       :
      620         assign
      621           v-inform = p-bh_tbl-name:index-information( v-ind )
      622           v-ind    = v-ind + 1
      623         .
      624       end.
      625       if v-inform = ?
      626         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      627         or entry( 3, v-inform, ",":U ) <> "1":U
      628       then do:
      629         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      630       end.
      631       else do:
      632         assign
      633           v-idx-field-qnty = num-entries( v-inform ) - 4
      634         .
      635         if v-idx-field-qnty < 2 then do:
      636           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      637         end.
      638         do v-ind = 1 to v-idx-field-qnty by 2
      639         on error undo, return error
      640         :
      641           assign
      642             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      643             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      644           .
      645         end.
      646       end.
      647       if p-key-rec = ? then do:
      648         assign
      649           p-key-rec = "":U
      650         .
      651         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      652       end.
      653     end.
      654     return.
      655   end procedure.
      656   procedure gen-where-keyr-tab :
      657     define input  parameter i-tableSerach as character no-undo.
      658     define input  parameter i-tablekey   as character  no-undo.
      659     define input  parameter p-key-rec    as character  no-undo.
      660     define input  parameter p-key-handle as handle     no-undo .
      661     define input  parameter p-db-name    as character  no-undo .
      662     define input  parameter p-tt-handle  as handle     no-undo .
      663     define output parameter o-Where      as character  no-undo.
      664     do
      665     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      666     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      667     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      668     :
      669       define variable v-full-tbl-name  as character no-undo .
      670       define variable bh_tbl-name      as handle    no-undo .
      671       define variable fh_key           as handle    no-undo .
      672       define variable fh_search        as handle    no-undo .
      673       define variable v-field-num      as integer   no-undo .
      674       define variable v-count-fld      as integer   no-undo .
      675       define variable v-inform         as character no-undo .
      676       define variable v-ind            as integer   no-undo .
      677       define variable v-idx-field-qnty as integer   no-undo .
      678       define variable v-field-name     as character no-undo .
      679       define variable v-field-val      as character no-undo .
      680       define variable v-word-link      as character no-undo .
      681       define variable vTable           as character no-undo.
      682       define variable bh_tbl-key       as handle    no-undo .
      683       assign
      684         p-key-rec = trim( p-key-rec )
      685       .
      686       if p-key-handle <> ? then do:
      687         if not valid-handle(p-key-handle)
      688            or p-key-handle:type <> "buffer"
      689         then do:
      690           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      691         end.
      692         if num-entries( p-key-rec, chr(3) ) > 1
      693           or p-key-rec = ?
      694           or p-key-rec = "":U
      695         then do:
      696           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      697         end.
      698       end.
      699       else do:
      700         if p-key-rec = ?
      701           or p-key-rec = "":U
      702         then do:
      703           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      704         end.
      705       end.
      706       assign
      707         vTable = entry( 1 , p-key-rec, chr(3) )
      708       .
      709       if p-tt-handle <> ?
      710         and ( not valid-handle(p-tt-handle)
      711               or p-tt-handle:type <> "buffer"
      712             )
      713       then do:
      714         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      715       end.
      716       if p-tt-handle = ? then do:
      717         assign
      718           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      719         .
      720         create buffer bh_tbl-name for table v-full-tbl-name .
      721       end.
      722       else do:
      723         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      724       end.
      725       assign
      726         v-inform = bh_tbl-name:index-information(1)
      727         v-ind    = 2
      728       .
      729       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      730       on error undo, return error
      731       :
      732         assign
      733           v-inform = bh_tbl-name:index-information( v-ind )
      734           v-ind    = v-ind + 1
      735         .
      736       end.
      737       if v-inform = ?
      738         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      739         or entry( 3, v-inform, ",":U ) <> "1":U
      740       then do:
      741         delete object bh_tbl-name no-error.
      742         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      743       end.
      744       assign
      745         v-idx-field-qnty = num-entries( v-inform ) - 4
      746       .
      747       if v-idx-field-qnty < 2 then do:
      748         delete object bh_tbl-name no-error.
      749         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      750       end.
      751       assign
      752         o-where     = "where":U
      753         v-word-link = "":U
      754         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      755         v-count-fld = 0
      756       .
      757       if i-tablekey ne "" and i-tablekey ne ?
      758       then do:
      759         assign
      760           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      761         .
      762         create buffer bh_tbl-key for table v-full-tbl-name .
      763       end.
      764       if i-tableSerach ne "" and i-tableSerach ne ?
      765       then do:
      766         delete object bh_tbl-name no-error.
      767         assign
      768           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      769         .
      770         create buffer bh_tbl-name for table v-full-tbl-name .
      771       end.
      772       block_where:
      773       do v-ind = 1 to v-idx-field-qnty by 2
      774       on error undo, return error
      775       :
      776         assign
      777           v-count-fld = v-count-fld + 1
      778         .
      779         if p-key-handle = ?
      780           and v-count-fld > v-field-num
      781         then do:
      782           leave block_where.
      783         end.
      784         define variable VfieldKeyTable as handle no-undo.
      785         assign
      786           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      787           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      788         .
      789         if     bh_tbl-key ne ?
      790         then do:
      791            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      792            if VfieldKeyTable eq ?
      793            then next block_where.
      794         end.
      795         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      796         then
      797            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      798         else
      799            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      800         if p-key-handle = ? then do:
      801           assign
      802             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      803           .
      804         end.
      805         else do:
      806           assign
      807             fh_key = p-key-handle:buffer-field( v-field-name )
      808           .
      809           if fh_key = ?
      810             or not valid-handle( fh_key )
      811           then do:
      812             delete object bh_tbl-name.
      813             if     bh_tbl-key ne ?
      814             then
      815                delete object bh_tbl-key.
      816             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      817           end.
      818           assign
      819             v-field-val = fh_key:buffer-value
      820           .
      821         end.
      822         if fh_search:data-type ="character":U then do:
      823           assign
      824             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      825             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      826             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      827             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      828             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      829             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      830             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      831             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      832             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      833             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      834             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      835             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      836             v-field-val = substitute( '"&1"', v-field-val )
      837           .
      838         end.
      839         assign
      840           o-where = substitute( "&1 &2", o-where, v-field-val )
      841         .
      842         if v-word-link = "":U then do:
      843           assign
      844             v-word-link = "and":U
      845           .
      846         end.
      847       end.
      848       delete object bh_tbl-name.
      849       if     bh_tbl-key ne ?
      850       then
      851          delete object bh_tbl-key.
      852       if p-key-handle = ?
      853         and v-count-fld <> v-field-num
      854       then do:
      855         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      856       end.
      857     end.
      858   end procedure.
      859   procedure gen-hn-keyr-tab :
      860     define input  parameter i-tableSerach as character no-undo.
      861     define input  parameter i-tablekey   as character no-undo.
      862     define input  parameter p-key-rec    as character no-undo.
      863     define input  parameter p-key-handle as handle    no-undo .
      864     define input  parameter p-db-name    as character no-undo .
      865     define input  parameter p-tt-handle  as handle    no-undo .
      866     define input  parameter p-stts-lock  as integer   no-undo .
      867     define output parameter o-hn         as handle    no-undo.
      868     define variable v-full-tbl-name as character no-undo.
      869     define variable v-where         as character no-undo.
      870     define variable bh_tbl-name     as handle    no-undo.
      871     define variable vTable          as character no-undo.
      872     do
      873     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      874     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      875     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      876         run gen-where-keyr-tab(i-tableSerach,
      877                                i-tablekey,
      878                                p-key-rec,
      879                                p-key-handle,
      880                                p-db-name,
      881                                p-tt-handle,
      882                                output v-where).
      883         if i-tableSerach ne "" and i-tableSerach ne ?
      884         then do:
      885            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      886            create buffer bh_tbl-name for table v-full-tbl-name .
      887         end.
      888         else do:
      889            if p-tt-handle = ? then do:
      890               assign
      891                  vTable = entry( 1 , p-key-rec, chr(3) )
      892               .
      893               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      894               create buffer bh_tbl-name for table v-full-tbl-name .
      895            end.
      896            else do:
      897               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      898            end.
      899         end.
      900         if p-tt-handle = ? then do:
      901            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      902         end.
      903         else do:
      904            bh_tbl-name:find-first( v-where ) no-error .
      905         end.
      906         o-hn = bh_tbl-name.
      907      end.
      908   end procedure.
      909   procedure gen-hn-keyr :
      910     define input  parameter p-key-rec    as character no-undo.
      911     define input  parameter p-key-handle as handle    no-undo .
      912     define input  parameter p-db-name    as character no-undo .
      913     define input  parameter p-tt-handle  as handle    no-undo .
      914     define input  parameter p-stts-lock  as integer   no-undo .
      915     define output parameter o-hn         as handle    no-undo.
      916     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      917   end.
      918   procedure gen-row-keyr :
      919     define input  parameter p-key-rec    as character no-undo.
      920     define input  parameter p-key-handle as handle    no-undo .
      921     define input  parameter p-db-name    as character no-undo .
      922     define input  parameter p-tt-handle  as handle    no-undo .
      923     define input  parameter p-stts-lock  as integer   no-undo .
      924     define output parameter p-tbl-row    as rowid     no-undo.
      925     define output parameter p-tbl-name   as character no-undo.
      926     define variable vHn as handle no-undo.
      927       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      928       p-tbl-row = if vHn:available then vHn:rowid else ?.
      929       p-tbl-name =  vHn:table.
      930       delete object vHn no-error.
      931     if p-tbl-row = ? then do:
      932       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
      933     end.
      934     else do:
      935       return.
      936     end.
      937   end procedure.
      938   procedure gen-key-fv :
      939     define input  parameter p-key-rec    as character no-undo .
      940     define output parameter p-field-list as character no-undo .
      941     define output parameter p-value-list as character no-undo.
      942     do
      943     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      944     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      945     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      946     :
      947       define variable v-full-tbl-name  as character no-undo .
      948       define variable bh_tbl-name      as handle    no-undo .
      949       define variable v-tbl-name       as character no-undo .
      950       define variable v-field-num      as integer   no-undo .
      951       define variable v-count-fld      as integer   no-undo .
      952       define variable v-inform         as character no-undo .
      953       define variable v-ind            as integer   no-undo .
      954       define variable v-idx-field-qnty as integer   no-undo .
      955       define variable v-delim-key      as character no-undo .
      956       if p-key-rec = ?
      957         or p-key-rec = "":U
      958       then do:
      959         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      960       end.
      961       assign
      962         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      963         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      964       .
      965       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      966       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
      967       assign
      968         v-inform = bh_tbl-name:index-information(1)
      969         v-ind    = 2
      970       .
      971       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      972       on error undo, return error
      973       :
      974         assign
      975           v-inform = bh_tbl-name:index-information( v-ind )
      976           v-ind    = v-ind + 1
      977         .
      978       end.
      979       if v-inform = ?
      980         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      981         or entry( 3, v-inform, ",":U ) <> "1":U
      982       then do:
      983         delete object bh_tbl-name no-error.
      984         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
      985       end.
      986       assign
      987         v-idx-field-qnty = num-entries( v-inform ) - 4
      988       .
      989       if v-idx-field-qnty < 2 then do:
      990         delete object bh_tbl-name no-error.
      991         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
      992       end.
      993       assign
      994         p-field-list = "":U
      995         p-value-list = "":U
      996         v-delim-key  = "":U
      997         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      998         v-count-fld  = 0
      999       .
     1000       block_where:
     1001       do v-ind = 1 to v-idx-field-qnty by 2
     1002       on error undo, return error
     1003       :
     1004         assign
     1005           v-count-fld = v-count-fld + 1
     1006         .
     1007         if v-count-fld > v-field-num then do:
     1008           leave block_where.
     1009         end.
     1010         assign
     1011           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1012           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1013         .
     1014         if v-ind = 1 then do:
     1015           assign
     1016             v-delim-key = chr(3)
     1017           .
     1018         end.
     1019       end.
     1020       delete object bh_tbl-name.
     1021       if v-count-fld <> v-field-num then do:
     1022         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
     1023       end.
     1024     end.
     1025   end procedure.
     1026   procedure gen-key-field :
     1027     define input  parameter p-table      as character no-undo .
     1028     define output parameter p-field-list as character no-undo .
     1029     do
     1030     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1031     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1032     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1033     :
     1034       define variable v-full-tbl-name  as character no-undo .
     1035       define variable bh_tbl-name      as handle    no-undo .
     1036       define variable v-tbl-name       as character no-undo .
     1037       define variable v-field-num      as integer   no-undo .
     1038       define variable v-count-fld      as integer   no-undo .
     1039       define variable v-inform         as character no-undo .
     1040       define variable v-ind            as integer   no-undo .
     1041       define variable v-idx-field-qnty as integer   no-undo .
     1042       define variable v-delim-key      as character no-undo .
     1043       if p-table = ?
     1044         or p-table = "":U
     1045       then do:
     1046         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
     1047       end.
     1048       assign
     1049         v-tbl-name      = p-table
     1050         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1051       .
     1052       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1053       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
     1054       assign
     1055         v-inform = bh_tbl-name:index-information(1)
     1056         v-ind    = 2
     1057       .
     1058       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1059       on error undo, return error
     1060       :
     1061         assign
     1062           v-inform = bh_tbl-name:index-information( v-ind )
     1063           v-ind    = v-ind + 1
     1064         .
     1065       end.
     1066       if v-inform = ?
     1067         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1068         or entry( 3, v-inform, ",":U ) <> "1":U
     1069       then do:
     1070         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
     1071       end.
     1072       assign
     1073         v-idx-field-qnty = num-entries( v-inform ) - 4
     1074       .
     1075       if v-idx-field-qnty < 2 then do:
     1076         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
     1077       end.
     1078       assign
     1079         p-field-list = "":U
     1080         v-delim-key  = "":U
     1081         v-count-fld  = 0
     1082       .
     1083       block_where:
     1084       do v-ind = 1 to v-idx-field-qnty by 2
     1085       on error undo, return error
     1086       :
     1087         assign
     1088           v-count-fld = v-count-fld + 1
     1089         .
     1090         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1091         if v-ind = 1 then do:
     1092           assign
     1093             v-delim-key = chr(3)
     1094           .
     1095         end.
     1096       end.
     1097       delete object bh_tbl-name.
     1098     end.
     1099   end procedure.
     1100   DEFINE VARIABLE loc#log as logical no-undo .
     1101   DEFINE VARIABLE VAR-ENTRY as character no-undo .
     1102   DEFINE VARIABLE jj as integer no-undo .
     1103   define variable v-r-b-code like ub.currency.curr-code.
     1104   define variable v-curr-r-b as character no-undo .
     1105   define variable v-glob-curr-code like ub.currency.curr-code no-undo .
     1106   define variable glob-val as logical no-undo .
     1107   define variable vardeleted   as logical   no-undo.
     1108   define variable conf-par as character no-undo .
     1109   define variable par-type as character no-undo .
     1110   define variable v-ok as logical no-undo .
     1111   define variable v-cmd-code as integer no-undo .
     1112   define variable v-cmd-proc-handle as handle no-undo .
     1113   define variable v-command as character no-undo .
     1114   define variable v-cmp as logical no-undo .
     1115   define variable v-cmp-loc as logical no-undo .
     1116   define variable v-last as integer no-undo .
     1117   define variable v-rec-ord as integer no-undo .
     1118   define buffer buf_Dis-card-type for ub.dis-card-type.
     1119   define buffer buf_cash-pay for ub.cash-pay.
     1120   define buffer buf_db for ub.db.
     1121   define buffer buf_hist-nws-option for ub.hist-nws-option.
     1122   define buffer buf0_hist-nws-option for ub.hist-nws-option.
     1123   define buffer last_hist-nws-option for ub.hist-nws-option.
     1124   define buffer buf_dis-dct-rule for ub.dis-dct-rule.
     1125   define buffer buf_tt0-dis-dct-rule for tt0-dis-dct-rule.
     1126   define buffer term_dis-card-type for ub.dis-card-type.
     1127   define buffer buf_dis-card for ub.dis-card.
     1128   if g#db-num > 0  then do:
     1129     message  vss-workfile vss-revision vss-description skip
     1130             "Вызов процедуры в УБД запрещен"
     1131     view-as alert-box ERROR.
     1132     return error '':u.
     1133   end.
     1134   if par-mode <> 'ДОБАВЛЕНИЕ':U AND par-mode <> 'ИЗМЕНЕНИЕ':U then do:
     1135     message vss-workfile vss-revision vss-description skip
     1136             "Неверный параметр par-mode - " par-mode
     1137     view-as alert-box error .
     1138     return error '':u.
     1139   end.
     1140   if p-type = "" then do:
     1141     message "Тип дисконтной карты не может быть пустым"
     1142     view-as alert-box error .
     1143     var-entry = "type":U.
     1144     return error VAR-ENTRY.
     1145   end.
     1146   if p-type begins '@' then do:
     1147     message "Тип дисконтной карты не может начинаться с символа @"
     1148     view-as alert-box error .
     1149     var-entry = "type":U.
     1150     return error VAR-ENTRY.
     1151   end.
     1152   if p-emitent-host-code <> 0 and not can-find( first ub.sysconf No-LOCK WHERE
     1153                          ub.sysconf.host-code = p-emitent-host-code) then do:
     1154     message "Нет фирмы-эмитента дисконтной карты" p-emitent-host-code
     1155     view-as alert-box error .
     1156     var-entry = "emitent-host-code":U.
     1157     return error var-entry.
     1158   end.
     1159   if pardflt-credit-card AND p-emitent-host-code = 0 then do:
     1160     message
     1161     "Глобальная дисконтная карта не может быть кредитной"
     1162     view-as alert-box error .
     1163     var-entry = "dflt-credit-card":U.
     1164     return error var-entry.
     1165   end.
     1166   if pardflt-credit-card and parlim-kr <= 0 then do:
     1167     message "Если дисконтная карта кредитная, лимит кредита должен быть положительным"
     1168     view-as alert-box error .
     1169     var-entry = "lim-kr":U.
     1170     return error var-entry.
     1171   end.
     1172   if pardflt-credit-card and pardflt-debet-card then do:
     1173     message "Карта не может быть одновременно и кредитной и дебетовой" skip
     1174     view-as alert-box error .
     1175     var-entry = "dflt-credit-card":U.
     1176     return error var-entry.
     1177   end.
     1178   if not pardflt-credit-card
     1179   AND not pardflt-debet-card
     1180   and (parfiscal-pay
     1181        or
     1182        parmixed-pay)
     1183   then do:
     1184     message "Свойста <Фискальный платеж> и <Разрешена смешанная оплата> имеют смысл только для кредитной или дебетовой карты" skip
     1185     view-as alert-box error .
     1186     var-entry = (if parfiscal-pay then "fiscal-pay":U else "mixed-pay":U).
     1187     return error var-entry.
     1188   end.
     1189   if not pardflt-credit-card
     1190   AND not pardflt-debet-card
     1191   and parpay-code <> 0  then do:
     1192     message "Свойство <Тип кассового платежа> имеет смысл только для кредитной или дебетовой карты" skip
     1193     view-as alert-box error .
     1194     var-entry = "pay-code":U.
     1195     return error var-entry.
     1196   end.
     1197   if (pardflt-credit-card
     1198   or pardflt-debet-card)
     1199   and parpay-code = 0  then do:
     1200     message "Для кредитной или дебетовой карты надо ввести код платежа" skip
     1201     view-as alert-box error .
     1202     var-entry = "pay-code":U.
     1203     return error var-entry.
     1204   end.
     1205   if parpay-code <> 0 then do:
     1206      run get-r-b in this-procedure (input p-emitent-host-code, output v-r-b-code) no-error .
     1207     find first  buf_cash-pay no-lock where
     1208               buf_cash-pay.cdpay-code = parpay-code
     1209           AND buf_cash-pay.curr-code = v-r-b-code no-error .
     1210     if not available buf_cash-pay then do:
     1211       message substitute("Не найден тип кассового платежа с кодом &1 и кодом валюты &2", parpay-code, v-r-b-code) skip
     1212       view-as alert-box error .
     1213       var-entry = "pay-code":U.
     1214       return error var-entry.
     1215     end.
     1216     if buf_Cash-pay.is-debet-card = no then do:
     1217       message substitute("Тип кассового платежа для кредитной или дебетовой карты должен иметь свойство <РАСЧЕТНАЯ КАРТА>: тип кассового платежа с кодом &1 и кодом валюты &2", parpay-code, v-r-b-code) skip
     1218       view-as alert-box error .
     1219       var-entry = "pay-code":U.
     1220       return error var-entry.
     1221     end.
     1222     if pardflt-credit-card = yes and buf_Cash-pay.is-credit = no then do:
     1223       message substitute("Тип кассового платежа для кредитной карты должен иметь свойство <В КРЕДИТ>: тип кассового платежа с кодом &1 и кодом валюты &2", parpay-code, v-r-b-code) skip
     1224       view-as alert-box error .
     1225       var-entry = "pay-code":U.
     1226       return error var-entry.
     1227     end.
     1228   end.
     1229   if parcardname-sent <> 'card':U
     1230   and parcardname-sent <> 'name':U then do:
     1231     message
     1232     substitute("Неверное значение свойства карты <ДЕРЖАТЕЛЬ КАРТЫ на кассе>: &1, может быть только &2 или &3"
     1233                ,parcardname-sent
     1234                ,'ФИО':U
     1235                ,'N карты':U
     1236                ) skip
     1237     view-as alert-box error .
     1238     var-entry = "cardname-sent":U.
     1239     return error var-entry.
     1240   end.
     1241   define variable V-VALUE-CHARACTER as character no-undo .
     1242   define variable v-ii as integer no-undo .
     1243   define variable V-STORAGE-PLACE as character no-undo .
     1244   define variable v-dtm-code as integer no-undo .
     1245   define variable V-SUM-ID as character no-undo .
     1246   define variable V-CALLER-ID as character no-undo .
     1247   define variable glog as logical no-undo .
     1248   do v-ii = 1 to num-entries(PARCUSTOM-SENT):
     1249     assign
     1250     v-value-character = entry(v-ii, PARCUSTOM-SENT)
     1251     v-storage-place = entry(1, v-value-character, chr(4))
     1252     v-dtm-code = integer(entry(2, v-value-character, chr(4)))
     1253     no-error .
     1254     if v-value-character = chr(63) then next.
     1255     find first TT0-HIST-NWS-OPTION WHERE
     1256               TT0-HIST-NWS-OPTION.db-num = 0
     1257           and tt0-hist-nws-option.table-name = v-STORAGE-PLACE
     1258           and tt0-hist-nws-option.obj-type = '':U
     1259           and tt0-hist-nws-option.obj-code = 0
     1260           and tt0-hist-nws-option.key#_one = V-dtm-code
     1261           and tt0-hist-nws-option.subject-group = 'c-dc-hist':U NO-ERROR.
     1262     IF AVAILABLE TT0-HIST-NWS-OPTION
     1263     AND TT0-HIST-NWS-OPTION.SMART-NWS >= 0 THEN DO:
     1264       message
     1265       substitute("Для пересылки на кассу выбран срез/итог объекта-операнда&1&2&1" +
     1266                  "Однако для этого операнда включена настройка смарт-пересылки через СПН:&1" +
     1267                  "в нескольких или во всех УБД данные обновляться не будут&1" +
     1268                  "Вы уверены, что хотите пересылать на кассу данный срез/итог?"
     1269                  , chr(10)
     1270                  ,dct-algo_custom-sent-description(v-value-character)
     1271                    )
     1272       view-as alert-box question buttons yes-no
     1273       update glog.
     1274       if not glog then do:
     1275         undo, return error ''.
     1276       end.
     1277     END.
     1278   END.
     1279   if entry (lookup (string(parcard-media), '0,1,2,3,4,5,6':U), 'Карта c магн.полосой,ТМ ключ,Смарт карта,Радио карта,Карта со штрихкодом,EASY FUEL,EasyFuel2':U) = "":U then do:
     1280     message
     1281     substitute("Неверный носитель для карты: &1"
     1282                ,parcard-media
     1283                ) skip
     1284     view-as alert-box error .
     1285     var-entry = "card-media":U.
     1286     return error var-entry.
     1287   end.
     1288   if parcard-media = integer('5':U) then do:
     1289   define variable is-ef-chr as character no-undo .
     1290   define variable conf-type as character no-undo .
     1291   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1292     (input  'is-ef'
     1293     ,input  ''
     1294     ,input  ''
     1295     ,input  0
     1296     ,input  ''
     1297     ,input  ''
     1298     ,input  ''
     1299     ,input  no
     1300     ,output is-ef-chr
     1301     ,output conf-type
     1302     ) no-error .
     1303     if error-status:error
     1304     or logical(is-ef-chr) = no then do:
     1305       message
     1306       substitute("В Вашей конфигурации нельзя ввести тип ДК с типом носителя &1,&2" +
     1307                 "так как не включен конфигурационный параметр is-ef"
     1308                 ,'EASY FUEL':U
     1309                 ,chr(10)
     1310                 )
     1311       view-as alert-box .
     1312       undo, return error .
     1313     end.
     1314   end.
     1315   if par-mode = 'ИЗМЕНЕНИЕ':U then do:
     1316     FIND FIRST buf_dis-card-type share-lock where
     1317               recid(buf_dis-card-type) = par-rid No-ERROR.
     1318     if not available buf_dis-card-type then do:
     1319       message
     1320       substitute("Не найден тип ДК recid &1", par-rid)
     1321       view-as alert-box error .
     1322       return error '':u.
     1323     end.
     1324     if buf_dis-card-type.card-media <> parcard-media
     1325     and (buf_dis-card-type.card-media = integer('5':U)
     1326          or
     1327          parcard-media = integer('5':U))
     1328     then do:
     1329       find first buf_dis-card no-lock where
     1330                 buf_dis-card.type = par-type
     1331             and buf_dis-card.emitent-host-code = p-emitent-host-code no-error.
     1332       if available buf_dis-card then do:
     1333          message
     1334          "Нельзя сменить тип носителя" skip
     1335          "В системе имеются ДК данного типа"
     1336          view-as alert-box  error.
     1337          return error "card-media".
     1338       end.
     1339     end.
     1340   end.
     1341   if lookup(string(pardflt-d-pcnt-method),
     1342             string('1':U + chr(44) + '2':U + chr(44) + '3':U)
     1343            ) = 0 then do:
     1344     message
     1345     "Неверное значение кода использования скидки"
     1346     view-as alert-box error .
     1347     var-entry = "dflt-d-pcnt-method":U.
     1348     return error var-entry.
     1349   end.
     1350   DO jj = 1 to num-entries(pardcbyshop):
     1351     find first ub.shop No-LOCK WHERE
     1352                ub.shop.obj-code = integer(entry(jj, pardcbyshop)) NO-ERROR.
     1353     if not avail ub.shop or (p-emitent-host-code > 0 and ub.shop.host-code <> p-emitent-host-code) then do:
     1354       message "В списке магазинов принимающие только СВОИ карты есть неверный код магазина " entry(jj, pardcbyshop)
     1355       view-as alert-box error .
     1356       var-entry = "lim-kr":U.
     1357       return error var-entry.
     1358     end.
     1359   END.
     1360   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1361   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1362     (output v-curr-r-b
     1363     )  .
     1364   if pardflt-d-pcnt-method  = integer('2':U)
     1365   OR pardflt-d-pcnt-method  = integer('3':U)  then do:
     1366     message
     1367     "ВНИМАНИЕ!" SKIP
     1368     "Использование скидок на итог имеет смысл только при условии применения POS NCR или IBS TH POS" SKIP
     1369     "Продолжить?"
     1370     view-as alert-box QUESTION Buttons YES-NO
     1371     update loc#log .
     1372     if not loc#log then do:
     1373       var-entry = "dflt-d-pcnt-method":U.
     1374       return error var-entry.
     1375     end.
     1376   end.
     1377   if parcheck-by-mask
     1378   and parho-join then do:
     1379     run check-mask-correct-ho-join in this-procedure (
     1380                                                   input p-emitent-host-code
     1381                                                 ,input p-type
     1382                                                 ,input "":U
     1383                                                 ,input 0
     1384                                                 ,input "":U
     1385                                                 ,input 0
     1386                                                 ,output v-ok
     1387                                                 ) no-error .
     1388     if error-status:error then do:
     1389       message substitute("Невозможно установить для ДК свойство&1<Проверка № карт по маске> с опцией <Привязка к фирме/объекту:&1&2 &3"
     1390                               , chr(10)
     1391                               , error-status:get-message(1)
     1392                               , return-value
     1393                               )
     1394       view-as alert-box error .
     1395       var-entry = "mask":U.
     1396       undo, return error var-entry.
     1397     end.
     1398     if not v-ok then do:
     1399       message substitute("Невозможно установить для ДК свойство&1<Проверка № карт по маске> с опцией <Привязка к фирме/объекту:&1&2"
     1400                               , chr(10)
     1401                               , return-value
     1402                               )
     1403       view-as alert-box error .
     1404       var-entry = "mask":U.
     1405       undo, return error var-entry.
     1406     end.
     1407   end.
     1408   for each tt0-root-dis-card-type:
     1409     delete tt0-root-dis-card-type.
     1410   end.
     1411   _MAIN:
     1412   do transaction
     1413   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1414   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
     1415   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
     1416   :
     1417      if not valid-handle(v-cmd-proc-handle ) then dO:
     1418       run nws/cmd-bush.p persistent set v-cmd-proc-handle no-error .
     1419       if error-status :error
     1420       then do:
     1421         delete procedure v-cmd-proc-handle .
     1422         undo _main, return error substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
     1423                                             "&5&4&6"
     1424                                             ,vss-workfile
     1425                                             ,vss-revision
     1426                                             ,vss-description
     1427                                             ,chr(10)
     1428                                             ,error-status:get-message(1)
     1429                                             ,return-value ).
     1430       end.
     1431     end.
     1432     assign
     1433     v-command =  substitute("&2&1&3&1&4"
     1434                            , chr(6)
     1435                            , 'cmd-dct-send':U
     1436                            , p-emitent-host-code
     1437                            , p-type
     1438                            ).
     1439     run begin-create-command in v-cmd-proc-handle
     1440       (input v-command
     1441       ,input "":U
     1442       ,output v-cmd-code
     1443       ) no-error.
     1444     if error-status :error
     1445     then do:
     1446       message
     1447         vss-workfile vss-revision vss-description skip
     1448         substitute( "Ошибка при создании команды &1", 'cmd-dct-send':U ) skip
     1449         error-status :get-message(1) skip
     1450         return-value skip
     1451         view-as alert-box error .
     1452       delete procedure v-cmd-proc-handle .
     1453       undo _main, return error return-value .
     1454     end.
     1455     create tt0-root-dis-card-type.
     1456     if par-mode = 'ДОБАВЛЕНИЕ':U then do:
     1457       if can-find( FIRST ub.dis-card-type No-LOCK where
     1458                         ub.dis-card-type.emitent-host-code = p-emitent-host-code AND
     1459                         ub.dis-card-type.type = p-type AND
     1460                         ub.dis-card-type.host-code = parhost-code AND
     1461                         ub.dis-card-type.obj-type = parobj-type AND
     1462                         ub.dis-card-type.obj-code = parobj-code
     1463                           ) then do:
     1464         delete procedure v-cmd-proc-handle .
     1465         message (if p-emitent-host-code = 0
     1466                 then "Уже есть такой тип глобальной дисконтной карты "
     1467                 else ("Уже есть такой тип дисконтной карты на фирме " + string(p-emitent-host-code)))
     1468         view-as alert-box ERROR .
     1469         var-entry = "type":U.
     1470         undo _main, return error var-entry.
     1471       end.
     1472       if can-find( FIRST ub.dis-card-type No-LOCK where
     1473                         ub.dis-card-type.type = p-type AND
     1474                         ub.dis-card-type.host-code = parhost-code AND
     1475                         ub.dis-card-type.obj-type = parobj-type AND
     1476                         ub.dis-card-type.obj-code = parobj-code ) then do:
     1477         delete procedure v-cmd-proc-handle .
     1478         message "Уже есть такой тип дисконтной карты "
     1479                 (if p-emitent-host-code = 0
     1480                 then " - глобальный "
     1481                 else (" - на фирме " + string(p-emitent-host-code)))
     1482         view-as alert-box ERROR .
     1483         var-entry = "type":U.
     1484         undo _main, return error var-entry.
     1485       end.
     1486       CREATE buf_dis-card-type.
     1487       assign
     1488       buf_dis-card-type.emitent-host-code = p-emitent-host-code
     1489       buf_dis-card-type.type = p-type
     1490       buf_dis-card-type.host-code = parhost-code
     1491       buf_dis-card-type.obj-type = parobj-type
     1492       buf_dis-card-type.obj-code = parobj-code
     1493       par-rid = recid( buf_dis-card-type )
     1494       .
     1495       define variable v-uniq-key-rec as character no-undo .
     1496       run gen-key-rec in this-procedure ( input 'dis-card-type':U
     1497                                         ,input buffer buf_dis-card-type:handle
     1498                                         ,output v-uniq-key-rec).
     1499       assign
     1500       buf_dis-card-type.uniq-key-rec = v-uniq-key-rec
     1501       p-uniq-key-rec = v-uniq-key-rec
     1502       .
     1503     end.
     1504     else do:
     1505       FIND FIRST buf_dis-card-type exclusive-lock where
     1506                 recid(buf_dis-card-type) = par-rid No-ERROR.
     1507       if not available buf_dis-card-type then return error '':u.
     1508       if buf_dis-card-type.uniq-key-rec <> p-uniq-key-rec then do:
     1509         delete procedure v-cmd-proc-handle .
     1510         message
     1511         substitute("Неверное значение параметра p-uniq-key-rec &1", p-uniq-key-rec)
     1512         view-as alert-box error.
     1513         undo _main, return error .
     1514       end.
     1515       buffer-copy buf_dis-card-type to tt0-root-dis-card-type.
     1516     end.
     1517     assign
     1518     buf_dis-card-type.d-pcnt-byshop = pard-pcnt-byshop
     1519     buf_dis-card-type.dflt-d-pcnt-method = pardflt-d-pcnt-method
     1520     buf_dis-card-type.dflt-credit-card = pardflt-credit-card
     1521     buf_dis-card-type.dflt-debet-card = pardflt-debet-card
     1522     buf_dis-card-type.dflt-staff-card = pardflt-staff-card
     1523     buf_dis-card-type.fiscal-pay = parfiscal-pay
     1524     buf_dis-card-type.mixed-pay = parmixed-pay
     1525     buf_dis-card-type.card-media = parcard-media
     1526     buf_dis-card-type.cardname-sent = parcardname-sent
     1527     buf_dis-card-type.custom-sent = parcustom-sent
     1528     buf_dis-card-type.pay-code = parpay-code
     1529     buf_dis-card-type.lim-kr = parlim-kr
     1530     buf_dis-card-type.dc-pfx = pardc-pfx
     1531     buf_dis-card-type.dcbyshop = pardcbyshop
     1532     buf_dis-card-type.check-by-mask = (if parcheck-by-mask then 1 else 0)
     1533     buf_dis-card-type.ho-join = (if parho-join then 1 else 0)
     1534     .
     1535     buffer-compare tt0-root-dis-card-type to buf_dis-card-type
     1536     case-sensitive
     1537     save result in v-cmp-loc.
     1538     v-cmp = v-cmp and v-cmp-loc.
     1539     if not v-cmp-loc then do:
     1540        buffer-copy buf_dis-card-type to tt0-root-dis-card-type .
     1541       run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'dis-card-type':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_dis-card-type:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo _main, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'dis-card-type':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1542     end.
     1543     release buf_dis-card-type no-error .
     1544     if error-status:error then do:
     1545       delete procedure v-cmd-proc-handle .
     1546       message
     1547       "Ошибка при сохранении записи ТИП ДИСКОНТНОЙ КАРТЫ" skip
     1548       error-status:get-message(1) skip
     1549       return-value
     1550       view-as alert-box error .
     1551       undo _main, return error .
     1552     end.
     1553     for each buf_tt0-dis-dct-rule
     1554       on ERROR UNDO _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1555       ON STOP undo _MAIN, return error '':u:
     1556       if not (buf_tt0-dis-dct-rule.discnt-role = 'def-pcnt':U
     1557               or
     1558               buf_tt0-dis-dct-rule.discnt-role = 'def-cash-pcnt':U
     1559               or
     1560               buf_tt0-dis-dct-rule.discnt-role = 'def-categ':U) then next.
     1561       find first buf_dis-dct-rule where
     1562               buf_dis-dct-rule.emitent-host-code = buf_tt0-dis-dct-rule.emitent-host-code
     1563           and buf_dis-dct-rule.type = buf_tt0-dis-dct-rule.type
     1564           and buf_dis-dct-rule.host-code = buf_tt0-dis-dct-rule.host-code
     1565           and buf_dis-dct-rule.obj-type = buf_tt0-dis-dct-rule.obj-type
     1566           and buf_dis-dct-rule.obj-code = buf_tt0-dis-dct-rule.obj-code
     1567           and buf_dis-dct-rule.pos-type = buf_tt0-dis-dct-rule.pos-type
     1568           and buf_dis-dct-rule.discnt-role = buf_tt0-dis-dct-rule.discnt-role
     1569           and buf_dis-dct-rule.nonunique = buf_tt0-dis-dct-rule.nonunique
     1570           no-error.
     1571       if not available buf_dis-dct-rule then do:
     1572         v-cmp-loc = no.
     1573         create buf_dis-dct-rule.
     1574         buffer-copy buf_tt0-dis-dct-rule to buf_dis-dct-rule.
     1575       end.
     1576       else do:
     1577         buffer-compare
     1578         buf_tt0-dis-dct-rule except emitent-host-code type
     1579         to buf_dis-dct-rule
     1580         case-sensitive
     1581         save result in v-cmp-loc.
     1582         if not v-cmp-loc then do:
     1583           assign
     1584           buf_dis-dct-rule.rule-num = buf_tt0-dis-dct-rule.rule-num
     1585           buf_dis-dct-rule.rl-root = buf_tt0-dis-dct-rule.rl-root
     1586           buf_dis-dct-rule.templ-rl-root = buf_tt0-dis-dct-rule.templ-rl-root
     1587           buf_dis-dct-rule.time-templ-rl-root = buf_tt0-dis-dct-rule.time-templ-rl-root
     1588           buf_dis-dct-rule.nonunique = buf_tt0-dis-dct-rule.nonunique
     1589           .
     1590         end.
     1591       end.
     1592       if not v-cmp-loc then do:
     1593         run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'dis-dct-rule':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_dis-dct-rule:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo _main, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'dis-dct-rule':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1594       end.
     1595     end.
     1596     _dis-dct-rule:
     1597     for each buf_dis-dct-rule where
     1598               buf_dis-dct-rule.emitent-host-code = p-emitent-host-code
     1599           and buf_dis-dct-rule.type = p-type
     1600     on ERROR UNDO _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1601     ON STOP undo _MAIN, return error '':u:
     1602       if not (buf_dis-dct-rule.discnt-role = 'def-pcnt':U
     1603               or
     1604               buf_dis-dct-rule.discnt-role = 'def-cash-pcnt':U
     1605               or
     1606               buf_dis-dct-rule.discnt-role = 'def-categ':U) then next.
     1607        if not pard-pcnt-byshop and
     1608        not ( buf_dis-dct-rule.host-code = 0
     1609              and
     1610              buf_dis-dct-rule.obj-type = '':U
     1611              and
     1612              buf_dis-dct-rule.obj-code = 0) then do:
     1613            run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'dis-dct-rule':U                                                                                          ,input '+delete'                                                                                         ,input buffer buf_dis-dct-rule:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo _main, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'dis-dct-rule':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1614          delete buf_dis-dct-rule.
     1615          next _dis-dct-rule.
     1616        end.
     1617        find first buf_tt0-dis-dct-rule where
     1618               buf_tt0-dis-dct-rule.emitent-host-code = buf_dis-dct-rule.emitent-host-code
     1619           and buf_tt0-dis-dct-rule.type = buf_dis-dct-rule.type
     1620           and buf_tt0-dis-dct-rule.host-code = buf_dis-dct-rule.host-code
     1621           and buf_tt0-dis-dct-rule.obj-type = buf_dis-dct-rule.obj-type
     1622           and buf_tt0-dis-dct-rule.obj-code = buf_dis-dct-rule.obj-code
     1623           and buf_tt0-dis-dct-rule.pos-type = buf_dis-dct-rule.pos-type
     1624           and buf_tt0-dis-dct-rule.discnt-role = buf_dis-dct-rule.discnt-role
     1625           and buf_tt0-dis-dct-rule.nonunique = buf_dis-dct-rule.nonunique
     1626           no-error .
     1627        if not available buf_tt0-dis-dct-rule then do:
     1628            run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'dis-dct-rule':U                                                                                          ,input '+delete'                                                                                         ,input buffer buf_dis-dct-rule:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo _main, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'dis-dct-rule':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1629          delete buf_dis-dct-rule.
     1630        end.
     1631     end.
     1632     if pard-pcnt-byshop = no then do:
     1633       for each term_dis-card-type where
     1634               term_dis-card-type.emitent-host-code = p-emitent-host-code
     1635           and term_dis-card-type.type = p-type
     1636     on ERROR UNDO _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1637     ON STOP undo _MAIN, return error '':u:
     1638       if term_dis-card-type.host-code = 0
     1639       and term_dis-card-type.obj-type = '':U
     1640       and term_dis-card-type.obj-code = 0 then next.
     1641            run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'dis-card-type':U                                                                                          ,input '+delete'                                                                                         ,input buffer term_dis-card-type:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo _main, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'dis-card-type':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1642          delete term_dis-card-type.
     1643        end.
     1644     end.
     1645     else do:
     1646       for each buf_dis-dct-rule where
     1647                 buf_dis-dct-rule.emitent-host-code = p-emitent-host-code
     1648             and buf_dis-dct-rule.type = p-type
     1649       on ERROR UNDO _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1650       ON STOP undo _MAIN, return error '':u:
     1651         if not (buf_dis-dct-rule.discnt-role = 'def-pcnt':U
     1652                 or
     1653                 buf_dis-dct-rule.discnt-role = 'def-cash-pcnt':U
     1654                 or
     1655                 buf_dis-dct-rule.discnt-role = 'def-categ':U) then next.
     1656         if ( buf_dis-dct-rule.host-code = 0
     1657               and
     1658               buf_dis-dct-rule.obj-type = '':U
     1659               and
     1660               buf_dis-dct-rule.obj-code = 0) then do:
     1661           next.
     1662         end.
     1663         v-cmp-loc = yes.
     1664         find first term_dis-card-type where
     1665                   term_dis-card-type.emitent-host-code = p-emitent-host-code
     1666               and term_dis-card-type.type = p-type
     1667               and term_dis-card-type.host-code = buf_Dis-dct-rule.host-code
     1668               and term_dis-card-type.obj-type = buf_Dis-dct-rule.obj-type
     1669               and term_dis-card-type.obj-code = buf_Dis-dct-rule.obj-code
     1670         no-error .
     1671         if not available term_dis-card-type then do:
     1672           v-cmp-loc = no.
     1673           create term_dis-card-type.
     1674           buffer-copy tt0-root-dis-card-type
     1675           except host-code obj-type obj-code
     1676           to term_dis-card-type
     1677           assign
     1678           term_dis-card-type.host-code = buf_dis-dct-rule.host-code
     1679           term_dis-card-type.obj-type = buf_dis-dct-rule.obj-type
     1680           term_dis-card-type.obj-code = buf_dis-dct-rule.obj-code
     1681           .
     1682           run gen-key-rec in this-procedure ( input 'dis-card-type':U
     1683                                             ,input buffer term_dis-card-type:handle
     1684                                             ,output term_dis-card-type.uniq-key-rec).
     1685         end.
     1686         v-cmp = v-cmp and v-cmp-loc.
     1687         if not v-cmp-loc then do:
     1688                   run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'dis-card-type':U                                                                                          ,input '+update'                                                                                         ,input buffer term_dis-card-type:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo _main, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'dis-card-type':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1689         end.
     1690       end.
     1691     end.
     1692     for each buf_db no-lock,
     1693        each buf_hist-nws-option where
     1694               buf_hist-nws-option.db-num = buf_db.db-num
     1695           and buf_hist-nws-option.subject-group = 'c-dc-hist':U
     1696           and buf_hist-nws-option.host-code = p-emitent-host-code
     1697           AND buf_hist-nws-option.charkey_one = p-type
     1698           AND buf_hist-nws-option.obj-type = '':U
     1699           AND buf_hist-nws-option.obj-code = 0
     1700       on ERROR UNDO _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1701       ON STOP undo _MAIN, return error '':u:
     1702       find first tt0-hist-nws-option no-lock where
     1703                 tt0-hist-nws-option.db-num = 0
     1704             and tt0-hist-nws-option.table-name = buf_hist-nws-option.table-name
     1705             and tt0-hist-nws-option.host-code = buf_hist-nws-option.host-code
     1706             AND tt0-hist-nws-option.charkey_one = buf_hist-nws-option.charkey_one
     1707             AND tt0-hist-nws-option.obj-type = buf_hist-nws-option.obj-type
     1708             AND tt0-hist-nws-option.obj-code = buf_hist-nws-option.obj-code
     1709             AND tt0-hist-nws-option.key#_one = buf_hist-nws-option.key#_one no-error .
     1710       if not available tt0-hist-nws-option then do:
     1711            run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'hist-nws-option':U                                                                                          ,input '+delete'                                                                                         ,input buffer buf_hist-nws-option:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo _main, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'hist-nws-option':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1712         delete buf_hist-nws-option.
     1713       end.
     1714      end.
     1715     for each tt0-hist-nws-option
     1716     on ERROR UNDO _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1717     ON STOP undo _MAIN, return error '':u:
     1718       for each buf_db no-lock
     1719       on ERROR UNDO _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1720       ON STOP undo _MAIN, return error '':u:
     1721         find first buf_hist-nws-option where
     1722                   buf_hist-nws-option.db-num = buf_db.db-num
     1723               and buf_hist-nws-option.table-name = tt0-hist-nws-option.table-name
     1724               and buf_hist-nws-option.host-code = tt0-hist-nws-option.host-code
     1725               AND buf_hist-nws-option.charkey_one = tt0-hist-nws-option.charkey_one
     1726               AND buf_hist-nws-option.obj-type = tt0-hist-nws-option.obj-type
     1727               AND buf_hist-nws-option.obj-code = tt0-hist-nws-option.obj-code
     1728               AND buf_hist-nws-option.key#_one = tt0-hist-nws-option.key#_one no-error .
     1729         if not available buf_hist-nws-option
     1730         then do:
     1731           find first buf_hist-nws-option where
     1732                     buf_hist-nws-option.db-num = 0
     1733                 and buf_hist-nws-option.table-name = tt0-hist-nws-option.table-name
     1734                 and buf_hist-nws-option.host-code = tt0-hist-nws-option.host-code
     1735                 AND buf_hist-nws-option.charkey_one = tt0-hist-nws-option.charkey_one
     1736                 AND buf_hist-nws-option.obj-type = tt0-hist-nws-option.obj-type
     1737                 AND buf_hist-nws-option.obj-code = tt0-hist-nws-option.obj-code
     1738                 AND buf_hist-nws-option.key#_one = tt0-hist-nws-option.key#_one no-error .
     1739           if available buf_hist-nws-option then do:
     1740             v-last = buf_hist-nws-option.hn-id.
     1741           end.
     1742           else do:
     1743             v-last = next-value(s-hn-id, ub).
     1744             create buf0_hist-nws-option.
     1745             assign
     1746             buf0_hist-nws-option.db-num = 0
     1747             buf0_hist-nws-option.table-name = tt0-hist-nws-option.table-name
     1748             buf0_hist-nws-option.host-code = tt0-hist-nws-option.host-code
     1749             buf0_hist-nws-option.charkey_one = tt0-hist-nws-option.charkey_one
     1750             buf0_hist-nws-option.obj-type = tt0-hist-nws-option.obj-type
     1751             buf0_hist-nws-option.obj-code = tt0-hist-nws-option.obj-code
     1752             buf0_hist-nws-option.key#_one = tt0-hist-nws-option.key#_one
     1753             buf0_hist-nws-option.option-descr = tt0-hist-nws-option.option-descr
     1754             buf0_hist-nws-option.subject-group = 'c-dc-hist':U
     1755             buf0_hist-nws-option.hn-id = v-last
     1756             buf0_hist-nws-option.hist-from-prim = tt0-hist-nws-option.hist-from-prim
     1757             buf0_hist-nws-option.hist-to-nws = tt0-hist-nws-option.hist-to-nws
     1758             buf0_hist-nws-option.nws-to-cd = tt0-hist-nws-option.nws-to-cd
     1759             buf0_hist-nws-option.nws-to-hist = tt0-hist-nws-option.nws-to-hist
     1760             buf0_hist-nws-option.smart-nws = tt0-hist-nws-option.smart-nws
     1761             buf0_hist-nws-option.get-hist-from-nws =  tt0-hist-nws-option.get-hist-from-nws
     1762             .
     1763            run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'hist-nws-option':U                                                                                          ,input '+update'                                                                                         ,input buffer buf0_hist-nws-option:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo _main, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'hist-nws-option':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1764           end.
     1765           assign
     1766           v-cmp-loc = no
     1767           v-cmp = v-cmp and v-cmp-loc
     1768           .
     1769           if buf_db.db-num > 0 then do:
     1770             create buf_hist-nws-option.
     1771             assign
     1772             buf_hist-nws-option.db-num = buf_db.db-num
     1773             buf_hist-nws-option.table-name = tt0-hist-nws-option.table-name
     1774             buf_hist-nws-option.host-code = tt0-hist-nws-option.host-code
     1775             buf_hist-nws-option.charkey_one = tt0-hist-nws-option.charkey_one
     1776             buf_hist-nws-option.obj-type = tt0-hist-nws-option.obj-type
     1777             buf_hist-nws-option.obj-code = tt0-hist-nws-option.obj-code
     1778             buf_hist-nws-option.key#_one = tt0-hist-nws-option.key#_one
     1779             buf_hist-nws-option.option-descr = tt0-hist-nws-option.option-descr
     1780             buf_hist-nws-option.subject-group = 'c-dc-hist':U
     1781             buf_hist-nws-option.hn-id = v-last
     1782             .
     1783           end.
     1784         end.
     1785         if available buf_hist-nws-option then do:
     1786           buffer-compare tt0-hist-nws-option
     1787           except db-num hn-id
     1788           to buf_hist-nws-option
     1789           case-sensitive
     1790           save result in v-cmp-loc.
     1791           buffer-copy tt0-hist-nws-option except hn-id db-num
     1792           to buf_hist-nws-option
     1793           .
     1794           if not v-cmp-loc then do:
     1795                   run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'hist-nws-option':U                                                                                          ,input '+update'                                                                                         ,input buffer buf_hist-nws-option:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo _main, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'hist-nws-option':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
     1796           end.
     1797         end.
     1798       end.
     1799     end.
     1800     run rul/ruprcall.p (
     1801                          input 'dis-card-type':U
     1802                         ,input p-uniq-key-rec
     1803                         ,input ('rp-by-call':U + chr(44) + 'rule-by-call':U + chr(44) + 'rule-call-param':U)
     1804                         ,input v-cmd-proc-handle
     1805                         ,input v-cmd-code
     1806                         ,INPUT TABLE tt0-rp-by-call
     1807                         ,INPUT TABLE tt0-rule-by-call
     1808                         ,INPUT TABLE tt0-rule-call-param) no-error .
     1809     if error-status:error then do:
     1810       delete procedure v-cmd-proc-handle .
     1811       message
     1812       "Ошибка при сохранении привязок профайлов и/правил для записи ТИП ДИСКОНТНОЙ КАРТЫ" skip
     1813       error-status:get-message(1) skip
     1814       return-value
     1815       view-as alert-box error .
     1816       undo _main, return error .
     1817     end.
     1818     define variable v-db-list as character no-undo .
     1819     for each buf_db no-lock
     1820     where buf_db.db-num > 0
     1821     :
     1822       assign
     1823       v-db-list = v-db-list + chr(1) + string(buf_db.db-num).
     1824     end.
     1825     v-db-list = trim(v-db-list, chr(1)).
     1826     run send-command in v-cmd-proc-handle
     1827       ( input v-cmd-code
     1828         ,input v-db-list
     1829         ) no-error .
     1830     if error-status:error then do:
     1831       delete procedure v-cmd-proc-handle .
     1832       message
     1833       vss-workfile vss-revision vss-description skip
     1834       substitute( "Ошибка при отсылке команды &1", 'cmd-dct-send':U ) skip
     1835       error-status :get-message(1) skip
     1836       return-value skip
     1837       view-as alert-box error .
     1838       undo _main, return error .
     1839     end.
     1840     delete procedure v-cmd-proc-handle .
     1841   END.
     1842   RETURN '':u.
     1843   PROCEDURE get-r-b :
     1844   define input parameter p-emitent-host-code like ub.dis-card.emitent-host-code no-undo .
     1845   DEFINE OUTPUT PARAMETER p-r-b-curr-code LIKE ub.currency.curr-code NO-UNDO.
     1846   define variable v-curr-r-b  as character no-undo .
     1847   DEFINE BUFFER buf_sysconf FOR ub.sysconf.
     1848   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1849   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1850     (output v-curr-r-b
     1851     ) no-error .
     1852   if p-emitent-host-code = 0
     1853   and v-curr-r-b = 'base':U
     1854   then do:
     1855     ASSIGN
     1856     p-r-b-curr-code = 0
     1857     .
     1858   end.
     1859   else do:
     1860     IF p-emitent-host-code = 0 or
     1861        v-curr-r-b = 'rubl':U
     1862        THEN DO:
     1863           ASSIGN
     1864           p-r-b-curr-code = 0
     1865           .
     1866       END.
     1867       ELSE DO:
     1868          FIND FIRST buf_sysconf NO-LOCK WHERE
     1869                    buf_sysconf.host-code = p-emitent-host-code .
     1870          ASSIGN
     1871          p-r-b-curr-code = buf_sysconf.base-code
     1872           .
     1873     END.
     1874   end.
     1875   END PROCEDURE.
