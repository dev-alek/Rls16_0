      471   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      472   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      473   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      474   on help of frame Dialog-Frame
      475   do:
      476     run gbl/app_help.p
      477       (input this-procedure :file-name
      478       ,input ''
      479       ,input ?
      480       ) no-error.
      481     if error-status :error then do:
      482       message
      483         "Ошибка при вызове помощи"
      484         error-status :get-message(1)
      485         view-as alert-box .
      486     end.
      487   end.
      488   run minbtn-set in this-procedure .
      489   on choose of b-help in frame Dialog-Frame
      490   do:
      491     apply "help":u to frame Dialog-Frame .
      492   end.
      493   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      494   procedure minbtn-set :
      495       do
      496           on error undo, return error return-value
      497           :
      498           define variable ii              as integer       no-undo .
      499           define variable fh              as widget-handle no-undo .
      500           define variable hh              as widget-handle no-undo .
      501           define variable v-h             as handle        extent 4 no-undo .
      502           define variable v-name-button   as character     no-undo .
      503           define variable v-help-old-x    as decimal       no-undo .
      504           define variable v-help-old-y    as decimal       no-undo .
      505           define variable v-help-old-size as decimal       no-undo .
      506           define variable v-frame-width   as decimal       no-undo .
      507           define variable jj              as integer       no-undo .
      508           do
      509               on error undo, return error
      510               :
      511               assign
      512                   v-frame-width = frame Dialog-Frame:width - 0.3
      513                   fh            = frame Dialog-Frame:first-child
      514                   hh            = fh:first-child
      515                   ii            = 1
      516                   .
      517               do while valid-handle(hh):
      518                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      519                   do:
      520                       case lc(hh:name) :
      521                           when "b-help" then
      522                               do:
      523                                   hh:load-image-up("cmp/b-help.bmp":u) .
      524                                   hh:load-image-down("cmp/b-help.bmp":u) .
      525                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      526                                   hh:TOOLTIP = "Помощь" .
      527                                   v-help-old-x = hh:column .
      528                                   v-help-old-y = hh:row    .
      529                                   v-help-old-size = hh:width .
      530                                   hh:width-chars = 2.5 .
      531                               end.
      532                           when "b-print" then
      533                               do:
      534                                   hh:load-image("cmp/b-print.bmp":u) .
      535                                   hh:TOOLTIP = "Печать" .
      536                                   v-h[ii] = hh:handle .
      537                                   ii = ii + 1 .
      538                                   hh:width-chars = 3 .
      539                               end.
      540                           when "b-history" or
      541                           when "b-hist" then
      542                               do:
      543                                   hh:load-image("cmp/b-hist.bmp":u) .
      544                                   hh:TOOLTIP = "История" .
      545                                   v-h[ii] = hh:handle .
      546                                   ii = ii + 1 .
      547                                   hh:width-chars = 3 .
      548                               end.
      549                           when "b-sch" then
      550                               do:
      551                                   hh:load-image("cmp/b-sch.bmp":u) .
      552                                   hh:TOOLTIP = "Установка Фильтра" .
      553                                   v-h[ii] = hh:handle .
      554                                   ii = ii + 1 .
      555                                   hh:width-chars = 3 .
      556                               end.
      557                           when "b-hist-user" then
      558                               do:
      559                                   hh:load-image("cmp/b-hist.bmp":u) .
      560                                   hh:TOOLTIP = "История пользователя" .
      561                                   ii = ii + 1 .
      562                               end.
      563                       end case.
      564                   end.
      565                   hh = hh:next-sibling.
      566               end.
      567               b-help:column = v-frame-width - b-help:width-chars.
      568               jj = 0.
      569               repeat ii = 4 to 1 by -1 :
      570                   if valid-handle (v-h[ii] ) then
      571                   do:
      572                       jj  = jj + 1 .
      573                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      574                       v-h[ii]:row    = v-help-old-y .
      575                   end.
      576               end.
      577           end.
      578       end.
      579   end procedure.
      580   MAIN-BLOCK:
      581   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      582      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      583    if p-mode <> 'ПРОСМОТР':U
      584    then do:
      585       message
      586       vss-workfile vss-revision vss-description skip
      587       "Неверное значение параметров вызова p-mode"  p-mode
      588       view-as alert-box ERROR.
      589       undo, return error.
      590    end.
      591   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      592   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      593     (output v-db-num
      594     )  .
      595     for each tt-c-fin-schet:
      596           delete tt-c-fin-schet.
      597       end.
      598     find first locked_c-fin-schet no-lock where
      599                       recid(locked_c-fin-schet) = p-doc-rec.
      600     if not available locked_c-fin-schet then do:
      601       message
      602       vss-workfile vss-revision vss-description skip
      603       "Не найдена запись БАНК"
      604       view-as alert-box error .
      605       undo, return error.
      606     end.
      607     create tt-c-fin-schet.
      608     buffer-copy locked_c-fin-schet to tt-c-fin-schet.
      609     RUN MYEnable.
      610     WAIT-FOR GO OF FRAME Dialog-Frame.
      611   END.
      612   RUN disable_UI.
      613   PROCEDURE disable_UI :
      614     HIDE FRAME Dialog-Frame.
      615   END PROCEDURE.
      616   PROCEDURE enable_UI :
      617     DISPLAY f-host-name f-cli-name f-bank-name F-otdel f-bik f-curr-abbr
      618         WITH FRAME Dialog-Frame.
      619     IF AVAILABLE tt-c-fin-schet THEN
      620       DISPLAY tt-c-fin-schet.host-code tt-c-fin-schet.code-schet
      621             tt-c-fin-schet.cli-code tt-c-fin-schet.cli-type
      622             tt-c-fin-schet.code-bank tt-c-fin-schet.c-schet
      623             tt-c-fin-schet.curr-code tt-c-fin-schet.r-schet tt-c-fin-schet.PS
      624         WITH FRAME Dialog-Frame.
      625     ENABLE B-exit b-quit B-Help tt-c-fin-schet.cli-code tt-c-fin-schet.cli-type
      626            f-cli-name tt-c-fin-schet.code-bank F-otdel tt-c-fin-schet.c-schet
      627            tt-c-fin-schet.curr-code f-curr-abbr tt-c-fin-schet.r-schet
      628            tt-c-fin-schet.PS
      629         WITH FRAME Dialog-Frame.
      630     VIEW FRAME Dialog-Frame.
      631   END PROCEDURE.
      632   PROCEDURE MyEnable :
      633   find first X_clients no-lock where
      634               X_clients.obj-type = 'орг':U
      635           AND X_clients.obj-code = p-host-code.
      636     find first X_schet-clients no-lock where
      637                 X_schet-clients.obj-type = tt-c-fin-schet.cli-type
      638             AND X_schet-clients.obj-code = tt-c-fin-schet.cli-code.
      639     find first X_fin-bank no-lock where
      640                 X_fin-bank.host-code = tt-c-fin-schet.host-code
      641             AND X_fin-bank.code-bank = tt-c-fin-schet.code-bank.
      642     find first X_currency no-lock where
      643                 X_currency.curr-code = tt-c-fin-schet.curr-code.
      644     DISPLAY
      645     X_clients.obj-name @  f-host-name
      646      WITH FRAME Dialog-Frame.
      647     DISPLAY
      648     tt-c-fin-schet.host-code
      649     tt-c-fin-schet.code-schet
      650     tt-c-fin-schet.cli-type
      651     tt-c-fin-schet.cli-code
      652     X_schet-clients.obj-name @ f-cli-name
      653     X_fin-bank.bank-name @ f-bank-name
      654     X_fin-bank.otdel @ f-otdel
      655     X_fin-bank.bik @ f-bik
      656     X_currency.curr-abbr @ f-curr-abbr
      657     tt-c-fin-schet.curr-code
      658     tt-c-fin-schet.c-schet
      659     tt-c-fin-schet.r-schet
      660     tt-c-fin-schet.PS
      661     WITH FRAME Dialog-Frame .
      662   if p-mode = 'ПРОСМОТР':U then do:
      663   assign
      664   b-quit:label = "&Выход"
      665   .
      666   hide
      667   b-exit in frame Dialog-Frame.
      668   end.
      669   ENABLE
      670   b-quit
      671   B-Help
      672   WITH FRAME Dialog-Frame .
      673   VIEW FRAME Dialog-Frame .
      674   END PROCEDURE.
