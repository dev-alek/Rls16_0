        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input parameter p-wth-code as integer no-undo .
        6   define input parameter p-par-code as integer no-undo .
        7   define input parameter p-par-val  as integer no-undo .
        8   define input parameter p-par-feat as character no-undo .
        9   define input parameter p-par-rate as decimal no-undo .
       10   define input parameter p-par-unit as character no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: wth-par1.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: ref/wth-par1.p $":U .
       16   define variable vss-description as character no-undo init "Сохранение номинала МЦ".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable v-mess as character no-undo .
       87   define buffer buf_wealth for ub.wealth.
       88   define buffer buf_wth-par for ub.wth-par.
       89   if p-mode <> 'ДОБАВЛЕНИЕ':U
       90   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       91     message vss-workfile vss-revision vss-description skip
       92             "Неверный параметр p-mode - " p-mode
       93     view-as alert-box error .
       94     return error '':u.
       95   end.
       96   if g#db-num <> 0 then do:
       97     message vss-workfile vss-revision vss-description skip
       98             "Запрещено вызывать процедуру в УБД"
       99     view-as alert-box error .
      100     return error '':u.
      101   end.
      102   main-block:
      103   do
      104   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      105   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      106   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      107   :
      108     find first buf_wealth no-lock where
      109             buf_wealth.wth-code = p-wth-code no-error .
      110     if not available buf_wealth then do:
      111       v-mess = substitute("Не найдена МЦ").
      112       run err-mess in this-procedure ( input-output v-mess).
      113       return error (if p-silent = yes then v-mess else 'wth-code':U).
      114     end.
      115     if p-par-val = ?
      116     or p-par-val = 0 then do:
      117       v-mess = "Не определено значение номинала" .
      118       run err-mess in this-procedure ( input-output v-mess).
      119       return error (if p-silent = yes then v-mess else 'par-val':U).
      120     end.
      121     if p-par-rate = ?
      122     or p-par-rate = 0 then do:
      123       v-mess = "Не определен коэффициент" .
      124       run err-mess in this-procedure ( input-output v-mess).
      125       return error (if p-silent = yes then v-mess else 'par-rate':U).
      126     end.
      127     if (p-par-feat = "" or p-par-feat = ? )
      128     and buf_wealth.is-money then do:
      129       v-mess = substitute("Для материальных ценностей - денежных средств или имеющих денежный эквивалент&1" +
      130                           "необходимо указать дополнительный признак"
      131                           , chr(10)).
      132       run err-mess in this-procedure ( input-output v-mess).
      133       return error (if p-silent = yes then v-mess else 'par-feat':U).
      134     end.
      135     if buf_wealth.is-money = no then do:
      136       if p-par-unit = ? or p-par-unit = "" then do:
      137         v-mess = substitute("Укажите ед. изм. номинала или выберите ее из справочника единиц измерения").
      138         run err-mess in this-procedure ( input-output v-mess).
      139         return error (if p-silent = yes then v-mess else 'par-unit':U).
      140       end.
      141       if (p-par-rate <> p-par-val)
      142       AND p-par-unit = buf_wealth.unit-base
      143       then do:
      144         v-mess = substitute("Ед. изм. номинала совпадает с базовой ед.изм. МЦ, а коэффициент не равен значению номинала").
      145         run err-mess in this-procedure ( input-output v-mess).
      146         return error (if p-silent = yes then v-mess else 'par-unit':U).
      147       end.
      148     end.
      149     else do:
      150       if p-par-unit = ? or p-par-unit = "" then do:
      151         v-mess = substitute("Не задана ед. изм. номинала").
      152         run err-mess in this-procedure ( input-output v-mess).
      153         return error (if p-silent = yes then v-mess else 'par-unit':U).
      154       end.
      155     end.
      156     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      157       create buf_wth-par.
      158       assign
      159       buf_wth-par.par-code = next-value(s-par-code, ub)
      160       buf_wth-par.wth-code = p-wth-code
      161       .
      162     end.
      163     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      164       find first buf_wth-par exclusive-lock where
      165                 recid(buf_wth-par) = p-rec .
      166       if buf_wth-par.par-code <> p-par-code
      167       or buf_wth-par.wth-code <> p-wth-code then do:
      168         v-mess = substitute("Для уже имеющейся записи Номинала МЦ нельзя изменить код МЦ или код Номинала&1" +
      169                              "старый код МЦ - &2, старый код номинала &3"
      170                              ,chr(10)
      171                              , buf_wth-par.wth-code
      172                              , buf_wth-par.par-code).
      173         run err-mess in this-procedure ( input-output v-mess).
      174         return error (if p-silent = yes then v-mess else '':U).
      175       end.
      176     end.
      177     assign
      178     buf_wth-par.par-val = p-par-val
      179     buf_wth-par.par-unit = p-par-unit
      180     buf_wth-par.par-feat = p-par-feat
      181     buf_wth-par.par-rate = p-par-rate
      182     p-rec = recid(buf_wth-par)
      183     .
      184     release buf_wth-par no-error .
      185     if error-status:error then do:
      186       v-mess = substitute("Ошибка при сохранения записи номинала МЦ:&1&2&3"
      187                            , error-status:get-message(1)
      188                            , chr(10)
      189                            , return-value
      190                            ).
      191       run err-mess in this-procedure ( input-output v-mess).
      192       return error (if p-silent = yes then v-mess else '':U).
      193     end.
      194   end.
      195   PROCEDURE err-mess:
      196     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      197     CASE p-silent:
      198       when yes then do:
      199         assign
      200         p-mess = substitute("Номинал МЦ: код МЦ &1 код номинала &2&3&4"
      201                            , p-wth-code
      202                            , p-par-code
      203                            , chr(10)
      204                            , p-mess)
      205         .
      206       end.
      207       when no then do:
      208         message
      209         p-mess
      210         view-as alert-box error .
      211       end.
      212     end.
      213   END PROCEDURE.
