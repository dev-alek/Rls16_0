      410   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      411   do:
      412     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      413       (input  v-cntxt-db-num
      414       ,input  v-cntxt-userid
      415       ,input  0
      416       ,input  'actn_fin-doc_add-def':U
      417       ,input  'firm':U
      418       ,input  p-host-code
      419       ,input  '':U
      420       ,input  0
      421       ,input  0
      422       ,input  0
      423       ,input  0
      424       ,input  p-silent <> true
      425       ,output loc#log
      426       )  .
      427   end.
      428   if not loc#log then return error.
      429   assign
      430   v-mode = 'ДОБАВЛЕНИЕ':U
      431   .
      432   assign
      433   v-cor-acc = 0
      434   v-cor-acc1 = 0
      435   v-an-uchet-code = 0
      436   v-cel-nazn-code  = 0
      437   v-contract-code = 0
      438   v-payer-type = "":U
      439   v-payer-code = 0
      440   v-receiver-code-schet = 0
      441   v-payer-code-schet = 0
      442   v-curr-code     = ?
      443   v-obj-type = p-obj-type
      444   v-obj-code = p-obj-code
      445   lock-obj = yes
      446   v-payer-type = 'орг':U
      447   v-payer-code = p-host-code
      448   .
      449   for each buf_clients-attr no-lock where
      450           buf_clients-attr.attr-code = 'is-inkassator':U
      451     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      452     on stop   undo , return error substitute( "&1. stop", vss-workfile )
      453     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
      454    :
      455     run clntattr-value in this-procedure (
      456                                             input  buf_clients-attr.obj-type
      457                                             ,input  buf_clients-attr.obj-code
      458                                             ,input  'db':U
      459                                             ,output v-with-db
      460                                             ,output v-type  ) no-error.
      461     create temp-inkassator.
      462     assign
      463     temp-inkassator.obj-type = buf_clients-attr.obj-type
      464     temp-inkassator.obj-code = buf_clients-attr.obj-code
      465     temp-inkassator.with-db  = logical(if v-with-db = ""
      466                                        or v-with-db = ?
      467                                        then "no"
      468                                        else v-with-db)
      469     .
      470     release temp-inkassator.
      471   end.
      472   find temp-inkassator where
      473       temp-inkassator.with-db = yes no-error.
      474   if available temp-inkassator then do:
      475     assign
      476     v-receiver-type = temp-inkassator.obj-type
      477     v-receiver-code = temp-inkassator.obj-code
      478     .
      479   end.
      480   if v-receiver-code = 0 then do:
      481     if p-silent then do:
      482       undo, return error substitute("Не удалось определить организацию-инкассатора").
      483     end.
      484     find first temp-inkassator where
      485                 temp-inkassator.with-db = yes no-error.
      486     if available temp-inkassator then do:
      487       run select-from in this-procedure ( input yes
      488                                         , output v-receiver-type
      489                                         , output v-receiver-code) no-error .
      490       if v-receiver-code = 0 then do:
      491         return.
      492       end.
      493     end.
      494   end.
      495   if v-receiver-code = 0 then do:
      496     find temp-inkassator no-error.
      497     if available temp-inkassator then do:
      498       assign
      499       v-receiver-type = temp-inkassator.obj-type
      500       v-receiver-code = temp-inkassator.obj-code
      501       .
      502     end.
      503   end.
      504   if v-receiver-code = 0 then do:
      505     if p-silent then do:
      506       undo, return error substitute("Не удалось определить организацию-инкассатора").
      507     end.
      508     find first temp-inkassator no-error.
      509     if available temp-inkassator then do:
      510       run select-from in this-procedure ( input ?
      511                                         , output v-receiver-type
      512                                         , output v-receiver-code) no-error .
      513       if v-receiver-code = 0 then do:
      514         return.
      515       end.
      516      end.
      517   end.
      518   if v-receiver-code = 0 then do:
      519     if p-silent then do:
      520       undo, return error substitute("Не удалось определить организацию-инкассатора").
      521     end.
      522     else do:
      523       message
      524       "Ни для Вашей БД, ни для системы в целом не найдено ни одной организации, определенной как ИНКАССАТОР" skip
      525       "Задайте организацию-ИНКАССАТОРА непосредственно в платеже"
      526       view-as alert-box WARNING.
      527     end.
      528   END.
      529   run ref/findoci2.w (
      530                  input parParentProc
      531                 ,input p-host-code
      532                 ,input v-mode
      533                 ,input p-host-code
      534                 ,input 0
      535                 ,input v-obj-type
      536                 ,input v-obj-code
      537                 ,input "":U
      538                 ,input v-contract-code
      539                 ,input '':U
      540                 ,input v-receiver-type
      541                 ,input v-receiver-code
      542                 ,input v-curr-code
      543                 ,input v-cor-acc
      544                 ,input v-cor-acc1
      545                 ,input v-an-uchet-code
      546                 ,input v-cel-nazn-code
      547                 ,input (if lock-obj then "lock-obj":U else '')
      548                 ,input-output loc-doc-rec
      549                             ) no-error
      550           .
      551   if not error-status :error
      552   and p-start-ref
      553   and loc-doc-rec <> ?
      554   then do:
      555    v-rid-list = string(loc-doc-rec).
      556    run ref/findocs.w (
      557                  input parparentproc
      558                 ,input p-host-code
      559                 ,input "":U
      560                 ,input "type-object"
      561                 ,input 'все':U
      562                 ,input p-host-code
      563                 ,input p-obj-type
      564                 ,input p-obj-code
      565                 ,input ""
      566                 ,input 'рко':U
      567                 ,input "":U
      568                 ,input ?
      569                 ,input ?
      570                 ,input "":U
      571                 ,input "":U
      572                 ,input 0
      573                 ,input "":U
      574                 ,input "":U
      575                 ,input 0
      576                 ,input "":U
      577                 ,input ?
      578                 ,input 0
      579                 ,input 0
      580                 ,input 0
      581                 ,input 0
      582                 ,input 0
      583                 ,input 0
      584                 ,input 0
      585                 ,input-output v-rid-list).
      586   end.
      587   procedure select-from :
      588   define input  parameter p-with-db as logical   no-undo .
      589   define output parameter p-inkassator-obj-type as character no-undo .
      590   define output parameter p-inkassator-obj-code as integer   no-undo .
      591   define variable v-codes as character no-undo .
      592   define variable v-labels as character no-undo .
      593   define variable v-sel-codes as character no-undo .
      594   define buffer buf_clients for ub.clients.
      595   for each temp-inkassator where
      596           p-with-db = ? or temp-inkassator.with-db = p-with-db
      597   :
      598     find first buf_clients no-lock where
      599              buf_clients.obj-type = temp-inkassator.obj-type
      600         and  buf_clients.obj-code = temp-inkassator.obj-code
      601         .
      602     assign
      603     v-codes = v-codes + (if v-codes = ''
      604                          then ''
      605                          else chr(4) ) +
      606              temp-inkassator.obj-type + string(temp-inkassator.obj-code)
      607     v-labels = v-labels + (if v-labels = ''
      608                          then ''
      609                          else chr(4) ) +
      610              buf_clients.obj-name.
      611   end.
      612   run gbl/d-list.w ( input "b-sel"
      613                     ,input "Выберите организацию-инкасатора"
      614                     ,input v-codes
      615                     ,input v-labels
      616                     ,input chr(4)
      617                     ,input ""
      618                     ,output v-sel-codes) no-error.
      619   if error-status:error
      620   or v-sel-codes = ''
      621   then do:
      622     return "return".
      623   end.
      624   assign
      625   p-inkassator-obj-type = substring(v-sel-codes, 1, 3)
      626   p-inkassator-obj-code = integer(substring(v-sel-codes, 4))
      627   .
      628    end procedure.
