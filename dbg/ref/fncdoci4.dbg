     1621     tt-c-fin-doc.receiver-name
     1622     tt-c-fin-doc.receiver-inn
     1623     tt-c-fin-doc.receiver-kpp
     1624     tt-c-fin-doc.receiver-bank-name
     1625     tt-c-fin-doc.receiver-bik
     1626     tt-c-fin-doc.receiver-r-schet
     1627     tt-c-fin-doc.receiver-c-schet
     1628     tt-c-fin-doc.naznach-plat
     1629     tt-c-fin-doc.PS
     1630     tt-c-fin-doc.payer-sign1
     1631     tt-c-fin-doc.payer-sign2
     1632     with frame Dialog-Frame
     1633     .
     1634     if tt-c-fin-doc.perm-date <> ? then
     1635     display
     1636     tt-c-fin-doc.perm-date
     1637     tt-c-fin-doc.user-name-perm
     1638     with frame Dialog-Frame
     1639      .
     1640     if tt-c-fin-doc.pay-date <> ? then
     1641     display
     1642     tt-c-fin-doc.pay-date
     1643     tt-c-fin-doc.user-name-pl
     1644     with frame Dialog-Frame
     1645      .
     1646     if tt-c-fin-doc.fact-date <> ? then
     1647     display
     1648     tt-c-fin-doc.fact-date
     1649     tt-c-fin-doc.user-name-fact
     1650     tt-c-fin-doc.sttm-code
     1651     v-sttm-prn-doc-code
     1652     with frame Dialog-Frame
     1653     .
     1654   ENABLE
     1655   b-quit
     1656   B-tax
     1657   b-other
     1658   B-Help
     1659   RS-view
     1660   b-receiver-view
     1661   b-payer-view
     1662   WITH FRAME Dialog-Frame.
     1663   assign
     1664   b-quit:label = "&Выход".
     1665   run hide-view-currency in this-procedure.
     1666   CASE p-view:
     1667     when "full":U then do:
     1668       IF AVAILABLE tt-c-fin-doc THEN
     1669       display
     1670       f-bank
     1671       tt-c-fin-doc.payer-type
     1672       tt-c-fin-doc.payer-code
     1673       tt-c-fin-doc.payer-name
     1674       tt-c-fin-doc.payer-inn
     1675       tt-c-fin-doc.payer-kpp
     1676       with frame Dialog-Frame
     1677       .
     1678       display
     1679       tt-c-fin-doc.cor-acc-value    when X_sysconf.is-corr-acc
     1680       f-cor-acc-descr               when X_sysconf.is-corr-acc
     1681       tt-c-fin-doc.an-uchet-value   when X_sysconf.is-an-uchet
     1682       f-an-uchet-descr              when X_sysconf.is-an-uchet
     1683       tt-c-fin-doc.cel-nazn-value   when X_sysconf.is-code-cel-nazn
     1684       f-cel-nazn-descr              when X_sysconf.is-code-cel-nazn
     1685       with frame Dialog-Frame
     1686       .
     1687     end.
     1688     when "brief":U then do:
     1689     end.
     1690     when "contract":U then do:
     1691       display
     1692       b-contract-view
     1693       f-contract-date when tt-c-fin-doc.contract-code <> 0
     1694       f-contract-prn-code when tt-c-fin-doc.contract-code <> 0
     1695       f-contract-type when tt-c-fin-doc.contract-code <> 0
     1696       f-contract-curr-abbr when tt-c-fin-doc.contract-code <> 0
     1697       tt-c-fin-doc.contract-curr when tt-c-fin-doc.contract-code <> 0
     1698       with frame Dialog-Frame
     1699       .
     1700       ENABLE
     1701       b-contract-view
     1702       with frame Dialog-Frame.
     1703     end.
     1704   END CASE.
     1705   END PROCEDURE.
     1706   PROCEDURE disable_UI :
     1707     HIDE FRAME Dialog-Frame.
     1708   END PROCEDURE.
     1709   PROCEDURE enable_UI :
     1710     OPEN QUERY Dialog-Frame FOR EACH locked_c-fin-doc SHARE-LOCK,       EACH tt-fin-doc WHERE TRUE  SHARE-LOCK.
     1711     GET FIRST Dialog-Frame.
     1712     DISPLAY RS-view v-sttm-prn-doc-code f-cor-acc-descr f-an-uchet-descr
     1713             f-contract-curr-abbr f-contract-prn-code f-contract-date
     1714             f-contract-type f-cel-nazn-descr F-curr-abbr f-bank
     1715         WITH FRAME Dialog-Frame.
     1716     IF AVAILABLE tt-c-fin-doc THEN
     1717       DISPLAY tt-c-fin-doc.prn-doc-code tt-c-fin-doc.vid-plat
     1718             tt-c-fin-doc.fin-doc-code tt-c-fin-doc.perm-date
     1719             tt-c-fin-doc.user-name-perm tt-c-fin-doc.pay-date
     1720             tt-c-fin-doc.doc-date tt-c-fin-doc.user-name-doc tt-c-fin-doc.obj-type
     1721             tt-c-fin-doc.obj-code tt-c-fin-doc.user-name-pl tt-c-fin-doc.fact-date
     1722             tt-c-fin-doc.user-name-fact tt-c-fin-doc.cor-acc-value
     1723             tt-c-fin-doc.an-uchet-value tt-c-fin-doc.contract-curr
     1724             tt-c-fin-doc.cel-nazn-value tt-c-fin-doc.sum-doc
     1725             tt-c-fin-doc.curr-code tt-c-fin-doc.sum-rubl tt-c-fin-doc.exch-rate
     1726             tt-c-fin-doc.exch-scale tt-c-fin-doc.base-rate tt-c-fin-doc.base-scale
     1727             tt-c-fin-doc.sum-base tt-c-fin-doc.contract-rate
     1728             tt-c-fin-doc.contract-scale tt-c-fin-doc.sum-contr
     1729             tt-c-fin-doc.payer-inn tt-c-fin-doc.payer-kpp tt-c-fin-doc.payer-type
     1730             tt-c-fin-doc.payer-code tt-c-fin-doc.payer-name
     1731             tt-c-fin-doc.payer-bank-name tt-c-fin-doc.payer-r-schet
     1732             tt-c-fin-doc.payer-bik tt-c-fin-doc.payer-c-schet
     1733             tt-c-fin-doc.receiver-inn tt-c-fin-doc.receiver-kpp
     1734             tt-c-fin-doc.receiver-type tt-c-fin-doc.receiver-code
     1735             tt-c-fin-doc.receiver-name tt-c-fin-doc.receiver-bank-name
     1736             tt-c-fin-doc.receiver-r-schet tt-c-fin-doc.receiver-bik
     1737             tt-c-fin-doc.receiver-c-schet tt-c-fin-doc.naznach-plat
     1738             tt-c-fin-doc.PS tt-c-fin-doc.payer-sign1 tt-c-fin-doc.payer-sign2
     1739             tt-c-fin-doc.sttm-code
     1740         WITH FRAME Dialog-Frame.
     1741     ENABLE B-exit b-quit b-other B-tax B-Help RS-view tt-c-fin-doc.prn-doc-code
     1742            tt-c-fin-doc.vid-plat tt-c-fin-doc.doc-date tt-c-fin-doc.user-name-doc
     1743            tt-c-fin-doc.obj-type tt-c-fin-doc.obj-code tt-c-fin-doc.cor-acc-value
     1744            tt-c-fin-doc.an-uchet-value f-contract-curr-abbr B-contract-view
     1745            tt-c-fin-doc.contract-curr tt-c-fin-doc.cel-nazn-value
     1746            tt-c-fin-doc.sum-doc tt-c-fin-doc.curr-code tt-c-fin-doc.exch-rate
     1747            tt-c-fin-doc.exch-scale tt-c-fin-doc.sum-base
     1748            tt-c-fin-doc.contract-rate tt-c-fin-doc.contract-scale
     1749            tt-c-fin-doc.sum-contr tt-c-fin-doc.payer-name
     1750            tt-c-fin-doc.payer-bank-name B-payer-view tt-c-fin-doc.payer-c-schet
     1751            tt-c-fin-doc.receiver-type tt-c-fin-doc.receiver-code
     1752            tt-c-fin-doc.receiver-name B-receiver-view tt-c-fin-doc.naznach-plat
     1753            tt-c-fin-doc.PS tt-c-fin-doc.payer-sign1 tt-c-fin-doc.payer-sign2
     1754         WITH FRAME Dialog-Frame.
     1755     VIEW FRAME Dialog-Frame.
     1756   END PROCEDURE.
     1757   PROCEDURE fill-main-table :
     1758   define variable v-recid-schet as recid no-undo .
     1759   define variable v-recid-bank as recid no-undo .
     1760   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1761   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1762     (output v-db-num
     1763     )  .
     1764   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1765   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1766     (input  p-host-code
     1767     ,output v-base-code
     1768     )  .
     1769   find first X_curr_sysconf no-lock where
     1770                   X_curr_sysconf.host-code = p-curr-host-code.
     1771   find first X_sysconf no-lock where
     1772                 X_sysconf.host-code = p-host-code.
     1773   find first X_clients-host no-lock where
     1774               X_clients-host.obj-type = 'орг':U
     1775           AND   X_clients-host.obj-code = p-host-code  no-error.
     1776   if not available X_clients-host then do:
     1777     message
     1778     vss-workfile vss-revision vss-description skip
     1779     "Неверное значение параметра вызова p-host-code"  p-host-code
     1780     view-as alert-box ERROR.
     1781     undo, return error.
     1782   end.
     1783   find first X_firm no-lock where
     1784               X_firm.firm-code = p-host-code.
     1785   for each tt-c-fin-doc:
     1786     delete tt-c-fin-doc.
     1787   end.
     1788   for each tt0-fin-doc-attr:
     1789     delete tt0-fin-doc-attr.
     1790   end.
     1791   for each tt0-fin-doc-tax:
     1792     delete tt0-fin-doc-tax.
     1793   end.
     1794   find first locked_c-fin-doc no-lock where
     1795               recid(locked_c-fin-doc) = p-doc-rec no-error .
     1796   if not available locked_c-fin-doc then do:
     1797     find first locked_c-fin-doc no-lock where
     1798                 locked_c-fin-doc.host-code = p-host-code
     1799             AND locked_c-fin-doc.fin-doc-code = p-fin-doc-code no-error .
     1800   end.
     1801   if not available locked_c-fin-doc then do:
     1802   message
     1803   vss-workfile vss-revision vss-description skip
     1804   "Не найдена запись истории РАСХОДНОГО ПЛАТЕЖНОГО ПОРУЧЕНИЯ"
     1805   view-as alert-box error .
     1806   undo, return error.
     1807   end.
     1808   create tt-c-fin-doc.
     1809   buffer-copy locked_c-fin-doc to tt-c-fin-doc.
     1810   END PROCEDURE.
     1811   PROCEDURE Myenable :
     1812   define variable v-inn like ub.firm.inn no-undo .
     1813   define variable v-kpp like ub.firm.kpp no-undo .
     1814   define variable g-log as logical no-undo.
     1815   assign
     1816       tt-c-fin-doc.sum-rubl :label in frame Dialog-Frame = "Рубли"
     1817       tt-c-fin-doc.payer-inn:label in frame Dialog-Frame = "ИНН"
     1818       tt-c-fin-doc.receiver-inn:label in frame Dialog-Frame = "ИНН"
     1819       tt-c-fin-doc.payer-kpp:label in frame Dialog-Frame = "КПП"
     1820       tt-c-fin-doc.receiver-kpp:label in frame Dialog-Frame = "КПП"
     1821       .
     1822   run uf-get in this-procedure(
     1823       input  ('findoci-p':U + chr(4) + 'рпп':U)
     1824       ,input  v-cntxt-userid
     1825       ,output v-uf-List_
     1826       ,output v-uf-Naim
     1827       ,output v-uf-print-graft
     1828       ,output v-uf-sort-gr
     1829       ,output v-uf-type-price
     1830       ,output v-uf-type-val
     1831   )  no-error.
     1832   if not error-status:error
     1833   and not v-uf-LIst_ = "":U
     1834   then do:
     1835       assign
     1836       v-view =  entry(1, v-uf-List_, chr(4))
     1837       .
     1838   end.
     1839   assign
     1840   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + x_clients-host.obj-name
     1841   tt-c-fin-doc.receiver-type:radio-buttons = "Орг" + chr(44) + 'орг':U + chr(44) +
     1842                                            "Чел" + chr(44) + 'чел':U
     1843   rs-view:radio-buttons = "&Полностью" + chr(44) + "full":U +  chr(44) +
     1844                                       "&Сокращ." + chr(44) + "brief":U + chr(44) +
     1845                                       "&Договор" + chr(44) + "contract":U
     1846   tt-c-fin-doc.obj-type:radio-buttons = "Маг" + chr(44) + 'маг':U + chr(44) +
     1847                                         "Скл" + chr(44) + 'скл':U
     1848   tt-c-fin-doc.vid-plat:list-items = 'почтой,телеграфом,электронно,':U
     1849   rs-view = v-view
     1850   .
     1851   if
     1852   tt-c-fin-doc.contract-code = 0 then do:
     1853       assign
     1854       g-log = rs-view:disable(radio-label("contract":U, RS-view:radio-buttons))
     1855       .
     1856       if rs-view = "contract":U then
     1857       assign
     1858       rs-view = "full":U
     1859       v-not-uf-set = yes.
     1860   end.
     1861   find first X_currency no-lock where
     1862                 X_currency.curr-code = tt-c-fin-doc.curr-code.
     1863   assign
     1864   f-curr-abbr = X_Currency.curr-abbr.
     1865   if tt-c-fin-doc.contract-code <> 0 then do:
     1866     find first X_currency no-lock where
     1867                   X_currency.curr-code = tt-c-fin-doc.contract-curr.
     1868     assign
     1869     f-contract-curr-abbr = X_Currency.curr-abbr.
     1870   end.
     1871   if tt-c-fin-doc.cor-acc <> 0 then do:
     1872     find first X_fin-code-cor-acc no-lock where
     1873                 X_fin-code-cor-acc.fin-code  = tt-c-fin-doc.cor-acc no-error.
     1874     if available X_fin-code-cor-acc then do:
     1875       assign
     1876       f-cor-acc-descr = X_fin-code-cor-acc.descr.
     1877     end.
     1878     if not available X_fin-code-cor-acc  then do:
     1879       assign
     1880       f-cor-acc-descr = "!!!Код больше не существует".
     1881     end.
     1882   end.
     1883   if tt-c-fin-doc.an-uchet-code <> 0 then do:
     1884   find first X_fin-code-an-uchet no-lock where
     1885                 X_fin-code-an-uchet.fin-code  = tt-c-fin-doc.an-uchet-code no-error.
     1886     if available X_fin-code-an-uchet then do:
     1887       assign
     1888       f-an-uchet-descr = X_fin-code-an-uchet.descr.
     1889     end.
     1890     if not available X_fin-code-an-uchet then do:
     1891       assign
     1892       f-an-uchet-descr = "!!!Код больше не существует".
     1893     end.
     1894   end.
     1895   if tt-c-fin-doc.cel-nazn-code <> 0 then do:
     1896     find first X_fin-code-cel-nazn no-lock where
     1897                   X_fin-code-cel-nazn.fin-code  = tt-c-fin-doc.cel-nazn-code no-error.
     1898     if available X_fin-code-cel-nazn then do:
     1899       assign
     1900       f-cel-nazn-descr = X_fin-code-cel-nazn.descr.
     1901     end.
     1902     if not available X_fin-code-cel-nazn then do:
     1903       assign
     1904       f-cel-nazn-descr = "!!!Код больше не существует".
     1905     end.
     1906   end.
     1907   IF tt-c-fin-doc.sttm-code <> 0 THEN DO:
     1908     FIND FIRST X_fin-statement NO-LOCK WHERE
     1909               X_fin-statement.host-code  = tt-c-fin-doc.host-code
     1910           AND X_fin-statement.sttm-code  = tt-c-fin-doc.sttm-code NO-ERROR.
     1911     IF NOT AVAILABLE X_fin-statement THEN DO:
     1912         FIND FIRST X_c-fin-statement NO-LOCK WHERE
     1913                   X_c-fin-statement.host-code  = tt-c-fin-doc.host-code
     1914               AND X_c-fin-statement.sttm-code  = tt-c-fin-doc.sttm-code NO-ERROR.
     1915       IF AVAILABLE X_c-fin-statement THEN DO:
     1916          ASSIGN
     1917          v-sttm-prn-doc-CODE = X_c-fin-statement.prn-doc-code.
     1918       END.
     1919       ELSE DO:
     1920           ASSIGN
     1921           v-sttm-prn-doc-CODE = "@НЕИЗВЕСТНАЯ ВЫПИСКА".
     1922       END.
     1923     END.
     1924     ELSE DO:
     1925         ASSIGN
     1926         v-sttm-prn-doc-CODE = X_fin-statement.prn-doc-code.
     1927     END.
     1928   END.
     1929   run proc-color-widgets in this-procedure("f-an-uchet-descr,f-cel-nazn-descr,f-contract-curr-abbr,f-contract-date,f-contract-prn-code,f-contract-rate," +                         "f-contract-scale,f-contract-type,f-cor-acc-descr,base-rate,base-scale,curr-code,exch-rate,exch-scale,contract-rate,contract-scale," +                         "fact-date,fin-doc-code,receiver-code,receiver-type,pay-date,perm-date,PS,payer-code,payer-type,sum-base,sum-rubl,sum-contr," +                         "user-name-doc,user-name-fact,user-name-perm.user-name-pl", no, yes, ?, grey_color).
     1930   run proc-color-widgets in this-procedure("F-curr-abbr,an-uchet-value,cel-nazn-value,cor-acc-value,doc-date," +                       "naznach-plat,receiver-name,receiver-inn,receiver-kpp,receiver-bank-name,receiver-bik,receiver-r-schet,receiver-c-schet," +                       "prn-doc-code,payer-name,payer-inn,payer-kpp,payer-bank-name,payer-bik,payer-r-schet,payer-c-schet,payer-sign1,payer-sign2" +                       "sum-doc", no, yes, ?, grey_color).
     1931   run change-view in this-procedure(rs-view).
     1932   VIEW FRAME Dialog-Frame.
     1933   END PROCEDURE.
