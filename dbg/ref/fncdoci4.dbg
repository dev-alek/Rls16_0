     1319   PROCEDURE fill-tables :
     1320   define buffer buf_c-fin-doc-tax for ub.c-fin-doc-tax.
     1321   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
     1322   for each buf_c-fin-doc-tax no-lock where
     1323   buf_c-fin-doc-tax.host-code = tt-c-fin-doc.host-code
     1324   AND buf_c-fin-doc-tax.fin-doc-code = tt-c-fin-doc.fin-doc-code
     1325   AND buf_c-fin-doc-tax.chip-num = tt-c-fin-doc.chip-num
     1326    :
     1327       create tt0-fin-doc-tax.
     1328       buffer-copy buf_c-fin-doc-tax to tt0-fin-doc-tax.
     1329   end.
     1330   for each buf_c-fin-doc-attr no-lock where
     1331   buf_c-fin-doc-attr.host-code = tt-c-fin-doc.host-code
     1332   AND buf_c-fin-doc-attr.fin-doc-code = tt-c-fin-doc.fin-doc-code
     1333   AND buf_c-fin-doc-attr.chip-num = tt-c-fin-doc.chip-num
     1334   :
     1335       create tt0-fin-doc-attr.
     1336       buffer-copy buf_c-fin-doc-attr to tt0-fin-doc-attr.
     1337   end.
     1338   END PROCEDURE.
     1339   PROCEDURE hide-view-currency :
     1340   assign
     1341   v-rubf = no
     1342   v-exchf = no
     1343   v-basef = no
     1344   v-baseratef = no
     1345   v-contractf = no
     1346   v-contractratef = no
     1347   .
     1348   hide
     1349   tt-c-fin-doc.exch-rate in frame Dialog-Frame
     1350   tt-c-fin-doc.exch-scale
     1351   tt-c-fin-doc.sum-rubl
     1352   tt-c-fin-doc.sum-base
     1353   tt-c-fin-doc.base-rate
     1354   tt-c-fin-doc.base-scale
     1355   tt-c-fin-doc.sum-contr
     1356   tt-c-fin-doc.contract-rate
     1357   tt-c-fin-doc.contract-scale
     1358   in frame Dialog-Frame .
     1359   if tt-c-fin-doc.curr-code = 0
     1360   and v-base-code = 0
     1361   and
     1362   (tt-c-fin-doc.contract-code = 0
     1363   or tt-c-fin-doc.contract-curr = 0)
     1364   then do:
     1365       return.
     1366   end.
     1367   if tt-c-fin-doc.curr-code <> 0 then do:
     1368     if tt-c-fin-doc.curr-code:visible then
     1369     display
     1370     tt-c-fin-doc.exch-rate
     1371     tt-c-fin-doc.exch-scale
     1372     tt-c-fin-doc.sum-rubl
     1373     with frame Dialog-Frame.
     1374     assign
     1375     v-rubf = yes
     1376     v-exchf = yes
     1377     .
     1378   end.
     1379   if v-base-code <> 0 then do:
     1380     if tt-c-fin-doc.curr-code:visible then
     1381     display
     1382     tt-c-fin-doc.base-rate
     1383     tt-c-fin-doc.base-scale
     1384     tt-c-fin-doc.sum-base
     1385     with frame Dialog-Frame.
     1386     assign
     1387     v-basef = yes
     1388     v-baseratef = yes
     1389     .
     1390   end.
     1391   if tt-c-fin-doc.contract-code  <> 0 and
     1392     (tt-c-fin-doc.contract-curr <> 0  )
     1393     then do:
     1394       if tt-c-fin-doc.curr-code:visible then
     1395       display
     1396       tt-c-fin-doc.sum-contr
     1397       tt-c-fin-doc.contract-rate
     1398       tt-c-fin-doc.contract-scale
     1399       with frame Dialog-Frame.
     1400     assign
     1401     v-contractf = yes
     1402     v-contractratef = yes
     1403     .
     1404   end.
     1405   END PROCEDURE.
     1406   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1407   on help of frame Dialog-Frame
     1408   do:
     1409     run gbl/app_help.p
     1410       (input this-procedure :file-name
     1411       ,input ''
     1412       ,input ?
     1413       ) no-error.
     1414     if error-status :error then do:
     1415       message
     1416         "Ошибка при вызове помощи"
     1417         error-status :get-message(1)
     1418         view-as alert-box .
     1419     end.
     1420   end.
     1421   run minbtn-set in this-procedure .
     1422   on choose of b-help in frame Dialog-Frame
     1423   do:
     1424     apply "help":u to frame Dialog-Frame .
     1425   end.
     1426   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1427   procedure minbtn-set :
     1428       do
     1429           on error undo, return error return-value
     1430           :
     1431           define variable ii              as integer       no-undo .
     1432           define variable fh              as widget-handle no-undo .
     1433           define variable hh              as widget-handle no-undo .
     1434           define variable v-h             as handle        extent 4 no-undo .
     1435           define variable v-name-button   as character     no-undo .
     1436           define variable v-help-old-x    as decimal       no-undo .
     1437           define variable v-help-old-y    as decimal       no-undo .
     1438           define variable v-help-old-size as decimal       no-undo .
     1439           define variable v-frame-width   as decimal       no-undo .
     1440           define variable jj              as integer       no-undo .
     1441           do
     1442               on error undo, return error
     1443               :
     1444               assign
     1445                   v-frame-width = frame Dialog-Frame:width - 0.3
     1446                   fh            = frame Dialog-Frame:first-child
     1447                   hh            = fh:first-child
     1448                   ii            = 1
     1449                   .
     1450               do while valid-handle(hh):
     1451                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1452                   do:
     1453                       case lc(hh:name) :
     1454                           when "b-help" then
     1455                               do:
     1456                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1457                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1458                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1459                                   hh:TOOLTIP = "Помощь" .
     1460                                   v-help-old-x = hh:column .
     1461                                   v-help-old-y = hh:row    .
     1462                                   v-help-old-size = hh:width .
     1463                                   hh:width-chars = 2.5 .
     1464                               end.
     1465                           when "b-print" then
     1466                               do:
     1467                                   hh:load-image("cmp/b-print.bmp":u) .
     1468                                   hh:TOOLTIP = "Печать" .
     1469                                   v-h[ii] = hh:handle .
     1470                                   ii = ii + 1 .
     1471                                   hh:width-chars = 3 .
     1472                               end.
     1473                           when "b-history" or
     1474                           when "b-hist" then
     1475                               do:
     1476                                   hh:load-image("cmp/b-hist.bmp":u) .
     1477                                   hh:TOOLTIP = "История" .
     1478                                   v-h[ii] = hh:handle .
     1479                                   ii = ii + 1 .
     1480                                   hh:width-chars = 3 .
     1481                               end.
     1482                           when "b-sch" then
     1483                               do:
     1484                                   hh:load-image("cmp/b-sch.bmp":u) .
     1485                                   hh:TOOLTIP = "Установка Фильтра" .
     1486                                   v-h[ii] = hh:handle .
     1487                                   ii = ii + 1 .
     1488                                   hh:width-chars = 3 .
     1489                               end.
     1490                           when "b-hist-user" then
     1491                               do:
     1492                                   hh:load-image("cmp/b-hist.bmp":u) .
     1493                                   hh:TOOLTIP = "История пользователя" .
     1494                                   ii = ii + 1 .
     1495                               end.
     1496                       end case.
     1497                   end.
     1498                   hh = hh:next-sibling.
     1499               end.
     1500               b-help:column = v-frame-width - b-help:width-chars.
     1501               jj = 0.
     1502               repeat ii = 4 to 1 by -1 :
     1503                   if valid-handle (v-h[ii] ) then
     1504                   do:
     1505                       jj  = jj + 1 .
     1506                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1507                       v-h[ii]:row    = v-help-old-y .
     1508                   end.
     1509               end.
     1510           end.
     1511       end.
     1512   end procedure.
