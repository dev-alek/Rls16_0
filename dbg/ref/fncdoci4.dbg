     1222   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1223   procedure proc-color-widgets :
     1224   define input parameter p-list as character no-undo .
     1225   define input parameter p-fg as logical no-undo .
     1226   define input parameter p-bg as logical no-undo .
     1227   define input parameter p-fgc as integer no-undo .
     1228   define input parameter p-bgc as integer no-undo .
     1229   define variable ii as integer no-undo .
     1230   define variable fh as widget-handle no-undo .
     1231   define variable hh as widget-handle no-undo .
     1232     do
     1233     on error undo, return error
     1234     :
     1235       assign
     1236       fh = frame Dialog-Frame:first-child
     1237       hh = fh:first-child
     1238       .
     1239       do while valid-handle(hh):
     1240         if LOOKUP(hh:name, p-list) > 0  then do:
     1241           assign
     1242           hh:fgcolor = (if p-fg then p-fgc else hh:fgcolor)
     1243           hh:bgcolor = (if p-bg then p-bgc else hh:bgcolor)
     1244           .
     1245         end.
     1246         hh = hh:next-sibling.
     1247       end.
     1248     end.
     1249   end procedure.
     1250   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1251   ON CHOOSE OF B-contract-view IN FRAME Dialog-Frame
     1252   DO:
     1253   define variable g-log as logical no-undo.
     1254    define variable ri as recid no-undo .
     1255     if not avail X_contract then return no-apply.
     1256   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1257   do:
     1258     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1259       (input  v-cntxt-db-num
     1260       ,input  v-cntxt-userid
     1261       ,input  0
     1262       ,input  'actn_fin-contract_lookup':U
     1263       ,input  'firm':U
     1264       ,input  tt-c-fin-doc.host-code
     1265       ,input  '':U
     1266       ,input  0
     1267       ,input  0
     1268       ,input  0
     1269       ,input  0
     1270       ,input  true
     1271       ,output g-log
     1272       )  .
     1273   end.
     1274     if not g-log then  return .
     1275     ri = recid( X_contract ).
     1276     run str/sh-contr.p ( input parParentProc, input ri) no-error.
     1277     if error-status:error then return no-apply.
     1278   END.
