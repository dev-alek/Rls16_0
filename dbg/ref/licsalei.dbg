        1   define input parameter parparentproc  as widget-handle no-undo .
        2   define input parameter p-mode as character no-undo.
        3   define input-output parameter p-rr      as  recid no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Редактирование лицензий на продажу алкоголя".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71     define variable v-cntxt-db-num        as integer   no-undo .
       72     define variable v-cntxt-userid        as character no-undo .
       73     define variable v-cntxt-level         as character no-undo .
       74     define variable v-cntxt-host-code-obj as integer   no-undo .
       75     define variable v-cntxt-obj-type      as character no-undo .
       76     define variable v-cntxt-obj-code      as integer   no-undo .
       77     define variable v-cntxt-db-num-obj    as integer   no-undo .
       78     define variable v-cntxt-is-admin      as logical   no-undo .
       79   procedure proc-alt-shift-f2:
       80     if not ibs.th.gbl.gbl-var:rcode
       81   then
       82     run gbl\inidebug.p .
       83   end.
       84   procedure proc-alt-shift-f3:
       85     run gbl/prvssinf.p
       86       ( input this-procedure
       87       ) .
       88   end.
       89   define variable v-inform-launched as logical no-undo initial false .
       90   procedure proc-alt-shift-f4:
       91     define variable v-action as character no-undo .
       92     if v-inform-launched = false then do:
       93       assign
       94         v-inform-launched = true
       95       .
       96       run gbl/d-inform.w
       97         (  input self
       98         ,  input this-procedure
       99         , output v-action
      100         ) no-error .
      101       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      102       assign
      103         v-inform-launched = false
      104       .
      105     end.
      106   end.
      107   procedure proc-alt-f1:
      108     run gbl/corrhelp.p
      109       (input this-procedure
      110       ) .
      111   end .
      112   on alt-shift-f2 anywhere do:
      113     run proc-alt-shift-f2.
      114   end.
      115   on alt-shift-f3 anywhere do:
      116     run proc-alt-shift-f3 in this-procedure .
      117   end.
      118   on alt-shift-f4 anywhere do:
      119     run proc-alt-shift-f4 in this-procedure.
      120   end.
      121   on alt-f1 anywhere do:
      122     run proc-alt-f1 in this-procedure .
      123   end.
      124   define variable RowID-list   as character no-undo .
      125   define variable rid-list-sale as character no-undo .
      126   define buffer buf_alc-sale-lic for ub.alc-sale-lic .
      127   DEFINE BUTTON b-exit AUTO-GO
      128        LABEL "Ввод"
      129        SIZE 10 BY 1
      130        BGCOLOR 8 .
      131   DEFINE BUTTON b-help
      132        LABEL "&Помощь"
      133        SIZE 10 BY 1
      134        BGCOLOR 8 .
      135   DEFINE BUTTON b-quit AUTO-END-KEY
      136        LABEL "Отмена"
      137        SIZE 10 BY 1
      138        BGCOLOR 8 .
      139   DEFINE BUTTON b-types
      140        IMAGE-UP FILE "btn-down-arrow":U
      141        IMAGE-DOWN FILE "btn-down-arrow":U
      142        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      143        LABEL "типы"
      144        SIZE 3 BY .87 TOOLTIP "типы алкоголя, разрешенные к продаже по этой лицензии".
      145   DEFINE VARIABLE f-client AS CHARACTER FORMAT "X(40)":U
      146         VIEW-AS TEXT
      147        SIZE 41.3 BY 1 NO-UNDO.
      148   DEFINE VARIABLE f-date-from AS DATE FORMAT "99/99/9999":U INITIAL ?
      149        LABEL "Дествует с"
      150        VIEW-AS FILL-IN
      151        SIZE 14 BY 1 NO-UNDO.
      152   DEFINE VARIABLE f-date-get AS DATE FORMAT "99/99/9999":U INITIAL ?
      153        LABEL "Дата выдачи"
      154        VIEW-AS FILL-IN
      155        SIZE 14 BY 1 NO-UNDO.
      156   DEFINE VARIABLE f-date-to AS DATE FORMAT "99/99/9999":U INITIAL ?
      157        LABEL "по"
      158        VIEW-AS FILL-IN
      159        SIZE 14 BY 1 NO-UNDO.
      160   DEFINE VARIABLE f-number AS CHARACTER FORMAT "X(16)":U
      161        LABEL "номер"
      162        VIEW-AS FILL-IN
      163        SIZE 16 BY 1 NO-UNDO.
      164   DEFINE VARIABLE f-seria AS CHARACTER FORMAT "X(16)":U
      165        LABEL "Серия"
      166        VIEW-AS FILL-IN
      167        SIZE 16 BY 1 NO-UNDO.
      168   DEFINE VARIABLE f-types AS CHARACTER FORMAT "X(10)":U INITIAL "не выбраны"
      169         VIEW-AS TEXT
      170        SIZE 10 BY 1 NO-UNDO.
      171   DEFINE VARIABLE f-who-are-got AS CHARACTER FORMAT "X(30)":U
      172        LABEL "Кем выдана"
      173        VIEW-AS FILL-IN
      174        SIZE 30 BY 1 NO-UNDO.
      175   DEFINE VARIABLE t-all AS LOGICAL INITIAL no
      176        LABEL "все типы алкоголя"
      177        VIEW-AS TOGGLE-BOX
      178        SIZE 20 BY 1 NO-UNDO.
      179   DEFINE FRAME Dialog-Frame
      180        b-exit AT ROW 1 COL 1
      181        b-quit AT ROW 1 COL 11
      182        b-help AT ROW 1 COL 42
      183        f-seria AT ROW 3.13 COL 5 WIDGET-ID 2
      184        f-number AT ROW 3.13 COL 34.5 COLON-ALIGNED WIDGET-ID 8
      185        f-date-get AT ROW 4.2 COL 12 COLON-ALIGNED WIDGET-ID 10
      186        f-who-are-got AT ROW 5.27 COL 12 COLON-ALIGNED WIDGET-ID 12
      187        f-date-from AT ROW 6.33 COL 12 COLON-ALIGNED WIDGET-ID 14
      188        f-date-to AT ROW 6.33 COL 30.5 COLON-ALIGNED WIDGET-ID 16
      189        b-types AT ROW 7.4 COL 22.5 WIDGET-ID 20
      190        t-all AT ROW 7.5 COL 2 WIDGET-ID 18
      191        f-client AT ROW 2 COL 10 COLON-ALIGNED NO-LABEL WIDGET-ID 26
      192        f-types AT ROW 7.4 COL 32 COLON-ALIGNED NO-LABEL WIDGET-ID 24
      193        SPACE(9.30) SKIP(0.10)
      194       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      195            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      196            TITLE "Лицензия поставщика алкоголя"
      197            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit WIDGET-ID 100.
      198   ASSIGN
      199          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      200          FRAME Dialog-Frame:HIDDEN           = TRUE.
      201   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      202   DO:
      203     APPLY "END-ERROR":U TO SELF.
      204   END.
      205   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      206   DO:
      207      assign
      208         f-seria
      209         f-number
      210         f-date-get
      211         f-who-are-got
      212         f-date-from
      213         f-date-to
      214         t-all
      215      .
      216     if f-seria = "" then do:
      217        message "Введите серию лицензии"
      218        view-as alert-box error.
      219        apply "entry"  to f-seria.
      220        return no-apply.
      221     end.
      222     if f-number = "" then do:
      223        message "Введите номер лицензии"
      224        view-as alert-box error.
      225        apply "entry"  to f-number.
      226        return no-apply.
      227     end.
      228     if f-date-get = ? then do:
      229        message "Введите дату выдачи лицензии"
      230        view-as alert-box error.
      231        apply "entry"  to f-date-get.
      232        return no-apply.
      233     end.
      234     if f-date-from = ? then do:
      235        message "Введите дату начала действия лицензии"
      236        view-as alert-box error.
      237        apply "entry"  to f-date-from.
      238        return no-apply.
      239     end.
      240     if f-date-to = ? then do:
      241        message "Введите дату окончания действия лицензии"
      242        view-as alert-box error.
      243        apply "entry"  to f-date-to.
      244        return no-apply.
      245     end.
      246     if f-who-are-got = "" then do:
      247        message "Введите кем выдана лицензия"
      248        view-as alert-box error.
      249        apply "entry"  to f-who-are-got.
      250        return no-apply.
      251     end.
      252     if not t-all
      253     and RowID-list = "" then do:
      254        message "Введите типы алкоголя, разрешенные к поставке по этой лицензии"
      255        view-as alert-box error.
      256        apply "entry"  to b-types.
      257        return no-apply.
      258     end.
      259     do
      260     transaction:
      261      if p-rr = ? then do:
      262         run create-lic in this-procedure.
      263      end.
      264      else do:
      265         run update-lic in this-procedure.
      266      end.
      267      run update-alc-type in this-procedure.
      268     end.
      269   END.
      270   ON CHOOSE OF b-types IN FRAME Dialog-Frame
      271   DO:
      272     define buffer buf_alc-sale-lic-type for ub.alc-sale-lic-type .
      273     define buffer buf_alc-type     for ub.alc-type .
      274     define variable v-ok as logical no-undo .
      275     define variable v-count as integer no-undo .
      276     if t-all then do:
      277        message 'Выставлен признак "все типы алкоголя" ' SKIP
      278                'Снять признак и продолжить выбор типов алкоголя?'
      279        view-as alert-box question
      280        buttons ok-cancel
      281        update v-ok
      282        .
      283         if not v-ok then do:
      284            return no-apply.
      285         end.
      286         else do:
      287            assign
      288            t-all = false
      289            .
      290         end.
      291     end.
      292     run ref/alc-type.w
      293       ( input Parparentproc
      294       , input "b-sel,b-mark"
      295       , input-OUTPUT RowID-list
      296       , output v-ok
      297         ).
      298     if RowID-list = ""
      299     and not t-all
      300     then do:
      301       assign
      302        f-types = "не выбраны"
      303       .
      304     end.
      305     else do:
      306       assign
      307        f-types = "выбраны"
      308        .
      309     end.
      310      assign
      311         f-seria
      312         f-number
      313         f-date-get
      314         f-who-are-got
      315         f-date-from
      316         f-date-to
      317         t-all
      318      .
      319     RUN enable_UI.
      320   END.
      321   ON VALUE-CHANGED OF t-all IN FRAME Dialog-Frame
      322   DO:
      323      assign
      324         f-seria
      325         f-number
      326         f-date-get
      327         f-who-are-got
      328         f-date-from
      329         f-date-to
      330            t-all
      331      .
      332      IF t-all
      333      THEN DO:
      334         ASSIGN
      335            RowID-list = ""
      336            f-types = "выбраны"
      337         .
      338      END.
      339      ELSE DO:
      340         assign
      341            f-types = "не выбраны"
      342         .
      343      END.
      344      RUN enable_UI.
      345   END.
      346   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      347   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      348   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      349   on help of frame Dialog-Frame
      350   do:
      351     run gbl/app_help.p
      352       (input this-procedure :file-name
      353       ,input ''
      354       ,input ?
      355       ) no-error.
      356     if error-status :error then do:
      357       message
      358         "Ошибка при вызове помощи"
      359         error-status :get-message(1)
      360         view-as alert-box .
      361     end.
      362   end.
      363   run minbtn-set in this-procedure .
      364   on choose of b-help in frame Dialog-Frame
      365   do:
      366     apply "help":u to frame Dialog-Frame .
      367   end.
      368   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   procedure minbtn-set :
      370       do
      371           on error undo, return error return-value
      372           :
      373           define variable ii              as integer       no-undo .
      374           define variable fh              as widget-handle no-undo .
      375           define variable hh              as widget-handle no-undo .
      376           define variable v-h             as handle        extent 4 no-undo .
      377           define variable v-name-button   as character     no-undo .
      378           define variable v-help-old-x    as decimal       no-undo .
      379           define variable v-help-old-y    as decimal       no-undo .
      380           define variable v-help-old-size as decimal       no-undo .
      381           define variable v-frame-width   as decimal       no-undo .
      382           define variable jj              as integer       no-undo .
      383           do
      384               on error undo, return error
      385               :
      386               assign
      387                   v-frame-width = frame Dialog-Frame:width - 0.3
      388                   fh            = frame Dialog-Frame:first-child
      389                   hh            = fh:first-child
      390                   ii            = 1
      391                   .
      392               do while valid-handle(hh):
      393                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      394                   do:
      395                       case lc(hh:name) :
      396                           when "b-help" then
      397                               do:
      398                                   hh:load-image-up("cmp/b-help.bmp":u) .
      399                                   hh:load-image-down("cmp/b-help.bmp":u) .
      400                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      401                                   hh:TOOLTIP = "Помощь" .
      402                                   v-help-old-x = hh:column .
      403                                   v-help-old-y = hh:row    .
      404                                   v-help-old-size = hh:width .
      405                                   hh:width-chars = 2.5 .
      406                               end.
      407                           when "b-print" then
      408                               do:
      409                                   hh:load-image("cmp/b-print.bmp":u) .
      410                                   hh:TOOLTIP = "Печать" .
      411                                   v-h[ii] = hh:handle .
      412                                   ii = ii + 1 .
      413                                   hh:width-chars = 3 .
      414                               end.
      415                           when "b-history" or
      416                           when "b-hist" then
      417                               do:
      418                                   hh:load-image("cmp/b-hist.bmp":u) .
      419                                   hh:TOOLTIP = "История" .
      420                                   v-h[ii] = hh:handle .
      421                                   ii = ii + 1 .
      422                                   hh:width-chars = 3 .
      423                               end.
      424                           when "b-sch" then
      425                               do:
      426                                   hh:load-image("cmp/b-sch.bmp":u) .
      427                                   hh:TOOLTIP = "Установка Фильтра" .
      428                                   v-h[ii] = hh:handle .
      429                                   ii = ii + 1 .
      430                                   hh:width-chars = 3 .
      431                               end.
      432                           when "b-hist-user" then
      433                               do:
      434                                   hh:load-image("cmp/b-hist.bmp":u) .
      435                                   hh:TOOLTIP = "История пользователя" .
      436                                   ii = ii + 1 .
      437                               end.
      438                       end case.
      439                   end.
      440                   hh = hh:next-sibling.
      441               end.
      442               b-help:column = v-frame-width - b-help:width-chars.
      443               jj = 0.
      444               repeat ii = 4 to 1 by -1 :
      445                   if valid-handle (v-h[ii] ) then
      446                   do:
      447                       jj  = jj + 1 .
      448                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      449                       v-h[ii]:row    = v-help-old-y .
      450                   end.
      451               end.
      452           end.
      453       end.
      454   end procedure.
      455   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      456   on ' ' of f-date-from in frame Dialog-Frame
      457   do:
      458     if (can-query (self, "sensitive")
      459        and
      460        self :sensitive = true
      461        )
      462     or (can-query (self, "read-only")
      463        and
      464        self :read-only = false
      465        )
      466     then do:
      467       assign
      468         self :screen-value = ?
      469       .
      470     end.
      471     return no-apply.
      472   end.
      473   on delete-character of f-date-from in frame Dialog-Frame
      474   do:
      475     if (can-query (self, "sensitive")
      476        and
      477        self :sensitive = true
      478        )
      479     or (can-query (self, "read-only")
      480        and
      481        self :read-only = false
      482        )
      483     then do:
      484       assign
      485         self :screen-value = ?
      486       .
      487     end.
      488     return no-apply.
      489   end.
      490   on ctrl-d of f-date-from in frame Dialog-Frame
      491   do:
      492     define variable v-curr-sv-date as date no-undo .
      493     if (can-query (self, "sensitive")
      494        and
      495        self :sensitive = true
      496        )
      497     or (can-query (self, "read-only")
      498        and
      499        self :read-only = false
      500        )
      501     then do:
      502       if self :handle <> focus :handle
      503       then do:
      504         apply "entry":u to self .
      505       end.
      506       run gbl/getcurdt.p
      507         (output v-curr-sv-date
      508         ) .
      509       assign
      510         self :screen-value = string(v-curr-sv-date) .
      511       .
      512     end.
      513     return no-apply.
      514   end.
      515   on ctrl-b of f-date-from in frame Dialog-Frame
      516   do:
      517     if (can-query (self, "sensitive")
      518        and
      519        self :sensitive = true
      520        )
      521     or (can-query (self, "read-only")
      522        and
      523        self :read-only = false
      524        )
      525     then do:
      526       if self :handle <> focus :handle
      527       then do:
      528         apply "entry":u to self .
      529       end.
      530       define variable v-curr-sv-date as date no-undo .
      531       define variable v-new-sv-date  as date no-undo .
      532       assign
      533         v-curr-sv-date = date(self :screen-value) no-error
      534       .
      535       if v-curr-sv-date = ?
      536       then do:
      537         run gbl/getcurdt.p
      538           (output v-curr-sv-date
      539           ) .
      540       end.
      541       if v-curr-sv-date <> ?
      542       then do:
      543         assign
      544           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      545         .
      546         assign
      547           self :screen-value = string(v-new-sv-date) .
      548         .
      549       end.
      550     end.
      551     return no-apply .
      552   end.
      553   on ctrl-e of f-date-from in frame Dialog-Frame
      554   do:
      555     if (can-query (self, "sensitive")
      556        and
      557        self :sensitive = true
      558        )
      559     or (can-query (self, "read-only")
      560        and
      561        self :read-only = false
      562        )
      563     then do:
      564       if self :handle <> focus :handle
      565       then do:
      566         apply "entry":u to self .
      567       end.
      568       define variable v-curr-sv-date as date no-undo .
      569       define variable v-new-sv-date  as date no-undo .
      570       assign
      571         v-curr-sv-date = date(self :screen-value) no-error
      572       .
      573       if v-curr-sv-date = ?
      574       then do:
      575         run gbl/getcurdt.p
      576           (output v-curr-sv-date
      577           ) .
      578       end.
      579       if v-curr-sv-date <> ?
      580       then do:
      581         run gbl/lastdate.p
      582           (input  v-curr-sv-date
      583           ,output v-new-sv-date
      584           ).
      585         assign
      586           self :screen-value = string(v-new-sv-date) .
      587         .
      588       end.
      589     end.
      590     return no-apply .
      591   end.
      592   on ctrl-f of f-date-from in frame Dialog-Frame
      593   do:
