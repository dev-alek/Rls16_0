     1124   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1125     run mainmenu_getcntxt in parparentproc
     1126       (output v-cntxt-db-num
     1127       ,output v-cntxt-userid
     1128       ,output v-cntxt-level
     1129       ,output v-cntxt-host-code-obj
     1130       ,output v-cntxt-obj-type
     1131       ,output v-cntxt-obj-code
     1132       ,output v-cntxt-db-num-obj
     1133       ,output v-cntxt-is-admin
     1134       ) .
     1135   MAIN-BLOCK:
     1136   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1137      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1138     define buffer bf_clients for ub.clients.
     1139     define buffer bf_alc-type for ub.alc-type.
     1140     define buffer bf_alc-sale-lic-type for ub.alc-sale-lic-type.
     1141     if p-mode = 'ИЗМЕНЕНИЕ':U then do
     1142     transaction:
     1143        if p-rr = ? then do:
     1144           return error "ссылка на лицензию не передана".
     1145        end.
     1146        find first buf_alc-sale-lic
     1147             where recid(buf_alc-sale-lic) = p-rr
     1148             exclusive-lock
     1149             no-error
     1150             .
     1151        if not available buf_alc-sale-lic then do:
     1152           return error "неправильная ссылка на лицензию".
     1153        end.
     1154        assign
     1155          f-seria       = buf_alc-sale-lic.seria
     1156          f-number      = buf_alc-sale-lic.number
     1157          f-date-get    = buf_alc-sale-lic.date-get
     1158          f-who-are-got = buf_alc-sale-lic.who-are-got
     1159          f-date-from   = buf_alc-sale-lic.date-from
     1160          f-date-to     = buf_alc-sale-lic.date-to
     1161          t-all         = if buf_alc-sale-lic.all-type >= 1 then true else false
     1162        .
     1163        find first bf_clients
     1164             where bf_clients.obj-type = buf_alc-sale-lic.cli-type
     1165               and bf_clients.obj-code = buf_alc-sale-lic.cli-code
     1166             no-lock
     1167             no-error
     1168             .
     1169        if not available bf_clients then do:
     1170           return error substitute ("Фирма &1&2 не найдена.", buf_alc-sale-lic.cli-code, buf_alc-sale-lic.cli-type).
     1171        end.
     1172        assign
     1173           f-client = substitute( "&1&2, &3", bf_clients.obj-code, bf_clients.obj-type, bf_clients.obj-name )
     1174        .
     1175   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1176   define variable v-str-recid11 as character no-undo .
     1177   define variable v-num-entry11 as integer   no-undo .
     1178   assign
     1179     v-str-recid11 = trim( string( recid( bf_clients ) , "->>>>>>>>>>>9":U ) )
     1180     v-num-entry11 = lookup( v-str-recid11 , rid-list-sale )
     1181   .
     1182   if v-num-entry11 > 0 then do:
     1183     assign
     1184       entry( v-num-entry11, rid-list-sale ) = "":U
     1185       rid-list-sale = trim( replace( rid-list-sale , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1186     .
     1187   end.
     1188   else do:
     1189     assign
     1190       rid-list-sale = rid-list-sale + ( if rid-list-sale = "":U then "":U else chr(44) ) + v-str-recid11
     1191     .
     1192   end.
     1193        if t-all
     1194         then do:
     1195            assign
     1196               f-types = "выбраны"
     1197            .
     1198         end.
     1199         else do:
     1200            for each  bf_alc-sale-lic-type
     1201                where bf_alc-sale-lic-type.alc-sale-lic-code = buf_alc-sale-lic.alc-sale-lic-code
     1202                no-lock,
     1203                first bf_alc-type
     1204                where bf_alc-type.alc-type-inner-code = bf_alc-sale-lic-type.alc-type-inner-code
     1205                no-lock
     1206                :
     1207   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1208   define variable v-str-recid13 as character no-undo .
     1209   define variable v-num-entry13 as integer   no-undo .
     1210   assign
     1211     v-str-recid13 = trim( string( recid( bf_alc-type ) , "->>>>>>>>>>>9":U ) )
     1212     v-num-entry13 = lookup( v-str-recid13 , RowID-list )
     1213   .
     1214   if v-num-entry13 > 0 then do:
     1215     assign
     1216       entry( v-num-entry13, RowID-list ) = "":U
     1217       RowID-list = trim( replace( RowID-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1218     .
     1219   end.
     1220   else do:
     1221     assign
     1222       RowID-list = RowID-list + ( if RowID-list = "":U then "":U else chr(44) ) + v-str-recid13
     1223     .
     1224   end.
     1225            end.
     1226            if RowID-list = "" then DO:
     1227               assign
     1228                  f-types = "не выбраны"
     1229               .
     1230            end.
     1231            else do:
     1232               assign
     1233                  f-types = "выбраны"
     1234               .
     1235            end.
     1236         end.
     1237     end.
     1238     RUN enable_UI.
     1239     WAIT-FOR GO OF FRAME Dialog-Frame.
     1240   END.
     1241   RUN disable_UI.
     1242   PROCEDURE create-lic :
     1243       define buffer buf_clients for ub.clients .
     1244       define variable v-code as integer no-undo .
     1245        v-code = next-value(s-alc-sale-lic, ub).
     1246        create buf_alc-sale-lic.
     1247        assign
     1248          buf_alc-sale-lic.alc-sale-lic-code = v-code
     1249          buf_alc-sale-lic.seria       = f-seria
     1250          buf_alc-sale-lic.number      = f-number
     1251          buf_alc-sale-lic.date-get    = f-date-get
     1252          buf_alc-sale-lic.who-are-got = f-who-are-got
     1253          buf_alc-sale-lic.date-from   = f-date-from
     1254          buf_alc-sale-lic.date-to     = f-date-to
     1255          buf_alc-sale-lic.all-type    = if t-all  then 1 else 0
     1256          buf_alc-sale-lic.cli-type    = 'орг':U
     1257          buf_alc-sale-lic.cli-code    = v-cntxt-host-code-obj
     1258          buf_alc-sale-lic.create-user-db-num = v-cntxt-db-num
     1259          buf_alc-sale-lic.lic-status         = 0
     1260          buf_alc-sale-lic.create-user        = v-cntxt-userid
     1261          buf_alc-sale-lic.corr-user-name     = v-cntxt-userid
     1262          buf_alc-sale-lic.create-date        = today
     1263          buf_alc-sale-lic.corr-date          = today
     1264          buf_alc-sale-lic.create-time        = time
     1265          buf_alc-sale-lic.corr-time          = time
     1266        .
     1267         assign
     1268            p-rr = recid (buf_alc-sale-lic)
     1269         .
     1270   END PROCEDURE.
     1271   PROCEDURE disable_UI :
     1272     HIDE FRAME Dialog-Frame.
     1273   END PROCEDURE.
     1274   PROCEDURE enable_UI :
     1275     DISPLAY f-seria f-number f-date-get f-who-are-got f-date-from f-date-to t-all
     1276             f-client f-types
     1277         WITH FRAME Dialog-Frame.
     1278     ENABLE b-exit b-quit b-help f-seria f-number f-date-get f-who-are-got
     1279            f-date-from f-date-to b-types t-all f-client f-types
     1280         WITH FRAME Dialog-Frame.
     1281     VIEW FRAME Dialog-Frame.
     1282   END PROCEDURE.
     1283   PROCEDURE update-alc-type :
     1284   define buffer buf_alc-sale-lic-type for ub.alc-sale-lic-type .
     1285   define buffer buf_alc-type          for ub.alc-type     .
     1286     define variable v-count as integer no-undo .
     1287       for each  buf_alc-sale-lic-type
     1288           where buf_alc-sale-lic-type.alc-sale-lic-code = buf_alc-sale-lic.alc-sale-lic-code
     1289           exclusive-lock,
     1290           first buf_alc-type
     1291           where buf_alc-type.alc-type-inner-code = buf_alc-sale-lic-type.alc-type-inner-code
     1292           no-lock
     1293           :
     1294           if index(RowID-list, trim( string( recid(buf_alc-type) , "->>>>>>>>>>>9":U ) )) = 0 THEN do:
     1295              delete buf_alc-sale-lic-type.
     1296           end.
     1297       end.
     1298       DO v-count = 1 TO NUM-ENTRIES(RowID-list)
     1299       on error undo, next
     1300       :
     1301         find first buf_alc-type
     1302            where recid( buf_alc-type ) = INTEGER(ENTRY(v-count, RowID-list))
     1303            NO-LOCK
     1304            no-error.
     1305         IF AVAILABLE buf_alc-type
     1306         and not can-find( first buf_alc-sale-lic-type
     1307                           where buf_alc-sale-lic-type.alc-sale-lic-code   = buf_alc-sale-lic.alc-sale-lic-code
     1308                             and buf_alc-sale-lic-type.alc-type-inner-code = buf_alc-type.alc-type-inner-code)
     1309         THEN DO:
     1310            CREATE buf_alc-sale-lic-type.
     1311            ASSIGN
     1312               buf_alc-sale-lic-type.alc-sale-lic-code   = buf_alc-sale-lic.alc-sale-lic-code
     1313               buf_alc-sale-lic-type.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     1314               buf_alc-sale-lic-type.corr-date = today
     1315               buf_alc-sale-lic-type.corr-time = time
     1316               buf_alc-sale-lic-type.corr-user-name  = v-cntxt-userid
     1317               buf_alc-sale-lic-type.create-alc-type-user-db-num = v-cntxt-db-num
     1318               buf_alc-sale-lic-type.create-date = today
     1319               buf_alc-sale-lic-type.create-time = time
     1320               buf_alc-sale-lic-type.create-user = v-cntxt-userid
     1321               buf_alc-sale-lic-type.create-user-db-num = v-cntxt-db-num
     1322            .
     1323         END.
     1324        end.
     1325       FOR EACH buf_alc-sale-lic-type
     1326           EXCLUSIVE-LOCK
     1327           :
     1328           find first buf_alc-type
     1329                where buf_alc-type.alc-type-inner-code = buf_alc-sale-lic-type.alc-type-inner-code
     1330                NO-LOCK
     1331                no-error
     1332                .
     1333            IF NOT AVAILABLE buf_alc-type
     1334            OR INDEX( RowID-list, STRING(recid( buf_alc-type ))) = 0
     1335            THEN DO:
     1336               DELETE buf_alc-sale-lic-type.
     1337            END.
     1338       END.
     1339   END PROCEDURE.
     1340   PROCEDURE update-lic :
     1341       define buffer buf_clients for ub.clients .
     1342        find first buf_clients
     1343             where recid(buf_clients) = INTEGER(ENTRY(1, rid-list-sale))
     1344             no-lock
     1345             no-error
     1346             .
     1347        assign
     1348          buf_alc-sale-lic.seria       = f-seria
     1349          buf_alc-sale-lic.number      = f-number
     1350          buf_alc-sale-lic.date-get    = f-date-get
     1351          buf_alc-sale-lic.who-are-got = f-who-are-got
     1352          buf_alc-sale-lic.date-from   = f-date-from
     1353          buf_alc-sale-lic.date-to     = f-date-to
     1354          buf_alc-sale-lic.all-type    = if t-all  then 1 else 0
     1355          buf_alc-sale-lic.cli-code    = buf_clients.obj-code
     1356          buf_alc-sale-lic.cli-type    = buf_clients.obj-type
     1357          buf_alc-sale-lic.corr-user-name     = v-cntxt-userid
     1358          buf_alc-sale-lic.corr-date          = today
     1359          buf_alc-sale-lic.corr-time          = time
     1360        .
     1361   END PROCEDURE.
