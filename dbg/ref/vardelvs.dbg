     1759         or error-status :get-message(1) <> ""
     1760         then do:
     1761           undo move_block, retry move_block .
     1762         end.
     1763         for each buf_temp-browse-handle
     1764           where buf_temp-browse-handle.browse-type = 'height':u
     1765         on error undo move_block, retry move_block
     1766         :
     1767           assign
     1768             buf_temp-browse-handle.browse-handle :height
     1769               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1770             no-error .
     1771           if error-status :error
     1772           or error-status :get-message(1) <> ""
     1773           then do:
     1774             undo move_block, retry move_block .
     1775           end.
     1776         end.
     1777         for each buf_temp-diasize-handle
     1778         on error undo move_block, retry move_block
     1779         :
     1780           assign
     1781             v-object-handle = buf_temp-diasize-handle.handle-value
     1782           .
     1783           if v-object-handle <> v-diasize-resize-button
     1784           then do:
     1785             assign
     1786               v-object-handle :row = v-object-handle :row + p-change-value
     1787               no-error .
     1788             if error-status :error
     1789             or error-status :get-message(1) <> ""
     1790             then do:
     1791               undo move_block, retry move_block .
     1792             end.
     1793           end.
     1794         end.
     1795       end.
     1796       else do:
     1797         for each buf_temp-diasize-handle
     1798         on error undo move_block, retry move_block
     1799         :
     1800           assign
     1801             v-object-handle = buf_temp-diasize-handle.handle-value
     1802           .
     1803           if v-object-handle <> v-diasize-resize-button
     1804           then do:
     1805             assign
     1806               v-object-handle :row = v-object-handle :row + p-change-value
     1807               no-error .
     1808             if error-status :error
     1809             or error-status :get-message(1) <> ""
     1810             then do:
     1811               undo move_block, retry move_block .
     1812             end.
     1813           end.
     1814         end.
     1815         assign
     1816           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1817           no-error .
     1818         if error-status :error
     1819         or error-status :get-message(1) <> ""
     1820         then do:
     1821           undo move_block, retry move_block .
     1822         end.
     1823         for each buf_temp-browse-handle
     1824           where buf_temp-browse-handle.browse-type = 'height':u
     1825         on error undo move_block, retry move_block
     1826         :
     1827           assign
     1828             buf_temp-browse-handle.browse-handle :height
     1829               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1830             no-error .
     1831           if error-status :error
     1832           or error-status :get-message(1) <> ""
     1833           then do:
     1834             undo move_block, retry move_block .
     1835           end.
     1836         end.
     1837         assign
     1838           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1839           no-error .
     1840         if error-status :error
     1841         or error-status :get-message(1) <> ""
     1842         then do:
     1843           undo move_block, retry move_block .
     1844         end.
     1845         if frame Dialog-Frame :scrollable = true
     1846         then do:
     1847           assign
     1848             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1849             no-error .
     1850           if error-status :error
     1851           or error-status :get-message(1) <> ""
     1852           then do:
     1853             undo move_block, retry move_block .
     1854           end.
     1855         end.
     1856       end.
     1857       if p-move-resize = true
     1858       then do:
     1859         run diasize_position-resize-button in this-procedure .
     1860       end.
     1861       if v-diasize-wndstore = true
     1862       then do:
     1863         if connected("ub") = true
     1864         then do:
     1865           define variable v-cntxt-db-num        as integer   no-undo .
     1866           define variable v-cntxt-userid        as character no-undo .
     1867           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1868                                             , OUTPUT v-cntxt-userid
     1869                                             ) .
     1870           run gbl/wndsizew.p
     1871             (input  v-cntxt-db-num
     1872             ,input  v-cntxt-userid
     1873             ,input  v-diasize-proc-name
     1874             ,input  'height':u
     1875             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1876             ) .
     1877         end.
     1878       end.
     1879     end.
     1880     assign
     1881       v-diasize-change-size = false
     1882     .
     1883   end procedure.
     1884   procedure diasize_set-height :
     1885     define input  parameter p-new-height  as decimal   no-undo .
     1886     define input  parameter p-move-resize as logical   no-undo .
     1887     do
     1888     on error undo, return error return-value
     1889     :
     1890       run diasize_change-height in this-procedure
     1891         (input  (p-new-height - frame Dialog-Frame :height)
     1892         ,input  p-move-resize
     1893         ) .
     1894     end.
     1895   end procedure.
     1896   procedure diasize_change-width :
     1897     define input  parameter p-change-value as decimal   no-undo .
     1898     define input  parameter p-move-resize  as logical   no-undo .
     1899     define variable v-field-group-handle   as handle    no-undo .
     1900     define variable v-object-handle        as handle    no-undo .
     1901     define variable v-frame-width          as decimal   no-undo .
     1902     define variable v-frame-virtual-width  as decimal   no-undo .
     1903     define variable v-browse-width         as decimal   no-undo .
     1904     define variable v-window-width         as decimal   no-undo .
     1905     define variable v-window-virtual-width as decimal   no-undo .
     1906     define variable v-change-sign          as integer   no-undo .
     1907     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1908     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1909     if p-change-value > 0
     1910     then do:
     1911       if frame Dialog-Frame :width + p-change-value >
     1912           session :width-chars
     1913       then do:
     1914         assign
     1915           p-change-value = session :width-chars - frame Dialog-Frame :width
     1916         .
     1917         if p-change-value <= 0
     1918         then do:
     1919           run diasize_position-resize-button in this-procedure .
     1920           return .
     1921         end.
     1922       end.
     1923     end.
     1924     if p-change-value < 0
     1925     then do:
     1926       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1927       then do:
     1928         assign
     1929           p-change-value = v-diasize-orig-frame-width
     1930                          - frame Dialog-Frame :width
     1931         .
     1932         if p-change-value >= 0
     1933         then do:
     1934           run diasize_position-resize-button in this-procedure .
     1935           return .
     1936         end.
     1937       end.
     1938     end.
     1939     if p-change-value >= 0
     1940     then do:
     1941       assign
     1942         v-change-sign = 1
     1943       .
     1944     end.
     1945     else do:
     1946       assign
     1947         v-change-sign = -1
     1948       .
     1949     end.
     1950     assign
     1951       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1952     .
     1953     if p-change-value = 0
     1954     then do:
     1955       run diasize_position-resize-button in this-procedure .
     1956       return .
     1957     end.
     1958     move_block:
     1959     do
     1960     on error undo move_block, leave move_block
     1961     :
     1962       if retry
     1963       then do:
     1964         do
     1965         on error undo move_block, leave move_block
     1966         :
     1967           if p-change-value > 0
     1968           then do:
     1969             for each buf_temp-diasize-handle
     1970             on error undo, next
     1971             :
     1972               assign
     1973                 v-object-handle = buf_temp-diasize-handle.handle-value
     1974               .
