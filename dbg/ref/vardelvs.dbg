     2132           end.
     2133         end.
     2134         assign
     2135           frame Dialog-Frame :width = v-frame-width + p-change-value
     2136           no-error .
     2137         if error-status :error
     2138         or error-status :get-message(1) <> ""
     2139         then do:
     2140           undo move_block, retry move_block.
     2141         end.
     2142         assign
     2143           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2144         no-error .
     2145         if error-status :error
     2146         or error-status :get-message(1) <> ""
     2147         then do:
     2148           undo move_block, retry move_block.
     2149         end.
     2150         for each buf_temp-browse-handle
     2151           where buf_temp-browse-handle.browse-type = 'width':u
     2152         on error undo move_block, retry move_block
     2153         :
     2154           assign
     2155             buf_temp-browse-handle.browse-handle :width
     2156               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2157             no-error .
     2158           if error-status :error
     2159           or error-status :get-message(1) <> ""
     2160           then do:
     2161             undo move_block, retry move_block .
     2162           end.
     2163         end.
     2164         for each buf_temp-diasize-handle
     2165         on error undo move_block, retry move_block
     2166         :
     2167           assign
     2168             v-object-handle = buf_temp-diasize-handle.handle-value
     2169           .
     2170           if v-object-handle <> v-diasize-resize-button
     2171           then do:
     2172             assign
     2173               v-object-handle :col = v-object-handle :col + p-change-value
     2174               no-error .
     2175             if error-status :error
     2176             or error-status :get-message(1) <> ""
     2177             then do:
     2178               undo move_block, retry move_block .
     2179             end.
     2180           end.
     2181         end.
     2182       end.
     2183       else do:
     2184         for each buf_temp-diasize-handle
     2185         on error undo move_block, retry move_block
     2186         :
     2187           assign
     2188             v-object-handle = buf_temp-diasize-handle.handle-value
     2189           .
     2190           if v-object-handle <> v-diasize-resize-button
     2191           then do:
     2192             assign
     2193               v-object-handle :col = v-object-handle :col + p-change-value
     2194               no-error .
     2195             if error-status :error
     2196             or error-status :get-message(1) <> ""
     2197             then do:
     2198               undo move_block, retry move_block .
     2199             end.
     2200           end.
     2201         end.
     2202         for each buf_temp-browse-handle
     2203           where buf_temp-browse-handle.browse-type = 'width':u
     2204         on error undo move_block, retry move_block
     2205         :
     2206           assign
     2207             buf_temp-browse-handle.browse-handle :width
     2208               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2209             no-error .
     2210           if error-status :error
     2211           or error-status :get-message(1) <> ""
     2212           then do:
     2213             undo move_block, retry move_block .
     2214           end.
     2215         end.
     2216         assign
     2217           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2218           no-error .
     2219         if error-status :error
     2220         or error-status :get-message(1) <> ""
     2221         then do:
     2222           undo move_block, retry move_block.
     2223         end.
     2224         assign
     2225           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2226         no-error .
     2227         if error-status :error
     2228         or error-status :get-message(1) <> ""
     2229         then do:
     2230           undo move_block, retry move_block.
     2231         end.
     2232         if frame Dialog-Frame :scrollable = true
     2233         then do:
     2234           assign
     2235             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2236           no-error .
     2237           if error-status :error
     2238           or error-status :get-message(1) <> ""
     2239           then do:
     2240             undo move_block, retry move_block.
     2241           end.
     2242         end.
     2243       end.
     2244       if p-move-resize
     2245       then do:
     2246         run diasize_position-resize-button in this-procedure .
     2247       end.
     2248       if v-diasize-wndstore = true
     2249       then do:
     2250         if connected("ub") = true
     2251         then do:
     2252           define variable v-cntxt-db-num        as integer   no-undo .
     2253           define variable v-cntxt-userid        as character no-undo .
     2254           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2255                                             , OUTPUT v-cntxt-userid
     2256                                             ) .
     2257           run gbl/wndsizew.p
     2258             (input  v-cntxt-db-num
     2259             ,input  v-cntxt-userid
     2260             ,input  v-diasize-proc-name
     2261             ,input  'width':u
     2262             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2263             ) .
     2264         end.
     2265       end.
     2266     end.
     2267     assign
     2268       v-diasize-change-size = false
     2269     .
     2270   end procedure.
     2271   procedure diasize_set-width :
     2272     define input  parameter p-new-width  as decimal   no-undo .
     2273     define input  parameter p-move-resize as logical   no-undo .
     2274     do
     2275     on error undo, return error return-value
     2276     :
     2277       run diasize_change-width in this-procedure
     2278         (input  (p-new-width - frame Dialog-Frame :width)
     2279         ,input  p-move-resize
     2280         ) .
     2281     end.
     2282   end procedure.
     2283   procedure diasize_position-resize-button :
     2284     do with frame Dialog-Frame
     2285     :
     2286       hide v-diasize-resize-button .
     2287       assign
     2288         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2289                     - 1
     2290                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2291         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2292                     - 1
     2293                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2294       .
     2295       view v-diasize-resize-button .
     2296     end.
     2297   end procedure.
     2298   on alt-right anywhere
     2299   do:
     2300     run diasize_change-width in this-procedure
     2301       (input 1
     2302       ,input true
     2303       ) .
     2304     return no-apply .
     2305   end.
     2306   on alt-left anywhere
     2307   do:
     2308     run diasize_change-width in this-procedure
     2309       (input -1
     2310       ,input true
     2311       ) .
     2312     return no-apply .
     2313   end.
     2314   on alt-down anywhere
     2315   do:
     2316     run diasize_change-height in this-procedure
     2317       (input 1
     2318       ,input true
     2319       ) .
     2320     return no-apply .
     2321   end.
     2322   on alt-up anywhere
     2323   do:
     2324     run diasize_change-height in this-procedure
     2325       (input -1
     2326       ,input true
     2327       ) .
     2328     return no-apply .
     2329   end.
     2330   on alt-enter of frame Dialog-Frame
     2331   do:
     2332     run diasize_maximize in this-procedure
     2333       (input  ?
     2334       ).
     2335     return no-apply .
     2336   end.
     2337   procedure diasize_end-move :
     2338     do
     2339     on error undo, return error return-value
     2340     :
     2341       define variable v-row-delta as decimal   no-undo .
     2342       define variable v-col-delta as decimal   no-undo .
     2343       define variable v-new-row as decimal   no-undo .
     2344       define variable v-new-col as decimal   no-undo .
     2345       assign
     2346         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2347         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2348       .
     2349       assign
     2350         v-row-delta = v-new-row - frame Dialog-Frame :height
     2351         v-col-delta = v-new-col - frame Dialog-Frame :width
     2352       .
     2353       run diasize_change-height in this-procedure
     2354         (input v-row-delta
     2355         ,input true
     2356         ) .
     2357       run diasize_change-width in this-procedure
     2358         (input v-col-delta
     2359         ,input true
     2360         ) .
     2361     end.
     2362   end procedure.
     2363   procedure diasize_maximize :
     2364     define input  parameter p-action as logical   no-undo .
     2365     do
     2366     on error undo, return error return-value
     2367     :
     2368       if p-action = ?
     2369       then do:
     2370         if v-diasize-need-maximize = true
     2371         then do:
     2372           assign
     2373             p-action = true
     2374           .
     2375         end.
     2376         else do:
     2377           assign
     2378             p-action = false
     2379           .
     2380         end.
     2381       end.
     2382       if p-action = true
     2383       then do:
     2384         run diasize_change-height in this-procedure
     2385           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2386               - frame Dialog-Frame :height-chars
     2387           ,input true
     2388           ) .
     2389         run diasize_change-width in this-procedure
     2390           (input session :width-chars
     2391               - frame Dialog-Frame :width-chars
     2392           ,input true
     2393           ) .
     2394         assign
     2395           v-diasize-need-maximize = false
     2396         .
     2397       end.
     2398       else do:
     2399         run diasize_change-width in this-procedure
     2400           (input v-diasize-orig-frame-width
     2401               - frame Dialog-Frame :width-chars
     2402           ,input true
     2403           ) .
     2404         run diasize_change-height in this-procedure
     2405           (input v-diasize-orig-frame-height
     2406               - frame Dialog-Frame :height-chars
     2407           ,input true
     2408           ) .
     2409         assign
     2410           v-diasize-need-maximize = true
     2411         .
     2412       end.
     2413     end.
     2414   end procedure.
     2415   procedure diasize_restore-orig-size :
     2416     do
     2417     on error undo, return error return-value
     2418     :
     2419       assign
     2420         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2421         v-diasize-current-frame-height = frame Dialog-Frame :height
     2422       .
     2423       run diasize_set-height in this-procedure
     2424         (input  v-diasize-orig-frame-height
     2425         ,input  true
     2426         ) .
     2427       run diasize_set-width in this-procedure
     2428         (input  v-diasize-orig-frame-width
     2429         ,input  true
     2430         ) .
     2431     end.
     2432   end procedure.
     2433   procedure diasize_restore-current-size :
     2434     do
     2435     on error undo, return error return-value
     2436     :
     2437       run diasize_set-height in this-procedure
     2438         (input  v-diasize-current-frame-height
     2439         ,input  true
     2440         ) .
     2441       run diasize_set-width in this-procedure
     2442         (input  v-diasize-current-frame-width
     2443         ,input  true
     2444         ) .
     2445     end.
     2446   end procedure.
     2447   procedure diasize_set-browse-handle :
     2448     define input  parameter p-browse-handle as handle   no-undo .
     2449     define buffer buf_temp-browse-handle for temp-browse-handle .
     2450     do
     2451     on error undo, return error return-value
     2452     :
     2453       assign
     2454         v-diasize-browse-handle = p-browse-handle
     2455       .
     2456       for each buf_temp-browse-handle
     2457       on error undo, return error return-value
     2458       :
     2459         delete buf_temp-browse-handle .
     2460       end.
     2461     end.
     2462   end procedure.
     2463   procedure diasize_add_browse :
     2464     define input  parameter p-browse-type   as character no-undo .
     2465     define input  parameter p-browse-handle as handle    no-undo .
     2466     define buffer buf_temp-browse-handle for temp-browse-handle .
     2467     do
     2468     on error undo, return error return-value
     2469     :
     2470       assign
     2471         v-diasize-browse-number = v-diasize-browse-number + 1
     2472       .
     2473       create buf_temp-browse-handle .
     2474       assign
     2475         buf_temp-browse-handle.browse-type   = p-browse-type
     2476         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2477         buf_temp-browse-handle.browse-handle = p-browse-handle
     2478       .
     2479     end.
     2480   end procedure.
     2481   procedure diasize_init :
     2482     define variable v-default-value    as logical   no-undo .
     2483     define variable v-restore-saved    as logical   no-undo .
     2484     define variable v-resize-value-str as character no-undo .
     2485     do
     2486     on error undo, return error return-value
     2487     :
     2488       do with frame Dialog-Frame
     2489       :
     2490         assign
     2491           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2492           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2493           v-diasize-browse-handle     = browse br-vardeliv :handle
     2494         .
     2495         create button v-diasize-resize-button
     2496         assign
     2497           parent        = frame Dialog-Frame :first-child
     2498           label         = "s"
     2499           height-pixels = 16
     2500           width-pixels  = 16
     2501           visible       = true
     2502           sensitive     = true
     2503           movable       = true
     2504           triggers:
     2505             on end-move persistent run diasize_end-move in this-procedure .
     2506           end triggers.
     2507         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2508         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2509         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2510         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2511         assign
     2512           v-diasize-wndmax = false
     2513         .
     2514         if connected("ub") = true
     2515         then do:
     2516           define variable v-cntxt-db-num        as integer   no-undo .
     2517           define variable v-cntxt-userid        as character no-undo .
     2518           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2519                                             , OUTPUT v-cntxt-userid
     2520                                             ) .
     2521           run gbl/wndpar_r.p
     2522             (input  v-cntxt-db-num
     2523             ,input  v-cntxt-userid
     2524             ,input  'wndmax':U
     2525             ,output v-diasize-wndmax
     2526             ,output v-default-value
     2527             ) .
     2528         end.
     2529         assign
     2530           v-diasize-wndstore = false
     2531         .
     2532         if connected("ub") = true
     2533         then do:
     2534           run gbl/wndpar_r.p
     2535             (input  v-cntxt-db-num
     2536             ,input  v-cntxt-userid
     2537             ,input  'wndstore':U
     2538             ,output v-diasize-wndstore
     2539             ,output v-default-value
     2540             ) .
     2541         end.
     2542         assign
     2543           v-diasize-proc-name = entry(1, program-name(2), '.')
     2544         .
     2545         if v-diasize-wndstore = true
     2546         then do:
     2547           assign
     2548             v-restore-saved = false
     2549           .
     2550           if connected("ub") = true
     2551           then do:
     2552             run gbl/wndsizer.p
     2553               (input  v-cntxt-db-num
     2554               ,input  v-cntxt-userid
     2555               ,input  v-diasize-proc-name
     2556               ,input  'height':u
     2557               ,output v-resize-value-str
     2558               ) .
     2559             if v-resize-value-str <> '':U
     2560             then do:
     2561               run diasize_change-height in this-procedure
     2562                 (input  integer(v-resize-value-str)
     2563                 ,input  true
     2564                 ) .
     2565               assign
     2566                 v-restore-saved = true
     2567               .
     2568             end.
     2569           end.
     2570           if connected("ub") = true
     2571           then do:
     2572             run gbl/wndsizer.p
     2573               (input  v-cntxt-db-num
     2574               ,input  v-cntxt-userid
     2575               ,input  v-diasize-proc-name
     2576               ,input  'width':u
     2577               ,output v-resize-value-str
     2578               ) .
     2579             if v-resize-value-str <> '':U
     2580             then do:
     2581               run diasize_change-width in this-procedure
     2582                 (input  integer(v-resize-value-str)
     2583                 ,input  true
     2584                 ) .
     2585               assign
     2586                 v-restore-saved = true
     2587               .
     2588             end.
     2589           end.
     2590           if v-restore-saved <> true
     2591           then do:
     2592             if v-diasize-wndmax = true
     2593             then do:
     2594               run diasize_maximize in this-procedure
     2595                 (input  true
     2596                 ) .
     2597             end.
     2598           end.
     2599         end.
     2600         else do:
     2601           if v-diasize-wndmax = true
     2602           then do:
     2603             run diasize_maximize in this-procedure
     2604               (input  true
     2605               ) .
     2606           end.
     2607         end.
     2608       end.
     2609     end.
     2610   end procedure.
     2611   procedure diasize_need-full-display :
     2612     define output parameter p-need-full-display as logical   no-undo .
     2613     do
     2614     on error undo, return error return-value
     2615     :
     2616       assign
     2617         p-need-full-display = v-diasize-need-full-display
     2618       .
     2619       assign
     2620         v-diasize-need-full-display = false
     2621       .
     2622     end.
     2623   end procedure.
     2624   procedure get-context :
     2625      define output parameter p-db-num as integer          no-undo.
     2626      define output parameter p-user-id as character        no-undo.
     2627      define variable v-login               as character    no-undo.
     2628      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2629      define buffer buf_user-login  for ub.user-login .
     2630      do
     2631      on error undo, return error
     2632      :
     2633            FIND FIRST buf_sys-ctrl no-lock.
     2634            ASSIGN
     2635               v-login = USERID("ub")
     2636               p-db-num = buf_sys-ctrl.db-num
     2637            .
     2638            FIND FIRST buf_user-login
     2639                 WHERE buf_user-login.db-num = p-db-num
     2640                   AND buf_user-login.user-login = v-login
     2641                 no-lock
     2642                 no-error
     2643                 .
     2644            IF AVAILABLE buf_user-login
     2645            THEN DO:
     2646               assign
     2647                  p-user-id = buf_user-login.user-id
     2648               .
     2649            END.
     2650      end.
     2651   end procedure.
     2652       run diasize_init in this-procedure .
     2653   def var sort-labelbr-vardeliv   as character no-undo .
     2654   def var sort-clmnbr-vardeliv    as handle    no-undo .
     2655   def var cur-clmnbr-vardeliv     as handle    no-undo .
     2656   def var cur-clmn-locbr-vardeliv as integer   no-undo .
     2657   def var re-querybr-vardeliv     as logical   initial no no-undo .
     2658   on start-search, ctrl-o of br-vardeliv in frame Dialog-Frame do:
     2659      run sort-brbr-vardeliv
     2660        (input (if available X_variant-delivery
     2661                then recid(X_variant-delivery)
     2662                else ?
     2663               )
     2664        ).
     2665   end.
     2666   PROCEDURE sort-brbr-vardeliv :
     2667     define input parameter p-recid as recid no-undo .
     2668     if re-querybr-vardeliv = no then do:
     2669       assign
     2670          cur-clmnbr-vardeliv = br-vardeliv:current-column in frame Dialog-Frame
     2671       .
     2672       if sort-clmnbr-vardeliv <> ? then sort-clmnbr-vardeliv:column-fgcolor = 0.
     2673       if cur-clmnbr-vardeliv = sort-clmnbr-vardeliv then do:
     2674         assign
     2675            sort-labelbr-vardeliv = ""
     2676            sort-clmnbr-vardeliv = ?
     2677         .
     2678        end.
     2679        else do:
     2680          assign
     2681            sort-labelbr-vardeliv = cur-clmnbr-vardeliv:label
     2682            sort-clmnbr-vardeliv  = cur-clmnbr-vardeliv
     2683            sort-clmnbr-vardeliv:column-fgcolor = 4
     2684          .
     2685        end.
     2686      end.
     2687     assign
     2688       cur-clmn-locbr-vardeliv = 1
     2689     .
     2690     def var column-handle as handle no-undo .
     2691     column-handle = br-vardeliv:first-column.
     2692     do while valid-handle(column-handle) :
     2693       if column-handle = cur-clmnbr-vardeliv then do:
     2694         leave .
     2695       end.
     2696       column-handle = column-handle:NEXT-COLUMN.
     2697       assign
     2698         cur-clmn-locbr-vardeliv = cur-clmn-locbr-vardeliv + 1
     2699       .
     2700     end.
     2701     case sort-labelbr-vardeliv:
     2702           when X_variant-delivery.deliv-type-code:label in browse br-vardeliv then DO:    assign       sort-column-name = "X_variant-delivery.deliv-type-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2703           when X_variant-delivery.deliv-subj-code:label in browse br-vardeliv then DO:    assign       sort-column-name = "X_variant-delivery.deliv-subj-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2704       otherwise do:
     2705         assign
     2706           sort-column-name = ""
     2707         .
     2708         run OpenBr in this-procedure ( input yes, input no, input '':U).
     2709           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-vardeliv') then do:
     2710             run mv-brw-defaultbr-vardeliv.
     2711           end.
     2712         if sort-labelbr-vardeliv <> "" then do:
     2713           assign
     2714             cur-clmnbr-vardeliv:column-fgcolor = 0
     2715           .
     2716         end.
     2717         assign
     2718           cur-clmn-locbr-vardeliv = ?
     2719         .
     2720       end.
     2721     end case.
     2722       if cur-clmn-locbr-vardeliv <> ? then do:
     2723         if can-do( this-procedure:internal-entries, 'ch-clmnbr-vardeliv') then do:
     2724           run ch-clmnbr-vardeliv in this-procedure (cur-clmn-locbr-vardeliv).
     2725         end.
     2726       end.
     2727     if p-recid <> ? then do:
     2728       reposition br-vardeliv to recid p-recid no-error.
     2729       apply "value-changed" to br-vardeliv in frame Dialog-Frame.
     2730     end.
     2731     apply "entry" to br-vardeliv in frame Dialog-Frame.
     2732   END PROCEDURE.
     2733   procedure re-open-query-srt-clmnbr-vardeliv:
     2734   if cur-clmnbr-vardeliv = ? then do:
     2735      run OpenBr in this-procedure ( input yes, input no, input '':U).
     2736   end.
     2737   else do:
     2738      assign re-querybr-vardeliv = yes.
     2739      run sort-brbr-vardeliv
     2740        (input (if available X_variant-delivery
     2741                then recid(X_variant-delivery)
     2742                else ?
     2743               )
     2744        ).
     2745      assign re-querybr-vardeliv = no.
     2746   end.
     2747   end.
     2748   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2749   DEF VAR cur-clmn-numbr-vardeliv as INT EXTENT 9 no-undo.
     2750   DEF VAR varmvibr-vardeliv       as INT no-undo.
     2751   DEF VAR varmvjbr-vardeliv       as INT no-undo.
     2752   DEF VAR varmvkbr-vardeliv       as INT no-undo.
     2753   DEF VAR varmvlbr-vardeliv       as INT no-undo.
     2754   DEF VAR move-elementbr-vardeliv as INT no-undo.
     2755   def var jjbr-vardeliv           as int no-undo.
     2756   do varmvibr-vardeliv = 1 to EXTENT(cur-clmn-numbr-vardeliv):
     2757     ASSIGN cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = varmvibr-vardeliv.
     2758   END.
     2759   RUN start-mv-clmnbr-vardeliv.
     2760   PROCEDURE start-mv-clmnbr-vardeliv:
     2761   def var old-session as logical no-undo.
     2762      old-session = SESSION:IMMEDIATE-DISPLAY.
     2763      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2764          IF  p-mode = 'все':U  THEN DO:
     2765      DO jjbr-vardeliv = NUM-ENTRIES('1,2,3,4,5,6,7,8,9') TO 1 BY -1:
     2766        RUN re-move-clmnbr-vardeliv ( cur-clmn-numbr-vardeliv[INTEGER(ENTRY (jjbr-vardeliv, '1,2,3,4,5,6,7,8,9'))] , 1).
     2767      END.
     2768          END.
     2769          IF  p-mode = 'delivery-type-subject'  THEN DO:
     2770      DO jjbr-vardeliv = NUM-ENTRIES('1,2,5,6,7,8,9,3,4') TO 1 BY -1:
     2771        RUN re-move-clmnbr-vardeliv ( cur-clmn-numbr-vardeliv[INTEGER(ENTRY (jjbr-vardeliv, '1,2,5,6,7,8,9,3,4'))] , 1).
     2772      END.
     2773          END.
     2774          IF  p-mode = 'объект':U  THEN DO:
     2775      DO jjbr-vardeliv = NUM-ENTRIES('1,2,3,4,5,6,8,9,7') TO 1 BY -1:
     2776        RUN re-move-clmnbr-vardeliv ( cur-clmn-numbr-vardeliv[INTEGER(ENTRY (jjbr-vardeliv, '1,2,3,4,5,6,8,9,7'))] , 1).
     2777      END.
     2778          END.
     2779      SESSION:IMMEDIATE-DISPLAY = old-session.
     2780   END.
     2781   ON ctrl-cursor-right OF BROWSE br-vardeliv do:
     2782     RUN re-move-clmnbr-vardeliv ( 1, 9).
     2783   END.
     2784   ON ctrl-cursor-left OF BROWSE br-vardeliv do:
     2785     RUN re-move-clmnbr-vardeliv (9, 1).
     2786   END.
     2787   PROCEDURE re-move-clmnbr-vardeliv:
     2788     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2789     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2790     DO varmvibr-vardeliv = 1 TO EXTENT(cur-clmn-numbr-vardeliv):
     2791       if cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = source-column THEN cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = -1.
     2792     END.
     2793     if br-vardeliv:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2794     if source-column > target-column THEN
     2795     DO varmvjbr-vardeliv = source-column - 1 to target-column BY -1:
     2796       DO varmvibr-vardeliv = 1 TO EXTENT(cur-clmn-numbr-vardeliv):
     2797           if cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = varmvjbr-vardeliv THEN DO:
     2798             cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = cur-clmn-numbr-vardeliv[varmvibr-vardeliv] + 1.
     2799           END.
     2800       END.
     2801     END.
     2802     ELSE
     2803     DO varmvjbr-vardeliv = source-column + 1 to target-column:
     2804       DO varmvibr-vardeliv = 1 TO EXTENT(cur-clmn-numbr-vardeliv):
     2805         if cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = varmvjbr-vardeliv THEN DO:
     2806           cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = cur-clmn-numbr-vardeliv[varmvibr-vardeliv] - 1.
     2807         END.
     2808       END.
     2809     END.
     2810     DO varmvibr-vardeliv = 1 TO EXTENT(cur-clmn-numbr-vardeliv):
     2811       if cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = -1 THEN cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = target-column.
     2812     END.
     2813   END PROCEDURE.
     2814   PROCEDURE ch-clmnbr-vardeliv:
     2815     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2816     if cur-clmn-loc <= 1 then do:
     2817       return .
     2818     end.
     2819     DO varmvibr-vardeliv = 1 TO EXTENT(cur-clmn-numbr-vardeliv):
     2820       if cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = cur-clmn-loc THEN move-elementbr-vardeliv = varmvibr-vardeliv.
     2821     END.
     2822     RUN re-move-clmnbr-vardeliv (cur-clmn-loc, 1).
     2823   END PROCEDURE.
     2824   PROCEDURE mv-brw-defaultbr-vardeliv:
     2825   def var old-session as logical no-undo.
     2826     old-session = SESSION:IMMEDIATE-DISPLAY.
     2827     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2828     do varmvlbr-vardeliv = 1 to EXTENT(cur-clmn-numbr-vardeliv):
     2829       RUN re-move-clmnbr-vardeliv (cur-clmn-numbr-vardeliv[varmvlbr-vardeliv], varmvlbr-vardeliv).
     2830     END.
     2831     RUN start-mv-clmnbr-vardeliv.
     2832     SESSION:IMMEDIATE-DISPLAY = old-session.
     2833   END PROCEDURE.
     2834   .
