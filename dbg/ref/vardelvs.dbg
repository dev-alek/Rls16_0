     2058       assign
     2059         v-frame-width = frame Dialog-Frame :width
     2060         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2061         v-browse-width = v-diasize-browse-handle :width
     2062       .
     2063       for each buf_temp-browse-handle
     2064         where buf_temp-browse-handle.browse-type = 'width':u
     2065       :
     2066         assign
     2067           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2068         .
     2069       end.
