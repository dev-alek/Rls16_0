     2087           and can-query(v-object-handle, "height")
     2088           and ( v-object-handle :col + v-object-handle :width
     2089                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2090               )
     2091           then do:
     2092             find first buf_temp-browse-handle
     2093               where buf_temp-browse-handle.browse-type   = 'width':u
     2094                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2095               no-error .
     2096             if available buf_temp-browse-handle
     2097             then do:
     2098             end.
     2099             else do:
     2100               create buf_temp-diasize-handle .
     2101               assign
     2102                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2103                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2104               .
     2105             end.
     2106           end.
     2107           assign
     2108             v-object-handle = v-object-handle :next-sibling
     2109           .
     2110         end.
     2111         assign
     2112           v-field-group-handle = v-field-group-handle :next-sibling
     2113         .
     2114       end.
     2115       do with frame Dialog-Frame
     2116       :
     2117         hide v-diasize-resize-button .
     2118         v-diasize-resize-button :row = 1.
     2119         v-diasize-resize-button :column = 1.
     2120       end.
     2121       if p-change-value > 0
     2122       then do:
     2123         if frame Dialog-Frame :scrollable = true
     2124         then do:
     2125           assign
     2126             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2127             no-error .
     2128           if error-status :error
     2129           or error-status :get-message(1) <> ""
     2130           then do:
