     4246                     ,input-output v-sts
     4247                    ) no-error .
     4248     if error-status:error then undo, return error.
     4249     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4250     REPOSITION br-vardeliv to recid loc-doc-rec No-error.
     4251     if error-status:error then do:                           find first pos_variant-delivery no-lock where                                   recid(pos_variant-delivery) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ВАРИАНТ ДОСТАВКИ" skip                            string(if avail pos_variant-delivery                                     then  substitute("Вн код типа доставки: &1 вн код субъекта доставки: &2 объект доставки: &3&4"                                                     , pos_variant-delivery.deliv-type-code                                                     , pos_variant-delivery.deliv-subj-code                                                     , pos_variant-delivery.obj-type                                                     , pos_variant-delivery.obj-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     4252     if available X_variant-delivery then do:
     4253       loc#log = br-vardeliv:select-focused-row( ) IN FRAME Dialog-Frame.
     4254     end.
     4255     apply "ENTRY" to br-vardeliv.
     4256   end.
     4257   END PROCEDURE.
     4258   PROCEDURE proc-b-print :
     4259   define variable v-doc-rec as recid no-undo .
     4260   define variable accum-count as integer.
     4261   define variable date_string     as      char    no-undo.
     4262   define variable Line            as      char    no-undo.
     4263   DEFINE VARIABLE v-sts-chr AS CHARACTER NO-UNDO.
     4264   define variable v-deliv-type-name like ub.delivery-type.deliv-type-name no-undo .
     4265   define variable v-deliv-subj-name like ub.delivery-subject.deliv-subj-name no-undo .
     4266   define variable v-obj as character no-undo .
     4267   DEFINE FRAME variant-delivery-list
     4268   v-sts-chr FORMAT "X(8)" COLUMN-LABEL "Статус"
     4269   X_variant-delivery.deliv-type-code COLUMN-LABEL "Вн.код!тип доставки"
     4270   v-deliv-type-name COLUmn-LABEL "Тип доставки" format "X(25)"
     4271   X_variant-delivery.deliv-subj-code COLUMN-LABEL "Вн.код!субъекта!доставки"
     4272   v-deliv-subj-name COLUmn-LABEL "Субъект доставки" format "X(25)"
     4273   v-obj COLUMn-LABEL "Объект!доставки" format "X(8)"
     4274   X_variant-delivery.des FORMAT "X(100)"
     4275   HEADER  date_string AT 5 format "X(35)"
     4276    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     4277   Line format "X(195)" AT 1
     4278   with width 232 down stream-io use-text    .
     4279   Line = fill("-", 195).
     4280   date_string = cur-time-print() .
     4281   run prn-lib-open-stream  in this-procedure (
     4282                                                input parParentProc
     4283                                               ,input 43
     4284                                               ,input yes
     4285                                               ,input no
     4286                                               ).
     4287   PUT  STREAM PrnLibStream
     4288   SPACE(25) ( frame Dialog-Frame:title )
     4289   format "x(90)" SKIP(1) .
     4290   FORM HEADER
     4291   Line format "X(195)" AT 1 SKIP
     4292   "Продолжение - на следующей странице" AT 30 SKIP
     4293   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4294   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4295   FORM with FRAME variant-delivery-list  .
     4296   run waitfram-show in this-procedure ("Ждите...").
     4297   v-doc-rec = recid(X_variant-delivery).
     4298   DO WHILE available X_variant-delivery :
     4299     GET prev br-vardeliv.
     4300   END.
     4301   GET next br-vardeliv.
     4302   DO WHILE available X_variant-delivery :
     4303     Display STREAM PrnLibStream
     4304     entry (lookup (STRING(p-sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) @ v-sts-chr
     4305     X_variant-delivery.deliv-type-code
     4306     get-type(X_variant-delivery.deliv-type-code) @ v-deliv-type-name
     4307     X_variant-delivery.deliv-subj-code
     4308     get-subject(X_variant-delivery.deliv-subj-code) @ v-deliv-subj-name
     4309     (X_variant-delivery.obj-type + string(X_variant-delivery.obj-code)) @ v-obj
     4310     X_variant-delivery.des
     4311     with FRAME variant-delivery-list .
     4312     DOWN STREAM PrnLibStream 1
     4313     with FRAME variant-delivery-list  .
     4314     assign
     4315     accum-count = accum-count + 1
     4316     .
     4317     GET next br-vardeliv.
     4318   END.
     4319   UNDERLINE  STREAM PrnLibStream
     4320   v-sts-chr
     4321   X_variant-delivery.deliv-type-code
     4322   v-deliv-type-name
     4323   X_variant-delivery.deliv-subj-code
     4324   v-deliv-subj-name
     4325   v-obj
     4326   X_variant-delivery.des
     4327   with FRAME variant-delivery-list .
     4328   DISPLAY STREAM PrnLibStream
     4329   accum-count @ v-sts-chr
     4330   with frame variant-delivery-list.
     4331   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4332   HIDE  STREAM PrnLibStream FRAME variant-delivery-List.
     4333   output  STREAM PrnLibStream CLOSE.
     4334   REPOSITION br-vardeliv to recid v-doc-rec no-error.
     4335   APPLY "entry" to br-vardeliv.
     4336   run waitfram-hide in this-procedure .
     4337   run prn-lib-prn-file in this-procedure (
     4338                                             input parParentProc
     4339                                             ,input 8
     4340                                             ).
     4341   END PROCEDURE.
     4342   PROCEDURE proc-b-sch :
     4343   assign
     4344     tbl = 'variant-delivery'
     4345     join-tbl = 'X_variant-delivery'
     4346     fld = ""
     4347     lab = ""
     4348     spr = ""
     4349     dim = '0'
     4350     .
     4351   run fltfield-add in this-procedure('deliv-type-code', 'Код типа доставки', '',
     4352   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4353   run fltfield-add in this-procedure('delive-subj-code', 'Код субъекта доставки', '',
     4354   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4355   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект доставки', 'cli',
     4356   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4357   run fltfield-add in this-procedure('des', 'Описание', '',
     4358   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4359   run fltfield-add in this-procedure('sts', 'Статус', '',
     4360   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4361   run fltfield-add in this-procedure('term-delivery', 'Срок доставки', '',
     4362   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4363   Filter-Block:
     4364   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4365       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4366       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4367     run gbl/filter.w ( INPUT parparentproc
     4368                      , INPUT (filter-point + chr(4) + filter-label0)
     4369                      , INPUT tbl
     4370                      , INPUT join-tbl
     4371                      , INPUT fld
     4372                      , INPUT lab
     4373                      , INPUT spr
     4374                      , INPUT dim ).
     4375     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4376   END.
     4377   END PROCEDURE.
     4378   PROCEDURE proc-br-vardeliv :
     4379   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4380   if b-sel:sensitive in frame Dialog-Frame then dO:
     4381       if b-mark:sensitive then do:
     4382           apply "choose" to b-mark in frame Dialog-Frame.
     4383       end.
     4384       else do:
     4385           apply "choose" to b-sel in frame Dialog-Frame.
     4386       end.
     4387   end.
     4388   else do:
     4389       if b-lkp:sensitive then
     4390       apply "choose" to b-lkp in frame Dialog-Frame.
     4391   end.
     4392   END PROCEDURE.
     4393   FUNCTION get-subject RETURNS CHARACTER
     4394     ( INPUT p-deliv-subj-code AS INTEGER) :
     4395   DEFINE BUFFER loc_delivery-subject FOR ub.delivery-subject.
     4396   FIND FIRST loc_delivery-subject NO-LOCK WHERE
     4397             loc_delivery-subject.deliv-subj-code = p-deliv-subj-code NO-ERROR.
     4398   IF AVAILABLE loc_delivery-subject THEN RETURN loc_delivery-subject.deliv-subj-name.
     4399     RETURN "Неизв.субъект доставки".
     4400   END FUNCTION.
     4401   FUNCTION get-type RETURNS CHARACTER
     4402   ( INPUT p-deliv-type-code AS INTEGER) :
     4403   DEFINE BUFFER loc_delivery-type FOR ub.delivery-type.
     4404   FIND FIRST loc_delivery-type NO-LOCK WHERE
     4405             loc_delivery-type.deliv-type-code = p-deliv-type-code NO-ERROR.
     4406   IF AVAILABLE loc_delivery-type THEN RETURN loc_delivery-type.deliv-type-name.
     4407     RETURN "Неизв.тип доставки".
     4408   END FUNCTION.
