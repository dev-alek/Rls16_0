     2899   MAIN-BLOCK:
     2900   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2901      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2902   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2903     run mainmenu_getcntxt in parparentproc
     2904       (output v-cntxt-db-num
     2905       ,output v-cntxt-userid
     2906       ,output v-cntxt-level
     2907       ,output v-cntxt-host-code-obj
     2908       ,output v-cntxt-obj-type
     2909       ,output v-cntxt-obj-code
     2910       ,output v-cntxt-db-num-obj
     2911       ,output v-cntxt-is-admin
     2912       ) .
     2913     v-rid-list = p-rid-list.
     2914     find first X_curr_clients no-lock where
     2915               X_curr_clients.obj-type = p-curr-obj-type
     2916          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
     2917     if not available X_curr_clients then do:
     2918       message
     2919       vss-workfile vss-revision vss-description skip
     2920       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
     2921       p-curr-obj-type p-curr-obj-code
     2922       view-as alert-box ERROR.
     2923       return error .
     2924     end.
     2925    if LOOKUP(p-mode, ('все':U + chr(4) + "delivery-type-subject":U + chr(4) + 'объект':U) ,
     2926                   chr(4)) = 0
     2927        then dO:
     2928       message
     2929       vss-workfile vss-revision vss-description skip
     2930       "Неверное значение параметров вызова p-mode"
     2931       p-mode
     2932       view-as alert-box ERROR.
     2933       return error .
     2934    end.
     2935    IF p-mode = "delivery-type-subject" THEN DO:
     2936        FIND FIRST X_delivery-type NO-LOCK WHERE
     2937                   X_delivery-type.deliv-type-code = p-deliv-type-code NO-ERROR.
     2938       IF NOT AVAILABLE X_delivery-type THEN DO:
     2939           MESSAGE
     2940           vss-workfile vss-revision vss-description skip
     2941           "Неверное значение параметров вызова p-deliv-type-code"
     2942           p-DELIV-TYPE-CODE
     2943           view-as alert-box ERROR.
     2944           return error .
     2945      END.
     2946    END.
     2947   IF p-mode = "delivery-type-subject":U THEN DO:
     2948        FIND FIRST X_delivery-subject NO-LOCK WHERE
     2949                   X_delivery-subject.deliv-subj-code = p-deliv-subj-code NO-ERROR.
     2950       IF NOT AVAILABLE X_delivery-subject THEN DO:
     2951           MESSAGE
     2952           vss-workfile vss-revision vss-description skip
     2953           "Неверное значение параметров вызова p-deliv-subj-code"
     2954           p-DELIV-subj-CODE
     2955           view-as alert-box ERROR.
     2956           return error .
     2957      END.
     2958    END.
     2959    if p-mode = 'объект':U then do:
     2960       FIND FIRST X_clients no-lock where
     2961                 X_clients.obj-type = p-deliv-obj-type
     2962            AND  X_clients.obj-code = p-deliv-obj-code no-error .
     2963       if not available X_clients then do:
     2964           MESSAGE
     2965           vss-workfile vss-revision vss-description skip
     2966           "Неверное значение параметров вызова p-deliv-obj-type и/или p-deliv-obj-code"
     2967           p-DELIV-obj-type p-deliv-obj-CODE
     2968           view-as alert-box ERROR.
     2969           return error .
     2970       end.
     2971    end.
     2972   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2973   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2974     (output v-db-num
