     1089         get-type(X_variant-delivery.deliv-type-code) COLUMN-LABEL "Тип доставки" FORMAT "X(25)":U
     1090         X_variant-delivery.deliv-subj-code COLUMN-LABEL "Вн.код!субъекта!доставки" FORMAT ">>9":U
     1091         get-subject(X_variant-delivery.deliv-subj-code) COLUMN-LABEL "Субъект доставки" FORMAT "X(25)":U
     1092         X_variant-delivery.obj-type + string(X_variant-delivery.obj-code) COLUMN-LABEL "Объект!доставки" FORMAT "X(8)":U
     1093         X_variant-delivery.term-delivery COLUMN-LABEL "Срок!доставки" FORMAT ">,>>9":U
     1094         X_variant-delivery.des FORMAT "X(100)":U WIDTH 50
     1095       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16.27.
     1096   DEFINE FRAME Dialog-Frame
     1097        b-quit AT ROW 1 COL 1
     1098        B-mark AT ROW 1 COL 11
     1099        B-sel AT ROW 1 COL 21
     1100        B-add AT ROW 1 COL 31
     1101        b-lkp AT ROW 1 COL 41
     1102        B-chg AT ROW 1 COL 51
     1103        B-del AT ROW 1 COL 61
     1104        B-print AT ROW 1 COL 86
     1105        B-hist AT ROW 1 COL 89
     1106        B-sch AT ROW 1 COL 92
     1107        B-Help AT ROW 1 COL 95
     1108        B-vrdlgrps AT ROW 2 COL 51
     1109        RS-sts AT ROW 3.5 COL 3.5 NO-LABEL
     1110        br-vardeliv AT ROW 5 COL 1
     1111        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1112        SPACE(78.62) SKIP(20.03)
     1113       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1114            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1115            TITLE "Варианты доставки"
     1116            CANCEL-BUTTON b-quit.
     1117   ASSIGN
     1118          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1119          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1120   ON GO OF FRAME Dialog-Frame
     1121   DO:
     1122     p-rid-list = v-rid-list.
     1123   END.
     1124   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1125   OR ENDKEY OF FRAME Dialog-Frame DO:
     1126     run gbl/markqwa.p (
     1127                              input b-mark:sensitive
     1128                             , input v-rid-list) no-error.
     1129     if error-status:error then return no-apply.
     1130     APPLY "END-ERROR":U TO SELF.
     1131   END.
     1132   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1133   DO:
     1134   define variable loc#log as logical no-undo.
     1135   define variable loc-doc-rec as recid no-undo .
     1136   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1137   do:
     1138     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1139       (input  v-cntxt-db-num
     1140       ,input  v-cntxt-userid
     1141       ,input  0
     1142       ,input  'actn_delivery-storage_work':U
     1143       ,input  'global':U
     1144       ,input  0
     1145       ,input  '':U
     1146       ,input  0
     1147       ,input  0
     1148       ,input  0
     1149       ,input  0
     1150       ,input  true
     1151       ,output loc#log
     1152       )  .
     1153   end.
     1154   if not loc#log then return no-apply.
     1155   run ref/vardelvi.w
     1156                 (
     1157                    input parParentProc
     1158                   ,input p-curr-obj-type
     1159                   ,input p-curr-obj-code
     1160                   ,input 'ДОБАВЛЕНИЕ':U
     1161                   ,input (if p-mode = "delivery-type-subject"
     1162                           then p-deliv-type-code
     1163                           else 0)
     1164                   ,input (if p-mode = "delivery-type-subject"
     1165                           then p-deliv-subj-code
     1166                           else 0)
     1167                   ,input (if p-mode = 'объект':U
     1168                           then p-deliv-obj-type
     1169                           else "":U)
     1170                   ,input (if p-mode = 'объект':U
     1171                           then p-deliv-obj-code
     1172                           else 0)
     1173                   ,input-output loc-doc-rec
     1174                               ) no-error
     1175   .
     1176   if loc-doc-rec <> ? then do:
     1177     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     1178     reposition br-vardeliv to recid loc-doc-rec no-error.
     1179     if error-status:error then do:                           find first pos_variant-delivery no-lock where                                   recid(pos_variant-delivery) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ВАРИАНТ ДОСТАВКИ" skip                            string(if avail pos_variant-delivery                                     then  substitute("Вн код типа доставки: &1 вн код субъекта доставки: &2 объект доставки: &3&4"                                                     , pos_variant-delivery.deliv-type-code                                                     , pos_variant-delivery.deliv-subj-code                                                     , pos_variant-delivery.obj-type                                                     , pos_variant-delivery.obj-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1180   end.
     1181   apply "entry" to br-vardeliv in frame Dialog-Frame.
     1182   apply "value-changed" to br-vardeliv in frame Dialog-Frame.
     1183   END.
     1184   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1185   DO:
     1186     DEFINE variable loc#log as logical no-undo.
     1187   define variable loc-doc-rec as recid no-undo .
     1188   if not available X_variant-delivery then return no-apply.
     1189   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1190   do:
     1191     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1192       (input  v-cntxt-db-num
     1193       ,input  v-cntxt-userid
     1194       ,input  0
     1195       ,input  'actn_delivery-storage_work':U
     1196       ,input  'global':U
     1197       ,input  0
     1198       ,input  '':U
     1199       ,input  0
     1200       ,input  0
     1201       ,input  0
     1202       ,input  0
     1203       ,input  true
     1204       ,output loc#log
     1205       )  .
     1206   end.
     1207   if not loc#log then return no-apply.
     1208   assign
     1209   loc-doc-rec = recid(X_variant-delivery).
     1210   run ref/vardelvi.w
     1211                 (
     1212                    input parParentProc
     1213                   ,input p-curr-obj-type
     1214                   ,input p-curr-obj-code
     1215                   ,input 'ИЗМЕНЕНИЕ':U
     1216                   ,input X_variant-delivery.deliv-type-code
     1217                   ,input X_variant-delivery.deliv-subj-code
     1218                   ,input X_variant-delivery.obj-type
     1219                   ,input X_variant-delivery.obj-code
     1220                   ,input-output loc-doc-rec
     1221                               ) no-error
     1222   .
     1223   if loc-doc-rec <> ? then do:
     1224     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     1225     reposition br-vardeliv to recid loc-doc-rec no-error.
     1226     if error-status:error then do:                           find first pos_variant-delivery no-lock where                                   recid(pos_variant-delivery) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ВАРИАНТ ДОСТАВКИ" skip                            string(if avail pos_variant-delivery                                     then  substitute("Вн код типа доставки: &1 вн код субъекта доставки: &2 объект доставки: &3&4"                                                     , pos_variant-delivery.deliv-type-code                                                     , pos_variant-delivery.deliv-subj-code                                                     , pos_variant-delivery.obj-type                                                     , pos_variant-delivery.obj-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1227   end.
     1228   apply "entry" to br-vardeliv in frame Dialog-Frame.
     1229   apply "value-changed" to br-vardeliv in frame Dialog-Frame.
     1230   END.
     1231   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1232   DO:
     1233     run proc-b-del in this-procedure no-error.
     1234     if error-status:error then return no-apply.
     1235   END.
     1236   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1237   DO:
     1238     define variable loc-doc-rec as recid no-undo .
     1239   define variable v-rid-list as character no-undo.
     1240     if NOT available X_variant-delivery then return no-apply.
     1241     loc-doc-rec = recid (X_variant-delivery).
     1242     .
     1243     run ref/dlvctyss.w
     1244                   (
     1245                    input parParentProc
     1246                   ,input p-curr-obj-type
     1247                   ,input p-curr-obj-code
     1248                   ,input "":U
     1249                   ,input "one":U
     1250                   ,input X_variant-delivery.deliv-type-code
     1251                   ,input X_variant-delivery.deliv-subj-code
     1252                   ,input-output v-rid-list
     1253                                 )
     1254   .
     1255     reposition br-vardeliv to recid loc-doc-rec no-error.
     1256     apply "entry" to br-vardeliv in frame Dialog-Frame.
     1257     apply "value-changed" to br-vardeliv in frame Dialog-Frame.
     1258   END.
     1259   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1260   DO:
     1261     DEFINE variable loc#log as logical no-undo.
     1262   define variable loc-doc-rec as recid no-undo .
     1263   if not available X_variant-delivery then return no-apply.
     1264   assign
     1265   loc-doc-rec = recid(X_variant-delivery).
     1266   run ref/vardelvi.w
     1267                 (
     1268                    input parParentProc
     1269                   ,input p-curr-obj-type
     1270                   ,input p-curr-obj-code
     1271                   ,input 'ПРОСМОТР':U
     1272                   ,input X_variant-delivery.deliv-type-code
     1273                   ,input X_variant-delivery.deliv-subj-code
     1274                   ,input X_variant-delivery.obj-type
     1275                   ,input X_variant-delivery.obj-code
     1276                   ,input-output loc-doc-rec
     1277                               )
     1278   .
     1279   apply "entry" to br-vardeliv in frame Dialog-Frame.
     1280   END.
     1281   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1282   DO:
     1283     define variable loc#log as logical no-undo .
     1284     if available X_variant-delivery then do:
     1285   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1286   define variable v-str-recid14 as character no-undo .
     1287   define variable v-num-entry14 as integer   no-undo .
     1288   assign
     1289     v-str-recid14 = trim( string( recid( X_variant-delivery ) , "->>>>>>>>>>>9":U ) )
     1290     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1291   .
     1292   if v-num-entry14 > 0 then do:
     1293     assign
     1294       entry( v-num-entry14, v-rid-list ) = "":U
     1295       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1296     .
     1297   end.
     1298   else do:
     1299     assign
     1300       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1301     .
     1302   end.
     1303       loc#log = br-vardeliv:refresh() .
     1304       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1305           loc#log = br-vardeliv:select-next-row ().
     1306           apply "VALUE-CHANGED" to br-vardeliv in frame Dialog-Frame.
     1307       end.
     1308       if num-entries( v-rid-list ) = 0
     1309       then
     1310           hide mark-num in frame Dialog-Frame.
     1311       else
     1312           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1313     end.
     1314     apply "entry" to br-vardeliv in frame Dialog-Frame.
     1315   END.
     1316   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1317   DO:
     1318     run proc-b-print in this-procedure no-error.
     1319     if error-status:error then do:
     1320       return no-apply.
     1321     end.
     1322     APPLY "ENTRY" to br-vardeliv.
     1323   END.
     1324   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1325   DO:
     1326     RUN proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1327     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1328   END.
     1329   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1330   DO:
     1331       if ( available X_variant-delivery ) then do:
     1332       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1333       then
     1334       v-rid-list = string( recid( X_variant-delivery ) ) .
     1335     end.
     1336   END.
     1337   ON CHOOSE OF B-vrdlgrps IN FRAME Dialog-Frame
     1338   DO:
     1339       DEFINE VARIABLE v-loc-rid-list AS CHARACTER NO-UNDO.
     1340     define variable v-sts as integer no-undo init ? .
     1341     IF NOT AVAILABLE X_variant-delivery  THEN DO:
     1342         RETURN NO-APPLY.
     1343     END.
     1344     run ref/vrdlgrps.w (
     1345                        INPUT parParentProc
     1346                     ,  input p-curr-obj-type
     1347                     ,  input p-curr-obj-code
     1348                     ,  input (if lookup("b-add":U, bttns) > 0 then "b-add":U else "":U)
     1349                     ,  INPUT "variant-delivery":U
     1350                     ,  input X_variant-delivery.deliv-type-code
     1351                     ,  input X_variant-delivery.deliv-subj-code
     1352                     ,  input X_variant-delivery.obj-type
     1353                     ,  input X_variant-delivery.obj-code
     1354                     ,  INPUT 0
     1355                     ,  input-output v-sts
     1356                     ,  input-output v-loc-rid-list    ) NO-ERROR.
     1357   END.
     1358   ON RETURN OF br-vardeliv IN FRAME Dialog-Frame
     1359   or MOUSE-SELECT-DBLCLICK OF br-vardeliv IN FRAME Dialog-Frame
     1360       DO:
     1361       run proc-br-vardeliv no-error.
     1362     if error-status:error then return no-apply.
     1363   END.
     1364   ON VALUE-CHANGED OF RS-sts IN FRAME Dialog-Frame
     1365   DO:
     1366     ASSIGN
     1367     rs-sts
     1368     p-sts = (IF rs-sts = 'все':U THEN ? ELSE INTEGER(rs-sts))
     1369     .
     1370     RUN openbr IN THIS-PROCEDURE ( input YES, input NO, input '':U) NO-ERROR.
     1371     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1372   END.
     1373   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1374   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1375   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1376   on help of frame Dialog-Frame
     1377   do:
     1378     run gbl/app_help.p
     1379       (input this-procedure :file-name
     1380       ,input ''
     1381       ,input ?
     1382       ) no-error.
     1383     if error-status :error then do:
     1384       message
     1385         "Ошибка при вызове помощи"
     1386         error-status :get-message(1)
     1387         view-as alert-box .
     1388     end.
     1389   end.
     1390   run minbtn-set in this-procedure .
     1391   on choose of b-help in frame Dialog-Frame
     1392   do:
     1393     apply "help":u to frame Dialog-Frame .
     1394   end.
     1395   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1396   procedure minbtn-set :
     1397       do
     1398           on error undo, return error return-value
     1399           :
     1400           define variable ii              as integer       no-undo .
     1401           define variable fh              as widget-handle no-undo .
     1402           define variable hh              as widget-handle no-undo .
     1403           define variable v-h             as handle        extent 4 no-undo .
     1404           define variable v-name-button   as character     no-undo .
     1405           define variable v-help-old-x    as decimal       no-undo .
     1406           define variable v-help-old-y    as decimal       no-undo .
     1407           define variable v-help-old-size as decimal       no-undo .
     1408           define variable v-frame-width   as decimal       no-undo .
     1409           define variable jj              as integer       no-undo .
     1410           do
     1411               on error undo, return error
     1412               :
     1413               assign
     1414                   v-frame-width = frame Dialog-Frame:width - 0.3
     1415                   fh            = frame Dialog-Frame:first-child
     1416                   hh            = fh:first-child
     1417                   ii            = 1
     1418                   .
     1419               do while valid-handle(hh):
     1420                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1421                   do:
     1422                       case lc(hh:name) :
     1423                           when "b-help" then
     1424                               do:
     1425                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1426                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1427                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1428                                   hh:TOOLTIP = "Помощь" .
     1429                                   v-help-old-x = hh:column .
     1430                                   v-help-old-y = hh:row    .
     1431                                   v-help-old-size = hh:width .
     1432                                   hh:width-chars = 2.5 .
     1433                               end.
     1434                           when "b-print" then
     1435                               do:
     1436                                   hh:load-image("cmp/b-print.bmp":u) .
     1437                                   hh:TOOLTIP = "Печать" .
     1438                                   v-h[ii] = hh:handle .
     1439                                   ii = ii + 1 .
     1440                                   hh:width-chars = 3 .
     1441                               end.
     1442                           when "b-history" or
     1443                           when "b-hist" then
     1444                               do:
     1445                                   hh:load-image("cmp/b-hist.bmp":u) .
     1446                                   hh:TOOLTIP = "История" .
     1447                                   v-h[ii] = hh:handle .
     1448                                   ii = ii + 1 .
     1449                                   hh:width-chars = 3 .
     1450                               end.
     1451                           when "b-sch" then
     1452                               do:
     1453                                   hh:load-image("cmp/b-sch.bmp":u) .
     1454                                   hh:TOOLTIP = "Установка Фильтра" .
     1455                                   v-h[ii] = hh:handle .
     1456                                   ii = ii + 1 .
     1457                                   hh:width-chars = 3 .
     1458                               end.
     1459                           when "b-hist-user" then
     1460                               do:
     1461                                   hh:load-image("cmp/b-hist.bmp":u) .
     1462                                   hh:TOOLTIP = "История пользователя" .
     1463                                   ii = ii + 1 .
     1464                               end.
     1465                       end case.
     1466                   end.
     1467                   hh = hh:next-sibling.
     1468               end.
     1469               b-help:column = v-frame-width - b-help:width-chars.
     1470               jj = 0.
     1471               repeat ii = 4 to 1 by -1 :
     1472                   if valid-handle (v-h[ii] ) then
     1473                   do:
     1474                       jj  = jj + 1 .
     1475                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1476                       v-h[ii]:row    = v-help-old-y .
     1477                   end.
     1478               end.
     1479           end.
     1480       end.
     1481   end procedure.
     1482   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1483   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1484   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1485   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1486   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1487   define variable v-diasize-current-frame-height as decimal   no-undo .
     1488   define variable v-diasize-change-size          as logical   no-undo .
     1489   define variable v-diasize-resize-button        as handle    no-undo .
     1490   define variable v-diasize-wndmax               as logical   no-undo .
     1491   define variable v-diasize-wndstore             as logical   no-undo .
     1492   define variable v-diasize-proc-name            as character no-undo .
     1493   define variable v-diasize-browse-handle        as handle    no-undo .
     1494   define variable v-diasize-browse-number        as integer   no-undo .
     1495   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1496   define temp-table temp-diasize-handle no-undo
     1497     field handle-value  as handle
     1498     field save-position as decimal
     1499     index xpk is primary unique handle-value
     1500     .
     1501   define temp-table temp-browse-handle no-undo
     1502     field browse-type   as character
     1503     field browse-number as integer
     1504     field browse-handle as handle
     1505     field original-size as decimal
     1506     index xpk is primary unique browse-type browse-number
     1507     index xie browse-type browse-handle
     1508   .
     1509   procedure diasize_change-height :
     1510     define input  parameter p-change-value  as decimal   no-undo .
     1511     define input  parameter p-move-resize   as logical   no-undo .
     1512     define variable v-field-group-handle    as handle    no-undo .
     1513     define variable v-object-handle         as handle    no-undo .
     1514     define variable v-frame-height          as decimal   no-undo .
     1515     define variable v-frame-virtual-height  as decimal   no-undo .
     1516     define variable v-browse-height         as decimal   no-undo .
     1517     define variable v-window-height         as decimal   no-undo .
     1518     define variable v-window-virtual-height as decimal   no-undo .
     1519     define variable v-change-sign           as integer   no-undo .
     1520     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1521     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1522     if p-change-value > 0
     1523     then do:
     1524       if frame Dialog-Frame :height + p-change-value
     1525           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1526       then do:
     1527         assign
     1528           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1529                           - (frame Dialog-Frame :height-chars)
     1530         .
     1531         if p-change-value <= 0
     1532         then do:
     1533           run diasize_position-resize-button in this-procedure .
     1534           return .
     1535         end.
     1536       end.
     1537     end.
     1538     if p-change-value < 0
     1539     then do:
     1540       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1541       then do:
     1542         assign
     1543           p-change-value = v-diasize-orig-frame-height
     1544                          - (frame Dialog-Frame :height-chars)
     1545         .
     1546         if p-change-value >= 0
     1547         then do:
     1548           run diasize_position-resize-button in this-procedure .
     1549           return .
     1550         end.
     1551       end.
     1552     end.
     1553     if p-change-value >= 0
     1554     then do:
     1555       assign
     1556         v-change-sign = 1
     1557       .
     1558     end.
     1559     else do:
     1560       assign
     1561         v-change-sign = -1
     1562       .
     1563     end.
     1564     assign
     1565       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1566     .
     1567     if p-change-value = 0
     1568     then do:
     1569       run diasize_position-resize-button in this-procedure .
     1570       return .
     1571     end.
     1572     move_block:
     1573     do
     1574     on error undo move_block, retry move_block
     1575     :
     1576       if retry
     1577       then do:
     1578         do
     1579         on error undo move_block, leave move_block
     1580         :
     1581           if p-change-value > 0
     1582           then do:
     1583             for each buf_temp-diasize-handle
     1584             on error undo, next
     1585             :
     1586               assign
     1587                 v-object-handle = buf_temp-diasize-handle.handle-value
     1588               .
     1589               if v-object-handle <> v-diasize-resize-button
     1590               then do:
     1591                 assign
     1592                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1593                 .
     1594               end.
     1595             end.
     1596             assign
     1597               v-diasize-browse-handle :height = v-browse-height
     1598             .
     1599             for each buf_temp-browse-handle
     1600               where buf_temp-browse-handle.browse-type = 'height':u
     1601             on error undo, next
     1602             :
     1603               assign
     1604                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1605               .
     1606             end.
     1607             assign
     1608               frame Dialog-Frame :height = v-frame-height
     1609             .
     1610             if frame Dialog-Frame :scrollable = true
     1611             then do:
     1612               assign
     1613                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1614               .
     1615             end.
     1616             run diasize_position-resize-button in this-procedure .
     1617           end.
     1618           else do:
     1619             if frame Dialog-Frame :scrollable = true
     1620             then do:
     1621               assign
     1622                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1623               .
     1624             end.
     1625             assign
     1626               frame Dialog-Frame :height = v-frame-height
     1627             .
     1628             assign
     1629               v-diasize-browse-handle :height = v-browse-height
     1630             .
     1631             for each buf_temp-browse-handle
     1632               where buf_temp-browse-handle.browse-type = 'height':u
     1633             on error undo, next
     1634             :
     1635               assign
     1636                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1637               .
     1638             end.
     1639             for each buf_temp-diasize-handle
     1640             on error undo, next
     1641             :
     1642               assign
     1643                 v-object-handle = buf_temp-diasize-handle.handle-value
     1644               .
     1645               if v-object-handle <> v-diasize-resize-button
     1646               then do:
     1647                 assign
     1648                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1649                 .
     1650               end.
     1651             end.
     1652             run diasize_position-resize-button in this-procedure .
     1653           end.
     1654           assign
     1655             v-diasize-change-size = false
     1656           .
     1657           leave move_block .
     1658         end.
     1659       end.
     1660       assign
     1661         v-diasize-need-full-display = true
     1662       .
     1663       if v-diasize-change-size = false
     1664       then do:
     1665         assign
     1666           v-diasize-change-size = true
     1667         .
     1668       end.
     1669       else do:
     1670         return .
     1671       end.
     1672       assign
     1673         v-frame-height = frame Dialog-Frame :height
     1674         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1675         v-browse-height = v-diasize-browse-handle :height
     1676       .
     1677       for each buf_temp-browse-handle
     1678         where buf_temp-browse-handle.browse-type = 'height':u
     1679       :
     1680         assign
     1681           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1682         .
     1683       end.
     1684       for each buf_temp-diasize-handle
     1685       :
     1686         delete buf_temp-diasize-handle .
     1687       end.
     1688       assign
     1689         v-field-group-handle = frame Dialog-Frame :first-child
     1690       .
     1691       do while valid-handle(v-field-group-handle)
     1692       :
     1693         assign
     1694           v-object-handle = v-field-group-handle :first-child
     1695         .
     1696         do while valid-handle(v-object-handle)
     1697         :
     1698           if  v-object-handle <> v-diasize-browse-handle :handle
     1699           and can-query(v-object-handle, "row")
     1700           and can-query(v-object-handle, "height")
     1701           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1702           then do:
     1703             find first buf_temp-browse-handle
     1704               where buf_temp-browse-handle.browse-type   = 'height':u
     1705                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1706               no-error .
     1707             if available buf_temp-browse-handle
     1708             then do:
     1709             end.
     1710             else do:
     1711               create buf_temp-diasize-handle .
     1712               assign
     1713                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1714                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1715               .
     1716             end.
     1717           end.
     1718           assign
     1719             v-object-handle = v-object-handle :next-sibling
     1720           .
     1721         end.
     1722         assign
     1723           v-field-group-handle = v-field-group-handle :next-sibling
     1724         .
     1725       end.
     1726       do with frame Dialog-Frame
     1727       :
     1728         hide v-diasize-resize-button .
     1729         assign
     1730           v-diasize-resize-button :row    = 1
     1731           v-diasize-resize-button :column = 1
     1732         .
     1733       end.
     1734       if p-change-value > 0
     1735       then do:
     1736         if frame Dialog-Frame :scrollable = true
     1737         then do:
     1738           assign
     1739             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1740             no-error .
     1741           if error-status :error
     1742           or error-status :get-message(1) <> ""
     1743           then do:
     1744             undo move_block, retry move_block .
     1745           end.
     1746         end.
     1747         assign
     1748           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1749           no-error .
     1750         if error-status :error
     1751         or error-status :get-message(1) <> ""
     1752         then do:
     1753           undo move_block, retry move_block .
     1754         end.
     1755         assign
     1756           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1757           no-error .
