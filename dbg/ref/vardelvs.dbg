      849   FUNCTION mark-string RETURNS CHARACTER
      850     ( input p-recid as recid, input mark-list as character  ) :
      851     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      852   END FUNCTION.
      853   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      854   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      855   procedure fltopend_fltopend :
      856   define input parameter p-parent-handle as handle no-undo .
      857   define input parameter p-qh as handle no-undo .
      858   define input parameter p-flt-open-open-query  as character no-undo .
      859   define input parameter p-where-cond as character no-undo .
      860   define input parameter p-use-indFIRST-query-tail as character no-undo .
      861   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      862   define input parameter p-indexed-reposition as character no-undo .
      863     do
      864     on error undo, return error
      865     :
      866   define variable v-prepare-string as character no-undo .
      867   define variable glog as logical no-undo .
      868   assign
      869   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      870                      p-where-cond + chr(32)  +
      871                      p-use-indFIRST-query-tail + chr(32) +
      872                      p-use-ind-sort-clmn-by + chr(32) +
      873                      p-indexed-reposition
      874   .
      875   assign
      876   glog = p-qh:query-prepare(v-prepare-string) no-error .
      877   if not glog
      878   or error-status:error then do:
      879     message error-status:get-message(1) view-as alert-box .
      880     undo, return error .
      881   end.
      882   assign
      883   glog = p-qh:query-open no-error .
      884   if not glog
      885   or error-status:error then do:
      886     message error-status:get-message(1) view-as alert-box .
      887     undo, return error .
      888   end.
      889     end.
      890   end procedure.
      891   procedure fltopend_fltfindd :
      892   define input parameter p-parent-handle as handle no-undo .
      893   define input parameter p-qh as handle no-undo .
      894   define input parameter p-rowid as rowid no-undo .
      895   define input parameter p-next as logical no-undo .
      896   define input parameter p-lock as integer no-undo .
      897   define input parameter p-bh as handle no-undo .
      898   define input parameter p-where-cond as character no-undo .
      899   define input parameter p-use-index-phrase as character no-undo .
      900   define variable glog as logical no-undo .
      901   define variable v-qh as handle no-undo .
      902   define variable v-bh as handle no-undo .
      903   define variable v-recid as recid no-undo .
      904   define variable v-prepare-string as character no-undo .
      905   do
      906   on error undo, return error
      907   on stop undo, return error
      908   :
      909     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      910     create buffer v-bh for table p-bh buffer-name p-bh:name.
      911     create query v-qh.
      912     v-qh:set-buffers(v-bh).
      913     v-prepare-string = substitute("for each &1 &2 &3"
      914                                     ,v-bh:name
      915                                     ,p-where-cond
      916                                     ,p-use-index-phrase).
      917     glog = v-qh:query-prepare(v-prepare-string) no-error.
      918     if not glog then do:
      919       delete object v-qh.
      920       delete object v-bh.
      921       undo, return error .
      922     end.
      923     glog = v-qh:query-open no-error .
      924     if not glog then do:
      925       delete object v-qh.
      926       delete object v-bh.
      927       undo, return error .
      928     end.
      929     if p-next then do:
      930       v-qh:reposition-to-rowid(p-rowid) no-error .
      931       glog = v-qh:get-next( p-lock) no-error .
      932       glog = v-qh:get-next( p-lock) no-error .
      933       if not glog or v-qh:query-off-end = yes then do:
      934         glog = v-qh:get-first( p-lock) no-error .
      935       end.
      936     end.
      937     else do:
      938       glog = v-qh:get-first( p-lock) no-error .
      939     end.
      940     v-recid = v-bh:recid no-error .
      941     delete object v-qh.
      942     delete object v-bh.
      943     return string(v-recid) .
      944   end.
      945   end procedure.
      946   procedure fltopend_fltfindq :
      947   define input parameter p-parent-handle as handle no-undo .
      948   define input parameter p-qh as handle no-undo .
      949   define input parameter p-next as logical no-undo .
      950   define input parameter p-lock as integer no-undo .
      951   define input parameter p-flt-open-open-query  as character no-undo .
      952   define input parameter p-where-cond as character no-undo .
      953   define input parameter p-use-indFIRST-query-tail as character no-undo .
      954   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      955   define input parameter p-indexed-reposition as character no-undo .
      956   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      957   define variable glog as logical no-undo .
      958   define variable v-qh as handle no-undo .
      959   define variable v-bh as handle no-undo extent 18.
      960   define variable v-rowid as rowid no-undo extent 18.
      961   define variable v-ii as integer no-undo .
      962   define variable v-prepare-string as character no-undo .
      963   do
      964   on error undo, return error
      965   on stop undo, return error
      966   :
      967     create query v-qh.
      968     do v-ii = 1 to p-qh:num-buffers:
      969       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      970       assign
      971       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      972       no-error.
      973       v-qh:add-buffer(v-bh[v-ii]).
      974     end.
      975     assign
      976     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      977                       p-where-cond + chr(32)  +
      978                       p-use-indFIRST-query-tail + chr(32) +
      979                       p-use-ind-sort-clmn-by + chr(32) +
      980                       p-indexed-reposition
      981     .
      982     glog = v-qh:query-prepare( v-prepare-string) no-error .
      983     if not glog then do:
      984       delete object v-qh.
      985       do v-ii = 1 to p-qh:num-buffers:
      986         delete object v-bh[v-ii].
      987       end.
      988       undo, return error .
      989     end.
      990     glog = v-qh:query-open no-error .
      991     if not glog then do:
      992       delete object v-qh.
      993       do v-ii = 1 to p-qh:num-buffers:
      994         delete object v-bh[v-ii].
      995       end.
      996       undo, return error .
      997     end.
      998     if p-next then do:
      999       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1000       glog = v-qh:get-next( p-lock) no-error .
     1001       glog = v-qh:get-next( p-lock) no-error .
     1002       if not glog or v-qh:query-off-end = yes then do:
     1003         glog = v-qh:get-first( p-lock) no-error .
     1004       end.
     1005     end.
     1006     else do:
     1007       glog = v-qh:get-first( p-lock) no-error .
     1008     end.
     1009     do v-ii = 1 to p-qh:num-buffers:
     1010       assign
     1011       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1012       no-error.
     1013     end.
     1014     delete object v-qh.
     1015     do v-ii = 1 to p-qh:num-buffers:
     1016       delete object v-bh[v-ii].
     1017     end.
     1018   end.
     1019   end procedure.
