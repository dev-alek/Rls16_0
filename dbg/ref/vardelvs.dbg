     2987   PROCEDURE enable_UI :
     2988     DISPLAY RS-sts mark-num
     2989         WITH FRAME Dialog-Frame.
     2990     ENABLE b-quit B-mark B-sel B-add b-lkp B-chg B-del B-print B-hist B-sch
     2991            B-Help B-vrdlgrps RS-sts br-vardeliv mark-num
     2992         WITH FRAME Dialog-Frame.
     2993     VIEW FRAME Dialog-Frame.
     2994     OPEN QUERY br-vardeliv FOR EACH X_variant-delivery NO-LOCK INDEXED-REPOSITION.
     2995   END PROCEDURE.
     2996   PROCEDURE MyEnable :
     2997   ASSIGN
     2998   rs-sts:RADIO-BUTTONS IN FRAME Dialog-Frame
     2999                          = "Текущие&+" + chr(44) +  '0':U + chr(44) +
     3000                          "Все&!" + chr(44) + 'все':U + chr(44) +
     3001                           "Удаленные&-" + chr(44) + '1':U
     3002   rs-sts = (IF p-sts = ? THEN 'все':U ELSE string(p-sts))
     3003   .
     3004   DISPLAY mark-num
     3005   WITH FRAME Dialog-Frame.
     3006   ENABLE
     3007   b-quit
     3008   B-mark when LOOKUP("b-mark":U, bttns) > 0
     3009   B-sel when LOOKUP("b-mark":U, bttns) > 0
     3010   B-add when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     3011   b-lkp
     3012   B-chg when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     3013   B-del when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     3014   B-print
     3015   B-Help
     3016   B-hist
     3017   b-sch
     3018   br-vardeliv
     3019   mark-num
     3020   rs-sts
     3021   B-vrdlgrps
     3022   with FRAME Dialog-Frame.
     3023   VIEW FRAME Dialog-Frame.
     3024   END PROCEDURE.
     3025   PROCEDURE OpenBr :
     3026   define input  parameter p-open-query     as logical   no-undo .
     3027   define input  parameter p-find-next      as logical   no-undo .
     3028   define input  parameter p-find-condition as character no-undo .
     3029   define variable l-query-was-opened as logical no-undo .
     3030   define variable title0 as character no-undo.
     3031   title0 = "Список вариантов доставки" + chr(32).
     3032   run waitfram-show in this-procedure ("Ждите...").
     3033   define variable sort-column-phrase as character no-undo .
     3034   case sort-column-name :
     3035     when "" then do:
     3036       assign
     3037         sort-column-phrase = ""
     3038       .
     3039     end.
     3040     otherwise do:
     3041       assign
     3042         sort-column-phrase = "by " + sort-column-name
     3043       .
     3044     end.
     3045   end case.
     3046   define variable l-open-query as logical   no-undo .
     3047     CASE p-mode :
     3048       WHEN 'все':U        THEN DO:
     3049        assign
     3050        filter-point = filter-point0 + p-mode
     3051        filter-label = substitute("&1", filter-label0)
     3052        .
     3053        IF p-sts = ? THEN DO:
     3054   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3055   define variable  l-disable-where-32  as logical   no-undo .
     3056   define variable  l-filter-open-32    as logical   .
     3057   define variable  flt-rec-32       as recid     no-undo .
     3058   define variable  filter-name-32      as character no-undo .
     3059   define variable  where-phrase-32     as character no-undo .
     3060   define variable  sort-phrase-32      as character no-undo .
     3061   define variable  where-phrase-rus-32 as character no-undo .
     3062   define variable  sort-phrase-rus-32  as character no-undo .
     3063     run waitfram-show in this-procedure
     3064       (input "ЖДИТЕ ..."
     3065       ).
     3066   run gbl/flt-get.p
     3067     (input filter-point
     3068     ,output flt-rec-32
     3069     ,output filter-name-32
     3070     ,output where-phrase-32
     3071     ,output sort-phrase-32
     3072     ,output where-phrase-rus-32
     3073     ,output sort-phrase-rus-32
     3074     ).
     3075   if p-open-query then do:
     3076       run set-filter-name in this-procedure
     3077         (INPUT filter-name-32
     3078         ) no-error .
     3079     assign
     3080       l-filter-open-32 = false
     3081     .
     3082     if flt-rec-32 <> ?
     3083       or sort-column-phrase > ""
     3084     then do:
     3085       define variable  parameter-2-32 as character no-undo .
     3086       define variable  parameter-3-32 as character no-undo .
     3087       define variable  parameter-4-32 as character no-undo .
     3088       define variable  parameter-5-32 as character no-undo .
     3089       define variable  parameter-6-32 as character no-undo .
     3090       define variable  parameter-7-32 as character no-undo .
     3091         assign
     3092         parameter-3-32 =
     3093                                 "FOR EACH X_variant-delivery"
     3094         parameter-4-32 =
     3095           (
     3096             if (" TRUE " + " " + where-phrase-32) <> ""
     3097             then " TRUE " + " " + where-phrase-32
     3098             else "true"
     3099           )
     3100         parameter-5-32 = (" " + "" + " " + "")
     3101         parameter-6-32 = if sort-phrase-32 = ''
     3102                              then
     3103           (
     3104           " " + "  " +
     3105             " " + sort-column-phrase +
     3106           " " + "  "
     3107           )
     3108                              else
     3109           (
     3110           " " + "  " +
     3111             " " + sort-column-phrase +
     3112           " " + sort-phrase-32
     3113           )
     3114         parameter-7-32 =
     3115           " indexed-reposition  "
     3116       .
     3117       do
     3118       on stop undo, leave
     3119       on error undo, leave
     3120       :
     3121         assign
     3122           l-disable-where-32 =
     3123             (" TRUE " + " " + where-phrase-32 = "")
     3124         .
     3125         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3126                             ,input QUERY br-vardeliv:handle
     3127                             ,input parameter-3-32
     3128                             ,input parameter-4-32
     3129                             ,input parameter-5-32
     3130                             ,input parameter-6-32
     3131                             ,input parameter-7-32
     3132                             )
     3133         .
     3134         assign
     3135           l-filter-open-32 = true
     3136         .
     3137       end.
     3138       if l-filter-open-32 = false then do:
     3139         message
     3140           "Ошибка при фильтрации / сортировке" skip
     3141           "Будут показаны записи без учета фильтра" skip
     3142           view-as alert-box .
     3143       end.
     3144       else do:
     3145           assign
     3146             l-query-was-opened = true
     3147           .
     3148       end.
     3149     end.
     3150     if l-filter-open-32 = false then do:
     3151       OPEN QUERY br-vardeliv FOR EACH X_variant-delivery
     3152         where  TRUE
     3153         indexed-reposition
     3154     .
     3155         assign
     3156           l-query-was-opened = true
     3157         .
     3158     end.
     3159   end.
     3160   else do:
     3161     assign
     3162       v-doc-rec = recid( X_variant-delivery )
     3163     .
     3164     do
     3165     on stop undo, leave
     3166     on error undo, leave
     3167     :
     3168       if QUERY br-vardeliv:handle:get-buffer-handle(1) = (buffer X_variant-delivery:handle) then do:
     3169         assign
     3170         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     3171         parameter-4-32 =
     3172           "where ":u + " TRUE " + " ":u + where-phrase-32 + " ":u + p-find-condition + " " + ""
     3173         parameter-5-32 = "  "
     3174       .
     3175         run fltopend_fltfindd in this-procedure  (
     3176                             input this-procedure:handle
     3177                             ,input QUERY br-vardeliv:handle
     3178                             ,input rowid(X_variant-delivery)
     3179                             ,input logical(parameter-2-32)
     3180                             ,input no-lock
     3181                             ,input (buffer X_variant-delivery:handle)
     3182                             ,input parameter-4-32
     3183                             ,input parameter-5-32
     3184                             ) no-error.
     3185         .
     3186         assign
     3187           v-doc-rec = integer(return-value)
     3188           v-fltopend-rowid[1] = ?
     3189         .
     3190       end.
     3191       else do:
     3192         assign
     3193         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     3194         parameter-3-32 =  "FOR EACH X_variant-delivery"
     3195         parameter-4-32 =
     3196           (
     3197             if (" TRUE " + " " + where-phrase-32) <> ""
     3198             then " TRUE " + " " + where-phrase-32
     3199             else "true"
     3200           )
     3201         parameter-5-32 = (" " + "" + " " + "" + " " + p-find-condition)
