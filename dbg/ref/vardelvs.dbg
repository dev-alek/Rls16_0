      527   procedure prn-lib-reportviewer :
      528     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      529     define input parameter p-report-name-html as character no-undo .
      530     define input parameter p-param        as character no-undo .
      531     define variable v-excel           as character no-undo init 'TRUE' .
      532     define variable v-value-character as character no-undo .
      533     define variable v-value-integer   as character no-undo .
      534     define variable v-value-date      as date      no-undo .
      535     define variable v-value-decimal   as decimal   no-undo .
      536     define variable rep-excel         as logical   no-undo .
      537     define variable excel-string      as character no-undo .
      538     define variable v-param-type      as character no-undo .
      539     define variable v-tth             as handle    no-undo .
      540     run adm/shattri.p (
      541       input "get":U
      542       ,input  ""
      543       ,input  0
      544       ,input  'report-glob':U
      545       ,input  'rep-excel':U
      546       ,output v-value-character
      547       ,output v-value-date
      548       ,output v-value-decimal
      549       ,output v-value-integer
      550       ,output rep-excel
      551       ,output v-param-type
      552       ,INPUT-OUTPUT table-handle v-tth
      553       )  .
      554     if rep-excel then v-excel = "TRUE" .
      555     else v-excel = "FALSE" .
      556     if p-param eq ""
      557     then
      558        p-param = "EXCEL:" + v-excel.
      559     else
      560        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      561     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      562   end procedure.
      563   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      564   procedure cur-time :
      565      define output parameter p-today as date      no-undo .
      566      define output parameter p-time  as integer   no-undo .
      567     do
      568     on error undo, return error
      569     :
      570       define variable v-date1 as date      no-undo .
      571       define variable v-date2 as date      no-undo .
      572       define variable v-time  as integer   no-undo .
      573       assign
      574         v-date1 = today
      575         v-time  = time
      576         v-date2 = today
      577       .
      578       if v-date1 <> v-date2
      579       then do:
      580         assign
      581           v-date1 = today
      582           v-time  = v-time
      583         .
      584       end.
      585       assign
      586         p-today = v-date1
      587         p-time  = v-time
      588       .
      589     end.
      590   end.
      591   function cur-time-date returns character
      592   :
      593     return string(today, '99/99/9999':U) .
      594   end.
      595   function cur-time-mjd returns decimal
      596   :
      597     define variable v-date as date      no-undo .
      598     define variable v-time as integer   no-undo .
      599     run cur-time in this-procedure
      600       (output v-date
      601       ,output v-time
      602       ) .
      603     return integer(v-date) - 2400002 + (v-time / 86400) .
      604   end.
      605   function cur-time-get-ending-index returns integer
      606   (input p-number as integer
      607   )
      608   :
      609     if p-number < 0
      610     or p-number = ?
      611     then do:
      612       return 1 .
      613     end.
      614     define variable v-rest as integer   no-undo .
      615     assign
      616       p-number = p-number modulo 100
      617     .
      618     if p-number < 20
      619     then do:
      620       assign
      621         v-rest = p-number
      622       .
      623     end.
      624     else do:
      625       assign
      626         v-rest = p-number modulo 10
      627       .
      628     end.
      629     case v-rest :
      630       when 1
      631       then do:
      632         return 2 .
      633       end.
      634       when 2 or
      635       when 3 or
      636       when 4
      637       then do:
      638         return 3 .
      639       end.
      640       otherwise do:
      641         return 1 .
      642       end.
      643     end case .
      644   end.
      645   procedure cur-time-mjd-to-date :
      646      define input  parameter i-mjd-diff as decimal no-undo.
      647      define output parameter o-Date     as date    no-undo.
      648      define output parameter o-Time     as integer no-undo.
      649      define variable v-day-number as integer   no-undo .
      650      if    i-mjd-diff < 0
      651         or i-mjd-diff = ?
      652      then do:
      653         return "?" .
      654      end.
      655      assign
      656         v-day-number = truncate(i-mjd-diff,0).
      657         o-Date = date(v-day-number + 2400002).
      658         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      659     .
      660   end.
      661   function cur-time-mjd-to-string returns character
      662   (input p-mjd-diff as decimal
      663   )
      664   :
      665     define variable v-day-number as integer   no-undo .
      666     define variable v-seconds    as integer   no-undo .
      667     define variable v-hour       as integer   no-undo .
      668     define variable v-min        as integer   no-undo .
      669     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      670     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      671     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      672     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      673     if p-mjd-diff < 0
      674     or p-mjd-diff = ?
      675     then do:
      676       return "?" .
      677     end.
      678     assign
      679       v-day-number = integer(truncate(p-mjd-diff,0))
      680       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      681     .
      682     if v-seconds > 86400
      683     then do:
      684       assign
      685         v-seconds = 86400 - 1
      686       .
      687     end.
      688     if v-seconds < 0
      689     then do:
      690       assign
      691         v-seconds = 0
      692       .
      693     end.
      694     assign
      695       v-hour = truncate(v-seconds / 3600, 0)
      696     .
      697     assign
      698       v-seconds = v-seconds modulo 3600
      699     .
      700     assign
      701       v-min = truncate(v-seconds / 60, 0)
      702     .
      703     assign
      704       v-seconds = v-seconds modulo 60
      705     .
      706     return
      707         (if v-day-number <> 0
      708           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      709           else ""
      710         )
      711       + (if v-day-number <> 0 or v-hour <> 0
      712           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      713           else ""
      714         )
      715       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      716           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      717           else ""
      718         )
      719       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      720       .
      721   end.
      722   function cur-time-string returns character
      723   :
      724     define variable v-date as date      no-undo .
      725     define variable v-time as integer   no-undo .
      726     run cur-time in this-procedure
      727       (output v-date
      728       ,output v-time
      729       ) .
      730     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      731   end.
      732   function cur-time-string-sec returns character
      733   :
      734     define variable v-date as date      no-undo .
      735     define variable v-time as integer   no-undo .
      736     run cur-time in this-procedure
      737       (output v-date
      738       ,output v-time
      739       ) .
      740     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      741   end.
      742   function cur-time-custom  returns character
      743   (input p-prefix as character
      744   ,input p-date-format as character
      745   ,input p-delimiter as character
      746   ,input p-time-format as character
      747   ,input p-suffix as character
      748   )
      749   :
      750     define variable v-date as date      no-undo .
      751     define variable v-time as integer   no-undo .
      752     run cur-time in this-procedure
      753       (output v-date
      754       ,output v-time
      755       ) .
      756     return
      757       p-prefix
      758       + string(v-date, p-date-format)
      759       + p-delimiter
      760       + string(v-time, p-time-format)
      761       + p-suffix
      762       .
      763   end.
      764   function cur-time-print  returns character
      765   :
      766     define variable v-date as date      no-undo .
      767     define variable v-time as integer   no-undo .
      768     run cur-time in this-procedure
      769       (output v-date
      770       ,output v-time
      771       ) .
      772     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      773   end.
      774   function cur-time-datetime returns datetime
      775   :
      776     define variable v-char as character no-undo .
      777     define variable v-datetime as datetime no-undo .
      778     v-char = cur-time-string().
      779     v-datetime = datetime(v-char).
      780     return  v-datetime.
      781   end.
      782   function cur-time-string-msec returns character
      783   :
      784     define variable v-date as datetime  no-undo .
      785     v-date = now.
      786     return string(v-date) .
      787   end.
