        1   DEFINE TEMP-TABLE temp-dis-card-property NO-UNDO LIKE dis-card-property
        2          field rw-option as character
        3          field prop-label as character
        4          field node-label as character
        5          field data-type as character
        6          field range as integer
        7          INDEX attrc is
        8          UNIQUE PRIMARY
        9          prop-label
       10          node-label
       11          dt-code
       12          host-code
       13          obj-type
       14          obj-code
       15          INDEX attrcl is UNIQUE
       16          dt-code
       17          node-code
       18          host-code
       19          obj-type
       20          obj-code
       21          .
       22   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
       23   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
       24   DEFINE INPUT PARAMETER p-dtm-code AS integer NO-UNDO.
       25   DEFINE INPUT PARAMETER p-sum-id AS CHARACTER NO-UNDO.
       26   DEFINE INPUT PARAMETER p-dt-code AS integer NO-UNDO.
       27   DEFINE INPUT PARAMETER p-node-code AS integer NO-UNDO.
       28   DEFINE INPUT PARAMETER p-emitent-host-code AS integer NO-UNDO.
       29   DEFINE INPUT PARAMETER p-type AS character NO-UNDO.
       30   DEFINE INPUT PARAMETER p-d-card AS character NO-UNDO.
       31   DEFINE INPUT PARAMETER p-host-code AS integer NO-UNDO.
       32   DEFINE INPUT PARAMETER p-obj-type AS CHARACTER NO-UNDO.
       33   DEFINE INPUT PARAMETER p-obj-code AS integer NO-UNDO.
       34   DEFINE INPUT-OUTPUT PARAMETER TABLE FOR temp-dis-card-property.
       35   DEFINE OUTPUT PARAMETER p-setted AS LOGICAL NO-UNDO.
       36   define variable vss-revision    as character no-undo init "$Revision$":U .
       37   define variable vss-author      as character no-undo init "$Author$":U .
       38   define variable vss-date        as character no-undo init "$Date$":U .
       39   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       40   define variable vss-archive     as character no-undo init "$Archive$":U .
       41   define variable vss-description as character no-undo init "Классы ограничений для ДК".
       42   procedure vss-get-info :
       43     define output parameter p-vss-revision    like vss-revision    no-undo .
       44     define output parameter p-vss-author      like vss-author      no-undo .
       45     define output parameter p-vss-date        like vss-date        no-undo .
       46     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       47     define output parameter p-vss-archive     like vss-archive     no-undo .
       48     define output parameter p-vss-description like vss-description no-undo .
       49     assign
       50       p-vss-revision    = vss-revision
       51       p-vss-author      = vss-author
       52       p-vss-date        = vss-date
       53       p-vss-workfile    = vss-workfile
       54       p-vss-archive     = vss-archive
       55       p-vss-description = vss-description
       56     .
       57   end procedure.
       58   procedure vss-get-parameters :
       59     define output parameter p-vss-parameters as character no-undo .
       60   end procedure.
       61   define new global shared variable g#vssrevis-logger as handle    no-undo .
       62   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       63   define variable v-vssrevis-logger                   as handle    no-undo .
       64   procedure vss-logevent :
       65     define input  parameter p-extra-paramters as character no-undo .
       66     define variable v-vssrevis-parameters as character no-undo .
       67     do
       68     on error undo, return error return-value
       69     :
       70       if  valid-handle(v-vssrevis-logger)
       71       and v-vssrevis-logger :get-signature("logevent") <> ""
       72       then do:
       73         run vss-get-parameters in this-procedure
       74           (output v-vssrevis-parameters
       75           ).
       76         run logevent in v-vssrevis-logger
       77           (input vss-workfile
       78           ,input vss-revision
       79           ,input v-vssrevis-parameters
       80           ,input p-extra-paramters
       81           ).
       82       end.
       83     end.
       84   end procedure.
       85   assign
       86     v-vssrevis-logger = g#vssrevis-logger
       87   .
       88   if  valid-handle(v-vssrevis-logger)
       89   and v-vssrevis-logger :get-signature("logevent") <> ""
       90   then do:
       91     assign
       92       v-vssrevis-logevent = true
       93     .
       94     run vss-logevent in this-procedure (input vss-description) .
       95   end.
       96   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       97   define variable v-waitfram-action01         as character   no-undo .
       98   define variable v-waitfram-action02         as character   no-undo .
       99   define variable v-waitfram-action03         as character   no-undo .
      100   define variable mWaitFramTextBeg            as character   no-undo.
      101   define variable mWaitFramTextEnd            as character   no-undo.
      102   define variable mWaitFramView               as logical     no-undo.
      103   define variable mWaitProcEvent              as logical     no-undo init yes.
      104   define variable mWaitFramInterval           as integer     no-undo init 1 .
      105   define variable mWaitFramStop               as logical     no-undo.
      106   define variable mWaitFramStopUser           as logical     no-undo.
      107   define variable mWaitFramStopTimeOut        as logical     no-undo.
      108   define variable mWaitFramStartProc          as datetime-tz no-undo.
      109   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      110   define button B-WaitFramStop auto-end-key
      111        label "Стоп"
      112        size 10 by 1 tooltip "Остоновить процесс".
      113   define button B-viewProcInfo
      114        label "Информация"
      115        size 15 by 1 tooltip "Информация о процесс".
      116   define frame waitfram
      117     v-waitfram-action01 format "x(72)" no-label skip
      118     v-waitfram-action02 format "x(72)" no-label skip
      119     v-waitfram-action03 format "x(72)" no-label skip
      120     B-viewProcInfo
      121     B-WaitFramStop at row 4 col 30
      122     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      123     .
      124   define new global shared variable mBatchMode as logical no-undo init ?.
      125   define variable mFramBachModHandle as handle no-undo.
      126   mFramBachModHandle = frame waitfram:handle.
      127   define variable mFameOldVis as logical no-undo.
      128   define variable mVisCUrentVin as logical no-undo.
      129   if session:batch-mode
      130   then
      131      mBatchMode = yes.
      132   if mBatchMode = ? then do:
      133     mVisCUrentVin = current-window:visible.
      134     mFameOldVis = mFramBachModHandle:visible.
      135     mFramBachModHandle:visible  = yes.
      136     mBatchMode = mFramBachModHandle:visible ne yes.
      137     mFramBachModHandle:visible = mFameOldVis.
      138     current-window:visible = mVisCUrentVin.
      139   end.
      140    if  log-manager:logfile-name ne ?
      141     then DO:
      142         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      143         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      144         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      145     end.
      146   on choose of B-WaitFramStop in frame waitfram
      147   do:
      148     mWaitFramStop = yes.
      149     mWaitFramStopUser = yes.
      150   end.
      151   function waitfram-check-timeout returns logical():
      152      define variable vtime as int64 no-undo.
      153      if mWaitFramStopTimeOut
      154      then
      155         return yes.
      156      vtime = ( now - mWaitFramStartProc ) / 1000 .
      157      if     mWaitFramTimeOut ne ?
      158         and mWaitFramTimeOut ne 0
      159         and mWaitFramTimeOut lt vtime
      160      then do:
      161         mWaitFramStopTimeOut = yes.
      162      end.
      163      return mWaitFramStopTimeOut.
      164   end.
      165   procedure waitfram-hide :
      166     if not session:batch-mode
      167     then do
      168     on error undo, return error return-value
      169     :
      170       pause 0 before-hide .
      171       if not mBatchMode then
      172         hide frame waitfram .
      173     if     not mWaitFramView
      174        and mWaitProcEvent
      175     then
      176       process events .
      177     end.
      178   end procedure.
      179   procedure waitfram-show :
      180     define input  parameter p-message as character no-undo .
      181     define variable v-left-margin as integer   no-undo .
      182     if not session:batch-mode
      183     then do
      184     on error undo, return error return-value
      185     :
      186       if length(p-message) <= 70 then do:
      187         assign
      188           v-left-margin = integer((70 - length(p-message)) / 2)
      189         .
      190         assign
      191           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      192         .
      193         assign
      194           v-waitfram-action01 = " "
      195           v-waitfram-action02 = " "
      196                                    + fill(" ", v-left-margin)
      197                                    + p-message
      198           v-waitfram-action03 = " "
      199         .
      200       end.
      201       else do:
      202         define variable vRindex1 as integer no-undo.
      203         define variable vRindex2 as integer no-undo.
      204         vRindex1 = r-index(p-message," ",70).
      205         if vRindex1 = 0
      206         then
      207            vRindex1 = 70.
      208         if length(p-message)  <= vRindex1 + 70 then do:
      209           assign
      210             v-waitfram-action01 = " "
      211             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      212             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      213           .
      214         end.
      215         else do:
      216           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      217           if vRindex2 <= vRindex1
      218           then
      219              vRindex2 = vRindex1 + 70.
      220           assign
      221             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      222             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      223             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      224           .
      225         end.
      226       end.
      227       B-viewProcInfo:visible   in frame waitfram = no.
      228       B-viewProcInfo:sensitive in frame waitfram = no.
      229       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      230       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      231       if  (   mWaitFramView
      232          or  mWaitProcEvent)
      233          and not mBatchMode
      234       then
      235          display
      236             v-waitfram-action01 skip
      237             v-waitfram-action02 skip
      238             v-waitfram-action03 skip
      239          with frame waitfram .
      240       if     mWaitFramView
      241          then do:
      242             if     mWaitFramInterval ne ?
      243                and not mBatchMode
      244             then
      245                wait-for go of frame waitfram pause mWaitFramInterval.
      246          end.
      247          else
      248             if     mWaitProcEvent
      249                and not mBatchMode
      250             then
      251                process events .
      252     end.
      253   end procedure.
      254      procedure waitfram-show-this:
      255         define input  parameter iInterval as int64 no-undo.
      256         define variable vtime as int64 no-undo.
      257         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      258         mWaitFramInterval = iInterval.
      259         run waitfram-show (substitute("&1&2 &3&4" ,
      260                                       mWaitFramTextBeg ,
      261                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      262                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      263                                       mWaitFramTextEnd
      264                                      )
      265                           ).
      266      end.
      267      procedure WaitFramRunPause:
      268         define input  parameter iInterval as dec no-undo.
      269         define variable vStart  as datetime-tz no-undo.
      270         define variable vend    as datetime-tz no-undo.
      271         define variable vint as int64 no-undo.
      272         define variable vOk as logical no-undo.
      273         vStart = now.
      274         vend   = vStart.
      275         publish "WaitFramPause" (iInterval,output vOk).
      276         vend   =  now.
      277         vint = vend - vStart.
      278         vint = iInterval - vint / 1000.
      279         if     not mWaitFramStop
      280            and (   vint > 0
      281                 or (    not vOk
      282                     and iInterval eq ?
      283                     )
      284                 )
      285         then
      286            run waitfram-show-this (iInterval).
      287         vend   =  now.
      288         vint = vend - vStart.
      289         vint = iInterval - vint / 1000.
      290         if     not mWaitFramStop
      291            and vint > 0
      292         then do:
      293            run gbl/pause.p (vint * 1000).
      294         end.
      295         if iInterval ne ?
      296         then
      297            publish "WaitFramStop".
      298         waitfram-check-timeout().
      299      end.
      300      procedure WaitFramWaitFor:
      301         define input  parameter iInterval as dec no-undo.
      302         assign
      303            mWaitFramStartProc   = now
      304            mWaitFramStopUser    = no
      305            mWaitFramStopTimeOut = no
      306         .
      307         block-wait:
      308         do while not mWaitFramStop:
      309            run WaitFramRunPause (iInterval).
      310            if  waitfram-check-timeout()
      311            then do:
      312               leave block-wait.
      313            end.
      314         end.
      315         run waitfram-hide.
      316      end.
      317   procedure waitfram-join :
      318     define input  parameter p-line-1  as character no-undo .
      319     define input  parameter p-line-2  as character no-undo .
      320     define input  parameter p-line-3  as character no-undo .
      321     define output parameter p-message as character no-undo .
      322     do
      323     on error undo, return error return-value
      324     :
      325       assign
      326         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      327                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      328                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      329       .
      330     end.
      331   end procedure.
      332   function waitfram-join-function returns character
      333     (input p-line-1 as character
      334     ,input p-line-2 as character
      335     ,input p-line-3 as character
      336     ).
      337     define variable v-message as character no-undo .
      338     run waitfram-join in this-procedure
      339       (input  p-line-1
      340       ,input  p-line-2
      341       ,input  p-line-3
      342       ,output v-message
      343       ) .
      344     return v-message .
      345   end function .
      346   define new global shared variable g#language as character no-undo .
      347   if g#language <> '' and g#language <> 'rus':U then do:
      348     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      349   end.
      350   define new global shared variable g#library  as handle no-undo .
      351   define new global shared variable g#library2 as handle no-undo .
      352   procedure proc-alt-shift-f2:
      353     if not ibs.th.gbl.gbl-var:rcode
      354   then
      355     run gbl\inidebug.p .
      356   end.
      357   procedure proc-alt-shift-f3:
      358     run gbl/prvssinf.p
      359       ( input this-procedure
      360       ) .
      361   end.
      362   define variable v-inform-launched as logical no-undo initial false .
      363   procedure proc-alt-shift-f4:
      364     define variable v-action as character no-undo .
      365     if v-inform-launched = false then do:
      366       assign
      367         v-inform-launched = true
      368       .
      369       run gbl/d-inform.w
      370         (  input self
      371         ,  input this-procedure
      372         , output v-action
      373         ) no-error .
      374       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      375       assign
      376         v-inform-launched = false
      377       .
      378     end.
      379   end.
      380   procedure proc-alt-f1:
      381     run gbl/corrhelp.p
      382       (input this-procedure
      383       ) .
      384   end .
      385   on alt-shift-f2 anywhere do:
      386     run proc-alt-shift-f2.
      387   end.
      388   on alt-shift-f3 anywhere do:
      389     run proc-alt-shift-f3 in this-procedure .
      390   end.
      391   on alt-shift-f4 anywhere do:
      392     run proc-alt-shift-f4 in this-procedure.
      393   end.
      394   on alt-f1 anywhere do:
      395     run proc-alt-f1 in this-procedure .
      396   end.
      397   function diff-list returns character (
      398     input parfirst-list  as character,
      399     input parsecond-list as character,
      400     input pardelim       as character).
      401     if pardelim = ""
      402     or pardelim = ?
      403     then do:
      404       assign
      405         pardelim = ","
      406       .
      407     end.
      408     def var ind as integer no-undo .
      409     def var v-elem as character no-undo .
      410     def var v-result-list as character no-undo init "".
      411     def var v-num-parfirst-list as integer no-undo .
      412     assign
      413       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      414     .
      415     do ind = 1 to v-num-parfirst-list
      416     :
      417       assign
      418         v-elem = entry(ind, parfirst-list, pardelim)
      419       .
      420       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      421         assign
      422           v-result-list = v-result-list
      423                         + (if v-result-list > "" then pardelim else "")
      424                         + v-elem
      425         .
      426       end.
      427     end.
      428     return v-result-list .
      429   end function.
      430   function add-list returns character (
      431    input parfirst-list  as character,
      432    input parsecond-list as character,
      433    input pardelim       as character).
      434     if pardelim = ""
      435     or pardelim = ?
      436     then do:
      437       assign
      438         pardelim = ","
      439       .
      440     end.
      441     def var ind as integer no-undo .
      442     def var v-elem as character no-undo .
      443     def var v-result-list as character no-undo init "".
      444     def var v-num-parfirst-list as integer no-undo .
      445     assign
      446       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      447     .
      448     do ind = 1 to v-num-parfirst-list
      449     :
      450       assign
      451         v-elem = entry(ind, parfirst-list, pardelim)
      452       .
      453       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      454         assign
      455           v-result-list = v-result-list
      456                         + (if v-result-list > "" then pardelim else "")
      457                         + v-elem
      458         .
      459       end.
      460     end.
      461     def var v-num-parsecond-list as integer no-undo .
      462     assign
      463       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      464     .
      465     do ind = 1 to v-num-parsecond-list
      466     :
      467       assign
      468         v-elem = entry(ind, parsecond-list, pardelim)
      469       .
      470       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      471         assign
      472           v-result-list = v-result-list
      473                         + (if v-result-list > "" then pardelim else "")
      474                         + v-elem
      475         .
      476       end.
      477     end.
      478     return v-result-list .
      479   end function.
      480   function cross-list returns character (
      481    input parfirst-list  as character,
      482    input parsecond-list as character,
      483    input pardelim       as character).
      484     if pardelim = ""
      485     or pardelim = ?
      486     then do:
      487       assign
      488         pardelim = ","
      489       .
      490     end.
      491     def var ind as integer no-undo .
      492     def var v-elem as character no-undo .
      493     def var v-result-list as character no-undo init "".
      494     def var v-num-parfirst-list as integer no-undo .
      495     assign
      496       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      497     .
      498     do ind = 1 to v-num-parfirst-list
      499     :
      500       assign
      501         v-elem = entry(ind, parfirst-list, pardelim)
      502       .
      503       if lookup(v-elem, v-result-list, pardelim) = 0
      504       and lookup(v-elem, parsecond-list, pardelim) > 0
      505       then do:
      506         assign
      507           v-result-list = v-result-list
      508                         + (if v-result-list > "" then pardelim else "")
      509                         + v-elem
      510         .
      511       end.
      512     end.
      513     return v-result-list .
      514   end function.
      515   function radio-label returns character (
      516    input par-rs-value  as character,
      517    input par-rs-radio-buttons as character)
      518    .
      519    DEFINE variable v-result-label as character no-undo.
      520    assign
      521    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      522                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      523                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      524                             ), par-rs-radio-buttons
      525                           )
      526    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      527    .
      528   return v-result-label.
      529   end function.
      530   function m-radio-label returns character (
      531    input par-rs-value  as character,
      532    input par-rs-radio-buttons as character,
      533    input par-delim as character
      534    )
      535    .
      536    DEFINE variable v-result-label as character no-undo.
      537    assign
      538    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      539                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      540                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      541                             ), par-rs-radio-buttons, par-delim
      542                           )
      543    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      544    .
      545   return v-result-label.
      546   end function.
      547   FUNCTION mixlist returns character
      548   (
      549    input parfirst-list  as character
      550    ,input parsecond-list as character
      551    ,input pardelim       as character
      552    ,input pardelim-result as character ) :
      553     if pardelim = ""
      554     or pardelim = ?
      555     then do:
      556       assign
      557         pardelim = ","
      558       .
      559     end.
      560     def var ind as integer no-undo .
      561     def var v-elem1 as character no-undo .
      562     def var v-elem2 as character no-undo .
      563     def var v-result-list as character no-undo init "".
      564     do ind = 1 to num-entries(parfirst-list, pardelim)
      565     :
      566       assign
      567         v-elem1 = entry(ind, parfirst-list, pardelim)
      568         v-elem2 = entry(ind, parsecond-list, pardelim)
      569       .
      570         assign
      571           v-result-list = v-result-list
      572                         + (if v-result-list > "" then pardelim-result else "")
      573                         + v-elem1 + pardelim-result + v-elem2
      574         .
      575     end.
      576     return v-result-list .
      577   END FUNCTION.
      578   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      579   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      580     define variable v-cntxt-db-num        as integer   no-undo .
      581     define variable v-cntxt-userid        as character no-undo .
      582     define variable v-cntxt-level         as character no-undo .
      583     define variable v-cntxt-host-code-obj as integer   no-undo .
      584     define variable v-cntxt-obj-type      as character no-undo .
      585     define variable v-cntxt-obj-code      as integer   no-undo .
      586     define variable v-cntxt-db-num-obj    as integer   no-undo .
      587     define variable v-cntxt-is-admin      as logical   no-undo .
      588   define variable is-elved-chr as character no-undo .
      589   define variable par-type as character no-undo .
      590   define buffer buf_prop-head for ub.prop-head.
      591   define buffer buf_prop-ref for ub.prop-ref.
      592   DEFINE BUTTON B-exit AUTO-GO
      593        LABEL "&Ввод"
      594        SIZE 10 BY 1
      595        BGCOLOR 8 .
      596   DEFINE BUTTON B-Help
      597        LABEL "Помо&щь"
      598        SIZE 3 BY 1
      599        BGCOLOR 8 .
      600   DEFINE BUTTON b-quit AUTO-END-KEY
      601        LABEL "&Отмена"
      602        SIZE 10 BY 1
      603        BGCOLOR 8 .
      604   DEFINE VARIABLE f-for AS DECIMAL FORMAT ">>>>>>>>>>>>>>>>>>>9":U INITIAL 0
      605        LABEL "от"
      606        VIEW-AS FILL-IN
      607        SIZE 50 BY 1 NO-UNDO.
      608   DEFINE VARIABLE f-to AS DECIMAL FORMAT ">>>>>>>>>>>>>>>>>>>9":U INITIAL 0
      609        LABEL "до"
      610        VIEW-AS FILL-IN
      611        SIZE 50 BY 1 NO-UNDO.
      612   DEFINE FRAME Dialog-Frame
      613        B-exit AT ROW 1 COL 1
      614        b-quit AT ROW 1 COL 11
      615        B-Help AT ROW 1 COL 78
      616        f-for AT ROW 4 COL 9 COLON-ALIGNED
      617        f-to AT ROW 6 COL 9 COLON-ALIGNED
      618        "Диапазон номеров карт:" VIEW-AS TEXT
      619             SIZE 38 BY 1.04 AT ROW 2.46 COL 11.13 WIDGET-ID 4
      620        SPACE(32.49) SKIP(5.74)
      621       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      622            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      623            TITLE "Классы ограничений для ДК"
      624            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      625   ASSIGN
      626          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      627          FRAME Dialog-Frame:HIDDEN           = TRUE.
      628   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      629   DO:
      630     APPLY "END-ERROR":U TO SELF.
      631   END.
      632   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      633   DO:
      634     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      635     IF ERROR-STATUS:error THEN RETURN NO-APPLY.
      636   END.
      637   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      638   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      639   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      640   on help of frame Dialog-Frame
      641   do:
      642     run gbl/app_help.p
      643       (input this-procedure :file-name
      644       ,input ''
      645       ,input ?
      646       ) no-error.
      647     if error-status :error then do:
      648       message
      649         "Ошибка при вызове помощи"
      650         error-status :get-message(1)
      651         view-as alert-box .
      652     end.
      653   end.
      654   run minbtn-set in this-procedure .
      655   on choose of b-help in frame Dialog-Frame
      656   do:
      657     apply "help":u to frame Dialog-Frame .
      658   end.
      659   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      660   procedure minbtn-set :
      661       do
      662           on error undo, return error return-value
      663           :
      664           define variable ii              as integer       no-undo .
      665           define variable fh              as widget-handle no-undo .
      666           define variable hh              as widget-handle no-undo .
      667           define variable v-h             as handle        extent 4 no-undo .
      668           define variable v-name-button   as character     no-undo .
      669           define variable v-help-old-x    as decimal       no-undo .
      670           define variable v-help-old-y    as decimal       no-undo .
      671           define variable v-help-old-size as decimal       no-undo .
      672           define variable v-frame-width   as decimal       no-undo .
      673           define variable jj              as integer       no-undo .
      674           do
      675               on error undo, return error
      676               :
      677               assign
      678                   v-frame-width = frame Dialog-Frame:width - 0.3
      679                   fh            = frame Dialog-Frame:first-child
      680                   hh            = fh:first-child
      681                   ii            = 1
      682                   .
      683               do while valid-handle(hh):
      684                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      685                   do:
      686                       case lc(hh:name) :
      687                           when "b-help" then
      688                               do:
      689                                   hh:load-image-up("cmp/b-help.bmp":u) .
      690                                   hh:load-image-down("cmp/b-help.bmp":u) .
      691                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      692                                   hh:TOOLTIP = "Помощь" .
      693                                   v-help-old-x = hh:column .
      694                                   v-help-old-y = hh:row    .
      695                                   v-help-old-size = hh:width .
      696                                   hh:width-chars = 2.5 .
      697                               end.
      698                           when "b-print" then
      699                               do:
      700                                   hh:load-image("cmp/b-print.bmp":u) .
      701                                   hh:TOOLTIP = "Печать" .
      702                                   v-h[ii] = hh:handle .
      703                                   ii = ii + 1 .
      704                                   hh:width-chars = 3 .
      705                               end.
      706                           when "b-history" or
      707                           when "b-hist" then
      708                               do:
      709                                   hh:load-image("cmp/b-hist.bmp":u) .
      710                                   hh:TOOLTIP = "История" .
      711                                   v-h[ii] = hh:handle .
      712                                   ii = ii + 1 .
      713                                   hh:width-chars = 3 .
      714                               end.
      715                           when "b-sch" then
      716                               do:
      717                                   hh:load-image("cmp/b-sch.bmp":u) .
      718                                   hh:TOOLTIP = "Установка Фильтра" .
      719                                   v-h[ii] = hh:handle .
      720                                   ii = ii + 1 .
      721                                   hh:width-chars = 3 .
      722                               end.
      723                           when "b-hist-user" then
      724                               do:
      725                                   hh:load-image("cmp/b-hist.bmp":u) .
      726                                   hh:TOOLTIP = "История пользователя" .
      727                                   ii = ii + 1 .
      728                               end.
      729                       end case.
      730                   end.
      731                   hh = hh:next-sibling.
      732               end.
      733               b-help:column = v-frame-width - b-help:width-chars.
      734               jj = 0.
      735               repeat ii = 4 to 1 by -1 :
      736                   if valid-handle (v-h[ii] ) then
      737                   do:
      738                       jj  = jj + 1 .
      739                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      740                       v-h[ii]:row    = v-help-old-y .
      741                   end.
      742               end.
      743           end.
      744       end.
      745   end procedure.
      746   MAIN-BLOCK:
      747   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      748      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      749   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      750     run mainmenu_getcntxt in parparentproc
      751       (output v-cntxt-db-num
      752       ,output v-cntxt-userid
      753       ,output v-cntxt-level
      754       ,output v-cntxt-host-code-obj
      755       ,output v-cntxt-obj-type
      756       ,output v-cntxt-obj-code
      757       ,output v-cntxt-db-num-obj
      758       ,output v-cntxt-is-admin
      759       ) .
      760     IF p-mode <> 'ДОБАВЛЕНИЕ':U
      761     AND p-mode <> 'ИЗМЕНЕНИЕ':U
      762     AND p-mode <> 'ПРОСМОТР':U THEN DO:
      763       MESSAGE
      764       substitute("Неверное значение параметра p-mode=&1", p-mode)
      765       VIEW-AS ALERT-BOX ERROR.
      766       UNDO, RETURN ERROR.
      767     END.
      768     find first buf_prop-head no-lock where
      769               buf_prop-head.dtm-code = p-dtm-code.
      770     RUN Myenable IN THIS-PROCEDURE.
      771     WAIT-FOR GO OF FRAME Dialog-Frame.
      772   END.
      773   RUN disable_UI.
      774   PROCEDURE disable_UI :
      775     HIDE FRAME Dialog-Frame.
      776   END PROCEDURE.
      777   PROCEDURE enable_UI :
      778     DISPLAY f-for f-to
      779         WITH FRAME Dialog-Frame.
      780     ENABLE B-exit b-quit B-Help f-for f-to
      781         WITH FRAME Dialog-Frame.
      782     VIEW FRAME Dialog-Frame.
      783   END PROCEDURE.
      784   PROCEDURE MyEnable :
      785   DEFINE BUFFER buf_goods FOR ub.goods.
      786   DEFINE BUFFER buf_cash-pay FOR ub.cash-pay.
      787   DEFINE BUFFER buf_dis-card-type FOR ub.dis-card-type.
      788   FOR EACH temp-dis-card-property where
      789          temp-dis-card-property.dtm-code = p-dtm-code
      790       and temp-dis-card-property.sum-id = p-sum-id
      791       and temp-dis-card-property.host-code = p-host-code
      792       and temp-dis-card-property.obj-type = p-obj-type
      793       and temp-dis-card-property.obj-code = p-obj-code
      794       :
      795      CASE temp-dis-card-property.node-code:
      796        WHEN 1 THEN DO:
      797           f-for = temp-dis-card-property.property-value-decimal.
      798        END.
      799        WHEN 2 THEN DO:
      800           f-to = temp-dis-card-property.property-value-decimal.
      801        END.
      802     END CASE.
      803   END.
      804   DISPLAY
      805   f-for
      806   f-to
      807   WITH FRAME Dialog-Frame.
      808   ENABLE
      809   B-exit WHEN p-mode <> 'ПРОСМОТР':U
      810   b-quit
      811   B-Help
      812   f-for WHEN p-mode <> 'ПРОСМОТР':U
      813   f-to WHEN p-mode <> 'ПРОСМОТР':U
      814   WITH FRAME Dialog-Frame.
      815   VIEW FRAME Dialog-Frame.
      816   IF p-mode = 'ПРОСМОТР':U  THEN DO:
      817     ASSIGN
      818     b-quit:LABEL = "&Выход"
      819     b-quit:COLUMN = 1
      820     .
      821     HIDE
      822     b-exit
      823     IN FRAME Dialog-Frame.
      824   END.
      825   END PROCEDURE.
      826   PROCEDURE proc-save :
      827   DEFINE BUFFER buf_prop-map FOR ub.prop-map.
      828   ASSIGN
      829   FRAME Dialog-Frame
      830   f-for
      831   f-to
      832   .
      833   IF f-for = ?
      834   or f-to = ?
      835   THEN DO:
      836     MESSAGE
      837     "Не задан диапазон номеров ДК"
      838     view-as ALERT-BOX ERROR.
      839     UNDO, RETURN ERROR.
      840   END.
      841   FOR EACH buf_prop-map NO-LOCK WHERE
      842           buf_prop-map.dtm-code = p-dtm-code
      843        and buf_prop-map.node-code > 0:
      844     FIND FIRST temp-dis-card-property WHERE
      845               temp-dis-card-property.d-card = p-d-card
      846         AND   temp-dis-card-property.dt-code = p-dt-code
      847         AND   temp-dis-card-property.node-code = buf_prop-map.node-code
      848         AND   temp-dis-card-property.host-code = p-host-code
      849         AND   temp-dis-card-property.obj-type = p-obj-type
      850         AND   temp-dis-card-property.obj-code = p-obj-code NO-ERROR.
      851     IF NOT AVAILABLE temp-dis-card-property THEN DO:
      852       CREATE temp-dis-card-property.
      853       ASSIGN
      854       temp-dis-card-property.d-card = p-d-card
      855       temp-dis-card-property.dt-code = p-dt-code
      856       temp-dis-card-property.dtm-code = p-dtm-code
      857       temp-dis-card-property.sum-id = p-sum-id
      858       temp-dis-card-property.node-code = buf_prop-map.node-code
      859       temp-dis-card-property.host-code = p-host-code
      860       temp-dis-card-property.obj-type = p-obj-type
      861       temp-dis-card-property.obj-code = p-obj-code
      862       temp-dis-card-property.prop-label = buf_prop-head.prop-label
      863       temp-dis-card-property.node-label = buf_prop-map.node-label
      864       temp-dis-card-property.data-type = buf_prop-map.node-value-type
      865       .
      866     END.
      867   END.
      868   FOR EACH temp-dis-card-property
      869      where temp-dis-card-property.d-card = p-d-card
      870   and temp-dis-card-property.dtm-code = p-dtm-code
      871   and temp-dis-card-property.dt-code = p-dt-code
      872   and temp-dis-card-property.host-code = p-host-code
      873   and temp-dis-card-property.obj-type = p-obj-type
      874   and temp-dis-card-property.obj-code = p-obj-code
      875      :
      876      CASE temp-dis-card-property.node-code:
      877        WHEN 1 THEN DO:
      878           temp-dis-card-property.property-value-decimal = f-for .
      879        END.
      880        WHEN 2 THEN DO:
      881           temp-dis-card-property.property-value-decimal = f-to .
      882        END.
      883     END CASE.
      884   END.
      885   ASSIGN
      886   p-setted = YES
      887   .
      888   END PROCEDURE.
