        1   DEFINE BUFFER locked_delivery-subject FOR ub.delivery-subject.
        2   DEFINE TEMP-TABLE tt-delivery-subject NO-UNDO LIKE ub.delivery-subject.
        3   DEFINE BUFFER X_curr_clients FOR ub.clients.
        4   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        5   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
        6   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
        7   define input parameter p-mode as character no-undo.
        8   DEFINE INPUT PARAMETER p-deliv-subj-code LIKE ub.delivery-subject.deliv-subj-code NO-UNDO.
        9   define input-output parameter p-doc-rec as recid no-undo.
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Карточка редактирования СУБЪЕКТА ДОСТАВКИ".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   procedure proc-alt-shift-f2:
       77     if not ibs.th.gbl.gbl-var:rcode
       78   then
       79     run gbl\inidebug.p .
       80   end.
       81   procedure proc-alt-shift-f3:
       82     run gbl/prvssinf.p
       83       ( input this-procedure
       84       ) .
       85   end.
       86   define variable v-inform-launched as logical no-undo initial false .
       87   procedure proc-alt-shift-f4:
       88     define variable v-action as character no-undo .
       89     if v-inform-launched = false then do:
       90       assign
       91         v-inform-launched = true
       92       .
       93       run gbl/d-inform.w
       94         (  input self
       95         ,  input this-procedure
       96         , output v-action
       97         ) no-error .
       98       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       99       assign
      100         v-inform-launched = false
      101       .
      102     end.
      103   end.
      104   procedure proc-alt-f1:
      105     run gbl/corrhelp.p
      106       (input this-procedure
      107       ) .
      108   end .
      109   on alt-shift-f2 anywhere do:
      110     run proc-alt-shift-f2.
      111   end.
      112   on alt-shift-f3 anywhere do:
      113     run proc-alt-shift-f3 in this-procedure .
      114   end.
      115   on alt-shift-f4 anywhere do:
      116     run proc-alt-shift-f4 in this-procedure.
      117   end.
      118   on alt-f1 anywhere do:
      119     run proc-alt-f1 in this-procedure .
      120   end.
      121   define variable v-tab-order as character no-undo.
      122   define variable v-db-num LIKE ub.db.db-num no-undo.
      123   define variable v-last-code like ub.delivery-subject.deliv-subj-code no-undo.
      124   DEFINE BUTTON B-exit AUTO-GO
      125        LABEL "&Ввод"
      126        SIZE 10 BY 1
      127        BGCOLOR 8 .
      128   DEFINE BUTTON B-Help
      129        LABEL "Помо&щь"
      130        SIZE 3 BY 1
      131        BGCOLOR 8 .
      132   DEFINE BUTTON B-Hist
      133        LABEL "Ис&тория"
      134        SIZE 3 BY 1
      135        BGCOLOR 8 .
      136   DEFINE BUTTON b-quit AUTO-END-KEY
      137        LABEL "&Отмена"
      138        SIZE 10 BY 1
      139        BGCOLOR 8 .
      140   DEFINE BUTTON b-region
      141        IMAGE-UP FILE "btn-down-arrow":U
      142        IMAGE-DOWN FILE "btn-down-arrow":U
      143        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      144        LABEL "":L
      145        SIZE 3 BY 1.
      146   DEFINE VARIABLE f-reg-name AS CHARACTER FORMAT "X(256)":U
      147        VIEW-AS FILL-IN NATIVE
      148        SIZE 61.5 BY 1
      149        FGCOLOR 4  NO-UNDO.
      150   DEFINE QUERY Dialog-Frame FOR
      151         tt-delivery-subject SCROLLING.
      152   DEFINE FRAME Dialog-Frame
      153        B-exit AT ROW 1 COL 1
      154        b-quit AT ROW 1 COL 11
      155        B-Hist AT ROW 1 COL 92
      156        B-Help AT ROW 1 COL 95
      157        tt-delivery-subject.deliv-subj-code AT ROW 3 COL 34 COLON-ALIGNED
      158             LABEL "Внутр.код субъекта доставки"
      159             VIEW-AS FILL-IN
      160             SIZE 11 BY 1
      161        tt-delivery-subject.deliv-subj-name AT ROW 4.27 COL 34 COLON-ALIGNED
      162             LABEL "Название субъекта доставки"
      163             VIEW-AS FILL-IN
      164             SIZE 63 BY 1
      165        tt-delivery-subject.reg-code AT ROW 6.33 COL 34 COLON-ALIGNED WIDGET-ID 4
      166             LABEL "Регион"
      167             VIEW-AS FILL-IN
      168             SIZE 4 BY 1
      169        b-region AT ROW 6.33 COL 40 WIDGET-ID 2
      170        f-reg-name AT ROW 7.4 COL 34 COLON-ALIGNED NO-LABEL WIDGET-ID 6
      171        tt-delivery-subject.des AT ROW 10 COL 1 NO-LABEL
      172             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      173             SIZE 98 BY 3.77
      174        "Описание" VIEW-AS TEXT
      175             SIZE 16 BY 1 AT ROW 8.77 COL 1.5
      176        SPACE(81.74) SKIP(4.47)
      177       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      178            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      179            TITLE "Субъект доставки"
      180            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      181   ASSIGN
      182          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      183          FRAME Dialog-Frame:HIDDEN           = TRUE.
      184   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      185   DO:
      186     APPLY "END-ERROR":U TO SELF.
      187   END.
      188   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      189   DO:
      190       run proc-save in this-procedure no-error.
      191     if error-status:error then return no-apply.
      192   END.
      193   ON CHOOSE OF B-Hist IN FRAME Dialog-Frame
      194   DO:
      195     define variable v-rid-list as character no-undo.
      196       run ref/dlvcsubs.w
      197                   (
      198                    input parParentProc
      199                   ,INPUT p-curr-obj-type
      200                   ,INPUT p-curr-obj-code
      201                   ,input "":U
      202                   ,input "one":U
      203                   ,input locked_delivery-subject.deliv-subj-code
      204                   ,input-output v-rid-list
      205                                 )
      206    .
      207   END.
      208   ON CHOOSE OF b-region IN FRAME Dialog-Frame
      209   DO:
      210     define buffer buf_regions for ub.regions.
      211     define variable v-reg-code like ub.regions.reg-code no-undo .
      212     run ref/regions.w ( input  parParentProc
      213                       , input  'выбор':U
      214                       , output v-reg-code
      215                       ).
      216     if v-reg-code <> ? then do :
      217       find first buf_regions no-lock
      218         where buf_regions.reg-code = v-reg-code
      219       no-error .
      220       if not available buf_regions then do:
      221         message
      222           "Неверный код региона " v-reg-code
      223         view-as alert-box error.
      224         return no-apply.
      225       end.
      226       else do:
      227         assign
      228           tt-delivery-subject.reg-code = buf_regions.reg-code
      229         .
      230         display
      231         tt-delivery-subject.reg-code
      232         buf_regions.reg-name @ f-reg-name
      233         with frame Dialog-Frame.
      234       end.
      235     end.
      236   END.
      237   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      238   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      239   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      240   on help of frame Dialog-Frame
      241   do:
      242     run gbl/app_help.p
      243       (input this-procedure :file-name
      244       ,input ''
      245       ,input ?
      246       ) no-error.
      247     if error-status :error then do:
      248       message
      249         "Ошибка при вызове помощи"
      250         error-status :get-message(1)
      251         view-as alert-box .
      252     end.
      253   end.
      254   run minbtn-set in this-procedure .
      255   on choose of b-help in frame Dialog-Frame
      256   do:
      257     apply "help":u to frame Dialog-Frame .
      258   end.
      259   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      260   procedure minbtn-set :
      261       do
      262           on error undo, return error return-value
      263           :
      264           define variable ii              as integer       no-undo .
      265           define variable fh              as widget-handle no-undo .
      266           define variable hh              as widget-handle no-undo .
      267           define variable v-h             as handle        extent 4 no-undo .
      268           define variable v-name-button   as character     no-undo .
      269           define variable v-help-old-x    as decimal       no-undo .
      270           define variable v-help-old-y    as decimal       no-undo .
      271           define variable v-help-old-size as decimal       no-undo .
      272           define variable v-frame-width   as decimal       no-undo .
      273           define variable jj              as integer       no-undo .
      274           do
      275               on error undo, return error
      276               :
      277               assign
      278                   v-frame-width = frame Dialog-Frame:width - 0.3
      279                   fh            = frame Dialog-Frame:first-child
      280                   hh            = fh:first-child
      281                   ii            = 1
      282                   .
      283               do while valid-handle(hh):
      284                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      285                   do:
      286                       case lc(hh:name) :
      287                           when "b-help" then
      288                               do:
      289                                   hh:load-image-up("cmp/b-help.bmp":u) .
      290                                   hh:load-image-down("cmp/b-help.bmp":u) .
      291                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      292                                   hh:TOOLTIP = "Помощь" .
      293                                   v-help-old-x = hh:column .
      294                                   v-help-old-y = hh:row    .
      295                                   v-help-old-size = hh:width .
      296                                   hh:width-chars = 2.5 .
      297                               end.
      298                           when "b-print" then
      299                               do:
      300                                   hh:load-image("cmp/b-print.bmp":u) .
      301                                   hh:TOOLTIP = "Печать" .
      302                                   v-h[ii] = hh:handle .
      303                                   ii = ii + 1 .
      304                                   hh:width-chars = 3 .
      305                               end.
      306                           when "b-history" or
      307                           when "b-hist" then
      308                               do:
      309                                   hh:load-image("cmp/b-hist.bmp":u) .
      310                                   hh:TOOLTIP = "История" .
      311                                   v-h[ii] = hh:handle .
      312                                   ii = ii + 1 .
      313                                   hh:width-chars = 3 .
      314                               end.
      315                           when "b-sch" then
      316                               do:
      317                                   hh:load-image("cmp/b-sch.bmp":u) .
      318                                   hh:TOOLTIP = "Установка Фильтра" .
      319                                   v-h[ii] = hh:handle .
      320                                   ii = ii + 1 .
      321                                   hh:width-chars = 3 .
      322                               end.
      323                           when "b-hist-user" then
      324                               do:
      325                                   hh:load-image("cmp/b-hist.bmp":u) .
      326                                   hh:TOOLTIP = "История пользователя" .
      327                                   ii = ii + 1 .
      328                               end.
      329                       end case.
      330                   end.
      331                   hh = hh:next-sibling.
      332               end.
      333               b-help:column = v-frame-width - b-help:width-chars.
      334               jj = 0.
      335               repeat ii = 4 to 1 by -1 :
      336                   if valid-handle (v-h[ii] ) then
      337                   do:
      338                       jj  = jj + 1 .
      339                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      340                       v-h[ii]:row    = v-help-old-y .
      341                   end.
      342               end.
      343           end.
      344       end.
      345   end procedure.
      346   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      347   ON TAB ANYWHERE
      348   DO:
      349   define variable ii as integer no-undo .
      350   define variable fh as widget-handle no-undo .
      351   define variable hh as widget-handle no-undo .
      352   define variable v-next-widget-name as character no-undo .
      353   if v-tab-order <> '' then do:
      354     if self:type = "TOGGLE-BOX" then
      355     self:BGCOLOR = ?.
      356     assign
      357     ii = lookup(self:name, v-tab-order).
      358     assign
      359     ii = ii + 1
      360     v-next-widget-name = entry(ii, v-tab-order)
      361     no-error .
      362     if error-status:error then do:
      363       assign
      364       ii = 1
      365       v-next-widget-name = entry( ii, v-tab-order)
      366       .
      367     end.
      368     assign
      369     fh = frame Dialog-Frame:first-child
      370     hh = fh:first-child
      371     .
      372     do while valid-handle(hh):
      373       if hh:name = v-next-widget-name then do:
      374         if hh:sensitive  = yes
      375         AND hh:visible = yes then do:
      376           APPLY "ENTRY" to hh.
      377           return no-apply.
      378         end.
      379         else do:
      380           APPLY "TAB" to hh.
      381           return no-apply.
      382         end.
      383       end.
      384       hh = hh:next-sibling.
      385     end.
      386   end.
      387   END.
      388   ON BACK-TAB ANYWHERE
      389   DO:
      390   define variable ii as integer no-undo .
      391   define variable fh as widget-handle no-undo .
      392   define variable hh as widget-handle no-undo .
      393   define variable v-next-widget-name as character no-undo .
      394   if v-tab-order <> '' then do:
      395     assign
      396     ii = lookup(self:name, v-tab-order).
      397     .
      398     assign
      399     ii = (if ii = 1
      400           then  num-entries(v-tab-order)
      401           else ii - 1
      402           )
      403     v-next-widget-name = entry(ii, v-tab-order)
      404     .
      405     assign
      406     fh = frame Dialog-Frame:first-child
      407     hh = fh:first-child
      408     .
      409     do while valid-handle(hh):
      410       if hh:name = v-next-widget-name then do:
      411         if hh:sensitive  = yes
      412         AND hh:visible = yes then do:
      413           APPLY "ENTRY" to hh.
      414           return no-apply.
      415         end.
      416         else do:
      417         APPLY "BACK-TAB" to hh.
      418         return no-apply.
      419         end.
      420       end.
      421       hh = hh:next-sibling.
      422     end.
      423     end.
      424   END.
      425   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      426   ON RETURN ANYWHERE
      427   DO:
      428   define variable ii as integer no-undo .
      429   define variable fh as widget-handle no-undo .
      430   define variable hh as widget-handle no-undo .
      431   define variable v-next-widget-name as character no-undo .
      432     if v-tab-order <> '' then do:
      433       assign
      434       ii = lookup(self:name, v-tab-order).
      435       if ii = num-entries(v-tab-order) then do:
      436           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
      437           return no-apply.
      438       end.
      439       if self:type <> "BUTTON" and
      440         self:type <> "EDITOR"  then do:
      441         run proc-move-forward in this-procedure .
      442         return no-apply.
      443       end.
      444       if self:type = "BUTTON" then do:
      445         APPLY "CHOOSE" to self.
      446       end.
      447       if self:type = "TOGGLE-BOX" then
      448       self:BGCOLOR = ?.
      449       assign
      450       ii = ii + 1
      451       v-next-widget-name = entry(ii, v-tab-order)
      452       no-error .
      453       if error-status:error then do:
      454         assign
      455         ii = 1
      456         v-next-widget-name = entry( ii, v-tab-order)
      457         .
      458       end.
      459       assign
      460       fh = frame Dialog-Frame:first-child
      461       hh = fh:first-child
      462       .
      463       do while valid-handle(hh):
      464         if hh:name = v-next-widget-name then do:
      465           if hh:sensitive  = yes
      466           AND hh:visible = yes then do:
      467             if hh:type = "TOGGLE-BOX":U then do:
      468               assign
      469               hh:BGcolor = 1
      470               .
      471             end.
      472             APPLY "ENTRY" to hh.
      473             return no-apply.
      474           end.
      475           else do:
      476             APPLY "TAB" to hh.
      477             return no-apply.
      478           end.
      479         end.
      480         hh = hh:next-sibling.
      481       end.
      482     end.
      483   END.
      484   procedure proc-move-forward :
      485   define variable ii as integer no-undo .
      486   define variable fh as widget-handle no-undo .
      487   define variable hh as widget-handle no-undo .
      488   define variable v-next-widget-name as character no-undo .
      489   do
      490   on error undo, return error
      491   :
      492     if v-tab-order <> '' then do:
      493       if self:type = "TOGGLE-BOX" then
      494       self:BGCOLOR = ?.
      495       assign
      496       ii = lookup(self:name, v-tab-order).
      497       assign
      498       ii = ii + 1
      499       v-next-widget-name = entry(ii, v-tab-order)
      500       no-error .
      501       if error-status:error then do:
      502         assign
      503         ii = 1
      504         v-next-widget-name = entry( ii, v-tab-order)
      505         .
      506       end.
      507       assign
      508       fh = frame Dialog-Frame:first-child
      509       hh = fh:first-child
      510       .
      511       do while valid-handle(hh):
      512         if hh:name = v-next-widget-name then do:
      513           if hh:sensitive  = yes
      514           AND hh:visible = yes then do:
      515             if hh:type = "TOGGLE-BOX":U then do:
      516               assign
      517               hh:BGcolor = 1
      518               .
      519             end.
      520             APPLY "ENTRY" to hh.
      521             return.
      522           end.
      523           else do:
      524             assign
      525             ii = ii + 1
      526             v-next-widget-name = entry(ii, v-tab-order)
      527             no-error .
      528             if error-status:error then do:
      529               assign
      530               ii = 1
      531               v-next-widget-name = entry( ii, v-tab-order)
      532               .
      533             end.
      534           end.
      535         end.
      536         hh = hh:next-sibling.
      537       end.
      538     end.
      539   end.
      540   end procedure.
      541   MAIN-BLOCK:
      542   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      543      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      544    if p-mode  <> 'ДОБАВЛЕНИЕ':U
      545    and p-mode <> 'ИЗМЕНЕНИЕ':U
      546    and p-mode <> 'ПРОСМОТР':U
      547    then do:
      548       message
      549       vss-workfile vss-revision vss-description skip
      550       "Неверное значение параметров вызова p-mode"  p-mode
      551       view-as alert-box ERROR.
      552       undo, return error.
      553    end.
      554      find first X_curr_clients no-lock where
      555               X_curr_clients.obj-type = p-curr-obj-type
      556          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
      557     if not available X_curr_clients then do:
      558       message
      559       vss-workfile vss-revision vss-description skip
      560       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
      561       p-curr-obj-type p-curr-obj-code
      562       view-as alert-box ERROR.
      563       return error .
      564     end.
      565   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      567     (output v-db-num
      568     )  .
      569   IF v-db-num <> 0
      570   AND (p-mode = 'ДОБАВЛЕНИЕ':U
      571        OR p-mode = 'ИЗМЕНЕНИЕ':U ) THEN DO:
      572         message
      573       vss-workfile vss-revision vss-description skip
      574       "Неверное значение параметра вызова p-mode" p-mode skip
      575       "Нельзя редактировать запись СУБЪЕКТА ДОСТАВКИ в УБД"
      576       view-as alert-box ERROR.
      577       return error .
      578   END.
      579     for each tt-delivery-subject:
      580       delete tt-delivery-subject.
      581     end.
      582     if p-mode = 'ИЗМЕНЕНИЕ':U
      583     or p-mode = 'ПРОСМОТР':U then do:
      584       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      585         find first locked_delivery-subject EXclusive-lock where
      586                      recid(locked_delivery-subject) = p-doc-rec no-wait no-error.
      587         if locked locked_delivery-subject then do:
      588           message
      589           vss-workfile vss-revision vss-description skip
      590            "Запись СУБЪЕКТА ДОСТАВКИ занята"
      591           view-as alert-box error .
      592           undo, return error.
      593         end.
      594       end.
      595       else do:
      596         find first locked_delivery-subject no-lock where
      597                          recid(locked_delivery-subject) = p-doc-rec no-error .
      598         if not avail locked_delivery-subject then do:
      599           find first locked_delivery-subject no-lock where
      600                      locked_delivery-subject.deliv-subj-code = p-deliv-subj-code no-error .
      601         end.
      602       end.
      603       if not available locked_delivery-subject then do:
      604         message
      605         vss-workfile vss-revision vss-description skip
      606         "Не найдена запись СУБЪЕКТА ДОСТАВКИ"
      607         view-as alert-box error .
      608         undo, return error.
      609       end.
      610       create tt-delivery-subject.
      611       buffer-copy locked_delivery-subject to tt-delivery-subject.
      612      end.
      613      else do:
      614             create tt-delivery-subject.
      615             assign
      616            tt-delivery-subject.deliv-subj-code = v-last-code + 1
      617            .
      618      end.
      619     RUN Myenable.
      620     WAIT-FOR GO OF FRAME Dialog-Frame.
      621   END.
      622   RUN disable_UI.
      623   PROCEDURE disable_UI :
      624     HIDE FRAME Dialog-Frame.
      625   END PROCEDURE.
      626   PROCEDURE enable_UI :
      627     OPEN QUERY Dialog-Frame FOR EACH tt-delivery-subject SHARE-LOCK.
      628     GET FIRST Dialog-Frame.
      629     DISPLAY f-reg-name
      630         WITH FRAME Dialog-Frame.
      631     IF AVAILABLE tt-delivery-subject THEN
      632       DISPLAY tt-delivery-subject.deliv-subj-code
      633             tt-delivery-subject.deliv-subj-name tt-delivery-subject.reg-code
      634             tt-delivery-subject.des
      635         WITH FRAME Dialog-Frame.
      636     ENABLE B-exit b-quit B-Hist B-Help tt-delivery-subject.deliv-subj-code
      637            tt-delivery-subject.deliv-subj-name tt-delivery-subject.reg-code
      638            b-region tt-delivery-subject.des
      639         WITH FRAME Dialog-Frame.
      640     VIEW FRAME Dialog-Frame.
      641   END PROCEDURE.
      642   PROCEDURE MyENable :
      643   DEFINE BUFFER buf_regions FOR ub.regions.
      644   IF tt-delivery-subject.reg-code > 0  THEN DO:
      645     find first buf_regions no-lock
      646         where buf_regions.reg-code = tt-delivery-subject.reg-code
      647       no-error .
      648     if not available buf_regions then do:
      649       message
      650       SUBSTITUTE("Неверный код региона &1", tt-delivery-subject.reg-code)
      651       view-as alert-box error.
      652      end.
      653   END.
      654   case p-mode:
      655     when 'ДОБАВЛЕНИЕ':U then do:
      656       display
      657       ? @ tt-delivery-subject.deliv-subj-code
      658       WITH FRAME Dialog-Frame.
      659     end.
      660     otherwise do:
      661       IF AVAILABLE tt-delivery-subject THEN
      662       DISPLAY
      663       tt-delivery-subject.deliv-subj-code
      664       tt-delivery-subject.deliv-subj-name
      665       tt-delivery-subject.des
      666       (IF AVAILABLE buf_regions
      667        THEN buf_regions.reg-name
      668        ELSE '')   @ f-reg-name
      669       WITH FRAME Dialog-Frame.
      670     end.
      671   END CASE.
      672   if p-mode = 'ПРОСМОТР':U then do:
      673   assign
      674   b-quit:label = "&Выход"
      675   .
      676   hide
      677   b-exit in frame Dialog-Frame.
      678   end.
      679   ENABLE
      680   B-exit when p-mode <> 'ПРОСМОТР':U
      681   b-quit
      682   B-Hist when p-mode <> 'ДОБАВЛЕНИЕ':U
      683   b-region when p-mode <> 'ПРОСМОТР':U
      684   B-Help
      685   tt-delivery-subject.deliv-subj-name when p-mode <> 'ПРОСМОТР':U
      686   tt-delivery-subject.des when p-mode <> 'ПРОСМОТР':U
      687   WITH FRAME Dialog-Frame.
      688   VIEW FRAME Dialog-Frame.
      689   END PROCEDURE.
      690   PROCEDURE Proc-save :
      691   if p-mode = 'ПРОСМОТР':U then do:
      692       return error.
      693   end.
      694   if not available tt-delivery-subject then do:
      695       create tt-delivery-subject.
      696   end.
      697   assign
      698   tt-delivery-subject.deliv-subj-code frame Dialog-Frame
      699   tt-delivery-subject.deliv-subj-name
      700   tt-delivery-subject.des = tt-delivery-subject.des:SCREEN-VALUE
      701   .
      702    run ref/dlvsubj1.p (
      703   input-output p-doc-rec
      704   ,input p-mode
      705   ,input tt-delivery-subject.deliv-subj-code
      706   ,input tt-delivery-subject.deliv-subj-name
      707   ,input tt-delivery-subject.reg-code
      708   ,input tt-delivery-subject.des
      709   )
      710   no-error.
      711   if error-status:error then do:
      712   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      713   define variable fh as widget-handle no-undo .
      714   define variable hh as widget-handle no-undo .
      715   define variable rv as character no-undo .
      716   assign
      717   rv = entry(1, return-value , chr(4)).
      718   if rv <> "":U then do:
      719     assign
      720     fh = frame Dialog-Frame:first-child
      721     hh = fh:first-child
      722     .
      723     do while valid-handle(hh):
      724       if hh:name = rv then do:
      725         APPLY "ENTRY" to hh.
      726         undo ,
      727         return error.
      728       end.
      729       hh = hh:next-sibling.
      730     end.
      731   end.
      732     undo, return error.
      733   end.
      734   END PROCEDURE.
