    10652               AND tt0-dis-gds-rule.obj-code = v-host-code))
    10653               or  (v-cntxt-db-num = 0
    10654                   and
    10655                   (tt0-dis-gds-rule.obj-type = '':U
    10656               AND tt0-dis-gds-rule.obj-code = 0))
