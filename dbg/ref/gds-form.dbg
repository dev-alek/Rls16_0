    10938                 end.
    10939                 else do:
    10940                   define variable v-format         as character no-undo .
    10941                   define variable v-label          as character no-undo .
    10942                   define variable v-user-can-edit  as logical   no-undo .
    10943                   define variable v-output-display as logical   no-undo .
    10944                   define variable v-other          as character no-undo .
    10945                   define variable v-type           as character no-undo .
    10946                   define variable jj as integer no-undo .
    10947                   define variable v-init-value as character no-undo .
    10948                   run gdspoatr-name in this-procedure
    10949                     (input  locked_gds-obj-prop-attr.attr-code
    10950                     ,output v-type
    10951                     ,output v-format
    10952                     ,output v-label
    10953                     ,output v-user-can-edit
    10954                     ,output v-output-display
    10955                     ,output v-other
    10956                     ) no-error .
    10957                   if error-status :error then do:
    10958                     undo, return error return-value .
    10959                 end.
    10960                   do jj = 1 to num-entries(v-other, chr(47)):
    10961                     if entry(1, entry(jj, v-other, chr(47)), "=":U) = "init-value":U then do:
    10962                       assign
    10963                       v-init-value = string(entry(2, entry(jj, v-other, chr(47)), "=":U))
    10964                       .
    10965                     end.
    10966                   end.
    10967                   if ttj-gds-obj-prop-attr.attr-value <> v-init-value then do:
    10968                     v-update-gds-prop = yes.
    10969         end.
    10970       end.
    10971               end.
    10972             end.
    10973           end.
    10974         end.
    10975       end.
    10976       if v-update-add-prop then do:
    10977         find first tt0-gds-add-charges no-error.
    10978         if available locked_gds-add-charges
    10979         and available tt0-gds-add-charges
    10980         then do:
    10981           v-updated-str = "":U.
    10982           buffer-compare locked_gds-add-charges
    10983           to tt0-gds-add-charges
    10984           case-sensitive
    10985           save result in v-updated-str.
    10986           v-update-add-prop = (v-updated-str <> "":U).
    10987         end.
    10988         else do:
    10989           if available tt0-gds-add-charges then
    10990           v-update-add-prop = yes.
    10991         end.
    10992       end.
    10993     end.
    10994     if copymode and v-found-copy-atr-obj then v-update-attr-obj = yes.
    10995     if copymode and v-found-copy-atr-host then v-update-attr-host = yes.
    10996     if copymode and v-found-copy-atr-gbl then v-update-attr-gbl = yes.
    10997     if copymode and v-found-copy-fbr-gds  then v-update-fbr-gds = yes.
    10998     if copymode and v-found-copy-s-coeff  then v-update-s-coeff = yes.
    10999     if copymode and v-found-copy-gds-prop  then v-update-gds-prop = yes.
    11000     if copymode and v-found-copy-add-prop  then v-update-add-prop = yes.
    11001     if copymode and v-found-copy-dgr       then v-update-dgr = yes.
    11002     if mode = 'ДОБАВЛЕНИЕ':U then return.
    11003     if not p-exit-without-save then return.
    11004     if v-update-attr-obj
    11005     or v-update-attr-host
    11006     or v-update-attr-gbl
    11007     or v-update-fbr-gds
    11008     or v-update-s-coeff
    11009     or v-update-gds-prop
    11010     or v-update-add-prop
    11011     or v-update-dgr
    11012     THEN DO:
    11013          MESSAGE
    11014         ( (if v-update-attr-obj
    11015           then "Были изменены атрибуты товара на объекте"
    11016           else "":U) + chr(10) +
    11017         (if v-found-copy-atr-obj then " или были унаследованы атрибуты товара на объекте" else "":U) + chr(10) +
    11018           (if v-update-attr-host
    11019           then "Были изменены атрибуты товара на фирме"
    11020           else "":U) + chr(10) +
    11021         (if v-found-copy-atr-host then " или были унаследованы атрибуты товара на фирме" else "":U) + chr(10) +
    11022         (if v-update-attr-gbl
    11023           then "Были изменены глобальные атрибуты товара"
    11024           else "":U) + chr(10) +
    11025         (if v-found-copy-atr-gbl then " или были унаследованы глобальные атрибуты товара" else "":U) + chr(10) +
    11026         ( if v-update-fbr-gds
    11027           then "Были изменены атрибуты РЕСТОРАН товара на объекте"
    11028           else "":U) + chr(10) +
    11029         (if v-found-copy-fbr-gds then " или были унаследованы атрибуты РЕСТОРАН товара на объекте" else "":U) + chr(10) +
    11030         ( if v-update-s-coeff
    11031           then "Были изменены сезонные коэффициенты товара"
    11032           else "":U) + chr(10) +
    11033         ( if v-update-dgr
    11034           then "Были изменены скидки товара на объекте"
    11035           else "":U) + chr(10) +
    11036         (if v-found-copy-s-coeff then " или были унаследованы сезонные коэффициенты товара" else "":U) + chr(10) +
    11037         ( if v-update-gds-prop
    11038           then "Были изменены индикаторы/атрибуты для заказа товара"
    11039           else "":U) + chr(10) +
    11040         (if v-found-copy-gds-prop then " или были унаследованы индикаторы/атрибуты для заказа товара" else "":U) + chr(10) +
    11041         ( if v-update-add-prop
    11042           then "Были изменены дополнительные расходы"
    11043           else "":U) + chr(10) +
    11044         (if v-found-copy-add-prop then " или были унаследованы дополнительные расходы" else "":U) + chr(10)
    11045         )
    11046          "Сделанные изменения будут отменены" skip
    11047          "Продолжить?"
    11048          VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
    11049          IF NOT glog  THEN RETURN error.
    11050      END.
    11051     end.
    11052   end procedure.
    11053   procedure reposition-goods :
    11054   define input parameter p-direction as character no-undo .
    11055   define variable v-new-goods-recid as recid no-undo .
    11056   define buffer buf_goods for ub.goods.
    11057   do
    11058   on error undo, return error
    11059   :
    11060     if valid-handle(p-call-prog)
    11061     then do:
    11062       run reposition-goods in p-call-prog
    11063         (input  p-direction
    11064         ,output v-new-goods-recid
    11065         ).
    11066       if v-new-goods-recid <> ?
    11067       then do:
    11068         find first buf_goods no-lock
    11069           where recid(buf_goods) = v-new-goods-recid
    11070           no-error .
    11071         assign
    11072         gds-rec = v-new-goods-recid
    11073         v-next-prev = '':U
    11074         .
    11075       end.
    11076     end.
    11077     else do:
    11078       message "Список товаров не определен." view-as alert-box INFORMATION .
    11079       undo, return.
    11080     end.
    11081   end.
    11082   end procedure.
    11083   procedure cb-for-struct-i :
    11084   define output parameter p-struct as character no-undo .
    11085     do
    11086     on error undo, return error
    11087     :
    11088       p-struct = temp-goods.struct.
    11089     end.
    11090   end procedure.
    11091   procedure proc-b-extart:
    11092     define input  parameter p-gds-code like ub.goods.gds-code no-undo .
    11093     do
    11094     on error undo, return error return-value
    11095     :
    11096       run ref/eartform.w ( input parParentProc
    11097                          , input 'ПРОСМОТР':U
    11098                          , input p-gds-code
    11099                          ) no-error .
    11100       if error-status :error then do:
    11101         message
    11102           error-status :get-message(1)
    11103         view-as alert-box information .
    11104       end.
    11105     end.
    11106   end procedure.
    11107   procedure proc-alc-attr:
    11108   end procedure.
    11109   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11110   procedure local-gds_inf :
    11111     for each tt-goods
    11112     :
    11113       delete tt-goods.
    11114     end.
    11115     for each tt-clients
    11116     :
    11117       delete tt-clients.
    11118     end.
    11119     create tt-goods.
    11120     buffer-copy goods to tt-goods.
    11121     create tt-clients.
    11122     assign
    11123       tt-clients.obj-type = p-obj-type
    11124       tt-clients.obj-code = p-obj-code
    11125     .
    11126     define variable v-ok as logical   no-undo .
    11127     define variable v-chk-act-host-code as integer   no-undo .
    11128   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11129   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    11130     (input  tt-clients.obj-type
    11131     ,input  tt-clients.obj-code
    11132     ,output v-chk-act-host-code
    11133     )  .
    11134   define variable vss-include-info55 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11135   do:
    11136     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    11137       (input  v-cntxt-db-num
    11138       ,input  v-cntxt-userid
    11139       ,input  0
    11140       ,input  'actn_reference_archive':U
    11141       ,input  'firm':U
    11142       ,input  v-chk-act-host-code
    11143       ,input  '':U
    11144       ,input  0
    11145       ,input  0
    11146       ,input  0
    11147       ,input  0
    11148       ,input  true
    11149       ,output v-ok
    11150       )  .
    11151   end.
    11152     if v-ok then do:
    11153       run arc/gds_inf.w (parparentproc, tt-clients.obj-type, tt-clients.obj-code).
    11154     end.
    11155   end procedure.
