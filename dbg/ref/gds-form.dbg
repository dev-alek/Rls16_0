     6181       FIND ub.units WHERE recid (ub.units) = ref-rec NO-LOCK.
     6182       DISPLAY ub.units.unit-name @ ub.goods.unit-cli with frame d-gds-form.
     6183       if input frame d-gds-form ub.goods.unit-cli =
     6184               input frame d-gds-form ub.goods.unit-base then
