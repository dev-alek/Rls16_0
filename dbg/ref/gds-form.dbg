     6123               FIND ub.country WHERE recid (ub.country) = integer(rid-list) NO-LOCK.
     6124               DISPLAY ub.country.alpha1 @ ub.goods.alpha1 with frame d-gds-form.
     6125           end.
     6126       return no-apply.
     6127   end.
     6128   ON choose OF r-alpha1 IN FRAME d-gds-form
     6129   do:
     6130   define variable v-rid-list as character no-undo .
     6131   define buffer buf_country for ub.country.
     6132   find first buf_country no-lock where
     6133            buf_country.alpha1 = (input frame d-gds-form  goods.alpha1) no-error.
     6134   if available buf_country then do:
