     7770        DISPLAY "" @ goods.artic with frame d-gds-form.
     7771       end.
     7772       else do:
     7773         DISPLAY ImpMes with frame d-gds-form.
     7774         assign
     7775         i-artic = ";;;"
     7776         i-find = no
     7777         .
     7778         _i-artic:
     7779         DO WHILE i-artic = ";;;" or i-find:
     7780           run next-good no-error.
     7781           if error-status:error then return.
     7782           i-find =  can-find (goods where
     7783                           goods.artic = i-artic AND
     7784                           goods.prod-type = input frame d-gds-form clients.obj-type AND
     7785                           goods.prod-code = input frame d-gds-form clients.obj-code no-lock).
     7786           if i-find then next _i-artic.
     7787         END.
     7788         if ArtDis then do:
     7789           message "Для импорта требуется, чтобы автоматичекий артикул был выключен.".
     7790           return.
     7791         end.
     7792         RUN next-good-display in this-procedure .
     7793       end.
     7794       if available ub.gds-grp then do:
     7795         grp-full = "".
     7796         RUN grplib-get-full-name in this-procedure (input gds-grp.node-code, output grp-full).
     7797         if length(grp-full) > 79
     7798           then
     7799         assign
     7800         grp-full = "..." + substr(grp-full, length(grp-full) - 79).
     7801         DISPLAY grp-full with frame d-gds-form.
     7802       end.
     7803       if NOT igoods and NOT available clients
     7804         then
     7805       FIND clients WHERE
     7806            clients.obj-type = 'орг':U and
     7807            clients.obj-code = v-host-code no-error.
     7808       if available clients
     7809         then
     7810       DISPLAY clients.obj-type clients.obj-code clients.obj-name with frame d-gds-form.
     7811         else
     7812       DISPLAY 'орг':U @ clients.obj-type with frame d-gds-form.
     7813       if available gds-prt
     7814         then
