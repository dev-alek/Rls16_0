     3349   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3350   define  temp-table temp-pers-proc no-undo
     3351   field proc-name as character
     3352   field vproc-handle as handle
     3353   field vparent-handle as handle
     3354   field user-name as character
     3355   field id as integer
     3356   field vpar as character
     3357   field rank-to-delete as integer
     3358   index pi is unique primary
     3359   proc-name
     3360   id
     3361   index puser
     3362   proc-name
     3363   user-name
     3364   index ppar
     3365   proc-name
     3366   vpar
     3367   index iparent
     3368   vparent-handle
     3369   proc-name
     3370   index iid
     3371   id
     3372   index ird
     3373   rank-to-delete
     3374   .
     3375   define variable v-per-proc-num as integer no-undo .
     3376   procedure perproc-create-proc :
     3377   define input  parameter p-parent-handle as handle no-undo .
     3378   define input  parameter p-proc-name as character no-undo .
     3379   define input  parameter p-proc-handle  as handle no-undo .
     3380   define input  parameter p-run        as logical no-undo .
     3381   define input  parameter p-parameter as character no-undo .
     3382   define input  parameter p-userid as character no-undo .
     3383   define input  parameter p-rank-to-delete as integer no-undo .
     3384   define output parameter p-id as integer   no-undo .
     3385   define variable ii as integer   no-undo .
     3386   define variable v-proc-handle as handle no-undo .
     3387   define buffer buf_temp-pers-proc for temp-pers-proc.
     3388   define buffer buf0_temp-pers-proc for temp-pers-proc.
     3389     do
     3390     on error undo, return error return-value
     3391     :
     3392       if v-per-proc-num > 200 then return error '>'.
     3393       find first buf0_temp-pers-proc no-lock where
     3394                 buf0_temp-pers-proc.proc-name = p-proc-name use-index pi    no-error.
     3395       if not available buf0_temp-pers-proc then do:
     3396         if p-run then do:
     3397           run value(p-proc-name) persistent SET v-proc-handle (input p-parameter) no-error.
     3398           if error-status :error then undo, return error return-value .
     3399         end.
     3400         else v-proc-handle = p-proc-handle.
     3401         find last buf0_temp-pers-proc no-lock use-index iid  no-error.
     3402         create buf_temp-pers-proc.
     3403         assign
     3404         buf_temp-pers-proc.proc-name = p-proc-name
     3405         buf_temp-pers-proc.id = (if not available buf0_temp-pers-proc
     3406                                   then  0
     3407                                   else buf0_temp-pers-proc.id + 1)
     3408         buf_temp-pers-proc.user-name = p-userid
     3409         buf_temp-pers-proc.vpar      = p-parameter
     3410         buf_temp-pers-proc.vparent-handle = p-parent-handle
     3411         buf_temp-pers-proc.vproc-handle = v-proc-handle
     3412         buf_temp-pers-proc.rank-to-delete = p-rank-to-delete
     3413         p-id = buf_temp-pers-proc.id
     3414         v-per-proc-num = v-per-proc-num + 1
     3415         .
     3416       end.
     3417       else p-id = buf0_temp-pers-proc.id.
     3418     end.
     3419   end procedure.
     3420   procedure perproc-delete-proc-user :
     3421   define input  parameter p-proc-name as character no-undo .
     3422   define input  parameter p-user-name as character no-undo .
     3423   define buffer buf_temp-pers-proc for temp-pers-proc.
     3424     do
     3425     on error undo, return error return-value
     3426     :
     3427        for each buf_temp-pers-proc where
     3428               buf_temp-pers-proc.proc-name = p-proc-name
     3429          AND  buf_temp-pers-proc.user-name = p-user-name:
     3430           APPLY "delete" to buf_temp-pers-proc.vproc-handle.
     3431           delete procedure buf_temp-pers-proc.vproc-handle.
     3432           delete buf_temp-pers-proc.
     3433           v-per-proc-num = v-per-proc-num - 1.
     3434        end.
     3435     end.
     3436   end procedure.
