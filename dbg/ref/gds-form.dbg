     5873                   , input recid(goods)
     5874                   , input ?
     5875                   , output rid-list).
     5876     apply "entry" to b-place in frame d-gds-form.
     5877   END.
     5878   ON choose OF b-prt IN FRAME d-gds-form
     5879   DO:
     5880   define variable ref-rec as recid no-undo .
     5881       if mode = 'ДОБАВЛЕНИЕ':U then
     5882           do:
     5883               run ref/gdsprts.w ( input parparentproc
     5884                                  ,input yes
     5885                                  ,output ref-rec).
     5886               if ref-rec = ? then
     5887                   do:
     5888                       apply "entry" to b-prt in frame d-gds-form.
     5889                       return no-apply.
     5890                   end.
     5891               FIND ub.gds-prt WHERE recid (ub.gds-prt) = ref-rec.
     5892               DISPLAY ub.gds-prt.node-name with frame d-gds-form.
     5893           end.
     5894       else do:
     5895         if available ub.goods
     5896         then do:
     5897           define variable v-sel-node-code as integer   no-undo .
     5898           run str/prt-ref.w
     5899             (input parparentproc
     5900             ,input  ub.goods.gds-code
     5901             ,input  'ПРОСМОТР':U
     5902             ,input  p-obj-type
     5903             ,input  p-obj-code
     5904             ,input  ""
     5905             ,input  ""
     5906             ,output v-sel-node-code
     5907             ) .
     5908         end.
     5909         apply "entry" to b-prt in frame d-gds-form.
     5910       end.
     5911   end.
     5912   ON CHOOSE OF b-recipe IN FRAME d-gds-form
     5913   DO:
     5914       FIND ub.units WHERE ub.units.unit-name = ub.goods.unit-base NO-LOCK .
     5915       if can-do( ub.units.type, 'сер':U ) then
     5916           message "Для серийного товара" skip
     5917                           "рецепт задать нельзя !" view-as alert-box INFORMATION .
     5918       else
     5919           do:
     5920               FIND ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK .
     5921               if can-do( '_Пустая шкала':U, ub.gds-prt.node-name )
     5922               then do:
     5923                   run ref/rcp-all.w (
     5924                         input parParentProc
     5925                       , input ( if mode = 'ИЗМЕНЕНИЕ':U then "b-add" else "nb-del,nb-chg" )
     5926                       , input ""
     5927                       , input recid(goods)
     5928                       , input p-obj-type
     5929                       , input p-obj-code
     5930                       , output ref-list
     5931                   ).
     5932               end.
     5933               else do:
     5934                   message
     5935                       "Рецепт можно определить"
     5936                       skip "только для товара БЕЗ ПРИЗНАКОВ."
     5937                   view-as alert-box information .
     5938               end.
     5939           end.
     5940   END.
     5941   ON choose OF b-rest IN FRAME d-gds-form
     5942   DO:
     5943     if mode = 'ПРОСМОТР':U
     5944     then do:
     5945       find ub.gds-prt no-lock
     5946         where ub.gds-prt.upper-code = ub.goods.prt-root
     5947         .
     5948       assign
     5949         gds-rec = recid( ub.goods )
     5950       .
     5951       run rep/gds-objs.w
     5952         (input parparentproc
     5953         ,input ub.goods.artic
     5954         ,input ub.goods.prod-type
     5955         ,input ub.goods.prod-code
     5956         ,input v-host-code
     5957         ,input -1
     5958         ).
     5959       apply "entry" to b-rest in frame d-gds-form.
     5960     end.
     5961     else do:
     5962       RUN check-update-attr IN THIS-PROCEDURE(yes) NO-ERROR.
     5963       IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     5964       if mode = 'ИЗМЕНЕНИЕ':U and not updated
     5965       then gds-rec = ?.
     5966       else if NOT f-name = "" then do:
     5967           message ("Импорт из файла " + f-name + " закончен" + chr(10) + "прочитано " + string(impc) +
     5968             ",  сохранено " + string(impc-saved) ) view-as alert-box
     5969             INFORMATION.
     5970             display
     5971             "" @ goods.artic
     5972             with frame d-gds-form.
     5973             DISABLE
     5974             b-card
     5975             with frame d-gds-form.
     5976       end.
     5977       run perproc-delete-from-parent( this-procedure , "").
     5978       v-next-prev = ?.
     5979       apply "go" to frame d-gds-form.
     5980     end.
     5981   end.
     5982   ON choose OF b-sert IN FRAME d-gds-form
     5983   DO:
     5984     run proc-b-sert no-error.
     5985     if error-status:error then return no-apply.
     5986   end.
     5987   ON return OF goods.gds-name IN FRAME d-gds-form
     5988   DO:
     5989       if input frame d-gds-form goods.gds-name = "" then
     5990           do:
     5991               message "Название не может быть пустым !".
     5992               apply "entry" to goods.gds-name in frame d-gds-form.
     5993               return no-apply.
     5994           end.
     5995       if input frame d-gds-form goods.unit-base = "" then
     5996           apply "entry" to goods.unit-base in frame d-gds-form.
     5997       else
     5998           if mode = 'ДОБАВЛЕНИЕ':U then
     5999               apply "entry" to b-arch in frame d-gds-form.
     6000           else
     6001               apply "entry" to b-exit in frame d-gds-form.
     6002       return no-apply.
     6003   end.
     6004   ON LEAVE OF goods.gds-name IN FRAME d-gds-form
     6005   DO:
     6006       run copy-name-to-lbl.
     6007   END.
     6008   ON CHOOSE OF b-copy-name-to-lbl IN FRAME d-gds-form
     6009   DO:
     6010       run copy-name-to-lbl.
     6011   END.
     6012   ON VALUE-CHANGED OF NegRest IN FRAME d-gds-form
     6013   do:
     6014       assign NegRest .
     6015   end.
     6016   ON leave OF ub.clients.obj-code IN FRAME d-gds-form
     6017   do:
     6018       FIND ub.clients WHERE ub.clients.obj-type = input frame d-gds-form ub.clients.obj-type
     6019                                   and ub.clients.obj-code = input frame d-gds-form ub.clients.obj-code
     6020                                   no-lock no-error.
     6021       if available ub.clients then
     6022           DISPLAY ub.clients.obj-name with frame d-gds-form.
     6023       HIDE Infmes in frame d-gds-form.
     6024   end.
     6025   ON return OF ub.clients.obj-code IN FRAME d-gds-form
     6026   do:
     6027     define variable ref-rec as recid no-undo .
     6028     FIND ub.clients WHERE ub.clients.obj-type = input frame d-gds-form ub.clients.obj-type
     6029                                 and ub.clients.obj-code = input frame d-gds-form ub.clients.obj-code
     6030                                 no-lock no-error.
     6031     if available ub.clients then
     6032         do:
     6033             DISPLAY ub.clients.obj-name with frame d-gds-form.
     6034             apply "entry" to ub.goods.gds-name in frame d-gds-form.
     6035             return no-apply.
     6036         end.
     6037     else  do:
     6038       run ref/cli-all.w ( input parParentProc
     6039                          ,input "b-add,b-sel"
     6040                          ,input ?
     6041                          ,input ?
     6042                          ,input ?
     6043                          ,input ?
     6044                          ,input ?
     6045                          ,input ?
     6046                          ,output ref-list) .
     6047       if ref-list = "" then do:
     6048         apply "entry" to ub.clients.obj-code in frame d-gds-form.
     6049         return no-apply.
     6050       end.
     6051       ref-rec = integer (ref-list).
     6052       FIND ub.clients WHERE recid (ub.clients) = ref-rec NO-LOCK .
     6053       DISPLAY ub.clients.obj-type ub.clients.obj-code ub.clients.obj-name with frame d-gds-form.
     6054       apply "entry" to ub.goods.gds-name in frame d-gds-form.
     6055       return no-apply.
     6056     end.
     6057   end.
     6058   ON LEAVE OF clients.obj-type IN FRAME d-gds-form
     6059   DO:
     6060       HIDE Infmes in frame d-gds-form.
     6061   END.
     6062   ON choose OF r-base IN FRAME d-gds-form
     6063   do:
     6064   define variable ref-rec as recid no-undo .
     6065       run ref/units.w ( input parparentproc
     6066                  , input yes
     6067                  , output ref-rec ).
     6068       if ref-rec = ? then do:
     6069               apply "entry" to r-base in frame d-gds-form.
     6070               return no-apply.
     6071        end.
     6072       FIND ub.units WHERE recid (ub.units) = ref-rec NO-LOCK.
     6073       DISPLAY ub.units.unit-name @ goods.unit-base with frame d-gds-form.
     6074       if avail ub.gds-grp then do:
     6075         run ref/dtaxgdss.p (
     6076                       input no
     6077                      ,input ub.goods.unit-base:screen-value
     6078                      ,input  ub.gds-grp.node-code
     6079                      ,input ?
     6080                      ,input ?
     6081                      ,input v-host-code
     6082                      ,input p-obj-type
     6083                      ,input p-obj-code
     6084                       ) no-error.
     6085         if error-status:error then return no-apply.
     6086       end.
     6087       run enable-max-min(goods.unit-base:screen-value) no-error.
     6088       if error-status:error then return no-apply.
     6089       OPEN QUERY br-tt-tax for each tt-tax NO-LOCK.
     6090       if input frame d-gds-form goods.unit-cli =
     6091               input frame d-gds-form goods.unit-base then
     6092           do:
     6093               DISPLAY 1 @ goods.cli-base-rate with frame d-gds-form.
     6094               DISABLE goods.cli-base-rate with frame d-gds-form.
     6095           end.
     6096       else
     6097           ENABLE goods.cli-base-rate with frame d-gds-form.
     6098       apply "entry" to goods.unit-cli in frame d-gds-form.
     6099   end.
     6100   ON LEAVE OF goods.alpha1 IN FRAME d-gds-form
     6101   OR ENTER OF goods.alpha1 IN FRAME d-gds-form
     6102   DO:
     6103     if not can-FIND( ub.country where ub.country.alpha1 = input frame d-gds-form ub.goods.alpha1 )
     6104     and (ub.goods.alpha1:modified = yes or f-name = '':U)  then
     6105     frame-value = "XX".
     6106     FIND FIRST ub.COUNTRY WHERE ub.COUNTRY.alpha1 = frame-value No-LOCK No-ERROR.
     6107     COUNTRY_name = if avail ub.country then ub.country.short-name else "".
     6108     DISPLAY country_name with FRAME d-gds-form.
     6109   END.
     6110   ON return OF ub.goods.alpha1 IN FRAME d-gds-form
     6111   do:
     6112   define variable rid-list as character no-undo .
     6113     if not can-FIND( ub.country where
     6114                               ub.country.alpha1 = input frame d-gds-form goods.alpha1 ) then  do:
     6115               run ref/countris.w ( input parparentproc
     6116                                   ,input "b-sel"
     6117                                   ,input-output rid-list ).
     6118               if rid-list = '' then
