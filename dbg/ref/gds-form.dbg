     8809                           , input-output temp-goods.nationality
     8810                           , input-output temp-goods.normal-wastage
     8811                           , input-output temp-goods.normal-waste
     8812                           , input-output temp-goods.cond-keep-code
     8813                           , input-output temp-goods.proof
     8814               , INPUT-OUTPUT temp-goods.alc-prod
     8815               , INPUT-OUTPUT temp-goods.alc-mark
     8816                           , INPUT-OUTPUT temp-goods.alc-choose-prod
     8817                           ) .
     8818           run get-fields in this-procedure .
     8819         end.
     8820       END.
     8821       WHEN "foto":U then do:
     8822         if mode = 'ДОБАВЛЕНИЕ':U then do:
     8823           BELL.
     8824           loc-DOPINF-option = "".
     8825           return error.
     8826         end.
     8827         run ref/gds-ph.p
     8828           (input parparentproc
     8829           ,buffer goods
     8830           ,input mode
     8831           ).
