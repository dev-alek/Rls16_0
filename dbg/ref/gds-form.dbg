     5523     do:
     5524       message "Введите объем штуки в карточке товара" VIEW-AS ALERT-BOX .
     5525       RETURN NO-APPLY.
     5526     end.
     5527     run clntattr-value in this-procedure ( input clients.obj-type
     5528                                          , input clients.obj-code
     5529                                          , input 'cli-alc-producer':U
     5530                                          , output v-cli-alc-producer
     5531                                          , output v-attr-type
     5532                                          ) .
