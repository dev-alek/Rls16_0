     6258   ON CHOOSE OF b-tax IN FRAME d-gds-form
     6259   DO:
     6260    run proc-b-tax no-error.
     6261    if error-status:error then return no-apply.
     6262   END.
     6263   ON ROW-ENTRY OF BR-tt-tax IN FRAME d-gds-form
     6264   DO:
     6265     if mode = 'ИЗМЕНЕНИЕ':U then do :
     6266   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6267   do:
     6268     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6269       (input  v-cntxt-db-num
     6270       ,input  v-cntxt-userid
     6271       ,input  0
     6272       ,input  'actn_reference_upd-gds-tax':U
     6273       ,input  'global':U
     6274       ,input  0
     6275       ,input  '':U
     6276       ,input  0
     6277       ,input  0
     6278       ,input  goods.grp-code
     6279       ,input  0
     6280       ,input  true
     6281       ,output g#log
     6282       )  .
     6283   end.
     6284       if not g#log then do:
     6285         APPLY "ENTRY" TO goods.PS in frame d-gds-form.
     6286         return no-apply.
     6287       end.
     6288     end.
     6289   END.
     6290   ON ROW-LEAVE OF BR-tt-tax IN FRAME d-gds-form
     6291   DO:
     6292       if
     6293       NOT integer(tt-tax.rate-code:screen-value in browse br-tt-tax) = tt-tax.rate-code OR
     6294       NOT decimal(tt-tax.rate-value:screen-value in browse br-tt-tax) = tt-tax.rate-value OR
     6295       NOT date(tt-tax.fact-date:screen-value in browse br-tt-tax) = tt-tax.fact-date
     6296       then do:
     6297           run row-leave-br-tt-tax(integer(tt-tax.rate-code:screen-value in browse br-tt-tax)) no-error.
     6298           if error-status:error then return no-apply.
     6299       end.
     6300   END.
     6301   ON RETURN OF tt-tax.rate-code IN BROWSE BR-tt-tax DO:
     6302       define variable rt as recid NO-UNDO.
     6303       define variable tax-rate-rid as char no-undo init "".
     6304       define variable taxvalue like ub.tax-rate-value.rate-value no-undo.
     6305       DEFINE VARIABLE v-today as date no-undo .
     6306       DEFINE VARIABLE v-time as integer no-undo .
     6307       IF AVAIL tt-tax then do:
     6308           if tt-tax.individual then do:
     6309               if tt-tax.rate-code = ? then do:
     6310                   message "Ставка налога индивидуальна для каждого товара" skip
     6311                                   "и создается автоматически при создании товара!" view-as alert-box
     6312                                   WARNING.
     6313                   return no-apply.
     6314               end.
     6315               else do:
     6316                   message "Нельзя изменять ставку индивидуального налога!" view-as alert-box
     6317                                   ERROR.
     6318                   return no-apply.
     6319               end.
     6320           end.
     6321           FIND FIRST ub.tax NO-LOCK WHERE ub.tax.tax-code = tt-tax.tax-code NO-ERROR.
     6322           if not avail ub.tax then return no-apply.
     6323           FIND FIRST ub.tax-rate NO-LOCK WHERE ub.tax-rate.tax-code = tt-tax.tax-code AND
     6324                                                                          ub.tax-rate.rate-code = tt-tax.rate-code NO-ERROR.
     6325           if not avail ub.tax-rate then return no-apply.
     6326           assign
     6327           rt = recid(ub.tax)
     6328           tax-rate-rid = string(recid(ub.tax-rate))
     6329           .
     6330           run ref/tax-tree.w (
     6331                           input parparentproc
     6332                          ,input "b-seltax-rate":U
     6333                          ,input "ALL-TAX-RATES":U
     6334                          ,input v-host-code
     6335                          ,input p-obj-type
     6336                          ,input p-obj-code
     6337                          ,input rt
     6338                          ,input-output tax-rate-rid) no-error .
     6339           if NOT tax-rate-rid = "" then do:
     6340               FIND FIRST tax-rate NO-LOCK WHERE
     6341                          recid(tax-rate) = integer(tax-rate-rid) NO-ERROR.
     6342               if not avail tax-rate then return no-apply.
     6343   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6344   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     6345     (input  integer(tax-rate-rid)
     6346     ,input  tax-rate.tax-code
     6347     ,input  tax-rate.rate-code
     6348     ,input  ?
     6349     ,input  v-host-code
     6350     ,input  p-obj-type
     6351     ,input  p-obj-code
     6352     ,output taxvalue
     6353     ) no-error .
     6354               if error-status:error or taxvalue = ? then return no-apply.
     6355               if mode = 'ДОБАВЛЕНИЕ':U and not copymode then v-today = 01/01/1990.
     6356               else do:
     6357                 run cur-time in this-procedure(output v-today, output v-time).
     6358               end.
     6359               assign
     6360               tt-tax.rate-code:screen-value in browse br-tt-tax = string(tax-rate.rate-code)
     6361               tt-tax.rate-value:screen-value in browse br-tt-tax = string(taxvalue)
     6362               tt-tax.fact-date:screen-value in browse br-tt-tax = string(v-today, "99/99/9999")
     6363               .
     6364            end.
     6365        end.
     6366   END.
     6367   ON return OF goods.unit-cli IN FRAME d-gds-form
     6368   do:
     6369   define variable ref-rec as recid no-undo .
     6370       if not can-find( ub.units where
     6371                        ub.units.unit-name = input frame d-gds-form ub.goods.unit-cli ) then do:
     6372           run ref/units.w (
     6373                        input parparentproc
     6374                       ,input yes
     6375                       ,output ref-rec ).
     6376           if ref-rec = ? then do:
     6377             apply "entry" to ub.goods.unit-cli in frame d-gds-form.
     6378             return no-apply.
     6379           end.
     6380           FIND ub.units WHERE recid (ub.units) = ref-rec NO-LOCK.
     6381           DISPLAY ub.units.unit-name @ goods.unit-cli with frame d-gds-form.
     6382       end.
     6383       if input frame d-gds-form ub.goods.unit-cli =
     6384              input frame d-gds-form ub.goods.unit-base then
     6385           do:
     6386               DISPLAY 1 @ goods.cli-base-rate with frame d-gds-form.
     6387               DISABLE goods.cli-base-rate with frame d-gds-form.
     6388               apply "entry" to goods.calc-method in frame d-gds-form.
     6389           end.
     6390       else
     6391           do:
     6392               ENABLE goods.cli-base-rate with frame d-gds-form.
     6393               apply "entry" to goods.cli-base-rate in frame d-gds-form.
     6394           end.
     6395       return no-apply.
     6396   end.
     6397   on leave of goods.qnty-cart in frame d-gds-form
     6398   do:
     6399     define variable varlog as logical initial no no-undo.
     6400     if (input frame d-gds-form goods.ms-base <> 0 and input frame d-gds-form goods.ms-base <> ? or
     6401         input frame d-gds-form goods.wt-base <> 0 and input frame d-gds-form goods.wt-base <> ?   ) and
     6402        (input frame d-gds-form goods.ms-base * input frame d-gds-form goods.qnty-cart <> input frame d-gds-form goods.ms-cart or
     6403         input frame d-gds-form goods.wt-base * input frame d-gds-form goods.qnty-cart <> input frame d-gds-form goods.wt-cart   )
     6404         then do:
     6405       message "Вы хотите пересчитать вес и объем упаковки, исходя из количества в упаковке и веса и объема штуки?"
     6406       view-as alert-box question button yes-no update varlog.
     6407       if varlog = yes then do:
     6408         display input frame d-gds-form goods.ms-base * input frame d-gds-form goods.qnty-cart @ goods.ms-cart
     6409                 input frame d-gds-form goods.wt-base * input frame d-gds-form goods.qnty-cart @ goods.wt-cart
     6410         with frame d-gds-form.
     6411       end.
     6412     end.
     6413   end.
     6414   on leave of goods.ms-base in frame d-gds-form
     6415   do:
     6416     define variable varlog as logical initial no no-undo.
     6417     if input frame d-gds-form goods.qnty-cart <> 0 and
     6418        input frame d-gds-form goods.qnty-cart <> ? and
     6419        input frame d-gds-form goods.ms-base * input frame d-gds-form goods.qnty-cart <> input frame d-gds-form goods.ms-cart
     6420         then do:
     6421       message "Вы хотите пересчитать объем упаковки, исходя из количества в упаковке и объема штуки?"
     6422       view-as alert-box question button yes-no update varlog.
     6423       if varlog = yes then do:
     6424         display input frame d-gds-form goods.ms-base * input frame d-gds-form goods.qnty-cart @ goods.ms-cart
     6425         with frame d-gds-form.
     6426       end.
     6427     end.
     6428   end.
     6429   on leave of goods.wt-base in frame d-gds-form
     6430   do:
     6431     define variable varlog as logical initial no no-undo.
     6432     if input frame d-gds-form goods.qnty-cart <> 0 and
     6433        input frame d-gds-form goods.qnty-cart <> ? and
     6434        input frame d-gds-form goods.wt-base * input frame d-gds-form goods.qnty-cart <> input frame d-gds-form goods.wt-cart
     6435         then do:
     6436       message "Вы хотите пересчитать вес упаковки, исходя из количества в упаковке и веса штуки?"
     6437       view-as alert-box question button yes-no update varlog.
     6438       if varlog = yes then do:
     6439         display input frame d-gds-form goods.wt-base * input frame d-gds-form goods.qnty-cart @ goods.wt-cart
     6440         with frame d-gds-form.
     6441       end.
     6442     end.
     6443   end.
     6444   on leave of goods.ms-cart in frame d-gds-form
     6445   do:
     6446     define variable varlog as logical initial no no-undo.
     6447     if input frame d-gds-form goods.qnty-cart <> 0 and
     6448        input frame d-gds-form goods.qnty-cart <> ? and
     6449        input frame d-gds-form goods.ms-base * input frame d-gds-form goods.qnty-cart <> input frame d-gds-form goods.ms-cart
     6450         then do:
     6451       message "Вы хотите пересчитать объем штуки, исходя из количества в упаковке и объема упаковки?"
     6452       view-as alert-box question button yes-no update varlog.
     6453       if varlog = yes then do:
     6454         display input frame d-gds-form goods.ms-cart / input frame d-gds-form goods.qnty-cart @ goods.ms-base
     6455         with frame d-gds-form.
     6456       end.
     6457     end.
     6458   end.
     6459   on leave of goods.wt-cart in frame d-gds-form
     6460   do:
     6461     define variable varlog as logical initial no no-undo.
     6462     if input frame d-gds-form goods.qnty-cart <> 0 and
     6463        input frame d-gds-form goods.qnty-cart <> ? and
     6464        input frame d-gds-form goods.wt-base * input frame d-gds-form goods.qnty-cart <> input frame d-gds-form goods.wt-cart
     6465         then do:
     6466       message "Вы хотите пересчитать вес штуки, исходя из количества в упаковке и веса упаковки?"
     6467       view-as alert-box question button yes-no update varlog.
     6468       if varlog = yes then do:
     6469         display input frame d-gds-form goods.wt-cart / input frame d-gds-form goods.qnty-cart @ goods.wt-base
     6470         with frame d-gds-form.
     6471       end.
     6472     end.
     6473   end.
     6474   on choose of b-gdsfrmfi in frame d-gds-form do:
     6475     if mode <> 'ПРОСМОТР':U then return no-apply.
     6476     run gdsfrmfi-description in this-procedure .
     6477   end.
     6478   ON WINDOW-CLOSE OF FRAME d-gds-form
     6479   DO:
     6480     APPLY "END-ERROR":U TO SELF.
     6481   END.
     6482   ON END-ERROR OF FRAME d-gds-form
     6483   DO:
     6484     RUN check-update-attr IN THIS-PROCEDURE (yes) NO-ERROR.
     6485     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     6486     run perproc-delete-from-parent( this-procedure , "").
     6487     v-next-prev = ?.
     6488   END.
     6489   ON CHOOSE OF b-next IN FRAME d-gds-form
     6490   DO:
     6491   run reposition-goods in this-procedure
     6492     (input 'next':U
     6493     ).
     6494   END.
     6495   ON CHOOSE OF b-prev IN FRAME d-gds-form
     6496   DO:
     6497   run reposition-goods in this-procedure
     6498     (input 'prev':U
     6499     ).
     6500   END.
     6501   on choose of b-extart in frame d-gds-form do:
     6502     run proc-b-extart in this-procedure ( input goods.gds-code ) no-error .
     6503     if error-status :error then do :
     6504       return no-apply.
     6505     end.
     6506   end.
     6507   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-gds-form:PARENT eq ?
     6508   THEN FRAME d-gds-form:PARENT = ACTIVE-WINDOW.
     6509   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6510   on help of frame d-gds-form
     6511   do:
     6512     run gbl/app_help.p
     6513       (input this-procedure :file-name
     6514       ,input ''
     6515       ,input ?
     6516       ) no-error.
     6517     if error-status :error then do:
     6518       message
     6519         "Ошибка при вызове помощи"
     6520         error-status :get-message(1)
     6521         view-as alert-box .
     6522     end.
     6523   end.
     6524   run minbtn-set in this-procedure .
     6525   on choose of b-help in frame d-gds-form
     6526   do:
     6527     apply "help":u to frame d-gds-form .
     6528   end.
     6529   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6530   procedure minbtn-set :
     6531       do
     6532           on error undo, return error return-value
     6533           :
     6534           define variable ii              as integer       no-undo .
     6535           define variable fh              as widget-handle no-undo .
     6536           define variable hh              as widget-handle no-undo .
     6537           define variable v-h             as handle        extent 4 no-undo .
     6538           define variable v-name-button   as character     no-undo .
     6539           define variable v-help-old-x    as decimal       no-undo .
     6540           define variable v-help-old-y    as decimal       no-undo .
     6541           define variable v-help-old-size as decimal       no-undo .
     6542           define variable v-frame-width   as decimal       no-undo .
     6543           define variable jj              as integer       no-undo .
     6544           do
     6545               on error undo, return error
     6546               :
     6547               assign
     6548                   v-frame-width = frame d-gds-form:width - 0.3
     6549                   fh            = frame d-gds-form:first-child
     6550                   hh            = fh:first-child
     6551                   ii            = 1
     6552                   .
     6553               do while valid-handle(hh):
     6554                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     6555                   do:
     6556                       case lc(hh:name) :
     6557                           when "b-help" then
     6558                               do:
     6559                                   hh:load-image-up("cmp/b-help.bmp":u) .
     6560                                   hh:load-image-down("cmp/b-help.bmp":u) .
     6561                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     6562                                   hh:TOOLTIP = "Помощь" .
     6563                                   v-help-old-x = hh:column .
     6564                                   v-help-old-y = hh:row    .
     6565                                   v-help-old-size = hh:width .
     6566                                   hh:width-chars = 2.5 .
     6567                               end.
     6568                           when "b-print" then
     6569                               do:
     6570                                   hh:load-image("cmp/b-print.bmp":u) .
     6571                                   hh:TOOLTIP = "Печать" .
     6572                                   v-h[ii] = hh:handle .
     6573                                   ii = ii + 1 .
     6574                                   hh:width-chars = 3 .
     6575                               end.
     6576                           when "b-history" or
     6577                           when "b-hist" then
     6578                               do:
     6579                                   hh:load-image("cmp/b-hist.bmp":u) .
     6580                                   hh:TOOLTIP = "История" .
     6581                                   v-h[ii] = hh:handle .
     6582                                   ii = ii + 1 .
     6583                                   hh:width-chars = 3 .
     6584                               end.
     6585                           when "b-sch" then
     6586                               do:
     6587                                   hh:load-image("cmp/b-sch.bmp":u) .
     6588                                   hh:TOOLTIP = "Установка Фильтра" .
     6589                                   v-h[ii] = hh:handle .
     6590                                   ii = ii + 1 .
     6591                                   hh:width-chars = 3 .
     6592                               end.
     6593                           when "b-hist-user" then
     6594                               do:
     6595                                   hh:load-image("cmp/b-hist.bmp":u) .
     6596                                   hh:TOOLTIP = "История пользователя" .
     6597                                   ii = ii + 1 .
     6598                               end.
     6599                       end case.
     6600                   end.
     6601                   hh = hh:next-sibling.
     6602               end.
     6603               b-help:column = v-frame-width - b-help:width-chars.
     6604               jj = 0.
     6605               repeat ii = 4 to 1 by -1 :
     6606                   if valid-handle (v-h[ii] ) then
     6607                   do:
     6608                       jj  = jj + 1 .
     6609                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     6610                       v-h[ii]:row    = v-help-old-y .
     6611                   end.
     6612               end.
     6613           end.
     6614       end.
     6615   end procedure.
     6616   ON WINDOW-CLOSE OF FRAME d-gds-form APPLY "END-ERROR":U TO SELF.
     6617   if LOOKUP('ДОБАВЛЕНИЕ':U, mode)  > 0 OR LOOKUP('КОПИРОВАНИЕ':U, mode) > 0 then do:
     6618     assign
     6619     igoods = if entry(2, mode) = 'т':U then yes else no
     6620     no-error.
     6621     if error-status:error then do:
     6622       message "Выберите, что добавлять товар или услугу"
     6623       view-as alert-box.
     6624       return.
     6625     end.
     6626     mode = entry(1, mode).
     6627   end.
     6628   on alt-shift-f6 anywhere do:
     6629     if available ub.goods
     6630     then do:
     6631       run gbl/d-infgds.p
     6632         (input ub.goods.gds-code
     6633         ,input p-obj-type
     6634         ,input p-obj-code
     6635         ) .
     6636     end.
     6637   end.
     6638   run proc-settings in this-procedure (
     6639   input-output var-artic-disable,
     6640   input-output var-negative-rest,
     6641   input-output unq-artc,
     6642   input-output dif-nam1,
     6643   input-output dif-nam2,
     6644   input-output dif-pdbc,
     6645   input-output tnvedimp,
     6646   input-output v-gds-copy,
     6647   input-output vattaxcd,
     6648   input-output slttaxcd,
     6649   input-output dfltggrp,
     6650   input-output gdsfrmfi
     6651   ) no-error .
     6652   if error-status:error then undo, return error.
     6653   for each temp-goods:
     6654     delete temp-goods.
     6655   end.
     6656   assign
     6657   ArtDis = var-artic-disable
     6658   ArtBAr:list-items = IF v-cntxt-db-num = 0
     6659   then (vArtBar-off + chr(44) + vArtBar-Auto + chr(44) + vArtBar-BarCode)
     6660   else (vArtBar-off + chr(44) + vArtBar-Auto)
     6661   ArtBar = if Artdis then vArtBar-Auto else vArtBar-off
     6662   f-name = ""
     6663   add-another = yes
     6664   .
     6665   if mode = 'КОПИРОВАНИЕ':U then do:
     6666     copymode = yes.
     6667     FIND FIRST for-goods where recid(for-goods) = gds-rec NO-LOCK NO-ERROR.
     6668     if not avail for-goods then return.
     6669     find first temp-goods no-error.
     6670     if not available temp-goods then do:
     6671       create temp-goods.
     6672     end.
     6673     buffer-copy for-goods to temp-goods.
     6674     FIND FIRST clients WHERE
     6675                 clients.obj-type = temp-goods.prod-type AND
     6676                 clients.obj-code = temp-goods.prod-code NO-LOCK NO-ERROR.
     6677     FIND FIRST gds-obj WHERE
     6678                 gds-obj.obj-type = p-obj-type
     6679            AND  gds-obj.obj-code = p-obj-code
     6680            AND  gds-obj.artic = for-goods.artic
     6681            AND  gds-obj.prod-type = for-goods.prod-type
     6682            AND  gds-obj.prod-code = for-goods.prod-code NO-ERROR .
     6683     FIND gds-prt WHERE gds-prt.upper-code = for-goods.prt-root NO-LOCK.
     6684     FIND FIRST ub.bar-code WHERE
     6685           ub.bar-code.gds-code  = for-goods.gds-code AND
     6686           ub.bar-code.node-code = gds-prt.node-code AND
     6687           ub.bar-code.in-code = "" AND
     6688           ub.bar-code.part-code = "" AND
     6689           ub.bar-code.unit-cli = for-goods.unit-base NO-LOCK NO-ERROR.
     6690     IF NOT AVAIL ub.bar-code then do:
     6691       message
     6692       vss-workfile vss-revision vss-description skip
     6693       "Не найден главный код для товара " ub.goods.artic ub.goods.prod-type string(goods.prod-code)
     6694       view-as alert-box ERROR.
     6695       return error.
     6696     end.
     6697     FIND ub.gds-grp WHERE ub.gds-grp.node-code = for-goods.grp-code NO-LOCK.
     6698     assign
     6699     igoods = IF for-goods.gds-type = 'т':U
     6700               THEN yes
     6701               else no
     6702     mode = 'ДОБАВЛЕНИЕ':U
     6703     saved-name = temp-goods.gds-name.
     6704     run fill-attr-tables in this-procedure ('gds-host-attr':U, mode) no-error.
     6705     run fill-attr-tables in this-procedure ('goods-attr':U, mode) no-error.
     6706     run fill-attr-tables in this-procedure ('fbr-gds-obj':U, mode) no-error .
     6707     run fill-attr-tables in this-procedure ('s-coeff':U, mode) no-error .
     6708     run fill-attr-tables in this-procedure ('gds-obj-attr':U, mode) no-error .
     6709     run fill-attr-tables in this-procedure ('gds-obj-prop':U, mode) no-error.
     6710     run fill-attr-tables in this-procedure ('gds-obj-prop':U + 'obj', mode) no-error.
     6711     run fill-attr-tables in this-procedure ('gds-obj-prop':U + 'firm', mode) no-error.
     6712     run fill-attr-tables in this-procedure ('gds-add-charges':U, mode) no-error.
     6713     run fill-attr-tables in this-procedure ('dis-gds-rule':U, mode) no-error .
     6714   end.
     6715   if igoods = ? then return.
     6716   HIDE Infmes ImpMes in frame d-gds-form.
     6717   add-cycle:
     6718   do while
     6719   add-another
     6720   or v-next-prev = '':U
     6721   :
     6722     add-another = no.
     6723     MAIN-BLOCK:
     6724     DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     6725       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     6726         if mode = 'ИЗМЕНЕНИЕ':U then do:
     6727           do TRANSACTION
     6728           on error undo MAIN-BLOCK, return error
     6729           on stop undo MAIN-BLOCK, return error:
     6730           FIND first locked_goods Exclusive-lock WHERE recid (locked_goods) = gds-rec.
     6731           find first goods where recid(goods) = recid(locked_goods).
     6732           end.
     6733         end.
     6734         RUN enable-UI in this-procedure no-error.
     6735         if error-status:error then do:
     6736           v-next-prev = ?.
     6737           undo main-block, return error .
     6738         end.
     6739         if wph = no then
     6740         run gdsfrmfi-to  in this-procedure ( input gdsfrmfi
     6741                                             ,input (if mode = 'ПРОСМОТР':U then no else yes)
     6742                                             ,OUTPUT v-dop-inf
     6743                                           )  .
     6744         run get-fields in this-procedure .
     6745         if (mode = 'ДОБАВЛЕНИЕ':U)  then do:
     6746             if ArtDis then do:
     6747             end.
     6748             if index(InfMes, "НЕ СОХРАНЕН") > 0 then
     6749             display prev-artic @ goods.artic with frame d-gds-form.
     6750             else if ArtDIs then
     6751             display  "" @ goods.artic with frame d-gds-form.
     6752             else if f-name = "" then
     6753             display "" @ goods.artic with frame d-gds-form.
     6754         end.
     6755         if available goods then do:
     6756             if mode = 'ПРОСМОТР':U and  (goods.gds-type <> 'т':U) then  apply "choose" to b-inf in frame d-gds-form.
     6757             if addch-value = 'yes' and (goods.gds-type <> 'т':U)
     6758                         then MENU-ITEM m-dopinf-AC:SENSITIVE IN MENU m-dopinf = true  .
     6759                         else MENU-ITEM m-dopinf-AC:SENSITIVE IN MENU m-dopinf = false .
     6760         end.
     6761         else do:
     6762             if mode = 'ДОБАВЛЕНИЕ':U and igoods = false then  apply "choose" to b-inf in frame d-gds-form.
     6763             if addch-value = 'yes' and igoods = false
     6764                         then MENU-ITEM m-dopinf-AC:SENSITIVE IN MENU m-dopinf = true  .
     6765                         else MENU-ITEM m-dopinf-AC:SENSITIVE IN MENU m-dopinf = false .
     6766         end.
     6767         IF mImagePh THEN MENU-ITEM m-dopinf-2:sensitive in MENU m-dopinf = true .
     6768         ELSE MENU-ITEM m-dopinf-2:sensitive in MENU m-dopinf = false .
     6769         case mode :
     6770             when 'ДОБАВЛЕНИЕ':U then
     6771                 if f-name = "" then
     6772                     do:
     6773                         if ArtDis then
     6774                             WAIT-FOR GO OF FRAME d-gds-form focus clients.obj-code.
     6775                         else
     6776                             WAIT-FOR GO OF FRAME d-gds-form focus goods.artic.
     6777                     end.
     6778                 else
     6779                     WAIT-FOR GO OF FRAME d-gds-form focus b-arch.
     6780             when 'ИЗМЕНЕНИЕ':U then
     6781                 WAIT-FOR GO OF FRAME d-gds-form focus goods.gds-name.
     6782             when 'ПРОСМОТР':U then
     6783                 if gds-prt.node-name = '_Пустая шкала':U then
     6784                     WAIT-FOR GO OF FRAME d-gds-form focus b-exit.
     6785                 else
     6786                     WAIT-FOR GO OF FRAME d-gds-form focus b-prt.
     6787         end case.
     6788     END.
     6789     release goods.
     6790   end.
     6791   delete widget-pool "gdsfrmfi" no-error.
     6792   RUN disable_UI.
     6793   input stream gds-file close.
     6794   PROCEDURE check-add :
     6795   define input parameter pmode as integer no-undo.
     6796   DEFINE VARIABLE v-prev-rec as recid no-undo .
     6797   define variable choice-str as character no-undo .
     6798   define variable v-loc-update-dgr as logical no-undo .
     6799   define variable v-loc-update-attr-obj as logical no-undo .
     6800   define variable v-loc-update-attr-host as logical no-undo .
     6801   define variable v-loc-update-attr-gbl as logical no-undo .
     6802   define variable v-loc-update-fbr-gds as logical no-undo .
     6803   define variable v-loc-update-s-coeff as logical no-undo .
     6804   define variable v-loc-update-gds-prop as logical no-undo .
     6805   define variable v-loc-update-add-prop as logical no-undo .
     6806   define variable v-mess as character no-undo .
     6807   define buffer buf_bar-code for ub.bar-code .
     6808   run set-fields.
     6809   assign
     6810   prev-artic = input frame d-gds-form goods.artic
     6811   NegRest
     6812   .
     6813   if NOT available ub.gds-prt then do:
     6814     FIND first ub.gds-prt WHERE
     6815               ub.gds-prt.node-name = '_Пустая шкала':U NO-LOCK.
     6816   end.
     6817   if NOT ub.gds-prt.root then do:
     6818     message
     6819     "Шкала выбрана неправильно !"
     6820     view-as alert-box error .
     6821     return error.
     6822   end.
     6823   if input frame d-gds-form ub.goods.unit-base = input frame d-gds-form ub.goods.unit-cli then do:
     6824     DISPLAY 1 @ ub.goods.cli-base-rate with frame d-gds-form.
     6825     DISABLE ub.goods.cli-base-rate with frame d-gds-form.
     6826   end.
     6827   else do:
     6828     ENABLE goods.cli-base-rate with frame d-gds-form.
     6829   end.
     6830   assign
     6831   v-prev-rec = gds-rec
     6832   gds-rec = if mode = 'ИЗМЕНЕНИЕ':U
     6833             then recid(goods)
     6834             else ?
     6835   .
     6836   choice-str = "yes".
     6837   if copymode and v-found-copy-atr-obj then v-update-attr-obj = yes.
     6838   if copymode and v-found-copy-atr-host then v-update-attr-host = yes.
     6839   if copymode and v-found-copy-atr-gbl then v-update-attr-gbl = yes.
     6840   if copymode and v-found-copy-fbr-gds then v-update-fbr-gds = yes.
     6841   if copymode and v-found-copy-s-coeff then v-update-s-coeff = yes.
     6842   if copymode and v-found-copy-gds-prop then v-update-gds-prop = yes.
     6843   if copymode and v-found-copy-add-prop then v-update-add-prop = yes.
     6844   if mode <> 'ДОБАВЛЕНИЕ':U then do:
     6845     RUN check-update-attr IN THIS-PROCEDURE(no) NO-ERROR.
     6846   end.
     6847   assign
     6848   v-loc-update-attr-obj = v-update-attr-obj
     6849   v-loc-update-attr-host = v-update-attr-host
     6850   v-loc-update-attr-gbl = v-update-attr-gbl
     6851   v-loc-update-fbr-gds = v-update-fbr-gds
     6852   v-loc-update-s-coeff = v-update-s-coeff
     6853   v-loc-update-gds-prop = v-update-gds-prop
     6854   v-loc-update-add-prop = v-update-add-prop
     6855   v-loc-update-dgr = v-update-dgr
     6856   .
     6857   if v-update-attr-obj
     6858   or v-update-attr-host
     6859   or v-update-attr-gbl
     6860   or v-update-fbr-gds
     6861   or v-update-s-coeff
     6862   or v-update-gds-prop
     6863   or v-update-add-prop
     6864   or v-update-dgr
     6865   then do:
     6866     v-mess =    (
     6867                          (if v-update-attr-gbl
     6868                          then "Были изменены глобальные атрибуты товара"
     6869                          else "":U) + chr(10) +
     6870                         (if v-found-copy-atr-host then " или наследуются глобальыне атрибуты товара" else "":U) + chr(10) +
     6871                          (if v-update-attr-host
     6872                          then "Были изменены атрибуты товара на фирме"
     6873                          else "":U) + chr(10) +
     6874                         (if v-found-copy-atr-host then " или наследуются атрибуты товара на фирме" else "":U) + chr(10) +
     6875                          (if v-update-attr-obj
     6876                          then "Были изменены атрибуты товара на объекте"
     6877                          else "":U) + chr(10) +
     6878                          (if v-found-copy-atr-obj then " или наследуются атрибуты товара на объекте" else "":U) + chr(10) +
     6879                          (if v-update-fbr-gds
     6880                          then "Были изменены атрибуты РЕСТОРАН товара на объекте"
     6881                          else "":U) + chr(10) +
     6882                          (if v-found-copy-fbr-gds then " или наследуются атрибуты РЕСТОРАН товара на объекте" else "":U) + chr(10) +
     6883                          (if v-update-s-coeff
     6884                          then "Были изменены сезонные коэффициенты товара"
     6885                          else "":U) + chr(10) +
     6886                          (if v-found-copy-s-coeff then " или наследуются сезонные коэффициенты товара" else "":U) + chr(10) +
     6887                          (if v-update-gds-prop
     6888                          then "Были изменены индикаторы/атрибуты для заказа товара"
     6889                          else "":U) + chr(10) +
     6890                          (if v-found-copy-gds-prop then " или наследуются индикаторы/атрибуты для заказа товара" else "":U) + chr(10) +
     6891                          (if v-update-add-prop
     6892                          then "Были изменены Дополнительные расходы"
     6893                          else "":U) + chr(10) +
     6894                          (if v-found-copy-add-prop then " или наследуются Дополнительные расходы" else "":U) + chr(10)
     6895                        ).
     6896     v-mess = left-trim(v-mess, chr(10)).
     6897     run gbl/d-toggle.w (
     6898                          input "Сохранение изменений"
     6899                         ,input v-mess
     6900                         ,input "|"
     6901                         ,input substitute("Товар^disable|" +
     6902                                         "Глобальные атрибуты&1|" +
     6903                                         "Атрибуты на фирме&2|" +
     6904                                         "Атрибуты на объекте&3|" +
     6905                                         "Атрибуты РЕСТОРАН&4|" +
     6906                                         "Сезонные коэффициенты&5|" +
     6907                                         "Скидки товара на объекте&6|" +
     6908                                         "Индикаторы товара&7|" +
     6909                                         "Дополнительные расходы&8"
     6910                                         , (if v-update-attr-gbl then "":U else "^disable":U)
     6911                                         , (if v-update-attr-host then "":U else "^disable":U)
     6912                                         , (if v-update-attr-obj then "":U else "^disable":U)
     6913                                         , (if v-update-fbr-gds then "":U else "^disable":U)
     6914                                         , (if v-update-s-coeff then "":U else "^disable":U)
     6915                                         , (if v-update-dgr then "":U else "^disable":U)
     6916                                         , (if v-update-gds-prop then "":U else "^disable":U)
     6917                                         , (if v-update-add-prop then "":U else "^disable":U)
     6918                                 )
     6919                         ,input ("Сохранить изменения собственно товара|" +
     6920                                 "Сохранить изменения глобальных атрибутов товара|" +
     6921                                 "Сохранить изменения атрибутов товара на фирме|" +
     6922                                 "Сохранить изменения атрибутов товара на объекте|" +
     6923                                 "Сохранить изменения атрибутов РЕСТОРАН товара на объекте|" +
     6924                                 "Сохранить изменения сезонных коэффициентов|" +
     6925                                 "Сохранить изменения скидок на товар на объекте|" +
     6926                                 "Сохранить изменения индикаторов/атрибутов для заказа товара|" +
     6927                                 "Сохранить изменения дополнительных расходов"
     6928                                 )
     6929                         ,input substitute("&1|&2|&3|&4|&5|&6|&7|&8|&9"
     6930                                           , yes
     6931                                           , v-update-attr-gbl
     6932                                           , v-update-attr-host
     6933                                           , v-update-attr-obj
     6934                                           , v-update-fbr-gds
     6935                                           , v-update-s-coeff
     6936                                           , v-update-dgr
     6937                                           , v-update-gds-prop
     6938                                           , v-update-add-prop
     6939                                         )
     6940                         ,output choice-str) no-error .
     6941     if choice-str = "":U then undo, return error .
     6942     if not logical(entry(2, choice-str, "|":U))
     6943     then v-loc-update-attr-gbl = no.
     6944     if not logical(entry(3, choice-str, "|":U))
     6945     then v-loc-update-attr-host = no.
     6946     if not logical(entry(4, choice-str, "|":U))
     6947     then v-loc-update-attr-obj = no.
     6948     if not logical(entry(5, choice-str, "|":U))
     6949     then v-loc-update-fbr-gds = no.
     6950     if not logical(entry(6, choice-str, "|":U))
     6951     then v-loc-update-s-coeff = no.
     6952     if not logical(entry(7, choice-str, "|":U))
     6953     then v-loc-update-dgr = no.
     6954     if not logical(entry(8, choice-str, "|":U))
     6955     then v-loc-update-gds-prop = no.
     6956     if not logical(entry(9, choice-str, "|":U))
     6957     then v-loc-update-add-prop = no.
     6958   end.
     6959   _main:
     6960   do transaction
     6961   on error undo, return error return-value
     6962   :
     6963   if logical(entry(1, choice-str, "|":U)) then do:
     6964     run ref/goods01.p (
     6965                   input parparentproc
     6966                   ,input mode
     6967                   ,input copymode
     6968                   ,input pmode
     6969                   ,input yes
     6970                   ,input no
     6971                   ,input no
     6972                   ,input (f-name <> "":U)
     6973                   ,input one-good
     6974                   ,input v-host-code
     6975                   ,input p-obj-type
     6976                   ,input p-obj-code
     6977                   ,input igoods
     6978                   ,input (if copymode then recid(for-goods) else ?)
     6979                   ,input (if mode = 'ДОБАВЛЕНИЕ':U then 0 else goods.gds-code)
     6980                   ,input frame d-gds-form goods.artic
     6981                   ,input frame d-gds-form ub.clients.obj-type
     6982                   ,input frame d-gds-form ub.clients.obj-code
     6983                   ,input gds-prt.node-code
     6984                   ,input (if avail ub.gds-grp then ub.gds-grp.node-code else -1)
     6985                   ,input frame d-gds-form ub.goods.gds-name
     6986                   ,input saved-name
     6987                   ,input frame d-gds-form ub.goods.engl-name
     6988                   ,input frame d-gds-form ub.goods.label-name
     6989                   ,input frame d-gds-form ub.goods.chk-name
     6990                   ,(if not avail ub.country
     6991                     then "XX":U
     6992                     else input frame d-gds-form ub.goods.alpha1
     6993                   )
     6994                   ,input frame d-gds-form ub.goods.unit-base
     6995                   ,input frame d-gds-form ub.goods.unit-cli
     6996                   ,INPUT FRAME d-gds-form ub.goods.max-rate
     6997                   ,INPUT FRAME d-gds-form ub.goods.min-rate
     6998                   ,INPUT FRAME d-gds-form ub.goods.cli-base-rate
     6999                   ,input frame d-gds-form ub.goods.qnty-cart
     7000                   ,input frame d-gds-form ub.goods.ms-base
     7001                   ,input frame d-gds-form ub.goods.wt-base
     7002                   ,input frame d-gds-form ub.goods.ms-cart
     7003                   ,input frame d-gds-form ub.goods.wt-cart
     7004                   ,input frame d-gds-form goods.calc-method
     7005                   ,input frame d-gds-form goods.increase-pc
     7006                   ,input NegRest
     7007                   ,input frame d-gds-form for-obj-price-base
     7008                   ,input frame d-gds-form for-obj-price-rubl
     7009                   ,input frame d-gds-form goods.okdp
     7010                   ,input temp-goods.destin
     7011                   ,input temp-goods.attrib
     7012                   ,input temp-goods.user-rule
     7013                   ,input temp-goods.sert
     7014                   ,input temp-goods.struct
     7015                   ,input temp-goods.deadline
     7016                   ,input temp-goods.cond-keep-code
     7017                   ,input temp-goods.sort
     7018                   ,input temp-goods.proof
     7019                   ,input temp-goods.normal-wastage
     7020                   ,input temp-goods.normal-waste
     7021                   ,input temp-goods.tnved
     7022                   ,input temp-goods.nationality
     7023                   ,input temp-goods.unit-cst
     7024                   ,input temp-goods.cst-base-rate
     7025                   ,input temp-goods.fbr-grp-code
     7026                   ,input frame d-gds-form goods.PS
     7027                   ,input unq-artc
     7028                   ,input is-jwlr
     7029                   ,input is-bttl
     7030                   ,input is-ptrl
     7031                   ,input custvalue
     7032                   ,input dif-nam1
     7033                   ,input dif-nam2
     7034                   ,input ArtDis
     7035                   ,input (if BarDis then 1 else 0)
     7036                   ,input-output gds-rec
     7037                   ,output nbc
     7038                   ) no-error .
     7039     if error-status:error then do:
     7040       assign
     7041       gds-rec = if v-prev-rec <> ? and gds-rec = ?
     7042                 then v-prev-rec
     7043                 else gds-rec
     7044       .
     7045       CASE entry(1, return-value, chr(4)):
     7046         when "unit-cli" then do:
     7047           APPLY "ENTRY" to goods.unit-cli in frame d-gds-form.
     7048           undo _main, return error .
     7049         end.
     7050         when "min-rate":U then do:
     7051           APPLY "ENTRY" to goods.min-rate in frame d-gds-form.
     7052           undo _main, return error .
     7053         end.
     7054         when "max-rate":U then do:
     7055           APPLY "ENTRY" to goods.max-rate in frame d-gds-form.
     7056           undo _main, return error .
     7057         end.
     7058         when "artic|prod-type|prod-code":U then do:
     7059           if f-name = "" then do:
     7060             not-saved = input frame d-gds-form goods.artic.
     7061             Infmes = "ТОВАР " + not-saved + " НЕ СОХРАНЕН В БАЗЕ ДАННЫХ".
     7062             undo _main, return error.
     7063           end.
     7064           else do:
     7065             run gbl/d-askw.w (input "Внимание  !!",
     7066                           input "Товар с таким артикулом и производителем УЖЕ есть в справочнике !",
     7067                           input "|",
     7068                           input "Перейти к СЛЕДУЮЩЕМУ|ВЫЙТИ из режима ИМПОРТА",
     7069                           input "|",
     7070                           input 1,
     7071                           input 2,
     7072                           output choice).
     7073             if choice = 1 then g#log = YES.
     7074             else g#log = no.
     7075             case g#log:
     7076               when YES then
     7077               g#log = NOT g#log.
     7078               when NO then
     7079               g#log = ?.
     7080             end case.
     7081             if NOT g#log then do:
     7082               not-saved = input frame d-gds-form goods.artic.
     7083               Infmes = "ТОВАР " + not-saved + " НЕ СОХРАНЕН В БАЗЕ ДАННЫХ".
     7084               VIEW Infmes in frame d-gds-form.
     7085               DISPLAY Infmes with frame d-gds-form.
     7086             end.
     7087             else  not-saved = "".
     7088             if NOT g#log or g#log = ? then
     7089             undo _main, return error (if not g#log then "next" else "").
     7090           end.
     7091         END.
     7092         when "artic|unq-artc":U then do:
     7093           if NOT f-name = "" then do:
     7094             g#log = NO.
     7095             return error "next".
     7096           end.
     7097           undo _main, return error.
     7098         end.
     7099         when "artic":U then do:
     7100           not-saved = input frame d-gds-form goods.artic.
     7101           Infmes = "ТОВАР " + not-saved + " НЕ СОХРАНЕН В БАЗЕ ДАННЫХ".
     7102           undo _main, return error.
     7103         end.
     7104         when "artic|next":U then do:
     7105           not-saved = input frame d-gds-form goods.artic.
     7106           Infmes = "ТОВАР " + not-saved + " НЕ СОХРАНЕН В БАЗЕ ДАННЫХ".
     7107           VIEW Infmes in frame d-gds-form.
     7108           DISPLAY Infmes with frame d-gds-form.
     7109           undo _main, return error "next":U.
     7110         end.
     7111         when "artic|quit":U then do:
     7112           not-saved = "".
     7113           return error "":U.
     7114         end.
     7115         otherwise do:
     7116           undo _main, return error.
     7117         end.
     7118       END CASE.
     7119     end.
     7120   end.
     7121   if mode = 'ДОБАВЛЕНИЕ':U then do:
     7122   find first goods share-lock where recid(goods) = gds-rec .
     7123     if not AVAILABLE goods then return no-apply.
     7124     else do:
     7125        if not v-loc-update-attr-gbl then
     7126        do:
     7127           message "Не задан атрибут Признак предмета расчета!"
     7128              view-as alert-box.
     7129           undo _main, return error .
     7130        end.
     7131        else
     7132        do:
     7133           find first tt0-goods-attr no-lock where tt0-goods-attr.attr-code = 'item-matter-mark':U no-error .
     7134           if not available (tt0-goods-attr) then
     7135           do:
     7136              message "Не задан атрибут Признак предмета расчета!"
     7137                 view-as alert-box.
     7138              undo _main, return error .
     7139           end.
     7140        end.
     7141       if temp-goods.alc-prod = yes then
     7142       do:
     7143         run gds-attr-write IN THIS-PROCEDURE(
     7144           input ub.goods.gds-code
     7145           ,INPUT 'alcohol-prod':U
     7146           ,INPUT temp-goods.alc-prod ) NO-ERROR.
     7147         IF ERROR-STATUS:ERROR THEN
     7148         DO:
     7149           assign
     7150             v-err-mess = substitute("Ошибка при сохранении атрибута товара &1 &2 :&3&4 &5"
     7151                                       , ub.goods.gds-code
     7152                                       , 'alcohol-prod':U
     7153                                       , chr(10)
     7154                                       ,error-status:get-message(1)
     7155                                       ,return-value).
     7156           undo _main, return error v-err-mess.
     7157         END.
     7158         if temp-goods.alc-mark = yes then do:
     7159         run gds-attr-write IN THIS-PROCEDURE(
     7160           input ub.goods.gds-code
     7161           ,INPUT 'mark':U
     7162           ,INPUT temp-goods.alc-mark ) NO-ERROR.
     7163         IF ERROR-STATUS:ERROR THEN
     7164         DO:
     7165           assign
     7166             v-err-mess = substitute("Ошибка при сохранении атрибута товара &1 &2 :&3&4 &5"
     7167                                       , ub.goods.gds-code
     7168                                       , 'mark':U
     7169                                       , chr(10)
     7170                                       ,error-status:get-message(1)
     7171                                       ,return-value).
     7172           undo _main, return error v-err-mess.
     7173         END.
     7174         end.
     7175           find first ub.alc-type-gds
     7176           where ub.alc-type-gds.gds-code = ub.goods.gds-code
     7177           and ub.alc-type-gds.create-user-db-num = 0 EXCLUSIVE-LOCK no-error.
     7178         if not available ub.alc-type-gds then
     7179         do :
     7180           create ub.alc-type-gds.
     7181         end.
     7182         else do:
     7183           delete ub.alc-type-gds.
     7184           create ub.alc-type-gds.
     7185         end.
     7186         assign
     7187           ub.alc-type-gds.gds-code            = ub.goods.gds-code
     7188           ub.alc-type-gds.alc-type-inner-code = temp-goods.alc-choose-prod
     7189           ub.alc-type-gds.create-user-db-num  = 0
     7190           ub.alc-type-gds.create-date = today
     7191           .
     7192         end.
     7193      end.
     7194      define variable v-value      as character no-undo .
     7195      define variable v-type       as character no-undo .
     7196      define buffer buf-grp for ub.gds-grp.
     7197      define variable v-upper like  ub.gds-grp.node-code.
     7198      find first buf-grp where buf-grp.node-code = ub.gds-grp.node-code no-lock no-error.
     7199      do while v-value = '' and available buf-grp:
     7200         v-upper = buf-grp.upper-code.
     7201         run ggoattr-value(
     7202                   input buf-grp.node-code,
     7203                   input 0,
     7204                   input "",
     7205                   input 0,
     7206                   input 'sum-grps':U,
     7207                   output v-value,
     7208                   output v-type
     7209                 ) no-error.
     7210           if v-value = '' then find first buf-grp where buf-grp.node-code = v-upper no-lock no-error.
     7211           if v-value > "" then do:
     7212             run gds-attr-write IN THIS-PROCEDURE(
     7213                 input ub.goods.gds-code
     7214                ,INPUT 'sum-grp-gl':U
     7215                ,INPUT v-value ) NO-ERROR.
     7216           end.
     7217         run ggoattr-value(
     7218                   input buf-grp.node-code,
     7219                   input 0,
     7220                   input "",
     7221                   input 0,
     7222                   input 'gg-mark-type':U,
     7223                   output v-value,
     7224                   output v-type
     7225                 ) no-error.
     7226           if v-value = '' then find first buf-grp where buf-grp.node-code = v-upper no-lock no-error.
     7227         if v-value > "" and v-value <> "not-type" then
     7228         do:
     7229            run gds-attr-write IN THIS-PROCEDURE(
     7230               input ub.goods.gds-code
     7231               ,INPUT 'mark-type':U
     7232               ,INPUT v-value ) NO-ERROR.
     7233            for each buf_bar-code no-lock where buf_bar-code.gds-code = ub.goods.gds-code:
     7234               find first ub.prod-bc no-lock where ub.prod-bc.b-code = buf_bar-code.b-code and ub.prod-bc.bc-on-type = 'GTIN':U no-error .
     7235               if not available (ub.prod-bc) then
     7236               do:
     7237                  message   "Для маркированного товара необходимо завести код с типом GTIN"
     7238                     view-as alert-box.
     7239                  undo _main, return error .
     7240               end.
     7241            end.
     7242         end.
     7243   end.
     7244   end.
     7245   if mode <> 'ДОБАВЛЕНИЕ':U and mode <> 'ПРОСМОТР':U then do:
     7246      find first tt0-goods-attr no-lock where tt0-goods-attr.attr-code = 'item-matter-mark':U no-error .
     7247      if not available (tt0-goods-attr) then
     7248      do:
     7249      find first ub.goods-attr no-lock where ub.goods-attr.attr-code = 'item-matter-mark':U no-error .
     7250      if not available (ub.goods-attr) then do:
     7251         message "Не задан атрибут Признак предмета расчета!"
     7252            view-as alert-box.
     7253         undo _main, return error .
     7254      end.
     7255      end.
     7256   find first goods share-lock where recid(goods) = gds-rec .
     7257     if temp-goods.alc-prod <> logical (v-gds-attr-value-old) then
     7258     do:
     7259       if temp-goods.alc-prod = yes then
     7260       do:
     7261         run gds-attr-write IN THIS-PROCEDURE(
     7262           input ub.goods.gds-code
     7263           ,INPUT 'alcohol-prod':U
     7264           ,INPUT temp-goods.alc-prod ) NO-ERROR.
     7265         IF ERROR-STATUS:ERROR THEN
     7266         DO:
     7267           assign
     7268             v-err-mess = substitute("Ошибка при сохранении атрибута товара &1 &2 :&3&4 &5"
     7269                                       , ub.goods.gds-code
     7270                                       , 'alcohol-prod':U
     7271                                       , chr(10)
     7272                                       ,error-status:get-message(1)
     7273                                       ,return-value).
     7274         END.
     7275       end.
     7276       else
     7277       do:
     7278         RUN gds-attr-delete IN THIS-PROCEDURE (
     7279           input ub.goods.gds-code
     7280           ,INPUT 'alcohol-prod':U
     7281           ,output v-deleted ) NO-ERROR.
     7282         IF NOT v-deleted
     7283           or error-status:error
     7284           THEN
     7285         DO:
     7286           assign
     7287             v-err-mess = substitute("Ошибка при удалении атрибута товара &1 &2 :&3&4 &5"
     7288                                     , ub.goods.gds-code
     7289                                     , 'alcohol-prod':U
     7290                                     , chr(10)
     7291                                     ,error-status:get-message(1)
     7292                                     ,return-value
     7293                                     ).
     7294         END.
     7295         find first ub.alc-type-gds
     7296           where ub.alc-type-gds.gds-code = goods.gds-code
     7297           and ub.alc-type-gds.alc-type-inner-code = temp-goods.alc-choose-prod
     7298           and ub.alc-type-gds.create-user-db-num = 0 no-error.
     7299           if available ub.alc-type-gds then
     7300           delete ub.alc-type-gds.
     7301       end.
     7302     end.
     7303     if temp-goods.alc-prod = yes then
     7304       do:
     7305         if temp-goods.alc-mark <> logical (v-gds-attr-mark-value-old) then do:
     7306           run gds-attr-write IN THIS-PROCEDURE(
     7307           input ub.goods.gds-code
     7308           ,INPUT 'mark':U
     7309           ,INPUT temp-goods.alc-mark ) NO-ERROR.
     7310         IF ERROR-STATUS:ERROR THEN
     7311         DO:
     7312           assign
     7313             v-err-mess = substitute("Ошибка при сохранении атрибута товара &1 &2 :&3&4 &5"
     7314                                       , ub.goods.gds-code
     7315                                       , 'mark':U
     7316                                       , chr(10)
     7317                                       ,error-status:get-message(1)
     7318                                       ,return-value).
     7319         END.
     7320         end.
     7321           find first ub.alc-type-gds
     7322           where ub.alc-type-gds.gds-code = ub.goods.gds-code
     7323           and ub.alc-type-gds.create-user-db-num = 0 EXCLUSIVE-LOCK no-error.
     7324         if not available ub.alc-type-gds then
     7325         do :
     7326           create ub.alc-type-gds.
     7327         end.
     7328         else do:
     7329           delete ub.alc-type-gds.
     7330           create ub.alc-type-gds.
     7331         end.
     7332         assign
     7333           ub.alc-type-gds.gds-code            = ub.goods.gds-code
     7334           ub.alc-type-gds.alc-type-inner-code = temp-goods.alc-choose-prod
     7335           ub.alc-type-gds.create-user-db-num  = 0
     7336           ub.alc-type-gds.create-date = today
     7337           .
     7338    end.
     7339   end.
     7340   end.
     7341   if v-loc-update-dgr then do:
     7342     run ref/disgdru1.p (
     7343                        input mode
     7344                       ,input ub.goods.gds-code
     7345                       ,input p-obj-type
     7346                       ,input p-obj-code
     7347                       ,INPUT table tt0-dis-gds-rule
     7348                       ) no-error .
     7349     if error-status:error then do:
     7350       message
     7351       substitute("Ошибка при сохранении скидок товара на объекте:&1&2&1&3"
     7352                  , chr(10)
     7353                  , error-status:get-message(1)
     7354                  , return-value )
     7355       view-as alert-box
     7356       error .
     7357     end.
     7358   end.
     7359   if v-loc-update-attr-obj then do:
     7360     run ref/gdsoatr1.p (
     7361                        input mode
     7362                       ,input ub.goods.gds-code
     7363                       ,input p-obj-type
     7364                       ,input p-obj-code
     7365                       ,INPUT table tt0-gds-obj-attr
     7366                       ) no-error .
     7367     if error-status:error then do:
     7368       message
     7369       substitute("Ошибка при сохранении атрибутов товара на объекте:&1&2&1&3"
     7370                  , chr(10)
     7371                  , error-status:get-message(1)
     7372                  , return-value )
     7373       view-as alert-box
     7374       error .
     7375     end.
     7376   end.
     7377   if v-loc-update-attr-host then do:
     7378     run ref/gdshatr1.p (
     7379                        input mode
     7380                       ,input goods.gds-code
     7381                       ,input v-host-code
     7382                       ,input p-obj-type
     7383                       ,input p-obj-code
     7384                       ,INPUT table tt0-gds-host-attr
     7385                       ) no-error .
     7386     if error-status:error then do:
     7387       message
     7388       substitute("Ошибка при сохранении атрибутов товара на фирме:&1&2&1&3"
     7389                  , chr(10)
     7390                  , error-status:get-message(1)
     7391                  , return-value )
     7392       view-as alert-box
     7393       error .
     7394     end.
     7395   end.
     7396   if v-loc-update-attr-gbl then do:
     7397     run ref/gds-atr1.p (
     7398                        input mode
     7399                       ,input goods.gds-code
     7400                       ,INPUT table tt0-goods-attr
     7401                       ) no-error .
     7402     if error-status:error then do:
     7403       message
     7404       substitute("Ошибка при сохранении глобальных атрибутов товара на объекте:&1&2&1&3"
     7405                  , chr(10)
     7406                  , error-status:get-message(1)
     7407                  , return-value )
     7408       view-as alert-box
     7409       error .
     7410     end.
     7411   end.
     7412   if v-loc-update-fbr-gds then do:
     7413       run ref/fgdsobj1.p (
     7414                         input-output v-fbr-gds-obj-recid
     7415                       , input (if available locked_fbr-gds-obj
     7416                                   then 'ИЗМЕНЕНИЕ':U
     7417                                   else 'ДОБАВЛЕНИЕ':U)
     7418                       , input no
     7419                       , input goods.gds-code
     7420                       , input p-obj-type
     7421                       , input p-obj-code
     7422                       , input integer(entry(9, v-fbr-gds-obj-template))
     7423                       , input entry(7, v-fbr-gds-obj-template)
     7424                       , input integer(entry(8, v-fbr-gds-obj-template))
     7425                       , input logical(entry(1, v-fbr-gds-obj-template))
     7426                       , input logical(entry(2, v-fbr-gds-obj-template))
     7427                       , input logical(entry(3, v-fbr-gds-obj-template))
     7428                       , input logical(entry(4, v-fbr-gds-obj-template))
     7429                       , input logical(entry(5, v-fbr-gds-obj-template))
     7430                       , input logical(entry(6, v-fbr-gds-obj-template))
     7431                       ) no-error.
     7432     if error-status:error then do:
     7433       message
     7434       substitute("Ошибка при сохранении атрибутов РЕСТОРАН товара на объекте:&1&2&1&3"
     7435                  , chr(10)
     7436                  , error-status:get-message(1)
     7437                  , return-value )
     7438       view-as alert-box
     7439       error .
     7440     end.
     7441   end.
     7442   if v-loc-update-s-coeff then do:
     7443     run ref/s-coeff1.p (
     7444                        input mode
     7445                       ,input goods.gds-code
     7446                       ,input v-host-code
     7447                       ,input p-obj-type
     7448                       ,input p-obj-code
     7449                       ,INPUT table tt0-s-coeff
     7450                       ) no-error .
     7451     if error-status:error then do:
     7452       message
     7453       substitute("Ошибка при сохранении сезонных коэффициентов товара:&1&2&1&3"
     7454                  , chr(10)
     7455                  , error-status:get-message(1)
     7456                  , return-value )
     7457       view-as alert-box
     7458       error .
     7459     end.
     7460   end.
     7461   if v-loc-update-gds-prop then do:
     7462       find first ttf-gds-obj-prop no-error .
     7463       if available ttf-gds-obj-prop then do:
     7464       run ref/gds-ind1.p
     7465           (input-output v-gds-prop-recid
     7466           ,input goods.gds-code
     7467           ,input ttf-gds-obj-prop.obj-type
     7468           ,input ttf-gds-obj-prop.obj-code
     7469           ,input ttf-gds-obj-prop.gdop-igt
     7470           ,input ttf-gds-obj-prop.gdop-assort-min
     7471           ,input ttf-gds-obj-prop.gdop-min-stock
     7472           ,input ttf-gds-obj-prop.grop-level-always-presence
     7473           ,input ttf-gds-obj-prop.grop-max-stock
     7474           ,input ttf-gds-obj-prop.grop-min-order
     7475           ,input table ttf-gds-obj-prop-attr
     7476           ) no-error .
     7477       end.
     7478       find first tt0-gds-obj-prop no-error .
     7479       if available tt0-gds-obj-prop then do:
     7480       run ref/gds-ind1.p
     7481           (input-output v-gds-prop-recid
     7482           ,input goods.gds-code
     7483           ,input tt0-gds-obj-prop.obj-type
     7484           ,input tt0-gds-obj-prop.obj-code
     7485           ,input tt0-gds-obj-prop.gdop-igt
     7486           ,input tt0-gds-obj-prop.gdop-assort-min
     7487           ,input ?
     7488           ,input ?
     7489           ,input ?
     7490           ,input ?
     7491           ,input table tt0-gds-obj-prop-attr
     7492           ) no-error .
     7493           if error-status:error then do:
     7494             message
     7495             substitute("Ошибка при сохранении индикаторов/атрибутов для заказа товара на объекте:&1&2&1&3"
     7496                       , chr(10)
     7497                       , error-status:get-message(1)
     7498                       , return-value )
     7499             view-as alert-box
     7500             error .
     7501           end.
     7502       end.
     7503       find first ttj-gds-obj-prop no-error .
     7504       if available ttj-gds-obj-prop then do:
     7505       run ref/gds-ind1.p
     7506           (input-output v-gds-prop-recid
     7507           ,input goods.gds-code
     7508           ,input ttJ-gds-obj-prop.obj-type
     7509           ,input ttj-gds-obj-prop.obj-code
     7510           ,input ?
     7511           ,input ?
     7512           ,input ttj-gds-obj-prop.gdop-min-stock
     7513           ,input ttj-gds-obj-prop.grop-level-always-presence
     7514           ,input ttj-gds-obj-prop.grop-max-stock
     7515           ,input ttj-gds-obj-prop.grop-min-order
     7516           ,input table ttj-gds-obj-prop-attr
     7517           ) no-error .
     7518           if error-status:error then do:
     7519             message
     7520             substitute("Ошибка при сохранении параметров заказа товара на объекте:&1&2&1&3"
     7521                       , chr(10)
     7522                       , error-status:get-message(1)
     7523                       , return-value )
     7524             view-as alert-box
     7525             error .
     7526           end.
     7527         end.
     7528   end.
     7529   if v-loc-update-add-prop then do:
     7530       find first tt0-gds-add-charges no-error .
     7531       if error-status :error then message error-status :get-message(1) .
     7532       run ref/adcharg1.p
     7533           (input-output v-add-prop-recid
     7534           ,input goods.gds-code
     7535           ,input tt0-gds-add-charges.algoritm
     7536           ,input tt0-gds-add-charges.cost-include
     7537           ) no-error .
     7538     if error-status:error then do:
     7539       message
     7540       substitute("Ошибка при сохранении дополнительных расходов :&1&2&1&3"
     7541                  , chr(10)
     7542                  , error-status:get-message(1)
     7543                  , return-value )
     7544       view-as alert-box
     7545       error .
     7546     end.
     7547   end.
     7548   if mode = 'ДОБАВЛЕНИЕ':U then do:
     7549     AvtArt = nbc .
     7550     DISPLAY string( AvtArt ) @ goods.artic with frame d-gds-form .
     7551     find first goods share-lock where
     7552                recid(goods) = gds-rec .
     7553     assign
     7554     copymode = no
     7555     saved-name = goods.gds-name
     7556     Infmes = "Товар " + string(goods.artic) + " сохранен  - "  + string(goods.gds-code, "99999999999")
     7557     impc-saved = impc-saved + 1
     7558     nbc = 0
     7559     .
     7560   end.
     7561   assign
     7562   temp-goods.cst-base-rate = goods.cst-base-rate
     7563   .
     7564   END PROCEDURE.
     7565   PROCEDURE disable_UI :
     7566     HIDE FRAME d-gds-form.
     7567   END PROCEDURE.
     7568   PROCEDURE enable-UI :
     7569   define variable i-find as logical no-undo .
     7570   define variable ii as integer no-undo .
     7571   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     7572     (input  'is-prt'
     7573     ,input  0
     7574     ,input  ''
     7575     ,input  0
     7576     ,input  ''
     7577     ,input  ''
     7578     ,input  ''
     7579     ,input  no
     7580     ,output conf-par
     7581     ,output par-type
     7582     ) no-error .
     7583   is-prt = (IF error-status:error or conf-par <> "yes" then no else yes).
     7584   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7585   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     7586     (input  p-obj-type
     7587     ,input  p-obj-code
     7588     ,input  'doc-prt=request':U
     7589     ,output v-doc-prt
     7590     ) no-error .
     7591   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     7592     (input  'is-jwlr'
     7593     ,input  ''
     7594     ,input  ''
     7595     ,input  0
     7596     ,input  ''
     7597     ,input  ''
     7598     ,input  ''
     7599     ,input  no
     7600     ,output conf-par
     7601     ,output par-type
     7602     ) no-error .
     7603   assign
     7604   is-jwlr = (conf-par = "yes":U) no-error
     7605   .
     7606   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     7607     (input  'is-bttl'
     7608     ,input  ''
     7609     ,input  ''
     7610     ,input  0
     7611     ,input  ''
     7612     ,input  ''
     7613     ,input  ''
     7614     ,input  no
     7615     ,output conf-par
     7616     ,output par-type
     7617     ) no-error .
     7618   assign
     7619   is-bttl = (conf-par = "yes":U) no-error
     7620   .
     7621   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     7622     (input  'is-ptrl'
     7623     ,input  ''
     7624     ,input  ''
     7625     ,input  0
     7626     ,input  ''
     7627     ,input  ''
     7628     ,input  ''
     7629     ,input  no
     7630     ,output conf-par
     7631     ,output par-type
     7632     ) no-error .
     7633   assign
     7634   is-ptrl = (conf-par = "yes":U) no-error
     7635   .
     7636   HIDE
     7637   frame d-gds-form name-uchet-base
     7638   frame d-gds-form name-uchet-rubl
     7639   frame d-gds-form for-obj-price-base
     7640   frame d-gds-form for-obj-last-base
     7641   frame d-gds-form for-obj-price-rubl
     7642   frame d-gds-form for-obj-last-rubl
     7643   frame d-gds-form b-extart
     7644   in frame d-gds-form.
     7645   CASE mode :
     7646     when 'ДОБАВЛЕНИЕ':U then do:
     7647       if not copymode then do:
     7648         find first temp-goods no-error.
     7649         if not available temp-goods then do:
     7650          create temp-goods.
     7651         end.
     7652       end.
     7653       ENABLE
     7654       b-exit
     7655       b-arch WHEN not dif-nam2
     7656       b-inf when not igoods
     7657       b-rest
     7658       b-chk
     7659       b-prt
     7660       b-file when igoods
     7661       b-help
     7662       add-inf
     7663       b-tax
     7664       br-tt-tax
     7665       ArtBar
     7666       b-copy-name-to-lbl
     7667       with frame d-gds-form.
     7668       assign
     7669       b-card:label = "След.->"
     7670       menu-item m-dopinf-2:sensitive in menu m-dopinf = no
     7671       .
     7672       HIDE
     7673       b-altcd
     7674       b-prodbc
     7675       ub.bar-code.b-code
     7676       b-parts
     7677       b-place
     7678       b-recipe
     7679       b-hist
     7680       in frame d-gds-form.
     7681       if copymode and f-name = "" then do:
     7682         run ref/dtaxgdss.p (
     7683                          input no
     7684                         ,input for-goods.unit-base
     7685                         ,input for-goods.grp-code
     7686                         ,input  ?
     7687                         ,input recid(for-goods)
     7688                         ,input v-host-code
     7689                         ,input p-obj-type
     7690                         ,input p-obj-code
     7691                         ) no-error.
     7692         if error-status:error then return error.
     7693         run enable-max-min in this-procedure ( input for-goods.unit-base) no-error.
     7694         if error-status:error then return no-apply.
     7695             OPEN QUERY br-tt-tax for each tt-tax NO-LOCK.
     7696         FIND FIRST ub.country where ub.country.alpha1 = for-goods.alpha1 No-LOCK No-ERROR.
     7697         assign
     7698         ub.goods.PS:screen-value = temp-goods.ps
     7699         ub.goods.calc-method:screen-value = string(temp-goods.calc-method)
     7700         FirstIter = no
     7701         NegRest = if (temp-goods.negative-rest) then var-negative-rest else FALSE
     7702         .
     7703         if temp-goods.fbr-grp-code <> ? then do:
     7704           find first buf_fbr-gds-grp no-lock where
     7705                   buf_fbr-gds-grp.obj-type = "":U
     7706               AND buf_fbr-gds-grp.obj-code = 0
     7707               AND buf_fbr-gds-grp.node-code = temp-goods.fbr-grp-code no-error .
     7708           if available buf_fbr-gds-grp then
     7709           assign
     7710           fbr-grp-code_ = buf_fbr-gds-grp.node-code
     7711           f-fbr-grp-name = buf_fbr-gds-grp.node-name
     7712           .
     7713         end.
     7714         display
     7715         temp-goods.gds-name @ goods.gds-name
     7716         temp-goods.prod-type @ ub.clients.obj-type
     7717         temp-goods.prod-code @ ub.clients.obj-code
     7718         ub.clients.obj-name
     7719         temp-goods.unit-base @ ub.goods.unit-base
     7720         temp-goods.okdp @ ub.goods.okdp
     7721         temp-goods.engl-name @  ub.goods.engl-name
