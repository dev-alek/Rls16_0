     4366   procedure addGdsGrpAttr:
     4367      define input  parameter i-gds-code as integer no-undo.
     4368      define input  parameter i-grp-code as integer no-undo.
     4369      define variable vi as integer no-undo.
     4370      define buffer buf_gds-grp-obj-attr for gds-grp-obj-attr.
     4371      define buffer tt0-goods-attr for tt0-goods-attr.
     4372      define buffer buf-goods-attr for tt0-goods-attr.
     4373      for each tt0-goods-attr where tt0-goods-attr.grp:
     4374         delete tt0-goods-attr.
     4375      end.
     4376      do vi = 1 to num-entries('alcohol-prod,egais-name,is-gas,ptrl-without-rvs,office-type,mark-type,emrc-type,IS18Plus,loyalty-gift,item-matter-mark,type-method-calc,group-np,fuel-type,is-loyalty-payment,ban-bonus,null-price,fasovka,time-coock,mark,sum-grp-gl,min-zapas,mercur_FGIS,perishable,production-only,15x80,8x50,6x50,calories,protein,fat,carbohydrate,calc-cal-rec,cash-parts,ptrl-as-good,dflt-insalepr,gds-ptrl-densities,gds-CommodityCode,gds-code-AIS,length-of,width-of,height-of,qnty-in-box,weight-box,qnty-on-pallet,weight-of-pallet,image-list,MercUnits,weighed-gds':U):
     4377         find first buf_gds-grp-obj-attr no-lock
     4378            where buf_gds-grp-obj-attr.node-code   = i-grp-code
     4379              and buf_gds-grp-obj-attr.host-code   = 0
     4380              and buf_gds-grp-obj-attr.obj-type    = ""
     4381              and buf_gds-grp-obj-attr.obj-code    = 0
     4382              and buf_gds-grp-obj-attr.attr-code   = entry(vi,'alcohol-prod,egais-name,is-gas,ptrl-without-rvs,office-type,mark-type,emrc-type,IS18Plus,loyalty-gift,item-matter-mark,type-method-calc,group-np,fuel-type,is-loyalty-payment,ban-bonus,null-price,fasovka,time-coock,mark,sum-grp-gl,min-zapas,mercur_FGIS,perishable,production-only,15x80,8x50,6x50,calories,protein,fat,carbohydrate,calc-cal-rec,cash-parts,ptrl-as-good,dflt-insalepr,gds-ptrl-densities,gds-CommodityCode,gds-code-AIS,length-of,width-of,height-of,qnty-in-box,weight-box,qnty-on-pallet,weight-of-pallet,image-list,MercUnits,weighed-gds':U)
     4383         no-error .
     4384         if available buf_gds-grp-obj-attr
     4385         then do:
     4386            find first tt0-goods-attr where tt0-goods-attr.gds-code   = i-gds-code
     4387                                        and tt0-goods-attr.attr-code  = buf_gds-grp-obj-attr.attr-code
     4388                                        and tt0-goods-attr.grp
     4389            no-error.
     4390               create tt0-goods-attr.
     4391            assign
     4392               tt0-goods-attr.gds-code   = i-gds-code
     4393               tt0-goods-attr.attr-code  = buf_gds-grp-obj-attr.attr-code
     4394               tt0-goods-attr.attr-value = buf_gds-grp-obj-attr.attr-value
     4395               tt0-goods-attr.grp        = yes
     4396            .
     4397            tt0-goods-attr.fdisable = can-find (buf-goods-attr where buf-goods-attr.gds-code   eq tt0-goods-attr.gds-code
     4398                                                                 and buf-goods-attr.attr-code  eq tt0-goods-attr.attr-code
     4399                                                                 and buf-goods-attr.grp        ne yes).
     4400            .
     4401            end.
     4402      end.
     4403   end.
