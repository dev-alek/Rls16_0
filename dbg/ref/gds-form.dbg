     5770         name-uchet-rubl
     5771         (if avail gds-obj then ub.gds-obj.last-base else 0) @ for-obj-last-base
     5772         (if avail gds-obj then ub.gds-obj.last-rubl else 0) @ for-obj-last-rubl
     5773         (if avail gds-obj then ub.gds-obj.avrg-base else 0) @ for-obj-price-base
     5774         (if avail gds-obj then ub.gds-obj.avrg-rubl else 0 ) @ for-obj-price-rubl
