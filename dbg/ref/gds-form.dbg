     5369     run proc-b-add-inf(input-output dopinf-option) no-error.
     5370     if error-status:error then return no-apply.
     5371   end.
     5372   on choose of MENU-ITEM m-dopinf-8 in menu m-dopinf DO:
     5373     dopinf-option = "indicators":U.
     5374     run proc-b-add-inf(input-output dopinf-option) no-error.
     5375     if error-status:error then return no-apply.
     5376   end.
