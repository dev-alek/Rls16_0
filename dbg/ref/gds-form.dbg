     5378     dopinf-option = "AM":U.
     5379     run proc-b-add-inf(input-output dopinf-option) no-error.
     5380     if error-status:error then return no-apply.
     5381   end.
     5382   on choose of MENU-ITEM m-dopinf-AC in menu m-dopinf DO:
     5383     dopinf-option = "add-charg":U.
     5384     run proc-b-add-inf(input-output dopinf-option) no-error.
     5385     if error-status:error then return no-apply.
     5386   end.
     5387   on choose of MENU-ITEM m-dopinf-AU in menu m-dopinf DO:
     5388     dopinf-option = "alt-units":U.
     5389     run proc-b-add-inf(input-output dopinf-option) no-error.
     5390     if error-status:error then return no-apply.
