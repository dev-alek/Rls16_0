     8779       ,input  0
     8780       ,input  0
     8781       ,input  ub.goods.grp-code
     8782       ,input  0
     8783       ,input  true
     8784       ,output glog
     8785       )  .
     8786   end.
     8787         end.
     8788         if glog then do :
     8789           run set-fields.
     8790           run ref/p51121.w (
     8791                             input parparentproc
     8792                           , input p-obj-type
     8793                           , input p-obj-code
     8794                           , input mode
     8795                           , input goodsname
     8796                           , input prodname
