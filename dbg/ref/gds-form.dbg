     8178                  gds-obj.prod-code = ub.goods.prod-code
     8179               NO-LOCK NO-ERROR .
     8180       FIND FIRST clients WHERE
     8181                  clients.obj-type = ub.goods.prod-type AND
     8182                  clients.obj-code = ub.goods.prod-code NO-LOCK.
     8183       FIND FIRST gds-prt WHERE
     8184                  gds-prt.upper-code = ub.goods.prt-root NO-LOCK.
     8185       FIND FIRST bar-code WHERE
     8186                  bar-code.gds-code = ub.goods.gds-code AND
     8187                  bar-code.node-code = gds-prt.node-code AND
     8188                  bar-code.in-code = "" AND
     8189                  bar-code.part-code = "" AND
     8190                  bar-code.unit-cli = ub.goods.unit-base NO-LOCK NO-error.
     8191       IF ERROR-status:error then do:
     8192         message
     8193         vss-workfile vss-revision vss-description skip
     8194         "Не найден главный код для товара " ub.goods.artic ub.goods.prod-type string(goods.prod-code)
     8195         view-as alert-box error.
     8196         return error.
     8197       end.
     8198       FIND FIRST country where
     8199                  country.alpha1 = ub.goods.alpha1 NO-LOCK No-ERROR.
     8200       if ub.goods.fbr-grp-code <> ? then do:
     8201         find first buf_fbr-gds-grp no-lock where
     8202                   buf_fbr-gds-grp.obj-type = "":U
     8203               AND buf_fbr-gds-grp.obj-code = 0
     8204               AND buf_fbr-gds-grp.node-code = ub.goods.fbr-grp-code no-error .
     8205         if available buf_Fbr-gds-grp then
     8206         assign
     8207         fbr-grp-code_ = buf_fbr-gds-grp.node-code
     8208         f-fbr-grp-name = buf_fbr-gds-grp.node-name
     8209         .
     8210       end.
     8211       HIDE
     8212       r-base r-supp r-prod r-alpha1 r-fbr-grp b-file
     8213       ArtBar in frame d-gds-form.
     8214       NegRest = ub.goods.negative-rest .
     8215       main-code = bar-code.b-code.
     8216       assign
     8217       menu-item m-dopinf-6:sensitive in menu m-dopinf = (fbrvalue = "yes")
     8218       menu-item m-dopinf-7:sensitive in menu m-dopinf = (fbrvalue = "yes")
     8219       .
     8220       DISPLAY
     8221       (if length(goods.grp-name) > 79
     8222         then ("..." + substr(goods.grp-name, length(goods.grp-name) - 79))
     8223         else ub.goods.grp-name)
     8224         @ grp-full
     8225       if avail country
     8226         then country.short-name
     8227         else "" @ country_name
     8228       ub.goods.artic ub.goods.okdp bar-code.b-code clients.obj-type clients.obj-code
     8229       clients.obj-name ub.goods.gds-name ub.goods.engl-name ub.goods.label-name ub.goods.chk-name
     8230       ub.goods.unit-base ub.goods.unit-cli ub.goods.cli-base-rate ub.goods.alpha1
     8231       ub.goods.calc-method ub.goods.increase-pc ub.goods.qnty-cart ub.goods.ms-base ub.goods.ms-cart label-increase-pc
     8232       label-min-rate
     8233       label-max-rate
     8234       ub.goods.wt-base
     8235       ub.goods.wt-cart ub.goods.PS NegRest
     8236       ub.goods.min-rate when ub.goods.min-rate <> 0
     8237       ub.goods.max-rate when ub.goods.max-rate <> 0
     8238       f-fbr-grp-name
     8239       with frame d-gds-form.
     8240       if gds-prt.node-name <> '_Пустая шкала':U
     8241       then
     8242       DISPLAY gds-prt.node-name with frame d-gds-form.
     8243       if ub.goods.PS = ""
     8244       then
     8245       disable ub.goods.PS with frame d-gds-form.
     8246       if ub.goods.gds-type = 'т':U
     8247         then
     8248       frame d-gds-form:title = "Т О В А Р".
     8249         else
     8250       frame d-gds-form:title = "У С Л У Г А".
     8251       if ub.goods.stts = 1
     8252         then
     8253       frame d-gds-form:title = frame d-gds-form:title + "      'статус':U :  УДАЛЕН".
     8254       frame d-gds-form:title = frame d-gds-form:title + fill(chr(32), 34) + title-mode(mode).
     8255       APPLY "Value-changed" to ub.goods.calc-method in frame d-gds-form.
     8256     end.
     8257   end CASE .
     8258     RUN gds-attr-value (
     8259       INPUT temp-goods.gds-code,
     8260       INPUT 'alcohol-prod':U,
     8261       OUTPUT v-gds-attr-value-old,
     8262       OUTPUT v-gds-attr-type
     8263       ).
     8264        if v-gds-attr-value-old = "yes" then do:
     8265        RUN gds-attr-value (
     8266           INPUT temp-goods.gds-code,
     8267           INPUT 'mark':U,
     8268           OUTPUT v-gds-attr-mark-value-old,
     8269           OUTPUT v-gds-attr-type
     8270           ).
     8271        find first ub.alc-type-gds no-lock
     8272        where ub.alc-type-gds.gds-code = temp-goods.gds-code and
     8273        ub.alc-type-gds.create-user-db-num = 0 no-error.
     8274        if not AVAILABLE ub.alc-type-gds then do:
     8275        assign
     8276           temp-goods.alc-prod = no
     8277           temp-goods.alc-mark = no
     8278           .
     8279        end.
     8280        else
     8281        assign
     8282           temp-goods.alc-choose-prod = ub.alc-type-gds.alc-type-inner-code
     8283           temp-goods.alc-prod = yes
     8284           .
     8285        if v-gds-attr-mark-value-old = "yes" then temp-goods.alc-mark = yes .
     8286        end.
     8287   END PROCEDURE.
     8288   PROCEDURE copy-name-to-lbl:
     8289      if mode = 'ДОБАВЛЕНИЕ':U and ub.goods.label-name:screen-value IN FRAME d-gds-form = ""
     8290      or self:name = "b-copy-name-to-lbl"
     8291      then
     8292     DISPLAY ub.goods.gds-name:screen-value @ ub.goods.label-name with frame d-gds-form.
     8293     if mode = 'ДОБАВЛЕНИЕ':U and ub.goods.chk-name:screen-value IN FRAME d-gds-form = ""
     8294     or self:name = "b-copy-name-to-lbl"
     8295     then
     8296     DISPLAY replace(replace(goods.gds-name:screen-value, chr(39), ""), '"', "") @ ub.goods.chk-name with frame d-gds-form.
     8297   END.
     8298   PROCEDURE start-import:
     8299       if ArtBar = vArtBar-Auto then
     8300       assign
     8301       ArtBar = vArtBar-Off.
     8302       run val-chg-ArtBar.
     8303       DiSPLAY ArtBar WITH FRAME d-gds-form.
     8304       if NOT f-name = "" then do:
     8305           message ("Импорт из файла " + f-name + " закончен" + chr(10) + "прочитано " + string(impc) +
     8306                            ",  сохранено " + string(impc-saved) )
     8307                            view-as alert-box INFORMATION.
     8308           assign
     8309           f-name = ""
     8310           not-saved = ''.
     8311           display "" @ ub.goods.artic with frame d-gds-form.
     8312           DISABLE b-card WITH frame d-gds-form.
     8313       end.
     8314       run ref/strtimp.w (
     8315                              input parparentproc
     8316                             ,input no
     8317                             ,input vattaxcd
     8318                             ,input slttaxcd
     8319                             ,input custvalue
     8320                             ,input tnvedimp
     8321                             ,output f-name
     8322                             ,output choice
     8323                             ,output p-artic
     8324                             ,output p-prod
     8325                             ,OUTPUT p-name
     8326                             ,OUTPUT p-engl-name
     8327                             ,OUTPUT p-unit-base
     8328                             ,OUTPUT p-VAT-code
     8329                             ,OUTPUT p-SLT-code
     8330                             ,OUTPUT p-struct
     8331                             ,OUTPUT p-tnved
     8332                             ,OUTPUT p-attrib
     8333                             ,OUTPUT p-destin
     8334                             ,OUTPUT p-sert
     8335                             ,OUTPUT p-user-rule
     8336                             ,OUTPUT p-alpha1
     8337                             ,OUTPUT p-grp-code
     8338                             ,OUTPUT p-service
     8339                             ,OUTPUT p-gds-code
     8340                             ,OUTPUT p-mark
     8341                             ) no-error.
     8342       if  error-status:error or f-name = "" then return error.
     8343       CASE choice:
     8344           WHEN 1 then do:
     8345               input stream gds-file from value (f-name) convert source "1251".
     8346           END.
     8347           WHEN 2 then do:
     8348               input stream gds-file from value (f-name) convert source "KOI8-R".
     8349           END.
     8350       END CASE.
     8351       assign
     8352       add-another = yes
     8353       impc = 0
     8354       impc-saved = 0.
     8355       apply "go" to frame d-gds-form.
     8356   END.
     8357   PROCEDURE next-good:
     8358     assign
     8359     v-flag-attr-obj-entry   = no
     8360     v-flag-attr-host-entry  = no
     8361     v-flag-fbr-gds-entry    = no
     8362     v-flag-s-coeff-entry    = no
     8363     v-flag-gds-prop-entry   = no
     8364     v-flag-add-prop-entry   = no
     8365     v-update-attr-obj       = no
     8366     v-update-attr-host      = no
     8367     v-update-fbr-gds        = no
     8368     v-update-s-coeff        = no
     8369     v-update-gds-prop       = no
     8370     v-update-add-prop       = no
     8371     v-found-copy-atr-obj    = no
     8372     v-found-copy-atr-host   = no
     8373     v-found-copy-fbr-gds    = no
     8374     v-found-copy-s-coeff    = no
     8375     v-found-copy-gds-prop   = no
     8376     v-found-copy-add-prop   = no
     8377     .
     8378       i-artic = "".
     8379       if g#log = ? then do:
     8380           input stream gds-file close.
     8381       end.
     8382       else DO on endkey undo, leave on error undo, leave:
     8383           run ref/nxtgdsi.p (   input vattaxcd
     8384                                ,input slttaxcd
     8385                                ,input custvalue
     8386                                ,input p-artic
     8387                                ,input p-prod
     8388                                ,input p-name
     8389                                ,input p-engl-name
     8390                                ,input p-unit-base
     8391                                ,input p-VAT-code
     8392                                ,input p-SLT-code
     8393                                ,input p-struct
     8394                                ,input p-tnved
     8395                                ,input p-attrib
     8396                                ,input p-destin
     8397                                ,input p-sert
     8398                                ,input p-user-rule
     8399                                ,input p-alpha1
     8400                                ,input p-grp-code
     8401                                ,input p-service
     8402                                ,input p-gds-code
     8403                                ,p-mark
     8404                                ,input (impc + 1)
     8405                                ,input-output i-artic
     8406                                ,input-output i-prod-type
     8407                                ,input-output i-prod-code
     8408                                ,input-output i-gds-name
     8409                                ,input-output i-engl-name
     8410                                ,input-output i-unit-base
     8411                                ,input-output i-VAT-code
     8412                                ,input-output i-SLT-code
     8413                                ,input-output i-struct
     8414                                ,input-output i-tnved
     8415                                ,input-output i-attrib
     8416                                ,input-output i-destin
     8417                                ,input-output i-sert
     8418                                ,input-output i-user-rule
     8419                                ,input-output i-alpha1
     8420                                ,input-output i-grp-code
     8421                                ,input-output i-service
     8422                                ,input-output i-gds-code
     8423                                ,input-output i-mark
     8424                                 ) .
     8425           assign
     8426           impc = impc + 1
     8427           ImpMes = "ИМПОРТ " + string (impc , "99999")
     8428           InfMes = "".
     8429           Display ImpMes with frame d-gds-form.
     8430      END.
     8431      IF ERROR-STATUS:ERROR OR g#log = ? THEN do:
     8432        message ("Импорт из файла " + f-name + " закончен" + chr(10) + "прочитано " + string(impc) +
     8433                         ",  сохранено " + string(impc-saved) )
     8434        view-as alert-box  INFORMATION.
     8435        display "" @ ub.goods.artic with frame d-gds-form.
     8436        assign f-name = ""
     8437        impc = 0
     8438        impc-saved = 0
     8439        ImpMes = "ИМПОРТ"
     8440        not-saved = ""
     8441        ArtBar:List-items = if v-cntxt-db-num = 0
     8442                                       then (vArtBar-off + chr(44) + vArtBar-Auto + chr(44) + vArtBar-BarCode)
     8443                                       else (vArtBar-off + chr(44) + vArtBar-Auto)
     8444        .
     8445        DISPLAY ArtBar With FRAME d-gds-form.
     8446        DISABLE b-card with frame d-gds-form.
     8447        Hide ImpMes in frame d-gds-form.
     8448        run val-chg-ArtBar.
     8449        return error.
     8450     END.
     8451   END.
     8452   PROCEDURE val-chg-ArtBAr:
     8453       Assign frame d-gds-form ArtBar.
     8454       Case ArtBar:
     8455       When vArtBar-Auto then  do:
     8456               assign
     8457                   ArtDis = yes
     8458                   BarDis = no
     8459                   ub.goods.artic:BGCOLOR in frame d-gds-form = 8
     8460                   ArtBar:FGCOLOR = 10
     8461                   AvtArt = nbc
     8462                   .
     8463               DISPLAY
     8464                   ( if AvtArt = 0 then "" else string( AvtArt)) @ ub.goods.artic with frame d-gds-form.
     8465               DISABLE ub.goods.artic b-file with frame d-gds-form.
     8466               apply "entry" to ub.goods.gds-name in frame d-gds-form.
     8467       end.
     8468       WHEN vArtBar-Off then do:
     8469               assign
     8470                   ArtDIs = no
     8471                   BarDis = no
     8472                   ub.goods.artic:BGCOLOR = 3
     8473                   ArtBar:FGCOLOR = 0 .
     8474               ENABLE ub.goods.artic b-file with frame d-gds-form.
     8475               apply "entry" to ub.goods.artic in frame d-gds-form.
     8476       end.
     8477       WHEN vArtBar-BarCode then do:
     8478               assign
     8479                   ArtDIs = no
     8480                   BarDis = yes
     8481                   ub.goods.artic:BGCOLOR = 9
     8482                   ArtBar:FGCOLOR = 9 .
     8483               ENABLE ub.goods.artic b-file with frame d-gds-form.
     8484               apply "entry" to ub.goods.artic in frame d-gds-form.
     8485       end.
     8486       END CASE.
     8487   END PROCEDURE.
     8488   PROCEDURE next-good-display:
     8489   define buffer first_gds-grp for ub.gds-grp.
     8490   DISPLAY
     8491   i-artic           @ ub.goods.artic
     8492   i-gds-name  @ ub.goods.gds-name
     8493   i-engl-name @ ub.goods.engl-name
     8494   ""                 @ ub.goods.label-name
     8495   ""                 @ ub.goods.chk-name
     8496   i-unit-base   @ ub.goods.unit-base
     8497   i-unit-base   @ ub.goods.unit-cli
     8498   with frame d-gds-form
     8499   .
     8500   if p-prod <> 0 then do:
     8501     DISPLAY
     8502     i-prod-type       @ ub.clients.obj-type
     8503     i-prod-code       @ ub.clients.obj-code
     8504     with frame d-gds-form.
     8505     apply "LEAVE" to ub.clients.obj-code in frame d-gds-form .
     8506   end.
     8507   if p-alpha1 <> 0 then do:
     8508     DISPLAY
     8509     i-alpha1          @ ub.goods.alpha1
     8510     with frame d-gds-form.
     8511     apply "LEAVE" to ub.goods.alpha1 in frame d-gds-form .
     8512   end.
     8513   if p-grp-code <> 0 then do:
     8514     find first ub.gds-grp no-lock where ub.gds-grp.node-code = i-grp-code no-error .
     8515     if avail ub.gds-grp then do:
     8516       RUN grplib-get-full-name in this-procedure(input ub.gds-grp.node-code, output grp-full).
     8517       DISPLAY
     8518       (if length(grp-full) > 79
     8519       then
     8520       ("..." + substr(grp-full, length(grp-full) - 79))
     8521       else
     8522       grp-full) @ grp-full
     8523       with frame d-gds-form.
     8524     end.
     8525   end.
     8526   assign
     8527   temp-goods.attrib = i-attrib
     8528   temp-goods.destin = i-destin
     8529   temp-goods.sert = i-sert
     8530   temp-goods.user-rule = i-user-rule
     8531   temp-goods.struct = i-struct
     8532   .
     8533   if p-unit-base > 0 then do:
     8534     run leave-unit-base(i-unit-base).
     8535   end.
     8536   find first first_gds-grp .
     8537   if p-VAT-code > 0 then do:
     8538     FIND FIRST bf-tt-tax NO-LOCK where
     8539               bf-tt-tax.tax-code = vattaxcd No-ERROR.
     8540     if not avail bf-tt-tax then do:
     8541       run ref/dtaxgdss.p (
     8542                      input no
     8543                     ,input i-unit-base
     8544                     ,input (if available ub.gds-grp
     8545                             then ub.gds-grp.node-code
     8546                             else first_gds-grp.node-code)
     8547                     ,input ?
     8548                     ,input ?
     8549                     ,input v-host-code
     8550                     ,input p-obj-type
     8551                     ,input p-obj-code
     8552                     ) no-error.
     8553       if error-status:error then return error.
     8554       run enable-max-min(goods.unit-base:screen-value) no-error.
     8555       if error-status:error then return error.
     8556       OPEN QUERY br-tt-tax for each tt-tax NO-LOCK.
     8557       FIND FIRST bf-tt-tax NO-LOCK where
     8558                 bf-tt-tax.tax-code = vattaxcd No-ERROR.
     8559     end.
     8560     if avail bf-tt-tax then do:
     8561       REPOSITION br-tt-tax to recid recid(bf-tt-tax) No-ERROR.
     8562       run ROW-LEAVE-BR-tt-tax(i-vat-code).
     8563     end.
     8564   end.
     8565   if p-slt-code > 0 then do:
     8566     FIND FIRST bf-tt-tax NO-LOCK where
     8567               bf-tt-tax.tax-code = slttaxcd No-ERROR.
     8568     if not avail bf-tt-tax then do:
     8569       run ref/dtaxgdss.p (
     8570                           input no
     8571                          ,input i-unit-base
     8572                          ,input (if available ub.gds-grp
     8573                                  then ub.gds-grp.node-code
     8574                                  else first_gds-grp.node-code)
     8575                          ,input ?
     8576                          ,input ?
     8577                          ,input v-host-code
     8578                          ,input p-obj-type
     8579                          ,input p-obj-code
     8580                     ) no-error.
     8581       if error-status:error then return error.
     8582       run enable-max-min(goods.unit-base:screen-value) no-error.
     8583       if error-status:error then return error.
     8584       OPEN QUERY br-tt-tax for each tt-tax NO-LOCK.
     8585       FIND FIRST bf-tt-tax NO-LOCK where
     8586                 bf-tt-tax.tax-code = slttaxcd No-ERROR.
     8587     end.
     8588     if avail bf-tt-tax then do:
     8589       REPOSITION br-tt-tax to recid recid(bf-tt-tax) No-ERROR.
     8590       run ROW-LEAVE-BR-tt-tax(i-slt-code).
     8591     end.
     8592   end.
     8593   if p-tnved > 0 then do:
     8594     assign
     8595     temp-goods.tnved = i-tnved
     8596     .
     8597     run get-fields in this-procedure no-error .
     8598   end.
     8599   END.
     8600   PROCEDURE leave-unit-base:
     8601   DEFINE INPUT PARAMETER fv as char no-undo.
     8602   define variable loc#log as logical no-undo .
     8603   define buffer base_units for ub.units.
     8604   FIND first base_units no-lock where
     8605            base_units.unit-name = input frame d-gds-form ub.goods.unit-base  no-error.
     8606   if not available base_units
     8607   then do:
     8608     display "?" @ ub.goods.unit-base WITH FRAME d-gds-form.
     8609   end.
     8610   if available base_units
     8611   and lookup( 'топ':U, base_units.type) > 0 then do:
     8612   define variable vss-include-info33 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8613   do:
     8614     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8615       (input  v-cntxt-db-num
     8616       ,input  v-cntxt-userid
     8617       ,input  0
     8618       ,input  'actn_reference-petrolium_update':U
     8619       ,input  'global':U
     8620       ,input  0
     8621       ,input  '':U
     8622       ,input  0
     8623       ,input  0
     8624       ,input  0
     8625       ,input  0
     8626       ,input  false
     8627       ,output loc#log
     8628       )  .
     8629   end.
     8630     if not loc#log then do:
     8631       display "?" @ ub.goods.unit-base WITH FRAME d-gds-form.
     8632     end.
     8633   end.
     8634   if  NOT ub.goods.unit-base:screen-value = "?" and mode = 'ДОБАВЛЕНИЕ':U and avail ub.gds-grp then do:
     8635     run ref/dtaxgdss.p (
     8636                          input no
     8637                         ,input fv
     8638                         ,input ub.gds-grp.node-code
     8639                         ,input ?
     8640                         ,input ?
     8641                         ,input v-host-code
     8642                         ,input p-obj-type
     8643                         ,input p-obj-code
     8644                         ) no-error.
     8645     if error-status:error then return error.
     8646     run enable-max-min(fv) no-error.
     8647     if error-status:error then return no-apply.
     8648     OPEN QUERY br-tt-tax for each tt-tax NO-LOCK.
     8649   end.
     8650   END.
     8651   PROCEDURE row-leave-br-tt-tax.
     8652   DEFINE INPUT PARAMETER trc like ub.tax-rate.rate-code no-undo.
     8653   define variable taxvalue like ub.tax-rate-value.rate-value no-undo.
     8654   define variable var-fact-order like ub.tax-rate-value.fact-order no-undo.
     8655   DEFINE VARIABLE v-today as date no-undo .
     8656   DEFINE VARIABLE v-time as integer no-undo .
     8657   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8658   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
     8659     (input  ?
     8660     ,input  tt-tax.tax-code
     8661     ,input  trc
     8662     ,input  ?
     8663     ,input  v-host-code
     8664     ,input  p-obj-type
     8665     ,input  p-obj-code
     8666     ,output taxvalue
     8667     ) no-error .
     8668     if error-status:error or taxvalue = ? then do:
     8669         assign
     8670         tt-tax.rate-code:screen-value in browse br-tt-tax = string(tt-tax.rate-code)
     8671         tt-tax.fact-date:screen-value in browse br-tt-tax = string(tt-tax.fact-date)
     8672         .
     8673         return error.
     8674     end.
     8675     if mode = 'ДОБАВЛЕНИЕ':U and not copymode then v-today = 01/01/1990.
     8676     else do:
     8677       run cur-time in this-procedure(output v-today, output v-time).
     8678     end.
     8679     assign
     8680     tt-tax.rate-value:screen-value in browse br-tt-tax = string(taxvalue)
     8681     tt-tax.fact-date:screen-value in browse br-tt-tax = string(v-today, "99/99/9999")
     8682     .
     8683     FIND FIRST bf-tt-tax WHERE recid(bf-tt-tax) = recid(tt-tax) NO-ERROR.
     8684     run factord-end-day in this-procedure (input date(tt-tax.fact-date:screen-value in browse br-tt-tax), output var-fact-order).
     8685     assign
     8686     bf-tt-tax.rate-code = integer(trc)
     8687     bf-tt-tax.rate-value = decimal(tt-tax.rate-value:screen-value in browse br-tt-tax)
     8688     bf-tt-tax.fact-date = date(tt-tax.fact-date:screen-value in browse br-tt-tax)
     8689     bf-tt-tax.fact-order = var-fact-order
     8690     .
     8691     OPEN QUERY br-tt-tax for each tt-tax NO-LOCK.
     8692   END.
     8693   PROCEDURE enable-max-min:
     8694   DEFINE INPUT PARAMETER fv as char no-undo.
     8695   DEFINE BUFFER loc-units for ub.units.
     8696         FIND FIRST loc-units No-LOCK WHERE
     8697                    loc-units.unit-name = fv NO-ERROR.
     8698         IF not avail loc-units then return error.
     8699         IF LOOKUP('2ед':U, loc-units.type) > 0 then do:
     8700           DISPLAY
     8701           label-min-rate
     8702           Label-max-rate
     8703           with frame d-gds-form.
     8704           ENABLE
     8705           ub.goods.min-rate
     8706           ub.goods.max-rate
     8707           with frame d-gds-form.
     8708           DISPLAY
     8709           0 @ ub.goods.min-rate
     8710           0 @ ub.goods.max-rate
     8711           with frame d-gds-form.
     8712         END.
     8713         ELSE DO:
     8714           DISABLE
     8715           ub.goods.min-rate
     8716           ub.goods.max-rate
     8717           with frame d-gds-form.
     8718           HIDE
     8719           label-min-rate
     8720           Label-max-rate
     8721           ub.goods.min-rate
     8722           ub.goods.max-rate
     8723           IN frame d-gds-form.
     8724         END.
     8725   END.
     8726   PROCEDURE proc-b-altcd :
     8727     DEFINE INPUT-OUTPUT PARAMETER loc-altcd-option as char no-undo.
     8728      run ref/alt-cds.w (
     8729                      input parparentproc
     8730                     ,input p-obj-type
     8731                     ,input p-obj-code
     8732                     ,input loc-altcd-option
     8733                     ,goods.gds-code
     8734                     ,main-code
     8735                     ,output ref-list).
     8736     loc-altcd-option = "".
     8737   END PROCEDURE.
     8738   PROCEDURE proc-b-add-inf:
     8739     DEFINE INPUT-OUTPUT PARAMETER loc-DOPINF-option as char no-undo.
     8740     define variable v-recid as recid no-undo.
     8741     DEFINE VARIABLE v-updated-now AS LOGICAL NO-UNDO.
     8742     case LOC-DOPINF-option:
     8743       WHEN "dop-inf":U then do:
     8744         define variable goodsname as char no-undo .
     8745         define variable prodname as char no-undo .
     8746         define variable prodaddress as char no-undo .
     8747         define variable goods-unit-base as char no-undo .
     8748         define variable glog as logical no-undo.
     8749         if NOT can-do( 'ДОБАВЛЕНИЕ':U, mode ) then do:
     8750           if ub.clients.obj-type = 'орг':U then
     8751               FIND ub.firm WHERE ub.firm.firm-code = ub.clients.obj-code NO-LOCK .
     8752           else
     8753               FIND ub.person WHERE ub.person.psn-code = ub.clients.obj-code NO-LOCK .
     8754           assign
     8755               goodsname = ub.goods.gds-name
     8756               prodname = ( trim( ub.clients.obj-name ) +
     8757                                     "( " + ub.clients.obj-type + " " + string( ub.clients.obj-code ) + " )" )
     8758               prodaddress = ( if ub.clients.obj-type = 'орг':U
     8759                               then string( trim( firm.city ) + " " +
     8760                                           trim( firm.addres1 ) + " " + trim( firm.addres2 ) )
     8761                               else string( trim( person.city ) + " " + trim( person.address ) ) )
     8762               goods-unit-base = input frame d-gds-form goods.unit-base
     8763               .
     8764         end.
     8765         assign
     8766           glog = true
     8767         .
     8768         if mode <> 'ДОБАВЛЕНИЕ':U and mode <> 'ПРОСМОТР':U then do :
     8769   define variable vss-include-info35 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8770   do:
     8771     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8772       (input  v-cntxt-db-num
     8773       ,input  v-cntxt-userid
     8774       ,input  0
     8775       ,input  'actn_reference_update_dopinfo_gbl':U
     8776       ,input  'object':U
     8777       ,input  0
