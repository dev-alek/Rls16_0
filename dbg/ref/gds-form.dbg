     3819   DEFINE VARIABLE mImagePath     AS CHARACTER   NO-UNDO.
     3820   DEFINE VARIABLE mImageDir      AS CHARACTER   NO-UNDO.
     3821   DEFINE VARIABLE mImagePreDir   AS CHARACTER   NO-UNDO.
     3822   DEFINE VARIABLE mImageTrash    AS CHARACTER   NO-UNDO.
     3823   DEFINE VARIABLE mPhotomgd      AS LOGICAL     NO-UNDO.
     3824   DEFINE VARIABLE mImagePh       AS LOGICAL     NO-UNDO.
     3825   define variable v-param-types   as character  no-undo.
     3826   define variable v-value-char    as character  no-undo.
     3827   define variable v-val-date      as date       no-undo.
     3828   define variable v-val-decimal   as decimal    no-undo.
     3829   define variable v-val-integer   as integer    no-undo.
     3830   define variable v-val-logical   as logical    no-undo.
     3831   define variable v-tthd          as handle     no-undo.
     3832   RUN imagelist_loaddef IN THIS-PROCEDURE NO-ERROR.
     3833   PROCEDURE imagelist_loaddef:
     3834       DEFINE VARIABLE vPar-val       AS CHARACTER   NO-UNDO.
     3835       DEFINE VARIABLE vPar-type      AS CHARACTER   NO-UNDO.
     3836       ASSIGN
     3837           vPar-val  = "":U
     3838           vPar-type = "":U
     3839           .
     3840   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3841     (input  'photo':u
     3842     ,input  '':u
     3843     ,input  '':u
     3844     ,input  0
     3845     ,input  '':u
     3846     ,input  '':u
     3847     ,input  '':u
     3848     ,input  no
     3849     ,output vPar-val
     3850     ,output vPar-type
     3851     ) no-error .
     3852           mImagePh = LOOKUP (vPar-val, "true,yes":U) > 0.
     3853       IF mImagePh THEN .
     3854       ELSE RETURN.
     3855       ASSIGN
     3856           vPar-val  = "":U
     3857           vPar-type = "":U
     3858           .
     3859   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3860     (input  'ph-dir':u
     3861     ,input  '':u
     3862     ,input  '':u
     3863     ,input  0
     3864     ,input  '':u
     3865     ,input  '':u
     3866     ,input  '':u
     3867     ,input  NO
     3868     ,output vPar-val
     3869     ,output vPar-type
     3870     ) no-error .
     3871       IF LENGTH (vPar-val) = 0 THEN
     3872           RUN verify-ini-entry("ph-dir":U, "REP-SETS":U, "":U, YES, OUTPUT vPar-val) NO-ERROR.
     3873       IF LENGTH (vPar-val) = 0 THEN vPar-val = "c:\temp\":U.
     3874       ASSIGN
     3875           mImagePath   = RIGHT-TRIM (vPar-val, "~\~/":U)
     3876           mImagePath   = mImagePath + (IF LENGTH (mImagePath) > 0 THEN "\":U ELSE "":U)
     3877           mImagePreDir = mImagePath
     3878           mImageDir    = mImagePreDir
     3879           mImageTrash  = mImagePath + "trash\":U
     3880           .
     3881       ASSIGN
     3882           vPar-val  = "":U
     3883           vPar-type = "":U
     3884           .
     3885               run adm/shattri.p (
     3886           input "get":U
     3887           ,input  '':U
     3888           ,input  0
     3889           ,input  'gds-ref':U
     3890           ,input  'shema-foto':U
     3891           ,output v-value-char
     3892           ,output v-val-date
     3893           ,output v-val-decimal
     3894           ,output v-val-integer
     3895           ,output v-val-logical
     3896           ,output v-param-types
     3897           ,INPUT-OUTPUT table-handle v-tthd
     3898           ) no-error.
     3899           delete object v-tthd.
     3900           mPhotomgd = IF v-val-integer = 2 then yes else no.
     3901   END PROCEDURE.
     3902   PROCEDURE imagelist_decode:
     3903       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
     3904       DEFINE INPUT  PARAMETER iImageGdsCode AS int    NO-UNDO.
     3905       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
     3906       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
     3907       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
     3908       ASSIGN
     3909           oImageList = iImageList
     3910           .
     3911       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
     3912           vCh =ENTRY (vInt, iImageList, ",":U).
     3913           IF SUBSTRING (vCh, 1, 2) = "~\~\":U THEN .
     3914           ELSE
     3915           DO:
     3916               ASSIGN
     3917                   vCh = REPLACE (vCh, "~/":U, "\":U)
     3918                   vCh = REPLACE (vCh, "~\":U, "\":U)
     3919                   .
     3920               IF SUBSTRING (vCh, 2, 2) = ":\":U OR vCh BEGINS mImageDir THEN .
     3921               ELSE vCh = mImagePreDir + (if mPhotomgd then string(iImageGdsCode) + "\":U else '':U ) +  vCh.
     3922               ENTRY (vInt, oImageList, ",":U) = vCh.
     3923           END.
     3924       END.
     3925   END PROCEDURE.
     3926   PROCEDURE imagelist_encode:
     3927       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
     3928       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
     3929       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
     3930       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
     3931       DEFINE VARIABLE vLen               AS INTEGER   NO-UNDO.
     3932       ASSIGN
     3933           oImageList = iImageList
     3934           vLen       = LENGTH (mImageDir)
     3935           .
     3936       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
     3937           vCh =ENTRY (vInt, iImageList, ",":U).
     3938           IF LENGTH (vCh) > 0 AND vLen > 0 AND vCh BEGINS mImageDir THEN
     3939               ENTRY (vInt, oImageList, ",":U) =
     3940                   SUBSTRING (vCh, vLen + 1).
     3941       END.
     3942   END PROCEDURE.
