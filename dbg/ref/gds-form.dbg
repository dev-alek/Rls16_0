    10844                         TO locked_s-coeff
    10845                         case-sensitive
    10846                         SAVE result IN v-updated-str.
    10847             assign
    10848             v-created = yes
    10849             v-updated = (v-updated-str <> "":U)
    10850             .
    10851           end.
    10852           else do:
    10853             assign
    10854             v-updated = yes.
    10855           end.
    10856           ASSIGN
    10857           v-loc-update = (v-loc-update or v-updated).
    10858         End.
    10859         FOR EACH locked_s-coeff where
    10860                 locked_s-coeff.gds-code = goods.gds-code :
    10861           FIND FIRST tt0-s-coeff NO-LOCK WHERE
    10862                     tt0-s-coeff.gds-code = locked_s-coeff.gds-code
    10863                 AND tt0-s-coeff.host-code = locked_s-coeff.host-code
    10864                 AND tt0-s-coeff.obj-type = locked_s-coeff.obj-type
    10865                 AND tt0-s-coeff.obj-code = locked_s-coeff.obj-code
    10866                 AND tt0-s-coeff.s-date = locked_s-coeff.s-date NO-ERROR.
    10867             IF NOT AVAILABLE tt0-s-coeff THEN DO:
