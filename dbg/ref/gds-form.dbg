      997   procedure uf-get :
      998     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      999     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1000     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1001     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1002     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1003     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1004     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1005     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1006     do
     1007     on error undo, return error
     1008     :
     1009       define buffer buf_usr-flt for ubflt.usr-flt .
     1010       define variable v-use-List_     as logical   no-undo .
     1011       define variable v-type-List_     as character no-undo .
     1012       define variable v-format-List_   as character no-undo .
     1013       define variable v-use-Naim      as logical   no-undo .
     1014       define variable v-type-Naim      as character no-undo .
     1015       define variable v-format-Naim    as character no-undo .
     1016       define variable v-use-print-graft as logical   no-undo .
     1017       define variable v-use-sort-gr     as logical   no-undo .
     1018       define variable v-use-type-price  as logical   no-undo .
     1019       define variable v-use-type-val    as logical   no-undo .
     1020       define variable v-label          as character no-undo .
     1021       define variable v-tooltip        as character no-undo .
     1022       define variable v-user-can-edit  as logical   no-undo .
     1023       define variable v-output-display as logical   no-undo .
     1024       define variable v-other          as character no-undo .
     1025       run uf-name in this-procedure
     1026          (input  entry(1, p-code, chr(4))
     1027         ,output v-use-List_
     1028         ,output v-type-List_
     1029         ,output v-format-List_
     1030         ,output v-use-Naim
     1031         ,output v-type-Naim
     1032         ,output v-format-Naim
     1033         ,output v-use-print-graft
     1034         ,output v-use-sort-gr
     1035         ,output v-use-type-price
     1036         ,output v-use-type-val
     1037         ,output v-label
     1038         ,output v-tooltip
     1039         ,output v-user-can-edit
     1040         ,output v-output-display
     1041         ,output v-other
     1042         ) no-error .
     1043       if error-status :error then do:
     1044         undo, return error return-value .
     1045       end.
     1046       find first buf_usr-flt no-lock where
     1047                  buf_usr-flt.Call-point     = p-code AND
     1048                  buf_usr-flt.user-name       = p-user-name
     1049         no-error .
     1050       if avail buf_usr-flt then do:
     1051         assign
     1052         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1053         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1054         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1055         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1056         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1057         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1058         .
     1059       end.
     1060       else do:
     1061         assign
     1062         p-List_        = (if v-use-List_       then "":U                    else ?)
     1063         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1064         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1065         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1066         p-type-price   = (if v-use-type-price  then no                      else ?)
     1067         p-type-val     = (if v-use-List_       then no                      else ?)
     1068         .
     1069       end.
     1070     end.
     1071   end procedure.
     1072   procedure uf-set :
     1073     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1074     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1075     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1076     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1077     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1078     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1079     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1080     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1081     do
     1082     on error undo, return error
     1083     :
     1084       define buffer buf_usr-flt for ubflt.usr-flt .
     1085       define variable v-use-List_     as logical   no-undo .
     1086       define variable v-type-List_     as character no-undo .
     1087       define variable v-format-List_   as character no-undo .
     1088       define variable v-use-Naim      as logical   no-undo .
     1089       define variable v-type-Naim      as character no-undo .
     1090       define variable v-format-Naim    as character no-undo .
     1091       define variable v-use-print-graft as logical   no-undo .
     1092       define variable v-use-sort-gr   as logical   no-undo .
     1093       define variable v-use-type-price as logical   no-undo .
     1094       define variable v-use-type-val  as logical   no-undo .
     1095       define variable v-tooltip        as character no-undo .
     1096       define variable v-label          as character no-undo .
     1097       define variable v-user-can-edit  as logical   no-undo .
     1098       define variable v-output-display as logical   no-undo .
     1099       define variable v-other          as character no-undo .
     1100       run uf-name in this-procedure
     1101         (input  entry(1, p-code, chr(4))
     1102         ,output v-use-List_
     1103         ,output v-type-List_
     1104         ,output v-format-List_
     1105         ,output v-use-Naim
     1106         ,output v-type-Naim
     1107         ,output v-format-Naim
     1108         ,output v-use-print-graft
     1109         ,output v-use-sort-gr
     1110         ,output v-use-type-price
     1111         ,output v-use-type-val
     1112         ,output v-label
     1113         ,output v-tooltip
     1114         ,output v-user-can-edit
     1115         ,output v-output-display
     1116         ,output v-other
     1117         ) no-error .
     1118       if error-status :error then do:
     1119         undo, return error return-value .
     1120       end.
     1121       find first buf_usr-flt where
     1122                  buf_usr-flt.Call-point     = p-code AND
     1123                  buf_usr-flt.user-name       = p-user-name
     1124         no-error .
     1125       if not avail buf_usr-flt then do:
     1126           create buf_usr-flt .
     1127           assign
     1128           buf_usr-flt.call-point = p-code
     1129           buf_usr-flt.user-name  = p-user-name
     1130           .
     1131       end.
     1132       if avail buf_usr-flt then do:
     1133        assign
     1134        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1135        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1136        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1137        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1138        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1139        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1140       .
     1141       release buf_usr-flt.
     1142       end.
     1143       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1144     end.
     1145   end procedure.
     1146   define variable vss-include-info9 as character format "X(65)" no-undo
     1147   initial "@(#)$Workfile$ $Revision$".
     1148   define temp-table temp_fbrglib_grp no-undo
     1149       field sel           as character
     1150       field full-name     as character
     1151       field out-code      as integer
     1152       field sort-name     as character
     1153       field node-code     as integer
     1154       field upper-code    as integer
     1155       field name          as character
     1156       field level         as integer
     1157       field mark          as character
     1158       field obj-type      as character
     1159       field obj-code      as integer
     1160       field global-code   as integer
     1161       index pi is primary unique obj-type obj-code sort-name
     1162       index fn obj-type obj-code full-name
     1163       index nc is unique obj-type obj-code node-code
     1164       index sl obj-type obj-code sel
     1165       index uc obj-type obj-code upper-code
     1166   .
     1167   define temp-table temp_fbrglib_found-grp no-undo
     1168       field full-name   as character
     1169       field sort-name   as character
     1170       field node-code   as integer
     1171       field level       as integer
     1172       field is-terminal as logical
     1173       field obj-type      as character
     1174       field obj-code      as integer
     1175       index pi is primary unique obj-type obj-code sort-name
     1176       index fn obj-type obj-code full-name
     1177       index lv obj-type obj-code level
     1178       index it obj-type obj-code is-terminal
     1179   .
     1180   define temp-table temp_found-result-nodelist no-undo
     1181       field node-code     as integer
     1182       field processed     as logical
     1183       field sort-name     as character
     1184       field full-name     as character
     1185       index pi is primary unique node-code
     1186       index ps processed
     1187   .
     1188   procedure fbrglib-get-sort-name :
     1189   do
     1190   on error undo, return error
     1191   :
     1192   define input parameter p-obj-type   as character    no-undo.
     1193   define input parameter p-obj-code   as integer      no-undo.
     1194   define input parameter p-node-code  as integer      no-undo.
     1195   define output parameter p-sort-name as character    no-undo.
     1196       define variable v-upper-code    as integer           no-undo.
     1197       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1198       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
     1199       find first buf_fbr-gds-grp no-lock
     1200            where buf_fbr-gds-grp.obj-type  = p-obj-type
     1201              and buf_fbr-gds-grp.obj-code  = p-obj-code
     1202              and buf_fbr-gds-grp.node-code = p-node-code
     1203       no-error.
     1204       if not available buf_fbr-gds-grp
     1205       then do:
     1206           undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1207       end.
     1208       assign
     1209           p-sort-name  = ""
     1210           v-upper-code = 1
     1211       .
     1212       do while true
     1213       on error undo, return error "fbrglib-get-sort-name: Ошибка составления полного имени группы"
     1214       :
     1215           assign
     1216               p-sort-name  = buf_fbr-gds-grp.node-name
     1217                            + (if p-sort-name <> "" then chr(2) else "")
     1218                            + p-sort-name
     1219               v-upper-code = buf_fbr-gds-grp.upper-code
     1220           .
     1221           if buf_fbr-gds-grp.upper-code = 1
     1222           then do:
     1223               leave.
     1224           end.
     1225           find first buf_fbr-gds-grp no-lock
     1226                where buf_fbr-gds-grp.obj-type  = p-obj-type
     1227                  and buf_fbr-gds-grp.obj-code  = p-obj-code
     1228                  and buf_fbr-gds-grp.node-code = v-upper-code
     1229           no-error.
     1230           if not available buf_fbr-gds-grp
     1231           then do:
     1232               undo, return error "fbrglib-get-sort-name: Не найдена группа товаров с кодом "
     1233                                   + string( v-upper-code )
     1234                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1235           end.
     1236       end.
     1237   end.
     1238   end procedure.
     1239   procedure fbrglib-get-full-name :
     1240   do
     1241   on error undo, return error
     1242   :
     1243   define input parameter p-obj-type   as character    no-undo.
     1244   define input parameter p-obj-code   as integer      no-undo.
     1245   define input parameter p-node-code  as integer      no-undo.
     1246   define output parameter p-full-name as character    no-undo.
     1247       define variable v-upper-code    as integer           no-undo.
     1248       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1249       define buffer buf_upper_fbr-gds-grp for ub.fbr-gds-grp.
     1250       if p-node-code = 1
     1251       then do:
     1252           assign
     1253               p-full-name = ""
     1254           .
     1255       end.
     1256       else do:
     1257           find first buf_fbr-gds-grp no-lock
     1258                where buf_fbr-gds-grp.obj-type  = p-obj-type
     1259                  and buf_fbr-gds-grp.obj-code  = p-obj-code
     1260                  and buf_fbr-gds-grp.node-code = p-node-code
     1261           no-error.
     1262           if not available buf_fbr-gds-grp
     1263           then do:
     1264               undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1265           end.
     1266           assign
     1267               p-full-name  = ""
     1268               v-upper-code = 1
     1269           .
     1270           do while true
     1271           on error undo, return error "fbrglib-get-full-name: Ошибка составления полного имени группы"
     1272           :
     1273               assign
     1274                   p-full-name  = buf_fbr-gds-grp.node-name
     1275                               + (if p-full-name <> "" then chr(47) else "")
     1276                               + p-full-name
     1277                   v-upper-code = buf_fbr-gds-grp.upper-code
     1278               .
     1279               if buf_fbr-gds-grp.upper-code = 1
     1280               then do:
     1281                   leave.
     1282               end.
     1283               find first buf_fbr-gds-grp no-lock
     1284                    where buf_fbr-gds-grp.obj-type  = p-obj-type
     1285                      and buf_fbr-gds-grp.obj-code  = p-obj-code
     1286                      and buf_fbr-gds-grp.node-code = v-upper-code
     1287               no-error.
     1288               if not available buf_fbr-gds-grp
     1289               then do:
     1290                   undo, return error "fbrglib-get-full-name: Не найдена группа товаров с кодом "
     1291                                       + string( v-upper-code )
     1292                                       + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1293               end.
     1294           end.
     1295           assign
     1296               p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1297           .
     1298       end.
     1299   end.
     1300   end procedure.
     1301   procedure fbrglib-get-root-code :
     1302   do
     1303   on error undo, return error
     1304   :
     1305   define output parameter p-root-code as integer      no-undo.
     1306       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1307       find first buf_fbr-gds-grp no-lock
     1308            where buf_fbr-gds-grp.upper-code = 0
     1309       no-error .
     1310       if not available buf_fbr-gds-grp
     1311       then do:
     1312           undo, return error .
     1313       end.
     1314       else do:
     1315           assign
     1316               p-root-code = buf_fbr-gds-grp.node-code
     1317           .
     1318       end.
     1319   end.
     1320   end procedure.
     1321   procedure fbrglib-find-grp-by-full-name :
     1322   do
     1323   on error undo, return error
     1324   :
     1325   define input parameter p-obj-type     as character    no-undo.
     1326   define input parameter p-obj-code     as integer      no-undo.
     1327   define input parameter p-search-name  as character    no-undo.
     1328   define input parameter p-fill-path    as logical      no-undo.
     1329       define variable v-upper-code    as integer          no-undo.
     1330       define variable v-not-found     as logical init yes no-undo.
     1331       define variable v-counter       as integer           no-undo.
     1332       define variable v-level         as integer           no-undo.
     1333       define variable v-full-name     as character         no-undo.
     1334       define variable v-sort-name     as character         no-undo.
     1335       define variable v-node-name     as character      no-undo.
     1336       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1337       assign
     1338           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1339       .
     1340       run fbrglib-get-root-code ( output v-upper-code ) no-error .
     1341       if error-status :error
     1342       then do:
     1343           undo, return error "fbrglib-find-grp-by-full-name: Ошибка при поиске корневого узла".
     1344       end.
     1345       assign
     1346           v-full-name  = ""
     1347           v-level      = num-entries( p-search-name, chr(2) )
     1348       .
     1349       for each temp_fbrglib_found-grp
     1350       :
     1351           delete temp_fbrglib_found-grp.
     1352       end.
     1353       start-name-analyze:
     1354       do v-counter = 1 to v-level
     1355       :
     1356           if v-counter < v-level
     1357           then do:
     1358               assign
     1359                   v-node-name = entry( v-counter, p-search-name, chr(2) )
     1360               .
     1361               find first buf_fbr-gds-grp no-lock
     1362                    where buf_fbr-gds-grp.obj-type   = p-obj-type
     1363                      and buf_fbr-gds-grp.obj-code   = p-obj-code
     1364                      and buf_fbr-gds-grp.upper-code = v-upper-code
     1365                      and buf_fbr-gds-grp.node-name  = v-node-name
     1366               no-error .
     1367               if not available buf_fbr-gds-grp
     1368               then do:
     1369                   assign
     1370                       v-full-name  = p-search-name
     1371                       v-sort-name  = p-search-name
     1372                   .
     1373                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(47) ).
     1374               end.
     1375               else do:
     1376                   assign
     1377                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_fbr-gds-grp.node-name
     1378                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_fbr-gds-grp.node-name
     1379                       v-upper-code = buf_fbr-gds-grp.node-code
     1380                   .
     1381                   if p-fill-path = yes
     1382                   then do:
     1383                       create temp_fbrglib_found-grp.
     1384                       assign
     1385                           temp_fbrglib_found-grp.full-name = v-full-name + chr(47)
     1386                           temp_fbrglib_found-grp.sort-name = v-sort-name
     1387                           temp_fbrglib_found-grp.node-code = v-upper-code
     1388                           temp_fbrglib_found-grp.level     = v-counter
     1389                           temp_fbrglib_found-grp.obj-type  = p-obj-type
     1390                           temp_fbrglib_found-grp.obj-code  = p-obj-code
     1391                       .
     1392                   end.
     1393               end.
     1394           end.
     1395           else do:
     1396               for each buf_fbr-gds-grp no-lock
     1397                  where buf_fbr-gds-grp.obj-type   = p-obj-type
     1398                    and buf_fbr-gds-grp.obj-code   = p-obj-code
     1399                    and buf_fbr-gds-grp.upper-code = v-upper-code
     1400                    and buf_fbr-gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1401               :
     1402                   assign
     1403                       v-not-found = no
     1404                   .
     1405                   create temp_fbrglib_found-grp.
     1406                   assign
     1407                       temp_fbrglib_found-grp.full-name = v-full-name
     1408                                                           + (if v-full-name = "" then "" else chr(47) )
     1409                                                           + buf_fbr-gds-grp.node-name + chr(47)
     1410                       temp_fbrglib_found-grp.sort-name = v-sort-name
     1411                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1412                                                           + buf_fbr-gds-grp.node-name
     1413                       temp_fbrglib_found-grp.node-code = buf_fbr-gds-grp.node-code
     1414                       temp_fbrglib_found-grp.level     = v-level
     1415                       temp_fbrglib_found-grp.obj-type  = p-obj-type
     1416                       temp_fbrglib_found-grp.obj-code  = p-obj-code
     1417                   .
     1418               end.
     1419               if v-not-found = yes
     1420               then do:
     1421                   assign
     1422                       v-full-name  = p-search-name
     1423                       v-sort-name  = p-search-name
     1424                   .
     1425                   for each temp_fbrglib_found-grp
     1426                   :
     1427                       delete temp_fbrglib_found-grp.
     1428                   end.
     1429                   return error "fbrglib-find-grp-by-full-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1430               end.
     1431           end.
     1432       end.
     1433   end.
     1434   end procedure.
     1435   procedure fbrglib-find-all-subgroup :
     1436   do
     1437   on error undo, return error
     1438   :
     1439   define input parameter p-start-obj-type     as character    no-undo.
     1440   define input parameter p-start-obj-code     as integer      no-undo.
     1441   define input parameter p-start-node-code    as integer      no-undo.
     1442   define input parameter p-terminal-only      as logical      no-undo.
     1443       define variable v-start-full-name   as character     no-undo.
     1444       define variable v-start-sort-name   as character     no-undo.
     1445       define variable v-not-found         as logical       no-undo.
     1446       define variable v-is-terminal       as logical       no-undo.
     1447       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     1448       create temp_found-result-nodelist.
     1449       assign
     1450           temp_found-result-nodelist.node-code = p-start-node-code
     1451           temp_found-result-nodelist.processed = no
     1452       .
     1453       run fbrglib-get-full-name in this-procedure (
     1454             input p-start-obj-type
     1455           , input p-start-obj-code
     1456           , input p-start-node-code
     1457           , output v-start-full-name
     1458       ).
     1459       run fbrglib-get-full-name in this-procedure (
     1460             input p-start-obj-type
     1461           , input p-start-obj-code
     1462           , input p-start-node-code
     1463           , output v-start-sort-name
     1464       ).
     1465       process-nodes:
     1466       do while yes
     1467       :
     1468           find first temp_found-result-nodelist
     1469                where temp_found-result-nodelist.node-code = p-start-node-code
     1470           .
     1471           assign
     1472               temp_found-result-nodelist.processed = yes
     1473           .
     1474           for each buf_fbr-gds-grp no-lock
     1475              where buf_fbr-gds-grp.obj-type   = p-start-obj-type
     1476                and buf_fbr-gds-grp.obj-code   = p-start-obj-code
     1477                and buf_fbr-gds-grp.upper-code = p-start-node-code
     1478           on error undo, return error
     1479           :
     1480               run fbrglib-is-terminal in this-procedure (
     1481                     input buf_fbr-gds-grp.obj-type
     1482                   , input buf_fbr-gds-grp.obj-code
     1483                   , input buf_fbr-gds-grp.node-code
     1484                   , output v-is-terminal
     1485               ).
     1486               if v-is-terminal = yes
     1487               then do:
     1488                   create temp_fbrglib_found-grp.
     1489                   assign
     1490                       temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1491                                                           chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     1492                       temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1493                                                           chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     1494                       temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
     1495                       temp_fbrglib_found-grp.is-terminal = yes
     1496                       temp_fbrglib_found-grp.obj-type  = p-start-obj-type
     1497                       temp_fbrglib_found-grp.obj-code  = p-start-obj-code
     1498                   .
     1499               end.
     1500               else do:
     1501                   create temp_found-result-nodelist.
     1502                   assign
     1503                       temp_found-result-nodelist.node-code = buf_fbr-gds-grp.node-code
     1504                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1505                                                              chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     1506                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1507                                                              chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     1508                       temp_found-result-nodelist.processed = no
     1509                   .
     1510                   if p-terminal-only = no
     1511                   then do:
     1512                       create temp_fbrglib_found-grp.
     1513                       assign
     1514                           temp_fbrglib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1515                                                               chr(47) + buf_fbr-gds-grp.node-name + chr(47)
     1516                           temp_fbrglib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1517                                                               chr(2) + buf_fbr-gds-grp.node-name + chr(2)
     1518                           temp_fbrglib_found-grp.node-code   = buf_fbr-gds-grp.node-code
     1519                           temp_fbrglib_found-grp.is-terminal = no
     1520                           temp_fbrglib_found-grp.obj-type  = p-start-obj-type
     1521                           temp_fbrglib_found-grp.obj-code  = p-start-obj-code
     1522                       .
     1523                   end.
     1524               end.
     1525           end.
     1526           find first temp_found-result-nodelist
     1527                where temp_found-result-nodelist.processed = no
     1528           no-error.
     1529           if not available temp_found-result-nodelist
     1530           then do:
     1531               leave process-nodes.
     1532           end.
     1533           else do:
     1534               assign
     1535                   p-start-node-code = temp_found-result-nodelist.node-code
     1536                   v-start-full-name = temp_found-result-nodelist.full-name
     1537                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1538               .
     1539           end.
     1540       end.
     1541   end.
     1542   end procedure.
     1543   procedure fbrglib-expand-name :
     1544   do
     1545   on error undo, return error
     1546   :
     1547   define input parameter p-obj-type   as character    no-undo.
     1548   define input parameter p-obj-code   as integer      no-undo.
     1549   define input parameter p-start-name as character    no-undo.
     1550   define output parameter p-end-name  as character    no-undo.
     1551       define variable v-is-terminal     as logical           no-undo.
     1552       define buffer buf_temp_fbrglib_found-grp     for temp_fbrglib_found-grp.
     1553       run fbrglib-find-grp-by-full-name in this-procedure (
     1554             input p-obj-type
     1555           , input p-obj-code
     1556           , input p-start-name
     1557           , input no
     1558       ) no-error.
     1559       run fbrglib-get-max-substring in this-procedure (
     1560              input p-obj-type
     1561           ,  input p-obj-code
     1562           ,  input length( p-start-name )
     1563           , output p-end-name
     1564       ) no-error .
     1565       if error-status :error
     1566       then do:
     1567           assign
     1568               p-end-name = ""
     1569           .
     1570       end.
     1571       else do:
     1572           find first temp_fbrglib_found-grp
     1573                where temp_fbrglib_found-grp.full-name = p-end-name
     1574                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
     1575                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     1576                        no-error.
     1577           if available temp_fbrglib_found-grp
     1578           then do:
     1579               find first buf_temp_fbrglib_found-grp
     1580                    where buf_temp_fbrglib_found-grp.full-name begins p-end-name
     1581                      and recid( buf_temp_fbrglib_found-grp ) <> recid( temp_fbrglib_found-grp )
     1582                   AND temp_fbrglib_found-grp.obj-type  = p-obj-type
     1583                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     1584               no-error.
     1585               if not available buf_temp_fbrglib_found-grp
     1586               then do:
     1587                   run fbrglib-is-terminal in this-procedure (
     1588                         input p-obj-type
     1589                       , input p-obj-code
     1590                       , input temp_fbrglib_found-grp.node-code
     1591                       , output v-is-terminal
     1592                   ).
     1593               end.
     1594           end.
     1595       end.
     1596   end.
     1597   end procedure.
     1598   procedure fbrglib-get-max-substring :
     1599   do
     1600   on error undo, return error
     1601   :
     1602   define input parameter p-obj-type as character no-undo .
     1603   define input parameter p-obj-code as integer no-undo .
     1604   define input parameter p-min-substring-length   as integer      no-undo.
     1605   define output parameter p-substring             as character    no-undo.
     1606           define variable v-char-counter  as integer           no-undo.
     1607           define variable v-current-char  as character         no-undo.
     1608           define variable v-names-counter  as integer           no-undo.
     1609           define variable v-base-string   as character         no-undo.
     1610           assign
     1611               v-char-counter  = p-min-substring-length
     1612           .
     1613           find first temp_fbrglib_found-grp  where
     1614                      temp_fbrglib_found-grp.obj-type  = p-obj-type
     1615                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     1616           no-error.
     1617           if not available temp_fbrglib_found-grp
     1618           then do:
     1619               undo, return error "fbrglib-get-max-substring: Нет строк для вычисления общей подстроки".
     1620           end.
     1621           else do:
     1622               assign
     1623                   v-base-string = temp_fbrglib_found-grp.full-name
     1624               .
     1625               counter-block:
     1626               do while yes
     1627               on error undo, return error "fbrglib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1628               :
     1629                   assign
     1630                       v-char-counter  = v-char-counter + 1
     1631                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1632                       v-names-counter = 0
     1633                   .
     1634                   compare-block:
     1635                   for each temp_fbrglib_found-grp
     1636                   where temp_fbrglib_found-grp.obj-type  = p-obj-type
     1637                   AND temp_fbrglib_found-grp.obj-code  = p-obj-code
     1638                   :
     1639                       assign
     1640                           v-names-counter = v-names-counter + 1
     1641                       .
     1642                       if v-names-counter = 1
     1643                       then do:
     1644                           next compare-block.
     1645                       end.
     1646                       if substring( temp_fbrglib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1647                       then do:
     1648                           leave counter-block.
     1649                       end.
     1650                   end.
     1651                   if v-names-counter = 1
     1652                   then do:
     1653                       assign
     1654                           p-substring = v-base-string
     1655                       .
     1656                       return.
     1657                   end.
     1658               end.
     1659               assign
     1660                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1661               .
     1662           end.
     1663   end.
     1664   end procedure.
     1665   procedure fbrglib-is-terminal :
     1666   do
     1667   on error undo, return error "Ошибка процедуры fbrglib-is-terminal"
     1668   :
     1669   define input parameter p-obj-type       as character    no-undo.
     1670   define input parameter p-obj-code       as integer      no-undo.
     1671   define input parameter p-node-code      as integer      no-undo.
     1672   define output parameter p-is-terminal   as logical      no-undo.
     1673       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1674       find first buf_fbr-gds-grp no-lock
     1675            where buf_fbr-gds-grp.obj-type   = p-obj-type
     1676              and buf_fbr-gds-grp.obj-code   = p-obj-code
     1677              and buf_fbr-gds-grp.upper-code = p-node-code
     1678       no-error .
     1679       if not available buf_fbr-gds-grp
     1680       then do:
     1681           assign
     1682               p-is-terminal = yes
     1683           .
     1684       end.
     1685       else do:
     1686           assign
     1687               p-is-terminal = no
     1688           .
     1689       end.
     1690   end.
     1691   end procedure.
     1692   procedure fbrglib-have-goods :
     1693   do
     1694   on error undo, return error
     1695   :
     1696   define input parameter p-obj-type           as character    no-undo.
     1697   define input parameter p-obj-code           as integer      no-undo.
     1698   define input parameter p-node-code          as integer      no-undo.
     1699   define output parameter p-have-fbr-gds-obj  as logical      no-undo.
     1700       define buffer buf_fbr-gds-obj         for ub.fbr-gds-obj.
     1701       find first buf_fbr-gds-obj no-lock
     1702            where buf_fbr-gds-obj.obj-type     = p-obj-type
     1703              and buf_fbr-gds-obj.obj-code     = p-obj-code
     1704              and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     1705       no-error .
     1706       if available buf_fbr-gds-obj
     1707       then do:
     1708           assign
     1709               p-have-fbr-gds-obj = yes
     1710           .
     1711       end.
     1712       else do:
     1713           assign
     1714               p-have-fbr-gds-obj = no
     1715           .
     1716       end.
     1717   end.
     1718   end procedure.
     1719   procedure fbrglib-find-by-substring :
     1720   do
     1721   on error undo, return error
     1722   :
     1723   define input parameter p-start-obj-type     as character    no-undo.
     1724   define input parameter p-start-obj-code     as integer      no-undo.
     1725   define input parameter p-start-code         as integer      no-undo.
     1726   define input parameter p-full-search-string as character    no-undo.
     1727   define output parameter p-found-code        as integer      no-undo.
     1728   define output parameter p-full-name         as character    no-undo.
     1729       define variable v-start-code     as integer           no-undo.
     1730       define variable v-found          as logical  init no  no-undo.
     1731       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1732       search-grp:
     1733       for each buf_fbr-gds-grp no-lock
     1734           where buf_fbr-gds-grp.obj-type  = p-start-obj-type
     1735             and buf_fbr-gds-grp.obj-code  = p-start-obj-code
     1736             and buf_fbr-gds-grp.node-code > p-start-code
     1737       :
     1738           if index( buf_fbr-gds-grp.node-name, p-full-search-string ) <> 0
     1739           then do:
     1740               assign
     1741                   p-found-code = buf_fbr-gds-grp.node-code
     1742                   v-found      = yes
     1743               .
     1744               run fbrglib-get-full-name in this-procedure (
     1745                     input p-start-obj-type
     1746                   , input p-start-obj-code
     1747                   , input p-found-code
     1748                   , output p-full-name
     1749               ) no-error .
     1750               if error-status :error
     1751               then do:
     1752                   undo, return error "fbrglib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1753               end.
     1754               leave search-grp.
     1755           end.
     1756       end.
     1757       if v-found = yes
     1758       then do:
     1759       end.
     1760       else do:
     1761           assign
     1762               p-full-name  = ""
     1763               p-found-code = 0
     1764           .
     1765       end.
     1766   end.
     1767   end procedure.
     1768   procedure fbrglib-analyze-grp-name :
     1769   do
     1770   on error undo, return error
     1771   :
     1772   define input parameter p-grp-name       as character            no-undo.
     1773   define input parameter p-obj-type       as character            no-undo.
     1774   define input parameter p-obj-code       as integer              no-undo.
     1775   define input parameter p-upper-code     as integer              no-undo.
     1776   define output parameter p-error-message as character init ""    no-undo.
     1777       define variable v-char-list     as character    no-undo.
     1778       define variable v-char-counter  as integer      no-undo.
     1779       define variable v-full-name     as character    no-undo.
     1780       if p-grp-name = "" then do:
     1781           assign
     1782               p-error-message = "Название группы не может быть пустым.".
     1783           .
     1784       end.
     1785       else do:
     1786           assign
     1787               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1788           .
     1789           do v-char-counter = 1 to num-entries( v-char-list )
     1790           :
     1791               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1792               then do:
     1793                   assign
     1794                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1795                   .
     1796                   return.
     1797               end.
     1798           end.
     1799           run fbrglib-get-full-name in this-procedure (
     1800                 input p-obj-type
     1801               , input p-obj-code
     1802               , input p-upper-code
     1803               , output v-full-name
     1804           ) no-error .
     1805           if error-status :error
     1806           then do:
     1807               undo, return error "fbrglib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1808           end.
     1809           if length( v-full-name ) + 1 + length( p-grp-name ) > 120
     1810           then do:
     1811               assign
     1812                   p-error-message = 'Полное название группы не может содержать более 120 символов.'
     1813               .
     1814           end.
     1815       end.
     1816   end.
     1817   end procedure.
     1818   procedure fbrglib-delete-grp :
     1819   do
     1820   on error undo, return error
     1821   :
     1822   define input parameter p-obj-type   as character    no-undo.
     1823   define input parameter p-obj-code   as integer      no-undo.
     1824   define input parameter p-node-code  as integer      no-undo.
     1825   define output parameter p-deleted   as logical      no-undo.
     1826       define variable v-have-goods    as logical        no-undo.
     1827       define variable v-yesno         as logical        no-undo.
     1828       define variable v-upper-code    as integer        no-undo.
     1829       define variable v-root-code     as integer        no-undo.
     1830       define buffer buf_fbr-gds-grp           for ub.fbr-gds-grp.
     1831       define buffer buf_fbr-gds-obj           for ub.fbr-gds-obj.
     1832       define buffer buf_second_fbr-gds-grp    for ub.fbr-gds-grp.
     1833       run fbrglib-get-root-code in this-procedure (
     1834           output v-root-code
     1835       ) no-error.
     1836       if error-status :error
     1837       then do:
     1838           undo, return error "Не найден корневой узел." + chr(10) + return-value.
     1839       end.
     1840       if p-node-code = v-root-code
     1841       then do:
     1842           message
     1843               "Корневую группу удалить невозможно."
     1844           view-as alert-box error.
     1845           assign
     1846               p-deleted = no
     1847           .
     1848           undo, return.
     1849       end.
     1850       find first buf_fbr-gds-grp no-lock
     1851            where buf_fbr-gds-grp.obj-type     = p-obj-type
     1852              and buf_fbr-gds-grp.obj-code     = p-obj-code
     1853              and buf_fbr-gds-grp.upper-code   = p-node-code
     1854       no-error.
     1855       if available buf_fbr-gds-grp
     1856       then do:
     1857           message
     1858               "Не терминальную группу удалить невозможно."
     1859           view-as alert-box error.
     1860           assign
     1861               p-deleted = no
     1862           .
     1863           undo, return.
     1864       end.
     1865       find first buf_fbr-gds-grp no-lock
     1866            where buf_fbr-gds-grp.obj-type     = p-obj-type
     1867              and buf_fbr-gds-grp.obj-code     = p-obj-code
     1868              and buf_fbr-gds-grp.node-code    = p-node-code
     1869       .
     1870       assign
     1871           v-upper-code = buf_fbr-gds-grp.upper-code
     1872       .
     1873       run fbrglib-have-goods in this-procedure (
     1874             input p-obj-type
     1875           , input p-obj-code
     1876           , input p-node-code
     1877           , output v-have-goods
     1878       ).
     1879       if v-have-goods = yes
     1880       then do:
     1881           find first buf_second_fbr-gds-grp no-lock
     1882                where buf_second_fbr-gds-grp.obj-type      = buf_fbr-gds-grp.obj-type
     1883                  and buf_second_fbr-gds-grp.obj-code      = buf_fbr-gds-grp.obj-code
     1884                  and buf_second_fbr-gds-grp.upper-code    = buf_fbr-gds-grp.upper-code
     1885                  and recid( buf_second_fbr-gds-grp )      <> recid( buf_fbr-gds-grp )
     1886           no-error.
     1887           if available buf_second_fbr-gds-grp
     1888           then do:
     1889               message
     1890                   "В группе есть товары,"
     1891                   skip "которые нельзя перенести в родительскую группу,"
     1892                   skip "потому что у родительской группы есть еще одна подгруппа."
     1893                   skip(1)
     1894                   skip "Перенесите товары в другую группу"
     1895                   skip "или удалите все остальные подгруппы родительской группы."
     1896               view-as alert-box error.
     1897               assign
     1898                   p-deleted = no
     1899               .
     1900               undo, return.
     1901           end.
     1902           message
     1903               "В группе есть товары."
     1904               skip "После удаления группы"
     1905               skip "все ее товары будут привязаны"
     1906               skip "к ее родительской группе."
     1907               skip(1)
     1908               skip "Удалить группу?"
     1909           view-as alert-box warning
     1910           buttons yes-no
     1911           title "Удаление группы"
     1912           update v-yesno
     1913           .
     1914           if v-yesno = yes
     1915           then do:
     1916               do transaction
     1917               on error undo, return error
     1918               :
     1919                   for each buf_fbr-gds-obj exclusive-lock
     1920                      where buf_fbr-gds-obj.obj-type     = p-obj-type
     1921                        and buf_fbr-gds-obj.obj-code     = p-obj-code
     1922                        and buf_fbr-gds-obj.fbr-grp-code = p-node-code
     1923                   on error undo, return error
     1924                   :
     1925                       assign
     1926                           buf_fbr-gds-obj.fbr-grp-code = v-upper-code
     1927                       .
     1928                   end.
     1929               end.
     1930               do transaction
     1931               on error undo, return error
     1932               :
     1933                   find current buf_fbr-gds-grp exclusive-lock .
     1934                   delete buf_fbr-gds-grp no-error .
     1935                   if error-status:error then do:
     1936                     undo, return error return-value .
     1937                   end.
     1938               end.
     1939           end.
     1940       end.
     1941       else do:
     1942           message
     1943               "Имя группы: " buf_fbr-gds-grp.node-name
     1944               "Код группы: " buf_fbr-gds-grp.node-code
     1945               skip(1)
     1946               skip "Удалить группу?"
     1947           view-as alert-box warning
     1948           buttons yes-no
     1949           title "Удаление группы"
     1950           update v-yesno
     1951           .
     1952           if v-yesno = yes
     1953           then do:
     1954               do transaction
     1955               on error undo, return error
     1956               :
     1957                   find current buf_fbr-gds-grp exclusive-lock .
     1958                   delete buf_fbr-gds-grp no-error.
     1959                   if error-status:error then do:
     1960                     undo, return error return-value .
     1961                   end.
     1962               end.
     1963           end.
     1964       end.
     1965   end.
     1966   end procedure.
     1967   procedure fbrglib-add-grp :
     1968   do
     1969   on error undo, return error
     1970   :
     1971   define input parameter p-obj-type       as character    no-undo.
     1972   define input parameter p-obj-code       as integer      no-undo.
     1973   define input parameter p-node-code      as integer      no-undo.
     1974   define input parameter p-interface      as logical      no-undo.
     1975   define input parameter p-node-name      as character    no-undo.
     1976   define input parameter p-out-code       as integer      no-undo.
     1977   define input parameter p-global-code    as integer      no-undo.
     1978   define output parameter p-new-node-code as integer      no-undo.
     1979   define output parameter p-cancel        as logical      no-undo.
     1980       define variable v-have-goods    as logical  no-undo.
     1981       define variable v-host-code     as integer        no-undo.
     1982       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
     1983       define buffer bf_fbr-gds-grp        for ub.fbr-gds-grp.
     1984       define buffer buf_fbr-gds-obj       for ub.fbr-gds-obj.
     1985       run fbrglib-have-goods in this-procedure (
     1986             input p-obj-type
     1987           , input p-obj-code
     1988           , input p-node-code
     1989           , output v-have-goods
     1990       ) no-error .
     1991       if error-status :error
     1992       then do:
     1993           message
     1994                    vss-workfile vss-revision vss-description
     1995               skip "Ошибка определения наличия товаров в группе."
     1996               skip return-value
     1997               skip trim(error-status :get-message(1))
     1998                    trim(error-status :get-message(2))
     1999                    trim(error-status :get-message(3))
     2000           view-as alert-box error.
     2001           undo, return error .
     2002       end.
     2003   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2004   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2005     (input  p-obj-type
     2006     ,input  p-obj-code
     2007     ,output v-host-code
     2008     )  .
     2009       find first buf_fbr-gds-grp no-lock where
     2010                 buf_fbr-gds-grp.upper-code = p-node-code
     2011             AND buf_fbr-gds-grp.obj-type   = p-obj-type
     2012             AND buf_fbr-gds-grp.obj-code   = p-obj-code
     2013             AND buf_fbr-gds-grp.node-name  = p-node-name no-error .
     2014       if available buf_fbr-gds-grp then do:
     2015           if p-node-code <> 1 then do:
     2016             find first buf_fbr-gds-grp no-lock where
     2017                       buf_fbr-gds-grp.node-code = p-node-code
     2018                   AND buf_fbr-gds-grp.obj-type   = p-obj-type
     2019                   AND buf_fbr-gds-grp.obj-code   = p-obj-code  .
     2020           end.
     2021                   message
     2022           "Для объекта" p-obj-type p-obj-code
     2023           "уже есть группа блюд" p-node-name "в подгруппе" (if p-node-code = 1 then "БЛЮДА" else buf_Fbr-gds-grp.node-name)
     2024           view-as alert-box error .
     2025           undo, return error .
     2026       end.
     2027       do transaction
     2028       on error undo, return error
     2029       :
     2030           create buf_fbr-gds-grp.
     2031           assign
     2032               buf_fbr-gds-grp.node-code   = next-value( s-gds-grp, ub )
     2033               p-new-node-code             = buf_fbr-gds-grp.node-code
     2034               buf_fbr-gds-grp.upper-code  = p-node-code
     2035               buf_fbr-gds-grp.host-code   = v-host-code
     2036               buf_fbr-gds-grp.obj-type    = p-obj-type
     2037               buf_fbr-gds-grp.obj-code    = p-obj-code
     2038               buf_fbr-gds-grp.node-name    = ""
     2039               buf_fbr-gds-grp.out-code    = 0
     2040           .
     2041           if p-interface then do:
     2042             run ref/fbrggrpd.w (
     2043                   input parparentproc
     2044                 , input 'ИЗМЕНЕНИЕ':U
     2045                 , input p-obj-type
     2046                 , input p-obj-code
     2047                 , input buf_fbr-gds-grp.node-code
     2048                 , input buf_fbr-gds-grp.upper-code
     2049                 , input buf_fbr-gds-grp.node-name
     2050                 , input buf_fbr-gds-grp.out-code
     2051                 , output buf_fbr-gds-grp.node-name
     2052                 , output buf_fbr-gds-grp.out-code
     2053                 , output p-cancel
     2054             ).
     2055             if p-cancel = yes
     2056             then do:
     2057                 delete buf_fbr-gds-grp.
     2058                 undo, return.
     2059             end.
     2060           end.
     2061           else do:
     2062             find first bf_fbr-gds-grp no-lock
     2063                 where bf_fbr-gds-grp.obj-type   = p-obj-type
     2064                   and bf_fbr-gds-grp.obj-code   = p-obj-code
     2065                   and bf_fbr-gds-grp.out-code   = p-out-code
     2066             no-error.
     2067             assign
     2068             buf_fbr-gds-grp.node-name    = p-node-name
     2069             buf_fbr-gds-grp.global-code  = p-global-code
     2070             buf_fbr-gds-grp.out-code     = (if available bf_fbr-gds-grp then 0 else p-out-code)
     2071             .
     2072           end.
     2073           if v-have-goods = yes
     2074           then do:
     2075               for each buf_fbr-gds-obj exclusive-lock
     2076                  where buf_fbr-gds-obj.obj-type      = p-obj-type
     2077                    and buf_fbr-gds-obj.obj-code      = p-obj-code
     2078                    and buf_fbr-gds-obj.fbr-grp-code  = p-node-code
     2079               on error undo, return error
     2080               :
     2081                   assign
     2082                       buf_fbr-gds-obj.fbr-grp-code = p-new-node-code
     2083                   .
     2084               end.
     2085           end.
     2086       end.
     2087   end.
     2088   end procedure.
     2089   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2090   define new global shared variable g#attr-lib  as handle no-undo .
     2091   define variable v-attr-lib-variable as handle no-undo .
     2092   procedure gdsoattr-name :
     2093     define input  parameter p-code           as character no-undo .
     2094     define output parameter p-type           as character no-undo .
     2095     define output parameter p-format         as character no-undo .
     2096     define output parameter p-label          as character no-undo .
     2097     define output parameter p-user-can-edit  as logical   no-undo .
     2098     define output parameter p-output-display as logical   no-undo .
     2099     define output parameter p-other          as character no-undo .
     2100     do
     2101     on error undo, return error
     2102     :
     2103           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsoattr-name in g#attr-lib
     2104         (input  p-code
     2105         ,output p-type
     2106         ,output p-format
     2107         ,output p-label
     2108         ,output p-user-can-edit
