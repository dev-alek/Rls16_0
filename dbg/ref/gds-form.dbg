     5025   DEFINE FRAME d-gds-form
     5026        goods.PS at row 16.83 col 56 NO-LABEL
     5027             VIEW-AS EDITOR SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
     5028             size 43.38 by 2.33
     5029             BGCOLOR 15 FGCOLOR 0
     5030        Impmes AT ROW 2 COL 12 COLON-ALIGNED NO-LABEL
     5031        Infmes at row 19.33 col 10 COLON-ALIGNED NO-LABEL
     5032        RECT-1 at row 10.96 col 1.38
     5033        RECT-2 at row 10.96 col 27.13
     5034        RECT-3 at row 10.96 col 46.25
     5035        RECT-4 at row 10.96 col 73.5
     5036        label-min-rate at row 11.13 col 27.88
     5037        NO-LABEL
     5038        label-max-rate at row 13 col 27.88
     5039        NO-LABEL
     5040        "Прим." VIEW-AS TEXT
     5041             size 5 by 0.75 at row 16 col 56
     5042             BGCOLOR 8 FGCOLOR 0
     5043        "Группа блюд" VIEW-AS TEXT
     5044             size 11.25 by 0.75 at row 15 col 56
     5045             BGCOLOR 8 FGCOLOR 0
     5046       r-fbr-grp at row 15 col 67.25
     5047       f-fbr-grp-name at row 15 col 70.25 NO-LABEL
     5048       b-gdsfrmfi at row 20.5 col 1.13
     5049       SKIP(0.25)
     5050       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     5051            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     5052            TITLE "".
     5053   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5054   define temp-table tt-widget  no-undo like ub.custom-labels
     5055   field wh as widget-handle
     5056   field whl as widget-handle
     5057   .
     5058   PROCEDURE gdsfrmfi-to:
     5059   DEFINE INPUT PARAMETER v-gdsfrmfi as char no-undo.
     5060   DEFINE INPUT PARAMETER loc-mode as logical no-undo.
     5061   DEFINE OUTPUT PARAMETER v-dop-inf as char no-undo.
     5062   DEFINE VARiable II AS INTEGER NO-UNDO.
     5063   DEFINE VARiable jj as integer no-undo init 1.
     5064   define variable startrow as decimal no-undo init 19.5.
     5065   define variable startcolumn as decimal no-undo init 5.
     5066   define variable col-size as decimal no-undo init 50.
     5067   define buffer buf_custom-labels for ub.custom-labels.
     5068   define buffer buf_widget for tt-widget.
     5069   IF v-gdsfrmfi = "" then do:
     5070     return.
     5071   end.
     5072   create widget-pool "gdsfrmfi" persistent no-error.
     5073   wph = yes.
     5074   if error-status:error then return.
     5075   for each buf_widget:
     5076     delete buf_widget.
     5077   end.
     5078   DO ii = 1 to NUm-ENTRIES(v-gdsfrmfi):
     5079     find first buf_custom-labels no-lock where
     5080             buf_custom-labels.language = "rus"
     5081         and buf_custom-labels.call-type = 'add-fields':U
     5082         and buf_custom-labels.call-point = 'gdsfrmfi':U
     5083         and buf_custom-labels.tbl-name = entry(1, entry(ii, v-gdsfrmfi), ".")
     5084         and buf_custom-labels.fld-name = entry(2, entry(ii, v-gdsfrmfi), ".") no-error .
     5085     if available buf_custom-labels then do:
     5086       create buf_widget.
     5087       buffer-copy buf_custom-labels to buf_widget
     5088       .
     5089       create TEXT buf_widget.whl in widget-pool "gdsfrmfi"
     5090       assign
     5091       frame = frame d-gds-form:handle
     5092       DATA-TYPE = 'character':U
     5093       FORMAT = substitute("X(&1)", length(buf_widget.custom-label))
     5094       screen-value = buf_widget.custom-label
     5095       row = startrow + round(jj / 2, 0)
     5096       column = startcolumn + (if jj mod 2 = 0 then col-size else 1)
     5097       height-chars = 1
     5098       visible = true
     5099       .
     5100       view buf_widget.whl.
     5101       case buf_widget.widget-type:
     5102          when  "fill-in" then do:
     5103             create fill-in buf_widget.wh in widget-pool "gdsfrmfi"
     5104             assign
     5105             frame = frame d-gds-form:handle
     5106             side-label-handle = buf_widget.whl
     5107             DATA-TYPE = buf_widget.fld-data-type
     5108             FORMAT = buf_widget.CUSTOM-FORMAT
     5109             row = startrow + ROUND(jj / 2, 0)
     5110             column = buf_widget.whl:column + buf_widget.whl:width-chars + 1
     5111             height-chars = 1
     5112             width-chars = minimum(buf_widget.widget-width, ((frame d-gds-form:width-chars )) - (buf_widget.whl:column + buf_widget.whl:width-chars + 1))
     5113             sensitive = loc-mode
     5114             visible = true
     5115             tooltip = buf_widget.custom-tooltip
     5116             .
     5117          end.
     5118          when "combo-box" then do:
     5119             create combo-box buf_widget.wh in widget-pool "gdsfrmfi"
     5120             assign
     5121             frame = frame d-gds-form:handle
     5122             side-label-handle = buf_widget.whl
     5123             DATA-TYPE = buf_widget.fld-data-type
     5124             FORMAT = buf_widget.CUSTOM-FORMAT
     5125             row = startrow + ROUND(jj / 2, 0)
     5126             column = buf_widget.whl:column + buf_widget.whl:width-chars + 1
     5127             delimiter = chr(10)
     5128             list-items = buf_widget.widget-list-items
     5129             inner-lines = num-entries(buf_widget.widget-list-items, chr(10))
     5130             subtype = "DROP-DOWN-LIST"
     5131             width-chars = minimum(buf_widget.widget-width, ((frame d-gds-form:width-chars )) - (buf_widget.whl:column + buf_widget.whl:width-chars + 1))
     5132             sensitive = loc-mode
     5133             visible = true
     5134             tooltip = buf_widget.custom-tooltip
     5135             .
     5136          end.
     5137       end case.
     5138       jj = jj + 1.
     5139       release buf_widget.
     5140       if jj = 5 then LEAVE.
     5141     end.
     5142   END.
     5143   END PROCEDURE.
     5144   PROCEDURE gdsfrmfi-description:
     5145   define variable v-ok as logical no-undo .
     5146   run ref/cstmlabs.w ( input parparentproc
     5147                        ,input 'add-fields':U
     5148                        ,input 'gdsfrmfi':U
     5149                        ,input no
     5150                        ,input 4
     5151                        ,output v-ok
     5152                        ) no-error.
     5153   if v-ok then do:
     5154     message
     5155     "Изменения вступят в силу при следующем входе в карточку товара"
     5156     view-as alert-box warning.
     5157   end.
     5158   END PROCEDURE.
     5159   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5160   PROCEDURE get-fields:
     5161   define buffer buf_widget for tt-widget.
     5162   for each buf_widget:
     5163     if buf_widget.tbl-name = 'goods':U then do:
     5164       buf_widget.wh:screen-value = string(buffer temp-goods:buffer-field(buf_widget.fld-name):buffer-value, buf_widget.custom-format).
     5165     end.
     5166   end.
     5167   END PROCEDURE.
     5168   PROCEDURE set-fields:
     5169   define buffer buf_widget for tt-widget.
     5170   for each buf_widget:
     5171     if buf_widget.tbl-name = 'goods':U then do:
     5172       buffer temp-goods:buffer-field(buf_widget.fld-name):buffer-value = buf_widget.wh:input-value.
     5173     end.
     5174   end.
     5175   END PROCEDURE.
     5176   ASSIGN
     5177          FRAME d-gds-form:SCROLLABLE       = FALSE.
     5178   ASSIGN b-altcd:POPUP-MENU IN FRAME d-gds-form = MENU m-altcd:HANDLE.
     5179   ASSIGN b-altcd:MENU-MOUSE = 1.
     5180   ASSIGN add-inf:POPUP-MENU IN FRAME d-gds-form = MENU m-dopinf:HANDLE.
     5181   ASSIGN add-inf:MENU-MOUSE = 1.
     5182   ASSIGN b-prodbc:POPUP-MENU IN FRAME d-gds-form = MENU m-prodbc:HANDLE.
     5183   ASSIGN b-prodbc:MENU-MOUSE = 1.
     5184   ASSIGN b-price:POPUP-MENU IN FRAME d-gds-form = MENU m-price:HANDLE.
     5185   ASSIGN b-price:MENU-MOUSE = 1.
     5186   ON CHOOSE OF add-inf IN FRAME d-gds-form
     5187   DO:
     5188     if dopinf-option = "" then do:
     5189       run gbl/pop-up.p ( input self:handle
     5190                         ,input no) no-error.
     5191       if error-status:error then return no-apply.
     5192     end.
     5193    if dopinf-option = "" then return no-apply.
     5194    run proc-b-add-inf(input-output dopinf-option) no-error.
     5195    if error-status:error then return no-apply.
     5196   END.
     5197   ON VALUE-CHANGED OF ArtBar IN FRAME d-gds-form
     5198   do:
     5199       assign ArtBar .
     5200       if ArtBAr = vArtBar-Auto then do:
     5201           if nbc = 0 then do:
     5202           end.
     5203       end.
     5204       run val-chg-ArtBar.
     5205   end.
     5206   ON VALUE-CHANGED OF goods.calc-method IN FRAME d-gds-form
     5207   do:
     5208     if goods.calc-method:sensitive and goods.calc-method:visible in frame d-gds-form then do:
     5209       CASE input frame d-gds-form goods.calc-method:screen-value:
     5210         when 'Группа':U then do:
     5211           hide
     5212           label-increase-pc
     5213           goods.increase-pc in frame d-gds-form.
     5214         end.
     5215         otherwise do:
     5216           display
     5217           label-increase-pc
     5218           with frame d-gds-form.
     5219           goods.increase-pc:visible in frame d-gds-form = yes.
     5220         end.
     5221       END CASE.
     5222     end.
     5223   end.
     5224   ON LEAVE OF goods.artic IN FRAME d-gds-form
     5225   DO:
     5226       HIDE Infmes in frame d-gds-form.
     5227   END.
     5228   ON return OF goods.artic IN FRAME d-gds-form
     5229   do:
     5230       if input frame d-gds-form goods.artic = "" then
     5231           do:
     5232               message "Артикул не может быть пустым !".
     5233               apply "entry" to goods.artic in frame d-gds-form.
     5234               return no-apply.
     5235           end.
     5236       apply "entry" to ub.clients.obj-code in frame d-gds-form.
     5237       return no-apply.
     5238   end.
     5239   ON LEAVE OF for-obj-price-base IN FRAME d-gds-form
     5240   do:
     5241       if ( input frame d-gds-form for-obj-price-base <= 0 ) OR
     5242          ( input frame d-gds-form for-obj-price-base = ? ) then .
     5243       else do:
     5244         if v-base-code <> 0 then do:
     5245           if NOT InpSelf then do:
     5246             if avrg-rate = 1 then do:
     5247               FIND LAST ub.curr-accnt WHERE
     5248                                 ub.curr-accnt.curr-code = v-base-code NO-ERROR.
     5249               avrg-rate = ub.curr-accnt.exch-rate * ub.curr-accnt.exch-scale .
     5250               run ref/avrgrate.w ( input "rubl"
     5251                                  , input-output avrg-rate ) .
     5252             end.
     5253             if avrg-rate = 1
     5254               then
     5255             InpSelf = TRUE .
     5256             else do:
     5257               if NOT CostEntered then do:
     5258                 DISPLAY
     5259                 ( input frame d-gds-form for-obj-price-base ) * avrg-rate
     5260                   @ for-obj-price-rubl with frame d-gds-form.
     5261                 CostEntered = TRUE .
     5262               end.
     5263               else do:
     5264                 g#log = no.
     5265                 if  ( input frame d-gds-form for-obj-price-base ) * avrg-rate <>
     5266                     input frame d-gds-form for-obj-price-rubl then do:
     5267                     message "Пересчитать ср.учетную цену в руб.?" view-as alert-box
     5268                     QUESTION buttons YES-NO update g#log.
     5269                     if g#log then
     5270                     DISPLAY
     5271                         ( input frame d-gds-form for-obj-price-base ) * avrg-rate
     5272                                 @ for-obj-price-rubl with frame d-gds-form.
     5273                 end.
     5274               end.
     5275             end.
     5276           end.
     5277         end.
     5278         else
     5279         DISPLAY
     5280         ( input frame d-gds-form for-obj-price-base )
     5281           @ for-obj-price-rubl with frame d-gds-form.
     5282         apply "entry" to for-obj-price-rubl in frame d-gds-form.
     5283       end.
     5284   end.
     5285   ON LEAVE OF for-obj-price-rubl IN FRAME d-gds-form
     5286   do:
     5287       if ( input frame d-gds-form for-obj-price-rubl <= 0 ) OR
     5288          ( input frame d-gds-form for-obj-price-rubl = ? ) then .
     5289       else do:
     5290       if v-base-code <> 0 then do:
     5291         if NOT InpSelf then do:
     5292           if avrg-rate = 1 then do:
     5293             FIND LAST ub.curr-accnt WHERE
     5294                               ub.curr-accnt.curr-code = v-base-code NO-ERROR.
     5295             avrg-rate = ub.curr-accnt.exch-rate * ub.curr-accnt.exch-scale .
     5296             run ref/avrgrate.w ( input "base"
     5297                                , input-output avrg-rate ) .
     5298           end.
     5299           if avrg-rate = 1
     5300           then
     5301           InpSelf = TRUE .
     5302           else do:
     5303             if NOT CostEntered then do:
     5304               DISPLAY
     5305               ( input frame d-gds-form for-obj-price-rubl ) / avrg-rate
     5306                @ for-obj-price-base with frame d-gds-form.
     5307                CostEntered = TRUE .
     5308             end.
     5309             else do:
     5310               g#log = no.
     5311               if ( input frame d-gds-form for-obj-price-rubl ) / avrg-rate <>
     5312                    input frame d-gds-form for-obj-price-base then do:
     5313                 message "Пересчитать ср.учетную цену в вал.?" view-as alert-box
     5314                 QUESTION buttons YES-NO update g#log.
     5315                 if g#log
     5316                   then
     5317                 DISPLAY
     5318                 ( input frame d-gds-form for-obj-price-rubl ) / avrg-rate
     5319                   @ for-obj-price-base with frame d-gds-form.
     5320               end.
     5321             end.
     5322           end.
     5323         end.
     5324       end.
     5325       else
     5326       DISPLAY
     5327       ( input frame d-gds-form for-obj-price-rubl )
     5328         @ for-obj-price-base with frame d-gds-form.
     5329       apply "entry" to for-obj-price-base in frame d-gds-form.
     5330     end.
     5331   end.
     5332   on choose of MENU-ITEM m-dopinf-1 in menu m-dopinf DO:
     5333     dopinf-option = "dop-inf":U.
     5334     run proc-b-add-inf(input-output dopinf-option) no-error.
     5335     if error-status:error then return no-apply.
     5336   end.
