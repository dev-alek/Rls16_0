     5751         HIDE
     5752         ub.goods.min-rate
     5753         ub.goods.max-rate
     5754         ub.goods.qnty-cart
     5755         ub.goods.ms-base
     5756         ub.goods.wt-base
     5757         ub.goods.ms-cart
     5758         ub.goods.wt-cart
     5759         ub.goods.calc-method
     5760         ub.goods.increase-pc
     5761         label-increase-pc
     5762         label-min-rate
     5763         label-max-rate
     5764         RECT-2
     5765         RECT-3
     5766         RECT-4
