     8800                           , input-output temp-goods.attrib
     8801                           , input-output temp-goods.user-rule
     8802                           , input-output temp-goods.sert
     8803                           , input-output temp-goods.struct
     8804                           , input-output temp-goods.deadline
     8805                           , input-output temp-goods.sort
     8806                           , input-output temp-goods.tnved
