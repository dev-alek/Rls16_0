     6136   end.
     6137       run ref/countris.w (  input parparentproc
     6138                         ,input "b-sel":U
     6139                         ,input-output v-rid-list ).
     6140   if v-rid-list = '' then  do:
     6141               apply "entry" to r-alpha1 in frame d-gds-form.
     6142               return no-apply.
     6143           end.
     6144       FIND ub.country WHERE recid (ub.country) = integer(v-rid-list) NO-LOCK.
     6145       DISPLAY ub.country.alpha1 @ ub.goods.alpha1
     6146                       ub.country.short-name @ country_name with frame d-gds-form.
     6147   end.
     6148   ON choose OF r-prod IN FRAME d-gds-form
     6149   do:
