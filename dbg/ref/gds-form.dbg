     6193               apply "entry" to ub.goods.cli-base-rate in frame d-gds-form.
     6194           end.
     6195   end.
     6196   ON choose OF r-fbr-grp IN FRAME d-gds-form
     6197   do:
     6198   define variable v-recid-list as character no-undo .
     6199   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
     6200   find first buf_fbr-gds-grp no-lock where
     6201           buf_fbr-gds-grp.obj-type = "":U
     6202       AND buf_fbr-gds-grp.obj-code = 0
     6203       AND buf_fbr-gds-grp.node-code = fbr-grp-code_ no-error .
     6204       if available buf_fbr-gds-grp then
     6205       assign
     6206       v-recid-list = string(recid(buf_fbr-gds-grp))
     6207       .
     6208       run ref/fbrggrp.w (
     6209             input parparentproc
     6210           , input p-obj-type
     6211           , input p-obj-code
     6212           , input ("buttons-for-rubr-only" + chr(44) + "b-sel" + chr(44) +  'терм':U)
     6213           , input-output v-recid-list
     6214       ).
     6215       if v-recid-list <> ""
     6216       then do:
     6217           find first buf_fbr-gds-grp no-lock
     6218                where recid( buf_fbr-gds-grp )  = integer( entry( 1, v-recid-list ) )
     6219           no-error.
     6220           if not available buf_fbr-gds-grp
     6221           then do:
