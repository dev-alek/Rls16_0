     5693       ,output g#log
     5694       )  .
     5695   end.
     5696     if NOT g#log then return no-apply.
     5697     if mode <> 'ДОБАВЛЕНИЕ':U AND NOT available ub.gds-obj then do:
     5698       FIND FIRST for-gds-obj No-LOCK WHERE
     5699                  for-gds-obj.host-code = v-host-code AND
     5700                  for-gds-obj.artic = ub.goods.artic AND
     5701                  for-gds-obj.prod-type = ub.goods.prod-type AND
     5702                  for-gds-obj.prod-code = ub.goods.prod-code No-ERROR.
     5703       if not avail for-gds-obj then do:
     5704         if goods.gds-type = 'т':U
     5705           then
     5706         message "Еще не было НИ ОДНОГО прихода" skip
     5707                 "данного товара в ТЕКУЩУЮ фирму" skip
     5708                 string( "( " + trim( v-host-name ) + " )." , "x(35)" )
     5709         view-as alert-box INFORMATION .
     5710           else
     5711         message "Для данной УСЛУГИ не определены" skip
     5712                 "учетные цены в ТЕКУЩЕЙ фирме" skip
     5713                 string( "( " + trim( v-host-name ) + " )." , "x(35)" )
     5714         view-as alert-box INFORMATION .
     5715         return no-apply.
     5716       end.
     5717     end.
     5718     if for-obj-price-base:visible then do:
     5719         IF (avail ub.units and lookup('2ед':U, ub.units.type) > 0 ) then
     5720         VIEW
     5721         ub.goods.min-rate
     5722         ub.goods.max-rate
     5723         IN FRAME d-gds-form.
     5724         VIEW
     5725         ub.goods.qnty-cart
     5726         ub.goods.ms-base
     5727         ub.goods.wt-base
     5728         ub.goods.ms-cart
     5729         ub.goods.wt-cart
     5730         ub.goods.calc-method
     5731         ub.goods.increase-pc
     5732         label-increase-pc
     5733         label-min-rate
     5734         label-max-rate
     5735         RECT-2
     5736         RECT-3
     5737         RECT-4
     5738         IN frame d-gds-form.
     5739       HIDE
     5740       name-uchet-base
     5741       name-uchet-rubl
     5742       for-obj-price-rubl
     5743       for-obj-last-rubl
