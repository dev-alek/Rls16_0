     9157                        ) no-error.
     9158         if error-status:error then do:
     9159           loc-DOPINF-option = "".
     9160           undo, return error.
     9161         end.
     9162         ASSIGN
     9163         v-update-gds-prop = v-update-gds-prop OR v-updated-now
     9164         .
     9165       END.
     9166       WHEN "ordersf":U then do:
     9167         if not v-flag-gds-prop-entry or true  then do:
     9168           run fill-attr-tables in this-procedure  ('gds-obj-prop':U + 'firm', mode) no-error.
     9169           if error-status:error then do:
     9170             message
     9171             error-status:get-message(1) skip
     9172             return-value
     9173             view-as alert-box error.
     9174             undo, return error .
     9175           end.
     9176         end.
     9177         run ref/ord-ind.w (  input parparentproc
     9178                        ,input mode
     9179                        ,input (if mode = 'ДОБАВЛЕНИЕ':U then 0 else goods.gds-code)
     9180                        ,input v-host-code
     9181                        ,input 'орг':U
     9182                        ,input v-host-code
     9183                        ,input no
     9184                        ,output v-updated-now
     9185                        ,input-output table ttf-gds-obj-prop
     9186                        ,input-output table ttf-gds-obj-prop-attr
     9187                        ) no-error.
     9188         if error-status:error then do:
     9189           loc-DOPINF-option = "".
     9190           undo, return error.
     9191         end.
     9192         ASSIGN
     9193         v-update-gds-prop = v-update-gds-prop OR v-updated-now
     9194         .
     9195       END.
     9196     end case.
     9197     loc-DOPINF-option = "".
     9198   END.
     9199   procedure proc-b-price :
     9200   define input  parameter p-var as integer   no-undo .
     9201   define variable v-fact-order     as decimal no-undo .
     9202   define variable v-plt-id         as integer no-undo .
     9203   define variable v-plt-db-num     as integer no-undo .
     9204   define variable v-pdf-id         as integer no-undo .
     9205   define variable v-pdf-db-num     as integer no-undo .
     9206   define variable v-sale-price-doc as decimal no-undo .
     9207     do
     9208     on error undo, return error return-value
     9209     :
     9210       if p-var = 2 then do:
     9211           run str/chg-sale.w
     9212           ( input  parparentproc ,
     9213             input  p-obj-type    ,
     9214             input  p-obj-code    ,
     9215             buffer goods ).
     9216        end.
     9217        else do:
     9218           run str/chmplgds.w
     9219           ( input  parparentproc ,
     9220             input  goods.gds-code ,
     9221             input  p-obj-type    ,
     9222             input  p-obj-code    ,
     9223             input  v-fact-order  ,
     9224             output v-plt-id      ,
     9225             output v-plt-db-num  ,
     9226             output v-pdf-id      ,
     9227             output v-pdf-db-num  ,
     9228             output v-sale-price-doc ).
     9229       end.
     9230       apply "entry" to b-price in frame d-gds-form.
     9231     end.
     9232   end procedure.
     9233   PROCEDURE proc-b-prodbc :
     9234     DEFINE INPUT-OUTPUT PARAMETER loc-prodbc-option as char no-undo.
     9235     run ref/prod-cds.w (input parparentproc
     9236                     ,input p-obj-type
     9237                     ,input p-obj-code
     9238                     ,input  loc-prodbc-option
     9239                     ,input  goods.gds-code
     9240                     ,input  main-code
     9241                     ,output ref-list ).
     9242     loc-prodbc-option = "".
     9243   END PROCEDURE.
     9244   PROCEDURE proc-b-sert :
     9245     run ref/gds-sert.w ( input parparentproc
     9246                         ,input  p-obj-type
     9247                         ,input p-obj-code
     9248                         ,input mode
     9249                         ,input "gds"
     9250                         ,input goods.gds-code
     9251                         ,input ?
