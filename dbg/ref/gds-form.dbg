     4122     on error undo, return error
     4123     :
     4124           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ggoattr-batch-edit in g#attr-lib
     4125         (input  p-code
     4126         ,output p-section-num
     4127         ) no-error .
     4128       if error-status :error
     4129       then do:
     4130         undo, return error return-value .
     4131       end.
     4132     end.
     4133   end procedure.
     4134   procedure grp-obj-notcorr-value :
     4135   do
     4136   on error undo, return error
     4137   :
     4138   define input parameter p-node-code             as integer      no-undo.
     4139   define input parameter p-obj-type              as character    no-undo.
     4140   define input parameter p-obj-code              as integer      no-undo.
     4141   define output parameter p-notcorr              as character    no-undo init ?.
     4142   define output parameter p-range-notcorr     as integer      no-undo.
     4143   define output parameter p-exists-notcorr    as logical      no-undo.
     4144   define variable v-host-code as integer      no-undo.
     4145   DEFINE VARIABLE v-found as logical no-undo .
     4146   DEFINE VARIABLE v-exists as logical no-undo .
     4147   DEFINE VARIABLE v-range as integer no-undo .
     4148   DEFINE VARIABLE jj as integer no-undo .
     4149   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     4150   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     4151   define buffer buf_gds-grp for ub.gds-grp.
     4152   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     4153   find first buf_gds-grp no-lock where
     4154              buf_gds-grp.node-code = p-node-code no-error .
     4155   if not avail buf_gds-grp and p-node-code <> 0 then do:
     4156     message
     4157       vss-workfile vss-revision vss-description
     4158       skip "Не удалось найти группу товаров с кодом" p-node-code
     4159       view-as alert-box error .
     4160     undo, return error .
     4161   end.
     4162   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4163   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4164     (input  p-obj-type
     4165     ,input  p-obj-code
     4166     ,output v-host-code
     4167     ) no-error .
     4168   if error-status :error
     4169   then do:
     4170       message
     4171         vss-workfile vss-revision vss-description
     4172         skip "Не удалось найти фирму объекта"
     4173         skip p-obj-type p-obj-code
     4174         skip return-value
     4175         skip trim(error-status :get-message(1))
     4176       view-as alert-box error.
     4177       undo, return error .
     4178   end.
     4179   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     4180   do while v-found = no and jj < 2:
     4181     if v-range <> 3 then do:
     4182       find first buf_gds-grp-obj no-lock
     4183           where buf_gds-grp-obj.node-code = p-node-code
     4184             and buf_gds-grp-obj.host-code = v-host-code
     4185             and buf_gds-grp-obj.obj-type  = p-obj-type
     4186             and buf_gds-grp-obj.obj-code  = p-obj-code
     4187       no-error .
     4188     end.
     4189     if v-range = 3 or not available buf_gds-grp-obj
     4190     then do:
     4191        if v-range <> 2 then do:
     4192           find first buf_gds-grp-obj no-lock
     4193               where buf_gds-grp-obj.node-code = p-node-code
     4194                 and buf_gds-grp-obj.host-code = v-host-code
     4195                 and buf_gds-grp-obj.obj-type  = ""
     4196                 and buf_gds-grp-obj.obj-code  = 0
     4197           no-error .
     4198         end.
     4199         if v-range = 2 or not available buf_gds-grp-obj
     4200         then do:
     4201             if v-range <> 1 then do:
     4202               find first buf_gds-grp-obj no-lock
     4203                   where buf_gds-grp-obj.node-code = p-node-code
     4204                   and buf_gds-grp-obj.host-code = 0
     4205                   and buf_gds-grp-obj.obj-type  = ""
     4206                   and buf_gds-grp-obj.obj-code  = 0
     4207               no-error .
     4208             end.
     4209             if v-range = 1 or not available buf_gds-grp-obj
     4210             then do:
     4211                 assign
     4212                     v-exists = no
     4213                 .
     4214             end.
     4215             else do:
     4216                 assign
     4217                     v-exists = yes
     4218                     v-range = 1
     4219                 .
     4220             end.
     4221         end.
     4222         else do:
     4223             assign
     4224                 v-exists = yes
     4225                 v-range  = 2
     4226             .
     4227         end.
     4228     end.
     4229     else do:
     4230         assign
     4231             v-exists = yes
     4232             v-range  = 3
     4233         .
     4234     end.
     4235     if available buf_gds-grp-obj
     4236     then do:
     4237       find first buf_gds-grp-obj-attr no-lock
     4238         where buf_gds-grp-obj-attr.node-code   = p-node-code
     4239           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     4240           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     4241           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     4242           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     4243         no-error .
     4244       if available buf_gds-grp-obj-attr then do:
     4245         assign
     4246           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     4247         .
     4248       end.
     4249       else do:
     4250         assign
     4251           v-notcorr-value = ?
     4252         .
     4253       end.
     4254       assign
     4255       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     4256                           then yes
     4257                           else p-exists-notcorr)
     4258       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     4259                         then v-range
     4260                         else p-range-notcorr
     4261       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     4262                         then v-notcorr-value
     4263                         else p-notcorr
     4264       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     4265       jj = jj + 1
     4266       .
     4267     end.
     4268     else do:
     4269       assign
     4270       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     4271       jj = jj + 1
     4272       .
     4273     end.
     4274   end.
     4275   end.
     4276   end procedure.
     4277   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4278   PROCEDURE verify-ini-entry:
     4279   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     4280   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     4281   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     4282   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     4283   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     4284   define variable v-mess as character no-undo .
     4285   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     4286   if ini-entry-value = ? and ini-key-name begins "spl"
     4287   then
     4288   get-key-value section ini-section-name key "splall" value ini-entry-value.
     4289   if ini-entry-value = ? and ini-key-name begins "sav"
     4290   then
     4291   get-key-value section ini-section-name key "savall" value ini-entry-value.
     4292   if ini-entry-value = ? then do:
     4293     assign
     4294     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     4295                       , chr(10)
     4296                       , ini-section-name
     4297                       , ini-key-name
     4298                       , error-msg-text).
     4299       if not silence then do:
     4300         message
     4301         v-mess
     4302         view-as alert-box ERROR  .
     4303         return error.
     4304       end.
     4305       else do:
     4306         return error v-mess.
     4307       end.
     4308   end.
     4309   END PROCEDURE.
     4310   PROCEDURE verify-file:
     4311   DEFINE INPUT  PARAMETER filename       as character no-undo.
     4312   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     4313   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     4314   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     4315   file-info:file-name = filename.
     4316   found = NOT (file-info:full-pathname = ?).
     4317   if NOT found  then do:
     4318     if not silence then do:
     4319       message error-msg-text
     4320       view-as alert-box ERROR.
     4321       return error.
     4322     end.
     4323     else return error error-msg-text.
     4324   end.
     4325   END PROCEDURE.
