      123   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      124   define new shared temp-table tt-goods no-undo like ub.goods.
      125   define new shared temp-table tt-clients no-undo like ub.clients.
      126     define NEW SHARED temp-table  tt-tax no-undo
      127   field tax-code    like ub.tax.tax-code
      128   FIELD individual  like ub.tax.individual
      129   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
      130   field rate-code   like ub.tax-rate.rate-code
      131   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
      132   FIELD tax-type    like ub.tax.tax-type
      133   field rate-value  like ub.tax-rate-value.rate-value
      134   FIELD tax-rate-gds-rc  as recid
      135   FIELD to-cashdesk like ub.tax.to-cashdesk
      136   FIELD fact-date like ub.tax-rate-value.fact-date
      137   FIELD fact-order like ub.tax-rate-value.fact-order
      138   FIELD next-order like ub.tax-rate-value.fact-order
      139   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
      140   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
      141   FIELD corr-date like ub.tax-rate-gds.corr-date
      142   FIELD corr-time like ub.tax-rate-gds.corr-time
      143   index tax-code is unique primary tax-code fact-order descending rate-code.
      144     define temp-table  output-tax no-undo
      145   field tax-code    like ub.tax.tax-code
      146   FIELD individual  like ub.tax.individual
      147   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
      148   field rate-code   like ub.tax-rate.rate-code
      149   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
      150   FIELD tax-type    like ub.tax.tax-type
      151   field rate-value  like ub.tax-rate-value.rate-value
      152   FIELD tax-rate-gds-rc  as recid
      153   FIELD to-cashdesk like ub.tax.to-cashdesk
      154   FIELD fact-date like ub.tax-rate-value.fact-date
      155   FIELD fact-order like ub.tax-rate-value.fact-order
      156   FIELD next-order like ub.tax-rate-value.fact-order
      157   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
      158   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
      159   FIELD corr-date like ub.tax-rate-gds.corr-date
