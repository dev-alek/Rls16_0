     7724         temp-goods.alpha1 @  ub.goods.alpha1
     7725         (if length(temp-goods.grp-name) > 79 then
     7726             ("..." + substr(temp-goods.grp-name, length(temp-goods.grp-name) - 79)) else
     7727             temp-goods.grp-name) @  grp-full
     7728         ub.gds-prt.node-name
     7729         temp-goods.qnty-cart     @ goods.qnty-cart
     7730         temp-goods.unit-cli      @ goods.unit-cli
     7731         temp-goods.ms-base       @ goods.ms-base
     7732         temp-goods.wt-base       @ goods.wt-base
     7733         temp-goods.ms-cart       @ goods.ms-cart
     7734         temp-goods.wt-cart       @ goods.wt-cart
     7735         temp-goods.cli-base-rate @ goods.cli-base-rate
     7736         temp-goods.increase-pc   @ goods.increase-pc
     7737         if avail country then country.short-name else "" @ country_name
     7738         f-fbr-grp-name
     7739         with frame d-gds-form.
     7740         IF temp-goods.min-rate <> 0 then
     7741         DISPLAY
     7742         temp-goods.min-rate @ goods.min-rate
     7743         with frame d-gds-form.
     7744         IF temp-goods.max-rate <> 0 then
     7745         DISPLAY
     7746         temp-goods.max-rate @ goods.max-rate
     7747         with frame d-gds-form.
     7748       end.
     7749       if FirstIter
     7750         then
     7751       assign
     7752       FirstIter = FALSE
     7753       CostEntered = FALSE
     7754       InpSelf = FALSE
     7755       NegRest = if igoods then var-negative-rest else FALSE .
     7756         else
     7757       assign
     7758       CostEntered = FALSE
     7759       InpSelf = FALSE
     7760       avrg-rate = 1
     7761       .
