     5534     do:
     5535       message "Производитель товара не является производителем алкогольной продукции, установите соответствующий атрибут в справочнике клиентов." VIEW-AS ALERT-BOX .
     5536       return no-apply .
     5537     end.
     5538   end.
     5539       RUN check-update-attr IN THIS-PROCEDURE(no) NO-ERROR.
     5540       RUN check-add in this-procedure ( input 0) no-error.
     5541       if error-status:error and NOT return-value = "next" then return no-apply.
     5542       add-another = yes.
     5543       run ref/add-matr.p ( input parParentProc
     5544                           ,input goods.gds-code) no-error .
     5545         if error-status :error then message
     5546             vss-workfile vss-revision vss-description skip
     5547             error-status :get-message(1) skip
     5548             return-value skip
     5549             "Ошибка добавления в Ассортиментную матрицу - add-matr.p"
