     5679   do:
     5680     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5681       (input  v-cntxt-db-num
     5682       ,input  v-cntxt-userid
     5683       ,input  0
     5684       ,input  'actn_archive_cost':U
     5685       ,input  'object':U
