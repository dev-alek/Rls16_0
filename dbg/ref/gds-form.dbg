      162   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      163   FUNCTION title-mode RETURNS CHARACTER
      164     ( INPUT pmode as character ) :
      165   DEFINE VARIABLE ptitle-mode as character no-undo.
      166   CASE ENTRY(1, pmode) :
      167     when 'ДОБАВЛЕНИЕ':U then ptitle-mode = "ДОБАВЛЕНИЕ".
      168     when 'ИЗМЕНЕНИЕ':U  then ptitle-mode = "ИЗМЕНЕНИЕ".
      169     when 'ПРОСМОТР':U  then ptitle-mode = "ПРОСМОТР".
      170   END CASE.
      171     RETURN ptitle-mode.
      172   END FUNCTION.
      173   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      174   procedure factord :
      175     define input  parameter p-fact-date            as date    no-undo .
      176     define input  parameter p-fact-time            as integer no-undo .
      177     define input  parameter p-fact-num             as integer no-undo .
      178     define input  parameter p-shift-date           as date    no-undo .
      179     define input  parameter p-shift-num            as integer no-undo .
      180     define input  parameter p-shift-on             as logical no-undo .
      181     define output parameter p-fact-order           as decimal no-undo .
      182     define output parameter p-shift-end-fact-order as decimal no-undo .
      183     define output parameter p-day-end-fact-order   as decimal no-undo .
      184     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      185     if p-fact-date = ?
      186     then do:
      187       return error "Не указана фактическая дата" .
      188     end.
      189     define variable v-fact-date-num as integer no-undo .
      190     assign
      191       v-fact-date-num = integer(p-fact-date)
      192     .
      193     if p-fact-num = ?
      194     or p-fact-num = 0
      195     then do:
      196       return error "Не задан p-fact-num " + string(p-fact-num) .
      197     end.
      198     if p-fact-num < 0
      199     then do:
      200       return error "Отрицательный fact-num " + string(p-fact-num) .
      201     end.
      202     if p-fact-num >= 100000000
      203     then do:
      204       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      205     end.
      206     if p-shift-on = true
      207     then do:
      208       if p-shift-date = ?
      209       then do:
      210         return error "Не задана дата смены" .
      211       end.
      212       if p-shift-num = ?
      213       or p-shift-num = 0
      214       then do:
      215         return error "Не задан номер смены" .
      216       end.
      217     end.
      218     else do:
      219       assign
      220         p-shift-date = p-fact-date
      221         p-shift-num  = 24
      222       .
      223     end.
      224     define variable v-shift-offset as integer no-undo .
      225     if p-shift-date = p-fact-date
      226     then do:
      227       assign
      228         v-shift-offset = 1
      229       .
      230     end.
      231     if p-shift-date < p-fact-date
      232     then do:
      233       assign
      234         v-shift-offset = 0
      235       .
      236     end.
      237     if p-shift-date > p-fact-date
      238     then do:
      239       message
      240         vss-workfile vss-revision vss-description skip
      241         "Неправильная дата закрытия смены" skip
      242         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      243         view-as alert-box error .
      244       undo, return error
      245         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      246           ,string(p-fact-date, '99/99/9999':U)
      247           ,string(p-shift-date, '99/99/9999':U)
      248           )
      249       .
      250     end.
      251     if p-shift-num < 1
      252     or p-shift-num > 24
      253     then do:
      254       message
      255         vss-workfile vss-revision vss-description skip
      256         "Неправильный номер смены" skip
      257         "p-shift-num" p-shift-num skip
      258         view-as alert-box error .
      259       undo, return error return-value .
      260     end.
      261     assign
      262       p-fact-order           = v-fact-date-num
      263                              + v-shift-offset * 0.5
      264                              + p-shift-num    * 0.02 - 0.01
      265                              + p-fact-num     * 0.0000000001
      266       p-shift-end-fact-order = v-fact-date-num
      267                              + v-shift-offset * 0.5
      268                              + p-shift-num    * 0.02
      269       p-day-end-fact-order   = v-fact-date-num
      270                              + 0.99
      271     .
      272     if p-fact-order           <= v-fact-date-num
      273     or p-shift-end-fact-order <= v-fact-date-num
      274     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      275     or p-shift-end-fact-order >= p-day-end-fact-order
      276     then do:
      277       message
      278         vss-workfile vss-revision vss-description skip
      279         "Внутренняя ошибка при генерации фактического номера" skip
      280         "p-fact-date"            p-fact-date            skip
      281         "p-fact-time"            p-fact-time            skip
      282         "p-fact-num"             p-fact-num             skip
      283         "p-shift-date"           p-shift-date           skip
      284         "p-shift-num"            p-shift-num            skip
      285         "p-shift-on"             p-shift-on             skip
      286         "p-shift-end-fact-order" p-shift-end-fact-order skip
      287         "p-day-end-fact-order"   p-day-end-fact-order   skip
      288         "v-fact-date-num"        v-fact-date-num        skip
      289         view-as alert-box error .
      290       undo, return error return-value .
      291     end.
      292   end procedure.
      293   procedure day-begin-fact-order :
      294     define input  parameter p-fact-date            as date    no-undo .
      295     define output parameter p-day-begin-fact-order as decimal no-undo .
      296     do
      297     on error undo, return error return-value
      298     :
      299       if p-fact-date = ?
      300       then do:
      301         assign
      302           p-day-begin-fact-order = 0
      303         .
      304       end.
      305       else do:
      306         assign
      307           p-day-begin-fact-order = integer(p-fact-date)
      308         .
      309       end.
      310     end.
      311   end procedure.
      312   procedure factord-max-fact-order :
      313     define output parameter p-max-fact-order as decimal   no-undo .
      314     do
      315     on error undo, return error return-value
      316     :
      317       run day-begin-fact-order in this-procedure
      318         (input  date(1, 1, 5000)
      319         ,output p-max-fact-order
      320         ) .
      321     end.
      322   end procedure.
      323   procedure factord-cut-archive :
      324     define input  parameter p-obj-type             as character no-undo .
      325     define input  parameter p-obj-code             as integer   no-undo .
      326     define input  parameter p-fact-date            as date      no-undo .
      327     define output parameter p-shift-on             as logical   no-undo .
      328     define output parameter p-shift-date           as date      no-undo .
      329     define output parameter p-shift-num            as integer   no-undo .
      330     define output parameter p-day-end-fact-order   as decimal   no-undo .
      331     define output parameter p-shift-end-fact-order as decimal   no-undo .
      332     define variable v-fact-order as decimal   no-undo .
      333     define buffer buf_shift-obj for ub.shift-obj .
      334     do
      335     on error undo, return error return-value
      336     :
      337   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      338   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      339     (input  p-obj-type
      340     ,input  p-obj-code
      341     ,input  'shift-on=request'
      342     ,output p-shift-on
      343     ) no-error .
      344       if error-status :error
      345       then do:
      346         message
      347           vss-workfile vss-revision vss-description skip
      348           "Ошибка при определении атрибута объекта" skip
      349           "Объект" p-obj-type p-obj-code skip
      350           error-status :get-message(1) skip
      351           return-value skip
      352           view-as alert-box error .
      353         undo, return error return-value .
      354       end.
      355       if p-shift-on = false
      356       then do:
      357         assign
      358           p-shift-date               = ?
      359           p-shift-num                = 0
      360         .
      361       end.
      362       else do:
      363         find first buf_shift-obj share-lock
      364           where buf_shift-obj.obj-type   = p-obj-type
      365             and buf_shift-obj.obj-code   = p-obj-code
      366             and buf_shift-obj.shift-date > p-fact-date
      367           use-index pi
      368           no-error .
      369         if not available buf_shift-obj
      370         or buf_shift-obj.status_ <> 'зкр':U
      371         then do:
      372           message
      373             vss-workfile vss-revision vss-description skip
      374             "Невозможно вычислить последнюю смену" skip
      375             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      376             "Объект" p-obj-type p-obj-code skip
      377             "Дата" p-fact-date skip
      378             view-as alert-box error .
      379           undo, return error return-value .
      380         end.
      381         find last buf_shift-obj share-lock
      382           where buf_shift-obj.obj-type = p-obj-type
      383             and buf_shift-obj.obj-code = p-obj-code
      384             and buf_shift-obj.shift-date <= p-fact-date
      385           use-index pi
      386           no-error .
      387         if available buf_shift-obj
      388         then do:
      389           if  buf_shift-obj.status_ = 'зкр':U
      390           then do:
      391             assign
      392               p-shift-date = buf_shift-obj.shift-date
      393               p-shift-num  = buf_shift-obj.shift-num
      394             .
      395           end.
      396           else do:
      397             message
      398               vss-workfile vss-revision vss-description skip
      399               "Невозможно вычислить последнюю смену" skip
      400               "Статус смены отличен от статуса" 'зкр':U skip
      401               "Объект" p-obj-type p-obj-code skip
      402               "Дата" p-fact-date skip
      403               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      404               view-as alert-box error .
      405             undo, return error return-value .
      406           end.
      407         end.
      408         else do:
      409           assign
      410             p-shift-date = p-fact-date - 1
      411             p-shift-num  = 1
      412           .
      413         end.
      414       end.
      415       run factord in this-procedure
      416         (input  p-fact-date
      417         ,input  1
      418         ,input  1
      419         ,input  p-shift-date
      420         ,input  p-shift-num
      421         ,input  p-shift-on
      422         ,output v-fact-order
      423         ,output p-shift-end-fact-order
      424         ,output p-day-end-fact-order
      425         ) no-error .
      426       if error-status :error
      427       then do:
      428         message
      429           vss-workfile vss-revision vss-description skip
      430           "Ошибка при вызове процедуры factord"
      431           error-status :get-message(1) skip
      432           return-value skip
      433           view-as alert-box error .
      434         undo, return error return-value .
      435       end.
      436     end.
      437   end procedure.
      438   procedure factord-lock-shift :
      439     define input  parameter p-obj-type  as character no-undo .
      440     define input  parameter p-obj-code  as integer   no-undo .
      441     define input  parameter p-fact-date as date      no-undo .
      442     define parameter buffer buf_shift-obj for ub.shift-obj .
      443     define variable v-shift-on      as logical   no-undo .
      444     define variable v-extra-message as character no-undo .
      445     define variable v-error as character no-undo .
      446     do
      447     on error undo, return error return-value
      448     :
      449   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      450   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      451     (input  p-obj-type
      452     ,input  p-obj-code
      453     ,input  'shift-on=request'
      454     ,output v-shift-on
      455     ) no-error .
      456       if error-status :error
      457       then do:
      458         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      459         undo, return error v-error .
      460       end.
      461       if v-shift-on = true
      462       then do:
      463         find first buf_shift-obj share-lock
      464           where buf_shift-obj.obj-type   = p-obj-type
      465             and buf_shift-obj.obj-code   = p-obj-code
      466             and buf_shift-obj.shift-date > p-fact-date
      467           use-index pi
      468           no-error .
      469         if not available buf_shift-obj
      470         or buf_shift-obj.status_ <> 'зкр':U
      471         then do:
      472           find last buf_shift-obj
      473             where buf_shift-obj.obj-type = p-obj-type
      474               and buf_shift-obj.obj-code = p-obj-code
      475               and buf_shift-obj.status_  = 'зкр':U
      476             use-index stts
      477             no-error .
      478           if available buf_shift-obj
      479           then do:
      480             assign
      481               v-extra-message =
      482                     substitute("Дата начала последеней закрытой смены на объекте &1"
      483                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      484                               )
      485             .
      486           end.
      487           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      488           undo, return error v-error .
      489         end.
      490       end.
      491     end.
      492   end procedure.
      493   procedure factord-end-day :
      494     define input  parameter p-fact-date            as date    no-undo .
      495     define output parameter p-day-end-fact-order   as decimal no-undo .
      496     do
      497     on error undo, return error return-value
      498     :
      499       if p-fact-date = ?
      500       then do:
      501         return error "Не указана фактическая дата" .
      502       end.
      503       assign
      504         p-day-end-fact-order = integer(p-fact-date) + 0.99
      505       .
      506     end.
      507   end procedure.
      508   procedure factord-to-date :
      509     define input  parameter p-fact-order as decimal no-undo .
      510     define output parameter p-fact-date  as date    no-undo .
      511     define variable v-ref-date  as date      no-undo .
      512     define variable v-ref-delta as integer   no-undo .
      513     do
      514     on error undo, return error return-value
      515     :
      516       if p-fact-order = ?
      517       or p-fact-order = 0
      518       then do:
      519         return error "Не указан fact-order" .
      520       end.
      521       assign
      522         v-ref-date  = date(1, 1, 2000)
      523       .
      524       assign
      525         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      526       .
      527       assign
      528         p-fact-date = v-ref-date + v-ref-delta
      529       .
      530     end.
      531   end procedure.
      532   procedure factord-to-fact-num :
      533     define input  parameter p-fact-order as decimal no-undo .
      534     define output parameter p-fact-num   as integer no-undo .
      535     define variable v-fact-order-trunc as decimal no-undo .
      536     do
      537     on error undo, return error return-value
      538     :
      539       if p-fact-order = ?
      540       or p-fact-order = 0
      541       then do:
      542         return error "Не указан fact-order" .
      543       end.
      544       assign
      545        v-fact-order-trunc = truncate(p-fact-order, 2)
      546       .
      547       assign
      548         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      549       .
      550     end.
      551   end procedure.
      552   procedure factord-to-shift-num :
      553     define input  parameter p-fact-order as decimal no-undo .
      554     define output parameter p-shift-num   as integer no-undo .
      555     define variable  p-shift-numd  as decimal   no-undo .
      556     define variable v-fact-order-trunc as decimal no-undo .
      557     do
      558     on error undo, return error return-value
      559     :
      560       if p-fact-order = ?
      561       or p-fact-order = 0
      562       then do:
      563         return error "Не указан fact-order" .
      564       end.
      565       assign
      566        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      567       .
      568       if v-fact-order-trunc < 0.5 then do:
      569         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      570       end.
      571       assign
      572         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      573         .
      574        assign
      575         p-shift-num = truncate (p-shift-numd , 0)
      576       .
      577     end.
      578   end procedure.
      579   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      580   procedure cur-time :
      581      define output parameter p-today as date      no-undo .
      582      define output parameter p-time  as integer   no-undo .
      583     do
      584     on error undo, return error
      585     :
      586       define variable v-date1 as date      no-undo .
      587       define variable v-date2 as date      no-undo .
      588       define variable v-time  as integer   no-undo .
      589       assign
      590         v-date1 = today
      591         v-time  = time
      592         v-date2 = today
      593       .
      594       if v-date1 <> v-date2
      595       then do:
      596         assign
      597           v-date1 = today
      598           v-time  = v-time
      599         .
      600       end.
      601       assign
      602         p-today = v-date1
      603         p-time  = v-time
      604       .
      605     end.
      606   end.
      607   function cur-time-date returns character
      608   :
      609     return string(today, '99/99/9999':U) .
      610   end.
      611   function cur-time-mjd returns decimal
      612   :
      613     define variable v-date as date      no-undo .
      614     define variable v-time as integer   no-undo .
      615     run cur-time in this-procedure
      616       (output v-date
      617       ,output v-time
      618       ) .
      619     return integer(v-date) - 2400002 + (v-time / 86400) .
      620   end.
      621   function cur-time-get-ending-index returns integer
      622   (input p-number as integer
      623   )
      624   :
      625     if p-number < 0
      626     or p-number = ?
      627     then do:
      628       return 1 .
      629     end.
      630     define variable v-rest as integer   no-undo .
      631     assign
      632       p-number = p-number modulo 100
      633     .
      634     if p-number < 20
      635     then do:
      636       assign
      637         v-rest = p-number
      638       .
      639     end.
      640     else do:
      641       assign
      642         v-rest = p-number modulo 10
      643       .
      644     end.
      645     case v-rest :
      646       when 1
      647       then do:
      648         return 2 .
      649       end.
      650       when 2 or
      651       when 3 or
      652       when 4
      653       then do:
      654         return 3 .
      655       end.
      656       otherwise do:
      657         return 1 .
      658       end.
      659     end case .
      660   end.
      661   procedure cur-time-mjd-to-date :
      662      define input  parameter i-mjd-diff as decimal no-undo.
      663      define output parameter o-Date     as date    no-undo.
      664      define output parameter o-Time     as integer no-undo.
      665      define variable v-day-number as integer   no-undo .
      666      if    i-mjd-diff < 0
      667         or i-mjd-diff = ?
      668      then do:
      669         return "?" .
      670      end.
      671      assign
      672         v-day-number = truncate(i-mjd-diff,0).
      673         o-Date = date(v-day-number + 2400002).
      674         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      675     .
      676   end.
      677   function cur-time-mjd-to-string returns character
      678   (input p-mjd-diff as decimal
      679   )
      680   :
      681     define variable v-day-number as integer   no-undo .
      682     define variable v-seconds    as integer   no-undo .
      683     define variable v-hour       as integer   no-undo .
      684     define variable v-min        as integer   no-undo .
      685     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      686     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      687     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      688     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      689     if p-mjd-diff < 0
      690     or p-mjd-diff = ?
      691     then do:
      692       return "?" .
      693     end.
      694     assign
      695       v-day-number = integer(truncate(p-mjd-diff,0))
      696       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      697     .
      698     if v-seconds > 86400
      699     then do:
      700       assign
      701         v-seconds = 86400 - 1
      702       .
      703     end.
      704     if v-seconds < 0
      705     then do:
      706       assign
      707         v-seconds = 0
      708       .
      709     end.
      710     assign
      711       v-hour = truncate(v-seconds / 3600, 0)
      712     .
      713     assign
      714       v-seconds = v-seconds modulo 3600
      715     .
      716     assign
      717       v-min = truncate(v-seconds / 60, 0)
      718     .
      719     assign
      720       v-seconds = v-seconds modulo 60
      721     .
      722     return
      723         (if v-day-number <> 0
      724           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      725           else ""
      726         )
      727       + (if v-day-number <> 0 or v-hour <> 0
      728           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      729           else ""
      730         )
      731       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      732           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      733           else ""
      734         )
      735       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      736       .
      737   end.
      738   function cur-time-string returns character
      739   :
      740     define variable v-date as date      no-undo .
      741     define variable v-time as integer   no-undo .
      742     run cur-time in this-procedure
      743       (output v-date
      744       ,output v-time
      745       ) .
      746     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      747   end.
      748   function cur-time-string-sec returns character
      749   :
      750     define variable v-date as date      no-undo .
      751     define variable v-time as integer   no-undo .
      752     run cur-time in this-procedure
      753       (output v-date
      754       ,output v-time
      755       ) .
      756     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      757   end.
      758   function cur-time-custom  returns character
      759   (input p-prefix as character
      760   ,input p-date-format as character
      761   ,input p-delimiter as character
      762   ,input p-time-format as character
      763   ,input p-suffix as character
      764   )
      765   :
      766     define variable v-date as date      no-undo .
      767     define variable v-time as integer   no-undo .
      768     run cur-time in this-procedure
      769       (output v-date
      770       ,output v-time
      771       ) .
      772     return
      773       p-prefix
      774       + string(v-date, p-date-format)
      775       + p-delimiter
      776       + string(v-time, p-time-format)
      777       + p-suffix
      778       .
      779   end.
      780   function cur-time-print  returns character
      781   :
      782     define variable v-date as date      no-undo .
      783     define variable v-time as integer   no-undo .
      784     run cur-time in this-procedure
      785       (output v-date
      786       ,output v-time
      787       ) .
      788     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      789   end.
      790   function cur-time-datetime returns datetime
      791   :
      792     define variable v-char as character no-undo .
      793     define variable v-datetime as datetime no-undo .
      794     v-char = cur-time-string().
      795     v-datetime = datetime(v-char).
      796     return  v-datetime.
      797   end.
      798   function cur-time-string-msec returns character
      799   :
      800     define variable v-date as datetime  no-undo .
      801     v-date = now.
      802     return string(v-date) .
      803   end.
      804   define variable vss-include-info7 as character format "X(65)" no-undo
      805   initial "@(#)$Workfile$ $Revision$".
      806   procedure grplib-get-full-name :
      807      define input parameter p-node-code  as integer      no-undo.
      808      define output parameter p-full-name as character    no-undo.
      809      do
      810   on error undo, return error
      811   :
      812       define variable v-upper-code    as integer           no-undo.
      813       define buffer buf_gds-grp       for ub.gds-grp.
      814       define buffer buf_upper_gds-grp for ub.gds-grp.
      815       find first buf_gds-grp no-lock
      816            where buf_gds-grp.node-code = p-node-code
      817       no-error.
      818       if not available buf_gds-grp
      819       then do:
      820           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      821       end.
      822       assign
      823           p-full-name  = ""
      824           v-upper-code = 1
      825       .
      826       do while buf_gds-grp.upper-code <> 0
      827       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      828       :
      829           assign
      830               p-full-name  = buf_gds-grp.node-name
      831                            + (if p-full-name <> "" then chr(47) else "")
      832                            + p-full-name
      833               v-upper-code = buf_gds-grp.upper-code
      834           .
      835           find first buf_gds-grp no-lock
      836                where buf_gds-grp.node-code = v-upper-code
      837           no-error.
      838           if not available buf_gds-grp
      839           then do:
      840               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      841                                   + string( v-upper-code )
      842                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      843           end.
      844       end.
      845       assign
      846       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      847       .
      848   end.
      849   end .
      850   procedure grplib-get-node-from-full-name :
      851   define input parameter p-full-name as character no-undo .
      852   define output parameter p-node-code as integer no-undo .
      853   define variable v-ii as integer no-undo .
      854   define variable v-upper-code as integer no-undo .
      855   define variable v-root-code as integer no-undo .
      856   define variable v-entry as character no-undo .
      857   define buffer buf_gds-grp       for ub.gds-grp.
      858   do
      859   on error undo, return error
      860   :
      861     find first buf_gds-grp no-lock
      862         where buf_gds-grp.upper-code = 0
      863     no-error .
      864     if not available buf_gds-grp
      865     then do:
      866         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      867     end.
      868     else do:
      869       assign
      870       v-root-code = buf_gds-grp.node-code
      871       .
      872     end.
      873     v-upper-code = v-root-code.
      874     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      875       assign
      876       v-entry = entry(v-ii, p-full-name, chr(47)).
      877       if v-entry = '' then leave.
      878       find first buf_gds-grp no-lock where
      879                 buf_gds-grp.node-name = v-entry
      880             and buf_gds-grp.upper-code = v-upper-code
      881             no-error.
      882       if not available buf_gds-grp then do:
      883         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      884       end.
      885       else do:
      886         p-node-code = buf_gds-grp.node-code.
      887         v-upper-code = buf_gds-grp.node-code.
      888       end.
      889     end.
      890   end.
      891   end .
