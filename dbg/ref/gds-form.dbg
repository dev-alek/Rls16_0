     5787         ub.goods.max-rate
     5788         ub.goods.qnty-cart
     5789         ub.goods.ms-base
     5790         ub.goods.wt-base
     5791         ub.goods.ms-cart
     5792         ub.goods.wt-cart
     5793         ub.goods.calc-method
     5794         goods.increase-pc
