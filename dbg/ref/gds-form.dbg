     4102   procedure ggoattr-manual-edit :
     4103     define input  parameter p-code           as character no-undo .
     4104     define output parameter p-section-num    as integer no-undo .
     4105     do
     4106     on error undo, return error
     4107     :
     4108           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ggoattr-manual-edit in g#attr-lib
     4109         (input  p-code
     4110         ,output p-section-num
     4111         ) no-error .
     4112       if error-status :error
     4113       then do:
     4114         undo, return error return-value .
     4115       end.
     4116     end.
     4117   end procedure.
     4118   procedure ggoattr-batch-edit :
     4119     define input  parameter p-code           as character no-undo .
