     9255   PROCEDURE proc-settings:
     9256   define input-output parameter par-artic-disable like ub.sysconf.artic-disable no-undo.
     9257   define input-output parameter par-negative-rest like ub.sysconf.negative-rest no-undo.
     9258   define input-output parameter par-unq-artc as logical no-undo.
     9259   define input-output parameter par-dif-nam1 as logical no-undo.
     9260   define input-output parameter par-dif-nam2 as logical no-undo.
     9261   define input-output parameter par-dif-pdbc as logical no-undo .
     9262   define input-output parameter par-tnvedimp as logical no-undo .
     9263   define input-output parameter par-gds-copy as character no-undo .
     9264   define input-output parameter par-vattaxcd like ub.tax.tax-code no-undo.
     9265   define input-output parameter par-slttaxcd like ub.tax.tax-code no-undo.
     9266   define input-output parameter par-dfltggrp like ub.gds-grp.node-code no-undo.
     9267   define input-output parameter par-gdsfrmfi as character no-undo.
     9268   do
     9269   on error undo, return error
     9270   :
     9271   define variable v-curr-obj-type like ub.clients.obj-type no-undo .
     9272   define variable v-curr-obj-code like ub.clients.obj-code no-undo .
     9273   define variable ii as integer no-undo .
     9274   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9275     run mainmenu_getcntxt in parparentproc
     9276       (output v-cntxt-db-num
     9277       ,output v-cntxt-userid
     9278       ,output v-cntxt-level
     9279       ,output v-cntxt-host-code-obj
     9280       ,output v-cntxt-obj-type
     9281       ,output v-cntxt-obj-code
     9282       ,output v-cntxt-db-num-obj
     9283       ,output v-cntxt-is-admin
     9284       ) .
     9285   if p-obj-type = ?
     9286   or p-obj-code = ? then do:
     9287     assign
     9288     p-obj-type = v-cntxt-obj-type
     9289     p-obj-code = v-cntxt-obj-code
     9290     .
     9291   end.
     9292   if p-obj-type = "":U
     9293   or p-obj-code = 0
     9294   or p-obj-type = ?
     9295   or p-obj-code = ? then do:
     9296     message
     9297     "Текущий объект не установлен" skip
     9298     "Работа с карточкой товара в этом режиме еще не реализована"
     9299     view-as alert-box error .
     9300     undo, return error.
     9301   end.
     9302   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9303   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     9304     (input  p-obj-type
     9305     ,input  p-obj-code
     9306     ,output v-host-code
     9307     ,output v-host-name
     9308     )  .
     9309   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9310   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     9311     (input  v-host-code
     9312     ,output v-base-code
     9313     )  .
     9314   FIND ub.sysconf WHERE
     9315        ub.sysconf.host-code = v-host-code NO-LOCK .
     9316   assign
     9317   par-artic-disable = ub.sysconf.artic-disable
     9318   par-negative-rest = ub.sysconf.negative-rest
     9319   .
     9320   for each thbjattr_thbj-attr:
     9321     delete thbjattr_thbj-attr.
     9322   end.
     9323   run adm/shattri.p (
     9324         input "get":U
     9325       ,input  '':U
     9326       ,input  0
     9327       ,input  'gds-ref':U
     9328       ,input  "":U
     9329       ,output v-value-character
     9330       ,output v-value-date
     9331       ,output v-value-decimal
     9332       ,output v-value-integer
     9333       ,output v-value-logical
     9334       ,output v-param-type
     9335       ,INPUT-OUTPUT table-handle v-tth
     9336       ) no-error .
     9337   IF error-status:error then do:
     9338     delete object v-tth.
     9339     message
     9340     substitute("Ошибка при получении опций работы со справочником товаров:&1&2 &3"
     9341               , chr(10)
     9342               , error-status:get-message(1)
     9343               , return-value )
     9344     view-as alert-box error .
     9345     return error.
     9346   end.
     9347   for each thbjattr_thbj-attr  where
     9348           thbjattr_thbj-attr.obj-type = '':U
     9349       and thbjattr_thbj-attr.obj-code = 0
     9350       and thbjattr_thbj-attr.upper-prop-code = 'gds-ref':U
     9351   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     9352   :
     9353     case thbjattr_thbj-attr.prop-code:
     9354       when 'dif-nam1':U then do:
     9355         par-dif-nam1 = thbjattr_thbj-attr.property-value-logical.
     9356       end.
     9357       when 'dif-nam2':U then do:
     9358         par-dif-nam2 = thbjattr_thbj-attr.property-value-logical.
     9359       end.
     9360       when 'dif-pdbc':U then do:
     9361         par-dif-pdbc = thbjattr_thbj-attr.property-value-logical.
     9362       end.
     9363       when 'gds-copy':U then do:
     9364         par-gds-copy = thbjattr_thbj-attr.property-value-character.
     9365       end.
     9366       when 'tnvedimp':U then do:
     9367         tnvedimp = thbjattr_thbj-attr.property-value-logical.
     9368       end.
     9369     end case.
     9370   end.
     9371   run adm/shattri.p (
     9372         input "get":U
     9373       ,input  p-obj-type
     9374       ,input  p-obj-code
     9375       ,input  'gds-ref_obj':U
     9376       ,input  'dfltggrp':U
     9377       ,output v-value-character
     9378       ,output v-value-date
     9379       ,output v-value-decimal
     9380       ,output par-dfltggrp
     9381       ,output v-value-logical
     9382       ,output v-param-type
     9383       ,INPUT-OUTPUT table-handle v-tth
     9384       ) no-error .
     9385   IF error-status:error then do:
     9386     delete object v-tth.
     9387     message
     9388     substitute("Ошибка при получении опций работы со справочником товаров на объекте &4&5:&1&2 &3"
     9389               , chr(10)
     9390               , error-status:get-message(1)
     9391               , return-value
     9392               , p-obj-type
     9393               , p-obj-code
     9394               )
     9395     view-as alert-box error .
     9396     return error.
     9397   end.
     9398   do ii = 1 to num-entries(par-gds-copy):
     9399     if ii = 1  then
     9400     assign
     9401     v-attr-obj-par = integer(entry(ii, par-gds-copy))
     9402     no-error .
     9403     if ii = 2  then
     9404     assign
     9405     v-attr-host-par = integer(entry(ii, par-gds-copy))
     9406     no-error .
     9407     if ii = 3 then
     9408     assign
     9409     v-fbr-gds-par = integer(entry(ii, par-gds-copy))
     9410     no-error .
     9411     if ii = 4 then
     9412     assign
     9413     v-s-coeff-par = integer(entry(ii, par-gds-copy))
     9414     no-error .
     9415     if ii = 5 then
     9416     assign
     9417     v-gds-prop-par = integer(entry(ii, par-gds-copy))
     9418     no-error .
     9419     if ii = 6 then
     9420     assign
     9421     v-attr-gbl-par = integer(entry(ii, par-gds-copy))
     9422     no-error .
     9423     if ii = 7 then
     9424     assign
     9425     v-add-prop-par = integer(entry(ii, par-gds-copy))
     9426     no-error .
     9427   end.
     9428   assign
     9429   par-vattaxcd = integer('1':U)
     9430   par-slttaxcd = integer('2':U)
     9431   .
     9432   run uf-get in this-procedure (
     9433       input 'gdsfrmfi':U
     9434     ,input  v-cntxt-userid
     9435     ,output v-uf-List_
     9436     ,output v-uf-Naim
     9437     ,output v-uf-print-graft
     9438     ,output v-uf-sort-gr
     9439     ,output v-uf-type-price
     9440     ,output v-uf-type-val
     9441     )  no-error.
     9442   if not error-status :error then do:
     9443     assign
     9444     par-gdsfrmfi = entry(1, v-uf-list_,  chr(4) ) no-error.
     9445   end.
     9446   end.
     9447   END PROCEDURE.
     9448   PROCEDURE proc-b-tax:
     9449   DEFINE VARIABLE locfor-title as character no-undo .
     9450   DEFINE VARIABLE v-today as date no-undo .
     9451   DEFINE VARIABLE v-time as integer no-undo .
     9452   define buffer b_tt-tax for tt-tax.
     9453   DEFINE VARIABLE vtoday-fact-order as decimal no-undo .
     9454   if NOT can-find(first tt-tax No-LOCK ) then do:
     9455     bell.
     9456     return error.
     9457   end.
     9458   FOR EACH output-tax:
     9459     DELETE output-tax.
     9460   END.
     9461   locfor-title =  "Ставки налогов и их значения: " +
     9462                   (if mode = 'ДОБАВЛЕНИЕ':U
     9463                    then frame d-gds-form:title
     9464                    else ( "товар с кодом " + string(goods.gds-code))
     9465                    ).
     9466   run ref/taxgtree.w (
     9467                  input table tt-tax,
     9468                  output table output-tax,
     9469                  input parparentproc,
     9470                  input mode,
     9471                  input "GOODS":U,
     9472                  input (if mode = 'ДОБАВЛЕНИЕ':U
     9473                         then ? else
     9474                         goods.gds-code),
     9475                  input ?,
     9476                  input v-host-code,
     9477                  input p-obj-type,
     9478                  input p-obj-code,
     9479                  input locfor-title) no-error .
     9480   if error-status:error then return error.
     9481   DO on error UNDO, return error:
     9482     FOR EACH tt-tax break by tt-tax.tax-code:
     9483       if first-of(tt-tax.tax-code) then do:
     9484         if tt-tax.individual then next.
     9485         if mode = 'ДОБАВЛЕНИЕ':U and not copymode then v-today = 01/01/1990.
     9486         else do:
     9487           run cur-time in this-procedure(output v-today, output v-time).
     9488         end.
     9489         for each output-tax where
     9490                 output-tax.tax-code = tt-tax.tax-code:
     9491           if output-tax.tax-rate-gds-rc <> ? then do:
     9492             find first b_tt-tax where
     9493                        b_tt-tax.tax-rate-gds-rc = output-tax.tax-rate-gds-rc .
     9494             buffer-copy
     9495             output-tax to b_tt-tax.
     9496           end.
     9497           else if mode = 'ДОБАВЛЕНИЕ':U and not copymode then do:
     9498             run factord-end-day in this-procedure (input 01/01/1990 , output vtoday-fact-order).
     9499             find first b_tt-tax where
     9500                        b_tt-tax.tax-code = output-tax.tax-code AND
     9501                        b_tt-tax.fact-order = vtoday-fact-order NO-ERROR.
     9502             if avail b_tt-tax then
     9503             buffer-copy
     9504             output-tax to b_tt-tax.
     9505           end.
     9506           if output-tax.tax-rate-gds-rc = ? and (output-tax.fact-date > v-today OR
     9507                                                  ( mode = 'ДОБАВЛЕНИЕ':U and copymode AND
     9508                                                    output-tax.fact-date = v-today )
     9509                                                 )
     9510             then do:
     9511             find first b_tt-tax where
     9512                        b_tt-tax.tax-code = output-tax.tax-code and
     9513                        b_tt-tax.fact-order = output-tax.fact-order no-error.
     9514             if not avail b_tt-tax then create b_tt-tax.
     9515             buffer-copy
     9516             output-tax to b_tt-tax.
     9517           end.
     9518         end.
     9519       end.
     9520     END.
     9521   END.
     9522   OPEN QUERY br-tt-tax for each tt-tax NO-LOCK.
     9523   END PROCEDURE.
     9524   PROCEDURE proc-b-chk:
     9525   DEFINE VARIABLE rid-list as character no-undo .
     9526   define variable v-stat as character no-undo init ?.
     9527   define variable v-list as character no-undo init ?.
     9528   define variable v-cond as character no-undo init ?.
     9529   define variable v-grp  as character no-undo .
     9530   define variable v-old-code as integer no-undo .
     9531   define buffer buf_units for ub.units.
     9532   if lookup (mode, 'ИЗМЕНЕНИЕ,ДОБАВЛЕНИЕ':U) > 0 then do:
     9533     if mode = 'ИЗМЕНЕНИЕ':U then do:
     9534       g#log = yes.
     9535       message "Выберите группу, в которую нужно переместить данный товар."
     9536               view-as alert-box question buttons OK-Cancel update g#log.
     9537       if not g#log then do:
     9538         return error.
     9539       end.
     9540     end.
     9541     v-grp = "".
     9542     run ref/gds-grp.w (
     9543                     input parparentproc
     9544                   , input ('терм':U + ',b-sel')
     9545                   , input p-obj-type
     9546                   , input p-obj-code
     9547                   , input-output v-grp).
     9548     if v-grp = "" then do:
     9549       return error.
     9550     end.
     9551     FIND ub.gds-grp WHERE recid (gds-grp) = integer (v-grp) No-ERROR.
     9552     if not avail ub.gds-grp then do:
     9553       return error.
     9554     end.
     9555   define variable vss-include-info39 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9556   do:
     9557     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9558       (input  v-cntxt-db-num
     9559       ,input  v-cntxt-userid
     9560       ,input  0
     9561       ,input  'actn_reference_upd-group':U
     9562       ,input  'global':U
     9563       ,input  0
     9564       ,input  '':U
     9565       ,input  0
     9566       ,input  0
     9567       ,input  ub.gds-grp.node-code
     9568       ,input  0
     9569       ,input  true
     9570       ,output g#log
     9571       )  .
     9572   end.
     9573     if NOT g#log then return error.
     9574      define variable v-value      as character no-undo .
     9575      define variable v-type       as character no-undo .
     9576      define buffer buf-grp for ub.gds-grp.
     9577      define variable v-upper like  ub.gds-grp.node-code.
     9578      find first buf-grp where buf-grp.node-code = ub.gds-grp.node-code no-lock no-error.
     9579         v-value = ''.
     9580         run ggoattr-value(
     9581                   input buf-grp.node-code,
     9582                   input 0,
     9583                   input "",
     9584                   input 0,
     9585                   input 'alchol-grp':U,
     9586                   output v-value,
     9587                   output v-type
     9588                 ) no-error.
     9589           if v-value = '' or v-value = "no" then find first buf-grp where buf-grp.node-code = v-upper no-lock no-error.
     9590           else temp-goods.alc-prod = yes .
     9591           if v-value = "yes" then do:
     9592        define variable v-value-mark as character no-undo .
     9593         find first buf-grp where buf-grp.node-code = ub.gds-grp.node-code no-lock no-error.
     9594         if available buf-grp then v-upper = buf-grp.upper-code.
     9595         else message "Выберите группу товаров"
     9596              view-as alert-box.
     9597         run ggoattr-value(
     9598                   input buf-grp.node-code,
     9599                   input 0,
     9600                   input "",
     9601                   input 0,
     9602                   input 'mark-grp':U,
     9603                   output v-value-mark,
     9604                   output v-type
     9605                 ) no-error.
     9606           if v-value-mark = "no" then temp-goods.alc-mark = no . else temp-goods.alc-mark = yes .
     9607           end.
     9608        define variable v-value-emrc as character no-undo .
     9609        define variable v-type-emrc  as character no-undo .
     9610        define variable old-value-emrc as character no-undo .
     9611        old-value-emrc = "" .
     9612        for first ub.gds-grp-obj-attr no-lock
     9613           where ub.gds-grp-obj-attr.node-code   = v-old-code
     9614           and ub.gds-grp-obj-attr.host-code   = 0
     9615           and ub.gds-grp-obj-attr.obj-type    = ""
     9616           and ub.gds-grp-obj-attr.obj-code    = 0
     9617           and ub.gds-grp-obj-attr.attr-code   = 'emrc-type':U:
     9618           old-value-emrc = ub.gds-grp-obj-attr.attr-value .
     9619        end.
     9620           for first ub.gds-grp-obj-attr no-lock
     9621              where ub.gds-grp-obj-attr.node-code   = ub.gds-grp.node-code
     9622              and ub.gds-grp-obj-attr.host-code   = 0
     9623              and ub.gds-grp-obj-attr.obj-type    = ""
     9624              and ub.gds-grp-obj-attr.obj-code    = 0
     9625              and ub.gds-grp-obj-attr.attr-code   = 'emrc-type':U:
     9626              v-value-emrc = ub.gds-grp-obj-attr.attr-value .
     9627           end.
     9628           define variable v-attr-emrc as character no-undo .
     9629           define variable v-attr-type as character no-undo .
     9630           define variable v-emrc-name as character no-undo .
     9631           define variable v-del       as logical   no-undo .
     9632           define buffer buf_goods-attr for ub.goods-attr .
     9633           for first buf_goods-attr no-lock where buf_goods-attr.attr-code = 'emrc-type':U and
     9634              buf_goods-attr.gds-code = temp-goods.gds-code:
     9635              v-attr-emrc = buf_goods-attr.attr-value .
     9636           end.
     9637           if v-value-emrc <> old-value-emrc and v-attr-emrc = "" then
     9638           do:
     9639              message "При переносе в группу " + string(ub.gds-grp.node-name) + " для товара " + string(temp-goods.gds-name) skip
     9640                 "будет наследоваться значение новой группы тип ЕМЦ-" + if v-value-emrc <> "" then v-value-emrc else "000" + ". " skip
     9641                 "При утвердительном ответе товар переносится в новую группу, значение тип ЕМЦ-" + string (if v-value-emrc <> "" then v-value-emrc else "000")
     9642                 view-as alert-box question buttons yes-no-cancel update choice as logical .
     9643              CASE choice:
     9644                 WHEN TRUE THEN
     9645                    DO:
     9646                    END.
     9647                 WHEN FALSE THEN
     9648                    DO:
     9649                       run gds-attr-write IN THIS-PROCEDURE(
     9650                          input temp-goods.gds-code
     9651                          ,INPUT 'emrc-type':U
     9652                          ,INPUT old-value-emrc ) .
     9653                    END.
     9654                 OTHERWISE
     9655                 DO:
     9656                    return error.
     9657                 end.
     9658              END CASE.
     9659           end.
     9660      define variable lChoice as integer no-undo .
     9661      if v-value-emrc <> v-attr-emrc and v-attr-emrc <> "" then
     9662      do:
     9663         find first ub.code no-lock where ub.Code.parent = "EMC" and ub.Code.code = v-attr-emrc no-error .
     9664         if not available (ub.Code) then v-emrc-name = "Нет" .
     9665         else v-emrc-name = ub.Code.CodeName .
     9666         run gbl/d-askw.w (
     9667            input "Сообщение"
     9668            ,input  "На товар установлен атрибут «тип ЕМЦ» - " + v-emrc-name + ". При переносе товара значение может быть изменено."
     9669            ,input "|"
     9670            ,input "Наследовать|Оставить|Отмена"
     9671            ,input "Наследовать атрибут от новой группы|Оставить текущее значение атрибута|Отмена"
     9672            ,input 1
     9673            ,input 3
     9674            ,output lChoice).
     9675         CASE lChoice:
     9676            WHEN 1 THEN
     9677               DO:
     9678                  if v-value-emrc = "" then
     9679                  do:
     9680                     run gds-attr-delete IN THIS-PROCEDURE(
     9681                        input temp-goods.gds-code
     9682                        ,INPUT 'emrc-type':U
     9683                        ,output v-del ) .
     9684                  end.
     9685                  else
     9686                  do:
     9687                     run gds-attr-write IN THIS-PROCEDURE(
     9688                        input temp-goods.gds-code
     9689                        ,INPUT 'emrc-type':U
     9690                        ,INPUT v-value-emrc ) NO-ERROR.
     9691                  end.
     9692               END.
     9693            WHEN 2 THEN
     9694               DO:
     9695                  run gds-attr-write IN THIS-PROCEDURE(
     9696                     input temp-goods.gds-code
     9697                     ,INPUT 'emrc-type':U
     9698                     ,INPUT v-attr-emrc ) .
     9699               END.
     9700            OTHERWISE
     9701            DO:
     9702               return error.
     9703            end.
     9704         END CASE.
     9705      end.
     9706     run chkgrp in this-procedure (buffer gds-grp) no-error .
     9707     if error-status:error then return error.
     9708     grp-full = "".
     9709     RUN grplib-get-full-name in this-procedure (input ub.gds-grp.node-code, output grp-full).
     9710     if length (grp-full) > 79 then
     9711       grp-full = "..." + substr (grp-full, length (grp-full) - 79).
     9712     run leave-unit-base(goods.unit-base:screen-value in frame d-gds-form) no-error.
     9713     if error-status:error then do:
     9714       return error.
     9715     end.
     9716     DISPLAY grp-full with frame d-gds-form.
     9717     if goods.artic:sensitive then
     9718       apply "entry" to goods.artic in frame d-gds-form.
     9719     else
     9720       apply "entry" to goods.gds-name in frame d-gds-form.
     9721   end.
     9722   else do:
     9723       if ub.gds-prt.node-name = '_Пустая шкала':U or not v-doc-prt then do:
     9724         find first buf_units No-LOCK WHERE
     9725                   buf_units.unit-name = ub.goods.unit-base .
     9726         if lookup('сер':U, buf_units.type ) > 0 then do:
     9727           run ref/gds-chks.w (input parparentproc
     9728                         ,input recid(goods)
     9729                         ,input "":U
     9730                         ,input 'объект':U
     9731                         ,input ?
     9732                         ,input p-obj-type
     9733                         ,input p-obj-code
     9734                         ,input "":U
     9735                         ,input "":U
     9736                         ,output rid-list
     9737                           ).
     9738         end.
     9739         else do:
     9740           run ref/gds-chk.w (
     9741                          input parparentproc
     9742                         ,input main-code
     9743                         ,input "":U
     9744                         ,input 'объект':U
     9745                         ,input ?
     9746                         ,input p-obj-type
     9747                         ,input p-obj-code
     9748                         ,input "":U
     9749                         ,input "":U
     9750                         ,output rid-list
     9751                           ).
     9752         end.
     9753       end.
     9754     else
     9755       message "Товар делится на признаки - смотрите чеки через шкалу."
     9756               view-as alert-box INFORMATION .
     9757     return error.
     9758   end.
     9759   END PROCEDURE.
     9760   PROCEDURE chkgrp:
     9761   define parameter buffer buf_gds-grp for ub.gds-grp.
     9762   run ref/dtaxgrps.p (buf_gds-grp.node-code,
     9763                  buf_gds-grp.upper-code,
     9764                  v-host-code,
     9765                  p-obj-type,
     9766                  p-obj-code) no-error.
     9767   if error-status:error then do:
     9768     message
     9769     error-status:get-message(1) skip
     9770     return-value
     9771     view-as alert-box error .
     9772     for each tt-tax:
     9773       delete tt-tax.
     9774     end.
     9775     return error.
     9776   end.
     9777   for each tt-tax:
     9778     delete tt-tax.
     9779   end.
     9780   if goods.calc-method:screen-value in frame d-gds-form  = 'Группа':U  then do:
     9781     if LOOKUP(buf_gds-grp.calc-method, goods.calc-method:list-items in frame d-gds-form) = 0 or
     9782        buf_gds-grp.calc-method = ? then do:
     9783       message "Неверный способ расчета учетной цены для товаров группы"
     9784       view-as alert-box error .
     9785       return error.
     9786     end.
     9787   end.
     9788   END PROCEDURE.
     9789   procedure fill-attr-tables :
     9790   define input parameter p-table as character no-undo .
     9791   define input parameter p-mode  as character no-undo .
     9792   define variable attr-type as character no-undo .
     9793   define variable attr-format as character no-undo .
     9794   define variable attr-label as character no-undo .
     9795   define variable attr-range as integer no-undo .
     9796   define variable attr-user-can-edit as logical no-undo .
     9797   define variable attr-output-display as logical no-undo .
     9798   define variable attr-other as char no-undo .
     9799   define variable other-db-num  like ub.db.db-num no-undo .
     9800   define variable other-host-code    like ub.sysconf.host-code no-undo .
     9801   define variable v-copy         as logical no-undo .
     9802   define variable v-update-attr  as logical no-undo .
     9803   define variable v-is-error     as logical no-undo .
     9804   define variable v-id           as integer no-undo .
     9805   define variable v-proc-handle  as handle  no-undo .
     9806   define buffer buf_gds-obj-attr for ub.gds-obj-attr.
     9807   define buffer buf_dis-gds-rule for ub.dis-gds-rule.
     9808   define buffer buf_s-coeff    for ub.s-coeff.
     9809   do
     9810   on error undo, return error return-value
     9811   on stop undo, return error return-value
     9812   :
     9813     CASE p-mode:
     9814        WHEN 'ИЗМЕНЕНИЕ':U THEN DO:
     9815           CASE p-table:
     9816             when 'dis-gds-rule':U then do:
     9817               FOR EACH tt0-dis-gds-rule:
     9818                 DELETE tt0-dis-gds-rule.
     9819               END.
     9820                FOR EACH locked_dis-gds-rule EXCLUSIVE-LOCK where
     9821                         locked_dis-gds-rule.gds-code = goods.gds-code
     9822                     AND (
     9823                          (locked_dis-gds-rule.obj-type = p-obj-type
     9824                     AND locked_dis-gds-rule.obj-code = p-obj-code)
     9825                     or   (v-cntxt-db-num = 0
     9826                          and
     9827                          (locked_dis-gds-rule.obj-type = 'орг':U
     9828                     AND locked_dis-gds-rule.obj-code = v-host-code))
     9829                     or  (v-cntxt-db-num = 0
     9830                         and
     9831                         (locked_dis-gds-rule.obj-type = '':U
     9832                     AND locked_dis-gds-rule.obj-code = 0))
     9833                     )
     9834                 on error undo, return error "Записи Атрибутов товара на объекте заняты"
     9835                 :
     9836                   if locked_dis-gds-rule.discnt-role = '':U
     9837                   and locked_dis-gds-rule.pos-type = '':U
     9838                   and locked_dis-gds-rule.nonunique = '':U then next.
     9839                   run trg/lock-dgr.p persistent set v-proc-handle (recid(locked_dis-gds-rule)) .
     9840                   run perproc-create-proc in this-procedure (
     9841                                                                     input  this-procedure
     9842                                                                     ,input  "trg/lock-dgr.p"
     9843                                                                     ,input  v-proc-handle
     9844                                                                     ,input  no
     9845                                                                     ,input  "":u
     9846                                                                     ,input v-cntxt-userid
     9847                                                                     ,input 0
     9848                                                                     ,output v-id) .
     9849                   CREATE tt0-dis-gds-rule.
     9850                   BUFFER-COPY locked_dis-gds-rule TO tt0-dis-gds-rule.
     9851               END.
     9852               v-flag-dgr-entry = yes.
     9853               FOR EACH buf_dis-gds-rule no-lock where
     9854                       buf_dis-gds-rule.gds-code = goods.gds-code
     9855               on error undo, return error
     9856               :
     9857                   if (buf_dis-gds-rule.obj-type = p-obj-type
     9858                   AND buf_dis-gds-rule.obj-code = p-obj-code)
     9859                   or (v-cntxt-db-num = 0
     9860                       and
     9861                       (buf_dis-gds-rule.obj-type = 'орг':U
     9862                   AND buf_dis-gds-rule.obj-code = v-host-code))
     9863                   or (v-cntxt-db-num = 0
     9864                       and
     9865                       (buf_dis-gds-rule.obj-type = '':U
     9866                   AND buf_dis-gds-rule.obj-code = 0))
     9867                      then NEXT.
     9868                   CREATE tt0-dis-gds-rule.
     9869                   BUFFER-COPY buf_dis-gds-rule TO tt0-dis-gds-rule.
     9870               END.
     9871             end.
     9872             when 'gds-obj-attr':U then do:
     9873               FOR EACH tt0-gds-obj-attr:
     9874                 DELETE tt0-gds-obj-attr.
     9875               END.
     9876                FOR EACH locked_gds-obj-attr EXCLUSIVE-LOCK where
     9877                         locked_gds-obj-attr.gds-code = goods.gds-code
     9878                     AND locked_gds-obj-attr.obj-type = p-obj-type
     9879                     AND locked_gds-obj-attr.obj-code = p-obj-code
     9880                 on error undo, return error "Записи Атрибутов товара на объекте заняты"
     9881                 :
     9882                   run trg/lock-goa.p persistent set v-proc-handle (recid(locked_gds-obj-attr)) .
     9883                   run perproc-create-proc in this-procedure (
     9884                                                                     input  this-procedure
     9885                                                                     ,input  "trg/lock-goa.p"
     9886                                                                     ,input  v-proc-handle
     9887                                                                     ,input  no
     9888                                                                     ,input  "":u
     9889                                                                     ,input v-cntxt-userid
     9890                                                                     ,input 0
     9891                                                                     ,output v-id) .
     9892                   CREATE tt0-gds-obj-attr.
     9893                   BUFFER-COPY locked_gds-obj-attr TO tt0-gds-obj-attr.
     9894               END.
     9895               v-flag-attr-obj-entry = yes.
     9896               FOR EACH buf_gds-obj-attr no-lock where
     9897                       buf_gds-obj-attr.gds-code = goods.gds-code
     9898               on error undo, return error
     9899               :
     9900                   if buf_gds-obj-attr.obj-type = p-obj-type
     9901                   AND buf_gds-obj-attr.obj-code = p-obj-code then NEXT.
     9902                   CREATE tt0-gds-obj-attr.
     9903                   BUFFER-COPY buf_gds-obj-attr TO tt0-gds-obj-attr.
     9904               END.
     9905             end.
     9906             when 'goods-attr':U then do:
     9907               FOR EACH tt0-goods-attr WHERE tt0-goods-attr.attr-code <> 'alcohol-prod':U:
     9908                 DELETE tt0-goods-attr.
     9909               END.
     9910               FOR EACH locked_goods-attr EXCLUSIVE-LOCK where
     9911                       locked_goods-attr.gds-code = goods.gds-code
     9912               on error undo, return error "Записи Глобальных Атрибутов товара на фирме заняты"
     9913               :
     9914                   run trg/lock-ga.p persistent set v-proc-handle (recid(locked_goods-attr)) .
     9915                   run perproc-create-proc in this-procedure (
     9916                                                                     input  this-procedure
     9917                                                                     ,input  "trg/lock-ga.p"
     9918                                                                     ,input  v-proc-handle
     9919                                                                     ,input  no
     9920                                                                     ,input  "":u
     9921                                                                     ,input v-cntxt-userid
     9922                                                                     ,input 0
     9923                                                                     ,output v-id) .
     9924                   CREATE tt0-goods-attr.
     9925                   BUFFER-COPY locked_goods-attr TO tt0-goods-attr.
     9926               END.
     9927               v-flag-attr-gbl-entry = yes.
     9928             end.
     9929             when 'gds-host-attr':U then do:
     9930               FOR EACH tt0-gds-host-attr:
     9931                 DELETE tt0-gds-host-attr.
     9932               END.
     9933               FOR EACH locked_gds-host-attr EXCLUSIVE-LOCK where
     9934                       locked_gds-host-attr.gds-code = goods.gds-code
     9935                   AND locked_gds-host-attr.host-code = v-host-code
     9936               on error undo, return error "Записи Атрибутов товара на фирме заняты"
     9937               :
     9938                   run trg/lock-gha.p persistent set v-proc-handle (recid(locked_gds-host-attr)) .
     9939                   run perproc-create-proc in this-procedure (
     9940                                                                     input  this-procedure
     9941                                                                     ,input  "trg/lock-gha.p"
     9942                                                                     ,input  v-proc-handle
     9943                                                                     ,input  no
     9944                                                                     ,input  "":u
     9945                                                                     ,input v-cntxt-userid
     9946                                                                     ,input 0
     9947                                                                     ,output v-id) .
     9948                   CREATE tt0-gds-host-attr.
     9949                   BUFFER-COPY locked_gds-host-attr TO tt0-gds-host-attr.
     9950               END.
     9951               v-flag-attr-host-entry = yes.
     9952             end.
     9953             when 'fbr-gds-obj':U then do:
     9954               FOR EACH tt0-fbr-gds-obj:
     9955                 DELETE tt0-fbr-gds-obj.
     9956               END.
     9957               FIND FIRST locked_fbr-gds-obj EXCLUSIVE-LOCK where
     9958                       locked_fbr-gds-obj.gds-code = goods.gds-code
     9959                   AND locked_fbr-gds-obj.obj-type = p-obj-type
     9960                   AND locked_fbr-gds-obj.obj-code = p-obj-code NO-WAIT no-error.
     9961               if not available locked_fbr-gds-obj then do:
     9962                 if locked locked_fbr-gds-obj then do:
     9963                   return error  "Запись атрибуты РЕСТОРАН товара на объекте занята".
     9964                 end.
     9965               end.
     9966               if available locked_fbr-gds-obj then do:
     9967                 assign
     9968                 v-fbr-gds-obj-recid = recid(locked_fbr-gds-obj).
     9969                 CREATE tt0-fbr-gds-obj.
     9970                 BUFFER-COPY locked_fbr-gds-obj TO tt0-fbr-gds-obj.
     9971               end.
     9972             v-flag-fbr-gds-entry = yes.
     9973           end.
     9974           when 's-coeff':U then do:
     9975             FOR EACH tt0-s-coeff:
     9976               DELETE tt0-s-coeff.
     9977             END.
     9978             find first locked_s-coeff exclusive-lock where
     9979                         locked_s-coeff.gds-code = goods.gds-code
     9980                   AND locked_s-coeff.s-date = 01/01/1996
     9981                   AND locked_s-coeff.host-code = 0
     9982                   AND locked_s-coeff.obj-type = "":U
     9983                   AND locked_s-coeff.obj-code = 0 no-wait no-error.
     9984             if not available locked_s-coeff then do:
     9985               if locked locked_s-coeff then do:
     9986                 return error  "Записи сезонных коэффициентов к товару сейчас заняты".
     9987               end.
     9988             end.
     9989             FOR EACH buf_s-coeff no-lock where
     9990                     buf_s-coeff.gds-code = goods.gds-code
     9991             on error undo, return error
     9992             :
     9993                 CREATE tt0-s-coeff.
     9994                 BUFFER-COPY buf_s-coeff TO tt0-s-coeff.
     9995             END.
     9996             v-flag-s-coeff-entry = yes.
     9997           end.
     9998           when 'gds-obj-prop':U then do:
     9999             FOR EACH tt0-gds-obj-prop:
    10000               DELETE tt0-gds-obj-prop.
    10001             END.
    10002             FIND FIRST locked_gds-obj-prop EXCLUSIVE-LOCK where
    10003                     locked_gds-obj-prop.gds-code = goods.gds-code
    10004                 AND locked_gds-obj-prop.obj-type = p-obj-type
    10005                 AND locked_gds-obj-prop.obj-code = p-obj-code NO-WAIT no-error.
    10006             if not available locked_gds-obj-prop then do:
    10007               if locked locked_gds-obj-prop then do:
    10008                 return error  "Запись индикаторов/атрибутов для заказа товара на объекте занята".
    10009               end.
    10010             end.
    10011             if available locked_gds-obj-prop then do:
    10012               assign
    10013               v-gds-prop-recid = recid(locked_gds-obj-prop).
    10014               CREATE tt0-gds-obj-prop.
    10015               BUFFER-COPY locked_gds-obj-prop TO tt0-gds-obj-prop.
    10016             end.
    10017           v-flag-gds-prop-entry = yes.
    10018         end.
    10019           when 'gds-obj-prop':U + 'obj' then do:
    10020             FOR EACH ttj-gds-obj-prop:
    10021               DELETE ttj-gds-obj-prop.
    10022             END.
    10023             FIND FIRST locked_gds-obj-prop EXCLUSIVE-LOCK where
    10024                     locked_gds-obj-prop.gds-code = goods.gds-code
    10025                 AND locked_gds-obj-prop.obj-type = p-obj-type
    10026                 AND locked_gds-obj-prop.obj-code = p-obj-code NO-WAIT no-error.
    10027             if not available locked_gds-obj-prop then do:
    10028               if locked locked_gds-obj-prop then do:
    10029                 return error  "Запись индикаторов/атрибутов для заказа товара на объекте занята".
    10030               end.
    10031             end.
    10032             if available locked_gds-obj-prop then do:
    10033               assign
    10034               v-gds-prop-recid = recid(locked_gds-obj-prop).
    10035               CREATE ttj-gds-obj-prop.
    10036               BUFFER-COPY locked_gds-obj-prop TO ttj-gds-obj-prop.
    10037             end.
    10038             for each locked_gds-obj-prop-attr no-lock where
    10039                     locked_gds-obj-prop-attr.gds-code = goods.gds-code
    10040                 AND locked_gds-obj-prop-attr.obj-type = p-obj-type
    10041                 AND locked_gds-obj-prop-attr.obj-code = p-obj-code :
    10042               if lookup(locked_gds-obj-prop-attr.attr-code, 'CorrIztDel':u) > 0 then next.
    10043               CREATE ttj-gds-obj-prop-attr.
    10044               BUFFER-COPY locked_gds-obj-prop-attr TO ttj-gds-obj-prop-attr.
    10045             end.
    10046           v-flag-gds-prop-entry = yes.
    10047         end.
    10048           when 'gds-obj-prop':U + 'firm' then do:
    10049             FOR EACH ttf-gds-obj-prop:
    10050               DELETE ttf-gds-obj-prop.
    10051             END.
    10052             FIND FIRST locked_gds-obj-prop EXCLUSIVE-LOCK where
    10053                     locked_gds-obj-prop.gds-code = goods.gds-code
    10054                 AND locked_gds-obj-prop.obj-type = 'орг':U
    10055                 AND locked_gds-obj-prop.obj-code = v-host-code NO-WAIT no-error.
    10056             if not available locked_gds-obj-prop then do:
    10057               if locked locked_gds-obj-prop then do:
    10058                 return error  "Запись параметров товара на фирме занята".
    10059               end.
    10060             end.
    10061             if available locked_gds-obj-prop then do:
    10062               assign
    10063               v-gds-prop-recid = recid(locked_gds-obj-prop).
    10064               CREATE ttf-gds-obj-prop.
    10065               BUFFER-COPY locked_gds-obj-prop TO ttf-gds-obj-prop.
    10066             end.
    10067           v-flag-gds-prop-entry = yes.
    10068         end.
    10069           when 'gds-add-charges':U then do:
    10070             FOR EACH tt0-gds-add-charges:
    10071               DELETE tt0-gds-add-charges.
    10072             END.
    10073             FIND FIRST locked_gds-add-charges EXCLUSIVE-LOCK where
    10074                     locked_gds-add-charges.gds-code = goods.gds-code
    10075                 NO-WAIT no-error.
    10076             if not available locked_gds-add-charges then do:
    10077               if locked locked_gds-add-charges then do:
    10078                 return error  "Запись дополнитеотных расходов".
    10079               end.
    10080             end.
    10081             if available locked_gds-add-charges then do:
    10082               assign
    10083               v-add-prop-recid = recid(locked_gds-add-charges).
    10084               CREATE tt0-gds-add-charges.
    10085               BUFFER-COPY locked_gds-add-charges TO tt0-gds-add-charges.
    10086             end.
    10087           v-flag-add-prop-entry = yes.
    10088         end.
    10089         END CASE.
    10090       END.
    10091       WHEN 'ПРОСМОТР':U THEN DO:
    10092         CASE p-table:
    10093           when 'dis-gds-rule':U then do:
    10094             FOR EACH tt0-dis-gds-rule:
    10095               DELETE tt0-dis-gds-rule.
    10096             END.
    10097             FOR EACH locked_dis-gds-rule no-LOCK where
    10098                 locked_dis-gds-rule.gds-code = goods.gds-code:
