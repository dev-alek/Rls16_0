      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117     define variable v-cntxt-db-num        as integer   no-undo .
      118     define variable v-cntxt-userid        as character no-undo .
      119     define variable v-cntxt-level         as character no-undo .
      120     define variable v-cntxt-host-code-obj as integer   no-undo .
      121     define variable v-cntxt-obj-type      as character no-undo .
      122     define variable v-cntxt-obj-code      as integer   no-undo .
      123     define variable v-cntxt-db-num-obj    as integer   no-undo .
      124     define variable v-cntxt-is-admin      as logical   no-undo .
      125   define variable v-mark        as logical FORMAT "*/ "     no-undo.
      126   define variable v-change      as logical FORMAT "*/ "     no-undo.
      127   define variable v-id          as integer      no-undo.
      128   define variable v-vid-id      as character      no-undo.
      129   define variable v-system-id   as character      no-undo.
      130   define variable v-ok          as logical      no-undo.
      131   define variable v-version     as integer      no-undo.
      132   DEFINE BUFFER buf_cd-video-link FOR ub.cd-video-link.
      133   DEFINE BUTTON b-add
      134        LABEL "&Добавить"
      135        SIZE 10 BY 1.
      136   DEFINE BUTTON b-chg
      137        LABEL "&Изменить"
      138        SIZE 10 BY 1.
      139   DEFINE BUTTON b-del
      140        LABEL "&Удалить"
      141        SIZE 10 BY 1.
      142   DEFINE BUTTON b-down
      143        LABEL "Выгрузить"
      144        SIZE 10 BY 1.
      145   DEFINE BUTTON b-help
      146        LABEL "Помо&щь"
      147        SIZE 10 BY 1
      148        BGCOLOR 8 .
      149   DEFINE BUTTON b-load
      150        LABEL "&Загрузить"
      151        SIZE 10 BY 1.
      152   DEFINE BUTTON b-mark
      153        LABEL "*"
      154        SIZE 3 BY 1.
      155   DEFINE BUTTON b-quit AUTO-END-KEY
      156        LABEL "&Выход"
      157        SIZE 10 BY 1
      158        BGCOLOR 8 .
      159   DEFINE BUTTON b-sel
      160        LABEL "Выбрать"
      161        SIZE 10 BY 1.
      162   DEFINE QUERY br-link FOR
      163         ub.cd-video-link SCROLLING.
      164   DEFINE BROWSE br-link
      165     QUERY br-link NO-LOCK DISPLAY
      166         v-mark COLUMN-LABEL "*" WIDTH 1
      167         ub.cd-video-link.event-id FORMAT ">>>9":U
      168         ub.cd-video-link.video-event-id FORMAT "x(30)":U
      169         ub.cd-video-link.video-id FORMAT "x(30)":U WIDTH 69.25
      170       WITH NO-ROW-MARKERS SEPARATORS SIZE 108.5 BY 14.75 FIT-LAST-COLUMN.
      171   DEFINE FRAME Dialog-Frame
      172        b-quit AT ROW 1 COL 1
      173        b-mark AT ROW 1 COL 13.5 WIDGET-ID 4
      174        b-sel AT ROW 1 COL 16.5 WIDGET-ID 2
      175        b-add AT ROW 1 COL 29 WIDGET-ID 10
      176        b-chg AT ROW 1 COL 39 WIDGET-ID 8
      177        b-del AT ROW 1 COL 49 WIDGET-ID 14
      178        b-down AT ROW 1 COL 61 WIDGET-ID 12
      179        b-load AT ROW 1 COL 71 WIDGET-ID 6
      180        b-help AT ROW 1 COL 99.5
      181        br-link AT ROW 2.25 COL 1 WIDGET-ID 200
      182        SPACE(0.37) SKIP(0.78)
      183       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      184            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      185            TITLE "Связь событий на кассе с событиями СВ"
      186            CANCEL-BUTTON b-quit WIDGET-ID 100.
      187   ASSIGN
      188          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      189          FRAME Dialog-Frame:HIDDEN           = TRUE.
      190   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      191   DO:
      192     APPLY "END-ERROR":U TO SELF.
      193   END.
      194   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      195   DO:
      196      assign
      197         v-id        = 0
      198         v-vid-id    = "":U
      199         v-system-id = "":U
      200         v-ok        = FALSE
      201      .
      202      run ref/cdvided.w ( INPUT parparentproc
      203                        , INPUT-OUTPUT v-id
      204                        , INPUT-OUTPUT v-vid-id
      205                        , INPUT-OUTPUT v-system-id
      206                        , OUTPUT v-ok
      207                        ) NO-ERROR.
      208      IF ERROR-STATUS:ERROR
      209      THEN DO:
      210         message
      211            "Ошибка создания связки события на кассе и СВ"
      212            skip RETURN-VALUE
      213            skip ERROR-STATUS:GET-MESSAGE (1)
      214         view-as alert-box error.
      215      END.
      216      IF  v-ok
      217      AND v-ID        <> 0
      218      AND v-vid-id    <> "":U
      219      AND v-system-id <> "":U
      220      THEN DO:
      221         define buffer buf_cd-video-link      for ub.cd-video-link .
      222         FIND FIRST buf_cd-video-link
      223              WHERE buf_cd-video-link.event-id        = v-ID
      224                AND buf_cd-video-link.video-event-id  = v-vid-id
      225                AND buf_cd-video-link.video-id        = v-system-id
      226              NO-LOCK
      227              NO-ERROR
      228              .
      229         IF AVAILABLE buf_cd-video-link
      230         THEN DO:
      231            run enable_UI.
      232            run post_enable_UI.
      233            REPOSITION br-link to rowid rowid( buf_cd-video-link ) no-error.
      234         END.
      235      END.
      236   END.
      237   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      238   DO:
      239   IF AVAILABLE ub.cd-video-link
      240      THEN DO:
      241         assign
      242            v-ok     = FALSE
      243         .
      244         run ref/cdvided.w  ( INPUT parparentproc
      245                            , INPUT-OUTPUT ub.cd-video-link.event-id
      246                            , INPUT-OUTPUT ub.cd-video-link.video-event-id
      247                            , INPUT-OUTPUT ub.cd-video-link.video-id
      248                            , OUTPUT v-ok
      249                            ) NO-ERROR.
      250         IF ERROR-STATUS:ERROR
      251         THEN DO:
      252            message
      253               "Ошибка создания записи"
      254               skip RETURN-VALUE
      255               skip ERROR-STATUS:GET-MESSAGE (1)
      256            view-as alert-box error.
      257         END.
      258         IF v-ok
      259         THEN DO:
      260            br-link:refresh().
      261         END.
      262      END.
      263   END.
      264   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      265   DO:
      266      IF AVAILABLE ub.cd-video-link
      267      THEN DO:
      268         ASSIGN
      269            v-ok = FALSE
      270         .
      271         message
      272            "Удалить запись?"
      273            skip ub.cd-video-link.event-id
      274            skip ub.cd-video-link.video-event-id
      275            skip ub.cd-video-link.video-id
      276            view-as alert-box QUESTION
      277            BUTTONS YES-NO
      278            update v-ok
      279         .
      280         IF v-ok
      281         THEN DO:
      282            run ref/cdviddel.p ( INPUT parparentproc
      283                               , INPUT ub.cd-video-link.event-id
      284                               , INPUT ub.cd-video-link.video-event-id
      285                               , INPUT ub.cd-video-link.video-id
      286                               , OUTPUT v-ok
      287                               ) NO-ERROR.
      288            IF ERROR-STATUS:ERROR
      289            THEN DO:
      290               message
      291                  "Ошибка удаления записи"
      292                  skip RETURN-VALUE
      293                  skip ERROR-STATUS:GET-MESSAGE (1)
      294               view-as alert-box error.
      295            END.
      296            IF  v-ok
      297            THEN DO:
      298               define buffer buf_cd-video-link      for ub.cd-video-link .
      299               FIND FIRST buf_cd-video-link
      300                    WHERE buf_cd-video-link.event-id        = ub.cd-video-link.event-id
      301                      AND buf_cd-video-link.video-event-id  = ub.cd-video-link.video-event-id
      302                      AND buf_cd-video-link.video-id        = ub.cd-video-link.video-id
      303                    EXCLUSIVE-LOCK
      304                    NO-ERROR
      305                    .
      306               IF AVAILABLE buf_cd-video-link
      307               THEN DO:
      308                  run enable_UI.
      309                  run post_enable_UI.
      310                  DELETE  buf_cd-video-link.
      311                  REPOSITION br-link to rowid rowid( buf_cd-video-link ) no-error.
      312               end.
      313                  run enable_UI.
      314                  run post_enable_UI.
      315            END.
      316         END.
      317      END.
      318   END.
      319   ON CHOOSE OF b-down IN FRAME Dialog-Frame
      320   DO:
      321      IF v-cntxt-db-num = 0
      322      THEN DO:
      323         run utl/cdvddown.p ( INPUT parparentproc
      324                            , INPUT-OUTPUT v-version
      325                            ) NO-ERROR.
      326         IF ERROR-STATUS:ERROR
      327         THEN DO:
      328            message
      329               RETURN-VALUE
      330               skip
      331            view-as alert-box ERROR.
      332         END.
      333         ELSE DO:
      334            run enable_UI.
      335            run post_enable_UI.
      336         END.
      337      END.
      338   END.
      339   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      340   OR HELP OF FRAME Dialog-Frame
      341   DO:
      342     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\cd-video.w" VIEW-AS ALERT-BOX INFORMATION.
      343   END.
      344   ON CHOOSE OF b-load IN FRAME Dialog-Frame
      345   DO:
      346      IF v-cntxt-db-num = 0
      347      THEN DO:
      348         run utl/cdvdload.p ( INPUT parparentproc
      349                            , INPUT-OUTPUT v-version
      350                            ) NO-ERROR.
      351         IF ERROR-STATUS:ERROR
      352         THEN DO:
      353            message
      354               RETURN-VALUE
      355               skip
      356            view-as alert-box ERROR.
      357         END.
      358         ELSE DO:
      359            run enable_UI.
      360            run post_enable_UI.
      361         END.
      362      END.
      363   END.
      364   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      365   DO:
      366      define variable v-ok as logical no-undo .
      367      if not available ub.cd-video-link then do:
      368         return no-apply.
      369      end.
      370   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      371   define variable v-str-recid2 as character no-undo .
      372   define variable v-num-entry2 as integer   no-undo .
      373   assign
      374     v-str-recid2 = trim( string( recid( ub.cd-video-link ) , "->>>>>>>>>>>9":U ) )
      375     v-num-entry2 = lookup( v-str-recid2 , rid-list )
      376   .
      377   if v-num-entry2 > 0 then do:
      378     assign
      379       entry( v-num-entry2, rid-list ) = "":U
      380       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      381     .
      382   end.
      383   else do:
      384     assign
      385       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid2
      386     .
      387   end.
      388      v-ok = br-link:select-next-row ().
      389      v-ok = br-link:refresh( )  in frame Dialog-Frame.
      390   END.
      391   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      392   DO:
      393      IF AVAILABLE ub.cd-video-link
      394      AND rid-list = ""
      395      then DO:
      396         assign
      397            rid-list = string( recid( ub.cd-video-link ) )
      398         .
      399      end.
      400      ASSIGN
      401         p-ok = true
      402      .
      403   END.
      404   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      405   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      406   MAIN-BLOCK:
      407   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      408      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      409   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      410     run mainmenu_getcntxt in parparentproc
      411       (output v-cntxt-db-num
      412       ,output v-cntxt-userid
      413       ,output v-cntxt-level
      414       ,output v-cntxt-host-code-obj
      415       ,output v-cntxt-obj-type
      416       ,output v-cntxt-obj-code
      417       ,output v-cntxt-db-num-obj
      418       ,output v-cntxt-is-admin
      419       ) .
      420   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      421   on help of frame Dialog-Frame
      422   do:
      423     run gbl/app_help.p
      424       (input this-procedure :file-name
      425       ,input ''
      426       ,input ?
      427       ) no-error.
      428     if error-status :error then do:
      429       message
      430         "Ошибка при вызове помощи"
      431         error-status :get-message(1)
      432         view-as alert-box .
      433     end.
      434   end.
      435   run minbtn-set in this-procedure .
      436   on choose of b-help in frame Dialog-Frame
      437   do:
      438     apply "help":u to frame Dialog-Frame .
      439   end.
      440   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      441   procedure minbtn-set :
      442       do
      443           on error undo, return error return-value
      444           :
      445           define variable ii              as integer       no-undo .
      446           define variable fh              as widget-handle no-undo .
      447           define variable hh              as widget-handle no-undo .
      448           define variable v-h             as handle        extent 4 no-undo .
      449           define variable v-name-button   as character     no-undo .
      450           define variable v-help-old-x    as decimal       no-undo .
      451           define variable v-help-old-y    as decimal       no-undo .
      452           define variable v-help-old-size as decimal       no-undo .
      453           define variable v-frame-width   as decimal       no-undo .
      454           define variable jj              as integer       no-undo .
      455           do
      456               on error undo, return error
      457               :
      458               assign
      459                   v-frame-width = frame Dialog-Frame:width - 0.3
      460                   fh            = frame Dialog-Frame:first-child
      461                   hh            = fh:first-child
      462                   ii            = 1
      463                   .
      464               do while valid-handle(hh):
      465                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      466                   do:
      467                       case lc(hh:name) :
      468                           when "b-help" then
      469                               do:
      470                                   hh:load-image-up("cmp/b-help.bmp":u) .
      471                                   hh:load-image-down("cmp/b-help.bmp":u) .
      472                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      473                                   hh:TOOLTIP = "Помощь" .
      474                                   v-help-old-x = hh:column .
      475                                   v-help-old-y = hh:row    .
      476                                   v-help-old-size = hh:width .
      477                                   hh:width-chars = 2.5 .
      478                               end.
      479                           when "b-print" then
      480                               do:
      481                                   hh:load-image("cmp/b-print.bmp":u) .
      482                                   hh:TOOLTIP = "Печать" .
      483                                   v-h[ii] = hh:handle .
      484                                   ii = ii + 1 .
      485                                   hh:width-chars = 3 .
      486                               end.
      487                           when "b-history" or
      488                           when "b-hist" then
      489                               do:
      490                                   hh:load-image("cmp/b-hist.bmp":u) .
      491                                   hh:TOOLTIP = "История" .
      492                                   v-h[ii] = hh:handle .
      493                                   ii = ii + 1 .
      494                                   hh:width-chars = 3 .
      495                               end.
      496                           when "b-sch" then
      497                               do:
      498                                   hh:load-image("cmp/b-sch.bmp":u) .
      499                                   hh:TOOLTIP = "Установка Фильтра" .
      500                                   v-h[ii] = hh:handle .
      501                                   ii = ii + 1 .
      502                                   hh:width-chars = 3 .
      503                               end.
      504                           when "b-hist-user" then
      505                               do:
      506                                   hh:load-image("cmp/b-hist.bmp":u) .
      507                                   hh:TOOLTIP = "История пользователя" .
      508                                   ii = ii + 1 .
      509                               end.
      510                       end case.
      511                   end.
      512                   hh = hh:next-sibling.
      513               end.
      514               b-help:column = v-frame-width - b-help:width-chars.
      515               jj = 0.
      516               repeat ii = 4 to 1 by -1 :
      517                   if valid-handle (v-h[ii] ) then
      518                   do:
      519                       jj  = jj + 1 .
      520                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      521                       v-h[ii]:row    = v-help-old-y .
      522                   end.
      523               end.
      524           end.
      525       end.
      526   end procedure.
      527   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      528   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      529   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      530   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      531   define variable v-diasize-current-frame-width  as decimal   no-undo .
      532   define variable v-diasize-current-frame-height as decimal   no-undo .
      533   define variable v-diasize-change-size          as logical   no-undo .
      534   define variable v-diasize-resize-button        as handle    no-undo .
      535   define variable v-diasize-wndmax               as logical   no-undo .
      536   define variable v-diasize-wndstore             as logical   no-undo .
      537   define variable v-diasize-proc-name            as character no-undo .
      538   define variable v-diasize-browse-handle        as handle    no-undo .
      539   define variable v-diasize-browse-number        as integer   no-undo .
      540   define variable v-diasize-need-full-display    as logical   no-undo init false .
      541   define temp-table temp-diasize-handle no-undo
      542     field handle-value  as handle
      543     field save-position as decimal
      544     index xpk is primary unique handle-value
      545     .
      546   define temp-table temp-browse-handle no-undo
      547     field browse-type   as character
      548     field browse-number as integer
      549     field browse-handle as handle
      550     field original-size as decimal
      551     index xpk is primary unique browse-type browse-number
      552     index xie browse-type browse-handle
      553   .
      554   procedure diasize_change-height :
      555     define input  parameter p-change-value  as decimal   no-undo .
      556     define input  parameter p-move-resize   as logical   no-undo .
      557     define variable v-field-group-handle    as handle    no-undo .
      558     define variable v-object-handle         as handle    no-undo .
      559     define variable v-frame-height          as decimal   no-undo .
      560     define variable v-frame-virtual-height  as decimal   no-undo .
      561     define variable v-browse-height         as decimal   no-undo .
      562     define variable v-window-height         as decimal   no-undo .
      563     define variable v-window-virtual-height as decimal   no-undo .
      564     define variable v-change-sign           as integer   no-undo .
      565     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      566     define buffer buf_temp-browse-handle  for temp-browse-handle .
      567     if p-change-value > 0
      568     then do:
      569       if frame Dialog-Frame :height + p-change-value
      570           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      571       then do:
      572         assign
      573           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      574                           - (frame Dialog-Frame :height-chars)
      575         .
      576         if p-change-value <= 0
      577         then do:
      578           run diasize_position-resize-button in this-procedure .
      579           return .
      580         end.
      581       end.
      582     end.
      583     if p-change-value < 0
      584     then do:
      585       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      586       then do:
      587         assign
      588           p-change-value = v-diasize-orig-frame-height
      589                          - (frame Dialog-Frame :height-chars)
      590         .
      591         if p-change-value >= 0
      592         then do:
      593           run diasize_position-resize-button in this-procedure .
      594           return .
      595         end.
      596       end.
      597     end.
      598     if p-change-value >= 0
      599     then do:
      600       assign
      601         v-change-sign = 1
      602       .
      603     end.
      604     else do:
      605       assign
      606         v-change-sign = -1
      607       .
      608     end.
      609     assign
      610       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      611     .
      612     if p-change-value = 0
      613     then do:
      614       run diasize_position-resize-button in this-procedure .
      615       return .
      616     end.
      617     move_block:
      618     do
      619     on error undo move_block, retry move_block
      620     :
      621       if retry
      622       then do:
      623         do
      624         on error undo move_block, leave move_block
      625         :
      626           if p-change-value > 0
      627           then do:
      628             for each buf_temp-diasize-handle
      629             on error undo, next
      630             :
      631               assign
      632                 v-object-handle = buf_temp-diasize-handle.handle-value
      633               .
      634               if v-object-handle <> v-diasize-resize-button
      635               then do:
      636                 assign
      637                   v-object-handle :row = buf_temp-diasize-handle.save-position
      638                 .
      639               end.
      640             end.
      641             assign
      642               v-diasize-browse-handle :height = v-browse-height
      643             .
      644             for each buf_temp-browse-handle
      645               where buf_temp-browse-handle.browse-type = 'height':u
      646             on error undo, next
      647             :
      648               assign
      649                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      650               .
      651             end.
      652             assign
      653               frame Dialog-Frame :height = v-frame-height
      654             .
      655             if frame Dialog-Frame :scrollable = true
      656             then do:
      657               assign
      658                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      659               .
      660             end.
      661             run diasize_position-resize-button in this-procedure .
      662           end.
      663           else do:
      664             if frame Dialog-Frame :scrollable = true
      665             then do:
      666               assign
      667                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      668               .
      669             end.
      670             assign
      671               frame Dialog-Frame :height = v-frame-height
      672             .
      673             assign
      674               v-diasize-browse-handle :height = v-browse-height
      675             .
      676             for each buf_temp-browse-handle
      677               where buf_temp-browse-handle.browse-type = 'height':u
      678             on error undo, next
      679             :
      680               assign
      681                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      682               .
      683             end.
      684             for each buf_temp-diasize-handle
      685             on error undo, next
      686             :
      687               assign
      688                 v-object-handle = buf_temp-diasize-handle.handle-value
      689               .
      690               if v-object-handle <> v-diasize-resize-button
      691               then do:
      692                 assign
      693                   v-object-handle :row = buf_temp-diasize-handle.save-position
      694                 .
      695               end.
      696             end.
      697             run diasize_position-resize-button in this-procedure .
      698           end.
      699           assign
      700             v-diasize-change-size = false
      701           .
      702           leave move_block .
      703         end.
      704       end.
      705       assign
      706         v-diasize-need-full-display = true
      707       .
      708       if v-diasize-change-size = false
      709       then do:
      710         assign
      711           v-diasize-change-size = true
      712         .
      713       end.
      714       else do:
      715         return .
      716       end.
      717       assign
      718         v-frame-height = frame Dialog-Frame :height
      719         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      720         v-browse-height = v-diasize-browse-handle :height
      721       .
      722       for each buf_temp-browse-handle
      723         where buf_temp-browse-handle.browse-type = 'height':u
      724       :
      725         assign
      726           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      727         .
      728       end.
      729       for each buf_temp-diasize-handle
      730       :
      731         delete buf_temp-diasize-handle .
      732       end.
      733       assign
      734         v-field-group-handle = frame Dialog-Frame :first-child
      735       .
      736       do while valid-handle(v-field-group-handle)
      737       :
      738         assign
      739           v-object-handle = v-field-group-handle :first-child
      740         .
      741         do while valid-handle(v-object-handle)
      742         :
      743           if  v-object-handle <> v-diasize-browse-handle :handle
      744           and can-query(v-object-handle, "row")
      745           and can-query(v-object-handle, "height")
      746           and ( v-object-handle :row > v-diasize-browse-handle :row )
      747           then do:
      748             find first buf_temp-browse-handle
      749               where buf_temp-browse-handle.browse-type   = 'height':u
      750                 and buf_temp-browse-handle.browse-handle = v-object-handle
      751               no-error .
      752             if available buf_temp-browse-handle
      753             then do:
      754             end.
      755             else do:
      756               create buf_temp-diasize-handle .
      757               assign
      758                 buf_temp-diasize-handle.handle-value  = v-object-handle
      759                 buf_temp-diasize-handle.save-position = v-object-handle :row
      760               .
      761             end.
      762           end.
      763           assign
      764             v-object-handle = v-object-handle :next-sibling
      765           .
      766         end.
      767         assign
      768           v-field-group-handle = v-field-group-handle :next-sibling
      769         .
      770       end.
      771       do with frame Dialog-Frame
      772       :
      773         hide v-diasize-resize-button .
      774         assign
      775           v-diasize-resize-button :row    = 1
      776           v-diasize-resize-button :column = 1
      777         .
      778       end.
      779       if p-change-value > 0
      780       then do:
      781         if frame Dialog-Frame :scrollable = true
      782         then do:
      783           assign
      784             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      785             no-error .
      786           if error-status :error
      787           or error-status :get-message(1) <> ""
      788           then do:
      789             undo move_block, retry move_block .
      790           end.
      791         end.
      792         assign
      793           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      794           no-error .
      795         if error-status :error
      796         or error-status :get-message(1) <> ""
      797         then do:
      798           undo move_block, retry move_block .
      799         end.
      800         assign
      801           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      802           no-error .
      803         if error-status :error
      804         or error-status :get-message(1) <> ""
      805         then do:
      806           undo move_block, retry move_block .
      807         end.
      808         for each buf_temp-browse-handle
      809           where buf_temp-browse-handle.browse-type = 'height':u
      810         on error undo move_block, retry move_block
      811         :
      812           assign
      813             buf_temp-browse-handle.browse-handle :height
      814               = buf_temp-browse-handle.browse-handle :height + p-change-value
      815             no-error .
      816           if error-status :error
      817           or error-status :get-message(1) <> ""
      818           then do:
      819             undo move_block, retry move_block .
      820           end.
      821         end.
      822         for each buf_temp-diasize-handle
      823         on error undo move_block, retry move_block
      824         :
      825           assign
      826             v-object-handle = buf_temp-diasize-handle.handle-value
      827           .
      828           if v-object-handle <> v-diasize-resize-button
      829           then do:
      830             assign
      831               v-object-handle :row = v-object-handle :row + p-change-value
      832               no-error .
      833             if error-status :error
      834             or error-status :get-message(1) <> ""
      835             then do:
      836               undo move_block, retry move_block .
      837             end.
      838           end.
      839         end.
      840       end.
      841       else do:
      842         for each buf_temp-diasize-handle
      843         on error undo move_block, retry move_block
      844         :
      845           assign
      846             v-object-handle = buf_temp-diasize-handle.handle-value
      847           .
      848           if v-object-handle <> v-diasize-resize-button
      849           then do:
      850             assign
      851               v-object-handle :row = v-object-handle :row + p-change-value
      852               no-error .
      853             if error-status :error
      854             or error-status :get-message(1) <> ""
      855             then do:
      856               undo move_block, retry move_block .
      857             end.
      858           end.
      859         end.
      860         assign
      861           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      862           no-error .
      863         if error-status :error
      864         or error-status :get-message(1) <> ""
      865         then do:
      866           undo move_block, retry move_block .
      867         end.
      868         for each buf_temp-browse-handle
      869           where buf_temp-browse-handle.browse-type = 'height':u
      870         on error undo move_block, retry move_block
      871         :
      872           assign
      873             buf_temp-browse-handle.browse-handle :height
      874               = buf_temp-browse-handle.browse-handle :height + p-change-value
      875             no-error .
      876           if error-status :error
      877           or error-status :get-message(1) <> ""
      878           then do:
      879             undo move_block, retry move_block .
      880           end.
      881         end.
      882         assign
      883           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      884           no-error .
      885         if error-status :error
      886         or error-status :get-message(1) <> ""
      887         then do:
      888           undo move_block, retry move_block .
      889         end.
      890         if frame Dialog-Frame :scrollable = true
      891         then do:
      892           assign
      893             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      894             no-error .
      895           if error-status :error
      896           or error-status :get-message(1) <> ""
      897           then do:
      898             undo move_block, retry move_block .
      899           end.
      900         end.
      901       end.
      902       if p-move-resize = true
      903       then do:
      904         run diasize_position-resize-button in this-procedure .
      905       end.
      906       if v-diasize-wndstore = true
      907       then do:
      908         if connected("ub") = true
      909         then do:
      910           define variable v-cntxt-db-num        as integer   no-undo .
      911           define variable v-cntxt-userid        as character no-undo .
      912           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      913                                             , OUTPUT v-cntxt-userid
      914                                             ) .
      915           run gbl/wndsizew.p
      916             (input  v-cntxt-db-num
      917             ,input  v-cntxt-userid
      918             ,input  v-diasize-proc-name
      919             ,input  'height':u
      920             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      921             ) .
      922         end.
      923       end.
      924     end.
      925     assign
      926       v-diasize-change-size = false
      927     .
      928   end procedure.
      929   procedure diasize_set-height :
      930     define input  parameter p-new-height  as decimal   no-undo .
      931     define input  parameter p-move-resize as logical   no-undo .
      932     do
      933     on error undo, return error return-value
      934     :
      935       run diasize_change-height in this-procedure
      936         (input  (p-new-height - frame Dialog-Frame :height)
      937         ,input  p-move-resize
      938         ) .
      939     end.
      940   end procedure.
      941   procedure diasize_change-width :
      942     define input  parameter p-change-value as decimal   no-undo .
      943     define input  parameter p-move-resize  as logical   no-undo .
      944     define variable v-field-group-handle   as handle    no-undo .
      945     define variable v-object-handle        as handle    no-undo .
      946     define variable v-frame-width          as decimal   no-undo .
      947     define variable v-frame-virtual-width  as decimal   no-undo .
      948     define variable v-browse-width         as decimal   no-undo .
      949     define variable v-window-width         as decimal   no-undo .
      950     define variable v-window-virtual-width as decimal   no-undo .
      951     define variable v-change-sign          as integer   no-undo .
      952     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      953     define buffer buf_temp-browse-handle  for temp-browse-handle .
      954     if p-change-value > 0
      955     then do:
      956       if frame Dialog-Frame :width + p-change-value >
      957           session :width-chars
      958       then do:
      959         assign
      960           p-change-value = session :width-chars - frame Dialog-Frame :width
      961         .
      962         if p-change-value <= 0
      963         then do:
      964           run diasize_position-resize-button in this-procedure .
      965           return .
      966         end.
      967       end.
      968     end.
      969     if p-change-value < 0
      970     then do:
      971       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      972       then do:
      973         assign
      974           p-change-value = v-diasize-orig-frame-width
      975                          - frame Dialog-Frame :width
      976         .
      977         if p-change-value >= 0
      978         then do:
      979           run diasize_position-resize-button in this-procedure .
      980           return .
      981         end.
      982       end.
      983     end.
      984     if p-change-value >= 0
      985     then do:
      986       assign
      987         v-change-sign = 1
      988       .
      989     end.
      990     else do:
      991       assign
      992         v-change-sign = -1
      993       .
      994     end.
      995     assign
      996       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      997     .
      998     if p-change-value = 0
      999     then do:
     1000       run diasize_position-resize-button in this-procedure .
     1001       return .
     1002     end.
     1003     move_block:
     1004     do
     1005     on error undo move_block, leave move_block
     1006     :
     1007       if retry
     1008       then do:
     1009         do
     1010         on error undo move_block, leave move_block
     1011         :
     1012           if p-change-value > 0
     1013           then do:
     1014             for each buf_temp-diasize-handle
     1015             on error undo, next
     1016             :
     1017               assign
     1018                 v-object-handle = buf_temp-diasize-handle.handle-value
     1019               .
     1020               if v-object-handle <> v-diasize-resize-button
     1021               then do:
     1022                 assign
     1023                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1024                 .
     1025               end.
     1026             end.
     1027             assign
     1028               v-diasize-browse-handle :width = v-browse-width
     1029             .
     1030             for each buf_temp-browse-handle
     1031               where buf_temp-browse-handle.browse-type = 'width':u
     1032             on error undo, next
     1033             :
     1034               assign
     1035                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1036               .
     1037             end.
     1038             assign
     1039               frame Dialog-Frame :width = v-frame-width
     1040             .
     1041             if frame Dialog-Frame :scrollable = true
     1042             then do:
     1043               assign
     1044                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1045               .
     1046             end.
     1047             run diasize_position-resize-button in this-procedure .
     1048           end.
     1049           else do:
     1050             if frame Dialog-Frame :scrollable = true
     1051             then do:
     1052               assign
     1053                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1054               .
     1055             end.
     1056             assign
     1057               frame Dialog-Frame :width = v-frame-width
     1058             .
     1059             for each buf_temp-browse-handle
     1060               where buf_temp-browse-handle.browse-type = 'width':u
     1061             on error undo, next
     1062             :
     1063               assign
     1064                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1065               .
     1066             end.
     1067             assign
     1068               v-diasize-browse-handle :width = v-browse-width
     1069             .
     1070             for each buf_temp-diasize-handle
     1071             on error undo, next
     1072             :
     1073               assign
     1074                 v-object-handle = buf_temp-diasize-handle.handle-value
     1075               .
     1076               if v-object-handle <> v-diasize-resize-button
     1077               then do:
     1078                 assign
     1079                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1080                 .
     1081               end.
     1082             end.
     1083             run diasize_position-resize-button in this-procedure .
     1084           end.
     1085           assign
     1086             v-diasize-change-size = false
     1087           .
     1088           leave move_block .
     1089         end.
     1090       end.
     1091       assign
     1092         v-diasize-need-full-display = true
     1093       .
     1094       if v-diasize-change-size = false
     1095       then do:
     1096         assign
     1097           v-diasize-change-size = true
     1098         .
     1099       end.
     1100       else do:
     1101         return .
     1102       end.
     1103       assign
     1104         v-frame-width = frame Dialog-Frame :width
     1105         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1106         v-browse-width = v-diasize-browse-handle :width
     1107       .
     1108       for each buf_temp-browse-handle
     1109         where buf_temp-browse-handle.browse-type = 'width':u
     1110       :
     1111         assign
     1112           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1113         .
     1114       end.
     1115       for each buf_temp-diasize-handle
     1116       :
     1117         delete buf_temp-diasize-handle .
     1118       end.
     1119       assign
     1120         v-field-group-handle = frame Dialog-Frame :first-child
     1121       .
     1122       do while valid-handle(v-field-group-handle)
     1123       :
     1124         assign
     1125           v-object-handle = v-field-group-handle :first-child
     1126         .
     1127         do while valid-handle(v-object-handle)
     1128         :
     1129           if  v-object-handle <> v-diasize-browse-handle :handle
     1130           and v-object-handle <> v-diasize-resize-button
     1131           and can-query(v-object-handle, "row")
     1132           and can-query(v-object-handle, "height")
     1133           and ( v-object-handle :col + v-object-handle :width
     1134                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1135               )
     1136           then do:
     1137             find first buf_temp-browse-handle
     1138               where buf_temp-browse-handle.browse-type   = 'width':u
     1139                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1140               no-error .
     1141             if available buf_temp-browse-handle
     1142             then do:
     1143             end.
     1144             else do:
     1145               create buf_temp-diasize-handle .
     1146               assign
     1147                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1148                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1149               .
     1150             end.
     1151           end.
     1152           assign
     1153             v-object-handle = v-object-handle :next-sibling
     1154           .
     1155         end.
     1156         assign
     1157           v-field-group-handle = v-field-group-handle :next-sibling
     1158         .
     1159       end.
     1160       do with frame Dialog-Frame
     1161       :
     1162         hide v-diasize-resize-button .
     1163         v-diasize-resize-button :row = 1.
     1164         v-diasize-resize-button :column = 1.
     1165       end.
     1166       if p-change-value > 0
     1167       then do:
     1168         if frame Dialog-Frame :scrollable = true
     1169         then do:
     1170           assign
     1171             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1172             no-error .
     1173           if error-status :error
     1174           or error-status :get-message(1) <> ""
     1175           then do:
     1176             undo move_block, retry move_block.
     1177           end.
     1178         end.
     1179         assign
     1180           frame Dialog-Frame :width = v-frame-width + p-change-value
     1181           no-error .
     1182         if error-status :error
     1183         or error-status :get-message(1) <> ""
     1184         then do:
     1185           undo move_block, retry move_block.
     1186         end.
     1187         assign
     1188           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1189         no-error .
     1190         if error-status :error
     1191         or error-status :get-message(1) <> ""
     1192         then do:
     1193           undo move_block, retry move_block.
     1194         end.
     1195         for each buf_temp-browse-handle
     1196           where buf_temp-browse-handle.browse-type = 'width':u
     1197         on error undo move_block, retry move_block
     1198         :
     1199           assign
     1200             buf_temp-browse-handle.browse-handle :width
     1201               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1202             no-error .
     1203           if error-status :error
     1204           or error-status :get-message(1) <> ""
     1205           then do:
     1206             undo move_block, retry move_block .
     1207           end.
     1208         end.
     1209         for each buf_temp-diasize-handle
     1210         on error undo move_block, retry move_block
     1211         :
     1212           assign
     1213             v-object-handle = buf_temp-diasize-handle.handle-value
     1214           .
     1215           if v-object-handle <> v-diasize-resize-button
     1216           then do:
     1217             assign
     1218               v-object-handle :col = v-object-handle :col + p-change-value
     1219               no-error .
     1220             if error-status :error
     1221             or error-status :get-message(1) <> ""
     1222             then do:
     1223               undo move_block, retry move_block .
     1224             end.
     1225           end.
     1226         end.
     1227       end.
     1228       else do:
     1229         for each buf_temp-diasize-handle
     1230         on error undo move_block, retry move_block
     1231         :
     1232           assign
     1233             v-object-handle = buf_temp-diasize-handle.handle-value
     1234           .
     1235           if v-object-handle <> v-diasize-resize-button
     1236           then do:
     1237             assign
     1238               v-object-handle :col = v-object-handle :col + p-change-value
     1239               no-error .
     1240             if error-status :error
     1241             or error-status :get-message(1) <> ""
     1242             then do:
     1243               undo move_block, retry move_block .
     1244             end.
     1245           end.
     1246         end.
     1247         for each buf_temp-browse-handle
     1248           where buf_temp-browse-handle.browse-type = 'width':u
     1249         on error undo move_block, retry move_block
     1250         :
     1251           assign
     1252             buf_temp-browse-handle.browse-handle :width
     1253               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1254             no-error .
     1255           if error-status :error
     1256           or error-status :get-message(1) <> ""
     1257           then do:
     1258             undo move_block, retry move_block .
     1259           end.
     1260         end.
     1261         assign
     1262           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1263           no-error .
     1264         if error-status :error
     1265         or error-status :get-message(1) <> ""
     1266         then do:
     1267           undo move_block, retry move_block.
     1268         end.
     1269         assign
     1270           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1271         no-error .
     1272         if error-status :error
     1273         or error-status :get-message(1) <> ""
     1274         then do:
     1275           undo move_block, retry move_block.
     1276         end.
     1277         if frame Dialog-Frame :scrollable = true
     1278         then do:
     1279           assign
     1280             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1281           no-error .
     1282           if error-status :error
     1283           or error-status :get-message(1) <> ""
     1284           then do:
     1285             undo move_block, retry move_block.
     1286           end.
     1287         end.
     1288       end.
     1289       if p-move-resize
     1290       then do:
     1291         run diasize_position-resize-button in this-procedure .
     1292       end.
     1293       if v-diasize-wndstore = true
     1294       then do:
     1295         if connected("ub") = true
     1296         then do:
     1297           define variable v-cntxt-db-num        as integer   no-undo .
     1298           define variable v-cntxt-userid        as character no-undo .
     1299           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1300                                             , OUTPUT v-cntxt-userid
     1301                                             ) .
     1302           run gbl/wndsizew.p
     1303             (input  v-cntxt-db-num
     1304             ,input  v-cntxt-userid
     1305             ,input  v-diasize-proc-name
     1306             ,input  'width':u
     1307             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1308             ) .
     1309         end.
     1310       end.
     1311     end.
     1312     assign
     1313       v-diasize-change-size = false
     1314     .
     1315   end procedure.
     1316   procedure diasize_set-width :
     1317     define input  parameter p-new-width  as decimal   no-undo .
     1318     define input  parameter p-move-resize as logical   no-undo .
     1319     do
     1320     on error undo, return error return-value
     1321     :
     1322       run diasize_change-width in this-procedure
     1323         (input  (p-new-width - frame Dialog-Frame :width)
     1324         ,input  p-move-resize
     1325         ) .
     1326     end.
     1327   end procedure.
     1328   procedure diasize_position-resize-button :
     1329     do with frame Dialog-Frame
     1330     :
     1331       hide v-diasize-resize-button .
     1332       assign
     1333         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1334                     - 1
     1335                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1336         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1337                     - 1
     1338                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1339       .
     1340       view v-diasize-resize-button .
     1341     end.
     1342   end procedure.
     1343   on alt-right anywhere
     1344   do:
     1345     run diasize_change-width in this-procedure
     1346       (input 1
     1347       ,input true
     1348       ) .
     1349     return no-apply .
     1350   end.
     1351   on alt-left anywhere
     1352   do:
     1353     run diasize_change-width in this-procedure
     1354       (input -1
     1355       ,input true
     1356       ) .
     1357     return no-apply .
     1358   end.
     1359   on alt-down anywhere
     1360   do:
     1361     run diasize_change-height in this-procedure
     1362       (input 1
     1363       ,input true
     1364       ) .
     1365     return no-apply .
     1366   end.
     1367   on alt-up anywhere
     1368   do:
     1369     run diasize_change-height in this-procedure
     1370       (input -1
     1371       ,input true
     1372       ) .
     1373     return no-apply .
     1374   end.
     1375   on alt-enter of frame Dialog-Frame
     1376   do:
     1377     run diasize_maximize in this-procedure
     1378       (input  ?
     1379       ).
     1380     return no-apply .
     1381   end.
     1382   procedure diasize_end-move :
     1383     do
     1384     on error undo, return error return-value
     1385     :
     1386       define variable v-row-delta as decimal   no-undo .
     1387       define variable v-col-delta as decimal   no-undo .
     1388       define variable v-new-row as decimal   no-undo .
     1389       define variable v-new-col as decimal   no-undo .
     1390       assign
     1391         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1392         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1393       .
     1394       assign
     1395         v-row-delta = v-new-row - frame Dialog-Frame :height
     1396         v-col-delta = v-new-col - frame Dialog-Frame :width
     1397       .
     1398       run diasize_change-height in this-procedure
     1399         (input v-row-delta
     1400         ,input true
     1401         ) .
     1402       run diasize_change-width in this-procedure
     1403         (input v-col-delta
     1404         ,input true
     1405         ) .
     1406     end.
     1407   end procedure.
     1408   procedure diasize_maximize :
     1409     define input  parameter p-action as logical   no-undo .
     1410     do
     1411     on error undo, return error return-value
     1412     :
     1413       if p-action = ?
     1414       then do:
     1415         if v-diasize-need-maximize = true
     1416         then do:
     1417           assign
     1418             p-action = true
     1419           .
     1420         end.
     1421         else do:
     1422           assign
     1423             p-action = false
     1424           .
     1425         end.
     1426       end.
     1427       if p-action = true
     1428       then do:
     1429         run diasize_change-height in this-procedure
     1430           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1431               - frame Dialog-Frame :height-chars
     1432           ,input true
     1433           ) .
     1434         run diasize_change-width in this-procedure
     1435           (input session :width-chars
     1436               - frame Dialog-Frame :width-chars
     1437           ,input true
     1438           ) .
     1439         assign
     1440           v-diasize-need-maximize = false
     1441         .
     1442       end.
     1443       else do:
     1444         run diasize_change-width in this-procedure
     1445           (input v-diasize-orig-frame-width
     1446               - frame Dialog-Frame :width-chars
     1447           ,input true
     1448           ) .
     1449         run diasize_change-height in this-procedure
     1450           (input v-diasize-orig-frame-height
     1451               - frame Dialog-Frame :height-chars
     1452           ,input true
     1453           ) .
     1454         assign
     1455           v-diasize-need-maximize = true
     1456         .
     1457       end.
     1458     end.
     1459   end procedure.
     1460   procedure diasize_restore-orig-size :
     1461     do
     1462     on error undo, return error return-value
     1463     :
     1464       assign
     1465         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1466         v-diasize-current-frame-height = frame Dialog-Frame :height
     1467       .
     1468       run diasize_set-height in this-procedure
     1469         (input  v-diasize-orig-frame-height
     1470         ,input  true
     1471         ) .
     1472       run diasize_set-width in this-procedure
     1473         (input  v-diasize-orig-frame-width
     1474         ,input  true
     1475         ) .
     1476     end.
     1477   end procedure.
     1478   procedure diasize_restore-current-size :
     1479     do
     1480     on error undo, return error return-value
     1481     :
     1482       run diasize_set-height in this-procedure
     1483         (input  v-diasize-current-frame-height
     1484         ,input  true
     1485         ) .
     1486       run diasize_set-width in this-procedure
     1487         (input  v-diasize-current-frame-width
     1488         ,input  true
     1489         ) .
     1490     end.
     1491   end procedure.
     1492   procedure diasize_set-browse-handle :
     1493     define input  parameter p-browse-handle as handle   no-undo .
     1494     define buffer buf_temp-browse-handle for temp-browse-handle .
     1495     do
     1496     on error undo, return error return-value
     1497     :
     1498       assign
     1499         v-diasize-browse-handle = p-browse-handle
     1500       .
     1501       for each buf_temp-browse-handle
     1502       on error undo, return error return-value
     1503       :
     1504         delete buf_temp-browse-handle .
     1505       end.
     1506     end.
     1507   end procedure.
     1508   procedure diasize_add_browse :
     1509     define input  parameter p-browse-type   as character no-undo .
     1510     define input  parameter p-browse-handle as handle    no-undo .
     1511     define buffer buf_temp-browse-handle for temp-browse-handle .
     1512     do
     1513     on error undo, return error return-value
     1514     :
     1515       assign
     1516         v-diasize-browse-number = v-diasize-browse-number + 1
     1517       .
     1518       create buf_temp-browse-handle .
     1519       assign
     1520         buf_temp-browse-handle.browse-type   = p-browse-type
     1521         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1522         buf_temp-browse-handle.browse-handle = p-browse-handle
     1523       .
     1524     end.
     1525   end procedure.
     1526   procedure diasize_init :
     1527     define variable v-default-value    as logical   no-undo .
     1528     define variable v-restore-saved    as logical   no-undo .
     1529     define variable v-resize-value-str as character no-undo .
     1530     do
     1531     on error undo, return error return-value
     1532     :
     1533       do with frame Dialog-Frame
     1534       :
     1535         assign
     1536           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1537           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1538           v-diasize-browse-handle     = browse br-link :handle
     1539         .
     1540         create button v-diasize-resize-button
     1541         assign
     1542           parent        = frame Dialog-Frame :first-child
     1543           label         = "s"
     1544           height-pixels = 16
     1545           width-pixels  = 16
     1546           visible       = true
     1547           sensitive     = true
     1548           movable       = true
     1549           triggers:
     1550             on end-move persistent run diasize_end-move in this-procedure .
     1551           end triggers.
     1552         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1553         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1554         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1555         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1556         assign
     1557           v-diasize-wndmax = false
     1558         .
     1559         if connected("ub") = true
     1560         then do:
     1561           define variable v-cntxt-db-num        as integer   no-undo .
     1562           define variable v-cntxt-userid        as character no-undo .
     1563           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1564                                             , OUTPUT v-cntxt-userid
     1565                                             ) .
     1566           run gbl/wndpar_r.p
     1567             (input  v-cntxt-db-num
     1568             ,input  v-cntxt-userid
     1569             ,input  'wndmax':U
     1570             ,output v-diasize-wndmax
     1571             ,output v-default-value
     1572             ) .
     1573         end.
     1574         assign
     1575           v-diasize-wndstore = false
     1576         .
     1577         if connected("ub") = true
     1578         then do:
     1579           run gbl/wndpar_r.p
     1580             (input  v-cntxt-db-num
     1581             ,input  v-cntxt-userid
     1582             ,input  'wndstore':U
     1583             ,output v-diasize-wndstore
     1584             ,output v-default-value
     1585             ) .
     1586         end.
     1587         assign
     1588           v-diasize-proc-name = entry(1, program-name(2), '.')
     1589         .
     1590         if v-diasize-wndstore = true
     1591         then do:
     1592           assign
     1593             v-restore-saved = false
     1594           .
     1595           if connected("ub") = true
     1596           then do:
     1597             run gbl/wndsizer.p
     1598               (input  v-cntxt-db-num
     1599               ,input  v-cntxt-userid
     1600               ,input  v-diasize-proc-name
     1601               ,input  'height':u
     1602               ,output v-resize-value-str
     1603               ) .
     1604             if v-resize-value-str <> '':U
     1605             then do:
     1606               run diasize_change-height in this-procedure
     1607                 (input  integer(v-resize-value-str)
     1608                 ,input  true
     1609                 ) .
     1610               assign
     1611                 v-restore-saved = true
     1612               .
     1613             end.
     1614           end.
     1615           if connected("ub") = true
     1616           then do:
     1617             run gbl/wndsizer.p
     1618               (input  v-cntxt-db-num
     1619               ,input  v-cntxt-userid
     1620               ,input  v-diasize-proc-name
     1621               ,input  'width':u
     1622               ,output v-resize-value-str
     1623               ) .
     1624             if v-resize-value-str <> '':U
     1625             then do:
     1626               run diasize_change-width in this-procedure
     1627                 (input  integer(v-resize-value-str)
     1628                 ,input  true
     1629                 ) .
     1630               assign
     1631                 v-restore-saved = true
     1632               .
     1633             end.
     1634           end.
     1635           if v-restore-saved <> true
     1636           then do:
     1637             if v-diasize-wndmax = true
     1638             then do:
     1639               run diasize_maximize in this-procedure
     1640                 (input  true
     1641                 ) .
     1642             end.
     1643           end.
     1644         end.
     1645         else do:
     1646           if v-diasize-wndmax = true
     1647           then do:
     1648             run diasize_maximize in this-procedure
     1649               (input  true
     1650               ) .
     1651           end.
     1652         end.
     1653       end.
     1654     end.
     1655   end procedure.
     1656   procedure diasize_need-full-display :
     1657     define output parameter p-need-full-display as logical   no-undo .
     1658     do
     1659     on error undo, return error return-value
     1660     :
     1661       assign
     1662         p-need-full-display = v-diasize-need-full-display
     1663       .
     1664       assign
     1665         v-diasize-need-full-display = false
     1666       .
     1667     end.
     1668   end procedure.
     1669   procedure get-context :
     1670      define output parameter p-db-num as integer          no-undo.
     1671      define output parameter p-user-id as character        no-undo.
     1672      define variable v-login               as character    no-undo.
     1673      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1674      define buffer buf_user-login  for ub.user-login .
     1675      do
     1676      on error undo, return error
     1677      :
     1678            FIND FIRST buf_sys-ctrl no-lock.
     1679            ASSIGN
     1680               v-login = USERID("ub")
     1681               p-db-num = buf_sys-ctrl.db-num
     1682            .
     1683            FIND FIRST buf_user-login
     1684                 WHERE buf_user-login.db-num = p-db-num
     1685                   AND buf_user-login.user-login = v-login
     1686                 no-lock
     1687                 no-error
     1688                 .
     1689            IF AVAILABLE buf_user-login
     1690            THEN DO:
     1691               assign
     1692                  p-user-id = buf_user-login.user-id
     1693               .
     1694            END.
     1695      end.
     1696   end procedure.
     1697       run diasize_init in this-procedure .
     1698      run enable_UI.
     1699      run post_enable_UI.
     1700      WAIT-FOR GO OF FRAME Dialog-Frame.
     1701   END.
     1702   run disable_UI.
     1703   PROCEDURE disable_UI :
     1704     HIDE FRAME Dialog-Frame.
     1705   END PROCEDURE.
     1706   PROCEDURE enable_UI :
     1707     ENABLE b-quit b-mark b-sel b-add b-chg b-del b-down b-load b-help br-link
     1708         WITH FRAME Dialog-Frame.
     1709     VIEW FRAME Dialog-Frame.
     1710     OPEN QUERY br-link FOR EACH ub.cd-video-link NO-LOCK INDEXED-REPOSITION.
     1711   END PROCEDURE.
     1712   PROCEDURE Post_enable_UI :
     1713      DISABLE
     1714         b-sel
     1715         b-mark
     1716         b-load
     1717         b-down
     1718         b-chg
     1719         b-del
     1720         b-add
     1721      WITH FRAME Dialog-Frame.
     1722      ENABLE
     1723         b-sel  WHEN (( lookup  ( "b-sel":U  , p-bttns) > 0 ) OR  ( lookup  ( "b-mark":U , p-bttns) > 0 ))
     1724         b-mark WHEN (  lookup  ( "b-mark":U , p-bttns) > 0 )
     1725         b-load WHEN (( lookup  ( "b-add":U , p-bttns) > 0 ) AND ( v-cntxt-db-num = 0 ))
     1726         b-down WHEN (( lookup  ( "b-add":U , p-bttns) > 0 ) AND ( v-cntxt-db-num = 0 ))
     1727         b-chg  WHEN (( lookup  ( "b-add":U , p-bttns) > 0 ) AND ( v-cntxt-db-num = 0 ))
     1728         b-del  WHEN (( lookup  ( "b-add":U , p-bttns) > 0 ) AND ( v-cntxt-db-num = 0 ))
     1729         b-add  WHEN (( lookup  ( "b-add":U , p-bttns) > 0 ) AND ( v-cntxt-db-num = 0 ))
     1730      WITH FRAME Dialog-Frame.
     1731   END PROCEDURE.
