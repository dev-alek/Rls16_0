        1   define output parameter Pri-Mode as char no-undo .
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Порядок сортировки при печати на весы".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   DEFINE BUTTON b-help
      112        LABEL "Помо&щь"
      113        SIZE 10 BY 1.
      114   DEFINE BUTTON b-quit AUTO-END-KEY
      115        LABEL "&Отмена"
      116        SIZE 10 BY 1
      117        BGCOLOR 8 FGCOLOR 0 .
      118   DEFINE RECTANGLE RECT-23
      119        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      120        SIZE 27.8 BY 8.77.
      121   DEFINE VARIABLE ByBar AS LOGICAL INITIAL no
      122        LABEL "по ВЕСОВОМУ коду"
      123        VIEW-AS TOGGLE-BOX
      124        SIZE 23 BY 1
      125        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
      126   DEFINE VARIABLE ByGroup AS LOGICAL INITIAL no
      127        LABEL "по ГРУППЕ + АРТИКУЛ"
      128        VIEW-AS TOGGLE-BOX
      129        SIZE 23 BY 1 NO-UNDO.
      130   DEFINE VARIABLE ByGroup-Name AS LOGICAL INITIAL no
      131        LABEL "по ГРУППЕ + НАЗВ."
      132        VIEW-AS TOGGLE-BOX
      133        SIZE 23 BY 1 NO-UNDO.
      134   DEFINE VARIABLE ByName AS LOGICAL INITIAL no
      135        LABEL "по НАЗВАНИЮ товара"
      136        VIEW-AS TOGGLE-BOX
      137        SIZE 23 BY 1 NO-UNDO.
      138   DEFINE VARIABLE ByPlu AS LOGICAL INITIAL no
      139        LABEL "по PLU-коду"
      140        VIEW-AS TOGGLE-BOX
      141        SIZE 23 BY 1
      142        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
      143   DEFINE FRAME Dialog-Frame
      144        b-quit AT ROW 1 COL 1
      145        b-help AT ROW 1 COL 28 WIDGET-ID 2
      146        ByBar AT ROW 3.83 COL 8
      147        ByPlu AT ROW 5.33 COL 8
      148        ByName AT ROW 6.93 COL 8
      149        ByGroup AT ROW 8.5 COL 8
      150        ByGroup-Name AT ROW 10.23 COL 7.8
      151        RECT-23 AT ROW 3.13 COL 5.5
      152        SPACE(5.06) SKIP(2.01)
      153       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      154            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      155            BGCOLOR 8 FGCOLOR 0
      156            TITLE "КАК УПОРЯДОЧИТЬ СПИСОК"
      157            CANCEL-BUTTON b-quit.
      158   ASSIGN
      159          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      160          FRAME Dialog-Frame:HIDDEN           = TRUE.
      161   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      162   DO:
      163     APPLY "END-ERROR":U TO SELF.
      164   END.
      165   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      166   DO:
      167       Pri-mode = "отказ".
      168   END.
      169   ON VALUE-CHANGED OF ByBar IN FRAME Dialog-Frame
      170   DO:
      171     assign ByBar.
      172     if ByBar then
      173       do:
      174           Pri-Mode = "bar" .
      175           apply "GO" to frame Dialog-Frame .
      176       end.
      177   END.
      178   ON VALUE-CHANGED OF ByGroup IN FRAME Dialog-Frame
      179   DO:
      180     assign ByGroup.
      181     if ByGroup then
      182       do:
      183           Pri-Mode = "group" .
      184           apply "GO" to frame Dialog-Frame .
      185       end.
      186   END.
      187   ON VALUE-CHANGED OF ByGroup-Name IN FRAME Dialog-Frame
      188   DO:
      189     assign ByGroup-NAME.
      190     if ByGroup-NAME then
      191       do:
      192           Pri-Mode = "group-name" .
      193           apply "GO" to frame Dialog-Frame .
      194       end.
      195   END.
      196   ON VALUE-CHANGED OF ByName IN FRAME Dialog-Frame
      197   DO:
      198     assign ByName.
      199     if ByName then
      200       do:
      201           Pri-Mode = "name" .
      202           apply "GO" to frame Dialog-Frame .
      203       end.
      204   END.
      205   ON VALUE-CHANGED OF ByPlu IN FRAME Dialog-Frame
      206   DO:
      207     assign ByPlu.
      208     if ByPlu then
      209       do:
      210           Pri-Mode = "plu" .
      211           apply "GO" to frame Dialog-Frame .
      212       end.
      213   END.
      214   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      215   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      216   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      217   on help of frame Dialog-Frame
      218   do:
      219     run gbl/app_help.p
      220       (input this-procedure :file-name
      221       ,input ''
      222       ,input ?
      223       ) no-error.
      224     if error-status :error then do:
      225       message
      226         "Ошибка при вызове помощи"
      227         error-status :get-message(1)
      228         view-as alert-box .
      229     end.
      230   end.
      231   run minbtn-set in this-procedure .
      232   on choose of b-help in frame Dialog-Frame
      233   do:
      234     apply "help":u to frame Dialog-Frame .
      235   end.
      236   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      237   procedure minbtn-set :
      238       do
      239           on error undo, return error return-value
      240           :
      241           define variable ii              as integer       no-undo .
      242           define variable fh              as widget-handle no-undo .
      243           define variable hh              as widget-handle no-undo .
      244           define variable v-h             as handle        extent 4 no-undo .
      245           define variable v-name-button   as character     no-undo .
      246           define variable v-help-old-x    as decimal       no-undo .
      247           define variable v-help-old-y    as decimal       no-undo .
      248           define variable v-help-old-size as decimal       no-undo .
      249           define variable v-frame-width   as decimal       no-undo .
      250           define variable jj              as integer       no-undo .
      251           do
      252               on error undo, return error
      253               :
      254               assign
      255                   v-frame-width = frame Dialog-Frame:width - 0.3
      256                   fh            = frame Dialog-Frame:first-child
      257                   hh            = fh:first-child
      258                   ii            = 1
      259                   .
      260               do while valid-handle(hh):
      261                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      262                   do:
      263                       case lc(hh:name) :
      264                           when "b-help" then
      265                               do:
      266                                   hh:load-image-up("cmp/b-help.bmp":u) .
      267                                   hh:load-image-down("cmp/b-help.bmp":u) .
      268                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      269                                   hh:TOOLTIP = "Помощь" .
      270                                   v-help-old-x = hh:column .
      271                                   v-help-old-y = hh:row    .
      272                                   v-help-old-size = hh:width .
      273                                   hh:width-chars = 2.5 .
      274                               end.
      275                           when "b-print" then
      276                               do:
      277                                   hh:load-image("cmp/b-print.bmp":u) .
      278                                   hh:TOOLTIP = "Печать" .
      279                                   v-h[ii] = hh:handle .
      280                                   ii = ii + 1 .
      281                                   hh:width-chars = 3 .
      282                               end.
      283                           when "b-history" or
      284                           when "b-hist" then
      285                               do:
      286                                   hh:load-image("cmp/b-hist.bmp":u) .
      287                                   hh:TOOLTIP = "История" .
      288                                   v-h[ii] = hh:handle .
      289                                   ii = ii + 1 .
      290                                   hh:width-chars = 3 .
      291                               end.
      292                           when "b-sch" then
      293                               do:
      294                                   hh:load-image("cmp/b-sch.bmp":u) .
      295                                   hh:TOOLTIP = "Установка Фильтра" .
      296                                   v-h[ii] = hh:handle .
      297                                   ii = ii + 1 .
      298                                   hh:width-chars = 3 .
      299                               end.
      300                           when "b-hist-user" then
      301                               do:
      302                                   hh:load-image("cmp/b-hist.bmp":u) .
      303                                   hh:TOOLTIP = "История пользователя" .
      304                                   ii = ii + 1 .
      305                               end.
      306                       end case.
      307                   end.
      308                   hh = hh:next-sibling.
      309               end.
      310               b-help:column = v-frame-width - b-help:width-chars.
      311               jj = 0.
      312               repeat ii = 4 to 1 by -1 :
      313                   if valid-handle (v-h[ii] ) then
      314                   do:
      315                       jj  = jj + 1 .
      316                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      317                       v-h[ii]:row    = v-help-old-y .
      318                   end.
      319               end.
      320           end.
      321       end.
      322   end procedure.
      323   MAIN-BLOCK:
      324   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      325      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      326     RUN enable_UI.
      327     WAIT-FOR GO OF FRAME Dialog-Frame.
      328   END.
      329   RUN disable_UI.
      330   PROCEDURE disable_UI :
      331     HIDE FRAME Dialog-Frame.
      332   END PROCEDURE.
      333   PROCEDURE enable_UI :
      334     DISPLAY ByBar ByPlu ByName ByGroup ByGroup-Name
      335         WITH FRAME Dialog-Frame.
      336     ENABLE b-quit RECT-23 b-help ByBar ByPlu ByName ByGroup ByGroup-Name
      337         WITH FRAME Dialog-Frame.
      338     VIEW FRAME Dialog-Frame.
      339   END PROCEDURE.
