      486   procedure uf-get :
      487     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      488     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      489     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      490     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      491     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      492     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      493     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      494     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      495     do
      496     on error undo, return error
      497     :
      498       define buffer buf_usr-flt for ubflt.usr-flt .
      499       define variable v-use-List_     as logical   no-undo .
      500       define variable v-type-List_     as character no-undo .
      501       define variable v-format-List_   as character no-undo .
      502       define variable v-use-Naim      as logical   no-undo .
      503       define variable v-type-Naim      as character no-undo .
      504       define variable v-format-Naim    as character no-undo .
      505       define variable v-use-print-graft as logical   no-undo .
      506       define variable v-use-sort-gr     as logical   no-undo .
      507       define variable v-use-type-price  as logical   no-undo .
      508       define variable v-use-type-val    as logical   no-undo .
      509       define variable v-label          as character no-undo .
      510       define variable v-tooltip        as character no-undo .
      511       define variable v-user-can-edit  as logical   no-undo .
      512       define variable v-output-display as logical   no-undo .
      513       define variable v-other          as character no-undo .
      514       run uf-name in this-procedure
      515          (input  entry(1, p-code, chr(4))
      516         ,output v-use-List_
      517         ,output v-type-List_
      518         ,output v-format-List_
      519         ,output v-use-Naim
      520         ,output v-type-Naim
      521         ,output v-format-Naim
      522         ,output v-use-print-graft
      523         ,output v-use-sort-gr
      524         ,output v-use-type-price
      525         ,output v-use-type-val
      526         ,output v-label
      527         ,output v-tooltip
      528         ,output v-user-can-edit
      529         ,output v-output-display
      530         ,output v-other
      531         ) no-error .
      532       if error-status :error then do:
      533         undo, return error return-value .
      534       end.
      535       find first buf_usr-flt no-lock where
      536                  buf_usr-flt.Call-point     = p-code AND
      537                  buf_usr-flt.user-name       = p-user-name
      538         no-error .
      539       if avail buf_usr-flt then do:
      540         assign
      541         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      542         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      543         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      544         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      545         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      546         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      547         .
      548       end.
      549       else do:
      550         assign
      551         p-List_        = (if v-use-List_       then "":U                    else ?)
      552         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      553         p-print-graft  = (if v-use-print-graft then no                      else ?)
      554         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      555         p-type-price   = (if v-use-type-price  then no                      else ?)
      556         p-type-val     = (if v-use-List_       then no                      else ?)
      557         .
      558       end.
      559     end.
      560   end procedure.
      561   procedure uf-set :
      562     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      563     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      564     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      565     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      566     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      567     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      568     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      569     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      570     do
      571     on error undo, return error
      572     :
      573       define buffer buf_usr-flt for ubflt.usr-flt .
      574       define variable v-use-List_     as logical   no-undo .
      575       define variable v-type-List_     as character no-undo .
      576       define variable v-format-List_   as character no-undo .
      577       define variable v-use-Naim      as logical   no-undo .
      578       define variable v-type-Naim      as character no-undo .
      579       define variable v-format-Naim    as character no-undo .
      580       define variable v-use-print-graft as logical   no-undo .
      581       define variable v-use-sort-gr   as logical   no-undo .
      582       define variable v-use-type-price as logical   no-undo .
      583       define variable v-use-type-val  as logical   no-undo .
      584       define variable v-tooltip        as character no-undo .
      585       define variable v-label          as character no-undo .
      586       define variable v-user-can-edit  as logical   no-undo .
      587       define variable v-output-display as logical   no-undo .
      588       define variable v-other          as character no-undo .
      589       run uf-name in this-procedure
      590         (input  entry(1, p-code, chr(4))
      591         ,output v-use-List_
      592         ,output v-type-List_
      593         ,output v-format-List_
      594         ,output v-use-Naim
      595         ,output v-type-Naim
      596         ,output v-format-Naim
      597         ,output v-use-print-graft
      598         ,output v-use-sort-gr
      599         ,output v-use-type-price
      600         ,output v-use-type-val
      601         ,output v-label
      602         ,output v-tooltip
      603         ,output v-user-can-edit
      604         ,output v-output-display
      605         ,output v-other
      606         ) no-error .
      607       if error-status :error then do:
      608         undo, return error return-value .
      609       end.
      610       find first buf_usr-flt where
      611                  buf_usr-flt.Call-point     = p-code AND
      612                  buf_usr-flt.user-name       = p-user-name
      613         no-error .
      614       if not avail buf_usr-flt then do:
      615           create buf_usr-flt .
      616           assign
      617           buf_usr-flt.call-point = p-code
      618           buf_usr-flt.user-name  = p-user-name
      619           .
      620       end.
      621       if avail buf_usr-flt then do:
      622        assign
      623        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      624        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      625        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      626        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      627        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      628        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      629       .
      630       release buf_usr-flt.
      631       end.
      632       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      633     end.
      634   end procedure.
      635   DEFINE VARIABLE v-all-ii AS INTEGER NO-UNDO.
      636   DEFINE BUTTON B-down
      637        IMAGE-UP FILE "btn-down-arrow":U
      638        IMAGE-DOWN FILE "btn-down-arrow":U
      639        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      640        LABEL "Вниз"
      641        SIZE 3 BY 1 TOOLTIP "Переместить запись ниже"
      642        BGCOLOR 8 .
      643   DEFINE BUTTON B-exit AUTO-GO
      644        LABEL "&Ввод"
      645        SIZE 10 BY 1
      646        BGCOLOR 8 .
      647   DEFINE BUTTON B-Help
      648        LABEL "Помо&щь"
      649        SIZE 3 BY 1
      650        BGCOLOR 8 .
      651   DEFINE BUTTON B-no-vis
      652        LABEL "Не вижу"
      653        SIZE 3 BY 1 TOOLTIP "Колонка не видна"
      654        BGCOLOR 8 .
      655   DEFINE BUTTON b-quit AUTO-END-KEY
      656        LABEL "&Отмена"
      657        SIZE 10 BY 1
      658        BGCOLOR 8 .
      659   DEFINE BUTTON B-up
      660        IMAGE-UP FILE "btn-up-arrow":U
      661        IMAGE-DOWN FILE "btn-up-arrow":U
      662        IMAGE-INSENSITIVE FILE "btn-up-arrow":U
      663        LABEL "Вверх"
      664        SIZE 3 BY 1 TOOLTIP "Переместить запись выше"
      665        BGCOLOR 8 .
      666   DEFINE BUTTON B-vis
      667        LABEL "Вижу"
      668        SIZE 3 BY 1 TOOLTIP "Колонка видна"
      669        BGCOLOR 8 .
      670   DEFINE QUERY BR-custom-labels FOR
      671         tt-custom-labels SCROLLING.
      672   DEFINE BROWSE BR-custom-labels
      673     QUERY BR-custom-labels NO-LOCK DISPLAY
      674         tt-custom-labels.custom-label COLUMN-LABEL "Лейбл" FORMAT "x(24)":U
      675   tt-custom-labels.custom-tooltip COLUMN-LABEL "Подсказка" FORMAT "x(255)":U WIDTH 50
      676   tt-custom-labels.field-vis COLUMN-LABEL "Вижу" VIEW-AS TOGGLE-BOX
      677   tt-custom-labels.field-siz COLUMN-LABEL "Ширина" FORMAT ">>9.99":U
      678   tt-custom-labels.visible-field-num COLUMN-LABEL "№№" FORMAT ">>9":U
      679   tt-custom-labels.field-num COLUMN-LABEL "№№" FORMAT ">>9":U
      680   ENABLE
      681   tt-custom-labels.field-vis
      682   tt-custom-labels.field-siz
      683       WITH NO-ROW-MARKERS SEPARATORS SIZE 95 BY 21.27 FIT-LAST-COLUMN.
      684   DEFINE FRAME Dialog-Frame
      685        B-exit AT ROW 1 COL 1
      686        b-quit AT ROW 1 COL 11
      687        B-Help AT ROW 1 COL 95
      688        BR-custom-labels AT ROW 2 COL 1 WIDGET-ID 100
      689        B-up AT ROW 2.33 COL 96 WIDGET-ID 2
      690        B-down AT ROW 3.57 COL 96 WIDGET-ID 4
      691        B-vis AT ROW 4.83 COL 96 WIDGET-ID 6
      692        B-no-vis AT ROW 6.13 COL 96 WIDGET-ID 8
      693        SPACE(0.70) SKIP(16.14)
      694       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      695            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      696            TITLE "Выбор и конфигурирование настраиваемых полей"
      697            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      698   ASSIGN
      699          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      700          FRAME Dialog-Frame:HIDDEN           = TRUE.
      701   ASSIGN
      702          B-no-vis:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      703   ASSIGN
      704          B-vis:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      705   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      706   DO:
      707     APPLY "END-ERROR":U TO SELF.
      708   END.
      709   ON CHOOSE OF B-down IN FRAME Dialog-Frame
      710   DO:
      711   define buffer buf_next for tt-custom-labels  .
      712   define variable old-number as integer   no-undo .
      713   define variable new-number as integer   no-undo .
      714   define variable v-recid as recid no-undo .
      715     if available tt-custom-labels then do:
      716     v-recid = recid (tt-custom-labels) .
      717     old-number = tt-custom-labels.visible-field-num .
      718     new-number = tt-custom-labels.visible-field-num + 1 .
      719     find first buf_next where buf_next.visible-field-num = new-number no-error .
      720       if available buf_next then do:
      721         buf_next.visible-field-num  = old-number .
      722         tt-custom-labels.visible-field-num = new-number .
      723         OPEN QUERY BR-custom-labels FOR EACH tt-custom-labels BY tt-custom-labels.field-vis DESCENDING BY tt-custom-labels.visible-field-num BY tt-custom-labels.custom-label      INDEXED-REPOSITION .
      724         reposition BR-custom-labels to recid v-recid no-error.
      725       end.
      726     end.
      727   END.
      728   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      729   DO:
      730     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      731     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      732     p-ok = yes.
      733   END.
      734   ON CHOOSE OF B-no-vis IN FRAME Dialog-Frame
      735   DO:
      736   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      737     if available tt-custom-labels then do:
      738         tt-custom-labels.field-vis = false .
      739         glog =  BR-custom-labels:refresh() .
      740         glog = BR-custom-labels:select-next-row().
      741     end.
      742   END.
      743   ON CHOOSE OF B-up IN FRAME Dialog-Frame
      744   DO:
      745   define buffer buf_prev for tt-custom-labels  .
      746   define variable old-number as integer   no-undo .
      747   define variable new-number as integer   no-undo .
      748   define variable v-recid as recid no-undo .
      749     if available tt-custom-labels then do:
      750     v-recid = recid (tt-custom-labels) .
      751     old-number = tt-custom-labels.visible-field-num .
      752     new-number = tt-custom-labels.visible-field-num - 1 .
      753     find first buf_prev where buf_prev.visible-field-num = new-number no-error .
      754       if available buf_prev then do:
      755         buf_prev.visible-field-num  = old-number .
      756         tt-custom-labels.visible-field-num = new-number .
      757         OPEN QUERY BR-custom-labels FOR EACH tt-custom-labels BY tt-custom-labels.field-vis DESCENDING BY tt-custom-labels.visible-field-num BY tt-custom-labels.custom-label      INDEXED-REPOSITION .
      758         reposition BR-custom-labels to recid v-recid no-error.
      759       end.
      760     end.
      761   END.
      762   ON CHOOSE OF B-vis IN FRAME Dialog-Frame
      763   DO:
      764   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      765     if available tt-custom-labels then do:
      766         tt-custom-labels.field-vis = true  .
      767         glog =  BR-custom-labels:refresh().
      768         glog = BR-custom-labels:select-next-row().
      769     end.
      770   END.
      771   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      772   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      773   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      774   on help of frame Dialog-Frame
      775   do:
      776     run gbl/app_help.p
      777       (input this-procedure :file-name
      778       ,input ''
      779       ,input ?
      780       ) no-error.
      781     if error-status :error then do:
      782       message
      783         "Ошибка при вызове помощи"
      784         error-status :get-message(1)
      785         view-as alert-box .
      786     end.
      787   end.
      788   run minbtn-set in this-procedure .
      789   on choose of b-help in frame Dialog-Frame
      790   do:
      791     apply "help":u to frame Dialog-Frame .
      792   end.
      793   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      794   procedure minbtn-set :
      795       do
      796           on error undo, return error return-value
      797           :
      798           define variable ii              as integer       no-undo .
      799           define variable fh              as widget-handle no-undo .
      800           define variable hh              as widget-handle no-undo .
      801           define variable v-h             as handle        extent 4 no-undo .
      802           define variable v-name-button   as character     no-undo .
      803           define variable v-help-old-x    as decimal       no-undo .
      804           define variable v-help-old-y    as decimal       no-undo .
      805           define variable v-help-old-size as decimal       no-undo .
      806           define variable v-frame-width   as decimal       no-undo .
      807           define variable jj              as integer       no-undo .
      808           do
      809               on error undo, return error
      810               :
      811               assign
      812                   v-frame-width = frame Dialog-Frame:width - 0.3
      813                   fh            = frame Dialog-Frame:first-child
      814                   hh            = fh:first-child
      815                   ii            = 1
      816                   .
      817               do while valid-handle(hh):
      818                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      819                   do:
      820                       case lc(hh:name) :
      821                           when "b-help" then
      822                               do:
      823                                   hh:load-image-up("cmp/b-help.bmp":u) .
      824                                   hh:load-image-down("cmp/b-help.bmp":u) .
      825                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      826                                   hh:TOOLTIP = "Помощь" .
      827                                   v-help-old-x = hh:column .
      828                                   v-help-old-y = hh:row    .
      829                                   v-help-old-size = hh:width .
      830                                   hh:width-chars = 2.5 .
      831                               end.
      832                           when "b-print" then
      833                               do:
      834                                   hh:load-image("cmp/b-print.bmp":u) .
      835                                   hh:TOOLTIP = "Печать" .
      836                                   v-h[ii] = hh:handle .
      837                                   ii = ii + 1 .
      838                                   hh:width-chars = 3 .
      839                               end.
      840                           when "b-history" or
      841                           when "b-hist" then
      842                               do:
      843                                   hh:load-image("cmp/b-hist.bmp":u) .
      844                                   hh:TOOLTIP = "История" .
      845                                   v-h[ii] = hh:handle .
      846                                   ii = ii + 1 .
      847                                   hh:width-chars = 3 .
      848                               end.
      849                           when "b-sch" then
      850                               do:
      851                                   hh:load-image("cmp/b-sch.bmp":u) .
      852                                   hh:TOOLTIP = "Установка Фильтра" .
      853                                   v-h[ii] = hh:handle .
      854                                   ii = ii + 1 .
      855                                   hh:width-chars = 3 .
      856                               end.
      857                           when "b-hist-user" then
      858                               do:
      859                                   hh:load-image("cmp/b-hist.bmp":u) .
      860                                   hh:TOOLTIP = "История пользователя" .
      861                                   ii = ii + 1 .
      862                               end.
      863                       end case.
      864                   end.
      865                   hh = hh:next-sibling.
      866               end.
      867               b-help:column = v-frame-width - b-help:width-chars.
      868               jj = 0.
      869               repeat ii = 4 to 1 by -1 :
      870                   if valid-handle (v-h[ii] ) then
      871                   do:
      872                       jj  = jj + 1 .
      873                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      874                       v-h[ii]:row    = v-help-old-y .
      875                   end.
      876               end.
      877           end.
      878       end.
      879   end procedure.
      880   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      881   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      882   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      883   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      884   define variable v-diasize-current-frame-width  as decimal   no-undo .
      885   define variable v-diasize-current-frame-height as decimal   no-undo .
      886   define variable v-diasize-change-size          as logical   no-undo .
      887   define variable v-diasize-resize-button        as handle    no-undo .
      888   define variable v-diasize-wndmax               as logical   no-undo .
      889   define variable v-diasize-wndstore             as logical   no-undo .
      890   define variable v-diasize-proc-name            as character no-undo .
      891   define variable v-diasize-browse-handle        as handle    no-undo .
      892   define variable v-diasize-browse-number        as integer   no-undo .
      893   define variable v-diasize-need-full-display    as logical   no-undo init false .
      894   define temp-table temp-diasize-handle no-undo
      895     field handle-value  as handle
      896     field save-position as decimal
      897     index xpk is primary unique handle-value
      898     .
      899   define temp-table temp-browse-handle no-undo
      900     field browse-type   as character
      901     field browse-number as integer
      902     field browse-handle as handle
      903     field original-size as decimal
      904     index xpk is primary unique browse-type browse-number
      905     index xie browse-type browse-handle
      906   .
      907   procedure diasize_change-height :
      908     define input  parameter p-change-value  as decimal   no-undo .
      909     define input  parameter p-move-resize   as logical   no-undo .
      910     define variable v-field-group-handle    as handle    no-undo .
      911     define variable v-object-handle         as handle    no-undo .
      912     define variable v-frame-height          as decimal   no-undo .
      913     define variable v-frame-virtual-height  as decimal   no-undo .
      914     define variable v-browse-height         as decimal   no-undo .
      915     define variable v-window-height         as decimal   no-undo .
      916     define variable v-window-virtual-height as decimal   no-undo .
      917     define variable v-change-sign           as integer   no-undo .
      918     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      919     define buffer buf_temp-browse-handle  for temp-browse-handle .
      920     if p-change-value > 0
      921     then do:
      922       if frame Dialog-Frame :height + p-change-value
      923           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      924       then do:
      925         assign
      926           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      927                           - (frame Dialog-Frame :height-chars)
      928         .
      929         if p-change-value <= 0
      930         then do:
      931           run diasize_position-resize-button in this-procedure .
      932           return .
      933         end.
      934       end.
      935     end.
      936     if p-change-value < 0
      937     then do:
      938       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      939       then do:
      940         assign
      941           p-change-value = v-diasize-orig-frame-height
      942                          - (frame Dialog-Frame :height-chars)
      943         .
      944         if p-change-value >= 0
      945         then do:
      946           run diasize_position-resize-button in this-procedure .
      947           return .
      948         end.
      949       end.
      950     end.
      951     if p-change-value >= 0
      952     then do:
      953       assign
      954         v-change-sign = 1
      955       .
      956     end.
      957     else do:
      958       assign
      959         v-change-sign = -1
      960       .
      961     end.
      962     assign
      963       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      964     .
      965     if p-change-value = 0
      966     then do:
      967       run diasize_position-resize-button in this-procedure .
      968       return .
      969     end.
      970     move_block:
      971     do
      972     on error undo move_block, retry move_block
      973     :
      974       if retry
      975       then do:
      976         do
      977         on error undo move_block, leave move_block
      978         :
      979           if p-change-value > 0
      980           then do:
      981             for each buf_temp-diasize-handle
      982             on error undo, next
      983             :
      984               assign
      985                 v-object-handle = buf_temp-diasize-handle.handle-value
      986               .
      987               if v-object-handle <> v-diasize-resize-button
      988               then do:
      989                 assign
      990                   v-object-handle :row = buf_temp-diasize-handle.save-position
      991                 .
      992               end.
      993             end.
      994             assign
      995               v-diasize-browse-handle :height = v-browse-height
      996             .
      997             for each buf_temp-browse-handle
      998               where buf_temp-browse-handle.browse-type = 'height':u
      999             on error undo, next
     1000             :
     1001               assign
     1002                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1003               .
     1004             end.
     1005             assign
     1006               frame Dialog-Frame :height = v-frame-height
     1007             .
     1008             if frame Dialog-Frame :scrollable = true
     1009             then do:
     1010               assign
     1011                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1012               .
     1013             end.
     1014             run diasize_position-resize-button in this-procedure .
     1015           end.
     1016           else do:
     1017             if frame Dialog-Frame :scrollable = true
     1018             then do:
     1019               assign
     1020                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1021               .
     1022             end.
     1023             assign
     1024               frame Dialog-Frame :height = v-frame-height
     1025             .
     1026             assign
     1027               v-diasize-browse-handle :height = v-browse-height
     1028             .
     1029             for each buf_temp-browse-handle
     1030               where buf_temp-browse-handle.browse-type = 'height':u
     1031             on error undo, next
     1032             :
     1033               assign
     1034                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1035               .
     1036             end.
     1037             for each buf_temp-diasize-handle
     1038             on error undo, next
     1039             :
     1040               assign
     1041                 v-object-handle = buf_temp-diasize-handle.handle-value
     1042               .
     1043               if v-object-handle <> v-diasize-resize-button
     1044               then do:
     1045                 assign
     1046                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1047                 .
     1048               end.
     1049             end.
     1050             run diasize_position-resize-button in this-procedure .
     1051           end.
     1052           assign
     1053             v-diasize-change-size = false
     1054           .
     1055           leave move_block .
     1056         end.
     1057       end.
     1058       assign
     1059         v-diasize-need-full-display = true
     1060       .
     1061       if v-diasize-change-size = false
     1062       then do:
     1063         assign
     1064           v-diasize-change-size = true
     1065         .
     1066       end.
     1067       else do:
     1068         return .
     1069       end.
     1070       assign
     1071         v-frame-height = frame Dialog-Frame :height
     1072         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1073         v-browse-height = v-diasize-browse-handle :height
     1074       .
     1075       for each buf_temp-browse-handle
     1076         where buf_temp-browse-handle.browse-type = 'height':u
     1077       :
     1078         assign
     1079           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1080         .
     1081       end.
     1082       for each buf_temp-diasize-handle
     1083       :
     1084         delete buf_temp-diasize-handle .
     1085       end.
     1086       assign
     1087         v-field-group-handle = frame Dialog-Frame :first-child
     1088       .
     1089       do while valid-handle(v-field-group-handle)
     1090       :
     1091         assign
     1092           v-object-handle = v-field-group-handle :first-child
     1093         .
     1094         do while valid-handle(v-object-handle)
     1095         :
     1096           if  v-object-handle <> v-diasize-browse-handle :handle
     1097           and can-query(v-object-handle, "row")
     1098           and can-query(v-object-handle, "height")
     1099           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1100           then do:
     1101             find first buf_temp-browse-handle
     1102               where buf_temp-browse-handle.browse-type   = 'height':u
     1103                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1104               no-error .
     1105             if available buf_temp-browse-handle
     1106             then do:
     1107             end.
     1108             else do:
     1109               create buf_temp-diasize-handle .
     1110               assign
     1111                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1112                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1113               .
     1114             end.
     1115           end.
     1116           assign
     1117             v-object-handle = v-object-handle :next-sibling
     1118           .
     1119         end.
     1120         assign
     1121           v-field-group-handle = v-field-group-handle :next-sibling
     1122         .
     1123       end.
     1124       do with frame Dialog-Frame
     1125       :
     1126         hide v-diasize-resize-button .
     1127         assign
     1128           v-diasize-resize-button :row    = 1
     1129           v-diasize-resize-button :column = 1
     1130         .
     1131       end.
     1132       if p-change-value > 0
     1133       then do:
     1134         if frame Dialog-Frame :scrollable = true
     1135         then do:
     1136           assign
     1137             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1138             no-error .
     1139           if error-status :error
     1140           or error-status :get-message(1) <> ""
     1141           then do:
     1142             undo move_block, retry move_block .
     1143           end.
     1144         end.
     1145         assign
     1146           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1147           no-error .
     1148         if error-status :error
     1149         or error-status :get-message(1) <> ""
     1150         then do:
     1151           undo move_block, retry move_block .
     1152         end.
     1153         assign
     1154           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1155           no-error .
     1156         if error-status :error
     1157         or error-status :get-message(1) <> ""
     1158         then do:
     1159           undo move_block, retry move_block .
     1160         end.
     1161         for each buf_temp-browse-handle
     1162           where buf_temp-browse-handle.browse-type = 'height':u
     1163         on error undo move_block, retry move_block
     1164         :
     1165           assign
     1166             buf_temp-browse-handle.browse-handle :height
     1167               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1168             no-error .
     1169           if error-status :error
     1170           or error-status :get-message(1) <> ""
     1171           then do:
     1172             undo move_block, retry move_block .
     1173           end.
     1174         end.
     1175         for each buf_temp-diasize-handle
     1176         on error undo move_block, retry move_block
     1177         :
     1178           assign
     1179             v-object-handle = buf_temp-diasize-handle.handle-value
     1180           .
     1181           if v-object-handle <> v-diasize-resize-button
     1182           then do:
     1183             assign
     1184               v-object-handle :row = v-object-handle :row + p-change-value
     1185               no-error .
     1186             if error-status :error
     1187             or error-status :get-message(1) <> ""
     1188             then do:
     1189               undo move_block, retry move_block .
     1190             end.
     1191           end.
     1192         end.
     1193       end.
     1194       else do:
     1195         for each buf_temp-diasize-handle
     1196         on error undo move_block, retry move_block
     1197         :
     1198           assign
     1199             v-object-handle = buf_temp-diasize-handle.handle-value
     1200           .
     1201           if v-object-handle <> v-diasize-resize-button
     1202           then do:
     1203             assign
     1204               v-object-handle :row = v-object-handle :row + p-change-value
     1205               no-error .
     1206             if error-status :error
     1207             or error-status :get-message(1) <> ""
     1208             then do:
     1209               undo move_block, retry move_block .
     1210             end.
     1211           end.
     1212         end.
     1213         assign
     1214           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1215           no-error .
     1216         if error-status :error
     1217         or error-status :get-message(1) <> ""
     1218         then do:
     1219           undo move_block, retry move_block .
     1220         end.
     1221         for each buf_temp-browse-handle
     1222           where buf_temp-browse-handle.browse-type = 'height':u
     1223         on error undo move_block, retry move_block
     1224         :
     1225           assign
     1226             buf_temp-browse-handle.browse-handle :height
     1227               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1228             no-error .
     1229           if error-status :error
     1230           or error-status :get-message(1) <> ""
     1231           then do:
     1232             undo move_block, retry move_block .
     1233           end.
     1234         end.
     1235         assign
     1236           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1237           no-error .
     1238         if error-status :error
     1239         or error-status :get-message(1) <> ""
     1240         then do:
     1241           undo move_block, retry move_block .
     1242         end.
     1243         if frame Dialog-Frame :scrollable = true
     1244         then do:
     1245           assign
     1246             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1247             no-error .
     1248           if error-status :error
     1249           or error-status :get-message(1) <> ""
     1250           then do:
     1251             undo move_block, retry move_block .
     1252           end.
     1253         end.
     1254       end.
     1255       if p-move-resize = true
     1256       then do:
     1257         run diasize_position-resize-button in this-procedure .
     1258       end.
     1259       if v-diasize-wndstore = true
     1260       then do:
     1261         if connected("ub") = true
     1262         then do:
     1263           define variable v-cntxt-db-num        as integer   no-undo .
     1264           define variable v-cntxt-userid        as character no-undo .
     1265           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1266                                             , OUTPUT v-cntxt-userid
     1267                                             ) .
     1268           run gbl/wndsizew.p
     1269             (input  v-cntxt-db-num
     1270             ,input  v-cntxt-userid
     1271             ,input  v-diasize-proc-name
     1272             ,input  'height':u
     1273             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1274             ) .
     1275         end.
     1276       end.
     1277     end.
     1278     assign
     1279       v-diasize-change-size = false
     1280     .
     1281   end procedure.
     1282   procedure diasize_set-height :
     1283     define input  parameter p-new-height  as decimal   no-undo .
     1284     define input  parameter p-move-resize as logical   no-undo .
     1285     do
     1286     on error undo, return error return-value
     1287     :
     1288       run diasize_change-height in this-procedure
     1289         (input  (p-new-height - frame Dialog-Frame :height)
     1290         ,input  p-move-resize
     1291         ) .
     1292     end.
     1293   end procedure.
     1294   procedure diasize_change-width :
     1295     define input  parameter p-change-value as decimal   no-undo .
     1296     define input  parameter p-move-resize  as logical   no-undo .
     1297     define variable v-field-group-handle   as handle    no-undo .
     1298     define variable v-object-handle        as handle    no-undo .
     1299     define variable v-frame-width          as decimal   no-undo .
     1300     define variable v-frame-virtual-width  as decimal   no-undo .
     1301     define variable v-browse-width         as decimal   no-undo .
     1302     define variable v-window-width         as decimal   no-undo .
     1303     define variable v-window-virtual-width as decimal   no-undo .
     1304     define variable v-change-sign          as integer   no-undo .
     1305     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1306     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1307     if p-change-value > 0
     1308     then do:
     1309       if frame Dialog-Frame :width + p-change-value >
     1310           session :width-chars
     1311       then do:
     1312         assign
     1313           p-change-value = session :width-chars - frame Dialog-Frame :width
     1314         .
     1315         if p-change-value <= 0
     1316         then do:
     1317           run diasize_position-resize-button in this-procedure .
     1318           return .
     1319         end.
     1320       end.
     1321     end.
     1322     if p-change-value < 0
     1323     then do:
     1324       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1325       then do:
     1326         assign
     1327           p-change-value = v-diasize-orig-frame-width
     1328                          - frame Dialog-Frame :width
     1329         .
     1330         if p-change-value >= 0
     1331         then do:
     1332           run diasize_position-resize-button in this-procedure .
     1333           return .
     1334         end.
     1335       end.
     1336     end.
     1337     if p-change-value >= 0
     1338     then do:
     1339       assign
     1340         v-change-sign = 1
     1341       .
     1342     end.
     1343     else do:
     1344       assign
     1345         v-change-sign = -1
     1346       .
     1347     end.
     1348     assign
     1349       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1350     .
     1351     if p-change-value = 0
     1352     then do:
     1353       run diasize_position-resize-button in this-procedure .
     1354       return .
     1355     end.
     1356     move_block:
     1357     do
     1358     on error undo move_block, leave move_block
     1359     :
     1360       if retry
     1361       then do:
     1362         do
     1363         on error undo move_block, leave move_block
     1364         :
     1365           if p-change-value > 0
     1366           then do:
     1367             for each buf_temp-diasize-handle
     1368             on error undo, next
     1369             :
     1370               assign
     1371                 v-object-handle = buf_temp-diasize-handle.handle-value
     1372               .
     1373               if v-object-handle <> v-diasize-resize-button
     1374               then do:
     1375                 assign
     1376                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1377                 .
     1378               end.
     1379             end.
     1380             assign
     1381               v-diasize-browse-handle :width = v-browse-width
     1382             .
     1383             for each buf_temp-browse-handle
     1384               where buf_temp-browse-handle.browse-type = 'width':u
     1385             on error undo, next
     1386             :
     1387               assign
     1388                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1389               .
     1390             end.
     1391             assign
     1392               frame Dialog-Frame :width = v-frame-width
     1393             .
     1394             if frame Dialog-Frame :scrollable = true
     1395             then do:
     1396               assign
     1397                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1398               .
     1399             end.
     1400             run diasize_position-resize-button in this-procedure .
     1401           end.
     1402           else do:
     1403             if frame Dialog-Frame :scrollable = true
     1404             then do:
     1405               assign
     1406                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1407               .
     1408             end.
     1409             assign
     1410               frame Dialog-Frame :width = v-frame-width
     1411             .
     1412             for each buf_temp-browse-handle
     1413               where buf_temp-browse-handle.browse-type = 'width':u
     1414             on error undo, next
     1415             :
     1416               assign
     1417                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1418               .
     1419             end.
     1420             assign
     1421               v-diasize-browse-handle :width = v-browse-width
     1422             .
     1423             for each buf_temp-diasize-handle
     1424             on error undo, next
     1425             :
     1426               assign
     1427                 v-object-handle = buf_temp-diasize-handle.handle-value
     1428               .
     1429               if v-object-handle <> v-diasize-resize-button
     1430               then do:
     1431                 assign
     1432                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1433                 .
     1434               end.
     1435             end.
     1436             run diasize_position-resize-button in this-procedure .
     1437           end.
     1438           assign
     1439             v-diasize-change-size = false
     1440           .
     1441           leave move_block .
     1442         end.
     1443       end.
     1444       assign
     1445         v-diasize-need-full-display = true
     1446       .
     1447       if v-diasize-change-size = false
     1448       then do:
     1449         assign
     1450           v-diasize-change-size = true
     1451         .
     1452       end.
     1453       else do:
     1454         return .
     1455       end.
     1456       assign
     1457         v-frame-width = frame Dialog-Frame :width
     1458         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1459         v-browse-width = v-diasize-browse-handle :width
     1460       .
     1461       for each buf_temp-browse-handle
     1462         where buf_temp-browse-handle.browse-type = 'width':u
     1463       :
     1464         assign
     1465           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1466         .
     1467       end.
     1468       for each buf_temp-diasize-handle
     1469       :
     1470         delete buf_temp-diasize-handle .
     1471       end.
     1472       assign
     1473         v-field-group-handle = frame Dialog-Frame :first-child
     1474       .
     1475       do while valid-handle(v-field-group-handle)
     1476       :
     1477         assign
     1478           v-object-handle = v-field-group-handle :first-child
     1479         .
     1480         do while valid-handle(v-object-handle)
     1481         :
     1482           if  v-object-handle <> v-diasize-browse-handle :handle
     1483           and v-object-handle <> v-diasize-resize-button
     1484           and can-query(v-object-handle, "row")
     1485           and can-query(v-object-handle, "height")
     1486           and ( v-object-handle :col + v-object-handle :width
     1487                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1488               )
     1489           then do:
     1490             find first buf_temp-browse-handle
     1491               where buf_temp-browse-handle.browse-type   = 'width':u
     1492                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1493               no-error .
     1494             if available buf_temp-browse-handle
     1495             then do:
     1496             end.
     1497             else do:
     1498               create buf_temp-diasize-handle .
     1499               assign
     1500                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1501                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1502               .
     1503             end.
     1504           end.
     1505           assign
     1506             v-object-handle = v-object-handle :next-sibling
     1507           .
     1508         end.
     1509         assign
     1510           v-field-group-handle = v-field-group-handle :next-sibling
     1511         .
     1512       end.
     1513       do with frame Dialog-Frame
     1514       :
     1515         hide v-diasize-resize-button .
     1516         v-diasize-resize-button :row = 1.
     1517         v-diasize-resize-button :column = 1.
     1518       end.
     1519       if p-change-value > 0
     1520       then do:
     1521         if frame Dialog-Frame :scrollable = true
     1522         then do:
     1523           assign
     1524             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1525             no-error .
     1526           if error-status :error
     1527           or error-status :get-message(1) <> ""
     1528           then do:
     1529             undo move_block, retry move_block.
     1530           end.
     1531         end.
     1532         assign
     1533           frame Dialog-Frame :width = v-frame-width + p-change-value
     1534           no-error .
     1535         if error-status :error
     1536         or error-status :get-message(1) <> ""
     1537         then do:
     1538           undo move_block, retry move_block.
     1539         end.
     1540         assign
     1541           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1542         no-error .
     1543         if error-status :error
     1544         or error-status :get-message(1) <> ""
     1545         then do:
     1546           undo move_block, retry move_block.
     1547         end.
     1548         for each buf_temp-browse-handle
     1549           where buf_temp-browse-handle.browse-type = 'width':u
     1550         on error undo move_block, retry move_block
     1551         :
     1552           assign
     1553             buf_temp-browse-handle.browse-handle :width
     1554               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1555             no-error .
     1556           if error-status :error
     1557           or error-status :get-message(1) <> ""
     1558           then do:
     1559             undo move_block, retry move_block .
     1560           end.
     1561         end.
     1562         for each buf_temp-diasize-handle
     1563         on error undo move_block, retry move_block
     1564         :
     1565           assign
     1566             v-object-handle = buf_temp-diasize-handle.handle-value
     1567           .
     1568           if v-object-handle <> v-diasize-resize-button
     1569           then do:
     1570             assign
     1571               v-object-handle :col = v-object-handle :col + p-change-value
     1572               no-error .
     1573             if error-status :error
     1574             or error-status :get-message(1) <> ""
     1575             then do:
     1576               undo move_block, retry move_block .
     1577             end.
     1578           end.
     1579         end.
     1580       end.
     1581       else do:
     1582         for each buf_temp-diasize-handle
     1583         on error undo move_block, retry move_block
     1584         :
     1585           assign
     1586             v-object-handle = buf_temp-diasize-handle.handle-value
     1587           .
     1588           if v-object-handle <> v-diasize-resize-button
     1589           then do:
     1590             assign
     1591               v-object-handle :col = v-object-handle :col + p-change-value
     1592               no-error .
     1593             if error-status :error
     1594             or error-status :get-message(1) <> ""
     1595             then do:
     1596               undo move_block, retry move_block .
     1597             end.
     1598           end.
     1599         end.
     1600         for each buf_temp-browse-handle
     1601           where buf_temp-browse-handle.browse-type = 'width':u
     1602         on error undo move_block, retry move_block
     1603         :
     1604           assign
     1605             buf_temp-browse-handle.browse-handle :width
     1606               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1607             no-error .
     1608           if error-status :error
     1609           or error-status :get-message(1) <> ""
     1610           then do:
     1611             undo move_block, retry move_block .
     1612           end.
     1613         end.
     1614         assign
     1615           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1616           no-error .
     1617         if error-status :error
     1618         or error-status :get-message(1) <> ""
     1619         then do:
     1620           undo move_block, retry move_block.
     1621         end.
     1622         assign
     1623           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1624         no-error .
     1625         if error-status :error
     1626         or error-status :get-message(1) <> ""
     1627         then do:
     1628           undo move_block, retry move_block.
     1629         end.
     1630         if frame Dialog-Frame :scrollable = true
     1631         then do:
     1632           assign
     1633             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1634           no-error .
     1635           if error-status :error
     1636           or error-status :get-message(1) <> ""
     1637           then do:
     1638             undo move_block, retry move_block.
     1639           end.
     1640         end.
     1641       end.
     1642       if p-move-resize
     1643       then do:
     1644         run diasize_position-resize-button in this-procedure .
     1645       end.
     1646       if v-diasize-wndstore = true
     1647       then do:
     1648         if connected("ub") = true
     1649         then do:
     1650           define variable v-cntxt-db-num        as integer   no-undo .
     1651           define variable v-cntxt-userid        as character no-undo .
     1652           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1653                                             , OUTPUT v-cntxt-userid
     1654                                             ) .
     1655           run gbl/wndsizew.p
     1656             (input  v-cntxt-db-num
     1657             ,input  v-cntxt-userid
     1658             ,input  v-diasize-proc-name
     1659             ,input  'width':u
     1660             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1661             ) .
     1662         end.
     1663       end.
     1664     end.
     1665     assign
     1666       v-diasize-change-size = false
     1667     .
     1668   end procedure.
     1669   procedure diasize_set-width :
     1670     define input  parameter p-new-width  as decimal   no-undo .
     1671     define input  parameter p-move-resize as logical   no-undo .
     1672     do
     1673     on error undo, return error return-value
     1674     :
     1675       run diasize_change-width in this-procedure
     1676         (input  (p-new-width - frame Dialog-Frame :width)
     1677         ,input  p-move-resize
     1678         ) .
     1679     end.
     1680   end procedure.
     1681   procedure diasize_position-resize-button :
     1682     do with frame Dialog-Frame
     1683     :
     1684       hide v-diasize-resize-button .
     1685       assign
     1686         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1687                     - 1
     1688                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1689         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1690                     - 1
     1691                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1692       .
     1693       view v-diasize-resize-button .
     1694     end.
     1695   end procedure.
     1696   on alt-right anywhere
     1697   do:
     1698     run diasize_change-width in this-procedure
     1699       (input 1
     1700       ,input true
     1701       ) .
     1702     return no-apply .
     1703   end.
     1704   on alt-left anywhere
     1705   do:
     1706     run diasize_change-width in this-procedure
     1707       (input -1
     1708       ,input true
     1709       ) .
     1710     return no-apply .
     1711   end.
     1712   on alt-down anywhere
     1713   do:
     1714     run diasize_change-height in this-procedure
     1715       (input 1
     1716       ,input true
     1717       ) .
     1718     return no-apply .
     1719   end.
     1720   on alt-up anywhere
     1721   do:
     1722     run diasize_change-height in this-procedure
     1723       (input -1
     1724       ,input true
     1725       ) .
     1726     return no-apply .
     1727   end.
     1728   on alt-enter of frame Dialog-Frame
     1729   do:
     1730     run diasize_maximize in this-procedure
     1731       (input  ?
     1732       ).
     1733     return no-apply .
     1734   end.
     1735   procedure diasize_end-move :
     1736     do
     1737     on error undo, return error return-value
     1738     :
     1739       define variable v-row-delta as decimal   no-undo .
     1740       define variable v-col-delta as decimal   no-undo .
     1741       define variable v-new-row as decimal   no-undo .
     1742       define variable v-new-col as decimal   no-undo .
     1743       assign
     1744         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1745         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1746       .
     1747       assign
     1748         v-row-delta = v-new-row - frame Dialog-Frame :height
     1749         v-col-delta = v-new-col - frame Dialog-Frame :width
     1750       .
     1751       run diasize_change-height in this-procedure
     1752         (input v-row-delta
     1753         ,input true
     1754         ) .
     1755       run diasize_change-width in this-procedure
     1756         (input v-col-delta
     1757         ,input true
     1758         ) .
     1759     end.
     1760   end procedure.
     1761   procedure diasize_maximize :
     1762     define input  parameter p-action as logical   no-undo .
     1763     do
     1764     on error undo, return error return-value
     1765     :
     1766       if p-action = ?
     1767       then do:
     1768         if v-diasize-need-maximize = true
     1769         then do:
     1770           assign
     1771             p-action = true
     1772           .
     1773         end.
     1774         else do:
     1775           assign
     1776             p-action = false
     1777           .
     1778         end.
     1779       end.
     1780       if p-action = true
     1781       then do:
     1782         run diasize_change-height in this-procedure
     1783           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1784               - frame Dialog-Frame :height-chars
     1785           ,input true
     1786           ) .
     1787         run diasize_change-width in this-procedure
     1788           (input session :width-chars
     1789               - frame Dialog-Frame :width-chars
     1790           ,input true
     1791           ) .
     1792         assign
     1793           v-diasize-need-maximize = false
     1794         .
     1795       end.
     1796       else do:
     1797         run diasize_change-width in this-procedure
     1798           (input v-diasize-orig-frame-width
     1799               - frame Dialog-Frame :width-chars
     1800           ,input true
     1801           ) .
     1802         run diasize_change-height in this-procedure
     1803           (input v-diasize-orig-frame-height
     1804               - frame Dialog-Frame :height-chars
     1805           ,input true
     1806           ) .
     1807         assign
     1808           v-diasize-need-maximize = true
     1809         .
     1810       end.
     1811     end.
     1812   end procedure.
     1813   procedure diasize_restore-orig-size :
     1814     do
     1815     on error undo, return error return-value
     1816     :
     1817       assign
     1818         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1819         v-diasize-current-frame-height = frame Dialog-Frame :height
     1820       .
     1821       run diasize_set-height in this-procedure
     1822         (input  v-diasize-orig-frame-height
     1823         ,input  true
     1824         ) .
     1825       run diasize_set-width in this-procedure
     1826         (input  v-diasize-orig-frame-width
     1827         ,input  true
     1828         ) .
     1829     end.
     1830   end procedure.
     1831   procedure diasize_restore-current-size :
     1832     do
     1833     on error undo, return error return-value
     1834     :
     1835       run diasize_set-height in this-procedure
     1836         (input  v-diasize-current-frame-height
     1837         ,input  true
     1838         ) .
     1839       run diasize_set-width in this-procedure
     1840         (input  v-diasize-current-frame-width
     1841         ,input  true
     1842         ) .
     1843     end.
     1844   end procedure.
     1845   procedure diasize_set-browse-handle :
     1846     define input  parameter p-browse-handle as handle   no-undo .
     1847     define buffer buf_temp-browse-handle for temp-browse-handle .
     1848     do
     1849     on error undo, return error return-value
     1850     :
     1851       assign
     1852         v-diasize-browse-handle = p-browse-handle
     1853       .
     1854       for each buf_temp-browse-handle
     1855       on error undo, return error return-value
     1856       :
     1857         delete buf_temp-browse-handle .
     1858       end.
     1859     end.
     1860   end procedure.
     1861   procedure diasize_add_browse :
     1862     define input  parameter p-browse-type   as character no-undo .
     1863     define input  parameter p-browse-handle as handle    no-undo .
     1864     define buffer buf_temp-browse-handle for temp-browse-handle .
     1865     do
     1866     on error undo, return error return-value
     1867     :
     1868       assign
     1869         v-diasize-browse-number = v-diasize-browse-number + 1
     1870       .
     1871       create buf_temp-browse-handle .
     1872       assign
     1873         buf_temp-browse-handle.browse-type   = p-browse-type
     1874         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1875         buf_temp-browse-handle.browse-handle = p-browse-handle
     1876       .
     1877     end.
     1878   end procedure.
     1879   procedure diasize_init :
     1880     define variable v-default-value    as logical   no-undo .
     1881     define variable v-restore-saved    as logical   no-undo .
     1882     define variable v-resize-value-str as character no-undo .
     1883     do
     1884     on error undo, return error return-value
     1885     :
     1886       do with frame Dialog-Frame
     1887       :
     1888         assign
     1889           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1890           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1891           v-diasize-browse-handle     = browse BR-custom-labels :handle
     1892         .
     1893         create button v-diasize-resize-button
     1894         assign
     1895           parent        = frame Dialog-Frame :first-child
     1896           label         = "s"
     1897           height-pixels = 16
     1898           width-pixels  = 16
     1899           visible       = true
     1900           sensitive     = true
     1901           movable       = true
     1902           triggers:
     1903             on end-move persistent run diasize_end-move in this-procedure .
     1904           end triggers.
     1905         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1906         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1907         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1908         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1909         assign
     1910           v-diasize-wndmax = false
     1911         .
     1912         if connected("ub") = true
     1913         then do:
     1914           define variable v-cntxt-db-num        as integer   no-undo .
     1915           define variable v-cntxt-userid        as character no-undo .
     1916           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1917                                             , OUTPUT v-cntxt-userid
     1918                                             ) .
     1919           run gbl/wndpar_r.p
     1920             (input  v-cntxt-db-num
     1921             ,input  v-cntxt-userid
     1922             ,input  'wndmax':U
     1923             ,output v-diasize-wndmax
     1924             ,output v-default-value
     1925             ) .
     1926         end.
     1927         assign
     1928           v-diasize-wndstore = false
     1929         .
     1930         if connected("ub") = true
     1931         then do:
     1932           run gbl/wndpar_r.p
     1933             (input  v-cntxt-db-num
     1934             ,input  v-cntxt-userid
     1935             ,input  'wndstore':U
     1936             ,output v-diasize-wndstore
     1937             ,output v-default-value
     1938             ) .
     1939         end.
     1940         assign
     1941           v-diasize-proc-name = entry(1, program-name(2), '.')
     1942         .
     1943         if v-diasize-wndstore = true
     1944         then do:
     1945           assign
     1946             v-restore-saved = false
     1947           .
     1948           if connected("ub") = true
     1949           then do:
     1950             run gbl/wndsizer.p
     1951               (input  v-cntxt-db-num
     1952               ,input  v-cntxt-userid
     1953               ,input  v-diasize-proc-name
     1954               ,input  'height':u
     1955               ,output v-resize-value-str
     1956               ) .
     1957             if v-resize-value-str <> '':U
     1958             then do:
     1959               run diasize_change-height in this-procedure
     1960                 (input  integer(v-resize-value-str)
     1961                 ,input  true
     1962                 ) .
     1963               assign
     1964                 v-restore-saved = true
     1965               .
     1966             end.
     1967           end.
     1968           if connected("ub") = true
     1969           then do:
     1970             run gbl/wndsizer.p
     1971               (input  v-cntxt-db-num
     1972               ,input  v-cntxt-userid
     1973               ,input  v-diasize-proc-name
     1974               ,input  'width':u
     1975               ,output v-resize-value-str
     1976               ) .
     1977             if v-resize-value-str <> '':U
     1978             then do:
     1979               run diasize_change-width in this-procedure
     1980                 (input  integer(v-resize-value-str)
     1981                 ,input  true
     1982                 ) .
     1983               assign
     1984                 v-restore-saved = true
     1985               .
     1986             end.
     1987           end.
     1988           if v-restore-saved <> true
     1989           then do:
     1990             if v-diasize-wndmax = true
     1991             then do:
     1992               run diasize_maximize in this-procedure
     1993                 (input  true
     1994                 ) .
     1995             end.
     1996           end.
     1997         end.
     1998         else do:
     1999           if v-diasize-wndmax = true
     2000           then do:
     2001             run diasize_maximize in this-procedure
     2002               (input  true
     2003               ) .
     2004           end.
     2005         end.
     2006       end.
     2007     end.
     2008   end procedure.
     2009   procedure diasize_need-full-display :
     2010     define output parameter p-need-full-display as logical   no-undo .
     2011     do
     2012     on error undo, return error return-value
     2013     :
     2014       assign
     2015         p-need-full-display = v-diasize-need-full-display
     2016       .
     2017       assign
     2018         v-diasize-need-full-display = false
     2019       .
     2020     end.
     2021   end procedure.
     2022   procedure get-context :
     2023      define output parameter p-db-num as integer          no-undo.
     2024      define output parameter p-user-id as character        no-undo.
     2025      define variable v-login               as character    no-undo.
     2026      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2027      define buffer buf_user-login  for ub.user-login .
     2028      do
     2029      on error undo, return error
     2030      :
     2031            FIND FIRST buf_sys-ctrl no-lock.
     2032            ASSIGN
     2033               v-login = USERID("ub")
     2034               p-db-num = buf_sys-ctrl.db-num
     2035            .
     2036            FIND FIRST buf_user-login
     2037                 WHERE buf_user-login.db-num = p-db-num
     2038                   AND buf_user-login.user-login = v-login
     2039                 no-lock
     2040                 no-error
     2041                 .
     2042            IF AVAILABLE buf_user-login
     2043            THEN DO:
     2044               assign
     2045                  p-user-id = buf_user-login.user-id
     2046               .
     2047            END.
     2048      end.
     2049   end procedure.
     2050       run diasize_init in this-procedure .
     2051   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2052   do:
     2053     BR-custom-labels :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2054   end.
     2055   ON leave OF tt-custom-labels.field-vis IN BROWSE br-custom-labels
     2056   DO:
     2057   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2058   DEFINE BUFFER buf_tt-custom-labels FOR tt-custom-labels.
     2059     case LOGICAL(tt-custom-labels.field-vis:SCREEN-VALUE IN BROWSE br-custom-labels):
     2060       WHEN YES THEN DO:
     2061        IF tt-custom-labels.field-vis then return .
     2062        IF v-all-ii + 1 > p-max-fields THEN DO:
     2063           MESSAGE
     2064           substitute("Max кол-во выбираемых полей = &1", p-max-fields)
     2065           VIEW-AS ALERT-BOX ERROR.
     2066           ASSIGN
     2067           tt-custom-labels.field-vis = NO.
     2068           DISPLAY
     2069           tt-custom-labels.field-vis with BROWSE br-custom-labels.
     2070           RETURN.
     2071        END.
     2072        v-all-ii = v-all-ii + 1.
     2073        tt-custom-labels.field-vis = YES.
     2074       END.
     2075       WHEN NO THEN DO:
     2076         IF tt-custom-labels.field-vis = no then return .
     2077         v-all-ii = v-all-ii - 1.
     2078         tt-custom-labels.field-vis = no.
     2079       END.
     2080     END CASE.
     2081   END.
     2082   MAIN-BLOCK:
     2083   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2084      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2085   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2086     run mainmenu_getcntxt in parparentproc
     2087       (output v-cntxt-db-num
     2088       ,output v-cntxt-userid
     2089       ,output v-cntxt-level
     2090       ,output v-cntxt-host-code-obj
     2091       ,output v-cntxt-obj-type
     2092       ,output v-cntxt-obj-code
     2093       ,output v-cntxt-db-num-obj
     2094       ,output v-cntxt-is-admin
     2095       ) .
     2096     RUN fill-tables IN THIS-PROCEDURE.
     2097     RUN Myenable.
     2098     WAIT-FOR GO OF FRAME Dialog-Frame.
     2099   END.
     2100   RUN disable_UI.
     2101   PROCEDURE disable_UI :
     2102     HIDE FRAME Dialog-Frame.
     2103   END PROCEDURE.
     2104   PROCEDURE enable_UI :
     2105     ENABLE B-exit b-quit B-Help BR-custom-labels B-up B-down B-vis B-no-vis
     2106         WITH FRAME Dialog-Frame.
     2107     VIEW FRAME Dialog-Frame.
     2108     OPEN QUERY BR-custom-labels FOR EACH tt-custom-labels BY tt-custom-labels.field-vis DESCENDING BY tt-custom-labels.visible-field-num BY tt-custom-labels.custom-label      INDEXED-REPOSITION .
     2109   END PROCEDURE.
     2110   PROCEDURE fill-tables :
     2111   define variable ii as integer   no-undo .
     2112   define variable v-size as character no-undo .
     2113   define variable v-num as character no-undo .
     2114   DEFINE BUFFER buf_custom-labels FOR ub.custom-labels.
     2115   DEFINE BUFFER buf_tt-custom-labels FOR tt-custom-labels.
     2116   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2117       for each buf_custom-labels no-lock where
     2118           buf_custom-labels.language = "rus"
     2119       and buf_custom-labels.call-type = p-call-type
     2120       and buf_custom-labels.call-point = p-call-point
     2121    by buf_custom-labels.custom-label
     2122       :
     2123     create buf_tt-custom-labels .
     2124     BUFFER-COPY buf_custom-labels TO buf_tt-custom-labels.
     2125     assign
     2126     buf_tt-custom-labels.field-num  = ii + 1
     2127     ii = ii + 1
     2128     buf_tt-custom-labels.field-vis  = no
     2129     buf_tt-custom-labels.default-field-size = buf_tt-custom-labels.widget-width
     2130     buf_tt-custom-labels.field-size = buf_tt-custom-labels.default-field-size
     2131     .
     2132   end.
     2133   run uf-get in this-procedure (
     2134        input  p-call-point
     2135       ,input  v-cntxt-userid
     2136       ,output v-uf-List_
     2137       ,output v-uf-Naim
     2138       ,output v-uf-print-graft
     2139       ,output v-uf-sort-gr
     2140       ,output v-uf-type-price
     2141       ,output v-uf-type-val
     2142       )  .
     2143   case p-call-point :
     2144     when 'gdsreffi':U then do:
     2145       if v-uf-List_ = "" or v-uf-List_ = ? then do:
     2146         v-num  = 'goods.gds-name,goods.#prod-name,goods.#prt-root-name,goods.negative-rest,gds-obj.#VAT-PC,goods.ALPHA1,gds-obj.in-date':U.
     2147         v-size = '?,?,?,?,?,?,?,?':U.
     2148       end.
     2149       else do:
     2150         v-num   = entry(1, v-uf-List_, chr(4)) .
     2151         v-size  = entry(2, v-uf-List_, chr(4)) .
     2152       end.
     2153     end.
     2154     otherwise do:
     2155       assign
     2156       v-num   = entry(1, v-uf-List_, chr(4))
     2157       v-size  = entry(2, v-uf-List_, chr(4))
     2158       no-error
     2159       .
     2160       if v-size = '':U then do:
     2161         assign
     2162         v-size = fill(chr(63), num-entries(v-num)).
     2163       end.
     2164     end.
     2165   end case.
     2166   repeat ii = 1 to num-entries(v-num) :
     2167     FIND FIRST buf_tt-custom-labels WHERE
     2168               buf_tt-custom-labels.tbl-name = ENTRY(1, ENTRY(ii, v-num), ".":U)
     2169           AND buf_tt-custom-labels.fld-name = ENTRY(2, ENTRY(ii, v-num), ".":U) no-error.
     2170     IF AVAILABLE buf_tt-custom-labels THEN DO:
     2171       ASSIGN
     2172       buf_tt-custom-labels.visible-field-num = ii
     2173       buf_tt-custom-labels.field-vis = YES
     2174       buf_tt-custom-labels.field-size = (IF entry(ii, v-size) = chr(63)
     2175                                         THEN buf_tt-custom-labels.field-size
     2176                                         ELSE decimal(entry(ii, v-size)))
     2177       v-all-ii = v-all-ii + 1
     2178       .
     2179     END.
     2180   end.
     2181   END PROCEDURE.
     2182   PROCEDURE MyEnable :
     2183   assign
     2184   tt-custom-labels.custom-tooltip:RESIZABLE IN BROWSE br-custom-labels = YES.
     2185   IF p-enable-size-change = NO THEN DO:
     2186     ASSIGN
     2187     tt-custom-labels.field-siz:REad-only IN BROWSE br-custom-labels = YES
     2188     tt-custom-labels.field-siz:visible IN BROWSE br-custom-labels = NO
     2189     .
     2190   END.
     2191   ENABLE
     2192   B-exit
     2193   b-quit
     2194   B-Help
     2195   BR-custom-labels
     2196   B-up
     2197   B-down
     2198   WITH FRAME Dialog-Frame.
     2199   VIEW FRAME Dialog-Frame.
     2200   OPEN QUERY BR-custom-labels FOR EACH tt-custom-labels BY tt-custom-labels.field-vis DESCENDING BY tt-custom-labels.visible-field-num BY tt-custom-labels.custom-label      INDEXED-REPOSITION .
     2201   END PROCEDURE.
     2202   PROCEDURE proc-save :
     2203   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2204   DEFINE VARIABLE v-num AS CHARACTER NO-UNDO.
     2205   DEFINE VARIABLE v-wis AS CHARACTER NO-UNDO.
     2206   DEFINE BUFFER buf_tt-custom-labels FOR tt-custom-labels.
     2207   FOR EACH buf_tt-custom-labels WHERE
     2208           buf_tt-custom-labels.field-vis = YES
     2209   by buf_tt-custom-labels.visible-field-num
     2210           :
     2211      ASSIGN
     2212      v-num  = v-num + (IF v-num = '':U
     2213                        THEN '':U
     2214                        ELSE chr(44)) + (buf_tt-custom-labels.tbl-name + "." + buf_tt-custom-labels.fld-name)
     2215      v-wis = v-wis + (IF v-wis = '':U
     2216                       THEN '':U
     2217                       ELSE chr(44)) + STRING(buf_tt-custom-labels.field-size).
     2218      v-ii = v-ii + 1.
     2219     IF v-ii = p-max-fields THEN LEAVE.
     2220   END.
     2221   ASSIGN
     2222   v-uf-list_ = v-num + chr(4) + v-wis.
     2223   run uf-set in this-procedure(
     2224       input  p-call-point
     2225       ,input  v-cntxt-userid
     2226       ,input v-uf-List_
     2227       ,input v-uf-Naim
     2228       ,input v-uf-print-graft
     2229       ,input v-uf-sort-gr
     2230       ,input v-uf-type-price
     2231       ,input v-uf-type-val
     2232   )  no-error .
     2233   END PROCEDURE.
