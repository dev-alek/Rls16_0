     4492   PROCEDURE proc-b-sch :
     4493   assign
     4494   tbl = 'c-gds-grp-hist'
     4495   join-tbl = 'X_c-gds-grp-hist'
     4496   fld = ""
     4497   lab = ""
     4498   spr = ""
     4499   dim = '0'
     4500   .
     4501   run fltfield-add in this-procedure('subject', 'Предмет изменений', 'gds-grp-hist-subject',
     4502   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4503   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     4504   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4505   if p-mode <> "gds-prt" then do:
     4506     run fltfield-add in this-procedure('tax-code', 'Код налога', '',
     4507     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4508     run fltfield-add in this-procedure('attr-code', 'Код атрибута', '',
     4509     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4510     run fltfield-add in this-procedure('host-code', 'Фирма', '',
     4511     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4512     run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     4513     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4514   end.
     4515   run fltfield-add in this-procedure('corr-date', 'Дата изменений', '',
     4516   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4517   run fltfield-add in this-procedure('corr-time', 'Время изменений', 'time',
     4518   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4519   run fltfield-add in this-procedure('corr-user-db-num', 'БД изменений', '',
     4520   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4521   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4522   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4523   DO on stop undo, leave:
     4524       run gbl/filter.w ( input parparentproc
     4525                       , input (filter-point + chr(4) +
     4526                         filter-label + chr(4) +
     4527                         string(yes))
     4528                       , input tbl
     4529                       , input join-tbl
     4530                       , input fld
     4531                       , input lab
     4532                       , input spr
     4533                       , input dim).
     4534       RUN OpenBr in this-procedure ( INPUT yes, input no, input '':U).
     4535   END .
     4536   END PROCEDURE.
     4537   PROCEDURE proc-view-changes :
     4538   define variable v-description as character no-undo .
     4539   for each temp-changes:
     4540       delete temp-changes.
     4541   END.
     4542   if not available X_c-gds-grp-hist then do:
     4543     Open QUery br-changes for each temp-changes.
     4544     return.
     4545   end.
     4546   assign
     4547   v-full-name-old = "":U
     4548   v-full-name-new = "":U
     4549   .
     4550   run ref/cggrhisv.p (
     4551                      input X_c-gds-grp-hist.node-code
     4552                     ,input X_c-gds-grp-hist.attr-code
     4553                     ,input X_c-gds-grp-hist.tax-code
     4554                     ,input X_c-gds-grp-hist.corr-user-db-num
     4555                     ,input X_c-gds-grp-hist.chip-num
     4556                     ,input X_c-gds-grp-hist.host-code
     4557                     ,input X_c-gds-grp-hist.obj-type
     4558                     ,input X_c-gds-grp-hist.obj-code
     4559                     ,input X_c-gds-grp-hist.subject
     4560                     ,input X_c-gds-grp-hist.action
     4561                     ,input no
     4562                     ,output v-description
     4563                     ,OUTPUT v-full-name-old
     4564                     ,OUTPUT v-full-name-new
     4565                  ) no-error .
     4566   Open QUery br-changes for each temp-changes.
     4567   assign
     4568   br-changes:title in frame Dialog-Frame = v-description
     4569   .
     4570   if v-full-name-old <> "":U
     4571   or v-full-name-new <> "":U  then do:
     4572     DISPLAY
     4573     v-full-name-old
     4574     v-full-name-new
     4575     WITH FRAME Dialog-Frame.
     4576   end.
     4577   else do:
     4578     hide
     4579     v-full-name-old
     4580     v-full-name-new
     4581     IN FRAME Dialog-Frame.
     4582   end.
     4583   END PROCEDURE.
     4584   FUNCTION get-action RETURNS CHARACTER
     4585     (  p-action as integer ) :
     4586     define variable dops as character no-undo.
     4587   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4588   RETURN dops.
     4589   END FUNCTION.
