        1   DEFINE BUFFER buf_cli FOR clients.
        2   DEFINE BUFFER for-c-gds-grp-hist FOR c-gds-grp-hist.
        3   DEFINE BUFFER X_c-gds-grp-hist FOR c-gds-grp-hist.
        4   define input parameter parparentproc as widget-handle no-undo .
        5   DEFINE INPUT PARAMETER bttns  as character  no-undo .
        6   DEFINE INPUT PARAMETER p-mode as character no-undo.
        7   DEFINE INPUT PARAMETER p-node-code like ub.c-gds-grp-hist.node-code no-undo.
        8   DEFINE INPUT PARAMETER p-attr-code like ub.c-gds-grp-hist.attr-code no-undo.
        9   DEFINE INPUT PARAMETER p-host-code like ub.c-gds-grp-hist.host-code no-undo.
       10   DEFINE INPUT PARAMETER p-obj-type  like ub.c-gds-grp-hist.obj-type  no-undo.
       11   DEFINE INPUT PARAMETER p-obj-code  like ub.c-gds-grp-hist.obj-code  no-undo.
       12   define input parameter p-tax-code  like ub.c-gds-grp-hist.tax-code no-undo .
       13   define input parameter p-is-del    as logical no-undo .
       14   define input parameter p-subject   like ub.c-gds-grp-hist.subject no-undo .
       15   DEFINE OUTPUT PARAMETER  P-rid-list    as  char no-undo .
       16   define variable vss-revision    as character no-undo init "$Revision$":u .
       17   define variable vss-author      as character no-undo init "$Author$":u .
       18   define variable vss-date        as character no-undo init "$Date$":u .
       19   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       20   define variable vss-archive     as character no-undo init "$Archive$":u .
       21   define variable vss-description as character no-undo init "Справочник истории групп товаров" .
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define new global shared variable g#library  as handle no-undo .
       81   define new global shared variable g#library2 as handle no-undo .
       82   procedure proc-alt-shift-f2:
       83     if not ibs.th.gbl.gbl-var:rcode
       84   then
       85     run gbl\inidebug.p .
       86   end.
       87   procedure proc-alt-shift-f3:
       88     run gbl/prvssinf.p
       89       ( input this-procedure
       90       ) .
       91   end.
       92   define variable v-inform-launched as logical no-undo initial false .
       93   procedure proc-alt-shift-f4:
       94     define variable v-action as character no-undo .
       95     if v-inform-launched = false then do:
       96       assign
       97         v-inform-launched = true
       98       .
       99       run gbl/d-inform.w
      100         (  input self
      101         ,  input this-procedure
      102         , output v-action
      103         ) no-error .
      104       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      105       assign
      106         v-inform-launched = false
      107       .
      108     end.
      109   end.
      110   procedure proc-alt-f1:
      111     run gbl/corrhelp.p
      112       (input this-procedure
      113       ) .
      114   end .
      115   on alt-shift-f2 anywhere do:
      116     run proc-alt-shift-f2.
      117   end.
      118   on alt-shift-f3 anywhere do:
      119     run proc-alt-shift-f3 in this-procedure .
      120   end.
      121   on alt-shift-f4 anywhere do:
      122     run proc-alt-shift-f4 in this-procedure.
      123   end.
      124   on alt-f1 anywhere do:
      125     run proc-alt-f1 in this-procedure .
      126   end.
      127   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128   procedure cur-time :
      129      define output parameter p-today as date      no-undo .
      130      define output parameter p-time  as integer   no-undo .
      131     do
      132     on error undo, return error
      133     :
      134       define variable v-date1 as date      no-undo .
      135       define variable v-date2 as date      no-undo .
      136       define variable v-time  as integer   no-undo .
      137       assign
      138         v-date1 = today
      139         v-time  = time
      140         v-date2 = today
      141       .
      142       if v-date1 <> v-date2
      143       then do:
      144         assign
      145           v-date1 = today
      146           v-time  = v-time
      147         .
      148       end.
      149       assign
      150         p-today = v-date1
      151         p-time  = v-time
      152       .
      153     end.
      154   end.
      155   function cur-time-date returns character
      156   :
      157     return string(today, '99/99/9999':U) .
      158   end.
      159   function cur-time-mjd returns decimal
      160   :
      161     define variable v-date as date      no-undo .
      162     define variable v-time as integer   no-undo .
      163     run cur-time in this-procedure
      164       (output v-date
      165       ,output v-time
      166       ) .
      167     return integer(v-date) - 2400002 + (v-time / 86400) .
      168   end.
      169   function cur-time-get-ending-index returns integer
      170   (input p-number as integer
      171   )
      172   :
      173     if p-number < 0
      174     or p-number = ?
      175     then do:
      176       return 1 .
      177     end.
      178     define variable v-rest as integer   no-undo .
      179     assign
      180       p-number = p-number modulo 100
      181     .
      182     if p-number < 20
      183     then do:
      184       assign
      185         v-rest = p-number
      186       .
      187     end.
      188     else do:
      189       assign
      190         v-rest = p-number modulo 10
      191       .
      192     end.
      193     case v-rest :
      194       when 1
      195       then do:
      196         return 2 .
      197       end.
      198       when 2 or
      199       when 3 or
      200       when 4
      201       then do:
      202         return 3 .
      203       end.
      204       otherwise do:
      205         return 1 .
      206       end.
      207     end case .
      208   end.
      209   procedure cur-time-mjd-to-date :
      210      define input  parameter i-mjd-diff as decimal no-undo.
      211      define output parameter o-Date     as date    no-undo.
      212      define output parameter o-Time     as integer no-undo.
      213      define variable v-day-number as integer   no-undo .
      214      if    i-mjd-diff < 0
      215         or i-mjd-diff = ?
      216      then do:
      217         return "?" .
      218      end.
      219      assign
      220         v-day-number = truncate(i-mjd-diff,0).
      221         o-Date = date(v-day-number + 2400002).
      222         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      223     .
      224   end.
      225   function cur-time-mjd-to-string returns character
      226   (input p-mjd-diff as decimal
      227   )
      228   :
      229     define variable v-day-number as integer   no-undo .
      230     define variable v-seconds    as integer   no-undo .
      231     define variable v-hour       as integer   no-undo .
      232     define variable v-min        as integer   no-undo .
      233     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      234     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      235     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      236     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      237     if p-mjd-diff < 0
      238     or p-mjd-diff = ?
      239     then do:
      240       return "?" .
      241     end.
      242     assign
      243       v-day-number = integer(truncate(p-mjd-diff,0))
      244       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      245     .
      246     if v-seconds > 86400
      247     then do:
      248       assign
      249         v-seconds = 86400 - 1
      250       .
      251     end.
      252     if v-seconds < 0
      253     then do:
      254       assign
      255         v-seconds = 0
      256       .
      257     end.
      258     assign
      259       v-hour = truncate(v-seconds / 3600, 0)
      260     .
      261     assign
      262       v-seconds = v-seconds modulo 3600
      263     .
      264     assign
      265       v-min = truncate(v-seconds / 60, 0)
      266     .
      267     assign
      268       v-seconds = v-seconds modulo 60
      269     .
      270     return
      271         (if v-day-number <> 0
      272           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      273           else ""
      274         )
      275       + (if v-day-number <> 0 or v-hour <> 0
      276           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      277           else ""
      278         )
      279       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      280           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      281           else ""
      282         )
      283       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      284       .
      285   end.
      286   function cur-time-string returns character
      287   :
      288     define variable v-date as date      no-undo .
      289     define variable v-time as integer   no-undo .
      290     run cur-time in this-procedure
      291       (output v-date
      292       ,output v-time
      293       ) .
      294     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      295   end.
      296   function cur-time-string-sec returns character
      297   :
      298     define variable v-date as date      no-undo .
      299     define variable v-time as integer   no-undo .
      300     run cur-time in this-procedure
      301       (output v-date
      302       ,output v-time
      303       ) .
      304     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      305   end.
      306   function cur-time-custom  returns character
      307   (input p-prefix as character
      308   ,input p-date-format as character
      309   ,input p-delimiter as character
      310   ,input p-time-format as character
      311   ,input p-suffix as character
      312   )
      313   :
      314     define variable v-date as date      no-undo .
      315     define variable v-time as integer   no-undo .
      316     run cur-time in this-procedure
      317       (output v-date
      318       ,output v-time
      319       ) .
      320     return
      321       p-prefix
      322       + string(v-date, p-date-format)
      323       + p-delimiter
      324       + string(v-time, p-time-format)
      325       + p-suffix
      326       .
      327   end.
      328   function cur-time-print  returns character
      329   :
      330     define variable v-date as date      no-undo .
      331     define variable v-time as integer   no-undo .
      332     run cur-time in this-procedure
      333       (output v-date
      334       ,output v-time
      335       ) .
      336     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      337   end.
      338   function cur-time-datetime returns datetime
      339   :
      340     define variable v-char as character no-undo .
      341     define variable v-datetime as datetime no-undo .
      342     v-char = cur-time-string().
      343     v-datetime = datetime(v-char).
      344     return  v-datetime.
      345   end.
      346   function cur-time-string-msec returns character
      347   :
      348     define variable v-date as datetime  no-undo .
      349     v-date = now.
      350     return string(v-date) .
      351   end.
      352   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      353   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      354   define new shared variable RepPathName        as character no-undo .
      355   define new shared variable PrintRubl          as logical   no-undo .
      356   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      357   define variable c-point  as character no-undo .
      358   define variable tbl      as character no-undo .
      359   define variable join-tbl as character no-undo .
      360   define variable fld      as character no-undo .
      361   define variable lab      as character no-undo .
      362   define variable spr      as character no-undo .
      363   define variable dim      as character no-undo .
      364   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      365   procedure fltfield-clear :
      366     define output parameter loc-fld as character no-undo.
      367     define output parameter loc-lab as character no-undo .
      368     define output parameter loc-spr as character no-undo .
      369     define output parameter loc-dim as character no-undo .
      370     assign
      371       loc-fld = ""
      372       loc-lab = ""
      373       loc-spr = ""
      374       loc-dim = "0"
      375     .
      376   end procedure .
      377   procedure fltfield-add :
      378     define input        parameter par-fld as character no-undo.
      379     define input        parameter par-lab as character no-undo .
      380     define input        parameter par-spr as character no-undo .
      381     define input-output parameter loc-fld as character no-undo.
      382     define input-output parameter loc-lab as character no-undo .
      383     define input-output parameter loc-spr as character no-undo .
      384     define input-output parameter loc-dim as character no-undo .
      385     do
      386     on error undo, return error
      387     :
      388       assign
      389       loc-fld = if loc-dim = '0'
      390                 then par-fld
      391                 else (loc-fld + chr(44) + par-fld)
      392       loc-lab = if loc-dim = '0'
      393                 then par-lab
      394                 else (loc-lab + chr(44) + par-lab)
      395       loc-spr = if loc-dim = '0'
      396                 then par-spr
      397                 else (loc-spr + chr(44) + par-spr)
      398       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      399                 string(integer(if num-entries(loc-dim) > 1
      400                               then entry(2, loc-dim)
      401                               else entry(1, loc-dim)
      402                               ) + 1)
      403       no-error
      404       .
      405     end.
      406   end procedure.
      407   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      408   define variable v-waitfram-action01         as character   no-undo .
      409   define variable v-waitfram-action02         as character   no-undo .
      410   define variable v-waitfram-action03         as character   no-undo .
      411   define variable mWaitFramTextBeg            as character   no-undo.
      412   define variable mWaitFramTextEnd            as character   no-undo.
      413   define variable mWaitFramView               as logical     no-undo.
      414   define variable mWaitProcEvent              as logical     no-undo init yes.
      415   define variable mWaitFramInterval           as integer     no-undo init 1 .
      416   define variable mWaitFramStop               as logical     no-undo.
      417   define variable mWaitFramStopUser           as logical     no-undo.
      418   define variable mWaitFramStopTimeOut        as logical     no-undo.
      419   define variable mWaitFramStartProc          as datetime-tz no-undo.
      420   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      421   define button B-WaitFramStop auto-end-key
      422        label "Стоп"
      423        size 10 by 1 tooltip "Остоновить процесс".
      424   define button B-viewProcInfo
      425        label "Информация"
      426        size 15 by 1 tooltip "Информация о процесс".
      427   define frame waitfram
      428     v-waitfram-action01 format "x(72)" no-label skip
      429     v-waitfram-action02 format "x(72)" no-label skip
      430     v-waitfram-action03 format "x(72)" no-label skip
      431     B-viewProcInfo
      432     B-WaitFramStop at row 4 col 30
      433     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      434     .
      435   define new global shared variable mBatchMode as logical no-undo init ?.
      436   define variable mFramBachModHandle as handle no-undo.
      437   mFramBachModHandle = frame waitfram:handle.
      438   define variable mFameOldVis as logical no-undo.
      439   define variable mVisCUrentVin as logical no-undo.
      440   if session:batch-mode
      441   then
      442      mBatchMode = yes.
      443   if mBatchMode = ? then do:
      444     mVisCUrentVin = current-window:visible.
      445     mFameOldVis = mFramBachModHandle:visible.
      446     mFramBachModHandle:visible  = yes.
      447     mBatchMode = mFramBachModHandle:visible ne yes.
      448     mFramBachModHandle:visible = mFameOldVis.
      449     current-window:visible = mVisCUrentVin.
      450   end.
      451    if  log-manager:logfile-name ne ?
      452     then DO:
      453         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      454         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      455         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      456     end.
      457   on choose of B-WaitFramStop in frame waitfram
      458   do:
      459     mWaitFramStop = yes.
      460     mWaitFramStopUser = yes.
      461   end.
      462   function waitfram-check-timeout returns logical():
      463      define variable vtime as int64 no-undo.
      464      if mWaitFramStopTimeOut
      465      then
      466         return yes.
      467      vtime = ( now - mWaitFramStartProc ) / 1000 .
      468      if     mWaitFramTimeOut ne ?
      469         and mWaitFramTimeOut ne 0
      470         and mWaitFramTimeOut lt vtime
      471      then do:
      472         mWaitFramStopTimeOut = yes.
      473      end.
      474      return mWaitFramStopTimeOut.
      475   end.
      476   procedure waitfram-hide :
      477     if not session:batch-mode
      478     then do
      479     on error undo, return error return-value
      480     :
      481       pause 0 before-hide .
      482       if not mBatchMode then
      483         hide frame waitfram .
      484     if     not mWaitFramView
      485        and mWaitProcEvent
      486     then
      487       process events .
      488     end.
      489   end procedure.
      490   procedure waitfram-show :
      491     define input  parameter p-message as character no-undo .
      492     define variable v-left-margin as integer   no-undo .
      493     if not session:batch-mode
      494     then do
      495     on error undo, return error return-value
      496     :
      497       if length(p-message) <= 70 then do:
      498         assign
      499           v-left-margin = integer((70 - length(p-message)) / 2)
      500         .
      501         assign
      502           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      503         .
      504         assign
      505           v-waitfram-action01 = " "
      506           v-waitfram-action02 = " "
      507                                    + fill(" ", v-left-margin)
      508                                    + p-message
      509           v-waitfram-action03 = " "
      510         .
      511       end.
      512       else do:
      513         define variable vRindex1 as integer no-undo.
      514         define variable vRindex2 as integer no-undo.
      515         vRindex1 = r-index(p-message," ",70).
      516         if vRindex1 = 0
      517         then
      518            vRindex1 = 70.
      519         if length(p-message)  <= vRindex1 + 70 then do:
      520           assign
      521             v-waitfram-action01 = " "
      522             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      523             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      524           .
      525         end.
      526         else do:
      527           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      528           if vRindex2 <= vRindex1
      529           then
      530              vRindex2 = vRindex1 + 70.
      531           assign
      532             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      533             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      534             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      535           .
      536         end.
      537       end.
      538       B-viewProcInfo:visible   in frame waitfram = no.
      539       B-viewProcInfo:sensitive in frame waitfram = no.
      540       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      541       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      542       if  (   mWaitFramView
      543          or  mWaitProcEvent)
      544          and not mBatchMode
      545       then
      546          display
      547             v-waitfram-action01 skip
      548             v-waitfram-action02 skip
      549             v-waitfram-action03 skip
      550          with frame waitfram .
      551       if     mWaitFramView
      552          then do:
      553             if     mWaitFramInterval ne ?
      554                and not mBatchMode
      555             then
      556                wait-for go of frame waitfram pause mWaitFramInterval.
      557          end.
      558          else
      559             if     mWaitProcEvent
      560                and not mBatchMode
      561             then
      562                process events .
      563     end.
      564   end procedure.
      565      procedure waitfram-show-this:
      566         define input  parameter iInterval as int64 no-undo.
      567         define variable vtime as int64 no-undo.
      568         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      569         mWaitFramInterval = iInterval.
      570         run waitfram-show (substitute("&1&2 &3&4" ,
      571                                       mWaitFramTextBeg ,
      572                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      573                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      574                                       mWaitFramTextEnd
      575                                      )
      576                           ).
      577      end.
      578      procedure WaitFramRunPause:
      579         define input  parameter iInterval as dec no-undo.
      580         define variable vStart  as datetime-tz no-undo.
      581         define variable vend    as datetime-tz no-undo.
      582         define variable vint as int64 no-undo.
      583         define variable vOk as logical no-undo.
      584         vStart = now.
      585         vend   = vStart.
      586         publish "WaitFramPause" (iInterval,output vOk).
      587         vend   =  now.
      588         vint = vend - vStart.
      589         vint = iInterval - vint / 1000.
      590         if     not mWaitFramStop
      591            and (   vint > 0
      592                 or (    not vOk
      593                     and iInterval eq ?
      594                     )
      595                 )
      596         then
      597            run waitfram-show-this (iInterval).
      598         vend   =  now.
      599         vint = vend - vStart.
      600         vint = iInterval - vint / 1000.
      601         if     not mWaitFramStop
      602            and vint > 0
      603         then do:
      604            run gbl/pause.p (vint * 1000).
      605         end.
      606         if iInterval ne ?
      607         then
      608            publish "WaitFramStop".
      609         waitfram-check-timeout().
      610      end.
      611      procedure WaitFramWaitFor:
      612         define input  parameter iInterval as dec no-undo.
      613         assign
      614            mWaitFramStartProc   = now
      615            mWaitFramStopUser    = no
      616            mWaitFramStopTimeOut = no
      617         .
      618         block-wait:
      619         do while not mWaitFramStop:
      620            run WaitFramRunPause (iInterval).
      621            if  waitfram-check-timeout()
      622            then do:
      623               leave block-wait.
      624            end.
      625         end.
      626         run waitfram-hide.
      627      end.
      628   procedure waitfram-join :
      629     define input  parameter p-line-1  as character no-undo .
      630     define input  parameter p-line-2  as character no-undo .
      631     define input  parameter p-line-3  as character no-undo .
      632     define output parameter p-message as character no-undo .
      633     do
      634     on error undo, return error return-value
      635     :
      636       assign
      637         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      638                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      639                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      640       .
      641     end.
      642   end procedure.
      643   function waitfram-join-function returns character
      644     (input p-line-1 as character
      645     ,input p-line-2 as character
      646     ,input p-line-3 as character
      647     ).
      648     define variable v-message as character no-undo .
      649     run waitfram-join in this-procedure
      650       (input  p-line-1
      651       ,input  p-line-2
      652       ,input  p-line-3
      653       ,output v-message
      654       ) .
      655     return v-message .
      656   end function .
      657   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      658   procedure grp-attr-name :
      659   do
      660     on error undo, return error
      661     :
      662     define input  parameter p-code           as character no-undo .
      663     define output parameter p-type           as character no-undo .
      664     define output parameter p-format         as character no-undo .
      665     define output parameter p-label          as character no-undo .
      666     define output parameter p-user-can-edit  as logical   no-undo .
      667     define output parameter p-output-display as logical   no-undo .
      668     define output parameter p-other          as character no-undo .
      669       case p-code :
      670               when 'gds-grp-nabor':U then do:     assign     p-label = "Набор"     p-type = 'L':U      p-format = "yes/no"     p-label = "Набор"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      671         otherwise do:
      672           undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
      673         end.
      674       end.
      675     end.
      676   end procedure.
      677   procedure grp-attr-tooltip :
      678   do
      679     on error undo, return error
      680     :
      681       define input  parameter p-code    as character no-undo .
      682       define output parameter p-tooltip as character no-undo .
      683       define output parameter p-label   as character no-undo .
      684       case p-code :
      685               when 'gds-grp-nabor':U then do:     assign     p-tooltip = "Набор - не товарные позиции"     p-label = "Набор" .   end.
      686         otherwise do:
      687               undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
      688         end.
      689       end.
      690     end.
      691   end procedure.
      692   procedure grp-attr-value :
      693   do
      694   on error undo, return error
      695   :
      696   define input  parameter p-node-code   as integer    no-undo.
      697   define input  parameter p-code        as character  no-undo.
      698   define input  parameter p-host-code   as integer    no-undo.
      699   define input  parameter p-obj-type    as character  no-undo.
      700   define input  parameter p-obj-code    as integer    no-undo.
      701   define output parameter p-value       as character  no-undo.
      702   define output parameter p-type        as character  no-undo.
      703       define variable v-format         as character no-undo .
      704       define variable v-label          as character no-undo .
      705       define variable v-user-can-edit  as logical   no-undo .
      706       define variable v-output-display as logical   no-undo .
      707       define variable v-other          as character no-undo .
      708       define buffer buf_gds-grp-attr for ub.gds-grp-attr.
      709       run grp-attr-name in this-procedure (
      710             input  p-code
      711           , output p-type
      712           , output v-format
      713           , output v-label
      714           , output v-user-can-edit
      715           , output v-output-display
      716           , output v-other
      717       ) no-error .
      718       if error-status :error
      719       then do:
      720           undo, return error return-value .
      721       end.
      722       find first buf_gds-grp-attr no-lock
      723            where buf_gds-grp-attr.node-code = p-node-code
      724              and buf_gds-grp-attr.attr-code = p-code
      725              and buf_gds-grp-attr.host-code = p-host-code
      726              and buf_gds-grp-attr.obj-type  = p-obj-type
      727              and buf_gds-grp-attr.obj-code  = p-obj-code
      728       no-error .
      729       if available buf_gds-grp-attr
      730       then do:
      731           assign
      732               p-value = buf_gds-grp-attr.attr-value
      733           .
      734       end.
      735       else do:
      736           assign
      737               p-value = if p-type = 'L':U then "no":U else ""
      738           .
      739       end.
      740   end.
      741   end procedure.
      742   procedure grp-attr-write :
      743   do
      744   on error undo, return error
      745   :
      746   define input parameter p-node-code  like ub.gds-grp-attr.node-code      no-undo.
      747   define input parameter p-code       like ub.gds-grp-attr.attr-code      no-undo.
      748   define input parameter p-host-code  as integer                          no-undo.
      749   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      750   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      751   define input parameter p-value      like ub.gds-grp-attr.attr-value     no-undo.
      752       define variable v-type              as character                no-undo.
      753       define variable v-format            as character                no-undo.
      754       define variable v-label             as character                no-undo.
      755       define variable v-user-can-edit     as logical                  no-undo.
      756       define variable v-output-display    as logical                  no-undo.
      757       define variable v-other             as character                no-undo.
      758       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      759       run grp-attr-name in this-procedure (
      760                         input  p-code
      761                       , output v-type
      762                       , output v-format
      763                       , output v-label
      764                       , output v-user-can-edit
      765                       , output v-output-display
      766                       , output v-other
      767       ) no-error.
      768       if error-status :error
      769       then do:
      770           undo, return error return-value.
      771       end.
      772       find first buf_gds-grp-attr exclusive-lock
      773            where buf_gds-grp-attr.node-code  = p-node-code
      774              and buf_gds-grp-attr.attr-code  = p-code
      775              and buf_gds-grp-attr.host-code  = p-host-code
      776              and buf_gds-grp-attr.obj-type   = p-obj-type
      777              and buf_gds-grp-attr.obj-code   = p-obj-code
      778       no-error.
      779       if not available buf_gds-grp-attr
      780       then do:
      781           create buf_gds-grp-attr.
      782           assign
      783                   buf_gds-grp-attr.node-code  = p-node-code
      784                   buf_gds-grp-attr.attr-code  = p-code
      785                   buf_gds-grp-attr.host-code  = p-host-code
      786                   buf_gds-grp-attr.obj-type   = p-obj-type
      787                   buf_gds-grp-attr.obj-code   = p-obj-code
      788                   buf_gds-grp-attr.attr-value = p-value
      789           .
      790       end.
      791       else do:
      792           assign
      793               buf_gds-grp-attr.attr-value = p-value
      794           .
      795       end.
      796   end.
      797   end procedure.
      798   procedure grp-attr-delete :
      799   do
      800   on error undo, return error
      801   :
      802   define input parameter p-node-code  like ub.gds-grp-attr.node-code  no-undo.
      803   define input parameter p-code       like ub.gds-grp-attr.attr-code  no-undo.
      804   define input parameter p-host-code  as integer                      no-undo.
      805   define input parameter p-obj-type   like ub.clients.obj-type        no-undo.
      806   define input parameter p-obj-code   like ub.clients.obj-code        no-undo.
      807   define output parameter p-deleted   as logical                      no-undo.
      808       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      809       define variable v-type              as character                no-undo.
      810       define variable v-format            as character                no-undo.
      811       define variable v-label             as character                no-undo.
      812       define variable v-user-can-edit     as logical                  no-undo.
      813       define variable v-output-display    as logical                  no-undo.
      814       define variable v-other             as character                no-undo.
      815       run grp-attr-name in this-procedure
      816       ( input  p-code
      817       , output v-type
      818       , output v-format
      819       , output v-label
      820       , output v-user-can-edit
      821       , output v-output-display
      822       , output v-other
      823       ) no-error .
      824       if error-status :error then do:
      825           undo, return error return-value .
      826       end.
      827       find first buf_gds-grp-attr exclusive-lock
      828            where buf_gds-grp-attr.node-code  = p-node-code
      829              and buf_gds-grp-attr.attr-code  = p-code
      830              and buf_gds-grp-attr.host-code  = p-host-code
      831              and buf_gds-grp-attr.obj-type   = p-obj-type
      832              and buf_gds-grp-attr.obj-code   = p-obj-code
      833       no-error.
      834       if not available buf_gds-grp-attr
      835       then do:
      836           assign
      837               p-deleted = no
      838           .
      839       end.
      840       else do:
      841          delete buf_gds-grp-attr.
      842          assign
      843               p-deleted = yes
      844           .
      845       end.
      846   end.
      847   end procedure.
      848   procedure grp-attr-news :
      849   do
      850   on error undo, return error
      851   :
      852       define input  parameter p-code           as character no-undo .
