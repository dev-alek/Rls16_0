      862   procedure grp-attr-obj-value :
      863   do
      864   on error undo, return error
      865   :
      866   define input parameter p-node-code as integer      no-undo.
      867   define input parameter p-obj-type  as character    no-undo.
      868   define input parameter p-obj-code  as integer      no-undo.
      869   define input parameter p-attr-code as character    no-undo .
      870   define output parameter p-attr-value     as character   no-undo.
      871   define output parameter p-range     as integer      no-undo.
      872   define output parameter p-exists    as logical      no-undo.
      873   define variable v-host-code as integer      no-undo.
      874   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      875   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      876     (input  p-obj-type
      877     ,input  p-obj-code
      878     ,output v-host-code
      879     ) no-error .
      880   if error-status :error
      881   then do:
      882       message
      883         vss-workfile vss-revision vss-description
      884         skip "Не удалось найти фирму объекта"
      885         skip p-obj-type p-obj-code
      886         skip return-value
      887         skip trim(error-status :get-message(1))
      888              trim(error-status :get-message(2))
      889              trim(error-status :get-message(3))
      890              trim(error-status :get-message(4))
      891              trim(error-status :get-message(5))
      892       view-as alert-box error.
      893       undo, return error .
      894   end.
      895   define buffer buf_gds-grp-attr      for ub.gds-grp-attr.
      896   find first buf_gds-grp-attr no-lock
      897        where buf_gds-grp-attr.node-code = p-node-code
      898          and buf_gds-grp-attr.attr-code = p-attr-code
      899          and buf_gds-grp-attr.host-code = v-host-code
      900          and buf_gds-grp-attr.obj-type  = p-obj-type
      901          and buf_gds-grp-attr.obj-code  = p-obj-code
      902   no-error .
      903   if not available buf_gds-grp-attr
      904   then do:
      905       find first buf_gds-grp-attr no-lock
      906            where buf_gds-grp-attr.node-code = p-node-code
      907              and buf_gds-grp-attr.attr-code = p-attr-code
      908              and buf_gds-grp-attr.host-code = v-host-code
      909              and buf_gds-grp-attr.obj-type  = ""
      910              and buf_gds-grp-attr.obj-code  = 0
      911       no-error .
      912       if not available buf_gds-grp-attr
      913       then do:
      914           find first buf_gds-grp-attr no-lock
      915               where buf_gds-grp-attr.node-code = p-node-code
      916               and buf_gds-grp-attr.attr-code = p-attr-code
      917               and buf_gds-grp-attr.host-code = 0
      918               and buf_gds-grp-attr.obj-type  = ""
      919               and buf_gds-grp-attr.obj-code  = 0
      920           no-error .
      921           if not available buf_gds-grp-attr
      922           then do:
      923               assign
      924                   p-exists = no
      925               .
      926           end.
      927           else do:
      928               assign
      929                   p-exists = yes
      930                   p-range  = 1
      931               .
      932           end.
      933       end.
      934       else do:
      935           assign
      936               p-exists = yes
      937               p-range  = 2
      938           .
      939       end.
      940   end.
      941   else do:
      942       assign
      943           p-exists = yes
      944           p-range  = 3
      945       .
      946   end.
      947   if available buf_gds-grp-attr
      948   then do:
      949     assign
      950     p-attr-value = buf_gds-grp-attr.attr-value
      951     .
      952   end.
      953   end.
      954   end procedure.
      955   procedure ver-gds-grp-nabor :
      956   do
      957   on error undo, return error return-value
      958   :
      959   define input  parameter p-gds-code as integer   no-undo .
      960   define output parameter p-nabor as logical   no-undo .
      961   define buffer buf_goods for ub.goods.
      962   p-nabor = false .
      963   find first  buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
      964   if error-status :error then return error .
      965   define variable v-value       as character  no-undo.
      966   define variable v-type        as character  no-undo.
      967     run grp-attr-value (
      968        input   buf_goods.grp-code
      969       ,input   'gds-grp-nabor':U
      970       ,input   0
      971       ,input   ""
      972       ,input   0
      973       ,output  v-value
      974       ,output  v-type       ) no-error .
      975       if error-status :error then return error .
      976     if v-value = "yes" then p-nabor = true  .
      977   end.
      978   end procedure.
      979   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      980   FUNCTION mark-string RETURNS CHARACTER
      981     ( input p-recid as recid, input mark-list as character  ) :
      982     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      983   END FUNCTION.
      984   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      985   function usrfulnf returns character ( input p-user-id as character):
      986   define variable v-user-name as character no-undo .
      987   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      988   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      989     (input  p-user-id
      990     ,output v-user-name
      991     ) no-error .
      992   if error-status:error
      993   or v-user-name = ""
      994   then do:
      995     return p-user-id.
      996   end.
      997   else do:
      998     return v-user-name.
      999   end.
     1000   end function.
     1001   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1002   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1003   procedure fltopend_fltopend :
     1004   define input parameter p-parent-handle as handle no-undo .
     1005   define input parameter p-qh as handle no-undo .
     1006   define input parameter p-flt-open-open-query  as character no-undo .
     1007   define input parameter p-where-cond as character no-undo .
     1008   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1009   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1010   define input parameter p-indexed-reposition as character no-undo .
     1011     do
     1012     on error undo, return error
     1013     :
     1014   define variable v-prepare-string as character no-undo .
     1015   define variable glog as logical no-undo .
     1016   assign
     1017   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1018                      p-where-cond + chr(32)  +
     1019                      p-use-indFIRST-query-tail + chr(32) +
     1020                      p-use-ind-sort-clmn-by + chr(32) +
     1021                      p-indexed-reposition
     1022   .
     1023   assign
     1024   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1025   if not glog
     1026   or error-status:error then do:
     1027     message error-status:get-message(1) view-as alert-box .
     1028     undo, return error .
     1029   end.
     1030   assign
     1031   glog = p-qh:query-open no-error .
     1032   if not glog
     1033   or error-status:error then do:
     1034     message error-status:get-message(1) view-as alert-box .
     1035     undo, return error .
     1036   end.
     1037     end.
     1038   end procedure.
     1039   procedure fltopend_fltfindd :
     1040   define input parameter p-parent-handle as handle no-undo .
     1041   define input parameter p-qh as handle no-undo .
     1042   define input parameter p-rowid as rowid no-undo .
     1043   define input parameter p-next as logical no-undo .
     1044   define input parameter p-lock as integer no-undo .
     1045   define input parameter p-bh as handle no-undo .
     1046   define input parameter p-where-cond as character no-undo .
     1047   define input parameter p-use-index-phrase as character no-undo .
     1048   define variable glog as logical no-undo .
     1049   define variable v-qh as handle no-undo .
     1050   define variable v-bh as handle no-undo .
     1051   define variable v-recid as recid no-undo .
     1052   define variable v-prepare-string as character no-undo .
     1053   do
     1054   on error undo, return error
     1055   on stop undo, return error
     1056   :
     1057     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1058     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1059     create query v-qh.
     1060     v-qh:set-buffers(v-bh).
     1061     v-prepare-string = substitute("for each &1 &2 &3"
     1062                                     ,v-bh:name
     1063                                     ,p-where-cond
     1064                                     ,p-use-index-phrase).
     1065     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1066     if not glog then do:
     1067       delete object v-qh.
     1068       delete object v-bh.
     1069       undo, return error .
     1070     end.
     1071     glog = v-qh:query-open no-error .
     1072     if not glog then do:
     1073       delete object v-qh.
     1074       delete object v-bh.
     1075       undo, return error .
     1076     end.
     1077     if p-next then do:
     1078       v-qh:reposition-to-rowid(p-rowid) no-error .
     1079       glog = v-qh:get-next( p-lock) no-error .
     1080       glog = v-qh:get-next( p-lock) no-error .
     1081       if not glog or v-qh:query-off-end = yes then do:
     1082         glog = v-qh:get-first( p-lock) no-error .
     1083       end.
     1084     end.
     1085     else do:
     1086       glog = v-qh:get-first( p-lock) no-error .
     1087     end.
     1088     v-recid = v-bh:recid no-error .
     1089     delete object v-qh.
     1090     delete object v-bh.
     1091     return string(v-recid) .
     1092   end.
     1093   end procedure.
     1094   procedure fltopend_fltfindq :
     1095   define input parameter p-parent-handle as handle no-undo .
     1096   define input parameter p-qh as handle no-undo .
     1097   define input parameter p-next as logical no-undo .
     1098   define input parameter p-lock as integer no-undo .
     1099   define input parameter p-flt-open-open-query  as character no-undo .
     1100   define input parameter p-where-cond as character no-undo .
     1101   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1102   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1103   define input parameter p-indexed-reposition as character no-undo .
     1104   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1105   define variable glog as logical no-undo .
     1106   define variable v-qh as handle no-undo .
     1107   define variable v-bh as handle no-undo extent 18.
     1108   define variable v-rowid as rowid no-undo extent 18.
     1109   define variable v-ii as integer no-undo .
     1110   define variable v-prepare-string as character no-undo .
     1111   do
     1112   on error undo, return error
     1113   on stop undo, return error
     1114   :
     1115     create query v-qh.
     1116     do v-ii = 1 to p-qh:num-buffers:
     1117       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1118       assign
     1119       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1120       no-error.
     1121       v-qh:add-buffer(v-bh[v-ii]).
     1122     end.
     1123     assign
     1124     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1125                       p-where-cond + chr(32)  +
     1126                       p-use-indFIRST-query-tail + chr(32) +
     1127                       p-use-ind-sort-clmn-by + chr(32) +
     1128                       p-indexed-reposition
     1129     .
     1130     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1131     if not glog then do:
     1132       delete object v-qh.
     1133       do v-ii = 1 to p-qh:num-buffers:
     1134         delete object v-bh[v-ii].
     1135       end.
     1136       undo, return error .
     1137     end.
     1138     glog = v-qh:query-open no-error .
     1139     if not glog then do:
     1140       delete object v-qh.
     1141       do v-ii = 1 to p-qh:num-buffers:
     1142         delete object v-bh[v-ii].
     1143       end.
     1144       undo, return error .
     1145     end.
     1146     if p-next then do:
     1147       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1148       glog = v-qh:get-next( p-lock) no-error .
     1149       glog = v-qh:get-next( p-lock) no-error .
     1150       if not glog or v-qh:query-off-end = yes then do:
     1151         glog = v-qh:get-first( p-lock) no-error .
     1152       end.
     1153     end.
     1154     else do:
     1155       glog = v-qh:get-first( p-lock) no-error .
     1156     end.
     1157     do v-ii = 1 to p-qh:num-buffers:
     1158       assign
     1159       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1160       no-error.
     1161     end.
     1162     delete object v-qh.
     1163     do v-ii = 1 to p-qh:num-buffers:
     1164       delete object v-bh[v-ii].
     1165     end.
     1166   end.
     1167   end procedure.
     1168   define variable v-rid-list as character no-undo .
     1169   define variable log-res as log no-undo.
     1170   define variable rr as recid no-undo.
     1171   define variable jj as integer no-undo .
     1172   define variable str as char no-undo.
     1173   define variable vartbl-name as char no-undo.
     1174   define variable varact      as char no-undo.
     1175   define variable filter-point0 as character no-undo init "cggrphis":U .
     1176   define variable filter-point as character no-undo init "cggrphis":U .
     1177   define variable filter-label as character no-undo init "История групп товаров":U .
     1178   define variable filter-label0 as character no-undo init "История групп товаров":U .
     1179   define variable sort-column-name as character no-undo .
     1180   define variable v-doc-rec as recid no-undo .
     1181   define buffer X_gds-grp for ub.gds-grp.
     1182   define buffer X_gds-prt for ub.gds-prt.
     1183   define buffer X_gds-grp-attr for ub.gds-grp-attr.
     1184   define buffer X_gds-grp-obj for ub.gds-grp-obj.
     1185   define buffer x_clients-obj for ub.clients.
     1186   define buffer X_sysconf for ub.sysconf.
     1187   define buffer X_tax for ub.tax.
     1188   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1189   define NEW SHARED temp-table temp-changes no-undo
     1190   field f_name as character
     1191   field l_name as character
     1192   field v_old as character
     1193   field v_new as character
     1194   field t_name as character
     1195   field num_ as integer
     1196   field uniq-key-rec as character
     1197   field action as integer
     1198   field fNotChange as logical
     1199   index pi is unique primary
     1200   num_
     1201   t_name
     1202   f_name
     1203   index
     1204   Chan
     1205   fnotChange
     1206   t_name
     1207   f_name
     1208   index imain uniq-key-rec
     1209   .
     1210   FUNCTION get-all-fields returns character (p-file-name as character ):
     1211   define variable v-dop as character no-undo .
     1212     find first _file no-lock where _file._file-name = p-file-name no-error .
     1213     if not available _file then return "":U.
     1214     for each _field no-lock where
     1215              _field._file-recid = recid(_file) :
     1216       assign
     1217       v-dop = v-dop + _field._field-name + chr(44)
     1218       .
     1219     end.
     1220     return trim(v-dop).
     1221   END FUNCTION.
     1222   PROCEDURE proc-full-temp-changes :
     1223     define input  parameter p-hst-handle as handle    no-undo .
     1224     define input  parameter p-main-table as character no-undo .
     1225     define input  parameter p-field-list as character no-undo .
     1226     define input  parameter p-label-form as character no-undo .
     1227     define variable h-new-buf         as handle    no-undo .
     1228     define variable h-main-buf        as handle    no-undo .
     1229     define variable h-for-comp        as handle    no-undo .
     1230     define variable v-inform          as character no-undo .
     1231     define variable v-ind             as integer   no-undo .
     1232     define variable v-idx-field-qnty  as integer   no-undo .
     1233     define variable v-num-entries     as integer   no-undo .
     1234     define variable fh                as handle    no-undo .
     1235     define variable fh-main           as handle    no-undo .
     1236     define variable fh-old            as handle    no-undo .
     1237     define variable fh-new            as handle    no-undo .
     1238     define variable v-field-name      as character no-undo .
     1239     define variable v-field-lvl       as character no-undo .
     1240     define variable v-field-form      as character no-undo .
     1241     define variable v-search-exp      as character no-undo .
     1242     define variable v-srch-main       as character no-undo .
     1243     define variable v-word-link       as character no-undo .
     1244     define variable v-av-chip-num     as logical   no-undo .
     1245     define variable v-main-pi-fld-lst as character no-undo .
     1246     define variable v-main-fld-lst    as character no-undo .
     1247     define variable v-delim-list      as character no-undo .
     1248     define variable v-label           as character no-undo .
     1249     define variable v-old-value       as character no-undo case-sensitive.
     1250     define variable v-new-value       as character no-undo case-sensitive.
     1251     define variable v-chg-fields as character no-undo.
     1252     for each temp-changes:
     1253       delete temp-changes.
     1254     end.
     1255     if not p-hst-handle:available then do:
     1256       return .
     1257     end.
     1258     create buffer h-new-buf  for table p-hst-handle .
     1259     create buffer h-main-buf for table p-main-table .
     1260     assign
     1261       v-inform = h-main-buf:index-information(1)
     1262       v-ind    = 2
     1263     .
     1264     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1265     on error undo, return error
     1266     :
     1267       assign
     1268         v-inform = h-main-buf:index-information( v-ind )
     1269         v-ind    = v-ind + 1
     1270       .
     1271     end.
     1272     if v-inform = ?
     1273       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1274       or entry( 3, v-inform, ",":U ) <> "1":U
     1275     then do:
     1276       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1277     end.
     1278     assign
     1279       v-idx-field-qnty = num-entries( v-inform ) - 4
     1280     .
     1281     if v-idx-field-qnty < 2 then do:
     1282       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1283     end.
     1284     assign
     1285       v-srch-main   = "where":U
     1286       v-word-link   = "":U
     1287       v-av-chip-num = false
     1288       v-delim-list  = "":U
     1289     .
     1290     do v-ind = 1 to v-idx-field-qnty by 2
     1291     on error undo, return error
     1292     :
     1293       assign
     1294         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1295         fh                = p-hst-handle:buffer-field( v-field-name )
     1296         fh-main           = h-main-buf:buffer-field( v-field-name )
     1297         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1298         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1299       .
     1300       if fh:data-type ="character":U then do:
     1301         assign
     1302           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1303         .
     1304       end.
     1305       else do:
     1306         assign
     1307           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1308         .
     1309       end.
     1310       if v-delim-list = "":U then do:
     1311         assign
     1312           v-delim-list = ",":U
     1313         .
     1314       end.
     1315       if v-word-link = "":U then do:
     1316         assign
     1317           v-word-link = "and":U
     1318         .
     1319       end.
     1320     end.
     1321     assign
     1322       v-delim-list  = "":U
     1323     .
     1324     do v-ind = 1 to h-main-buf:num-fields
     1325     on error undo, return error
     1326     :
     1327       assign
     1328         fh-main      = h-main-buf:buffer-field( v-ind )
     1329         v-field-name = fh-main:name
     1330       .
     1331         assign
     1332           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1333         .
     1334         if v-delim-list = "":U then do:
     1335           assign
     1336             v-delim-list = ",":U
     1337           .
     1338         end.
     1339     end.
     1340     assign
     1341       v-inform = p-hst-handle:index-information(1)
     1342       v-ind    = 2
     1343     .
     1344     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1345     on error undo, return error
     1346     :
     1347       assign
     1348         v-inform = p-hst-handle:index-information( v-ind )
     1349         v-ind    = v-ind + 1
     1350       .
     1351     end.
     1352     if v-inform = ?
     1353       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1354       or entry( 3, v-inform, ",":U ) <> "1":U
     1355     then do:
     1356       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1357     end.
     1358     assign
     1359       v-idx-field-qnty = num-entries( v-inform ) - 4
     1360     .
     1361     if v-idx-field-qnty < 2 then do:
     1362       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1363     end.
     1364     assign
     1365       v-search-exp  = "where":U
     1366       v-word-link   = "":U
     1367       v-av-chip-num = false
     1368     .
     1369     do v-ind = 1 to v-idx-field-qnty by 2
     1370     on error undo, return error
     1371     :
     1372       assign
     1373         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1374         fh           = p-hst-handle:buffer-field( v-field-name )
     1375         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1376       .
     1377       if v-field-name = "chip-num":U then do:
     1378         assign
     1379           v-search-exp  = substitute( "&1 >", v-search-exp )
     1380           v-av-chip-num = true
     1381         .
     1382       end.
     1383       else do:
     1384         assign
     1385           v-search-exp = substitute( "&1 =", v-search-exp )
     1386         .
     1387       end.
     1388       if fh:data-type ="character":U then do:
     1389         assign
     1390           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1391         .
     1392       end.
     1393       else do:
     1394         assign
     1395           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1396         .
     1397       end.
     1398       if v-word-link = "":U then do:
     1399         assign
     1400           v-word-link = "and":U
     1401         .
     1402       end.
     1403     end.
     1404     if v-av-chip-num = false then do:
     1405       message
     1406         vss-workfile vss-revision vss-description skip
     1407         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1408         "Использование данной процедуры невозможно!" skip
     1409         view-as alert-box error .
     1410       return error .
     1411     end.
     1412     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1413     if not h-new-buf:available then do:
     1414       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1415       if not h-main-buf:available then do:
     1416         assign
     1417           h-for-comp = ?
     1418         .
     1419       end.
     1420       else do:
     1421         assign
     1422           h-for-comp = h-main-buf
     1423         .
     1424       end.
     1425     end.
     1426     else do:
     1427       assign
     1428         h-for-comp = h-new-buf
     1429       .
     1430     end.
     1431     assign
     1432       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1433     .
     1434     do v-ind = 1 to v-num-entries
     1435     on error undo, return error return-value
     1436     :
     1437       assign
     1438         v-field-name = entry( v-ind, v-main-fld-lst )
     1439         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1440         v-old-value  = fh-old:buffer-value()
     1441         v-label      = trim( fh-old:label )
     1442       .
     1443       if ( trim( p-field-list ) <> "":U
     1444            and lookup( v-field-name, p-field-list ) > 0
     1445          )
     1446          or trim( p-field-list ) = "":U
     1447       then do:
     1448         if h-for-comp <> ? then do:
     1449           assign
     1450             fh-new      = h-for-comp:buffer-field( v-field-name )
     1451             v-new-value = fh-new:buffer-value()
     1452           .
     1453         end.
     1454         else do:
     1455           assign
     1456             v-new-value = "":U
     1457           .
     1458         end.
     1459         if v-old-value <> v-new-value
     1460         then do:
     1461           create temp-changes.
     1462           assign
     1463             temp-changes.t_name = p-main-table
     1464             temp-changes.f_name = v-field-name
     1465             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1466             temp-changes.v_old  = trim( v-old-value )
     1467             temp-changes.v_new  = trim( v-new-value )
     1468             temp-changes.num_   = 0
     1469             temp-changes.fNotChange = v-old-value eq v-new-value
     1470           .
     1471         end.
     1472       end.
     1473     end.
     1474     assign
     1475       v-num-entries = num-entries( p-label-form, chr(8) )
     1476     .
     1477     do v-ind = 1 to v-num-entries
     1478     on error undo, return error return-value
     1479     :
     1480       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1481         assign
     1482           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1483           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1484           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1485         .
     1486         find first temp-changes
     1487           where temp-changes.f_name = v-field-name
     1488           no-error .
     1489         if available temp-changes then do:
     1490           if trim( v-field-lvl ) <> "":U then do:
     1491             assign
     1492               temp-changes.l_name = v-field-lvl
     1493             .
     1494           end.
     1495           if trim( v-field-form ) <> "":U then do:
     1496             assign
     1497               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1498             .
     1499             if h-for-comp <> ? then do:
     1500               assign
     1501                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1502               .
     1503             end.
     1504           end.
     1505         end.
     1506       end.
     1507       else do:
     1508         message
     1509           vss-workfile vss-revision vss-description skip
     1510           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1511           substitute( "список для поля '&1': '&2'"
     1512                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1513                       ,entry( v-ind, p-label-form, chr(8) )
     1514                     ) skip
     1515           substitute( "полный список: &2", p-label-form ) skip
     1516           view-as alert-box error .
     1517       end.
     1518     end.
     1519     delete object h-new-buf .
     1520     delete object h-main-buf .
     1521   END PROCEDURE.
     1522   FUNCTION get-action RETURNS CHARACTER
     1523     (  p-action as integer )  FORWARD.
     1524   DEFINE BUTTON B-Help
     1525        LABEL "Помо&щь"
     1526        SIZE 3 BY 1
     1527        BGCOLOR 8 .
     1528   DEFINE BUTTON B-mark
     1529        LABEL "&*"
     1530        SIZE 3 BY 1.
     1531   DEFINE BUTTON b-quit AUTO-END-KEY
     1532        LABEL "&Выход"
     1533        SIZE 10 BY 1
     1534        BGCOLOR 8 .
     1535   DEFINE BUTTON B-sch
     1536        LABEL "&Фильтр"
     1537        SIZE 3 BY 1.
     1538   DEFINE BUTTON b-sel AUTO-GO
     1539        LABEL "Вы&бор"
     1540        SIZE 10 BY 1.
     1541   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1542        VIEW-AS FILL-IN
     1543        SIZE 9 BY 1
     1544        FGCOLOR 4  NO-UNDO.
     1545   DEFINE VARIABLE v-full-name-new AS CHARACTER FORMAT "X(256)":U
     1546        LABEL "Стало"
     1547        VIEW-AS FILL-IN
     1548        SIZE 91 BY 1 NO-UNDO.
     1549   DEFINE VARIABLE v-full-name-old AS CHARACTER FORMAT "X(256)":U
     1550        LABEL "Было"
     1551        VIEW-AS FILL-IN
     1552        SIZE 91 BY 1 NO-UNDO.
     1553   DEFINE QUERY BR-c-gds-grp-hist FOR
     1554         X_c-gds-grp-hist SCROLLING.
     1555   DEFINE QUERY BR-changes FOR
     1556         temp-changes SCROLLING.
     1557   DEFINE BROWSE BR-c-gds-grp-hist
     1558     QUERY BR-c-gds-grp-hist DISPLAY
     1559         mark-string( recid(X_c-gds-grp-hist), v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     1560         X_c-gds-grp-hist.corr-date COLUMN-LABEL "Дата корр" FORMAT "99/99/9999":U
     1561         usrfulnf(X_c-gds-grp-hist.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1562         X_c-gds-grp-hist.corr-user-db-num COLUMN-LABEL "БД" FORMAT ">>>>9":U
     1563               WIDTH 3
     1564         (if p-mode = 'gds-prt':U then "Узел Шкалы" else entry (lookup (X_c-gds-grp-hist.subject, 'gds-grp,gds-grp-attr,gds-grp-obj,tax-rate-gds-grp,dis-grp-rule':U), 'Группа товаров,Атр-т группы товаров,Группа товаров на объекте,Налоги группы товаров,Скидки по группе':U)) COLUMN-LABEL "Предмет изменений" FORMAT "X(32)":U
     1565         abs(X_c-gds-grp-hist.node-code) COLUMN-LABEL "Вн №" FORMAT ">,>>>,>>9":U
     1566         get-action(X_c-gds-grp-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1567         string(X_c-gds-grp-hist.corr-time, "HH:MM") COLUMN-LABEL "Время!корр" FORMAT "X(5)":U
     1568               WIDTH 6
     1569         if X_c-gds-grp-hist.subject <> 'gds-grp':U and X_c-gds-grp-hist.host-code > 0 then string(X_c-gds-grp-hist.host-code) else '':U COLUMN-LABEL "Фирма" FORMAT "X(5)":U
     1570               WIDTH 6
     1571         if X_c-gds-grp-hist.subject <> 'gds-grp':U and X_c-gds-grp-hist.obj-code > 0 then
     1572   (X_c-gds-grp-hist.obj-type + string(X_c-gds-grp-hist.obj-code)) else '':U COLUMN-LABEL "Объект" FORMAT "X(9)":U
     1573               WIDTH 10
     1574       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.25.
     1575   DEFINE BROWSE BR-changes
     1576     QUERY BR-changes DISPLAY
     1577         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1578   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1579   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1580       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 5.25.
     1581   DEFINE FRAME Dialog-Frame
     1582        b-quit AT ROW 1 COL 1
     1583        B-mark AT ROW 1 COL 11
     1584        b-sel AT ROW 1 COL 14
     1585        B-sch AT ROW 1 COL 92
     1586        B-Help AT ROW 1 COL 95
     1587        mark-num AT ROW 1.92 COL 9 COLON-ALIGNED NO-LABEL
     1588        BR-c-gds-grp-hist AT ROW 3 COL 1
     1589        BR-changes AT ROW 14.5 COL 1
     1590        v-full-name-old AT ROW 20 COL 2
     1591        v-full-name-new AT ROW 21 COL 1
     1592        SPACE(0.24) SKIP(0.04)
     1593       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1594            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1595            TITLE "Справочник истории групп товаров"
     1596            CANCEL-BUTTON b-quit.
     1597   ASSIGN
     1598          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1599          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1600   ASSIGN
     1601          BR-c-gds-grp-hist:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1602   ON GO OF FRAME Dialog-Frame
     1603   DO:
     1604     p-rid-list = v-rid-list.
     1605   END.
     1606   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1607   DO:
     1608     APPLY "END-ERROR":U TO SELF.
     1609   END.
     1610   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1611   DO:
     1612   define variable g#log as logical no-undo .
     1613   if not available X_c-gds-grp-hist then return no-apply.
     1614   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1615   define variable v-str-recid14 as character no-undo .
     1616   define variable v-num-entry14 as integer   no-undo .
     1617   assign
     1618     v-str-recid14 = trim( string( recid( X_c-gds-grp-hist ) , "->>>>>>>>>>>9":U ) )
     1619     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1620   .
     1621   if v-num-entry14 > 0 then do:
     1622     assign
     1623       entry( v-num-entry14, v-rid-list ) = "":U
     1624       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1625     .
     1626   end.
     1627   else do:
     1628     assign
     1629       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1630     .
     1631   end.
     1632     g#log = br-c-gds-grp-hist :refresh( )  in frame Dialog-Frame.
     1633     if not can-do ("MOUSE-SELECT-DBLCLICK,Return", last-event:function) then do:
     1634             g#log = br-c-gds-grp-hist:select-next-row () in frame Dialog-Frame.
     1635             apply "value-changed" to br-c-gds-grp-hist in frame Dialog-Frame.
     1636     end.
     1637     if num-entries (v-rid-list) = 0 then
     1638         hide mark-num in frame Dialog-Frame.
     1639     else
     1640     disp num-entries (v-rid-list) @ mark-num
     1641     with frame Dialog-Frame.
     1642     apply "entry" to br-c-gds-grp-hist in frame Dialog-Frame.
     1643   END.
     1644   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1645   DO:
     1646     run proc-b-sch in this-procedure no-error.
     1647     if error-status:error then return no-apply.
     1648   END.
     1649   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1650   DO:
     1651       if ( available X_c-gds-grp-hist ) AND ( v-rid-list = "" ) then
     1652           v-rid-list = string( recid( X_c-gds-grp-hist ) ) .
     1653   END.
     1654   ON RETURN OF BR-c-gds-grp-hist IN FRAME Dialog-Frame
     1655   DO:
     1656         apply "DEFAULT-ACTION":U to self.
     1657   END.
     1658   ON VALUE-CHANGED OF BR-c-gds-grp-hist IN FRAME Dialog-Frame
     1659   DO:
     1660     run proc-view-changes in this-procedure no-error.
     1661   END.
     1662   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1663   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1664   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1665   on help of frame Dialog-Frame
     1666   do:
     1667     run gbl/app_help.p
     1668       (input this-procedure :file-name
     1669       ,input ''
     1670       ,input ?
     1671       ) no-error.
     1672     if error-status :error then do:
     1673       message
     1674         "Ошибка при вызове помощи"
     1675         error-status :get-message(1)
     1676         view-as alert-box .
     1677     end.
     1678   end.
     1679   run minbtn-set in this-procedure .
     1680   on choose of b-help in frame Dialog-Frame
     1681   do:
     1682     apply "help":u to frame Dialog-Frame .
     1683   end.
     1684   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1685   procedure minbtn-set :
     1686       do
     1687           on error undo, return error return-value
     1688           :
     1689           define variable ii              as integer       no-undo .
     1690           define variable fh              as widget-handle no-undo .
     1691           define variable hh              as widget-handle no-undo .
     1692           define variable v-h             as handle        extent 4 no-undo .
     1693           define variable v-name-button   as character     no-undo .
     1694           define variable v-help-old-x    as decimal       no-undo .
     1695           define variable v-help-old-y    as decimal       no-undo .
     1696           define variable v-help-old-size as decimal       no-undo .
     1697           define variable v-frame-width   as decimal       no-undo .
     1698           define variable jj              as integer       no-undo .
     1699           do
     1700               on error undo, return error
     1701               :
     1702               assign
     1703                   v-frame-width = frame Dialog-Frame:width - 0.3
     1704                   fh            = frame Dialog-Frame:first-child
     1705                   hh            = fh:first-child
     1706                   ii            = 1
     1707                   .
     1708               do while valid-handle(hh):
     1709                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1710                   do:
     1711                       case lc(hh:name) :
     1712                           when "b-help" then
     1713                               do:
     1714                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1715                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1716                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1717                                   hh:TOOLTIP = "Помощь" .
     1718                                   v-help-old-x = hh:column .
     1719                                   v-help-old-y = hh:row    .
     1720                                   v-help-old-size = hh:width .
     1721                                   hh:width-chars = 2.5 .
     1722                               end.
     1723                           when "b-print" then
     1724                               do:
     1725                                   hh:load-image("cmp/b-print.bmp":u) .
     1726                                   hh:TOOLTIP = "Печать" .
     1727                                   v-h[ii] = hh:handle .
     1728                                   ii = ii + 1 .
     1729                                   hh:width-chars = 3 .
     1730                               end.
     1731                           when "b-history" or
     1732                           when "b-hist" then
     1733                               do:
     1734                                   hh:load-image("cmp/b-hist.bmp":u) .
     1735                                   hh:TOOLTIP = "История" .
     1736                                   v-h[ii] = hh:handle .
     1737                                   ii = ii + 1 .
     1738                                   hh:width-chars = 3 .
     1739                               end.
     1740                           when "b-sch" then
     1741                               do:
     1742                                   hh:load-image("cmp/b-sch.bmp":u) .
     1743                                   hh:TOOLTIP = "Установка Фильтра" .
     1744                                   v-h[ii] = hh:handle .
     1745                                   ii = ii + 1 .
     1746                                   hh:width-chars = 3 .
     1747                               end.
     1748                           when "b-hist-user" then
     1749                               do:
     1750                                   hh:load-image("cmp/b-hist.bmp":u) .
     1751                                   hh:TOOLTIP = "История пользователя" .
     1752                                   ii = ii + 1 .
     1753                               end.
     1754                       end case.
     1755                   end.
     1756                   hh = hh:next-sibling.
     1757               end.
     1758               b-help:column = v-frame-width - b-help:width-chars.
     1759               jj = 0.
     1760               repeat ii = 4 to 1 by -1 :
     1761                   if valid-handle (v-h[ii] ) then
     1762                   do:
     1763                       jj  = jj + 1 .
     1764                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1765                       v-h[ii]:row    = v-help-old-y .
     1766                   end.
     1767               end.
     1768           end.
     1769       end.
     1770   end procedure.
     1771   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1772   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1773   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1774   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1775   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1776   define variable v-diasize-current-frame-height as decimal   no-undo .
     1777   define variable v-diasize-change-size          as logical   no-undo .
     1778   define variable v-diasize-resize-button        as handle    no-undo .
     1779   define variable v-diasize-wndmax               as logical   no-undo .
     1780   define variable v-diasize-wndstore             as logical   no-undo .
     1781   define variable v-diasize-proc-name            as character no-undo .
     1782   define variable v-diasize-browse-handle        as handle    no-undo .
     1783   define variable v-diasize-browse-number        as integer   no-undo .
     1784   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1785   define temp-table temp-diasize-handle no-undo
     1786     field handle-value  as handle
     1787     field save-position as decimal
     1788     index xpk is primary unique handle-value
     1789     .
     1790   define temp-table temp-browse-handle no-undo
     1791     field browse-type   as character
     1792     field browse-number as integer
     1793     field browse-handle as handle
     1794     field original-size as decimal
     1795     index xpk is primary unique browse-type browse-number
     1796     index xie browse-type browse-handle
     1797   .
     1798   procedure diasize_change-height :
     1799     define input  parameter p-change-value  as decimal   no-undo .
     1800     define input  parameter p-move-resize   as logical   no-undo .
     1801     define variable v-field-group-handle    as handle    no-undo .
     1802     define variable v-object-handle         as handle    no-undo .
     1803     define variable v-frame-height          as decimal   no-undo .
     1804     define variable v-frame-virtual-height  as decimal   no-undo .
     1805     define variable v-browse-height         as decimal   no-undo .
     1806     define variable v-window-height         as decimal   no-undo .
     1807     define variable v-window-virtual-height as decimal   no-undo .
     1808     define variable v-change-sign           as integer   no-undo .
     1809     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1810     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1811     if p-change-value > 0
     1812     then do:
     1813       if frame Dialog-Frame :height + p-change-value
     1814           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1815       then do:
     1816         assign
     1817           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1818                           - (frame Dialog-Frame :height-chars)
     1819         .
     1820         if p-change-value <= 0
     1821         then do:
     1822           run diasize_position-resize-button in this-procedure .
     1823           return .
     1824         end.
     1825       end.
     1826     end.
     1827     if p-change-value < 0
     1828     then do:
     1829       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1830       then do:
     1831         assign
     1832           p-change-value = v-diasize-orig-frame-height
     1833                          - (frame Dialog-Frame :height-chars)
     1834         .
     1835         if p-change-value >= 0
     1836         then do:
     1837           run diasize_position-resize-button in this-procedure .
     1838           return .
     1839         end.
     1840       end.
     1841     end.
     1842     if p-change-value >= 0
     1843     then do:
     1844       assign
     1845         v-change-sign = 1
     1846       .
     1847     end.
     1848     else do:
     1849       assign
     1850         v-change-sign = -1
     1851       .
     1852     end.
     1853     assign
     1854       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1855     .
     1856     if p-change-value = 0
     1857     then do:
     1858       run diasize_position-resize-button in this-procedure .
     1859       return .
     1860     end.
     1861     move_block:
     1862     do
     1863     on error undo move_block, retry move_block
     1864     :
     1865       if retry
     1866       then do:
     1867         do
     1868         on error undo move_block, leave move_block
     1869         :
     1870           if p-change-value > 0
     1871           then do:
     1872             for each buf_temp-diasize-handle
     1873             on error undo, next
     1874             :
     1875               assign
     1876                 v-object-handle = buf_temp-diasize-handle.handle-value
     1877               .
     1878               if v-object-handle <> v-diasize-resize-button
     1879               then do:
     1880                 assign
     1881                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1882                 .
     1883               end.
     1884             end.
     1885             assign
     1886               v-diasize-browse-handle :height = v-browse-height
     1887             .
     1888             for each buf_temp-browse-handle
     1889               where buf_temp-browse-handle.browse-type = 'height':u
     1890             on error undo, next
     1891             :
     1892               assign
     1893                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1894               .
     1895             end.
     1896             assign
     1897               frame Dialog-Frame :height = v-frame-height
     1898             .
     1899             if frame Dialog-Frame :scrollable = true
     1900             then do:
     1901               assign
     1902                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1903               .
     1904             end.
     1905             run diasize_position-resize-button in this-procedure .
     1906           end.
     1907           else do:
     1908             if frame Dialog-Frame :scrollable = true
     1909             then do:
     1910               assign
     1911                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1912               .
     1913             end.
     1914             assign
     1915               frame Dialog-Frame :height = v-frame-height
     1916             .
     1917             assign
     1918               v-diasize-browse-handle :height = v-browse-height
     1919             .
     1920             for each buf_temp-browse-handle
     1921               where buf_temp-browse-handle.browse-type = 'height':u
     1922             on error undo, next
     1923             :
     1924               assign
     1925                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1926               .
     1927             end.
     1928             for each buf_temp-diasize-handle
     1929             on error undo, next
     1930             :
     1931               assign
     1932                 v-object-handle = buf_temp-diasize-handle.handle-value
     1933               .
     1934               if v-object-handle <> v-diasize-resize-button
     1935               then do:
     1936                 assign
     1937                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1938                 .
     1939               end.
     1940             end.
     1941             run diasize_position-resize-button in this-procedure .
     1942           end.
     1943           assign
     1944             v-diasize-change-size = false
     1945           .
     1946           leave move_block .
     1947         end.
     1948       end.
     1949       assign
     1950         v-diasize-need-full-display = true
     1951       .
     1952       if v-diasize-change-size = false
     1953       then do:
     1954         assign
     1955           v-diasize-change-size = true
     1956         .
     1957       end.
     1958       else do:
     1959         return .
     1960       end.
     1961       assign
     1962         v-frame-height = frame Dialog-Frame :height
     1963         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1964         v-browse-height = v-diasize-browse-handle :height
     1965       .
     1966       for each buf_temp-browse-handle
     1967         where buf_temp-browse-handle.browse-type = 'height':u
     1968       :
     1969         assign
     1970           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1971         .
     1972       end.
     1973       for each buf_temp-diasize-handle
     1974       :
     1975         delete buf_temp-diasize-handle .
     1976       end.
     1977       assign
     1978         v-field-group-handle = frame Dialog-Frame :first-child
     1979       .
     1980       do while valid-handle(v-field-group-handle)
     1981       :
     1982         assign
     1983           v-object-handle = v-field-group-handle :first-child
     1984         .
     1985         do while valid-handle(v-object-handle)
     1986         :
     1987           if  v-object-handle <> v-diasize-browse-handle :handle
     1988           and can-query(v-object-handle, "row")
     1989           and can-query(v-object-handle, "height")
     1990           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1991           then do:
     1992             find first buf_temp-browse-handle
     1993               where buf_temp-browse-handle.browse-type   = 'height':u
     1994                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1995               no-error .
     1996             if available buf_temp-browse-handle
     1997             then do:
     1998             end.
     1999             else do:
     2000               create buf_temp-diasize-handle .
     2001               assign
     2002                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2003                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2004               .
     2005             end.
     2006           end.
     2007           assign
     2008             v-object-handle = v-object-handle :next-sibling
     2009           .
     2010         end.
     2011         assign
     2012           v-field-group-handle = v-field-group-handle :next-sibling
     2013         .
     2014       end.
     2015       do with frame Dialog-Frame
     2016       :
     2017         hide v-diasize-resize-button .
     2018         assign
     2019           v-diasize-resize-button :row    = 1
     2020           v-diasize-resize-button :column = 1
     2021         .
     2022       end.
     2023       if p-change-value > 0
     2024       then do:
     2025         if frame Dialog-Frame :scrollable = true
     2026         then do:
     2027           assign
     2028             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2029             no-error .
     2030           if error-status :error
     2031           or error-status :get-message(1) <> ""
     2032           then do:
     2033             undo move_block, retry move_block .
     2034           end.
     2035         end.
     2036         assign
     2037           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2038           no-error .
     2039         if error-status :error
     2040         or error-status :get-message(1) <> ""
     2041         then do:
     2042           undo move_block, retry move_block .
     2043         end.
     2044         assign
     2045           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2046           no-error .
     2047         if error-status :error
     2048         or error-status :get-message(1) <> ""
     2049         then do:
     2050           undo move_block, retry move_block .
     2051         end.
     2052         for each buf_temp-browse-handle
     2053           where buf_temp-browse-handle.browse-type = 'height':u
     2054         on error undo move_block, retry move_block
     2055         :
     2056           assign
     2057             buf_temp-browse-handle.browse-handle :height
     2058               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2059             no-error .
     2060           if error-status :error
     2061           or error-status :get-message(1) <> ""
     2062           then do:
     2063             undo move_block, retry move_block .
     2064           end.
     2065         end.
     2066         for each buf_temp-diasize-handle
     2067         on error undo move_block, retry move_block
     2068         :
     2069           assign
     2070             v-object-handle = buf_temp-diasize-handle.handle-value
     2071           .
     2072           if v-object-handle <> v-diasize-resize-button
     2073           then do:
     2074             assign
     2075               v-object-handle :row = v-object-handle :row + p-change-value
     2076               no-error .
     2077             if error-status :error
     2078             or error-status :get-message(1) <> ""
     2079             then do:
     2080               undo move_block, retry move_block .
     2081             end.
     2082           end.
     2083         end.
     2084       end.
     2085       else do:
     2086         for each buf_temp-diasize-handle
     2087         on error undo move_block, retry move_block
     2088         :
     2089           assign
     2090             v-object-handle = buf_temp-diasize-handle.handle-value
     2091           .
     2092           if v-object-handle <> v-diasize-resize-button
     2093           then do:
     2094             assign
     2095               v-object-handle :row = v-object-handle :row + p-change-value
     2096               no-error .
     2097             if error-status :error
     2098             or error-status :get-message(1) <> ""
     2099             then do:
     2100               undo move_block, retry move_block .
     2101             end.
     2102           end.
     2103         end.
     2104         assign
     2105           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2106           no-error .
     2107         if error-status :error
     2108         or error-status :get-message(1) <> ""
     2109         then do:
     2110           undo move_block, retry move_block .
     2111         end.
     2112         for each buf_temp-browse-handle
     2113           where buf_temp-browse-handle.browse-type = 'height':u
     2114         on error undo move_block, retry move_block
     2115         :
     2116           assign
     2117             buf_temp-browse-handle.browse-handle :height
     2118               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2119             no-error .
     2120           if error-status :error
     2121           or error-status :get-message(1) <> ""
     2122           then do:
     2123             undo move_block, retry move_block .
     2124           end.
     2125         end.
     2126         assign
     2127           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2128           no-error .
     2129         if error-status :error
     2130         or error-status :get-message(1) <> ""
     2131         then do:
     2132           undo move_block, retry move_block .
     2133         end.
     2134         if frame Dialog-Frame :scrollable = true
     2135         then do:
     2136           assign
     2137             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2138             no-error .
     2139           if error-status :error
     2140           or error-status :get-message(1) <> ""
     2141           then do:
     2142             undo move_block, retry move_block .
     2143           end.
     2144         end.
     2145       end.
     2146       if p-move-resize = true
     2147       then do:
     2148         run diasize_position-resize-button in this-procedure .
     2149       end.
     2150       if v-diasize-wndstore = true
     2151       then do:
     2152         if connected("ub") = true
     2153         then do:
     2154           define variable v-cntxt-db-num        as integer   no-undo .
     2155           define variable v-cntxt-userid        as character no-undo .
     2156           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2157                                             , OUTPUT v-cntxt-userid
     2158                                             ) .
     2159           run gbl/wndsizew.p
     2160             (input  v-cntxt-db-num
     2161             ,input  v-cntxt-userid
     2162             ,input  v-diasize-proc-name
     2163             ,input  'height':u
     2164             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2165             ) .
     2166         end.
     2167       end.
     2168     end.
     2169     assign
     2170       v-diasize-change-size = false
     2171     .
     2172   end procedure.
     2173   procedure diasize_set-height :
     2174     define input  parameter p-new-height  as decimal   no-undo .
     2175     define input  parameter p-move-resize as logical   no-undo .
     2176     do
     2177     on error undo, return error return-value
     2178     :
     2179       run diasize_change-height in this-procedure
     2180         (input  (p-new-height - frame Dialog-Frame :height)
     2181         ,input  p-move-resize
     2182         ) .
     2183     end.
     2184   end procedure.
     2185   procedure diasize_change-width :
     2186     define input  parameter p-change-value as decimal   no-undo .
     2187     define input  parameter p-move-resize  as logical   no-undo .
     2188     define variable v-field-group-handle   as handle    no-undo .
     2189     define variable v-object-handle        as handle    no-undo .
     2190     define variable v-frame-width          as decimal   no-undo .
     2191     define variable v-frame-virtual-width  as decimal   no-undo .
     2192     define variable v-browse-width         as decimal   no-undo .
     2193     define variable v-window-width         as decimal   no-undo .
     2194     define variable v-window-virtual-width as decimal   no-undo .
     2195     define variable v-change-sign          as integer   no-undo .
     2196     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2197     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2198     if p-change-value > 0
     2199     then do:
     2200       if frame Dialog-Frame :width + p-change-value >
     2201           session :width-chars
     2202       then do:
     2203         assign
     2204           p-change-value = session :width-chars - frame Dialog-Frame :width
     2205         .
     2206         if p-change-value <= 0
     2207         then do:
     2208           run diasize_position-resize-button in this-procedure .
     2209           return .
     2210         end.
     2211       end.
     2212     end.
     2213     if p-change-value < 0
     2214     then do:
     2215       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2216       then do:
     2217         assign
     2218           p-change-value = v-diasize-orig-frame-width
     2219                          - frame Dialog-Frame :width
     2220         .
     2221         if p-change-value >= 0
     2222         then do:
     2223           run diasize_position-resize-button in this-procedure .
     2224           return .
     2225         end.
     2226       end.
     2227     end.
     2228     if p-change-value >= 0
     2229     then do:
     2230       assign
     2231         v-change-sign = 1
     2232       .
     2233     end.
     2234     else do:
     2235       assign
     2236         v-change-sign = -1
     2237       .
     2238     end.
     2239     assign
     2240       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2241     .
     2242     if p-change-value = 0
     2243     then do:
     2244       run diasize_position-resize-button in this-procedure .
     2245       return .
     2246     end.
     2247     move_block:
     2248     do
     2249     on error undo move_block, leave move_block
     2250     :
     2251       if retry
     2252       then do:
     2253         do
     2254         on error undo move_block, leave move_block
     2255         :
     2256           if p-change-value > 0
     2257           then do:
     2258             for each buf_temp-diasize-handle
     2259             on error undo, next
     2260             :
     2261               assign
     2262                 v-object-handle = buf_temp-diasize-handle.handle-value
     2263               .
     2264               if v-object-handle <> v-diasize-resize-button
     2265               then do:
     2266                 assign
     2267                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2268                 .
     2269               end.
     2270             end.
     2271             assign
     2272               v-diasize-browse-handle :width = v-browse-width
     2273             .
     2274             for each buf_temp-browse-handle
     2275               where buf_temp-browse-handle.browse-type = 'width':u
     2276             on error undo, next
     2277             :
     2278               assign
     2279                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2280               .
     2281             end.
     2282             assign
     2283               frame Dialog-Frame :width = v-frame-width
     2284             .
     2285             if frame Dialog-Frame :scrollable = true
     2286             then do:
     2287               assign
     2288                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2289               .
     2290             end.
     2291             run diasize_position-resize-button in this-procedure .
     2292           end.
     2293           else do:
     2294             if frame Dialog-Frame :scrollable = true
     2295             then do:
     2296               assign
     2297                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2298               .
     2299             end.
     2300             assign
     2301               frame Dialog-Frame :width = v-frame-width
     2302             .
     2303             for each buf_temp-browse-handle
     2304               where buf_temp-browse-handle.browse-type = 'width':u
     2305             on error undo, next
     2306             :
     2307               assign
     2308                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2309               .
     2310             end.
     2311             assign
     2312               v-diasize-browse-handle :width = v-browse-width
     2313             .
     2314             for each buf_temp-diasize-handle
     2315             on error undo, next
     2316             :
     2317               assign
     2318                 v-object-handle = buf_temp-diasize-handle.handle-value
     2319               .
     2320               if v-object-handle <> v-diasize-resize-button
     2321               then do:
     2322                 assign
     2323                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2324                 .
     2325               end.
     2326             end.
     2327             run diasize_position-resize-button in this-procedure .
     2328           end.
     2329           assign
     2330             v-diasize-change-size = false
     2331           .
     2332           leave move_block .
     2333         end.
     2334       end.
     2335       assign
     2336         v-diasize-need-full-display = true
     2337       .
     2338       if v-diasize-change-size = false
     2339       then do:
     2340         assign
     2341           v-diasize-change-size = true
     2342         .
     2343       end.
     2344       else do:
     2345         return .
     2346       end.
     2347       assign
     2348         v-frame-width = frame Dialog-Frame :width
     2349         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2350         v-browse-width = v-diasize-browse-handle :width
     2351       .
     2352       for each buf_temp-browse-handle
     2353         where buf_temp-browse-handle.browse-type = 'width':u
     2354       :
     2355         assign
     2356           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2357         .
     2358       end.
     2359       for each buf_temp-diasize-handle
     2360       :
     2361         delete buf_temp-diasize-handle .
     2362       end.
     2363       assign
     2364         v-field-group-handle = frame Dialog-Frame :first-child
     2365       .
     2366       do while valid-handle(v-field-group-handle)
     2367       :
     2368         assign
     2369           v-object-handle = v-field-group-handle :first-child
     2370         .
     2371         do while valid-handle(v-object-handle)
     2372         :
     2373           if  v-object-handle <> v-diasize-browse-handle :handle
     2374           and v-object-handle <> v-diasize-resize-button
     2375           and can-query(v-object-handle, "row")
     2376           and can-query(v-object-handle, "height")
     2377           and ( v-object-handle :col + v-object-handle :width
     2378                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2379               )
     2380           then do:
     2381             find first buf_temp-browse-handle
     2382               where buf_temp-browse-handle.browse-type   = 'width':u
     2383                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2384               no-error .
     2385             if available buf_temp-browse-handle
     2386             then do:
     2387             end.
     2388             else do:
     2389               create buf_temp-diasize-handle .
     2390               assign
     2391                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2392                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2393               .
     2394             end.
     2395           end.
     2396           assign
     2397             v-object-handle = v-object-handle :next-sibling
     2398           .
     2399         end.
     2400         assign
     2401           v-field-group-handle = v-field-group-handle :next-sibling
     2402         .
     2403       end.
     2404       do with frame Dialog-Frame
     2405       :
     2406         hide v-diasize-resize-button .
     2407         v-diasize-resize-button :row = 1.
     2408         v-diasize-resize-button :column = 1.
     2409       end.
     2410       if p-change-value > 0
     2411       then do:
     2412         if frame Dialog-Frame :scrollable = true
     2413         then do:
     2414           assign
     2415             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2416             no-error .
     2417           if error-status :error
     2418           or error-status :get-message(1) <> ""
     2419           then do:
     2420             undo move_block, retry move_block.
     2421           end.
     2422         end.
     2423         assign
     2424           frame Dialog-Frame :width = v-frame-width + p-change-value
     2425           no-error .
     2426         if error-status :error
     2427         or error-status :get-message(1) <> ""
     2428         then do:
     2429           undo move_block, retry move_block.
     2430         end.
     2431         assign
     2432           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2433         no-error .
     2434         if error-status :error
     2435         or error-status :get-message(1) <> ""
     2436         then do:
     2437           undo move_block, retry move_block.
     2438         end.
     2439         for each buf_temp-browse-handle
     2440           where buf_temp-browse-handle.browse-type = 'width':u
     2441         on error undo move_block, retry move_block
     2442         :
     2443           assign
     2444             buf_temp-browse-handle.browse-handle :width
     2445               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2446             no-error .
     2447           if error-status :error
     2448           or error-status :get-message(1) <> ""
     2449           then do:
     2450             undo move_block, retry move_block .
     2451           end.
     2452         end.
     2453         for each buf_temp-diasize-handle
     2454         on error undo move_block, retry move_block
     2455         :
     2456           assign
     2457             v-object-handle = buf_temp-diasize-handle.handle-value
     2458           .
     2459           if v-object-handle <> v-diasize-resize-button
     2460           then do:
     2461             assign
     2462               v-object-handle :col = v-object-handle :col + p-change-value
     2463               no-error .
     2464             if error-status :error
     2465             or error-status :get-message(1) <> ""
     2466             then do:
     2467               undo move_block, retry move_block .
     2468             end.
     2469           end.
     2470         end.
     2471       end.
     2472       else do:
     2473         for each buf_temp-diasize-handle
     2474         on error undo move_block, retry move_block
     2475         :
     2476           assign
     2477             v-object-handle = buf_temp-diasize-handle.handle-value
     2478           .
     2479           if v-object-handle <> v-diasize-resize-button
     2480           then do:
     2481             assign
     2482               v-object-handle :col = v-object-handle :col + p-change-value
     2483               no-error .
     2484             if error-status :error
     2485             or error-status :get-message(1) <> ""
     2486             then do:
     2487               undo move_block, retry move_block .
     2488             end.
     2489           end.
     2490         end.
     2491         for each buf_temp-browse-handle
     2492           where buf_temp-browse-handle.browse-type = 'width':u
     2493         on error undo move_block, retry move_block
     2494         :
     2495           assign
     2496             buf_temp-browse-handle.browse-handle :width
     2497               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2498             no-error .
     2499           if error-status :error
     2500           or error-status :get-message(1) <> ""
     2501           then do:
     2502             undo move_block, retry move_block .
     2503           end.
     2504         end.
     2505         assign
     2506           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2507           no-error .
     2508         if error-status :error
     2509         or error-status :get-message(1) <> ""
     2510         then do:
     2511           undo move_block, retry move_block.
     2512         end.
     2513         assign
     2514           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2515         no-error .
     2516         if error-status :error
     2517         or error-status :get-message(1) <> ""
     2518         then do:
     2519           undo move_block, retry move_block.
     2520         end.
     2521         if frame Dialog-Frame :scrollable = true
     2522         then do:
     2523           assign
     2524             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2525           no-error .
     2526           if error-status :error
     2527           or error-status :get-message(1) <> ""
     2528           then do:
     2529             undo move_block, retry move_block.
     2530           end.
     2531         end.
     2532       end.
     2533       if p-move-resize
     2534       then do:
     2535         run diasize_position-resize-button in this-procedure .
     2536       end.
     2537       if v-diasize-wndstore = true
     2538       then do:
     2539         if connected("ub") = true
     2540         then do:
     2541           define variable v-cntxt-db-num        as integer   no-undo .
     2542           define variable v-cntxt-userid        as character no-undo .
     2543           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2544                                             , OUTPUT v-cntxt-userid
     2545                                             ) .
     2546           run gbl/wndsizew.p
     2547             (input  v-cntxt-db-num
     2548             ,input  v-cntxt-userid
     2549             ,input  v-diasize-proc-name
     2550             ,input  'width':u
     2551             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2552             ) .
     2553         end.
     2554       end.
     2555     end.
     2556     assign
     2557       v-diasize-change-size = false
     2558     .
     2559   end procedure.
     2560   procedure diasize_set-width :
     2561     define input  parameter p-new-width  as decimal   no-undo .
     2562     define input  parameter p-move-resize as logical   no-undo .
     2563     do
     2564     on error undo, return error return-value
     2565     :
     2566       run diasize_change-width in this-procedure
     2567         (input  (p-new-width - frame Dialog-Frame :width)
     2568         ,input  p-move-resize
     2569         ) .
     2570     end.
     2571   end procedure.
     2572   procedure diasize_position-resize-button :
     2573     do with frame Dialog-Frame
     2574     :
     2575       hide v-diasize-resize-button .
     2576       assign
     2577         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2578                     - 1
     2579                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2580         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2581                     - 1
     2582                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2583       .
     2584       view v-diasize-resize-button .
     2585     end.
     2586   end procedure.
     2587   on alt-right anywhere
     2588   do:
     2589     run diasize_change-width in this-procedure
     2590       (input 1
     2591       ,input true
     2592       ) .
     2593     return no-apply .
     2594   end.
     2595   on alt-left anywhere
     2596   do:
     2597     run diasize_change-width in this-procedure
     2598       (input -1
     2599       ,input true
     2600       ) .
     2601     return no-apply .
     2602   end.
     2603   on alt-down anywhere
     2604   do:
     2605     run diasize_change-height in this-procedure
     2606       (input 1
     2607       ,input true
     2608       ) .
     2609     return no-apply .
     2610   end.
     2611   on alt-up anywhere
     2612   do:
     2613     run diasize_change-height in this-procedure
     2614       (input -1
     2615       ,input true
     2616       ) .
     2617     return no-apply .
     2618   end.
     2619   on alt-enter of frame Dialog-Frame
     2620   do:
     2621     run diasize_maximize in this-procedure
     2622       (input  ?
     2623       ).
     2624     return no-apply .
     2625   end.
     2626   procedure diasize_end-move :
     2627     do
     2628     on error undo, return error return-value
     2629     :
     2630       define variable v-row-delta as decimal   no-undo .
     2631       define variable v-col-delta as decimal   no-undo .
     2632       define variable v-new-row as decimal   no-undo .
     2633       define variable v-new-col as decimal   no-undo .
     2634       assign
     2635         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2636         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2637       .
     2638       assign
     2639         v-row-delta = v-new-row - frame Dialog-Frame :height
     2640         v-col-delta = v-new-col - frame Dialog-Frame :width
     2641       .
     2642       run diasize_change-height in this-procedure
     2643         (input v-row-delta
     2644         ,input true
     2645         ) .
     2646       run diasize_change-width in this-procedure
     2647         (input v-col-delta
     2648         ,input true
     2649         ) .
     2650     end.
     2651   end procedure.
     2652   procedure diasize_maximize :
     2653     define input  parameter p-action as logical   no-undo .
     2654     do
     2655     on error undo, return error return-value
     2656     :
     2657       if p-action = ?
     2658       then do:
     2659         if v-diasize-need-maximize = true
     2660         then do:
     2661           assign
     2662             p-action = true
     2663           .
     2664         end.
     2665         else do:
     2666           assign
     2667             p-action = false
     2668           .
     2669         end.
     2670       end.
     2671       if p-action = true
     2672       then do:
     2673         run diasize_change-height in this-procedure
     2674           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2675               - frame Dialog-Frame :height-chars
     2676           ,input true
     2677           ) .
     2678         run diasize_change-width in this-procedure
     2679           (input session :width-chars
     2680               - frame Dialog-Frame :width-chars
     2681           ,input true
     2682           ) .
     2683         assign
     2684           v-diasize-need-maximize = false
     2685         .
     2686       end.
     2687       else do:
     2688         run diasize_change-width in this-procedure
     2689           (input v-diasize-orig-frame-width
     2690               - frame Dialog-Frame :width-chars
     2691           ,input true
     2692           ) .
     2693         run diasize_change-height in this-procedure
     2694           (input v-diasize-orig-frame-height
     2695               - frame Dialog-Frame :height-chars
     2696           ,input true
     2697           ) .
     2698         assign
     2699           v-diasize-need-maximize = true
     2700         .
     2701       end.
     2702     end.
     2703   end procedure.
     2704   procedure diasize_restore-orig-size :
     2705     do
     2706     on error undo, return error return-value
     2707     :
     2708       assign
     2709         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2710         v-diasize-current-frame-height = frame Dialog-Frame :height
     2711       .
     2712       run diasize_set-height in this-procedure
     2713         (input  v-diasize-orig-frame-height
     2714         ,input  true
     2715         ) .
     2716       run diasize_set-width in this-procedure
     2717         (input  v-diasize-orig-frame-width
     2718         ,input  true
     2719         ) .
     2720     end.
     2721   end procedure.
     2722   procedure diasize_restore-current-size :
     2723     do
     2724     on error undo, return error return-value
     2725     :
     2726       run diasize_set-height in this-procedure
     2727         (input  v-diasize-current-frame-height
     2728         ,input  true
     2729         ) .
     2730       run diasize_set-width in this-procedure
     2731         (input  v-diasize-current-frame-width
     2732         ,input  true
     2733         ) .
     2734     end.
     2735   end procedure.
     2736   procedure diasize_set-browse-handle :
     2737     define input  parameter p-browse-handle as handle   no-undo .
     2738     define buffer buf_temp-browse-handle for temp-browse-handle .
     2739     do
     2740     on error undo, return error return-value
     2741     :
     2742       assign
     2743         v-diasize-browse-handle = p-browse-handle
     2744       .
     2745       for each buf_temp-browse-handle
     2746       on error undo, return error return-value
     2747       :
     2748         delete buf_temp-browse-handle .
     2749       end.
     2750     end.
     2751   end procedure.
     2752   procedure diasize_add_browse :
     2753     define input  parameter p-browse-type   as character no-undo .
     2754     define input  parameter p-browse-handle as handle    no-undo .
     2755     define buffer buf_temp-browse-handle for temp-browse-handle .
     2756     do
     2757     on error undo, return error return-value
     2758     :
     2759       assign
     2760         v-diasize-browse-number = v-diasize-browse-number + 1
     2761       .
     2762       create buf_temp-browse-handle .
     2763       assign
     2764         buf_temp-browse-handle.browse-type   = p-browse-type
     2765         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2766         buf_temp-browse-handle.browse-handle = p-browse-handle
     2767       .
     2768     end.
     2769   end procedure.
     2770   procedure diasize_init :
     2771     define variable v-default-value    as logical   no-undo .
     2772     define variable v-restore-saved    as logical   no-undo .
     2773     define variable v-resize-value-str as character no-undo .
     2774     do
     2775     on error undo, return error return-value
     2776     :
     2777       do with frame Dialog-Frame
     2778       :
     2779         assign
     2780           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2781           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2782           v-diasize-browse-handle     = browse br-c-gds-grp-hist :handle
     2783         .
     2784         create button v-diasize-resize-button
     2785         assign
     2786           parent        = frame Dialog-Frame :first-child
     2787           label         = "s"
     2788           height-pixels = 16
     2789           width-pixels  = 16
     2790           visible       = true
     2791           sensitive     = true
     2792           movable       = true
     2793           triggers:
     2794             on end-move persistent run diasize_end-move in this-procedure .
     2795           end triggers.
     2796         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2797         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2798         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2799         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2800         assign
     2801           v-diasize-wndmax = false
     2802         .
     2803         if connected("ub") = true
     2804         then do:
     2805           define variable v-cntxt-db-num        as integer   no-undo .
     2806           define variable v-cntxt-userid        as character no-undo .
     2807           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2808                                             , OUTPUT v-cntxt-userid
     2809                                             ) .
     2810           run gbl/wndpar_r.p
     2811             (input  v-cntxt-db-num
     2812             ,input  v-cntxt-userid
     2813             ,input  'wndmax':U
     2814             ,output v-diasize-wndmax
     2815             ,output v-default-value
     2816             ) .
     2817         end.
     2818         assign
     2819           v-diasize-wndstore = false
     2820         .
     2821         if connected("ub") = true
     2822         then do:
     2823           run gbl/wndpar_r.p
     2824             (input  v-cntxt-db-num
     2825             ,input  v-cntxt-userid
     2826             ,input  'wndstore':U
     2827             ,output v-diasize-wndstore
     2828             ,output v-default-value
     2829             ) .
     2830         end.
     2831         assign
     2832           v-diasize-proc-name = entry(1, program-name(2), '.')
     2833         .
     2834         if v-diasize-wndstore = true
     2835         then do:
     2836           assign
     2837             v-restore-saved = false
     2838           .
     2839           if connected("ub") = true
     2840           then do:
     2841             run gbl/wndsizer.p
     2842               (input  v-cntxt-db-num
     2843               ,input  v-cntxt-userid
     2844               ,input  v-diasize-proc-name
     2845               ,input  'height':u
     2846               ,output v-resize-value-str
     2847               ) .
     2848             if v-resize-value-str <> '':U
     2849             then do:
     2850               run diasize_change-height in this-procedure
     2851                 (input  integer(v-resize-value-str)
     2852                 ,input  true
     2853                 ) .
     2854               assign
     2855                 v-restore-saved = true
     2856               .
     2857             end.
     2858           end.
     2859           if connected("ub") = true
     2860           then do:
     2861             run gbl/wndsizer.p
     2862               (input  v-cntxt-db-num
     2863               ,input  v-cntxt-userid
     2864               ,input  v-diasize-proc-name
     2865               ,input  'width':u
     2866               ,output v-resize-value-str
     2867               ) .
     2868             if v-resize-value-str <> '':U
     2869             then do:
     2870               run diasize_change-width in this-procedure
     2871                 (input  integer(v-resize-value-str)
     2872                 ,input  true
     2873                 ) .
     2874               assign
     2875                 v-restore-saved = true
     2876               .
     2877             end.
     2878           end.
     2879           if v-restore-saved <> true
     2880           then do:
     2881             if v-diasize-wndmax = true
     2882             then do:
     2883               run diasize_maximize in this-procedure
     2884                 (input  true
     2885                 ) .
     2886             end.
     2887           end.
     2888         end.
     2889         else do:
     2890           if v-diasize-wndmax = true
     2891           then do:
     2892             run diasize_maximize in this-procedure
     2893               (input  true
     2894               ) .
     2895           end.
     2896         end.
     2897       end.
     2898     end.
     2899   end procedure.
     2900   procedure diasize_need-full-display :
     2901     define output parameter p-need-full-display as logical   no-undo .
     2902     do
     2903     on error undo, return error return-value
     2904     :
     2905       assign
     2906         p-need-full-display = v-diasize-need-full-display
     2907       .
     2908       assign
     2909         v-diasize-need-full-display = false
     2910       .
     2911     end.
     2912   end procedure.
     2913   procedure get-context :
     2914      define output parameter p-db-num as integer          no-undo.
     2915      define output parameter p-user-id as character        no-undo.
     2916      define variable v-login               as character    no-undo.
     2917      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2918      define buffer buf_user-login  for ub.user-login .
     2919      do
     2920      on error undo, return error
     2921      :
     2922            FIND FIRST buf_sys-ctrl no-lock.
     2923            ASSIGN
     2924               v-login = USERID("ub")
     2925               p-db-num = buf_sys-ctrl.db-num
     2926            .
     2927            FIND FIRST buf_user-login
     2928                 WHERE buf_user-login.db-num = p-db-num
     2929                   AND buf_user-login.user-login = v-login
     2930                 no-lock
     2931                 no-error
     2932                 .
     2933            IF AVAILABLE buf_user-login
     2934            THEN DO:
     2935               assign
     2936                  p-user-id = buf_user-login.user-id
     2937               .
     2938            END.
     2939      end.
     2940   end procedure.
     2941   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2942   procedure set-filter-name :
     2943   define input parameter p-filter-name as character no-undo .
     2944     do with frame Dialog-Frame:
     2945       if p-filter-name > "" then do:
     2946         assign
     2947           frame Dialog-Frame:title
     2948             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2949         .
     2950         assign
     2951           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2952         .
     2953       end.
     2954       else do:
     2955         assign
     2956           b-sch :tooltip = ""
     2957         .
     2958       end.
     2959     end.
     2960   end procedure.
     2961   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2962   on f5 of frame Dialog-Frame anywhere
     2963   do:
     2964     v-doc-rec = recid(X_c-gds-grp-hist). run openbr in this-procedure ( input yes, input no, input '':U). reposition br-c-gds-grp-hist to recid v-doc-rec no-error.
     2965                 APPLY 'VALUE-CHANGED' to br-c-gds-grp-hist.
     2966       apply "VALUE-CHANGED" to BR-c-gds-grp-hist.
     2967   end.
     2968   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2969   do:
     2970     BR-c-gds-grp-hist :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2971   end.
     2972   def var sort-labelbr-c-gds-grp-hist   as character no-undo .
     2973   def var sort-clmnbr-c-gds-grp-hist    as handle    no-undo .
     2974   def var cur-clmnbr-c-gds-grp-hist     as handle    no-undo .
     2975   def var cur-clmn-locbr-c-gds-grp-hist as integer   no-undo .
     2976   def var re-querybr-c-gds-grp-hist     as logical   initial no no-undo .
     2977   on start-search, ctrl-o of br-c-gds-grp-hist in frame Dialog-Frame do:
     2978      run sort-brbr-c-gds-grp-hist
     2979        (input (if available X_c-gds-grp-hist
     2980                then recid(X_c-gds-grp-hist)
     2981                else ?
     2982               )
     2983        ).
     2984   end.
     2985   PROCEDURE sort-brbr-c-gds-grp-hist :
     2986     define input parameter p-recid as recid no-undo .
     2987     if re-querybr-c-gds-grp-hist = no then do:
     2988       assign
     2989          cur-clmnbr-c-gds-grp-hist = br-c-gds-grp-hist:current-column in frame Dialog-Frame
     2990       .
     2991       if sort-clmnbr-c-gds-grp-hist <> ? then sort-clmnbr-c-gds-grp-hist:column-fgcolor = 0.
     2992       if cur-clmnbr-c-gds-grp-hist = sort-clmnbr-c-gds-grp-hist then do:
     2993         assign
     2994            sort-labelbr-c-gds-grp-hist = ""
     2995            sort-clmnbr-c-gds-grp-hist = ?
     2996         .
     2997        end.
     2998        else do:
     2999          assign
     3000            sort-labelbr-c-gds-grp-hist = cur-clmnbr-c-gds-grp-hist:label
     3001            sort-clmnbr-c-gds-grp-hist  = cur-clmnbr-c-gds-grp-hist
     3002            sort-clmnbr-c-gds-grp-hist:column-fgcolor = 4
     3003          .
     3004        end.
     3005      end.
     3006     assign
     3007       cur-clmn-locbr-c-gds-grp-hist = 1
     3008     .
     3009     def var column-handle as handle no-undo .
     3010     column-handle = br-c-gds-grp-hist:first-column.
     3011     do while valid-handle(column-handle) :
     3012       if column-handle = cur-clmnbr-c-gds-grp-hist then do:
     3013         leave .
     3014       end.
     3015       column-handle = column-handle:NEXT-COLUMN.
     3016       assign
     3017         cur-clmn-locbr-c-gds-grp-hist = cur-clmn-locbr-c-gds-grp-hist + 1
     3018       .
     3019     end.
     3020     case sort-labelbr-c-gds-grp-hist:
     3021           when X_c-gds-grp-hist.corr-date:label in browse br-c-gds-grp-hist then DO:    assign       sort-column-name = "X_c-gds-grp-hist.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3022           when X_c-gds-grp-hist.corr-user-db-num:label in browse br-c-gds-grp-hist then DO:    assign       sort-column-name = "X_c-gds-grp-hist.corr-user-db-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3023       otherwise do:
     3024         assign
     3025           sort-column-name = ""
     3026         .
     3027         run OpenBr in this-procedure ( input yes, input no, input '':U).
     3028         if sort-labelbr-c-gds-grp-hist <> "" then do:
     3029           assign
     3030             cur-clmnbr-c-gds-grp-hist:column-fgcolor = 0
     3031           .
     3032         end.
     3033         assign
     3034           cur-clmn-locbr-c-gds-grp-hist = ?
     3035         .
     3036       end.
     3037     end case.
     3038     if p-recid <> ? then do:
     3039       reposition br-c-gds-grp-hist to recid p-recid no-error.
     3040       apply "value-changed" to br-c-gds-grp-hist in frame Dialog-Frame.
     3041     end.
     3042     apply "entry" to br-c-gds-grp-hist in frame Dialog-Frame.
     3043   END PROCEDURE.
     3044   procedure re-open-query-srt-clmnbr-c-gds-grp-hist:
     3045   if cur-clmnbr-c-gds-grp-hist = ? then do:
     3046      run OpenBr in this-procedure ( input yes, input no, input '':U).
     3047   end.
     3048   else do:
     3049      assign re-querybr-c-gds-grp-hist = yes.
     3050      run sort-brbr-c-gds-grp-hist
     3051        (input (if available X_c-gds-grp-hist
     3052                then recid(X_c-gds-grp-hist)
     3053                else ?
     3054               )
     3055        ).
     3056      assign re-querybr-c-gds-grp-hist = no.
     3057   end.
     3058   end.
     3059   MAIN-BLOCK:
     3060   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3061      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3062      if LOOKUP(p-mode, ("gds-grp":U  + chr(4) +
     3063                        "gds-prt":U + chr(4) +
     3064                        "gds-grp-attr":U  + chr(4) +
     3065                        "gds-grp-obj":U  + chr(4) +
     3066                        "tax-rate-gds-grp":U  + chr(4) +
     3067                        ("gds-grp-attr":U + chr(44) + 'объект':U) + chr(4) +
     3068                        ("gds-grp-obj":U + chr(44) + 'объект':U)  + chr(4) +
     3069                        ("tax-rate-gds-grp":U + chr(44) + 'объект':U)  + chr(4) +
     3070                        ("gds-grp-attr":U + chr(44) + "host":U) + chr(4) +
     3071                        ("gds-grp-obj":U + chr(44) + "host":U)  + chr(4) +
     3072                        ("tax-rate-gds-grp":U + chr(44) + "host":U)),
     3073                        chr(4)
     3074                        ) > 0
     3075      THEN DO:
     3076        if p-mode = "gds-prt" then do:
     3077         find first X_gds-prt no-lock where
     3078                     X_gds-prt.node-code = p-node-code
     3079                 no-error .
     3080         if not available X_gds-prt
     3081         and not p-is-del
     3082         then do:
     3083             message
     3084             vss-workfile vss-revision vss-description skip
     3085             "Неверное значение параметра p-node-code и/или p-is-del" p-node-code p-is-del
     3086             view-as alert-box ERROR.
     3087             return.
     3088         end.
     3089        end.
     3090        else do:
     3091         find first X_gds-grp no-lock where
     3092                     X_gds-grp.node-code = p-node-code
     3093                 no-error .
     3094         if not available X_gds-grp
     3095         and not p-is-del
     3096         then do:
     3097             message
     3098             vss-workfile vss-revision vss-description skip
     3099             "Неверное значение параметра p-node-code и/или p-is-del" p-node-code p-is-del
     3100             view-as alert-box ERROR.
     3101             return.
     3102         end.
     3103      end.
     3104      if LOOKUP(p-mode,
     3105                        'объект':U ) > 0
     3106      THEN DO:
     3107       find first X_clients-obj no-lock where
     3108                 X_clients-obj.obj-type = p-obj-type
     3109             AND X_clients-obj.obj-code = p-obj-code no-error .
     3110       if not available X_clients-obj then do:
     3111           message
     3112           vss-workfile vss-revision vss-description skip
     3113           "Неверное значение параметров p-obj-type и/или p-obj-code" p-obj-type p-obj-code
     3114           view-as alert-box ERROR.
     3115           return.
     3116       end.
     3117   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3118   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3119     (input  p-obj-type
     3120     ,input  p-obj-code
     3121     ,output p-host-code
     3122     )  .
     3123      end.
     3124      if LOOKUP(p-mode,
     3125                        "host":U ) > 0
     3126      THEN DO:
     3127         find first X_sysconf no-lock where
     3128                   X_sysconf.host-code = p-host-code  no-error .
     3129         if not available X_sysconf then do:
     3130             message
     3131             vss-workfile vss-revision vss-description skip
     3132             "Неверное значение параметра p-host-code" p-host-code
     3133             view-as alert-box ERROR.
     3134             return.
     3135         end.
     3136      end.
     3137      if LOOKUP(p-mode, "tax-rate-gds-grp") > 0 then do:
     3138       if NOT p-tax-code = 0 then do:
     3139         find first X_tax no-lock where X_tax.tax-code = p-tax-code no-error .
     3140         if not available X_sysconf then do:
     3141             message
     3142             vss-workfile vss-revision vss-description skip
     3143             "Неверное значение параметра p-tax-code" p-tax-code
     3144             view-as alert-box ERROR.
     3145             return.
     3146         end.
     3147        end.
     3148      end.
     3149      if lookup(p-mode, "gds-grp-attr") > 0 then do:
     3150         if lookup(p-attr-code, 'gds-grp-nabor':u) = 0 then do:
     3151             message
     3152             vss-workfile vss-revision vss-description skip
     3153             "Неверное значение параметра p-attr-code" p-attr-code
     3154             view-as alert-box ERROR.
     3155             return.
     3156         end.
     3157      end.
     3158     END.
     3159     else do:
     3160         message vss-workfile vss-revision vss-description skip
     3161         "Неверный вызов - p-mode=" p-mode
     3162         view-as alert-box ERROR.
     3163         return.
     3164     end.
     3165     RUN MyEnable.
     3166     HIDE mark-num in frame Dialog-Frame .
     3167     run OpenBR in this-procedure ( input yes, input no, input '':U).
     3168     run diasize_add_browse in this-procedure
     3169       (input  'width':u
     3170       ,input  browse br-changes :handle
     3171       ) .
     3172     run diasize_add_browse in this-procedure
     3173       (input  'width':u
     3174       ,input  v-full-name-old:handle
     3175       ) .
     3176     run diasize_add_browse in this-procedure
     3177       (input  'width':u
     3178       ,input  v-full-name-new:handle
     3179       ) .
     3180       run diasize_init in this-procedure .
     3181     WAIT-FOR GO OF FRAME Dialog-Frame.
     3182   END.
     3183   RUN disable_UI.
     3184   PROCEDURE disable_UI :
     3185     HIDE FRAME Dialog-Frame.
     3186   END PROCEDURE.
     3187   PROCEDURE enable_UI :
     3188     DISPLAY mark-num v-full-name-old v-full-name-new
     3189         WITH FRAME Dialog-Frame.
     3190     ENABLE b-quit B-mark b-sel B-sch B-Help mark-num BR-c-gds-grp-hist BR-changes
     3191            v-full-name-old v-full-name-new
     3192         WITH FRAME Dialog-Frame.
     3193     VIEW FRAME Dialog-Frame.
     3194     OPEN QUERY BR-c-gds-grp-hist FOR EACH X_c-gds-grp-hist NO-LOCK.
     3195   END PROCEDURE.
     3196   PROCEDURE MyEnable :
     3197   br-changes:title in frame Dialog-Frame  = "":U.
     3198   assign
     3199   temp-changes.l_name:resizable in browse br-changes = true
     3200   temp-changes.v_old:resizable in browse br-changes = true
     3201   temp-changes.v_new:resizable in browse br-changes = true
     3202   temp-changes.l_name:width in browse br-changes = 30
     3203   temp-changes.v_old:width in browse br-changes = 40
     3204   temp-changes.v_new:width in browse br-changes = 40
     3205   .
     3206   DISPLAY
     3207   mark-num
     3208   br-changes
     3209   WITH FRAME Dialog-Frame.
     3210   ENABLE
     3211   B-quit
