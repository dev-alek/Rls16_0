        1   DEFINE BUFFER X_c-PromoAction FOR c-PromoAction.
        2   DEFINE BUFFER X_PromoAction FOR PromoAction.
        3   define input parameter bttns         as character no-undo .
        4   define input parameter p-mode        as character no-undo .
        5   define input parameter p-obj-type like ub.clients.obj-type no-undo.
        6   define input parameter p-obj-code like ub.clients.obj-code no-undo.
        7   define input parameter p-actionId like ub.PromoAction.id no-undo .
        8   define input-output param p-rid-list    as  char no-undo .
        9   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       10   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       11   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       12   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       13   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
