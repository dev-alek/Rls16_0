      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      122   define new shared variable RepPathName        as character no-undo .
      123   define new shared variable PrintRubl          as logical   no-undo .
      124   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define variable v-waitfram-action01         as character   no-undo .
      126   define variable v-waitfram-action02         as character   no-undo .
      127   define variable v-waitfram-action03         as character   no-undo .
      128   define variable mWaitFramTextBeg            as character   no-undo.
      129   define variable mWaitFramTextEnd            as character   no-undo.
      130   define variable mWaitFramView               as logical     no-undo.
      131   define variable mWaitProcEvent              as logical     no-undo init yes.
      132   define variable mWaitFramInterval           as integer     no-undo init 1 .
      133   define variable mWaitFramStop               as logical     no-undo.
      134   define variable mWaitFramStopUser           as logical     no-undo.
      135   define variable mWaitFramStopTimeOut        as logical     no-undo.
      136   define variable mWaitFramStartProc          as datetime-tz no-undo.
      137   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      138   define button B-WaitFramStop auto-end-key
      139        label "Стоп"
      140        size 10 by 1 tooltip "Остоновить процесс".
      141   define button B-viewProcInfo
      142        label "Информация"
      143        size 15 by 1 tooltip "Информация о процесс".
      144   define frame waitfram
      145     v-waitfram-action01 format "x(72)" no-label skip
      146     v-waitfram-action02 format "x(72)" no-label skip
      147     v-waitfram-action03 format "x(72)" no-label skip
      148     B-viewProcInfo
      149     B-WaitFramStop at row 4 col 30
      150     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      151     .
      152   define new global shared variable mBatchMode as logical no-undo init ?.
      153   define variable mFramBachModHandle as handle no-undo.
      154   mFramBachModHandle = frame waitfram:handle.
      155   define variable mFameOldVis as logical no-undo.
      156   define variable mVisCUrentVin as logical no-undo.
      157   if session:batch-mode
      158   then
      159      mBatchMode = yes.
      160   if mBatchMode = ? then do:
      161     mVisCUrentVin = current-window:visible.
      162     mFameOldVis = mFramBachModHandle:visible.
      163     mFramBachModHandle:visible  = yes.
      164     mBatchMode = mFramBachModHandle:visible ne yes.
      165     mFramBachModHandle:visible = mFameOldVis.
      166     current-window:visible = mVisCUrentVin.
      167   end.
      168    if  log-manager:logfile-name ne ?
      169     then DO:
      170         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      171         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      172         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      173     end.
      174   on choose of B-WaitFramStop in frame waitfram
      175   do:
      176     mWaitFramStop = yes.
      177     mWaitFramStopUser = yes.
      178   end.
      179   function waitfram-check-timeout returns logical():
      180      define variable vtime as int64 no-undo.
      181      if mWaitFramStopTimeOut
      182      then
      183         return yes.
      184      vtime = ( now - mWaitFramStartProc ) / 1000 .
      185      if     mWaitFramTimeOut ne ?
      186         and mWaitFramTimeOut ne 0
      187         and mWaitFramTimeOut lt vtime
      188      then do:
      189         mWaitFramStopTimeOut = yes.
      190      end.
      191      return mWaitFramStopTimeOut.
      192   end.
      193   procedure waitfram-hide :
      194     if not session:batch-mode
      195     then do
      196     on error undo, return error return-value
      197     :
      198       pause 0 before-hide .
      199       if not mBatchMode then
      200         hide frame waitfram .
      201     if     not mWaitFramView
      202        and mWaitProcEvent
      203     then
      204       process events .
      205     end.
      206   end procedure.
      207   procedure waitfram-show :
      208     define input  parameter p-message as character no-undo .
      209     define variable v-left-margin as integer   no-undo .
      210     if not session:batch-mode
      211     then do
      212     on error undo, return error return-value
      213     :
      214       if length(p-message) <= 70 then do:
      215         assign
      216           v-left-margin = integer((70 - length(p-message)) / 2)
      217         .
      218         assign
      219           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      220         .
      221         assign
      222           v-waitfram-action01 = " "
      223           v-waitfram-action02 = " "
      224                                    + fill(" ", v-left-margin)
      225                                    + p-message
      226           v-waitfram-action03 = " "
      227         .
      228       end.
      229       else do:
      230         define variable vRindex1 as integer no-undo.
      231         define variable vRindex2 as integer no-undo.
      232         vRindex1 = r-index(p-message," ",70).
      233         if vRindex1 = 0
      234         then
      235            vRindex1 = 70.
      236         if length(p-message)  <= vRindex1 + 70 then do:
      237           assign
      238             v-waitfram-action01 = " "
      239             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      240             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      241           .
      242         end.
      243         else do:
      244           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      245           if vRindex2 <= vRindex1
      246           then
      247              vRindex2 = vRindex1 + 70.
      248           assign
      249             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      250             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      251             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      252           .
      253         end.
      254       end.
      255       B-viewProcInfo:visible   in frame waitfram = no.
      256       B-viewProcInfo:sensitive in frame waitfram = no.
      257       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      258       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      259       if  (   mWaitFramView
      260          or  mWaitProcEvent)
      261          and not mBatchMode
      262       then
      263          display
      264             v-waitfram-action01 skip
      265             v-waitfram-action02 skip
      266             v-waitfram-action03 skip
      267          with frame waitfram .
      268       if     mWaitFramView
      269          then do:
      270             if     mWaitFramInterval ne ?
      271                and not mBatchMode
      272             then
      273                wait-for go of frame waitfram pause mWaitFramInterval.
      274          end.
      275          else
      276             if     mWaitProcEvent
      277                and not mBatchMode
      278             then
      279                process events .
      280     end.
      281   end procedure.
      282      procedure waitfram-show-this:
      283         define input  parameter iInterval as int64 no-undo.
      284         define variable vtime as int64 no-undo.
      285         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      286         mWaitFramInterval = iInterval.
      287         run waitfram-show (substitute("&1&2 &3&4" ,
      288                                       mWaitFramTextBeg ,
      289                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      290                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      291                                       mWaitFramTextEnd
      292                                      )
      293                           ).
      294      end.
      295      procedure WaitFramRunPause:
      296         define input  parameter iInterval as dec no-undo.
      297         define variable vStart  as datetime-tz no-undo.
      298         define variable vend    as datetime-tz no-undo.
      299         define variable vint as int64 no-undo.
      300         define variable vOk as logical no-undo.
      301         vStart = now.
      302         vend   = vStart.
      303         publish "WaitFramPause" (iInterval,output vOk).
      304         vend   =  now.
      305         vint = vend - vStart.
      306         vint = iInterval - vint / 1000.
      307         if     not mWaitFramStop
      308            and (   vint > 0
      309                 or (    not vOk
      310                     and iInterval eq ?
      311                     )
      312                 )
      313         then
      314            run waitfram-show-this (iInterval).
      315         vend   =  now.
      316         vint = vend - vStart.
      317         vint = iInterval - vint / 1000.
      318         if     not mWaitFramStop
      319            and vint > 0
      320         then do:
      321            run gbl/pause.p (vint * 1000).
      322         end.
      323         if iInterval ne ?
      324         then
      325            publish "WaitFramStop".
      326         waitfram-check-timeout().
      327      end.
      328      procedure WaitFramWaitFor:
      329         define input  parameter iInterval as dec no-undo.
      330         assign
      331            mWaitFramStartProc   = now
      332            mWaitFramStopUser    = no
      333            mWaitFramStopTimeOut = no
      334         .
      335         block-wait:
      336         do while not mWaitFramStop:
      337            run WaitFramRunPause (iInterval).
      338            if  waitfram-check-timeout()
      339            then do:
      340               leave block-wait.
      341            end.
      342         end.
      343         run waitfram-hide.
      344      end.
      345   procedure waitfram-join :
      346     define input  parameter p-line-1  as character no-undo .
      347     define input  parameter p-line-2  as character no-undo .
      348     define input  parameter p-line-3  as character no-undo .
      349     define output parameter p-message as character no-undo .
      350     do
      351     on error undo, return error return-value
      352     :
      353       assign
      354         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      355                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      356                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      357       .
      358     end.
      359   end procedure.
      360   function waitfram-join-function returns character
      361     (input p-line-1 as character
      362     ,input p-line-2 as character
      363     ,input p-line-3 as character
      364     ).
      365     define variable v-message as character no-undo .
      366     run waitfram-join in this-procedure
      367       (input  p-line-1
      368       ,input  p-line-2
      369       ,input  p-line-3
      370       ,output v-message
      371       ) .
      372     return v-message .
      373   end function .
      374   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      375   define  stream PrnLibStream.
      376   procedure prn-lib-prn-file :
      377     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      378     define input parameter p-DIsabledoptions as integer no-undo .
      379     define variable v-report-name as character no-undo .
      380     define variable v-user-action as character no-undo .
      381     define variable v-printed     as logical   no-undo .
      382     define variable v-exist       as logical   no-undo .
      383     do
      384       on error undo, return error
      385       :
      386       run prn-lib-get-report-name  in this-procedure (
      387         input parParentProc
      388         ,output v-report-name
      389         ).
      390   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      391   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      392     (input  v-report-name
      393     ,input  2
      394     ,output v-exist
      395     )  .
      396       if NOT v-exist then
      397       DO:
      398         Message
      399           "Нет заданий на печать ! "
      400           view-as alert-box .
      401         Return  .
      402       End.
      403       run gbl/prnfilen.w
      404         (input  ""
      405         ,input  p-DisabledOptions
      406         ,input  string(v-report-name )
      407         ,input  7
      408         ,output v-user-action
      409         ,output v-printed
      410         ) .
      411       if v-printed then
      412       do:
      413         return "YES" .
      414       end.
      415       else
      416       do:
      417         return "NO" .
      418       end.
      419     end.
      420   end procedure.
      421   procedure prn-lib-open-stream :
      422     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      423     define input parameter p-page-size    as integer no-undo .
      424     define input parameter p-is-stream    as logical no-undo .
      425     define input parameter p-append       as logical no-undo .
      426     define variable v-report-name as character no-undo .
      427     do
      428       on error undo, return error
      429       :
      430       run prn-lib-get-report-name  in this-procedure (
      431         input parParentProc
      432         ,output v-report-name
      433         ).
      434       if p-is-stream then
      435       do:
      436         if p-append then
      437         do:
      438           output stream PrnLibStream to value( v-report-name )
      439             page-size value(p-page-size) append .
      440         end.
      441         if not p-append then
      442         do:
      443           output stream PrnLibStream to value( v-report-name )
      444             page-size value(p-page-size) .
      445         end.
      446       end.
      447       if not p-is-stream then
      448       do:
      449         if p-append then
      450         do:
      451           output to value( v-report-name )
      452             page-size value(p-page-size) append .
      453         end.
      454         if not p-append then
      455         do:
      456           output to value( v-report-name )
      457             page-size value(p-page-size) .
      458         end.
      459       end.
      460     end.
      461   end procedure.
      462   procedure prn-lib-open-exp :
      463     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      464     define input parameter p-is-stream    as logical no-undo .
      465     define input parameter p-is-append    as logical no-undo .
      466     define output parameter p-ReportFileName as char init "report" no-undo.
      467     define output parameter p-process as logical no-undo .
      468     define variable glog as logical no-undo .
      469     do
      470       on error undo, return error
      471       :
      472       SYSTEM-DIALOG GET-FILE p-ReportFileName
      473         TITLE      "Укажите путь"
      474         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      475         ASK-OVERWRITE
      476         CREATE-TEST-FILE
      477         SAVE-AS
      478         USE-FILENAME
      479         DEFAULT-EXTENSION "txt"
      480         UPDATE glog
      481         .
      482       if not glog then  return.
      483       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      484       if p-is-stream then
      485       do:
      486         if p-is-append then
      487         do:
      488           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      489         end.
      490         else
      491         do:
      492           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      493         end.
      494       end.
      495       else
      496       do:
      497         if p-is-append then
      498         do:
      499           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      500         end.
      501         else
      502         do:
      503           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      504         end.
      505       end.
      506       p-process = yes.
      507     end.
      508   end procedure.
      509   procedure prn-lib-get-report-name :
      510     define input parameter parParentProc  as widget-handle no-undo.
      511     define output parameter p-report-name as character no-undo .
      512     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      513   end procedure.
      514   procedure prn-lib-reportviewer-report-name :
      515     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      516     define input parameter p-report-name-html as character no-undo .
      517     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      518   end procedure.
      519   procedure prn-lib-reportviewer :
      520     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      521     define input parameter p-report-name-html as character no-undo .
      522     define input parameter p-param        as character no-undo .
      523     define variable v-excel           as character no-undo init 'TRUE' .
      524     define variable v-value-character as character no-undo .
      525     define variable v-value-integer   as character no-undo .
      526     define variable v-value-date      as date      no-undo .
      527     define variable v-value-decimal   as decimal   no-undo .
      528     define variable rep-excel         as logical   no-undo .
      529     define variable excel-string      as character no-undo .
      530     define variable v-param-type      as character no-undo .
      531     define variable v-tth             as handle    no-undo .
      532     run adm/shattri.p (
      533       input "get":U
      534       ,input  ""
      535       ,input  0
      536       ,input  'report-glob':U
      537       ,input  'rep-excel':U
      538       ,output v-value-character
      539       ,output v-value-date
      540       ,output v-value-decimal
      541       ,output v-value-integer
      542       ,output rep-excel
      543       ,output v-param-type
      544       ,INPUT-OUTPUT table-handle v-tth
      545       )  .
      546     if rep-excel then v-excel = "TRUE" .
      547     else v-excel = "FALSE" .
      548     if p-param eq ""
      549     then
      550        p-param = "EXCEL:" + v-excel.
      551     else
      552        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      553     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      554   end procedure.
      555   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      556   procedure cur-time :
      557      define output parameter p-today as date      no-undo .
      558      define output parameter p-time  as integer   no-undo .
      559     do
      560     on error undo, return error
      561     :
      562       define variable v-date1 as date      no-undo .
      563       define variable v-date2 as date      no-undo .
      564       define variable v-time  as integer   no-undo .
      565       assign
      566         v-date1 = today
      567         v-time  = time
      568         v-date2 = today
      569       .
      570       if v-date1 <> v-date2
      571       then do:
      572         assign
      573           v-date1 = today
      574           v-time  = v-time
      575         .
      576       end.
      577       assign
      578         p-today = v-date1
      579         p-time  = v-time
      580       .
      581     end.
      582   end.
      583   function cur-time-date returns character
      584   :
      585     return string(today, '99/99/9999':U) .
      586   end.
      587   function cur-time-mjd returns decimal
      588   :
      589     define variable v-date as date      no-undo .
      590     define variable v-time as integer   no-undo .
      591     run cur-time in this-procedure
      592       (output v-date
      593       ,output v-time
      594       ) .
      595     return integer(v-date) - 2400002 + (v-time / 86400) .
      596   end.
      597   function cur-time-get-ending-index returns integer
      598   (input p-number as integer
      599   )
      600   :
      601     if p-number < 0
      602     or p-number = ?
      603     then do:
      604       return 1 .
      605     end.
      606     define variable v-rest as integer   no-undo .
      607     assign
      608       p-number = p-number modulo 100
      609     .
      610     if p-number < 20
      611     then do:
      612       assign
      613         v-rest = p-number
      614       .
      615     end.
      616     else do:
      617       assign
      618         v-rest = p-number modulo 10
      619       .
      620     end.
      621     case v-rest :
      622       when 1
      623       then do:
      624         return 2 .
      625       end.
      626       when 2 or
      627       when 3 or
      628       when 4
      629       then do:
      630         return 3 .
      631       end.
      632       otherwise do:
      633         return 1 .
      634       end.
      635     end case .
      636   end.
      637   procedure cur-time-mjd-to-date :
      638      define input  parameter i-mjd-diff as decimal no-undo.
      639      define output parameter o-Date     as date    no-undo.
      640      define output parameter o-Time     as integer no-undo.
      641      define variable v-day-number as integer   no-undo .
      642      if    i-mjd-diff < 0
      643         or i-mjd-diff = ?
      644      then do:
      645         return "?" .
      646      end.
      647      assign
      648         v-day-number = truncate(i-mjd-diff,0).
      649         o-Date = date(v-day-number + 2400002).
      650         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      651     .
      652   end.
      653   function cur-time-mjd-to-string returns character
      654   (input p-mjd-diff as decimal
      655   )
      656   :
      657     define variable v-day-number as integer   no-undo .
      658     define variable v-seconds    as integer   no-undo .
      659     define variable v-hour       as integer   no-undo .
      660     define variable v-min        as integer   no-undo .
      661     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      662     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      663     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      664     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      665     if p-mjd-diff < 0
      666     or p-mjd-diff = ?
      667     then do:
      668       return "?" .
      669     end.
      670     assign
      671       v-day-number = integer(truncate(p-mjd-diff,0))
      672       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      673     .
      674     if v-seconds > 86400
      675     then do:
      676       assign
      677         v-seconds = 86400 - 1
      678       .
      679     end.
      680     if v-seconds < 0
      681     then do:
      682       assign
      683         v-seconds = 0
      684       .
      685     end.
      686     assign
      687       v-hour = truncate(v-seconds / 3600, 0)
      688     .
      689     assign
      690       v-seconds = v-seconds modulo 3600
      691     .
      692     assign
      693       v-min = truncate(v-seconds / 60, 0)
      694     .
      695     assign
      696       v-seconds = v-seconds modulo 60
      697     .
      698     return
      699         (if v-day-number <> 0
      700           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      701           else ""
      702         )
      703       + (if v-day-number <> 0 or v-hour <> 0
      704           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      705           else ""
      706         )
      707       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      708           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      709           else ""
      710         )
      711       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      712       .
      713   end.
      714   function cur-time-string returns character
      715   :
      716     define variable v-date as date      no-undo .
      717     define variable v-time as integer   no-undo .
      718     run cur-time in this-procedure
      719       (output v-date
      720       ,output v-time
      721       ) .
      722     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      723   end.
      724   function cur-time-string-sec returns character
      725   :
      726     define variable v-date as date      no-undo .
      727     define variable v-time as integer   no-undo .
      728     run cur-time in this-procedure
      729       (output v-date
      730       ,output v-time
      731       ) .
      732     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      733   end.
      734   function cur-time-custom  returns character
      735   (input p-prefix as character
      736   ,input p-date-format as character
      737   ,input p-delimiter as character
      738   ,input p-time-format as character
      739   ,input p-suffix as character
      740   )
      741   :
      742     define variable v-date as date      no-undo .
      743     define variable v-time as integer   no-undo .
      744     run cur-time in this-procedure
      745       (output v-date
      746       ,output v-time
      747       ) .
      748     return
      749       p-prefix
      750       + string(v-date, p-date-format)
      751       + p-delimiter
      752       + string(v-time, p-time-format)
      753       + p-suffix
      754       .
      755   end.
      756   function cur-time-print  returns character
      757   :
      758     define variable v-date as date      no-undo .
      759     define variable v-time as integer   no-undo .
      760     run cur-time in this-procedure
      761       (output v-date
      762       ,output v-time
      763       ) .
      764     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      765   end.
      766   function cur-time-datetime returns datetime
      767   :
      768     define variable v-char as character no-undo .
      769     define variable v-datetime as datetime no-undo .
      770     v-char = cur-time-string().
      771     v-datetime = datetime(v-char).
      772     return  v-datetime.
      773   end.
      774   function cur-time-string-msec returns character
      775   :
      776     define variable v-date as datetime  no-undo .
      777     v-date = now.
      778     return string(v-date) .
      779   end.
      780   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      781   FUNCTION mark-string RETURNS CHARACTER
      782     ( input p-recid as recid, input mark-list as character  ) :
      783     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      784   END FUNCTION.
      785   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      786   function usrfulnf returns character ( input p-user-id as character):
      787   define variable v-user-name as character no-undo .
      788   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      789   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      790     (input  p-user-id
      791     ,output v-user-name
      792     ) no-error .
      793   if error-status:error
      794   or v-user-name = ""
      795   then do:
      796     return p-user-id.
      797   end.
      798   else do:
      799     return v-user-name.
      800   end.
      801   end function.
      802   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      803   define variable sort-column-name as character no-undo .
      804   define variable v-db-num LIKE ub.db.db-num no-undo.
      805   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      806   define  temp-table temp-changes no-undo
      807   field f_name as character
      808   field l_name as character
      809   field v_old as character
      810   field v_new as character
      811   field t_name as character
      812   field num_ as integer
      813   field uniq-key-rec as character
      814   field action as integer
      815   field fNotChange as logical
      816   index pi is unique primary
      817   num_
      818   t_name
      819   f_name
      820   index
      821   Chan
      822   fnotChange
      823   t_name
      824   f_name
      825   index imain uniq-key-rec
      826   .
      827   FUNCTION get-all-fields returns character (p-file-name as character ):
      828   define variable v-dop as character no-undo .
      829     find first _file no-lock where _file._file-name = p-file-name no-error .
      830     if not available _file then return "":U.
      831     for each _field no-lock where
      832              _field._file-recid = recid(_file) :
      833       assign
      834       v-dop = v-dop + _field._field-name + chr(44)
      835       .
      836     end.
      837     return trim(v-dop).
      838   END FUNCTION.
      839   PROCEDURE proc-full-temp-changes :
      840     define input  parameter p-hst-handle as handle    no-undo .
      841     define input  parameter p-main-table as character no-undo .
      842     define input  parameter p-field-list as character no-undo .
      843     define input  parameter p-label-form as character no-undo .
      844     define variable h-new-buf         as handle    no-undo .
      845     define variable h-main-buf        as handle    no-undo .
      846     define variable h-for-comp        as handle    no-undo .
      847     define variable v-inform          as character no-undo .
      848     define variable v-ind             as integer   no-undo .
      849     define variable v-idx-field-qnty  as integer   no-undo .
      850     define variable v-num-entries     as integer   no-undo .
      851     define variable fh                as handle    no-undo .
      852     define variable fh-main           as handle    no-undo .
      853     define variable fh-old            as handle    no-undo .
      854     define variable fh-new            as handle    no-undo .
      855     define variable v-field-name      as character no-undo .
      856     define variable v-field-lvl       as character no-undo .
      857     define variable v-field-form      as character no-undo .
      858     define variable v-search-exp      as character no-undo .
      859     define variable v-srch-main       as character no-undo .
      860     define variable v-word-link       as character no-undo .
      861     define variable v-av-chip-num     as logical   no-undo .
      862     define variable v-main-pi-fld-lst as character no-undo .
      863     define variable v-main-fld-lst    as character no-undo .
      864     define variable v-delim-list      as character no-undo .
      865     define variable v-label           as character no-undo .
      866     define variable v-old-value       as character no-undo case-sensitive.
      867     define variable v-new-value       as character no-undo case-sensitive.
      868     define variable v-chg-fields as character no-undo.
      869     for each temp-changes:
      870       delete temp-changes.
      871     end.
      872     if not p-hst-handle:available then do:
      873       return .
      874     end.
      875     create buffer h-new-buf  for table p-hst-handle .
      876     create buffer h-main-buf for table p-main-table .
      877     assign
      878       v-inform = h-main-buf:index-information(1)
      879       v-ind    = 2
      880     .
      881     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      882     on error undo, return error
      883     :
      884       assign
      885         v-inform = h-main-buf:index-information( v-ind )
      886         v-ind    = v-ind + 1
      887       .
      888     end.
      889     if v-inform = ?
      890       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      891       or entry( 3, v-inform, ",":U ) <> "1":U
      892     then do:
      893       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      894     end.
      895     assign
      896       v-idx-field-qnty = num-entries( v-inform ) - 4
      897     .
      898     if v-idx-field-qnty < 2 then do:
      899       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      900     end.
      901     assign
      902       v-srch-main   = "where":U
      903       v-word-link   = "":U
      904       v-av-chip-num = false
      905       v-delim-list  = "":U
      906     .
      907     do v-ind = 1 to v-idx-field-qnty by 2
      908     on error undo, return error
      909     :
      910       assign
      911         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      912         fh                = p-hst-handle:buffer-field( v-field-name )
      913         fh-main           = h-main-buf:buffer-field( v-field-name )
      914         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      915         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      916       .
      917       if fh:data-type ="character":U then do:
      918         assign
      919           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      920         .
      921       end.
      922       else do:
      923         assign
      924           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      925         .
      926       end.
      927       if v-delim-list = "":U then do:
      928         assign
      929           v-delim-list = ",":U
      930         .
      931       end.
      932       if v-word-link = "":U then do:
      933         assign
      934           v-word-link = "and":U
      935         .
      936       end.
      937     end.
      938     assign
      939       v-delim-list  = "":U
      940     .
      941     do v-ind = 1 to h-main-buf:num-fields
      942     on error undo, return error
      943     :
      944       assign
      945         fh-main      = h-main-buf:buffer-field( v-ind )
      946         v-field-name = fh-main:name
      947       .
      948         assign
      949           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      950         .
      951         if v-delim-list = "":U then do:
      952           assign
      953             v-delim-list = ",":U
      954           .
      955         end.
      956     end.
      957     assign
      958       v-inform = p-hst-handle:index-information(1)
      959       v-ind    = 2
      960     .
      961     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      962     on error undo, return error
      963     :
      964       assign
      965         v-inform = p-hst-handle:index-information( v-ind )
      966         v-ind    = v-ind + 1
      967       .
      968     end.
      969     if v-inform = ?
      970       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      971       or entry( 3, v-inform, ",":U ) <> "1":U
      972     then do:
      973       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      974     end.
      975     assign
      976       v-idx-field-qnty = num-entries( v-inform ) - 4
      977     .
      978     if v-idx-field-qnty < 2 then do:
      979       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      980     end.
      981     assign
      982       v-search-exp  = "where":U
      983       v-word-link   = "":U
      984       v-av-chip-num = false
      985     .
      986     do v-ind = 1 to v-idx-field-qnty by 2
      987     on error undo, return error
      988     :
      989       assign
      990         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      991         fh           = p-hst-handle:buffer-field( v-field-name )
      992         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      993       .
      994       if v-field-name = "chip-num":U then do:
      995         assign
      996           v-search-exp  = substitute( "&1 >", v-search-exp )
      997           v-av-chip-num = true
      998         .
      999       end.
     1000       else do:
     1001         assign
     1002           v-search-exp = substitute( "&1 =", v-search-exp )
     1003         .
     1004       end.
     1005       if fh:data-type ="character":U then do:
     1006         assign
     1007           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1008         .
     1009       end.
     1010       else do:
     1011         assign
     1012           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1013         .
     1014       end.
     1015       if v-word-link = "":U then do:
     1016         assign
     1017           v-word-link = "and":U
     1018         .
     1019       end.
     1020     end.
     1021     if v-av-chip-num = false then do:
     1022       message
     1023         vss-workfile vss-revision vss-description skip
     1024         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1025         "Использование данной процедуры невозможно!" skip
     1026         view-as alert-box error .
     1027       return error .
     1028     end.
     1029     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1030     if not h-new-buf:available then do:
     1031       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1032       if not h-main-buf:available then do:
     1033         assign
     1034           h-for-comp = ?
     1035         .
     1036       end.
     1037       else do:
     1038         assign
     1039           h-for-comp = h-main-buf
     1040         .
     1041       end.
     1042     end.
     1043     else do:
     1044       assign
     1045         h-for-comp = h-new-buf
     1046       .
     1047     end.
     1048     assign
     1049       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1050     .
     1051     do v-ind = 1 to v-num-entries
     1052     on error undo, return error return-value
     1053     :
     1054       assign
     1055         v-field-name = entry( v-ind, v-main-fld-lst )
     1056         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1057         v-old-value  = fh-old:buffer-value()
     1058         v-label      = trim( fh-old:label )
     1059       .
     1060       if ( trim( p-field-list ) <> "":U
     1061            and lookup( v-field-name, p-field-list ) > 0
     1062          )
     1063          or trim( p-field-list ) = "":U
     1064       then do:
     1065         if h-for-comp <> ? then do:
     1066           assign
     1067             fh-new      = h-for-comp:buffer-field( v-field-name )
     1068             v-new-value = fh-new:buffer-value()
     1069           .
     1070         end.
     1071         else do:
     1072           assign
     1073             v-new-value = "":U
     1074           .
     1075         end.
     1076         if v-old-value <> v-new-value
     1077         then do:
     1078           create temp-changes.
     1079           assign
     1080             temp-changes.t_name = p-main-table
     1081             temp-changes.f_name = v-field-name
     1082             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1083             temp-changes.v_old  = trim( v-old-value )
     1084             temp-changes.v_new  = trim( v-new-value )
     1085             temp-changes.num_   = 0
     1086             temp-changes.fNotChange = v-old-value eq v-new-value
     1087           .
     1088         end.
     1089       end.
     1090     end.
     1091     assign
     1092       v-num-entries = num-entries( p-label-form, chr(8) )
     1093     .
     1094     do v-ind = 1 to v-num-entries
     1095     on error undo, return error return-value
     1096     :
     1097       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1098         assign
     1099           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1100           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1101           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1102         .
     1103         find first temp-changes
     1104           where temp-changes.f_name = v-field-name
     1105           no-error .
     1106         if available temp-changes then do:
     1107           if trim( v-field-lvl ) <> "":U then do:
     1108             assign
     1109               temp-changes.l_name = v-field-lvl
     1110             .
     1111           end.
     1112           if trim( v-field-form ) <> "":U then do:
     1113             assign
     1114               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1115             .
     1116             if h-for-comp <> ? then do:
     1117               assign
     1118                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1119               .
     1120             end.
     1121           end.
     1122         end.
     1123       end.
     1124       else do:
     1125         message
     1126           vss-workfile vss-revision vss-description skip
     1127           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1128           substitute( "список для поля '&1': '&2'"
     1129                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1130                       ,entry( v-ind, p-label-form, chr(8) )
     1131                     ) skip
     1132           substitute( "полный список: &2", p-label-form ) skip
     1133           view-as alert-box error .
     1134       end.
     1135     end.
     1136     delete object h-new-buf .
     1137     delete object h-main-buf .
     1138   END PROCEDURE.
     1139   DEFINE BUTTON B-Help
     1140        LABEL "Помо&щь"
     1141        SIZE 3 BY 1
     1142        BGCOLOR 8 .
     1143   DEFINE BUTTON B-mark
     1144        LABEL "&*"
     1145        SIZE 3 BY 1.
     1146   DEFINE BUTTON b-quit AUTO-END-KEY
     1147        LABEL "&Выход"
     1148        SIZE 10 BY 1
     1149        BGCOLOR 8 .
     1150   DEFINE BUTTON B-sel AUTO-GO
     1151        LABEL "Вы&бор"
     1152        SIZE 10 BY 1.
     1153   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1154         VIEW-AS TEXT
     1155        SIZE 6 BY 1
     1156        FGCOLOR 4  NO-UNDO.
     1157   DEFINE QUERY BR-changes FOR
     1158         temp-changes SCROLLING.
     1159   DEFINE QUERY br-wp FOR
     1160         X_c-PromoAction SCROLLING.
     1161   DEFINE BROWSE BR-changes
     1162     QUERY BR-changes DISPLAY
     1163   temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(120)"
     1164   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1165   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1166       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.05.
     1167   DEFINE BROWSE br-wp
     1168     QUERY br-wp NO-LOCK DISPLAY
     1169         mark-string(recid(X_c-PromoAction), p-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1170         usrfulnf(X_c-PromoAction.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1171         X_c-PromoAction.corr-date COLUMN-LABEL "Дата!измен" FORMAT "99/99/9999":U
     1172         string(X_c-PromoAction.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1173         X_c-PromoAction.id COLUMN-LABEL "ид.!акции" FORMAT ">>>,>>9":U
     1174         X_c-PromoAction.nameAction COLUMN-LABEL "Наименование акции" FORMAT "x(40)":U
     1175         X_c-PromoAction.TypeDiscont
     1176       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.24 FIT-LAST-COLUMN.
     1177   DEFINE FRAME Dialog-Frame
     1178        b-quit AT ROW 1 COL 1
     1179        B-mark AT ROW 1 COL 11
     1180        B-sel AT ROW 1 COL 21
     1181        B-Help AT ROW 1 COL 95
     1182        br-wp AT ROW 3 COL 1
     1183        BR-changes AT ROW 13 COL 1
     1184        mark-num AT ROW 1 COL 12.6 COLON-ALIGNED NO-LABEL
     1185        SPACE(78.52) SKIP(20.05)
     1186       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1187            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1188            TITLE "История промо-акций"
     1189            CANCEL-BUTTON b-quit.
     1190   ASSIGN
     1191          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1192          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1193   ASSIGN
     1194          br-wp:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1
     1195          br-wp:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE
     1196          br-wp:COLUMN-MOVABLE IN FRAME Dialog-Frame         = TRUE.
     1197   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1198   DO:
     1199     APPLY "END-ERROR":U TO SELF.
     1200   END.
     1201   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1202   DO:
     1203     define variable loc#log as logical no-undo .
     1204     if available X_c-PromoAction then do:
     1205   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1206   define variable v-str-recid10 as character no-undo .
     1207   define variable v-num-entry10 as integer   no-undo .
     1208   assign
     1209     v-str-recid10 = trim( string( recid( X_c-PromoAction ) , "->>>>>>>>>>>9":U ) )
     1210     v-num-entry10 = lookup( v-str-recid10 , p-rid-list )
     1211   .
     1212   if v-num-entry10 > 0 then do:
     1213     assign
     1214       entry( v-num-entry10, p-rid-list ) = "":U
     1215       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1216     .
     1217   end.
     1218   else do:
     1219     assign
     1220       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid10
     1221     .
     1222   end.
     1223       loc#log = br-wp:refresh() .
     1224       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1225           loc#log = br-wp:select-next-row ().
     1226           apply "VALUE-CHANGED" to br-wp in frame Dialog-Frame.
     1227       end.
     1228       if num-entries( p-rid-list ) = 0
     1229       then
     1230           hide mark-num in frame Dialog-Frame.
     1231       else
     1232           disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
     1233     end.
     1234     apply "entry" to br-wp in frame Dialog-Frame.
     1235   END.
     1236   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1237   DO:
     1238       if ( available X_c-PromoAction ) then do:
     1239       if  ( p-rid-list = "" ) or b-mark:sensitive = no
     1240       then
     1241       p-rid-list = string( recid( X_c-PromoAction ) ) .
     1242     end.
     1243   END.
     1244   ON VALUE-CHANGED OF br-wp IN FRAME Dialog-Frame
     1245   DO:
     1246     run proc-view-changes in this-procedure no-error.
     1247   END.
     1248   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1249   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1250   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1251   on help of frame Dialog-Frame
     1252   do:
     1253     run gbl/app_help.p
     1254       (input this-procedure :file-name
     1255       ,input ''
     1256       ,input ?
     1257       ) no-error.
     1258     if error-status :error then do:
     1259       message
     1260         "Ошибка при вызове помощи"
     1261         error-status :get-message(1)
     1262         view-as alert-box .
     1263     end.
     1264   end.
     1265   run minbtn-set in this-procedure .
     1266   on choose of b-help in frame Dialog-Frame
     1267   do:
     1268     apply "help":u to frame Dialog-Frame .
     1269   end.
     1270   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1271   procedure minbtn-set :
     1272       do
     1273           on error undo, return error return-value
     1274           :
     1275           define variable ii              as integer       no-undo .
     1276           define variable fh              as widget-handle no-undo .
     1277           define variable hh              as widget-handle no-undo .
     1278           define variable v-h             as handle        extent 4 no-undo .
     1279           define variable v-name-button   as character     no-undo .
     1280           define variable v-help-old-x    as decimal       no-undo .
     1281           define variable v-help-old-y    as decimal       no-undo .
     1282           define variable v-help-old-size as decimal       no-undo .
     1283           define variable v-frame-width   as decimal       no-undo .
     1284           define variable jj              as integer       no-undo .
     1285           do
     1286               on error undo, return error
     1287               :
     1288               assign
     1289                   v-frame-width = frame Dialog-Frame:width - 0.3
     1290                   fh            = frame Dialog-Frame:first-child
     1291                   hh            = fh:first-child
     1292                   ii            = 1
     1293                   .
     1294               do while valid-handle(hh):
     1295                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1296                   do:
     1297                       case lc(hh:name) :
     1298                           when "b-help" then
     1299                               do:
     1300                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1301                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1302                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1303                                   hh:TOOLTIP = "Помощь" .
     1304                                   v-help-old-x = hh:column .
     1305                                   v-help-old-y = hh:row    .
     1306                                   v-help-old-size = hh:width .
     1307                                   hh:width-chars = 2.5 .
     1308                               end.
     1309                           when "b-print" then
     1310                               do:
     1311                                   hh:load-image("cmp/b-print.bmp":u) .
     1312                                   hh:TOOLTIP = "Печать" .
     1313                                   v-h[ii] = hh:handle .
     1314                                   ii = ii + 1 .
     1315                                   hh:width-chars = 3 .
     1316                               end.
     1317                           when "b-history" or
     1318                           when "b-hist" then
     1319                               do:
     1320                                   hh:load-image("cmp/b-hist.bmp":u) .
     1321                                   hh:TOOLTIP = "История" .
     1322                                   v-h[ii] = hh:handle .
     1323                                   ii = ii + 1 .
     1324                                   hh:width-chars = 3 .
     1325                               end.
     1326                           when "b-sch" then
     1327                               do:
     1328                                   hh:load-image("cmp/b-sch.bmp":u) .
     1329                                   hh:TOOLTIP = "Установка Фильтра" .
     1330                                   v-h[ii] = hh:handle .
     1331                                   ii = ii + 1 .
     1332                                   hh:width-chars = 3 .
     1333                               end.
     1334                           when "b-hist-user" then
     1335                               do:
     1336                                   hh:load-image("cmp/b-hist.bmp":u) .
     1337                                   hh:TOOLTIP = "История пользователя" .
     1338                                   ii = ii + 1 .
     1339                               end.
     1340                       end case.
     1341                   end.
     1342                   hh = hh:next-sibling.
     1343               end.
     1344               b-help:column = v-frame-width - b-help:width-chars.
     1345               jj = 0.
     1346               repeat ii = 4 to 1 by -1 :
     1347                   if valid-handle (v-h[ii] ) then
     1348                   do:
     1349                       jj  = jj + 1 .
     1350                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1351                       v-h[ii]:row    = v-help-old-y .
     1352                   end.
     1353               end.
     1354           end.
     1355       end.
     1356   end procedure.
     1357   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1358   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1359   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1360   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1361   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1362   define variable v-diasize-current-frame-height as decimal   no-undo .
     1363   define variable v-diasize-change-size          as logical   no-undo .
     1364   define variable v-diasize-resize-button        as handle    no-undo .
     1365   define variable v-diasize-wndmax               as logical   no-undo .
     1366   define variable v-diasize-wndstore             as logical   no-undo .
     1367   define variable v-diasize-proc-name            as character no-undo .
     1368   define variable v-diasize-browse-handle        as handle    no-undo .
     1369   define variable v-diasize-browse-number        as integer   no-undo .
     1370   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1371   define temp-table temp-diasize-handle no-undo
     1372     field handle-value  as handle
     1373     field save-position as decimal
     1374     index xpk is primary unique handle-value
     1375     .
     1376   define temp-table temp-browse-handle no-undo
     1377     field browse-type   as character
     1378     field browse-number as integer
     1379     field browse-handle as handle
     1380     field original-size as decimal
     1381     index xpk is primary unique browse-type browse-number
     1382     index xie browse-type browse-handle
     1383   .
     1384   procedure diasize_change-height :
     1385     define input  parameter p-change-value  as decimal   no-undo .
     1386     define input  parameter p-move-resize   as logical   no-undo .
     1387     define variable v-field-group-handle    as handle    no-undo .
     1388     define variable v-object-handle         as handle    no-undo .
     1389     define variable v-frame-height          as decimal   no-undo .
     1390     define variable v-frame-virtual-height  as decimal   no-undo .
     1391     define variable v-browse-height         as decimal   no-undo .
     1392     define variable v-window-height         as decimal   no-undo .
     1393     define variable v-window-virtual-height as decimal   no-undo .
     1394     define variable v-change-sign           as integer   no-undo .
     1395     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1396     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1397     if p-change-value > 0
     1398     then do:
     1399       if frame Dialog-Frame :height + p-change-value
     1400           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1401       then do:
     1402         assign
     1403           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1404                           - (frame Dialog-Frame :height-chars)
     1405         .
     1406         if p-change-value <= 0
     1407         then do:
     1408           run diasize_position-resize-button in this-procedure .
     1409           return .
     1410         end.
     1411       end.
     1412     end.
     1413     if p-change-value < 0
     1414     then do:
     1415       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1416       then do:
     1417         assign
     1418           p-change-value = v-diasize-orig-frame-height
     1419                          - (frame Dialog-Frame :height-chars)
     1420         .
     1421         if p-change-value >= 0
     1422         then do:
     1423           run diasize_position-resize-button in this-procedure .
     1424           return .
     1425         end.
     1426       end.
     1427     end.
     1428     if p-change-value >= 0
     1429     then do:
     1430       assign
     1431         v-change-sign = 1
     1432       .
     1433     end.
     1434     else do:
     1435       assign
     1436         v-change-sign = -1
     1437       .
     1438     end.
     1439     assign
     1440       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1441     .
     1442     if p-change-value = 0
     1443     then do:
     1444       run diasize_position-resize-button in this-procedure .
     1445       return .
     1446     end.
     1447     move_block:
     1448     do
     1449     on error undo move_block, retry move_block
     1450     :
     1451       if retry
     1452       then do:
     1453         do
     1454         on error undo move_block, leave move_block
     1455         :
     1456           if p-change-value > 0
     1457           then do:
     1458             for each buf_temp-diasize-handle
     1459             on error undo, next
     1460             :
     1461               assign
     1462                 v-object-handle = buf_temp-diasize-handle.handle-value
     1463               .
     1464               if v-object-handle <> v-diasize-resize-button
     1465               then do:
     1466                 assign
     1467                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1468                 .
     1469               end.
     1470             end.
     1471             assign
     1472               v-diasize-browse-handle :height = v-browse-height
     1473             .
     1474             for each buf_temp-browse-handle
     1475               where buf_temp-browse-handle.browse-type = 'height':u
     1476             on error undo, next
     1477             :
     1478               assign
     1479                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1480               .
     1481             end.
     1482             assign
     1483               frame Dialog-Frame :height = v-frame-height
     1484             .
     1485             if frame Dialog-Frame :scrollable = true
     1486             then do:
     1487               assign
     1488                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1489               .
     1490             end.
     1491             run diasize_position-resize-button in this-procedure .
     1492           end.
     1493           else do:
     1494             if frame Dialog-Frame :scrollable = true
     1495             then do:
     1496               assign
     1497                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1498               .
     1499             end.
     1500             assign
     1501               frame Dialog-Frame :height = v-frame-height
     1502             .
     1503             assign
     1504               v-diasize-browse-handle :height = v-browse-height
     1505             .
     1506             for each buf_temp-browse-handle
     1507               where buf_temp-browse-handle.browse-type = 'height':u
     1508             on error undo, next
     1509             :
     1510               assign
     1511                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1512               .
     1513             end.
     1514             for each buf_temp-diasize-handle
     1515             on error undo, next
     1516             :
     1517               assign
     1518                 v-object-handle = buf_temp-diasize-handle.handle-value
     1519               .
     1520               if v-object-handle <> v-diasize-resize-button
     1521               then do:
     1522                 assign
     1523                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1524                 .
     1525               end.
     1526             end.
     1527             run diasize_position-resize-button in this-procedure .
     1528           end.
     1529           assign
     1530             v-diasize-change-size = false
     1531           .
     1532           leave move_block .
     1533         end.
     1534       end.
     1535       assign
     1536         v-diasize-need-full-display = true
     1537       .
     1538       if v-diasize-change-size = false
     1539       then do:
     1540         assign
     1541           v-diasize-change-size = true
     1542         .
     1543       end.
     1544       else do:
     1545         return .
     1546       end.
     1547       assign
     1548         v-frame-height = frame Dialog-Frame :height
     1549         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1550         v-browse-height = v-diasize-browse-handle :height
     1551       .
     1552       for each buf_temp-browse-handle
     1553         where buf_temp-browse-handle.browse-type = 'height':u
     1554       :
     1555         assign
     1556           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1557         .
     1558       end.
     1559       for each buf_temp-diasize-handle
     1560       :
     1561         delete buf_temp-diasize-handle .
     1562       end.
     1563       assign
     1564         v-field-group-handle = frame Dialog-Frame :first-child
     1565       .
     1566       do while valid-handle(v-field-group-handle)
     1567       :
     1568         assign
     1569           v-object-handle = v-field-group-handle :first-child
     1570         .
     1571         do while valid-handle(v-object-handle)
     1572         :
     1573           if  v-object-handle <> v-diasize-browse-handle :handle
     1574           and can-query(v-object-handle, "row")
     1575           and can-query(v-object-handle, "height")
     1576           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1577           then do:
     1578             find first buf_temp-browse-handle
     1579               where buf_temp-browse-handle.browse-type   = 'height':u
     1580                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1581               no-error .
     1582             if available buf_temp-browse-handle
     1583             then do:
     1584             end.
     1585             else do:
     1586               create buf_temp-diasize-handle .
     1587               assign
     1588                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1589                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1590               .
     1591             end.
     1592           end.
     1593           assign
     1594             v-object-handle = v-object-handle :next-sibling
     1595           .
     1596         end.
     1597         assign
     1598           v-field-group-handle = v-field-group-handle :next-sibling
     1599         .
     1600       end.
     1601       do with frame Dialog-Frame
     1602       :
     1603         hide v-diasize-resize-button .
     1604         assign
     1605           v-diasize-resize-button :row    = 1
     1606           v-diasize-resize-button :column = 1
     1607         .
     1608       end.
     1609       if p-change-value > 0
     1610       then do:
     1611         if frame Dialog-Frame :scrollable = true
     1612         then do:
     1613           assign
     1614             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1615             no-error .
     1616           if error-status :error
     1617           or error-status :get-message(1) <> ""
     1618           then do:
     1619             undo move_block, retry move_block .
     1620           end.
     1621         end.
     1622         assign
     1623           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1624           no-error .
     1625         if error-status :error
     1626         or error-status :get-message(1) <> ""
     1627         then do:
     1628           undo move_block, retry move_block .
     1629         end.
     1630         assign
     1631           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1632           no-error .
     1633         if error-status :error
     1634         or error-status :get-message(1) <> ""
     1635         then do:
     1636           undo move_block, retry move_block .
     1637         end.
     1638         for each buf_temp-browse-handle
     1639           where buf_temp-browse-handle.browse-type = 'height':u
     1640         on error undo move_block, retry move_block
     1641         :
     1642           assign
     1643             buf_temp-browse-handle.browse-handle :height
     1644               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1645             no-error .
     1646           if error-status :error
     1647           or error-status :get-message(1) <> ""
     1648           then do:
     1649             undo move_block, retry move_block .
     1650           end.
     1651         end.
     1652         for each buf_temp-diasize-handle
     1653         on error undo move_block, retry move_block
     1654         :
     1655           assign
     1656             v-object-handle = buf_temp-diasize-handle.handle-value
     1657           .
     1658           if v-object-handle <> v-diasize-resize-button
     1659           then do:
     1660             assign
     1661               v-object-handle :row = v-object-handle :row + p-change-value
     1662               no-error .
     1663             if error-status :error
     1664             or error-status :get-message(1) <> ""
     1665             then do:
     1666               undo move_block, retry move_block .
     1667             end.
     1668           end.
     1669         end.
     1670       end.
     1671       else do:
     1672         for each buf_temp-diasize-handle
     1673         on error undo move_block, retry move_block
     1674         :
     1675           assign
     1676             v-object-handle = buf_temp-diasize-handle.handle-value
     1677           .
     1678           if v-object-handle <> v-diasize-resize-button
     1679           then do:
     1680             assign
     1681               v-object-handle :row = v-object-handle :row + p-change-value
     1682               no-error .
     1683             if error-status :error
     1684             or error-status :get-message(1) <> ""
     1685             then do:
     1686               undo move_block, retry move_block .
     1687             end.
     1688           end.
     1689         end.
     1690         assign
     1691           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1692           no-error .
     1693         if error-status :error
     1694         or error-status :get-message(1) <> ""
     1695         then do:
     1696           undo move_block, retry move_block .
     1697         end.
     1698         for each buf_temp-browse-handle
     1699           where buf_temp-browse-handle.browse-type = 'height':u
     1700         on error undo move_block, retry move_block
     1701         :
     1702           assign
     1703             buf_temp-browse-handle.browse-handle :height
     1704               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1705             no-error .
     1706           if error-status :error
     1707           or error-status :get-message(1) <> ""
     1708           then do:
     1709             undo move_block, retry move_block .
     1710           end.
     1711         end.
     1712         assign
     1713           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1714           no-error .
     1715         if error-status :error
     1716         or error-status :get-message(1) <> ""
     1717         then do:
     1718           undo move_block, retry move_block .
     1719         end.
     1720         if frame Dialog-Frame :scrollable = true
     1721         then do:
     1722           assign
     1723             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1724             no-error .
     1725           if error-status :error
     1726           or error-status :get-message(1) <> ""
     1727           then do:
     1728             undo move_block, retry move_block .
     1729           end.
     1730         end.
     1731       end.
     1732       if p-move-resize = true
     1733       then do:
     1734         run diasize_position-resize-button in this-procedure .
     1735       end.
     1736       if v-diasize-wndstore = true
     1737       then do:
     1738         if connected("ub") = true
     1739         then do:
     1740           define variable v-cntxt-db-num        as integer   no-undo .
     1741           define variable v-cntxt-userid        as character no-undo .
     1742           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1743                                             , OUTPUT v-cntxt-userid
     1744                                             ) .
     1745           run gbl/wndsizew.p
     1746             (input  v-cntxt-db-num
     1747             ,input  v-cntxt-userid
     1748             ,input  v-diasize-proc-name
     1749             ,input  'height':u
     1750             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1751             ) .
     1752         end.
     1753       end.
     1754     end.
     1755     assign
     1756       v-diasize-change-size = false
     1757     .
     1758   end procedure.
     1759   procedure diasize_set-height :
     1760     define input  parameter p-new-height  as decimal   no-undo .
     1761     define input  parameter p-move-resize as logical   no-undo .
     1762     do
     1763     on error undo, return error return-value
     1764     :
     1765       run diasize_change-height in this-procedure
     1766         (input  (p-new-height - frame Dialog-Frame :height)
     1767         ,input  p-move-resize
     1768         ) .
     1769     end.
     1770   end procedure.
     1771   procedure diasize_change-width :
     1772     define input  parameter p-change-value as decimal   no-undo .
     1773     define input  parameter p-move-resize  as logical   no-undo .
     1774     define variable v-field-group-handle   as handle    no-undo .
     1775     define variable v-object-handle        as handle    no-undo .
     1776     define variable v-frame-width          as decimal   no-undo .
     1777     define variable v-frame-virtual-width  as decimal   no-undo .
     1778     define variable v-browse-width         as decimal   no-undo .
     1779     define variable v-window-width         as decimal   no-undo .
     1780     define variable v-window-virtual-width as decimal   no-undo .
     1781     define variable v-change-sign          as integer   no-undo .
     1782     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1783     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1784     if p-change-value > 0
     1785     then do:
     1786       if frame Dialog-Frame :width + p-change-value >
     1787           session :width-chars
     1788       then do:
     1789         assign
     1790           p-change-value = session :width-chars - frame Dialog-Frame :width
     1791         .
     1792         if p-change-value <= 0
     1793         then do:
     1794           run diasize_position-resize-button in this-procedure .
     1795           return .
     1796         end.
     1797       end.
     1798     end.
     1799     if p-change-value < 0
     1800     then do:
     1801       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1802       then do:
     1803         assign
     1804           p-change-value = v-diasize-orig-frame-width
     1805                          - frame Dialog-Frame :width
     1806         .
     1807         if p-change-value >= 0
     1808         then do:
     1809           run diasize_position-resize-button in this-procedure .
     1810           return .
     1811         end.
     1812       end.
     1813     end.
     1814     if p-change-value >= 0
     1815     then do:
     1816       assign
     1817         v-change-sign = 1
     1818       .
     1819     end.
     1820     else do:
     1821       assign
     1822         v-change-sign = -1
     1823       .
     1824     end.
     1825     assign
     1826       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1827     .
     1828     if p-change-value = 0
     1829     then do:
     1830       run diasize_position-resize-button in this-procedure .
     1831       return .
     1832     end.
     1833     move_block:
     1834     do
     1835     on error undo move_block, leave move_block
     1836     :
     1837       if retry
     1838       then do:
     1839         do
     1840         on error undo move_block, leave move_block
     1841         :
     1842           if p-change-value > 0
     1843           then do:
     1844             for each buf_temp-diasize-handle
     1845             on error undo, next
     1846             :
     1847               assign
     1848                 v-object-handle = buf_temp-diasize-handle.handle-value
     1849               .
     1850               if v-object-handle <> v-diasize-resize-button
     1851               then do:
     1852                 assign
     1853                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1854                 .
     1855               end.
     1856             end.
     1857             assign
     1858               v-diasize-browse-handle :width = v-browse-width
     1859             .
     1860             for each buf_temp-browse-handle
     1861               where buf_temp-browse-handle.browse-type = 'width':u
     1862             on error undo, next
     1863             :
     1864               assign
     1865                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1866               .
     1867             end.
     1868             assign
     1869               frame Dialog-Frame :width = v-frame-width
     1870             .
     1871             if frame Dialog-Frame :scrollable = true
     1872             then do:
     1873               assign
     1874                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1875               .
     1876             end.
     1877             run diasize_position-resize-button in this-procedure .
     1878           end.
     1879           else do:
     1880             if frame Dialog-Frame :scrollable = true
     1881             then do:
     1882               assign
     1883                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1884               .
     1885             end.
     1886             assign
     1887               frame Dialog-Frame :width = v-frame-width
     1888             .
     1889             for each buf_temp-browse-handle
     1890               where buf_temp-browse-handle.browse-type = 'width':u
     1891             on error undo, next
     1892             :
     1893               assign
     1894                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1895               .
     1896             end.
     1897             assign
     1898               v-diasize-browse-handle :width = v-browse-width
     1899             .
     1900             for each buf_temp-diasize-handle
     1901             on error undo, next
     1902             :
     1903               assign
     1904                 v-object-handle = buf_temp-diasize-handle.handle-value
     1905               .
     1906               if v-object-handle <> v-diasize-resize-button
     1907               then do:
     1908                 assign
     1909                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1910                 .
     1911               end.
     1912             end.
     1913             run diasize_position-resize-button in this-procedure .
     1914           end.
     1915           assign
     1916             v-diasize-change-size = false
     1917           .
     1918           leave move_block .
     1919         end.
     1920       end.
     1921       assign
     1922         v-diasize-need-full-display = true
     1923       .
     1924       if v-diasize-change-size = false
     1925       then do:
     1926         assign
     1927           v-diasize-change-size = true
     1928         .
     1929       end.
     1930       else do:
     1931         return .
     1932       end.
     1933       assign
     1934         v-frame-width = frame Dialog-Frame :width
     1935         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1936         v-browse-width = v-diasize-browse-handle :width
     1937       .
     1938       for each buf_temp-browse-handle
     1939         where buf_temp-browse-handle.browse-type = 'width':u
     1940       :
     1941         assign
     1942           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1943         .
     1944       end.
     1945       for each buf_temp-diasize-handle
     1946       :
     1947         delete buf_temp-diasize-handle .
     1948       end.
     1949       assign
     1950         v-field-group-handle = frame Dialog-Frame :first-child
     1951       .
     1952       do while valid-handle(v-field-group-handle)
     1953       :
     1954         assign
     1955           v-object-handle = v-field-group-handle :first-child
     1956         .
     1957         do while valid-handle(v-object-handle)
     1958         :
     1959           if  v-object-handle <> v-diasize-browse-handle :handle
     1960           and v-object-handle <> v-diasize-resize-button
     1961           and can-query(v-object-handle, "row")
     1962           and can-query(v-object-handle, "height")
     1963           and ( v-object-handle :col + v-object-handle :width
     1964                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1965               )
     1966           then do:
     1967             find first buf_temp-browse-handle
     1968               where buf_temp-browse-handle.browse-type   = 'width':u
     1969                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1970               no-error .
     1971             if available buf_temp-browse-handle
     1972             then do:
     1973             end.
     1974             else do:
     1975               create buf_temp-diasize-handle .
     1976               assign
     1977                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1978                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1979               .
     1980             end.
     1981           end.
     1982           assign
     1983             v-object-handle = v-object-handle :next-sibling
     1984           .
     1985         end.
     1986         assign
     1987           v-field-group-handle = v-field-group-handle :next-sibling
     1988         .
     1989       end.
     1990       do with frame Dialog-Frame
     1991       :
     1992         hide v-diasize-resize-button .
     1993         v-diasize-resize-button :row = 1.
     1994         v-diasize-resize-button :column = 1.
     1995       end.
     1996       if p-change-value > 0
     1997       then do:
     1998         if frame Dialog-Frame :scrollable = true
     1999         then do:
     2000           assign
     2001             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2002             no-error .
     2003           if error-status :error
     2004           or error-status :get-message(1) <> ""
     2005           then do:
     2006             undo move_block, retry move_block.
     2007           end.
     2008         end.
     2009         assign
     2010           frame Dialog-Frame :width = v-frame-width + p-change-value
     2011           no-error .
     2012         if error-status :error
     2013         or error-status :get-message(1) <> ""
     2014         then do:
     2015           undo move_block, retry move_block.
     2016         end.
     2017         assign
     2018           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2019         no-error .
     2020         if error-status :error
     2021         or error-status :get-message(1) <> ""
     2022         then do:
     2023           undo move_block, retry move_block.
     2024         end.
     2025         for each buf_temp-browse-handle
     2026           where buf_temp-browse-handle.browse-type = 'width':u
     2027         on error undo move_block, retry move_block
     2028         :
     2029           assign
     2030             buf_temp-browse-handle.browse-handle :width
     2031               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2032             no-error .
     2033           if error-status :error
     2034           or error-status :get-message(1) <> ""
     2035           then do:
     2036             undo move_block, retry move_block .
     2037           end.
     2038         end.
     2039         for each buf_temp-diasize-handle
     2040         on error undo move_block, retry move_block
     2041         :
     2042           assign
     2043             v-object-handle = buf_temp-diasize-handle.handle-value
     2044           .
     2045           if v-object-handle <> v-diasize-resize-button
     2046           then do:
     2047             assign
     2048               v-object-handle :col = v-object-handle :col + p-change-value
     2049               no-error .
     2050             if error-status :error
     2051             or error-status :get-message(1) <> ""
     2052             then do:
     2053               undo move_block, retry move_block .
     2054             end.
     2055           end.
     2056         end.
     2057       end.
     2058       else do:
     2059         for each buf_temp-diasize-handle
     2060         on error undo move_block, retry move_block
     2061         :
     2062           assign
     2063             v-object-handle = buf_temp-diasize-handle.handle-value
     2064           .
     2065           if v-object-handle <> v-diasize-resize-button
     2066           then do:
     2067             assign
     2068               v-object-handle :col = v-object-handle :col + p-change-value
     2069               no-error .
     2070             if error-status :error
     2071             or error-status :get-message(1) <> ""
     2072             then do:
     2073               undo move_block, retry move_block .
     2074             end.
     2075           end.
     2076         end.
     2077         for each buf_temp-browse-handle
     2078           where buf_temp-browse-handle.browse-type = 'width':u
     2079         on error undo move_block, retry move_block
     2080         :
     2081           assign
     2082             buf_temp-browse-handle.browse-handle :width
     2083               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2084             no-error .
     2085           if error-status :error
     2086           or error-status :get-message(1) <> ""
     2087           then do:
     2088             undo move_block, retry move_block .
     2089           end.
     2090         end.
     2091         assign
     2092           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2093           no-error .
     2094         if error-status :error
     2095         or error-status :get-message(1) <> ""
     2096         then do:
     2097           undo move_block, retry move_block.
     2098         end.
     2099         assign
     2100           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2101         no-error .
     2102         if error-status :error
     2103         or error-status :get-message(1) <> ""
     2104         then do:
     2105           undo move_block, retry move_block.
     2106         end.
     2107         if frame Dialog-Frame :scrollable = true
     2108         then do:
     2109           assign
     2110             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2111           no-error .
     2112           if error-status :error
     2113           or error-status :get-message(1) <> ""
     2114           then do:
     2115             undo move_block, retry move_block.
     2116           end.
     2117         end.
     2118       end.
     2119       if p-move-resize
     2120       then do:
     2121         run diasize_position-resize-button in this-procedure .
     2122       end.
     2123       if v-diasize-wndstore = true
     2124       then do:
     2125         if connected("ub") = true
     2126         then do:
     2127           define variable v-cntxt-db-num        as integer   no-undo .
     2128           define variable v-cntxt-userid        as character no-undo .
     2129           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2130                                             , OUTPUT v-cntxt-userid
     2131                                             ) .
     2132           run gbl/wndsizew.p
     2133             (input  v-cntxt-db-num
     2134             ,input  v-cntxt-userid
     2135             ,input  v-diasize-proc-name
     2136             ,input  'width':u
     2137             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2138             ) .
     2139         end.
     2140       end.
     2141     end.
     2142     assign
     2143       v-diasize-change-size = false
     2144     .
     2145   end procedure.
     2146   procedure diasize_set-width :
     2147     define input  parameter p-new-width  as decimal   no-undo .
     2148     define input  parameter p-move-resize as logical   no-undo .
     2149     do
     2150     on error undo, return error return-value
     2151     :
     2152       run diasize_change-width in this-procedure
     2153         (input  (p-new-width - frame Dialog-Frame :width)
     2154         ,input  p-move-resize
     2155         ) .
     2156     end.
     2157   end procedure.
     2158   procedure diasize_position-resize-button :
     2159     do with frame Dialog-Frame
     2160     :
     2161       hide v-diasize-resize-button .
     2162       assign
     2163         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2164                     - 1
     2165                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2166         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2167                     - 1
     2168                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2169       .
     2170       view v-diasize-resize-button .
     2171     end.
     2172   end procedure.
     2173   on alt-right anywhere
     2174   do:
     2175     run diasize_change-width in this-procedure
     2176       (input 1
     2177       ,input true
     2178       ) .
     2179     return no-apply .
     2180   end.
     2181   on alt-left anywhere
     2182   do:
     2183     run diasize_change-width in this-procedure
     2184       (input -1
     2185       ,input true
     2186       ) .
     2187     return no-apply .
     2188   end.
     2189   on alt-down anywhere
     2190   do:
     2191     run diasize_change-height in this-procedure
     2192       (input 1
     2193       ,input true
     2194       ) .
     2195     return no-apply .
     2196   end.
     2197   on alt-up anywhere
     2198   do:
     2199     run diasize_change-height in this-procedure
     2200       (input -1
     2201       ,input true
     2202       ) .
     2203     return no-apply .
     2204   end.
     2205   on alt-enter of frame Dialog-Frame
     2206   do:
     2207     run diasize_maximize in this-procedure
     2208       (input  ?
     2209       ).
     2210     return no-apply .
     2211   end.
     2212   procedure diasize_end-move :
     2213     do
     2214     on error undo, return error return-value
     2215     :
     2216       define variable v-row-delta as decimal   no-undo .
     2217       define variable v-col-delta as decimal   no-undo .
     2218       define variable v-new-row as decimal   no-undo .
     2219       define variable v-new-col as decimal   no-undo .
     2220       assign
     2221         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2222         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2223       .
     2224       assign
     2225         v-row-delta = v-new-row - frame Dialog-Frame :height
     2226         v-col-delta = v-new-col - frame Dialog-Frame :width
     2227       .
     2228       run diasize_change-height in this-procedure
     2229         (input v-row-delta
     2230         ,input true
     2231         ) .
     2232       run diasize_change-width in this-procedure
     2233         (input v-col-delta
     2234         ,input true
     2235         ) .
     2236     end.
     2237   end procedure.
     2238   procedure diasize_maximize :
     2239     define input  parameter p-action as logical   no-undo .
     2240     do
     2241     on error undo, return error return-value
     2242     :
     2243       if p-action = ?
     2244       then do:
     2245         if v-diasize-need-maximize = true
     2246         then do:
     2247           assign
     2248             p-action = true
     2249           .
     2250         end.
     2251         else do:
     2252           assign
     2253             p-action = false
     2254           .
     2255         end.
     2256       end.
     2257       if p-action = true
     2258       then do:
     2259         run diasize_change-height in this-procedure
     2260           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2261               - frame Dialog-Frame :height-chars
     2262           ,input true
     2263           ) .
     2264         run diasize_change-width in this-procedure
     2265           (input session :width-chars
     2266               - frame Dialog-Frame :width-chars
     2267           ,input true
     2268           ) .
     2269         assign
     2270           v-diasize-need-maximize = false
     2271         .
     2272       end.
     2273       else do:
     2274         run diasize_change-width in this-procedure
     2275           (input v-diasize-orig-frame-width
     2276               - frame Dialog-Frame :width-chars
     2277           ,input true
     2278           ) .
     2279         run diasize_change-height in this-procedure
     2280           (input v-diasize-orig-frame-height
     2281               - frame Dialog-Frame :height-chars
     2282           ,input true
     2283           ) .
     2284         assign
     2285           v-diasize-need-maximize = true
     2286         .
     2287       end.
     2288     end.
     2289   end procedure.
     2290   procedure diasize_restore-orig-size :
     2291     do
     2292     on error undo, return error return-value
     2293     :
     2294       assign
     2295         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2296         v-diasize-current-frame-height = frame Dialog-Frame :height
     2297       .
     2298       run diasize_set-height in this-procedure
     2299         (input  v-diasize-orig-frame-height
     2300         ,input  true
     2301         ) .
     2302       run diasize_set-width in this-procedure
     2303         (input  v-diasize-orig-frame-width
     2304         ,input  true
     2305         ) .
     2306     end.
     2307   end procedure.
     2308   procedure diasize_restore-current-size :
     2309     do
     2310     on error undo, return error return-value
     2311     :
     2312       run diasize_set-height in this-procedure
     2313         (input  v-diasize-current-frame-height
     2314         ,input  true
     2315         ) .
     2316       run diasize_set-width in this-procedure
     2317         (input  v-diasize-current-frame-width
     2318         ,input  true
     2319         ) .
     2320     end.
     2321   end procedure.
     2322   procedure diasize_set-browse-handle :
     2323     define input  parameter p-browse-handle as handle   no-undo .
     2324     define buffer buf_temp-browse-handle for temp-browse-handle .
     2325     do
     2326     on error undo, return error return-value
     2327     :
     2328       assign
     2329         v-diasize-browse-handle = p-browse-handle
     2330       .
     2331       for each buf_temp-browse-handle
     2332       on error undo, return error return-value
     2333       :
     2334         delete buf_temp-browse-handle .
     2335       end.
     2336     end.
     2337   end procedure.
     2338   procedure diasize_add_browse :
     2339     define input  parameter p-browse-type   as character no-undo .
     2340     define input  parameter p-browse-handle as handle    no-undo .
     2341     define buffer buf_temp-browse-handle for temp-browse-handle .
     2342     do
     2343     on error undo, return error return-value
     2344     :
     2345       assign
     2346         v-diasize-browse-number = v-diasize-browse-number + 1
     2347       .
     2348       create buf_temp-browse-handle .
     2349       assign
     2350         buf_temp-browse-handle.browse-type   = p-browse-type
     2351         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2352         buf_temp-browse-handle.browse-handle = p-browse-handle
     2353       .
     2354     end.
     2355   end procedure.
     2356   procedure diasize_init :
     2357     define variable v-default-value    as logical   no-undo .
     2358     define variable v-restore-saved    as logical   no-undo .
     2359     define variable v-resize-value-str as character no-undo .
     2360     do
     2361     on error undo, return error return-value
     2362     :
     2363       do with frame Dialog-Frame
     2364       :
     2365         assign
     2366           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2367           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2368           v-diasize-browse-handle     = browse br-wp :handle
     2369         .
     2370         create button v-diasize-resize-button
     2371         assign
     2372           parent        = frame Dialog-Frame :first-child
     2373           label         = "s"
     2374           height-pixels = 16
     2375           width-pixels  = 16
     2376           visible       = true
     2377           sensitive     = true
     2378           movable       = true
     2379           triggers:
     2380             on end-move persistent run diasize_end-move in this-procedure .
     2381           end triggers.
     2382         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2383         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2384         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2385         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2386         assign
     2387           v-diasize-wndmax = false
     2388         .
     2389         if connected("ub") = true
     2390         then do:
     2391           define variable v-cntxt-db-num        as integer   no-undo .
     2392           define variable v-cntxt-userid        as character no-undo .
     2393           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2394                                             , OUTPUT v-cntxt-userid
     2395                                             ) .
     2396           run gbl/wndpar_r.p
     2397             (input  v-cntxt-db-num
     2398             ,input  v-cntxt-userid
     2399             ,input  'wndmax':U
     2400             ,output v-diasize-wndmax
     2401             ,output v-default-value
     2402             ) .
     2403         end.
     2404         assign
     2405           v-diasize-wndstore = false
     2406         .
     2407         if connected("ub") = true
     2408         then do:
     2409           run gbl/wndpar_r.p
     2410             (input  v-cntxt-db-num
     2411             ,input  v-cntxt-userid
     2412             ,input  'wndstore':U
     2413             ,output v-diasize-wndstore
     2414             ,output v-default-value
     2415             ) .
     2416         end.
     2417         assign
     2418           v-diasize-proc-name = entry(1, program-name(2), '.')
     2419         .
     2420         if v-diasize-wndstore = true
     2421         then do:
     2422           assign
     2423             v-restore-saved = false
     2424           .
     2425           if connected("ub") = true
     2426           then do:
     2427             run gbl/wndsizer.p
     2428               (input  v-cntxt-db-num
     2429               ,input  v-cntxt-userid
     2430               ,input  v-diasize-proc-name
     2431               ,input  'height':u
     2432               ,output v-resize-value-str
     2433               ) .
     2434             if v-resize-value-str <> '':U
     2435             then do:
     2436               run diasize_change-height in this-procedure
     2437                 (input  integer(v-resize-value-str)
     2438                 ,input  true
     2439                 ) .
     2440               assign
     2441                 v-restore-saved = true
     2442               .
     2443             end.
     2444           end.
     2445           if connected("ub") = true
     2446           then do:
     2447             run gbl/wndsizer.p
     2448               (input  v-cntxt-db-num
     2449               ,input  v-cntxt-userid
     2450               ,input  v-diasize-proc-name
     2451               ,input  'width':u
     2452               ,output v-resize-value-str
     2453               ) .
     2454             if v-resize-value-str <> '':U
     2455             then do:
     2456               run diasize_change-width in this-procedure
     2457                 (input  integer(v-resize-value-str)
     2458                 ,input  true
     2459                 ) .
     2460               assign
     2461                 v-restore-saved = true
     2462               .
     2463             end.
     2464           end.
     2465           if v-restore-saved <> true
     2466           then do:
     2467             if v-diasize-wndmax = true
     2468             then do:
     2469               run diasize_maximize in this-procedure
     2470                 (input  true
     2471                 ) .
     2472             end.
     2473           end.
     2474         end.
     2475         else do:
     2476           if v-diasize-wndmax = true
     2477           then do:
     2478             run diasize_maximize in this-procedure
     2479               (input  true
     2480               ) .
     2481           end.
     2482         end.
     2483       end.
     2484     end.
     2485   end procedure.
     2486   procedure diasize_need-full-display :
     2487     define output parameter p-need-full-display as logical   no-undo .
     2488     do
     2489     on error undo, return error return-value
     2490     :
     2491       assign
     2492         p-need-full-display = v-diasize-need-full-display
     2493       .
     2494       assign
     2495         v-diasize-need-full-display = false
     2496       .
     2497     end.
     2498   end procedure.
     2499   procedure get-context :
     2500      define output parameter p-db-num as integer          no-undo.
     2501      define output parameter p-user-id as character        no-undo.
     2502      define variable v-login               as character    no-undo.
     2503      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2504      define buffer buf_user-login  for ub.user-login .
     2505      do
     2506      on error undo, return error
     2507      :
     2508            FIND FIRST buf_sys-ctrl no-lock.
     2509            ASSIGN
     2510               v-login = USERID("ub")
     2511               p-db-num = buf_sys-ctrl.db-num
     2512            .
     2513            FIND FIRST buf_user-login
     2514                 WHERE buf_user-login.db-num = p-db-num
     2515                   AND buf_user-login.user-login = v-login
     2516                 no-lock
     2517                 no-error
     2518                 .
     2519            IF AVAILABLE buf_user-login
     2520            THEN DO:
     2521               assign
     2522                  p-user-id = buf_user-login.user-id
     2523               .
     2524            END.
     2525      end.
     2526   end procedure.
     2527   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2528   on f5 of frame Dialog-Frame anywhere
     2529   do:
     2530       v-doc-rec = recid(X_c-PromoAction).
     2531       run openbr in this-procedure.
     2532       reposition br-wp to recid v-doc-rec no-error.
     2533       apply 'value-changed' to br-wp.
     2534       apply "VALUE-CHANGED" to BR-changes.
     2535   end.
     2536   def var sort-labelbr-wp   as character no-undo .
     2537   def var sort-clmnbr-wp    as handle    no-undo .
     2538   def var cur-clmnbr-wp     as handle    no-undo .
     2539   def var cur-clmn-locbr-wp as integer   no-undo .
     2540   def var re-querybr-wp     as logical   initial no no-undo .
     2541   on start-search, ctrl-o of br-wp in frame Dialog-Frame do:
     2542      run sort-brbr-wp
     2543        (input (if available temp-changes
     2544                then recid(temp-changes)
     2545                else ?
     2546               )
     2547        ).
     2548   end.
     2549   PROCEDURE sort-brbr-wp :
     2550     define input parameter p-recid as recid no-undo .
     2551     if re-querybr-wp = no then do:
     2552       assign
     2553          cur-clmnbr-wp = br-wp:current-column in frame Dialog-Frame
     2554       .
     2555       if sort-clmnbr-wp <> ? then sort-clmnbr-wp:column-fgcolor = 0.
     2556       if cur-clmnbr-wp = sort-clmnbr-wp then do:
     2557         assign
     2558            sort-labelbr-wp = ""
     2559            sort-clmnbr-wp = ?
     2560         .
     2561        end.
     2562        else do:
     2563          assign
     2564            sort-labelbr-wp = cur-clmnbr-wp:label
     2565            sort-clmnbr-wp  = cur-clmnbr-wp
     2566            sort-clmnbr-wp:column-fgcolor = 4
     2567          .
     2568        end.
     2569      end.
     2570     assign
     2571       cur-clmn-locbr-wp = 1
     2572     .
     2573     def var column-handle as handle no-undo .
     2574     column-handle = br-wp:first-column.
     2575     do while valid-handle(column-handle) :
     2576       if column-handle = cur-clmnbr-wp then do:
     2577         leave .
     2578       end.
     2579       column-handle = column-handle:NEXT-COLUMN.
     2580       assign
     2581         cur-clmn-locbr-wp = cur-clmn-locbr-wp + 1
     2582       .
     2583     end.
     2584     case sort-labelbr-wp:
     2585           when X_c-PromoAction.nameAction:label in browse br-wp then DO:   assign     sort-column-name = "X_c-PromoAction.nameAction"   .   run OpenBr.   . END.
     2586           when X_c-PromoAction.corr-date:label in browse br-wp then DO:   assign     sort-column-name = "X_c-PromoAction.corr-date"   .   run OpenBr.   . END.
     2587       otherwise do:
     2588         assign
     2589           sort-column-name = ""
     2590         .
     2591         run OpenBr.
     2592           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-wp') then do:
     2593             run mv-brw-defaultbr-wp.
     2594           end.
     2595         if sort-labelbr-wp <> "" then do:
     2596           assign
     2597             cur-clmnbr-wp:column-fgcolor = 0
     2598           .
     2599         end.
     2600         assign
     2601           cur-clmn-locbr-wp = ?
     2602         .
     2603       end.
     2604     end case.
     2605       if cur-clmn-locbr-wp <> ? then do:
     2606         if can-do( this-procedure:internal-entries, 'ch-clmnbr-wp') then do:
     2607           run ch-clmnbr-wp in this-procedure (cur-clmn-locbr-wp).
     2608         end.
     2609       end.
     2610     if p-recid <> ? then do:
     2611       reposition br-wp to recid p-recid no-error.
     2612       apply "value-changed" to br-wp in frame Dialog-Frame.
     2613     end.
     2614     apply "entry" to br-wp in frame Dialog-Frame.
     2615   END PROCEDURE.
     2616   procedure re-open-query-srt-clmnbr-wp:
     2617   if cur-clmnbr-wp = ? then do:
     2618      run OpenBr.
     2619   end.
     2620   else do:
     2621      assign re-querybr-wp = yes.
     2622      run sort-brbr-wp
     2623        (input (if available temp-changes
     2624                then recid(temp-changes)
     2625                else ?
     2626               )
     2627        ).
     2628      assign re-querybr-wp = no.
     2629   end.
     2630   end.
     2631   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2632   do:
     2633     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2634   end.
     2635   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2636   on INS of frame Dialog-Frame anywhere do:
     2637     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2638     return no-apply.
     2639   end.
     2640   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2641   on F2 of frame Dialog-Frame anywhere do:
     2642     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2643     return no-apply.
     2644   end.
     2645   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2646   on F2 of frame Dialog-Frame anywhere do:
     2647     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2648     return no-apply.
     2649   end.
     2650   MAIN-BLOCK:
     2651   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2652      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2653    if LOOKUP(p-mode, 'one':U, chr(4)) = 0 then dO:
     2654       message
     2655       vss-workfile vss-revision vss-description skip
     2656       "Неверное значение параметров вызова p-mode"
     2657       p-mode
     2658       view-as alert-box ERROR.
     2659       return error .
     2660    end.
     2661     if p-mode = "one":U then do:
     2662      find first X_c-PromoAction no-lock
     2663           where X_c-PromoAction.id = p-ActionId no-error.
     2664       if not available X_c-PromoAction then do:
     2665           message
     2666           vss-workfile vss-revision vss-description skip
     2667           substitute("Отсутствует история промо-акции с ид. &1", p-ActionId)
     2668           view-as alert-box ERROR.
     2669           // 14/VIII-2018 - продолжаем выполнение, чтобы посмотреть как отображается список return.
     2670       end.
     2671     end.
     2672     RUN MyEnable.
     2673     RUn OpenBR.
     2674     HIDE mark-num in frame Dialog-Frame .
     2675     if v-doc-rec <> ? then
     2676     REPOSITION br-wp to recid v-doc-rec No-ERROR.
     2677    run diasize_add_browse in this-procedure
     2678       (input  'width':u
     2679       ,input  browse br-changes :handle
     2680       ) .
     2681    run diasize_init in this-procedure .
     2682   WAIT-FOR GO OF FRAME Dialog-Frame.
     2683   END.
     2684   RUN disable_UI.
     2685   PROCEDURE disable_UI :
     2686     HIDE FRAME Dialog-Frame.
     2687   END PROCEDURE.
     2688   PROCEDURE enable_UI :
     2689     DISPLAY mark-num
     2690         WITH FRAME Dialog-Frame.
     2691     ENABLE b-quit B-mark B-sel B-Help br-wp BR-changes mark-num
     2692         WITH FRAME Dialog-Frame.
     2693     VIEW FRAME Dialog-Frame.
     2694     OPEN QUERY br-wp FOR EACH X_c-PromoAction NO-LOCK INDEXED-REPOSITION.
     2695   END PROCEDURE.
     2696   PROCEDURE MyEnable :
     2697   assign
     2698   temp-changes.l_name:resizable in browse br-changes = true
     2699   temp-changes.v_old:resizable in browse br-changes = true
     2700   temp-changes.v_new:resizable in browse br-changes = true
     2701   temp-changes.l_name:width in browse br-changes = 30
     2702   temp-changes.v_old:width in browse br-changes = 40
     2703   temp-changes.v_new:width in browse br-changes = 40
     2704   .
     2705   DISPLAY mark-num
     2706   WITH FRAME Dialog-Frame.
     2707   ENABLE
     2708   b-quit
     2709   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2710   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2711   B-Help
     2712   br-wp mark-num
     2713   br-changes
     2714   with FRAME Dialog-Frame.
     2715   VIEW FRAME Dialog-Frame.
     2716   END PROCEDURE.
     2717   PROCEDURE OpenBr :
     2718   define variable v-host-code as integer no-undo .
     2719   OPEN QUERY br-wp FOR EACH X_c-PromoAction NO-LOCK
     2720                       where X_c-PromoAction.id = p-ActionId
     2721                                 INDEXED-REPOSITION.
     2722   APPLY "VALUE-CHANGED" TO br-wp in frame Dialog-Frame.
     2723   APPLY "ENTRY" TO br-wp.
     2724   END PROCEDURE.
     2725   PROCEDURE proc-view-changes :
     2726   define variable v-label-param as character no-undo .
     2727   v-label-param =   "id" + chr(4) + "Ид.промо-акции" + chr(4) + ""
     2728    + chr(8) + "beg-date"  + chr(4) + "Дата начала" + chr(4) + ""
     2729    + chr(8) + "end-date"  + chr(4) + "Дата окончания" + chr(4) + ""
     2730    + chr(8) + "nameAction"  + chr(4) + "Наименование" + chr(4) + ""
     2731    + chr(8) + "TypeDiscont"  + chr(4) + "Тип скидки" + chr(4) + ""
     2732    + chr(8) + "methodCalc"  + chr(4) + "Метод расчёта" + chr(4) + ""
     2733    + chr(8) + "typecond"  + chr(4) + "Вид условия" + chr(4) + ""
     2734    + chr(8) + "promosched-id"  + chr(4) + "Ид.расписания" + chr(4) + ""
     2735    + chr(8) + "Status_"  + chr(4) + "Статус" + chr(4) + ""
     2736    + chr(8) + "priority"  + chr(4) + "Приоритет" + chr(4) + ""
     2737    + chr(8) + "comment"  + chr(4) + "Комментарий" + chr(4) + ""
     2738    + chr(8) + "description"  + chr(4) + "Описание" + chr(4) + ""
     2739    + chr(8) + "paymenttype"  + chr(4) + "Коды типов платежей" + chr(4) + ""
     2740    + chr(8) + "changeDate"  + chr(4) + "Дата досрочного завершения" + chr(4) + ""
     2741    + chr(8) + "ext-code"  + chr(4) + "Код промо-акции во внешней системе" + chr(4) + ""
     2742    + chr(8) + "db-num"  + chr(4) + "Номер БД" + chr(4) + ""
     2743   .
     2744    run proc-full-temp-changes in this-procedure (
     2745                                                input  buffer X_c-PromoAction:handle
     2746                                               ,input  'PromoAction':U
     2747                                               ,input  "id,beg-date,end-date,nameAction,TypeDiscont,methodCalc,typecond,promosched-id,Status_,priority,comment,description,paymenttype,changeDate,ext-code,db-num"
     2748                                               ,input  v-label-param).
     2749   Open QUery br-changes for each temp-changes.
     2750   END PROCEDURE.
