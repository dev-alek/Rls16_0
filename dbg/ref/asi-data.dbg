      928   procedure create_obj-list :
      929      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      930      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      931      do
      932      on error undo, return error return-value
      933      :
      934         define buffer cli-obj for ub.clients .
      935         define variable p-var as integer no-undo .
      936         define buffer buf_obj-list for obj-list .
      937         find last buf_obj-list  use-index pi no-error .
      938         if available buf_obj-list
      939         then
      940            p-var = buf_obj-list.obj-id + 1.
      941         else
      942            p-var = 1.
      943         find first cli-obj where
      944                   cli-obj.obj-type = p-obj-type
      945               and cli-obj.obj-code = p-obj-code
      946         no-lock no-error.
      947         if available cli-obj
      948         then do:
      949            create buf_obj-list.
      950            assign
      951               buf_obj-list.obj-id   = p-var
      952               buf_obj-list.obj-code = cli-obj.obj-code
      953               buf_obj-list.obj-type = cli-obj.obj-type
      954               buf_obj-list.obj-name = cli-obj.obj-name
      955               buf_obj-list.db-num   = cli-obj.db-num
      956            .
      957         end.
      958      end.
      959   end.
