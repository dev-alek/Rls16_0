     1368   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1369   define  stream PrnLibStream.
     1370   procedure prn-lib-prn-file :
     1371     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1372     define input parameter p-DIsabledoptions as integer no-undo .
     1373     define variable v-report-name as character no-undo .
     1374     define variable v-user-action as character no-undo .
     1375     define variable v-printed     as logical   no-undo .
     1376     define variable v-exist       as logical   no-undo .
     1377     do
     1378       on error undo, return error
     1379       :
     1380       run prn-lib-get-report-name  in this-procedure (
     1381         input parParentProc
     1382         ,output v-report-name
     1383         ).
     1384   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1385   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1386     (input  v-report-name
     1387     ,input  2
     1388     ,output v-exist
     1389     )  .
     1390       if NOT v-exist then
     1391       DO:
     1392         Message
     1393           "Нет заданий на печать ! "
     1394           view-as alert-box .
     1395         Return  .
     1396       End.
     1397       run gbl/prnfilen.w
     1398         (input  ""
     1399         ,input  p-DisabledOptions
     1400         ,input  string(v-report-name )
     1401         ,input  7
     1402         ,output v-user-action
     1403         ,output v-printed
     1404         ) .
     1405       if v-printed then
     1406       do:
     1407         return "YES" .
     1408       end.
     1409       else
     1410       do:
     1411         return "NO" .
     1412       end.
     1413     end.
     1414   end procedure.
     1415   procedure prn-lib-open-stream :
     1416     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1417     define input parameter p-page-size    as integer no-undo .
     1418     define input parameter p-is-stream    as logical no-undo .
     1419     define input parameter p-append       as logical no-undo .
     1420     define variable v-report-name as character no-undo .
     1421     do
     1422       on error undo, return error
     1423       :
     1424       run prn-lib-get-report-name  in this-procedure (
     1425         input parParentProc
     1426         ,output v-report-name
     1427         ).
     1428       if p-is-stream then
     1429       do:
     1430         if p-append then
     1431         do:
     1432           output stream PrnLibStream to value( v-report-name )
     1433             page-size value(p-page-size) append .
     1434         end.
     1435         if not p-append then
     1436         do:
     1437           output stream PrnLibStream to value( v-report-name )
     1438             page-size value(p-page-size) .
     1439         end.
     1440       end.
     1441       if not p-is-stream then
     1442       do:
     1443         if p-append then
     1444         do:
     1445           output to value( v-report-name )
     1446             page-size value(p-page-size) append .
     1447         end.
     1448         if not p-append then
     1449         do:
     1450           output to value( v-report-name )
     1451             page-size value(p-page-size) .
     1452         end.
     1453       end.
     1454     end.
     1455   end procedure.
     1456   procedure prn-lib-open-exp :
     1457     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1458     define input parameter p-is-stream    as logical no-undo .
     1459     define input parameter p-is-append    as logical no-undo .
     1460     define output parameter p-ReportFileName as char init "report" no-undo.
     1461     define output parameter p-process as logical no-undo .
     1462     define variable glog as logical no-undo .
     1463     do
     1464       on error undo, return error
     1465       :
     1466       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1467         TITLE      "Укажите путь"
     1468         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1469         ASK-OVERWRITE
     1470         CREATE-TEST-FILE
     1471         SAVE-AS
     1472         USE-FILENAME
     1473         DEFAULT-EXTENSION "txt"
     1474         UPDATE glog
     1475         .
     1476       if not glog then  return.
     1477       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1478       if p-is-stream then
     1479       do:
     1480         if p-is-append then
     1481         do:
     1482           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1483         end.
     1484         else
     1485         do:
     1486           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1487         end.
     1488       end.
     1489       else
     1490       do:
     1491         if p-is-append then
     1492         do:
     1493           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1494         end.
     1495         else
     1496         do:
     1497           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1498         end.
     1499       end.
     1500       p-process = yes.
     1501     end.
     1502   end procedure.
     1503   procedure prn-lib-get-report-name :
     1504     define input parameter parParentProc  as widget-handle no-undo.
     1505     define output parameter p-report-name as character no-undo .
     1506     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1507   end procedure.
     1508   procedure prn-lib-reportviewer-report-name :
     1509     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1510     define input parameter p-report-name-html as character no-undo .
     1511     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1512   end procedure.
     1513   procedure prn-lib-reportviewer :
     1514     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1515     define input parameter p-report-name-html as character no-undo .
     1516     define input parameter p-param        as character no-undo .
     1517     define variable v-excel           as character no-undo init 'TRUE' .
     1518     define variable v-value-character as character no-undo .
     1519     define variable v-value-integer   as character no-undo .
     1520     define variable v-value-date      as date      no-undo .
     1521     define variable v-value-decimal   as decimal   no-undo .
     1522     define variable rep-excel         as logical   no-undo .
     1523     define variable excel-string      as character no-undo .
     1524     define variable v-param-type      as character no-undo .
     1525     define variable v-tth             as handle    no-undo .
     1526     run adm/shattri.p (
     1527       input "get":U
     1528       ,input  ""
     1529       ,input  0
     1530       ,input  'report-glob':U
     1531       ,input  'rep-excel':U
     1532       ,output v-value-character
     1533       ,output v-value-date
     1534       ,output v-value-decimal
     1535       ,output v-value-integer
     1536       ,output rep-excel
     1537       ,output v-param-type
     1538       ,INPUT-OUTPUT table-handle v-tth
     1539       )  .
     1540     if rep-excel then v-excel = "TRUE" .
     1541     else v-excel = "FALSE" .
     1542     if p-param eq ""
     1543     then
     1544        p-param = "EXCEL:" + v-excel.
     1545     else
     1546        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1547     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1548   end procedure.
     1549   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1550   define variable v-waitfram-action01         as character   no-undo .
     1551   define variable v-waitfram-action02         as character   no-undo .
     1552   define variable v-waitfram-action03         as character   no-undo .
     1553   define variable mWaitFramTextBeg            as character   no-undo.
     1554   define variable mWaitFramTextEnd            as character   no-undo.
     1555   define variable mWaitFramView               as logical     no-undo.
     1556   define variable mWaitProcEvent              as logical     no-undo init yes.
     1557   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1558   define variable mWaitFramStop               as logical     no-undo.
     1559   define variable mWaitFramStopUser           as logical     no-undo.
     1560   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1561   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1562   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1563   define button B-WaitFramStop auto-end-key
     1564        label "Стоп"
     1565        size 10 by 1 tooltip "Остоновить процесс".
     1566   define button B-viewProcInfo
     1567        label "Информация"
     1568        size 15 by 1 tooltip "Информация о процесс".
     1569   define frame waitfram
     1570     v-waitfram-action01 format "x(72)" no-label skip
     1571     v-waitfram-action02 format "x(72)" no-label skip
     1572     v-waitfram-action03 format "x(72)" no-label skip
     1573     B-viewProcInfo
     1574     B-WaitFramStop at row 4 col 30
     1575     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1576     .
     1577   define new global shared variable mBatchMode as logical no-undo init ?.
     1578   define variable mFramBachModHandle as handle no-undo.
     1579   mFramBachModHandle = frame waitfram:handle.
     1580   define variable mFameOldVis as logical no-undo.
     1581   define variable mVisCUrentVin as logical no-undo.
     1582   if session:batch-mode
     1583   then
     1584      mBatchMode = yes.
     1585   if mBatchMode = ? then do:
     1586     mVisCUrentVin = current-window:visible.
     1587     mFameOldVis = mFramBachModHandle:visible.
     1588     mFramBachModHandle:visible  = yes.
     1589     mBatchMode = mFramBachModHandle:visible ne yes.
     1590     mFramBachModHandle:visible = mFameOldVis.
     1591     current-window:visible = mVisCUrentVin.
     1592   end.
     1593    if  log-manager:logfile-name ne ?
     1594     then DO:
     1595         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1596         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1597         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1598     end.
     1599   on choose of B-WaitFramStop in frame waitfram
     1600   do:
     1601     mWaitFramStop = yes.
     1602     mWaitFramStopUser = yes.
     1603   end.
     1604   function waitfram-check-timeout returns logical():
     1605      define variable vtime as int64 no-undo.
     1606      if mWaitFramStopTimeOut
     1607      then
     1608         return yes.
     1609      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1610      if     mWaitFramTimeOut ne ?
     1611         and mWaitFramTimeOut ne 0
     1612         and mWaitFramTimeOut lt vtime
     1613      then do:
     1614         mWaitFramStopTimeOut = yes.
     1615      end.
     1616      return mWaitFramStopTimeOut.
     1617   end.
     1618   procedure waitfram-hide :
     1619     if not session:batch-mode
     1620     then do
     1621     on error undo, return error return-value
     1622     :
     1623       pause 0 before-hide .
     1624       if not mBatchMode then
     1625         hide frame waitfram .
     1626     if     not mWaitFramView
     1627        and mWaitProcEvent
     1628     then
     1629       process events .
     1630     end.
     1631   end procedure.
     1632   procedure waitfram-show :
     1633     define input  parameter p-message as character no-undo .
     1634     define variable v-left-margin as integer   no-undo .
     1635     if not session:batch-mode
     1636     then do
     1637     on error undo, return error return-value
     1638     :
     1639       if length(p-message) <= 70 then do:
     1640         assign
     1641           v-left-margin = integer((70 - length(p-message)) / 2)
     1642         .
     1643         assign
     1644           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1645         .
     1646         assign
     1647           v-waitfram-action01 = " "
     1648           v-waitfram-action02 = " "
     1649                                    + fill(" ", v-left-margin)
     1650                                    + p-message
     1651           v-waitfram-action03 = " "
     1652         .
     1653       end.
     1654       else do:
     1655         define variable vRindex1 as integer no-undo.
     1656         define variable vRindex2 as integer no-undo.
     1657         vRindex1 = r-index(p-message," ",70).
     1658         if vRindex1 = 0
     1659         then
     1660            vRindex1 = 70.
     1661         if length(p-message)  <= vRindex1 + 70 then do:
     1662           assign
     1663             v-waitfram-action01 = " "
     1664             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1665             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1666           .
     1667         end.
     1668         else do:
     1669           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1670           if vRindex2 <= vRindex1
     1671           then
     1672              vRindex2 = vRindex1 + 70.
     1673           assign
     1674             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1675             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1676             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1677           .
     1678         end.
     1679       end.
     1680       B-viewProcInfo:visible   in frame waitfram = no.
     1681       B-viewProcInfo:sensitive in frame waitfram = no.
     1682       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1683       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1684       if  (   mWaitFramView
     1685          or  mWaitProcEvent)
     1686          and not mBatchMode
     1687       then
     1688          display
     1689             v-waitfram-action01 skip
     1690             v-waitfram-action02 skip
     1691             v-waitfram-action03 skip
     1692          with frame waitfram .
     1693       if     mWaitFramView
     1694          then do:
     1695             if     mWaitFramInterval ne ?
     1696                and not mBatchMode
     1697             then
     1698                wait-for go of frame waitfram pause mWaitFramInterval.
     1699          end.
     1700          else
     1701             if     mWaitProcEvent
     1702                and not mBatchMode
     1703             then
     1704                process events .
     1705     end.
     1706   end procedure.
     1707      procedure waitfram-show-this:
     1708         define input  parameter iInterval as int64 no-undo.
     1709         define variable vtime as int64 no-undo.
     1710         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1711         mWaitFramInterval = iInterval.
     1712         run waitfram-show (substitute("&1&2 &3&4" ,
     1713                                       mWaitFramTextBeg ,
     1714                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1715                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1716                                       mWaitFramTextEnd
     1717                                      )
     1718                           ).
     1719      end.
     1720      procedure WaitFramRunPause:
     1721         define input  parameter iInterval as dec no-undo.
     1722         define variable vStart  as datetime-tz no-undo.
     1723         define variable vend    as datetime-tz no-undo.
     1724         define variable vint as int64 no-undo.
     1725         define variable vOk as logical no-undo.
     1726         vStart = now.
     1727         vend   = vStart.
     1728         publish "WaitFramPause" (iInterval,output vOk).
     1729         vend   =  now.
     1730         vint = vend - vStart.
     1731         vint = iInterval - vint / 1000.
     1732         if     not mWaitFramStop
     1733            and (   vint > 0
     1734                 or (    not vOk
     1735                     and iInterval eq ?
     1736                     )
     1737                 )
     1738         then
     1739            run waitfram-show-this (iInterval).
     1740         vend   =  now.
     1741         vint = vend - vStart.
     1742         vint = iInterval - vint / 1000.
     1743         if     not mWaitFramStop
     1744            and vint > 0
     1745         then do:
     1746            run gbl/pause.p (vint * 1000).
     1747         end.
     1748         if iInterval ne ?
     1749         then
     1750            publish "WaitFramStop".
     1751         waitfram-check-timeout().
     1752      end.
     1753      procedure WaitFramWaitFor:
     1754         define input  parameter iInterval as dec no-undo.
     1755         assign
     1756            mWaitFramStartProc   = now
     1757            mWaitFramStopUser    = no
     1758            mWaitFramStopTimeOut = no
     1759         .
     1760         block-wait:
     1761         do while not mWaitFramStop:
     1762            run WaitFramRunPause (iInterval).
     1763            if  waitfram-check-timeout()
     1764            then do:
     1765               leave block-wait.
     1766            end.
     1767         end.
     1768         run waitfram-hide.
     1769      end.
     1770   procedure waitfram-join :
     1771     define input  parameter p-line-1  as character no-undo .
     1772     define input  parameter p-line-2  as character no-undo .
     1773     define input  parameter p-line-3  as character no-undo .
     1774     define output parameter p-message as character no-undo .
     1775     do
     1776     on error undo, return error return-value
     1777     :
     1778       assign
     1779         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1780                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1781                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1782       .
     1783     end.
     1784   end procedure.
     1785   function waitfram-join-function returns character
     1786     (input p-line-1 as character
     1787     ,input p-line-2 as character
     1788     ,input p-line-3 as character
     1789     ).
     1790     define variable v-message as character no-undo .
     1791     run waitfram-join in this-procedure
     1792       (input  p-line-1
     1793       ,input  p-line-2
     1794       ,input  p-line-3
     1795       ,output v-message
     1796       ) .
     1797     return v-message .
     1798   end function .
     1799   procedure placelib_write-attr:
     1800   define input  parameter p-code     like ub.place-attr.attr-code .
     1801   define input  parameter p-obj-code like ub.place-attr.obj-code .
     1802   define input  parameter p-obj-type like ub.place-attr.obj-type .
     1803   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     1804   define input  parameter p-value    like ub.place-attr.attr-value .
     1805   define output parameter p-ok       as logical.
     1806   define buffer buf_place-attr for ub.place-attr .
     1807     do on error undo, return error return-value :
     1808        p-ok = false.
     1809        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1810                                                   and buf_place-attr.obj-code    = p-obj-code
     1811                                                   and buf_place-attr.obj-type    = p-obj-type
     1812                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1813        if not available buf_place-attr then do :
     1814           create buf_place-attr.
     1815           assign
     1816             buf_place-attr.attr-code   = p-code
     1817             buf_place-attr.attr-value  = p-value
     1818             buf_place-attr.obj-code    = p-obj-code
     1819             buf_place-attr.obj-type    = p-obj-type
     1820             buf_place-attr.pl-code     = p-pl-code
     1821           .
     1822           p-ok = true.
     1823        end.
     1824        else do:
     1825           buf_place-attr.attr-value  = p-value .
     1826           p-ok = true.
     1827        end.
     1828     end.
     1829   end.
     1830   procedure placelib_get-attr:
     1831   define input  parameter  p-code     like ub.place-attr.attr-code .
     1832   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     1833   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     1834   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     1835   define output parameter  p-value    like ub.place-attr.attr-value .
     1836   define output parameter  p-ok       as logical.
     1837   define buffer buf_place-attr for ub.place-attr .
     1838     do on error undo, return error return-value :
     1839        p-ok = false.
     1840        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     1841                                                   and buf_place-attr.obj-code    = p-obj-code
     1842                                                   and buf_place-attr.obj-type    = p-obj-type
     1843                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1844        if available buf_place-attr then do :
     1845          p-value = buf_place-attr.attr-value.
     1846          p-ok = true.
     1847        end.
     1848        else do :
     1849          p-ok = false.
     1850        end.
     1851     end.
     1852   end.
     1853   procedure placelib_del-attr:
     1854   define input parameter  p-code     like ub.place-attr.attr-code .
     1855   define input parameter  p-obj-code like ub.place-attr.obj-code .
     1856   define input parameter  p-obj-type like ub.place-attr.obj-type .
     1857   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     1858   define input parameter  p-value    like ub.place-attr.attr-value .
     1859   define output parameter p-ok       as logical.
     1860   define buffer buf_place-attr for ub.place-attr .
     1861     do on error undo, return error return-value :
     1862        p-ok = false.
     1863        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1864                                                   and buf_place-attr.obj-code    = p-obj-code
     1865                                                   and buf_place-attr.obj-type    = p-obj-type
     1866                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1867        if available buf_place-attr then do :
     1868           delete buf_place-attr.
     1869           p-ok = true.
     1870        end.
     1871     end.
     1872   end.
     1873   function f-int-to-chr returns character (input v-int as integer) :
     1874     if v-int = 0 or v-int = ? then return "" .
     1875     return string(v-int) .
     1876   end function .
     1877   function f-dec-to-chr returns character (input v-dec as decimal) :
     1878     if v-dec = ? then return "" .
     1879     return string(v-dec, "->>>>>>>9.99<<<") .
     1880   end function .
     1881     define new global shared variable g#lib-rvs as handle no-undo.
     1882   define variable vss-revision18    as character no-undo init "$Revision:$":U .
     1883   define variable vss-author18      as character no-undo init "$Author:$":U .
     1884   define variable vss-date18        as character no-undo init "$Date:$":U .
     1885   define variable vss-workfile18    as character no-undo init "$Workfile:$":U .
     1886   define variable vss-archive18     as character no-undo init "$Archive:$":U .
     1887   define variable vss-description18 as character no-undo init "Работа С сокетом".
     1888   procedure PutMesAsunc:
     1889       define input  parameter Itext as character no-undo.
     1890       define variable vflag as logical no-undo.
     1891       Publish "WriteLogAsunc" (Itext, yes)  .
     1892   end.
     1893   procedure PutMesAsuncNoTime:
     1894       define input  parameter Itext as character no-undo.
     1895       define variable vflag as logical no-undo.
     1896       Publish "WriteLogAsunc" (Itext,no)  .
     1897   end.
     1898   procedure PutStatAsunc:
     1899       define input  parameter Itext as character no-undo.
     1900       Publish "PutStatAsunc" (Itext,no) .
     1901        run
     1902       PutMesAsunc (itext).
     1903   end.
     1904   procedure PutStatAsuncNoTime:
     1905       define input  parameter Itext as character no-undo.
     1906       Publish "PutStatAsunc" (Itext,no)  .
     1907        run
     1908       PutMesAsuncNoTime (itext).
     1909   end.
     1910   procedure PutStatAsuncAdd:
     1911       define input  parameter Itext as character no-undo.
     1912       Publish "PutStatAsunc" (Itext,yes)  .
     1913   end.
     1914   procedure PutFileLogAsunc:
     1915       define input  parameter IFile as character no-undo.
     1916       Publish "PutFileLogAsunc" (ifile)  .
     1917   end.
     1918   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1919   define variable mHSocket       as handle      no-undo.
     1920   define variable mWebRespHead   as longchar    no-undo.
     1921   define variable mWebResp       as longchar    no-undo.
     1922   define variable mWebRespMptr   as memptr      no-undo.
     1923   define variable OerrMsg        as character   no-undo.
     1924   define variable mFileLogSocet  as character   no-undo.
     1925   define variable mReturnHttp    as logical     no-undo.
     1926   define variable mAddTimeOut    as logical     no-undo init yes.
     1927   define variable mSocetBegTime  as datetime-tz no-undo.
     1928   define variable mSocetEndTime  as dec         no-undo.
     1929   define variable mWriteRespFile as character   no-undo.
     1930   define variable mTypeResponse  as character   no-undo init "POST".
     1931   publish "getSocetLog" (output mFileLogSocet).
     1932   if
     1933      (   mFileLogSocet eq ""
     1934       or mFileLogSocet eq ?)
     1935      and session:debug-alert
     1936   then
     1937      mFileLogSocet = "socet.log".
     1938   procedure ConectSocet:
     1939      define input  parameter iHost       as character no-undo.
     1940      define input  parameter iPort       as character no-undo.
     1941      define input  parameter iUrl        as character no-undo.
     1942      define input  parameter iPostData   as longchar  no-undo.
     1943      define input  parameter iReturnType as character no-undo.
     1944      define input  parameter iTimeOut    as decimal   no-undo.
     1945      define input  parameter iSilent     as logical   no-undo.
     1946      define input  parameter iTextWait   as character no-undo.
     1947      mWaitFramTextBeg = iTextWait.
     1948      run SendReqSocet (iHost, iPort, iUrl, iPostData, iReturnType, 'getResponse').
     1949      if OerrMsg eq ""
     1950      then
     1951         run waitrespsocet (iTimeOut, iSilent, iTextWait).
     1952      mSocetEndTime = (now - mSocetBegTime) / 1000.
     1953   end.
     1954   procedure SendReqSocet:
     1955      define input  parameter iHost            as character no-undo.
     1956      define input  parameter iPort            as character no-undo.
     1957      define input  parameter iUrl             as character no-undo.
     1958      define input  parameter iPostData        as longchar  no-undo.
     1959      define input  parameter iReturnType      as character no-undo.
     1960      define input  parameter iProcGetResponse as character no-undo.
     1961      mSocetBegTime = now.
     1962      run writeLogSocet in this-procedure (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
     1963      assign
     1964         mWebResp         = ""
     1965         mWebResphead     = ""
     1966         OerrMsg          = ""
     1967         mReturnHttp      = iReturnType eq "xml" or iReturnType eq "http" or iReturnType eq "yes"
     1968         iProcGetResponse = "getResponse"  when iProcGetResponse eq ? or iProcGetResponse eq ""
     1969      .
     1970      define variable vPostData as longchar                       no-undo.
     1971      if    iHost eq ""
     1972         or iHost eq ?
     1973      then do:
     1974         oErrMsg = substitute("Не задан host &1 или port &2.", ihost ,iport).
     1975         run writeLogSocet in this-procedure (oErrMsg).
     1976         return oErrMsg.
     1977      end.
     1978      run waitfram-show (substitute("Подключаемся к адресу &1 по порту &2",iHost,iPort )).
     1979      create socket mHSocket.
     1980      mHSocket:connect('-H ' + iHost + ' -S ' + iPort) no-error.
     1981      if mHSocket:connected() = false
     1982      then do:
     1983         run waitfram-hide .
     1984         oErrMsg = substitute( "Не удалось установить соединение: &1" , error-status:get-message(1)).
     1985         run writeLogSocet in this-procedure (oErrMsg).
     1986         delete object mHSocket.
     1987         return oErrMsg.
     1988      end.
     1989      run waitfram-show ("Отправка данных").
     1990      mHSocket:set-read-response-procedure(iProcGetResponse).
     1991      run PostRequest (
     1992       input iUrl,
     1993       input iHost + ":" + iPort,
     1994       input iPostData
     1995       ).
     1996       run waitfram-hide .
     1997   end.
     1998   procedure WaitRespSocet:
     1999      define input  parameter iTimeOut   as decimal   no-undo.
     2000      define input  parameter iSilent    as logical   no-undo.
     2001      define input  parameter iTextWait  as character no-undo.
     2002      if    not valid-handle (mHSocket )
     2003      then do:
     2004         run writeLogSocet in this-procedure (substitute("Потерян объект соединения")).
     2005         return "End connected".
     2006      end.
     2007      if mHSocket:connected() = false
     2008      then do:
     2009         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespSocet")).
     2010         oErrMsg = "Not connected".
     2011         return oErrMsg.
     2012      end.
     2013      mWaitFramView = if iSilent ne yes then yes else no.
     2014      mWaitFramTextBeg = iTextWait.
     2015      mWaitFramTimeOut = iTimeOut.
     2016      mWaitFramTextEnd = "".
     2017      mWaitFramStop = no.
     2018      if mAddTimeOut
     2019      then do:
     2020         mWaitFramTimeOut = 300.
     2021         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при уcтановке соодинения",mWaitFramTimeOut)).
     2022      end.
     2023      run writeLogSocet in this-procedure (substitute("Ожидаем ответ TimeOut &1 сек.",iTimeOut )).
     2024      subscribe   to "WaitFramStop" anywhere run-procedure "WaitRespTestStop".
     2025      run WaitFramWaitFor(1).
     2026      unsubscribe "WaitFramStop".
     2027      if mWaitFramStopUser
     2028      then do:
     2029         OerrMsg = substitute("Операция прервана пользователем." ).
     2030         run writeLogSocet in this-procedure (OerrMsg).
     2031      end.
     2032      else if mWaitFramStopTimeOut
     2033      then do:
     2034         OerrMsg = substitute("Привышено время ожидания &1 сек. Ответ не получен.",iTimeOut ).
     2035         run writeLogSocet in this-procedure (OerrMsg).
     2036      end.
     2037      run waitfram-hide .
     2038      mHSocket:disconnect() no-error.
     2039      delete object mHSocket.
     2040   end.
     2041   procedure WaitRespTestStop:
     2042      if mWaitFramStopTimeOut
     2043      then
     2044         return.
     2045      if     (mWebResp ne ""
     2046          and mWebResp ne ?)
     2047      then do:
     2048         mWaitFramStop = yes.
     2049         return.
     2050      end.
     2051      else if mHSocket:connected() = false
     2052      then do:
     2053         mWaitFramStop = yes.
     2054         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной WaitRespTestStop")).
     2055         oErrMsg = "Not connected".
     2056         return oErrMsg.
     2057      end.
     2058      wait-for read-response of mHSocket pause 0.001.
     2059   end.
     2060   procedure PostRequest:
     2061      define input parameter iPostUrl  as char.
     2062      define input parameter iPostHost as char.
     2063      define input parameter iPostData as longchar.
     2064      define variable vCRequest      as longchar.
     2065      define variable vMRequest       as memptr.
     2066      if iPostUrl ne ?
     2067      then do:
     2068         vCRequest =substitute(
     2069         '&5 /&2 HTTP/1.1&1'                                   +
     2070         'Host: &4&1'                                           +
     2071         'User-Agent: Apache-HttpClient/4.1.1 (java 1.5)&1'    +
     2072         'Accept: */*&1' +
     2073         'Content-Type: text/xml&1'               +
     2074         'Content-Length: &3&1'                                  +
     2075         '&1'
     2076         ,
     2077         chr(13) + chr(10),
     2078         iPostUrl,
     2079         length(iPostData),
     2080         iPostHost,
     2081         mTypeResponse) + iPostData.
     2082      end.
     2083      else
     2084         vCRequest = iPostData.
     2085      run writeLogSocet in this-procedure (substitute("Отправляем запрос &1.",chr(13) + chr(10) )).
     2086      run writeLogSocet in this-procedure (vCRequest).
     2087      SET-SIZE(vMRequest)            = 0.
     2088      SET-SIZE(vMRequest)            = length(vCRequest) + 1.
     2089      SET-BYTE-ORDER(vMRequest)      = big-endian.
     2090      PUT-STRING(vMRequest,1)        = vCRequest .
     2091      if mHSocket:connected() = false then
     2092      do:
     2093         run writeLogSocet in this-procedure ("Соединение было разорвано другой стороной getResponse").
     2094         oErrMsg = "Not connected".
     2095         delete object mHSocket no-error.
     2096         return oErrMsg.
     2097      end.
     2098      mHSocket:write(vMRequest, 1, length(vCRequest)).
     2099      run writeLogSocet in this-procedure ("Запрос отправлен.").
     2100   end procedure.
     2101   function hex-to-int returns integer (
     2102     input p-hex-code  as character  ).
     2103     define variable v-int-code as integer   no-undo .
     2104     define variable v-ind      as integer   no-undo .
     2105     define variable v-digit    as integer   no-undo .
     2106     define variable v-letter   as character no-undo .
     2107     do v-ind = 1 to length(p-hex-code)
     2108     :
     2109       assign
     2110         v-letter = caps(substring(p-hex-code, v-ind, 1))
     2111       .
     2112       assign
     2113         v-digit = index('123456789ABCDEF':u, v-letter)
     2114       .
     2115       assign
     2116         v-int-code = v-int-code * 16 + v-digit
     2117       .
     2118     end.
     2119     return v-int-code .
     2120   end function .
     2121   procedure getResponse:
     2122      define variable vFlagTag     as logical          no-undo init no.
     2123      define variable vResponse    as memptr           no-undo.
     2124      define variable vCnt         as int64            no-undo.
     2125      define variable vMessage     as longchar         no-undo.
     2126      define variable v-cont-length as int64 no-undo.
     2127      define variable vi           as integer no-undo.
     2128      define variable v-hd-line    as character no-undo.
     2129      define variable level        as integer no-undo initial 2.
     2130      repeat while program-name(level) <> ?:
     2131        if program-name(level) = program-name(1) then do:
     2132          run writeLogSocet in this-procedure (substitute("Повторный вызов getResponse.")).
     2133          return "".
     2134        end.
     2135        level = level + 1.
     2136      end.
     2137      if mHSocket:connected() = false then
     2138      do:
     2139         run writeLogSocet in this-procedure (substitute("Соединение было разорвано другой стороной getResponse")).
     2140         oErrMsg = "Not connected".
     2141         return oErrMsg.
     2142      end.
     2143      if mAddTimeOut
     2144      then do:
     2145         mWaitFramTimeOut = 1000.
     2146         run writeLogSocet in this-procedure (substitute ("Таймаут увеличен до &1 при получении ответа",mWaitFramTimeOut)).
     2147      end.
     2148      run writeLogSocet in this-procedure (substitute("Получаем ответ")).
     2149      mWaitFramTextEnd = "Получаем ответ".
     2150      define variable vWaitProcEvent as logical no-undo.
     2151      vWaitProcEvent = mWaitProcEvent.
     2152      mWaitProcEvent = no.
     2153      run WaitFramRunPause (?).
     2154      define variable vByte as int64 no-undo.
     2155      define variable vNextMese as int64 no-undo init 100000.
     2156      define variable VFlag as logical no-undo init ? .
     2157      mWaitFramStop = no.
     2158      mWaitFramStopTimeOut = no.
     2159      block-wait:
     2160      do while mHSocket:get-bytes-available() > 0:
     2161         VFlag = no.
     2162         define variable vNumByte as integer no-undo.
     2163         vNumByte =   mHSocket:get-bytes-available().
     2164         if vNumByte > 30000 then vNumByte = 30000.
     2165         SET-SIZE(vResponse) = vNumByte + 1.
     2166         SET-BYTE-ORDER(vResponse) = big-endian.
     2167         mHSocket:read(vResponse,1,vNumByte).
     2168         vMessage = vMessage + GET-STRING(vResponse,1).
     2169         if  mReturnHTTp
     2170         then do:
     2171            vCnt = index(vMessage,chr(13) + chr(10) + chr(13) + chr(10)).
     2172            if vCnt > 0
     2173            then do:
     2174               mReturnHttp = no.
     2175               mWebResphead = substring (vMessage,1,vCnt).
     2176               vMessage     = substring (vMessage,vCnt + 4).
     2177               mWebResphead = replace (mWebResphead,";",chr(13) + chr(10)).
     2178               do vi = 1 to num-entries(mWebResphead,chr(13) + chr(10)):
     2179                  v-hd-line = trim(entry(vi,mWebResphead,chr(13) + chr(10))).
     2180                  if  v-hd-line  begins "Content-Length"  then  do:
     2181                     v-cont-length = INT(trim(substring(v-hd-line,16,length(v-hd-line)))).
     2182                  end.
     2183                  else if v-hd-line  begins "Transfer-Encoding"
     2184                  then do :
     2185                     define variable vChunked as logical no-undo.
     2186                     vchunked = index(v-hd-line,"chunked",19) > 0.
     2187                  end.
     2188               end.
     2189            end.
     2190         end.
     2191         vByte = vByte + vNumByte.
     2192         SET-SIZE(vResponse) = 0.
     2193         if v-cont-length > 0 and length (vMessage) >= v-cont-length
     2194         then
     2195            leave block-wait.
     2196         if not mHSocket:get-bytes-available() > 0
     2197         then do:
     2198            VFlag = yes.
     2199            run WaitFramRunPause (?).
     2200            run gbl/pause.p (1000) .
     2201         end.
     2202         else if vByte > vNextMese
     2203         then do:
     2204            vNextMese = vNextMese + 100000.
     2205            mWaitFramTextEnd = substitute ("Получаем ответ прочитано &1 байт ",vByte) .
     2206            run WaitFramRunPause (?).
     2207         end.
     2208         if mWaitFramStopTimeOut
     2209         then do:
     2210            mWebResp = "".
     2211            leave block-wait.
     2212         end.
     2213      end.
     2214      if VFlag ne false
     2215      then
     2216         run writeLogSocet in this-procedure (substitute ("Завершена обработка &1",If VFlag eq  yes then " 0 байт за последнию секунду" else " пустой ответ(((")).
     2217      mWaitFramStop = yes.
     2218      run writeLogSocet         in this-procedure ("Получен ответ").
     2219      run writeLogSocetOnlyText in this-procedure (mWebResphead).
     2220      run writeLogSocetOnlyText in this-procedure (substitute("&1&2&1&2",chr(13) , chr(10) )).
     2221      run writeLogSocetOnlyText in this-procedure (vMessage).
     2222      run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
     2223      mHSocket:disconnect() no-error.
     2224      if v-cont-length > 0
     2225      then
     2226         mWebResp = substring (vMessage,1,v-cont-length).
     2227      else if vChunked
     2228      then do:
     2229         define variable vByteCopy as int64 no-undo init 1.
     2230         Block-Copy:
     2231         do while length(vMessage) > 0:
     2232            vByteCopy = 1.
     2233            vCnt = index (vMessage,chr(13) + chr(10)) - 1.
     2234            vByteCopy = vByteCopy +  vCnt + 2.
     2235            v-cont-length = hex-to-int(string(substring (vMessage,1,vCnt))).
     2236            if v-cont-length eq 0
     2237            then
     2238               leave Block-copy.
     2239            mWebResp = mWebResp + substring (vMessage,vByteCopy,  v-cont-length).
     2240            vByteCopy = vByteCopy + v-cont-length + 2.
     2241            vMessage = substring  (vMessage,vByteCopy).
     2242         end.
     2243         run writeLogSocet         in this-procedure ("Заголовок").
     2244         run writeLogSocetOnlyText in this-procedure (mWebResphead).
     2245         run writeLogSocet         in this-procedure ("Тело ответа").
     2246         run writeLogSocetOnlyText in this-procedure (mWebResp).
     2247        run writeLogSocetOnlyText in this-procedure (substitute("&1&2",chr(13) , chr(10) )).
     2248      end.
     2249      else
     2250         mWebResp = vMessage.
     2251      mWaitProcEvent = vWaitProcEvent.
     2252      mSocetEndTime = (now - mSocetBegTime) / 1000.
     2253      copy-lob mWebResp to mWebRespMptr.
     2254      if     mWriteRespFile ne ""
     2255         and mWriteRespFile ne ?
     2256      then
     2257           run gbl/fileapnd.p
     2258                ( mWriteRespFile
     2259                , mWebResp + chr(13) + chr(10)
     2260                ,input 10
     2261                ) no-error .
     2262   end procedure.
     2263   procedure writeLogSocet:
     2264      define input  parameter itext as longchar no-undo.
     2265      if mFileLogSocet eq "Async"
     2266      then
     2267         run PutMesAsunc(itext).
     2268      else if     mFileLogSocet ne ?
     2269              and mFileLogSocet ne ""
     2270      then do:
     2271         run gbl/fileapnd.p
     2272             ( mFileLogSocet
     2273             , substitute("&1 &2 ", string(today), string(time, "HH:MM:SS"))
     2274             ,input 10
     2275             ) no-error .
     2276         run writeLogSocetOnlyText(itext).
     2277         run gbl/fileapnd.p
     2278             ( mFileLogSocet
     2279             , substitute(" &1&2", chr(13) , chr(10))
     2280             ,input 10
     2281             ) no-error .
     2282      end.
     2283   end.
     2284   procedure writeLogSocetOnlyText:
     2285      define input  parameter itext as longchar no-undo.
     2286      if mFileLogSocet eq "Async"
     2287      then
     2288         run PutMesAsunc(itext).
     2289      else if     mFileLogSocet ne ?
     2290              and mFileLogSocet ne ""
     2291      then do:
     2292         if length(itext) > 32000
     2293         then
     2294            copy-lob
     2295      from object itext
     2296      to file mFileLogSocet append
     2297      no-error
     2298      .
     2299         else
     2300         run gbl/fileapnd.p
     2301             ( mFileLogSocet
     2302             , string(itext)
     2303             ,input 10
     2304             ) no-error .
     2305      end.
     2306   end.
     2307   procedure Disconect:
     2308      mHSocket:disconnect() no-error.
     2309      delete object mHSocket no-error.
     2310   end.
     2311   define temp-table tt-place no-undo
     2312     field loc1          as character  label "№ резервуара"
     2313     field locint        as integer    label "№ резервуара"           init ?
     2314     field pl-code       as integer    label "Код резервуара"
     2315     field gds-code      as integer    label "Код продукта"
     2316     field gds-name      as character  label "НАИМЕНОВАНИЕ ПРОДУКТА"
     2317     field level-total   as decimal    label "Общий уровень (см)"
     2318     field level-water   as decimal    label "Уровень воды (см)"
     2319     field total-vol     as decimal    label "Общий объем (л)"
     2320     field avrg-temp     as decimal    label "Средняя Т"
     2321     field t1            as decimal    label "T1"
     2322     field t2            as decimal    label "T2"
     2323     field t3            as decimal    label "T3"
     2324     field density       as decimal    label "Плотность (кг/л)"
     2325     field mass          as decimal    label "Масса (кг)"
     2326     field vapor-density as decimal    label "Плотность СУГ (кг/л)"
     2327     field vapor-pressure as decimal   label "Давление СУГ (мПа)"
     2328     field volume_water  as decimal
     2329     field is-error      as logical
     2330     field error-message as character
     2331     index pi as unique
     2332       loc1
     2333     index locint as primary locint loc1
     2334   .
     2335     define temp-table tt-param no-undo
     2336       field strfrfile as character
     2337       field strasi    as character
     2338       field flddb     as character
     2339       index pi        as primary   unique strfrfile
     2340       index asi strasi.
     2341     define temp-table tt-param-pump no-undo
     2342       field strfrfile as character
     2343       field meaning   as character
     2344       index pi        as primary   unique strfrfile.
     2345     define temp-table tt-meas no-undo like ub.place
     2346       field measure-qnty like ub.rvs-line.measure-qnty
     2347       field brutto-qnty like ub.rvs-line.brutto-qnty
     2348       field measure-cli-qnty like ub.rvs-line.measure-cli-qnty
     2349       field brutto-cli-qnty like ub.rvs-line.brutto-cli-qnty
     2350       field density like ub.rvs-line.density
     2351       field temperature like ub.rvs-line.temperature
     2352       field level-total like ub.rvs-line.level-total
     2353       field level-petrol like ub.rvs-line.level-petrol
     2354       field level-water like ub.rvs-line.level-water
     2355       field temp-layer1 like ub.rvs-line.temp-layer1
     2356       field temp-layer2 like ub.rvs-line.temp-layer2
     2357       field temp-layer3 like ub.rvs-line.temp-layer3
     2358       field measure-tc-qnty like ub.rvs-line.measure-tc-qnty
     2359       field brutto-tc-qnty like ub.rvs-line.brutto-tc-qnty
     2360       field meas-vol-oil   as logical initial no
     2361       field meas-vol-water as logical initial no
     2362       field water-qnty     like ub.rvs-line.measure-qnty
     2363       field vapor-density like ub.rvs-line.density
     2364       field vapor-pressure as decimal format ">>9.9<":U
     2365       field log-brutto as logical
     2366       field temp-not-null as logical
     2367       field t1-not-null as logical
     2368       field t2-not-null as logical
     2369       field t3-not-null as logical
     2370       field is-error    as logical
     2371       index pi        as primary   loc1.
     2372     define temp-table tt-meas-file no-undo like tt-meas.
     2373     define temp-table tt-pump-nozzle no-undo like ub.pump-nozzle
     2374       field gds-code    like ub.goods.gds-code
     2375       field meas-el-cnt like ub.rvs-line-pump.meas-el-cnt
     2376       field meas-am-cnt like ub.rvs-line-pump.meas-am-cnt
     2377       field grade       as   character
     2378       field meas-cf-cnt like ub.rvs-line-pump.meas-cf-cnt.
     2379     define temp-table tt-pump-nozzle-file no-undo like tt-pump-nozzle.
     2380   function objExists return character
     2381   (input  ifolder as character,
     2382    input  iType   as character  ):
     2383       define variable vFileType as character no-undo init "D,F".
     2384       define variable vi        as integer no-undo.
     2385       define variable vtype as character no-undo.
     2386       if iType ne ?
     2387       then
     2388          vFileType = iType.
     2389       do vi = 1 to num-entries(vFileType):
     2390          file-information:file-name = ".\" + right-trim(replace(ifolder,"/","\"),"\").
     2391          vtype = file-information:file-type.
     2392          if entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
     2393             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
     2394             index(vtype , entry(vi,vFileType )) > 0
     2395          then return file-information:full-pathname .
     2396          file-information:file-name = right-trim(replace(ifolder,"/","\"),"\").
     2397          vtype = file-information:file-type.
     2398          if file-information:file-name <> "" and
     2399             entry(num-entries(file-information:file-name, "\"), file-information:file-name, "\")
     2400             = entry(num-entries(file-information:full-pathname, "\"), file-information:full-pathname ,"\") and
     2401             index( vtype, entry(vi,vFileType )) > 0
     2402          then return file-information:full-pathname .
     2403       end.
     2404       return ? .
     2405   end.
     2406   function SearchFile return character
     2407   (input  ifile as character):
     2408      return objExists(ifile,?).
     2409   end.
     2410   function SearchPFile return character
     2411   (input inFile as char):
     2412        define variable oFile       as character no-undo.
     2413        define variable vFileSearch as character no-undo.
     2414        define variable vNumEntry   as integer no-undo.
     2415        if inFile = "" then return ?.
     2416        vNumEntry = num-entries(inFile,".").
     2417        vFileSearch = inFile.
     2418        if    vNumEntry > 0
     2419           and (   entry(vNumEntry,inFile,".") eq "p"
     2420                or entry(vNumEntry,inFile,".") eq "w")
     2421        then do:
     2422           entry(vNumEntry,vFileSearch, ".") = "r".
     2423           oFile = search(vFileSearch ).
     2424           if oFile eq ?
     2425           then
     2426              oFile = search(inFile).
     2427        end.
     2428        else
     2429           oFile = search(vFileSearch).
     2430        return oFile.
     2431     end.
     2432   define stream str-file.
     2433   procedure readfiletxt:
     2434      define input  parameter i_File-Name   as character no-undo.
     2435      define output parameter Otext as longchar no-undo.
     2436      define variable v_string-tmp as character no-undo.
     2437      if searchfile(i_File-Name) eq ?
     2438      then
     2439         return.
     2440      input  stream str-file from  value (i_File-Name)   .
     2441      repeat :
     2442         import stream str-file unformatted v_string-tmp.
     2443         Otext = Otext + v_string-tmp + chr(10).
     2444      end.
     2445      input  stream str-file close.
     2446   end procedure.
     2447   procedure readrevisetxt:
     2448      define input  parameter i_Str         as Longchar no-undo.
     2449      define input  parameter i_StartString as character no-undo.
     2450      define input  parameter i_comment     as character no-undo.
     2451      define variable v_string-tmp          as character no-undo.
     2452      define variable v-bh                  as handle  no-undo .
     2453      define variable v-fh                  as handle  no-undo .
     2454      define variable vi                    as integer no-undo.
     2455      for each tt-place:
     2456         tt-place.is-error       = yes.
     2457      end.
     2458      rpt:
     2459      do vi = 1 to num-entries(i_Str,chr(10)) :
     2460         v_string-tmp = entry(vi, i_Str,chr(10)).
     2461         if index( v_string-tmp, i_comment ) > 0
     2462         then do:
     2463            v_string-tmp = substring( v_string-tmp, 1, index( v_string-tmp, i_comment ) - 1 ).
     2464         end.
     2465         if v_string-tmp = '':U
     2466         then
     2467            next rpt .
     2468         if index( v_string-tmp, i_StartString ) > 0
     2469         then do:
     2470            find first tt-place where tt-place.loc1 = trim( entry( 2, v_string-tmp, '=' ) ) no-error .
     2471            if not available tt-place
     2472            then do :
     2473              create tt-place .
     2474              assign tt-place.loc1 = trim( entry( 2, v_string-tmp, '=' ) )
     2475                     tt-place.locint   = int(tt-place.loc1)
     2476              no-error .
     2477            end.
     2478            assign
     2479                tt-place.t1             = ?
     2480                tt-place.t2             = ?
     2481                tt-place.t3             = ?
     2482                tt-place.level-total    = ?
     2483                tt-place.level-water    = ?
     2484                tt-place.total-vol      = ?
     2485                tt-place.avrg-temp      = ?
     2486                tt-place.density        = ?
     2487                tt-place.mass           = ?
     2488                tt-place.vapor-density  = ?
     2489                tt-place.vapor-pressure = ?
     2490                tt-place.volume_water   = ?
     2491                tt-place.is-error       = no
     2492                tt-place.error-message  = ?
     2493            .
     2494         end.
     2495         else do:
     2496            if not available tt-place
     2497            then
     2498               next rpt .
     2499            find first tt-param where tt-param.strfrfile = trim( entry( 1, v_string-tmp, '=' ) ) no-error.
     2500            if available tt-param
     2501            then do:
     2502               v-bh = buffer tt-place:handle.
     2503               assign
     2504                  v-fh                = v-bh:buffer-field( tt-param.strasi )
     2505                  v-fh:buffer-value() = decimal( trim( entry( 2, v_string-tmp, '=' ) ) )
     2506               no-error.
     2507               if (tt-param.flddb = "temperature"
     2508                or tt-param.flddb = "water-qnty")
     2509               and trim( entry( 2, v_string-tmp, '=' ) ) = "-"
     2510               then do :
     2511                 assign
     2512                    v-fh:buffer-value() = ?
     2513                 no-error.
     2514               end .
     2515            end.
     2516            else do:
     2517               run gbl/fileapnd.p
     2518                     ( 'revis.err'
     2519                     ,
     2520                  if trim( entry( 1, v_string-tmp, '=' ) ) = "ERROR"
     2521                  then
     2522                     substitute("&1 &2  Ошибка: &3 &4", string(today),string(time, "HH:MM:SS"),  trim( entry( 2, v_string-tmp, '=' ) ), chr(13) + chr(10))
     2523                  else
     2524                     substitute("&1 &2  Неизвестный параметр: &3 &4", string(today),string(time, "HH:MM:SS"), trim( entry( 1, v_string-tmp, '=' ) ), chr(13) + chr(10))
     2525                  ,input 10
     2526                ) no-error .
     2527            end.
     2528         end.
     2529      end.
     2530      for each tt-place:
     2531         tt-place.vapor-pressure = tt-place.vapor-pressure / 1000.
     2532      end.
     2533   end procedure.
     2534   procedure get-from-struna :
     2535     define input  parameter i-log-file-name as character no-undo.
     2536     define input  parameter i-obj-code as integer no-undo.
     2537     define variable v-comstring as character no-undo .
     2538     define variable v_File-Name as character no-undo .
     2539     define variable v_command as character no-undo .
     2540     define variable v-comment     as character no-undo.
     2541     define variable v-StartString as character no-undo.
     2542     define variable Vrevis        as longchar no-undo.
     2543     define variable vi as integer no-undo.
     2544   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_crtt-rvs in g#lib-rvs ( input-output table tt-param ,
     2545                               output       v-comstring ,
     2546                               output       v-comment ,
     2547                               output       v-StartString ) no-error .
     2548       if error-status :error then do:
     2549         return error substitute( 'Ошибка при установке параметров для считывания данных с резервуаров.&1&2&1&3'
     2550                               , chr(10)
     2551                               , error-status :get-message( 1 )
     2552                               , return-value ) .
     2553       end.
     2554      v_File-Name = searchfile('revis.txt').
     2555      if v_File-Name ne ?
     2556      then do:
     2557         block-del-file:
     2558         do vi = 1 to 5:
     2559            os-delete value( v_File-Name ) .
     2560            v_File-Name = searchfile('revis.txt').
     2561            if v_File-Name eq ?
     2562            then
     2563               leave block-del-file.
     2564        end.
     2565      end.
     2566      if v_File-Name ne ?
     2567      then
     2568         return error 'Файл revis.txt заблокирован удалите файл и попробуйте еще раз. ' + v_File-Name .
     2569      if    v-comstring = '':U
     2570         or v-comstring = ?
     2571      then do:
     2572         return error 'Не задан парам. comstr в секции revision ini файла.' .
     2573      end.
     2574      v_File-Name = "wrevis" + string(random(1000000,9999999)) + ".tmp".
     2575      if searchfile(v_File-Name) ne ?
     2576      then do :
     2577         v_File-Name = "wrevis" + string(random(1000000,9999999)) + ".tmp".
     2578         if searchfile(v_File-Name) ne ?
     2579         then do :
     2580           os-delete value(searchfile(v_File-Name)) no-error .
     2581         end.
     2582         if searchfile(v_File-Name) ne ?
     2583         then
     2584           return error "Удалите все файлы wrevis*.tmp".
     2585      end.
     2586      assign
     2587         v_command = substitute( "&1 &2 &3 &4", v-comstring, string(0), v_File-Name, i-obj-code)
     2588      .
     2589      os-command silent value( v_command ) .
     2590      if searchfile(v_File-Name) ne ?
     2591      then
     2592         run readfiletxt (v_File-Name, output Vrevis).
     2593      run gbl/fileapnd.p
     2594             ( i-log-file-name
     2595             ,substitute("&1 &2  Запрос &3&4", string(today),string(time, "HH:MM:SS"), v_command, chr(13) + chr(10))
     2596             ,input 10
     2597             ) no-error .
     2598      if searchfile( v_File-Name ) = ? then do:
     2599         run gbl/fileapnd.p
     2600             ( i-log-file-name
     2601             ,substitute("Файл с прибора не получен. &1",  chr(13) + chr(10))
     2602             ,input 10
     2603             ) no-error .
     2604         return error 'Файл с прибора не получен.' .
     2605     end.
     2606     else do:
     2607         v_File-Name  = searchfile( v_File-Name ) .
     2608     end.
     2609     run gbl/fileapnd.p
     2610             ( i-log-file-name
     2611             ,substitute("&1 &2  Данные &3", string(today),string(time, "HH:MM:SS"), chr(13) + chr(10))
     2612             ,input 10
     2613             ) no-error .
     2614     os-append value(v_File-Name) value(i-log-file-name).
     2615     os-rename value( v_File-Name ) 'revis.txt'.
     2616     os-delete value( v_File-Name ) .
     2617     run gbl/fileapnd.p
     2618             ( i-log-file-name
     2619             , chr(13) + chr(10)
     2620             ,input 10
     2621             ) no-error .
     2622     run readrevisetxt (Vrevis,v-StartString,v-comment).
     2623   end procedure .
     2624   procedure get-from-ifsf :
     2625      define input  parameter i-log-file-name as character no-undo.
     2626      define input  parameter i-asi-ip        as character no-undo.
     2627      define input  parameter i-asi-port      as character no-undo.
     2628     define variable v_command     as   character     no-undo.
     2629     define variable v-log     as logical no-undo .
     2630     define variable v-bytes   as integer no-undo .
     2631     define variable v-out-data as character no-undo .
     2632     define variable v-line-str as character no-undo .
     2633     define variable ii        as integer no-undo .
     2634     define variable str       as character no-undo .
     2635     define variable str1      as character no-undo .
     2636     define variable str2      as character no-undo .
     2637     define variable hSocket   as handle no-undo .
     2638     define variable mDataIn   as memptr no-undo .
     2639     define variable mDataout  as memptr no-undo .
     2640     define variable cmd       as character no-undo .
     2641     define variable connStr   as character no-undo .
     2642     define variable v-attr-type   as character no-undo.
     2643     define variable v-comstring   as character no-undo.
     2644     define variable v-comment     as character no-undo.
     2645     define variable v-StartString as character no-undo.
     2646     define variable Vrevis        as longchar no-undo.
     2647     define variable vi as integer no-undo.
     2648   if valid-handle( g#lib-rvs ) <> yes then do:       run str/lib-rvs.p persistent no-error.       if error-status :error or valid-handle( g#lib-rvs ) <> yes then do:         message "Error starting lib-rvs.p" skip( 0 )           g#lib-rvs                        skip( 0 )           g#lib-rvs    :type               skip( 0 )           g#lib-rvs    :file-name          skip( 0 )           error-status :get-message( 1 )   skip( 0 )           return-value                     skip( 0 )         view-as alert-box error.         stop.       end.      end.     run lib-rvs_crtt-rvs in g#lib-rvs ( input-output table tt-param ,
     2649                               output       v-comstring ,
     2650                               output       v-comment ,
     2651                               output       v-StartString ) no-error .
     2652       if error-status :error then do:
     2653         return error substitute( 'Ошибка при установке параметров для считывания данных с резервуаров.&1&2&1&3'
     2654                               , chr(10)
     2655                               , error-status :get-message( 1 )
     2656                               , return-value ) .
     2657       end.
     2658     cmd = 'KOI8-R 1 0 1' + chr(10) .
     2659     set-size(mDataIn) = 0 .
     2660     set-size(mDataIn) = length(cmd , "RAW":U) + 1 .
     2661     put-string(mDataIn,1) = cmd .
     2662     find first sys-ctrl no-lock.
     2663     if i-asi-ip eq ? or i-asi-ip eq ""
     2664     then
     2665        run db-attr-value(sys-ctrl.db,"AsiIp",output i-asi-ip,output v-attr-type).
     2666     if i-asi-port eq ? or i-asi-port eq ""
     2667     then
     2668        run db-attr-value(sys-ctrl.db,"AsiPort",output i-asi-port,output v-attr-type).
     2669     create socket hSocket .
     2670     connStr = '-H ' + i-asi-ip + ' -S ' + i-asi-port .
     2671     hSocket:connect(connStr) no-error.
     2672     run gbl/fileapnd.p
     2673             ( i-log-file-name
     2674             ,substitute("&1 &2  Запрос  connStr='-H &3  -S &4 '  cmd='KOI8-R 1 0 1'&5", string(today),string(time, "HH:MM:SS"),i-asi-ip,i-asi-port, chr(13) + chr(10))
     2675             ,input 10
     2676             ) no-error .
     2677     if hSocket:connected() = false
     2678     then do :
     2679       run gbl/fileapnd.p
     2680             ( i-log-file-name
     2681             ,substitute("&1 &2 &3 &4", string(today),string(time, "HH:MM:SS"), "Не могу подключиться к IFSF серверу." , chr(13) + chr(10))
     2682             ,input 10
     2683             ) no-error .
     2684       return error "Не могу подключиться к IFSF серверу." .
     2685     end.
     2686     hSocket:set-socket-option('TCP-NODELAY', 'true').
     2687     hSocket:set-socket-option('SO-KEEPALIVE', 'true').
     2688     hSocket:set-socket-option('SO-REUSEADDR', 'true').
     2689     v-log = hSocket:write(mDataIn, 1, get-size(mDataIn)) no-error.
     2690     if v-log = false or error-status:get-message(1) <> ''
     2691     then do:
     2692       hSocket:disconnect() no-error.
     2693       run gbl/fileapnd.p
     2694             ( i-log-file-name
     2695             ,substitute("&1 &2 &3 &4", string(today),string(time, "HH:MM:SS"), "Не могу отправить команду на IFSF сервер.", chr(13) + chr(10))
     2696             ,input 10
     2697             ) no-error .
     2698       return error "Не могу отправить команду на IFSF сервер." .
     2699     end.
     2700     run sleep (1000) .
     2701     set-size(mDataOut) = 0 .
     2702     v-bytes = hSocket:get-bytes-available() .
     2703     set-size(mDataOut) = v-bytes + 1 .
     2704     v-log = hSocket:read(mDataOut, 1, v-bytes, 2) no-error.
     2705     if v-log = false or error-status:get-message(1) <> ''
     2706     then do:
     2707       hSocket:disconnect() no-error.
     2708       run gbl/fileapnd.p
     2709             ( i-log-file-name
     2710             ,substitute("&1 &2 &3 &4", string(today),string(time, "HH:MM:SS"), "Не могу прочитать ответ от IFSF сервера.", chr(13) + chr(10))
     2711             ,input 10
     2712             ) no-error .
     2713       return error "Не могу прочитать ответ от IFSF сервера." .
     2714     end.
     2715     v-out-data = get-string(mDataOut,1) .
     2716     if v-out-data = ""
     2717     then do :
     2718       hSocket:disconnect() no-error.
     2719       run gbl/fileapnd.p
     2720             ( i-log-file-name
     2721             ,substitute("&1 &2 &3 &4", string(today),string(time, "HH:MM:SS"), "Не могу получить данные от IFSF сервера.", chr(13) + chr(10))
     2722             ,input 10
     2723             ) no-error .
     2724       return error "Не могу получить данные от IFSF сервера." .
     2725     end.
     2726     if index(v-out-data, "Bad Request") > 0
     2727     then do :
     2728       hSocket:disconnect() no-error.
     2729       run gbl/fileapnd.p
     2730             ( i-log-file-name
     2731             ,substitute("&1 &2 &3 &4", string(today),string(time, "HH:MM:SS"), "Bad Request", chr(13) + chr(10))
     2732             ,input 10
     2733             ) no-error .
     2734       return error v-out-data .
     2735     end.
     2736     hSocket:disconnect() no-error.
     2737     delete object hSocket.
     2738     set-size(mDataIn) = 0.
     2739     set-size(mDataOut)   = 0.
     2740     run gbl/fileapnd.p
     2741             ( i-log-file-name
     2742             ,substitute("&1 &2  Данные &3", string(today),string(time, "HH:MM:SS"), chr(13) + chr(10))
     2743             ,input 10
     2744             ) no-error .
     2745      run gbl/fileapnd.p
     2746             ( i-log-file-name
     2747             , v-out-data
     2748             ,input 10
     2749             ) no-error .
     2750      run gbl/fileapnd.p
     2751             ( i-log-file-name
     2752             , chr(13) + chr(10)
     2753             ,input 10
     2754             ) no-error .
     2755     output to "revis.ifsf" .
     2756     do vi = 1 to num-entries(v-out-data, chr(10)) :
     2757       put unformatted entry(vi, v-out-data, chr(10)) skip .
     2758     end.
     2759     output close.
     2760     run readrevisetxt (v-out-data,v-StartString,v-comment).
     2761   end procedure .
     2762   procedure parse-xml :
     2763     define input parameter iStr as longchar .
     2764     define variable hDoc              as handle     no-undo .
     2765     define variable hRoot             as handle     no-undo .
     2766     for each tt-place:
     2767         tt-place.is-error       = yes.
     2768     end.
     2769     CREATE X-DOCUMENT hDoc.
     2770     CREATE X-NODEREF hRoot.
     2771     hDoc:LOAD("longchar",iStr,FALSE).
     2772     hDoc:GET-DOCUMENT-ELEMENT(hRoot).
     2773     RUN GetChildren(hRoot, 1).
     2774     DELETE OBJECT hDoc.
     2775     DELETE OBJECT hRoot.
     2776   end procedure .
     2777   PROCEDURE GetChildren:
     2778   DEFINE INPUT PARAMETER hParent AS HANDLE NO-UNDO.
     2779   DEFINE INPUT PARAMETER level AS INTEGER NO-UNDO.
     2780   DEFINE VARIABLE i AS INTEGER NO-UNDO.
     2781   DEFINE VARIABLE hNoderef AS HANDLE NO-UNDO.
     2782   DEFINE VARIABLE hText    AS HANDLE NO-UNDO.
     2783   define variable client   as character no-undo.
     2784   define variable good                as logical   no-undo .
     2785   define variable v-asi-error-code    as integer   no-undo initial 0 .
     2786   define variable v-asi-error-message as character no-undo .
     2787   CREATE X-NODEREF hNoderef.
     2788   CREATE X-NODEREF hText .
     2789   REPEAT i = 1 TO hParent:NUM-CHILDREN:
     2790       good = hParent:GET-CHILD(hNoderef,i).
     2791       IF NOT good THEN
     2792           LEAVE.
     2793       IF hNoderef:SUBTYPE <> "element" THEN
     2794           NEXT.
     2795       hNoderef:GET-CHILD(hText, 1) no-error .
     2796       IF hNoderef:NAME = "ErrNum"
     2797       then do :
     2798         v-asi-error-code = integer(hText:node-value) no-error .
     2799       end .
     2800       IF hNoderef:NAME = "ErrMsg"
     2801       then do :
     2802         v-asi-error-message = hText:node-value no-error .
     2803         if     v-asi-error-code > 0
     2804            and v-asi-error-code ne 2
     2805         then do :
     2806           assign
     2807             tt-place.t1             = ?
     2808             tt-place.t2             = ?
     2809             tt-place.t3             = ?
     2810             tt-place.level-total    = ?
     2811             tt-place.level-water    = ?
     2812             tt-place.total-vol      = ?
     2813             tt-place.avrg-temp      = ?
     2814             tt-place.density        = ?
     2815             tt-place.mass           = ?
     2816             tt-place.vapor-density  = ?
     2817             tt-place.vapor-pressure = ?
     2818             tt-place.volume_water   = ?
     2819             tt-place.is-error       = true
     2820             tt-place.error-message  = v-asi-error-message
     2821           .
     2822         end .
     2823       end .
     2824       IF hNoderef:NAME = "Tank"
     2825       then do :
     2826         find first tt-place where tt-place.loc1 = hText:node-value no-error .
     2827         if not available tt-place
     2828         then do :
     2829           create tt-place .
     2830           assign tt-place.loc1     = hText:node-value
     2831                  tt-place.locint   = int(tt-place.loc1)
     2832           no-error .
     2833         end.
     2834         assign
     2835             v-asi-error-code        = 0
     2836             tt-place.t1             = ?
     2837             tt-place.t2             = ?
     2838             tt-place.t3             = ?
     2839             tt-place.level-total    = ?
     2840             tt-place.level-water    = ?
     2841             tt-place.total-vol      = ?
     2842             tt-place.avrg-temp      = ?
     2843             tt-place.density        = ?
     2844             tt-place.mass           = ?
     2845             tt-place.vapor-density  = ?
     2846             tt-place.vapor-pressure = ?
     2847             tt-place.volume_water   = ?
     2848             tt-place.is-error       = no
     2849             tt-place.error-message  = ?
     2850         .
     2851       end.
     2852       if    v-asi-error-code = 0
     2853          or v-asi-error-code = 2
     2854       then do :
     2855         IF hNoderef:NAME = "LevelTotal" then assign tt-place.level-total = decimal(hText:node-value) / 10 no-error .
     2856         IF hNoderef:NAME = "LevelWater" then assign tt-place.level-water = decimal(hText:node-value) / 10 no-error .
     2857         IF hNoderef:NAME = "Temperature" then assign tt-place.avrg-temp = decimal(hText:node-value) no-error .
     2858         IF hNoderef:NAME = "Density" then assign tt-place.density = decimal(hText:node-value) no-error .
     2859         IF hNoderef:NAME = "VolumeTotal" then assign tt-place.total-vol = decimal(hText:node-value) no-error .
     2860         IF hNoderef:NAME = "MassTotal" then assign tt-place.mass = decimal(hText:node-value) no-error .
     2861         IF hNoderef:NAME = "VaporDensity" then assign tt-place.vapor-density = decimal(hText:node-value) no-error .
     2862         IF hNoderef:NAME = "VaporPressure" then assign tt-place.vapor-pressure = decimal(hText:node-value) / 1000 no-error .
     2863         IF hNoderef:NAME = "Temperature1" then assign tt-place.t1 = decimal(hText:node-value) no-error .
     2864         IF hNoderef:NAME = "Temperature2" then assign tt-place.t2 = decimal(hText:node-value) no-error .
     2865         IF hNoderef:NAME = "Temperature3" then assign tt-place.t3 = decimal(hText:node-value) no-error .
     2866       end .
     2867       RUN GetChildren(hNoderef, (level + 1)).
     2868   END.
     2869   DELETE OBJECT hNoderef.
     2870   DELETE OBJECT hText.
     2871   END PROCEDURE.
     2872   if session:debug-alert
     2873   then assign
     2874      mWriteRespFile = "asi-data.xml"
     2875      mFileLogSocet  = "asi-data.log"
     2876   .
     2877   define temp-table tt-pids no-undo
     2878     field pid as integer
     2879     index pi as primary unique
     2880       pid
     2881   .
     2882   define variable log-exit          as logical    no-undo .
     2883   define variable curl-path         as character  no-undo .
     2884   define variable v-post-file-name  as character  no-undo .
     2885   define variable v-cmd-file-name   as character  no-undo .
     2886   define variable v-command         as character  no-undo .
     2887   define variable v-out-str         as character  no-undo .
     2888   define variable v-pid-list        as character  no-undo .
     2889   define variable v-time-str        as character  no-undo .
     2890   define variable v-del-file        as character  no-undo .
     2891   define variable v-log-file-name   as character  no-undo .
     2892   define variable v-parsesub        as character  no-undo .
     2893   define variable hDoc              as handle     no-undo .
     2894   define variable hRoot             as handle     no-undo .
     2895   define variable good              as logical    no-undo .
     2896   define variable v-temp-dir        as character  no-undo .
     2897   define variable rv                as integer    no-undo .
     2898   define variable cash-recids       as character  no-undo .
     2899   define variable ii                as integer    no-undo .
     2900   define variable rid-list          as character  no-undo .
     2901   define variable v-asi-ip  as character no-undo .
     2902   define variable v-asi-port as character no-undo .
     2903   define variable v-asi-type as character no-undo .
     2904   define variable v-attr-type as character no-undo .
     2905   define variable v-date  as date no-undo init ? .
     2906   define variable v-time  as integer no-undo .
     2907   define variable v-mode    as integer no-undo .
     2908   define variable mclose        as logical no-undo .
     2909   define variable v-status  as character view-as text label "Статус" initial "" format "X(80)".
     2910   define buffer buf_clients for ub.clients .
     2911   define buffer buf_place for ub.place .
     2912   define buffer buf_pl-gds for ub.pl-gds .
     2913   define buffer buf_tt-place for tt-place .
     2914   function f-int-to-chr returns character (input v-int as integer) FORWARD.
     2915   function f-int-to-chr returns character (input v-int as integer) FORWARD.
     2916   function f-int-to-chr returns character (input v-int as integer) FORWARD.
     2917   function f-int-to-chr returns character (input v-int as integer) FORWARD.
     2918   function f-int-to-chr returns character (input v-int as integer) FORWARD.
     2919   function f-int-to-chr returns character (input v-int as integer) FORWARD.
     2920   function f-int-to-chr returns character (input v-int as integer) FORWARD.
     2921   function f-int-to-chr returns character (input v-int as integer) FORWARD.
     2922   function f-int-to-chr returns character (input v-int as integer) FORWARD.
     2923   function f-int-to-chr returns character (input v-int as integer) FORWARD.
     2924   function f-int-to-chr returns character (input v-int as integer) FORWARD.
     2925   function f-int-to-chr returns character (input v-int as integer) FORWARD.
     2926   DEFINE BUTTON b-exit AUTO-END-KEY
     2927        LABEL "Выход"
     2928        SIZE 10 BY 1
     2929        BGCOLOR 8 .
     2930   DEFINE BUTTON b-req
     2931        LABEL "Запрос"
     2932        SIZE 10 BY 1
     2933        BGCOLOR 8 .
     2934   DEFINE BUTTON b-print
     2935        LABEL "Печать"
     2936        SIZE 18 BY 1
     2937        BGCOLOR 8 .
     2938   define query br-place for tt-place scrolling .
     2939   define browse br-place
     2940     query br-place no-lock display
     2941       tt-place.loc1
     2942       f-int-to-chr(tt-place.pl-code)  label "Код резервуара"
     2943       tt-place.gds-name format "x(30)"
     2944       f-int-to-chr(tt-place.gds-code)  label "Код продукта"
     2945       tt-place.level-total
     2946       tt-place.level-water
     2947       tt-place.total-vol
     2948       tt-place.avrg-temp
     2949       tt-place.density FORMAT ">>>9.9999"
     2950       tt-place.mass
     2951       tt-place.vapor-density
     2952       tt-place.vapor-pressure
     2953   WITH NO-ROW-MARKERS SEPARATORS SIZE 143 BY 15
     2954            TITLE "Показания АСИ" FIT-LAST-COLUMN.
     2955   define stream OutStr-html.
     2956   define stream MyWatch-strm.
     2957   DEFINE FRAME Dialog-Frame
     2958        b-exit AT ROW 1.24 COL 2
     2959        b-req at row 1.24 col 12.1
     2960        b-print AT ROW 1.24 COL 93 WIDGET-ID 10
     2961        br-place at row 3 col 2
     2962        v-status at row 18 col 2
     2963        SPACE(1)
     2964       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2965            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2966            TITLE "Показания АСИ"
     2967            CANCEL-BUTTON b-exit WIDGET-ID 100.
     2968   ASSIGN
     2969          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2970          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2971   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2972   DO:
     2973     APPLY "END-ERROR":U TO SELF.
     2974   END.
     2975   ON CHOOSE OF b-req IN FRAME Dialog-Frame
     2976   DO:
     2977     run getreqAsi.
     2978     open query br-place for each tt-place indexed-reposition .
     2979     display v-status with frame Dialog-Frame .
     2980   END.
     2981   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     2982   DO:
     2983     if v-date = ?
     2984     then do :
     2985       message "Нет данных для печати!" view-as alert-box .
     2986       return no-apply .
     2987     end .
     2988     run My-Rep.
     2989     run waitfram-hide in this-procedure no-error .
     2990   END.
     2991   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     2992   DO:
     2993     for each tt-place no-lock :
     2994       v-del-file = v-temp-dir + "\asiresp_" + string(tt-place.loc1) + ".xml" .
     2995       v-del-file = search(v-del-file) .
     2996       if v-del-file = ? or trim(v-del-file) = ""
     2997       then next .
     2998       os-delete value(v-del-file) .
     2999       v-del-file = v-temp-dir + "\asireq_" + string(tt-place.loc1) + ".bat" .
     3000       v-del-file = search(v-del-file) .
     3001       if v-del-file = ? or trim(v-del-file) = ""
     3002       then next .
     3003       os-delete value(v-del-file) .
     3004     end.
     3005     run sleep (1000) .
     3006     os-delete value (search(v-temp-dir)) recursive .
     3007     assign
     3008       log-exit = true
     3009       mclose   = yes
     3010     .
     3011   END.
     3012   on row-display OF br-place IN FRAME Dialog-Frame
     3013   do:
     3014     if  tt-place.level-total    = ? then tt-place.level-total:fgcolor in browse br-place = 15 .
     3015     if  tt-place.level-water    = ? then tt-place.level-water:fgcolor in browse br-place = 15 .
     3016     if  tt-place.total-vol      = ? then tt-place.total-vol:fgcolor in browse br-place = 15 .
     3017     if  tt-place.avrg-temp      = ? then tt-place.avrg-temp:fgcolor in browse br-place = 15 .
     3018     if  tt-place.density        = ? then tt-place.density:fgcolor in browse br-place = 15 .
     3019     if  tt-place.mass           = ? then tt-place.mass:fgcolor in browse br-place = 15 .
     3020     if  tt-place.vapor-density  = ? then tt-place.vapor-density:fgcolor in browse br-place = 15 .
     3021     if  tt-place.vapor-pressure = ? then tt-place.vapor-pressure:fgcolor in browse br-place = 15 .
     3022   end.
     3023   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3024   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3025   MAIN-BLOCK:
     3026   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3027      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3028   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3029     run mainmenu_getcntxt in parparentproc
     3030       (output v-cntxt-db-num
     3031       ,output v-cntxt-userid
     3032       ,output v-cntxt-level
     3033       ,output v-cntxt-host-code-obj
     3034       ,output v-cntxt-obj-type
     3035       ,output v-cntxt-obj-code
     3036       ,output v-cntxt-db-num-obj
     3037       ,output v-cntxt-is-admin
     3038       ) .
     3039     v-log-file-name = substitute('&1rvs.log', ibs.th.gbl.gbl-inipar:logDir) .
     3040     v-temp-dir = "ASI_temp-cmd" .
     3041     os-delete value (v-temp-dir) recursive no-error .
     3042     os-create-dir value(v-temp-dir) .
     3043     run db-attr-value(v-cntxt-db-num,"AsiIp",output v-asi-ip,output v-attr-type).
     3044     run db-attr-value(v-cntxt-db-num,"AsiPort",output v-asi-port,output v-attr-type).
     3045     run db-attr-value(v-cntxt-db-num,"AsiType",output v-asi-type,output v-attr-type).
     3046     if trim(v-asi-ip) <> ''
     3047     and trim(v-asi-port) <> ''
     3048     and trim(v-asi-type) <> ''
     3049     then do :
     3050       case v-asi-type :
     3051         when "1"
     3052         then do :
     3053           v-mode = 2 .
     3054         end .
     3055         when "2"
     3056         then do :
     3057           v-mode = 3 .
     3058         end .
     3059       end case .
     3060     end .
     3061     else do :
     3062       v-mode = 1 .
     3063     end .
     3064     empty temp-table tt-pids .
     3065     assign
     3066       curl-path = search("exe/curl.exe")
     3067     .
     3068     run init-tt .
     3069     RUN enable_UI.
     3070     run getreqAsi.
     3071     open query br-place for each tt-place indexed-reposition .
     3072     if not mclose
     3073     then
     3074        WAIT-FOR GO OF FRAME Dialog-Frame.
     3075   END.
     3076   RUN disable_UI.
     3077   procedure getreqAsi:
     3078     run waitfram-show in this-procedure ("Получаем данные с АСИ ...").
     3079     case v-mode :
     3080       when 1
     3081       then do :
     3082         run get-from-struna (v-log-file-name, v-cntxt-obj-code )no-error.
     3083         if error-status:error
     3084         then do :
     3085           v-status = return-value .
     3086           message v-status
     3087           view-as alert-box.
     3088         end .
     3089         else do:
     3090            run  checkttPlace no-error.
     3091            if error-status:error
     3092            then do :
     3093              v-status = return-value .
     3094              message v-status
     3095              view-as alert-box.
     3096            end .
     3097            else do :
     3098              v-status = "Данные получены " + string(NOW).
     3099              v-date = date(now) .
     3100              v-time = time .
     3101            end.
     3102         end.
     3103       end .
     3104       when 2
     3105       then do :
     3106         run waitfram-hide in this-procedure no-error .
     3107         display v-status with frame Dialog-Frame .
     3108         run asi-send-cmd no-error .
     3109         if error-status:error
     3110         then do :
     3111           v-status = return-value .
     3112           message v-status
     3113              view-as alert-box.
     3114           display v-status with frame Dialog-Frame .
     3115         end .
     3116       end .
     3117       when 3
     3118       then do :
     3119         run get-from-ifsf (v-log-file-name,v-asi-ip,v-asi-port )no-error.
     3120         if error-status:error
     3121         then do :
     3122           v-status = return-value .
     3123           message v-status
     3124              view-as alert-box.
     3125         end .
     3126         else do:
     3127            run  checkttPlace no-error.
     3128            if error-status:error
     3129            then do :
     3130              v-status = return-value .
     3131              message v-status
     3132              view-as alert-box.
     3133            end .
     3134            else do :
     3135              v-status = "Данные получены " + string(NOW) .
     3136              v-date = date(now) .
     3137              v-time = time .
     3138            end.
     3139          end.
     3140       end .
     3141     end case .
     3142     run waitfram-hide in this-procedure no-error .
     3143     display v-status with frame Dialog-Frame .
     3144   end procedure.
     3145   define variable mFlagRes as logical no-undo.
     3146   procedure asi-send-cmd :
     3147     define variable bat-file              as character    no-undo .
     3148     define variable cmd                   as character    no-undo .
     3149     define variable v-pid                 as integer      no-undo .
     3150     define variable v-addr                as character    no-undo .
     3151     mWaitProcEvent = false.
     3152     run SendReqSocet (v-asi-ip,v-asi-port,"getmeas/?loclist=all","","xml","getResponseMy").
     3153     if oErrMsg ne ""
     3154     then do:
     3155        v-status = oErrMsg.
     3156        return.
     3157     end.
     3158     define variable mTimeOut as decimal no-undo init 180.
     3159     if     mTimeOut ne ?
     3160        and mTimeOut ne 0
     3161     then
     3162        v-status = substitute("Запрос отправлен &1 ожидаем ответ &2 секунд...", string(NOW), mTimeOut).
     3163     else
     3164        v-status = "Запрос отправлен " + string(NOW) + " ожидаем ответ..." .
     3165     mFlagRes = no.
     3166     display v-status with frame Dialog-Frame .
     3167     etime(yes).
     3168     b-req:sensitive = no.
     3169     WAIT-FOR CHOOSE OF b-exit IN FRAME Dialog-Frame or read-response of mHSocket pause mTimeOut.
     3170     b-req:sensitive = yes.
     3171     if mHSocket:connected()
     3172     then do:
     3173        mHSocket:disconnect() no-error.
     3174     end.
     3175     delete object mHSocket no-error.
     3176     if not mFlagRes
     3177     then do:
     3178        if     mTimeOut ne ?
     3179           and mTimeOut ne 0
     3180           and etime / 1000 > mTimeOut - 0.1
     3181        then
     3182           v-status = "Данные не получены. Вышло вмремя ожидания ответа".
     3183        else
     3184           v-status = "Данные не получены. Операция прервана пользователем".
     3185     end.
     3186     if mclose
     3187     then
     3188        APPLY "GO" TO FRAME Dialog-Frame.
     3189   end procedure .
     3190   procedure getResponseMy:
     3191      mFlagRes = yes.
     3192      run getResponse.
     3193      run asi-read-sts no-error .
     3194      if error-status:error
     3195      then do :
     3196        v-status = return-value .
     3197        message v-status
     3198        view-as alert-box.
     3199      end .
     3200      else do :
     3201        v-status = "Данные получены " + string(NOW) .
     3202        v-date = date(now) .
     3203        v-time = time .
     3204      end.
     3205   end.
     3206   procedure asi-read-sts :
     3207     define variable v-file    as character no-undo .
     3208     define variable err-msg as character no-undo .
     3209     if length(mWebResp) = 0
     3210     then do :
     3211       return error "Пустой ответ от агента АСИ".
     3212     end.
     3213     run parse-xml (input mWebResp) .
     3214     find first buf_tt-place no-error .
     3215     if available buf_tt-place
     3216     then
     3217     br-place:refresh () in frame Dialog-Frame no-error .
     3218     run  checkttPlace no-error.
     3219     if error-status:error
     3220     then
     3221        return error return-value.
     3222   end procedure .
     3223   procedure checkttPlace :
     3224     define variable err-msg as character no-undo.
     3225     find first buf_tt-place where buf_tt-place.locint eq ? no-error .
     3226     if available buf_tt-place
     3227     then do :
     3228       for each buf_tt-place:
     3229         if buf_tt-place.locint eq ?
     3230         then
     3231            buf_tt-place.locint = integer (buf_tt-place.loc1) no-error.
     3232       end .
     3233     end .
     3234     find first buf_tt-place where buf_tt-place.is-error no-error .
     3235     if available buf_tt-place
     3236     then do :
     3237       err-msg = "Ошибка при получении данных с резервуаров " .
     3238       for each buf_tt-place where buf_tt-place.is-error :
     3239         err-msg = err-msg + buf_tt-place.loc1 + ", " .
     3240       end .
     3241       err-msg = trim(err-msg) .
     3242       err-msg = trim(err-msg, ",") .
     3243          v-date = date(now) .
     3244          v-time = time .
     3245       return error err-msg .
     3246     end .
     3247   end.
     3248   procedure init-tt :
     3249     define variable pl-twice-code as character no-undo initial "" .
     3250     define variable v-value       as character no-undo .
     3251     define variable v-ok          as logical   no-undo .
     3252     define buffer buf_tt-place for tt-place .
     3253     for each buf_place no-lock where buf_place.obj-type = v-cntxt-obj-type
     3254                                  and buf_place.obj-code = v-cntxt-obj-code
     3255                                  and buf_place.is-meas
     3256                                  and buf_place.status_ = ""  :
     3257       find first tt-place where tt-place.loc1 = buf_place.loc1 no-error.
     3258       if not available tt-place
     3259       then do :
     3260         create tt-place .
     3261         assign
     3262           tt-place.loc1     = buf_place.loc1
     3263           tt-place.pl-code  = buf_place.pl-code
     3264           tt-place.locint   = int(buf_place.loc1)
     3265         no-error.
     3266         assign
     3267           tt-place.t1             = ?
     3268           tt-place.t2             = ?
     3269           tt-place.t3             = ?
     3270           tt-place.level-total    = ?
     3271           tt-place.level-water    = ?
     3272           tt-place.total-vol      = ?
     3273           tt-place.avrg-temp      = ?
     3274           tt-place.density        = ?
     3275           tt-place.mass           = ?
     3276           tt-place.vapor-density  = ?
     3277           tt-place.vapor-pressure = ?
     3278         .
     3279         find first buf_pl-gds no-lock where buf_pl-gds.pl-code = buf_place.pl-code no-error .
     3280         if available (buf_pl-gds) then
     3281         do:
     3282           tt-place.gds-code = buf_pl-gds.gds-code .
     3283           find first goods no-lock where goods.gds-code = tt-place.gds-code .
     3284           if available (goods)
     3285           then tt-place.gds-name = goods.gds-name .
     3286         end.
     3287       end.
     3288       run placelib_get-attr  ( input "place-twice-code"
     3289                         ,input v-cntxt-obj-code
     3290                         ,input v-cntxt-obj-type
     3291                         ,input buf_place.pl-code
     3292                         ,output v-value
     3293                         ,output v-ok      ) no-error.
     3294       if v-ok then pl-twice-code = v-value .
     3295       if trim(pl-twice-code) > ""
     3296       then do :
     3297         if num-entries(pl-twice-code) > 1
     3298         then do :
     3299           do ii = 1 to num-entries(pl-twice-code) :
     3300             find first buf_tt-place where buf_tt-place.loc1 = trim( entry( ii, pl-twice-code ) ) no-error.
     3301             if not available buf_tt-place
     3302             then do :
     3303               create buf_tt-place .
     3304             end.
     3305             assign
     3306               buf_tt-place.loc1 = trim( entry( ii, pl-twice-code ) )
     3307               buf_tt-place.locint   = int(buf_tt-place.loc1)
     3308             no-error.
     3309             assign
     3310               buf_tt-place.gds-code = tt-place.gds-code
     3311               buf_tt-place.gds-name = tt-place.gds-name
     3312             .
     3313             assign
     3314               buf_tt-place.t1             = ?
     3315               buf_tt-place.t2             = ?
     3316               buf_tt-place.t3             = ?
     3317               buf_tt-place.level-total    = ?
     3318               buf_tt-place.level-water    = ?
     3319               buf_tt-place.total-vol      = ?
     3320               buf_tt-place.avrg-temp      = ?
     3321               buf_tt-place.density        = ?
     3322               buf_tt-place.mass           = ?
     3323               buf_tt-place.vapor-density  = ?
     3324               buf_tt-place.vapor-pressure = ?
     3325             .
     3326           end.
     3327         end.
     3328         else do :
     3329           find first buf_tt-place where buf_tt-place.loc1 = pl-twice-code no-error .
     3330           if not available buf_tt-place
     3331           then do :
     3332             create buf_tt-place .
     3333           end.
     3334           assign
     3335             buf_tt-place.loc1     = pl-twice-code
     3336             buf_tt-place.locint   = int(buf_tt-place.loc1)
     3337           no-error.
     3338           .
     3339           assign
     3340             buf_tt-place.gds-code = tt-place.gds-code
     3341             buf_tt-place.gds-name = tt-place.gds-name
     3342           .
     3343           assign
     3344             buf_tt-place.t1             = ?
     3345             buf_tt-place.t2             = ?
     3346             buf_tt-place.t3             = ?
     3347             buf_tt-place.level-total    = ?
     3348             buf_tt-place.level-water    = ?
     3349             buf_tt-place.total-vol      = ?
     3350             buf_tt-place.avrg-temp      = ?
     3351             buf_tt-place.density        = ?
     3352             buf_tt-place.mass           = ?
     3353             buf_tt-place.vapor-density  = ?
     3354             buf_tt-place.vapor-pressure = ?
     3355           .
     3356         end.
     3357       end.
     3358       pl-twice-code = "" .
     3359     end.
     3360   end procedure.
     3361   procedure My-Rep:
     3362   define variable v-full-path-RepView as character no-undo.
     3363   define variable v-file-name-rep-htm as character no-undo.
     3364   define variable g#report-num as integer no-undo.
     3365   define variable v-report-name as character no-undo.
     3366   define variable Lines_Counter as integer no-undo .
     3367     run get-full-path-RepViewer(output v-full-path-RepView).
     3368     run get-report-num in parParentProc(output g#report-num).
     3369     run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
     3370     run create-file(v-file-name-rep-htm).
     3371     run waitfram-show in this-procedure ("Подождите ...").
     3372     Lines_Counter = 0 .
     3373     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     3374     put stream OutStr-html unformatted
     3375   "<!DOCTYPE HTML>" skip
     3376   ' <html>' skip
     3377   '  <head>' skip
     3378   '   <meta charset="utf-8">' skip
     3379   '    <style type="text/css">' skip
     3380   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     3381   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     3382   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black;' + chr(125) skip
     3383   '   </style>' skip
     3384   '  </head>' skip
     3385       .
     3386     put stream OutStr-html unformatted
     3387       '<body>' skip
     3388       '<TABLE name="1"  fit_to_page="true" orientation="portrait" CELLSPACING="0" BORDER="0">'skip
     3389       '<thead>' skip
     3390     .
     3391     put stream OutStr-html unformatted
     3392       '<tr>' skip
     3393       '<td style="width: 60px;"></td>' skip
     3394       '<td style="width: 60px;"></td>' skip
     3395       '<td style="width: 120px;"></td>' skip
     3396       '<td style="width: 60px;"></td>' skip
     3397       '<td style="width: 60px;"></td>' skip
     3398       '<td style="width: 60px;"></td>' skip
     3399       '<td style="width: 60px;"></td>' skip
     3400       '<td style="width: 60px;"></td>' skip
     3401       '<td style="width: 60px;"></td>' skip
     3402       '<td style="width: 60px;"></td>' skip
     3403       '<td style="width: 60px;"></td>' skip
     3404       '<td style="width: 60px;"></td>' skip
     3405       '<td style="width: 60px;"></td>' skip
     3406       '<td style="width: 60px;"></td>' skip
     3407       '<td style="width: 60px;"></td>' skip
     3408       '</tr>' skip
     3409     .
     3410     put stream OutStr-html unformatted
     3411       '<tr>' skip
     3412       '<td colspan="15" style="text-align: center; font-weight:bold;">Оперативный отчет по показаниям АСИ</td>' skip
     3413       '</tr>' skip
     3414       '<tr>' skip
     3415       '<td colspan="7" style="text-align: left; font-weight:bold;">Дата: ' + string(v-date) + '</td>' skip
     3416       '</tr>' skip
     3417       '<tr>' skip
     3418       '<td colspan="7" style="text-align: left; font-weight:bold;">Время: ' + string(v-time, 'HH:MM:SS') + '</td>' skip
     3419       '</tr>' skip
     3420       '<tr>' skip
     3421       '<td colspan="7" style="text-align: left; font-weight:bold;"><br></td>' skip
     3422       '</tr>' skip
     3423       '</thead>' skip
     3424     .
     3425     put stream OutStr-html unformatted
     3426         '     <tbody>' skip
     3427         '       <tr>' skip
     3428         '         <th style="text-align: center; font-weight:bold; background-color: silver; height: 50px">№ резервуара</th>' skip
     3429         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Код резервуара</th>' skip
     3430         '         <th style="text-align: center; font-weight:bold; background-color: silver;">НАИМЕНОВАНИЕ ПРОДУКТА</th>' skip
     3431         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Код продукта</th>' skip
     3432         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Общий уровень (см)</th>' skip
     3433         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Уровень воды (см)</th>' skip
     3434         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Общий объем (л)</th>' skip
     3435         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Средняя Т (°С)</th>' skip
     3436         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Т1 (°С)</th>' skip
     3437         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Т2 (°С)</th>' skip
     3438         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Т3 (°С)</th>' skip
     3439         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Плотность (кг/л)</th>' skip
     3440         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Масса (кг)</th>' skip
     3441         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Плотность СУГ ПФ (кг/л)</th>' skip
     3442         '         <th style="text-align: center; font-weight:bold; background-color: silver;">Давление СУГ (мПа)</th>' skip
     3443         '       </tr>' skip
     3444         '       <tr>' skip
     3445         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1.1</th>' skip
     3446         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1.2</th>' skip
     3447         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1.3</th>' skip
     3448         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1.4</th>' skip
     3449         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1.5</th>' skip
     3450         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1.6</th>' skip
     3451         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1.7</th>' skip
     3452         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1.8</th>' skip
     3453         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1.9</th>' skip
     3454         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1.10</th>' skip
     3455         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1.11</th>' skip
     3456         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1.12</th>' skip
     3457         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1.13</th>' skip
     3458         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1.14</th>' skip
     3459         '         <th num="" style="text-align: center;  font-weight:bold; background-color: silver;">1.15</th>' skip
     3460         '       </tr>' skip
     3461     .
     3462     for each tt-place no-lock :
     3463       put stream OutStr-html unformatted
     3464         '       <tr>' skip
     3465         '         <th style="text-align: center;">' + tt-place.loc1 + '</th>' skip
     3466         '         <th style="text-align: center;">' + (if tt-place.pl-code > 0 then string(tt-place.pl-code, ">>>>>>>>>>9") else " ") + '</th>' skip
     3467         '         <th style="text-align: center;">' + tt-place.gds-name + '</th>' skip
     3468         '         <th style="text-align: center;">' + (if tt-place.gds-code > 0 then string(tt-place.gds-code) else " ") + '</th>' skip
     3469         '         <th style="text-align: center;">' + (if tt-place.level-total <> ? then string(tt-place.level-total, ">>>>>9.9<<") else " ") + '</th>' skip
     3470         '         <th style="text-align: center;">' + (if tt-place.level-water <> ? then string(tt-place.level-water, ">>>>>9.9<<") else " ") + '</th>' skip
     3471         '         <th style="text-align: center;">' + (if tt-place.total-vol <> ? then string(tt-place.total-vol,   ">>>>>9.9<<") else " ") + '</th>' skip
     3472         '         <th style="text-align: center;">' + (if tt-place.avrg-temp <> ? then string(tt-place.avrg-temp,  "->>>>>9.9<<") else " ") + '</th>' skip
     3473         '         <th style="text-align: center;">' + (if tt-place.t1 <> ? then string(tt-place.t1,  "->>>>>9.9<") else " ") + '</th>' skip
     3474         '         <th style="text-align: center;">' + (if tt-place.t2 <> ? then string(tt-place.t2,  "->>>>>9.9<") else " ") + '</th>' skip
     3475         '         <th style="text-align: center;">' + (if tt-place.t3 <> ? then string(tt-place.t3,  "->>>>>9.9<") else " ") + '</th>' skip
     3476         '         <th style="text-align: center;">' + (if tt-place.density <> ? then string(tt-place.density,   ">>>>>>>>>9.9<<<<<<<<<") else " ") + '</th>' skip
     3477         '         <th style="text-align: center;">' + (if tt-place.mass <> ? then string(tt-place.mass,        ">>>>>9.9<<") else " ") + '</th>' skip
     3478         '         <th style="text-align: center;">' + (if tt-place.vapor-density <> ? then string(tt-place.vapor-density, ">>>>>>>>>9.9<<<<<<<<<") else " ") + '</th>' skip
     3479         '         <th style="text-align: center;">' + (if tt-place.vapor-pressure <> ? then string(tt-place.vapor-pressure, ">>>>>9.99999") else " ") + '</th>' skip
     3480         '       </tr>' skip
     3481       .
     3482     end.
     3483     put stream OutStr-html unformatted
     3484                   '     </tbody>' skip
     3485                   '   </table>' skip
     3486                   '  </body>' skip
     3487                   ' </html>' skip
     3488    .
     3489     output stream OutStr-html close.
     3490     output stream OutStr-html close.
     3491     run prn-lib-reportviewer-report-name in this-procedure (
     3492     input THIS-PROCEDURE
     3493     ,input v-file-name-rep-htm
     3494     ).
     3495   end procedure.
     3496   procedure get-full-path-RepViewer:
     3497       define output parameter p-fill-path-RepView as character no-undo.
     3498       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     3499       do:
     3500           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     3501       end.
     3502       else
     3503       do:
     3504           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     3505       end.
     3506   end procedure.
     3507   procedure define-full-path-Report:
     3508       define input parameter p-rep-num as integer no-undo.
     3509       define output parameter p-file-name-rep-htm as character no-undo.
     3510       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     3511   end procedure.
     3512   procedure search-full-path-Report:
     3513       define input parameter p-file-name as character no-undo.
     3514       if search(p-file-name) = ? then
     3515           do:
     3516               message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     3517           end.
     3518       else
     3519           do:
     3520               p-file-name = search(p-file-name).
     3521           end.
     3522   end procedure.
     3523   procedure Report-Viewer:
     3524       define input parameter p-full-path-RepView as character no-undo.
     3525       define input parameter p-file-name-rep-htm as character no-undo.
     3526   os-command no-wait value(p-full-path-RepView + " " + search(p-file-name-rep-htm)).
     3527   end procedure.
     3528   procedure create-file:
     3529       define input parameter p-file-name as character no-undo.
     3530       output to value(string(p-file-name)).
     3531       output close.
     3532   end procedure.
     3533   function fnc-DD-MM-YYYY returns character
     3534   (input p-dat-date as date):
     3535       define variable result as character no-undo.
     3536       define variable p-str-date as character no-undo.
     3537       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     3538           return p-str-date.
     3539   end function.
     3540   PROCEDURE disable_UI :
     3541     HIDE FRAME Dialog-Frame.
     3542   END PROCEDURE.
     3543   PROCEDURE enable_UI :
     3544     ENABLE b-exit b-req b-print br-place v-status
     3545         WITH FRAME Dialog-Frame.
     3546     VIEW FRAME Dialog-Frame.
     3547   END PROCEDURE.
     3548   PROCEDURE Sleep EXTERNAL "kernel32.DLL":
     3549     DEFINE INPUT PARAMETER intMilliseconds AS LONG.
     3550   END PROCEDURE.
