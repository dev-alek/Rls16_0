      786   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      787      DEFINE NEW GLOBAL SHARED VARIABLE hpApi AS HANDLE NO-UNDO.
      788      IF NOT VALID-HANDLE(hpApi) THEN run gbl/windows.p PERSISTENT SET hpApi.
      789   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      790   DEFINE NEW GLOBAL SHARED VARIABLE hpWinFunc AS HANDLE NO-UNDO.
      791     IF NOT VALID-HANDLE(hpWinFunc) THEN run gbl/winfunc.p PERSISTENT SET hpWinFunc.
      792   FUNCTION GetLastError
      793            RETURNS INTEGER
      794            ()
      795            IN hpWinFunc.
      796   FUNCTION GetParent
      797            RETURNS INTEGER
      798            (input hwnd as INTEGER)
      799            IN hpWinFunc.
      800   FUNCTION ShowLastError
      801            RETURNS INTEGER
      802            ()
      803            IN hpWinFunc.
      804   FUNCTION CreateProcess
      805            RETURNS INTEGER
      806            (input CommandLine as CHAR,
      807             input CurrentDir  as CHAR,
      808             input wShowWindow as INTEGER)
      809            in hpWinFunc.
      810   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      811   function IsProcessRunning return integer
      812     (PID AS INTEGER) :
      813     DEFINE VARIABLE IsRunning   AS LOGICAL NO-UNDO INITIAL NO.
      814     DEFINE VARIABLE hProcess    AS INTEGER NO-UNDO.
      815     DEFINE VARIABLE ExitCode    AS INTEGER NO-UNDO.
      816     DEFINE VARIABLE ReturnValue AS INTEGER NO-UNDO.
      817     define variable rv          as integer no-undo .
      818     RUN OpenProcess in hpapi
      819                     ( 1024,
      820                       0,
      821                       PID,
      822                       OUTPUT hProcess).
      823     IF hProcess NE 0 THEN DO:
      824        RUN GetExitcodeProcess in hpapi
      825                     ( hProcess,
      826                       OUTPUT ExitCode,
      827                       OUTPUT ReturnValue).
      828        rv = (if (ExitCode=259) AND (ReturnValue NE 0)
      829             then  - 1
      830             else ReturnValue).
      831        RUN CloseHandle in hpapi (hProcess, OUTPUT ReturnValue).
      832     END.
      833     RETURN rv.
      834   end.
      835   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      836   FUNCTION mark-string RETURNS CHARACTER
      837     ( input p-recid as recid, input mark-list as character  ) :
      838     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      839   END FUNCTION.
      840   function fnc-convert-dot-to-colon returns character
      841       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      842   function fnc-convert-dot-to-colon returns character
      843   (input p-data as decimal, input p-accur as character, input p-num as integer):
      844       define variable result as character no-undo.
      845       define variable v-str-result as character no-undo.
      846       if p-data = ? then p-data = 0 .
      847       p-data = round(p-data, p-num).
      848       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      849       return v-str-result.
      850   END FUNCTION.
