        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter par-recid as recid no-undo.
        4   define input-output parameter par-stts like ub.dis-card-mask.stts no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: dc-mask2.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: ref/dc-mask2.p $":U .
       10   define variable vss-description as character no-undo init "Изменение статуса маски дисконтной карты".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   define temp-table temp-mask-range no-undo
       82   field mask-original   like ub.dis-card-mask.mask
       83   field mask      like ub.dis-card-mask.mask
       84   field mask-num as integer
       85   field lvl-decompose as integer
       86   field host-code like ub.sysconf.host-code
       87   field obj-type like ub.clients.obj-type
       88   field obj-code like ub.clients.obj-code
       89   field first-code as decimal
       90   field last-code as decimal
       91   field to-check as logical
       92   index pi is unique mask-num lvl-decompose first-code last-code
       93   index iobj to-check first-code last-code host-code obj-type obj-code
       94   .
       95   procedure decompose-mask :
       96   define input parameter p-mask-num  like ub.dis-card-mask.mask-num no-undo .
       97   define input parameter p-mask      like ub.dis-card-mask.mask     no-undo .
       98   define input parameter p-mask-original like ub.dis-card-mask.mask     no-undo .
       99   define input parameter p-lvl-decompose  as integer no-undo .
      100   define input parameter p-host-code like ub.sysconf.host-code      no-undo .
      101   define input parameter p-obj-type  like ub.clients.obj-type       no-undo .
      102   define input parameter p-obj-code  like ub.clients.obj-code       no-undo .
      103   define variable v-ii as integer no-undo .
      104   define variable v-jj as integer no-undo .
      105   define variable v-kk as integer no-undo .
      106   define variable v-max as integer no-undo .
      107   define variable v-mask as character no-undo .
      108   define variable v-mask0 as character no-undo .
      109   define variable v-mask9 as character no-undo .
      110   define variable v-mask-char as character no-undo .
      111   define variable v-dec       as decimal no-undo .
      112     do
      113     on error undo, return error return-value
      114     :
      115       assign
      116       v-mask = p-mask
      117       v-max = length (p-mask).
      118       _do:
      119       do v-ii = 1 to v-max:
      120         assign
      121         v-mask-char = substring(p-mask, v-ii, 1)
      122         .
      123         if v-mask-char = chr(63) then do:
      124           do v-kk = 0 to 9:
      125             create temp-mask-range.
      126             assign
      127             substring(v-mask, v-ii, 1) = string(v-kk)
      128             temp-mask-range.mask     = v-mask
      129             temp-mask-range.mask-original = p-mask-original
      130             temp-mask-range.mask-num = p-mask-num
      131             temp-mask-range.host-code = p-host-code
      132             temp-mask-range.obj-type  = p-obj-type
      133             temp-mask-range.obj-code  = p-obj-code
      134             temp-mask-range.lvl-decompose = p-lvl-decompose + 1
      135             .
      136             assign
      137             v-dec = decimal(v-mask + "." ) no-error .
      138             if not error-status:error then
      139             assign
      140             temp-mask-range.first-code = decimal(v-mask + ".")
      141             temp-mask-range.last-code = decimal(v-mask + ".")
      142             temp-mask-range.to-check  = yes
      143             .
      144             else do:
      145               assign
      146               temp-mask-range.first-code = ?
      147               temp-mask-range.last-code = ?
      148               temp-mask-range.to-check  = no
      149               .
      150             end.
      151           end.
      152         end.
      153         if v-mask-char = "*":U then do:
      154           assign
      155           v-mask =  trim(v-mask, "*":U)
      156           v-mask0 = trim(v-mask, "*":U)
      157           v-mask9 = trim(v-mask, "*":U)
      158           .
      159           do v-jj = 1 to (19 - v-ii + 1) :
      160             create temp-mask-range.
      161             assign
      162             temp-mask-range.mask     = v-mask
      163             temp-mask-range.mask-original = p-mask-original
      164             temp-mask-range.mask-num = p-mask-num
      165             temp-mask-range.host-code = p-host-code
      166             temp-mask-range.obj-type  = p-obj-type
      167             temp-mask-range.obj-code  = p-obj-code
      168             temp-mask-range.lvl-decompose = p-lvl-decompose + 1
      169             v-mask  = v-mask + "0"
      170             v-mask0 = v-mask0 + "0"
      171             v-mask9 = v-mask9 + "9"
      172             .
      173             assign
      174             v-dec = decimal(v-mask0 + ".") no-error .
      175             if not error-status:error then
      176             assign
      177             temp-mask-range.first-code = decimal(v-mask0 + ".":U)
      178             temp-mask-range.last-code = decimal(v-mask9 + ".")
      179             temp-mask-range.to-check  = yes
      180             .
      181           end.
      182         end.
      183       end.
      184       for each temp-mask-range no-lock where
      185               temp-mask-range.mask-num = p-mask-num
      186           AND temp-mask-range.lvl-decompose = p-lvl-decompose + 1:
      187         if index(temp-mask-range.mask, "*":U) > 0 then
      188         run decompose-mask in this-procedure (
      189                                                  input temp-mask-range.mask-num
      190                                                 ,input temp-mask-range.mask
      191                                                 ,input temp-mask-range.mask-original
      192                                                 ,input temp-mask-range.lvl-decompose
      193                                                 ,input temp-mask-range.host-code
      194                                                 ,input temp-mask-range.obj-type
      195                                                 ,input temp-mask-range.obj-code  ).
      196       end.
      197     end.
      198   end procedure.
      199   procedure check-mask-correct-ho-join :
      200   define input parameter p-emitent-host-code like ub.dis-card-mask.emitent-host-code no-undo .
      201   define input parameter p-type              like ub.dis-card-mask.type no-undo .
      202   define input parameter p-new-mask          like ub.dis-card-mask.mask      no-undo .
      203   define input parameter p-new-host-code     like ub.dis-card-mask.host-code no-undo .
      204   define input parameter p-new-obj-type      like ub.dis-card-mask.obj-type  no-undo .
      205   define input parameter p-new-obj-code      like ub.dis-card-mask.obj-code  no-undo .
      206   define output parameter p-is-correct as logical no-undo .
      207   define variable v-found as logical no-undo .
      208   define buffer buf_temp-mask-range for temp-mask-range.
      209   define buffer buf_dis-card-mask for ub.dis-card-mask.
      210     do
      211     on error undo, return error
      212     :
      213       for each temp-mask-range:
      214         delete temp-mask-range.
      215       end.
      216       for each buf_dis-card-mask no-lock where
      217               buf_dis-card-mask.emitent-host-code = p-emitent-host-code
      218           AND buf_dis-card-mask.type = p-type
      219           AND buf_dis-card-mask.stts = integer('0':U)
      220           :
      221         if buf_dis-card-mask.use-on = integer('1':U) then NEXT.
      222         run decompose-mask in this-procedure (
      223                                                  input buf_dis-card-mask.mask-num
      224                                                 ,input buf_dis-card-mask.mask
      225                                                 ,input buf_dis-card-mask.mask
      226                                                 ,input 0
      227                                                 ,input buf_dis-card-mask.host-code
      228                                                 ,input buf_dis-card-mask.obj-type
      229                                                 ,input buf_dis-card-mask.obj-code  ).
      230       end.
      231       if p-new-mask <> "":U then do:
      232         run decompose-mask in this-procedure (
      233                                                  input 0
      234                                                 ,input p-new-mask
      235                                                 ,input p-new-mask
      236                                                 ,input 0
      237                                                 ,input p-new-host-code
      238                                                 ,input p-new-obj-type
      239                                                 ,input p-new-obj-code   ).
      240       end.
      241       for each temp-mask-range no-lock where
      242               temp-mask-range.to-check = yes
      243       break
      244       by temp-mask-range.host-code
      245       by temp-mask-range.obj-type
      246       by temp-mask-range.obj-code:
      247         for each buf_temp-mask-range where
      248                buf_temp-mask-range.to-check = yes
      249            AND
      250                (buf_temp-mask-range.first-code >= temp-mask-range.first-code
      251            AND buf_temp-mask-range.first-code <= temp-mask-range.last-code)
      252            OR
      253                (buf_temp-mask-range.last-code >= temp-mask-range.first-code
      254            AND buf_temp-mask-range.last-code <= temp-mask-range.last-code):
      255           if recid(buf_temp-mask-range) = recid(temp-mask-range) then Next.
      256           if temp-mask-range.host-code <> 0
      257           and (buf_temp-mask-range.host-code = temp-mask-range.host-code
      258           AND buf_temp-mask-range.obj-type = temp-mask-range.obj-type
      259           AND buf_temp-mask-range.obj-code = temp-mask-range.obj-code) then NEXT.
      260           assign
      261           v-found = yes.
      262           return substitute("Могут существовать номера карт, удовлетворяющих маске &1 по фирме &2 объект &3 и маске &4 по фирме &5 объект &6"
      263                              , temp-mask-range.mask-original
      264                              , temp-mask-range.host-code
      265                              , (temp-mask-range.obj-type + string(temp-mask-range.obj-code))
      266                              , buf_temp-mask-range.mask-original
      267                              , buf_temp-mask-range.host-code
      268                              , (buf_temp-mask-range.obj-type + string(buf_temp-mask-range.obj-code))
      269                                 ).
      270         end.
      271       end.
      272       assign
      273       p-is-correct = yes.
      274     end.
      275   end procedure.
      276   DEFINE VARIABLE loc#log as logical no-undo .
      277   DEFINE BUFFER bf-dis-card-mask for ub.dis-card-mask.
      278   DEFINE VARIABLE choice as logical no-undo .
      279   DEFINE VARIABLE varold-stts like ub.dis-card-mask.stts no-undo .
      280   define variable v-check-by-mask  as character no-undo .
      281   define variable v-type as character no-undo .
      282   define variable v-ok as logical no-undo .
      283   define variable v-stts-char as character no-undo .
      284   define variable dc-ri as recid no-undo .
      285   define buffer buf_dis-card for ub.dis-card.
      286   define buffer buf_Dis-card-mask for ub.dis-card-mask.
      287   define buffer buf_dis-card-type for ub.dis-card-type .
      288   define temp-table tt0-dis-card-property no-undo like ub.dis-card-property.
      289   _main:
      290   do
      291   on error undo, return error return-value
      292   :
      293   FIND FIRST bf-dis-card-mask WHERE
      294              recid(bf-dis-card-mask) = par-recid.
      295   varold-stts = bf-dis-card-mask.stts.
      296   if par-stts = ? then do:
      297     CASE varold-stts:
      298       when integer('0':U) then do:
      299         assign
      300         par-stts = integer('1':U).
      301       end.
      302       when integer('1':U) then do:
      303         assign
      304         par-stts = integer('0':U).
      305       end.
      306     END CASE.
      307   end.
      308   CASE par-stts:
      309     WHEN integer('0':U) then do:
      310       if integer('0':U) = bf-dis-card-mask.stts  then do:
      311         message "Запись уже имеет статус ТЕКУЩИЙ!"
      312         view-as alert-box ERROR.
      313         par-stts = ?.
      314         return error.
      315       end.
      316       else do:
      317         message
      318         "Запись уже удалена - восстановить?"
      319         view-as alert-box QUestion buttons YEs-no update choice.
      320       end.
      321     end.
      322     WHEN integer('1':U) then do:
      323       if integer('1':U) = bf-dis-card-mask.stts  then do:
      324         message "Запись уже имеет статус УДАЛЕН!"
      325         view-as alert-box ERROR.
      326         par-stts = ?.
      327         return error.
      328       end.
      329       else do:
      330         message
      331         "Удалить запись?"
      332         view-as alert-box QUestion buttons yes-no update choice.
      333       end.
      334     end.
      335   END CASE.
      336   if par-stts = integer('0':U) then do:
      337     find first buf_dis-card-type share-lock where
      338               buf_dis-card-type.emitent-host-code = bf-dis-card-mask.emitent-host-code
      339           and buf_dis-card-type.type = bf-dis-card-mask.type
      340           and buf_dis-card-type.host-code = 0
      341           and buf_dis-card-type.obj-type = '':U
      342           and buf_dis-card-type.obj-code = 0 .
      343     if buf_dis-card-type.check-by-mask = 1 then do:
      344       run check-mask-correct-ho-join in this-procedure (
      345                                                   input bf-dis-card-mask.emitent-host-code
      346                                                   ,input bf-dis-card-mask.type
      347                                                   ,input bf-dis-card-mask.mask
      348                                                   ,input bf-dis-card-mask.host-code
      349                                                   ,input bf-dis-card-mask.obj-type
      350                                                   ,input bf-dis-card-mask.obj-code
      351                                                   ,output v-ok
      352                                                               ) no-error .
      353       if error-status:error then do:
      354          message
      355          substitute("Нельзя восстановить маску:&1&2 &3"
      356                                , chr(10)
      357                                , error-status:get-message(1)
      358                                , return-value
      359                                 ).
      360          undo, return error .
      361       end.
      362       if not v-ok  then do:
      363         message
      364         substitute("Нельзя восстановить маску &1:&2&3"
      365                                , bf-dis-card-mask.mask
      366                                , chr(10)
      367                                , return-value
      368                                )
      369         view-as alert-box error .
      370         undo, return error .
      371       end.
      372     end.
      373   end.
      374   assign
      375   bf-dis-card-mask.stts = par-stts.
      376   if bf-dis-card-mask.cli-code <> 0 then do:
      377     find first buf_dis-card no-lock where
      378               buf_dis-card.d-card = bf-dis-card-mask.mask  no-error .
      379     if available buf_dis-card then do:
      380       for each buf_dis-card-mask no-lock where
      381               buf_Dis-card-mask.mask = bf-dis-card-mask.mask:
      382         if recid(buf_dis-card-mask) = recid(bf-dis-card-mask) then next.
      383         if varold-stts = integer('1':U)
      384         and buf_dis-card-mask.stts <> integer('0':U) then next.
      385         if varold-stts = integer('0':U)
      386         and buf_dis-card-mask.stts <> integer('0':U) then next.
      387         leave.
      388       end.
      389       if not available buf_dis-card-mask then do:
      390         CASE par-stts:
      391           when integer('1':U) then do:
      392             v-stts-char = 'удал':U.
      393           end.
      394           when integer('0':U) then do:
      395             v-stts-char = 'тек':U.
      396           end.
      397         END CASE.
      398         assign
      399         v-stts-char = v-stts-char + chr(4) + string(yes)
      400         dc-ri = recid(buf_dis-card).
      401         run ref/dcardi01.p (
      402                        input parparentproc
      403                       ,input this-procedure
      404                       ,input ?
      405                       ,input ?
      406                       ,input ?
      407                       ,input-output dc-ri
      408                       ,input 'ИЗМЕНЕНИЕ':U
      409                       ,input '':U
      410                       ,input "":U
      411                       ,input 0
      412                       ,input bf-dis-card-mask.mask
      413                       ,input bf-dis-card-mask.emitent-host-code
      414                       ,input bf-dis-card-mask.cli-type
      415                       ,input bf-dis-card-mask.cli-code
      416                       ,input v-stts-char
      417                       ,input bf-dis-card-mask.type
      418                       ,input buf_dis-card.d-pcnt
      419                       ,input buf_dis-card.cash-d-pcnt
      420                       ,input buf_dis-card.category
      421                       ,input buf_dis-card.d-pcnt-method
      422                       ,input buf_dis-card.credit-card
      423                       ,input buf_dis-card.lim-kr
      424                       ,input buf_dis-card.debet-card
      425                       ,input buf_dis-card.staff-card
      426                       ,input buf_dis-card.issue-date
      427                       ,input buf_dis-card.issue-code
      428                       ,input buf_dis-card.valid-from
      429                       ,input buf_dis-card.valid-date
      430                       ,input buf_dis-card.sourced-card
      431                       ,input buf_dis-card.cli-message
      432                       ,input yes
      433                       ,input buf_Dis-card.main-card
      434                       ,input buf_Dis-card.is-subsid
      435                       ,INPUT no
      436                       ,INPUT table tt0-dis-card-property
      437                         ) no-error.
      438         if error-status:error then do:
      439           message
      440           "Ошибка при сохранении записи КАРТЫ-МАСКИ" skip
      441           error-status:get-message(1) skip
      442           return-value
      443           view-as alert-box error .
      444           undo _main, return error.
      445         end.
      446       end.
      447     end.
      448   end.
      449   release bf-dis-card-mask no-error .
      450   if error-status:error then do:
      451     message
      452     "Ошибка при сохранении записи МАСКА ДИСКОНТНОЙ КАРТЫ" skip
      453     error-status:get-message(1) skip
      454     return-value
      455     view-as alert-box error .
      456     undo _main, return error .
      457   end.
      458   par-stts = ?.
      459   end.
