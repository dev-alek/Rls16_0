        1   DEFINE INPUT  PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   DEFINE OUTPUT PARAMETER p-obj-type AS character NO-UNDO.
        3   DEFINE OUTPUT PARAMETER p-obj-code AS integer NO-UNDO.
        4   DEFINE OUTPUT PARAMETER p-ext-obj-type AS character NO-UNDO.
        5   DEFINE OUTPUT PARAMETER p-ext-obj-code AS character NO-UNDO.
        6   DEFINE OUTPUT PARAMETER p-Ok        AS logical NO-UNDO.
        7   define variable vss-revision    as character no-undo init "$Revision$":u .
        8   define variable vss-author      as character no-undo init "$Author$":u .
        9   define variable vss-date        as character no-undo init "$Date$":u .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       11   define variable vss-archive     as character no-undo init "$Archive$":u .
       12   define variable vss-description as character no-undo init "Ввод данных для нового клиента во внешнем классификаторе Синхронизации клиентов ДИАДОК" .
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define variable ref-list as character no-undo.
      119   define variable v-rec as recid no-undo .
      120   define buffer buf_db for ub.db.
      121   DEFINE BUTTON b-choose-client
      122        IMAGE-UP FILE "btn-down-arrow":U
      123        IMAGE-DOWN FILE "btn-down-arrow":U
      124        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      125        LABEL "b-choose-client"
      126        SIZE 3 BY 1.
      127   DEFINE BUTTON b-exit AUTO-GO
      128        LABEL "&Ввод "
      129        SIZE 10 BY 1
      130        BGCOLOR 8 .
      131   DEFINE BUTTON B-help
      132        LABEL "Помо&щь"
      133        SIZE 3 BY 1
      134        BGCOLOR 8 .
      135   DEFINE BUTTON b-quit AUTO-END-KEY
      136        LABEL "&Отмена"
      137        SIZE 10 BY 1
      138        BGCOLOR 8 .
      139   DEFINE VARIABLE fi-ext-obj-code AS CHARACTER FORMAT "X(150)" INITIAL ""
      140        LABEL "ИД Диадок"
      141        VIEW-AS FILL-IN
      142        SIZE 48.5 BY 1 TOOLTIP "ИД Диадок"
      143        BGCOLOR 15 .
      144   DEFINE VARIABLE fi-obj-code AS INTEGER FORMAT ">>>>>>>>>>>9" INITIAL 0
      145        VIEW-AS FILL-IN
      146        SIZE 8.25 BY 1 TOOLTIP "код клиента"
      147        BGCOLOR 15 .
      148   DEFINE VARIABLE fi-obj-type AS CHARACTER FORMAT "X(3)"
      149        LABEL "Клиент в ТН"
      150        VIEW-AS FILL-IN
      151        SIZE 5.63 BY 1 TOOLTIP "тип клиента"
      152        BGCOLOR 15 .
      153   DEFINE FRAME d-add-ext-client
      154        b-exit AT ROW 1 COL 1
      155        b-quit AT ROW 1 COL 11
      156        B-help AT ROW 1 COL 50
      157        fi-obj-type AT ROW 2.42 COL 13 COLON-ALIGNED
      158        fi-obj-code AT ROW 2.42 COL 19.63 COLON-ALIGNED NO-LABEL WIDGET-ID 2
      159        b-choose-client AT ROW 2.42 COL 29.63
      160        fi-ext-obj-code AT ROW 3.88 COL 13 COLON-ALIGNED WIDGET-ID 4
      161        SPACE(1.87) SKIP(1.76)
      162       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      163            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      164            TITLE "Синхронизация клиентов ДИАДОК"
      165            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
      166   ASSIGN
      167          FRAME d-add-ext-client:SCROLLABLE       = FALSE
      168          FRAME d-add-ext-client:HIDDEN           = TRUE.
      169   ON GO OF FRAME d-add-ext-client
      170   DO:
      171     define buffer buf_db for ub.db .
      172     define buffer buf_clients for ub.clients.
      173     assign
      174       fi-obj-type
      175       fi-obj-code
      176       fi-ext-obj-code
      177     .
      178     find first buf_clients no-lock
      179       where buf_clients.obj-type = fi-obj-type
      180         and buf_clients.obj-code = fi-obj-code
      181       no-error.
      182     if not avail buf_clients then do:
      183       message
      184         substitute( "Не возможно найти клиента &1 &2", fi-obj-type, string( fi-obj-code ) )
      185         view-as alert-box error .
      186       apply "entry" to fi-obj-type.
      187       return no-apply.
      188     end.
      189     assign
      190       p-obj-type     = fi-obj-type
      191       p-obj-code     = fi-obj-code
      192       p-ext-obj-code = fi-ext-obj-code
      193       p-Ok = yes
      194     .
      195    END.
      196   ON WINDOW-CLOSE OF FRAME d-add-ext-client
      197   DO:
      198     APPLY "END-ERROR":U TO SELF.
      199   END.
      200   ON CHOOSE OF b-choose-client IN FRAME d-add-ext-client
      201   DO:
      202     run ref/cli-all.w
      203     ( parparentproc
      204       , input  "b-sel"
      205       , ?
      206       , ?
      207       , ?
      208       , ?
      209       , ?
      210       , ?
      211     ,output ref-list
      212     ).
      213     If ref-list <> "" then do :
      214       find first ub.clients no-lock
      215         where recid(ub.clients) = integer(ref-list) no-error.
      216       if available ub.clients then do with frame d-add-ext-client:
      217         assign
      218           fi-obj-type = ub.clients.obj-type
      219           fi-obj-code = ub.clients.obj-code
      220         .
      221         display fi-obj-type fi-obj-code.
      222       end.
      223     end.
      224   END.
      225   ON LEAVE OF fi-ext-obj-code IN FRAME d-add-ext-client
      226   DO:
      227     assign fi-ext-obj-code .
      228   END.
      229   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-add-ext-client:PARENT eq ?
      230   THEN FRAME d-add-ext-client:PARENT = ACTIVE-WINDOW.
      231   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      232   on help of frame d-add-ext-client
      233   do:
      234     run gbl/app_help.p
      235       (input this-procedure :file-name
      236       ,input ''
      237       ,input ?
      238       ) no-error.
      239     if error-status :error then do:
      240       message
      241         "Ошибка при вызове помощи"
      242         error-status :get-message(1)
      243         view-as alert-box .
      244     end.
      245   end.
      246   run minbtn-set in this-procedure .
      247   on choose of b-help in frame d-add-ext-client
      248   do:
      249     apply "help":u to frame d-add-ext-client .
      250   end.
      251   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      252   procedure minbtn-set :
      253       do
      254           on error undo, return error return-value
      255           :
      256           define variable ii              as integer       no-undo .
      257           define variable fh              as widget-handle no-undo .
      258           define variable hh              as widget-handle no-undo .
      259           define variable v-h             as handle        extent 4 no-undo .
      260           define variable v-name-button   as character     no-undo .
      261           define variable v-help-old-x    as decimal       no-undo .
      262           define variable v-help-old-y    as decimal       no-undo .
      263           define variable v-help-old-size as decimal       no-undo .
      264           define variable v-frame-width   as decimal       no-undo .
      265           define variable jj              as integer       no-undo .
      266           do
      267               on error undo, return error
      268               :
      269               assign
      270                   v-frame-width = frame d-add-ext-client:width - 0.3
      271                   fh            = frame d-add-ext-client:first-child
      272                   hh            = fh:first-child
      273                   ii            = 1
      274                   .
      275               do while valid-handle(hh):
      276                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      277                   do:
      278                       case lc(hh:name) :
      279                           when "b-help" then
      280                               do:
      281                                   hh:load-image-up("cmp/b-help.bmp":u) .
      282                                   hh:load-image-down("cmp/b-help.bmp":u) .
      283                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      284                                   hh:TOOLTIP = "Помощь" .
      285                                   v-help-old-x = hh:column .
      286                                   v-help-old-y = hh:row    .
      287                                   v-help-old-size = hh:width .
      288                                   hh:width-chars = 2.5 .
      289                               end.
      290                           when "b-print" then
      291                               do:
      292                                   hh:load-image("cmp/b-print.bmp":u) .
      293                                   hh:TOOLTIP = "Печать" .
      294                                   v-h[ii] = hh:handle .
      295                                   ii = ii + 1 .
      296                                   hh:width-chars = 3 .
      297                               end.
      298                           when "b-history" or
      299                           when "b-hist" then
      300                               do:
      301                                   hh:load-image("cmp/b-hist.bmp":u) .
      302                                   hh:TOOLTIP = "История" .
      303                                   v-h[ii] = hh:handle .
      304                                   ii = ii + 1 .
      305                                   hh:width-chars = 3 .
      306                               end.
      307                           when "b-sch" then
      308                               do:
      309                                   hh:load-image("cmp/b-sch.bmp":u) .
      310                                   hh:TOOLTIP = "Установка Фильтра" .
      311                                   v-h[ii] = hh:handle .
      312                                   ii = ii + 1 .
      313                                   hh:width-chars = 3 .
      314                               end.
      315                           when "b-hist-user" then
      316                               do:
      317                                   hh:load-image("cmp/b-hist.bmp":u) .
      318                                   hh:TOOLTIP = "История пользователя" .
      319                                   ii = ii + 1 .
      320                               end.
      321                       end case.
      322                   end.
      323                   hh = hh:next-sibling.
      324               end.
      325               b-help:column = v-frame-width - b-help:width-chars.
      326               jj = 0.
      327               repeat ii = 4 to 1 by -1 :
      328                   if valid-handle (v-h[ii] ) then
      329                   do:
      330                       jj  = jj + 1 .
      331                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      332                       v-h[ii]:row    = v-help-old-y .
      333                   end.
      334               end.
      335           end.
      336       end.
      337   end procedure.
      338   MAIN-BLOCK:
      339   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      340      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      341     RUN MyEnable.
      342     WAIT-FOR GO OF FRAME d-add-ext-client.
      343   END.
      344   RUN disable_UI.
      345   PROCEDURE disable_UI :
      346     HIDE FRAME d-add-ext-client.
      347   END PROCEDURE.
      348   PROCEDURE enable_UI :
      349     DISPLAY fi-obj-type fi-obj-code fi-ext-obj-code
      350         WITH FRAME d-add-ext-client.
      351     ENABLE b-exit b-quit B-help fi-obj-type fi-obj-code b-choose-client
      352            fi-ext-obj-code
      353         WITH FRAME d-add-ext-client.
      354     VIEW FRAME d-add-ext-client.
      355   END PROCEDURE.
      356   PROCEDURE MyEnable :
      357       DISPLAY
      358       fi-obj-type fi-obj-code fi-ext-obj-code
      359       WITH FRAME d-add-ext-client.
      360     ENABLE
      361     B-exit
      362     B-quit
      363     B-Help
      364     fi-obj-type fi-obj-code b-choose-client fi-ext-obj-code
      365     WITH FRAME d-add-ext-client.
      366     VIEW FRAME d-add-ext-client.
      367   END PROCEDURE.
