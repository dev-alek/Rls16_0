       91   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   define temp-table temp-drt-prop no-undo like ub.drt-prop.
       93   procedure disrules-fill-properties:
       94   define input  parameter p-templ-rl-root as integer   no-undo .
       95   define buffer buf_drt-prop for ub.drt-prop.
       96   define buffer buf_temp-drt-prop for temp-drt-prop.
       97   do
       98   on error undo, return error return-value
       99   :
      100     for each buf_temp-drt-prop:
      101       delete buf_temp-drt-prop.
      102     end.
      103     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      104       create buf_temp-drt-prop.
      105       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      106     end.
      107   end.
      108   end procedure.
      109   ~
      110   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111   procedure discfgru-check :
      112   define input parameter p-table-name as character no-undo .
      113   define input parameter p-templ-rl-root as integer no-undo .
      114   define input parameter p-time-templ-rl-root as integer no-undo .
      115   define input parameter p-pos-type as character no-undo .
      116   define output parameter p-disnct-role as character no-undo .
      117   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      118     do
      119     on error undo, return error return-value
      120     :
      121       find first buf_dis-cfg-rule no-lock where
      122               buf_dis-cfg-rule.table-name = p-table-name
      123           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      124           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      125           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      126       if not available buf_dis-cfg-rule
      127       or p-pos-type = "":U
      128       then do:
      129          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      130                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      131                                  , p-templ-rl-root
      132                                  , (if p-time-templ-rl-root = ?
      133                                     then '':U
      134                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      135                                     )
      136                                  ).
      137       end.
      138       assign
      139       p-disnct-role = buf_dis-cfg-rule.discnt-role
      140       .
      141     end.
      142   end procedure.
      143   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      144   FUNCTION get-region RETURNS CHARACTER
      145     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      146     define variable par-region as character no-undo.
      147     if parhost-code = 0 and
      148          parobj-type = "":U and
      149          parobj-code = 0 then do:
      150          par-region = "Глобально".
      151          return par-region.
      152       end.
      153       if parobj-type = 'орг':U then do:
      154          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      155          return par-region.
      156       end.
      157       if parobj-type = 'регион':U
      158       then do:
      159          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      160          return par-region.
      161       end.
      162       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      163       return par-region.
      164   END FUNCTION.
      165   FUNCTION get-objregion RETURNS CHARACTER
      166     (  input parobj-type as character, input parobj-code as integer ) :
      167     define variable par-region as character no-undo.
      168     if  parobj-type = "":U and
      169         parobj-code = 0
      170     then do:
      171        par-region = "Глобально".
      172     end.
      173     else if parobj-type = 'орг':U
      174     then do:
      175        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      176     end.
      177     else if parobj-type = 'регион':U
      178     then do:
      179        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      180     end.
      181     else
      182        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      183     return par-region.
      184   END FUNCTION.
      185   procedure disdcrul-name :
      186   define buffer buf_dis-rule for ub.dis-rule.
      187   do
      188     on error undo, return error
      189     :
      190     define input  parameter p-templ-rl-root  as integer no-undo .
      191     define output parameter p-label          as character no-undo .
      192     find first buf_dis-rule no-lock where
      193               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      194     if available buf_dis-rule then do:
      195       if buf_dis-rule.rule-num > 0 then
      196       p-label = buf_dis-rule.des.
      197     end.
      198     else do:
      199       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
      200     end.
      201   end.
      202   end procedure.
      203   function disdcrul-get-disc-label returns character ( input p-templ-rl-root as integer):
      204   define variable v-rule-label as character no-undo .
      205   run disdcrul-name in this-procedure ( input p-templ-rl-root
      206                                        ,output v-rule-label) no-error.
      207   return v-rule-label.
      208   end function.
      209   function disdcrul-get-disc-role-label returns character ( input p-discnt-role as character):
      210   define variable v-rule-label as character no-undo .
      211   return entry (lookup (p-discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u).
      212   end function.
      213   procedure disdcrul-write :
      214     do
      215     on error undo, return error
      216     :
      217       define input parameter p-d-card         like ub.dis-dc-rule.d-card     no-undo .
      218       define input parameter p-host-code      like ub.dis-dc-rule.host-code  no-undo .
      219       define input parameter p-obj-type       like ub.dis-dc-rule.obj-type   no-undo .
      220       define input parameter p-obj-code       like ub.dis-dc-rule.obj-code   no-undo .
      221       define input parameter p-pos-type       like ub.dis-dc-rule.pos-type   no-undo .
      222       define input parameter p-discnt-role    like ub.dis-dc-rule.discnt-role no-undo .
      223       define input parameter p-templ-rl-root  like ub.dis-dc-rule.templ-rl-root  no-undo .
      224       define input parameter p-time-templ-rl-root  like ub.dis-dc-rule.time-templ-rl-root  no-undo .
      225       define input parameter p-rule-num       like ub.dis-dc-rule.rule-num    no-undo .
      226       define input parameter p-nonunique      like ub.dis-dc-rule.nonunique   no-undo .
      227       define buffer buf_dis-rule for ub.dis-rule.
      228       define buffer buf_dis-dc-rule for ub.dis-dc-rule .
      229       define buffer lock_dis-dc-rule for ub.dis-dc-rule .
      230       define variable v-label          as character no-undo .
      231       define variable v-discnt-role as character no-undo .
      232       run discfgru-check in this-procedure (
      233                                             input 'dis-dc-rule':U
      234                                            ,input p-templ-rl-root
      235                                            ,input p-time-templ-rl-root
      236                                            ,input p-pos-type
      237                                            ,output v-discnt-role
      238                                             ) no-error .
      239       if error-status :error then do:
      240         undo, return error return-value .
      241       end.
      242       if p-discnt-role = ? then do:
      243         p-discnt-role = v-discnt-role.
      244       end.
      245       if p-discnt-role <> v-discnt-role then do:
      246         undo, return error substitute("ДК &1 Фирма &2 &3&4 место использ. &5 скидка типа &6&7не может быть по шаблону &8 и расписанию &9"
      247                                 ,p-d-card
      248                                 ,p-host-code
      249                                 ,p-obj-type
      250                                 ,p-obj-code
      251                                 ,p-pos-type
      252                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      253                                 ,chr(10)
      254                                 ,p-templ-rl-root
      255                                 ,p-rule-num).
      256       end.
      257       if p-pos-type = ? then do:
      258   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      259   define variable v-param-type5 as character no-undo .
      260   define variable v-value-date5 as date no-undo .
      261   define variable v-value-decimal5 as decimal no-undo .
      262   define variable v-value-integer5 as INTEGER no-undo .
      263   define variable v-value-logical5 AS LOGICAL no-undo .
      264   define variable v-tth5 as handle no-undo .
      265   run adm/shattri.p (
      266       input "get":U
      267       ,input  p-obj-type
      268       ,input  p-obj-code
      269       ,input  'cd-sending':U
      270       ,input  'dflt-cd':U
      271       ,output p-pos-type
      272       ,output v-value-date5
      273       ,output v-value-decimal5
      274       ,output v-value-integer5
      275       ,output v-value-logical5
      276       ,output v-param-type5
      277       ,INPUT-OUTPUT table-handle v-tth5
      278       )  .
      279   delete object v-tth5 no-error.
      280       end.
      281       find first buf_dis-rule no-lock where
      282                 buf_dis-rule.rule-num = p-rule-num no-error.
      283       if not available buf_Dis-rule then do:
      284         undo, return error substitute("ДК &1 Фирма &2 &3&4 место использ. &5 скидка типа &6&7не найдено правило скидки &8"
      285                                 ,p-d-card
      286                                 ,p-host-code
      287                                 ,p-obj-type
      288                                 ,p-obj-code
      289                                 ,p-pos-type
      290                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      291                                 ,chr(10)
      292                                 ,p-rule-num).
      293       end.
      294       if buf_dis-rule.root <> yes then do:
      295         undo, return error substitute("ДК &1 Фирма &2 &3&4 место использ. &5 скидка типа &6&7правило скидки &8 - некорневое"
      296                                 ,p-d-card
      297                                 ,p-host-code
      298                                 ,p-obj-type
      299                                 ,p-obj-code
      300                                 ,p-pos-type
      301                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      302                                 ,chr(10)
      303                                 ,p-rule-num).
      304       end.
      305       if not (p-host-code = buf_dis-rule.host-code
      306           and p-obj-type = buf_dis-rule.obj-type
      307           and p-obj-code = buf_dis-rule.obj-code)
      308       then do:
      309         undo, return error (substitute("ДК &1 Фирма &2 &3&4 место использ. &5 скидка типа &6&7правило скидки &8 - некорневое"
      310                                 ,p-d-card
      311                                 ,p-host-code
      312                                 ,p-obj-type
      313                                 ,p-obj-code
      314                                 ,p-pos-type
      315                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      316                                 ,chr(10)
      317                                 )
      318                             +
      319                             substitute("Правило скидки &1 определено для &2&3" +
      320                                        "а привязка к ДК для &4"
      321                                        ,buf_dis-rule.rule-num
      322                                        ,get-region( buf_Dis-rule.host-code, buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
      323                                        ,chr(10)
      324                                        ,get-region( p-host-code, p-obj-type, p-obj-code)
      325                                        ))
      326                                 .
      327       end.
      328       find first buf_dis-dc-rule exclusive-lock where
      329                  buf_dis-dc-rule.d-card  = p-d-card
      330              AND buf_dis-dc-rule.obj-type  = p-obj-type
      331              AND buf_dis-dc-rule.host-code = p-host-code
      332              AND buf_dis-dc-rule.obj-code  = p-obj-code
      333              AND buf_dis-dc-rule.pos-type  = p-pos-type
      334              AND buf_dis-dc-rule.discnt-role = p-discnt-role
      335              and buf_dis-dc-rule.nonunique = p-nonunique
      336              no-error .
      337       if not available buf_dis-dc-rule then do:
      338         create buf_dis-dc-rule .
      339         assign
      340         buf_dis-dc-rule.d-card  = p-d-card
      341         buf_dis-dc-rule.host-code  = p-host-code
      342         buf_dis-dc-rule.obj-type  = p-obj-type
      343         buf_dis-dc-rule.obj-code  = p-obj-code
      344         buf_dis-dc-rule.pos-type = p-pos-type
      345         buf_dis-dc-rule.discnt-role = v-discnt-role
      346         buf_dis-dc-rule.rule-num = p-rule-num
      347         buf_dis-dc-rule.nonunique = p-nonunique
      348         no-error
      349         .
      350       end.
      351       ASSIGN
      352       buf_dis-dc-rule.time-templ-rl-root = p-time-templ-rl-root
      353       buf_dis-dc-rule.rule-num = p-rule-num
      354       buf_dis-dc-rule.rl-root = buf_Dis-rule.rl-root
      355       buf_dis-dc-rule.templ-rl-root = p-templ-rl-root
      356       buf_dis-dc-rule.nonunique = p-nonunique
      357       no-error.
      358     end.
      359   end procedure.
      360   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   define shared temp-table dc-list no-undo like ub.dis-card
      362     field to-del as logical
      363     field order-num as integer
      364     field fdec as decimal
      365     field fint as integer
      366     field flog as logical
      367     field fchar as character
      368     index pi  is primary unique d-card
      369     index cn      card-num
      370     index cli cli-type cli-code
      371     index host-dscnt  emitent-host-code status_ d-pcnt
      372     index host-type  emitent-host-code type d-pcnt
      373     index oi order-num
      374     .
      375   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   define  shared  temp-table dc-list-hist no-undo
      377   field list-table as character
      378   field id as integer
      379   field line as integer
      380   field hist-mode as character
      381   field des as character
      382   field num-recs as integer
      383   field option_ as character
      384   field item_ as character
      385   field status_ as character
      386   field num-add as integer
      387   field num-ignored as integer
      388   field done as logical
      389   field err_ as logical
      390   field err-mes as character
      391   index pi is primary
      392   id
      393   line
      394   index isdone
      395   done
      396   .
      397   define variable p-host-code like ub.clients.host-code no-undo .
      398   define variable p-obj-type like ub.clients.obj-type no-undo .
      399   define variable p-obj-code like ub.clients.obj-code no-undo .
      400   define variable pardelete-ok as logical no-undo .
      401   DEFINE VARIABLE var-object as character no-undo init 'dis-dc-rule':U.
      402   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      403   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
      404   def var vl_bin as char no-undo init "".
      405   if vl_int < 0 OR vl_int = ? then return ?.
      406   do while vl_int > 0:
      407     assign
      408     vl_bin = (if vl_int modulo 2 = 0
      409                 then "0":U
      410                 else "1":U) + vl_bin
      411     vl_int = truncate(vl_int / 2,0).
      412   end.
      413   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
      414   END FUNCTION.
      415   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
      416                                    input vl_binm as character):
      417   DEFINE VARIABLE vl_bin as character no-undo.
      418   DEFINE VARIABLE ii as integer no-undo.
      419   DEFINE VARIABLE ii-len as integer no-undo.
      420   DEFINE VARIABLE ii-lenm as integer no-undo.
      421   DEFINE VARIABLE mchar as character no-undo.
      422   DEFINE VARIABLE ichar as character no-undo.
      423   if vl_binm = ? then return ?.
      424   vl_bin = CIntBinS(vl_int).
      425   if vl_bin = ? then return ?.
      426   assign
      427   vl_binm = LEFT-TRIM(vl_binm, "X":U)
      428   ii-lenm = LENGTH(vl_binm)
      429   ii-len = LENGTH(vl_bin) - ii-lenm
      430   .
      431   if II-LENM > 32 THEN RETURN ?.
      432   DO II = 1 to II-LENm:
      433     assign
      434     mchar = SUBSTR(vl_binm, ii, 1)
      435     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
      436     .
      437     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
      438     IF ichar <> mchar AND mchar <> "X":U then return no.
      439   END.
      440   return yes.
      441   END FUNCTION.
      442   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      443   define SHARED temp-table temp-disc no-undo
      444   field rule-num as integer
      445   field host-code as integer
      446   field obj-type as character
      447   field obj-code as integer
      448   field templ-rl-root as integer
      449   field time-templ-rl-root as integer
      450   field discnt-role as character
      451   field nonunique as character
      452   field cfg-nonunique as character
      453   field pos-type as character
      454   field action as logical
      455   field label_ as character
      456   index pi is  unique primary
      457   pos-type discnt-role nonunique host-code obj-type obj-code action ASCENDING
      458   index action
      459   action
      460   index ipos
      461   pos-type discnt-role
      462   .
      463   procedure temp-dsc-value :
      464   define input  parameter p-pos-type  as character  no-undo .
      465   define input  parameter p-templ-rl-root as integer  no-undo .
      466   define input  parameter p-time-templ-rl-root as integer no-undo .
      467   define input  parameter p-discnt-role  as character  no-undo .
      468   define input  parameter p-cfg-nonunique as character no-undo .
      469   define input  parameter p-host-code as integer no-undo .
      470   define input  parameter p-obj-type  as character no-undo .
      471   define input  parameter p-obj-code as integer no-undo .
      472   define input  parameter p-0mode as character no-undo .
      473   define input  parameter p-mode      as character no-undo .
      474   define input  parameter p-rec as recid no-undo .
      475   define output parameter p-rule-num    as integer no-undo .
      476   define output parameter p-nonunique   as character no-undo .
      477   define buffer buf_temp-disc for temp-disc .
      478   define variable v-discnt-role as character no-undo .
      479   define variable v-rule-num as integer no-undo .
      480   define variable v-nonunique as character no-undo .
      481   define variable v-templ-rl-root as integer no-undo .
      482   define variable v-time-templ-rl-root as integer no-undo .
      483   define variable v-setted         as logical   no-undo .
      484   define variable choice as integer no-undo .
      485   do
      486   on error undo, return error
      487   :
      488     case var-object:
      489       when 'dis-gds-rule':U
      490       then do:
      491         run discfgru-check  in this-procedure (
      492                                                  input 'dis-gds-rule':U
      493                                                 ,input p-templ-rl-root
      494                                                 ,input p-time-templ-rl-root
      495                                                 ,input p-pos-type
      496                                                 ,output v-discnt-role) no-error.
      497       end.
      498       when 'dis-dc-rule':U then do:
      499         run discfgru-check  in this-procedure (
      500                                                  input 'dis-dc-rule':U
      501                                                 ,input p-templ-rl-root
      502                                                 ,input p-time-templ-rl-root
      503                                                 ,input p-pos-type
      504                                                 ,output v-discnt-role) no-error.
      505       end.
      506       when 'dis-cp-rule':U then do:
      507         run discfgru-check  in this-procedure (
      508                                                  input 'dis-cp-rule':U
      509                                                 ,input p-templ-rl-root
      510                                                 ,input p-time-templ-rl-root
      511                                                 ,input p-pos-type
      512                                                 ,output v-discnt-role) no-error.
      513       end.
      514       otherwise do:
      515         undo, return error .
      516       end.
      517     end case.
      518     if error-status :error
      519     then do:
      520       undo, return error return-value .
      521     end.
      522     if p-mode = "change":U
      523     then do:
      524       if p-rec <> ? then do:
      525         find first buf_temp-disc no-lock where
      526               recid(buf_temp-disc) = p-rec
      527           no-error .
      528       end.
      529       else do:
      530         find first buf_temp-disc no-lock where
      531                   buf_temp-disc.pos-type = p-pos-type
      532               and buf_temp-disc.discnt-role = p-discnt-role
      533               and buf_temp-disc.nonunique  = p-nonunique
      534               and buf_temp-disc.host-code = p-host-code
      535               and buf_temp-disc.obj-type = p-obj-type
      536               and buf_temp-disc.obj-code = p-obj-code
      537           no-error .
      538       end.
      539       if avail buf_temp-disc then do:
      540         assign
      541         v-rule-num =  buf_temp-disc.rule-num
      542         v-nonunique = buf_temp-disc.nonunique
      543         v-templ-rl-root = buf_temp-disc.templ-rl-root
      544         v-time-templ-rl-root = buf_temp-disc.time-templ-rl-root
      545         .
      546       end.
      547     end.
      548     CASE var-object:
      549     END CASE.
      550     if v-setted = no then do:
      551       return "not-set":U.
      552     end.
      553     p-rule-num = v-rule-num.
      554     p-nonunique = v-nonunique.
      555   end.
      556   end procedure.
      557   procedure temp-dsc-write :
      558     do
      559     on error undo, return error
      560     :
      561       define input parameter p-add      as logical no-undo .
      562       define input parameter p-pos-type as character  no-undo .
      563       define input parameter p-templ-rl-root as integer  no-undo .
      564       define input parameter p-time-templ-rl-root as integer  no-undo .
      565       define input parameter p-discnt-role as character  no-undo .
      566       define input parameter p-cfg-nonunique as character no-undo .
      567       define input parameter p-host-code as integer no-undo .
      568       define input parameter p-obj-type as character no-undo .
      569       define input parameter p-obj-code as integer no-undo .
      570       define input parameter p-rule-num  as integer no-undo .
      571       define input parameter p-action   like temp-disc.action no-undo .
      572       define input-output parameter p-rec as recid no-undo .
      573       define buffer buf_temp-disc for temp-disc .
      574       define variable v-discnt-role as character no-undo .
      575       define variable varhost-code like ub.clients.host-code no-undo.
      576       define variable varobj-type like ub.clients.obj-type no-undo.
      577       define variable varobj-code like ub.clients.obj-code no-undo.
      578       define variable choice as integer no-undo .
      579       define var loc#log as logical no-undo.
      580       define variable loc-action as logical no-undo.
      581       define variable v-nonunique as character no-undo .
      582       define buffer buf_dis-rule for ub.dis-rule.
      583       case var-object:
      584         when 'dis-gds-rule':U
      585         then do:
      586           run discfgru-check  in this-procedure (
      587                                                   input 'dis-gds-rule':U
      588                                                  ,input p-templ-rl-root
      589                                                  ,input p-time-templ-rl-root
      590                                                  ,input p-pos-type
      591                                                  ,output v-discnt-role) no-error.
      592         end.
      593         when 'dis-dc-rule':U
      594         then do:
      595           run discfgru-check  in this-procedure (
      596                                                   input 'dis-dc-rule':U
      597                                                  ,input p-templ-rl-root
      598                                                  ,input p-time-templ-rl-root
      599                                                  ,input p-pos-type
      600                                                  ,output v-discnt-role) no-error.
      601         end.
      602         when 'dis-cp-rule':U
      603         then do:
      604           run discfgru-check  in this-procedure (
      605                                                   input 'dis-cp-rule':U
      606                                                  ,input p-templ-rl-root
      607                                                  ,input p-time-templ-rl-root
      608                                                  ,input p-pos-type
      609                                                  ,output v-discnt-role) no-error.
      610         end.
      611         otherwise do:
      612           undo, return error .
      613         end.
      614       END CASE.
      615       if error-status :error then do:
      616         undo, return error return-value .
      617       end.
      618       if p-cfg-nonunique <> '':U
      619       and p-rule-num <> 0
      620       and p-rule-num <> ?
      621       then do:
      622         find first buf_dis-rule no-lock where
      623                 buf_dis-rule.rule-num = p-rule-num no-error.
      624         if not available buf_dis-rule then do:
      625           undo, return error substitute("Не найдено правило скидок &1", p-rule-num).
      626         end.
      627         assign
      628         v-nonunique = (if p-cfg-nonunique = '':U
      629                       then '':U
      630                       else (if p-cfg-nonunique begins "@"
      631                             then left-trim(p-cfg-nonunique, "@")
      632                             else string(buffer buf_Dis-rule:handle:buffer-field(p-cfg-nonunique):buffer-value)
      633                             ))
      634         .
      635       end.
      636       if p-rec <> ? then do:
      637         find first buf_temp-disc exclusive-lock where
      638                   recid(buf_temp-disc) = p-rec no-error .
      639       end.
      640       else do:
      641         find first buf_temp-disc exclusive-lock where
      642                   buf_temp-disc.pos-type = p-pos-type
      643                 and buf_temp-disc.discnt-role = p-discnt-role
      644                 and buf_temp-disc.host-code = p-host-code
      645                 and buf_temp-disc.obj-type = p-obj-type
      646                 and buf_temp-disc.obj-code = p-obj-code
      647                 and buf_temp-disc.nonunique = v-nonunique
      648                 no-error .
      649       end.
      650       if not available buf_temp-disc then do:
      651         create buf_temp-disc .
      652         assign
      653         buf_temp-disc.host-code = p-host-code
      654         buf_temp-disc.obj-type = p-obj-type
      655         buf_temp-disc.obj-code = p-obj-code
      656         buf_temp-disc.rule-num = p-rule-num
      657         buf_temp-disc.action = p-action
      658         buf_temp-disc.pos-type = p-pos-type
      659         buf_temp-disc.discnt-role = p-discnt-role
      660         buf_temp-disc.cfg-nonunique = p-cfg-nonunique
      661         buf_temp-disc.rule-num = p-rule-num
      662         buf_temp-disc.nonunique = v-nonunique
      663         buf_temp-disc.time-templ-rl-root = p-time-templ-rl-root
      664         buf_temp-disc.templ-rl-root = p-templ-rl-root
      665         p-rec = recid(buf_temp-disc)
      666         no-error
      667         .
      668       end.
      669       ELSE do:
      670         if p-add then do:
      671            message
      672            substitute("Такая скидка уже добавлена&1"
      673                       ,chr(10)
      674                   )
      675            view-as alert-box error .
      676           undo, return error "not-set" .
      677         end.
      678         ASSIGN
      679         buf_temp-disc.rule-num = p-rule-num
      680         buf_temp-disc.nonunique = v-nonunique
      681         buf_temp-disc.time-templ-rl-root = p-time-templ-rl-root
      682         buf_temp-disc.templ-rl-root = p-templ-rl-root
      683         p-rec = recid(buf_temp-disc)
      684         no-error.
      685       end.
      686     end.
      687   end procedure.
      688   procedure temp-dsc-exist :
      689   define input parameter p-pos-type as character  no-undo .
      690   define input parameter p-templ-rl-root as integer  no-undo .
      691   define input parameter p-time-templ-rl-root as integer no-undo .
      692   define input parameter p-discnt-role as character  no-undo .
      693   define input parameter p-nonunique as character no-undo .
      694   define input parameter p-host-code as integer no-undo .
      695   define input parameter p-obj-type as character no-undo .
      696   define input parameter p-obj-code as integer no-undo .
      697   define output parameter p-exist    as logical no-undo .
      698   define output parameter p-action as logical no-undo .
      699   define variable v-discnt-role as character no-undo .
      700   define buffer buf_temp-disc for temp-disc .
      701     do
      702     on error undo, return error
      703     :
      704       case var-object:
      705         when 'dis-gds-rule':U then do:
      706           run discfgru-check  in this-procedure (
      707                                                   input 'dis-gds-rule':U
      708                                                  ,input p-templ-rl-root
      709                                                  ,input p-time-templ-rl-root
      710                                                  ,input p-pos-type
      711                                                  ,output v-discnt-role) no-error.
      712         end.
      713         when 'dis-dc-rule':U then do:
      714           run discfgru-check  in this-procedure (
      715                                                   input 'dis-dc-rule':U
      716                                                  ,input p-templ-rl-root
      717                                                  ,input p-time-templ-rl-root
      718                                                  ,input p-pos-type
      719                                                  ,output v-discnt-role) no-error.
      720         end.
      721         otherwise do:
      722           undo, return error .
      723         end.
      724       end case.
      725       if error-status :error
      726       then do:
      727         undo, return error return-value .
      728       end.
      729       find first buf_temp-disc no-lock where
      730                  buf_temp-disc.pos-type = p-pos-type
      731               and buf_temp-disc.discnt-role = p-discnt-role
      732               and buf_temp-disc.host-code = p-host-code
      733               and buf_temp-disc.obj-type = p-obj-type
      734               and buf_temp-disc.obj-code = p-obj-code
      735               and buf_temp-disc.nonunique = p-nonunique no-error .
      736       if available buf_temp-disc then do:
      737         P-EXIST = YES.
      738         p-action = buf_temp-disc.action.
      739       end.
      740     end.
      741   end procedure.
      742   procedure temp-dsc-delete :
      743   define input parameter p-pos-type as character  no-undo .
      744   define input parameter p-discnt-role as character no-undo .
      745   define input parameter p-nonunique as character no-undo .
      746   define input parameter p-host-code  as integer no-undo .
      747   define input parameter p-obj-type as character no-undo .
      748   define input parameter p-obj-code as integer no-undo .
      749   define input parameter p-action as logical no-undo .
      750   define output parameter p-deleted  as logical no-undo .
      751   define buffer buf_temp-disc for temp-disc .
      752     do
      753     on error undo, return error :
      754       case var-object:
      755         when 'dis-gds-rule':U
      756         then do:
      757           error-status:error = no.
      758         end.
      759         when 'dis-dc-rule':U
      760         then do:
      761           error-status:error = no.
      762         end.
      763         when 'dis-cp-rule':U
      764         then do:
      765           error-status:error = no.
      766         end.
      767         otherwise do:
      768           undo, return error .
      769         end.
      770       END CASE.
      771       if error-status :error then do:
      772         undo, return error return-value .
      773       end.
      774       find first buf_temp-disc exclusive-lock where
      775                  buf_temp-disc.pos-type = p-pos-type
      776              and buf_temp-disc.discnt-role = p-discnt-role
      777              and buf_temp-disc.host-code = p-host-code
      778              and buf_temp-disc.obj-type = p-obj-type
      779              and buf_temp-disc.obj-code = p-obj-code
      780              and buf_temp-disc.nonunique = p-nonunique
      781              and buf_temp-disc.action = p-action
      782              no-error .
      783       if not available buf_temp-disc then do:
      784         P-DELETED = NO.
      785       end.
      786       ELSE DO:
      787          delete buf_temp-disc.
      788          P-DELETED = YES.
      789       END.
      790     end.
      791   end procedure.
      792   define variable v-no-ask as logical no-undo .
      793   define variable v-view-log as logical no-undo .
      794   define variable log-file-name                as character      no-undo init "ddcr-lst.txt".
      795   define variable v-stop                       as logical        no-undo .
      796   define variable v-choice as integer no-undo .
      797   DEFINE VARIABLE num-rec as integer no-undo .
      798   DEFINE VARIABLE num-rec-ok as integer no-undo .
      799   define variable v-mes as character no-undo .
      800   assign
      801   p-host-code = integer(entry(1, p-parameter, chr(4)))
      802   p-obj-type  = entry(2, p-parameter, chr(4))
      803   p-obj-code = integer(entry(3, p-parameter, chr(4)))
      804   pardelete-ok = logical(entry(4, p-parameter, chr(4)))
      805   no-error
      806   .
      807   if error-status:error then do:
      808    run write-log-and-file in p-log-handle (
      809           input 1
      810         , input log-file-name
      811         , input 1
      812         , input substitute("Ошибка входных параметров &1:&2&3&4"
      813                            , p-parameter
      814                            , chr(10)
      815                            , error-status:get-message(1)
      816                            , return-value
      817                            )).
      818     assign
      819     v-view-log = yes.
      820   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      821   if v-view-log
      822   and not g#news
      823   and not g#auto
      824   then do:
      825     message
      826     '!!!При изменении скидок по отдельным ДК по списку произошли ошибки!!!'  skip
      827     "!!!Внимательно прочитайте Log-file!!"
      828     view-as alert-box error .
      829        define variable v-user-action11   as character no-undo .
      830     define variable v-printed11       as logical   no-undo .
      831     run gbl/prnfilen.w
      832       (input  ('!!!При изменении скидок по отдельным ДК по списку произошли ошибки!!!')
      833       ,input  0
      834       ,input  (string("./":U) + 'ddcr-lst.txt')
      835       ,input  7
      836       ,output v-user-action11
      837       ,output v-printed11
      838       ) .
      839   end.
      840   if v-view-log = true
      841   and (g#news
      842   or g#auto)
      843   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      844   then do:
      845      run cb_set-view-log in p-parent-handle ( input yes).
      846   end.
      847   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
      848     OS-DELETE value(string("./":U) + 'ddcr-lst.txt').
      849   end.
      850     return .
      851   end.
      852   run write-log  in p-log-handle(
      853                                    input 0
      854                                  , "&DLine").
      855   run write-log-and-file in p-log-handle (
      856         input 1
      857       , input log-file-name
      858       , input 1
      859       , input substitute("Изменение скидок товара на объекте &1&2 по списку товаров", p-obj-type, p-obj-code)).
      860   _dc-list:
      861   for each dc-list
      862     ON ERROR undo, NEXT:
      863       num-rec = num-rec + 1.
      864       run do-changes in this-procedure (
      865                                          input dc-list.d-card
      866                                         ,input p-host-code
      867                                         ,input p-obj-type
      868                                         ,input p-obj-code) no-error .
      869       if error-status:error then do:
      870         run write-log-and-file in p-log-handle (
      871                   input 1
      872                 , input log-file-name
      873                 , input 1
      874                 , input return-value
      875                                             ).
      876         assign
      877         v-view-log = yes.
      878         if v-no-ask  then do:
      879           run gbl/d-askw.w (
      880                         input "Изменение скидок товара на отдельные ДК по списку"
      881                         ,input substitute("ДК &1 Фирма &2 объект &3&4 - не удалось провести изменение скидок на ДК"
      882                                         , dc-list.d-card
      883                                         , p-host-code
      884                                         , p-obj-type
      885                                         , p-obj-code
      886                                         )
      887                         ,input "|"
      888                         ,input ("Продолжить|" +
      889                               "Продолжить и больше не запрашивать подтверждения на продолжение|" +
      890                               "Прекратить")
      891                         ,input "||"
      892                         ,input 1
      893                         ,input 3
      894                         ,output v-choice).
      895           if v-choice = 3 then do:
      896             leave.
      897           end.
      898           if v-choice = 2 then do:
      899             assign
      900             v-no-ask = yes.
      901           end.
      902         end.
      903       end.
      904       else do:
      905         num-rec-ok = num-rec-ok + 1.
      906         if pardelete-ok then delete dc-list.
      907       end.
      908       run show-counter in p-log-handle .
      909       run write-counter in p-log-handle (substitute("Обработано &1 из них успешно &2"
      910                                                   , num-rec
      911                                                   , num-rec-ok
      912                                                   )) no-error.
      913       run get-stop-state in p-log-handle (
      914           output v-stop
      915       ).
      916       if v-stop then do:
      917         leave _dc-list.
      918       end.
      919   END.
      920   run write-log-and-file in p-log-handle (
      921         input 1
      922       , input log-file-name
      923       , input 1
      924       , input substitute("Пакетное изменение скидок по списку ДК завершено: из &1 ДК списка успешно изменено &2", num-rec, num-rec-ok )).
      925   .
      926   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      927   if v-view-log
      928   and not g#news
      929   and not g#auto
      930   then do:
      931     message
      932     '!!!При изменении скидок на отдельные ДК по списку ДК произошли ошибки!!!'  skip
      933     "!!!Внимательно прочитайте Log-file!!"
      934     view-as alert-box error .
      935        define variable v-user-action13   as character no-undo .
      936     define variable v-printed13       as logical   no-undo .
      937     run gbl/prnfilen.w
      938       (input  ('!!!При изменении скидок на отдельные ДК по списку ДК произошли ошибки!!!')
      939       ,input  0
      940       ,input  (string("./":U) + 'ddcr-lst.txt')
      941       ,input  7
      942       ,output v-user-action13
      943       ,output v-printed13
      944       ) .
      945   end.
      946   if v-view-log = true
      947   and (g#news
      948   or g#auto)
      949   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      950   then do:
      951      run cb_set-view-log in p-parent-handle ( input yes).
      952   end.
      953   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
      954     OS-DELETE value(string("./":U) + 'ddcr-lst.txt').
      955   end.
      956   procedure do-changes :
      957   define input parameter pard-card like ub.dis-dc-rule.d-card no-undo .
      958   define input parameter p-host-code like ub.clients.host-code no-undo .
      959   define input parameter p-obj-type like ub.clients.obj-type no-undo .
      960   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      961   DEFINE VARIABLE loc#log as logical no-undo .
      962   DEFINE VARIABLE var-deleted as logical no-undo .
      963   define variable v-check as character no-undo .
      964   define variable v-correct as logical no-undo .
      965   define variable v-error-code as character no-undo .
      966   define variable v-rule-num as integer no-undo .
      967   define buffer buf_dis-dc-rule for ub.dis-dc-rule.
      968       _main:
      969     do
      970     on error undo, return error
      971     :
      972       _temp-disc:
      973       for each temp-disc no-lock
      974           on error undo _main, return error:
      975         CASE temp-disc.action:
      976           when yes then do:
      977             run disdcrul-write in this-procedure(
      978                                                    input pard-card
      979                                                   ,input p-host-code
      980                                                   ,input p-obj-type
      981                                                   ,input p-obj-code
      982                                                   ,input temp-disc.pos-type
      983                                                   ,input temp-disc.discnt-role
      984                                                   ,input temp-disc.templ-rl-root
      985                                                   ,input temp-disc.time-templ-rl-root
      986                                                   ,input temp-disc.rule-num
      987                                                   ,input temp-disc.nonunique
      988                                                       )  no-error.
      989             if error-status:error then do:
      990               assign v-mes = substitute("ДК &1, фирма &2 объект &3&4, POS &5, Тип скидки &6: ошибка при записи скидки:&7&8&7&9"                     , dc-list.d-card                    , p-host-code                    , p-obj-type                      , p-obj-code                      , entry (lookup (temp-disc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)                    , entry (lookup (temp-disc.discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u)                    , chr(10)                        , error-status:get-message(1)                    , return-value ).
      991               undo _main, return error v-mes.
      992             end.
      993           end.
      994           when no then do:
      995             var-deleted = no.
      996             find first buf_dis-dc-rule no-lock where
      997                       buf_dis-dc-rule.obj-type = temp-disc.obj-type
      998                   and buf_dis-dc-rule.obj-code = temp-disc.obj-code
      999                   and buf_dis-dc-rule.host-code = temp-disc.host-code
     1000                   and buf_dis-dc-rule.d-card = pard-card
     1001                   and buf_dis-dc-rule.pos-type = temp-disc.pos-type
     1002                   and buf_dis-dc-rule.discnt-role = temp-disc.discnt-role
     1003                   and  buf_dis-dc-rule.nonunique = temp-disc.nonunique   no-error.
     1004             if available buf_dis-dc-rule
     1005             and buf_dis-dc-rule.time-templ-rl-root = temp-disc.time-templ-rl-root
     1006             and buf_dis-dc-rule.rule-num = temp-disc.rule-num
     1007             then do:
     1008               v-rule-num = buf_dis-dc-rule.rule-num.
     1009               find current buf_dis-dc-rule exclusive-lock no-wait no-error.
     1010               if not available buf_dis-dc-rule then do:
     1011                 undo _main, return error substitute( "Товар &1 фирма &2 объект &3&4 POS &5 тип скидки &6, правило &7&8" +
     1012                                                      "занята запись скидки"
     1013                                                      , pard-card
     1014                                                      , p-host-code
     1015                                                      , p-obj-type
     1016                                                      , p-obj-code
     1017                                                      , entry (lookup (temp-disc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1018                                                      , entry (lookup (temp-disc.discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u)
     1019                                                      , v-rule-num
     1020                                                      , chr(10)
     1021                                                      ).
     1022               end.
     1023               delete buf_dis-dc-rule no-error.
     1024               if error-status:error then do:
     1025                 assign v-mes = substitute("ДК &1, фирма &2 объект &3&4, POS &5, Тип скидки &6: ошибка при удалении скидки:&7&8&7&9"                    , dc-list.d-card                    , p-host-code                    , p-obj-type                     , p-obj-code                      , temp-disc.pos-type                    , entry (lookup (temp-disc.discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u)                    , chr(10)                        , error-status:get-message(1)                    , return-value ).
     1026                 undo _main, return error v-mes.
     1027               end.
     1028             end.
     1029           end.
     1030         END CASE.
     1031       end.
     1032     end.
     1033   end procedure.
