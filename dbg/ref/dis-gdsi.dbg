     2469         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2470         assign
     2471           v-diasize-wndmax = false
     2472         .
     2473         if connected("ub") = true
     2474         then do:
     2475           define variable v-cntxt-db-num        as integer   no-undo .
     2476           define variable v-cntxt-userid        as character no-undo .
     2477           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2478                                             , OUTPUT v-cntxt-userid
     2479                                             ) .
     2480           run gbl/wndpar_r.p
     2481             (input  v-cntxt-db-num
     2482             ,input  v-cntxt-userid
     2483             ,input  'wndmax':U
     2484             ,output v-diasize-wndmax
     2485             ,output v-default-value
     2486             ) .
     2487         end.
     2488         assign
     2489           v-diasize-wndstore = false
     2490         .
     2491         if connected("ub") = true
     2492         then do:
     2493           run gbl/wndpar_r.p
     2494             (input  v-cntxt-db-num
     2495             ,input  v-cntxt-userid
     2496             ,input  'wndstore':U
     2497             ,output v-diasize-wndstore
     2498             ,output v-default-value
     2499             ) .
     2500         end.
     2501         assign
     2502           v-diasize-proc-name = entry(1, program-name(2), '.')
     2503         .
     2504         if v-diasize-wndstore = true
     2505         then do:
     2506           assign
     2507             v-restore-saved = false
     2508           .
     2509           if connected("ub") = true
     2510           then do:
     2511             run gbl/wndsizer.p
     2512               (input  v-cntxt-db-num
     2513               ,input  v-cntxt-userid
     2514               ,input  v-diasize-proc-name
     2515               ,input  'height':u
     2516               ,output v-resize-value-str
     2517               ) .
     2518             if v-resize-value-str <> '':U
     2519             then do:
     2520               run diasize_change-height in this-procedure
     2521                 (input  integer(v-resize-value-str)
     2522                 ,input  true
     2523                 ) .
     2524               assign
     2525                 v-restore-saved = true
     2526               .
     2527             end.
     2528           end.
     2529           if connected("ub") = true
     2530           then do:
     2531             run gbl/wndsizer.p
     2532               (input  v-cntxt-db-num
     2533               ,input  v-cntxt-userid
     2534               ,input  v-diasize-proc-name
     2535               ,input  'width':u
     2536               ,output v-resize-value-str
     2537               ) .
     2538             if v-resize-value-str <> '':U
     2539             then do:
     2540               run diasize_change-width in this-procedure
     2541                 (input  integer(v-resize-value-str)
     2542                 ,input  true
     2543                 ) .
     2544               assign
     2545                 v-restore-saved = true
     2546               .
     2547             end.
     2548           end.
     2549           if v-restore-saved <> true
     2550           then do:
     2551             if v-diasize-wndmax = true
     2552             then do:
     2553               run diasize_maximize in this-procedure
     2554                 (input  true
     2555                 ) .
     2556             end.
     2557           end.
     2558         end.
     2559         else do:
     2560           if v-diasize-wndmax = true
     2561           then do:
     2562             run diasize_maximize in this-procedure
     2563               (input  true
     2564               ) .
     2565           end.
     2566         end.
     2567       end.
     2568     end.
     2569   end procedure.
     2570   procedure diasize_need-full-display :
     2571     define output parameter p-need-full-display as logical   no-undo .
     2572     do
