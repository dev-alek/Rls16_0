     2623   ON TAB ANYWHERE
     2624   DO:
     2625   define variable ii as integer no-undo .
     2626   define variable fh as widget-handle no-undo .
     2627   define variable hh as widget-handle no-undo .
     2628   define variable v-next-widget-name as character no-undo .
     2629   if v-tab-order <> '' then do:
     2630     if self:type = "TOGGLE-BOX" then
     2631     self:BGCOLOR = ?.
     2632     assign
     2633     ii = lookup(self:name, v-tab-order).
     2634     assign
     2635     ii = ii + 1
     2636     v-next-widget-name = entry(ii, v-tab-order)
     2637     no-error .
     2638     if error-status:error then do:
     2639       assign
     2640       ii = 1
     2641       v-next-widget-name = entry( ii, v-tab-order)
     2642       .
     2643     end.
     2644     assign
     2645     fh = frame Dialog-Frame:first-child
     2646     hh = fh:first-child
     2647     .
     2648     do while valid-handle(hh):
     2649       if hh:name = v-next-widget-name then do:
     2650         if hh:sensitive  = yes
     2651         AND hh:visible = yes then do:
     2652           if hh:type = "TOGGLE-BOX":U then do:
     2653             assign
     2654             hh:BGcolor = 1
     2655             .
     2656           end.
     2657           APPLY "ENTRY" to hh.
     2658           return no-apply.
     2659         end.
     2660         else do:
     2661           APPLY "TAB" to hh.
     2662           return no-apply.
     2663         end.
     2664       end.
     2665       hh = hh:next-sibling.
     2666     end.
     2667   end.
     2668   END.
     2669   ON BACK-TAB ANYWHERE
     2670   DO:
     2671   define variable ii as integer no-undo .
     2672   define variable fh as widget-handle no-undo .
     2673   define variable hh as widget-handle no-undo .
     2674   define variable v-next-widget-name as character no-undo .
     2675   if v-tab-order <> '' then do:
     2676     assign
     2677     ii = lookup(self:name, v-tab-order).
     2678     .
     2679     assign
     2680     ii = (if ii = 1
     2681           then  num-entries(v-tab-order)
     2682           else ii - 1
     2683           )
     2684     v-next-widget-name = entry(ii, v-tab-order)
     2685     .
     2686     assign
     2687     fh = frame Dialog-Frame:first-child
     2688     hh = fh:first-child
     2689     .
     2690     do while valid-handle(hh):
     2691       if hh:name = v-next-widget-name then do:
     2692         if hh:sensitive  = yes
     2693         AND hh:visible = yes then do:
     2694           if hh:type = "TOGGLE-BOX":U then do:
     2695             assign
     2696             hh:BGcolor = 1
     2697             .
     2698           end.
     2699           APPLY "ENTRY" to hh.
     2700           return no-apply.
     2701         end.
     2702         else do:
     2703         APPLY "BACK-TAB" to hh.
     2704         return no-apply.
     2705         end.
     2706       end.
     2707       hh = hh:next-sibling.
     2708     end.
     2709     end.
     2710   END.
     2711   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2712   ON RETURN ANYWHERE
     2713   DO:
     2714   define variable ii as integer no-undo .
     2715   define variable fh as widget-handle no-undo .
     2716   define variable hh as widget-handle no-undo .
     2717   define variable v-next-widget-name as character no-undo .
     2718     if v-tab-order <> '' then do:
     2719       assign
     2720       ii = lookup(self:name, v-tab-order).
     2721       if ii = num-entries(v-tab-order) then do:
     2722           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2723           return no-apply.
     2724       end.
     2725       if self:type <> "BUTTON" and
     2726         self:type <> "EDITOR"  then do:
     2727         run proc-move-forward in this-procedure .
     2728         return no-apply.
     2729       end.
     2730       if self:type = "BUTTON" then do:
     2731         APPLY "CHOOSE" to self.
     2732       end.
     2733       if self:type = "TOGGLE-BOX" then
     2734       self:BGCOLOR = ?.
     2735       assign
     2736       ii = ii + 1
     2737       v-next-widget-name = entry(ii, v-tab-order)
     2738       no-error .
     2739       if error-status:error then do:
     2740         assign
     2741         ii = 1
     2742         v-next-widget-name = entry( ii, v-tab-order)
     2743         .
     2744       end.
     2745       assign
     2746       fh = frame Dialog-Frame:first-child
     2747       hh = fh:first-child
     2748       .
     2749       do while valid-handle(hh):
     2750         if hh:name = v-next-widget-name then do:
     2751           if hh:sensitive  = yes
     2752           AND hh:visible = yes then do:
     2753             if hh:type = "TOGGLE-BOX":U then do:
     2754               assign
     2755               hh:BGcolor = 1
     2756               .
     2757             end.
     2758             APPLY "ENTRY" to hh.
     2759             return no-apply.
     2760           end.
     2761           else do:
     2762             APPLY "TAB" to hh.
     2763             return no-apply.
     2764           end.
     2765         end.
     2766         hh = hh:next-sibling.
     2767       end.
     2768     end.
     2769   END.
     2770   procedure proc-move-forward :
     2771   define variable ii as integer no-undo .
     2772   define variable fh as widget-handle no-undo .
     2773   define variable hh as widget-handle no-undo .
     2774   define variable v-next-widget-name as character no-undo .
     2775   do
     2776   on error undo, return error
     2777   :
     2778     if v-tab-order <> '' then do:
     2779       if self:type = "TOGGLE-BOX" then
     2780       self:BGCOLOR = ?.
     2781       assign
     2782       ii = lookup(self:name, v-tab-order).
     2783       assign
     2784       ii = ii + 1
     2785       v-next-widget-name = entry(ii, v-tab-order)
     2786       no-error .
     2787       if error-status:error then do:
     2788         assign
     2789         ii = 1
     2790         v-next-widget-name = entry( ii, v-tab-order)
     2791         .
     2792       end.
     2793       assign
     2794       fh = frame Dialog-Frame:first-child
     2795       hh = fh:first-child
     2796       .
     2797       do while valid-handle(hh):
     2798         if hh:name = v-next-widget-name then do:
     2799           if hh:sensitive  = yes
     2800           AND hh:visible = yes then do:
     2801             if hh:type = "TOGGLE-BOX":U then do:
     2802               assign
     2803               hh:BGcolor = 1
     2804               .
     2805             end.
     2806             APPLY "ENTRY" to hh.
     2807             return.
     2808           end.
     2809           else do:
     2810             assign
     2811             ii = ii + 1
     2812             v-next-widget-name = entry(ii, v-tab-order)
     2813             no-error .
     2814             if error-status:error then do:
     2815               assign
     2816               ii = 1
     2817               v-next-widget-name = entry( ii, v-tab-order)
     2818               .
     2819             end.
     2820           end.
     2821         end.
     2822         hh = hh:next-sibling.
     2823       end.
     2824     end.
     2825   end.
     2826   end procedure.
