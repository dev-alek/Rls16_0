     2968   PROCEDURE disable_UI :
     2969     HIDE FRAME Dialog-Frame.
     2970   END PROCEDURE.
     2971   PROCEDURE enable_UI :
     2972     DISPLAY RS-p-mode goods-artic Goods-dsc-name goods-gds-code goods-prod-type
     2973             goods-prod-code goods-prod-name
     2974         WITH FRAME Dialog-Frame.
     2975     ENABLE B-exit b-quit b-add B-lookup b-chg b-del b-help RS-p-mode goods-artic
     2976            Goods-dsc-name goods-gds-code goods-prod-type goods-prod-code
     2977            goods-prod-name
     2978         WITH FRAME Dialog-Frame.
     2979     VIEW FRAME Dialog-Frame.
     2980     OPEN QUERY br-dis-gds FOR EACH temp-odisc NO-LOCK.
     2981   END PROCEDURE.
     2982   PROCEDURE init-proc :
     2983   DEFINE INPUT PARAMETER pp-mode as character no-undo.
     2984   define variable v-rule-label as character no-undo .
     2985   define buffer buf_goods for ub.goods.
     2986   define buffer buf_clients for ub.clients.
     2987   define buffer buf_prods for ub.clients.
     2988   for each  temp-odisc share-lock:
     2989     if p-mode = 'ИЗМЕНЕНИЕ':U
     2990     and (temp-odisc.obj-type = p-obj-type
     2991         and
     2992         temp-odisc.obj-code = p-obj-code)
     2993     or (v-cntxt-db-num = 0
     2994         and temp-odisc.obj-type = '':U
     2995         and
     2996         temp-odisc.obj-code = 0)
     2997     or (v-cntxt-db-num = 0
     2998         and temp-odisc.obj-type = 'орг':U
     2999         and temp-odisc.obj-code = v-cntxt-host-code-obj)
     3000         then do:
     3001     end.
     3002     else do:
     3003       delete temp-odisc.
     3004     end.
     3005   end.
     3006   if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     3007     find first buf_goods where
     3008              buf_goods.gds-code =  p-gds-code no-lock no-error .
     3009     find first buf_prods where
     3010                 buf_prods.obj-code =  buf_goods.prod-code
     3011             and buf_prods.obj-type =  buf_goods.prod-type  no-lock no-error .
     3012     Assign
     3013     Goods-dsc-name = buf_Goods.gds-name
     3014     goods-artic    = buf_goods.artic
     3015     goods-gds-code = buf_goods.gds-code
     3016     goods-prod-type = buf_goods.prod-type
     3017     goods-prod-code = buf_goods.prod-code
     3018     goods-prod-name = buf_prods.obj-name
     3019     .
     3020     display
     3021     Goods-dsc-name
     3022     goods-gds-code
     3023     goods-artic
     3024     goods-prod-type
     3025     goods-prod-code
     3026     goods-prod-name
     3027     with frame Dialog-Frame  .
     3028   end.
     3029     for each tt0-dis-gds-rule no-lock
     3030     where tt0-dis-gds-rule.gds-code = p-gds-code :
     3031         if tt0-dis-gds-rule.discnt-role  = '':U and
     3032            tt0-dis-gds-rule.pos-type     = '':U and
     3033            tt0-dis-gds-rule.nonunique    = '':U then next .
     3034         if pp-mode = 'объект':U and
     3035           (tt0-dis-gds-rule.obj-type = 'маг':U or tt0-dis-gds-rule.obj-type = 'скл':U) and
     3036           not (tt0-dis-gds-rule.obj-code = p-obj-code and tt0-dis-gds-rule.obj-type = p-obj-type) and
     3037           not (tt0-dis-gds-rule.obj-type = 'орг':U) and
     3038           not (tt0-dis-gds-rule.obj-type = "") then next.
     3039         if ( pp-mode = 'объект':U or pp-mode = 'орг':U ) and
     3040            ( tt0-dis-gds-rule.obj-type = 'орг':U and not tt0-dis-gds-rule.obj-code = v-host-code ) then next.
     3041         if tt0-dis-gds-rule.obj-type <> "" and tt0-dis-gds-rule.obj-type <>'орг':U then do:
     3042           if pp-mode = 'орг':U then do:
     3043             find first buf_clients no-lock where
     3044                     buf_Clients.obj-type = tt0-dis-gds-rule.obj-type
     3045                     and buf_Clients.obj-code = tt0-dis-gds-rule.obj-code no-error .
     3046                 if not avail buf_Clients or buf_Clients.host-code <> v-host-code then next.
     3047           end.
     3048           if pp-mode = "db":U then do:
     3049             find first buf_clients no-lock where
     3050                     buf_Clients.obj-type = tt0-dis-gds-rule.obj-type
     3051                     and buf_Clients.obj-code = tt0-dis-gds-rule.obj-code no-error .
     3052                 if not avail buf_Clients or buf_Clients.db-num <> v-cntxt-db-num then next.
     3053           end.
     3054       end.
     3055         if p-pos-type <> '':U and p-pos-type <> tt0-dis-gds-rule.pos-type then next.
     3056         run disgdsru-name ( input tt0-dis-gds-rule.templ-rl-root, output v-rule-label ).
     3057       find first temp-odisc where
     3058                 temp-odisc.discnt-role = tt0-dis-gds-rule.discnt-role
     3059             AND temp-odisc.obj-code = tt0-dis-gds-rule.obj-code
     3060             AND temp-odisc.obj-type = tt0-dis-gds-rule.obj-type
     3061             AND temp-odisc.gds-code = tt0-dis-gds-rule.gds-code
     3062             AND temp-odisc.nonunique = tt0-dis-gds-rule.nonunique
     3063             AND temp-odisc.pos-type = tt0-dis-gds-rule.pos-type
     3064             no-error.
     3065       if not available temp-odisc then do:
     3066         create temp-odisc.
     3067         assign
     3068         temp-odisc.obj-code = tt0-dis-gds-rule.obj-code
     3069         temp-odisc.obj-type = tt0-dis-gds-rule.obj-type
     3070         temp-odisc.gds-code = tt0-dis-gds-rule.gds-code
     3071         temp-odisc.pos-type = tt0-dis-gds-rule.pos-type
     3072         temp-odisc.nonunique = tt0-dis-gds-rule.nonunique
     3073         temp-odisc.discnt-role = tt0-dis-gds-rule.discnt-role
     3074         .
     3075       end.
     3076         assign
     3077       temp-odisc.templ-rl-root = tt0-dis-gds-rule.templ-rl-root
     3078       temp-odisc.time-templ-rl-root = tt0-dis-gds-rule.time-templ-rl-root
     3079       temp-odisc.rule-num =  tt0-dis-gds-rule.rule-num
     3080       temp-odisc.rule-label = v-rule-label
     3081       temp-odisc.rl-root = tt0-dis-gds-rule.rl-root
     3082       .
     3083     end.
     3084     case pp-mode:
     3085       when 'все':U then do:
     3086       end.
     3087       when "db" then do:
     3088           frame Dialog-Frame:TITLE = ini-title + " - объекты БД " +
     3089                                       string(v-cntxt-db-num).
     3090       end.
     3091       when 'объект':U then do:
     3092           frame Dialog-Frame:TITLE = ini-title + chr(32) +
     3093                                       p-obj-type + chr(32) +
     3094                                       string(p-obj-code).
     3095       end.
     3096       when 'орг':U then do:
     3097           frame Dialog-Frame:TITLE = ini-title + " - объекты фирмы " +
     3098                                       string(v-host-code).
     3099       end.
     3100     end case.
     3101     OPEN QUERY br-dis-gds FOR EACH temp-odisc NO-LOCK.
     3102   END PROCEDURE.
     3103   PROCEDURE MyEnable :
     3104   DEFINE VARIABLE v-h AS WIDGET-HANDLE NO-UNDO.
     3105   v-h = br-dis-gds:FIRST-COLUMN IN FRAME Dialog-Frame.
     3106   DO while valid-handle(v-h) :
     3107     if v-h:LABEL = 'Тип скидки' then do:
     3108       v-h:RESIZABLE = YES.
     3109       leave.
     3110     end.
     3111     ELSE DO:
     3112       v-h = v-h:NEXT-COLUMN.
     3113     END.
     3114   END.
     3115   IF p-obj-type = 'маг':U THEN DO:
     3116   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3117   define variable v-param-type25 as character no-undo .
     3118   define variable v-value-date25 as date no-undo .
     3119   define variable v-value-decimal25 as decimal no-undo .
     3120   define variable v-value-integer25 as INTEGER no-undo .
     3121   define variable v-value-logical25 AS LOGICAL no-undo .
     3122   define variable v-tth25 as handle no-undo .
     3123   run adm/shattri.p (
     3124       input "get":U
     3125       ,input  p-obj-type
     3126       ,input  p-obj-code
     3127       ,input  'cd-sending':U
     3128       ,input  'dflt-cd':U
     3129       ,output dflt-cd
     3130       ,output v-value-date25
     3131       ,output v-value-decimal25
     3132       ,output v-value-integer25
     3133       ,output v-value-logical25
     3134       ,output v-param-type25
     3135       ,INPUT-OUTPUT table-handle v-tth25
     3136       )  .
     3137   delete object v-tth25 no-error.
     3138   END.
     3139   if p-obj-type = 'скл':U then do:
     3140     dflt-cd = '-':U.
     3141   end.
     3142   ASSIGN
     3143   b-add:POPUP-MENU IN FRAME Dialog-Frame = MENU MENU-b-add:HANDLE
     3144   b-add:MENU-MOUSE = 1
     3145   MENU-ITEM m_pos-type:LABEL IN MENU menu-b-add  = dflt-cd
     3146   MENU-ITEM m_pos-type:sensitive IN MENU menu-b-add  = ((dflt-cd <> '':U) and (dflt-cd <> '-':U))
     3147   .
     3148   assign
     3149   v-tab-order = "b-exit,b-quit,b-add,b-lookup,b-chg,b-del,b-help,br-dis-gds".
     3150   assign
     3151   rs-p-mode:radio-buttons in frame Dialog-Frame = "Текущий" + chr(44) + 'объект':U + chr(44) +
     3152                           "Объекты фирмы" + chr(44) + 'орг':U + chr(44) +
     3153                           "Объекты БД" + chr(44) + "db" +
     3154                           (if v-cntxt-db-num = 0 then (chr(44) + "Все объекты" + chr(44) + 'все':U) else "":U)
     3155                           .
     3156   RS-p-mode =  p-mode-obj.
     3157   DISPLAY
     3158   Goods-dsc-name
     3159   goods-gds-code
     3160   goods-artic
     3161   RS-p-mode
     3162   WITH FRAME Dialog-Frame.
     3163   ENABLE
     3164   b-exit when (p-mode <> 'ПРОСМОТР':U and p-mode-obj = 'объект':U)
     3165   b-quit
     3166   b-del when (p-mode <> 'ПРОСМОТР':U and p-mode-obj = 'объект':U)
     3167   b-add when (p-mode <> 'ПРОСМОТР':U and p-mode-obj = 'объект':U)
     3168   b-chg when (p-mode <> 'ПРОСМОТР':U and p-mode-obj = 'объект':U)
     3169   b-lookup
     3170   b-help br-dis-gds Goods-dsc-name goods-gds-code goods-artic
     3171   RS-p-mode WHEN (p-mode-obj = 'орг':U OR p-mode-obj = 'объект':U)
     3172   WITH FRAME Dialog-Frame .
     3173   VIEW FRAME Dialog-Frame .
     3174   if p-mode = 'ПРОСМОТР':U then do:
     3175     hide
     3176     b-exit
     3177     in frame Dialog-Frame .
     3178     assign
     3179     b-quit:label = "&Выход"
     3180     b-quit:col    = 1
     3181     .
     3182   end.
     3183   OPEN QUERY br-dis-gds FOR EACH temp-odisc NO-LOCK.
     3184   APPLY "ENTRY" to br-dis-gds.
     3185   END PROCEDURE.
     3186   PROCEDURE proc-add-chg :
     3187   define input parameter p-add as logical no-undo.
     3188   define input parameter p-pos-type as character no-undo.
     3189   define variable v-rule-label as character no-undo .
     3190   DEFINE VARIABLE v-rule-num as integer no-undo .
     3191   define variable v-setted as logical no-undo .
     3192   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     3193   define variable v-templ-rl-root as integer no-undo .
     3194   define variable v-time-templ-rl-root as integer no-undo .
     3195   define variable v-cfg-nonunique as character no-undo .
     3196   define variable v-nonunique as character no-undo .
     3197   define variable v-discnt-role as character no-undo .
     3198   define variable v-obj-type as character no-undo .
     3199   define variable v-obj-code as integer no-undo .
     3200   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     3201   define buffer buf_dis-gds-rule for ub.dis-gds-rule.
     3202   define buffer buf_temp-odisc for temp-odisc.
     3203   CASE p-add:
     3204     when yes then do:
     3205       run ref/dis-pos.w ( INPUT parparentproc
     3206                           ,INPUT "b-sel":U
     3207                           ,INPUT "cd-type-list"
     3208                           ,INPUT (if v-cntxt-db-num = 0 and loc-glob  then 1 else 0)
     3209                           ,INPUT (if v-cntxt-db-num = 0 and loc-firm  then 1 else 0)
     3210                           ,INPUT (if loc-object then 1 else 0)
     3211                           ,input 'dis-gds-rule':U
     3212                           ,input '':U
     3213                           ,input ?
     3214                           ,INPUT p-pos-type
     3215                           ,input '':U
     3216                           ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     3217      IF ERROR-STATUS:ERROR
     3218      OR v-rid-list = '':U THEN DO:
     3219         RETURN.
     3220      END.
     3221      FIND FIRST buf_dis-cfg-rule NO-LOCK where
     3222                recid(buf_dis-cfg-rule) = INTEGER(v-rid-list).
     3223       assign
     3224       v-templ-rl-root = buf_dis-cfg-rule.templ-rl-root
     3225       v-time-templ-rl-root = buf_dis-cfg-rule.time-templ-rl-root
     3226       V-cfg-NONUNIQUE = buf_dis-cfg-rule.nonunique
     3227       v-discnt-role = buf_dis-cfg-rule.discnt-role
     3228       .
     3229       assign
     3230       added = yes.
     3231       v-rule-num = 0.
     3232       if (buf_dis-cfg-rule.has-global +
     3233          buf_dis-cfg-rule.has-host +
     3234          buf_dis-cfg-rule.has-obj) > 1 then do:
     3235         define variable v-sel-vals as character no-undo .
     3236         define variable v-sel-labels as character no-undo .
     3237         define variable var-region as character no-undo .
     3238         assign
     3239         v-sel-vals = v-sel-vals +
     3240                       (if buf_dis-cfg-rule.has-global = 1
     3241                       then (fill(chr(32), 3)  + string(0) + chr(44))
     3242                       else "":U)
     3243         v-sel-labels = v-sel-labels +
     3244                       (if buf_dis-cfg-rule.has-global  = 1
     3245                       then ("Глобально" + chr(44))
     3246                       else "":U)
     3247         .
     3248         assign
     3249         v-sel-vals = v-sel-vals +
     3250                       (if buf_dis-cfg-rule.has-host = 1
     3251                       then ('орг':U  + string(v-cntxt-host-code-obj)  + chr(44))
     3252                       else "":U)
     3253         v-sel-labels = v-sel-labels +
     3254                       (if buf_dis-cfg-rule.has-host = 1
     3255                       then ("Фирма"  + string(v-cntxt-host-code-obj) + chr(44))
     3256                       else "":U)
     3257         .
     3258         assign
     3259         v-sel-vals = v-sel-vals +
     3260                       (if buf_dis-cfg-rule.has-obj = 1
     3261                       then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(44))
     3262                       else "":U)
     3263         v-sel-labels = v-sel-labels +
     3264                       (if buf_dis-cfg-rule.has-obj = 1
     3265                       then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(44))
     3266                       else "":U)
     3267         .
     3268         run gbl/d-list.w (
     3269                             input "b-sel":U
     3270                             ,input "Выберите область действия"
     3271                             ,input v-sel-vals
     3272                             ,input v-sel-labels
     3273                             ,input chr(44)
     3274                             ,input "":U
     3275                             ,output var-region) no-error.
     3276         if error-status:error then do:
     3277           return error.
     3278         end.
     3279         assign
     3280         v-obj-type = trim(substring(var-region, 1, 3))
     3281         v-obj-code = integer(substring(var-region, 4))
     3282         v-host-code = (if var-region begins 'орг':U
     3283                        then integer(substring(var-region, 4))
     3284                        else 0)
     3285         .
     3286         if v-host-code = 0
     3287          and v-obj-type <> '':U then do:
     3288   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3289   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3290     (input  v-obj-type
     3291     ,input  v-obj-code
     3292     ,output v-host-code
     3293     )  .
     3294         end.
     3295       end.
     3296       else do:
     3297         if buf_dis-cfg-rule.has-obj = 1 then do:
     3298           assign
     3299           v-obj-type = p-obj-type
     3300           v-obj-code = p-obj-code
     3301           .
     3302         end.
     3303         if buf_dis-cfg-rule.has-host = 1 then do:
     3304           define variable v-host-code as integer no-undo .
     3305   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3306   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3307     (input  p-obj-type
     3308     ,input  p-obj-code
     3309     ,output v-host-code
     3310     )  .
     3311           assign
     3312           v-obj-type = 'орг':U
     3313           v-obj-code = v-host-code
     3314           .
     3315         end.
     3316         if buf_dis-cfg-rule.has-glob = 1 then do:
     3317           assign
     3318           v-obj-type = '':U
     3319           v-obj-code = 0
     3320           .
     3321         end.
     3322       end.
     3323     end.
     3324     when no then do:
     3325       find first buf_dis-cfg-rule no-lock where
     3326                 buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
     3327             and buf_dis-cfg-rule.discnt-role = temp-odisc.discnt-role
     3328             and buf_dis-cfg-rule.pos-type = temp-odisc.pos-type
     3329             and buf_dis-cfg-rule.templ-rl-root = temp-odisc.templ-rl-root
     3330             no-error .
     3331       if available buf_dis-cfg-rule then do:
     3332         assign
     3333         v-cfg-nonunique = buf_dis-cfg-rule.nonunique.
     3334       end.
     3335       v-rule-num  = temp-odisc.rule-num.
     3336       v-nonunique = temp-odisc.nonunique.
     3337     end.
     3338   END CASE.
     3339   if v-cfg-nonunique <> ''
     3340   and num-entries(v-cfg-nonunique, ".") > 1
     3341   then do:
     3342     case v-cfg-nonunique:
     3343       when "bar-code.b-code" then do:
     3344         define variable v-rec-num  as integer   no-undo .
     3345         define variable v-rec-cnt  as integer   no-undo init 0 .
     3346         define variable v-rec-osn  as character no-undo init '' .
     3347         define variable v-rec-dk   as character no-undo init '' .
     3348         define buffer buf_bar-code for ub.bar-code.
     3349         define buffer buf_prod-bc for ub.prod-bc.
     3350         if p-add then do:
     3351         run ref/alt-cds.w (
     3352              input parParentProc
     3353             ,input p-obj-type
     3354             ,input p-obj-code
     3355               ,input "all-no-part-dk"
     3356             ,input p-gds-code
     3357             ,input p-gds-code
     3358             ,output v-rec-list) no-error.
     3359         if v-rec-list = '' then undo, return error.
     3360           do v-rec-num = 1 to num-entries( v-rec-list, chr(44) ) :
     3361               if not entry( v-rec-num, v-rec-list, chr(44) ) begins "dk" then do:
     3362                  assign
     3363                    v-rec-osn = entry( v-rec-num, v-rec-list, chr(44) )
     3364                    v-rec-cnt = v-rec-cnt + 1
     3365                  .
     3366               end.
     3367               else v-rec-dk = substring( entry( v-rec-num, v-rec-list, chr(44) ), 3 ) .
     3368           end.
     3369           if v-rec-cnt > 1 then do:
     3370             message
     3371             "ВЫ выбрали более одного осн/неосн баркода"
     3372             view-as alert-box Error.
     3373             undo, return error .
     3374           end.
     3375           if v-rec-cnt = 1 then do:
     3376               find first buf_bar-code no-lock where recid(buf_bar-code) = integer(v-rec-osn) no-error .
     3377               if not avail buf_bar-code then do:
     3378                   message
     3379                   "Не найден выбранный осн/неосн баркод."
     3380                   view-as alert-box Error.
     3381                   undo, return error .
     3382               end.
     3383               assign
     3384                 v-cfg-nonunique = "@" + string(buf_bar-code.b-code)
     3385                 v-nonunique = string(buf_bar-code.b-code)
     3386               .
     3387           end.
     3388           if not v-rec-dk = '' then do:
     3389               find first buf_prod-bc no-lock where recid(buf_prod-bc) = integer(v-rec-dk) no-error .
     3390               if not avail buf_prod-bc then do:
     3391           message
     3392                   "Не найден выбранный дополнительный баркод."
     3393           view-as alert-box Error.
     3394           undo, return error .
     3395         end.
     3396               if v-rec-cnt = 1 and not buf_bar-code.b-code = buf_prod-bc.b-code then do:
     3397                   message
     3398                   "Неверные дополнительные коды ."
     3399                   view-as alert-box Error.
     3400                   undo, return error .
     3401               end.
     3402               assign
     3403                 v-cfg-nonunique = "@" + string(buf_prod-bc.b-code)
     3404                 v-nonunique = string(buf_prod-bc.b-code)
     3405               .
     3406           end.
     3407        end.
     3408         else do:
     3409           v-cfg-nonunique = "@" + temp-odisc.nonunique.
     3410           v-nonunique = string(temp-odisc.nonunique).
     3411         end.
     3412       end.
     3413       otherwise do:
     3414         message
     3415         substitute("Неизвестная опция для дифференциации скидки внутри одного товара=&1", v-cfg-nonunique)
     3416         view-as alert-box error .
     3417         return error.
     3418       end.
     3419     end case.
     3420   end.
     3421   run disgdsru-edit in this-procedure (
     3422                                          input (if p-add then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     3423                                         ,input p-gds-code
     3424                                         ,input (if p-add then v-obj-type else temp-odisc.obj-type)
     3425                                         ,input (if p-add then v-obj-code else temp-odisc.obj-code)
     3426                                         ,INPUT (if p-add then p-pos-type else temp-odisc.pos-type)
     3427                                         ,input (if p-add then v-discnt-role else temp-odisc.discnt-role)
     3428                                         ,input (if p-add then v-templ-rl-root else temp-odisc.templ-rl-root)
     3429                                         ,input (if p-add then v-time-templ-rl-root else temp-odisc.time-templ-rl-root)
     3430                                         ,input v-cfg-nonunique
     3431                                         ,input 1
     3432                                         ,input-output v-rule-num
     3433                                         ,input-output v-nonunique
     3434                                         ,output v-setted ) no-error.
     3435   if not v-setted then return error.
     3436   run temp-disgdsru-write in this-procedure (
     3437                                              input p-gds-code
     3438                                             ,input (if p-add then v-obj-type else temp-odisc.obj-type)
     3439                                             ,input (if p-add then v-obj-code else temp-odisc.obj-code)
     3440                                             ,input (if p-add then p-pos-type else temp-odisc.pos-type)
     3441                                             ,input (if p-add then v-templ-rl-root else temp-odisc.templ-rl-root)
     3442                                             ,input (if p-add then v-time-templ-rl-root else temp-odisc.time-templ-rl-root)
     3443                                             ,input (if p-add then v-discnt-role else temp-odisc.discnt-role)
     3444                                             ,input (if p-add then ? else temp-odisc.nonunique)
     3445                                             ,input v-rule-num
     3446                                             ,input v-nonunique
     3447                                             ) no-error .
     3448   IF not error-status:error then do:
     3449     assign
     3450     updated = yes
     3451     .
     3452     br-dis-gds:refresh() in frame Dialog-Frame no-error .
     3453   END.
     3454   assign
     3455   added = no.
     3456   if p-add = yes then do:
     3457     OPEN QUERY br-dis-gds FOR EACH temp-odisc NO-LOCK.
     3458     find first buf_temp-odisc no-lock where
     3459               buf_temp-odisc.obj-type = v-obj-type
     3460           AND buf_temp-odisc.obj-code = v-obj-code
     3461           AND buf_temp-odisc.pos-type = add-option
     3462           AND buf_temp-odisc.discnt-role = v-discnt-role
     3463           AND buf_temp-odisc.nonunique = v-nonunique
     3464         no-error.
     3465     add-option = '':U.
     3466     if avail buf_temp-odisc then
     3467         temp-doc-rec = recid(buf_temp-odisc).
     3468         else temp-doc-rec = ?.
     3469     reposition br-dis-gds to recid temp-doc-rec no-error.
     3470     if error-status:error then return no-apply.
     3471   end.
     3472   END PROCEDURE.
     3473   PROCEDURE proc-b-lookup :
     3474   define variable disc-label as character no-undo .
     3475   run disgdsru-name in this-procedure (
     3476                                         input temp-odisc.templ-rl-root
     3477                                       , output disc-label
     3478                                   ) no-error.
     3479   IF ERROR-STATUS:ERROR THEN DO:
     3480       message "Ошибка при определении названия и типа скидки товара на объекте!"         skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     3481       return error.
     3482   END.
     3483   run dsp-dis-rule in this-procedure  (
     3484                                          input temp-odisc.gds-code
     3485                                         ,input temp-odisc.nonunique
     3486                                         ,input temp-odisc.obj-type
     3487                                         ,input temp-odisc.obj-code
     3488                                         ,input temp-odisc.discnt-role
     3489                                         ,input temp-odisc.pos-type
     3490                                         ,input temp-odisc.rule-num) no-error.
     3491   END PROCEDURE.
     3492   PROCEDURE proc-save :
     3493   DEFINE VARIABLE v-updated AS LOGICAL NO-UNDO.
     3494   define variable v-created as logical no-undo .
     3495   define variable v-deleted as logical no-undo .
     3496   define variable v-updated-str as character no-undo .
     3497   for each temp-odisc NO-LOCK where
     3498            temp-odisc.gds-code = p-gds-code
     3499   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3500   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3501   on endkey undo , return error substitute( "&1. endkey", vss-workfile ):
     3502      find first tt0-dis-gds-rule NO-LOCK WHERE
     3503             tt0-dis-gds-rule.gds-code = temp-odisc.gds-code
     3504       AND   tt0-dis-gds-rule.obj-type = temp-odisc.obj-type
     3505       AND   tt0-dis-gds-rule.obj-code = temp-odisc.obj-code
     3506       AND   tt0-dis-gds-rule.pos-type = temp-odisc.pos-type
     3507       AND   tt0-dis-gds-rule.discnt-role = temp-odisc.discnt-role
     3508       AND   tt0-dis-gds-rule.nonunique = temp-odisc.nonunique
     3509       no-error.
     3510     assign
     3511     v-updated = no.
     3512     if available  tt0-dis-gds-rule then do:
     3513       BUFFER-COMPARE temp-odisc
     3514                   TO tt0-dis-gds-rule
     3515                   case-sensitive
     3516                   SAVE result IN v-updated-str.
     3517       assign
     3518       v-created = yes
     3519       v-updated = (v-updated-str <> "":U)
     3520       .
     3521     end.
     3522     else do:
     3523       assign
     3524       v-updated = yes.
     3525     end.
     3526     if v-updated then do:
     3527       if temp-odisc.obj-type = 'орг':U and v-cntxt-db-num <> 0 then do:
     3528         message
     3529         "Нельзя редактировать в УБД скидки, которые действуют ГЛОБАЛЬНО или на ФИРМЕ"
     3530         view-as alert-box error.
     3531         next.
     3532       end.
     3533       if temp-odisc.obj-type = '':U and v-cntxt-db-num <> 0 then do:
     3534         message
     3535         "Нельзя редактировать в УБД скидки, которые действуют ГЛОБАЛЬНО или на ФИРМЕ"
     3536         view-as alert-box error.
     3537         next.
     3538       end.
     3539       run tt0-disgdsru-write in this-procedure(
     3540                                        input p-gds-code
     3541                                       ,input temp-odisc.obj-type
     3542                                       ,input temp-odisc.obj-code
     3543                                       ,input temp-odisc.pos-type
     3544                                       ,input temp-odisc.templ-rl-root
     3545                                       ,input temp-odisc.time-templ-rl-root
     3546                                       ,input temp-odisc.discnt-role
     3547                                       ,input temp-odisc.rule-num
     3548                                       ,input temp-odisc.nonunique
     3549                                       )  no-error.
     3550       if error-status:error then do:
     3551         message
     3552         "Ошибка при сохранении скидки на товара на объекте" skip
     3553         "товар" p-gds-code skip
     3554         "объект" temp-odisc.obj-type temp-odisc.obj-code
     3555         "Тип скидки" temp-odisc.discnt-role
     3556         "POS" temp-odisc.pos-type
     3557         view-as alert-box  error .
     3558         undo, return error  .
     3559       end.
     3560       updated = yes.
     3561     end.
     3562     ASSIGN
     3563     p-updated = v-updated OR p-updated.
     3564   End.
     3565   FOR EACH tt0-dis-gds-rule where
     3566            tt0-dis-gds-rule.gds-code = p-gds-code
     3567   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3568   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     3569   on endkey undo , return error substitute( "&1. endkey", vss-workfile ):
     3570     if p-pos-type <> '':U
     3571     and p-pos-type <> tt0-dis-gds-rule.pos-type then do:
     3572       NEXT.
     3573     end.
     3574     FIND FIRST temp-odisc NO-LOCK WHERE
     3575               temp-odisc.gds-code = tt0-dis-gds-rule.gds-code
     3576           AND temp-odisc.obj-type = tt0-dis-gds-rule.obj-type
     3577           AND temp-odisc.obj-code = tt0-dis-gds-rule.obj-code
     3578           AND temp-odisc.pos-type = tt0-dis-gds-rule.pos-type
     3579           AND temp-odisc.discnt-role = tt0-dis-gds-rule.discnt-role
     3580           AND temp-odisc.nonunique = tt0-dis-gds-rule.nonunique
     3581           NO-ERROR.
     3582       IF NOT AVAILABLE temp-odisc THEN DO:
     3583         if tt0-dis-gds-rule.obj-type = 'орг':U and v-cntxt-db-num <> 0 then do:
     3584           message
     3585           "Нельзя редактировать в УБД скидки, которые действуют ГЛОБАЛЬНО или на ФИРМЕ"
     3586           view-as alert-box error.
     3587           next.
     3588         end.
     3589         if tt0-dis-gds-rule.obj-type = '':U and v-cntxt-db-num <> 0 then do:
     3590           message
     3591           "Нельзя редактировать в УБД скидки, которые действуют ГЛОБАЛЬНО или на ФИРМЕ"
     3592           view-as alert-box error.
     3593           next.
     3594         end.
     3595         DELETE tt0-dis-gds-rule.
     3596         assign
     3597         v-deleted = yes.
     3598         ASSIGN
     3599         p-updated = (v-deleted OR p-updated).
     3600       END.
     3601   END.
     3602   if p-updated
     3603   and p-update-instantly then do:
     3604     run ref/disgdsr1.p (
     3605                        input p-mode + chr(44) + v-rec-list
     3606                       ,input p-gds-code
     3607                       ,input p-obj-type
     3608                       ,input p-obj-code
     3609                       ,INPUT table tt0-dis-gds-rule
     3610                       ) no-error .
     3611     if error-status:error then do:
     3612       message
     3613       substitute("Ошибка при сохранении скидок товара на объекте:&1&2&1&3"
     3614                  , chr(10)
     3615                  , error-status:get-message(1)
     3616                  , return-value )
     3617       view-as alert-box
     3618       error .
     3619       undo, return error .
     3620     end.
     3621   end.
     3622   END PROCEDURE.
     3623   PROCEDURE temp-disgdsru-write :
     3624   do
     3625     on error undo, return error
     3626     :
     3627       define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     3628       define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     3629       define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     3630       define input parameter p-pos-type like ub.dis-gds-rule.pos-type  no-undo .
     3631       define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     3632       define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     3633       define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     3634       define input parameter p-was-nonunique like ub.dis-gds-rule.nonunique no-undo .
     3635       define input parameter p-rule-num  like ub.dis-gds-rule.rule-num no-undo .
     3636       define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     3637       define variable v-rule-label as character no-undo .
     3638       define buffer buf_temp-odisc for temp-odisc .
     3639       define buffer buf_Dis-rule for ub.dis-rule.
     3640       run disgdsru-name in this-procedure (
     3641                                              input  p-templ-rl-root
     3642                                             ,output v-rule-label
     3643                                             ) no-error .
     3644       if error-status :error then do:
     3645         undo, return error return-value .
     3646       end.
     3647       find first buf_temp-odisc exclusive-lock where
     3648                  buf_temp-odisc.gds-code  = p-gds-code
     3649              AND buf_temp-odisc.obj-type  = p-obj-type
     3650              AND buf_temp-odisc.obj-code  = p-obj-code
     3651              AND buf_temp-odisc.pos-type  = p-pos-type
     3652              AND buf_temp-odisc.discnt-role = p-discnt-role
     3653              AND buf_temp-odisc.nonunique = (if p-was-nonunique = ? then p-nonunique else p-was-nonunique)
     3654              no-error no-wait .
     3655       if not available buf_temp-odisc then do:
     3656         create buf_temp-odisc .
     3657         assign
     3658         buf_temp-odisc.gds-code  = p-gds-code
     3659         buf_temp-odisc.obj-type  = p-obj-type
     3660         buf_temp-odisc.obj-code  = p-obj-code
     3661         buf_temp-odisc.pos-type  = p-pos-type
     3662         buf_temp-odisc.nonunique = p-nonunique
     3663         buf_temp-odisc.discnt-role = p-discnt-role
     3664         no-error
     3665         .
     3666       end.
     3667       find first buf_dis-rule no-lock where
     3668                 buf_dis-rule.rule-num = p-rule-num.
     3669       ASSIGN
     3670       buf_temp-odisc.rule-num =  p-rule-num
     3671       buf_temp-odisc.time-templ-rl-root = p-time-templ-rl-root
     3672       buf_temp-odisc.templ-rl-root = p-templ-rl-root
     3673       buf_temp-odisc.rl-root = buf_dis-rule.rl-root
     3674       buf_temp-odisc.nonunique = p-nonunique
     3675       no-error.
     3676     end.
     3677   END PROCEDURE.
     3678   PROCEDURE tt0-disgdsru-write :
     3679   do
     3680   on error undo, return error
     3681   :
     3682     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     3683     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     3684     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     3685     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     3686     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     3687     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     3688     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     3689     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     3690     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     3691     define variable v-rule-label          as character no-undo .
     3692     define buffer buf_tt0-dis-gds-rule for tt0-dis-gds-rule .
     3693     define buffer buf_dis-rule for ub.dis-rule.
     3694     run disgdsru-name in this-procedure (
     3695                                         input  p-templ-rl-root
     3696                                         ,output v-rule-label
     3697                                         ) no-error .
     3698     if error-status :error then do:
     3699       undo, return error return-value .
     3700     end.
     3701     find first buf_tt0-dis-gds-rule exclusive-lock where
     3702                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     3703             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     3704             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     3705             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     3706             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     3707             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     3708             no-error .
     3709     if not available buf_tt0-dis-gds-rule then do:
     3710       create buf_tt0-dis-gds-rule .
     3711       assign
     3712       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     3713       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     3714       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     3715       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     3716       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     3717       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     3718       no-error
     3719       .
     3720     end.
     3721     find first buf_dis-rule no-lock where
     3722               buf_dis-rule.rule-num = p-rule-num.
     3723     ASSIGN
     3724     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     3725     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     3726     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     3727     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     3728     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     3729     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     3730     no-error.
     3731     release buf_tt0-dis-gds-rule no-error .
     3732     if error-status:error then do:
     3733       undo, return error return-value .
     3734     end.
     3735   end.
     3736   END PROCEDURE.
