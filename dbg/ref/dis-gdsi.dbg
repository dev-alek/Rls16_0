     1055   DEFINE MENU MENU-b-add
     1056          MENU-ITEM m_pos-type     LABEL "m_pos-type"
     1057          MENU-ITEM m_no-pos       LABEL "По накладной"
     1058          MENU-ITEM m_bo           LABEL "Бэкофис"       .
     1059   DEFINE BUTTON b-add
     1060        LABEL "&Добавить":L
     1061        SIZE 10 BY 1 TOOLTIP "Добавить скидку товара".
     1062   DEFINE BUTTON b-chg
     1063        LABEL "&Изменить":L
     1064        SIZE 10 BY 1 TOOLTIP "Изменить скидку товара".
     1065   DEFINE BUTTON b-del
     1066        LABEL "&Удалить":L
     1067        SIZE 10 BY 1 TOOLTIP "Удалить  скидку товара".
     1068   DEFINE BUTTON B-exit AUTO-GO
     1069        LABEL "&Ввод"
     1070        SIZE 10 BY 1 TOOLTIP "Выход с сохранением".
     1071   DEFINE BUTTON b-help
     1072        LABEL "Помо&щь":L
     1073        SIZE 3 BY 1.
     1074   DEFINE BUTTON B-lookup
     1075        LABEL "&Просмотр"
     1076        SIZE 10 BY 1.
     1077   DEFINE BUTTON b-quit AUTO-END-KEY
     1078        LABEL "&Отмена":L
     1079        SIZE 10 BY 1 TOOLTIP "Выход из режима".
     1080   DEFINE VARIABLE goods-artic AS CHARACTER FORMAT "X(16)":U
     1081         VIEW-AS TEXT
     1082        SIZE 16.4 BY 1
     1083        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1084   DEFINE VARIABLE Goods-dsc-name AS CHARACTER FORMAT "X(60)":U
     1085         VIEW-AS TEXT
     1086        SIZE 61.6 BY 1
     1087        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1088   DEFINE VARIABLE goods-gds-code AS INTEGER FORMAT ">>>>>>>>>>":U INITIAL 0
     1089         VIEW-AS TEXT
     1090        SIZE 11 BY 1
     1091        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1092   DEFINE VARIABLE goods-prod-code AS INTEGER FORMAT ">>>>>>>>>":U INITIAL 0
     1093         VIEW-AS TEXT
     1094        SIZE 9.6 BY 1
     1095        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1096   DEFINE VARIABLE goods-prod-name AS CHARACTER FORMAT "X(60)":U
     1097         VIEW-AS TEXT
     1098        SIZE 46.8 BY 1
     1099        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1100   DEFINE VARIABLE goods-prod-type AS CHARACTER FORMAT "X(3)":U
     1101         VIEW-AS TEXT
     1102        SIZE 3.8 BY 1
     1103        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1104   DEFINE VARIABLE RS-p-mode AS CHARACTER
     1105        VIEW-AS RADIO-SET VERTICAL
     1106        RADIO-BUTTONS
     1107             "Текущий", "1",
     1108   "Объекты фирмы", "2",
     1109   "Объекты БД", "3"
     1110        SIZE 16.9 BY 2 NO-UNDO.
     1111   DEFINE QUERY br-dis-gds FOR
     1112         temp-odisc SCROLLING.
     1113   DEFINE BROWSE br-dis-gds
     1114     QUERY br-dis-gds DISPLAY
     1115         temp-odisc.templ-rl-root COLUMN-LABEL "" FORMAT ">9":U
     1116   disgdsru-get-disc-label(temp-odisc.templ-rl-root) COLUMN-LABEL 'Тип скидки' FORMAT "X(255)":U WIDTH 50
     1117   temp-odisc.rule-num COLUMN-LABEL "№ правила" FORMAT ">>>>>>>>9":U
     1118   temp-odisc.nonunique COLUMN-LABEL "Детализ." FORMAT "X(11)":U
     1119   get-objregion(temp-odisc.obj-type, temp-odisc.obj-code) COLUMN-LABEL "Действует" FORMAT "X(12)"
     1120   entry (lookup (temp-odisc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) FORMAT "X(15)":U COLUMN-LABEL "Место!использ."
     1121   temp-odisc.rl-root COLUMN-LABEL "№ корн.!правила" FORMAT ">>>>>>>>9":U
     1122       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.8 BY 15.5
     1123            FONT 4.
     1124   DEFINE FRAME Dialog-Frame
     1125        B-exit AT ROW 1 COL 1
     1126        b-quit AT ROW 1 COL 11
     1127        b-add AT ROW 1 COL 21
     1128        B-lookup AT ROW 1 COL 31
     1129        b-chg AT ROW 1 COL 41
     1130        b-del AT ROW 1 COL 51
     1131        b-help AT ROW 1 COL 95
     1132        RS-p-mode AT ROW 2.33 COL 81.5 NO-LABEL
     1133        br-dis-gds AT ROW 4.47 COL 1
     1134        goods-artic AT ROW 2.13 COL 1.9 NO-LABEL
     1135        Goods-dsc-name AT ROW 2.13 COL 19 NO-LABEL
     1136        goods-gds-code AT ROW 3.3 COL 1.8 NO-LABEL
     1137        goods-prod-type AT ROW 3.3 COL 19 NO-LABEL
     1138        goods-prod-code AT ROW 3.3 COL 23.4 NO-LABEL
     1139        goods-prod-name AT ROW 3.3 COL 33.8 NO-LABEL
     1140        "Объекты:" VIEW-AS TEXT
     1141             SIZE 11.9 BY .93 AT ROW 1.13 COL 81.6
     1142             FGCOLOR 4
     1143        SPACE(6.30) SKIP(17.91)
     1144       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1145            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1146            TITLE "Скидки товара".
     1147   ASSIGN
     1148          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1149          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1150   ASSIGN
     1151          b-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-add:HANDLE.
     1152   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1153   DO:
     1154     APPLY "END-ERROR":U TO SELF.
     1155   END.
     1156   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1157   DO:
     1158     if add-option = '':U then do:
     1159         run gbl/pop-up.p ( input self:handle, input no) no-error.
     1160     end.
     1161     if add-option = '':U then return no-apply.
     1162     run proc-add-chg in this-procedure ( input yes, input add-option ) no-error.
     1163     if error-status:error then do:
     1164       add-option = '':U.
     1165       return no-apply.
     1166     end.
     1167     add-option = '':U.
     1168   END.
     1169   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1170   DO:
     1171     if not avail temp-odisc then return no-apply.
     1172     run proc-add-chg in this-procedure ( input no, input temp-odisc.pos-type) no-error .
     1173     if error-status:error then return no-apply.
     1174     OPEN QUERY br-dis-gds FOR EACH temp-odisc NO-LOCK.
     1175   END.
     1176   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1177   DO:
     1178   define variable loc#log as logical no-undo.
     1179   define variable jj as integer no-undo .
     1180   define variable v-rule-label as character no-undo .
     1181     if not avail temp-odisc then return no-apply.
     1182       run disgdsru-name in this-procedure
     1183         (input  temp-odisc.templ-rl-root
     1184         ,output v-rule-label
     1185         ) no-error .
     1186       if error-status :error then do:
     1187         return no-apply .
     1188       end.
     1189     loc#log = no.
     1190     if temp-odisc.obj-type = ""
     1191     and temp-odisc.obj-code = 0
     1192     and v-cntxt-db-num > 0
     1193     then do:
     1194       message
     1195       "Нельзя удалять в УБД скидки, которые действуют ГЛОБАЛЬНО или на ФИРМЕ"
     1196       view-as alert-box error .
     1197       undo, return no-apply.
     1198     end.
     1199     message
     1200     substitute("Вы уверены, что хотите удалить скидку &1 (место использования &2) на &3&4&6для товара &5"
     1201              ,v-rule-label
     1202              ,entry (lookup (temp-odisc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1203              ,temp-odisc.obj-type
     1204              ,temp-odisc.obj-code
     1205              ,goods-dsc-name
     1206              , chr(10))
     1207             view-as alert-box QUESTIOn buttons YES-NO update loc#log.
     1208     if NOT loc#log then return no-apply.
     1209     delete temp-odisc.
     1210     updated = yes.
     1211    OPEN QUERY br-dis-gds FOR EACH temp-odisc NO-LOCK.
     1212   END.
     1213   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1214   DO:
     1215      RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     1216     IF ERROR-STATUS:ERROR THEN DO:
     1217        RETURN NO-APPLY.
     1218     END.
     1219   END.
     1220   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1221   DO:
     1222     if not avail temp-odisc then return no-apply.
     1223     RUN proc-b-lookup IN THIS-PROCEDURE NO-ERROR.
     1224     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1225   END.
     1226   ON MOUSE-SELECT-DBLCLICK OF br-dis-gds IN FRAME Dialog-Frame
     1227   DO:
     1228     if not avail temp-odisc then return no-apply.
     1229     RUN proc-b-lookup IN THIS-PROCEDURE NO-ERROR.
     1230     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1231   END.
     1232   ON RETURN OF br-dis-gds IN FRAME Dialog-Frame
     1233   DO:
     1234     if not avail temp-odisc then return no-apply.
     1235     RUN proc-b-lookup IN THIS-PROCEDURE NO-ERROR.
     1236     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1237   END.
     1238   ON VALUE-CHANGED OF br-dis-gds IN FRAME Dialog-Frame
     1239   DO:
     1240     IF v-cntxt-db-num > 0
     1241     AND (temp-odisc.obj-type = 'орг':U
     1242     OR temp-odisc.obj-type = '':U) THEN DO:
     1243        DISABLE
     1244        b-chg
     1245        with FRAME Dialog-Frame.
     1246     END.
     1247     ELSE DO:
     1248         enable
     1249         b-chg WHEN (p-mode <> 'ПРОСМОТР':U and p-mode-obj = 'объект':U)
     1250         with FRAME Dialog-Frame.
     1251     END.
     1252   END.
     1253   ON CHOOSE OF MENU-ITEM m_bo
     1254   DO:
     1255     add-option = 'bo':U.
     1256     run proc-add-chg in this-procedure ( input yes, input add-option ) no-error.
     1257     if error-status:error then do:
     1258       add-option = '':U.
     1259       return no-apply.
     1260     end.
     1261     add-option = '':U.
     1262   END.
     1263   ON CHOOSE OF MENU-ITEM m_no-pos
     1264   DO:
     1265     add-option = '-':U.
     1266     run proc-add-chg in this-procedure ( input yes, input add-option ) no-error.
     1267     if error-status:error then do:
     1268       add-option = '':U.
     1269       return no-apply.
     1270     end.
     1271     add-option = '':U.
     1272   END.
     1273   ON CHOOSE OF MENU-ITEM m_pos-type
     1274   DO:
     1275     add-option = dflt-cd.
     1276     run proc-add-chg in this-procedure ( input yes, input add-option ) no-error.
     1277     if error-status:error then do:
     1278       add-option = '':U.
     1279       return no-apply.
     1280     end.
     1281     add-option = '':U.
     1282   END.
     1283   ON VALUE-CHANGED OF RS-p-mode IN FRAME Dialog-Frame
     1284   DO:
     1285     assign
     1286     rs-p-mode
     1287     p-mode-obj = rs-p-mode
     1288     .
     1289     DO TRANSACTION on error undo,  return no-apply on stop undo, return no-apply:
     1290       case rs-p-mode:
     1291         when 'орг':U then do:
     1292           disable
     1293           b-del
     1294           b-add
     1295           b-chg
     1296           with frame Dialog-Frame.
     1297         end.
     1298         when 'объект':U then do:
     1299           enable
     1300           b-del when p-mode <> 'ПРОСМОТР':U
     1301           b-add when p-mode <> 'ПРОСМОТР':U
     1302           b-chg when p-mode <> 'ПРОСМОТР':U
     1303           with frame Dialog-Frame.
     1304         end.
     1305         when 'все':U then do:
     1306           disable
     1307           b-del when p-mode = 'ИЗМЕНЕНИЕ':U
     1308           b-add when p-mode = 'ИЗМЕНЕНИЕ':U
     1309           b-chg when p-mode = 'ИЗМЕНЕНИЕ':U
     1310           with frame Dialog-Frame.
     1311         end.
     1312         when "db":U then do:
     1313           disable
     1314           b-del when p-mode = 'ИЗМЕНЕНИЕ':U
     1315           b-add when p-mode = 'ИЗМЕНЕНИЕ':U
     1316           b-chg when p-mode = 'ИЗМЕНЕНИЕ':U
     1317           with frame Dialog-Frame.
     1318         end.
     1319       END CASE.
     1320       for each temp-odisc:
     1321         if p-mode = 'ИЗМЕНЕНИЕ':U
     1322         and (temp-odisc.obj-type = p-obj-type
     1323             and
     1324             temp-odisc.obj-code = p-obj-code)
     1325         or temp-odisc.obj-type = 'орг':U
     1326         or temp-odisc.obj-type = ""  then.
     1327         else
     1328         delete temp-odisc.
     1329       end.
     1330       run MyENable in this-procedure .
     1331       RUn init-proc in this-procedure ( input p-mode-obj).
     1332     END.
     1333   END.
     1334   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1335   on help of frame Dialog-Frame
     1336   do:
     1337     run gbl/app_help.p
     1338       (input this-procedure :file-name
     1339       ,input ''
     1340       ,input ?
     1341       ) no-error.
     1342     if error-status :error then do:
     1343       message
     1344         "Ошибка при вызове помощи"
     1345         error-status :get-message(1)
     1346         view-as alert-box .
     1347     end.
     1348   end.
     1349   run minbtn-set in this-procedure .
     1350   on choose of b-help in frame Dialog-Frame
     1351   do:
     1352     apply "help":u to frame Dialog-Frame .
     1353   end.
     1354   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1355   procedure minbtn-set :
     1356       do
     1357           on error undo, return error return-value
     1358           :
     1359           define variable ii              as integer       no-undo .
     1360           define variable fh              as widget-handle no-undo .
     1361           define variable hh              as widget-handle no-undo .
     1362           define variable v-h             as handle        extent 4 no-undo .
     1363           define variable v-name-button   as character     no-undo .
     1364           define variable v-help-old-x    as decimal       no-undo .
     1365           define variable v-help-old-y    as decimal       no-undo .
     1366           define variable v-help-old-size as decimal       no-undo .
     1367           define variable v-frame-width   as decimal       no-undo .
     1368           define variable jj              as integer       no-undo .
     1369           do
     1370               on error undo, return error
     1371               :
     1372               assign
     1373                   v-frame-width = frame Dialog-Frame:width - 0.3
     1374                   fh            = frame Dialog-Frame:first-child
     1375                   hh            = fh:first-child
     1376                   ii            = 1
     1377                   .
     1378               do while valid-handle(hh):
     1379                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1380                   do:
     1381                       case lc(hh:name) :
     1382                           when "b-help" then
     1383                               do:
     1384                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1385                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1386                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1387                                   hh:TOOLTIP = "Помощь" .
     1388                                   v-help-old-x = hh:column .
     1389                                   v-help-old-y = hh:row    .
     1390                                   v-help-old-size = hh:width .
     1391                                   hh:width-chars = 2.5 .
     1392                               end.
     1393                           when "b-print" then
     1394                               do:
     1395                                   hh:load-image("cmp/b-print.bmp":u) .
     1396                                   hh:TOOLTIP = "Печать" .
     1397                                   v-h[ii] = hh:handle .
     1398                                   ii = ii + 1 .
     1399                                   hh:width-chars = 3 .
     1400                               end.
     1401                           when "b-history" or
     1402                           when "b-hist" then
     1403                               do:
     1404                                   hh:load-image("cmp/b-hist.bmp":u) .
     1405                                   hh:TOOLTIP = "История" .
     1406                                   v-h[ii] = hh:handle .
     1407                                   ii = ii + 1 .
     1408                                   hh:width-chars = 3 .
     1409                               end.
     1410                           when "b-sch" then
     1411                               do:
     1412                                   hh:load-image("cmp/b-sch.bmp":u) .
     1413                                   hh:TOOLTIP = "Установка Фильтра" .
     1414                                   v-h[ii] = hh:handle .
     1415                                   ii = ii + 1 .
     1416                                   hh:width-chars = 3 .
     1417                               end.
     1418                           when "b-hist-user" then
     1419                               do:
     1420                                   hh:load-image("cmp/b-hist.bmp":u) .
     1421                                   hh:TOOLTIP = "История пользователя" .
     1422                                   ii = ii + 1 .
     1423                               end.
     1424                       end case.
     1425                   end.
     1426                   hh = hh:next-sibling.
     1427               end.
     1428               b-help:column = v-frame-width - b-help:width-chars.
     1429               jj = 0.
     1430               repeat ii = 4 to 1 by -1 :
     1431                   if valid-handle (v-h[ii] ) then
     1432                   do:
     1433                       jj  = jj + 1 .
     1434                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1435                       v-h[ii]:row    = v-help-old-y .
     1436                   end.
     1437               end.
     1438           end.
     1439       end.
     1440   end procedure.
     1441   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1442   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1443   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1444   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1445   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1446   define variable v-diasize-current-frame-height as decimal   no-undo .
     1447   define variable v-diasize-change-size          as logical   no-undo .
     1448   define variable v-diasize-resize-button        as handle    no-undo .
     1449   define variable v-diasize-wndmax               as logical   no-undo .
     1450   define variable v-diasize-wndstore             as logical   no-undo .
     1451   define variable v-diasize-proc-name            as character no-undo .
     1452   define variable v-diasize-browse-handle        as handle    no-undo .
     1453   define variable v-diasize-browse-number        as integer   no-undo .
     1454   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1455   define temp-table temp-diasize-handle no-undo
     1456     field handle-value  as handle
     1457     field save-position as decimal
     1458     index xpk is primary unique handle-value
     1459     .
     1460   define temp-table temp-browse-handle no-undo
     1461     field browse-type   as character
     1462     field browse-number as integer
     1463     field browse-handle as handle
     1464     field original-size as decimal
     1465     index xpk is primary unique browse-type browse-number
     1466     index xie browse-type browse-handle
     1467   .
     1468   procedure diasize_change-height :
     1469     define input  parameter p-change-value  as decimal   no-undo .
     1470     define input  parameter p-move-resize   as logical   no-undo .
     1471     define variable v-field-group-handle    as handle    no-undo .
     1472     define variable v-object-handle         as handle    no-undo .
     1473     define variable v-frame-height          as decimal   no-undo .
     1474     define variable v-frame-virtual-height  as decimal   no-undo .
     1475     define variable v-browse-height         as decimal   no-undo .
     1476     define variable v-window-height         as decimal   no-undo .
     1477     define variable v-window-virtual-height as decimal   no-undo .
     1478     define variable v-change-sign           as integer   no-undo .
     1479     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1480     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1481     if p-change-value > 0
     1482     then do:
     1483       if frame Dialog-Frame :height + p-change-value
     1484           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1485       then do:
     1486         assign
     1487           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1488                           - (frame Dialog-Frame :height-chars)
     1489         .
     1490         if p-change-value <= 0
     1491         then do:
     1492           run diasize_position-resize-button in this-procedure .
     1493           return .
     1494         end.
     1495       end.
     1496     end.
     1497     if p-change-value < 0
     1498     then do:
     1499       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1500       then do:
     1501         assign
     1502           p-change-value = v-diasize-orig-frame-height
     1503                          - (frame Dialog-Frame :height-chars)
     1504         .
     1505         if p-change-value >= 0
     1506         then do:
     1507           run diasize_position-resize-button in this-procedure .
     1508           return .
     1509         end.
     1510       end.
     1511     end.
     1512     if p-change-value >= 0
     1513     then do:
     1514       assign
     1515         v-change-sign = 1
     1516       .
     1517     end.
     1518     else do:
     1519       assign
     1520         v-change-sign = -1
     1521       .
     1522     end.
     1523     assign
     1524       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1525     .
     1526     if p-change-value = 0
     1527     then do:
     1528       run diasize_position-resize-button in this-procedure .
     1529       return .
     1530     end.
     1531     move_block:
     1532     do
     1533     on error undo move_block, retry move_block
     1534     :
     1535       if retry
     1536       then do:
     1537         do
     1538         on error undo move_block, leave move_block
     1539         :
     1540           if p-change-value > 0
     1541           then do:
     1542             for each buf_temp-diasize-handle
     1543             on error undo, next
     1544             :
     1545               assign
     1546                 v-object-handle = buf_temp-diasize-handle.handle-value
     1547               .
     1548               if v-object-handle <> v-diasize-resize-button
     1549               then do:
     1550                 assign
     1551                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1552                 .
     1553               end.
     1554             end.
     1555             assign
     1556               v-diasize-browse-handle :height = v-browse-height
     1557             .
     1558             for each buf_temp-browse-handle
     1559               where buf_temp-browse-handle.browse-type = 'height':u
     1560             on error undo, next
     1561             :
     1562               assign
     1563                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1564               .
     1565             end.
     1566             assign
     1567               frame Dialog-Frame :height = v-frame-height
     1568             .
     1569             if frame Dialog-Frame :scrollable = true
     1570             then do:
     1571               assign
     1572                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1573               .
     1574             end.
     1575             run diasize_position-resize-button in this-procedure .
     1576           end.
     1577           else do:
     1578             if frame Dialog-Frame :scrollable = true
     1579             then do:
     1580               assign
     1581                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1582               .
     1583             end.
     1584             assign
     1585               frame Dialog-Frame :height = v-frame-height
     1586             .
     1587             assign
     1588               v-diasize-browse-handle :height = v-browse-height
     1589             .
     1590             for each buf_temp-browse-handle
     1591               where buf_temp-browse-handle.browse-type = 'height':u
     1592             on error undo, next
     1593             :
     1594               assign
     1595                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1596               .
     1597             end.
     1598             for each buf_temp-diasize-handle
     1599             on error undo, next
     1600             :
     1601               assign
     1602                 v-object-handle = buf_temp-diasize-handle.handle-value
     1603               .
     1604               if v-object-handle <> v-diasize-resize-button
     1605               then do:
     1606                 assign
     1607                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1608                 .
     1609               end.
     1610             end.
     1611             run diasize_position-resize-button in this-procedure .
     1612           end.
     1613           assign
     1614             v-diasize-change-size = false
     1615           .
     1616           leave move_block .
     1617         end.
     1618       end.
     1619       assign
     1620         v-diasize-need-full-display = true
     1621       .
     1622       if v-diasize-change-size = false
     1623       then do:
     1624         assign
     1625           v-diasize-change-size = true
     1626         .
     1627       end.
     1628       else do:
     1629         return .
     1630       end.
     1631       assign
     1632         v-frame-height = frame Dialog-Frame :height
     1633         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1634         v-browse-height = v-diasize-browse-handle :height
     1635       .
     1636       for each buf_temp-browse-handle
     1637         where buf_temp-browse-handle.browse-type = 'height':u
     1638       :
     1639         assign
     1640           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1641         .
     1642       end.
     1643       for each buf_temp-diasize-handle
     1644       :
     1645         delete buf_temp-diasize-handle .
     1646       end.
     1647       assign
     1648         v-field-group-handle = frame Dialog-Frame :first-child
     1649       .
     1650       do while valid-handle(v-field-group-handle)
     1651       :
     1652         assign
     1653           v-object-handle = v-field-group-handle :first-child
     1654         .
     1655         do while valid-handle(v-object-handle)
     1656         :
     1657           if  v-object-handle <> v-diasize-browse-handle :handle
     1658           and can-query(v-object-handle, "row")
     1659           and can-query(v-object-handle, "height")
     1660           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1661           then do:
     1662             find first buf_temp-browse-handle
     1663               where buf_temp-browse-handle.browse-type   = 'height':u
     1664                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1665               no-error .
     1666             if available buf_temp-browse-handle
     1667             then do:
     1668             end.
     1669             else do:
     1670               create buf_temp-diasize-handle .
     1671               assign
     1672                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1673                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1674               .
     1675             end.
     1676           end.
     1677           assign
     1678             v-object-handle = v-object-handle :next-sibling
     1679           .
     1680         end.
     1681         assign
     1682           v-field-group-handle = v-field-group-handle :next-sibling
     1683         .
     1684       end.
     1685       do with frame Dialog-Frame
     1686       :
     1687         hide v-diasize-resize-button .
     1688         assign
     1689           v-diasize-resize-button :row    = 1
     1690           v-diasize-resize-button :column = 1
     1691         .
     1692       end.
     1693       if p-change-value > 0
     1694       then do:
     1695         if frame Dialog-Frame :scrollable = true
     1696         then do:
     1697           assign
     1698             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1699             no-error .
     1700           if error-status :error
     1701           or error-status :get-message(1) <> ""
     1702           then do:
     1703             undo move_block, retry move_block .
     1704           end.
     1705         end.
     1706         assign
     1707           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1708           no-error .
     1709         if error-status :error
     1710         or error-status :get-message(1) <> ""
     1711         then do:
     1712           undo move_block, retry move_block .
     1713         end.
     1714         assign
     1715           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1716           no-error .
     1717         if error-status :error
     1718         or error-status :get-message(1) <> ""
     1719         then do:
     1720           undo move_block, retry move_block .
     1721         end.
     1722         for each buf_temp-browse-handle
     1723           where buf_temp-browse-handle.browse-type = 'height':u
     1724         on error undo move_block, retry move_block
     1725         :
     1726           assign
     1727             buf_temp-browse-handle.browse-handle :height
     1728               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1729             no-error .
     1730           if error-status :error
     1731           or error-status :get-message(1) <> ""
     1732           then do:
     1733             undo move_block, retry move_block .
     1734           end.
     1735         end.
     1736         for each buf_temp-diasize-handle
     1737         on error undo move_block, retry move_block
     1738         :
     1739           assign
     1740             v-object-handle = buf_temp-diasize-handle.handle-value
     1741           .
     1742           if v-object-handle <> v-diasize-resize-button
     1743           then do:
     1744             assign
     1745               v-object-handle :row = v-object-handle :row + p-change-value
     1746               no-error .
     1747             if error-status :error
     1748             or error-status :get-message(1) <> ""
     1749             then do:
     1750               undo move_block, retry move_block .
     1751             end.
     1752           end.
     1753         end.
     1754       end.
     1755       else do:
     1756         for each buf_temp-diasize-handle
     1757         on error undo move_block, retry move_block
     1758         :
     1759           assign
     1760             v-object-handle = buf_temp-diasize-handle.handle-value
     1761           .
     1762           if v-object-handle <> v-diasize-resize-button
     1763           then do:
     1764             assign
     1765               v-object-handle :row = v-object-handle :row + p-change-value
     1766               no-error .
     1767             if error-status :error
     1768             or error-status :get-message(1) <> ""
     1769             then do:
     1770               undo move_block, retry move_block .
     1771             end.
     1772           end.
     1773         end.
     1774         assign
     1775           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1776           no-error .
     1777         if error-status :error
     1778         or error-status :get-message(1) <> ""
     1779         then do:
     1780           undo move_block, retry move_block .
     1781         end.
     1782         for each buf_temp-browse-handle
     1783           where buf_temp-browse-handle.browse-type = 'height':u
     1784         on error undo move_block, retry move_block
     1785         :
     1786           assign
     1787             buf_temp-browse-handle.browse-handle :height
     1788               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1789             no-error .
     1790           if error-status :error
     1791           or error-status :get-message(1) <> ""
     1792           then do:
     1793             undo move_block, retry move_block .
     1794           end.
     1795         end.
     1796         assign
     1797           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1798           no-error .
     1799         if error-status :error
     1800         or error-status :get-message(1) <> ""
     1801         then do:
     1802           undo move_block, retry move_block .
     1803         end.
     1804         if frame Dialog-Frame :scrollable = true
     1805         then do:
     1806           assign
     1807             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1808             no-error .
     1809           if error-status :error
     1810           or error-status :get-message(1) <> ""
     1811           then do:
     1812             undo move_block, retry move_block .
     1813           end.
     1814         end.
     1815       end.
     1816       if p-move-resize = true
     1817       then do:
     1818         run diasize_position-resize-button in this-procedure .
     1819       end.
     1820       if v-diasize-wndstore = true
     1821       then do:
     1822         if connected("ub") = true
     1823         then do:
     1824           define variable v-cntxt-db-num        as integer   no-undo .
     1825           define variable v-cntxt-userid        as character no-undo .
     1826           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1827                                             , OUTPUT v-cntxt-userid
     1828                                             ) .
     1829           run gbl/wndsizew.p
     1830             (input  v-cntxt-db-num
     1831             ,input  v-cntxt-userid
     1832             ,input  v-diasize-proc-name
     1833             ,input  'height':u
     1834             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1835             ) .
     1836         end.
     1837       end.
     1838     end.
     1839     assign
     1840       v-diasize-change-size = false
     1841     .
     1842   end procedure.
     1843   procedure diasize_set-height :
     1844     define input  parameter p-new-height  as decimal   no-undo .
     1845     define input  parameter p-move-resize as logical   no-undo .
     1846     do
     1847     on error undo, return error return-value
     1848     :
     1849       run diasize_change-height in this-procedure
     1850         (input  (p-new-height - frame Dialog-Frame :height)
     1851         ,input  p-move-resize
     1852         ) .
     1853     end.
     1854   end procedure.
     1855   procedure diasize_change-width :
     1856     define input  parameter p-change-value as decimal   no-undo .
     1857     define input  parameter p-move-resize  as logical   no-undo .
     1858     define variable v-field-group-handle   as handle    no-undo .
     1859     define variable v-object-handle        as handle    no-undo .
     1860     define variable v-frame-width          as decimal   no-undo .
     1861     define variable v-frame-virtual-width  as decimal   no-undo .
     1862     define variable v-browse-width         as decimal   no-undo .
     1863     define variable v-window-width         as decimal   no-undo .
     1864     define variable v-window-virtual-width as decimal   no-undo .
     1865     define variable v-change-sign          as integer   no-undo .
     1866     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1867     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1868     if p-change-value > 0
     1869     then do:
     1870       if frame Dialog-Frame :width + p-change-value >
     1871           session :width-chars
     1872       then do:
     1873         assign
     1874           p-change-value = session :width-chars - frame Dialog-Frame :width
     1875         .
     1876         if p-change-value <= 0
     1877         then do:
     1878           run diasize_position-resize-button in this-procedure .
     1879           return .
     1880         end.
     1881       end.
     1882     end.
     1883     if p-change-value < 0
     1884     then do:
     1885       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1886       then do:
     1887         assign
     1888           p-change-value = v-diasize-orig-frame-width
     1889                          - frame Dialog-Frame :width
     1890         .
     1891         if p-change-value >= 0
     1892         then do:
     1893           run diasize_position-resize-button in this-procedure .
     1894           return .
     1895         end.
     1896       end.
     1897     end.
     1898     if p-change-value >= 0
     1899     then do:
     1900       assign
     1901         v-change-sign = 1
     1902       .
     1903     end.
     1904     else do:
     1905       assign
     1906         v-change-sign = -1
     1907       .
     1908     end.
     1909     assign
     1910       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1911     .
     1912     if p-change-value = 0
     1913     then do:
     1914       run diasize_position-resize-button in this-procedure .
     1915       return .
     1916     end.
     1917     move_block:
     1918     do
     1919     on error undo move_block, leave move_block
     1920     :
     1921       if retry
     1922       then do:
     1923         do
     1924         on error undo move_block, leave move_block
     1925         :
     1926           if p-change-value > 0
     1927           then do:
     1928             for each buf_temp-diasize-handle
     1929             on error undo, next
     1930             :
     1931               assign
     1932                 v-object-handle = buf_temp-diasize-handle.handle-value
     1933               .
     1934               if v-object-handle <> v-diasize-resize-button
     1935               then do:
     1936                 assign
     1937                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1938                 .
     1939               end.
     1940             end.
     1941             assign
     1942               v-diasize-browse-handle :width = v-browse-width
     1943             .
     1944             for each buf_temp-browse-handle
     1945               where buf_temp-browse-handle.browse-type = 'width':u
     1946             on error undo, next
     1947             :
     1948               assign
     1949                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1950               .
     1951             end.
     1952             assign
     1953               frame Dialog-Frame :width = v-frame-width
     1954             .
     1955             if frame Dialog-Frame :scrollable = true
     1956             then do:
     1957               assign
     1958                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1959               .
     1960             end.
     1961             run diasize_position-resize-button in this-procedure .
     1962           end.
     1963           else do:
     1964             if frame Dialog-Frame :scrollable = true
     1965             then do:
     1966               assign
     1967                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1968               .
     1969             end.
     1970             assign
     1971               frame Dialog-Frame :width = v-frame-width
     1972             .
     1973             for each buf_temp-browse-handle
     1974               where buf_temp-browse-handle.browse-type = 'width':u
     1975             on error undo, next
     1976             :
     1977               assign
     1978                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1979               .
     1980             end.
     1981             assign
     1982               v-diasize-browse-handle :width = v-browse-width
     1983             .
     1984             for each buf_temp-diasize-handle
     1985             on error undo, next
     1986             :
     1987               assign
     1988                 v-object-handle = buf_temp-diasize-handle.handle-value
     1989               .
     1990               if v-object-handle <> v-diasize-resize-button
     1991               then do:
     1992                 assign
     1993                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1994                 .
     1995               end.
     1996             end.
     1997             run diasize_position-resize-button in this-procedure .
     1998           end.
     1999           assign
     2000             v-diasize-change-size = false
     2001           .
     2002           leave move_block .
     2003         end.
     2004       end.
     2005       assign
     2006         v-diasize-need-full-display = true
     2007       .
     2008       if v-diasize-change-size = false
     2009       then do:
     2010         assign
     2011           v-diasize-change-size = true
     2012         .
     2013       end.
     2014       else do:
     2015         return .
     2016       end.
     2017       assign
     2018         v-frame-width = frame Dialog-Frame :width
     2019         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2020         v-browse-width = v-diasize-browse-handle :width
     2021       .
     2022       for each buf_temp-browse-handle
     2023         where buf_temp-browse-handle.browse-type = 'width':u
     2024       :
     2025         assign
     2026           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2027         .
     2028       end.
     2029       for each buf_temp-diasize-handle
     2030       :
     2031         delete buf_temp-diasize-handle .
     2032       end.
     2033       assign
     2034         v-field-group-handle = frame Dialog-Frame :first-child
     2035       .
     2036       do while valid-handle(v-field-group-handle)
     2037       :
     2038         assign
     2039           v-object-handle = v-field-group-handle :first-child
     2040         .
     2041         do while valid-handle(v-object-handle)
     2042         :
     2043           if  v-object-handle <> v-diasize-browse-handle :handle
     2044           and v-object-handle <> v-diasize-resize-button
     2045           and can-query(v-object-handle, "row")
     2046           and can-query(v-object-handle, "height")
     2047           and ( v-object-handle :col + v-object-handle :width
     2048                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2049               )
     2050           then do:
     2051             find first buf_temp-browse-handle
     2052               where buf_temp-browse-handle.browse-type   = 'width':u
     2053                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2054               no-error .
     2055             if available buf_temp-browse-handle
     2056             then do:
     2057             end.
     2058             else do:
     2059               create buf_temp-diasize-handle .
     2060               assign
     2061                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2062                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2063               .
     2064             end.
     2065           end.
     2066           assign
     2067             v-object-handle = v-object-handle :next-sibling
     2068           .
     2069         end.
     2070         assign
     2071           v-field-group-handle = v-field-group-handle :next-sibling
     2072         .
     2073       end.
     2074       do with frame Dialog-Frame
     2075       :
     2076         hide v-diasize-resize-button .
     2077         v-diasize-resize-button :row = 1.
     2078         v-diasize-resize-button :column = 1.
     2079       end.
     2080       if p-change-value > 0
     2081       then do:
     2082         if frame Dialog-Frame :scrollable = true
     2083         then do:
     2084           assign
     2085             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2086             no-error .
     2087           if error-status :error
     2088           or error-status :get-message(1) <> ""
     2089           then do:
     2090             undo move_block, retry move_block.
     2091           end.
     2092         end.
     2093         assign
     2094           frame Dialog-Frame :width = v-frame-width + p-change-value
     2095           no-error .
     2096         if error-status :error
     2097         or error-status :get-message(1) <> ""
     2098         then do:
     2099           undo move_block, retry move_block.
     2100         end.
     2101         assign
     2102           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2103         no-error .
     2104         if error-status :error
     2105         or error-status :get-message(1) <> ""
     2106         then do:
     2107           undo move_block, retry move_block.
     2108         end.
     2109         for each buf_temp-browse-handle
     2110           where buf_temp-browse-handle.browse-type = 'width':u
     2111         on error undo move_block, retry move_block
     2112         :
     2113           assign
     2114             buf_temp-browse-handle.browse-handle :width
     2115               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2116             no-error .
     2117           if error-status :error
     2118           or error-status :get-message(1) <> ""
     2119           then do:
     2120             undo move_block, retry move_block .
     2121           end.
     2122         end.
     2123         for each buf_temp-diasize-handle
     2124         on error undo move_block, retry move_block
     2125         :
     2126           assign
     2127             v-object-handle = buf_temp-diasize-handle.handle-value
     2128           .
     2129           if v-object-handle <> v-diasize-resize-button
     2130           then do:
     2131             assign
     2132               v-object-handle :col = v-object-handle :col + p-change-value
     2133               no-error .
     2134             if error-status :error
     2135             or error-status :get-message(1) <> ""
     2136             then do:
     2137               undo move_block, retry move_block .
     2138             end.
     2139           end.
     2140         end.
     2141       end.
     2142       else do:
     2143         for each buf_temp-diasize-handle
     2144         on error undo move_block, retry move_block
     2145         :
     2146           assign
     2147             v-object-handle = buf_temp-diasize-handle.handle-value
     2148           .
     2149           if v-object-handle <> v-diasize-resize-button
     2150           then do:
     2151             assign
     2152               v-object-handle :col = v-object-handle :col + p-change-value
     2153               no-error .
     2154             if error-status :error
     2155             or error-status :get-message(1) <> ""
     2156             then do:
     2157               undo move_block, retry move_block .
     2158             end.
     2159           end.
     2160         end.
     2161         for each buf_temp-browse-handle
     2162           where buf_temp-browse-handle.browse-type = 'width':u
     2163         on error undo move_block, retry move_block
     2164         :
     2165           assign
     2166             buf_temp-browse-handle.browse-handle :width
     2167               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2168             no-error .
     2169           if error-status :error
     2170           or error-status :get-message(1) <> ""
     2171           then do:
     2172             undo move_block, retry move_block .
     2173           end.
     2174         end.
     2175         assign
     2176           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2177           no-error .
     2178         if error-status :error
     2179         or error-status :get-message(1) <> ""
     2180         then do:
     2181           undo move_block, retry move_block.
     2182         end.
     2183         assign
     2184           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2185         no-error .
     2186         if error-status :error
     2187         or error-status :get-message(1) <> ""
     2188         then do:
     2189           undo move_block, retry move_block.
     2190         end.
     2191         if frame Dialog-Frame :scrollable = true
     2192         then do:
     2193           assign
     2194             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2195           no-error .
     2196           if error-status :error
     2197           or error-status :get-message(1) <> ""
     2198           then do:
     2199             undo move_block, retry move_block.
     2200           end.
     2201         end.
     2202       end.
     2203       if p-move-resize
     2204       then do:
     2205         run diasize_position-resize-button in this-procedure .
     2206       end.
     2207       if v-diasize-wndstore = true
     2208       then do:
     2209         if connected("ub") = true
     2210         then do:
     2211           define variable v-cntxt-db-num        as integer   no-undo .
     2212           define variable v-cntxt-userid        as character no-undo .
     2213           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2214                                             , OUTPUT v-cntxt-userid
     2215                                             ) .
     2216           run gbl/wndsizew.p
     2217             (input  v-cntxt-db-num
     2218             ,input  v-cntxt-userid
     2219             ,input  v-diasize-proc-name
     2220             ,input  'width':u
     2221             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2222             ) .
     2223         end.
     2224       end.
     2225     end.
     2226     assign
     2227       v-diasize-change-size = false
     2228     .
     2229   end procedure.
     2230   procedure diasize_set-width :
     2231     define input  parameter p-new-width  as decimal   no-undo .
     2232     define input  parameter p-move-resize as logical   no-undo .
     2233     do
     2234     on error undo, return error return-value
     2235     :
     2236       run diasize_change-width in this-procedure
     2237         (input  (p-new-width - frame Dialog-Frame :width)
     2238         ,input  p-move-resize
     2239         ) .
     2240     end.
     2241   end procedure.
     2242   procedure diasize_position-resize-button :
     2243     do with frame Dialog-Frame
     2244     :
     2245       hide v-diasize-resize-button .
     2246       assign
     2247         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2248                     - 1
     2249                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2250         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2251                     - 1
     2252                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2253       .
     2254       view v-diasize-resize-button .
     2255     end.
     2256   end procedure.
     2257   on alt-right anywhere
     2258   do:
     2259     run diasize_change-width in this-procedure
     2260       (input 1
     2261       ,input true
     2262       ) .
     2263     return no-apply .
     2264   end.
     2265   on alt-left anywhere
     2266   do:
     2267     run diasize_change-width in this-procedure
     2268       (input -1
     2269       ,input true
     2270       ) .
     2271     return no-apply .
     2272   end.
     2273   on alt-down anywhere
     2274   do:
     2275     run diasize_change-height in this-procedure
     2276       (input 1
     2277       ,input true
     2278       ) .
     2279     return no-apply .
     2280   end.
     2281   on alt-up anywhere
     2282   do:
     2283     run diasize_change-height in this-procedure
     2284       (input -1
     2285       ,input true
     2286       ) .
     2287     return no-apply .
     2288   end.
     2289   on alt-enter of frame Dialog-Frame
     2290   do:
     2291     run diasize_maximize in this-procedure
     2292       (input  ?
     2293       ).
     2294     return no-apply .
     2295   end.
     2296   procedure diasize_end-move :
     2297     do
     2298     on error undo, return error return-value
     2299     :
     2300       define variable v-row-delta as decimal   no-undo .
     2301       define variable v-col-delta as decimal   no-undo .
     2302       define variable v-new-row as decimal   no-undo .
     2303       define variable v-new-col as decimal   no-undo .
     2304       assign
     2305         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2306         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2307       .
     2308       assign
     2309         v-row-delta = v-new-row - frame Dialog-Frame :height
     2310         v-col-delta = v-new-col - frame Dialog-Frame :width
     2311       .
     2312       run diasize_change-height in this-procedure
     2313         (input v-row-delta
     2314         ,input true
     2315         ) .
     2316       run diasize_change-width in this-procedure
     2317         (input v-col-delta
     2318         ,input true
     2319         ) .
     2320     end.
     2321   end procedure.
     2322   procedure diasize_maximize :
     2323     define input  parameter p-action as logical   no-undo .
     2324     do
     2325     on error undo, return error return-value
     2326     :
     2327       if p-action = ?
     2328       then do:
     2329         if v-diasize-need-maximize = true
     2330         then do:
     2331           assign
     2332             p-action = true
     2333           .
     2334         end.
     2335         else do:
     2336           assign
     2337             p-action = false
     2338           .
     2339         end.
     2340       end.
     2341       if p-action = true
     2342       then do:
     2343         run diasize_change-height in this-procedure
     2344           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2345               - frame Dialog-Frame :height-chars
     2346           ,input true
     2347           ) .
     2348         run diasize_change-width in this-procedure
     2349           (input session :width-chars
     2350               - frame Dialog-Frame :width-chars
     2351           ,input true
     2352           ) .
     2353         assign
     2354           v-diasize-need-maximize = false
     2355         .
     2356       end.
     2357       else do:
     2358         run diasize_change-width in this-procedure
     2359           (input v-diasize-orig-frame-width
     2360               - frame Dialog-Frame :width-chars
     2361           ,input true
     2362           ) .
     2363         run diasize_change-height in this-procedure
     2364           (input v-diasize-orig-frame-height
     2365               - frame Dialog-Frame :height-chars
     2366           ,input true
     2367           ) .
     2368         assign
     2369           v-diasize-need-maximize = true
     2370         .
     2371       end.
     2372     end.
     2373   end procedure.
     2374   procedure diasize_restore-orig-size :
     2375     do
     2376     on error undo, return error return-value
     2377     :
     2378       assign
     2379         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2380         v-diasize-current-frame-height = frame Dialog-Frame :height
     2381       .
     2382       run diasize_set-height in this-procedure
     2383         (input  v-diasize-orig-frame-height
     2384         ,input  true
     2385         ) .
     2386       run diasize_set-width in this-procedure
     2387         (input  v-diasize-orig-frame-width
     2388         ,input  true
     2389         ) .
     2390     end.
     2391   end procedure.
     2392   procedure diasize_restore-current-size :
     2393     do
     2394     on error undo, return error return-value
     2395     :
     2396       run diasize_set-height in this-procedure
     2397         (input  v-diasize-current-frame-height
     2398         ,input  true
     2399         ) .
     2400       run diasize_set-width in this-procedure
     2401         (input  v-diasize-current-frame-width
     2402         ,input  true
     2403         ) .
     2404     end.
     2405   end procedure.
     2406   procedure diasize_set-browse-handle :
     2407     define input  parameter p-browse-handle as handle   no-undo .
     2408     define buffer buf_temp-browse-handle for temp-browse-handle .
     2409     do
     2410     on error undo, return error return-value
     2411     :
     2412       assign
     2413         v-diasize-browse-handle = p-browse-handle
     2414       .
     2415       for each buf_temp-browse-handle
     2416       on error undo, return error return-value
     2417       :
     2418         delete buf_temp-browse-handle .
     2419       end.
     2420     end.
     2421   end procedure.
     2422   procedure diasize_add_browse :
     2423     define input  parameter p-browse-type   as character no-undo .
     2424     define input  parameter p-browse-handle as handle    no-undo .
     2425     define buffer buf_temp-browse-handle for temp-browse-handle .
     2426     do
     2427     on error undo, return error return-value
     2428     :
     2429       assign
     2430         v-diasize-browse-number = v-diasize-browse-number + 1
     2431       .
     2432       create buf_temp-browse-handle .
     2433       assign
     2434         buf_temp-browse-handle.browse-type   = p-browse-type
     2435         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2436         buf_temp-browse-handle.browse-handle = p-browse-handle
     2437       .
     2438     end.
     2439   end procedure.
     2440   procedure diasize_init :
     2441     define variable v-default-value    as logical   no-undo .
     2442     define variable v-restore-saved    as logical   no-undo .
     2443     define variable v-resize-value-str as character no-undo .
     2444     do
     2445     on error undo, return error return-value
     2446     :
     2447       do with frame Dialog-Frame
     2448       :
     2449         assign
     2450           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2451           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2452           v-diasize-browse-handle     = browse br-dis-gds :handle
     2453         .
     2454         create button v-diasize-resize-button
     2455         assign
     2456           parent        = frame Dialog-Frame :first-child
     2457           label         = "s"
     2458           height-pixels = 16
     2459           width-pixels  = 16
     2460           visible       = true
     2461           sensitive     = true
     2462           movable       = true
     2463           triggers:
     2464             on end-move persistent run diasize_end-move in this-procedure .
     2465           end triggers.
     2466         v-diasize-resize-button :load-mouse-pointer("SIZE") .
