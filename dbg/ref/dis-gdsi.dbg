      128     define variable v-cntxt-level         as character no-undo .
      129     define variable v-cntxt-host-code-obj as integer   no-undo .
      130     define variable v-cntxt-obj-type      as character no-undo .
      131     define variable v-cntxt-obj-code      as integer   no-undo .
      132     define variable v-cntxt-db-num-obj    as integer   no-undo .
      133     define variable v-cntxt-is-admin      as logical   no-undo .
      134   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   procedure dr-code :
      136     do
      137     on error undo, return error
      138     :
      139       define input  parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
      140       define output parameter  p-des               like ub.dis-rule.des               no-undo .
      141       define output parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
      142       define output parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
      143       define output parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
      144       define output parameter  p-level-1           as character no-undo .
      145       define output parameter  p-level-2           as character no-undo .
      146       define output parameter  p-global             as integer no-undo .
      147       define output parameter  p-host               as integer no-undo .
      148       define output parameter  p-object             as integer no-undo .
      149       define output parameter  p-output-display as logical   no-undo .
      150       define output parameter  p-tree           as char  no-undo .
      151       define output parameter  p-other          as character no-undo .
      152       define variable v-other as character no-undo .
      153       define buffer buf_dis-rule for ub.dis-rule .
      154       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      155       find first buf_dis-rule no-lock where
      156                 buf_dis-rule.rule-num = p-templ-rl-root no-error.
      157       find first buf_dis-cfg-rule no-lock where
      158               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      159           and buf_dis-cfg-rule.pos-type = '':U
      160           and buf_dis-cfg-rule.table-name = '':U
      161           and buf_dis-cfg-rule.discnt-role = '':U
      162           and buf_dis-cfg-rule.self-nonunique = '':U
      163               no-error.
      164       if not available buf_Dis-cfg-rule then do:
      165           undo, return error substitute("неизвестный шаблон скидки &1", p-templ-rl-root ).
      166       end.
      167       assign
      168       p-des = buf_dis-rule.des
      169       p-discnt-type = buf_dis-rule.discnt-type
      170       p-subject-type = buf_dis-rule.subject-type
      171       p-value-type = buf_dis-rule.value-type
      172       p-global = (if available buf_dis-cfg-rule
      173                   then buf_dis-cfg-rule.has-global
      174                   else 0)
      175       p-host = (if available buf_dis-cfg-rule
      176                 then buf_dis-cfg-rule.has-host
      177                 else 0)
      178       p-object = (if available buf_dis-cfg-rule
      179                 then buf_dis-cfg-rule.has-obj
      180                 else 0)
      181       p-output-display = (buf_dis-rule.sts = integer('0':U))
      182       p-tree = buf_Dis-rule.uniq-field
      183       p-other = buf_dis-rule.other-inf
      184       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      185       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      186                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      187                    else '')
      188       .
      189     end.
      190   end procedure.
      191   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      192   procedure disrules-fill-properties:
      193   define input  parameter p-templ-rl-root as integer   no-undo .
      194   define buffer buf_drt-prop for ub.drt-prop.
      195   define buffer buf_temp-drt-prop for temp-drt-prop.
      196   do
      197   on error undo, return error return-value
      198   :
      199     for each buf_temp-drt-prop:
      200       delete buf_temp-drt-prop.
      201     end.
      202     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      203       create buf_temp-drt-prop.
      204       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      205     end.
      206   end.
      207   end procedure.
      208   procedure disrules-get-interface-form :
      209   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
      210   define output parameter p-form-name as character no-undo .
      211   define buffer buf_temp-drt-prop for temp-drt-prop.
      212   define buffer buf_drt-prop for ub.drt-prop.
      213   find first buf_temp-drt-prop where
      214             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
      215         and buf_temp-drt-prop.upper-prop-code = "InputForm"
      216         and buf_temp-drt-prop.prop-code = "FormName" no-error.
      217   if not available buf_temp-drt-prop then do:
      218     find first buf_drt-prop where
      219               buf_drt-prop.templ-rl-root = p-templ-rl-root
      220           and buf_drt-prop.upper-prop-code = "InputForm"
      221           and buf_drt-prop.prop-code = "FormName" no-error.
      222     if available buf_drt-prop then do:
      223       p-form-name = buf_drt-prop.property-value.
      224     end.
      225     else do:
      226       p-form-name = "ref/dis-ruli.w".
      227     end.
      228   end.
      229   else do:
      230     p-form-name = buf_temp-drt-prop.property-value.
      231   end.
      232   end procedure.
      233   ~
      234   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      235   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      236   ~
      237   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      238   procedure discfgru-check :
      239   define input parameter p-table-name as character no-undo .
      240   define input parameter p-templ-rl-root as integer no-undo .
      241   define input parameter p-time-templ-rl-root as integer no-undo .
      242   define input parameter p-pos-type as character no-undo .
      243   define output parameter p-disnct-role as character no-undo .
      244   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      245     do
      246     on error undo, return error return-value
      247     :
      248       find first buf_dis-cfg-rule no-lock where
      249               buf_dis-cfg-rule.table-name = p-table-name
      250           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      251           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      252           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      253       if not available buf_dis-cfg-rule
      254       or p-pos-type = "":U
      255       then do:
      256          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      257                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      258                                  , p-templ-rl-root
      259                                  , (if p-time-templ-rl-root = ?
      260                                     then '':U
      261                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      262                                     )
      263                                  ).
      264       end.
      265       assign
      266       p-disnct-role = buf_dis-cfg-rule.discnt-role
      267       .
      268     end.
      269   end procedure.
      270   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      271   FUNCTION get-region RETURNS CHARACTER
      272     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      273     define variable par-region as character no-undo.
      274     if parhost-code = 0 and
      275          parobj-type = "":U and
      276          parobj-code = 0 then do:
      277          par-region = "Глобально".
      278          return par-region.
      279       end.
      280       if parobj-type = 'орг':U then do:
      281          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      282          return par-region.
      283       end.
      284       if parobj-type = 'регион':U
      285       then do:
      286          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      287          return par-region.
      288       end.
      289       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      290       return par-region.
      291   END FUNCTION.
      292   FUNCTION get-objregion RETURNS CHARACTER
      293     (  input parobj-type as character, input parobj-code as integer ) :
      294     define variable par-region as character no-undo.
      295     if  parobj-type = "":U and
      296         parobj-code = 0
      297     then do:
      298        par-region = "Глобально".
      299     end.
      300     else if parobj-type = 'орг':U
      301     then do:
      302        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      303     end.
      304     else if parobj-type = 'регион':U
      305     then do:
      306        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      307     end.
      308     else
      309        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      310     return par-region.
      311   END FUNCTION.
      312   procedure disgdsru-name :
      313   define buffer buf_dis-rule for ub.dis-rule.
      314   do
      315     on error undo, return error
      316     :
      317     define input  parameter p-templ-rl-root  as integer no-undo .
      318     define output parameter p-label          as character no-undo .
      319     find first buf_dis-rule no-lock where
      320               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      321     if available buf_dis-rule
      322     then do:
      323       if buf_dis-rule.rule-num > 0 then
      324       p-label = buf_dis-rule.des.
      325     end.
      326     else do:
      327       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
      328     end.
      329   end.
      330   end procedure.
      331   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
      332   define variable v-rule-label as character no-undo .
      333   run disgdsru-name in this-procedure ( input p-templ-rl-root
      334                                        ,output v-rule-label) no-error.
      335   return v-rule-label.
      336   end function.
      337   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
      338   define variable v-rule-label as character no-undo .
      339   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
      340   end function.
      341   procedure disgdsru-write :
      342     do
      343     on error undo, return error
      344     :
      345       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
      346       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
      347       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
      348       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
      349       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
      350       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
      351       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
      352       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
      353       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
      354       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
      355       define buffer buf_dis-rule for ub.dis-rule.
      356       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
      357       define variable v-label          as character no-undo .
      358       define variable v-discnt-role as character no-undo .
      359       run discfgru-check in this-procedure (
      360                                             input 'dis-gds-rule':U
      361                                            ,input p-templ-rl-root
      362                                            ,input p-time-templ-rl-root
      363                                            ,input p-pos-type
      364                                            ,output v-discnt-role
      365                                             ) no-error .
      366       if error-status :error then do:
      367         undo, return error return-value .
      368       end.
      369       if p-discnt-role = ? then do:
      370         p-discnt-role = v-discnt-role.
      371       end.
      372       if p-discnt-role <> v-discnt-role then do:
      373         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
      374                                 ,p-gds-code
      375                                 ,p-obj-type
      376                                 ,p-obj-code
      377                                 ,p-pos-type
      378                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      379                                 ,chr(10)
      380                                 ,p-templ-rl-root
      381                                 ,p-rule-num).
      382       end.
      383       if p-pos-type = ? then do:
      384   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      385   define variable v-param-type6 as character no-undo .
      386   define variable v-value-date6 as date no-undo .
      387   define variable v-value-decimal6 as decimal no-undo .
      388   define variable v-value-integer6 as INTEGER no-undo .
      389   define variable v-value-logical6 AS LOGICAL no-undo .
      390   define variable v-tth6 as handle no-undo .
      391   run adm/shattri.p (
      392       input "get":U
      393       ,input  p-obj-type
      394       ,input  p-obj-code
      395       ,input  'cd-sending':U
      396       ,input  'dflt-cd':U
      397       ,output p-pos-type
      398       ,output v-value-date6
      399       ,output v-value-decimal6
      400       ,output v-value-integer6
      401       ,output v-value-logical6
      402       ,output v-param-type6
      403       ,INPUT-OUTPUT table-handle v-tth6
      404       )  .
      405   delete object v-tth6 no-error.
      406       end.
      407       find first buf_dis-rule no-lock where
      408                 buf_dis-rule.rule-num = p-rule-num no-error.
      409       if not available buf_Dis-rule then do:
      410         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
      411                                 ,p-gds-code
      412                                 ,p-obj-type
      413                                 ,p-obj-code
      414                                 ,p-pos-type
      415                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      416                                 ,chr(10)
      417                                 ,p-rule-num).
      418       end.
      419       if buf_dis-rule.root <> yes then do:
      420         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
      421                                 ,p-gds-code
      422                                 ,p-obj-type
      423                                 ,p-obj-code
      424                                 ,p-pos-type
      425                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      426                                 ,chr(10)
      427                                 ,p-rule-num).
      428       end.
      429       if not (p-obj-type = buf_dis-rule.obj-type
      430           and p-obj-code = buf_dis-rule.obj-code)
      431       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
      432                and
      433                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
      434        then do:
      435         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
      436                                 ,p-gds-code
      437                                 ,p-obj-type
      438                                 ,p-obj-code
      439                                 ,p-pos-type
      440                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      441                                 ,chr(10)
      442                                 ) +
      443                             substitute("Правило скидки &1 определено для &2&3" +
      444                                        "а привязка к товару для &4"
      445                                        ,buf_dis-rule.rule-num
      446                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
      447                                        ,chr(10)
      448                                        ,get-objregion( p-obj-type, p-obj-code)
      449                                        ))
      450                                 .
      451       end.
      452       find first buf_dis-gds-rule exclusive-lock where
      453                  buf_dis-gds-rule.gds-code  = p-gds-code
      454              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
      455              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
      456              AND buf_dis-gds-rule.pos-type  = p-pos-type
      457              AND buf_dis-gds-rule.discnt-role = p-discnt-role
      458              and buf_dis-gds-rule.nonunique = p-nonunique
      459              no-error .
      460       if not available buf_dis-gds-rule then do:
      461         find first buf_dis-gds-rule exclusive-lock where
      462                   buf_dis-gds-rule.gds-code  = p-gds-code
      463               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
      464               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
      465               AND buf_dis-gds-rule.pos-type  = p-pos-type
      466               AND buf_dis-gds-rule.discnt-role = p-discnt-role
      467               no-error .
      468         if available buf_Dis-gds-rule then do:
      469           if p-nonunique = ''
      470           and available buf_dis-gds-rule
      471           then do:
      472             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
      473                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      474                                      , p-gds-code
      475                                      , buf_Dis-rule.obj-type
      476                                      , buf_Dis-rule.obj-code
      477                                      , p-nonunique
      478                                     ).
      479           end.
      480           if available buf_dis-gds-rule
      481           and buf_dis-gds-rule.nonunique = ''
      482           and p-nonunique <> ''then do:
      483             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
      484                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
      485                                      , p-gds-code
      486                                      , buf_Dis-rule.obj-type
      487                                      , buf_Dis-rule.obj-code
      488                                     ).
      489           end.
      490         end.
      491         create buf_dis-gds-rule .
      492         assign
      493         buf_dis-gds-rule.gds-code  = p-gds-code
      494         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
      495         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
      496         buf_dis-gds-rule.pos-type = p-pos-type
      497         buf_dis-gds-rule.discnt-role = v-discnt-role
      498         buf_dis-gds-rule.rule-num = p-rule-num
      499         buf_dis-gds-rule.nonunique = p-nonunique
      500         no-error
      501         .
      502       end.
      503       ASSIGN
      504       buf_dis-gds-rule.rule-num = p-rule-num
      505       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
      506       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
      507       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
      508       buf_dis-gds-rule.nonunique = p-nonunique
      509       no-error.
      510     end.
      511   end procedure.
      512   PROCEDURE cmp-disgdsru-write :
      513   do
      514   on error undo, return error
      515   :
      516     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
      517     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
      518     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
      519     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
      520     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
      521     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
      522     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
      523     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
      524     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
      525     define variable v-rule-label          as character no-undo .
      526     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
      527     define buffer buf_dis-rule     for ub.dis-rule.
      528     run disgdsru-name in this-procedure (
      529                                         input  p-templ-rl-root
      530                                         ,output v-rule-label
      531                                         ) no-error .
      532     if error-status :error then do:
      533       undo, return error return-value .
      534     end.
      535     find first buf_tt0-dis-gds-rule exclusive-lock where
      536                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
      537             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
      538             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
      539             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
      540             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
      541             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
      542             no-error .
      543     if not available buf_tt0-dis-gds-rule then do:
      544       create buf_tt0-dis-gds-rule .
      545       assign
      546       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
      547       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
      548       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
      549       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
      550       buf_tt0-dis-gds-rule.nonunique = p-nonunique
      551       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
      552       no-error
      553       .
      554     end.
      555     find first buf_dis-rule no-lock where
      556               buf_dis-rule.rule-num = p-rule-num.
      557     ASSIGN
      558     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
      559     buf_tt0-dis-gds-rule.rule-num = p-rule-num
      560     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
      561     buf_tt0-dis-gds-rule.nonunique = p-nonunique
      562     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
      563     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
      564     no-error.
      565     release buf_tt0-dis-gds-rule no-error .
      566     if error-status:error then do:
      567       undo, return error return-value .
      568     end.
      569   end.
      570   END PROCEDURE.
      571   procedure disgdsru-edit :
      572   define input parameter p-mode as character no-undo .
      573   define input parameter p-gds-code like ub.dis-gds-rule.gds-code no-undo .
      574   define input parameter p-obj-type like ub.dis-gds-rule.obj-type no-undo .
      575   define input parameter p-obj-code like ub.dis-gds-rule.obj-code no-undo .
      576   define input parameter p-pos-type like ub.dis-gds-rule.pos-type no-undo .
      577   define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
      578   define input parameter p-templ-rl-root like ub.dis-gds-rule.templ-rl-root no-undo .
      579   define input parameter p-time-templ-rl-root like ub.dis-gds-rule.time-templ-rl-root no-undo .
      580   define input parameter p-cfg-NONUNIQUE as character no-undo .
      581   define input parameter p-check as integer no-undo .
      582   define input-output parameter p-rule-num as integer no-undo .
      583   define input-output parameter p-NONUNIQUE like ub.dis-gds-rule.NONUNIQUE no-undo .
      584   define output parameter p-setted as logical no-undo .
      585   define variable v-sts as integer no-undo .
      586   define variable v-rid-list as character no-undo .
      587   define variable r-b-code like ub.bar-code.b-code no-undo .
      588   define variable v-label as character no-undo .
      589   DEFINE VARIABLE v-rule-num as integer no-undo .
      590   define variable v-cd-dr-correct  as logical no-undo .
      591   define variable jj as integer no-undo .
      592   define variable conf-par as character no-undo .
      593   define variable conf-attr as character no-undo .
      594   define variable par-type as character no-undo .
      595   define variable dflt-cd as character no-undo .
      596   define variable v-cd-list as character no-undo .
      597   define variable v-is-time-rule as logical no-undo .
      598   define variable v-nonunique as character no-undo .
      599   define variable v-mode as character no-undo .
      600   define variable v-time-templ-rl-root as integer   no-undo .
      601   define variable v-cfg-nonunique as character no-undo .
      602   define buffer buf_dis-gds-rule for ub.dis-gds-rule.
      603   define buffer buf_dis-rule for ub.dis-rule.
      604   define buffer buf_dis-time-rule for ub.dis-time-rule .
      605   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      606   define buffer term_dis-rule for ub.dis-rule.
      607   define buffer buf_temp-odisc for temp-odisc.
      608   assign
      609   v-rule-num = p-rule-num.
      610   v-sts = integer('0':U).
      611   if v-rule-num <> 0
      612   and v-rule-num <> ?
      613   then do:
      614     find first buf_dis-rule no-lock where
      615               buf_dis-rule.rule-num = v-rule-num no-error .
      616     if error-status:error then do:
      617       message
      618       "Ошибка при поиске правила с номером" v-rule-num
      619       view-as alert-box error .
      620       return .
      621     end.
      622     assign
      623     v-rid-list = string(recid(buf_dis-rule))
      624     .
      625   end.
      626   if p-gds-code <> 0 then do:
      627   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      628     (input  p-gds-code
      629     ,input  ?
      630     ,output r-b-code
      631     )  .
      632   end.
      633   run disgdsru-name in this-procedure (
      634                                     input p-templ-rl-root
      635                                    ,output v-label) no-error.
      636   if p-pos-type = ?
      637   or p-pos-type = '':U then do:
      638   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      639   define variable v-param-type7 as character no-undo .
      640   define variable v-value-date7 as date no-undo .
      641   define variable v-value-decimal7 as decimal no-undo .
      642   define variable v-value-integer7 as INTEGER no-undo .
      643   define variable v-value-logical7 AS LOGICAL no-undo .
      644   define variable v-tth7 as handle no-undo .
      645   run adm/shattri.p (
      646       input "get":U
      647       ,input  p-obj-type
      648       ,input  p-obj-code
      649       ,input  'cd-sending':U
      650       ,input  'dflt-cd':U
      651       ,output dflt-cd
      652       ,output v-value-date7
      653       ,output v-value-decimal7
      654       ,output v-value-integer7
      655       ,output v-value-logical7
      656       ,output v-param-type7
      657       ,INPUT-OUTPUT table-handle v-tth7
      658       )  .
      659   delete object v-tth7 no-error.
      660   end.
      661   else do:
      662     dflt-cd = p-pos-type.
      663   end.
      664   v-mode = (if p-obj-type = 'маг':U
      665             or p-obj-type = 'скл':U
      666             then (if p-gds-code = 0 then "upper-rule-num-all-obj" else "upper-rule-num-gds-obj":U)
      667             else ('dis-gds-rule':U + "=" + p-discnt-role)).
      668   if p-discnt-role <> ''
      669   and p-pos-type <> '' then do:
      670     find first buf_dis-cfg-rule no-lock where
      671               buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
      672           and buf_dis-cfg-rule.discnt-role = p-discnt-role
      673           and buf_dis-cfg-rule.pos-type = p-pos-type
      674           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      675           no-error .
      676     if available buf_dis-cfg-rule then do:
      677       assign
      678       v-cfg-nonunique = buf_dis-cfg-rule.nonunique.
      679     end.
      680   end.
      681   if v-cfg-nonunique <> ''
      682   and num-entries(v-cfg-nonunique, ".") > 1
      683   then do:
      684     case v-cfg-nonunique:
      685       when "bar-code.b-code" then do:
      686         r-b-code = integer(p-nonunique).
      687       end.
      688     end case.
      689   end.
      690   run ref/dis-ruls.w (
      691                input parparentproc
      692               ,input 0
      693               ,input p-obj-type
      694               ,input p-obj-code
      695               ,input "b-add,b-sel":U
      696               ,input v-mode
      697               ,input p-templ-rl-root
      698               ,input p-time-templ-rl-root
      699               ,input r-b-code
      700               ,input-output v-sts
      701               ,input-output v-rid-list ) no-error .
      702   do
      703   on error undo, return error return-value
      704   :
      705     if v-rid-list <> "":U then do:
      706       find first buf_dis-rule exclusive-lock where
      707                   recid(buf_dis-rule) = integer(v-rid-list) no-wait no-error .
      708       if not available buf_dis-rule
      709       then do:
      710         message
      711         "Ошибка при поиске правила с recid" v-rid-list
      712         view-as alert-box error .
      713         return .
      714       end.
      715       if buf_dis-rule.sts <> integer('0':U) then do:
      716         message
      717         "Правило скидки имеет статус" entry (lookup (string(buf_dis-rule.sts), '0,1,2,99,98':U), 'исп,не-исп,детализ,удаление,запр.удал':U) skip
      718         "Нельзя привязать к нему скидку на товар"
      719         view-as alert-box error .
      720         return .
      721       end.
      722       find first buf_dis-cfg-rule no-lock where
      723               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      724           and buf_dis-cfg-rule.time-templ-rl-root = (if buf_dis-rule.time-templ-rl-root = 0
      725                                                      then 0
      726                                                      else buf_dis-rule.time-templ-rl-root)
      727           and buf_dis-cfg-rule.pos-type = dflt-cd
      728           and buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
      729           no-error.
      730       if available buf_dis-cfg-rule then do:
      731         assign
      732         v-cd-dr-correct = yes
      733         .
      734       end.
      735       else do:
      736          if buf_dis-rule.is-term = no then do:
      737            for each term_dis-rule no-lock where
      738               term_dis-rule.upper-rule-num = buf_dis-rule.rule-num:
      739              find first buf_dis-cfg-rule no-lock where
      740                     buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      741                 and buf_dis-cfg-rule.time-templ-rl-root = term_dis-rule.time-templ-rl-root
      742                 and buf_dis-cfg-rule.pos-type = dflt-cd
      743                 and buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
      744                 no-error.
      745              if available buf_dis-cfg-rule
      746              and v-time-templ-rl-root = 0
      747              then do:
      748                 v-time-templ-rl-root = term_dis-rule.time-templ-rl-root.
      749                 v-cd-dr-correct = yes.
      750              end.
      751              if not available buf_dis-cfg-rule
      752              or v-time-templ-rl-root <> term_dis-rule.time-templ-rl-root then do:
      753                v-cd-dr-correct = no.
      754                leave.
      755              end.
      756            end.
      757          end.
      758       end.
      759       if not v-cd-dr-correct
      760       then do:
      761         message
      762         substitute("Правило скидки &1 неприменимо для касс &2.&3" +
      763                   "(АРМ АДМИНИСТРАТОР-Магазины(Фирмы)-Параметры-Общие опции коммуникации с кассами)"
      764                   ,buf_dis-rule.rule-num
      765                   ,dflt-cd
      766                   ,chr(10)
      767                   )
      768         view-as alert-box error .
      769         undo, return error .
      770       end.
      771       assign
      772       v-nonunique = if p-cfg-nonunique = '':U
      773                     then '':U
      774                     else (if p-cfg-nonunique begins "@"
      775                           then left-trim(p-cfg-nonunique, "@")
      776                           else string(buffer buf_Dis-rule:handle:buffer-field(p-cfg-nonunique):buffer-value)
      777                           )
      778                     .
      779       if p-check = 0
      780       or p-check = 2
      781       then do:
      782         find first buf_dis-gds-rule no-lock where
      783                     buf_dis-gds-rule.obj-type = p-obj-type
      784                 and buf_dis-gds-rule.obj-code = p-obj-code
      785                 and buf_dis-gds-rule.gds-code = p-gds-code
      786                 and buf_dis-gds-rule.pos-type = p-pos-type
      787                 and buf_dis-gds-rule.discnt-role = p-discnt-role
      788                 and buf_dis-gds-rule.nonunique = v-nonunique no-error .
      789         if available buf_dis-gds-rule
      790         and p-mode <> 'ИЗМЕНЕНИЕ':U
      791         then do:
      792           message
      793           "Скидка такого типа на данный товар уже существует"
      794           view-as alert-box error .
      795           return error.
      796         end.
      797         find first buf_dis-gds-rule no-lock where
      798                     buf_dis-gds-rule.obj-type = p-obj-type
      799                 and buf_dis-gds-rule.obj-code = p-obj-code
      800                 and buf_dis-gds-rule.gds-code = p-gds-code
      801                 and buf_dis-gds-rule.pos-type = p-pos-type
      802                 and buf_dis-gds-rule.discnt-role = p-discnt-role
      803                 no-error .
      804         if v-nonunique = ''
      805         and available buf_dis-gds-rule
      806         and p-mode <> 'ИЗМЕНЕНИЕ':U
      807         then do:
      808           message
      809           "Скидка такого типа на данный товар уже существует"
      810           view-as alert-box error .
      811           return error.
      812         end.
      813         if available buf_dis-gds-rule
      814         and buf_dis-gds-rule.nonunique = ''
      815         and v-nonunique <> ''
      816         and p-mode <> 'ИЗМЕНЕНИЕ':U
      817         then do:
      818           message
      819           "Скидка такого типа на данный товар уже существует"
      820           view-as alert-box error .
      821           return error.
      822         end.
      823       end.
      824       if p-check = 1
      825       or p-check = 2
      826       then do:
      827         find first buf_temp-odisc no-lock where
      828                     buf_temp-odisc.obj-type = p-obj-type
      829                 and buf_temp-odisc.obj-code = p-obj-code
      830                 and buf_temp-odisc.gds-code = p-gds-code
      831                 and buf_temp-odisc.pos-type = p-pos-type
      832                 and buf_temp-odisc.discnt-role = p-discnt-role
      833                 and buf_temp-odisc.nonunique = v-nonunique no-error .
      834         if available buf_temp-odisc
      835         and buf_temp-odisc.rule-num <> 0
      836         and p-mode <> 'ИЗМЕНЕНИЕ':U
      837         then do:
      838           message
      839           "Скидка такого типа на данный товар уже существует"
      840           view-as alert-box error .
      841           return error.
      842         end.
      843         find first buf_temp-odisc no-lock where
      844                     buf_temp-odisc.obj-type = p-obj-type
      845                 and buf_temp-odisc.obj-code = p-obj-code
      846                 and buf_temp-odisc.gds-code = p-gds-code
      847                 and buf_temp-odisc.pos-type = p-pos-type
      848                 and buf_temp-odisc.discnt-role = p-discnt-role
      849                 no-error .
      850         if v-nonunique = ''
      851         and available buf_temp-odisc
      852         and p-mode <> 'ИЗМЕНЕНИЕ':U
      853         then do:
      854           message
      855           "Скидка такого типа на данный товар уже существует"
      856           view-as alert-box error .
      857           return error.
      858         end.
      859         if available buf_temp-odisc
      860         and buf_temp-odisc.nonunique = ''
      861         and v-nonunique <> ''
      862         and p-mode <> 'ИЗМЕНЕНИЕ':U
      863         then do:
      864           message
      865           "Скидка такого типа на данный товар уже существует"
      866           view-as alert-box error .
      867           return error.
      868         end.
      869       end.
      870       if p-rule-num <> buf_dis-rule.rule-num then do:
      871         assign
      872         p-setted = yes
      873         p-rule-num = buf_dis-rule.rule-num
      874         p-nonunique = v-nonunique
      875         .
      876       end.
      877     end.
      878   end.
      879   end procedure.
      880   procedure dsp-dis-rule :
      881   define input parameter p-gds-code like ub.dis-gds-rule.gds-code no-undo .
      882   define input parameter p-nonunique as character no-undo .
      883   define input parameter p-obj-type like ub.dis-gds-rule.obj-type no-undo .
      884   define input parameter p-obj-code like ub.dis-gds-rule.obj-code no-undo .
      885   define input parameter p-discnt-role as character no-undo .
      886   define input parameter p-pos-type as character no-undo .
      887   define input parameter p-value like ub.dis-gds-rule.rule-num no-undo .
      888   define buffer buf_dis-rule for ub.dis-rule.
      889   DEFINE variable loc#log as logical no-undo.
      890   define variable loc-doc-rec as recid no-undo .
      891   define variable r-b-code like ub.bar-code.b-code no-undo .
      892   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      893   define variable v-cfg-nonunique as character no-undo .
      894     do
      895     on error undo, return error
      896     :
      897       find first buf_dis-rule no-lock where
      898                 buf_dis-rule.rule-num = p-value no-error .
      899       if not available buf_dis-rule then do:
      900         message substitute("Не найдено правило скидки с номером &1", p-value)
      901         view-as alert-box error .
      902         .
      903         return.
      904       end.
      905   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      906   do:
      907     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      908       (input  v-cntxt-db-num
      909       ,input  v-cntxt-userid
      910       ,input  0
      911       ,input  'actn_discount_work':U
      912       ,input  'global':U
      913       ,input  0
      914       ,input  '':U
      915       ,input  0
      916       ,input  0
      917       ,input  0
      918       ,input  0
      919       ,input  true
      920       ,output loc#log
      921       )  .
      922   end.
      923       if not loc#log then return error.
      924       ASSIGN
      925       loc-doc-rec = recid(buf_dis-rule)
      926       .
      927       if p-gds-code <> ? then do:
      928   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      929     (input  p-gds-code
      930     ,input  ?
      931     ,output r-b-code
      932     )  .
      933       end.
      934       define variable v-form-name as character no-undo init "ref/dis-ruli.w".
      935       run disrules-get-interface-form in this-procedure ( input buf_dis-rule.templ-rl-root
      936                                                         ,output v-form-name) .
      937       if p-discnt-role <> ''
      938       and p-pos-type <> '' then do:
      939         find first buf_dis-cfg-rule no-lock where
      940                   buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
      941               and buf_dis-cfg-rule.discnt-role = p-discnt-role
      942               and buf_dis-cfg-rule.pos-type = p-pos-type
      943               and buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      944               no-error .
      945         if available buf_dis-cfg-rule then do:
      946           assign
      947           v-cfg-nonunique = buf_dis-cfg-rule.nonunique.
      948         end.
      949       end.
      950       if v-cfg-nonunique <> ''
      951       and num-entries(v-cfg-nonunique, ".") > 1
      952       then do:
      953         case v-cfg-nonunique:
      954           when "bar-code.b-code" then do:
      955             r-b-code = integer(p-nonunique).
      956           end.
      957         end case.
      958       end.
      959       run value(v-form-name) (
      960                        input parparentproc
      961                       ,input 'ПРОСМОТР':U
      962                       ,input buf_dis-rule.templ-rl-root
      963                       ,input buf_dis-rule.host-code
      964                       ,input buf_dis-rule.obj-type
      965                       ,input buf_dis-rule.obj-code
      966                       ,input buf_dis-rule.rule-num
      967                       ,input buf_dis-rule.upper-rule-num
      968                       ,input r-b-code
      969                       ,input buf_dis-rule.time-templ-rl-root
      970                       ,input '':U
      971                       ,input-output loc-doc-rec
      972                                   )
      973       .
      974     end.
      975   end procedure.
      976   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
