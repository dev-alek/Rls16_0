     2583   procedure get-context :
     2584      define output parameter p-db-num as integer          no-undo.
     2585      define output parameter p-user-id as character        no-undo.
     2586      define variable v-login               as character    no-undo.
     2587      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2588      define buffer buf_user-login  for ub.user-login .
     2589      do
     2590      on error undo, return error
     2591      :
     2592            FIND FIRST buf_sys-ctrl no-lock.
     2593            ASSIGN
     2594               v-login = USERID("ub")
     2595               p-db-num = buf_sys-ctrl.db-num
     2596            .
     2597            FIND FIRST buf_user-login
     2598                 WHERE buf_user-login.db-num = p-db-num
     2599                   AND buf_user-login.user-login = v-login
     2600                 no-lock
     2601                 no-error
     2602                 .
     2603            IF AVAILABLE buf_user-login
     2604            THEN DO:
     2605               assign
     2606                  p-user-id = buf_user-login.user-id
     2607               .
     2608            END.
     2609      end.
     2610   end procedure.
