        1   block-level on error undo, throw.
        2   define input  parameter p-mode as character no-undo .
        3   define input  parameter p-silent as logical   no-undo .
        4   define input  parameter p-b-code as integer   no-undo .
        5   define input  parameter p-gds-code as integer   no-undo .
        6   define input  parameter p-node-code as integer   no-undo .
        7   define input  parameter p-part-code as character no-undo .
        8   define input  parameter p-in-code as character no-undo .
        9   define input  parameter p-unit-cli as character no-undo .
       10   define input  parameter p-cli-base-rate as decimal no-undo .
       11   define output parameter p-rid as recid no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       14   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: barcode1.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: ref/barcode1.p $":U .
       17   define variable vss-description as character no-undo init "".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$".
       88   procedure chk-b-code:
       89   define input parameter p-silence as logical no-undo .
       90   define input param b-c like ub.bar-code.b-code no-undo.
       91   define output param p-log as log no-undo.
       92     define variable l-code as integer no-undo.
       93     define variable v-mes as character no-undo .
       94     define variable v-param-type0 as character no-undo .
       95     define variable v-value-character0 as INTEGER no-undo .
       96     define variable v-value-date0 as date no-undo .
       97     define variable v-value-decimal0 as decimal no-undo .
       98     define variable v-value-integer0 AS integer no-undo .
       99     define variable v-value-logical0 AS LOGICAL no-undo .
      100     define variable v-tth0 as handle no-undo .
      101     define buffer buf_sys-ctrl for ub.sys-ctrl.
      102     define buffer b-c-r for ub.code-range.
      103     define buffer buf_code-range for ub.code-range .
      104     do
      105     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      106     on stop   undo , return error substitute( "&1. stop", vss-workfile )
      107     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
      108     :
      109       find first buf_sys-ctrl no-lock.
      110       p-log = no.
      111       run adm/shattri.p (
      112           input "get":U
      113           ,input  'БД':U
      114           ,input  buf_sys-ctrl.db-num
      115           ,input  'code-range':U
      116           ,input  'cdrgbcgb':U
      117           ,output v-value-character0
      118           ,output v-value-date0
      119           ,output v-value-decimal0
      120           ,output v-value-integer0
      121           ,output v-value-logical0
      122           ,output v-param-type0
      123           ,INPUT-OUTPUT table-handle v-tth0
      124           ) no-error .
      125       if error-status :error then do:
      126         delete object v-tth0.
      127         v-mes = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      128                            , error-status:get-message(1)
      129                            , chr(10)
      130                            , return-value ).
      131         if not p-silence then
      132         message
      133         v-mes
      134         view-as alert-box error.
      135         p-log = no.
      136         undo, return error v-mes.
      137       end.
      138       delete object v-tth0.
      139       find first buf_code-range
      140         where buf_code-range.range-type = 'bcgb':U
      141           and buf_code-range.last-code >= b-c
      142           and buf_code-range.db-num = g#db-num
      143       use-index last-codei
      144     no-lock no-error .
      145       if available buf_code-range and buf_code-range.first-code <= b-c then do:
      146         case buf_code-range.stts:
      147         when "a" then do:
      148             if buf_code-range.db-num <> buf_sys-ctrl.db-num then do:
      149             assign
      150             v-mes = substitute("Нельзя использовать активный диапазон чужой БД для генерации бар-кодов в БД").
      151             if not p-silence then
      152             message v-mes
      153             view-as alert-box error.
      154             p-log = no.
      155             undo, return error v-mes.
      156           end.
      157           p-log = yes.
      158         end.
      159         when "f" then do:
      160             if buf_code-range.db-num = -1
      161             or buf_code-range.db-num <> buf_sys-ctrl.db-num
      162             then do:
      163             assign
      164               v-mes = substitute("Нельзя использовать свободный диапазон БД для генерации бар-кодов:&1" +
      165                                  "текущая БД &2, диапазон (&3 - &4) для БД &5&1"
      166                                  ,chr(10)
      167                                  ,buf_sys-ctrl.db-num
      168                                  ,buf_code-range.first-code
      169                                  ,buf_code-range.last-code
      170                                  ,buf_code-range.db-num
      171                                  ).
      172             if not p-silence then
      173             message v-mes
      174             view-as alert-box error.
      175             p-log = no.
      176             undo, return error v-mes .
      177           end.
      178             find b-c-r where recid(b-c-r) = recid(buf_code-range) exclusive no-error.
      179           if (not available b-c-r) or (b-c-r.db-num <> buf_sys-ctrl.db-num) then do:
      180             p-log = no.
      181             undo, return error.
      182           end.
      183           assign
      184             b-c-r.stts = "u"
      185               b-c-r.db-num = buf_sys-ctrl.db-num
      186             p-log = yes.
      187         end.
      188         when "u" then do:
      189             if (buf_code-range.db-num > 0 and buf_sys-ctrl.db-num = 0) or
      190                (buf_sys-ctrl.db-num <> 0 and buf_code-range.db-num <> buf_sys-ctrl.db-num)  then do:
      191             assign
      192             v-mes = substitute("Нельзя использовать использованный чужой диапазон БД для генерации бар-кодов в БД").
      193             if not p-silence then
      194             message v-mes
      195             view-as alert-box error.
      196             p-log = no.
      197             undo, return error v-mes.
      198           end.
      199           assign
      200             p-log = yes.
      201         end.
      202       end case.
      203     end.
      204       else do:
      205         if buf_sys-ctrl.db-num <> 0 then do:
      206         assign
      207         v-mes = substitute("Нельзя создавать диапазоны в УБД ").
      208         if not p-silence then
      209         message v-mes
      210         view-as alert-box error.
      211         undo, return error v-mes.
      212       end.
      213       find first buf_code-range
      214         where buf_code-range.range-type = 'bcgb':U
      215           and buf_code-range.last-code >= b-c
      216           and buf_code-range.first-code <= b-c
      217       no-lock no-error .
      218       if available buf_code-range
      219       and buf_code-range.db-num <> g#db-num then do:
      220         assign
      221         v-mes = substitute("Диапазон для кода &1 (&2-&3) принадлежит БД &4"
      222                             , b-c
      223                             , buf_code-range.first-code
      224                             , buf_code-range.last-code
      225                             , buf_code-range.db-num
      226                     ).
      227         if not p-silence then
      228         message v-mes
      229         view-as alert-box error.
      230         undo, return error v-mes.
      231       end.
      232         _l-code:
      233         do while true :
      234           run new-bcod-gen-code-range in this-procedure ( input g#db-num
      235                                                          ,input 'bcgb':U).
      236           find first buf_code-range where
      237             buf_code-range.range-type = 'bcgb':U
      238               and buf_code-range.db-num = g#db-num
      239               and buf_code-range.last-code >= b-c
      240               and buf_code-range.first-code <= b-c  no-lock no-error .
      241           if available buf_code-range then do:
      242             find b-c-r where recid(b-c-r) = recid(buf_code-range) exclusive .
      243             b-c-r.stts = 'u':U.
      244             p-log = yes.
      245             leave _l-code.
      246           end.
      247       end.
      248     end.
      249   end.
      250   end procedure.
      251   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      252   procedure gen-b-code :
      253     define input  parameter type-code like ub.code-range.range-type no-undo .
      254     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      255     do
      256     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      257     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      258     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      259     :
      260       define buffer buf_thbj-attr     for ub.thbj-attr .
      261       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      262       define buffer buf_code-range for ub.code-range .
      263       define variable l-code         as   integer              no-undo .
      264       define variable v-db-num       like ub.db.db-num         no-undo .
      265       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      266       if type-code = 'sslc':U
      267       or type-code = 'ssgb':U
      268       then do:
      269         message
      270           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      271           "Обратитесь к администратору системы."
      272           view-as alert-box error .
      273         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      274       end.
      275       run trg/getpcode.p ( input  type-code
      276                      ,output cfg-param-code
      277                     ).
      278       run get-next-seq( input  type-code,
      279                         output l-code
      280                       ).
      281       find first buf_sys-ctrl no-lock.
      282       if type-code = 'sclc':U
      283       or type-code = 'pglc':U
      284       then do:
      285         assign
      286           v-db-num = 0
      287         .
      288       end.
      289       else do:
      290         assign
      291           v-db-num = buf_sys-ctrl.db-num
      292         .
      293       end.
      294       find first buf_code-range no-lock
      295         where buf_code-range.db-num     = v-db-num
      296           and buf_code-range.range-type = type-code
      297           and buf_code-range.stts       = "a"
      298         use-index stts
      299         no-error .
      300       if available buf_code-range
      301          and l-code <= buf_code-range.last-code
      302          and l-code >= buf_code-range.first-code then do:
      303         assign
      304           p-b-code = l-code
      305         .
      306       end.
      307       else do:
      308         if available buf_code-range
      309            and l-code < buf_code-range.last-code then do:
      310           message
      311             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      312             "Обратитесь к администратору системы."
      313             view-as alert-box error .
      314           undo, return error "sequence":U .
      315         end.
      316         do transaction
      317         on error undo, return error
      318         :
      319           find first buf_thbj-attr exclusive-lock
      320             where buf_thbj-attr.upper-prop-code = 'code-range':U
      321               and buf_thbj-attr.prop-code = cfg-param-code
      322               and buf_thbj-attr.obj-type   = 'БД':U
      323               and buf_thbj-attr.obj-code   = v-db-num
      324             no-error .
      325           if not available buf_thbj-attr then do:
      326             find first buf_thbj-attr exclusive-lock
      327               where buf_thbj-attr.upper-prop-code = 'code-range':U
      328                 and buf_thbj-attr.prop-code = cfg-param-code
      329                 and buf_thbj-attr.obj-type   = ''
      330                 and buf_thbj-attr.obj-code   = 0
      331               no-error .
      332             if not available buf_thbj-attr then do:
      333               if not locked buf_thbj-attr then do:
      334                 message
      335                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      336                   "Обратитесь к администратору системы."
      337                   view-as alert-box error .
      338               end.
      339               undo, return error "config":U .
      340             end.
      341           end.
      342           run get-next-seq( input type-code,
      343                             output l-code
      344                           ).
      345           find first buf_code-range
      346             where buf_code-range.db-num     = v-db-num
      347               and buf_code-range.range-type = type-code
      348               and buf_code-range.stts       = "a"
      349             use-index stts
      350             no-error .
      351           if available buf_code-range
      352           and l-code <= buf_code-range.last-code
      353           and l-code >= buf_code-range.first-code
      354           then do:
      355             assign
      356               p-b-code = l-code
      357             .
      358           end.
      359           else do:
      360             if available buf_code-range then do:
      361               assign
      362                 buf_code-range.stts = "u"
      363               .
      364             end.
      365             find first buf_code-range
      366               where buf_code-range.db-num     = v-db-num
      367                 and buf_code-range.range-type = type-code
      368                 and buf_code-range.stts       = "f"
      369               use-index stts
      370               no-error .
      371             if not available buf_code-range then do:
      372               message
      373                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      374                 "Обратитесь к администратору системы"
      375                 view-as alert-box error .
      376               undo, return error "code-range":U .
      377             end.
      378             assign
      379               buf_code-range.stts           = "a"
      380             .
      381             if buf_code-range.first-code = 1 then do:
      382               run set-seq-cr( input type-code,
      383                               input buf_code-range.first-code
      384                             ).
      385               assign
      386                 p-b-code = 1
      387               .
      388             end.
      389             else do:
      390               run set-seq-cr( input type-code,
      391                               input ( buf_code-range.first-code - 1 )
      392                             ).
      393               run get-next-seq( input type-code,
      394                                 output p-b-code
      395                               ).
      396             end.
      397           end.
      398         end.
      399       end.
      400     end.
      401   end procedure.
      402   procedure get-next-seq :
      403     define input  parameter type-code like ub.code-range.range-type no-undo .
      404     define output parameter next-seq  as   integer                  no-undo .
      405     do
      406     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      407     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      408     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      409     :
      410       case type-code:
      411         when 'bcgb':U then do:
      412           assign
      413             next-seq = next-value(s-bcgb-code, ub)
      414           .
      415         end.
      416         when 'scgb':U then do:
      417           assign
      418             next-seq = next-value(s-scgb-code, ub)
      419           .
      420         end.
      421         when 'sclc':U then do:
      422           assign
      423             next-seq = next-value(s-sclc-code, ub)
      424           .
      425         end.
      426         when 'pglc':U then do:
      427           assign
      428             next-seq = next-value(s-pglc-code, ub)
      429           .
      430         end.
      431         when 'dcgb':U then do:
      432           assign
      433             next-seq = next-value(s-dcgb-code, ub)
      434           .
      435         end.
      436         when 'ctgb':U then do:
      437           assign
      438             next-seq = next-value(s-ctgb-code, ub)
      439           .
      440         end.
      441         when 'drgb':U then do:
      442           assign
      443             next-seq = next-value(s-drgb-code, ub)
      444           .
      445         end.
      446         when 'fmgb':U then do:
      447           assign
      448             next-seq = next-value(s-fmgb-code, ub)
      449           .
      450         end.
      451         when 'pngb':U then do:
      452           assign
      453             next-seq = next-value(s-pngb-code, ub)
      454           .
      455         end.
      456         when 'cagb':U then do:
      457           assign
      458             next-seq = next-value(s-cagb-code, ub)
      459           .
      460         end.
      461         when 'fdgb':U then do:
      462           assign
      463             next-seq = next-value(s-fin-doc, ub)
      464           .
      465         end.
      466       end case.
      467     end.
      468   end procedure.
      469   procedure set-seq-cr :
      470     define input parameter type-code like ub.code-range.range-type no-undo .
      471     define input parameter set-val   like ub.code-range.first-code no-undo .
      472     do
      473     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      474     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      475     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      476     :
      477       case type-code:
      478         when 'bcgb':U then do:
      479           assign
      480             current-value(s-bcgb-code, ub) = set-val
      481           .
      482         end.
      483         when 'scgb':U then do:
      484           assign
      485             current-value(s-scgb-code, ub) = set-val
      486           .
      487         end.
      488         when 'sclc':U then do:
      489           assign
      490             current-value(s-sclc-code, ub) = set-val
      491           .
      492         end.
      493         when 'pglc':U then do:
      494           assign
      495             current-value(s-pglc-code, ub) = set-val
      496           .
      497         end.
      498         when 'dcgb':U then do:
      499           assign
      500             current-value(s-dcgb-code, ub) = set-val
      501           .
      502         end.
      503         when 'ctgb':U then do:
      504           assign
      505             current-value(s-ctgb-code, ub) = set-val
      506           .
      507         end.
      508         when 'drgb':U then do:
      509           assign
      510             current-value(s-drgb-code, ub) = set-val
      511           .
      512         end.
      513         when 'fmgb':U then do:
      514           assign
      515             current-value(s-fmgb-code, ub) = set-val
      516           .
      517         end.
      518         when 'pngb':U then do:
      519           assign
      520             current-value(s-pngb-code, ub) = set-val
      521           .
      522         end.
      523         when 'cagb':U then do:
      524           assign
      525             current-value(s-cagb-code, ub) = set-val
      526           .
      527         end.
      528         when 'fdgb':U then do:
      529           assign
      530             current-value(s-fin-doc, ub) = set-val
      531           .
      532         end.
      533       end case.
      534     end.
      535   end procedure.
      536   procedure new-bcod-gen-code-range :
      537     do
      538     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      539     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      540     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      541     :
      542       define input parameter p-db-num  like ub.db.db-num             no-undo .
      543       define input parameter type-code like ub.code-range.range-type no-undo .
      544       define buffer buf_code-range      for ub.code-range .
      545       define buffer last_code-range     for ub.code-range .
      546       define buffer last-1_code-range   for ub.code-range .
      547       define buffer last-2_code-range   for ub.code-range .
      548       define buffer last-3_code-range   for ub.code-range .
      549       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      550       define variable conf-par       as character no-undo .
      551       define variable par-type       as character no-undo .
      552       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      553       define variable v-cre-cdrg as logical   no-undo .
      554       define variable v-cre-str  as character no-undo .
      555       define variable v-cr1      as integer no-undo .
      556       define variable v-cr2      as integer no-undo .
      557       define variable v-cr3      as integer no-undo .
      558       define variable v-cmax     as integer no-undo .
      559       find first buf_sys-ctrl no-lock .
      560       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      561         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      562                                       ,vss-workfile
      563                                       ,vss-revision
      564                                       ,vss-description
      565                                       ,chr(10)
      566                                       , p-db-num
      567                                      ).
      568       end.
      569       run trg/getpcode.p ( input  type-code
      570                      ,output cfg-param-code
      571                     ).
      572       for each buf_code-range
      573         where buf_code-range.db-num     = -1
      574           and buf_code-range.range-type = type-code
      575           and buf_code-range.stts       = "f"
      576       by buf_code-range.first-code
      577       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      578       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      579       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      580       :
      581         assign
      582           buf_code-range.db-num = p-db-num
      583         .
      584         return .
      585       end.
      586       assign
      587         v-cre-cdrg = TRUE
      588       .
      589       case type-code:
      590         when 'sclc':U
      591         or when 'scgb':U
      592         or when 'pglc':U
      593         then do:
      594           find last last-1_code-range no-lock
      595             where last-1_code-range.range-type = 'sclc':U
      596             no-error .
      597           if available last-1_code-range then do:
      598             v-cr1 = last-1_code-range.last-code.
      599           end.
      600           find last last-2_code-range no-lock
      601             where last-2_code-range.range-type = 'scgb':U
      602             no-error .
      603           if available last-2_code-range then do:
      604             v-cr2 = last-2_code-range.last-code.
      605             end.
      606           find last last-3_code-range no-lock
      607             where last-3_code-range.range-type = 'pglc':U
      608             no-error .
      609           if available last-3_code-range then do:
      610             v-cr3 = last-3_code-range.last-code.
      611           end.
      612           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      613           .
      614           if v-cmax = v-cr1  then do:
      615               find last last_code-range no-lock
      616                 where recid( last_code-range ) = recid( last-1_code-range )
      617                 .
      618             end.
      619           if v-cmax = v-cr2  then do:
      620               find last last_code-range no-lock
      621                 where recid( last_code-range ) = recid( last-2_code-range )
      622                 .
      623             end.
      624           if v-cmax = v-cr3  then do:
      625             find last last_code-range no-lock
      626               where recid( last_code-range ) = recid( last-3_code-range )
      627               .
      628           end.
      629           if last_code-range.last-code + 1 > 99999 then do:
      630             assign
      631               v-cre-cdrg = FALSE
      632             .
      633           end.
      634         end.
      635         when 'bcgb':U
      636         or when 'sslc':U
      637         or when 'ssgb':U
      638         then do:
      639           find last last-1_code-range no-lock
      640             where last-1_code-range.range-type = 'sslc':U
      641             no-error .
      642           if available last-1_code-range then do:
      643             v-cr1 = last-1_code-range.last-code.
      644           end.
      645           find last last-2_code-range no-lock
      646             where last-2_code-range.range-type = 'bcgb':U
      647             no-error .
      648           if available last-2_code-range then do:
      649             v-cr2 = last-2_code-range.last-code.
      650             end.
      651           find last last-3_code-range no-lock
      652             where last-3_code-range.range-type = 'ssgb':U
      653             no-error .
      654           if available last-3_code-range then do:
      655             v-cr3 = last-3_code-range.last-code.
      656           end.
      657           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      658           .
      659           if v-cmax = v-cr1  then do:
      660               find last last_code-range no-lock
      661                 where recid( last_code-range ) = recid( last-1_code-range )
      662                 .
      663             end.
      664           if v-cmax = v-cr2  then do:
      665               find last last_code-range no-lock
      666                 where recid( last_code-range ) = recid( last-2_code-range )
      667                 .
      668             end.
      669           if v-cmax = v-cr3  then do:
      670             find last last_code-range no-lock
      671               where recid( last_code-range ) = recid( last-3_code-range )
      672               .
      673           end.
      674         end.
      675         otherwise do:
      676           find last last_code-range no-lock
      677             where last_code-range.range-type = type-code
      678             no-error .
      679         end.
      680       end case.
      681       if not available last_code-range then do:
      682         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      683                                       ,vss-workfile
      684                                       ,vss-revision
      685                                       ,vss-description
      686                                       , chr(10)
      687                                       , type-code
      688                                      ) .
      689       end.
      690       define variable v-mes1 as character no-undo .
      691       define variable v-param-type1 as character no-undo .
      692       define variable v-value-character1 as INTEGER no-undo .
      693       define variable v-value-date1 as date no-undo .
      694       define variable v-value-decimal1 as decimal no-undo .
      695       define variable v-value-integer1 AS integer no-undo .
      696       define variable v-value-logical1 AS LOGICAL no-undo .
      697       define variable v-tth1 as handle no-undo .
      698       run adm/shattri.p (
      699           input "get":U
      700           ,input  'БД':U
      701           ,input  p-db-num
      702           ,input  'code-range':U
      703           ,input  cfg-param-code
      704           ,output v-value-character1
      705           ,output v-value-date1
      706           ,output v-value-decimal1
      707           ,output v-value-integer1
      708           ,output v-value-logical1
      709           ,output v-param-type1
      710           ,INPUT-OUTPUT table-handle v-tth1
      711           ) no-error .
      712       if error-status :error then do:
      713         delete object v-tth1.
      714         v-mes1 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      715                            , error-status:get-message(1)
      716                            , chr(10)
      717                            , return-value ).
      718         undo, return error v-mes1.
      719       end.
      720       delete object v-tth1.
      721       if v-cre-cdrg = TRUE then do:
      722         create buf_code-range .
      723         assign
      724           buf_code-range.db-num     = p-db-num
      725           buf_code-range.range-type = type-code
      726           buf_code-range.stts       = "f"
      727           buf_code-range.first-code = last_code-range.last-code + 1
      728           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer1)
      729           v-cre-str = "Свободный диапазон успешно создан"
      730         .
      731       end.
      732       else do:
      733         assign
      734           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      735                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      736         .
      737       end.
      738     end.
      739     return v-cre-str .
      740   end procedure.
      741   procedure gen-new-code-range-if-neces :
      742     define input parameter v-db-num           like ub.db.db-num             no-undo .
      743     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      744     define input parameter v-cur-code         as   integer                  no-undo .
      745     define input parameter v-g#news           as   logical                  no-undo .
      746     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      747     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      748     do
      749     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      750     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      751     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      752     :
      753       define variable l-code-range-exist as logical   no-undo init false .
      754       define variable v-db-for-send      as character no-undo .
      755       define buffer buf_code-range  for ub.code-range .
      756       define buffer buf1_code-range for ub.code-range .
      757       define buffer buf_db          for ub.db .
      758       find first buf_code-range
      759         where buf_code-range.range-type = v-range-type
      760           and buf_code-range.last-code >= v-cur-code
      761         use-index last-codei
      762         no-error .
      763       if
      764       (
      765          available buf_code-range
      766          and
      767         (buf_code-range.db-num = v-db-num
      768           and
      769         buf_code-range.first-code <= v-cur-code
      770         )
      771       or
      772         (
      773           v-range-type = 'drgb':U
      774           AND
      775           v-cur-code = 0
      776         )
      777      )
      778      then do:
      779         assign
      780           l-code-range-exist = true
      781         .
      782         if v-g#news
      783         and buf_code-range.stts = "f" then do:
      784           assign
      785             buf_code-range.stts = "u"
      786           .
      787         end.
      788       end.
      789       if not l-code-range-exist
      790          and v-g#news-source-db <> 0
      791       then do:
      792         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      793                                       ,vss-workfile
      794                                       ,vss-revision
      795                                       ,vss-description
      796                                       ,chr(10)
      797                                       ,v-db-num
      798                                       ,v-range-type
      799                                       ,v-cur-code
      800                                      ).
      801       end.
      802       if (not l-code-range-exist
      803           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      804          )
      805       and ( not can-find (first buf1_code-range no-lock
      806                           where buf1_code-range.db-num = v-db-num
      807                             and buf1_code-range.range-type = v-range-type
      808                             and buf1_code-range.stts = "f"
      809                          )
      810           )
      811       then do:
      812         if v-g#db-num = 0 then do:
      813           run new-bcod-gen-code-range in this-procedure
      814             (input v-db-num,
      815              input v-range-type
      816             ) no-error .
      817           if error-status :error then do:
      818             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      819                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      820                                           ,v-db-num
      821                                           ,v-range-type
      822                                           ,v-cur-code
      823                                           ,chr(10)
      824                                           ,error-status:get-message(1)
      825                                           ,return-value
      826                                          ).
      827           end.
      828         end.
      829         else do:
      830           if v-range-type = 'sclc':U
      831           or v-range-type = 'pglc':U
      832           then do:
      833             assign
      834               v-db-for-send = "":U
      835             .
      836             if v-g#db-num = 0 then do:
      837               for each buf_db no-lock
      838                 where buf_db.db-num > 0
      839                   and buf_db.db-num <> v-g#news-source-db
      840               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      841               :
      842                 assign
      843                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      844                 .
      845               end.
      846               assign
      847                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      848               .
      849             end.
      850             else do:
      851               if not v-g#news then do:
      852                 assign
      853                   v-db-for-send = "0":U
      854                 .
      855               end.
      856             end.
      857             run nws/cr-route.p ( input 'send-cmd':U
      858                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      859                                  "code-range":U + chr(1) +
      860                                  (if v-range-type = 'sclc':U
      861                                   then string( current-value(s-sclc-code, ub))
      862                                   else string( current-value(s-pglc-code, ub))
      863                                   ) + chr(1) +
      864                                   v-range-type)
      865                           ,input ?
      866                           ,input v-db-for-send
      867                           ) no-error .
      868             if error-status :error then do:
      869               undo, return error return-value.
      870             end.
      871           end.
      872         end.
      873       end.
      874     end.
      875   end procedure.
      876   procedure cre-loc-sc-code-range :
      877     define input parameter v-cur-code as integer no-undo .
      878   define input parameter p-cdrg-type as character no-undo .
      879     do
      880     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      881     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      882     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      883     :
      884       define buffer buf_code-range for ub.code-range .
      885       find first buf_code-range
      886            where buf_code-range.range-type = p-cdrg-type
      887              and buf_code-range.first-code >= v-cur-code
      888            no-error .
      889       if not available buf_code-range then do:
      890         run new-bcod-gen-code-range in this-procedure
      891           ( input 0,
      892             input p-cdrg-type
      893           ) no-error .
      894         if error-status :error then do:
      895           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      896                                          + "Код &2&1&3 &4"
      897                                         , chr(10)
      898                                         , v-cur-code
      899                                         , error-status:get-message(1)
      900                                         , return-value
      901                                        ) .
      902         end.
      903       end.
      904     end.
      905   end procedure.
      906   procedure mark-used-if-need :
      907   define input parameter p-cur-code as integer no-undo .
      908   define input parameter p-range-type like ub.code-range.range-type no-undo .
      909   define input parameter p-db-num like ub.code-range.db-num no-undo .
      910     do
      911     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      912     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      913     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      914     :
      915       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      916       define buffer buf_code-range for ub.code-range .
      917       assign
      918       v-db-num = if p-range-type = 'sclc':U
      919                  then 0
      920                  else p-db-num
      921       .
      922   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      923   define buffer locK-batchprocess2 for ub.batchprocess.
      924   run gbl/lock-prc.p
      925       (input 'lscc':U
      926       ,input 0
      927       ,input 0
      928       ,input 0
      929       ,input ""
      930       ,input ""
      931       ,input ""
      932       ,input (
      933               ",,,Вкл/выкл лок. вес. кодов"
      934              )
      935       ,input true
      936       ,buffer lock-batchprocess2
      937       ) no-error .
      938     if error-status :error then do:
      939       message
      940         vss-workfile vss-revision vss-description skip
      941         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      942         view-as alert-box error .
      943       undo, return error .
      944     end.
      945       find first buf_code-range
      946            where buf_code-range.range-type = p-range-type
      947              and buf_code-range.first-code >= p-cur-code
      948              and buf_code-range.last-code <= p-cur-code
      949              and buf_code-range.db-num = v-db-num
      950            no-error .
      951       if not available buf_code-range then do:
      952         message
      953           vss-workfile vss-revision vss-description skip
      954           "Ошибка при создании поиске диапазона" skip
      955           "База данных" p-db-num skip
      956           "Код" p-cur-code skip
      957           "Тип" p-range-type
      958           error-status :get-message(1) skip
      959           return-value skip
      960           view-as alert-box error .
      961         undo, return error .
      962       end.
      963       if buf_code-range.stts = "f":U then do:
      964         assign
      965         buf_code-range.stts = "u":U
      966         .
      967       end.
      968     end.
      969   end procedure.
      970   define buffer buf_units for ub.units.
      971   define buffer base_units for ub.units.
      972   define buffer buf_goods for ub.goods.
      973   define buffer buf_bar-code for ub.bar-code.
      974   define buffer buf_gds-prt for ub.gds-prt.
      975   define variable v-err-mess as character no-undo .
      976   define variable v-is-new as logical no-undo .
      977   define variable v-import as logical   no-undo .
      978   define variable glog as logical   no-undo .
      979   main-block:
      980   do
      981   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      982   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      983   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      984   :
      985     if num-entries(p-mode) > 1 then do:
      986       assign
      987       v-import = (entry(2, p-mode) = 'ДОБАВЛЕНИЕ-ИМПОРТ':U).
      988       p-mode = entry(1, p-mode).
      989     end.
      990     if not ( p-mode = 'ДОБАВЛЕНИЕ':U or p-mode = 'ИЗМЕНЕНИЕ':U) then do:
      991       message vss-workfile vss-revision vss-description skip
      992               "Неверный параметр p-mode - " p-mode
      993       view-as alert-box error .
      994       return error '':u.
      995     end.
      996     find first buf_goods no-lock where
      997               buf_goods.gds-code = p-gds-code no-error .
      998     if not available buf_goods then do:
      999       v-err-mess = substitute("Не найден товар с кодом &1", p-gds-code).
     1000       run err-mess in this-procedure ( input-output v-err-mess).
     1001       undo, return error (if p-silent then v-err-mess else 'unit-cli').
     1002     end.
     1003     if p-unit-cli = ""
     1004     then do:
     1005       v-err-mess = "Не задана единица измерения.".
     1006       run err-mess in this-procedure ( input-output v-err-mess).
     1007       undo, return error (if p-silent then v-err-mess else 'unit-cli').
     1008     end.
     1009     find first buf_gds-prt no-lock where
     1010               buf_gds-prt.node-code = p-node-code no-error.
     1011     if not available buf_gds-prt then do:
     1012       v-err-mess = substitute("Неверный код признака &1.", p-node-code).
     1013       run err-mess in this-procedure ( input-output v-err-mess).
     1014       undo, return error (if p-silent then v-err-mess else 'node-code').
     1015     end.
     1016     find buf_units where
     1017         buf_units.unit-name = p-unit-cli no-lock no-error.
     1018     find base_units where base_units.unit-name = buf_goods.unit-base no-lock.
     1019     if not available buf_units
     1020     then do:
     1021       v-err-mess = substitute("Единица измерения &1 отсутствует в справочнике.", p-unit-cli).
     1022       run err-mess in this-procedure ( input-output v-err-mess).
     1023       undo, return error (if p-silent then v-err-mess else 'unit-cli').
     1024     end.
     1025     if  lookup( 'сте':U, base_units.type ) > 0
     1026     and buf_goods.unit-base <> buf_units.unit-name
     1027     then do:
     1028       v-err-mess =  substitute("Нельзя создать код для неосновной единицы измерения&1"  +
     1029                               "к товару, у которого основная единица измерения типа &2"
     1030                               , chr(10)
     1031                               , 'сте':U).
     1032       run err-mess in this-procedure ( input-output v-err-mess).
     1033       undo, return error (if p-silent then v-err-mess else 'unit-cli').
     1034     end.
     1035     if  lookup ('топ':U, base_units.type) > 0
     1036     and lookup ('дро':U, base_units.type) > 0
     1037     and buf_goods.gds-type = 'т':U
     1038     then do:
     1039       v-err-mess =  "Товар топливный: добавление собственных кодов запрещено.".
     1040       run err-mess in this-procedure ( input-output v-err-mess).
     1041       undo, return error (if p-silent then v-err-mess else '').
     1042     end.
     1043     if  lookup ('топ':U, buf_units.type) > 0
     1044     and lookup ('дро':U, buf_units.type) > 0
     1045     then do:
     1046       v-err-mess =  "Топливная единица измерения не может быть указана в бар-коде.".
     1047       run err-mess in this-procedure ( input-output v-err-mess).
     1048       undo, return error (if p-silent then v-err-mess else 'unit-cli').
     1049     end.
     1050     if lookup ('вес':U, buf_units.type) > 0
     1051     then do:
     1052       v-err-mess = "Весовая единица измерения не может быть указана в бар-коде.".
     1053       run err-mess in this-procedure ( input-output v-err-mess).
     1054       undo, return error (if p-silent then v-err-mess else 'unit-cli').
     1055     end.
     1056     if lookup ('сер':U, buf_units.type) > 0
     1057     then do:
     1058       v-err-mess = "Серийная единица измерения не может быть указана в бар-коде.".
     1059       run err-mess in this-procedure ( input-output v-err-mess).
     1060       undo, return error (if p-silent then v-err-mess else 'unit-cli').
     1061     end.
     1062     if  p-unit-cli <> buf_goods.unit-base
     1063     and lookup ('сер':U, base_units.type) > 0
     1064     then do:
     1065       v-err-mess = "Товар серийный: Единица измерения должна совпадать с базовой.".
     1066       run err-mess in this-procedure ( input-output v-err-mess).
     1067       undo, return error (if p-silent then v-err-mess else 'unit-cli').
     1068     end.
     1069     if  lookup ('шту':U, base_units.type) > 0
     1070     and p-cli-base-rate <>  truncate (p-cli-base-rate, 0)
     1071     then do:
     1072       v-err-mess = "Товар штучный: коэффициент должен быть целым числом.".
     1073       run err-mess in this-procedure ( input-output v-err-mess).
     1074       undo, return error (if p-silent then v-err-mess else 'cli-base-rate').
     1075     end.
     1076     if p-cli-base-rate <= 0
     1077     or p-cli-base-rate = ?
     1078     then do:
     1079       v-err-mess =  "Коэффициент должен быть больше 0.".
     1080       run err-mess in this-procedure ( input-output v-err-mess).
     1081       undo, return error (if p-silent then v-err-mess else 'cli-base-rate').
     1082     end.
     1083     if  p-unit-cli <> buf_goods.unit-base
     1084     and p-cli-base-rate = 1
     1085     and not p-silent
     1086     then do:
     1087       message
     1088       "Единица измерения не совпадает с основной - а коэффициент 1. Это странно. Вы не ошиблись?"
     1089         view-as alert-box question.
     1090     end.
     1091     b-c:
     1092     do transaction
     1093     on error undo, return error return-value
     1094     :
     1095       if p-mode = 'ДОБАВЛЕНИЕ':U
     1096       then do:
     1097           if can-find (ub.bar-code where
     1098                       ub.bar-code.gds-code  = buf_goods.gds-code
     1099                   and ub.bar-code.in-code   = p-in-code
     1100                   and ub.bar-code.part-code = p-part-code
     1101                   and ub.bar-code.node-code = p-node-code
     1102                   and ub.bar-code.unit-cli  = p-unit-cli)
     1103           then do:
     1104             v-err-mess = substitute( "Бар-код для единицы измерения &1 уже существует."
     1105                                     ,p-unit-cli ).
     1106             run err-mess in this-procedure ( input-output v-err-mess).
     1107             undo, return error (if p-silent then v-err-mess else 'cli-base-rate').
     1108           end.
     1109         if v-import = yes then do:
     1110           glog = no.
     1111           run  chk-b-code in THIS-PROCEDURE (
     1112                                                input p-silent
     1113                                               ,input p-b-code
     1114                                               ,output glog
     1115                                             ) no-error.
     1116           if error-status:error then do:
     1117             v-err-mess = return-value .
     1118             run err-mess in this-procedure ( input-output v-err-mess).
     1119             undo, return error (if p-silent then v-err-mess else '').
     1120           end.
     1121           create buf_bar-code.
     1122           assign
     1123           buf_bar-code.gds-code  = p-gds-code
     1124           buf_bar-code.b-code    = p-b-code
     1125           buf_bar-code.node-code = p-node-code
     1126           buf_bar-code.part-code = p-part-code
     1127           buf_bar-code.in-code   = p-in-code
     1128           buf_bar-code.unit-cli  = p-unit-cli
     1129           buf_bar-code.cli-base-rate  = p-cli-base-rate
     1130           p-rid = recid(buf_bar-code)
     1131           .
     1132         end.
     1133       end.
     1134       if v-import = no then do:
     1135   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1136   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run barcodcr in g#library
     1137     (input  buf_goods.gds-code
     1138     ,input  p-node-code
     1139     ,input  p-part-code
     1140     ,input  p-in-code
     1141     ,input  p-unit-cli
     1142     ,input  p-cli-base-rate
     1143     ,output v-is-new
     1144     ,buffer buf_bar-code
     1145     ) no-error .
     1146         if error-status :error
     1147         then do:
     1148           v-err-mess = substitute("Ошибка: &1&2&3", error-status:get-message(1) , chr(10), return-value ).
     1149           run err-mess in this-procedure ( input-output v-err-mess).
     1150           undo, return error (if p-silent then v-err-mess else 'cli-base-rate').
     1151         end.
     1152         p-rid = recid(buf_bar-code).
     1153       end.
     1154       if p-mode = 'ИЗМЕНЕНИЕ':U
     1155       then do:
     1156         if v-import = yes then do:
     1157           find first buf_bar-code exclusive-lock where
     1158                     buf_bar-code.b-code = p-b-code .
     1159           if buf_bar-code.gds-code <> p-gds-code then do:
     1160             v-err-mess = substitute("Изменяемый бар-код существует, но относится к другому товару ( с кодом &1)", buf_bar-code.gds-code).
     1161             run err-mess in this-procedure ( input-output v-err-mess).
     1162             undo, return error (if p-silent then v-err-mess else '').
     1163           end.
     1164           if buf_bar-code.node-code <> p-node-code then do:
     1165             v-err-mess = substitute("Изменяемый бар-код существует, но относится к другому признаку ( с кодом &1)", buf_bar-code.node-code).
     1166             run err-mess in this-procedure ( input-output v-err-mess).
     1167             undo, return error (if p-silent then v-err-mess else '').
     1168           end.
     1169           if buf_bar-code.part-code <> p-part-code then do:
     1170             v-err-mess = substitute("Изменяемый бар-код существует, но относится к другому коду партии (&1)", buf_bar-code.part-code).
     1171             run err-mess in this-procedure ( input-output v-err-mess).
     1172             undo, return error (if p-silent then v-err-mess else '').
     1173           end.
     1174           if buf_bar-code.in-code <> p-in-code then do:
     1175             v-err-mess = substitute("Изменяемый бар-код существует, но относится к другой ПН (&1)", buf_bar-code.in-code).
     1176             run err-mess in this-procedure ( input-output v-err-mess).
     1177             undo, return error (if p-silent then v-err-mess else '').
     1178           end.
     1179           if buf_bar-code.unit-cli <> p-unit-cli then do:
     1180             v-err-mess = substitute("Изменяемый бар-код существует, но относится к другой ед.изм. (&1)", buf_bar-code.unit-cli).
     1181             run err-mess in this-procedure ( input-output v-err-mess).
     1182             undo, return error (if p-silent then v-err-mess else '').
     1183           end.
     1184           if buf_bar-code.stts_ = integer('79':U) then do:
     1185             buf_bar-code.stts_ = 0.
     1186           end.
     1187         end.
     1188         if v-import = no then do:
     1189           buf_bar-code.cli-base-rate = p-cli-base-rate.
     1190         end.
     1191       end.
     1192     end.
     1193   end.
     1194   PROCEDURE err-mess:
     1195     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
     1196     CASE p-silent:
     1197       when yes then do:
     1198         assign
     1199         p-mess = substitute("Создание бар-кода &2 для товара с кодом &1:&3&4"
     1200                            , p-gds-code
     1201                            , p-b-code
     1202                            , chr(10)
     1203                            , p-mess)
     1204         .
     1205       end.
     1206       when no then do:
     1207         message
     1208         p-mess
     1209         view-as alert-box error .
     1210       end.
     1211     end.
     1212   END PROCEDURE.
