        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   DEFINE INPUT PARAMETER p-parent-handle AS HANDLE NO-UNDO.
        3   define input parameter p-mode as character no-undo .
        4   DEFINE INPUT-OUTPUT PARAMETER p-sum-id-type AS CHARACTER NO-UNDO.
        5   define INPUT-OUTPUT parameter p-dt-code   AS integer no-undo .
        6   define INPUT-OUTPUT parameter p-host-code like ub.sysconf.host-code no-undo .
        7   define INPUT-OUTPUT parameter p-obj-type like ub.clients.obj-type no-undo .
        8   define INPUT-OUTPUT parameter p-obj-code like ub.clients.obj-code no-undo .
        9   define INPUT-OUTPUT parameter p-r-b AS character no-undo .
       10   define INPUT-OUTPUT parameter p-field AS character no-undo .
       11   define INPUT-OUTPUT parameter p-cond as character no-undo .
       12   define INPUT-OUTPUT parameter p-last-change-date as date no-undo .
       13   define output parameter p-field-des as character no-undo .
       14   define OUTPUT parameter p-low as decimal no-undo .
       15   define OUTPUT parameter p-high as decimal no-undo .
       16   DEFINE OUTPUT PARAMETER p-ok AS logical NO-UNDO.
       17   define variable vss-revision    as character no-undo init "$Revision$":U .
       18   define variable vss-author      as character no-undo init "$Author$":U .
       19   define variable vss-date        as character no-undo init "$Date$":U .
       20   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       21   define variable vss-archive     as character no-undo init "$Archive$":U .
       22   define variable vss-description as character no-undo init "Задание значений по суммам итогов по ДК".
       23   procedure vss-get-info :
       24     define output parameter p-vss-revision    like vss-revision    no-undo .
       25     define output parameter p-vss-author      like vss-author      no-undo .
       26     define output parameter p-vss-date        like vss-date        no-undo .
       27     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       28     define output parameter p-vss-archive     like vss-archive     no-undo .
       29     define output parameter p-vss-description like vss-description no-undo .
       30     assign
       31       p-vss-revision    = vss-revision
       32       p-vss-author      = vss-author
       33       p-vss-date        = vss-date
       34       p-vss-workfile    = vss-workfile
       35       p-vss-archive     = vss-archive
       36       p-vss-description = vss-description
       37     .
       38   end procedure.
       39   procedure vss-get-parameters :
       40     define output parameter p-vss-parameters as character no-undo .
       41   end procedure.
       42   define new global shared variable g#vssrevis-logger as handle    no-undo .
       43   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       44   define variable v-vssrevis-logger                   as handle    no-undo .
       45   procedure vss-logevent :
       46     define input  parameter p-extra-paramters as character no-undo .
       47     define variable v-vssrevis-parameters as character no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51       if  valid-handle(v-vssrevis-logger)
       52       and v-vssrevis-logger :get-signature("logevent") <> ""
       53       then do:
       54         run vss-get-parameters in this-procedure
       55           (output v-vssrevis-parameters
       56           ).
       57         run logevent in v-vssrevis-logger
       58           (input vss-workfile
       59           ,input vss-revision
       60           ,input v-vssrevis-parameters
       61           ,input p-extra-paramters
       62           ).
       63       end.
       64     end.
       65   end procedure.
       66   assign
       67     v-vssrevis-logger = g#vssrevis-logger
       68   .
       69   if  valid-handle(v-vssrevis-logger)
       70   and v-vssrevis-logger :get-signature("logevent") <> ""
       71   then do:
       72     assign
       73       v-vssrevis-logevent = true
       74     .
       75     run vss-logevent in this-procedure (input vss-description) .
       76   end.
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   define variable v-waitfram-action01         as character   no-undo .
       79   define variable v-waitfram-action02         as character   no-undo .
       80   define variable v-waitfram-action03         as character   no-undo .
       81   define variable mWaitFramTextBeg            as character   no-undo.
       82   define variable mWaitFramTextEnd            as character   no-undo.
       83   define variable mWaitFramView               as logical     no-undo.
       84   define variable mWaitProcEvent              as logical     no-undo init yes.
       85   define variable mWaitFramInterval           as integer     no-undo init 1 .
       86   define variable mWaitFramStop               as logical     no-undo.
       87   define variable mWaitFramStopUser           as logical     no-undo.
       88   define variable mWaitFramStopTimeOut        as logical     no-undo.
       89   define variable mWaitFramStartProc          as datetime-tz no-undo.
       90   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       91   define button B-WaitFramStop auto-end-key
       92        label "Стоп"
       93        size 10 by 1 tooltip "Остоновить процесс".
       94   define button B-viewProcInfo
       95        label "Информация"
       96        size 15 by 1 tooltip "Информация о процесс".
       97   define frame waitfram
       98     v-waitfram-action01 format "x(72)" no-label skip
       99     v-waitfram-action02 format "x(72)" no-label skip
      100     v-waitfram-action03 format "x(72)" no-label skip
      101     B-viewProcInfo
      102     B-WaitFramStop at row 4 col 30
      103     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      104     .
      105   define new global shared variable mBatchMode as logical no-undo init ?.
      106   define variable mFramBachModHandle as handle no-undo.
      107   mFramBachModHandle = frame waitfram:handle.
      108   define variable mFameOldVis as logical no-undo.
      109   define variable mVisCUrentVin as logical no-undo.
      110   if session:batch-mode
      111   then
      112      mBatchMode = yes.
      113   if mBatchMode = ? then do:
      114     mVisCUrentVin = current-window:visible.
      115     mFameOldVis = mFramBachModHandle:visible.
      116     mFramBachModHandle:visible  = yes.
      117     mBatchMode = mFramBachModHandle:visible ne yes.
      118     mFramBachModHandle:visible = mFameOldVis.
      119     current-window:visible = mVisCUrentVin.
      120   end.
      121    if  log-manager:logfile-name ne ?
      122     then DO:
      123         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      124         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      125         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      126     end.
      127   on choose of B-WaitFramStop in frame waitfram
      128   do:
      129     mWaitFramStop = yes.
      130     mWaitFramStopUser = yes.
      131   end.
      132   function waitfram-check-timeout returns logical():
      133      define variable vtime as int64 no-undo.
      134      if mWaitFramStopTimeOut
      135      then
      136         return yes.
      137      vtime = ( now - mWaitFramStartProc ) / 1000 .
      138      if     mWaitFramTimeOut ne ?
      139         and mWaitFramTimeOut ne 0
      140         and mWaitFramTimeOut lt vtime
      141      then do:
      142         mWaitFramStopTimeOut = yes.
      143      end.
      144      return mWaitFramStopTimeOut.
      145   end.
      146   procedure waitfram-hide :
      147     if not session:batch-mode
      148     then do
      149     on error undo, return error return-value
      150     :
      151       pause 0 before-hide .
      152       if not mBatchMode then
      153         hide frame waitfram .
      154     if     not mWaitFramView
      155        and mWaitProcEvent
      156     then
      157       process events .
      158     end.
      159   end procedure.
      160   procedure waitfram-show :
      161     define input  parameter p-message as character no-undo .
      162     define variable v-left-margin as integer   no-undo .
      163     if not session:batch-mode
      164     then do
      165     on error undo, return error return-value
      166     :
      167       if length(p-message) <= 70 then do:
      168         assign
      169           v-left-margin = integer((70 - length(p-message)) / 2)
      170         .
      171         assign
      172           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      173         .
      174         assign
      175           v-waitfram-action01 = " "
      176           v-waitfram-action02 = " "
      177                                    + fill(" ", v-left-margin)
      178                                    + p-message
      179           v-waitfram-action03 = " "
      180         .
      181       end.
      182       else do:
      183         define variable vRindex1 as integer no-undo.
      184         define variable vRindex2 as integer no-undo.
      185         vRindex1 = r-index(p-message," ",70).
      186         if vRindex1 = 0
      187         then
      188            vRindex1 = 70.
      189         if length(p-message)  <= vRindex1 + 70 then do:
      190           assign
      191             v-waitfram-action01 = " "
      192             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      193             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      194           .
      195         end.
      196         else do:
      197           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      198           if vRindex2 <= vRindex1
      199           then
      200              vRindex2 = vRindex1 + 70.
      201           assign
      202             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      203             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      204             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      205           .
      206         end.
      207       end.
      208       B-viewProcInfo:visible   in frame waitfram = no.
      209       B-viewProcInfo:sensitive in frame waitfram = no.
      210       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      211       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      212       if  (   mWaitFramView
      213          or  mWaitProcEvent)
      214          and not mBatchMode
      215       then
      216          display
      217             v-waitfram-action01 skip
      218             v-waitfram-action02 skip
      219             v-waitfram-action03 skip
      220          with frame waitfram .
      221       if     mWaitFramView
      222          then do:
      223             if     mWaitFramInterval ne ?
      224                and not mBatchMode
      225             then
      226                wait-for go of frame waitfram pause mWaitFramInterval.
      227          end.
      228          else
      229             if     mWaitProcEvent
      230                and not mBatchMode
      231             then
      232                process events .
      233     end.
      234   end procedure.
      235      procedure waitfram-show-this:
      236         define input  parameter iInterval as int64 no-undo.
      237         define variable vtime as int64 no-undo.
      238         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      239         mWaitFramInterval = iInterval.
      240         run waitfram-show (substitute("&1&2 &3&4" ,
      241                                       mWaitFramTextBeg ,
      242                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      243                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      244                                       mWaitFramTextEnd
      245                                      )
      246                           ).
      247      end.
      248      procedure WaitFramRunPause:
      249         define input  parameter iInterval as dec no-undo.
      250         define variable vStart  as datetime-tz no-undo.
      251         define variable vend    as datetime-tz no-undo.
      252         define variable vint as int64 no-undo.
      253         define variable vOk as logical no-undo.
      254         vStart = now.
      255         vend   = vStart.
      256         publish "WaitFramPause" (iInterval,output vOk).
      257         vend   =  now.
      258         vint = vend - vStart.
      259         vint = iInterval - vint / 1000.
      260         if     not mWaitFramStop
      261            and (   vint > 0
      262                 or (    not vOk
      263                     and iInterval eq ?
      264                     )
      265                 )
      266         then
      267            run waitfram-show-this (iInterval).
      268         vend   =  now.
      269         vint = vend - vStart.
      270         vint = iInterval - vint / 1000.
      271         if     not mWaitFramStop
      272            and vint > 0
      273         then do:
      274            run gbl/pause.p (vint * 1000).
      275         end.
      276         if iInterval ne ?
      277         then
      278            publish "WaitFramStop".
      279         waitfram-check-timeout().
      280      end.
      281      procedure WaitFramWaitFor:
      282         define input  parameter iInterval as dec no-undo.
      283         assign
      284            mWaitFramStartProc   = now
      285            mWaitFramStopUser    = no
      286            mWaitFramStopTimeOut = no
      287         .
      288         block-wait:
      289         do while not mWaitFramStop:
      290            run WaitFramRunPause (iInterval).
      291            if  waitfram-check-timeout()
      292            then do:
      293               leave block-wait.
      294            end.
      295         end.
      296         run waitfram-hide.
      297      end.
      298   procedure waitfram-join :
      299     define input  parameter p-line-1  as character no-undo .
      300     define input  parameter p-line-2  as character no-undo .
      301     define input  parameter p-line-3  as character no-undo .
      302     define output parameter p-message as character no-undo .
      303     do
      304     on error undo, return error return-value
      305     :
      306       assign
      307         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      308                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      309                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      310       .
      311     end.
      312   end procedure.
      313   function waitfram-join-function returns character
      314     (input p-line-1 as character
      315     ,input p-line-2 as character
      316     ,input p-line-3 as character
      317     ).
      318     define variable v-message as character no-undo .
      319     run waitfram-join in this-procedure
      320       (input  p-line-1
      321       ,input  p-line-2
      322       ,input  p-line-3
      323       ,output v-message
      324       ) .
      325     return v-message .
      326   end function .
      327   define new global shared variable g#language as character no-undo .
      328   if g#language <> '' and g#language <> 'rus':U then do:
      329     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      330   end.
      331   define new global shared variable g#library  as handle no-undo .
      332   define new global shared variable g#library2 as handle no-undo .
      333   procedure proc-alt-shift-f2:
      334     if not ibs.th.gbl.gbl-var:rcode
      335   then
      336     run gbl\inidebug.p .
      337   end.
      338   procedure proc-alt-shift-f3:
      339     run gbl/prvssinf.p
      340       ( input this-procedure
      341       ) .
      342   end.
      343   define variable v-inform-launched as logical no-undo initial false .
      344   procedure proc-alt-shift-f4:
      345     define variable v-action as character no-undo .
      346     if v-inform-launched = false then do:
      347       assign
      348         v-inform-launched = true
      349       .
      350       run gbl/d-inform.w
      351         (  input self
      352         ,  input this-procedure
      353         , output v-action
      354         ) no-error .
      355       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      356       assign
      357         v-inform-launched = false
      358       .
      359     end.
      360   end.
      361   procedure proc-alt-f1:
      362     run gbl/corrhelp.p
      363       (input this-procedure
      364       ) .
      365   end .
      366   on alt-shift-f2 anywhere do:
      367     run proc-alt-shift-f2.
      368   end.
      369   on alt-shift-f3 anywhere do:
      370     run proc-alt-shift-f3 in this-procedure .
      371   end.
      372   on alt-shift-f4 anywhere do:
      373     run proc-alt-shift-f4 in this-procedure.
      374   end.
      375   on alt-f1 anywhere do:
      376     run proc-alt-f1 in this-procedure .
      377   end.
      378   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      379     define variable v-cntxt-db-num        as integer   no-undo .
      380     define variable v-cntxt-userid        as character no-undo .
      381     define variable v-cntxt-level         as character no-undo .
      382     define variable v-cntxt-host-code-obj as integer   no-undo .
      383     define variable v-cntxt-obj-type      as character no-undo .
      384     define variable v-cntxt-obj-code      as integer   no-undo .
      385     define variable v-cntxt-db-num-obj    as integer   no-undo .
      386     define variable v-cntxt-is-admin      as logical   no-undo .
      387   function diff-list returns character (
      388     input parfirst-list  as character,
      389     input parsecond-list as character,
      390     input pardelim       as character).
      391     if pardelim = ""
      392     or pardelim = ?
      393     then do:
      394       assign
      395         pardelim = ","
      396       .
      397     end.
      398     def var ind as integer no-undo .
      399     def var v-elem as character no-undo .
      400     def var v-result-list as character no-undo init "".
      401     def var v-num-parfirst-list as integer no-undo .
      402     assign
      403       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      404     .
      405     do ind = 1 to v-num-parfirst-list
      406     :
      407       assign
      408         v-elem = entry(ind, parfirst-list, pardelim)
      409       .
      410       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      411         assign
      412           v-result-list = v-result-list
      413                         + (if v-result-list > "" then pardelim else "")
      414                         + v-elem
      415         .
      416       end.
      417     end.
      418     return v-result-list .
      419   end function.
      420   function add-list returns character (
      421    input parfirst-list  as character,
      422    input parsecond-list as character,
      423    input pardelim       as character).
      424     if pardelim = ""
      425     or pardelim = ?
      426     then do:
      427       assign
      428         pardelim = ","
      429       .
      430     end.
      431     def var ind as integer no-undo .
      432     def var v-elem as character no-undo .
      433     def var v-result-list as character no-undo init "".
      434     def var v-num-parfirst-list as integer no-undo .
      435     assign
      436       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      437     .
      438     do ind = 1 to v-num-parfirst-list
      439     :
      440       assign
      441         v-elem = entry(ind, parfirst-list, pardelim)
      442       .
      443       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      444         assign
      445           v-result-list = v-result-list
      446                         + (if v-result-list > "" then pardelim else "")
      447                         + v-elem
      448         .
      449       end.
      450     end.
      451     def var v-num-parsecond-list as integer no-undo .
      452     assign
      453       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      454     .
      455     do ind = 1 to v-num-parsecond-list
      456     :
      457       assign
      458         v-elem = entry(ind, parsecond-list, pardelim)
      459       .
      460       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      461         assign
      462           v-result-list = v-result-list
      463                         + (if v-result-list > "" then pardelim else "")
      464                         + v-elem
      465         .
      466       end.
      467     end.
      468     return v-result-list .
      469   end function.
      470   function cross-list returns character (
      471    input parfirst-list  as character,
      472    input parsecond-list as character,
      473    input pardelim       as character).
      474     if pardelim = ""
      475     or pardelim = ?
      476     then do:
      477       assign
      478         pardelim = ","
      479       .
      480     end.
      481     def var ind as integer no-undo .
      482     def var v-elem as character no-undo .
      483     def var v-result-list as character no-undo init "".
      484     def var v-num-parfirst-list as integer no-undo .
      485     assign
      486       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      487     .
      488     do ind = 1 to v-num-parfirst-list
      489     :
      490       assign
      491         v-elem = entry(ind, parfirst-list, pardelim)
      492       .
      493       if lookup(v-elem, v-result-list, pardelim) = 0
      494       and lookup(v-elem, parsecond-list, pardelim) > 0
      495       then do:
      496         assign
      497           v-result-list = v-result-list
      498                         + (if v-result-list > "" then pardelim else "")
      499                         + v-elem
      500         .
      501       end.
      502     end.
      503     return v-result-list .
      504   end function.
      505   function radio-label returns character (
      506    input par-rs-value  as character,
      507    input par-rs-radio-buttons as character)
      508    .
      509    DEFINE variable v-result-label as character no-undo.
      510    assign
      511    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      512                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      513                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      514                             ), par-rs-radio-buttons
      515                           )
      516    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      517    .
      518   return v-result-label.
      519   end function.
      520   function m-radio-label returns character (
      521    input par-rs-value  as character,
      522    input par-rs-radio-buttons as character,
      523    input par-delim as character
      524    )
      525    .
      526    DEFINE variable v-result-label as character no-undo.
      527    assign
      528    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      529                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      530                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      531                             ), par-rs-radio-buttons, par-delim
      532                           )
      533    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      534    .
      535   return v-result-label.
      536   end function.
      537   FUNCTION mixlist returns character
      538   (
      539    input parfirst-list  as character
      540    ,input parsecond-list as character
      541    ,input pardelim       as character
      542    ,input pardelim-result as character ) :
      543     if pardelim = ""
      544     or pardelim = ?
      545     then do:
      546       assign
      547         pardelim = ","
      548       .
      549     end.
      550     def var ind as integer no-undo .
      551     def var v-elem1 as character no-undo .
      552     def var v-elem2 as character no-undo .
      553     def var v-result-list as character no-undo init "".
      554     do ind = 1 to num-entries(parfirst-list, pardelim)
      555     :
      556       assign
      557         v-elem1 = entry(ind, parfirst-list, pardelim)
      558         v-elem2 = entry(ind, parsecond-list, pardelim)
      559       .
      560         assign
      561           v-result-list = v-result-list
      562                         + (if v-result-list > "" then pardelim-result else "")
      563                         + v-elem1 + pardelim-result + v-elem2
      564         .
      565     end.
      566     return v-result-list .
      567   END FUNCTION.
      568   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      569   define variable dcard-algo-field-name as character no-undo extent 3 init [
      570    'd-pcnt':U
      571   ,'cash-d-pcnt':U
      572   ,'pcnt-kat':U].
      573   define variable algo-field-abbr as character no-undo extent 3 init [
      574    'ITEM%':U
      575   ,'TOTAL%':U
      576   ,'CATEG':U].
      577   FUNCTION dct-algo-Date-to-String returns character(input  p-date as date):
      578   define variable v-date-str as character no-undo .
      579   assign
      580   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
      581                string(Month(p-date), "99":U) + chr(47) +
      582                string(DAY(p-date), "99":U).
      583   return v-date-str.
      584   END FUNCTION.
      585   function dct-algo-string-to-date returns date ( input p-string  as character):
      586     define variable v-date as date no-undo .
      587     assign
      588     v-date = date(integer(substring(p-string, 6, 2))
      589                   ,integer(substring(p-string, 9, 2))
      590                   ,integer(substring(p-string, 1, 4))
      591                  ) no-error .
      592     if error-status:error then return ?.
      593     return v-date.
      594   END FUNCTION.
      595   FUNCTION dct-algo-get-sum-id-from-DT-CODE returns character ( input p-DT-CODE as integer):
      596   define buffer buf_prop-ref for ub.prop-ref.
      597   find first buf_prop-ref no-lock where
      598             buf_prop-ref.DT-CODE = p-DT-CODE no-error.
      599   if not available buf_prop-ref then do:
      600     return chr(63).
      601   end.
      602   return buf_prop-ref.sum-id.
      603   END FUNCTION.
      604   FUNCTION dct-algo-get-description-sum-id returns character ( input p-dt-code as integer):
      605   define variable v-des as character no-undo .
      606   define buffer buf_prop-ref for ub.prop-ref.
      607   define buffer buf_prop-head for ub.prop-head.
      608   find first buf_prop-ref no-lock where
      609             buf_prop-ref.dt-code = p-dt-code no-error.
      610   if not available buf_prop-ref then do:
      611     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
      612   end.
      613   find first buf_prop-head no-lock where
      614           buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error.
      615   if not available buf_prop-head then do:
      616     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, buf_prop-ref.dtm-code).
      617   end.
      618   assign
      619   v-des = substitute("&1  &2 &3"
      620                     , buf_prop-head.prop-name
      621                     , buf_prop-ref.sum-id
      622                     , buf_prop-ref.caller_id).
      623   return v-des.
      624   end FUNCTION.
      625   FUNCTION dct-algo-get-description-node-code returns character ( input p-dtm-code as integer
      626                                                               ,input p-dt-code as integer
      627                                                               ,input p-node-code as integer
      628                                                               ):
      629   define variable v-des as character no-undo .
      630   define buffer buf_prop-ref for ub.prop-ref.
      631   define buffer buf_prop-head for ub.prop-head.
      632   define buffer buf_prop-map for ub.prop-map.
      633   find first buf_prop-ref no-lock where
      634             buf_prop-ref.dt-code = p-dt-code no-error.
      635   if not available buf_prop-ref then do:
      636     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
      637   end.
      638   find first buf_prop-head no-lock where
      639           buf_prop-head.dtm-code = p-dtm-code no-error.
      640   if not available buf_prop-head then do:
      641     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, p-dtm-code).
      642   end.
      643   find first buf_prop-map no-lock where
      644           buf_prop-map.dtm-code = p-dtm-code
      645       and buf_prop-map.node-code = p-node-code no-error .
      646   if not available buf_prop-map then do:
      647     return substitute("Срез/итог по ДК &1, &2.&3 - неизвестно"
      648                       , p-dt-code
      649                       , buf_prop-head.prop-label
      650                       , p-node-code).
      651   end.
      652   assign
      653   v-des = substitute("&1.&2 &3 &4"
      654                     , buf_prop-head.prop-label
      655                     , buf_prop-map.node-label
      656                     , buf_prop-ref.sum-id
      657                     , buf_prop-ref.caller_id).
      658   return v-des.
      659   end FUNCTION.
      660   function dct-algo-get-prev-sum-id RETURNS integer (
      661                                                       input p-dt-code as integer
      662                                                      ):
      663   define variable v-dtm-code as integer no-undo .
      664   define variable v-sum-id as character no-undo .
      665   define variable v-caller-id as character no-undo .
      666   define buffer buf_prop-ref for ub.prop-ref.
      667   find first buf_prop-ref no-lock where
      668           buf_prop-ref.dt-code = p-dt-code no-error.
      669   if not available buf_prop-ref then return ?.
      670   assign
      671   v-dtm-code = buf_prop-ref.dtm-code
      672   v-sum-id = buf_prop-ref.sum-id.
      673   v-caller-id = buf_prop-ref.caller_id.
      674   find last buf_prop-ref no-lock where
      675             buf_prop-ref.dtm-code = v-dtm-code
      676        and  buf_prop-ref.sum-id < v-sum-id
      677        and  buf_prop-ref.caller_id = v-caller-id
      678        no-error.
      679   if available buf_prop-ref then return buf_prop-ref.dt-code.
      680   return -1 .
      681   END FUNCTION.
      682   FUNCTION dct-algo-get_dcproperty-value returns logical (
      683                                                             input p-prop-name as character
      684                                                           , input p-d-card    as character
      685                                                           , input p-host-code as integer
      686                                                           , input p-obj-type  as character
      687                                                           , input p-obj-code  as integer
      688                                                           , output p-value-character as character
      689                                                           , output p-value-date   as date
      690                                                           , output p-value-integer as integer
      691                                                           , output p-value-decimal as decimal
      692                                                           , output p-value-logical as logical):
      693     return no.
      694   END FUNCTION.
      695   FUNCTION dct-algo-get_dcproperty-value-chr returns logical (
      696                                                             input p-d-card    as character
      697                                                           , input p-emitent-host-code as integer
      698                                                           , input p-type as character
      699                                                           , input p-host-code as integer
      700                                                           , input p-obj-type  as character
      701                                                           , input p-obj-code  as integer
      702                                                           , output p-value-chr as character):
      703   define variable v-dt-code as integer no-undo .
      704   define variable v-node-code as integer no-undo .
      705   define variable v-field-name as character no-undo .
      706   define variable v-storage-place as character no-undo .
      707   define variable v-sum-id-value as character no-undo .
      708   define variable v-sum-id-output as logical no-undo .
      709   define variable v-value-chr as character no-undo .
      710   define variable v-ii as integer no-undo .
      711   define buffer buf_dis-card-property for ub.dis-card-property.
      712   define buffer buf_dis-host for ub.dis-host.
      713   define buffer buf_dis-obj for ub.dis-obj.
      714   run get-cd-sumid in this-procedure (
      715                                         input p-emitent-host-code
      716                                        ,input p-type
      717                                        ,input p-host-code
      718                                        ,input p-obj-type
      719                                        ,input p-obj-code
      720                                        ,output v-sum-id-value
      721                                        ,output v-sum-id-output
      722                                       ) no-error.
      723   if not v-sum-id-output then do:
      724     return no.
      725   end.
      726   do v-ii = 1 to num-entries(v-sum-id-value):
      727     assign
      728     v-storage-place = entry(1, entry(v-ii, v-sum-id-value), chr(4))
      729     v-dt-code = integer(entry(2, entry(v-ii, v-sum-id-value), chr(4)))
      730     v-node-code = integer(entry(3, entry(v-ii, v-sum-id-value), chr(4)))
      731     v-field-name = entry(4, entry(v-ii, v-sum-id-value), chr(4))
      732     no-error .
      733     if not error-status:error then do:
      734       case v-storage-place:
      735         when 'dis-card-property':U then do:
      736           find first buf_dis-card-property no-lock where
      737                     buf_dis-card-property.d-card = p-d-card
      738               and  buf_dis-card-property.host-code = p-host-code
      739               and  buf_dis-card-property.obj-type = p-obj-type
      740               and  buf_dis-card-property.obj-code = p-obj-code
      741               and  buf_dis-card-property.dt-code = v-dt-code
      742               and  buf_dis-card-property.node-code = v-node-code no-error .
      743           if available buf_dis-card-property then do:
      744             v-value-chr = buffer buf_dis-card-property:handle:buffer-field(v-field-name):string-value.
      745           end.
      746           else do:
      747             v-value-chr = chr(63).
      748           end.
      749         end.
      750         when 'dis-obj':U then do:
      751           find first buf_dis-obj no-lock where
      752                     buf_dis-obj.d-card = p-d-card
      753               and  buf_dis-obj.obj-type = p-obj-type
      754               and  buf_dis-obj.obj-code = p-obj-code
      755               and  buf_dis-obj.dt-code = v-dt-code no-error .
      756           if available buf_dis-obj then do:
      757             v-value-chr = buffer buf_dis-obj:handle:buffer-field(v-field-name):string-value.
      758           end.
      759           else do:
      760             v-value-chr = chr(63).
      761           end.
      762         end.
      763         when 'dis-host':U then do:
      764           find first buf_dis-host no-lock where
      765                     buf_dis-host.d-card = p-d-card
      766               and  buf_dis-host.host-code = p-host-code
      767               and  buf_dis-host.dt-code = v-dt-code no-error .
      768           if available buf_dis-host then do:
      769             v-value-chr = buffer buf_dis-host:handle:buffer-field(v-field-name):string-value.
      770           end.
      771           else do:
      772             v-value-chr = chr(63).
      773           end.
      774         end.
      775       end.
      776     end.
      777     p-value-chr = p-value-chr + (if v-ii = 1 then '':U else chr(44)) + v-value-chr.
      778   end.
      779   END FUNCTION.
      780   FUNCTION dct-algo_custom-sent-description RETURNS CHARACTER
      781     ( INPUT p-custom-sent as character ) :
      782   DEFINE VARIABLE v-storage-place AS CHARACTER NO-UNDO.
      783   DEFINE VARIABLE v-dtm-code AS integer NO-UNDO.
      784   DEFINE VARIABLE v-sum-id AS character NO-UNDO.
      785   DEFINE VARIABLE v-caller-id AS character NO-UNDO.
      786   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
      787   DEFINE VARIABLE v-sum-id-description AS CHARACTER.
      788   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
      789   IF p-custom-sent = chr(63) THEN RETURN "Не отсылать".
      790   assign
      791   v-storage-place = entry(1, p-custom-sent, chr(4))
      792   v-dtm-code = integer(entry(2, p-custom-sent, chr(4)))
      793   v-sum-id   = entry(3, p-custom-sent, chr(4))
      794   v-caller-id = entry(4, p-custom-sent, chr(4))
      795   v-node-code = integer(entry(5, p-custom-sent, chr(4)))
      796   no-error .
      797   IF ERROR-STATUS:ERROR THEN DO:
      798     MESSAGE
      799     "Не могу разобрать строку, описывающую итог"
      800      VIEW-AS ALERT-BOX WARNING.
      801     RETURN chr(63).
      802   END.
      803   FIND FIRST buf_prop-ref NO-LOCK WHERE
      804             buf_prop-ref.dtm-code = v-dtm-code
      805        AND  buf_prop-ref.sum-id = v-sum-id
      806        AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
      807   IF NOT AVAILABLE buf_prop-ref THEN DO:
      808     FIND FIRST buf_prop-ref NO-LOCK WHERE
      809               buf_prop-ref.dtm-code = v-dtm-code
      810         AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
      811     IF NOT AVAILABLE buf_prop-ref THEN DO:
      812         MESSAGE
      813         "Не могу разобрать строку, описывающую итог"
      814          VIEW-AS ALERT-BOX WARNING.
      815         RETURN chr(63).
      816      end.
      817   end.
      818   ASSIGN
      819   v-sum-id-description =  dct-algo-get-description-node-code ( v-dtm-code
      820                                                          ,buf_prop-ref.dt-code
      821                                                          ,v-node-code).
      822   RETURN v-sum-id-description.
      823   END FUNCTION.
      824   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      825   define variable is-temp as logical no-undo .
      826   define variable v-obj-db-num like ub.db.db-num no-undo .
      827   DEFINE BUTTON B-exit AUTO-GO
      828        LABEL "&Ввод"
      829        SIZE 10 BY 1
      830        BGCOLOR 8 .
      831   DEFINE BUTTON B-Help
      832        LABEL "Помо&щь"
      833        SIZE 10 BY 1
      834        BGCOLOR 8 .
      835   DEFINE BUTTON B-host
      836        IMAGE-UP FILE "btn-down-arrow":U
      837        IMAGE-DOWN FILE "btn-down-arrow":U
      838        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      839        LABEL "Btn 1"
      840        SIZE 3 BY 1.
      841   DEFINE BUTTON B-obj
      842        IMAGE-UP FILE "btn-down-arrow":U
      843        IMAGE-DOWN FILE "btn-down-arrow":U
      844        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      845        LABEL "Btn 1"
      846        SIZE 3 BY 1.
      847   DEFINE BUTTON b-quit AUTO-END-KEY
      848        LABEL "&Отмена"
      849        SIZE 10 BY 1
      850        BGCOLOR 8 .
      851   DEFINE BUTTON B-sum-id
      852        IMAGE-UP FILE "btn-down-arrow":U
      853        IMAGE-DOWN FILE "btn-down-arrow":U
      854        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      855        LABEL "Btn 1"
      856        SIZE 3 BY 1.
      857   DEFINE VARIABLE CB-obj-type AS CHARACTER FORMAT "X(256)":U
      858        VIEW-AS COMBO-BOX INNER-LINES 3
      859        LIST-ITEMS "","Item 1","Item 2"
      860        DROP-DOWN-LIST
      861        SIZE 11 BY 1
      862        BGCOLOR 8  NO-UNDO.
      863   DEFINE VARIABLE f-high AS DECIMAL FORMAT "->>>,>>>,>>>,>>9.99":U INITIAL 0
      864        LABEL "Верхняя граница"
      865        VIEW-AS FILL-IN
      866        SIZE 27.5 BY 1
      867        FGCOLOR 4  NO-UNDO.
      868   DEFINE VARIABLE f-host-code AS INTEGER FORMAT ">>>>9":U INITIAL 0
      869        LABEL "Фирма"
      870        VIEW-AS FILL-IN
      871        SIZE 7 BY 1
      872        BGCOLOR 8  NO-UNDO.
      873   DEFINE VARIABLE F-host-name AS CHARACTER FORMAT "X(256)":U
      874         VIEW-AS TEXT
      875        SIZE 56.5 BY .67
      876        FGCOLOR 1  NO-UNDO.
      877   DEFINE VARIABLE f-last-change-date AS DATE FORMAT "99/99/9999":U INITIAL ?
      878        LABEL "Дата последнего изменения"
      879        VIEW-AS FILL-IN
      880        SIZE 12 BY 1 NO-UNDO.
      881   DEFINE VARIABLE f-low AS DECIMAL FORMAT "->>>,>>>,>>>,>>9.99":U INITIAL 0
      882        LABEL "Нижняя граница"
      883        VIEW-AS FILL-IN
      884        SIZE 27.5 BY 1
      885        FGCOLOR 4  NO-UNDO.
      886   DEFINE VARIABLE f-obj-code AS INTEGER FORMAT ">>>>9":U INITIAL 0
      887        VIEW-AS FILL-IN
      888        SIZE 7 BY 1
      889        BGCOLOR 8  NO-UNDO.
      890   DEFINE VARIABLE F-obj-name AS CHARACTER FORMAT "X(256)":U
      891         VIEW-AS TEXT
      892        SIZE 56.5 BY .67
      893        FGCOLOR 1  NO-UNDO.
      894   DEFINE VARIABLE f-sum-id AS CHARACTER FORMAT "X(256)":U
      895         VIEW-AS TEXT
      896        SIZE 46 BY .67
      897        FGCOLOR 1  NO-UNDO.
      898   DEFINE VARIABLE rs-cond AS CHARACTER INITIAL ">"
      899        VIEW-AS RADIO-SET HORIZONTAL
      900        RADIO-BUTTONS
      901             "=", "=",
      902   ">", ">",
      903   "<", "<",
      904   ">=", ">=",
      905   "<=", "<="
      906        SIZE 30.5 BY 1 NO-UNDO.
      907   DEFINE VARIABLE rs-field AS CHARACTER
      908        VIEW-AS RADIO-SET VERTICAL
      909        RADIO-BUTTONS
      910             "Количество чеков", "num-chk",
      911   "Сумма оплат", "pay-tot-rubl",
      912   "Сумма покупок брутто", "gds-tot-rubl",
      913   "Сумма скидок", "gds-dis-rubl"
      914        SIZE 26 BY 6.5 NO-UNDO.
      915   DEFINE VARIABLE rs-r-b AS CHARACTER
      916        VIEW-AS RADIO-SET HORIZONTAL
      917        RADIO-BUTTONS
      918             "Нац. валюта", "rubl",
      919   "Баз.вал.", "base"
      920        SIZE 24.5 BY 1 NO-UNDO.
      921   DEFINE VARIABLE RS-range AS CHARACTER
      922        VIEW-AS RADIO-SET HORIZONTAL
      923        RADIO-BUTTONS
      924             "Глобально", "global",
      925   "Фирма", "firm",
      926   "Объект", "object"
      927        SIZE 36 BY 1 NO-UNDO.
      928   DEFINE VARIABLE Rs-sum-id-type AS CHARACTER
      929        VIEW-AS RADIO-SET HORIZONTAL
      930        RADIO-BUTTONS
      931             "Общие итоги", "general-sum-id",
      932   "Частные итоги", "partial-sum-id"
      933        SIZE 31 BY 1 NO-UNDO.
      934   DEFINE FRAME DIALOG-FRAME
      935        B-exit AT ROW 1 COL 1
      936        b-quit AT ROW 1 COL 11
      937        B-Help AT ROW 1 COL 54.9
      938        Rs-sum-id-type AT ROW 2.5 COL 2 NO-LABEL
      939        B-sum-id AT ROW 2.5 COL 33
      940        RS-range AT ROW 4 COL 2 NO-LABEL
      941        f-host-code AT ROW 5.5 COL 13 COLON-ALIGNED
      942        B-host AT ROW 5.5 COL 23
      943        CB-obj-type AT ROW 7 COL 2.5 NO-LABEL
      944        f-obj-code AT ROW 7 COL 13 COLON-ALIGNED NO-LABEL
      945        B-obj AT ROW 7 COL 23
      946        rs-r-b AT ROW 8.5 COL 2 NO-LABEL
      947        f-low AT ROW 9 COL 49 COLON-ALIGNED
      948        rs-field AT ROW 10 COL 3 NO-LABEL
      949        f-high AT ROW 11 COL 49 COLON-ALIGNED
      950        f-last-change-date AT ROW 12.73 COL 61.5 COLON-ALIGNED
      951        rs-cond AT ROW 14.6 COL 50.5 NO-LABEL
      952        f-sum-id AT ROW 2.5 COL 36 COLON-ALIGNED NO-LABEL
      953        F-host-name AT ROW 5.77 COL 24 COLON-ALIGNED NO-LABEL
      954        F-obj-name AT ROW 7.27 COL 24 COLON-ALIGNED NO-LABEL
      955        SPACE(2.37) SKIP(9.01)
      956       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      957            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      958            TITLE "Задание диапазона значений общих или частных итогов по ДК"
      959            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      960   ASSIGN
      961          FRAME DIALOG-FRAME:SCROLLABLE       = FALSE
      962          FRAME DIALOG-FRAME:HIDDEN           = TRUE.
      963   ASSIGN
      964          f-host-code:READ-ONLY IN FRAME DIALOG-FRAME        = TRUE.
      965   ASSIGN
      966          f-obj-code:READ-ONLY IN FRAME DIALOG-FRAME        = TRUE.
      967   ON WINDOW-CLOSE OF FRAME DIALOG-FRAME
      968   DO:
      969     APPLY "END-ERROR":U TO SELF.
      970   END.
      971   ON CHOOSE OF B-exit IN FRAME DIALOG-FRAME
      972   DO:
      973     run proc-save IN THIS-PROCEDURE NO-ERROR.
      974     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      975     ASSIGN
      976     p-ok = YES
      977     p-host-code = (if p-host-code <> f-host-code then f-host-code else p-host-code)
      978     p-obj-type = (if p-obj-type <> cb-obj-type then cb-obj-type else p-obj-type)
      979     p-obj-code = (if p-obj-code <> f-obj-code then f-obj-code else p-obj-code)
      980     p-sum-id-type = (if p-sum-id-type <> rs-sum-id-type then rs-sum-id-type else p-sum-id-type)
      981     p-dt-code = (if p-dt-code <> integer(f-sum-id:private-data) then integer(f-sum-id) else p-dt-code)
      982     .
      983     CASE p-mode:
      984       WHEN 'last-change' THEN DO:
      985           ASSIGN
      986           p-cond = rs-cond
      987           p-last-change-date = f-last-change-date
      988           p-field-des = substitute("Дата последнего изменения")
      989           .
      990       END.
      991       WHEN 'current-values' THEN DO:
      992           ASSIGN
      993           p-field = (if p-field <> rs-field then rs-field else p-field)
      994           p-r-b = (if p-r-b <> rs-r-b then rs-r-b else p-r-b)
      995           p-low = f-low
      996           p-high = f-high
      997           p-field-des = substitute("&1 &2"
      998                                   ,  radio-label (
      999                                       input p-field
     1000                                      ,input rs-field:radio-buttons in frame DIALOG-FRAME )
     1001                                  ,  (if p-field = 'num-chk'
     1002                                       then '':U
     1003                                       else radio-label (
     1004                                                         input p-r-b
     1005                                                         ,input rs-r-b:radio-buttons in frame DIALOG-FRAME ) ))
     1006           .
     1007       END.
     1008     END CASE.
     1009   END.
     1010   ON CHOOSE OF B-host IN FRAME DIALOG-FRAME
     1011   DO:
     1012     run proc-b-host IN THIS-PROCEDURE NO-ERROR.
     1013     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1014   END.
     1015   ON CHOOSE OF B-obj IN FRAME DIALOG-FRAME
     1016   DO:
     1017     run proc-b-obj IN THIS-PROCEDURE NO-ERROR.
     1018     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1019   END.
     1020   ON CHOOSE OF B-sum-id IN FRAME DIALOG-FRAME
     1021   DO:
     1022   DEFINE variable v-ref-list AS CHARACTER NO-UNDO.
     1023   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
     1024   run ref/proprefs.w (
     1025                   input parparentproc
     1026                 ,input 'b-sel'
     1027                 ,input 'dis-tot':U
     1028                 ,input 0
     1029                 ,input '':U
     1030                 ,input '':U
     1031                 ,input-output  v-ref-list) no-error.
     1032   if error-status:error or v-ref-list = '':u then do:
     1033     return.
     1034   end.
     1035   find first buf_prop-ref no-lock where
     1036             recid(buf_prop-ref) = integer(v-ref-list) no-error.
     1037   if not available buf_prop-ref then return.
     1038   ASSIGN
     1039   f-sum-id:PRIVATE-DATA = string(buf_prop-ref.dt-code)
     1040   f-sum-id = buf_prop-ref.sum-id.
     1041   DISPLAY
     1042   f-sum-id
     1043   WITH FRAME DIALOG-FRAME.
     1044   END.
     1045   ON VALUE-CHANGED OF rs-field IN FRAME DIALOG-FRAME
     1046   DO:
     1047     IF rs-field = 'num-chk'
     1048     OR INPUT FRAME DIALOG-FRAME rs-field = 'num-chk' THEN DO:
     1049         ASSIGN
     1050         f-low =0.0
     1051         f-high = 0.0
     1052         .
     1053         HIDE
     1054         f-low
     1055         f-high
     1056         IN FRAME DIALOG-FRAME.
     1057     END.
     1058     ASSIGN
     1059     rs-field.
     1060     CASE rs-field:
     1061         WHEN "num-chk" THEN DO:
     1062             ASSIGN
     1063             f-low:FORMAT IN FRAME DIALOG-FRAME = '->>>>>>>>9'
     1064             f-high:FORMAT IN FRAME DIALOG-FRAME = '->>>>>>>>9'
     1065             .
     1066         END.
     1067         OTHERWISE DO:
     1068             ASSIGN
     1069             f-low:FORMAT IN FRAME DIALOG-FRAME = '->>>,>>>,>>>,>>9.99'
     1070             f-high:FORMAT IN FRAME DIALOG-FRAME = '->>>,>>>,>>>,>>9.99'
     1071             .
     1072         END.
     1073     END CASE.
     1074     display
     1075     f-low
     1076     f-high
     1077     with frame DIALOG-FRAME .
     1078   END.
     1079   ON VALUE-CHANGED OF RS-range IN FRAME DIALOG-FRAME
     1080   DO:
     1081     ASSIGN
     1082     rs-range.
     1083     CASE rs-range:
     1084         WHEN "GLOBAL":U THEN DO:
     1085            ASSIGN
     1086            f-host-code = 0
     1087            f-host-name = '':U
     1088            cb-obj-type = '':U
     1089            f-obj-code = 0
     1090            f-obj-name = '':U.
     1091            DISABLE
     1092            b-host
     1093            b-obj
     1094            WITH FRAME DIALOG-FRAME.
     1095            DISPLAY
     1096            f-host-code
     1097            f-host-name
     1098            cb-obj-type
     1099            f-obj-code
     1100            f-obj-name
     1101            WITH FRAME DIALOG-FRAME.
     1102         END.
     1103         WHEN "firm":U THEN DO:
     1104             ASSIGN
     1105             cb-obj-type = '':U
     1106             f-obj-code = 0
     1107             f-obj-name = '':U.
     1108             DISABLE
     1109             b-obj
     1110             WITH FRAME DIALOG-FRAME.
     1111             DISPLAY
     1112             f-host-code
     1113             f-host-name
     1114             cb-obj-type
     1115             f-obj-code
     1116             f-obj-name
     1117             WITH FRAME DIALOG-FRAME.
     1118             ENABLE
     1119             b-host
     1120             WITH FRAME DIALOG-FRAME.
     1121         END.
     1122         WHEN "object":U THEN DO:
     1123             ASSIGN
     1124             f-host-code = 0
     1125             f-host-name = '':U
     1126             cb-obj-type = '':U
     1127             f-obj-code = 0
     1128             f-obj-name = '':U.
     1129             DISABLE
     1130             b-host
     1131             WITH FRAME DIALOG-FRAME.
     1132             DISPLAY
     1133             f-host-code
     1134             f-host-name
     1135             cb-obj-type
     1136             f-obj-code
     1137             f-obj-name
     1138             WITH FRAME DIALOG-FRAME.
     1139             ENABLE
     1140             b-obj
     1141             WITH FRAME DIALOG-FRAME.
     1142         END.
     1143     END CASE.
     1144   END.
     1145   ON VALUE-CHANGED OF Rs-sum-id-type IN FRAME DIALOG-FRAME
     1146   DO:
     1147   ASSIGN
     1148   rs-sum-id-type.
     1149   CASE rs-sum-id-type:
     1150     WHEN 'general-sum-id':U THEN DO:
     1151       f-sum-id = '':U.
     1152       DISABLE
     1153       b-sum-id
     1154       WITH FRAME DIALOG-FRAME.
     1155       DISPLAY f-sum-id
     1156       WITH FRAME DIALOG-FRAME.
     1157     END.
     1158     WHEN 'partial-sum-id':U THEN DO:
     1159       ENABLE
     1160       b-sum-id
     1161       WITH FRAME DIALOG-FRAME.
     1162     END.
     1163   END CASE.
     1164   END.
     1165   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DIALOG-FRAME:PARENT eq ?
     1166   THEN FRAME DIALOG-FRAME:PARENT = ACTIVE-WINDOW.
     1167   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1168   on help of frame DIALOG-FRAME
     1169   do:
     1170     run gbl/app_help.p
     1171       (input this-procedure :file-name
     1172       ,input ''
     1173       ,input ?
     1174       ) no-error.
     1175     if error-status :error then do:
     1176       message
     1177         "Ошибка при вызове помощи"
     1178         error-status :get-message(1)
     1179         view-as alert-box .
     1180     end.
     1181   end.
     1182   run minbtn-set in this-procedure .
     1183   on choose of b-help in frame DIALOG-FRAME
     1184   do:
     1185     apply "help":u to frame DIALOG-FRAME .
     1186   end.
     1187   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1188   procedure minbtn-set :
     1189       do
     1190           on error undo, return error return-value
     1191           :
     1192           define variable ii              as integer       no-undo .
     1193           define variable fh              as widget-handle no-undo .
     1194           define variable hh              as widget-handle no-undo .
     1195           define variable v-h             as handle        extent 4 no-undo .
     1196           define variable v-name-button   as character     no-undo .
     1197           define variable v-help-old-x    as decimal       no-undo .
     1198           define variable v-help-old-y    as decimal       no-undo .
     1199           define variable v-help-old-size as decimal       no-undo .
     1200           define variable v-frame-width   as decimal       no-undo .
     1201           define variable jj              as integer       no-undo .
     1202           do
     1203               on error undo, return error
     1204               :
     1205               assign
     1206                   v-frame-width = frame DIALOG-FRAME:width - 0.3
     1207                   fh            = frame DIALOG-FRAME:first-child
     1208                   hh            = fh:first-child
     1209                   ii            = 1
     1210                   .
     1211               do while valid-handle(hh):
     1212                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1213                   do:
     1214                       case lc(hh:name) :
     1215                           when "b-help" then
     1216                               do:
     1217                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1218                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1219                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1220                                   hh:TOOLTIP = "Помощь" .
     1221                                   v-help-old-x = hh:column .
     1222                                   v-help-old-y = hh:row    .
     1223                                   v-help-old-size = hh:width .
     1224                                   hh:width-chars = 2.5 .
     1225                               end.
     1226                           when "b-print" then
     1227                               do:
     1228                                   hh:load-image("cmp/b-print.bmp":u) .
     1229                                   hh:TOOLTIP = "Печать" .
     1230                                   v-h[ii] = hh:handle .
     1231                                   ii = ii + 1 .
     1232                                   hh:width-chars = 3 .
     1233                               end.
     1234                           when "b-history" or
     1235                           when "b-hist" then
     1236                               do:
     1237                                   hh:load-image("cmp/b-hist.bmp":u) .
     1238                                   hh:TOOLTIP = "История" .
     1239                                   v-h[ii] = hh:handle .
     1240                                   ii = ii + 1 .
     1241                                   hh:width-chars = 3 .
     1242                               end.
     1243                           when "b-sch" then
     1244                               do:
     1245                                   hh:load-image("cmp/b-sch.bmp":u) .
     1246                                   hh:TOOLTIP = "Установка Фильтра" .
     1247                                   v-h[ii] = hh:handle .
     1248                                   ii = ii + 1 .
     1249                                   hh:width-chars = 3 .
     1250                               end.
     1251                           when "b-hist-user" then
     1252                               do:
     1253                                   hh:load-image("cmp/b-hist.bmp":u) .
     1254                                   hh:TOOLTIP = "История пользователя" .
     1255                                   ii = ii + 1 .
     1256                               end.
     1257                       end case.
     1258                   end.
     1259                   hh = hh:next-sibling.
     1260               end.
     1261               b-help:column = v-frame-width - b-help:width-chars.
     1262               jj = 0.
     1263               repeat ii = 4 to 1 by -1 :
     1264                   if valid-handle (v-h[ii] ) then
     1265                   do:
     1266                       jj  = jj + 1 .
     1267                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1268                       v-h[ii]:row    = v-help-old-y .
     1269                   end.
     1270               end.
     1271           end.
     1272       end.
     1273   end procedure.
     1274   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1275   ON TAB ANYWHERE
     1276   DO:
     1277   define variable ii as integer no-undo .
     1278   define variable fh as widget-handle no-undo .
     1279   define variable hh as widget-handle no-undo .
     1280   define variable v-next-widget-name as character no-undo .
     1281   if v-tab-order <> '' then do:
     1282     if self:type = "TOGGLE-BOX" then
     1283     self:BGCOLOR = ?.
     1284     assign
     1285     ii = lookup(self:name, v-tab-order).
     1286     assign
     1287     ii = ii + 1
     1288     v-next-widget-name = entry(ii, v-tab-order)
     1289     no-error .
     1290     if error-status:error then do:
     1291       assign
     1292       ii = 1
     1293       v-next-widget-name = entry( ii, v-tab-order)
     1294       .
     1295     end.
     1296     assign
     1297     fh = frame DIALOG-FRAME:first-child
     1298     hh = fh:first-child
     1299     .
     1300     do while valid-handle(hh):
     1301       if hh:name = v-next-widget-name then do:
     1302         if hh:sensitive  = yes
     1303         AND hh:visible = yes then do:
     1304           APPLY "ENTRY" to hh.
     1305           return no-apply.
     1306         end.
     1307         else do:
     1308           APPLY "TAB" to hh.
     1309           return no-apply.
     1310         end.
     1311       end.
     1312       hh = hh:next-sibling.
     1313     end.
     1314   end.
     1315   END.
     1316   ON BACK-TAB ANYWHERE
     1317   DO:
     1318   define variable ii as integer no-undo .
     1319   define variable fh as widget-handle no-undo .
     1320   define variable hh as widget-handle no-undo .
     1321   define variable v-next-widget-name as character no-undo .
     1322   if v-tab-order <> '' then do:
     1323     assign
     1324     ii = lookup(self:name, v-tab-order).
     1325     .
     1326     assign
     1327     ii = (if ii = 1
     1328           then  num-entries(v-tab-order)
     1329           else ii - 1
     1330           )
     1331     v-next-widget-name = entry(ii, v-tab-order)
     1332     .
     1333     assign
     1334     fh = frame DIALOG-FRAME:first-child
     1335     hh = fh:first-child
     1336     .
     1337     do while valid-handle(hh):
     1338       if hh:name = v-next-widget-name then do:
     1339         if hh:sensitive  = yes
     1340         AND hh:visible = yes then do:
     1341           APPLY "ENTRY" to hh.
     1342           return no-apply.
     1343         end.
     1344         else do:
     1345         APPLY "BACK-TAB" to hh.
     1346         return no-apply.
     1347         end.
     1348       end.
     1349       hh = hh:next-sibling.
     1350     end.
     1351     end.
     1352   END.
     1353   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1354   ON RETURN ANYWHERE
     1355   DO:
     1356   define variable ii as integer no-undo .
     1357   define variable fh as widget-handle no-undo .
     1358   define variable hh as widget-handle no-undo .
     1359   define variable v-next-widget-name as character no-undo .
     1360     if v-tab-order <> '' then do:
     1361       assign
     1362       ii = lookup(self:name, v-tab-order).
     1363       if ii = num-entries(v-tab-order) then do:
     1364           return no-apply.
     1365       end.
     1366       if self:type <> "BUTTON" and
     1367         self:type <> "EDITOR"  then do:
     1368         run proc-move-forward in this-procedure .
     1369         return no-apply.
     1370       end.
     1371       if self:type = "BUTTON" then do:
     1372         APPLY "CHOOSE" to self.
     1373       end.
     1374       if self:type = "TOGGLE-BOX" then
     1375       self:BGCOLOR = ?.
     1376       assign
     1377       ii = ii + 1
     1378       v-next-widget-name = entry(ii, v-tab-order)
     1379       no-error .
     1380       if error-status:error then do:
     1381         assign
     1382         ii = 1
     1383         v-next-widget-name = entry( ii, v-tab-order)
     1384         .
     1385       end.
     1386       assign
     1387       fh = frame DIALOG-FRAME:first-child
     1388       hh = fh:first-child
     1389       .
     1390       do while valid-handle(hh):
     1391         if hh:name = v-next-widget-name then do:
     1392           if hh:sensitive  = yes
     1393           AND hh:visible = yes then do:
     1394             APPLY "ENTRY" to hh.
     1395             return no-apply.
     1396           end.
     1397           else do:
     1398             APPLY "TAB" to hh.
     1399             return no-apply.
     1400           end.
     1401         end.
     1402         hh = hh:next-sibling.
     1403       end.
     1404     end.
     1405   END.
     1406   procedure proc-move-forward :
     1407   define variable ii as integer no-undo .
     1408   define variable fh as widget-handle no-undo .
     1409   define variable hh as widget-handle no-undo .
     1410   define variable v-next-widget-name as character no-undo .
     1411   do
     1412   on error undo, return error
     1413   :
     1414     if v-tab-order <> '' then do:
     1415       if self:type = "TOGGLE-BOX" then
     1416       self:BGCOLOR = ?.
     1417       assign
     1418       ii = lookup(self:name, v-tab-order).
     1419       assign
     1420       ii = ii + 1
     1421       v-next-widget-name = entry(ii, v-tab-order)
     1422       no-error .
     1423       if error-status:error then do:
     1424         assign
     1425         ii = 1
     1426         v-next-widget-name = entry( ii, v-tab-order)
     1427         .
     1428       end.
     1429       assign
     1430       fh = frame DIALOG-FRAME:first-child
     1431       hh = fh:first-child
     1432       .
     1433       do while valid-handle(hh):
     1434         if hh:name = v-next-widget-name then do:
     1435           if hh:sensitive  = yes
     1436           AND hh:visible = yes then do:
     1437             APPLY "ENTRY" to hh.
     1438             return.
     1439           end.
     1440           else do:
     1441             assign
     1442             ii = ii + 1
     1443             v-next-widget-name = entry(ii, v-tab-order)
     1444             no-error .
     1445             if error-status:error then do:
     1446               assign
     1447               ii = 1
     1448               v-next-widget-name = entry( ii, v-tab-order)
     1449               .
     1450             end.
     1451           end.
     1452         end.
     1453         hh = hh:next-sibling.
     1454       end.
     1455     end.
     1456   end.
     1457   end procedure.
     1458   MAIN-BLOCK:
     1459   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1460      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1461   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1462     run mainmenu_getcntxt in parparentproc
     1463       (output v-cntxt-db-num
     1464       ,output v-cntxt-userid
     1465       ,output v-cntxt-level
     1466       ,output v-cntxt-host-code-obj
     1467       ,output v-cntxt-obj-type
     1468       ,output v-cntxt-obj-code
     1469       ,output v-cntxt-db-num-obj
     1470       ,output v-cntxt-is-admin
     1471       ) .
     1472     run Myenable in this-procedure .
     1473     WAIT-FOR GO OF FRAME DIALOG-FRAME.
     1474   END.
     1475   run disable_UI.
     1476   PROCEDURE disable_UI :
     1477     HIDE FRAME DIALOG-FRAME.
     1478   END PROCEDURE.
     1479   PROCEDURE enable_UI :
     1480     DISPLAY Rs-sum-id-type RS-range f-host-code CB-obj-type f-obj-code rs-r-b
     1481             f-low rs-field f-high f-last-change-date rs-cond f-sum-id F-host-name
     1482             F-obj-name
     1483         WITH FRAME DIALOG-FRAME.
     1484     ENABLE B-exit b-quit B-Help Rs-sum-id-type B-sum-id RS-range B-host
     1485            CB-obj-type B-obj rs-r-b f-low rs-field f-high f-last-change-date
     1486            rs-cond f-sum-id F-host-name F-obj-name
     1487         WITH FRAME DIALOG-FRAME.
     1488     VIEW FRAME DIALOG-FRAME.
     1489   END PROCEDURE.
     1490   PROCEDURE MyEnable :
     1491   define buffer buf_clients for ub.clients.
     1492   ASSIGN
     1493   v-tab-order = "b-exit,b-quit,b-help,rs-sum-id,b-sum-id,rs-range,b-host,b-obj,rs-r-b,rs-field,f-low,f-high," +
     1494                 "f-last-change-date,rs-cond"
     1495   .
     1496   ASSIGN
     1497   rs-r-b:RADIO-BUTTONS IN FRAME DIALOG-FRAME = "руб" + chr(44) + 'rubl':U + chr(44) +
     1498                                                 "Баз.вал." + chr(44) + 'base':U
     1499   CB-obj-type:list-items = '':U + chr(44) + 'маг':U + chr(44) + 'скл':U
     1500   .
     1501   ASSIGN
     1502   rs-sum-id-type = (IF p-sum-id-type = '':U THEN 'general-sum-id' ELSE p-sum-id-type).
     1503   IF p-host-code <> 0  THEN DO:
     1504   FIND FIRST buf_clients NO-LOCK WHERE
     1505            buf_clients.obj-code = p-host-code
     1506         AND buf_clients.obj-type = 'орг':U NO-ERROR.
     1507   if available buf_clients then do:
     1508       assign
     1509       f-host-CODE = p-host-code
     1510       f-host-name = buf_clients.obj-name
     1511       .
     1512       DISPLAY
     1513       f-host-code
     1514       f-host-name
     1515       WITH FRAME DIALOG-FRAME.
     1516   END.
     1517   END.
     1518   IF NOT ( p-obj-type = '':U
     1519            AND p-obj-code = 0) THEN DO:
     1520       FIND FIRST buf_clients NO-LOCK WHERE
     1521              buf_clients.obj-type = p-obj-type
     1522          AND  buf_clients.obj-code = p-obj-code NO-ERROR.
     1523       if available buf_clients then do:
     1524           assign
     1525           f-obj-CODE = buf_clients.obj-code
     1526           CB-obj-type = buf_clients.obj-type
     1527           f-obj-name = buf_clients.obj-name
     1528           .
     1529           DISPLAY
     1530           f-obj-code
     1531           cb-obj-type
     1532           f-obj-name
     1533           WITH FRAME DIALOG-FRAME.
     1534       END.
     1535   END.
     1536   ASSIGN
     1537   CB-obj-type = p-obj-type
     1538   f-obj-code = p-obj-code
     1539   .
     1540   ASSIGN
     1541   rs-field = (IF p-field = '':U THEN 'pay-tot-rubl' ELSE p-field).
     1542   ASSIGN
     1543   rs-r-b = (IF p-r-b = '':U THEN 'rubl':U ELSE p-r-b)
     1544   .
     1545   if rs-sum-id-type = 'partial-sum-id' then do:
     1546     define variable v-sum-id as character no-undo .
     1547      v-sum-id = dct-algo-get-sum-id-from-dt-code (input p-dt-code).
     1548      if p-dt-code <> 0
     1549     AND CAN-FIND (FIRST ub.prop-ref WHERE
     1550                       ub.prop-ref.sum-id = v-sum-id)
     1551     THEN
     1552     ASSIGN
     1553     f-sum-id:PRIVATE-DATA = string(p-dt-code)
     1554     f-sum-id = dct-algo-get-description-sum-id(input p-dt-code)
     1555     .
     1556   end.
     1557   IF f-obj-code > 0 THEN DO:
     1558       ASSIGN
     1559       rs-range = "object":U.
     1560   END.
     1561   ELSE do:
     1562      IF f-host-code > 0 THEN DO:
     1563        ASSIGN
     1564        rs-range = "firm":U.
     1565      END.
     1566      ASSIGN
     1567      rs-range ="global":U.
     1568   END.
     1569   ASSIGN
     1570   f-last-change-date = p-last-change-date
     1571   rs-cond = p-cond.
     1572   DISPLAY
     1573   rs-range
     1574   rs-sum-id-type
     1575   f-sum-id
     1576   f-host-code
     1577   CB-obj-type
     1578   f-obj-code
     1579   rs-r-b
     1580   rs-field
     1581   rs-cond
     1582   f-last-change-date
     1583   WITH FRAME DIALOG-FRAME
     1584   .
     1585   ENABLE
     1586   B-exit
     1587   b-quit
     1588   B-Help
     1589   b-host
     1590   b-obj
     1591   b-sum-id when p-sum-id-type <> 'general-sum-id':U
     1592   rs-r-b
     1593   f-low
     1594   f-high
     1595   rs-field
     1596   rs-sum-id-type when p-sum-id-type = '':U
     1597   rs-range
     1598   rs-cond
     1599   f-last-change-date
     1600   WITH FRAME DIALOG-FRAME.
     1601   VIEW FRAME DIALOG-FRAME.
     1602   APPLY "VALUE-CHANGED" to rs-range.
     1603   APPLY "VALUE-CHANGED" to rs-field.
     1604   if RS-sum-id-type:SENSITIVE In FRAME DIALOG-FRAME THEN DO:
     1605     APPLY "VALUE-CHANGED" to rs-sum-id-type.
     1606   end.
     1607   RUN process-mode-interface IN THIS-PROCEDURE ( INPUT p-mode).
     1608   END PROCEDURE.
     1609   PROCEDURE proc-b-host :
     1610   define VARIABLE v-host-code LIKE ub.sysconf.host-code no-undo .
     1611   define variable v-rid-list as character no-undo .
     1612   define buffer buf_clients  for ub.clients.
     1613     do
     1614     on error undo, return error
     1615     :
     1616           run adm/sconfs.w (
     1617                 input parParentProc
     1618               , input "b-sel":U
     1619               , input no
     1620               , input v-cntxt-host-code-obj
     1621               , output v-host-code
     1622               , input-output v-rid-list
     1623           ) no-error.
     1624         IF v-rid-list = '':U THEN RETURN NO-APPLY.
     1625         FIND FIRST buf_clients NO-LOCK WHERE
     1626                    buf_clients.obj-code = v-host-code
     1627                 AND buf_clients.obj-type = 'орг':U NO-ERROR.
     1628         if not available buf_clients then do:
     1629              return error.
     1630         end.
     1631         assign
     1632         f-host-CODE = v-host-code
     1633         f-host-name = buf_clients.obj-name
     1634         .
     1635         DISPLAY
     1636         f-host-code
     1637         f-host-name
     1638         WITH FRAME DIALOG-FRAME.
     1639     end.
     1640   END PROCEDURE.
     1641   PROCEDURE proc-b-obj :
     1642   define variable v-rid-list as character no-undo .
     1643   define buffer buf_clients  for ub.clients.
     1644   define buffer buf_clients-host  for ub.clients.
     1645     do
     1646     on error undo, return error
     1647     :
     1648          run ref/cli-all.w (
     1649                    INPUT parparentproc
     1650                   ,INPUT "b-sel"
     1651                   ,INPUT 'объект':U
     1652                   ,INPUT 'все':U
     1653                   ,INPUT 'текущие':U
     1654                   ,INPUT ?
     1655                   ,INPUT ",,,,,,NO,,"
     1656                   ,INPUT "lock-cli-type"
     1657                   ,output v-rid-list ) NO-ERROR.
     1658        IF v-rid-list = '':U THEN RETURN error.
     1659         FIND FIRST buf_clients NO-LOCK WHERE
     1660             RECID( buf_clients) = INTEGER( v-rid-list ) NO-ERROR.
     1661         if not available buf_clients then do:
     1662              return error.
     1663         end.
     1664         IF NOT (buf_clients.obj-type = 'маг':U
     1665                 OR
     1666                 buf_clients.obj-type = 'скл':U)
     1667                 THEN DO:
     1668             MESSAGE
     1669             substitute("Неверный тип объекта &1", buf_clients.obj-type)
     1670             VIEW-AS ALERT-BOX ERROR.
     1671             RETURN ERROR.
     1672         END.
     1673         FIND FIRST buf_clients-host NO-LOCK WHERE
     1674                   buf_clients-host.obj-type = 'орг':U
     1675             AND   buf_clients-host.obj-code = buf_clients.host-code NO-ERROR.
     1676            IF NOT AVAILABLE buf_clients-host THEN DO:
     1677                MESSAGE
     1678                SUBSTITUTE("Не найдена фирма &1 для объекта &2&3"
     1679                           , buf_clients.host-code
     1680                           , buf_clients.obj-type
     1681                           , buf_clients.obj-code)
     1682                 VIEW-AS ALERT-BOX ERROR.
     1683                RETURN ERROR.
     1684            END.
     1685         assign
     1686         f-obj-CODE = buf_clients.obj-code
     1687         CB-obj-type = buf_clients.obj-type
     1688         f-obj-name = buf_clients.obj-name
     1689         f-host-code = buf_clients.host-code
     1690         f-host-name = buf_clients-host.obj-name
     1691         .
     1692         DISPLAY
     1693         f-obj-code
     1694         cb-obj-type
     1695         f-obj-name
     1696         f-host-name
     1697         f-host-code
     1698         WITH FRAME DIALOG-FRAME.
     1699     end.
     1700   END PROCEDURE.
     1701   PROCEDURE proc-save :
     1702   DEFINE BUFFER buf_clients for ub.clients.
     1703   DEFINE BUFFER buf_sysconf     FOR ub.sysconf.
     1704   DEFINE BUFFER buf_prop-ref    FOR ub.prop-ref.
     1705   ASSIGN FRAME DIALOG-FRAME
     1706   f-host-code when f-host-code:sensitive in frame DIALOG-FRAME
     1707   CB-obj-type when cb-obj-type:sensitive in frame DIALOG-FRAME
     1708   f-obj-code   when f-obj-code:sensitive in frame DIALOG-FRAME
     1709   rs-sum-id-type when rs-sum-id-type:sensitive in frame DIALOG-FRAME
     1710   f-sum-id   when f-sum-id:sensitive in frame DIALOG-FRAME
     1711   rs-field   when (rs-field:sensitive in frame DIALOG-FRAME AND rs-field:visible in frame DIALOG-FRAME)
     1712   rs-r-b  when (rs-r-b:sensitive in frame DIALOG-FRAME AND rs-r-b:visible in frame DIALOG-FRAME)
     1713   f-low WHEN f-low:VISIBLE IN FRAME DIALOG-FRAME
     1714   f-high WHEN f-high:VISIBLE IN FRAME DIALOG-FRAME
     1715   f-last-change-date WHEN (f-last-change-date:SENSITIVE IN FRAME DIALOG-FRAME AND f-last-change-date:visible IN FRAME DIALOG-FRAME)
     1716   rs-cond WHEN (rs-cond:SENSITIVE IN FRAME DIALOG-FRAME AND rs-cond:visible IN FRAME DIALOG-FRAME)
     1717   .
     1718   IF f-host-code <> 0  THEN DO:
     1719   find FIRST buf_sysconf NO-LOCK WHERE
     1720            buf_sysconf.host-code = f-host-code  NO-ERROR.
     1721       IF NOT AVAILABLE buf_sysconf THEN DO:
     1722           MESSAGE
     1723           "Неверный номер фирмы"
     1724           VIEW-AS ALERT-BOX.
     1725           UNDO, RETURN ERROR.
     1726       END.
     1727   END.
     1728   IF NOT (cb-obj-type = '':U AND f-obj-code = 0) THEN DO:
     1729     find FIRST buf_clients NO-LOCK WHERE
     1730               buf_clients.obj-type = cb-obj-type
     1731          AND buf_clients.obj-code = f-obj-code NO-ERROR.
     1732       IF NOT AVAILABLE buf_clients THEN DO:
     1733           MESSAGE
     1734           "Неверный номер объекта"
     1735           VIEW-AS ALERT-BOX.
     1736           UNDO, RETURN ERROR.
     1737       END.
     1738       IF NOT (buf_clients.obj-type = 'маг':U
     1739               OR
     1740               buf_clients.obj-type = 'скл':U)
     1741               THEN DO:
     1742       message
     1743       "Неверный тип объекта"
     1744       VIEW-AS ALERT-BOX.
     1745       UNDO, RETURN ERROR.
     1746     END.
     1747   END.
     1748   IF rs-sum-id-type = 'partial-sum-id':U THEN do:
     1749       FIND FIRST buf_prop-ref NO-LOCK WHERE
     1750                buf_prop-ref.sum-id = f-sum-id NO-ERROR.
     1751      IF NOT AVAILABLE buf_prop-ref THEN DO:
     1752          MESSAGE
     1753          substitute("Неверный частный итог &1", f-sum-id)
     1754          VIEW-AS ALERT-BOX ERROR.
     1755         UNDO, RETURN ERROR.
     1756      END.
     1757   END.
     1758   END PROCEDURE.
     1759   PROCEDURE process-mode-interface :
     1760   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
     1761   CASE p-mode:
     1762     WHEN "last-change" THEN DO:
     1763       HIDE
     1764       f-high IN FRAME DIALOG-FRAME
     1765       f-low
     1766       rs-field
     1767       rs-r-b
     1768       IN FRAME DIALOG-FRAME.
     1769     END.
     1770     WHEN "current-values" THEN DO:
     1771       HIDE
     1772       f-last-change-date IN FRAME DIALOG-FRAME
     1773       rs-cond
     1774       IN FRAME DIALOG-FRAME.
     1775     END.
     1776   END CASE.
     1777   END PROCEDURE.
