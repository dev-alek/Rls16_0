        1   block-level on error undo, throw.
        2   DEFINE INPUT PARAMETER to-del as logical no-undo.
        3   define input parameter parhost-code like ub.sysconf.host-code no-undo .
        4   define input parameter parobj-type like ub.clients.obj-type no-undo .
        5   define input parameter parobj-code like ub.clients.obj-code no-undo .
        6   define input parameter par-rec as recid no-undo.
        7   define input parameter par-copy-gds-code like ub.goods.gds-code no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: dtaxgdsu.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: ref/dtaxgdsu.p $":U .
       13   define variable vss-description as character no-undo init "Заполнение таблицы tax-rate-gds по полям временной таблицы tt-tax".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83     define SHARED temp-table  tt-tax no-undo
       84   field tax-code    like ub.tax.tax-code
       85   FIELD individual  like ub.tax.individual
       86   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
       87   field rate-code   like ub.tax-rate.rate-code
       88   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
       89   FIELD tax-type    like ub.tax.tax-type
       90   field rate-value  like ub.tax-rate-value.rate-value
       91   FIELD tax-rate-gds-rc  as recid
       92   FIELD to-cashdesk like ub.tax.to-cashdesk
       93   FIELD fact-date like ub.tax-rate-value.fact-date
       94   FIELD fact-order like ub.tax-rate-value.fact-order
       95   FIELD next-order like ub.tax-rate-value.fact-order
       96   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
       97   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
       98   FIELD corr-date like ub.tax-rate-gds.corr-date
       99   FIELD corr-time like ub.tax-rate-gds.corr-time
      100   index tax-code is unique primary tax-code fact-order descending rate-code.
      101   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      102   procedure factord :
      103     define input  parameter p-fact-date            as date    no-undo .
      104     define input  parameter p-fact-time            as integer no-undo .
      105     define input  parameter p-fact-num             as integer no-undo .
      106     define input  parameter p-shift-date           as date    no-undo .
      107     define input  parameter p-shift-num            as integer no-undo .
      108     define input  parameter p-shift-on             as logical no-undo .
      109     define output parameter p-fact-order           as decimal no-undo .
      110     define output parameter p-shift-end-fact-order as decimal no-undo .
      111     define output parameter p-day-end-fact-order   as decimal no-undo .
      112     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      113     if p-fact-date = ?
      114     then do:
      115       return error "Не указана фактическая дата" .
      116     end.
      117     define variable v-fact-date-num as integer no-undo .
      118     assign
      119       v-fact-date-num = integer(p-fact-date)
      120     .
      121     if p-fact-num = ?
      122     or p-fact-num = 0
      123     then do:
      124       return error "Не задан p-fact-num " + string(p-fact-num) .
      125     end.
      126     if p-fact-num < 0
      127     then do:
      128       return error "Отрицательный fact-num " + string(p-fact-num) .
      129     end.
      130     if p-fact-num >= 100000000
      131     then do:
      132       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      133     end.
      134     if p-shift-on = true
      135     then do:
      136       if p-shift-date = ?
      137       then do:
      138         return error "Не задана дата смены" .
      139       end.
      140       if p-shift-num = ?
      141       or p-shift-num = 0
      142       then do:
      143         return error "Не задан номер смены" .
      144       end.
      145     end.
      146     else do:
      147       assign
      148         p-shift-date = p-fact-date
      149         p-shift-num  = 24
      150       .
      151     end.
      152     define variable v-shift-offset as integer no-undo .
      153     if p-shift-date = p-fact-date
      154     then do:
      155       assign
      156         v-shift-offset = 1
      157       .
      158     end.
      159     if p-shift-date < p-fact-date
      160     then do:
      161       assign
      162         v-shift-offset = 0
      163       .
      164     end.
      165     if p-shift-date > p-fact-date
      166     then do:
      167       message
      168         vss-workfile vss-revision vss-description skip
      169         "Неправильная дата закрытия смены" skip
      170         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      171         view-as alert-box error .
      172       undo, return error
      173         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      174           ,string(p-fact-date, '99/99/9999':U)
      175           ,string(p-shift-date, '99/99/9999':U)
      176           )
      177       .
      178     end.
      179     if p-shift-num < 1
      180     or p-shift-num > 24
      181     then do:
      182       message
      183         vss-workfile vss-revision vss-description skip
      184         "Неправильный номер смены" skip
      185         "p-shift-num" p-shift-num skip
      186         view-as alert-box error .
      187       undo, return error return-value .
      188     end.
      189     assign
      190       p-fact-order           = v-fact-date-num
      191                              + v-shift-offset * 0.5
      192                              + p-shift-num    * 0.02 - 0.01
      193                              + p-fact-num     * 0.0000000001
      194       p-shift-end-fact-order = v-fact-date-num
      195                              + v-shift-offset * 0.5
      196                              + p-shift-num    * 0.02
      197       p-day-end-fact-order   = v-fact-date-num
      198                              + 0.99
      199     .
      200     if p-fact-order           <= v-fact-date-num
      201     or p-shift-end-fact-order <= v-fact-date-num
      202     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      203     or p-shift-end-fact-order >= p-day-end-fact-order
      204     then do:
      205       message
      206         vss-workfile vss-revision vss-description skip
      207         "Внутренняя ошибка при генерации фактического номера" skip
      208         "p-fact-date"            p-fact-date            skip
      209         "p-fact-time"            p-fact-time            skip
      210         "p-fact-num"             p-fact-num             skip
      211         "p-shift-date"           p-shift-date           skip
      212         "p-shift-num"            p-shift-num            skip
      213         "p-shift-on"             p-shift-on             skip
      214         "p-shift-end-fact-order" p-shift-end-fact-order skip
      215         "p-day-end-fact-order"   p-day-end-fact-order   skip
      216         "v-fact-date-num"        v-fact-date-num        skip
      217         view-as alert-box error .
      218       undo, return error return-value .
      219     end.
      220   end procedure.
      221   procedure day-begin-fact-order :
      222     define input  parameter p-fact-date            as date    no-undo .
      223     define output parameter p-day-begin-fact-order as decimal no-undo .
      224     do
      225     on error undo, return error return-value
      226     :
      227       if p-fact-date = ?
      228       then do:
      229         assign
      230           p-day-begin-fact-order = 0
      231         .
      232       end.
      233       else do:
      234         assign
      235           p-day-begin-fact-order = integer(p-fact-date)
      236         .
      237       end.
      238     end.
      239   end procedure.
      240   procedure factord-max-fact-order :
      241     define output parameter p-max-fact-order as decimal   no-undo .
      242     do
      243     on error undo, return error return-value
      244     :
      245       run day-begin-fact-order in this-procedure
      246         (input  date(1, 1, 5000)
      247         ,output p-max-fact-order
      248         ) .
      249     end.
      250   end procedure.
      251   procedure factord-cut-archive :
      252     define input  parameter p-obj-type             as character no-undo .
      253     define input  parameter p-obj-code             as integer   no-undo .
      254     define input  parameter p-fact-date            as date      no-undo .
      255     define output parameter p-shift-on             as logical   no-undo .
      256     define output parameter p-shift-date           as date      no-undo .
      257     define output parameter p-shift-num            as integer   no-undo .
      258     define output parameter p-day-end-fact-order   as decimal   no-undo .
      259     define output parameter p-shift-end-fact-order as decimal   no-undo .
      260     define variable v-fact-order as decimal   no-undo .
      261     define buffer buf_shift-obj for ub.shift-obj .
      262     do
      263     on error undo, return error return-value
      264     :
      265   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      266   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      267     (input  p-obj-type
      268     ,input  p-obj-code
      269     ,input  'shift-on=request'
      270     ,output p-shift-on
      271     ) no-error .
      272       if error-status :error
      273       then do:
      274         message
      275           vss-workfile vss-revision vss-description skip
      276           "Ошибка при определении атрибута объекта" skip
      277           "Объект" p-obj-type p-obj-code skip
      278           error-status :get-message(1) skip
      279           return-value skip
      280           view-as alert-box error .
      281         undo, return error return-value .
      282       end.
      283       if p-shift-on = false
      284       then do:
      285         assign
      286           p-shift-date               = ?
      287           p-shift-num                = 0
      288         .
      289       end.
      290       else do:
      291         find first buf_shift-obj share-lock
      292           where buf_shift-obj.obj-type   = p-obj-type
      293             and buf_shift-obj.obj-code   = p-obj-code
      294             and buf_shift-obj.shift-date > p-fact-date
      295           use-index pi
      296           no-error .
      297         if not available buf_shift-obj
      298         or buf_shift-obj.status_ <> 'зкр':U
      299         then do:
      300           message
      301             vss-workfile vss-revision vss-description skip
      302             "Невозможно вычислить последнюю смену" skip
      303             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      304             "Объект" p-obj-type p-obj-code skip
      305             "Дата" p-fact-date skip
      306             view-as alert-box error .
      307           undo, return error return-value .
      308         end.
      309         find last buf_shift-obj share-lock
      310           where buf_shift-obj.obj-type = p-obj-type
      311             and buf_shift-obj.obj-code = p-obj-code
      312             and buf_shift-obj.shift-date <= p-fact-date
      313           use-index pi
      314           no-error .
      315         if available buf_shift-obj
      316         then do:
      317           if  buf_shift-obj.status_ = 'зкр':U
      318           then do:
      319             assign
      320               p-shift-date = buf_shift-obj.shift-date
      321               p-shift-num  = buf_shift-obj.shift-num
      322             .
      323           end.
      324           else do:
      325             message
      326               vss-workfile vss-revision vss-description skip
      327               "Невозможно вычислить последнюю смену" skip
      328               "Статус смены отличен от статуса" 'зкр':U skip
      329               "Объект" p-obj-type p-obj-code skip
      330               "Дата" p-fact-date skip
      331               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      332               view-as alert-box error .
      333             undo, return error return-value .
      334           end.
      335         end.
      336         else do:
      337           assign
      338             p-shift-date = p-fact-date - 1
      339             p-shift-num  = 1
      340           .
      341         end.
      342       end.
      343       run factord in this-procedure
      344         (input  p-fact-date
      345         ,input  1
      346         ,input  1
      347         ,input  p-shift-date
      348         ,input  p-shift-num
      349         ,input  p-shift-on
      350         ,output v-fact-order
      351         ,output p-shift-end-fact-order
      352         ,output p-day-end-fact-order
      353         ) no-error .
      354       if error-status :error
      355       then do:
      356         message
      357           vss-workfile vss-revision vss-description skip
      358           "Ошибка при вызове процедуры factord"
      359           error-status :get-message(1) skip
      360           return-value skip
      361           view-as alert-box error .
      362         undo, return error return-value .
      363       end.
      364     end.
      365   end procedure.
      366   procedure factord-lock-shift :
      367     define input  parameter p-obj-type  as character no-undo .
      368     define input  parameter p-obj-code  as integer   no-undo .
      369     define input  parameter p-fact-date as date      no-undo .
      370     define parameter buffer buf_shift-obj for ub.shift-obj .
      371     define variable v-shift-on      as logical   no-undo .
      372     define variable v-extra-message as character no-undo .
      373     define variable v-error as character no-undo .
      374     do
      375     on error undo, return error return-value
      376     :
      377   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      378   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      379     (input  p-obj-type
      380     ,input  p-obj-code
      381     ,input  'shift-on=request'
      382     ,output v-shift-on
      383     ) no-error .
      384       if error-status :error
      385       then do:
      386         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      387         undo, return error v-error .
      388       end.
      389       if v-shift-on = true
      390       then do:
      391         find first buf_shift-obj share-lock
      392           where buf_shift-obj.obj-type   = p-obj-type
      393             and buf_shift-obj.obj-code   = p-obj-code
      394             and buf_shift-obj.shift-date > p-fact-date
      395           use-index pi
      396           no-error .
      397         if not available buf_shift-obj
      398         or buf_shift-obj.status_ <> 'зкр':U
      399         then do:
      400           find last buf_shift-obj
      401             where buf_shift-obj.obj-type = p-obj-type
      402               and buf_shift-obj.obj-code = p-obj-code
      403               and buf_shift-obj.status_  = 'зкр':U
      404             use-index stts
      405             no-error .
      406           if available buf_shift-obj
      407           then do:
      408             assign
      409               v-extra-message =
      410                     substitute("Дата начала последеней закрытой смены на объекте &1"
      411                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      412                               )
      413             .
      414           end.
      415           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      416           undo, return error v-error .
      417         end.
      418       end.
      419     end.
      420   end procedure.
      421   procedure factord-end-day :
      422     define input  parameter p-fact-date            as date    no-undo .
      423     define output parameter p-day-end-fact-order   as decimal no-undo .
      424     do
      425     on error undo, return error return-value
      426     :
      427       if p-fact-date = ?
      428       then do:
      429         return error "Не указана фактическая дата" .
      430       end.
      431       assign
      432         p-day-end-fact-order = integer(p-fact-date) + 0.99
      433       .
      434     end.
      435   end procedure.
      436   procedure factord-to-date :
      437     define input  parameter p-fact-order as decimal no-undo .
      438     define output parameter p-fact-date  as date    no-undo .
      439     define variable v-ref-date  as date      no-undo .
      440     define variable v-ref-delta as integer   no-undo .
      441     do
      442     on error undo, return error return-value
      443     :
      444       if p-fact-order = ?
      445       or p-fact-order = 0
      446       then do:
      447         return error "Не указан fact-order" .
      448       end.
      449       assign
      450         v-ref-date  = date(1, 1, 2000)
      451       .
      452       assign
      453         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      454       .
      455       assign
      456         p-fact-date = v-ref-date + v-ref-delta
      457       .
      458     end.
      459   end procedure.
      460   procedure factord-to-fact-num :
      461     define input  parameter p-fact-order as decimal no-undo .
      462     define output parameter p-fact-num   as integer no-undo .
      463     define variable v-fact-order-trunc as decimal no-undo .
      464     do
      465     on error undo, return error return-value
      466     :
      467       if p-fact-order = ?
      468       or p-fact-order = 0
      469       then do:
      470         return error "Не указан fact-order" .
      471       end.
      472       assign
      473        v-fact-order-trunc = truncate(p-fact-order, 2)
      474       .
      475       assign
      476         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      477       .
      478     end.
      479   end procedure.
      480   procedure factord-to-shift-num :
      481     define input  parameter p-fact-order as decimal no-undo .
      482     define output parameter p-shift-num   as integer no-undo .
      483     define variable  p-shift-numd  as decimal   no-undo .
      484     define variable v-fact-order-trunc as decimal no-undo .
      485     do
      486     on error undo, return error return-value
      487     :
      488       if p-fact-order = ?
      489       or p-fact-order = 0
      490       then do:
      491         return error "Не указан fact-order" .
      492       end.
      493       assign
      494        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      495       .
      496       if v-fact-order-trunc < 0.5 then do:
      497         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      498       end.
      499       assign
      500         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      501         .
      502        assign
      503         p-shift-num = truncate (p-shift-numd , 0)
      504       .
      505     end.
      506   end procedure.
      507   DEFINE VARIABLE v-fact-order like ub.tax-rate-gds.fact-order no-undo .
      508   define variable v-fact-date as date no-undo .
      509   define buffer b_tax-rate-gds for ub.tax-rate-gds.
      510   define buffer copy_tax-rate-gds for ub.tax-rate-gds.
      511   define buffer copy_goods for ub.goods.
      512   define buffer buf_tax-rate for ub.tax-rate.
      513   define buffer buf_tax for ub.tax.
      514   main-block:
      515   do
      516   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      517   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      518   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      519   :
      520   find first ub.goods share-lock where
      521              recid(ub.goods) = par-rec no-error.
      522   if not avail ub.goods then do:
      523     message
      524     vss-workfile vss-revision vss-description skip
      525     "Не найден товар - recid" par-rec
      526     view-as alert-box error .
      527     return error .
      528   end.
      529   _tt-tax:
      530   FOR EACH tt-tax:
      531     find first buf_tax-rate no-lock where
      532               buf_tax-rate.tax-code = tt-tax.tax-code
      533           and buf_tax-rate.rate-code = tt-tax.rate-code  no-error.
      534     if not available buf_tax-rate then do:
      535       find first buf_tax no-lock where
      536                 buf_tax.tax-code = tt-tax.tax-code no-error.
      537       if not available buf_tax then do:
      538         undo main-block, return error substitute("Неизвестный налог с кодом &1", tt-tax.tax-code).
      539       end.
      540       else do:
      541         if buf_tax.individual = yes then next.
      542       end.
      543       undo main-block, return error substitute("Отсутствует ставка налога &1 с кодом &2", tt-tax.tax-code, tt-tax.rate-code).
      544     end.
      545     assign
      546     v-fact-date = tt-tax.fact-date
      547     .
      548     run factord-end-day in this-procedure (input v-fact-date , output v-fact-order).
      549     if NOT tt-tax.tax-rate-gds-rc = ? then do:
      550       FIND  FIRST ub.tax-rate-gds where
      551                   recid(ub.tax-rate-gds) = tt-tax.tax-rate-gds-rc NO-ERROR.
      552       find LAST b_tax-rate-gds where
      553                 b_tax-rate-gds.gds-code = tax-rate-gds.gds-code AND
      554                 b_tax-rate-gds.tax-code = tax-rate-gds.tax-code AND
      555                 b_tax-rate-gds.host-code = tax-rate-gds.host-code AND
      556                 b_tax-rate-gds.obj-type = tax-rate-gds.obj-type AND
      557                 b_tax-rate-gds.obj-code = tax-rate-gds.obj-code AND
      558                 b_tax-rate-gds.fact-order <= v-fact-order no-error.
      559       if avail b_tax-rate-gds and b_tax-rate-gds.rate-code = tt-tax.rate-code then NEXT _tt-tax.
      560       if not avail b_tax-rate-gds or b_tax-rate-gds.fact-order < v-fact-order then do:
      561         create b_tax-rate-gds.
      562         buffer-copy tax-rate-gds except rate-code to b_tax-rate-gds
      563         assign
      564         b_tax-rate-gds.rate-code = tt-tax.rate-code
      565         b_tax-rate-gds.fact-order = v-fact-order
      566         b_tax-rate-gds.fact-date = v-fact-date
      567         .
      568       end.
      569       else do:
      570         if b_tax-rate-gds.rate-code <> tt-tax.rate-code then
      571         assign
      572         b_tax-rate-gds.rate-code = tt-tax.rate-code
      573         .
      574       end.
      575     end.
      576     if (not avail ub.tax-rate-gds or tt-tax.tax-rate-gds-rc = ?) and
      577         not tt-tax.individual then do:
      578         find First b_tax-rate-gds where
      579                   b_tax-rate-gds.gds-code = goods.gds-code AND
      580                   b_tax-rate-gds.tax-code = tt-tax.tax-code AND
      581                   b_tax-rate-gds.host-code = 0 AND
      582                   b_tax-rate-gds.obj-type = "":U AND
      583                   b_tax-rate-gds.obj-code = 0 AND
      584                   b_tax-rate-gds.fact-order <= v-fact-order no-error.
      585       if not avail b_tax-rate-gds then do:
      586         assign
      587         v-fact-date = 01/01/1990
      588         .
      589         run factord-end-day in this-procedure (input v-fact-date , output v-fact-order).
      590       end.
      591       if not avail b_tax-rate-gds
      592       or v-fact-order <> b_tax-rate-gds.fact-order  then do:
      593         create tax-rate-gds.
      594         assign
      595         tax-rate-gds.tax-code = tt-tax.tax-code
      596         tax-rate-gds.rate-code = tt-tax.rate-code
      597         tax-rate-gds.gds-code = goods.gds-code
      598         tax-rate-gds.fact-order = v-fact-order
      599         tax-rate-gds.fact-date = v-fact-date
      600         .
      601       end.
      602     end.
      603     if to-del then
      604     delete tt-tax.
      605   END.
      606   if par-copy-gds-code <> 0 then do:
      607     find first copy_goods no-lock where
      608               copy_goods.gds-code = par-copy-gds-code no-error .
      609     if not avail copy_goods then do:
      610       message
      611       "Не найден товар с кодом " par-copy-gds-code
      612       "-оригинал для копирования" skip
      613       view-as alert-box error .
      614       undo, return error.
      615     end.
      616     for each copy_tax-rate-gds no-lock where
      617              copy_tax-rate-gds.gds-code = copy_goods.gds-code and
      618              copy_tax-rate-gds.fact-order < v-fact-order:
      619        find first ub.tax-rate-gds No-LOCK where
      620                   ub.tax-rate-gds.gds-code = ub.goods.gds-code
      621               ANd ub.tax-rate-gds.tax-code = copy_tax-rate-gds.tax-code
      622               ANd ub.tax-rate-gds.host-code = copy_tax-rate-gds.host-code
      623               ANd ub.tax-rate-gds.obj-type = copy_tax-rate-gds.obj-type
      624               ANd ub.tax-rate-gds.obj-code = copy_tax-rate-gds.obj-code
      625               ANd ub.tax-rate-gds.fact-order = copy_tax-rate-gds.fact-order no-error .
      626       if not avail ub.tax-rate-gds then do:
      627         create ub.tax-rate-gds.
      628         buffer-copy copy_tax-rate-gds except gds-code to ub.tax-rate-gds
      629         assign
      630         ub.tax-rate-gds.gds-code = ub.goods.gds-code
      631         .
      632         release ub.tax-rate-gds no-error.
      633         if error-status:error then do:
      634           message
      635           "Не удалось создать копию истории по ставкам налогов для товара с кодом" goods.gds-code
      636           view-as alert-box error .
      637           undo, return error.
      638         end.
      639       end.
      640     end.
      641   end.
      642   end.
