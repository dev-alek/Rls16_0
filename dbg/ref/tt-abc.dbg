      539       (input  p-obj-type
      540       ,input  p-obj-code
      541       ,input  p-upper-code
      542       ,input  p-code
      543       ,input  p-value-character
      544       ,input  p-value-date
      545       ,input  p-value-decimal
      546       ,input  p-value-integer
      547       ,input  p-value-logical
