      383   procedure thbjattr_code_reg :
      384   define input  parameter p-upper-code     as character no-undo .
      385   define input  parameter p-code           as character no-undo .
      386   define output parameter p-label          as character no-undo .
      387   define output parameter p-user-can-edit  as logical   no-undo .
      388   define output parameter p-output-display as logical   no-undo .
      389   define output parameter p-other          as character no-undo .
      390   define output parameter p-prop-list      as character no-undo .
      391   define output parameter p-prop-type-list as character no-undo .
      392   define output parameter p-prop-label-list as character no-undo .
      393   define output parameter p-global          as logical no-undo .
      394   define output parameter p-host           as logical no-undo .
      395   define output parameter p-shop           as logical no-undo .
      396   define output parameter p-store          as logical no-undo .
      397   define output parameter p-db             as logical no-undo .
      398   define output parameter p-region         as logical no-undo .
      399   do
      400   on error undo, return error return-value
      401   :
      402       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      403       (input  p-upper-code
      404       ,input  p-code
      405       ,output p-label
      406       ,output p-user-can-edit
      407       ,output p-output-display
      408       ,output p-other
      409       ,output p-prop-list
      410       ,output p-prop-type-list
      411       ,output p-prop-label-list
      412       ,output p-global
      413       ,output p-host
      414       ,output p-shop
      415       ,output p-store
      416       ,output p-db
      417       ,output p-region
      418       ) no-error .
      419     if error-status :error
      420     then do:
      421       undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1)).
      422     end.
      423   end.
      424   end procedure.
