      634   end procedure.
      635   find first x-analysis no-error .
      636   define variable v-A     as decimal   no-undo .
      637   define variable v-B     as decimal   no-undo .
      638   define variable first-A as logical   no-undo .
      639   define variable first-B as logical   no-undo .
      640   define variable v-c as decimal   no-undo .
      641   define variable v-d as decimal   no-undo .
      642   define variable first-c as logical   no-undo .
      643   define variable first-d as logical   no-undo .
      644   define variable v-e as decimal   no-undo .
      645   define variable v-f as decimal   no-undo .
      646   define variable first-e as logical   no-undo .
      647   define variable first-f as logical   no-undo .
      648   define variable par-type as character no-undo .
      649   define variable par-abc-type as character no-undo .
      650   run waitfram-show ("Просчет АВС процентов...").
      651   define variable  v-value-date    as date   no-undo .
      652   define variable  v-value-decimal as decimal   no-undo .
      653   define variable  v-value-integer as integer   no-undo .
      654   define variable  v-value-logical as logical   no-undo .
      655   define variable v-found as logical   no-undo .
      656   run thbjattr_value in this-procedure  (
      657     input   "",
      658     input   0 ,
      659     input   'abc-global':U ,
      660     input   'abc-type'  ,
      661     output  par-abc-type ,
      662     output  v-value-date      ,
      663     output  v-value-decimal   ,
      664     output  v-value-integer   ,
      665     output  v-value-logical   ,
      666     output  par-type            ,
      667     output  v-found
      668     ) no-error
      669     .
      670     if error-status :error or v-found = false then do:
      671         message "Нет настроек Ассортиментной политики !!!." view-as alert-box information .
      672         return error return-value .
      673     end.
      674   define variable v-pr1 as decimal   no-undo .
      675   v-pr1 = 0 .
      676   for each temp-tt :
      677      v-pr1 = v-pr1 + temp-tt.summa.
      678   end.
      679   for each temp-tt :
      680     temp-tt.proc = temp-tt.summa * 100 / v-pr1 .
      681   end.
      682   assign
      683     v-a = x-analysis.double-line-proc
      684     first-A = true
      685     .
      686   define variable v-nak as decimal   no-undo .
      687   v-nak = 0.
      688   if x-analysis.abc-type = "2" then do:
      689   for each temp-tt
      690            break by temp-tt.proc desc :
      691       v-nak = v-nak + temp-tt.proc .
      692       temp-tt.proc-acc1 = v-nak .
      693       if v-nak <= v-A   then do:
      694          temp-tt.ABC-1 = "A" .
      695          first-A = true.
      696          next.
      697       end.
      698       if v-nak > v-A  then do:
      699          if first-A = true then
      700             assign
      701               first-A = false
      702               temp-tt.ABC-1 = "A"
      703             .
      704           else
      705             assign
      706               temp-tt.ABC-1 = "B"
      707             .
      708       end.
      709   end.
      710   define variable v-80 as decimal   no-undo .
      711   assign
      712     v-a = x-analysis.abc-a
      713     v-b = x-analysis.abc-b
      714     v-c = x-analysis.abc-c
      715     v-d = x-analysis.abc-d
      716     v-e = x-analysis.abc-e
      717     v-f = x-analysis.abc-f
      718     first-A = true
      719     first-B = true
      720     first-c = true
      721     first-d = true
      722     first-e = true
      723     first-f = true
      724     v-nak = 0
      725     v-80  = 0
      726     .
      727   for each temp-tt  where temp-tt.ABC-1 = "A"
      728     :
      729     v-80 = v-80 + temp-tt.summa .
      730   end.
      731   for each temp-tt  where temp-tt.ABC-1 = "A"
      732       break by temp-tt.summa desc
      733       :
      734       temp-tt.proc-2 = temp-tt.summa * 100 / v-80 .
      735   end.
      736   define variable first-str as logical   no-undo .
      737   first-str = true .
      738   for each temp-tt  where temp-tt.ABC-1 = "A"
      739       break by temp-tt.proc-2 desc
      740       :
      741       v-nak = v-nak + temp-tt.proc-2 .
      742       temp-tt.proc-acc2  = v-nak .
      743       if first-str = true and v-nak > v-A then do:
      744          temp-tt.ABC = "A" .
      745          first-A = false .
      746          first-str = false .
      747          next.
      748       end.
      749       first-str = false .
      750       if v-nak <= v-A   then do:
      751          temp-tt.ABC = "A" .
      752          first-A = true.
      753          next.
      754       end.
      755       if v-nak > v-A  and v-nak <= v-B then do:
      756          if first-A = true then
      757             assign
      758               first-A = false
      759               temp-tt.abc = "A"
      760             .
      761           else
      762             assign
      763               temp-tt.abc = "B"
      764             .
      765       end.
      766       if v-nak > v-B  and v-nak <= v-C then do:
      767          if first-B = true then
      768             assign
      769               first-B = false
      770               temp-tt.abc = "B"
      771             .
      772             else
      773               assign
      774                 temp-tt.abc = "C"
      775               .
      776       end.
      777       if v-nak >  v-c  and length(par-abc-type) = 3 then temp-tt.abc = "C" .
      778       if length(par-abc-type) >= 4 then do:
      779           if v-nak > v-c  and v-nak <= v-d then do:
      780             if first-c = true then
      781                 assign
      782                   first-c = false
      783                   temp-tt.abc = "C"
      784                 .
      785                 else
      786                   assign
      787                     temp-tt.abc = "D"
      788                   .
      789           end.
      790           if v-nak >  v-d  and length(par-abc-type) = 4 then temp-tt.abc = "D" .
      791       end.
      792       if length(par-abc-type) >= 5 then do:
      793           if v-nak > v-d  and v-nak <= v-e then do:
      794             if first-d = true then
      795                 assign
      796                   first-d = false
      797                   temp-tt.abc = "D"
      798                 .
      799                 else
      800                   assign
      801                     temp-tt.abc = "E"
      802                   .
      803           end.
      804           if v-nak >  v-e  and length(par-abc-type) = 5 then temp-tt.abc = "E" .
      805       end.
      806       if length(par-abc-type) >= 6 then do:
      807           if v-nak > v-e  and v-nak <= v-f then do:
      808             if first-e = true then
      809                 assign
      810                   first-e = false
      811                   temp-tt.abc = "E"
      812                 .
      813                 else
      814                   assign
      815                     temp-tt.abc = "F"
      816                   .
      817           end.
      818           if v-nak >  v-f then do:
      819                   assign
      820                     temp-tt.abc = "F"
      821                   .
      822           end.
      823       end.
      824   end.
      825   define variable LE-proc as decimal   no-undo .
      826   define variable label-a as character no-undo .
      827   define variable label-b as character no-undo .
      828   case par-abc-type :
      829      when 'ABC':U
      830         then do:
      831         label-a  = "D"  .
      832         label-b  = "E"  .
      833         end.
      834      when 'ABCD':U
      835         then do:
      836         label-a = "E"  .
      837         label-b = "F"  .
      838         end.
      839      when 'ABCDE':U
      840         then do:
      841         label-a = "F"  .
      842         label-b = "G"  .
      843         end.
      844      when 'ABCDEF':U
      845         then do:
      846         label-a = "G"  .
      847         label-b = "H"  .
      848         end.
      849   end case.
      850   assign
      851     LE-proc = x-analysis.LE-proc
      852     .
      853   for each temp-tt  where temp-tt.ABC-1 = "B"
      854       break by temp-tt.proc desc
      855       :
      856       if temp-tt.proc <= LE-proc   then do:
      857          temp-tt.abc = label-b .
      858       end.
      859       else temp-tt.abc = label-a .
      860   end.
      861   end.
      862   else do:
      863   assign
      864     v-a = x-analysis.abc-a
      865     v-b = x-analysis.abc-b
      866     v-c = x-analysis.abc-c
      867     v-d = x-analysis.abc-d
      868     v-e = x-analysis.abc-e
      869     v-f = x-analysis.abc-f
      870     first-A = true
      871     first-B = true
      872     first-c = true
      873     first-d = true
      874     first-e = true
      875     first-f = true
      876     v-nak = 0
      877     v-80  = 0
      878     .
      879   define variable first-str2 as logical   no-undo .
      880   first-str2 = true .
      881   for each temp-tt
      882       break by temp-tt.proc desc
      883       :
      884       v-nak = v-nak + temp-tt.proc .
      885       temp-tt.proc-acc1  = v-nak .
      886       if first-str2 = true  and v-nak > v-A then do:
      887          temp-tt.ABC = "A" .
      888          first-A = false .
      889          first-str2 = false  .
      890          next.
      891       end.
      892       first-str2 = false  .
      893       if v-nak <= v-A   then do:
      894          temp-tt.ABC = "A" .
      895          first-A = true.
      896          next.
      897       end.
      898       if v-nak > v-A  and v-nak <= v-B then do:
      899          if first-A = true then
      900             assign
      901               first-A = false
      902               temp-tt.abc = "A"
      903             .
      904           else
      905             assign
      906               temp-tt.abc = "B"
      907             .
      908       end.
      909       if v-nak > v-B  and v-nak <= v-C then do:
      910          if first-B = true then
      911             assign
      912               first-B = false
      913               temp-tt.abc = "B"
      914             .
      915             else
      916               assign
      917                 temp-tt.abc = "C"
      918               .
      919       end.
      920       if v-nak >  v-c  and length(par-abc-type) = 3 then temp-tt.abc = "C" .
      921       if length(par-abc-type) >= 4 then do:
      922           if v-nak > v-c  and v-nak <= v-d then do:
      923             if first-c = true then
      924                 assign
      925                   first-c = false
      926                   temp-tt.abc = "C"
      927                 .
      928                 else
      929                   assign
      930                     temp-tt.abc = "D"
      931                   .
      932           end.
      933           if v-nak >  v-d  and length(par-abc-type) = 4 then temp-tt.abc = "D" .
      934       end.
      935       if length(par-abc-type) >= 5 then do:
      936           if v-nak > v-d  and v-nak <= v-e then do:
      937             if first-d = true then
      938                 assign
      939                   first-d = false
      940                   temp-tt.abc = "D"
      941                 .
      942                 else
      943                   assign
      944                     temp-tt.abc = "E"
      945                   .
      946           end.
      947           if v-nak >  v-e  and length(par-abc-type) = 5 then temp-tt.abc = "E" .
      948       end.
      949       if length(par-abc-type) >= 6 then do:
      950           if v-nak > v-e  and v-nak <= v-f then do:
      951             if first-e = true then
      952                 assign
      953                   first-e = false
      954                   temp-tt.abc = "E"
      955                 .
      956                 else
      957                   assign
      958                     temp-tt.abc = "F"
      959                   .
      960           end.
      961           if v-nak >  v-f then do:
      962                   assign
      963                     temp-tt.abc = "F"
      964                   .
      965           end.
      966       end.
      967   end.
      968   end.
      969   run waitfram-hide.
