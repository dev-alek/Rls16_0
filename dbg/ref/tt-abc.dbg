      503   define input  parameter p-mode as character no-undo .
      504   define input-output parameter table-handle p-tth.
      505   define output parameter p-all-found as decimal no-undo .
      506   do
      507   on error undo, return error return-value
      508   :
      509       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_get-section in g#attr-lib
      510       (input  p-obj-type
      511       ,input  p-obj-code
      512       ,input  p-upper-param-code
      513       ,input  p-mode
      514       ,input-output table-handle p-tth
      515       ,output p-all-found
      516       ) no-error .
      517     if error-status :error
      518     then do:
      519       delete object p-tth.
      520       undo, return error return-value .
      521     end.
      522     delete object p-tth.
      523   end.
      524   end procedure.
      525   procedure thbjattr_write :
