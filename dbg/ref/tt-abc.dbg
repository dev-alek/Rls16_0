        1   block-level on error undo, throw.
        2   define temp-table temp-tt no-undo
        3   field id        as recid
        4   field summa     as decimal
        5   field proc      as decimal
        6   field proc-2    as decimal
        7   field proc-acc1 as decimal
        8   field proc-acc2 as decimal
        9   field ABC-1     as character
       10   field ABC       as character
       11   index pi proc desc
       12   index pi1 proc-acc1 desc
       13   index pi2 proc-acc2 desc
       14   index pi3 id
       15   .
       16   define temp-table  x-analysis        no-undo  like ub.abc-analysis.
       17   define input         parameter table for    x-analysis.
       18   define input-output  parameter table for    temp-tt.
       19   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       20   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       21   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       22   define variable vss-workfile    as character no-undo init "$Workfile: tt-abc.p $":U .
       23   define variable vss-archive     as character no-undo init "$Archive: ref/tt-abc.p $":U .
       24   define variable vss-description as character no-undo init "Процедура проставления ABC по временной таблице temp-tt".
       25   procedure vss-get-info :
       26     define output parameter p-vss-revision    like vss-revision    no-undo .
       27     define output parameter p-vss-author      like vss-author      no-undo .
       28     define output parameter p-vss-date        like vss-date        no-undo .
       29     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       30     define output parameter p-vss-archive     like vss-archive     no-undo .
       31     define output parameter p-vss-description like vss-description no-undo .
       32     assign
       33       p-vss-revision    = vss-revision
       34       p-vss-author      = vss-author
       35       p-vss-date        = vss-date
       36       p-vss-workfile    = vss-workfile
       37       p-vss-archive     = vss-archive
       38       p-vss-description = vss-description
       39     .
       40   end procedure.
       41   procedure vss-get-parameters :
       42     define output parameter p-vss-parameters as character no-undo .
       43   end procedure.
       44   define new global shared variable g#vssrevis-logger as handle    no-undo .
       45   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       46   define variable v-vssrevis-logger                   as handle    no-undo .
       47   procedure vss-logevent :
       48     define input  parameter p-extra-paramters as character no-undo .
       49     define variable v-vssrevis-parameters as character no-undo .
       50     do
       51     on error undo, return error return-value
       52     :
       53       if  valid-handle(v-vssrevis-logger)
       54       and v-vssrevis-logger :get-signature("logevent") <> ""
       55       then do:
       56         run vss-get-parameters in this-procedure
       57           (output v-vssrevis-parameters
       58           ).
       59         run logevent in v-vssrevis-logger
       60           (input vss-workfile
       61           ,input vss-revision
       62           ,input v-vssrevis-parameters
       63           ,input p-extra-paramters
       64           ).
       65       end.
       66     end.
       67   end procedure.
       68   assign
       69     v-vssrevis-logger = g#vssrevis-logger
       70   .
       71   if  valid-handle(v-vssrevis-logger)
       72   and v-vssrevis-logger :get-signature("logevent") <> ""
       73   then do:
       74     assign
       75       v-vssrevis-logevent = true
       76     .
       77     run vss-logevent in this-procedure (input vss-description) .
       78   end.
       79   define new global shared variable g#language as character no-undo .
       80   if g#language <> '' and g#language <> 'rus':U then do:
       81     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       82   end.
       83   define new global shared variable g#library  as handle no-undo .
       84   define new global shared variable g#library2 as handle no-undo .
       85   define   shared variable g#auto as logical no-undo.
       86   define   shared variable g#news as logical no-undo.
       87   define   shared variable g#oxml as logical no-undo.
       88   define   shared variable g#esys as logical no-undo.
       89   define   shared variable g#news-source-db as integer no-undo.
       90   define   shared variable g#esys-source-esys as integer no-undo.
       91   define   shared variable g#db-num as integer   no-undo .
       92   define   shared variable g#userid as character no-undo .
       93   define   shared variable g#passwd as character no-undo .
       94   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       95   define variable v-waitfram-action01         as character   no-undo .
       96   define variable v-waitfram-action02         as character   no-undo .
       97   define variable v-waitfram-action03         as character   no-undo .
       98   define variable mWaitFramTextBeg            as character   no-undo.
       99   define variable mWaitFramTextEnd            as character   no-undo.
      100   define variable mWaitFramView               as logical     no-undo.
      101   define variable mWaitProcEvent              as logical     no-undo init yes.
      102   define variable mWaitFramInterval           as integer     no-undo init 1 .
      103   define variable mWaitFramStop               as logical     no-undo.
      104   define variable mWaitFramStopUser           as logical     no-undo.
      105   define variable mWaitFramStopTimeOut        as logical     no-undo.
      106   define variable mWaitFramStartProc          as datetime-tz no-undo.
      107   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      108   define button B-WaitFramStop auto-end-key
      109        label "Стоп"
      110        size 10 by 1 tooltip "Остоновить процесс".
      111   define button B-viewProcInfo
      112        label "Информация"
      113        size 15 by 1 tooltip "Информация о процесс".
      114   define frame waitfram
      115     v-waitfram-action01 format "x(72)" no-label skip
      116     v-waitfram-action02 format "x(72)" no-label skip
      117     v-waitfram-action03 format "x(72)" no-label skip
      118     B-viewProcInfo
      119     B-WaitFramStop at row 4 col 30
      120     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      121     .
      122   define new global shared variable mBatchMode as logical no-undo init ?.
      123   define variable mFramBachModHandle as handle no-undo.
      124   mFramBachModHandle = frame waitfram:handle.
      125   define variable mFameOldVis as logical no-undo.
      126   define variable mVisCUrentVin as logical no-undo.
      127   if session:batch-mode
      128   then
      129      mBatchMode = yes.
      130   if mBatchMode = ? then do:
      131     mVisCUrentVin = current-window:visible.
      132     mFameOldVis = mFramBachModHandle:visible.
      133     mFramBachModHandle:visible  = yes.
      134     mBatchMode = mFramBachModHandle:visible ne yes.
      135     mFramBachModHandle:visible = mFameOldVis.
      136     current-window:visible = mVisCUrentVin.
      137   end.
      138    if  log-manager:logfile-name ne ?
      139     then DO:
      140         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      141         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      142         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      143     end.
      144   on choose of B-WaitFramStop in frame waitfram
      145   do:
      146     mWaitFramStop = yes.
      147     mWaitFramStopUser = yes.
      148   end.
      149   function waitfram-check-timeout returns logical():
      150      define variable vtime as int64 no-undo.
      151      if mWaitFramStopTimeOut
      152      then
      153         return yes.
      154      vtime = ( now - mWaitFramStartProc ) / 1000 .
      155      if     mWaitFramTimeOut ne ?
      156         and mWaitFramTimeOut ne 0
      157         and mWaitFramTimeOut lt vtime
      158      then do:
      159         mWaitFramStopTimeOut = yes.
      160      end.
      161      return mWaitFramStopTimeOut.
      162   end.
      163   procedure waitfram-hide :
      164     if not session:batch-mode
      165     then do
      166     on error undo, return error return-value
      167     :
      168       pause 0 before-hide .
      169       if not mBatchMode then
      170         hide frame waitfram .
      171     if     not mWaitFramView
      172        and mWaitProcEvent
      173     then
      174       process events .
      175     end.
      176   end procedure.
      177   procedure waitfram-show :
      178     define input  parameter p-message as character no-undo .
      179     define variable v-left-margin as integer   no-undo .
      180     if not session:batch-mode
      181     then do
      182     on error undo, return error return-value
      183     :
      184       if length(p-message) <= 70 then do:
      185         assign
      186           v-left-margin = integer((70 - length(p-message)) / 2)
      187         .
      188         assign
      189           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      190         .
      191         assign
      192           v-waitfram-action01 = " "
      193           v-waitfram-action02 = " "
      194                                    + fill(" ", v-left-margin)
      195                                    + p-message
      196           v-waitfram-action03 = " "
      197         .
      198       end.
      199       else do:
      200         define variable vRindex1 as integer no-undo.
      201         define variable vRindex2 as integer no-undo.
      202         vRindex1 = r-index(p-message," ",70).
      203         if vRindex1 = 0
      204         then
      205            vRindex1 = 70.
      206         if length(p-message)  <= vRindex1 + 70 then do:
      207           assign
      208             v-waitfram-action01 = " "
      209             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      210             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      211           .
      212         end.
      213         else do:
      214           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      215           if vRindex2 <= vRindex1
      216           then
      217              vRindex2 = vRindex1 + 70.
      218           assign
      219             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      220             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      221             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      222           .
      223         end.
      224       end.
      225       B-viewProcInfo:visible   in frame waitfram = no.
      226       B-viewProcInfo:sensitive in frame waitfram = no.
      227       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      228       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      229       if  (   mWaitFramView
      230          or  mWaitProcEvent)
      231          and not mBatchMode
      232       then
      233          display
      234             v-waitfram-action01 skip
      235             v-waitfram-action02 skip
      236             v-waitfram-action03 skip
      237          with frame waitfram .
      238       if     mWaitFramView
      239          then do:
      240             if     mWaitFramInterval ne ?
      241                and not mBatchMode
      242             then
      243                wait-for go of frame waitfram pause mWaitFramInterval.
      244          end.
      245          else
      246             if     mWaitProcEvent
      247                and not mBatchMode
      248             then
      249                process events .
      250     end.
      251   end procedure.
      252      procedure waitfram-show-this:
      253         define input  parameter iInterval as int64 no-undo.
      254         define variable vtime as int64 no-undo.
      255         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      256         mWaitFramInterval = iInterval.
      257         run waitfram-show (substitute("&1&2 &3&4" ,
      258                                       mWaitFramTextBeg ,
      259                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      260                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      261                                       mWaitFramTextEnd
      262                                      )
      263                           ).
      264      end.
      265      procedure WaitFramRunPause:
      266         define input  parameter iInterval as dec no-undo.
      267         define variable vStart  as datetime-tz no-undo.
      268         define variable vend    as datetime-tz no-undo.
      269         define variable vint as int64 no-undo.
      270         define variable vOk as logical no-undo.
      271         vStart = now.
      272         vend   = vStart.
      273         publish "WaitFramPause" (iInterval,output vOk).
      274         vend   =  now.
      275         vint = vend - vStart.
      276         vint = iInterval - vint / 1000.
      277         if     not mWaitFramStop
      278            and (   vint > 0
      279                 or (    not vOk
      280                     and iInterval eq ?
      281                     )
      282                 )
      283         then
      284            run waitfram-show-this (iInterval).
      285         vend   =  now.
      286         vint = vend - vStart.
      287         vint = iInterval - vint / 1000.
      288         if     not mWaitFramStop
      289            and vint > 0
      290         then do:
      291            run gbl/pause.p (vint * 1000).
      292         end.
      293         if iInterval ne ?
      294         then
      295            publish "WaitFramStop".
      296         waitfram-check-timeout().
      297      end.
      298      procedure WaitFramWaitFor:
      299         define input  parameter iInterval as dec no-undo.
      300         assign
      301            mWaitFramStartProc   = now
      302            mWaitFramStopUser    = no
      303            mWaitFramStopTimeOut = no
      304         .
      305         block-wait:
      306         do while not mWaitFramStop:
      307            run WaitFramRunPause (iInterval).
      308            if  waitfram-check-timeout()
      309            then do:
      310               leave block-wait.
      311            end.
      312         end.
      313         run waitfram-hide.
      314      end.
      315   procedure waitfram-join :
      316     define input  parameter p-line-1  as character no-undo .
      317     define input  parameter p-line-2  as character no-undo .
      318     define input  parameter p-line-3  as character no-undo .
      319     define output parameter p-message as character no-undo .
      320     do
      321     on error undo, return error return-value
      322     :
      323       assign
      324         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      325                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      326                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      327       .
      328     end.
      329   end procedure.
      330   function waitfram-join-function returns character
      331     (input p-line-1 as character
      332     ,input p-line-2 as character
      333     ,input p-line-3 as character
      334     ).
      335     define variable v-message as character no-undo .
      336     run waitfram-join in this-procedure
      337       (input  p-line-1
      338       ,input  p-line-2
      339       ,input  p-line-3
      340       ,output v-message
      341       ) .
      342     return v-message .
      343   end function .
      344   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      345   define new global shared variable g#attr-lib  as handle no-undo .
      346   define variable v-attr-lib-variable as handle no-undo .
