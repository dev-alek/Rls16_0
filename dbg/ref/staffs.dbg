     5745       ,input  v-cntxt-userid
     5746       ,input  0
     5747       ,input  'actn_cashdesk-cashiers_update':U
     5748       ,input  'object':U
     5749       ,input  v-cntxt-host-code-obj
     5750       ,input  v-cntxt-obj-type
     5751       ,input  v-cntxt-obj-code
     5752       ,input  0
     5753       ,input  0
     5754       ,input  0
     5755       ,input  false
     5756       ,output glog
     5757       )  .
     5758   end.
     5759     if NOT glog
     5760     then do :
     5761       message "У вас не хватает прав на изменение." skip
     5762               "(actn_cashdesk-cashiers_update)"
     5763       view-as alert-box error .
     5764       return no-apply .
     5765     end .
     5766   end.
     5767   if NOT glog
     5768   then do :
     5769     message "У вас не хватает прав на изменение." skip
     5770             "(actn_client-reference_update)"
     5771     view-as alert-box error .
     5772     return no-apply .
     5773   end .
     5774   assign
     5775   ric = recid( X_clients )
     5776   ri = recid( X_staff )
     5777   .
     5778   CASE p-option:
     5779     WHEN 'чел':U THEN DO:
     5780       run ref/personi.w (
     5781                        input parparentproc
     5782                       ,input 'ИЗМЕНЕНИЕ':U
     5783                       ,input X_clients.obj-code
     5784                       ,input X_clients.grp-code
     5785                       ,input p-role
     5786                       ,input-output  ric) .
     5787       if ric <> ? then do:
     5788         run OpenBr in this-procedure ( INPUT yes, INPUT no, INPUT '':U).
     5789         reposition br-staff to recid ri no-error .
     5790       end.
     5791     END.
     5792     WHEN  "staff":U THEN DO:
     5793        run ref/rolei.p (
     5794                        input parparentproc
     5795                       ,input 'ИЗМЕНЕНИЕ':U
     5796                       ,input X_clients.obj-code
     5797                       ,input X_staff.role
     5798                       ,input X_staff.role-level
     5799                       ,input-output  ri
     5800                       ,input-output table tt-staff
     5801                       ) .
     5802       IF ri <> ? THEN DO:
     5803           run OpenBr in this-procedure ( INPUT yes, INPUT no, INPUT '':U).
     5804           reposition br-staff to recid ri no-error .
     5805       END.
     5806     END.
     5807   END CASE.
     5808   apply "entry" to br-staff IN FRAME d-sel .
     5809   END PROCEDURE.
     5810   PROCEDURE proc-b-del :
     5811   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     5812   define variable glog as logical no-undo .
     5813   define variable ri as recid no-undo .
     5814   define variable ric as recid no-undo .
     5815   DEFINE VARIABLE v-today as date no-undo .
     5816   DEFINE VARIABLE v-time as integer no-undo .
     5817   define buffer buf_clients for ub.clients.
     5818   IF NOT AVAILABLE X_staff  THEN RETURN.
     5819   define variable vss-include-info52 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5820   do:
     5821     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5822       (input  v-cntxt-db-num
     5823       ,input  v-cntxt-userid
     5824       ,input  0
     5825       ,input  'actn_client-reference-prs_add-del':U
     5826       ,input  'global':U
     5827       ,input  0
     5828       ,input  '':U
     5829       ,input  0
     5830       ,input  0
     5831       ,input  0
     5832       ,input  0
     5833       ,input  true
     5834       ,output glog
     5835       )  .
     5836   end.
     5837   if NOT glog then return no-apply .
     5838   CASE p-option :
     5839     WHEN 'staff' THEN DO:
     5840       run cur-time in this-procedure ( output v-today, output v-time).
     5841       message
     5842       substitute("Вы уверены, что хотите удалить запись типа &1&2" +
     5843                  "для физ.лица &3 (дата удаления - сегодня, &4)?&2" +
     5844                  "Это может привести к ошибкам при разборе чеков&2"
     5845                  ,v-role-name
     5846                  ,chr(10)
     5847                  ,X_clients.obj-name
     5848                  , string(v-today, "99/99/9999")
     5849                  )
     5850       view-as alert-box QUESTION buttons yes-no update glog.
     5851       if not glog then do:
     5852          undo, return no-apply.
     5853       end.
     5854       ri = recid (X_staff).
     5855       run ref/staff01.p (
     5856                      input-output ri
     5857                     ,input 'удаление':U
     5858                     ,input no
     5859                     ,input X_staff.role
     5860                     ,input X_staff.staff-code
     5861                     ,input X_staff.psn-code
     5862                     ,input X_staff.role-level
     5863                     ,input X_staff.date-start
     5864                     ,input ?
     5865                     ,input X_staff.db-num
     5866                     ,input X_staff.host-code
     5867                     ,input X_staff.obj-type
     5868                     ,input X_staff.obj-code
     5869                     ,input X_staff.work-place
     5870                     ,input X_staff.password) no-error .
     5871       if error-status:error then do:
     5872         undo, return error.
     5873       end.
     5874     END.
     5875     WHEN 'чел':U THEN DO:
     5876       if X_clients.stts <> 0 then do:
     5877         message
     5878         SUBSTITUTE("Данное физ.лицо&1&2&1У Ж Е  имеет статус У Д А Л Е Н. &1Восстановить"
     5879                    , chr(10)
     5880                    ,X_clients.obj-name )
     5881         view-as alert-box question buttons yes-no update choice .
     5882         if choice then  do:
     5883           ri = recid( X_staff ).
     5884           ric = recid( X_clients ).
     5885           FIND FIRST buf_clients WHERE recid( buf_clients ) = ric .
     5886           buf_clients.stts = 0 .
     5887           br-staff:refresh() IN FRAME d-sel.
     5888         end.
     5889       end.
     5890       else do:
     5891         message "Установить статус УДАЛЕН  для данного клиента?"
     5892         view-as alert-box question buttons yes-no update choice .
     5893         if choice then  do:
     5894           ri = recid( X_clients ).
     5895           ric = recid( X_clients ).
     5896           FIND FIRST buf_clients WHERE recid( buf_clients ) = ric .
     5897           buf_clients.stts = 1.
     5898         end.
     5899       end.
     5900     END.
     5901   END CASE.
     5902   br-staff:refresh().
     5903   reposition br-staff to row 1 no-error .
     5904   apply "ENTRY" to br-staff .
     5905   END PROCEDURE.
     5906   PROCEDURE proc-b-sch :
     5907   assign
     5908     tbl = 'staff'
     5909     join-tbl = 'X_staff'
     5910     fld = ""
     5911     lab = ""
     5912     spr = ""
     5913     dim = '0'
     5914     .
     5915   IF p-psn-code = 0 THEN DO:
     5916     run fltfield-add in this-procedure('psn-code', 'Код Физ.лица', '',
     5917     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5918   END.
     5919   run fltfield-add in this-procedure('staff-code', 'Код персонала', '',
     5920   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5921   run fltfield-add in this-procedure('date-start', 'Работает с', '',
     5922   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5923   run fltfield-add in this-procedure('date-end', 'Работал по', '',
     5924   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5925   Filter-Block:
     5926   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5927       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5928       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5929     run gbl/filter.w ( INPUT parparentproc
     5930                      , INPUT filter-point0 + chr(4) + filter-label
     5931                      , INPUT tbl
     5932                      , INPUT join-tbl
     5933                      , INPUT fld
     5934                      , INPUT lab
     5935                      , INPUT spr
     5936                      , INPUT dim ).
     5937     run OpenBr IN THIS-PROCEDURE ( INPUT yes, INPUT no, INPUT '':U).
     5938   END.
     5939   END PROCEDURE.
     5940   PROCEDURE proc-find_staff-code :
     5941   define input parameter p-next as logical no-undo.
     5942   define input parameter p-staff-code like ub.staff.staff-code no-undo.
     5943   run OpenBr in THIS-PROCEDURE (
     5944                                 input false
     5945                                ,input p-next
     5946                                ,input substitute("and X_staff.staff-code = &1 ", p-staff-code)
     5947                               ).
     5948   apply "entry":u to f-staff-code in frame d-sel .
     5949   END PROCEDURE.
