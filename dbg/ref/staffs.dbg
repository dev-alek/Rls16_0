     5694   if NOT glog then  return no-apply .
     5695   run ref/rolei.p ( INPUT parparentproc
     5696               ,input 'ДОБАВЛЕНИЕ':U
     5697               ,input (IF add-option = "new":u
     5698                       THEN 0
     5699                       ELSE ?   )
     5700               ,input p-role
     5701               ,input ?
     5702               ,input-output ri
     5703               ,input-output table tt-staff
     5704               ) .
     5705   if ri <> ? then  do:
     5706       Run OpenBr in this-procedure ( INPUT yes, INPUT no, INPUT '':U ).
     5707       reposition br-staff to recid ri no-error .
     5708   end.
     5709   apply "entry" to br-staff IN FRAME d-sel .
     5710   END PROCEDURE.
