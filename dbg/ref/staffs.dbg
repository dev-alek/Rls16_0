     5678     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5679       (input  v-cntxt-db-num
     5680       ,input  v-cntxt-userid
     5681       ,input  0
     5682       ,input  'actn_client-reference-prs_add-del':U
     5683       ,input  'global':U
     5684       ,input  0
     5685       ,input  '':U
