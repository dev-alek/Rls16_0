      560     .
      561   define new global shared variable mBatchMode as logical no-undo init ?.
      562   define variable mFramBachModHandle as handle no-undo.
      563   mFramBachModHandle = frame waitfram:handle.
      564   define variable mFameOldVis as logical no-undo.
      565   define variable mVisCUrentVin as logical no-undo.
      566   if session:batch-mode
      567   then
      568      mBatchMode = yes.
      569   if mBatchMode = ? then do:
      570     mVisCUrentVin = current-window:visible.
      571     mFameOldVis = mFramBachModHandle:visible.
      572     mFramBachModHandle:visible  = yes.
      573     mBatchMode = mFramBachModHandle:visible ne yes.
      574     mFramBachModHandle:visible = mFameOldVis.
      575     current-window:visible = mVisCUrentVin.
      576   end.
      577    if  log-manager:logfile-name ne ?
      578     then DO:
      579         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      580         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      581         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      582     end.
      583   on choose of B-WaitFramStop in frame waitfram
      584   do:
      585     mWaitFramStop = yes.
      586     mWaitFramStopUser = yes.
      587   end.
      588   function waitfram-check-timeout returns logical():
      589      define variable vtime as int64 no-undo.
      590      if mWaitFramStopTimeOut
      591      then
      592         return yes.
      593      vtime = ( now - mWaitFramStartProc ) / 1000 .
      594      if     mWaitFramTimeOut ne ?
      595         and mWaitFramTimeOut ne 0
      596         and mWaitFramTimeOut lt vtime
      597      then do:
      598         mWaitFramStopTimeOut = yes.
      599      end.
      600      return mWaitFramStopTimeOut.
      601   end.
      602   procedure waitfram-hide :
      603     if not session:batch-mode
      604     then do
      605     on error undo, return error return-value
      606     :
      607       pause 0 before-hide .
      608       if not mBatchMode then
      609         hide frame waitfram .
      610     if     not mWaitFramView
      611        and mWaitProcEvent
      612     then
      613       process events .
      614     end.
      615   end procedure.
      616   procedure waitfram-show :
      617     define input  parameter p-message as character no-undo .
      618     define variable v-left-margin as integer   no-undo .
      619     if not session:batch-mode
      620     then do
      621     on error undo, return error return-value
      622     :
      623       if length(p-message) <= 70 then do:
      624         assign
      625           v-left-margin = integer((70 - length(p-message)) / 2)
      626         .
      627         assign
      628           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      629         .
      630         assign
      631           v-waitfram-action01 = " "
      632           v-waitfram-action02 = " "
      633                                    + fill(" ", v-left-margin)
      634                                    + p-message
      635           v-waitfram-action03 = " "
      636         .
      637       end.
      638       else do:
      639         define variable vRindex1 as integer no-undo.
      640         define variable vRindex2 as integer no-undo.
      641         vRindex1 = r-index(p-message," ",70).
      642         if vRindex1 = 0
      643         then
      644            vRindex1 = 70.
      645         if length(p-message)  <= vRindex1 + 70 then do:
      646           assign
      647             v-waitfram-action01 = " "
      648             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      649             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      650           .
      651         end.
      652         else do:
      653           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      654           if vRindex2 <= vRindex1
      655           then
      656              vRindex2 = vRindex1 + 70.
      657           assign
      658             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      659             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      660             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      661           .
      662         end.
      663       end.
      664       B-viewProcInfo:visible   in frame waitfram = no.
      665       B-viewProcInfo:sensitive in frame waitfram = no.
      666       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      667       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      668       if  (   mWaitFramView
      669          or  mWaitProcEvent)
      670          and not mBatchMode
      671       then
      672          display
      673             v-waitfram-action01 skip
      674             v-waitfram-action02 skip
      675             v-waitfram-action03 skip
      676          with frame waitfram .
      677       if     mWaitFramView
      678          then do:
      679             if     mWaitFramInterval ne ?
      680                and not mBatchMode
      681             then
      682                wait-for go of frame waitfram pause mWaitFramInterval.
      683          end.
      684          else
      685             if     mWaitProcEvent
      686                and not mBatchMode
      687             then
      688                process events .
      689     end.
      690   end procedure.
      691      procedure waitfram-show-this:
      692         define input  parameter iInterval as int64 no-undo.
      693         define variable vtime as int64 no-undo.
      694         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      695         mWaitFramInterval = iInterval.
      696         run waitfram-show (substitute("&1&2 &3&4" ,
      697                                       mWaitFramTextBeg ,
      698                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      699                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      700                                       mWaitFramTextEnd
      701                                      )
      702                           ).
      703      end.
      704      procedure WaitFramRunPause:
      705         define input  parameter iInterval as dec no-undo.
      706         define variable vStart  as datetime-tz no-undo.
      707         define variable vend    as datetime-tz no-undo.
      708         define variable vint as int64 no-undo.
      709         define variable vOk as logical no-undo.
      710         vStart = now.
      711         vend   = vStart.
      712         publish "WaitFramPause" (iInterval,output vOk).
      713         vend   =  now.
      714         vint = vend - vStart.
      715         vint = iInterval - vint / 1000.
      716         if     not mWaitFramStop
      717            and (   vint > 0
      718                 or (    not vOk
      719                     and iInterval eq ?
      720                     )
      721                 )
      722         then
      723            run waitfram-show-this (iInterval).
      724         vend   =  now.
      725         vint = vend - vStart.
      726         vint = iInterval - vint / 1000.
      727         if     not mWaitFramStop
      728            and vint > 0
      729         then do:
      730            run gbl/pause.p (vint * 1000).
      731         end.
      732         if iInterval ne ?
      733         then
      734            publish "WaitFramStop".
      735         waitfram-check-timeout().
      736      end.
      737      procedure WaitFramWaitFor:
      738         define input  parameter iInterval as dec no-undo.
      739         assign
      740            mWaitFramStartProc   = now
      741            mWaitFramStopUser    = no
      742            mWaitFramStopTimeOut = no
      743         .
      744         block-wait:
      745         do while not mWaitFramStop:
      746            run WaitFramRunPause (iInterval).
      747            if  waitfram-check-timeout()
      748            then do:
      749               leave block-wait.
      750            end.
      751         end.
      752         run waitfram-hide.
      753      end.
      754   procedure waitfram-join :
      755     define input  parameter p-line-1  as character no-undo .
      756     define input  parameter p-line-2  as character no-undo .
      757     define input  parameter p-line-3  as character no-undo .
      758     define output parameter p-message as character no-undo .
      759     do
      760     on error undo, return error return-value
      761     :
      762       assign
      763         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      764                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      765                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      766       .
      767     end.
      768   end procedure.
      769   function waitfram-join-function returns character
      770     (input p-line-1 as character
      771     ,input p-line-2 as character
      772     ,input p-line-3 as character
      773     ).
      774     define variable v-message as character no-undo .
      775     run waitfram-join in this-procedure
      776       (input  p-line-1
      777       ,input  p-line-2
      778       ,input  p-line-3
      779       ,output v-message
      780       ) .
      781     return v-message .
      782   end function .
      783   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      784   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      785                                                       ,input p-range-type as character
      786                                                       ,input p-code as integer):
      787   define variable v-seq-val as integer no-undo .
      788   define buffer buf_code-range for ub.code-range.
      789   find first buf_code-range no-lock where
      790             buf_code-range.db-num = p-db-num
      791       and  buf_code-range.range-type = p-range-type
      792       and  buf_code-range.stts = 'u'
      793       and buf_code-range.first-code <= p-code
      794       and buf_code-range.last-code >= p-code no-error .
      795   if available buf_code-range then return yes.
      796   CASE p-range-type:
      797     when 'pngb':U then do:
      798       v-seq-val = current-value(s-pngb-code, ub).
      799     end.
      800     when 'fmgb':U then do:
      801       v-seq-val = current-value(s-fmgb-code, ub).
      802     end.
      803   END CASE.
      804   if p-code <= v-seq-val then do:
      805     find first buf_code-range no-lock where
      806               buf_code-range.db-num = p-db-num
      807         and  buf_code-range.range-type = p-range-type
      808         and  buf_code-range.stts = 'a'
      809         and buf_code-range.first-code <= p-code
      810         no-error .
      811    if available buf_code-range then return yes.
      812   end.
      813   find first buf_code-range no-lock where
      814             buf_code-range.db-num = p-db-num
      815       and  buf_code-range.range-type = p-range-type
      816       and  buf_code-range.stts = 'f'
      817       and buf_code-range.first-code <= p-code
      818       and buf_code-range.last-code >= p-code
      819       no-error .
      820   if available buf_code-range then return yes.
      821   return no.
      822   END FUNCTION.
      823   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      824                                                       ,input p-range-type as character
      825                                                       ,input p-code as integer):
      826   define variable v-seq-val as integer no-undo .
      827   define buffer buf_code-range for ub.code-range.
      828   CASE p-range-type:
      829     when 'pngb':U then do:
      830       v-seq-val = current-value(s-pngb-code, ub).
      831     end.
      832     when 'fmgb':U then do:
      833       v-seq-val = current-value(s-fmgb-code, ub).
      834     end.
      835   END CASE.
      836   if p-code <= v-seq-val then do:
      837     find first buf_code-range no-lock where
      838               buf_code-range.db-num = p-db-num
      839         and  buf_code-range.range-type = p-range-type
      840         and buf_code-range.first-code <= p-code
      841         and buf_code-range.last-code >= p-code no-error .
      842     if available buf_code-range then return yes.
      843   end.
      844   return no.
      845   END FUNCTION.
      846   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      847                                                       ,input p-db-num as integer
      848                                                       ,input p-staff-code as integer
      849                                                       ,input p-date as date
      850                                                        ):
      851   define buffer buf_staff for ub.staff.
      852   if p-date = ? then do:
      853     p-date = today .
      854   end.
      855   find first buf_staff no-lock where
      856             buf_staff.role = p-role
      857         and buf_staff.role-level = 'db':U
      858         and buf_staff.db-num = p-db-num
      859         and buf_staff.staff-code = p-staff-code
      860         and buf_staff.date-end >= p-date use-index pi  no-error .
      861   if available buf_staff then do:
      862     return buf_staff.psn-code.
      863   end.
      864   return 0.
      865   end FUNCTION.
      866   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      867                                                             ,input p-db-num as integer
      868                                                             ,input p-date as date
      869                                                                 ):
      870   define buffer buf_staff for ub.staff.
      871   define buffer buf2_staff for ub.staff.
      872   if p-date = ? then do:
      873     p-date = today .
      874   end.
      875   for each  buf_staff no-lock where
      876             buf_staff.role = p-role
      877         and buf_staff.db-num = p-db-num,
      878   first buf2_staff no-lock where
      879         buf2_staff.role = p-role
      880     and buf2_staff.role-level = 'db':U
      881     and buf2_staff.staff-code = buf_staff.staff-code
      882     and buf2_staff.date-start <= p-date
      883     and buf2_staff.date-end >= p-date
      884   by buf_staff.staff-code
      885   by date-start descending:
      886     return buf_staff.staff-code.
      887   end.
      888   end FUNCTION.
      889   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      890                                                  ,input p-db-num as integer
      891                                                  ,input p-psn-code as integer
      892                                                  ,input p-date as date
      893                                                  ,output p-c-password as character
      894                                                        ):
      895   define buffer buf_staff for ub.staff.
      896   if p-date = ? then do:
      897     p-date = today .
      898   end.
      899   find first buf_staff no-lock where
      900             buf_staff.role = p-role
      901         and buf_staff.role-level = 'db':U
      902         and buf_staff.db-num = p-db-num
      903        and buf_staff.date-end >= p-date
      904        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      905   if available buf_staff
      906   then do:
      907     assign
      908     p-c-password = buf_staff.password.
      909     return buf_staff.staff-code.
      910   end.
      911   p-c-password = ''.
      912   return 0.
      913   end FUNCTION.
      914   FUNCTION gbclcode-is-psn-role returns integer (
      915                                                 input p-role as character
      916                                                 ,input p-psn-code as integer
      917                                                 ,input p-date as date
      918                                                     ):
      919   define buffer buf_staff for ub.staff.
      920   if p-date = ? then do:
      921     p-date = today .
      922   end.
      923   for each buf_staff no-lock where
      924             buf_staff.psn-code = p-psn-code
      925        and  buf_staff.role = p-role
      926   by buf_staff.role-level
      927   by buf_staff.date-start
      928        :
      929     if  buf_staff.date-start <= p-date and
      930     buf_staff.date-end >= p-date  then do:
      931       return buf_staff.staff-code.
      932     end.
      933   end.
      934   return 0.
      935   end FUNCTION.
      936   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      937   define variable v-role-name as character no-undo .
      938   assign
      939   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      940   no-error .
      941   return v-role-name.
      942   END.
      943   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      944   FUNCTION gbclcode-get-position returns character ( input p-role as character
      945                                                     ,input p-role-level as character
      946                                                     ,input p-work-place as character
      947                                                     ,input p-staff-code as integer
      948                                                                ):
      949   define variable v-role-name as character no-undo .
      950   define variable v-role-level as character no-undo .
      951   define variable v-staff-code as integer no-undo .
      952   assign
      953   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      954   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      955   v-staff-code = p-staff-code
      956   no-error .
      957   return substitute("&1, &2, Код &3"
      958                   ,v-role-name
      959                   ,v-role-level
      960                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      961   END.
      962   FUNCTION gbclcode-get-work-place returns character (
      963                                                   input p-role as character
      964                                                  ,input p-role-level as character
      965                                                  ,input p-db-num as integer
      966                                                  ,input p-host-code as integer
      967                                                  ,input p-obj-type as character
      968                                                  ,input p-obj-code as integer
      969                                                  ) :
      970   define variable v-work-place as character no-undo .
      971   define variable v-obj-type as character no-undo .
      972     case p-role-level:
      973       when 'db':U then do:
      974         v-work-place = string(p-db-num, "99999").
      975       end.
      976       when 'firm':U then do:
      977         v-work-place = string(p-host-code, "99999").
      978       end.
      979       when 'object':U then do:
      980         assign
      981         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      982         .
      983       end.
      984     END CASE.
      985     return v-work-place.
      986   END FUNCTION.
      987   FUNCTION gbclcode-get-level-last-code returns integer (
      988                                                           input p-role as character
      989                                                         , input p-role-level as character
      990                                                         , input p-work-place as character
      991                                                         , input p-date-start as date
      992                                                         ):
      993   DEFINE VARIABLE v-today as date no-undo .
      994   define buffer buf_staff for ub.staff.
      995   if p-work-place = chr(63) then return ?.
      996   if p-date-start = ? then do:
      997     v-today = today .
      998   end.
      999   else do:
     1000     v-today = p-date-start.
     1001   end.
     1002   find last buf_staff no-lock where
     1003             buf_staff.role = p-role
     1004        and  buf_staff.role-level = p-role-level
     1005        and  buf_staff.work-place = p-work-place
     1006        and  buf_staff.date-start <= v-today + 1
     1007        and  buf_staff.date-end >= v-today + 1
     1008        use-index pi  no-error .
     1009   if available buf_staff
     1010   then return buf_staff.staff-code.
     1011   return 0.
     1012   end FUNCTION.
     1013   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1014   FUNCTION mark-string RETURNS CHARACTER
     1015     ( input p-recid as recid, input mark-list as character  ) :
     1016     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1017   END FUNCTION.
     1018   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1019     define variable v-cntxt-db-num        as integer   no-undo .
     1020     define variable v-cntxt-userid        as character no-undo .
     1021     define variable v-cntxt-level         as character no-undo .
     1022     define variable v-cntxt-host-code-obj as integer   no-undo .
     1023     define variable v-cntxt-obj-type      as character no-undo .
     1024     define variable v-cntxt-obj-code      as integer   no-undo .
     1025     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1026     define variable v-cntxt-is-admin      as logical   no-undo .
     1027   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1028   define variable c-point  as character no-undo .
     1029   define variable tbl      as character no-undo .
     1030   define variable join-tbl as character no-undo .
     1031   define variable fld      as character no-undo .
     1032   define variable lab      as character no-undo .
     1033   define variable spr      as character no-undo .
     1034   define variable dim      as character no-undo .
     1035   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1036   procedure fltfield-clear :
     1037     define output parameter loc-fld as character no-undo.
     1038     define output parameter loc-lab as character no-undo .
     1039     define output parameter loc-spr as character no-undo .
     1040     define output parameter loc-dim as character no-undo .
     1041     assign
     1042       loc-fld = ""
     1043       loc-lab = ""
     1044       loc-spr = ""
     1045       loc-dim = "0"
     1046     .
     1047   end procedure .
     1048   procedure fltfield-add :
     1049     define input        parameter par-fld as character no-undo.
     1050     define input        parameter par-lab as character no-undo .
     1051     define input        parameter par-spr as character no-undo .
     1052     define input-output parameter loc-fld as character no-undo.
     1053     define input-output parameter loc-lab as character no-undo .
     1054     define input-output parameter loc-spr as character no-undo .
     1055     define input-output parameter loc-dim as character no-undo .
     1056     do
     1057     on error undo, return error
     1058     :
     1059       assign
     1060       loc-fld = if loc-dim = '0'
     1061                 then par-fld
     1062                 else (loc-fld + chr(44) + par-fld)
     1063       loc-lab = if loc-dim = '0'
     1064                 then par-lab
     1065                 else (loc-lab + chr(44) + par-lab)
     1066       loc-spr = if loc-dim = '0'
     1067                 then par-spr
     1068                 else (loc-spr + chr(44) + par-spr)
     1069       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     1070                 string(integer(if num-entries(loc-dim) > 1
     1071                               then entry(2, loc-dim)
     1072                               else entry(1, loc-dim)
     1073                               ) + 1)
     1074       no-error
     1075       .
     1076     end.
     1077   end procedure.
     1078   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1079   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1080   procedure fltopend_fltopend :
     1081   define input parameter p-parent-handle as handle no-undo .
     1082   define input parameter p-qh as handle no-undo .
     1083   define input parameter p-flt-open-open-query  as character no-undo .
     1084   define input parameter p-where-cond as character no-undo .
     1085   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1086   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1087   define input parameter p-indexed-reposition as character no-undo .
     1088     do
     1089     on error undo, return error
     1090     :
     1091   define variable v-prepare-string as character no-undo .
     1092   define variable glog as logical no-undo .
     1093   assign
     1094   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1095                      p-where-cond + chr(32)  +
     1096                      p-use-indFIRST-query-tail + chr(32) +
     1097                      p-use-ind-sort-clmn-by + chr(32) +
     1098                      p-indexed-reposition
     1099   .
     1100   assign
     1101   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1102   if not glog
     1103   or error-status:error then do:
     1104     message error-status:get-message(1) view-as alert-box .
     1105     undo, return error .
     1106   end.
     1107   assign
     1108   glog = p-qh:query-open no-error .
     1109   if not glog
     1110   or error-status:error then do:
     1111     message error-status:get-message(1) view-as alert-box .
     1112     undo, return error .
     1113   end.
     1114     end.
     1115   end procedure.
     1116   procedure fltopend_fltfindd :
     1117   define input parameter p-parent-handle as handle no-undo .
     1118   define input parameter p-qh as handle no-undo .
     1119   define input parameter p-rowid as rowid no-undo .
     1120   define input parameter p-next as logical no-undo .
     1121   define input parameter p-lock as integer no-undo .
     1122   define input parameter p-bh as handle no-undo .
     1123   define input parameter p-where-cond as character no-undo .
     1124   define input parameter p-use-index-phrase as character no-undo .
     1125   define variable glog as logical no-undo .
     1126   define variable v-qh as handle no-undo .
     1127   define variable v-bh as handle no-undo .
     1128   define variable v-recid as recid no-undo .
     1129   define variable v-prepare-string as character no-undo .
     1130   do
     1131   on error undo, return error
     1132   on stop undo, return error
     1133   :
     1134     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1135     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1136     create query v-qh.
     1137     v-qh:set-buffers(v-bh).
     1138     v-prepare-string = substitute("for each &1 &2 &3"
     1139                                     ,v-bh:name
     1140                                     ,p-where-cond
     1141                                     ,p-use-index-phrase).
     1142     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1143     if not glog then do:
     1144       delete object v-qh.
     1145       delete object v-bh.
     1146       undo, return error .
     1147     end.
     1148     glog = v-qh:query-open no-error .
     1149     if not glog then do:
     1150       delete object v-qh.
     1151       delete object v-bh.
     1152       undo, return error .
     1153     end.
     1154     if p-next then do:
     1155       v-qh:reposition-to-rowid(p-rowid) no-error .
     1156       glog = v-qh:get-next( p-lock) no-error .
     1157       glog = v-qh:get-next( p-lock) no-error .
     1158       if not glog or v-qh:query-off-end = yes then do:
     1159         glog = v-qh:get-first( p-lock) no-error .
     1160       end.
     1161     end.
     1162     else do:
     1163       glog = v-qh:get-first( p-lock) no-error .
     1164     end.
     1165     v-recid = v-bh:recid no-error .
     1166     delete object v-qh.
     1167     delete object v-bh.
     1168     return string(v-recid) .
     1169   end.
     1170   end procedure.
     1171   procedure fltopend_fltfindq :
     1172   define input parameter p-parent-handle as handle no-undo .
     1173   define input parameter p-qh as handle no-undo .
     1174   define input parameter p-next as logical no-undo .
     1175   define input parameter p-lock as integer no-undo .
     1176   define input parameter p-flt-open-open-query  as character no-undo .
     1177   define input parameter p-where-cond as character no-undo .
     1178   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1179   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1180   define input parameter p-indexed-reposition as character no-undo .
     1181   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1182   define variable glog as logical no-undo .
     1183   define variable v-qh as handle no-undo .
     1184   define variable v-bh as handle no-undo extent 18.
     1185   define variable v-rowid as rowid no-undo extent 18.
     1186   define variable v-ii as integer no-undo .
     1187   define variable v-prepare-string as character no-undo .
     1188   do
     1189   on error undo, return error
     1190   on stop undo, return error
     1191   :
     1192     create query v-qh.
     1193     do v-ii = 1 to p-qh:num-buffers:
     1194       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1195       assign
     1196       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1197       no-error.
     1198       v-qh:add-buffer(v-bh[v-ii]).
     1199     end.
     1200     assign
     1201     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1202                       p-where-cond + chr(32)  +
     1203                       p-use-indFIRST-query-tail + chr(32) +
     1204                       p-use-ind-sort-clmn-by + chr(32) +
     1205                       p-indexed-reposition
     1206     .
     1207     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1208     if not glog then do:
     1209       delete object v-qh.
     1210       do v-ii = 1 to p-qh:num-buffers:
     1211         delete object v-bh[v-ii].
     1212       end.
     1213       undo, return error .
     1214     end.
     1215     glog = v-qh:query-open no-error .
     1216     if not glog then do:
     1217       delete object v-qh.
     1218       do v-ii = 1 to p-qh:num-buffers:
     1219         delete object v-bh[v-ii].
     1220       end.
     1221       undo, return error .
     1222     end.
     1223     if p-next then do:
     1224       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1225       glog = v-qh:get-next( p-lock) no-error .
     1226       glog = v-qh:get-next( p-lock) no-error .
     1227       if not glog or v-qh:query-off-end = yes then do:
     1228         glog = v-qh:get-first( p-lock) no-error .
     1229       end.
     1230     end.
     1231     else do:
     1232       glog = v-qh:get-first( p-lock) no-error .
     1233     end.
     1234     do v-ii = 1 to p-qh:num-buffers:
     1235       assign
     1236       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1237       no-error.
     1238     end.
     1239     delete object v-qh.
     1240     do v-ii = 1 to p-qh:num-buffers:
     1241       delete object v-bh[v-ii].
     1242     end.
     1243   end.
     1244   end procedure.
     1245   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1246   DEFINE NEW SHARED TEMP-TABLE cash-cash no-undo
     1247   FIELD stts like ub.clients.stts
     1248   FIELD psn-code like ub.person.psn-code
     1249   FIELD cash-code as integer
     1250   FIELD slr-code  as integer
     1251   FIELD superviser as integer
     1252   FIELD cash-name like ub.clients.obj-name
     1253   FIELD psswd as character
     1254   FIELD s-psswd as character
     1255   FIELD ident-type as integer
     1256   index icli IS PRIMARY psn-code
     1257   index icash cash-code stts
     1258   index islr  slr-code stts
     1259   .
     1260   define variable log-res as log no-undo.
     1261   define variable choice as log no-undo.
     1262   define variable cli-name as char no-undo.
     1263   define variable ri-str  as char no-undo.
     1264   define variable per-stts      like  ub.clients.stts     no-undo .
     1265   define variable glog as logical no-undo .
     1266   define variable v-db-num like ub.db.db-num no-undo .
     1267   define variable v-date-end like ub.staff.date-end no-undo .
     1268   DEFINE VARIABLE v-role AS CHARACTER NO-UNDO.
     1269   define variable title0 as character no-undo .
     1270   DEFINE VARIABLE v-tab-order as character no-undo .
     1271   define variable v-doc-rec   as recid no-undo .
     1272   define variable v-role-name as character no-undo .
     1273   DEFINE VARIABLE add-option AS CHARACTER NO-UNDO.
     1274   DEFINE VARIABLE change-option AS CHARACTER NO-UNDO.
     1275   DEFINE VARIABLE delete-option AS CHARACTER NO-UNDO.
     1276   define variable sort-column-name as character no-undo .
     1277   define variable filter-label0 as character no-undo init "Список персонала" .
     1278   define variable filter-label as character no-undo init "Список персонала" .
     1279   define variable filter-point0 as character no-undo init "staffs" .
     1280   define variable filter-point as character no-undo init "staffs" .
     1281   define variable log-file-name as character no-undo init "send-cd.txt".
     1282   define variable v-view-log as logical no-undo .
     1283   FUNCTION get-staff-name RETURNS CHARACTER ( input p-obj-name as character
     1284                                             , input p-psn-code as integer
     1285                                             , input p-stts as integer):
     1286   define variable v-full-name as character no-undo .
     1287   define buffer buf_person for ub.person.
     1288   find first buf_person no-lock where
     1289             buf_person.psn-code = p-psn-code no-error.
     1290   v-full-name = substitute("&1 &2 &3"
     1291                      , p-obj-name
     1292                      , (if available buf_person then buf_person.name1 else '')
     1293                      , (if available buf_person then buf_person.name2 else '')
     1294                      ).
     1295   RETURN
     1296   (IF (p-stts = integer('0':U))
     1297   THEN v-full-name
     1298   ELSE (substring (v-full-name,1, 25) +
     1299                   FILL (chr(32), 25 - LENGTH (substring (v-full-name, 1, 25)) )) +
     1300                   '---  УДАЛЕН  ---':U).
     1301   END FUNCTION.
     1302   DEFINE MENU MENU-add
     1303          MENU-ITEM m-add-new      LABEL "Новое физ-лицо"
     1304          MENU-ITEM m-add-old      LABEL "Выбрать из справочника".
     1305   DEFINE MENU MENU-b-chg
     1306          MENU-ITEM m_psn          LABEL "Физ.лицо"
     1307          MENU-ITEM m_staff        LABEL "Данные персонала".
     1308   DEFINE MENU MENU-b-chg-2
     1309          MENU-ITEM m_psn-2        LABEL "Физ.лицо"
     1310          MENU-ITEM m_staff-2      LABEL "Данные персонала".
     1311   DEFINE MENU MENU-b-del
     1312          MENU-ITEM m_client       LABEL "Физ.лицо"
     1313          MENU-ITEM m_delstaff     LABEL "Данные персонала".
     1314   DEFINE BUTTON b-add
     1315        LABEL "&Добавить"
     1316        SIZE 10 BY 1.
     1317   DEFINE BUTTON b-arch
     1318        LABEL "&Архив"
     1319        SIZE 10 BY 1.
     1320   DEFINE BUTTON b-chg
     1321        LABEL "&Изменить"
     1322        SIZE 10 BY 1.
     1323   DEFINE BUTTON b-del
     1324        LABEL "&Удалить"
     1325        SIZE 10 BY 1.
     1326   DEFINE BUTTON b-help
     1327        LABEL "Помо&щь":L
     1328        SIZE 3 BY 1.
     1329   DEFINE BUTTON b-hist
     1330        LABEL "Ис&тория"
     1331        SIZE 3 BY 1.
     1332   DEFINE BUTTON b-lkp
     1333        LABEL "&Просмотр"
     1334        SIZE 10 BY 1.
     1335   DEFINE BUTTON b-mark
     1336        LABEL "&*"
     1337        SIZE 3 BY 1.
     1338   DEFINE BUTTON b-print
     1339        LABEL "Пе&чать":L
     1340        SIZE 3 BY 1.
     1341   DEFINE BUTTON b-qrCode
     1342        LABEL "&QR-код кассира"
     1343        SIZE 15 BY 1.
     1344   DEFINE BUTTON b-quit AUTO-GO
     1345        LABEL "&Выход ":L
     1346        SIZE 10 BY 1.
     1347   DEFINE BUTTON b-sch
     1348        LABEL "&Фильтр"
     1349        SIZE 3 BY 1.
     1350   DEFINE BUTTON b-sel AUTO-GO
     1351        LABEL "Вы&бор ":L
     1352        SIZE 10 BY 1.
     1353   DEFINE VARIABLE f-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1354        LABEL "№ БД"
     1355        VIEW-AS FILL-IN
     1356        SIZE 7 BY 1 NO-UNDO.
     1357   DEFINE VARIABLE f-staff-code AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 0
     1358        LABEL "Код"
     1359        VIEW-AS FILL-IN
     1360        SIZE 9.5 BY 1 NO-UNDO.
     1361   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>>9":U INITIAL 0
     1362         VIEW-AS TEXT
     1363        SIZE 4.75 BY .75
     1364        FGCOLOR 10  NO-UNDO.
     1365   DEFINE VARIABLE RS-status AS INTEGER
     1366        VIEW-AS RADIO-SET HORIZONTAL
     1367        RADIO-BUTTONS
     1368             "Все", 0,
     1369   "Текущие", 1
     1370        SIZE 28 BY 1 NO-UNDO.
     1371   DEFINE QUERY br-staff FOR
     1372         X_staff,
     1373         X_person,
     1374         X_clients SCROLLING.
     1375   DEFINE BROWSE br-staff
     1376     QUERY br-staff NO-LOCK DISPLAY
     1377         (mark-string ( INPUT RECID( X_staff), INPUT rid-list)) COLUMN-LABEL '*' FORMAT "x(1)":U
     1378   X_staff.staff-code COLUMN-LABEL 'Код!перс.' FORMAT ">>>>9":U
     1379   get-staff-name ( X_clients.obj-name, X_clients.obj-code, X_clients.stts ) COLUMN-LABEL 'Имя' FORMAT "x(40)":U
     1380   X_person.firm-name COLUMN-LABEL 'Организация' FORMAT "x(20)":U
     1381   X_person.psn-code COLUMN-LABEL 'Код!физ.лица' FORMAT ">>>>>>>>9":U
     1382   X_staff.db-num COLUMN-LABEL 'БД!№' FORMAT ">>>>9":U
     1383   X_staff.date-start COLUMN-LABEL 'c' FORMAT "99/99/9999":U
     1384   (IF X_staff.date-end = 12/31/9999 THEN '':u ELSE string(X_staff.date-end, '99/99/9999')) COLUMN-LABEL 'по' FORMAT "X(10)":U
     1385   ENABLE X_staff.staff-code
     1386       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 15.
     1387   DEFINE FRAME d-sel
     1388        b-quit AT ROW 1 COL 1
     1389        b-mark AT ROW 1 COL 11
     1390        b-sel AT ROW 1 COL 15
     1391        b-add AT ROW 1 COL 25
     1392        b-lkp AT ROW 1 COL 35
     1393        b-chg AT ROW 1 COL 45
     1394        b-del AT ROW 1 COL 55
     1395        b-qrCode AT ROW 1 COL 65 WIDGET-ID 2
     1396        b-print AT ROW 1 COL 86
     1397        b-hist AT ROW 1 COL 89
     1398        b-sch AT ROW 1 COL 92
     1399        b-help AT ROW 1 COL 95
     1400        RS-status AT ROW 2 COL 15.5 NO-LABEL
     1401        b-arch AT ROW 2 COL 45
     1402        f-db-num AT ROW 3 COL 24.5 COLON-ALIGNED
     1403        f-staff-code AT ROW 3 COL 42 COLON-ALIGNED
     1404        br-staff AT ROW 4 COL 1
     1405        mark-num AT ROW 2.96 COL 3.5 COLON-ALIGNED NO-LABEL
     1406        SPACE(88.75) SKIP(15.41)
     1407       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1408            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1409            TITLE "ПЕРСОНАЛ":L.
     1410   ASSIGN
     1411          FRAME d-sel:SCROLLABLE       = FALSE
     1412          FRAME d-sel:PRIVATE-DATA     =
     1413                   "DLGCLOSE".
     1414   ASSIGN
     1415          b-add:POPUP-MENU IN FRAME d-sel       = MENU MENU-add:HANDLE.
     1416   ASSIGN
     1417          b-arch:HIDDEN IN FRAME d-sel           = TRUE.
     1418   ASSIGN
     1419          b-chg:POPUP-MENU IN FRAME d-sel       = MENU MENU-b-chg:HANDLE.
     1420   ASSIGN
     1421          b-del:POPUP-MENU IN FRAME d-sel       = MENU MENU-b-del:HANDLE.
     1422   ASSIGN
     1423          b-qrCode:POPUP-MENU IN FRAME d-sel       = MENU MENU-b-chg-2:HANDLE.
     1424   ON ENDKEY OF FRAME d-sel
     1425   DO:
     1426   END.
     1427   ON CHOOSE OF B-quit IN FRAME d-sel
     1428   DO:
     1429     define variable recid_attr as character no-undo .
     1430     for each tt-staff-attr :
     1431       find first X_staff no-lock where X_staff.staff-code = tt-staff-attr.staff-code and
     1432       X_staff.role = tt-staff-attr.role no-error .
     1433       find first X_clients NO-LOCK WHERE X_clients.obj-type = 'чел':U
     1434           AND X_clients.obj-code = X_staff.psn-code no-error .
     1435             create cash-cash.
     1436             assign
     1437             cash-cash.cash-code = X_staff.staff-code
     1438             cash-cash.cash-name = X_clients.obj-name
     1439             cash-cash.stts = (if X_staff.date-end < today then 1 else 0)
     1440             cash-cash.psn-code = X_staff.psn-code
     1441             cash-cash.psswd = X_staff.password
     1442             .
     1443             find first ub.staff-attr no-lock where ub.staff-attr.attr-code = "CashierQRCode"
     1444             and ub.staff-attr.role = X_staff.role
     1445             and ub.staff-attr.role-level = X_staff.role-level
     1446             and ub.staff-attr.staff-code = X_staff.staff-code no-error .
     1447             if available (ub.staff-attr) then
     1448             recid_attr = recid_attr + chr(44) + string(recid(ub.staff-attr)) .
     1449      end.
     1450     if can-find(first cash-cash) then do:
     1451         run str/diallog.w (
     1452               input parparentproc
     1453             , input this-procedure
     1454             , input "str/send-all.p":U
     1455             , input ( v-cntxt-obj-type + chr(4) + string(v-cntxt-obj-code) + chr(4) + 'U':U + chr(4) + 'qrCode' + chr(4) + 'Отсылка QR-code на кассы':U + chr(4) + string(recid_attr))
     1456             , input ?
     1457             , input "":U
     1458             , input substitute("Отсылка QR-code на кассы &1", 'IBM-XML':U)
     1459           ) no-error.
     1460     end.
     1461   END.
     1462   ON CHOOSE OF b-add IN FRAME d-sel
     1463   DO:
     1464   DEFINE VARIABLE v-option AS CHARACTER NO-UNDO.
     1465   IF add-option = '':U THEN DO:
     1466       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     1467      if error-status :error then do: return no-apply. end.
     1468   END.
     1469   if add-option = '':U then return no-apply.
     1470   v-option = add-option.
     1471   add-option = '':U.
     1472   run proc-b-add in this-procedure ( input v-option) no-error.
     1473   if error-status:error then do:
     1474      return no-apply.
     1475   end.
     1476   END.
     1477   ON CHOOSE OF b-arch IN FRAME d-sel
     1478   DO:
     1479   DEFINE VARIABLE v-today as date no-undo .
     1480   DEFINE VARIABLE v-time as integer no-undo .
     1481   DEFINE VARIABLE v-cashier-db-num like ub.clients.db-num no-undo .
     1482   define variable v-cashier-code as integer no-undo .
     1483   define buffer shop_cli for ub.clients .
     1484     if available X_person then do:
     1485       run calc-arch in this-procedure .
     1486       if return-value <> "0" then do:
     1487           run cur-time in this-procedure ( output v-today, output v-time) .
     1488           assign
     1489           v-cashier-code = X_staff.staff-code
     1490           .
     1491           run ref/cshrsarc.w (
     1492                           input parparentproc
     1493                          ,input X_staff.staff-code
     1494                          ,input  X_person.psn-code ) .
     1495           if month(v-today) > 1 then do:
     1496             FOR EACH ub.cshr-month WHERE
     1497                   (ub.cshr-month.cashier-psn-code = X_person.psn-code
     1498                   or ub.cshr-month.cashier-psn-code = 0)
     1499                   AND
     1500                   ub.cshr-month.cshr-code = v-cashier-code AND
     1501                   ub.cshr-month.year_ = year( v-today ) AND
     1502                   (ub.cshr-month.month_ = month( v-today ) or ub.cshr-month.month_ = month(v-today) - 1):
     1503               if ub.cshr-month.obj-code <> 0 then do:
     1504                 find first shop_cli no-lock where
     1505                            shop_cli.obj-type = cshr-month.obj-type .
     1506                 assign
     1507                 v-cashier-db-num = shop_cli.db-num
     1508                 .
     1509               end.
     1510               else v-cashier-db-num = ?.
     1511               if v-cashier-db-num = ? or v-cashier-db-num = v-cntxt-db-num then
     1512               delete cshr-month .
     1513             END.
     1514          end.
     1515          else do:
     1516             FOR EACH cshr-month WHERE
     1517                   (cshr-month.cashier-psn-code = X_person.psn-code
     1518                   or cshr-month.cashier-psn-code = 0)
     1519                   AND
     1520                   cshr-month.cshr-code = v-cashier-code AND
     1521                   (cshr-month.year_ = year( v-today ) AND
     1522                   cshr-month.month_ = month( v-today )) or
     1523                   (cshr-month.year_ = year( v-today ) - 1 AND
     1524                   cshr-month.month_ = 12 ):
     1525               if cshr-month.obj-code <> 0 then do:
     1526                 find first shop_cli no-lock where
     1527                            shop_cli.obj-type = cshr-month.obj-type .
     1528                 assign
     1529                 v-cashier-db-num = shop_cli.db-num
     1530                 .
     1531               end.
     1532               else v-cashier-db-num = ?.
     1533               if v-cashier-db-num = ? or v-cashier-db-num = v-cntxt-db-num then
     1534               delete cshr-month .
     1535             END.
     1536          end.
     1537       end.
     1538     end.
     1539     apply "entry" to br-staff .
     1540   END.
     1541   ON CHOOSE OF b-chg IN FRAME d-sel
     1542   DO:
     1543   DEFINE VARIABLE v-option AS CHARACTER NO-UNDO.
     1544   IF change-option = '':U THEN DO:
     1545       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     1546      if error-status :error then do: return no-apply. end.
     1547   END.
     1548   if change-option = '':U then return no-apply.
     1549   v-option = change-option.
     1550   change-option = '':U.
     1551   run proc-b-chg in this-procedure (input v-option) no-error.
     1552   if error-status:error then do:
     1553     return no-apply.
     1554   end.
     1555   END.
     1556   ON CHOOSE OF b-del IN FRAME d-sel
     1557   DO:
     1558   DEFINE VARIABLE v-option AS CHARACTER NO-UNDO.
     1559   IF delete-option = '':U THEN DO:
     1560       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     1561      if error-status :error then do: return no-apply. end.
     1562   END.
     1563   if delete-option = '':U then return no-apply.
     1564   v-option = delete-option.
     1565   delete-option = '':U.
     1566   run proc-b-del in this-procedure ( input v-option) no-error.
     1567   if error-status:error then do:
     1568     v-option ='':U.
     1569     return no-apply.
     1570   end.
     1571   END.
     1572   ON CHOOSE OF b-hist IN FRAME d-sel
     1573   DO:
     1574   define variable v-rid-list as character no-undo .
     1575       if available X_staff THEN
     1576       run ref/cstaffs.w (
     1577                         input parparentproc
     1578                       , input v-cntxt-obj-type
     1579                       , input v-cntxt-obj-code
     1580                       , input "":U
     1581                       , "one":U
     1582                       , input X_staff.role
     1583                       , input X_staff.role-level
     1584                       , input X_staff.work-place
     1585                       , input X_staff.staff-code
     1586                       , input X_staff.date-start
     1587                       , input-output v-rid-list  ) no-error .
     1588       apply "entry" to br-staff .
     1589   END.
     1590   ON CHOOSE OF b-lkp IN FRAME d-sel
     1591   DO:
     1592   define variable ri as recid no-undo .
     1593     if available X_staff then do:
     1594       run ref/showcli.p (
     1595         input parParentProc
     1596         ,input X_clients.obj-type
     1597         ,input X_clients.obj-code
     1598         ).
     1599     end.
     1600     apply "entry" to br-staff .
     1601   END.
     1602   ON CHOOSE OF b-mark IN FRAME d-sel
     1603   DO:
     1604   define variable glog as logical no-undo .
     1605   if available X_staff then  do:
     1606   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1607   define variable v-str-recid15 as character no-undo .
     1608   define variable v-num-entry15 as integer   no-undo .
     1609   assign
     1610     v-str-recid15 = trim( string( recid( X_staff ) , "->>>>>>>>>>>9":U ) )
     1611     v-num-entry15 = lookup( v-str-recid15 , rid-list )
     1612   .
     1613   if v-num-entry15 > 0 then do:
     1614     assign
     1615       entry( v-num-entry15, rid-list ) = "":U
     1616       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1617     .
     1618   end.
     1619   else do:
     1620     assign
     1621       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1622     .
     1623   end.
     1624   glog = br-staff:refresh() .
     1625   if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1626     glog = br-staff:select-next-row ().
     1627     apply "iteration-changed" to br-staff in frame d-sel.
     1628   end.
     1629   if num-entries( rid-list ) = 0 then
     1630       hide mark-num in frame d-sel.
     1631   else
     1632       disp num-entries( rid-list ) @ mark-num with frame d-sel.
     1633   end.
     1634   apply "entry" to br-staff in frame d-sel.
     1635   END.
     1636   ON CHOOSE OF b-print IN FRAME d-sel
     1637   DO:
     1638   define variable Line                    as char         no-undo.
     1639   define variable cli-attr                 as char         no-undo.
     1640   define variable ii                  as integer   no-undo.
     1641   define variable ri as recid no-undo .
     1642   DEFINE VARIABLE v-work-place AS CHARACTER no-undo.
     1643   define variable v-role-level as character no-undo .
     1644   define variable v-obj-type as character no-undo .
     1645   DEFINE VARIABLE v-date-end-chr AS CHARACTER NO-UNDO.
     1646   DEFINE FRAME List
     1647   X_staff.staff-code column-label "Код" format ">>>>9"
     1648   X_person.name1 column-label "Имя " format "X(60)"
     1649   X_person.firm-name column-label "Организация" format "x(30)"
     1650   X_staff.psn-code column-label "Код физ.лица" format ">>>>>>>>9"
     1651   v-work-place COLUMN-LABEL "Работает" FORMAT "X(15)"
     1652   X_staff.date-start COLUMN-LABEL "c" FORMAT "99/99/9999"
     1653   v-date-end-chr COLUMN-LABEL "по" FORMAT "X(10)"
     1654   HEADER
     1655   cur-time-print() AT 5 format "X(35)"
     1656   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>9") )
     1657   AT 85 format "X(15)" SKIP
     1658   Line format "x(105)" AT 1
     1659   with width 160 down use-text stream-io no-box .
     1660   if num-results( "br-staff" ) = 0 then do:
     1661       message "Список  П У С Т !" skip view-as alert-box information .
     1662       return no-apply .
     1663   end.
     1664   if session:set-wait-state( "compiler" ) then .
     1665   Line = fill( "-" , 150 ) .
     1666   ri = recid(X_staff).
     1667   DO WHILE available X_staff :
     1668     GET prev br-staff NO-LOCK .
     1669   END.
     1670   GET next br-staff NO-LOCK .
     1671   ii = 1 .
     1672   run prn-lib-open-stream  in this-procedure (
     1673                                             input parParentProc
     1674                                             ,input 62
     1675                                             ,input yes
     1676                                             ,input no
     1677                                             ).
     1678   FORM HEADER
     1679   Line format "X(105)" SKIP
     1680   "Продолжение - на следующей странице" AT 30 SKIP
     1681   with FRAME CliBottomFrame width 160 PAGE-BOTTOM NO-LABELS no-box.
     1682   VIEW stream PrnLibStream FRAME CliBottomFrame .
     1683   PUT stream PrnLibStream unformatted space(20) frame d-sel:title skip.
     1684   FORM with frame List .
     1685   DO WHILE available X_staff :
     1686     assign
     1687     v-role-level =  X_staff.role-level
     1688     no-error .
     1689     if p-psn-code = 0 then do:
     1690       CASE X_staff.role-level:
     1691         when 'db':U then do:
     1692           v-work-place = substitute("БД &1", X_staff.db-num).
     1693         end.
     1694         when 'firm':U then do:
     1695           v-work-place = substitute("Фирма &1", X_staff.host-code).
     1696         end.
     1697         when 'object':U then do:
     1698           v-work-place =  X_staff.work-place.
     1699         end.
     1700         otherwise do:
     1701           v-work-place = ''.
     1702         end.
     1703       END CASE.
     1704     end.
     1705     else do:
     1706       v-work-place = gbclcode-get-position ( input X_staff.role
     1707                                             ,input X_staff.role-level
     1708                                             ,input X_staff.work-place
     1709                                             ,input X_staff.staff-code ).
     1710     end.
     1711     DISPLAY stream PrnLibStream
     1712     X_staff.staff-code
     1713     get-staff-name ( X_clients.obj-name, X_clients.obj-code, X_clients.stts ) @ X_person.name1
     1714     X_person.firm-name
     1715     X_staff.psn-code
     1716     v-work-place
     1717     X_staff.date-start
     1718     IF X_staff.date-end = 12/31/9999 THEN "":U ELSE string(X_staff.date-end, "99/99/9999") @ v-date-end-chr
     1719     with frame List .
     1720     DOWN stream PrnLibStream 1 with frame List .
     1721     ii =  ii + 1 .
     1722     if ( ( ii modulo 10 ) = 0 ) AND ( ii >= 10 ) then
     1723       run waitfram-show in this-procedure ( input "Просмотрено строк : " + string( ii ) ) .
     1724     GET next br-staff NO-LOCK .
     1725   END.
     1726   PUT stream PrnLibStream Line format "X(105)" SKIP.
     1727   HIDE stream PrnLibStream FRAME CliBottomFrame .
     1728   output stream PrnLibStream close .
     1729   run waitfram-hide in this-procedure .
     1730   run prn-lib-prn-file in this-procedure (
     1731                                           input parParentProc
     1732                                           ,input 0
     1733                                           ).
     1734   reposition br-staff to recid ri no-error.
     1735   END.
     1736   ON CHOOSE OF b-qrCode IN FRAME d-sel
     1737   DO:
     1738     define variable v-update as logical no-undo .
     1739     define variable attr-value as character no-undo .
     1740     if available (X_staff) then do:
     1741       buffer-copy X_staff to tt-staff .
     1742       find first ub.staff-attr no-lock where ub.staff-attr.attr-code = "CashierQRCode" and
     1743       ub.staff-attr.date-start <= today and
     1744       ub.staff-attr.role = X_staff.role and
     1745       ub.staff-attr.staff-code = X_staff.staff-code no-error .
     1746       attr-value = if available (ub.staff-attr) then ub.staff-attr.attr-value else "" .
     1747       run ref\view-qrCode.w(parparentproc, input-output attr-value, input table tt-staff, output v-update).
     1748     if v-update then do:
     1749       find first tt-staff-attr no-lock where tt-staff-attr.attr-code = "CashierQRCode" and
     1750       tt-staff-attr.date-start = today and
     1751       tt-staff-attr.role = X_staff.role and
     1752       tt-staff-attr.staff-code = X_staff.staff-code no-error .
     1753       if not available (tt-staff-attr) then do:
     1754         create tt-staff-attr .
     1755         assign
     1756         tt-staff-attr.attr-code = "CashierQRCode"
     1757         tt-staff-attr.date-start = today
     1758         tt-staff-attr.role = X_staff.role
     1759         tt-staff-attr.role-level = X_staff.role-level
     1760         tt-staff-attr.staff-code = X_staff.staff-code
     1761         .
     1762       end.
     1763       tt-staff-attr.attr-value = attr-value .
     1764     end.
     1765     end.
     1766     else do:
     1767       message "Не выбран кассир."
     1768       view-as alert-box.
     1769     end.
     1770   END.
     1771   ON CHOOSE OF b-sch IN FRAME d-sel
     1772   DO:
     1773       run proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1774     IF ERROR-STATUS:error THEN RETURN NO-APPLY.
     1775   END.
     1776   ON CHOOSE OF b-sel IN FRAME d-sel
     1777   DO:
     1778       if ( available X_staff ) AND ( rid-list = "" ) then
     1779           rid-list = string( recid( X_staff ) ) .
     1780   END.
     1781   ON MOUSE-SELECT-DBLCLICK OF br-staff IN FRAME d-sel
     1782   OR INSERT-MODE  OF br-staff IN FRAME d-sel DO:
     1783       if can-do(bttns, "b-mark") then
     1784       apply "choose" to b-mark in frame d-sel .
     1785       else if can-do( bttns, "b-sel" ) then
     1786           apply "choose" to b-sel in frame d-sel .
     1787       else
     1788           apply "choose" to b-lkp in frame d-sel .
     1789   END.
     1790   ON RETURN OF br-staff IN FRAME d-sel
     1791   DO:
     1792       if can-do( bttns, "b-sel" ) then
     1793           apply "choose" to b-sel in frame d-sel .
     1794       else
     1795           apply "choose" to b-lkp in frame d-sel .
     1796   END.
     1797   ON RETURN OF f-db-num IN FRAME d-sel
     1798   DO:
     1799     DEFINE VARIABLE v-int AS INTEGER NO-UNDO.
     1800     DEFINE BUFFER buf_db FOR ub.db.
     1801     ASSIGN
     1802     f-db-num
     1803     v-int = f-db-num
     1804     .
     1805     IF v-int <> ? THEN DO:
     1806         FIND FIRST buf_db NO-LOCK WHERE
     1807                   buf_db.db-num = v-int NO-ERROR.
     1808         IF NOT AVAILABLE buf_db THEN DO:
     1809             MESSAGE
     1810             substitute("Нет БД № &1", f-db-num)
     1811             VIEW-AS ALERT-BOX ERROR.
     1812             RETURN NO-APPLY.
     1813         END.
     1814     END.
     1815     assign
     1816     v-db-num = f-db-num.
     1817     run OpenBr IN THIS-PROCEDURE ( INPUT yes, INPUT no, INPUT '':U).
     1818   END.
     1819   ON RETURN OF f-staff-code IN FRAME d-sel
     1820   DO:
     1821     run proc-find_staff-code in THIS-PROCEDURE ( INPUT no, input frame d-sel f-staff-code) no-error.
     1822     if error-status:error then return no-apply.
     1823   END.
     1824   ON CHOOSE OF MENU-ITEM m-add-new
     1825   DO:
     1826   DEFINE VARIABLE v-option AS CHARACTER NO-UNDO.
     1827     ASSIGN
     1828     add-option = "new":U.
     1829     run proc-b-add IN THIS-PROCEDURE ( INPUT add-option) NO-ERROR.
     1830     IF ERROR-STATUS:ERROR THEN DO:
     1831         ASSIGN
     1832         add-option = '':U.
     1833         RETURN NO-APPLY.
     1834     END.
     1835   END.
     1836   ON CHOOSE OF MENU-ITEM m-add-old
     1837   DO:
     1838   DEFINE VARIABLE v-option AS CHARACTER NO-UNDO.
     1839   ASSIGN
     1840    add-option = "old":U.
     1841    run proc-b-add IN THIS-PROCEDURE ( INPUT add-option) NO-ERROR.
     1842    IF ERROR-STATUS:ERROR THEN DO:
     1843        ASSIGN
     1844        add-option = '':U.
     1845        RETURN NO-APPLY.
     1846    END.
     1847   END.
     1848   ON CHOOSE OF MENU-ITEM m_client
     1849   DO:
     1850     ASSIGN
     1851     delete-option = 'чел':U.
     1852     APPLY "CHOOSE" TO b-del IN FRAME d-sel.
     1853   END.
     1854   ON CHOOSE OF MENU-ITEM m_delstaff
     1855   DO:
     1856    ASSIGN
     1857    delete-option = 'staff'.
     1858    APPLY "CHOOSE" TO b-del IN FRAME d-sel.
     1859   END.
     1860   ON CHOOSE OF MENU-ITEM m_psn
     1861   DO:
     1862     ASSIGN
     1863     change-option = 'чел':U.
     1864     APPLY "CHOOSE" TO b-chg IN FRAME d-sel.
     1865   END.
     1866   ON CHOOSE OF MENU-ITEM m_psn-2
     1867   DO:
     1868     ASSIGN
     1869     change-option = 'чел':U.
     1870     APPLY "CHOOSE" TO b-chg IN FRAME d-sel.
     1871   END.
     1872   ON CHOOSE OF MENU-ITEM m_staff
     1873   DO:
     1874     ASSIGN
     1875     change-option = 'staff'.
     1876     APPLY "CHOOSE" TO b-chg  IN FRAME d-sel.
     1877   END.
     1878   ON CHOOSE OF MENU-ITEM m_staff-2
     1879   DO:
     1880     ASSIGN
     1881     change-option = 'staff'.
     1882     APPLY "CHOOSE" TO b-chg  IN FRAME d-sel.
     1883   END.
     1884   ON VALUE-CHANGED OF RS-status IN FRAME d-sel
     1885   DO:
     1886     ASSIGN
     1887     rs-status
     1888     .
     1889     assign
     1890     v-date-end = (IF rs-status = 0 THEN ? ELSE 12/31/9999) .
     1891     run OpenBr IN THIS-PROCEDURE ( INPUT yes, INPUT no, INPUT '':U).
     1892   END.
     1893   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-sel:PARENT eq ?
     1894   THEN FRAME d-sel:PARENT = ACTIVE-WINDOW.
     1895   def var sort-labelbr-staff   as character no-undo .
     1896   def var sort-clmnbr-staff    as handle    no-undo .
     1897   def var cur-clmnbr-staff     as handle    no-undo .
     1898   def var cur-clmn-locbr-staff as integer   no-undo .
     1899   def var re-querybr-staff     as logical   initial no no-undo .
     1900   on start-search, ctrl-o of br-staff in frame d-sel do:
     1901      run sort-brbr-staff
     1902        (input (if available X_staff
     1903                then recid(X_staff)
     1904                else ?
     1905               )
     1906        ).
     1907   end.
     1908   PROCEDURE sort-brbr-staff :
     1909     define input parameter p-recid as recid no-undo .
     1910     if re-querybr-staff = no then do:
     1911       assign
     1912          cur-clmnbr-staff = br-staff:current-column in frame d-sel
     1913       .
     1914       if sort-clmnbr-staff <> ? then sort-clmnbr-staff:column-fgcolor = 0.
     1915       if cur-clmnbr-staff = sort-clmnbr-staff then do:
     1916         assign
     1917            sort-labelbr-staff = ""
     1918            sort-clmnbr-staff = ?
     1919         .
     1920        end.
     1921        else do:
     1922          assign
     1923            sort-labelbr-staff = cur-clmnbr-staff:label
     1924            sort-clmnbr-staff  = cur-clmnbr-staff
     1925            sort-clmnbr-staff:column-fgcolor = 4
     1926          .
     1927        end.
     1928      end.
     1929     assign
     1930       cur-clmn-locbr-staff = 1
     1931     .
     1932     def var column-handle as handle no-undo .
     1933     column-handle = br-staff:first-column.
     1934     do while valid-handle(column-handle) :
     1935       if column-handle = cur-clmnbr-staff then do:
     1936         leave .
     1937       end.
     1938       column-handle = column-handle:NEXT-COLUMN.
     1939       assign
     1940         cur-clmn-locbr-staff = cur-clmn-locbr-staff + 1
     1941       .
     1942     end.
     1943     case sort-labelbr-staff:
     1944           when '*'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1mark-string&1, RECID( X_staff), &1&2&1)', chr(34),rid-list)     .     run OpenBr in this-procedure ( INPUT yes, INPUT no, INPUT '':U).   . END.
     1945           when 'Код!перс.'  then DO:    assign       sort-column-name = "X_staff.staff-code"     .     run OpenBr in this-procedure ( INPUT yes, INPUT no, INPUT '':U).   . END.
     1946           when 'Имя'  then DO:   assign       sort-column-name = substitute('dynamic-function(&1get-staff-name&1, X_clients.obj-name, X_clients.obj-code, X_clients.stts)', chr(34))     .     run OpenBr in this-procedure ( INPUT yes, INPUT no, INPUT '':U).   . END.
     1947           when 'Организация'  then DO:    assign       sort-column-name = "X_person.firm-name"     .     run OpenBr in this-procedure ( INPUT yes, INPUT no, INPUT '':U).   . END.
     1948           when 'Код!физ.лица'  then DO:    assign       sort-column-name = "X_person.psn-code"     .     run OpenBr in this-procedure ( INPUT yes, INPUT no, INPUT '':U).   . END.
     1949           when 'БД!№'  then DO:    assign       sort-column-name = "X_staff.db-num"     .     run OpenBr in this-procedure ( INPUT yes, INPUT no, INPUT '':U).   . END.
     1950           when 'c'  then DO:    assign       sort-column-name = "X_staff.date-start"     .     run OpenBr in this-procedure ( INPUT yes, INPUT no, INPUT '':U).   . END.
     1951           when 'по'  then DO:   assign       sort-column-name = substitute('string(X_staff.date-end)')     .     run OpenBr in this-procedure ( INPUT yes, INPUT no, INPUT '':U).   . END.
     1952       otherwise do:
     1953         assign
     1954           sort-column-name = ""
     1955         .
     1956         run OpenBr in this-procedure ( INPUT yes, INPUT no, INPUT '':U).
     1957         if sort-labelbr-staff <> "" then do:
     1958           assign
     1959             cur-clmnbr-staff:column-fgcolor = 0
     1960           .
     1961         end.
     1962         assign
     1963           cur-clmn-locbr-staff = ?
     1964         .
     1965       end.
     1966     end case.
     1967     if p-recid <> ? then do:
     1968       reposition br-staff to recid p-recid no-error.
     1969       apply "value-changed" to br-staff in frame d-sel.
     1970     end.
     1971     apply "entry" to br-staff in frame d-sel.
     1972   END PROCEDURE.
     1973   procedure re-open-query-srt-clmnbr-staff:
     1974   if cur-clmnbr-staff = ? then do:
     1975      run OpenBr in this-procedure ( INPUT yes, INPUT no, INPUT '':U).
     1976   end.
     1977   else do:
     1978      assign re-querybr-staff = yes.
     1979      run sort-brbr-staff
     1980        (input (if available X_staff
     1981                then recid(X_staff)
     1982                else ?
     1983               )
     1984        ).
     1985      assign re-querybr-staff = no.
     1986   end.
     1987   end.
     1988   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1989   procedure set-filter-name :
     1990   define input parameter p-filter-name as character no-undo .
     1991     do with frame d-sel:
     1992       if p-filter-name > "" then do:
     1993         assign
     1994           frame d-sel:title
     1995             = frame d-sel:title + "   ФИЛЬТР: " + p-filter-name.
     1996         .
     1997         assign
     1998           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     1999         .
     2000       end.
     2001       else do:
     2002         assign
     2003           b-sch :tooltip = ""
     2004         .
     2005       end.
     2006     end.
     2007   end procedure.
     2008   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2009   on help of frame d-sel
     2010   do:
     2011     run gbl/app_help.p
     2012       (input this-procedure :file-name
     2013       ,input ''
     2014       ,input ?
     2015       ) no-error.
     2016     if error-status :error then do:
     2017       message
     2018         "Ошибка при вызове помощи"
     2019         error-status :get-message(1)
     2020         view-as alert-box .
     2021     end.
     2022   end.
     2023   run minbtn-set in this-procedure .
     2024   on choose of b-help in frame d-sel
     2025   do:
     2026     apply "help":u to frame d-sel .
     2027   end.
     2028   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2029   procedure minbtn-set :
     2030       do
     2031           on error undo, return error return-value
     2032           :
     2033           define variable ii              as integer       no-undo .
     2034           define variable fh              as widget-handle no-undo .
     2035           define variable hh              as widget-handle no-undo .
     2036           define variable v-h             as handle        extent 4 no-undo .
     2037           define variable v-name-button   as character     no-undo .
     2038           define variable v-help-old-x    as decimal       no-undo .
     2039           define variable v-help-old-y    as decimal       no-undo .
     2040           define variable v-help-old-size as decimal       no-undo .
     2041           define variable v-frame-width   as decimal       no-undo .
     2042           define variable jj              as integer       no-undo .
     2043           do
     2044               on error undo, return error
     2045               :
     2046               assign
     2047                   v-frame-width = frame d-sel:width - 0.3
     2048                   fh            = frame d-sel:first-child
     2049                   hh            = fh:first-child
     2050                   ii            = 1
     2051                   .
     2052               do while valid-handle(hh):
     2053                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2054                   do:
     2055                       case lc(hh:name) :
     2056                           when "b-help" then
     2057                               do:
     2058                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2059                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2060                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2061                                   hh:TOOLTIP = "Помощь" .
     2062                                   v-help-old-x = hh:column .
     2063                                   v-help-old-y = hh:row    .
     2064                                   v-help-old-size = hh:width .
     2065                                   hh:width-chars = 2.5 .
     2066                               end.
     2067                           when "b-print" then
     2068                               do:
     2069                                   hh:load-image("cmp/b-print.bmp":u) .
     2070                                   hh:TOOLTIP = "Печать" .
     2071                                   v-h[ii] = hh:handle .
     2072                                   ii = ii + 1 .
     2073                                   hh:width-chars = 3 .
     2074                               end.
     2075                           when "b-history" or
     2076                           when "b-hist" then
     2077                               do:
     2078                                   hh:load-image("cmp/b-hist.bmp":u) .
     2079                                   hh:TOOLTIP = "История" .
     2080                                   v-h[ii] = hh:handle .
     2081                                   ii = ii + 1 .
     2082                                   hh:width-chars = 3 .
     2083                               end.
     2084                           when "b-sch" then
     2085                               do:
     2086                                   hh:load-image("cmp/b-sch.bmp":u) .
     2087                                   hh:TOOLTIP = "Установка Фильтра" .
     2088                                   v-h[ii] = hh:handle .
     2089                                   ii = ii + 1 .
     2090                                   hh:width-chars = 3 .
     2091                               end.
     2092                           when "b-hist-user" then
     2093                               do:
     2094                                   hh:load-image("cmp/b-hist.bmp":u) .
     2095                                   hh:TOOLTIP = "История пользователя" .
     2096                                   ii = ii + 1 .
     2097                               end.
     2098                       end case.
     2099                   end.
     2100                   hh = hh:next-sibling.
     2101               end.
     2102               b-help:column = v-frame-width - b-help:width-chars.
     2103               jj = 0.
     2104               repeat ii = 4 to 1 by -1 :
     2105                   if valid-handle (v-h[ii] ) then
     2106                   do:
     2107                       jj  = jj + 1 .
     2108                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2109                       v-h[ii]:row    = v-help-old-y .
     2110                   end.
     2111               end.
     2112           end.
     2113       end.
     2114   end procedure.
     2115   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2116   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2117   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2118   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2119   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2120   define variable v-diasize-current-frame-height as decimal   no-undo .
     2121   define variable v-diasize-change-size          as logical   no-undo .
     2122   define variable v-diasize-resize-button        as handle    no-undo .
     2123   define variable v-diasize-wndmax               as logical   no-undo .
     2124   define variable v-diasize-wndstore             as logical   no-undo .
     2125   define variable v-diasize-proc-name            as character no-undo .
     2126   define variable v-diasize-browse-handle        as handle    no-undo .
     2127   define variable v-diasize-browse-number        as integer   no-undo .
     2128   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2129   define temp-table temp-diasize-handle no-undo
     2130     field handle-value  as handle
     2131     field save-position as decimal
     2132     index xpk is primary unique handle-value
     2133     .
     2134   define temp-table temp-browse-handle no-undo
     2135     field browse-type   as character
     2136     field browse-number as integer
     2137     field browse-handle as handle
     2138     field original-size as decimal
     2139     index xpk is primary unique browse-type browse-number
     2140     index xie browse-type browse-handle
     2141   .
     2142   procedure diasize_change-height :
     2143     define input  parameter p-change-value  as decimal   no-undo .
     2144     define input  parameter p-move-resize   as logical   no-undo .
     2145     define variable v-field-group-handle    as handle    no-undo .
     2146     define variable v-object-handle         as handle    no-undo .
     2147     define variable v-frame-height          as decimal   no-undo .
     2148     define variable v-frame-virtual-height  as decimal   no-undo .
     2149     define variable v-browse-height         as decimal   no-undo .
     2150     define variable v-window-height         as decimal   no-undo .
     2151     define variable v-window-virtual-height as decimal   no-undo .
     2152     define variable v-change-sign           as integer   no-undo .
     2153     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2154     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2155     if p-change-value > 0
     2156     then do:
     2157       if frame d-sel :height + p-change-value
     2158           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2159       then do:
     2160         assign
     2161           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2162                           - (frame d-sel :height-chars)
     2163         .
     2164         if p-change-value <= 0
     2165         then do:
     2166           run diasize_position-resize-button in this-procedure .
     2167           return .
     2168         end.
     2169       end.
     2170     end.
     2171     if p-change-value < 0
     2172     then do:
     2173       if frame d-sel :height + p-change-value < v-diasize-orig-frame-height
     2174       then do:
     2175         assign
     2176           p-change-value = v-diasize-orig-frame-height
     2177                          - (frame d-sel :height-chars)
     2178         .
     2179         if p-change-value >= 0
     2180         then do:
     2181           run diasize_position-resize-button in this-procedure .
     2182           return .
     2183         end.
     2184       end.
     2185     end.
     2186     if p-change-value >= 0
     2187     then do:
     2188       assign
     2189         v-change-sign = 1
     2190       .
     2191     end.
     2192     else do:
     2193       assign
     2194         v-change-sign = -1
     2195       .
     2196     end.
     2197     assign
     2198       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2199     .
     2200     if p-change-value = 0
     2201     then do:
     2202       run diasize_position-resize-button in this-procedure .
     2203       return .
     2204     end.
     2205     move_block:
     2206     do
     2207     on error undo move_block, retry move_block
     2208     :
     2209       if retry
     2210       then do:
     2211         do
     2212         on error undo move_block, leave move_block
     2213         :
     2214           if p-change-value > 0
     2215           then do:
     2216             for each buf_temp-diasize-handle
     2217             on error undo, next
     2218             :
     2219               assign
     2220                 v-object-handle = buf_temp-diasize-handle.handle-value
     2221               .
     2222               if v-object-handle <> v-diasize-resize-button
     2223               then do:
     2224                 assign
     2225                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2226                 .
     2227               end.
     2228             end.
     2229             assign
     2230               v-diasize-browse-handle :height = v-browse-height
     2231             .
     2232             for each buf_temp-browse-handle
     2233               where buf_temp-browse-handle.browse-type = 'height':u
     2234             on error undo, next
     2235             :
     2236               assign
     2237                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2238               .
     2239             end.
     2240             assign
     2241               frame d-sel :height = v-frame-height
     2242             .
     2243             if frame d-sel :scrollable = true
     2244             then do:
     2245               assign
     2246                 frame d-sel :virtual-height = v-frame-virtual-height
     2247               .
     2248             end.
     2249             run diasize_position-resize-button in this-procedure .
     2250           end.
     2251           else do:
     2252             if frame d-sel :scrollable = true
     2253             then do:
     2254               assign
     2255                 frame d-sel :virtual-height = v-frame-virtual-height
     2256               .
     2257             end.
     2258             assign
     2259               frame d-sel :height = v-frame-height
     2260             .
     2261             assign
     2262               v-diasize-browse-handle :height = v-browse-height
     2263             .
     2264             for each buf_temp-browse-handle
     2265               where buf_temp-browse-handle.browse-type = 'height':u
     2266             on error undo, next
     2267             :
     2268               assign
     2269                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2270               .
     2271             end.
     2272             for each buf_temp-diasize-handle
     2273             on error undo, next
     2274             :
     2275               assign
     2276                 v-object-handle = buf_temp-diasize-handle.handle-value
     2277               .
     2278               if v-object-handle <> v-diasize-resize-button
     2279               then do:
     2280                 assign
     2281                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2282                 .
     2283               end.
     2284             end.
     2285             run diasize_position-resize-button in this-procedure .
     2286           end.
     2287           assign
     2288             v-diasize-change-size = false
     2289           .
     2290           leave move_block .
     2291         end.
     2292       end.
     2293       assign
     2294         v-diasize-need-full-display = true
     2295       .
     2296       if v-diasize-change-size = false
     2297       then do:
     2298         assign
     2299           v-diasize-change-size = true
     2300         .
     2301       end.
     2302       else do:
     2303         return .
     2304       end.
     2305       assign
     2306         v-frame-height = frame d-sel :height
     2307         v-frame-virtual-height = frame d-sel :virtual-height
     2308         v-browse-height = v-diasize-browse-handle :height
     2309       .
     2310       for each buf_temp-browse-handle
     2311         where buf_temp-browse-handle.browse-type = 'height':u
     2312       :
     2313         assign
     2314           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2315         .
     2316       end.
     2317       for each buf_temp-diasize-handle
     2318       :
     2319         delete buf_temp-diasize-handle .
     2320       end.
     2321       assign
     2322         v-field-group-handle = frame d-sel :first-child
     2323       .
     2324       do while valid-handle(v-field-group-handle)
     2325       :
     2326         assign
     2327           v-object-handle = v-field-group-handle :first-child
     2328         .
     2329         do while valid-handle(v-object-handle)
     2330         :
     2331           if  v-object-handle <> v-diasize-browse-handle :handle
     2332           and can-query(v-object-handle, "row")
     2333           and can-query(v-object-handle, "height")
     2334           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2335           then do:
     2336             find first buf_temp-browse-handle
     2337               where buf_temp-browse-handle.browse-type   = 'height':u
     2338                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2339               no-error .
     2340             if available buf_temp-browse-handle
     2341             then do:
     2342             end.
     2343             else do:
     2344               create buf_temp-diasize-handle .
     2345               assign
     2346                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2347                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2348               .
     2349             end.
     2350           end.
     2351           assign
     2352             v-object-handle = v-object-handle :next-sibling
     2353           .
     2354         end.
     2355         assign
     2356           v-field-group-handle = v-field-group-handle :next-sibling
     2357         .
     2358       end.
     2359       do with frame d-sel
     2360       :
     2361         hide v-diasize-resize-button .
     2362         assign
     2363           v-diasize-resize-button :row    = 1
     2364           v-diasize-resize-button :column = 1
     2365         .
     2366       end.
     2367       if p-change-value > 0
     2368       then do:
     2369         if frame d-sel :scrollable = true
     2370         then do:
     2371           assign
     2372             frame d-sel :virtual-height = frame d-sel :virtual-height + p-change-value
     2373             no-error .
     2374           if error-status :error
     2375           or error-status :get-message(1) <> ""
     2376           then do:
     2377             undo move_block, retry move_block .
     2378           end.
     2379         end.
     2380         assign
     2381           frame d-sel :height = frame d-sel :height + p-change-value
     2382           no-error .
     2383         if error-status :error
     2384         or error-status :get-message(1) <> ""
     2385         then do:
     2386           undo move_block, retry move_block .
     2387         end.
     2388         assign
     2389           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2390           no-error .
     2391         if error-status :error
     2392         or error-status :get-message(1) <> ""
     2393         then do:
     2394           undo move_block, retry move_block .
     2395         end.
     2396         for each buf_temp-browse-handle
     2397           where buf_temp-browse-handle.browse-type = 'height':u
     2398         on error undo move_block, retry move_block
     2399         :
     2400           assign
     2401             buf_temp-browse-handle.browse-handle :height
     2402               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2403             no-error .
     2404           if error-status :error
     2405           or error-status :get-message(1) <> ""
     2406           then do:
     2407             undo move_block, retry move_block .
     2408           end.
     2409         end.
     2410         for each buf_temp-diasize-handle
     2411         on error undo move_block, retry move_block
     2412         :
     2413           assign
     2414             v-object-handle = buf_temp-diasize-handle.handle-value
     2415           .
     2416           if v-object-handle <> v-diasize-resize-button
     2417           then do:
     2418             assign
     2419               v-object-handle :row = v-object-handle :row + p-change-value
     2420               no-error .
     2421             if error-status :error
     2422             or error-status :get-message(1) <> ""
     2423             then do:
     2424               undo move_block, retry move_block .
     2425             end.
     2426           end.
     2427         end.
     2428       end.
     2429       else do:
     2430         for each buf_temp-diasize-handle
     2431         on error undo move_block, retry move_block
     2432         :
     2433           assign
     2434             v-object-handle = buf_temp-diasize-handle.handle-value
     2435           .
     2436           if v-object-handle <> v-diasize-resize-button
     2437           then do:
     2438             assign
     2439               v-object-handle :row = v-object-handle :row + p-change-value
     2440               no-error .
     2441             if error-status :error
     2442             or error-status :get-message(1) <> ""
     2443             then do:
     2444               undo move_block, retry move_block .
     2445             end.
     2446           end.
     2447         end.
     2448         assign
     2449           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2450           no-error .
     2451         if error-status :error
     2452         or error-status :get-message(1) <> ""
     2453         then do:
     2454           undo move_block, retry move_block .
     2455         end.
     2456         for each buf_temp-browse-handle
     2457           where buf_temp-browse-handle.browse-type = 'height':u
     2458         on error undo move_block, retry move_block
     2459         :
     2460           assign
     2461             buf_temp-browse-handle.browse-handle :height
     2462               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2463             no-error .
     2464           if error-status :error
     2465           or error-status :get-message(1) <> ""
     2466           then do:
     2467             undo move_block, retry move_block .
     2468           end.
     2469         end.
     2470         assign
     2471           frame d-sel :height = frame d-sel :height + p-change-value
     2472           no-error .
     2473         if error-status :error
     2474         or error-status :get-message(1) <> ""
     2475         then do:
     2476           undo move_block, retry move_block .
     2477         end.
     2478         if frame d-sel :scrollable = true
     2479         then do:
     2480           assign
     2481             frame d-sel :virtual-height = frame d-sel :virtual-height + p-change-value
     2482             no-error .
     2483           if error-status :error
     2484           or error-status :get-message(1) <> ""
     2485           then do:
     2486             undo move_block, retry move_block .
     2487           end.
     2488         end.
     2489       end.
     2490       if p-move-resize = true
     2491       then do:
     2492         run diasize_position-resize-button in this-procedure .
     2493       end.
     2494       if v-diasize-wndstore = true
     2495       then do:
     2496         if connected("ub") = true
     2497         then do:
     2498           define variable v-cntxt-db-num        as integer   no-undo .
     2499           define variable v-cntxt-userid        as character no-undo .
     2500           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2501                                             , OUTPUT v-cntxt-userid
     2502                                             ) .
     2503           run gbl/wndsizew.p
     2504             (input  v-cntxt-db-num
     2505             ,input  v-cntxt-userid
     2506             ,input  v-diasize-proc-name
     2507             ,input  'height':u
     2508             ,input  string(frame d-sel :height - v-diasize-orig-frame-height)
     2509             ) .
     2510         end.
     2511       end.
     2512     end.
     2513     assign
     2514       v-diasize-change-size = false
     2515     .
     2516   end procedure.
     2517   procedure diasize_set-height :
     2518     define input  parameter p-new-height  as decimal   no-undo .
     2519     define input  parameter p-move-resize as logical   no-undo .
     2520     do
     2521     on error undo, return error return-value
     2522     :
     2523       run diasize_change-height in this-procedure
     2524         (input  (p-new-height - frame d-sel :height)
     2525         ,input  p-move-resize
     2526         ) .
     2527     end.
     2528   end procedure.
     2529   procedure diasize_change-width :
     2530     define input  parameter p-change-value as decimal   no-undo .
     2531     define input  parameter p-move-resize  as logical   no-undo .
     2532     define variable v-field-group-handle   as handle    no-undo .
     2533     define variable v-object-handle        as handle    no-undo .
     2534     define variable v-frame-width          as decimal   no-undo .
     2535     define variable v-frame-virtual-width  as decimal   no-undo .
     2536     define variable v-browse-width         as decimal   no-undo .
     2537     define variable v-window-width         as decimal   no-undo .
     2538     define variable v-window-virtual-width as decimal   no-undo .
     2539     define variable v-change-sign          as integer   no-undo .
     2540     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2541     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2542     if p-change-value > 0
     2543     then do:
     2544       if frame d-sel :width + p-change-value >
     2545           session :width-chars
     2546       then do:
     2547         assign
     2548           p-change-value = session :width-chars - frame d-sel :width
     2549         .
     2550         if p-change-value <= 0
     2551         then do:
     2552           run diasize_position-resize-button in this-procedure .
     2553           return .
     2554         end.
     2555       end.
     2556     end.
     2557     if p-change-value < 0
     2558     then do:
     2559       if frame d-sel :width + p-change-value < v-diasize-orig-frame-width
     2560       then do:
     2561         assign
     2562           p-change-value = v-diasize-orig-frame-width
     2563                          - frame d-sel :width
     2564         .
     2565         if p-change-value >= 0
     2566         then do:
     2567           run diasize_position-resize-button in this-procedure .
     2568           return .
     2569         end.
     2570       end.
     2571     end.
     2572     if p-change-value >= 0
     2573     then do:
     2574       assign
     2575         v-change-sign = 1
     2576       .
     2577     end.
     2578     else do:
     2579       assign
     2580         v-change-sign = -1
     2581       .
     2582     end.
     2583     assign
     2584       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2585     .
     2586     if p-change-value = 0
     2587     then do:
     2588       run diasize_position-resize-button in this-procedure .
     2589       return .
     2590     end.
     2591     move_block:
     2592     do
     2593     on error undo move_block, leave move_block
     2594     :
     2595       if retry
     2596       then do:
     2597         do
     2598         on error undo move_block, leave move_block
     2599         :
     2600           if p-change-value > 0
     2601           then do:
     2602             for each buf_temp-diasize-handle
     2603             on error undo, next
     2604             :
     2605               assign
     2606                 v-object-handle = buf_temp-diasize-handle.handle-value
     2607               .
     2608               if v-object-handle <> v-diasize-resize-button
     2609               then do:
     2610                 assign
     2611                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2612                 .
     2613               end.
     2614             end.
     2615             assign
     2616               v-diasize-browse-handle :width = v-browse-width
     2617             .
     2618             for each buf_temp-browse-handle
     2619               where buf_temp-browse-handle.browse-type = 'width':u
     2620             on error undo, next
     2621             :
     2622               assign
     2623                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2624               .
     2625             end.
     2626             assign
     2627               frame d-sel :width = v-frame-width
     2628             .
     2629             if frame d-sel :scrollable = true
     2630             then do:
     2631               assign
     2632                 frame d-sel :virtual-width = v-frame-virtual-width
     2633               .
     2634             end.
     2635             run diasize_position-resize-button in this-procedure .
     2636           end.
     2637           else do:
     2638             if frame d-sel :scrollable = true
     2639             then do:
     2640               assign
     2641                 frame d-sel :virtual-width = v-frame-virtual-width
     2642               .
     2643             end.
     2644             assign
     2645               frame d-sel :width = v-frame-width
     2646             .
     2647             for each buf_temp-browse-handle
     2648               where buf_temp-browse-handle.browse-type = 'width':u
     2649             on error undo, next
     2650             :
     2651               assign
     2652                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2653               .
     2654             end.
     2655             assign
     2656               v-diasize-browse-handle :width = v-browse-width
     2657             .
     2658             for each buf_temp-diasize-handle
     2659             on error undo, next
     2660             :
     2661               assign
     2662                 v-object-handle = buf_temp-diasize-handle.handle-value
     2663               .
     2664               if v-object-handle <> v-diasize-resize-button
     2665               then do:
     2666                 assign
     2667                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2668                 .
     2669               end.
     2670             end.
     2671             run diasize_position-resize-button in this-procedure .
     2672           end.
     2673           assign
     2674             v-diasize-change-size = false
     2675           .
     2676           leave move_block .
     2677         end.
     2678       end.
     2679       assign
     2680         v-diasize-need-full-display = true
     2681       .
     2682       if v-diasize-change-size = false
     2683       then do:
     2684         assign
     2685           v-diasize-change-size = true
     2686         .
     2687       end.
     2688       else do:
     2689         return .
     2690       end.
     2691       assign
     2692         v-frame-width = frame d-sel :width
     2693         v-frame-virtual-width = frame d-sel :virtual-width
     2694         v-browse-width = v-diasize-browse-handle :width
     2695       .
     2696       for each buf_temp-browse-handle
     2697         where buf_temp-browse-handle.browse-type = 'width':u
     2698       :
     2699         assign
     2700           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2701         .
     2702       end.
     2703       for each buf_temp-diasize-handle
     2704       :
     2705         delete buf_temp-diasize-handle .
     2706       end.
     2707       assign
     2708         v-field-group-handle = frame d-sel :first-child
     2709       .
     2710       do while valid-handle(v-field-group-handle)
     2711       :
     2712         assign
     2713           v-object-handle = v-field-group-handle :first-child
     2714         .
     2715         do while valid-handle(v-object-handle)
     2716         :
     2717           if  v-object-handle <> v-diasize-browse-handle :handle
     2718           and v-object-handle <> v-diasize-resize-button
     2719           and can-query(v-object-handle, "row")
     2720           and can-query(v-object-handle, "height")
     2721           and ( v-object-handle :col + v-object-handle :width
     2722                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2723               )
     2724           then do:
     2725             find first buf_temp-browse-handle
     2726               where buf_temp-browse-handle.browse-type   = 'width':u
     2727                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2728               no-error .
     2729             if available buf_temp-browse-handle
     2730             then do:
     2731             end.
     2732             else do:
     2733               create buf_temp-diasize-handle .
     2734               assign
     2735                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2736                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2737               .
     2738             end.
     2739           end.
     2740           assign
     2741             v-object-handle = v-object-handle :next-sibling
     2742           .
     2743         end.
     2744         assign
     2745           v-field-group-handle = v-field-group-handle :next-sibling
     2746         .
     2747       end.
     2748       do with frame d-sel
     2749       :
     2750         hide v-diasize-resize-button .
     2751         v-diasize-resize-button :row = 1.
     2752         v-diasize-resize-button :column = 1.
     2753       end.
     2754       if p-change-value > 0
     2755       then do:
     2756         if frame d-sel :scrollable = true
     2757         then do:
     2758           assign
     2759             frame d-sel :virtual-width = frame d-sel :virtual-width + p-change-value
     2760             no-error .
     2761           if error-status :error
     2762           or error-status :get-message(1) <> ""
     2763           then do:
     2764             undo move_block, retry move_block.
     2765           end.
     2766         end.
     2767         assign
     2768           frame d-sel :width = v-frame-width + p-change-value
     2769           no-error .
     2770         if error-status :error
     2771         or error-status :get-message(1) <> ""
     2772         then do:
     2773           undo move_block, retry move_block.
     2774         end.
     2775         assign
     2776           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2777         no-error .
     2778         if error-status :error
     2779         or error-status :get-message(1) <> ""
     2780         then do:
     2781           undo move_block, retry move_block.
     2782         end.
     2783         for each buf_temp-browse-handle
     2784           where buf_temp-browse-handle.browse-type = 'width':u
     2785         on error undo move_block, retry move_block
     2786         :
     2787           assign
     2788             buf_temp-browse-handle.browse-handle :width
     2789               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2790             no-error .
     2791           if error-status :error
     2792           or error-status :get-message(1) <> ""
     2793           then do:
     2794             undo move_block, retry move_block .
     2795           end.
     2796         end.
     2797         for each buf_temp-diasize-handle
     2798         on error undo move_block, retry move_block
     2799         :
     2800           assign
     2801             v-object-handle = buf_temp-diasize-handle.handle-value
     2802           .
     2803           if v-object-handle <> v-diasize-resize-button
     2804           then do:
     2805             assign
     2806               v-object-handle :col = v-object-handle :col + p-change-value
     2807               no-error .
     2808             if error-status :error
     2809             or error-status :get-message(1) <> ""
     2810             then do:
     2811               undo move_block, retry move_block .
     2812             end.
     2813           end.
     2814         end.
     2815       end.
     2816       else do:
     2817         for each buf_temp-diasize-handle
     2818         on error undo move_block, retry move_block
     2819         :
     2820           assign
     2821             v-object-handle = buf_temp-diasize-handle.handle-value
     2822           .
     2823           if v-object-handle <> v-diasize-resize-button
     2824           then do:
     2825             assign
     2826               v-object-handle :col = v-object-handle :col + p-change-value
     2827               no-error .
     2828             if error-status :error
     2829             or error-status :get-message(1) <> ""
     2830             then do:
     2831               undo move_block, retry move_block .
     2832             end.
     2833           end.
     2834         end.
     2835         for each buf_temp-browse-handle
     2836           where buf_temp-browse-handle.browse-type = 'width':u
     2837         on error undo move_block, retry move_block
     2838         :
     2839           assign
     2840             buf_temp-browse-handle.browse-handle :width
     2841               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2842             no-error .
     2843           if error-status :error
     2844           or error-status :get-message(1) <> ""
     2845           then do:
     2846             undo move_block, retry move_block .
     2847           end.
     2848         end.
     2849         assign
     2850           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2851           no-error .
     2852         if error-status :error
     2853         or error-status :get-message(1) <> ""
     2854         then do:
     2855           undo move_block, retry move_block.
     2856         end.
     2857         assign
     2858           frame d-sel :width = frame d-sel :width + p-change-value
     2859         no-error .
     2860         if error-status :error
     2861         or error-status :get-message(1) <> ""
     2862         then do:
     2863           undo move_block, retry move_block.
     2864         end.
     2865         if frame d-sel :scrollable = true
     2866         then do:
     2867           assign
     2868             frame d-sel :virtual-width = frame d-sel :virtual-width + p-change-value
     2869           no-error .
     2870           if error-status :error
     2871           or error-status :get-message(1) <> ""
     2872           then do:
     2873             undo move_block, retry move_block.
     2874           end.
     2875         end.
     2876       end.
     2877       if p-move-resize
     2878       then do:
     2879         run diasize_position-resize-button in this-procedure .
     2880       end.
     2881       if v-diasize-wndstore = true
     2882       then do:
     2883         if connected("ub") = true
     2884         then do:
     2885           define variable v-cntxt-db-num        as integer   no-undo .
     2886           define variable v-cntxt-userid        as character no-undo .
     2887           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2888                                             , OUTPUT v-cntxt-userid
     2889                                             ) .
     2890           run gbl/wndsizew.p
     2891             (input  v-cntxt-db-num
     2892             ,input  v-cntxt-userid
     2893             ,input  v-diasize-proc-name
     2894             ,input  'width':u
     2895             ,input  string(frame d-sel :width - v-diasize-orig-frame-width)
     2896             ) .
     2897         end.
     2898       end.
     2899     end.
     2900     assign
     2901       v-diasize-change-size = false
     2902     .
     2903   end procedure.
     2904   procedure diasize_set-width :
     2905     define input  parameter p-new-width  as decimal   no-undo .
     2906     define input  parameter p-move-resize as logical   no-undo .
     2907     do
     2908     on error undo, return error return-value
     2909     :
     2910       run diasize_change-width in this-procedure
     2911         (input  (p-new-width - frame d-sel :width)
     2912         ,input  p-move-resize
     2913         ) .
     2914     end.
     2915   end procedure.
     2916   procedure diasize_position-resize-button :
     2917     do with frame d-sel
     2918     :
     2919       hide v-diasize-resize-button .
     2920       assign
     2921         v-diasize-resize-button :row = frame d-sel :height - v-diasize-resize-button :height
     2922                     - 1
     2923                     - (frame d-sel :border-bottom-pixels / session :pixels-per-row)
     2924         v-diasize-resize-button :col = frame d-sel :width - v-diasize-resize-button :width
     2925                     - 1
     2926                     - (frame d-sel :border-right-pixels / session :pixels-per-column)
     2927       .
     2928       view v-diasize-resize-button .
     2929     end.
     2930   end procedure.
     2931   on alt-right anywhere
     2932   do:
     2933     run diasize_change-width in this-procedure
     2934       (input 1
     2935       ,input true
     2936       ) .
     2937     return no-apply .
     2938   end.
     2939   on alt-left anywhere
     2940   do:
     2941     run diasize_change-width in this-procedure
     2942       (input -1
     2943       ,input true
     2944       ) .
     2945     return no-apply .
     2946   end.
     2947   on alt-down anywhere
     2948   do:
     2949     run diasize_change-height in this-procedure
     2950       (input 1
     2951       ,input true
     2952       ) .
     2953     return no-apply .
     2954   end.
     2955   on alt-up anywhere
     2956   do:
     2957     run diasize_change-height in this-procedure
     2958       (input -1
     2959       ,input true
     2960       ) .
     2961     return no-apply .
     2962   end.
     2963   on alt-enter of frame d-sel
     2964   do:
     2965     run diasize_maximize in this-procedure
     2966       (input  ?
     2967       ).
     2968     return no-apply .
     2969   end.
     2970   procedure diasize_end-move :
     2971     do
     2972     on error undo, return error return-value
     2973     :
     2974       define variable v-row-delta as decimal   no-undo .
     2975       define variable v-col-delta as decimal   no-undo .
     2976       define variable v-new-row as decimal   no-undo .
     2977       define variable v-new-col as decimal   no-undo .
     2978       assign
     2979         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2980         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2981       .
     2982       assign
     2983         v-row-delta = v-new-row - frame d-sel :height
     2984         v-col-delta = v-new-col - frame d-sel :width
     2985       .
     2986       run diasize_change-height in this-procedure
     2987         (input v-row-delta
     2988         ,input true
     2989         ) .
     2990       run diasize_change-width in this-procedure
     2991         (input v-col-delta
     2992         ,input true
     2993         ) .
     2994     end.
     2995   end procedure.
     2996   procedure diasize_maximize :
     2997     define input  parameter p-action as logical   no-undo .
     2998     do
     2999     on error undo, return error return-value
     3000     :
     3001       if p-action = ?
     3002       then do:
     3003         if v-diasize-need-maximize = true
     3004         then do:
     3005           assign
     3006             p-action = true
     3007           .
     3008         end.
     3009         else do:
     3010           assign
     3011             p-action = false
     3012           .
     3013         end.
     3014       end.
     3015       if p-action = true
     3016       then do:
     3017         run diasize_change-height in this-procedure
     3018           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3019               - frame d-sel :height-chars
     3020           ,input true
     3021           ) .
     3022         run diasize_change-width in this-procedure
     3023           (input session :width-chars
     3024               - frame d-sel :width-chars
     3025           ,input true
     3026           ) .
     3027         assign
     3028           v-diasize-need-maximize = false
     3029         .
     3030       end.
     3031       else do:
     3032         run diasize_change-width in this-procedure
     3033           (input v-diasize-orig-frame-width
     3034               - frame d-sel :width-chars
     3035           ,input true
     3036           ) .
     3037         run diasize_change-height in this-procedure
     3038           (input v-diasize-orig-frame-height
     3039               - frame d-sel :height-chars
     3040           ,input true
     3041           ) .
     3042         assign
     3043           v-diasize-need-maximize = true
     3044         .
     3045       end.
     3046     end.
     3047   end procedure.
     3048   procedure diasize_restore-orig-size :
     3049     do
     3050     on error undo, return error return-value
     3051     :
     3052       assign
     3053         v-diasize-current-frame-width  = frame d-sel :width
     3054         v-diasize-current-frame-height = frame d-sel :height
     3055       .
     3056       run diasize_set-height in this-procedure
     3057         (input  v-diasize-orig-frame-height
     3058         ,input  true
     3059         ) .
     3060       run diasize_set-width in this-procedure
     3061         (input  v-diasize-orig-frame-width
     3062         ,input  true
     3063         ) .
     3064     end.
     3065   end procedure.
     3066   procedure diasize_restore-current-size :
     3067     do
     3068     on error undo, return error return-value
     3069     :
     3070       run diasize_set-height in this-procedure
     3071         (input  v-diasize-current-frame-height
     3072         ,input  true
     3073         ) .
     3074       run diasize_set-width in this-procedure
     3075         (input  v-diasize-current-frame-width
     3076         ,input  true
     3077         ) .
     3078     end.
     3079   end procedure.
     3080   procedure diasize_set-browse-handle :
     3081     define input  parameter p-browse-handle as handle   no-undo .
     3082     define buffer buf_temp-browse-handle for temp-browse-handle .
     3083     do
     3084     on error undo, return error return-value
     3085     :
     3086       assign
     3087         v-diasize-browse-handle = p-browse-handle
     3088       .
     3089       for each buf_temp-browse-handle
     3090       on error undo, return error return-value
     3091       :
     3092         delete buf_temp-browse-handle .
     3093       end.
     3094     end.
     3095   end procedure.
     3096   procedure diasize_add_browse :
     3097     define input  parameter p-browse-type   as character no-undo .
     3098     define input  parameter p-browse-handle as handle    no-undo .
     3099     define buffer buf_temp-browse-handle for temp-browse-handle .
     3100     do
     3101     on error undo, return error return-value
     3102     :
     3103       assign
     3104         v-diasize-browse-number = v-diasize-browse-number + 1
     3105       .
     3106       create buf_temp-browse-handle .
     3107       assign
     3108         buf_temp-browse-handle.browse-type   = p-browse-type
     3109         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3110         buf_temp-browse-handle.browse-handle = p-browse-handle
     3111       .
     3112     end.
     3113   end procedure.
     3114   procedure diasize_init :
     3115     define variable v-default-value    as logical   no-undo .
     3116     define variable v-restore-saved    as logical   no-undo .
     3117     define variable v-resize-value-str as character no-undo .
     3118     do
     3119     on error undo, return error return-value
     3120     :
     3121       do with frame d-sel
     3122       :
     3123         assign
     3124           v-diasize-orig-frame-height = frame d-sel :height
     3125           v-diasize-orig-frame-width  = frame d-sel :width
     3126           v-diasize-browse-handle     = browse br-staff :handle
     3127         .
     3128         create button v-diasize-resize-button
     3129         assign
     3130           parent        = frame d-sel :first-child
     3131           label         = "s"
     3132           height-pixels = 16
     3133           width-pixels  = 16
     3134           visible       = true
     3135           sensitive     = true
     3136           movable       = true
     3137           triggers:
     3138             on end-move persistent run diasize_end-move in this-procedure .
     3139           end triggers.
     3140         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3141         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3142         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3143         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3144         assign
     3145           v-diasize-wndmax = false
     3146         .
     3147         if connected("ub") = true
     3148         then do:
     3149           define variable v-cntxt-db-num        as integer   no-undo .
     3150           define variable v-cntxt-userid        as character no-undo .
     3151           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3152                                             , OUTPUT v-cntxt-userid
     3153                                             ) .
     3154           run gbl/wndpar_r.p
     3155             (input  v-cntxt-db-num
     3156             ,input  v-cntxt-userid
     3157             ,input  'wndmax':U
     3158             ,output v-diasize-wndmax
     3159             ,output v-default-value
     3160             ) .
     3161         end.
     3162         assign
     3163           v-diasize-wndstore = false
     3164         .
     3165         if connected("ub") = true
     3166         then do:
     3167           run gbl/wndpar_r.p
     3168             (input  v-cntxt-db-num
     3169             ,input  v-cntxt-userid
     3170             ,input  'wndstore':U
     3171             ,output v-diasize-wndstore
     3172             ,output v-default-value
     3173             ) .
     3174         end.
     3175         assign
     3176           v-diasize-proc-name = entry(1, program-name(2), '.')
     3177         .
     3178         if v-diasize-wndstore = true
     3179         then do:
     3180           assign
     3181             v-restore-saved = false
     3182           .
     3183           if connected("ub") = true
     3184           then do:
     3185             run gbl/wndsizer.p
     3186               (input  v-cntxt-db-num
     3187               ,input  v-cntxt-userid
     3188               ,input  v-diasize-proc-name
     3189               ,input  'height':u
     3190               ,output v-resize-value-str
     3191               ) .
     3192             if v-resize-value-str <> '':U
     3193             then do:
     3194               run diasize_change-height in this-procedure
     3195                 (input  integer(v-resize-value-str)
     3196                 ,input  true
     3197                 ) .
     3198               assign
     3199                 v-restore-saved = true
     3200               .
     3201             end.
     3202           end.
     3203           if connected("ub") = true
     3204           then do:
     3205             run gbl/wndsizer.p
     3206               (input  v-cntxt-db-num
     3207               ,input  v-cntxt-userid
     3208               ,input  v-diasize-proc-name
     3209               ,input  'width':u
     3210               ,output v-resize-value-str
     3211               ) .
     3212             if v-resize-value-str <> '':U
     3213             then do:
     3214               run diasize_change-width in this-procedure
     3215                 (input  integer(v-resize-value-str)
     3216                 ,input  true
     3217                 ) .
     3218               assign
     3219                 v-restore-saved = true
     3220               .
     3221             end.
     3222           end.
     3223           if v-restore-saved <> true
     3224           then do:
     3225             if v-diasize-wndmax = true
     3226             then do:
     3227               run diasize_maximize in this-procedure
     3228                 (input  true
     3229                 ) .
     3230             end.
     3231           end.
     3232         end.
     3233         else do:
     3234           if v-diasize-wndmax = true
     3235           then do:
     3236             run diasize_maximize in this-procedure
     3237               (input  true
     3238               ) .
     3239           end.
     3240         end.
     3241       end.
     3242     end.
     3243   end procedure.
     3244   procedure diasize_need-full-display :
     3245     define output parameter p-need-full-display as logical   no-undo .
     3246     do
     3247     on error undo, return error return-value
     3248     :
     3249       assign
     3250         p-need-full-display = v-diasize-need-full-display
     3251       .
     3252       assign
     3253         v-diasize-need-full-display = false
     3254       .
     3255     end.
     3256   end procedure.
     3257   procedure get-context :
     3258      define output parameter p-db-num as integer          no-undo.
     3259      define output parameter p-user-id as character        no-undo.
     3260      define variable v-login               as character    no-undo.
     3261      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3262      define buffer buf_user-login  for ub.user-login .
     3263      do
     3264      on error undo, return error
     3265      :
     3266            FIND FIRST buf_sys-ctrl no-lock.
     3267            ASSIGN
     3268               v-login = USERID("ub")
     3269               p-db-num = buf_sys-ctrl.db-num
     3270            .
     3271            FIND FIRST buf_user-login
     3272                 WHERE buf_user-login.db-num = p-db-num
     3273                   AND buf_user-login.user-login = v-login
     3274                 no-lock
     3275                 no-error
     3276                 .
     3277            IF AVAILABLE buf_user-login
     3278            THEN DO:
     3279               assign
     3280                  p-user-id = buf_user-login.user-id
     3281               .
     3282            END.
     3283      end.
     3284   end procedure.
