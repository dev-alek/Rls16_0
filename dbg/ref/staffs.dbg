     3331   ON TAB ANYWHERE
     3332   DO:
     3333   define variable ii as integer no-undo .
     3334   define variable fh as widget-handle no-undo .
     3335   define variable hh as widget-handle no-undo .
     3336   define variable v-next-widget-name as character no-undo .
     3337   if v-tab-order <> '' then do:
     3338     if self:type = "TOGGLE-BOX" then
     3339     self:BGCOLOR = ?.
     3340     assign
     3341     ii = lookup(self:name, v-tab-order).
     3342     assign
     3343     ii = ii + 1
     3344     v-next-widget-name = entry(ii, v-tab-order)
     3345     no-error .
     3346     if error-status:error then do:
     3347       assign
     3348       ii = 1
     3349       v-next-widget-name = entry( ii, v-tab-order)
     3350       .
     3351     end.
     3352     assign
     3353     fh = frame d-sel:first-child
     3354     hh = fh:first-child
     3355     .
     3356     do while valid-handle(hh):
     3357       if hh:name = v-next-widget-name then do:
     3358         if hh:sensitive  = yes
     3359         AND hh:visible = yes then do:
     3360           APPLY "ENTRY" to hh.
     3361           return no-apply.
     3362         end.
     3363         else do:
     3364           APPLY "TAB" to hh.
     3365           return no-apply.
     3366         end.
     3367       end.
     3368       hh = hh:next-sibling.
     3369     end.
     3370   end.
     3371   END.
     3372   ON BACK-TAB ANYWHERE
     3373   DO:
     3374   define variable ii as integer no-undo .
     3375   define variable fh as widget-handle no-undo .
     3376   define variable hh as widget-handle no-undo .
     3377   define variable v-next-widget-name as character no-undo .
     3378   if v-tab-order <> '' then do:
     3379     assign
     3380     ii = lookup(self:name, v-tab-order).
     3381     .
     3382     assign
     3383     ii = (if ii = 1
     3384           then  num-entries(v-tab-order)
     3385           else ii - 1
     3386           )
     3387     v-next-widget-name = entry(ii, v-tab-order)
     3388     .
     3389     assign
     3390     fh = frame d-sel:first-child
     3391     hh = fh:first-child
     3392     .
     3393     do while valid-handle(hh):
     3394       if hh:name = v-next-widget-name then do:
     3395         if hh:sensitive  = yes
     3396         AND hh:visible = yes then do:
     3397           APPLY "ENTRY" to hh.
     3398           return no-apply.
     3399         end.
     3400         else do:
     3401         APPLY "BACK-TAB" to hh.
     3402         return no-apply.
     3403         end.
     3404       end.
     3405       hh = hh:next-sibling.
     3406     end.
     3407     end.
     3408   END.
     3409   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3410   ON RETURN ANYWHERE
     3411   DO:
     3412   define variable ii as integer no-undo .
     3413   define variable fh as widget-handle no-undo .
     3414   define variable hh as widget-handle no-undo .
     3415   define variable v-next-widget-name as character no-undo .
     3416     if v-tab-order <> '' then do:
     3417       assign
     3418       ii = lookup(self:name, v-tab-order).
     3419       if ii = num-entries(v-tab-order) then do:
     3420           return no-apply.
     3421       end.
     3422       if self:type <> "BUTTON" and
     3423         self:type <> "EDITOR"  then do:
     3424         run proc-move-forward in this-procedure .
     3425         return no-apply.
     3426       end.
     3427       if self:type = "BUTTON" then do:
     3428         APPLY "CHOOSE" to self.
     3429       end.
     3430       if self:type = "TOGGLE-BOX" then
     3431       self:BGCOLOR = ?.
     3432       assign
     3433       ii = ii + 1
     3434       v-next-widget-name = entry(ii, v-tab-order)
     3435       no-error .
     3436       if error-status:error then do:
     3437         assign
     3438         ii = 1
     3439         v-next-widget-name = entry( ii, v-tab-order)
     3440         .
     3441       end.
     3442       assign
     3443       fh = frame d-sel:first-child
     3444       hh = fh:first-child
     3445       .
     3446       do while valid-handle(hh):
     3447         if hh:name = v-next-widget-name then do:
     3448           if hh:sensitive  = yes
     3449           AND hh:visible = yes then do:
     3450             APPLY "ENTRY" to hh.
     3451             return no-apply.
     3452           end.
     3453           else do:
     3454             APPLY "TAB" to hh.
     3455             return no-apply.
     3456           end.
     3457         end.
     3458         hh = hh:next-sibling.
     3459       end.
     3460     end.
     3461   END.
     3462   procedure proc-move-forward :
     3463   define variable ii as integer no-undo .
     3464   define variable fh as widget-handle no-undo .
     3465   define variable hh as widget-handle no-undo .
     3466   define variable v-next-widget-name as character no-undo .
     3467   do
     3468   on error undo, return error
     3469   :
     3470     if v-tab-order <> '' then do:
     3471       if self:type = "TOGGLE-BOX" then
     3472       self:BGCOLOR = ?.
     3473       assign
     3474       ii = lookup(self:name, v-tab-order).
     3475       assign
     3476       ii = ii + 1
     3477       v-next-widget-name = entry(ii, v-tab-order)
     3478       no-error .
     3479       if error-status:error then do:
     3480         assign
     3481         ii = 1
     3482         v-next-widget-name = entry( ii, v-tab-order)
     3483         .
     3484       end.
     3485       assign
     3486       fh = frame d-sel:first-child
     3487       hh = fh:first-child
     3488       .
     3489       do while valid-handle(hh):
     3490         if hh:name = v-next-widget-name then do:
     3491           if hh:sensitive  = yes
     3492           AND hh:visible = yes then do:
     3493             APPLY "ENTRY" to hh.
     3494             return.
     3495           end.
     3496           else do:
     3497             assign
     3498             ii = ii + 1
     3499             v-next-widget-name = entry(ii, v-tab-order)
     3500             no-error .
     3501             if error-status:error then do:
     3502               assign
     3503               ii = 1
     3504               v-next-widget-name = entry( ii, v-tab-order)
     3505               .
     3506             end.
     3507           end.
     3508         end.
     3509         hh = hh:next-sibling.
     3510       end.
     3511     end.
     3512   end.
     3513   end procedure.
     3514   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3515   on f5 of frame d-sel anywhere
     3516   do:
     3517     v-doc-rec = ?. if available X_staff then assign v-doc-rec = recid(X_staff) no-error. Run OpenBr in this-procedure ( INPUT yes, INPUT no, INPUT '':U). reposition br-staff to recid v-doc-rec no-error.               APPLY 'entry' to br-staff. APPLY 'VALUE-CHANGED' to br-staff. v-doc-rec = ?.
     3518       apply "VALUE-CHANGED" to br-staff.
     3519   end.
     3520   ON WINDOW-CLOSE OF FRAME d-sel APPLY "END-ERROR":U TO SELF.
     3521   MAIN-BLOCK:
     3522   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3523      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3524   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3525     run mainmenu_getcntxt in parparentproc
     3526       (output v-cntxt-db-num
     3527       ,output v-cntxt-userid
     3528       ,output v-cntxt-level
     3529       ,output v-cntxt-host-code-obj
     3530       ,output v-cntxt-obj-type
     3531       ,output v-cntxt-obj-code
     3532       ,output v-cntxt-db-num-obj
     3533       ,output v-cntxt-is-admin
     3534       ) .
     3535       if v-cntxt-db-num <> 0
     3536       or (v-cntxt-db-num = 0  and p-db-num = 0)
     3537       then do:
     3538         assign
     3539         p-db-num = v-cntxt-db-num
     3540         v-db-num = p-db-num
     3541         .
     3542       end.
     3543       run enable_UI  in this-procedure .
     3544       HIDE mark-num in frame d-sel .
     3545       WAIT-FOR GO OF FRAME d-sel.
     3546   END.
     3547   run disable_UI in this-procedure .
     3548   PROCEDURE calc-arch :
     3549   define variable StartMonth  like ub.cshr-month.month_ no-undo .
     3550   define variable StartYear   like ub.cshr-month.year_       no-undo .
     3551   define variable StartMonth-psn  like ub.cshr-month.month_ no-undo .
     3552   define variable StartYear-psn   like ub.cshr-month.year_       no-undo .
     3553   define variable StartDate   as date no-undo .
     3554   define variable StartDate-psn   as date no-undo .
     3555   define variable ChkMonth as integer no-undo.
     3556   define variable ChkYear as integer no-undo.
     3557   define variable DateBuf-Start as date no-undo .
     3558   define variable DateBuf-End as date no-undo .
     3559   define variable EndDay_ as integer no-undo .
     3560   DEFINE VARIABLE v-today as date no-undo .
     3561   DEFINE VARIABLE v-time as integer no-undo .
     3562   DEFINE VARIABLE v-v12-3 as date no-undo .
     3563   define variable v-out-totchk  as integer no-undo .
     3564   define variable v-out-totsum  as decimal no-undo .
     3565   define variable v-out-count   as integer no-undo .
     3566   define variable v-out-qnty    as decimal no-undo .
     3567   define variable v-out-sum     as decimal no-undo .
     3568   define variable v-ret-totchk  as integer no-undo .
     3569   define variable v-ret-totsum  as decimal no-undo .
     3570   define variable v-ret-count   as integer no-undo .
     3571   define variable v-ret-qnty    as decimal no-undo .
     3572   define variable v-ret-sum     as decimal no-undo .
     3573   define buffer shop_cli for ub.clients.
     3574   find first ub.upgrade no-lock where
     3575              ub.upgrade.db-num = v-db-num
     3576         and  ub.upgrade.version-num = "12.3":U no-error .
     3577   assign
     3578   StartDate = ?
     3579   StartDate-psn = ?
     3580   v-db-num = v-cntxt-db-num
     3581   v-v12-3 = if available ub.upgrade then ub.upgrade.upgdate else ?
     3582   .
     3583   FIND FIRST ub.cshr-month WHERE
     3584               ub.cshr-month.cshr-code = X_staff.staff-code
     3585           AND ub.cshr-month.cashier-psn-code = 0
     3586   NO-LOCK NO-ERROR .
     3587   if available ub.cshr-month then do:
     3588     if ub.cshr-month.month_ < 12 then do:
     3589       assign
     3590           StartMonth = ub.cshr-month.month_ + 1
     3591           StartYear = ub.cshr-month.year_ .
     3592     end.
     3593     else do:
     3594       assign
     3595           StartMonth = 1
     3596           StartYear = ub.cshr-month.year_ + 1 .
     3597     end.
     3598     StartDate = date( StartMonth, 1, StartYear ) .
     3599   end.
     3600   for each  cshr-month NO-LOCK WHERE
     3601               cshr-month.cshr-code = X_staff.staff-code
     3602           AND cshr-month.cashier-psn-code = X_person.psn-code:
     3603     if StartDate-psn = ? or
     3604       Startdate-psn > date(cshr-month.month_, 1, cshr-month.year_) then do:
     3605       if cshr-month.month_ < 12 then do:
     3606         assign
     3607             StartMonth-PSN = cshr-month.month_ + 1
     3608             StartYear-PSN = cshr-month.year_ .
     3609       end.
     3610       else do:
     3611         assign
     3612             StartMonth-PSN = 1
     3613             StartYear-PSN = cshr-month.year_ + 1 .
     3614       end.
     3615       StartDate-PSN = date( StartMonth-PSN, 1, StartYear-pSN ) .
     3616     end.
     3617   END.
     3618   if startdate = ? or startdate-psn = ? then do:
     3619     FOR EACH ub.shop NO-LOCK :
     3620       FIND LAST ub.chk-doc NO-LOCK WHERE
     3621               ub.chk-doc.obj-type = 'маг':U AND
     3622               ub.chk-doc.obj-code = shop.obj-code AND
     3623               ub.chk-doc.cashier = X_staff.staff-code
     3624               use-index cash-desk no-error.
     3625       if available ub.chk-doc then do:
     3626         if ub.chk-doc.cashier-psn-code = ? then do:
     3627           if StartDate = ? then do:
     3628             assign
     3629             StartDate = date( month( chk-doc.chk-date ), 1, year( chk-doc.chk-date ) ) .
     3630           end.
     3631           else do:
     3632             if StartDate > chk-doc.chk-date then do:
     3633               assign
     3634               StartDate = date( month( chk-doc.chk-date ), 1, year( chk-doc.chk-date ) )
     3635               .
     3636             end.
     3637           end.
     3638         end.
     3639         if chk-doc.cashier-psn-code <> ? and chk-doc.cashier-psn-code = X_person.psn-code then do:
     3640           if StartDate-psn = ? then do:
     3641             assign
     3642             StartDate-psn = date( month( chk-doc.chk-date ), 1, year( chk-doc.chk-date ) ) .
     3643           end.
     3644           else do:
     3645             if StartDate-psn > chk-doc.chk-date then do:
     3646               assign
     3647               StartDate-psn = date( month( chk-doc.chk-date ), 1, year( chk-doc.chk-date ) )
     3648               .
     3649             end.
     3650           end.
     3651         end.
     3652       END.
     3653     END .
     3654     if startdate <> ? and startdate-psn = ? then do:
     3655       if v-v12-3 = ? then v-v12-3 = Startdate.
     3656       FOR EACH shop_cli NO-LOCK where
     3657               shop_cli.obj-type = 'маг':U
     3658           AND  shop_cli.db-num = v-cntxt-db-num,
     3659           EACH chk-doc NO-LOCK WHERE
     3660                 chk-doc.obj-type = 'маг':U AND
     3661                 chk-doc.obj-code = shop_cli.obj-code AND
     3662                 chk-doc.cashier = X_staff.staff-code AND
     3663                 chk-doc.chk-date > v-v12-3
     3664       by chk-doc.chk-date descending
     3665       by chk-doc.chk-time descending:
     3666         if chk-doc.cashier-psn-code <> ? and chk-doc.cashier-psn-code <> X_person.psn-code then NEXT.
     3667         if StartDate-psn = ? then do:
     3668           assign
     3669           StartDate-psn = date( month( chk-doc.chk-date ), 1, year( chk-doc.chk-date ) ) .
     3670         end.
     3671         else do:
     3672           if StartDate-psn > chk-doc.chk-date then do:
     3673             assign
     3674             StartDate-psn = date( month( chk-doc.chk-date ), 1, year( chk-doc.chk-date ) )
     3675             .
     3676           end.
     3677         end.
     3678       END .
     3679     end.
     3680   end.
     3681   if StartDate = ? and startdate-psn = ? then do:
     3682     message
     3683     "Архивы по данному кассиру пусты."
     3684     view-as alert-box INFORMATION .
     3685     return "0" .
     3686   end.
     3687   run waitfram-show in this-procedure ( input "Подождите ..." ) .
     3688   run cur-time in this-procedure ( output v-today, output v-time).
     3689   assign
     3690   v-v12-3 = (if StartDate-psn <> ? then startdate-psn else v-today)
     3691   .
     3692   DO TRANSACTION
     3693   ON STOP undo, return no-apply
     3694   ON ERROR undo, return no-apply
     3695   ON END-KEY undo, return no-apply :
     3696     if StartDate = ? then.
     3697     else do:
     3698       assign
     3699       DateBuf-Start = StartDate
     3700       StartMonth = month( StartDate )
     3701       StartYear = year( StartDate )
     3702       .
     3703       DO WHILE DateBuf-Start < v-v12-3  :
     3704         run gbl/lastday.p ( input DateBuf-Start, output EndDay_ ) .
     3705         assign
     3706         DateBuf-End = date( StartMonth, EndDay_ , StartYear )
     3707         DateBuf-end = min(dateBuf-end, v-v12-3)
     3708         .
     3709     shop-cycle:
     3710         FOR EACH shop NO-LOCK:
     3711           FIND FIRST chk-doc WHERE
     3712                     chk-doc.obj-type = 'маг':U AND
     3713                     chk-doc.obj-code = shop.obj-code AND
     3714                     chk-doc.cashier = X_staff.staff-code AND
     3715                     chk-doc.chk-date >= DateBuf-Start AND
     3716                     chk-doc.chk-date <= DateBuf-End AND
     3717                     chk-doc.out-code <> ? NO-LOCK NO-ERROR .
     3718           if available chk-doc AND
     3719               ( NOT can-find( cshr-month WHERE
     3720                               cshr-month.cshr-code = X_staff.staff-code AND
     3721                               cshr-month.cashier-psn-code = 0 AND
     3722                               cshr-month.obj-type = "":U and
     3723                               cshr-month.obj-code = 0 AND
     3724                               cshr-month.year_ = StartYear AND
     3725                               cshr-month.month_ = StartMonth ) ) then do:
     3726             CREATE cshr-month .
     3727             assign
     3728             cshr-month.cshr-code = X_staff.staff-code
     3729             cshr-month.year_ = year( chk-doc.chk-date )
     3730             cshr-month.month_ = month( chk-doc.chk-date )
     3731             cshr-month.cashier-psn-code = 0
     3732             cshr-month.obj-type = "":U
     3733             cshr-month.obj-code = 0
     3734             .
     3735             LEAVE shop-cycle.
     3736           end.
     3737         END.
     3738         if month( DateBuf-Start ) < 12 then do:
     3739           assign
     3740           StartMonth = month( DateBuf-Start ) + 1
     3741           StartYear = year( DateBuf-Start )
     3742           .
     3743         end.
     3744         else do:
     3745           assign
     3746           StartMonth = 1
     3747           StartYear = year( DateBuf-Start ) + 1
     3748           .
     3749         end.
     3750         DateBuf-Start = date( StartMonth, 1, StartYear ) .
     3751       END .
     3752       assign
     3753       StartMonth = month( StartDate )
     3754       StartYear = year( StartDate )
     3755       .
     3756       FOR EACH cshr-month WHERE
     3757               cshr-month.cshr-code = X_staff.staff-code AND
     3758               cshr-month.cashier-psn-code = 0 AND
     3759               cshr-month.obj-type = "":U and
     3760               cshr-month.obj-code = 0 and
     3761               ( ( cshr-month.year_ = StartYear ) AND
     3762                 ( cshr-month.month_ >= StartMonth )
     3763               OR ( cshr-month.year_ > StartYear ) ) :
     3764         assign
     3765         DateBuf-Start = date( cshr-month.month_ , 1, cshr-month.year_ )
     3766         .
     3767         run gbl/lastday.p ( input DateBuf-Start, output EndDay_ ) .
     3768         assign
     3769         DateBuf-End = date( cshr-month.month_ , EndDay_ , cshr-month.year_ ) .
     3770         assign
     3771         v-out-totchk  = 0
     3772         v-out-totsum  = 0
     3773         v-out-count   = 0
     3774         v-out-qnty    = 0
     3775         v-out-sum     = 0
     3776         v-ret-totchk  = 0
     3777         v-ret-totsum  = 0
     3778         v-ret-count   = 0
     3779         v-ret-qnty    = 0
     3780         v-ret-sum     = 0
     3781         .
     3782         FOR EACH shop NO-LOCK,
     3783             EACH chk-doc WHERE
     3784               chk-doc.obj-type = 'маг':U AND
     3785               chk-doc.obj-code = shop.obj-code AND
     3786               chk-doc.cashier = X_staff.staff-code AND
     3787               chk-doc.chk-date >= DateBuf-Start AND
     3788               chk-doc.chk-date <= DateBuf-End AND
     3789               chk-doc.out-code <> ?  NO-LOCK :
     3790             if chk-doc.cashier-psn-code <> ? then NEXT.
     3791             if lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next .
     3792             if chk-doc.netto >= 0 then do:
     3793               assign
     3794               v-out-totchk = v-out-totchk + 1
     3795               v-out-totsum = v-out-totsum + chk-doc.netto
     3796               .
     3797               if v-out-totchk modulo 20 = 0
     3798               AND v-out-totchk >= 20 then
     3799               run waitfram-show in this-procedure ( input substitute("Обработано чеков : &1",  v-out-totchk) ) .
     3800             end.
     3801             else do:
     3802               assign
     3803               v-ret-totchk = v-ret-totchk + 1
     3804               v-ret-totsum = v-ret-totsum + chk-doc.netto
     3805               .
     3806             end.
     3807             if ( ( chk-doc.netto < 0 ) AND
     3808                 can-find( first ub.chk-gds where
     3809                                 ub.chk-gds.doc-code = chk-doc.doc-code AND
     3810                                 ub.chk-gds.doc-qnty > 0 ) ) OR
     3811                     ( ( ub.chk-doc.netto > 0 ) AND
     3812                         can-find( first ub.chk-gds where
     3813                                         ub.chk-gds.doc-code = chk-doc.doc-code AND
     3814                                         ub.chk-gds.doc-qnty < 0 ) ) then do:
     3815               if ub.chk-doc.netto < 0 then  do:
     3816                 FOR EACH ub.chk-gds WHERE
     3817                         ub.chk-gds.doc-code = chk-doc.doc-code AND
     3818                         ub.chk-gds.doc-qnty > 0 NO-LOCK :
     3819                   assign
     3820                   v-ret-count = v-ret-count + 1
     3821                   v-ret-qnty = v-ret-qnty + abs(chk-gds.doc-qnty)
     3822                   v-ret-sum = v-ret-sum + abs(  chk-gds.price-base - chk-gds.discnt ) * chk-gds.doc-qnty
     3823                   .
     3824                 END .
     3825               end.
     3826               else do:
     3827                 FOR EACH chk-gds WHERE
     3828                           chk-gds.doc-code = chk-doc.doc-code AND
     3829                           chk-gds.doc-qnty < 0 NO-LOCK :
     3830                   assign
     3831                   v-out-count = v-out-count + 1
     3832                   v-out-qnty = v-out-qnty + chk-gds.doc-qnty
     3833                   v-out-sum = v-out-sum + ( chk-gds.price-base - chk-gds.discnt ) * chk-gds.doc-qnty
     3834                   .
     3835                 END .
     3836               end.
     3837             end.
     3838         END .
     3839         assign
     3840         cshr-month.out-totchk = v-out-totchk
     3841         cshr-month.out-totsum = v-out-totsum
     3842         cshr-month.out-count  = v-out-count
     3843         cshr-month.out-qnty   = v-out-qnty
     3844         cshr-month.out-sum    = v-out-sum
     3845         cshr-month.ret-totchk = v-ret-totchk
     3846         cshr-month.ret-totsum = v-ret-totsum
     3847         cshr-month.ret-count  = v-ret-count
     3848         cshr-month.ret-qnty   = v-ret-qnty
     3849         cshr-month.ret-sum    = v-ret-sum
     3850         .
     3851       END.
     3852     end.
     3853     if StartDate-Psn = ? then .
     3854     else do:
     3855       assign
     3856       DateBuf-Start = StartDate-PSN
     3857       StartMonth-PSN = month( StartDate-PSN )
     3858       StartYear-PSN = year( StartDate-PSN )
     3859       .
     3860       DO WHILE DateBuf-Start < v-today  :
     3861         run gbl/lastday.p ( input DateBuf-Start, output EndDay_ ) .
     3862         assign
     3863         DateBuf-End = date( StartMonth-PSN, EndDay_ , StartYear-PSN )
     3864         .
     3865     shop-cycle:
     3866         FOR EACH shop_cli NO-LOCK WHERE
     3867                  shop_cli.obj-type = 'маг':U
     3868              AND shop_cli.db-num = v-cntxt-db-num:
     3869           _chk-doc:
     3870           FOR EACH chk-doc NO-LOCK WHERE
     3871                     chk-doc.obj-type = 'маг':U AND
     3872                     chk-doc.obj-code = shop_cli.obj-code AND
     3873                     chk-doc.cashier = X_staff.staff-code AND
     3874                     chk-doc.chk-date >= DateBuf-Start AND
     3875                     chk-doc.chk-date <= DateBuf-End AND
     3876                     chk-doc.out-code <> ?:
     3877             if lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     3878             if chk-doc.cashier-psn-code <> X_person.psn-code then NEXT _chk-doc.
     3879             if ( NOT can-find( cshr-month WHERE
     3880                               cshr-month.cshr-code = X_staff.staff-code AND
     3881                               cshr-month.cashier-psn-code = X_person.psn-code AND
     3882                               cshr-month.obj-type = 'маг':U and
     3883                               cshr-month.obj-code = shop_cli.obj-code AND
     3884                               cshr-month.year_ = StartYear-PSN AND
     3885                               cshr-month.month_ = StartMonth-PSN ) ) then do:
     3886               CREATE cshr-month .
     3887               assign
     3888               cshr-month.cshr-code = X_staff.staff-code
     3889               cshr-month.year_ = year( chk-doc.chk-date )
     3890               cshr-month.month_ = month( chk-doc.chk-date )
     3891               cshr-month.cashier-psn-code = X_person.psn-code
     3892               cshr-month.obj-type = 'маг':U
     3893               cshr-month.obj-code = shop_cli.obj-code
     3894               .
     3895               NEXT shop-cycle.
     3896             END.
     3897           end.
     3898         END.
     3899         if month( DateBuf-Start ) < 12 then do:
     3900           assign
     3901           StartMonth-PSN = month( DateBuf-Start ) + 1
     3902           StartYear-PSN = year( DateBuf-Start )
     3903           .
     3904         end.
     3905         else do:
     3906           assign
     3907           StartMonth-PSN = 1
     3908           StartYear-PSN = year( DateBuf-Start ) + 1
     3909           .
     3910         end.
     3911         DateBuf-Start = date( StartMonth-PSN, 1, StartYear-PSN ) .
     3912       END .
     3913       assign
     3914       StartMonth-PSN = month( StartDate-PSN )
     3915       StartYear-PSN = year( StartDate-PSN )
     3916       .
     3917       FOR EACH cshr-month WHERE
     3918               cshr-month.cshr-code = X_staff.staff-code AND
     3919               cshr-month.cashier-psn-code = X_person.psn-code AND
     3920               ( ( cshr-month.year_ = StartYear-pSN ) AND
     3921                 ( cshr-month.month_ >= StartMonth-PSN )
     3922               OR ( cshr-month.year_ > StartYear-PSN ) ) :
     3923         assign
     3924         DateBuf-Start = date( cshr-month.month_ , 1, cshr-month.year_ )
     3925         .
     3926         run gbl/lastday.p ( input DateBuf-Start, output EndDay_ ) .
     3927         assign
     3928         DateBuf-End = date( cshr-month.month_ , EndDay_ , cshr-month.year_ ) .
     3929         assign
     3930         v-out-totchk  = 0
     3931         v-out-totsum  = 0
     3932         v-out-count   = 0
     3933         v-out-qnty    = 0
     3934         v-out-sum     = 0
     3935         v-ret-totchk  = 0
     3936         v-ret-totsum  = 0
     3937         v-ret-count   = 0
     3938         v-ret-qnty    = 0
     3939         v-ret-sum     = 0
     3940         .
     3941         FOR  EACH chk-doc WHERE
     3942             chk-doc.obj-type = cshr-month.obj-type AND
     3943             chk-doc.obj-code = cshr-month.obj-code AND
     3944             chk-doc.cashier = X_staff.staff-code AND
     3945             chk-doc.chk-date >= DateBuf-Start AND
     3946             chk-doc.chk-date <= DateBuf-End AND
     3947             chk-doc.out-code <> ?  NO-LOCK :
     3948           if lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next.
     3949           if chk-doc.cashier-psn-code <> X_person.psn-code then NEXT.
     3950           if chk-doc.netto > 0 then do:
     3951             assign
     3952             v-out-totchk = v-out-totchk + 1
     3953             v-out-totsum = v-out-totsum + chk-doc.netto
     3954             .
     3955             if v-out-totchk modulo 20  = 0
     3956             and v-out-totchk >= 20 then
     3957             run waitfram-show in this-procedure ( input substitute("Обработано чеков : &1",  v-out-totchk ) ) .
     3958           end.
     3959           else do:
     3960             assign
     3961             v-ret-totchk = v-ret-totchk + 1
     3962             v-ret-totsum = v-ret-totsum + chk-doc.netto
     3963             .
     3964           end.
     3965           if ( ( chk-doc.netto < 0 ) AND
     3966               can-find( first chk-gds where
     3967                               chk-gds.doc-code = chk-doc.doc-code AND
     3968                               chk-gds.doc-qnty > 0 ) ) OR
     3969                   ( ( chk-doc.netto > 0 ) AND
     3970                       can-find( first chk-gds where
     3971                                       chk-gds.doc-code = chk-doc.doc-code AND
     3972                                       chk-gds.doc-qnty < 0 ) ) then do:
     3973             if chk-doc.netto < 0 then  do:
     3974               FOR EACH chk-gds WHERE
     3975                       chk-gds.doc-code = chk-doc.doc-code AND
     3976                       chk-gds.doc-qnty > 0 NO-LOCK :
     3977                 assign
     3978                 v-ret-count = v-ret-count +  1
     3979                 v-ret-qnty = v-ret-qnty + abs( chk-gds.doc-qnty )
     3980                 v-ret-sum = v-ret-sum + abs( ( chk-gds.price-base - chk-gds.discnt ) * chk-gds.doc-qnty )
     3981                 .
     3982               END .
     3983             end.
     3984             else do:
     3985               FOR EACH chk-gds WHERE
     3986                         chk-gds.doc-code = chk-doc.doc-code AND
     3987                         chk-gds.doc-qnty < 0 NO-LOCK :
     3988                 assign
     3989                 v-out-count = v-out-count + 1
     3990                 v-out-qnty = v-out-qnty +  chk-gds.doc-qnty
     3991                 v-out-sum = v-out-sum   + ( chk-gds.price-base - chk-gds.discnt ) * chk-gds.doc-qnty
     3992                 .
     3993               END .
     3994             end.
     3995           end.
     3996           assign
     3997           cshr-month.out-totchk = v-out-totchk
     3998           cshr-month.out-totsum = v-out-totsum
     3999           cshr-month.out-count  = v-out-count
     4000           cshr-month.out-qnty   = v-out-qnty
     4001           cshr-month.out-sum    = v-out-sum
     4002           cshr-month.ret-totchk = v-ret-totchk
     4003           cshr-month.ret-totsum = v-ret-totsum
     4004           cshr-month.ret-count  = v-ret-count
     4005           cshr-month.ret-qnty   = v-ret-qnty
     4006           cshr-month.ret-sum    = v-ret-sum
     4007           .
     4008         END .
     4009       END.
     4010     END.
     4011   END.
     4012   run waitfram-hide in this-procedure .
     4013   return "1" .
     4014   END PROCEDURE.
     4015   PROCEDURE disable_UI :
     4016     HIDE FRAME d-sel.
     4017   END PROCEDURE.
     4018   PROCEDURE enable_UI :
     4019   define buffer buf_db for ub.db.
     4020   ASSIGN
     4021   br-staff:NUM-LOCKED-COLUMNS IN FRAME d-sel = 2
     4022   X_staff.staff-code:read-only in browse br-staff = yes
     4023   .
     4024   ASSIGN
     4025   b-add:MENU-MOUSE = 1
     4026   b-chg:MENU-MOUSE = 1
     4027   b-del:MENU-MOUSE = 1
     4028   f-db-num = p-db-num
     4029   .
     4030   find first buf_db no-lock where buf_db.db-num = v-cntxt-db-num.
     4031   ASSIGN
     4032   v-tab-order = "b-exit,b-mark,b-add,b-sel,b-lkp,b-chg,b-del,b-hist,b-print,b-help,f-db-num," +
     4033                 "rs-status,b-arch,b-sch,f-db-num,f-staff-code" .
     4034   ENABLE
     4035   br-staff
     4036   b-quit
     4037   b-qrCode when p-role = 'C':U
     4038   b-mark WHEN lookup( "b-mark", bttns) > 0
     4039   b-sel  WHEN lookup( "b-sel", bttns) > 0
     4040   b-print
     4041   b-hist
     4042   b-help
     4043   b-add WHEN lookup( "b-add", bttns) > 0
     4044   b-del WHEN lookup( "b-add", bttns) > 0
     4045   b-chg WHEN lookup( "b-add", bttns) > 0
     4046   b-sch
     4047   b-lkp
     4048   f-db-num WHEN v-cntxt-db-num = 0
     4049   f-staff-code
     4050   RS-status
     4051   b-arch when p-role = 'C':U
     4052   WITH FRAME d-sel .
     4053   disable b-qrCode  WHEN lookup( "b-sel", bttns) > 0 with frame d-sel .
     4054   if p-role <> 'C':U then
     4055   hide b-qrCode in frame d-sel .
     4056   assign
     4057   MENU-ITEM m-add-new:sensitive in menu menu-add = (lookup( "b-add", bttns) > 0  and buf_db.add-clients)
     4058   MENU-ITEM m_psn:sensitive in menu menu-b-chg = (lookup( "b-add", bttns) > 0  and buf_db.add-clients)
     4059   MENU-ITEM m_client:sensitive in menu menu-b-del = (lookup( "b-add", bttns) > 0  and buf_db.add-clients)
     4060   .
     4061   CASE p-role:
     4062     when 'C':U then do.
     4063       title0 = "КАССИРЫ".
     4064     end.
     4065     when 'S':U then do.
     4066       title0 = "ПРОДАВЦЫ".
     4067     end.
     4068   END CASE.
     4069   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U).
     4070   IF NOT (v-cntxt-db-num = 0 AND p-db-num = ?)THEN DO:
     4071       HIDE
     4072       f-db-num
     4073       IN FRAME d-sel.
     4074   END.
     4075   else do:
     4076     display
     4077     f-db-num
     4078     with frame d-sel .
     4079   end.
     4080   Run OpenBr in this-procedure ( INPUT yes, INPUT no, INPUT '':U)  .
     4081   if available X_staff
     4082   then log-res = br-staff:select-focused-row( ).
     4083   APPLY "ENTRY" to br-staff.
     4084   END PROCEDURE.
     4085   PROCEDURE OpenBr :
     4086   define input  parameter p-open-query     as logical   no-undo .
     4087   define input  parameter p-find-next      as logical   no-undo .
     4088   define input  parameter p-find-condition as character no-undo .
     4089   define variable l-query-was-opened as logical no-undo .
     4090   define variable title0 as character no-undo.
     4091   define variable v-stts as integer no-undo .
     4092   define variable p-user-name as character no-undo .
     4093   DEFINE VARIABLE v-today as date no-undo .
     4094   DEFINE VARIABLE v-time as integer no-undo .
     4095   title0 = substitute("Список персонала").
     4096   run waitfram-show in this-procedure ("Ждите...").
     4097   def var sort-column-phrase as character no-undo .
     4098   case sort-column-name :
     4099     when "" then do:
     4100       assign
     4101         sort-column-phrase = ""
     4102       .
     4103     end.
     4104     otherwise do:
     4105       assign
     4106         sort-column-phrase = "by " + sort-column-name
     4107       .
     4108     end.
     4109   end case.
     4110   define variable l-open-query as logical   no-undo .
     4111    ASSIGN
     4112    frame d-sel:TITLE = title0.
     4113   if v-db-num = ? then do:
     4114   if p-open-query then do:
     4115    assign
     4116    frame d-sel:title = substitute("&1 &2 &3 &4"
     4117                                                  , title0
     4118                                                  , entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
     4119                                                  , (IF rs-status = 0 THEN "Все" ELSE "Текущие")
     4120                                                  , if p-psn-code= 0 then '':U else ('чел':U + string(p-psn-code))).
     4121   end.
     4122     IF p-psn-code = 0 THEN DO:
     4123       IF rs-status = 0  THEN DO:
     4124   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4125   define variable  l-disable-where-34  as logical   no-undo .
     4126   define variable  l-filter-open-34    as logical   .
     4127   define variable  flt-rec-34       as recid     no-undo .
     4128   define variable  filter-name-34      as character no-undo .
     4129   define variable  where-phrase-34     as character no-undo .
     4130   define variable  sort-phrase-34      as character no-undo .
     4131   define variable  where-phrase-rus-34 as character no-undo .
     4132   define variable  sort-phrase-rus-34  as character no-undo .
     4133     run waitfram-show in this-procedure
     4134       (input "ЖДИТЕ ..."
     4135       ).
     4136   run gbl/flt-get.p
     4137     (input filter-point
     4138     ,output flt-rec-34
     4139     ,output filter-name-34
     4140     ,output where-phrase-34
     4141     ,output sort-phrase-34
     4142     ,output where-phrase-rus-34
     4143     ,output sort-phrase-rus-34
     4144     ).
     4145   if p-open-query then do:
     4146       run set-filter-name in this-procedure
     4147         (INPUT filter-name-34
     4148         ) no-error .
     4149     assign
     4150       l-filter-open-34 = false
     4151     .
     4152     if flt-rec-34 <> ?
     4153       or sort-column-phrase > ""
     4154     then do:
     4155       define variable  parameter-2-34 as character no-undo .
     4156       define variable  parameter-3-34 as character no-undo .
     4157       define variable  parameter-4-34 as character no-undo .
     4158       define variable  parameter-5-34 as character no-undo .
     4159       define variable  parameter-6-34 as character no-undo .
     4160       define variable  parameter-7-34 as character no-undo .
     4161         assign
     4162         parameter-3-34 =
     4163                                 "FOR EACH X_staff no-lock"
     4164         parameter-4-34 =
     4165           (
     4166             if (" X_staff.role = p-role " + " " + where-phrase-34) <> ""
     4167             then  substitute('X_staff.role = &1&2&1', chr(34), p-role ) + " " + where-phrase-34
     4168             else "true"
     4169           )
     4170         parameter-5-34 = (" " + "" + " " + ", first X_person NO-LOCK WHERE X_person.psn-code = X_staff.psn-code, first X_clients NO-LOCK WHERE X_clients.obj-type = 'чел':U         AND X_clients.obj-code = X_staff.psn-code")
     4171         parameter-6-34 = if sort-phrase-34 = ''
     4172                              then
     4173           (
     4174           " " + "  " +
     4175             " " + sort-column-phrase +
     4176           " " + " BY X_staff.staff-code "
     4177           )
     4178                              else
     4179           (
     4180           " " + "  " +
     4181             " " + sort-column-phrase +
     4182           " " + sort-phrase-34
     4183           )
     4184         parameter-7-34 =
     4185           " indexed-reposition  "
     4186       .
     4187       do
     4188       on stop undo, leave
     4189       on error undo, leave
     4190       :
     4191         assign
     4192           l-disable-where-34 =
     4193             (" X_staff.role = p-role " + " " + where-phrase-34 = "")
     4194         .
     4195         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4196                             ,input QUERY br-staff:handle
     4197                             ,input parameter-3-34
     4198                             ,input parameter-4-34
     4199                             ,input parameter-5-34
     4200                             ,input parameter-6-34
     4201                             ,input parameter-7-34
     4202                             )
     4203         .
     4204         assign
     4205           l-filter-open-34 = true
     4206         .
     4207       end.
     4208       if l-filter-open-34 = false then do:
     4209         message
     4210           "Ошибка при фильтрации / сортировке" skip
     4211           "Будут показаны записи без учета фильтра" skip
     4212           view-as alert-box .
     4213       end.
     4214       else do:
     4215           assign
     4216             l-query-was-opened = true
     4217           .
     4218       end.
     4219     end.
     4220     if l-filter-open-34 = false then do:
     4221       OPEN QUERY br-staff FOR EACH X_staff no-lock
     4222         where  X_staff.role = p-role
     4223       , first X_person NO-LOCK WHERE X_person.psn-code = X_staff.psn-code, first X_clients NO-LOCK WHERE X_clients.obj-type = 'чел':U         AND X_clients.obj-code = X_staff.psn-code
     4224          BY X_staff.staff-code
     4225         indexed-reposition
     4226     .
     4227         assign
     4228           l-query-was-opened = true
     4229         .
     4230     end.
     4231   end.
     4232   else do:
     4233     assign
     4234       v-doc-rec = recid( X_staff )
     4235     .
     4236     do
     4237     on stop undo, leave
     4238     on error undo, leave
     4239     :
     4240       if QUERY br-staff:handle:get-buffer-handle(1) = (buffer X_staff:handle) then do:
     4241         assign
     4242         parameter-2-34 = (if p-find-next then "true":u else "false":u )
     4243         parameter-4-34 =
     4244           "where ":u +  substitute('X_staff.role = &1&2&1', chr(34), p-role ) + " ":u + where-phrase-34 + " ":u + p-find-condition + " " + ""
     4245         parameter-5-34 = "  "
