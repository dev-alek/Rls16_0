      399   procedure prn-lib-open-stream :
      400     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      401     define input parameter p-page-size    as integer no-undo .
      402     define input parameter p-is-stream    as logical no-undo .
      403     define input parameter p-append       as logical no-undo .
      404     define variable v-report-name as character no-undo .
      405     do
      406       on error undo, return error
      407       :
      408       run prn-lib-get-report-name  in this-procedure (
      409         input parParentProc
      410         ,output v-report-name
      411         ).
      412       if p-is-stream then
      413       do:
      414         if p-append then
      415         do:
      416           output stream PrnLibStream to value( v-report-name )
      417             page-size value(p-page-size) append .
      418         end.
      419         if not p-append then
      420         do:
      421           output stream PrnLibStream to value( v-report-name )
      422             page-size value(p-page-size) .
      423         end.
      424       end.
      425       if not p-is-stream then
      426       do:
      427         if p-append then
      428         do:
      429           output to value( v-report-name )
      430             page-size value(p-page-size) append .
      431         end.
      432         if not p-append then
      433         do:
      434           output to value( v-report-name )
      435             page-size value(p-page-size) .
      436         end.
      437       end.
      438     end.
      439   end procedure.
      440   procedure prn-lib-open-exp :
      441     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      442     define input parameter p-is-stream    as logical no-undo .
      443     define input parameter p-is-append    as logical no-undo .
      444     define output parameter p-ReportFileName as char init "report" no-undo.
      445     define output parameter p-process as logical no-undo .
      446     define variable glog as logical no-undo .
      447     do
      448       on error undo, return error
      449       :
      450       SYSTEM-DIALOG GET-FILE p-ReportFileName
      451         TITLE      "Укажите путь"
      452         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      453         ASK-OVERWRITE
      454         CREATE-TEST-FILE
      455         SAVE-AS
      456         USE-FILENAME
      457         DEFAULT-EXTENSION "txt"
      458         UPDATE glog
      459         .
      460       if not glog then  return.
      461       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      462       if p-is-stream then
      463       do:
      464         if p-is-append then
      465         do:
      466           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      467         end.
      468         else
      469         do:
      470           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      471         end.
      472       end.
      473       else
      474       do:
      475         if p-is-append then
      476         do:
      477           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      478         end.
      479         else
      480         do:
      481           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      482         end.
      483       end.
      484       p-process = yes.
      485     end.
      486   end procedure.
      487   procedure prn-lib-get-report-name :
      488     define input parameter parParentProc  as widget-handle no-undo.
      489     define output parameter p-report-name as character no-undo .
      490     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      491   end procedure.
      492   procedure prn-lib-reportviewer-report-name :
      493     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      494     define input parameter p-report-name-html as character no-undo .
      495     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      496   end procedure.
      497   procedure prn-lib-reportviewer :
      498     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      499     define input parameter p-report-name-html as character no-undo .
      500     define input parameter p-param        as character no-undo .
      501     define variable v-excel           as character no-undo init 'TRUE' .
      502     define variable v-value-character as character no-undo .
      503     define variable v-value-integer   as character no-undo .
      504     define variable v-value-date      as date      no-undo .
      505     define variable v-value-decimal   as decimal   no-undo .
      506     define variable rep-excel         as logical   no-undo .
      507     define variable excel-string      as character no-undo .
      508     define variable v-param-type      as character no-undo .
      509     define variable v-tth             as handle    no-undo .
      510     run adm/shattri.p (
      511       input "get":U
      512       ,input  ""
      513       ,input  0
      514       ,input  'report-glob':U
      515       ,input  'rep-excel':U
      516       ,output v-value-character
      517       ,output v-value-date
      518       ,output v-value-decimal
      519       ,output v-value-integer
      520       ,output rep-excel
      521       ,output v-param-type
      522       ,INPUT-OUTPUT table-handle v-tth
      523       )  .
      524     if rep-excel then v-excel = "TRUE" .
      525     else v-excel = "FALSE" .
      526     if p-param eq ""
      527     then
      528        p-param = "EXCEL:" + v-excel.
      529     else
      530        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      531     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      532   end procedure.
