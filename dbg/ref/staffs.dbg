      362       on error undo, return error
      363       :
      364       run prn-lib-get-report-name  in this-procedure (
      365         input parParentProc
      366         ,output v-report-name
      367         ).
      368   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      370     (input  v-report-name
      371     ,input  2
      372     ,output v-exist
      373     )  .
      374       if NOT v-exist then
      375       DO:
      376         Message
      377           "Нет заданий на печать ! "
      378           view-as alert-box .
      379         Return  .
      380       End.
      381       run gbl/prnfilen.w
      382         (input  ""
      383         ,input  p-DisabledOptions
      384         ,input  string(v-report-name )
      385         ,input  7
      386         ,output v-user-action
      387         ,output v-printed
      388         ) .
      389       if v-printed then
      390       do:
      391         return "YES" .
      392       end.
      393       else
      394       do:
      395         return "NO" .
      396       end.
      397     end.
