     5073     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5074     REPOSITION br-vardeliv to recid loc-doc-rec No-error.
     5075     if error-status:error then do:                           find first pos_var-deliv-gr-per-val no-lock where                                   recid(pos_var-deliv-gr-per-val) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ВАРИАНТ ДОСТАВКИ ПО ГРУППАМ СРОКОВ ГОДНОСТИ" skip                            string(if avail pos_var-deliv-gr-per-val                                     then  substitute("Вн код типа доставки: &1 вн код субъекта доставки: &2 объект доставки: &3&4 вн уод группы сроков годности &5"                                                     , pos_var-deliv-gr-per-val.deliv-type-code                                                     , pos_var-deliv-gr-per-val.deliv-subj-code                                                     , pos_var-deliv-gr-per-val.obj-type                                                     , pos_var-deliv-gr-per-val.obj-code                                                     , pos_var-deliv-gr-per-val.gr-per-val-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     5076     if available X_var-deliv-gr-per-val then do:
     5077       loc#log = br-vardeliv:select-focused-row( ) IN FRAME Dialog-Frame.
     5078     end.
     5079     apply "ENTRY" to br-vardeliv.
     5080   end.
     5081   END PROCEDURE.
     5082   PROCEDURE proc-b-print :
     5083   define variable v-doc-rec as recid no-undo .
     5084   define variable accum-count as integer.
     5085   define variable date_string     as      char    no-undo.
     5086   define variable Line            as      char    no-undo.
     5087   DEFINE VARIABLE v-sts-chr AS CHARACTER NO-UNDO.
     5088   define variable v-deliv-type-name like ub.delivery-type.deliv-type-name no-undo .
     5089   define variable v-deliv-subj-name like ub.delivery-subject.deliv-subj-name no-undo .
     5090   define variable v-obj as character no-undo .
     5091   DEFINE FRAME var-deliv-gr-per-val-list
     5092   v-sts-chr FORMAT "X(8)" COLUMN-LABEL "Статус"
     5093   X_var-deliv-gr-per-val.deliv-type-code COLUMN-LABEL "Вн.код!тип доставки"
     5094   v-deliv-type-name COLUmn-LABEL "Тип доставки" format "X(25)"
     5095   X_var-deliv-gr-per-val.deliv-subj-code COLUMN-LABEL "Вн.код!субъекта!доставки"
     5096   v-deliv-subj-name COLUmn-LABEL "Субъект доставки" format "X(25)"
     5097   v-obj COLUMn-LABEL "Объект!доставки" format "X(8)"
     5098   X_var-deliv-gr-per-val.des FORMAT "X(100)"
     5099   HEADER  date_string AT 5 format "X(35)"
     5100    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5101   Line format "X(195)" AT 1
     5102   with width 232 down stream-io use-text    .
     5103   Line = fill("-", 195).
     5104   date_string = cur-time-print() .
     5105   run prn-lib-open-stream  in this-procedure (
     5106                                                input parParentProc
     5107                                               ,input 43
     5108                                               ,input yes
     5109                                               ,input no
     5110                                               ).
     5111   PUT  STREAM PrnLibStream
     5112   SPACE(25) ( frame Dialog-Frame:title )
     5113   format "x(90)" SKIP(1) .
     5114   FORM HEADER
     5115   Line format "X(195)" AT 1 SKIP
     5116   "Продолжение - на следующей странице" AT 30 SKIP
     5117   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5118   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5119   FORM with FRAME var-deliv-gr-per-val-list  .
     5120   run waitfram-show in this-procedure ("Ждите...").
     5121   v-doc-rec = recid(X_var-deliv-gr-per-val).
     5122   DO WHILE available X_var-deliv-gr-per-val :
     5123     GET prev br-vardeliv.
     5124   END.
     5125   GET next br-vardeliv.
     5126   DO WHILE available X_var-deliv-gr-per-val :
     5127     Display STREAM PrnLibStream
     5128     entry (lookup (STRING(p-sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) @ v-sts-chr
     5129     X_var-deliv-gr-per-val.deliv-type-code
     5130     get-type(X_var-deliv-gr-per-val.deliv-type-code) @ v-deliv-type-name
     5131     X_var-deliv-gr-per-val.deliv-subj-code
     5132     get-subject(X_var-deliv-gr-per-val.deliv-subj-code) @ v-deliv-subj-name
     5133     (X_var-deliv-gr-per-val.obj-type + string(X_var-deliv-gr-per-val.obj-code)) @ v-obj
     5134     X_var-deliv-gr-per-val.des
     5135     with FRAME var-deliv-gr-per-val-list .
     5136     DOWN STREAM PrnLibStream 1
     5137     with FRAME var-deliv-gr-per-val-list  .
     5138     assign
     5139     accum-count = accum-count + 1
     5140     .
     5141     GET next br-vardeliv.
     5142   END.
     5143   UNDERLINE  STREAM PrnLibStream
     5144   v-sts-chr
     5145   X_var-deliv-gr-per-val.deliv-type-code
     5146   v-deliv-type-name
     5147   X_var-deliv-gr-per-val.deliv-subj-code
     5148   v-deliv-subj-name
     5149   v-obj
     5150   X_var-deliv-gr-per-val.des
     5151   with FRAME var-deliv-gr-per-val-list .
     5152   DISPLAY STREAM PrnLibStream
     5153   accum-count @ v-sts-chr
     5154   with frame var-deliv-gr-per-val-list.
     5155   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5156   HIDE  STREAM PrnLibStream FRAME var-deliv-gr-per-val-List.
     5157   output  STREAM PrnLibStream CLOSE.
     5158   REPOSITION br-vardeliv to recid v-doc-rec no-error.
     5159   APPLY "entry" to br-vardeliv.
     5160   run waitfram-hide in this-procedure .
     5161   run prn-lib-prn-file in this-procedure (
     5162                                             input parParentProc
     5163                                             ,input 8
     5164                                             ).
     5165   END PROCEDURE.
     5166   PROCEDURE proc-b-sch :
     5167   assign
     5168     tbl = 'var-deliv-gr-per-val'
     5169     join-tbl = 'X_var-deliv-gr-per-val'
     5170     fld = ""
     5171     lab = ""
     5172     spr = ""
     5173     dim = '0'
     5174     .
     5175   run fltfield-add in this-procedure('deliv-type-code', 'Код типа доставки', '',
     5176   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5177   run fltfield-add in this-procedure('delive-subj-code', 'Код субъекта доставки', '',
     5178   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5179   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект доставки', 'cli',
     5180   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5181   run fltfield-add in this-procedure('des', 'Описание', '',
     5182   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5183   run fltfield-add in this-procedure('sts', 'Статус', '',
     5184   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5185   Filter-Block:
     5186   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5187       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5188       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5189     run gbl/filter.w ( INPUT parparentproc
     5190                      , INPUT (filter-point + chr(4) + filter-label)
     5191                      , INPUT tbl
     5192                      , INPUT join-tbl
     5193                      , INPUT fld
     5194                      , INPUT lab
     5195                      , INPUT spr
     5196                      , INPUT dim ).
     5197     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5198   END.
     5199   END PROCEDURE.
     5200   PROCEDURE proc-br-vardeliv :
     5201   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5202   if b-sel:sensitive in frame Dialog-Frame then dO:
     5203       if b-mark:sensitive then do:
     5204           apply "choose" to b-mark in frame Dialog-Frame.
     5205       end.
     5206       else do:
     5207           apply "choose" to b-sel in frame Dialog-Frame.
     5208       end.
     5209   end.
     5210   else do:
     5211       if b-lkp:sensitive then
     5212       apply "choose" to b-lkp in frame Dialog-Frame.
     5213   end.
     5214   END PROCEDURE.
     5215   FUNCTION get-gr-per-val RETURNS CHARACTER
     5216     ( INPUT p-gr-per-val-code AS integer, OUTPUT p-gr-per-from AS INTEGER, OUTPUT p-gr-per-to AS INTEGER ) :
     5217   DEFINE BUFFER loc_group-period-validity FOR ub.group-period-validity.
     5218   FIND FIRST loc_group-period-validity NO-LOCK WHERE
     5219             loc_group-period-validity.gr-per-val-code = p-gr-per-val-code NO-ERROR.
     5220   IF NOT AVAILABLE loc_group-period-validity THEN dO:
     5221       ASSIGN
     5222       p-gr-per-from = ?
     5223       p-gr-per-to = ?
     5224       .
     5225       RETURN loc_group-period-validity.gr-per-val-name.
     5226   END.
     5227   ASSIGN
     5228       p-gr-per-from = loc_group-period-validity.gr-per-from
     5229       p-gr-per-to = loc_group-period-validity.gr-per-to
     5230       .
     5231     RETURN "Неизв.группа сроков годности".
     5232   END FUNCTION.
     5233   FUNCTION get-subject RETURNS CHARACTER
     5234     ( INPUT p-deliv-subj-code AS INTEGER) :
     5235   DEFINE BUFFER loc_delivery-subject FOR ub.delivery-subject.
     5236   FIND FIRST loc_delivery-subject NO-LOCK WHERE
     5237             loc_delivery-subject.deliv-subj-code = p-deliv-subj-code NO-ERROR.
     5238   IF AVAILABLE loc_delivery-subject THEN RETURN loc_delivery-subject.deliv-subj-name.
     5239     RETURN "Неизв.субъект доставки".
     5240   END FUNCTION.
     5241   FUNCTION get-term-delivery RETURNS INTEGER
     5242     ( INPUT p-deliv-type-code AS INTEGER,
     5243       INPUT p-deliv-subj-code AS INTEGER,
     5244       INPUT p-deliv-obj-type AS CHARACTER,
     5245       INPUT p-deliv-obj-code AS INTEGER) :
     5246   DEFINE BUFFER loc_variant-delivery  FOR ub.variant-delivery.
     5247   FIND FIRST loc_variant-delivery NO-LOCK WHERE
     5248               loc_variant-delivery.deliv-type-code = p-deliv-type-code
     5249           AND loc_variant-delivery.deliv-subj-code = p-deliv-subj-code
     5250           AND loc_variant-delivery.obj-type = p-deliv-obj-type
     5251           AND loc_variant-delivery.obj-code = p-deliv-obj-code NO-ERROR.
     5252    IF NOT AVAILABLE loc_variant-delivery THEN DO:
     5253        RETURN ?.
     5254    END.
     5255     RETURN loc_variant-delivery.term-delivery.
     5256   END FUNCTION.
     5257   FUNCTION get-type RETURNS CHARACTER
     5258   ( INPUT p-deliv-type-code AS INTEGER) :
     5259   DEFINE BUFFER loc_delivery-type FOR ub.delivery-type.
     5260   FIND FIRST loc_delivery-type NO-LOCK WHERE
     5261             loc_delivery-type.deliv-type-code = p-deliv-type-code NO-ERROR.
     5262   IF AVAILABLE loc_delivery-type THEN RETURN loc_delivery-type.deliv-type-name.
     5263     RETURN "Неизв.тип доставки".
     5264   END FUNCTION.
