       17   define input parameter p-gr-per-val-code  LIKE ub.var-deliv-gr-per-val.gr-per-val-code no-undo .
       18   define input-output parameter p-sts as integer no-undo .
       19   define input-output parameter p-rid-list    as  char no-undo .
       20   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       21   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       22   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       23   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
