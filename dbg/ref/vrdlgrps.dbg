     3030   PROCEDURE disable_UI :
     3031     HIDE FRAME Dialog-Frame.
     3032   END PROCEDURE.
     3033   PROCEDURE enable_UI :
     3034     DISPLAY RS-sts mark-num
     3035         WITH FRAME Dialog-Frame.
     3036     ENABLE b-quit B-mark B-sel B-add b-lkp B-chg B-del B-print B-hist B-sch
     3037            B-Help RS-sts br-vardeliv mark-num
     3038         WITH FRAME Dialog-Frame.
     3039     VIEW FRAME Dialog-Frame.
     3040     OPEN QUERY br-vardeliv FOR EACH X_var-deliv-gr-per-val NO-LOCK INDEXED-REPOSITION.
     3041   END PROCEDURE.
     3042   PROCEDURE MyEnable :
     3043   ASSIGN
     3044   rs-sts:RADIO-BUTTONS IN FRAME Dialog-Frame
     3045                          = "Текущие&+" + chr(44) +  '0':U + chr(44) +
     3046                          "Все&!" + chr(44) + 'все':U + chr(44) +
     3047                           "Удаленные&-" + chr(44) + '1':U
     3048   rs-sts = (IF p-sts = ? THEN 'все':U ELSE string(p-sts))
     3049   .
     3050   DISPLAY mark-num
     3051   WITH FRAME Dialog-Frame.
     3052   ENABLE
     3053   b-quit
     3054   B-mark when LOOKUP("b-mark":U, bttns) > 0
     3055   B-sel when LOOKUP("b-mark":U, bttns) > 0
     3056   B-add when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     3057   b-lkp
     3058   B-chg when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     3059   B-del when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     3060   B-print
     3061   B-Help
     3062   B-hist
     3063   b-sch
     3064   br-vardeliv
     3065   mark-num
     3066   rs-sts
     3067   with FRAME Dialog-Frame.
     3068   VIEW FRAME Dialog-Frame.
     3069   END PROCEDURE.
     3070   PROCEDURE OpenBr :
     3071   define input  parameter p-open-query     as logical   no-undo .
     3072   define input  parameter p-find-next      as logical   no-undo .
     3073   define input  parameter p-find-condition as character no-undo .
     3074   define variable l-query-was-opened as logical no-undo .
     3075   define variable title0 as character no-undo.
     3076   title0 = "Список вариантов доставки по группам сроков годности" + chr(32).
     3077   run waitfram-show in this-procedure ("Ждите...").
     3078   define variable sort-column-phrase as character no-undo .
     3079   case sort-column-name :
     3080     when "" then do:
     3081       assign
     3082         sort-column-phrase = ""
     3083       .
     3084     end.
     3085     otherwise do:
     3086       assign
     3087         sort-column-phrase = "by " + sort-column-name
     3088       .
     3089     end.
     3090   end case.
     3091   define variable l-open-query as logical   no-undo .
     3092     CASE p-mode :
     3093       WHEN 'все':U        THEN DO:
     3094        assign
     3095        filter-point = filter-point0 + p-mode
     3096        filter-label = substitute("&1", filter-label0)
     3097        .
     3098        IF p-sts = ?  THEN DO:
     3099   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3100   define variable  l-disable-where-32  as logical   no-undo .
     3101   define variable  l-filter-open-32    as logical   .
     3102   define variable  flt-rec-32       as recid     no-undo .
     3103   define variable  filter-name-32      as character no-undo .
     3104   define variable  where-phrase-32     as character no-undo .
     3105   define variable  sort-phrase-32      as character no-undo .
     3106   define variable  where-phrase-rus-32 as character no-undo .
     3107   define variable  sort-phrase-rus-32  as character no-undo .
     3108     run waitfram-show in this-procedure
     3109       (input "ЖДИТЕ ..."
     3110       ).
     3111   run gbl/flt-get.p
     3112     (input filter-point
     3113     ,output flt-rec-32
     3114     ,output filter-name-32
