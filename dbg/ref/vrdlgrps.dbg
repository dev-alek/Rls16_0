     1306   END.
     1307   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1308   DO:
     1309     define variable loc#log as logical no-undo .
     1310     if available X_var-deliv-gr-per-val then do:
     1311   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1312   define variable v-str-recid14 as character no-undo .
     1313   define variable v-num-entry14 as integer   no-undo .
     1314   assign
     1315     v-str-recid14 = trim( string( recid( X_var-deliv-gr-per-val ) , "->>>>>>>>>>>9":U ) )
     1316     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1317   .
     1318   if v-num-entry14 > 0 then do:
     1319     assign
     1320       entry( v-num-entry14, v-rid-list ) = "":U
     1321       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1322     .
     1323   end.
     1324   else do:
     1325     assign
     1326       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1327     .
     1328   end.
     1329       loc#log = br-vardeliv:refresh() .
     1330       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1331           loc#log = br-vardeliv:select-next-row ().
     1332           apply "VALUE-CHANGED" to br-vardeliv in frame Dialog-Frame.
     1333       end.
     1334       if num-entries( v-rid-list ) = 0
     1335       then
     1336           hide mark-num in frame Dialog-Frame.
     1337       else
     1338           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1339     end.
     1340     apply "entry" to br-vardeliv in frame Dialog-Frame.
     1341   END.
     1342   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1343   DO:
     1344     run proc-b-print in this-procedure no-error.
     1345     if error-status:error then do:
     1346       return no-apply.
     1347     end.
     1348     APPLY "ENTRY" to br-vardeliv.
     1349   END.
     1350   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1351   DO:
