     1367     if error-status:error then return no-apply.
     1368   END.
     1369   ON VALUE-CHANGED OF RS-sts IN FRAME Dialog-Frame
     1370   DO:
     1371     ASSIGN
     1372     rs-sts
     1373     p-sts = (IF rs-sts = 'все':U THEN ? ELSE INTEGER(rs-sts))
     1374     .
     1375     RUN openbr IN THIS-PROCEDURE ( input YES, input NO, input '':U) NO-ERROR.
     1376     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1377   END.
     1378   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1379   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1380   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1381   on help of frame Dialog-Frame
     1382   do:
     1383     run gbl/app_help.p
     1384       (input this-procedure :file-name
     1385       ,input ''
     1386       ,input ?
     1387       ) no-error.
     1388     if error-status :error then do:
     1389       message
     1390         "Ошибка при вызове помощи"
     1391         error-status :get-message(1)
     1392         view-as alert-box .
     1393     end.
     1394   end.
     1395   run minbtn-set in this-procedure .
     1396   on choose of b-help in frame Dialog-Frame
     1397   do:
     1398     apply "help":u to frame Dialog-Frame .
     1399   end.
     1400   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1401   procedure minbtn-set :
     1402       do
     1403           on error undo, return error return-value
     1404           :
     1405           define variable ii              as integer       no-undo .
     1406           define variable fh              as widget-handle no-undo .
     1407           define variable hh              as widget-handle no-undo .
     1408           define variable v-h             as handle        extent 4 no-undo .
     1409           define variable v-name-button   as character     no-undo .
     1410           define variable v-help-old-x    as decimal       no-undo .
     1411           define variable v-help-old-y    as decimal       no-undo .
     1412           define variable v-help-old-size as decimal       no-undo .
     1413           define variable v-frame-width   as decimal       no-undo .
     1414           define variable jj              as integer       no-undo .
     1415           do
     1416               on error undo, return error
     1417               :
     1418               assign
     1419                   v-frame-width = frame Dialog-Frame:width - 0.3
     1420                   fh            = frame Dialog-Frame:first-child
     1421                   hh            = fh:first-child
     1422                   ii            = 1
     1423                   .
     1424               do while valid-handle(hh):
     1425                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1426                   do:
     1427                       case lc(hh:name) :
     1428                           when "b-help" then
     1429                               do:
     1430                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1431                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1432                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1433                                   hh:TOOLTIP = "Помощь" .
     1434                                   v-help-old-x = hh:column .
     1435                                   v-help-old-y = hh:row    .
     1436                                   v-help-old-size = hh:width .
     1437                                   hh:width-chars = 2.5 .
     1438                               end.
     1439                           when "b-print" then
     1440                               do:
     1441                                   hh:load-image("cmp/b-print.bmp":u) .
     1442                                   hh:TOOLTIP = "Печать" .
     1443                                   v-h[ii] = hh:handle .
     1444                                   ii = ii + 1 .
     1445                                   hh:width-chars = 3 .
     1446                               end.
     1447                           when "b-history" or
     1448                           when "b-hist" then
     1449                               do:
     1450                                   hh:load-image("cmp/b-hist.bmp":u) .
     1451                                   hh:TOOLTIP = "История" .
     1452                                   v-h[ii] = hh:handle .
     1453                                   ii = ii + 1 .
     1454                                   hh:width-chars = 3 .
     1455                               end.
     1456                           when "b-sch" then
     1457                               do:
     1458                                   hh:load-image("cmp/b-sch.bmp":u) .
     1459                                   hh:TOOLTIP = "Установка Фильтра" .
     1460                                   v-h[ii] = hh:handle .
     1461                                   ii = ii + 1 .
     1462                                   hh:width-chars = 3 .
     1463                               end.
     1464                           when "b-hist-user" then
     1465                               do:
     1466                                   hh:load-image("cmp/b-hist.bmp":u) .
     1467                                   hh:TOOLTIP = "История пользователя" .
     1468                                   ii = ii + 1 .
     1469                               end.
     1470                       end case.
     1471                   end.
     1472                   hh = hh:next-sibling.
     1473               end.
     1474               b-help:column = v-frame-width - b-help:width-chars.
     1475               jj = 0.
     1476               repeat ii = 4 to 1 by -1 :
     1477                   if valid-handle (v-h[ii] ) then
     1478                   do:
     1479                       jj  = jj + 1 .
     1480                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1481                       v-h[ii]:row    = v-help-old-y .
     1482                   end.
     1483               end.
     1484           end.
     1485       end.
     1486   end procedure.
     1487   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1488   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1489   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1490   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1491   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1492   define variable v-diasize-current-frame-height as decimal   no-undo .
     1493   define variable v-diasize-change-size          as logical   no-undo .
     1494   define variable v-diasize-resize-button        as handle    no-undo .
     1495   define variable v-diasize-wndmax               as logical   no-undo .
     1496   define variable v-diasize-wndstore             as logical   no-undo .
     1497   define variable v-diasize-proc-name            as character no-undo .
     1498   define variable v-diasize-browse-handle        as handle    no-undo .
     1499   define variable v-diasize-browse-number        as integer   no-undo .
     1500   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1501   define temp-table temp-diasize-handle no-undo
     1502     field handle-value  as handle
     1503     field save-position as decimal
     1504     index xpk is primary unique handle-value
     1505     .
     1506   define temp-table temp-browse-handle no-undo
     1507     field browse-type   as character
     1508     field browse-number as integer
     1509     field browse-handle as handle
     1510     field original-size as decimal
     1511     index xpk is primary unique browse-type browse-number
     1512     index xie browse-type browse-handle
     1513   .
     1514   procedure diasize_change-height :
     1515     define input  parameter p-change-value  as decimal   no-undo .
     1516     define input  parameter p-move-resize   as logical   no-undo .
     1517     define variable v-field-group-handle    as handle    no-undo .
     1518     define variable v-object-handle         as handle    no-undo .
     1519     define variable v-frame-height          as decimal   no-undo .
     1520     define variable v-frame-virtual-height  as decimal   no-undo .
     1521     define variable v-browse-height         as decimal   no-undo .
     1522     define variable v-window-height         as decimal   no-undo .
     1523     define variable v-window-virtual-height as decimal   no-undo .
     1524     define variable v-change-sign           as integer   no-undo .
     1525     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1526     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1527     if p-change-value > 0
     1528     then do:
     1529       if frame Dialog-Frame :height + p-change-value
     1530           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1531       then do:
     1532         assign
     1533           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1534                           - (frame Dialog-Frame :height-chars)
     1535         .
     1536         if p-change-value <= 0
     1537         then do:
     1538           run diasize_position-resize-button in this-procedure .
     1539           return .
     1540         end.
     1541       end.
     1542     end.
     1543     if p-change-value < 0
     1544     then do:
     1545       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1546       then do:
     1547         assign
     1548           p-change-value = v-diasize-orig-frame-height
     1549                          - (frame Dialog-Frame :height-chars)
     1550         .
     1551         if p-change-value >= 0
     1552         then do:
     1553           run diasize_position-resize-button in this-procedure .
     1554           return .
     1555         end.
     1556       end.
     1557     end.
     1558     if p-change-value >= 0
     1559     then do:
     1560       assign
     1561         v-change-sign = 1
     1562       .
     1563     end.
     1564     else do:
     1565       assign
     1566         v-change-sign = -1
     1567       .
     1568     end.
     1569     assign
     1570       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1571     .
     1572     if p-change-value = 0
     1573     then do:
     1574       run diasize_position-resize-button in this-procedure .
     1575       return .
     1576     end.
     1577     move_block:
     1578     do
     1579     on error undo move_block, retry move_block
     1580     :
     1581       if retry
     1582       then do:
     1583         do
     1584         on error undo move_block, leave move_block
     1585         :
     1586           if p-change-value > 0
     1587           then do:
     1588             for each buf_temp-diasize-handle
     1589             on error undo, next
     1590             :
     1591               assign
     1592                 v-object-handle = buf_temp-diasize-handle.handle-value
     1593               .
     1594               if v-object-handle <> v-diasize-resize-button
     1595               then do:
     1596                 assign
     1597                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1598                 .
     1599               end.
     1600             end.
     1601             assign
     1602               v-diasize-browse-handle :height = v-browse-height
     1603             .
     1604             for each buf_temp-browse-handle
     1605               where buf_temp-browse-handle.browse-type = 'height':u
     1606             on error undo, next
     1607             :
     1608               assign
     1609                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1610               .
     1611             end.
     1612             assign
     1613               frame Dialog-Frame :height = v-frame-height
     1614             .
     1615             if frame Dialog-Frame :scrollable = true
     1616             then do:
     1617               assign
     1618                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1619               .
     1620             end.
     1621             run diasize_position-resize-button in this-procedure .
     1622           end.
     1623           else do:
     1624             if frame Dialog-Frame :scrollable = true
     1625             then do:
     1626               assign
     1627                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1628               .
     1629             end.
     1630             assign
     1631               frame Dialog-Frame :height = v-frame-height
     1632             .
     1633             assign
     1634               v-diasize-browse-handle :height = v-browse-height
     1635             .
     1636             for each buf_temp-browse-handle
     1637               where buf_temp-browse-handle.browse-type = 'height':u
     1638             on error undo, next
     1639             :
     1640               assign
     1641                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1642               .
     1643             end.
     1644             for each buf_temp-diasize-handle
     1645             on error undo, next
     1646             :
     1647               assign
     1648                 v-object-handle = buf_temp-diasize-handle.handle-value
     1649               .
     1650               if v-object-handle <> v-diasize-resize-button
     1651               then do:
     1652                 assign
     1653                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1654                 .
     1655               end.
     1656             end.
     1657             run diasize_position-resize-button in this-procedure .
     1658           end.
     1659           assign
     1660             v-diasize-change-size = false
     1661           .
     1662           leave move_block .
     1663         end.
     1664       end.
     1665       assign
     1666         v-diasize-need-full-display = true
     1667       .
     1668       if v-diasize-change-size = false
     1669       then do:
     1670         assign
     1671           v-diasize-change-size = true
     1672         .
     1673       end.
     1674       else do:
     1675         return .
     1676       end.
     1677       assign
     1678         v-frame-height = frame Dialog-Frame :height
     1679         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1680         v-browse-height = v-diasize-browse-handle :height
     1681       .
     1682       for each buf_temp-browse-handle
     1683         where buf_temp-browse-handle.browse-type = 'height':u
     1684       :
     1685         assign
     1686           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1687         .
     1688       end.
     1689       for each buf_temp-diasize-handle
     1690       :
     1691         delete buf_temp-diasize-handle .
     1692       end.
     1693       assign
     1694         v-field-group-handle = frame Dialog-Frame :first-child
     1695       .
     1696       do while valid-handle(v-field-group-handle)
     1697       :
     1698         assign
     1699           v-object-handle = v-field-group-handle :first-child
     1700         .
     1701         do while valid-handle(v-object-handle)
     1702         :
     1703           if  v-object-handle <> v-diasize-browse-handle :handle
     1704           and can-query(v-object-handle, "row")
     1705           and can-query(v-object-handle, "height")
     1706           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1707           then do:
     1708             find first buf_temp-browse-handle
     1709               where buf_temp-browse-handle.browse-type   = 'height':u
     1710                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1711               no-error .
     1712             if available buf_temp-browse-handle
     1713             then do:
     1714             end.
     1715             else do:
     1716               create buf_temp-diasize-handle .
     1717               assign
     1718                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1719                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1720               .
     1721             end.
     1722           end.
     1723           assign
     1724             v-object-handle = v-object-handle :next-sibling
     1725           .
     1726         end.
     1727         assign
     1728           v-field-group-handle = v-field-group-handle :next-sibling
     1729         .
     1730       end.
     1731       do with frame Dialog-Frame
     1732       :
     1733         hide v-diasize-resize-button .
     1734         assign
     1735           v-diasize-resize-button :row    = 1
     1736           v-diasize-resize-button :column = 1
     1737         .
     1738       end.
     1739       if p-change-value > 0
     1740       then do:
     1741         if frame Dialog-Frame :scrollable = true
     1742         then do:
     1743           assign
     1744             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1745             no-error .
     1746           if error-status :error
     1747           or error-status :get-message(1) <> ""
     1748           then do:
     1749             undo move_block, retry move_block .
     1750           end.
     1751         end.
     1752         assign
     1753           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1754           no-error .
     1755         if error-status :error
     1756         or error-status :get-message(1) <> ""
     1757         then do:
     1758           undo move_block, retry move_block .
     1759         end.
     1760         assign
     1761           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1762           no-error .
     1763         if error-status :error
     1764         or error-status :get-message(1) <> ""
     1765         then do:
     1766           undo move_block, retry move_block .
     1767         end.
     1768         for each buf_temp-browse-handle
     1769           where buf_temp-browse-handle.browse-type = 'height':u
     1770         on error undo move_block, retry move_block
     1771         :
     1772           assign
     1773             buf_temp-browse-handle.browse-handle :height
     1774               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1775             no-error .
     1776           if error-status :error
     1777           or error-status :get-message(1) <> ""
     1778           then do:
     1779             undo move_block, retry move_block .
     1780           end.
     1781         end.
     1782         for each buf_temp-diasize-handle
     1783         on error undo move_block, retry move_block
     1784         :
     1785           assign
     1786             v-object-handle = buf_temp-diasize-handle.handle-value
     1787           .
     1788           if v-object-handle <> v-diasize-resize-button
     1789           then do:
     1790             assign
     1791               v-object-handle :row = v-object-handle :row + p-change-value
     1792               no-error .
     1793             if error-status :error
     1794             or error-status :get-message(1) <> ""
     1795             then do:
     1796               undo move_block, retry move_block .
     1797             end.
     1798           end.
     1799         end.
     1800       end.
     1801       else do:
     1802         for each buf_temp-diasize-handle
     1803         on error undo move_block, retry move_block
     1804         :
     1805           assign
     1806             v-object-handle = buf_temp-diasize-handle.handle-value
     1807           .
     1808           if v-object-handle <> v-diasize-resize-button
     1809           then do:
     1810             assign
     1811               v-object-handle :row = v-object-handle :row + p-change-value
     1812               no-error .
     1813             if error-status :error
     1814             or error-status :get-message(1) <> ""
     1815             then do:
     1816               undo move_block, retry move_block .
     1817             end.
     1818           end.
     1819         end.
     1820         assign
     1821           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1822           no-error .
     1823         if error-status :error
     1824         or error-status :get-message(1) <> ""
     1825         then do:
     1826           undo move_block, retry move_block .
     1827         end.
     1828         for each buf_temp-browse-handle
     1829           where buf_temp-browse-handle.browse-type = 'height':u
     1830         on error undo move_block, retry move_block
     1831         :
     1832           assign
     1833             buf_temp-browse-handle.browse-handle :height
     1834               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1835             no-error .
     1836           if error-status :error
     1837           or error-status :get-message(1) <> ""
     1838           then do:
     1839             undo move_block, retry move_block .
     1840           end.
     1841         end.
     1842         assign
     1843           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1844           no-error .
     1845         if error-status :error
     1846         or error-status :get-message(1) <> ""
     1847         then do:
     1848           undo move_block, retry move_block .
     1849         end.
     1850         if frame Dialog-Frame :scrollable = true
     1851         then do:
     1852           assign
     1853             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1854             no-error .
     1855           if error-status :error
     1856           or error-status :get-message(1) <> ""
     1857           then do:
     1858             undo move_block, retry move_block .
     1859           end.
     1860         end.
     1861       end.
     1862       if p-move-resize = true
     1863       then do:
     1864         run diasize_position-resize-button in this-procedure .
     1865       end.
     1866       if v-diasize-wndstore = true
     1867       then do:
     1868         if connected("ub") = true
     1869         then do:
     1870           define variable v-cntxt-db-num        as integer   no-undo .
     1871           define variable v-cntxt-userid        as character no-undo .
     1872           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1873                                             , OUTPUT v-cntxt-userid
     1874                                             ) .
     1875           run gbl/wndsizew.p
     1876             (input  v-cntxt-db-num
     1877             ,input  v-cntxt-userid
     1878             ,input  v-diasize-proc-name
     1879             ,input  'height':u
     1880             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1881             ) .
     1882         end.
     1883       end.
     1884     end.
     1885     assign
     1886       v-diasize-change-size = false
     1887     .
     1888   end procedure.
     1889   procedure diasize_set-height :
     1890     define input  parameter p-new-height  as decimal   no-undo .
     1891     define input  parameter p-move-resize as logical   no-undo .
     1892     do
     1893     on error undo, return error return-value
     1894     :
     1895       run diasize_change-height in this-procedure
     1896         (input  (p-new-height - frame Dialog-Frame :height)
     1897         ,input  p-move-resize
     1898         ) .
     1899     end.
     1900   end procedure.
     1901   procedure diasize_change-width :
     1902     define input  parameter p-change-value as decimal   no-undo .
     1903     define input  parameter p-move-resize  as logical   no-undo .
     1904     define variable v-field-group-handle   as handle    no-undo .
     1905     define variable v-object-handle        as handle    no-undo .
     1906     define variable v-frame-width          as decimal   no-undo .
     1907     define variable v-frame-virtual-width  as decimal   no-undo .
     1908     define variable v-browse-width         as decimal   no-undo .
     1909     define variable v-window-width         as decimal   no-undo .
     1910     define variable v-window-virtual-width as decimal   no-undo .
     1911     define variable v-change-sign          as integer   no-undo .
     1912     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1913     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1914     if p-change-value > 0
     1915     then do:
     1916       if frame Dialog-Frame :width + p-change-value >
     1917           session :width-chars
     1918       then do:
     1919         assign
     1920           p-change-value = session :width-chars - frame Dialog-Frame :width
     1921         .
     1922         if p-change-value <= 0
     1923         then do:
     1924           run diasize_position-resize-button in this-procedure .
     1925           return .
     1926         end.
     1927       end.
     1928     end.
     1929     if p-change-value < 0
     1930     then do:
     1931       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1932       then do:
     1933         assign
     1934           p-change-value = v-diasize-orig-frame-width
     1935                          - frame Dialog-Frame :width
     1936         .
     1937         if p-change-value >= 0
     1938         then do:
     1939           run diasize_position-resize-button in this-procedure .
     1940           return .
     1941         end.
     1942       end.
     1943     end.
     1944     if p-change-value >= 0
     1945     then do:
     1946       assign
     1947         v-change-sign = 1
     1948       .
     1949     end.
     1950     else do:
     1951       assign
     1952         v-change-sign = -1
     1953       .
     1954     end.
     1955     assign
     1956       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1957     .
     1958     if p-change-value = 0
     1959     then do:
     1960       run diasize_position-resize-button in this-procedure .
     1961       return .
     1962     end.
     1963     move_block:
     1964     do
     1965     on error undo move_block, leave move_block
     1966     :
     1967       if retry
     1968       then do:
     1969         do
     1970         on error undo move_block, leave move_block
     1971         :
     1972           if p-change-value > 0
     1973           then do:
     1974             for each buf_temp-diasize-handle
     1975             on error undo, next
     1976             :
     1977               assign
     1978                 v-object-handle = buf_temp-diasize-handle.handle-value
     1979               .
     1980               if v-object-handle <> v-diasize-resize-button
     1981               then do:
     1982                 assign
     1983                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1984                 .
     1985               end.
     1986             end.
     1987             assign
     1988               v-diasize-browse-handle :width = v-browse-width
     1989             .
     1990             for each buf_temp-browse-handle
     1991               where buf_temp-browse-handle.browse-type = 'width':u
     1992             on error undo, next
     1993             :
     1994               assign
     1995                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1996               .
     1997             end.
     1998             assign
     1999               frame Dialog-Frame :width = v-frame-width
     2000             .
     2001             if frame Dialog-Frame :scrollable = true
     2002             then do:
     2003               assign
     2004                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2005               .
     2006             end.
     2007             run diasize_position-resize-button in this-procedure .
     2008           end.
     2009           else do:
     2010             if frame Dialog-Frame :scrollable = true
     2011             then do:
     2012               assign
     2013                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2014               .
     2015             end.
     2016             assign
     2017               frame Dialog-Frame :width = v-frame-width
     2018             .
     2019             for each buf_temp-browse-handle
     2020               where buf_temp-browse-handle.browse-type = 'width':u
     2021             on error undo, next
     2022             :
     2023               assign
     2024                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2025               .
     2026             end.
     2027             assign
     2028               v-diasize-browse-handle :width = v-browse-width
     2029             .
     2030             for each buf_temp-diasize-handle
     2031             on error undo, next
     2032             :
     2033               assign
     2034                 v-object-handle = buf_temp-diasize-handle.handle-value
     2035               .
     2036               if v-object-handle <> v-diasize-resize-button
     2037               then do:
     2038                 assign
     2039                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2040                 .
     2041               end.
     2042             end.
     2043             run diasize_position-resize-button in this-procedure .
     2044           end.
     2045           assign
     2046             v-diasize-change-size = false
     2047           .
     2048           leave move_block .
     2049         end.
     2050       end.
     2051       assign
     2052         v-diasize-need-full-display = true
     2053       .
     2054       if v-diasize-change-size = false
     2055       then do:
     2056         assign
     2057           v-diasize-change-size = true
     2058         .
     2059       end.
     2060       else do:
     2061         return .
     2062       end.
     2063       assign
     2064         v-frame-width = frame Dialog-Frame :width
     2065         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2066         v-browse-width = v-diasize-browse-handle :width
     2067       .
     2068       for each buf_temp-browse-handle
     2069         where buf_temp-browse-handle.browse-type = 'width':u
     2070       :
     2071         assign
     2072           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2073         .
     2074       end.
     2075       for each buf_temp-diasize-handle
     2076       :
     2077         delete buf_temp-diasize-handle .
     2078       end.
     2079       assign
     2080         v-field-group-handle = frame Dialog-Frame :first-child
     2081       .
     2082       do while valid-handle(v-field-group-handle)
     2083       :
     2084         assign
     2085           v-object-handle = v-field-group-handle :first-child
     2086         .
     2087         do while valid-handle(v-object-handle)
     2088         :
     2089           if  v-object-handle <> v-diasize-browse-handle :handle
     2090           and v-object-handle <> v-diasize-resize-button
     2091           and can-query(v-object-handle, "row")
     2092           and can-query(v-object-handle, "height")
     2093           and ( v-object-handle :col + v-object-handle :width
     2094                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2095               )
     2096           then do:
     2097             find first buf_temp-browse-handle
     2098               where buf_temp-browse-handle.browse-type   = 'width':u
     2099                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2100               no-error .
     2101             if available buf_temp-browse-handle
     2102             then do:
     2103             end.
     2104             else do:
     2105               create buf_temp-diasize-handle .
     2106               assign
     2107                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2108                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2109               .
     2110             end.
     2111           end.
     2112           assign
     2113             v-object-handle = v-object-handle :next-sibling
     2114           .
     2115         end.
     2116         assign
     2117           v-field-group-handle = v-field-group-handle :next-sibling
     2118         .
     2119       end.
     2120       do with frame Dialog-Frame
     2121       :
     2122         hide v-diasize-resize-button .
     2123         v-diasize-resize-button :row = 1.
     2124         v-diasize-resize-button :column = 1.
     2125       end.
     2126       if p-change-value > 0
     2127       then do:
     2128         if frame Dialog-Frame :scrollable = true
     2129         then do:
     2130           assign
     2131             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2132             no-error .
     2133           if error-status :error
     2134           or error-status :get-message(1) <> ""
     2135           then do:
     2136             undo move_block, retry move_block.
     2137           end.
     2138         end.
     2139         assign
     2140           frame Dialog-Frame :width = v-frame-width + p-change-value
     2141           no-error .
     2142         if error-status :error
     2143         or error-status :get-message(1) <> ""
     2144         then do:
     2145           undo move_block, retry move_block.
     2146         end.
     2147         assign
     2148           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2149         no-error .
     2150         if error-status :error
     2151         or error-status :get-message(1) <> ""
     2152         then do:
     2153           undo move_block, retry move_block.
     2154         end.
     2155         for each buf_temp-browse-handle
     2156           where buf_temp-browse-handle.browse-type = 'width':u
     2157         on error undo move_block, retry move_block
     2158         :
     2159           assign
     2160             buf_temp-browse-handle.browse-handle :width
     2161               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2162             no-error .
     2163           if error-status :error
     2164           or error-status :get-message(1) <> ""
     2165           then do:
     2166             undo move_block, retry move_block .
     2167           end.
     2168         end.
     2169         for each buf_temp-diasize-handle
     2170         on error undo move_block, retry move_block
     2171         :
     2172           assign
     2173             v-object-handle = buf_temp-diasize-handle.handle-value
     2174           .
     2175           if v-object-handle <> v-diasize-resize-button
     2176           then do:
     2177             assign
     2178               v-object-handle :col = v-object-handle :col + p-change-value
     2179               no-error .
     2180             if error-status :error
     2181             or error-status :get-message(1) <> ""
     2182             then do:
     2183               undo move_block, retry move_block .
     2184             end.
     2185           end.
     2186         end.
     2187       end.
     2188       else do:
     2189         for each buf_temp-diasize-handle
     2190         on error undo move_block, retry move_block
     2191         :
     2192           assign
     2193             v-object-handle = buf_temp-diasize-handle.handle-value
     2194           .
     2195           if v-object-handle <> v-diasize-resize-button
     2196           then do:
     2197             assign
     2198               v-object-handle :col = v-object-handle :col + p-change-value
     2199               no-error .
     2200             if error-status :error
     2201             or error-status :get-message(1) <> ""
     2202             then do:
     2203               undo move_block, retry move_block .
     2204             end.
     2205           end.
     2206         end.
     2207         for each buf_temp-browse-handle
     2208           where buf_temp-browse-handle.browse-type = 'width':u
     2209         on error undo move_block, retry move_block
     2210         :
     2211           assign
     2212             buf_temp-browse-handle.browse-handle :width
     2213               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2214             no-error .
     2215           if error-status :error
     2216           or error-status :get-message(1) <> ""
     2217           then do:
     2218             undo move_block, retry move_block .
     2219           end.
     2220         end.
     2221         assign
     2222           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2223           no-error .
     2224         if error-status :error
     2225         or error-status :get-message(1) <> ""
     2226         then do:
     2227           undo move_block, retry move_block.
     2228         end.
     2229         assign
     2230           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2231         no-error .
     2232         if error-status :error
     2233         or error-status :get-message(1) <> ""
     2234         then do:
     2235           undo move_block, retry move_block.
     2236         end.
     2237         if frame Dialog-Frame :scrollable = true
     2238         then do:
     2239           assign
     2240             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2241           no-error .
     2242           if error-status :error
     2243           or error-status :get-message(1) <> ""
     2244           then do:
     2245             undo move_block, retry move_block.
     2246           end.
     2247         end.
     2248       end.
     2249       if p-move-resize
     2250       then do:
     2251         run diasize_position-resize-button in this-procedure .
     2252       end.
     2253       if v-diasize-wndstore = true
     2254       then do:
     2255         if connected("ub") = true
     2256         then do:
     2257           define variable v-cntxt-db-num        as integer   no-undo .
     2258           define variable v-cntxt-userid        as character no-undo .
     2259           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2260                                             , OUTPUT v-cntxt-userid
     2261                                             ) .
     2262           run gbl/wndsizew.p
     2263             (input  v-cntxt-db-num
     2264             ,input  v-cntxt-userid
     2265             ,input  v-diasize-proc-name
     2266             ,input  'width':u
     2267             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2268             ) .
     2269         end.
     2270       end.
     2271     end.
     2272     assign
     2273       v-diasize-change-size = false
     2274     .
     2275   end procedure.
     2276   procedure diasize_set-width :
     2277     define input  parameter p-new-width  as decimal   no-undo .
     2278     define input  parameter p-move-resize as logical   no-undo .
     2279     do
     2280     on error undo, return error return-value
     2281     :
     2282       run diasize_change-width in this-procedure
     2283         (input  (p-new-width - frame Dialog-Frame :width)
     2284         ,input  p-move-resize
     2285         ) .
     2286     end.
     2287   end procedure.
     2288   procedure diasize_position-resize-button :
     2289     do with frame Dialog-Frame
     2290     :
     2291       hide v-diasize-resize-button .
     2292       assign
     2293         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2294                     - 1
     2295                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2296         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2297                     - 1
     2298                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2299       .
     2300       view v-diasize-resize-button .
     2301     end.
     2302   end procedure.
     2303   on alt-right anywhere
     2304   do:
     2305     run diasize_change-width in this-procedure
     2306       (input 1
     2307       ,input true
     2308       ) .
     2309     return no-apply .
     2310   end.
     2311   on alt-left anywhere
     2312   do:
     2313     run diasize_change-width in this-procedure
     2314       (input -1
     2315       ,input true
     2316       ) .
     2317     return no-apply .
     2318   end.
     2319   on alt-down anywhere
     2320   do:
     2321     run diasize_change-height in this-procedure
     2322       (input 1
     2323       ,input true
     2324       ) .
     2325     return no-apply .
     2326   end.
     2327   on alt-up anywhere
     2328   do:
     2329     run diasize_change-height in this-procedure
     2330       (input -1
     2331       ,input true
     2332       ) .
     2333     return no-apply .
     2334   end.
     2335   on alt-enter of frame Dialog-Frame
     2336   do:
     2337     run diasize_maximize in this-procedure
     2338       (input  ?
     2339       ).
     2340     return no-apply .
     2341   end.
     2342   procedure diasize_end-move :
     2343     do
     2344     on error undo, return error return-value
     2345     :
     2346       define variable v-row-delta as decimal   no-undo .
     2347       define variable v-col-delta as decimal   no-undo .
     2348       define variable v-new-row as decimal   no-undo .
     2349       define variable v-new-col as decimal   no-undo .
     2350       assign
     2351         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2352         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2353       .
     2354       assign
     2355         v-row-delta = v-new-row - frame Dialog-Frame :height
     2356         v-col-delta = v-new-col - frame Dialog-Frame :width
     2357       .
     2358       run diasize_change-height in this-procedure
     2359         (input v-row-delta
     2360         ,input true
     2361         ) .
     2362       run diasize_change-width in this-procedure
     2363         (input v-col-delta
     2364         ,input true
     2365         ) .
     2366     end.
     2367   end procedure.
     2368   procedure diasize_maximize :
     2369     define input  parameter p-action as logical   no-undo .
     2370     do
     2371     on error undo, return error return-value
     2372     :
     2373       if p-action = ?
     2374       then do:
     2375         if v-diasize-need-maximize = true
     2376         then do:
     2377           assign
     2378             p-action = true
     2379           .
     2380         end.
     2381         else do:
     2382           assign
     2383             p-action = false
     2384           .
     2385         end.
     2386       end.
     2387       if p-action = true
     2388       then do:
     2389         run diasize_change-height in this-procedure
     2390           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2391               - frame Dialog-Frame :height-chars
     2392           ,input true
     2393           ) .
     2394         run diasize_change-width in this-procedure
     2395           (input session :width-chars
     2396               - frame Dialog-Frame :width-chars
     2397           ,input true
     2398           ) .
     2399         assign
     2400           v-diasize-need-maximize = false
     2401         .
     2402       end.
     2403       else do:
     2404         run diasize_change-width in this-procedure
     2405           (input v-diasize-orig-frame-width
     2406               - frame Dialog-Frame :width-chars
     2407           ,input true
     2408           ) .
     2409         run diasize_change-height in this-procedure
     2410           (input v-diasize-orig-frame-height
     2411               - frame Dialog-Frame :height-chars
     2412           ,input true
     2413           ) .
     2414         assign
     2415           v-diasize-need-maximize = true
     2416         .
     2417       end.
     2418     end.
     2419   end procedure.
     2420   procedure diasize_restore-orig-size :
     2421     do
     2422     on error undo, return error return-value
     2423     :
     2424       assign
     2425         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2426         v-diasize-current-frame-height = frame Dialog-Frame :height
     2427       .
     2428       run diasize_set-height in this-procedure
     2429         (input  v-diasize-orig-frame-height
     2430         ,input  true
     2431         ) .
     2432       run diasize_set-width in this-procedure
     2433         (input  v-diasize-orig-frame-width
     2434         ,input  true
     2435         ) .
     2436     end.
     2437   end procedure.
     2438   procedure diasize_restore-current-size :
     2439     do
     2440     on error undo, return error return-value
     2441     :
     2442       run diasize_set-height in this-procedure
     2443         (input  v-diasize-current-frame-height
     2444         ,input  true
     2445         ) .
     2446       run diasize_set-width in this-procedure
     2447         (input  v-diasize-current-frame-width
     2448         ,input  true
     2449         ) .
     2450     end.
     2451   end procedure.
     2452   procedure diasize_set-browse-handle :
     2453     define input  parameter p-browse-handle as handle   no-undo .
     2454     define buffer buf_temp-browse-handle for temp-browse-handle .
     2455     do
     2456     on error undo, return error return-value
     2457     :
     2458       assign
     2459         v-diasize-browse-handle = p-browse-handle
     2460       .
     2461       for each buf_temp-browse-handle
     2462       on error undo, return error return-value
     2463       :
     2464         delete buf_temp-browse-handle .
     2465       end.
     2466     end.
     2467   end procedure.
     2468   procedure diasize_add_browse :
     2469     define input  parameter p-browse-type   as character no-undo .
     2470     define input  parameter p-browse-handle as handle    no-undo .
     2471     define buffer buf_temp-browse-handle for temp-browse-handle .
     2472     do
     2473     on error undo, return error return-value
     2474     :
     2475       assign
     2476         v-diasize-browse-number = v-diasize-browse-number + 1
     2477       .
     2478       create buf_temp-browse-handle .
     2479       assign
     2480         buf_temp-browse-handle.browse-type   = p-browse-type
     2481         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2482         buf_temp-browse-handle.browse-handle = p-browse-handle
     2483       .
     2484     end.
     2485   end procedure.
     2486   procedure diasize_init :
     2487     define variable v-default-value    as logical   no-undo .
     2488     define variable v-restore-saved    as logical   no-undo .
     2489     define variable v-resize-value-str as character no-undo .
     2490     do
     2491     on error undo, return error return-value
     2492     :
     2493       do with frame Dialog-Frame
     2494       :
     2495         assign
     2496           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2497           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2498           v-diasize-browse-handle     = browse br-vardeliv :handle
     2499         .
     2500         create button v-diasize-resize-button
     2501         assign
     2502           parent        = frame Dialog-Frame :first-child
     2503           label         = "s"
     2504           height-pixels = 16
     2505           width-pixels  = 16
     2506           visible       = true
     2507           sensitive     = true
     2508           movable       = true
     2509           triggers:
     2510             on end-move persistent run diasize_end-move in this-procedure .
     2511           end triggers.
     2512         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2513         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2514         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2515         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2516         assign
     2517           v-diasize-wndmax = false
     2518         .
     2519         if connected("ub") = true
     2520         then do:
     2521           define variable v-cntxt-db-num        as integer   no-undo .
     2522           define variable v-cntxt-userid        as character no-undo .
     2523           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2524                                             , OUTPUT v-cntxt-userid
     2525                                             ) .
     2526           run gbl/wndpar_r.p
     2527             (input  v-cntxt-db-num
     2528             ,input  v-cntxt-userid
     2529             ,input  'wndmax':U
     2530             ,output v-diasize-wndmax
     2531             ,output v-default-value
     2532             ) .
     2533         end.
     2534         assign
     2535           v-diasize-wndstore = false
     2536         .
     2537         if connected("ub") = true
     2538         then do:
     2539           run gbl/wndpar_r.p
     2540             (input  v-cntxt-db-num
     2541             ,input  v-cntxt-userid
     2542             ,input  'wndstore':U
     2543             ,output v-diasize-wndstore
     2544             ,output v-default-value
     2545             ) .
     2546         end.
     2547         assign
     2548           v-diasize-proc-name = entry(1, program-name(2), '.')
     2549         .
     2550         if v-diasize-wndstore = true
     2551         then do:
     2552           assign
     2553             v-restore-saved = false
     2554           .
     2555           if connected("ub") = true
     2556           then do:
     2557             run gbl/wndsizer.p
     2558               (input  v-cntxt-db-num
     2559               ,input  v-cntxt-userid
     2560               ,input  v-diasize-proc-name
     2561               ,input  'height':u
     2562               ,output v-resize-value-str
     2563               ) .
     2564             if v-resize-value-str <> '':U
     2565             then do:
     2566               run diasize_change-height in this-procedure
     2567                 (input  integer(v-resize-value-str)
     2568                 ,input  true
     2569                 ) .
     2570               assign
     2571                 v-restore-saved = true
     2572               .
     2573             end.
     2574           end.
     2575           if connected("ub") = true
     2576           then do:
     2577             run gbl/wndsizer.p
     2578               (input  v-cntxt-db-num
     2579               ,input  v-cntxt-userid
     2580               ,input  v-diasize-proc-name
     2581               ,input  'width':u
     2582               ,output v-resize-value-str
     2583               ) .
     2584             if v-resize-value-str <> '':U
     2585             then do:
     2586               run diasize_change-width in this-procedure
     2587                 (input  integer(v-resize-value-str)
     2588                 ,input  true
     2589                 ) .
     2590               assign
     2591                 v-restore-saved = true
     2592               .
     2593             end.
     2594           end.
     2595           if v-restore-saved <> true
     2596           then do:
     2597             if v-diasize-wndmax = true
     2598             then do:
     2599               run diasize_maximize in this-procedure
     2600                 (input  true
     2601                 ) .
     2602             end.
     2603           end.
     2604         end.
     2605         else do:
     2606           if v-diasize-wndmax = true
     2607           then do:
     2608             run diasize_maximize in this-procedure
     2609               (input  true
     2610               ) .
     2611           end.
     2612         end.
     2613       end.
     2614     end.
     2615   end procedure.
     2616   procedure diasize_need-full-display :
     2617     define output parameter p-need-full-display as logical   no-undo .
     2618     do
     2619     on error undo, return error return-value
     2620     :
     2621       assign
     2622         p-need-full-display = v-diasize-need-full-display
     2623       .
     2624       assign
     2625         v-diasize-need-full-display = false
     2626       .
     2627     end.
     2628   end procedure.
     2629   procedure get-context :
     2630      define output parameter p-db-num as integer          no-undo.
     2631      define output parameter p-user-id as character        no-undo.
     2632      define variable v-login               as character    no-undo.
     2633      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2634      define buffer buf_user-login  for ub.user-login .
     2635      do
     2636      on error undo, return error
     2637      :
     2638            FIND FIRST buf_sys-ctrl no-lock.
     2639            ASSIGN
     2640               v-login = USERID("ub")
     2641               p-db-num = buf_sys-ctrl.db-num
     2642            .
     2643            FIND FIRST buf_user-login
     2644                 WHERE buf_user-login.db-num = p-db-num
     2645                   AND buf_user-login.user-login = v-login
     2646                 no-lock
     2647                 no-error
     2648                 .
     2649            IF AVAILABLE buf_user-login
     2650            THEN DO:
     2651               assign
     2652                  p-user-id = buf_user-login.user-id
     2653               .
     2654            END.
     2655      end.
     2656   end procedure.
     2657       run diasize_init in this-procedure .
     2658   def var sort-labelbr-vardeliv   as character no-undo .
     2659   def var sort-clmnbr-vardeliv    as handle    no-undo .
     2660   def var cur-clmnbr-vardeliv     as handle    no-undo .
     2661   def var cur-clmn-locbr-vardeliv as integer   no-undo .
     2662   def var re-querybr-vardeliv     as logical   initial no no-undo .
     2663   on start-search, ctrl-o of br-vardeliv in frame Dialog-Frame do:
     2664      run sort-brbr-vardeliv
     2665        (input (if available X_var-deliv-gr-per-val
     2666                then recid(X_var-deliv-gr-per-val)
     2667                else ?
     2668               )
     2669        ).
     2670   end.
     2671   PROCEDURE sort-brbr-vardeliv :
     2672     define input parameter p-recid as recid no-undo .
     2673     if re-querybr-vardeliv = no then do:
     2674       assign
     2675          cur-clmnbr-vardeliv = br-vardeliv:current-column in frame Dialog-Frame
     2676       .
     2677       if sort-clmnbr-vardeliv <> ? then sort-clmnbr-vardeliv:column-fgcolor = 0.
     2678       if cur-clmnbr-vardeliv = sort-clmnbr-vardeliv then do:
     2679         assign
     2680            sort-labelbr-vardeliv = ""
     2681            sort-clmnbr-vardeliv = ?
     2682         .
     2683        end.
     2684        else do:
     2685          assign
     2686            sort-labelbr-vardeliv = cur-clmnbr-vardeliv:label
     2687            sort-clmnbr-vardeliv  = cur-clmnbr-vardeliv
     2688            sort-clmnbr-vardeliv:column-fgcolor = 4
     2689          .
     2690        end.
     2691      end.
     2692     assign
     2693       cur-clmn-locbr-vardeliv = 1
     2694     .
     2695     def var column-handle as handle no-undo .
     2696     column-handle = br-vardeliv:first-column.
     2697     do while valid-handle(column-handle) :
     2698       if column-handle = cur-clmnbr-vardeliv then do:
     2699         leave .
     2700       end.
     2701       column-handle = column-handle:NEXT-COLUMN.
     2702       assign
     2703         cur-clmn-locbr-vardeliv = cur-clmn-locbr-vardeliv + 1
     2704       .
     2705     end.
     2706     case sort-labelbr-vardeliv:
     2707           when X_var-deliv-gr-per-val.deliv-type-code:label in browse br-vardeliv then DO:    assign       sort-column-name = "X_var-deliv-gr-per-val.deliv-type-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2708           when X_var-deliv-gr-per-val.deliv-subj-code:label in browse br-vardeliv then DO:    assign       sort-column-name = "X_var-deliv-gr-per-val.deliv-subj-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2709       otherwise do:
     2710         assign
     2711           sort-column-name = ""
     2712         .
     2713         run OpenBr in this-procedure ( input yes, input no, input '':U).
     2714           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-vardeliv') then do:
     2715             run mv-brw-defaultbr-vardeliv.
     2716           end.
     2717         if sort-labelbr-vardeliv <> "" then do:
     2718           assign
     2719             cur-clmnbr-vardeliv:column-fgcolor = 0
     2720           .
     2721         end.
     2722         assign
     2723           cur-clmn-locbr-vardeliv = ?
     2724         .
     2725       end.
     2726     end case.
     2727       if cur-clmn-locbr-vardeliv <> ? then do:
     2728         if can-do( this-procedure:internal-entries, 'ch-clmnbr-vardeliv') then do:
     2729           run ch-clmnbr-vardeliv in this-procedure (cur-clmn-locbr-vardeliv).
     2730         end.
     2731       end.
     2732     if p-recid <> ? then do:
     2733       reposition br-vardeliv to recid p-recid no-error.
     2734       apply "value-changed" to br-vardeliv in frame Dialog-Frame.
     2735     end.
     2736     apply "entry" to br-vardeliv in frame Dialog-Frame.
     2737   END PROCEDURE.
     2738   procedure re-open-query-srt-clmnbr-vardeliv:
     2739   if cur-clmnbr-vardeliv = ? then do:
     2740      run OpenBr in this-procedure ( input yes, input no, input '':U).
     2741   end.
     2742   else do:
     2743      assign re-querybr-vardeliv = yes.
     2744      run sort-brbr-vardeliv
     2745        (input (if available X_var-deliv-gr-per-val
     2746                then recid(X_var-deliv-gr-per-val)
     2747                else ?
     2748               )
     2749        ).
     2750      assign re-querybr-vardeliv = no.
     2751   end.
     2752   end.
     2753   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2754   DEF VAR cur-clmn-numbr-vardeliv as INT EXTENT 9 no-undo.
     2755   DEF VAR varmvibr-vardeliv       as INT no-undo.
     2756   DEF VAR varmvjbr-vardeliv       as INT no-undo.
     2757   DEF VAR varmvkbr-vardeliv       as INT no-undo.
     2758   DEF VAR varmvlbr-vardeliv       as INT no-undo.
     2759   DEF VAR move-elementbr-vardeliv as INT no-undo.
     2760   def var jjbr-vardeliv           as int no-undo.
     2761   do varmvibr-vardeliv = 1 to EXTENT(cur-clmn-numbr-vardeliv):
     2762     ASSIGN cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = varmvibr-vardeliv.
     2763   END.
     2764   RUN start-mv-clmnbr-vardeliv.
     2765   PROCEDURE start-mv-clmnbr-vardeliv:
     2766   def var old-session as logical no-undo.
     2767      old-session = SESSION:IMMEDIATE-DISPLAY.
     2768      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2769          IF  p-mode = 'все':U  THEN DO:
     2770      DO jjbr-vardeliv = NUM-ENTRIES('1,2,3,4,5,6,7,8,9') TO 1 BY -1:
     2771        RUN re-move-clmnbr-vardeliv ( cur-clmn-numbr-vardeliv[INTEGER(ENTRY (jjbr-vardeliv, '1,2,3,4,5,6,7,8,9'))] , 1).
     2772      END.
     2773          END.
     2774          IF  p-mode = 'delivery-type-subject'  THEN DO:
     2775      DO jjbr-vardeliv = NUM-ENTRIES('1,2,5,6,7,8,9,3,4') TO 1 BY -1:
     2776        RUN re-move-clmnbr-vardeliv ( cur-clmn-numbr-vardeliv[INTEGER(ENTRY (jjbr-vardeliv, '1,2,5,6,7,8,9,3,4'))] , 1).
     2777      END.
     2778          END.
     2779          IF  p-mode = 'объект':U  THEN DO:
     2780      DO jjbr-vardeliv = NUM-ENTRIES('1,2,3,4,5,6,8,9,7') TO 1 BY -1:
     2781        RUN re-move-clmnbr-vardeliv ( cur-clmn-numbr-vardeliv[INTEGER(ENTRY (jjbr-vardeliv, '1,2,3,4,5,6,8,9,7'))] , 1).
     2782      END.
     2783          END.
     2784      SESSION:IMMEDIATE-DISPLAY = old-session.
     2785   END.
     2786   ON ctrl-cursor-right OF BROWSE br-vardeliv do:
     2787     RUN re-move-clmnbr-vardeliv ( 1, 9).
     2788   END.
     2789   ON ctrl-cursor-left OF BROWSE br-vardeliv do:
     2790     RUN re-move-clmnbr-vardeliv (9, 1).
     2791   END.
     2792   PROCEDURE re-move-clmnbr-vardeliv:
     2793     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2794     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2795     DO varmvibr-vardeliv = 1 TO EXTENT(cur-clmn-numbr-vardeliv):
     2796       if cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = source-column THEN cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = -1.
     2797     END.
     2798     if br-vardeliv:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2799     if source-column > target-column THEN
     2800     DO varmvjbr-vardeliv = source-column - 1 to target-column BY -1:
     2801       DO varmvibr-vardeliv = 1 TO EXTENT(cur-clmn-numbr-vardeliv):
     2802           if cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = varmvjbr-vardeliv THEN DO:
     2803             cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = cur-clmn-numbr-vardeliv[varmvibr-vardeliv] + 1.
     2804           END.
     2805       END.
     2806     END.
     2807     ELSE
     2808     DO varmvjbr-vardeliv = source-column + 1 to target-column:
     2809       DO varmvibr-vardeliv = 1 TO EXTENT(cur-clmn-numbr-vardeliv):
     2810         if cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = varmvjbr-vardeliv THEN DO:
     2811           cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = cur-clmn-numbr-vardeliv[varmvibr-vardeliv] - 1.
     2812         END.
     2813       END.
     2814     END.
     2815     DO varmvibr-vardeliv = 1 TO EXTENT(cur-clmn-numbr-vardeliv):
     2816       if cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = -1 THEN cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = target-column.
     2817     END.
     2818   END PROCEDURE.
     2819   PROCEDURE ch-clmnbr-vardeliv:
     2820     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2821     if cur-clmn-loc <= 1 then do:
     2822       return .
     2823     end.
     2824     DO varmvibr-vardeliv = 1 TO EXTENT(cur-clmn-numbr-vardeliv):
     2825       if cur-clmn-numbr-vardeliv[varmvibr-vardeliv] = cur-clmn-loc THEN move-elementbr-vardeliv = varmvibr-vardeliv.
     2826     END.
     2827     RUN re-move-clmnbr-vardeliv (cur-clmn-loc, 1).
     2828   END PROCEDURE.
     2829   PROCEDURE mv-brw-defaultbr-vardeliv:
     2830   def var old-session as logical no-undo.
     2831     old-session = SESSION:IMMEDIATE-DISPLAY.
     2832     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2833     do varmvlbr-vardeliv = 1 to EXTENT(cur-clmn-numbr-vardeliv):
     2834       RUN re-move-clmnbr-vardeliv (cur-clmn-numbr-vardeliv[varmvlbr-vardeliv], varmvlbr-vardeliv).
     2835     END.
     2836     RUN start-mv-clmnbr-vardeliv.
     2837     SESSION:IMMEDIATE-DISPLAY = old-session.
     2838   END PROCEDURE.
     2839   .
