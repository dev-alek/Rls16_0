     1248       if error-status:error then do:                           find first pos_var-deliv-gr-per-val no-lock where                                   recid(pos_var-deliv-gr-per-val) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ВАРИАНТ ДОСТАВКИ ПО ГРУППАМ СРОКОВ ГОДНОСТИ" skip                            string(if avail pos_var-deliv-gr-per-val                                     then  substitute("Вн код типа доставки: &1 вн код субъекта доставки: &2 объект доставки: &3&4 вн уод группы сроков годности &5"                                                     , pos_var-deliv-gr-per-val.deliv-type-code                                                     , pos_var-deliv-gr-per-val.deliv-subj-code                                                     , pos_var-deliv-gr-per-val.obj-type                                                     , pos_var-deliv-gr-per-val.obj-code                                                     , pos_var-deliv-gr-per-val.gr-per-val-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1249    end.
     1250   apply "entry" to br-vardeliv in frame Dialog-Frame.
     1251   apply "value-changed" to br-vardeliv in frame Dialog-Frame.
