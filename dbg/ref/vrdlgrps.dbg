     1084        FGCOLOR 4  NO-UNDO.
     1085   DEFINE VARIABLE RS-sts AS CHARACTER
     1086        VIEW-AS RADIO-SET HORIZONTAL
     1087        RADIO-BUTTONS
     1088             "Item 1", "1",
     1089   "Item 2", "2",
     1090   "Item 3", "3"
     1091        SIZE 33.5 BY 1 NO-UNDO.
     1092   DEFINE QUERY br-vardeliv FOR
     1093         X_var-deliv-gr-per-val SCROLLING.
     1094   DEFINE BROWSE br-vardeliv
     1095     QUERY br-vardeliv NO-LOCK DISPLAY
     1096         mark-string(recid( X_var-deliv-gr-per-val), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1097         entry (lookup (STRING(X_var-deliv-gr-per-val.sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) COLUMN-LABEL "Статус"
     1098         X_var-deliv-gr-per-val.deliv-type-code COLUMN-LABEL "Вн.код!типа!доставки" FORMAT ">>9":U
     1099         get-type(X_var-deliv-gr-per-val.deliv-type-code) COLUMN-LABEL "Тип доставки" FORMAT "X(25)":U
     1100         X_var-deliv-gr-per-val.deliv-subj-code COLUMN-LABEL "Вн.код!субъекта!доставки" FORMAT ">>9":U
     1101         get-subject(X_var-deliv-gr-per-val.deliv-subj-code) COLUMN-LABEL "Субъект доставки" FORMAT "X(25)":U
     1102         X_var-deliv-gr-per-val.obj-type + string(X_var-deliv-gr-per-val.obj-code) COLUMN-LABEL "Объект!доставки" FORMAT "X(8)":U
     1103         X_var-deliv-gr-per-val.gr-per-val-code COLUMN-LABEL "Код группы!сроков!хранения" FORMAT ">>9":U
     1104               WIDTH 8
     1105         get-gr-per-val(X_var-deliv-gr-per-val.gr-per-val-code, output v-gr-per-from, output v-gr-per-to) COLUMN-LABEL "Группа сроков годности" FORMAT "X(25)":U
     1106         get-term-delivery(X_var-deliv-gr-per-val.deliv-type-code,
     1107   X_var-deliv-gr-per-val.deliv-subj-code,
     1108   X_var-deliv-gr-per-val.obj-type,
     1109   X_var-deliv-gr-per-val.obj-code ) COLUMN-LABEL "Срок!доставки" FORMAT ">>>9":U
     1110         string(v-gr-per-from) + "-":U + string(v-gr-per-to) COLUMN-LABEL "Срок!годности" FORMAT "X(10)":U
     1111         X_var-deliv-gr-per-val.des FORMAT "X(100)":U WIDTH 50
     1112       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 18.
     1113   DEFINE FRAME Dialog-Frame
     1114        b-quit AT ROW 1 COL 1
     1115        B-mark AT ROW 1 COL 11
     1116        B-sel AT ROW 1 COL 21
     1117        B-add AT ROW 1 COL 31
     1118        b-lkp AT ROW 1 COL 41
     1119        B-chg AT ROW 1 COL 51
     1120        B-del AT ROW 1 COL 61
     1121        B-print AT ROW 1 COL 86
     1122        B-hist AT ROW 1 COL 89
     1123        B-sch AT ROW 1 COL 92
     1124        B-Help AT ROW 1 COL 95
     1125        RS-sts AT ROW 2.5 COL 3.5 NO-LABEL
     1126        br-vardeliv AT ROW 4 COL 1
     1127        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1128        SPACE(78.62) SKIP(20.03)
     1129       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1130            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1131            TITLE "Варианты доставки"
