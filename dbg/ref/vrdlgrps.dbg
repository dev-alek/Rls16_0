     1253   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1254   DO:
     1255       run proc-b-del in this-procedure no-error.
     1256     if error-status:error then return no-apply.
     1257   END.
     1258   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1259   DO:
     1260     define variable loc-doc-rec as recid no-undo .
     1261   define variable v-rid-list as character no-undo.
     1262     if NOT available X_var-deliv-gr-per-val then return no-apply.
     1263     loc-doc-rec = recid (X_var-deliv-gr-per-val).
