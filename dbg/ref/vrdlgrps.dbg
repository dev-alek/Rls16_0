      800   procedure fltfield-clear :
      801     define output parameter loc-fld as character no-undo.
      802     define output parameter loc-lab as character no-undo .
      803     define output parameter loc-spr as character no-undo .
      804     define output parameter loc-dim as character no-undo .
      805     assign
      806       loc-fld = ""
      807       loc-lab = ""
      808       loc-spr = ""
      809       loc-dim = "0"
      810     .
      811   end procedure .
      812   procedure fltfield-add :
      813     define input        parameter par-fld as character no-undo.
      814     define input        parameter par-lab as character no-undo .
      815     define input        parameter par-spr as character no-undo .
      816     define input-output parameter loc-fld as character no-undo.
      817     define input-output parameter loc-lab as character no-undo .
      818     define input-output parameter loc-spr as character no-undo .
      819     define input-output parameter loc-dim as character no-undo .
      820     do
      821     on error undo, return error
      822     :
      823       assign
      824       loc-fld = if loc-dim = '0'
      825                 then par-fld
      826                 else (loc-fld + chr(44) + par-fld)
      827       loc-lab = if loc-dim = '0'
      828                 then par-lab
      829                 else (loc-lab + chr(44) + par-lab)
      830       loc-spr = if loc-dim = '0'
      831                 then par-spr
      832                 else (loc-spr + chr(44) + par-spr)
      833       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      834                 string(integer(if num-entries(loc-dim) > 1
      835                               then entry(2, loc-dim)
      836                               else entry(1, loc-dim)
      837                               ) + 1)
      838       no-error
      839       .
      840     end.
      841   end procedure.
