     1295                   ,input p-curr-obj-code
     1296                   ,input 'ПРОСМОТР':U
     1297                   ,input X_var-deliv-gr-per-val.deliv-type-code
     1298                   ,input X_var-deliv-gr-per-val.deliv-subj-code
     1299                   ,input X_var-deliv-gr-per-val.obj-type
     1300                   ,input X_var-deliv-gr-per-val.obj-code
     1301                   ,input X_var-deliv-gr-per-val.gr-per-val-code
     1302                   ,input-output loc-doc-rec
     1303                               )
     1304   .
