     1144                             , input v-rid-list) no-error.
     1145     if error-status:error then return no-apply.
     1146     APPLY "END-ERROR":U TO SELF.
     1147   END.
     1148   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1149   DO:
     1150   define variable loc#log as logical no-undo.
     1151   define variable loc-doc-rec as recid no-undo .
     1152   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1153   do:
     1154     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1155       (input  v-cntxt-db-num
     1156       ,input  v-cntxt-userid
     1157       ,input  0
     1158       ,input  'actn_delivery-storage_work':U
     1159       ,input  'global':U
     1160       ,input  0
     1161       ,input  '':U
     1162       ,input  0
     1163       ,input  0
     1164       ,input  0
     1165       ,input  0
     1166       ,input  true
     1167       ,output loc#log
     1168       )  .
     1169   end.
     1170   if not loc#log then return no-apply.
     1171   run ref/vrdlgrpi.w
     1172                 (
     1173                    input parParentProc
     1174                   ,input p-curr-obj-type
     1175                   ,input p-curr-obj-code
     1176                   ,input 'ДОБАВЛЕНИЕ':U
     1177                   ,input (if p-mode = "delivery-type-subject" or p-mode = "variant-delivery"
     1178                           then p-deliv-type-code
     1179                           else 0)
     1180                   ,input (if p-mode = "delivery-type-subject" or p-mode = "variant-delivery"
     1181                           then p-deliv-subj-code
     1182                           else 0)
     1183                   ,input (if p-mode = 'объект':U or p-mode = "group-period-validity":U
     1184                           or p-mode = "variant-delivery"
     1185                           then p-deliv-obj-type
     1186                           else "":U)
     1187                   ,input (if p-mode = 'объект':U or p-mode = "group-period-validity":U
     1188                           or p-mode = "variant-delivery"
     1189                           then p-deliv-obj-code
     1190                           else 0)
     1191                   ,input (if p-mode = "group-period-validity"
     1192                           then p-gr-per-val-code
     1193                           else 0)
     1194                   ,input-output loc-doc-rec
     1195                               ) no-error
     1196   .
     1197   if loc-doc-rec <> ? then do:
     1198     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     1199     reposition br-vardeliv to recid loc-doc-rec no-error.
     1200     if error-status:error then do:                           find first pos_var-deliv-gr-per-val no-lock where                                   recid(pos_var-deliv-gr-per-val) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ВАРИАНТ ДОСТАВКИ ПО ГРУППАМ СРОКОВ ГОДНОСТИ" skip                            string(if avail pos_var-deliv-gr-per-val                                     then  substitute("Вн код типа доставки: &1 вн код субъекта доставки: &2 объект доставки: &3&4 вн уод группы сроков годности &5"                                                     , pos_var-deliv-gr-per-val.deliv-type-code                                                     , pos_var-deliv-gr-per-val.deliv-subj-code                                                     , pos_var-deliv-gr-per-val.obj-type                                                     , pos_var-deliv-gr-per-val.obj-code                                                     , pos_var-deliv-gr-per-val.gr-per-val-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1201   end.
     1202   apply "entry" to br-vardeliv in frame Dialog-Frame.
     1203   apply "value-changed" to br-vardeliv in frame Dialog-Frame.
     1204   END.
     1205   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1206   DO:
     1207     DEFINE variable loc#log as logical no-undo.
     1208   define variable loc-doc-rec as recid no-undo .
