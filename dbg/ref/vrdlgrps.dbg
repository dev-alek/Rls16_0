     2904   MAIN-BLOCK:
     2905   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2906      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2907   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2908     run mainmenu_getcntxt in parparentproc
     2909       (output v-cntxt-db-num
     2910       ,output v-cntxt-userid
     2911       ,output v-cntxt-level
     2912       ,output v-cntxt-host-code-obj
     2913       ,output v-cntxt-obj-type
     2914       ,output v-cntxt-obj-code
     2915       ,output v-cntxt-db-num-obj
     2916       ,output v-cntxt-is-admin
     2917       ) .
     2918     v-rid-list = p-rid-list.
     2919     find first X_curr_clients no-lock where
     2920               X_curr_clients.obj-type = p-curr-obj-type
     2921          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
     2922     if not available X_curr_clients then do:
     2923       message
     2924       vss-workfile vss-revision vss-description skip
     2925       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
     2926       p-curr-obj-type p-curr-obj-code
     2927       view-as alert-box ERROR.
     2928       return error .
     2929     end.
     2930    if LOOKUP(p-mode, ('все':U + chr(4) +
     2931                       "delivery-type-subject":U + chr(4) +
     2932                       'объект':U + chr(4) +
     2933                       "variant-delivery":U + chr(4) +
     2934                       "group-period-validity":U ) ,
     2935                   chr(4)) = 0
     2936        then dO:
     2937       message
     2938       vss-workfile vss-revision vss-description skip
     2939       "Неверное значение параметров вызова p-mode"
     2940       p-mode
     2941       view-as alert-box ERROR.
     2942       return error .
     2943    end.
     2944    IF p-mode = "delivery-type-subject"
     2945    or p-deliv-type-code <> 0
     2946    THEN DO:
     2947        FIND FIRST X_delivery-type NO-LOCK WHERE
     2948                   X_delivery-type.deliv-type-code = p-deliv-type-code NO-ERROR.
     2949       IF NOT AVAILABLE X_delivery-type THEN DO:
     2950           MESSAGE
     2951           vss-workfile vss-revision vss-description skip
     2952           "Неверное значение параметров вызова p-deliv-type-code"
     2953           p-DELIV-TYPE-CODE
     2954           view-as alert-box ERROR.
     2955           return error .
     2956      END.
     2957    END.
     2958   IF p-mode = "delivery-type-subject":U
     2959   or p-deliv-subj-code <> 0
     2960   THEN DO:
     2961        FIND FIRST X_delivery-subject NO-LOCK WHERE
     2962                   X_delivery-subject.deliv-subj-code = p-deliv-subj-code NO-ERROR.
     2963       IF NOT AVAILABLE X_delivery-subject THEN DO:
     2964           MESSAGE
     2965           vss-workfile vss-revision vss-description skip
     2966           "Неверное значение параметров вызова p-deliv-subj-code" skip
     2967           p-deliv-subj-code
     2968           view-as alert-box ERROR.
     2969           return error .
     2970      END.
     2971    END.
     2972    if p-mode = 'объект':U
     2973    or p-mode = "group-period-validity":U
     2974    or p-deliv-obj-type <> "":U
     2975    or p-deliv-obj-code <> 0
     2976     then do:
     2977       FIND FIRST X_clients no-lock where
     2978                 X_clients.obj-type = p-deliv-obj-type
     2979            AND  X_clients.obj-code = p-deliv-obj-code no-error .
     2980       if not available X_clients then do:
     2981           MESSAGE
     2982           vss-workfile vss-revision vss-description skip
     2983           "Неверное значение параметров вызова p-deliv-obj-type и/или p-deliv-obj-code"
     2984           p-DELIV-obj-type p-deliv-obj-CODE
     2985           view-as alert-box ERROR.
     2986           return error .
     2987       end.
     2988    end.
     2989    if p-mode = "variant-delivery":U then do:
     2990        FIND FIRST X_variant-delivery NO-LOCK WHERE
     2991                 X_variant-delivery.deliv-type-code = p-deliv-type-code
     2992              AND X_variant-delivery.deliv-subj-code = p-deliv-subj-code
     2993              AND X_variant-delivery.obj-type = p-deliv-obj-type
     2994              AND X_variant-delivery.obj-code = p-deliv-obj-code        NO-ERROR.
     2995       IF NOT AVAILABLE X_variant-delivery THEN DO:
     2996           MESSAGE
     2997           vss-workfile vss-revision vss-description skip
     2998           "Неверное значение параметров вызова p-deliv-subj-code"
     2999           "и/или p-deliv-type-code" skip
     3000           "и/или p-deliv-obj-type p-deliv-obj-code" skip
     3001           p-DELIV-type-CODE  p-DELIV-subj-CODE p-deliv-obj-type p-deliv-obj-code
     3002           view-as alert-box ERROR.
     3003           return error .
     3004      END.
     3005    end.
     3006    if p-mode = "group-period-validity":U then do:
     3007        FIND FIRST X_group-period-validity NO-LOCK WHERE
     3008                   X_group-period-validity.gr-per-val-code = p-gr-per-val-code NO-ERROR.
     3009       IF NOT AVAILABLE X_group-period-validity THEN DO:
     3010           MESSAGE
     3011           vss-workfile vss-revision vss-description skip
     3012           "Неверное значение параметров вызова p-gr-per-val-code" skip
     3013           p-gr-per-val-code
