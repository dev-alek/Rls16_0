      852   FUNCTION mark-string RETURNS CHARACTER
      853     ( input p-recid as recid, input mark-list as character  ) :
      854     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      855   END FUNCTION.
      856   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      857   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      858   procedure fltopend_fltopend :
      859   define input parameter p-parent-handle as handle no-undo .
      860   define input parameter p-qh as handle no-undo .
      861   define input parameter p-flt-open-open-query  as character no-undo .
      862   define input parameter p-where-cond as character no-undo .
      863   define input parameter p-use-indFIRST-query-tail as character no-undo .
      864   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      865   define input parameter p-indexed-reposition as character no-undo .
      866     do
      867     on error undo, return error
      868     :
      869   define variable v-prepare-string as character no-undo .
      870   define variable glog as logical no-undo .
      871   assign
      872   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      873                      p-where-cond + chr(32)  +
      874                      p-use-indFIRST-query-tail + chr(32) +
      875                      p-use-ind-sort-clmn-by + chr(32) +
      876                      p-indexed-reposition
      877   .
      878   assign
      879   glog = p-qh:query-prepare(v-prepare-string) no-error .
      880   if not glog
      881   or error-status:error then do:
      882     message error-status:get-message(1) view-as alert-box .
      883     undo, return error .
      884   end.
      885   assign
      886   glog = p-qh:query-open no-error .
      887   if not glog
      888   or error-status:error then do:
      889     message error-status:get-message(1) view-as alert-box .
      890     undo, return error .
      891   end.
      892     end.
      893   end procedure.
      894   procedure fltopend_fltfindd :
      895   define input parameter p-parent-handle as handle no-undo .
      896   define input parameter p-qh as handle no-undo .
      897   define input parameter p-rowid as rowid no-undo .
      898   define input parameter p-next as logical no-undo .
      899   define input parameter p-lock as integer no-undo .
      900   define input parameter p-bh as handle no-undo .
      901   define input parameter p-where-cond as character no-undo .
      902   define input parameter p-use-index-phrase as character no-undo .
      903   define variable glog as logical no-undo .
      904   define variable v-qh as handle no-undo .
      905   define variable v-bh as handle no-undo .
      906   define variable v-recid as recid no-undo .
      907   define variable v-prepare-string as character no-undo .
      908   do
      909   on error undo, return error
      910   on stop undo, return error
      911   :
      912     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      913     create buffer v-bh for table p-bh buffer-name p-bh:name.
      914     create query v-qh.
      915     v-qh:set-buffers(v-bh).
      916     v-prepare-string = substitute("for each &1 &2 &3"
      917                                     ,v-bh:name
      918                                     ,p-where-cond
      919                                     ,p-use-index-phrase).
      920     glog = v-qh:query-prepare(v-prepare-string) no-error.
      921     if not glog then do:
      922       delete object v-qh.
      923       delete object v-bh.
      924       undo, return error .
      925     end.
      926     glog = v-qh:query-open no-error .
      927     if not glog then do:
      928       delete object v-qh.
      929       delete object v-bh.
      930       undo, return error .
      931     end.
      932     if p-next then do:
      933       v-qh:reposition-to-rowid(p-rowid) no-error .
      934       glog = v-qh:get-next( p-lock) no-error .
      935       glog = v-qh:get-next( p-lock) no-error .
      936       if not glog or v-qh:query-off-end = yes then do:
      937         glog = v-qh:get-first( p-lock) no-error .
      938       end.
      939     end.
      940     else do:
      941       glog = v-qh:get-first( p-lock) no-error .
      942     end.
      943     v-recid = v-bh:recid no-error .
      944     delete object v-qh.
      945     delete object v-bh.
      946     return string(v-recid) .
      947   end.
      948   end procedure.
      949   procedure fltopend_fltfindq :
      950   define input parameter p-parent-handle as handle no-undo .
      951   define input parameter p-qh as handle no-undo .
      952   define input parameter p-next as logical no-undo .
      953   define input parameter p-lock as integer no-undo .
      954   define input parameter p-flt-open-open-query  as character no-undo .
      955   define input parameter p-where-cond as character no-undo .
      956   define input parameter p-use-indFIRST-query-tail as character no-undo .
      957   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      958   define input parameter p-indexed-reposition as character no-undo .
      959   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      960   define variable glog as logical no-undo .
      961   define variable v-qh as handle no-undo .
      962   define variable v-bh as handle no-undo extent 18.
      963   define variable v-rowid as rowid no-undo extent 18.
      964   define variable v-ii as integer no-undo .
      965   define variable v-prepare-string as character no-undo .
      966   do
      967   on error undo, return error
      968   on stop undo, return error
      969   :
      970     create query v-qh.
      971     do v-ii = 1 to p-qh:num-buffers:
      972       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      973       assign
      974       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      975       no-error.
      976       v-qh:add-buffer(v-bh[v-ii]).
      977     end.
      978     assign
      979     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      980                       p-where-cond + chr(32)  +
      981                       p-use-indFIRST-query-tail + chr(32) +
      982                       p-use-ind-sort-clmn-by + chr(32) +
      983                       p-indexed-reposition
      984     .
      985     glog = v-qh:query-prepare( v-prepare-string) no-error .
      986     if not glog then do:
      987       delete object v-qh.
      988       do v-ii = 1 to p-qh:num-buffers:
      989         delete object v-bh[v-ii].
      990       end.
      991       undo, return error .
      992     end.
      993     glog = v-qh:query-open no-error .
      994     if not glog then do:
      995       delete object v-qh.
      996       do v-ii = 1 to p-qh:num-buffers:
      997         delete object v-bh[v-ii].
      998       end.
      999       undo, return error .
     1000     end.
     1001     if p-next then do:
     1002       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1003       glog = v-qh:get-next( p-lock) no-error .
     1004       glog = v-qh:get-next( p-lock) no-error .
     1005       if not glog or v-qh:query-off-end = yes then do:
     1006         glog = v-qh:get-first( p-lock) no-error .
     1007       end.
     1008     end.
     1009     else do:
     1010       glog = v-qh:get-first( p-lock) no-error .
     1011     end.
     1012     do v-ii = 1 to p-qh:num-buffers:
     1013       assign
     1014       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1015       no-error.
     1016     end.
     1017     delete object v-qh.
     1018     do v-ii = 1 to p-qh:num-buffers:
     1019       delete object v-bh[v-ii].
     1020     end.
     1021   end.
     1022   end procedure.
