      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   def
      118   new shared
      119   temp-table  obj-list no-undo
      120     field obj-type like ub.clients.obj-type
      121     field obj-code like ub.clients.obj-code
      122     field obj-name like ub.clients.obj-name
      123     field obj-id   as integer
      124     field db-num   as integer
      125     index pi is primary unique obj-id
      126     index ie1 obj-type obj-code
      127     index ie2 obj-name
      128   .
      129   procedure create_obj-list :
      130      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      131      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      132      do
      133      on error undo, return error return-value
      134      :
      135         define buffer cli-obj for ub.clients .
      136         define variable p-var as integer no-undo .
      137         define buffer buf_obj-list for obj-list .
      138         find last buf_obj-list  use-index pi no-error .
      139         if available buf_obj-list
      140         then
      141            p-var = buf_obj-list.obj-id + 1.
      142         else
      143            p-var = 1.
      144         find first cli-obj where
      145                   cli-obj.obj-type = p-obj-type
      146               and cli-obj.obj-code = p-obj-code
      147         no-lock no-error.
      148         if available cli-obj
      149         then do:
      150            create buf_obj-list.
      151            assign
      152               buf_obj-list.obj-id   = p-var
      153               buf_obj-list.obj-code = cli-obj.obj-code
      154               buf_obj-list.obj-type = cli-obj.obj-type
      155               buf_obj-list.obj-name = cli-obj.obj-name
      156               buf_obj-list.db-num   = cli-obj.db-num
      157            .
      158         end.
      159      end.
      160   end.
      161   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      162   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      163   define new shared variable RepPathName        as character no-undo .
      164   define new shared variable PrintRubl          as logical   no-undo .
      165   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      166   define  stream PrnLibStream.
      167   procedure prn-lib-prn-file :
      168     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      169     define input parameter p-DIsabledoptions as integer no-undo .
      170     define variable v-report-name as character no-undo .
      171     define variable v-user-action as character no-undo .
      172     define variable v-printed     as logical   no-undo .
      173     define variable v-exist       as logical   no-undo .
      174     do
      175       on error undo, return error
      176       :
      177       run prn-lib-get-report-name  in this-procedure (
      178         input parParentProc
      179         ,output v-report-name
      180         ).
      181   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      182   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      183     (input  v-report-name
      184     ,input  2
      185     ,output v-exist
      186     )  .
      187       if NOT v-exist then
      188       DO:
      189         Message
      190           "Нет заданий на печать ! "
      191           view-as alert-box .
      192         Return  .
      193       End.
      194       run gbl/prnfilen.w
      195         (input  ""
      196         ,input  p-DisabledOptions
      197         ,input  string(v-report-name )
      198         ,input  7
      199         ,output v-user-action
      200         ,output v-printed
      201         ) .
      202       if v-printed then
      203       do:
      204         return "YES" .
      205       end.
      206       else
      207       do:
      208         return "NO" .
      209       end.
      210     end.
      211   end procedure.
      212   procedure prn-lib-open-stream :
      213     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      214     define input parameter p-page-size    as integer no-undo .
      215     define input parameter p-is-stream    as logical no-undo .
      216     define input parameter p-append       as logical no-undo .
      217     define variable v-report-name as character no-undo .
      218     do
      219       on error undo, return error
      220       :
      221       run prn-lib-get-report-name  in this-procedure (
      222         input parParentProc
      223         ,output v-report-name
      224         ).
      225       if p-is-stream then
      226       do:
      227         if p-append then
      228         do:
      229           output stream PrnLibStream to value( v-report-name )
      230             page-size value(p-page-size) append .
      231         end.
      232         if not p-append then
      233         do:
      234           output stream PrnLibStream to value( v-report-name )
      235             page-size value(p-page-size) .
      236         end.
      237       end.
      238       if not p-is-stream then
      239       do:
      240         if p-append then
      241         do:
      242           output to value( v-report-name )
      243             page-size value(p-page-size) append .
      244         end.
      245         if not p-append then
      246         do:
      247           output to value( v-report-name )
      248             page-size value(p-page-size) .
      249         end.
      250       end.
      251     end.
      252   end procedure.
      253   procedure prn-lib-open-exp :
      254     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      255     define input parameter p-is-stream    as logical no-undo .
      256     define input parameter p-is-append    as logical no-undo .
      257     define output parameter p-ReportFileName as char init "report" no-undo.
      258     define output parameter p-process as logical no-undo .
      259     define variable glog as logical no-undo .
      260     do
      261       on error undo, return error
      262       :
      263       SYSTEM-DIALOG GET-FILE p-ReportFileName
      264         TITLE      "Укажите путь"
      265         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      266         ASK-OVERWRITE
      267         CREATE-TEST-FILE
      268         SAVE-AS
      269         USE-FILENAME
      270         DEFAULT-EXTENSION "txt"
      271         UPDATE glog
      272         .
      273       if not glog then  return.
      274       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      275       if p-is-stream then
      276       do:
      277         if p-is-append then
      278         do:
      279           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      280         end.
      281         else
      282         do:
      283           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      284         end.
      285       end.
      286       else
      287       do:
      288         if p-is-append then
      289         do:
      290           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      291         end.
      292         else
      293         do:
      294           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      295         end.
      296       end.
      297       p-process = yes.
      298     end.
      299   end procedure.
      300   procedure prn-lib-get-report-name :
      301     define input parameter parParentProc  as widget-handle no-undo.
      302     define output parameter p-report-name as character no-undo .
      303     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      304   end procedure.
      305   procedure prn-lib-reportviewer-report-name :
      306     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      307     define input parameter p-report-name-html as character no-undo .
      308     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      309   end procedure.
      310   procedure prn-lib-reportviewer :
      311     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      312     define input parameter p-report-name-html as character no-undo .
      313     define input parameter p-param        as character no-undo .
      314     define variable v-excel           as character no-undo init 'TRUE' .
      315     define variable v-value-character as character no-undo .
      316     define variable v-value-integer   as character no-undo .
      317     define variable v-value-date      as date      no-undo .
      318     define variable v-value-decimal   as decimal   no-undo .
      319     define variable rep-excel         as logical   no-undo .
      320     define variable excel-string      as character no-undo .
      321     define variable v-param-type      as character no-undo .
      322     define variable v-tth             as handle    no-undo .
      323     run adm/shattri.p (
      324       input "get":U
      325       ,input  ""
      326       ,input  0
      327       ,input  'report-glob':U
      328       ,input  'rep-excel':U
      329       ,output v-value-character
      330       ,output v-value-date
      331       ,output v-value-decimal
      332       ,output v-value-integer
      333       ,output rep-excel
      334       ,output v-param-type
      335       ,INPUT-OUTPUT table-handle v-tth
      336       )  .
      337     if rep-excel then v-excel = "TRUE" .
      338     else v-excel = "FALSE" .
      339     if p-param eq ""
      340     then
      341        p-param = "EXCEL:" + v-excel.
      342     else
      343        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      344     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      345   end procedure.
      346   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      347   procedure cur-time :
      348      define output parameter p-today as date      no-undo .
      349      define output parameter p-time  as integer   no-undo .
      350     do
      351     on error undo, return error
      352     :
      353       define variable v-date1 as date      no-undo .
      354       define variable v-date2 as date      no-undo .
      355       define variable v-time  as integer   no-undo .
      356       assign
      357         v-date1 = today
      358         v-time  = time
      359         v-date2 = today
      360       .
      361       if v-date1 <> v-date2
      362       then do:
      363         assign
      364           v-date1 = today
      365           v-time  = v-time
      366         .
      367       end.
      368       assign
      369         p-today = v-date1
      370         p-time  = v-time
      371       .
      372     end.
      373   end.
      374   function cur-time-date returns character
      375   :
      376     return string(today, '99/99/9999':U) .
      377   end.
      378   function cur-time-mjd returns decimal
      379   :
      380     define variable v-date as date      no-undo .
      381     define variable v-time as integer   no-undo .
      382     run cur-time in this-procedure
      383       (output v-date
      384       ,output v-time
      385       ) .
      386     return integer(v-date) - 2400002 + (v-time / 86400) .
      387   end.
      388   function cur-time-get-ending-index returns integer
      389   (input p-number as integer
      390   )
      391   :
      392     if p-number < 0
      393     or p-number = ?
      394     then do:
      395       return 1 .
      396     end.
      397     define variable v-rest as integer   no-undo .
      398     assign
      399       p-number = p-number modulo 100
      400     .
      401     if p-number < 20
      402     then do:
      403       assign
      404         v-rest = p-number
      405       .
      406     end.
      407     else do:
      408       assign
      409         v-rest = p-number modulo 10
      410       .
      411     end.
      412     case v-rest :
      413       when 1
      414       then do:
      415         return 2 .
      416       end.
      417       when 2 or
      418       when 3 or
      419       when 4
      420       then do:
      421         return 3 .
      422       end.
      423       otherwise do:
      424         return 1 .
      425       end.
      426     end case .
      427   end.
      428   procedure cur-time-mjd-to-date :
      429      define input  parameter i-mjd-diff as decimal no-undo.
      430      define output parameter o-Date     as date    no-undo.
      431      define output parameter o-Time     as integer no-undo.
      432      define variable v-day-number as integer   no-undo .
      433      if    i-mjd-diff < 0
      434         or i-mjd-diff = ?
      435      then do:
      436         return "?" .
      437      end.
      438      assign
      439         v-day-number = truncate(i-mjd-diff,0).
      440         o-Date = date(v-day-number + 2400002).
      441         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      442     .
      443   end.
      444   function cur-time-mjd-to-string returns character
      445   (input p-mjd-diff as decimal
      446   )
      447   :
      448     define variable v-day-number as integer   no-undo .
      449     define variable v-seconds    as integer   no-undo .
      450     define variable v-hour       as integer   no-undo .
      451     define variable v-min        as integer   no-undo .
      452     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      453     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      454     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      455     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      456     if p-mjd-diff < 0
      457     or p-mjd-diff = ?
      458     then do:
      459       return "?" .
      460     end.
      461     assign
      462       v-day-number = integer(truncate(p-mjd-diff,0))
      463       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      464     .
      465     if v-seconds > 86400
      466     then do:
      467       assign
      468         v-seconds = 86400 - 1
      469       .
      470     end.
      471     if v-seconds < 0
      472     then do:
      473       assign
      474         v-seconds = 0
      475       .
      476     end.
      477     assign
      478       v-hour = truncate(v-seconds / 3600, 0)
      479     .
      480     assign
      481       v-seconds = v-seconds modulo 3600
      482     .
      483     assign
      484       v-min = truncate(v-seconds / 60, 0)
      485     .
      486     assign
      487       v-seconds = v-seconds modulo 60
      488     .
      489     return
      490         (if v-day-number <> 0
      491           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      492           else ""
      493         )
      494       + (if v-day-number <> 0 or v-hour <> 0
      495           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      496           else ""
      497         )
      498       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      499           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      500           else ""
      501         )
      502       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      503       .
      504   end.
      505   function cur-time-string returns character
      506   :
      507     define variable v-date as date      no-undo .
      508     define variable v-time as integer   no-undo .
      509     run cur-time in this-procedure
      510       (output v-date
      511       ,output v-time
      512       ) .
      513     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      514   end.
      515   function cur-time-string-sec returns character
      516   :
      517     define variable v-date as date      no-undo .
      518     define variable v-time as integer   no-undo .
      519     run cur-time in this-procedure
      520       (output v-date
      521       ,output v-time
      522       ) .
      523     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      524   end.
      525   function cur-time-custom  returns character
      526   (input p-prefix as character
      527   ,input p-date-format as character
      528   ,input p-delimiter as character
      529   ,input p-time-format as character
      530   ,input p-suffix as character
      531   )
      532   :
      533     define variable v-date as date      no-undo .
      534     define variable v-time as integer   no-undo .
      535     run cur-time in this-procedure
      536       (output v-date
      537       ,output v-time
      538       ) .
      539     return
      540       p-prefix
      541       + string(v-date, p-date-format)
      542       + p-delimiter
      543       + string(v-time, p-time-format)
      544       + p-suffix
      545       .
      546   end.
      547   function cur-time-print  returns character
      548   :
      549     define variable v-date as date      no-undo .
      550     define variable v-time as integer   no-undo .
      551     run cur-time in this-procedure
      552       (output v-date
      553       ,output v-time
      554       ) .
      555     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      556   end.
      557   function cur-time-datetime returns datetime
      558   :
      559     define variable v-char as character no-undo .
      560     define variable v-datetime as datetime no-undo .
      561     v-char = cur-time-string().
      562     v-datetime = datetime(v-char).
      563     return  v-datetime.
      564   end.
      565   function cur-time-string-msec returns character
      566   :
      567     define variable v-date as datetime  no-undo .
      568     v-date = now.
      569     return string(v-date) .
      570   end.
      571   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      572   define variable v-waitfram-action01         as character   no-undo .
      573   define variable v-waitfram-action02         as character   no-undo .
      574   define variable v-waitfram-action03         as character   no-undo .
      575   define variable mWaitFramTextBeg            as character   no-undo.
      576   define variable mWaitFramTextEnd            as character   no-undo.
      577   define variable mWaitFramView               as logical     no-undo.
      578   define variable mWaitProcEvent              as logical     no-undo init yes.
      579   define variable mWaitFramInterval           as integer     no-undo init 1 .
      580   define variable mWaitFramStop               as logical     no-undo.
      581   define variable mWaitFramStopUser           as logical     no-undo.
      582   define variable mWaitFramStopTimeOut        as logical     no-undo.
      583   define variable mWaitFramStartProc          as datetime-tz no-undo.
      584   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      585   define button B-WaitFramStop auto-end-key
      586        label "Стоп"
      587        size 10 by 1 tooltip "Остоновить процесс".
      588   define button B-viewProcInfo
      589        label "Информация"
      590        size 15 by 1 tooltip "Информация о процесс".
      591   define frame waitfram
      592     v-waitfram-action01 format "x(72)" no-label skip
      593     v-waitfram-action02 format "x(72)" no-label skip
      594     v-waitfram-action03 format "x(72)" no-label skip
      595     B-viewProcInfo
      596     B-WaitFramStop at row 4 col 30
      597     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      598     .
      599   define new global shared variable mBatchMode as logical no-undo init ?.
      600   define variable mFramBachModHandle as handle no-undo.
      601   mFramBachModHandle = frame waitfram:handle.
      602   define variable mFameOldVis as logical no-undo.
      603   define variable mVisCUrentVin as logical no-undo.
      604   if session:batch-mode
      605   then
      606      mBatchMode = yes.
      607   if mBatchMode = ? then do:
      608     mVisCUrentVin = current-window:visible.
      609     mFameOldVis = mFramBachModHandle:visible.
      610     mFramBachModHandle:visible  = yes.
      611     mBatchMode = mFramBachModHandle:visible ne yes.
      612     mFramBachModHandle:visible = mFameOldVis.
      613     current-window:visible = mVisCUrentVin.
      614   end.
      615    if  log-manager:logfile-name ne ?
      616     then DO:
      617         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      618         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      619         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      620     end.
      621   on choose of B-WaitFramStop in frame waitfram
      622   do:
      623     mWaitFramStop = yes.
      624     mWaitFramStopUser = yes.
      625   end.
      626   function waitfram-check-timeout returns logical():
      627      define variable vtime as int64 no-undo.
      628      if mWaitFramStopTimeOut
      629      then
      630         return yes.
      631      vtime = ( now - mWaitFramStartProc ) / 1000 .
      632      if     mWaitFramTimeOut ne ?
      633         and mWaitFramTimeOut ne 0
      634         and mWaitFramTimeOut lt vtime
      635      then do:
      636         mWaitFramStopTimeOut = yes.
      637      end.
      638      return mWaitFramStopTimeOut.
      639   end.
      640   procedure waitfram-hide :
      641     if not session:batch-mode
      642     then do
      643     on error undo, return error return-value
      644     :
      645       pause 0 before-hide .
      646       if not mBatchMode then
      647         hide frame waitfram .
      648     if     not mWaitFramView
      649        and mWaitProcEvent
      650     then
      651       process events .
      652     end.
      653   end procedure.
      654   procedure waitfram-show :
      655     define input  parameter p-message as character no-undo .
      656     define variable v-left-margin as integer   no-undo .
      657     if not session:batch-mode
      658     then do
      659     on error undo, return error return-value
      660     :
      661       if length(p-message) <= 70 then do:
      662         assign
      663           v-left-margin = integer((70 - length(p-message)) / 2)
      664         .
      665         assign
      666           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      667         .
      668         assign
      669           v-waitfram-action01 = " "
      670           v-waitfram-action02 = " "
      671                                    + fill(" ", v-left-margin)
      672                                    + p-message
      673           v-waitfram-action03 = " "
      674         .
      675       end.
      676       else do:
      677         define variable vRindex1 as integer no-undo.
      678         define variable vRindex2 as integer no-undo.
      679         vRindex1 = r-index(p-message," ",70).
      680         if vRindex1 = 0
      681         then
      682            vRindex1 = 70.
      683         if length(p-message)  <= vRindex1 + 70 then do:
      684           assign
      685             v-waitfram-action01 = " "
      686             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      687             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      688           .
      689         end.
      690         else do:
      691           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      692           if vRindex2 <= vRindex1
      693           then
      694              vRindex2 = vRindex1 + 70.
      695           assign
      696             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      697             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      698             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      699           .
      700         end.
      701       end.
      702       B-viewProcInfo:visible   in frame waitfram = no.
      703       B-viewProcInfo:sensitive in frame waitfram = no.
      704       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      705       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      706       if  (   mWaitFramView
      707          or  mWaitProcEvent)
      708          and not mBatchMode
      709       then
      710          display
      711             v-waitfram-action01 skip
      712             v-waitfram-action02 skip
      713             v-waitfram-action03 skip
      714          with frame waitfram .
      715       if     mWaitFramView
      716          then do:
      717             if     mWaitFramInterval ne ?
      718                and not mBatchMode
      719             then
      720                wait-for go of frame waitfram pause mWaitFramInterval.
      721          end.
      722          else
      723             if     mWaitProcEvent
      724                and not mBatchMode
      725             then
      726                process events .
      727     end.
      728   end procedure.
      729      procedure waitfram-show-this:
      730         define input  parameter iInterval as int64 no-undo.
      731         define variable vtime as int64 no-undo.
      732         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      733         mWaitFramInterval = iInterval.
      734         run waitfram-show (substitute("&1&2 &3&4" ,
      735                                       mWaitFramTextBeg ,
      736                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      737                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      738                                       mWaitFramTextEnd
      739                                      )
      740                           ).
      741      end.
      742      procedure WaitFramRunPause:
      743         define input  parameter iInterval as dec no-undo.
      744         define variable vStart  as datetime-tz no-undo.
      745         define variable vend    as datetime-tz no-undo.
      746         define variable vint as int64 no-undo.
      747         define variable vOk as logical no-undo.
      748         vStart = now.
      749         vend   = vStart.
      750         publish "WaitFramPause" (iInterval,output vOk).
      751         vend   =  now.
      752         vint = vend - vStart.
      753         vint = iInterval - vint / 1000.
      754         if     not mWaitFramStop
      755            and (   vint > 0
      756                 or (    not vOk
      757                     and iInterval eq ?
      758                     )
      759                 )
      760         then
      761            run waitfram-show-this (iInterval).
      762         vend   =  now.
      763         vint = vend - vStart.
      764         vint = iInterval - vint / 1000.
      765         if     not mWaitFramStop
      766            and vint > 0
      767         then do:
      768            run gbl/pause.p (vint * 1000).
      769         end.
      770         if iInterval ne ?
      771         then
      772            publish "WaitFramStop".
      773         waitfram-check-timeout().
      774      end.
      775      procedure WaitFramWaitFor:
      776         define input  parameter iInterval as dec no-undo.
      777         assign
      778            mWaitFramStartProc   = now
      779            mWaitFramStopUser    = no
      780            mWaitFramStopTimeOut = no
      781         .
      782         block-wait:
      783         do while not mWaitFramStop:
      784            run WaitFramRunPause (iInterval).
      785            if  waitfram-check-timeout()
      786            then do:
      787               leave block-wait.
      788            end.
      789         end.
      790         run waitfram-hide.
      791      end.
      792   procedure waitfram-join :
      793     define input  parameter p-line-1  as character no-undo .
      794     define input  parameter p-line-2  as character no-undo .
      795     define input  parameter p-line-3  as character no-undo .
      796     define output parameter p-message as character no-undo .
      797     do
      798     on error undo, return error return-value
      799     :
      800       assign
      801         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      802                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      803                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      804       .
      805     end.
      806   end procedure.
      807   function waitfram-join-function returns character
      808     (input p-line-1 as character
      809     ,input p-line-2 as character
      810     ,input p-line-3 as character
      811     ).
      812     define variable v-message as character no-undo .
      813     run waitfram-join in this-procedure
      814       (input  p-line-1
      815       ,input  p-line-2
      816       ,input  p-line-3
      817       ,output v-message
      818       ) .
      819     return v-message .
      820   end function .
