     1445        LABEL "Истори&я"
     1446        SIZE 3 BY 1.
     1447   DEFINE BUTTON b-mark
     1448        LABEL "&*":L
     1449        SIZE 3 BY 1.
     1450   DEFINE BUTTON b-print
     1451        LABEL "П&ечать":L
     1452        SIZE 3 BY 1.
     1453   DEFINE BUTTON b-quit AUTO-GO
     1454        LABEL "&Выход ":L
     1455        SIZE 10 BY 1.
     1456   DEFINE BUTTON b-sel AUTO-GO
     1457        LABEL "Вы&бор ":L
     1458        SIZE 10 BY 1.
     1459   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>9":U INITIAL 0
     1460        VIEW-AS FILL-IN
     1461        SIZE 6.25 BY 1
     1462        FGCOLOR 10  NO-UNDO.
     1463   DEFINE QUERY br-sumgrps FOR
     1464         X_sum-grp SCROLLING.
     1465   DEFINE BROWSE br-sumgrps
     1466     QUERY br-sumgrps NO-LOCK DISPLAY
     1467         if lookup(string(recid(X_sum-grp)), v-rid-list) > 0 then "*" else "":U FORMAT "X(1)":U
     1468     X_sum-grp.grp-code FORMAT "999":U width 10
     1469     X_sum-grp.grp-name COLUMN-LABEL "Наименование группы" FORMAT "X(65)":U
     1470       WITH SEPARATORS SIZE 87 BY 18.83
     1471            BGCOLOR 15 FGCOLOR 0 .
     1472   DEFINE FRAME d-sum-grp
     1473        b-quit AT ROW 1 COL 1
     1474        b-mark AT ROW 1 COL 15
     1475        b-sel AT ROW 1 COL 18
     1476        b-add AT ROW 1 COL 28
     1477        b-chg AT ROW 1 COL 38
     1478        b-del AT ROW 1 COL 48
     1479        b-disc AT ROW 1 COL 58 WIDGET-ID 2
     1480        b-goods AT ROW 1 COL 68
     1481        b-hist AT ROW 1 COL 80.13
     1482        b-print AT ROW 1 COL 83.13
     1483        b-help AT ROW 1 COL 86.13
     1484        mark-num AT ROW 1.04 COL 9.13 COLON-ALIGNED NO-LABEL
     1485        br-sumgrps AT ROW 2.92 COL 2.5
     1486        SPACE(1.37) SKIP(0.20)
     1487       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1488            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1489            TITLE "ГРУППЫ ТОВАРОВ НА КАССАХ":L.
     1490   ASSIGN
     1491          FRAME d-sum-grp:SCROLLABLE       = FALSE.
     1492   ASSIGN
     1493          b-disc:POPUP-MENU IN FRAME d-sum-grp       = MENU MENU-b-disc:HANDLE.
     1494   ASSIGN
     1495          b-goods:POPUP-MENU IN FRAME d-sum-grp       = MENU MENU-b-goods:HANDLE.
     1496   ON END-ERROR OF FRAME d-sum-grp
     1497   OR ENDKEY OF FRAME d-sum-grp DO:
     1498      run gbl/markqwa.p (
     1499                              input b-mark:sensitive
     1500                             , input v-rid-list) no-error.
     1501       if error-status:error then return no-apply.
     1502     run proc-send in this-procedure no-error.
     1503   END.
     1504   ON GO OF FRAME d-sum-grp
     1505   DO:
     1506     p-rid-list = v-rid-list.
     1507     run proc-send in this-procedure no-error.
     1508   END.
     1509   ON CHOOSE OF b-add IN FRAME d-sum-grp
     1510   DO:
     1511   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1512   do:
     1513     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1514       (input  v-cntxt-db-num
     1515       ,input  v-cntxt-userid
     1516       ,input  0
     1517       ,input  'actn_group-goods-cash-desk_add-def':U
     1518       ,input  'global':U
     1519       ,input  0
     1520       ,input  '':U
     1521       ,input  0
     1522       ,input  0
     1523       ,input  0
     1524       ,input  0
     1525       ,input  true
     1526       ,output glog
     1527       )  .
     1528   end.
     1529   if NOT glog then return no-apply .
     1530   run ref/sum-grpi.w (  input parparentproc
     1531                       , input 'ДОБАВЛЕНИЕ':U
     1532                       , input-output rr ).
     1533   if rr <> ? then  do:
     1534     FIND b_sum-grp WHERE recid( b_sum-grp ) = rr NO-LOCK .
     1535     rr = recid( b_sum-grp ) .
     1536     run grp-sending in this-procedure ("U":U) no-error .
     1537     if error-status:error then return no-apply.
     1538     OPEN QUERY br-sumgrps FOR EACH X_sum-grp NO-LOCK     BY X_sum-grp.grp-code INDEXED-REPOSITION.
     1539     reposition br-sumgrps to recid rr.
     1540     log-res  = br-sumgrps:select-focused-row( ).
     1541     apply "ENTRY":U to br-sumgrps.
     1542   end.
     1543   END.
     1544   ON CHOOSE OF b-chg IN FRAME d-sum-grp
     1545   DO:
     1546   DEFINE VARIABLE V-OLD-NAME LIKE UB.SUM-GRP.GRP-NAME NO-UNDO.
     1547   if not available X_sum-grp THEN    return no-apply.
     1548   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1549   do:
     1550     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1551       (input  v-cntxt-db-num
     1552       ,input  v-cntxt-userid
     1553       ,input  0
     1554       ,input  'actn_group-goods-cash-desk_update':U
     1555       ,input  'global':U
     1556       ,input  0
     1557       ,input  '':U
     1558       ,input  0
     1559       ,input  0
     1560       ,input  0
     1561       ,input  0
     1562       ,input  true
     1563       ,output glog
     1564       )  .
     1565   end.
     1566   if NOT glog then  return no-apply .
     1567   rr = recid( X_sum-grp ).
     1568   find first b_sum-grp where
     1569               recid(b_sum-grp) = RR NO-ERROR.
     1570   IF NOT AVAIL B_SUM-GRP THEN RETURN NO-APPLY.
     1571   ASSIGN
     1572   V-OLD-NAME = B_SUM-GRP.GRP-NAME
     1573   .
     1574   run ref/sum-grpi.w ( input parparentproc
     1575                        ,input 'ИЗМЕНЕНИЕ':U
     1576                        ,input-output rr ).
     1577   find first b_sum-grp where
     1578               recid(b_sum-grp) = RR NO-ERROR.
     1579   if B_SUM-GRP.GRP-NAME <> V-OLD-NAME then do:
     1580       run GRP-sending IN THIS-PROCEDURE ("U":U) no-error .
     1581       if error-status:error then return no-apply.
     1582     end.
     1583   OPEN QUERY br-sumgrps FOR EACH X_sum-grp NO-LOCK     BY X_sum-grp.grp-code INDEXED-REPOSITION.
     1584   reposition br-sumgrps to recid rr .
     1585   END.
     1586   ON CHOOSE OF b-del IN FRAME d-sum-grp
     1587   DO:
     1588   DEFINE VARIABLE V-OLD-NAME LIKE UB.SUM-GRP.GRP-NAME NO-UNDO.
     1589   if not available X_sum-grp THEN  return no-apply.
     1590   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1591   do:
     1592     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1593       (input  v-cntxt-db-num
     1594       ,input  v-cntxt-userid
     1595       ,input  0
     1596       ,input  'actn_group-goods-cash-desk_update':U
     1597       ,input  'global':U
     1598       ,input  0
     1599       ,input  '':U
     1600       ,input  0
     1601       ,input  0
     1602       ,input  0
     1603       ,input  0
     1604       ,input  true
     1605       ,output glog
     1606       )  .
     1607   end.
     1608   if NOT glog then  return no-apply .
     1609   rr = recid( X_sum-grp ).
     1610   find first b_sum-grp where
     1611               recid(b_sum-grp) = RR NO-ERROR.
     1612   IF NOT AVAIL B_SUM-GRP THEN RETURN NO-APPLY.
     1613   run grp-sending in this-procedure ("D":U) no-error .
     1614   if error-status:error then return no-apply.
     1615   delete b_sum-grp.
     1616   OPEN QUERY br-sumgrps FOR EACH X_sum-grp NO-LOCK     BY X_sum-grp.grp-code INDEXED-REPOSITION.
     1617   reposition br-sumgrps to row 1 no-error  .
     1618   END.
     1619   ON CHOOSE OF b-disc IN FRAME d-sum-grp
     1620   DO:
     1621    if not available X_sum-grp THEN return no-apply.
     1622     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1623     if dgrpr-option = "":U then do:
     1624       run gbl/pop-up.p ( input self :handle
     1625                        , input no ) no-error.
     1626       if error-status :error then do:
     1627           return no-apply.
     1628       end.
     1629     end.
     1630     if dgrpr-option = "":U then do:
     1631         return no-apply.
     1632     end.
     1633     run ref/disgrpui.w ( input parparentproc
     1634                   ,input dgrpr-option
     1635                   ,input 'sum-grp':U
     1636                   ,input v-cntxt-host-code-obj
     1637                   ,input v-cntxt-obj-type
     1638                   ,input v-cntxt-obj-code
     1639                   ,input X_sum-grp.grp-code
     1640                  ) NO-ERROR.
     1641   END.
     1642   ON CHOOSE OF b-goods IN FRAME d-sum-grp
     1643   DO:
     1644    if not available X_sum-grp THEN return no-apply.
     1645     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1646     if dgrpr-option = "":U then do:
     1647       run gbl/pop-up.p ( input self :handle
     1648                        , input no ) no-error.
     1649       if error-status :error then do:
     1650           return no-apply.
     1651       end.
     1652     end.
     1653     if dgrpr-option = "":U then do:
     1654         return no-apply.
     1655     end.
     1656     if dgrpr-option = 'sum-grp-gl':U then do:
     1657     run ref/sum-gds.w (input parparentproc
     1658                        ,input dgrpr-option
     1659                        ,input X_sum-grp.grp-code
     1660                        ,input v-cntxt-host-code-obj
     1661                        ,input v-cntxt-obj-type
     1662                        ,input v-cntxt-obj-code
     1663                        ,input X_sum-grp.grp-name
     1664                  ) NO-ERROR.
     1665     end.
     1666     if dgrpr-option = 'sum-grp':U then do:
     1667     run ref/sum-gds-obj.w (input parparentproc
     1668                           ,input dgrpr-option
     1669                           ,input string (X_sum-grp.grp-code, "999")
     1670                           ,input v-cntxt-host-code-obj
     1671                           ,input v-cntxt-obj-type
     1672                           ,input v-cntxt-obj-code
     1673                           ,input X_sum-grp.grp-name
     1674                  ) NO-ERROR.
     1675     end.
     1676   END.
     1677   ON CHOOSE OF b-hist IN FRAME d-sum-grp
     1678   DO:
     1679       DEFINE VARIABLE v-loc-rid-list AS CHARACTER NO-UNDO.
     1680       IF AVAILABLE X_sum-grp THEN DO:
     1681         run ref/csumgrps.w (
     1682                        INPUT parparentproc
     1683                       ,INPUT '':U
     1684                       ,INPUT 'one':U
     1685                       ,INPUT X_sum-grp.grp-code
     1686                       ,input '':U
     1687                       ,INPUT-OUTPUT v-loc-rid-list) NO-ERROR.
     1688       END.
     1689       apply "entry" to br-sumgrps.
     1690   END.
     1691   ON CHOOSE OF b-mark IN FRAME d-sum-grp
     1692   DO:
     1693     if available X_sum-grp then do:
     1694   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1695   define variable v-str-recid12 as character no-undo .
     1696   define variable v-num-entry12 as integer   no-undo .
     1697   assign
     1698     v-str-recid12 = trim( string( recid( X_sum-grp ) , "->>>>>>>>>>>9":U ) )
     1699     v-num-entry12 = lookup( v-str-recid12 , v-rid-list )
     1700   .
     1701   if v-num-entry12 > 0 then do:
     1702     assign
     1703       entry( v-num-entry12, v-rid-list ) = "":U
     1704       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1705     .
     1706   end.
     1707   else do:
     1708     assign
     1709       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid12
     1710     .
     1711   end.
     1712       glog = br-sumgrps:refresh() .
     1713       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1714               glog = br-sumgrps:select-next-row ().
     1715               apply "iteration-changed" to br-sumgrps in frame d-sum-grp.
     1716         end.
     1717       if num-entries( v-rid-list ) = 0 then
     1718           hide mark-num in frame d-sum-grp.
     1719       else
     1720           disp num-entries( v-rid-list ) @ mark-num with frame d-sum-grp.
     1721     end.
     1722     apply "entry" to br-sumgrps in frame d-sum-grp.
     1723   END.
     1724   ON CHOOSE OF b-print IN FRAME d-sum-grp
     1725   DO:
     1726     define variable sym1 as char init ":"   no-undo.
     1727     define variable sym2 as char init ":"   no-undo.
     1728     define variable sym3 as char init ":"   no-undo.
     1729     define variable Line                    as char         no-undo.
     1730     define variable ii      as integer   no-undo.
     1731     define variable StartRecid      as integer   no-undo.
     1732     DEFINE FRAME List
     1733         sym1 column-label ":" format "x(1)"
     1734         X_sum-grp.grp-code column-label 'код':U format ">>9"
     1735         sym2 column-label ":" format "x(1)"
     1736         X_sum-grp.grp-name column-label 'название':U format "x(50)"
     1737         sym3 column-label ":" format "x(1)"
     1738         HEADER
     1739         cur-time-print() AT 5 format "X(35)"
     1740         string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>9") )
     1741         AT 43 format "X(15)" SKIP
     1742         line format "x(60)" AT 1
     1743         with width 160 down use-text stream-io no-box .
     1744     if num-results( "br-sumgrps" ) = 0 then  do:
     1745       message
     1746       "Список  П У С Т !"
     1747       skip
     1748       view-as alert-box information .
     1749       return no-apply .
     1750     end.
     1751     if session:set-wait-state( "compiler" ) then .
     1752     Line = fill( "-" , 100 ) .
     1753     StartRecid = recid( X_sum-grp ) .
     1754     DO WHILE available X_sum-grp :
     1755         GET prev br-sumgrps NO-LOCK .
     1756     END.
     1757     GET next br-sumgrps NO-LOCK .
     1758     ii = 1 .
     1759     run prn-lib-open-stream  in this-procedure (
     1760                                                 input parParentProc
     1761                                                 ,input 62
     1762                                                 ,input yes
     1763                                                 ,input no
     1764                                                 ).
     1765     FORM HEADER
     1766     Line format "X(130)" SKIP
     1767     "Продолжение - на следующей странице" AT 30 SKIP
     1768     with FRAME CliBottomFrame width 160 PAGE-BOTTOM NO-LABELS no-box.
     1769     VIEW stream PrnLibStream FRAME CliBottomFrame .
     1770     PUT stream PrnLibStream space(10)
     1771     "СПИСОК  ГРУПП  ТОВАРОВ  НА  КАССАХ" format "X(50)" SKIP(2) .
     1772     FORM with frame List .
     1773     DO WHILE available X_sum-grp :
     1774         DISPLAY stream PrnLibStream
     1775         sym1 X_sum-grp.grp-code
     1776         sym2 X_sum-grp.grp-name
     1777         sym3
     1778         with frame List .
     1779         DOWN stream PrnLibStream 1 with frame List .
     1780         ii =  ii + 1 .
     1781         if ( ( ii modulo 10 ) = 0 ) AND ( ii >= 10 ) then
     1782         run waitfram-show in this-procedure ( "Просмотрено строк : " + string( ii ) ) .
     1783         GET next br-sumgrps .
     1784     END.
     1785     PUT stream PrnLibStream Line format "X(60)" SKIP.
     1786     HIDE stream PrnLibStream FRAME CliBottomFrame .
     1787     output stream PrnLibStream close .
     1788     run waitfram-hide in this-procedure .
     1789     run prn-lib-prn-file in this-procedure (
     1790                                           input parParentProc
     1791                                           ,input 0
     1792                                           ).
     1793     reposition br-sumgrps to recid StartRecid NO-ERROR .
     1794   END.
     1795   ON CHOOSE OF b-sel IN FRAME d-sum-grp
     1796   DO:
     1797       if ( available X_sum-grp ) AND (( v-rid-list = "" ) or b-mark:sensitive = no) then
     1798           v-rid-list = string( recid( X_sum-grp ) ) .
     1799   END.
     1800   ON DEFAULT-ACTION OF br-sumgrps IN FRAME d-sum-grp
     1801   DO:
     1802     case yes:
     1803         when  b-chg:sensitive THEN apply "CHOOSE":U to b-chg.
     1804     end case.
     1805   END.
     1806   ON INSERT-MODE OF br-sumgrps IN FRAME d-sum-grp
     1807   OR MOUSE-SELECT-DBLCLICK OF br-sumgrps
     1808   DO:
     1809       if can-do(bttns, "b-mark") then
     1810       apply "choose" to b-mark in frame d-sum-grp .
     1811       else if can-do( bttns, "b-sel" ) then
     1812           apply "choose" to b-sel in frame d-sum-grp .
     1813       else dO:
     1814       end.
     1815   END.
     1816   ON MOUSE-SELECT-DBLCLICK OF br-sumgrps IN FRAME d-sum-grp
     1817   DO:
     1818     if can-do( bttns, "b-sel" ) then do:
     1819       apply "choose" to b-sel in frame d-sum-grp .
     1820       return no-apply .
     1821     end.
     1822   END.
     1823   ON RETURN OF br-sumgrps IN FRAME d-sum-grp
     1824   DO:
     1825       if can-do( bttns, "b-sel" ) then
     1826           apply "choose" to b-sel in frame d-sum-grp .
     1827       else
     1828            apply "DEFAULT-ACTION":U to self.
     1829   END.
     1830   ON CHOOSE OF MENU-ITEM m_lookup-disc
     1831   DO:
     1832     assign
     1833     dgrpr-option = 'ПРОСМОТР':U
     1834     .
     1835     APPLY "CHOOSE" TO b-disc IN FRAME d-sum-grp.
     1836   END.
     1837   ON CHOOSE OF MENU-ITEM m_update-disc
     1838   DO:
     1839       assign
     1840      dgrpr-option = 'ИЗМЕНЕНИЕ':U
     1841      .
     1842      APPLY "CHOOSE" TO b-disc IN FRAME d-sum-grp.
     1843   END.
     1844   ON CHOOSE OF MENU-ITEM m_lookup-goods
     1845   DO:
     1846     assign
     1847     dgrpr-option = 'sum-grp-gl':U
     1848     .
     1849     APPLY "CHOOSE" TO b-goods IN FRAME d-sum-grp.
     1850   END.
     1851   ON CHOOSE OF MENU-ITEM m_update-goods
     1852   DO:
     1853       assign
     1854      dgrpr-option = 'sum-grp':U
     1855      .
     1856      APPLY "CHOOSE" TO b-goods IN FRAME d-sum-grp.
     1857   END.
     1858   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-sum-grp:PARENT eq ?
     1859   THEN FRAME d-sum-grp:PARENT = ACTIVE-WINDOW.
     1860   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1861   on help of frame d-sum-grp
     1862   do:
     1863     run gbl/app_help.p
     1864       (input this-procedure :file-name
     1865       ,input ''
     1866       ,input ?
     1867       ) no-error.
     1868     if error-status :error then do:
     1869       message
     1870         "Ошибка при вызове помощи"
     1871         error-status :get-message(1)
     1872         view-as alert-box .
     1873     end.
     1874   end.
     1875   run minbtn-set in this-procedure .
     1876   on choose of b-help in frame d-sum-grp
     1877   do:
     1878     apply "help":u to frame d-sum-grp .
     1879   end.
     1880   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1881   procedure minbtn-set :
     1882       do
     1883           on error undo, return error return-value
     1884           :
     1885           define variable ii              as integer       no-undo .
     1886           define variable fh              as widget-handle no-undo .
     1887           define variable hh              as widget-handle no-undo .
     1888           define variable v-h             as handle        extent 4 no-undo .
     1889           define variable v-name-button   as character     no-undo .
     1890           define variable v-help-old-x    as decimal       no-undo .
     1891           define variable v-help-old-y    as decimal       no-undo .
     1892           define variable v-help-old-size as decimal       no-undo .
     1893           define variable v-frame-width   as decimal       no-undo .
     1894           define variable jj              as integer       no-undo .
     1895           do
     1896               on error undo, return error
     1897               :
     1898               assign
     1899                   v-frame-width = frame d-sum-grp:width - 0.3
     1900                   fh            = frame d-sum-grp:first-child
     1901                   hh            = fh:first-child
     1902                   ii            = 1
     1903                   .
     1904               do while valid-handle(hh):
     1905                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1906                   do:
     1907                       case lc(hh:name) :
     1908                           when "b-help" then
     1909                               do:
     1910                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1911                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1912                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1913                                   hh:TOOLTIP = "Помощь" .
     1914                                   v-help-old-x = hh:column .
     1915                                   v-help-old-y = hh:row    .
     1916                                   v-help-old-size = hh:width .
     1917                                   hh:width-chars = 2.5 .
     1918                               end.
     1919                           when "b-print" then
     1920                               do:
     1921                                   hh:load-image("cmp/b-print.bmp":u) .
     1922                                   hh:TOOLTIP = "Печать" .
     1923                                   v-h[ii] = hh:handle .
     1924                                   ii = ii + 1 .
     1925                                   hh:width-chars = 3 .
     1926                               end.
     1927                           when "b-history" or
     1928                           when "b-hist" then
     1929                               do:
     1930                                   hh:load-image("cmp/b-hist.bmp":u) .
     1931                                   hh:TOOLTIP = "История" .
     1932                                   v-h[ii] = hh:handle .
     1933                                   ii = ii + 1 .
     1934                                   hh:width-chars = 3 .
     1935                               end.
     1936                           when "b-sch" then
     1937                               do:
     1938                                   hh:load-image("cmp/b-sch.bmp":u) .
     1939                                   hh:TOOLTIP = "Установка Фильтра" .
     1940                                   v-h[ii] = hh:handle .
     1941                                   ii = ii + 1 .
     1942                                   hh:width-chars = 3 .
     1943                               end.
     1944                           when "b-hist-user" then
     1945                               do:
     1946                                   hh:load-image("cmp/b-hist.bmp":u) .
     1947                                   hh:TOOLTIP = "История пользователя" .
     1948                                   ii = ii + 1 .
     1949                               end.
     1950                       end case.
     1951                   end.
     1952                   hh = hh:next-sibling.
     1953               end.
     1954               b-help:column = v-frame-width - b-help:width-chars.
     1955               jj = 0.
     1956               repeat ii = 4 to 1 by -1 :
     1957                   if valid-handle (v-h[ii] ) then
     1958                   do:
     1959                       jj  = jj + 1 .
     1960                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1961                       v-h[ii]:row    = v-help-old-y .
     1962                   end.
     1963               end.
     1964           end.
     1965       end.
     1966   end procedure.
     1967   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1968   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1969   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1970   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1971   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1972   define variable v-diasize-current-frame-height as decimal   no-undo .
     1973   define variable v-diasize-change-size          as logical   no-undo .
     1974   define variable v-diasize-resize-button        as handle    no-undo .
     1975   define variable v-diasize-wndmax               as logical   no-undo .
     1976   define variable v-diasize-wndstore             as logical   no-undo .
     1977   define variable v-diasize-proc-name            as character no-undo .
     1978   define variable v-diasize-browse-handle        as handle    no-undo .
     1979   define variable v-diasize-browse-number        as integer   no-undo .
     1980   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1981   define temp-table temp-diasize-handle no-undo
     1982     field handle-value  as handle
     1983     field save-position as decimal
     1984     index xpk is primary unique handle-value
     1985     .
     1986   define temp-table temp-browse-handle no-undo
     1987     field browse-type   as character
     1988     field browse-number as integer
     1989     field browse-handle as handle
     1990     field original-size as decimal
     1991     index xpk is primary unique browse-type browse-number
     1992     index xie browse-type browse-handle
     1993   .
     1994   procedure diasize_change-height :
     1995     define input  parameter p-change-value  as decimal   no-undo .
     1996     define input  parameter p-move-resize   as logical   no-undo .
     1997     define variable v-field-group-handle    as handle    no-undo .
     1998     define variable v-object-handle         as handle    no-undo .
     1999     define variable v-frame-height          as decimal   no-undo .
     2000     define variable v-frame-virtual-height  as decimal   no-undo .
     2001     define variable v-browse-height         as decimal   no-undo .
     2002     define variable v-window-height         as decimal   no-undo .
     2003     define variable v-window-virtual-height as decimal   no-undo .
     2004     define variable v-change-sign           as integer   no-undo .
     2005     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2006     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2007     if p-change-value > 0
     2008     then do:
     2009       if frame d-sum-grp :height + p-change-value
     2010           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2011       then do:
     2012         assign
     2013           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2014                           - (frame d-sum-grp :height-chars)
     2015         .
     2016         if p-change-value <= 0
     2017         then do:
     2018           run diasize_position-resize-button in this-procedure .
     2019           return .
     2020         end.
     2021       end.
     2022     end.
     2023     if p-change-value < 0
     2024     then do:
     2025       if frame d-sum-grp :height + p-change-value < v-diasize-orig-frame-height
     2026       then do:
     2027         assign
     2028           p-change-value = v-diasize-orig-frame-height
     2029                          - (frame d-sum-grp :height-chars)
     2030         .
     2031         if p-change-value >= 0
     2032         then do:
     2033           run diasize_position-resize-button in this-procedure .
     2034           return .
     2035         end.
     2036       end.
     2037     end.
     2038     if p-change-value >= 0
     2039     then do:
     2040       assign
     2041         v-change-sign = 1
     2042       .
     2043     end.
     2044     else do:
     2045       assign
     2046         v-change-sign = -1
     2047       .
     2048     end.
     2049     assign
     2050       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2051     .
     2052     if p-change-value = 0
     2053     then do:
     2054       run diasize_position-resize-button in this-procedure .
     2055       return .
     2056     end.
     2057     move_block:
     2058     do
     2059     on error undo move_block, retry move_block
     2060     :
     2061       if retry
     2062       then do:
     2063         do
     2064         on error undo move_block, leave move_block
     2065         :
     2066           if p-change-value > 0
     2067           then do:
     2068             for each buf_temp-diasize-handle
     2069             on error undo, next
     2070             :
     2071               assign
     2072                 v-object-handle = buf_temp-diasize-handle.handle-value
     2073               .
     2074               if v-object-handle <> v-diasize-resize-button
     2075               then do:
     2076                 assign
     2077                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2078                 .
     2079               end.
     2080             end.
     2081             assign
     2082               v-diasize-browse-handle :height = v-browse-height
     2083             .
     2084             for each buf_temp-browse-handle
     2085               where buf_temp-browse-handle.browse-type = 'height':u
     2086             on error undo, next
     2087             :
     2088               assign
     2089                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2090               .
     2091             end.
     2092             assign
     2093               frame d-sum-grp :height = v-frame-height
     2094             .
     2095             if frame d-sum-grp :scrollable = true
     2096             then do:
     2097               assign
     2098                 frame d-sum-grp :virtual-height = v-frame-virtual-height
     2099               .
     2100             end.
     2101             run diasize_position-resize-button in this-procedure .
     2102           end.
     2103           else do:
     2104             if frame d-sum-grp :scrollable = true
     2105             then do:
     2106               assign
     2107                 frame d-sum-grp :virtual-height = v-frame-virtual-height
     2108               .
     2109             end.
     2110             assign
     2111               frame d-sum-grp :height = v-frame-height
     2112             .
     2113             assign
     2114               v-diasize-browse-handle :height = v-browse-height
     2115             .
     2116             for each buf_temp-browse-handle
     2117               where buf_temp-browse-handle.browse-type = 'height':u
     2118             on error undo, next
     2119             :
     2120               assign
     2121                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2122               .
     2123             end.
     2124             for each buf_temp-diasize-handle
     2125             on error undo, next
     2126             :
     2127               assign
     2128                 v-object-handle = buf_temp-diasize-handle.handle-value
     2129               .
     2130               if v-object-handle <> v-diasize-resize-button
     2131               then do:
     2132                 assign
     2133                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2134                 .
     2135               end.
     2136             end.
     2137             run diasize_position-resize-button in this-procedure .
     2138           end.
     2139           assign
     2140             v-diasize-change-size = false
     2141           .
     2142           leave move_block .
     2143         end.
     2144       end.
     2145       assign
     2146         v-diasize-need-full-display = true
     2147       .
     2148       if v-diasize-change-size = false
     2149       then do:
     2150         assign
     2151           v-diasize-change-size = true
     2152         .
     2153       end.
     2154       else do:
     2155         return .
     2156       end.
     2157       assign
     2158         v-frame-height = frame d-sum-grp :height
     2159         v-frame-virtual-height = frame d-sum-grp :virtual-height
     2160         v-browse-height = v-diasize-browse-handle :height
     2161       .
     2162       for each buf_temp-browse-handle
     2163         where buf_temp-browse-handle.browse-type = 'height':u
     2164       :
     2165         assign
     2166           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2167         .
     2168       end.
     2169       for each buf_temp-diasize-handle
     2170       :
     2171         delete buf_temp-diasize-handle .
     2172       end.
     2173       assign
     2174         v-field-group-handle = frame d-sum-grp :first-child
     2175       .
     2176       do while valid-handle(v-field-group-handle)
     2177       :
     2178         assign
     2179           v-object-handle = v-field-group-handle :first-child
     2180         .
     2181         do while valid-handle(v-object-handle)
     2182         :
     2183           if  v-object-handle <> v-diasize-browse-handle :handle
     2184           and can-query(v-object-handle, "row")
     2185           and can-query(v-object-handle, "height")
     2186           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2187           then do:
     2188             find first buf_temp-browse-handle
     2189               where buf_temp-browse-handle.browse-type   = 'height':u
     2190                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2191               no-error .
     2192             if available buf_temp-browse-handle
     2193             then do:
     2194             end.
     2195             else do:
     2196               create buf_temp-diasize-handle .
     2197               assign
     2198                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2199                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2200               .
     2201             end.
     2202           end.
     2203           assign
     2204             v-object-handle = v-object-handle :next-sibling
     2205           .
     2206         end.
     2207         assign
     2208           v-field-group-handle = v-field-group-handle :next-sibling
     2209         .
     2210       end.
     2211       do with frame d-sum-grp
     2212       :
     2213         hide v-diasize-resize-button .
     2214         assign
     2215           v-diasize-resize-button :row    = 1
     2216           v-diasize-resize-button :column = 1
     2217         .
     2218       end.
     2219       if p-change-value > 0
     2220       then do:
     2221         if frame d-sum-grp :scrollable = true
     2222         then do:
     2223           assign
     2224             frame d-sum-grp :virtual-height = frame d-sum-grp :virtual-height + p-change-value
     2225             no-error .
     2226           if error-status :error
     2227           or error-status :get-message(1) <> ""
     2228           then do:
     2229             undo move_block, retry move_block .
     2230           end.
     2231         end.
     2232         assign
     2233           frame d-sum-grp :height = frame d-sum-grp :height + p-change-value
     2234           no-error .
     2235         if error-status :error
     2236         or error-status :get-message(1) <> ""
     2237         then do:
     2238           undo move_block, retry move_block .
     2239         end.
     2240         assign
     2241           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2242           no-error .
     2243         if error-status :error
     2244         or error-status :get-message(1) <> ""
     2245         then do:
     2246           undo move_block, retry move_block .
     2247         end.
     2248         for each buf_temp-browse-handle
     2249           where buf_temp-browse-handle.browse-type = 'height':u
     2250         on error undo move_block, retry move_block
     2251         :
     2252           assign
     2253             buf_temp-browse-handle.browse-handle :height
     2254               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2255             no-error .
     2256           if error-status :error
     2257           or error-status :get-message(1) <> ""
     2258           then do:
     2259             undo move_block, retry move_block .
     2260           end.
     2261         end.
     2262         for each buf_temp-diasize-handle
     2263         on error undo move_block, retry move_block
     2264         :
     2265           assign
     2266             v-object-handle = buf_temp-diasize-handle.handle-value
     2267           .
     2268           if v-object-handle <> v-diasize-resize-button
     2269           then do:
     2270             assign
     2271               v-object-handle :row = v-object-handle :row + p-change-value
     2272               no-error .
     2273             if error-status :error
     2274             or error-status :get-message(1) <> ""
     2275             then do:
     2276               undo move_block, retry move_block .
     2277             end.
     2278           end.
     2279         end.
     2280       end.
     2281       else do:
     2282         for each buf_temp-diasize-handle
     2283         on error undo move_block, retry move_block
     2284         :
     2285           assign
     2286             v-object-handle = buf_temp-diasize-handle.handle-value
     2287           .
     2288           if v-object-handle <> v-diasize-resize-button
     2289           then do:
     2290             assign
     2291               v-object-handle :row = v-object-handle :row + p-change-value
     2292               no-error .
     2293             if error-status :error
     2294             or error-status :get-message(1) <> ""
     2295             then do:
     2296               undo move_block, retry move_block .
     2297             end.
     2298           end.
     2299         end.
     2300         assign
     2301           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2302           no-error .
     2303         if error-status :error
     2304         or error-status :get-message(1) <> ""
     2305         then do:
     2306           undo move_block, retry move_block .
     2307         end.
     2308         for each buf_temp-browse-handle
     2309           where buf_temp-browse-handle.browse-type = 'height':u
     2310         on error undo move_block, retry move_block
     2311         :
     2312           assign
     2313             buf_temp-browse-handle.browse-handle :height
     2314               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2315             no-error .
     2316           if error-status :error
     2317           or error-status :get-message(1) <> ""
     2318           then do:
     2319             undo move_block, retry move_block .
     2320           end.
     2321         end.
     2322         assign
     2323           frame d-sum-grp :height = frame d-sum-grp :height + p-change-value
     2324           no-error .
     2325         if error-status :error
     2326         or error-status :get-message(1) <> ""
     2327         then do:
     2328           undo move_block, retry move_block .
     2329         end.
     2330         if frame d-sum-grp :scrollable = true
     2331         then do:
     2332           assign
     2333             frame d-sum-grp :virtual-height = frame d-sum-grp :virtual-height + p-change-value
     2334             no-error .
     2335           if error-status :error
     2336           or error-status :get-message(1) <> ""
     2337           then do:
     2338             undo move_block, retry move_block .
     2339           end.
     2340         end.
     2341       end.
     2342       if p-move-resize = true
     2343       then do:
     2344         run diasize_position-resize-button in this-procedure .
     2345       end.
     2346       if v-diasize-wndstore = true
     2347       then do:
     2348         if connected("ub") = true
     2349         then do:
     2350           define variable v-cntxt-db-num        as integer   no-undo .
     2351           define variable v-cntxt-userid        as character no-undo .
     2352           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2353                                             , OUTPUT v-cntxt-userid
     2354                                             ) .
     2355           run gbl/wndsizew.p
     2356             (input  v-cntxt-db-num
     2357             ,input  v-cntxt-userid
     2358             ,input  v-diasize-proc-name
     2359             ,input  'height':u
     2360             ,input  string(frame d-sum-grp :height - v-diasize-orig-frame-height)
     2361             ) .
     2362         end.
     2363       end.
     2364     end.
     2365     assign
     2366       v-diasize-change-size = false
     2367     .
     2368   end procedure.
     2369   procedure diasize_set-height :
     2370     define input  parameter p-new-height  as decimal   no-undo .
     2371     define input  parameter p-move-resize as logical   no-undo .
     2372     do
     2373     on error undo, return error return-value
     2374     :
     2375       run diasize_change-height in this-procedure
     2376         (input  (p-new-height - frame d-sum-grp :height)
     2377         ,input  p-move-resize
     2378         ) .
     2379     end.
     2380   end procedure.
     2381   procedure diasize_change-width :
     2382     define input  parameter p-change-value as decimal   no-undo .
     2383     define input  parameter p-move-resize  as logical   no-undo .
     2384     define variable v-field-group-handle   as handle    no-undo .
     2385     define variable v-object-handle        as handle    no-undo .
     2386     define variable v-frame-width          as decimal   no-undo .
     2387     define variable v-frame-virtual-width  as decimal   no-undo .
     2388     define variable v-browse-width         as decimal   no-undo .
     2389     define variable v-window-width         as decimal   no-undo .
     2390     define variable v-window-virtual-width as decimal   no-undo .
     2391     define variable v-change-sign          as integer   no-undo .
     2392     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2393     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2394     if p-change-value > 0
     2395     then do:
     2396       if frame d-sum-grp :width + p-change-value >
     2397           session :width-chars
     2398       then do:
     2399         assign
     2400           p-change-value = session :width-chars - frame d-sum-grp :width
     2401         .
     2402         if p-change-value <= 0
     2403         then do:
     2404           run diasize_position-resize-button in this-procedure .
     2405           return .
     2406         end.
     2407       end.
     2408     end.
     2409     if p-change-value < 0
     2410     then do:
     2411       if frame d-sum-grp :width + p-change-value < v-diasize-orig-frame-width
     2412       then do:
     2413         assign
     2414           p-change-value = v-diasize-orig-frame-width
     2415                          - frame d-sum-grp :width
     2416         .
     2417         if p-change-value >= 0
     2418         then do:
     2419           run diasize_position-resize-button in this-procedure .
     2420           return .
     2421         end.
     2422       end.
     2423     end.
     2424     if p-change-value >= 0
     2425     then do:
     2426       assign
     2427         v-change-sign = 1
     2428       .
     2429     end.
     2430     else do:
     2431       assign
     2432         v-change-sign = -1
     2433       .
     2434     end.
     2435     assign
     2436       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2437     .
     2438     if p-change-value = 0
     2439     then do:
     2440       run diasize_position-resize-button in this-procedure .
     2441       return .
     2442     end.
     2443     move_block:
     2444     do
     2445     on error undo move_block, leave move_block
     2446     :
     2447       if retry
     2448       then do:
     2449         do
     2450         on error undo move_block, leave move_block
     2451         :
     2452           if p-change-value > 0
     2453           then do:
     2454             for each buf_temp-diasize-handle
     2455             on error undo, next
     2456             :
     2457               assign
     2458                 v-object-handle = buf_temp-diasize-handle.handle-value
     2459               .
     2460               if v-object-handle <> v-diasize-resize-button
     2461               then do:
     2462                 assign
     2463                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2464                 .
     2465               end.
     2466             end.
     2467             assign
     2468               v-diasize-browse-handle :width = v-browse-width
     2469             .
     2470             for each buf_temp-browse-handle
     2471               where buf_temp-browse-handle.browse-type = 'width':u
     2472             on error undo, next
     2473             :
     2474               assign
     2475                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2476               .
     2477             end.
     2478             assign
     2479               frame d-sum-grp :width = v-frame-width
     2480             .
     2481             if frame d-sum-grp :scrollable = true
     2482             then do:
     2483               assign
     2484                 frame d-sum-grp :virtual-width = v-frame-virtual-width
     2485               .
     2486             end.
     2487             run diasize_position-resize-button in this-procedure .
     2488           end.
     2489           else do:
     2490             if frame d-sum-grp :scrollable = true
     2491             then do:
     2492               assign
     2493                 frame d-sum-grp :virtual-width = v-frame-virtual-width
     2494               .
     2495             end.
     2496             assign
     2497               frame d-sum-grp :width = v-frame-width
     2498             .
     2499             for each buf_temp-browse-handle
     2500               where buf_temp-browse-handle.browse-type = 'width':u
     2501             on error undo, next
     2502             :
     2503               assign
     2504                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2505               .
     2506             end.
     2507             assign
     2508               v-diasize-browse-handle :width = v-browse-width
     2509             .
     2510             for each buf_temp-diasize-handle
     2511             on error undo, next
     2512             :
     2513               assign
     2514                 v-object-handle = buf_temp-diasize-handle.handle-value
     2515               .
     2516               if v-object-handle <> v-diasize-resize-button
     2517               then do:
     2518                 assign
     2519                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2520                 .
     2521               end.
     2522             end.
     2523             run diasize_position-resize-button in this-procedure .
     2524           end.
     2525           assign
     2526             v-diasize-change-size = false
     2527           .
     2528           leave move_block .
     2529         end.
     2530       end.
     2531       assign
     2532         v-diasize-need-full-display = true
     2533       .
     2534       if v-diasize-change-size = false
     2535       then do:
     2536         assign
     2537           v-diasize-change-size = true
     2538         .
     2539       end.
     2540       else do:
     2541         return .
     2542       end.
     2543       assign
     2544         v-frame-width = frame d-sum-grp :width
     2545         v-frame-virtual-width = frame d-sum-grp :virtual-width
     2546         v-browse-width = v-diasize-browse-handle :width
     2547       .
     2548       for each buf_temp-browse-handle
     2549         where buf_temp-browse-handle.browse-type = 'width':u
     2550       :
     2551         assign
     2552           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2553         .
     2554       end.
     2555       for each buf_temp-diasize-handle
     2556       :
     2557         delete buf_temp-diasize-handle .
     2558       end.
     2559       assign
     2560         v-field-group-handle = frame d-sum-grp :first-child
     2561       .
     2562       do while valid-handle(v-field-group-handle)
     2563       :
     2564         assign
     2565           v-object-handle = v-field-group-handle :first-child
     2566         .
     2567         do while valid-handle(v-object-handle)
     2568         :
     2569           if  v-object-handle <> v-diasize-browse-handle :handle
     2570           and v-object-handle <> v-diasize-resize-button
     2571           and can-query(v-object-handle, "row")
     2572           and can-query(v-object-handle, "height")
     2573           and ( v-object-handle :col + v-object-handle :width
     2574                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2575               )
     2576           then do:
     2577             find first buf_temp-browse-handle
     2578               where buf_temp-browse-handle.browse-type   = 'width':u
     2579                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2580               no-error .
     2581             if available buf_temp-browse-handle
     2582             then do:
     2583             end.
     2584             else do:
     2585               create buf_temp-diasize-handle .
     2586               assign
     2587                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2588                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2589               .
     2590             end.
     2591           end.
     2592           assign
     2593             v-object-handle = v-object-handle :next-sibling
     2594           .
     2595         end.
     2596         assign
     2597           v-field-group-handle = v-field-group-handle :next-sibling
     2598         .
     2599       end.
     2600       do with frame d-sum-grp
     2601       :
     2602         hide v-diasize-resize-button .
     2603         v-diasize-resize-button :row = 1.
     2604         v-diasize-resize-button :column = 1.
     2605       end.
     2606       if p-change-value > 0
     2607       then do:
     2608         if frame d-sum-grp :scrollable = true
     2609         then do:
     2610           assign
     2611             frame d-sum-grp :virtual-width = frame d-sum-grp :virtual-width + p-change-value
     2612             no-error .
     2613           if error-status :error
     2614           or error-status :get-message(1) <> ""
     2615           then do:
     2616             undo move_block, retry move_block.
     2617           end.
     2618         end.
     2619         assign
     2620           frame d-sum-grp :width = v-frame-width + p-change-value
     2621           no-error .
     2622         if error-status :error
     2623         or error-status :get-message(1) <> ""
     2624         then do:
     2625           undo move_block, retry move_block.
     2626         end.
     2627         assign
     2628           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2629         no-error .
     2630         if error-status :error
     2631         or error-status :get-message(1) <> ""
     2632         then do:
     2633           undo move_block, retry move_block.
     2634         end.
     2635         for each buf_temp-browse-handle
     2636           where buf_temp-browse-handle.browse-type = 'width':u
     2637         on error undo move_block, retry move_block
     2638         :
     2639           assign
     2640             buf_temp-browse-handle.browse-handle :width
     2641               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2642             no-error .
     2643           if error-status :error
     2644           or error-status :get-message(1) <> ""
     2645           then do:
     2646             undo move_block, retry move_block .
     2647           end.
     2648         end.
     2649         for each buf_temp-diasize-handle
     2650         on error undo move_block, retry move_block
     2651         :
     2652           assign
     2653             v-object-handle = buf_temp-diasize-handle.handle-value
     2654           .
     2655           if v-object-handle <> v-diasize-resize-button
     2656           then do:
     2657             assign
     2658               v-object-handle :col = v-object-handle :col + p-change-value
     2659               no-error .
     2660             if error-status :error
     2661             or error-status :get-message(1) <> ""
     2662             then do:
     2663               undo move_block, retry move_block .
     2664             end.
     2665           end.
     2666         end.
     2667       end.
     2668       else do:
     2669         for each buf_temp-diasize-handle
     2670         on error undo move_block, retry move_block
     2671         :
     2672           assign
     2673             v-object-handle = buf_temp-diasize-handle.handle-value
     2674           .
     2675           if v-object-handle <> v-diasize-resize-button
     2676           then do:
     2677             assign
     2678               v-object-handle :col = v-object-handle :col + p-change-value
     2679               no-error .
     2680             if error-status :error
     2681             or error-status :get-message(1) <> ""
     2682             then do:
     2683               undo move_block, retry move_block .
     2684             end.
     2685           end.
     2686         end.
     2687         for each buf_temp-browse-handle
     2688           where buf_temp-browse-handle.browse-type = 'width':u
     2689         on error undo move_block, retry move_block
     2690         :
     2691           assign
     2692             buf_temp-browse-handle.browse-handle :width
     2693               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2694             no-error .
     2695           if error-status :error
     2696           or error-status :get-message(1) <> ""
     2697           then do:
     2698             undo move_block, retry move_block .
     2699           end.
     2700         end.
     2701         assign
     2702           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2703           no-error .
     2704         if error-status :error
     2705         or error-status :get-message(1) <> ""
     2706         then do:
     2707           undo move_block, retry move_block.
     2708         end.
     2709         assign
     2710           frame d-sum-grp :width = frame d-sum-grp :width + p-change-value
     2711         no-error .
     2712         if error-status :error
     2713         or error-status :get-message(1) <> ""
     2714         then do:
     2715           undo move_block, retry move_block.
     2716         end.
     2717         if frame d-sum-grp :scrollable = true
     2718         then do:
     2719           assign
     2720             frame d-sum-grp :virtual-width = frame d-sum-grp :virtual-width + p-change-value
     2721           no-error .
     2722           if error-status :error
     2723           or error-status :get-message(1) <> ""
     2724           then do:
     2725             undo move_block, retry move_block.
     2726           end.
     2727         end.
     2728       end.
     2729       if p-move-resize
     2730       then do:
     2731         run diasize_position-resize-button in this-procedure .
     2732       end.
     2733       if v-diasize-wndstore = true
     2734       then do:
     2735         if connected("ub") = true
     2736         then do:
     2737           define variable v-cntxt-db-num        as integer   no-undo .
     2738           define variable v-cntxt-userid        as character no-undo .
     2739           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2740                                             , OUTPUT v-cntxt-userid
     2741                                             ) .
     2742           run gbl/wndsizew.p
     2743             (input  v-cntxt-db-num
     2744             ,input  v-cntxt-userid
     2745             ,input  v-diasize-proc-name
     2746             ,input  'width':u
     2747             ,input  string(frame d-sum-grp :width - v-diasize-orig-frame-width)
     2748             ) .
     2749         end.
     2750       end.
     2751     end.
     2752     assign
     2753       v-diasize-change-size = false
     2754     .
     2755   end procedure.
     2756   procedure diasize_set-width :
     2757     define input  parameter p-new-width  as decimal   no-undo .
     2758     define input  parameter p-move-resize as logical   no-undo .
     2759     do
     2760     on error undo, return error return-value
     2761     :
     2762       run diasize_change-width in this-procedure
     2763         (input  (p-new-width - frame d-sum-grp :width)
     2764         ,input  p-move-resize
     2765         ) .
     2766     end.
     2767   end procedure.
     2768   procedure diasize_position-resize-button :
     2769     do with frame d-sum-grp
     2770     :
     2771       hide v-diasize-resize-button .
     2772       assign
     2773         v-diasize-resize-button :row = frame d-sum-grp :height - v-diasize-resize-button :height
     2774                     - 1
     2775                     - (frame d-sum-grp :border-bottom-pixels / session :pixels-per-row)
     2776         v-diasize-resize-button :col = frame d-sum-grp :width - v-diasize-resize-button :width
     2777                     - 1
     2778                     - (frame d-sum-grp :border-right-pixels / session :pixels-per-column)
     2779       .
     2780       view v-diasize-resize-button .
     2781     end.
     2782   end procedure.
     2783   on alt-right anywhere
     2784   do:
     2785     run diasize_change-width in this-procedure
     2786       (input 1
     2787       ,input true
     2788       ) .
     2789     return no-apply .
     2790   end.
     2791   on alt-left anywhere
     2792   do:
     2793     run diasize_change-width in this-procedure
     2794       (input -1
     2795       ,input true
     2796       ) .
     2797     return no-apply .
     2798   end.
     2799   on alt-down anywhere
     2800   do:
     2801     run diasize_change-height in this-procedure
     2802       (input 1
     2803       ,input true
     2804       ) .
     2805     return no-apply .
     2806   end.
     2807   on alt-up anywhere
     2808   do:
     2809     run diasize_change-height in this-procedure
     2810       (input -1
     2811       ,input true
     2812       ) .
     2813     return no-apply .
     2814   end.
     2815   on alt-enter of frame d-sum-grp
     2816   do:
     2817     run diasize_maximize in this-procedure
     2818       (input  ?
     2819       ).
     2820     return no-apply .
     2821   end.
     2822   procedure diasize_end-move :
     2823     do
     2824     on error undo, return error return-value
     2825     :
     2826       define variable v-row-delta as decimal   no-undo .
     2827       define variable v-col-delta as decimal   no-undo .
     2828       define variable v-new-row as decimal   no-undo .
     2829       define variable v-new-col as decimal   no-undo .
     2830       assign
     2831         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2832         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2833       .
     2834       assign
     2835         v-row-delta = v-new-row - frame d-sum-grp :height
     2836         v-col-delta = v-new-col - frame d-sum-grp :width
     2837       .
     2838       run diasize_change-height in this-procedure
     2839         (input v-row-delta
     2840         ,input true
     2841         ) .
     2842       run diasize_change-width in this-procedure
     2843         (input v-col-delta
     2844         ,input true
     2845         ) .
     2846     end.
     2847   end procedure.
     2848   procedure diasize_maximize :
     2849     define input  parameter p-action as logical   no-undo .
     2850     do
     2851     on error undo, return error return-value
     2852     :
     2853       if p-action = ?
     2854       then do:
     2855         if v-diasize-need-maximize = true
     2856         then do:
     2857           assign
     2858             p-action = true
     2859           .
     2860         end.
     2861         else do:
     2862           assign
     2863             p-action = false
     2864           .
     2865         end.
     2866       end.
     2867       if p-action = true
     2868       then do:
     2869         run diasize_change-height in this-procedure
     2870           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2871               - frame d-sum-grp :height-chars
     2872           ,input true
     2873           ) .
     2874         run diasize_change-width in this-procedure
     2875           (input session :width-chars
     2876               - frame d-sum-grp :width-chars
     2877           ,input true
     2878           ) .
     2879         assign
     2880           v-diasize-need-maximize = false
     2881         .
     2882       end.
     2883       else do:
     2884         run diasize_change-width in this-procedure
     2885           (input v-diasize-orig-frame-width
     2886               - frame d-sum-grp :width-chars
     2887           ,input true
     2888           ) .
     2889         run diasize_change-height in this-procedure
     2890           (input v-diasize-orig-frame-height
     2891               - frame d-sum-grp :height-chars
     2892           ,input true
     2893           ) .
     2894         assign
     2895           v-diasize-need-maximize = true
     2896         .
     2897       end.
     2898     end.
     2899   end procedure.
     2900   procedure diasize_restore-orig-size :
     2901     do
     2902     on error undo, return error return-value
     2903     :
     2904       assign
     2905         v-diasize-current-frame-width  = frame d-sum-grp :width
     2906         v-diasize-current-frame-height = frame d-sum-grp :height
     2907       .
     2908       run diasize_set-height in this-procedure
     2909         (input  v-diasize-orig-frame-height
     2910         ,input  true
     2911         ) .
     2912       run diasize_set-width in this-procedure
     2913         (input  v-diasize-orig-frame-width
     2914         ,input  true
     2915         ) .
     2916     end.
     2917   end procedure.
     2918   procedure diasize_restore-current-size :
     2919     do
     2920     on error undo, return error return-value
     2921     :
     2922       run diasize_set-height in this-procedure
     2923         (input  v-diasize-current-frame-height
     2924         ,input  true
     2925         ) .
     2926       run diasize_set-width in this-procedure
     2927         (input  v-diasize-current-frame-width
     2928         ,input  true
     2929         ) .
     2930     end.
     2931   end procedure.
     2932   procedure diasize_set-browse-handle :
     2933     define input  parameter p-browse-handle as handle   no-undo .
     2934     define buffer buf_temp-browse-handle for temp-browse-handle .
     2935     do
     2936     on error undo, return error return-value
     2937     :
     2938       assign
     2939         v-diasize-browse-handle = p-browse-handle
     2940       .
     2941       for each buf_temp-browse-handle
     2942       on error undo, return error return-value
     2943       :
     2944         delete buf_temp-browse-handle .
     2945       end.
     2946     end.
     2947   end procedure.
     2948   procedure diasize_add_browse :
     2949     define input  parameter p-browse-type   as character no-undo .
     2950     define input  parameter p-browse-handle as handle    no-undo .
     2951     define buffer buf_temp-browse-handle for temp-browse-handle .
     2952     do
     2953     on error undo, return error return-value
     2954     :
     2955       assign
     2956         v-diasize-browse-number = v-diasize-browse-number + 1
     2957       .
     2958       create buf_temp-browse-handle .
     2959       assign
     2960         buf_temp-browse-handle.browse-type   = p-browse-type
     2961         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2962         buf_temp-browse-handle.browse-handle = p-browse-handle
     2963       .
     2964     end.
     2965   end procedure.
     2966   procedure diasize_init :
     2967     define variable v-default-value    as logical   no-undo .
     2968     define variable v-restore-saved    as logical   no-undo .
     2969     define variable v-resize-value-str as character no-undo .
     2970     do
     2971     on error undo, return error return-value
     2972     :
     2973       do with frame d-sum-grp
     2974       :
     2975         assign
     2976           v-diasize-orig-frame-height = frame d-sum-grp :height
     2977           v-diasize-orig-frame-width  = frame d-sum-grp :width
     2978           v-diasize-browse-handle     = browse br-sumgrps :handle
     2979         .
     2980         create button v-diasize-resize-button
     2981         assign
     2982           parent        = frame d-sum-grp :first-child
     2983           label         = "s"
     2984           height-pixels = 16
     2985           width-pixels  = 16
     2986           visible       = true
     2987           sensitive     = true
     2988           movable       = true
     2989           triggers:
     2990             on end-move persistent run diasize_end-move in this-procedure .
     2991           end triggers.
     2992         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2993         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2994         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2995         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2996         assign
     2997           v-diasize-wndmax = false
     2998         .
     2999         if connected("ub") = true
     3000         then do:
     3001           define variable v-cntxt-db-num        as integer   no-undo .
     3002           define variable v-cntxt-userid        as character no-undo .
     3003           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3004                                             , OUTPUT v-cntxt-userid
     3005                                             ) .
     3006           run gbl/wndpar_r.p
     3007             (input  v-cntxt-db-num
     3008             ,input  v-cntxt-userid
     3009             ,input  'wndmax':U
     3010             ,output v-diasize-wndmax
     3011             ,output v-default-value
     3012             ) .
     3013         end.
     3014         assign
     3015           v-diasize-wndstore = false
     3016         .
     3017         if connected("ub") = true
     3018         then do:
     3019           run gbl/wndpar_r.p
     3020             (input  v-cntxt-db-num
     3021             ,input  v-cntxt-userid
     3022             ,input  'wndstore':U
     3023             ,output v-diasize-wndstore
     3024             ,output v-default-value
     3025             ) .
     3026         end.
     3027         assign
     3028           v-diasize-proc-name = entry(1, program-name(2), '.')
     3029         .
     3030         if v-diasize-wndstore = true
     3031         then do:
     3032           assign
     3033             v-restore-saved = false
     3034           .
     3035           if connected("ub") = true
     3036           then do:
     3037             run gbl/wndsizer.p
     3038               (input  v-cntxt-db-num
     3039               ,input  v-cntxt-userid
     3040               ,input  v-diasize-proc-name
     3041               ,input  'height':u
     3042               ,output v-resize-value-str
     3043               ) .
     3044             if v-resize-value-str <> '':U
     3045             then do:
     3046               run diasize_change-height in this-procedure
     3047                 (input  integer(v-resize-value-str)
     3048                 ,input  true
     3049                 ) .
     3050               assign
     3051                 v-restore-saved = true
     3052               .
     3053             end.
     3054           end.
     3055           if connected("ub") = true
     3056           then do:
     3057             run gbl/wndsizer.p
     3058               (input  v-cntxt-db-num
     3059               ,input  v-cntxt-userid
     3060               ,input  v-diasize-proc-name
     3061               ,input  'width':u
     3062               ,output v-resize-value-str
     3063               ) .
     3064             if v-resize-value-str <> '':U
     3065             then do:
     3066               run diasize_change-width in this-procedure
     3067                 (input  integer(v-resize-value-str)
     3068                 ,input  true
     3069                 ) .
     3070               assign
     3071                 v-restore-saved = true
     3072               .
     3073             end.
     3074           end.
     3075           if v-restore-saved <> true
     3076           then do:
     3077             if v-diasize-wndmax = true
     3078             then do:
     3079               run diasize_maximize in this-procedure
     3080                 (input  true
     3081                 ) .
     3082             end.
     3083           end.
     3084         end.
     3085         else do:
     3086           if v-diasize-wndmax = true
     3087           then do:
     3088             run diasize_maximize in this-procedure
     3089               (input  true
     3090               ) .
     3091           end.
     3092         end.
     3093       end.
     3094     end.
     3095   end procedure.
     3096   procedure diasize_need-full-display :
     3097     define output parameter p-need-full-display as logical   no-undo .
     3098     do
     3099     on error undo, return error return-value
     3100     :
     3101       assign
     3102         p-need-full-display = v-diasize-need-full-display
     3103       .
     3104       assign
     3105         v-diasize-need-full-display = false
     3106       .
     3107     end.
     3108   end procedure.
     3109   procedure get-context :
     3110      define output parameter p-db-num as integer          no-undo.
     3111      define output parameter p-user-id as character        no-undo.
     3112      define variable v-login               as character    no-undo.
     3113      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3114      define buffer buf_user-login  for ub.user-login .
     3115      do
     3116      on error undo, return error
     3117      :
     3118            FIND FIRST buf_sys-ctrl no-lock.
     3119            ASSIGN
     3120               v-login = USERID("ub")
     3121               p-db-num = buf_sys-ctrl.db-num
     3122            .
     3123            FIND FIRST buf_user-login
     3124                 WHERE buf_user-login.db-num = p-db-num
     3125                   AND buf_user-login.user-login = v-login
     3126                 no-lock
     3127                 no-error
     3128                 .
     3129            IF AVAILABLE buf_user-login
     3130            THEN DO:
     3131               assign
     3132                  p-user-id = buf_user-login.user-id
     3133               .
     3134            END.
     3135      end.
     3136   end procedure.
     3137       run diasize_init in this-procedure .
     3138   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3139   on INS of frame d-sum-grp anywhere do:
     3140     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame d-sum-grp. END.
     3141     return no-apply.
     3142   end.
     3143   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3144   on CTRL-N, CTRL-Т of frame d-sum-grp anywhere do:
     3145     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame d-sum-grp. END.
     3146     return no-apply.
     3147   end.
     3148   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3149   on F4 of frame d-sum-grp anywhere do:
     3150     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame d-sum-grp. END.
     3151     return no-apply.
     3152   end.
     3153   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3154   on F8 of frame d-sum-grp anywhere do:
     3155     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame d-sum-grp. END.
     3156     return no-apply.
     3157   end.
     3158   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3159   on F2 of frame d-sum-grp anywhere do:
     3160     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame d-sum-grp. END.
     3161     return no-apply.
     3162   end.
     3163   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3164   on F2 of frame d-sum-grp anywhere do:
     3165     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame d-sum-grp. END.
     3166     return no-apply.
     3167   end.
     3168   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3169   on CTRL-P, CTRL-З of frame d-sum-grp anywhere do:
     3170     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame d-sum-grp. END.
     3171     return no-apply.
     3172   end.
     3173   ON WINDOW-CLOSE OF FRAME d-sum-grp APPLY "END-ERROR":U TO SELF.
     3174   MAIN-BLOCK:
     3175   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3176      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3177   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3178     run mainmenu_getcntxt in parparentproc
     3179       (output v-cntxt-db-num
     3180       ,output v-cntxt-userid
     3181       ,output v-cntxt-level
     3182       ,output v-cntxt-host-code-obj
     3183       ,output v-cntxt-obj-type
     3184       ,output v-cntxt-obj-code
     3185       ,output v-cntxt-db-num-obj
     3186       ,output v-cntxt-is-admin
     3187       ) .
     3188      if v-cntxt-db-num > 0 and lookup("b-add":U, bttns) > 0 then do:
     3189       message
     3190       vss-workfile vss-revision vss-description skip
     3191       "Неверное значение параметра bttns" bttns skip
     3192       "Нельзя добавлять записи в удаленной БД"
     3193       view-as alert-box  error.
     3194       return error.
     3195      end.
     3196   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3197   define variable send-ref as logical no-undo.
     3198   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3199     (input  'send-ref'
     3200     ,input  0
     3201     ,input  ''
     3202     ,input  0
     3203     ,input  ''
     3204     ,input  ''
     3205     ,input  ''
     3206     ,input  no
     3207     ,output dops
     3208     ,output dopst
     3209     ) no-error .
     3210     send-ref = (IF error-status:error or dops <> "yes" then no else yes).
     3211      v-rid-list = p-rid-list.
     3212      RUN enable_UI.
     3213      HIDE mark-num in frame d-sum-grp.
     3214      if v-rid-list <> "":U then do:
     3215       assign
     3216       rr = integer(v-rid-list) no-error .
     3217       .
     3218       if not error-status:error then do:
     3219         reposition br-sumgrps to recid rr no-error .
     3220       end.
     3221       APPLY "ENTRY" to br-sumgrps.
     3222      end.
     3223      WAIT-FOR GO OF FRAME d-sum-grp.
     3224   END.
     3225   RUN disable_UI.
     3226   PROCEDURE disable_UI :
     3227     HIDE FRAME d-sum-grp.
     3228   END PROCEDURE.
     3229   PROCEDURE enable_UI :
     3230   assign
     3231   b-disc:menu-mouse in frame d-sum-grp = 1
     3232   menu-item m_update-disc:sensitive in menu menu-b-disc = lookup("b-add", bttns) > 0 AND v-cntxt-db-num = 0
     3233   b-goods:menu-mouse in frame d-sum-grp = 1
     3234   .
     3235   ENABLE br-sumgrps b-quit
     3236   b-add WHEN lookup("b-add", bttns) > 0 AND v-cntxt-db-num = 0 and not transaction
     3237   b-del WHEN lookup("b-add", bttns) > 0 AND v-cntxt-db-num = 0 and not transaction
     3238   b-sel WHEN lookup("b-sel", bttns) > 0
     3239   b-chg WHEN lookup("b-add", bttns) > 0 AND v-cntxt-db-num = 0 and not transaction
     3240   b-disc
     3241   b-goods
     3242   b-mark when lookup("b-mark", bttns) > 0
     3243   b-hist
     3244   b-print
     3245   b-help
     3246   WITH FRAME d-sum-grp.
     3247   OPEN QUERY br-sumgrps FOR EACH X_sum-grp NO-LOCK     BY X_sum-grp.grp-code INDEXED-REPOSITION.
     3248   APPLY "ENTRY" to br-sumgrps.
     3249   END PROCEDURE.
     3250   PROCEDURE grp-sending :
     3251   define input parameter p-action as character no-undo .
     3252   if NOT send-ref  then return.
     3253   define variable p-var as integer no-undo .
     3254   FIND FIRST obj-list WHERE
     3255              obj-list.obj-code = b_sum-grp.grp-code No-ERROR.
     3256   IF NOT avail obj-list then do:
     3257     find last obj-list  use-index pi no-error .
     3258      if available obj-list then p-var = obj-list.obj-id + 1.
     3259                            else p-var = 1.
     3260     create obj-list.
     3261     assign
     3262      obj-list.obj-code = b_sum-grp.GRP-code
     3263      obj-list.obj-name = (if p-action = "D":U then "D":U else obj-list.obj-name)
     3264      obj-list.obj-id   = p-var
     3265     .
     3266   end.
     3267   END PROCEDURE.
     3268   PROCEDURE proc-send :
     3269   define variable glog as logical no-undo .
     3270   if can-find(first ub.cash-desk where ub.cash-desk.pos-type = 'IBM':U) AND
     3271          can-find(first obj-list) then do:
     3272     message
     3273     "Переслать изменения справочника на кассы?"
     3274     view-as alert-box question buttons YES-NO update glog.
     3275     if  glog then do:
     3276       run str/diallog.w (
     3277               input parparentproc
     3278             , input this-procedure
     3279             , input "str/snd-grup.p":U
     3280             , input string(v-cntxt-db-num)
     3281             , input no
     3282             , input "":U
     3283             , input substitute("Отсылка групп товаров на кассы БД &1", v-cntxt-db-num )
     3284         ) no-error.
     3285     end.
     3286   end.
     3287   for each obj-list:
     3288     delete obj-list.
     3289   end.
     3290   END PROCEDURE.
