        1   block-level on error undo, throw.
        2   define input  parameter p-cli-type like ub.ext-artic.cli-type no-undo .
        3   define input  parameter p-cli-code like ub.ext-artic.cli-code no-undo .
        4   define input  parameter p-gds-code like ub.ext-artic.gds-code no-undo .
        5   define input  parameter p-status_  like ub.ext-artic.status_  no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: extartd.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: ref/extartd.p $":U .
       11   define variable vss-description as character no-undo init "Изменение статуса внешнего артикула".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define buffer buf_ext-artic       for ub.ext-artic.
       71   define buffer ex_ext-artic        for ub.ext-artic.
       72   define buffer buf_goods           for ub.goods.
       73   define buffer buf_ext-artic-attr  for ub.ext-artic-attr.
       74   do on error undo, return error return-value :
       75     if     p-status_ <> 'тек':U
       76       and  p-status_ <> 'удал':U then do:
       77       return error "Неверное значение параметра p-status_".
       78     end.
       79     find first buf_ext-artic exclusive-lock
       80       where buf_ext-artic.cli-type = p-cli-type
       81         and buf_ext-artic.cli-code = p-cli-code
       82         and buf_ext-artic.gds-code = p-gds-code
       83     no-wait no-error .
       84     if not available buf_ext-artic then do:
       85       if locked buf_ext-artic then do:
       86         return error "Запись заблокирована".
       87       end.
       88       else do:
       89         return error "Запись не найдена".
       90       end.
       91     end.
       92     if p-status_ = 'тек':U then do:
       93       find first ex_ext-artic no-lock
       94         where ex_ext-artic.cli-type  = p-cli-type
       95           and ex_ext-artic.cli-code  = p-cli-code
       96           and ex_ext-artic.gds-code <> p-gds-code
       97           and ex_ext-artic.ext-artic = buf_ext-artic.ext-artic
       98           and ex_ext-artic.status_   = 'тек':U
       99       use-index ea-stts
      100       no-error .
      101       if available ex_ext-artic then do :
      102         find first buf_goods no-lock
      103           where buf_goods.gds-code = ex_ext-artic.gds-code
      104         no-error .
      105         return error substitute( "У '&1 &2' уже есть товар &3 с внешним артикулом &4"
      106                               , p-cli-type
      107                               , p-cli-code
      108                               , if available buf_goods then substitute( "'&1 &2'" , buf_goods.artic , buf_goods.gds-name ) else ''
      109                               , buf_ext-artic.ext-artic
      110                               ).
      111       end.
      112     end.
      113     if p-status_ = 'удал':U then do :
      114       for each buf_ext-artic-attr exclusive-lock
      115             where buf_ext-artic-attr.cli-type = buf_ext-artic.cli-type
      116               and buf_ext-artic-attr.cli-code = buf_ext-artic.cli-code
      117               and buf_ext-artic-attr.gds-code = buf_ext-artic.gds-code
      118       :
      119         delete buf_ext-artic-attr.
      120       end.
      121     end.
      122     assign
      123       buf_ext-artic.status_ = p-status_
      124     .
      125   end.
