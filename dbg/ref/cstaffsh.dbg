     2189           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2190                                             , OUTPUT v-cntxt-userid
     2191                                             ) .
     2192           run gbl/wndsizew.p
     2193             (input  v-cntxt-db-num
     2194             ,input  v-cntxt-userid
     2195             ,input  v-diasize-proc-name
     2196             ,input  'width':u
     2197             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2198             ) .
