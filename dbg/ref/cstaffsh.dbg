     2153           no-error .
     2154         if error-status :error
     2155         or error-status :get-message(1) <> ""
     2156         then do:
     2157           undo move_block, retry move_block.
     2158         end.
     2159         assign
     2160           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2161         no-error .
     2162         if error-status :error
     2163         or error-status :get-message(1) <> ""
     2164         then do:
     2165           undo move_block, retry move_block.
     2166         end.
     2167         if frame Dialog-Frame :scrollable = true
     2168         then do:
     2169           assign
