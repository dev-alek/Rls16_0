        1   DEFINE BUFFER X_c-cli-hist FOR c-cli-hist.
        2   DEFINE BUFFER X_c-staff FOR c-staff.
        3   DEFINE BUFFER X_curr_clients FOR clients.
        4   DEFINE BUFFER X_staff FOR staff.
        5   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        6   define input parameter bttns  as char   no-undo .
        7   define input parameter p-mode  as char   no-undo .
        8   define input parameter p-role           like ub.staff.role no-undo .
        9   define input parameter p-role-level     like ub.staff.role-level no-undo .
       10   define input parameter p-work-place     like ub.staff.work-place no-undo .
       11   define input parameter p-staff-code     like ub.staff.staff-code no-undo .
       12   define input parameter p-date-start     like ub.staff.date-start no-undo .
       13   define input-output param p-rid-list    as  char no-undo .
       14   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       15   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       16   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       17   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       18   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       19   define variable vss-description AS CHAR NO-UNDO INIT "Список истории персонала":U.
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   procedure proc-alt-shift-f2:
       81     if not ibs.th.gbl.gbl-var:rcode
       82   then
       83     run gbl\inidebug.p .
       84   end.
       85   procedure proc-alt-shift-f3:
       86     run gbl/prvssinf.p
       87       ( input this-procedure
       88       ) .
       89   end.
       90   define variable v-inform-launched as logical no-undo initial false .
       91   procedure proc-alt-shift-f4:
       92     define variable v-action as character no-undo .
       93     if v-inform-launched = false then do:
       94       assign
       95         v-inform-launched = true
       96       .
       97       run gbl/d-inform.w
       98         (  input self
       99         ,  input this-procedure
      100         , output v-action
      101         ) no-error .
      102       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      103       assign
      104         v-inform-launched = false
      105       .
      106     end.
      107   end.
      108   procedure proc-alt-f1:
      109     run gbl/corrhelp.p
      110       (input this-procedure
      111       ) .
      112   end .
      113   on alt-shift-f2 anywhere do:
      114     run proc-alt-shift-f2.
      115   end.
      116   on alt-shift-f3 anywhere do:
      117     run proc-alt-shift-f3 in this-procedure .
      118   end.
      119   on alt-shift-f4 anywhere do:
      120     run proc-alt-shift-f4 in this-procedure.
      121   end.
      122   on alt-f1 anywhere do:
      123     run proc-alt-f1 in this-procedure .
      124   end.
      125   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      127   define new shared variable RepPathName        as character no-undo .
      128   define new shared variable PrintRubl          as logical   no-undo .
      129   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   define variable v-waitfram-action01         as character   no-undo .
      131   define variable v-waitfram-action02         as character   no-undo .
      132   define variable v-waitfram-action03         as character   no-undo .
      133   define variable mWaitFramTextBeg            as character   no-undo.
      134   define variable mWaitFramTextEnd            as character   no-undo.
      135   define variable mWaitFramView               as logical     no-undo.
      136   define variable mWaitProcEvent              as logical     no-undo init yes.
      137   define variable mWaitFramInterval           as integer     no-undo init 1 .
      138   define variable mWaitFramStop               as logical     no-undo.
      139   define variable mWaitFramStopUser           as logical     no-undo.
      140   define variable mWaitFramStopTimeOut        as logical     no-undo.
      141   define variable mWaitFramStartProc          as datetime-tz no-undo.
      142   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      143   define button B-WaitFramStop auto-end-key
      144        label "Стоп"
      145        size 10 by 1 tooltip "Остоновить процесс".
      146   define button B-viewProcInfo
      147        label "Информация"
      148        size 15 by 1 tooltip "Информация о процесс".
      149   define frame waitfram
      150     v-waitfram-action01 format "x(72)" no-label skip
      151     v-waitfram-action02 format "x(72)" no-label skip
      152     v-waitfram-action03 format "x(72)" no-label skip
      153     B-viewProcInfo
      154     B-WaitFramStop at row 4 col 30
      155     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      156     .
      157   define new global shared variable mBatchMode as logical no-undo init ?.
      158   define variable mFramBachModHandle as handle no-undo.
      159   mFramBachModHandle = frame waitfram:handle.
      160   define variable mFameOldVis as logical no-undo.
      161   define variable mVisCUrentVin as logical no-undo.
      162   if session:batch-mode
      163   then
      164      mBatchMode = yes.
      165   if mBatchMode = ? then do:
      166     mVisCUrentVin = current-window:visible.
      167     mFameOldVis = mFramBachModHandle:visible.
      168     mFramBachModHandle:visible  = yes.
      169     mBatchMode = mFramBachModHandle:visible ne yes.
      170     mFramBachModHandle:visible = mFameOldVis.
      171     current-window:visible = mVisCUrentVin.
      172   end.
      173    if  log-manager:logfile-name ne ?
      174     then DO:
      175         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      176         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      177         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      178     end.
      179   on choose of B-WaitFramStop in frame waitfram
      180   do:
      181     mWaitFramStop = yes.
      182     mWaitFramStopUser = yes.
      183   end.
      184   function waitfram-check-timeout returns logical():
      185      define variable vtime as int64 no-undo.
      186      if mWaitFramStopTimeOut
      187      then
      188         return yes.
      189      vtime = ( now - mWaitFramStartProc ) / 1000 .
      190      if     mWaitFramTimeOut ne ?
      191         and mWaitFramTimeOut ne 0
      192         and mWaitFramTimeOut lt vtime
      193      then do:
      194         mWaitFramStopTimeOut = yes.
      195      end.
      196      return mWaitFramStopTimeOut.
      197   end.
      198   procedure waitfram-hide :
      199     if not session:batch-mode
      200     then do
      201     on error undo, return error return-value
      202     :
      203       pause 0 before-hide .
      204       if not mBatchMode then
      205         hide frame waitfram .
      206     if     not mWaitFramView
      207        and mWaitProcEvent
      208     then
      209       process events .
      210     end.
      211   end procedure.
      212   procedure waitfram-show :
      213     define input  parameter p-message as character no-undo .
      214     define variable v-left-margin as integer   no-undo .
      215     if not session:batch-mode
      216     then do
      217     on error undo, return error return-value
      218     :
      219       if length(p-message) <= 70 then do:
      220         assign
      221           v-left-margin = integer((70 - length(p-message)) / 2)
      222         .
      223         assign
      224           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      225         .
      226         assign
      227           v-waitfram-action01 = " "
      228           v-waitfram-action02 = " "
      229                                    + fill(" ", v-left-margin)
      230                                    + p-message
      231           v-waitfram-action03 = " "
      232         .
      233       end.
      234       else do:
      235         define variable vRindex1 as integer no-undo.
      236         define variable vRindex2 as integer no-undo.
      237         vRindex1 = r-index(p-message," ",70).
      238         if vRindex1 = 0
      239         then
      240            vRindex1 = 70.
      241         if length(p-message)  <= vRindex1 + 70 then do:
      242           assign
      243             v-waitfram-action01 = " "
      244             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      245             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      246           .
      247         end.
      248         else do:
      249           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      250           if vRindex2 <= vRindex1
      251           then
      252              vRindex2 = vRindex1 + 70.
      253           assign
      254             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      255             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      256             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      257           .
      258         end.
      259       end.
      260       B-viewProcInfo:visible   in frame waitfram = no.
      261       B-viewProcInfo:sensitive in frame waitfram = no.
      262       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      263       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      264       if  (   mWaitFramView
      265          or  mWaitProcEvent)
      266          and not mBatchMode
      267       then
      268          display
      269             v-waitfram-action01 skip
      270             v-waitfram-action02 skip
      271             v-waitfram-action03 skip
      272          with frame waitfram .
      273       if     mWaitFramView
      274          then do:
      275             if     mWaitFramInterval ne ?
      276                and not mBatchMode
      277             then
      278                wait-for go of frame waitfram pause mWaitFramInterval.
      279          end.
      280          else
      281             if     mWaitProcEvent
      282                and not mBatchMode
      283             then
      284                process events .
      285     end.
      286   end procedure.
      287      procedure waitfram-show-this:
      288         define input  parameter iInterval as int64 no-undo.
      289         define variable vtime as int64 no-undo.
      290         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      291         mWaitFramInterval = iInterval.
      292         run waitfram-show (substitute("&1&2 &3&4" ,
      293                                       mWaitFramTextBeg ,
      294                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      295                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      296                                       mWaitFramTextEnd
      297                                      )
      298                           ).
      299      end.
      300      procedure WaitFramRunPause:
      301         define input  parameter iInterval as dec no-undo.
      302         define variable vStart  as datetime-tz no-undo.
      303         define variable vend    as datetime-tz no-undo.
      304         define variable vint as int64 no-undo.
      305         define variable vOk as logical no-undo.
      306         vStart = now.
      307         vend   = vStart.
      308         publish "WaitFramPause" (iInterval,output vOk).
      309         vend   =  now.
      310         vint = vend - vStart.
      311         vint = iInterval - vint / 1000.
      312         if     not mWaitFramStop
      313            and (   vint > 0
      314                 or (    not vOk
      315                     and iInterval eq ?
      316                     )
      317                 )
      318         then
      319            run waitfram-show-this (iInterval).
      320         vend   =  now.
      321         vint = vend - vStart.
      322         vint = iInterval - vint / 1000.
      323         if     not mWaitFramStop
      324            and vint > 0
      325         then do:
      326            run gbl/pause.p (vint * 1000).
      327         end.
      328         if iInterval ne ?
      329         then
      330            publish "WaitFramStop".
      331         waitfram-check-timeout().
      332      end.
      333      procedure WaitFramWaitFor:
      334         define input  parameter iInterval as dec no-undo.
      335         assign
      336            mWaitFramStartProc   = now
      337            mWaitFramStopUser    = no
      338            mWaitFramStopTimeOut = no
      339         .
      340         block-wait:
      341         do while not mWaitFramStop:
      342            run WaitFramRunPause (iInterval).
      343            if  waitfram-check-timeout()
      344            then do:
      345               leave block-wait.
      346            end.
      347         end.
      348         run waitfram-hide.
      349      end.
      350   procedure waitfram-join :
      351     define input  parameter p-line-1  as character no-undo .
      352     define input  parameter p-line-2  as character no-undo .
      353     define input  parameter p-line-3  as character no-undo .
      354     define output parameter p-message as character no-undo .
      355     do
      356     on error undo, return error return-value
      357     :
      358       assign
      359         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      360                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      361                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      362       .
      363     end.
      364   end procedure.
      365   function waitfram-join-function returns character
      366     (input p-line-1 as character
      367     ,input p-line-2 as character
      368     ,input p-line-3 as character
      369     ).
      370     define variable v-message as character no-undo .
      371     run waitfram-join in this-procedure
      372       (input  p-line-1
      373       ,input  p-line-2
      374       ,input  p-line-3
      375       ,output v-message
      376       ) .
      377     return v-message .
      378   end function .
      379   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      380   define  stream PrnLibStream.
      381   procedure prn-lib-prn-file :
      382     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      383     define input parameter p-DIsabledoptions as integer no-undo .
      384     define variable v-report-name as character no-undo .
      385     define variable v-user-action as character no-undo .
      386     define variable v-printed     as logical   no-undo .
      387     define variable v-exist       as logical   no-undo .
      388     do
      389       on error undo, return error
      390       :
      391       run prn-lib-get-report-name  in this-procedure (
      392         input parParentProc
      393         ,output v-report-name
      394         ).
      395   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      397     (input  v-report-name
      398     ,input  2
      399     ,output v-exist
      400     )  .
      401       if NOT v-exist then
      402       DO:
      403         Message
      404           "Нет заданий на печать ! "
      405           view-as alert-box .
      406         Return  .
      407       End.
      408       run gbl/prnfilen.w
      409         (input  ""
      410         ,input  p-DisabledOptions
      411         ,input  string(v-report-name )
      412         ,input  7
      413         ,output v-user-action
      414         ,output v-printed
      415         ) .
      416       if v-printed then
      417       do:
      418         return "YES" .
      419       end.
      420       else
      421       do:
      422         return "NO" .
      423       end.
      424     end.
      425   end procedure.
      426   procedure prn-lib-open-stream :
      427     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      428     define input parameter p-page-size    as integer no-undo .
      429     define input parameter p-is-stream    as logical no-undo .
      430     define input parameter p-append       as logical no-undo .
      431     define variable v-report-name as character no-undo .
      432     do
      433       on error undo, return error
      434       :
      435       run prn-lib-get-report-name  in this-procedure (
      436         input parParentProc
      437         ,output v-report-name
      438         ).
      439       if p-is-stream then
      440       do:
      441         if p-append then
      442         do:
      443           output stream PrnLibStream to value( v-report-name )
      444             page-size value(p-page-size) append .
      445         end.
      446         if not p-append then
      447         do:
      448           output stream PrnLibStream to value( v-report-name )
      449             page-size value(p-page-size) .
      450         end.
      451       end.
      452       if not p-is-stream then
      453       do:
      454         if p-append then
      455         do:
      456           output to value( v-report-name )
      457             page-size value(p-page-size) append .
      458         end.
      459         if not p-append then
      460         do:
      461           output to value( v-report-name )
      462             page-size value(p-page-size) .
      463         end.
      464       end.
      465     end.
      466   end procedure.
      467   procedure prn-lib-open-exp :
      468     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      469     define input parameter p-is-stream    as logical no-undo .
      470     define input parameter p-is-append    as logical no-undo .
      471     define output parameter p-ReportFileName as char init "report" no-undo.
      472     define output parameter p-process as logical no-undo .
      473     define variable glog as logical no-undo .
      474     do
      475       on error undo, return error
      476       :
      477       SYSTEM-DIALOG GET-FILE p-ReportFileName
      478         TITLE      "Укажите путь"
      479         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      480         ASK-OVERWRITE
      481         CREATE-TEST-FILE
      482         SAVE-AS
      483         USE-FILENAME
      484         DEFAULT-EXTENSION "txt"
      485         UPDATE glog
      486         .
      487       if not glog then  return.
      488       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      489       if p-is-stream then
      490       do:
      491         if p-is-append then
      492         do:
      493           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      494         end.
      495         else
      496         do:
      497           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      498         end.
      499       end.
      500       else
      501       do:
      502         if p-is-append then
      503         do:
      504           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      505         end.
      506         else
      507         do:
      508           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      509         end.
      510       end.
      511       p-process = yes.
      512     end.
      513   end procedure.
      514   procedure prn-lib-get-report-name :
      515     define input parameter parParentProc  as widget-handle no-undo.
      516     define output parameter p-report-name as character no-undo .
      517     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      518   end procedure.
      519   procedure prn-lib-reportviewer-report-name :
      520     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      521     define input parameter p-report-name-html as character no-undo .
      522     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      523   end procedure.
      524   procedure prn-lib-reportviewer :
      525     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      526     define input parameter p-report-name-html as character no-undo .
      527     define input parameter p-param        as character no-undo .
      528     define variable v-excel           as character no-undo init 'TRUE' .
      529     define variable v-value-character as character no-undo .
      530     define variable v-value-integer   as character no-undo .
      531     define variable v-value-date      as date      no-undo .
      532     define variable v-value-decimal   as decimal   no-undo .
      533     define variable rep-excel         as logical   no-undo .
      534     define variable excel-string      as character no-undo .
      535     define variable v-param-type      as character no-undo .
      536     define variable v-tth             as handle    no-undo .
      537     run adm/shattri.p (
      538       input "get":U
      539       ,input  ""
      540       ,input  0
      541       ,input  'report-glob':U
      542       ,input  'rep-excel':U
      543       ,output v-value-character
      544       ,output v-value-date
      545       ,output v-value-decimal
      546       ,output v-value-integer
      547       ,output rep-excel
      548       ,output v-param-type
      549       ,INPUT-OUTPUT table-handle v-tth
      550       )  .
      551     if rep-excel then v-excel = "TRUE" .
      552     else v-excel = "FALSE" .
      553     if p-param eq ""
      554     then
      555        p-param = "EXCEL:" + v-excel.
      556     else
      557        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      558     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      559   end procedure.
      560   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      561   procedure cur-time :
      562      define output parameter p-today as date      no-undo .
      563      define output parameter p-time  as integer   no-undo .
      564     do
      565     on error undo, return error
      566     :
      567       define variable v-date1 as date      no-undo .
      568       define variable v-date2 as date      no-undo .
      569       define variable v-time  as integer   no-undo .
      570       assign
      571         v-date1 = today
      572         v-time  = time
      573         v-date2 = today
      574       .
      575       if v-date1 <> v-date2
      576       then do:
      577         assign
      578           v-date1 = today
      579           v-time  = v-time
      580         .
      581       end.
      582       assign
      583         p-today = v-date1
      584         p-time  = v-time
      585       .
      586     end.
      587   end.
      588   function cur-time-date returns character
      589   :
      590     return string(today, '99/99/9999':U) .
      591   end.
      592   function cur-time-mjd returns decimal
      593   :
      594     define variable v-date as date      no-undo .
      595     define variable v-time as integer   no-undo .
      596     run cur-time in this-procedure
      597       (output v-date
      598       ,output v-time
      599       ) .
      600     return integer(v-date) - 2400002 + (v-time / 86400) .
      601   end.
      602   function cur-time-get-ending-index returns integer
      603   (input p-number as integer
      604   )
      605   :
      606     if p-number < 0
      607     or p-number = ?
      608     then do:
      609       return 1 .
      610     end.
      611     define variable v-rest as integer   no-undo .
      612     assign
      613       p-number = p-number modulo 100
      614     .
      615     if p-number < 20
      616     then do:
      617       assign
      618         v-rest = p-number
      619       .
      620     end.
      621     else do:
      622       assign
      623         v-rest = p-number modulo 10
      624       .
      625     end.
      626     case v-rest :
      627       when 1
      628       then do:
      629         return 2 .
      630       end.
      631       when 2 or
      632       when 3 or
      633       when 4
      634       then do:
      635         return 3 .
      636       end.
      637       otherwise do:
      638         return 1 .
      639       end.
      640     end case .
      641   end.
      642   procedure cur-time-mjd-to-date :
      643      define input  parameter i-mjd-diff as decimal no-undo.
      644      define output parameter o-Date     as date    no-undo.
      645      define output parameter o-Time     as integer no-undo.
      646      define variable v-day-number as integer   no-undo .
      647      if    i-mjd-diff < 0
      648         or i-mjd-diff = ?
      649      then do:
      650         return "?" .
      651      end.
      652      assign
      653         v-day-number = truncate(i-mjd-diff,0).
      654         o-Date = date(v-day-number + 2400002).
      655         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      656     .
      657   end.
      658   function cur-time-mjd-to-string returns character
      659   (input p-mjd-diff as decimal
      660   )
      661   :
      662     define variable v-day-number as integer   no-undo .
      663     define variable v-seconds    as integer   no-undo .
      664     define variable v-hour       as integer   no-undo .
      665     define variable v-min        as integer   no-undo .
      666     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      667     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      668     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      669     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      670     if p-mjd-diff < 0
      671     or p-mjd-diff = ?
      672     then do:
      673       return "?" .
      674     end.
      675     assign
      676       v-day-number = integer(truncate(p-mjd-diff,0))
      677       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      678     .
      679     if v-seconds > 86400
      680     then do:
      681       assign
      682         v-seconds = 86400 - 1
      683       .
      684     end.
      685     if v-seconds < 0
      686     then do:
      687       assign
      688         v-seconds = 0
      689       .
      690     end.
      691     assign
      692       v-hour = truncate(v-seconds / 3600, 0)
      693     .
      694     assign
      695       v-seconds = v-seconds modulo 3600
      696     .
      697     assign
      698       v-min = truncate(v-seconds / 60, 0)
      699     .
      700     assign
      701       v-seconds = v-seconds modulo 60
      702     .
      703     return
      704         (if v-day-number <> 0
      705           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      706           else ""
      707         )
      708       + (if v-day-number <> 0 or v-hour <> 0
      709           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      710           else ""
      711         )
      712       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      713           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      714           else ""
      715         )
      716       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      717       .
      718   end.
      719   function cur-time-string returns character
      720   :
      721     define variable v-date as date      no-undo .
      722     define variable v-time as integer   no-undo .
      723     run cur-time in this-procedure
      724       (output v-date
      725       ,output v-time
      726       ) .
      727     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      728   end.
      729   function cur-time-string-sec returns character
      730   :
      731     define variable v-date as date      no-undo .
      732     define variable v-time as integer   no-undo .
      733     run cur-time in this-procedure
      734       (output v-date
      735       ,output v-time
      736       ) .
      737     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      738   end.
      739   function cur-time-custom  returns character
      740   (input p-prefix as character
      741   ,input p-date-format as character
      742   ,input p-delimiter as character
      743   ,input p-time-format as character
      744   ,input p-suffix as character
      745   )
      746   :
      747     define variable v-date as date      no-undo .
      748     define variable v-time as integer   no-undo .
      749     run cur-time in this-procedure
      750       (output v-date
      751       ,output v-time
      752       ) .
      753     return
      754       p-prefix
      755       + string(v-date, p-date-format)
      756       + p-delimiter
      757       + string(v-time, p-time-format)
      758       + p-suffix
      759       .
      760   end.
      761   function cur-time-print  returns character
      762   :
      763     define variable v-date as date      no-undo .
      764     define variable v-time as integer   no-undo .
      765     run cur-time in this-procedure
      766       (output v-date
      767       ,output v-time
      768       ) .
      769     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      770   end.
      771   function cur-time-datetime returns datetime
      772   :
      773     define variable v-char as character no-undo .
      774     define variable v-datetime as datetime no-undo .
      775     v-char = cur-time-string().
      776     v-datetime = datetime(v-char).
      777     return  v-datetime.
      778   end.
      779   function cur-time-string-msec returns character
      780   :
      781     define variable v-date as datetime  no-undo .
      782     v-date = now.
      783     return string(v-date) .
      784   end.
      785   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      786   FUNCTION gbclcode-get-position returns character ( input p-role as character
      787                                                     ,input p-role-level as character
      788                                                     ,input p-work-place as character
      789                                                     ,input p-staff-code as integer
      790                                                                ):
      791   define variable v-role-name as character no-undo .
      792   define variable v-role-level as character no-undo .
      793   define variable v-staff-code as integer no-undo .
      794   assign
      795   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      796   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      797   v-staff-code = p-staff-code
      798   no-error .
      799   return substitute("&1, &2, Код &3"
      800                   ,v-role-name
      801                   ,v-role-level
      802                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      803   END.
      804   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      805   FUNCTION mark-string RETURNS CHARACTER
      806     ( input p-recid as recid, input mark-list as character  ) :
      807     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      808   END FUNCTION.
      809   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      810   function usrfulnf returns character ( input p-user-id as character):
      811   define variable v-user-name as character no-undo .
      812   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      813   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      814     (input  p-user-id
      815     ,output v-user-name
      816     ) no-error .
      817   if error-status:error
      818   or v-user-name = ""
      819   then do:
      820     return p-user-id.
      821   end.
      822   else do:
      823     return v-user-name.
      824   end.
      825   end function.
      826   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      827   define variable sort-column-name as character no-undo .
      828   define variable v-db-num LIKE ub.db.db-num no-undo.
      829   define variable v-rid-list as character no-undo .
      830   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      831   define   temp-table temp-changes no-undo
      832   field f_name as character
      833   field l_name as character
      834   field v_old as character
      835   field v_new as character
      836   field t_name as character
      837   field num_ as integer
      838   field uniq-key-rec as character
      839   field action as integer
      840   field fNotChange as logical
      841   index pi is unique primary
      842   num_
      843   t_name
      844   f_name
      845   index
      846   Chan
      847   fnotChange
      848   t_name
      849   f_name
      850   index imain uniq-key-rec
      851   .
      852   FUNCTION get-all-fields returns character (p-file-name as character ):
      853   define variable v-dop as character no-undo .
      854     find first _file no-lock where _file._file-name = p-file-name no-error .
      855     if not available _file then return "":U.
      856     for each _field no-lock where
      857              _field._file-recid = recid(_file) :
      858       assign
      859       v-dop = v-dop + _field._field-name + chr(44)
      860       .
      861     end.
      862     return trim(v-dop).
      863   END FUNCTION.
      864   PROCEDURE proc-full-temp-changes :
      865     define input  parameter p-act-create as logical   no-undo .
      866     define input  parameter p-act-delete as logical   no-undo .
      867     define input  parameter p-hst-handle as handle    no-undo .
      868     define input  parameter p-main-table as character no-undo .
      869     define input  parameter p-field-list as character no-undo .
      870     define input  parameter p-label-form as character no-undo .
      871     define variable h-new-buf         as handle    no-undo .
      872     define variable h-main-buf        as handle    no-undo .
      873     define variable h-for-comp        as handle    no-undo .
      874     define variable v-inform          as character no-undo .
      875     define variable v-ind             as integer   no-undo .
      876     define variable v-idx-field-qnty  as integer   no-undo .
      877     define variable v-num-entries     as integer   no-undo .
      878     define variable fh                as handle    no-undo .
      879     define variable fh-main           as handle    no-undo .
      880     define variable fh-old            as handle    no-undo .
      881     define variable fh-new            as handle    no-undo .
      882     define variable v-field-name      as character no-undo .
      883     define variable v-field-lvl       as character no-undo .
      884     define variable v-field-form      as character no-undo .
      885     define variable v-search-exp      as character no-undo .
      886     define variable v-srch-main       as character no-undo .
      887     define variable v-word-link       as character no-undo .
      888     define variable v-av-chip-num     as logical   no-undo .
      889     define variable v-main-pi-fld-lst as character no-undo .
      890     define variable v-main-fld-lst    as character no-undo .
      891     define variable v-delim-list      as character no-undo .
      892     define variable v-label           as character no-undo .
      893     define variable v-old-value       as character no-undo case-sensitive.
      894     define variable v-new-value       as character no-undo case-sensitive.
      895     define variable v-chg-fields as character no-undo.
      896     for each temp-changes:
      897       delete temp-changes.
      898     end.
      899     if not p-hst-handle:available then do:
      900       return .
      901     end.
      902     create buffer h-new-buf  for table p-hst-handle .
      903     create buffer h-main-buf for table p-main-table .
      904     assign
      905       v-inform = h-main-buf:index-information(1)
      906       v-ind    = 2
      907     .
      908     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      909     on error undo, return error
      910     :
      911       assign
      912         v-inform = h-main-buf:index-information( v-ind )
      913         v-ind    = v-ind + 1
      914       .
      915     end.
      916     if v-inform = ?
      917       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      918       or entry( 3, v-inform, ",":U ) <> "1":U
      919     then do:
      920       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      921     end.
      922     assign
      923       v-idx-field-qnty = num-entries( v-inform ) - 4
      924     .
      925     if v-idx-field-qnty < 2 then do:
      926       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      927     end.
      928     assign
      929       v-srch-main   = "where":U
      930       v-word-link   = "":U
      931       v-av-chip-num = false
      932       v-delim-list  = "":U
      933     .
      934     do v-ind = 1 to v-idx-field-qnty by 2
      935     on error undo, return error
      936     :
      937       assign
      938         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      939         fh                = p-hst-handle:buffer-field( v-field-name )
      940         fh-main           = h-main-buf:buffer-field( v-field-name )
      941         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      942         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      943       .
      944       if fh:data-type ="character":U then do:
      945         assign
      946           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      947         .
      948       end.
      949       else do:
      950         assign
      951           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      952         .
      953       end.
      954       if v-delim-list = "":U then do:
      955         assign
      956           v-delim-list = ",":U
      957         .
      958       end.
      959       if v-word-link = "":U then do:
      960         assign
      961           v-word-link = "and":U
      962         .
      963       end.
      964     end.
      965     assign
      966       v-delim-list  = "":U
      967     .
      968     do v-ind = 1 to h-main-buf:num-fields
      969     on error undo, return error
      970     :
      971       assign
      972         fh-main      = h-main-buf:buffer-field( v-ind )
      973         v-field-name = fh-main:name
      974       .
      975         assign
      976           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      977         .
      978         if v-delim-list = "":U then do:
      979           assign
      980             v-delim-list = ",":U
      981           .
      982         end.
      983     end.
      984     assign
      985       v-inform = p-hst-handle:index-information(1)
      986       v-ind    = 2
      987     .
      988     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      989     on error undo, return error
      990     :
      991       assign
      992         v-inform = p-hst-handle:index-information( v-ind )
      993         v-ind    = v-ind + 1
      994       .
      995     end.
      996     if v-inform = ?
      997       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      998       or entry( 3, v-inform, ",":U ) <> "1":U
      999     then do:
     1000       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1001     end.
     1002     assign
     1003       v-idx-field-qnty = num-entries( v-inform ) - 4
     1004     .
     1005     if v-idx-field-qnty < 2 then do:
     1006       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1007     end.
     1008     assign
     1009       v-search-exp  = "where":U
     1010       v-word-link   = "":U
     1011       v-av-chip-num = false
     1012     .
     1013     do v-ind = 1 to v-idx-field-qnty by 2
     1014     on error undo, return error
     1015     :
     1016       assign
     1017         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1018         fh           = p-hst-handle:buffer-field( v-field-name )
     1019         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1020       .
     1021       if v-field-name = "chip-num":U then do:
     1022         assign
     1023           v-search-exp  = substitute( "&1 >", v-search-exp )
     1024           v-av-chip-num = true
     1025         .
     1026       end.
     1027       else do:
     1028         assign
     1029           v-search-exp = substitute( "&1 =", v-search-exp )
     1030         .
     1031       end.
     1032       if fh:data-type ="character":U then do:
     1033         assign
     1034           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1035         .
     1036       end.
     1037       else do:
     1038         assign
     1039           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1040         .
     1041       end.
     1042       if v-word-link = "":U then do:
     1043         assign
     1044           v-word-link = "and":U
     1045         .
     1046       end.
     1047     end.
     1048     if v-av-chip-num = false then do:
     1049       message
     1050         vss-workfile vss-revision vss-description skip
     1051         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1052         "Использование данной процедуры невозможно!" skip
     1053         view-as alert-box error .
     1054       return error .
     1055     end.
     1056     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1057     if not h-new-buf:available then do:
     1058       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1059       if not h-main-buf:available then do:
     1060         assign
     1061           h-for-comp = ?
     1062         .
     1063       end.
     1064       else do:
     1065         assign
     1066           h-for-comp = h-main-buf
     1067         .
     1068       end.
     1069     end.
     1070     else do:
     1071       assign
     1072         h-for-comp = h-new-buf
     1073       .
     1074     end.
     1075     assign
     1076       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1077     .
     1078     do v-ind = 1 to v-num-entries
     1079     on error undo, return error return-value
     1080     :
     1081       assign
     1082         v-field-name = entry( v-ind, v-main-fld-lst )
     1083         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1084         v-old-value  = fh-old:buffer-value()
     1085         v-label      = trim( fh-old:label )
     1086       .
     1087       if ( trim( p-field-list ) <> "":U
     1088            and lookup( v-field-name, p-field-list ) > 0
     1089          )
     1090          or trim( p-field-list ) = "":U
     1091       then do:
     1092         if h-for-comp <> ? then do:
     1093           assign
     1094             fh-new      = h-for-comp:buffer-field( v-field-name )
     1095             v-new-value = fh-new:buffer-value()
     1096           .
     1097         end.
     1098         else do:
     1099           assign
     1100             v-new-value = "":U
     1101           .
     1102         end.
     1103           if p-act-create = true then do:
     1104             assign
     1105               v-old-value = "":U
     1106             .
     1107           end.
     1108           if p-act-delete = true then do:
     1109             assign
     1110               v-new-value = "":U
     1111             .
     1112           end.
     1113         if v-old-value <> v-new-value
     1114         then do:
     1115           create temp-changes.
     1116           assign
     1117             temp-changes.t_name = p-main-table
     1118             temp-changes.f_name = v-field-name
     1119             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1120             temp-changes.v_old  = trim( v-old-value )
     1121             temp-changes.v_new  = trim( v-new-value )
     1122             temp-changes.num_   = 0
     1123             temp-changes.fNotChange = v-old-value eq v-new-value
     1124           .
     1125         end.
     1126       end.
     1127     end.
     1128     assign
     1129       v-num-entries = num-entries( p-label-form, chr(8) )
     1130     .
     1131     do v-ind = 1 to v-num-entries
     1132     on error undo, return error return-value
     1133     :
     1134       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1135         assign
     1136           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1137           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1138           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1139         .
     1140         find first temp-changes
     1141           where temp-changes.f_name = v-field-name
     1142           no-error .
     1143         if available temp-changes then do:
     1144           if trim( v-field-lvl ) <> "":U then do:
     1145             assign
     1146               temp-changes.l_name = v-field-lvl
     1147             .
     1148           end.
     1149           if trim( v-field-form ) <> "":U then do:
     1150             assign
     1151               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1152             .
     1153             if h-for-comp <> ? then do:
     1154               assign
     1155                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1156               .
     1157             end.
     1158           end.
     1159         end.
     1160       end.
     1161       else do:
     1162         message
     1163           vss-workfile vss-revision vss-description skip
     1164           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1165           substitute( "список для поля '&1': '&2'"
     1166                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1167                       ,entry( v-ind, p-label-form, chr(8) )
     1168                     ) skip
     1169           substitute( "полный список: &2", p-label-form ) skip
     1170           view-as alert-box error .
     1171       end.
     1172     end.
     1173     delete object h-new-buf .
     1174     delete object h-main-buf .
     1175   END PROCEDURE.
     1176   FUNCTION get-action RETURNS CHARACTER
     1177     ( INPUT p-action AS integer )  FORWARD.
     1178   FUNCTION get-action-from-c-cli RETURNS CHARACTER
     1179     ( INPUT p-psn-code AS INTEGER, INPUT p-corr-user-db-num AS INTEGER, INPUT p-chip-num AS INTEGER )  FORWARD.
     1180   DEFINE BUTTON B-Help
     1181        LABEL "Помо&щь"
     1182        SIZE 3 BY 1
     1183        BGCOLOR 8 .
     1184   DEFINE BUTTON B-lookup
     1185        LABEL "&Просмотр"
     1186        SIZE 10 BY 1.
     1187   DEFINE BUTTON B-mark
     1188        LABEL "&*"
     1189        SIZE 3 BY 1.
     1190   DEFINE BUTTON b-quit AUTO-END-KEY
     1191        LABEL "&Выход"
     1192        SIZE 10 BY 1
     1193        BGCOLOR 8 .
     1194   DEFINE BUTTON B-sel AUTO-GO
     1195        LABEL "Вы&бор"
     1196        SIZE 10 BY 1.
     1197   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1198         VIEW-AS TEXT
     1199        SIZE 6 BY 1
     1200        FGCOLOR 4  NO-UNDO.
     1201   DEFINE QUERY BR-changes FOR
     1202         temp-changes SCROLLING.
     1203   DEFINE QUERY br-cstaff FOR
     1204         X_c-staff SCROLLING.
     1205   DEFINE BROWSE BR-changes
     1206     QUERY BR-changes DISPLAY
     1207         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1208   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1209   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1210       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.04.
     1211   DEFINE BROWSE br-cstaff
     1212     QUERY br-cstaff NO-LOCK DISPLAY
     1213         mark-string(recid(X_c-staff), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1214   usrfulnf(X_c-staff.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1215   X_c-staff.corr-date COLUMN-LABEL "Дата!измен" FORMAT "99/99/9999":U
     1216   string(X_c-staff.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1217   gbclcode-get-position ( input X_c-staff.role
     1218                           ,input X_c-staff.role-level
     1219                           ,input X_c-staff.work-place
     1220                            ,input X_c-staff.staff-code )
     1221   COLUMN-LABEL "Работает" FORMAT "X(34)":U WIDTH 34
     1222   get-action-from-c-cli(X_c-staff.psn-code, X_c-staff.corr-user-db-num, X_c-staff.chip-num) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1223   X_c-staff.psn-code COLUMN-LABEL "Код физ.лица" FORMAT ">>>>>>>>9"
     1224   X_c-staff.date-start FORMAT "99/99/9999":U COLUMN-LABEL "Работает с"
     1225       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.25.
     1226   DEFINE FRAME Dialog-Frame
     1227        b-quit AT ROW 1 COL 1
     1228        B-mark AT ROW 1 COL 11
     1229        B-sel AT ROW 1 COL 21
     1230        B-lookup AT ROW 1 COL 61
     1231        B-Help AT ROW 1 COL 95
     1232        br-cstaff AT ROW 3 COL 1
     1233        BR-changes AT ROW 13 COL 1
     1234        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1235        SPACE(78.62) SKIP(20.04)
     1236       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1237            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1238            TITLE "История персонала"
     1239            CANCEL-BUTTON b-quit.
     1240   ASSIGN
     1241          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1242          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1243   ASSIGN
     1244          B-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1245   ASSIGN
     1246          br-cstaff:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1247   ON GO OF FRAME Dialog-Frame
     1248   DO:
     1249     p-rid-list = v-rid-list.
     1250   END.
     1251   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1252   DO:
     1253     APPLY "END-ERROR":U TO SELF.
     1254   END.
     1255   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1256   DO:
     1257     define variable loc#log as logical no-undo .
     1258     if available X_c-staff then do:
     1259   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1260   define variable v-str-recid11 as character no-undo .
     1261   define variable v-num-entry11 as integer   no-undo .
     1262   assign
     1263     v-str-recid11 = trim( string( recid( X_c-staff ) , "->>>>>>>>>>>9":U ) )
     1264     v-num-entry11 = lookup( v-str-recid11 , v-rid-list )
     1265   .
     1266   if v-num-entry11 > 0 then do:
     1267     assign
     1268       entry( v-num-entry11, v-rid-list ) = "":U
     1269       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1270     .
     1271   end.
     1272   else do:
     1273     assign
     1274       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid11
     1275     .
     1276   end.
     1277       loc#log = br-cstaff:refresh() .
     1278       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1279           loc#log = br-cstaff:select-next-row ().
     1280           apply "VALUE-CHANGED" to br-cstaff in frame Dialog-Frame.
     1281       end.
     1282       if num-entries( v-rid-list ) = 0
     1283       then
     1284           hide mark-num in frame Dialog-Frame.
     1285       else
     1286           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1287     end.
     1288     apply "entry" to br-cstaff in frame Dialog-Frame.
     1289   END.
     1290   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1291   DO:
     1292       if ( available X_c-staff ) then do:
     1293       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1294       then
     1295       v-rid-list = string( recid( X_c-staff ) ) .
     1296     end.
     1297   END.
     1298   ON RETURN OF br-cstaff IN FRAME Dialog-Frame
     1299   or MOUSE-SELECT-DBLCLICK OF br-cstaff IN FRAME Dialog-Frame
     1300       DO:
     1301       run proc-br-cstaff no-error.
     1302     if error-status:error then return no-apply.
     1303   END.
     1304   ON VALUE-CHANGED OF br-cstaff IN FRAME Dialog-Frame
     1305   DO:
     1306     run proc-view-changes in this-procedure no-error.
     1307   END.
     1308   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1309   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1310   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1311   on help of frame Dialog-Frame
     1312   do:
     1313     run gbl/app_help.p
     1314       (input this-procedure :file-name
     1315       ,input ''
     1316       ,input ?
     1317       ) no-error.
     1318     if error-status :error then do:
     1319       message
     1320         "Ошибка при вызове помощи"
     1321         error-status :get-message(1)
     1322         view-as alert-box .
     1323     end.
     1324   end.
     1325   run minbtn-set in this-procedure .
     1326   on choose of b-help in frame Dialog-Frame
     1327   do:
     1328     apply "help":u to frame Dialog-Frame .
     1329   end.
     1330   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1331   procedure minbtn-set :
     1332       do
     1333           on error undo, return error return-value
     1334           :
     1335           define variable ii              as integer       no-undo .
     1336           define variable fh              as widget-handle no-undo .
     1337           define variable hh              as widget-handle no-undo .
     1338           define variable v-h             as handle        extent 4 no-undo .
     1339           define variable v-name-button   as character     no-undo .
     1340           define variable v-help-old-x    as decimal       no-undo .
     1341           define variable v-help-old-y    as decimal       no-undo .
     1342           define variable v-help-old-size as decimal       no-undo .
     1343           define variable v-frame-width   as decimal       no-undo .
     1344           define variable jj              as integer       no-undo .
     1345           do
     1346               on error undo, return error
     1347               :
     1348               assign
     1349                   v-frame-width = frame Dialog-Frame:width - 0.3
     1350                   fh            = frame Dialog-Frame:first-child
     1351                   hh            = fh:first-child
     1352                   ii            = 1
     1353                   .
     1354               do while valid-handle(hh):
     1355                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1356                   do:
     1357                       case lc(hh:name) :
     1358                           when "b-help" then
     1359                               do:
     1360                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1361                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1362                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1363                                   hh:TOOLTIP = "Помощь" .
     1364                                   v-help-old-x = hh:column .
     1365                                   v-help-old-y = hh:row    .
     1366                                   v-help-old-size = hh:width .
     1367                                   hh:width-chars = 2.5 .
     1368                               end.
     1369                           when "b-print" then
     1370                               do:
     1371                                   hh:load-image("cmp/b-print.bmp":u) .
     1372                                   hh:TOOLTIP = "Печать" .
     1373                                   v-h[ii] = hh:handle .
     1374                                   ii = ii + 1 .
     1375                                   hh:width-chars = 3 .
     1376                               end.
     1377                           when "b-history" or
     1378                           when "b-hist" then
     1379                               do:
     1380                                   hh:load-image("cmp/b-hist.bmp":u) .
     1381                                   hh:TOOLTIP = "История" .
     1382                                   v-h[ii] = hh:handle .
     1383                                   ii = ii + 1 .
     1384                                   hh:width-chars = 3 .
     1385                               end.
     1386                           when "b-sch" then
     1387                               do:
     1388                                   hh:load-image("cmp/b-sch.bmp":u) .
     1389                                   hh:TOOLTIP = "Установка Фильтра" .
     1390                                   v-h[ii] = hh:handle .
     1391                                   ii = ii + 1 .
     1392                                   hh:width-chars = 3 .
     1393                               end.
     1394                           when "b-hist-user" then
     1395                               do:
     1396                                   hh:load-image("cmp/b-hist.bmp":u) .
     1397                                   hh:TOOLTIP = "История пользователя" .
     1398                                   ii = ii + 1 .
     1399                               end.
     1400                       end case.
     1401                   end.
     1402                   hh = hh:next-sibling.
     1403               end.
     1404               b-help:column = v-frame-width - b-help:width-chars.
     1405               jj = 0.
     1406               repeat ii = 4 to 1 by -1 :
     1407                   if valid-handle (v-h[ii] ) then
     1408                   do:
     1409                       jj  = jj + 1 .
     1410                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1411                       v-h[ii]:row    = v-help-old-y .
     1412                   end.
     1413               end.
     1414           end.
     1415       end.
     1416   end procedure.
     1417   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1418   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1419   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1420   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1421   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1422   define variable v-diasize-current-frame-height as decimal   no-undo .
     1423   define variable v-diasize-change-size          as logical   no-undo .
     1424   define variable v-diasize-resize-button        as handle    no-undo .
     1425   define variable v-diasize-wndmax               as logical   no-undo .
     1426   define variable v-diasize-wndstore             as logical   no-undo .
     1427   define variable v-diasize-proc-name            as character no-undo .
     1428   define variable v-diasize-browse-handle        as handle    no-undo .
     1429   define variable v-diasize-browse-number        as integer   no-undo .
     1430   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1431   define temp-table temp-diasize-handle no-undo
     1432     field handle-value  as handle
     1433     field save-position as decimal
     1434     index xpk is primary unique handle-value
     1435     .
     1436   define temp-table temp-browse-handle no-undo
     1437     field browse-type   as character
     1438     field browse-number as integer
     1439     field browse-handle as handle
     1440     field original-size as decimal
     1441     index xpk is primary unique browse-type browse-number
     1442     index xie browse-type browse-handle
     1443   .
     1444   procedure diasize_change-height :
     1445     define input  parameter p-change-value  as decimal   no-undo .
     1446     define input  parameter p-move-resize   as logical   no-undo .
     1447     define variable v-field-group-handle    as handle    no-undo .
     1448     define variable v-object-handle         as handle    no-undo .
     1449     define variable v-frame-height          as decimal   no-undo .
     1450     define variable v-frame-virtual-height  as decimal   no-undo .
     1451     define variable v-browse-height         as decimal   no-undo .
     1452     define variable v-window-height         as decimal   no-undo .
     1453     define variable v-window-virtual-height as decimal   no-undo .
     1454     define variable v-change-sign           as integer   no-undo .
     1455     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1456     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1457     if p-change-value > 0
     1458     then do:
     1459       if frame Dialog-Frame :height + p-change-value
     1460           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1461       then do:
     1462         assign
     1463           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1464                           - (frame Dialog-Frame :height-chars)
     1465         .
     1466         if p-change-value <= 0
     1467         then do:
     1468           run diasize_position-resize-button in this-procedure .
     1469           return .
     1470         end.
     1471       end.
     1472     end.
     1473     if p-change-value < 0
     1474     then do:
     1475       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1476       then do:
     1477         assign
     1478           p-change-value = v-diasize-orig-frame-height
     1479                          - (frame Dialog-Frame :height-chars)
     1480         .
     1481         if p-change-value >= 0
     1482         then do:
     1483           run diasize_position-resize-button in this-procedure .
     1484           return .
     1485         end.
     1486       end.
     1487     end.
     1488     if p-change-value >= 0
     1489     then do:
     1490       assign
     1491         v-change-sign = 1
     1492       .
     1493     end.
     1494     else do:
     1495       assign
     1496         v-change-sign = -1
     1497       .
     1498     end.
     1499     assign
     1500       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1501     .
     1502     if p-change-value = 0
     1503     then do:
     1504       run diasize_position-resize-button in this-procedure .
     1505       return .
     1506     end.
     1507     move_block:
     1508     do
     1509     on error undo move_block, retry move_block
     1510     :
     1511       if retry
     1512       then do:
     1513         do
     1514         on error undo move_block, leave move_block
     1515         :
     1516           if p-change-value > 0
     1517           then do:
     1518             for each buf_temp-diasize-handle
     1519             on error undo, next
     1520             :
     1521               assign
     1522                 v-object-handle = buf_temp-diasize-handle.handle-value
     1523               .
     1524               if v-object-handle <> v-diasize-resize-button
     1525               then do:
     1526                 assign
     1527                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1528                 .
     1529               end.
     1530             end.
     1531             assign
     1532               v-diasize-browse-handle :height = v-browse-height
     1533             .
     1534             for each buf_temp-browse-handle
     1535               where buf_temp-browse-handle.browse-type = 'height':u
     1536             on error undo, next
     1537             :
     1538               assign
     1539                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1540               .
     1541             end.
     1542             assign
     1543               frame Dialog-Frame :height = v-frame-height
     1544             .
     1545             if frame Dialog-Frame :scrollable = true
     1546             then do:
     1547               assign
     1548                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1549               .
     1550             end.
     1551             run diasize_position-resize-button in this-procedure .
     1552           end.
     1553           else do:
     1554             if frame Dialog-Frame :scrollable = true
     1555             then do:
     1556               assign
     1557                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1558               .
     1559             end.
     1560             assign
     1561               frame Dialog-Frame :height = v-frame-height
     1562             .
     1563             assign
     1564               v-diasize-browse-handle :height = v-browse-height
     1565             .
     1566             for each buf_temp-browse-handle
     1567               where buf_temp-browse-handle.browse-type = 'height':u
     1568             on error undo, next
     1569             :
     1570               assign
     1571                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1572               .
     1573             end.
     1574             for each buf_temp-diasize-handle
     1575             on error undo, next
     1576             :
     1577               assign
     1578                 v-object-handle = buf_temp-diasize-handle.handle-value
     1579               .
     1580               if v-object-handle <> v-diasize-resize-button
     1581               then do:
     1582                 assign
     1583                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1584                 .
     1585               end.
     1586             end.
     1587             run diasize_position-resize-button in this-procedure .
     1588           end.
     1589           assign
     1590             v-diasize-change-size = false
     1591           .
     1592           leave move_block .
     1593         end.
     1594       end.
     1595       assign
     1596         v-diasize-need-full-display = true
     1597       .
     1598       if v-diasize-change-size = false
     1599       then do:
     1600         assign
     1601           v-diasize-change-size = true
     1602         .
     1603       end.
     1604       else do:
     1605         return .
     1606       end.
     1607       assign
     1608         v-frame-height = frame Dialog-Frame :height
     1609         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1610         v-browse-height = v-diasize-browse-handle :height
     1611       .
     1612       for each buf_temp-browse-handle
     1613         where buf_temp-browse-handle.browse-type = 'height':u
     1614       :
     1615         assign
     1616           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1617         .
     1618       end.
     1619       for each buf_temp-diasize-handle
     1620       :
     1621         delete buf_temp-diasize-handle .
     1622       end.
     1623       assign
     1624         v-field-group-handle = frame Dialog-Frame :first-child
     1625       .
     1626       do while valid-handle(v-field-group-handle)
     1627       :
     1628         assign
     1629           v-object-handle = v-field-group-handle :first-child
     1630         .
     1631         do while valid-handle(v-object-handle)
     1632         :
     1633           if  v-object-handle <> v-diasize-browse-handle :handle
     1634           and can-query(v-object-handle, "row")
     1635           and can-query(v-object-handle, "height")
     1636           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1637           then do:
     1638             find first buf_temp-browse-handle
     1639               where buf_temp-browse-handle.browse-type   = 'height':u
     1640                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1641               no-error .
     1642             if available buf_temp-browse-handle
     1643             then do:
     1644             end.
     1645             else do:
     1646               create buf_temp-diasize-handle .
     1647               assign
     1648                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1649                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1650               .
     1651             end.
     1652           end.
     1653           assign
     1654             v-object-handle = v-object-handle :next-sibling
     1655           .
     1656         end.
     1657         assign
     1658           v-field-group-handle = v-field-group-handle :next-sibling
     1659         .
     1660       end.
     1661       do with frame Dialog-Frame
     1662       :
     1663         hide v-diasize-resize-button .
     1664         assign
     1665           v-diasize-resize-button :row    = 1
     1666           v-diasize-resize-button :column = 1
     1667         .
     1668       end.
     1669       if p-change-value > 0
     1670       then do:
     1671         if frame Dialog-Frame :scrollable = true
     1672         then do:
     1673           assign
     1674             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1675             no-error .
     1676           if error-status :error
     1677           or error-status :get-message(1) <> ""
     1678           then do:
     1679             undo move_block, retry move_block .
     1680           end.
     1681         end.
     1682         assign
     1683           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1684           no-error .
     1685         if error-status :error
     1686         or error-status :get-message(1) <> ""
     1687         then do:
     1688           undo move_block, retry move_block .
     1689         end.
     1690         assign
     1691           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1692           no-error .
     1693         if error-status :error
     1694         or error-status :get-message(1) <> ""
     1695         then do:
     1696           undo move_block, retry move_block .
     1697         end.
     1698         for each buf_temp-browse-handle
     1699           where buf_temp-browse-handle.browse-type = 'height':u
     1700         on error undo move_block, retry move_block
     1701         :
     1702           assign
     1703             buf_temp-browse-handle.browse-handle :height
     1704               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1705             no-error .
     1706           if error-status :error
     1707           or error-status :get-message(1) <> ""
     1708           then do:
     1709             undo move_block, retry move_block .
     1710           end.
     1711         end.
     1712         for each buf_temp-diasize-handle
     1713         on error undo move_block, retry move_block
     1714         :
     1715           assign
     1716             v-object-handle = buf_temp-diasize-handle.handle-value
     1717           .
     1718           if v-object-handle <> v-diasize-resize-button
     1719           then do:
     1720             assign
     1721               v-object-handle :row = v-object-handle :row + p-change-value
     1722               no-error .
     1723             if error-status :error
     1724             or error-status :get-message(1) <> ""
     1725             then do:
     1726               undo move_block, retry move_block .
     1727             end.
     1728           end.
     1729         end.
     1730       end.
     1731       else do:
     1732         for each buf_temp-diasize-handle
     1733         on error undo move_block, retry move_block
     1734         :
     1735           assign
     1736             v-object-handle = buf_temp-diasize-handle.handle-value
     1737           .
     1738           if v-object-handle <> v-diasize-resize-button
     1739           then do:
     1740             assign
     1741               v-object-handle :row = v-object-handle :row + p-change-value
     1742               no-error .
     1743             if error-status :error
     1744             or error-status :get-message(1) <> ""
     1745             then do:
     1746               undo move_block, retry move_block .
     1747             end.
     1748           end.
     1749         end.
     1750         assign
     1751           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1752           no-error .
     1753         if error-status :error
     1754         or error-status :get-message(1) <> ""
     1755         then do:
     1756           undo move_block, retry move_block .
     1757         end.
     1758         for each buf_temp-browse-handle
     1759           where buf_temp-browse-handle.browse-type = 'height':u
     1760         on error undo move_block, retry move_block
     1761         :
     1762           assign
     1763             buf_temp-browse-handle.browse-handle :height
     1764               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1765             no-error .
     1766           if error-status :error
     1767           or error-status :get-message(1) <> ""
     1768           then do:
     1769             undo move_block, retry move_block .
     1770           end.
     1771         end.
     1772         assign
     1773           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1774           no-error .
     1775         if error-status :error
     1776         or error-status :get-message(1) <> ""
     1777         then do:
     1778           undo move_block, retry move_block .
     1779         end.
     1780         if frame Dialog-Frame :scrollable = true
     1781         then do:
     1782           assign
     1783             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1784             no-error .
     1785           if error-status :error
     1786           or error-status :get-message(1) <> ""
     1787           then do:
     1788             undo move_block, retry move_block .
     1789           end.
     1790         end.
     1791       end.
     1792       if p-move-resize = true
     1793       then do:
     1794         run diasize_position-resize-button in this-procedure .
     1795       end.
     1796       if v-diasize-wndstore = true
     1797       then do:
     1798         if connected("ub") = true
     1799         then do:
     1800           define variable v-cntxt-db-num        as integer   no-undo .
     1801           define variable v-cntxt-userid        as character no-undo .
     1802           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1803                                             , OUTPUT v-cntxt-userid
     1804                                             ) .
     1805           run gbl/wndsizew.p
     1806             (input  v-cntxt-db-num
     1807             ,input  v-cntxt-userid
     1808             ,input  v-diasize-proc-name
     1809             ,input  'height':u
     1810             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1811             ) .
     1812         end.
     1813       end.
     1814     end.
     1815     assign
     1816       v-diasize-change-size = false
     1817     .
     1818   end procedure.
     1819   procedure diasize_set-height :
     1820     define input  parameter p-new-height  as decimal   no-undo .
     1821     define input  parameter p-move-resize as logical   no-undo .
     1822     do
     1823     on error undo, return error return-value
     1824     :
     1825       run diasize_change-height in this-procedure
     1826         (input  (p-new-height - frame Dialog-Frame :height)
     1827         ,input  p-move-resize
     1828         ) .
     1829     end.
     1830   end procedure.
     1831   procedure diasize_change-width :
     1832     define input  parameter p-change-value as decimal   no-undo .
     1833     define input  parameter p-move-resize  as logical   no-undo .
     1834     define variable v-field-group-handle   as handle    no-undo .
     1835     define variable v-object-handle        as handle    no-undo .
     1836     define variable v-frame-width          as decimal   no-undo .
     1837     define variable v-frame-virtual-width  as decimal   no-undo .
     1838     define variable v-browse-width         as decimal   no-undo .
     1839     define variable v-window-width         as decimal   no-undo .
     1840     define variable v-window-virtual-width as decimal   no-undo .
     1841     define variable v-change-sign          as integer   no-undo .
     1842     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1843     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1844     if p-change-value > 0
     1845     then do:
     1846       if frame Dialog-Frame :width + p-change-value >
     1847           session :width-chars
     1848       then do:
     1849         assign
     1850           p-change-value = session :width-chars - frame Dialog-Frame :width
     1851         .
     1852         if p-change-value <= 0
     1853         then do:
     1854           run diasize_position-resize-button in this-procedure .
     1855           return .
     1856         end.
     1857       end.
     1858     end.
     1859     if p-change-value < 0
     1860     then do:
     1861       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1862       then do:
     1863         assign
     1864           p-change-value = v-diasize-orig-frame-width
     1865                          - frame Dialog-Frame :width
     1866         .
     1867         if p-change-value >= 0
     1868         then do:
     1869           run diasize_position-resize-button in this-procedure .
     1870           return .
     1871         end.
     1872       end.
     1873     end.
     1874     if p-change-value >= 0
     1875     then do:
     1876       assign
     1877         v-change-sign = 1
     1878       .
     1879     end.
     1880     else do:
     1881       assign
     1882         v-change-sign = -1
     1883       .
     1884     end.
     1885     assign
     1886       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1887     .
     1888     if p-change-value = 0
     1889     then do:
     1890       run diasize_position-resize-button in this-procedure .
     1891       return .
     1892     end.
     1893     move_block:
     1894     do
     1895     on error undo move_block, leave move_block
     1896     :
     1897       if retry
     1898       then do:
     1899         do
     1900         on error undo move_block, leave move_block
     1901         :
     1902           if p-change-value > 0
     1903           then do:
     1904             for each buf_temp-diasize-handle
     1905             on error undo, next
     1906             :
     1907               assign
     1908                 v-object-handle = buf_temp-diasize-handle.handle-value
     1909               .
     1910               if v-object-handle <> v-diasize-resize-button
     1911               then do:
     1912                 assign
     1913                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1914                 .
     1915               end.
     1916             end.
     1917             assign
     1918               v-diasize-browse-handle :width = v-browse-width
     1919             .
     1920             for each buf_temp-browse-handle
     1921               where buf_temp-browse-handle.browse-type = 'width':u
     1922             on error undo, next
     1923             :
     1924               assign
     1925                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1926               .
     1927             end.
     1928             assign
     1929               frame Dialog-Frame :width = v-frame-width
     1930             .
     1931             if frame Dialog-Frame :scrollable = true
     1932             then do:
     1933               assign
     1934                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1935               .
     1936             end.
     1937             run diasize_position-resize-button in this-procedure .
     1938           end.
     1939           else do:
     1940             if frame Dialog-Frame :scrollable = true
     1941             then do:
     1942               assign
     1943                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1944               .
     1945             end.
     1946             assign
     1947               frame Dialog-Frame :width = v-frame-width
     1948             .
     1949             for each buf_temp-browse-handle
     1950               where buf_temp-browse-handle.browse-type = 'width':u
     1951             on error undo, next
     1952             :
     1953               assign
     1954                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1955               .
     1956             end.
     1957             assign
     1958               v-diasize-browse-handle :width = v-browse-width
     1959             .
     1960             for each buf_temp-diasize-handle
     1961             on error undo, next
     1962             :
     1963               assign
     1964                 v-object-handle = buf_temp-diasize-handle.handle-value
     1965               .
     1966               if v-object-handle <> v-diasize-resize-button
     1967               then do:
