     2204     .
     2205   end procedure.
     2206   procedure diasize_set-width :
     2207     define input  parameter p-new-width  as decimal   no-undo .
     2208     define input  parameter p-move-resize as logical   no-undo .
     2209     do
     2210     on error undo, return error return-value
     2211     :
     2212       run diasize_change-width in this-procedure
     2213         (input  (p-new-width - frame Dialog-Frame :width)
     2214         ,input  p-move-resize
     2215         ) .
     2216     end.
     2217   end procedure.
     2218   procedure diasize_position-resize-button :
     2219     do with frame Dialog-Frame
     2220     :
     2221       hide v-diasize-resize-button .
     2222       assign
     2223         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2224                     - 1
     2225                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2226         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2227                     - 1
     2228                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2229       .
     2230       view v-diasize-resize-button .
     2231     end.
     2232   end procedure.
     2233   on alt-right anywhere
     2234   do:
     2235     run diasize_change-width in this-procedure
     2236       (input 1
     2237       ,input true
     2238       ) .
     2239     return no-apply .
     2240   end.
     2241   on alt-left anywhere
     2242   do:
     2243     run diasize_change-width in this-procedure
     2244       (input -1
     2245       ,input true
     2246       ) .
     2247     return no-apply .
     2248   end.
     2249   on alt-down anywhere
     2250   do:
     2251     run diasize_change-height in this-procedure
     2252       (input 1
     2253       ,input true
     2254       ) .
     2255     return no-apply .
     2256   end.
     2257   on alt-up anywhere
     2258   do:
     2259     run diasize_change-height in this-procedure
     2260       (input -1
     2261       ,input true
     2262       ) .
     2263     return no-apply .
     2264   end.
     2265   on alt-enter of frame Dialog-Frame
     2266   do:
     2267     run diasize_maximize in this-procedure
     2268       (input  ?
     2269       ).
     2270     return no-apply .
     2271   end.
     2272   procedure diasize_end-move :
     2273     do
     2274     on error undo, return error return-value
     2275     :
     2276       define variable v-row-delta as decimal   no-undo .
     2277       define variable v-col-delta as decimal   no-undo .
     2278       define variable v-new-row as decimal   no-undo .
     2279       define variable v-new-col as decimal   no-undo .
     2280       assign
     2281         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2282         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2283       .
     2284       assign
     2285         v-row-delta = v-new-row - frame Dialog-Frame :height
     2286         v-col-delta = v-new-col - frame Dialog-Frame :width
     2287       .
     2288       run diasize_change-height in this-procedure
     2289         (input v-row-delta
     2290         ,input true
     2291         ) .
     2292       run diasize_change-width in this-procedure
     2293         (input v-col-delta
     2294         ,input true
     2295         ) .
     2296     end.
     2297   end procedure.
     2298   procedure diasize_maximize :
     2299     define input  parameter p-action as logical   no-undo .
     2300     do
     2301     on error undo, return error return-value
     2302     :
     2303       if p-action = ?
     2304       then do:
     2305         if v-diasize-need-maximize = true
     2306         then do:
     2307           assign
     2308             p-action = true
     2309           .
     2310         end.
     2311         else do:
     2312           assign
     2313             p-action = false
     2314           .
     2315         end.
     2316       end.
     2317       if p-action = true
     2318       then do:
     2319         run diasize_change-height in this-procedure
     2320           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2321               - frame Dialog-Frame :height-chars
     2322           ,input true
     2323           ) .
     2324         run diasize_change-width in this-procedure
     2325           (input session :width-chars
     2326               - frame Dialog-Frame :width-chars
     2327           ,input true
     2328           ) .
     2329         assign
     2330           v-diasize-need-maximize = false
     2331         .
     2332       end.
     2333       else do:
     2334         run diasize_change-width in this-procedure
     2335           (input v-diasize-orig-frame-width
     2336               - frame Dialog-Frame :width-chars
     2337           ,input true
     2338           ) .
     2339         run diasize_change-height in this-procedure
     2340           (input v-diasize-orig-frame-height
     2341               - frame Dialog-Frame :height-chars
     2342           ,input true
     2343           ) .
     2344         assign
     2345           v-diasize-need-maximize = true
     2346         .
     2347       end.
     2348     end.
     2349   end procedure.
     2350   procedure diasize_restore-orig-size :
     2351     do
     2352     on error undo, return error return-value
     2353     :
     2354       assign
     2355         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2356         v-diasize-current-frame-height = frame Dialog-Frame :height
     2357       .
     2358       run diasize_set-height in this-procedure
     2359         (input  v-diasize-orig-frame-height
     2360         ,input  true
     2361         ) .
     2362       run diasize_set-width in this-procedure
     2363         (input  v-diasize-orig-frame-width
     2364         ,input  true
     2365         ) .
     2366     end.
     2367   end procedure.
     2368   procedure diasize_restore-current-size :
     2369     do
     2370     on error undo, return error return-value
     2371     :
     2372       run diasize_set-height in this-procedure
     2373         (input  v-diasize-current-frame-height
     2374         ,input  true
     2375         ) .
     2376       run diasize_set-width in this-procedure
     2377         (input  v-diasize-current-frame-width
     2378         ,input  true
     2379         ) .
     2380     end.
     2381   end procedure.
     2382   procedure diasize_set-browse-handle :
     2383     define input  parameter p-browse-handle as handle   no-undo .
     2384     define buffer buf_temp-browse-handle for temp-browse-handle .
     2385     do
     2386     on error undo, return error return-value
     2387     :
     2388       assign
     2389         v-diasize-browse-handle = p-browse-handle
     2390       .
     2391       for each buf_temp-browse-handle
     2392       on error undo, return error return-value
     2393       :
     2394         delete buf_temp-browse-handle .
     2395       end.
     2396     end.
     2397   end procedure.
     2398   procedure diasize_add_browse :
     2399     define input  parameter p-browse-type   as character no-undo .
     2400     define input  parameter p-browse-handle as handle    no-undo .
     2401     define buffer buf_temp-browse-handle for temp-browse-handle .
     2402     do
     2403     on error undo, return error return-value
     2404     :
     2405       assign
     2406         v-diasize-browse-number = v-diasize-browse-number + 1
     2407       .
     2408       create buf_temp-browse-handle .
     2409       assign
     2410         buf_temp-browse-handle.browse-type   = p-browse-type
     2411         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2412         buf_temp-browse-handle.browse-handle = p-browse-handle
     2413       .
     2414     end.
     2415   end procedure.
     2416   procedure diasize_init :
     2417     define variable v-default-value    as logical   no-undo .
     2418     define variable v-restore-saved    as logical   no-undo .
     2419     define variable v-resize-value-str as character no-undo .
     2420     do
     2421     on error undo, return error return-value
     2422     :
     2423       do with frame Dialog-Frame
     2424       :
     2425         assign
     2426           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2427           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2428           v-diasize-browse-handle     = browse br-cstaff :handle
     2429         .
     2430         create button v-diasize-resize-button
     2431         assign
     2432           parent        = frame Dialog-Frame :first-child
     2433           label         = "s"
     2434           height-pixels = 16
     2435           width-pixels  = 16
     2436           visible       = true
     2437           sensitive     = true
     2438           movable       = true
     2439           triggers:
     2440             on end-move persistent run diasize_end-move in this-procedure .
     2441           end triggers.
     2442         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2443         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2444         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2445         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2446         assign
     2447           v-diasize-wndmax = false
     2448         .
     2449         if connected("ub") = true
     2450         then do:
     2451           define variable v-cntxt-db-num        as integer   no-undo .
     2452           define variable v-cntxt-userid        as character no-undo .
     2453           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2454                                             , OUTPUT v-cntxt-userid
     2455                                             ) .
     2456           run gbl/wndpar_r.p
     2457             (input  v-cntxt-db-num
     2458             ,input  v-cntxt-userid
     2459             ,input  'wndmax':U
     2460             ,output v-diasize-wndmax
     2461             ,output v-default-value
     2462             ) .
     2463         end.
     2464         assign
     2465           v-diasize-wndstore = false
     2466         .
     2467         if connected("ub") = true
     2468         then do:
     2469           run gbl/wndpar_r.p
     2470             (input  v-cntxt-db-num
     2471             ,input  v-cntxt-userid
     2472             ,input  'wndstore':U
     2473             ,output v-diasize-wndstore
     2474             ,output v-default-value
     2475             ) .
     2476         end.
     2477         assign
     2478           v-diasize-proc-name = entry(1, program-name(2), '.')
     2479         .
     2480         if v-diasize-wndstore = true
     2481         then do:
     2482           assign
     2483             v-restore-saved = false
     2484           .
     2485           if connected("ub") = true
     2486           then do:
     2487             run gbl/wndsizer.p
     2488               (input  v-cntxt-db-num
     2489               ,input  v-cntxt-userid
     2490               ,input  v-diasize-proc-name
     2491               ,input  'height':u
     2492               ,output v-resize-value-str
     2493               ) .
     2494             if v-resize-value-str <> '':U
     2495             then do:
     2496               run diasize_change-height in this-procedure
     2497                 (input  integer(v-resize-value-str)
     2498                 ,input  true
     2499                 ) .
     2500               assign
     2501                 v-restore-saved = true
     2502               .
     2503             end.
     2504           end.
     2505           if connected("ub") = true
     2506           then do:
     2507             run gbl/wndsizer.p
     2508               (input  v-cntxt-db-num
     2509               ,input  v-cntxt-userid
     2510               ,input  v-diasize-proc-name
     2511               ,input  'width':u
     2512               ,output v-resize-value-str
     2513               ) .
     2514             if v-resize-value-str <> '':U
     2515             then do:
     2516               run diasize_change-width in this-procedure
     2517                 (input  integer(v-resize-value-str)
     2518                 ,input  true
     2519                 ) .
     2520               assign
     2521                 v-restore-saved = true
     2522               .
     2523             end.
     2524           end.
     2525           if v-restore-saved <> true
     2526           then do:
     2527             if v-diasize-wndmax = true
     2528             then do:
     2529               run diasize_maximize in this-procedure
     2530                 (input  true
     2531                 ) .
     2532             end.
     2533           end.
     2534         end.
     2535         else do:
     2536           if v-diasize-wndmax = true
     2537           then do:
     2538             run diasize_maximize in this-procedure
     2539               (input  true
     2540               ) .
     2541           end.
     2542         end.
     2543       end.
     2544     end.
     2545   end procedure.
     2546   procedure diasize_need-full-display :
     2547     define output parameter p-need-full-display as logical   no-undo .
     2548     do
     2549     on error undo, return error return-value
     2550     :
     2551       assign
     2552         p-need-full-display = v-diasize-need-full-display
     2553       .
     2554       assign
     2555         v-diasize-need-full-display = false
     2556       .
     2557     end.
     2558   end procedure.
     2559   procedure get-context :
     2560      define output parameter p-db-num as integer          no-undo.
     2561      define output parameter p-user-id as character        no-undo.
     2562      define variable v-login               as character    no-undo.
     2563      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2564      define buffer buf_user-login  for ub.user-login .
     2565      do
     2566      on error undo, return error
     2567      :
     2568            FIND FIRST buf_sys-ctrl no-lock.
     2569            ASSIGN
     2570               v-login = USERID("ub")
     2571               p-db-num = buf_sys-ctrl.db-num
     2572            .
     2573            FIND FIRST buf_user-login
     2574                 WHERE buf_user-login.db-num = p-db-num
     2575                   AND buf_user-login.user-login = v-login
     2576                 no-lock
     2577                 no-error
     2578                 .
     2579            IF AVAILABLE buf_user-login
     2580            THEN DO:
     2581               assign
     2582                  p-user-id = buf_user-login.user-id
     2583               .
     2584            END.
     2585      end.
     2586   end procedure.
     2587   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2588   on f5 of frame Dialog-Frame anywhere
     2589   do:
     2590     v-doc-rec = recid(X_c-staff). run OpenBr in this-procedure. reposition br-cstaff to recid v-doc-rec no-error. v-doc-rec = ?.              apply 'value-changed' to br-cstaff.
     2591       apply "VALUE-CHANGED" to BR-changes.
     2592   end.
     2593   def var sort-labelbr-cstaff   as character no-undo .
     2594   def var sort-clmnbr-cstaff    as handle    no-undo .
     2595   def var cur-clmnbr-cstaff     as handle    no-undo .
     2596   def var cur-clmn-locbr-cstaff as integer   no-undo .
     2597   def var re-querybr-cstaff     as logical   initial no no-undo .
     2598   on start-search, ctrl-o of br-cstaff in frame Dialog-Frame do:
     2599      run sort-brbr-cstaff
     2600        (input (if available temp-changes
     2601                then recid(temp-changes)
     2602                else ?
     2603               )
     2604        ).
     2605   end.
     2606   PROCEDURE sort-brbr-cstaff :
     2607     define input parameter p-recid as recid no-undo .
     2608     if re-querybr-cstaff = no then do:
     2609       assign
     2610          cur-clmnbr-cstaff = br-cstaff:current-column in frame Dialog-Frame
     2611       .
     2612       if sort-clmnbr-cstaff <> ? then sort-clmnbr-cstaff:column-fgcolor = 0.
     2613       if cur-clmnbr-cstaff = sort-clmnbr-cstaff then do:
     2614         assign
     2615            sort-labelbr-cstaff = ""
     2616            sort-clmnbr-cstaff = ?
     2617         .
     2618        end.
     2619        else do:
     2620          assign
     2621            sort-labelbr-cstaff = cur-clmnbr-cstaff:label
     2622            sort-clmnbr-cstaff  = cur-clmnbr-cstaff
     2623            sort-clmnbr-cstaff:column-fgcolor = 4
     2624          .
     2625        end.
     2626      end.
     2627     assign
     2628       cur-clmn-locbr-cstaff = 1
     2629     .
     2630     def var column-handle as handle no-undo .
     2631     column-handle = br-cstaff:first-column.
     2632     do while valid-handle(column-handle) :
     2633       if column-handle = cur-clmnbr-cstaff then do:
     2634         leave .
     2635       end.
     2636       column-handle = column-handle:NEXT-COLUMN.
     2637       assign
     2638         cur-clmn-locbr-cstaff = cur-clmn-locbr-cstaff + 1
     2639       .
     2640     end.
     2641     case sort-labelbr-cstaff:
     2642           when X_c-staff.corr-date:label in browse br-cstaff then DO:   assign     sort-column-name = "X_c-staff.corr-date"   .   run OpenBr.   . END.
     2643       otherwise do:
     2644         assign
     2645           sort-column-name = ""
     2646         .
     2647         run OpenBr.
     2648           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-cstaff') then do:
     2649             run mv-brw-defaultbr-cstaff.
     2650           end.
     2651         if sort-labelbr-cstaff <> "" then do:
     2652           assign
     2653             cur-clmnbr-cstaff:column-fgcolor = 0
     2654           .
     2655         end.
     2656         assign
     2657           cur-clmn-locbr-cstaff = ?
     2658         .
     2659       end.
     2660     end case.
     2661       if cur-clmn-locbr-cstaff <> ? then do:
     2662         if can-do( this-procedure:internal-entries, 'ch-clmnbr-cstaff') then do:
     2663           run ch-clmnbr-cstaff in this-procedure (cur-clmn-locbr-cstaff).
     2664         end.
     2665       end.
     2666     if p-recid <> ? then do:
     2667       reposition br-cstaff to recid p-recid no-error.
     2668       apply "value-changed" to br-cstaff in frame Dialog-Frame.
     2669     end.
     2670     apply "entry" to br-cstaff in frame Dialog-Frame.
     2671   END PROCEDURE.
     2672   procedure re-open-query-srt-clmnbr-cstaff:
     2673   if cur-clmnbr-cstaff = ? then do:
     2674      run OpenBr.
     2675   end.
     2676   else do:
     2677      assign re-querybr-cstaff = yes.
     2678      run sort-brbr-cstaff
     2679        (input (if available temp-changes
     2680                then recid(temp-changes)
     2681                else ?
     2682               )
     2683        ).
     2684      assign re-querybr-cstaff = no.
     2685   end.
     2686   end.
     2687   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2688   do:
     2689     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2690   end.
     2691   MAIN-BLOCK:
     2692   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2693      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2694    if p-mode = "one":U then do:
     2695     find first X_staff no-lock where
     2696                   X_staff.role = p-role no-error.
     2697       if not available X_staff then do:
     2698           message
     2699           vss-workfile vss-revision vss-description skip
     2700           "Неверное значение параметра вызова p-role"
     2701           p-role
     2702           view-as alert-box ERROR.
     2703           return.
     2704       end.
     2705     end.
     2706     v-rid-list = p-rid-list.
     2707   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2708   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2709     (output v-db-num
     2710     )  .
     2711     RUN MyEnable.
     2712     RUn OpenBR.
     2713     HIDE mark-num in frame Dialog-Frame .
     2714     if v-doc-rec <> ? then
     2715     REPOSITION br-cstaff to recid v-doc-rec No-ERROR.
     2716   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2717   DEF VAR cur-clmn-numbr-cstaff as INT EXTENT 6 no-undo.
     2718   DEF VAR varmvibr-cstaff       as INT no-undo.
     2719   DEF VAR varmvjbr-cstaff       as INT no-undo.
     2720   DEF VAR varmvkbr-cstaff       as INT no-undo.
     2721   DEF VAR varmvlbr-cstaff       as INT no-undo.
     2722   DEF VAR move-elementbr-cstaff as INT no-undo.
     2723   def var jjbr-cstaff           as int no-undo.
     2724   do varmvibr-cstaff = 1 to EXTENT(cur-clmn-numbr-cstaff):
     2725     ASSIGN cur-clmn-numbr-cstaff[varmvibr-cstaff] = varmvibr-cstaff.
     2726   END.
     2727   RUN start-mv-clmnbr-cstaff.
     2728   PROCEDURE start-mv-clmnbr-cstaff:
     2729   def var old-session as logical no-undo.
     2730      old-session = SESSION:IMMEDIATE-DISPLAY.
     2731      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2732          IF  p-mode = 'one'  THEN DO:
     2733      DO jjbr-cstaff = NUM-ENTRIES('1,2,3,4,5,6') TO 1 BY -1:
     2734        RUN re-move-clmnbr-cstaff ( cur-clmn-numbr-cstaff[INTEGER(ENTRY (jjbr-cstaff, '1,2,3,4,5,6'))] , 1).
     2735      END.
     2736          END.
     2737      SESSION:IMMEDIATE-DISPLAY = old-session.
     2738   END.
     2739   ON ctrl-cursor-right OF BROWSE br-cstaff do:
     2740     RUN re-move-clmnbr-cstaff ( 1, 6).
     2741   END.
     2742   ON ctrl-cursor-left OF BROWSE br-cstaff do:
     2743     RUN re-move-clmnbr-cstaff (6, 1).
     2744   END.
     2745   PROCEDURE re-move-clmnbr-cstaff:
     2746     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2747     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2748     DO varmvibr-cstaff = 1 TO EXTENT(cur-clmn-numbr-cstaff):
     2749       if cur-clmn-numbr-cstaff[varmvibr-cstaff] = source-column THEN cur-clmn-numbr-cstaff[varmvibr-cstaff] = -1.
     2750     END.
     2751     if br-cstaff:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2752     if source-column > target-column THEN
     2753     DO varmvjbr-cstaff = source-column - 1 to target-column BY -1:
     2754       DO varmvibr-cstaff = 1 TO EXTENT(cur-clmn-numbr-cstaff):
     2755           if cur-clmn-numbr-cstaff[varmvibr-cstaff] = varmvjbr-cstaff THEN DO:
     2756             cur-clmn-numbr-cstaff[varmvibr-cstaff] = cur-clmn-numbr-cstaff[varmvibr-cstaff] + 1.
     2757           END.
     2758       END.
     2759     END.
     2760     ELSE
     2761     DO varmvjbr-cstaff = source-column + 1 to target-column:
     2762       DO varmvibr-cstaff = 1 TO EXTENT(cur-clmn-numbr-cstaff):
     2763         if cur-clmn-numbr-cstaff[varmvibr-cstaff] = varmvjbr-cstaff THEN DO:
     2764           cur-clmn-numbr-cstaff[varmvibr-cstaff] = cur-clmn-numbr-cstaff[varmvibr-cstaff] - 1.
     2765         END.
     2766       END.
     2767     END.
     2768     DO varmvibr-cstaff = 1 TO EXTENT(cur-clmn-numbr-cstaff):
     2769       if cur-clmn-numbr-cstaff[varmvibr-cstaff] = -1 THEN cur-clmn-numbr-cstaff[varmvibr-cstaff] = target-column.
     2770     END.
     2771   END PROCEDURE.
     2772   PROCEDURE ch-clmnbr-cstaff:
     2773     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2774     if cur-clmn-loc <= 1 then do:
     2775       return .
     2776     end.
     2777     DO varmvibr-cstaff = 1 TO EXTENT(cur-clmn-numbr-cstaff):
     2778       if cur-clmn-numbr-cstaff[varmvibr-cstaff] = cur-clmn-loc THEN move-elementbr-cstaff = varmvibr-cstaff.
     2779     END.
     2780     RUN re-move-clmnbr-cstaff (cur-clmn-loc, 1).
     2781   END PROCEDURE.
     2782   PROCEDURE mv-brw-defaultbr-cstaff:
     2783   def var old-session as logical no-undo.
     2784     old-session = SESSION:IMMEDIATE-DISPLAY.
     2785     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2786     do varmvlbr-cstaff = 1 to EXTENT(cur-clmn-numbr-cstaff):
     2787       RUN re-move-clmnbr-cstaff (cur-clmn-numbr-cstaff[varmvlbr-cstaff], varmvlbr-cstaff).
     2788     END.
     2789     RUN start-mv-clmnbr-cstaff.
     2790     SESSION:IMMEDIATE-DISPLAY = old-session.
     2791   END PROCEDURE.
     2792   .
     2793     run diasize_add_browse in this-procedure
     2794       (input  'width':u
     2795       ,input  browse br-changes :handle
     2796       ) .
     2797     run diasize_init in this-procedure .
     2798   WAIT-FOR GO OF FRAME Dialog-Frame.
     2799   END.
     2800   RUN disable_UI.
     2801   PROCEDURE disable_UI :
     2802     HIDE FRAME Dialog-Frame.
     2803   END PROCEDURE.
     2804   PROCEDURE enable_UI :
     2805     DISPLAY mark-num
     2806         WITH FRAME Dialog-Frame.
     2807     ENABLE b-quit B-mark B-sel B-Help br-cstaff BR-changes mark-num
     2808         WITH FRAME Dialog-Frame.
     2809     VIEW FRAME Dialog-Frame.
     2810     OPEN QUERY br-cstaff FOR EACH X_c-staff NO-LOCK INDEXED-REPOSITION.
     2811   END PROCEDURE.
     2812   PROCEDURE MyEnable :
     2813   assign
     2814   temp-changes.l_name:resizable in browse br-changes = true
     2815   temp-changes.v_old:resizable in browse br-changes = true
     2816   temp-changes.v_new:resizable in browse br-changes = true
     2817   temp-changes.l_name:width in browse br-changes = 30
     2818   temp-changes.v_old:width in browse br-changes = 40
     2819   temp-changes.v_new:width in browse br-changes = 40
     2820   .
     2821   DISPLAY mark-num
     2822   WITH FRAME Dialog-Frame.
     2823   ENABLE
     2824   b-quit
     2825   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2826   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2827   B-Help
     2828   br-cstaff
     2829   mark-num
     2830   br-changes
     2831   with FRAME Dialog-Frame .
     2832   VIEW FRAME Dialog-Frame .
     2833   END PROCEDURE.
     2834   PROCEDURE OpenBr :
     2835   CASE p-mode:
     2836       WHEN 'one':U THEN DO:
     2837         assign
     2838         frame Dialog-Frame:title = substitute("&1 &2"
     2839                                                 , frame Dialog-Frame:title
     2840                                                 , gbclcode-get-position ( input p-role
     2841                                                                          ,input p-role-level
     2842                                                                          ,input p-work-place
     2843                                                                          ,input p-staff-code ))
     2844         .
     2845         OPEN QUERY br-cstaff
     2846         FOR EACH X_c-staff NO-LOCK where
     2847             X_c-staff.role = p-role
     2848         AND X_c-staff.role-level = p-role-level
     2849         AND X_c-staff.work-place = p-work-place
     2850         AND X_c-staff.staff-code = p-staff-code
     2851         AND X_c-staff.date-start = p-date-start INDEXED-REPOSITION.
     2852       END.
     2853   END CASE.
     2854   APPLY "VALUE-CHANGED" TO br-cstaff in frame Dialog-Frame.
     2855   APPLY "ENTRY" TO br-cstaff.
     2856   END PROCEDURE.
     2857   PROCEDURE proc-br-cstaff :
     2858   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2859   if b-sel:sensitive in frame Dialog-Frame then dO:
     2860       if b-mark:sensitive then do:
     2861           apply "choose" to b-mark in frame Dialog-Frame.
     2862       end.
     2863       else do:
     2864           apply "choose" to b-sel in frame Dialog-Frame.
     2865       end.
     2866   end.
     2867   else do:
     2868       if b-lookup:sensitive then
     2869       apply "choose" to b-lookup in frame Dialog-Frame.
     2870   end.
     2871   END PROCEDURE.
     2872   PROCEDURE proc-view-changes :
     2873   define buffer buf_c-cli-hist for ub.c-cli-hist.
     2874   define buffer next_c-staff for ub.c-staff.
     2875   for each temp-changes:
     2876       delete temp-changes.
     2877   END.
     2878   if not available X_c-staff then do:
     2879     Open QUery br-changes for each temp-changes.
     2880     return.
     2881   end.
     2882   find first buf_c-cli-hist no-lock where
     2883             buf_c-cli-hist.obj-type = 'чел':U
     2884         and buf_c-cli-hist.obj-code = X_c-staff.psn-code
     2885         and buf_c-cli-hist.corr-user-db-num = X_c-staff.corr-user-db-num
     2886         and buf_c-cli-hist.chip-num = X_c-staff.chip-num no-error .
     2887   if not available buf_c-cli-hist then do:
     2888     message
     2889     "Неверная ссылка на c-cli-hist в таблице c-staff"
     2890     view-as alert-box error.
     2891   end.
     2892   else do:
     2893     define variable v-label-param as character no-undo .
     2894     v-label-param =
     2895       "date-end" + chr(4) + "По" + chr(4) + ""  .
     2896     run proc-full-temp-changes in this-procedure (
     2897                                                  input buf_c-cli-hist.action = integer('1':U)
     2898                                                 ,input buf_c-cli-hist.action = integer('99':U)
     2899                                                 ,input  buffer X_c-staff:handle
     2900                                                 ,input  'staff':U
     2901                                                 ,input  "date-end"
     2902                                                 ,input  v-label-param).
     2903   end.
     2904   Open QUery br-changes for each temp-changes.
     2905   END PROCEDURE.
     2906   FUNCTION get-action RETURNS CHARACTER
     2907     ( INPUT p-action AS integer ) :
     2908     define variable dops as character no-undo.
     2909   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     2910   RETURN dops.
     2911   END FUNCTION.
     2912   FUNCTION get-action-from-c-cli RETURNS CHARACTER
     2913     ( INPUT p-psn-code AS INTEGER, INPUT p-corr-user-db-num AS INTEGER, INPUT p-chip-num AS INTEGER ) :
     2914   define buffer buf_c-cli-hist for ub.c-cli-hist.
     2915   find first buf_c-cli-hist no-lock where
     2916             buf_c-cli-hist.obj-type = 'чел':U
     2917         and buf_c-cli-hist.obj-code = p-psn-code
     2918         and buf_c-cli-hist.corr-user-db-num = p-corr-user-db-num
     2919         and buf_c-cli-hist.chip-num = p-chip-num no-error .
     2920   IF AVAILABLE buf_c-cli-hist  THEN DO:
     2921       RETURN get-action(buf_c-cli-hist.action).
     2922   END.
     2923   RETURN chr(63).
     2924   END FUNCTION.
