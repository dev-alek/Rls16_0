     1974           end.
     1975           assign
     1976             v-diasize-change-size = false
     1977           .
     1978           leave move_block .
     1979         end.
     1980       end.
     1981       assign
     1982         v-diasize-need-full-display = true
     1983       .
     1984       if v-diasize-change-size = false
     1985       then do:
     1986         assign
     1987           v-diasize-change-size = true
     1988         .
     1989       end.
     1990       else do:
     1991         return .
     1992       end.
     1993       assign
     1994         v-frame-width = frame Dialog-Frame :width
     1995         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1996         v-browse-width = v-diasize-browse-handle :width
     1997       .
     1998       for each buf_temp-browse-handle
     1999         where buf_temp-browse-handle.browse-type = 'width':u
     2000       :
     2001         assign
     2002           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2003         .
     2004       end.
     2005       for each buf_temp-diasize-handle
     2006       :
     2007         delete buf_temp-diasize-handle .
     2008       end.
     2009       assign
     2010         v-field-group-handle = frame Dialog-Frame :first-child
     2011       .
     2012       do while valid-handle(v-field-group-handle)
     2013       :
     2014         assign
     2015           v-object-handle = v-field-group-handle :first-child
     2016         .
     2017         do while valid-handle(v-object-handle)
     2018         :
     2019           if  v-object-handle <> v-diasize-browse-handle :handle
     2020           and v-object-handle <> v-diasize-resize-button
     2021           and can-query(v-object-handle, "row")
     2022           and can-query(v-object-handle, "height")
     2023           and ( v-object-handle :col + v-object-handle :width
     2024                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2025               )
     2026           then do:
     2027             find first buf_temp-browse-handle
     2028               where buf_temp-browse-handle.browse-type   = 'width':u
     2029                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2030               no-error .
     2031             if available buf_temp-browse-handle
     2032             then do:
     2033             end.
     2034             else do:
     2035               create buf_temp-diasize-handle .
     2036               assign
     2037                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2038                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2039               .
     2040             end.
     2041           end.
     2042           assign
     2043             v-object-handle = v-object-handle :next-sibling
     2044           .
     2045         end.
     2046         assign
     2047           v-field-group-handle = v-field-group-handle :next-sibling
     2048         .
     2049       end.
     2050       do with frame Dialog-Frame
     2051       :
     2052         hide v-diasize-resize-button .
     2053         v-diasize-resize-button :row = 1.
     2054         v-diasize-resize-button :column = 1.
     2055       end.
     2056       if p-change-value > 0
     2057       then do:
     2058         if frame Dialog-Frame :scrollable = true
     2059         then do:
     2060           assign
     2061             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2062             no-error .
     2063           if error-status :error
     2064           or error-status :get-message(1) <> ""
     2065           then do:
     2066             undo move_block, retry move_block.
     2067           end.
     2068         end.
     2069         assign
     2070           frame Dialog-Frame :width = v-frame-width + p-change-value
     2071           no-error .
     2072         if error-status :error
     2073         or error-status :get-message(1) <> ""
     2074         then do:
     2075           undo move_block, retry move_block.
     2076         end.
     2077         assign
     2078           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2079         no-error .
     2080         if error-status :error
     2081         or error-status :get-message(1) <> ""
     2082         then do:
     2083           undo move_block, retry move_block.
     2084         end.
     2085         for each buf_temp-browse-handle
     2086           where buf_temp-browse-handle.browse-type = 'width':u
     2087         on error undo move_block, retry move_block
     2088         :
     2089           assign
     2090             buf_temp-browse-handle.browse-handle :width
     2091               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2092             no-error .
     2093           if error-status :error
     2094           or error-status :get-message(1) <> ""
     2095           then do:
     2096             undo move_block, retry move_block .
     2097           end.
     2098         end.
     2099         for each buf_temp-diasize-handle
     2100         on error undo move_block, retry move_block
     2101         :
     2102           assign
     2103             v-object-handle = buf_temp-diasize-handle.handle-value
     2104           .
     2105           if v-object-handle <> v-diasize-resize-button
     2106           then do:
     2107             assign
     2108               v-object-handle :col = v-object-handle :col + p-change-value
     2109               no-error .
     2110             if error-status :error
     2111             or error-status :get-message(1) <> ""
     2112             then do:
     2113               undo move_block, retry move_block .
     2114             end.
     2115           end.
     2116         end.
     2117       end.
     2118       else do:
     2119         for each buf_temp-diasize-handle
     2120         on error undo move_block, retry move_block
     2121         :
     2122           assign
     2123             v-object-handle = buf_temp-diasize-handle.handle-value
     2124           .
     2125           if v-object-handle <> v-diasize-resize-button
     2126           then do:
     2127             assign
     2128               v-object-handle :col = v-object-handle :col + p-change-value
     2129               no-error .
     2130             if error-status :error
     2131             or error-status :get-message(1) <> ""
     2132             then do:
     2133               undo move_block, retry move_block .
     2134             end.
     2135           end.
     2136         end.
     2137         for each buf_temp-browse-handle
     2138           where buf_temp-browse-handle.browse-type = 'width':u
     2139         on error undo move_block, retry move_block
     2140         :
     2141           assign
     2142             buf_temp-browse-handle.browse-handle :width
     2143               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2144             no-error .
     2145           if error-status :error
     2146           or error-status :get-message(1) <> ""
     2147           then do:
     2148             undo move_block, retry move_block .
