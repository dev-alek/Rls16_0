        1   block-level on error undo, throw.
        2   define input-output parameter par-rid as recid no-undo .
        3   define input parameter par-mode as character no-undo .
        4   define input parameter p-silent as logical   no-undo .
        5   define input parameter partax-code like ub.tax-rate-value.tax-code no-undo .
        6   define input parameter parrate-code like ub.tax-rate-value.rate-code no-undo .
        7   define input parameter parrate-value like ub.tax-rate-value.rate-value no-undo .
        8   define input parameter parfact-date like ub.tax-rate-value.fact-date no-undo .
        9   define input parameter parhost-code like ub.tax-rate-value.host-code no-undo .
       10   define input parameter parobj-type like ub.tax-rate-value.obj-type no-undo .
       11   define input parameter parobj-code like ub.tax-rate-value.obj-code no-undo .
       12   define input parameter parstatus  like ub.tax-rate-value.status_ no-undo .
       13   def var vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       14   def var vss-author      as character no-undo init "$Author: expertek $":U .
       15   def var vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       16   def var vss-workfile    as character no-undo init "$Workfile: taxvali1.p $":U .
       17   def var vss-archive     as character no-undo init "$Archive: ref/taxvali1.p $":U .
       18   def var vss-description as character no-undo init "Сохранение изменений в карточке значений ставки налога".
       19   procedure vss-get-info :
       20     define output parameter p-vss-revision    like vss-revision    no-undo .
       21     define output parameter p-vss-author      like vss-author      no-undo .
       22     define output parameter p-vss-date        like vss-date        no-undo .
       23     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       24     define output parameter p-vss-archive     like vss-archive     no-undo .
       25     define output parameter p-vss-description like vss-description no-undo .
       26     assign
       27       p-vss-revision    = vss-revision
       28       p-vss-author      = vss-author
       29       p-vss-date        = vss-date
       30       p-vss-workfile    = vss-workfile
       31       p-vss-archive     = vss-archive
       32       p-vss-description = vss-description
       33     .
       34   end procedure.
       35   procedure vss-get-parameters :
       36     define output parameter p-vss-parameters as character no-undo .
       37   end procedure.
       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   define   shared variable g#auto as logical no-undo.
       80   define   shared variable g#news as logical no-undo.
       81   define   shared variable g#oxml as logical no-undo.
       82   define   shared variable g#esys as logical no-undo.
       83   define   shared variable g#news-source-db as integer no-undo.
       84   define   shared variable g#esys-source-esys as integer no-undo.
       85   define   shared variable g#db-num as integer   no-undo .
       86   define   shared variable g#userid as character no-undo .
       87   define   shared variable g#passwd as character no-undo .
       88   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   procedure factord :
       90     define input  parameter p-fact-date            as date    no-undo .
       91     define input  parameter p-fact-time            as integer no-undo .
       92     define input  parameter p-fact-num             as integer no-undo .
       93     define input  parameter p-shift-date           as date    no-undo .
       94     define input  parameter p-shift-num            as integer no-undo .
       95     define input  parameter p-shift-on             as logical no-undo .
       96     define output parameter p-fact-order           as decimal no-undo .
       97     define output parameter p-shift-end-fact-order as decimal no-undo .
       98     define output parameter p-day-end-fact-order   as decimal no-undo .
       99     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      100     if p-fact-date = ?
      101     then do:
      102       return error "Не указана фактическая дата" .
      103     end.
      104     define variable v-fact-date-num as integer no-undo .
      105     assign
      106       v-fact-date-num = integer(p-fact-date)
      107     .
      108     if p-fact-num = ?
      109     or p-fact-num = 0
      110     then do:
      111       return error "Не задан p-fact-num " + string(p-fact-num) .
      112     end.
      113     if p-fact-num < 0
      114     then do:
      115       return error "Отрицательный fact-num " + string(p-fact-num) .
      116     end.
      117     if p-fact-num >= 100000000
      118     then do:
      119       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      120     end.
      121     if p-shift-on = true
      122     then do:
      123       if p-shift-date = ?
      124       then do:
      125         return error "Не задана дата смены" .
      126       end.
      127       if p-shift-num = ?
      128       or p-shift-num = 0
      129       then do:
      130         return error "Не задан номер смены" .
      131       end.
      132     end.
      133     else do:
      134       assign
      135         p-shift-date = p-fact-date
      136         p-shift-num  = 24
      137       .
      138     end.
      139     define variable v-shift-offset as integer no-undo .
      140     if p-shift-date = p-fact-date
      141     then do:
      142       assign
      143         v-shift-offset = 1
      144       .
      145     end.
      146     if p-shift-date < p-fact-date
      147     then do:
      148       assign
      149         v-shift-offset = 0
      150       .
      151     end.
      152     if p-shift-date > p-fact-date
      153     then do:
      154       message
      155         vss-workfile vss-revision vss-description skip
      156         "Неправильная дата закрытия смены" skip
      157         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      158         view-as alert-box error .
      159       undo, return error
      160         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      161           ,string(p-fact-date, '99/99/9999':U)
      162           ,string(p-shift-date, '99/99/9999':U)
      163           )
      164       .
      165     end.
      166     if p-shift-num < 1
      167     or p-shift-num > 24
      168     then do:
      169       message
      170         vss-workfile vss-revision vss-description skip
      171         "Неправильный номер смены" skip
      172         "p-shift-num" p-shift-num skip
      173         view-as alert-box error .
      174       undo, return error return-value .
      175     end.
      176     assign
      177       p-fact-order           = v-fact-date-num
      178                              + v-shift-offset * 0.5
      179                              + p-shift-num    * 0.02 - 0.01
      180                              + p-fact-num     * 0.0000000001
      181       p-shift-end-fact-order = v-fact-date-num
      182                              + v-shift-offset * 0.5
      183                              + p-shift-num    * 0.02
      184       p-day-end-fact-order   = v-fact-date-num
      185                              + 0.99
      186     .
      187     if p-fact-order           <= v-fact-date-num
      188     or p-shift-end-fact-order <= v-fact-date-num
      189     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      190     or p-shift-end-fact-order >= p-day-end-fact-order
      191     then do:
      192       message
      193         vss-workfile vss-revision vss-description skip
      194         "Внутренняя ошибка при генерации фактического номера" skip
      195         "p-fact-date"            p-fact-date            skip
      196         "p-fact-time"            p-fact-time            skip
      197         "p-fact-num"             p-fact-num             skip
      198         "p-shift-date"           p-shift-date           skip
      199         "p-shift-num"            p-shift-num            skip
      200         "p-shift-on"             p-shift-on             skip
      201         "p-shift-end-fact-order" p-shift-end-fact-order skip
      202         "p-day-end-fact-order"   p-day-end-fact-order   skip
      203         "v-fact-date-num"        v-fact-date-num        skip
      204         view-as alert-box error .
      205       undo, return error return-value .
      206     end.
      207   end procedure.
      208   procedure day-begin-fact-order :
      209     define input  parameter p-fact-date            as date    no-undo .
      210     define output parameter p-day-begin-fact-order as decimal no-undo .
      211     do
      212     on error undo, return error return-value
      213     :
      214       if p-fact-date = ?
      215       then do:
      216         assign
      217           p-day-begin-fact-order = 0
      218         .
      219       end.
      220       else do:
      221         assign
      222           p-day-begin-fact-order = integer(p-fact-date)
      223         .
      224       end.
      225     end.
      226   end procedure.
      227   procedure factord-max-fact-order :
      228     define output parameter p-max-fact-order as decimal   no-undo .
      229     do
      230     on error undo, return error return-value
      231     :
      232       run day-begin-fact-order in this-procedure
      233         (input  date(1, 1, 5000)
      234         ,output p-max-fact-order
      235         ) .
      236     end.
      237   end procedure.
      238   procedure factord-cut-archive :
      239     define input  parameter p-obj-type             as character no-undo .
      240     define input  parameter p-obj-code             as integer   no-undo .
      241     define input  parameter p-fact-date            as date      no-undo .
      242     define output parameter p-shift-on             as logical   no-undo .
      243     define output parameter p-shift-date           as date      no-undo .
      244     define output parameter p-shift-num            as integer   no-undo .
      245     define output parameter p-day-end-fact-order   as decimal   no-undo .
      246     define output parameter p-shift-end-fact-order as decimal   no-undo .
      247     define variable v-fact-order as decimal   no-undo .
      248     define buffer buf_shift-obj for ub.shift-obj .
      249     do
      250     on error undo, return error return-value
      251     :
      252   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      253   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      254     (input  p-obj-type
      255     ,input  p-obj-code
      256     ,input  'shift-on=request'
      257     ,output p-shift-on
      258     ) no-error .
      259       if error-status :error
      260       then do:
      261         message
      262           vss-workfile vss-revision vss-description skip
      263           "Ошибка при определении атрибута объекта" skip
      264           "Объект" p-obj-type p-obj-code skip
      265           error-status :get-message(1) skip
      266           return-value skip
      267           view-as alert-box error .
      268         undo, return error return-value .
      269       end.
      270       if p-shift-on = false
      271       then do:
      272         assign
      273           p-shift-date               = ?
      274           p-shift-num                = 0
      275         .
      276       end.
      277       else do:
      278         find first buf_shift-obj share-lock
      279           where buf_shift-obj.obj-type   = p-obj-type
      280             and buf_shift-obj.obj-code   = p-obj-code
      281             and buf_shift-obj.shift-date > p-fact-date
      282           use-index pi
      283           no-error .
      284         if not available buf_shift-obj
      285         or buf_shift-obj.status_ <> 'зкр':U
      286         then do:
      287           message
      288             vss-workfile vss-revision vss-description skip
      289             "Невозможно вычислить последнюю смену" skip
      290             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      291             "Объект" p-obj-type p-obj-code skip
      292             "Дата" p-fact-date skip
      293             view-as alert-box error .
      294           undo, return error return-value .
      295         end.
      296         find last buf_shift-obj share-lock
      297           where buf_shift-obj.obj-type = p-obj-type
      298             and buf_shift-obj.obj-code = p-obj-code
      299             and buf_shift-obj.shift-date <= p-fact-date
      300           use-index pi
      301           no-error .
      302         if available buf_shift-obj
      303         then do:
      304           if  buf_shift-obj.status_ = 'зкр':U
      305           then do:
      306             assign
      307               p-shift-date = buf_shift-obj.shift-date
      308               p-shift-num  = buf_shift-obj.shift-num
      309             .
      310           end.
      311           else do:
      312             message
      313               vss-workfile vss-revision vss-description skip
      314               "Невозможно вычислить последнюю смену" skip
      315               "Статус смены отличен от статуса" 'зкр':U skip
      316               "Объект" p-obj-type p-obj-code skip
      317               "Дата" p-fact-date skip
      318               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      319               view-as alert-box error .
      320             undo, return error return-value .
      321           end.
      322         end.
      323         else do:
      324           assign
      325             p-shift-date = p-fact-date - 1
      326             p-shift-num  = 1
      327           .
      328         end.
      329       end.
      330       run factord in this-procedure
      331         (input  p-fact-date
      332         ,input  1
      333         ,input  1
      334         ,input  p-shift-date
      335         ,input  p-shift-num
      336         ,input  p-shift-on
      337         ,output v-fact-order
      338         ,output p-shift-end-fact-order
      339         ,output p-day-end-fact-order
      340         ) no-error .
      341       if error-status :error
      342       then do:
      343         message
      344           vss-workfile vss-revision vss-description skip
      345           "Ошибка при вызове процедуры factord"
      346           error-status :get-message(1) skip
      347           return-value skip
      348           view-as alert-box error .
      349         undo, return error return-value .
      350       end.
      351     end.
      352   end procedure.
      353   procedure factord-lock-shift :
      354     define input  parameter p-obj-type  as character no-undo .
      355     define input  parameter p-obj-code  as integer   no-undo .
      356     define input  parameter p-fact-date as date      no-undo .
      357     define parameter buffer buf_shift-obj for ub.shift-obj .
      358     define variable v-shift-on      as logical   no-undo .
      359     define variable v-extra-message as character no-undo .
      360     define variable v-error as character no-undo .
      361     do
      362     on error undo, return error return-value
      363     :
      364   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      365   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      366     (input  p-obj-type
      367     ,input  p-obj-code
      368     ,input  'shift-on=request'
      369     ,output v-shift-on
      370     ) no-error .
      371       if error-status :error
      372       then do:
      373         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      374         undo, return error v-error .
      375       end.
      376       if v-shift-on = true
      377       then do:
      378         find first buf_shift-obj share-lock
      379           where buf_shift-obj.obj-type   = p-obj-type
      380             and buf_shift-obj.obj-code   = p-obj-code
      381             and buf_shift-obj.shift-date > p-fact-date
      382           use-index pi
      383           no-error .
      384         if not available buf_shift-obj
      385         or buf_shift-obj.status_ <> 'зкр':U
      386         then do:
      387           find last buf_shift-obj
      388             where buf_shift-obj.obj-type = p-obj-type
      389               and buf_shift-obj.obj-code = p-obj-code
      390               and buf_shift-obj.status_  = 'зкр':U
      391             use-index stts
      392             no-error .
      393           if available buf_shift-obj
      394           then do:
      395             assign
      396               v-extra-message =
      397                     substitute("Дата начала последеней закрытой смены на объекте &1"
      398                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      399                               )
      400             .
      401           end.
      402           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      403           undo, return error v-error .
      404         end.
      405       end.
      406     end.
      407   end procedure.
      408   procedure factord-end-day :
      409     define input  parameter p-fact-date            as date    no-undo .
      410     define output parameter p-day-end-fact-order   as decimal no-undo .
      411     do
      412     on error undo, return error return-value
      413     :
      414       if p-fact-date = ?
      415       then do:
      416         return error "Не указана фактическая дата" .
      417       end.
      418       assign
      419         p-day-end-fact-order = integer(p-fact-date) + 0.99
      420       .
      421     end.
      422   end procedure.
      423   procedure factord-to-date :
      424     define input  parameter p-fact-order as decimal no-undo .
      425     define output parameter p-fact-date  as date    no-undo .
      426     define variable v-ref-date  as date      no-undo .
      427     define variable v-ref-delta as integer   no-undo .
      428     do
      429     on error undo, return error return-value
      430     :
      431       if p-fact-order = ?
      432       or p-fact-order = 0
      433       then do:
      434         return error "Не указан fact-order" .
      435       end.
      436       assign
      437         v-ref-date  = date(1, 1, 2000)
      438       .
      439       assign
      440         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      441       .
      442       assign
      443         p-fact-date = v-ref-date + v-ref-delta
      444       .
      445     end.
      446   end procedure.
      447   procedure factord-to-fact-num :
      448     define input  parameter p-fact-order as decimal no-undo .
      449     define output parameter p-fact-num   as integer no-undo .
      450     define variable v-fact-order-trunc as decimal no-undo .
      451     do
      452     on error undo, return error return-value
      453     :
      454       if p-fact-order = ?
      455       or p-fact-order = 0
      456       then do:
      457         return error "Не указан fact-order" .
      458       end.
      459       assign
      460        v-fact-order-trunc = truncate(p-fact-order, 2)
      461       .
      462       assign
      463         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      464       .
      465     end.
      466   end procedure.
      467   procedure factord-to-shift-num :
      468     define input  parameter p-fact-order as decimal no-undo .
      469     define output parameter p-shift-num   as integer no-undo .
      470     define variable  p-shift-numd  as decimal   no-undo .
      471     define variable v-fact-order-trunc as decimal no-undo .
      472     do
      473     on error undo, return error return-value
      474     :
      475       if p-fact-order = ?
      476       or p-fact-order = 0
      477       then do:
      478         return error "Не указан fact-order" .
      479       end.
      480       assign
      481        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      482       .
      483       if v-fact-order-trunc < 0.5 then do:
      484         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      485       end.
      486       assign
      487         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      488         .
      489        assign
      490         p-shift-num = truncate (p-shift-numd , 0)
      491       .
      492     end.
      493   end procedure.
      494   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      495   procedure cur-time :
      496      define output parameter p-today as date      no-undo .
      497      define output parameter p-time  as integer   no-undo .
      498     do
      499     on error undo, return error
      500     :
      501       define variable v-date1 as date      no-undo .
      502       define variable v-date2 as date      no-undo .
      503       define variable v-time  as integer   no-undo .
      504       assign
      505         v-date1 = today
      506         v-time  = time
      507         v-date2 = today
      508       .
      509       if v-date1 <> v-date2
      510       then do:
      511         assign
      512           v-date1 = today
      513           v-time  = v-time
      514         .
      515       end.
      516       assign
      517         p-today = v-date1
      518         p-time  = v-time
      519       .
      520     end.
      521   end.
      522   function cur-time-date returns character
      523   :
      524     return string(today, '99/99/9999':U) .
      525   end.
      526   function cur-time-mjd returns decimal
      527   :
      528     define variable v-date as date      no-undo .
      529     define variable v-time as integer   no-undo .
      530     run cur-time in this-procedure
      531       (output v-date
      532       ,output v-time
      533       ) .
      534     return integer(v-date) - 2400002 + (v-time / 86400) .
      535   end.
      536   function cur-time-get-ending-index returns integer
      537   (input p-number as integer
      538   )
      539   :
      540     if p-number < 0
      541     or p-number = ?
      542     then do:
      543       return 1 .
      544     end.
      545     define variable v-rest as integer   no-undo .
      546     assign
      547       p-number = p-number modulo 100
      548     .
      549     if p-number < 20
      550     then do:
      551       assign
      552         v-rest = p-number
      553       .
      554     end.
      555     else do:
      556       assign
      557         v-rest = p-number modulo 10
      558       .
      559     end.
      560     case v-rest :
      561       when 1
      562       then do:
      563         return 2 .
      564       end.
      565       when 2 or
      566       when 3 or
      567       when 4
      568       then do:
      569         return 3 .
      570       end.
      571       otherwise do:
      572         return 1 .
      573       end.
      574     end case .
      575   end.
      576   procedure cur-time-mjd-to-date :
      577      define input  parameter i-mjd-diff as decimal no-undo.
      578      define output parameter o-Date     as date    no-undo.
      579      define output parameter o-Time     as integer no-undo.
      580      define variable v-day-number as integer   no-undo .
      581      if    i-mjd-diff < 0
      582         or i-mjd-diff = ?
      583      then do:
      584         return "?" .
      585      end.
      586      assign
      587         v-day-number = truncate(i-mjd-diff,0).
      588         o-Date = date(v-day-number + 2400002).
      589         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      590     .
      591   end.
      592   function cur-time-mjd-to-string returns character
      593   (input p-mjd-diff as decimal
      594   )
      595   :
      596     define variable v-day-number as integer   no-undo .
      597     define variable v-seconds    as integer   no-undo .
      598     define variable v-hour       as integer   no-undo .
      599     define variable v-min        as integer   no-undo .
      600     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      601     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      602     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      603     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      604     if p-mjd-diff < 0
      605     or p-mjd-diff = ?
      606     then do:
      607       return "?" .
      608     end.
      609     assign
      610       v-day-number = integer(truncate(p-mjd-diff,0))
      611       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      612     .
      613     if v-seconds > 86400
      614     then do:
      615       assign
      616         v-seconds = 86400 - 1
      617       .
      618     end.
      619     if v-seconds < 0
      620     then do:
      621       assign
      622         v-seconds = 0
      623       .
      624     end.
      625     assign
      626       v-hour = truncate(v-seconds / 3600, 0)
      627     .
      628     assign
      629       v-seconds = v-seconds modulo 3600
      630     .
      631     assign
      632       v-min = truncate(v-seconds / 60, 0)
      633     .
      634     assign
      635       v-seconds = v-seconds modulo 60
      636     .
      637     return
      638         (if v-day-number <> 0
      639           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      640           else ""
      641         )
      642       + (if v-day-number <> 0 or v-hour <> 0
      643           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      644           else ""
      645         )
      646       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      647           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      648           else ""
      649         )
      650       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      651       .
      652   end.
      653   function cur-time-string returns character
      654   :
      655     define variable v-date as date      no-undo .
      656     define variable v-time as integer   no-undo .
      657     run cur-time in this-procedure
      658       (output v-date
      659       ,output v-time
      660       ) .
      661     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      662   end.
      663   function cur-time-string-sec returns character
      664   :
      665     define variable v-date as date      no-undo .
      666     define variable v-time as integer   no-undo .
      667     run cur-time in this-procedure
      668       (output v-date
      669       ,output v-time
      670       ) .
      671     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      672   end.
      673   function cur-time-custom  returns character
      674   (input p-prefix as character
      675   ,input p-date-format as character
      676   ,input p-delimiter as character
      677   ,input p-time-format as character
      678   ,input p-suffix as character
      679   )
      680   :
      681     define variable v-date as date      no-undo .
      682     define variable v-time as integer   no-undo .
      683     run cur-time in this-procedure
      684       (output v-date
      685       ,output v-time
      686       ) .
      687     return
      688       p-prefix
      689       + string(v-date, p-date-format)
      690       + p-delimiter
      691       + string(v-time, p-time-format)
      692       + p-suffix
      693       .
      694   end.
      695   function cur-time-print  returns character
      696   :
      697     define variable v-date as date      no-undo .
      698     define variable v-time as integer   no-undo .
      699     run cur-time in this-procedure
      700       (output v-date
      701       ,output v-time
      702       ) .
      703     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      704   end.
      705   function cur-time-datetime returns datetime
      706   :
      707     define variable v-char as character no-undo .
      708     define variable v-datetime as datetime no-undo .
      709     v-char = cur-time-string().
      710     v-datetime = datetime(v-char).
      711     return  v-datetime.
      712   end.
      713   function cur-time-string-msec returns character
      714   :
      715     define variable v-date as datetime  no-undo .
      716     v-date = now.
      717     return string(v-date) .
      718   end.
      719   main-block:
      720   do transaction
      721   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      722   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      723   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      724   :
      725     define variable var-entry as character no-undo .
      726     define variable var-fact-order like ub.tax-rate-value.fact-order no-undo .
      727     define variable dop-rid as recid no-undo .
      728     define variable is-found as logical no-undo .
      729     define variable loc#log as logical no-undo .
      730     define variable v-today as date      no-undo.
      731     define variable v-time  as integer   no-undo.
      732     define variable varfact-date as date no-undo .
      733     define variable v-first-value as logical no-undo .
      734     define variable v-mess as character no-undo .
      735     define buffer b_tax-rate-value     for ub.tax-rate-value.
      736     define buffer buf_tax-rate-value   for ub.tax-rate-value.
      737     define buffer first_tax-rate-value for ub.tax-rate-value.
      738     define buffer new_tax-rate-value   for ub.tax-rate-value .
      739     define buffer up_tax-rate-value    for ub.tax-rate-value .
      740     if par-mode <> 'ДОБАВЛЕНИЕ':U then do:
      741       assign
      742         v-mess = substitute( "&1 (&2). Ошибка задания входных параметров. Неверный параметр par-mode (&3).", vss-workfile, vss-revision, par-mode )
      743       .
      744       run err-mess in this-procedure ( input-output v-mess ).
      745       undo main-block, return error (if p-silent = yes then v-mess else '':U ).
      746     end.
      747     FIND FIRST ub.tax-rate No-LOCK where
      748               ub.tax-rate.tax-code = partax-code AND
      749               ub.tax-rate.rate-code = parrate-code No-ERROR.
      750     if not available ub.tax-rate then do:
      751       assign
      752         v-mess = substitute( "Не найдена ставка." )
      753       .
      754       run err-mess in this-procedure ( input-output v-mess ).
      755       undo main-block, return error (if p-silent = yes then v-mess else '':U ).
      756     end.
      757     if ub.tax-rate.status_ = 'удал':U then do:
      758       assign
      759         v-mess = substitute( "Нельзя добавить значениe к удаленной ставке." )
      760       .
      761       run err-mess in this-procedure ( input-output v-mess ).
      762       undo main-block, return error (if p-silent = yes then v-mess else '':U ).
      763     end.
      764     find first first_tax-rate-value no-lock where
      765               first_tax-rate-value.tax-code = partax-code
      766           AND first_tax-rate-value.rate-code = parrate-code no-error .
      767     if not available first_tax-rate-value then do:
      768       assign
      769       v-first-value = true
      770       .
      771     end.
      772     if v-first-value = true then do:
      773       assign
      774       v-today = 01/01/1990
      775       .
      776     end.
      777     else do:
      778       if parobj-type = ""
      779       or parobj-code = 0
      780       then do:
      781           run cur-time in this-procedure ( output v-today
      782                                         , output v-time
      783                                         ).
      784       end.
      785       else do:
      786   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      787   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      788     (input  parobj-type
      789     ,input  parobj-code
      790     ,output v-today
      791     )  .
      792       end.
      793     end.
      794     if parfact-date = ? then do:
      795         assign
      796         v-mess = substitute( "Не указана дата начала действия данного значения ставки." )
      797           var-entry = "fact-date":U
      798         .
      799         run err-mess in this-procedure ( input-output v-mess ).
      800         undo main-block, return error (if p-silent = yes then v-mess else var-entry ).
      801     end.
      802     if p-silent = no
      803       and parfact-date < v-today
      804     then do:
      805       assign
      806         v-mess = substitute( "Указана дата начала действия данного значения ставки меньше текущей." )
      807         var-entry = "fact-date":U
      808       .
      809       run err-mess in this-procedure ( input-output v-mess ).
      810       undo main-block, return error (if p-silent = yes then v-mess else var-entry ).
      811     end.
      812     assign
      813     varfact-date = parfact-date
      814     .
      815     run factord-end-day in this-procedure (input parfact-date, output var-fact-order).
      816     find last b_tax-rate-value no-lock
      817       where b_tax-rate-value.tax-code = partax-code
      818         and b_tax-rate-value.rate-code = parrate-code
      819         and b_tax-rate-value.fact-order <= var-fact-order
      820         and b_tax-rate-value.host-code = parhost-code
      821         and b_tax-rate-value.obj-type = parobj-type
      822         and b_tax-rate-value.obj-code = parobj-code
      823         and b_tax-rate-value.status_ = 'тек':U
      824       no-error.
      825     if available b_tax-rate-value
      826       and b_tax-rate-value.rate-value = parrate-value
      827     then do:
      828       assign
      829         v-mess = substitute( "Уже есть ТАКОЕ ЖЕ значение ставки налога, которое действует с &1", string( b_tax-rate-value.fact-date, "99/99/9999" ) )
      830         var-entry = "rate-value":U
      831       .
      832       run err-mess in this-procedure ( input-output v-mess ).
      833       undo main-block, return error (if p-silent = yes then v-mess else var-entry ).
      834     end.
      835     else do:
      836       FIND LAST b_tax-rate-value No-LOCK WHERE
      837                 b_tax-rate-value.tax-code = partax-code AND
      838                 b_tax-rate-value.rate-code = parrate-code AND
      839                 b_tax-rate-value.fact-order <= var-fact-order AND
      840                 b_tax-rate-value.host-code = parhost-code AND
      841                 b_tax-rate-value.obj-type = parobj-type AND
      842                 b_tax-rate-value.obj-code = parobj-code
      843                 NO-ERROR.
      844       if not available b_tax-rate-value then do:
      845         assign
      846         varfact-date = 01/01/1990
      847         .
      848         run factord-end-day in this-procedure (input varfact-date, output var-fact-order).
      849       end.
      850     end.
      851     FIND FIRST b_tax-rate-value  NO-LOCK where
      852               b_tax-rate-value.tax-code = partax-code AND
      853               b_tax-rate-value.rate-code = parrate-code AND
      854               b_tax-rate-value.fact-order = var-fact-order AND
      855               b_tax-rate-value.host-code = parhost-code AND
      856               b_tax-rate-value.obj-type = parobj-type AND
      857               b_tax-rate-value.obj-code = parobj-code AND
      858               b_tax-rate-value.status_ = 'тек':U
      859               No-ERROR.
      860     if available b_tax-rate-value then do:
      861       if parfact-date > v-today then do:
      862         if p-silent = no then do:
      863           message "Уже есть значение ставки налога" skip
      864                   "с такой датой начала действия"
      865                   "Переписать значение? "
      866           view-as alert-box QUESTION
      867           buttons YES-NO update loc#log.
      868         end.
      869         else do:
      870           assign
      871             loc#log = true
      872           .
      873         end.
      874         if loc#log = false then do:
      875           assign
      876             var-entry = "fact-date":U
      877           .
      878           return error var-entry.
      879         end.
      880         else do:
      881           assign
      882             dop-rid = recid(b_tax-rate-value)
      883             is-found = yes
      884           .
      885         end.
      886       end.
      887       else do:
      888         assign
      889           v-mess = substitute( "Уже есть значение ставки налога действующее с &1", string( b_tax-rate-value.fact-date, "99/99/9999" ) )
      890           var-entry = "fact-date":U
      891         .
      892         run err-mess in this-procedure ( input-output v-mess ).
      893         undo main-block, return error (if p-silent = yes then v-mess else var-entry ).
      894       end.
      895     end.
      896     else do:
      897       FIND FIRST b_tax-rate-value  NO-LOCK where
      898                 b_tax-rate-value.tax-code = partax-code AND
      899                 b_tax-rate-value.rate-code = parrate-code AND
      900                 b_tax-rate-value.fact-order = var-fact-order AND
      901                 b_tax-rate-value.host-code = parhost-code AND
      902                 b_tax-rate-value.obj-type = parobj-type AND
      903                 b_tax-rate-value.obj-code = parobj-code AND
      904                 b_tax-rate-value.status_ = 'удал':U
      905                 No-ERROR.
      906       if available b_tax-rate-value then do:
      907         if p-silent = no then do:
      908           message substitute( "Уже есть удаленное значение ставки налога (&1)", b_tax-rate-value.rate-value ) skip
      909                   substitute( "с такой же датой начала действия (&1)", b_tax-rate-value.fact-date ) skip
      910                   "Восстановить и переписать значение? "
      911           view-as alert-box QUESTION
      912           buttons YES-NO update loc#log.
      913           if not loc#log then do:
      914             var-entry = "fact-date":U.
      915             return error var-entry.
      916           end.
      917           else do:
      918             assign
      919             dop-rid = recid(b_tax-rate-value)
      920             is-found = yes.
      921           end.
      922         end.
      923         else do:
      924           if parstatus = 'тек':U then do:
      925             assign
      926             dop-rid = recid(b_tax-rate-value)
      927             is-found = yes.
      928           end.
      929           else do:
      930             assign
      931               v-mess = substitute( "Уже есть удаленное значение ставки налога (&1) с такой датой начала действия (&2)", b_tax-rate-value.rate-value, b_tax-rate-value.fact-date )
      932               var-entry = "fact-date":U
      933             .
      934             run err-mess in this-procedure ( input-output v-mess ).
      935             undo main-block, return error (if p-silent = yes then v-mess else var-entry ).
      936           end.
      937         end.
      938       end.
      939     end.
      940     if is-found = true then do:
      941       FIND FIRST b_tax-rate-value EXCLUSIVE-LOCK where
      942                 recid( b_tax-rate-value) = dop-rid No-ERROR.
      943       if not available b_tax-rate-value then do:
      944         assign
      945           v-mess = substitute( "Не удалось переписать значение ставки налога" )
      946         .
      947         run err-mess in this-procedure ( input-output v-mess ).
      948         undo main-block, return error (if p-silent = yes then v-mess else '':U ).
      949       end.
      950       assign
      951       b_tax-rate-value.rate-value = parrate-value
      952       b_tax-rate-value.status_ = 'тек':U
      953       par-rid = recid( b_tax-rate-value )
      954       .
      955       release b_tax-rate-value no-error .
      956       if error-status:error then do:
      957         assign
      958           v-mess = substitute( "&2 (&3). Ошибка при сохранении записи ЗНАЧЕНИЕ СТАВКИ НАЛОГА.&1&4&1&5"
      959                                 , chr(10)
      960                                 , vss-workfile
      961                                 , vss-revision
      962                                 , error-status:get-message(1)
      963                                 , return-value )
      964         .
      965         run err-mess in this-procedure ( input-output v-mess ).
      966         undo main-block, return error (if p-silent = yes then v-mess else '':U ).
      967       end.
      968     end.
      969     else do:
      970       create new_tax-rate-value.
      971       assign
      972       new_tax-rate-value.tax-code = partax-code
      973       new_tax-rate-value.rate-code = parrate-code
      974       new_tax-rate-value.rate-value = parrate-value
      975       new_tax-rate-value.fact-date = varfact-date
      976       new_tax-rate-value.fact-order = var-fact-order
      977       new_tax-rate-value.status_ = 'тек':U
      978       new_tax-rate-value.host-code = parhost-code
      979       new_tax-rate-value.obj-type = parobj-type
      980       new_tax-rate-value.obj-code = parobj-code
      981       par-rid = recid( new_tax-rate-value )
      982       .
      983       if parobj-code <> 0 then do:
      984         find last buf_tax-rate-value no-lock where
      985                   buf_tax-rate-value.tax-code = partax-code AND
      986                   buf_tax-rate-value.rate-code = parrate-code AND
      987                   buf_tax-rate-value.host-code = parhost-code AND
      988                   buf_tax-rate-value.obj-type = "":U AND
      989                   buf_tax-rate-value.obj-code = 0 AND
      990                   buf_tax-rate-value.fact-order <= var-fact-order  NO-ERROR.
      991         IF not available buf_tax-rate-value OR
      992           (buf_tax-rate-value.status_ = 'удал':U AND
      993           NOT can-find(first up_tax-rate-value where
      994                           up_tax-rate-value.tax-code = partax-code AND
      995                           up_tax-rate-value.rate-code = parrate-code AND
      996                           up_tax-rate-value.host-code = parhost-code AND
      997                           up_tax-rate-value.obj-type = '':U AND
      998                           up_tax-rate-value.obj-code = 0 AND
      999                           up_tax-rate-value.fact-order <= var-fact-order AND
     1000                           recid(up_tax-rate-value) <> recid(buf_tax-rate-value)
     1001                         ) AND
     1002           buf_tax-rate-value.fact-order <> var-fact-order
     1003           ) then do:
     1004           if g#db-num > 0 then do:
     1005             assign
     1006               v-mess = substitute( "При создании значения ставки налога на объекте&1"
     1007                                     + "в БД уже должна быть определено значение ставки налога по фирме, которой принадлежит объект &1"
     1008                                     + "Введите значение ставки налога на фирме в ОФИСЕ и перешлите его по СПН&1"
     1009                                     , chr(10)
     1010                                   ) .
     1011             run err-mess in this-procedure ( input-output v-mess ).
     1012             undo main-block, return error (if p-silent = yes then v-mess else '':U ).
     1013           end.
     1014           create up_tax-rate-value.
     1015           assign
     1016           up_tax-rate-value.tax-code = partax-code
     1017           up_tax-rate-value.rate-code = parrate-code
     1018           up_tax-rate-value.rate-value = parrate-value
     1019           up_tax-rate-value.fact-date = varfact-date
     1020           up_tax-rate-value.fact-order = var-fact-order
     1021           up_tax-rate-value.status_ = 'тек':U
     1022           up_tax-rate-value.host-code = parhost-code
     1023           up_tax-rate-value.obj-type = "":U
     1024           up_tax-rate-value.obj-code = 0
     1025           .
     1026         end.
     1027         else do:
     1028           if not available buf_tax-rate-value then do:
     1029             find LAST up_tax-rate-value where
     1030                       up_tax-rate-value.tax-code = partax-code AND
     1031                       up_tax-rate-value.rate-code = parrate-code AND
     1032                       up_tax-rate-value.host-code = parhost-code AND
     1033                       up_tax-rate-value.obj-type = '':U AND
     1034                       up_tax-rate-value.obj-code = 0 AND
     1035                       up_tax-rate-value.fact-order <= var-fact-order AND
     1036                       up_tax-rate-value.status_ = 'удал':U NO-WAIT No-ERROR.
     1037             if not available up_tax-rate-value then do:
     1038               assign
     1039                 v-mess = substitute( "Не удается создать запись-родитель для значения ставки" )
     1040               .
     1041               run err-mess in this-procedure ( input-output v-mess ).
     1042               undo main-block, return error (if p-silent = yes then v-mess else '':U ).
     1043             end.
     1044             assign
     1045             up_tax-rate-value.status_ = 'тек':U
     1046             .
     1047           end.
     1048         end.
     1049         if available up_tax-rate-value then do:
     1050           release up_tax-rate-value no-error .
     1051           if error-status:error then do:
     1052             assign
     1053               v-mess = substitute( "&2 (&3). Ошибка при сохранении записи-родителя для значения ставки.&1&4&1&5"
     1054                                     , chr(10)
     1055                                     , vss-workfile
     1056                                     , vss-revision
     1057                                     , error-status:get-message(1)
     1058                                     , return-value )
     1059             .
     1060             run err-mess in this-procedure ( input-output v-mess ).
     1061             undo main-block, return error (if p-silent = yes then v-mess else '':U ).
     1062           end.
     1063         end.
     1064       end.
     1065       if parhost-code <> 0 then do:
     1066         FIND  LAST BUF_TAX-RATE-VALUe NO-LOCK where
     1067                     buf_tax-rate-value.tax-code = partax-code AND
     1068                     buf_tax-rate-value.rate-code = parrate-code AND
     1069                     buf_tax-rate-value.host-code = 0 AND
     1070                     buf_tax-rate-value.obj-type = "":U AND
     1071                     buf_tax-rate-value.obj-code = 0 AND
     1072                     buf_tax-rate-value.fact-order <= var-fact-order NO-ERROR.
     1073         IF not available buf_tax-rate-value OR
     1074           (buf_tax-rate-value.status_ = 'удал':U AND
     1075           NOT can-find(first up_tax-rate-value where
     1076                           up_tax-rate-value.tax-code = partax-code AND
     1077                           up_tax-rate-value.rate-code = parrate-code AND
     1078                           up_tax-rate-value.host-code = 0 AND
     1079                           up_tax-rate-value.obj-type = '':U AND
     1080                           up_tax-rate-value.obj-code = 0 AND
     1081                           up_tax-rate-value.fact-order <= var-fact-order AND
     1082                           recid(up_tax-rate-value) <> recid(buf_tax-rate-value)
     1083                         ) AND
     1084           buf_tax-rate-value.fact-order <> var-fact-order
     1085           ) then do:
     1086           create up_tax-rate-value.
     1087           assign
     1088           up_tax-rate-value.tax-code = partax-code
     1089           up_tax-rate-value.rate-code = parrate-code
     1090           up_tax-rate-value.rate-value = parrate-value
     1091           up_tax-rate-value.fact-date = varfact-date
     1092           up_tax-rate-value.fact-order = var-fact-order
     1093           up_tax-rate-value.status_ = 'тек':U
     1094           up_tax-rate-value.host-code = 0
     1095           up_tax-rate-value.obj-type = "":U
     1096           up_tax-rate-value.obj-code = 0
     1097           .
     1098         end.
     1099         else do:
     1100           if not available buf_tax-rate-value then do:
     1101             find LAST up_tax-rate-value where
     1102                       up_tax-rate-value.tax-code = partax-code AND
     1103                       up_tax-rate-value.rate-code = parrate-code AND
     1104                       up_tax-rate-value.host-code = 0 AND
     1105                       up_tax-rate-value.obj-type = '':U AND
     1106                       up_tax-rate-value.obj-code = 0 AND
     1107                       up_tax-rate-value.fact-order <= var-fact-order AND
     1108                       up_tax-rate-value.status_ = 'удал':U No-ERROR.
     1109             if not available up_tax-rate-value then do:
     1110               assign
     1111                 v-mess = substitute( "Не удается создать запись-родитель для значения ставки." )
     1112               .
     1113               run err-mess in this-procedure ( input-output v-mess ).
     1114               undo main-block, return error (if p-silent = yes then v-mess else '':U ).
     1115             end.
     1116             assign
     1117             up_tax-rate-value.status_ = 'тек':U
     1118             .
     1119           end.
     1120         end.
     1121         if available up_tax-rate-value then do:
     1122           release up_tax-rate-value no-error .
     1123           if error-status:error then do:
     1124             assign
     1125               v-mess = substitute( "&2 (&3). Ошибка при сохранении записи-родителя для значения ставки.&1&4&1&5"
     1126                                     , chr(10)
     1127                                     , vss-workfile
     1128                                     , vss-revision
     1129                                     , error-status:get-message(1)
     1130                                     , return-value )
     1131             .
     1132             run err-mess in this-procedure ( input-output v-mess ).
     1133             undo main-block, return error (if p-silent = yes then v-mess else '':U ).
     1134           end.
     1135         end.
     1136       end.
     1137       release new_tax-rate-value no-error .
     1138       if error-status:error then do:
     1139         assign
     1140           v-mess = substitute( "&2 (&3). Ошибка при сохранении записи ЗНАЧЕНИЕ СТАВКИ НАЛОГА.&1&4&1&5"
     1141                                 , chr(10)
     1142                                 , vss-workfile
     1143                                 , vss-revision
     1144                                 , error-status:get-message(1)
     1145                                 , return-value )
     1146         .
     1147         run err-mess in this-procedure ( input-output v-mess ).
     1148         undo main-block, return error (if p-silent = yes then v-mess else '':U ).
     1149       end.
     1150     end.
     1151     return '':U.
     1152   end.
     1153   procedure err-mess:
     1154     define input-output parameter p-mess as character no-undo.
     1155     case p-silent:
     1156       when yes then do:
     1157         assign
     1158         p-mess = substitute("Сохранение изменений в карточке ЗНАЧЕНИЙ ставки налога&1"
     1159                             + "Тип ставки &2&1"
     1160                             + "Код ставки &3&1"
     1161                             + "Код фирмы &4&1"
     1162                             + "Объект &5 &6&1"
     1163                             + "Дата включениия &7&1"
     1164                             + "&8"
     1165                            , chr(10)
     1166                            , partax-code
     1167                            , parrate-code
     1168                            , parhost-code
     1169                            , parobj-type
     1170                            , parobj-code
     1171                            , parfact-date
     1172                            , p-mess)
     1173         .
     1174       end.
     1175       when no then do:
     1176         message
     1177         p-mess
     1178         view-as alert-box error .
     1179       end.
     1180     end.
     1181   end procedure.
