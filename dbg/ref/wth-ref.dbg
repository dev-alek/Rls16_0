     1412        SIZE 3.5 BY .67
     1413        FGCOLOR 4  NO-UNDO.
     1414   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1415         VIEW-AS TEXT
     1416        SIZE 2 BY 1
     1417        FGCOLOR 4  NO-UNDO.
     1418   DEFINE VARIABLE rsfl-par AS INTEGER INITIAL 1
     1419        VIEW-AS RADIO-SET HORIZONTAL
     1420        RADIO-BUTTONS
     1421             "Текущие", 0,
     1422   "Все", 3,
     1423   "Удаленные", 1
     1424        SIZE 31.5 BY 1 NO-UNDO.
     1425   DEFINE VARIABLE rstp-par AS INTEGER INITIAL 1
     1426        VIEW-AS RADIO-SET HORIZONTAL
     1427        RADIO-BUTTONS
     1428             "Все", 3,
     1429   "Серийные", 1,
     1430   "Несерийные", 0
     1431        SIZE 32 BY .75 NO-UNDO.
     1432   DEFINE QUERY BR-wth FOR
     1433         X_wealth SCROLLING.
     1434   DEFINE BROWSE BR-wth
     1435     QUERY BR-wth NO-LOCK DISPLAY
     1436         mark-string(recid(X_wealth), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1437         X_wealth.wth-code FORMAT "999999999":U
     1438         (if X_wealth.stts = 0
     1439    then X_wealth.wth-name
     1440    else substring (X_wealth.wth-name, 1, 15) + '---  УДАЛЕН  ---':U) COLUMN-LABEL "Название" FORMAT "X(49)":U
     1441         X_wealth.is-money COLUMN-LABEL "Денежн.!эквив." FORMAT "+/":U
     1442         X_wealth.curr-code COLUMN-LABEL "Код!вал" FORMAT ">>9":U
     1443         get-curr(buffer X_wealth) COLUMN-LABEL "Валюта/!Ед.изм."
     1444         wth-lib_cur-stock-obj-func(p-curr-obj-type,p-curr-obj-code, X_wealth.wth-code) COLUMN-LABEL "На объекте" FORMAT "->>>,>>>,>>9.99":U
     1445       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16.25.
     1446   DEFINE FRAME Dialog-Frame
     1447        b-quit AT ROW 1 COL 1
     1448        B-mark AT ROW 1 COL 13
     1449        B-sel AT ROW 1 COL 16
     1450        B-add AT ROW 1 COL 26
     1451        B-chg AT ROW 1 COL 36
     1452        b-lkp AT ROW 1 COL 46
     1453        B-del AT ROW 1 COL 56
     1454        B-pobj AT ROW 1 COL 66
     1455        B-par AT ROW 1 COL 76
     1456        B-print AT ROW 1 COL 86
     1457        B-hist AT ROW 1 COL 89
     1458        B-sch AT ROW 1 COL 92
     1459        B-Help AT ROW 1 COL 95
     1460        rsfl-par AT ROW 2.25 COL 10 NO-LABEL WIDGET-ID 2
     1461        rstp-par AT ROW 3.25 COL 10 NO-LABEL WIDGET-ID 14
     1462        BR-wth AT ROW 4.25 COL 1
     1463        E-PS AT ROW 21 COL 1 NO-LABEL
     1464        mark-num AT ROW 1 COL 11 NO-LABEL
     1465        F-type AT ROW 3.25 COL 3 COLON-ALIGNED NO-LABEL WIDGET-ID 20
     1466        "Статус" VIEW-AS TEXT
     1467             SIZE 7 BY .67 AT ROW 2.42 COL 2 WIDGET-ID 12
     1468             FGCOLOR 4
     1469        SPACE(90.39) SKIP(20.66)
     1470       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1471            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1472            TITLE "Справочник материальных ценностей".
     1473   ASSIGN
     1474          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1475          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1476   ASSIGN
     1477          B-print:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-print:HANDLE.
     1478   ASSIGN
     1479          E-PS:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1480   ASSIGN
     1481          rstp-par:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1482   ON GO OF FRAME Dialog-Frame
     1483   DO:
     1484     RUN save-position IN THIS-PROCEDURE NO-ERROR.
     1485     p-rid-list = v-rid-list.
     1486   END.
     1487   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1488   DO:
     1489     APPLY "END-ERROR":U TO SELF.
     1490   END.
     1491   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1492   DO:
     1493   define variable glog as logical no-undo .
     1494   define variable rep-rec as recid no-undo .
     1495   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1496   do:
     1497     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1498       (input  v-cntxt-db-num
     1499       ,input  v-cntxt-userid
     1500       ,input  0
     1501       ,input  'actn_wealth_work':U
     1502       ,input  'global':U
     1503       ,input  0
     1504       ,input  '':U
     1505       ,input  0
     1506       ,input  0
     1507       ,input  0
     1508       ,input  0
     1509       ,input  true
     1510       ,output glog
     1511       )  .
     1512   end.
     1513   if NOT glog then return no-apply.
     1514   run ref/wth-form.w (
     1515                    input parparentproc
     1516                  , input 0
     1517                  , input 'ДОБАВЛЕНИЕ':U
     1518                  , output rep-rec).
     1519   if rep-rec <> ? then do:
     1520      v-doc-rec = rep-rec.
     1521      RUn OpenBr in this-procedure  ( input yes, input no, input '':U).
     1522     apply "entry" to br-wth in frame Dialog-Frame.
     1523   end.
     1524   else do:
     1525     apply "entry" to br-wth in frame Dialog-Frame.
     1526     return no-apply.
     1527   end.
     1528   END.
     1529   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1530   DO:
     1531   define variable rep-rec as recid no-undo .
     1532   define variable glog as logical no-undo .
     1533     if not available X_wealth then do:
     1534     message "Неправильно выбрана строка.".
     1535     return no-apply.
     1536   end.
     1537   if X_wealth.stts = 1 then do:
     1538     message substitute("Изменение записи со статусом &1 невозможно!",'---  УДАЛЕН  ---':U).
     1539     return no-apply.
     1540   end.
     1541   rep-rec = recid (X_wealth).
     1542   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1543   do:
     1544     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1545       (input  v-cntxt-db-num
     1546       ,input  v-cntxt-userid
     1547       ,input  0
     1548       ,input  'actn_wealth_work':U
     1549       ,input  'global':U
     1550       ,input  0
     1551       ,input  '':U
     1552       ,input  0
     1553       ,input  0
     1554       ,input  0
     1555       ,input  0
     1556       ,input  true
     1557       ,output glog
     1558       )  .
     1559   end.
     1560   if NOT glog then return no-apply.
     1561   run ref/wth-form.w (
     1562                    input parparentproc
     1563                  , input X_wealth.wth-code
     1564                  , input 'ИЗМЕНЕНИЕ':U
     1565                  , output rep-rec).
     1566   if rep-rec <> ? then do:
     1567      RUn OpenBr in this-procedure  ( input yes, input no, input '':U).
     1568      apply "entry" to br-wth in frame Dialog-Frame.
     1569   end.
     1570   else do:
     1571     apply "entry" to br-wth in frame Dialog-Frame.
     1572     return no-apply.
     1573   end.
     1574   END.
     1575   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1576   DO:
     1577   define variable del-rec as recid no-undo.
     1578   define variable glog as logical no-undo .
     1579   define variable rep-rec as recid no-undo .
     1580   define buffer buf_wealth for ub.wealth.
     1581   if not available X_wealth then do:
     1582     message "Неправильно выбрана строка.".
     1583     return no-apply.
     1584   end.
     1585   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1586   do:
     1587     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1588       (input  v-cntxt-db-num
     1589       ,input  v-cntxt-userid
     1590       ,input  0
     1591       ,input  'actn_wealth_work':U
     1592       ,input  'global':U
     1593       ,input  0
     1594       ,input  '':U
     1595       ,input  0
     1596       ,input  0
     1597       ,input  0
     1598       ,input  0
     1599       ,input  true
     1600       ,output glog
     1601       )  .
     1602   end.
     1603   if NOT glog then return no-apply.
     1604   rep-rec = recid ( X_wealth).
     1605   glog = no.
     1606   FIND FIRST buf_wealth WHERE recid (buf_wealth) = rep-rec.
     1607   if buf_wealth.stts <> 0 then do:
     1608       glog = no.
     1609       message
     1610       "МЦ" buf_wealth.wth-code buf_wealth.wth-name "уже удалена." skip
     1611       "Восстановить ?"
     1612       view-as alert-box question buttons Yes-No update glog.
     1613       if not glog then do:
     1614         apply "entry" to br-wth in frame Dialog-Frame.
     1615         return no-apply.
     1616       end.
     1617       assign
     1618       buf_wealth.stts = 0
     1619       .
     1620       run OpenBr in this-procedure  ( input yes, input no, input '':U).
     1621       apply "entry" to br-wth in frame Dialog-Frame.
     1622   end.
     1623   else do:
     1624         glog = no.
     1625         message
     1626         "Удалить МЦ :" skip
     1627         buf_wealth.wth-code buf_wealth.wth-name skip
     1628        "Вы уверены ?"
     1629         view-as alert-box question buttons OK-Cancel update glog.
     1630         if not glog then do:
     1631           apply "entry" to br-wth in frame Dialog-Frame.
     1632           return no-apply.
     1633         end.
     1634         if wth-lib_cur-stock-host-func(p-curr-host-code,buf_wealth.wth-code ) <> 0 then do:
     1635           message 'Удаление невозможно!' skip
     1636          'МЦ имеется на остатках по фирме.' skip
     1637          'Количество по фирме: ' wth-lib_cur-stock-host-func(p-curr-host-code,buf_wealth.wth-code )
     1638          view-as alert-box error.
     1639          apply "entry" to br-wth in frame Dialog-Frame.
     1640          return no-apply.
     1641         end.
     1642         assign
     1643         buf_wealth.stts = 1
     1644         .
     1645       run OpenBr in this-procedure  ( input yes, input no, input '':U).
     1646       apply "entry" to br-wth in frame Dialog-Frame.
     1647    end.
     1648   END.
     1649   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1650   DO:
     1651     IF NOT AVAILABLE X_wealth THEN RETURN NO-APPLY.
     1652     define variable v-rid-list  as   character            no-undo .
     1653     define variable v-host-code like ub.sysconf.host-code no-undo .
     1654     run ref/cwthhist.w (
     1655                      input        parparentproc
     1656                    , input        p-curr-host-code
     1657                    , input        p-curr-obj-type
     1658                    , input        p-curr-obj-code
     1659                    , input        "":U
     1660                    , input        "one":U
     1661                    , input        X_wealth.wth-code
     1662                    , INPUT        0
     1663                    , input        ?
     1664                    , input        ?
     1665                    , input        ?
     1666                    , input        ?
     1667                    , input        "":U
     1668                    , input        "":U
     1669                    , input         v-cntxt-db-num
     1670                    , input        ?
     1671                    , input        ?
     1672                    , input-output v-rid-list
     1673                    ) no-error .
     1674   END.
     1675   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1676   DO:
     1677       define variable rep-rec as recid no-undo .
     1678       if not available X_wealth then do:
     1679         message "Неправильно выбрана строка.".
     1680         return no-apply.
     1681       end.
     1682       rep-rec = recid (X_wealth).
     1683       run ref/wth-form.w (
     1684                        input parparentproc
     1685                      , input X_wealth.wth-code
     1686                      , input 'ПРОСМОТР':U
     1687                      , output rep-rec) NO-ERROR.
     1688        apply "entry" to br-wth in frame Dialog-Frame.
     1689        return no-apply.
     1690   END.
     1691   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1692   DO:
     1693    define variable glog as logical no-undo .
     1694     if available X_wealth then do:
     1695   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1696   define variable v-str-recid17 as character no-undo .
     1697   define variable v-num-entry17 as integer   no-undo .
     1698   assign
     1699     v-str-recid17 = trim( string( recid( X_wealth ) , "->>>>>>>>>>>9":U ) )
     1700     v-num-entry17 = lookup( v-str-recid17 , v-rid-list )
     1701   .
     1702   if v-num-entry17 > 0 then do:
     1703     assign
     1704       entry( v-num-entry17, v-rid-list ) = "":U
     1705       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1706     .
     1707   end.
     1708   else do:
     1709     assign
     1710       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid17
     1711     .
     1712   end.
     1713       br-wth:refresh().
     1714       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1715               glog = br-wth:select-next-row ().
     1716               apply "iteration-changed" to br-wth in frame Dialog-Frame.
     1717           end.
     1718       if num-entries( v-rid-list ) = 0 then
     1719           hide mark-num in frame Dialog-Frame.
     1720       else
     1721           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1722     end.
     1723     apply "entry" to br-wth in frame Dialog-Frame.
     1724   END.
     1725   ON CHOOSE OF B-par IN FRAME Dialog-Frame
     1726   DO:
     1727     if not avail X_wealth then return no-apply.
     1728     define variable v-rid-list as character no-undo .
     1729     run ref/wthp-ref.w (
     1730                     input parparentproc
     1731                    ,input (if lookup("b-add", bttns) > 0 then "b-add" else "")
     1732                    ,input p-curr-host-code
     1733                    ,input p-curr-obj-type
     1734                    ,input p-curr-obj-code
     1735                    ,input 'МЦ':U
     1736                    ,input X_wealth.wth-code
     1737                    ,input-output v-rid-list).
     1738   END.
     1739   ON CHOOSE OF B-pobj IN FRAME Dialog-Frame
     1740   DO:
     1741   define variable v-rid-list as character no-undo .
     1742     if avail X_wealth then do:
     1743       run ref/wthpobjr.w (
     1744                       input parparentproc
     1745                      ,input ('МЦ':U + chr(47) + 'объект':U)
     1746                      ,input X_wealth.wth-code
     1747                      ,input ?
     1748                      ,input p-curr-obj-type
     1749                      ,input p-curr-obj-code
     1750                      ,input-output v-rid-list
     1751                      ) .
     1752     end.
     1753   END.
     1754   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1755   DO:
     1756   define variable doc-rec as recid no-undo .
     1757     if print-option = "" then do:
     1758          run gbl/pop-up.p (self:handle, no) no-error.
     1759     end.
     1760       doc-rec = recid( X_wealth ).
     1761       DO WHILE available X_wealth :
     1762             GET prev br-wth.
     1763       END.
     1764       CASE print-option:
     1765         when "wealth":U then do:
     1766             run PrintProc.
     1767         end.
     1768         when "wth-par":U then do:
     1769             run PrintProcPar.
     1770         end.
     1771       END CASE.
     1772       print-option = "".
     1773       reposition br-wth to recid doc-rec no-error.
     1774       apply "entry" to br-wth in frame Dialog-Frame.
     1775   END.
     1776   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1777   DO:
     1778     assign
     1779     tbl = 'wealth'
     1780     join-tbl = 'X_wealth'
     1781     fld = '':U
     1782     spr = '':U
     1783     lab = '':U
     1784     dim = '0':U
     1785     .
     1786     run fltfield-add in this-procedure('wth-code', 'Код МЦ', '',
     1787     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1788     run fltfield-add in this-procedure('wth-name', 'Название', '',
     1789     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1790     run fltfield-add in this-procedure('curr-code', '', 'curr',
     1791     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1792     run fltfield-add in this-procedure('is-money', '', '',
     1793     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1794     run fltfield-add in this-procedure('PS', 'Примечание', '',
     1795     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1796     DO on stop undo, leave:
     1797         run gbl/filter.w ( input parparentproc
     1798                           ,input filter-point
     1799                           ,input tbl
     1800                           ,input join-tbl
     1801                           ,input fld
     1802                           ,input lab
     1803                           ,input spr
     1804                           ,input dim).
     1805         RUN OpenBr in this-procedure  ( input yes, input no, input '':U).
     1806     END .
     1807   END.
     1808   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1809   DO:
     1810       if ( available X_wealth
     1811           AND (v-rid-list = ""
     1812               or
     1813               b-mark:sensitive = no)
     1814           ) then
     1815           v-rid-list = string( recid( X_wealth ) ) .
     1816   END.
     1817   ON MOUSE-SELECT-DBLCLICK OF BR-wth IN FRAME Dialog-Frame
     1818   DO:
     1819       if lookup("b-sel", bttns) > 0 then APPLY "CHOOSE" to b-sel.
     1820   END.
     1821   ON RETURN OF BR-wth IN FRAME Dialog-Frame
     1822   DO:
     1823       if lookup("b-sel", bttns) > 0 then APPLY "CHOOSE" to b-sel.
     1824   END.
     1825   ON VALUE-CHANGED OF BR-wth IN FRAME Dialog-Frame
     1826   DO:
     1827     if avail X_wealth then do:
     1828       E-PS:screen-value = X_wealth.PS  .
     1829       b-del:label = if X_wealth.stts = 1 then 'Восстанов' else 'Удалить'.
     1830     end.
     1831     else
     1832     E-PS:screen-value = "".
     1833   END.
     1834   ON CHOOSE OF MENU-ITEM m_par
     1835   DO:
     1836         print-option = "wth-par":U.
     1837       apply "choose" to b-print in frame Dialog-Frame.
     1838   END.
     1839   ON CHOOSE OF MENU-ITEM m_wealth
     1840   DO:
     1841           print-option = "wealth":U.
     1842       apply "choose" to b-print in frame Dialog-Frame.
     1843   END.
     1844   ON VALUE-CHANGED OF rsfl-par IN FRAME Dialog-Frame
     1845   DO:
     1846     RUN OpenBR in this-procedure  ( input yes, input no, input '':U).
     1847   END.
     1848   ON VALUE-CHANGED OF rstp-par IN FRAME Dialog-Frame
     1849   DO:
     1850     RUN OpenBR in this-procedure  ( input yes, input no, input '':U).
     1851   END.
     1852   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1853   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1854   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1855   on help of frame Dialog-Frame
     1856   do:
     1857     run gbl/app_help.p
     1858       (input this-procedure :file-name
     1859       ,input ''
     1860       ,input ?
     1861       ) no-error.
     1862     if error-status :error then do:
     1863       message
     1864         "Ошибка при вызове помощи"
     1865         error-status :get-message(1)
     1866         view-as alert-box .
     1867     end.
     1868   end.
     1869   run minbtn-set in this-procedure .
     1870   on choose of b-help in frame Dialog-Frame
     1871   do:
     1872     apply "help":u to frame Dialog-Frame .
     1873   end.
     1874   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1875   procedure minbtn-set :
     1876       do
     1877           on error undo, return error return-value
     1878           :
     1879           define variable ii              as integer       no-undo .
     1880           define variable fh              as widget-handle no-undo .
     1881           define variable hh              as widget-handle no-undo .
     1882           define variable v-h             as handle        extent 4 no-undo .
     1883           define variable v-name-button   as character     no-undo .
     1884           define variable v-help-old-x    as decimal       no-undo .
     1885           define variable v-help-old-y    as decimal       no-undo .
     1886           define variable v-help-old-size as decimal       no-undo .
     1887           define variable v-frame-width   as decimal       no-undo .
     1888           define variable jj              as integer       no-undo .
     1889           do
     1890               on error undo, return error
     1891               :
     1892               assign
     1893                   v-frame-width = frame Dialog-Frame:width - 0.3
     1894                   fh            = frame Dialog-Frame:first-child
     1895                   hh            = fh:first-child
     1896                   ii            = 1
     1897                   .
     1898               do while valid-handle(hh):
     1899                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1900                   do:
     1901                       case lc(hh:name) :
     1902                           when "b-help" then
     1903                               do:
     1904                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1905                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1906                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1907                                   hh:TOOLTIP = "Помощь" .
     1908                                   v-help-old-x = hh:column .
     1909                                   v-help-old-y = hh:row    .
     1910                                   v-help-old-size = hh:width .
     1911                                   hh:width-chars = 2.5 .
     1912                               end.
     1913                           when "b-print" then
     1914                               do:
     1915                                   hh:load-image("cmp/b-print.bmp":u) .
     1916                                   hh:TOOLTIP = "Печать" .
     1917                                   v-h[ii] = hh:handle .
     1918                                   ii = ii + 1 .
     1919                                   hh:width-chars = 3 .
     1920                               end.
     1921                           when "b-history" or
     1922                           when "b-hist" then
     1923                               do:
     1924                                   hh:load-image("cmp/b-hist.bmp":u) .
     1925                                   hh:TOOLTIP = "История" .
     1926                                   v-h[ii] = hh:handle .
     1927                                   ii = ii + 1 .
     1928                                   hh:width-chars = 3 .
     1929                               end.
     1930                           when "b-sch" then
     1931                               do:
     1932                                   hh:load-image("cmp/b-sch.bmp":u) .
     1933                                   hh:TOOLTIP = "Установка Фильтра" .
     1934                                   v-h[ii] = hh:handle .
     1935                                   ii = ii + 1 .
     1936                                   hh:width-chars = 3 .
     1937                               end.
     1938                           when "b-hist-user" then
     1939                               do:
     1940                                   hh:load-image("cmp/b-hist.bmp":u) .
     1941                                   hh:TOOLTIP = "История пользователя" .
     1942                                   ii = ii + 1 .
     1943                               end.
     1944                       end case.
     1945                   end.
     1946                   hh = hh:next-sibling.
     1947               end.
     1948               b-help:column = v-frame-width - b-help:width-chars.
     1949               jj = 0.
     1950               repeat ii = 4 to 1 by -1 :
     1951                   if valid-handle (v-h[ii] ) then
     1952                   do:
     1953                       jj  = jj + 1 .
     1954                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1955                       v-h[ii]:row    = v-help-old-y .
     1956                   end.
     1957               end.
     1958           end.
     1959       end.
     1960   end procedure.
     1961   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1962   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1963   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1964   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1965   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1966   define variable v-diasize-current-frame-height as decimal   no-undo .
     1967   define variable v-diasize-change-size          as logical   no-undo .
     1968   define variable v-diasize-resize-button        as handle    no-undo .
     1969   define variable v-diasize-wndmax               as logical   no-undo .
     1970   define variable v-diasize-wndstore             as logical   no-undo .
     1971   define variable v-diasize-proc-name            as character no-undo .
     1972   define variable v-diasize-browse-handle        as handle    no-undo .
     1973   define variable v-diasize-browse-number        as integer   no-undo .
     1974   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1975   define temp-table temp-diasize-handle no-undo
     1976     field handle-value  as handle
     1977     field save-position as decimal
     1978     index xpk is primary unique handle-value
     1979     .
     1980   define temp-table temp-browse-handle no-undo
     1981     field browse-type   as character
     1982     field browse-number as integer
     1983     field browse-handle as handle
     1984     field original-size as decimal
     1985     index xpk is primary unique browse-type browse-number
     1986     index xie browse-type browse-handle
     1987   .
     1988   procedure diasize_change-height :
     1989     define input  parameter p-change-value  as decimal   no-undo .
     1990     define input  parameter p-move-resize   as logical   no-undo .
     1991     define variable v-field-group-handle    as handle    no-undo .
     1992     define variable v-object-handle         as handle    no-undo .
     1993     define variable v-frame-height          as decimal   no-undo .
     1994     define variable v-frame-virtual-height  as decimal   no-undo .
     1995     define variable v-browse-height         as decimal   no-undo .
     1996     define variable v-window-height         as decimal   no-undo .
     1997     define variable v-window-virtual-height as decimal   no-undo .
     1998     define variable v-change-sign           as integer   no-undo .
     1999     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2000     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2001     if p-change-value > 0
     2002     then do:
     2003       if frame Dialog-Frame :height + p-change-value
     2004           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2005       then do:
     2006         assign
     2007           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2008                           - (frame Dialog-Frame :height-chars)
     2009         .
     2010         if p-change-value <= 0
     2011         then do:
     2012           run diasize_position-resize-button in this-procedure .
     2013           return .
     2014         end.
     2015       end.
     2016     end.
     2017     if p-change-value < 0
     2018     then do:
     2019       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2020       then do:
     2021         assign
     2022           p-change-value = v-diasize-orig-frame-height
     2023                          - (frame Dialog-Frame :height-chars)
     2024         .
     2025         if p-change-value >= 0
     2026         then do:
     2027           run diasize_position-resize-button in this-procedure .
     2028           return .
     2029         end.
     2030       end.
     2031     end.
     2032     if p-change-value >= 0
     2033     then do:
     2034       assign
     2035         v-change-sign = 1
     2036       .
     2037     end.
     2038     else do:
     2039       assign
     2040         v-change-sign = -1
     2041       .
     2042     end.
     2043     assign
     2044       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2045     .
     2046     if p-change-value = 0
     2047     then do:
     2048       run diasize_position-resize-button in this-procedure .
     2049       return .
     2050     end.
     2051     move_block:
     2052     do
     2053     on error undo move_block, retry move_block
     2054     :
     2055       if retry
     2056       then do:
     2057         do
     2058         on error undo move_block, leave move_block
     2059         :
     2060           if p-change-value > 0
     2061           then do:
     2062             for each buf_temp-diasize-handle
     2063             on error undo, next
     2064             :
     2065               assign
     2066                 v-object-handle = buf_temp-diasize-handle.handle-value
     2067               .
     2068               if v-object-handle <> v-diasize-resize-button
     2069               then do:
     2070                 assign
     2071                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2072                 .
     2073               end.
     2074             end.
     2075             assign
     2076               v-diasize-browse-handle :height = v-browse-height
     2077             .
     2078             for each buf_temp-browse-handle
     2079               where buf_temp-browse-handle.browse-type = 'height':u
     2080             on error undo, next
     2081             :
     2082               assign
     2083                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2084               .
     2085             end.
     2086             assign
     2087               frame Dialog-Frame :height = v-frame-height
     2088             .
     2089             if frame Dialog-Frame :scrollable = true
     2090             then do:
     2091               assign
     2092                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2093               .
     2094             end.
     2095             run diasize_position-resize-button in this-procedure .
     2096           end.
     2097           else do:
     2098             if frame Dialog-Frame :scrollable = true
     2099             then do:
     2100               assign
     2101                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2102               .
     2103             end.
     2104             assign
     2105               frame Dialog-Frame :height = v-frame-height
     2106             .
     2107             assign
     2108               v-diasize-browse-handle :height = v-browse-height
     2109             .
     2110             for each buf_temp-browse-handle
     2111               where buf_temp-browse-handle.browse-type = 'height':u
     2112             on error undo, next
     2113             :
     2114               assign
     2115                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2116               .
     2117             end.
     2118             for each buf_temp-diasize-handle
     2119             on error undo, next
     2120             :
     2121               assign
     2122                 v-object-handle = buf_temp-diasize-handle.handle-value
     2123               .
     2124               if v-object-handle <> v-diasize-resize-button
     2125               then do:
     2126                 assign
     2127                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2128                 .
     2129               end.
     2130             end.
     2131             run diasize_position-resize-button in this-procedure .
     2132           end.
     2133           assign
     2134             v-diasize-change-size = false
     2135           .
     2136           leave move_block .
     2137         end.
     2138       end.
     2139       assign
     2140         v-diasize-need-full-display = true
     2141       .
     2142       if v-diasize-change-size = false
     2143       then do:
     2144         assign
     2145           v-diasize-change-size = true
     2146         .
     2147       end.
     2148       else do:
     2149         return .
     2150       end.
     2151       assign
     2152         v-frame-height = frame Dialog-Frame :height
     2153         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2154         v-browse-height = v-diasize-browse-handle :height
     2155       .
     2156       for each buf_temp-browse-handle
     2157         where buf_temp-browse-handle.browse-type = 'height':u
     2158       :
     2159         assign
     2160           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2161         .
     2162       end.
     2163       for each buf_temp-diasize-handle
     2164       :
     2165         delete buf_temp-diasize-handle .
     2166       end.
     2167       assign
     2168         v-field-group-handle = frame Dialog-Frame :first-child
     2169       .
     2170       do while valid-handle(v-field-group-handle)
     2171       :
     2172         assign
     2173           v-object-handle = v-field-group-handle :first-child
     2174         .
     2175         do while valid-handle(v-object-handle)
     2176         :
     2177           if  v-object-handle <> v-diasize-browse-handle :handle
     2178           and can-query(v-object-handle, "row")
     2179           and can-query(v-object-handle, "height")
     2180           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2181           then do:
     2182             find first buf_temp-browse-handle
     2183               where buf_temp-browse-handle.browse-type   = 'height':u
     2184                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2185               no-error .
     2186             if available buf_temp-browse-handle
     2187             then do:
     2188             end.
     2189             else do:
     2190               create buf_temp-diasize-handle .
     2191               assign
     2192                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2193                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2194               .
     2195             end.
     2196           end.
     2197           assign
     2198             v-object-handle = v-object-handle :next-sibling
     2199           .
     2200         end.
     2201         assign
     2202           v-field-group-handle = v-field-group-handle :next-sibling
     2203         .
     2204       end.
     2205       do with frame Dialog-Frame
     2206       :
     2207         hide v-diasize-resize-button .
     2208         assign
     2209           v-diasize-resize-button :row    = 1
     2210           v-diasize-resize-button :column = 1
     2211         .
     2212       end.
     2213       if p-change-value > 0
     2214       then do:
     2215         if frame Dialog-Frame :scrollable = true
     2216         then do:
     2217           assign
     2218             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2219             no-error .
     2220           if error-status :error
     2221           or error-status :get-message(1) <> ""
     2222           then do:
     2223             undo move_block, retry move_block .
     2224           end.
     2225         end.
     2226         assign
     2227           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2228           no-error .
     2229         if error-status :error
     2230         or error-status :get-message(1) <> ""
     2231         then do:
     2232           undo move_block, retry move_block .
     2233         end.
     2234         assign
     2235           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2236           no-error .
     2237         if error-status :error
     2238         or error-status :get-message(1) <> ""
     2239         then do:
     2240           undo move_block, retry move_block .
     2241         end.
     2242         for each buf_temp-browse-handle
     2243           where buf_temp-browse-handle.browse-type = 'height':u
     2244         on error undo move_block, retry move_block
     2245         :
     2246           assign
     2247             buf_temp-browse-handle.browse-handle :height
     2248               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2249             no-error .
     2250           if error-status :error
     2251           or error-status :get-message(1) <> ""
     2252           then do:
     2253             undo move_block, retry move_block .
     2254           end.
     2255         end.
     2256         for each buf_temp-diasize-handle
     2257         on error undo move_block, retry move_block
     2258         :
     2259           assign
     2260             v-object-handle = buf_temp-diasize-handle.handle-value
     2261           .
     2262           if v-object-handle <> v-diasize-resize-button
     2263           then do:
     2264             assign
     2265               v-object-handle :row = v-object-handle :row + p-change-value
     2266               no-error .
     2267             if error-status :error
     2268             or error-status :get-message(1) <> ""
     2269             then do:
     2270               undo move_block, retry move_block .
     2271             end.
     2272           end.
     2273         end.
     2274       end.
     2275       else do:
     2276         for each buf_temp-diasize-handle
     2277         on error undo move_block, retry move_block
     2278         :
     2279           assign
     2280             v-object-handle = buf_temp-diasize-handle.handle-value
     2281           .
     2282           if v-object-handle <> v-diasize-resize-button
     2283           then do:
     2284             assign
     2285               v-object-handle :row = v-object-handle :row + p-change-value
     2286               no-error .
     2287             if error-status :error
     2288             or error-status :get-message(1) <> ""
     2289             then do:
     2290               undo move_block, retry move_block .
     2291             end.
     2292           end.
     2293         end.
     2294         assign
     2295           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2296           no-error .
     2297         if error-status :error
     2298         or error-status :get-message(1) <> ""
     2299         then do:
     2300           undo move_block, retry move_block .
     2301         end.
     2302         for each buf_temp-browse-handle
     2303           where buf_temp-browse-handle.browse-type = 'height':u
     2304         on error undo move_block, retry move_block
     2305         :
     2306           assign
     2307             buf_temp-browse-handle.browse-handle :height
     2308               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2309             no-error .
     2310           if error-status :error
     2311           or error-status :get-message(1) <> ""
     2312           then do:
     2313             undo move_block, retry move_block .
     2314           end.
     2315         end.
     2316         assign
     2317           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2318           no-error .
     2319         if error-status :error
     2320         or error-status :get-message(1) <> ""
     2321         then do:
     2322           undo move_block, retry move_block .
     2323         end.
     2324         if frame Dialog-Frame :scrollable = true
     2325         then do:
     2326           assign
     2327             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2328             no-error .
     2329           if error-status :error
     2330           or error-status :get-message(1) <> ""
     2331           then do:
     2332             undo move_block, retry move_block .
     2333           end.
     2334         end.
     2335       end.
     2336       if p-move-resize = true
     2337       then do:
     2338         run diasize_position-resize-button in this-procedure .
     2339       end.
     2340       if v-diasize-wndstore = true
     2341       then do:
     2342         if connected("ub") = true
     2343         then do:
     2344           define variable v-cntxt-db-num        as integer   no-undo .
     2345           define variable v-cntxt-userid        as character no-undo .
     2346           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2347                                             , OUTPUT v-cntxt-userid
     2348                                             ) .
     2349           run gbl/wndsizew.p
     2350             (input  v-cntxt-db-num
     2351             ,input  v-cntxt-userid
     2352             ,input  v-diasize-proc-name
     2353             ,input  'height':u
     2354             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2355             ) .
     2356         end.
     2357       end.
     2358     end.
     2359     assign
     2360       v-diasize-change-size = false
     2361     .
     2362   end procedure.
     2363   procedure diasize_set-height :
     2364     define input  parameter p-new-height  as decimal   no-undo .
     2365     define input  parameter p-move-resize as logical   no-undo .
     2366     do
     2367     on error undo, return error return-value
     2368     :
     2369       run diasize_change-height in this-procedure
     2370         (input  (p-new-height - frame Dialog-Frame :height)
     2371         ,input  p-move-resize
     2372         ) .
     2373     end.
     2374   end procedure.
     2375   procedure diasize_change-width :
     2376     define input  parameter p-change-value as decimal   no-undo .
     2377     define input  parameter p-move-resize  as logical   no-undo .
     2378     define variable v-field-group-handle   as handle    no-undo .
     2379     define variable v-object-handle        as handle    no-undo .
     2380     define variable v-frame-width          as decimal   no-undo .
     2381     define variable v-frame-virtual-width  as decimal   no-undo .
     2382     define variable v-browse-width         as decimal   no-undo .
     2383     define variable v-window-width         as decimal   no-undo .
     2384     define variable v-window-virtual-width as decimal   no-undo .
     2385     define variable v-change-sign          as integer   no-undo .
     2386     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2387     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2388     if p-change-value > 0
     2389     then do:
     2390       if frame Dialog-Frame :width + p-change-value >
     2391           session :width-chars
     2392       then do:
     2393         assign
     2394           p-change-value = session :width-chars - frame Dialog-Frame :width
     2395         .
     2396         if p-change-value <= 0
     2397         then do:
     2398           run diasize_position-resize-button in this-procedure .
     2399           return .
     2400         end.
     2401       end.
     2402     end.
     2403     if p-change-value < 0
     2404     then do:
     2405       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2406       then do:
     2407         assign
     2408           p-change-value = v-diasize-orig-frame-width
     2409                          - frame Dialog-Frame :width
     2410         .
     2411         if p-change-value >= 0
     2412         then do:
     2413           run diasize_position-resize-button in this-procedure .
     2414           return .
     2415         end.
     2416       end.
     2417     end.
     2418     if p-change-value >= 0
     2419     then do:
     2420       assign
     2421         v-change-sign = 1
     2422       .
     2423     end.
     2424     else do:
     2425       assign
     2426         v-change-sign = -1
     2427       .
     2428     end.
     2429     assign
     2430       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2431     .
     2432     if p-change-value = 0
     2433     then do:
     2434       run diasize_position-resize-button in this-procedure .
     2435       return .
     2436     end.
     2437     move_block:
     2438     do
     2439     on error undo move_block, leave move_block
     2440     :
     2441       if retry
     2442       then do:
     2443         do
     2444         on error undo move_block, leave move_block
     2445         :
     2446           if p-change-value > 0
     2447           then do:
     2448             for each buf_temp-diasize-handle
     2449             on error undo, next
     2450             :
     2451               assign
     2452                 v-object-handle = buf_temp-diasize-handle.handle-value
     2453               .
     2454               if v-object-handle <> v-diasize-resize-button
     2455               then do:
     2456                 assign
     2457                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2458                 .
     2459               end.
     2460             end.
     2461             assign
     2462               v-diasize-browse-handle :width = v-browse-width
     2463             .
     2464             for each buf_temp-browse-handle
     2465               where buf_temp-browse-handle.browse-type = 'width':u
     2466             on error undo, next
     2467             :
     2468               assign
     2469                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2470               .
     2471             end.
     2472             assign
     2473               frame Dialog-Frame :width = v-frame-width
     2474             .
     2475             if frame Dialog-Frame :scrollable = true
     2476             then do:
     2477               assign
     2478                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2479               .
     2480             end.
     2481             run diasize_position-resize-button in this-procedure .
     2482           end.
     2483           else do:
     2484             if frame Dialog-Frame :scrollable = true
     2485             then do:
     2486               assign
     2487                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2488               .
     2489             end.
     2490             assign
     2491               frame Dialog-Frame :width = v-frame-width
     2492             .
     2493             for each buf_temp-browse-handle
     2494               where buf_temp-browse-handle.browse-type = 'width':u
     2495             on error undo, next
     2496             :
     2497               assign
     2498                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2499               .
     2500             end.
     2501             assign
     2502               v-diasize-browse-handle :width = v-browse-width
     2503             .
     2504             for each buf_temp-diasize-handle
     2505             on error undo, next
     2506             :
     2507               assign
     2508                 v-object-handle = buf_temp-diasize-handle.handle-value
     2509               .
     2510               if v-object-handle <> v-diasize-resize-button
     2511               then do:
     2512                 assign
     2513                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2514                 .
     2515               end.
     2516             end.
     2517             run diasize_position-resize-button in this-procedure .
     2518           end.
     2519           assign
     2520             v-diasize-change-size = false
     2521           .
     2522           leave move_block .
     2523         end.
     2524       end.
     2525       assign
     2526         v-diasize-need-full-display = true
     2527       .
     2528       if v-diasize-change-size = false
     2529       then do:
     2530         assign
     2531           v-diasize-change-size = true
     2532         .
     2533       end.
     2534       else do:
     2535         return .
     2536       end.
     2537       assign
     2538         v-frame-width = frame Dialog-Frame :width
     2539         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2540         v-browse-width = v-diasize-browse-handle :width
     2541       .
     2542       for each buf_temp-browse-handle
     2543         where buf_temp-browse-handle.browse-type = 'width':u
     2544       :
     2545         assign
     2546           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2547         .
     2548       end.
     2549       for each buf_temp-diasize-handle
     2550       :
     2551         delete buf_temp-diasize-handle .
     2552       end.
     2553       assign
     2554         v-field-group-handle = frame Dialog-Frame :first-child
     2555       .
     2556       do while valid-handle(v-field-group-handle)
     2557       :
     2558         assign
     2559           v-object-handle = v-field-group-handle :first-child
     2560         .
     2561         do while valid-handle(v-object-handle)
     2562         :
     2563           if  v-object-handle <> v-diasize-browse-handle :handle
     2564           and v-object-handle <> v-diasize-resize-button
     2565           and can-query(v-object-handle, "row")
     2566           and can-query(v-object-handle, "height")
     2567           and ( v-object-handle :col + v-object-handle :width
     2568                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2569               )
     2570           then do:
     2571             find first buf_temp-browse-handle
     2572               where buf_temp-browse-handle.browse-type   = 'width':u
     2573                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2574               no-error .
     2575             if available buf_temp-browse-handle
     2576             then do:
     2577             end.
     2578             else do:
     2579               create buf_temp-diasize-handle .
     2580               assign
     2581                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2582                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2583               .
     2584             end.
     2585           end.
     2586           assign
     2587             v-object-handle = v-object-handle :next-sibling
     2588           .
     2589         end.
     2590         assign
     2591           v-field-group-handle = v-field-group-handle :next-sibling
     2592         .
     2593       end.
     2594       do with frame Dialog-Frame
     2595       :
     2596         hide v-diasize-resize-button .
     2597         v-diasize-resize-button :row = 1.
     2598         v-diasize-resize-button :column = 1.
     2599       end.
     2600       if p-change-value > 0
     2601       then do:
     2602         if frame Dialog-Frame :scrollable = true
     2603         then do:
     2604           assign
     2605             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2606             no-error .
     2607           if error-status :error
     2608           or error-status :get-message(1) <> ""
     2609           then do:
     2610             undo move_block, retry move_block.
     2611           end.
     2612         end.
     2613         assign
     2614           frame Dialog-Frame :width = v-frame-width + p-change-value
     2615           no-error .
     2616         if error-status :error
     2617         or error-status :get-message(1) <> ""
     2618         then do:
     2619           undo move_block, retry move_block.
     2620         end.
     2621         assign
     2622           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2623         no-error .
     2624         if error-status :error
     2625         or error-status :get-message(1) <> ""
     2626         then do:
     2627           undo move_block, retry move_block.
     2628         end.
     2629         for each buf_temp-browse-handle
     2630           where buf_temp-browse-handle.browse-type = 'width':u
     2631         on error undo move_block, retry move_block
     2632         :
     2633           assign
     2634             buf_temp-browse-handle.browse-handle :width
     2635               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2636             no-error .
     2637           if error-status :error
     2638           or error-status :get-message(1) <> ""
     2639           then do:
     2640             undo move_block, retry move_block .
     2641           end.
     2642         end.
     2643         for each buf_temp-diasize-handle
     2644         on error undo move_block, retry move_block
     2645         :
     2646           assign
     2647             v-object-handle = buf_temp-diasize-handle.handle-value
     2648           .
     2649           if v-object-handle <> v-diasize-resize-button
     2650           then do:
     2651             assign
     2652               v-object-handle :col = v-object-handle :col + p-change-value
     2653               no-error .
     2654             if error-status :error
     2655             or error-status :get-message(1) <> ""
     2656             then do:
     2657               undo move_block, retry move_block .
     2658             end.
     2659           end.
     2660         end.
     2661       end.
     2662       else do:
     2663         for each buf_temp-diasize-handle
     2664         on error undo move_block, retry move_block
     2665         :
     2666           assign
     2667             v-object-handle = buf_temp-diasize-handle.handle-value
     2668           .
     2669           if v-object-handle <> v-diasize-resize-button
     2670           then do:
     2671             assign
     2672               v-object-handle :col = v-object-handle :col + p-change-value
     2673               no-error .
     2674             if error-status :error
     2675             or error-status :get-message(1) <> ""
     2676             then do:
     2677               undo move_block, retry move_block .
     2678             end.
     2679           end.
     2680         end.
     2681         for each buf_temp-browse-handle
     2682           where buf_temp-browse-handle.browse-type = 'width':u
     2683         on error undo move_block, retry move_block
     2684         :
     2685           assign
     2686             buf_temp-browse-handle.browse-handle :width
     2687               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2688             no-error .
     2689           if error-status :error
     2690           or error-status :get-message(1) <> ""
     2691           then do:
     2692             undo move_block, retry move_block .
     2693           end.
     2694         end.
     2695         assign
     2696           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2697           no-error .
     2698         if error-status :error
     2699         or error-status :get-message(1) <> ""
     2700         then do:
     2701           undo move_block, retry move_block.
     2702         end.
     2703         assign
     2704           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2705         no-error .
     2706         if error-status :error
     2707         or error-status :get-message(1) <> ""
     2708         then do:
     2709           undo move_block, retry move_block.
     2710         end.
     2711         if frame Dialog-Frame :scrollable = true
     2712         then do:
     2713           assign
     2714             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2715           no-error .
     2716           if error-status :error
     2717           or error-status :get-message(1) <> ""
     2718           then do:
     2719             undo move_block, retry move_block.
     2720           end.
     2721         end.
     2722       end.
     2723       if p-move-resize
     2724       then do:
     2725         run diasize_position-resize-button in this-procedure .
     2726       end.
     2727       if v-diasize-wndstore = true
     2728       then do:
     2729         if connected("ub") = true
     2730         then do:
     2731           define variable v-cntxt-db-num        as integer   no-undo .
     2732           define variable v-cntxt-userid        as character no-undo .
     2733           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2734                                             , OUTPUT v-cntxt-userid
     2735                                             ) .
     2736           run gbl/wndsizew.p
     2737             (input  v-cntxt-db-num
     2738             ,input  v-cntxt-userid
     2739             ,input  v-diasize-proc-name
     2740             ,input  'width':u
     2741             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2742             ) .
     2743         end.
     2744       end.
     2745     end.
     2746     assign
     2747       v-diasize-change-size = false
     2748     .
     2749   end procedure.
     2750   procedure diasize_set-width :
     2751     define input  parameter p-new-width  as decimal   no-undo .
     2752     define input  parameter p-move-resize as logical   no-undo .
     2753     do
     2754     on error undo, return error return-value
     2755     :
     2756       run diasize_change-width in this-procedure
     2757         (input  (p-new-width - frame Dialog-Frame :width)
     2758         ,input  p-move-resize
     2759         ) .
     2760     end.
     2761   end procedure.
     2762   procedure diasize_position-resize-button :
     2763     do with frame Dialog-Frame
     2764     :
     2765       hide v-diasize-resize-button .
     2766       assign
     2767         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2768                     - 1
     2769                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2770         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2771                     - 1
     2772                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2773       .
     2774       view v-diasize-resize-button .
     2775     end.
     2776   end procedure.
     2777   on alt-right anywhere
     2778   do:
     2779     run diasize_change-width in this-procedure
     2780       (input 1
     2781       ,input true
     2782       ) .
     2783     return no-apply .
     2784   end.
     2785   on alt-left anywhere
     2786   do:
     2787     run diasize_change-width in this-procedure
     2788       (input -1
     2789       ,input true
     2790       ) .
     2791     return no-apply .
     2792   end.
     2793   on alt-down anywhere
     2794   do:
     2795     run diasize_change-height in this-procedure
     2796       (input 1
     2797       ,input true
     2798       ) .
     2799     return no-apply .
     2800   end.
     2801   on alt-up anywhere
     2802   do:
     2803     run diasize_change-height in this-procedure
     2804       (input -1
     2805       ,input true
     2806       ) .
     2807     return no-apply .
     2808   end.
     2809   on alt-enter of frame Dialog-Frame
     2810   do:
     2811     run diasize_maximize in this-procedure
     2812       (input  ?
     2813       ).
     2814     return no-apply .
     2815   end.
     2816   procedure diasize_end-move :
     2817     do
     2818     on error undo, return error return-value
     2819     :
     2820       define variable v-row-delta as decimal   no-undo .
     2821       define variable v-col-delta as decimal   no-undo .
     2822       define variable v-new-row as decimal   no-undo .
     2823       define variable v-new-col as decimal   no-undo .
     2824       assign
     2825         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2826         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2827       .
     2828       assign
     2829         v-row-delta = v-new-row - frame Dialog-Frame :height
     2830         v-col-delta = v-new-col - frame Dialog-Frame :width
     2831       .
     2832       run diasize_change-height in this-procedure
     2833         (input v-row-delta
     2834         ,input true
     2835         ) .
     2836       run diasize_change-width in this-procedure
     2837         (input v-col-delta
     2838         ,input true
     2839         ) .
     2840     end.
     2841   end procedure.
     2842   procedure diasize_maximize :
     2843     define input  parameter p-action as logical   no-undo .
     2844     do
     2845     on error undo, return error return-value
     2846     :
     2847       if p-action = ?
     2848       then do:
     2849         if v-diasize-need-maximize = true
     2850         then do:
     2851           assign
     2852             p-action = true
     2853           .
     2854         end.
     2855         else do:
     2856           assign
     2857             p-action = false
     2858           .
     2859         end.
     2860       end.
     2861       if p-action = true
     2862       then do:
     2863         run diasize_change-height in this-procedure
     2864           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2865               - frame Dialog-Frame :height-chars
     2866           ,input true
     2867           ) .
     2868         run diasize_change-width in this-procedure
     2869           (input session :width-chars
     2870               - frame Dialog-Frame :width-chars
     2871           ,input true
     2872           ) .
     2873         assign
     2874           v-diasize-need-maximize = false
     2875         .
     2876       end.
     2877       else do:
     2878         run diasize_change-width in this-procedure
     2879           (input v-diasize-orig-frame-width
     2880               - frame Dialog-Frame :width-chars
     2881           ,input true
     2882           ) .
     2883         run diasize_change-height in this-procedure
     2884           (input v-diasize-orig-frame-height
     2885               - frame Dialog-Frame :height-chars
     2886           ,input true
     2887           ) .
     2888         assign
     2889           v-diasize-need-maximize = true
     2890         .
     2891       end.
     2892     end.
     2893   end procedure.
     2894   procedure diasize_restore-orig-size :
     2895     do
     2896     on error undo, return error return-value
     2897     :
     2898       assign
     2899         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2900         v-diasize-current-frame-height = frame Dialog-Frame :height
     2901       .
     2902       run diasize_set-height in this-procedure
     2903         (input  v-diasize-orig-frame-height
     2904         ,input  true
     2905         ) .
     2906       run diasize_set-width in this-procedure
     2907         (input  v-diasize-orig-frame-width
     2908         ,input  true
     2909         ) .
     2910     end.
     2911   end procedure.
     2912   procedure diasize_restore-current-size :
     2913     do
     2914     on error undo, return error return-value
     2915     :
     2916       run diasize_set-height in this-procedure
     2917         (input  v-diasize-current-frame-height
     2918         ,input  true
     2919         ) .
     2920       run diasize_set-width in this-procedure
     2921         (input  v-diasize-current-frame-width
     2922         ,input  true
     2923         ) .
     2924     end.
     2925   end procedure.
     2926   procedure diasize_set-browse-handle :
     2927     define input  parameter p-browse-handle as handle   no-undo .
     2928     define buffer buf_temp-browse-handle for temp-browse-handle .
     2929     do
     2930     on error undo, return error return-value
     2931     :
     2932       assign
     2933         v-diasize-browse-handle = p-browse-handle
     2934       .
     2935       for each buf_temp-browse-handle
     2936       on error undo, return error return-value
     2937       :
     2938         delete buf_temp-browse-handle .
     2939       end.
     2940     end.
     2941   end procedure.
     2942   procedure diasize_add_browse :
     2943     define input  parameter p-browse-type   as character no-undo .
     2944     define input  parameter p-browse-handle as handle    no-undo .
     2945     define buffer buf_temp-browse-handle for temp-browse-handle .
     2946     do
     2947     on error undo, return error return-value
     2948     :
     2949       assign
     2950         v-diasize-browse-number = v-diasize-browse-number + 1
     2951       .
     2952       create buf_temp-browse-handle .
     2953       assign
     2954         buf_temp-browse-handle.browse-type   = p-browse-type
     2955         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2956         buf_temp-browse-handle.browse-handle = p-browse-handle
     2957       .
     2958     end.
     2959   end procedure.
     2960   procedure diasize_init :
     2961     define variable v-default-value    as logical   no-undo .
     2962     define variable v-restore-saved    as logical   no-undo .
     2963     define variable v-resize-value-str as character no-undo .
     2964     do
     2965     on error undo, return error return-value
     2966     :
     2967       do with frame Dialog-Frame
     2968       :
     2969         assign
     2970           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2971           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2972           v-diasize-browse-handle     = browse BR-wth :handle
     2973         .
     2974         create button v-diasize-resize-button
     2975         assign
     2976           parent        = frame Dialog-Frame :first-child
     2977           label         = "s"
     2978           height-pixels = 16
     2979           width-pixels  = 16
     2980           visible       = true
     2981           sensitive     = true
     2982           movable       = true
     2983           triggers:
     2984             on end-move persistent run diasize_end-move in this-procedure .
     2985           end triggers.
     2986         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2987         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2988         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2989         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2990         assign
     2991           v-diasize-wndmax = false
     2992         .
     2993         if connected("ub") = true
     2994         then do:
     2995           define variable v-cntxt-db-num        as integer   no-undo .
     2996           define variable v-cntxt-userid        as character no-undo .
     2997           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2998                                             , OUTPUT v-cntxt-userid
     2999                                             ) .
     3000           run gbl/wndpar_r.p
     3001             (input  v-cntxt-db-num
     3002             ,input  v-cntxt-userid
     3003             ,input  'wndmax':U
     3004             ,output v-diasize-wndmax
     3005             ,output v-default-value
     3006             ) .
     3007         end.
     3008         assign
     3009           v-diasize-wndstore = false
     3010         .
     3011         if connected("ub") = true
     3012         then do:
     3013           run gbl/wndpar_r.p
     3014             (input  v-cntxt-db-num
     3015             ,input  v-cntxt-userid
     3016             ,input  'wndstore':U
     3017             ,output v-diasize-wndstore
     3018             ,output v-default-value
     3019             ) .
     3020         end.
     3021         assign
     3022           v-diasize-proc-name = entry(1, program-name(2), '.')
     3023         .
     3024         if v-diasize-wndstore = true
     3025         then do:
     3026           assign
     3027             v-restore-saved = false
     3028           .
     3029           if connected("ub") = true
     3030           then do:
     3031             run gbl/wndsizer.p
     3032               (input  v-cntxt-db-num
     3033               ,input  v-cntxt-userid
     3034               ,input  v-diasize-proc-name
     3035               ,input  'height':u
     3036               ,output v-resize-value-str
     3037               ) .
     3038             if v-resize-value-str <> '':U
     3039             then do:
     3040               run diasize_change-height in this-procedure
     3041                 (input  integer(v-resize-value-str)
     3042                 ,input  true
     3043                 ) .
     3044               assign
     3045                 v-restore-saved = true
     3046               .
     3047             end.
     3048           end.
     3049           if connected("ub") = true
     3050           then do:
     3051             run gbl/wndsizer.p
     3052               (input  v-cntxt-db-num
     3053               ,input  v-cntxt-userid
     3054               ,input  v-diasize-proc-name
     3055               ,input  'width':u
     3056               ,output v-resize-value-str
     3057               ) .
     3058             if v-resize-value-str <> '':U
     3059             then do:
     3060               run diasize_change-width in this-procedure
     3061                 (input  integer(v-resize-value-str)
     3062                 ,input  true
     3063                 ) .
     3064               assign
     3065                 v-restore-saved = true
     3066               .
     3067             end.
     3068           end.
     3069           if v-restore-saved <> true
     3070           then do:
     3071             if v-diasize-wndmax = true
     3072             then do:
     3073               run diasize_maximize in this-procedure
     3074                 (input  true
     3075                 ) .
     3076             end.
     3077           end.
     3078         end.
     3079         else do:
     3080           if v-diasize-wndmax = true
     3081           then do:
     3082             run diasize_maximize in this-procedure
     3083               (input  true
     3084               ) .
     3085           end.
     3086         end.
     3087       end.
     3088     end.
     3089   end procedure.
     3090   procedure diasize_need-full-display :
     3091     define output parameter p-need-full-display as logical   no-undo .
     3092     do
     3093     on error undo, return error return-value
     3094     :
     3095       assign
     3096         p-need-full-display = v-diasize-need-full-display
     3097       .
     3098       assign
     3099         v-diasize-need-full-display = false
     3100       .
     3101     end.
     3102   end procedure.
     3103   procedure get-context :
     3104      define output parameter p-db-num as integer          no-undo.
     3105      define output parameter p-user-id as character        no-undo.
     3106      define variable v-login               as character    no-undo.
     3107      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3108      define buffer buf_user-login  for ub.user-login .
     3109      do
     3110      on error undo, return error
     3111      :
     3112            FIND FIRST buf_sys-ctrl no-lock.
     3113            ASSIGN
     3114               v-login = USERID("ub")
     3115               p-db-num = buf_sys-ctrl.db-num
     3116            .
     3117            FIND FIRST buf_user-login
     3118                 WHERE buf_user-login.db-num = p-db-num
     3119                   AND buf_user-login.user-login = v-login
     3120                 no-lock
     3121                 no-error
     3122                 .
     3123            IF AVAILABLE buf_user-login
     3124            THEN DO:
     3125               assign
     3126                  p-user-id = buf_user-login.user-id
     3127               .
     3128            END.
     3129      end.
     3130   end procedure.
