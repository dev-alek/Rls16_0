      401   define  stream PrnLibStream.
      402   procedure prn-lib-prn-file :
      403     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      404     define input parameter p-DIsabledoptions as integer no-undo .
      405     define variable v-report-name as character no-undo .
      406     define variable v-user-action as character no-undo .
      407     define variable v-printed     as logical   no-undo .
      408     define variable v-exist       as logical   no-undo .
      409     do
      410       on error undo, return error
      411       :
      412       run prn-lib-get-report-name  in this-procedure (
      413         input parParentProc
      414         ,output v-report-name
      415         ).
      416   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      417   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      418     (input  v-report-name
      419     ,input  2
      420     ,output v-exist
      421     )  .
      422       if NOT v-exist then
      423       DO:
      424         Message
      425           "Нет заданий на печать ! "
      426           view-as alert-box .
      427         Return  .
      428       End.
      429       run gbl/prnfilen.w
      430         (input  ""
      431         ,input  p-DisabledOptions
      432         ,input  string(v-report-name )
      433         ,input  7
      434         ,output v-user-action
      435         ,output v-printed
      436         ) .
      437       if v-printed then
      438       do:
      439         return "YES" .
      440       end.
      441       else
      442       do:
      443         return "NO" .
      444       end.
      445     end.
      446   end procedure.
      447   procedure prn-lib-open-stream :
      448     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      449     define input parameter p-page-size    as integer no-undo .
      450     define input parameter p-is-stream    as logical no-undo .
      451     define input parameter p-append       as logical no-undo .
      452     define variable v-report-name as character no-undo .
      453     do
      454       on error undo, return error
      455       :
      456       run prn-lib-get-report-name  in this-procedure (
      457         input parParentProc
      458         ,output v-report-name
      459         ).
      460       if p-is-stream then
      461       do:
      462         if p-append then
      463         do:
      464           output stream PrnLibStream to value( v-report-name )
      465             page-size value(p-page-size) append .
      466         end.
      467         if not p-append then
      468         do:
      469           output stream PrnLibStream to value( v-report-name )
      470             page-size value(p-page-size) .
      471         end.
      472       end.
      473       if not p-is-stream then
      474       do:
      475         if p-append then
      476         do:
      477           output to value( v-report-name )
      478             page-size value(p-page-size) append .
      479         end.
      480         if not p-append then
      481         do:
      482           output to value( v-report-name )
      483             page-size value(p-page-size) .
      484         end.
      485       end.
      486     end.
      487   end procedure.
      488   procedure prn-lib-open-exp :
      489     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      490     define input parameter p-is-stream    as logical no-undo .
      491     define input parameter p-is-append    as logical no-undo .
      492     define output parameter p-ReportFileName as char init "report" no-undo.
      493     define output parameter p-process as logical no-undo .
      494     define variable glog as logical no-undo .
      495     do
      496       on error undo, return error
      497       :
      498       SYSTEM-DIALOG GET-FILE p-ReportFileName
      499         TITLE      "Укажите путь"
      500         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      501         ASK-OVERWRITE
      502         CREATE-TEST-FILE
      503         SAVE-AS
      504         USE-FILENAME
      505         DEFAULT-EXTENSION "txt"
      506         UPDATE glog
      507         .
      508       if not glog then  return.
      509       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      510       if p-is-stream then
      511       do:
      512         if p-is-append then
      513         do:
      514           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      515         end.
      516         else
      517         do:
      518           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      519         end.
      520       end.
      521       else
      522       do:
      523         if p-is-append then
      524         do:
      525           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      526         end.
      527         else
      528         do:
      529           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      530         end.
      531       end.
      532       p-process = yes.
      533     end.
      534   end procedure.
      535   procedure prn-lib-get-report-name :
      536     define input parameter parParentProc  as widget-handle no-undo.
      537     define output parameter p-report-name as character no-undo .
      538     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      539   end procedure.
      540   procedure prn-lib-reportviewer-report-name :
      541     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      542     define input parameter p-report-name-html as character no-undo .
      543     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      544   end procedure.
      545   procedure prn-lib-reportviewer :
      546     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      547     define input parameter p-report-name-html as character no-undo .
      548     define input parameter p-param        as character no-undo .
      549     define variable v-excel           as character no-undo init 'TRUE' .
      550     define variable v-value-character as character no-undo .
      551     define variable v-value-integer   as character no-undo .
      552     define variable v-value-date      as date      no-undo .
      553     define variable v-value-decimal   as decimal   no-undo .
      554     define variable rep-excel         as logical   no-undo .
      555     define variable excel-string      as character no-undo .
      556     define variable v-param-type      as character no-undo .
      557     define variable v-tth             as handle    no-undo .
      558     run adm/shattri.p (
      559       input "get":U
      560       ,input  ""
      561       ,input  0
      562       ,input  'report-glob':U
      563       ,input  'rep-excel':U
      564       ,output v-value-character
      565       ,output v-value-date
      566       ,output v-value-decimal
      567       ,output v-value-integer
      568       ,output rep-excel
      569       ,output v-param-type
      570       ,INPUT-OUTPUT table-handle v-tth
      571       )  .
      572     if rep-excel then v-excel = "TRUE" .
      573     else v-excel = "FALSE" .
      574     if p-param eq ""
      575     then
      576        p-param = "EXCEL:" + v-excel.
      577     else
      578        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      579     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      580   end procedure.
      581   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      582   procedure wth-lib_cur-stock-place:
      583   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      584   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      585   define input  parameter parw-p-code like ub.wth-pobj.w-p-code  no-undo.
      586   define input  parameter parwth-code like ub.wth-pobj.wth-code  no-undo.
      587   define output parameter parstock    like ub.wth-pobj.income-pl no-undo.
      588   define buffer bf_wth-pobj for ub.wth-pobj.
      589   find first bf_wth-pobj where bf_wth-pobj.obj-type = parobj-type and
      590                                bf_wth-pobj.obj-code = parobj-code and
      591                                bf_wth-pobj.w-p-code = parw-p-code and
      592                                bf_wth-pobj.wth-code = parwth-code no-lock no-error.
      593   if available bf_wth-pobj then assign parstock = bf_wth-pobj.income-pl - bf_wth-pobj.incass-pl.
      594                            else assign parstock = 0.
      595   end procedure.
      596   procedure wth-lib_cur-stock-obj:
      597   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      598   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      599   define input  parameter parwth-code like ub.wth-obj.wth-code   no-undo.
      600   define output parameter parstock    like ub.wth-obj.income     no-undo.
      601   define buffer bf_wth-obj for ub.wth-obj.
      602   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      603                               bf_wth-obj.obj-code = parobj-code and
      604                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      605   if available bf_wth-obj then assign parstock = bf_wth-obj.income - bf_wth-obj.incass.
      606                           else assign parstock = 0.
      607   end.
      608   FUNCTION wth-lib_cur-stock-obj-func RETURNS DECIMAL (INPUT parobj-type AS CHARACTER,
      609                                                        INPUT parobj-code AS INTEGER,
      610                                                        INPUT parwth-code AS INTEGER):
      611   define buffer bf_wth-obj for ub.wth-obj.
      612   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      613                               bf_wth-obj.obj-code = parobj-code and
      614                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      615   if available bf_wth-obj then return (bf_wth-obj.income - bf_wth-obj.incass).
      616                           else return 0.00.
      617   end function.
      618   FUNCTION wth-lib_cur-stock-host-func RETURNS DECIMAL (INPUT parhost-code AS INTEGER,
      619                                                         INPUT parwth-code  AS INTEGER):
      620   define buffer bf_wth-obj for ub.wth-obj.
      621   define variable v-stock like ub.wth-obj.income no-undo.
      622   for each bf_wth-obj no-lock where bf_wth-obj.host-code = parhost-code and
      623                                     bf_wth-obj.wth-code = parwth-code :
      624     v-stock = v-stock +  bf_wth-obj.income - bf_wth-obj.incass.
      625   end.
      626   return v-stock.
      627   end function.
      628   procedure wth-lib_full-inf-shift:
      629   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.shift-date = parshift-date and                        cur_wth-line.shift-num  = parshift-num  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-sdn no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                (start_wth-line.shift-date = parshift-date and                           start_wth-line.shift-num  < parshift-num  or                            start_wth-line.shift-date < parshift-date ) and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-sdn no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      630   end procedure.
      631   procedure wth-lib_full-inf-shift-inter:
      632   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                        define input  parameter parshift-date1  like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num1   like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        ((cur_wth-line.shift-date = parshift-date1 and                           cur_wth-line.shift-num  <= parshift-num1)  or                            cur_wth-line.shift-date < parshift-date1 ) and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-sdn no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                (start_wth-line.shift-date = parshift-date and                           start_wth-line.shift-num  < parshift-num  or                            start_wth-line.shift-date < parshift-date ) and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-sdn no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      633   end procedure.
      634   procedure wth-lib_full-inf-shift-period-place:
      635   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parw-p-code     like ub.wth-pobj.w-p-code  no-undo.                        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                        define input  parameter parshift-date1  like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num1   like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                        cur_wth-line.w-p-code = parw-p-code and                                                               cur_wth-line.wth-code   = parwth-code   and                                        ((cur_wth-line.shift-date = parshift-date1 and                           cur_wth-line.shift-num  <= parshift-num1)  or                            cur_wth-line.shift-date < parshift-date1 ) and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-sdn no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                start_wth-line.w-p-code = parw-p-code and                                                             start_wth-line.wth-code   = parwth-code         and                                (start_wth-line.shift-date = parshift-date and                           start_wth-line.shift-num  < parshift-num  or                            start_wth-line.shift-date < parshift-date ) and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-sdn no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income-pl - cur_wth-line.incass-pl              parincome        = cur_wth-line.income-pl                     parincome-cassa  = cur_wth-line.income-cassa-pl               parincome-other  = cur_wth-line.income-other-pl               parincass        = cur_wth-line.incass-pl                     parincass-bank   = cur_wth-line.incass-bank-pl                parincass-other  = cur_wth-line.incass-other-pl.              parincass-cassa  = cur_wth-line.incass-cassa-pl.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income-pl     - start_wth-line.incass-pl               parstock-end     = cur_wth-line.income-pl       - cur_wth-line.incass-pl                 parincome        = cur_wth-line.income-pl       - start_wth-line.income-pl               parincome-cassa  = cur_wth-line.income-cassa-pl - start_wth-line.income-cassa-pl         parincome-other  = cur_wth-line.income-other-pl - start_wth-line.income-other-pl         parincass        = cur_wth-line.incass-pl       - start_wth-line.incass-pl               parincass-bank   = cur_wth-line.incass-bank-pl  - start_wth-line.incass-bank-pl          parincass-other  = cur_wth-line.incass-other-pl - start_wth-line.incass-other-pl.        parincass-cassa  = cur_wth-line.incass-cassa-pl - start_wth-line.incass-cassa-pl.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income-pl - start_wth-line.incass-pl                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
