     1199   procedure uf-get :
     1200     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1201     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1202     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1203     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1204     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1205     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1206     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1207     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1208     do
     1209     on error undo, return error
     1210     :
     1211       define buffer buf_usr-flt for ubflt.usr-flt .
     1212       define variable v-use-List_     as logical   no-undo .
     1213       define variable v-type-List_     as character no-undo .
     1214       define variable v-format-List_   as character no-undo .
     1215       define variable v-use-Naim      as logical   no-undo .
     1216       define variable v-type-Naim      as character no-undo .
     1217       define variable v-format-Naim    as character no-undo .
     1218       define variable v-use-print-graft as logical   no-undo .
     1219       define variable v-use-sort-gr     as logical   no-undo .
     1220       define variable v-use-type-price  as logical   no-undo .
     1221       define variable v-use-type-val    as logical   no-undo .
     1222       define variable v-label          as character no-undo .
     1223       define variable v-tooltip        as character no-undo .
     1224       define variable v-user-can-edit  as logical   no-undo .
     1225       define variable v-output-display as logical   no-undo .
     1226       define variable v-other          as character no-undo .
     1227       run uf-name in this-procedure
     1228          (input  entry(1, p-code, chr(4))
     1229         ,output v-use-List_
     1230         ,output v-type-List_
     1231         ,output v-format-List_
     1232         ,output v-use-Naim
     1233         ,output v-type-Naim
     1234         ,output v-format-Naim
     1235         ,output v-use-print-graft
     1236         ,output v-use-sort-gr
     1237         ,output v-use-type-price
     1238         ,output v-use-type-val
     1239         ,output v-label
     1240         ,output v-tooltip
     1241         ,output v-user-can-edit
     1242         ,output v-output-display
     1243         ,output v-other
     1244         ) no-error .
     1245       if error-status :error then do:
     1246         undo, return error return-value .
     1247       end.
     1248       find first buf_usr-flt no-lock where
     1249                  buf_usr-flt.Call-point     = p-code AND
     1250                  buf_usr-flt.user-name       = p-user-name
     1251         no-error .
     1252       if avail buf_usr-flt then do:
     1253         assign
     1254         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1255         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1256         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1257         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1258         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1259         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1260         .
     1261       end.
     1262       else do:
     1263         assign
     1264         p-List_        = (if v-use-List_       then "":U                    else ?)
     1265         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1266         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1267         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1268         p-type-price   = (if v-use-type-price  then no                      else ?)
     1269         p-type-val     = (if v-use-List_       then no                      else ?)
     1270         .
     1271       end.
     1272     end.
     1273   end procedure.
     1274   procedure uf-set :
     1275     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1276     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1277     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1278     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1279     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1280     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1281     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1282     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1283     do
     1284     on error undo, return error
     1285     :
     1286       define buffer buf_usr-flt for ubflt.usr-flt .
     1287       define variable v-use-List_     as logical   no-undo .
     1288       define variable v-type-List_     as character no-undo .
     1289       define variable v-format-List_   as character no-undo .
     1290       define variable v-use-Naim      as logical   no-undo .
     1291       define variable v-type-Naim      as character no-undo .
     1292       define variable v-format-Naim    as character no-undo .
     1293       define variable v-use-print-graft as logical   no-undo .
     1294       define variable v-use-sort-gr   as logical   no-undo .
     1295       define variable v-use-type-price as logical   no-undo .
     1296       define variable v-use-type-val  as logical   no-undo .
     1297       define variable v-tooltip        as character no-undo .
     1298       define variable v-label          as character no-undo .
     1299       define variable v-user-can-edit  as logical   no-undo .
     1300       define variable v-output-display as logical   no-undo .
     1301       define variable v-other          as character no-undo .
     1302       run uf-name in this-procedure
     1303         (input  entry(1, p-code, chr(4))
     1304         ,output v-use-List_
     1305         ,output v-type-List_
     1306         ,output v-format-List_
     1307         ,output v-use-Naim
     1308         ,output v-type-Naim
     1309         ,output v-format-Naim
     1310         ,output v-use-print-graft
     1311         ,output v-use-sort-gr
     1312         ,output v-use-type-price
     1313         ,output v-use-type-val
     1314         ,output v-label
     1315         ,output v-tooltip
     1316         ,output v-user-can-edit
     1317         ,output v-output-display
     1318         ,output v-other
     1319         ) no-error .
     1320       if error-status :error then do:
     1321         undo, return error return-value .
     1322       end.
     1323       find first buf_usr-flt where
     1324                  buf_usr-flt.Call-point     = p-code AND
     1325                  buf_usr-flt.user-name       = p-user-name
     1326         no-error .
     1327       if not avail buf_usr-flt then do:
     1328           create buf_usr-flt .
     1329           assign
     1330           buf_usr-flt.call-point = p-code
     1331           buf_usr-flt.user-name  = p-user-name
     1332           .
     1333       end.
     1334       if avail buf_usr-flt then do:
     1335        assign
     1336        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1337        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1338        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1339        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1340        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1341        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1342       .
     1343       release buf_usr-flt.
     1344       end.
     1345       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1346     end.
     1347   end procedure.
     1348   define variable filter-label as character no-undo init "Материальные_ценности" .
     1349   define variable filter-label0 as character no-undo init "Материальные_ценности" .
     1350   define variable filter-point as character no-undo init "wth-ref" .
     1351   define variable filter-point0 as character no-undo init "wth-ref" .
     1352   define variable sort-column-name as character no-undo .
     1353   define variable ri          as      recid   no-undo     init ? .
     1354   define variable choice as log no-undo.
     1355   define variable mark as char no-undo.
     1356   define variable print-option as char no-undo.
     1357   define variable varwth-obj as decimal no-undo.
     1358   define variable v-doc-rec as recid no-undo .
     1359   define variable ser-wth  as logical   no-undo.
     1360   define variable conf-par as character no-undo.
     1361   define variable par-type as character no-undo.
     1362   define variable v-rid-list as character no-undo .
