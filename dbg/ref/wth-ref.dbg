      650   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input parameter parw-p-code  like ub.wth-line.w-p-code  no-undo.                        define input parameter parfact-date like ub.wth-line.fact-date no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                        cur_wth-line.w-p-code   = parw-p-code and                                                               cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.fact-date  = parfact-date  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-cld-pl no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                start_wth-line.w-p-code = parw-p-code and                                                             start_wth-line.wth-code   = parwth-code         and                                start_wth-line.fact-date  < parfact-date   and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-cld-pl no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income-pl - cur_wth-line.incass-pl              parincome        = cur_wth-line.income-pl                     parincome-cassa  = cur_wth-line.income-cassa-pl               parincome-other  = cur_wth-line.income-other-pl               parincass        = cur_wth-line.incass-pl                     parincass-bank   = cur_wth-line.incass-bank-pl                parincass-other  = cur_wth-line.incass-other-pl.              parincass-cassa  = cur_wth-line.incass-cassa-pl.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income-pl     - start_wth-line.incass-pl               parstock-end     = cur_wth-line.income-pl       - cur_wth-line.incass-pl                 parincome        = cur_wth-line.income-pl       - start_wth-line.income-pl               parincome-cassa  = cur_wth-line.income-cassa-pl - start_wth-line.income-cassa-pl         parincome-other  = cur_wth-line.income-other-pl - start_wth-line.income-other-pl         parincass        = cur_wth-line.incass-pl       - start_wth-line.incass-pl               parincass-bank   = cur_wth-line.incass-bank-pl  - start_wth-line.incass-bank-pl          parincass-other  = cur_wth-line.incass-other-pl - start_wth-line.incass-other-pl.        parincass-cassa  = cur_wth-line.incass-cassa-pl - start_wth-line.incass-cassa-pl.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income-pl - start_wth-line.incass-pl                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      651   end procedure.
      652   FUNCTION get-curr RETURNS CHARACTER
      653     (buffer loc-wealth for ub.wealth ) :
      654   define buffer buf_currency for ub.currency.
      655   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
      656   return loc-wealth.unit-base.
      657   FIND FIRST buf_currency no-lock where
      658             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
      659   if avail buf_currency then
      660     RETURN buf_currency.curr-abbr.
      661   else return "".
      662   END FUNCTION.
      663   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      664   define variable v-waitfram-action01         as character   no-undo .
      665   define variable v-waitfram-action02         as character   no-undo .
      666   define variable v-waitfram-action03         as character   no-undo .
      667   define variable mWaitFramTextBeg            as character   no-undo.
      668   define variable mWaitFramTextEnd            as character   no-undo.
      669   define variable mWaitFramView               as logical     no-undo.
      670   define variable mWaitProcEvent              as logical     no-undo init yes.
      671   define variable mWaitFramInterval           as integer     no-undo init 1 .
      672   define variable mWaitFramStop               as logical     no-undo.
      673   define variable mWaitFramStopUser           as logical     no-undo.
      674   define variable mWaitFramStopTimeOut        as logical     no-undo.
      675   define variable mWaitFramStartProc          as datetime-tz no-undo.
      676   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      677   define button B-WaitFramStop auto-end-key
      678        label "Стоп"
      679        size 10 by 1 tooltip "Остоновить процесс".
      680   define button B-viewProcInfo
      681        label "Информация"
      682        size 15 by 1 tooltip "Информация о процесс".
      683   define frame waitfram
      684     v-waitfram-action01 format "x(72)" no-label skip
      685     v-waitfram-action02 format "x(72)" no-label skip
      686     v-waitfram-action03 format "x(72)" no-label skip
      687     B-viewProcInfo
      688     B-WaitFramStop at row 4 col 30
      689     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      690     .
      691   define new global shared variable mBatchMode as logical no-undo init ?.
      692   define variable mFramBachModHandle as handle no-undo.
      693   mFramBachModHandle = frame waitfram:handle.
      694   define variable mFameOldVis as logical no-undo.
      695   define variable mVisCUrentVin as logical no-undo.
      696   if session:batch-mode
      697   then
      698      mBatchMode = yes.
      699   if mBatchMode = ? then do:
      700     mVisCUrentVin = current-window:visible.
      701     mFameOldVis = mFramBachModHandle:visible.
      702     mFramBachModHandle:visible  = yes.
      703     mBatchMode = mFramBachModHandle:visible ne yes.
      704     mFramBachModHandle:visible = mFameOldVis.
      705     current-window:visible = mVisCUrentVin.
      706   end.
      707    if  log-manager:logfile-name ne ?
      708     then DO:
      709         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      710         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      711         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      712     end.
      713   on choose of B-WaitFramStop in frame waitfram
      714   do:
      715     mWaitFramStop = yes.
      716     mWaitFramStopUser = yes.
      717   end.
      718   function waitfram-check-timeout returns logical():
      719      define variable vtime as int64 no-undo.
      720      if mWaitFramStopTimeOut
      721      then
      722         return yes.
      723      vtime = ( now - mWaitFramStartProc ) / 1000 .
      724      if     mWaitFramTimeOut ne ?
      725         and mWaitFramTimeOut ne 0
      726         and mWaitFramTimeOut lt vtime
      727      then do:
      728         mWaitFramStopTimeOut = yes.
      729      end.
      730      return mWaitFramStopTimeOut.
      731   end.
      732   procedure waitfram-hide :
      733     if not session:batch-mode
      734     then do
      735     on error undo, return error return-value
      736     :
      737       pause 0 before-hide .
      738       if not mBatchMode then
      739         hide frame waitfram .
      740     if     not mWaitFramView
      741        and mWaitProcEvent
      742     then
      743       process events .
      744     end.
      745   end procedure.
      746   procedure waitfram-show :
      747     define input  parameter p-message as character no-undo .
      748     define variable v-left-margin as integer   no-undo .
      749     if not session:batch-mode
      750     then do
      751     on error undo, return error return-value
      752     :
      753       if length(p-message) <= 70 then do:
      754         assign
      755           v-left-margin = integer((70 - length(p-message)) / 2)
      756         .
      757         assign
      758           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      759         .
      760         assign
      761           v-waitfram-action01 = " "
      762           v-waitfram-action02 = " "
      763                                    + fill(" ", v-left-margin)
      764                                    + p-message
      765           v-waitfram-action03 = " "
      766         .
      767       end.
      768       else do:
      769         define variable vRindex1 as integer no-undo.
      770         define variable vRindex2 as integer no-undo.
      771         vRindex1 = r-index(p-message," ",70).
      772         if vRindex1 = 0
      773         then
      774            vRindex1 = 70.
      775         if length(p-message)  <= vRindex1 + 70 then do:
      776           assign
      777             v-waitfram-action01 = " "
      778             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      779             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      780           .
      781         end.
      782         else do:
      783           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      784           if vRindex2 <= vRindex1
      785           then
      786              vRindex2 = vRindex1 + 70.
      787           assign
      788             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      789             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      790             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      791           .
      792         end.
      793       end.
      794       B-viewProcInfo:visible   in frame waitfram = no.
      795       B-viewProcInfo:sensitive in frame waitfram = no.
      796       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      797       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      798       if  (   mWaitFramView
      799          or  mWaitProcEvent)
      800          and not mBatchMode
      801       then
      802          display
      803             v-waitfram-action01 skip
      804             v-waitfram-action02 skip
      805             v-waitfram-action03 skip
      806          with frame waitfram .
      807       if     mWaitFramView
      808          then do:
      809             if     mWaitFramInterval ne ?
      810                and not mBatchMode
      811             then
      812                wait-for go of frame waitfram pause mWaitFramInterval.
      813          end.
      814          else
      815             if     mWaitProcEvent
      816                and not mBatchMode
      817             then
      818                process events .
      819     end.
      820   end procedure.
      821      procedure waitfram-show-this:
      822         define input  parameter iInterval as int64 no-undo.
      823         define variable vtime as int64 no-undo.
      824         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      825         mWaitFramInterval = iInterval.
      826         run waitfram-show (substitute("&1&2 &3&4" ,
      827                                       mWaitFramTextBeg ,
      828                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      829                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      830                                       mWaitFramTextEnd
      831                                      )
      832                           ).
      833      end.
      834      procedure WaitFramRunPause:
      835         define input  parameter iInterval as dec no-undo.
      836         define variable vStart  as datetime-tz no-undo.
      837         define variable vend    as datetime-tz no-undo.
      838         define variable vint as int64 no-undo.
      839         define variable vOk as logical no-undo.
      840         vStart = now.
      841         vend   = vStart.
      842         publish "WaitFramPause" (iInterval,output vOk).
      843         vend   =  now.
      844         vint = vend - vStart.
      845         vint = iInterval - vint / 1000.
      846         if     not mWaitFramStop
      847            and (   vint > 0
      848                 or (    not vOk
      849                     and iInterval eq ?
      850                     )
      851                 )
      852         then
      853            run waitfram-show-this (iInterval).
      854         vend   =  now.
      855         vint = vend - vStart.
      856         vint = iInterval - vint / 1000.
      857         if     not mWaitFramStop
      858            and vint > 0
      859         then do:
      860            run gbl/pause.p (vint * 1000).
      861         end.
      862         if iInterval ne ?
      863         then
      864            publish "WaitFramStop".
      865         waitfram-check-timeout().
      866      end.
      867      procedure WaitFramWaitFor:
      868         define input  parameter iInterval as dec no-undo.
      869         assign
      870            mWaitFramStartProc   = now
      871            mWaitFramStopUser    = no
      872            mWaitFramStopTimeOut = no
      873         .
      874         block-wait:
      875         do while not mWaitFramStop:
      876            run WaitFramRunPause (iInterval).
      877            if  waitfram-check-timeout()
      878            then do:
      879               leave block-wait.
      880            end.
      881         end.
      882         run waitfram-hide.
      883      end.
      884   procedure waitfram-join :
      885     define input  parameter p-line-1  as character no-undo .
      886     define input  parameter p-line-2  as character no-undo .
      887     define input  parameter p-line-3  as character no-undo .
      888     define output parameter p-message as character no-undo .
      889     do
      890     on error undo, return error return-value
      891     :
      892       assign
      893         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      894                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      895                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      896       .
      897     end.
      898   end procedure.
      899   function waitfram-join-function returns character
      900     (input p-line-1 as character
      901     ,input p-line-2 as character
      902     ,input p-line-3 as character
      903     ).
      904     define variable v-message as character no-undo .
      905     run waitfram-join in this-procedure
      906       (input  p-line-1
      907       ,input  p-line-2
      908       ,input  p-line-3
      909       ,output v-message
      910       ) .
      911     return v-message .
      912   end function .
      913   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      914     define variable v-cntxt-db-num        as integer   no-undo .
      915     define variable v-cntxt-userid        as character no-undo .
      916     define variable v-cntxt-level         as character no-undo .
      917     define variable v-cntxt-host-code-obj as integer   no-undo .
      918     define variable v-cntxt-obj-type      as character no-undo .
      919     define variable v-cntxt-obj-code      as integer   no-undo .
      920     define variable v-cntxt-db-num-obj    as integer   no-undo .
      921     define variable v-cntxt-is-admin      as logical   no-undo .
      922   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      923   FUNCTION mark-string RETURNS CHARACTER
      924     ( input p-recid as recid, input mark-list as character  ) :
      925     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      926   END FUNCTION.
      927   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      928   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      929   procedure fltopend_fltopend :
      930   define input parameter p-parent-handle as handle no-undo .
      931   define input parameter p-qh as handle no-undo .
      932   define input parameter p-flt-open-open-query  as character no-undo .
      933   define input parameter p-where-cond as character no-undo .
      934   define input parameter p-use-indFIRST-query-tail as character no-undo .
      935   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      936   define input parameter p-indexed-reposition as character no-undo .
      937     do
      938     on error undo, return error
      939     :
      940   define variable v-prepare-string as character no-undo .
      941   define variable glog as logical no-undo .
      942   assign
      943   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      944                      p-where-cond + chr(32)  +
      945                      p-use-indFIRST-query-tail + chr(32) +
      946                      p-use-ind-sort-clmn-by + chr(32) +
      947                      p-indexed-reposition
      948   .
      949   assign
      950   glog = p-qh:query-prepare(v-prepare-string) no-error .
      951   if not glog
      952   or error-status:error then do:
      953     message error-status:get-message(1) view-as alert-box .
      954     undo, return error .
      955   end.
      956   assign
      957   glog = p-qh:query-open no-error .
      958   if not glog
      959   or error-status:error then do:
      960     message error-status:get-message(1) view-as alert-box .
      961     undo, return error .
      962   end.
      963     end.
      964   end procedure.
      965   procedure fltopend_fltfindd :
      966   define input parameter p-parent-handle as handle no-undo .
      967   define input parameter p-qh as handle no-undo .
      968   define input parameter p-rowid as rowid no-undo .
      969   define input parameter p-next as logical no-undo .
      970   define input parameter p-lock as integer no-undo .
      971   define input parameter p-bh as handle no-undo .
      972   define input parameter p-where-cond as character no-undo .
      973   define input parameter p-use-index-phrase as character no-undo .
      974   define variable glog as logical no-undo .
      975   define variable v-qh as handle no-undo .
      976   define variable v-bh as handle no-undo .
      977   define variable v-recid as recid no-undo .
      978   define variable v-prepare-string as character no-undo .
      979   do
      980   on error undo, return error
      981   on stop undo, return error
      982   :
      983     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      984     create buffer v-bh for table p-bh buffer-name p-bh:name.
      985     create query v-qh.
      986     v-qh:set-buffers(v-bh).
      987     v-prepare-string = substitute("for each &1 &2 &3"
      988                                     ,v-bh:name
      989                                     ,p-where-cond
      990                                     ,p-use-index-phrase).
      991     glog = v-qh:query-prepare(v-prepare-string) no-error.
      992     if not glog then do:
      993       delete object v-qh.
      994       delete object v-bh.
      995       undo, return error .
      996     end.
      997     glog = v-qh:query-open no-error .
      998     if not glog then do:
      999       delete object v-qh.
     1000       delete object v-bh.
     1001       undo, return error .
     1002     end.
     1003     if p-next then do:
     1004       v-qh:reposition-to-rowid(p-rowid) no-error .
     1005       glog = v-qh:get-next( p-lock) no-error .
     1006       glog = v-qh:get-next( p-lock) no-error .
     1007       if not glog or v-qh:query-off-end = yes then do:
     1008         glog = v-qh:get-first( p-lock) no-error .
     1009       end.
     1010     end.
     1011     else do:
     1012       glog = v-qh:get-first( p-lock) no-error .
     1013     end.
     1014     v-recid = v-bh:recid no-error .
     1015     delete object v-qh.
     1016     delete object v-bh.
     1017     return string(v-recid) .
     1018   end.
     1019   end procedure.
     1020   procedure fltopend_fltfindq :
     1021   define input parameter p-parent-handle as handle no-undo .
     1022   define input parameter p-qh as handle no-undo .
     1023   define input parameter p-next as logical no-undo .
     1024   define input parameter p-lock as integer no-undo .
     1025   define input parameter p-flt-open-open-query  as character no-undo .
     1026   define input parameter p-where-cond as character no-undo .
     1027   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1028   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1029   define input parameter p-indexed-reposition as character no-undo .
     1030   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1031   define variable glog as logical no-undo .
     1032   define variable v-qh as handle no-undo .
     1033   define variable v-bh as handle no-undo extent 18.
     1034   define variable v-rowid as rowid no-undo extent 18.
     1035   define variable v-ii as integer no-undo .
     1036   define variable v-prepare-string as character no-undo .
     1037   do
     1038   on error undo, return error
     1039   on stop undo, return error
     1040   :
     1041     create query v-qh.
     1042     do v-ii = 1 to p-qh:num-buffers:
     1043       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1044       assign
     1045       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1046       no-error.
     1047       v-qh:add-buffer(v-bh[v-ii]).
     1048     end.
     1049     assign
     1050     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1051                       p-where-cond + chr(32)  +
     1052                       p-use-indFIRST-query-tail + chr(32) +
     1053                       p-use-ind-sort-clmn-by + chr(32) +
     1054                       p-indexed-reposition
     1055     .
     1056     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1057     if not glog then do:
     1058       delete object v-qh.
     1059       do v-ii = 1 to p-qh:num-buffers:
     1060         delete object v-bh[v-ii].
     1061       end.
     1062       undo, return error .
     1063     end.
     1064     glog = v-qh:query-open no-error .
     1065     if not glog then do:
     1066       delete object v-qh.
     1067       do v-ii = 1 to p-qh:num-buffers:
     1068         delete object v-bh[v-ii].
     1069       end.
     1070       undo, return error .
     1071     end.
     1072     if p-next then do:
     1073       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1074       glog = v-qh:get-next( p-lock) no-error .
     1075       glog = v-qh:get-next( p-lock) no-error .
     1076       if not glog or v-qh:query-off-end = yes then do:
     1077         glog = v-qh:get-first( p-lock) no-error .
     1078       end.
     1079     end.
     1080     else do:
     1081       glog = v-qh:get-first( p-lock) no-error .
     1082     end.
     1083     do v-ii = 1 to p-qh:num-buffers:
     1084       assign
     1085       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1086       no-error.
     1087     end.
     1088     delete object v-qh.
     1089     do v-ii = 1 to p-qh:num-buffers:
     1090       delete object v-bh[v-ii].
     1091     end.
     1092   end.
     1093   end procedure.
     1094   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1095   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
     1096   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
     1097   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1098   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1099   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
     1100   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
     1101   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
     1102   procedure uf-name :
     1103     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1104     define output parameter p-use-List_     as logical   no-undo .
     1105     define output parameter p-type-List_     as character no-undo .
     1106     define output parameter p-format-List_   as character no-undo .
     1107     define output parameter p-use-Naim      as logical   no-undo .
     1108     define output parameter p-type-Naim      as character no-undo .
     1109     define output parameter p-format-Naim    as character no-undo .
     1110     define output parameter p-use-print-graft as logical   no-undo .
     1111     define output parameter p-use-sort-gr   as logical   no-undo .
     1112     define output parameter p-use-type-price as logical   no-undo .
     1113     define output parameter p-use-type-val  as logical   no-undo .
     1114     define output parameter p-label          as character no-undo .
     1115     define output parameter p-tooltip        as character no-undo .
     1116     define output parameter p-user-can-edit  as logical   no-undo .
     1117     define output parameter p-output-display as logical   no-undo .
     1118     define output parameter p-other          as character no-undo .
     1119     do
     1120     on error undo, return error
     1121     :
     1122       case p-code :
     1123               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1124               when 'oldscode':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника неиспользуемых весовых кодов"     p-tooltip = "Настройки справочника неиспользуемых весовых кодов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1125               when 'gds-ref-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(8)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = yes      p-label = "Параметры вызова справочника товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1126               when 'gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1127               when 'fbr-gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп блюд"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп блюд"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1128               when 'cli-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1129               when 'findoci-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова карточки платежа"     p-tooltip = "Параметры по умолчанию, используемые для вызова карточки платежа"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1130               when 'findocs-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника платежей"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника платежей"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1131               when 'fin-obi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова карточки платежа"     p-tooltip = "Параметры по умолчанию, используемые для вызова карточки платежа"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1132               when 'seqeallo':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Порядок колонок в АВТО-ЗАКАЗЕ"     p-tooltip = "Порядок колонок в РАСЧЕТЕ потребности заказа и его импорте"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
     1133               when 'skm-rep':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова выгрузки файла данных по продажам по СКМ"     p-tooltip = "Параметры по умолчанию, используемые для вызова выгрузки файла данных по продажам по СКМ"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
