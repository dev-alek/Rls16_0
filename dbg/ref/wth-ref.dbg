     3607           (
     3608             if (" X_wealth.is-ser = 0 and (if rsfl-par = 3 then true else x_wealth.stts = rsfl-par)  " + " " + where-phrase-37) <> ""
     3609             then  substitute('X_wealth.is-ser = 0 and (if &1 = 3 then true else x_wealth.stts = &1)  ', rsfl-par) + " " + where-phrase-37
     3610             else "true"
     3611           )
     3612         parameter-5-37 = (" " + "" + " " + "")
     3613         parameter-6-37 = if sort-phrase-37 = ''
     3614                              then
     3615           (
     3616           " " + "  " +
     3617             " " + sort-column-phrase +
     3618           " " + " by X_wealth.wth-code "
     3619           )
     3620                              else
     3621           (
     3622           " " + "  " +
     3623             " " + sort-column-phrase +
     3624           " " + sort-phrase-37
     3625           )
     3626         parameter-7-37 =
     3627           "   "
     3628       .
     3629       do
     3630       on stop undo, leave
     3631       on error undo, leave
     3632       :
     3633         assign
     3634           l-disable-where-37 =
     3635             (" X_wealth.is-ser = 0 and (if rsfl-par = 3 then true else x_wealth.stts = rsfl-par)  " + " " + where-phrase-37 = "")
     3636         .
     3637         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3638                             ,input QUERY br-wth:handle
     3639                             ,input parameter-3-37
     3640                             ,input parameter-4-37
     3641                             ,input parameter-5-37
     3642                             ,input parameter-6-37
     3643                             ,input parameter-7-37
     3644                             )
     3645         .
     3646         assign
     3647           l-filter-open-37 = true
     3648         .
     3649       end.
     3650       if l-filter-open-37 = false then do:
     3651         message
     3652           "Ошибка при фильтрации / сортировке" skip
     3653           "Будут показаны записи без учета фильтра" skip
     3654           view-as alert-box .
     3655       end.
     3656       else do:
     3657           assign
     3658             l-query-was-opened = true
     3659           .
     3660       end.
     3661     end.
     3662     if l-filter-open-37 = false then do:
     3663       OPEN QUERY br-wth FOR EACH X_wealth
     3664         where  X_wealth.is-ser = 0 and (if rsfl-par = 3 then true else x_wealth.stts = rsfl-par)
     3665          by X_wealth.wth-code
     3666     .
     3667         assign
     3668           l-query-was-opened = true
     3669         .
     3670     end.
     3671     run waitfram-hide in this-procedure .
     3672       end.
     3673   END CASE.
     3674   if v-doc-rec <> ? then reposition br-wth to recid v-doc-rec no-error.
     3675   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3676   query br-wth:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3677   if error-status:error then do:
     3678     reposition br-wth to row 1 no-error.
     3679   end.
     3680   apply "entry" to br-wth in frame Dialog-Frame.
     3681   if avail X_wealth then
     3682   APPLY "VALUE-CHANGED":U to br-wth.
     3683   END PROCEDURE.
     3684   PROCEDURE PrintProc :
     3685   define variable date_string     as      char    no-undo.
     3686   define variable Line                as      char    no-undo.
     3687   define variable for-time as char.
     3688   define variable var-on-obj as decimal no-undo.
     3689   DEFINE FRAME Wth-List
     3690   X_wealth.wth-code     column-label "Код"
     3691   X_wealth.wth-name     column-label "Название"
     3692   X_wealth.is-money     column-label "Денежн.!эквив."
     3693   X_wealth.curr-code    column-label "Код!валюты"
     3694   X_wealth.unit-base    column-label "Валюта/!Ед.изм."
     3695   var-on-obj          column-label "Остаток!на объекте" format "->>>,>>>,>>9.99"
     3696   HEADER  date_string AT 5 format "X(35)"
     3697   string( "Страница " ) format "X(9)" AT 100 PAGE-NUMBER(PrnLibStream) AT 110 FORMAT ">>9" SKIP
     3698   Line format "X(138)" AT 1
     3699   with width 160 down stream-io use-text    .
     3700   Line = fill("-", 70).
     3701   date_string = cur-time-print() .
     3702   run prn-lib-open-stream  in this-procedure (
     3703                                                input parParentProc
     3704                                               ,input 62
     3705                                               ,input yes
     3706                                               ,input no
     3707                                               ).
     3708       PUT  STREAM PrnLibStream
     3709       SPACE(25) ( frame Dialog-Frame:title )
     3710       format "x(90)" SKIP(1) .
     3711       FORM HEADER
     3712       Line AT 1 SKIP
     3713       "Продолжение - на следующей странице" AT 30 SKIP
     3714       with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
     3715       VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3716       FORM with FRAME Wth-List  .
     3717       run waitfram-show in this-procedure ("Ждите...").
     3718       GET next br-wth.
     3719        DO WHILE available X_wealth :
     3720           var-on-obj = wth-lib_cur-stock-obj-func(p-curr-obj-type,p-curr-obj-code, X_wealth.wth-code).
     3721           Display STREAM PrnLibStream
     3722           X_wealth.wth-code
     3723           X_wealth.wth-name
     3724           X_wealth.is-money
     3725           X_wealth.curr-code
     3726           X_wealth.unit-base
     3727           var-on-obj
     3728           with FRAME Wth-List .
     3729           DOWN STREAM PrnLibStream 1 with FRAME Wth-List  .
     3730           GET next br-wth.
     3731         END.
     3732         UNDERLINE  STREAM PrnLibStream
     3733           X_wealth.wth-code
     3734           X_wealth.wth-name
     3735           X_wealth.is-money
     3736           X_wealth.curr-code
     3737           X_wealth.unit-base
     3738           var-on-obj
     3739           with FRAME Wth-List .
     3740       HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3741       HIDE  STREAM PrnLibStream FRAME CheckList.
     3742       output  STREAM PrnLibStream CLOSE.
     3743       run waitfram-hide in this-procedure .
     3744   run prn-lib-prn-file in this-procedure (
     3745                                             input parParentProc
     3746                                             ,input 0
     3747                                             ).
     3748   END PROCEDURE.
     3749   PROCEDURE PrintProcpar :
     3750   define variable date_string     as      char    no-undo.
     3751   define variable Line                as      char    no-undo.
     3752   define variable for-time as char.
     3753   define variable var-on-obj as decimal no-undo.
     3754   define buffer buf_wth-par for ub.wth-par.
     3755   DEFINE FRAME Wth-List
     3756   X_wealth.wth-code     column-label "Код"
     3757   X_wealth.wth-name     column-label "Название"
     3758   X_wealth.is-money     column-label "Денежн.!эквив."
     3759   X_wealth.curr-code    column-label "Код!валюты"
     3760   X_wealth.unit-base    column-label "Валюта/!Ед.изм."
     3761   var-on-obj          column-label "Остаток!на объекте" format "->>>,>>>,>>9.99"
     3762   buf_wth-par.par-code     column-label "Код!номинала"
     3763   buf_wth-par.par-val     column-label "Номинал"
     3764   buf_wth-par.par-unit     column-label "Ед.изм.!номинала"
     3765   buf_wth-par.par-rate     column-label "Коэфф."
     3766   buf_wth-par.par-feat     column-label "Доп. признак"
     3767   HEADER  date_string AT 5 format "X(35)"
     3768   string( "Страница " ) format "X(9)" AT 100 PAGE-NUMBER(PrnLibStream) AT 110 FORMAT ">>9" SKIP
     3769   Line format "X(138)" AT 1
     3770   with width 160 down stream-io use-text    .
     3771   Line = fill("-", 122).
     3772   date_string = cur-time-print() .
     3773   run prn-lib-open-stream  in this-procedure (
     3774                                                input parParentProc
     3775                                               ,input 62
     3776                                               ,input yes
     3777                                               ,input no
     3778                                               ).
     3779   PUT  STREAM PrnLibStream
     3780   SPACE(25) ( frame Dialog-Frame:title )
     3781   format "x(90)" SKIP(1) .
     3782   FORM HEADER
     3783   Line AT 1 SKIP
     3784   "Продолжение - на следующей странице" AT 30 SKIP
     3785   with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
     3786   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3787   FORM with FRAME Wth-List  .
     3788   run waitfram-show in this-procedure ("Ждите...").
     3789   GET next br-wth.
     3790   DO WHILE available X_wealth :
     3791     var-on-obj = wth-lib_cur-stock-obj-func(p-curr-obj-type,p-curr-obj-code, X_wealth.wth-code).
     3792     Display STREAM PrnLibStream
     3793     X_wealth.wth-code
     3794     X_wealth.wth-name
     3795     X_wealth.is-money
     3796     X_wealth.curr-code
     3797     X_wealth.unit-base
     3798     var-on-obj
     3799     with FRAME Wth-List .
     3800     DOWN STREAM PrnLibStream 1 with FRAME Wth-List  .
     3801     FOR EACH buf_wth-par No-LOCK WHERE
     3802               buf_wth-par.wth-code = X_wealth.wth-code:
     3803         Display STREAM PrnLibStream
     3804         buf_wth-par.par-code
     3805         buf_wth-par.par-val
     3806         buf_wth-par.par-unit
     3807         buf_wth-par.par-rate
     3808         buf_wth-par.par-feat
     3809         with FRAME Wth-List .
     3810         DOWN STREAM PrnLibStream 1 with FRAME Wth-List  .
     3811     END.
     3812     UNDERLINE  STREAM PrnLibStream
     3813     X_wealth.wth-code
     3814     X_wealth.wth-name
     3815     X_wealth.is-money
     3816     X_wealth.curr-code
     3817     X_wealth.unit-base
     3818     var-on-obj
     3819     buf_wth-par.par-code
     3820     buf_wth-par.par-val
     3821     buf_wth-par.par-unit
     3822     buf_wth-par.par-rate
     3823     buf_wth-par.par-feat
     3824     with FRAME Wth-List .
     3825     GET next br-wth.
     3826   END.
     3827   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3828   HIDE  STREAM PrnLibStream FRAME CheckList.
     3829   output  STREAM PrnLibStream CLOSE.
     3830   run waitfram-hide in this-procedure .
     3831   run prn-lib-prn-file in this-procedure (
     3832                                             input parParentProc
     3833                                             ,input 0
     3834                                             ).
     3835   END PROCEDURE.
     3836   PROCEDURE save-position :
     3837   do
     3838   with frame Dialog-Frame
     3839   on error undo, return error
     3840   :
     3841   assign rsfl-par rstp-par.
     3842           run uf-set (
     3843                 input 'wthref-stts':U
     3844               , input v-cntxt-userid
     3845               , input string( rsfl-par )
     3846               , input 'wthref-stts':U
     3847               , input no
     3848               , input no
     3849               , input no
     3850               , input no
     3851           ) no-error .
     3852           run uf-set (
     3853                 input 'wthref-type':U
     3854               , input v-cntxt-userid
     3855               , input string( rstp-par )
     3856               , input 'wthref-type':U
     3857               , input no
     3858               , input no
     3859               , input no
     3860               , input no
     3861           ) no-error.
     3862   end.
     3863   END PROCEDURE.
