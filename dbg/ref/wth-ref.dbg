      354   procedure fltfield-clear :
      355     define output parameter loc-fld as character no-undo.
      356     define output parameter loc-lab as character no-undo .
      357     define output parameter loc-spr as character no-undo .
      358     define output parameter loc-dim as character no-undo .
      359     assign
      360       loc-fld = ""
      361       loc-lab = ""
      362       loc-spr = ""
      363       loc-dim = "0"
      364     .
      365   end procedure .
      366   procedure fltfield-add :
      367     define input        parameter par-fld as character no-undo.
      368     define input        parameter par-lab as character no-undo .
      369     define input        parameter par-spr as character no-undo .
      370     define input-output parameter loc-fld as character no-undo.
      371     define input-output parameter loc-lab as character no-undo .
      372     define input-output parameter loc-spr as character no-undo .
      373     define input-output parameter loc-dim as character no-undo .
      374     do
      375     on error undo, return error
      376     :
      377       assign
      378       loc-fld = if loc-dim = '0'
      379                 then par-fld
      380                 else (loc-fld + chr(44) + par-fld)
      381       loc-lab = if loc-dim = '0'
      382                 then par-lab
      383                 else (loc-lab + chr(44) + par-lab)
      384       loc-spr = if loc-dim = '0'
      385                 then par-spr
      386                 else (loc-spr + chr(44) + par-spr)
      387       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      388                 string(integer(if num-entries(loc-dim) > 1
      389                               then entry(2, loc-dim)
      390                               else entry(1, loc-dim)
      391                               ) + 1)
      392       no-error
      393       .
      394     end.
      395   end procedure.
