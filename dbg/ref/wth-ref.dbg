     3248   PROCEDURE load-position :
     3249   define variable v-current-stts-string       as character    no-undo.
     3250   define variable v-current-type-string       as character    no-undo.
     3251   define variable v-void-logical              as logical      no-undo.
     3252   define variable v-void-character            as character    no-undo.
     3253   define variable v-found                     as logical      no-undo.
     3254   do   with frame Dialog-Frame
     3255   on error undo, return error
     3256   :
     3257       run uf-get (
     3258             input 'wthref-stts':U
     3259           , input v-cntxt-userid
     3260           , output v-current-stts-string
     3261           , output v-void-character
     3262           , output v-void-logical
     3263           , output v-void-logical
     3264           , output v-void-logical
     3265           , output v-void-logical
     3266       ) no-error.
     3267       if not error-status :error then rsfl-par:screen-value =  v-current-stts-string.
     3268           run uf-get (
     3269                 input 'wthref-type':U
     3270               , input v-cntxt-userid
     3271               , output v-current-type-string
     3272               , output v-void-character
     3273               , output v-void-logical
     3274               , output v-void-logical
     3275               , output v-void-logical
     3276               , output v-void-logical
     3277       ) no-error.
     3278       if not error-status :error then  rstp-par:screen-value = v-current-type-string  .
     3279    end.
     3280   END PROCEDURE.
     3281   PROCEDURE MyEnable :
     3282   define variable glog as logical no-undo .
     3283   DISPLAY E-PS mark-num
     3284   WITH FRAME Dialog-Frame.
     3285   ENABLE
     3286   br-wth
     3287   b-quit
     3288   b-mark WHEN LOOKUP("b-mark":U, bttns) > 0
     3289   b-sel  WHEN LOOKUP("b-sel":U, bttns) > 0
     3290   b-pobj
     3291   b-print
     3292   b-sch
     3293   b-lkp
     3294   b-help
     3295   b-add WHEN (LOOKUP("b-add":U, bttns) > 0 AND v-cntxt-db-num = 0)
     3296   b-del WHEN (LOOKUP("b-add":U, bttns) > 0 AND v-cntxt-db-num = 0)
     3297   b-chg WHEN (LOOKUP("b-add":U, bttns) > 0 AND v-cntxt-db-num = 0)
     3298   b-par
     3299   b-hist
     3300   rsfl-par
     3301   rstp-par
     3302   f-type
     3303   WITH FRAME Dialog-Frame.
     3304   VIEW FRAME Dialog-Frame.
     3305   if not ser-wth then hide   rstp-par f-type
     3306   IN FRAME Dialog-Frame.
     3307   else f-type:screen-value = 'Тип'.
     3308   if not p-mode = 'все':U then
     3309   disable
     3310    rstp-par
     3311   WITH FRAME Dialog-Frame.
     3312   run load-position in this-procedure.
     3313   if p-mode = 'wth-ser':U then rstp-par:screen-value = '1'.
     3314   else if p-mode = 'wth-nser':U then rstp-par:screen-value = '0'.
     3315   apply 'value-changed':U to rstp-par.
     3316   if available X_wealth then
     3317   glog = br-wth:select-focused-row( ).
     3318   ASSIGN b-print:MENU-MOUSE = 1.
     3319   END PROCEDURE.
