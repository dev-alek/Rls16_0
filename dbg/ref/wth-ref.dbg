      346   define variable c-point  as character no-undo .
      347   define variable tbl      as character no-undo .
      348   define variable join-tbl as character no-undo .
      349   define variable fld      as character no-undo .
      350   define variable lab      as character no-undo .
      351   define variable spr      as character no-undo .
