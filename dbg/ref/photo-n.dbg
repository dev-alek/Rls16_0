        1   define INPUT parameter PictName as char no-undo .
        2   define INPUT parameter p-mode as char no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Отсутствие фото товара".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113   define NEW shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      114   define NEW shared variable RepPathName        as character no-undo .
      115   define NEW shared variable PrintRubl          as logical   no-undo .
      116   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117   DEFINE VARIABLE v-image-order      AS CHARACTER NO-UNDO INIT "jpg,bmp":U.
      118   define variable v-image-format     as character extent 62 init
      119   [
      120    "Windows bitmap                                                          ", "*.bmp"
      121   ,"Computer-aided Acquisition and Logistics Support                        ", "*.cal"
      122   ,"Microsoft Windows Clipboard                                             ", "*.clp"
      123   ,"Halo CUT                                                                ", "*.cut"
      124   ,"Intel FAX format                                                        ", "*.dcx"
      125   ,"Windows device-independent bitmap                                       ", "*.dib"
      126   ,"Encapsulated PostScript                                                 ", "*.eps"
      127   ,"1 Graphics Interchange Format                                           ", "*.gif"
      128   ,"IBM IOCA                                                                ", "*.ica"
      129   ,"Microsoft Icon File format                                              ", "*.ico"
      130   ,"Amiga IFF                                                               ", "*.iff"
      131   ,"GEM bitmap                                                              ", "*.img"
      132   ,"Joint Bi-level Image Experts Group                                      ", "*.jbig"
      133   ,"JPEG                                                                    ", "*.jpg"
      134   ,"serView                                                                 ", "*.lv "
      135   ,"Macintosh MacPaint                                                      ", "*.mac"
      136   ,"Microsoft Windows Paint                                                 ", "*.msp"
      137   ,"Kodak Photo CD                                                          ", "*.pcd"
      138   ,"Macintosh PICT                                                          ", "*.pct"
      139   ,"PC Paintbrush                                                           ", "*.pcx"
      140   ,"GIF (Graphics Interchange Format) replacement                           ", "*.png"
      141   ,"Adobe Photoshop                                                         ", "*.psd"
      142   ,"Sun Raster (1-, 8-, 24-, or 32-bit Standard, BGR, RGB, and byte encoded)", "*.ras"
      143   ,"TARGA                                                                   ", "*.tga"
      144   ,"Tag image file format                                                   ", "*.tif"
      145   ,"Windows bitmap for wireless devices                                     ", "*.wbmp"
      146   ,"Windows metafiles                                                       ", "*.wmf"
      147   ,"WordPerfect graphics                                                    ", "*.wpg"
      148   ,"(also .bm) X bitmap                                                     ", "*.xbm"
      149   ,"Pixmap                                                                  ", "*.xpm"
      150   ,"UNIX X Window Dump File format                                          ", "*.xwd"
      151   ] no-undo.
      152   procedure get-custom-img-order :
      153   define output parameter p-descriptions as character no-undo .
      154   define output parameter p-extensiond   as character no-undo .
      155   define output parameter p-extensiont   as character no-undo .
      156   define variable ii as integer no-undo .
      157   define variable v-entry as integer no-undo .
      158     do
      159     on error undo, return error
      160     :
      161       assign
      162       p-descriptions = fill(chr(4), 30)
      163       p-extensiond   = fill(chr(4), 30)
      164       p-extensiont   = fill(chr(4), 30)
      165       .
      166       do ii = 2 to 62 by 2:
      167         assign
      168         v-entry = lookup(left-trim(v-image-format[ii], ".*"), v-image-order)
      169         .
      170         if v-entry > 0 then do:
      171           assign
      172           entry(v-entry, p-descriptions, chr(4)) = substitute("&1 &2", trim(v-image-format[ii - 1]), v-image-format[ii])
      173           entry(v-entry, p-extensiond, chr(4)) = v-image-format[ii]
      174           entry(v-entry, p-extensiont, chr(4)) = left-trim(v-image-format[ii], ".*")
      175           .
      176         end.
      177       end.
      178       assign
      179       p-descriptions = trim(p-descriptions, chr(4))
      180       p-extensiond   = trim(p-extensiond, chr(4))
      181       p-extensiont   = trim(p-extensiont, chr(4))
      182       p-descriptions = replace(p-descriptions, (chr(4) + chr(4)), chr(4))
      183       p-extensiond   = replace(p-extensiond, (chr(4) + chr(4)),  chr(4))
      184       p-extensiont   = replace(p-extensiont, (chr(4) + chr(4)), chr(4))
      185       .
      186     end.
      187   end procedure.
      188   define variable v-descriptions as character no-undo .
      189   define variable v-extensiond   as character no-undo .
      190   define variable v-extensiont   as character no-undo .
      191   DEFINE VARIABLE v-old-file     AS CHARACTER NO-UNDO.
      192   define variable v-param-type as character no-undo .
      193   define variable v-value-date as date no-undo .
      194   define variable v-value-decimal as decimal no-undo .
      195   define variable v-value-integer as INTEGER no-undo .
      196   define variable v-value-logical AS LOGICAL no-undo .
      197   define variable v-tth as handle no-undo .
      198   DEFINE BUTTON B-exit AUTO-GO
      199        LABEL "&Ввод":L
      200        SIZE 10 BY 1
      201        BGCOLOR 8 .
      202   DEFINE BUTTON B-file
      203        IMAGE-UP FILE "btn-down-arrow":U
      204        IMAGE-DOWN FILE "btn-down-arrow":U
      205        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      206        LABEL "no"
      207        SIZE 3 BY 1.
      208   DEFINE BUTTON b-help
      209        LABEL "&Помощь":L
      210        SIZE 10 BY 1
      211        BGCOLOR 8 .
      212   DEFINE BUTTON B-quit AUTO-END-KEY
      213        LABEL "&Отмена"
      214        SIZE 10 BY 1.
      215   DEFINE VARIABLE F-image-name AS CHARACTER FORMAT "X(256)":U
      216         VIEW-AS TEXT
      217        SIZE 78 BY .67
      218        FGCOLOR 4  NO-UNDO.
      219   DEFINE VARIABLE file-name AS CHARACTER FORMAT "X(256)":U
      220         VIEW-AS TEXT
      221        SIZE 77 BY .67 NO-UNDO.
      222   DEFINE IMAGE IMAGE-new
      223        STRETCH-TO-FIT RETAIN-SHAPE
      224        SIZE 28.5 BY 7.25.
      225   DEFINE FRAME DLGOKCAN
      226        B-exit AT ROW 1 COL 1
      227        B-quit AT ROW 1 COL 11
      228        b-help AT ROW 1 COL 41.5
      229        B-file AT ROW 7 COL 80.5
      230        F-image-name AT ROW 4 COL 3 NO-LABEL
      231        file-name AT ROW 7 COL 2 NO-LABEL
      232        "и соотв. расширением (.bmp, .jpg и т.д.) - кнопка ОТМЕНА" VIEW-AS TEXT
      233             SIZE 72.5 BY 1 AT ROW 5 COL 6
      234        "ИЛИ" VIEW-AS TEXT
      235             SIZE 5.5 BY 1 AT ROW 6 COL 3
      236             FGCOLOR 4
      237        "Если Вы сейчас вводите изображение, Вам следует сохранить его в файле с именем" VIEW-AS TEXT
      238             SIZE 82.5 BY 1 AT ROW 3 COL 3.5
      239        "выбрать уже имеющийся у Вас файл изображения для копирования - кнопка ENTER" VIEW-AS TEXT
      240             SIZE 76 BY 1 AT ROW 6 COL 8.5
      241        IMAGE-new AT ROW 8.75 COL 2.5
      242        SPACE(54.99) SKIP(0.41)
      243       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      244            SIDE-LABELS THREE-D  SCROLLABLE
      245            BGCOLOR 8
      246            TITLE BGCOLOR 8 FGCOLOR 1 "":L
      247            DEFAULT-BUTTON B-exit.
      248   ASSIGN
      249          FRAME DLGOKCAN:SCROLLABLE       = FALSE.
      250   ASSIGN
      251          file-name:READ-ONLY IN FRAME DLGOKCAN        = TRUE.
      252   ON CHOOSE OF B-exit IN FRAME DLGOKCAN
      253   DO:
      254     DEFINE VARIABLE err-status AS INTEGER NO-UNDO.
      255     DEFINE VARIABLE err-name AS character NO-UNDO.
      256     define variable v-full-path        as character no-undo .
      257     define variable v-path             as character no-undo .
      258     define variable v-file-name        as character no-undo .
      259     define variable v-file-name-no-ext as character no-undo .
      260     define variable v-file-name-ext    as character no-undo .
      261     define variable v-file-directory   as character no-undo .
      262     define variable vo-full-path        as character no-undo .
      263     define variable vo-path             as character no-undo .
      264     define variable vo-file-name        as character no-undo .
      265     define variable vo-file-name-no-ext as character no-undo .
      266     define variable vo-file-name-ext    as character no-undo .
      267     define variable vo-file-directory   as character no-undo .
      268     assign
      269     file-name.
      270     if file-name = '':U then do:
      271       message
      272       "Не задан файл"
      273       view-as alert-box error .
      274       return no-apply.
      275     end.
      276   run gbl/filename.p (
      277                       input  FILE-NAME
      278                       ,output v-full-path
      279                       ,output v-path
      280                       ,output v-file-name
      281                       ,output v-file-name-no-ext
      282                       ,output v-file-name-ext
      283                       ) no-error .
      284   if error-status:error then do:
      285     message
      286     substitute("Отсутствует или не найден файл &1", file-name)
      287     view-as alert-box error .
      288     return no-apply.
      289   end.
      290   IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
      291       run gbl/filename.p (
      292                           input  v-old-file
      293                           ,output vo-full-path
      294                           ,output vo-path
      295                           ,output vo-file-name
      296                           ,output vo-file-name-no-ext
      297                           ,output vo-file-name-ext
      298                           ) no-error .
      299       IF ERROR-STATUS:ERROR THEN DO:
      300           RETURN NO-APPLY.
      301       END.
      302         IF v-full-path <> vo-full-path THEN DO:
      303             OS-DELETE VALUE(vo-full-path).
      304             err-status = OS-ERROR.
      305             IF err-status <> 0 THEN DO:
      306               run gbl/os-errnm.p (INPUT err-status, OUTPUT err-name).
      307               MESSAGE substitute("Ошибка при удалении старого файла изображения &1:&2&3"
      308                                   , vo-full-path
      309                                  , chr(10)
      310                                   , err-name) VIEW-AS ALERT-BOX.
      311               RETURN NO-APPLY.
      312             END.
      313         END.
      314     END.
      315     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      316       OS-COPY VALUE(FILE-NAME) VALUE(Pictname + "." + v-file-name-ext).
      317     end.
      318     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      319       OS-COPY VALUE(FILE-NAME) VALUE(vo-path + chr(47) + vo-file-name-no-ext + "." + v-file-name-ext ).
      320     end.
      321       err-status = OS-ERROR.
      322     IF err-status <> 0 THEN DO:
      323       run gbl/os-errnm.p (INPUT err-status, OUTPUT err-name).
      324     END.
      325     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      326       RETURN (Pictname + ("." + v-file-name-ext) ).
      327     end.
      328     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      329       RETURN (vo-path + chr(47) + vo-file-name-no-ext + "." + v-file-name-ext ) .
      330     end.
      331   END.
      332   ON CHOOSE OF B-file IN FRAME DLGOKCAN
      333   DO:
      334   DEFINE VARIABLE v_os-file   AS CHAR NO-UNDO INIT "".
      335   DEFINE VARIABLE ll_commit AS LOG    NO-UNDO INIT NO.
      336   define variable v-full-path        as character no-undo .
      337   define variable v-path             as character no-undo .
      338   define variable v-file-name        as character no-undo .
      339   define variable v-file-name-no-ext as character no-undo .
      340   define variable v-file-name-ext    as character no-undo .
      341   define variable v-file-directory   as character no-undo .
      342   define variable v-choose           as LOGICAL   no-undo .
      343   define variable stat               as LOGICAL   no-undo .
      344   ASSIGN
      345   FILE-NAME
      346   v_os-file = FILE-NAME
      347   .
      348   run gbl/d-file.p (
      349    input-output v_os-file
      350   ,input-output v-file-directory
      351   ,input        v-descriptions
      352   ,input        v-extensiond
      353   ,input        chr(4)
      354   ,input        v-extensiont
      355   ,input        YES
      356   ,input        NO
      357   ,input        yes
      358   ,input        "Введите имя файла изображения"
      359   ,output       v-choose
      360   ).
      361   IF v-choose <> YES THEN do:
      362          RETURN NO-APPLY.
      363   end.
      364   ASSIGN
      365   file-name = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) )
      366   .
      367   run gbl/filename.p (
      368                       input  v_os-file
      369                       ,output v-full-path
      370                       ,output v-path
      371                       ,output v-file-name
      372                       ,output v-file-name-no-ext
      373                       ,output v-file-name-ext
      374                       ) no-error .
      375   if error-status:error  = ? then do:
      376     return no-apply.
      377   end.
      378   assign
      379   file-name = v-full-path.
      380   DISPLAY
      381   file-name WITH FRAME DLGOKCAN.
      382   stat = image-new:load-image( FILE-NAME) .
      383   END.
      384   ON CHOOSE OF B-quit IN FRAME DLGOKCAN
      385   DO:
      386     RETURN "error".
      387   END.
      388   ON LEAVE OF file-name IN FRAME DLGOKCAN
      389   DO:
      390       ASSIGN file-name.
      391       IF SEARCH( file-name ) <> ? AND SEARCH( file-name ) <> "":U THEN DO:
      392           ASSIGN FILE-INFO:FILE-NAME = file-name.
      393           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN file-name = FILE-INFO:FULL-PATHNAME.
      394           DISP file-name WITH FRAME DLGOKCAN.
      395       END.
      396       APPLY "TAB":U TO file-name IN FRAME DLGOKCAN.
      397   END.
      398   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DLGOKCAN:PARENT eq ?
      399   THEN FRAME DLGOKCAN:PARENT = ACTIVE-WINDOW.
      400   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      401   on help of frame DLGOKCAN
      402   do:
      403     run gbl/app_help.p
      404       (input this-procedure :file-name
      405       ,input ''
      406       ,input ?
      407       ) no-error.
      408     if error-status :error then do:
      409       message
      410         "Ошибка при вызове помощи"
      411         error-status :get-message(1)
      412         view-as alert-box .
      413     end.
      414   end.
      415   run minbtn-set in this-procedure .
      416   on choose of b-help in frame DLGOKCAN
      417   do:
      418     apply "help":u to frame DLGOKCAN .
      419   end.
      420   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      421   procedure minbtn-set :
      422       do
      423           on error undo, return error return-value
      424           :
      425           define variable ii              as integer       no-undo .
      426           define variable fh              as widget-handle no-undo .
      427           define variable hh              as widget-handle no-undo .
      428           define variable v-h             as handle        extent 4 no-undo .
      429           define variable v-name-button   as character     no-undo .
      430           define variable v-help-old-x    as decimal       no-undo .
      431           define variable v-help-old-y    as decimal       no-undo .
      432           define variable v-help-old-size as decimal       no-undo .
      433           define variable v-frame-width   as decimal       no-undo .
      434           define variable jj              as integer       no-undo .
      435           do
      436               on error undo, return error
      437               :
      438               assign
      439                   v-frame-width = frame DLGOKCAN:width - 0.3
      440                   fh            = frame DLGOKCAN:first-child
      441                   hh            = fh:first-child
      442                   ii            = 1
      443                   .
      444               do while valid-handle(hh):
      445                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      446                   do:
      447                       case lc(hh:name) :
      448                           when "b-help" then
      449                               do:
      450                                   hh:load-image-up("cmp/b-help.bmp":u) .
      451                                   hh:load-image-down("cmp/b-help.bmp":u) .
      452                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      453                                   hh:TOOLTIP = "Помощь" .
      454                                   v-help-old-x = hh:column .
      455                                   v-help-old-y = hh:row    .
      456                                   v-help-old-size = hh:width .
      457                                   hh:width-chars = 2.5 .
      458                               end.
      459                           when "b-print" then
      460                               do:
      461                                   hh:load-image("cmp/b-print.bmp":u) .
      462                                   hh:TOOLTIP = "Печать" .
      463                                   v-h[ii] = hh:handle .
      464                                   ii = ii + 1 .
      465                                   hh:width-chars = 3 .
      466                               end.
      467                           when "b-history" or
      468                           when "b-hist" then
      469                               do:
      470                                   hh:load-image("cmp/b-hist.bmp":u) .
      471                                   hh:TOOLTIP = "История" .
      472                                   v-h[ii] = hh:handle .
      473                                   ii = ii + 1 .
      474                                   hh:width-chars = 3 .
      475                               end.
      476                           when "b-sch" then
      477                               do:
      478                                   hh:load-image("cmp/b-sch.bmp":u) .
      479                                   hh:TOOLTIP = "Установка Фильтра" .
      480                                   v-h[ii] = hh:handle .
      481                                   ii = ii + 1 .
      482                                   hh:width-chars = 3 .
      483                               end.
      484                           when "b-hist-user" then
      485                               do:
      486                                   hh:load-image("cmp/b-hist.bmp":u) .
      487                                   hh:TOOLTIP = "История пользователя" .
      488                                   ii = ii + 1 .
      489                               end.
      490                       end case.
      491                   end.
      492                   hh = hh:next-sibling.
      493               end.
      494               b-help:column = v-frame-width - b-help:width-chars.
      495               jj = 0.
      496               repeat ii = 4 to 1 by -1 :
      497                   if valid-handle (v-h[ii] ) then
      498                   do:
      499                       jj  = jj + 1 .
      500                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      501                       v-h[ii]:row    = v-help-old-y .
      502                   end.
      503               end.
      504           end.
      505       end.
      506   end procedure.
      507   ON WINDOW-CLOSE OF FRAME DLGOKCAN APPLY "END-ERROR":U TO SELF.
      508   MAIN-BLOCK:
      509   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      510      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      511     run adm/shattri.p (
      512         input "get":U
      513         ,input  ''
      514         ,input  0
      515         ,input  'images':U
      516         ,input  'imgorder':U
      517         ,output v-image-order
      518         ,output v-value-date
      519         ,output v-value-decimal
      520         ,output v-value-integer
      521         ,output v-value-logical
      522         ,output v-param-type
      523         ,INPUT-OUTPUT table-handle v-tth
      524         ) no-error .
      525     delete object v-tth.
      526     RUN get-custom-img-order IN THIS-PROCEDURE(OUTPUT v-descriptions, OUTPUT v-extensiond, OUTPUT v-extensiont).
      527     RUN Myenable.
      528     WAIT-FOR GO OF FRAME DLGOKCAN.
      529   END.
      530   RUN disable_UI.
      531   PROCEDURE disable_UI :
      532     HIDE FRAME DLGOKCAN.
      533   END PROCEDURE.
      534   PROCEDURE enable_UI :
      535     DISPLAY F-image-name file-name
      536         WITH FRAME DLGOKCAN.
      537     ENABLE B-exit IMAGE-new B-quit b-help B-file F-image-name
      538         WITH FRAME DLGOKCAN.
      539   END PROCEDURE.
      540   PROCEDURE MyEnable :
      541   define variable stat AS LOGICAL NO-UNDO.
      542   IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
      543       F-image-name = PictName  + ".???".
      544   END.
      545   IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
      546       v-old-file = PictName.
      547       F-image-name = PictName.
      548       stat = image-new:load-image( PictName)  IN FRAME DLGOKCAN.
      549       DISPLAY image-new
      550       WITH FRAME DLGOKCAN.
      551   END.
      552   DISPLAY
      553   F-image-name
      554   file-name
      555   WITH FRAME DLGOKCAN.
      556   ENABLE
      557   B-exit
      558   image-new
      559   B-quit
      560   b-help
      561   B-file
      562   F-image-name
      563   WITH FRAME DLGOKCAN.
      564   END PROCEDURE.
