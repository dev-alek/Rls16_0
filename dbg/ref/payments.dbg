     1509   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1510   DO:
     1511       if ( available X_payment ) AND ( v-rid-list = "" ) then
     1512       v-rid-list = string( recid( X_payment ) ) .
     1513   END.
     1514   ON DEFAULT-ACTION OF BR-payment IN FRAME Dialog-Frame
     1515   DO:
     1516       if b-sel:sensitive THEN
     1517           apply "CHOOSE":U to b-sel.
     1518       else
     1519           apply "CHOOSE":U to b-lkp.
     1520   END.
     1521   ON VALUE-CHANGED OF BR-payment IN FRAME Dialog-Frame
     1522   DO:
     1523       if available X_payment then do:
     1524         ed-notes = X_payment.PS.
     1525       end.
     1526       ELSE DO:
     1527         ed-notes = '':U.
     1528       END.
     1529       DISPLAY ed-notes
     1530       with frame Dialog-Frame.
     1531   END.
     1532   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1533   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1534   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1535   on help of frame Dialog-Frame
     1536   do:
     1537     run gbl/app_help.p
     1538       (input this-procedure :file-name
     1539       ,input ''
     1540       ,input ?
     1541       ) no-error.
     1542     if error-status :error then do:
     1543       message
     1544         "Ошибка при вызове помощи"
     1545         error-status :get-message(1)
     1546         view-as alert-box .
     1547     end.
     1548   end.
     1549   run minbtn-set in this-procedure .
     1550   on choose of b-help in frame Dialog-Frame
     1551   do:
     1552     apply "help":u to frame Dialog-Frame .
     1553   end.
     1554   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1555   procedure minbtn-set :
     1556       do
     1557           on error undo, return error return-value
     1558           :
     1559           define variable ii              as integer       no-undo .
     1560           define variable fh              as widget-handle no-undo .
     1561           define variable hh              as widget-handle no-undo .
     1562           define variable v-h             as handle        extent 4 no-undo .
     1563           define variable v-name-button   as character     no-undo .
     1564           define variable v-help-old-x    as decimal       no-undo .
     1565           define variable v-help-old-y    as decimal       no-undo .
     1566           define variable v-help-old-size as decimal       no-undo .
     1567           define variable v-frame-width   as decimal       no-undo .
     1568           define variable jj              as integer       no-undo .
     1569           do
     1570               on error undo, return error
     1571               :
     1572               assign
     1573                   v-frame-width = frame Dialog-Frame:width - 0.3
     1574                   fh            = frame Dialog-Frame:first-child
     1575                   hh            = fh:first-child
     1576                   ii            = 1
     1577                   .
     1578               do while valid-handle(hh):
     1579                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1580                   do:
     1581                       case lc(hh:name) :
     1582                           when "b-help" then
     1583                               do:
     1584                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1585                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1586                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1587                                   hh:TOOLTIP = "Помощь" .
     1588                                   v-help-old-x = hh:column .
     1589                                   v-help-old-y = hh:row    .
     1590                                   v-help-old-size = hh:width .
     1591                                   hh:width-chars = 2.5 .
     1592                               end.
     1593                           when "b-print" then
     1594                               do:
     1595                                   hh:load-image("cmp/b-print.bmp":u) .
     1596                                   hh:TOOLTIP = "Печать" .
     1597                                   v-h[ii] = hh:handle .
     1598                                   ii = ii + 1 .
     1599                                   hh:width-chars = 3 .
     1600                               end.
     1601                           when "b-history" or
     1602                           when "b-hist" then
     1603                               do:
     1604                                   hh:load-image("cmp/b-hist.bmp":u) .
     1605                                   hh:TOOLTIP = "История" .
     1606                                   v-h[ii] = hh:handle .
     1607                                   ii = ii + 1 .
     1608                                   hh:width-chars = 3 .
     1609                               end.
     1610                           when "b-sch" then
     1611                               do:
     1612                                   hh:load-image("cmp/b-sch.bmp":u) .
     1613                                   hh:TOOLTIP = "Установка Фильтра" .
     1614                                   v-h[ii] = hh:handle .
     1615                                   ii = ii + 1 .
     1616                                   hh:width-chars = 3 .
     1617                               end.
     1618                           when "b-hist-user" then
     1619                               do:
     1620                                   hh:load-image("cmp/b-hist.bmp":u) .
     1621                                   hh:TOOLTIP = "История пользователя" .
     1622                                   ii = ii + 1 .
     1623                               end.
     1624                       end case.
     1625                   end.
     1626                   hh = hh:next-sibling.
     1627               end.
     1628               b-help:column = v-frame-width - b-help:width-chars.
     1629               jj = 0.
     1630               repeat ii = 4 to 1 by -1 :
     1631                   if valid-handle (v-h[ii] ) then
     1632                   do:
     1633                       jj  = jj + 1 .
     1634                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1635                       v-h[ii]:row    = v-help-old-y .
     1636                   end.
     1637               end.
     1638           end.
     1639       end.
     1640   end procedure.
     1641   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1642   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1643   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1644   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1645   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1646   define variable v-diasize-current-frame-height as decimal   no-undo .
     1647   define variable v-diasize-change-size          as logical   no-undo .
     1648   define variable v-diasize-resize-button        as handle    no-undo .
     1649   define variable v-diasize-wndmax               as logical   no-undo .
     1650   define variable v-diasize-wndstore             as logical   no-undo .
     1651   define variable v-diasize-proc-name            as character no-undo .
     1652   define variable v-diasize-browse-handle        as handle    no-undo .
     1653   define variable v-diasize-browse-number        as integer   no-undo .
     1654   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1655   define temp-table temp-diasize-handle no-undo
     1656     field handle-value  as handle
     1657     field save-position as decimal
     1658     index xpk is primary unique handle-value
     1659     .
     1660   define temp-table temp-browse-handle no-undo
     1661     field browse-type   as character
     1662     field browse-number as integer
     1663     field browse-handle as handle
     1664     field original-size as decimal
     1665     index xpk is primary unique browse-type browse-number
     1666     index xie browse-type browse-handle
     1667   .
     1668   procedure diasize_change-height :
     1669     define input  parameter p-change-value  as decimal   no-undo .
     1670     define input  parameter p-move-resize   as logical   no-undo .
     1671     define variable v-field-group-handle    as handle    no-undo .
     1672     define variable v-object-handle         as handle    no-undo .
     1673     define variable v-frame-height          as decimal   no-undo .
     1674     define variable v-frame-virtual-height  as decimal   no-undo .
     1675     define variable v-browse-height         as decimal   no-undo .
     1676     define variable v-window-height         as decimal   no-undo .
     1677     define variable v-window-virtual-height as decimal   no-undo .
     1678     define variable v-change-sign           as integer   no-undo .
     1679     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1680     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1681     if p-change-value > 0
     1682     then do:
     1683       if frame Dialog-Frame :height + p-change-value
     1684           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1685       then do:
     1686         assign
     1687           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1688                           - (frame Dialog-Frame :height-chars)
     1689         .
     1690         if p-change-value <= 0
     1691         then do:
     1692           run diasize_position-resize-button in this-procedure .
     1693           return .
     1694         end.
     1695       end.
     1696     end.
     1697     if p-change-value < 0
     1698     then do:
     1699       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1700       then do:
     1701         assign
     1702           p-change-value = v-diasize-orig-frame-height
     1703                          - (frame Dialog-Frame :height-chars)
     1704         .
     1705         if p-change-value >= 0
     1706         then do:
     1707           run diasize_position-resize-button in this-procedure .
     1708           return .
     1709         end.
     1710       end.
     1711     end.
     1712     if p-change-value >= 0
     1713     then do:
     1714       assign
     1715         v-change-sign = 1
     1716       .
     1717     end.
     1718     else do:
     1719       assign
     1720         v-change-sign = -1
     1721       .
     1722     end.
     1723     assign
     1724       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1725     .
     1726     if p-change-value = 0
     1727     then do:
     1728       run diasize_position-resize-button in this-procedure .
     1729       return .
     1730     end.
     1731     move_block:
     1732     do
     1733     on error undo move_block, retry move_block
     1734     :
     1735       if retry
     1736       then do:
     1737         do
     1738         on error undo move_block, leave move_block
     1739         :
     1740           if p-change-value > 0
     1741           then do:
     1742             for each buf_temp-diasize-handle
     1743             on error undo, next
     1744             :
     1745               assign
     1746                 v-object-handle = buf_temp-diasize-handle.handle-value
     1747               .
     1748               if v-object-handle <> v-diasize-resize-button
     1749               then do:
     1750                 assign
     1751                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1752                 .
     1753               end.
     1754             end.
     1755             assign
     1756               v-diasize-browse-handle :height = v-browse-height
     1757             .
     1758             for each buf_temp-browse-handle
     1759               where buf_temp-browse-handle.browse-type = 'height':u
     1760             on error undo, next
     1761             :
     1762               assign
     1763                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1764               .
     1765             end.
     1766             assign
     1767               frame Dialog-Frame :height = v-frame-height
     1768             .
     1769             if frame Dialog-Frame :scrollable = true
     1770             then do:
     1771               assign
     1772                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1773               .
     1774             end.
     1775             run diasize_position-resize-button in this-procedure .
     1776           end.
     1777           else do:
     1778             if frame Dialog-Frame :scrollable = true
     1779             then do:
     1780               assign
     1781                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1782               .
     1783             end.
     1784             assign
     1785               frame Dialog-Frame :height = v-frame-height
     1786             .
     1787             assign
     1788               v-diasize-browse-handle :height = v-browse-height
     1789             .
     1790             for each buf_temp-browse-handle
     1791               where buf_temp-browse-handle.browse-type = 'height':u
     1792             on error undo, next
     1793             :
     1794               assign
     1795                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1796               .
     1797             end.
     1798             for each buf_temp-diasize-handle
     1799             on error undo, next
     1800             :
     1801               assign
     1802                 v-object-handle = buf_temp-diasize-handle.handle-value
     1803               .
     1804               if v-object-handle <> v-diasize-resize-button
     1805               then do:
     1806                 assign
     1807                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1808                 .
     1809               end.
     1810             end.
     1811             run diasize_position-resize-button in this-procedure .
     1812           end.
     1813           assign
     1814             v-diasize-change-size = false
     1815           .
     1816           leave move_block .
     1817         end.
     1818       end.
     1819       assign
     1820         v-diasize-need-full-display = true
     1821       .
     1822       if v-diasize-change-size = false
     1823       then do:
     1824         assign
     1825           v-diasize-change-size = true
     1826         .
     1827       end.
     1828       else do:
     1829         return .
     1830       end.
     1831       assign
     1832         v-frame-height = frame Dialog-Frame :height
     1833         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1834         v-browse-height = v-diasize-browse-handle :height
     1835       .
     1836       for each buf_temp-browse-handle
     1837         where buf_temp-browse-handle.browse-type = 'height':u
     1838       :
     1839         assign
     1840           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1841         .
     1842       end.
     1843       for each buf_temp-diasize-handle
     1844       :
     1845         delete buf_temp-diasize-handle .
     1846       end.
     1847       assign
     1848         v-field-group-handle = frame Dialog-Frame :first-child
     1849       .
     1850       do while valid-handle(v-field-group-handle)
     1851       :
     1852         assign
     1853           v-object-handle = v-field-group-handle :first-child
     1854         .
     1855         do while valid-handle(v-object-handle)
     1856         :
     1857           if  v-object-handle <> v-diasize-browse-handle :handle
     1858           and can-query(v-object-handle, "row")
     1859           and can-query(v-object-handle, "height")
     1860           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1861           then do:
     1862             find first buf_temp-browse-handle
     1863               where buf_temp-browse-handle.browse-type   = 'height':u
     1864                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1865               no-error .
     1866             if available buf_temp-browse-handle
     1867             then do:
     1868             end.
     1869             else do:
     1870               create buf_temp-diasize-handle .
     1871               assign
     1872                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1873                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1874               .
     1875             end.
     1876           end.
     1877           assign
     1878             v-object-handle = v-object-handle :next-sibling
     1879           .
     1880         end.
     1881         assign
     1882           v-field-group-handle = v-field-group-handle :next-sibling
     1883         .
     1884       end.
     1885       do with frame Dialog-Frame
     1886       :
     1887         hide v-diasize-resize-button .
     1888         assign
     1889           v-diasize-resize-button :row    = 1
     1890           v-diasize-resize-button :column = 1
     1891         .
     1892       end.
     1893       if p-change-value > 0
     1894       then do:
     1895         if frame Dialog-Frame :scrollable = true
     1896         then do:
     1897           assign
     1898             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1899             no-error .
     1900           if error-status :error
     1901           or error-status :get-message(1) <> ""
     1902           then do:
     1903             undo move_block, retry move_block .
     1904           end.
     1905         end.
     1906         assign
     1907           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1908           no-error .
     1909         if error-status :error
     1910         or error-status :get-message(1) <> ""
     1911         then do:
     1912           undo move_block, retry move_block .
     1913         end.
     1914         assign
     1915           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1916           no-error .
     1917         if error-status :error
     1918         or error-status :get-message(1) <> ""
     1919         then do:
     1920           undo move_block, retry move_block .
     1921         end.
     1922         for each buf_temp-browse-handle
     1923           where buf_temp-browse-handle.browse-type = 'height':u
     1924         on error undo move_block, retry move_block
     1925         :
     1926           assign
     1927             buf_temp-browse-handle.browse-handle :height
     1928               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1929             no-error .
     1930           if error-status :error
     1931           or error-status :get-message(1) <> ""
     1932           then do:
     1933             undo move_block, retry move_block .
     1934           end.
     1935         end.
     1936         for each buf_temp-diasize-handle
     1937         on error undo move_block, retry move_block
     1938         :
     1939           assign
     1940             v-object-handle = buf_temp-diasize-handle.handle-value
     1941           .
     1942           if v-object-handle <> v-diasize-resize-button
     1943           then do:
     1944             assign
     1945               v-object-handle :row = v-object-handle :row + p-change-value
     1946               no-error .
     1947             if error-status :error
     1948             or error-status :get-message(1) <> ""
     1949             then do:
     1950               undo move_block, retry move_block .
     1951             end.
     1952           end.
     1953         end.
     1954       end.
     1955       else do:
     1956         for each buf_temp-diasize-handle
     1957         on error undo move_block, retry move_block
     1958         :
     1959           assign
     1960             v-object-handle = buf_temp-diasize-handle.handle-value
     1961           .
     1962           if v-object-handle <> v-diasize-resize-button
     1963           then do:
     1964             assign
     1965               v-object-handle :row = v-object-handle :row + p-change-value
     1966               no-error .
     1967             if error-status :error
     1968             or error-status :get-message(1) <> ""
     1969             then do:
     1970               undo move_block, retry move_block .
     1971             end.
     1972           end.
     1973         end.
     1974         assign
     1975           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1976           no-error .
     1977         if error-status :error
     1978         or error-status :get-message(1) <> ""
     1979         then do:
     1980           undo move_block, retry move_block .
     1981         end.
     1982         for each buf_temp-browse-handle
     1983           where buf_temp-browse-handle.browse-type = 'height':u
     1984         on error undo move_block, retry move_block
     1985         :
     1986           assign
     1987             buf_temp-browse-handle.browse-handle :height
     1988               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1989             no-error .
     1990           if error-status :error
     1991           or error-status :get-message(1) <> ""
     1992           then do:
     1993             undo move_block, retry move_block .
     1994           end.
     1995         end.
     1996         assign
     1997           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1998           no-error .
     1999         if error-status :error
     2000         or error-status :get-message(1) <> ""
     2001         then do:
     2002           undo move_block, retry move_block .
     2003         end.
     2004         if frame Dialog-Frame :scrollable = true
     2005         then do:
     2006           assign
     2007             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2008             no-error .
     2009           if error-status :error
     2010           or error-status :get-message(1) <> ""
     2011           then do:
     2012             undo move_block, retry move_block .
     2013           end.
     2014         end.
     2015       end.
     2016       if p-move-resize = true
     2017       then do:
     2018         run diasize_position-resize-button in this-procedure .
     2019       end.
     2020       if v-diasize-wndstore = true
     2021       then do:
     2022         if connected("ub") = true
     2023         then do:
     2024           define variable v-cntxt-db-num        as integer   no-undo .
     2025           define variable v-cntxt-userid        as character no-undo .
     2026           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2027                                             , OUTPUT v-cntxt-userid
     2028                                             ) .
     2029           run gbl/wndsizew.p
     2030             (input  v-cntxt-db-num
     2031             ,input  v-cntxt-userid
     2032             ,input  v-diasize-proc-name
     2033             ,input  'height':u
     2034             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2035             ) .
     2036         end.
     2037       end.
     2038     end.
     2039     assign
     2040       v-diasize-change-size = false
     2041     .
     2042   end procedure.
     2043   procedure diasize_set-height :
     2044     define input  parameter p-new-height  as decimal   no-undo .
     2045     define input  parameter p-move-resize as logical   no-undo .
     2046     do
     2047     on error undo, return error return-value
     2048     :
     2049       run diasize_change-height in this-procedure
     2050         (input  (p-new-height - frame Dialog-Frame :height)
     2051         ,input  p-move-resize
     2052         ) .
     2053     end.
     2054   end procedure.
     2055   procedure diasize_change-width :
     2056     define input  parameter p-change-value as decimal   no-undo .
     2057     define input  parameter p-move-resize  as logical   no-undo .
     2058     define variable v-field-group-handle   as handle    no-undo .
     2059     define variable v-object-handle        as handle    no-undo .
     2060     define variable v-frame-width          as decimal   no-undo .
     2061     define variable v-frame-virtual-width  as decimal   no-undo .
     2062     define variable v-browse-width         as decimal   no-undo .
     2063     define variable v-window-width         as decimal   no-undo .
     2064     define variable v-window-virtual-width as decimal   no-undo .
     2065     define variable v-change-sign          as integer   no-undo .
     2066     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2067     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2068     if p-change-value > 0
     2069     then do:
     2070       if frame Dialog-Frame :width + p-change-value >
     2071           session :width-chars
     2072       then do:
     2073         assign
     2074           p-change-value = session :width-chars - frame Dialog-Frame :width
     2075         .
     2076         if p-change-value <= 0
     2077         then do:
     2078           run diasize_position-resize-button in this-procedure .
     2079           return .
     2080         end.
     2081       end.
     2082     end.
     2083     if p-change-value < 0
     2084     then do:
     2085       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2086       then do:
     2087         assign
     2088           p-change-value = v-diasize-orig-frame-width
     2089                          - frame Dialog-Frame :width
     2090         .
     2091         if p-change-value >= 0
     2092         then do:
     2093           run diasize_position-resize-button in this-procedure .
     2094           return .
     2095         end.
     2096       end.
     2097     end.
     2098     if p-change-value >= 0
     2099     then do:
     2100       assign
     2101         v-change-sign = 1
     2102       .
     2103     end.
     2104     else do:
     2105       assign
     2106         v-change-sign = -1
     2107       .
     2108     end.
     2109     assign
     2110       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2111     .
     2112     if p-change-value = 0
     2113     then do:
     2114       run diasize_position-resize-button in this-procedure .
     2115       return .
     2116     end.
     2117     move_block:
     2118     do
     2119     on error undo move_block, leave move_block
     2120     :
     2121       if retry
     2122       then do:
     2123         do
     2124         on error undo move_block, leave move_block
     2125         :
     2126           if p-change-value > 0
     2127           then do:
     2128             for each buf_temp-diasize-handle
     2129             on error undo, next
     2130             :
     2131               assign
     2132                 v-object-handle = buf_temp-diasize-handle.handle-value
     2133               .
     2134               if v-object-handle <> v-diasize-resize-button
     2135               then do:
     2136                 assign
     2137                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2138                 .
     2139               end.
     2140             end.
     2141             assign
     2142               v-diasize-browse-handle :width = v-browse-width
     2143             .
     2144             for each buf_temp-browse-handle
     2145               where buf_temp-browse-handle.browse-type = 'width':u
     2146             on error undo, next
     2147             :
     2148               assign
     2149                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2150               .
     2151             end.
     2152             assign
     2153               frame Dialog-Frame :width = v-frame-width
     2154             .
     2155             if frame Dialog-Frame :scrollable = true
     2156             then do:
     2157               assign
     2158                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2159               .
     2160             end.
     2161             run diasize_position-resize-button in this-procedure .
     2162           end.
     2163           else do:
     2164             if frame Dialog-Frame :scrollable = true
     2165             then do:
     2166               assign
     2167                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2168               .
     2169             end.
     2170             assign
     2171               frame Dialog-Frame :width = v-frame-width
     2172             .
     2173             for each buf_temp-browse-handle
     2174               where buf_temp-browse-handle.browse-type = 'width':u
     2175             on error undo, next
     2176             :
     2177               assign
     2178                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2179               .
     2180             end.
     2181             assign
     2182               v-diasize-browse-handle :width = v-browse-width
     2183             .
     2184             for each buf_temp-diasize-handle
     2185             on error undo, next
     2186             :
     2187               assign
     2188                 v-object-handle = buf_temp-diasize-handle.handle-value
     2189               .
     2190               if v-object-handle <> v-diasize-resize-button
     2191               then do:
     2192                 assign
     2193                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2194                 .
     2195               end.
     2196             end.
     2197             run diasize_position-resize-button in this-procedure .
     2198           end.
     2199           assign
     2200             v-diasize-change-size = false
     2201           .
     2202           leave move_block .
     2203         end.
     2204       end.
     2205       assign
     2206         v-diasize-need-full-display = true
     2207       .
     2208       if v-diasize-change-size = false
     2209       then do:
     2210         assign
     2211           v-diasize-change-size = true
     2212         .
     2213       end.
     2214       else do:
     2215         return .
     2216       end.
     2217       assign
     2218         v-frame-width = frame Dialog-Frame :width
     2219         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2220         v-browse-width = v-diasize-browse-handle :width
     2221       .
     2222       for each buf_temp-browse-handle
     2223         where buf_temp-browse-handle.browse-type = 'width':u
     2224       :
     2225         assign
     2226           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2227         .
     2228       end.
     2229       for each buf_temp-diasize-handle
     2230       :
     2231         delete buf_temp-diasize-handle .
     2232       end.
     2233       assign
     2234         v-field-group-handle = frame Dialog-Frame :first-child
     2235       .
     2236       do while valid-handle(v-field-group-handle)
     2237       :
     2238         assign
     2239           v-object-handle = v-field-group-handle :first-child
     2240         .
     2241         do while valid-handle(v-object-handle)
     2242         :
     2243           if  v-object-handle <> v-diasize-browse-handle :handle
     2244           and v-object-handle <> v-diasize-resize-button
     2245           and can-query(v-object-handle, "row")
     2246           and can-query(v-object-handle, "height")
     2247           and ( v-object-handle :col + v-object-handle :width
     2248                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2249               )
     2250           then do:
     2251             find first buf_temp-browse-handle
     2252               where buf_temp-browse-handle.browse-type   = 'width':u
     2253                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2254               no-error .
     2255             if available buf_temp-browse-handle
     2256             then do:
     2257             end.
     2258             else do:
     2259               create buf_temp-diasize-handle .
     2260               assign
     2261                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2262                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2263               .
     2264             end.
     2265           end.
     2266           assign
     2267             v-object-handle = v-object-handle :next-sibling
     2268           .
     2269         end.
     2270         assign
     2271           v-field-group-handle = v-field-group-handle :next-sibling
     2272         .
     2273       end.
     2274       do with frame Dialog-Frame
     2275       :
     2276         hide v-diasize-resize-button .
     2277         v-diasize-resize-button :row = 1.
     2278         v-diasize-resize-button :column = 1.
     2279       end.
     2280       if p-change-value > 0
     2281       then do:
     2282         if frame Dialog-Frame :scrollable = true
     2283         then do:
     2284           assign
     2285             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2286             no-error .
     2287           if error-status :error
     2288           or error-status :get-message(1) <> ""
     2289           then do:
     2290             undo move_block, retry move_block.
     2291           end.
     2292         end.
     2293         assign
     2294           frame Dialog-Frame :width = v-frame-width + p-change-value
     2295           no-error .
     2296         if error-status :error
     2297         or error-status :get-message(1) <> ""
     2298         then do:
     2299           undo move_block, retry move_block.
     2300         end.
     2301         assign
     2302           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2303         no-error .
     2304         if error-status :error
     2305         or error-status :get-message(1) <> ""
     2306         then do:
     2307           undo move_block, retry move_block.
     2308         end.
     2309         for each buf_temp-browse-handle
     2310           where buf_temp-browse-handle.browse-type = 'width':u
     2311         on error undo move_block, retry move_block
     2312         :
     2313           assign
     2314             buf_temp-browse-handle.browse-handle :width
     2315               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2316             no-error .
     2317           if error-status :error
     2318           or error-status :get-message(1) <> ""
     2319           then do:
     2320             undo move_block, retry move_block .
     2321           end.
     2322         end.
     2323         for each buf_temp-diasize-handle
     2324         on error undo move_block, retry move_block
     2325         :
     2326           assign
     2327             v-object-handle = buf_temp-diasize-handle.handle-value
     2328           .
     2329           if v-object-handle <> v-diasize-resize-button
     2330           then do:
     2331             assign
     2332               v-object-handle :col = v-object-handle :col + p-change-value
     2333               no-error .
     2334             if error-status :error
     2335             or error-status :get-message(1) <> ""
     2336             then do:
     2337               undo move_block, retry move_block .
     2338             end.
     2339           end.
     2340         end.
     2341       end.
     2342       else do:
     2343         for each buf_temp-diasize-handle
     2344         on error undo move_block, retry move_block
     2345         :
     2346           assign
     2347             v-object-handle = buf_temp-diasize-handle.handle-value
     2348           .
     2349           if v-object-handle <> v-diasize-resize-button
     2350           then do:
     2351             assign
     2352               v-object-handle :col = v-object-handle :col + p-change-value
     2353               no-error .
     2354             if error-status :error
     2355             or error-status :get-message(1) <> ""
     2356             then do:
     2357               undo move_block, retry move_block .
     2358             end.
     2359           end.
     2360         end.
     2361         for each buf_temp-browse-handle
     2362           where buf_temp-browse-handle.browse-type = 'width':u
     2363         on error undo move_block, retry move_block
     2364         :
     2365           assign
     2366             buf_temp-browse-handle.browse-handle :width
     2367               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2368             no-error .
     2369           if error-status :error
     2370           or error-status :get-message(1) <> ""
     2371           then do:
     2372             undo move_block, retry move_block .
     2373           end.
     2374         end.
     2375         assign
     2376           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2377           no-error .
     2378         if error-status :error
     2379         or error-status :get-message(1) <> ""
     2380         then do:
     2381           undo move_block, retry move_block.
     2382         end.
     2383         assign
     2384           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2385         no-error .
     2386         if error-status :error
     2387         or error-status :get-message(1) <> ""
     2388         then do:
     2389           undo move_block, retry move_block.
     2390         end.
     2391         if frame Dialog-Frame :scrollable = true
     2392         then do:
     2393           assign
     2394             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2395           no-error .
     2396           if error-status :error
     2397           or error-status :get-message(1) <> ""
     2398           then do:
     2399             undo move_block, retry move_block.
     2400           end.
     2401         end.
     2402       end.
     2403       if p-move-resize
     2404       then do:
     2405         run diasize_position-resize-button in this-procedure .
     2406       end.
     2407       if v-diasize-wndstore = true
     2408       then do:
     2409         if connected("ub") = true
     2410         then do:
     2411           define variable v-cntxt-db-num        as integer   no-undo .
     2412           define variable v-cntxt-userid        as character no-undo .
     2413           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2414                                             , OUTPUT v-cntxt-userid
     2415                                             ) .
     2416           run gbl/wndsizew.p
     2417             (input  v-cntxt-db-num
     2418             ,input  v-cntxt-userid
     2419             ,input  v-diasize-proc-name
     2420             ,input  'width':u
     2421             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2422             ) .
     2423         end.
     2424       end.
     2425     end.
     2426     assign
     2427       v-diasize-change-size = false
     2428     .
     2429   end procedure.
     2430   procedure diasize_set-width :
     2431     define input  parameter p-new-width  as decimal   no-undo .
     2432     define input  parameter p-move-resize as logical   no-undo .
     2433     do
     2434     on error undo, return error return-value
     2435     :
     2436       run diasize_change-width in this-procedure
     2437         (input  (p-new-width - frame Dialog-Frame :width)
     2438         ,input  p-move-resize
     2439         ) .
     2440     end.
     2441   end procedure.
     2442   procedure diasize_position-resize-button :
     2443     do with frame Dialog-Frame
     2444     :
     2445       hide v-diasize-resize-button .
     2446       assign
     2447         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2448                     - 1
     2449                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2450         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2451                     - 1
     2452                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2453       .
     2454       view v-diasize-resize-button .
     2455     end.
     2456   end procedure.
     2457   on alt-right anywhere
     2458   do:
     2459     run diasize_change-width in this-procedure
     2460       (input 1
     2461       ,input true
     2462       ) .
     2463     return no-apply .
     2464   end.
     2465   on alt-left anywhere
     2466   do:
     2467     run diasize_change-width in this-procedure
     2468       (input -1
     2469       ,input true
     2470       ) .
     2471     return no-apply .
     2472   end.
     2473   on alt-down anywhere
     2474   do:
     2475     run diasize_change-height in this-procedure
     2476       (input 1
     2477       ,input true
     2478       ) .
     2479     return no-apply .
     2480   end.
     2481   on alt-up anywhere
     2482   do:
     2483     run diasize_change-height in this-procedure
     2484       (input -1
     2485       ,input true
     2486       ) .
     2487     return no-apply .
     2488   end.
     2489   on alt-enter of frame Dialog-Frame
     2490   do:
     2491     run diasize_maximize in this-procedure
     2492       (input  ?
     2493       ).
     2494     return no-apply .
     2495   end.
     2496   procedure diasize_end-move :
     2497     do
     2498     on error undo, return error return-value
     2499     :
     2500       define variable v-row-delta as decimal   no-undo .
     2501       define variable v-col-delta as decimal   no-undo .
     2502       define variable v-new-row as decimal   no-undo .
     2503       define variable v-new-col as decimal   no-undo .
     2504       assign
     2505         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2506         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2507       .
     2508       assign
     2509         v-row-delta = v-new-row - frame Dialog-Frame :height
     2510         v-col-delta = v-new-col - frame Dialog-Frame :width
     2511       .
     2512       run diasize_change-height in this-procedure
     2513         (input v-row-delta
     2514         ,input true
     2515         ) .
     2516       run diasize_change-width in this-procedure
     2517         (input v-col-delta
     2518         ,input true
     2519         ) .
     2520     end.
     2521   end procedure.
     2522   procedure diasize_maximize :
     2523     define input  parameter p-action as logical   no-undo .
     2524     do
     2525     on error undo, return error return-value
     2526     :
     2527       if p-action = ?
     2528       then do:
     2529         if v-diasize-need-maximize = true
     2530         then do:
     2531           assign
     2532             p-action = true
     2533           .
     2534         end.
     2535         else do:
     2536           assign
     2537             p-action = false
     2538           .
     2539         end.
     2540       end.
     2541       if p-action = true
     2542       then do:
     2543         run diasize_change-height in this-procedure
     2544           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2545               - frame Dialog-Frame :height-chars
     2546           ,input true
     2547           ) .
     2548         run diasize_change-width in this-procedure
     2549           (input session :width-chars
     2550               - frame Dialog-Frame :width-chars
     2551           ,input true
     2552           ) .
     2553         assign
     2554           v-diasize-need-maximize = false
     2555         .
     2556       end.
     2557       else do:
     2558         run diasize_change-width in this-procedure
     2559           (input v-diasize-orig-frame-width
     2560               - frame Dialog-Frame :width-chars
     2561           ,input true
     2562           ) .
     2563         run diasize_change-height in this-procedure
     2564           (input v-diasize-orig-frame-height
     2565               - frame Dialog-Frame :height-chars
     2566           ,input true
     2567           ) .
     2568         assign
     2569           v-diasize-need-maximize = true
     2570         .
     2571       end.
     2572     end.
     2573   end procedure.
     2574   procedure diasize_restore-orig-size :
     2575     do
     2576     on error undo, return error return-value
     2577     :
     2578       assign
     2579         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2580         v-diasize-current-frame-height = frame Dialog-Frame :height
     2581       .
     2582       run diasize_set-height in this-procedure
     2583         (input  v-diasize-orig-frame-height
     2584         ,input  true
     2585         ) .
     2586       run diasize_set-width in this-procedure
     2587         (input  v-diasize-orig-frame-width
     2588         ,input  true
     2589         ) .
     2590     end.
     2591   end procedure.
     2592   procedure diasize_restore-current-size :
     2593     do
     2594     on error undo, return error return-value
     2595     :
     2596       run diasize_set-height in this-procedure
     2597         (input  v-diasize-current-frame-height
     2598         ,input  true
     2599         ) .
     2600       run diasize_set-width in this-procedure
     2601         (input  v-diasize-current-frame-width
     2602         ,input  true
     2603         ) .
     2604     end.
     2605   end procedure.
     2606   procedure diasize_set-browse-handle :
     2607     define input  parameter p-browse-handle as handle   no-undo .
     2608     define buffer buf_temp-browse-handle for temp-browse-handle .
     2609     do
     2610     on error undo, return error return-value
     2611     :
     2612       assign
     2613         v-diasize-browse-handle = p-browse-handle
     2614       .
     2615       for each buf_temp-browse-handle
     2616       on error undo, return error return-value
     2617       :
     2618         delete buf_temp-browse-handle .
     2619       end.
     2620     end.
     2621   end procedure.
     2622   procedure diasize_add_browse :
     2623     define input  parameter p-browse-type   as character no-undo .
     2624     define input  parameter p-browse-handle as handle    no-undo .
     2625     define buffer buf_temp-browse-handle for temp-browse-handle .
     2626     do
     2627     on error undo, return error return-value
     2628     :
     2629       assign
     2630         v-diasize-browse-number = v-diasize-browse-number + 1
     2631       .
     2632       create buf_temp-browse-handle .
     2633       assign
     2634         buf_temp-browse-handle.browse-type   = p-browse-type
     2635         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2636         buf_temp-browse-handle.browse-handle = p-browse-handle
     2637       .
     2638     end.
     2639   end procedure.
     2640   procedure diasize_init :
     2641     define variable v-default-value    as logical   no-undo .
     2642     define variable v-restore-saved    as logical   no-undo .
     2643     define variable v-resize-value-str as character no-undo .
     2644     do
     2645     on error undo, return error return-value
     2646     :
     2647       do with frame Dialog-Frame
     2648       :
     2649         assign
     2650           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2651           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2652           v-diasize-browse-handle     = browse BR-payment :handle
     2653         .
     2654         create button v-diasize-resize-button
     2655         assign
     2656           parent        = frame Dialog-Frame :first-child
     2657           label         = "s"
     2658           height-pixels = 16
     2659           width-pixels  = 16
     2660           visible       = true
     2661           sensitive     = true
     2662           movable       = true
     2663           triggers:
     2664             on end-move persistent run diasize_end-move in this-procedure .
     2665           end triggers.
     2666         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2667         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2668         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2669         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2670         assign
     2671           v-diasize-wndmax = false
     2672         .
     2673         if connected("ub") = true
     2674         then do:
     2675           define variable v-cntxt-db-num        as integer   no-undo .
     2676           define variable v-cntxt-userid        as character no-undo .
     2677           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2678                                             , OUTPUT v-cntxt-userid
     2679                                             ) .
     2680           run gbl/wndpar_r.p
     2681             (input  v-cntxt-db-num
     2682             ,input  v-cntxt-userid
     2683             ,input  'wndmax':U
     2684             ,output v-diasize-wndmax
     2685             ,output v-default-value
     2686             ) .
     2687         end.
     2688         assign
     2689           v-diasize-wndstore = false
     2690         .
     2691         if connected("ub") = true
     2692         then do:
     2693           run gbl/wndpar_r.p
     2694             (input  v-cntxt-db-num
     2695             ,input  v-cntxt-userid
     2696             ,input  'wndstore':U
     2697             ,output v-diasize-wndstore
     2698             ,output v-default-value
     2699             ) .
     2700         end.
     2701         assign
     2702           v-diasize-proc-name = entry(1, program-name(2), '.')
     2703         .
     2704         if v-diasize-wndstore = true
     2705         then do:
     2706           assign
     2707             v-restore-saved = false
     2708           .
     2709           if connected("ub") = true
     2710           then do:
     2711             run gbl/wndsizer.p
     2712               (input  v-cntxt-db-num
     2713               ,input  v-cntxt-userid
     2714               ,input  v-diasize-proc-name
     2715               ,input  'height':u
     2716               ,output v-resize-value-str
     2717               ) .
     2718             if v-resize-value-str <> '':U
     2719             then do:
     2720               run diasize_change-height in this-procedure
     2721                 (input  integer(v-resize-value-str)
     2722                 ,input  true
     2723                 ) .
     2724               assign
     2725                 v-restore-saved = true
     2726               .
     2727             end.
     2728           end.
     2729           if connected("ub") = true
     2730           then do:
     2731             run gbl/wndsizer.p
     2732               (input  v-cntxt-db-num
     2733               ,input  v-cntxt-userid
     2734               ,input  v-diasize-proc-name
     2735               ,input  'width':u
     2736               ,output v-resize-value-str
     2737               ) .
     2738             if v-resize-value-str <> '':U
     2739             then do:
     2740               run diasize_change-width in this-procedure
     2741                 (input  integer(v-resize-value-str)
     2742                 ,input  true
     2743                 ) .
     2744               assign
     2745                 v-restore-saved = true
     2746               .
     2747             end.
     2748           end.
     2749           if v-restore-saved <> true
     2750           then do:
     2751             if v-diasize-wndmax = true
     2752             then do:
     2753               run diasize_maximize in this-procedure
     2754                 (input  true
     2755                 ) .
     2756             end.
     2757           end.
     2758         end.
     2759         else do:
     2760           if v-diasize-wndmax = true
     2761           then do:
     2762             run diasize_maximize in this-procedure
     2763               (input  true
     2764               ) .
     2765           end.
     2766         end.
     2767       end.
     2768     end.
     2769   end procedure.
     2770   procedure diasize_need-full-display :
     2771     define output parameter p-need-full-display as logical   no-undo .
     2772     do
     2773     on error undo, return error return-value
     2774     :
     2775       assign
     2776         p-need-full-display = v-diasize-need-full-display
     2777       .
     2778       assign
     2779         v-diasize-need-full-display = false
     2780       .
     2781     end.
     2782   end procedure.
     2783   procedure get-context :
     2784      define output parameter p-db-num as integer          no-undo.
     2785      define output parameter p-user-id as character        no-undo.
     2786      define variable v-login               as character    no-undo.
     2787      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2788      define buffer buf_user-login  for ub.user-login .
     2789      do
     2790      on error undo, return error
     2791      :
     2792            FIND FIRST buf_sys-ctrl no-lock.
     2793            ASSIGN
     2794               v-login = USERID("ub")
     2795               p-db-num = buf_sys-ctrl.db-num
     2796            .
     2797            FIND FIRST buf_user-login
     2798                 WHERE buf_user-login.db-num = p-db-num
     2799                   AND buf_user-login.user-login = v-login
     2800                 no-lock
     2801                 no-error
     2802                 .
     2803            IF AVAILABLE buf_user-login
     2804            THEN DO:
     2805               assign
     2806                  p-user-id = buf_user-login.user-id
     2807               .
     2808            END.
     2809      end.
     2810   end procedure.
     2811       run diasize_init in this-procedure .
     2812   def var sort-labelBR-payment   as character no-undo .
     2813   def var sort-clmnBR-payment    as handle    no-undo .
     2814   def var cur-clmnBR-payment     as handle    no-undo .
     2815   def var cur-clmn-locBR-payment as integer   no-undo .
     2816   def var re-queryBR-payment     as logical   initial no no-undo .
     2817   on start-search, ctrl-o of BR-payment in frame Dialog-Frame do:
     2818      run sort-brBR-payment
     2819        (input (if available X_payment
     2820                then recid(X_payment)
     2821                else ?
     2822               )
     2823        ).
     2824   end.
     2825   PROCEDURE sort-brBR-payment :
     2826     define input parameter p-recid as recid no-undo .
     2827     if re-queryBR-payment = no then do:
     2828       assign
     2829          cur-clmnBR-payment = BR-payment:current-column in frame Dialog-Frame
     2830       .
     2831       if sort-clmnBR-payment <> ? then sort-clmnBR-payment:column-fgcolor = 0.
     2832       if cur-clmnBR-payment = sort-clmnBR-payment then do:
     2833         assign
     2834            sort-labelBR-payment = ""
     2835            sort-clmnBR-payment = ?
     2836         .
     2837        end.
     2838        else do:
     2839          assign
     2840            sort-labelBR-payment = cur-clmnBR-payment:label
     2841            sort-clmnBR-payment  = cur-clmnBR-payment
     2842            sort-clmnBR-payment:column-fgcolor = 4
     2843          .
     2844        end.
     2845      end.
     2846     assign
     2847       cur-clmn-locBR-payment = 1
     2848     .
     2849     def var column-handle as handle no-undo .
     2850     column-handle = BR-payment:first-column.
     2851     do while valid-handle(column-handle) :
     2852       if column-handle = cur-clmnBR-payment then do:
     2853         leave .
     2854       end.
     2855       column-handle = column-handle:NEXT-COLUMN.
     2856       assign
     2857         cur-clmn-locBR-payment = cur-clmn-locBR-payment + 1
     2858       .
     2859     end.
     2860     case sort-labelBR-payment:
     2861           when X_payment.pay-code:label in browse BR-payment then DO:   assign     sort-column-name = "X_payment.pay-code"   .   run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2862           when X_payment.exch-code:label in browse BR-payment then DO:   assign     sort-column-name = "X_payment.exch-code"   .   run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2863           when X_payment.creid:label in browse BR-payment then DO:   assign     sort-column-name = "X_payment.creid"   .   run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2864           when X_payment.closid:label in browse BR-payment then DO:   assign     sort-column-name = "X_payment.closid"   .   run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2865           when X_payment.tot-cli:label in browse BR-payment then DO:   assign     sort-column-name = "X_payment.tot-cli"   .   run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2866       otherwise do:
     2867         assign
     2868           sort-column-name = ""
     2869         .
     2870         run OpenBr in this-procedure ( input yes, input no, input '':U).
     2871           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-payment') then do:
     2872             run mv-brw-defaultBR-payment.
     2873           end.
     2874         if sort-labelBR-payment <> "" then do:
     2875           assign
     2876             cur-clmnBR-payment:column-fgcolor = 0
     2877           .
     2878         end.
     2879         assign
     2880           cur-clmn-locBR-payment = ?
     2881         .
     2882       end.
     2883     end case.
     2884       if cur-clmn-locBR-payment <> ? then do:
     2885         if can-do( this-procedure:internal-entries, 'ch-clmnBR-payment') then do:
     2886           run ch-clmnBR-payment in this-procedure (cur-clmn-locBR-payment).
     2887         end.
     2888       end.
     2889     if p-recid <> ? then do:
     2890       reposition BR-payment to recid p-recid no-error.
     2891       apply "value-changed" to BR-payment in frame Dialog-Frame.
     2892     end.
     2893     apply "entry" to BR-payment in frame Dialog-Frame.
     2894   END PROCEDURE.
     2895   procedure re-open-query-srt-clmnBR-payment:
     2896   if cur-clmnBR-payment = ? then do:
     2897      run OpenBr in this-procedure ( input yes, input no, input '':U).
     2898   end.
     2899   else do:
     2900      assign re-queryBR-payment = yes.
     2901      run sort-brBR-payment
     2902        (input (if available X_payment
     2903                then recid(X_payment)
     2904                else ?
     2905               )
     2906        ).
     2907      assign re-queryBR-payment = no.
     2908   end.
     2909   end.
