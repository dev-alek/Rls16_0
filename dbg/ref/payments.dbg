     1109   X_payment.exch-rate
     1110   X_payment.exch-scale
     1111   X_payment.base-rate
     1112   X_payment.base-scale
     1113   X_payment.due-date
     1114   X_payment.pay-code COLUMN-LABEL "Вид опл.!+сорт"
