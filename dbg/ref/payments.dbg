      571   procedure fltfield-add :
      572     define input        parameter par-fld as character no-undo.
      573     define input        parameter par-lab as character no-undo .
      574     define input        parameter par-spr as character no-undo .
      575     define input-output parameter loc-fld as character no-undo.
      576     define input-output parameter loc-lab as character no-undo .
      577     define input-output parameter loc-spr as character no-undo .
      578     define input-output parameter loc-dim as character no-undo .
      579     do
      580     on error undo, return error
      581     :
      582       assign
      583       loc-fld = if loc-dim = '0'
      584                 then par-fld
      585                 else (loc-fld + chr(44) + par-fld)
      586       loc-lab = if loc-dim = '0'
      587                 then par-lab
      588                 else (loc-lab + chr(44) + par-lab)
      589       loc-spr = if loc-dim = '0'
      590                 then par-spr
      591                 else (loc-spr + chr(44) + par-spr)
      592       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      593                 string(integer(if num-entries(loc-dim) > 1
      594                               then entry(2, loc-dim)
      595                               else entry(1, loc-dim)
      596                               ) + 1)
      597       no-error
      598       .
      599     end.
      600   end procedure.
      601   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      602   define variable v-waitfram-action01         as character   no-undo .
      603   define variable v-waitfram-action02         as character   no-undo .
      604   define variable v-waitfram-action03         as character   no-undo .
      605   define variable mWaitFramTextBeg            as character   no-undo.
      606   define variable mWaitFramTextEnd            as character   no-undo.
      607   define variable mWaitFramView               as logical     no-undo.
      608   define variable mWaitProcEvent              as logical     no-undo init yes.
      609   define variable mWaitFramInterval           as integer     no-undo init 1 .
      610   define variable mWaitFramStop               as logical     no-undo.
      611   define variable mWaitFramStopUser           as logical     no-undo.
      612   define variable mWaitFramStopTimeOut        as logical     no-undo.
      613   define variable mWaitFramStartProc          as datetime-tz no-undo.
      614   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      615   define button B-WaitFramStop auto-end-key
      616        label "Стоп"
      617        size 10 by 1 tooltip "Остоновить процесс".
      618   define button B-viewProcInfo
      619        label "Информация"
      620        size 15 by 1 tooltip "Информация о процесс".
      621   define frame waitfram
      622     v-waitfram-action01 format "x(72)" no-label skip
      623     v-waitfram-action02 format "x(72)" no-label skip
      624     v-waitfram-action03 format "x(72)" no-label skip
      625     B-viewProcInfo
      626     B-WaitFramStop at row 4 col 30
      627     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      628     .
      629   define new global shared variable mBatchMode as logical no-undo init ?.
      630   define variable mFramBachModHandle as handle no-undo.
      631   mFramBachModHandle = frame waitfram:handle.
      632   define variable mFameOldVis as logical no-undo.
      633   define variable mVisCUrentVin as logical no-undo.
      634   if session:batch-mode
      635   then
      636      mBatchMode = yes.
      637   if mBatchMode = ? then do:
      638     mVisCUrentVin = current-window:visible.
      639     mFameOldVis = mFramBachModHandle:visible.
      640     mFramBachModHandle:visible  = yes.
      641     mBatchMode = mFramBachModHandle:visible ne yes.
      642     mFramBachModHandle:visible = mFameOldVis.
      643     current-window:visible = mVisCUrentVin.
      644   end.
      645    if  log-manager:logfile-name ne ?
      646     then DO:
      647         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      648         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      649         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      650     end.
      651   on choose of B-WaitFramStop in frame waitfram
      652   do:
      653     mWaitFramStop = yes.
      654     mWaitFramStopUser = yes.
      655   end.
      656   function waitfram-check-timeout returns logical():
      657      define variable vtime as int64 no-undo.
      658      if mWaitFramStopTimeOut
      659      then
      660         return yes.
      661      vtime = ( now - mWaitFramStartProc ) / 1000 .
      662      if     mWaitFramTimeOut ne ?
      663         and mWaitFramTimeOut ne 0
      664         and mWaitFramTimeOut lt vtime
      665      then do:
      666         mWaitFramStopTimeOut = yes.
      667      end.
      668      return mWaitFramStopTimeOut.
      669   end.
      670   procedure waitfram-hide :
      671     if not session:batch-mode
      672     then do
      673     on error undo, return error return-value
      674     :
      675       pause 0 before-hide .
      676       if not mBatchMode then
      677         hide frame waitfram .
      678     if     not mWaitFramView
      679        and mWaitProcEvent
      680     then
      681       process events .
      682     end.
      683   end procedure.
      684   procedure waitfram-show :
      685     define input  parameter p-message as character no-undo .
      686     define variable v-left-margin as integer   no-undo .
      687     if not session:batch-mode
      688     then do
      689     on error undo, return error return-value
      690     :
      691       if length(p-message) <= 70 then do:
      692         assign
      693           v-left-margin = integer((70 - length(p-message)) / 2)
      694         .
      695         assign
      696           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      697         .
      698         assign
      699           v-waitfram-action01 = " "
      700           v-waitfram-action02 = " "
      701                                    + fill(" ", v-left-margin)
      702                                    + p-message
      703           v-waitfram-action03 = " "
      704         .
      705       end.
      706       else do:
      707         define variable vRindex1 as integer no-undo.
      708         define variable vRindex2 as integer no-undo.
      709         vRindex1 = r-index(p-message," ",70).
      710         if vRindex1 = 0
      711         then
      712            vRindex1 = 70.
      713         if length(p-message)  <= vRindex1 + 70 then do:
      714           assign
      715             v-waitfram-action01 = " "
      716             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      717             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      718           .
      719         end.
      720         else do:
      721           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      722           if vRindex2 <= vRindex1
      723           then
      724              vRindex2 = vRindex1 + 70.
      725           assign
      726             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      727             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      728             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      729           .
      730         end.
      731       end.
      732       B-viewProcInfo:visible   in frame waitfram = no.
      733       B-viewProcInfo:sensitive in frame waitfram = no.
      734       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      735       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      736       if  (   mWaitFramView
      737          or  mWaitProcEvent)
      738          and not mBatchMode
      739       then
      740          display
      741             v-waitfram-action01 skip
      742             v-waitfram-action02 skip
      743             v-waitfram-action03 skip
      744          with frame waitfram .
      745       if     mWaitFramView
      746          then do:
      747             if     mWaitFramInterval ne ?
      748                and not mBatchMode
      749             then
      750                wait-for go of frame waitfram pause mWaitFramInterval.
      751          end.
      752          else
      753             if     mWaitProcEvent
      754                and not mBatchMode
      755             then
      756                process events .
      757     end.
      758   end procedure.
      759      procedure waitfram-show-this:
      760         define input  parameter iInterval as int64 no-undo.
      761         define variable vtime as int64 no-undo.
      762         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      763         mWaitFramInterval = iInterval.
      764         run waitfram-show (substitute("&1&2 &3&4" ,
      765                                       mWaitFramTextBeg ,
      766                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      767                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      768                                       mWaitFramTextEnd
      769                                      )
      770                           ).
      771      end.
      772      procedure WaitFramRunPause:
      773         define input  parameter iInterval as dec no-undo.
      774         define variable vStart  as datetime-tz no-undo.
      775         define variable vend    as datetime-tz no-undo.
      776         define variable vint as int64 no-undo.
      777         define variable vOk as logical no-undo.
      778         vStart = now.
      779         vend   = vStart.
      780         publish "WaitFramPause" (iInterval,output vOk).
      781         vend   =  now.
      782         vint = vend - vStart.
      783         vint = iInterval - vint / 1000.
      784         if     not mWaitFramStop
      785            and (   vint > 0
      786                 or (    not vOk
      787                     and iInterval eq ?
      788                     )
      789                 )
      790         then
      791            run waitfram-show-this (iInterval).
      792         vend   =  now.
      793         vint = vend - vStart.
      794         vint = iInterval - vint / 1000.
      795         if     not mWaitFramStop
      796            and vint > 0
      797         then do:
      798            run gbl/pause.p (vint * 1000).
      799         end.
      800         if iInterval ne ?
      801         then
      802            publish "WaitFramStop".
      803         waitfram-check-timeout().
      804      end.
      805      procedure WaitFramWaitFor:
      806         define input  parameter iInterval as dec no-undo.
      807         assign
      808            mWaitFramStartProc   = now
      809            mWaitFramStopUser    = no
      810            mWaitFramStopTimeOut = no
      811         .
      812         block-wait:
      813         do while not mWaitFramStop:
      814            run WaitFramRunPause (iInterval).
      815            if  waitfram-check-timeout()
      816            then do:
      817               leave block-wait.
      818            end.
      819         end.
      820         run waitfram-hide.
      821      end.
      822   procedure waitfram-join :
      823     define input  parameter p-line-1  as character no-undo .
      824     define input  parameter p-line-2  as character no-undo .
      825     define input  parameter p-line-3  as character no-undo .
      826     define output parameter p-message as character no-undo .
      827     do
      828     on error undo, return error return-value
      829     :
      830       assign
      831         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      832                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      833                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      834       .
      835     end.
      836   end procedure.
      837   function waitfram-join-function returns character
      838     (input p-line-1 as character
      839     ,input p-line-2 as character
      840     ,input p-line-3 as character
      841     ).
      842     define variable v-message as character no-undo .
      843     run waitfram-join in this-procedure
      844       (input  p-line-1
      845       ,input  p-line-2
      846       ,input  p-line-3
      847       ,output v-message
      848       ) .
      849     return v-message .
      850   end function .
      851   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      852     define variable v-cntxt-db-num        as integer   no-undo .
      853     define variable v-cntxt-userid        as character no-undo .
      854     define variable v-cntxt-level         as character no-undo .
      855     define variable v-cntxt-host-code-obj as integer   no-undo .
      856     define variable v-cntxt-obj-type      as character no-undo .
      857     define variable v-cntxt-obj-code      as integer   no-undo .
      858     define variable v-cntxt-db-num-obj    as integer   no-undo .
      859     define variable v-cntxt-is-admin      as logical   no-undo .
      860   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      861   FUNCTION mark-string RETURNS CHARACTER
      862     ( input p-recid as recid, input mark-list as character  ) :
      863     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      864   END FUNCTION.
      865   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      866   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      867   procedure fltopend_fltopend :
      868   define input parameter p-parent-handle as handle no-undo .
      869   define input parameter p-qh as handle no-undo .
      870   define input parameter p-flt-open-open-query  as character no-undo .
      871   define input parameter p-where-cond as character no-undo .
      872   define input parameter p-use-indFIRST-query-tail as character no-undo .
      873   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      874   define input parameter p-indexed-reposition as character no-undo .
      875     do
      876     on error undo, return error
      877     :
      878   define variable v-prepare-string as character no-undo .
      879   define variable glog as logical no-undo .
      880   assign
      881   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      882                      p-where-cond + chr(32)  +
      883                      p-use-indFIRST-query-tail + chr(32) +
      884                      p-use-ind-sort-clmn-by + chr(32) +
      885                      p-indexed-reposition
      886   .
      887   assign
      888   glog = p-qh:query-prepare(v-prepare-string) no-error .
      889   if not glog
      890   or error-status:error then do:
      891     message error-status:get-message(1) view-as alert-box .
      892     undo, return error .
      893   end.
      894   assign
      895   glog = p-qh:query-open no-error .
      896   if not glog
      897   or error-status:error then do:
      898     message error-status:get-message(1) view-as alert-box .
      899     undo, return error .
      900   end.
      901     end.
      902   end procedure.
      903   procedure fltopend_fltfindd :
      904   define input parameter p-parent-handle as handle no-undo .
      905   define input parameter p-qh as handle no-undo .
      906   define input parameter p-rowid as rowid no-undo .
      907   define input parameter p-next as logical no-undo .
      908   define input parameter p-lock as integer no-undo .
      909   define input parameter p-bh as handle no-undo .
      910   define input parameter p-where-cond as character no-undo .
      911   define input parameter p-use-index-phrase as character no-undo .
      912   define variable glog as logical no-undo .
      913   define variable v-qh as handle no-undo .
      914   define variable v-bh as handle no-undo .
      915   define variable v-recid as recid no-undo .
      916   define variable v-prepare-string as character no-undo .
      917   do
      918   on error undo, return error
      919   on stop undo, return error
      920   :
      921     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      922     create buffer v-bh for table p-bh buffer-name p-bh:name.
      923     create query v-qh.
      924     v-qh:set-buffers(v-bh).
      925     v-prepare-string = substitute("for each &1 &2 &3"
      926                                     ,v-bh:name
      927                                     ,p-where-cond
      928                                     ,p-use-index-phrase).
      929     glog = v-qh:query-prepare(v-prepare-string) no-error.
      930     if not glog then do:
      931       delete object v-qh.
      932       delete object v-bh.
      933       undo, return error .
      934     end.
      935     glog = v-qh:query-open no-error .
      936     if not glog then do:
      937       delete object v-qh.
      938       delete object v-bh.
      939       undo, return error .
      940     end.
      941     if p-next then do:
      942       v-qh:reposition-to-rowid(p-rowid) no-error .
      943       glog = v-qh:get-next( p-lock) no-error .
      944       glog = v-qh:get-next( p-lock) no-error .
      945       if not glog or v-qh:query-off-end = yes then do:
      946         glog = v-qh:get-first( p-lock) no-error .
      947       end.
      948     end.
      949     else do:
      950       glog = v-qh:get-first( p-lock) no-error .
      951     end.
      952     v-recid = v-bh:recid no-error .
      953     delete object v-qh.
      954     delete object v-bh.
      955     return string(v-recid) .
      956   end.
      957   end procedure.
      958   procedure fltopend_fltfindq :
      959   define input parameter p-parent-handle as handle no-undo .
      960   define input parameter p-qh as handle no-undo .
      961   define input parameter p-next as logical no-undo .
      962   define input parameter p-lock as integer no-undo .
      963   define input parameter p-flt-open-open-query  as character no-undo .
      964   define input parameter p-where-cond as character no-undo .
      965   define input parameter p-use-indFIRST-query-tail as character no-undo .
      966   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      967   define input parameter p-indexed-reposition as character no-undo .
      968   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      969   define variable glog as logical no-undo .
      970   define variable v-qh as handle no-undo .
      971   define variable v-bh as handle no-undo extent 18.
      972   define variable v-rowid as rowid no-undo extent 18.
      973   define variable v-ii as integer no-undo .
      974   define variable v-prepare-string as character no-undo .
      975   do
      976   on error undo, return error
      977   on stop undo, return error
      978   :
      979     create query v-qh.
      980     do v-ii = 1 to p-qh:num-buffers:
      981       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      982       assign
      983       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      984       no-error.
      985       v-qh:add-buffer(v-bh[v-ii]).
      986     end.
      987     assign
      988     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      989                       p-where-cond + chr(32)  +
      990                       p-use-indFIRST-query-tail + chr(32) +
      991                       p-use-ind-sort-clmn-by + chr(32) +
      992                       p-indexed-reposition
      993     .
      994     glog = v-qh:query-prepare( v-prepare-string) no-error .
      995     if not glog then do:
      996       delete object v-qh.
      997       do v-ii = 1 to p-qh:num-buffers:
      998         delete object v-bh[v-ii].
      999       end.
     1000       undo, return error .
     1001     end.
     1002     glog = v-qh:query-open no-error .
     1003     if not glog then do:
     1004       delete object v-qh.
     1005       do v-ii = 1 to p-qh:num-buffers:
     1006         delete object v-bh[v-ii].
     1007       end.
     1008       undo, return error .
     1009     end.
     1010     if p-next then do:
     1011       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1012       glog = v-qh:get-next( p-lock) no-error .
     1013       glog = v-qh:get-next( p-lock) no-error .
     1014       if not glog or v-qh:query-off-end = yes then do:
     1015         glog = v-qh:get-first( p-lock) no-error .
     1016       end.
     1017     end.
     1018     else do:
     1019       glog = v-qh:get-first( p-lock) no-error .
     1020     end.
     1021     do v-ii = 1 to p-qh:num-buffers:
     1022       assign
     1023       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1024       no-error.
     1025     end.
     1026     delete object v-qh.
     1027     do v-ii = 1 to p-qh:num-buffers:
     1028       delete object v-bh[v-ii].
     1029     end.
     1030   end.
     1031   end procedure.
