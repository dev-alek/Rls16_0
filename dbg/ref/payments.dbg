     1094         mark-string( recid( X_payment ) , v-rid-list) COLUMN-LABEL "*" FORMAT "x(1)"
     1095   X_payment.pmnt-code FORMAT "X(19)"
     1096   X_payment.fact-date
     1097   X_payment.status_
     1098   X_payment.creid   column-label "Создал!+сорт"
     1099   X_payment.closid column-label "Закрыл!+сорт"
     1100   get-cli-name (buffer X_payment) COLUMN-LABEL "Контрагент" FORMAT "X(20)"
     1101   X_payment.source-type COLUMN-LABEL "К док-ту" format "X(16)"
     1102   X_payment.source-ref COLUMN-LABEL "N док-та" format "X(20)"
