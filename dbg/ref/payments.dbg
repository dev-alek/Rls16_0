     1392     end.
     1393   END.
     1394   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1395   DO:
     1396   define variable glog as logical no-undo .
     1397       if available X_payment then do:
     1398   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1399   define variable v-str-recid16 as character no-undo .
     1400   define variable v-num-entry16 as integer   no-undo .
     1401   assign
     1402     v-str-recid16 = trim( string( recid( X_payment ) , "->>>>>>>>>>>9":U ) )
     1403     v-num-entry16 = lookup( v-str-recid16 , v-rid-list )
     1404   .
     1405   if v-num-entry16 > 0 then do:
     1406     assign
     1407       entry( v-num-entry16, v-rid-list ) = "":U
     1408       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1409     .
     1410   end.
     1411   else do:
     1412     assign
     1413       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid16
     1414     .
     1415   end.
     1416         glog = br-payment:refresh() .
     1417         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1418             glog = br-payment:select-next-row ().
     1419             apply "iteration-changed" to br-payment in frame Dialog-Frame.
     1420         end.
     1421         if num-entries( v-rid-list ) = 0
     1422         then
     1423             hide mark-num in frame Dialog-Frame.
     1424         else
     1425             disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1426       end.
     1427       apply "entry" to br-payment in frame Dialog-Frame.
     1428   END.
     1429   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1430   DO:
     1431   define variable v-doc-rec as recid no-undo .
     1432     v-doc-rec = recid( X_payment ).
     1433     DO WHILE available X_payment :
     1434         GET prev br-payment.
     1435     END.
     1436     run b-print-proc no-error.
     1437     if error-status:error then do:
     1438       return no-apply.
     1439     end.
     1440     reposition br-payment to recid v-doc-rec no-error.
     1441     apply "entry" to br-payment in frame Dialog-Frame.
     1442   END.
