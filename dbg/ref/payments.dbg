     1116   ENABLE X_payment.tot-cli
     1117       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16.17.
     1118   DEFINE FRAME Dialog-Frame
     1119        B-quit AT ROW 1 COL 1.13
     1120        B-sel AT ROW 1 COL 11
     1121        B-mark AT ROW 1 COL 21
     1122        B-add AT ROW 1 COL 24
     1123        B-lkp AT ROW 1 COL 34
     1124        B-chg AT ROW 1 COL 44
     1125        B-del AT ROW 1 COL 54
     1126        B-print AT ROW 1 COL 89
     1127        B-sch AT ROW 1 COL 92
     1128        B-Help AT ROW 1 COL 95
     1129        BR-payment AT ROW 3.21 COL 1.13
     1130        ed-notes AT ROW 19.63 COL 1.13 NO-LABEL
     1131        mark-num AT ROW 2.17 COL 2.88 NO-LABEL
     1132        SPACE(86.34) SKIP(18.85)
     1133       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1134            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1135            TITLE "Платежи"
     1136            DEFAULT-BUTTON B-quit.
     1137   ASSIGN
     1138          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1139          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1140   ASSIGN
     1141          BR-payment:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 4.
     1142   ON GO OF FRAME Dialog-Frame
     1143   DO:
     1144     ASSIGN
     1145     p-rid-list = v-rid-list.
     1146   END.
     1147   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1148   DO:
     1149     APPLY "END-ERROR":U TO SELF.
     1150   END.
     1151   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1152   DO:
     1153     define variable rid as recid no-undo init ?.
     1154     define variable glog as logical no-undo .
     1155   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1156   do:
     1157     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1158       (input  v-cntxt-db-num
     1159       ,input  v-cntxt-userid
     1160       ,input  0
     1161       ,input  'actn_payments-expected_work':U
     1162       ,input  'firm':U
     1163       ,input  v-cntxt-host-code-obj
     1164       ,input  '':U
     1165       ,input  0
     1166       ,input  0
     1167       ,input  0
     1168       ,input  0
     1169       ,input  true
     1170       ,output glog
     1171       )  .
     1172   end.
     1173     if NOT glog then do:
     1174       return no-apply.
     1175     end.
     1176     case p-list-mode:
     1177       when 'документы':U then do:
     1178         if loc-source-type = 'заказ':U and loc-source-ref <> ""  then do:
     1179           run ref/paymento.w (
     1180                           input parparentproc
     1181                          ,input 'ДОБАВЛЕНИЕ':U
     1182                          ,input-output rid
     1183                          ,input buf-cli.obj-type
     1184                          ,input buf-cli.obj-code
     1185                          ,input v-cntxt-host-code-obj
     1186                          ,input loc-source-type
     1187                          ,input loc-source-ref
     1188                          ,input '':U
     1189                          ,input ?
     1190                          ,input ?
     1191                          ,input ?
     1192                          ,input ?
     1193                          ,input ?
     1194                          ,input ?
     1195                          ,input ?
     1196                          ,input ?
     1197                          ,input ?
     1198                          ) no-error .
     1199           if rid = ? then return no-apply.
     1200           else do:
     1201             run openbr in this-procedure ( input yes, input no, input '':U).
     1202             reposition br-payment to recid rid no-error.
     1203             APPLY "Value-CHanged" to br-payment.
     1204             APPLY "ENTRY" to br-payment.
     1205           end.
     1206         end.
     1207       end.
     1208       when 'карта':U then do:
     1209         run ref/paymento.w (
     1210                          input parparentproc
     1211                         ,input 'ДОБАВЛЕНИЕ':U
     1212                         ,input-output rid
     1213                         ,input buf-cli-card.obj-type
     1214                         ,input buf-cli-card.obj-code
     1215                         ,input v-cntxt-host-code-obj
     1216                         ,input 'payment':U
     1217                         ,input '':U
     1218                         ,input buf_dis-card.d-card
     1219                         ,input ?
     1220                         ,input ?
     1221                         ,input ?
     1222                         ,input ?
     1223                         ,input ?
     1224                         ,input ?
     1225                         ,input ?
     1226                         ,input ?
     1227                         ,input ?
     1228                         ) no-error .
     1229         if rid = ? then return no-apply.
     1230         else do:
     1231           run openbr in this-procedure ( input yes, input no, input '':U).
     1232           reposition br-payment to recid rid no-error.
     1233           APPLY "Value-CHanged" to br-payment.
     1234           APPLY "ENTRY" to br-payment.
     1235         end.
     1236       end.
     1237       otherwise do:
     1238         "BELL".
     1239       end.
     1240     END CASE.
     1241   END.
     1242   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1243   DO:
     1244     define variable rid as recid no-undo init ?.
     1245     define variable glog as logical no-undo .
     1246   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1247   do:
     1248     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1249       (input  v-cntxt-db-num
     1250       ,input  v-cntxt-userid
     1251       ,input  0
     1252       ,input  'actn_payments-expected_work':U
     1253       ,input  'firm':U
     1254       ,input  v-cntxt-host-code-obj
     1255       ,input  '':U
     1256       ,input  0
     1257       ,input  0
     1258       ,input  0
     1259       ,input  0
     1260       ,input  true
     1261       ,output glog
     1262       )  .
     1263   end.
     1264     if NOT glog then do:
     1265       return no-apply.
     1266     end.
     1267     if avail X_payment and X_payment.status_ <> 'факт':U then do:
     1268       rid = recid(X_payment).
     1269       case p-list-mode:
     1270         when 'документы':U then do:
     1271           if loc-source-type = 'заказ':U and loc-source-ref <> ""  then do:
     1272             run ref/paymento.w (input parparentproc
     1273                            ,input 'ИЗМЕНЕНИЕ':U
     1274                            ,input-output rid
     1275                            ,input buf-cli.obj-type
     1276                            ,input buf-cli.obj-code
     1277                            ,input v-cntxt-host-code-obj
     1278                            ,input loc-source-type
     1279                            ,input loc-source-ref
     1280                            ,input X_payment.d-card
     1281                            ,input ?
     1282                            ,input ?
     1283                            ,input ?
     1284                            ,input ?
     1285                            ,input ?
     1286                            ,input ?
     1287                            ,input ?
     1288                            ,input ?
     1289                            ,input ?
     1290                            ) .
     1291             if rid = ? then return no-apply.
     1292             else do:
     1293               run openbr in this-procedure ( input yes, input no, input '':U).
     1294               reposition br-payment to recid rid no-error.
     1295               APPLY "Value-CHanged" to br-payment.
     1296               APPLY "ENTRY" to br-payment.
     1297             end.
     1298           end.
     1299         end.
     1300         otherwise do:
     1301             "BELL".
     1302         end.
     1303       END CASE.
     1304     end.
     1305   END.
     1306   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1307   DO:
     1308     define buffer for-payment for ub.payment.
     1309     define variable glog as logical no-undo .
     1310     if avail X_payment and X_payment.status_ <> 'факт':U then do:
     1311   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1312   do:
     1313     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1314       (input  v-cntxt-db-num
     1315       ,input  v-cntxt-userid
     1316       ,input  0
     1317       ,input  'actn_payments-expected_work':U
     1318       ,input  'firm':U
     1319       ,input  v-cntxt-host-code-obj
     1320       ,input  '':U
     1321       ,input  0
     1322       ,input  0
     1323       ,input  0
     1324       ,input  0
     1325       ,input  true
     1326       ,output glog
     1327       )  .
     1328   end.
     1329       if NOT glog then do:
     1330         return no-apply.
     1331       end.
     1332       find first for-payment where
     1333                  recid(for-payment) = recid(X_payment) exclusive-lock no-wait no-error.
     1334       if locked for-payment or
     1335                 not avail for-payment OR
     1336                 NOT for-payment.status_ = 'ожид':U then return no-apply.
     1337       else do:
     1338           delete for-payment no-error.
     1339           if error-status:error then return no-apply.
     1340           run OpenBr in this-procedure ( input yes, input no, input '':U).
     1341           reposition br-payment to row 1 no-error.
     1342           if error-status:error then do:
     1343               ed-notes = "".
     1344               display
     1345               ed-notes
     1346               WITH FRAME Dialog-Frame.
     1347           end.
     1348           APPLY "ENTRY" to br-payment.
     1349       end.
     1350     end.
     1351   END.
     1352   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
     1353   DO:
     1354     define variable rid as recid no-undo init ?.
