     4212           " " + "  "
     4213           )
     4214                              else
     4215           (
     4216           " " + " use-index source " +
     4217             " " + sort-column-phrase +
     4218           " " + sort-phrase-47
     4219           )
     4220         parameter-7-47 =
     4221           " indexed-reposition  "
     4222       .
     4223       do
     4224       on stop undo, leave
     4225       on error undo, leave
     4226       :
     4227         assign
     4228           l-disable-where-47 =
     4229             ("X_payment.host-code = v-cntxt-host-code-obj              AND X_payment.source-type = loc-source-type              AND X_payment.source-ref = loc-source-ref
     4230                AND X_payment.status_ = 'факт':U " + " " + where-phrase-47 = "")
     4231         .
     4232         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4233                             ,input QUERY br-payment:handle
     4234                             ,input parameter-3-47
     4235                             ,input parameter-4-47
     4236                             ,input parameter-5-47
     4237                             ,input parameter-6-47
     4238                             ,input parameter-7-47
     4239                             )
     4240         .
     4241         assign
     4242           l-filter-open-47 = true
     4243         .
     4244       end.
     4245       if l-filter-open-47 = false then do:
     4246         message
     4247           "Ошибка при фильтрации / сортировке" skip
     4248           "Будут показаны записи без учета фильтра" skip
     4249           view-as alert-box .
     4250       end.
     4251       else do:
     4252           assign
     4253             l-query-was-opened = true
     4254           .
     4255       end.
     4256     end.
     4257     if l-filter-open-47 = false then do:
     4258       OPEN QUERY br-payment FOR EACH X_payment
     4259         where X_payment.host-code = v-cntxt-host-code-obj              AND X_payment.source-type = loc-source-type              AND X_payment.source-ref = loc-source-ref
     4260                AND X_payment.status_ = 'факт':U
     4261          use-index source
     4262         indexed-reposition
     4263     .
     4264         assign
     4265           l-query-was-opened = true
     4266         .
     4267     end.
     4268     run waitfram-hide in this-procedure .
     4269       end.
     4270       when 'карта':U then do:
     4271            FIND FIRST buf_dis-card NO-LOCK WHERE
     4272                       buf_dis-card.d-card = loc-d-card NO-ERROR.
     4273            if avail buf_dis-card then do:
     4274               FIND FIRST buf-cli-card No-LOCK WHERE
     4275                          buf-cli-card.obj-type = buf_dis-card.cli-type
     4276                      AND buf-cli-card.obj-code = buf_dis-card.cli-code NO-ERROR.
     4277            end.
     4278            ASSIGN
     4279            frame Dialog-Frame:TITLE = substitute("ПЛАТЕЖИ ПО КАРТЕ &1 ПО ФИРМЕ &2 КЛИЕНТА &3"
     4280                                                   ,buf_Dis-card.d-card
     4281                                                   ,v-host-name
     4282                                                   ,string(IF AVAIL buf-cli-card
     4283                                                           then string(buf-cli-card.obj-name, "X(20)")
     4284                                                           else "")
     4285                                                   )
     4286            filter-point = filter-point0 + p-list-mode
     4287            filter-label = substitute("&1 Одна фирма, одна карта", filter-label0)
     4288            .
     4289   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4290   define variable  l-disable-where-49  as logical   no-undo .
     4291   define variable  l-filter-open-49    as logical   .
     4292   define variable  flt-rec-49       as recid     no-undo .
     4293   define variable  filter-name-49      as character no-undo .
     4294   define variable  where-phrase-49     as character no-undo .
     4295   define variable  sort-phrase-49      as character no-undo .
     4296   define variable  where-phrase-rus-49 as character no-undo .
     4297   define variable  sort-phrase-rus-49  as character no-undo .
     4298     run waitfram-show in this-procedure
     4299       (input "ЖДИТЕ ..."
     4300       ).
     4301   run gbl/flt-get.p
     4302     (input filter-point
     4303     ,output flt-rec-49
     4304     ,output filter-name-49
     4305     ,output where-phrase-49
     4306     ,output sort-phrase-49
     4307     ,output where-phrase-rus-49
     4308     ,output sort-phrase-rus-49
     4309     ).
     4310       run set-filter-name in this-procedure
     4311         (INPUT filter-name-49
     4312         ) no-error .
     4313     assign
     4314       l-filter-open-49 = false
     4315     .
     4316     if flt-rec-49 <> ?
     4317       or sort-column-phrase > ""
     4318     then do:
     4319       define variable  parameter-2-49 as character no-undo .
     4320       define variable  parameter-3-49 as character no-undo .
     4321       define variable  parameter-4-49 as character no-undo .
     4322       define variable  parameter-5-49 as character no-undo .
     4323       define variable  parameter-6-49 as character no-undo .
     4324       define variable  parameter-7-49 as character no-undo .
     4325         assign
     4326         parameter-3-49 =
     4327                                 "FOR EACH X_payment"
     4328         parameter-4-49 =
     4329           (
     4330             if ("X_payment.host-code = v-cntxt-host-code-obj              AND X_payment.d-card = loc-d-card " + " " + where-phrase-49) <> ""
     4331             then  substitute('X_payment.host-code = &1              AND X_payment.d-card = &2&3&2 ', v-cntxt-host-code-obj, chr(34), loc-d-card) + " " + where-phrase-49
     4332             else "true"
     4333           )
     4334         parameter-5-49 = (" " + "" + " " + "")
     4335         parameter-6-49 = if sort-phrase-49 = ''
     4336                              then
     4337           (
     4338           " " + " use-index d-card  " +
     4339             " " + sort-column-phrase +
     4340           " " + "  "
     4341           )
     4342                              else
     4343           (
     4344           " " + " use-index d-card  " +
     4345             " " + sort-column-phrase +
     4346           " " + sort-phrase-49
     4347           )
     4348         parameter-7-49 =
     4349           " indexed-reposition  "
     4350       .
     4351       do
     4352       on stop undo, leave
     4353       on error undo, leave
     4354       :
     4355         assign
     4356           l-disable-where-49 =
     4357             ("X_payment.host-code = v-cntxt-host-code-obj              AND X_payment.d-card = loc-d-card " + " " + where-phrase-49 = "")
     4358         .
     4359         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4360                             ,input QUERY br-payment:handle
     4361                             ,input parameter-3-49
     4362                             ,input parameter-4-49
     4363                             ,input parameter-5-49
     4364                             ,input parameter-6-49
     4365                             ,input parameter-7-49
     4366                             )
     4367         .
     4368         assign
     4369           l-filter-open-49 = true
     4370         .
     4371       end.
     4372       if l-filter-open-49 = false then do:
     4373         message
     4374           "Ошибка при фильтрации / сортировке" skip
     4375           "Будут показаны записи без учета фильтра" skip
     4376           view-as alert-box .
     4377       end.
     4378       else do:
     4379           assign
     4380             l-query-was-opened = true
     4381           .
     4382       end.
     4383     end.
     4384     if l-filter-open-49 = false then do:
     4385       OPEN QUERY br-payment FOR EACH X_payment
     4386         where X_payment.host-code = v-cntxt-host-code-obj              AND X_payment.d-card = loc-d-card
     4387          use-index d-card
     4388         indexed-reposition
     4389     .
     4390         assign
     4391           l-query-was-opened = true
     4392         .
     4393     end.
     4394     run waitfram-hide in this-procedure .
     4395       end.
     4396   END CASE.
     4397   run waitfram-hide in this-procedure .
     4398   APPLY "VALUE-CHANGED" TO br-payment.
     4399   APPLY "ENTRY" TO br-payment.
     4400   END PROCEDURE.
     4401   FUNCTION get-cli-name RETURNS CHARACTER
     4402     (buffer loc-payment for ub.payment ) :
     4403   define buffer buf_clients for ub.clients.
     4404       define variable dop like ub.clients.obj-name.
     4405       FIND FIRST buf_clients NO-LOCK WHERE
     4406                 buf_clients.obj-type = loc-payment.cli-type
     4407             AND buf_clients.obj-code = loc-payment.cli-code
     4408       No-ERROR.
     4409       IF avail buf_clients then dop = buf_clients.obj-name.
     4410       ELSE dop = "".
     4411     RETURN dop.
     4412   END FUNCTION.
     4413   FUNCTION get-full-source RETURNS CHARACTER
     4414      (buffer loc-payment for ub.payment ) :
     4415       define variable dop as char.
     4416       dop = loc-payment.source-type.
     4417     RETURN dop.
     4418   END FUNCTION.
     4419   FUNCTION get-payer-name RETURNS CHARACTER
     4420     (buffer loc-payment for ub.payment ) :
     4421       define variable dop like ub.clients.obj-name.
     4422       define buffer buf_clients for ub.clients.
     4423       FIND FIRST buf_clients NO-LOCK WHERE
     4424                 buf_clients.obj-type = loc-payment.payer-type
     4425             AND buf_clients.obj-code = loc-payment.payer-code
     4426       No-ERROR.
     4427       IF avail buf_clients then dop = buf_clients.obj-name.
     4428       ELSE dop = "".
     4429     RETURN dop.
     4430   END FUNCTION.
