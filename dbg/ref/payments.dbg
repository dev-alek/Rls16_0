     1357           message "Выбран платеж другой фирмы!"
     1358           view-as alert-box.
     1359           return no-apply.
     1360       end.
     1361        rid = recid(X_payment).
     1362       case p-list-mode:
     1363         when 'документы':U then do:
     1364           if loc-source-type = 'заказ':U and loc-source-ref <> ""  then do:
     1365             run ref/paymento.w (
     1366                                   input parparentproc
     1367                                 ,input 'ПРОСМОТР':U
     1368                                 ,input-output rid
     1369                                 ,input buf-cli.obj-type
     1370                                 ,input buf-cli.obj-code
     1371                                 ,input v-cntxt-host-code-obj
     1372                                 ,input loc-source-type
     1373                                 ,input loc-source-ref
     1374                                 ,input X_payment.d-card
     1375                                 ,input ?
     1376                                 ,input ?
     1377                                 ,input ?
     1378                                 ,input ?
     1379                                 ,input ?
     1380                                 ,input ?
     1381                                 ,input ?
     1382                                 ,input ?
     1383                                 ,input ?
     1384                                 ) .
     1385             APPLY "ENTRY" to br-payment.
