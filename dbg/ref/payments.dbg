     3302     (input filter-point
     3303     ,output flt-rec-33
     3304     ,output filter-name-33
     3305     ,output where-phrase-33
     3306     ,output sort-phrase-33
     3307     ,output where-phrase-rus-33
     3308     ,output sort-phrase-rus-33
     3309     ).
     3310       run set-filter-name in this-procedure
     3311         (INPUT filter-name-33
     3312         ) no-error .
     3313     assign
     3314       l-filter-open-33 = false
     3315     .
     3316     if flt-rec-33 <> ?
     3317       or sort-column-phrase > ""
     3318     then do:
     3319       define variable  parameter-2-33 as character no-undo .
     3320       define variable  parameter-3-33 as character no-undo .
     3321       define variable  parameter-4-33 as character no-undo .
     3322       define variable  parameter-5-33 as character no-undo .
     3323       define variable  parameter-6-33 as character no-undo .
     3324       define variable  parameter-7-33 as character no-undo .
     3325         assign
     3326         parameter-3-33 =
     3327                                 "FOR EACH X_payment"
     3328         parameter-4-33 =
     3329           (
     3330             if (" X_payment.host-code = v-cntxt-host-code-obj " + " " + where-phrase-33) <> ""
     3331             then  substitute('X_payment.host-code = &1', v-cntxt-host-code-obj ) + " " + where-phrase-33
     3332             else "true"
     3333           )
     3334         parameter-5-33 = (" " + "" + " " + "")
     3335         parameter-6-33 = if sort-phrase-33 = ''
     3336                              then
     3337           (
     3338           " " + " use-index fact-date " +
     3339             " " + sort-column-phrase +
     3340           " " + "  "
     3341           )
     3342                              else
     3343           (
     3344           " " + " use-index fact-date " +
     3345             " " + sort-column-phrase +
     3346           " " + sort-phrase-33
     3347           )
     3348         parameter-7-33 =
     3349           " indexed-reposition  "
     3350       .
     3351       do
     3352       on stop undo, leave
     3353       on error undo, leave
     3354       :
     3355         assign
     3356           l-disable-where-33 =
     3357             (" X_payment.host-code = v-cntxt-host-code-obj " + " " + where-phrase-33 = "")
     3358         .
     3359         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3360                             ,input QUERY br-payment:handle
     3361                             ,input parameter-3-33
     3362                             ,input parameter-4-33
     3363                             ,input parameter-5-33
     3364                             ,input parameter-6-33
     3365                             ,input parameter-7-33
     3366                             )
     3367         .
     3368         assign
     3369           l-filter-open-33 = true
     3370         .
     3371       end.
     3372       if l-filter-open-33 = false then do:
     3373         message
     3374           "Ошибка при фильтрации / сортировке" skip
     3375           "Будут показаны записи без учета фильтра" skip
     3376           view-as alert-box .
     3377       end.
     3378       else do:
     3379           assign
     3380             l-query-was-opened = true
     3381           .
     3382       end.
