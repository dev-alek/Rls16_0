     2854   PROCEDURE sort-brbr-gds-hist :
     2855     define input parameter p-recid as recid no-undo .
     2856     if re-querybr-gds-hist = no then do:
     2857       assign
     2858          cur-clmnbr-gds-hist = br-gds-hist:current-column in frame Dialog-Frame
     2859       .
     2860       if sort-clmnbr-gds-hist <> ? then sort-clmnbr-gds-hist:column-fgcolor = 0.
     2861       if cur-clmnbr-gds-hist = sort-clmnbr-gds-hist then do:
     2862         assign
     2863            sort-labelbr-gds-hist = ""
     2864            sort-clmnbr-gds-hist = ?
     2865         .
     2866        end.
     2867        else do:
     2868          assign
     2869            sort-labelbr-gds-hist = cur-clmnbr-gds-hist:label
     2870            sort-clmnbr-gds-hist  = cur-clmnbr-gds-hist
     2871            sort-clmnbr-gds-hist:column-fgcolor = 4
     2872          .
     2873        end.
     2874      end.
     2875     assign
     2876       cur-clmn-locbr-gds-hist = 1
     2877     .
     2878     def var column-handle as handle no-undo .
     2879     column-handle = br-gds-hist:first-column.
     2880     do while valid-handle(column-handle) :
     2881       if column-handle = cur-clmnbr-gds-hist then do:
     2882         leave .
     2883       end.
     2884       column-handle = column-handle:NEXT-COLUMN.
     2885       assign
     2886         cur-clmn-locbr-gds-hist = cur-clmn-locbr-gds-hist + 1
     2887       .
     2888     end.
     2889     case sort-labelbr-gds-hist:
     2890           when X_c-gds-hist.gds-code:label in browse br-gds-hist then DO:    assign       sort-column-name = "X_c-gds-hist.gds-code"     .     run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).   . END.
     2891           when X_c-prod-bc.b-code:label in browse br-gds-hist then DO:    assign       sort-column-name = "X_c-prod-bc.b-code"     .     run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).   . END.
     2892           when X_c-gds-hist.corr-date:label in browse br-gds-hist then DO:    assign       sort-column-name = "X_c-gds-hist.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).   . END.
     2893           when X_c-gds-hist.corr-user-db-num:label in browse br-gds-hist then DO:    assign       sort-column-name = "X_c-gds-hist.corr-user-db-num"     .     run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).   . END.
     2894       otherwise do:
     2895         assign
     2896           sort-column-name = ""
     2897         .
     2898         run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).
     2899           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-gds-hist') then do:
     2900             run mv-brw-defaultbr-gds-hist.
     2901           end.
     2902         if sort-labelbr-gds-hist <> "" then do:
     2903           assign
     2904             cur-clmnbr-gds-hist:column-fgcolor = 0
     2905           .
     2906         end.
     2907         assign
     2908           cur-clmn-locbr-gds-hist = ?
     2909         .
     2910       end.
     2911     end case.
     2912       if cur-clmn-locbr-gds-hist <> ? then do:
     2913         if can-do( this-procedure:internal-entries, 'ch-clmnbr-gds-hist') then do:
     2914           run ch-clmnbr-gds-hist in this-procedure (cur-clmn-locbr-gds-hist).
     2915         end.
     2916       end.
     2917     if p-recid <> ? then do:
     2918       reposition br-gds-hist to recid p-recid no-error.
     2919       apply "value-changed" to br-gds-hist in frame Dialog-Frame.
     2920     end.
     2921     apply "entry" to br-gds-hist in frame Dialog-Frame.
     2922   END PROCEDURE.
     2923   procedure re-open-query-srt-clmnbr-gds-hist:
     2924   if cur-clmnbr-gds-hist = ? then do:
     2925      run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).
     2926   end.
     2927   else do:
     2928      assign re-querybr-gds-hist = yes.
     2929      run sort-brbr-gds-hist
