     3934   PROCEDURE proc-b-print :
     3935   define variable date_string     as      char    no-undo.
     3936   define variable Line                as      char    no-undo.
     3937   define variable for-time as char.
     3938   define variable accum-count as integer.
     3939   define variable v-doc-rec as recid no-undo.
     3940   define variable v-prod as character no-undo .
     3941   define variable v-subject-chr as character no-undo .
