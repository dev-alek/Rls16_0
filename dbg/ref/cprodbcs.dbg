     4077   br-changes:title in frame Dialog-Frame = v-description
     4078   .
     4079   END PROCEDURE.
     4080   FUNCTION get-action RETURNS CHARACTER
     4081     ( p-action as integer ) :
     4082     define variable dops as character no-undo.
     4083   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4084   RETURN dops.
     4085   END FUNCTION.
     4086   FUNCTION get-good RETURNS CHARACTER
     4087     ( p-b-code as integer, output p-artic as character, output p-prod-type as character, output p-prod-code as integer ) :
     4088   define buffer buf_goods for ub.goods.
     4089   define buffer buf_bar-code for ub.bar-code.
     4090   find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error.
     4091   if not available buf_bar-code then do:
     4092       return "!!! Неизвестный товар!!!".
     4093   end.
     4094   find first buf_goods no-lock where buf_goods.gds-code = buf_bar-code.gds-code no-error.
     4095   if not available buf_goods then do:
     4096       return "!!! Неизвестный товар!!!".
     4097   end.
     4098   assign
     4099   p-artic =  buf_goods.artic
     4100   p-prod-type =  buf_goods.prod-type
     4101   p-prod-code =  buf_goods.prod-code
     4102   .
     4103     RETURN buf_goods.gds-name.
     4104   END FUNCTION.
     4105   FUNCTION get-source-type RETURNS CHARACTER
     4106     ( p-source-type as character ) :
     4107   define variable v-dop as character no-undo .
     4108   assign
     4109   v-dop =  entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U) no-error
     4110   .
     4111     RETURN v-dop .
     4112   END FUNCTION.
     4113   FUNCTION get-subject RETURNS CHARACTER
     4114     ( p-subject as character ) :
     4115     RETURN entry (lookup (p-subject, 'goods,goods-attr,gds-host-attr,gds-obj-attr,fbr-gds-obj,s-coeff,bar-code,bar-code-attr,bar-code-obj-attr,prod-bc,varianty-delivery-gds-obj,gds-season,tax-rate-gds,assortment-matrix-goods,gds-obj-prop,pl-gds,pl-gds-pump,sert-join,pl-gds-attr,dis-gds-rule,ext-artic,ext-classif,recipe,recipe-gds,gds-obj,gds-obj-prop-attr':U), 'Товар,Атр-т товара,Атр-т тов. на фирме,Атр-т тов. на объекте,Атрибут РЕСТОРАНа,Сезонный коэфф,Бар-код,Атрибуты бар-кодов,Атрибуты бар-кода на объекте,ДопБК,Варианты доставки,Сезон товара,Ставки налогов,Содержимое ассортиментных матр,Индикаторы,Товар на складском месте,Товар на ТРК,Сертификат на товар,АттрТовара на скл.месте,Скидка Товара на объ.,Внешний артикул товара,Внешний классификатор,Рецепт,Товар рецепта,Товар на объекте,Атр-т тов. для заказов':U).
     4116   END FUNCTION.
