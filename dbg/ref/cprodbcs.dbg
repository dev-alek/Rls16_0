     2807   procedure get-context :
     2808      define output parameter p-db-num as integer          no-undo.
     2809      define output parameter p-user-id as character        no-undo.
     2810      define variable v-login               as character    no-undo.
     2811      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2812      define buffer buf_user-login  for ub.user-login .
     2813      do
     2814      on error undo, return error
     2815      :
     2816            FIND FIRST buf_sys-ctrl no-lock.
     2817            ASSIGN
     2818               v-login = USERID("ub")
     2819               p-db-num = buf_sys-ctrl.db-num
     2820            .
     2821            FIND FIRST buf_user-login
     2822                 WHERE buf_user-login.db-num = p-db-num
     2823                   AND buf_user-login.user-login = v-login
     2824                 no-lock
     2825                 no-error
     2826                 .
     2827            IF AVAILABLE buf_user-login
     2828            THEN DO:
     2829               assign
     2830                  p-user-id = buf_user-login.user-id
     2831               .
     2832            END.
     2833      end.
     2834   end procedure.
     2835   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2836   on f5 of frame Dialog-Frame anywhere
