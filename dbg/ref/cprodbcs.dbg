     2841   def var sort-labelbr-gds-hist   as character no-undo .
     2842   def var sort-clmnbr-gds-hist    as handle    no-undo .
     2843   def var cur-clmnbr-gds-hist     as handle    no-undo .
     2844   def var cur-clmn-locbr-gds-hist as integer   no-undo .
     2845   def var re-querybr-gds-hist     as logical   initial no no-undo .
     2846   on start-search, ctrl-o of br-gds-hist in frame Dialog-Frame do:
