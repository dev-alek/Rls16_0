     3163                                                                            .
     3164   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3165   define variable  l-disable-where-23  as logical   no-undo .
     3166   define variable  l-filter-open-23    as logical   .
     3167   define variable  flt-rec-23       as recid     no-undo .
     3168   define variable  filter-name-23      as character no-undo .
     3169   define variable  where-phrase-23     as character no-undo .
     3170   define variable  sort-phrase-23      as character no-undo .
     3171   define variable  where-phrase-rus-23 as character no-undo .
     3172   define variable  sort-phrase-rus-23  as character no-undo .
     3173     run waitfram-show in this-procedure
     3174       (input "ЖДИТЕ ..."
     3175       ).
