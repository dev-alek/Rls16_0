     3944   define variable v-action-chr as character no-undo .
     3945   define variable v-source-type as character no-undo .
     3946   DEFINE VARIABLE v-for-user-name AS CHARACTER NO-UNDO.
     3947   DEFINE FRAME HistoryList
     3948   X_c-gds-hist.gds-code
     3949   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     3950   v-gds-name COLUMN-LABEL "Назв. товара" FORMAT "X(20)"
     3951   v-artic COLUMN-LABEL "Артикул" FORMAT "X(14)"
     3952   v-prod COLUMN-LABEL "Пр-ль" FORMAT "X(12)"
     3953   X_c-gds-hist.is-news COLUMn-LABEL "СПН" FORMAT "+/ "
     3954   v-source-type COLUMn-LABEL "Источн.!измен"
     3955   X_c-gds-hist.source-ref COLUMn-LABEL "№"
     3956   X_c-gds-hist.corr-date
     3957   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     3958   v-for-user-name COLUMN-LABEL "Изменил" FORMAT "X(18)"
     3959   X_c-gds-hist.corr-user-db-num
     3960   HEADER  date_string AT 5 format "X(35)"
     3961   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3962   Line format "X(195)" AT 1
     3963   with width 232 down stream-io use-text    .
     3964   Line = fill("-", 195).
     3965   date_string = cur-time-print() .
     3966   assign
     3967   v-doc-rec = recid( X_c-gds-hist ).
     3968   DO WHILE available X_c-gds-hist :
     3969         GET prev br-gds-hist.
     3970   END.
     3971   run prn-lib-open-stream  in this-procedure (
     3972                                                input parparentProc
     3973                                               ,input 43
     3974                                               ,input yes
     3975                                               ,input no
     3976                                               ).
     3977   PUT  STREAM PrnLibStream
     3978   SPACE(25) ( frame Dialog-Frame:title )
     3979   format "x(90)" SKIP(1) .
     3980   FORM HEADER
     3981   Line format "X(180)" AT 1 SKIP
     3982   "Продолжение - на следующей странице" AT 30 SKIP
     3983   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3984   VIEW  STREAM PrnLibStream FRAME BottomFrame .
