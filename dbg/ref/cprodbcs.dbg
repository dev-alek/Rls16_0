     1072   FUNCTION get-all-fields returns character (p-file-name as character ):
     1073   define variable v-dop as character no-undo .
     1074     find first _file no-lock where _file._file-name = p-file-name no-error .
     1075     if not available _file then return "":U.
     1076     for each _field no-lock where
     1077              _field._file-recid = recid(_file) :
     1078       assign
     1079       v-dop = v-dop + _field._field-name + chr(44)
     1080       .
     1081     end.
     1082     return trim(v-dop).
     1083   END FUNCTION.
     1084   PROCEDURE proc-full-temp-changes :
     1085     define input  parameter p-hst-handle as handle    no-undo .
     1086     define input  parameter p-main-table as character no-undo .
     1087     define input  parameter p-field-list as character no-undo .
     1088     define input  parameter p-label-form as character no-undo .
     1089     define variable h-new-buf         as handle    no-undo .
     1090     define variable h-main-buf        as handle    no-undo .
     1091     define variable h-for-comp        as handle    no-undo .
     1092     define variable v-inform          as character no-undo .
     1093     define variable v-ind             as integer   no-undo .
     1094     define variable v-idx-field-qnty  as integer   no-undo .
     1095     define variable v-num-entries     as integer   no-undo .
     1096     define variable fh                as handle    no-undo .
     1097     define variable fh-main           as handle    no-undo .
     1098     define variable fh-old            as handle    no-undo .
     1099     define variable fh-new            as handle    no-undo .
     1100     define variable v-field-name      as character no-undo .
     1101     define variable v-field-lvl       as character no-undo .
     1102     define variable v-field-form      as character no-undo .
     1103     define variable v-search-exp      as character no-undo .
     1104     define variable v-srch-main       as character no-undo .
     1105     define variable v-word-link       as character no-undo .
     1106     define variable v-av-chip-num     as logical   no-undo .
     1107     define variable v-main-pi-fld-lst as character no-undo .
     1108     define variable v-main-fld-lst    as character no-undo .
     1109     define variable v-delim-list      as character no-undo .
     1110     define variable v-label           as character no-undo .
     1111     define variable v-old-value       as character no-undo case-sensitive.
     1112     define variable v-new-value       as character no-undo case-sensitive.
     1113     define variable v-chg-fields as character no-undo.
     1114     for each temp-changes:
     1115       delete temp-changes.
     1116     end.
     1117     if not p-hst-handle:available then do:
     1118       return .
     1119     end.
     1120     create buffer h-new-buf  for table p-hst-handle .
     1121     create buffer h-main-buf for table p-main-table .
     1122     assign
     1123       v-inform = h-main-buf:index-information(1)
     1124       v-ind    = 2
     1125     .
     1126     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1127     on error undo, return error
     1128     :
     1129       assign
     1130         v-inform = h-main-buf:index-information( v-ind )
     1131         v-ind    = v-ind + 1
     1132       .
     1133     end.
     1134     if v-inform = ?
     1135       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1136       or entry( 3, v-inform, ",":U ) <> "1":U
     1137     then do:
     1138       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1139     end.
     1140     assign
     1141       v-idx-field-qnty = num-entries( v-inform ) - 4
     1142     .
     1143     if v-idx-field-qnty < 2 then do:
     1144       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1145     end.
     1146     assign
     1147       v-srch-main   = "where":U
     1148       v-word-link   = "":U
     1149       v-av-chip-num = false
     1150       v-delim-list  = "":U
     1151     .
     1152     do v-ind = 1 to v-idx-field-qnty by 2
     1153     on error undo, return error
     1154     :
     1155       assign
     1156         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1157         fh                = p-hst-handle:buffer-field( v-field-name )
     1158         fh-main           = h-main-buf:buffer-field( v-field-name )
     1159         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1160         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1161       .
     1162       if fh:data-type ="character":U then do:
     1163         assign
     1164           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1165         .
     1166       end.
     1167       else do:
     1168         assign
     1169           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1170         .
     1171       end.
     1172       if v-delim-list = "":U then do:
     1173         assign
     1174           v-delim-list = ",":U
     1175         .
     1176       end.
     1177       if v-word-link = "":U then do:
     1178         assign
     1179           v-word-link = "and":U
     1180         .
     1181       end.
     1182     end.
     1183     assign
     1184       v-delim-list  = "":U
     1185     .
     1186     do v-ind = 1 to h-main-buf:num-fields
     1187     on error undo, return error
     1188     :
     1189       assign
     1190         fh-main      = h-main-buf:buffer-field( v-ind )
     1191         v-field-name = fh-main:name
     1192       .
     1193         assign
     1194           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1195         .
     1196         if v-delim-list = "":U then do:
     1197           assign
     1198             v-delim-list = ",":U
     1199           .
     1200         end.
     1201     end.
     1202     assign
     1203       v-inform = p-hst-handle:index-information(1)
     1204       v-ind    = 2
     1205     .
     1206     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1207     on error undo, return error
     1208     :
     1209       assign
     1210         v-inform = p-hst-handle:index-information( v-ind )
     1211         v-ind    = v-ind + 1
     1212       .
     1213     end.
     1214     if v-inform = ?
     1215       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1216       or entry( 3, v-inform, ",":U ) <> "1":U
     1217     then do:
     1218       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1219     end.
     1220     assign
     1221       v-idx-field-qnty = num-entries( v-inform ) - 4
     1222     .
     1223     if v-idx-field-qnty < 2 then do:
     1224       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1225     end.
     1226     assign
     1227       v-search-exp  = "where":U
     1228       v-word-link   = "":U
     1229       v-av-chip-num = false
     1230     .
     1231     do v-ind = 1 to v-idx-field-qnty by 2
     1232     on error undo, return error
     1233     :
     1234       assign
     1235         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1236         fh           = p-hst-handle:buffer-field( v-field-name )
     1237         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1238       .
     1239       if v-field-name = "chip-num":U then do:
     1240         assign
     1241           v-search-exp  = substitute( "&1 >", v-search-exp )
     1242           v-av-chip-num = true
     1243         .
     1244       end.
     1245       else do:
     1246         assign
     1247           v-search-exp = substitute( "&1 =", v-search-exp )
     1248         .
     1249       end.
     1250       if fh:data-type ="character":U then do:
     1251         assign
     1252           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1253         .
     1254       end.
     1255       else do:
     1256         assign
     1257           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1258         .
     1259       end.
     1260       if v-word-link = "":U then do:
     1261         assign
     1262           v-word-link = "and":U
     1263         .
     1264       end.
     1265     end.
     1266     if v-av-chip-num = false then do:
     1267       message
     1268         vss-workfile vss-revision vss-description skip
     1269         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1270         "Использование данной процедуры невозможно!" skip
     1271         view-as alert-box error .
     1272       return error .
     1273     end.
     1274     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1275     if not h-new-buf:available then do:
     1276       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1277       if not h-main-buf:available then do:
     1278         assign
     1279           h-for-comp = ?
     1280         .
     1281       end.
     1282       else do:
     1283         assign
     1284           h-for-comp = h-main-buf
     1285         .
     1286       end.
     1287     end.
     1288     else do:
     1289       assign
     1290         h-for-comp = h-new-buf
     1291       .
     1292     end.
     1293     assign
     1294       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1295     .
     1296     do v-ind = 1 to v-num-entries
     1297     on error undo, return error return-value
     1298     :
     1299       assign
     1300         v-field-name = entry( v-ind, v-main-fld-lst )
     1301         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1302         v-old-value  = fh-old:buffer-value()
     1303         v-label      = trim( fh-old:label )
     1304       .
     1305       if ( trim( p-field-list ) <> "":U
     1306            and lookup( v-field-name, p-field-list ) > 0
     1307          )
     1308          or trim( p-field-list ) = "":U
     1309       then do:
     1310         if h-for-comp <> ? then do:
     1311           assign
     1312             fh-new      = h-for-comp:buffer-field( v-field-name )
     1313             v-new-value = fh-new:buffer-value()
     1314           .
     1315         end.
     1316         else do:
     1317           assign
     1318             v-new-value = "":U
     1319           .
     1320         end.
     1321         if v-old-value <> v-new-value
     1322         then do:
     1323           create temp-changes.
     1324           assign
     1325             temp-changes.t_name = p-main-table
     1326             temp-changes.f_name = v-field-name
     1327             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1328             temp-changes.v_old  = trim( v-old-value )
     1329             temp-changes.v_new  = trim( v-new-value )
     1330             temp-changes.num_   = 0
     1331             temp-changes.fNotChange = v-old-value eq v-new-value
     1332           .
     1333         end.
     1334       end.
     1335     end.
     1336     assign
     1337       v-num-entries = num-entries( p-label-form, chr(8) )
     1338     .
     1339     do v-ind = 1 to v-num-entries
     1340     on error undo, return error return-value
     1341     :
     1342       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1343         assign
     1344           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1345           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1346           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1347         .
     1348         find first temp-changes
     1349           where temp-changes.f_name = v-field-name
     1350           no-error .
     1351         if available temp-changes then do:
     1352           if trim( v-field-lvl ) <> "":U then do:
     1353             assign
     1354               temp-changes.l_name = v-field-lvl
     1355             .
     1356           end.
     1357           if trim( v-field-form ) <> "":U then do:
     1358             assign
     1359               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1360             .
     1361             if h-for-comp <> ? then do:
     1362               assign
     1363                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1364               .
     1365             end.
     1366           end.
     1367         end.
     1368       end.
     1369       else do:
     1370         message
     1371           vss-workfile vss-revision vss-description skip
     1372           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1373           substitute( "список для поля '&1': '&2'"
     1374                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1375                       ,entry( v-ind, p-label-form, chr(8) )
     1376                     ) skip
     1377           substitute( "полный список: &2", p-label-form ) skip
     1378           view-as alert-box error .
     1379       end.
     1380     end.
     1381     delete object h-new-buf .
     1382     delete object h-main-buf .
     1383   END PROCEDURE.
     1384   FUNCTION get-action RETURNS CHARACTER
     1385     ( p-action as integer )  FORWARD.
     1386   FUNCTION get-good RETURNS CHARACTER
     1387     ( p-b-code as integer, output p-artic as character, output p-prod-type as character, output p-prod-code as integer )  FORWARD.
     1388   FUNCTION get-source-type RETURNS CHARACTER
     1389     ( p-source-type as character )  FORWARD.
     1390   FUNCTION get-subject RETURNS CHARACTER
     1391     ( p-subject as character )  FORWARD.
     1392   DEFINE BUTTON B-Help
     1393        LABEL "Помо&щь"
     1394        SIZE 3 BY 1
     1395        BGCOLOR 8 .
     1396   DEFINE BUTTON B-lookup
     1397        LABEL "&Товар"
     1398        SIZE 10 BY 1.
     1399   DEFINE BUTTON B-mark
     1400        LABEL "&*"
     1401        SIZE 3 BY 1.
     1402   DEFINE BUTTON B-print
     1403        LABEL "Пе&чать"
     1404        SIZE 3 BY 1.
     1405   DEFINE BUTTON b-quit AUTO-END-KEY
     1406        LABEL "&Выход"
     1407        SIZE 10 BY 1
     1408        BGCOLOR 8 .
     1409   DEFINE BUTTON b-sel AUTO-GO
     1410        LABEL "Вы&бор"
     1411        SIZE 10 BY 1
     1412        BGCOLOR 8 .
     1413   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1414         VIEW-AS TEXT
     1415        SIZE 6 BY 1
     1416        FGCOLOR 4  NO-UNDO.
     1417   DEFINE VARIABLE v-corr-user-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1418        LABEL "по БД"
     1419        VIEW-AS FILL-IN
     1420        SIZE 6 BY 1 NO-UNDO.
     1421   DEFINE QUERY BR-changes FOR
     1422         temp-changes SCROLLING.
     1423   DEFINE QUERY BR-gds-hist FOR
     1424         X_c-prod-bc,
     1425         X_c-bar-code,
     1426         X_c-gds-hist SCROLLING.
     1427   DEFINE BROWSE BR-changes
     1428     QUERY BR-changes DISPLAY
     1429         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1430   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1431   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1432       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.27.
     1433   DEFINE BROWSE BR-gds-hist
     1434     QUERY BR-gds-hist NO-LOCK DISPLAY
     1435         mark-string(recid(X_c-gds-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1436         X_c-prod-bc.b-code FORMAT "999999999":U
     1437         X_c-gds-hist.gds-code FORMAT "999999999":U
     1438         X_c-gds-hist.corr-date FORMAT "99/99/9999":U
     1439         usrfulnf(X_c-gds-hist.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1440         X_c-gds-hist.corr-user-db-num FORMAT ">>>>9":U
     1441         string(X_c-gds-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1442         X_c-gds-hist.is-news FORMAT "+/":U
     1443         X_c-gds-hist.source-ref FORMAT "X(14)":U
     1444         get-action(X_c-gds-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1445         get-source-type(X_c-gds-hist.source-type) COLUMN-LABEL "Источн.!измен."
     1446         if v-find then get-good(X_c-prod-bc.b-code, output v-artic, output v-prod-type, output v-prod-code) else "":U COLUMN-LABEL "Назв. товара" FORMAT "X(25)":U
     1447         v-artic COLUMN-LABEL "Артикул" FORMAT "X(14)":U
     1448         v-prod-type + string(v-prod-code) COLUMN-LABEL "Пр-ль" FORMAT "X(12)":U
     1449     ENABLE
     1450         X_c-gds-hist.corr-date
     1451       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.47.
     1452   DEFINE FRAME Dialog-Frame
     1453        b-quit AT ROW 1 COL 1
     1454        B-mark AT ROW 1 COL 11
     1455        b-sel AT ROW 1 COL 21
     1456        v-corr-user-db-num AT ROW 1 COL 37 COLON-ALIGNED
     1457        B-print AT ROW 1 COL 92
     1458        B-Help AT ROW 1 COL 95
     1459        B-lookup AT ROW 1.03 COL 51
     1460        BR-gds-hist AT ROW 2 COL 1
     1461        BR-changes AT ROW 14.8 COL 1
     1462        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1463        SPACE(78.74) SKIP(20.07)
     1464       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1465            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1466            TITLE "Полная история по товару"
     1467            CANCEL-BUTTON b-quit.
     1468   ASSIGN
     1469          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1470          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1471   ON GO OF FRAME Dialog-Frame
     1472   DO:
     1473     p-rid-list = v-rid-list.
     1474   END.
     1475   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1476   DO:
     1477     APPLY "END-ERROR":U TO SELF.
     1478   END.
     1479   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1480   DO:
     1481   run str/showgds.p ( input parparentproc
     1482                ,input ?
     1483                ,input X_c-gds-hist.gds-code
     1484                ,input 'ПРОСМОТР':U) no-error.
     1485   if error-status:error then return no-apply.
     1486   END.
     1487   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1488   DO:
     1489   define variable loc#log as logical no-undo .
     1490     if available X_c-gds-hist then do:
     1491   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1492   define variable v-str-recid14 as character no-undo .
     1493   define variable v-num-entry14 as integer   no-undo .
     1494   assign
     1495     v-str-recid14 = trim( string( recid( X_c-gds-hist ) , "->>>>>>>>>>>9":U ) )
     1496     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1497   .
     1498   if v-num-entry14 > 0 then do:
     1499     assign
     1500       entry( v-num-entry14, v-rid-list ) = "":U
     1501       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1502     .
     1503   end.
     1504   else do:
     1505     assign
     1506       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1507     .
     1508   end.
     1509       loc#log = br-gds-hist:refresh() .
     1510       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1511           loc#log = br-gds-hist:select-next-row ().
     1512           apply "VALUE-CHANGED" to br-gds-hist in frame Dialog-Frame.
     1513       end.
     1514       if num-entries( v-rid-list ) = 0
     1515       then
     1516           hide mark-num in frame Dialog-Frame.
     1517       else
     1518           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1519     end.
     1520     apply "entry" to br-gds-hist in frame Dialog-Frame.
     1521   END.
     1522   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1523   DO:
     1524     run proc-b-print in this-procedure no-error.
     1525     if error-status:error then return no-apply.
     1526   END.
     1527   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1528   DO:
     1529     if ( available X_c-gds-hist ) then do:
     1530       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1531       then
     1532       v-rid-list = string( recid( X_c-gds-hist ) ) .
     1533     end.
     1534   END.
     1535   ON MOUSE-SELECT-DBLCLICK OF BR-gds-hist IN FRAME Dialog-Frame
     1536   DO:
     1537     run proc-br-gds-hist in this-procedure no-error.
     1538     if error-status:error then return no-apply.
     1539   END.
     1540   ON RETURN OF BR-gds-hist IN FRAME Dialog-Frame
     1541   DO:
     1542     run proc-br-gds-hist in this-procedure no-error.
     1543     if error-status:error then return no-apply.
     1544   END.
     1545   ON VALUE-CHANGED OF BR-gds-hist IN FRAME Dialog-Frame
     1546   DO:
     1547     run proc-view-changes in this-procedure no-error.
     1548   END.
     1549   ON RETURN OF v-corr-user-db-num IN FRAME Dialog-Frame
     1550   DO:
     1551     assign
     1552     v-corr-user-db-num
     1553     .
     1554     RUn OpenBR in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     1555   END.
     1556   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1557   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1558   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1559   on help of frame Dialog-Frame
     1560   do:
     1561     run gbl/app_help.p
     1562       (input this-procedure :file-name
     1563       ,input ''
     1564       ,input ?
     1565       ) no-error.
     1566     if error-status :error then do:
     1567       message
     1568         "Ошибка при вызове помощи"
     1569         error-status :get-message(1)
     1570         view-as alert-box .
     1571     end.
     1572   end.
     1573   run minbtn-set in this-procedure .
     1574   on choose of b-help in frame Dialog-Frame
     1575   do:
     1576     apply "help":u to frame Dialog-Frame .
     1577   end.
     1578   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1579   procedure minbtn-set :
     1580       do
     1581           on error undo, return error return-value
     1582           :
     1583           define variable ii              as integer       no-undo .
     1584           define variable fh              as widget-handle no-undo .
     1585           define variable hh              as widget-handle no-undo .
     1586           define variable v-h             as handle        extent 4 no-undo .
     1587           define variable v-name-button   as character     no-undo .
     1588           define variable v-help-old-x    as decimal       no-undo .
     1589           define variable v-help-old-y    as decimal       no-undo .
     1590           define variable v-help-old-size as decimal       no-undo .
     1591           define variable v-frame-width   as decimal       no-undo .
     1592           define variable jj              as integer       no-undo .
     1593           do
     1594               on error undo, return error
     1595               :
     1596               assign
     1597                   v-frame-width = frame Dialog-Frame:width - 0.3
     1598                   fh            = frame Dialog-Frame:first-child
     1599                   hh            = fh:first-child
     1600                   ii            = 1
     1601                   .
     1602               do while valid-handle(hh):
     1603                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1604                   do:
     1605                       case lc(hh:name) :
     1606                           when "b-help" then
     1607                               do:
     1608                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1609                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1610                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1611                                   hh:TOOLTIP = "Помощь" .
     1612                                   v-help-old-x = hh:column .
     1613                                   v-help-old-y = hh:row    .
     1614                                   v-help-old-size = hh:width .
     1615                                   hh:width-chars = 2.5 .
     1616                               end.
     1617                           when "b-print" then
     1618                               do:
     1619                                   hh:load-image("cmp/b-print.bmp":u) .
     1620                                   hh:TOOLTIP = "Печать" .
     1621                                   v-h[ii] = hh:handle .
     1622                                   ii = ii + 1 .
     1623                                   hh:width-chars = 3 .
     1624                               end.
     1625                           when "b-history" or
     1626                           when "b-hist" then
     1627                               do:
     1628                                   hh:load-image("cmp/b-hist.bmp":u) .
     1629                                   hh:TOOLTIP = "История" .
     1630                                   v-h[ii] = hh:handle .
     1631                                   ii = ii + 1 .
     1632                                   hh:width-chars = 3 .
     1633                               end.
     1634                           when "b-sch" then
     1635                               do:
     1636                                   hh:load-image("cmp/b-sch.bmp":u) .
     1637                                   hh:TOOLTIP = "Установка Фильтра" .
     1638                                   v-h[ii] = hh:handle .
     1639                                   ii = ii + 1 .
     1640                                   hh:width-chars = 3 .
     1641                               end.
     1642                           when "b-hist-user" then
     1643                               do:
     1644                                   hh:load-image("cmp/b-hist.bmp":u) .
     1645                                   hh:TOOLTIP = "История пользователя" .
     1646                                   ii = ii + 1 .
     1647                               end.
     1648                       end case.
     1649                   end.
     1650                   hh = hh:next-sibling.
     1651               end.
     1652               b-help:column = v-frame-width - b-help:width-chars.
     1653               jj = 0.
     1654               repeat ii = 4 to 1 by -1 :
     1655                   if valid-handle (v-h[ii] ) then
     1656                   do:
     1657                       jj  = jj + 1 .
     1658                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1659                       v-h[ii]:row    = v-help-old-y .
     1660                   end.
     1661               end.
     1662           end.
     1663       end.
     1664   end procedure.
     1665   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1666   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1667   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1668   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1669   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1670   define variable v-diasize-current-frame-height as decimal   no-undo .
     1671   define variable v-diasize-change-size          as logical   no-undo .
     1672   define variable v-diasize-resize-button        as handle    no-undo .
     1673   define variable v-diasize-wndmax               as logical   no-undo .
     1674   define variable v-diasize-wndstore             as logical   no-undo .
     1675   define variable v-diasize-proc-name            as character no-undo .
     1676   define variable v-diasize-browse-handle        as handle    no-undo .
     1677   define variable v-diasize-browse-number        as integer   no-undo .
     1678   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1679   define temp-table temp-diasize-handle no-undo
     1680     field handle-value  as handle
     1681     field save-position as decimal
     1682     index xpk is primary unique handle-value
     1683     .
     1684   define temp-table temp-browse-handle no-undo
     1685     field browse-type   as character
     1686     field browse-number as integer
     1687     field browse-handle as handle
     1688     field original-size as decimal
     1689     index xpk is primary unique browse-type browse-number
     1690     index xie browse-type browse-handle
     1691   .
     1692   procedure diasize_change-height :
     1693     define input  parameter p-change-value  as decimal   no-undo .
     1694     define input  parameter p-move-resize   as logical   no-undo .
     1695     define variable v-field-group-handle    as handle    no-undo .
     1696     define variable v-object-handle         as handle    no-undo .
     1697     define variable v-frame-height          as decimal   no-undo .
     1698     define variable v-frame-virtual-height  as decimal   no-undo .
     1699     define variable v-browse-height         as decimal   no-undo .
     1700     define variable v-window-height         as decimal   no-undo .
     1701     define variable v-window-virtual-height as decimal   no-undo .
     1702     define variable v-change-sign           as integer   no-undo .
     1703     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1704     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1705     if p-change-value > 0
     1706     then do:
     1707       if frame Dialog-Frame :height + p-change-value
     1708           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1709       then do:
     1710         assign
     1711           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1712                           - (frame Dialog-Frame :height-chars)
     1713         .
     1714         if p-change-value <= 0
     1715         then do:
     1716           run diasize_position-resize-button in this-procedure .
     1717           return .
     1718         end.
     1719       end.
     1720     end.
     1721     if p-change-value < 0
     1722     then do:
     1723       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1724       then do:
     1725         assign
     1726           p-change-value = v-diasize-orig-frame-height
     1727                          - (frame Dialog-Frame :height-chars)
     1728         .
     1729         if p-change-value >= 0
     1730         then do:
     1731           run diasize_position-resize-button in this-procedure .
     1732           return .
     1733         end.
     1734       end.
     1735     end.
     1736     if p-change-value >= 0
     1737     then do:
     1738       assign
     1739         v-change-sign = 1
     1740       .
     1741     end.
     1742     else do:
     1743       assign
     1744         v-change-sign = -1
     1745       .
     1746     end.
     1747     assign
     1748       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1749     .
     1750     if p-change-value = 0
     1751     then do:
     1752       run diasize_position-resize-button in this-procedure .
     1753       return .
     1754     end.
     1755     move_block:
     1756     do
     1757     on error undo move_block, retry move_block
     1758     :
     1759       if retry
     1760       then do:
     1761         do
     1762         on error undo move_block, leave move_block
     1763         :
     1764           if p-change-value > 0
     1765           then do:
     1766             for each buf_temp-diasize-handle
     1767             on error undo, next
     1768             :
     1769               assign
     1770                 v-object-handle = buf_temp-diasize-handle.handle-value
     1771               .
     1772               if v-object-handle <> v-diasize-resize-button
     1773               then do:
     1774                 assign
     1775                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1776                 .
     1777               end.
     1778             end.
     1779             assign
     1780               v-diasize-browse-handle :height = v-browse-height
     1781             .
     1782             for each buf_temp-browse-handle
     1783               where buf_temp-browse-handle.browse-type = 'height':u
     1784             on error undo, next
     1785             :
     1786               assign
     1787                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1788               .
     1789             end.
     1790             assign
     1791               frame Dialog-Frame :height = v-frame-height
     1792             .
     1793             if frame Dialog-Frame :scrollable = true
     1794             then do:
     1795               assign
     1796                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1797               .
     1798             end.
     1799             run diasize_position-resize-button in this-procedure .
     1800           end.
     1801           else do:
     1802             if frame Dialog-Frame :scrollable = true
     1803             then do:
     1804               assign
     1805                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1806               .
     1807             end.
     1808             assign
     1809               frame Dialog-Frame :height = v-frame-height
     1810             .
     1811             assign
     1812               v-diasize-browse-handle :height = v-browse-height
     1813             .
     1814             for each buf_temp-browse-handle
     1815               where buf_temp-browse-handle.browse-type = 'height':u
     1816             on error undo, next
     1817             :
     1818               assign
     1819                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1820               .
     1821             end.
     1822             for each buf_temp-diasize-handle
     1823             on error undo, next
     1824             :
     1825               assign
     1826                 v-object-handle = buf_temp-diasize-handle.handle-value
     1827               .
     1828               if v-object-handle <> v-diasize-resize-button
     1829               then do:
     1830                 assign
     1831                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1832                 .
     1833               end.
     1834             end.
     1835             run diasize_position-resize-button in this-procedure .
     1836           end.
     1837           assign
     1838             v-diasize-change-size = false
     1839           .
     1840           leave move_block .
     1841         end.
     1842       end.
     1843       assign
     1844         v-diasize-need-full-display = true
     1845       .
     1846       if v-diasize-change-size = false
     1847       then do:
     1848         assign
     1849           v-diasize-change-size = true
     1850         .
     1851       end.
     1852       else do:
     1853         return .
     1854       end.
     1855       assign
     1856         v-frame-height = frame Dialog-Frame :height
     1857         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1858         v-browse-height = v-diasize-browse-handle :height
     1859       .
     1860       for each buf_temp-browse-handle
     1861         where buf_temp-browse-handle.browse-type = 'height':u
     1862       :
     1863         assign
     1864           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1865         .
     1866       end.
     1867       for each buf_temp-diasize-handle
     1868       :
     1869         delete buf_temp-diasize-handle .
     1870       end.
     1871       assign
     1872         v-field-group-handle = frame Dialog-Frame :first-child
     1873       .
     1874       do while valid-handle(v-field-group-handle)
     1875       :
     1876         assign
     1877           v-object-handle = v-field-group-handle :first-child
     1878         .
     1879         do while valid-handle(v-object-handle)
     1880         :
     1881           if  v-object-handle <> v-diasize-browse-handle :handle
     1882           and can-query(v-object-handle, "row")
     1883           and can-query(v-object-handle, "height")
     1884           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1885           then do:
     1886             find first buf_temp-browse-handle
     1887               where buf_temp-browse-handle.browse-type   = 'height':u
     1888                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1889               no-error .
     1890             if available buf_temp-browse-handle
     1891             then do:
     1892             end.
     1893             else do:
     1894               create buf_temp-diasize-handle .
     1895               assign
     1896                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1897                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1898               .
     1899             end.
     1900           end.
     1901           assign
     1902             v-object-handle = v-object-handle :next-sibling
     1903           .
     1904         end.
     1905         assign
     1906           v-field-group-handle = v-field-group-handle :next-sibling
     1907         .
     1908       end.
     1909       do with frame Dialog-Frame
     1910       :
     1911         hide v-diasize-resize-button .
     1912         assign
     1913           v-diasize-resize-button :row    = 1
     1914           v-diasize-resize-button :column = 1
     1915         .
     1916       end.
     1917       if p-change-value > 0
     1918       then do:
     1919         if frame Dialog-Frame :scrollable = true
     1920         then do:
     1921           assign
     1922             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1923             no-error .
     1924           if error-status :error
     1925           or error-status :get-message(1) <> ""
     1926           then do:
     1927             undo move_block, retry move_block .
     1928           end.
     1929         end.
     1930         assign
     1931           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1932           no-error .
     1933         if error-status :error
     1934         or error-status :get-message(1) <> ""
     1935         then do:
     1936           undo move_block, retry move_block .
     1937         end.
     1938         assign
     1939           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1940           no-error .
     1941         if error-status :error
     1942         or error-status :get-message(1) <> ""
     1943         then do:
     1944           undo move_block, retry move_block .
     1945         end.
     1946         for each buf_temp-browse-handle
     1947           where buf_temp-browse-handle.browse-type = 'height':u
     1948         on error undo move_block, retry move_block
     1949         :
     1950           assign
     1951             buf_temp-browse-handle.browse-handle :height
     1952               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1953             no-error .
     1954           if error-status :error
     1955           or error-status :get-message(1) <> ""
     1956           then do:
     1957             undo move_block, retry move_block .
     1958           end.
     1959         end.
     1960         for each buf_temp-diasize-handle
     1961         on error undo move_block, retry move_block
     1962         :
     1963           assign
     1964             v-object-handle = buf_temp-diasize-handle.handle-value
     1965           .
     1966           if v-object-handle <> v-diasize-resize-button
     1967           then do:
     1968             assign
     1969               v-object-handle :row = v-object-handle :row + p-change-value
     1970               no-error .
     1971             if error-status :error
     1972             or error-status :get-message(1) <> ""
     1973             then do:
     1974               undo move_block, retry move_block .
     1975             end.
     1976           end.
     1977         end.
     1978       end.
     1979       else do:
     1980         for each buf_temp-diasize-handle
     1981         on error undo move_block, retry move_block
     1982         :
     1983           assign
     1984             v-object-handle = buf_temp-diasize-handle.handle-value
     1985           .
     1986           if v-object-handle <> v-diasize-resize-button
     1987           then do:
     1988             assign
     1989               v-object-handle :row = v-object-handle :row + p-change-value
     1990               no-error .
     1991             if error-status :error
     1992             or error-status :get-message(1) <> ""
     1993             then do:
     1994               undo move_block, retry move_block .
     1995             end.
     1996           end.
     1997         end.
     1998         assign
     1999           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2000           no-error .
     2001         if error-status :error
     2002         or error-status :get-message(1) <> ""
     2003         then do:
     2004           undo move_block, retry move_block .
     2005         end.
     2006         for each buf_temp-browse-handle
     2007           where buf_temp-browse-handle.browse-type = 'height':u
     2008         on error undo move_block, retry move_block
     2009         :
     2010           assign
     2011             buf_temp-browse-handle.browse-handle :height
     2012               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2013             no-error .
     2014           if error-status :error
     2015           or error-status :get-message(1) <> ""
     2016           then do:
     2017             undo move_block, retry move_block .
     2018           end.
     2019         end.
     2020         assign
     2021           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2022           no-error .
     2023         if error-status :error
     2024         or error-status :get-message(1) <> ""
     2025         then do:
     2026           undo move_block, retry move_block .
     2027         end.
     2028         if frame Dialog-Frame :scrollable = true
     2029         then do:
     2030           assign
     2031             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2032             no-error .
     2033           if error-status :error
     2034           or error-status :get-message(1) <> ""
     2035           then do:
     2036             undo move_block, retry move_block .
     2037           end.
     2038         end.
     2039       end.
     2040       if p-move-resize = true
     2041       then do:
     2042         run diasize_position-resize-button in this-procedure .
     2043       end.
     2044       if v-diasize-wndstore = true
     2045       then do:
     2046         if connected("ub") = true
     2047         then do:
     2048           define variable v-cntxt-db-num        as integer   no-undo .
     2049           define variable v-cntxt-userid        as character no-undo .
     2050           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2051                                             , OUTPUT v-cntxt-userid
     2052                                             ) .
     2053           run gbl/wndsizew.p
     2054             (input  v-cntxt-db-num
     2055             ,input  v-cntxt-userid
     2056             ,input  v-diasize-proc-name
     2057             ,input  'height':u
     2058             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2059             ) .
     2060         end.
     2061       end.
     2062     end.
     2063     assign
     2064       v-diasize-change-size = false
     2065     .
     2066   end procedure.
     2067   procedure diasize_set-height :
     2068     define input  parameter p-new-height  as decimal   no-undo .
     2069     define input  parameter p-move-resize as logical   no-undo .
     2070     do
     2071     on error undo, return error return-value
     2072     :
     2073       run diasize_change-height in this-procedure
     2074         (input  (p-new-height - frame Dialog-Frame :height)
     2075         ,input  p-move-resize
     2076         ) .
     2077     end.
     2078   end procedure.
     2079   procedure diasize_change-width :
     2080     define input  parameter p-change-value as decimal   no-undo .
     2081     define input  parameter p-move-resize  as logical   no-undo .
     2082     define variable v-field-group-handle   as handle    no-undo .
     2083     define variable v-object-handle        as handle    no-undo .
     2084     define variable v-frame-width          as decimal   no-undo .
     2085     define variable v-frame-virtual-width  as decimal   no-undo .
     2086     define variable v-browse-width         as decimal   no-undo .
     2087     define variable v-window-width         as decimal   no-undo .
     2088     define variable v-window-virtual-width as decimal   no-undo .
     2089     define variable v-change-sign          as integer   no-undo .
     2090     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2091     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2092     if p-change-value > 0
     2093     then do:
     2094       if frame Dialog-Frame :width + p-change-value >
     2095           session :width-chars
     2096       then do:
     2097         assign
     2098           p-change-value = session :width-chars - frame Dialog-Frame :width
     2099         .
     2100         if p-change-value <= 0
     2101         then do:
     2102           run diasize_position-resize-button in this-procedure .
     2103           return .
     2104         end.
     2105       end.
     2106     end.
     2107     if p-change-value < 0
     2108     then do:
     2109       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2110       then do:
     2111         assign
     2112           p-change-value = v-diasize-orig-frame-width
     2113                          - frame Dialog-Frame :width
     2114         .
     2115         if p-change-value >= 0
     2116         then do:
     2117           run diasize_position-resize-button in this-procedure .
     2118           return .
     2119         end.
     2120       end.
     2121     end.
     2122     if p-change-value >= 0
     2123     then do:
     2124       assign
     2125         v-change-sign = 1
     2126       .
     2127     end.
     2128     else do:
     2129       assign
     2130         v-change-sign = -1
     2131       .
     2132     end.
     2133     assign
     2134       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2135     .
     2136     if p-change-value = 0
     2137     then do:
     2138       run diasize_position-resize-button in this-procedure .
     2139       return .
     2140     end.
     2141     move_block:
     2142     do
     2143     on error undo move_block, leave move_block
     2144     :
     2145       if retry
     2146       then do:
     2147         do
     2148         on error undo move_block, leave move_block
     2149         :
     2150           if p-change-value > 0
     2151           then do:
     2152             for each buf_temp-diasize-handle
     2153             on error undo, next
     2154             :
     2155               assign
     2156                 v-object-handle = buf_temp-diasize-handle.handle-value
     2157               .
     2158               if v-object-handle <> v-diasize-resize-button
     2159               then do:
     2160                 assign
     2161                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2162                 .
     2163               end.
     2164             end.
     2165             assign
     2166               v-diasize-browse-handle :width = v-browse-width
     2167             .
     2168             for each buf_temp-browse-handle
     2169               where buf_temp-browse-handle.browse-type = 'width':u
     2170             on error undo, next
     2171             :
     2172               assign
     2173                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2174               .
     2175             end.
     2176             assign
     2177               frame Dialog-Frame :width = v-frame-width
     2178             .
     2179             if frame Dialog-Frame :scrollable = true
     2180             then do:
     2181               assign
     2182                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2183               .
     2184             end.
     2185             run diasize_position-resize-button in this-procedure .
     2186           end.
     2187           else do:
     2188             if frame Dialog-Frame :scrollable = true
     2189             then do:
     2190               assign
     2191                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2192               .
     2193             end.
     2194             assign
     2195               frame Dialog-Frame :width = v-frame-width
     2196             .
     2197             for each buf_temp-browse-handle
     2198               where buf_temp-browse-handle.browse-type = 'width':u
     2199             on error undo, next
     2200             :
     2201               assign
     2202                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2203               .
     2204             end.
     2205             assign
     2206               v-diasize-browse-handle :width = v-browse-width
     2207             .
     2208             for each buf_temp-diasize-handle
     2209             on error undo, next
     2210             :
     2211               assign
     2212                 v-object-handle = buf_temp-diasize-handle.handle-value
     2213               .
     2214               if v-object-handle <> v-diasize-resize-button
     2215               then do:
     2216                 assign
     2217                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2218                 .
     2219               end.
     2220             end.
     2221             run diasize_position-resize-button in this-procedure .
     2222           end.
     2223           assign
     2224             v-diasize-change-size = false
     2225           .
     2226           leave move_block .
     2227         end.
     2228       end.
     2229       assign
     2230         v-diasize-need-full-display = true
     2231       .
     2232       if v-diasize-change-size = false
     2233       then do:
     2234         assign
     2235           v-diasize-change-size = true
     2236         .
     2237       end.
     2238       else do:
     2239         return .
     2240       end.
     2241       assign
     2242         v-frame-width = frame Dialog-Frame :width
     2243         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2244         v-browse-width = v-diasize-browse-handle :width
     2245       .
     2246       for each buf_temp-browse-handle
     2247         where buf_temp-browse-handle.browse-type = 'width':u
     2248       :
     2249         assign
     2250           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2251         .
     2252       end.
     2253       for each buf_temp-diasize-handle
     2254       :
     2255         delete buf_temp-diasize-handle .
     2256       end.
     2257       assign
     2258         v-field-group-handle = frame Dialog-Frame :first-child
     2259       .
     2260       do while valid-handle(v-field-group-handle)
     2261       :
     2262         assign
     2263           v-object-handle = v-field-group-handle :first-child
     2264         .
     2265         do while valid-handle(v-object-handle)
     2266         :
     2267           if  v-object-handle <> v-diasize-browse-handle :handle
     2268           and v-object-handle <> v-diasize-resize-button
     2269           and can-query(v-object-handle, "row")
     2270           and can-query(v-object-handle, "height")
     2271           and ( v-object-handle :col + v-object-handle :width
     2272                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2273               )
     2274           then do:
     2275             find first buf_temp-browse-handle
     2276               where buf_temp-browse-handle.browse-type   = 'width':u
     2277                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2278               no-error .
     2279             if available buf_temp-browse-handle
     2280             then do:
     2281             end.
     2282             else do:
     2283               create buf_temp-diasize-handle .
     2284               assign
     2285                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2286                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2287               .
     2288             end.
     2289           end.
     2290           assign
     2291             v-object-handle = v-object-handle :next-sibling
     2292           .
     2293         end.
     2294         assign
     2295           v-field-group-handle = v-field-group-handle :next-sibling
     2296         .
     2297       end.
     2298       do with frame Dialog-Frame
     2299       :
     2300         hide v-diasize-resize-button .
     2301         v-diasize-resize-button :row = 1.
     2302         v-diasize-resize-button :column = 1.
     2303       end.
     2304       if p-change-value > 0
     2305       then do:
     2306         if frame Dialog-Frame :scrollable = true
     2307         then do:
     2308           assign
     2309             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2310             no-error .
     2311           if error-status :error
     2312           or error-status :get-message(1) <> ""
     2313           then do:
     2314             undo move_block, retry move_block.
     2315           end.
     2316         end.
     2317         assign
     2318           frame Dialog-Frame :width = v-frame-width + p-change-value
     2319           no-error .
     2320         if error-status :error
     2321         or error-status :get-message(1) <> ""
     2322         then do:
     2323           undo move_block, retry move_block.
     2324         end.
     2325         assign
     2326           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2327         no-error .
     2328         if error-status :error
     2329         or error-status :get-message(1) <> ""
     2330         then do:
     2331           undo move_block, retry move_block.
     2332         end.
     2333         for each buf_temp-browse-handle
     2334           where buf_temp-browse-handle.browse-type = 'width':u
     2335         on error undo move_block, retry move_block
     2336         :
     2337           assign
     2338             buf_temp-browse-handle.browse-handle :width
     2339               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2340             no-error .
     2341           if error-status :error
     2342           or error-status :get-message(1) <> ""
     2343           then do:
     2344             undo move_block, retry move_block .
     2345           end.
     2346         end.
     2347         for each buf_temp-diasize-handle
     2348         on error undo move_block, retry move_block
     2349         :
     2350           assign
     2351             v-object-handle = buf_temp-diasize-handle.handle-value
     2352           .
     2353           if v-object-handle <> v-diasize-resize-button
     2354           then do:
     2355             assign
     2356               v-object-handle :col = v-object-handle :col + p-change-value
     2357               no-error .
     2358             if error-status :error
     2359             or error-status :get-message(1) <> ""
     2360             then do:
     2361               undo move_block, retry move_block .
     2362             end.
     2363           end.
     2364         end.
     2365       end.
     2366       else do:
     2367         for each buf_temp-diasize-handle
     2368         on error undo move_block, retry move_block
     2369         :
     2370           assign
     2371             v-object-handle = buf_temp-diasize-handle.handle-value
     2372           .
     2373           if v-object-handle <> v-diasize-resize-button
     2374           then do:
     2375             assign
     2376               v-object-handle :col = v-object-handle :col + p-change-value
     2377               no-error .
     2378             if error-status :error
     2379             or error-status :get-message(1) <> ""
     2380             then do:
     2381               undo move_block, retry move_block .
     2382             end.
     2383           end.
     2384         end.
     2385         for each buf_temp-browse-handle
     2386           where buf_temp-browse-handle.browse-type = 'width':u
     2387         on error undo move_block, retry move_block
     2388         :
     2389           assign
     2390             buf_temp-browse-handle.browse-handle :width
     2391               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2392             no-error .
     2393           if error-status :error
     2394           or error-status :get-message(1) <> ""
     2395           then do:
     2396             undo move_block, retry move_block .
     2397           end.
     2398         end.
     2399         assign
     2400           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2401           no-error .
     2402         if error-status :error
     2403         or error-status :get-message(1) <> ""
     2404         then do:
     2405           undo move_block, retry move_block.
     2406         end.
     2407         assign
     2408           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2409         no-error .
     2410         if error-status :error
     2411         or error-status :get-message(1) <> ""
     2412         then do:
     2413           undo move_block, retry move_block.
     2414         end.
     2415         if frame Dialog-Frame :scrollable = true
     2416         then do:
     2417           assign
     2418             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2419           no-error .
     2420           if error-status :error
     2421           or error-status :get-message(1) <> ""
     2422           then do:
     2423             undo move_block, retry move_block.
     2424           end.
     2425         end.
     2426       end.
     2427       if p-move-resize
     2428       then do:
     2429         run diasize_position-resize-button in this-procedure .
     2430       end.
     2431       if v-diasize-wndstore = true
     2432       then do:
     2433         if connected("ub") = true
     2434         then do:
     2435           define variable v-cntxt-db-num        as integer   no-undo .
     2436           define variable v-cntxt-userid        as character no-undo .
     2437           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2438                                             , OUTPUT v-cntxt-userid
     2439                                             ) .
     2440           run gbl/wndsizew.p
     2441             (input  v-cntxt-db-num
     2442             ,input  v-cntxt-userid
     2443             ,input  v-diasize-proc-name
     2444             ,input  'width':u
     2445             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2446             ) .
     2447         end.
     2448       end.
     2449     end.
     2450     assign
     2451       v-diasize-change-size = false
     2452     .
     2453   end procedure.
     2454   procedure diasize_set-width :
     2455     define input  parameter p-new-width  as decimal   no-undo .
     2456     define input  parameter p-move-resize as logical   no-undo .
     2457     do
     2458     on error undo, return error return-value
     2459     :
     2460       run diasize_change-width in this-procedure
     2461         (input  (p-new-width - frame Dialog-Frame :width)
     2462         ,input  p-move-resize
     2463         ) .
     2464     end.
     2465   end procedure.
     2466   procedure diasize_position-resize-button :
     2467     do with frame Dialog-Frame
     2468     :
     2469       hide v-diasize-resize-button .
     2470       assign
     2471         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2472                     - 1
     2473                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2474         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2475                     - 1
     2476                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2477       .
     2478       view v-diasize-resize-button .
     2479     end.
     2480   end procedure.
     2481   on alt-right anywhere
     2482   do:
     2483     run diasize_change-width in this-procedure
     2484       (input 1
     2485       ,input true
     2486       ) .
     2487     return no-apply .
     2488   end.
     2489   on alt-left anywhere
     2490   do:
     2491     run diasize_change-width in this-procedure
     2492       (input -1
     2493       ,input true
     2494       ) .
     2495     return no-apply .
     2496   end.
     2497   on alt-down anywhere
     2498   do:
     2499     run diasize_change-height in this-procedure
     2500       (input 1
     2501       ,input true
     2502       ) .
     2503     return no-apply .
     2504   end.
     2505   on alt-up anywhere
     2506   do:
     2507     run diasize_change-height in this-procedure
     2508       (input -1
     2509       ,input true
     2510       ) .
     2511     return no-apply .
     2512   end.
     2513   on alt-enter of frame Dialog-Frame
     2514   do:
     2515     run diasize_maximize in this-procedure
     2516       (input  ?
     2517       ).
     2518     return no-apply .
     2519   end.
     2520   procedure diasize_end-move :
     2521     do
     2522     on error undo, return error return-value
     2523     :
     2524       define variable v-row-delta as decimal   no-undo .
     2525       define variable v-col-delta as decimal   no-undo .
     2526       define variable v-new-row as decimal   no-undo .
     2527       define variable v-new-col as decimal   no-undo .
     2528       assign
     2529         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2530         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2531       .
     2532       assign
     2533         v-row-delta = v-new-row - frame Dialog-Frame :height
     2534         v-col-delta = v-new-col - frame Dialog-Frame :width
     2535       .
     2536       run diasize_change-height in this-procedure
     2537         (input v-row-delta
     2538         ,input true
     2539         ) .
     2540       run diasize_change-width in this-procedure
     2541         (input v-col-delta
     2542         ,input true
     2543         ) .
     2544     end.
     2545   end procedure.
     2546   procedure diasize_maximize :
     2547     define input  parameter p-action as logical   no-undo .
     2548     do
     2549     on error undo, return error return-value
     2550     :
     2551       if p-action = ?
     2552       then do:
     2553         if v-diasize-need-maximize = true
     2554         then do:
     2555           assign
     2556             p-action = true
     2557           .
     2558         end.
     2559         else do:
     2560           assign
     2561             p-action = false
     2562           .
     2563         end.
     2564       end.
     2565       if p-action = true
     2566       then do:
     2567         run diasize_change-height in this-procedure
     2568           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2569               - frame Dialog-Frame :height-chars
     2570           ,input true
     2571           ) .
     2572         run diasize_change-width in this-procedure
     2573           (input session :width-chars
     2574               - frame Dialog-Frame :width-chars
     2575           ,input true
     2576           ) .
     2577         assign
     2578           v-diasize-need-maximize = false
     2579         .
     2580       end.
     2581       else do:
     2582         run diasize_change-width in this-procedure
     2583           (input v-diasize-orig-frame-width
     2584               - frame Dialog-Frame :width-chars
     2585           ,input true
     2586           ) .
     2587         run diasize_change-height in this-procedure
     2588           (input v-diasize-orig-frame-height
     2589               - frame Dialog-Frame :height-chars
     2590           ,input true
     2591           ) .
     2592         assign
     2593           v-diasize-need-maximize = true
     2594         .
     2595       end.
     2596     end.
     2597   end procedure.
     2598   procedure diasize_restore-orig-size :
     2599     do
     2600     on error undo, return error return-value
     2601     :
     2602       assign
     2603         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2604         v-diasize-current-frame-height = frame Dialog-Frame :height
     2605       .
     2606       run diasize_set-height in this-procedure
     2607         (input  v-diasize-orig-frame-height
     2608         ,input  true
     2609         ) .
     2610       run diasize_set-width in this-procedure
     2611         (input  v-diasize-orig-frame-width
     2612         ,input  true
     2613         ) .
     2614     end.
     2615   end procedure.
     2616   procedure diasize_restore-current-size :
     2617     do
     2618     on error undo, return error return-value
     2619     :
     2620       run diasize_set-height in this-procedure
     2621         (input  v-diasize-current-frame-height
     2622         ,input  true
     2623         ) .
     2624       run diasize_set-width in this-procedure
     2625         (input  v-diasize-current-frame-width
     2626         ,input  true
     2627         ) .
     2628     end.
     2629   end procedure.
     2630   procedure diasize_set-browse-handle :
     2631     define input  parameter p-browse-handle as handle   no-undo .
     2632     define buffer buf_temp-browse-handle for temp-browse-handle .
     2633     do
     2634     on error undo, return error return-value
     2635     :
     2636       assign
     2637         v-diasize-browse-handle = p-browse-handle
     2638       .
     2639       for each buf_temp-browse-handle
     2640       on error undo, return error return-value
     2641       :
     2642         delete buf_temp-browse-handle .
     2643       end.
     2644     end.
     2645   end procedure.
     2646   procedure diasize_add_browse :
     2647     define input  parameter p-browse-type   as character no-undo .
     2648     define input  parameter p-browse-handle as handle    no-undo .
     2649     define buffer buf_temp-browse-handle for temp-browse-handle .
     2650     do
     2651     on error undo, return error return-value
     2652     :
     2653       assign
     2654         v-diasize-browse-number = v-diasize-browse-number + 1
     2655       .
     2656       create buf_temp-browse-handle .
     2657       assign
     2658         buf_temp-browse-handle.browse-type   = p-browse-type
     2659         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2660         buf_temp-browse-handle.browse-handle = p-browse-handle
     2661       .
     2662     end.
     2663   end procedure.
     2664   procedure diasize_init :
     2665     define variable v-default-value    as logical   no-undo .
     2666     define variable v-restore-saved    as logical   no-undo .
     2667     define variable v-resize-value-str as character no-undo .
     2668     do
     2669     on error undo, return error return-value
     2670     :
     2671       do with frame Dialog-Frame
     2672       :
     2673         assign
     2674           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2675           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2676           v-diasize-browse-handle     = browse br-gds-hist :handle
     2677         .
     2678         create button v-diasize-resize-button
     2679         assign
     2680           parent        = frame Dialog-Frame :first-child
     2681           label         = "s"
     2682           height-pixels = 16
     2683           width-pixels  = 16
     2684           visible       = true
     2685           sensitive     = true
     2686           movable       = true
     2687           triggers:
     2688             on end-move persistent run diasize_end-move in this-procedure .
     2689           end triggers.
     2690         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2691         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2692         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2693         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2694         assign
     2695           v-diasize-wndmax = false
     2696         .
     2697         if connected("ub") = true
     2698         then do:
     2699           define variable v-cntxt-db-num        as integer   no-undo .
     2700           define variable v-cntxt-userid        as character no-undo .
     2701           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2702                                             , OUTPUT v-cntxt-userid
     2703                                             ) .
     2704           run gbl/wndpar_r.p
     2705             (input  v-cntxt-db-num
     2706             ,input  v-cntxt-userid
     2707             ,input  'wndmax':U
     2708             ,output v-diasize-wndmax
     2709             ,output v-default-value
     2710             ) .
     2711         end.
     2712         assign
     2713           v-diasize-wndstore = false
     2714         .
     2715         if connected("ub") = true
     2716         then do:
     2717           run gbl/wndpar_r.p
     2718             (input  v-cntxt-db-num
     2719             ,input  v-cntxt-userid
     2720             ,input  'wndstore':U
     2721             ,output v-diasize-wndstore
     2722             ,output v-default-value
     2723             ) .
     2724         end.
     2725         assign
     2726           v-diasize-proc-name = entry(1, program-name(2), '.')
     2727         .
     2728         if v-diasize-wndstore = true
     2729         then do:
     2730           assign
     2731             v-restore-saved = false
     2732           .
     2733           if connected("ub") = true
     2734           then do:
     2735             run gbl/wndsizer.p
     2736               (input  v-cntxt-db-num
     2737               ,input  v-cntxt-userid
     2738               ,input  v-diasize-proc-name
     2739               ,input  'height':u
     2740               ,output v-resize-value-str
     2741               ) .
     2742             if v-resize-value-str <> '':U
     2743             then do:
     2744               run diasize_change-height in this-procedure
     2745                 (input  integer(v-resize-value-str)
     2746                 ,input  true
     2747                 ) .
     2748               assign
     2749                 v-restore-saved = true
     2750               .
     2751             end.
     2752           end.
     2753           if connected("ub") = true
     2754           then do:
     2755             run gbl/wndsizer.p
     2756               (input  v-cntxt-db-num
     2757               ,input  v-cntxt-userid
     2758               ,input  v-diasize-proc-name
     2759               ,input  'width':u
     2760               ,output v-resize-value-str
     2761               ) .
     2762             if v-resize-value-str <> '':U
     2763             then do:
     2764               run diasize_change-width in this-procedure
     2765                 (input  integer(v-resize-value-str)
     2766                 ,input  true
     2767                 ) .
     2768               assign
     2769                 v-restore-saved = true
     2770               .
     2771             end.
     2772           end.
     2773           if v-restore-saved <> true
     2774           then do:
     2775             if v-diasize-wndmax = true
     2776             then do:
     2777               run diasize_maximize in this-procedure
     2778                 (input  true
