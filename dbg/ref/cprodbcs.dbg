     3991         get-action(X_c-gds-hist.action) @ v-action-chr
     3992         X_c-gds-hist.is-news
     3993         (if v-find then get-good(X_c-gds-hist.gds-code, output v-artic, output v-prod-type, output v-prod-code) else "":U )
     3994         @ v-gds-name
     3995         v-artic
     3996         (v-prod-type + string(v-prod-code)) @ v-prod
     3997         get-source-type(X_c-gds-hist.source-type) @ v-source-type
     3998         X_c-gds-hist.source-ref
     3999         X_c-gds-hist.corr-date
     4000         string(X_c-gds-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     4001         usrfulnf(X_c-gds-hist.corr-user-name) @ v-for-user-name
     4002         X_c-gds-hist.corr-user-db-num
     4003         with FRAME HistoryList .
