     3191     then do:
     3192       define variable  parameter-2-23 as character no-undo .
     3193       define variable  parameter-3-23 as character no-undo .
     3194       define variable  parameter-4-23 as character no-undo .
     3195       define variable  parameter-5-23 as character no-undo .
     3196       define variable  parameter-6-23 as character no-undo .
     3197       define variable  parameter-7-23 as character no-undo .
     3198         assign
     3199         parameter-3-23 =
     3200                                 "FOR EACH X_c-prod-bc"
     3201         parameter-4-23 =
     3202           (
     3203             if (" X_c-prod-bc.b-str = p-b-str ANd  X_c-prod-bc.b-code = p-b-code " + " " + where-phrase-23) <> ""
     3204             then  substitute('X_c-prod-bc.b-str = &1&2&1 ANd  X_c-prod-bc.b-code = &3 ', chr(34), p-b-str, p-b-code) + " " + where-phrase-23
