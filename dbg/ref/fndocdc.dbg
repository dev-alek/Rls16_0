      431        LABEL "&Отмена"
      432        SIZE 10 BY 1
      433        BGCOLOR 8 .
      434   DEFINE VARIABLE f-all-sum-doc AS DECIMAL FORMAT ">,>>>,>>>,>>>,>>9.99" INITIAL 0
      435        LABEL "Сумма по док-ту"
      436        VIEW-AS FILL-IN
      437        SIZE 21.5 BY 1
      438        FGCOLOR 4 .
