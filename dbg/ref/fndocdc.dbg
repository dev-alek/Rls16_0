      452   DEFINE QUERY BR-payment FOR
      453         tt-payment,
      454         buf_dis-card,
      455         buf_clients SCROLLING.
      456   DEFINE QUERY Dialog-Frame FOR
      457         locked_fin-doc SCROLLING.
      458   DEFINE BROWSE BR-payment
      459     QUERY BR-payment DISPLAY
      460         tt-payment.d-card COLUMN-LABEL "№ карты" FORMAT "X(19)":U
      461   tt-payment.pmnt-code COLUMN-LABEL "№ платежа" FORMAT "X(19)":U
      462   tt-payment.tot-cli COLUMN-LABEL "Сумма" FORMAT "->>>,>>>,>>9.99":U
      463   buf_dis-card.cli-type + STRING(buf_dis-card.cli-code)
      464   buf_clients.obj-name
      465   ENABLE
      466   tt-payment.tot-cli
      467       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16.
      468   DEFINE FRAME Dialog-Frame
      469        B-exit AT ROW 1 COL 1
      470        b-quit AT ROW 1 COL 11
      471        B-add AT ROW 1 COL 31
      472        B-del AT ROW 1 COL 41
      473        b-dc AT ROW 1 COL 51 WIDGET-ID 2
      474        B-Help AT ROW 1 COL 95
      475        f-all-sum-doc AT ROW 2.27 COL 16 COLON-ALIGNED
      476        F-curr-code AT ROW 2.27 COL 45 COLON-ALIGNED
      477        f-curr-abbr AT ROW 2.27 COL 50 COLON-ALIGNED NO-LABEL
      478        f-rest-sum-doc AT ROW 2.27 COL 75 COLON-ALIGNED WIDGET-ID 4
      479        BR-payment AT ROW 3.47 COL 1
      480        SPACE(0.24) SKIP(0.56)
      481       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      482            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      483            TITLE "Привязки к ДК"
      484            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      485   ASSIGN
      486          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      487          FRAME Dialog-Frame:HIDDEN           = TRUE.
      488   ON GO OF FRAME Dialog-Frame
      489   DO:
      490     run check-sums in this-procedure no-error.
      491     if error-status:error then return no-apply.
      492     run proc-save in this-procedure no-error.
      493     if error-status:error then return no-apply.
      494   END.
      495   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      496   DO:
      497     APPLY "END-ERROR":U TO SELF.
      498   END.
      499   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      500   DO:
      501   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      502   if lookup(self :type
      503            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      504            ) = 0
      505   then do:
      506     message
      507       "$Workfile$"
      508       "Указанному интерфейсному элементу фокус не может быть передан" skip
      509       "Интерфейсный элемент" self :name  skip
      510       "Тип" self :type  skip
      511       "Процедура" this-procedure :file-name skip
      512       view-as alert-box .
      513   end.
      514   else do:
      515     apply "entry":u to self  .
      516     if focus :handle <> self :handle  then do:
      517       return no-apply .
      518     end.
      519   end.
      520   run proc-b-add in this-procedure  no-error.
      521   if error-status:error then do:
      522       return no-apply.
      523   end.
      524   END.
      525   ON CHOOSE OF b-dc IN FRAME Dialog-Frame
      526   DO:
      527   DEFINE VARIABLE v-rid AS RECID NO-UNDO.
      528   IF NOT AVAILABLE tt-payment  THEN RETURN NO-APPLY.
      529   v-rid = recid( buf_dis-card ) .
      530   run ref/dcardi.w (
      531                 input parparentproc
      532               , input 'ПРОСМОТР':U
      533               , input buf_dis-card.emitent-host-code
      534               , input v-cntxt-host-code-obj
      535               , input v-cntxt-obj-type
      536               , input v-cntxt-obj-code
      537               , input ?
      538               , input-output v-rid ) NO-ERROR.
      539   END.
      540   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      541   DO:
      542   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      543   if lookup(self :type
      544            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      545            ) = 0
      546   then do:
      547     message
      548       "$Workfile$"
      549       "Указанному интерфейсному элементу фокус не может быть передан" skip
      550       "Интерфейсный элемент" self :name  skip
      551       "Тип" self :type  skip
      552       "Процедура" this-procedure :file-name skip
      553       view-as alert-box .
      554   end.
      555   else do:
      556     apply "entry":u to self  .
      557     if focus :handle <> self :handle  then do:
      558       return no-apply .
      559     end.
      560   end.
      561   define variable v-line-num as integer no-undo .
      562   DEFINE BUFFER buf_tt-payment for tt-payment.
      563   IF AVAIL tt-payment then do:
      564     do
      565     on error undo, return no-apply
      566     :
      567         FIND FIRST buf_tt-payment WHERE
      568                           recid(buf_tt-payment) = RECID(tt-payment) NO-ERROR.
      569         if avail buf_tt-payment then do:
      570             assign
      571             v-line-num = buf_tt-payment.line-num
      572             .
      573             delete buf_tt-payment.
      574         end.
      575         for each buf_tt-payment where
      576                     buf_tt-payment.host-code = p-host-code
      577                 AND buf_tt-payment.source-ref = string(p-fin-doc-code)
      578                 AND buf_tt-payment.line-num > v-line-num
      579                 by buf_tt-payment.pmnt-code:
      580             assign
      581             buf_tt-payment.line-num = buf_tt-payment.line-num - 1
      582             .
      583         end.
      584       end.
      585       run openbr in this-procedure.
      586       RUN get-rest-sum in this-procedure(output v-rest-sum-doc).
      587     end.
      588   END.
      589   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      590   DO:
      591   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      592   if lookup(self :type
      593            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      594            ) = 0
      595   then do:
      596     message
      597       "$Workfile$"
      598       "Указанному интерфейсному элементу фокус не может быть передан" skip
      599       "Интерфейсный элемент" self :name  skip
      600       "Тип" self :type  skip
      601       "Процедура" this-procedure :file-name skip
      602       view-as alert-box .
      603   end.
      604   else do:
      605     apply "entry":u to self  .
      606     if focus :handle <> self :handle  then do:
      607       return no-apply .
      608     end.
      609   end.
      610   END.
      611   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      612   on help of frame Dialog-Frame
      613   do:
      614     run gbl/app_help.p
      615       (input this-procedure :file-name
      616       ,input ''
      617       ,input ?
      618       ) no-error.
      619     if error-status :error then do:
      620       message
      621         "Ошибка при вызове помощи"
      622         error-status :get-message(1)
      623         view-as alert-box .
      624     end.
      625   end.
      626   run minbtn-set in this-procedure .
      627   on choose of b-help in frame Dialog-Frame
      628   do:
      629     apply "help":u to frame Dialog-Frame .
      630   end.
      631   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      632   procedure minbtn-set :
      633       do
      634           on error undo, return error return-value
      635           :
      636           define variable ii              as integer       no-undo .
      637           define variable fh              as widget-handle no-undo .
      638           define variable hh              as widget-handle no-undo .
      639           define variable v-h             as handle        extent 4 no-undo .
      640           define variable v-name-button   as character     no-undo .
      641           define variable v-help-old-x    as decimal       no-undo .
      642           define variable v-help-old-y    as decimal       no-undo .
      643           define variable v-help-old-size as decimal       no-undo .
      644           define variable v-frame-width   as decimal       no-undo .
      645           define variable jj              as integer       no-undo .
      646           do
      647               on error undo, return error
      648               :
      649               assign
      650                   v-frame-width = frame Dialog-Frame:width - 0.3
      651                   fh            = frame Dialog-Frame:first-child
      652                   hh            = fh:first-child
      653                   ii            = 1
      654                   .
      655               do while valid-handle(hh):
      656                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      657                   do:
      658                       case lc(hh:name) :
      659                           when "b-help" then
      660                               do:
      661                                   hh:load-image-up("cmp/b-help.bmp":u) .
      662                                   hh:load-image-down("cmp/b-help.bmp":u) .
      663                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      664                                   hh:TOOLTIP = "Помощь" .
      665                                   v-help-old-x = hh:column .
      666                                   v-help-old-y = hh:row    .
      667                                   v-help-old-size = hh:width .
      668                                   hh:width-chars = 2.5 .
      669                               end.
      670                           when "b-print" then
      671                               do:
      672                                   hh:load-image("cmp/b-print.bmp":u) .
      673                                   hh:TOOLTIP = "Печать" .
      674                                   v-h[ii] = hh:handle .
      675                                   ii = ii + 1 .
      676                                   hh:width-chars = 3 .
      677                               end.
      678                           when "b-history" or
      679                           when "b-hist" then
      680                               do:
      681                                   hh:load-image("cmp/b-hist.bmp":u) .
      682                                   hh:TOOLTIP = "История" .
      683                                   v-h[ii] = hh:handle .
      684                                   ii = ii + 1 .
      685                                   hh:width-chars = 3 .
      686                               end.
      687                           when "b-sch" then
      688                               do:
      689                                   hh:load-image("cmp/b-sch.bmp":u) .
      690                                   hh:TOOLTIP = "Установка Фильтра" .
      691                                   v-h[ii] = hh:handle .
      692                                   ii = ii + 1 .
      693                                   hh:width-chars = 3 .
      694                               end.
      695                           when "b-hist-user" then
      696                               do:
      697                                   hh:load-image("cmp/b-hist.bmp":u) .
      698                                   hh:TOOLTIP = "История пользователя" .
      699                                   ii = ii + 1 .
      700                               end.
      701                       end case.
      702                   end.
      703                   hh = hh:next-sibling.
      704               end.
      705               b-help:column = v-frame-width - b-help:width-chars.
      706               jj = 0.
      707               repeat ii = 4 to 1 by -1 :
      708                   if valid-handle (v-h[ii] ) then
      709                   do:
      710                       jj  = jj + 1 .
      711                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      712                       v-h[ii]:row    = v-help-old-y .
      713                   end.
      714               end.
      715           end.
      716       end.
      717   end procedure.
      718   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      719   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      720   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      721   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      722   define variable v-diasize-current-frame-width  as decimal   no-undo .
      723   define variable v-diasize-current-frame-height as decimal   no-undo .
      724   define variable v-diasize-change-size          as logical   no-undo .
      725   define variable v-diasize-resize-button        as handle    no-undo .
      726   define variable v-diasize-wndmax               as logical   no-undo .
      727   define variable v-diasize-wndstore             as logical   no-undo .
      728   define variable v-diasize-proc-name            as character no-undo .
      729   define variable v-diasize-browse-handle        as handle    no-undo .
      730   define variable v-diasize-browse-number        as integer   no-undo .
      731   define variable v-diasize-need-full-display    as logical   no-undo init false .
      732   define temp-table temp-diasize-handle no-undo
      733     field handle-value  as handle
      734     field save-position as decimal
      735     index xpk is primary unique handle-value
      736     .
      737   define temp-table temp-browse-handle no-undo
      738     field browse-type   as character
      739     field browse-number as integer
      740     field browse-handle as handle
      741     field original-size as decimal
      742     index xpk is primary unique browse-type browse-number
      743     index xie browse-type browse-handle
      744   .
      745   procedure diasize_change-height :
      746     define input  parameter p-change-value  as decimal   no-undo .
      747     define input  parameter p-move-resize   as logical   no-undo .
      748     define variable v-field-group-handle    as handle    no-undo .
      749     define variable v-object-handle         as handle    no-undo .
      750     define variable v-frame-height          as decimal   no-undo .
      751     define variable v-frame-virtual-height  as decimal   no-undo .
      752     define variable v-browse-height         as decimal   no-undo .
      753     define variable v-window-height         as decimal   no-undo .
      754     define variable v-window-virtual-height as decimal   no-undo .
      755     define variable v-change-sign           as integer   no-undo .
      756     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      757     define buffer buf_temp-browse-handle  for temp-browse-handle .
      758     if p-change-value > 0
      759     then do:
      760       if frame Dialog-Frame :height + p-change-value
      761           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      762       then do:
      763         assign
      764           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      765                           - (frame Dialog-Frame :height-chars)
      766         .
      767         if p-change-value <= 0
      768         then do:
      769           run diasize_position-resize-button in this-procedure .
      770           return .
      771         end.
      772       end.
      773     end.
      774     if p-change-value < 0
      775     then do:
      776       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      777       then do:
      778         assign
      779           p-change-value = v-diasize-orig-frame-height
      780                          - (frame Dialog-Frame :height-chars)
      781         .
      782         if p-change-value >= 0
      783         then do:
      784           run diasize_position-resize-button in this-procedure .
      785           return .
      786         end.
      787       end.
      788     end.
      789     if p-change-value >= 0
      790     then do:
      791       assign
      792         v-change-sign = 1
      793       .
      794     end.
      795     else do:
      796       assign
      797         v-change-sign = -1
      798       .
      799     end.
      800     assign
      801       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      802     .
      803     if p-change-value = 0
      804     then do:
      805       run diasize_position-resize-button in this-procedure .
      806       return .
      807     end.
      808     move_block:
      809     do
      810     on error undo move_block, retry move_block
      811     :
      812       if retry
      813       then do:
      814         do
      815         on error undo move_block, leave move_block
      816         :
      817           if p-change-value > 0
      818           then do:
      819             for each buf_temp-diasize-handle
      820             on error undo, next
      821             :
      822               assign
      823                 v-object-handle = buf_temp-diasize-handle.handle-value
      824               .
      825               if v-object-handle <> v-diasize-resize-button
      826               then do:
      827                 assign
      828                   v-object-handle :row = buf_temp-diasize-handle.save-position
      829                 .
      830               end.
      831             end.
      832             assign
      833               v-diasize-browse-handle :height = v-browse-height
      834             .
      835             for each buf_temp-browse-handle
      836               where buf_temp-browse-handle.browse-type = 'height':u
      837             on error undo, next
      838             :
      839               assign
      840                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      841               .
      842             end.
      843             assign
      844               frame Dialog-Frame :height = v-frame-height
      845             .
      846             if frame Dialog-Frame :scrollable = true
      847             then do:
      848               assign
      849                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      850               .
      851             end.
      852             run diasize_position-resize-button in this-procedure .
      853           end.
      854           else do:
      855             if frame Dialog-Frame :scrollable = true
      856             then do:
      857               assign
      858                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      859               .
      860             end.
      861             assign
      862               frame Dialog-Frame :height = v-frame-height
      863             .
      864             assign
      865               v-diasize-browse-handle :height = v-browse-height
      866             .
      867             for each buf_temp-browse-handle
      868               where buf_temp-browse-handle.browse-type = 'height':u
      869             on error undo, next
      870             :
      871               assign
      872                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      873               .
      874             end.
      875             for each buf_temp-diasize-handle
      876             on error undo, next
      877             :
      878               assign
      879                 v-object-handle = buf_temp-diasize-handle.handle-value
      880               .
      881               if v-object-handle <> v-diasize-resize-button
      882               then do:
      883                 assign
      884                   v-object-handle :row = buf_temp-diasize-handle.save-position
      885                 .
      886               end.
      887             end.
      888             run diasize_position-resize-button in this-procedure .
      889           end.
      890           assign
      891             v-diasize-change-size = false
      892           .
      893           leave move_block .
      894         end.
      895       end.
      896       assign
      897         v-diasize-need-full-display = true
      898       .
      899       if v-diasize-change-size = false
      900       then do:
      901         assign
      902           v-diasize-change-size = true
      903         .
      904       end.
      905       else do:
      906         return .
      907       end.
      908       assign
      909         v-frame-height = frame Dialog-Frame :height
      910         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      911         v-browse-height = v-diasize-browse-handle :height
      912       .
      913       for each buf_temp-browse-handle
      914         where buf_temp-browse-handle.browse-type = 'height':u
      915       :
      916         assign
      917           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      918         .
      919       end.
      920       for each buf_temp-diasize-handle
      921       :
      922         delete buf_temp-diasize-handle .
      923       end.
      924       assign
      925         v-field-group-handle = frame Dialog-Frame :first-child
      926       .
      927       do while valid-handle(v-field-group-handle)
      928       :
      929         assign
      930           v-object-handle = v-field-group-handle :first-child
      931         .
      932         do while valid-handle(v-object-handle)
      933         :
      934           if  v-object-handle <> v-diasize-browse-handle :handle
      935           and can-query(v-object-handle, "row")
      936           and can-query(v-object-handle, "height")
      937           and ( v-object-handle :row > v-diasize-browse-handle :row )
      938           then do:
      939             find first buf_temp-browse-handle
      940               where buf_temp-browse-handle.browse-type   = 'height':u
      941                 and buf_temp-browse-handle.browse-handle = v-object-handle
      942               no-error .
      943             if available buf_temp-browse-handle
      944             then do:
      945             end.
      946             else do:
      947               create buf_temp-diasize-handle .
      948               assign
      949                 buf_temp-diasize-handle.handle-value  = v-object-handle
      950                 buf_temp-diasize-handle.save-position = v-object-handle :row
      951               .
      952             end.
      953           end.
      954           assign
      955             v-object-handle = v-object-handle :next-sibling
      956           .
      957         end.
      958         assign
      959           v-field-group-handle = v-field-group-handle :next-sibling
      960         .
      961       end.
      962       do with frame Dialog-Frame
      963       :
      964         hide v-diasize-resize-button .
      965         assign
      966           v-diasize-resize-button :row    = 1
      967           v-diasize-resize-button :column = 1
      968         .
      969       end.
      970       if p-change-value > 0
      971       then do:
      972         if frame Dialog-Frame :scrollable = true
      973         then do:
      974           assign
      975             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      976             no-error .
      977           if error-status :error
      978           or error-status :get-message(1) <> ""
      979           then do:
      980             undo move_block, retry move_block .
      981           end.
      982         end.
      983         assign
      984           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      985           no-error .
      986         if error-status :error
      987         or error-status :get-message(1) <> ""
      988         then do:
      989           undo move_block, retry move_block .
      990         end.
      991         assign
      992           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      993           no-error .
      994         if error-status :error
      995         or error-status :get-message(1) <> ""
      996         then do:
      997           undo move_block, retry move_block .
      998         end.
      999         for each buf_temp-browse-handle
     1000           where buf_temp-browse-handle.browse-type = 'height':u
     1001         on error undo move_block, retry move_block
     1002         :
     1003           assign
     1004             buf_temp-browse-handle.browse-handle :height
     1005               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1006             no-error .
     1007           if error-status :error
     1008           or error-status :get-message(1) <> ""
     1009           then do:
     1010             undo move_block, retry move_block .
     1011           end.
     1012         end.
     1013         for each buf_temp-diasize-handle
     1014         on error undo move_block, retry move_block
     1015         :
     1016           assign
     1017             v-object-handle = buf_temp-diasize-handle.handle-value
     1018           .
     1019           if v-object-handle <> v-diasize-resize-button
     1020           then do:
     1021             assign
     1022               v-object-handle :row = v-object-handle :row + p-change-value
     1023               no-error .
     1024             if error-status :error
     1025             or error-status :get-message(1) <> ""
     1026             then do:
     1027               undo move_block, retry move_block .
     1028             end.
     1029           end.
     1030         end.
     1031       end.
     1032       else do:
     1033         for each buf_temp-diasize-handle
     1034         on error undo move_block, retry move_block
     1035         :
     1036           assign
     1037             v-object-handle = buf_temp-diasize-handle.handle-value
     1038           .
     1039           if v-object-handle <> v-diasize-resize-button
     1040           then do:
     1041             assign
     1042               v-object-handle :row = v-object-handle :row + p-change-value
     1043               no-error .
     1044             if error-status :error
     1045             or error-status :get-message(1) <> ""
     1046             then do:
     1047               undo move_block, retry move_block .
     1048             end.
     1049           end.
     1050         end.
     1051         assign
     1052           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1053           no-error .
     1054         if error-status :error
     1055         or error-status :get-message(1) <> ""
     1056         then do:
     1057           undo move_block, retry move_block .
     1058         end.
     1059         for each buf_temp-browse-handle
     1060           where buf_temp-browse-handle.browse-type = 'height':u
     1061         on error undo move_block, retry move_block
     1062         :
     1063           assign
     1064             buf_temp-browse-handle.browse-handle :height
     1065               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1066             no-error .
     1067           if error-status :error
     1068           or error-status :get-message(1) <> ""
     1069           then do:
     1070             undo move_block, retry move_block .
     1071           end.
     1072         end.
     1073         assign
     1074           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1075           no-error .
     1076         if error-status :error
     1077         or error-status :get-message(1) <> ""
     1078         then do:
     1079           undo move_block, retry move_block .
     1080         end.
     1081         if frame Dialog-Frame :scrollable = true
     1082         then do:
     1083           assign
     1084             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1085             no-error .
     1086           if error-status :error
     1087           or error-status :get-message(1) <> ""
     1088           then do:
     1089             undo move_block, retry move_block .
     1090           end.
     1091         end.
     1092       end.
     1093       if p-move-resize = true
     1094       then do:
     1095         run diasize_position-resize-button in this-procedure .
     1096       end.
     1097       if v-diasize-wndstore = true
     1098       then do:
     1099         if connected("ub") = true
     1100         then do:
     1101           define variable v-cntxt-db-num        as integer   no-undo .
     1102           define variable v-cntxt-userid        as character no-undo .
     1103           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1104                                             , OUTPUT v-cntxt-userid
     1105                                             ) .
     1106           run gbl/wndsizew.p
     1107             (input  v-cntxt-db-num
     1108             ,input  v-cntxt-userid
     1109             ,input  v-diasize-proc-name
     1110             ,input  'height':u
     1111             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1112             ) .
     1113         end.
     1114       end.
     1115     end.
     1116     assign
     1117       v-diasize-change-size = false
     1118     .
     1119   end procedure.
     1120   procedure diasize_set-height :
     1121     define input  parameter p-new-height  as decimal   no-undo .
     1122     define input  parameter p-move-resize as logical   no-undo .
     1123     do
     1124     on error undo, return error return-value
     1125     :
     1126       run diasize_change-height in this-procedure
     1127         (input  (p-new-height - frame Dialog-Frame :height)
     1128         ,input  p-move-resize
     1129         ) .
     1130     end.
     1131   end procedure.
     1132   procedure diasize_change-width :
     1133     define input  parameter p-change-value as decimal   no-undo .
     1134     define input  parameter p-move-resize  as logical   no-undo .
     1135     define variable v-field-group-handle   as handle    no-undo .
     1136     define variable v-object-handle        as handle    no-undo .
     1137     define variable v-frame-width          as decimal   no-undo .
     1138     define variable v-frame-virtual-width  as decimal   no-undo .
     1139     define variable v-browse-width         as decimal   no-undo .
     1140     define variable v-window-width         as decimal   no-undo .
     1141     define variable v-window-virtual-width as decimal   no-undo .
     1142     define variable v-change-sign          as integer   no-undo .
     1143     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1144     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1145     if p-change-value > 0
     1146     then do:
     1147       if frame Dialog-Frame :width + p-change-value >
     1148           session :width-chars
     1149       then do:
     1150         assign
     1151           p-change-value = session :width-chars - frame Dialog-Frame :width
     1152         .
     1153         if p-change-value <= 0
     1154         then do:
     1155           run diasize_position-resize-button in this-procedure .
     1156           return .
     1157         end.
     1158       end.
     1159     end.
     1160     if p-change-value < 0
     1161     then do:
     1162       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1163       then do:
     1164         assign
     1165           p-change-value = v-diasize-orig-frame-width
     1166                          - frame Dialog-Frame :width
     1167         .
     1168         if p-change-value >= 0
     1169         then do:
     1170           run diasize_position-resize-button in this-procedure .
     1171           return .
     1172         end.
     1173       end.
     1174     end.
     1175     if p-change-value >= 0
     1176     then do:
     1177       assign
     1178         v-change-sign = 1
     1179       .
     1180     end.
     1181     else do:
     1182       assign
     1183         v-change-sign = -1
     1184       .
     1185     end.
     1186     assign
     1187       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1188     .
     1189     if p-change-value = 0
     1190     then do:
     1191       run diasize_position-resize-button in this-procedure .
     1192       return .
     1193     end.
     1194     move_block:
     1195     do
     1196     on error undo move_block, leave move_block
     1197     :
     1198       if retry
     1199       then do:
     1200         do
     1201         on error undo move_block, leave move_block
     1202         :
     1203           if p-change-value > 0
     1204           then do:
     1205             for each buf_temp-diasize-handle
     1206             on error undo, next
     1207             :
     1208               assign
     1209                 v-object-handle = buf_temp-diasize-handle.handle-value
     1210               .
     1211               if v-object-handle <> v-diasize-resize-button
     1212               then do:
     1213                 assign
     1214                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1215                 .
     1216               end.
     1217             end.
     1218             assign
     1219               v-diasize-browse-handle :width = v-browse-width
     1220             .
     1221             for each buf_temp-browse-handle
     1222               where buf_temp-browse-handle.browse-type = 'width':u
     1223             on error undo, next
     1224             :
     1225               assign
     1226                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1227               .
     1228             end.
     1229             assign
     1230               frame Dialog-Frame :width = v-frame-width
     1231             .
     1232             if frame Dialog-Frame :scrollable = true
     1233             then do:
     1234               assign
     1235                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1236               .
     1237             end.
     1238             run diasize_position-resize-button in this-procedure .
     1239           end.
     1240           else do:
     1241             if frame Dialog-Frame :scrollable = true
     1242             then do:
     1243               assign
     1244                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1245               .
     1246             end.
     1247             assign
     1248               frame Dialog-Frame :width = v-frame-width
     1249             .
     1250             for each buf_temp-browse-handle
     1251               where buf_temp-browse-handle.browse-type = 'width':u
     1252             on error undo, next
     1253             :
     1254               assign
     1255                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1256               .
     1257             end.
     1258             assign
     1259               v-diasize-browse-handle :width = v-browse-width
     1260             .
     1261             for each buf_temp-diasize-handle
     1262             on error undo, next
     1263             :
     1264               assign
     1265                 v-object-handle = buf_temp-diasize-handle.handle-value
     1266               .
     1267               if v-object-handle <> v-diasize-resize-button
     1268               then do:
     1269                 assign
     1270                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1271                 .
     1272               end.
     1273             end.
     1274             run diasize_position-resize-button in this-procedure .
     1275           end.
     1276           assign
     1277             v-diasize-change-size = false
     1278           .
     1279           leave move_block .
     1280         end.
     1281       end.
     1282       assign
     1283         v-diasize-need-full-display = true
     1284       .
     1285       if v-diasize-change-size = false
     1286       then do:
     1287         assign
     1288           v-diasize-change-size = true
     1289         .
     1290       end.
     1291       else do:
     1292         return .
     1293       end.
     1294       assign
     1295         v-frame-width = frame Dialog-Frame :width
     1296         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1297         v-browse-width = v-diasize-browse-handle :width
     1298       .
     1299       for each buf_temp-browse-handle
     1300         where buf_temp-browse-handle.browse-type = 'width':u
     1301       :
     1302         assign
     1303           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1304         .
     1305       end.
     1306       for each buf_temp-diasize-handle
     1307       :
     1308         delete buf_temp-diasize-handle .
     1309       end.
     1310       assign
     1311         v-field-group-handle = frame Dialog-Frame :first-child
     1312       .
     1313       do while valid-handle(v-field-group-handle)
     1314       :
     1315         assign
     1316           v-object-handle = v-field-group-handle :first-child
     1317         .
     1318         do while valid-handle(v-object-handle)
     1319         :
     1320           if  v-object-handle <> v-diasize-browse-handle :handle
     1321           and v-object-handle <> v-diasize-resize-button
     1322           and can-query(v-object-handle, "row")
     1323           and can-query(v-object-handle, "height")
     1324           and ( v-object-handle :col + v-object-handle :width
     1325                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1326               )
     1327           then do:
     1328             find first buf_temp-browse-handle
     1329               where buf_temp-browse-handle.browse-type   = 'width':u
     1330                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1331               no-error .
     1332             if available buf_temp-browse-handle
     1333             then do:
     1334             end.
     1335             else do:
     1336               create buf_temp-diasize-handle .
     1337               assign
     1338                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1339                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1340               .
     1341             end.
     1342           end.
     1343           assign
     1344             v-object-handle = v-object-handle :next-sibling
     1345           .
     1346         end.
     1347         assign
     1348           v-field-group-handle = v-field-group-handle :next-sibling
     1349         .
     1350       end.
     1351       do with frame Dialog-Frame
     1352       :
     1353         hide v-diasize-resize-button .
     1354         v-diasize-resize-button :row = 1.
     1355         v-diasize-resize-button :column = 1.
     1356       end.
     1357       if p-change-value > 0
     1358       then do:
     1359         if frame Dialog-Frame :scrollable = true
     1360         then do:
     1361           assign
     1362             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1363             no-error .
     1364           if error-status :error
     1365           or error-status :get-message(1) <> ""
     1366           then do:
     1367             undo move_block, retry move_block.
     1368           end.
     1369         end.
     1370         assign
     1371           frame Dialog-Frame :width = v-frame-width + p-change-value
     1372           no-error .
     1373         if error-status :error
     1374         or error-status :get-message(1) <> ""
     1375         then do:
     1376           undo move_block, retry move_block.
     1377         end.
     1378         assign
     1379           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1380         no-error .
     1381         if error-status :error
     1382         or error-status :get-message(1) <> ""
     1383         then do:
     1384           undo move_block, retry move_block.
     1385         end.
     1386         for each buf_temp-browse-handle
     1387           where buf_temp-browse-handle.browse-type = 'width':u
     1388         on error undo move_block, retry move_block
     1389         :
     1390           assign
     1391             buf_temp-browse-handle.browse-handle :width
     1392               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1393             no-error .
     1394           if error-status :error
     1395           or error-status :get-message(1) <> ""
     1396           then do:
     1397             undo move_block, retry move_block .
     1398           end.
     1399         end.
     1400         for each buf_temp-diasize-handle
     1401         on error undo move_block, retry move_block
     1402         :
     1403           assign
     1404             v-object-handle = buf_temp-diasize-handle.handle-value
     1405           .
     1406           if v-object-handle <> v-diasize-resize-button
     1407           then do:
     1408             assign
     1409               v-object-handle :col = v-object-handle :col + p-change-value
     1410               no-error .
     1411             if error-status :error
     1412             or error-status :get-message(1) <> ""
     1413             then do:
     1414               undo move_block, retry move_block .
     1415             end.
     1416           end.
     1417         end.
     1418       end.
     1419       else do:
     1420         for each buf_temp-diasize-handle
     1421         on error undo move_block, retry move_block
     1422         :
     1423           assign
     1424             v-object-handle = buf_temp-diasize-handle.handle-value
     1425           .
     1426           if v-object-handle <> v-diasize-resize-button
     1427           then do:
     1428             assign
     1429               v-object-handle :col = v-object-handle :col + p-change-value
     1430               no-error .
     1431             if error-status :error
     1432             or error-status :get-message(1) <> ""
     1433             then do:
     1434               undo move_block, retry move_block .
     1435             end.
     1436           end.
     1437         end.
     1438         for each buf_temp-browse-handle
     1439           where buf_temp-browse-handle.browse-type = 'width':u
     1440         on error undo move_block, retry move_block
     1441         :
     1442           assign
     1443             buf_temp-browse-handle.browse-handle :width
     1444               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1445             no-error .
     1446           if error-status :error
     1447           or error-status :get-message(1) <> ""
     1448           then do:
     1449             undo move_block, retry move_block .
     1450           end.
     1451         end.
     1452         assign
     1453           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1454           no-error .
     1455         if error-status :error
     1456         or error-status :get-message(1) <> ""
     1457         then do:
     1458           undo move_block, retry move_block.
     1459         end.
     1460         assign
     1461           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1462         no-error .
     1463         if error-status :error
     1464         or error-status :get-message(1) <> ""
     1465         then do:
     1466           undo move_block, retry move_block.
     1467         end.
     1468         if frame Dialog-Frame :scrollable = true
     1469         then do:
     1470           assign
     1471             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1472           no-error .
     1473           if error-status :error
     1474           or error-status :get-message(1) <> ""
     1475           then do:
     1476             undo move_block, retry move_block.
     1477           end.
     1478         end.
     1479       end.
     1480       if p-move-resize
     1481       then do:
     1482         run diasize_position-resize-button in this-procedure .
     1483       end.
     1484       if v-diasize-wndstore = true
     1485       then do:
     1486         if connected("ub") = true
     1487         then do:
     1488           define variable v-cntxt-db-num        as integer   no-undo .
     1489           define variable v-cntxt-userid        as character no-undo .
     1490           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1491                                             , OUTPUT v-cntxt-userid
     1492                                             ) .
     1493           run gbl/wndsizew.p
     1494             (input  v-cntxt-db-num
     1495             ,input  v-cntxt-userid
     1496             ,input  v-diasize-proc-name
     1497             ,input  'width':u
     1498             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1499             ) .
     1500         end.
     1501       end.
     1502     end.
     1503     assign
     1504       v-diasize-change-size = false
     1505     .
     1506   end procedure.
     1507   procedure diasize_set-width :
     1508     define input  parameter p-new-width  as decimal   no-undo .
     1509     define input  parameter p-move-resize as logical   no-undo .
     1510     do
     1511     on error undo, return error return-value
     1512     :
     1513       run diasize_change-width in this-procedure
     1514         (input  (p-new-width - frame Dialog-Frame :width)
     1515         ,input  p-move-resize
     1516         ) .
     1517     end.
     1518   end procedure.
     1519   procedure diasize_position-resize-button :
     1520     do with frame Dialog-Frame
     1521     :
     1522       hide v-diasize-resize-button .
     1523       assign
     1524         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1525                     - 1
     1526                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1527         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1528                     - 1
     1529                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1530       .
     1531       view v-diasize-resize-button .
     1532     end.
     1533   end procedure.
     1534   on alt-right anywhere
     1535   do:
     1536     run diasize_change-width in this-procedure
     1537       (input 1
     1538       ,input true
     1539       ) .
     1540     return no-apply .
     1541   end.
     1542   on alt-left anywhere
     1543   do:
     1544     run diasize_change-width in this-procedure
     1545       (input -1
     1546       ,input true
     1547       ) .
     1548     return no-apply .
     1549   end.
     1550   on alt-down anywhere
     1551   do:
     1552     run diasize_change-height in this-procedure
     1553       (input 1
     1554       ,input true
     1555       ) .
     1556     return no-apply .
     1557   end.
     1558   on alt-up anywhere
     1559   do:
     1560     run diasize_change-height in this-procedure
     1561       (input -1
     1562       ,input true
     1563       ) .
     1564     return no-apply .
     1565   end.
     1566   on alt-enter of frame Dialog-Frame
     1567   do:
     1568     run diasize_maximize in this-procedure
     1569       (input  ?
     1570       ).
     1571     return no-apply .
     1572   end.
     1573   procedure diasize_end-move :
     1574     do
     1575     on error undo, return error return-value
     1576     :
     1577       define variable v-row-delta as decimal   no-undo .
     1578       define variable v-col-delta as decimal   no-undo .
     1579       define variable v-new-row as decimal   no-undo .
     1580       define variable v-new-col as decimal   no-undo .
     1581       assign
     1582         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1583         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1584       .
     1585       assign
     1586         v-row-delta = v-new-row - frame Dialog-Frame :height
     1587         v-col-delta = v-new-col - frame Dialog-Frame :width
     1588       .
     1589       run diasize_change-height in this-procedure
     1590         (input v-row-delta
     1591         ,input true
     1592         ) .
     1593       run diasize_change-width in this-procedure
     1594         (input v-col-delta
     1595         ,input true
     1596         ) .
     1597     end.
     1598   end procedure.
     1599   procedure diasize_maximize :
     1600     define input  parameter p-action as logical   no-undo .
     1601     do
     1602     on error undo, return error return-value
     1603     :
     1604       if p-action = ?
     1605       then do:
     1606         if v-diasize-need-maximize = true
     1607         then do:
     1608           assign
     1609             p-action = true
     1610           .
     1611         end.
     1612         else do:
     1613           assign
     1614             p-action = false
     1615           .
     1616         end.
     1617       end.
     1618       if p-action = true
     1619       then do:
     1620         run diasize_change-height in this-procedure
     1621           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1622               - frame Dialog-Frame :height-chars
     1623           ,input true
     1624           ) .
     1625         run diasize_change-width in this-procedure
     1626           (input session :width-chars
     1627               - frame Dialog-Frame :width-chars
     1628           ,input true
     1629           ) .
     1630         assign
     1631           v-diasize-need-maximize = false
     1632         .
     1633       end.
     1634       else do:
     1635         run diasize_change-width in this-procedure
     1636           (input v-diasize-orig-frame-width
     1637               - frame Dialog-Frame :width-chars
     1638           ,input true
     1639           ) .
     1640         run diasize_change-height in this-procedure
     1641           (input v-diasize-orig-frame-height
     1642               - frame Dialog-Frame :height-chars
     1643           ,input true
     1644           ) .
     1645         assign
     1646           v-diasize-need-maximize = true
     1647         .
     1648       end.
     1649     end.
     1650   end procedure.
     1651   procedure diasize_restore-orig-size :
     1652     do
     1653     on error undo, return error return-value
     1654     :
     1655       assign
     1656         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1657         v-diasize-current-frame-height = frame Dialog-Frame :height
     1658       .
     1659       run diasize_set-height in this-procedure
     1660         (input  v-diasize-orig-frame-height
     1661         ,input  true
     1662         ) .
     1663       run diasize_set-width in this-procedure
     1664         (input  v-diasize-orig-frame-width
     1665         ,input  true
     1666         ) .
     1667     end.
     1668   end procedure.
     1669   procedure diasize_restore-current-size :
     1670     do
     1671     on error undo, return error return-value
     1672     :
     1673       run diasize_set-height in this-procedure
     1674         (input  v-diasize-current-frame-height
     1675         ,input  true
     1676         ) .
     1677       run diasize_set-width in this-procedure
     1678         (input  v-diasize-current-frame-width
     1679         ,input  true
     1680         ) .
     1681     end.
     1682   end procedure.
     1683   procedure diasize_set-browse-handle :
     1684     define input  parameter p-browse-handle as handle   no-undo .
     1685     define buffer buf_temp-browse-handle for temp-browse-handle .
     1686     do
     1687     on error undo, return error return-value
     1688     :
     1689       assign
     1690         v-diasize-browse-handle = p-browse-handle
     1691       .
     1692       for each buf_temp-browse-handle
     1693       on error undo, return error return-value
     1694       :
     1695         delete buf_temp-browse-handle .
     1696       end.
     1697     end.
     1698   end procedure.
     1699   procedure diasize_add_browse :
     1700     define input  parameter p-browse-type   as character no-undo .
     1701     define input  parameter p-browse-handle as handle    no-undo .
     1702     define buffer buf_temp-browse-handle for temp-browse-handle .
     1703     do
     1704     on error undo, return error return-value
     1705     :
     1706       assign
     1707         v-diasize-browse-number = v-diasize-browse-number + 1
     1708       .
     1709       create buf_temp-browse-handle .
     1710       assign
     1711         buf_temp-browse-handle.browse-type   = p-browse-type
     1712         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1713         buf_temp-browse-handle.browse-handle = p-browse-handle
     1714       .
     1715     end.
     1716   end procedure.
     1717   procedure diasize_init :
     1718     define variable v-default-value    as logical   no-undo .
     1719     define variable v-restore-saved    as logical   no-undo .
     1720     define variable v-resize-value-str as character no-undo .
     1721     do
     1722     on error undo, return error return-value
     1723     :
     1724       do with frame Dialog-Frame
     1725       :
     1726         assign
     1727           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1728           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1729           v-diasize-browse-handle     = browse BR-payment :handle
     1730         .
     1731         create button v-diasize-resize-button
     1732         assign
     1733           parent        = frame Dialog-Frame :first-child
     1734           label         = "s"
     1735           height-pixels = 16
     1736           width-pixels  = 16
     1737           visible       = true
     1738           sensitive     = true
     1739           movable       = true
     1740           triggers:
     1741             on end-move persistent run diasize_end-move in this-procedure .
     1742           end triggers.
     1743         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1744         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1745         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1746         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1747         assign
     1748           v-diasize-wndmax = false
     1749         .
     1750         if connected("ub") = true
     1751         then do:
     1752           define variable v-cntxt-db-num        as integer   no-undo .
     1753           define variable v-cntxt-userid        as character no-undo .
     1754           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1755                                             , OUTPUT v-cntxt-userid
     1756                                             ) .
     1757           run gbl/wndpar_r.p
     1758             (input  v-cntxt-db-num
     1759             ,input  v-cntxt-userid
     1760             ,input  'wndmax':U
     1761             ,output v-diasize-wndmax
     1762             ,output v-default-value
     1763             ) .
     1764         end.
     1765         assign
     1766           v-diasize-wndstore = false
     1767         .
     1768         if connected("ub") = true
     1769         then do:
     1770           run gbl/wndpar_r.p
     1771             (input  v-cntxt-db-num
     1772             ,input  v-cntxt-userid
     1773             ,input  'wndstore':U
     1774             ,output v-diasize-wndstore
     1775             ,output v-default-value
     1776             ) .
     1777         end.
     1778         assign
     1779           v-diasize-proc-name = entry(1, program-name(2), '.')
     1780         .
     1781         if v-diasize-wndstore = true
     1782         then do:
     1783           assign
     1784             v-restore-saved = false
     1785           .
     1786           if connected("ub") = true
     1787           then do:
     1788             run gbl/wndsizer.p
     1789               (input  v-cntxt-db-num
     1790               ,input  v-cntxt-userid
     1791               ,input  v-diasize-proc-name
     1792               ,input  'height':u
     1793               ,output v-resize-value-str
     1794               ) .
     1795             if v-resize-value-str <> '':U
     1796             then do:
     1797               run diasize_change-height in this-procedure
     1798                 (input  integer(v-resize-value-str)
     1799                 ,input  true
     1800                 ) .
     1801               assign
     1802                 v-restore-saved = true
     1803               .
     1804             end.
     1805           end.
     1806           if connected("ub") = true
     1807           then do:
     1808             run gbl/wndsizer.p
     1809               (input  v-cntxt-db-num
     1810               ,input  v-cntxt-userid
     1811               ,input  v-diasize-proc-name
     1812               ,input  'width':u
     1813               ,output v-resize-value-str
     1814               ) .
     1815             if v-resize-value-str <> '':U
     1816             then do:
     1817               run diasize_change-width in this-procedure
     1818                 (input  integer(v-resize-value-str)
     1819                 ,input  true
     1820                 ) .
     1821               assign
     1822                 v-restore-saved = true
     1823               .
     1824             end.
     1825           end.
     1826           if v-restore-saved <> true
     1827           then do:
     1828             if v-diasize-wndmax = true
     1829             then do:
     1830               run diasize_maximize in this-procedure
     1831                 (input  true
     1832                 ) .
     1833             end.
     1834           end.
     1835         end.
     1836         else do:
     1837           if v-diasize-wndmax = true
     1838           then do:
     1839             run diasize_maximize in this-procedure
     1840               (input  true
     1841               ) .
     1842           end.
     1843         end.
     1844       end.
     1845     end.
     1846   end procedure.
     1847   procedure diasize_need-full-display :
     1848     define output parameter p-need-full-display as logical   no-undo .
     1849     do
     1850     on error undo, return error return-value
     1851     :
     1852       assign
     1853         p-need-full-display = v-diasize-need-full-display
     1854       .
     1855       assign
     1856         v-diasize-need-full-display = false
     1857       .
     1858     end.
     1859   end procedure.
     1860   procedure get-context :
     1861      define output parameter p-db-num as integer          no-undo.
     1862      define output parameter p-user-id as character        no-undo.
     1863      define variable v-login               as character    no-undo.
     1864      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1865      define buffer buf_user-login  for ub.user-login .
     1866      do
     1867      on error undo, return error
     1868      :
     1869            FIND FIRST buf_sys-ctrl no-lock.
     1870            ASSIGN
     1871               v-login = USERID("ub")
     1872               p-db-num = buf_sys-ctrl.db-num
     1873            .
     1874            FIND FIRST buf_user-login
     1875                 WHERE buf_user-login.db-num = p-db-num
     1876                   AND buf_user-login.user-login = v-login
     1877                 no-lock
     1878                 no-error
     1879                 .
     1880            IF AVAILABLE buf_user-login
     1881            THEN DO:
     1882               assign
     1883                  p-user-id = buf_user-login.user-id
     1884               .
     1885            END.
     1886      end.
     1887   end procedure.
     1888       run diasize_init in this-procedure .
     1889   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1890   ON TAB ANYWHERE
     1891   DO:
     1892   define variable ii as integer no-undo .
     1893   define variable fh as widget-handle no-undo .
     1894   define variable hh as widget-handle no-undo .
     1895   define variable v-next-widget-name as character no-undo .
     1896   if "b-add,b-del,b-quit,b-exit" <> '' then do:
     1897     if self:type = "TOGGLE-BOX" then
     1898     self:BGCOLOR = ?.
     1899     assign
     1900     ii = lookup(self:name, "b-add,b-del,b-quit,b-exit").
     1901     assign
     1902     ii = ii + 1
     1903     v-next-widget-name = entry(ii, "b-add,b-del,b-quit,b-exit")
     1904     no-error .
     1905     if error-status:error then do:
     1906       assign
     1907       ii = 1
     1908       v-next-widget-name = entry( ii, "b-add,b-del,b-quit,b-exit")
     1909       .
     1910     end.
     1911     assign
     1912     fh = frame Dialog-Frame:first-child
     1913     hh = fh:first-child
     1914     .
     1915     do while valid-handle(hh):
     1916       if hh:name = v-next-widget-name then do:
     1917         if hh:sensitive  = yes
     1918         AND hh:visible = yes then do:
     1919           if hh:type = "TOGGLE-BOX":U then do:
     1920             assign
     1921             hh:BGcolor = 1
     1922             .
     1923           end.
     1924           APPLY "ENTRY" to hh.
     1925           return no-apply.
     1926         end.
     1927         else do:
     1928           APPLY "TAB" to hh.
     1929           return no-apply.
     1930         end.
     1931       end.
     1932       hh = hh:next-sibling.
     1933     end.
     1934   end.
     1935   END.
     1936   ON BACK-TAB ANYWHERE
     1937   DO:
     1938   define variable ii as integer no-undo .
     1939   define variable fh as widget-handle no-undo .
     1940   define variable hh as widget-handle no-undo .
     1941   define variable v-next-widget-name as character no-undo .
     1942   if "b-add,b-del,b-quit,b-exit" <> '' then do:
     1943     assign
     1944     ii = lookup(self:name, "b-add,b-del,b-quit,b-exit").
     1945     .
     1946     assign
     1947     ii = (if ii = 1
     1948           then  num-entries("b-add,b-del,b-quit,b-exit")
     1949           else ii - 1
     1950           )
     1951     v-next-widget-name = entry(ii, "b-add,b-del,b-quit,b-exit")
     1952     .
     1953     assign
     1954     fh = frame Dialog-Frame:first-child
     1955     hh = fh:first-child
     1956     .
     1957     do while valid-handle(hh):
     1958       if hh:name = v-next-widget-name then do:
     1959         if hh:sensitive  = yes
     1960         AND hh:visible = yes then do:
     1961           if hh:type = "TOGGLE-BOX":U then do:
     1962             assign
     1963             hh:BGcolor = 1
     1964             .
     1965           end.
     1966           APPLY "ENTRY" to hh.
     1967           return no-apply.
     1968         end.
     1969         else do:
     1970         APPLY "BACK-TAB" to hh.
     1971         return no-apply.
     1972         end.
     1973       end.
     1974       hh = hh:next-sibling.
     1975     end.
     1976     end.
     1977   END.
     1978   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1979   do:
     1980     BR-payment :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     1981   end.
     1982   ON LEAVE OF tt-payment.tot-cli IN BROWSE br-payment do:
     1983     assign
     1984     tt-payment.tot-cli = decimal(tt-payment.tot-cli:screen-value in browse br-payment)
     1985     tt-payment.tot-base =  (tt-payment.tot-cli * p-exch-rate / p-exch-scale) /  (p-base-rate / p-base-scale)
     1986     tt-payment.tot-rubl =  (tt-payment.tot-cli * p-exch-rate / p-exch-scale)
     1987     .
     1988     RUN get-rest-sum in this-procedure(output v-rest-sum-doc).
     1989   end.
     1990   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1991   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1992   MAIN-BLOCK:
     1993   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1994      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1995   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1996     run mainmenu_getcntxt in parparentproc
     1997       (output v-cntxt-db-num
     1998       ,output v-cntxt-userid
     1999       ,output v-cntxt-level
     2000       ,output v-cntxt-host-code-obj
     2001       ,output v-cntxt-obj-type
     2002       ,output v-cntxt-obj-code
     2003       ,output v-cntxt-db-num-obj
     2004       ,output v-cntxt-is-admin
     2005       ) .
     2006     if p-mode <> 'ИЗМЕНЕНИЕ':U
     2007     and p-mode <> 'ПРОСМОТР':U
     2008     and p-mode <> 'ДОБАВЛЕНИЕ':U
     2009     and p-mode <> ('ПРОСМОТР':U + chr(4) + "history":U)
     2010     then do:
     2011       message
     2012       vss-workfile vss-revision vss-description skip
     2013       "Неверное значение параметров вызова p-mode"  p-mode
     2014       view-as alert-box ERROR.
     2015       undo, return error.
     2016     end.
     2017   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2018   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2019     (output v-db-num
     2020     )  .
     2021   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2022   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2023     (input  p-host-code
     2024     ,output v-base-code
     2025     )  .
     2026       find first X_curr_sysconf no-lock where
     2027                       X_curr_sysconf.host-code = p-curr-host-code.
     2028       find first X_sysconf no-lock where
     2029                     X_sysconf.host-code = p-host-code.
     2030       find first X_clients-host no-lock where
     2031                 X_clients-host.obj-type = 'орг':U
     2032             AND X_clients-host.obj-code = p-host-code.
     2033     if p-mode = 'ИЗМЕНЕНИЕ':U
     2034     or p-mode = 'ПРОСМОТР':U then do:
     2035       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     2036         find first locked_fin-doc EXclusive-lock where
     2037                    locked_fin-doc.host-code  = p-host-code
     2038                AND locked_fin-doc.fin-doc-code  = p-fin-doc-code
     2039                      no-wait no-error.
     2040         if locked locked_fin-doc then do:
     2041           message
     2042           vss-workfile vss-revision vss-description skip
     2043           "Запись Платежа занята"
     2044           "фирма" p-host-code
     2045           "внутр. № документа" p-fin-doc-code
     2046           view-as alert-box error .
     2047           undo, return error.
     2048         end.
     2049       end.
     2050       else do:
     2051         find first locked_fin-doc no-lock where
     2052                    locked_fin-doc.host-code  = p-host-code
     2053                AND locked_fin-doc.fin-doc-code  = p-fin-doc-code no-error .
     2054       end.
     2055       if not available locked_fin-doc
     2056       then do:
     2057         message
     2058         vss-workfile vss-revision vss-description skip
     2059         "Не найдена запись ПЛАТЕЖА"
     2060         view-as alert-box error .
     2061         undo, return error.
     2062       end.
     2063     end.
     2064     if p-mode = ('ПРОСМОТР':U + chr(4) + "history":U)
     2065     then do:
     2066       find first locked_c-fin-doc no-lock where
     2067                   locked_c-fin-doc.host-code  = p-host-code
     2068               AND locked_c-fin-doc.fin-doc-code  = p-fin-doc-code no-error .
     2069       if not available locked_c-fin-doc
     2070       then do:
     2071         message
     2072         vss-workfile vss-revision vss-description skip
     2073         "Не найдена запись истории ПЛАТЕЖА"
     2074         view-as alert-box error .
     2075         undo, return error.
     2076       end.
     2077     end.
     2078     find first X_currency no-lock where
     2079                  X_currency.curr-code = p-curr-code.
     2080     run fill-tables in this-procedure.
     2081     RUN Myenable.
     2082     WAIT-FOR GO OF FRAME Dialog-Frame.
     2083   END.
     2084   RUN disable_UI.
     2085   PROCEDURE check-sums :
     2086   define variable acc as decimal no-undo.
     2087   define buffer buf_tt-payment for tt-payment.
     2088   for each buf_tt-payment:
     2089       assign
     2090       acc = acc + buf_tt-payment.tot-cli
     2091       .
     2092   end.
     2093   if acc <> p-sum-doc then do:
     2094   message
     2095   substitute("Общая сумма платежа &1, а сумма по картам - &2", p-sum-doc, acc)
     2096   view-as alert-box ERROR.
     2097   return error.
     2098   end.
     2099   END PROCEDURE.
     2100   PROCEDURE create-payment-line :
     2101   DEFINE PARAMETER BUFFER buf_dis-card FOR ub.dis-card.
     2102   define buffer buf_tt-payment for tt-payment.
     2103   FIND FIRST buf_tt-payment NO-LOCK WHERE
     2104           buf_tt-payment.d-card = buf_dis-card.d-card no-error.
     2105   IF AVAILABLE buf_tt-payment THEN DO:
     2106     MESSAGE
     2107     SUBSTITUTE("Уже есть строка привязки к карте &1", buf_dis-card.d-card)
     2108     VIEW-AS ALERT-BOX ERROR.
     2109     UNDO, RETURN ERROR.
     2110   END.
     2111   FIND LAST buf_tt-payment  NO-ERROR.
     2112   IF AVAILABLE buf_tt-payment THEN DO:
     2113     last-line = integer(entry(2, buf_tt-payment.pmnt-code, "_")).
     2114   END.
     2115   CREATE buf_tt-payment.
     2116   ASSIGN
     2117   buf_tt-payment.host-code = p-host-code
     2118   buf_tt-payment.source-type = 'платеж':U
     2119   buf_tt-payment.source-ref = string(p-fin-doc-code)
     2120   buf_tt-payment.pmnt-code = substitute("&1_&2", v-pmnt-code, string(last-line + 1, "999999999"))
     2121   buf_tt-payment.line-num = last-line + 1
     2122   last-line = last-line + 1
     2123   buf_tt-payment.d-card = buf_dis-card.d-card
     2124   buf_tt-payment.cli-type = buf_dis-card.cli-type
     2125   buf_tt-payment.cli-code = buf_dis-card.cli-code
     2126   buf_tt-payment.payer-type = p-payer-type
     2127   buf_tt-payment.payer-code = p-payer-code
     2128   buf_tt-payment.exch-date = p-doc-date
     2129   buf_tt-payment.exch-code = p-curr-code
     2130   buf_tt-payment.exch-rate = p-exch-rate
     2131   buf_tt-payment.exch-scale = p-exch-scale
     2132   buf_tt-payment.base-rate = p-base-rate
     2133   buf_tt-payment.base-scale = p-base-scale
     2134   buf_tt-payment.due-date = p-pay-date
     2135   buf_tt-payment.STATUS_ = 'ожид':U
     2136   buf_tt-payment.PS = '':U
     2137   buf_tt-payment.pay-code = (if p-fin-ext-doc-type = 'пко':U
     2138                             then 1
     2139                             else (if p-fin-ext-doc-type = 'ппп':U
     2140                                  then 3
     2141                                  else 5)
     2142                             )
     2143   .
     2144   END PROCEDURE.
     2145   PROCEDURE disable_UI :
     2146     HIDE FRAME Dialog-Frame.
     2147   END PROCEDURE.
     2148   PROCEDURE enable_UI :
     2149     OPEN QUERY Dialog-Frame FOR EACH locked_fin-doc SHARE-LOCK.
     2150     GET FIRST Dialog-Frame.
     2151     DISPLAY f-all-sum-doc F-curr-code f-curr-abbr f-rest-sum-doc
     2152         WITH FRAME Dialog-Frame.
     2153     ENABLE B-exit b-quit B-add B-del b-dc B-Help F-curr-code BR-payment
     2154         WITH FRAME Dialog-Frame.
     2155     VIEW FRAME Dialog-Frame.
     2156   END PROCEDURE.
     2157   PROCEDURE fill-tables :
     2158   define variable v-found as logical no-undo .
     2159   define buffer buf_payment for ub.payment.
     2160   define buffer buf_c-payment for ub.payment.
     2161   define buffer buf_tt-payment for tt-payment.
     2162   do on error undo, return error:
     2163     if p-mode = 'ПРОСМОТР':U + chr(4) + "History":U then do:
     2164       for each buf_c-payment no-lock where
     2165                   buf_c-payment.host-code = p-host-code
     2166             AND buf_c-payment.source-type = 'платеж':U
     2167             AND buf_c-payment.source-ref = string(p-fin-doc-code)
     2168             :
     2169         create buf_tt-payment.
     2170         buffer-copy buf_c-payment to buf_tt-payment.
     2171       END.
     2172     end.
     2173     else do:
     2174       find first tt0-payment no-lock no-error.
     2175       if available tt0-payment then do:
     2176         for each tt0-payment no-lock where
     2177                     tt0-payment.host-code = p-host-code
     2178               AND tt0-payment.source-type = 'платеж':U
     2179               AND tt0-payment.source-ref = string(p-fin-doc-code):
     2180           create buf_tt-payment.
     2181           buffer-copy tt0-payment to buf_tt-payment
     2182           assign
     2183           buf_tt-payment.line-num = integer(entry(2, tt0-payment.pmnt-code, "_"))
     2184           .
     2185         END.
     2186       end.
     2187       else do:
     2188         for each buf_payment no-lock where
     2189                     buf_payment.host-code = p-host-code
     2190               AND buf_payment.source-type = 'платеж':U
     2191               AND buf_payment.source-ref = string(p-fin-doc-code):
     2192           create buf_tt-payment.
     2193           buffer-copy buf_payment to buf_tt-payment
     2194           assign
     2195           buf_tt-payment.line-num = integer(entry(2, buf_payment.pmnt-code, "_"))
     2196           v-pmnt-code = entry(1, buf_payment.pmnt-code, "_")
     2197           .
     2198           v-found = YES.
     2199         END.
     2200         IF v-found = NO
     2201         AND p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     2202            FOR EACH buf_dis-card NO-LOCK WHERE
     2203                    buf_Dis-card.cli-type = p-payer-type
     2204                AND buf_Dis-card.cli-code = p-payer-code:
     2205              RUN create-payment-line IN THIS-PROCEDURE ( BUFFER buf_dis-card).
     2206            END.
     2207         END.
     2208       end.
     2209     end.
     2210     RUN get-rest-sum in this-procedure(output v-rest-sum-doc).
     2211   end.
     2212   END PROCEDURE.
     2213   PROCEDURE get-rest-sum :
     2214   define output parameter p-rest-sum like ub.payment.tot-cli no-undo.
     2215   define buffer buf_tt-payment for tt-payment.
     2216   for each buf_tt-payment no-lock:
     2217       assign
     2218       p-rest-sum = p-rest-sum + buf_tt-payment.tot-cli
     2219       .
     2220   end.
     2221   assign
     2222   p-rest-sum = p-sum-doc - p-rest-sum
     2223   .
     2224   DISPLAY
     2225   p-rest-sum @ f-rest-sum-doc
     2226   WITH FRAME Dialog-Frame.
     2227   END PROCEDURE.
     2228   PROCEDURE Myenable :
     2229   assign
     2230   frame Dialog-Frame:title = substitute("&1 для платежа &2", frame Dialog-Frame:title
     2231                                                , p-fin-doc-code)
     2232   b-quit:label = (if lookup('ПРОСМОТР':U, p-mode, chr(4)) > 0 then "&Выход" else b-quit:label)
     2233   .
     2234   DISPLAY
     2235   p-sum-doc @ f-all-sum-doc
     2236   p-curr-code @ f-curr-code
     2237   X_currency.curr-abbr @ f-curr-abbr
     2238   WITH FRAME Dialog-Frame.
     2239   ENABLE
     2240   b-quit
     2241   B-exit when lookup('ПРОСМОТР':U, p-mode, chr(4)) = 0
     2242   B-add  when lookup('ПРОСМОТР':U, p-mode, chr(4)) = 0
     2243   B-del  when lookup('ПРОСМОТР':U, p-mode, chr(4)) = 0
     2244   b-dc
     2245   B-Help
     2246   BR-payment
     2247   WITH FRAME Dialog-Frame.
     2248   if lookup('ПРОСМОТР':U, p-mode, chr(4)) > 0 then do:
     2249     assign
     2250     tt-payment.tot-cli:read-only in browse br-payment = yes
     2251     .
     2252     hide
     2253     b-exit
     2254     in frame Dialog-Frame .
     2255     b-quit:column = 1.
     2256   end.
     2257   VIEW FRAME Dialog-Frame.
     2258   RUN openbr in this-procedure .
     2259   END PROCEDURE.
     2260   PROCEDURE OpenBr :
     2261   output to kk.txt.
     2262   for each tt-payment:
     2263   export tt-payment.
     2264   end.
     2265   output close.
     2266   Open query br-payment
     2267   for each tt-payment no-lock where
     2268               tt-payment.source-type = 'платеж':U
     2269           AND tt-payment.source-ref = string(p-fin-doc-code)
     2270           AND tt-payment.host-code = p-host-code,
     2271       first buf_dis-card no-lock where
     2272             buf_dis-card.d-card = tt-payment.d-card,
     2273       first buf_clients no-lock where
     2274           buf_clients.obj-type = buf_dis-card.cli-type
     2275        and buf_clients.obj-code = buf_dis-card.cli-code.
     2276   END PROCEDURE.
     2277   PROCEDURE proc-b-add :
     2278   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2279   define variable v-ii as integer no-undo .
     2280   DEFINE BUFFER buf_clients FOR ub.clients.
     2281   define buffer buf_dis-card for ub.dis-card.
     2282   FIND FIRST buf_clients NO-LOCK WHERE
     2283           buf_clients.obj-type = p-payer-type
     2284       AND buf_clients.obj-code = p-payer-code.
     2285   run ref/discards.w ( INPUT parparentproc
     2286                       ,INPUT "b-sel,b-mark"
     2287                       ,INPUT "client"
     2288                       ,INPUT v-cntxt-host-code-obj
     2289                       ,INPUT v-cntxt-obj-type
     2290                       ,INPUT v-cntxt-obj-code
     2291                       ,INPUT '':U
     2292                       ,INPUT RECID(buf_clients)
     2293                       ,OUTPUT v-rid-list) NO-ERROR.
     2294   IF v-rid-list <> '' THEN DO:
     2295     DO v-ii = 1 TO NUM-ENTRIES(v-rid-list):
     2296         FIND FIRST buf_dis-card NO-LOCK WHERE
     2297             recid(buf_Dis-card) = integer(ENTRY(v-ii, v-rid-list)) NO-ERROR.
     2298         IF AVAILABLE buf_dis-card THEN DO:
     2299            RUN create-payment-line IN THIS-PROCEDURE ( BUFFER buf_dis-card).
     2300         END.
     2301     END.
     2302     RUN Openbr IN THIS-PROCEDURE NO-ERROR.
     2303     RUN get-rest-sum in this-procedure(output v-rest-sum-doc).
     2304   END.
     2305   END PROCEDURE.
     2306   PROCEDURE proc-save :
     2307   do on error undo, return error:
     2308     for each tt0-payment where
     2309             tt0-payment.host-code = p-host-code
     2310          AND tt0-payment.source-type = 'платеж':U
     2311          AND tt0-payment.source-ref = string(p-fin-doc-code):
     2312       find first tt-payment no-lock where
     2313                  tt-payment.host-code = p-host-code
     2314              AND tt-payment.source-ref = string(p-fin-doc-code)
     2315              AND tt-payment.pmnt-code = tt0-payment.pmnt-code no-error .
     2316       if not available tt-payment then do:
     2317         delete tt0-payment.
     2318       end.
     2319     end.
     2320    for each tt-payment :
     2321       find first tt0-payment where
     2322                  tt0-payment.host-code = p-host-code
     2323              AND tt0-payment.source-type = 'платеж':U
     2324              AND tt0-payment.source-ref = string(p-fin-doc-code)
     2325              AND tt0-payment.pmnt-code   = tt-payment.pmnt-code
     2326              no-error .
     2327       if not available tt0-payment then do:
     2328         create tt0-payment.
     2329         assign
     2330         tt0-payment.host-code = p-host-code
     2331         tt0-payment.source-type = 'платеж':U
     2332         tt0-payment.source-ref = string(p-fin-doc-code)
     2333         tt0-payment.pmnt-code = tt-payment.pmnt-code
     2334         .
     2335       end.
     2336       buffer-copy tt-payment except host-code source-type source-ref pmnt-code
     2337       to tt0-payment
     2338       assign
     2339       tt-payment.tot-base =  (tt0-payment.tot-cli * p-exch-rate / p-exch-scale) /  (p-base-rate / p-base-scale)
     2340       tt-payment.tot-rubl =  (tt0-payment.tot-cli * p-exch-rate / p-exch-scale)
     2341       tt-payment.exch-date = p-doc-date
     2342       tt-payment.exch-code =  p-curr-code
     2343       tt-payment.exch-rate = p-exch-rate
     2344       tt-payment.exch-scale = p-exch-scale
     2345       tt-payment.base-rate = p-base-rate
     2346       tt-payment.base-scale = p-base-scale
     2347       tt-payment.due-date = p-pay-date
     2348       .
     2349     end.
     2350   end.
     2351   for each tt0-payment where
     2352           tt0-payment.host-code = p-host-code
     2353     AND tt0-payment.source-type = 'платеж':U
     2354     AND tt0-payment.source-ref = string(p-fin-doc-code):
     2355   end.
     2356   END PROCEDURE.
