      412   define new global shared variable g#lib-farh as handle no-undo .
      413   DEFINE BUTTON B-add
      414        LABEL "&Добавить"
      415        SIZE 10 BY 1.
      416   DEFINE BUTTON b-dc
      417        LABEL "&Карта"
      418        SIZE 10 BY 1.
      419   DEFINE BUTTON B-del
