       37   define variable vss-description as character no-undo init "Налоги для финансового документа".
       38   procedure vss-get-info :
       39     define output parameter p-vss-revision    like vss-revision    no-undo .
       40     define output parameter p-vss-author      like vss-author      no-undo .
       41     define output parameter p-vss-date        like vss-date        no-undo .
       42     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       43     define output parameter p-vss-archive     like vss-archive     no-undo .
       44     define output parameter p-vss-description like vss-description no-undo .
       45     assign
       46       p-vss-revision    = vss-revision
       47       p-vss-author      = vss-author
       48       p-vss-date        = vss-date
       49       p-vss-workfile    = vss-workfile
       50       p-vss-archive     = vss-archive
       51       p-vss-description = vss-description
       52     .
       53   end procedure.
       54   procedure vss-get-parameters :
       55     define output parameter p-vss-parameters as character no-undo .
       56   end procedure.
       57   define new global shared variable g#vssrevis-logger as handle    no-undo .
       58   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       59   define variable v-vssrevis-logger                   as handle    no-undo .
       60   procedure vss-logevent :
       61     define input  parameter p-extra-paramters as character no-undo .
       62     define variable v-vssrevis-parameters as character no-undo .
       63     do
       64     on error undo, return error return-value
       65     :
       66       if  valid-handle(v-vssrevis-logger)
       67       and v-vssrevis-logger :get-signature("logevent") <> ""
       68       then do:
       69         run vss-get-parameters in this-procedure
       70           (output v-vssrevis-parameters
       71           ).
       72         run logevent in v-vssrevis-logger
       73           (input vss-workfile
       74           ,input vss-revision
       75           ,input v-vssrevis-parameters
       76           ,input p-extra-paramters
       77           ).
       78       end.
       79     end.
       80   end procedure.
       81   assign
       82     v-vssrevis-logger = g#vssrevis-logger
       83   .
       84   if  valid-handle(v-vssrevis-logger)
       85   and v-vssrevis-logger :get-signature("logevent") <> ""
       86   then do:
       87     assign
       88       v-vssrevis-logevent = true
       89     .
       90     run vss-logevent in this-procedure (input vss-description) .
       91   end.
       92   define variable v-db-num like ub.db.db-num no-undo.
       93   define variable v-base-code like ub.sysconf.host-code no-undo.
       94   define variable v-add-chg as character no-undo.
       95   define variable v-rest-sum-doc like ub.payment.tot-cli no-undo.
       96   define variable v-change-tab-order as character no-undo .
       97   define variable v-updated-line-num as integer no-undo .
       98   define variable last-line as integer no-undo.
       99   DEFINE VARIABLE v-pmnt-code AS CHARACTER NO-UNDO.
      100   define buffer X_curr_sysconf for ub.sysconf.
      101   define buffer X_currency for ub.currency.
      102   define new global shared variable g#language as character no-undo .
      103   if g#language <> '' and g#language <> 'rus':U then do:
      104     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      105   end.
      106   define new global shared variable g#library  as handle no-undo .
      107   define new global shared variable g#library2 as handle no-undo .
      108   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      109   define variable v-waitfram-action01         as character   no-undo .
      110   define variable v-waitfram-action02         as character   no-undo .
      111   define variable v-waitfram-action03         as character   no-undo .
      112   define variable mWaitFramTextBeg            as character   no-undo.
      113   define variable mWaitFramTextEnd            as character   no-undo.
      114   define variable mWaitFramView               as logical     no-undo.
      115   define variable mWaitProcEvent              as logical     no-undo init yes.
      116   define variable mWaitFramInterval           as integer     no-undo init 1 .
      117   define variable mWaitFramStop               as logical     no-undo.
      118   define variable mWaitFramStopUser           as logical     no-undo.
      119   define variable mWaitFramStopTimeOut        as logical     no-undo.
      120   define variable mWaitFramStartProc          as datetime-tz no-undo.
      121   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      122   define button B-WaitFramStop auto-end-key
      123        label "Стоп"
      124        size 10 by 1 tooltip "Остоновить процесс".
      125   define button B-viewProcInfo
      126        label "Информация"
      127        size 15 by 1 tooltip "Информация о процесс".
      128   define frame waitfram
      129     v-waitfram-action01 format "x(72)" no-label skip
      130     v-waitfram-action02 format "x(72)" no-label skip
      131     v-waitfram-action03 format "x(72)" no-label skip
      132     B-viewProcInfo
      133     B-WaitFramStop at row 4 col 30
      134     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      135     .
      136   define new global shared variable mBatchMode as logical no-undo init ?.
      137   define variable mFramBachModHandle as handle no-undo.
      138   mFramBachModHandle = frame waitfram:handle.
      139   define variable mFameOldVis as logical no-undo.
      140   define variable mVisCUrentVin as logical no-undo.
      141   if session:batch-mode
      142   then
      143      mBatchMode = yes.
      144   if mBatchMode = ? then do:
      145     mVisCUrentVin = current-window:visible.
      146     mFameOldVis = mFramBachModHandle:visible.
      147     mFramBachModHandle:visible  = yes.
      148     mBatchMode = mFramBachModHandle:visible ne yes.
      149     mFramBachModHandle:visible = mFameOldVis.
      150     current-window:visible = mVisCUrentVin.
      151   end.
      152    if  log-manager:logfile-name ne ?
      153     then DO:
      154         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      155         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      156         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      157     end.
      158   on choose of B-WaitFramStop in frame waitfram
      159   do:
      160     mWaitFramStop = yes.
      161     mWaitFramStopUser = yes.
      162   end.
      163   function waitfram-check-timeout returns logical():
      164      define variable vtime as int64 no-undo.
      165      if mWaitFramStopTimeOut
      166      then
      167         return yes.
      168      vtime = ( now - mWaitFramStartProc ) / 1000 .
      169      if     mWaitFramTimeOut ne ?
      170         and mWaitFramTimeOut ne 0
      171         and mWaitFramTimeOut lt vtime
      172      then do:
      173         mWaitFramStopTimeOut = yes.
      174      end.
      175      return mWaitFramStopTimeOut.
      176   end.
      177   procedure waitfram-hide :
      178     if not session:batch-mode
      179     then do
      180     on error undo, return error return-value
      181     :
      182       pause 0 before-hide .
      183       if not mBatchMode then
      184         hide frame waitfram .
      185     if     not mWaitFramView
      186        and mWaitProcEvent
      187     then
      188       process events .
      189     end.
      190   end procedure.
      191   procedure waitfram-show :
      192     define input  parameter p-message as character no-undo .
      193     define variable v-left-margin as integer   no-undo .
      194     if not session:batch-mode
      195     then do
      196     on error undo, return error return-value
      197     :
      198       if length(p-message) <= 70 then do:
      199         assign
      200           v-left-margin = integer((70 - length(p-message)) / 2)
      201         .
      202         assign
      203           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      204         .
      205         assign
      206           v-waitfram-action01 = " "
      207           v-waitfram-action02 = " "
      208                                    + fill(" ", v-left-margin)
      209                                    + p-message
      210           v-waitfram-action03 = " "
      211         .
      212       end.
      213       else do:
      214         define variable vRindex1 as integer no-undo.
      215         define variable vRindex2 as integer no-undo.
      216         vRindex1 = r-index(p-message," ",70).
      217         if vRindex1 = 0
      218         then
      219            vRindex1 = 70.
      220         if length(p-message)  <= vRindex1 + 70 then do:
      221           assign
      222             v-waitfram-action01 = " "
      223             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      224             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      225           .
      226         end.
      227         else do:
      228           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      229           if vRindex2 <= vRindex1
      230           then
      231              vRindex2 = vRindex1 + 70.
      232           assign
      233             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      234             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      235             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      236           .
      237         end.
      238       end.
      239       B-viewProcInfo:visible   in frame waitfram = no.
      240       B-viewProcInfo:sensitive in frame waitfram = no.
      241       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      242       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      243       if  (   mWaitFramView
      244          or  mWaitProcEvent)
      245          and not mBatchMode
      246       then
      247          display
      248             v-waitfram-action01 skip
      249             v-waitfram-action02 skip
      250             v-waitfram-action03 skip
      251          with frame waitfram .
      252       if     mWaitFramView
      253          then do:
      254             if     mWaitFramInterval ne ?
      255                and not mBatchMode
      256             then
      257                wait-for go of frame waitfram pause mWaitFramInterval.
      258          end.
      259          else
      260             if     mWaitProcEvent
      261                and not mBatchMode
      262             then
      263                process events .
      264     end.
      265   end procedure.
      266      procedure waitfram-show-this:
      267         define input  parameter iInterval as int64 no-undo.
      268         define variable vtime as int64 no-undo.
      269         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      270         mWaitFramInterval = iInterval.
      271         run waitfram-show (substitute("&1&2 &3&4" ,
      272                                       mWaitFramTextBeg ,
      273                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      274                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      275                                       mWaitFramTextEnd
      276                                      )
      277                           ).
      278      end.
      279      procedure WaitFramRunPause:
      280         define input  parameter iInterval as dec no-undo.
      281         define variable vStart  as datetime-tz no-undo.
      282         define variable vend    as datetime-tz no-undo.
      283         define variable vint as int64 no-undo.
      284         define variable vOk as logical no-undo.
      285         vStart = now.
      286         vend   = vStart.
      287         publish "WaitFramPause" (iInterval,output vOk).
      288         vend   =  now.
      289         vint = vend - vStart.
      290         vint = iInterval - vint / 1000.
      291         if     not mWaitFramStop
      292            and (   vint > 0
      293                 or (    not vOk
      294                     and iInterval eq ?
      295                     )
      296                 )
      297         then
      298            run waitfram-show-this (iInterval).
      299         vend   =  now.
      300         vint = vend - vStart.
      301         vint = iInterval - vint / 1000.
      302         if     not mWaitFramStop
      303            and vint > 0
      304         then do:
      305            run gbl/pause.p (vint * 1000).
      306         end.
      307         if iInterval ne ?
      308         then
      309            publish "WaitFramStop".
      310         waitfram-check-timeout().
      311      end.
      312      procedure WaitFramWaitFor:
      313         define input  parameter iInterval as dec no-undo.
      314         assign
      315            mWaitFramStartProc   = now
      316            mWaitFramStopUser    = no
      317            mWaitFramStopTimeOut = no
      318         .
      319         block-wait:
      320         do while not mWaitFramStop:
      321            run WaitFramRunPause (iInterval).
      322            if  waitfram-check-timeout()
      323            then do:
      324               leave block-wait.
      325            end.
      326         end.
      327         run waitfram-hide.
      328      end.
      329   procedure waitfram-join :
      330     define input  parameter p-line-1  as character no-undo .
      331     define input  parameter p-line-2  as character no-undo .
      332     define input  parameter p-line-3  as character no-undo .
      333     define output parameter p-message as character no-undo .
      334     do
      335     on error undo, return error return-value
      336     :
      337       assign
      338         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      339                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      340                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      341       .
      342     end.
      343   end procedure.
      344   function waitfram-join-function returns character
      345     (input p-line-1 as character
      346     ,input p-line-2 as character
      347     ,input p-line-3 as character
      348     ).
      349     define variable v-message as character no-undo .
      350     run waitfram-join in this-procedure
      351       (input  p-line-1
      352       ,input  p-line-2
      353       ,input  p-line-3
      354       ,output v-message
      355       ) .
      356     return v-message .
      357   end function .
      358   procedure proc-alt-shift-f2:
      359     if not ibs.th.gbl.gbl-var:rcode
      360   then
      361     run gbl\inidebug.p .
      362   end.
      363   procedure proc-alt-shift-f3:
      364     run gbl/prvssinf.p
      365       ( input this-procedure
      366       ) .
      367   end.
      368   define variable v-inform-launched as logical no-undo initial false .
      369   procedure proc-alt-shift-f4:
      370     define variable v-action as character no-undo .
      371     if v-inform-launched = false then do:
      372       assign
      373         v-inform-launched = true
      374       .
      375       run gbl/d-inform.w
      376         (  input self
      377         ,  input this-procedure
      378         , output v-action
      379         ) no-error .
      380       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      381       assign
      382         v-inform-launched = false
      383       .
      384     end.
      385   end.
      386   procedure proc-alt-f1:
      387     run gbl/corrhelp.p
      388       (input this-procedure
      389       ) .
      390   end .
