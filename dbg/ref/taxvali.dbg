        1   DEFINE BUFFER locked_tax-rate FOR ub.tax-rate.
        2   DEFINE TEMP-TABLE tt-tax-rate-value NO-UNDO LIKE ub.tax-rate-value.
        3   def input parameter ref-mode as char no-undo.
        4   define input parameter parhost-code like ub.sysconf.host-code no-undo.
        5   define input parameter parobj-type like ub.clients.obj-type no-undo.
        6   define input parameter parobj-code like ub.clients.obj-code no-undo.
        7   def input-output param rid as recid init ? no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision$":u .
        9   define variable vss-author      as character no-undo init "$Author$":u .
       10   define variable vss-date        as character no-undo init "$Date$":u .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       12   define variable vss-archive     as character no-undo init "$Archive$":u .
       13   define variable vss-description as character no-undo init "Карточка значения ставки налога" .
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   procedure proc-alt-shift-f2:
       75     if not ibs.th.gbl.gbl-var:rcode
       76   then
       77     run gbl\inidebug.p .
       78   end.
       79   procedure proc-alt-shift-f3:
       80     run gbl/prvssinf.p
       81       ( input this-procedure
       82       ) .
       83   end.
       84   define variable v-inform-launched as logical no-undo initial false .
       85   procedure proc-alt-shift-f4:
       86     define variable v-action as character no-undo .
       87     if v-inform-launched = false then do:
       88       assign
       89         v-inform-launched = true
       90       .
       91       run gbl/d-inform.w
       92         (  input self
       93         ,  input this-procedure
       94         , output v-action
       95         ) no-error .
       96       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       97       assign
       98         v-inform-launched = false
       99       .
      100     end.
      101   end.
      102   procedure proc-alt-f1:
      103     run gbl/corrhelp.p
      104       (input this-procedure
      105       ) .
      106   end .
      107   on alt-shift-f2 anywhere do:
      108     run proc-alt-shift-f2.
      109   end.
      110   on alt-shift-f3 anywhere do:
      111     run proc-alt-shift-f3 in this-procedure .
      112   end.
      113   on alt-shift-f4 anywhere do:
      114     run proc-alt-shift-f4 in this-procedure.
      115   end.
      116   on alt-f1 anywhere do:
      117     run proc-alt-f1 in this-procedure .
      118   end.
      119   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   procedure cur-time :
      121      define output parameter p-today as date      no-undo .
      122      define output parameter p-time  as integer   no-undo .
      123     do
      124     on error undo, return error
      125     :
      126       define variable v-date1 as date      no-undo .
      127       define variable v-date2 as date      no-undo .
      128       define variable v-time  as integer   no-undo .
      129       assign
      130         v-date1 = today
      131         v-time  = time
      132         v-date2 = today
      133       .
      134       if v-date1 <> v-date2
      135       then do:
      136         assign
      137           v-date1 = today
      138           v-time  = v-time
      139         .
      140       end.
      141       assign
      142         p-today = v-date1
      143         p-time  = v-time
      144       .
      145     end.
      146   end.
      147   function cur-time-date returns character
      148   :
      149     return string(today, '99/99/9999':U) .
      150   end.
      151   function cur-time-mjd returns decimal
      152   :
      153     define variable v-date as date      no-undo .
      154     define variable v-time as integer   no-undo .
      155     run cur-time in this-procedure
      156       (output v-date
      157       ,output v-time
      158       ) .
      159     return integer(v-date) - 2400002 + (v-time / 86400) .
      160   end.
      161   function cur-time-get-ending-index returns integer
      162   (input p-number as integer
      163   )
      164   :
      165     if p-number < 0
      166     or p-number = ?
      167     then do:
      168       return 1 .
      169     end.
      170     define variable v-rest as integer   no-undo .
      171     assign
      172       p-number = p-number modulo 100
      173     .
      174     if p-number < 20
      175     then do:
      176       assign
      177         v-rest = p-number
      178       .
      179     end.
      180     else do:
      181       assign
      182         v-rest = p-number modulo 10
      183       .
      184     end.
      185     case v-rest :
      186       when 1
      187       then do:
      188         return 2 .
      189       end.
      190       when 2 or
      191       when 3 or
      192       when 4
      193       then do:
      194         return 3 .
      195       end.
      196       otherwise do:
      197         return 1 .
      198       end.
      199     end case .
      200   end.
      201   procedure cur-time-mjd-to-date :
      202      define input  parameter i-mjd-diff as decimal no-undo.
      203      define output parameter o-Date     as date    no-undo.
      204      define output parameter o-Time     as integer no-undo.
      205      define variable v-day-number as integer   no-undo .
      206      if    i-mjd-diff < 0
      207         or i-mjd-diff = ?
      208      then do:
      209         return "?" .
      210      end.
      211      assign
      212         v-day-number = truncate(i-mjd-diff,0).
      213         o-Date = date(v-day-number + 2400002).
      214         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      215     .
      216   end.
      217   function cur-time-mjd-to-string returns character
      218   (input p-mjd-diff as decimal
      219   )
      220   :
      221     define variable v-day-number as integer   no-undo .
      222     define variable v-seconds    as integer   no-undo .
      223     define variable v-hour       as integer   no-undo .
      224     define variable v-min        as integer   no-undo .
      225     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      226     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      227     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      228     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      229     if p-mjd-diff < 0
      230     or p-mjd-diff = ?
      231     then do:
      232       return "?" .
      233     end.
      234     assign
      235       v-day-number = integer(truncate(p-mjd-diff,0))
      236       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      237     .
      238     if v-seconds > 86400
      239     then do:
      240       assign
      241         v-seconds = 86400 - 1
      242       .
      243     end.
      244     if v-seconds < 0
      245     then do:
      246       assign
      247         v-seconds = 0
      248       .
      249     end.
      250     assign
      251       v-hour = truncate(v-seconds / 3600, 0)
      252     .
      253     assign
      254       v-seconds = v-seconds modulo 3600
      255     .
      256     assign
      257       v-min = truncate(v-seconds / 60, 0)
      258     .
      259     assign
      260       v-seconds = v-seconds modulo 60
      261     .
      262     return
      263         (if v-day-number <> 0
      264           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      265           else ""
      266         )
      267       + (if v-day-number <> 0 or v-hour <> 0
      268           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      269           else ""
      270         )
      271       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      272           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      273           else ""
      274         )
      275       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      276       .
      277   end.
      278   function cur-time-string returns character
      279   :
      280     define variable v-date as date      no-undo .
      281     define variable v-time as integer   no-undo .
      282     run cur-time in this-procedure
      283       (output v-date
      284       ,output v-time
      285       ) .
      286     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      287   end.
      288   function cur-time-string-sec returns character
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      297   end.
      298   function cur-time-custom  returns character
      299   (input p-prefix as character
      300   ,input p-date-format as character
      301   ,input p-delimiter as character
      302   ,input p-time-format as character
      303   ,input p-suffix as character
      304   )
      305   :
      306     define variable v-date as date      no-undo .
      307     define variable v-time as integer   no-undo .
      308     run cur-time in this-procedure
      309       (output v-date
      310       ,output v-time
      311       ) .
      312     return
      313       p-prefix
      314       + string(v-date, p-date-format)
      315       + p-delimiter
      316       + string(v-time, p-time-format)
      317       + p-suffix
      318       .
      319   end.
      320   function cur-time-print  returns character
      321   :
      322     define variable v-date as date      no-undo .
      323     define variable v-time as integer   no-undo .
      324     run cur-time in this-procedure
      325       (output v-date
      326       ,output v-time
      327       ) .
      328     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      329   end.
      330   function cur-time-datetime returns datetime
      331   :
      332     define variable v-char as character no-undo .
      333     define variable v-datetime as datetime no-undo .
      334     v-char = cur-time-string().
      335     v-datetime = datetime(v-char).
      336     return  v-datetime.
      337   end.
      338   function cur-time-string-msec returns character
      339   :
      340     define variable v-date as datetime  no-undo .
      341     v-date = now.
      342     return string(v-date) .
      343   end.
      344   define variable taxcode like ub.tax.tax-code no-undo.
      345   define variable ratecode like ub.tax-rate.rate-code no-undo.
      346   define buffer b-objects for ub.clients.
      347   DEFINE BUTTON B-exit AUTO-GO
      348        LABEL "&Ввод "
      349        SIZE 10 BY 1
      350        BGCOLOR 8 .
      351   DEFINE BUTTON B-help
      352        LABEL "Помо&щь"
      353        SIZE 10 BY 1
      354        BGCOLOR 8 .
      355   DEFINE BUTTON B-quit AUTO-END-KEY
      356        LABEL "&Отмена"
      357        SIZE 10 BY 1
      358        BGCOLOR 8 .
      359   DEFINE VARIABLE for-obj-name AS CHARACTER FORMAT "X(256)":U
      360         VIEW-AS TEXT
      361        SIZE 37.88 BY 1 NO-UNDO.
      362   DEFINE VARIABLE host-name AS CHARACTER FORMAT "X(256)":U
      363         VIEW-AS TEXT
      364        SIZE 51.5 BY 1 NO-UNDO.
      365   DEFINE VARIABLE var-region AS CHARACTER FORMAT "X(256)":U
      366         VIEW-AS TEXT
      367        SIZE 24 BY 1 NO-UNDO.
      368   DEFINE RECTANGLE RECT-region
      369        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      370        SIZE 72 BY 6.46.
      371   DEFINE QUERY Dialog-Frame FOR
      372         tt-tax-rate-value SCROLLING.
      373   DEFINE FRAME Dialog-Frame
      374        B-exit AT ROW 1 COL 1
      375        B-quit AT ROW 1 COL 11
      376        B-help AT ROW 1 COL 41
      377        tt-tax-rate-value.rate-value AT ROW 3.04 COL 10.75 COLON-ALIGNED
      378             LABEL "Значение"
      379             VIEW-AS FILL-IN
      380             SIZE 14.25 BY 1
      381        tt-tax-rate-value.fact-date AT ROW 4.92 COL 22.88 COLON-ALIGNED
      382             LABEL "Дата начала действия"
      383             VIEW-AS FILL-IN
      384             SIZE 10.75 BY 1
      385        var-region AT ROW 7 COL 19.25 COLON-ALIGNED NO-LABEL
      386        host-name AT ROW 8.58 COL 18.88 COLON-ALIGNED NO-LABEL
      387        tt-tax-rate-value.host-code AT ROW 8.63 COL 1.75 COLON-ALIGNED NO-LABEL
      388              VIEW-AS TEXT
      389             SIZE 9 BY 1
      390        tt-tax-rate-value.obj-type AT ROW 11.04 COL 1.5 COLON-ALIGNED NO-LABEL
      391              VIEW-AS TEXT
      392             SIZE 6.13 BY 1
      393        tt-tax-rate-value.obj-code AT ROW 11.04 COL 8.63 COLON-ALIGNED NO-LABEL
      394              VIEW-AS TEXT
      395             SIZE 10.63 BY 1
      396        for-obj-name AT ROW 11.08 COL 20.63 COLON-ALIGNED NO-LABEL
      397        "Область действия:" VIEW-AS TEXT
      398             SIZE 16.63 BY 1 AT ROW 7 COL 3.25
      399             FGCOLOR 4
      400        RECT-region AT ROW 6.33 COL 2
      401        SPACE(1.99) SKIP(0.95)
      402       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      403            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      404            TITLE "Ввод значения ставки налога"
      405            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit.
      406   ASSIGN
      407          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      408          FRAME Dialog-Frame:HIDDEN           = TRUE.
      409   ON GO OF FRAME Dialog-Frame
      410   DO:
      411    find first tt-tax-rate-value No-ERROR.
      412    if not avail tt-tax-rate-value then create tt-tax-rate-value.
      413    assign
      414    tt-tax-rate-value.rate-value
      415    tt-tax-rate-value.host-code
      416    tt-tax-rate-value.obj-type
      417    tt-tax-rate-value.obj-code
      418    tt-tax-rate-value.fact-date
      419    .
      420    run ref/taxvali1.p ( input-output rid
      421                       , input ref-mode
      422                       , input no
      423                       , input taxcode
      424                       , input ratecode
      425                       , input tt-tax-rate-value.rate-value
      426                       , input tt-tax-rate-value.fact-date
      427                       , input tt-tax-rate-value.host-code
      428                       , input tt-tax-rate-value.obj-type
      429                       , input tt-tax-rate-value.obj-code
      430                       , input (if tt-tax-rate-value.status_ = "":U then 'тек':U else tt-tax-rate-value.status_ )
      431                       ) no-error.
      432     if error-status:error then do:
      433           if return-value = "":U then return no-apply.
      434       case return-value:
      435               when "rate-value":U then do:
      436                   APPLY "ENTRY" to tt-tax-rate-value.rate-value.
      437               end.
      438               when "fact-date":U then do:
      439                    APPLY "ENTRY" to tt-tax-rate-value.fact-date.
      440               end.
      441                when "host-code":U then do:
      442                    APPLY "ENTRY" to tt-tax-rate-value.host-code.
      443               end.
      444                when "obj-type":U then do:
      445                    APPLY "ENTRY" to tt-tax-rate-value.obj-type.
      446               end.
      447                when "obj-code":U then do:
      448                    APPLY "ENTRY" to tt-tax-rate-value.obj-code.
      449               end.
      450           end.
      451     end.
      452   END.
      453   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      454   DO:
      455     APPLY "END-ERROR":U TO SELF.
      456   END.
      457   ON CHOOSE OF B-quit IN FRAME Dialog-Frame
      458   DO:
      459     rid = ?.
      460   END.
      461   ON LEAVE OF tt-tax-rate-value.fact-date IN FRAME Dialog-Frame
      462   DO:
      463   DEFINE VARIABLE v-today as date no-undo .
      464   DEFINE VARIABLE v-time as integer no-undo .
      465   run cur-time in this-procedure(output v-today, output v-time).
      466     if date(tt-tax-rate-value.fact-date:screen-value) < v-today then do:
      467       Bell.
      468       return no-apply.
      469     end.
      470   END.
      471   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      472   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      473   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      474   on help of frame Dialog-Frame
      475   do:
      476     run gbl/app_help.p
      477       (input this-procedure :file-name
      478       ,input ''
      479       ,input ?
      480       ) no-error.
      481     if error-status :error then do:
      482       message
      483         "Ошибка при вызове помощи"
      484         error-status :get-message(1)
      485         view-as alert-box .
      486     end.
      487   end.
      488   run minbtn-set in this-procedure .
      489   on choose of b-help in frame Dialog-Frame
      490   do:
      491     apply "help":u to frame Dialog-Frame .
      492   end.
      493   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      494   procedure minbtn-set :
      495       do
      496           on error undo, return error return-value
      497           :
      498           define variable ii              as integer       no-undo .
      499           define variable fh              as widget-handle no-undo .
      500           define variable hh              as widget-handle no-undo .
      501           define variable v-h             as handle        extent 4 no-undo .
      502           define variable v-name-button   as character     no-undo .
      503           define variable v-help-old-x    as decimal       no-undo .
      504           define variable v-help-old-y    as decimal       no-undo .
      505           define variable v-help-old-size as decimal       no-undo .
      506           define variable v-frame-width   as decimal       no-undo .
      507           define variable jj              as integer       no-undo .
      508           do
      509               on error undo, return error
      510               :
      511               assign
      512                   v-frame-width = frame Dialog-Frame:width - 0.3
      513                   fh            = frame Dialog-Frame:first-child
      514                   hh            = fh:first-child
      515                   ii            = 1
      516                   .
      517               do while valid-handle(hh):
      518                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      519                   do:
      520                       case lc(hh:name) :
      521                           when "b-help" then
      522                               do:
      523                                   hh:load-image-up("cmp/b-help.bmp":u) .
      524                                   hh:load-image-down("cmp/b-help.bmp":u) .
      525                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      526                                   hh:TOOLTIP = "Помощь" .
      527                                   v-help-old-x = hh:column .
      528                                   v-help-old-y = hh:row    .
      529                                   v-help-old-size = hh:width .
      530                                   hh:width-chars = 2.5 .
      531                               end.
      532                           when "b-print" then
      533                               do:
      534                                   hh:load-image("cmp/b-print.bmp":u) .
      535                                   hh:TOOLTIP = "Печать" .
      536                                   v-h[ii] = hh:handle .
      537                                   ii = ii + 1 .
      538                                   hh:width-chars = 3 .
      539                               end.
      540                           when "b-history" or
      541                           when "b-hist" then
      542                               do:
      543                                   hh:load-image("cmp/b-hist.bmp":u) .
      544                                   hh:TOOLTIP = "История" .
      545                                   v-h[ii] = hh:handle .
      546                                   ii = ii + 1 .
      547                                   hh:width-chars = 3 .
      548                               end.
      549                           when "b-sch" then
      550                               do:
      551                                   hh:load-image("cmp/b-sch.bmp":u) .
      552                                   hh:TOOLTIP = "Установка Фильтра" .
      553                                   v-h[ii] = hh:handle .
      554                                   ii = ii + 1 .
      555                                   hh:width-chars = 3 .
      556                               end.
      557                           when "b-hist-user" then
      558                               do:
      559                                   hh:load-image("cmp/b-hist.bmp":u) .
      560                                   hh:TOOLTIP = "История пользователя" .
      561                                   ii = ii + 1 .
      562                               end.
      563                       end case.
      564                   end.
      565                   hh = hh:next-sibling.
      566               end.
      567               b-help:column = v-frame-width - b-help:width-chars.
      568               jj = 0.
      569               repeat ii = 4 to 1 by -1 :
      570                   if valid-handle (v-h[ii] ) then
      571                   do:
      572                       jj  = jj + 1 .
      573                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      574                       v-h[ii]:row    = v-help-old-y .
      575                   end.
      576               end.
      577           end.
      578       end.
      579   end procedure.
      580   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581   on ' ' of tt-tax-rate-value.fact-date in frame Dialog-Frame
      582   do:
      583     if (can-query (self, "sensitive")
      584        and
      585        self :sensitive = true
      586        )
      587     or (can-query (self, "read-only")
      588        and
      589        self :read-only = false
      590        )
      591     then do:
      592       assign
      593         self :screen-value = ?
      594       .
      595     end.
      596     return no-apply.
      597   end.
      598   on delete-character of tt-tax-rate-value.fact-date in frame Dialog-Frame
      599   do:
      600     if (can-query (self, "sensitive")
      601        and
      602        self :sensitive = true
      603        )
      604     or (can-query (self, "read-only")
      605        and
      606        self :read-only = false
      607        )
      608     then do:
      609       assign
      610         self :screen-value = ?
      611       .
      612     end.
      613     return no-apply.
      614   end.
      615   on ctrl-d of tt-tax-rate-value.fact-date in frame Dialog-Frame
      616   do:
      617     define variable v-curr-sv-date as date no-undo .
      618     if (can-query (self, "sensitive")
      619        and
      620        self :sensitive = true
      621        )
      622     or (can-query (self, "read-only")
      623        and
      624        self :read-only = false
      625        )
      626     then do:
      627       if self :handle <> focus :handle
      628       then do:
      629         apply "entry":u to self .
      630       end.
      631       run gbl/getcurdt.p
      632         (output v-curr-sv-date
      633         ) .
      634       assign
      635         self :screen-value = string(v-curr-sv-date) .
      636       .
      637     end.
      638     return no-apply.
      639   end.
      640   on ctrl-b of tt-tax-rate-value.fact-date in frame Dialog-Frame
      641   do:
      642     if (can-query (self, "sensitive")
      643        and
      644        self :sensitive = true
      645        )
      646     or (can-query (self, "read-only")
      647        and
      648        self :read-only = false
      649        )
      650     then do:
      651       if self :handle <> focus :handle
      652       then do:
      653         apply "entry":u to self .
      654       end.
      655       define variable v-curr-sv-date as date no-undo .
      656       define variable v-new-sv-date  as date no-undo .
      657       assign
      658         v-curr-sv-date = date(self :screen-value) no-error
      659       .
      660       if v-curr-sv-date = ?
      661       then do:
      662         run gbl/getcurdt.p
      663           (output v-curr-sv-date
      664           ) .
      665       end.
      666       if v-curr-sv-date <> ?
      667       then do:
      668         assign
      669           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      670         .
      671         assign
      672           self :screen-value = string(v-new-sv-date) .
      673         .
      674       end.
      675     end.
      676     return no-apply .
      677   end.
      678   on ctrl-e of tt-tax-rate-value.fact-date in frame Dialog-Frame
      679   do:
      680     if (can-query (self, "sensitive")
      681        and
      682        self :sensitive = true
      683        )
      684     or (can-query (self, "read-only")
      685        and
      686        self :read-only = false
      687        )
      688     then do:
      689       if self :handle <> focus :handle
      690       then do:
      691         apply "entry":u to self .
      692       end.
      693       define variable v-curr-sv-date as date no-undo .
      694       define variable v-new-sv-date  as date no-undo .
      695       assign
      696         v-curr-sv-date = date(self :screen-value) no-error
      697       .
      698       if v-curr-sv-date = ?
      699       then do:
      700         run gbl/getcurdt.p
      701           (output v-curr-sv-date
      702           ) .
      703       end.
      704       if v-curr-sv-date <> ?
      705       then do:
      706         run gbl/lastdate.p
      707           (input  v-curr-sv-date
      708           ,output v-new-sv-date
      709           ).
      710         assign
      711           self :screen-value = string(v-new-sv-date) .
      712         .
      713       end.
      714     end.
      715     return no-apply .
      716   end.
      717   on ctrl-f of tt-tax-rate-value.fact-date in frame Dialog-Frame
      718   do:
      719     if (can-query (self, "sensitive")
      720        and
      721        self :sensitive = true
      722        )
      723     or (can-query (self, "read-only")
      724        and
      725        self :read-only = false
      726        )
      727     then do:
      728       if self :handle <> focus :handle
      729       then do:
      730         apply "entry":u to self .
      731       end.
      732       define variable v-ok            as logical   no-undo .
      733       define variable v-curr-sv-date  as date      no-undo .
      734       define variable v-description   as character no-undo .
      735       assign
      736         v-curr-sv-date = date(self :screen-value) no-error
      737       .
      738       if v-curr-sv-date = ?
      739       then do:
      740         run gbl/getcurdt.p
      741           (output v-curr-sv-date
      742           ) .
      743       end.
      744       if v-curr-sv-date <> ?
      745       then do:
      746         run gbl/d-inpday.w
      747           (input ?
      748           ,input "Выбор даты"
      749           ,input v-description
      750           ,input ""
      751           ,input-output v-curr-sv-date
      752           ,output v-ok
      753           ).
      754         if v-ok = true
      755         then do:
      756           assign
      757             self :screen-value = string(v-curr-sv-date) .
      758           .
      759         end.
      760       end.
      761     end.
      762     return no-apply .
      763   end.
      764     define MENU m-ed-date4
      765       MENU-ITEM m-ed-date4-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      766       MENU-ITEM m-ed-date4-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      767       MENU-ITEM m-ed-date4-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      768       MENU-ITEM m-ed-date4-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      769       .
      770     if tt-tax-rate-value.fact-date :POPUP-MENU in frame Dialog-Frame = ?
      771     then do:
      772       ASSIGN
      773         tt-tax-rate-value.fact-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date4 :HANDLE
      774         tt-tax-rate-value.fact-date :MENU-MOUSE in frame Dialog-Frame = 3
      775       .
      776     end.
      777     define variable v-label-handle4 as handle no-undo .
      778     assign
      779       v-label-handle4 = tt-tax-rate-value.fact-date :side-label-handle in frame Dialog-Frame
      780     .
      781     if valid-handle (v-label-handle4)
      782     then do:
      783       if v-label-handle4 :tooltip = ""
      784       or v-label-handle4 :tooltip = ?
      785       then do:
      786         assign
      787           v-label-handle4 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      788         .
      789       end.
      790     end.
      791     ON CHOOSE OF MENU-ITEM m-ed-date4-1 in menu m-ed-date4 DO:
      792       apply "ctrl-b":U to tt-tax-rate-value.fact-date in frame Dialog-Frame .
      793     END.
      794     ON CHOOSE OF MENU-ITEM m-ed-date4-2 in menu m-ed-date4 DO:
      795       apply "ctrl-d":U to tt-tax-rate-value.fact-date in frame Dialog-Frame .
      796     END.
      797     ON CHOOSE OF MENU-ITEM m-ed-date4-3 in menu m-ed-date4 DO:
      798       apply "ctrl-e":U to tt-tax-rate-value.fact-date in frame Dialog-Frame .
      799     END.
      800     ON CHOOSE OF MENU-ITEM m-ed-date4-4 in menu m-ed-date4 DO:
      801       apply "ctrl-f":U to tt-tax-rate-value.fact-date in frame Dialog-Frame .
      802     END.
      803   MAIN-BLOCK:
      804   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      805      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      806       if ref-mode <> 'ДОБАВЛЕНИЕ':U then do:
      807           message vss-workfile vss-revision vss-description skip
      808                       "Неверный параметр вызова ref-mode"
      809           view-as alert-box ERROR.
      810           return error.
      811       end.
      812       if (parhost-code = 0 and
      813              (parobj-type <> "":U or parobj-code <> 0)) OR
      814              (parobj-type = "":U and parobj-code <> 0) or
      815              (parobj-type <> "" and  parobj-code = 0)
      816               then do:
      817               message vss-workfile vss-revision vss-description skip
      818                           "Неверный параметр вызова parhost-code и/или parobj-type и/или parobj-code"
      819               view-as alert-box ERROR.
      820               return error.
      821       end.
      822       for each tt-tax-rate-value:
      823         delete tt-tax-rate-value.
      824       end.
      825       FIND FIRST locked_tax-rate EXCLUSIVE-LOCK WHERE
      826             recid(locked_tax-rate) = rid No-WAIT No-ERROR.
      827       if locked locked_tax-rate then do:
      828         message vss-workfile vss-revision vss-description skip
      829                 "Запись ставки налога занята"
      830                 view-as alert-box error .
      831        return error .
      832       end.
      833       if not avail locked_tax-rate then do:
      834         message vss-workfile vss-revision vss-description skip
      835                 "Запись ставки не найдена"
      836                 view-as alert-box error .
      837         return error .
      838       end.
      839       assign
      840       taxcode =  locked_tax-rate.tax-code
      841       ratecode = locked_tax-rate.rate-code
      842       .
      843       var-region = "Глобально".
      844       if parhost-code <> 0 then do:
      845           find first ub.clients No-LOCK WHERE
      846                   ub.clients.obj-type = 'орг':U and
      847                   ub.clients.obj-code = parhost-code No-ERROR.
      848           var-region = "Фирма: ".
      849       end.
      850       if parobj-code <> 0 then do:
      851           find first b-objects No-LOCK WHERE
      852                   b-objects.obj-type = parobj-type and
      853                   b-objects.obj-code = parobj-code No-ERROR.
      854               var-region = "Объект: ".
      855       end.
      856     RUN Myenable in this-procedure .
      857     WAIT-FOR GO OF FRAME Dialog-Frame.
      858   END.
      859   RUN disable_UI.
      860   PROCEDURE disable_UI :
      861     HIDE FRAME Dialog-Frame.
      862   END PROCEDURE.
      863   PROCEDURE enable_UI :
      864     OPEN QUERY Dialog-Frame FOR EACH tt-tax-rate-value SHARE-LOCK.
      865     GET FIRST Dialog-Frame.
      866     DISPLAY var-region host-name for-obj-name
      867         WITH FRAME Dialog-Frame.
      868     IF AVAILABLE tt-tax-rate-value THEN
      869       DISPLAY tt-tax-rate-value.rate-value tt-tax-rate-value.fact-date
      870             tt-tax-rate-value.host-code tt-tax-rate-value.obj-type
      871             tt-tax-rate-value.obj-code
      872         WITH FRAME Dialog-Frame.
      873     ENABLE B-exit RECT-region B-quit B-help tt-tax-rate-value.rate-value
      874            tt-tax-rate-value.fact-date var-region host-name
      875            tt-tax-rate-value.host-code tt-tax-rate-value.obj-type
      876            tt-tax-rate-value.obj-code for-obj-name
      877         WITH FRAME Dialog-Frame.
      878     VIEW FRAME Dialog-Frame.
      879   END PROCEDURE.
      880   PROCEDURE MyEnable :
      881   DEFINE VARIABLE v-today as date no-undo .
      882   DEFINE VARIABLE v-time as integer no-undo .
      883   define variable v-lock-fact-date as logical no-undo .
      884   define buffer first_tax-rate-value for ub.tax-rate-value.
      885   find first first_tax-rate-value no-lock where
      886             first_tax-rate-value.tax-code = locked_tax-rate.tax-code
      887         AND first_tax-rate-value.rate-code = locked_tax-rate.rate-code no-error .
      888   if not available first_tax-rate-value then do:
      889     assign
      890     v-lock-fact-date = yes.
      891   end.
      892     ENABLE
      893     B-exit
      894     B-quit
      895     B-help
      896     tt-tax-rate-value.rate-value
      897     tt-tax-rate-value.fact-date when not v-lock-fact-date
      898     WITH FRAME Dialog-Frame.
      899     VIEW FRAME Dialog-Frame.
      900     FRAME Dialog-Frame:title = frame Dialog-Frame:title + " с кодом " +
      901                                   string(ratecode) + " по налогу " + string(taxcode).
      902     if v-lock-fact-date then do:
      903       assign
      904       v-today = 01/01/1990
      905       .
      906     end.
      907     else do:
      908       run cur-time in this-procedure(output v-today, output v-time).
      909     end.
      910     DISPLAY
      911     var-region
      912        0 @ tt-tax-rate-value.rate-value
      913     v-today @ tt-tax-rate-value.fact-date
      914     WITH FRAME Dialog-Frame.
      915     if parhost-code > 0 then
      916        DISPLAY
      917        parhost-code FORMAT "999999999" @ tt-tax-rate-value.host-code
      918        (if avail ub.clients then ub.clients.obj-name else "":U) @ host-name
      919       WITH FRAME Dialog-Frame.
      920       if parobj-code <> 0 then do:
      921         DISPLAY
      922         parobj-type @ tt-tax-rate-value.obj-type
      923         parobj-code @ tt-tax-rate-value.obj-code
      924         (if avail b-objects then b-objects.obj-name else "":U) @ for-obj-name
      925          WITH FRAME Dialog-Frame.
      926    end.
      927   END PROCEDURE.
