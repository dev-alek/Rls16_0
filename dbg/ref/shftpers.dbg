      871   DO:
      872   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      873   if lookup(self :type
      874            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      875            ) = 0
      876   then do:
      877     message
      878       "$Workfile$"
      879       "Указанному интерфейсному элементу фокус не может быть передан" skip
