      919   else do:
      920     apply "entry":u to self  .
      921     if focus :handle <> self :handle  then do:
      922       return no-apply .
      923     end.
      924   end.
      925       if avail next-shft-pers then do:
      926           if next-shft-pers.psn-code <> ? then do:
      927               MESSAGE "Нельзя изменить эту запись - она была выбрана из справочника"
      928               VIEW-AS ALERT-BOX ERROR.
      929               return no-apply.
      930           end.
      931         assign
      932         next-shft-pers.fio:read-only in browse br-staff-next = false
      933         next-shft-pers.cashier:read-only in browse br-staff-next = false
      934         .
      935         APPLY "ENTRY" to br-staff-next.
      936       end.
      937   END.
      938   ON CHOOSE OF B-del IN FRAME PERS-Frame
      939   DO:
      940   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      941   if lookup(self :type
      942            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      943            ) = 0
      944   then do:
