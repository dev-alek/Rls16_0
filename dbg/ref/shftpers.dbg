        1   define input parameter parparentproc as widget-handle no-undo .
        2   DEFINE INPUT PARAMETER pobj-type like  ub.shift-obj.obj-type no-undo.
        3   DEFINE INPUT PARAMETER pobj-code like  ub.shift-obj.obj-code no-undo.
        4   DEFINE INPUT PARAMETER pshift-date like ub.shift-obj.shift-date no-undo.
        5   DEFINE INPUT PARAMETER pshift-num like  ub.shift-obj.shift-num no-undo.
        6   DEFINE INPUT PARAMETER bttns as char no-UNDO.
        7   DEFINE INPUT PARAMETER call-point as char no-UNDO.
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Процедура выбора персонала смены".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define new global shared variable g#lib-trn  as handle no-undo .
       84   define new global shared variable g#lib-trn2 as handle no-undo .
       85   define new global shared variable g#lib-trn3 as handle no-undo .
       86   define new global shared variable g#lib-trn4 as handle no-undo .
       87   procedure proc-alt-shift-f2:
       88     if not ibs.th.gbl.gbl-var:rcode
       89   then
       90     run gbl\inidebug.p .
       91   end.
       92   procedure proc-alt-shift-f3:
       93     run gbl/prvssinf.p
       94       ( input this-procedure
       95       ) .
       96   end.
       97   define variable v-inform-launched as logical no-undo initial false .
       98   procedure proc-alt-shift-f4:
       99     define variable v-action as character no-undo .
      100     if v-inform-launched = false then do:
      101       assign
      102         v-inform-launched = true
      103       .
      104       run gbl/d-inform.w
      105         (  input self
      106         ,  input this-procedure
      107         , output v-action
      108         ) no-error .
      109       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      110       assign
      111         v-inform-launched = false
      112       .
      113     end.
      114   end.
      115   procedure proc-alt-f1:
      116     run gbl/corrhelp.p
      117       (input this-procedure
      118       ) .
      119   end .
      120   on alt-shift-f2 anywhere do:
      121     run proc-alt-shift-f2.
      122   end.
      123   on alt-shift-f3 anywhere do:
      124     run proc-alt-shift-f3 in this-procedure .
      125   end.
      126   on alt-shift-f4 anywhere do:
      127     run proc-alt-shift-f4 in this-procedure.
      128   end.
      129   on alt-f1 anywhere do:
      130     run proc-alt-f1 in this-procedure .
      131   end.
      132   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   define NEW SHARED temp-table shft-pers no-undo
      134   FIELD FIO as CHARACTER format "X(40)"
      135   FIELD staff-role AS LOGICAL format "+/ "
      136   FIELD psn-code like ub.person.psn-code
      137   FIELD cashier  as integer
      138   FIELD next-shift as logical
      139   field psn-num like ub.shift-staff.psn-num
      140   index staff-role is primary next-shift
      141                               staff-role DESCENDING
      142   index pc is unique next-shift psn-code psn-num
      143   .
      144   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      145     define variable v-cntxt-db-num        as integer   no-undo .
      146     define variable v-cntxt-userid        as character no-undo .
      147     define variable v-cntxt-level         as character no-undo .
      148     define variable v-cntxt-host-code-obj as integer   no-undo .
      149     define variable v-cntxt-obj-type      as character no-undo .
      150     define variable v-cntxt-obj-code      as integer   no-undo .
      151     define variable v-cntxt-db-num-obj    as integer   no-undo .
      152     define variable v-cntxt-is-admin      as logical   no-undo .
      153   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      154   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      155                                                       ,input p-range-type as character
      156                                                       ,input p-code as integer):
      157   define variable v-seq-val as integer no-undo .
      158   define buffer buf_code-range for ub.code-range.
      159   find first buf_code-range no-lock where
      160             buf_code-range.db-num = p-db-num
      161       and  buf_code-range.range-type = p-range-type
      162       and  buf_code-range.stts = 'u'
      163       and buf_code-range.first-code <= p-code
      164       and buf_code-range.last-code >= p-code no-error .
      165   if available buf_code-range then return yes.
      166   CASE p-range-type:
      167     when 'pngb':U then do:
      168       v-seq-val = current-value(s-pngb-code, ub).
      169     end.
      170     when 'fmgb':U then do:
      171       v-seq-val = current-value(s-fmgb-code, ub).
      172     end.
      173   END CASE.
      174   if p-code <= v-seq-val then do:
      175     find first buf_code-range no-lock where
      176               buf_code-range.db-num = p-db-num
      177         and  buf_code-range.range-type = p-range-type
      178         and  buf_code-range.stts = 'a'
      179         and buf_code-range.first-code <= p-code
      180         no-error .
      181    if available buf_code-range then return yes.
      182   end.
      183   find first buf_code-range no-lock where
      184             buf_code-range.db-num = p-db-num
      185       and  buf_code-range.range-type = p-range-type
      186       and  buf_code-range.stts = 'f'
      187       and buf_code-range.first-code <= p-code
      188       and buf_code-range.last-code >= p-code
      189       no-error .
      190   if available buf_code-range then return yes.
      191   return no.
      192   END FUNCTION.
      193   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      194                                                       ,input p-range-type as character
      195                                                       ,input p-code as integer):
      196   define variable v-seq-val as integer no-undo .
      197   define buffer buf_code-range for ub.code-range.
      198   CASE p-range-type:
      199     when 'pngb':U then do:
      200       v-seq-val = current-value(s-pngb-code, ub).
      201     end.
      202     when 'fmgb':U then do:
      203       v-seq-val = current-value(s-fmgb-code, ub).
      204     end.
      205   END CASE.
      206   if p-code <= v-seq-val then do:
      207     find first buf_code-range no-lock where
      208               buf_code-range.db-num = p-db-num
      209         and  buf_code-range.range-type = p-range-type
      210         and buf_code-range.first-code <= p-code
      211         and buf_code-range.last-code >= p-code no-error .
      212     if available buf_code-range then return yes.
      213   end.
      214   return no.
      215   END FUNCTION.
      216   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      217                                                       ,input p-db-num as integer
      218                                                       ,input p-staff-code as integer
      219                                                       ,input p-date as date
      220                                                        ):
      221   define buffer buf_staff for ub.staff.
      222   if p-date = ? then do:
      223     p-date = today .
      224   end.
      225   find first buf_staff no-lock where
      226             buf_staff.role = p-role
      227         and buf_staff.role-level = 'db':U
      228         and buf_staff.db-num = p-db-num
      229         and buf_staff.staff-code = p-staff-code
      230         and buf_staff.date-end >= p-date use-index pi  no-error .
      231   if available buf_staff then do:
      232     return buf_staff.psn-code.
      233   end.
      234   return 0.
      235   end FUNCTION.
      236   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      237                                                             ,input p-db-num as integer
      238                                                             ,input p-date as date
      239                                                                 ):
      240   define buffer buf_staff for ub.staff.
      241   define buffer buf2_staff for ub.staff.
      242   if p-date = ? then do:
      243     p-date = today .
      244   end.
      245   for each  buf_staff no-lock where
      246             buf_staff.role = p-role
      247         and buf_staff.db-num = p-db-num,
      248   first buf2_staff no-lock where
      249         buf2_staff.role = p-role
      250     and buf2_staff.role-level = 'db':U
      251     and buf2_staff.staff-code = buf_staff.staff-code
      252     and buf2_staff.date-start <= p-date
      253     and buf2_staff.date-end >= p-date
      254   by buf_staff.staff-code
      255   by date-start descending:
      256     return buf_staff.staff-code.
      257   end.
      258   end FUNCTION.
      259   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      260                                                  ,input p-db-num as integer
      261                                                  ,input p-psn-code as integer
      262                                                  ,input p-date as date
      263                                                  ,output p-c-password as character
      264                                                        ):
      265   define buffer buf_staff for ub.staff.
      266   if p-date = ? then do:
      267     p-date = today .
      268   end.
      269   find first buf_staff no-lock where
      270             buf_staff.role = p-role
      271         and buf_staff.role-level = 'db':U
      272         and buf_staff.db-num = p-db-num
      273        and buf_staff.date-end >= p-date
      274        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      275   if available buf_staff
      276   then do:
      277     assign
      278     p-c-password = buf_staff.password.
      279     return buf_staff.staff-code.
      280   end.
      281   p-c-password = ''.
      282   return 0.
      283   end FUNCTION.
      284   FUNCTION gbclcode-is-psn-role returns integer (
      285                                                 input p-role as character
      286                                                 ,input p-psn-code as integer
      287                                                 ,input p-date as date
      288                                                     ):
      289   define buffer buf_staff for ub.staff.
      290   if p-date = ? then do:
      291     p-date = today .
      292   end.
      293   for each buf_staff no-lock where
      294             buf_staff.psn-code = p-psn-code
      295        and  buf_staff.role = p-role
      296   by buf_staff.role-level
      297   by buf_staff.date-start
      298        :
      299     if  buf_staff.date-start <= p-date and
      300     buf_staff.date-end >= p-date  then do:
      301       return buf_staff.staff-code.
      302     end.
      303   end.
      304   return 0.
      305   end FUNCTION.
      306   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      307   define variable v-role-name as character no-undo .
      308   assign
      309   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      310   no-error .
      311   return v-role-name.
      312   END.
      313   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      314   FUNCTION gbclcode-get-position returns character ( input p-role as character
      315                                                     ,input p-role-level as character
      316                                                     ,input p-work-place as character
      317                                                     ,input p-staff-code as integer
      318                                                                ):
      319   define variable v-role-name as character no-undo .
      320   define variable v-role-level as character no-undo .
      321   define variable v-staff-code as integer no-undo .
      322   assign
      323   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      324   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      325   v-staff-code = p-staff-code
      326   no-error .
      327   return substitute("&1, &2, Код &3"
      328                   ,v-role-name
      329                   ,v-role-level
      330                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      331   END.
      332   FUNCTION gbclcode-get-work-place returns character (
      333                                                   input p-role as character
      334                                                  ,input p-role-level as character
      335                                                  ,input p-db-num as integer
      336                                                  ,input p-host-code as integer
      337                                                  ,input p-obj-type as character
      338                                                  ,input p-obj-code as integer
      339                                                  ) :
      340   define variable v-work-place as character no-undo .
      341   define variable v-obj-type as character no-undo .
      342     case p-role-level:
      343       when 'db':U then do:
      344         v-work-place = string(p-db-num, "99999").
      345       end.
      346       when 'firm':U then do:
      347         v-work-place = string(p-host-code, "99999").
      348       end.
      349       when 'object':U then do:
      350         assign
      351         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      352         .
      353       end.
      354     END CASE.
      355     return v-work-place.
      356   END FUNCTION.
      357   FUNCTION gbclcode-get-level-last-code returns integer (
      358                                                           input p-role as character
      359                                                         , input p-role-level as character
      360                                                         , input p-work-place as character
      361                                                         , input p-date-start as date
      362                                                         ):
      363   DEFINE VARIABLE v-today as date no-undo .
      364   define buffer buf_staff for ub.staff.
      365   if p-work-place = chr(63) then return ?.
      366   if p-date-start = ? then do:
      367     v-today = today .
      368   end.
      369   else do:
      370     v-today = p-date-start.
      371   end.
      372   find last buf_staff no-lock where
      373             buf_staff.role = p-role
      374        and  buf_staff.role-level = p-role-level
      375        and  buf_staff.work-place = p-work-place
      376        and  buf_staff.date-start <= v-today + 1
      377        and  buf_staff.date-end >= v-today + 1
      378        use-index pi  no-error .
      379   if available buf_staff
      380   then return buf_staff.staff-code.
      381   return 0.
      382   end FUNCTION.
      383   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384   procedure cur-time :
      385      define output parameter p-today as date      no-undo .
      386      define output parameter p-time  as integer   no-undo .
      387     do
      388     on error undo, return error
      389     :
      390       define variable v-date1 as date      no-undo .
      391       define variable v-date2 as date      no-undo .
      392       define variable v-time  as integer   no-undo .
      393       assign
      394         v-date1 = today
      395         v-time  = time
      396         v-date2 = today
      397       .
      398       if v-date1 <> v-date2
      399       then do:
      400         assign
      401           v-date1 = today
      402           v-time  = v-time
      403         .
      404       end.
      405       assign
      406         p-today = v-date1
      407         p-time  = v-time
      408       .
      409     end.
      410   end.
      411   function cur-time-date returns character
      412   :
      413     return string(today, '99/99/9999':U) .
      414   end.
      415   function cur-time-mjd returns decimal
      416   :
      417     define variable v-date as date      no-undo .
      418     define variable v-time as integer   no-undo .
      419     run cur-time in this-procedure
      420       (output v-date
      421       ,output v-time
      422       ) .
      423     return integer(v-date) - 2400002 + (v-time / 86400) .
      424   end.
      425   function cur-time-get-ending-index returns integer
      426   (input p-number as integer
      427   )
      428   :
      429     if p-number < 0
      430     or p-number = ?
      431     then do:
      432       return 1 .
      433     end.
      434     define variable v-rest as integer   no-undo .
      435     assign
      436       p-number = p-number modulo 100
      437     .
      438     if p-number < 20
      439     then do:
      440       assign
      441         v-rest = p-number
      442       .
      443     end.
      444     else do:
      445       assign
      446         v-rest = p-number modulo 10
      447       .
      448     end.
      449     case v-rest :
      450       when 1
      451       then do:
      452         return 2 .
      453       end.
      454       when 2 or
      455       when 3 or
      456       when 4
      457       then do:
      458         return 3 .
      459       end.
      460       otherwise do:
      461         return 1 .
      462       end.
      463     end case .
      464   end.
      465   procedure cur-time-mjd-to-date :
      466      define input  parameter i-mjd-diff as decimal no-undo.
      467      define output parameter o-Date     as date    no-undo.
      468      define output parameter o-Time     as integer no-undo.
      469      define variable v-day-number as integer   no-undo .
      470      if    i-mjd-diff < 0
      471         or i-mjd-diff = ?
      472      then do:
      473         return "?" .
      474      end.
      475      assign
      476         v-day-number = truncate(i-mjd-diff,0).
      477         o-Date = date(v-day-number + 2400002).
      478         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      479     .
      480   end.
      481   function cur-time-mjd-to-string returns character
      482   (input p-mjd-diff as decimal
      483   )
      484   :
      485     define variable v-day-number as integer   no-undo .
      486     define variable v-seconds    as integer   no-undo .
      487     define variable v-hour       as integer   no-undo .
      488     define variable v-min        as integer   no-undo .
      489     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      490     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      491     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      492     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      493     if p-mjd-diff < 0
      494     or p-mjd-diff = ?
      495     then do:
      496       return "?" .
      497     end.
      498     assign
      499       v-day-number = integer(truncate(p-mjd-diff,0))
      500       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      501     .
      502     if v-seconds > 86400
      503     then do:
      504       assign
      505         v-seconds = 86400 - 1
      506       .
      507     end.
      508     if v-seconds < 0
      509     then do:
      510       assign
      511         v-seconds = 0
      512       .
      513     end.
      514     assign
      515       v-hour = truncate(v-seconds / 3600, 0)
      516     .
      517     assign
      518       v-seconds = v-seconds modulo 3600
      519     .
      520     assign
      521       v-min = truncate(v-seconds / 60, 0)
      522     .
      523     assign
      524       v-seconds = v-seconds modulo 60
      525     .
      526     return
      527         (if v-day-number <> 0
      528           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      529           else ""
      530         )
      531       + (if v-day-number <> 0 or v-hour <> 0
      532           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      533           else ""
      534         )
      535       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      536           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      537           else ""
      538         )
      539       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      540       .
      541   end.
      542   function cur-time-string returns character
      543   :
      544     define variable v-date as date      no-undo .
      545     define variable v-time as integer   no-undo .
      546     run cur-time in this-procedure
      547       (output v-date
      548       ,output v-time
      549       ) .
      550     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      551   end.
      552   function cur-time-string-sec returns character
      553   :
      554     define variable v-date as date      no-undo .
      555     define variable v-time as integer   no-undo .
      556     run cur-time in this-procedure
      557       (output v-date
      558       ,output v-time
      559       ) .
      560     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      561   end.
      562   function cur-time-custom  returns character
      563   (input p-prefix as character
      564   ,input p-date-format as character
      565   ,input p-delimiter as character
      566   ,input p-time-format as character
      567   ,input p-suffix as character
      568   )
      569   :
      570     define variable v-date as date      no-undo .
      571     define variable v-time as integer   no-undo .
      572     run cur-time in this-procedure
      573       (output v-date
      574       ,output v-time
      575       ) .
      576     return
      577       p-prefix
      578       + string(v-date, p-date-format)
      579       + p-delimiter
      580       + string(v-time, p-time-format)
      581       + p-suffix
      582       .
      583   end.
      584   function cur-time-print  returns character
      585   :
      586     define variable v-date as date      no-undo .
      587     define variable v-time as integer   no-undo .
      588     run cur-time in this-procedure
      589       (output v-date
      590       ,output v-time
      591       ) .
      592     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      593   end.
      594   function cur-time-datetime returns datetime
      595   :
      596     define variable v-char as character no-undo .
      597     define variable v-datetime as datetime no-undo .
      598     v-char = cur-time-string().
      599     v-datetime = datetime(v-char).
      600     return  v-datetime.
      601   end.
      602   function cur-time-string-msec returns character
      603   :
      604     define variable v-date as datetime  no-undo .
      605     v-date = now.
      606     return string(v-date) .
      607   end.
      608   DEFINE BUFFER next-shft-pers for shft-pers.
      609   DEFINE variable add-option as char no-undo.
      610   define variable v-need-rec as recid no-undo .
      611   define variable v-param-type as character no-undo .
      612   define variable v-value-character AS character no-undo .
      613   define variable v-value-date as date no-undo .
      614   define variable v-value-decimal as decimal no-undo .
      615   define variable v-value-integer as INTEGER no-undo .
      616   define variable v-noanshftstaff as logical no-undo .
      617   define variable v-tth as handle no-undo .
      618   define variable v-close as logical no-undo .
      619   define variable par-type as character no-undo .
      620   define variable par-is-cctv as character no-undo .
      621   define variable is-cctv as logical no-undo .
      622   define variable v-vid-action        as integer no-undo .
      623   define variable v-vid-ok            as logical  no-undo .
      624   define variable v-vid-mes           as character no-undo .
      625   define variable v-vid-param         as longchar no-undo .
      626   define variable v-shift-staff-list  as character no-undo .
      627   define variable v-shift-manager     as character no-undo .
      628   define variable conf-par as character no-undo .
      629   define variable v-1C     as logical   no-undo .
      630   DEFINE BUFFER next-shift-obj for shift-obj.
      631   DEFINE BUFFER previous-shift-obj for shift-obj.
      632   DEFINE BUFFER previous-shift-obj2 for shift-obj.
      633   DEFINE MENU MENU-B-add
      634          MENU-ITEM m-add-ref      LABEL "Из справочника"
      635          MENU-ITEM m-add-blank    LABEL "Произвольно"   .
      636   DEFINE MENU MENU-B-add-next
      637          MENU-ITEM m-add-next-ref LABEL "Из справочника"
      638          MENU-ITEM m-add-next-blank LABEL "Произвольно"   .
      639   DEFINE MENU MENU-BR-staff
      640          MENU-ITEM m-br-ref       LABEL "Из справочника"
      641          MENU-ITEM m-br-blank     LABEL "Произвольно"   .
      642   DEFINE MENU MENU-BR-staff-next
      643          MENU-ITEM m-br-next-ref  LABEL "Из справочника"
      644          MENU-ITEM m-br-next-blank LABEL "Произвольно"   .
      645   DEFINE BUTTON B-add
      646        LABEL "Добавить"
      647        SIZE 10 BY 1.
      648   DEFINE BUTTON B-add-next
      649        LABEL "Добавить"
      650        SIZE 10 BY 1.
      651   DEFINE BUTTON B-chg
      652        LABEL "Изменить"
      653        SIZE 10 BY 1.
      654   DEFINE BUTTON B-chg-next
      655        LABEL "Изменить"
      656        SIZE 10 BY 1.
      657   DEFINE BUTTON B-del
      658        LABEL "Удалить"
      659        SIZE 10 BY 1.
      660   DEFINE BUTTON B-del-next
      661        LABEL "Удалить"
      662        SIZE 10 BY 1.
      663   DEFINE BUTTON B-exit AUTO-GO
      664        LABEL "&Ввод"
      665        SIZE 10 BY 1
      666        BGCOLOR 8 .
      667   DEFINE BUTTON B-Help
      668        LABEL "Помо&щь"
      669        SIZE 3 BY 1
      670        BGCOLOR 8 .
      671   DEFINE BUTTON B-mng
      672        LABEL "Менеджер"
      673        SIZE 10 BY 1.
      674   DEFINE BUTTON B-mng-next
      675        LABEL "Менеджер"
      676        SIZE 10 BY 1.
      677   DEFINE BUTTON b-quit AUTO-END-KEY
      678        LABEL "&Отмена"
      679        SIZE 10 BY 1
      680        BGCOLOR 8 .
      681   DEFINE RECTANGLE RECT-1
      682        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      683        SIZE 86.4 BY 9.87.
      684   DEFINE RECTANGLE RECT-2
      685        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      686        SIZE 86.1 BY 6.53.
      687   DEFINE QUERY BR-staff FOR
      688         shft-pers SCROLLING.
      689   DEFINE QUERY BR-staff-next FOR
      690         next-shft-pers SCROLLING.
      691   DEFINE BROWSE BR-staff
      692     QUERY BR-staff SHARE-LOCK NO-WAIT DISPLAY
      693         shft-pers.FIO column-label " ФИО"
      694         shft-pers.cashier column-label "Код!кассира"
      695         shft-pers.staff-role column-label "Менеджер"
      696         shft-pers.psn-code COLUMN-LABEL "Код!физ.лица"
      697         ENABLE
      698         shft-pers.FIO
      699         shft-pers.cashier
      700       WITH SEPARATORS SIZE 83.8 BY 7.53
      701            TITLE "Персонал текущей смены".
      702   DEFINE BROWSE BR-staff-next
      703     QUERY BR-staff-next SHARE-LOCK NO-WAIT DISPLAY
      704         next-shft-pers.FIO column-label " ФИО"
      705         next-shft-pers.cashier column-label "Код!кассира"
      706         next-shft-pers.staff-role column-label "Менеджер"
      707         next-shft-pers.psn-code COLUMN-LABEL "Код!физ.лица"
      708         ENABLE
      709         NEXt-shft-pers.FIO
      710         next-shft-pers.cashier
      711       WITH SEPARATORS SIZE 84.1 BY 4.17
      712            TITLE "Персонал принимающей смены".
      713   DEFINE FRAME PERS-Frame
      714        B-exit AT ROW 1 COL 1.1
      715        b-quit AT ROW 1 COL 11.1
      716        B-Help AT ROW 1 COL 80
      717        B-add AT ROW 3 COL 3.9
      718        B-del AT ROW 3 COL 13.9
      719        B-chg AT ROW 3 COL 23.9
      720        B-mng AT ROW 3 COL 33.9
      721        BR-staff AT ROW 4.3 COL 3.6
      722        B-add-next AT ROW 13.03 COL 3.9
      723        B-del-next AT ROW 13.03 COL 13.9
      724        B-chg-next AT ROW 13.03 COL 23.9
      725        B-mng-next AT ROW 13.03 COL 33.9
      726        BR-staff-next AT ROW 14.43 COL 3.3
      727        RECT-1 AT ROW 2.37 COL 2.4
      728        RECT-2 AT ROW 12.7 COL 2.3
      729        SPACE(1.72) SKIP(0.39)
      730       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      731            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      732            TITLE "Персонал  смены"
      733            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      734   ASSIGN
      735          FRAME PERS-Frame:SCROLLABLE       = FALSE
      736          FRAME PERS-Frame:HIDDEN           = TRUE.
      737   ASSIGN
      738          B-add:POPUP-MENU IN FRAME PERS-Frame       = MENU MENU-B-add:HANDLE.
      739   ASSIGN
      740          B-add-next:POPUP-MENU IN FRAME PERS-Frame       = MENU MENU-B-add-next:HANDLE.
      741   ASSIGN
      742          B-mng-next:HIDDEN IN FRAME PERS-Frame           = TRUE.
      743   ASSIGN
      744          BR-staff:POPUP-MENU IN FRAME PERS-Frame             = MENU MENU-BR-staff:HANDLE.
      745   ASSIGN
      746          BR-staff-next:POPUP-MENU IN FRAME PERS-Frame             = MENU MENU-BR-staff-next:HANDLE.
      747   ON END-ERROR OF FRAME PERS-Frame
      748   DO:
      749     apply "choose" to b-exit in frame PERS-Frame.
      750     return no-apply.
      751   END.
      752   ON GO OF FRAME PERS-Frame
      753   DO:
      754       IF FOCUS:NAME <> "B-exit" and FOCUS:NAME <> "B-QUIT" THEN DO:
      755       RETURN NO-APPLY.
      756       END.
      757       run fill-db in this-procedure no-error.
      758       if error-status:error then return no-apply.
      759       for each ub.shift-staff no-lock where ub.shift-staff.obj-type = pobj-type
      760                                         and ub.shift-staff.obj-code = pobj-code
      761                                         and ub.shift-staff.shift-num = pshift-num
      762                                         and ub.shift-staff.shift-date = pshift-date
      763                                         and ub.shift-staff.next-shift = no :
      764           if ub.shift-staff.staff-role
      765           then
      766           assign
      767               v-shift-manager = ub.shift-staff.name
      768           .
      769           else
      770           assign
      771               v-shift-staff-list = v-shift-staff-list + (if v-shift-staff-list = "" then "" else ", ") + ub.shift-staff.name
      772           .
      773           run trg/userlog.p (
      774                 input 'update':U
      775               , input 'shift-staff':U
      776               , input ( buffer ub.shift-staff :handle )
      777               , input ?
      778               , input ""
      779           ) no-error.
      780           if error-status :error
      781           then do:
      782               undo, return no-apply .
      783           end.
      784       end.
      785       find first ub.shift-obj no-lock where ub.shift-obj.obj-type = pobj-type
      786                                         and ub.shift-obj.obj-code = pobj-code
      787                                         and ub.shift-obj.shift-num = pshift-num
      788                                         and ub.shift-obj.shift-date = pshift-date .
      789       v-vid-action = 52 .
      790       v-vid-param = "SHOP_NUM=" + string(ub.shift-obj.obj-code) + chr(4) +
      791                     "SHIFT_NUM=" + string(ub.shift-obj.shift-num) + string(ub.shift-obj.shift-date, "99999999") + chr(4) +
      792                     "ShiftManager=" + v-shift-manager + chr(4) +
      793                     "ShiftStaff=" + v-shift-staff-list + chr(4) +
      794                     "RESULT=0" + chr(4) +
      795                     "Description=".
      796       run trg/userlog.p (
      797             input 'update':U
      798           , input 'shift-obj':U
      799           , input ( buffer ub.shift-obj :handle )
      800           , input v-vid-action
      801           , input v-vid-param
      802       ) no-error.
      803       if error-status :error
      804       then do:
      805           undo, return no-apply .
      806       end.
      807   END.
      808   ON stop OF FRAME PERS-Frame
      809   DO:
      810       apply "choose" to b-exit in frame PERS-Frame.
      811     return no-apply.
      812   END.
      813   ON WINDOW-CLOSE OF FRAME PERS-Frame
      814   DO:
      815     APPLY "END-ERROR":U TO SELF.
      816   END.
      817   ON CHOOSE OF B-add IN FRAME PERS-Frame
      818   DO:
      819   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      820   if lookup(self :type
      821            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      822            ) = 0
      823   then do:
      824     message
      825       "$Workfile$"
      826       "Указанному интерфейсному элементу фокус не может быть передан" skip
      827       "Интерфейсный элемент" self :name  skip
      828       "Тип" self :type  skip
      829       "Процедура" this-procedure :file-name skip
      830       view-as alert-box .
      831   end.
      832   else do:
      833     apply "entry":u to self  .
      834     if focus :handle <> self :handle  then do:
      835       return no-apply .
      836     end.
      837   end.
      838     if add-option = "" then
      839     run gbl/pop-up.p ( input self:handle, input no) no-error.
      840     if error-status:error then return no-apply.
      841     run create-pers in this-procedure ( input 0) no-error.
      842     if error-status:error then return no-apply.
      843   END.
      844   ON CHOOSE OF B-add-next IN FRAME PERS-Frame
      845   DO:
      846   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      847   if lookup(self :type
      848            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      849            ) = 0
      850   then do:
