      986   ON CHOOSE OF B-exit IN FRAME PERS-Frame
      987   DO:
      988   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      989   if lookup(self :type
      990            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      991            ) = 0
      992   then do:
      993     message
