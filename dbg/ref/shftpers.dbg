     1001   else do:
     1002     apply "entry":u to self  .
     1003     if focus :handle <> self :handle  then do:
     1004       return no-apply .
     1005     end.
     1006   end.
     1007       if v-1C
     1008       then do :
     1009         find first shft-pers no-lock where shft-pers.next-shift = no
     1010                                        and shft-pers.psn-code <> -1
     1011                                        no-error .
     1012         if not available shft-pers
     1013         then do :
     1014           message "Включен обмен с 1С. Ввод персонала смены обязателен." view-as alert-box .
     1015           return no-apply .
     1016         end .
     1017       end .
     1018   END.
     1019   ON CHOOSE OF B-quit IN FRAME PERS-Frame
     1020   DO:
     1021   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1022   if lookup(self :type
     1023            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
