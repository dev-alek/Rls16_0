     1207   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME PERS-Frame:PARENT eq ?
     1208   THEN FRAME PERS-Frame:PARENT = ACTIVE-WINDOW.
     1209   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1210   on help of frame PERS-Frame
     1211   do:
     1212     run gbl/app_help.p
     1213       (input this-procedure :file-name
     1214       ,input ''
     1215       ,input ?
     1216       ) no-error.
     1217     if error-status :error then do:
     1218       message
     1219         "Ошибка при вызове помощи"
     1220         error-status :get-message(1)
     1221         view-as alert-box .
     1222     end.
     1223   end.
     1224   run minbtn-set in this-procedure .
     1225   on choose of b-help in frame PERS-Frame
     1226   do:
     1227     apply "help":u to frame PERS-Frame .
     1228   end.
     1229   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1230   procedure minbtn-set :
     1231       do
     1232           on error undo, return error return-value
     1233           :
     1234           define variable ii              as integer       no-undo .
     1235           define variable fh              as widget-handle no-undo .
     1236           define variable hh              as widget-handle no-undo .
     1237           define variable v-h             as handle        extent 4 no-undo .
     1238           define variable v-name-button   as character     no-undo .
     1239           define variable v-help-old-x    as decimal       no-undo .
     1240           define variable v-help-old-y    as decimal       no-undo .
     1241           define variable v-help-old-size as decimal       no-undo .
     1242           define variable v-frame-width   as decimal       no-undo .
     1243           define variable jj              as integer       no-undo .
     1244           do
     1245               on error undo, return error
     1246               :
     1247               assign
     1248                   v-frame-width = frame PERS-Frame:width - 0.3
     1249                   fh            = frame PERS-Frame:first-child
     1250                   hh            = fh:first-child
     1251                   ii            = 1
     1252                   .
     1253               do while valid-handle(hh):
     1254                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1255                   do:
     1256                       case lc(hh:name) :
     1257                           when "b-help" then
     1258                               do:
     1259                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1260                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1261                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1262                                   hh:TOOLTIP = "Помощь" .
     1263                                   v-help-old-x = hh:column .
     1264                                   v-help-old-y = hh:row    .
     1265                                   v-help-old-size = hh:width .
     1266                                   hh:width-chars = 2.5 .
     1267                               end.
     1268                           when "b-print" then
     1269                               do:
     1270                                   hh:load-image("cmp/b-print.bmp":u) .
     1271                                   hh:TOOLTIP = "Печать" .
     1272                                   v-h[ii] = hh:handle .
     1273                                   ii = ii + 1 .
     1274                                   hh:width-chars = 3 .
     1275                               end.
     1276                           when "b-history" or
     1277                           when "b-hist" then
     1278                               do:
     1279                                   hh:load-image("cmp/b-hist.bmp":u) .
     1280                                   hh:TOOLTIP = "История" .
     1281                                   v-h[ii] = hh:handle .
     1282                                   ii = ii + 1 .
     1283                                   hh:width-chars = 3 .
     1284                               end.
     1285                           when "b-sch" then
     1286                               do:
     1287                                   hh:load-image("cmp/b-sch.bmp":u) .
     1288                                   hh:TOOLTIP = "Установка Фильтра" .
     1289                                   v-h[ii] = hh:handle .
     1290                                   ii = ii + 1 .
     1291                                   hh:width-chars = 3 .
     1292                               end.
     1293                           when "b-hist-user" then
     1294                               do:
     1295                                   hh:load-image("cmp/b-hist.bmp":u) .
     1296                                   hh:TOOLTIP = "История пользователя" .
     1297                                   ii = ii + 1 .
     1298                               end.
     1299                       end case.
     1300                   end.
     1301                   hh = hh:next-sibling.
     1302               end.
     1303               b-help:column = v-frame-width - b-help:width-chars.
     1304               jj = 0.
     1305               repeat ii = 4 to 1 by -1 :
     1306                   if valid-handle (v-h[ii] ) then
     1307                   do:
     1308                       jj  = jj + 1 .
     1309                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1310                       v-h[ii]:row    = v-help-old-y .
     1311                   end.
     1312               end.
     1313           end.
     1314       end.
     1315   end procedure.
     1316   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1317   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1318   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1319   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1320   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1321   define variable v-diasize-current-frame-height as decimal   no-undo .
     1322   define variable v-diasize-change-size          as logical   no-undo .
     1323   define variable v-diasize-resize-button        as handle    no-undo .
     1324   define variable v-diasize-wndmax               as logical   no-undo .
     1325   define variable v-diasize-wndstore             as logical   no-undo .
     1326   define variable v-diasize-proc-name            as character no-undo .
     1327   define variable v-diasize-browse-handle        as handle    no-undo .
     1328   define variable v-diasize-browse-number        as integer   no-undo .
     1329   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1330   define temp-table temp-diasize-handle no-undo
     1331     field handle-value  as handle
     1332     field save-position as decimal
     1333     index xpk is primary unique handle-value
     1334     .
     1335   define temp-table temp-browse-handle no-undo
     1336     field browse-type   as character
     1337     field browse-number as integer
     1338     field browse-handle as handle
     1339     field original-size as decimal
     1340     index xpk is primary unique browse-type browse-number
     1341     index xie browse-type browse-handle
     1342   .
     1343   procedure diasize_change-height :
     1344     define input  parameter p-change-value  as decimal   no-undo .
     1345     define input  parameter p-move-resize   as logical   no-undo .
     1346     define variable v-field-group-handle    as handle    no-undo .
     1347     define variable v-object-handle         as handle    no-undo .
     1348     define variable v-frame-height          as decimal   no-undo .
     1349     define variable v-frame-virtual-height  as decimal   no-undo .
     1350     define variable v-browse-height         as decimal   no-undo .
     1351     define variable v-window-height         as decimal   no-undo .
     1352     define variable v-window-virtual-height as decimal   no-undo .
     1353     define variable v-change-sign           as integer   no-undo .
     1354     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1355     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1356     if p-change-value > 0
     1357     then do:
     1358       if frame PERS-Frame :height + p-change-value
     1359           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1360       then do:
     1361         assign
     1362           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1363                           - (frame PERS-Frame :height-chars)
     1364         .
     1365         if p-change-value <= 0
     1366         then do:
     1367           run diasize_position-resize-button in this-procedure .
     1368           return .
     1369         end.
     1370       end.
     1371     end.
     1372     if p-change-value < 0
     1373     then do:
     1374       if frame PERS-Frame :height + p-change-value < v-diasize-orig-frame-height
     1375       then do:
     1376         assign
     1377           p-change-value = v-diasize-orig-frame-height
     1378                          - (frame PERS-Frame :height-chars)
     1379         .
     1380         if p-change-value >= 0
     1381         then do:
     1382           run diasize_position-resize-button in this-procedure .
     1383           return .
     1384         end.
     1385       end.
     1386     end.
     1387     if p-change-value >= 0
     1388     then do:
     1389       assign
     1390         v-change-sign = 1
     1391       .
     1392     end.
     1393     else do:
     1394       assign
     1395         v-change-sign = -1
     1396       .
     1397     end.
     1398     assign
     1399       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1400     .
     1401     if p-change-value = 0
     1402     then do:
     1403       run diasize_position-resize-button in this-procedure .
     1404       return .
     1405     end.
     1406     move_block:
     1407     do
     1408     on error undo move_block, retry move_block
     1409     :
     1410       if retry
     1411       then do:
     1412         do
     1413         on error undo move_block, leave move_block
     1414         :
     1415           if p-change-value > 0
     1416           then do:
     1417             for each buf_temp-diasize-handle
     1418             on error undo, next
     1419             :
     1420               assign
     1421                 v-object-handle = buf_temp-diasize-handle.handle-value
     1422               .
     1423               if v-object-handle <> v-diasize-resize-button
     1424               then do:
     1425                 assign
     1426                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1427                 .
     1428               end.
     1429             end.
     1430             assign
     1431               v-diasize-browse-handle :height = v-browse-height
     1432             .
     1433             for each buf_temp-browse-handle
     1434               where buf_temp-browse-handle.browse-type = 'height':u
     1435             on error undo, next
     1436             :
     1437               assign
     1438                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1439               .
     1440             end.
     1441             assign
     1442               frame PERS-Frame :height = v-frame-height
     1443             .
     1444             if frame PERS-Frame :scrollable = true
     1445             then do:
     1446               assign
     1447                 frame PERS-Frame :virtual-height = v-frame-virtual-height
     1448               .
     1449             end.
     1450             run diasize_position-resize-button in this-procedure .
     1451           end.
     1452           else do:
     1453             if frame PERS-Frame :scrollable = true
     1454             then do:
     1455               assign
     1456                 frame PERS-Frame :virtual-height = v-frame-virtual-height
     1457               .
     1458             end.
     1459             assign
     1460               frame PERS-Frame :height = v-frame-height
     1461             .
     1462             assign
     1463               v-diasize-browse-handle :height = v-browse-height
     1464             .
     1465             for each buf_temp-browse-handle
     1466               where buf_temp-browse-handle.browse-type = 'height':u
     1467             on error undo, next
     1468             :
     1469               assign
     1470                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1471               .
     1472             end.
     1473             for each buf_temp-diasize-handle
     1474             on error undo, next
     1475             :
     1476               assign
     1477                 v-object-handle = buf_temp-diasize-handle.handle-value
     1478               .
     1479               if v-object-handle <> v-diasize-resize-button
     1480               then do:
     1481                 assign
     1482                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1483                 .
     1484               end.
     1485             end.
     1486             run diasize_position-resize-button in this-procedure .
     1487           end.
     1488           assign
     1489             v-diasize-change-size = false
     1490           .
     1491           leave move_block .
     1492         end.
     1493       end.
     1494       assign
     1495         v-diasize-need-full-display = true
     1496       .
     1497       if v-diasize-change-size = false
     1498       then do:
     1499         assign
     1500           v-diasize-change-size = true
     1501         .
     1502       end.
     1503       else do:
     1504         return .
     1505       end.
     1506       assign
     1507         v-frame-height = frame PERS-Frame :height
     1508         v-frame-virtual-height = frame PERS-Frame :virtual-height
     1509         v-browse-height = v-diasize-browse-handle :height
     1510       .
     1511       for each buf_temp-browse-handle
     1512         where buf_temp-browse-handle.browse-type = 'height':u
     1513       :
     1514         assign
     1515           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1516         .
     1517       end.
     1518       for each buf_temp-diasize-handle
     1519       :
     1520         delete buf_temp-diasize-handle .
     1521       end.
     1522       assign
     1523         v-field-group-handle = frame PERS-Frame :first-child
     1524       .
     1525       do while valid-handle(v-field-group-handle)
     1526       :
     1527         assign
     1528           v-object-handle = v-field-group-handle :first-child
     1529         .
     1530         do while valid-handle(v-object-handle)
     1531         :
     1532           if  v-object-handle <> v-diasize-browse-handle :handle
     1533           and can-query(v-object-handle, "row")
     1534           and can-query(v-object-handle, "height")
     1535           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1536           then do:
     1537             find first buf_temp-browse-handle
     1538               where buf_temp-browse-handle.browse-type   = 'height':u
     1539                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1540               no-error .
     1541             if available buf_temp-browse-handle
     1542             then do:
     1543             end.
     1544             else do:
     1545               create buf_temp-diasize-handle .
     1546               assign
     1547                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1548                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1549               .
     1550             end.
     1551           end.
     1552           assign
     1553             v-object-handle = v-object-handle :next-sibling
     1554           .
     1555         end.
     1556         assign
     1557           v-field-group-handle = v-field-group-handle :next-sibling
     1558         .
     1559       end.
     1560       do with frame PERS-Frame
     1561       :
     1562         hide v-diasize-resize-button .
     1563         assign
     1564           v-diasize-resize-button :row    = 1
     1565           v-diasize-resize-button :column = 1
     1566         .
     1567       end.
     1568       if p-change-value > 0
     1569       then do:
     1570         if frame PERS-Frame :scrollable = true
     1571         then do:
     1572           assign
     1573             frame PERS-Frame :virtual-height = frame PERS-Frame :virtual-height + p-change-value
     1574             no-error .
     1575           if error-status :error
     1576           or error-status :get-message(1) <> ""
     1577           then do:
     1578             undo move_block, retry move_block .
     1579           end.
     1580         end.
     1581         assign
     1582           frame PERS-Frame :height = frame PERS-Frame :height + p-change-value
     1583           no-error .
     1584         if error-status :error
     1585         or error-status :get-message(1) <> ""
     1586         then do:
     1587           undo move_block, retry move_block .
     1588         end.
     1589         assign
     1590           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1591           no-error .
     1592         if error-status :error
     1593         or error-status :get-message(1) <> ""
     1594         then do:
     1595           undo move_block, retry move_block .
     1596         end.
     1597         for each buf_temp-browse-handle
     1598           where buf_temp-browse-handle.browse-type = 'height':u
     1599         on error undo move_block, retry move_block
     1600         :
     1601           assign
     1602             buf_temp-browse-handle.browse-handle :height
     1603               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1604             no-error .
     1605           if error-status :error
     1606           or error-status :get-message(1) <> ""
     1607           then do:
     1608             undo move_block, retry move_block .
     1609           end.
     1610         end.
     1611         for each buf_temp-diasize-handle
     1612         on error undo move_block, retry move_block
     1613         :
     1614           assign
     1615             v-object-handle = buf_temp-diasize-handle.handle-value
     1616           .
     1617           if v-object-handle <> v-diasize-resize-button
     1618           then do:
     1619             assign
     1620               v-object-handle :row = v-object-handle :row + p-change-value
     1621               no-error .
     1622             if error-status :error
     1623             or error-status :get-message(1) <> ""
     1624             then do:
     1625               undo move_block, retry move_block .
     1626             end.
     1627           end.
     1628         end.
     1629       end.
     1630       else do:
     1631         for each buf_temp-diasize-handle
     1632         on error undo move_block, retry move_block
     1633         :
     1634           assign
     1635             v-object-handle = buf_temp-diasize-handle.handle-value
     1636           .
     1637           if v-object-handle <> v-diasize-resize-button
     1638           then do:
     1639             assign
     1640               v-object-handle :row = v-object-handle :row + p-change-value
     1641               no-error .
     1642             if error-status :error
     1643             or error-status :get-message(1) <> ""
     1644             then do:
     1645               undo move_block, retry move_block .
     1646             end.
     1647           end.
     1648         end.
     1649         assign
     1650           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1651           no-error .
     1652         if error-status :error
     1653         or error-status :get-message(1) <> ""
     1654         then do:
     1655           undo move_block, retry move_block .
     1656         end.
     1657         for each buf_temp-browse-handle
     1658           where buf_temp-browse-handle.browse-type = 'height':u
     1659         on error undo move_block, retry move_block
     1660         :
     1661           assign
     1662             buf_temp-browse-handle.browse-handle :height
     1663               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1664             no-error .
     1665           if error-status :error
     1666           or error-status :get-message(1) <> ""
     1667           then do:
     1668             undo move_block, retry move_block .
     1669           end.
     1670         end.
     1671         assign
     1672           frame PERS-Frame :height = frame PERS-Frame :height + p-change-value
     1673           no-error .
     1674         if error-status :error
     1675         or error-status :get-message(1) <> ""
     1676         then do:
     1677           undo move_block, retry move_block .
     1678         end.
     1679         if frame PERS-Frame :scrollable = true
     1680         then do:
     1681           assign
     1682             frame PERS-Frame :virtual-height = frame PERS-Frame :virtual-height + p-change-value
     1683             no-error .
     1684           if error-status :error
     1685           or error-status :get-message(1) <> ""
     1686           then do:
     1687             undo move_block, retry move_block .
     1688           end.
     1689         end.
     1690       end.
     1691       if p-move-resize = true
     1692       then do:
     1693         run diasize_position-resize-button in this-procedure .
     1694       end.
     1695       if v-diasize-wndstore = true
     1696       then do:
     1697         if connected("ub") = true
     1698         then do:
     1699           define variable v-cntxt-db-num        as integer   no-undo .
     1700           define variable v-cntxt-userid        as character no-undo .
     1701           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1702                                             , OUTPUT v-cntxt-userid
     1703                                             ) .
     1704           run gbl/wndsizew.p
     1705             (input  v-cntxt-db-num
     1706             ,input  v-cntxt-userid
     1707             ,input  v-diasize-proc-name
     1708             ,input  'height':u
     1709             ,input  string(frame PERS-Frame :height - v-diasize-orig-frame-height)
     1710             ) .
     1711         end.
     1712       end.
     1713     end.
     1714     assign
     1715       v-diasize-change-size = false
     1716     .
     1717   end procedure.
     1718   procedure diasize_set-height :
     1719     define input  parameter p-new-height  as decimal   no-undo .
     1720     define input  parameter p-move-resize as logical   no-undo .
     1721     do
     1722     on error undo, return error return-value
     1723     :
     1724       run diasize_change-height in this-procedure
     1725         (input  (p-new-height - frame PERS-Frame :height)
     1726         ,input  p-move-resize
     1727         ) .
     1728     end.
     1729   end procedure.
     1730   procedure diasize_change-width :
     1731     define input  parameter p-change-value as decimal   no-undo .
     1732     define input  parameter p-move-resize  as logical   no-undo .
     1733     define variable v-field-group-handle   as handle    no-undo .
     1734     define variable v-object-handle        as handle    no-undo .
     1735     define variable v-frame-width          as decimal   no-undo .
     1736     define variable v-frame-virtual-width  as decimal   no-undo .
     1737     define variable v-browse-width         as decimal   no-undo .
     1738     define variable v-window-width         as decimal   no-undo .
     1739     define variable v-window-virtual-width as decimal   no-undo .
     1740     define variable v-change-sign          as integer   no-undo .
     1741     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1742     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1743     if p-change-value > 0
     1744     then do:
     1745       if frame PERS-Frame :width + p-change-value >
     1746           session :width-chars
     1747       then do:
     1748         assign
     1749           p-change-value = session :width-chars - frame PERS-Frame :width
     1750         .
     1751         if p-change-value <= 0
     1752         then do:
     1753           run diasize_position-resize-button in this-procedure .
     1754           return .
     1755         end.
     1756       end.
     1757     end.
     1758     if p-change-value < 0
     1759     then do:
     1760       if frame PERS-Frame :width + p-change-value < v-diasize-orig-frame-width
     1761       then do:
     1762         assign
     1763           p-change-value = v-diasize-orig-frame-width
     1764                          - frame PERS-Frame :width
     1765         .
     1766         if p-change-value >= 0
     1767         then do:
     1768           run diasize_position-resize-button in this-procedure .
     1769           return .
     1770         end.
     1771       end.
     1772     end.
     1773     if p-change-value >= 0
     1774     then do:
     1775       assign
     1776         v-change-sign = 1
     1777       .
     1778     end.
     1779     else do:
     1780       assign
     1781         v-change-sign = -1
     1782       .
     1783     end.
     1784     assign
     1785       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1786     .
     1787     if p-change-value = 0
     1788     then do:
     1789       run diasize_position-resize-button in this-procedure .
     1790       return .
     1791     end.
     1792     move_block:
     1793     do
     1794     on error undo move_block, leave move_block
     1795     :
     1796       if retry
     1797       then do:
     1798         do
     1799         on error undo move_block, leave move_block
     1800         :
     1801           if p-change-value > 0
     1802           then do:
     1803             for each buf_temp-diasize-handle
     1804             on error undo, next
     1805             :
     1806               assign
     1807                 v-object-handle = buf_temp-diasize-handle.handle-value
     1808               .
     1809               if v-object-handle <> v-diasize-resize-button
     1810               then do:
     1811                 assign
     1812                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1813                 .
     1814               end.
     1815             end.
     1816             assign
     1817               v-diasize-browse-handle :width = v-browse-width
     1818             .
     1819             for each buf_temp-browse-handle
     1820               where buf_temp-browse-handle.browse-type = 'width':u
     1821             on error undo, next
     1822             :
     1823               assign
     1824                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1825               .
     1826             end.
     1827             assign
     1828               frame PERS-Frame :width = v-frame-width
     1829             .
     1830             if frame PERS-Frame :scrollable = true
     1831             then do:
     1832               assign
     1833                 frame PERS-Frame :virtual-width = v-frame-virtual-width
     1834               .
     1835             end.
     1836             run diasize_position-resize-button in this-procedure .
     1837           end.
     1838           else do:
     1839             if frame PERS-Frame :scrollable = true
     1840             then do:
     1841               assign
     1842                 frame PERS-Frame :virtual-width = v-frame-virtual-width
     1843               .
     1844             end.
     1845             assign
     1846               frame PERS-Frame :width = v-frame-width
     1847             .
     1848             for each buf_temp-browse-handle
     1849               where buf_temp-browse-handle.browse-type = 'width':u
     1850             on error undo, next
     1851             :
     1852               assign
     1853                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1854               .
     1855             end.
     1856             assign
     1857               v-diasize-browse-handle :width = v-browse-width
     1858             .
     1859             for each buf_temp-diasize-handle
     1860             on error undo, next
     1861             :
     1862               assign
     1863                 v-object-handle = buf_temp-diasize-handle.handle-value
     1864               .
     1865               if v-object-handle <> v-diasize-resize-button
     1866               then do:
     1867                 assign
     1868                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1869                 .
     1870               end.
     1871             end.
     1872             run diasize_position-resize-button in this-procedure .
     1873           end.
     1874           assign
     1875             v-diasize-change-size = false
     1876           .
     1877           leave move_block .
     1878         end.
     1879       end.
     1880       assign
     1881         v-diasize-need-full-display = true
     1882       .
     1883       if v-diasize-change-size = false
     1884       then do:
     1885         assign
     1886           v-diasize-change-size = true
     1887         .
     1888       end.
     1889       else do:
     1890         return .
     1891       end.
     1892       assign
     1893         v-frame-width = frame PERS-Frame :width
     1894         v-frame-virtual-width = frame PERS-Frame :virtual-width
     1895         v-browse-width = v-diasize-browse-handle :width
     1896       .
     1897       for each buf_temp-browse-handle
     1898         where buf_temp-browse-handle.browse-type = 'width':u
     1899       :
     1900         assign
     1901           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1902         .
     1903       end.
     1904       for each buf_temp-diasize-handle
     1905       :
     1906         delete buf_temp-diasize-handle .
     1907       end.
     1908       assign
     1909         v-field-group-handle = frame PERS-Frame :first-child
     1910       .
     1911       do while valid-handle(v-field-group-handle)
     1912       :
     1913         assign
     1914           v-object-handle = v-field-group-handle :first-child
     1915         .
     1916         do while valid-handle(v-object-handle)
     1917         :
     1918           if  v-object-handle <> v-diasize-browse-handle :handle
     1919           and v-object-handle <> v-diasize-resize-button
     1920           and can-query(v-object-handle, "row")
     1921           and can-query(v-object-handle, "height")
     1922           and ( v-object-handle :col + v-object-handle :width
     1923                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1924               )
     1925           then do:
     1926             find first buf_temp-browse-handle
     1927               where buf_temp-browse-handle.browse-type   = 'width':u
     1928                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1929               no-error .
     1930             if available buf_temp-browse-handle
     1931             then do:
     1932             end.
     1933             else do:
     1934               create buf_temp-diasize-handle .
     1935               assign
     1936                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1937                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1938               .
     1939             end.
     1940           end.
     1941           assign
     1942             v-object-handle = v-object-handle :next-sibling
     1943           .
     1944         end.
     1945         assign
     1946           v-field-group-handle = v-field-group-handle :next-sibling
     1947         .
     1948       end.
     1949       do with frame PERS-Frame
     1950       :
     1951         hide v-diasize-resize-button .
     1952         v-diasize-resize-button :row = 1.
     1953         v-diasize-resize-button :column = 1.
     1954       end.
     1955       if p-change-value > 0
     1956       then do:
     1957         if frame PERS-Frame :scrollable = true
     1958         then do:
     1959           assign
     1960             frame PERS-Frame :virtual-width = frame PERS-Frame :virtual-width + p-change-value
     1961             no-error .
     1962           if error-status :error
     1963           or error-status :get-message(1) <> ""
     1964           then do:
     1965             undo move_block, retry move_block.
     1966           end.
     1967         end.
     1968         assign
     1969           frame PERS-Frame :width = v-frame-width + p-change-value
     1970           no-error .
     1971         if error-status :error
     1972         or error-status :get-message(1) <> ""
     1973         then do:
     1974           undo move_block, retry move_block.
     1975         end.
     1976         assign
     1977           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1978         no-error .
     1979         if error-status :error
     1980         or error-status :get-message(1) <> ""
     1981         then do:
     1982           undo move_block, retry move_block.
     1983         end.
     1984         for each buf_temp-browse-handle
     1985           where buf_temp-browse-handle.browse-type = 'width':u
     1986         on error undo move_block, retry move_block
     1987         :
     1988           assign
     1989             buf_temp-browse-handle.browse-handle :width
     1990               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1991             no-error .
     1992           if error-status :error
     1993           or error-status :get-message(1) <> ""
     1994           then do:
     1995             undo move_block, retry move_block .
     1996           end.
     1997         end.
     1998         for each buf_temp-diasize-handle
     1999         on error undo move_block, retry move_block
     2000         :
     2001           assign
     2002             v-object-handle = buf_temp-diasize-handle.handle-value
     2003           .
     2004           if v-object-handle <> v-diasize-resize-button
     2005           then do:
     2006             assign
     2007               v-object-handle :col = v-object-handle :col + p-change-value
     2008               no-error .
     2009             if error-status :error
     2010             or error-status :get-message(1) <> ""
     2011             then do:
     2012               undo move_block, retry move_block .
     2013             end.
     2014           end.
     2015         end.
     2016       end.
     2017       else do:
     2018         for each buf_temp-diasize-handle
     2019         on error undo move_block, retry move_block
     2020         :
     2021           assign
     2022             v-object-handle = buf_temp-diasize-handle.handle-value
     2023           .
     2024           if v-object-handle <> v-diasize-resize-button
     2025           then do:
     2026             assign
     2027               v-object-handle :col = v-object-handle :col + p-change-value
     2028               no-error .
     2029             if error-status :error
     2030             or error-status :get-message(1) <> ""
     2031             then do:
     2032               undo move_block, retry move_block .
     2033             end.
     2034           end.
     2035         end.
     2036         for each buf_temp-browse-handle
     2037           where buf_temp-browse-handle.browse-type = 'width':u
     2038         on error undo move_block, retry move_block
     2039         :
     2040           assign
     2041             buf_temp-browse-handle.browse-handle :width
     2042               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2043             no-error .
     2044           if error-status :error
     2045           or error-status :get-message(1) <> ""
     2046           then do:
     2047             undo move_block, retry move_block .
     2048           end.
     2049         end.
     2050         assign
     2051           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2052           no-error .
     2053         if error-status :error
     2054         or error-status :get-message(1) <> ""
     2055         then do:
     2056           undo move_block, retry move_block.
     2057         end.
     2058         assign
     2059           frame PERS-Frame :width = frame PERS-Frame :width + p-change-value
     2060         no-error .
     2061         if error-status :error
     2062         or error-status :get-message(1) <> ""
     2063         then do:
     2064           undo move_block, retry move_block.
     2065         end.
     2066         if frame PERS-Frame :scrollable = true
     2067         then do:
     2068           assign
     2069             frame PERS-Frame :virtual-width = frame PERS-Frame :virtual-width + p-change-value
     2070           no-error .
     2071           if error-status :error
     2072           or error-status :get-message(1) <> ""
     2073           then do:
     2074             undo move_block, retry move_block.
     2075           end.
     2076         end.
     2077       end.
     2078       if p-move-resize
     2079       then do:
     2080         run diasize_position-resize-button in this-procedure .
     2081       end.
     2082       if v-diasize-wndstore = true
     2083       then do:
     2084         if connected("ub") = true
     2085         then do:
     2086           define variable v-cntxt-db-num        as integer   no-undo .
     2087           define variable v-cntxt-userid        as character no-undo .
     2088           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2089                                             , OUTPUT v-cntxt-userid
     2090                                             ) .
     2091           run gbl/wndsizew.p
     2092             (input  v-cntxt-db-num
     2093             ,input  v-cntxt-userid
     2094             ,input  v-diasize-proc-name
     2095             ,input  'width':u
     2096             ,input  string(frame PERS-Frame :width - v-diasize-orig-frame-width)
     2097             ) .
     2098         end.
     2099       end.
     2100     end.
     2101     assign
     2102       v-diasize-change-size = false
     2103     .
     2104   end procedure.
     2105   procedure diasize_set-width :
     2106     define input  parameter p-new-width  as decimal   no-undo .
     2107     define input  parameter p-move-resize as logical   no-undo .
     2108     do
     2109     on error undo, return error return-value
     2110     :
     2111       run diasize_change-width in this-procedure
     2112         (input  (p-new-width - frame PERS-Frame :width)
     2113         ,input  p-move-resize
     2114         ) .
     2115     end.
     2116   end procedure.
     2117   procedure diasize_position-resize-button :
     2118     do with frame PERS-Frame
     2119     :
     2120       hide v-diasize-resize-button .
     2121       assign
     2122         v-diasize-resize-button :row = frame PERS-Frame :height - v-diasize-resize-button :height
     2123                     - 1
     2124                     - (frame PERS-Frame :border-bottom-pixels / session :pixels-per-row)
     2125         v-diasize-resize-button :col = frame PERS-Frame :width - v-diasize-resize-button :width
     2126                     - 1
     2127                     - (frame PERS-Frame :border-right-pixels / session :pixels-per-column)
     2128       .
     2129       view v-diasize-resize-button .
     2130     end.
     2131   end procedure.
     2132   on alt-right anywhere
     2133   do:
     2134     run diasize_change-width in this-procedure
     2135       (input 1
     2136       ,input true
     2137       ) .
     2138     return no-apply .
     2139   end.
     2140   on alt-left anywhere
     2141   do:
     2142     run diasize_change-width in this-procedure
     2143       (input -1
     2144       ,input true
     2145       ) .
     2146     return no-apply .
     2147   end.
     2148   on alt-down anywhere
     2149   do:
     2150     run diasize_change-height in this-procedure
     2151       (input 1
     2152       ,input true
     2153       ) .
     2154     return no-apply .
     2155   end.
     2156   on alt-up anywhere
     2157   do:
     2158     run diasize_change-height in this-procedure
     2159       (input -1
     2160       ,input true
     2161       ) .
     2162     return no-apply .
     2163   end.
     2164   on alt-enter of frame PERS-Frame
     2165   do:
     2166     run diasize_maximize in this-procedure
     2167       (input  ?
     2168       ).
     2169     return no-apply .
     2170   end.
     2171   procedure diasize_end-move :
     2172     do
     2173     on error undo, return error return-value
     2174     :
     2175       define variable v-row-delta as decimal   no-undo .
     2176       define variable v-col-delta as decimal   no-undo .
     2177       define variable v-new-row as decimal   no-undo .
     2178       define variable v-new-col as decimal   no-undo .
     2179       assign
     2180         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2181         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2182       .
     2183       assign
     2184         v-row-delta = v-new-row - frame PERS-Frame :height
     2185         v-col-delta = v-new-col - frame PERS-Frame :width
     2186       .
     2187       run diasize_change-height in this-procedure
     2188         (input v-row-delta
     2189         ,input true
     2190         ) .
     2191       run diasize_change-width in this-procedure
     2192         (input v-col-delta
     2193         ,input true
     2194         ) .
     2195     end.
     2196   end procedure.
     2197   procedure diasize_maximize :
     2198     define input  parameter p-action as logical   no-undo .
     2199     do
     2200     on error undo, return error return-value
     2201     :
     2202       if p-action = ?
     2203       then do:
     2204         if v-diasize-need-maximize = true
     2205         then do:
     2206           assign
     2207             p-action = true
     2208           .
     2209         end.
     2210         else do:
     2211           assign
     2212             p-action = false
     2213           .
     2214         end.
     2215       end.
     2216       if p-action = true
     2217       then do:
     2218         run diasize_change-height in this-procedure
     2219           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2220               - frame PERS-Frame :height-chars
     2221           ,input true
     2222           ) .
     2223         run diasize_change-width in this-procedure
     2224           (input session :width-chars
     2225               - frame PERS-Frame :width-chars
     2226           ,input true
     2227           ) .
     2228         assign
     2229           v-diasize-need-maximize = false
     2230         .
     2231       end.
     2232       else do:
     2233         run diasize_change-width in this-procedure
     2234           (input v-diasize-orig-frame-width
     2235               - frame PERS-Frame :width-chars
     2236           ,input true
     2237           ) .
     2238         run diasize_change-height in this-procedure
     2239           (input v-diasize-orig-frame-height
     2240               - frame PERS-Frame :height-chars
     2241           ,input true
     2242           ) .
     2243         assign
     2244           v-diasize-need-maximize = true
     2245         .
     2246       end.
     2247     end.
     2248   end procedure.
     2249   procedure diasize_restore-orig-size :
     2250     do
     2251     on error undo, return error return-value
     2252     :
     2253       assign
     2254         v-diasize-current-frame-width  = frame PERS-Frame :width
     2255         v-diasize-current-frame-height = frame PERS-Frame :height
     2256       .
     2257       run diasize_set-height in this-procedure
     2258         (input  v-diasize-orig-frame-height
     2259         ,input  true
     2260         ) .
     2261       run diasize_set-width in this-procedure
     2262         (input  v-diasize-orig-frame-width
     2263         ,input  true
     2264         ) .
     2265     end.
     2266   end procedure.
     2267   procedure diasize_restore-current-size :
     2268     do
     2269     on error undo, return error return-value
     2270     :
     2271       run diasize_set-height in this-procedure
     2272         (input  v-diasize-current-frame-height
     2273         ,input  true
     2274         ) .
     2275       run diasize_set-width in this-procedure
     2276         (input  v-diasize-current-frame-width
     2277         ,input  true
     2278         ) .
     2279     end.
     2280   end procedure.
     2281   procedure diasize_set-browse-handle :
     2282     define input  parameter p-browse-handle as handle   no-undo .
     2283     define buffer buf_temp-browse-handle for temp-browse-handle .
     2284     do
     2285     on error undo, return error return-value
     2286     :
     2287       assign
     2288         v-diasize-browse-handle = p-browse-handle
     2289       .
     2290       for each buf_temp-browse-handle
     2291       on error undo, return error return-value
     2292       :
     2293         delete buf_temp-browse-handle .
     2294       end.
     2295     end.
     2296   end procedure.
     2297   procedure diasize_add_browse :
     2298     define input  parameter p-browse-type   as character no-undo .
     2299     define input  parameter p-browse-handle as handle    no-undo .
     2300     define buffer buf_temp-browse-handle for temp-browse-handle .
     2301     do
     2302     on error undo, return error return-value
     2303     :
     2304       assign
     2305         v-diasize-browse-number = v-diasize-browse-number + 1
     2306       .
     2307       create buf_temp-browse-handle .
     2308       assign
     2309         buf_temp-browse-handle.browse-type   = p-browse-type
     2310         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2311         buf_temp-browse-handle.browse-handle = p-browse-handle
     2312       .
     2313     end.
     2314   end procedure.
     2315   procedure diasize_init :
     2316     define variable v-default-value    as logical   no-undo .
     2317     define variable v-restore-saved    as logical   no-undo .
     2318     define variable v-resize-value-str as character no-undo .
     2319     do
     2320     on error undo, return error return-value
     2321     :
     2322       do with frame PERS-Frame
     2323       :
     2324         assign
     2325           v-diasize-orig-frame-height = frame PERS-Frame :height
     2326           v-diasize-orig-frame-width  = frame PERS-Frame :width
     2327           v-diasize-browse-handle     = browse BR-staff :handle
     2328         .
     2329         create button v-diasize-resize-button
     2330         assign
     2331           parent        = frame PERS-Frame :first-child
     2332           label         = "s"
     2333           height-pixels = 16
     2334           width-pixels  = 16
     2335           visible       = true
     2336           sensitive     = true
     2337           movable       = true
     2338           triggers:
     2339             on end-move persistent run diasize_end-move in this-procedure .
     2340           end triggers.
     2341         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2342         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2343         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2344         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2345         assign
     2346           v-diasize-wndmax = false
     2347         .
     2348         if connected("ub") = true
     2349         then do:
     2350           define variable v-cntxt-db-num        as integer   no-undo .
     2351           define variable v-cntxt-userid        as character no-undo .
     2352           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2353                                             , OUTPUT v-cntxt-userid
     2354                                             ) .
     2355           run gbl/wndpar_r.p
     2356             (input  v-cntxt-db-num
     2357             ,input  v-cntxt-userid
     2358             ,input  'wndmax':U
     2359             ,output v-diasize-wndmax
     2360             ,output v-default-value
     2361             ) .
     2362         end.
     2363         assign
     2364           v-diasize-wndstore = false
     2365         .
     2366         if connected("ub") = true
     2367         then do:
     2368           run gbl/wndpar_r.p
     2369             (input  v-cntxt-db-num
     2370             ,input  v-cntxt-userid
     2371             ,input  'wndstore':U
     2372             ,output v-diasize-wndstore
     2373             ,output v-default-value
     2374             ) .
     2375         end.
     2376         assign
     2377           v-diasize-proc-name = entry(1, program-name(2), '.')
     2378         .
     2379         if v-diasize-wndstore = true
     2380         then do:
     2381           assign
     2382             v-restore-saved = false
     2383           .
     2384           if connected("ub") = true
     2385           then do:
     2386             run gbl/wndsizer.p
     2387               (input  v-cntxt-db-num
     2388               ,input  v-cntxt-userid
     2389               ,input  v-diasize-proc-name
     2390               ,input  'height':u
     2391               ,output v-resize-value-str
     2392               ) .
     2393             if v-resize-value-str <> '':U
     2394             then do:
     2395               run diasize_change-height in this-procedure
     2396                 (input  integer(v-resize-value-str)
     2397                 ,input  true
     2398                 ) .
     2399               assign
     2400                 v-restore-saved = true
     2401               .
     2402             end.
     2403           end.
     2404           if connected("ub") = true
     2405           then do:
     2406             run gbl/wndsizer.p
     2407               (input  v-cntxt-db-num
     2408               ,input  v-cntxt-userid
     2409               ,input  v-diasize-proc-name
     2410               ,input  'width':u
     2411               ,output v-resize-value-str
     2412               ) .
     2413             if v-resize-value-str <> '':U
     2414             then do:
     2415               run diasize_change-width in this-procedure
     2416                 (input  integer(v-resize-value-str)
     2417                 ,input  true
     2418                 ) .
     2419               assign
     2420                 v-restore-saved = true
     2421               .
     2422             end.
     2423           end.
     2424           if v-restore-saved <> true
     2425           then do:
     2426             if v-diasize-wndmax = true
     2427             then do:
     2428               run diasize_maximize in this-procedure
     2429                 (input  true
     2430                 ) .
     2431             end.
     2432           end.
     2433         end.
     2434         else do:
     2435           if v-diasize-wndmax = true
     2436           then do:
     2437             run diasize_maximize in this-procedure
     2438               (input  true
     2439               ) .
     2440           end.
     2441         end.
     2442       end.
     2443     end.
     2444   end procedure.
     2445   procedure diasize_need-full-display :
     2446     define output parameter p-need-full-display as logical   no-undo .
     2447     do
     2448     on error undo, return error return-value
     2449     :
     2450       assign
     2451         p-need-full-display = v-diasize-need-full-display
     2452       .
     2453       assign
     2454         v-diasize-need-full-display = false
     2455       .
     2456     end.
     2457   end procedure.
     2458   procedure get-context :
     2459      define output parameter p-db-num as integer          no-undo.
     2460      define output parameter p-user-id as character        no-undo.
     2461      define variable v-login               as character    no-undo.
     2462      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2463      define buffer buf_user-login  for ub.user-login .
     2464      do
     2465      on error undo, return error
     2466      :
     2467            FIND FIRST buf_sys-ctrl no-lock.
     2468            ASSIGN
     2469               v-login = USERID("ub")
     2470               p-db-num = buf_sys-ctrl.db-num
     2471            .
     2472            FIND FIRST buf_user-login
     2473                 WHERE buf_user-login.db-num = p-db-num
     2474                   AND buf_user-login.user-login = v-login
     2475                 no-lock
     2476                 no-error
     2477                 .
     2478            IF AVAILABLE buf_user-login
     2479            THEN DO:
     2480               assign
     2481                  p-user-id = buf_user-login.user-id
     2482               .
     2483            END.
     2484      end.
     2485   end procedure.
     2486       run diasize_init in this-procedure .
     2487   on end-error of SHFT-PERS.FIO, SHFT-PERS.CASHIER In browse br-STAFF do:
     2488     disp SHFT-PERS.FIO SHFT-PERS.CASHIER with browse br-STAFF.
     2489     return no-apply.
     2490   end.
     2491   on end-error of NEXT-SHFT-PERS.FIO, NEXT-SHFT-PERS.CASHIER In browse br-STAFF-NEXT do:
     2492     disp NEXT-SHFT-PERS.FIO NEXT-SHFT-PERS.CASHIER with browse br-STAFF-NEXT.
     2493     return no-apply.
     2494   end.
     2495   On RETURN OF shft-pers.cashier in browse br-staff
     2496   OR RETURN OF shft-pers.FIO in browse br-staff
     2497   OR TAB OF shft-pers.cashier in browse br-staff
     2498   DO:
     2499     run upd-shft-pers in this-procedure no-error.
     2500     if error-status:error then return no-apply.
     2501     return no-apply.
     2502   end.
     2503   On RETURN OF next-shft-pers.cashier in browse br-staff-next
     2504   OR RETURN OF next-shft-pers.FIO in browse br-staff-next
     2505   OR TAB OF next-shft-pers.cashier in browse br-staff-next
     2506   DO:
     2507     run upd-NEXT-shft-pers in this-procedure no-error.
     2508     if error-status:error then return no-apply.
     2509    return no-apply.
     2510   end.
     2511   MAIN-BLOCK:
     2512   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2513      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2514   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2515     run mainmenu_getcntxt in parparentproc
     2516       (output v-cntxt-db-num
     2517       ,output v-cntxt-userid
     2518       ,output v-cntxt-level
     2519       ,output v-cntxt-host-code-obj
     2520       ,output v-cntxt-obj-type
     2521       ,output v-cntxt-obj-code
     2522       ,output v-cntxt-db-num-obj
     2523       ,output v-cntxt-is-admin
     2524       ) .
     2525     FIND FIRST ub.shift-obj SHARE-LOCK WHERE
     2526                ub.shift-obj.obj-type = pobj-type AND
     2527                ub.shift-obj.obj-code = pobj-code AND
     2528                ub.shift-obj.shift-num = pshift-num AND
     2529                ub.shift-obj.shift-date = pshift-date NO-ERROR.
     2530     IF NOT AVAIL shift-obj then do:
     2531       message
     2532       vss-workfile vss-revision vss-description skip
     2533       "Отсутствует запись о смене на объекте" skip
     2534       "объект" pobj-type pobj-code
     2535       "смена" pshift-date "порядок" pshift-num
     2536       view-as alert-box ERROR.
     2537       return error.
     2538     END.
     2539     IF call-point = 'смена-объект-откр':U then do:
     2540       if can-find(first ub.shift-staff no-lock where
     2541                         ub.shift-staff.obj-type = pobj-type AND
     2542                         ub.shift-staff.obj-code = pobj-code AND
     2543                         ub.shift-staff.shift-num = pshift-num AND
     2544                         ub.shift-staff.shift-date = pshift-date) then
     2545       call-point = "".
     2546       else do:
     2547         FIND LAST  previous-shift-obj SHARE-LOCK WHERE
     2548                   previous-shift-obj.obj-type = pobj-type
     2549               AND previous-shift-obj.obj-code = pobj-code
     2550               AND (previous-shift-obj.shift-date = pshift-date
     2551               AND previous-shift-obj.shift-num < pshift-num) use-index pi no-error.
     2552         FIND LAST  previous-shift-obj2 SHARE-LOCK WHERE
     2553                   previous-shift-obj2.obj-type = pobj-type
     2554               AND previous-shift-obj2.obj-code = pobj-code
     2555               AND previous-shift-obj2.shift-date < pshift-date use-index pi no-error.
     2556         v-need-rec = ?.
     2557         if available previous-shift-obj then do:
     2558           v-need-rec = recid(previous-shift-obj).
     2559         end.
     2560         else do:
     2561           if available previous-shift-obj2 then do:
     2562             v-need-rec = recid(previous-shift-obj2).
     2563           end.
     2564         end.
     2565         if v-need-rec <> ? then do:
     2566           find first previous-shift-obj where recid(previous-shift-obj) = v-need-rec.
     2567         end.
     2568       end.
     2569     end.
     2570     FIND first next-shift-obj NO-LOCK WHERE
     2571                recid(next-shift-obj) = recid(shift-obj) NO-ERROR.
     2572     FIND NEXT  next-shift-obj SHARE-LOCK WHERE
     2573                next-shift-obj.obj-type = pobj-type AND
     2574                next-shift-obj.obj-code = pobj-code
     2575                   use-index pi NO-ERROR.
     2576     if avail next-shift-obj then do:
     2577       if next-shift-obj.status_ = 'ожд':U then release next-shift-obj.
     2578       else if next-shift-obj.status_ = 'зкр':U or next-shift-obj.status_ = 'тек':U then
     2579       bttns = replace(bttns, "b-add-next", "").
     2580     end.
     2581     run adm/shattri.p (
     2582       input "get":U
     2583       ,input  pobj-type
     2584       ,input  pobj-code
     2585       ,input  'staff':U
     2586       ,input  'noanshftstaff':U
     2587       ,output v-value-character
     2588       ,output v-value-date
     2589       ,output v-value-decimal
     2590       ,output v-value-integer
     2591       ,output v-noanshftstaff
     2592       ,output v-param-type
     2593       ,INPUT-OUTPUT table-handle v-tth
     2594       )  .
     2595     delete object v-tth no-error.
     2596   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2597     (input  'is-erpRN'
     2598     ,input  0
     2599     ,input  ''
     2600     ,input  0
     2601     ,input  ''
     2602     ,input  ''
     2603     ,input  ''
     2604     ,input  NO
     2605     ,output conf-par
     2606     ,output par-type
     2607     ) no-error .
     2608     IF not error-status:error and conf-par = "yes":U
     2609     then do:
     2610       v-1C = true .
     2611     end .
     2612     else do :
     2613       v-1C = false .
     2614     end .
     2615     RUN MYenable in this-procedure .
     2616     WAIT-FOR GO OF FRAME PERS-Frame.
     2617   END.
     2618   RUN disable_UI in this-procedure .
     2619   PROCEDURE Create-pers :
     2620   DEFINE INPUT PARAMETER pnext-shift as logical no-undo.
     2621   define variable cli-list as char no-undo.
     2622   define variable cli-rec as recid no-undo.
     2623   define variable ii as integer no-undo.
     2624   define variable for-name as char no-undo.
     2625   define buffer loc-shft-pers for shft-pers.
     2626   define buffer buf_staff for ub.staff.
     2627   if add-option = "" then return error.
     2628   CASE add-option:
     2629     when "ref":U then do:
     2630       run ref/staffs.w ( input parparentproc
     2631                       , input (if pnext-shift then "b-sel" else "b-sel,b-mark")
     2632                       , input 'C':U
     2633                       , input v-cntxt-db-num
     2634                       , input 0
     2635                       , output cli-list ) .
     2636       if cli-list <> "" then do:
     2637           DO ii = 1 to NUM-ENTRIES(cli-list):
     2638               cli-rec = integer(entry(ii, cli-list)).
     2639               FIND FIRSt buf_staff No-LOCK WHERE
     2640                          recid(buf_staff) = cli-rec No-ERROR.
     2641               if not avail buf_staff then do:
     2642                   add-option = "".
     2643                   return error substitute("Не найден кассир - recid &1", cli-rec).
     2644               end.
     2645               FIND FIRSt ub.person No-LOCK WHERE
     2646                          ub.person.psn-code  = buf_staff.psn-code No-ERROR.
     2647               if not avail person then do:
     2648                   add-option = "".
     2649                   return error.
     2650               end.
     2651               FIND FIRSt ub.clients No-LOCK WHERE
     2652                          ub.clients.obj-type = 'чел':U AND
     2653                          ub.clients.obj-code = ub.person.psn-code No-ERROR.
     2654               if not avail ub.clients then do:
     2655                   add-option = "".
     2656                   return error.
     2657               end.
     2658               FIND FIRST loc-shft-pers No-LOCK WHERE
     2659                          loc-shft-pers.psn-code = person.psn-code AND
     2660                          loc-shft-pers.next-shift = pnext-shift No-ERROR.
     2661               if not avail loc-shft-pers then do:
     2662                   create loc-shft-pers.
     2663                   assign
     2664                   loc-shft-pers.FIO = clients.obj-name + chr(32) +
     2665                                   person.name1 + chr(32) + person.name2
     2666                   loc-shft-pers.psn-code = buf_staff.psn-code
     2667                   loc-shft-pers.cashier  = buf_staff.staff-code
     2668                   loc-shft-pers.next-shift = pnext-shift
     2669                   loc-shft-pers.staff-role = if pnext-shift then yes else no
     2670                   CLI-REC = RECID(loc-shft-pers)
     2671                   .
     2672                   RELEASE LOC-SHFT-PERS.
     2673               end.
     2674               else do:
     2675                   message substitute("&1 &2 &3 уже входит в состав персонала &4"
     2676                                      , clients.obj-name
     2677                                      , person.name1
     2678                                      , person.name2
     2679                                      , (if NOT pnext-shift
     2680                                       then "передающей смены"
     2681                                       else "принимающей смены"))
     2682                   view-as alert-box ERROR.
     2683               end.
     2684           END.
     2685       end.
     2686       else do:
     2687         undo, return error .
     2688       end.
     2689     END.
     2690     WHEN "blank":U then do:
     2691       if v-noanshftstaff then do:
     2692         message
     2693         "Для данного объекта действует запрет на ввод произвольных данных по персоналу"
     2694         view-as alert-box error .
     2695         undo, return error .
     2696       end.
     2697       run gbl/d-prompt.w (
     2698         'title=':u + "Введите ФИО оператора или старшего по смене" + '\':u
     2699       + 'text1=':u + " ФИО" + '\':u
     2700       + 'format=' + "X(40)" + '\':u
     2701       + 'type=' + 'C':U + '\':u
     2702       + 'fillin_row=2\':u
     2703       + 'fillin_col=4\':u
     2704       + 'fillin_width=20\':u
     2705       + 'fillin_height=1\':u
     2706       + 'max-chars=70\':u
     2707       + 'readonly=no\':u
     2708       , input-output for-name
     2709       ).
     2710     if return-value = 'false':u then do:
     2711       add-option = "".
     2712       return error.
     2713     end.
     2714       create loc-shft-pers.
     2715       assign
     2716       loc-shft-pers.cashier = 0
     2717       loc-shft-pers.psn-code = ?
     2718       loc-shft-pers.fio = for-name
     2719       loc-shft-pers.next-shift = pnext-shift
     2720       loc-shft-pers.staff-role = if pnext-shift then yes else no
     2721       cli-rec = recid(loc-shft-pers)
     2722       .
     2723       release loc-shft-pers.
     2724       if NOT pnext-shift then do:
     2725         assign
     2726         shft-pers.fio:read-only in browse br-staff = false
     2727         shft-pers.cashier:read-only in browse br-staff = false
     2728         .
     2729       end.
     2730       else do:
     2731         assign
     2732         next-shft-pers.fio:read-only in browse br-staff-next = false
     2733         next-shft-pers.cashier:read-only in browse br-staff-next = false
     2734         .
     2735       end.
     2736       add-option = "".
     2737     END.
     2738   END CASE.
     2739       if NOT pnext-shift then do:
     2740           OPEN QUERY BR-staff FOR EACH shft-pers       WHERE shft-pers.next-shift = no SHARE-LOCK     BY shft-pers.staff-role DESCENDING.
     2741           reposition br-staff to recid cli-rec no-error.
     2742           apply "entry" to br-staff in frame PERS-Frame.
     2743       end.
     2744       else do:
     2745           OPEN QUERY BR-staff-next FOR EACH next-shft-pers       WHERE next-shft-pers.next-shift = yes SHARE-LOCK     BY next-shft-pers.staff-role DESCENDING.
     2746           reposition br-staff-next to recid cli-rec no-error.
     2747           DISABLE b-add-next with frame PERS-Frame.
     2748           apply "entry" to br-staff-next in frame PERS-Frame.
     2749       end.
     2750   END PROCEDURE.
     2751   PROCEDURE delete-pers :
     2752   DEFINE INPUT PARAMETER pnext-shift as logical no-undo.
     2753   DEFINE PARAMETER BUFFER loc-shft-pers for shft-pers.
     2754   define variable glog as logical no-undo .
     2755     if avail loc-shft-pers then do:
     2756     glog = yes.
     2757     message "Удалить "
     2758     (if NOT pnext-shift
     2759      then shft-pers.fio
     2760      else next-shft-pers.fio)
     2761      "из состава персонала"
     2762     (if NOT pnext-shift
     2763      then "передающей смены"
     2764      else "принимающей смены")
     2765       "?"
     2766      view-as alert-box question buttons OK-Cancel update glog.
     2767     if glog <> true then return error.
     2768     delete loc-shft-pers.
     2769     if NOT pnext-shift then do:
     2770         OPEN QUERY BR-staff FOR EACH shft-pers       WHERE shft-pers.next-shift = no SHARE-LOCK     BY shft-pers.staff-role DESCENDING.
     2771         reposition br-staff to row 1 no-error.
     2772         apply "entry" to br-staff in frame PERS-Frame.
     2773     end.
     2774     else do:
     2775         OPEN QUERY BR-staff-next FOR EACH next-shft-pers       WHERE next-shft-pers.next-shift = yes SHARE-LOCK     BY next-shft-pers.staff-role DESCENDING.
     2776         reposition br-staff-next to row 1 no-error.
     2777         apply "entry" to br-staff-next in frame PERS-Frame.
     2778         ENABLE b-add-next with frame PERS-Frame.
     2779     end.
     2780     end.
     2781   END PROCEDURE.
     2782   PROCEDURE disable_UI :
     2783     HIDE FRAME PERS-Frame.
     2784   END PROCEDURE.
     2785   PROCEDURE enable_UI :
     2786     ENABLE b-quit B-Help RECT-1 RECT-2 B-add B-del B-chg B-mng BR-staff
     2787            B-add-next B-del-next B-chg-next BR-staff-next
     2788         WITH FRAME PERS-Frame.
     2789     Display B-exit with frame PERS-Frame .
     2790     VIEW FRAME PERS-Frame.
     2791     OPEN QUERY BR-staff FOR EACH shft-pers       WHERE shft-pers.next-shift = no SHARE-LOCK     BY shft-pers.staff-role DESCENDING.    OPEN QUERY BR-staff-next FOR EACH next-shft-pers       WHERE next-shft-pers.next-shift = yes SHARE-LOCK     BY next-shft-pers.staff-role DESCENDING.
     2792   END PROCEDURE.
     2793   PROCEDURE fill-db :
     2794   define variable for-psn-num like ub.shift-staff.psn-num no-undo init 0.
     2795   define buffer buf_shift-staff for ub.shift-staff.
     2796       FOR EACH shft-pers NO-LOCK where
     2797            shft-pers.next-shift = no and
     2798            shft-pers.psn-code <> -1
     2799            by shft-pers.staff-role
     2800            by shft-pers.fio:
     2801          FIND FIRST buf_shift-staff where
     2802                     buf_shift-staff.OBJ-TYPE = POBJ-TYPE and
     2803                     buf_shift-staff.obj-code = pobj-code AND
     2804                     buf_shift-staff.shift-num = pshift-num AND
     2805                     buf_shift-staff.shift-date = pshift-date AND
     2806                     buf_shift-staff.next-shift = no AND
     2807                     buf_shift-staff.psn-num = for-psn-num no-error.
     2808           if not avail buf_shift-staff then do:
     2809               create buf_shift-staff.
     2810               assign
     2811               buf_shift-staff.obj-type = pobj-type
     2812               buf_shift-staff.obj-code = pobj-code
     2813               buf_shift-staff.shift-num = pshift-num
     2814               buf_shift-staff.shift-name = shift-obj.shift-name
     2815               buf_shift-staff.shift-date = pshift-date
     2816               buf_shift-staff.psn-num = for-psn-num
     2817               buf_shift-staff.next-shift = no
     2818               .
     2819           end.
     2820           if avail buf_shift-staff THEN DO:
     2821               ASSIGN
     2822               buf_shift-staff.NAME = SHft-pers.fio
     2823               buf_shift-staff.psn-code = shft-pers.psn-code
     2824               buf_shift-staff.cashier = shft-pers.cashier
     2825               buf_shift-staff.staff-role = shft-pers.staff-role
     2826               .
     2827           END.
     2828           for-psn-num = for-psn-num + 1.
     2829       END.
     2830       FOR EACH buf_shift-staff where
     2831                buf_shift-staff.OBJ-TYPE = POBJ-TYPE and
     2832                buf_shift-staff.obj-code = pobj-code AND
     2833                buf_shift-staff.shift-num = pshift-num AND
     2834                buf_shift-staff.shift-date = pshift-date AND
     2835                buf_shift-staff.next-shift = no AND
     2836                buf_shift-staff.psn-num >= for-psn-num:
     2837           delete buf_shift-staff.
     2838       END.
     2839       for-psn-num = 0.
     2840       FOR EACH shft-pers NO-LOCK where
     2841         shft-pers.next-shift = yes
     2842         by shft-pers.staff-role
     2843         by shft-pers.fio:
     2844           FIND FIRST buf_shift-staff where
     2845                     buf_shift-staff.OBJ-TYPE = POBJ-TYPE and
     2846                     buf_shift-staff.obj-code = pobj-code AND
     2847                     buf_shift-staff.shift-num = pshift-num AND
     2848                     buf_shift-staff.shift-date = pshift-date AND
     2849                     buf_shift-staff.next-shift = yes AND
     2850                     buf_shift-staff.psn-num = for-psn-num no-error.
     2851           if not avail buf_shift-staff then do:
     2852               create buf_shift-staff.
     2853               assign
     2854               buf_shift-staff.obj-type   = pobj-type
     2855               buf_shift-staff.obj-code   = pobj-code
     2856               buf_shift-staff.shift-num  = pshift-num
     2857               buf_shift-staff.shift-name = shift-obj.shift-name
     2858               buf_shift-staff.shift-date = pshift-date
     2859               buf_shift-staff.psn-num    = for-psn-num
     2860               buf_shift-staff.next-shift = yes
     2861               .
     2862           end.
     2863       if avail buf_shift-staff THEN DO:
     2864           ASSIGN
     2865           buf_shift-staff.NAME = SHft-pers.fio
     2866           buf_shift-staff.next-shift = shft-pers.next-shift
     2867           buf_shift-staff.cashier = shft-pers.cashier
     2868           buf_shift-staff.staff-role = shft-pers.staff-role
     2869            buf_shift-staff.psn-code = shft-pers.psn-code
     2870           .
     2871       END.
     2872       for-psn-num = for-psn-num + 1.
     2873       END.
     2874       FOR EACH buf_shift-staff where
     2875                 buf_shift-staff.OBJ-TYPE = POBJ-TYPE and
     2876                 buf_shift-staff.obj-code = pobj-code AND
     2877                 buf_shift-staff.shift-num = pshift-num AND
     2878                 buf_shift-staff.shift-date = pshift-date AND
     2879                 buf_shift-staff.next-shift = yes AND
     2880                 buf_shift-staff.psn-num >= for-psn-num:
     2881           delete buf_shift-staff.
     2882       END.
     2883       for-psn-num = 0.
     2884       if avail next-shift-obj and next-shift-obj.status_ <> 'зкр':U then do:
     2885           FOR EACH shft-pers NO-LOCK where
     2886            shft-pers.next-shift = yes
     2887            by shft-pers.staff-role
     2888            by shft-pers.fio:
     2889              FIND FIRST buf_shift-staff where
     2890                         buf_shift-staff.OBJ-TYPE = POBJ-TYPE and
     2891                         buf_shift-staff.obj-code = pobj-code AND
     2892                         buf_shift-staff.shift-num = next-shift-obj.shift-num AND
     2893                         buf_shift-staff.shift-date = next-shift-obj.shift-date AND
     2894                         buf_shift-staff.next-shift = no AND
     2895                         buf_shift-staff.psn-num = for-psn-num no-error.
     2896               if not avail buf_shift-staff then do:
     2897                   create buf_shift-staff.
     2898                   assign
     2899                   buf_shift-staff.obj-type   = pobj-type
     2900                   buf_shift-staff.obj-code   = pobj-code
     2901                   buf_shift-staff.shift-num  = next-shift-obj.shift-num
     2902                   buf_shift-staff.shift-name = next-shift-obj.shift-name
     2903                   buf_shift-staff.shift-date = next-shift-obj.shift-date
     2904                   buf_shift-staff.psn-num    = for-psn-num
     2905                   buf_shift-staff.next-shift = no
     2906                   .
     2907               end.
     2908             if avail buf_shift-staff THEN DO:
     2909                 ASSIGN
     2910                 buf_shift-staff.NAME = SHft-pers.fio
     2911                 buf_shift-staff.next-shift = no
     2912                 buf_shift-staff.cashier = shft-pers.cashier
     2913                 buf_shift-staff.staff-role = shft-pers.staff-role
     2914                 buf_shift-staff.psn-code = shft-pers.psn-code
     2915                 .
     2916             END.
     2917           for-psn-num = for-psn-num + 1.
     2918           END.
     2919           FOR EACH buf_shift-staff where
     2920                     buf_shift-staff.OBJ-TYPE = POBJ-TYPE and
     2921                     buf_shift-staff.obj-code = pobj-code AND
     2922                     buf_shift-staff.shift-num = next-shift-obj.shift-num AND
     2923                     buf_shift-staff.shift-date = next-shift-obj.shift-date AND
     2924                     buf_shift-staff.next-shift = no AND
     2925                     buf_shift-staff.psn-num >= for-psn-num:
     2926               delete buf_shift-staff.
     2927           END.
     2928       end.
     2929   END PROCEDURE.
     2930   PROCEDURE fill-table :
     2931   DEFINE OUTPUT PARAMETER find-mng-next as logical no-undo.
     2932   define buffer buf_shift-staff for ub.shift-staff.
     2933   for each shft-pers:
     2934       delete shft-pers.
     2935   end.
     2936   if call-point = 'смена-объект-откр':U and avail previous-shift-obj then do:
     2937     FOR EACH buf_shift-staff No-LOCK WHERE
     2938             buf_shift-staff.obj-type = pobj-type AND
     2939             buf_shift-staff.obj-code = pobj-code AND
     2940             buf_shift-staff.shift-num = previous-shift-obj.shift-num AND
     2941             buf_shift-staff.shift-date = previous-shift-obj.shift-date AND
     2942             buf_shift-staff.next-shift = yes use-index pi:
     2943             create shft-pers.
     2944             assign
     2945             shft-pers.psn-code = buf_shift-staff.psn-code
     2946             shft-pers.cashier = buf_shift-staff.cashier
     2947             shft-pers.fio = buf_shift-staff.name
     2948             shft-pers.staff-role = buf_shift-staff.staff-role
     2949             shft-pers.next-shift = no
     2950             .
     2951     END.
     2952   end.
     2953   else
     2954   FOR EACH buf_shift-staff No-LOCK WHERE
     2955            buf_shift-staff.obj-type = pobj-type AND
     2956            buf_shift-staff.obj-code = pobj-code AND
     2957            buf_shift-staff.shift-num = pshift-num AND
     2958            buf_shift-staff.shift-date = pshift-date AND
     2959            buf_shift-staff.next-shift = no use-index pi:
     2960            create shft-pers.
     2961            assign
     2962            shft-pers.psn-code = buf_shift-staff.psn-code
     2963            shft-pers.cashier = buf_shift-staff.cashier
     2964            shft-pers.fio = buf_shift-staff.name
     2965            shft-pers.staff-role = buf_shift-staff.staff-role
     2966            shft-pers.next-shift = buf_shift-staff.next-shift
     2967            .
     2968   END.
     2969   IF AVAIL next-shift-obj then do:
     2970     FOR EACH buf_shift-staff No-LOCK WHERE
     2971             buf_shift-staff.obj-type = next-shift-obj.obj-type AND
     2972             buf_shift-staff.obj-code = next-shift-obj.obj-code AND
     2973             buf_shift-staff.shift-num = next-shift-obj.shift-num AND
     2974             buf_shift-staff.shift-date = next-shift-obj.shift-date AND
     2975             buf_shift-staff.staff-role = yes AND
     2976             buf_shift-staff.next-shift = no use-index pi:
     2977             create shft-pers.
     2978             assign
     2979             shft-pers.psn-code = buf_shift-staff.psn-code
     2980             shft-pers.cashier = buf_shift-staff.cashier
     2981             shft-pers.fio = buf_shift-staff.name
     2982             shft-pers.staff-role = buf_shift-staff.staff-role
     2983             shft-pers.next-shift = yes
     2984             .
     2985       find-mng-next = yes.
     2986     END.
     2987   end.
     2988   else
     2989   FOR EACH buf_shift-staff No-LOCK WHERE
     2990            buf_shift-staff.obj-type = pobj-type AND
     2991            buf_shift-staff.obj-code = pobj-code AND
     2992            buf_shift-staff.shift-num = pshift-num AND
     2993            buf_shift-staff.shift-date = pshift-date AND
     2994            buf_shift-staff.next-shift = yes use-index pi:
     2995            create shft-pers.
     2996            assign
     2997            shft-pers.psn-code = buf_shift-staff.psn-code
     2998            shft-pers.cashier = buf_shift-staff.cashier
     2999            shft-pers.fio = buf_shift-staff.name
     3000            shft-pers.staff-role = buf_shift-staff.staff-role
     3001            shft-pers.next-shift = buf_shift-staff.next-shift
     3002            .
     3003       find-mng-next = yes.
     3004   END.
     3005   END PROCEDURE.
     3006   PROCEDURE Mng-pers :
     3007   DEFINE INPUT PARAMETER pnext-shift as integer no-undo.
     3008   DEFINE PARAMETER BUFFER loc-shft-pers for shft-pers.
     3009   define variable cli-rec as recid no-undo.
     3010   define buffer b-shft-pers for shft-pers.
     3011   if avail loc-shft-pers then do:
     3012      DO TRANSACTION ON ERROR UNDO, return error:
     3013       if loc-shft-pers.staff-role = no THEN DO:
     3014           FOR EACH b-shft-pers where
     3015                    b-shft-pers.next-shift = loc-shft-pers.next-shift AND
     3016                    b-shft-pers.staff-role = yes:
     3017               assign
     3018               b-shft-pers.staff-role = no.
     3019           END.
     3020       end.
     3021       assign
     3022       loc-shft-pers.staff-role = NOT loc-shft-pers.staff-role
     3023       cli-rec = recid(loc-shft-pers)
     3024       .
     3025       END.
     3026      if pnext-shift = 0 then do:
     3027       OPEN QUERY BR-staff FOR EACH shft-pers       WHERE shft-pers.next-shift = no SHARE-LOCK     BY shft-pers.staff-role DESCENDING.
     3028       reposition br-staff to recid cli-rec no-error.
     3029       apply "entry" to br-staff in frame PERS-Frame.
     3030      end.
     3031      else do:
     3032       OPEN QUERY BR-staff-next FOR EACH next-shft-pers       WHERE next-shft-pers.next-shift = yes SHARE-LOCK     BY next-shft-pers.staff-role DESCENDING.
     3033       reposition br-staff-NEXT to recid cli-rec no-error.
     3034       apply "entry" to br-staff-next in frame PERS-Frame.
     3035      end.
     3036   end.
     3037   END PROCEDURE.
     3038   PROCEDURE MyEnable :
     3039   define variable varshift-name as character no-undo .
     3040   define variable varshift-name-next as character no-undo .
     3041   define variable varshift-name-num as character no-undo .
     3042   define variable varshift-name-num-next as character no-undo .
     3043   define variable glog as logical no-undo .
     3044   define variable v-obj-db-num as integer no-undo .
     3045   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3046   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3047     (input  pobj-type
     3048     ,input  pobj-code
     3049     ,output v-obj-db-num
     3050     )  .
     3051   ASSIGN b-add:POPUP-MENU IN FRAME PERS-Frame = MENU menu-b-add:HANDLE.
     3052   ASSIGN b-add:MENU-MOUSE = 1.
     3053   ASSIGN b-add-next:POPUP-MENU IN FRAME PERS-Frame = MENU menu-b-add-next:HANDLE.
     3054   ASSIGN b-add-next:MENU-MOUSE = 1.
     3055   if lookup("b-add", bttns) > 0 and v-obj-db-num = v-cntxt-db-num then do:
     3056     assign
     3057     B-add:POPUP-MENU IN FRAME PERS-Frame       = MENU MENU-B-add:HANDLE
     3058     BR-staff:POPUP-MENU IN FRAME PERS-Frame             = MENU MENU-BR-staff:HANDLE
     3059     .
     3060   end.
     3061   else do:
     3062     assign
     3063     B-add:POPUP-MENU IN FRAME PERS-Frame       = ?
     3064     BR-staff:POPUP-MENU IN FRAME PERS-Frame    = ?
     3065     .
     3066   end.
     3067   if lookup("b-add-next", bttns) > 0 and v-obj-db-num = v-cntxt-db-num then do:
     3068     ASSIGN
     3069     B-add-next:POPUP-MENU IN FRAME PERS-Frame       = MENU MENU-B-add-next:HANDLE
     3070     BR-staff-next:POPUP-MENU IN FRAME PERS-Frame    = MENU MENU-BR-staff-next:HANDLE
     3071     .
     3072   end.
     3073   else do:
     3074     ASSIGN
     3075     B-add-next:POPUP-MENU IN FRAME PERS-Frame       = ?
     3076     BR-staff-next:POPUP-MENU IN FRAME PERS-Frame    = ?
     3077     .
     3078   end.
     3079   ENABLE
     3080   B-exit
     3081   b-quit
     3082   B-Help
     3083   RECT-1
     3084   RECT-2
     3085   B-add when lookup("b-add", bttns) > 0 and v-obj-db-num = v-cntxt-db-num
     3086   B-del when lookup("b-add", bttns) > 0 and v-obj-db-num = v-cntxt-db-num
     3087   b-mng when lookup("b-add", bttns) > 0 and v-obj-db-num = v-cntxt-db-num
     3088   b-chg when lookup("b-add", bttns) > 0 and v-obj-db-num = v-cntxt-db-num
     3089   BR-staff
     3090   B-add-next when lookup("b-add-next", bttns) > 0 and v-obj-db-num = v-cntxt-db-num
     3091   B-del-next when lookup("b-add-next", bttns) > 0 and v-obj-db-num = v-cntxt-db-num
     3092   b-chg-next when lookup("b-add-next", bttns) > 0 and v-obj-db-num = v-cntxt-db-num
     3093   BR-staff-next
     3094   WITH FRAME PERS-Frame.
     3095   VIEW FRAME PERS-Frame.
     3096   run fill-table in this-procedure ( output glog) no-error.
     3097   if glog then
     3098   disable b-add-next with frame PERS-Frame.
     3099   OPEN QUERY BR-staff FOR EACH shft-pers       WHERE shft-pers.next-shift = no SHARE-LOCK     BY shft-pers.staff-role DESCENDING.    OPEN QUERY BR-staff-next FOR EACH next-shft-pers       WHERE next-shft-pers.next-shift = yes SHARE-LOCK     BY next-shft-pers.staff-role DESCENDING.
     3100   assign
     3101   shft-pers.fio:read-only in browse br-staff = true
     3102   shft-pers.cashier:read-only in browse br-staff = true
     3103   .
     3104   assign
     3105   next-shft-pers.fio:read-only in browse br-staff-next = true
     3106   next-shft-pers.cashier:read-only in browse br-staff-next = true
     3107   .
     3108   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnam in g#lib-trn3
     3109     (
     3110        input pobj-type
     3111     ,  input pobj-code
     3112     ,  input pshift-date
     3113     ,  input pshift-num
     3114     , output varshift-name
     3115     , output varshift-name-num
     3116     )        no-error .
     3117   if available next-shift-obj then do:
     3118   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnam in g#lib-trn3
     3119     (
     3120        input pobj-type
     3121     ,  input pobj-code
     3122     ,  input next-shift-obj.shift-date
     3123     ,  input next-shift-obj.shift-num
     3124     , output varshift-name-next
     3125     , output varshift-name-num-next
     3126     )        no-error .
     3127   end.
     3128   assign
     3129   MENU-ITEM m-add-blank:sensitive   in MENU MENU-B-add = not v-noanshftstaff
     3130   MENU-ITEM m-add-next-blank:sensitive in menu menu-b-add-next = not v-noanshftstaff
     3131   MENU-ITEM m-br-blank:sensitive in menu menu-br-staff = not v-noanshftstaff
     3132   MENU-ITEM m-br-next-blank:sensitive in menu menu-br-staff-next = not v-noanshftstaff
     3133   .
     3134   ASSIGN
     3135   browse br-staff:title = substitute("&1 &2 &3"
     3136                                       , browse br-staff:title
     3137                                       , string(pshift-date, "99/99/9999")
     3138                                       , varshift-name-num)
     3139   browse br-staff-next:title = substitute("&1 &2 &3"
     3140                                           , browse br-staff-next:title
     3141                                           , (if available next-shift-obj
     3142                                             then string(next-shift-obj.shift-date, "99/99/9999")
     3143                                             else '':U)
     3144                                           , (if available next-shift-obj
     3145                                             then  varshift-name-num-next
     3146                                             else '':U) )
     3147   .
     3148   if b-add:sensitive in frame PERS-Frame then do:
     3149     APPLY "ENTRY" to b-add.
     3150   end.
     3151   if lookup("b-add", bttns) = 0
     3152   and lookup("b-add-next", bttns) = 0 then do:
     3153     assign
     3154     b-quit:label = "&Выход"
     3155     b-quit:column = 1
     3156     .
     3157     hide
     3158     b-exit in frame PERS-Frame
     3159     .
     3160   end.
     3161   END PROCEDURE.
     3162   PROCEDURE upd-next-shft-pers :
     3163     IF AVAIL next-shft-pers THEN DO:
     3164     IF next-shft-pers.PSN-CODE <> ? THEN DO:
     3165       MESSAGE "Нельзя изменить эту запись - она была выбрана из справочника"
     3166       VIEW-AS ALERT-BOX ERROR.
     3167       DISPLAY
     3168       next-shft-pers.fio
     3169       next-shft-pers.cashier
     3170       with browse br-staff-next
     3171       .
     3172       RETURN error.
     3173     END.
     3174     assign
     3175     next-shft-pers.fio = next-shft-pers.fio:screen-value in browse br-staff-next
     3176     next-shft-pers.cashier = integer(next-shft-pers.cashier:screen-value in browse br-staff-next)
     3177     .
     3178     DISPLAY
     3179     next-shft-pers.fio
     3180     next-shft-pers.cashier
     3181     with browse br-staff-next
     3182     .
     3183     assign
     3184     next-shft-pers.fio:read-only in browse br-staff-next = true
     3185     next-shft-pers.cashier:read-only in browse br-staff-next = true
     3186     .
     3187     end.
     3188     run gbl/frcclick.p (
     3189                           input br-staff-next:handle in frame PERS-Frame
     3190                          ,input next-shft-pers.staff-role:handle in browse br-staff-next
     3191                          ,input no) no-error.
     3192   END PROCEDURE.
     3193   PROCEDURE upd-shft-pers :
     3194     IF AVAIL SHFT-PERS THEN DO:
     3195     IF SHFT-PERS.PSN-CODE <> ? THEN DO:
     3196       MESSAGE "Нельзя изменить эту запись - она была выбрана из справочника"
     3197       VIEW-AS ALERT-BOX ERROR.
     3198       DISPLAY
     3199       shft-pers.fio
     3200       shft-pers.cashier
     3201       with browse br-staff
     3202       .
     3203       RETURN error.
     3204     END.
     3205     assign
     3206     shft-pers.fio = shft-pers.fio:screen-value in browse br-staff
     3207     shft-pers.cashier = integer(shft-pers.cashier:screen-value in browse br-staff)
     3208     .
     3209     DISPLAY
     3210     shft-pers.fio
     3211     shft-pers.cashier
     3212     with browse br-staff
     3213     .
     3214     assign
     3215     shft-pers.fio:read-only in browse br-staff = true
     3216     shft-pers.cashier:read-only in browse br-staff = true
     3217     .
     3218     end.
     3219     run gbl/frcclick.p (
     3220                          input br-staff:handle in frame PERS-Frame
     3221                         ,input shft-pers.staff-role:handle in browse br-staff
     3222                         ,input no) no-error.
     3223   END PROCEDURE.
