     1042         find first ub.shift-staff no-lock where ub.shift-staff.obj-type = pobj-type
     1043                                             and ub.shift-staff.obj-code = pobj-code
     1044                                             and ub.shift-staff.shift-num = pshift-num
     1045                                             and ub.shift-staff.shift-date = pshift-date
     1046                                             and ub.shift-staff.next-shift = no
     1047                                             no-error .
