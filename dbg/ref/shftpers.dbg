     1050           message "Включен обмен с 1С. Ввод персонала смены обязателен." view-as alert-box .
     1051           return no-apply .
     1052         end .
     1053       end .
     1054   END.
     1055   ON CHOOSE OF B-mng IN FRAME PERS-Frame
     1056   DO:
     1057   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1058   if lookup(self :type
     1059            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1060            ) = 0
     1061   then do:
     1062     message
     1063       "$Workfile$"
     1064       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1065       "Интерфейсный элемент" self :name  skip
     1066       "Тип" self :type  skip
     1067       "Процедура" this-procedure :file-name skip
     1068       view-as alert-box .
     1069   end.
     1070   else do:
     1071     apply "entry":u to self  .
     1072     if focus :handle <> self :handle  then do:
     1073       return no-apply .
     1074     end.
     1075   end.
     1076     run mng-pers  in this-procedure ( input 0, buffer shft-pers) no-error.
     1077     if error-status:error then return no-apply.
     1078   END.
