      885   else do:
      886     apply "entry":u to self  .
      887     if focus :handle <> self :handle  then do:
      888       return no-apply .
      889     end.
      890   end.
      891       if avail shft-pers then do:
      892           if shft-pers.psn-code <> ? then do:
      893               MESSAGE "Нельзя изменить эту запись - она была выбрана из справочника"
      894               VIEW-AS ALERT-BOX ERROR.
      895               return no-apply.
      896           end.
      897         assign
      898         shft-pers.fio:read-only in browse br-staff = false
      899         shft-pers.cashier:read-only in browse br-staff = false
      900         .
      901         APPLY "ENTRY" to shft-pers.fio in browse br-staff.
      902       end.
      903   END.
      904   ON CHOOSE OF B-chg-next IN FRAME PERS-Frame
      905   DO:
