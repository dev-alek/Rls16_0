        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-mode      as character no-undo .
        4   define input parameter p-gds-code  like ub.goods.gds-code no-undo .
        5   define input parameter p-host-code like ub.sysconf.host-code  no-undo .
        6   define input parameter p-obj-type  like ub.clients.obj-type  no-undo .
        7   define input parameter p-obj-code  like ub.clients.obj-code  no-undo .
        8   define input parameter p-update-on-exit as logical no-undo .
        9   define output parameter p-modified as logical no-undo .
       10   define output parameter p-is-error as logical no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: gh-attir.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: ref/gh-attir.p $":U .
       16   define variable vss-description as character no-undo init "Запуск интерфейса редактирования атрибутов товара на фирме".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define variable v-update-attr as logical no-undo .
       76   define temp-table tt0-gds-host-attr no-undo like ub.gds-host-attr.
       77   define buffer buf_gds-host-attr for ub.gds-host-attr.
       78   do TRANSACTION
       79   on error undo, return error return-value
       80   on stop undo, return error return-value
       81   :
       82     for each tt0-gds-host-attr:
       83       delete tt0-gds-host-attr.
       84     end.
       85     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
       86       do on error undo, return error :
       87         FOR EACH buf_gds-host-attr exclusive-lock  where
       88                  buf_gds-host-attr.gds-code = p-gds-code
       89              AND buf_gds-host-attr.host-code = p-host-code
       90         on error undo, return error :
       91             CREATE tt0-gds-host-attr.
       92             BUFFER-COPY buf_gds-host-attr TO tt0-gds-host-attr.
       93         END.
       94         run ref/gdshatti.w (
       95                         input parparentproc
       96                       , input p-mode
       97                       , input p-gds-code
       98                       , input p-obj-type
       99                       , input p-obj-code
      100                       , input p-update-on-exit
      101                       , output p-modified
      102                       , input-output table tt0-gds-host-attr
      103                             ) no-error.
      104         if error-status:error then do:
      105           assign
      106           p-is-error = yes.
      107         end.
      108         for each tt0-gds-host-attr:
      109           delete tt0-gds-host-attr.
      110         end.
      111         if p-is-error then do:
      112           return error substitute("&1 &2", error-status:get-message(1) , return-value ).
      113         end.
      114       end.
      115     end.
      116     else do:
      117       FOR EACH buf_gds-host-attr no-lock where
      118               buf_gds-host-attr.gds-code = p-gds-code
      119           AND buf_gds-host-attr.host-code = p-host-code :
      120           CREATE tt0-gds-host-attr.
      121           BUFFER-COPY buf_gds-host-attr TO tt0-gds-host-attr.
      122       END.
      123       run ref/gdshatti.w (
      124                       input parparentproc
      125                     , input p-mode
      126                     , input p-gds-code
      127                     , input p-obj-type
      128                     , input p-obj-code
      129                     , input p-update-on-exit
      130                     , output p-modified
      131                     , input-output table tt0-gds-host-attr
      132                           ) no-error.
      133       if error-status:error then do:
      134         assign
      135         p-is-error = yes.
      136       end.
      137       for each tt0-gds-host-attr:
      138         delete tt0-gds-host-attr.
      139       end.
      140       if p-is-error then do:
      141         return error substitute("&1 &2", error-status:get-message(1) , return-value ).
      142       end.
      143     end.
      144   end.
