        1   block-level on error undo, throw.
        2   define input parameter p-mode            as character no-undo .
        3   define input parameter p-gds-code        like ub.gds-host-attr.gds-code no-undo .
        4   define input parameter p-host-code       like ub.gds-host-attr.host-code no-undo .
        5   define input parameter p-obj-type        like ub.clients.obj-type no-undo .
        6   define input parameter p-obj-code        like ub.clients.obj-code no-undo .
        7   define temp-table tt0-gds-host-attr no-undo like ub.gds-host-attr.
        8   DEFINE INPUT PARAMETER TABLE FOR tt0-gds-host-attr.
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: gdshatr1.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: ref/gdshatr1.p $":U .
       14   define variable vss-description as character no-undo init "Сохранение изменеий атрибутов товара на фирме".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33       assign
       34         p-vss-parameters = substitute('&1|&2|&3':u,p-gds-code,p-obj-type,p-obj-code)
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   define new global shared variable g#attr-lib  as handle no-undo .
       80   define variable v-attr-lib-variable as handle no-undo .
       81   procedure gdshattr-name :
       82   define input  parameter p-code           as character no-undo .
       83   define output parameter p-type           as character no-undo .
       84   define output parameter p-format         as character no-undo .
       85   define output parameter p-label          as character no-undo .
       86   define output parameter p-user-can-edit  as logical   no-undo .
       87   define output parameter p-output-display as logical   no-undo .
       88   define output parameter p-other          as character no-undo .
       89     do
       90     on error undo, return error
       91     :
       92           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdshattr-name in g#attr-lib
       93         (input  p-code
       94         ,output p-type
       95         ,output p-format
       96         ,output p-label
       97         ,output p-user-can-edit
       98         ,output p-output-display
       99         ,output p-other
      100         ) no-error .
      101       if error-status :error
      102       then do:
      103         undo, return error return-value .
      104       end.
      105     end.
      106   end procedure.
