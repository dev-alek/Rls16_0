      270   define variable v-deleted as logical no-undo .
      271   define variable v-err-mess as character no-undo .
      272   define variable v-host-code like ub.gds-host-attr.host-code no-undo .
      273   define buffer buf_gds-host-attr for ub.gds-host-attr.
      274   define buffer buf_goods for ub.goods.
      275   _main:
      276   do
      277   on error undo, return error return-value
      278   :
      279     find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
      280     if not available buf_goods then do:
      281       undo, return error substitute("&1 &2 &3&4Не найден товар с кодом &5"
      282                                    , vss-workfile
      283                                    , vss-revision
      284                                    , vss-description
      285                                    , chr(10)
      286                                    , p-gds-code).
      287     end.
      288   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      289   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      290     (input  p-obj-type
      291     ,input  p-obj-code
      292     ,output v-host-code
      293     )  .
      294     FOR EACH tt0-gds-host-attr:
      295         find FIRST buf_gds-host-attr WHERE buf_gds-host-attr.gds-code = p-gds-code
      296          AND buf_gds-host-attr.host-code = v-host-code
      297         AND buf_gds-host-attr.attr-code = tt0-gds-host-attr.attr-code no-error.
      298       IF not available buf_gds-host-attr
      299       or buf_gds-host-attr.attr-value <> tt0-gds-host-attr.attr-value
      300       THEN DO:
      301         run gdshattr-write IN THIS-PROCEDURE(
      302                                               input p-gds-code
      303                                             ,INPUT p-obj-type
      304                                             ,INPUT p-obj-code
      305                                             ,INPUT tt0-gds-host-attr.attr-code
      306                                             ,INPUT tt0-gds-host-attr.attr-value) NO-ERROR.
      307         IF ERROR-STATUS:ERROR THEN DO:
      308           assign
      309           v-err-mess = substitute("Ошибка при сохранении атрибута товара на фирме &1 &2 &3 :&4&5 &6"
      310                                   , p-gds-code
      311                                   , tt0-gds-host-attr.host-code
      312                                   , tt0-gds-host-attr.attr-code
      313                                   , chr(10)
      314                                   ,error-status:get-message(1)
      315                                   ,return-value).
      316           undo _main, return error v-err-mess.
      317         END.
      318       END.
      319     END.
      320     if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
      321       FOR EACH buf_gds-host-attr where buf_gds-host-attr.gds-code = p-gds-code:
      322         if buf_gds-host-attr.host-code <> p-host-code  then next.
      323           FIND FIRST tt0-gds-host-attr NO-LOCK WHERE
      324               tt0-gds-host-attr.gds-code = p-gds-code
      325           AND tt0-gds-host-attr.host-code = buf_gds-host-attr.host-code
      326           AND tt0-gds-host-attr.attr-code = buf_gds-host-attr.attr-code NO-ERROR.
      327         IF NOT AVAILABLE tt0-gds-host-attr THEN DO:
      328             ASSIGN
      329             v-deleted = NO.
      330             RUN gdshattr-delete IN THIS-PROCEDURE (
      331                                                   input buf_gds-host-attr.gds-code
      332                                                   ,input p-obj-type
      333                                                   ,INPUT p-obj-code
      334                                                   ,INPUT buf_gds-host-attr.attr-code
      335                                                   ,output v-deleted ) NO-ERROR.
      336           IF NOT v-deleted
      337           or error-status:error
      338           THEN DO:
      339             assign
      340             v-err-mess = substitute("Ошибка при удалении атрибута товара на фирме &1 &2 &3 :&4&5 &6"
      341                                     , p-gds-code
      342                                     , buf_gds-host-attr.host-code
      343                                     , buf_gds-host-attr.attr-code
      344                                     , chr(10)
      345                                     ,error-status:get-message(1)
      346                                     ,return-value
      347                                     ).
      348             undo _main, return error v-err-mess.
      349           END.
      350         END.
      351       END.
      352     end.
      353   end.
