        1   DEFINE BUFFER locked_fin-statement FOR ub.fin-statement.
        2   DEFINE BUFFER locked_fin-statement-line FOR ub.fin-statement-line.
        3   DEFINE TEMP-TABLE tt-fin-doc NO-UNDO LIKE ub.fin-doc.
        4   DEFINE TEMP-TABLE tt-fin-statement NO-UNDO LIKE ub.fin-statement.
        5   DEFINE TEMP-TABLE tt0-fin-statement-attr NO-UNDO LIKE ub.fin-statement-attr.
        6   DEFINE BUFFER X_clients FOR ub.clients.
        7   DEFINE BUFFER X_curr_sysconf FOR ub.sysconf.
        8   DEFINE BUFFER X_fin-bank FOR ub.fin-bank.
        9   DEFINE BUFFER X_fin-schet FOR ub.fin-schet.
       10   DEFINE BUFFER X_sysconf FOR ub.sysconf.
       11   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
       12   DEFINE INPUT PARAMETER p-curr-host-code LIKE ub.fin-statement.host-code NO-UNDO.
       13   DEFINE INPUT PARAMETER p-mode           AS character NO-UNDO.
       14   DEFINE INPUT PARAMETER p-host-code LIKE ub.fin-statement.host-code NO-UNDO.
       15   DEFINE INPUT PARAMETER p-sttm-code LIKE ub.fin-statement.sttm-code NO-UNDO.
       16   DEFINE INPUT PARAMETER p-fins-ext-doc-type LIKE ub.fin-statement.fins-ext-doc-type NO-UNDO.
       17   DEFINE INPUT PARAMETER p-code-bank  LIKE ub.fin-statement.code-bank NO-UNDO.
       18   DEFINE INPUT PARAMETER p-code-schet LIKE ub.fin-statement.code-schet NO-UNDO.
       19   DEFINE INPUT PARAMETER p-other           AS character NO-UNDO.
       20   define input-output parameter p-doc-rec as recid no-undo.
       21   define input-output parameter p-line-rec as recid no-undo.
       22   define variable vss-revision    as character no-undo init "$Revision$":U .
       23   define variable vss-author      as character no-undo init "$Author$":U .
       24   define variable vss-date        as character no-undo init "$Date$":U .
       25   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       26   define variable vss-archive     as character no-undo init "$Archive$":U .
       27   define variable vss-description as character no-undo init "Редактирование и просмотр банковский выписки".
       28   procedure vss-get-info :
       29     define output parameter p-vss-revision    like vss-revision    no-undo .
       30     define output parameter p-vss-author      like vss-author      no-undo .
       31     define output parameter p-vss-date        like vss-date        no-undo .
       32     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       33     define output parameter p-vss-archive     like vss-archive     no-undo .
       34     define output parameter p-vss-description like vss-description no-undo .
       35     assign
       36       p-vss-revision    = vss-revision
       37       p-vss-author      = vss-author
       38       p-vss-date        = vss-date
       39       p-vss-workfile    = vss-workfile
       40       p-vss-archive     = vss-archive
       41       p-vss-description = vss-description
       42     .
       43   end procedure.
       44   procedure vss-get-parameters :
       45     define output parameter p-vss-parameters as character no-undo .
       46   end procedure.
       47   define new global shared variable g#vssrevis-logger as handle    no-undo .
       48   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       49   define variable v-vssrevis-logger                   as handle    no-undo .
       50   procedure vss-logevent :
       51     define input  parameter p-extra-paramters as character no-undo .
       52     define variable v-vssrevis-parameters as character no-undo .
       53     do
       54     on error undo, return error return-value
       55     :
       56       if  valid-handle(v-vssrevis-logger)
       57       and v-vssrevis-logger :get-signature("logevent") <> ""
       58       then do:
       59         run vss-get-parameters in this-procedure
       60           (output v-vssrevis-parameters
       61           ).
       62         run logevent in v-vssrevis-logger
       63           (input vss-workfile
       64           ,input vss-revision
       65           ,input v-vssrevis-parameters
       66           ,input p-extra-paramters
       67           ).
       68       end.
       69     end.
       70   end procedure.
       71   assign
       72     v-vssrevis-logger = g#vssrevis-logger
       73   .
       74   if  valid-handle(v-vssrevis-logger)
       75   and v-vssrevis-logger :get-signature("logevent") <> ""
       76   then do:
       77     assign
       78       v-vssrevis-logevent = true
       79     .
       80     run vss-logevent in this-procedure (input vss-description) .
       81   end.
       82   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       83   define variable v-waitfram-action01         as character   no-undo .
       84   define variable v-waitfram-action02         as character   no-undo .
       85   define variable v-waitfram-action03         as character   no-undo .
       86   define variable mWaitFramTextBeg            as character   no-undo.
       87   define variable mWaitFramTextEnd            as character   no-undo.
       88   define variable mWaitFramView               as logical     no-undo.
       89   define variable mWaitProcEvent              as logical     no-undo init yes.
       90   define variable mWaitFramInterval           as integer     no-undo init 1 .
       91   define variable mWaitFramStop               as logical     no-undo.
       92   define variable mWaitFramStopUser           as logical     no-undo.
       93   define variable mWaitFramStopTimeOut        as logical     no-undo.
       94   define variable mWaitFramStartProc          as datetime-tz no-undo.
       95   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       96   define button B-WaitFramStop auto-end-key
       97        label "Стоп"
       98        size 10 by 1 tooltip "Остоновить процесс".
       99   define button B-viewProcInfo
      100        label "Информация"
      101        size 15 by 1 tooltip "Информация о процесс".
      102   define frame waitfram
      103     v-waitfram-action01 format "x(72)" no-label skip
      104     v-waitfram-action02 format "x(72)" no-label skip
      105     v-waitfram-action03 format "x(72)" no-label skip
      106     B-viewProcInfo
      107     B-WaitFramStop at row 4 col 30
      108     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      109     .
      110   define new global shared variable mBatchMode as logical no-undo init ?.
      111   define variable mFramBachModHandle as handle no-undo.
      112   mFramBachModHandle = frame waitfram:handle.
      113   define variable mFameOldVis as logical no-undo.
      114   define variable mVisCUrentVin as logical no-undo.
      115   if session:batch-mode
      116   then
      117      mBatchMode = yes.
      118   if mBatchMode = ? then do:
      119     mVisCUrentVin = current-window:visible.
      120     mFameOldVis = mFramBachModHandle:visible.
      121     mFramBachModHandle:visible  = yes.
      122     mBatchMode = mFramBachModHandle:visible ne yes.
      123     mFramBachModHandle:visible = mFameOldVis.
      124     current-window:visible = mVisCUrentVin.
      125   end.
      126    if  log-manager:logfile-name ne ?
      127     then DO:
      128         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      129         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      130         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      131     end.
      132   on choose of B-WaitFramStop in frame waitfram
      133   do:
      134     mWaitFramStop = yes.
      135     mWaitFramStopUser = yes.
      136   end.
      137   function waitfram-check-timeout returns logical():
      138      define variable vtime as int64 no-undo.
      139      if mWaitFramStopTimeOut
      140      then
      141         return yes.
      142      vtime = ( now - mWaitFramStartProc ) / 1000 .
      143      if     mWaitFramTimeOut ne ?
      144         and mWaitFramTimeOut ne 0
      145         and mWaitFramTimeOut lt vtime
      146      then do:
      147         mWaitFramStopTimeOut = yes.
      148      end.
      149      return mWaitFramStopTimeOut.
      150   end.
      151   procedure waitfram-hide :
      152     if not session:batch-mode
      153     then do
      154     on error undo, return error return-value
      155     :
      156       pause 0 before-hide .
      157       if not mBatchMode then
      158         hide frame waitfram .
      159     if     not mWaitFramView
      160        and mWaitProcEvent
      161     then
      162       process events .
      163     end.
      164   end procedure.
      165   procedure waitfram-show :
      166     define input  parameter p-message as character no-undo .
      167     define variable v-left-margin as integer   no-undo .
      168     if not session:batch-mode
      169     then do
      170     on error undo, return error return-value
      171     :
      172       if length(p-message) <= 70 then do:
      173         assign
      174           v-left-margin = integer((70 - length(p-message)) / 2)
      175         .
      176         assign
      177           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      178         .
      179         assign
      180           v-waitfram-action01 = " "
      181           v-waitfram-action02 = " "
      182                                    + fill(" ", v-left-margin)
      183                                    + p-message
      184           v-waitfram-action03 = " "
      185         .
      186       end.
      187       else do:
      188         define variable vRindex1 as integer no-undo.
      189         define variable vRindex2 as integer no-undo.
      190         vRindex1 = r-index(p-message," ",70).
      191         if vRindex1 = 0
      192         then
      193            vRindex1 = 70.
      194         if length(p-message)  <= vRindex1 + 70 then do:
      195           assign
      196             v-waitfram-action01 = " "
      197             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      198             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      199           .
      200         end.
      201         else do:
      202           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      203           if vRindex2 <= vRindex1
      204           then
      205              vRindex2 = vRindex1 + 70.
      206           assign
      207             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      208             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      209             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      210           .
      211         end.
      212       end.
      213       B-viewProcInfo:visible   in frame waitfram = no.
      214       B-viewProcInfo:sensitive in frame waitfram = no.
      215       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      216       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      217       if  (   mWaitFramView
      218          or  mWaitProcEvent)
      219          and not mBatchMode
      220       then
      221          display
      222             v-waitfram-action01 skip
      223             v-waitfram-action02 skip
      224             v-waitfram-action03 skip
      225          with frame waitfram .
      226       if     mWaitFramView
      227          then do:
      228             if     mWaitFramInterval ne ?
      229                and not mBatchMode
      230             then
      231                wait-for go of frame waitfram pause mWaitFramInterval.
      232          end.
      233          else
      234             if     mWaitProcEvent
      235                and not mBatchMode
      236             then
      237                process events .
      238     end.
      239   end procedure.
      240      procedure waitfram-show-this:
      241         define input  parameter iInterval as int64 no-undo.
      242         define variable vtime as int64 no-undo.
      243         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      244         mWaitFramInterval = iInterval.
      245         run waitfram-show (substitute("&1&2 &3&4" ,
      246                                       mWaitFramTextBeg ,
      247                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      248                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      249                                       mWaitFramTextEnd
      250                                      )
      251                           ).
      252      end.
      253      procedure WaitFramRunPause:
      254         define input  parameter iInterval as dec no-undo.
      255         define variable vStart  as datetime-tz no-undo.
      256         define variable vend    as datetime-tz no-undo.
      257         define variable vint as int64 no-undo.
      258         define variable vOk as logical no-undo.
      259         vStart = now.
      260         vend   = vStart.
      261         publish "WaitFramPause" (iInterval,output vOk).
      262         vend   =  now.
      263         vint = vend - vStart.
      264         vint = iInterval - vint / 1000.
      265         if     not mWaitFramStop
      266            and (   vint > 0
      267                 or (    not vOk
      268                     and iInterval eq ?
      269                     )
      270                 )
      271         then
      272            run waitfram-show-this (iInterval).
      273         vend   =  now.
      274         vint = vend - vStart.
      275         vint = iInterval - vint / 1000.
      276         if     not mWaitFramStop
      277            and vint > 0
      278         then do:
      279            run gbl/pause.p (vint * 1000).
      280         end.
      281         if iInterval ne ?
      282         then
      283            publish "WaitFramStop".
      284         waitfram-check-timeout().
      285      end.
      286      procedure WaitFramWaitFor:
      287         define input  parameter iInterval as dec no-undo.
      288         assign
      289            mWaitFramStartProc   = now
      290            mWaitFramStopUser    = no
      291            mWaitFramStopTimeOut = no
      292         .
      293         block-wait:
      294         do while not mWaitFramStop:
      295            run WaitFramRunPause (iInterval).
      296            if  waitfram-check-timeout()
      297            then do:
      298               leave block-wait.
      299            end.
      300         end.
      301         run waitfram-hide.
      302      end.
      303   procedure waitfram-join :
      304     define input  parameter p-line-1  as character no-undo .
      305     define input  parameter p-line-2  as character no-undo .
      306     define input  parameter p-line-3  as character no-undo .
      307     define output parameter p-message as character no-undo .
      308     do
      309     on error undo, return error return-value
      310     :
      311       assign
      312         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      313                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      314                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      315       .
      316     end.
      317   end procedure.
      318   function waitfram-join-function returns character
      319     (input p-line-1 as character
      320     ,input p-line-2 as character
      321     ,input p-line-3 as character
      322     ).
      323     define variable v-message as character no-undo .
      324     run waitfram-join in this-procedure
      325       (input  p-line-1
      326       ,input  p-line-2
      327       ,input  p-line-3
      328       ,output v-message
      329       ) .
      330     return v-message .
      331   end function .
      332   define new global shared variable g#language as character no-undo .
      333   if g#language <> '' and g#language <> 'rus':U then do:
      334     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      335   end.
      336   define new global shared variable g#library  as handle no-undo .
      337   define new global shared variable g#library2 as handle no-undo .
      338   define   shared variable g#auto as logical no-undo.
      339   define   shared variable g#news as logical no-undo.
      340   define   shared variable g#oxml as logical no-undo.
      341   define   shared variable g#esys as logical no-undo.
      342   define   shared variable g#news-source-db as integer no-undo.
      343   define   shared variable g#esys-source-esys as integer no-undo.
      344   define   shared variable g#db-num as integer   no-undo .
      345   define   shared variable g#userid as character no-undo .
      346   define   shared variable g#passwd as character no-undo .
      347   procedure proc-alt-shift-f2:
      348     if not ibs.th.gbl.gbl-var:rcode
      349   then
      350     run gbl\inidebug.p .
      351   end.
      352   procedure proc-alt-shift-f3:
      353     run gbl/prvssinf.p
      354       ( input this-procedure
      355       ) .
      356   end.
      357   define variable v-inform-launched as logical no-undo initial false .
      358   procedure proc-alt-shift-f4:
      359     define variable v-action as character no-undo .
      360     if v-inform-launched = false then do:
      361       assign
      362         v-inform-launched = true
      363       .
      364       run gbl/d-inform.w
      365         (  input self
      366         ,  input this-procedure
      367         , output v-action
      368         ) no-error .
      369       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      370       assign
      371         v-inform-launched = false
      372       .
      373     end.
      374   end.
      375   procedure proc-alt-f1:
      376     run gbl/corrhelp.p
      377       (input this-procedure
      378       ) .
      379   end .
      380   on alt-shift-f2 anywhere do:
      381     run proc-alt-shift-f2.
      382   end.
      383   on alt-shift-f3 anywhere do:
      384     run proc-alt-shift-f3 in this-procedure .
      385   end.
      386   on alt-shift-f4 anywhere do:
      387     run proc-alt-shift-f4 in this-procedure.
      388   end.
      389   on alt-f1 anywhere do:
      390     run proc-alt-f1 in this-procedure .
      391   end.
      392   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      393   FUNCTION mark-string RETURNS CHARACTER
      394     ( input p-recid as recid, input mark-list as character  ) :
      395     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      396   END FUNCTION.
      397   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      398   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      399   procedure cur-time :
      400      define output parameter p-today as date      no-undo .
      401      define output parameter p-time  as integer   no-undo .
      402     do
      403     on error undo, return error
      404     :
      405       define variable v-date1 as date      no-undo .
      406       define variable v-date2 as date      no-undo .
      407       define variable v-time  as integer   no-undo .
      408       assign
      409         v-date1 = today
      410         v-time  = time
      411         v-date2 = today
      412       .
      413       if v-date1 <> v-date2
      414       then do:
      415         assign
      416           v-date1 = today
      417           v-time  = v-time
      418         .
      419       end.
      420       assign
      421         p-today = v-date1
      422         p-time  = v-time
      423       .
      424     end.
      425   end.
      426   function cur-time-date returns character
      427   :
      428     return string(today, '99/99/9999':U) .
      429   end.
      430   function cur-time-mjd returns decimal
      431   :
      432     define variable v-date as date      no-undo .
      433     define variable v-time as integer   no-undo .
      434     run cur-time in this-procedure
      435       (output v-date
      436       ,output v-time
      437       ) .
      438     return integer(v-date) - 2400002 + (v-time / 86400) .
      439   end.
      440   function cur-time-get-ending-index returns integer
      441   (input p-number as integer
      442   )
      443   :
      444     if p-number < 0
      445     or p-number = ?
      446     then do:
      447       return 1 .
      448     end.
      449     define variable v-rest as integer   no-undo .
      450     assign
      451       p-number = p-number modulo 100
      452     .
      453     if p-number < 20
      454     then do:
      455       assign
      456         v-rest = p-number
      457       .
      458     end.
      459     else do:
      460       assign
      461         v-rest = p-number modulo 10
      462       .
      463     end.
      464     case v-rest :
      465       when 1
      466       then do:
      467         return 2 .
      468       end.
      469       when 2 or
      470       when 3 or
      471       when 4
      472       then do:
      473         return 3 .
      474       end.
      475       otherwise do:
      476         return 1 .
      477       end.
      478     end case .
      479   end.
      480   procedure cur-time-mjd-to-date :
      481      define input  parameter i-mjd-diff as decimal no-undo.
      482      define output parameter o-Date     as date    no-undo.
      483      define output parameter o-Time     as integer no-undo.
      484      define variable v-day-number as integer   no-undo .
      485      if    i-mjd-diff < 0
      486         or i-mjd-diff = ?
      487      then do:
      488         return "?" .
      489      end.
      490      assign
      491         v-day-number = truncate(i-mjd-diff,0).
      492         o-Date = date(v-day-number + 2400002).
      493         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      494     .
      495   end.
      496   function cur-time-mjd-to-string returns character
      497   (input p-mjd-diff as decimal
      498   )
      499   :
      500     define variable v-day-number as integer   no-undo .
      501     define variable v-seconds    as integer   no-undo .
      502     define variable v-hour       as integer   no-undo .
      503     define variable v-min        as integer   no-undo .
      504     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      505     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      506     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      507     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      508     if p-mjd-diff < 0
      509     or p-mjd-diff = ?
      510     then do:
      511       return "?" .
      512     end.
      513     assign
      514       v-day-number = integer(truncate(p-mjd-diff,0))
      515       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      516     .
      517     if v-seconds > 86400
      518     then do:
      519       assign
      520         v-seconds = 86400 - 1
      521       .
      522     end.
      523     if v-seconds < 0
      524     then do:
      525       assign
      526         v-seconds = 0
      527       .
      528     end.
      529     assign
      530       v-hour = truncate(v-seconds / 3600, 0)
      531     .
      532     assign
      533       v-seconds = v-seconds modulo 3600
      534     .
      535     assign
      536       v-min = truncate(v-seconds / 60, 0)
      537     .
      538     assign
      539       v-seconds = v-seconds modulo 60
      540     .
      541     return
      542         (if v-day-number <> 0
      543           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      544           else ""
      545         )
      546       + (if v-day-number <> 0 or v-hour <> 0
      547           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      548           else ""
      549         )
      550       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      551           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      552           else ""
      553         )
      554       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      555       .
      556   end.
      557   function cur-time-string returns character
      558   :
      559     define variable v-date as date      no-undo .
      560     define variable v-time as integer   no-undo .
      561     run cur-time in this-procedure
      562       (output v-date
      563       ,output v-time
      564       ) .
      565     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      566   end.
      567   function cur-time-string-sec returns character
      568   :
      569     define variable v-date as date      no-undo .
      570     define variable v-time as integer   no-undo .
      571     run cur-time in this-procedure
      572       (output v-date
      573       ,output v-time
      574       ) .
      575     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      576   end.
      577   function cur-time-custom  returns character
      578   (input p-prefix as character
      579   ,input p-date-format as character
      580   ,input p-delimiter as character
      581   ,input p-time-format as character
      582   ,input p-suffix as character
      583   )
      584   :
      585     define variable v-date as date      no-undo .
      586     define variable v-time as integer   no-undo .
      587     run cur-time in this-procedure
      588       (output v-date
      589       ,output v-time
      590       ) .
      591     return
      592       p-prefix
      593       + string(v-date, p-date-format)
      594       + p-delimiter
      595       + string(v-time, p-time-format)
      596       + p-suffix
      597       .
      598   end.
      599   function cur-time-print  returns character
      600   :
      601     define variable v-date as date      no-undo .
      602     define variable v-time as integer   no-undo .
      603     run cur-time in this-procedure
      604       (output v-date
      605       ,output v-time
      606       ) .
      607     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      608   end.
      609   function cur-time-datetime returns datetime
      610   :
      611     define variable v-char as character no-undo .
      612     define variable v-datetime as datetime no-undo .
      613     v-char = cur-time-string().
      614     v-datetime = datetime(v-char).
      615     return  v-datetime.
      616   end.
      617   function cur-time-string-msec returns character
      618   :
      619     define variable v-date as datetime  no-undo .
      620     v-date = now.
      621     return string(v-date) .
      622   end.
      623   DEFINE VARIABLE v-cli-name AS CHARACTER NO-UNDO.
      624   DEFINE VARIABLE v-mark AS CHARACTER NO-UNDO.
      625   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      626   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      627   DEFINE VARIABLE v-db-num LIKE ub.db.db-num NO-UNDO.
      628   DEFINE VARIABLE v-base-code LIKE ub.sysconf.base-code NO-UNDO.
      629   DEFINE VARIABLE lock-doc as logical no-undo.
      630   DEFINE VARIABLE add-option AS CHARACTER NO-UNDO.
      631   DEFINE VARIABLE v-first AS LOGICAL NO-UNDO init yes.
      632   define variable sort-column-name as character no-undo .
      633   define variable v-doc-rec as recid no-undo .
      634   define variable v-limit-access as integer no-undo .
      635   FUNCTION get-cli-name RETURNS CHARACTER
      636     (BUFFER buf_fin-statement-line FOR ub.fin-statement-line )  FORWARD.
      637   DEFINE MENU MENU-B-add
      638          MENU-ITEM m_no-th        LABEL "Неучтенный в TH платеж"
      639          MENU-ITEM m_income       LABEL "Приход"
      640          MENU-ITEM m_expense      LABEL "Расход"        .
      641   DEFINE BUTTON B-add
      642        LABEL "&Добавить"
      643        SIZE 10 BY 1.
      644   DEFINE BUTTON B-del
      645        LABEL "&Удалить"
      646        SIZE 10 BY 1.
      647   DEFINE BUTTON B-exit AUTO-GO
      648        LABEL "&Ввод"
      649        SIZE 10 BY 1
      650        BGCOLOR 8 .
      651   DEFINE BUTTON B-Help
      652        LABEL "Помо&щь"
      653        SIZE 10 BY 1
      654        BGCOLOR 8 .
      655   DEFINE BUTTON B-hist
      656        LABEL "&История"
      657        SIZE 10 BY 1.
      658   DEFINE BUTTON B-lookup
      659        LABEL "&Просмотр"
      660        SIZE 10 BY 1.
      661   DEFINE BUTTON B-mark
      662        LABEL "&*"
      663        SIZE 3 BY 1.
      664   DEFINE BUTTON B-print
      665        LABEL "Пе&чать"
      666        SIZE 10 BY 1.
      667   DEFINE BUTTON B-quit AUTO-END-KEY
      668        LABEL "&Отмена"
      669        SIZE 10 BY 1
      670        BGCOLOR 8 .
      671   DEFINE BUTTON B-schet
      672        IMAGE-UP FILE "btn-down-arrow":U
      673        IMAGE-DOWN FILE "btn-down-arrow":U
      674        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      675        LABEL "Btn 1"
      676        SIZE 3 BY 1.
      677   DEFINE VARIABLE e-line-ps AS CHARACTER
      678        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      679        SIZE 49 BY 4 NO-UNDO.
      680   DEFINE VARIABLE f-bank AS CHARACTER FORMAT "X(256)":U INITIAL "Счет"
      681         VIEW-AS TEXT
      682        SIZE 4.4 BY .77
      683        FGCOLOR 4  NO-UNDO.
      684   DEFINE VARIABLE f-bank-data AS CHARACTER FORMAT "X(256)":U INITIAL "Данные банка"
      685         VIEW-AS TEXT
      686        SIZE 12.5 BY .77
      687        FGCOLOR 9  NO-UNDO.
      688   DEFINE VARIABLE F-curr-abbr AS CHARACTER FORMAT "X(256)":U
      689         VIEW-AS TEXT
      690        SIZE 4 BY .67
      691        FGCOLOR 4  NO-UNDO.
      692   DEFINE VARIABLE f-th-data AS CHARACTER FORMAT "X(256)":U INITIAL "Док-ты TH"
      693         VIEW-AS TEXT
      694        SIZE 11 BY .77
      695        FGCOLOR 4  NO-UNDO.
      696   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      697         VIEW-AS TEXT
      698        SIZE 6 BY 1
      699        FGCOLOR 4  NO-UNDO.
      700   DEFINE QUERY BR-lines FOR
      701         locked_fin-statement-line SCROLLING.
      702   DEFINE BROWSE BR-lines
      703     QUERY BR-lines NO-LOCK DISPLAY
      704         mark-string(recid(locked_fin-statement-line), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U WIDTH 1
      705   locked_fin-statement-line.line-num COLUMN-LABEL "Строка" FORMAT ">,>>9":U
      706   locked_fin-statement-line.prn-doc-code FORMAT "X(16)":U
      707   locked_fin-statement-line.fin-doc-code COLUMN-LABEL "Внутр.№" FORMAT "999999999":U
      708   locked_fin-statement-line.fin-ext-doc-type COLUMN-LABEL "Тип" FORMAT "X(8)":U
      709       WIDTH 8
      710   locked_fin-statement-line.sum-doc FORMAT ">,>>>,>>>,>>>,>>9.99":U
      711   get-cli-name(BUFFER locked_fin-statement-line) @ v-cli-name COLUMN-LABEL "Контрагент" FORMAT "X(20)":U WIDTH 21
      712   ENABLE
      713   locked_fin-statement-line.prn-doc-code
      714       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8.27 FIT-LAST-COLUMN.
      715   DEFINE FRAME Dialog-Frame
      716        B-exit AT ROW 1 COL 1
      717        B-quit AT ROW 1 COL 11
      718        B-mark AT ROW 1 COL 29
      719        B-add AT ROW 1 COL 39
      720        B-lookup AT ROW 1 COL 49
      721        B-del AT ROW 1 COL 59
      722        B-print AT ROW 1 COL 69
      723        B-hist AT ROW 1 COL 79
      724        B-Help AT ROW 1 COL 89
      725        tt-fin-statement.prn-doc-code AT ROW 2 COL 1
      726             LABEL "№" FORMAT "X(22)"
      727             VIEW-AS FILL-IN
      728             SIZE 25.5 BY 1
      729             FGCOLOR 4
      730        tt-fin-statement.num-docs AT ROW 2 COL 67 COLON-ALIGNED NO-LABEL
      731             VIEW-AS FILL-IN
      732             SIZE 9 BY 1
      733        tt-fin-statement.num-docs-th AT ROW 2 COL 88 COLON-ALIGNED NO-LABEL
      734             VIEW-AS FILL-IN
      735             SIZE 9 BY 1
      736        tt-fin-statement.sttm-code AT ROW 3 COL 8 COLON-ALIGNED
      737             LABEL "Внутр.№" FORMAT "999999999"
      738             VIEW-AS FILL-IN
      739             SIZE 10.4 BY 1
      740        tt-fin-statement.doc-date AT ROW 3 COL 21.5
      741             LABEL "Дата сост." FORMAT "99/99/9999"
      742             VIEW-AS FILL-IN
      743             SIZE 11 BY 1
      744             FGCOLOR 4
      745        tt-fin-statement.start-sum-doc AT ROW 3 COL 54.5 COLON-ALIGNED
      746             LABEL "Вход.ост." FORMAT "->,>>>,>>>,>>>,>>9.99"
      747             VIEW-AS FILL-IN
      748             SIZE 21 BY 1
      749             FGCOLOR 9
      750        tt-fin-statement.start-sum-doc-th AT ROW 3 COL 76 COLON-ALIGNED NO-LABEL FORMAT "->,>>>,>>>,>>>,>>9.99"
      751             VIEW-AS FILL-IN
      752             SIZE 21 BY 1
      753             FGCOLOR 4
      754        tt-fin-statement.bank-date AT ROW 4 COL 31.5 COLON-ALIGNED
      755             LABEL "Дата банк" FORMAT "99/99/9999"
      756             VIEW-AS FILL-IN
      757             SIZE 11 BY 1
      758        tt-fin-statement.in-sum-doc AT ROW 4 COL 54.5 COLON-ALIGNED
      759             LABEL "Приход" FORMAT "->,>>>,>>>,>>>,>>9.99"
      760             VIEW-AS FILL-IN
      761             SIZE 21 BY 1
      762             FGCOLOR 9
      763        tt-fin-statement.in-sum-doc-th AT ROW 4 COL 76 COLON-ALIGNED NO-LABEL FORMAT "->,>>>,>>>,>>>,>>9.99"
      764             VIEW-AS FILL-IN
      765             SIZE 21 BY 1
      766             FGCOLOR 4
      767        tt-fin-statement.fact-date AT ROW 5 COL 31.5 COLON-ALIGNED
      768             LABEL "Дата факт" FORMAT "99/99/9999"
      769             VIEW-AS FILL-IN
      770             SIZE 11 BY 1
      771             FGCOLOR 4
      772        tt-fin-statement.out-sum-doc AT ROW 5 COL 54.5 COLON-ALIGNED
      773             LABEL "Расход" FORMAT "->,>>>,>>>,>>>,>>9.99"
      774             VIEW-AS FILL-IN
      775             SIZE 21 BY 1
      776             FGCOLOR 9
      777        tt-fin-statement.out-sum-doc-th AT ROW 5 COL 76 COLON-ALIGNED NO-LABEL FORMAT "->,>>>,>>>,>>>,>>9.99"
      778             VIEW-AS FILL-IN
      779             SIZE 21 BY 1
      780             FGCOLOR 4
      781        tt-fin-statement.start-date AT ROW 6 COL 15 COLON-ALIGNED
      782             LABEL "С" FORMAT "99/99/9999"
      783             VIEW-AS FILL-IN
      784             SIZE 11 BY 1
      785             FGCOLOR 4
      786        tt-fin-statement.end-date AT ROW 6 COL 31.5 COLON-ALIGNED
      787             LABEL "по" FORMAT "99/99/9999"
      788             VIEW-AS FILL-IN
      789             SIZE 11 BY 1
      790             FGCOLOR 4
      791        tt-fin-statement.end-sum-doc AT ROW 6 COL 54.5 COLON-ALIGNED
      792             LABEL "Исход.ост." FORMAT "->,>>>,>>>,>>>,>>9.99"
      793             VIEW-AS FILL-IN
      794             SIZE 21 BY 1
      795             FGCOLOR 9
      796        tt-fin-statement.end-sum-doc-th AT ROW 6 COL 76 COLON-ALIGNED NO-LABEL FORMAT "->,>>>,>>>,>>>,>>9.99"
      797             VIEW-AS FILL-IN
      798             SIZE 21 BY 1
      799             FGCOLOR 4
      800        B-schet AT ROW 7 COL 6
      801        BR-lines AT ROW 9 COL 1
      802       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      803            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      804            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit.
      805   DEFINE FRAME Dialog-Frame
      806        e-line-ps AT ROW 18 COL 1 NO-LABEL
      807        tt-fin-statement.PS AT ROW 18 COL 50 NO-LABEL
      808             VIEW-AS EDITOR SCROLLBAR-VERTICAL
      809             SIZE 49 BY 4 TOOLTIP "Дополнительная информация"
      810        mark-num AT ROW 1 COL 30.5 COLON-ALIGNED NO-LABEL
      811        f-bank-data AT ROW 2 COL 56.5 NO-LABEL
      812        f-th-data AT ROW 2 COL 78 NO-LABEL
      813        tt-fin-statement.curr-code AT ROW 5 COL 1
      814             LABEL "Вал" FORMAT ">>9"
      815              VIEW-AS TEXT
      816             SIZE 4 BY .67
      817        F-curr-abbr AT ROW 5 COL 6 COLON-ALIGNED NO-LABEL
      818        f-bank AT ROW 7 COL 1 NO-LABEL
      819        tt-fin-statement.r-schet AT ROW 7 COL 8 COLON-ALIGNED NO-LABEL FORMAT "X(20)"
      820              VIEW-AS TEXT
      821             SIZE 21 BY .67
      822             FGCOLOR 4
      823        tt-fin-statement.bank-name AT ROW 7 COL 30 COLON-ALIGNED NO-LABEL FORMAT "X(100)"
      824              VIEW-AS TEXT
      825             SIZE 50 BY .67
      826        tt-fin-statement.bik AT ROW 8.2 COL 8 COLON-ALIGNED
      827             LABEL "БИК" FORMAT "X(9)"
      828              VIEW-AS TEXT
      829             SIZE 10 BY .67
      830             FGCOLOR 4
      831        tt-fin-statement.bank-city AT ROW 8.2 COL 29 COLON-ALIGNED
      832             LABEL "Город"
      833              VIEW-AS TEXT
      834             SIZE 25.5 BY .67
      835        "Примечания к выписке" VIEW-AS TEXT
      836             SIZE 29.5 BY .67 AT ROW 17.33 COL 50
      837             FGCOLOR 4 FONT 4
      838        "Примечания к строке выписки" VIEW-AS TEXT
      839             SIZE 29.5 BY .67 AT ROW 17.33 COL 1.5
      840             FONT 4
      841        SPACE(67.99) SKIP(4.02)
      842       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      843            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      844            TITLE "Выписка №"
      845            DEFAULT-BUTTON B-exit CANCEL-BUTTON B-quit.
      846   ASSIGN
      847          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      848          FRAME Dialog-Frame:HIDDEN           = TRUE.
      849   ASSIGN
      850          B-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-add:HANDLE.
      851   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      852   DO:
      853     APPLY "END-ERROR":U TO SELF.
      854   END.
      855   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      856   DO:
      857     if add-option = '':U then do:
      858       run gbl/pop-up.p ( input self:handle, no) no-error.
      859     end.
      860     if add-option = '':U then return no-apply.
      861     run proc-b-add in this-procedure ( input add-option) no-error.
      862     add-option = '':U.
      863     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
      864   END.
      865   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      866   DO:
      867     DEFINE VARIABLE loc#log AS LOGICAL NO-UNDO.
      868     DEFINE VARIABLE v-loc-rid-list AS character NO-UNDO.
      869     IF NOT AVAILABLE LOCKED_fin-statement-line AND v-rid-list = '':U THEN RETURN NO-APPLY.
      870     CASE v-rid-list:
      871         WHEN '':U THEN DO:
      872             MESSAGE
      873             substitute("Вы действительно хотите удалить из выписки платеж &1 (внутр. №&2)"
      874                        , LOCKED_fin-statement-line.prn-doc-code
      875                        , LOCKED_fin-statement-line.fin-doc-code)
      876             VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE loc#log.
      877             IF NOT loc#log THEN  RETURN no-apply.
      878             v-loc-rid-list = string(RECID(LOCKED_fin-statement-line)).
      879         END.
      880         OTHERWISE DO:
      881             MESSAGE
      882             substitute("Вы действительно хотите удалить из выписки отмеченные платежи")
      883             VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE loc#log.
      884             IF NOT loc#log THEN  RETURN no-apply.
      885            v-loc-rid-list = v-rid-list.
      886        END.
      887     END CASE.
      888     RUN proc-b-del IN THIS-PROCEDURE( input v-loc-rid-list) NO-ERROR.
      889     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      890   END.
      891   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      892   DO:
      893     IF p-mode = 'ПРОСМОТР':U THEN DO:
      894         RETURN NO-APPLY.
      895     END.
      896     RUN proc-save IN THIS-PROCEDURE ( INPUT lock-doc) no-error.
      897     IF ERROR-STATUS:ERROR THEN DO:
      898         RETURN NO-APPLY.
      899     END.
      900     p-doc-rec = v-doc-rec.
      901   END.
      902   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
      903   DO:
      904     IF NOT AVAILABLE LOCKED_fin-statement-line THEN RETURN NO-APPLY.
      905     IF locked_fin-statement-line.fin-doc-code = 0 THEN DO:
      906         MESSAGE
      907         "К данной строке платеж в системе не привязан!" SKIP
      908         "Просмотр невозможен!"
      909         VIEW-AS ALERT-BOX.
      910     END.
      911     run ref/showfind.p
      912                     (INPUT  parParentProc
      913                      ,input p-curr-host-code
      914                      ,input p-host-code
      915                      ,input locked_fin-statement-line.fin-doc-code) NO-ERROR.
      916   END.
      917   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      918   DO:
      919   define variable loc#log as logical no-undo .
      920     if available locked_fin-statement then do:
      921   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      922   define variable v-str-recid5 as character no-undo .
      923   define variable v-num-entry5 as integer   no-undo .
      924   assign
      925     v-str-recid5 = trim( string( recid( locked_fin-statement ) , "->>>>>>>>>>>9":U ) )
      926     v-num-entry5 = lookup( v-str-recid5 , v-rid-list )
      927   .
      928   if v-num-entry5 > 0 then do:
      929     assign
      930       entry( v-num-entry5, v-rid-list ) = "":U
      931       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      932     .
      933   end.
      934   else do:
      935     assign
      936       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid5
      937     .
      938   end.
      939       loc#log = br-lines:refresh() .
      940       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      941           loc#log = br-lines:select-next-row ().
      942           apply "VALUE-CHANGED" to br-lines in frame Dialog-Frame.
      943       end.
      944       if num-entries( v-rid-list ) = 0
      945       then
      946           hide mark-num in frame Dialog-Frame.
      947       else
      948           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      949     end.
      950     apply "entry" to br-lines in frame Dialog-Frame.
      951   END.
      952   ON CHOOSE OF B-print IN FRAME Dialog-Frame
      953   DO:
      954   define variable v-format as integer no-undo .
      955   define variable v-cmp as character no-undo .
      956   define variable v-log as logical no-undo .
      957   buffer-compare tt-fin-statement to locked_fin-statement
      958   case-sensitive
      959   save result in v-cmp .
      960   if v-cmp <> "":U then do:
      961      run proc-save in this-procedure ( input v-log) no-error.
      962   end.
      963   if error-status:error then return no-apply.
      964   END.
      965   ON CHOOSE OF B-quit IN FRAME Dialog-Frame
      966   DO:
      967   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      968   if lookup(self :type
      969            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      970            ) = 0
      971   then do:
      972     message
      973       "$Workfile$"
      974       "Указанному интерфейсному элементу фокус не может быть передан" skip
      975       "Интерфейсный элемент" self :name  skip
      976       "Тип" self :type  skip
      977       "Процедура" this-procedure :file-name skip
      978       view-as alert-box .
      979   end.
      980   else do:
      981     apply "entry":u to self  .
      982     if focus :handle <> self :handle  then do:
      983       return no-apply .
      984     end.
      985   end.
      986     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      987     case p-mode:
      988       when 'ДОБАВЛЕНИЕ':U then do:
      989         if available locked_fin-statement
      990         AND locked_fin-statement.status_ = 'новый':U THEN DO:
      991           RUN control-line IN THIS-PROCEDURE ( OUTPUT lock-doc).
      992           IF lock-doc = NO THEN DO:
      993               MESSAGE
      994               "Вы уверены, что не хотите сохранить выписку?"
      995               VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE gLOG.
      996               IF glog THEN DO:
      997                 DELETE LOCKED_fin-statement.
      998                 p-doc-rec = ?.
      999               END.
     1000           END.
     1001           else do:
     1002             p-doc-rec = v-doc-rec.
     1003           end.
     1004         END.
     1005       end.
     1006     END CASE.
     1007   END.
     1008   ON CHOOSE OF B-schet IN FRAME Dialog-Frame
     1009   DO:
     1010   define variable v-rid-list as character no-undo.
     1011   define variable ref-rec as recid no-undo.
     1012   define variable v-status_ like ub.fin-schet.status_ no-undo init 'тек':U.
     1013   define buffer buf_fin-schet for ub.fin-schet .
     1014   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1015   if lookup(self :type
     1016            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1017            ) = 0
     1018   then do:
     1019     message
     1020       "$Workfile$"
     1021       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1022       "Интерфейсный элемент" self :name  skip
     1023       "Тип" self :type  skip
     1024       "Процедура" this-procedure :file-name skip
     1025       view-as alert-box .
     1026   end.
     1027   else do:
     1028     apply "entry":u to self  .
     1029     if focus :handle <> self :handle  then do:
     1030       return no-apply .
     1031     end.
     1032   end.
     1033   if available X_fin-schet then
     1034   assign
     1035   v-rid-list = string(recid(X_fin-schet))
     1036   v-status_ = X_fin-schet.status_
     1037   .
     1038     run ref/finschts.w (
     1039                  INPUT parParentProc
     1040                 ,INPUT p-curr-host-code
     1041                 ,input "b-sel":U
     1042                 ,input "company-host":U
     1043                 ,input 'орг':U
     1044                 ,input p-host-code
     1045                 ,input ?
     1046                 ,input tt-fin-statement.host-code
     1047                 ,input 0
     1048                 ,input-output v-status_
     1049                 ,input-output v-rid-list
     1050   ) no-error.
     1051   if v-rid-list = "" then   do:
     1052     apply "entry" to b-schet in frame Dialog-Frame.
     1053     return no-apply.
     1054   end.
     1055    ref-rec = integer( v-rid-list ).
     1056   FIND FIRST buf_fin-schet WHERE
     1057         recid (buf_fin-schet) = ref-rec NO-LOCK  .
     1058   if buf_fin-schet.status_ <> 'тек':U then do:
     1059     message
     1060     "Статус выбранного Вами счета" buf_fin-schet.status_ " - нельзя работать с таким счетом"
     1061     view-as alert-box error .
     1062     return no-apply.
     1063   end.
     1064   FIND FIRST X_fin-schet WHERE
     1065         recid (X_fin-schet) = ref-rec NO-LOCK  .
     1066   find first X_fin-bank no-lock where
     1067             X_fin-bank.host-code = tt-fin-statement.host-code
     1068         AND X_fin-bank.code-bank = X_fin-schet.code-bank .
     1069     assign
     1070     tt-fin-statement.bank-name = X_fin-bank.bank-name
     1071     tt-fin-statement.bank-city = X_fin-bank.bank-city
     1072     tt-fin-statement.dop1      =  X_fin-schet.dop1
     1073     tt-fin-statement.dop2      =  X_fin-schet.dop2
     1074     tt-fin-statement.bik       =  X_fin-bank.bik
     1075     tt-fin-statement.r-schet   =  X_fin-schet.r-schet
     1076     tt-fin-statement.c-schet   =  X_fin-schet.c-schet
     1077     tt-fin-statement.code-schet = X_fin-schet.code-schet
     1078     tt-fin-statement.curr-code = X_fin-schet.curr-code
     1079     tt-fin-statement.code-bank = X_fin-schet.code-bank
     1080     .
     1081     display
     1082     tt-fin-statement.bank-name
     1083     tt-fin-statement.bank-city
     1084     tt-fin-statement.bik
     1085     tt-fin-statement.r-schet
     1086     tt-fin-statement.curr-code
     1087     with frame Dialog-Frame.
     1088     run control-line in this-procedure ( output lock-doc).
     1089     run lock-proc in this-procedure ( input lock-doc).
     1090     APPLY "Value-changed" TO tt-fin-statement.curr-code.
     1091   END.
     1092   ON VALUE-CHANGED OF BR-lines IN FRAME Dialog-Frame
     1093   DO:
     1094     IF AVAILABLE locked_fin-statement-line THEN DO:
     1095       ASSIGN e-line-ps:SCREEN-VALUE = locked_fin-statement-line.PS.
     1096     END.
     1097     ELSE DO:
     1098       ASSIGN e-line-ps:SCREEN-VALUE = '':U.
     1099     END.
     1100   END.
     1101   ON VALUE-CHANGED OF tt-fin-statement.curr-code IN FRAME Dialog-Frame
     1102   DO:
     1103     DEFINE BUFFER buf_currency FOR ub.currency.
     1104     FIND FIRST buf_currency NO-LOCK WHERE
     1105               buf_currency.curr-code = tt-fin-statement.curr-code NO-ERROR.
     1106     IF  AVAILABLE buf_currency THEN DO:
     1107         DISPLAY
     1108         buf_currency.curr-abbr @ f-curr-abbr
     1109         WITH FRAME Dialog-Frame.
     1110     END.
     1111     ELSE DO:
     1112         DISPLAY
     1113          ? @ f-curr-abbr
     1114          WITH FRAME Dialog-Frame.
     1115     END.
     1116   END.
     1117   ON CHOOSE OF MENU-ITEM m_expense
     1118   DO:
     1119       assign
     1120     add-option = 'рпп':U.
     1121     APPLY "CHOOSE" to b-add  in frame Dialog-Frame.
     1122   END.
     1123   ON CHOOSE OF MENU-ITEM m_income
     1124   DO:
     1125       assign
     1126     add-option = 'ппп':U.
     1127     APPLY "CHOOSE" to b-add  in frame Dialog-Frame.
     1128   END.
     1129   ON CHOOSE OF MENU-ITEM m_no-th
     1130   DO:
     1131     assign
     1132     add-option = "no-th".
     1133     APPLY "CHOOSE" to b-add  in frame Dialog-Frame.
     1134   END.
     1135   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1136   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1137   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1138   on help of frame Dialog-Frame
     1139   do:
     1140     run gbl/app_help.p
     1141       (input this-procedure :file-name
     1142       ,input ''
     1143       ,input ?
     1144       ) no-error.
     1145     if error-status :error then do:
     1146       message
     1147         "Ошибка при вызове помощи"
     1148         error-status :get-message(1)
     1149         view-as alert-box .
     1150     end.
     1151   end.
     1152   run minbtn-set in this-procedure .
     1153   on choose of b-help in frame Dialog-Frame
     1154   do:
     1155     apply "help":u to frame Dialog-Frame .
     1156   end.
     1157   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1158   procedure minbtn-set :
     1159       do
     1160           on error undo, return error return-value
     1161           :
     1162           define variable ii              as integer       no-undo .
     1163           define variable fh              as widget-handle no-undo .
     1164           define variable hh              as widget-handle no-undo .
     1165           define variable v-h             as handle        extent 4 no-undo .
     1166           define variable v-name-button   as character     no-undo .
     1167           define variable v-help-old-x    as decimal       no-undo .
     1168           define variable v-help-old-y    as decimal       no-undo .
     1169           define variable v-help-old-size as decimal       no-undo .
     1170           define variable v-frame-width   as decimal       no-undo .
     1171           define variable jj              as integer       no-undo .
     1172           do
     1173               on error undo, return error
     1174               :
     1175               assign
     1176                   v-frame-width = frame Dialog-Frame:width - 0.3
     1177                   fh            = frame Dialog-Frame:first-child
     1178                   hh            = fh:first-child
     1179                   ii            = 1
     1180                   .
     1181               do while valid-handle(hh):
     1182                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1183                   do:
     1184                       case lc(hh:name) :
     1185                           when "b-help" then
     1186                               do:
     1187                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1188                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1189                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1190                                   hh:TOOLTIP = "Помощь" .
     1191                                   v-help-old-x = hh:column .
     1192                                   v-help-old-y = hh:row    .
     1193                                   v-help-old-size = hh:width .
     1194                                   hh:width-chars = 2.5 .
     1195                               end.
     1196                           when "b-print" then
     1197                               do:
     1198                                   hh:load-image("cmp/b-print.bmp":u) .
     1199                                   hh:TOOLTIP = "Печать" .
     1200                                   v-h[ii] = hh:handle .
     1201                                   ii = ii + 1 .
     1202                                   hh:width-chars = 3 .
     1203                               end.
     1204                           when "b-history" or
     1205                           when "b-hist" then
     1206                               do:
     1207                                   hh:load-image("cmp/b-hist.bmp":u) .
     1208                                   hh:TOOLTIP = "История" .
     1209                                   v-h[ii] = hh:handle .
     1210                                   ii = ii + 1 .
     1211                                   hh:width-chars = 3 .
     1212                               end.
     1213                           when "b-sch" then
     1214                               do:
     1215                                   hh:load-image("cmp/b-sch.bmp":u) .
     1216                                   hh:TOOLTIP = "Установка Фильтра" .
     1217                                   v-h[ii] = hh:handle .
     1218                                   ii = ii + 1 .
     1219                                   hh:width-chars = 3 .
     1220                               end.
     1221                           when "b-hist-user" then
     1222                               do:
     1223                                   hh:load-image("cmp/b-hist.bmp":u) .
     1224                                   hh:TOOLTIP = "История пользователя" .
     1225                                   ii = ii + 1 .
     1226                               end.
     1227                       end case.
     1228                   end.
     1229                   hh = hh:next-sibling.
     1230               end.
     1231               b-help:column = v-frame-width - b-help:width-chars.
     1232               jj = 0.
     1233               repeat ii = 4 to 1 by -1 :
     1234                   if valid-handle (v-h[ii] ) then
     1235                   do:
     1236                       jj  = jj + 1 .
     1237                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1238                       v-h[ii]:row    = v-help-old-y .
     1239                   end.
     1240               end.
     1241           end.
     1242       end.
     1243   end procedure.
     1244   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1245   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1246   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1247   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1248   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1249   define variable v-diasize-current-frame-height as decimal   no-undo .
     1250   define variable v-diasize-change-size          as logical   no-undo .
     1251   define variable v-diasize-resize-button        as handle    no-undo .
     1252   define variable v-diasize-wndmax               as logical   no-undo .
     1253   define variable v-diasize-wndstore             as logical   no-undo .
     1254   define variable v-diasize-proc-name            as character no-undo .
     1255   define variable v-diasize-browse-handle        as handle    no-undo .
     1256   define variable v-diasize-browse-number        as integer   no-undo .
     1257   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1258   define temp-table temp-diasize-handle no-undo
     1259     field handle-value  as handle
     1260     field save-position as decimal
     1261     index xpk is primary unique handle-value
     1262     .
     1263   define temp-table temp-browse-handle no-undo
     1264     field browse-type   as character
     1265     field browse-number as integer
     1266     field browse-handle as handle
     1267     field original-size as decimal
     1268     index xpk is primary unique browse-type browse-number
     1269     index xie browse-type browse-handle
     1270   .
     1271   procedure diasize_change-height :
     1272     define input  parameter p-change-value  as decimal   no-undo .
     1273     define input  parameter p-move-resize   as logical   no-undo .
     1274     define variable v-field-group-handle    as handle    no-undo .
     1275     define variable v-object-handle         as handle    no-undo .
     1276     define variable v-frame-height          as decimal   no-undo .
     1277     define variable v-frame-virtual-height  as decimal   no-undo .
     1278     define variable v-browse-height         as decimal   no-undo .
     1279     define variable v-window-height         as decimal   no-undo .
     1280     define variable v-window-virtual-height as decimal   no-undo .
     1281     define variable v-change-sign           as integer   no-undo .
     1282     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1283     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1284     if p-change-value > 0
     1285     then do:
     1286       if frame Dialog-Frame :height + p-change-value
     1287           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1288       then do:
     1289         assign
     1290           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1291                           - (frame Dialog-Frame :height-chars)
     1292         .
     1293         if p-change-value <= 0
     1294         then do:
     1295           run diasize_position-resize-button in this-procedure .
     1296           return .
     1297         end.
     1298       end.
     1299     end.
     1300     if p-change-value < 0
     1301     then do:
     1302       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1303       then do:
     1304         assign
     1305           p-change-value = v-diasize-orig-frame-height
     1306                          - (frame Dialog-Frame :height-chars)
     1307         .
     1308         if p-change-value >= 0
     1309         then do:
     1310           run diasize_position-resize-button in this-procedure .
     1311           return .
     1312         end.
     1313       end.
     1314     end.
     1315     if p-change-value >= 0
     1316     then do:
     1317       assign
     1318         v-change-sign = 1
     1319       .
     1320     end.
     1321     else do:
     1322       assign
     1323         v-change-sign = -1
     1324       .
     1325     end.
     1326     assign
     1327       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1328     .
     1329     if p-change-value = 0
     1330     then do:
     1331       run diasize_position-resize-button in this-procedure .
     1332       return .
     1333     end.
     1334     move_block:
     1335     do
     1336     on error undo move_block, retry move_block
     1337     :
     1338       if retry
     1339       then do:
     1340         do
     1341         on error undo move_block, leave move_block
     1342         :
     1343           if p-change-value > 0
     1344           then do:
     1345             for each buf_temp-diasize-handle
     1346             on error undo, next
     1347             :
     1348               assign
     1349                 v-object-handle = buf_temp-diasize-handle.handle-value
     1350               .
     1351               if v-object-handle <> v-diasize-resize-button
     1352               then do:
     1353                 assign
     1354                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1355                 .
     1356               end.
     1357             end.
     1358             assign
     1359               v-diasize-browse-handle :height = v-browse-height
     1360             .
     1361             for each buf_temp-browse-handle
     1362               where buf_temp-browse-handle.browse-type = 'height':u
     1363             on error undo, next
     1364             :
     1365               assign
     1366                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1367               .
     1368             end.
     1369             assign
     1370               frame Dialog-Frame :height = v-frame-height
     1371             .
     1372             if frame Dialog-Frame :scrollable = true
     1373             then do:
     1374               assign
     1375                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1376               .
     1377             end.
     1378             run diasize_position-resize-button in this-procedure .
     1379           end.
     1380           else do:
     1381             if frame Dialog-Frame :scrollable = true
     1382             then do:
     1383               assign
     1384                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1385               .
     1386             end.
     1387             assign
     1388               frame Dialog-Frame :height = v-frame-height
     1389             .
     1390             assign
     1391               v-diasize-browse-handle :height = v-browse-height
     1392             .
     1393             for each buf_temp-browse-handle
     1394               where buf_temp-browse-handle.browse-type = 'height':u
     1395             on error undo, next
     1396             :
     1397               assign
     1398                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1399               .
     1400             end.
     1401             for each buf_temp-diasize-handle
     1402             on error undo, next
     1403             :
     1404               assign
     1405                 v-object-handle = buf_temp-diasize-handle.handle-value
     1406               .
     1407               if v-object-handle <> v-diasize-resize-button
     1408               then do:
     1409                 assign
     1410                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1411                 .
     1412               end.
     1413             end.
     1414             run diasize_position-resize-button in this-procedure .
     1415           end.
     1416           assign
     1417             v-diasize-change-size = false
     1418           .
     1419           leave move_block .
     1420         end.
     1421       end.
     1422       assign
     1423         v-diasize-need-full-display = true
     1424       .
     1425       if v-diasize-change-size = false
     1426       then do:
     1427         assign
     1428           v-diasize-change-size = true
     1429         .
     1430       end.
     1431       else do:
     1432         return .
     1433       end.
     1434       assign
     1435         v-frame-height = frame Dialog-Frame :height
     1436         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1437         v-browse-height = v-diasize-browse-handle :height
     1438       .
     1439       for each buf_temp-browse-handle
     1440         where buf_temp-browse-handle.browse-type = 'height':u
     1441       :
     1442         assign
     1443           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1444         .
     1445       end.
     1446       for each buf_temp-diasize-handle
     1447       :
     1448         delete buf_temp-diasize-handle .
     1449       end.
     1450       assign
     1451         v-field-group-handle = frame Dialog-Frame :first-child
     1452       .
     1453       do while valid-handle(v-field-group-handle)
     1454       :
     1455         assign
     1456           v-object-handle = v-field-group-handle :first-child
     1457         .
     1458         do while valid-handle(v-object-handle)
     1459         :
     1460           if  v-object-handle <> v-diasize-browse-handle :handle
     1461           and can-query(v-object-handle, "row")
     1462           and can-query(v-object-handle, "height")
     1463           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1464           then do:
     1465             find first buf_temp-browse-handle
     1466               where buf_temp-browse-handle.browse-type   = 'height':u
     1467                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1468               no-error .
     1469             if available buf_temp-browse-handle
     1470             then do:
     1471             end.
     1472             else do:
     1473               create buf_temp-diasize-handle .
     1474               assign
     1475                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1476                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1477               .
     1478             end.
     1479           end.
     1480           assign
     1481             v-object-handle = v-object-handle :next-sibling
     1482           .
     1483         end.
     1484         assign
     1485           v-field-group-handle = v-field-group-handle :next-sibling
     1486         .
     1487       end.
     1488       do with frame Dialog-Frame
     1489       :
     1490         hide v-diasize-resize-button .
     1491         assign
     1492           v-diasize-resize-button :row    = 1
     1493           v-diasize-resize-button :column = 1
     1494         .
     1495       end.
     1496       if p-change-value > 0
     1497       then do:
     1498         if frame Dialog-Frame :scrollable = true
     1499         then do:
     1500           assign
     1501             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1502             no-error .
     1503           if error-status :error
     1504           or error-status :get-message(1) <> ""
     1505           then do:
     1506             undo move_block, retry move_block .
     1507           end.
     1508         end.
     1509         assign
     1510           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1511           no-error .
     1512         if error-status :error
     1513         or error-status :get-message(1) <> ""
     1514         then do:
     1515           undo move_block, retry move_block .
     1516         end.
     1517         assign
     1518           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1519           no-error .
     1520         if error-status :error
     1521         or error-status :get-message(1) <> ""
     1522         then do:
     1523           undo move_block, retry move_block .
     1524         end.
     1525         for each buf_temp-browse-handle
     1526           where buf_temp-browse-handle.browse-type = 'height':u
     1527         on error undo move_block, retry move_block
     1528         :
     1529           assign
     1530             buf_temp-browse-handle.browse-handle :height
     1531               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1532             no-error .
     1533           if error-status :error
     1534           or error-status :get-message(1) <> ""
     1535           then do:
     1536             undo move_block, retry move_block .
     1537           end.
     1538         end.
     1539         for each buf_temp-diasize-handle
     1540         on error undo move_block, retry move_block
     1541         :
     1542           assign
     1543             v-object-handle = buf_temp-diasize-handle.handle-value
     1544           .
     1545           if v-object-handle <> v-diasize-resize-button
     1546           then do:
     1547             assign
     1548               v-object-handle :row = v-object-handle :row + p-change-value
     1549               no-error .
     1550             if error-status :error
     1551             or error-status :get-message(1) <> ""
     1552             then do:
     1553               undo move_block, retry move_block .
     1554             end.
     1555           end.
     1556         end.
     1557       end.
     1558       else do:
     1559         for each buf_temp-diasize-handle
     1560         on error undo move_block, retry move_block
     1561         :
     1562           assign
     1563             v-object-handle = buf_temp-diasize-handle.handle-value
     1564           .
     1565           if v-object-handle <> v-diasize-resize-button
     1566           then do:
     1567             assign
     1568               v-object-handle :row = v-object-handle :row + p-change-value
     1569               no-error .
     1570             if error-status :error
     1571             or error-status :get-message(1) <> ""
     1572             then do:
     1573               undo move_block, retry move_block .
     1574             end.
     1575           end.
     1576         end.
     1577         assign
     1578           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1579           no-error .
     1580         if error-status :error
     1581         or error-status :get-message(1) <> ""
     1582         then do:
     1583           undo move_block, retry move_block .
     1584         end.
     1585         for each buf_temp-browse-handle
     1586           where buf_temp-browse-handle.browse-type = 'height':u
     1587         on error undo move_block, retry move_block
     1588         :
     1589           assign
     1590             buf_temp-browse-handle.browse-handle :height
     1591               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1592             no-error .
     1593           if error-status :error
     1594           or error-status :get-message(1) <> ""
     1595           then do:
     1596             undo move_block, retry move_block .
     1597           end.
     1598         end.
     1599         assign
     1600           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1601           no-error .
     1602         if error-status :error
     1603         or error-status :get-message(1) <> ""
     1604         then do:
     1605           undo move_block, retry move_block .
     1606         end.
     1607         if frame Dialog-Frame :scrollable = true
     1608         then do:
     1609           assign
     1610             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1611             no-error .
     1612           if error-status :error
     1613           or error-status :get-message(1) <> ""
     1614           then do:
     1615             undo move_block, retry move_block .
     1616           end.
     1617         end.
     1618       end.
     1619       if p-move-resize = true
     1620       then do:
     1621         run diasize_position-resize-button in this-procedure .
     1622       end.
     1623       if v-diasize-wndstore = true
     1624       then do:
     1625         if connected("ub") = true
     1626         then do:
     1627           define variable v-cntxt-db-num        as integer   no-undo .
     1628           define variable v-cntxt-userid        as character no-undo .
     1629           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1630                                             , OUTPUT v-cntxt-userid
     1631                                             ) .
     1632           run gbl/wndsizew.p
     1633             (input  v-cntxt-db-num
     1634             ,input  v-cntxt-userid
     1635             ,input  v-diasize-proc-name
     1636             ,input  'height':u
     1637             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1638             ) .
     1639         end.
     1640       end.
     1641     end.
     1642     assign
     1643       v-diasize-change-size = false
     1644     .
     1645   end procedure.
     1646   procedure diasize_set-height :
     1647     define input  parameter p-new-height  as decimal   no-undo .
     1648     define input  parameter p-move-resize as logical   no-undo .
     1649     do
     1650     on error undo, return error return-value
     1651     :
     1652       run diasize_change-height in this-procedure
     1653         (input  (p-new-height - frame Dialog-Frame :height)
     1654         ,input  p-move-resize
     1655         ) .
     1656     end.
     1657   end procedure.
     1658   procedure diasize_change-width :
     1659     define input  parameter p-change-value as decimal   no-undo .
     1660     define input  parameter p-move-resize  as logical   no-undo .
     1661     define variable v-field-group-handle   as handle    no-undo .
     1662     define variable v-object-handle        as handle    no-undo .
     1663     define variable v-frame-width          as decimal   no-undo .
     1664     define variable v-frame-virtual-width  as decimal   no-undo .
     1665     define variable v-browse-width         as decimal   no-undo .
     1666     define variable v-window-width         as decimal   no-undo .
     1667     define variable v-window-virtual-width as decimal   no-undo .
     1668     define variable v-change-sign          as integer   no-undo .
     1669     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1670     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1671     if p-change-value > 0
     1672     then do:
     1673       if frame Dialog-Frame :width + p-change-value >
     1674           session :width-chars
     1675       then do:
     1676         assign
     1677           p-change-value = session :width-chars - frame Dialog-Frame :width
     1678         .
     1679         if p-change-value <= 0
     1680         then do:
     1681           run diasize_position-resize-button in this-procedure .
     1682           return .
     1683         end.
     1684       end.
     1685     end.
     1686     if p-change-value < 0
     1687     then do:
     1688       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1689       then do:
     1690         assign
     1691           p-change-value = v-diasize-orig-frame-width
     1692                          - frame Dialog-Frame :width
     1693         .
     1694         if p-change-value >= 0
     1695         then do:
     1696           run diasize_position-resize-button in this-procedure .
     1697           return .
     1698         end.
     1699       end.
     1700     end.
     1701     if p-change-value >= 0
     1702     then do:
     1703       assign
     1704         v-change-sign = 1
     1705       .
     1706     end.
     1707     else do:
     1708       assign
     1709         v-change-sign = -1
     1710       .
     1711     end.
     1712     assign
     1713       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1714     .
     1715     if p-change-value = 0
     1716     then do:
     1717       run diasize_position-resize-button in this-procedure .
     1718       return .
     1719     end.
     1720     move_block:
     1721     do
     1722     on error undo move_block, leave move_block
     1723     :
     1724       if retry
     1725       then do:
     1726         do
     1727         on error undo move_block, leave move_block
     1728         :
     1729           if p-change-value > 0
     1730           then do:
     1731             for each buf_temp-diasize-handle
     1732             on error undo, next
     1733             :
     1734               assign
     1735                 v-object-handle = buf_temp-diasize-handle.handle-value
     1736               .
     1737               if v-object-handle <> v-diasize-resize-button
     1738               then do:
     1739                 assign
     1740                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1741                 .
     1742               end.
     1743             end.
     1744             assign
     1745               v-diasize-browse-handle :width = v-browse-width
     1746             .
     1747             for each buf_temp-browse-handle
     1748               where buf_temp-browse-handle.browse-type = 'width':u
     1749             on error undo, next
     1750             :
     1751               assign
     1752                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1753               .
     1754             end.
     1755             assign
     1756               frame Dialog-Frame :width = v-frame-width
     1757             .
     1758             if frame Dialog-Frame :scrollable = true
     1759             then do:
     1760               assign
     1761                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1762               .
     1763             end.
     1764             run diasize_position-resize-button in this-procedure .
     1765           end.
     1766           else do:
     1767             if frame Dialog-Frame :scrollable = true
     1768             then do:
     1769               assign
     1770                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1771               .
     1772             end.
     1773             assign
     1774               frame Dialog-Frame :width = v-frame-width
     1775             .
     1776             for each buf_temp-browse-handle
     1777               where buf_temp-browse-handle.browse-type = 'width':u
     1778             on error undo, next
     1779             :
     1780               assign
     1781                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1782               .
     1783             end.
     1784             assign
     1785               v-diasize-browse-handle :width = v-browse-width
     1786             .
     1787             for each buf_temp-diasize-handle
     1788             on error undo, next
     1789             :
     1790               assign
     1791                 v-object-handle = buf_temp-diasize-handle.handle-value
     1792               .
     1793               if v-object-handle <> v-diasize-resize-button
     1794               then do:
     1795                 assign
     1796                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1797                 .
     1798               end.
     1799             end.
     1800             run diasize_position-resize-button in this-procedure .
     1801           end.
     1802           assign
     1803             v-diasize-change-size = false
     1804           .
     1805           leave move_block .
     1806         end.
     1807       end.
     1808       assign
     1809         v-diasize-need-full-display = true
     1810       .
     1811       if v-diasize-change-size = false
     1812       then do:
     1813         assign
     1814           v-diasize-change-size = true
     1815         .
     1816       end.
     1817       else do:
     1818         return .
     1819       end.
     1820       assign
     1821         v-frame-width = frame Dialog-Frame :width
     1822         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1823         v-browse-width = v-diasize-browse-handle :width
     1824       .
     1825       for each buf_temp-browse-handle
     1826         where buf_temp-browse-handle.browse-type = 'width':u
     1827       :
     1828         assign
     1829           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1830         .
     1831       end.
     1832       for each buf_temp-diasize-handle
     1833       :
     1834         delete buf_temp-diasize-handle .
     1835       end.
     1836       assign
     1837         v-field-group-handle = frame Dialog-Frame :first-child
     1838       .
     1839       do while valid-handle(v-field-group-handle)
     1840       :
     1841         assign
     1842           v-object-handle = v-field-group-handle :first-child
     1843         .
     1844         do while valid-handle(v-object-handle)
     1845         :
     1846           if  v-object-handle <> v-diasize-browse-handle :handle
     1847           and v-object-handle <> v-diasize-resize-button
     1848           and can-query(v-object-handle, "row")
     1849           and can-query(v-object-handle, "height")
     1850           and ( v-object-handle :col + v-object-handle :width
     1851                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1852               )
     1853           then do:
     1854             find first buf_temp-browse-handle
     1855               where buf_temp-browse-handle.browse-type   = 'width':u
     1856                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1857               no-error .
     1858             if available buf_temp-browse-handle
     1859             then do:
     1860             end.
     1861             else do:
     1862               create buf_temp-diasize-handle .
     1863               assign
     1864                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1865                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1866               .
     1867             end.
     1868           end.
     1869           assign
     1870             v-object-handle = v-object-handle :next-sibling
     1871           .
     1872         end.
     1873         assign
     1874           v-field-group-handle = v-field-group-handle :next-sibling
     1875         .
     1876       end.
     1877       do with frame Dialog-Frame
     1878       :
     1879         hide v-diasize-resize-button .
     1880         v-diasize-resize-button :row = 1.
     1881         v-diasize-resize-button :column = 1.
     1882       end.
     1883       if p-change-value > 0
     1884       then do:
     1885         if frame Dialog-Frame :scrollable = true
     1886         then do:
     1887           assign
     1888             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1889             no-error .
     1890           if error-status :error
     1891           or error-status :get-message(1) <> ""
     1892           then do:
     1893             undo move_block, retry move_block.
     1894           end.
     1895         end.
     1896         assign
     1897           frame Dialog-Frame :width = v-frame-width + p-change-value
     1898           no-error .
     1899         if error-status :error
     1900         or error-status :get-message(1) <> ""
     1901         then do:
     1902           undo move_block, retry move_block.
     1903         end.
     1904         assign
     1905           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1906         no-error .
     1907         if error-status :error
     1908         or error-status :get-message(1) <> ""
     1909         then do:
     1910           undo move_block, retry move_block.
     1911         end.
     1912         for each buf_temp-browse-handle
     1913           where buf_temp-browse-handle.browse-type = 'width':u
     1914         on error undo move_block, retry move_block
     1915         :
     1916           assign
     1917             buf_temp-browse-handle.browse-handle :width
     1918               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1919             no-error .
     1920           if error-status :error
     1921           or error-status :get-message(1) <> ""
     1922           then do:
     1923             undo move_block, retry move_block .
     1924           end.
     1925         end.
     1926         for each buf_temp-diasize-handle
     1927         on error undo move_block, retry move_block
     1928         :
     1929           assign
     1930             v-object-handle = buf_temp-diasize-handle.handle-value
     1931           .
     1932           if v-object-handle <> v-diasize-resize-button
     1933           then do:
     1934             assign
     1935               v-object-handle :col = v-object-handle :col + p-change-value
     1936               no-error .
     1937             if error-status :error
     1938             or error-status :get-message(1) <> ""
     1939             then do:
     1940               undo move_block, retry move_block .
     1941             end.
     1942           end.
     1943         end.
     1944       end.
     1945       else do:
     1946         for each buf_temp-diasize-handle
     1947         on error undo move_block, retry move_block
     1948         :
     1949           assign
     1950             v-object-handle = buf_temp-diasize-handle.handle-value
     1951           .
     1952           if v-object-handle <> v-diasize-resize-button
     1953           then do:
     1954             assign
     1955               v-object-handle :col = v-object-handle :col + p-change-value
     1956               no-error .
     1957             if error-status :error
     1958             or error-status :get-message(1) <> ""
     1959             then do:
     1960               undo move_block, retry move_block .
     1961             end.
     1962           end.
     1963         end.
     1964         for each buf_temp-browse-handle
     1965           where buf_temp-browse-handle.browse-type = 'width':u
     1966         on error undo move_block, retry move_block
     1967         :
     1968           assign
     1969             buf_temp-browse-handle.browse-handle :width
     1970               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1971             no-error .
     1972           if error-status :error
     1973           or error-status :get-message(1) <> ""
     1974           then do:
     1975             undo move_block, retry move_block .
     1976           end.
     1977         end.
     1978         assign
     1979           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1980           no-error .
     1981         if error-status :error
     1982         or error-status :get-message(1) <> ""
     1983         then do:
     1984           undo move_block, retry move_block.
     1985         end.
     1986         assign
     1987           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1988         no-error .
     1989         if error-status :error
     1990         or error-status :get-message(1) <> ""
     1991         then do:
     1992           undo move_block, retry move_block.
     1993         end.
     1994         if frame Dialog-Frame :scrollable = true
     1995         then do:
     1996           assign
     1997             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1998           no-error .
     1999           if error-status :error
     2000           or error-status :get-message(1) <> ""
     2001           then do:
     2002             undo move_block, retry move_block.
     2003           end.
     2004         end.
     2005       end.
     2006       if p-move-resize
     2007       then do:
     2008         run diasize_position-resize-button in this-procedure .
     2009       end.
     2010       if v-diasize-wndstore = true
     2011       then do:
     2012         if connected("ub") = true
     2013         then do:
     2014           define variable v-cntxt-db-num        as integer   no-undo .
     2015           define variable v-cntxt-userid        as character no-undo .
     2016           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2017                                             , OUTPUT v-cntxt-userid
     2018                                             ) .
     2019           run gbl/wndsizew.p
     2020             (input  v-cntxt-db-num
     2021             ,input  v-cntxt-userid
     2022             ,input  v-diasize-proc-name
     2023             ,input  'width':u
     2024             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2025             ) .
     2026         end.
     2027       end.
     2028     end.
     2029     assign
     2030       v-diasize-change-size = false
     2031     .
     2032   end procedure.
     2033   procedure diasize_set-width :
     2034     define input  parameter p-new-width  as decimal   no-undo .
     2035     define input  parameter p-move-resize as logical   no-undo .
     2036     do
     2037     on error undo, return error return-value
     2038     :
     2039       run diasize_change-width in this-procedure
     2040         (input  (p-new-width - frame Dialog-Frame :width)
     2041         ,input  p-move-resize
     2042         ) .
     2043     end.
     2044   end procedure.
     2045   procedure diasize_position-resize-button :
     2046     do with frame Dialog-Frame
     2047     :
     2048       hide v-diasize-resize-button .
     2049       assign
     2050         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2051                     - 1
     2052                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2053         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2054                     - 1
     2055                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2056       .
     2057       view v-diasize-resize-button .
     2058     end.
     2059   end procedure.
     2060   on alt-right anywhere
     2061   do:
     2062     run diasize_change-width in this-procedure
     2063       (input 1
     2064       ,input true
     2065       ) .
     2066     return no-apply .
     2067   end.
     2068   on alt-left anywhere
     2069   do:
     2070     run diasize_change-width in this-procedure
     2071       (input -1
     2072       ,input true
     2073       ) .
     2074     return no-apply .
     2075   end.
     2076   on alt-down anywhere
     2077   do:
     2078     run diasize_change-height in this-procedure
     2079       (input 1
     2080       ,input true
     2081       ) .
     2082     return no-apply .
     2083   end.
     2084   on alt-up anywhere
     2085   do:
     2086     run diasize_change-height in this-procedure
     2087       (input -1
     2088       ,input true
     2089       ) .
     2090     return no-apply .
     2091   end.
     2092   on alt-enter of frame Dialog-Frame
     2093   do:
     2094     run diasize_maximize in this-procedure
     2095       (input  ?
     2096       ).
     2097     return no-apply .
     2098   end.
     2099   procedure diasize_end-move :
     2100     do
     2101     on error undo, return error return-value
     2102     :
     2103       define variable v-row-delta as decimal   no-undo .
     2104       define variable v-col-delta as decimal   no-undo .
     2105       define variable v-new-row as decimal   no-undo .
     2106       define variable v-new-col as decimal   no-undo .
     2107       assign
     2108         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2109         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2110       .
     2111       assign
     2112         v-row-delta = v-new-row - frame Dialog-Frame :height
     2113         v-col-delta = v-new-col - frame Dialog-Frame :width
     2114       .
     2115       run diasize_change-height in this-procedure
     2116         (input v-row-delta
     2117         ,input true
     2118         ) .
     2119       run diasize_change-width in this-procedure
     2120         (input v-col-delta
     2121         ,input true
     2122         ) .
     2123     end.
     2124   end procedure.
     2125   procedure diasize_maximize :
     2126     define input  parameter p-action as logical   no-undo .
     2127     do
     2128     on error undo, return error return-value
     2129     :
     2130       if p-action = ?
     2131       then do:
     2132         if v-diasize-need-maximize = true
     2133         then do:
     2134           assign
     2135             p-action = true
     2136           .
     2137         end.
     2138         else do:
     2139           assign
     2140             p-action = false
     2141           .
     2142         end.
     2143       end.
     2144       if p-action = true
     2145       then do:
     2146         run diasize_change-height in this-procedure
     2147           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2148               - frame Dialog-Frame :height-chars
     2149           ,input true
     2150           ) .
     2151         run diasize_change-width in this-procedure
     2152           (input session :width-chars
     2153               - frame Dialog-Frame :width-chars
     2154           ,input true
     2155           ) .
     2156         assign
     2157           v-diasize-need-maximize = false
     2158         .
     2159       end.
     2160       else do:
     2161         run diasize_change-width in this-procedure
     2162           (input v-diasize-orig-frame-width
     2163               - frame Dialog-Frame :width-chars
     2164           ,input true
     2165           ) .
     2166         run diasize_change-height in this-procedure
     2167           (input v-diasize-orig-frame-height
     2168               - frame Dialog-Frame :height-chars
     2169           ,input true
     2170           ) .
     2171         assign
     2172           v-diasize-need-maximize = true
     2173         .
     2174       end.
     2175     end.
     2176   end procedure.
     2177   procedure diasize_restore-orig-size :
     2178     do
     2179     on error undo, return error return-value
     2180     :
     2181       assign
     2182         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2183         v-diasize-current-frame-height = frame Dialog-Frame :height
     2184       .
     2185       run diasize_set-height in this-procedure
     2186         (input  v-diasize-orig-frame-height
     2187         ,input  true
     2188         ) .
     2189       run diasize_set-width in this-procedure
     2190         (input  v-diasize-orig-frame-width
     2191         ,input  true
     2192         ) .
     2193     end.
     2194   end procedure.
     2195   procedure diasize_restore-current-size :
     2196     do
     2197     on error undo, return error return-value
     2198     :
     2199       run diasize_set-height in this-procedure
     2200         (input  v-diasize-current-frame-height
     2201         ,input  true
     2202         ) .
     2203       run diasize_set-width in this-procedure
     2204         (input  v-diasize-current-frame-width
     2205         ,input  true
     2206         ) .
     2207     end.
     2208   end procedure.
     2209   procedure diasize_set-browse-handle :
     2210     define input  parameter p-browse-handle as handle   no-undo .
     2211     define buffer buf_temp-browse-handle for temp-browse-handle .
     2212     do
     2213     on error undo, return error return-value
     2214     :
     2215       assign
     2216         v-diasize-browse-handle = p-browse-handle
     2217       .
     2218       for each buf_temp-browse-handle
     2219       on error undo, return error return-value
     2220       :
     2221         delete buf_temp-browse-handle .
     2222       end.
     2223     end.
     2224   end procedure.
     2225   procedure diasize_add_browse :
     2226     define input  parameter p-browse-type   as character no-undo .
     2227     define input  parameter p-browse-handle as handle    no-undo .
     2228     define buffer buf_temp-browse-handle for temp-browse-handle .
     2229     do
     2230     on error undo, return error return-value
     2231     :
     2232       assign
     2233         v-diasize-browse-number = v-diasize-browse-number + 1
     2234       .
     2235       create buf_temp-browse-handle .
     2236       assign
     2237         buf_temp-browse-handle.browse-type   = p-browse-type
     2238         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2239         buf_temp-browse-handle.browse-handle = p-browse-handle
     2240       .
     2241     end.
     2242   end procedure.
     2243   procedure diasize_init :
     2244     define variable v-default-value    as logical   no-undo .
     2245     define variable v-restore-saved    as logical   no-undo .
     2246     define variable v-resize-value-str as character no-undo .
     2247     do
     2248     on error undo, return error return-value
     2249     :
     2250       do with frame Dialog-Frame
     2251       :
     2252         assign
     2253           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2254           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2255           v-diasize-browse-handle     = browse BR-lines :handle
     2256         .
     2257         create button v-diasize-resize-button
     2258         assign
     2259           parent        = frame Dialog-Frame :first-child
     2260           label         = "s"
     2261           height-pixels = 16
     2262           width-pixels  = 16
     2263           visible       = true
     2264           sensitive     = true
     2265           movable       = true
     2266           triggers:
     2267             on end-move persistent run diasize_end-move in this-procedure .
     2268           end triggers.
     2269         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2270         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2271         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2272         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2273         assign
     2274           v-diasize-wndmax = false
     2275         .
     2276         if connected("ub") = true
     2277         then do:
     2278           define variable v-cntxt-db-num        as integer   no-undo .
     2279           define variable v-cntxt-userid        as character no-undo .
     2280           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2281                                             , OUTPUT v-cntxt-userid
     2282                                             ) .
     2283           run gbl/wndpar_r.p
     2284             (input  v-cntxt-db-num
     2285             ,input  v-cntxt-userid
     2286             ,input  'wndmax':U
     2287             ,output v-diasize-wndmax
     2288             ,output v-default-value
     2289             ) .
     2290         end.
     2291         assign
     2292           v-diasize-wndstore = false
     2293         .
     2294         if connected("ub") = true
     2295         then do:
     2296           run gbl/wndpar_r.p
     2297             (input  v-cntxt-db-num
     2298             ,input  v-cntxt-userid
     2299             ,input  'wndstore':U
     2300             ,output v-diasize-wndstore
     2301             ,output v-default-value
     2302             ) .
     2303         end.
     2304         assign
     2305           v-diasize-proc-name = entry(1, program-name(2), '.')
     2306         .
     2307         if v-diasize-wndstore = true
     2308         then do:
     2309           assign
     2310             v-restore-saved = false
     2311           .
     2312           if connected("ub") = true
     2313           then do:
     2314             run gbl/wndsizer.p
     2315               (input  v-cntxt-db-num
     2316               ,input  v-cntxt-userid
     2317               ,input  v-diasize-proc-name
     2318               ,input  'height':u
     2319               ,output v-resize-value-str
     2320               ) .
     2321             if v-resize-value-str <> '':U
     2322             then do:
     2323               run diasize_change-height in this-procedure
     2324                 (input  integer(v-resize-value-str)
     2325                 ,input  true
     2326                 ) .
     2327               assign
     2328                 v-restore-saved = true
     2329               .
     2330             end.
     2331           end.
     2332           if connected("ub") = true
     2333           then do:
     2334             run gbl/wndsizer.p
     2335               (input  v-cntxt-db-num
     2336               ,input  v-cntxt-userid
     2337               ,input  v-diasize-proc-name
     2338               ,input  'width':u
     2339               ,output v-resize-value-str
     2340               ) .
     2341             if v-resize-value-str <> '':U
     2342             then do:
     2343               run diasize_change-width in this-procedure
     2344                 (input  integer(v-resize-value-str)
     2345                 ,input  true
     2346                 ) .
     2347               assign
     2348                 v-restore-saved = true
     2349               .
     2350             end.
     2351           end.
     2352           if v-restore-saved <> true
     2353           then do:
     2354             if v-diasize-wndmax = true
     2355             then do:
     2356               run diasize_maximize in this-procedure
     2357                 (input  true
     2358                 ) .
     2359             end.
     2360           end.
     2361         end.
     2362         else do:
     2363           if v-diasize-wndmax = true
     2364           then do:
     2365             run diasize_maximize in this-procedure
     2366               (input  true
     2367               ) .
     2368           end.
     2369         end.
     2370       end.
     2371     end.
     2372   end procedure.
     2373   procedure diasize_need-full-display :
     2374     define output parameter p-need-full-display as logical   no-undo .
     2375     do
     2376     on error undo, return error return-value
     2377     :
