     2756        )
     2757     then do:
     2758       assign
     2759         self :screen-value = ?
     2760       .
     2761     end.
     2762     return no-apply.
     2763   end.
     2764   on ctrl-d of tt-fin-statement.doc-date in frame Dialog-Frame
     2765   do:
     2766     define variable v-curr-sv-date as date no-undo .
     2767     if (can-query (self, "sensitive")
     2768        and
     2769        self :sensitive = true
     2770        )
     2771     or (can-query (self, "read-only")
     2772        and
     2773        self :read-only = false
     2774        )
     2775     then do:
     2776       if self :handle <> focus :handle
     2777       then do:
     2778         apply "entry":u to self .
     2779       end.
     2780       run gbl/getcurdt.p
     2781         (output v-curr-sv-date
     2782         ) .
     2783       assign
     2784         self :screen-value = string(v-curr-sv-date) .
     2785       .
     2786     end.
     2787     return no-apply.
     2788   end.
     2789   on ctrl-b of tt-fin-statement.doc-date in frame Dialog-Frame
     2790   do:
     2791     if (can-query (self, "sensitive")
     2792        and
     2793        self :sensitive = true
     2794        )
     2795     or (can-query (self, "read-only")
     2796        and
     2797        self :read-only = false
     2798        )
     2799     then do:
     2800       if self :handle <> focus :handle
     2801       then do:
     2802         apply "entry":u to self .
     2803       end.
     2804       define variable v-curr-sv-date as date no-undo .
     2805       define variable v-new-sv-date  as date no-undo .
     2806       assign
     2807         v-curr-sv-date = date(self :screen-value) no-error
     2808       .
     2809       if v-curr-sv-date = ?
     2810       then do:
     2811         run gbl/getcurdt.p
     2812           (output v-curr-sv-date
     2813           ) .
     2814       end.
     2815       if v-curr-sv-date <> ?
     2816       then do:
     2817         assign
     2818           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
