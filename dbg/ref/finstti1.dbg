     2386   procedure get-context :
     2387      define output parameter p-db-num as integer          no-undo.
     2388      define output parameter p-user-id as character        no-undo.
     2389      define variable v-login               as character    no-undo.
     2390      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2391      define buffer buf_user-login  for ub.user-login .
     2392      do
     2393      on error undo, return error
     2394      :
     2395            FIND FIRST buf_sys-ctrl no-lock.
     2396            ASSIGN
     2397               v-login = USERID("ub")
     2398               p-db-num = buf_sys-ctrl.db-num
     2399            .
     2400            FIND FIRST buf_user-login
     2401                 WHERE buf_user-login.db-num = p-db-num
     2402                   AND buf_user-login.user-login = v-login
     2403                 no-lock
     2404                 no-error
     2405                 .
     2406            IF AVAILABLE buf_user-login
     2407            THEN DO:
     2408               assign
     2409                  p-user-id = buf_user-login.user-id
     2410               .
     2411            END.
     2412      end.
     2413   end procedure.
     2414       run diasize_init in this-procedure .
     2415   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2416   ON TAB ANYWHERE
     2417   DO:
     2418   define variable ii as integer no-undo .
     2419   define variable fh as widget-handle no-undo .
     2420   define variable hh as widget-handle no-undo .
     2421   define variable v-next-widget-name as character no-undo .
     2422   if v-tab-order <> '' then do:
     2423     if self:type = "TOGGLE-BOX" then
     2424     self:BGCOLOR = ?.
     2425     assign
     2426     ii = lookup(self:name, v-tab-order).
     2427     assign
     2428     ii = ii + 1
     2429     v-next-widget-name = entry(ii, v-tab-order)
     2430     no-error .
     2431     if error-status:error then do:
     2432       assign
     2433       ii = 1
     2434       v-next-widget-name = entry( ii, v-tab-order)
     2435       .
     2436     end.
     2437     assign
     2438     fh = frame Dialog-Frame:first-child
     2439     hh = fh:first-child
     2440     .
     2441     do while valid-handle(hh):
     2442       if hh:name = v-next-widget-name then do:
     2443         if hh:sensitive  = yes
     2444         AND hh:visible = yes then do:
     2445           if hh:type = "TOGGLE-BOX":U then do:
     2446             assign
     2447             hh:BGcolor = 1
     2448             .
     2449           end.
     2450           APPLY "ENTRY" to hh.
     2451           return no-apply.
     2452         end.
     2453         else do:
     2454           APPLY "TAB" to hh.
     2455           return no-apply.
     2456         end.
     2457       end.
     2458       hh = hh:next-sibling.
     2459     end.
     2460   end.
     2461   END.
     2462   ON BACK-TAB ANYWHERE
     2463   DO:
     2464   define variable ii as integer no-undo .
     2465   define variable fh as widget-handle no-undo .
     2466   define variable hh as widget-handle no-undo .
     2467   define variable v-next-widget-name as character no-undo .
     2468   if v-tab-order <> '' then do:
     2469     assign
     2470     ii = lookup(self:name, v-tab-order).
     2471     .
     2472     assign
     2473     ii = (if ii = 1
     2474           then  num-entries(v-tab-order)
     2475           else ii - 1
     2476           )
     2477     v-next-widget-name = entry(ii, v-tab-order)
     2478     .
     2479     assign
     2480     fh = frame Dialog-Frame:first-child
     2481     hh = fh:first-child
     2482     .
     2483     do while valid-handle(hh):
     2484       if hh:name = v-next-widget-name then do:
     2485         if hh:sensitive  = yes
     2486         AND hh:visible = yes then do:
     2487           if hh:type = "TOGGLE-BOX":U then do:
     2488             assign
     2489             hh:BGcolor = 1
     2490             .
     2491           end.
     2492           APPLY "ENTRY" to hh.
     2493           return no-apply.
     2494         end.
     2495         else do:
     2496         APPLY "BACK-TAB" to hh.
     2497         return no-apply.
     2498         end.
     2499       end.
     2500       hh = hh:next-sibling.
     2501     end.
     2502     end.
     2503   END.
     2504   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2505   ON RETURN ANYWHERE
     2506   DO:
     2507   define variable ii as integer no-undo .
     2508   define variable fh as widget-handle no-undo .
     2509   define variable hh as widget-handle no-undo .
     2510   define variable v-next-widget-name as character no-undo .
     2511     if v-tab-order <> '' then do:
     2512       assign
     2513       ii = lookup(self:name, v-tab-order).
     2514       if ii = num-entries(v-tab-order) then do:
     2515           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2516           return no-apply.
     2517       end.
     2518       if self:type <> "BUTTON" and
     2519         self:type <> "EDITOR"  then do:
     2520         run proc-move-forward in this-procedure .
     2521         return no-apply.
     2522       end.
     2523       if self:type = "BUTTON" then do:
     2524         APPLY "CHOOSE" to self.
     2525       end.
     2526       if self:type = "TOGGLE-BOX" then
     2527       self:BGCOLOR = ?.
     2528       assign
     2529       ii = ii + 1
     2530       v-next-widget-name = entry(ii, v-tab-order)
     2531       no-error .
     2532       if error-status:error then do:
     2533         assign
     2534         ii = 1
     2535         v-next-widget-name = entry( ii, v-tab-order)
     2536         .
     2537       end.
     2538       assign
     2539       fh = frame Dialog-Frame:first-child
     2540       hh = fh:first-child
     2541       .
     2542       do while valid-handle(hh):
     2543         if hh:name = v-next-widget-name then do:
     2544           if hh:sensitive  = yes
     2545           AND hh:visible = yes then do:
     2546             if hh:type = "TOGGLE-BOX":U then do:
     2547               assign
     2548               hh:BGcolor = 1
     2549               .
     2550             end.
     2551             APPLY "ENTRY" to hh.
     2552             return no-apply.
     2553           end.
     2554           else do:
     2555             APPLY "TAB" to hh.
     2556             return no-apply.
     2557           end.
     2558         end.
     2559         hh = hh:next-sibling.
     2560       end.
     2561     end.
     2562   END.
     2563   procedure proc-move-forward :
     2564   define variable ii as integer no-undo .
     2565   define variable fh as widget-handle no-undo .
     2566   define variable hh as widget-handle no-undo .
     2567   define variable v-next-widget-name as character no-undo .
     2568   do
     2569   on error undo, return error
     2570   :
     2571     if v-tab-order <> '' then do:
     2572       if self:type = "TOGGLE-BOX" then
     2573       self:BGCOLOR = ?.
     2574       assign
     2575       ii = lookup(self:name, v-tab-order).
     2576       assign
     2577       ii = ii + 1
     2578       v-next-widget-name = entry(ii, v-tab-order)
     2579       no-error .
     2580       if error-status:error then do:
     2581         assign
     2582         ii = 1
     2583         v-next-widget-name = entry( ii, v-tab-order)
     2584         .
     2585       end.
     2586       assign
     2587       fh = frame Dialog-Frame:first-child
     2588       hh = fh:first-child
     2589       .
     2590       do while valid-handle(hh):
     2591         if hh:name = v-next-widget-name then do:
     2592           if hh:sensitive  = yes
     2593           AND hh:visible = yes then do:
     2594             if hh:type = "TOGGLE-BOX":U then do:
     2595               assign
     2596               hh:BGcolor = 1
     2597               .
     2598             end.
     2599             APPLY "ENTRY" to hh.
     2600             return.
     2601           end.
     2602           else do:
     2603             assign
     2604             ii = ii + 1
     2605             v-next-widget-name = entry(ii, v-tab-order)
     2606             no-error .
     2607             if error-status:error then do:
     2608               assign
     2609               ii = 1
     2610               v-next-widget-name = entry( ii, v-tab-order)
     2611               .
     2612             end.
     2613           end.
     2614         end.
     2615         hh = hh:next-sibling.
     2616       end.
     2617     end.
     2618   end.
     2619   end procedure.
     2620   def var sort-labelBR-lines   as character no-undo .
     2621   def var sort-clmnBR-lines    as handle    no-undo .
     2622   def var cur-clmnBR-lines     as handle    no-undo .
     2623   def var cur-clmn-locBR-lines as integer   no-undo .
     2624   def var re-queryBR-lines     as logical   initial no no-undo .
     2625   on start-search, ctrl-o of BR-lines in frame Dialog-Frame do:
     2626      run sort-brBR-lines
     2627        (input (if available locked_fin-statement-line
     2628                then recid(locked_fin-statement-line)
     2629                else ?
     2630               )
     2631        ).
     2632   end.
     2633   PROCEDURE sort-brBR-lines :
     2634     define input parameter p-recid as recid no-undo .
     2635     if re-queryBR-lines = no then do:
     2636       assign
     2637          cur-clmnBR-lines = BR-lines:current-column in frame Dialog-Frame
     2638       .
     2639       if sort-clmnBR-lines <> ? then sort-clmnBR-lines:column-fgcolor = 0.
     2640       if cur-clmnBR-lines = sort-clmnBR-lines then do:
     2641         assign
     2642            sort-labelBR-lines = ""
     2643            sort-clmnBR-lines = ?
     2644         .
     2645        end.
     2646        else do:
     2647          assign
     2648            sort-labelBR-lines = cur-clmnBR-lines:label
     2649            sort-clmnBR-lines  = cur-clmnBR-lines
     2650            sort-clmnBR-lines:column-fgcolor = 4
     2651          .
     2652        end.
     2653      end.
     2654     assign
     2655       cur-clmn-locBR-lines = 1
     2656     .
     2657     def var column-handle as handle no-undo .
     2658     column-handle = BR-lines:first-column.
     2659     do while valid-handle(column-handle) :
     2660       if column-handle = cur-clmnBR-lines then do:
     2661         leave .
     2662       end.
     2663       column-handle = column-handle:NEXT-COLUMN.
     2664       assign
     2665         cur-clmn-locBR-lines = cur-clmn-locBR-lines + 1
     2666       .
     2667     end.
     2668     case sort-labelBR-lines:
     2669           when '*'  then DO:   assign     sort-column-name = "mark-string(recid(locked_fin-statement-line), v-rid-list)"   .   run OpenBr in this-procedure ( yes, no, no).   . END.
     2670           when locked_fin-statement-line.line-num:label in browse BR-lines then DO:   assign     sort-column-name = "locked_fin-statement-line.line-num"   .   run OpenBr in this-procedure ( yes, no, no).   . END.
     2671           when locked_fin-statement-line.prn-doc-code:label in browse BR-lines then DO:   assign     sort-column-name = "locked_fin-statement-line.prn-doc-code"   .   run OpenBr in this-procedure ( yes, no, no).   . END.
     2672           when locked_fin-statement-line.fin-doc-code:label in browse BR-lines then DO:   assign     sort-column-name = "locked_fin-statement-line.fin-doc-code"   .   run OpenBr in this-procedure ( yes, no, no).   . END.
     2673           when 'Контрагент'  then DO:   assign     sort-column-name = "get-cli-name(buffer locked_fin-statement-line)"   .   run OpenBr in this-procedure ( yes, no, no).   . END.
     2674           when locked_fin-statement-line.sum-doc:label in browse BR-lines then DO:   assign     sort-column-name = "locked_fin-statement-line.sum-doc"   .   run OpenBr in this-procedure ( yes, no, no).   . END.
     2675       otherwise do:
     2676         assign
     2677           sort-column-name = ""
     2678         .
     2679         run OpenBr in this-procedure ( yes, no, no).
     2680           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-lines') then do:
     2681             run mv-brw-defaultBR-lines.
     2682           end.
     2683         if sort-labelBR-lines <> "" then do:
     2684           assign
     2685             cur-clmnBR-lines:column-fgcolor = 0
     2686           .
     2687         end.
     2688         assign
     2689           cur-clmn-locBR-lines = ?
     2690         .
     2691       end.
     2692     end case.
     2693       if cur-clmn-locBR-lines <> ? then do:
     2694         if can-do( this-procedure:internal-entries, 'ch-clmnBR-lines') then do:
     2695           run ch-clmnBR-lines in this-procedure (cur-clmn-locBR-lines).
     2696         end.
     2697       end.
     2698     if p-recid <> ? then do:
     2699       reposition BR-lines to recid p-recid no-error.
     2700       apply "value-changed" to BR-lines in frame Dialog-Frame.
     2701     end.
     2702     apply "entry" to BR-lines in frame Dialog-Frame.
     2703   END PROCEDURE.
     2704   procedure re-open-query-srt-clmnBR-lines:
     2705   if cur-clmnBR-lines = ? then do:
     2706      run OpenBr in this-procedure ( yes, no, no).
     2707   end.
     2708   else do:
     2709      assign re-queryBR-lines = yes.
     2710      run sort-brBR-lines
     2711        (input (if available locked_fin-statement-line
     2712                then recid(locked_fin-statement-line)
     2713                else ?
     2714               )
     2715        ).
     2716      assign re-queryBR-lines = no.
     2717   end.
     2718   end.
     2719   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2720   do:
     2721     BR-lines :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2722   end.
     2723   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2724   on f5 of frame Dialog-Frame anywhere
     2725   do:
     2726     v-doc-rec = recid(locked_fin-statement-line). run OpenBr in this-procedure ( yes, no, '':U). reposition br-lines to recid v-doc-rec no-error. v-doc-rec = ?.
     2727       apply "VALUE-CHANGED" to BR-lines.
     2728   end.
     2729   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2730   on ' ' of tt-fin-statement.doc-date in frame Dialog-Frame
     2731   do:
     2732     if (can-query (self, "sensitive")
     2733        and
     2734        self :sensitive = true
     2735        )
     2736     or (can-query (self, "read-only")
     2737        and
     2738        self :read-only = false
     2739        )
     2740     then do:
     2741       assign
     2742         self :screen-value = ?
     2743       .
     2744     end.
     2745     return no-apply.
     2746   end.
     2747   on delete-character of tt-fin-statement.doc-date in frame Dialog-Frame
     2748   do:
     2749     if (can-query (self, "sensitive")
     2750        and
     2751        self :sensitive = true
     2752        )
     2753     or (can-query (self, "read-only")
     2754        and
