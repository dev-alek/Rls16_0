     3844   MAIN-BLOCK:
     3845   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3846      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3847     RUN check-parameters IN THIS-PROCEDURE NO-ERROR.
     3848     IF ERROR-STATUS:ERROR THEN UNDO main-block, RETURN ERROR.
     3849     RUN fill-tables IN THIS-PROCEDURE NO-ERROR.
     3850     IF ERROR-STATUS:ERROR THEN UNDO main-block, RETURN ERROR.
     3851     RUN Myenable in this-procedure .
     3852     run control-line in this-procedure ( output lock-doc).
     3853     run lock-proc in this-procedure ( input lock-doc).
     3854     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     3855     APPLY "Value-changed" TO br-lines.
     3856     HIDE mark-num in frame Dialog-Frame .
     3857     if p-line-rec <> ? then
     3858     REPOSITION br-lines to recid p-line-rec No-ERROR.
     3859   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3860   DEF VAR cur-clmn-numbr-lines as INT EXTENT 7 no-undo.
     3861   DEF VAR varmvibr-lines       as INT no-undo.
     3862   DEF VAR varmvjbr-lines       as INT no-undo.
     3863   DEF VAR varmvkbr-lines       as INT no-undo.
     3864   DEF VAR varmvlbr-lines       as INT no-undo.
     3865   DEF VAR move-elementbr-lines as INT no-undo.
     3866   def var jjbr-lines           as int no-undo.
     3867   do varmvibr-lines = 1 to EXTENT(cur-clmn-numbr-lines):
     3868     ASSIGN cur-clmn-numbr-lines[varmvibr-lines] = varmvibr-lines.
     3869   END.
     3870   RUN start-mv-clmnbr-lines.
     3871   PROCEDURE start-mv-clmnbr-lines:
     3872   def var old-session as logical no-undo.
     3873      old-session = SESSION:IMMEDIATE-DISPLAY.
     3874      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3875          IF  yes  THEN DO:
     3876      DO jjbr-lines = NUM-ENTRIES('1,2,3,4,5,6,7') TO 1 BY -1:
     3877        RUN re-move-clmnbr-lines ( cur-clmn-numbr-lines[INTEGER(ENTRY (jjbr-lines, '1,2,3,4,5,6,7'))] , 2).
     3878      END.
     3879          END.
     3880      SESSION:IMMEDIATE-DISPLAY = old-session.
     3881   END.
     3882   ON ctrl-cursor-right OF BROWSE br-lines do:
     3883     RUN re-move-clmnbr-lines ( 2, 7).
     3884   END.
     3885   ON ctrl-cursor-left OF BROWSE br-lines do:
     3886     RUN re-move-clmnbr-lines (7, 2).
     3887   END.
     3888   PROCEDURE re-move-clmnbr-lines:
     3889     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3890     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3891     DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     3892       if cur-clmn-numbr-lines[varmvibr-lines] = source-column THEN cur-clmn-numbr-lines[varmvibr-lines] = -1.
     3893     END.
     3894     if br-lines:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3895     if source-column > target-column THEN
     3896     DO varmvjbr-lines = source-column - 1 to target-column BY -1:
     3897       DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     3898           if cur-clmn-numbr-lines[varmvibr-lines] = varmvjbr-lines THEN DO:
     3899             cur-clmn-numbr-lines[varmvibr-lines] = cur-clmn-numbr-lines[varmvibr-lines] + 1.
     3900           END.
     3901       END.
     3902     END.
     3903     ELSE
     3904     DO varmvjbr-lines = source-column + 1 to target-column:
     3905       DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     3906         if cur-clmn-numbr-lines[varmvibr-lines] = varmvjbr-lines THEN DO:
     3907           cur-clmn-numbr-lines[varmvibr-lines] = cur-clmn-numbr-lines[varmvibr-lines] - 1.
     3908         END.
     3909       END.
     3910     END.
     3911     DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     3912       if cur-clmn-numbr-lines[varmvibr-lines] = -1 THEN cur-clmn-numbr-lines[varmvibr-lines] = target-column.
     3913     END.
     3914   END PROCEDURE.
     3915   PROCEDURE ch-clmnbr-lines:
     3916     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3917     if cur-clmn-loc <= 2 then do:
     3918       return .
     3919     end.
     3920     DO varmvibr-lines = 1 TO EXTENT(cur-clmn-numbr-lines):
     3921       if cur-clmn-numbr-lines[varmvibr-lines] = cur-clmn-loc THEN move-elementbr-lines = varmvibr-lines.
     3922     END.
     3923     RUN re-move-clmnbr-lines (cur-clmn-loc, 2).
     3924   END PROCEDURE.
     3925   PROCEDURE mv-brw-defaultbr-lines:
     3926   def var old-session as logical no-undo.
     3927     old-session = SESSION:IMMEDIATE-DISPLAY.
     3928     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3929     do varmvlbr-lines = 2 to EXTENT(cur-clmn-numbr-lines):
     3930       RUN re-move-clmnbr-lines (cur-clmn-numbr-lines[varmvlbr-lines], varmvlbr-lines).
     3931     END.
     3932     RUN start-mv-clmnbr-lines.
     3933     SESSION:IMMEDIATE-DISPLAY = old-session.
     3934   END PROCEDURE.
     3935   .
     3936     WAIT-FOR GO OF FRAME Dialog-Frame.
     3937   END.
     3938   RUN disable_UI.
     3939   PROCEDURE check-parameters :
     3940   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3941   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3942     (output v-db-num
     3943     )  .
     3944   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3945   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3946     (input  p-host-code
     3947     ,output v-base-code
     3948     )  .
     3949   find first X_curr_sysconf no-lock where
     3950                 X_curr_sysconf.host-code = p-curr-host-code.
     3951   find first X_sysconf no-lock where
     3952               X_sysconf.host-code = p-host-code.
     3953   if p-mode  <> 'ДОБАВЛЕНИЕ':U
     3954   and p-mode <> 'ИЗМЕНЕНИЕ':U
     3955   and p-mode <> 'ПРОСМОТР':U
     3956   then do:
     3957       message
     3958       vss-workfile vss-revision vss-description skip
     3959       "Неверное значение параметров вызова p-mode"  p-mode
     3960       view-as alert-box ERROR.
     3961       undo, return error.
     3962   end.
     3963   FIND FIRST X_curr_sysconf NO-LOCK WHERE
     3964           X_curr_sysconf.host-code = p-curr-host-code NO-ERROR.
     3965   IF NOT AVAILABLE X_curr_sysconf THEN DO:
     3966       message
     3967       vss-workfile vss-revision vss-description skip
     3968       "Неверное значение параметров вызова p-curr-host-code"  p-curr-host-code
     3969       view-as alert-box ERROR.
     3970       undo, return error.
     3971   END.
     3972   find first X_clients no-lock where
     3973           X_clients.obj-type = 'орг':U
     3974       and X_clients.obj-code = p-curr-host-code.
     3975   if p-mode <> 'ПРОСМОТР':U then do:
     3976   if p-curr-host-code <> p-host-code
     3977   or (v-db-num <> X_sysconf.firm-db-num)
     3978   then do:
     3979     message
     3980     vss-workfile vss-revision vss-description skip
     3981     "Неверное значение параметров вызова p-mode и/или p-host-code и/или p-curr-host-code" p-mode p-host-code  p-curr-host-code
     3982     view-as alert-box ERROR.
     3983     undo, return error.
     3984   end.
     3985   end.
     3986   FIND FIRST X_sysconf NO-LOCK WHERE
     3987           X_sysconf.host-code = p-host-code NO-ERROR.
     3988   IF NOT AVAILABLE X_sysconf THEN DO:
     3989       message
     3990       vss-workfile vss-revision vss-description skip
     3991       "Неверное значение параметров вызова p-host-code"  p-curr-host-code
     3992       view-as alert-box ERROR.
     3993       undo, return error.
     3994   END.
     3995   IF p-code-bank <> 0 THEN DO:
     3996     FIND FIRST X_fin-bank NO-LOCK WHERE
     3997               X_fin-bank.host-code = p-host-code
     3998          AND  X_fin-bank.code-bank = p-code-bank NO-ERROR.
     3999       IF NOT AVAILABLE X_fin-bank THEN DO:
     4000           message
     4001           vss-workfile vss-revision vss-description skip
     4002           "Неверное значение параметров вызова p-code-bank"  p-code-bank
     4003           view-as alert-box ERROR.
     4004           undo, return error.
     4005       END.
     4006   END.
     4007   IF p-code-schet <> 0 THEN DO:
     4008     FIND FIRST X_fin-schet NO-LOCK WHERE
     4009               X_fin-schet.host-code = p-host-code
     4010          AND  X_fin-schet.code-schet = p-code-schet NO-ERROR.
     4011       IF NOT AVAILABLE X_fin-schet THEN DO:
     4012           message
     4013           vss-workfile vss-revision vss-description skip
     4014           "Неверное значение параметров вызова p-code-schet"  p-code-schet
     4015           view-as alert-box ERROR.
     4016           undo, return error.
     4017       END.
     4018       IF p-code-bank <> 0 THEN do:
     4019         IF X_fin-schet.code-bank <>  p-code-bank THEN DO:
     4020           message
     4021           vss-workfile vss-revision vss-description skip
     4022           "Неверное значение параметров вызова p-code-schet и/или p-code-bank"  p-code-schet p-code-bank
     4023           view-as alert-box ERROR.
     4024           undo, return error.
     4025         END.
     4026         FIND FIRST X_fin-bank NO-LOCK WHERE
     4027                   X_fin-bank.host-code = X_fin-schet.host-code
     4028              AND  X_fin-bank.code-bank = X_fin-schet.code-bank.
     4029      END.
     4030   END.
     4031   END PROCEDURE.
     4032   PROCEDURE control-line :
     4033   DEFINE OUTPUT PARAMETER p-lock-doc as logical no-undo.
     4034   IF CAN-FIND(FIRST ub.fin-statement-line No-LOCK WHERE
     4035                     ub.fin-statement-line.host-code = tt-fin-statement.host-code
     4036                AND  ub.fin-statement-line.sttm-code = tt-fin-statement.sttm-code) then
     4037   p-lock-doc = yes.
     4038   else p-lock-doc = no.
     4039   END PROCEDURE.
     4040   PROCEDURE disable_UI :
     4041     HIDE FRAME Dialog-Frame.
     4042   END PROCEDURE.
     4043   PROCEDURE enable_UI :
     4044     DISPLAY e-line-ps mark-num f-bank-data f-th-data F-curr-abbr f-bank
     4045         WITH FRAME Dialog-Frame.
     4046     IF AVAILABLE tt-fin-statement THEN
     4047       DISPLAY tt-fin-statement.prn-doc-code tt-fin-statement.num-docs
     4048             tt-fin-statement.num-docs-th tt-fin-statement.sttm-code
     4049             tt-fin-statement.doc-date tt-fin-statement.start-sum-doc
     4050             tt-fin-statement.start-sum-doc-th tt-fin-statement.bank-date
     4051             tt-fin-statement.in-sum-doc tt-fin-statement.in-sum-doc-th
     4052             tt-fin-statement.fact-date tt-fin-statement.out-sum-doc
     4053             tt-fin-statement.out-sum-doc-th tt-fin-statement.start-date
     4054             tt-fin-statement.end-date tt-fin-statement.end-sum-doc
     4055             tt-fin-statement.end-sum-doc-th tt-fin-statement.PS
     4056             tt-fin-statement.curr-code tt-fin-statement.r-schet
     4057             tt-fin-statement.bank-name tt-fin-statement.bik
     4058             tt-fin-statement.bank-city
     4059         WITH FRAME Dialog-Frame.
     4060     ENABLE B-exit B-quit B-mark B-add B-lookup B-del B-print B-hist B-Help
     4061            tt-fin-statement.prn-doc-code tt-fin-statement.num-docs
     4062            tt-fin-statement.num-docs-th tt-fin-statement.doc-date
     4063            tt-fin-statement.start-sum-doc tt-fin-statement.start-sum-doc-th
     4064            tt-fin-statement.bank-date tt-fin-statement.in-sum-doc
     4065            tt-fin-statement.in-sum-doc-th tt-fin-statement.out-sum-doc
     4066            tt-fin-statement.out-sum-doc-th tt-fin-statement.start-date
     4067            tt-fin-statement.end-date tt-fin-statement.end-sum-doc
     4068            tt-fin-statement.end-sum-doc-th B-schet BR-lines e-line-ps
     4069            tt-fin-statement.PS mark-num tt-fin-statement.curr-code
     4070            tt-fin-statement.r-schet tt-fin-statement.bank-name
     4071            tt-fin-statement.bik tt-fin-statement.bank-city
     4072         WITH FRAME Dialog-Frame.
     4073     VIEW FRAME Dialog-Frame.
     4074   END PROCEDURE.
     4075   PROCEDURE fill-tables :
     4076   DEFINE VARIABLE v-today as date no-undo .
     4077   DEFINE VARIABLE v-time as integer no-undo .
     4078   for each tt-fin-statement:
     4079     delete tt-fin-statement.
     4080   end.
     4081   for each tt0-fin-statement-attr:
     4082     delete tt0-fin-statement-attr.
     4083   end.
     4084   if p-mode = 'ИЗМЕНЕНИЕ':U
     4085   or p-mode = 'ПРОСМОТР':U
     4086   then do:
     4087   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     4088     find first locked_fin-statement EXclusive-lock where
     4089                   recid(locked_fin-statement) = p-doc-rec no-wait no-error.
     4090     if locked locked_fin-statement then do:
     4091       message
     4092       vss-workfile vss-revision vss-description skip
     4093       "Запись БАНКОВСКАЯ ВЫПИСКА занята"
     4094       view-as alert-box error .
     4095       undo, return error.
     4096     end.
     4097   end.
     4098   else do:
     4099     find first locked_fin-statement no-lock where
     4100                 recid(locked_fin-statement) = p-doc-rec no-error .
     4101      if not available locked_fin-statement then do:
     4102         find first locked_fin-statement no-lock where
     4103                    locked_fin-statement.host-code = p-host-code
     4104                AND locked_fin-statement.sttm-code = p-sttm-code no-error .
     4105      end.
     4106   end.
     4107   if not available locked_fin-statement then do:
     4108     message
     4109     vss-workfile vss-revision vss-description skip
     4110     "Не найдена запись БАНКОВСКОЙ ВЫПИСКИР"
     4111     view-as alert-box error .
     4112     undo, return error.
     4113   end.
     4114   if p-mode = 'ИЗМЕНЕНИЕ':U
     4115       AND not (locked_fin-statement.status_ = 'новый':U
     4116             or locked_fin-statement.status_ = 'банк':U
     4117                )
     4118       then do:
     4119         message
     4120         "ВЫПИСКА находится в статусе" locked_fin-statement.status_ skip
     4121         "Изменение невозможно"
     4122         view-as alert-box error .
     4123         undo, return error.
     4124       end.
     4125       if locked_fin-statement.status_ = 'банк':U  then do:
     4126         assign
     4127         v-limit-access = 1
     4128         .
     4129       end.
     4130       create tt-fin-statement.
     4131       buffer-copy locked_fin-statement to tt-fin-statement.
     4132     end.
     4133     else do:
     4134       run cur-time in this-procedure ( output v-today, output v-time).
     4135       create tt-fin-statement.
     4136       assign
     4137       tt-fin-statement.host-code = p-host-code
     4138       tt-fin-statement.sttm-code  = next-value(s-fin-sttm, ub)
     4139       tt-fin-statement.curr-code = (IF AVAILABLE X_fin-schet THEN X_fin-schet.curr-code ELSE 0)
     4140       tt-fin-statement.code-schet = (IF AVAILABLE X_fin-schet THEN X_fin-schet.code-schet ELSE 0)
     4141       tt-fin-statement.code-bank = (IF AVAILABLE X_fin-bank THEN X_fin-bank.code-bank ELSE 0)
     4142       tt-fin-statement.c-schet  = (IF AVAILABLE X_fin-schet THEN X_fin-schet.c-schet ELSE '':u)
     4143       tt-fin-statement.r-schet  = (IF AVAILABLE X_fin-schet THEN X_fin-schet.r-schet ELSE '':u)
     4144       tt-fin-statement.bik  = (IF AVAILABLE X_fin-bank THEN X_fin-bank.bik ELSE '':u)
     4145       tt-fin-statement.cl-bank  = (IF AVAILABLE X_fin-bank THEN X_fin-bank.cl-bank ELSE '':u)
     4146       tt-fin-statement.bank-name = (IF AVAILABLE X_fin-bank THEN X_fin-bank.bank-name ELSE '':u)
     4147       tt-fin-statement.bank-city = (IF AVAILABLE X_fin-bank THEN X_fin-bank.bank-city ELSE '':u)
     4148       tt-fin-statement.cli-name  = X_CLIENTS.obj-NAME
     4149       tt-fin-statement.PS  = '':U
     4150       tt-fin-statement.prn-doc-code  = '':U
     4151       tt-fin-statement.num-docs  = 0
     4152       tt-fin-statement.fins-ext-doc-type = '':U
     4153       tt-fin-statement.fins-doc-type = '':U
     4154       tt-fin-statement.start-date  = v-today
     4155       tt-fin-statement.end-date  = v-TODAY
     4156       tt-fin-statement.doc-date      = v-today
     4157       tt-fin-statement.fins-doc-type  = 'стд':U
     4158       tt-fin-statement.fins-ext-doc-type  = 'стд':U
     4159       tt-fin-statement.prn-doc-code  = "":U
     4160       tt-fin-statement.status_       = 'новый':U
     4161       .
     4162     end.
     4163   END PROCEDURE.
     4164   PROCEDURE lock-proc :
     4165   DEFINE INPUT PARAMETER p-loc-doc AS LOGICAL NO-UNDO.
     4166   if p-mode = 'ПРОСМОТР':U then return.
     4167   if p-loc-doc then do:
     4168       DISABLE
     4169       b-schet
     4170       tt-fin-statement.start-date
     4171       tt-fin-statement.end-date
     4172       tt-fin-statement.start-sum-doc-th
     4173       with frame Dialog-Frame
     4174       .
     4175   end.
     4176   else do:
     4177       ENABLE
     4178       b-schet WHEN tt-fin-statement.STATUS_ = 'новый':U
     4179       tt-fin-statement.start-sum-doc-th WHEN tt-fin-statement.STATUS_ = 'новый':U
     4180       tt-fin-statement.start-date WHEN tt-fin-statement.STATUS_ = 'новый':U
     4181       tt-fin-statement.end-date WHEN tt-fin-statement.STATUS_ = 'новый':U
     4182       with frame Dialog-Frame
     4183       .
     4184   end.
     4185   IF tt-fin-statement.code-schet <> 0 THEN DO:
     4186       ENABLE
     4187       b-add WHEN tt-fin-statement.STATUS_ = 'новый':U
     4188       b-lookup WHEN tt-fin-statement.STATUS_ = 'новый':U
     4189       b-del WHEN tt-fin-statement.STATUS_ = 'новый':U
     4190       with frame Dialog-Frame .
     4191   END.
     4192   ELSE DO:
     4193       DISABLE
     4194       b-add
     4195       b-lookup
     4196       b-del
     4197       with frame Dialog-Frame .
     4198   END.
     4199   END PROCEDURE.
     4200   PROCEDURE MyEnable :
     4201   ASSIGN
     4202   LOCKED_fin-statement-line.prn-doc-code:READ-ONLY  IN BROWSE  br-lines = YES
     4203   v-cli-name:resizable IN BROWSE  br-lines  = YES
     4204   b-add:MENU-MOUSE in frame Dialog-Frame = 1
     4205   .
     4206   ASSIGN
     4207   v-tab-order = "b-exit,b-quit,b-mark,b-add,b-lookup,b-del,b-print,b-hist,b-help," +
     4208                 "prn-doc-code,doc-date,bank-date," +
     4209                 "start-date,end-date,start-sum-doc,start-sum-doc-th,fact-date,in-sum-doc,out-sum-doc,end-sum-doc,b-schet"
     4210   .
     4211   DISPLAY
     4212   F-curr-abbr
     4213   mark-num
     4214   f-bank
     4215   f-bank-data
     4216   f-th-data
     4217   WITH FRAME Dialog-Frame.
     4218   IF AVAILABLE tt-fin-statement THEN
     4219   DISPLAY
     4220   tt-fin-statement.num-docs
     4221   tt-fin-statement.num-docs-th
     4222   tt-fin-statement.prn-doc-code
     4223   tt-fin-statement.sttm-code
     4224   tt-fin-statement.doc-date
     4225   tt-fin-statement.bank-date
     4226   tt-fin-statement.fact-date
     4227   tt-fin-statement.curr-code
     4228   tt-fin-statement.start-date
     4229   tt-fin-statement.end-date
     4230   tt-fin-statement.start-sum-doc tt-fin-statement.start-sum-doc-th
     4231   tt-fin-statement.in-sum-doc tt-fin-statement.in-sum-doc-th
     4232   tt-fin-statement.out-sum-doc tt-fin-statement.out-sum-doc-th
     4233   tt-fin-statement.end-sum-doc tt-fin-statement.end-sum-doc-th
     4234   tt-fin-statement.r-schet
     4235   tt-fin-statement.bank-name
     4236   tt-fin-statement.bank-city
     4237   tt-fin-statement.bik
     4238   tt-fin-statement.PS
     4239   WITH FRAME Dialog-Frame.
     4240   e-line-ps:READ-ONLY IN FRAME Dialog-Frame = YES.
     4241   ENABLE
     4242   B-exit WHEN p-mode <> 'ПРОСМОТР':U
     4243   b-quit
     4244   B-mark WHEN NOT (p-mode = 'ПРОСМОТР':U AND p-line-rec = ?)
     4245   B-add   WHEN p-mode <> 'ПРОСМОТР':U  and v-limit-access = 0
     4246   B-lookup
     4247   B-del   WHEN p-mode <> 'ПРОСМОТР':U  and v-limit-access = 0
     4248   B-print
     4249   B-hist WHEN p-mode <> 'ДОБАВЛЕНИЕ':U
     4250   B-Help
     4251   tt-fin-statement.prn-doc-code WHEN p-mode <> 'ПРОСМОТР':U
     4252   tt-fin-statement.PS
     4253   tt-fin-statement.doc-date     WHEN p-mode <> 'ПРОСМОТР':U
     4254   tt-fin-statement.bank-date    WHEN p-mode <> 'ПРОСМОТР':U
     4255   B-schet                       WHEN (p-mode <> 'ПРОСМОТР':U AND tt-fin-statement.num-docs = 0)
     4256   BR-lines
     4257   e-line-ps
     4258   mark-num
     4259   tt-fin-statement.start-date    WHEN (p-mode <> 'ПРОСМОТР':U AND tt-fin-statement.STATUS_ = 'новый':U)
     4260   tt-fin-statement.end-date      WHEN (p-mode <> 'ПРОСМОТР':U AND tt-fin-statement.STATUS_ = 'новый':U)
     4261   tt-fin-statement.num-docs      WHEN (p-mode <> 'ПРОСМОТР':U AND tt-fin-statement.STATUS_ = 'новый':U AND tt-fin-statement.cl-bank = '':U)
     4262   tt-fin-statement.start-sum-doc WHEN (p-mode <> 'ПРОСМОТР':U AND tt-fin-statement.STATUS_ = 'новый':U AND tt-fin-statement.cl-bank = '':U)
     4263   tt-fin-statement.start-sum-doc-th WHEN (p-mode <> 'ПРОСМОТР':U AND tt-fin-statement.STATUS_ = 'новый':U)
     4264   tt-fin-statement.in-sum-doc    WHEN (p-mode <> 'ПРОСМОТР':U AND tt-fin-statement.STATUS_ = 'новый':U AND tt-fin-statement.cl-bank = '':U)
     4265   tt-fin-statement.out-sum-doc   WHEN (p-mode <> 'ПРОСМОТР':U AND tt-fin-statement.STATUS_ = 'новый':U AND tt-fin-statement.cl-bank = '':U)
     4266   tt-fin-statement.end-sum-doc   WHEN (p-mode <> 'ПРОСМОТР':U AND tt-fin-statement.STATUS_ = 'новый':U AND tt-fin-statement.cl-bank = '':U)
     4267   WITH FRAME Dialog-Frame.
     4268   VIEW FRAME Dialog-Frame.
     4269   IF p-mode = 'ПРОСМОТР':U THEN DO:
     4270       HIDE
     4271       b-exit
     4272       IN FRAME Dialog-Frame.
     4273       ASSIGN
     4274       b-quit:LABEL = '&Выход'
     4275       b-quit:COLUMN = 1
     4276       tt-fin-statement.ps:READ-ONLY IN FRAME Dialog-Frame = YES
     4277       .
     4278   END.
     4279   APPLY "Value-changed" TO tt-fin-statement.curr-code.
     4280   ASSIGN FRAME Dialog-Frame:TITLE = substitute("Выписка &1", tt-fin-statement.prn-doc-code).
     4281   END PROCEDURE.
     4282   PROCEDURE OpenBr :
     4283   define input  parameter p-open-query     as logical   no-undo .
     4284   define input  parameter p-find-next      as logical   no-undo .
     4285   define input  parameter p-find-condition as character no-undo .
     4286   OPEN QUERY br-lines FOR EACH locked_fin-statement-line NO-LOCK where
     4287       locked_fin-statement-line.host-code = tt-fin-statement.host-code
     4288    AND locked_fin-statement-line.sttm-code = tt-fin-statement.sttm-code INDEXED-REPOSITION.
     4289   END PROCEDURE.
     4290   PROCEDURE proc-b-add :
     4291   define input parameter p-fin-doc-type like ub.fin-doc.fin-doc-type no-undo .
     4292   define variable v-rid-list as character no-undo .
     4293   define variable v-line-rec as recid no-undo .
     4294   define variable v-doc-rec as recid no-undo .
     4295   DEFINE VARIABLE v-pay-date LIKE ub.fin-doc.fact-date NO-UNDO.
     4296   define variable v-bik like ub.fin-statement-line.rp-bik no-undo .
     4297   define variable v-bank-name like ub.fin-statement-line.rp-bank-name no-undo .
     4298   define variable v-bank-city like ub.fin-statement-line.rp-bank-city no-undo .
     4299   define variable v-c-schet like ub.fin-statement-line.rp-c-schet no-undo .
     4300   define variable v-r-schet like ub.fin-statement-line.rp-r-schet no-undo .
     4301   define variable v-name like ub.fin-statement-line.rp-name no-undo .
     4302   define variable v-inn like ub.fin-statement-line.rp-inn no-undo .
     4303   define variable v-kpp like ub.fin-statement-line.rp-kpp no-undo .
     4304   DEFINE VARIABLE v-prn-doc-code LIKE ub.fin-doc.prn-doc-code NO-UNDO.
     4305   DEFINE VARIABLE v-fin-ext-doc-type LIKE ub.fin-doc.fin-ext-doc-type NO-UNDO.
     4306   define variable v-sum-doc as decimal no-undo .
     4307   define variable v-ps as character no-undo .
     4308   define variable ii as integer no-undo .
     4309   define buffer buf_fin-doc for ub.fin-doc.
     4310   run proc-save in this-procedure ( input no) No-ERROR.
     4311   if error-status:error then do:
     4312      MESSAGE ERROR-STATUS:GET-MESSAGE(1) VIEW-AS ALERT-BOX.
     4313      return error.
     4314   END.
     4315   assign
     4316   v-doc-rec = recid(locked_fin-statement)
     4317   v-line-rec = ?
     4318   .
     4319   IF p-fin-doc-type = 'no-th':U THEN DO:
     4320     run ref/finsttli.w (
     4321                     input tt-fin-statement.start-date
     4322                    ,input tt-fin-statement.end-date
     4323                    ,OUTPUT v-prn-doc-code
     4324                    ,output v-fin-ext-doc-type
     4325                    ,output v-pay-date
     4326                    ,output v-bik
     4327                    ,output v-bank-name
     4328                    ,output v-bank-city
     4329                    ,output v-c-schet
     4330                    ,output v-r-schet
     4331                    ,output v-name
     4332                    ,output v-inn
     4333                    ,output v-kpp
     4334                    ,OUTPUT v-sum-doc
     4335                    ,output v-ps
     4336                    ) NO-ERROR.
     4337     IF ERROR-STATUS:ERROR
     4338     OR v-prn-doc-code = '':U THEN DO:
     4339         RETURN .
     4340     END.
     4341       run ref/finsttml.p (
     4342                      INPUT NO
     4343                     ,INPUT-OUTPUT v-line-rec
     4344                     ,INPUT 'ДОБАВЛЕНИЕ':U
     4345                     ,INPUT tt-fin-statement.host-code
     4346                     ,INPUT tt-fin-statement.sttm-code
     4347                     ,INPUT 0
     4348                     ,INPUT v-pay-date
     4349                     ,INPUT v-prn-doc-code
     4350                     ,INPUT v-fin-ext-doc-type
     4351                     ,input v-bik
     4352                     ,input v-bank-name
     4353                     ,input v-bank-city
     4354                     ,input v-c-schet
     4355                     ,input v-r-schet
     4356                     ,input v-name
     4357                     ,input v-inn
     4358                     ,input v-kpp
     4359                     ,INPUT v-sum-doc
     4360                     ,INPUT '':U
     4361                     ,input v-ps
     4362                       )
     4363           no-error.
     4364       if error-status:error then do:
     4365         run control-line in this-procedure ( output lock-doc).
     4366         run lock-proc in this-procedure ( input lock-doc).
     4367         return error.
     4368       end.
     4369   END.
     4370   ELSE DO:
     4371       run ref/findocs.w (
     4372                      input parparentproc
     4373                     ,input p-curr-host-code
     4374                     ,input "b-sel,b-mark":U
     4375                     ,input (IF p-fin-doc-type = 'рпп':U
     4376                             THEN "schet-fact-order-expense-cashless":U
     4377                             ELSE "schet-fact-order-income-cashless":U)
     4378                     ,input 'все':U
     4379                     ,input tt-fin-statement.host-code
     4380                     ,input "":U
     4381                     ,input 0
     4382                     ,input 'факт':U
     4383                     ,input "":U
     4384                     ,input p-fins-ext-doc-type
     4385                     ,input tt-fin-statement.start-date
     4386                     ,input tt-fin-statement.end-date
     4387                     ,input "":U
     4388                     ,input "":U
     4389                     ,input 0
     4390                     ,input "":U
     4391                     ,input "":U
     4392                     ,input 0
     4393                     ,input "":U
     4394                     ,input ?
     4395                     ,input X_fin-schet.code-schet
     4396                     ,input X_fin-schet.code-schet
     4397                     ,input 0
     4398                     ,input 0
     4399                     ,input 0
     4400                     ,input 0
     4401                     ,input 0
     4402                     ,input-output v-rid-list) NO-ERROR.
     4403       IF v-rid-list <> '':U THEN DO:
     4404           _ii:
     4405           DO ii = 1 TO NUM-ENTRIES(v-rid-list)
     4406           ON ERROR UNDO, NEXT _ii
     4407           ON stop UNDO, NEXT _ii
     4408               :
     4409               FIND FIRST buf_fin-doc EXCLUSIVE-LOCK where
     4410                      recid(buf_fin-doc) = INTEGER(ENTRY(ii, v-rid-list)).
     4411               run ref/finsttml.p
     4412                             (INPUT NO
     4413                             ,INPUT-OUTPUT v-line-rec
     4414                             ,INPUT 'ДОБАВЛЕНИЕ':U
     4415                             ,INPUT tt-fin-statement.host-code
     4416                             ,INPUT tt-fin-statement.sttm-code
     4417                             ,INPUT buf_fin-doc.fin-doc-code
     4418                             ,INPUT buf_fin-doc.pay-date
     4419                             ,INPUT buf_fin-doc.prn-doc-code
     4420                             ,INPUT buf_fin-doc.fin-ext-doc-type
     4421                             ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     4422                                   then buf_fin-doc.receiver-bik
     4423                                   else buf_fin-doc.payer-bik)
     4424                             ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     4425                                   then buf_fin-doc.receiver-bank-name
     4426                                   else buf_fin-doc.payer-bank-name)
     4427                             ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     4428                                   then buf_fin-doc.receiver-bank-city
     4429                                   else buf_fin-doc.payer-bank-city)
     4430                             ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     4431                                   then buf_fin-doc.receiver-c-schet
     4432                                   else buf_fin-doc.payer-c-schet )
     4433                             ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     4434                                   then buf_fin-doc.receiver-r-schet
     4435                                   else buf_fin-doc.payer-r-schet )
     4436                             ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     4437                                   then buf_fin-doc.receiver-name
     4438                                   else buf_fin-doc.payer-name )
     4439                             ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     4440                                   then buf_fin-doc.receiver-inn
     4441                                   else buf_fin-doc.payer-inn )
     4442                             ,input (if buf_fin-doc.fin-ext-doc-type = 'рпп':U
     4443                                   then buf_fin-doc.receiver-kpp
     4444                                   else buf_fin-doc.payer-kpp )
     4445                             ,INPUT buf_fin-doc.sum-doc
     4446                             ,INPUT '':U
     4447                             ,input buf_fin-doc.ps
     4448                               )
     4449                   no-error.
     4450               if error-status:error then do:
     4451                 run control-line in this-procedure ( output lock-doc).
     4452                 run lock-proc in this-procedure ( input lock-doc).
     4453                 return error.
     4454               end.
     4455           END.
     4456       END.
     4457   END.
     4458   BUFFER-COPY LOCKED_fin-statement TO tt-fin-statement.
     4459   DISPLAY
     4460   tt-fin-statement.start-sum-doc-th
     4461   tt-fin-statement.in-sum-doc-th
     4462   tt-fin-statement.out-sum-doc-th
     4463   tt-fin-statement.end-sum-doc-th
     4464   tt-fin-statement.num-docs-th
     4465   tt-fin-statement.num-docs
     4466   with frame Dialog-Frame .
     4467   run control-line in this-procedure ( output lock-doc).
     4468   run lock-proc in this-procedure ( input lock-doc).
     4469   RUN OpenBr IN THIS-PROCEDURE ( input YES, input NO, input NO).
     4470   reposition br-lines to recid v-line-rec no-error.
     4471   apply "entry" to br-lines.
     4472   END PROCEDURE.
     4473   PROCEDURE proc-b-del :
     4474   DEFINE INPUT PARAMETER p-rid-list AS CHARACTER NO-UNDO.
     4475   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     4476   DEFINE VARIABLE v-line-rec AS RECID NO-UNDO.
     4477   DEFINE BUFFER buf_fin-statement-line FOR ub.fin-statement-line.
     4478   _ii:
     4479   DO ii = 1 TO NUM-ENTRIES(p-rid-list)
     4480   ON ERROR UNDO, NEXT _ii
     4481   ON stop UNDO, NEXT _ii
     4482       :
     4483       FIND FIRST buf_fin-statement-line EXCLUSIVE-LOCK where
     4484              recid(buf_fin-statement-line) = INTEGER(ENTRY(ii, p-rid-list)).
     4485           v-line-rec = RECID(buf_fin-statement-line).
     4486           run ref/finsttml.p (
     4487                          INPUT NO
     4488                         ,INPUT-OUTPUT v-line-rec
     4489                         ,INPUT 'удаление':U
     4490                         ,INPUT tt-fin-statement.host-code
     4491                         ,INPUT tt-fin-statement.sttm-code
     4492                         ,INPUT buf_fin-statement-line.fin-doc-code
     4493                         ,INPUT buf_fin-statement-line.pay-date
     4494                         ,INPUT buf_fin-statement-line.prn-doc-code
     4495                         ,INPUT buf_fin-statement-line.fin-ext-doc-type
     4496                         ,input buf_fin-statement-line.rp-bik
     4497                         ,input buf_fin-statement-line.rp-bank-name
     4498                         ,input buf_fin-statement-line.rp-bank-city
     4499                         ,input buf_fin-statement-line.rp-c-schet
     4500                         ,input buf_fin-statement-line.rp-r-schet
     4501                         ,input buf_fin-statement-line.rp-name
     4502                         ,input buf_fin-statement-line.rp-inn
     4503                         ,input buf_fin-statement-line.rp-kpp
     4504                         ,INPUT buf_fin-statement-line.sum-doc
     4505                         ,INPUT '':U
     4506                         ,input '':U
     4507                           )
     4508               no-error.
     4509           if error-status:error then do:
     4510             run control-line in this-procedure ( output lock-doc).
     4511             run lock-proc in this-procedure ( input lock-doc).
     4512             return error.
     4513           end.
     4514   END.
     4515   BUFFER-COPY LOCKED_fin-statement TO tt-fin-statement.
     4516   DISPLAY
     4517   tt-fin-statement.start-sum-doc-th
     4518   tt-fin-statement.in-sum-doc-th
     4519   tt-fin-statement.out-sum-doc-th
     4520   tt-fin-statement.end-sum-doc-th
     4521   tt-fin-statement.num-docs-th
     4522   with frame Dialog-Frame .
     4523   run control-line in this-procedure ( output lock-doc).
     4524   run lock-proc in this-procedure ( input lock-doc).
     4525   RUN OpenBr IN THIS-PROCEDURE ( input YES, input NO, input NO).
     4526   reposition br-lines to recid v-line-rec no-error.
     4527   apply "entry" to br-lines.
     4528   END PROCEDURE.
     4529   PROCEDURE proc-save :
     4530   define input parameter parlines-exist as logical no-undo .
     4531    IF p-mode = 'ПРОСМОТР':U THEN DO:
     4532       RETURN.
     4533    END.
     4534    DO TRANSACTION
     4535        ON ERROR UNDO, RETURN ERROR
     4536        ON stop UNDO, RETURN ERROR:
     4537    assign
     4538    frame Dialog-Frame
     4539    tt-fin-statement.prn-doc-code
     4540    tt-fin-statement.doc-date
     4541    tt-fin-statement.start-date
     4542    tt-fin-statement.end-date
     4543    tt-fin-statement.start-sum-doc-th
     4544    tt-fin-statement.start-sum-doc when tt-fin-statement.cl-bank = '':U
     4545    tt-fin-statement.end-sum-doc when tt-fin-statement.cl-bank = '':U
     4546    tt-fin-statement.in-sum-doc when tt-fin-statement.cl-bank = '':U
     4547    tt-fin-statement.out-sum-doc when tt-fin-statement.cl-bank = '':U
     4548    tt-fin-statement.num-docs when tt-fin-statement.cl-bank = '':U
     4549    tt-fin-statement.sum-doc = tt-fin-statement.in-sum-doc - tt-fin-statement.out-sum-doc
     4550    tt-fin-statement.PS
     4551    tt-fin-statement.start-date
     4552    tt-fin-statement.end-date
     4553    .
     4554    v-doc-rec = (IF AVAILABLE locked_fin-statement THEN recid(locked_fin-statement) ELSE ?).
     4555    run ref/finsttm0.p
     4556                    (input no
     4557                    ,input-output v-doc-rec
     4558                    ,input       (IF v-first AND p-mode = 'ДОБАВЛЕНИЕ':U THEN  'ДОБАВЛЕНИЕ':U ELSE 'ИЗМЕНЕНИЕ':U)
     4559                    ,input        '':U
     4560                    ,input tt-fin-statement.host-code            ,input tt-fin-statement.sttm-code            ,input tt-fin-statement.curr-code            ,input tt-fin-statement.doc-date             ,input tt-fin-statement.bank-date            ,input tt-fin-statement.fact-date            ,input tt-fin-statement.fins-doc-type        ,input tt-fin-statement.fins-ext-doc-type    ,input tt-fin-statement.code-bank            ,input tt-fin-statement.bank-name            ,input tt-fin-statement.bank-city            ,input tt-fin-statement.bik                  ,input tt-fin-statement.code-schet           ,input tt-fin-statement.r-schet              ,input tt-fin-statement.c-schet              ,input tt-fin-statement.cli-name             ,input tt-fin-statement.prn-doc-code         ,input tt-fin-statement.PS                   ,input tt-fin-statement.sum-doc              ,input tt-fin-statement.start-sum-doc-th     ,input tt-fin-statement.start-sum-doc        ,input tt-fin-statement.in-sum-doc           ,input tt-fin-statement.out-sum-doc          ,input tt-fin-statement.end-sum-doc          ,input tt-fin-statement.num-docs             ,input tt-fin-statement.start-date           ,input tt-fin-statement.end-date
     4561                    ,input 'новый':U
     4562                    ,input parlines-exist
     4563                    ) no-error .
     4564   if error-status:error then do:
     4565   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4566   define variable fh as widget-handle no-undo .
     4567   define variable hh as widget-handle no-undo .
     4568   define variable rv as character no-undo .
     4569   assign
     4570   rv = entry(1, return-value , chr(4)).
     4571   if rv <> "":U then do:
     4572     assign
     4573     fh = frame Dialog-Frame:first-child
     4574     hh = fh:first-child
     4575     .
     4576     do while valid-handle(hh):
     4577       if hh:name = rv then do:
     4578         APPLY "ENTRY" to hh.
     4579         undo ,
     4580         return error.
     4581       end.
     4582       hh = hh:next-sibling.
     4583     end.
     4584   end.
     4585     undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1)).
     4586   end.
     4587   else do:
     4588     IF p-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
     4589        FIND FIRST LOCKED_fin-statement EXCLUSIVE-LOCK WHERE
     4590                  recid(LOCKED_fin-statement) = v-doc-rec.
     4591          v-first = NO.
     4592       hide
     4593       b-quit in frame Dialog-Frame .
     4594       assign
     4595       b-exit:label in frame Dialog-Frame = "&Выход"
     4596       .
     4597     END.
     4598    end.
     4599   END.
     4600   p-doc-rec = ?.
     4601   END PROCEDURE.
     4602   FUNCTION get-cli-name RETURNS CHARACTER
     4603     (BUFFER buf_fin-statement-line FOR ub.fin-statement-line ) :
     4604   DEFINE BUFFER buf_fin-doc FOR ub.fin-doc.
     4605   IF buf_fin-statement-line.fin-doc-code = 0  THEN DO:
     4606       RETURN '':U.
     4607   END.
     4608   FIND FIRST buf_fin-doc NO-LOCK WHERE
     4609             buf_fin-doc.host-code = buf_fin-statement-line.host-code
     4610        AND  buf_fin-doc.fin-doc-code = buf_fin-statement-line.fin-doc-code NO-ERROR.
     4611   IF NOT AVAILABLE buf_fin-doc THEN DO:
     4612       RETURN "!!!Не найден платеж".
     4613   END.
     4614   CASE buf_fin-doc.fin-ext-doc-type:
     4615       WHEN 'ппп':U THEN DO:
     4616           RETURN buf_fin-doc.payer-name.
     4617       END.
     4618       WHEN 'рпп':U THEN DO:
     4619          RETURN buf_fin-doc.receiver-name.
     4620       END.
     4621   END CASE.
     4622     RETURN "".
     4623   END FUNCTION.
