      876           v-label-handle4 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      877         .
      878       end.
      879     end.
      880     ON CHOOSE OF MENU-ITEM m-ed-date4-1 in menu m-ed-date4 DO:
      881       apply "ctrl-b":U to f-pay-date in frame Dialog-Frame .
      882     END.
      883     ON CHOOSE OF MENU-ITEM m-ed-date4-2 in menu m-ed-date4 DO:
      884       apply "ctrl-d":U to f-pay-date in frame Dialog-Frame .
      885     END.
      886     ON CHOOSE OF MENU-ITEM m-ed-date4-3 in menu m-ed-date4 DO:
      887       apply "ctrl-e":U to f-pay-date in frame Dialog-Frame .
      888     END.
      889     ON CHOOSE OF MENU-ITEM m-ed-date4-4 in menu m-ed-date4 DO:
      890       apply "ctrl-f":U to f-pay-date in frame Dialog-Frame .
      891     END.
      892   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      893   ON RETURN ANYWHERE
      894   DO:
      895   define variable ii as integer no-undo .
      896   define variable fh as widget-handle no-undo .
      897   define variable hh as widget-handle no-undo .
      898   define variable v-next-widget-name as character no-undo .
      899     if v-tab-order <> '' then do:
      900       assign
      901       ii = lookup(self:name, v-tab-order).
      902       if ii = num-entries(v-tab-order) then do:
      903           return no-apply.
      904       end.
      905       if self:type <> "BUTTON" and
      906         self:type <> "EDITOR"  then do:
      907         run proc-move-forward in this-procedure .
      908         return no-apply.
      909       end.
      910       if self:type = "BUTTON" then do:
      911         APPLY "CHOOSE" to self.
      912       end.
      913       if self:type = "TOGGLE-BOX" then
      914       self:BGCOLOR = ?.
      915       assign
      916       ii = ii + 1
      917       v-next-widget-name = entry(ii, v-tab-order)
      918       no-error .
      919       if error-status:error then do:
      920         assign
      921         ii = 1
      922         v-next-widget-name = entry( ii, v-tab-order)
      923         .
      924       end.
      925       assign
      926       fh = frame Dialog-Frame:first-child
      927       hh = fh:first-child
      928       .
      929       do while valid-handle(hh):
      930         if hh:name = v-next-widget-name then do:
      931           if hh:sensitive  = yes
      932           AND hh:visible = yes then do:
      933             APPLY "ENTRY" to hh.
      934             return no-apply.
      935           end.
      936           else do:
      937             APPLY "TAB" to hh.
      938             return no-apply.
      939           end.
      940         end.
      941         hh = hh:next-sibling.
      942       end.
      943     end.
      944   END.
      945   procedure proc-move-forward :
      946   define variable ii as integer no-undo .
      947   define variable fh as widget-handle no-undo .
      948   define variable hh as widget-handle no-undo .
      949   define variable v-next-widget-name as character no-undo .
      950   do
      951   on error undo, return error
      952   :
      953     if v-tab-order <> '' then do:
      954       if self:type = "TOGGLE-BOX" then
      955       self:BGCOLOR = ?.
      956       assign
      957       ii = lookup(self:name, v-tab-order).
      958       assign
      959       ii = ii + 1
      960       v-next-widget-name = entry(ii, v-tab-order)
      961       no-error .
      962       if error-status:error then do:
      963         assign
      964         ii = 1
      965         v-next-widget-name = entry( ii, v-tab-order)
      966         .
      967       end.
      968       assign
      969       fh = frame Dialog-Frame:first-child
      970       hh = fh:first-child
      971       .
      972       do while valid-handle(hh):
      973         if hh:name = v-next-widget-name then do:
      974           if hh:sensitive  = yes
      975           AND hh:visible = yes then do:
      976             APPLY "ENTRY" to hh.
      977             return.
      978           end.
      979           else do:
      980             assign
      981             ii = ii + 1
      982             v-next-widget-name = entry(ii, v-tab-order)
      983             no-error .
      984             if error-status:error then do:
      985               assign
      986               ii = 1
      987               v-next-widget-name = entry( ii, v-tab-order)
      988               .
      989             end.
      990           end.
      991         end.
      992         hh = hh:next-sibling.
      993       end.
      994     end.
      995   end.
      996   end procedure.
      997   MAIN-BLOCK:
      998   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      999      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1000     RUN Myenable IN THIS-PROCEDURE.
     1001     WAIT-FOR GO OF FRAME Dialog-Frame.
     1002   END.
     1003   RUN disable_UI.
     1004   PROCEDURE disable_UI :
     1005     HIDE FRAME Dialog-Frame.
     1006   END PROCEDURE.
     1007   PROCEDURE enable_UI :
     1008     DISPLAY f-prn-doc-code S-fin-ext-doc-type f-bik f-bank-name f-bank-city
     1009             f-c-schet f-r-schet f-name f-inn f-kpp f-pay-date f-sum E-ps
     1010         WITH FRAME Dialog-Frame.
     1011     ENABLE B-exit b-quit B-Help f-prn-doc-code S-fin-ext-doc-type f-bik
     1012            f-bank-name f-bank-city f-c-schet f-r-schet f-name f-inn f-kpp
     1013            f-pay-date f-sum E-ps
     1014         WITH FRAME Dialog-Frame.
     1015     VIEW FRAME Dialog-Frame.
     1016   END PROCEDURE.
     1017   PROCEDURE MyEnable :
     1018   DEFINE VARIABLE V-ITEM-1 AS CHARACTER NO-UNDO.
     1019   DEFINE VARIABLE V-ITEM-2 AS CHARACTER NO-UNDO.
     1020   ASSIGN
     1021   f-kpp:label in frame Dialog-Frame = "КПП"
     1022   f-inn:label in frame Dialog-Frame = "ИНН"
     1023   v-tab-order = "f-prn-doc-code,S-fin-ext-doc-type,f-bik,f-bank-name,f-bank-city,f-c-schet," +
     1024                 "f-r-schet,f-name,f-inn,f-kpp,f-pay-date,f-sum,e-ps".
     1025   V-ITEM-1 = entry (lookup ('ппп':U, 'пко,рко,ппп,рпп,апп,апр,':U), 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,апп,апр':U) + chr(44) +
     1026               'ппп':U .
     1027   V-ITEM-2 = entry (lookup ('рпп':U, 'пко,рко,ппп,рпп,апп,апр,':U), 'приходный кассовый ордер,расходный кассовый ордер,приходное платежное поручение,расходное платежное поручение,апп,апр':U) + chr(44) +
     1028               'рпп':U.
     1029   ASSIGN
     1030   s-fin-ext-doc-type:LIST-ITEM-PAIRS in frame Dialog-Frame = V-ITEM-1 + chr(44) + V-ITEM-2.
     1031   DISPLAY
     1032   f-prn-doc-code
     1033   S-fin-ext-doc-type
     1034   f-bik
     1035   f-bank-name
     1036   f-bank-city
     1037   f-c-schet
     1038   f-r-schet
     1039   f-name
     1040   f-inn
     1041   f-kpp
     1042   f-sum
     1043   WITH FRAME Dialog-Frame.
     1044   ENABLE
     1045   B-exit
     1046   b-quit
     1047   B-Help
     1048   f-prn-doc-code
     1049   S-fin-ext-doc-type
     1050   f-bik
     1051   f-bank-name
     1052   f-bank-city
     1053   f-c-schet
     1054   f-r-schet
     1055   f-name
     1056   f-inn
     1057   f-kpp
     1058   f-pay-date
     1059   f-sum
     1060   E-PS
     1061   WITH FRAME Dialog-Frame.
     1062   VIEW FRAME Dialog-Frame.
     1063   END PROCEDURE.
