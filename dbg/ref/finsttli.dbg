      582   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      583   procedure minbtn-set :
      584       do
      585           on error undo, return error return-value
      586           :
      587           define variable ii              as integer       no-undo .
      588           define variable fh              as widget-handle no-undo .
      589           define variable hh              as widget-handle no-undo .
      590           define variable v-h             as handle        extent 4 no-undo .
      591           define variable v-name-button   as character     no-undo .
      592           define variable v-help-old-x    as decimal       no-undo .
      593           define variable v-help-old-y    as decimal       no-undo .
      594           define variable v-help-old-size as decimal       no-undo .
      595           define variable v-frame-width   as decimal       no-undo .
      596           define variable jj              as integer       no-undo .
      597           do
      598               on error undo, return error
      599               :
      600               assign
      601                   v-frame-width = frame Dialog-Frame:width - 0.3
      602                   fh            = frame Dialog-Frame:first-child
      603                   hh            = fh:first-child
      604                   ii            = 1
      605                   .
      606               do while valid-handle(hh):
      607                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      608                   do:
      609                       case lc(hh:name) :
      610                           when "b-help" then
      611                               do:
      612                                   hh:load-image-up("cmp/b-help.bmp":u) .
      613                                   hh:load-image-down("cmp/b-help.bmp":u) .
      614                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      615                                   hh:TOOLTIP = "Помощь" .
      616                                   v-help-old-x = hh:column .
      617                                   v-help-old-y = hh:row    .
      618                                   v-help-old-size = hh:width .
      619                                   hh:width-chars = 2.5 .
      620                               end.
      621                           when "b-print" then
      622                               do:
      623                                   hh:load-image("cmp/b-print.bmp":u) .
      624                                   hh:TOOLTIP = "Печать" .
      625                                   v-h[ii] = hh:handle .
      626                                   ii = ii + 1 .
      627                                   hh:width-chars = 3 .
      628                               end.
      629                           when "b-history" or
      630                           when "b-hist" then
      631                               do:
      632                                   hh:load-image("cmp/b-hist.bmp":u) .
      633                                   hh:TOOLTIP = "История" .
      634                                   v-h[ii] = hh:handle .
      635                                   ii = ii + 1 .
      636                                   hh:width-chars = 3 .
      637                               end.
      638                           when "b-sch" then
      639                               do:
      640                                   hh:load-image("cmp/b-sch.bmp":u) .
      641                                   hh:TOOLTIP = "Установка Фильтра" .
      642                                   v-h[ii] = hh:handle .
      643                                   ii = ii + 1 .
      644                                   hh:width-chars = 3 .
      645                               end.
      646                           when "b-hist-user" then
      647                               do:
      648                                   hh:load-image("cmp/b-hist.bmp":u) .
      649                                   hh:TOOLTIP = "История пользователя" .
      650                                   ii = ii + 1 .
      651                               end.
      652                       end case.
      653                   end.
      654                   hh = hh:next-sibling.
      655               end.
      656               b-help:column = v-frame-width - b-help:width-chars.
      657               jj = 0.
      658               repeat ii = 4 to 1 by -1 :
      659                   if valid-handle (v-h[ii] ) then
      660                   do:
      661                       jj  = jj + 1 .
      662                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      663                       v-h[ii]:row    = v-help-old-y .
      664                   end.
      665               end.
      666           end.
      667       end.
      668   end procedure.
      669   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      670   on ' ' of f-pay-date in frame Dialog-Frame
      671   do:
      672     if (can-query (self, "sensitive")
      673        and
      674        self :sensitive = true
      675        )
      676     or (can-query (self, "read-only")
      677        and
      678        self :read-only = false
      679        )
      680     then do:
      681       assign
      682         self :screen-value = ?
      683       .
      684     end.
      685     return no-apply.
      686   end.
      687   on delete-character of f-pay-date in frame Dialog-Frame
      688   do:
      689     if (can-query (self, "sensitive")
      690        and
      691        self :sensitive = true
      692        )
      693     or (can-query (self, "read-only")
      694        and
      695        self :read-only = false
      696        )
      697     then do:
      698       assign
      699         self :screen-value = ?
      700       .
      701     end.
      702     return no-apply.
      703   end.
      704   on ctrl-d of f-pay-date in frame Dialog-Frame
      705   do:
      706     define variable v-curr-sv-date as date no-undo .
      707     if (can-query (self, "sensitive")
      708        and
      709        self :sensitive = true
      710        )
      711     or (can-query (self, "read-only")
      712        and
      713        self :read-only = false
      714        )
      715     then do:
      716       if self :handle <> focus :handle
      717       then do:
      718         apply "entry":u to self .
      719       end.
      720       run gbl/getcurdt.p
      721         (output v-curr-sv-date
      722         ) .
      723       assign
      724         self :screen-value = string(v-curr-sv-date) .
      725       .
      726     end.
      727     return no-apply.
      728   end.
      729   on ctrl-b of f-pay-date in frame Dialog-Frame
      730   do:
      731     if (can-query (self, "sensitive")
      732        and
      733        self :sensitive = true
      734        )
      735     or (can-query (self, "read-only")
      736        and
      737        self :read-only = false
      738        )
      739     then do:
      740       if self :handle <> focus :handle
      741       then do:
      742         apply "entry":u to self .
      743       end.
      744       define variable v-curr-sv-date as date no-undo .
      745       define variable v-new-sv-date  as date no-undo .
      746       assign
      747         v-curr-sv-date = date(self :screen-value) no-error
      748       .
      749       if v-curr-sv-date = ?
      750       then do:
      751         run gbl/getcurdt.p
      752           (output v-curr-sv-date
      753           ) .
      754       end.
      755       if v-curr-sv-date <> ?
      756       then do:
      757         assign
      758           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      759         .
      760         assign
      761           self :screen-value = string(v-new-sv-date) .
      762         .
      763       end.
      764     end.
      765     return no-apply .
      766   end.
      767   on ctrl-e of f-pay-date in frame Dialog-Frame
      768   do:
      769     if (can-query (self, "sensitive")
      770        and
      771        self :sensitive = true
      772        )
      773     or (can-query (self, "read-only")
      774        and
      775        self :read-only = false
      776        )
      777     then do:
      778       if self :handle <> focus :handle
      779       then do:
      780         apply "entry":u to self .
      781       end.
      782       define variable v-curr-sv-date as date no-undo .
      783       define variable v-new-sv-date  as date no-undo .
      784       assign
      785         v-curr-sv-date = date(self :screen-value) no-error
      786       .
      787       if v-curr-sv-date = ?
      788       then do:
      789         run gbl/getcurdt.p
      790           (output v-curr-sv-date
      791           ) .
      792       end.
      793       if v-curr-sv-date <> ?
      794       then do:
      795         run gbl/lastdate.p
      796           (input  v-curr-sv-date
      797           ,output v-new-sv-date
      798           ).
      799         assign
      800           self :screen-value = string(v-new-sv-date) .
      801         .
      802       end.
      803     end.
      804     return no-apply .
      805   end.
      806   on ctrl-f of f-pay-date in frame Dialog-Frame
      807   do:
      808     if (can-query (self, "sensitive")
      809        and
      810        self :sensitive = true
      811        )
      812     or (can-query (self, "read-only")
      813        and
      814        self :read-only = false
      815        )
      816     then do:
      817       if self :handle <> focus :handle
      818       then do:
      819         apply "entry":u to self .
      820       end.
      821       define variable v-ok            as logical   no-undo .
      822       define variable v-curr-sv-date  as date      no-undo .
      823       define variable v-description   as character no-undo .
      824       assign
      825         v-curr-sv-date = date(self :screen-value) no-error
      826       .
      827       if v-curr-sv-date = ?
      828       then do:
      829         run gbl/getcurdt.p
      830           (output v-curr-sv-date
      831           ) .
      832       end.
      833       if v-curr-sv-date <> ?
      834       then do:
      835         run gbl/d-inpday.w
      836           (input ?
      837           ,input "Выбор даты"
      838           ,input v-description
      839           ,input ""
      840           ,input-output v-curr-sv-date
      841           ,output v-ok
      842           ).
      843         if v-ok = true
      844         then do:
      845           assign
      846             self :screen-value = string(v-curr-sv-date) .
      847           .
      848         end.
      849       end.
      850     end.
      851     return no-apply .
      852   end.
      853     define MENU m-ed-date4
      854       MENU-ITEM m-ed-date4-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      855       MENU-ITEM m-ed-date4-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      856       MENU-ITEM m-ed-date4-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      857       MENU-ITEM m-ed-date4-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
