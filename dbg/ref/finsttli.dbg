      562   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      563   on help of frame Dialog-Frame
      564   do:
      565     run gbl/app_help.p
      566       (input this-procedure :file-name
      567       ,input ''
      568       ,input ?
      569       ) no-error.
      570     if error-status :error then do:
      571       message
      572         "Ошибка при вызове помощи"
      573         error-status :get-message(1)
      574         view-as alert-box .
      575     end.
      576   end.
