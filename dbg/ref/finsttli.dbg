      861       ASSIGN
      862         f-pay-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date4 :HANDLE
      863         f-pay-date :MENU-MOUSE in frame Dialog-Frame = 3
      864       .
      865     end.
      866     define variable v-label-handle4 as handle no-undo .
      867     assign
      868       v-label-handle4 = f-pay-date :side-label-handle in frame Dialog-Frame
      869     .
      870     if valid-handle (v-label-handle4)
      871     then do:
      872       if v-label-handle4 :tooltip = ""
      873       or v-label-handle4 :tooltip = ?
      874       then do:
