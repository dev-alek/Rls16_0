        1   define input parameter p-start-date as date no-undo .
        2   define input parameter p-end-date as date no-undo .
        3   DEFINE output PARAMETER p-prn-doc-code AS CHARACTER NO-UNDO.
        4   DEFINE output PARAMETER p-fin-ext-doc-type AS CHARACTER NO-UNDO.
        5   define output parameter p-pay-date as date no-undo .
        6   define output parameter p-bik as character no-undo .
        7   define output parameter p-bank-name as character no-undo .
        8   define output parameter p-bank-city as character no-undo .
        9   define output parameter p-c-schet as character no-undo .
       10   define output parameter p-r-schet as character no-undo .
       11   define output parameter p-name as character no-undo .
       12   define output parameter p-inn as character no-undo .
       13   define output parameter p-kpp as character no-undo .
       14   DEFINE output PARAMETER p-sum AS decimal NO-UNDO.
       15   DEFINE output PARAMETER p-ps AS character NO-UNDO.
       16   define variable vss-revision    as character no-undo init "$Revision$":U .
       17   define variable vss-author      as character no-undo init "$Author$":U .
       18   define variable vss-date        as character no-undo init "$Date$":U .
       19   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       20   define variable vss-archive     as character no-undo init "$Archive$":U .
       21   define variable vss-description as character no-undo init "Ввод данных неучтенного в TH платежа".
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   define variable v-waitfram-action01         as character   no-undo .
       78   define variable v-waitfram-action02         as character   no-undo .
       79   define variable v-waitfram-action03         as character   no-undo .
       80   define variable mWaitFramTextBeg            as character   no-undo.
       81   define variable mWaitFramTextEnd            as character   no-undo.
       82   define variable mWaitFramView               as logical     no-undo.
       83   define variable mWaitProcEvent              as logical     no-undo init yes.
       84   define variable mWaitFramInterval           as integer     no-undo init 1 .
       85   define variable mWaitFramStop               as logical     no-undo.
       86   define variable mWaitFramStopUser           as logical     no-undo.
       87   define variable mWaitFramStopTimeOut        as logical     no-undo.
       88   define variable mWaitFramStartProc          as datetime-tz no-undo.
       89   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       90   define button B-WaitFramStop auto-end-key
       91        label "Стоп"
       92        size 10 by 1 tooltip "Остоновить процесс".
       93   define button B-viewProcInfo
       94        label "Информация"
       95        size 15 by 1 tooltip "Информация о процесс".
       96   define frame waitfram
       97     v-waitfram-action01 format "x(72)" no-label skip
       98     v-waitfram-action02 format "x(72)" no-label skip
       99     v-waitfram-action03 format "x(72)" no-label skip
      100     B-viewProcInfo
      101     B-WaitFramStop at row 4 col 30
      102     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      103     .
      104   define new global shared variable mBatchMode as logical no-undo init ?.
      105   define variable mFramBachModHandle as handle no-undo.
      106   mFramBachModHandle = frame waitfram:handle.
      107   define variable mFameOldVis as logical no-undo.
      108   define variable mVisCUrentVin as logical no-undo.
      109   if session:batch-mode
      110   then
      111      mBatchMode = yes.
      112   if mBatchMode = ? then do:
      113     mVisCUrentVin = current-window:visible.
      114     mFameOldVis = mFramBachModHandle:visible.
      115     mFramBachModHandle:visible  = yes.
      116     mBatchMode = mFramBachModHandle:visible ne yes.
      117     mFramBachModHandle:visible = mFameOldVis.
      118     current-window:visible = mVisCUrentVin.
      119   end.
      120    if  log-manager:logfile-name ne ?
      121     then DO:
      122         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      123         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      124         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      125     end.
      126   on choose of B-WaitFramStop in frame waitfram
      127   do:
      128     mWaitFramStop = yes.
      129     mWaitFramStopUser = yes.
      130   end.
      131   function waitfram-check-timeout returns logical():
      132      define variable vtime as int64 no-undo.
      133      if mWaitFramStopTimeOut
      134      then
      135         return yes.
      136      vtime = ( now - mWaitFramStartProc ) / 1000 .
      137      if     mWaitFramTimeOut ne ?
      138         and mWaitFramTimeOut ne 0
      139         and mWaitFramTimeOut lt vtime
      140      then do:
      141         mWaitFramStopTimeOut = yes.
      142      end.
      143      return mWaitFramStopTimeOut.
      144   end.
      145   procedure waitfram-hide :
      146     if not session:batch-mode
      147     then do
      148     on error undo, return error return-value
      149     :
      150       pause 0 before-hide .
      151       if not mBatchMode then
      152         hide frame waitfram .
      153     if     not mWaitFramView
      154        and mWaitProcEvent
      155     then
      156       process events .
      157     end.
      158   end procedure.
      159   procedure waitfram-show :
      160     define input  parameter p-message as character no-undo .
      161     define variable v-left-margin as integer   no-undo .
      162     if not session:batch-mode
      163     then do
      164     on error undo, return error return-value
      165     :
      166       if length(p-message) <= 70 then do:
      167         assign
      168           v-left-margin = integer((70 - length(p-message)) / 2)
      169         .
      170         assign
      171           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      172         .
      173         assign
      174           v-waitfram-action01 = " "
      175           v-waitfram-action02 = " "
      176                                    + fill(" ", v-left-margin)
      177                                    + p-message
      178           v-waitfram-action03 = " "
      179         .
      180       end.
      181       else do:
      182         define variable vRindex1 as integer no-undo.
      183         define variable vRindex2 as integer no-undo.
      184         vRindex1 = r-index(p-message," ",70).
      185         if vRindex1 = 0
      186         then
      187            vRindex1 = 70.
      188         if length(p-message)  <= vRindex1 + 70 then do:
      189           assign
      190             v-waitfram-action01 = " "
      191             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      192             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      193           .
      194         end.
      195         else do:
      196           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      197           if vRindex2 <= vRindex1
      198           then
      199              vRindex2 = vRindex1 + 70.
      200           assign
      201             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      202             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      203             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      204           .
      205         end.
      206       end.
      207       B-viewProcInfo:visible   in frame waitfram = no.
      208       B-viewProcInfo:sensitive in frame waitfram = no.
      209       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      210       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      211       if  (   mWaitFramView
      212          or  mWaitProcEvent)
      213          and not mBatchMode
      214       then
      215          display
      216             v-waitfram-action01 skip
      217             v-waitfram-action02 skip
      218             v-waitfram-action03 skip
      219          with frame waitfram .
      220       if     mWaitFramView
      221          then do:
      222             if     mWaitFramInterval ne ?
      223                and not mBatchMode
      224             then
      225                wait-for go of frame waitfram pause mWaitFramInterval.
      226          end.
      227          else
      228             if     mWaitProcEvent
      229                and not mBatchMode
      230             then
      231                process events .
      232     end.
      233   end procedure.
      234      procedure waitfram-show-this:
      235         define input  parameter iInterval as int64 no-undo.
      236         define variable vtime as int64 no-undo.
      237         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      238         mWaitFramInterval = iInterval.
      239         run waitfram-show (substitute("&1&2 &3&4" ,
      240                                       mWaitFramTextBeg ,
      241                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      242                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      243                                       mWaitFramTextEnd
      244                                      )
      245                           ).
      246      end.
      247      procedure WaitFramRunPause:
      248         define input  parameter iInterval as dec no-undo.
      249         define variable vStart  as datetime-tz no-undo.
      250         define variable vend    as datetime-tz no-undo.
      251         define variable vint as int64 no-undo.
      252         define variable vOk as logical no-undo.
      253         vStart = now.
      254         vend   = vStart.
      255         publish "WaitFramPause" (iInterval,output vOk).
      256         vend   =  now.
      257         vint = vend - vStart.
      258         vint = iInterval - vint / 1000.
      259         if     not mWaitFramStop
      260            and (   vint > 0
      261                 or (    not vOk
      262                     and iInterval eq ?
      263                     )
      264                 )
      265         then
      266            run waitfram-show-this (iInterval).
      267         vend   =  now.
      268         vint = vend - vStart.
      269         vint = iInterval - vint / 1000.
      270         if     not mWaitFramStop
      271            and vint > 0
      272         then do:
      273            run gbl/pause.p (vint * 1000).
      274         end.
      275         if iInterval ne ?
      276         then
      277            publish "WaitFramStop".
      278         waitfram-check-timeout().
      279      end.
      280      procedure WaitFramWaitFor:
      281         define input  parameter iInterval as dec no-undo.
      282         assign
      283            mWaitFramStartProc   = now
      284            mWaitFramStopUser    = no
      285            mWaitFramStopTimeOut = no
      286         .
      287         block-wait:
      288         do while not mWaitFramStop:
      289            run WaitFramRunPause (iInterval).
      290            if  waitfram-check-timeout()
      291            then do:
      292               leave block-wait.
      293            end.
      294         end.
      295         run waitfram-hide.
      296      end.
      297   procedure waitfram-join :
      298     define input  parameter p-line-1  as character no-undo .
      299     define input  parameter p-line-2  as character no-undo .
      300     define input  parameter p-line-3  as character no-undo .
      301     define output parameter p-message as character no-undo .
      302     do
      303     on error undo, return error return-value
      304     :
      305       assign
      306         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      307                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      308                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      309       .
      310     end.
      311   end procedure.
      312   function waitfram-join-function returns character
      313     (input p-line-1 as character
      314     ,input p-line-2 as character
      315     ,input p-line-3 as character
      316     ).
      317     define variable v-message as character no-undo .
      318     run waitfram-join in this-procedure
      319       (input  p-line-1
      320       ,input  p-line-2
      321       ,input  p-line-3
      322       ,output v-message
      323       ) .
      324     return v-message .
      325   end function .
      326   define new global shared variable g#language as character no-undo .
      327   if g#language <> '' and g#language <> 'rus':U then do:
      328     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      329   end.
      330   define new global shared variable g#library  as handle no-undo .
      331   define new global shared variable g#library2 as handle no-undo .
      332   procedure proc-alt-shift-f2:
      333     if not ibs.th.gbl.gbl-var:rcode
      334   then
      335     run gbl\inidebug.p .
      336   end.
      337   procedure proc-alt-shift-f3:
      338     run gbl/prvssinf.p
      339       ( input this-procedure
      340       ) .
      341   end.
      342   define variable v-inform-launched as logical no-undo initial false .
      343   procedure proc-alt-shift-f4:
      344     define variable v-action as character no-undo .
      345     if v-inform-launched = false then do:
      346       assign
      347         v-inform-launched = true
      348       .
      349       run gbl/d-inform.w
      350         (  input self
      351         ,  input this-procedure
      352         , output v-action
      353         ) no-error .
      354       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      355       assign
      356         v-inform-launched = false
      357       .
      358     end.
      359   end.
      360   procedure proc-alt-f1:
      361     run gbl/corrhelp.p
      362       (input this-procedure
      363       ) .
      364   end .
      365   on alt-shift-f2 anywhere do:
      366     run proc-alt-shift-f2.
      367   end.
      368   on alt-shift-f3 anywhere do:
      369     run proc-alt-shift-f3 in this-procedure .
      370   end.
      371   on alt-shift-f4 anywhere do:
      372     run proc-alt-shift-f4 in this-procedure.
      373   end.
      374   on alt-f1 anywhere do:
      375     run proc-alt-f1 in this-procedure .
      376   end.
      377   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      378   DEFINE BUTTON B-exit AUTO-GO
      379        LABEL "&Ввод"
      380        SIZE 10 BY 1
      381        BGCOLOR 8 .
      382   DEFINE BUTTON B-Help
      383        LABEL "Помо&щь"
      384        SIZE 10 BY 1
      385        BGCOLOR 8 .
      386   DEFINE BUTTON b-quit AUTO-END-KEY
      387        LABEL "&Отмена"
      388        SIZE 10 BY 1
      389        BGCOLOR 8 .
      390   DEFINE VARIABLE E-ps AS CHARACTER
      391        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      392        SIZE 66 BY 4 NO-UNDO.
      393   DEFINE VARIABLE f-bank-city AS CHARACTER FORMAT "X(20)":U
      394        LABEL "Город Банка"
      395        VIEW-AS FILL-IN
      396        SIZE 24.5 BY 1.07 NO-UNDO.
      397   DEFINE VARIABLE f-bank-name AS CHARACTER FORMAT "X(256)":U
      398        LABEL "Банк"
      399        VIEW-AS FILL-IN
      400        SIZE 87.5 BY 1.07 NO-UNDO.
      401   DEFINE VARIABLE f-bik AS CHARACTER FORMAT "X(10)":U
      402        LABEL "БИК"
      403        VIEW-AS FILL-IN
      404        SIZE 11 BY 1 NO-UNDO.
      405   DEFINE VARIABLE f-c-schet AS CHARACTER FORMAT "X(20)":U
      406        LABEL "Коррсчет"
      407        VIEW-AS FILL-IN
      408        SIZE 31.5 BY 1 NO-UNDO.
      409   DEFINE VARIABLE f-inn AS CHARACTER FORMAT "X(20)":U
      410        LABEL "INN"
      411        VIEW-AS FILL-IN
      412        SIZE 24.5 BY 1.07 NO-UNDO.
      413   DEFINE VARIABLE f-kpp AS CHARACTER FORMAT "X(20)":U
      414        LABEL "kpp"
      415        VIEW-AS FILL-IN
      416        SIZE 24.5 BY 1.07 NO-UNDO.
      417   DEFINE VARIABLE f-name AS CHARACTER FORMAT "X(256)":U
      418        LABEL "Плат/Получ"
      419        VIEW-AS FILL-IN
      420        SIZE 74.5 BY 1.07 NO-UNDO.
      421   DEFINE VARIABLE f-pay-date AS DATE FORMAT "99/99/9999":U
      422        LABEL "Дата платежа"
      423        VIEW-AS FILL-IN
      424        SIZE 14.5 BY 1 NO-UNDO.
      425   DEFINE VARIABLE f-prn-doc-code AS CHARACTER FORMAT "X(256)":U
      426        LABEL "№ платежа"
      427        VIEW-AS FILL-IN
      428        SIZE 31 BY 1 NO-UNDO.
      429   DEFINE VARIABLE f-r-schet AS CHARACTER FORMAT "X(20)":U
      430        LABEL "Расчсчет"
      431        VIEW-AS FILL-IN
      432        SIZE 31.5 BY 1 NO-UNDO.
      433   DEFINE VARIABLE f-sum AS DECIMAL FORMAT ">>>,>>>,>>9.99":U INITIAL 0
      434        LABEL "Сумма"
      435        VIEW-AS FILL-IN
      436        SIZE 30.5 BY 1 NO-UNDO.
      437   DEFINE VARIABLE S-fin-ext-doc-type AS CHARACTER
      438        VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
      439        SIZE 31.5 BY 2 NO-UNDO.
      440   DEFINE FRAME Dialog-Frame
      441        B-exit AT ROW 1 COL 1
      442        b-quit AT ROW 1 COL 11
      443        B-Help AT ROW 1 COL 54.9
      444        f-prn-doc-code AT ROW 2.5 COL 11 COLON-ALIGNED
      445        S-fin-ext-doc-type AT ROW 2.5 COL 55 NO-LABEL
      446        f-bik AT ROW 4.5 COL 5 COLON-ALIGNED
      447        f-bank-name AT ROW 5.77 COL 5 COLON-ALIGNED
      448        f-bank-city AT ROW 7 COL 2.5
      449        f-c-schet AT ROW 8.27 COL 13.5 COLON-ALIGNED
      450        f-r-schet AT ROW 9.5 COL 13.5 COLON-ALIGNED
      451        f-name AT ROW 10.77 COL 3.5
      452        f-inn AT ROW 12 COL 10.5
      453        f-kpp AT ROW 12 COL 42
      454        f-pay-date AT ROW 13.27 COL 13.5 COLON-ALIGNED
      455        f-sum AT ROW 13.27 COL 43.5 COLON-ALIGNED
      456        E-ps AT ROW 15.67 COL 1 NO-LABEL
      457        "Примечания:" VIEW-AS TEXT
      458             SIZE 22.5 BY 1 AT ROW 14.33 COL 2
      459             FGCOLOR 4
      460        SPACE(70.99) SKIP(4.49)
      461       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      462            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      463            TITLE "Неучтенный в TH платеж"
      464            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      465   ASSIGN
      466          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      467          FRAME Dialog-Frame:HIDDEN           = TRUE.
      468   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      469   DO:
      470     APPLY "END-ERROR":U TO SELF.
      471   END.
      472   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      473   DO:
      474     ASSIGN
      475     f-prn-doc-code
      476     f-bik
      477     f-bank-name
      478     f-bank-city
      479     f-r-schet
      480     f-c-schet
      481     f-name
      482     f-inn
      483     f-kpp
      484     f-pay-date
      485     f-sum
      486     S-fin-ext-doc-type
      487     .
      488     IF f-prn-doc-code = '':U THEN DO:
      489       MESSAGE
      490       "Введите номер платежа!"
      491       VIEW-AS ALERT-BOX ERROR.
      492       RETURN NO-APPLY.
      493     END.
      494     IF s-fin-ext-doc-type = "":U THEN DO:
      495       MESSAGE
      496       "Укажите тип платежа"
      497       VIEW-AS ALERT-BOX ERROR.
      498       RETURN NO-APPLY.
      499     END.
      500     IF f-bik = '':U
      501     and f-bank-name = '':U
      502     THEN DO:
      503         MESSAGE
      504         "Вы должны указать хотя бы один из следующих реквизитов:" SKIP
      505         "БИК, название банка"
      506         VIEW-AS ALERT-BOX ERROR.
      507         RETURN NO-APPLY.
      508     END.
      509     IF f-inn = '':U
      510     and f-kpp = '':U
      511     AND f-name = '':U THEN DO:
      512         MESSAGE
      513         "Вы должны указать хотя бы один из следующих реквизитов:" SKIP
      514         "ИНН, КПП, название Плат/Получ"
      515         VIEW-AS ALERT-BOX ERROR.
      516         RETURN NO-APPLY.
      517     END.
      518     IF f-r-schet = '':U THEN DO:
      519         MESSAGE
      520         "Укажите расч. счет"
      521         VIEW-AS ALERT-BOX ERROR.
      522         RETURN NO-APPLY.
      523     END.
      524     IF f-sum = ?
      525     OR f-sum < 0 THEN DO:
      526         MESSAGE
      527         "Укажите сумму платежа"
      528         VIEW-AS ALERT-BOX ERROR.
      529         RETURN NO-APPLY.
      530     END.
      531     if f-pay-date = ? then do:
      532       MESSAGE
      533       "Укажите дату платежа"
      534       VIEW-AS ALERT-BOX ERROR.
      535       RETURN NO-APPLY.
      536     end.
      537     if f-pay-date < p-start-date
      538     or f-pay-date > p-end-date then do:
      539       MESSAGE
      540       substitute("Дата платежа может быть: &1 - &2 ", p-start-date, p-end-date)
      541       VIEW-AS ALERT-BOX ERROR.
      542       RETURN NO-APPLY.
      543     end.
      544     ASSIGN
      545     p-prn-doc-code = f-prn-doc-code
      546     p-fin-ext-doc-type = s-fin-ext-doc-type
      547     p-bik = f-bik
