     1097   DEFINE VARIABLE p-desc AS CHARACTER FORMAT "X(80)":U
     1098        LABEL "по &описанию"
     1099        VIEW-AS FILL-IN
     1100        SIZE 29.25 BY 1 TOOLTIP "Поиск по описанию  Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1101   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "X(12)":U
     1102        LABEL "по &коду"
     1103        VIEW-AS FILL-IN
     1104        SIZE 14 BY 1 TOOLTIP "Поиск по коду справочника Поиск первой записи - <ВВОД>; поиск следующей - <CTRL" NO-UNDO.
     1105   DEFINE VARIABLE rs-sts AS CHARACTER
     1106        VIEW-AS RADIO-SET HORIZONTAL
     1107        RADIO-BUTTONS
     1108             "Item 1", "1",
     1109   "Item 2", "2",
     1110   "Item 3", "3"
     1111        SIZE 34.5 BY .75 NO-UNDO.
     1112   DEFINE  QUERY BR-docs FOR
     1113         buf_fin-code SCROLLING.
     1114   DEFINE BROWSE BR-docs
     1115     QUERY BR-docs DISPLAY
     1116         mark-string(recid( ub.buf_fin-code), rid-list) COLUMN-LABEL "*" FORMAT "x(1)"
     1117         buf_fin-code.code-value COLUMN-LABEL "Код"
     1118         buf_fin-code.descr COLUMN-LABEL "Описание"
     1119         buf_fin-code.fin-code COLUMN-LABEL "Внутр.№"
     1120         buf_fin-code.host-code COLUMN-LABEL "Фирма" format ">>>>>>>>9"
     1121         entry (lookup (STRING(buf_fin-code.status_ ), '0,1,50,99':U), 'тек,удал,блок,удаление':U) @ t-s  COLUMN-LABEL "Статус" FORMAT "x(6)"
     1122         buf_fin-code.level-1 COLUMN-LABEL   "Уровень1"
     1123         buf_fin-code.level-2 COLUMN-LABEL   "Уровень2"
     1124         buf_fin-code.level-3 COLUMN-LABEL   "Уровень3"
     1125         enable buf_fin-code.code-value
     1126       WITH NO-ROW-MARKERS SEPARATORS SIZE 69.88 BY 12.75.
     1127   DEFINE FRAME Dialog-Frame
     1128        B-exit AT ROW 1 COL 1
     1129        B-mark AT ROW 1 COL 11.5
     1130        B-sel AT ROW 1 COL 21
     1131        B-add AT ROW 1 COL 31
     1132        B-lkp AT ROW 1 COL 41
     1133        B-chg AT ROW 1 COL 51
     1134        B-del AT ROW 1 COL 61
     1135        B-import AT ROW 2 COL 1
     1136        B-History AT ROW 2 COL 11
     1137        B-firm AT ROW 2 COL 21
     1138        B-copy AT ROW 2 COL 31
     1139        B-sch AT ROW 2 COL 41
     1140        B-print AT ROW 2 COL 51
     1141        B-Help AT ROW 2 COL 61
     1142        BR-docs AT ROW 3.25 COL 1.25
     1143        rs-sts AT ROW 16.25 COL 35 NO-LABEL
     1144        p-desc AT ROW 17.42 COL 24.13
     1145        sch-code AT ROW 17.46 COL 1
     1146        mark-num AT ROW 1 COL 14.88 NO-LABEL
     1147        " ПОИСК" VIEW-AS TEXT
     1148             SIZE 7.13 BY .71 AT ROW 16.67 COL 1.75
     1149             BGCOLOR 3 FGCOLOR 15
     1150        SPACE(62.36) SKIP(1.28)
     1151       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1152            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1153            TITLE "Справочник"
     1154            DEFAULT-BUTTON B-sel CANCEL-BUTTON B-exit.
     1155   ASSIGN
     1156          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1157          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1158   ASSIGN
     1159          B-History:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1160   ASSIGN
     1161          B-import:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1162   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1163   DO:
     1164     APPLY "END-ERROR":U TO SELF.
     1165   END.
     1166   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1167   DO:
     1168     run add-proc in this-procedure.
     1169   END.
     1170   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1171   DO:
     1172   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1173   do:
     1174     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1175       (input  v-cntxt-db-num
     1176       ,input  v-cntxt-userid
     1177       ,input  0
     1178       ,input  'actn_fin-reference_update':U
     1179       ,input  'firm':U
     1180       ,input  par-host-code
     1181       ,input  '':U
     1182       ,input  0
     1183       ,input  0
     1184       ,input  0
     1185       ,input  0
     1186       ,input  true
     1187       ,output g#log
     1188       )  .
     1189   end.
     1190   if not g#log then  return .
     1191   define variable rr as recid no-undo .
     1192       if available buf_fin-code then do:
     1193           rr = recid( buf_fin-code ).
     1194                     run ref/fci-2.w ( 'ИЗМЕНЕНИЕ':U , input-output rr , input par-host-code ).
     1195           disp buf_fin-code.code-value  buf_fin-code.descr
     1196                buf_fin-code.level-1
     1197                buf_fin-code.level-2
     1198                buf_fin-code.level-3
     1199           with browse br-docs.
     1200       end.
