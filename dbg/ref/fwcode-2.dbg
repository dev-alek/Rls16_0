     1329   ON CHOOSE OF B-lkp IN FRAME Dialog-Frame
     1330   DO:
     1331   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1332   do:
     1333     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1334       (input  v-cntxt-db-num
     1335       ,input  v-cntxt-userid
     1336       ,input  0
     1337       ,input  'actn_fin-reference_lookup':U
     1338       ,input  'firm':U
     1339       ,input  par-host-code
     1340       ,input  '':U
     1341       ,input  0
     1342       ,input  0
     1343       ,input  0
     1344       ,input  0
     1345       ,input  true
     1346       ,output g#log
     1347       )  .
     1348   end.
     1349   if not g#log then  return .
     1350   define variable rr as recid no-undo .
     1351       if available buf_fin-code then do:
     1352           rr = recid( buf_fin-code ).
     1353                     run ref/fci-2.w ( 'ПРОСМОТР':U , input-output rr , input par-host-code ).
     1354        end.
     1355   END.
     1356   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1357   DO:
     1358         if available buf_fin-code then do:
     1359   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1360   define variable v-str-recid16 as character no-undo .
     1361   define variable v-num-entry16 as integer   no-undo .
     1362   assign
     1363     v-str-recid16 = trim( string( recid( buf_fin-code ) , "->>>>>>>>>>>9":U ) )
     1364     v-num-entry16 = lookup( v-str-recid16 , rid-list )
     1365   .
     1366   if v-num-entry16 > 0 then do:
     1367     assign
     1368       entry( v-num-entry16, rid-list ) = "":U
     1369       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1370     .
     1371   end.
     1372   else do:
     1373     assign
     1374       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid16
     1375     .
     1376   end.
     1377           g#log = br-docs:refresh() .
     1378           if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1379               g#log = br-docs:select-next-row ().
     1380               apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     1381           end.
     1382           if num-entries( rid-list ) = 0
     1383           then
     1384               hide mark-num in frame Dialog-Frame.
     1385           else do:
     1386               mark-num:screen-value in frame Dialog-Frame  = string (num-entries( rid-list )) .
     1387               enable mark-num with frame Dialog-Frame.
     1388               end.
     1389       end.
     1390       apply "entry" to br-docs in frame Dialog-Frame.
     1391   END.
     1392   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1393   DO:
     1394     run print-proc in this-procedure.
     1395   END.
     1396   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1397   DO:
     1398     run proc-b-sch in this-procedure no-error.
     1399     if error-status:error then return no-apply.
     1400   END.
     1401   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1402   DO:
     1403       if ( available buf_fin-code ) AND ( rid-list = "" ) then
     1404       rid-list = string( recid( buf_fin-code ) ) .
     1405   END.
     1406   ON DELETE-CHARACTER OF BR-docs IN FRAME Dialog-Frame
     1407   DO:
     1408      if b-mark:sensitive in frame Dialog-Frame then
     1409     APPLY "CHOOSE" to b-mark.
     1410   END.
     1411   ON INSERT-MODE OF BR-docs IN FRAME Dialog-Frame
     1412   DO:
     1413       if b-mark:sensitive in frame Dialog-Frame then
     1414     APPLY "CHOOSE" to b-mark.
     1415       else do:
     1416         if b-sel:sensitive in frame Dialog-Frame then
     1417         APPLY "CHOOSE" to b-sel.
     1418       end.
     1419   END.
     1420   ON RETURN OF BR-docs IN FRAME Dialog-Frame
     1421   OR MOUSE-SELECT-DBLCLICK OF BR-docs IN FRAME Dialog-Frame
     1422   DO:
     1423         if b-sel:sensitive in frame Dialog-Frame  = yes then
     1424           apply "choose" to b-sel in frame Dialog-Frame.
     1425       else
     1426           apply "choose" to B-lkp in frame Dialog-Frame.
     1427   END.
     1428   ON LEAVE OF p-desc IN FRAME Dialog-Frame
     1429   DO:
     1430   END.
     1431   ON CTRL-J OF p-desc IN FRAME Dialog-Frame
     1432   DO:
     1433     run proc-find-desc in this-procedure(yes, input frame Dialog-Frame p-desc) no-error.
     1434     if error-status:error then return no-apply.
     1435   END.
     1436   ON RETURN OF p-desc IN FRAME Dialog-Frame
     1437   DO:
     1438     run proc-find-desc in this-procedure(no, input frame Dialog-Frame p-desc) no-error.
     1439     return no-apply.
     1440   END.
     1441   ON VALUE-CHANGED OF rs-sts IN FRAME Dialog-Frame
     1442   DO:
     1443       ASSIGN
     1444     rs-sts
     1445     p-sts = (IF rs-sts = 'все':U  THEN ? ELSE INTEGER(rs-sts))
     1446     .
     1447     run OpenBR in this-procedure (yes, no, '':U)  NO-ERROR.
     1448     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1449   END.
     1450   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1451   DO:
     1452     run proc-find-code in this-procedure(no, input frame Dialog-Frame sch-code) no-error.
     1453     return no-apply.
     1454   END.
     1455   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1456   DO:
     1457     run proc-find-code in this-procedure(yes, input frame Dialog-Frame sch-code) no-error.
     1458     if error-status:error then return no-apply.
     1459   END.
     1460   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1461   define buffer buf_file for ub.fin-code-cel-nazn .
     1462   procedure current-db :
     1463    do
     1464    on error undo, return error return-value
     1465    :
     1466   define input parameter  p-host-code as integer no-undo .
     1467   define input parameter  c-host-code as integer no-undo .
     1468   define output parameter ret         as logical no-undo .
     1469   define buffer current_sysconf for ub.sysconf.
     1470   define variable v-current-db as integer no-undo .
     1471   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
     1472   if error-status :error then return error .
     1473      v-current-db = current_sysconf.firm-db-num .
     1474      ret = true .
     1475   find first ub.sysconf where ub.sysconf.host-code = p-host-code no-lock no-error .
     1476   if not( ub.sysconf.firm-db-num = v-current-db or
     1477           ub.sysconf.firm-db-num = 0 )
     1478     then do:
     1479     ret = false .
     1480     message "Нельзя добавлять запись в  справочнике  для фирмы с не главной БД !!!" view-as alert-box information .
     1481     return .
     1482   end.
     1483    end.
     1484   end procedure.
     1485   procedure ver-db :
     1486    do
     1487    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1488    :
     1489   define input parameter  c-host-code as integer no-undo .
     1490   define input parameter  par-ver-db  as integer no-undo .
     1491   define input parameter  p-mess as logical no-undo .
     1492   define output parameter ret         as logical no-undo .
     1493   define buffer current_sysconf for ub.sysconf.
     1494   define variable v-current-db as integer no-undo .
     1495   find first current_sysconf where current_sysconf.host-code = c-host-code no-lock no-error .
     1496   if error-status :error then return error .
     1497      v-current-db = current_sysconf.firm-db-num .
     1498      ret = true .
     1499   if not( par-ver-db = v-current-db or
     1500           par-ver-db = 0 )
     1501     then do:
     1502     ret = false .
     1503     if p-mess = true then message "База , на которой мы работаем не является главной базой данных текущей фирмы!!!" view-as alert-box information .
     1504     return .
     1505   end.
     1506    end.
     1507   end procedure.
     1508   procedure fin-code :
     1509    do
     1510    on error undo, return error return-value
     1511    :
     1512     define input  parameter p-host-code as integer no-undo .
     1513     define output parameter p-fin-code  as integer no-undo .
     1514     p-fin-code = next-value(s-fin-code, ub) .
     1515    end.
     1516   end procedure.
     1517   procedure create-ref-fin-code :
     1518    do
     1519    on error undo, return error return-value
     1520    :
     1521   define input parameter p-ver as logical no-undo .
     1522   define input parameter p-host-code  as integer   no-undo .
     1523   define input parameter p-fin-code   as integer   no-undo .
     1524   define input parameter p-code-value as character no-undo .
     1525   define input parameter p-descr      as character no-undo .
     1526   define input parameter p-status_    as integer   no-undo .
     1527   define input parameter p-level-1    as integer   no-undo .
     1528   define input parameter p-level-2    as integer   no-undo .
     1529   define input parameter p-level-3    as integer   no-undo .
     1530   if p-ver then do:
     1531       find first  buf_file no-lock  where buf_file.host-code = p-host-code and
     1532                                           buf_file.fin-code  = p-fin-code no-error .
     1533       if available buf_file then return error .
     1534   end.
     1535   define variable p-ret as logical no-undo .
     1536   run current-db in this-procedure (
     1537       input p-host-code,
     1538       input p-host-code,
     1539       output p-ret ) .
     1540    if p-ret = no then return.
     1541    create ub.fin-code-cel-nazn.
     1542    assign
     1543      ub.fin-code-cel-nazn.host-code  = p-host-code
     1544      ub.fin-code-cel-nazn.fin-code   = p-fin-code
     1545      ub.fin-code-cel-nazn.code-value = p-code-value
     1546      ub.fin-code-cel-nazn.descr      = p-descr
     1547      ub.fin-code-cel-nazn.status_    = p-status_
     1548      ub.fin-code-cel-nazn.level-1    = p-level-1
     1549      ub.fin-code-cel-nazn.level-2    = p-level-2
     1550      ub.fin-code-cel-nazn.level-3    = p-level-3
     1551     no-error .
     1552     if error-status :error then do:
     1553         message vss-include-info17 skip
     1554                 error-status :get-message(1)
     1555                 view-as alert-box error .
     1556         return error .
     1557     end.
     1558    end.
     1559   end procedure.
     1560   procedure create-ref-corr-acc :
     1561    do
     1562    on error undo, return error return-value
     1563    :
     1564   define input parameter p-ver as logical no-undo .
     1565   define input parameter p-host-code  as integer   no-undo .
     1566   define input parameter p-fin-code   as integer   no-undo .
     1567   define input parameter p-code-value as character no-undo .
     1568   define input parameter p-descr      as character no-undo .
     1569   define input parameter p-status_    as integer   no-undo .
     1570   define input parameter p-level-1    as integer   no-undo .
     1571   define input parameter p-level-2    as integer   no-undo .
     1572   define input parameter p-level-3    as integer   no-undo .
     1573   define input parameter p-acc-type    as integer   no-undo .
     1574   define buffer buf_file  for ub.fin-code-cor-acc .
     1575   if p-ver then do:
     1576       find first  buf_file no-lock  where buf_file.host-code = p-host-code and
     1577                                           buf_file.fin-code  = p-fin-code no-error .
     1578       if available buf_file then return error .
     1579   end.
     1580   define variable p-ret as logical no-undo .
     1581   run current-db in this-procedure (
     1582       input p-host-code,
     1583       input p-host-code,
     1584       output p-ret ) .
     1585    if p-ret = no then return.
     1586    create ub.fin-code-cor-acc.
     1587    assign
     1588      ub.fin-code-cor-acc.host-code  = p-host-code
     1589      ub.fin-code-cor-acc.fin-code   = p-fin-code
     1590      ub.fin-code-cor-acc.code-value = p-code-value
     1591      ub.fin-code-cor-acc.descr      = p-descr
     1592      ub.fin-code-cor-acc.status_    = p-status_
     1593      ub.fin-code-cor-acc.level-1    = p-level-1
     1594      ub.fin-code-cor-acc.level-2    = p-level-2
     1595      ub.fin-code-cor-acc.level-3    = p-level-3
     1596      ub.fin-code-cor-acc.acc-type   = p-acc-type
     1597     no-error .
     1598     if error-status :error then do:
     1599         message vss-include-info17 skip
     1600                 error-status :get-message(1)
     1601                 view-as alert-box error .
     1602         return error .
     1603     end.
     1604    end.
     1605   end procedure.
     1606   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1607   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1608   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1609   on help of frame Dialog-Frame
     1610   do:
     1611     run gbl/app_help.p
     1612       (input this-procedure :file-name
     1613       ,input ''
     1614       ,input ?
     1615       ) no-error.
     1616     if error-status :error then do:
     1617       message
     1618         "Ошибка при вызове помощи"
     1619         error-status :get-message(1)
     1620         view-as alert-box .
     1621     end.
     1622   end.
     1623   run minbtn-set in this-procedure .
     1624   on choose of b-help in frame Dialog-Frame
     1625   do:
     1626     apply "help":u to frame Dialog-Frame .
     1627   end.
     1628   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1629   procedure minbtn-set :
     1630       do
     1631           on error undo, return error return-value
     1632           :
     1633           define variable ii              as integer       no-undo .
     1634           define variable fh              as widget-handle no-undo .
     1635           define variable hh              as widget-handle no-undo .
     1636           define variable v-h             as handle        extent 4 no-undo .
     1637           define variable v-name-button   as character     no-undo .
     1638           define variable v-help-old-x    as decimal       no-undo .
     1639           define variable v-help-old-y    as decimal       no-undo .
     1640           define variable v-help-old-size as decimal       no-undo .
     1641           define variable v-frame-width   as decimal       no-undo .
     1642           define variable jj              as integer       no-undo .
     1643           do
     1644               on error undo, return error
     1645               :
     1646               assign
     1647                   v-frame-width = frame Dialog-Frame:width - 0.3
     1648                   fh            = frame Dialog-Frame:first-child
     1649                   hh            = fh:first-child
     1650                   ii            = 1
     1651                   .
     1652               do while valid-handle(hh):
     1653                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1654                   do:
     1655                       case lc(hh:name) :
     1656                           when "b-help" then
     1657                               do:
     1658                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1659                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1660                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1661                                   hh:TOOLTIP = "Помощь" .
     1662                                   v-help-old-x = hh:column .
     1663                                   v-help-old-y = hh:row    .
     1664                                   v-help-old-size = hh:width .
     1665                                   hh:width-chars = 2.5 .
     1666                               end.
     1667                           when "b-print" then
     1668                               do:
     1669                                   hh:load-image("cmp/b-print.bmp":u) .
     1670                                   hh:TOOLTIP = "Печать" .
     1671                                   v-h[ii] = hh:handle .
     1672                                   ii = ii + 1 .
     1673                                   hh:width-chars = 3 .
     1674                               end.
     1675                           when "b-history" or
     1676                           when "b-hist" then
     1677                               do:
     1678                                   hh:load-image("cmp/b-hist.bmp":u) .
     1679                                   hh:TOOLTIP = "История" .
     1680                                   v-h[ii] = hh:handle .
     1681                                   ii = ii + 1 .
     1682                                   hh:width-chars = 3 .
     1683                               end.
     1684                           when "b-sch" then
     1685                               do:
     1686                                   hh:load-image("cmp/b-sch.bmp":u) .
     1687                                   hh:TOOLTIP = "Установка Фильтра" .
     1688                                   v-h[ii] = hh:handle .
     1689                                   ii = ii + 1 .
     1690                                   hh:width-chars = 3 .
     1691                               end.
     1692                           when "b-hist-user" then
     1693                               do:
     1694                                   hh:load-image("cmp/b-hist.bmp":u) .
     1695                                   hh:TOOLTIP = "История пользователя" .
     1696                                   ii = ii + 1 .
     1697                               end.
     1698                       end case.
     1699                   end.
     1700                   hh = hh:next-sibling.
     1701               end.
     1702               b-help:column = v-frame-width - b-help:width-chars.
     1703               jj = 0.
     1704               repeat ii = 4 to 1 by -1 :
     1705                   if valid-handle (v-h[ii] ) then
     1706                   do:
     1707                       jj  = jj + 1 .
     1708                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1709                       v-h[ii]:row    = v-help-old-y .
     1710                   end.
     1711               end.
     1712           end.
     1713       end.
     1714   end procedure.
     1715   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1716   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1717   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1718   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1719   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1720   define variable v-diasize-current-frame-height as decimal   no-undo .
     1721   define variable v-diasize-change-size          as logical   no-undo .
     1722   define variable v-diasize-resize-button        as handle    no-undo .
     1723   define variable v-diasize-wndmax               as logical   no-undo .
     1724   define variable v-diasize-wndstore             as logical   no-undo .
     1725   define variable v-diasize-proc-name            as character no-undo .
     1726   define variable v-diasize-browse-handle        as handle    no-undo .
     1727   define variable v-diasize-browse-number        as integer   no-undo .
     1728   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1729   define temp-table temp-diasize-handle no-undo
     1730     field handle-value  as handle
     1731     field save-position as decimal
     1732     index xpk is primary unique handle-value
     1733     .
     1734   define temp-table temp-browse-handle no-undo
     1735     field browse-type   as character
     1736     field browse-number as integer
     1737     field browse-handle as handle
     1738     field original-size as decimal
     1739     index xpk is primary unique browse-type browse-number
     1740     index xie browse-type browse-handle
     1741   .
     1742   procedure diasize_change-height :
     1743     define input  parameter p-change-value  as decimal   no-undo .
     1744     define input  parameter p-move-resize   as logical   no-undo .
     1745     define variable v-field-group-handle    as handle    no-undo .
     1746     define variable v-object-handle         as handle    no-undo .
     1747     define variable v-frame-height          as decimal   no-undo .
     1748     define variable v-frame-virtual-height  as decimal   no-undo .
     1749     define variable v-browse-height         as decimal   no-undo .
     1750     define variable v-window-height         as decimal   no-undo .
     1751     define variable v-window-virtual-height as decimal   no-undo .
     1752     define variable v-change-sign           as integer   no-undo .
     1753     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1754     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1755     if p-change-value > 0
     1756     then do:
     1757       if frame Dialog-Frame :height + p-change-value
     1758           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1759       then do:
     1760         assign
     1761           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1762                           - (frame Dialog-Frame :height-chars)
     1763         .
     1764         if p-change-value <= 0
     1765         then do:
     1766           run diasize_position-resize-button in this-procedure .
     1767           return .
     1768         end.
     1769       end.
     1770     end.
     1771     if p-change-value < 0
     1772     then do:
     1773       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1774       then do:
     1775         assign
     1776           p-change-value = v-diasize-orig-frame-height
     1777                          - (frame Dialog-Frame :height-chars)
     1778         .
     1779         if p-change-value >= 0
     1780         then do:
     1781           run diasize_position-resize-button in this-procedure .
     1782           return .
     1783         end.
     1784       end.
     1785     end.
     1786     if p-change-value >= 0
     1787     then do:
     1788       assign
     1789         v-change-sign = 1
     1790       .
     1791     end.
     1792     else do:
     1793       assign
     1794         v-change-sign = -1
     1795       .
     1796     end.
     1797     assign
     1798       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1799     .
     1800     if p-change-value = 0
     1801     then do:
     1802       run diasize_position-resize-button in this-procedure .
     1803       return .
     1804     end.
     1805     move_block:
     1806     do
     1807     on error undo move_block, retry move_block
     1808     :
     1809       if retry
     1810       then do:
     1811         do
     1812         on error undo move_block, leave move_block
     1813         :
     1814           if p-change-value > 0
     1815           then do:
     1816             for each buf_temp-diasize-handle
     1817             on error undo, next
     1818             :
     1819               assign
     1820                 v-object-handle = buf_temp-diasize-handle.handle-value
     1821               .
     1822               if v-object-handle <> v-diasize-resize-button
     1823               then do:
     1824                 assign
     1825                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1826                 .
     1827               end.
     1828             end.
     1829             assign
     1830               v-diasize-browse-handle :height = v-browse-height
     1831             .
     1832             for each buf_temp-browse-handle
     1833               where buf_temp-browse-handle.browse-type = 'height':u
     1834             on error undo, next
     1835             :
     1836               assign
     1837                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1838               .
     1839             end.
     1840             assign
     1841               frame Dialog-Frame :height = v-frame-height
     1842             .
     1843             if frame Dialog-Frame :scrollable = true
     1844             then do:
     1845               assign
     1846                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1847               .
     1848             end.
     1849             run diasize_position-resize-button in this-procedure .
     1850           end.
     1851           else do:
     1852             if frame Dialog-Frame :scrollable = true
     1853             then do:
     1854               assign
     1855                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1856               .
     1857             end.
     1858             assign
     1859               frame Dialog-Frame :height = v-frame-height
     1860             .
     1861             assign
     1862               v-diasize-browse-handle :height = v-browse-height
     1863             .
     1864             for each buf_temp-browse-handle
     1865               where buf_temp-browse-handle.browse-type = 'height':u
     1866             on error undo, next
     1867             :
     1868               assign
     1869                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1870               .
     1871             end.
     1872             for each buf_temp-diasize-handle
     1873             on error undo, next
     1874             :
     1875               assign
     1876                 v-object-handle = buf_temp-diasize-handle.handle-value
     1877               .
     1878               if v-object-handle <> v-diasize-resize-button
     1879               then do:
     1880                 assign
     1881                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1882                 .
     1883               end.
     1884             end.
     1885             run diasize_position-resize-button in this-procedure .
     1886           end.
     1887           assign
     1888             v-diasize-change-size = false
     1889           .
     1890           leave move_block .
     1891         end.
     1892       end.
     1893       assign
     1894         v-diasize-need-full-display = true
     1895       .
     1896       if v-diasize-change-size = false
     1897       then do:
     1898         assign
     1899           v-diasize-change-size = true
     1900         .
     1901       end.
     1902       else do:
     1903         return .
     1904       end.
     1905       assign
     1906         v-frame-height = frame Dialog-Frame :height
     1907         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1908         v-browse-height = v-diasize-browse-handle :height
     1909       .
     1910       for each buf_temp-browse-handle
     1911         where buf_temp-browse-handle.browse-type = 'height':u
     1912       :
     1913         assign
     1914           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1915         .
     1916       end.
     1917       for each buf_temp-diasize-handle
     1918       :
     1919         delete buf_temp-diasize-handle .
     1920       end.
     1921       assign
     1922         v-field-group-handle = frame Dialog-Frame :first-child
     1923       .
     1924       do while valid-handle(v-field-group-handle)
     1925       :
     1926         assign
     1927           v-object-handle = v-field-group-handle :first-child
     1928         .
     1929         do while valid-handle(v-object-handle)
     1930         :
     1931           if  v-object-handle <> v-diasize-browse-handle :handle
     1932           and can-query(v-object-handle, "row")
     1933           and can-query(v-object-handle, "height")
     1934           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1935           then do:
     1936             find first buf_temp-browse-handle
     1937               where buf_temp-browse-handle.browse-type   = 'height':u
     1938                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1939               no-error .
     1940             if available buf_temp-browse-handle
     1941             then do:
     1942             end.
     1943             else do:
     1944               create buf_temp-diasize-handle .
     1945               assign
     1946                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1947                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1948               .
     1949             end.
     1950           end.
     1951           assign
     1952             v-object-handle = v-object-handle :next-sibling
     1953           .
     1954         end.
     1955         assign
     1956           v-field-group-handle = v-field-group-handle :next-sibling
     1957         .
     1958       end.
     1959       do with frame Dialog-Frame
     1960       :
     1961         hide v-diasize-resize-button .
     1962         assign
     1963           v-diasize-resize-button :row    = 1
     1964           v-diasize-resize-button :column = 1
     1965         .
     1966       end.
     1967       if p-change-value > 0
     1968       then do:
     1969         if frame Dialog-Frame :scrollable = true
     1970         then do:
     1971           assign
     1972             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1973             no-error .
     1974           if error-status :error
     1975           or error-status :get-message(1) <> ""
     1976           then do:
     1977             undo move_block, retry move_block .
     1978           end.
     1979         end.
     1980         assign
     1981           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1982           no-error .
     1983         if error-status :error
     1984         or error-status :get-message(1) <> ""
     1985         then do:
     1986           undo move_block, retry move_block .
     1987         end.
     1988         assign
     1989           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1990           no-error .
     1991         if error-status :error
     1992         or error-status :get-message(1) <> ""
     1993         then do:
     1994           undo move_block, retry move_block .
     1995         end.
     1996         for each buf_temp-browse-handle
     1997           where buf_temp-browse-handle.browse-type = 'height':u
     1998         on error undo move_block, retry move_block
     1999         :
     2000           assign
     2001             buf_temp-browse-handle.browse-handle :height
     2002               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2003             no-error .
     2004           if error-status :error
     2005           or error-status :get-message(1) <> ""
     2006           then do:
     2007             undo move_block, retry move_block .
     2008           end.
     2009         end.
     2010         for each buf_temp-diasize-handle
     2011         on error undo move_block, retry move_block
     2012         :
     2013           assign
     2014             v-object-handle = buf_temp-diasize-handle.handle-value
     2015           .
     2016           if v-object-handle <> v-diasize-resize-button
     2017           then do:
     2018             assign
     2019               v-object-handle :row = v-object-handle :row + p-change-value
     2020               no-error .
     2021             if error-status :error
     2022             or error-status :get-message(1) <> ""
     2023             then do:
     2024               undo move_block, retry move_block .
     2025             end.
     2026           end.
     2027         end.
     2028       end.
     2029       else do:
     2030         for each buf_temp-diasize-handle
     2031         on error undo move_block, retry move_block
     2032         :
     2033           assign
     2034             v-object-handle = buf_temp-diasize-handle.handle-value
     2035           .
     2036           if v-object-handle <> v-diasize-resize-button
     2037           then do:
     2038             assign
     2039               v-object-handle :row = v-object-handle :row + p-change-value
     2040               no-error .
     2041             if error-status :error
     2042             or error-status :get-message(1) <> ""
     2043             then do:
     2044               undo move_block, retry move_block .
     2045             end.
     2046           end.
     2047         end.
     2048         assign
     2049           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2050           no-error .
     2051         if error-status :error
     2052         or error-status :get-message(1) <> ""
     2053         then do:
     2054           undo move_block, retry move_block .
     2055         end.
     2056         for each buf_temp-browse-handle
     2057           where buf_temp-browse-handle.browse-type = 'height':u
     2058         on error undo move_block, retry move_block
     2059         :
     2060           assign
     2061             buf_temp-browse-handle.browse-handle :height
     2062               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2063             no-error .
     2064           if error-status :error
     2065           or error-status :get-message(1) <> ""
     2066           then do:
     2067             undo move_block, retry move_block .
     2068           end.
     2069         end.
     2070         assign
     2071           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2072           no-error .
     2073         if error-status :error
     2074         or error-status :get-message(1) <> ""
     2075         then do:
     2076           undo move_block, retry move_block .
     2077         end.
     2078         if frame Dialog-Frame :scrollable = true
     2079         then do:
     2080           assign
     2081             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2082             no-error .
     2083           if error-status :error
     2084           or error-status :get-message(1) <> ""
     2085           then do:
     2086             undo move_block, retry move_block .
     2087           end.
     2088         end.
     2089       end.
     2090       if p-move-resize = true
     2091       then do:
     2092         run diasize_position-resize-button in this-procedure .
     2093       end.
     2094       if v-diasize-wndstore = true
     2095       then do:
     2096         if connected("ub") = true
     2097         then do:
     2098           define variable v-cntxt-db-num        as integer   no-undo .
     2099           define variable v-cntxt-userid        as character no-undo .
     2100           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2101                                             , OUTPUT v-cntxt-userid
     2102                                             ) .
     2103           run gbl/wndsizew.p
     2104             (input  v-cntxt-db-num
     2105             ,input  v-cntxt-userid
     2106             ,input  v-diasize-proc-name
     2107             ,input  'height':u
     2108             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2109             ) .
     2110         end.
     2111       end.
     2112     end.
     2113     assign
     2114       v-diasize-change-size = false
     2115     .
     2116   end procedure.
     2117   procedure diasize_set-height :
     2118     define input  parameter p-new-height  as decimal   no-undo .
     2119     define input  parameter p-move-resize as logical   no-undo .
     2120     do
     2121     on error undo, return error return-value
     2122     :
     2123       run diasize_change-height in this-procedure
     2124         (input  (p-new-height - frame Dialog-Frame :height)
     2125         ,input  p-move-resize
     2126         ) .
     2127     end.
     2128   end procedure.
     2129   procedure diasize_change-width :
     2130     define input  parameter p-change-value as decimal   no-undo .
     2131     define input  parameter p-move-resize  as logical   no-undo .
     2132     define variable v-field-group-handle   as handle    no-undo .
     2133     define variable v-object-handle        as handle    no-undo .
     2134     define variable v-frame-width          as decimal   no-undo .
     2135     define variable v-frame-virtual-width  as decimal   no-undo .
     2136     define variable v-browse-width         as decimal   no-undo .
     2137     define variable v-window-width         as decimal   no-undo .
     2138     define variable v-window-virtual-width as decimal   no-undo .
     2139     define variable v-change-sign          as integer   no-undo .
     2140     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2141     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2142     if p-change-value > 0
     2143     then do:
     2144       if frame Dialog-Frame :width + p-change-value >
     2145           session :width-chars
     2146       then do:
     2147         assign
     2148           p-change-value = session :width-chars - frame Dialog-Frame :width
     2149         .
     2150         if p-change-value <= 0
     2151         then do:
     2152           run diasize_position-resize-button in this-procedure .
     2153           return .
     2154         end.
     2155       end.
     2156     end.
     2157     if p-change-value < 0
     2158     then do:
     2159       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2160       then do:
     2161         assign
     2162           p-change-value = v-diasize-orig-frame-width
     2163                          - frame Dialog-Frame :width
     2164         .
     2165         if p-change-value >= 0
     2166         then do:
     2167           run diasize_position-resize-button in this-procedure .
     2168           return .
     2169         end.
     2170       end.
     2171     end.
     2172     if p-change-value >= 0
     2173     then do:
     2174       assign
     2175         v-change-sign = 1
     2176       .
     2177     end.
     2178     else do:
     2179       assign
     2180         v-change-sign = -1
     2181       .
     2182     end.
     2183     assign
     2184       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2185     .
     2186     if p-change-value = 0
     2187     then do:
     2188       run diasize_position-resize-button in this-procedure .
     2189       return .
     2190     end.
     2191     move_block:
     2192     do
     2193     on error undo move_block, leave move_block
     2194     :
     2195       if retry
     2196       then do:
     2197         do
     2198         on error undo move_block, leave move_block
     2199         :
     2200           if p-change-value > 0
     2201           then do:
     2202             for each buf_temp-diasize-handle
     2203             on error undo, next
     2204             :
     2205               assign
     2206                 v-object-handle = buf_temp-diasize-handle.handle-value
     2207               .
     2208               if v-object-handle <> v-diasize-resize-button
     2209               then do:
     2210                 assign
     2211                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2212                 .
     2213               end.
     2214             end.
     2215             assign
     2216               v-diasize-browse-handle :width = v-browse-width
     2217             .
     2218             for each buf_temp-browse-handle
     2219               where buf_temp-browse-handle.browse-type = 'width':u
     2220             on error undo, next
     2221             :
     2222               assign
     2223                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2224               .
     2225             end.
     2226             assign
     2227               frame Dialog-Frame :width = v-frame-width
     2228             .
     2229             if frame Dialog-Frame :scrollable = true
     2230             then do:
     2231               assign
     2232                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2233               .
     2234             end.
     2235             run diasize_position-resize-button in this-procedure .
     2236           end.
     2237           else do:
     2238             if frame Dialog-Frame :scrollable = true
     2239             then do:
     2240               assign
     2241                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2242               .
     2243             end.
     2244             assign
     2245               frame Dialog-Frame :width = v-frame-width
     2246             .
     2247             for each buf_temp-browse-handle
     2248               where buf_temp-browse-handle.browse-type = 'width':u
     2249             on error undo, next
     2250             :
     2251               assign
     2252                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2253               .
     2254             end.
     2255             assign
     2256               v-diasize-browse-handle :width = v-browse-width
     2257             .
     2258             for each buf_temp-diasize-handle
     2259             on error undo, next
     2260             :
     2261               assign
     2262                 v-object-handle = buf_temp-diasize-handle.handle-value
     2263               .
     2264               if v-object-handle <> v-diasize-resize-button
     2265               then do:
     2266                 assign
     2267                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2268                 .
     2269               end.
     2270             end.
     2271             run diasize_position-resize-button in this-procedure .
     2272           end.
     2273           assign
     2274             v-diasize-change-size = false
     2275           .
     2276           leave move_block .
     2277         end.
     2278       end.
     2279       assign
     2280         v-diasize-need-full-display = true
     2281       .
     2282       if v-diasize-change-size = false
     2283       then do:
     2284         assign
     2285           v-diasize-change-size = true
     2286         .
     2287       end.
     2288       else do:
     2289         return .
     2290       end.
     2291       assign
     2292         v-frame-width = frame Dialog-Frame :width
     2293         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2294         v-browse-width = v-diasize-browse-handle :width
     2295       .
     2296       for each buf_temp-browse-handle
     2297         where buf_temp-browse-handle.browse-type = 'width':u
     2298       :
     2299         assign
     2300           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2301         .
     2302       end.
     2303       for each buf_temp-diasize-handle
     2304       :
     2305         delete buf_temp-diasize-handle .
     2306       end.
     2307       assign
     2308         v-field-group-handle = frame Dialog-Frame :first-child
     2309       .
     2310       do while valid-handle(v-field-group-handle)
     2311       :
     2312         assign
     2313           v-object-handle = v-field-group-handle :first-child
     2314         .
     2315         do while valid-handle(v-object-handle)
     2316         :
     2317           if  v-object-handle <> v-diasize-browse-handle :handle
     2318           and v-object-handle <> v-diasize-resize-button
     2319           and can-query(v-object-handle, "row")
     2320           and can-query(v-object-handle, "height")
     2321           and ( v-object-handle :col + v-object-handle :width
     2322                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2323               )
     2324           then do:
     2325             find first buf_temp-browse-handle
     2326               where buf_temp-browse-handle.browse-type   = 'width':u
     2327                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2328               no-error .
     2329             if available buf_temp-browse-handle
     2330             then do:
     2331             end.
     2332             else do:
     2333               create buf_temp-diasize-handle .
     2334               assign
     2335                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2336                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2337               .
     2338             end.
     2339           end.
     2340           assign
     2341             v-object-handle = v-object-handle :next-sibling
     2342           .
     2343         end.
     2344         assign
     2345           v-field-group-handle = v-field-group-handle :next-sibling
     2346         .
     2347       end.
     2348       do with frame Dialog-Frame
     2349       :
     2350         hide v-diasize-resize-button .
     2351         v-diasize-resize-button :row = 1.
     2352         v-diasize-resize-button :column = 1.
     2353       end.
     2354       if p-change-value > 0
     2355       then do:
     2356         if frame Dialog-Frame :scrollable = true
     2357         then do:
     2358           assign
     2359             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2360             no-error .
     2361           if error-status :error
     2362           or error-status :get-message(1) <> ""
     2363           then do:
     2364             undo move_block, retry move_block.
     2365           end.
     2366         end.
     2367         assign
     2368           frame Dialog-Frame :width = v-frame-width + p-change-value
     2369           no-error .
     2370         if error-status :error
     2371         or error-status :get-message(1) <> ""
     2372         then do:
     2373           undo move_block, retry move_block.
     2374         end.
     2375         assign
     2376           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2377         no-error .
     2378         if error-status :error
     2379         or error-status :get-message(1) <> ""
     2380         then do:
     2381           undo move_block, retry move_block.
     2382         end.
     2383         for each buf_temp-browse-handle
     2384           where buf_temp-browse-handle.browse-type = 'width':u
     2385         on error undo move_block, retry move_block
     2386         :
     2387           assign
     2388             buf_temp-browse-handle.browse-handle :width
     2389               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2390             no-error .
     2391           if error-status :error
     2392           or error-status :get-message(1) <> ""
     2393           then do:
     2394             undo move_block, retry move_block .
     2395           end.
     2396         end.
     2397         for each buf_temp-diasize-handle
     2398         on error undo move_block, retry move_block
     2399         :
     2400           assign
     2401             v-object-handle = buf_temp-diasize-handle.handle-value
     2402           .
     2403           if v-object-handle <> v-diasize-resize-button
     2404           then do:
     2405             assign
     2406               v-object-handle :col = v-object-handle :col + p-change-value
     2407               no-error .
     2408             if error-status :error
     2409             or error-status :get-message(1) <> ""
     2410             then do:
     2411               undo move_block, retry move_block .
     2412             end.
     2413           end.
     2414         end.
     2415       end.
     2416       else do:
     2417         for each buf_temp-diasize-handle
     2418         on error undo move_block, retry move_block
     2419         :
     2420           assign
     2421             v-object-handle = buf_temp-diasize-handle.handle-value
     2422           .
     2423           if v-object-handle <> v-diasize-resize-button
     2424           then do:
     2425             assign
     2426               v-object-handle :col = v-object-handle :col + p-change-value
     2427               no-error .
     2428             if error-status :error
     2429             or error-status :get-message(1) <> ""
     2430             then do:
     2431               undo move_block, retry move_block .
     2432             end.
     2433           end.
     2434         end.
     2435         for each buf_temp-browse-handle
     2436           where buf_temp-browse-handle.browse-type = 'width':u
     2437         on error undo move_block, retry move_block
     2438         :
     2439           assign
     2440             buf_temp-browse-handle.browse-handle :width
     2441               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2442             no-error .
     2443           if error-status :error
     2444           or error-status :get-message(1) <> ""
     2445           then do:
     2446             undo move_block, retry move_block .
     2447           end.
     2448         end.
     2449         assign
     2450           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2451           no-error .
     2452         if error-status :error
     2453         or error-status :get-message(1) <> ""
     2454         then do:
     2455           undo move_block, retry move_block.
     2456         end.
     2457         assign
     2458           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2459         no-error .
     2460         if error-status :error
     2461         or error-status :get-message(1) <> ""
     2462         then do:
     2463           undo move_block, retry move_block.
     2464         end.
     2465         if frame Dialog-Frame :scrollable = true
     2466         then do:
     2467           assign
     2468             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2469           no-error .
     2470           if error-status :error
     2471           or error-status :get-message(1) <> ""
     2472           then do:
     2473             undo move_block, retry move_block.
     2474           end.
     2475         end.
     2476       end.
     2477       if p-move-resize
     2478       then do:
     2479         run diasize_position-resize-button in this-procedure .
     2480       end.
     2481       if v-diasize-wndstore = true
     2482       then do:
     2483         if connected("ub") = true
     2484         then do:
     2485           define variable v-cntxt-db-num        as integer   no-undo .
     2486           define variable v-cntxt-userid        as character no-undo .
     2487           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2488                                             , OUTPUT v-cntxt-userid
     2489                                             ) .
     2490           run gbl/wndsizew.p
     2491             (input  v-cntxt-db-num
     2492             ,input  v-cntxt-userid
     2493             ,input  v-diasize-proc-name
     2494             ,input  'width':u
     2495             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2496             ) .
     2497         end.
     2498       end.
     2499     end.
     2500     assign
     2501       v-diasize-change-size = false
     2502     .
     2503   end procedure.
     2504   procedure diasize_set-width :
     2505     define input  parameter p-new-width  as decimal   no-undo .
     2506     define input  parameter p-move-resize as logical   no-undo .
     2507     do
     2508     on error undo, return error return-value
     2509     :
     2510       run diasize_change-width in this-procedure
     2511         (input  (p-new-width - frame Dialog-Frame :width)
     2512         ,input  p-move-resize
     2513         ) .
     2514     end.
     2515   end procedure.
     2516   procedure diasize_position-resize-button :
     2517     do with frame Dialog-Frame
     2518     :
     2519       hide v-diasize-resize-button .
     2520       assign
     2521         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2522                     - 1
     2523                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2524         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2525                     - 1
     2526                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2527       .
     2528       view v-diasize-resize-button .
     2529     end.
     2530   end procedure.
     2531   on alt-right anywhere
     2532   do:
     2533     run diasize_change-width in this-procedure
     2534       (input 1
     2535       ,input true
     2536       ) .
     2537     return no-apply .
     2538   end.
     2539   on alt-left anywhere
     2540   do:
     2541     run diasize_change-width in this-procedure
     2542       (input -1
     2543       ,input true
     2544       ) .
     2545     return no-apply .
     2546   end.
     2547   on alt-down anywhere
     2548   do:
     2549     run diasize_change-height in this-procedure
     2550       (input 1
     2551       ,input true
     2552       ) .
     2553     return no-apply .
     2554   end.
     2555   on alt-up anywhere
     2556   do:
     2557     run diasize_change-height in this-procedure
     2558       (input -1
     2559       ,input true
     2560       ) .
     2561     return no-apply .
     2562   end.
     2563   on alt-enter of frame Dialog-Frame
     2564   do:
     2565     run diasize_maximize in this-procedure
     2566       (input  ?
     2567       ).
     2568     return no-apply .
     2569   end.
     2570   procedure diasize_end-move :
     2571     do
     2572     on error undo, return error return-value
     2573     :
     2574       define variable v-row-delta as decimal   no-undo .
     2575       define variable v-col-delta as decimal   no-undo .
     2576       define variable v-new-row as decimal   no-undo .
     2577       define variable v-new-col as decimal   no-undo .
     2578       assign
     2579         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2580         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2581       .
     2582       assign
     2583         v-row-delta = v-new-row - frame Dialog-Frame :height
     2584         v-col-delta = v-new-col - frame Dialog-Frame :width
     2585       .
     2586       run diasize_change-height in this-procedure
     2587         (input v-row-delta
     2588         ,input true
     2589         ) .
     2590       run diasize_change-width in this-procedure
     2591         (input v-col-delta
     2592         ,input true
     2593         ) .
     2594     end.
     2595   end procedure.
     2596   procedure diasize_maximize :
     2597     define input  parameter p-action as logical   no-undo .
     2598     do
     2599     on error undo, return error return-value
     2600     :
     2601       if p-action = ?
     2602       then do:
     2603         if v-diasize-need-maximize = true
     2604         then do:
     2605           assign
     2606             p-action = true
     2607           .
     2608         end.
     2609         else do:
     2610           assign
     2611             p-action = false
     2612           .
     2613         end.
     2614       end.
     2615       if p-action = true
     2616       then do:
     2617         run diasize_change-height in this-procedure
     2618           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2619               - frame Dialog-Frame :height-chars
     2620           ,input true
     2621           ) .
     2622         run diasize_change-width in this-procedure
     2623           (input session :width-chars
     2624               - frame Dialog-Frame :width-chars
     2625           ,input true
     2626           ) .
     2627         assign
     2628           v-diasize-need-maximize = false
     2629         .
     2630       end.
     2631       else do:
     2632         run diasize_change-width in this-procedure
     2633           (input v-diasize-orig-frame-width
     2634               - frame Dialog-Frame :width-chars
     2635           ,input true
     2636           ) .
     2637         run diasize_change-height in this-procedure
     2638           (input v-diasize-orig-frame-height
     2639               - frame Dialog-Frame :height-chars
     2640           ,input true
     2641           ) .
     2642         assign
     2643           v-diasize-need-maximize = true
     2644         .
     2645       end.
     2646     end.
     2647   end procedure.
     2648   procedure diasize_restore-orig-size :
     2649     do
     2650     on error undo, return error return-value
     2651     :
     2652       assign
     2653         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2654         v-diasize-current-frame-height = frame Dialog-Frame :height
     2655       .
     2656       run diasize_set-height in this-procedure
     2657         (input  v-diasize-orig-frame-height
     2658         ,input  true
     2659         ) .
     2660       run diasize_set-width in this-procedure
     2661         (input  v-diasize-orig-frame-width
     2662         ,input  true
     2663         ) .
     2664     end.
     2665   end procedure.
     2666   procedure diasize_restore-current-size :
     2667     do
     2668     on error undo, return error return-value
     2669     :
     2670       run diasize_set-height in this-procedure
     2671         (input  v-diasize-current-frame-height
     2672         ,input  true
     2673         ) .
     2674       run diasize_set-width in this-procedure
     2675         (input  v-diasize-current-frame-width
     2676         ,input  true
     2677         ) .
     2678     end.
     2679   end procedure.
     2680   procedure diasize_set-browse-handle :
     2681     define input  parameter p-browse-handle as handle   no-undo .
     2682     define buffer buf_temp-browse-handle for temp-browse-handle .
     2683     do
     2684     on error undo, return error return-value
     2685     :
     2686       assign
     2687         v-diasize-browse-handle = p-browse-handle
     2688       .
     2689       for each buf_temp-browse-handle
     2690       on error undo, return error return-value
     2691       :
     2692         delete buf_temp-browse-handle .
     2693       end.
     2694     end.
     2695   end procedure.
     2696   procedure diasize_add_browse :
     2697     define input  parameter p-browse-type   as character no-undo .
     2698     define input  parameter p-browse-handle as handle    no-undo .
     2699     define buffer buf_temp-browse-handle for temp-browse-handle .
     2700     do
     2701     on error undo, return error return-value
     2702     :
     2703       assign
     2704         v-diasize-browse-number = v-diasize-browse-number + 1
     2705       .
     2706       create buf_temp-browse-handle .
     2707       assign
     2708         buf_temp-browse-handle.browse-type   = p-browse-type
     2709         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2710         buf_temp-browse-handle.browse-handle = p-browse-handle
     2711       .
     2712     end.
     2713   end procedure.
     2714   procedure diasize_init :
     2715     define variable v-default-value    as logical   no-undo .
     2716     define variable v-restore-saved    as logical   no-undo .
     2717     define variable v-resize-value-str as character no-undo .
     2718     do
     2719     on error undo, return error return-value
     2720     :
     2721       do with frame Dialog-Frame
     2722       :
     2723         assign
     2724           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2725           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2726           v-diasize-browse-handle     = browse BR-docs :handle
     2727         .
     2728         create button v-diasize-resize-button
     2729         assign
     2730           parent        = frame Dialog-Frame :first-child
     2731           label         = "s"
     2732           height-pixels = 16
     2733           width-pixels  = 16
     2734           visible       = true
     2735           sensitive     = true
     2736           movable       = true
     2737           triggers:
     2738             on end-move persistent run diasize_end-move in this-procedure .
     2739           end triggers.
     2740         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2741         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2742         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2743         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2744         assign
     2745           v-diasize-wndmax = false
     2746         .
     2747         if connected("ub") = true
     2748         then do:
     2749           define variable v-cntxt-db-num        as integer   no-undo .
     2750           define variable v-cntxt-userid        as character no-undo .
     2751           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2752                                             , OUTPUT v-cntxt-userid
     2753                                             ) .
     2754           run gbl/wndpar_r.p
     2755             (input  v-cntxt-db-num
     2756             ,input  v-cntxt-userid
     2757             ,input  'wndmax':U
     2758             ,output v-diasize-wndmax
     2759             ,output v-default-value
     2760             ) .
     2761         end.
     2762         assign
     2763           v-diasize-wndstore = false
     2764         .
     2765         if connected("ub") = true
     2766         then do:
     2767           run gbl/wndpar_r.p
     2768             (input  v-cntxt-db-num
     2769             ,input  v-cntxt-userid
     2770             ,input  'wndstore':U
     2771             ,output v-diasize-wndstore
     2772             ,output v-default-value
     2773             ) .
     2774         end.
     2775         assign
     2776           v-diasize-proc-name = entry(1, program-name(2), '.')
     2777         .
     2778         if v-diasize-wndstore = true
     2779         then do:
     2780           assign
     2781             v-restore-saved = false
     2782           .
     2783           if connected("ub") = true
     2784           then do:
     2785             run gbl/wndsizer.p
     2786               (input  v-cntxt-db-num
     2787               ,input  v-cntxt-userid
     2788               ,input  v-diasize-proc-name
     2789               ,input  'height':u
     2790               ,output v-resize-value-str
     2791               ) .
     2792             if v-resize-value-str <> '':U
     2793             then do:
     2794               run diasize_change-height in this-procedure
     2795                 (input  integer(v-resize-value-str)
     2796                 ,input  true
     2797                 ) .
     2798               assign
     2799                 v-restore-saved = true
     2800               .
     2801             end.
     2802           end.
     2803           if connected("ub") = true
     2804           then do:
     2805             run gbl/wndsizer.p
     2806               (input  v-cntxt-db-num
     2807               ,input  v-cntxt-userid
     2808               ,input  v-diasize-proc-name
     2809               ,input  'width':u
     2810               ,output v-resize-value-str
     2811               ) .
     2812             if v-resize-value-str <> '':U
     2813             then do:
     2814               run diasize_change-width in this-procedure
     2815                 (input  integer(v-resize-value-str)
     2816                 ,input  true
     2817                 ) .
     2818               assign
     2819                 v-restore-saved = true
     2820               .
     2821             end.
     2822           end.
     2823           if v-restore-saved <> true
     2824           then do:
     2825             if v-diasize-wndmax = true
     2826             then do:
     2827               run diasize_maximize in this-procedure
     2828                 (input  true
     2829                 ) .
     2830             end.
     2831           end.
     2832         end.
     2833         else do:
     2834           if v-diasize-wndmax = true
     2835           then do:
     2836             run diasize_maximize in this-procedure
     2837               (input  true
     2838               ) .
     2839           end.
     2840         end.
     2841       end.
     2842     end.
     2843   end procedure.
     2844   procedure diasize_need-full-display :
     2845     define output parameter p-need-full-display as logical   no-undo .
     2846     do
     2847     on error undo, return error return-value
     2848     :
     2849       assign
     2850         p-need-full-display = v-diasize-need-full-display
     2851       .
     2852       assign
     2853         v-diasize-need-full-display = false
     2854       .
     2855     end.
     2856   end procedure.
     2857   procedure get-context :
     2858      define output parameter p-db-num as integer          no-undo.
     2859      define output parameter p-user-id as character        no-undo.
     2860      define variable v-login               as character    no-undo.
     2861      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2862      define buffer buf_user-login  for ub.user-login .
     2863      do
     2864      on error undo, return error
     2865      :
     2866            FIND FIRST buf_sys-ctrl no-lock.
     2867            ASSIGN
     2868               v-login = USERID("ub")
     2869               p-db-num = buf_sys-ctrl.db-num
     2870            .
     2871            FIND FIRST buf_user-login
     2872                 WHERE buf_user-login.db-num = p-db-num
     2873                   AND buf_user-login.user-login = v-login
     2874                 no-lock
     2875                 no-error
     2876                 .
     2877            IF AVAILABLE buf_user-login
     2878            THEN DO:
     2879               assign
     2880                  p-user-id = buf_user-login.user-id
     2881               .
     2882            END.
     2883      end.
     2884   end procedure.
     2885       run diasize_init in this-procedure .
     2886   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2887   DEF VAR cur-clmn-numBR-docs as INT EXTENT 7 no-undo.
     2888   DEF VAR varmviBR-docs       as INT no-undo.
     2889   DEF VAR varmvjBR-docs       as INT no-undo.
     2890   DEF VAR varmvkBR-docs       as INT no-undo.
     2891   DEF VAR varmvlBR-docs       as INT no-undo.
     2892   DEF VAR move-elementBR-docs as INT no-undo.
     2893   def var jjBR-docs           as int no-undo.
     2894   do varmviBR-docs = 1 to EXTENT(cur-clmn-numBR-docs):
     2895     ASSIGN cur-clmn-numBR-docs[varmviBR-docs] = varmviBR-docs.
     2896   END.
     2897   RUN start-mv-clmnBR-docs.
     2898   PROCEDURE start-mv-clmnBR-docs:
     2899   def var old-session as logical no-undo.
     2900      old-session = SESSION:IMMEDIATE-DISPLAY.
     2901      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2902      SESSION:IMMEDIATE-DISPLAY = old-session.
     2903   END.
     2904   ON ctrl-cursor-right OF BROWSE BR-docs do:
     2905     RUN re-move-clmnBR-docs ( 2, 7).
     2906   END.
     2907   ON ctrl-cursor-left OF BROWSE BR-docs do:
     2908     RUN re-move-clmnBR-docs (7, 2).
     2909   END.
     2910   PROCEDURE re-move-clmnBR-docs:
     2911     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2912     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2913     DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     2914       if cur-clmn-numBR-docs[varmviBR-docs] = source-column THEN cur-clmn-numBR-docs[varmviBR-docs] = -1.
     2915     END.
     2916     if BR-docs:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2917     if source-column > target-column THEN
     2918     DO varmvjBR-docs = source-column - 1 to target-column BY -1:
     2919       DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     2920           if cur-clmn-numBR-docs[varmviBR-docs] = varmvjBR-docs THEN DO:
     2921             cur-clmn-numBR-docs[varmviBR-docs] = cur-clmn-numBR-docs[varmviBR-docs] + 1.
     2922           END.
     2923       END.
     2924     END.
     2925     ELSE
     2926     DO varmvjBR-docs = source-column + 1 to target-column:
     2927       DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     2928         if cur-clmn-numBR-docs[varmviBR-docs] = varmvjBR-docs THEN DO:
     2929           cur-clmn-numBR-docs[varmviBR-docs] = cur-clmn-numBR-docs[varmviBR-docs] - 1.
     2930         END.
     2931       END.
     2932     END.
     2933     DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     2934       if cur-clmn-numBR-docs[varmviBR-docs] = -1 THEN cur-clmn-numBR-docs[varmviBR-docs] = target-column.
     2935     END.
     2936   END PROCEDURE.
     2937   PROCEDURE ch-clmnBR-docs:
     2938     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2939     if cur-clmn-loc <= 2 then do:
     2940       return .
     2941     end.
     2942     DO varmviBR-docs = 1 TO EXTENT(cur-clmn-numBR-docs):
     2943       if cur-clmn-numBR-docs[varmviBR-docs] = cur-clmn-loc THEN move-elementBR-docs = varmviBR-docs.
     2944     END.
     2945     RUN re-move-clmnBR-docs (cur-clmn-loc, 2).
     2946   END PROCEDURE.
     2947   PROCEDURE mv-brw-defaultBR-docs:
     2948   def var old-session as logical no-undo.
     2949     old-session = SESSION:IMMEDIATE-DISPLAY.
     2950     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2951     do varmvlBR-docs = 2 to EXTENT(cur-clmn-numBR-docs):
     2952       RUN re-move-clmnBR-docs (cur-clmn-numBR-docs[varmvlBR-docs], varmvlBR-docs).
     2953     END.
     2954     RUN start-mv-clmnBR-docs.
     2955     SESSION:IMMEDIATE-DISPLAY = old-session.
     2956   END PROCEDURE.
     2957   .
     2958   def var sort-labelBR-docs   as character no-undo .
     2959   def var sort-clmnBR-docs    as handle    no-undo .
     2960   def var cur-clmnBR-docs     as handle    no-undo .
     2961   def var cur-clmn-locBR-docs as integer   no-undo .
     2962   def var re-queryBR-docs     as logical   initial no no-undo .
     2963   on start-search, ctrl-o of BR-docs in frame Dialog-Frame do:
     2964      run sort-brBR-docs
     2965        (input (if available ub.fin-code-cel-nazn
     2966                then recid(ub.fin-code-cel-nazn)
     2967                else ?
     2968               )
     2969        ).
     2970   end.
     2971   PROCEDURE sort-brBR-docs :
     2972     define input parameter p-recid as recid no-undo .
     2973     if re-queryBR-docs = no then do:
     2974       assign
     2975          cur-clmnBR-docs = BR-docs:current-column in frame Dialog-Frame
     2976       .
     2977       if sort-clmnBR-docs <> ? then sort-clmnBR-docs:column-fgcolor = 0.
     2978       if cur-clmnBR-docs = sort-clmnBR-docs then do:
     2979         assign
     2980            sort-labelBR-docs = ""
     2981            sort-clmnBR-docs = ?
     2982         .
     2983        end.
     2984        else do:
     2985          assign
     2986            sort-labelBR-docs = cur-clmnBR-docs:label
     2987            sort-clmnBR-docs  = cur-clmnBR-docs
     2988            sort-clmnBR-docs:column-fgcolor = 4
     2989          .
     2990        end.
     2991      end.
     2992     assign
     2993       cur-clmn-locBR-docs = 1
     2994     .
     2995     def var column-handle as handle no-undo .
     2996     column-handle = BR-docs:first-column.
     2997     do while valid-handle(column-handle) :
     2998       if column-handle = cur-clmnBR-docs then do:
     2999         leave .
     3000       end.
     3001       column-handle = column-handle:NEXT-COLUMN.
     3002       assign
     3003         cur-clmn-locBR-docs = cur-clmn-locBR-docs + 1
     3004       .
     3005     end.
     3006     case sort-labelBR-docs:
     3007           when buf_fin-code.code-value:label in browse BR-docs then DO:    assign       sort-column-name = "buf_fin-code.code-value"     .     run OpenBr(yes, no, '':U).   . END.
     3008           when buf_fin-code.descr:label in browse BR-docs then DO:    assign       sort-column-name = "buf_fin-code.descr"     .     run OpenBr(yes, no, '':U).   . END.
     3009           when buf_fin-code.fin-code:label in browse BR-docs then DO:    assign       sort-column-name = "buf_fin-code.fin-code"     .     run OpenBr(yes, no, '':U).   . END.
     3010           when buf_fin-code.host-code:label in browse BR-docs then DO:    assign       sort-column-name = "buf_fin-code.host-code"     .     run OpenBr(yes, no, '':U).   . END.
     3011           when buf_fin-code.level-1:label in browse BR-docs then DO:    assign       sort-column-name = "buf_fin-code.level-1"     .     run OpenBr(yes, no, '':U).   . END.
     3012           when buf_fin-code.level-2:label in browse BR-docs then DO:    assign       sort-column-name = "buf_fin-code.level-2"     .     run OpenBr(yes, no, '':U).   . END.
     3013           when buf_fin-code.level-3:label in browse BR-docs then DO:    assign       sort-column-name = "buf_fin-code.level-3"     .     run OpenBr(yes, no, '':U).   . END.
     3014       otherwise do:
     3015         assign
     3016           sort-column-name = ""
     3017         .
     3018         run OpenBr(yes, no, '':U).
     3019           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-docs') then do:
     3020             run mv-brw-defaultBR-docs.
     3021           end.
     3022         if sort-labelBR-docs <> "" then do:
     3023           assign
     3024             cur-clmnBR-docs:column-fgcolor = 0
     3025           .
     3026         end.
     3027         assign
     3028           cur-clmn-locBR-docs = ?
     3029         .
     3030       end.
     3031     end case.
     3032       if cur-clmn-locBR-docs <> ? then do:
     3033         if can-do( this-procedure:internal-entries, 'ch-clmnBR-docs') then do:
     3034           run ch-clmnBR-docs in this-procedure (cur-clmn-locBR-docs).
     3035         end.
     3036       end.
     3037     if p-recid <> ? then do:
     3038       reposition BR-docs to recid p-recid no-error.
     3039       apply "value-changed" to BR-docs in frame Dialog-Frame.
     3040     end.
     3041     apply "entry" to BR-docs in frame Dialog-Frame.
     3042   END PROCEDURE.
     3043   procedure re-open-query-srt-clmnBR-docs:
     3044   if cur-clmnBR-docs = ? then do:
     3045      run OpenBr(yes, no, '':U).
     3046   end.
     3047   else do:
     3048      assign re-queryBR-docs = yes.
     3049      run sort-brBR-docs
     3050        (input (if available ub.fin-code-cel-nazn
     3051                then recid(ub.fin-code-cel-nazn)
     3052                else ?
     3053               )
     3054        ).
     3055      assign re-queryBR-docs = no.
     3056   end.
     3057   end.
     3058   MAIN-BLOCK:
     3059   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3060      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3061   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3062     run mainmenu_getcntxt in parparentproc
     3063       (output v-cntxt-db-num
     3064       ,output v-cntxt-userid
     3065       ,output v-cntxt-level
     3066       ,output v-cntxt-host-code-obj
     3067       ,output v-cntxt-obj-type
     3068       ,output v-cntxt-obj-code
     3069       ,output v-cntxt-db-num-obj
     3070       ,output v-cntxt-is-admin
     3071       ) .
     3072     assign
     3073       buf_fin-code.code-value:read-only in browse BR-docs = true
     3074     .
     3075   define variable p-file-label as character no-undo .
     3076   assign
     3077     p-file-label = "Коды целевого назначения"
     3078   .
     3079     define buffer buf_clients for  ub.clients .
     3080     case par-mode:
     3081       when 'все':U
     3082       then do:
     3083       end.
     3084       when 'фирма':U
     3085       then do:
     3086         find first buf_clients no-lock
     3087           where buf_clients.obj-code = par-host-code
     3088             and buf_clients.obj-type = 'орг':U
     3089           no-error .
     3090         if not available buf_clients then do:
     3091           message
     3092           substitute("Неверное значение параметра par-host-code=&1", par-host-code)
     3093           view-as alert-box error .
     3094           return error.
     3095         end.
     3096         find first X_sysconf where X_sysconf.host-code = par-host-code .
     3097         v-main-firm-db = X_sysconf.firm-db-num.
     3098       end.
     3099       otherwise do:
     3100         message vss-workfile vss-revision vss-description skip
     3101         "Неверный вызов - par-mode=" par-mode skip
     3102         view-as alert-box error.
     3103         return.
     3104       end.
     3105     end case.
     3106       if pardoc-rec <> ? then do:
     3107         FIND FIRST find_code No-LOCK where
     3108                    recid(find_code) = pardoc-rec No-ERROR.
     3109         if not avail find_code then do:
     3110           message
     3111           vss-workfile vss-revision vss-description skip
     3112           "Неверное значение параметра вызова pardoc-rec" pardoc-rec
     3113           view-as alert-box error .
     3114           return error.
     3115         end.
     3116         doc-rec = pardoc-rec.
     3117       end.
     3118     run my-enable_ui in this-procedure.
     3119     run openbr in this-procedure (yes, no, '':u).
     3120     hide mark-num in frame Dialog-Frame .
     3121     if pardoc-rec <> ? then
     3122     reposition br-docs to recid doc-rec no-error.
     3123     wait-for go of frame Dialog-Frame .
     3124   end.
     3125   run disable_ui in this-procedure.
     3126   PROCEDURE add-proc :
     3127   define variable v-doc-rec as recid no-undo .
     3128   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3129   do:
     3130     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3131       (input  v-cntxt-db-num
     3132       ,input  v-cntxt-userid
     3133       ,input  0
     3134       ,input  'actn_fin-reference_add-def':U
     3135       ,input  'firm':U
     3136       ,input  par-host-code
     3137       ,input  '':U
     3138       ,input  0
     3139       ,input  0
     3140       ,input  0
     3141       ,input  0
     3142       ,input  true
     3143       ,output g#log
     3144       )  .
     3145   end.
     3146   if not g#log then  return .
     3147   define variable rr as recid no-undo .
     3148               run ref/fci-2.w ( 'ДОБАВЛЕНИЕ':U , input-output rr , input par-host-code ).
     3149     v-doc-rec = rr .
     3150     run OpenBr in this-procedure (yes, no, '':U).
     3151     REPOSITION br-docs to recid v-doc-rec no-error .
     3152   END PROCEDURE.
     3153   PROCEDURE disable_UI :
     3154     HIDE FRAME Dialog-Frame.
     3155   END PROCEDURE.
     3156   PROCEDURE enable_UI :
     3157     DISPLAY rs-sts p-desc sch-code mark-num
     3158         WITH FRAME Dialog-Frame.
     3159     ENABLE B-exit B-mark B-sel B-add B-lkp B-chg B-del B-firm B-copy B-sch
     3160            B-print B-Help BR-docs rs-sts p-desc sch-code mark-num
     3161         WITH FRAME Dialog-Frame.
     3162     VIEW FRAME Dialog-Frame.
     3163     OPEN QUERY BR-docs FOR EACH buf_fin-code NO-LOCK .
     3164   END PROCEDURE.
     3165   PROCEDURE my-enable_UI :
     3166   ASSIGN
     3167   rs-sts:RADIO-BUTTONS IN FRAME Dialog-Frame
     3168                          = "Текущие&+" + chr(44) +  '0':U + chr(44) +
     3169                          "Все&!" + chr(44) + 'все':U + chr(44) +
     3170                           "Удаленные&-" + chr(44) + '1':U
     3171   rs-sts = (IF p-sts = ? THEN 'все':U ELSE string(p-sts))
     3172   .
     3173   DISPLAY sch-code p-desc mark-num
     3174         WITH FRAME Dialog-Frame.
     3175     ENABLE B-exit
     3176            rs-sts
     3177            B-lkp
     3178            B-add       when LOOKUP("b-add":U,  bttns) > 0  and v-cntxt-db-num = v-main-firm-db and not transaction
     3179            B-chg       when LOOKUP("b-chg":U,  bttns) > 0  and v-cntxt-db-num = v-main-firm-db and not transaction
     3180            B-copy      when LOOKUP("b-add":U,  bttns) > 0  and v-cntxt-db-num = v-main-firm-db and not transaction
     3181            B-firm
     3182            B-History
     3183            B-sch
     3184            B-print
     3185            B-Help
     3186            b-sel        when LOOKUP("b-sel":U,  bttns) > 0
     3187            b-mark       when LOOKUP("b-mark":U, bttns) > 0
     3188            b-del        when LOOKUP("b-del":U,  bttns) > 0 and v-cntxt-db-num = v-main-firm-db  and not transaction
     3189            BR-docs sch-code p-desc mark-num
     3190         WITH FRAME Dialog-Frame.
     3191     VIEW FRAME Dialog-Frame.
     3192   END PROCEDURE.
     3193   PROCEDURE OpenBr :
     3194   define input  parameter p-open-query     as logical   no-undo .
     3195   define input  parameter p-find-next      as logical   no-undo .
     3196   define input  parameter p-find-condition as character no-undo .
     3197   define variable l-query-was-opened as logical no-undo .
     3198   define variable title0 as character no-undo.
     3199   title0 = "Справочник фин.кодов " + caps(p-file-label) + chr(32).
     3200   define variable sort-column-phrase as character no-undo .
     3201   case sort-column-name :
     3202     when "" then do:
     3203       assign
     3204         sort-column-phrase = ""
     3205       .
     3206     end.
     3207     otherwise do:
     3208       assign
     3209         sort-column-phrase = "by " + sort-column-name
     3210       .
     3211     end.
     3212   end case.
     3213   define variable l-open-query as logical   no-undo .
     3214    IF p-sts <> ? THEN DO:
     3215        CASE par-mode :
     3216            WHEN 'все':U        THEN DO:
     3217             filter-point = filter-point0 + par-mode.
     3218             ASSIGN frame Dialog-Frame:TITLE = title0 .
     3219   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3220   define variable  l-disable-where-25  as logical   no-undo .
     3221   define variable  l-filter-open-25    as logical   .
     3222   define variable  flt-rec-25       as recid     no-undo .
