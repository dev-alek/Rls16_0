      368   procedure fltfield-clear :
      369     define output parameter loc-fld as character no-undo.
      370     define output parameter loc-lab as character no-undo .
      371     define output parameter loc-spr as character no-undo .
      372     define output parameter loc-dim as character no-undo .
      373     assign
      374       loc-fld = ""
      375       loc-lab = ""
      376       loc-spr = ""
      377       loc-dim = "0"
      378     .
      379   end procedure .
      380   procedure fltfield-add :
      381     define input        parameter par-fld as character no-undo.
      382     define input        parameter par-lab as character no-undo .
      383     define input        parameter par-spr as character no-undo .
      384     define input-output parameter loc-fld as character no-undo.
      385     define input-output parameter loc-lab as character no-undo .
      386     define input-output parameter loc-spr as character no-undo .
      387     define input-output parameter loc-dim as character no-undo .
      388     do
      389     on error undo, return error
      390     :
      391       assign
      392       loc-fld = if loc-dim = '0'
      393                 then par-fld
      394                 else (loc-fld + chr(44) + par-fld)
      395       loc-lab = if loc-dim = '0'
      396                 then par-lab
      397                 else (loc-lab + chr(44) + par-lab)
      398       loc-spr = if loc-dim = '0'
      399                 then par-spr
      400                 else (loc-spr + chr(44) + par-spr)
      401       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      402                 string(integer(if num-entries(loc-dim) > 1
      403                               then entry(2, loc-dim)
      404                               else entry(1, loc-dim)
      405                               ) + 1)
      406       no-error
      407       .
      408     end.
      409   end procedure.
      410   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      411   define  stream PrnLibStream.
      412   procedure prn-lib-prn-file :
      413     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      414     define input parameter p-DIsabledoptions as integer no-undo .
      415     define variable v-report-name as character no-undo .
      416     define variable v-user-action as character no-undo .
      417     define variable v-printed     as logical   no-undo .
      418     define variable v-exist       as logical   no-undo .
      419     do
      420       on error undo, return error
      421       :
      422       run prn-lib-get-report-name  in this-procedure (
      423         input parParentProc
      424         ,output v-report-name
      425         ).
      426   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      427   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      428     (input  v-report-name
      429     ,input  2
      430     ,output v-exist
      431     )  .
      432       if NOT v-exist then
      433       DO:
      434         Message
      435           "Нет заданий на печать ! "
      436           view-as alert-box .
      437         Return  .
      438       End.
      439       run gbl/prnfilen.w
      440         (input  ""
      441         ,input  p-DisabledOptions
      442         ,input  string(v-report-name )
      443         ,input  7
      444         ,output v-user-action
      445         ,output v-printed
      446         ) .
      447       if v-printed then
      448       do:
      449         return "YES" .
      450       end.
      451       else
      452       do:
      453         return "NO" .
      454       end.
      455     end.
      456   end procedure.
      457   procedure prn-lib-open-stream :
      458     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      459     define input parameter p-page-size    as integer no-undo .
      460     define input parameter p-is-stream    as logical no-undo .
      461     define input parameter p-append       as logical no-undo .
      462     define variable v-report-name as character no-undo .
      463     do
      464       on error undo, return error
      465       :
      466       run prn-lib-get-report-name  in this-procedure (
      467         input parParentProc
      468         ,output v-report-name
      469         ).
      470       if p-is-stream then
      471       do:
      472         if p-append then
      473         do:
      474           output stream PrnLibStream to value( v-report-name )
      475             page-size value(p-page-size) append .
      476         end.
      477         if not p-append then
      478         do:
      479           output stream PrnLibStream to value( v-report-name )
      480             page-size value(p-page-size) .
      481         end.
      482       end.
      483       if not p-is-stream then
      484       do:
      485         if p-append then
      486         do:
      487           output to value( v-report-name )
      488             page-size value(p-page-size) append .
      489         end.
      490         if not p-append then
      491         do:
      492           output to value( v-report-name )
      493             page-size value(p-page-size) .
      494         end.
      495       end.
      496     end.
      497   end procedure.
      498   procedure prn-lib-open-exp :
      499     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      500     define input parameter p-is-stream    as logical no-undo .
      501     define input parameter p-is-append    as logical no-undo .
      502     define output parameter p-ReportFileName as char init "report" no-undo.
      503     define output parameter p-process as logical no-undo .
      504     define variable glog as logical no-undo .
      505     do
      506       on error undo, return error
      507       :
      508       SYSTEM-DIALOG GET-FILE p-ReportFileName
      509         TITLE      "Укажите путь"
      510         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      511         ASK-OVERWRITE
      512         CREATE-TEST-FILE
      513         SAVE-AS
      514         USE-FILENAME
      515         DEFAULT-EXTENSION "txt"
      516         UPDATE glog
      517         .
      518       if not glog then  return.
      519       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      520       if p-is-stream then
      521       do:
      522         if p-is-append then
      523         do:
      524           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      525         end.
      526         else
      527         do:
      528           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      529         end.
      530       end.
      531       else
      532       do:
      533         if p-is-append then
      534         do:
      535           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      536         end.
      537         else
      538         do:
      539           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      540         end.
      541       end.
      542       p-process = yes.
      543     end.
      544   end procedure.
      545   procedure prn-lib-get-report-name :
      546     define input parameter parParentProc  as widget-handle no-undo.
      547     define output parameter p-report-name as character no-undo .
      548     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      549   end procedure.
      550   procedure prn-lib-reportviewer-report-name :
      551     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      552     define input parameter p-report-name-html as character no-undo .
      553     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      554   end procedure.
      555   procedure prn-lib-reportviewer :
      556     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      557     define input parameter p-report-name-html as character no-undo .
      558     define input parameter p-param        as character no-undo .
      559     define variable v-excel           as character no-undo init 'TRUE' .
      560     define variable v-value-character as character no-undo .
      561     define variable v-value-integer   as character no-undo .
      562     define variable v-value-date      as date      no-undo .
      563     define variable v-value-decimal   as decimal   no-undo .
      564     define variable rep-excel         as logical   no-undo .
      565     define variable excel-string      as character no-undo .
      566     define variable v-param-type      as character no-undo .
      567     define variable v-tth             as handle    no-undo .
      568     run adm/shattri.p (
      569       input "get":U
      570       ,input  ""
      571       ,input  0
      572       ,input  'report-glob':U
      573       ,input  'rep-excel':U
      574       ,output v-value-character
      575       ,output v-value-date
      576       ,output v-value-decimal
      577       ,output v-value-integer
      578       ,output rep-excel
      579       ,output v-param-type
      580       ,INPUT-OUTPUT table-handle v-tth
      581       )  .
      582     if rep-excel then v-excel = "TRUE" .
      583     else v-excel = "FALSE" .
      584     if p-param eq ""
      585     then
      586        p-param = "EXCEL:" + v-excel.
      587     else
      588        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      589     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      590   end procedure.
      591   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      592   define variable v-waitfram-action01         as character   no-undo .
      593   define variable v-waitfram-action02         as character   no-undo .
      594   define variable v-waitfram-action03         as character   no-undo .
      595   define variable mWaitFramTextBeg            as character   no-undo.
      596   define variable mWaitFramTextEnd            as character   no-undo.
      597   define variable mWaitFramView               as logical     no-undo.
      598   define variable mWaitProcEvent              as logical     no-undo init yes.
      599   define variable mWaitFramInterval           as integer     no-undo init 1 .
      600   define variable mWaitFramStop               as logical     no-undo.
      601   define variable mWaitFramStopUser           as logical     no-undo.
      602   define variable mWaitFramStopTimeOut        as logical     no-undo.
      603   define variable mWaitFramStartProc          as datetime-tz no-undo.
      604   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      605   define button B-WaitFramStop auto-end-key
      606        label "Стоп"
      607        size 10 by 1 tooltip "Остоновить процесс".
      608   define button B-viewProcInfo
      609        label "Информация"
      610        size 15 by 1 tooltip "Информация о процесс".
      611   define frame waitfram
      612     v-waitfram-action01 format "x(72)" no-label skip
      613     v-waitfram-action02 format "x(72)" no-label skip
      614     v-waitfram-action03 format "x(72)" no-label skip
      615     B-viewProcInfo
      616     B-WaitFramStop at row 4 col 30
      617     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      618     .
      619   define new global shared variable mBatchMode as logical no-undo init ?.
      620   define variable mFramBachModHandle as handle no-undo.
      621   mFramBachModHandle = frame waitfram:handle.
      622   define variable mFameOldVis as logical no-undo.
      623   define variable mVisCUrentVin as logical no-undo.
      624   if session:batch-mode
      625   then
      626      mBatchMode = yes.
      627   if mBatchMode = ? then do:
      628     mVisCUrentVin = current-window:visible.
      629     mFameOldVis = mFramBachModHandle:visible.
      630     mFramBachModHandle:visible  = yes.
      631     mBatchMode = mFramBachModHandle:visible ne yes.
      632     mFramBachModHandle:visible = mFameOldVis.
      633     current-window:visible = mVisCUrentVin.
      634   end.
      635    if  log-manager:logfile-name ne ?
      636     then DO:
      637         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      638         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      639         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      640     end.
      641   on choose of B-WaitFramStop in frame waitfram
      642   do:
      643     mWaitFramStop = yes.
      644     mWaitFramStopUser = yes.
      645   end.
      646   function waitfram-check-timeout returns logical():
      647      define variable vtime as int64 no-undo.
      648      if mWaitFramStopTimeOut
      649      then
      650         return yes.
      651      vtime = ( now - mWaitFramStartProc ) / 1000 .
      652      if     mWaitFramTimeOut ne ?
      653         and mWaitFramTimeOut ne 0
      654         and mWaitFramTimeOut lt vtime
      655      then do:
      656         mWaitFramStopTimeOut = yes.
      657      end.
      658      return mWaitFramStopTimeOut.
      659   end.
      660   procedure waitfram-hide :
      661     if not session:batch-mode
      662     then do
      663     on error undo, return error return-value
      664     :
      665       pause 0 before-hide .
      666       if not mBatchMode then
      667         hide frame waitfram .
      668     if     not mWaitFramView
      669        and mWaitProcEvent
      670     then
      671       process events .
      672     end.
      673   end procedure.
      674   procedure waitfram-show :
      675     define input  parameter p-message as character no-undo .
      676     define variable v-left-margin as integer   no-undo .
      677     if not session:batch-mode
      678     then do
      679     on error undo, return error return-value
      680     :
      681       if length(p-message) <= 70 then do:
      682         assign
      683           v-left-margin = integer((70 - length(p-message)) / 2)
      684         .
      685         assign
      686           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      687         .
      688         assign
      689           v-waitfram-action01 = " "
      690           v-waitfram-action02 = " "
      691                                    + fill(" ", v-left-margin)
      692                                    + p-message
      693           v-waitfram-action03 = " "
      694         .
      695       end.
      696       else do:
      697         define variable vRindex1 as integer no-undo.
      698         define variable vRindex2 as integer no-undo.
      699         vRindex1 = r-index(p-message," ",70).
      700         if vRindex1 = 0
      701         then
      702            vRindex1 = 70.
      703         if length(p-message)  <= vRindex1 + 70 then do:
      704           assign
      705             v-waitfram-action01 = " "
      706             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      707             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      708           .
      709         end.
      710         else do:
      711           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      712           if vRindex2 <= vRindex1
      713           then
      714              vRindex2 = vRindex1 + 70.
      715           assign
      716             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      717             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      718             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      719           .
      720         end.
      721       end.
      722       B-viewProcInfo:visible   in frame waitfram = no.
      723       B-viewProcInfo:sensitive in frame waitfram = no.
      724       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      725       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      726       if  (   mWaitFramView
      727          or  mWaitProcEvent)
      728          and not mBatchMode
      729       then
      730          display
      731             v-waitfram-action01 skip
      732             v-waitfram-action02 skip
      733             v-waitfram-action03 skip
      734          with frame waitfram .
      735       if     mWaitFramView
      736          then do:
      737             if     mWaitFramInterval ne ?
      738                and not mBatchMode
      739             then
      740                wait-for go of frame waitfram pause mWaitFramInterval.
      741          end.
      742          else
      743             if     mWaitProcEvent
      744                and not mBatchMode
      745             then
      746                process events .
      747     end.
      748   end procedure.
      749      procedure waitfram-show-this:
      750         define input  parameter iInterval as int64 no-undo.
      751         define variable vtime as int64 no-undo.
      752         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      753         mWaitFramInterval = iInterval.
      754         run waitfram-show (substitute("&1&2 &3&4" ,
      755                                       mWaitFramTextBeg ,
      756                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      757                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      758                                       mWaitFramTextEnd
      759                                      )
      760                           ).
      761      end.
      762      procedure WaitFramRunPause:
      763         define input  parameter iInterval as dec no-undo.
      764         define variable vStart  as datetime-tz no-undo.
      765         define variable vend    as datetime-tz no-undo.
      766         define variable vint as int64 no-undo.
      767         define variable vOk as logical no-undo.
      768         vStart = now.
      769         vend   = vStart.
      770         publish "WaitFramPause" (iInterval,output vOk).
      771         vend   =  now.
      772         vint = vend - vStart.
      773         vint = iInterval - vint / 1000.
      774         if     not mWaitFramStop
      775            and (   vint > 0
      776                 or (    not vOk
      777                     and iInterval eq ?
      778                     )
      779                 )
      780         then
      781            run waitfram-show-this (iInterval).
      782         vend   =  now.
      783         vint = vend - vStart.
      784         vint = iInterval - vint / 1000.
      785         if     not mWaitFramStop
      786            and vint > 0
      787         then do:
      788            run gbl/pause.p (vint * 1000).
      789         end.
      790         if iInterval ne ?
      791         then
      792            publish "WaitFramStop".
      793         waitfram-check-timeout().
      794      end.
      795      procedure WaitFramWaitFor:
      796         define input  parameter iInterval as dec no-undo.
      797         assign
      798            mWaitFramStartProc   = now
      799            mWaitFramStopUser    = no
      800            mWaitFramStopTimeOut = no
      801         .
      802         block-wait:
      803         do while not mWaitFramStop:
      804            run WaitFramRunPause (iInterval).
      805            if  waitfram-check-timeout()
      806            then do:
      807               leave block-wait.
      808            end.
      809         end.
      810         run waitfram-hide.
      811      end.
      812   procedure waitfram-join :
      813     define input  parameter p-line-1  as character no-undo .
      814     define input  parameter p-line-2  as character no-undo .
      815     define input  parameter p-line-3  as character no-undo .
      816     define output parameter p-message as character no-undo .
      817     do
      818     on error undo, return error return-value
      819     :
      820       assign
      821         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      822                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      823                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      824       .
      825     end.
      826   end procedure.
      827   function waitfram-join-function returns character
      828     (input p-line-1 as character
      829     ,input p-line-2 as character
      830     ,input p-line-3 as character
      831     ).
      832     define variable v-message as character no-undo .
      833     run waitfram-join in this-procedure
      834       (input  p-line-1
      835       ,input  p-line-2
      836       ,input  p-line-3
      837       ,output v-message
      838       ) .
      839     return v-message .
      840   end function .
      841   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      842     define variable v-cntxt-db-num        as integer   no-undo .
      843     define variable v-cntxt-userid        as character no-undo .
      844     define variable v-cntxt-level         as character no-undo .
      845     define variable v-cntxt-host-code-obj as integer   no-undo .
      846     define variable v-cntxt-obj-type      as character no-undo .
      847     define variable v-cntxt-obj-code      as integer   no-undo .
      848     define variable v-cntxt-db-num-obj    as integer   no-undo .
      849     define variable v-cntxt-is-admin      as logical   no-undo .
      850   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      851   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      852   procedure fltopend_fltopend :
      853   define input parameter p-parent-handle as handle no-undo .
      854   define input parameter p-qh as handle no-undo .
      855   define input parameter p-flt-open-open-query  as character no-undo .
      856   define input parameter p-where-cond as character no-undo .
      857   define input parameter p-use-indFIRST-query-tail as character no-undo .
      858   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      859   define input parameter p-indexed-reposition as character no-undo .
      860     do
      861     on error undo, return error
      862     :
      863   define variable v-prepare-string as character no-undo .
      864   define variable glog as logical no-undo .
      865   assign
      866   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      867                      p-where-cond + chr(32)  +
      868                      p-use-indFIRST-query-tail + chr(32) +
      869                      p-use-ind-sort-clmn-by + chr(32) +
      870                      p-indexed-reposition
      871   .
      872   assign
      873   glog = p-qh:query-prepare(v-prepare-string) no-error .
      874   if not glog
      875   or error-status:error then do:
      876     message error-status:get-message(1) view-as alert-box .
      877     undo, return error .
      878   end.
      879   assign
      880   glog = p-qh:query-open no-error .
      881   if not glog
      882   or error-status:error then do:
      883     message error-status:get-message(1) view-as alert-box .
      884     undo, return error .
      885   end.
      886     end.
      887   end procedure.
      888   procedure fltopend_fltfindd :
      889   define input parameter p-parent-handle as handle no-undo .
      890   define input parameter p-qh as handle no-undo .
      891   define input parameter p-rowid as rowid no-undo .
      892   define input parameter p-next as logical no-undo .
      893   define input parameter p-lock as integer no-undo .
      894   define input parameter p-bh as handle no-undo .
      895   define input parameter p-where-cond as character no-undo .
      896   define input parameter p-use-index-phrase as character no-undo .
      897   define variable glog as logical no-undo .
      898   define variable v-qh as handle no-undo .
      899   define variable v-bh as handle no-undo .
      900   define variable v-recid as recid no-undo .
      901   define variable v-prepare-string as character no-undo .
      902   do
      903   on error undo, return error
      904   on stop undo, return error
      905   :
      906     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      907     create buffer v-bh for table p-bh buffer-name p-bh:name.
      908     create query v-qh.
      909     v-qh:set-buffers(v-bh).
      910     v-prepare-string = substitute("for each &1 &2 &3"
      911                                     ,v-bh:name
      912                                     ,p-where-cond
      913                                     ,p-use-index-phrase).
      914     glog = v-qh:query-prepare(v-prepare-string) no-error.
      915     if not glog then do:
      916       delete object v-qh.
      917       delete object v-bh.
      918       undo, return error .
      919     end.
      920     glog = v-qh:query-open no-error .
      921     if not glog then do:
      922       delete object v-qh.
      923       delete object v-bh.
      924       undo, return error .
      925     end.
      926     if p-next then do:
      927       v-qh:reposition-to-rowid(p-rowid) no-error .
      928       glog = v-qh:get-next( p-lock) no-error .
      929       glog = v-qh:get-next( p-lock) no-error .
      930       if not glog or v-qh:query-off-end = yes then do:
      931         glog = v-qh:get-first( p-lock) no-error .
      932       end.
      933     end.
      934     else do:
      935       glog = v-qh:get-first( p-lock) no-error .
      936     end.
      937     v-recid = v-bh:recid no-error .
      938     delete object v-qh.
      939     delete object v-bh.
      940     return string(v-recid) .
      941   end.
      942   end procedure.
      943   procedure fltopend_fltfindq :
      944   define input parameter p-parent-handle as handle no-undo .
      945   define input parameter p-qh as handle no-undo .
      946   define input parameter p-next as logical no-undo .
      947   define input parameter p-lock as integer no-undo .
      948   define input parameter p-flt-open-open-query  as character no-undo .
      949   define input parameter p-where-cond as character no-undo .
      950   define input parameter p-use-indFIRST-query-tail as character no-undo .
      951   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      952   define input parameter p-indexed-reposition as character no-undo .
      953   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      954   define variable glog as logical no-undo .
      955   define variable v-qh as handle no-undo .
      956   define variable v-bh as handle no-undo extent 18.
      957   define variable v-rowid as rowid no-undo extent 18.
      958   define variable v-ii as integer no-undo .
      959   define variable v-prepare-string as character no-undo .
      960   do
      961   on error undo, return error
      962   on stop undo, return error
      963   :
      964     create query v-qh.
      965     do v-ii = 1 to p-qh:num-buffers:
      966       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      967       assign
      968       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      969       no-error.
      970       v-qh:add-buffer(v-bh[v-ii]).
      971     end.
      972     assign
      973     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      974                       p-where-cond + chr(32)  +
      975                       p-use-indFIRST-query-tail + chr(32) +
      976                       p-use-ind-sort-clmn-by + chr(32) +
      977                       p-indexed-reposition
      978     .
      979     glog = v-qh:query-prepare( v-prepare-string) no-error .
      980     if not glog then do:
      981       delete object v-qh.
      982       do v-ii = 1 to p-qh:num-buffers:
      983         delete object v-bh[v-ii].
      984       end.
      985       undo, return error .
      986     end.
      987     glog = v-qh:query-open no-error .
      988     if not glog then do:
      989       delete object v-qh.
      990       do v-ii = 1 to p-qh:num-buffers:
      991         delete object v-bh[v-ii].
      992       end.
      993       undo, return error .
      994     end.
      995     if p-next then do:
      996       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      997       glog = v-qh:get-next( p-lock) no-error .
      998       glog = v-qh:get-next( p-lock) no-error .
      999       if not glog or v-qh:query-off-end = yes then do:
     1000         glog = v-qh:get-first( p-lock) no-error .
     1001       end.
     1002     end.
     1003     else do:
     1004       glog = v-qh:get-first( p-lock) no-error .
     1005     end.
     1006     do v-ii = 1 to p-qh:num-buffers:
     1007       assign
     1008       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1009       no-error.
     1010     end.
     1011     delete object v-qh.
     1012     do v-ii = 1 to p-qh:num-buffers:
     1013       delete object v-bh[v-ii].
     1014     end.
     1015   end.
     1016   end procedure.
     1017   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1018   FUNCTION mark-string RETURNS CHARACTER
     1019     ( input p-recid as recid, input mark-list as character  ) :
     1020     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1021   END FUNCTION.
