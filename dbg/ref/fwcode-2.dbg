     1206   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1207   DO:
     1208   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1209   do:
     1210     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1211       (input  v-cntxt-db-num
     1212       ,input  v-cntxt-userid
     1213       ,input  0
     1214       ,input  'actn_fin-reference_deletion':U
     1215       ,input  'firm':U
     1216       ,input  par-host-code
     1217       ,input  '':U
     1218       ,input  0
     1219       ,input  0
     1220       ,input  0
     1221       ,input  0
     1222       ,input  true
     1223       ,output g#log
     1224       )  .
     1225   end.
     1226   if not g#log then  return .
     1227     else do:
     1228         message "Удалить запись в справочнике ?"
     1229         view-as alert-box question
     1230         buttons yes-no
     1231         update g#log.
     1232         if g#log = false then return.
     1233     end.
     1234     find current buf_fin-code  exclusive-lock  no-error .
     1235     if available buf_fin-code then do:
     1236         find first ub.sysconf no-lock where
     1237             (ub.sysconf.cel-nazn-code-in         = buf_fin-code.fin-code and
     1238               ub.sysconf.host-code               = buf_fin-code.host-code) or
     1239             (ub.sysconf.cel-nazn-code-in-cash    = buf_fin-code.fin-code and
     1240               ub.sysconf.host-code               = buf_fin-code.host-code) or
     1241             (ub.sysconf.cel-nazn-code-in-payoff  = buf_fin-code.fin-code and
     1242               ub.sysconf.host-code               = buf_fin-code.host-code) or
     1243             (ub.sysconf.cel-nazn-code-out        = buf_fin-code.fin-code and
     1244               ub.sysconf.host-code               = buf_fin-code.host-code) or
     1245             (ub.sysconf.cel-nazn-code-out-cash   = buf_fin-code.fin-code and
     1246               ub.sysconf.host-code               = buf_fin-code.host-code) or
     1247             (ub.sysconf.cel-nazn-code-out-payoff = buf_fin-code.fin-code and
     1248               ub.sysconf.host-code               = buf_fin-code.host-code)
     1249               no-error .
     1250         if available ub.sysconf
     1251           then do:
     1252             message
     1253               vss-workfile vss-revision vss-description skip
     1254               "Нельзя удалять запись! " skip
     1255               "Значение справочника используется в настройке фирмы"  skip
     1256               view-as alert-box error .
     1257             return no-apply .
     1258           end.
     1259       buf_fin-code.status_ = 1.
     1260       run OpenBr in this-procedure (yes, no, '':U).
     1261     end.
     1262   END.
     1263   ON CHOOSE OF B-firm IN FRAME Dialog-Frame
     1264   DO:
     1265   define var p-out-host-code like ub.sysconf.host-code no-undo.
     1266   define variable v-rid-list as character no-undo .
     1267   define buffer buf_sysconf for ub.sysconf.
     1268   find first buf_sysconf no-lock where
     1269               buf_sysconf.host-code = par-host-code no-error.
     1270   if available buf_sysconf then v-rid-list =string( recid(buf_sysconf) ).
     1271   run adm/sconfs.w (input parParentProc,
     1272                 input "b-sel":U,
     1273                 input no,
     1274                 input  par-host-code ,
     1275                 output p-out-host-code,
     1276                 input-output v-rid-list
     1277                   ).
     1278   define variable p-ret as logical no-undo .
     1279   if p-out-host-code <> ? then do:
     1280   run current-db  in this-procedure (
     1281       input p-out-host-code,
     1282       input par-host-code,
     1283       output p-ret ) no-error .
     1284   if error-status :error then do:
     1285      message vss-workfile vss-revision vss-description skip
     1286              error-status :get-message(1) .
     1287      return .
     1288      end.
     1289   if p-ret = no then return.
     1290   if p-out-host-code <> ? then
     1291      par-host-code = p-out-host-code .
     1292   run OpenBR in this-procedure (yes, no, '':U).
     1293   end.
     1294   END.
     1295   ON CHOOSE OF B-import IN FRAME Dialog-Frame
     1296   DO:
     1297   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1298   do:
     1299     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1300       (input  v-cntxt-db-num
     1301       ,input  v-cntxt-userid
     1302       ,input  0
     1303       ,input  'actn_fin-reference_export':U
     1304       ,input  'firm':U
     1305       ,input  par-host-code
     1306       ,input  '':U
     1307       ,input  0
     1308       ,input  0
     1309       ,input  0
     1310       ,input  0
     1311       ,input  true
     1312       ,output g#log
     1313       )  .
     1314   end.
