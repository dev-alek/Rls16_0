     3791               find first buf_clients no-lock where buf_clients.obj-code = par-host-code and buf_clients.obj-type = 'орг':U no-error .
     3792               if not available buf_clients then return .
     3793               filter-point = filter-point0 + par-mode.
     3794               ASSIGN frame Dialog-Frame:TITLE = title0 + "   ФИРМА: " + buf_clients.obj-name  + "  код:" +  string(par-host-code).
     3795   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3796   define variable  l-disable-where-31  as logical   no-undo .
     3797   define variable  l-filter-open-31    as logical   .
     3798   define variable  flt-rec-31       as recid     no-undo .
     3799   define variable  filter-name-31      as character no-undo .
     3800   define variable  where-phrase-31     as character no-undo .
     3801   define variable  sort-phrase-31      as character no-undo .
     3802   define variable  where-phrase-rus-31 as character no-undo .
     3803   define variable  sort-phrase-rus-31  as character no-undo .
     3804     run waitfram-show in this-procedure
     3805       (input "ЖДИТЕ ..."
     3806       ).
     3807   run gbl/flt-get.p
     3808     (input filter-point
     3809     ,output flt-rec-31
     3810     ,output filter-name-31
     3811     ,output where-phrase-31
     3812     ,output sort-phrase-31
     3813     ,output where-phrase-rus-31
     3814     ,output sort-phrase-rus-31
     3815     ).
     3816   if p-open-query then do:
     3817       run set-filter-name in this-procedure
     3818         (INPUT filter-name-31
     3819         ) no-error .
     3820     assign
     3821       l-filter-open-31 = false
     3822     .
     3823     if flt-rec-31 <> ?
     3824       or sort-column-phrase > ""
     3825     then do:
     3826       define variable  parameter-2-31 as character no-undo .
     3827       define variable  parameter-3-31 as character no-undo .
     3828       define variable  parameter-4-31 as character no-undo .
     3829       define variable  parameter-5-31 as character no-undo .
     3830       define variable  parameter-6-31 as character no-undo .
     3831       define variable  parameter-7-31 as character no-undo .
     3832         assign
     3833         parameter-3-31 =
     3834                                 "FOR EACH buf_fin-code"
     3835         parameter-4-31 =
     3836           (
     3837             if (" buf_fin-code.host-code = par-host-code " + " " + where-phrase-31) <> ""
     3838             then  substitute (' buf_fin-code.host-code = &1 ', par-host-code)  + " " + where-phrase-31
     3839             else "true"
     3840           )
     3841         parameter-5-31 = (" " + "" + " " + "")
     3842         parameter-6-31 = if sort-phrase-31 = ''
     3843                              then
     3844           (
     3845           " " + " USE-INDEX val " +
     3846             " " + sort-column-phrase +
     3847           " " + "  "
     3848           )
     3849                              else
     3850           (
     3851           " " + " USE-INDEX val " +
     3852             " " + sort-column-phrase +
     3853           " " + sort-phrase-31
     3854           )
     3855         parameter-7-31 =
     3856           " indexed-reposition  "
     3857       .
     3858       do
     3859       on stop undo, leave
     3860       on error undo, leave
     3861       :
     3862         assign
     3863           l-disable-where-31 =
     3864             (" buf_fin-code.host-code = par-host-code " + " " + where-phrase-31 = "")
     3865         .
     3866         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3867                             ,input query br-docs:handle
     3868                             ,input parameter-3-31
     3869                             ,input parameter-4-31
     3870                             ,input parameter-5-31
     3871                             ,input parameter-6-31
     3872                             ,input parameter-7-31
     3873                             )
     3874         .
     3875         assign
     3876           l-filter-open-31 = true
     3877         .
     3878       end.
     3879       if l-filter-open-31 = false then do:
     3880         message
     3881           "Ошибка при фильтрации / сортировке" skip
     3882           "Будут показаны записи без учета фильтра" skip
     3883           view-as alert-box .
     3884       end.
     3885       else do:
     3886           assign
     3887             l-query-was-opened = true
     3888           .
     3889       end.
     3890     end.
     3891     if l-filter-open-31 = false then do:
     3892       OPEN QUERY br-docs FOR EACH buf_fin-code
     3893         where  buf_fin-code.host-code = par-host-code
     3894          USE-INDEX val
     3895         indexed-reposition
     3896     .
     3897         assign
     3898           l-query-was-opened = true
     3899         .
     3900     end.
     3901   end.
     3902   else do:
     3903     assign
     3904       doc-rec = recid( buf_fin-code )
     3905     .
     3906     do
     3907     on stop undo, leave
     3908     on error undo, leave
     3909     :
     3910       if query br-docs:handle:get-buffer-handle(1) = (buffer buf_fin-code:handle) then do:
     3911         assign
     3912         parameter-2-31 = (if p-find-next then "true":u else "false":u )
     3913         parameter-4-31 =
     3914           "where ":u +  substitute (' buf_fin-code.host-code = &1 ', par-host-code)  + " ":u + where-phrase-31 + " ":u + p-find-condition + " " + ""
     3915         parameter-5-31 = " USE-INDEX val "
     3916       .
     3917         run fltopend_fltfindd in this-procedure  (
     3918                             input this-procedure:handle
     3919                             ,input query br-docs:handle
     3920                             ,input rowid(buf_fin-code)
     3921                             ,input logical(parameter-2-31)
     3922                             ,input no-lock
     3923                             ,input (buffer buf_fin-code:handle)
     3924                             ,input parameter-4-31
     3925                             ,input parameter-5-31
     3926                             ) no-error.
     3927         .
     3928         assign
     3929           doc-rec = integer(return-value)
     3930           v-fltopend-rowid[1] = ?
     3931         .
     3932       end.
     3933       else do:
     3934         assign
     3935         parameter-2-31 = (if p-find-next then "true":u else "false":u )
     3936         parameter-3-31 =  "FOR EACH buf_fin-code"
     3937         parameter-4-31 =
     3938           (
     3939             if (" buf_fin-code.host-code = par-host-code " + " " + where-phrase-31) <> ""
     3940             then  substitute (' buf_fin-code.host-code = &1 ', par-host-code)  + " " + where-phrase-31
     3941             else "true"
     3942           )
     3943         parameter-5-31 = (" " + "" + " " + "" + " " + p-find-condition)
     3944         parameter-6-31 = if sort-phrase-31 = ''
     3945                              then
     3946           (
     3947           " " + " USE-INDEX val " +
     3948             " " + sort-column-phrase +
     3949           " " + "  "
     3950           )
     3951                              else
     3952           (
     3953           " " + " USE-INDEX val " +
     3954             " " + sort-column-phrase +
     3955           " " + sort-phrase-31
     3956           )
     3957         parameter-7-31 =
     3958           " indexed-reposition  "
     3959       .
     3960         run fltopend_fltfindq in this-procedure  (
     3961                             input this-procedure:handle
     3962                             ,input query br-docs:handle
     3963                             ,input logical(parameter-2-31)
     3964                             ,input no-lock
     3965                             ,input parameter-3-31
     3966                             ,input parameter-4-31
     3967                             ,input parameter-5-31
     3968                             ,input parameter-6-31
     3969                             ,input parameter-7-31
     3970                             ,output v-fltopend-rowid
     3971                             ) no-error.
     3972         .
     3973         doc-rec = ?.
     3974       end.
     3975       assign
     3976         l-query-was-opened = true
     3977       .
     3978     end.
     3979   end.
     3980     run waitfram-hide in this-procedure .
     3981            END.
     3982        END CASE.
     3983    END.
     3984   if not p-open-query and doc-rec <> ? then
     3985   REPOSITION br-docs to recid doc-rec No-ERROR.
     3986   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3987   query br-docs:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3988   apply "entry" to br-docs in frame Dialog-Frame.
     3989   END PROCEDURE.
     3990   PROCEDURE print-proc :
     3991   define variable vss-include-info32 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3992   do:
     3993     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3994       (input  v-cntxt-db-num
     3995       ,input  v-cntxt-userid
     3996       ,input  0
     3997       ,input  'actn_fin-reference_print':U
     3998       ,input  'firm':U
     3999       ,input  par-host-code
     4000       ,input  '':U
     4001       ,input  0
     4002       ,input  0
     4003       ,input  0
     4004       ,input  0
     4005       ,input  true
     4006       ,output g#log
     4007       )  .
     4008   end.
     4009   if not g#log then  return .
     4010   define variable sym1   as char format "X(1)" init ":".
     4011   define variable sym2 as char format "X(1)" init ":".
     4012   define variable sym3 as char format "X(1)" init ":".
     4013   define variable date_string     as      char    no-undo.
     4014   define variable Line                as      char    no-undo.
     4015   define variable for-time as char.
     4016   DEFINE FRAME Chk-List
     4017           sym1                      column-label "_"                   format "X(1)" space(0)
     4018           buf_fin-code.code-value   column-label "Код_"                format "X(12)"
     4019           sym2                      column-label " "                   format "X(1)"
     4020           buf_fin-code.descr        column-label "Описание_"           format "X(80)"
     4021           sym3                      column-label " "                   format "X(1)"
     4022           HEADER  date_string AT 5 format "X(35)"
     4023                       string( "Страница " ) format "X(9)" AT 50 PAGE-NUMBER(PrnLibStream) AT 70 FORMAT ">>>>9" SKIP
     4024                       Line format "X(98)" AT 1
     4025       with width 232 down stream-io use-text    .
     4026       Line = fill("-", 98).
     4027       date_string = cur-time-print() .
     4028   run prn-lib-open-stream  in this-procedure (
     4029                                                input parParentProc
     4030                                               ,input 43
     4031                                               ,input yes
     4032                                               ,input no
     4033                                               ).
     4034       PUT  STREAM PrnLibStream
     4035       SPACE(25) ( frame Dialog-Frame:title )
     4036       format "x(90)" SKIP(1) .
     4037       FORM HEADER
     4038               Line format "X(177)" AT 1 SKIP
     4039               "Продолжение - на следующей странице" AT 30 SKIP
     4040               with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4041       VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4042       FORM with FRAME Chk-List  .
     4043       run waitfram-show in this-procedure ("Ждите...").
     4044       run OpenBr in this-procedure (yes, no, '':U).
     4045        DO WHILE available buf_fin-code :
     4046                Display STREAM PrnLibStream
     4047               sym1
     4048               sym2
     4049                           sym3
     4050               buf_fin-code.code-value buf_fin-code.descr
     4051               with FRAME Chk-List .
     4052               DOWN STREAM PrnLibStream 1 with FRAME CHk-List  .
     4053               GET next br-docs.
     4054         END.
     4055         UNDERLINE  STREAM PrnLibStream
     4056               sym1 sym2 sym3
     4057               buf_fin-code.code-value buf_fin-code.descr
     4058               with FRAME Chk-List .
     4059       HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4060       HIDE  STREAM PrnLibStream FRAME CheckList.
     4061       output  STREAM PrnLibStream CLOSE.
     4062       run waitfram-hide in this-procedure.
     4063       run prn-lib-prn-file in this-procedure (
     4064                                             input parParentProc
     4065                                             ,input 0
     4066                                             ).
     4067   END PROCEDURE.
     4068   PROCEDURE proc-b-sch :
     4069   assign
     4070     tbl = 'ub.fin-code-cel-nazn'
     4071     join-tbl = 'buf_fin-code'
     4072     fld = ""
     4073     lab = ""
     4074     spr = ""
     4075     dim = '0'
     4076     .
     4077   run fltfield-add in this-procedure('code-value', 'Код', '',
     4078   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4079   run fltfield-add in this-procedure('descr', 'Описание', '',
     4080   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4081   run fltfield-add in this-procedure('fin-code', 'Внутр.№', '',
     4082   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4083   run fltfield-add in this-procedure('host-code', 'Код фирмы', '',
     4084   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4085   run fltfield-add in this-procedure('level-1', 'Уровень_1', '',
     4086   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4087   run fltfield-add in this-procedure('level-2', 'Уровень_2', '',
     4088   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4089   run fltfield-add in this-procedure('level-3', 'Уровень_3', '',
     4090   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4091   Filter-Block:
     4092   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4093       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4094       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4095     run gbl/filter.w ( INPUT parparentproc, INPUT filter-point, INPUT tbl, INPUT join-tbl, INPUT fld, INPUT lab, INPUT spr, INPUT dim ).
     4096     run OpenBr in this-procedure (yes, no, '':U).
     4097   END.
     4098   END PROCEDURE.
     4099   PROCEDURE proc-copy :
     4100   define variable p-fin-code as integer no-undo .
     4101   define variable p-out-host-code like ub.sysconf.host-code no-undo.
     4102   define variable firm-rid-list as char no-undo.
     4103   define variable p-ok as logical no-undo .
     4104   define buffer buf2_fin-code for ub.fin-code-cel-nazn .
     4105   define variable i as integer no-undo .
     4106   define variable J as integer no-undo .
     4107   define variable k as integer no-undo .
     4108   define variable p-ret as logical no-undo .
     4109   define variable vss-include-info33 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4110   do:
     4111     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4112       (input  v-cntxt-db-num
     4113       ,input  v-cntxt-userid
     4114       ,input  0
     4115       ,input  'actn_fin-reference_export':U
     4116       ,input  'firm':U
     4117       ,input  par-host-code
     4118       ,input  '':U
     4119       ,input  0
     4120       ,input  0
     4121       ,input  0
     4122       ,input  0
     4123       ,input  true
     4124       ,output g#log
     4125       )  .
     4126   end.
     4127   if not g#log then  return .
     4128   if not g#log then  return .
     4129   if num-entries(rid-list) = 0 then do:
     4130      message "Не отмечены записи для копирования !!!" .
     4131      return .
     4132   end.
     4133   define variable v-out-host-code  as integer no-undo .
     4134   define variable v-lock-self-host as integer no-undo .
     4135   define variable v-curr-host-code as integer no-undo .
     4136   v-lock-self-host = par-host-code.
     4137   v-lock-self-host = par-host-code.
     4138   run adm/sconfs.w
     4139   (
     4140    input parParentProc,
     4141    input "b-sel,b-mark" ,
     4142    input no,
     4143    input par-host-code,
     4144    output v-out-host-code,
     4145    input-output firm-rid-list )
     4146    .
     4147    if num-entries(firm-rid-list) = 0 then do:
     4148      message "Не выбрана фирма для копирования !!!" .
     4149      return .
     4150      end.
     4151     message
     4152       "Вы отметили " num-entries(firm-rid-list) " фирмы. " skip
     4153       "Скопировать выбранные значения справочника в эти фирмы ?"
     4154       view-as alert-box question
     4155       buttons yes-no
     4156       update p-ok.
     4157   k = 0.
     4158     if p-ok = false then return.
     4159     define buffer buf_sysconf for ub.sysconf.
     4160   define variable v-nn as integer   no-undo .
     4161   define variable v-nnn as integer   no-undo .
     4162   v-nn  = num-entries(firm-rid-list) .
     4163   v-nnn = num-entries(rid-list) .
     4164     repeat i = 1 to v-nn :
     4165        for each buf_sysconf no-lock  where recid(buf_sysconf) = integer(entry(i,firm-rid-list)) :
     4166           repeat j = 1 to v-nnn :
     4167             for each buf2_fin-code where recid(buf2_fin-code) =  integer(entry(j,rid-list)):
     4168             if not can-find ( first buf_fin-code no-lock where
     4169                                 buf_fin-code.host-code      = buf_sysconf.host-code and
     4170                                 buf_fin-code.code-value     = buf2_fin-code.code-value) then do:
     4171                     run current-db in this-procedure (
     4172                         input buf_fin-code.host-code,
     4173                         input par-host-code,
     4174                         output p-ret ) .
     4175                     if p-ret = no then next.
     4176                     run fin-code in this-procedure (input buf_sysconf.host-code , output p-fin-code) .
     4177                     run create-ref-fin-code in this-procedure (
     4178                         input yes ,
     4179                         input buf_sysconf.host-code,
     4180                         input p-fin-code   ,
     4181                         input buf2_fin-code.code-value ,
     4182                         input buf2_fin-code.descr,
     4183                         input buf2_fin-code.status_,
     4184                         input buf2_fin-code.level-1,
     4185                         input buf2_fin-code.level-2,
     4186                         input buf2_fin-code.level-3
     4187                         ).
     4188                         k = k + 1.
     4189                     end.
     4190             end.
     4191           end.
     4192        end.
     4193     end.
     4194   message "Скопировано " k  "записей" view-as alert-box .
     4195   END PROCEDURE.
     4196   PROCEDURE proc-find-code :
     4197   define input parameter par-next as logical no-undo.
     4198   define input parameter pardoc-code as char no-undo.
     4199   display "" @ p-desc with frame Dialog-Frame.
     4200   assign
     4201     pardoc-code = chr(34) + pardoc-code + chr(34) .
     4202   run OpenBr in this-procedure
     4203       (input false
     4204       ,input par-next
     4205       ,input substitute("and buf_fin-code.code-value   begins &1 "
     4206         , pardoc-code)
     4207       ).
     4208   END PROCEDURE.
     4209   PROCEDURE proc-find-desc :
     4210   define input parameter par-next as logical no-undo.
     4211   define input parameter pardoc-code as char no-undo.
     4212   display "" @ sch-code with frame Dialog-Frame.
     4213   assign
     4214     pardoc-code = chr(34) + pardoc-code + chr(34) .
     4215   run OpenBr in this-procedure
     4216       (input false
     4217       ,input par-next
     4218       ,input substitute("and buf_fin-code.descr   begins &1 "
     4219         , pardoc-code)
     4220       ).
     4221   apply "entry":u to p-desc in frame Dialog-Frame .
     4222   END PROCEDURE.
     4223   PROCEDURE set-filter-name :
     4224   define input parameter p-filter-name as character no-undo .
     4225     do with frame Dialog-Frame:
     4226       if p-filter-name > "" then do:
     4227         assign
     4228           frame Dialog-Frame:title
     4229             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     4230         .
     4231         assign
     4232           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
     4233         .
     4234       end.
     4235       else do:
     4236         assign
     4237           b-sch :TOOLTIP = ""
     4238         .
     4239       end.
     4240     end.
     4241   END PROCEDURE.
     4242   FUNCTION sel-type RETURNS CHARACTER
     4243     (input  p-rec as recid   ) :
     4244     define buffer loc-fin-code for ub.fin-code-cel-nazn  .
     4245     RETURN ''.
     4246   END FUNCTION.
