       90   define variable v-fin-slt-pc like ub.sysconf.fin-slt-pc no-undo.
       91   define variable v-rest-sum-doc like ub.fin-doc-tax.sum-line-doc no-undo.
       92   define variable v-sum-tax like ub.fin-doc-tax.sum-line-doc no-undo.
       93   define variable last-line like ub.fin-doc-tax.line-num no-undo.
       94   define variable v-change-tab-order as character no-undo .
       95   define variable v-updated-line-num like ub.fin-doc-tax.line-num no-undo .
       96   define variable v-obj-db-num as integer no-undo init -1.
