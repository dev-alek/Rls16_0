      983   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      984   procedure minbtn-set :
      985       do
      986           on error undo, return error return-value
      987           :
      988           define variable ii              as integer       no-undo .
      989           define variable fh              as widget-handle no-undo .
      990           define variable hh              as widget-handle no-undo .
      991           define variable v-h             as handle        extent 4 no-undo .
      992           define variable v-name-button   as character     no-undo .
      993           define variable v-help-old-x    as decimal       no-undo .
      994           define variable v-help-old-y    as decimal       no-undo .
      995           define variable v-help-old-size as decimal       no-undo .
      996           define variable v-frame-width   as decimal       no-undo .
      997           define variable jj              as integer       no-undo .
      998           do
      999               on error undo, return error
     1000               :
     1001               assign
     1002                   v-frame-width = frame Dialog-Frame:width - 0.3
     1003                   fh            = frame Dialog-Frame:first-child
     1004                   hh            = fh:first-child
     1005                   ii            = 1
     1006                   .
     1007               do while valid-handle(hh):
     1008                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1009                   do:
     1010                       case lc(hh:name) :
     1011                           when "b-help" then
     1012                               do:
     1013                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1014                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1015                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1016                                   hh:TOOLTIP = "Помощь" .
     1017                                   v-help-old-x = hh:column .
     1018                                   v-help-old-y = hh:row    .
     1019                                   v-help-old-size = hh:width .
     1020                                   hh:width-chars = 2.5 .
     1021                               end.
     1022                           when "b-print" then
     1023                               do:
     1024                                   hh:load-image("cmp/b-print.bmp":u) .
     1025                                   hh:TOOLTIP = "Печать" .
     1026                                   v-h[ii] = hh:handle .
     1027                                   ii = ii + 1 .
     1028                                   hh:width-chars = 3 .
     1029                               end.
     1030                           when "b-history" or
     1031                           when "b-hist" then
     1032                               do:
     1033                                   hh:load-image("cmp/b-hist.bmp":u) .
     1034                                   hh:TOOLTIP = "История" .
     1035                                   v-h[ii] = hh:handle .
     1036                                   ii = ii + 1 .
     1037                                   hh:width-chars = 3 .
     1038                               end.
     1039                           when "b-sch" then
     1040                               do:
     1041                                   hh:load-image("cmp/b-sch.bmp":u) .
     1042                                   hh:TOOLTIP = "Установка Фильтра" .
     1043                                   v-h[ii] = hh:handle .
     1044                                   ii = ii + 1 .
     1045                                   hh:width-chars = 3 .
     1046                               end.
     1047                           when "b-hist-user" then
     1048                               do:
     1049                                   hh:load-image("cmp/b-hist.bmp":u) .
     1050                                   hh:TOOLTIP = "История пользователя" .
     1051                                   ii = ii + 1 .
     1052                               end.
     1053                       end case.
     1054                   end.
     1055                   hh = hh:next-sibling.
     1056               end.
     1057               b-help:column = v-frame-width - b-help:width-chars.
     1058               jj = 0.
     1059               repeat ii = 4 to 1 by -1 :
     1060                   if valid-handle (v-h[ii] ) then
     1061                   do:
     1062                       jj  = jj + 1 .
     1063                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1064                       v-h[ii]:row    = v-help-old-y .
     1065                   end.
     1066               end.
     1067           end.
     1068       end.
     1069   end procedure.
     1070   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1071   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1072   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1073   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1074   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1075   define variable v-diasize-current-frame-height as decimal   no-undo .
     1076   define variable v-diasize-change-size          as logical   no-undo .
     1077   define variable v-diasize-resize-button        as handle    no-undo .
     1078   define variable v-diasize-wndmax               as logical   no-undo .
     1079   define variable v-diasize-wndstore             as logical   no-undo .
     1080   define variable v-diasize-proc-name            as character no-undo .
     1081   define variable v-diasize-browse-handle        as handle    no-undo .
     1082   define variable v-diasize-browse-number        as integer   no-undo .
     1083   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1084   define temp-table temp-diasize-handle no-undo
     1085     field handle-value  as handle
     1086     field save-position as decimal
     1087     index xpk is primary unique handle-value
     1088     .
     1089   define temp-table temp-browse-handle no-undo
     1090     field browse-type   as character
     1091     field browse-number as integer
     1092     field browse-handle as handle
     1093     field original-size as decimal
     1094     index xpk is primary unique browse-type browse-number
     1095     index xie browse-type browse-handle
     1096   .
     1097   procedure diasize_change-height :
     1098     define input  parameter p-change-value  as decimal   no-undo .
     1099     define input  parameter p-move-resize   as logical   no-undo .
     1100     define variable v-field-group-handle    as handle    no-undo .
     1101     define variable v-object-handle         as handle    no-undo .
     1102     define variable v-frame-height          as decimal   no-undo .
     1103     define variable v-frame-virtual-height  as decimal   no-undo .
     1104     define variable v-browse-height         as decimal   no-undo .
     1105     define variable v-window-height         as decimal   no-undo .
     1106     define variable v-window-virtual-height as decimal   no-undo .
     1107     define variable v-change-sign           as integer   no-undo .
     1108     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1109     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1110     if p-change-value > 0
     1111     then do:
     1112       if frame Dialog-Frame :height + p-change-value
     1113           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1114       then do:
     1115         assign
     1116           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1117                           - (frame Dialog-Frame :height-chars)
     1118         .
     1119         if p-change-value <= 0
     1120         then do:
     1121           run diasize_position-resize-button in this-procedure .
     1122           return .
     1123         end.
     1124       end.
     1125     end.
     1126     if p-change-value < 0
     1127     then do:
     1128       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1129       then do:
     1130         assign
     1131           p-change-value = v-diasize-orig-frame-height
     1132                          - (frame Dialog-Frame :height-chars)
     1133         .
     1134         if p-change-value >= 0
     1135         then do:
     1136           run diasize_position-resize-button in this-procedure .
     1137           return .
     1138         end.
     1139       end.
     1140     end.
     1141     if p-change-value >= 0
     1142     then do:
     1143       assign
     1144         v-change-sign = 1
     1145       .
     1146     end.
     1147     else do:
     1148       assign
     1149         v-change-sign = -1
     1150       .
     1151     end.
     1152     assign
     1153       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1154     .
     1155     if p-change-value = 0
     1156     then do:
     1157       run diasize_position-resize-button in this-procedure .
     1158       return .
     1159     end.
     1160     move_block:
     1161     do
     1162     on error undo move_block, retry move_block
     1163     :
     1164       if retry
     1165       then do:
     1166         do
     1167         on error undo move_block, leave move_block
     1168         :
     1169           if p-change-value > 0
     1170           then do:
     1171             for each buf_temp-diasize-handle
     1172             on error undo, next
     1173             :
     1174               assign
     1175                 v-object-handle = buf_temp-diasize-handle.handle-value
     1176               .
     1177               if v-object-handle <> v-diasize-resize-button
     1178               then do:
     1179                 assign
     1180                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1181                 .
     1182               end.
     1183             end.
     1184             assign
     1185               v-diasize-browse-handle :height = v-browse-height
     1186             .
     1187             for each buf_temp-browse-handle
     1188               where buf_temp-browse-handle.browse-type = 'height':u
     1189             on error undo, next
     1190             :
     1191               assign
     1192                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1193               .
     1194             end.
     1195             assign
     1196               frame Dialog-Frame :height = v-frame-height
     1197             .
     1198             if frame Dialog-Frame :scrollable = true
     1199             then do:
     1200               assign
     1201                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1202               .
     1203             end.
     1204             run diasize_position-resize-button in this-procedure .
     1205           end.
     1206           else do:
     1207             if frame Dialog-Frame :scrollable = true
     1208             then do:
     1209               assign
     1210                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1211               .
     1212             end.
     1213             assign
     1214               frame Dialog-Frame :height = v-frame-height
     1215             .
     1216             assign
     1217               v-diasize-browse-handle :height = v-browse-height
     1218             .
     1219             for each buf_temp-browse-handle
     1220               where buf_temp-browse-handle.browse-type = 'height':u
     1221             on error undo, next
     1222             :
     1223               assign
     1224                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1225               .
     1226             end.
     1227             for each buf_temp-diasize-handle
     1228             on error undo, next
     1229             :
     1230               assign
     1231                 v-object-handle = buf_temp-diasize-handle.handle-value
     1232               .
     1233               if v-object-handle <> v-diasize-resize-button
     1234               then do:
     1235                 assign
     1236                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1237                 .
     1238               end.
     1239             end.
     1240             run diasize_position-resize-button in this-procedure .
     1241           end.
     1242           assign
     1243             v-diasize-change-size = false
     1244           .
     1245           leave move_block .
     1246         end.
     1247       end.
     1248       assign
     1249         v-diasize-need-full-display = true
     1250       .
     1251       if v-diasize-change-size = false
     1252       then do:
     1253         assign
     1254           v-diasize-change-size = true
     1255         .
     1256       end.
     1257       else do:
     1258         return .
     1259       end.
     1260       assign
     1261         v-frame-height = frame Dialog-Frame :height
     1262         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1263         v-browse-height = v-diasize-browse-handle :height
     1264       .
     1265       for each buf_temp-browse-handle
     1266         where buf_temp-browse-handle.browse-type = 'height':u
     1267       :
     1268         assign
     1269           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1270         .
     1271       end.
     1272       for each buf_temp-diasize-handle
     1273       :
     1274         delete buf_temp-diasize-handle .
     1275       end.
     1276       assign
     1277         v-field-group-handle = frame Dialog-Frame :first-child
     1278       .
     1279       do while valid-handle(v-field-group-handle)
     1280       :
     1281         assign
     1282           v-object-handle = v-field-group-handle :first-child
     1283         .
     1284         do while valid-handle(v-object-handle)
     1285         :
     1286           if  v-object-handle <> v-diasize-browse-handle :handle
     1287           and can-query(v-object-handle, "row")
     1288           and can-query(v-object-handle, "height")
     1289           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1290           then do:
     1291             find first buf_temp-browse-handle
     1292               where buf_temp-browse-handle.browse-type   = 'height':u
     1293                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1294               no-error .
     1295             if available buf_temp-browse-handle
     1296             then do:
     1297             end.
     1298             else do:
     1299               create buf_temp-diasize-handle .
     1300               assign
     1301                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1302                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1303               .
     1304             end.
     1305           end.
     1306           assign
     1307             v-object-handle = v-object-handle :next-sibling
     1308           .
     1309         end.
     1310         assign
     1311           v-field-group-handle = v-field-group-handle :next-sibling
     1312         .
     1313       end.
     1314       do with frame Dialog-Frame
     1315       :
     1316         hide v-diasize-resize-button .
     1317         assign
     1318           v-diasize-resize-button :row    = 1
     1319           v-diasize-resize-button :column = 1
     1320         .
     1321       end.
     1322       if p-change-value > 0
     1323       then do:
     1324         if frame Dialog-Frame :scrollable = true
     1325         then do:
     1326           assign
     1327             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1328             no-error .
     1329           if error-status :error
     1330           or error-status :get-message(1) <> ""
     1331           then do:
     1332             undo move_block, retry move_block .
     1333           end.
     1334         end.
     1335         assign
     1336           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1337           no-error .
     1338         if error-status :error
     1339         or error-status :get-message(1) <> ""
     1340         then do:
     1341           undo move_block, retry move_block .
     1342         end.
     1343         assign
     1344           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1345           no-error .
     1346         if error-status :error
     1347         or error-status :get-message(1) <> ""
     1348         then do:
     1349           undo move_block, retry move_block .
     1350         end.
     1351         for each buf_temp-browse-handle
     1352           where buf_temp-browse-handle.browse-type = 'height':u
     1353         on error undo move_block, retry move_block
     1354         :
     1355           assign
     1356             buf_temp-browse-handle.browse-handle :height
     1357               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1358             no-error .
     1359           if error-status :error
     1360           or error-status :get-message(1) <> ""
     1361           then do:
     1362             undo move_block, retry move_block .
     1363           end.
     1364         end.
     1365         for each buf_temp-diasize-handle
     1366         on error undo move_block, retry move_block
     1367         :
     1368           assign
     1369             v-object-handle = buf_temp-diasize-handle.handle-value
     1370           .
     1371           if v-object-handle <> v-diasize-resize-button
     1372           then do:
     1373             assign
     1374               v-object-handle :row = v-object-handle :row + p-change-value
     1375               no-error .
     1376             if error-status :error
     1377             or error-status :get-message(1) <> ""
     1378             then do:
     1379               undo move_block, retry move_block .
     1380             end.
     1381           end.
     1382         end.
     1383       end.
     1384       else do:
     1385         for each buf_temp-diasize-handle
     1386         on error undo move_block, retry move_block
     1387         :
     1388           assign
     1389             v-object-handle = buf_temp-diasize-handle.handle-value
     1390           .
     1391           if v-object-handle <> v-diasize-resize-button
     1392           then do:
     1393             assign
     1394               v-object-handle :row = v-object-handle :row + p-change-value
     1395               no-error .
     1396             if error-status :error
     1397             or error-status :get-message(1) <> ""
     1398             then do:
     1399               undo move_block, retry move_block .
     1400             end.
     1401           end.
     1402         end.
     1403         assign
     1404           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1405           no-error .
     1406         if error-status :error
     1407         or error-status :get-message(1) <> ""
     1408         then do:
     1409           undo move_block, retry move_block .
     1410         end.
     1411         for each buf_temp-browse-handle
     1412           where buf_temp-browse-handle.browse-type = 'height':u
     1413         on error undo move_block, retry move_block
     1414         :
     1415           assign
     1416             buf_temp-browse-handle.browse-handle :height
     1417               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1418             no-error .
     1419           if error-status :error
     1420           or error-status :get-message(1) <> ""
     1421           then do:
     1422             undo move_block, retry move_block .
     1423           end.
     1424         end.
     1425         assign
     1426           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1427           no-error .
     1428         if error-status :error
     1429         or error-status :get-message(1) <> ""
     1430         then do:
     1431           undo move_block, retry move_block .
     1432         end.
     1433         if frame Dialog-Frame :scrollable = true
     1434         then do:
     1435           assign
     1436             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1437             no-error .
     1438           if error-status :error
     1439           or error-status :get-message(1) <> ""
     1440           then do:
     1441             undo move_block, retry move_block .
     1442           end.
     1443         end.
     1444       end.
     1445       if p-move-resize = true
     1446       then do:
     1447         run diasize_position-resize-button in this-procedure .
     1448       end.
     1449       if v-diasize-wndstore = true
     1450       then do:
     1451         if connected("ub") = true
     1452         then do:
     1453           define variable v-cntxt-db-num        as integer   no-undo .
     1454           define variable v-cntxt-userid        as character no-undo .
     1455           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1456                                             , OUTPUT v-cntxt-userid
     1457                                             ) .
     1458           run gbl/wndsizew.p
     1459             (input  v-cntxt-db-num
     1460             ,input  v-cntxt-userid
     1461             ,input  v-diasize-proc-name
     1462             ,input  'height':u
     1463             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1464             ) .
     1465         end.
     1466       end.
     1467     end.
     1468     assign
     1469       v-diasize-change-size = false
     1470     .
     1471   end procedure.
     1472   procedure diasize_set-height :
     1473     define input  parameter p-new-height  as decimal   no-undo .
     1474     define input  parameter p-move-resize as logical   no-undo .
     1475     do
     1476     on error undo, return error return-value
     1477     :
     1478       run diasize_change-height in this-procedure
     1479         (input  (p-new-height - frame Dialog-Frame :height)
     1480         ,input  p-move-resize
     1481         ) .
     1482     end.
     1483   end procedure.
     1484   procedure diasize_change-width :
     1485     define input  parameter p-change-value as decimal   no-undo .
     1486     define input  parameter p-move-resize  as logical   no-undo .
     1487     define variable v-field-group-handle   as handle    no-undo .
     1488     define variable v-object-handle        as handle    no-undo .
     1489     define variable v-frame-width          as decimal   no-undo .
     1490     define variable v-frame-virtual-width  as decimal   no-undo .
     1491     define variable v-browse-width         as decimal   no-undo .
     1492     define variable v-window-width         as decimal   no-undo .
     1493     define variable v-window-virtual-width as decimal   no-undo .
     1494     define variable v-change-sign          as integer   no-undo .
     1495     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1496     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1497     if p-change-value > 0
     1498     then do:
     1499       if frame Dialog-Frame :width + p-change-value >
     1500           session :width-chars
     1501       then do:
     1502         assign
     1503           p-change-value = session :width-chars - frame Dialog-Frame :width
     1504         .
     1505         if p-change-value <= 0
     1506         then do:
     1507           run diasize_position-resize-button in this-procedure .
     1508           return .
     1509         end.
     1510       end.
     1511     end.
     1512     if p-change-value < 0
     1513     then do:
     1514       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1515       then do:
     1516         assign
     1517           p-change-value = v-diasize-orig-frame-width
     1518                          - frame Dialog-Frame :width
     1519         .
     1520         if p-change-value >= 0
     1521         then do:
     1522           run diasize_position-resize-button in this-procedure .
     1523           return .
     1524         end.
     1525       end.
     1526     end.
     1527     if p-change-value >= 0
     1528     then do:
     1529       assign
     1530         v-change-sign = 1
     1531       .
     1532     end.
     1533     else do:
     1534       assign
     1535         v-change-sign = -1
     1536       .
     1537     end.
     1538     assign
     1539       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1540     .
     1541     if p-change-value = 0
     1542     then do:
     1543       run diasize_position-resize-button in this-procedure .
     1544       return .
     1545     end.
     1546     move_block:
     1547     do
     1548     on error undo move_block, leave move_block
     1549     :
     1550       if retry
     1551       then do:
     1552         do
     1553         on error undo move_block, leave move_block
     1554         :
     1555           if p-change-value > 0
     1556           then do:
     1557             for each buf_temp-diasize-handle
     1558             on error undo, next
     1559             :
     1560               assign
     1561                 v-object-handle = buf_temp-diasize-handle.handle-value
     1562               .
     1563               if v-object-handle <> v-diasize-resize-button
     1564               then do:
     1565                 assign
     1566                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1567                 .
     1568               end.
     1569             end.
     1570             assign
     1571               v-diasize-browse-handle :width = v-browse-width
     1572             .
     1573             for each buf_temp-browse-handle
     1574               where buf_temp-browse-handle.browse-type = 'width':u
     1575             on error undo, next
     1576             :
     1577               assign
     1578                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1579               .
     1580             end.
     1581             assign
     1582               frame Dialog-Frame :width = v-frame-width
     1583             .
     1584             if frame Dialog-Frame :scrollable = true
     1585             then do:
     1586               assign
     1587                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1588               .
     1589             end.
     1590             run diasize_position-resize-button in this-procedure .
     1591           end.
     1592           else do:
     1593             if frame Dialog-Frame :scrollable = true
     1594             then do:
     1595               assign
     1596                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1597               .
     1598             end.
     1599             assign
     1600               frame Dialog-Frame :width = v-frame-width
     1601             .
     1602             for each buf_temp-browse-handle
     1603               where buf_temp-browse-handle.browse-type = 'width':u
     1604             on error undo, next
     1605             :
     1606               assign
     1607                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1608               .
     1609             end.
     1610             assign
     1611               v-diasize-browse-handle :width = v-browse-width
     1612             .
     1613             for each buf_temp-diasize-handle
     1614             on error undo, next
     1615             :
     1616               assign
     1617                 v-object-handle = buf_temp-diasize-handle.handle-value
     1618               .
     1619               if v-object-handle <> v-diasize-resize-button
     1620               then do:
     1621                 assign
     1622                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1623                 .
     1624               end.
     1625             end.
     1626             run diasize_position-resize-button in this-procedure .
     1627           end.
     1628           assign
     1629             v-diasize-change-size = false
     1630           .
     1631           leave move_block .
     1632         end.
     1633       end.
     1634       assign
     1635         v-diasize-need-full-display = true
     1636       .
     1637       if v-diasize-change-size = false
     1638       then do:
     1639         assign
     1640           v-diasize-change-size = true
     1641         .
     1642       end.
     1643       else do:
     1644         return .
     1645       end.
     1646       assign
     1647         v-frame-width = frame Dialog-Frame :width
     1648         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1649         v-browse-width = v-diasize-browse-handle :width
     1650       .
     1651       for each buf_temp-browse-handle
     1652         where buf_temp-browse-handle.browse-type = 'width':u
     1653       :
     1654         assign
     1655           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1656         .
     1657       end.
     1658       for each buf_temp-diasize-handle
     1659       :
     1660         delete buf_temp-diasize-handle .
     1661       end.
     1662       assign
     1663         v-field-group-handle = frame Dialog-Frame :first-child
     1664       .
     1665       do while valid-handle(v-field-group-handle)
     1666       :
     1667         assign
     1668           v-object-handle = v-field-group-handle :first-child
     1669         .
     1670         do while valid-handle(v-object-handle)
     1671         :
     1672           if  v-object-handle <> v-diasize-browse-handle :handle
     1673           and v-object-handle <> v-diasize-resize-button
     1674           and can-query(v-object-handle, "row")
     1675           and can-query(v-object-handle, "height")
     1676           and ( v-object-handle :col + v-object-handle :width
     1677                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1678               )
     1679           then do:
     1680             find first buf_temp-browse-handle
     1681               where buf_temp-browse-handle.browse-type   = 'width':u
     1682                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1683               no-error .
     1684             if available buf_temp-browse-handle
     1685             then do:
     1686             end.
     1687             else do:
     1688               create buf_temp-diasize-handle .
     1689               assign
     1690                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1691                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1692               .
     1693             end.
     1694           end.
     1695           assign
     1696             v-object-handle = v-object-handle :next-sibling
     1697           .
     1698         end.
     1699         assign
     1700           v-field-group-handle = v-field-group-handle :next-sibling
     1701         .
     1702       end.
     1703       do with frame Dialog-Frame
     1704       :
     1705         hide v-diasize-resize-button .
     1706         v-diasize-resize-button :row = 1.
     1707         v-diasize-resize-button :column = 1.
     1708       end.
     1709       if p-change-value > 0
     1710       then do:
     1711         if frame Dialog-Frame :scrollable = true
     1712         then do:
     1713           assign
     1714             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1715             no-error .
     1716           if error-status :error
     1717           or error-status :get-message(1) <> ""
     1718           then do:
     1719             undo move_block, retry move_block.
     1720           end.
     1721         end.
     1722         assign
     1723           frame Dialog-Frame :width = v-frame-width + p-change-value
     1724           no-error .
     1725         if error-status :error
     1726         or error-status :get-message(1) <> ""
     1727         then do:
     1728           undo move_block, retry move_block.
     1729         end.
     1730         assign
     1731           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1732         no-error .
     1733         if error-status :error
     1734         or error-status :get-message(1) <> ""
     1735         then do:
     1736           undo move_block, retry move_block.
     1737         end.
     1738         for each buf_temp-browse-handle
     1739           where buf_temp-browse-handle.browse-type = 'width':u
     1740         on error undo move_block, retry move_block
     1741         :
     1742           assign
     1743             buf_temp-browse-handle.browse-handle :width
     1744               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1745             no-error .
     1746           if error-status :error
     1747           or error-status :get-message(1) <> ""
     1748           then do:
     1749             undo move_block, retry move_block .
     1750           end.
     1751         end.
     1752         for each buf_temp-diasize-handle
     1753         on error undo move_block, retry move_block
     1754         :
     1755           assign
     1756             v-object-handle = buf_temp-diasize-handle.handle-value
     1757           .
     1758           if v-object-handle <> v-diasize-resize-button
     1759           then do:
     1760             assign
     1761               v-object-handle :col = v-object-handle :col + p-change-value
     1762               no-error .
     1763             if error-status :error
     1764             or error-status :get-message(1) <> ""
     1765             then do:
     1766               undo move_block, retry move_block .
     1767             end.
     1768           end.
     1769         end.
     1770       end.
     1771       else do:
     1772         for each buf_temp-diasize-handle
     1773         on error undo move_block, retry move_block
     1774         :
     1775           assign
     1776             v-object-handle = buf_temp-diasize-handle.handle-value
     1777           .
     1778           if v-object-handle <> v-diasize-resize-button
     1779           then do:
     1780             assign
     1781               v-object-handle :col = v-object-handle :col + p-change-value
     1782               no-error .
     1783             if error-status :error
     1784             or error-status :get-message(1) <> ""
     1785             then do:
     1786               undo move_block, retry move_block .
     1787             end.
     1788           end.
     1789         end.
     1790         for each buf_temp-browse-handle
     1791           where buf_temp-browse-handle.browse-type = 'width':u
     1792         on error undo move_block, retry move_block
     1793         :
     1794           assign
     1795             buf_temp-browse-handle.browse-handle :width
     1796               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1797             no-error .
     1798           if error-status :error
     1799           or error-status :get-message(1) <> ""
     1800           then do:
     1801             undo move_block, retry move_block .
     1802           end.
     1803         end.
     1804         assign
     1805           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1806           no-error .
     1807         if error-status :error
     1808         or error-status :get-message(1) <> ""
     1809         then do:
     1810           undo move_block, retry move_block.
     1811         end.
     1812         assign
     1813           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1814         no-error .
     1815         if error-status :error
     1816         or error-status :get-message(1) <> ""
     1817         then do:
     1818           undo move_block, retry move_block.
     1819         end.
     1820         if frame Dialog-Frame :scrollable = true
     1821         then do:
     1822           assign
     1823             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1824           no-error .
     1825           if error-status :error
     1826           or error-status :get-message(1) <> ""
     1827           then do:
     1828             undo move_block, retry move_block.
     1829           end.
     1830         end.
     1831       end.
     1832       if p-move-resize
     1833       then do:
     1834         run diasize_position-resize-button in this-procedure .
     1835       end.
     1836       if v-diasize-wndstore = true
     1837       then do:
     1838         if connected("ub") = true
     1839         then do:
     1840           define variable v-cntxt-db-num        as integer   no-undo .
     1841           define variable v-cntxt-userid        as character no-undo .
     1842           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1843                                             , OUTPUT v-cntxt-userid
     1844                                             ) .
     1845           run gbl/wndsizew.p
     1846             (input  v-cntxt-db-num
     1847             ,input  v-cntxt-userid
     1848             ,input  v-diasize-proc-name
     1849             ,input  'width':u
     1850             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1851             ) .
     1852         end.
     1853       end.
     1854     end.
     1855     assign
     1856       v-diasize-change-size = false
     1857     .
     1858   end procedure.
     1859   procedure diasize_set-width :
     1860     define input  parameter p-new-width  as decimal   no-undo .
     1861     define input  parameter p-move-resize as logical   no-undo .
     1862     do
     1863     on error undo, return error return-value
     1864     :
     1865       run diasize_change-width in this-procedure
     1866         (input  (p-new-width - frame Dialog-Frame :width)
     1867         ,input  p-move-resize
     1868         ) .
     1869     end.
     1870   end procedure.
     1871   procedure diasize_position-resize-button :
     1872     do with frame Dialog-Frame
     1873     :
     1874       hide v-diasize-resize-button .
     1875       assign
     1876         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1877                     - 1
     1878                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1879         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1880                     - 1
     1881                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1882       .
     1883       view v-diasize-resize-button .
     1884     end.
     1885   end procedure.
     1886   on alt-right anywhere
     1887   do:
     1888     run diasize_change-width in this-procedure
     1889       (input 1
     1890       ,input true
     1891       ) .
     1892     return no-apply .
     1893   end.
     1894   on alt-left anywhere
     1895   do:
     1896     run diasize_change-width in this-procedure
     1897       (input -1
     1898       ,input true
     1899       ) .
     1900     return no-apply .
     1901   end.
     1902   on alt-down anywhere
     1903   do:
     1904     run diasize_change-height in this-procedure
     1905       (input 1
     1906       ,input true
     1907       ) .
     1908     return no-apply .
     1909   end.
     1910   on alt-up anywhere
     1911   do:
     1912     run diasize_change-height in this-procedure
     1913       (input -1
     1914       ,input true
     1915       ) .
     1916     return no-apply .
     1917   end.
     1918   on alt-enter of frame Dialog-Frame
     1919   do:
     1920     run diasize_maximize in this-procedure
     1921       (input  ?
     1922       ).
     1923     return no-apply .
     1924   end.
     1925   procedure diasize_end-move :
     1926     do
     1927     on error undo, return error return-value
     1928     :
     1929       define variable v-row-delta as decimal   no-undo .
     1930       define variable v-col-delta as decimal   no-undo .
     1931       define variable v-new-row as decimal   no-undo .
     1932       define variable v-new-col as decimal   no-undo .
     1933       assign
     1934         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1935         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1936       .
     1937       assign
     1938         v-row-delta = v-new-row - frame Dialog-Frame :height
     1939         v-col-delta = v-new-col - frame Dialog-Frame :width
     1940       .
     1941       run diasize_change-height in this-procedure
     1942         (input v-row-delta
     1943         ,input true
     1944         ) .
     1945       run diasize_change-width in this-procedure
     1946         (input v-col-delta
     1947         ,input true
     1948         ) .
     1949     end.
     1950   end procedure.
     1951   procedure diasize_maximize :
     1952     define input  parameter p-action as logical   no-undo .
     1953     do
     1954     on error undo, return error return-value
     1955     :
     1956       if p-action = ?
     1957       then do:
     1958         if v-diasize-need-maximize = true
     1959         then do:
     1960           assign
     1961             p-action = true
     1962           .
     1963         end.
     1964         else do:
     1965           assign
     1966             p-action = false
     1967           .
     1968         end.
     1969       end.
     1970       if p-action = true
     1971       then do:
     1972         run diasize_change-height in this-procedure
     1973           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1974               - frame Dialog-Frame :height-chars
     1975           ,input true
     1976           ) .
     1977         run diasize_change-width in this-procedure
     1978           (input session :width-chars
     1979               - frame Dialog-Frame :width-chars
     1980           ,input true
     1981           ) .
     1982         assign
     1983           v-diasize-need-maximize = false
     1984         .
     1985       end.
     1986       else do:
     1987         run diasize_change-width in this-procedure
     1988           (input v-diasize-orig-frame-width
     1989               - frame Dialog-Frame :width-chars
     1990           ,input true
     1991           ) .
     1992         run diasize_change-height in this-procedure
     1993           (input v-diasize-orig-frame-height
     1994               - frame Dialog-Frame :height-chars
     1995           ,input true
     1996           ) .
     1997         assign
     1998           v-diasize-need-maximize = true
     1999         .
     2000       end.
     2001     end.
     2002   end procedure.
     2003   procedure diasize_restore-orig-size :
     2004     do
     2005     on error undo, return error return-value
     2006     :
     2007       assign
     2008         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2009         v-diasize-current-frame-height = frame Dialog-Frame :height
     2010       .
     2011       run diasize_set-height in this-procedure
     2012         (input  v-diasize-orig-frame-height
     2013         ,input  true
     2014         ) .
     2015       run diasize_set-width in this-procedure
     2016         (input  v-diasize-orig-frame-width
     2017         ,input  true
     2018         ) .
     2019     end.
     2020   end procedure.
     2021   procedure diasize_restore-current-size :
     2022     do
     2023     on error undo, return error return-value
     2024     :
     2025       run diasize_set-height in this-procedure
     2026         (input  v-diasize-current-frame-height
     2027         ,input  true
     2028         ) .
     2029       run diasize_set-width in this-procedure
     2030         (input  v-diasize-current-frame-width
     2031         ,input  true
     2032         ) .
     2033     end.
     2034   end procedure.
     2035   procedure diasize_set-browse-handle :
     2036     define input  parameter p-browse-handle as handle   no-undo .
     2037     define buffer buf_temp-browse-handle for temp-browse-handle .
     2038     do
     2039     on error undo, return error return-value
     2040     :
     2041       assign
     2042         v-diasize-browse-handle = p-browse-handle
     2043       .
     2044       for each buf_temp-browse-handle
     2045       on error undo, return error return-value
     2046       :
     2047         delete buf_temp-browse-handle .
     2048       end.
     2049     end.
     2050   end procedure.
     2051   procedure diasize_add_browse :
     2052     define input  parameter p-browse-type   as character no-undo .
     2053     define input  parameter p-browse-handle as handle    no-undo .
     2054     define buffer buf_temp-browse-handle for temp-browse-handle .
     2055     do
     2056     on error undo, return error return-value
     2057     :
     2058       assign
     2059         v-diasize-browse-number = v-diasize-browse-number + 1
     2060       .
     2061       create buf_temp-browse-handle .
     2062       assign
     2063         buf_temp-browse-handle.browse-type   = p-browse-type
     2064         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2065         buf_temp-browse-handle.browse-handle = p-browse-handle
     2066       .
     2067     end.
     2068   end procedure.
     2069   procedure diasize_init :
     2070     define variable v-default-value    as logical   no-undo .
     2071     define variable v-restore-saved    as logical   no-undo .
     2072     define variable v-resize-value-str as character no-undo .
     2073     do
     2074     on error undo, return error return-value
     2075     :
     2076       do with frame Dialog-Frame
     2077       :
     2078         assign
     2079           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2080           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2081           v-diasize-browse-handle     = browse BR-fin-doc-tax :handle
     2082         .
     2083         create button v-diasize-resize-button
     2084         assign
     2085           parent        = frame Dialog-Frame :first-child
     2086           label         = "s"
     2087           height-pixels = 16
     2088           width-pixels  = 16
     2089           visible       = true
     2090           sensitive     = true
     2091           movable       = true
     2092           triggers:
     2093             on end-move persistent run diasize_end-move in this-procedure .
     2094           end triggers.
     2095         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2096         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2097         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2098         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2099         assign
     2100           v-diasize-wndmax = false
     2101         .
     2102         if connected("ub") = true
     2103         then do:
     2104           define variable v-cntxt-db-num        as integer   no-undo .
     2105           define variable v-cntxt-userid        as character no-undo .
     2106           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2107                                             , OUTPUT v-cntxt-userid
     2108                                             ) .
     2109           run gbl/wndpar_r.p
     2110             (input  v-cntxt-db-num
     2111             ,input  v-cntxt-userid
     2112             ,input  'wndmax':U
     2113             ,output v-diasize-wndmax
     2114             ,output v-default-value
     2115             ) .
     2116         end.
     2117         assign
     2118           v-diasize-wndstore = false
     2119         .
     2120         if connected("ub") = true
     2121         then do:
     2122           run gbl/wndpar_r.p
     2123             (input  v-cntxt-db-num
     2124             ,input  v-cntxt-userid
     2125             ,input  'wndstore':U
     2126             ,output v-diasize-wndstore
     2127             ,output v-default-value
     2128             ) .
     2129         end.
     2130         assign
     2131           v-diasize-proc-name = entry(1, program-name(2), '.')
     2132         .
     2133         if v-diasize-wndstore = true
     2134         then do:
     2135           assign
     2136             v-restore-saved = false
     2137           .
     2138           if connected("ub") = true
     2139           then do:
     2140             run gbl/wndsizer.p
     2141               (input  v-cntxt-db-num
     2142               ,input  v-cntxt-userid
     2143               ,input  v-diasize-proc-name
     2144               ,input  'height':u
     2145               ,output v-resize-value-str
     2146               ) .
     2147             if v-resize-value-str <> '':U
     2148             then do:
     2149               run diasize_change-height in this-procedure
     2150                 (input  integer(v-resize-value-str)
     2151                 ,input  true
     2152                 ) .
     2153               assign
     2154                 v-restore-saved = true
     2155               .
     2156             end.
     2157           end.
     2158           if connected("ub") = true
     2159           then do:
     2160             run gbl/wndsizer.p
     2161               (input  v-cntxt-db-num
     2162               ,input  v-cntxt-userid
     2163               ,input  v-diasize-proc-name
     2164               ,input  'width':u
     2165               ,output v-resize-value-str
     2166               ) .
     2167             if v-resize-value-str <> '':U
     2168             then do:
     2169               run diasize_change-width in this-procedure
     2170                 (input  integer(v-resize-value-str)
     2171                 ,input  true
     2172                 ) .
     2173               assign
     2174                 v-restore-saved = true
     2175               .
     2176             end.
     2177           end.
     2178           if v-restore-saved <> true
     2179           then do:
     2180             if v-diasize-wndmax = true
     2181             then do:
     2182               run diasize_maximize in this-procedure
     2183                 (input  true
     2184                 ) .
     2185             end.
     2186           end.
     2187         end.
     2188         else do:
     2189           if v-diasize-wndmax = true
     2190           then do:
     2191             run diasize_maximize in this-procedure
     2192               (input  true
     2193               ) .
     2194           end.
     2195         end.
     2196       end.
     2197     end.
     2198   end procedure.
     2199   procedure diasize_need-full-display :
     2200     define output parameter p-need-full-display as logical   no-undo .
     2201     do
     2202     on error undo, return error return-value
     2203     :
     2204       assign
     2205         p-need-full-display = v-diasize-need-full-display
     2206       .
     2207       assign
     2208         v-diasize-need-full-display = false
     2209       .
     2210     end.
     2211   end procedure.
     2212   procedure get-context :
     2213      define output parameter p-db-num as integer          no-undo.
     2214      define output parameter p-user-id as character        no-undo.
     2215      define variable v-login               as character    no-undo.
     2216      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2217      define buffer buf_user-login  for ub.user-login .
     2218      do
     2219      on error undo, return error
     2220      :
     2221            FIND FIRST buf_sys-ctrl no-lock.
     2222            ASSIGN
     2223               v-login = USERID("ub")
     2224               p-db-num = buf_sys-ctrl.db-num
     2225            .
     2226            FIND FIRST buf_user-login
     2227                 WHERE buf_user-login.db-num = p-db-num
     2228                   AND buf_user-login.user-login = v-login
     2229                 no-lock
     2230                 no-error
     2231                 .
     2232            IF AVAILABLE buf_user-login
     2233            THEN DO:
     2234               assign
     2235                  p-user-id = buf_user-login.user-id
     2236               .
     2237            END.
     2238      end.
     2239   end procedure.
     2240       run diasize_init in this-procedure .
     2241   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2242   ON TAB ANYWHERE
     2243   DO:
     2244   define variable ii as integer no-undo .
     2245   define variable fh as widget-handle no-undo .
     2246   define variable hh as widget-handle no-undo .
     2247   define variable v-next-widget-name as character no-undo .
     2248   if "b-add,b-chg,b-del," + v-change-tab-order + "b-quit,b-exit" <> '' then do:
     2249     if self:type = "TOGGLE-BOX" then
     2250     self:BGCOLOR = ?.
     2251     assign
     2252     ii = lookup(self:name, "b-add,b-chg,b-del," + v-change-tab-order + "b-quit,b-exit").
     2253     assign
     2254     ii = ii + 1
     2255     v-next-widget-name = entry(ii, "b-add,b-chg,b-del," + v-change-tab-order + "b-quit,b-exit")
     2256     no-error .
     2257     if error-status:error then do:
     2258       assign
     2259       ii = 1
     2260       v-next-widget-name = entry( ii, "b-add,b-chg,b-del," + v-change-tab-order + "b-quit,b-exit")
     2261       .
     2262     end.
     2263     assign
     2264     fh = frame Dialog-Frame:first-child
     2265     hh = fh:first-child
     2266     .
     2267     do while valid-handle(hh):
     2268       if hh:name = v-next-widget-name then do:
     2269         if hh:sensitive  = yes
     2270         AND hh:visible = yes then do:
     2271           if hh:type = "TOGGLE-BOX":U then do:
     2272             assign
     2273             hh:BGcolor = 1
     2274             .
     2275           end.
     2276           APPLY "ENTRY" to hh.
     2277           return no-apply.
     2278         end.
     2279         else do:
     2280           APPLY "TAB" to hh.
     2281           return no-apply.
     2282         end.
     2283       end.
     2284       hh = hh:next-sibling.
     2285     end.
     2286   end.
     2287   END.
     2288   ON BACK-TAB ANYWHERE
     2289   DO:
     2290   define variable ii as integer no-undo .
     2291   define variable fh as widget-handle no-undo .
     2292   define variable hh as widget-handle no-undo .
     2293   define variable v-next-widget-name as character no-undo .
     2294   if "b-add,b-chg,b-del," + v-change-tab-order + "b-quit,b-exit" <> '' then do:
     2295     assign
     2296     ii = lookup(self:name, "b-add,b-chg,b-del," + v-change-tab-order + "b-quit,b-exit").
     2297     .
     2298     assign
     2299     ii = (if ii = 1
     2300           then  num-entries("b-add,b-chg,b-del," + v-change-tab-order + "b-quit,b-exit")
     2301           else ii - 1
     2302           )
     2303     v-next-widget-name = entry(ii, "b-add,b-chg,b-del," + v-change-tab-order + "b-quit,b-exit")
     2304     .
     2305     assign
     2306     fh = frame Dialog-Frame:first-child
     2307     hh = fh:first-child
     2308     .
     2309     do while valid-handle(hh):
     2310       if hh:name = v-next-widget-name then do:
     2311         if hh:sensitive  = yes
     2312         AND hh:visible = yes then do:
     2313           if hh:type = "TOGGLE-BOX":U then do:
     2314             assign
     2315             hh:BGcolor = 1
     2316             .
     2317           end.
     2318           APPLY "ENTRY" to hh.
     2319           return no-apply.
     2320         end.
     2321         else do:
     2322         APPLY "BACK-TAB" to hh.
     2323         return no-apply.
     2324         end.
     2325       end.
     2326       hh = hh:next-sibling.
     2327     end.
     2328     end.
     2329   END.
     2330   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2331   do:
     2332     BR-fin-doc-tax :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2333   end.
     2334   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2335   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2336   MAIN-BLOCK:
     2337   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2338      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2339     if p-mode <> 'ИЗМЕНЕНИЕ':U
     2340     and p-mode <> 'ПРОСМОТР':U
     2341     and p-mode <> 'ДОБАВЛЕНИЕ':U
     2342     and p-mode <> ('ПРОСМОТР':U + chr(4) + "history":U)
     2343     then do:
     2344       message
     2345       vss-workfile vss-revision vss-description skip
     2346       "Неверное значение параметров вызова p-mode"  p-mode
     2347       view-as alert-box ERROR.
     2348       undo, return error.
     2349     end.
     2350   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2351   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2352     (output v-db-num
     2353     )  .
     2354   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2355   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2356     (input  p-host-code
     2357     ,output v-base-code
     2358     )  .
     2359       find first X_curr_sysconf no-lock where
     2360                       X_curr_sysconf.host-code = p-curr-host-code.
     2361       find first X_sysconf no-lock where
     2362                     X_sysconf.host-code = p-host-code.
     2363      assign
     2364      v-fin-vat-pc = X_sysconf.fin-vat-pc
     2365       v-fin-slt-pc = X_sysconf.fin-slt-pc
     2366       .
     2367       find first X_clients-host no-lock where
     2368                 X_clients-host.obj-type = 'орг':U
     2369             AND X_clients-host.obj-code = p-host-code.
     2370     if p-mode = 'ИЗМЕНЕНИЕ':U
     2371     or p-mode = 'ПРОСМОТР':U then do:
     2372       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     2373         find first locked_fin-doc EXclusive-lock where
     2374                    locked_fin-doc.host-code  = p-host-code
     2375                AND locked_fin-doc.fin-doc-code  = p-fin-doc-code
     2376                      no-wait no-error.
     2377         if locked locked_fin-doc then do:
     2378           message
     2379           vss-workfile vss-revision vss-description skip
     2380           "Запись Платежа занята"
     2381           "фирма" p-host-code
     2382           "внутр. № документа" p-fin-doc-code
     2383           view-as alert-box error .
     2384           undo, return error.
     2385         end.
     2386       end.
     2387       else do:
     2388         find first locked_fin-doc no-lock where
     2389                    locked_fin-doc.host-code  = p-host-code
     2390                AND locked_fin-doc.fin-doc-code  = p-fin-doc-code no-error .
     2391       end.
     2392       if not available locked_fin-doc
     2393       then do:
     2394         message
     2395         vss-workfile vss-revision vss-description skip
     2396         "Не найдена запись ПЛАТЕЖА"
     2397         view-as alert-box error .
     2398         undo, return error.
     2399       end.
     2400     end.
     2401     if p-mode = ('ПРОСМОТР':U + chr(4) + "history":U)
     2402     then do:
     2403       find first locked_c-fin-doc no-lock where
     2404                   locked_c-fin-doc.host-code  = p-host-code
     2405               AND locked_c-fin-doc.fin-doc-code  = p-fin-doc-code no-error .
     2406       if not available locked_c-fin-doc
     2407       then do:
     2408         message
     2409         vss-workfile vss-revision vss-description skip
     2410         "Не найдена запись истории ПЛАТЕЖА"
     2411         view-as alert-box error .
     2412         undo, return error.
     2413       end.
     2414     end.
     2415     find first X_currency no-lock where
     2416                  X_currency.curr-code = p-curr-code.
     2417     run fill-tables in this-procedure.
     2418     RUN Myenable.
     2419     WAIT-FOR GO OF FRAME Dialog-Frame.
     2420   END.
     2421   RUN disable_UI.
     2422   PROCEDURE check-sums :
     2423   define variable acc as decimal no-undo.
     2424   define buffer buf_tt-fin-doc-tax for tt-fin-doc-tax.
     2425   for each buf_tt-fin-doc-tax:
     2426       assign
     2427       acc = acc + buf_tt-fin-doc-tax.sum-line-doc
     2428       .
     2429   end.
     2430   if acc <> p-sum-doc then do:
     2431   message
     2432   substitute("Общая сумма платежа &1, а сумма всех компонент, по которым исчислялся налог - &2", p-sum-doc, acc)
     2433   view-as alert-box ERROR.
     2434   return error.
     2435   end.
     2436   END PROCEDURE.
     2437   PROCEDURE disable-enable :
     2438   define input parameter p-main-widget as character no-undo.
     2439   CASE p-main-widget:
     2440     when "vat-sum" then do:
     2441       assign
     2442           T-vatpc = no.
     2443           enable
     2444                   t-vatpc
     2445                   f-sum-vat
     2446                   with frame Dialog-Frame.
     2447           disable
     2448           t-vatsum
     2449           f-vat-pc
     2450           with frame Dialog-Frame.
     2451     end.
     2452       when "slt-sum" then do:
     2453         assign
     2454           T-sltpc = no.
     2455           enable
     2456                   t-sltpc
     2457                   f-sum-slt
     2458                   with frame Dialog-Frame.
     2459           disable
     2460           t-sltsum
     2461           f-slt-pc
     2462           with frame Dialog-Frame.
     2463     end.
     2464     when "vat-pc" then do:
     2465       assign
     2466           T-vatsum = no.
     2467               enable
     2468                   t-vatsum
     2469                   f-vat-pc
     2470                   with frame Dialog-Frame.
     2471           disable
     2472           t-vatpc
     2473           f-sum-vat
     2474           with frame Dialog-Frame.
     2475     end.
     2476     when "slt-pc" then do:
     2477         assign
     2478           T-sltsum = no.
     2479                   enable
     2480                   t-sltsum
     2481                   f-slt-pc
     2482                   with frame Dialog-Frame.
     2483           disable
     2484           t-sltpc
     2485           f-sum-slt
     2486           with frame Dialog-Frame.
     2487     end.
     2488   END CASE.
     2489   display
     2490   T-sltpc
     2491   T-sltsum
     2492   T-vatpc
     2493   T-vatsum
     2494   with frame Dialog-Frame.
     2495   END PROCEDURE.
     2496   PROCEDURE disable_UI :
     2497     HIDE FRAME Dialog-Frame.
     2498   END PROCEDURE.
     2499   PROCEDURE enable_UI :
     2500     OPEN QUERY Dialog-Frame FOR EACH locked_fin-doc SHARE-LOCK.
     2501     GET FIRST Dialog-Frame.
     2502     DISPLAY f-all-sum-doc F-curr-code f-curr-abbr f-sum-tax f-sum-doc f-sum-vat
     2503             T-vatsum f-vat-pc T-vatpc T-with-vat T-sltsum T-sltpc f-slt-pc
     2504             f-sum-slt T-with-slt
     2505         WITH FRAME Dialog-Frame.
     2506     ENABLE B-ok B-exit b-quit B-not-ok B-Help F-curr-code BR-fin-doc-tax
     2507            f-sum-doc f-vat-pc T-vatpc T-with-vat T-sltpc f-slt-pc T-with-slt
     2508            B-add B-chg B-del
     2509         WITH FRAME Dialog-Frame.
     2510     VIEW FRAME Dialog-Frame.
     2511   END PROCEDURE.
     2512   PROCEDURE fill-tables :
     2513   define buffer buf_fin-doc-tax for ub.fin-doc-tax.
     2514   define buffer buf_c-fin-doc-tax for ub.c-fin-doc-tax.
     2515   define buffer buf_tt-fin-doc-tax for tt-fin-doc-tax.
     2516   do on error undo, return error:
     2517     if p-mode = 'ПРОСМОТР':U + chr(4) + "History":U then do:
     2518       for each buf_c-fin-doc-tax no-lock where
     2519                   buf_c-fin-doc-tax.host-code = p-host-code
     2520             AND buf_c-fin-doc-tax.fin-doc-code = p-fin-doc-code
     2521             AND buf_c-fin-doc-tax.chip-num = p-chip-num
     2522             :
     2523         create buf_tt-fin-doc-tax.
     2524         buffer-copy buf_c-fin-doc-tax to buf_tt-fin-doc-tax.
     2525       END.
     2526     end.
     2527     else do:
     2528       find first tt0-fin-doc-tax no-lock no-error.
     2529       if available tt0-fin-doc-tax then do:
     2530         for each tt0-fin-doc-tax no-lock where
     2531                     tt0-fin-doc-tax.host-code = p-host-code
     2532               AND tt0-fin-doc-tax.fin-doc-code = p-fin-doc-code:
     2533           create buf_tt-fin-doc-tax.
     2534           buffer-copy tt0-fin-doc-tax to buf_tt-fin-doc-tax.
     2535         END.
     2536       end.
     2537       else do:
     2538         for each buf_fin-doc-tax no-lock where
     2539                     buf_fin-doc-tax.host-code = p-host-code
     2540               AND buf_fin-doc-tax.fin-doc-code = p-fin-doc-code:
     2541           create buf_tt-fin-doc-tax.
     2542           buffer-copy buf_fin-doc-tax to buf_tt-fin-doc-tax.
     2543         END.
     2544       end.
     2545     end.
     2546     RUN get-rest-sum in this-procedure(output v-rest-sum-doc, output v-sum-tax).
     2547   end.
     2548   if p-contract-code <> 0 then do:
     2549     find first X_contract no-lock where
     2550     x_contract.host-code = p-host-code
     2551     AND x_contract.contract-code = p-contract-code.
     2552           assign
     2553     v-fin-vat-pc = X_contract.fin-vat-pc
     2554     v-fin-slt-pc = X_contract.fin-slt-pc
     2555     .
     2556   end.
     2557   END PROCEDURE.
     2558   PROCEDURE get-rest-sum :
     2559   define output parameter p-rest-sum like ub.fin-doc-tax.sum-line-doc no-undo.
     2560   define output parameter p-sum-tax  like ub.fin-doc-tax.sum-line-doc no-undo .
     2561   define buffer buf_tt-fin-doc-tax for tt-fin-doc-tax.
     2562   for each buf_tt-fin-doc-tax no-lock:
     2563       assign
     2564       p-rest-sum = p-rest-sum + buf_tt-fin-doc-tax.sum-line-doc
     2565       p-sum-tax = p-sum-tax +  buf_tt-fin-doc-tax.sum-vat-line-doc + buf_tt-fin-doc-tax.sum-slt-line-doc
     2566       .
     2567   end.
     2568   assign
     2569   p-rest-sum = p-sum-doc - p-rest-sum
     2570   .
     2571   END PROCEDURE.
     2572   PROCEDURE Myenable :
     2573   assign
     2574   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + x_clients-host.obj-name
     2575   b-quit:label = (if lookup('ПРОСМОТР':U, p-mode, chr(4)) > 0 then "&Выход" else b-quit:label)
     2576   t-with-slt = yes
     2577   t-with-vat = yes
     2578   t-sltpc = yes
     2579   t-vatpc = yes
     2580   t-sltsum = no
     2581   t-vatsum = no
     2582   .
     2583   DISPLAY
     2584   p-sum-doc @ f-all-sum-doc
     2585   p-curr-code @ f-curr-code
     2586   v-sum-tax @ f-sum-tax
     2587   X_currency.curr-abbr @ f-curr-abbr
     2588   WITH FRAME Dialog-Frame.
     2589   ENABLE
     2590   b-quit
     2591   B-exit when lookup('ПРОСМОТР':U, p-mode, chr(4)) = 0
     2592   B-add  when lookup('ПРОСМОТР':U, p-mode, chr(4)) = 0
     2593   B-chg  when lookup('ПРОСМОТР':U, p-mode, chr(4)) = 0
     2594   B-del  when lookup('ПРОСМОТР':U, p-mode, chr(4)) = 0
     2595   B-Help
     2596   BR-fin-doc-tax
     2597   WITH FRAME Dialog-Frame.
     2598   if lookup('ПРОСМОТР':U, p-mode, chr(4)) > 0 then do:
     2599     hide
     2600     b-exit
     2601     in frame Dialog-Frame .
     2602     b-quit:column = 1.
     2603   end.
     2604   hide
     2605   f-slt-pc
     2606   f-sum-doc
     2607   f-sum-vat
     2608   f-sum-slt
     2609   f-vat-pc
     2610   T-sltpc
     2611   T-sltsum
     2612   T-vatpc
     2613   T-vatsum
     2614   T-with-slt
     2615   T-with-vat
     2616   b-ok
     2617   b-not-ok
     2618   in frame Dialog-Frame.
     2619   VIEW FRAME Dialog-Frame.
     2620   run openbr in this-procedure .
     2621   END PROCEDURE.
     2622   PROCEDURE OpenBr :
     2623   Open query br-fin-doc-tax
     2624   for each tt-fin-doc-tax no-lock where
     2625               tt-fin-doc-tax.fin-doc-code = p-fin-doc-code
     2626           AND tt-fin-doc-tax.host-code = p-host-code.
     2627   END PROCEDURE.
     2628   PROCEDURE proc-b-add-chg :
     2629   define input parameter p-mode as character no-undo.
     2630   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     2631       assign
     2632       f-slt-pc     = tt-fin-doc-tax.slt-pc
     2633       f-sum-doc    = tt-fin-doc-tax.sum-line-doc
     2634       f-sum-vat    = tt-fin-doc-tax.sum-vat-line-doc
     2635       f-sum-slt    =  tt-fin-doc-tax.sum-slt-line-doc
     2636       f-vat-pc     =  tt-fin-doc-tax.vat-pc
     2637       T-with-slt   =  tt-fin-doc-tax.with-slt
     2638       T-with-vat   =  tt-fin-doc-tax.with-vat
     2639       v-updated-line-num = tt-fin-doc-tax.line-num
     2640       .
     2641   end.
     2642   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     2643       assign
     2644       f-slt-pc     = v-fin-slt-pc * (If T-with-slt then 1 else 0)
     2645       f-sum-doc    = (if v-rest-sum-doc > 0 then v-rest-sum-doc else 0)
     2646       f-sum-tax    = v-sum-tax
     2647       f-vat-pc     = v-fin-vat-pc * (If T-with-vat then 1 else 0)
     2648       T-with-slt   = yes
     2649       T-with-vat    = yes
     2650       f-sum-slt    = f-sum-doc * f-slt-pc / ( 100  + f-slt-pc )
     2651       f-sum-vat    = (f-sum-doc - f-sum-slt ) * f-vat-pc / (100 + f-vat-pc )
     2652       .
     2653   end.
     2654   assign
     2655   t-sltpc = yes
     2656   t-vatpc = yes
     2657   t-sltsum = no
     2658   t-vatsum = no
     2659   .
     2660   display
     2661   f-slt-pc
     2662   f-sum-doc
     2663   f-sum-vat
     2664   f-sum-slt
     2665   f-vat-pc
     2666   T-sltpc
     2667   T-sltsum
     2668   T-vatpc
     2669   T-vatsum
     2670   T-with-slt
     2671   T-with-vat
     2672   b-ok
     2673   b-not-ok
     2674   with frame Dialog-Frame.
     2675   disable
     2676   b-exit
     2677   b-add
     2678   b-chg
     2679   b-del
     2680   t-sltpc
     2681   t-vatpc
     2682   f-sum-vat
     2683   f-sum-slt
     2684   with frame Dialog-Frame.
     2685   hide
     2686   b-exit
     2687   b-add
     2688   b-chg
     2689   b-del
     2690   BR-fin-doc-tax
     2691   IN frame Dialog-Frame.
     2692   enable
     2693   f-sum-doc
     2694   f-vat-pc when t-with-vat
     2695   f-slt-pc when t-with-slt
     2696   T-vatsum  when t-with-vat
     2697   T-sltsum when t-with-slt
     2698   T-with-slt
     2699   T-with-vat
     2700   b-ok
     2701   b-not-ok
     2702   with frame Dialog-Frame.
     2703   assign
     2704   v-change-tab-order = "f-sum-doc,T-with-vat,T-vatpc,f-vat-pc,T-vatsum,f-sum-vat,T-with-slt,T-sltpc,f-slt-pc,T-sltsum,f-sum-slt,b-ok,b-not-ok,".
     2705   APPLY "ENTRY" to f-sum-doc.
     2706   END PROCEDURE.
     2707   PROCEDURE proc-b-not-ok :
     2708   assign
     2709   v-add-chg = "":U
     2710   v-change-tab-order = "":U
     2711   .
     2712   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     2713       assign
     2714       f-slt-pc         = 0
     2715       f-sum-doc    =   0
     2716       f-sum-vat     =  0
     2717       f-sum-slt      = 0
     2718       f-vat-pc        = 0
     2719       T-with-slt      =  yes
     2720       T-with-vat    =      Yes
     2721       .
     2722   end.
     2723   hide
     2724   f-slt-pc in frame Dialog-Frame
     2725   f-sum-doc
     2726   f-sum-vat
     2727   f-sum-slt
     2728   f-vat-pc
     2729   T-sltpc
     2730   T-sltsum
     2731   T-vatpc
     2732   T-vatsum
     2733   T-with-slt
     2734   T-with-vat
     2735   b-ok
     2736   b-not-ok
     2737   in frame Dialog-Frame.
     2738   DISPLAY BR-fin-doc-tax WITH FRAME Dialog-Frame .
     2739   enable
     2740   b-exit
     2741   b-add
     2742   b-chg
     2743   b-del
     2744   with frame Dialog-Frame.
     2745   END PROCEDURE.
     2746   PROCEDURE proc-b-ok :
     2747   define input parameter p-line-num like tt-fin-doc-tax.line-num no-undo .
     2748   define buffer buf_tt-fin-doc-tax for tt-fin-doc-tax.
     2749   assign
     2750   frame Dialog-Frame
     2751   f-slt-pc
     2752   f-sum-doc
     2753   f-sum-vat
     2754   f-sum-slt
     2755   f-vat-pc
     2756   T-with-slt
     2757   T-with-vat
     2758   .
     2759   if f-sum-vat + f-sum-slt >= f-sum-doc
     2760   then do:
     2761     message
     2762     "Сумма налогов больше налогооблагаемой суммы!"
     2763     view-as alert-box error .
     2764     return error.
     2765   end.
     2766   CASE v-add-chg:
     2767     when 'ДОБАВЛЕНИЕ':U then do:
     2768       find last buf_tt-fin-doc-tax no-lock where
     2769       buf_tt-fin-doc-tax.host-code = p-host-code
     2770       AND buf_tt-fin-doc-tax.fin-doc-code = p-fin-doc-code
     2771       use-index pi
     2772       no-error.
     2773       if available buf_tt-fin-doc-tax then
     2774       assign
     2775       last-line = buf_tt-fin-doc-tax.line-num
     2776       .
     2777       create
     2778       buf_tt-fin-doc-tax.
     2779       assign
     2780       buf_tt-fin-doc-tax.host-code = p-host-code
     2781       buf_tt-fin-doc-tax.fin-doc-code = p-fin-doc-code
     2782       buf_tt-fin-doc-tax.line-num = last-line + 1
     2783       buf_tt-fin-doc-tax.sum-line-doc  = f-sum-doc
     2784       buf_tt-fin-doc-tax.sum-slt-line-doc = f-sum-slt
     2785       buf_tt-fin-doc-tax.sum-vat-line-doc  = f-sum-vat
     2786       buf_tt-fin-doc-tax.vat-pc  = f-vat-pc
     2787       buf_tt-fin-doc-tax.with-slt = t-with-slt
     2788       buf_tt-fin-doc-tax.with-vat = t-with-vat
     2789       buf_tt-fin-doc-tax.slt-pc = f-slt-pc
     2790       .
     2791     end.
     2792     when 'ИЗМЕНЕНИЕ':U then do:
     2793       find first buf_tt-fin-doc-tax where
     2794                   buf_tt-fin-doc-tax.line-num = p-line-num.
     2795       assign
     2796       buf_tt-fin-doc-tax.sum-line-doc  = f-sum-doc
     2797       buf_tt-fin-doc-tax.sum-slt-line-doc = f-sum-slt
     2798       buf_tt-fin-doc-tax.sum-vat-line-doc  = f-sum-vat
     2799       buf_tt-fin-doc-tax.vat-pc  = f-vat-pc
     2800       buf_tt-fin-doc-tax.with-slt = t-with-slt
     2801       buf_tt-fin-doc-tax.with-vat = t-with-vat
     2802       buf_tt-fin-doc-tax.slt-pc = f-slt-pc
     2803       .
     2804     end.
     2805   END CASE.
     2806   assign
     2807   v-add-chg = "":U
     2808   v-change-tab-order = "":U
     2809   .
     2810   RUN get-rest-sum in this-procedure(output v-rest-sum-doc, output v-sum-tax).
     2811   hide
     2812   f-slt-pc
     2813   f-sum-doc
     2814   f-sum-vat
     2815   f-sum-slt
     2816   f-vat-pc
     2817   T-sltpc
     2818   T-sltsum
     2819   T-vatpc
     2820   T-vatsum
     2821   T-with-slt
     2822   T-with-vat
     2823   b-ok
     2824   b-not-ok
     2825   in frame Dialog-Frame.
     2826   DISPLAY BR-fin-doc-tax WITH FRAME Dialog-Frame .
     2827   run openbr in this-procedure.
     2828   find first buf_tt-fin-doc-tax no-lock where
     2829              buf_tt-fin-doc-tax.line-num = (if v-add-chg = 'ДОБАВЛЕНИЕ':U
     2830                                             then (last-line + 1)
     2831                                             else v-updated-line-num) no-error .
     2832   if available buf_tt-fin-doc-tax then do:
     2833     reposition BR-fin-doc-tax to recid recid(buf_tt-fin-doc-tax) no-error .
     2834   end.
     2835   enable
     2836   b-exit
     2837   b-add
     2838   b-chg
     2839   b-del
     2840   with frame Dialog-Frame.
     2841   display
     2842   v-sum-tax @ f-sum-tax
     2843   with frame Dialog-Frame.
     2844   END PROCEDURE.
     2845   PROCEDURE proc-save :
     2846   do on error undo, return error:
     2847     for each tt0-fin-doc-tax where
     2848             tt0-fin-doc-tax.host-code = p-host-code
     2849          AND tt0-fin-doc-tax.fin-doc-code = p-fin-doc-code:
     2850       find first tt-fin-doc-tax no-lock where
     2851                  tt-fin-doc-tax.host-code = p-host-code
     2852              AND tt-fin-doc-tax.fin-doc-code = p-fin-doc-code
     2853              AND tt-fin-doc-tax.line-num = tt0-fin-doc-tax.line-num no-error .
     2854       if not available tt-fin-doc-tax then do:
     2855         delete tt0-fin-doc-tax.
     2856       end.
     2857     end.
     2858    for each tt-fin-doc-tax :
     2859       find first tt0-fin-doc-tax where
     2860                  tt0-fin-doc-tax.host-code = p-host-code
     2861              AND tt0-fin-doc-tax.fin-doc-code = p-fin-doc-code
     2862              AND tt0-fin-doc-tax.line-num   = tt-fin-doc-tax.line-num
     2863              no-error .
     2864       if not available tt0-fin-doc-tax then do:
     2865         create tt0-fin-doc-tax.
     2866         assign
     2867         tt0-fin-doc-tax.host-code = p-host-code
     2868         tt0-fin-doc-tax.fin-doc-code = p-fin-doc-code
     2869         tt0-fin-doc-tax.line-num = tt-fin-doc-tax.line-num
     2870         .
     2871       end.
     2872       buffer-copy tt-fin-doc-tax except host-code fin-doc-code line-num
     2873       to tt0-fin-doc-tax.
     2874     end.
     2875   end.
     2876     for each tt0-fin-doc-tax where
     2877             tt0-fin-doc-tax.host-code = p-host-code
     2878          AND tt0-fin-doc-tax.fin-doc-code = p-fin-doc-code:
     2879     end.
     2880   END PROCEDURE.
     2881   PROCEDURE recalc-sums :
     2882   define input parameter p-main-widget as character no-undo.
     2883   define variable v-line-num like ub.fin-doc-tax.line-num no-undo.
     2884   define buffer buf_tt-fin-doc-tax for tt-fin-doc-tax.
     2885   case v-add-chg:
     2886     when 'ИЗМЕНЕНИЕ':U then do:
     2887       assign
     2888       v-line-num = tt-fin-doc-tax.line-num
     2889       .
     2890     end.
     2891     when 'ДОБАВЛЕНИЕ':U then do:
     2892       assign
     2893       v-line-num = last-line
     2894       .
     2895     end.
     2896    END CASE.
     2897    if f-vat-pc <> -1 then do:
     2898   CASE p-main-widget :
     2899       when "sum-doc":U then do:
     2900         assign
     2901         f-sum-slt = f-sum-doc * f-slt-pc / ( 100  + f-slt-pc )
     2902         f-sum-vat =  (f-sum-doc - f-sum-slt ) * f-vat-pc / (100 + f-vat-pc )
     2903         .
     2904       end.
     2905       when "slt-pc":U then do:
     2906         assign
     2907         f-sum-slt = f-sum-doc * f-slt-pc / ( 100  + f-slt-pc )
     2908         f-sum-vat = (f-sum-doc - f-sum-slt ) * f-vat-pc / (100 + f-vat-pc )
     2909         .
     2910       end.
     2911       when "vat-pc":U then do:
     2912         assign
     2913         f-sum-vat = (f-sum-doc - f-sum-slt ) * f-vat-pc / (100 + f-vat-pc )
     2914         .
     2915       end.
     2916       when "sum-slt":U then do:
     2917         assign
     2918         f-slt-pc = f-sum-slt / (f-sum-doc - f-sum-slt ) * 100
     2919         f-sum-vat =  (f-sum-doc - f-sum-slt ) * f-vat-pc / (100 + f-vat-pc )
     2920         .
     2921       end.
     2922       when "sum-vat":U then do:
     2923         assign
     2924         f-vat-pc = f-sum-vat / (f-sum-doc - f-sum-slt - f-sum-vat ) * 100
     2925         .
     2926       end.
     2927   END CASE.
     2928   end.
     2929   if
     2930   not (f-sum-vat = 0
     2931   and f-sum-slt = 0
     2932   and f-sum-doc = 0)
     2933   and
     2934   f-sum-vat + f-sum-slt >= f-sum-doc  then do:
     2935     message
     2936     "Сумма налогов больше налогооблагаемой суммы + налоги!"
     2937     view-as alert-box error .
     2938     return error.
     2939   end.
     2940   display
     2941   f-slt-pc
     2942   f-sum-doc
     2943   f-sum-vat
     2944   f-sum-slt
     2945   f-vat-pc
     2946   with frame Dialog-Frame.
     2947   END PROCEDURE.
     2948   PROCEDURE with-without :
     2949   define input parameter p-widget as character no-undo.
     2950   define input parameter p-on as logical no-undo.
     2951   define input parameter p-rewrite-tax as logical no-undo .
     2952   CASE p-widget:
     2953     when "slt":U then do:
     2954       CASE p-on:
     2955         when yes then do:
     2956           assign
     2957           f-slt-pc     = v-fin-slt-pc
     2958           T-with-slt   = yes
     2959           f-sum-slt    = f-sum-doc * f-slt-pc / ( 100  + f-slt-pc )
     2960           f-sum-vat    = (f-sum-doc - f-sum-slt ) * f-vat-pc / (100 + f-vat-pc )
     2961           .
     2962           display
     2963           f-slt-pc
     2964           f-sum-slt
     2965           t-with-slt
     2966           with frame Dialog-Frame.
     2967           enable
     2968           f-slt-pc
     2969           T-sltsum
     2970           with frame Dialog-Frame.
     2971           disable
     2972           f-sum-slt
     2973           t-sltpc
     2974           with frame Dialog-Frame.
     2975         end.
     2976         when no then do:
     2977           assign
     2978           f-slt-pc = 0
     2979           .
     2980           display
     2981           f-slt-pc
     2982           with frame Dialog-Frame.
     2983           apply "LEAVE" to f-slt-pc.
     2984           disable
     2985           f-slt-pc
     2986           f-sum-slt
     2987           T-sltpc
     2988           T-sltsum
     2989           with frame Dialog-Frame.
     2990         end.
     2991       END CASE.
     2992     end.
     2993     when "vat":U then do:
     2994       CASE p-on:
     2995         when yes then do:
     2996           if p-rewrite-tax then do:
     2997             if f-vat-pc <> -1 then
     2998           assign
     2999           f-vat-pc     = v-fin-vat-pc
     3000           .
     3001           end.
     3002           if f-vat-pc <> -1 then do:
     3003           assign
     3004           T-with-vat   = yes
     3005           f-sum-vat    = (f-sum-doc - f-sum-slt ) * f-vat-pc / (100 + f-vat-pc )
     3006           .
     3007           end.
     3008           display
     3009           f-vat-pc
     3010           f-sum-vat
     3011           t-with-vat
     3012           with frame Dialog-Frame.
     3013           enable
     3014           f-vat-pc
     3015           T-vatsum
     3016           with frame Dialog-Frame.
     3017           disable
     3018           f-sum-vat
     3019           t-vatpc
     3020           with frame Dialog-Frame.
     3021         end.
     3022         when no then do:
     3023           assign
     3024           f-vat-pc = 0
     3025           .
     3026           display
     3027           f-vat-pc
     3028           with frame Dialog-Frame.
     3029           apply "LEAVE" to f-vat-pc.
     3030           disable
     3031           f-vat-pc
     3032           f-sum-vat
     3033           T-vatpc
     3034           T-vatsum
     3035           with frame Dialog-Frame.
     3036         end.
     3037       END CASE.
     3038     end.
     3039   END CASE.
     3040   END PROCEDURE.
