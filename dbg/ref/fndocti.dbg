      643   define variable v-line-num like ub.fin-doc-tax.line-num no-undo.
      644   DEFINE BUFFER buf_tt-fin-doc-tax for tt-fin-doc-tax.
      645       IF AVAIL tt-fin-doc-tax then do:
      646       do
      647   on error undo, return no-apply
      648   :
      649           FIND FIRST buf_tt-fin-doc-tax WHERE
      650                            recid(buf_tt-fin-doc-tax) = RECID(tt-fin-doc-tax) NO-ERROR.
      651           if avail buf_tt-fin-doc-tax then do:
      652               assign
      653               v-line-num = buf_tt-fin-doc-tax.line-num
      654               .
      655               delete buf_tt-fin-doc-tax.
      656               find first tt-fix where
      657               tt-fix.line-num = v-line-num no-error.
      658               if available tt-fix then delete tt-fix.
      659           end.
      660           for each buf_tt-fin-doc-tax where
      661                       buf_tt-fin-doc-tax.host-code = p-host-code
      662                  AND buf_tt-fin-doc-tax.fin-doc-code = p-fin-doc-code
      663                  AND buf_tt-fin-doc-tax.line-num > v-line-num
      664                  by buf_tt-fin-doc-tax.line-num:
      665               assign
      666               buf_tt-fin-doc-tax.line-num = buf_tt-fin-doc-tax.line-num - 1
      667               .
      668           end.
      669            for each tt-fix where
      670             tt-fix.line-num > v-line-num
      671                  by tt-fix.line-num:
      672               assign
      673               tt-fix.line-num = tt-fix.line-num - 1
      674               .
      675           end.
      676   end.
      677         run openbr in this-procedure.
      678         RUN get-rest-sum in this-procedure(output v-rest-sum-doc, output v-sum-tax).
