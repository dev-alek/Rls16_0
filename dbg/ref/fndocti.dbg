      514         tt-fin-doc-tax.sum-slt-line-doc COLUMN-LABEL "Сумма НП" FORMAT ">,>>>,>>>,>>>,>>9.99":U
      515       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.54.
      516   DEFINE FRAME Dialog-Frame
      517        B-ok AT ROW 1 COL 1
      518        B-exit AT ROW 1 COL 1
      519        b-quit AT ROW 1 COL 11
      520        B-not-ok AT ROW 1 COL 11
      521        B-Help AT ROW 1 COL 89
      522        f-all-sum-doc AT ROW 2.25 COL 20.5 COLON-ALIGNED
      523        F-curr-code AT ROW 2.25 COL 50.25 COLON-ALIGNED
      524        f-curr-abbr AT ROW 2.25 COL 55.25 COLON-ALIGNED NO-LABEL
      525        f-sum-tax AT ROW 2.25 COL 74.5 COLON-ALIGNED
      526        BR-fin-doc-tax AT ROW 3.46 COL 1
      527        f-sum-doc AT ROW 4.08 COL 23.25 COLON-ALIGNED
      528        f-sum-vat AT ROW 5.17 COL 74.25 COLON-ALIGNED
      529        T-vatsum AT ROW 5.21 COL 61.75
      530        f-vat-pc AT ROW 5.25 COL 45.63 COLON-ALIGNED
