        1   block-level on error undo, throw.
        2   define input parameter p-mode            as character no-undo .
        3   define input parameter p-gds-code        like ub.goods-attr.gds-code no-undo .
        4   define new global shared variable g#language as character no-undo .
        5   if g#language <> '' and g#language <> 'rus':U then do:
        6     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        7   end.
        8   define temp-table tt0-goods-attr no-undo like ub.goods-attr
        9   field grp as logical
       10   field fdisable as logical
       11   index attr-code-activ fdisable gds-code attr-code
       12   index attr-code                gds-code attr-code.
       13   procedure addGdsGrpAttr:
       14      define input  parameter i-gds-code as integer no-undo.
       15      define input  parameter i-grp-code as integer no-undo.
       16      define variable vi as integer no-undo.
       17      define buffer buf_gds-grp-obj-attr for gds-grp-obj-attr.
       18      define buffer tt0-goods-attr for tt0-goods-attr.
       19      define buffer buf-goods-attr for tt0-goods-attr.
       20      for each tt0-goods-attr where tt0-goods-attr.grp:
       21         delete tt0-goods-attr.
       22      end.
       23      do vi = 1 to num-entries('alcohol-prod,egais-name,is-gas,ptrl-without-rvs,office-type,mark-type,emrc-type,IS18Plus,loyalty-gift,item-matter-mark,type-method-calc,group-np,fuel-type,is-loyalty-payment,ban-bonus,null-price,fasovka,time-coock,mark,sum-grp-gl,min-zapas,mercur_FGIS,perishable,production-only,15x80,8x50,6x50,calories,protein,fat,carbohydrate,calc-cal-rec,cash-parts,ptrl-as-good,dflt-insalepr,gds-ptrl-densities,gds-CommodityCode,gds-code-AIS,length-of,width-of,height-of,qnty-in-box,weight-box,qnty-on-pallet,weight-of-pallet,image-list,MercUnits,weighed-gds':U):
       24         find first buf_gds-grp-obj-attr no-lock
       25            where buf_gds-grp-obj-attr.node-code   = i-grp-code
       26              and buf_gds-grp-obj-attr.host-code   = 0
       27              and buf_gds-grp-obj-attr.obj-type    = ""
       28              and buf_gds-grp-obj-attr.obj-code    = 0
       29              and buf_gds-grp-obj-attr.attr-code   = entry(vi,'alcohol-prod,egais-name,is-gas,ptrl-without-rvs,office-type,mark-type,emrc-type,IS18Plus,loyalty-gift,item-matter-mark,type-method-calc,group-np,fuel-type,is-loyalty-payment,ban-bonus,null-price,fasovka,time-coock,mark,sum-grp-gl,min-zapas,mercur_FGIS,perishable,production-only,15x80,8x50,6x50,calories,protein,fat,carbohydrate,calc-cal-rec,cash-parts,ptrl-as-good,dflt-insalepr,gds-ptrl-densities,gds-CommodityCode,gds-code-AIS,length-of,width-of,height-of,qnty-in-box,weight-box,qnty-on-pallet,weight-of-pallet,image-list,MercUnits,weighed-gds':U)
       30         no-error .
       31         if available buf_gds-grp-obj-attr
       32         then do:
       33            find first tt0-goods-attr where tt0-goods-attr.gds-code   = i-gds-code
       34                                        and tt0-goods-attr.attr-code  = buf_gds-grp-obj-attr.attr-code
       35                                        and tt0-goods-attr.grp
       36            no-error.
       37               create tt0-goods-attr.
       38            assign
       39               tt0-goods-attr.gds-code   = i-gds-code
       40               tt0-goods-attr.attr-code  = buf_gds-grp-obj-attr.attr-code
       41               tt0-goods-attr.attr-value = buf_gds-grp-obj-attr.attr-value
       42               tt0-goods-attr.grp        = yes
       43            .
       44            tt0-goods-attr.fdisable = can-find (buf-goods-attr where buf-goods-attr.gds-code   eq tt0-goods-attr.gds-code
       45                                                                 and buf-goods-attr.attr-code  eq tt0-goods-attr.attr-code
       46                                                                 and buf-goods-attr.grp        ne yes).
       47            .
       48            end.
       49      end.
       50   end.
       51   DEFINE INPUT PARAMETER TABLE FOR tt0-goods-attr.
       52   define variable vss-revision    as character no-undo init "$Revision: 0ed05d970e58, 3225, rls $":U .
       53   define variable vss-author      as character no-undo init "$Author: DRuban $":U .
       54   define variable vss-date        as character no-undo init "$Date: 2022/12/27 12:54:29 $":U .
       55   define variable vss-workfile    as character no-undo init "$Workfile: gds-atr1.p $":U .
       56   define variable vss-archive     as character no-undo init "$Archive: ref/gds-atr1.p $":U .
       57   define variable vss-description as character no-undo init "Сохранение изменеий атрибутов товара".
       58   procedure vss-get-info :
       59     define output parameter p-vss-revision    like vss-revision    no-undo .
       60     define output parameter p-vss-author      like vss-author      no-undo .
       61     define output parameter p-vss-date        like vss-date        no-undo .
       62     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       63     define output parameter p-vss-archive     like vss-archive     no-undo .
       64     define output parameter p-vss-description like vss-description no-undo .
       65     assign
       66       p-vss-revision    = vss-revision
       67       p-vss-author      = vss-author
       68       p-vss-date        = vss-date
       69       p-vss-workfile    = vss-workfile
       70       p-vss-archive     = vss-archive
       71       p-vss-description = vss-description
       72     .
       73   end procedure.
       74   procedure vss-get-parameters :
       75     define output parameter p-vss-parameters as character no-undo .
       76       assign
       77         p-vss-parameters = substitute('&1':u,p-gds-code)
       78       .
       79   end procedure.
       80   define new global shared variable g#vssrevis-logger as handle    no-undo .
       81   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       82   define variable v-vssrevis-logger                   as handle    no-undo .
       83   procedure vss-logevent :
       84     define input  parameter p-extra-paramters as character no-undo .
       85     define variable v-vssrevis-parameters as character no-undo .
       86     do
       87     on error undo, return error return-value
       88     :
       89       if  valid-handle(v-vssrevis-logger)
       90       and v-vssrevis-logger :get-signature("logevent") <> ""
       91       then do:
       92         run vss-get-parameters in this-procedure
       93           (output v-vssrevis-parameters
       94           ).
       95         run logevent in v-vssrevis-logger
       96           (input vss-workfile
       97           ,input vss-revision
       98           ,input v-vssrevis-parameters
       99           ,input p-extra-paramters
      100           ).
      101       end.
      102     end.
      103   end procedure.
      104   assign
      105     v-vssrevis-logger = g#vssrevis-logger
      106   .
      107   if  valid-handle(v-vssrevis-logger)
      108   and v-vssrevis-logger :get-signature("logevent") <> ""
      109   then do:
      110     assign
      111       v-vssrevis-logevent = true
      112     .
      113     run vss-logevent in this-procedure (input vss-description) .
      114   end.
