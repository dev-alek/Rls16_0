      679   procedure isVolumArticGoods :
      680     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      681     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
      682     define input  parameter p-gds-code as   integer                    no-undo .
      683     define output parameter o-result   as   logical                    no-undo.
      684     do
      685     on error undo, return error
      686     :
      687           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run isVolumArticGoods in g#attr-lib
      688         (input  p-obj-type
      689         ,input  p-obj-code
      690         ,input p-gds-code
      691         ,output o-result
      692         ) no-error .
      693       if error-status :error
      694       then do:
      695         undo, return error return-value .
      696       end.
      697     end.
      698   end procedure.
      699   define variable v-deleted as logical no-undo .
      700   define variable v-err-mess as character no-undo .
      701   define buffer buf_goods-attr for ub.goods-attr.
      702   define buffer buf_goods for ub.goods.
      703   define variable v-num-section            as integer no-undo.
      704   _main:
      705   do
      706   on error undo, return error return-value
      707   :
      708     find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
      709     if not available buf_goods then do:
      710       undo, return error substitute("&1 &2 &3&4Не найден товар с кодом &5"
      711                                    , vss-workfile
      712                                    , vss-revision
      713                                    , vss-description
      714                                    , chr(10)
      715                                    , p-gds-code).
      716     end.
      717     FOR EACH tt0-goods-attr where tt0-goods-attr.grp ne yes:
      718       if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
      719         find FIRST buf_goods-attr WHERE buf_goods-attr.gds-code = p-gds-code
      720         AND buf_goods-attr.attr-code = tt0-goods-attr.attr-code no-error.
      721       end.
      722       IF p-mode = 'ДОБАВЛЕНИЕ':U
      723       or not available buf_goods-attr
      724       or buf_goods-attr.attr-value <> tt0-goods-attr.attr-value THEN DO:
      725         run gds-attr-write IN THIS-PROCEDURE(
      726                                              input p-gds-code
      727                                             ,INPUT tt0-goods-attr.attr-code
      728                                             ,INPUT tt0-goods-attr.attr-value) NO-ERROR.
      729         IF ERROR-STATUS:ERROR THEN DO:
      730           assign
      731           v-err-mess = substitute("Ошибка при сохранении атрибута товара &1 &2 :&3&4 &5"
      732                                   , p-gds-code
      733                                   , tt0-goods-attr.attr-code
      734                                   , chr(10)
      735                                   ,error-status:get-message(1)
      736                                   ,return-value).
      737           undo _main, return error v-err-mess.
      738         END.
      739       END.
      740     END.
      741     if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
      742       FOR EACH buf_goods-attr where buf_goods-attr.gds-code = p-gds-code:
      743           v-num-section = ?.
      744           FIND FIRST tt0-goods-attr NO-LOCK WHERE
      745               tt0-goods-attr.gds-code = p-gds-code
      746           AND tt0-goods-attr.attr-code = buf_goods-attr.attr-code
      747           and tt0-goods-attr.grp ne yes NO-ERROR.
      748             IF NOT AVAILABLE tt0-goods-attr THEN DO:
      749                   run gds-attr-manual-edit in this-procedure (input buf_goods-attr.attr-code
      750                                                          , output v-num-section) no-error.
      751                   IF       error-status:error
      752                       and  buf_goods-attr.attr-code ne 'lock':U
      753                   THEN DO:
      754                     assign
      755                     v-err-mess = substitute("Ошибка при удалении атрибута товара &1 &2 :&3&4 &5"
      756                                             , p-gds-code
      757                                             , buf_goods-attr.attr-code
      758                                             , chr(10)
      759                                             ,error-status:get-message(1)
      760                                             ,return-value
      761                                             ).
      762                     undo _main, return error v-err-mess.
      763                   END.
      764              if v-num-section > 0 then do:
      765                     ASSIGN
      766                     v-deleted = NO.
      767                     RUN gds-attr-delete IN THIS-PROCEDURE (
      768                                                           input buf_goods-attr.gds-code
      769                                                           ,INPUT buf_goods-attr.attr-code
      770                                                           ,output v-deleted ) NO-ERROR.
      771                   IF NOT v-deleted
      772                   or error-status:error
      773                   THEN DO:
      774                     assign
      775                     v-err-mess = substitute("Ошибка при удалении атрибута товара &1 &2 :&3&4 &5"
      776                                             , p-gds-code
      777                                             , buf_goods-attr.attr-code
      778                                             , chr(10)
      779                                             ,error-status:get-message(1)
      780                                             ,return-value
      781                                             ).
      782                     undo _main, return error v-err-mess.
      783                   END.
      784               end.
      785             END.
      786       END.
      787     end.
      788   end.
