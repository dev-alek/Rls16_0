     1080   FIELD fact-order like ub.tax-rate-value.fact-order
     1081   FIELD next-order like ub.tax-rate-value.fact-order
     1082   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
     1083   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
     1084   FIELD corr-date like ub.tax-rate-gds.corr-date
