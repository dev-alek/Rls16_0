     2753         buf_goods.nationality   = par-nationality
     2754         buf_goods.fbr-grp-code  = par-fbr-grp-code
     2755         v-gds-rec = recid (buf_goods)
     2756         .
     2757         RUN grplib-get-full-name in this-procedure (input buf_gds-grp.node-code, output buf_goods.grp-name).
     2758         run ref/dtaxgdsu.p (
     2759                        input (if par-single-record then yes else no)
     2760                       ,input par-host-code
     2761                       ,input par-obj-type
     2762                       ,input par-obj-code
     2763                       ,input v-gds-rec
     2764                       ,input (if par-copymode then for-goods.gds-code else 0)
     2765                       ) no-error.
     2766         if error-status:error then do:
     2767           run do-message in this-procedure(
