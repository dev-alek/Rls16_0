       28   define input parameter par-unit-base like ub.goods.unit-base no-undo .
       29   define input parameter par-unit-cli like ub.goods.unit-cli no-undo .
       30   define input parameter par-max-rate like ub.goods.max-rate no-undo .
       31   define input parameter par-min-rate like ub.goods.min-rate no-undo .
       32   define input parameter par-cli-base-rate like ub.goods.cli-base-rate no-undo .
       33   define input parameter par-qnty-cart like ub.goods.qnty-cart no-undo .
       34   define input parameter par-ms-base like ub.goods.ms-base no-undo .
       35   define input parameter par-wt-base like ub.goods.wt-base no-undo .
       36   define input parameter par-ms-cart like ub.goods.ms-cart no-undo .
       37   define input parameter par-wt-cart like ub.goods.wt-cart no-undo .
       38   define input parameter par-calc-method like ub.goods.calc-method no-undo .
       39   define input parameter par-increase-pc like ub.goods.increase-pc no-undo .
       40   define input parameter par-NegRest as logical no-undo .
       41   define input parameter par-obj-price-base like ub.gds-obj.price-base no-undo .
       42   define input parameter par-obj-price-rubl like ub.gds-obj.price-rubl no-undo .
       43   define input parameter par-okdp like ub.goods.okdp no-undo .
       44   define input parameter par-destin like ub.goods.destin no-undo .
       45   define input parameter par-attrib like ub.goods.attrib  no-undo .
       46   define input parameter par-user-rule like ub.goods.user-rule no-undo .
       47   define input parameter par-sert like ub.goods.sert no-undo .
       48   define input parameter par-struct like ub.goods.struct no-undo .
       49   define input parameter par-deadline like ub.goods.deadline no-undo .
       50   define input parameter par-cond-keep-code like ub.goods.cond-keep-code no-undo .
       51   define input parameter par-sort like ub.goods.sort no-undo .
       52   define input parameter par-proof like ub.goods.proof no-undo .
       53   define input parameter par-normal-wastage like ub.goods.normal-wastage no-undo .
       54   define input parameter par-normal-waste like ub.goods.normal-waste no-undo .
       55   define input parameter par-tnved like ub.goods.tnved no-undo .
       56   define input parameter par-nationality like ub.goods.nationality no-undo .
       57   define input parameter par-unit-cst like ub.goods.unit-cst no-undo .
       58   define input parameter par-cst-base-rate like ub.goods.cst-base-rate no-undo .
       59   define input parameter par-fbr-grp-code like ub.goods.fbr-grp-code no-undo .
       60   define input parameter par-PS like ub.goods.ps no-undo .
       61   define input parameter par-unq-artc as logical no-undo .
       62   define input parameter par-is-jwlr   as logical no-undo .
       63   define input parameter par-is-bttl  as logical no-undo .
       64   define input parameter par-is-ptrl  as logical no-undo .
       65   define input parameter par-custvalue as character no-undo .
       66   define input parameter par-dif-nam1 as logical no-undo .
       67   define input parameter par-dif-nam2 as logical no-undo .
       68   define input parameter par-ArtDis as logical no-undo .
       69   define input parameter par-BarDis as integer no-undo .
       70   define input-output parameter par-rec as recid no-undo .
       71   define output parameter par-nbc like ub.bar-code.b-code no-undo .
       72   define variable vss-revision    as character no-undo init "$Revision: f5e72f13272f, 2363, rls $":U .
       73   define variable vss-author      as character no-undo init "$Author: druban $":U .
       74   define variable vss-date        as character no-undo init "$Date: 2020/06/10 18:13:42 $":U .
       75   define variable vss-workfile    as character no-undo init "$Workfile: goods01.p $":U .
       76   define variable vss-archive     as character no-undo init "$Archive: ref/goods01.p $":U .
       77   define variable vss-description as character no-undo init "Проверка и создание goods".
       78   procedure vss-get-info :
       79     define output parameter p-vss-revision    like vss-revision    no-undo .
       80     define output parameter p-vss-author      like vss-author      no-undo .
       81     define output parameter p-vss-date        like vss-date        no-undo .
       82     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       83     define output parameter p-vss-archive     like vss-archive     no-undo .
       84     define output parameter p-vss-description like vss-description no-undo .
       85     assign
       86       p-vss-revision    = vss-revision
       87       p-vss-author      = vss-author
       88       p-vss-date        = vss-date
       89       p-vss-workfile    = vss-workfile
       90       p-vss-archive     = vss-archive
       91       p-vss-description = vss-description
       92     .
       93   end procedure.
       94   procedure vss-get-parameters :
       95     define output parameter p-vss-parameters as character no-undo .
       96   end procedure.
       97   define new global shared variable g#vssrevis-logger as handle    no-undo .
       98   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       99   define variable v-vssrevis-logger                   as handle    no-undo .
      100   procedure vss-logevent :
      101     define input  parameter p-extra-paramters as character no-undo .
      102     define variable v-vssrevis-parameters as character no-undo .
      103     do
      104     on error undo, return error return-value
      105     :
      106       if  valid-handle(v-vssrevis-logger)
      107       and v-vssrevis-logger :get-signature("logevent") <> ""
      108       then do:
      109         run vss-get-parameters in this-procedure
      110           (output v-vssrevis-parameters
      111           ).
      112         run logevent in v-vssrevis-logger
      113           (input vss-workfile
      114           ,input vss-revision
      115           ,input v-vssrevis-parameters
      116           ,input p-extra-paramters
      117           ).
      118       end.
      119     end.
      120   end procedure.
      121   assign
      122     v-vssrevis-logger = g#vssrevis-logger
      123   .
      124   if  valid-handle(v-vssrevis-logger)
      125   and v-vssrevis-logger :get-signature("logevent") <> ""
      126   then do:
      127     assign
      128       v-vssrevis-logevent = true
      129     .
      130     run vss-logevent in this-procedure (input vss-description) .
      131   end.
      132   define new global shared variable g#language as character no-undo .
      133   if g#language <> '' and g#language <> 'rus':U then do:
      134     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      135   end.
      136   define new global shared variable g#library  as handle no-undo .
      137   define new global shared variable g#library2 as handle no-undo .
      138   define   shared variable g#auto as logical no-undo.
      139   define   shared variable g#news as logical no-undo.
      140   define   shared variable g#oxml as logical no-undo.
      141   define   shared variable g#esys as logical no-undo.
      142   define   shared variable g#news-source-db as integer no-undo.
      143   define   shared variable g#esys-source-esys as integer no-undo.
      144   define   shared variable g#db-num as integer   no-undo .
      145   define   shared variable g#userid as character no-undo .
      146   define   shared variable g#passwd as character no-undo .
      147   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      148   DEFINE  SHARED TEMP-TABLE TT-tnved NO-UNDO
      149   FIELD tnved  AS CHAR FORMAT "X(10)"  LABEL 'Код ТНВЭД':U
      150   FIELD f-name AS CHAR FORMAT "X(255)" LABEL 'Полное наименование':U
      151   INDEX tnved IS UNIQUE PRIMARY  tnved.
      152   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      153   procedure gen-b-code :
      154     define input  parameter type-code like ub.code-range.range-type no-undo .
      155     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      156     do
      157     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      158     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      159     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      160     :
      161       define buffer buf_thbj-attr     for ub.thbj-attr .
      162       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      163       define buffer buf_code-range for ub.code-range .
      164       define variable l-code         as   integer              no-undo .
      165       define variable v-db-num       like ub.db.db-num         no-undo .
      166       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      167       if type-code = 'sslc':U
      168       or type-code = 'ssgb':U
      169       then do:
      170         message
      171           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      172           "Обратитесь к администратору системы."
      173           view-as alert-box error .
      174         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      175       end.
      176       run trg/getpcode.p ( input  type-code
      177                      ,output cfg-param-code
      178                     ).
      179       run get-next-seq( input  type-code,
      180                         output l-code
      181                       ).
      182       find first buf_sys-ctrl no-lock.
      183       if type-code = 'sclc':U
      184       or type-code = 'pglc':U
      185       then do:
      186         assign
      187           v-db-num = 0
      188         .
      189       end.
      190       else do:
      191         assign
      192           v-db-num = buf_sys-ctrl.db-num
      193         .
      194       end.
      195       find first buf_code-range no-lock
      196         where buf_code-range.db-num     = v-db-num
      197           and buf_code-range.range-type = type-code
      198           and buf_code-range.stts       = "a"
      199         use-index stts
      200         no-error .
      201       if available buf_code-range
      202          and l-code <= buf_code-range.last-code
      203          and l-code >= buf_code-range.first-code then do:
      204         assign
      205           p-b-code = l-code
      206         .
      207       end.
      208       else do:
      209         if available buf_code-range
      210            and l-code < buf_code-range.last-code then do:
      211           message
      212             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      213             "Обратитесь к администратору системы."
      214             view-as alert-box error .
      215           undo, return error "sequence":U .
      216         end.
      217         do transaction
      218         on error undo, return error
      219         :
      220           find first buf_thbj-attr exclusive-lock
      221             where buf_thbj-attr.upper-prop-code = 'code-range':U
      222               and buf_thbj-attr.prop-code = cfg-param-code
      223               and buf_thbj-attr.obj-type   = 'БД':U
      224               and buf_thbj-attr.obj-code   = v-db-num
      225             no-error .
      226           if not available buf_thbj-attr then do:
      227             find first buf_thbj-attr exclusive-lock
      228               where buf_thbj-attr.upper-prop-code = 'code-range':U
      229                 and buf_thbj-attr.prop-code = cfg-param-code
      230                 and buf_thbj-attr.obj-type   = ''
      231                 and buf_thbj-attr.obj-code   = 0
      232               no-error .
      233             if not available buf_thbj-attr then do:
      234               if not locked buf_thbj-attr then do:
      235                 message
      236                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      237                   "Обратитесь к администратору системы."
      238                   view-as alert-box error .
      239               end.
      240               undo, return error "config":U .
      241             end.
      242           end.
      243           run get-next-seq( input type-code,
      244                             output l-code
      245                           ).
      246           find first buf_code-range
      247             where buf_code-range.db-num     = v-db-num
      248               and buf_code-range.range-type = type-code
      249               and buf_code-range.stts       = "a"
      250             use-index stts
      251             no-error .
      252           if available buf_code-range
      253           and l-code <= buf_code-range.last-code
      254           and l-code >= buf_code-range.first-code
      255           then do:
      256             assign
      257               p-b-code = l-code
      258             .
      259           end.
      260           else do:
      261             if available buf_code-range then do:
      262               assign
      263                 buf_code-range.stts = "u"
      264               .
      265             end.
      266             find first buf_code-range
      267               where buf_code-range.db-num     = v-db-num
      268                 and buf_code-range.range-type = type-code
      269                 and buf_code-range.stts       = "f"
      270               use-index stts
      271               no-error .
      272             if not available buf_code-range then do:
      273               message
      274                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      275                 "Обратитесь к администратору системы"
      276                 view-as alert-box error .
      277               undo, return error "code-range":U .
      278             end.
      279             assign
      280               buf_code-range.stts           = "a"
      281             .
      282             if buf_code-range.first-code = 1 then do:
      283               run set-seq-cr( input type-code,
      284                               input buf_code-range.first-code
      285                             ).
      286               assign
      287                 p-b-code = 1
      288               .
      289             end.
      290             else do:
      291               run set-seq-cr( input type-code,
      292                               input ( buf_code-range.first-code - 1 )
      293                             ).
      294               run get-next-seq( input type-code,
      295                                 output p-b-code
      296                               ).
      297             end.
      298           end.
      299         end.
      300       end.
      301     end.
      302   end procedure.
      303   procedure get-next-seq :
      304     define input  parameter type-code like ub.code-range.range-type no-undo .
      305     define output parameter next-seq  as   integer                  no-undo .
      306     do
      307     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      308     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      309     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      310     :
      311       case type-code:
      312         when 'bcgb':U then do:
      313           assign
      314             next-seq = next-value(s-bcgb-code, ub)
      315           .
      316         end.
      317         when 'scgb':U then do:
      318           assign
      319             next-seq = next-value(s-scgb-code, ub)
      320           .
      321         end.
      322         when 'sclc':U then do:
      323           assign
      324             next-seq = next-value(s-sclc-code, ub)
      325           .
      326         end.
      327         when 'pglc':U then do:
      328           assign
      329             next-seq = next-value(s-pglc-code, ub)
      330           .
      331         end.
      332         when 'dcgb':U then do:
      333           assign
      334             next-seq = next-value(s-dcgb-code, ub)
      335           .
      336         end.
      337         when 'ctgb':U then do:
      338           assign
      339             next-seq = next-value(s-ctgb-code, ub)
      340           .
      341         end.
      342         when 'drgb':U then do:
      343           assign
      344             next-seq = next-value(s-drgb-code, ub)
      345           .
      346         end.
      347         when 'fmgb':U then do:
      348           assign
      349             next-seq = next-value(s-fmgb-code, ub)
      350           .
      351         end.
      352         when 'pngb':U then do:
      353           assign
      354             next-seq = next-value(s-pngb-code, ub)
      355           .
      356         end.
      357         when 'cagb':U then do:
      358           assign
      359             next-seq = next-value(s-cagb-code, ub)
      360           .
      361         end.
      362         when 'fdgb':U then do:
      363           assign
      364             next-seq = next-value(s-fin-doc, ub)
      365           .
      366         end.
      367       end case.
      368     end.
      369   end procedure.
      370   procedure set-seq-cr :
      371     define input parameter type-code like ub.code-range.range-type no-undo .
      372     define input parameter set-val   like ub.code-range.first-code no-undo .
      373     do
      374     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      375     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      376     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      377     :
      378       case type-code:
      379         when 'bcgb':U then do:
      380           assign
      381             current-value(s-bcgb-code, ub) = set-val
      382           .
      383         end.
      384         when 'scgb':U then do:
      385           assign
      386             current-value(s-scgb-code, ub) = set-val
      387           .
      388         end.
      389         when 'sclc':U then do:
      390           assign
      391             current-value(s-sclc-code, ub) = set-val
      392           .
      393         end.
      394         when 'pglc':U then do:
      395           assign
      396             current-value(s-pglc-code, ub) = set-val
      397           .
      398         end.
      399         when 'dcgb':U then do:
      400           assign
      401             current-value(s-dcgb-code, ub) = set-val
      402           .
      403         end.
      404         when 'ctgb':U then do:
      405           assign
      406             current-value(s-ctgb-code, ub) = set-val
      407           .
      408         end.
      409         when 'drgb':U then do:
      410           assign
      411             current-value(s-drgb-code, ub) = set-val
      412           .
      413         end.
      414         when 'fmgb':U then do:
      415           assign
      416             current-value(s-fmgb-code, ub) = set-val
      417           .
      418         end.
      419         when 'pngb':U then do:
      420           assign
      421             current-value(s-pngb-code, ub) = set-val
      422           .
      423         end.
      424         when 'cagb':U then do:
      425           assign
      426             current-value(s-cagb-code, ub) = set-val
      427           .
      428         end.
      429         when 'fdgb':U then do:
      430           assign
      431             current-value(s-fin-doc, ub) = set-val
      432           .
      433         end.
      434       end case.
      435     end.
      436   end procedure.
      437   procedure new-bcod-gen-code-range :
      438     do
      439     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      440     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      441     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      442     :
      443       define input parameter p-db-num  like ub.db.db-num             no-undo .
      444       define input parameter type-code like ub.code-range.range-type no-undo .
      445       define buffer buf_code-range      for ub.code-range .
      446       define buffer last_code-range     for ub.code-range .
      447       define buffer last-1_code-range   for ub.code-range .
      448       define buffer last-2_code-range   for ub.code-range .
      449       define buffer last-3_code-range   for ub.code-range .
      450       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      451       define variable conf-par       as character no-undo .
      452       define variable par-type       as character no-undo .
      453       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      454       define variable v-cre-cdrg as logical   no-undo .
      455       define variable v-cre-str  as character no-undo .
      456       define variable v-cr1      as integer no-undo .
      457       define variable v-cr2      as integer no-undo .
      458       define variable v-cr3      as integer no-undo .
      459       define variable v-cmax     as integer no-undo .
      460       find first buf_sys-ctrl no-lock .
      461       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      462         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      463                                       ,vss-workfile
      464                                       ,vss-revision
      465                                       ,vss-description
      466                                       ,chr(10)
      467                                       , p-db-num
      468                                      ).
      469       end.
      470       run trg/getpcode.p ( input  type-code
      471                      ,output cfg-param-code
      472                     ).
      473       for each buf_code-range
      474         where buf_code-range.db-num     = -1
      475           and buf_code-range.range-type = type-code
      476           and buf_code-range.stts       = "f"
      477       by buf_code-range.first-code
      478       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      479       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      480       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      481       :
      482         assign
      483           buf_code-range.db-num = p-db-num
      484         .
      485         return .
      486       end.
      487       assign
      488         v-cre-cdrg = TRUE
      489       .
      490       case type-code:
      491         when 'sclc':U
      492         or when 'scgb':U
      493         or when 'pglc':U
      494         then do:
      495           find last last-1_code-range no-lock
      496             where last-1_code-range.range-type = 'sclc':U
      497             no-error .
      498           if available last-1_code-range then do:
      499             v-cr1 = last-1_code-range.last-code.
      500           end.
      501           find last last-2_code-range no-lock
      502             where last-2_code-range.range-type = 'scgb':U
      503             no-error .
      504           if available last-2_code-range then do:
      505             v-cr2 = last-2_code-range.last-code.
      506             end.
      507           find last last-3_code-range no-lock
      508             where last-3_code-range.range-type = 'pglc':U
      509             no-error .
      510           if available last-3_code-range then do:
      511             v-cr3 = last-3_code-range.last-code.
      512           end.
      513           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      514           .
      515           if v-cmax = v-cr1  then do:
      516               find last last_code-range no-lock
      517                 where recid( last_code-range ) = recid( last-1_code-range )
      518                 .
      519             end.
      520           if v-cmax = v-cr2  then do:
      521               find last last_code-range no-lock
      522                 where recid( last_code-range ) = recid( last-2_code-range )
      523                 .
      524             end.
      525           if v-cmax = v-cr3  then do:
      526             find last last_code-range no-lock
      527               where recid( last_code-range ) = recid( last-3_code-range )
      528               .
      529           end.
      530           if last_code-range.last-code + 1 > 99999 then do:
      531             assign
      532               v-cre-cdrg = FALSE
      533             .
      534           end.
      535         end.
      536         when 'bcgb':U
      537         or when 'sslc':U
      538         or when 'ssgb':U
      539         then do:
      540           find last last-1_code-range no-lock
      541             where last-1_code-range.range-type = 'sslc':U
      542             no-error .
      543           if available last-1_code-range then do:
      544             v-cr1 = last-1_code-range.last-code.
      545           end.
      546           find last last-2_code-range no-lock
      547             where last-2_code-range.range-type = 'bcgb':U
      548             no-error .
      549           if available last-2_code-range then do:
      550             v-cr2 = last-2_code-range.last-code.
      551             end.
      552           find last last-3_code-range no-lock
      553             where last-3_code-range.range-type = 'ssgb':U
      554             no-error .
      555           if available last-3_code-range then do:
      556             v-cr3 = last-3_code-range.last-code.
      557           end.
      558           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      559           .
      560           if v-cmax = v-cr1  then do:
      561               find last last_code-range no-lock
      562                 where recid( last_code-range ) = recid( last-1_code-range )
      563                 .
      564             end.
      565           if v-cmax = v-cr2  then do:
      566               find last last_code-range no-lock
      567                 where recid( last_code-range ) = recid( last-2_code-range )
      568                 .
      569             end.
      570           if v-cmax = v-cr3  then do:
      571             find last last_code-range no-lock
      572               where recid( last_code-range ) = recid( last-3_code-range )
      573               .
      574           end.
      575         end.
      576         otherwise do:
      577           find last last_code-range no-lock
      578             where last_code-range.range-type = type-code
      579             no-error .
      580         end.
      581       end case.
      582       if not available last_code-range then do:
      583         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      584                                       ,vss-workfile
      585                                       ,vss-revision
      586                                       ,vss-description
      587                                       , chr(10)
      588                                       , type-code
      589                                      ) .
      590       end.
      591       define variable v-mes1 as character no-undo .
      592       define variable v-param-type1 as character no-undo .
      593       define variable v-value-character1 as INTEGER no-undo .
      594       define variable v-value-date1 as date no-undo .
      595       define variable v-value-decimal1 as decimal no-undo .
      596       define variable v-value-integer1 AS integer no-undo .
      597       define variable v-value-logical1 AS LOGICAL no-undo .
      598       define variable v-tth1 as handle no-undo .
      599       run adm/shattri.p (
      600           input "get":U
      601           ,input  'БД':U
      602           ,input  p-db-num
      603           ,input  'code-range':U
      604           ,input  cfg-param-code
      605           ,output v-value-character1
      606           ,output v-value-date1
      607           ,output v-value-decimal1
      608           ,output v-value-integer1
      609           ,output v-value-logical1
      610           ,output v-param-type1
      611           ,INPUT-OUTPUT table-handle v-tth1
      612           ) no-error .
      613       if error-status :error then do:
      614         delete object v-tth1.
      615         v-mes1 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      616                            , error-status:get-message(1)
      617                            , chr(10)
      618                            , return-value ).
      619         undo, return error v-mes1.
      620       end.
      621       delete object v-tth1.
      622       if v-cre-cdrg = TRUE then do:
      623         create buf_code-range .
      624         assign
      625           buf_code-range.db-num     = p-db-num
      626           buf_code-range.range-type = type-code
      627           buf_code-range.stts       = "f"
      628           buf_code-range.first-code = last_code-range.last-code + 1
      629           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer1)
      630           v-cre-str = "Свободный диапазон успешно создан"
      631         .
      632       end.
      633       else do:
      634         assign
      635           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      636                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      637         .
      638       end.
      639     end.
      640     return v-cre-str .
      641   end procedure.
      642   procedure gen-new-code-range-if-neces :
      643     define input parameter v-db-num           like ub.db.db-num             no-undo .
      644     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      645     define input parameter v-cur-code         as   integer                  no-undo .
      646     define input parameter v-g#news           as   logical                  no-undo .
      647     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      648     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      649     do
      650     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      651     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      652     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      653     :
      654       define variable l-code-range-exist as logical   no-undo init false .
      655       define variable v-db-for-send      as character no-undo .
      656       define buffer buf_code-range  for ub.code-range .
      657       define buffer buf1_code-range for ub.code-range .
      658       define buffer buf_db          for ub.db .
      659       find first buf_code-range
      660         where buf_code-range.range-type = v-range-type
      661           and buf_code-range.last-code >= v-cur-code
      662         use-index last-codei
      663         no-error .
      664       if
      665       (
      666          available buf_code-range
      667          and
      668         (buf_code-range.db-num = v-db-num
      669           and
      670         buf_code-range.first-code <= v-cur-code
      671         )
      672       or
      673         (
      674           v-range-type = 'drgb':U
      675           AND
      676           v-cur-code = 0
      677         )
      678      )
      679      then do:
      680         assign
      681           l-code-range-exist = true
      682         .
      683         if v-g#news
      684         and buf_code-range.stts = "f" then do:
      685           assign
      686             buf_code-range.stts = "u"
      687           .
      688         end.
      689       end.
      690       if not l-code-range-exist
      691          and v-g#news-source-db <> 0
      692       then do:
      693         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      694                                       ,vss-workfile
      695                                       ,vss-revision
      696                                       ,vss-description
      697                                       ,chr(10)
      698                                       ,v-db-num
      699                                       ,v-range-type
      700                                       ,v-cur-code
      701                                      ).
      702       end.
      703       if (not l-code-range-exist
      704           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      705          )
      706       and ( not can-find (first buf1_code-range no-lock
      707                           where buf1_code-range.db-num = v-db-num
      708                             and buf1_code-range.range-type = v-range-type
      709                             and buf1_code-range.stts = "f"
      710                          )
      711           )
      712       then do:
      713         if v-g#db-num = 0 then do:
      714           run new-bcod-gen-code-range in this-procedure
      715             (input v-db-num,
      716              input v-range-type
      717             ) no-error .
      718           if error-status :error then do:
      719             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      720                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      721                                           ,v-db-num
      722                                           ,v-range-type
      723                                           ,v-cur-code
      724                                           ,chr(10)
      725                                           ,error-status:get-message(1)
      726                                           ,return-value
      727                                          ).
      728           end.
      729         end.
      730         else do:
      731           if v-range-type = 'sclc':U
      732           or v-range-type = 'pglc':U
      733           then do:
      734             assign
      735               v-db-for-send = "":U
      736             .
      737             if v-g#db-num = 0 then do:
      738               for each buf_db no-lock
      739                 where buf_db.db-num > 0
      740                   and buf_db.db-num <> v-g#news-source-db
      741               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      742               :
      743                 assign
      744                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      745                 .
      746               end.
      747               assign
      748                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      749               .
      750             end.
      751             else do:
      752               if not v-g#news then do:
      753                 assign
      754                   v-db-for-send = "0":U
      755                 .
      756               end.
      757             end.
      758             run nws/cr-route.p ( input 'send-cmd':U
      759                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      760                                  "code-range":U + chr(1) +
      761                                  (if v-range-type = 'sclc':U
      762                                   then string( current-value(s-sclc-code, ub))
      763                                   else string( current-value(s-pglc-code, ub))
      764                                   ) + chr(1) +
      765                                   v-range-type)
      766                           ,input ?
      767                           ,input v-db-for-send
      768                           ) no-error .
      769             if error-status :error then do:
      770               undo, return error return-value.
      771             end.
      772           end.
      773         end.
      774       end.
      775     end.
      776   end procedure.
      777   procedure cre-loc-sc-code-range :
      778     define input parameter v-cur-code as integer no-undo .
      779   define input parameter p-cdrg-type as character no-undo .
      780     do
      781     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      782     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      783     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      784     :
      785       define buffer buf_code-range for ub.code-range .
      786       find first buf_code-range
      787            where buf_code-range.range-type = p-cdrg-type
      788              and buf_code-range.first-code >= v-cur-code
      789            no-error .
      790       if not available buf_code-range then do:
      791         run new-bcod-gen-code-range in this-procedure
      792           ( input 0,
      793             input p-cdrg-type
      794           ) no-error .
      795         if error-status :error then do:
      796           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      797                                          + "Код &2&1&3 &4"
      798                                         , chr(10)
      799                                         , v-cur-code
      800                                         , error-status:get-message(1)
      801                                         , return-value
      802                                        ) .
      803         end.
      804       end.
      805     end.
      806   end procedure.
      807   procedure mark-used-if-need :
      808   define input parameter p-cur-code as integer no-undo .
      809   define input parameter p-range-type like ub.code-range.range-type no-undo .
      810   define input parameter p-db-num like ub.code-range.db-num no-undo .
      811     do
      812     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      813     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      814     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      815     :
      816       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      817       define buffer buf_code-range for ub.code-range .
      818       assign
      819       v-db-num = if p-range-type = 'sclc':U
      820                  then 0
      821                  else p-db-num
      822       .
      823   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      824   define buffer locK-batchprocess2 for ub.batchprocess.
      825   run gbl/lock-prc.p
      826       (input 'lscc':U
      827       ,input 0
      828       ,input 0
      829       ,input 0
      830       ,input ""
      831       ,input ""
      832       ,input ""
      833       ,input (
      834               ",,,Вкл/выкл лок. вес. кодов"
      835              )
      836       ,input true
      837       ,buffer lock-batchprocess2
      838       ) no-error .
      839     if error-status :error then do:
      840       message
      841         vss-workfile vss-revision vss-description skip
      842         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      843         view-as alert-box error .
      844       undo, return error .
      845     end.
      846       find first buf_code-range
      847            where buf_code-range.range-type = p-range-type
      848              and buf_code-range.first-code >= p-cur-code
      849              and buf_code-range.last-code <= p-cur-code
      850              and buf_code-range.db-num = v-db-num
      851            no-error .
      852       if not available buf_code-range then do:
      853         message
      854           vss-workfile vss-revision vss-description skip
      855           "Ошибка при создании поиске диапазона" skip
      856           "База данных" p-db-num skip
      857           "Код" p-cur-code skip
      858           "Тип" p-range-type
      859           error-status :get-message(1) skip
      860           return-value skip
      861           view-as alert-box error .
      862         undo, return error .
      863       end.
      864       if buf_code-range.stts = "f":U then do:
      865         assign
      866         buf_code-range.stts = "u":U
      867         .
      868       end.
      869     end.
      870   end procedure.
      871   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      872   procedure chk-b-code:
      873   define input parameter p-silence as logical no-undo .
      874   define input param b-c like ub.bar-code.b-code no-undo.
      875   define output param p-log as log no-undo.
      876     define variable l-code as integer no-undo.
      877     define variable v-mes as character no-undo .
      878     define variable v-param-type3 as character no-undo .
      879     define variable v-value-character3 as INTEGER no-undo .
      880     define variable v-value-date3 as date no-undo .
      881     define variable v-value-decimal3 as decimal no-undo .
      882     define variable v-value-integer3 AS integer no-undo .
      883     define variable v-value-logical3 AS LOGICAL no-undo .
      884     define variable v-tth3 as handle no-undo .
      885     define buffer buf_sys-ctrl for ub.sys-ctrl.
      886     define buffer b-c-r for ub.code-range.
      887     define buffer buf_code-range for ub.code-range .
      888     do
      889     on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      890     on stop   undo , return error substitute( "&1. stop", vss-workfile )
      891     on endkey undo , return error substitute( "&1. endkey", vss-workfile )
      892     :
      893       find first buf_sys-ctrl no-lock.
      894       p-log = no.
      895       run adm/shattri.p (
      896           input "get":U
      897           ,input  'БД':U
      898           ,input  buf_sys-ctrl.db-num
      899           ,input  'code-range':U
      900           ,input  'cdrgbcgb':U
      901           ,output v-value-character3
      902           ,output v-value-date3
      903           ,output v-value-decimal3
      904           ,output v-value-integer3
      905           ,output v-value-logical3
      906           ,output v-param-type3
      907           ,INPUT-OUTPUT table-handle v-tth3
      908           ) no-error .
      909       if error-status :error then do:
      910         delete object v-tth3.
      911         v-mes = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      912                            , error-status:get-message(1)
      913                            , chr(10)
      914                            , return-value ).
      915         if not p-silence then
      916         message
      917         v-mes
      918         view-as alert-box error.
      919         p-log = no.
      920         undo, return error v-mes.
      921       end.
      922       delete object v-tth3.
      923       find first buf_code-range
      924         where buf_code-range.range-type = 'bcgb':U
      925           and buf_code-range.last-code >= b-c
      926           and buf_code-range.db-num = g#db-num
      927       use-index last-codei
      928     no-lock no-error .
      929       if available buf_code-range and buf_code-range.first-code <= b-c then do:
      930         case buf_code-range.stts:
      931         when "a" then do:
      932             if buf_code-range.db-num <> buf_sys-ctrl.db-num then do:
      933             assign
      934             v-mes = substitute("Нельзя использовать активный диапазон чужой БД для генерации бар-кодов в БД").
      935             if not p-silence then
      936             message v-mes
      937             view-as alert-box error.
      938             p-log = no.
      939             undo, return error v-mes.
      940           end.
      941           p-log = yes.
      942         end.
      943         when "f" then do:
      944             if buf_code-range.db-num = -1
      945             or buf_code-range.db-num <> buf_sys-ctrl.db-num
      946             then do:
      947             assign
      948               v-mes = substitute("Нельзя использовать свободный диапазон БД для генерации бар-кодов:&1" +
      949                                  "текущая БД &2, диапазон (&3 - &4) для БД &5&1"
      950                                  ,chr(10)
      951                                  ,buf_sys-ctrl.db-num
      952                                  ,buf_code-range.first-code
      953                                  ,buf_code-range.last-code
      954                                  ,buf_code-range.db-num
      955                                  ).
      956             if not p-silence then
      957             message v-mes
      958             view-as alert-box error.
      959             p-log = no.
      960             undo, return error v-mes .
      961           end.
      962             find b-c-r where recid(b-c-r) = recid(buf_code-range) exclusive no-error.
      963           if (not available b-c-r) or (b-c-r.db-num <> buf_sys-ctrl.db-num) then do:
      964             p-log = no.
      965             undo, return error.
      966           end.
      967           assign
      968             b-c-r.stts = "u"
      969               b-c-r.db-num = buf_sys-ctrl.db-num
      970             p-log = yes.
      971         end.
      972         when "u" then do:
      973             if (buf_code-range.db-num > 0 and buf_sys-ctrl.db-num = 0) or
      974                (buf_sys-ctrl.db-num <> 0 and buf_code-range.db-num <> buf_sys-ctrl.db-num)  then do:
      975             assign
      976             v-mes = substitute("Нельзя использовать использованный чужой диапазон БД для генерации бар-кодов в БД").
      977             if not p-silence then
      978             message v-mes
      979             view-as alert-box error.
      980             p-log = no.
      981             undo, return error v-mes.
      982           end.
      983           assign
      984             p-log = yes.
      985         end.
      986       end case.
      987     end.
      988       else do:
      989         if buf_sys-ctrl.db-num <> 0 then do:
      990         assign
      991         v-mes = substitute("Нельзя создавать диапазоны в УБД ").
      992         if not p-silence then
      993         message v-mes
      994         view-as alert-box error.
      995         undo, return error v-mes.
      996       end.
      997       find first buf_code-range
      998         where buf_code-range.range-type = 'bcgb':U
      999           and buf_code-range.last-code >= b-c
     1000           and buf_code-range.first-code <= b-c
     1001       no-lock no-error .
     1002       if available buf_code-range
     1003       and buf_code-range.db-num <> g#db-num then do:
     1004         assign
     1005         v-mes = substitute("Диапазон для кода &1 (&2-&3) принадлежит БД &4"
     1006                             , b-c
     1007                             , buf_code-range.first-code
     1008                             , buf_code-range.last-code
     1009                             , buf_code-range.db-num
     1010                     ).
     1011         if not p-silence then
     1012         message v-mes
     1013         view-as alert-box error.
     1014         undo, return error v-mes.
     1015       end.
     1016         _l-code:
     1017         do while true :
     1018           run new-bcod-gen-code-range in this-procedure ( input g#db-num
     1019                                                          ,input 'bcgb':U).
     1020           find first buf_code-range where
     1021             buf_code-range.range-type = 'bcgb':U
     1022               and buf_code-range.db-num = g#db-num
     1023               and buf_code-range.last-code >= b-c
     1024               and buf_code-range.first-code <= b-c  no-lock no-error .
     1025           if available buf_code-range then do:
     1026             find b-c-r where recid(b-c-r) = recid(buf_code-range) exclusive .
     1027             b-c-r.stts = 'u':U.
     1028             p-log = yes.
     1029             leave _l-code.
     1030           end.
     1031       end.
     1032     end.
     1033   end.
     1034   end procedure.
     1035   function cross-list returns logical (
     1036     input parfirst-stream  as character,
     1037     input parsecond-stream as character,
     1038     input pardelim         as character).
     1039     if pardelim = ""
     1040     or pardelim = ?
     1041     then do:
     1042       assign
     1043         pardelim = ","
     1044       .
     1045     end.
     1046     define variable vari            as integer no-undo .
     1047     define variable varresult-cross as logical no-undo .
     1048     assign
     1049       varresult-cross = no
     1050     .
     1051     def var v-num-parfirst-stream as integer no-undo .
     1052     assign
     1053       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
     1054     .
     1055     do vari = 1 to v-num-parfirst-stream
     1056     :
     1057       if lookup(entry(vari, parfirst-stream, pardelim)
     1058                ,parsecond-stream
     1059                ,pardelim
     1060                ) > 0 then do:
     1061         assign
     1062           varresult-cross = yes
     1063         .
     1064         leave.
     1065       end.
     1066     end.
     1067     return varresult-cross .
     1068   end function.
     1069     define SHARED temp-table  tt-tax no-undo
     1070   field tax-code    like ub.tax.tax-code
     1071   FIELD individual  like ub.tax.individual
     1072   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
     1073   field rate-code   like ub.tax-rate.rate-code
     1074   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
     1075   FIELD tax-type    like ub.tax.tax-type
