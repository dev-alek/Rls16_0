     2711         assign
     2712         buf_goods.grp-code    = buf_gds-grp.node-code
     2713         buf_goods.okdp        = par-okdp
     2714         buf_goods.gds-name    = par-gds-name
     2715         buf_goods.engl-name   = par-engl-name
     2716         buf_goods.label-name   = par-label-name
     2717         buf_goods.chk-name   = par-chk-name
     2718         buf_goods.alpha1   = par-alpha1
     2719         buf_goods.prt-root    = buf_gds-prt.upper-code
     2720         buf_goods.unit-cli    = par-unit-cli
     2721         buf_goods.cli-base-rate = par-cli-base-rate
     2722         buf_goods.calc-method  = par-calc-method
     2723         buf_goods.increase-pc   = (if par-calc-method = 'Группа':U then 0 else par-increase-pc)
     2724         buf_goods.qnty-cart = par-qnty-cart
     2725         buf_goods.ms-base = par-ms-base
     2726         buf_goods.wt-base = par-wt-base
     2727         buf_goods.ms-cart = par-ms-cart
     2728         buf_goods.wt-cart = par-wt-cart
     2729         buf_goods.PS      = par-PS
     2730         buf_goods.PS = REPLACE(buf_goods.PS, chr(10), " ")
     2731         buf_goods.grp-name = ""
     2732         buf_goods.negative-rest = par-NegRest
     2733         buf_goods.min-rate = if is-twounit
     2734                               then par-min-rate
