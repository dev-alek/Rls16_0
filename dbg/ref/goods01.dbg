     2408                                                )
     2409                                               ,"error":U
     2410                                               ) no-error .
     2411             if error-status:error then do:
     2412               undo _main, return error return-value.
     2413             end.
     2414           end.
     2415           IF can-FIND(FIRST ub.bar-code No-LOCK WHERE
     2416                             ub.bar-code.b-code = (if par-bardis = 1 then integer(par-artic) else par-gds-code)) OR
     2417             NOT loc#log
     2418           then do:
     2419             run do-message in this-procedure(
     2420                                               par-silence
     2421                                               ,(if par-bardis = 1
     2422                                                 then substitute("Неверный артикул товара &1 при создании товара с кодом=артикулу - уже есть товар с кодом &1 или невозможно сгенерить код &1", par-artic)
     2423                                                 else substitute("Неверный код товара &1 при создании товара с кодом, определенным пользователем - уже есть товар с кодом &1 или невозможно сгенерить код &1", par-gds-code)
     2424                                                )
     2425                                               ,"error":U
     2426                                               ) no-error .
     2427             if error-status:error then do:
     2428               undo _main, return error return-value.
     2429             end.
     2430           end.
     2431         end.
     2432         CREATE buf_goods.
     2433         assign
     2434         buf_goods.gds-type = if is-goods then 'т':U else 'у':U
     2435         buf_goods.artic = ( if par-ArtDis
     2436                             then string( var-AvtArt )
     2437                             else par-artic )
     2438         v-artic                 = buf_goods.artic
     2439         buf_goods.okdp          = par-okdp
     2440         buf_goods.prod-type     = buf_clients.obj-type
     2441         buf_goods.prod-code     = buf_clients.obj-code
     2442         buf_goods.grp-code      = buf_gds-grp.node-code
     2443         buf_goods.gds-name      = par-gds-name
     2444         buf_goods.engl-name     = par-engl-name
     2445         buf_goods.prt-root      = buf_gds-prt.upper-code
