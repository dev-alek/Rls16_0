     1520     ,input  0
     1521     ,input  0
     1522     ,input  'nws-to-hist'
     1523     ,output v-send
     1524     ) no-error .
     1525         if v-send < 0 then return.
     1526       end.
     1527       run cur-time in this-procedure(output v-date, output v-time).
     1528       create buf_c-bar-code.
     1529       if p-action = integer('1':U) then do:
     1530         assign
     1531         buf_c-bar-code.b-code             = buf_bar-code.b-code
     1532         buf_c-bar-code.gds-code           = buf_bar-code.gds-code
     1533         buf_c-bar-code.chip-num           = next-value (s-gds-chip, ub)
     1534         buf_c-bar-code.corr-time          = v-time
     1535         buf_c-bar-code.corr-user-db-num   = g#db-num
     1536         buf_c-bar-code.corr-user-name     = (if g#news
     1537                                             then (chr(4) +  'СПН':U)
     1538                                             else (if g#esys
     1539                                                   then (chr(4) +  'ВС':U)
     1540                                                   else g#userid)
     1541                                             )
     1542         buf_c-bar-code.corr-date          = v-date
     1543        .
     1544       end.
     1545       else do:
     1546         buffer-copy buf_bar-code to buf_c-bar-code
     1547         assign
     1548         buf_c-bar-code.gds-code           = buf_bar-code.gds-code
     1549         buf_c-bar-code.chip-num           = next-value (s-gds-chip, ub)
     1550         buf_c-bar-code.corr-time          = v-time
     1551         buf_c-bar-code.corr-user-db-num   = g#db-num
     1552         buf_c-bar-code.corr-user-name     = (if g#news
     1553                                             then (chr(4) +  'СПН':U)
     1554                                             else (if g#esys
     1555                                                   then (chr(4) +  'ВС':U)
     1556                                                   else g#userid)
     1557                                             )
     1558         buf_c-bar-code.corr-date          = v-date
     1559         .
     1560       end.
     1561       create buf_c-gds-hist.
     1562       buffer-copy buf_c-bar-code to buf_c-gds-hist
     1563       assign
     1564       buf_c-gds-hist.gds-code           = buf_c-bar-code.gds-code
     1565       buf_c-gds-hist.action = integer(p-action)
     1566       buf_c-gds-hist.subject = 'bar-code':U
     1567       buf_c-gds-hist.is-news = g#news
     1568       buf_c-gds-hist.source-type = (if g#news then 'db':U
     1569                                     else (if g#esys
     1570                                           then 'esys':U
     1571                                           else "":U
     1572                                           )
     1573                                    )
     1574       buf_c-gds-hist.source-ref = (if g#news
     1575                                    then string(g#news-source-db)
     1576                                     else (if g#esys
     1577                                           then string(g#esys-source-esys)
     1578                                           else "":U
     1579                                           )
     1580                                    )
     1581       .
     1582     end.
     1583   end procedure.
     1584   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1585     define variable v-cntxt-db-num        as integer   no-undo .
