     1402   define new global shared variable g#lib-nws as handle no-undo .
     1403   procedure clientsh_write-clients-proc  :
     1404   define parameter buffer buf_clients for ub.clients .
     1405   define input parameter p-source-type like ub.c-cli-hist.source-type no-undo .
     1406   define input parameter p-source-ref  like ub.c-cli-hist.source-ref no-undo .
     1407   define variable v-date as date      no-undo.
     1408   define variable v-time  as integer   no-undo.
     1409   define buffer buf_c-cli-hist for ub.c-cli-hist.
     1410   define buffer buf_c-clients for ub.c-clients.
     1411     do
     1412     on error undo, return error
     1413     :
     1414       if not available buf_clients then do:
     1415         message
     1416           vss-workfile vss-revision vss-description skip
     1417           "Ошибка задания входных параметров" skip
     1418           "Не определен контрагент" skip
     1419           view-as alert-box error .
     1420         undo, return error .
     1421       end.
     1422       if g#news then do:
     1423         define variable v-send as integer no-undo .
     1424         define variable v-subject as character no-undo .
     1425         case buf_clients.obj-type:
     1426           when 'орг':U then v-subject =  'firm':U.
     1427           when 'чел':U then v-subject =  'person':U.
     1428           when 'маг':U then v-subject =  'shop':U.
     1429           when 'скл':U then v-subject =  'store':U.
     1430         end case.
     1431         v-send = integer('0':U).
     1432   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1433   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     1434     (input  g#db-num
     1435     ,input  v-subject
     1436     ,input  0
     1437     ,input  '':U
     1438     ,input  0
     1439     ,input  '':U
     1440     ,input  '':U
     1441     ,input  '':U
     1442     ,input  0
     1443     ,input  0
     1444     ,input  0
     1445     ,input  'nws-to-hist'
     1446     ,output v-send
     1447     ) no-error .
     1448         if v-send < 0 then return.
     1449       end.
     1450       run cur-time in this-procedure(output v-date, output v-time).
     1451       create buf_c-clients.
     1452       buffer-copy buf_clients to buf_c-clients
     1453       assign
     1454       buf_c-clients.obj-code           = buf_clients.obj-code
     1455       buf_c-clients.obj-type           = buf_clients.obj-type
     1456       buf_c-clients.chip-num           = next-value (s-cli-chip, ub)
     1457       buf_c-clients.corr-time          = v-time
     1458       buf_c-clients.corr-user-db-num   = g#db-num
     1459       buf_c-clients.corr-user-name     = (if g#news
     1460                                           then (chr(4) +  'СПН':U)
     1461                                           else (if g#esys
     1462                                                 then (chr(4) +  'ВС':U)
     1463                                                 else g#userid)
     1464                                           )
     1465       buf_c-clients.corr-date          = v-date
     1466       .
     1467       create buf_c-cli-hist.
     1468       buffer-copy buf_c-clients to buf_c-cli-hist
     1469       assign
     1470       buf_c-cli-hist.action =  integer('2':U)
     1471       buf_c-cli-hist.subject = 'clients':U
     1472       buf_c-cli-hist.host-code = (if buf_clients.obj-type = 'орг':U
     1473                                   and
     1474                                   can-find(first ub.sysconf no-lock where
     1475                                                     ub.sysconf.host-code = buf_clients.obj-code)
     1476                                   then buf_clients.obj-code
     1477                                   else 0)
     1478       buf_c-cli-hist.is-news = g#news
     1479       buf_c-cli-hist.source-type = p-source-type
     1480       buf_c-cli-hist.source-ref = p-source-ref
     1481       .
     1482     end.
     1483   end procedure.
