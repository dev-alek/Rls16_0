     1624   _main:
     1625   do
     1626   on error undo, return error return-value
     1627   :
     1628     assign
     1629     vattaxcd = integer('1':U)
     1630     slttaxcd = integer('2':U)
     1631     .
     1632     if par-mode = 'АВТОИЗМЕНЕНИЕ':U
     1633     then do on error undo, return error :
     1634        par-mode = 'ИЗМЕНЕНИЕ':U.
     1635        find first buf_goods no-lock where
     1636                  recid(buf_goods) = par-rec no-error .
     1637        if not available buf_goods then do:
     1638           find first buf_goods no-lock where
     1639                    buf_goods.gds-code = par-gds-code.
     1640        end.
     1641        if available buf_goods
     1642        then do:
     1643           assign
     1644              par-tnved      = buf_goods.tnved when par-tnved eq ?
     1645              par-gds-name   = buf_goods.gds-name  when par-gds-name eq ?
     1646              par-grp-code   = buf_goods.grp-code when par-grp-code eq ?
     1647              par-prod-type   = buf_goods.prod-type     when par-prod-type eq ?
     1648              par-prod-code   = buf_goods.prod-code     when par-prod-code eq ?
     1649              is-goods = buf_goods.gds-type eq 'т':U when is-goods eq ?
     1650              par-engl-name = buf_goods.engl-name     when par-engl-name eq ?
     1651              par-label-name = buf_goods.label-name   when par-label-name eq ?
     1652              par-chk-name = buf_goods.chk-name   when par-chk-name eq ?
     1653              par-fbr-grp-code = buf_goods.fbr-grp-code  when par-fbr-grp-code eq ?
     1654              par-unit-base = buf_goods.unit-base     when par-unit-base eq ?
     1655              par-unit-cli = buf_goods.unit-cli      when par-unit-cli eq ?
     1656              par-min-rate = buf_goods.min-rate when par-min-rate eq ?
     1657              par-max-rate = buf_goods.max-rate when par-max-rate eq ?
     1658              par-cli-base-rate = buf_goods.cli-base-rate when par-cli-base-rate eq ?
     1659              par-calc-method = buf_goods.calc-method  when par-calc-method eq ?
     1660              par-nationality = buf_goods.nationality   when par-nationality eq ?
     1661              par-unit-cst = buf_goods.unit-cst     when par-unit-cst eq ?
     1662              par-alpha1 = buf_goods.alpha1  when par-alpha1 eq ?
     1663              par-okdp = buf_goods.okdp       when par-okdp eq ?
     1664              par-increase-pc = buf_goods.increase-pc   when par-increase-pc eq ?
     1665              par-qnty-cart =  buf_goods.qnty-cart     when par-qnty-cart  eq ?
     1666              par-ms-base  = buf_goods.ms-base when  par-ms-base eq ?
     1667              par-wt-base =  buf_goods.wt-base when par-wt-base eq ?
     1668              par-ms-cart = buf_goods.ms-cart when par-ms-cart eq ?
     1669              par-wt-cart = buf_goods.wt-cart when par-wt-cart eq ?
     1670              par-PS = buf_goods.PS      when par-PS  eq ?
     1671              par-NegRest = buf_goods.negative-rest when par-NegRest eq ?
     1672              par-destin = buf_goods.destin        when par-destin  eq ?
     1673              par-attrib = buf_goods.attrib        when par-attrib eq ?
     1674              par-user-rule = buf_goods.user-rule    when par-user-rule eq ?
     1675              par-sert = buf_goods.sert          when par-sert eq ?
     1676              par-struct = buf_goods.struct        when par-struct eq ?
     1677              par-deadline = buf_goods.deadline     when par-deadline eq ?
     1678              par-cond-keep-code = buf_goods.cond-keep-code when par-cond-keep-code eq ?
     1679              par-sort  = buf_goods.sort          when par-sort eq ?
     1680              par-proof = buf_goods.proof         when par-proof eq ?
     1681              par-normal-wastage = buf_goods.normal-wastage when par-normal-wastage eq ?
     1682              par-normal-waste = buf_goods.normal-waste when par-normal-waste eq ?
     1683           .
     1684        end.
     1685     end.
     1686     if par-gds-name = "" then do:
     1687       run do-message in this-procedure(
     1688                                         par-silence
     1689                                       ,"Название не может быть пустым !"
     1690                                       ,"error":U
     1691                                       ) no-error .
     1692       if error-status :error then do:
     1693           undo _main, return error return-value.
     1694       end.
     1695     end.
     1696     if
     1697     index(par-gds-name, chr(10)) > 0
     1698     or
     1699     index(par-gds-name, chr(13)) > 0
     1700     or
     1701     index(par-engl-name, chr(10)) > 0
     1702     or
     1703     index(par-engl-name, chr(13)) > 0
     1704     or
     1705     index(par-label-name, chr(10)) > 0
     1706     or
     1707     index(par-label-name, chr(13)) > 0
     1708     or
     1709     index(par-chk-name, chr(10)) > 0
     1710     or
     1711     index(par-chk-name, chr(13)) > 0
     1712     then do:
     1713       run do-message in this-procedure(
     1714                                         par-silence
     1715                                       ,"Поля Названий не могут содержать символы перевода строки и возврата каретки!"
     1716                                       ,"error":U
     1717                                       ) no-error .
     1718       if error-status :error then do:
     1719           undo _main, return error return-value.
     1720       end.
     1721     end.
     1722     find first buf_gds-prt share-lock where
     1723               buf_gds-prt.node-code = par-node-code no-error .
     1724     if not available buf_gds-prt then do:
     1725       run do-message in this-procedure(
     1726                                         par-silence
     1727                                       ,"Шкала выбрана неправильно !"
     1728                                       ,"error":U
     1729                                       ) no-error .
     1730       if error-status:error then do:
     1731           undo _main, return error return-value.
     1732       end.
     1733     end.
     1734     find first buf_gds-grp share-lock where
     1735                 buf_gds-grp.node-code = par-grp-code no-error .
     1736     if NOT available buf_gds-grp then do:
     1737       run do-message in this-procedure(
     1738                                         par-silence
     1739                                       ,"Не выбрана группа ( по классификатору товаров ) !"
     1740                                       ,"error":U
     1741                                       ) no-error .
     1742       if error-status:error then do:
     1743           undo _main, return error return-value.
     1744       end.
     1745     end.
     1746     if can-find( first grp-buf where grp-buf.upper-code = buf_gds-grp.node-code ) then do:
     1747       run do-message in this-procedure(
     1748                                         par-silence
     1749                                       ,("Выбранная Вами группа" + chr(10) +
     1750                                         "делится на более детальные группы :"  + chr(10) +
     1751                                         "в такую группу нельзя добавлять товар !"
     1752                                         )
     1753                                       ,"error":U
     1754                                       ) no-error .
     1755       if error-status:error then do:
     1756           undo _main, return error return-value.
     1757       end.
     1758     end.
     1759     if par-fbr-grp-code <> ? then do:
     1760       find first buf_fbr-gds-grp no-lock where
     1761                   buf_fbr-gds-grp.node-code = par-fbr-grp-code
     1762            AND    buf_fbr-gds-grp.obj-type = "":U
     1763            and    buf_fbr-gds-grp.obj-code = 0
     1764            no-error .
     1765       if NOT available buf_fbr-gds-grp then do:
     1766         run do-message in this-procedure(
     1767                                           par-silence
     1768                                         ,"Неверно выбрана группа блюд( по рубрикатору блюд ) !"
     1769                                         ,"error":U
     1770                                         ) no-error .
     1771         if error-status:error then do:
     1772             undo _main, return error return-value.
     1773         end.
     1774       end.
     1775       if can-find( first buf_fbr-gds-grp where buf_fbr-gds-grp.upper-code = par-fbr-grp-code ) then do:
     1776         run do-message in this-procedure(
     1777                                           par-silence
     1778                                         ,("Выбранная Вами группа блюд" + chr(10) +
     1779                                           "делится на более детальные группы :"  + chr(10) +
     1780                                           "в такую группу нельзя добавлять товар !"
     1781                                           )
     1782                                         ,"error":U
     1783                                         ) no-error .
     1784         if error-status:error then do:
     1785             undo _main, return error return-value.
     1786         end.
     1787       end.
     1788     end.
     1789     if NOT can-find( ub.units where ub.units.unit-name = par-unit-base ) then do:
     1790       run do-message in this-procedure(
     1791                                         par-silence
     1792                                       ,"Не выбрана учетная единица измерения !"
     1793                                       ,"error":U
     1794                                       ) no-error .
     1795       if error-status:error then do:
     1796         undo _main, return error return-value.
     1797       end.
     1798     end.
     1799     if NOT can-find( ub.units where ub.units.unit-name =  par-unit-cli ) then do:
     1800       run do-message in this-procedure(
     1801                                         par-silence
     1802                                       ,"Не выбрана единица измерения поставщика !"
     1803                                       ,"error":U
     1804                                       ) no-error .
     1805       if error-status:error then do:
     1806         undo _main, return error return-value.
     1807       end.
     1808     end.
     1809     FIND FIRST base_units WHERE
     1810               base_units.unit-name = par-unit-base
     1811     NO-LOCK NO-ERROR .
     1812     if ( available base_units ) then do:
     1813       if  can-do( base_units.type, 'топ':U) then do:
     1814   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1815   do:
     1816     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1817       (input  ibs.th.gbl.gbl-var:g#db-num
     1818       ,input  ibs.th.gbl.gbl-var:g#userid
     1819       ,input  0
     1820       ,input  'actn_reference-petrolium_update':U
     1821       ,input  'global':U
     1822       ,input  0
     1823       ,input  '':U
     1824       ,input  0
     1825       ,input  0
     1826       ,input  0
     1827       ,input  0
     1828       ,input  false
     1829       ,output loc#log
     1830       )  .
     1831   end.
     1832         if not loc#log then undo _main, return error "Отсутствуют права на работу с топливным товаром".
     1833         if not par-is-ptrl then do:
     1834           run do-message in this-procedure(
     1835                                               par-silence
     1836                                             ,"В системе запрещена работа с топливным товаром"
     1837                                             ,"error":U
     1838                                             ) no-error .
     1839           if error-status:error then do:
     1840             undo _main, return error return-value.
     1841           end.
     1842         end.
     1843       end.
     1844       if par-unq-artc AND can-do(base_units.type, 'вес':U) then do:
     1845         run do-message in this-procedure(
     1846                                             par-silence
     1847                                           ,("В Вашей конфигурации диапазон весовых кодов" + chr(10) +
     1848                                             "уже используется несовместимым образом," + chr(10) +
     1849                                             "поэтому ввод весовых товаров ЗАПРЕЩЕН!")
     1850                                           ,"error":U
     1851                                           ) no-error .
     1852         if error-status:error then do:
     1853           undo _main, return error return-value.
     1854         end.
     1855       end.
     1856       if can-do( base_units.type, 'сер':U) AND ( par-unit-cli <> par-unit-base ) then do:
     1857         run do-message in this-procedure(
     1858                                             par-silence
     1859                                           ,("Для товаров с серийными номерами" + chr(10) +
     1860                                             "учетная единица измерения"  + chr(10) +
     1861                                             "и единица измерения  поставщика"  +  chr(10) +
     1862                                             "должны быть ОДИНАКОВЫ !")
     1863                                           ,"error":U
     1864                                           ) no-error .
     1865         if error-status:error then do:
     1866           undo _main, return error return-value.
     1867         end.
     1868       end.
     1869       assign
     1870       is-twounit = (lookup('2ед':U, base_units.type) > 0)
     1871       .
     1872     end.
     1873     FIND FIRST cli_units No-LOCK WHERE
     1874               cli_units.unit-name = par-unit-cli No-ERROR.
     1875     if NOT can-do(base_units.type, 'топ':U) = can-do(cli_units.type, 'топ':U) THEN DO:
     1876       run do-message in this-procedure(
     1877                                           par-silence
     1878                                         ,("Для товара eдиница измерения поставщика и основная единица измерения" + chr(10) +
     1879                                           "могут быть либо обе топливные либо обе нетопливные!")
     1880                                         ,"error":U
     1881                                         ) no-error .
     1882       if error-status:error then do:
     1883         undo _main, return error return-value.
     1884       end.
     1885     END.
     1886     if  LOOKUP('топ':U, base_units.type) > 0  AND (LOOKUP('дро':U, cli_units.type ) = 0 ) then do:
     1887       run do-message in this-procedure(
     1888                                           par-silence
     1889                                         ,("Для товаров типа топливо  единица измерения поставщика может быть только типа " + chr(10) +
     1890                                           'топ':U + chr(44) + 'дро':U + "!")
     1891                                         ,"error":U
     1892                                         ) no-error .
     1893       if error-status:error then do:
     1894         undo _main, return error return-value.
     1895       end.
     1896     end.
     1897     if  LOOKUP('2ед':U, base_units.type) > 0  then do:
     1898       if not par-is-jwlr then do:
     1899         run do-message in this-procedure(
     1900                                             par-silence
     1901                                           ,"В системе запрещена работа с товаром с двумя единицами измерения"
     1902                                           ,"error":U
     1903                                           ) no-error .
     1904         if error-status:error then do:
     1905           undo _main, return error return-value.
     1906         end.
     1907       end.
     1908       IF (LOOKUP('шту':U, cli_units.type ) = 0 ) then do:
     1909         run do-message in this-procedure(
     1910                                             par-silence
     1911                                           ,( "Для товаров, у которых тип основной единицы измерения - " + '2ед':U + chr(10) +
     1912                                             " единица измерения поставщика может быть только типа " + 'шту':U + "!"
     1913                                           )
     1914                                           ,"error":U
     1915                                           ) no-error .
     1916         if error-status:error then do:
     1917           undo _main, return error ("unit-cli":U + chr(4) + return-value).
     1918         end.
     1919       END.
     1920       if par-max-rate <= par-min-rate AND
     1921         (par-max-rate <> 0 AND
     1922         par-min-rate <> 0)
     1923       then do:
     1924         run do-message in this-procedure(
     1925                                           par-silence
     1926                                           ,("Для товаров, у которых тип основной единицы измерения - " + '2ед':U + chr(10) +
     1927                                           "max кол-во дробного в штуке должно быть больше min кол-ва дробного в штуке !")
     1928                                           ,"error":U
     1929                                           ) no-error .
     1930         if error-status:error then do:
     1931           undo _main, return error return-value.
     1932         end.
     1933       end.
     1934       IF (par-max-rate) >= 2 * (par-min-rate) AND
     1935         (par-max-rate <> 0 AND
     1936           par-min-rate <> 0)
     1937       then do:
     1938         run do-message in this-procedure(
     1939                                           par-silence
     1940                                           ,("Для товаров, у которых тип основной единицы измерения - " + '2ед':U + chr(10) +
     1941                                             "max кол-во дробного в штуке не может быть больше чем в 2 раза min кол-ва дробного в штуке!")
     1942                                           ,"error":U
     1943                                           ) no-error .
     1944         if error-status:error then do:
     1945           undo _main, return error return-value.
     1946         end.
     1947       end.
     1948     end.
     1949     if  LOOKUP('сте':U, base_units.type) > 0  then do:
     1950       if not par-is-bttl then do:
     1951         run do-message in this-procedure(
     1952                                           par-silence
     1953                                           ,"В системе запрещена работа с товаром с раздельным учетом стеклотары"
     1954                                           ,"error":U
     1955                                           ) no-error .
     1956         if error-status:error then do:
