     2562                           input parparentproc
     2563                           ,input par-obj-type
     2564                           ,input par-obj-code
     2565                           ,input main-code
     2566                           ).
     2567           end.
     2568           if par-dif-nam2 or par-alt-bc-mode = 2 then do:
     2569             REPEAT while prod-bc-added:
     2570               run dif-nam2-proc in this-procedure(
     2571                                                    input par-dif-nam2
     2572                                                   ,input par-gds-name
     2573                                                   ,input base_units.type
     2574                                                   ,input main-code
     2575                                                   ) no-error .
     2576               if error-status:error then do:
     2577                 run gbl/d-askw.w (input "Рекомендация",
     2578                             input ("В соответствии с настройками системы" + chr(10) +
     2579                                     "необходимо ввести доп.бар-код" + chr(10) +
     2580                                     "( уже был сохранен товар с таким же названием)!"),
     2581                             input "|",
     2582                             input "Ввести Доп.БК|Продолжить без Доп.БК",
     2583                             input "|",
     2584                             input 1,
     2585                             input 2,
     2586                             output choice).
     2587                 if choice = 1 then do:
     2588                   assign
     2589                   prod-bc-added = yes
     2590                   .
     2591                 end.
     2592                 else do:
     2593                   prod-bc-added = no.
     2594                 end.
     2595                 if prod-bc-added then do:
     2596                   run ref/alt-bc.w (
     2597                                 input parparentproc
     2598                                 ,input par-obj-type
     2599                                 ,input par-obj-code
     2600                                 ,input main-code
     2601                               ).
     2602                   prod-bc-added = no.
     2603                 end.
     2604               end.
     2605               else  do:
     2606                 assign
     2607                 prod-bc-added = no.
     2608               end.
     2609             END.
     2610           end.
     2611         end.
     2612         if par-unq-artc and NOT can-do( base_units.type, 'вес':U ) then do:
     2613           define variable v-b-str as character no-undo .
     2614           define variable v-pbc-rid as recid no-undo .
     2615           assign
     2616             v-b-str = v-artic
     2617             v-pbc-rid = ?
     2618           .
     2619           find first buf_goods exclusive-lock where
     2620                     recid(buf_goods) = par-rec no-error .
     2621           run trg/prod-bc1.p (
     2622                               input  parparentproc
     2623                               ,input par-silence
     2624                               ,input no
     2625                               ,input no
     2626                               ,input no
     2627                               ,input 'unq-artc'
     2628                               ,input ""
     2629                               ,buffer buf_goods
     2630                               ,input main-code
     2631                               ,input-output v-b-str
     2632                               ,output v-pbc-rid
     2633                               ) no-error.
     2634           if error-status :error
     2635           or v-pbc-rid = ? then do:
     2636             run do-message in this-procedure(
     2637                                              input par-silence
     2638                                             ,input return-value
     2639                                             ,input "error":U
     2640                                             ) no-error .
     2641             if error-status:error then do:
     2642               undo _main, return error return-value.
     2643             end.
     2644           end.
     2645         end.
     2646       end.
     2647     end.
     2648     if par-mode = 'ИЗМЕНЕНИЕ':U then do:
     2649       do on error undo, return error :
     2650         find first buf_goods exclusive-lock where
     2651                   recid(buf_goods) = par-rec no-error .
     2652         if not available buf_goods then do:
     2653           find first buf_goods exclusive-lock where
     2654                    buf_goods.gds-code = par-gds-code.
     2655         end.
     2656         assign
     2657         par-nbc = buf_goods.gds-code
     2658         .
     2659         if buf_goods.gds-type = 'у':U and not par-file then do:
     2660           if not par-file then do :
     2661             if ( par-obj-price-base <> 0 ) AND
     2662               ( par-obj-price-rubl <> 0 ) AND
     2663               ( par-obj-price-base <> ? ) AND
     2664               ( par-obj-price-rubl <> ? ) then .
     2665             else do:
     2666               run do-message in this-procedure(
     2667                                                   par-silence
     2668                                                   ,"Учетная цена не может быть нулевой !"
     2669                                                   ,"error":U
     2670                                                   ) no-error .
     2671               if error-status:error then do:
     2672                 undo _main, return error return-value.
     2673               end.
     2674             end.
     2675           end.
     2676   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2677   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscr in g#library
     2678     (input  par-obj-type
     2679     ,input  par-obj-code
     2680     ,input  buf_goods.artic
     2681     ,input  buf_clients.obj-type
     2682     ,input  buf_clients.obj-code
     2683     ,input  buf_gds-prt.node-code
     2684     ,buffer ub.gds-obj
     2685     ,buffer ub.prt-obj
     2686     )  .
     2687           if not is-goods then do:
     2688             assign
     2689             prev-value-base = gds-obj.price-base
     2690             prev-value-rubl = gds-obj.price-rubl
     2691             .
     2692           end.
     2693           IF
     2694           ( par-obj-price-base <> prev-value-base OR
