     1087   define variable vss-include-info4 as character format "X(65)" no-undo
     1088   initial "@(#)$Workfile$ $Revision$".
     1089   procedure grplib-get-full-name :
     1090      define input parameter p-node-code  as integer      no-undo.
     1091      define output parameter p-full-name as character    no-undo.
     1092      do
     1093   on error undo, return error
     1094   :
     1095       define variable v-upper-code    as integer           no-undo.
     1096       define buffer buf_gds-grp       for ub.gds-grp.
     1097       define buffer buf_upper_gds-grp for ub.gds-grp.
     1098       find first buf_gds-grp no-lock
     1099            where buf_gds-grp.node-code = p-node-code
     1100       no-error.
     1101       if not available buf_gds-grp
     1102       then do:
     1103           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1104       end.
     1105       assign
     1106           p-full-name  = ""
     1107           v-upper-code = 1
     1108       .
     1109       do while buf_gds-grp.upper-code <> 0
     1110       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1111       :
     1112           assign
     1113               p-full-name  = buf_gds-grp.node-name
     1114                            + (if p-full-name <> "" then chr(47) else "")
     1115                            + p-full-name
     1116               v-upper-code = buf_gds-grp.upper-code
     1117           .
     1118           find first buf_gds-grp no-lock
     1119                where buf_gds-grp.node-code = v-upper-code
     1120           no-error.
     1121           if not available buf_gds-grp
     1122           then do:
     1123               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1124                                   + string( v-upper-code )
     1125                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1126           end.
     1127       end.
     1128       assign
     1129       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1130       .
     1131   end.
     1132   end .
     1133   procedure grplib-get-node-from-full-name :
     1134   define input parameter p-full-name as character no-undo .
     1135   define output parameter p-node-code as integer no-undo .
     1136   define variable v-ii as integer no-undo .
     1137   define variable v-upper-code as integer no-undo .
     1138   define variable v-root-code as integer no-undo .
     1139   define variable v-entry as character no-undo .
     1140   define buffer buf_gds-grp       for ub.gds-grp.
     1141   do
     1142   on error undo, return error
     1143   :
     1144     find first buf_gds-grp no-lock
     1145         where buf_gds-grp.upper-code = 0
     1146     no-error .
     1147     if not available buf_gds-grp
     1148     then do:
     1149         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1150     end.
     1151     else do:
     1152       assign
     1153       v-root-code = buf_gds-grp.node-code
     1154       .
     1155     end.
     1156     v-upper-code = v-root-code.
     1157     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1158       assign
     1159       v-entry = entry(v-ii, p-full-name, chr(47)).
     1160       if v-entry = '' then leave.
     1161       find first buf_gds-grp no-lock where
     1162                 buf_gds-grp.node-name = v-entry
     1163             and buf_gds-grp.upper-code = v-upper-code
     1164             no-error.
     1165       if not available buf_gds-grp then do:
     1166         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1167       end.
     1168       else do:
     1169         p-node-code = buf_gds-grp.node-code.
     1170         v-upper-code = buf_gds-grp.node-code.
     1171       end.
     1172     end.
     1173   end.
     1174   end .
     1175   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1176   procedure cur-time :
     1177      define output parameter p-today as date      no-undo .
     1178      define output parameter p-time  as integer   no-undo .
     1179     do
     1180     on error undo, return error
     1181     :
     1182       define variable v-date1 as date      no-undo .
     1183       define variable v-date2 as date      no-undo .
     1184       define variable v-time  as integer   no-undo .
     1185       assign
     1186         v-date1 = today
     1187         v-time  = time
     1188         v-date2 = today
     1189       .
     1190       if v-date1 <> v-date2
     1191       then do:
     1192         assign
     1193           v-date1 = today
     1194           v-time  = v-time
     1195         .
     1196       end.
     1197       assign
     1198         p-today = v-date1
     1199         p-time  = v-time
     1200       .
     1201     end.
     1202   end.
     1203   function cur-time-date returns character
     1204   :
     1205     return string(today, '99/99/9999':U) .
     1206   end.
     1207   function cur-time-mjd returns decimal
     1208   :
     1209     define variable v-date as date      no-undo .
     1210     define variable v-time as integer   no-undo .
     1211     run cur-time in this-procedure
     1212       (output v-date
     1213       ,output v-time
     1214       ) .
     1215     return integer(v-date) - 2400002 + (v-time / 86400) .
     1216   end.
     1217   function cur-time-get-ending-index returns integer
     1218   (input p-number as integer
     1219   )
     1220   :
     1221     if p-number < 0
     1222     or p-number = ?
     1223     then do:
     1224       return 1 .
     1225     end.
     1226     define variable v-rest as integer   no-undo .
     1227     assign
     1228       p-number = p-number modulo 100
     1229     .
     1230     if p-number < 20
     1231     then do:
     1232       assign
     1233         v-rest = p-number
     1234       .
     1235     end.
     1236     else do:
     1237       assign
     1238         v-rest = p-number modulo 10
     1239       .
     1240     end.
     1241     case v-rest :
     1242       when 1
     1243       then do:
     1244         return 2 .
     1245       end.
     1246       when 2 or
     1247       when 3 or
     1248       when 4
     1249       then do:
     1250         return 3 .
     1251       end.
     1252       otherwise do:
     1253         return 1 .
     1254       end.
     1255     end case .
     1256   end.
     1257   procedure cur-time-mjd-to-date :
     1258      define input  parameter i-mjd-diff as decimal no-undo.
     1259      define output parameter o-Date     as date    no-undo.
     1260      define output parameter o-Time     as integer no-undo.
     1261      define variable v-day-number as integer   no-undo .
     1262      if    i-mjd-diff < 0
     1263         or i-mjd-diff = ?
     1264      then do:
     1265         return "?" .
     1266      end.
     1267      assign
     1268         v-day-number = truncate(i-mjd-diff,0).
     1269         o-Date = date(v-day-number + 2400002).
     1270         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1271     .
     1272   end.
     1273   function cur-time-mjd-to-string returns character
     1274   (input p-mjd-diff as decimal
     1275   )
     1276   :
     1277     define variable v-day-number as integer   no-undo .
     1278     define variable v-seconds    as integer   no-undo .
     1279     define variable v-hour       as integer   no-undo .
     1280     define variable v-min        as integer   no-undo .
     1281     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1282     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1283     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1284     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1285     if p-mjd-diff < 0
     1286     or p-mjd-diff = ?
     1287     then do:
     1288       return "?" .
     1289     end.
     1290     assign
     1291       v-day-number = integer(truncate(p-mjd-diff,0))
     1292       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1293     .
     1294     if v-seconds > 86400
     1295     then do:
     1296       assign
     1297         v-seconds = 86400 - 1
     1298       .
     1299     end.
     1300     if v-seconds < 0
     1301     then do:
     1302       assign
     1303         v-seconds = 0
     1304       .
     1305     end.
     1306     assign
     1307       v-hour = truncate(v-seconds / 3600, 0)
     1308     .
     1309     assign
     1310       v-seconds = v-seconds modulo 3600
     1311     .
     1312     assign
     1313       v-min = truncate(v-seconds / 60, 0)
     1314     .
     1315     assign
     1316       v-seconds = v-seconds modulo 60
     1317     .
     1318     return
     1319         (if v-day-number <> 0
     1320           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1321           else ""
     1322         )
     1323       + (if v-day-number <> 0 or v-hour <> 0
     1324           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1325           else ""
     1326         )
     1327       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1328           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1329           else ""
     1330         )
     1331       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1332       .
     1333   end.
     1334   function cur-time-string returns character
     1335   :
     1336     define variable v-date as date      no-undo .
     1337     define variable v-time as integer   no-undo .
     1338     run cur-time in this-procedure
     1339       (output v-date
     1340       ,output v-time
     1341       ) .
     1342     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1343   end.
     1344   function cur-time-string-sec returns character
     1345   :
     1346     define variable v-date as date      no-undo .
     1347     define variable v-time as integer   no-undo .
     1348     run cur-time in this-procedure
     1349       (output v-date
     1350       ,output v-time
     1351       ) .
     1352     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1353   end.
     1354   function cur-time-custom  returns character
     1355   (input p-prefix as character
     1356   ,input p-date-format as character
     1357   ,input p-delimiter as character
     1358   ,input p-time-format as character
     1359   ,input p-suffix as character
     1360   )
     1361   :
     1362     define variable v-date as date      no-undo .
     1363     define variable v-time as integer   no-undo .
     1364     run cur-time in this-procedure
     1365       (output v-date
     1366       ,output v-time
     1367       ) .
     1368     return
     1369       p-prefix
     1370       + string(v-date, p-date-format)
     1371       + p-delimiter
     1372       + string(v-time, p-time-format)
     1373       + p-suffix
     1374       .
     1375   end.
     1376   function cur-time-print  returns character
     1377   :
     1378     define variable v-date as date      no-undo .
     1379     define variable v-time as integer   no-undo .
     1380     run cur-time in this-procedure
     1381       (output v-date
     1382       ,output v-time
     1383       ) .
     1384     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1385   end.
     1386   function cur-time-datetime returns datetime
     1387   :
     1388     define variable v-char as character no-undo .
     1389     define variable v-datetime as datetime no-undo .
     1390     v-char = cur-time-string().
     1391     v-datetime = datetime(v-char).
     1392     return  v-datetime.
     1393   end.
     1394   function cur-time-string-msec returns character
     1395   :
     1396     define variable v-date as datetime  no-undo .
     1397     v-date = now.
     1398     return string(v-date) .
     1399   end.
