     2465                             then replace(replace(buf_goods.gds-name, chr(39), ""), '"', "")
     2466                             else par-chk-name
     2467         buf_goods.alpha1 = par-alpha1
     2468         buf_goods.min-rate = if LOOKUP('2ед':U, base_units.type) > 0
     2469                             then par-min-rate
     2470                             else 0
     2471         buf_goods.max-rate = if LOOKUP('2ед':U, base_units.type) > 0
     2472                             then par-max-rate
     2473                             else 0
     2474         buf_goods.grp-name = v-grp-name
     2475         buf_goods.destin        = par-destin
