     2274               undo _main, return error ("artic|unq-artc":U + chr(4) + return-value).
     2275               end.
     2276           end.
     2277           FIND FIRST cli-buf WHERE
     2278                       cli-buf.obj-type = similar_goods.prod-type AND
     2279                       cli-buf.obj-code = similar_goods.prod-code NO-LOCK.
     2280           loc#log = no.
     2281           if not par-manual then do:
     2282               run do-message in this-procedure(
     2283                                                   par-silence
     2284                                                   ,(substitute("Вы добавляете товар с артикулом &1 для производителя &2&3: &4"
     2285                                                               ,par-artic
     2286                                                               ,par-prod-type
     2287                                                               ,par-prod-code
     2288                                                               ,par-gds-name
     2289                                                               )
     2290                                                   + chr(10) + chr(10) +
