     2477         buf_goods.user-rule     = par-user-rule
     2478         buf_goods.sert          = par-sert
     2479         buf_goods.struct        = par-struct
     2480         buf_goods.deadline      = par-deadline
     2481         buf_goods.cond-keep-code = par-cond-keep-code
     2482         buf_goods.sort          = par-sort
     2483         buf_goods.proof          = par-proof
     2484         buf_goods.normal-wastage = par-normal-wastage
     2485         buf_goods.normal-waste = par-normal-waste
     2486         buf_goods.unit-cst      = if par-custvalue = "yes"
     2487                                   then par-unit-cst else "":U
     2488         buf_goods.tnved         = if par-custvalue = "yes" or
     2489                                   (par-file = yes and par-tnved <> "":U)
     2490                                   then par-tnved
     2491                                   else "":U
     2492         buf_goods.cst-base-rate = if par-custvalue = "yes"
     2493                                   then par-cst-base-rate
     2494                                   else 0
     2495         buf_goods.nationality   = if par-custvalue = "yes"
     2496                                   then par-nationality
     2497                                   else "":U
     2498         buf_goods.fbr-grp-code  = par-fbr-grp-code
     2499         v-gds-rec = recid (buf_goods)
     2500         par-rec = recid (buf_goods)
     2501         v-gds-code = buf_goods.gds-code
     2502         .
     2503         if not buf_clients.is-prod then do:
     2504           FIND current buf_clients SHARE-LOCK NO-ERROR .
     2505           if available buf_clients
     2506           and  not buf_clients.is-prod then do:
     2507             run clientsh_write-clients-proc in this-procedure  (
     2508                                                          buffer buf_clients
     2509                                                         ,input "":U
     2510                                                         ,input "":U
     2511                                                         ) .
     2512             assign
     2513             buf_clients.is-prod = yes.
     2514           end.
     2515           FIND current buf_clients No-LOCK NO-ERROR .
     2516         end.
     2517         RUN cre-bc in this-procedure (
     2518                                       input buf_gds-prt.node-code
     2519                                       ,input par-nbc
     2520                                       ,input par-ArtDIs
     2521                                       ,input var-AvtArt
     2522                                       ,input par-BarDis
     2523                                       ,output main-code
     2524                                       ) no-error.
     2525         if error-status:error then do:
     2526           run do-message in this-procedure(
     2527                                               par-silence
     2528                                               ,"Ошибка при создании главного кода товара: " + return-value
     2529                                               ,"error":U
     2530                                               ) no-error .
     2531           if error-status:error then do:
     2532             undo _main, return error return-value.
     2533           end.
     2534         end.
     2535         par-gds-code = v-gds-code.
     2536         if not is-goods and not par-file then do:
     2537   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2538   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscr in g#library
     2539     (input  par-obj-type
