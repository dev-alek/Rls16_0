     2781   end.
     2782   PROCEDURE cre-bc :
     2783   define input parameter par-c like ub.gds-prt.node-code no-undo.
     2784   define input parameter par-nbc like ub.bar-code.gds-code no-undo .
     2785   define input parameter par-ArtDis as logical no-undo .
     2786   define input parameter par-ArtAvt like ub.bar-code.b-code no-undo .
     2787   define input parameter par-BarDis as integer no-undo .
     2788   define output parameter par-main-code like ub.bar-code.gds-code no-undo .
     2789   DEFINE VARIABLE var-bc-code as integer no-undo .
     2790   define variable v-gds-code like ub.goods.gds-code no-undo .
     2791   define variable v-unit-base like ub.goods.unit-base no-undo .
     2792   define variable v-goods-recid as recid no-undo .
     2793   define buffer buf_bar-code for ub.bar-code.
     2794   _bc:
     2795   do transaction on error undo, return error :
     2796     IF NOT par-ArtDis and par-Bardis = 0 then do:
     2797       run gen-b-code IN THIS-PROCEDURE (
     2798                                          input 'bcgb':U
     2799                                         ,output var-bc-code
     2800                                         ) no-error.
     2801       if error-status:error then do:
     2802         undo _bc, return error return-value .
     2803       end.
     2804     end.
     2805     else do:
     2806       assign
     2807       var-bc-code = (if par-BarDIs = 1
     2808                      then integer(buf_goods.artic)
     2809                      else (if par-bardis = 2
     2810                            then integer(par-gds-code)
     2811                            else par-nbc)
     2812                     )
     2813       .
     2814     end.
     2815     assign
     2816     par-nbc = var-bc-code
     2817     .
     2818     assign
     2819     buf_goods.gds-code  = if par-ArtDis
     2820                           then par-ArtAvt
     2821                           else var-bc-code
     2822     v-gds-code          = buf_goods.gds-code
     2823     v-unit-base         = buf_goods.unit-base
     2824     .
     2825     create buf_bar-code.
     2826     assign
     2827     buf_bar-code.b-code        = var-bc-code
     2828     buf_bar-code.node-code     = par-c
     2829     buf_bar-code.gds-code      = v-gds-code
     2830     buf_bar-code.in-code       = "":U
     2831     buf_bar-code.part-code     = "":U
     2832     buf_bar-code.unit-cli      = v-unit-base
     2833     buf_bar-code.cli-base-rate = 1
     2834     par-main-code = var-bc-code
     2835     buf_bar-code.stts          = integer('99':U)
     2836     .
     2837     release buf_bar-code no-error .
     2838     if error-status:error then do:
     2839       undo _bc, return error vss-workfile + "Ошибка при создании бар-кода." + chr(10) + return-value + chr(10) + trim(error-status :get-message(1)).
     2840     end.
     2841     assign
     2842     v-goods-recid = recid(buf_goods).
     2843     release buf_goods no-error .
     2844     if error-status:error then do:
     2845       undo _bc, return error vss-workfile + "Ошибка при создании товара." + chr(10) + return-value + chr(10) + trim(error-status :get-message(1)).
     2846     end.
     2847     find first buf_bar-code where buf_bar-code.b-code = var-bc-code.
     2848     assign
     2849     buf_bar-code.stts = 0
     2850     .
     2851     run ref/dtaxgdsu.p (
     2852                     if par-single-record then yes else no
     2853                   ,par-host-code
     2854                   ,par-obj-type
     2855                   ,par-obj-code
     2856                   ,v-goods-recid
     2857                   ,(if par-copymode then for-goods.gds-code else 0)
     2858                   ) no-error.
     2859     if error-status:error then do:
     2860         undo _bc, return error vss-workfile + "Ошибка при создании налогов." + chr(10) + return-value + chr(10) + trim(error-status :get-message(1)).
     2861     end.
     2862     find first buf_bar-code no-lock where
     2863               buf_bar-code.b-code = var-bc-code .
     2864     run bar-codh_write-bar-code-proc in this-procedure (
     2865                                                           buffer buf_bar-code
     2866                                                         , integer('1':U)
     2867                                                         , "":U
     2868                                                         , "":U
     2869                                                         ) .
     2870   end.
     2871   END PROCEDURE.
     2872   procedure do-message :
     2873   define input parameter par-silence as logical no-undo .
     2874   define input parameter par-mess as character no-undo .
     2875   define input parameter par-title-type as character no-undo .
     2876     do
     2877     on error undo, return error
     2878     :
     2879       if not par-silence then do:
     2880         CASE par-title-type:
     2881           when "error":U then do:
     2882             message
     2883             par-mess
     2884             view-as alert-box error.
     2885             undo, return error par-mess.
     2886           end.
     2887           when "warning":U then do:
     2888             message
     2889             par-mess
     2890             view-as alert-box warning.
     2891           end.
     2892           when "question":U then do:
     2893             message
     2894             par-mess
     2895             view-as alert-box question buttons YES-NO update loc#log.
     2896           end.
     2897         end CASE.
     2898       end.
     2899       else do:
     2900         CASE par-title-type:
     2901           when "error":U then do:
     2902             undo, return error par-mess.
     2903           end.
     2904           when "warning":U then do:
     2905           end.
     2906           when "question":U then do:
     2907             loc#log = no.
     2908           end.
     2909         end CASE.
     2910       end.
     2911     end.
     2912   end procedure.
     2913   PROCEDURE dif-nam2-proc:
     2914   define input parameter par-dif-nam2 as logical no-undo .
     2915   define input parameter par-gds-name like ub.goods.gds-name no-undo .
     2916   define input parameter par-units-type like ub.units.type no-undo .
     2917   define input parameter par-gds-code like ub.goods.gds-code no-undo .
     2918     do
     2919     on error undo, return error
     2920     :
     2921       if par-dif-nam2 and par-saved-name = par-gds-name
     2922           and NOT can-do( par-units-type, 'вес':U) AND
     2923           not can-find(first ub.prod-bc where ub.prod-bc.b-code = par-gds-code)
     2924           then return error.
     2925     end.
     2926   END PROCEDURE.
