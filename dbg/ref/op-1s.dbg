      959   define variable sym3  as char init ":" no-undo.
      960   define variable sym4  as char init ":" no-undo.
      961   define variable sym5  as char init ":" no-undo.
      962   define variable sym6  as char init ":" no-undo.
      963   define variable sym7  as char init ":" no-undo.
      964   define variable sym8  as char init "|" no-undo.
      965   define variable v-attr-value            as character            no-undo.
      966   define variable v-attr-type             as character            no-undo.
      967   define variable v-single-line           as character            no-undo.
      968   define variable v-underline             as character            no-undo.
      969   define variable v-no-printable-recipe   as logical init no      no-undo.
      970   define variable v-need-page-break       as logical init no      no-undo.
      971   define variable g#report-num    as integer      no-undo.
      972   define variable g#quest-print   as logical      no-undo.
      973   define variable g#log           as logical      no-undo.
      974   run get-report-num in p-mainmenu-handle (
      975       output g#report-num
      976   ).
      977   run get-quest-print in p-mainmenu-handle (
      978       output g#quest-print
      979   ).
      980   find first buf_recipe no-lock
      981        where buf_recipe.recipe-code = p-recipe-code
      982   no-error.
      983   if not available buf_recipe
      984   then do:
      985       message
      986         "Форму OP-1 напечатать невозможно."
      987         skip "Неверно задан код рецепта."
      988       view-as alert-box.
      989       return.
      990   end.
      991   DEFINE frame f-op-1
      992           space(10)
      993           sym1  format "X(1)" space(0)   v-line-counter      format ">>9"     space(0)
      994           sym2  format "X(1)" space(0)   v-goods-artic       format "X(16)"     space(0)
      995           sym3  format "X(1)" space(0)   v-goods-name        format "X(47)"     space(0)
      996           sym4  format "X(1)" space(0)   v-bar-code          format ">>>>>>>>9" space(0)
      997           sym5  format "X(1)" space(0)   v-mass              format ">,>>9.999"  space(0)
      998           sym6  format "X(1)" space(0)   v-cost              format ">>,>>>,>>9.99"  space(0)
      999           sym7  format "X(1)" space(0)   v-sum               format ">>>,>>>,>>9.99"  space(0)
     1000           sym8  format "X(1)" space(0)
     1001   with width 235 down stream-io.
     1002   do
     1003   on error undo, return error
     1004   :
     1005       assign
     1006           v-single-line  = fill("-", 230)
     1007           v-underline    = fill("_", 230)
     1008       .
     1009       run cur-time in this-procedure (
     1010           output v-today
     1011           , output v-time
     1012       ).
     1013       assign
     1014           v-doc-code     = buf_recipe.recipe-code
     1015           v-fact-date    = v-today
     1016       .
     1017       find first buf_clients no-lock
     1018            where buf_clients.obj-type = p-store-type
     1019              and buf_clients.obj-code = p-store-code
     1020       no-error.
     1021       case buf_clients.obj-type :
     1022           when 'маг':U then
     1023               do:
     1024                   find first shop no-lock
     1025                       where shop.obj-code = buf_clients.obj-code
     1026                   .
     1027               end.
     1028           when 'скл':U then
     1029               do:
     1030                   find first store no-lock
     1031                       where store.obj-code = buf_clients.obj-code
     1032                   .
     1033               end.
     1034       end case.
     1035       assign
     1036           v-org-name = buf_clients.obj-name
     1037       .
     1038   if session :set-wait-state( "compiler" ) then.
     1039   output stream Out-Stream to value( string( session:temp-directory +
     1040                                        "rpt" + string( g#report-num ) ) )
     1041                                        page-size  value(62) .
     1042       form header
     1043           v-single-line format "X(119)" at 1 skip
     1044           "Продолжение - на следующей странице" at 30 skip
     1045           with frame BottomFrame width 235 page-bottom no-labels no-box .
     1046       view stream Out-Stream frame BottomFrame .
     1047       define variable v-host-code    as integer      no-undo.
     1048   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1049   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1050     (input  p-store-type
     1051     ,input  p-store-code
     1052     ,output v-host-code
     1053     )  .
     1054       find first clients no-lock
     1055           where clients.obj-type = 'орг':U
     1056           and clients.obj-code = v-host-code
     1057       .
     1058       case clients.obj-type:
     1059          when 'орг':U
     1060          then do:
     1061               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     1062               if available ub.firm
     1063               then do:
     1064                   assign
     1065                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     1066                       t-addres = t-addres
     1067                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     1068                               then ""
     1069                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     1070                             )
     1071                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     1072                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1073                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1074                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     1075                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     1076                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1077                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1078                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     1079                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     1080                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     1081                       t-phone = ub.firm.phone
     1082                       t-inn   = ub.firm.inn
     1083                       t-okpo  = ub.firm.okpo
     1084                   .
     1085               end.
     1086          end.
     1087          when 'маг':U
     1088          then do:
     1089               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     1090               if available ub.shop
     1091               then do:
     1092                   assign
     1093                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     1094                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     1095                       t-phone = shop.phone
     1096                       t-inn = ""
     1097                       t-okpo = ""
     1098                   .
     1099               end.
     1100          end.
     1101          when 'скл':U
     1102          then do:
     1103               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     1104               if available ub.store
     1105               then do:
     1106                   assign
     1107                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     1108                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     1109                       t-phone = ub.store.phone
     1110                       t-inn = ""
     1111                       t-okpo = ""
     1112                   .
     1113               end.
     1114          end.
     1115          when 'чел':U
     1116          then do:
     1117               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     1118               if available ub.person
     1119               then do:
     1120                   assign
     1121                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     1122                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     1123                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     1124                       t-phone = ub.person.phone1
     1125                       t-inn = ub.person.inn
     1126                       t-okpo = ub.person.okpo
     1127                   .
     1128               end.
     1129          end.
     1130       end case.
     1131       assign
     1132           v-organization = string( "ИНН " + t-inn + " " + CAPS( clients.obj-name ) + " (" + string(clients.obj-code) + ")"
     1133                       + t-addres + t-phone)
     1134       .
     1135       find first buf_goods no-lock
     1136            where buf_goods.artic      = buf_recipe.artic
     1137              and buf_goods.prod-type  = buf_recipe.prod-type
     1138              and buf_goods.prod-code  = buf_recipe.prod-code
     1139       .
     1140   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1141     (input  buf_goods.gds-code
     1142     ,input  ?
     1143     ,output v-bar-code
     1144     ) no-error .
     1145    .
     1146       run check-all-weight-kg in this-procedure (
     1147             input buf_recipe.recipe-code
     1148           , output v-no-printable-recipe
     1149       ).
     1150       find first buf_units no-lock
     1151            where buf_units.unit-name = buf_goods.unit-base
     1152       .
     1153   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1154   gp-fact-order = 0 .
     1155   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1156     (input  buf_goods.gds-code
     1157     ,input  ?
     1158     ,output gp-b-code
     1159     ) no-error .
     1160   if error-status:error then do:
     1161     message
     1162       error-status :get-message(1) skip
     1163       return-value skip
     1164       view-as alert-box error .
     1165     return error.
     1166   end.
     1167   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1168   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1169     (input  p-store-type
     1170     ,input  p-store-code
     1171     ,input  gp-b-code
     1172     ,input  0
     1173     ,input  gp-fact-order
     1174     ,output gp-doc-num
     1175     ,output gp-price-sale
     1176     ,output gp-road-tax
     1177     ,output gp-excise
     1178     ) no-error .
     1179   if error-status:error then do:
     1180     return error.
     1181   end.
     1182   gp-price-sale-parts = gp-price-sale.
     1183   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1184   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avprpart in g#lib-trn3
     1185     (input  p-store-type
     1186     ,input  p-store-code
     1187     ,input  gp-b-code
     1188     ,input  0
     1189     ,input  gp-fact-order
     1190     ,output gp-doc-num
     1191     ,output gp-price-sale-parts
     1192     ,output gp-road-tax
     1193     ,output gp-excise
     1194     ) no-error .
     1195   if error-status:error then do:
     1196     return error.
     1197   end.
     1198   if gp-price-sale-parts <> 0 and gp-price-sale-parts <> ? then do:
     1199       gp-price-sale = gp-price-sale-parts.
     1200    end.
     1201       assign
     1202           v-recipe-name     = string( buf_goods.artic ) + fill( " ", 2 ) + buf_goods.gds-name
     1203                                                           + fill( " ", 2 ) + string( v-bar-code )
     1204           v-sum-mass-doc    = buf_recipe.qnty
     1205           v-goods-unit      = buf_goods.unit-base
     1206           v-line-counter    = 0
     1207           v-sum-cost        = 0
     1208           v-need-page-break = yes
     1209           v-sum-sale        = gp-price-sale
     1210           v-sum-mass        = 0
     1211       .
     1212       run print-title in this-procedure.
     1213       form with frame f-op-1 .
     1214       view stream Out-Stream frame BottomFrame .
     1215       down stream Out-Stream 1 with frame f-op-1 no-labels.
     1216       run print-header in this-procedure.
     1217       run print-header-numbers (
     1218             input v-single-line
     1219           , input no
     1220       ).
     1221       for each buf_recipe-gds no-lock
     1222          where buf_recipe-gds.recipe-code = buf_recipe.recipe-code
     1223       :
     1224           find first buf_goods no-lock
     1225                where buf_goods.artic      = buf_recipe-gds.artic
     1226                  and buf_goods.prod-type  = buf_recipe-gds.prod-type
     1227                  and buf_goods.prod-code  = buf_recipe-gds.prod-code
     1228           .
     1229   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1230     (input  buf_goods.gds-code
     1231     ,input  ?
     1232     ,output v-bar-code
     1233     ) no-error .
     1234    .
     1235           assign
     1236               v-line-counter  = v-line-counter + 1
     1237               v-goods-artic   = string( buf_goods.artic )
     1238               v-goods-name    = buf_goods.gds-name
     1239               v-mass          = buf_recipe-gds.brutto-qnty / buf_recipe.qnty
     1240               v-sum-mass      = v-sum-mass + ( if buf_recipe-gds.is-waste = yes then 0.0 else v-mass )
     1241           .
     1242           if buf_recipe-gds.is-waste <> yes
     1243           then do:
     1244               run gdsoattr-value in this-procedure (
     1245                   input 'fbr-cost-rubl':U
     1246                   , input buf_goods.gds-code
     1247                   , input p-store-type
     1248                   , input p-store-code
     1249                   , output v-attr-value
     1250                   , output v-attr-type
     1251               ).
     1252               assign
     1253                   v-cost = decimal( v-attr-value )
     1254               no-error.
     1255               if error-status :error
     1256               then do:
     1257                   assign
     1258                       v-cost = 0.0
     1259                   .
     1260               end.
     1261               assign
     1262                   v-sum           = v-cost * v-mass
     1263                   v-sum-cost      = v-sum-cost + v-sum
     1264               .
     1265           end.
     1266           else do:
     1267               assign
     1268                   v-cost          = 0
     1269                   v-sum           = 0
     1270               .
     1271           end.
     1272           display stream out-stream
     1273               sym1  v-line-counter
     1274               sym2  v-goods-artic
     1275               sym3  v-goods-name
     1276               sym4  v-bar-code
     1277               sym5  v-mass
     1278               sym6  v-cost
     1279               sym7  v-sum
     1280               sym8
     1281           with frame f-op-1.
     1282           down stream out-stream 1 with frame f-op-1.
     1283       end.
     1284       assign
     1285           v-sum-prc       = ( v-sum-sale - v-sum-cost ) / v-sum-cost * 100
     1286       .
     1287       put stream out-stream
     1288           skip space(10)
     1289           "|"
     1290           v-single-line             format "X(117)"
     1291           "|"
     1292           skip space(10)
     1293           "|" space (1)
     1294           "Общая стоимость сырьевого набора"
     1295           ":"                                               at 10 + 80
     1296           v-sum-cost                format ">>>,>>>,>>9.99" at right-field(10 + 119, 14)
     1297           "|"                                               at 10 + 119
     1298           skip space(10)
     1299           "|"
     1300           v-single-line             format "X(117)"
     1301           "|"
     1302           skip space(10)
     1303           "|" space (1)
     1304           substitute( "Наценка &1%, руб. коп", string( v-sum-prc, "->>9.99") )
     1305                                       format "X(74)"
     1306           ":"                                               at 10 + 80
     1307           ( v-sum-sale - v-sum-cost ) format "->>,>>>,>>9.99" at right-field(10 + 119, 14)
     1308           "|"                                               at 10 + 119
     1309           skip space(10)
     1310           "|"
     1311           v-single-line   format "X(117)"
     1312           "|"
     1313           skip space(10)
     1314           "|" space (1)
     1315           "Цена продажи блюда, руб. коп"
     1316           ":"                                               at 10 + 80
     1317           v-sum-sale                format ">>>,>>>,>>9.99" at right-field(10 + 119, 14)
     1318           "|"                                               at 10 + 119
     1319           skip space(10)
     1320           "|"
     1321           v-single-line             format "X(117)"
     1322           "|"
     1323           skip space(10)
     1324           "|" space (1)
     1325           "Выход одного блюда в готовом виде, грамм"
     1326           ":"                                               at 10 + 80
     1327           string( buf_recipe.portion-weight * 1000, ">>>,>>>,>>9.99" )
     1328                                       format "X(14)"          at right-field(10 + 119, 14)
     1329           "|"                                               at 10 + 119
     1330           skip space(10)
     1331           "|"
     1332           v-single-line   format "X(117)"
     1333           "|"
     1334           skip space(10)
     1335           "|" space(1)
     1336           "Заведующий производством"
     1337           ":"                                               at 10 + 70
     1338           space(1) "подпись"
     1339           ":"                                               at 10 + 80
     1340           "|"                                               at 10 + 119
     1341           skip space(10)
     1342           "|"
     1343           v-single-line   format "X(117)"
     1344           "|"
     1345           skip space(10)
     1346           "|" space(1)
     1347           "Калькуляцию составил"
     1348           ":"                                               at 10 + 70
     1349           space(1) "подпись"
     1350           ":"                                               at 10 + 80
     1351           "|"                                               at 10 + 119
     1352           skip space(10)
     1353           "|"
     1354           v-single-line   format "X(117)"
     1355           "|"
     1356           skip space(10)
     1357           "|" space (1)
     1358           "УТВЕРЖДАЮ. Руководитель организации"
     1359           ":"                                               at 10 + 70
     1360           space(1) "подпись"
     1361           ":"                                               at 10 + 80
     1362           "|"                                               at 10 + 119
     1363           skip space(10)
     1364           v-single-line   format "X(119)"
     1365       .
     1366       hide stream Out-Stream frame BottomFrame .
     1367       output stream Out-Stream close.
     1368   if session :set-wait-state( "" ) then.
     1369       define variable v-user-action           as character            no-undo.
     1370       define variable v-printed               as logical              no-undo.
     1371       run gbl/prnfilen.w (
     1372             input "":U
     1373           , input 4
     1374           , input string( session :temp-directory ) + "rpt" + string( g#report-num )
     1375           , input 7
     1376           , output v-user-action
     1377           , output v-printed
     1378       ) .
     1379   end.
     1380   procedure print-header-numbers :
     1381   do
     1382   on error undo, return error
     1383   :
     1384   def input parameter p-single-line as char    no-undo.
     1385   def input parameter p-need-line   as logical no-undo.
     1386       if p-need-line = yes
     1387       then put stream out-stream
     1388           skip
     1389             string( "Страница " + string( PAGE-NUMBER( Out-Stream ), ">>9" ) ) format "X(13)" at right-field( 10 + 119, 13)
     1390           skip space(10)
     1391             p-single-line format "X(119)"
     1392       .
     1393       put stream out-stream
     1394           skip space(10)
     1395             "|"
     1396             "1"                  at center-field( 10 + 1, 10 + 5, 1)
     1397             ":"                  at 10 + 5
     1398             "2"                  at center-field( 10 + 5, 10 + 22, 1)
     1399             ":"                  at 10 + 22
     1400             "3"                  at center-field( 10 + 22, 10 + 70, 1)
     1401             ":"                  at 10 + 70
     1402             "4"                  at center-field( 10 + 70, 10 + 80, 1)
     1403             ":"                  at 10 + 80
     1404             "5"                  at center-field( 10 + 80, 10 + 90, 1)
     1405             ":"                  at 10 + 90
     1406             "6"                  at center-field( 10 + 90, 10 + 104, 1)
     1407             ":"                  at 10 + 104
     1408             "7"                  at center-field( 10 + 104, 10 + 119, 1)
     1409             "|"                  at 10 + 119
     1410           skip space(10)
     1411             "|"
     1412             p-single-line format "X(117)"
     1413             "|"                  at 10 + 119
     1414       .
     1415   end.
     1416   end procedure.
     1417   procedure write-itog :
     1418   do
     1419   on error undo, return error
     1420   :
     1421       def input parameter p-type          as char no-undo.
     1422       def input parameter p-in-mass       as decimal no-undo.
     1423       def input parameter p-in-sum        as decimal no-undo.
     1424       def input parameter p-out-norm-mass as decimal no-undo.
     1425       def input parameter p-out-fact-mass as decimal no-undo.
     1426       def input parameter p-out-fact-sum  as decimal no-undo.
     1427       put stream Out-Stream
     1428         skip space(10)
     1429           v-single-line format "X(119)"
     1430       .
     1431   end.
     1432   end procedure.
     1433   procedure check-all-weight-kg :
     1434   do
     1435   on error undo, return error
     1436   :
     1437   define input parameter p-recipe-code            as character    no-undo.
     1438   define output parameter p-no-printable-recipe   as logical      no-undo.
     1439       define variable v-is-weight     as logical init no    no-undo.
     1440       def buffer  buf_recipe-gds  for recipe-gds.
     1441       def buffer  buf_goods       for goods.
     1442       def buffer  buf_units       for units.
     1443           assign
     1444               p-no-printable-recipe = no
     1445           .
     1446           for each buf_recipe-gds
     1447              where buf_recipe-gds.recipe-code  = p-recipe-code
     1448           :
     1449               find first buf_goods
     1450                    where buf_goods.artic      = buf_recipe-gds.artic
     1451                      and buf_goods.prod-type  = buf_recipe-gds.prod-type
     1452                      and buf_goods.prod-code  = buf_recipe-gds.prod-code
     1453               .
     1454               if buf_goods.gds-type <> 'у':U
     1455               then do:
     1456                   assign
     1457                       v-is-weight = no
     1458                   .
     1459                   for each buf_units no-lock
     1460                      where buf_units.type = 'вес':U
     1461                   :
     1462                       if buf_goods.unit-base = buf_units.unit-name
     1463                       then do:
     1464                           assign
     1465                               v-is-weight = yes
     1466                           .
     1467                       end.
     1468                   end.
     1469                   if v-is-weight = no
     1470                   then do:
     1471                       assign
     1472                           p-no-printable-recipe = yes
     1473                       .
     1474                       leave.
     1475                   end.
     1476               end.
     1477           end.
     1478   end.
     1479   end procedure.
     1480   procedure print-title :
     1481   do
     1482   on error undo, return error
     1483   :
     1484           put stream Out-Stream
     1485             skip
     1486               string( "Страница " + string( PAGE-NUMBER( Out-Stream ), ">>9" ) ) format "X(13)" at right-field( 10 + 119, 13)
     1487             skip
     1488               space(10) v-single-line format  "X(16)"             at 114
     1489             skip
     1490               space(10) "| "                                      at 114
     1491                             'код':U                               at center-field(114, 10 + 119, length('код':U))
     1492                             "|"                                       at 10 + 119
     1493             skip
     1494               space(10) "Форма по ОКУД" format "X(14)"            at right-field(114, 13)
     1495                             "| "                                      at 114
     1496                             "0330501"                                 at center-field(114, 10 + 119, 7)
     1497                             "|"                                       at 10 + 119
     1498             skip
     1499               space(10) "Организация:               "
     1500                       v-organization                format "X(60)"
     1501                       "по ОКПО"                                      at right-field(114, 7)
     1502                       "|"                                            at 114
     1503                       trim(t-okpo)                  format "X(10)"   at right-field( 10 + 119, 10)
     1504                       "|"                                            at 10 + 119
     1505             skip
     1506               space(10) "Структурное подразделение: "
     1507                             v-org-name              format "X(60)"
     1508                             "|"                                       at 114
     1509                             "|"                                       at 10 + 119
     1510             skip
     1511               space(10) "Вид деятельности по ОКДП"
     1512                                                     format "X(25)"    at right-field(114, 25)
     1513                             "|"                                       at 114
     1514                             "|"                                       at 10 + 119
     1515             skip
     1516               space(10) "Наименование блюда:        "
     1517                             v-recipe-name           format "X(60)"
     1518                             "|"                                       at 114
     1519                             "|"                                       at 10 + 119
     1520             skip
     1521               space(10) "Номер блюда по сборнику рецептур"
     1522                                                     format "X(32)"    at right-field(114, 32)
     1523                             "|"                                       at 114
     1524                             buf_recipe.recipe-code  format "X(8)"     at center-field(114, 10 + 119, 8)
     1525                             "|"                                       at 10 + 119
     1526             skip
     1527               space(10) "Вид операции"          format "X(12)"    at right-field(114, 12)
     1528                             "|"                                       at 114
     1529                             buf_recipe.recipe-type  format "X(12)"    at center-field(114, 10 + 119, 12)
     1530                             "|"                                       at 10 + 119
     1531             skip
     1532               space(10) v-single-line           format  "X(16)"   at 114
     1533           .
     1534           put stream Out-Stream
     1535             skip space(10)
     1536                 v-single-line   format  "X(46)"   at 50 + 1
     1537             skip space(50)
     1538                 "|"
     1539                 "Номер"                           at  center-field(50, 50 + 20, 5)
     1540                 "|"                               at 50 + 20
     1541                 "Номер"                           at  center-field(50 + 20, 50 + 33, 5)
     1542                 "|"                               at 50 + 33
     1543                 "Дата"                            at  center-field(50 + 33, 50 + 46, 4)
     1544                 "|"                               at 50 + 46
     1545             skip space(50)
     1546                 "|"
     1547                 "документа"     format "X(9)"     at  center-field(50, 50 + 20, 9)
     1548                 "|"                               at 50 + 20
     1549                 "рецепта"       format "X(7)"     at  center-field(50 + 20, 50 + 33, 7)
     1550                 "|"                               at 50 + 33
     1551                 "составления"   format "X(11)"    at  center-field(50 + 33, 50 + 46, 11)
     1552                 "|"                               at 50 + 46
     1553             skip space(50)
     1554                 "|"
     1555                 v-single-line   format "X(44)"
     1556                 "|"  at 50 + 46
     1557             skip
     1558                 space(25) "КАЛЬКУЛЯЦИОННАЯ КАРТОЧКА | "
     1559                 v-doc-code format "X(16)"
     1560                 " | "
     1561                 fill( " ", 10 - length(buf_recipe.recipe-code)) + buf_recipe.recipe-code
     1562                                 format "X(10)"            at  right-field( 50 + 33, 10)
     1563                 "| "                                      at 50 + 33
     1564                 v-fact-date     format "99/99/9999"
     1565                 "|"                                       at 50 + 46
     1566             skip space(10)
     1567                 v-single-line   format  "X(46)"      at 50 + 1
     1568           .
     1569   end.
     1570   end procedure.
     1571   procedure print-header :
     1572   do
     1573   on error undo, return error
     1574   :
     1575       put stream Out-Stream
     1576           skip space(10)
     1577               v-single-line format "X(119)"
     1578           skip space(10)
     1579               "|"
     1580               ":"                                  at 10 + 5
     1581               "Продукты"                           at center-field( 10 + 5, 10 + 80, 8)
     1582               ":"                                  at 10 + 80
     1583               ":"                                  at 10 + 90
     1584               ":"                                  at 10 + 104
     1585           "|"                                  at 10 + 119
     1586           skip space(10)
     1587               "|"
     1588               "Но-"
     1589               ":"                                  at 10 + 5
     1590               v-single-line format "X(74)"
     1591               ":"                                  at 10 + 80
     1592               "норма,"                             at center-field( 10 + 80, 10 + 90, 6)
     1593               ":"                                  at 10 + 90
     1594               "цена,"                              at center-field( 10 + 90, 10 + 104, 5)
     1595               ":"                                  at 10 + 104
     1596               "сумма,"                             at center-field( 10 + 104, 10 + 119, 6)
     1597               "|"                                  at 10 + 119
     1598           skip space(10)
     1599               "|"
     1600               "мер"
     1601               ":"                                  at 10 + 5
     1602               "Артикул"                            at center-field( 10 + 5, 10 + 22, 7)
     1603               ":"                                  at 10 + 22
     1604               "Наименование"                       at center-field( 10 + 22, 10 + 70, 12)
     1605               ":"                                  at 10 + 70
     1606               "Код"                                at center-field( 10 + 70, 10 + 80, 3)
     1607               ":"                                  at 10 + 80
     1608               ":"                                  at 10 + 90
     1609               "руб.коп"                            at center-field( 10 + 90, 10 + 104, 7)
     1610               ":"                                  at 10 + 104
     1611               "руб.коп"                            at center-field( 10 + 104, 10 + 119, 7)
     1612               "|"                                  at 10 + 119
     1613           skip space(10)
     1614           "|"
     1615           v-single-line format "X(117)"
     1616           "|" at 10 + 119
     1617       .
     1618   end.
     1619   end procedure.
