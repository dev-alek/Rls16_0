      706   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      707   procedure cur-time :
      708      define output parameter p-today as date      no-undo .
      709      define output parameter p-time  as integer   no-undo .
      710     do
      711     on error undo, return error
      712     :
      713       define variable v-date1 as date      no-undo .
      714       define variable v-date2 as date      no-undo .
      715       define variable v-time  as integer   no-undo .
      716       assign
      717         v-date1 = today
      718         v-time  = time
      719         v-date2 = today
      720       .
      721       if v-date1 <> v-date2
      722       then do:
      723         assign
      724           v-date1 = today
      725           v-time  = v-time
      726         .
      727       end.
      728       assign
      729         p-today = v-date1
      730         p-time  = v-time
      731       .
      732     end.
      733   end.
      734   function cur-time-date returns character
      735   :
      736     return string(today, '99/99/9999':U) .
      737   end.
      738   function cur-time-mjd returns decimal
      739   :
      740     define variable v-date as date      no-undo .
      741     define variable v-time as integer   no-undo .
      742     run cur-time in this-procedure
      743       (output v-date
      744       ,output v-time
      745       ) .
      746     return integer(v-date) - 2400002 + (v-time / 86400) .
      747   end.
      748   function cur-time-get-ending-index returns integer
      749   (input p-number as integer
      750   )
      751   :
      752     if p-number < 0
      753     or p-number = ?
      754     then do:
      755       return 1 .
      756     end.
      757     define variable v-rest as integer   no-undo .
      758     assign
      759       p-number = p-number modulo 100
      760     .
      761     if p-number < 20
      762     then do:
      763       assign
      764         v-rest = p-number
      765       .
      766     end.
      767     else do:
      768       assign
      769         v-rest = p-number modulo 10
      770       .
      771     end.
      772     case v-rest :
      773       when 1
      774       then do:
      775         return 2 .
      776       end.
      777       when 2 or
      778       when 3 or
      779       when 4
      780       then do:
      781         return 3 .
      782       end.
      783       otherwise do:
      784         return 1 .
      785       end.
      786     end case .
      787   end.
      788   procedure cur-time-mjd-to-date :
      789      define input  parameter i-mjd-diff as decimal no-undo.
      790      define output parameter o-Date     as date    no-undo.
      791      define output parameter o-Time     as integer no-undo.
      792      define variable v-day-number as integer   no-undo .
      793      if    i-mjd-diff < 0
      794         or i-mjd-diff = ?
      795      then do:
      796         return "?" .
      797      end.
      798      assign
      799         v-day-number = truncate(i-mjd-diff,0).
      800         o-Date = date(v-day-number + 2400002).
      801         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      802     .
      803   end.
      804   function cur-time-mjd-to-string returns character
      805   (input p-mjd-diff as decimal
      806   )
      807   :
      808     define variable v-day-number as integer   no-undo .
      809     define variable v-seconds    as integer   no-undo .
      810     define variable v-hour       as integer   no-undo .
      811     define variable v-min        as integer   no-undo .
      812     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      813     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      814     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      815     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      816     if p-mjd-diff < 0
      817     or p-mjd-diff = ?
      818     then do:
      819       return "?" .
      820     end.
      821     assign
      822       v-day-number = integer(truncate(p-mjd-diff,0))
      823       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      824     .
      825     if v-seconds > 86400
      826     then do:
      827       assign
      828         v-seconds = 86400 - 1
      829       .
      830     end.
      831     if v-seconds < 0
      832     then do:
      833       assign
      834         v-seconds = 0
      835       .
      836     end.
      837     assign
      838       v-hour = truncate(v-seconds / 3600, 0)
      839     .
      840     assign
      841       v-seconds = v-seconds modulo 3600
      842     .
      843     assign
      844       v-min = truncate(v-seconds / 60, 0)
      845     .
      846     assign
      847       v-seconds = v-seconds modulo 60
      848     .
      849     return
      850         (if v-day-number <> 0
      851           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      852           else ""
      853         )
      854       + (if v-day-number <> 0 or v-hour <> 0
      855           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      856           else ""
      857         )
      858       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      859           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      860           else ""
      861         )
      862       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      863       .
      864   end.
      865   function cur-time-string returns character
      866   :
      867     define variable v-date as date      no-undo .
      868     define variable v-time as integer   no-undo .
      869     run cur-time in this-procedure
      870       (output v-date
      871       ,output v-time
      872       ) .
      873     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      874   end.
      875   function cur-time-string-sec returns character
      876   :
      877     define variable v-date as date      no-undo .
      878     define variable v-time as integer   no-undo .
      879     run cur-time in this-procedure
      880       (output v-date
      881       ,output v-time
      882       ) .
      883     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      884   end.
      885   function cur-time-custom  returns character
      886   (input p-prefix as character
      887   ,input p-date-format as character
      888   ,input p-delimiter as character
      889   ,input p-time-format as character
      890   ,input p-suffix as character
      891   )
      892   :
      893     define variable v-date as date      no-undo .
      894     define variable v-time as integer   no-undo .
      895     run cur-time in this-procedure
      896       (output v-date
      897       ,output v-time
      898       ) .
      899     return
      900       p-prefix
      901       + string(v-date, p-date-format)
      902       + p-delimiter
      903       + string(v-time, p-time-format)
      904       + p-suffix
      905       .
      906   end.
      907   function cur-time-print  returns character
      908   :
      909     define variable v-date as date      no-undo .
      910     define variable v-time as integer   no-undo .
      911     run cur-time in this-procedure
      912       (output v-date
      913       ,output v-time
      914       ) .
      915     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      916   end.
      917   function cur-time-datetime returns datetime
      918   :
      919     define variable v-char as character no-undo .
      920     define variable v-datetime as datetime no-undo .
      921     v-char = cur-time-string().
      922     v-datetime = datetime(v-char).
      923     return  v-datetime.
      924   end.
      925   function cur-time-string-msec returns character
      926   :
      927     define variable v-date as datetime  no-undo .
      928     v-date = now.
      929     return string(v-date) .
      930   end.
