       90   define temp-table temp_p-fmt_string-part no-undo
       91       field str-key       as integer
       92       field string-part   as character
       93       index pi is primary unique
       94           str-key
       95   .
       96   define variable v-p-fmt-2-str-key    as integer      no-undo.
       97   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
       98                                     iInput AS INTEGER).
       99     def var v-start-print as integer no-undo .
      100     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      101     assign
      102       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      103     .
      104     RETURN v-start-print .
      105   END FUNCTION.
      106   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      107                                     iInput AS INTEGER).
      108     def var v-start-print as integer no-undo .
      109     assign
      110       v-start-print = INTEGER(iEndPix - 1 - iInput)
      111     .
      112     if v-start-print < 0 then return 0.
      113     RETURN v-start-print .
      114   END FUNCTION.
      115   function p-fmt-align-string returns character (
      116         p-in-string      as character
      117       , p-page-width     as integer
      118       , p-align-type     as character
      119   ).
      120       define variable v-string-length     as integer      no-undo.
      121       define variable v-out-string        as character    no-undo.
      122       assign
      123           v-string-length = length( trim( p-in-string ) )
      124       .
      125       if v-string-length >= p-page-width
      126       then do:
      127           assign
      128               v-out-string = trim( p-in-string )
      129           .
      130       end.
      131       else do:
      132           case p-align-type
      133           :
      134               when 'left':U
      135               then do:
      136                   assign
      137                       v-out-string = trim( p-in-string )
      138                   .
      139               end.
      140               when 'right':U
      141               then do:
      142                   assign
      143                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      144                   .
      145               end.
      146               when 'center':U
      147               then do:
      148                   assign
      149                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      150                   .
      151               end.
      152           end case.
      153       end.
      154       return v-out-string .
      155   end function.
      156   procedure p-fmt-split-string :
      157   define input parameter p-source-string  as character        no-undo.
      158   define input parameter p-split-length   as integer          no-undo.
      159   define output parameter p-string-1      as character        no-undo.
      160   define output parameter p-string-2      as character        no-undo.
      161   do
      162   on error undo, return error
      163   :
      164       define variable v-space-pos    as integer      no-undo.
      165       if length( p-source-string ) <= p-split-length
      166       then do:
      167           assign
      168               p-string-1 = p-source-string
      169           .
      170       end.
      171       else do:
      172           assign
      173               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      174           .
      175           if v-space-pos = 0
      176           then do:
      177               assign
      178                   v-space-pos = index( p-source-string, " ":U )
      179               .
      180           end.
      181           if v-space-pos = 0
      182           then do:
      183               assign
      184                   p-string-1 = substring( p-source-string, 1, p-split-length )
      185                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      186               .
      187           end.
      188           else do:
      189               assign
      190                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      191                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      192               .
      193           end.
      194       end.
      195   end.
      196   end procedure.
      197   procedure p-fmt-round :
      198   define input parameter p-qnty               as decimal          no-undo.
      199   define input parameter p-price-no-VAT       as decimal          no-undo.
      200   define input parameter p-VAT                as decimal          no-undo.
      201   define input parameter p-SLT                as decimal          no-undo.
      202   define input parameter p-road-tax           as decimal          no-undo.
      203   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      204   define output parameter p-new-VAT           as decimal          no-undo.
      205   define output parameter p-new-SLT           as decimal          no-undo.
      206   define output parameter p-new-sum-VAT       as decimal          no-undo.
      207   define output parameter p-new-sum-SLT       as decimal          no-undo.
      208   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      209   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      210   define output parameter p-new-sum-full      as decimal          no-undo.
      211       define variable v-vat-pc    as decimal      no-undo.
      212       define variable v-slt-pc    as decimal      no-undo.
      213   do
      214   on error undo, return error
      215   :
      216       if p-price-no-VAT = 0
      217       then do:
      218           assign
      219               p-new-price-no-VAT = 0.0
      220               p-new-VAT          = ?
      221               p-new-SLT          = ?
      222               p-new-sum-VAT      = 0.0
      223               p-new-sum-SLT      = 0.0
      224               p-new-sum-no-VAT   = 0.0
      225               p-new-sum-road-tax = 0.0
      226               p-new-sum-full     = 0.0
      227           .
      228       end.
      229       else do:
      230           assign
      231               v-vat-pc            = p-VAT / p-price-no-VAT
      232               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      233               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      234               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      235               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      236               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      237               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      238               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      239               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      240               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      241           .
      242       end.
      243   end.
      244   end procedure.
      245   procedure p-fmt-split :
      246   define input parameter p-in-string      as character        no-undo.
      247   define input parameter p-split-length   as integer          no-undo.
      248       define variable v-start-pos     as integer      no-undo.
      249       define variable v-end-pos       as integer      no-undo.
      250       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      251   do
      252   for buf_temp_p-fmt_string-part
      253   on error undo, return error
      254   :
      255       empty temp-table buf_temp_p-fmt_string-part.
      256       if p-split-length < 1
      257       then do:
      258           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      259       end.
      260       assign
      261           p-in-string                 = trim( p-in-string )
      262           v-p-fmt-2-str-key   = 0
      263           v-start-pos                 = 1
      264           v-end-pos                   = length( p-in-string )
      265       .
      266       run p-fmt-get-string-range in this-procedure (
      267             input p-in-string
      268           , input p-split-length
      269           , input v-start-pos
      270           , output v-start-pos
      271           , output v-end-pos
      272       ).
      273       do while v-end-pos <> 0
      274       :
      275           create buf_temp_p-fmt_string-part.
      276           assign
      277               v-p-fmt-2-str-key = v-p-fmt-2-str-key + 1
      278           .
      279           assign
      280               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-2-str-key
      281               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      282           .
      283           assign
      284               v-start-pos = v-end-pos + 1
      285           .
      286           run p-fmt-get-string-range in this-procedure (
      287                 input p-in-string
      288               , input p-split-length
      289               , input v-start-pos
      290               , output v-start-pos
      291               , output v-end-pos
      292           ).
      293       end.
      294   end.
      295   end procedure.
      296   procedure p-fmt-get-string-range :
      297   define input parameter p-in-string      as character        no-undo.
      298   define input parameter p-split-length   as integer          no-undo.
      299   define input parameter p-old-start-pos  as integer          no-undo.
      300   define output parameter p-start-pos     as integer          no-undo.
      301   define output parameter p-end-pos       as integer          no-undo.
      302       define variable v-init-string    as character    no-undo.
      303       define variable v-temp-char      as character    no-undo.
      304       define variable v-temp-pos       as integer      no-undo.
      305       define variable v-counter        as integer      no-undo.
      306   do
      307   on error undo, return error
      308   :
      309       assign
      310           p-start-pos   = p-old-start-pos
      311           v-init-string = substring( p-in-string, p-start-pos )
      312       no-error.
      313       if error-status :error
      314       or trim( v-init-string ) = "":U
      315       then do:
      316           assign
      317               p-end-pos = 0
      318           .
      319           undo, return .
      320       end.
      321       assign
      322           v-temp-char   = substring( v-init-string, 1, 1 )
      323       .
      324       do
      325       while trim( v-temp-char ) = "":U
      326       :
      327           assign
      328               p-start-pos     = p-start-pos + 1
      329               v-init-string   = substring( p-in-string, p-start-pos )
      330               v-temp-char     = substring( v-init-string, 1, 1 )
      331           .
      332       end.
      333       assign
      334           v-temp-pos  = p-split-length
      335           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      336           v-counter   = 0
      337       .
      338       search-word-end:
      339       do
      340       while trim( v-temp-char ) <> "":U
      341       :
      342           assign
      343               v-counter   = v-counter + 1
      344           .
      345           if v-counter > 20
      346           then do:
      347               assign
      348                   v-temp-pos  = p-split-length
      349               .
      350               leave search-word-end.
      351           end.
      352           assign
      353               v-temp-pos  = v-temp-pos - 1
      354               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      355           .
      356       end.
      357       assign
      358           p-end-pos = p-start-pos + v-temp-pos - 1
      359       .
      360   end.
      361   end procedure.
