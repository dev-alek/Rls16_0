     1072   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1073   procedure fltopend_fltopend :
     1074   define input parameter p-parent-handle as handle no-undo .
     1075   define input parameter p-qh as handle no-undo .
     1076   define input parameter p-flt-open-open-query  as character no-undo .
     1077   define input parameter p-where-cond as character no-undo .
     1078   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1079   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1080   define input parameter p-indexed-reposition as character no-undo .
     1081     do
     1082     on error undo, return error
     1083     :
     1084   define variable v-prepare-string as character no-undo .
     1085   define variable glog as logical no-undo .
     1086   assign
     1087   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1088                      p-where-cond + chr(32)  +
     1089                      p-use-indFIRST-query-tail + chr(32) +
     1090                      p-use-ind-sort-clmn-by + chr(32) +
     1091                      p-indexed-reposition
     1092   .
     1093   assign
     1094   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1095   if not glog
     1096   or error-status:error then do:
     1097     message error-status:get-message(1) view-as alert-box .
     1098     undo, return error .
     1099   end.
     1100   assign
     1101   glog = p-qh:query-open no-error .
     1102   if not glog
     1103   or error-status:error then do:
     1104     message error-status:get-message(1) view-as alert-box .
     1105     undo, return error .
     1106   end.
     1107     end.
     1108   end procedure.
     1109   procedure fltopend_fltfindd :
     1110   define input parameter p-parent-handle as handle no-undo .
     1111   define input parameter p-qh as handle no-undo .
     1112   define input parameter p-rowid as rowid no-undo .
     1113   define input parameter p-next as logical no-undo .
     1114   define input parameter p-lock as integer no-undo .
     1115   define input parameter p-bh as handle no-undo .
     1116   define input parameter p-where-cond as character no-undo .
     1117   define input parameter p-use-index-phrase as character no-undo .
     1118   define variable glog as logical no-undo .
     1119   define variable v-qh as handle no-undo .
     1120   define variable v-bh as handle no-undo .
     1121   define variable v-recid as recid no-undo .
     1122   define variable v-prepare-string as character no-undo .
     1123   do
     1124   on error undo, return error
     1125   on stop undo, return error
     1126   :
     1127     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1128     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1129     create query v-qh.
     1130     v-qh:set-buffers(v-bh).
     1131     v-prepare-string = substitute("for each &1 &2 &3"
     1132                                     ,v-bh:name
     1133                                     ,p-where-cond
     1134                                     ,p-use-index-phrase).
     1135     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1136     if not glog then do:
     1137       delete object v-qh.
     1138       delete object v-bh.
     1139       undo, return error .
     1140     end.
     1141     glog = v-qh:query-open no-error .
     1142     if not glog then do:
     1143       delete object v-qh.
     1144       delete object v-bh.
     1145       undo, return error .
     1146     end.
     1147     if p-next then do:
     1148       v-qh:reposition-to-rowid(p-rowid) no-error .
     1149       glog = v-qh:get-next( p-lock) no-error .
     1150       glog = v-qh:get-next( p-lock) no-error .
     1151       if not glog or v-qh:query-off-end = yes then do:
     1152         glog = v-qh:get-first( p-lock) no-error .
     1153       end.
     1154     end.
     1155     else do:
     1156       glog = v-qh:get-first( p-lock) no-error .
     1157     end.
     1158     v-recid = v-bh:recid no-error .
     1159     delete object v-qh.
     1160     delete object v-bh.
     1161     return string(v-recid) .
     1162   end.
     1163   end procedure.
     1164   procedure fltopend_fltfindq :
     1165   define input parameter p-parent-handle as handle no-undo .
     1166   define input parameter p-qh as handle no-undo .
     1167   define input parameter p-next as logical no-undo .
     1168   define input parameter p-lock as integer no-undo .
     1169   define input parameter p-flt-open-open-query  as character no-undo .
     1170   define input parameter p-where-cond as character no-undo .
     1171   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1172   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1173   define input parameter p-indexed-reposition as character no-undo .
     1174   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1175   define variable glog as logical no-undo .
     1176   define variable v-qh as handle no-undo .
     1177   define variable v-bh as handle no-undo extent 18.
     1178   define variable v-rowid as rowid no-undo extent 18.
     1179   define variable v-ii as integer no-undo .
     1180   define variable v-prepare-string as character no-undo .
     1181   do
     1182   on error undo, return error
     1183   on stop undo, return error
     1184   :
     1185     create query v-qh.
     1186     do v-ii = 1 to p-qh:num-buffers:
     1187       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1188       assign
     1189       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1190       no-error.
     1191       v-qh:add-buffer(v-bh[v-ii]).
     1192     end.
     1193     assign
     1194     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1195                       p-where-cond + chr(32)  +
     1196                       p-use-indFIRST-query-tail + chr(32) +
     1197                       p-use-ind-sort-clmn-by + chr(32) +
     1198                       p-indexed-reposition
     1199     .
     1200     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1201     if not glog then do:
     1202       delete object v-qh.
     1203       do v-ii = 1 to p-qh:num-buffers:
     1204         delete object v-bh[v-ii].
     1205       end.
     1206       undo, return error .
     1207     end.
     1208     glog = v-qh:query-open no-error .
     1209     if not glog then do:
     1210       delete object v-qh.
     1211       do v-ii = 1 to p-qh:num-buffers:
     1212         delete object v-bh[v-ii].
     1213       end.
     1214       undo, return error .
     1215     end.
     1216     if p-next then do:
     1217       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1218       glog = v-qh:get-next( p-lock) no-error .
     1219       glog = v-qh:get-next( p-lock) no-error .
     1220       if not glog or v-qh:query-off-end = yes then do:
     1221         glog = v-qh:get-first( p-lock) no-error .
     1222       end.
     1223     end.
     1224     else do:
     1225       glog = v-qh:get-first( p-lock) no-error .
     1226     end.
     1227     do v-ii = 1 to p-qh:num-buffers:
     1228       assign
     1229       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1230       no-error.
     1231     end.
     1232     delete object v-qh.
     1233     do v-ii = 1 to p-qh:num-buffers:
     1234       delete object v-bh[v-ii].
     1235     end.
     1236   end.
     1237   end procedure.
     1238   define variable filter-label as character no-undo init "Товары на принтере кухни" .
     1239   define variable filter-label0 as character no-undo init "Товары на принтере кухни" .
     1240   define variable filter-point0 as character no-undo init "fprngdss" .
     1241   define variable filter-point as character no-undo init "fprngdss" .
     1242   define variable sort-column-name as character no-undo .
     1243   define variable v-db-num like ub.db.db-num no-undo .
     1244   define variable v-list as character no-undo.
     1245   define variable gds-rec as recid no-undo .
     1246   define variable v-doc-rec as recid no-undo .
     1247   define buffer X_goods for ub.goods.
     1248   FUNCTION get-fbr-obj-name RETURNS CHARACTER
     1249     ( input p-db-num as integer, input p-prn-num as integer )  FORWARD.
     1250   FUNCTION get-gds-name RETURNS CHARACTER
     1251     ( p-gds-code as integer)  FORWARD.
     1252   FUNCTION get-obj-name RETURNS CHARACTER
     1253     ( input p-obj-type as character, input p-obj-code as integer )  FORWARD.
     1254   DEFINE BUTTON B-add
     1255        LABEL "&Добавить"
     1256        SIZE 10 BY 1.
     1257   DEFINE BUTTON B-chg
     1258        LABEL "&Изменить"
     1259        SIZE 10 BY 1.
     1260   DEFINE BUTTON B-delete
     1261        LABEL "&Удалить"
     1262        SIZE 10 BY 1.
     1263   DEFINE BUTTON B-exit AUTO-GO
     1264        LABEL "В&ыход"
     1265        SIZE 10 BY 1
     1266        BGCOLOR 8 .
     1267   DEFINE BUTTON B-gds
     1268        LABEL "&Товар"
     1269        SIZE 10 BY 1.
     1270   DEFINE BUTTON B-help
     1271        LABEL "Помо&щь"
     1272        SIZE 3 BY 1
     1273        BGCOLOR 8 .
     1274   DEFINE BUTTON B-print
     1275        LABEL "Пе&чать"
     1276        SIZE 3 BY 1
     1277        BGCOLOR 8 .
     1278   DEFINE BUTTON B-sch
     1279        LABEL "&Фильтр"
     1280        SIZE 3 BY 1
     1281        BGCOLOR 8 .
     1282   DEFINE VARIABLE f-object AS CHARACTER FORMAT "X(256)":U
     1283        VIEW-AS FILL-IN
     1284        SIZE 10 BY 1 NO-UNDO.
     1285   DEFINE VARIABLE sch-code AS CHARACTER FORMAT "X(20)":U
     1286        LABEL "коду товара"
     1287        VIEW-AS FILL-IN
     1288        SIZE 14.38 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1289   DEFINE VARIABLE sch-num AS CHARACTER FORMAT "X(20)":U
     1290        LABEL "принтеру"
     1291        VIEW-AS FILL-IN
     1292        SIZE 5.63 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1293   DEFINE VARIABLE RS-Object AS CHARACTER
     1294        VIEW-AS RADIO-SET HORIZONTAL
     1295        RADIO-BUTTONS
     1296             "Item 1", "1",
     1297   "Item 2", "2"
     1298        SIZE 18.13 BY .83 NO-UNDO.
     1299   DEFINE QUERY BR-prn-gds FOR
     1300                   buf_fbr-prn-gds,
     1301                   buf_goods SCROLLING.
     1302   DEFINE BROWSE BR-prn-gds
     1303     QUERY BR-prn-gds NO-LOCK DISPLAY
     1304         buf_fbr-prn-gds.prn-num COLUMN-LABEL "N!пр-ра" FORMAT ">>9":U
     1305         get-fbr-obj-name(buf_fbr-prn-gds.db-num, buf_fbr-prn-gds.prn-num) COLUMN-LABEL "Принтер!установлен" FORMAT "X(8)":U
     1306         buf_goods.gds-code FORMAT "999999999":U
     1307         buf_goods.gds-name FORMAT "X(48)":U
     1308         buf_fbr-prn-gds.obj-type + string(buf_fbr-prn-gds.obj-code) COLUMN-LABEL "Объект!товара" FORMAT "X(8)":U
     1309       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16.71.
     1310   DEFINE FRAME Dialog-Frame
     1311        B-exit AT ROW 1 COL 1
     1312        B-add AT ROW 1 COL 21
     1313        B-delete AT ROW 1 COL 31
     1314        B-chg AT ROW 1 COL 41
     1315        B-gds AT ROW 1 COL 51
     1316        B-print AT ROW 1 COL 89
     1317        B-sch AT ROW 1 COL 92
     1318        B-help AT ROW 1 COL 95
     1319        f-object AT ROW 2.5 COL 22.25 NO-LABEL
     1320        RS-Object AT ROW 2.54 COL 1.88 NO-LABEL
     1321        BR-prn-gds AT ROW 3.58 COL 1
     1322        sch-code AT ROW 20.71 COL 40 COLON-ALIGNED
     1323        sch-num AT ROW 20.79 COL 19.63 COLON-ALIGNED
     1324        "ПОИСК ПО" VIEW-AS TEXT
     1325             SIZE 9.25 BY 1 AT ROW 20.79 COL 1.5
     1326             FGCOLOR 4
     1327        SPACE(88.49) SKIP(0.24)
     1328       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1329            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1330            TITLE "Товары на принтере кухни"
     1331            DEFAULT-BUTTON B-exit.
     1332   ASSIGN
     1333          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1334          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1335   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1336   DO:
     1337     APPLY "END-ERROR":U TO SELF.
     1338   END.
     1339   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1340   DO:
     1341     run proc-add in this-procedure no-error.
     1342     if error-status:error then return no-apply.
     1343   END.
     1344   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1345   DO:
     1346     run proc-chg in this-procedure no-error.
     1347     if error-status:error then return no-apply.
     1348   END.
     1349   ON CHOOSE OF B-delete IN FRAME Dialog-Frame
     1350   DO:
     1351   define buffer del_fbr-prn-gds for ub.fbr-prn-gds.
     1352   define variable loc#log as logical no-undo .
     1353   define variable glog as logical no-undo .
     1354   if not available buf_fbr-prn-gds then return no-apply.
     1355     define variable v-chk-act-host-code as integer   no-undo .
     1356   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1357   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1358     (input  buf_fbr-prn-gds.obj-type
     1359     ,input  buf_fbr-prn-gds.obj-code
     1360     ,output v-chk-act-host-code
     1361     )  .
     1362   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1363   do:
     1364     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1365       (input  v-cntxt-db-num
     1366       ,input  v-cntxt-userid
     1367       ,input  0
     1368       ,input  'actn_fbr-prn-goods_work':U
     1369       ,input  'object':U
     1370       ,input  v-chk-act-host-code
     1371       ,input  buf_fbr-prn-gds.obj-type
     1372       ,input  buf_fbr-prn-gds.obj-code
     1373       ,input  0
     1374       ,input  0
     1375       ,input  0
     1376       ,input  true
     1377       ,output loc#log
     1378       )  .
     1379   end.
     1380     if not loc#log then return no-apply.
     1381   glog = no.
     1382   message
     1383   "После удаления данный товар (блюдо) НЕ БУДЕТ" skip
     1384   "автоматически появляться (печататься)" skip
     1385   "на ЭТОМ принтера ( с номером " buf_fbr-prn-gds.prn-num " )" skip
     1386   "при заказе его на объекте" buf_fbr-prn-gds.obj-type buf_fbr-prn-gds.obj-code skip(1)
     1387   "Вы уверены ?" skip
     1388   " "
     1389   view-as alert-box question buttons OK-Cancel update glog.
     1390   if not glog then return no-apply.
     1391   FIND del_fbr-prn-gds WHERE recid( del_fbr-prn-gds ) = recid(buf_fbr-prn-gds) exclusive.
     1392   delete del_fbr-prn-gds .
     1393   RUN OpenBr in this-procedure ( input yes, input no, input "":U).
     1394   END.
     1395   ON CHOOSE OF B-gds IN FRAME Dialog-Frame
     1396   DO:
     1397   define variable gds-rec as recid no-undo .
     1398      if not available buf_goods then return no-apply.
     1399       gds-rec = recid (buf_goods).
     1400       run ref/gds-form.w ( input parparentproc
     1401                           ,input 'ПРОСМОТР':U
     1402                           ,input p-obj-type
     1403                           ,input p-obj-code
     1404                           ,input this-procedure:handle
     1405                           ,input-output gds-rec).
     1406       apply "entry" to br-prn-gds in frame Dialog-Frame.
     1407       return no-apply.
     1408   END.
     1409   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1410   DO:
     1411     run proc-print in this-procedure no-error.
     1412     if error-status:error then return no-apply.
     1413   END.
     1414   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1415   DO:
     1416     run proc-sch in this-procedure no-error.
     1417     if error-status:error then return no-apply.
     1418   END.
     1419   ON VALUE-CHANGED OF RS-Object IN FRAME Dialog-Frame
     1420   DO:
     1421   define variable v-host-code like ub.sysconf.host-code no-undo .
     1422   define buffer loc_clients for ub.clients.
     1423     Assign
     1424     Rs-object.
     1425     CASE RS-object:screen-value:
     1426       when 'все':U then do:
     1427       assign
     1428       RS-object
     1429       v-list = 'все':U
     1430       p-obj-type = "":U
     1431       p-obj-code = 0
     1432       .
     1433       DIsplay
     1434       "":U @ f-object
     1435       with frame Dialog-Frame
     1436       .
     1437     end.
     1438     when 'объект':U
     1439     then do:
     1440       define variable v-user-select as logical   no-undo .
     1441       define variable v-obj-type    as character no-undo .
     1442       define variable v-obj-code    as integer   no-undo .
     1443   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1444   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1445     (input  p-obj-type
     1446     ,input  p-obj-code
     1447     ,output v-host-code
     1448     )  .
     1449   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1450   run userobjs_select-one in this-procedure
     1451     (input  parparentproc
     1452     ,input  v-cntxt-db-num
     1453     ,input  v-cntxt-userid
     1454     ,input  v-host-code
     1455     ,input  p-obj-type
     1456     ,input  p-obj-code
     1457     ,output v-user-select
     1458     ,output v-obj-type
     1459     ,output v-obj-code
     1460     )  .
     1461       if v-user-select <> true
     1462       then do:
     1463         RS-object:screen-value = 'все':U.
     1464         return no-apply.
     1465       end.
     1466       find first loc_clients no-lock
     1467         where loc_clients.obj-type = v-obj-type
     1468           and loc_clients.obj-code = v-obj-code
     1469         no-error .
     1470       if not available loc_clients
     1471       then do:
     1472           RS-object:screen-value = 'все':U.
     1473           return no-apply.
     1474         end.
     1475       if loc_clients.db-num <> v-db-num then do:
     1476         message
     1477         "Можно выбать только объект текущей БД"
     1478         view-as alert-box error.
     1479         RS-object:screen-value = 'все':U.
     1480         return no-apply.
     1481       end.
     1482       assign
     1483       v-list = 'объект':U
     1484       p-obj-type = loc_clients.obj-type
     1485       p-obj-code = loc_clients.obj-code
     1486       RS-object
     1487       .
     1488           DIsplay
     1489       (p-obj-type + string(p-obj-code)) @ f-object
     1490       with frame Dialog-Frame
     1491       .
     1492       end.
     1493     END CASE.
     1494     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     1495   END.
     1496   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1497   DO:
     1498     run proc-find-code in this-procedure ( input yes, input frame Dialog-Frame sch-code) no-error.
     1499     if error-status:error then return no-apply.
     1500   END.
     1501   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1502   DO:
     1503     run proc-find-code in this-procedure ( input no, input frame Dialog-Frame sch-code) no-error.
     1504     if error-status:error then return no-apply.
     1505   END.
     1506   ON CTRL-J OF sch-num IN FRAME Dialog-Frame
     1507   DO:
     1508     run proc-find-num in this-procedure ( input yes, input frame Dialog-Frame sch-num) no-error.
     1509     if error-status:error then return no-apply.
     1510   END.
     1511   ON RETURN OF sch-num IN FRAME Dialog-Frame
     1512   DO:
     1513     run proc-find-num in this-procedure ( input no, input frame Dialog-Frame sch-num) no-error.
     1514     if error-status:error then return no-apply.
     1515   END.
     1516   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1517   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1518   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1519   on help of frame Dialog-Frame
     1520   do:
     1521     run gbl/app_help.p
     1522       (input this-procedure :file-name
     1523       ,input ''
     1524       ,input ?
     1525       ) no-error.
     1526     if error-status :error then do:
     1527       message
     1528         "Ошибка при вызове помощи"
     1529         error-status :get-message(1)
     1530         view-as alert-box .
     1531     end.
     1532   end.
     1533   run minbtn-set in this-procedure .
     1534   on choose of b-help in frame Dialog-Frame
     1535   do:
     1536     apply "help":u to frame Dialog-Frame .
     1537   end.
     1538   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1539   procedure minbtn-set :
     1540       do
     1541           on error undo, return error return-value
     1542           :
     1543           define variable ii              as integer       no-undo .
     1544           define variable fh              as widget-handle no-undo .
     1545           define variable hh              as widget-handle no-undo .
     1546           define variable v-h             as handle        extent 4 no-undo .
     1547           define variable v-name-button   as character     no-undo .
     1548           define variable v-help-old-x    as decimal       no-undo .
     1549           define variable v-help-old-y    as decimal       no-undo .
     1550           define variable v-help-old-size as decimal       no-undo .
     1551           define variable v-frame-width   as decimal       no-undo .
     1552           define variable jj              as integer       no-undo .
     1553           do
     1554               on error undo, return error
     1555               :
     1556               assign
     1557                   v-frame-width = frame Dialog-Frame:width - 0.3
     1558                   fh            = frame Dialog-Frame:first-child
     1559                   hh            = fh:first-child
     1560                   ii            = 1
     1561                   .
     1562               do while valid-handle(hh):
     1563                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1564                   do:
     1565                       case lc(hh:name) :
     1566                           when "b-help" then
     1567                               do:
     1568                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1569                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1570                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1571                                   hh:TOOLTIP = "Помощь" .
     1572                                   v-help-old-x = hh:column .
     1573                                   v-help-old-y = hh:row    .
     1574                                   v-help-old-size = hh:width .
     1575                                   hh:width-chars = 2.5 .
     1576                               end.
     1577                           when "b-print" then
     1578                               do:
     1579                                   hh:load-image("cmp/b-print.bmp":u) .
     1580                                   hh:TOOLTIP = "Печать" .
     1581                                   v-h[ii] = hh:handle .
     1582                                   ii = ii + 1 .
     1583                                   hh:width-chars = 3 .
     1584                               end.
     1585                           when "b-history" or
     1586                           when "b-hist" then
     1587                               do:
     1588                                   hh:load-image("cmp/b-hist.bmp":u) .
     1589                                   hh:TOOLTIP = "История" .
     1590                                   v-h[ii] = hh:handle .
     1591                                   ii = ii + 1 .
     1592                                   hh:width-chars = 3 .
     1593                               end.
     1594                           when "b-sch" then
     1595                               do:
     1596                                   hh:load-image("cmp/b-sch.bmp":u) .
     1597                                   hh:TOOLTIP = "Установка Фильтра" .
     1598                                   v-h[ii] = hh:handle .
     1599                                   ii = ii + 1 .
     1600                                   hh:width-chars = 3 .
     1601                               end.
     1602                           when "b-hist-user" then
     1603                               do:
     1604                                   hh:load-image("cmp/b-hist.bmp":u) .
     1605                                   hh:TOOLTIP = "История пользователя" .
     1606                                   ii = ii + 1 .
     1607                               end.
     1608                       end case.
     1609                   end.
     1610                   hh = hh:next-sibling.
     1611               end.
     1612               b-help:column = v-frame-width - b-help:width-chars.
     1613               jj = 0.
     1614               repeat ii = 4 to 1 by -1 :
     1615                   if valid-handle (v-h[ii] ) then
     1616                   do:
     1617                       jj  = jj + 1 .
     1618                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1619                       v-h[ii]:row    = v-help-old-y .
     1620                   end.
     1621               end.
     1622           end.
     1623       end.
     1624   end procedure.
     1625   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1626   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1627   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1628   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1629   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1630   define variable v-diasize-current-frame-height as decimal   no-undo .
     1631   define variable v-diasize-change-size          as logical   no-undo .
     1632   define variable v-diasize-resize-button        as handle    no-undo .
     1633   define variable v-diasize-wndmax               as logical   no-undo .
     1634   define variable v-diasize-wndstore             as logical   no-undo .
     1635   define variable v-diasize-proc-name            as character no-undo .
     1636   define variable v-diasize-browse-handle        as handle    no-undo .
     1637   define variable v-diasize-browse-number        as integer   no-undo .
     1638   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1639   define temp-table temp-diasize-handle no-undo
     1640     field handle-value  as handle
     1641     field save-position as decimal
     1642     index xpk is primary unique handle-value
     1643     .
     1644   define temp-table temp-browse-handle no-undo
     1645     field browse-type   as character
     1646     field browse-number as integer
     1647     field browse-handle as handle
     1648     field original-size as decimal
     1649     index xpk is primary unique browse-type browse-number
     1650     index xie browse-type browse-handle
     1651   .
     1652   procedure diasize_change-height :
     1653     define input  parameter p-change-value  as decimal   no-undo .
     1654     define input  parameter p-move-resize   as logical   no-undo .
     1655     define variable v-field-group-handle    as handle    no-undo .
     1656     define variable v-object-handle         as handle    no-undo .
     1657     define variable v-frame-height          as decimal   no-undo .
     1658     define variable v-frame-virtual-height  as decimal   no-undo .
     1659     define variable v-browse-height         as decimal   no-undo .
     1660     define variable v-window-height         as decimal   no-undo .
     1661     define variable v-window-virtual-height as decimal   no-undo .
     1662     define variable v-change-sign           as integer   no-undo .
     1663     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1664     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1665     if p-change-value > 0
     1666     then do:
     1667       if frame Dialog-Frame :height + p-change-value
     1668           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1669       then do:
     1670         assign
     1671           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1672                           - (frame Dialog-Frame :height-chars)
     1673         .
     1674         if p-change-value <= 0
     1675         then do:
     1676           run diasize_position-resize-button in this-procedure .
     1677           return .
     1678         end.
     1679       end.
     1680     end.
     1681     if p-change-value < 0
     1682     then do:
     1683       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1684       then do:
     1685         assign
     1686           p-change-value = v-diasize-orig-frame-height
     1687                          - (frame Dialog-Frame :height-chars)
     1688         .
     1689         if p-change-value >= 0
     1690         then do:
     1691           run diasize_position-resize-button in this-procedure .
     1692           return .
     1693         end.
     1694       end.
     1695     end.
     1696     if p-change-value >= 0
     1697     then do:
     1698       assign
     1699         v-change-sign = 1
     1700       .
     1701     end.
     1702     else do:
     1703       assign
     1704         v-change-sign = -1
     1705       .
     1706     end.
     1707     assign
     1708       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1709     .
     1710     if p-change-value = 0
     1711     then do:
     1712       run diasize_position-resize-button in this-procedure .
     1713       return .
     1714     end.
     1715     move_block:
     1716     do
     1717     on error undo move_block, retry move_block
     1718     :
     1719       if retry
     1720       then do:
     1721         do
     1722         on error undo move_block, leave move_block
     1723         :
     1724           if p-change-value > 0
     1725           then do:
     1726             for each buf_temp-diasize-handle
     1727             on error undo, next
     1728             :
     1729               assign
     1730                 v-object-handle = buf_temp-diasize-handle.handle-value
     1731               .
     1732               if v-object-handle <> v-diasize-resize-button
     1733               then do:
     1734                 assign
     1735                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1736                 .
     1737               end.
     1738             end.
     1739             assign
     1740               v-diasize-browse-handle :height = v-browse-height
     1741             .
     1742             for each buf_temp-browse-handle
     1743               where buf_temp-browse-handle.browse-type = 'height':u
     1744             on error undo, next
     1745             :
     1746               assign
     1747                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1748               .
     1749             end.
     1750             assign
     1751               frame Dialog-Frame :height = v-frame-height
     1752             .
     1753             if frame Dialog-Frame :scrollable = true
     1754             then do:
     1755               assign
     1756                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1757               .
     1758             end.
     1759             run diasize_position-resize-button in this-procedure .
     1760           end.
     1761           else do:
     1762             if frame Dialog-Frame :scrollable = true
     1763             then do:
     1764               assign
     1765                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1766               .
     1767             end.
     1768             assign
     1769               frame Dialog-Frame :height = v-frame-height
     1770             .
     1771             assign
     1772               v-diasize-browse-handle :height = v-browse-height
     1773             .
     1774             for each buf_temp-browse-handle
     1775               where buf_temp-browse-handle.browse-type = 'height':u
     1776             on error undo, next
     1777             :
     1778               assign
     1779                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1780               .
     1781             end.
     1782             for each buf_temp-diasize-handle
     1783             on error undo, next
     1784             :
     1785               assign
     1786                 v-object-handle = buf_temp-diasize-handle.handle-value
     1787               .
     1788               if v-object-handle <> v-diasize-resize-button
     1789               then do:
     1790                 assign
     1791                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1792                 .
     1793               end.
     1794             end.
     1795             run diasize_position-resize-button in this-procedure .
     1796           end.
     1797           assign
     1798             v-diasize-change-size = false
     1799           .
     1800           leave move_block .
     1801         end.
     1802       end.
     1803       assign
     1804         v-diasize-need-full-display = true
     1805       .
     1806       if v-diasize-change-size = false
     1807       then do:
     1808         assign
     1809           v-diasize-change-size = true
     1810         .
     1811       end.
     1812       else do:
     1813         return .
     1814       end.
     1815       assign
     1816         v-frame-height = frame Dialog-Frame :height
     1817         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1818         v-browse-height = v-diasize-browse-handle :height
     1819       .
     1820       for each buf_temp-browse-handle
     1821         where buf_temp-browse-handle.browse-type = 'height':u
     1822       :
     1823         assign
     1824           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1825         .
     1826       end.
     1827       for each buf_temp-diasize-handle
     1828       :
     1829         delete buf_temp-diasize-handle .
     1830       end.
     1831       assign
     1832         v-field-group-handle = frame Dialog-Frame :first-child
     1833       .
     1834       do while valid-handle(v-field-group-handle)
     1835       :
     1836         assign
     1837           v-object-handle = v-field-group-handle :first-child
     1838         .
     1839         do while valid-handle(v-object-handle)
     1840         :
     1841           if  v-object-handle <> v-diasize-browse-handle :handle
     1842           and can-query(v-object-handle, "row")
     1843           and can-query(v-object-handle, "height")
     1844           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1845           then do:
     1846             find first buf_temp-browse-handle
     1847               where buf_temp-browse-handle.browse-type   = 'height':u
     1848                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1849               no-error .
     1850             if available buf_temp-browse-handle
     1851             then do:
     1852             end.
     1853             else do:
     1854               create buf_temp-diasize-handle .
     1855               assign
     1856                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1857                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1858               .
     1859             end.
     1860           end.
     1861           assign
     1862             v-object-handle = v-object-handle :next-sibling
     1863           .
     1864         end.
     1865         assign
     1866           v-field-group-handle = v-field-group-handle :next-sibling
     1867         .
     1868       end.
     1869       do with frame Dialog-Frame
     1870       :
     1871         hide v-diasize-resize-button .
     1872         assign
     1873           v-diasize-resize-button :row    = 1
     1874           v-diasize-resize-button :column = 1
     1875         .
     1876       end.
     1877       if p-change-value > 0
     1878       then do:
     1879         if frame Dialog-Frame :scrollable = true
     1880         then do:
     1881           assign
     1882             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1883             no-error .
     1884           if error-status :error
     1885           or error-status :get-message(1) <> ""
     1886           then do:
     1887             undo move_block, retry move_block .
     1888           end.
     1889         end.
     1890         assign
     1891           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1892           no-error .
     1893         if error-status :error
     1894         or error-status :get-message(1) <> ""
     1895         then do:
     1896           undo move_block, retry move_block .
     1897         end.
     1898         assign
     1899           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1900           no-error .
     1901         if error-status :error
     1902         or error-status :get-message(1) <> ""
     1903         then do:
     1904           undo move_block, retry move_block .
     1905         end.
     1906         for each buf_temp-browse-handle
     1907           where buf_temp-browse-handle.browse-type = 'height':u
     1908         on error undo move_block, retry move_block
     1909         :
     1910           assign
     1911             buf_temp-browse-handle.browse-handle :height
     1912               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1913             no-error .
     1914           if error-status :error
     1915           or error-status :get-message(1) <> ""
     1916           then do:
     1917             undo move_block, retry move_block .
     1918           end.
     1919         end.
     1920         for each buf_temp-diasize-handle
     1921         on error undo move_block, retry move_block
     1922         :
     1923           assign
     1924             v-object-handle = buf_temp-diasize-handle.handle-value
     1925           .
     1926           if v-object-handle <> v-diasize-resize-button
     1927           then do:
     1928             assign
     1929               v-object-handle :row = v-object-handle :row + p-change-value
     1930               no-error .
     1931             if error-status :error
     1932             or error-status :get-message(1) <> ""
     1933             then do:
     1934               undo move_block, retry move_block .
     1935             end.
     1936           end.
     1937         end.
     1938       end.
     1939       else do:
     1940         for each buf_temp-diasize-handle
     1941         on error undo move_block, retry move_block
     1942         :
     1943           assign
     1944             v-object-handle = buf_temp-diasize-handle.handle-value
     1945           .
     1946           if v-object-handle <> v-diasize-resize-button
     1947           then do:
     1948             assign
     1949               v-object-handle :row = v-object-handle :row + p-change-value
     1950               no-error .
     1951             if error-status :error
     1952             or error-status :get-message(1) <> ""
     1953             then do:
     1954               undo move_block, retry move_block .
     1955             end.
     1956           end.
     1957         end.
     1958         assign
     1959           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1960           no-error .
     1961         if error-status :error
     1962         or error-status :get-message(1) <> ""
     1963         then do:
     1964           undo move_block, retry move_block .
     1965         end.
     1966         for each buf_temp-browse-handle
     1967           where buf_temp-browse-handle.browse-type = 'height':u
     1968         on error undo move_block, retry move_block
     1969         :
     1970           assign
     1971             buf_temp-browse-handle.browse-handle :height
     1972               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1973             no-error .
     1974           if error-status :error
     1975           or error-status :get-message(1) <> ""
     1976           then do:
     1977             undo move_block, retry move_block .
     1978           end.
     1979         end.
     1980         assign
     1981           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1982           no-error .
     1983         if error-status :error
     1984         or error-status :get-message(1) <> ""
     1985         then do:
     1986           undo move_block, retry move_block .
     1987         end.
     1988         if frame Dialog-Frame :scrollable = true
     1989         then do:
     1990           assign
     1991             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1992             no-error .
     1993           if error-status :error
     1994           or error-status :get-message(1) <> ""
     1995           then do:
     1996             undo move_block, retry move_block .
     1997           end.
     1998         end.
     1999       end.
     2000       if p-move-resize = true
     2001       then do:
     2002         run diasize_position-resize-button in this-procedure .
     2003       end.
     2004       if v-diasize-wndstore = true
     2005       then do:
     2006         if connected("ub") = true
     2007         then do:
     2008           define variable v-cntxt-db-num        as integer   no-undo .
     2009           define variable v-cntxt-userid        as character no-undo .
     2010           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2011                                             , OUTPUT v-cntxt-userid
     2012                                             ) .
     2013           run gbl/wndsizew.p
     2014             (input  v-cntxt-db-num
     2015             ,input  v-cntxt-userid
     2016             ,input  v-diasize-proc-name
     2017             ,input  'height':u
     2018             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2019             ) .
     2020         end.
     2021       end.
     2022     end.
     2023     assign
     2024       v-diasize-change-size = false
     2025     .
     2026   end procedure.
     2027   procedure diasize_set-height :
     2028     define input  parameter p-new-height  as decimal   no-undo .
     2029     define input  parameter p-move-resize as logical   no-undo .
     2030     do
     2031     on error undo, return error return-value
     2032     :
     2033       run diasize_change-height in this-procedure
     2034         (input  (p-new-height - frame Dialog-Frame :height)
     2035         ,input  p-move-resize
     2036         ) .
     2037     end.
     2038   end procedure.
     2039   procedure diasize_change-width :
     2040     define input  parameter p-change-value as decimal   no-undo .
     2041     define input  parameter p-move-resize  as logical   no-undo .
     2042     define variable v-field-group-handle   as handle    no-undo .
     2043     define variable v-object-handle        as handle    no-undo .
     2044     define variable v-frame-width          as decimal   no-undo .
     2045     define variable v-frame-virtual-width  as decimal   no-undo .
     2046     define variable v-browse-width         as decimal   no-undo .
     2047     define variable v-window-width         as decimal   no-undo .
     2048     define variable v-window-virtual-width as decimal   no-undo .
     2049     define variable v-change-sign          as integer   no-undo .
     2050     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2051     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2052     if p-change-value > 0
     2053     then do:
     2054       if frame Dialog-Frame :width + p-change-value >
     2055           session :width-chars
     2056       then do:
     2057         assign
     2058           p-change-value = session :width-chars - frame Dialog-Frame :width
     2059         .
     2060         if p-change-value <= 0
     2061         then do:
     2062           run diasize_position-resize-button in this-procedure .
     2063           return .
     2064         end.
     2065       end.
     2066     end.
     2067     if p-change-value < 0
     2068     then do:
     2069       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2070       then do:
     2071         assign
     2072           p-change-value = v-diasize-orig-frame-width
     2073                          - frame Dialog-Frame :width
     2074         .
     2075         if p-change-value >= 0
     2076         then do:
     2077           run diasize_position-resize-button in this-procedure .
     2078           return .
     2079         end.
     2080       end.
     2081     end.
     2082     if p-change-value >= 0
     2083     then do:
     2084       assign
     2085         v-change-sign = 1
     2086       .
     2087     end.
     2088     else do:
     2089       assign
     2090         v-change-sign = -1
     2091       .
     2092     end.
     2093     assign
     2094       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2095     .
     2096     if p-change-value = 0
     2097     then do:
     2098       run diasize_position-resize-button in this-procedure .
     2099       return .
     2100     end.
     2101     move_block:
     2102     do
     2103     on error undo move_block, leave move_block
     2104     :
     2105       if retry
     2106       then do:
     2107         do
     2108         on error undo move_block, leave move_block
     2109         :
     2110           if p-change-value > 0
     2111           then do:
     2112             for each buf_temp-diasize-handle
     2113             on error undo, next
     2114             :
     2115               assign
     2116                 v-object-handle = buf_temp-diasize-handle.handle-value
     2117               .
     2118               if v-object-handle <> v-diasize-resize-button
     2119               then do:
     2120                 assign
     2121                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2122                 .
     2123               end.
     2124             end.
     2125             assign
     2126               v-diasize-browse-handle :width = v-browse-width
     2127             .
     2128             for each buf_temp-browse-handle
     2129               where buf_temp-browse-handle.browse-type = 'width':u
     2130             on error undo, next
     2131             :
     2132               assign
     2133                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2134               .
     2135             end.
     2136             assign
     2137               frame Dialog-Frame :width = v-frame-width
     2138             .
     2139             if frame Dialog-Frame :scrollable = true
     2140             then do:
     2141               assign
     2142                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2143               .
     2144             end.
     2145             run diasize_position-resize-button in this-procedure .
     2146           end.
     2147           else do:
     2148             if frame Dialog-Frame :scrollable = true
     2149             then do:
     2150               assign
     2151                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2152               .
     2153             end.
     2154             assign
     2155               frame Dialog-Frame :width = v-frame-width
     2156             .
     2157             for each buf_temp-browse-handle
     2158               where buf_temp-browse-handle.browse-type = 'width':u
     2159             on error undo, next
     2160             :
     2161               assign
     2162                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2163               .
     2164             end.
     2165             assign
     2166               v-diasize-browse-handle :width = v-browse-width
     2167             .
     2168             for each buf_temp-diasize-handle
     2169             on error undo, next
     2170             :
     2171               assign
     2172                 v-object-handle = buf_temp-diasize-handle.handle-value
     2173               .
     2174               if v-object-handle <> v-diasize-resize-button
     2175               then do:
     2176                 assign
     2177                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2178                 .
     2179               end.
     2180             end.
     2181             run diasize_position-resize-button in this-procedure .
     2182           end.
     2183           assign
     2184             v-diasize-change-size = false
     2185           .
     2186           leave move_block .
     2187         end.
     2188       end.
     2189       assign
     2190         v-diasize-need-full-display = true
     2191       .
     2192       if v-diasize-change-size = false
     2193       then do:
     2194         assign
     2195           v-diasize-change-size = true
     2196         .
     2197       end.
     2198       else do:
     2199         return .
     2200       end.
     2201       assign
     2202         v-frame-width = frame Dialog-Frame :width
     2203         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2204         v-browse-width = v-diasize-browse-handle :width
     2205       .
     2206       for each buf_temp-browse-handle
     2207         where buf_temp-browse-handle.browse-type = 'width':u
     2208       :
     2209         assign
     2210           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2211         .
     2212       end.
     2213       for each buf_temp-diasize-handle
     2214       :
     2215         delete buf_temp-diasize-handle .
     2216       end.
     2217       assign
     2218         v-field-group-handle = frame Dialog-Frame :first-child
     2219       .
     2220       do while valid-handle(v-field-group-handle)
     2221       :
     2222         assign
     2223           v-object-handle = v-field-group-handle :first-child
     2224         .
     2225         do while valid-handle(v-object-handle)
     2226         :
     2227           if  v-object-handle <> v-diasize-browse-handle :handle
     2228           and v-object-handle <> v-diasize-resize-button
     2229           and can-query(v-object-handle, "row")
     2230           and can-query(v-object-handle, "height")
     2231           and ( v-object-handle :col + v-object-handle :width
     2232                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2233               )
     2234           then do:
     2235             find first buf_temp-browse-handle
     2236               where buf_temp-browse-handle.browse-type   = 'width':u
     2237                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2238               no-error .
     2239             if available buf_temp-browse-handle
     2240             then do:
     2241             end.
     2242             else do:
     2243               create buf_temp-diasize-handle .
     2244               assign
     2245                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2246                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2247               .
     2248             end.
     2249           end.
     2250           assign
     2251             v-object-handle = v-object-handle :next-sibling
     2252           .
     2253         end.
     2254         assign
     2255           v-field-group-handle = v-field-group-handle :next-sibling
     2256         .
     2257       end.
     2258       do with frame Dialog-Frame
     2259       :
     2260         hide v-diasize-resize-button .
     2261         v-diasize-resize-button :row = 1.
     2262         v-diasize-resize-button :column = 1.
     2263       end.
     2264       if p-change-value > 0
     2265       then do:
     2266         if frame Dialog-Frame :scrollable = true
     2267         then do:
     2268           assign
     2269             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2270             no-error .
     2271           if error-status :error
     2272           or error-status :get-message(1) <> ""
     2273           then do:
     2274             undo move_block, retry move_block.
     2275           end.
     2276         end.
     2277         assign
     2278           frame Dialog-Frame :width = v-frame-width + p-change-value
     2279           no-error .
     2280         if error-status :error
     2281         or error-status :get-message(1) <> ""
     2282         then do:
     2283           undo move_block, retry move_block.
     2284         end.
     2285         assign
     2286           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2287         no-error .
     2288         if error-status :error
     2289         or error-status :get-message(1) <> ""
     2290         then do:
     2291           undo move_block, retry move_block.
     2292         end.
     2293         for each buf_temp-browse-handle
     2294           where buf_temp-browse-handle.browse-type = 'width':u
     2295         on error undo move_block, retry move_block
     2296         :
     2297           assign
     2298             buf_temp-browse-handle.browse-handle :width
     2299               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2300             no-error .
     2301           if error-status :error
     2302           or error-status :get-message(1) <> ""
     2303           then do:
     2304             undo move_block, retry move_block .
     2305           end.
     2306         end.
     2307         for each buf_temp-diasize-handle
     2308         on error undo move_block, retry move_block
     2309         :
     2310           assign
     2311             v-object-handle = buf_temp-diasize-handle.handle-value
     2312           .
     2313           if v-object-handle <> v-diasize-resize-button
     2314           then do:
     2315             assign
     2316               v-object-handle :col = v-object-handle :col + p-change-value
     2317               no-error .
     2318             if error-status :error
     2319             or error-status :get-message(1) <> ""
     2320             then do:
     2321               undo move_block, retry move_block .
     2322             end.
     2323           end.
     2324         end.
     2325       end.
     2326       else do:
     2327         for each buf_temp-diasize-handle
     2328         on error undo move_block, retry move_block
     2329         :
     2330           assign
     2331             v-object-handle = buf_temp-diasize-handle.handle-value
     2332           .
     2333           if v-object-handle <> v-diasize-resize-button
     2334           then do:
     2335             assign
     2336               v-object-handle :col = v-object-handle :col + p-change-value
     2337               no-error .
     2338             if error-status :error
     2339             or error-status :get-message(1) <> ""
     2340             then do:
     2341               undo move_block, retry move_block .
     2342             end.
     2343           end.
     2344         end.
     2345         for each buf_temp-browse-handle
     2346           where buf_temp-browse-handle.browse-type = 'width':u
     2347         on error undo move_block, retry move_block
     2348         :
     2349           assign
     2350             buf_temp-browse-handle.browse-handle :width
     2351               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2352             no-error .
     2353           if error-status :error
     2354           or error-status :get-message(1) <> ""
     2355           then do:
     2356             undo move_block, retry move_block .
     2357           end.
     2358         end.
     2359         assign
     2360           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2361           no-error .
     2362         if error-status :error
     2363         or error-status :get-message(1) <> ""
     2364         then do:
     2365           undo move_block, retry move_block.
     2366         end.
     2367         assign
     2368           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2369         no-error .
     2370         if error-status :error
     2371         or error-status :get-message(1) <> ""
     2372         then do:
     2373           undo move_block, retry move_block.
     2374         end.
     2375         if frame Dialog-Frame :scrollable = true
     2376         then do:
     2377           assign
     2378             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2379           no-error .
     2380           if error-status :error
     2381           or error-status :get-message(1) <> ""
     2382           then do:
     2383             undo move_block, retry move_block.
     2384           end.
     2385         end.
     2386       end.
     2387       if p-move-resize
     2388       then do:
     2389         run diasize_position-resize-button in this-procedure .
     2390       end.
     2391       if v-diasize-wndstore = true
     2392       then do:
     2393         if connected("ub") = true
     2394         then do:
     2395           define variable v-cntxt-db-num        as integer   no-undo .
     2396           define variable v-cntxt-userid        as character no-undo .
     2397           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2398                                             , OUTPUT v-cntxt-userid
     2399                                             ) .
     2400           run gbl/wndsizew.p
     2401             (input  v-cntxt-db-num
     2402             ,input  v-cntxt-userid
     2403             ,input  v-diasize-proc-name
     2404             ,input  'width':u
     2405             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2406             ) .
     2407         end.
     2408       end.
     2409     end.
     2410     assign
     2411       v-diasize-change-size = false
     2412     .
     2413   end procedure.
     2414   procedure diasize_set-width :
     2415     define input  parameter p-new-width  as decimal   no-undo .
     2416     define input  parameter p-move-resize as logical   no-undo .
     2417     do
     2418     on error undo, return error return-value
     2419     :
     2420       run diasize_change-width in this-procedure
     2421         (input  (p-new-width - frame Dialog-Frame :width)
     2422         ,input  p-move-resize
     2423         ) .
     2424     end.
     2425   end procedure.
     2426   procedure diasize_position-resize-button :
     2427     do with frame Dialog-Frame
     2428     :
     2429       hide v-diasize-resize-button .
     2430       assign
     2431         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2432                     - 1
     2433                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2434         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2435                     - 1
     2436                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2437       .
     2438       view v-diasize-resize-button .
     2439     end.
     2440   end procedure.
     2441   on alt-right anywhere
     2442   do:
     2443     run diasize_change-width in this-procedure
     2444       (input 1
     2445       ,input true
     2446       ) .
     2447     return no-apply .
     2448   end.
     2449   on alt-left anywhere
     2450   do:
     2451     run diasize_change-width in this-procedure
     2452       (input -1
     2453       ,input true
     2454       ) .
     2455     return no-apply .
     2456   end.
     2457   on alt-down anywhere
     2458   do:
     2459     run diasize_change-height in this-procedure
     2460       (input 1
     2461       ,input true
     2462       ) .
     2463     return no-apply .
     2464   end.
     2465   on alt-up anywhere
     2466   do:
     2467     run diasize_change-height in this-procedure
     2468       (input -1
     2469       ,input true
     2470       ) .
     2471     return no-apply .
     2472   end.
     2473   on alt-enter of frame Dialog-Frame
     2474   do:
     2475     run diasize_maximize in this-procedure
     2476       (input  ?
     2477       ).
     2478     return no-apply .
     2479   end.
     2480   procedure diasize_end-move :
     2481     do
     2482     on error undo, return error return-value
     2483     :
     2484       define variable v-row-delta as decimal   no-undo .
     2485       define variable v-col-delta as decimal   no-undo .
     2486       define variable v-new-row as decimal   no-undo .
     2487       define variable v-new-col as decimal   no-undo .
     2488       assign
     2489         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2490         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2491       .
     2492       assign
     2493         v-row-delta = v-new-row - frame Dialog-Frame :height
     2494         v-col-delta = v-new-col - frame Dialog-Frame :width
     2495       .
     2496       run diasize_change-height in this-procedure
     2497         (input v-row-delta
     2498         ,input true
     2499         ) .
     2500       run diasize_change-width in this-procedure
     2501         (input v-col-delta
     2502         ,input true
     2503         ) .
     2504     end.
     2505   end procedure.
     2506   procedure diasize_maximize :
     2507     define input  parameter p-action as logical   no-undo .
     2508     do
     2509     on error undo, return error return-value
     2510     :
     2511       if p-action = ?
     2512       then do:
     2513         if v-diasize-need-maximize = true
     2514         then do:
     2515           assign
     2516             p-action = true
     2517           .
     2518         end.
     2519         else do:
     2520           assign
     2521             p-action = false
     2522           .
     2523         end.
     2524       end.
     2525       if p-action = true
     2526       then do:
     2527         run diasize_change-height in this-procedure
     2528           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2529               - frame Dialog-Frame :height-chars
     2530           ,input true
     2531           ) .
     2532         run diasize_change-width in this-procedure
     2533           (input session :width-chars
     2534               - frame Dialog-Frame :width-chars
     2535           ,input true
     2536           ) .
     2537         assign
     2538           v-diasize-need-maximize = false
     2539         .
     2540       end.
     2541       else do:
     2542         run diasize_change-width in this-procedure
     2543           (input v-diasize-orig-frame-width
     2544               - frame Dialog-Frame :width-chars
     2545           ,input true
     2546           ) .
     2547         run diasize_change-height in this-procedure
     2548           (input v-diasize-orig-frame-height
     2549               - frame Dialog-Frame :height-chars
     2550           ,input true
     2551           ) .
     2552         assign
     2553           v-diasize-need-maximize = true
     2554         .
     2555       end.
     2556     end.
     2557   end procedure.
     2558   procedure diasize_restore-orig-size :
     2559     do
     2560     on error undo, return error return-value
     2561     :
     2562       assign
     2563         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2564         v-diasize-current-frame-height = frame Dialog-Frame :height
     2565       .
     2566       run diasize_set-height in this-procedure
     2567         (input  v-diasize-orig-frame-height
     2568         ,input  true
     2569         ) .
     2570       run diasize_set-width in this-procedure
     2571         (input  v-diasize-orig-frame-width
     2572         ,input  true
     2573         ) .
     2574     end.
     2575   end procedure.
     2576   procedure diasize_restore-current-size :
     2577     do
     2578     on error undo, return error return-value
     2579     :
     2580       run diasize_set-height in this-procedure
     2581         (input  v-diasize-current-frame-height
     2582         ,input  true
     2583         ) .
     2584       run diasize_set-width in this-procedure
     2585         (input  v-diasize-current-frame-width
     2586         ,input  true
     2587         ) .
     2588     end.
     2589   end procedure.
     2590   procedure diasize_set-browse-handle :
     2591     define input  parameter p-browse-handle as handle   no-undo .
     2592     define buffer buf_temp-browse-handle for temp-browse-handle .
     2593     do
     2594     on error undo, return error return-value
     2595     :
     2596       assign
     2597         v-diasize-browse-handle = p-browse-handle
     2598       .
     2599       for each buf_temp-browse-handle
     2600       on error undo, return error return-value
     2601       :
     2602         delete buf_temp-browse-handle .
     2603       end.
     2604     end.
     2605   end procedure.
     2606   procedure diasize_add_browse :
     2607     define input  parameter p-browse-type   as character no-undo .
     2608     define input  parameter p-browse-handle as handle    no-undo .
     2609     define buffer buf_temp-browse-handle for temp-browse-handle .
     2610     do
     2611     on error undo, return error return-value
     2612     :
     2613       assign
     2614         v-diasize-browse-number = v-diasize-browse-number + 1
     2615       .
     2616       create buf_temp-browse-handle .
     2617       assign
     2618         buf_temp-browse-handle.browse-type   = p-browse-type
     2619         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2620         buf_temp-browse-handle.browse-handle = p-browse-handle
     2621       .
     2622     end.
     2623   end procedure.
     2624   procedure diasize_init :
     2625     define variable v-default-value    as logical   no-undo .
     2626     define variable v-restore-saved    as logical   no-undo .
     2627     define variable v-resize-value-str as character no-undo .
     2628     do
     2629     on error undo, return error return-value
     2630     :
     2631       do with frame Dialog-Frame
     2632       :
     2633         assign
     2634           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2635           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2636           v-diasize-browse-handle     = browse BR-prn-gds :handle
     2637         .
     2638         create button v-diasize-resize-button
     2639         assign
     2640           parent        = frame Dialog-Frame :first-child
     2641           label         = "s"
     2642           height-pixels = 16
     2643           width-pixels  = 16
     2644           visible       = true
     2645           sensitive     = true
     2646           movable       = true
     2647           triggers:
     2648             on end-move persistent run diasize_end-move in this-procedure .
     2649           end triggers.
     2650         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2651         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2652         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2653         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2654         assign
     2655           v-diasize-wndmax = false
     2656         .
     2657         if connected("ub") = true
     2658         then do:
     2659           define variable v-cntxt-db-num        as integer   no-undo .
     2660           define variable v-cntxt-userid        as character no-undo .
     2661           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2662                                             , OUTPUT v-cntxt-userid
     2663                                             ) .
     2664           run gbl/wndpar_r.p
     2665             (input  v-cntxt-db-num
     2666             ,input  v-cntxt-userid
     2667             ,input  'wndmax':U
     2668             ,output v-diasize-wndmax
     2669             ,output v-default-value
     2670             ) .
     2671         end.
     2672         assign
     2673           v-diasize-wndstore = false
     2674         .
     2675         if connected("ub") = true
     2676         then do:
     2677           run gbl/wndpar_r.p
     2678             (input  v-cntxt-db-num
     2679             ,input  v-cntxt-userid
     2680             ,input  'wndstore':U
     2681             ,output v-diasize-wndstore
     2682             ,output v-default-value
     2683             ) .
     2684         end.
     2685         assign
     2686           v-diasize-proc-name = entry(1, program-name(2), '.')
     2687         .
     2688         if v-diasize-wndstore = true
     2689         then do:
     2690           assign
     2691             v-restore-saved = false
     2692           .
     2693           if connected("ub") = true
     2694           then do:
     2695             run gbl/wndsizer.p
     2696               (input  v-cntxt-db-num
     2697               ,input  v-cntxt-userid
     2698               ,input  v-diasize-proc-name
     2699               ,input  'height':u
     2700               ,output v-resize-value-str
     2701               ) .
     2702             if v-resize-value-str <> '':U
     2703             then do:
     2704               run diasize_change-height in this-procedure
     2705                 (input  integer(v-resize-value-str)
     2706                 ,input  true
     2707                 ) .
     2708               assign
     2709                 v-restore-saved = true
     2710               .
     2711             end.
     2712           end.
     2713           if connected("ub") = true
     2714           then do:
     2715             run gbl/wndsizer.p
     2716               (input  v-cntxt-db-num
     2717               ,input  v-cntxt-userid
     2718               ,input  v-diasize-proc-name
     2719               ,input  'width':u
     2720               ,output v-resize-value-str
     2721               ) .
     2722             if v-resize-value-str <> '':U
     2723             then do:
     2724               run diasize_change-width in this-procedure
     2725                 (input  integer(v-resize-value-str)
     2726                 ,input  true
     2727                 ) .
     2728               assign
     2729                 v-restore-saved = true
     2730               .
     2731             end.
     2732           end.
     2733           if v-restore-saved <> true
     2734           then do:
     2735             if v-diasize-wndmax = true
     2736             then do:
     2737               run diasize_maximize in this-procedure
     2738                 (input  true
     2739                 ) .
     2740             end.
     2741           end.
     2742         end.
     2743         else do:
     2744           if v-diasize-wndmax = true
     2745           then do:
     2746             run diasize_maximize in this-procedure
     2747               (input  true
     2748               ) .
     2749           end.
     2750         end.
     2751       end.
     2752     end.
     2753   end procedure.
     2754   procedure diasize_need-full-display :
     2755     define output parameter p-need-full-display as logical   no-undo .
     2756     do
     2757     on error undo, return error return-value
     2758     :
     2759       assign
     2760         p-need-full-display = v-diasize-need-full-display
     2761       .
     2762       assign
     2763         v-diasize-need-full-display = false
     2764       .
     2765     end.
     2766   end procedure.
     2767   procedure get-context :
     2768      define output parameter p-db-num as integer          no-undo.
     2769      define output parameter p-user-id as character        no-undo.
     2770      define variable v-login               as character    no-undo.
     2771      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2772      define buffer buf_user-login  for ub.user-login .
     2773      do
     2774      on error undo, return error
     2775      :
     2776            FIND FIRST buf_sys-ctrl no-lock.
     2777            ASSIGN
     2778               v-login = USERID("ub")
     2779               p-db-num = buf_sys-ctrl.db-num
     2780            .
     2781            FIND FIRST buf_user-login
     2782                 WHERE buf_user-login.db-num = p-db-num
     2783                   AND buf_user-login.user-login = v-login
     2784                 no-lock
     2785                 no-error
     2786                 .
     2787            IF AVAILABLE buf_user-login
     2788            THEN DO:
     2789               assign
     2790                  p-user-id = buf_user-login.user-id
     2791               .
     2792            END.
     2793      end.
     2794   end procedure.
     2795       run diasize_init in this-procedure .
     2796   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2797   on F9 of frame Dialog-Frame anywhere do:
     2798     if not available ub.goods then
     2799       return no-apply.
     2800     gds-rec = recid (ub.goods).
     2801     run ref/gds-form.w ( input parparentproc
     2802                         ,input 'ПРОСМОТР':U
     2803                         ,input ?
     2804                         ,input ?
     2805                         ,input ?
     2806                         ,input-output gds-rec).
