     2850       ,output v-cntxt-obj-code
     2851       ,output v-cntxt-db-num-obj
     2852       ,output v-cntxt-is-admin
     2853       ) .
     2854       CASE par-mode:
     2855         when "printer":U or when "printer-object":U then do:
     2856           FIND FIRST buf_fbr-prn no-lock where
     2857                     buf_fbr-prn.db-num = p-db-num
     2858                 AND buf_fbr-prn.prn-num = p-prn-num no-error.
     2859           if not available buf_fbr-prn then do:
     2860                     message
     2861                     "Неверное значение параметров p-db-num и/или p-prn-num" p-db-num p-prn-num
     2862                     view-as alert-box error.
     2863                     return error.
     2864           end.
     2865   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2866   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2867     (output v-db-num
     2868     )  .
     2869         end.
     2870         when "db":U then do:
     2871           find first buf_db no-lock where
     2872                     buf_db.db-num = p-db-num no-error.
     2873           if not available buf_db then do:
     2874             message
     2875             "Неверное значение параметра p-db-num" p-db-num
     2876             view-as alert-box error.
     2877             return error.
     2878           end.
     2879         end.
     2880         when "goods" then do:
     2881           find first X_goods no-lock where
     2882                       X_goods.gds-code = p-gds-code no-error .
     2883           if not available buf_goods then do:
     2884             message
     2885             "Неверное значение параметра p-gds-code" p-gds-code
     2886             view-as alert-box error.
     2887             return error.
     2888           end.
     2889         end.
     2890         when "object":U or when "printer-object":U then do:
     2891           find first buf_clients no-lock where
     2892                     buf_clients.obj-type = p-obj-type
     2893                 AND buf_clients.obj-code = p-obj-code
     2894                       no-error .
     2895           if not available buf_clients then do:
     2896             message
