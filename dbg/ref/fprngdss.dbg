      918   procedure userobjs_append :
      919      define input  parameter p-obj-type as character no-undo .
      920      define input  parameter p-obj-code as integer   no-undo .
      921     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      922     do
      923     on error undo, return error return-value
      924     :
      925       find first buf_userobjs_temp-user-obj
      926         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      927           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      928         no-error .
      929       if not available buf_userobjs_temp-user-obj
      930       then do:
      931         create buf_userobjs_temp-user-obj .
      932         assign
      933           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      934           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      935         .
      936       end.
      937     end.
      938   end.
      939   procedure userobjs_object-exist :
      940     define output parameter p-object-exist as logical   no-undo .
      941     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      942     do
      943     on error undo, return error return-value
      944     :
      945       find first buf_userobjs_temp-user-obj
      946         no-error .
      947       if not available buf_userobjs_temp-user-obj
      948       then do:
      949         assign
      950           p-object-exist = false
      951         .
      952       end.
      953       else do:
      954         assign
      955           p-object-exist = true
      956         .
      957       end.
      958     end.
      959   end.
      960   procedure userobjs_transfer :
      961     define input  parameter p-callback-handle as handle no-undo .
      962     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      963     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      964     do
      965     on error undo, return error return-value
      966     :
      967       if valid-handle(p-callback-handle) <> true
      968       then do:
      969         message
      970           vss-workfile vss-revision vss-description skip
      971           "Ошибка задания входных параметров" skip
      972           "Неизвестный указатель на процедуру" skip
      973           view-as alert-box error .
      974         undo, return error return-value .
      975       end.
      976       if p-callback-handle :get-signature("userobjs_append") = ""
      977       then do:
      978         message
      979           vss-workfile vss-revision vss-description skip
      980           "Ошибка задания входных параметров" skip
      981           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      982                     ,p-callback-handle :file-name
      983                     ) skip
      984           view-as alert-box error .
      985         undo, return error return-value .
      986       end.
      987       for each buf_userobjs_temp-user-obj
      988       on error undo, return error return-value
      989       :
      990         run userobjs_append in p-callback-handle
      991           (input  buf_userobjs_temp-user-obj.obj-type
      992           ,input  buf_userobjs_temp-user-obj.obj-code
      993           ) .
      994       end.
      995     end.
      996   end procedure.
