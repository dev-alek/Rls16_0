     2820   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2821   procedure set-filter-name :
     2822   define input parameter p-filter-name as character no-undo .
     2823     do with frame Dialog-Frame:
     2824       if p-filter-name > "" then do:
     2825         assign
     2826           frame Dialog-Frame:title
     2827             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2828         .
