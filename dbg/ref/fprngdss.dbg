      888   procedure userobjs_clear :
      889     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      890     do
      891     on error undo, return error return-value
      892     :
      893       for each buf_userobjs_temp-user-obj
      894       on error undo, return error return-value
      895       :
      896         delete buf_userobjs_temp-user-obj .
      897       end.
      898     end.
      899   end .
      900   procedure userobjs_object-count :
      901     define output parameter p-total-count as integer   no-undo .
      902     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      903     do
      904     on error undo, return error return-value
      905     :
      906       assign
      907         p-total-count = 0
      908       .
      909       for each buf_userobjs_temp-user-obj
      910       on error undo, return error return-value
      911       :
      912         assign
      913           p-total-count = p-total-count + 1
      914         .
