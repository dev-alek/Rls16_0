      650   procedure fltfield-clear :
      651     define output parameter loc-fld as character no-undo.
      652     define output parameter loc-lab as character no-undo .
      653     define output parameter loc-spr as character no-undo .
      654     define output parameter loc-dim as character no-undo .
      655     assign
      656       loc-fld = ""
      657       loc-lab = ""
      658       loc-spr = ""
      659       loc-dim = "0"
      660     .
      661   end procedure .
      662   procedure fltfield-add :
      663     define input        parameter par-fld as character no-undo.
      664     define input        parameter par-lab as character no-undo .
      665     define input        parameter par-spr as character no-undo .
      666     define input-output parameter loc-fld as character no-undo.
      667     define input-output parameter loc-lab as character no-undo .
      668     define input-output parameter loc-spr as character no-undo .
      669     define input-output parameter loc-dim as character no-undo .
      670     do
      671     on error undo, return error
      672     :
      673       assign
      674       loc-fld = if loc-dim = '0'
      675                 then par-fld
      676                 else (loc-fld + chr(44) + par-fld)
      677       loc-lab = if loc-dim = '0'
      678                 then par-lab
      679                 else (loc-lab + chr(44) + par-lab)
      680       loc-spr = if loc-dim = '0'
      681                 then par-spr
      682                 else (loc-spr + chr(44) + par-spr)
      683       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      684                 string(integer(if num-entries(loc-dim) > 1
      685                               then entry(2, loc-dim)
      686                               else entry(1, loc-dim)
      687                               ) + 1)
      688       no-error
      689       .
      690     end.
      691   end procedure.
      692   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      693   define  stream PrnLibStream.
      694   procedure prn-lib-prn-file :
      695     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      696     define input parameter p-DIsabledoptions as integer no-undo .
      697     define variable v-report-name as character no-undo .
      698     define variable v-user-action as character no-undo .
      699     define variable v-printed     as logical   no-undo .
      700     define variable v-exist       as logical   no-undo .
      701     do
      702       on error undo, return error
      703       :
      704       run prn-lib-get-report-name  in this-procedure (
      705         input parParentProc
      706         ,output v-report-name
      707         ).
      708   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      709   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      710     (input  v-report-name
      711     ,input  2
      712     ,output v-exist
      713     )  .
      714       if NOT v-exist then
      715       DO:
      716         Message
      717           "Нет заданий на печать ! "
      718           view-as alert-box .
      719         Return  .
      720       End.
      721       run gbl/prnfilen.w
      722         (input  ""
      723         ,input  p-DisabledOptions
      724         ,input  string(v-report-name )
      725         ,input  7
      726         ,output v-user-action
      727         ,output v-printed
      728         ) .
      729       if v-printed then
      730       do:
      731         return "YES" .
      732       end.
      733       else
      734       do:
      735         return "NO" .
      736       end.
      737     end.
      738   end procedure.
      739   procedure prn-lib-open-stream :
      740     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      741     define input parameter p-page-size    as integer no-undo .
      742     define input parameter p-is-stream    as logical no-undo .
      743     define input parameter p-append       as logical no-undo .
      744     define variable v-report-name as character no-undo .
      745     do
      746       on error undo, return error
      747       :
      748       run prn-lib-get-report-name  in this-procedure (
      749         input parParentProc
      750         ,output v-report-name
      751         ).
      752       if p-is-stream then
      753       do:
      754         if p-append then
      755         do:
      756           output stream PrnLibStream to value( v-report-name )
      757             page-size value(p-page-size) append .
      758         end.
      759         if not p-append then
      760         do:
      761           output stream PrnLibStream to value( v-report-name )
      762             page-size value(p-page-size) .
      763         end.
      764       end.
      765       if not p-is-stream then
      766       do:
      767         if p-append then
      768         do:
      769           output to value( v-report-name )
      770             page-size value(p-page-size) append .
      771         end.
      772         if not p-append then
      773         do:
      774           output to value( v-report-name )
      775             page-size value(p-page-size) .
      776         end.
      777       end.
      778     end.
      779   end procedure.
      780   procedure prn-lib-open-exp :
      781     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      782     define input parameter p-is-stream    as logical no-undo .
      783     define input parameter p-is-append    as logical no-undo .
      784     define output parameter p-ReportFileName as char init "report" no-undo.
      785     define output parameter p-process as logical no-undo .
      786     define variable glog as logical no-undo .
      787     do
      788       on error undo, return error
      789       :
      790       SYSTEM-DIALOG GET-FILE p-ReportFileName
      791         TITLE      "Укажите путь"
      792         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      793         ASK-OVERWRITE
      794         CREATE-TEST-FILE
      795         SAVE-AS
      796         USE-FILENAME
      797         DEFAULT-EXTENSION "txt"
      798         UPDATE glog
      799         .
      800       if not glog then  return.
      801       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      802       if p-is-stream then
      803       do:
      804         if p-is-append then
      805         do:
      806           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      807         end.
      808         else
      809         do:
      810           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      811         end.
      812       end.
      813       else
      814       do:
      815         if p-is-append then
      816         do:
      817           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      818         end.
      819         else
      820         do:
      821           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      822         end.
      823       end.
      824       p-process = yes.
      825     end.
      826   end procedure.
      827   procedure prn-lib-get-report-name :
      828     define input parameter parParentProc  as widget-handle no-undo.
      829     define output parameter p-report-name as character no-undo .
      830     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      831   end procedure.
      832   procedure prn-lib-reportviewer-report-name :
