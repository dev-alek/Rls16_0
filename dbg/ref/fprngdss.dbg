     2898             view-as alert-box error.
     2899             return error.
     2900           end.
     2901         end.
     2902       END CASE.
     2903     RUN MyEnable in this-procedure .
     2904     run OpenBr in this-procedure ( input yes, input no, input '':U).
     2905     WAIT-FOR GO OF FRAME Dialog-Frame.
     2906   END.
     2907   RUN disable_UI.
     2908   PROCEDURE disable_UI :
     2909     HIDE FRAME Dialog-Frame.
     2910   END PROCEDURE.
     2911   PROCEDURE enable_UI :
     2912     DISPLAY f-object RS-Object sch-code sch-num
     2913         WITH FRAME Dialog-Frame.
     2914     ENABLE B-exit B-add B-delete B-chg B-gds B-print B-sch B-help RS-Object
     2915            BR-prn-gds sch-code sch-num
     2916         WITH FRAME Dialog-Frame.
     2917     VIEW FRAME Dialog-Frame.
     2918   END PROCEDURE.
     2919   PROCEDURE MyEnable :
     2920   ASSIGN
     2921   RS-object:radio-buttons in frame Dialog-Frame = "Все" + chr(44) + 'все':U + chr(44) + "Объект" + chr(44) + 'объект':U
     2922   RS-object = (if par-mode = "printer-object":U or par-mode = "object":U
     2923                then 'объект':U
     2924                else 'все':U
     2925               )
     2926   f-object =  if rs-object = 'объект':U
     2927                           then (p-obj-type + string(p-obj-code))
     2928                           else "":U
     2929   v-list = rs-object
     2930   .
     2931   DISPLAY
     2932   sch-code
     2933   sch-num
     2934   RS-object
     2935   f-object
     2936   with frame Dialog-Frame.
     2937   ENABLE
     2938   B-exit
     2939   RS-object when (par-mode <> "printer-object":U and par-mode <> "object":U)
     2940   b-add when (par-mode = "goods" or ((par-mode = "printer":U or par-mode = "printer-object":U) and v-db-num = p-db-num))
     2941   b-delete when (par-mode = "goods" or ((par-mode = "printer":U or par-mode = "printer-object":U) and v-db-num = p-db-num))
     2942   b-print
     2943   B-Help
     2944   BR-prn-gds
     2945   b-sch
     2946   b-gds
     2947   sch-code when par-mode <> "goods":U
     2948   sch-num when par-mode <> "printer":U or par-mode <> "printer-object":U
     2949   WITH FRAME Dialog-Frame.
     2950   if par-mode = "Printer":U or par-mode = "printer-object" then do:
     2951     hide
     2952     sch-num in frame Dialog-Frame .
     2953   end.
     2954   VIEW FRAME Dialog-Frame.
     2955   END PROCEDURE.
     2956   PROCEDURE OpenBr :
     2957   define input  parameter p-open-query     as logical   no-undo .
