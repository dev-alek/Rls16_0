      837   procedure prn-lib-reportviewer :
      838     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      839     define input parameter p-report-name-html as character no-undo .
      840     define input parameter p-param        as character no-undo .
      841     define variable v-excel           as character no-undo init 'TRUE' .
      842     define variable v-value-character as character no-undo .
      843     define variable v-value-integer   as character no-undo .
      844     define variable v-value-date      as date      no-undo .
      845     define variable v-value-decimal   as decimal   no-undo .
      846     define variable rep-excel         as logical   no-undo .
      847     define variable excel-string      as character no-undo .
      848     define variable v-param-type      as character no-undo .
      849     define variable v-tth             as handle    no-undo .
      850     run adm/shattri.p (
      851       input "get":U
      852       ,input  ""
      853       ,input  0
      854       ,input  'report-glob':U
      855       ,input  'rep-excel':U
      856       ,output v-value-character
      857       ,output v-value-date
      858       ,output v-value-decimal
      859       ,output v-value-integer
      860       ,output rep-excel
      861       ,output v-param-type
      862       ,INPUT-OUTPUT table-handle v-tth
      863       )  .
      864     if rep-excel then v-excel = "TRUE" .
      865     else v-excel = "FALSE" .
      866     if p-param eq ""
      867     then
      868        p-param = "EXCEL:" + v-excel.
      869     else
      870        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      871     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      872   end procedure.
