     4801         parameter-2-45 = (if p-find-next then "true":u else "false":u )
     4802         parameter-4-45 =
     4803           "where ":u +  substitute('buf_fbr-prn-gds.db-num = &1 AND buf_fbr-prn-gds.prn-num = &2 AND                          buf_fbr-prn-gds.obj-type = &3&4&3 AND buf_fbr-prn-gds.obj-code = &5 ', p-db-num, p-prn-num, chr(34), p-obj-type, p-obj-code) + " ":u + where-phrase-45 + " ":u + p-find-condition + " " + ""
     4804         parameter-5-45 = "  "
     4805       .
     4806         run fltopend_fltfindd in this-procedure  (
     4807                             input this-procedure:handle
     4808                             ,input QUERY br-prn-gds:handle
     4809                             ,input rowid(buf_fbr-prn-gds)
     4810                             ,input logical(parameter-2-45)
     4811                             ,input no-lock
     4812                             ,input (buffer buf_fbr-prn-gds:handle)
     4813                             ,input parameter-4-45
     4814                             ,input parameter-5-45
     4815                             ) no-error.
     4816         .
     4817         assign
     4818           v-doc-rec = integer(return-value)
     4819           v-fltopend-rowid[1] = ?
     4820         .
     4821       end.
     4822       else do:
     4823         assign
     4824         parameter-2-45 = (if p-find-next then "true":u else "false":u )
     4825         parameter-3-45 =  "FOR EACH buf_fbr-prn-gds"
     4826         parameter-4-45 =
     4827           (
     4828             if (" buf_fbr-prn-gds.db-num = p-db-num AND buf_fbr-prn-gds.prn-num = p-prn-num AND                          buf_fbr-prn-gds.obj-type = p-obj-type AND buf_fbr-prn-gds.obj-code = p-obj-code " + " " + where-phrase-45) <> ""
     4829             then  substitute('buf_fbr-prn-gds.db-num = &1 AND buf_fbr-prn-gds.prn-num = &2 AND                          buf_fbr-prn-gds.obj-type = &3&4&3 AND buf_fbr-prn-gds.obj-code = &5 ', p-db-num, p-prn-num, chr(34), p-obj-type, p-obj-code) + " " + where-phrase-45
     4830             else "true"
     4831           )
     4832         parameter-5-45 = (" " + "" + " " + ",       FIRST buf_goods No-LOCK where                      buf_goods.gds-code = buf_fbr-prn-gds.gds-code" + " " + p-find-condition)
     4833         parameter-6-45 = if sort-phrase-45 = ''
     4834                              then
     4835           (
     4836           " " + "  " +
     4837             " " + sort-column-phrase +
     4838           " " + "  "
     4839           )
     4840                              else
     4841           (
     4842           " " + "  " +
     4843             " " + sort-column-phrase +
     4844           " " + sort-phrase-45
     4845           )
     4846         parameter-7-45 =
     4847           "   "
     4848       .
     4849         run fltopend_fltfindq in this-procedure  (
     4850                             input this-procedure:handle
     4851                             ,input QUERY br-prn-gds:handle
     4852                             ,input logical(parameter-2-45)
     4853                             ,input no-lock
     4854                             ,input parameter-3-45
     4855                             ,input parameter-4-45
     4856                             ,input parameter-5-45
     4857                             ,input parameter-6-45
     4858                             ,input parameter-7-45
     4859                             ,output v-fltopend-rowid
     4860                             ) no-error.
     4861         .
     4862         v-doc-rec = ?.
     4863       end.
     4864       assign
     4865         l-query-was-opened = true
     4866       .
     4867     end.
     4868   end.
     4869     end.
     4870   END CASE.
     4871   if not p-open-query and v-doc-rec <> ? then
     4872   REPOSITION br-prn-gds to recid v-doc-rec No-ERROR.
     4873   if not p-open-query and v-fltopend-rowid[1] <> ? then
     4874   query br-prn-gds:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     4875   run waitfram-hide in this-procedure .
     4876   APPLY "VALUE-CHANGED" TO br-prn-gds in frame Dialog-Frame.
     4877   APPLY "ENTRY" TO br-prn-gds.
     4878   END PROCEDURE.
     4879   PROCEDURE proc-add :
     4880   define variable v-update as logical no-undo .
     4881   define variable v-rec as recid no-undo .
     4882   define buffer loc_fbr-prn-gds for ub.fbr-prn-gds.
     4883   define buffer loc_clients for ub.clients.
     4884   define buffer loc_fbr-prn for ub.fbr-prn.
     4885   define variable loc#log as logical no-undo .
     4886   CASE par-mode:
     4887     when "printer":U then do:
     4888       FOR EACH gds-list :
     4889           delete gds-list.
     4890       END.
     4891       run str/gds-list.w (
     4892                      input parparentproc
     4893                     ,input v-cntxt-host-code-obj
     4894                     ,input v-cntxt-obj-type
     4895                     ,input v-cntxt-obj-code).
     4896       message
     4897       "Вы действительно хотите добавить " skip
     4898       "товары данного списка на принтер?" p-prn-num
     4899       view-as alert-box QUESTION buttons YES-NO update v-update.
     4900       if not v-update then do:
     4901         FOR EACH gds-list:
     4902           delete gds-list.
     4903         END.
     4904         return error.
     4905       end.
     4906   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4907   run userobjs_clear in this-procedure  .
     4908       define variable v-user-select as logical   no-undo .
     4909   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4910   run userobjs_select-many in this-procedure
     4911     (input  parparentproc
     4912     ,input  v-cntxt-db-num
     4913     ,input  v-cntxt-userid
     4914     ,input  v-cntxt-host-code-obj
     4915     ,input  v-cntxt-obj-type
     4916     ,input  v-cntxt-obj-code
     4917     ,output v-user-select
     4918     )  .
     4919       if v-user-select <> true
     4920       then do:
     4921         return error .
     4922       end.
     4923       define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     4924       for each buf_userobjs_temp-user-obj
     4925       on error undo, return error return-value
     4926       :
     4927         find first loc_clients no-lock
     4928           where loc_clients.obj-type = buf_userobjs_temp-user-obj.obj-type
     4929             and loc_clients.obj-code = buf_userobjs_temp-user-obj.obj-code
     4930           no-error .
     4931         if not available loc_clients then return error.
     4932         if loc_clients.db-num <> v-db-num then do:
     4933           message
     4934           "Можно выбрать только объект текущей БД"
     4935           view-as alert-box error.
     4936           return error.
     4937         end.
     4938   define variable vss-include-info48 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4939   do:
     4940     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4941       (input  v-cntxt-db-num
     4942       ,input  v-cntxt-userid
     4943       ,input  0
     4944       ,input  'actn_fbr-prn-goods_work':U
     4945       ,input  'object':U
     4946       ,input  loc_clients.host-code
     4947       ,input  loc_clients.obj-type
     4948       ,input  loc_clients.obj-code
     4949       ,input  0
     4950       ,input  0
     4951       ,input  0
     4952       ,input  true
     4953       ,output loc#log
     4954       )  .
     4955   end.
     4956         if not loc#log then do:
     4957           return error.
     4958         end.
     4959       end.
     4960       for each gds-list no-lock
     4961       :
     4962         for each buf_userobjs_temp-user-obj
     4963         on error undo, return error return-value
     4964         :
     4965           run ref/fprngds1.p
     4966             (input-output v-rec
     4967             ,input 'ДОБАВЛЕНИЕ':U
     4968             ,input p-db-num
     4969             ,input p-prn-num
     4970             ,input buf_userobjs_temp-user-obj.obj-type
     4971             ,input buf_userobjs_temp-user-obj.obj-code
     4972             ,input gds-list.gds-code
     4973             ) no-error .
     4974           if error-status :error
     4975           then do:
     4976           end.
     4977         end.
     4978       end.
     4979     end.
     4980     when "goods":U then do:
     4981           run ref/fprngdsi.w (
     4982                      input parparentproc
     4983                     ,input 'ДОБАВЛЕНИЕ':U
     4984                     ,input "goods":U
     4985                     ,input 0
     4986                     ,input 0
     4987                     ,input "":U
     4988                     ,input 0
     4989                     ,input p-gds-code
     4990                     ,input-output v-rec) no-error.
     4991       if error-status:error then return error.
     4992     end.
     4993     END CASE.
     4994   run OpenBr in this-procedure ( input yes, input no, input "":U).
     4995   END PROCEDURE.
     4996   PROCEDURE proc-chg :
     4997   define variable v-rec as recid no-undo.
     4998   define variable loc#log as logical no-undo .
     4999   if not available buf_fbr-prn-gds then return error.
     5000     define variable v-chk-act-host-code as integer   no-undo .
     5001   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5002   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5003     (input  buf_fbr-prn-gds.obj-type
     5004     ,input  buf_fbr-prn-gds.obj-code
     5005     ,output v-chk-act-host-code
     5006     )  .
     5007   define variable vss-include-info50 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5008   do:
     5009     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5010       (input  v-cntxt-db-num
     5011       ,input  v-cntxt-userid
     5012       ,input  0
     5013       ,input  'actn_fbr-prn-goods_work':U
     5014       ,input  'object':U
     5015       ,input  v-chk-act-host-code
     5016       ,input  buf_fbr-prn-gds.obj-type
     5017       ,input  buf_fbr-prn-gds.obj-code
     5018       ,input  0
     5019       ,input  0
     5020       ,input  0
     5021       ,input  true
     5022       ,output loc#log
     5023       )  .
     5024   end.
     5025     if not loc#log then return no-apply.
     5026   v-rec = recid(buf_fbr-prn-gds).
     5027   run ref/fprngdsi.w (
     5028                  input parparentproc
     5029                 ,input 'ИЗМЕНЕНИЕ':U
     5030                 ,input "":U
     5031                 ,input buf_fbr-prn-gds.db-num
     5032                 ,input buf_fbr-prn-gds.prn-num
     5033                 ,input buf_fbr-prn-gds.obj-type
     5034                 ,input buf_fbr-prn-gds.obj-code
     5035                 ,input buf_fbr-prn-gds.gds-code
     5036                 ,input-output v-rec) no-error.
     5037       if error-status:error then return error.
     5038   RUn OpenBr   in this-procedure ( input yes, input no, input "":U).
     5039   reposition BR-prn-gds to recid v-rec no-error.
     5040   APPLY "ENTRY" to br-prn-gds in frame Dialog-Frame.
     5041   END PROCEDURE.
     5042   PROCEDURE proc-find-code :
     5043   define input parameter par-next as logical no-undo.
     5044   define input parameter pargds-code like ub.fbr-prn-gds.gds-code no-undo.
     5045   define variable var-gds-code-chr as character no-undo.
     5046   if sch-num:visible in frame Dialog-Frame then
     5047   display
     5048   "  ":U @ sch-num
     5049   with frame Dialog-Frame.
     5050   assign
     5051   var-gds-code-chr = string(pargds-code).
     5052   run OpenBr in this-procedure
     5053       (input false
     5054       ,input par-next
     5055       ,input substitute("and buf_fbr-prn-gds.gds-code  = &1 "  , var-gds-code-chr)
     5056       ).
     5057   apply "entry":u to sch-code in frame Dialog-Frame .
     5058   END PROCEDURE.
     5059   PROCEDURE proc-find-num :
     5060   define input parameter par-next as logical no-undo.
     5061   define input parameter parprn-num like ub.fbr-prn-gds.prn-num no-undo.
     5062   define variable var-prn-num-chr as character no-undo.
     5063   display
     5064   "  ":U @ sch-code
     5065   with frame Dialog-Frame.
     5066   assign
     5067   var-prn-num-chr = chr(34) + string(parprn-num) + chr(34).
     5068   run OpenBr in this-procedure
     5069       (input false
     5070       ,input par-next
     5071       ,input substitute("and buf_fbr-pnr-gds.prn-num  = &1 "
     5072         , var-prn-num-chr)
     5073       ).
     5074   apply "entry":u to sch-num in frame Dialog-Frame .
     5075   END PROCEDURE.
     5076   PROCEDURE proc-print :
     5077   define variable v-fbr-obj-name as character no-undo.
     5078   define variable v-obj-name as character no-undo.
     5079   define variable v-gds-full as character no-undo.
     5080   define variable v-rec as recid no-undo.
     5081   define variable LIne as character no-undo.
     5082   define variable ii as integer no-undo.
     5083   DEFINE FRAME List
     5084   buf_fbr-prn-gds.prn-num COLUMN-LABEL "Принтер"
     5085   v-fbr-obj-name column-label "Установлен на" format "X(8)"
     5086   buf_goods.gds-code column-label "Код товара"
     5087   buf_goods.gds-name column-label "Название товара"
     5088   v-obj-name column-label "Объект" format "x(8)"
     5089    HEADER
     5090       cur-time-print() AT 5 format "x(35)"
     5091           string( "Страница " + string( PAGE-NUMBER( Prnlibstream ) , ">>9") )
     5092               AT 66 format "X(15)" SKIP
     5093       Line format "x(116)" AT 1
     5094   with width 160 down use-text stream-io no-box .
     5095   if num-results( "BR-prn-gds" ) = 0 then  do:
     5096       message "Список  П У С Т !" skip view-as alert-box information .
     5097       return error .
     5098   end.
     5099   if session:set-wait-state( "compiler" ) then .
     5100   Line = fill( "-" , 116 ) .
     5101   v-rec = recid( buf_fbr-prn-gds ) .
     5102   DO WHILE available buf_fbr-prn-gds :
     5103       GET prev br-prn-gds NO-LOCK .
     5104   END.
     5105   GET next br-prn-gds NO-LOCK .
     5106   ii = 1 .
     5107   run prn-lib-open-stream  in this-procedure (
     5108                                                input parParentProc
     5109                                               ,input 62
     5110                                               ,input yes
     5111                                               ,input no
     5112                                               ).
     5113   FORM HEADER
     5114   Line format "X(116)" SKIP
     5115   "Продолжение - на следующей странице" AT 30 SKIP
     5116   with FRAME CliBottomFrame width 160 PAGE-BOTTOM NO-LABELS no-box.
     5117   VIEW stream Prnlibstream FRAME CliBottomFrame .
     5118   PUT stream Prnlibstream space(20) frame Dialog-Frame:title format "X(80)" SKIP(2) .
     5119   FORM with frame List .
     5120   DO WHILE available buf_fbr-prn-gds :
     5121       DISPLAY stream Prnlibstream
     5122           buf_fbr-prn-gds.prn-num
     5123           get-fbr-obj-name(buf_fbr-prn-gds.db-num, buf_fbr-prn-gds.prn-num) @ v-fbr-obj-name
     5124           buf_goods.gds-code
     5125           buf_goods.gds-name
     5126           buf_fbr-prn-gds.obj-type + string(buf_fbr-prn-gds.obj-code) @ v-obj-name
     5127          with frame List .
     5128       DOWN stream Prnlibstream 1
     5129       with frame List .
     5130       ii =  ii + 1 .
     5131       if ( ( ii modulo 10 ) = 0 ) AND ( ii >= 10 ) then
     5132       run waitfram-show in this-procedure ( input ("Просмотрено строк : " + string( ii ) ) ).
     5133       GET next br-prn-gds .
     5134   END.
     5135   PUT stream Prnlibstream Line format "X(116)" SKIP.
     5136   HIDE stream Prnlibstream FRAME CliBottomFrame .
     5137   output stream Prnlibstream close .
     5138   run prn-lib-prn-file in this-procedure (
     5139                                             input parParentProc
     5140                                             ,input 0
     5141                                             ).
     5142   reposition br-prn-gds to recid v-rec NO-ERROR .
     5143   run waitfram-hide in this-procedure.
     5144   END PROCEDURE.
     5145   PROCEDURE proc-sch :
     5146   assign
     5147     tbl = 'fbr-prn-gds'
     5148     join-tbl = 'buf_fbr-prn-gds'
     5149     fld = ""
     5150     lab = ""
     5151     spr = ""
     5152     dim = '0'
     5153     .
     5154   run fltfield-add in this-procedure('gds-code', 'Код товара', '',
     5155   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5156   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     5157   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5158   run fltfield-add in this-procedure('prn-num', 'Номер принтера', '',
     5159   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5160   run fltfield-add in this-procedure('db-num', '№ БД', 'db',
     5161   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5162     Filter-Block:
     5163     DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5164        ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5165        ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5166       run gbl/filter.w ( INPUT parparentproc
     5167                         , INPUT (filter-point + chr(4) +
     5168                                   filter-label + chr(4) +
     5169                                   string(yes))
     5170                         , INPUT tbl
     5171                         , INPUT join-tbl
     5172                         , INPUT fld
     5173                         , INPUT lab
     5174                         , INPUT spr
     5175                         , INPUT dim ).
     5176       RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5177     END.
     5178   END PROCEDURE.
     5179   PROCEDURE reposition-goods :
     5180   define input  parameter p-direction   as character no-undo .
     5181   define output parameter p-recid as recid no-undo .
     5182     case p-direction :
     5183       when "first":U
     5184       then do:
     5185         get first br-prn-gds.
     5186       end.
     5187       when "last":U
     5188       then do:
     5189         get last br-prn-gds.
     5190       end.
     5191       when "prev":U
     5192       then do:
     5193         get prev br-prn-gds.
     5194         if not available buf_fbr-prn-gds then do:
     5195           message
     5196           "Это первый товар списка"
     5197           view-as alert-box.
     5198         end.
     5199       end.
     5200       when "next":U
     5201       then do:
     5202         get next BR-prn-gds.
     5203         if not available buf_fbr-prn-gds then do:
     5204           message
     5205           "Это последний товар списка"
     5206           view-as alert-box.
     5207         end.
     5208       end.
     5209     end case .
     5210     assign
     5211     p-recid = recid(buf_goods)
     5212     .
     5213     run reposition-query in this-procedure
     5214       (input recid(buf_fbr-prn-gds)
     5215       ).
     5216   END PROCEDURE.
     5217   PROCEDURE reposition-query :
     5218   define input parameter p-recid as recid no-undo .
     5219   if p-recid <> ?
     5220   then do:
     5221     reposition BR-prn-gds to recid p-recid no-error.
     5222   end.
     5223   do with frame Dialog-Frame:
     5224     apply "entry":u to browse BR-prn-gds .
     5225     apply "VALUE-CHANGED":u to browse BR-prn-gds .
     5226   end.
     5227   END PROCEDURE.
     5228   FUNCTION get-fbr-obj-name RETURNS CHARACTER
     5229     ( input p-db-num as integer, input p-prn-num as integer ) :
     5230   define buffer loc_clients for ub.clients.
     5231   CASE par-mode:
     5232       when "printer":U then do:
     5233       end.
     5234       when "db":U or when 'все':U then do:
     5235               find first buf_fbr-prn no-lock where
     5236                           buf_fbr-prn.db-num = p-db-num
     5237                       AND buf_fbr-prn.prn-num = p-prn-num no-error.
     5238               if not available buf_fbr-prn then return ?.
     5239       end.
     5240   END CASE.
     5241   return (buf_fbr-prn.fbr-obj-type + string(buf_fbr-prn.fbr-obj-code)).
     5242   END FUNCTION.
     5243   FUNCTION get-gds-name RETURNS CHARACTER
     5244     ( p-gds-code as integer) :
     5245   define variable v-gds-name as character no-undo.
     5246     RETURN v-gds-name.
     5247   END FUNCTION.
     5248   FUNCTION get-obj-name RETURNS CHARACTER
     5249     ( input p-obj-type as character, input p-obj-code as integer ) :
     5250   define buffer loc_clients for ub.clients.
     5251   find first loc_clients no-lock where
     5252           buf_clients.obj-type = p-obj-type
     5253       AND loc_clients.obj-code = p-obj-code no-error.
     5254       if available loc_clients then
     5255     RETURN loc_clients.obj-name.
     5256     return (p-obj-type + string(p-obj-code)).
     5257   END FUNCTION.
