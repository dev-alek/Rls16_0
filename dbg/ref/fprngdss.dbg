     2830           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2831         .
     2832       end.
     2833       else do:
     2834         assign
     2835           b-sch :tooltip = ""
     2836         .
     2837       end.
     2838     end.
     2839   end procedure.
     2840   MAIN-BLOCK:
     2841   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2842      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2843   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2844     run mainmenu_getcntxt in parparentproc
     2845       (output v-cntxt-db-num
     2846       ,output v-cntxt-userid
     2847       ,output v-cntxt-level
     2848       ,output v-cntxt-host-code-obj
