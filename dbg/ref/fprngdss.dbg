        1   DEFINE BUFFER buf_clients FOR ub.clients.
        2   DEFINE BUFFER buf_db FOR ub.db.
        3   DEFINE BUFFER buf_fbr-prn FOR ub.fbr-prn.
        4   DEFINE BUFFER buf_fbr-prn-gds FOR ub.fbr-prn-gds.
        5   DEFINE BUFFER buf_goods FOR ub.goods.
        6   define input parameter parparentproc as widget-handle no-undo .
        7   define input parameter par-mode as character no-undo.
        8   define input parameter bttns as character no-undo.
        9   define input parameter p-db-num like ub.fbr-prn.db-num no-undo.
       10   define input parameter p-prn-num like ub.fbr-prn.prn-num no-undo.
       11   define input parameter p-obj-type like ub.fbr-prn-gds.obj-type no-undo.
       12   define input parameter p-obj-code like ub.fbr-prn-gds.obj-code no-undo.
       13   define input parameter p-gds-code like ub.fbr-prn-gds.gds-code no-undo .
       14   define input-output parameter par-recid as recid no-undo.
       15   define variable vss-revision    as character no-undo init "$Revision$":U .
       16   define variable vss-author      as character no-undo init "$Author$":U .
       17   define variable vss-date        as character no-undo init "$Date$":U .
       18   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       19   define variable vss-archive     as character no-undo init "$Archive$":U .
       20   define variable vss-description as character no-undo init "Товары на  принтере кухни".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   procedure proc-alt-shift-f2:
       82     if not ibs.th.gbl.gbl-var:rcode
       83   then
       84     run gbl\inidebug.p .
       85   end.
       86   procedure proc-alt-shift-f3:
       87     run gbl/prvssinf.p
       88       ( input this-procedure
       89       ) .
       90   end.
       91   define variable v-inform-launched as logical no-undo initial false .
       92   procedure proc-alt-shift-f4:
       93     define variable v-action as character no-undo .
       94     if v-inform-launched = false then do:
       95       assign
       96         v-inform-launched = true
       97       .
       98       run gbl/d-inform.w
       99         (  input self
      100         ,  input this-procedure
      101         , output v-action
      102         ) no-error .
      103       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      104       assign
      105         v-inform-launched = false
      106       .
      107     end.
      108   end.
      109   procedure proc-alt-f1:
      110     run gbl/corrhelp.p
      111       (input this-procedure
      112       ) .
      113   end .
      114   on alt-shift-f2 anywhere do:
      115     run proc-alt-shift-f2.
      116   end.
      117   on alt-shift-f3 anywhere do:
      118     run proc-alt-shift-f3 in this-procedure .
      119   end.
      120   on alt-shift-f4 anywhere do:
      121     run proc-alt-shift-f4 in this-procedure.
      122   end.
      123   on alt-f1 anywhere do:
      124     run proc-alt-f1 in this-procedure .
      125   end.
      126   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define variable v-waitfram-action01         as character   no-undo .
      128   define variable v-waitfram-action02         as character   no-undo .
      129   define variable v-waitfram-action03         as character   no-undo .
      130   define variable mWaitFramTextBeg            as character   no-undo.
      131   define variable mWaitFramTextEnd            as character   no-undo.
      132   define variable mWaitFramView               as logical     no-undo.
      133   define variable mWaitProcEvent              as logical     no-undo init yes.
      134   define variable mWaitFramInterval           as integer     no-undo init 1 .
      135   define variable mWaitFramStop               as logical     no-undo.
      136   define variable mWaitFramStopUser           as logical     no-undo.
      137   define variable mWaitFramStopTimeOut        as logical     no-undo.
      138   define variable mWaitFramStartProc          as datetime-tz no-undo.
      139   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      140   define button B-WaitFramStop auto-end-key
      141        label "Стоп"
      142        size 10 by 1 tooltip "Остоновить процесс".
      143   define button B-viewProcInfo
      144        label "Информация"
      145        size 15 by 1 tooltip "Информация о процесс".
      146   define frame waitfram
      147     v-waitfram-action01 format "x(72)" no-label skip
      148     v-waitfram-action02 format "x(72)" no-label skip
      149     v-waitfram-action03 format "x(72)" no-label skip
      150     B-viewProcInfo
      151     B-WaitFramStop at row 4 col 30
      152     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      153     .
      154   define new global shared variable mBatchMode as logical no-undo init ?.
      155   define variable mFramBachModHandle as handle no-undo.
      156   mFramBachModHandle = frame waitfram:handle.
      157   define variable mFameOldVis as logical no-undo.
      158   define variable mVisCUrentVin as logical no-undo.
      159   if session:batch-mode
      160   then
      161      mBatchMode = yes.
      162   if mBatchMode = ? then do:
      163     mVisCUrentVin = current-window:visible.
      164     mFameOldVis = mFramBachModHandle:visible.
      165     mFramBachModHandle:visible  = yes.
      166     mBatchMode = mFramBachModHandle:visible ne yes.
      167     mFramBachModHandle:visible = mFameOldVis.
      168     current-window:visible = mVisCUrentVin.
      169   end.
      170    if  log-manager:logfile-name ne ?
      171     then DO:
      172         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      173         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      174         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      175     end.
      176   on choose of B-WaitFramStop in frame waitfram
      177   do:
      178     mWaitFramStop = yes.
      179     mWaitFramStopUser = yes.
      180   end.
      181   function waitfram-check-timeout returns logical():
      182      define variable vtime as int64 no-undo.
      183      if mWaitFramStopTimeOut
      184      then
      185         return yes.
      186      vtime = ( now - mWaitFramStartProc ) / 1000 .
      187      if     mWaitFramTimeOut ne ?
      188         and mWaitFramTimeOut ne 0
      189         and mWaitFramTimeOut lt vtime
      190      then do:
      191         mWaitFramStopTimeOut = yes.
      192      end.
      193      return mWaitFramStopTimeOut.
      194   end.
      195   procedure waitfram-hide :
      196     if not session:batch-mode
      197     then do
      198     on error undo, return error return-value
      199     :
      200       pause 0 before-hide .
      201       if not mBatchMode then
      202         hide frame waitfram .
      203     if     not mWaitFramView
      204        and mWaitProcEvent
      205     then
      206       process events .
      207     end.
      208   end procedure.
      209   procedure waitfram-show :
      210     define input  parameter p-message as character no-undo .
      211     define variable v-left-margin as integer   no-undo .
      212     if not session:batch-mode
      213     then do
      214     on error undo, return error return-value
      215     :
      216       if length(p-message) <= 70 then do:
      217         assign
      218           v-left-margin = integer((70 - length(p-message)) / 2)
      219         .
      220         assign
      221           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      222         .
      223         assign
      224           v-waitfram-action01 = " "
      225           v-waitfram-action02 = " "
      226                                    + fill(" ", v-left-margin)
      227                                    + p-message
      228           v-waitfram-action03 = " "
      229         .
      230       end.
      231       else do:
      232         define variable vRindex1 as integer no-undo.
      233         define variable vRindex2 as integer no-undo.
      234         vRindex1 = r-index(p-message," ",70).
      235         if vRindex1 = 0
      236         then
      237            vRindex1 = 70.
      238         if length(p-message)  <= vRindex1 + 70 then do:
      239           assign
      240             v-waitfram-action01 = " "
      241             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      242             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      243           .
      244         end.
      245         else do:
      246           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      247           if vRindex2 <= vRindex1
      248           then
      249              vRindex2 = vRindex1 + 70.
      250           assign
      251             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      252             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      253             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      254           .
      255         end.
      256       end.
      257       B-viewProcInfo:visible   in frame waitfram = no.
      258       B-viewProcInfo:sensitive in frame waitfram = no.
      259       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      260       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      261       if  (   mWaitFramView
      262          or  mWaitProcEvent)
      263          and not mBatchMode
      264       then
      265          display
      266             v-waitfram-action01 skip
      267             v-waitfram-action02 skip
      268             v-waitfram-action03 skip
      269          with frame waitfram .
      270       if     mWaitFramView
      271          then do:
      272             if     mWaitFramInterval ne ?
      273                and not mBatchMode
      274             then
      275                wait-for go of frame waitfram pause mWaitFramInterval.
      276          end.
      277          else
      278             if     mWaitProcEvent
      279                and not mBatchMode
      280             then
      281                process events .
      282     end.
      283   end procedure.
      284      procedure waitfram-show-this:
      285         define input  parameter iInterval as int64 no-undo.
      286         define variable vtime as int64 no-undo.
      287         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      288         mWaitFramInterval = iInterval.
      289         run waitfram-show (substitute("&1&2 &3&4" ,
      290                                       mWaitFramTextBeg ,
      291                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      292                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      293                                       mWaitFramTextEnd
      294                                      )
      295                           ).
      296      end.
      297      procedure WaitFramRunPause:
      298         define input  parameter iInterval as dec no-undo.
      299         define variable vStart  as datetime-tz no-undo.
      300         define variable vend    as datetime-tz no-undo.
      301         define variable vint as int64 no-undo.
      302         define variable vOk as logical no-undo.
      303         vStart = now.
      304         vend   = vStart.
      305         publish "WaitFramPause" (iInterval,output vOk).
      306         vend   =  now.
      307         vint = vend - vStart.
      308         vint = iInterval - vint / 1000.
      309         if     not mWaitFramStop
      310            and (   vint > 0
      311                 or (    not vOk
      312                     and iInterval eq ?
      313                     )
      314                 )
      315         then
      316            run waitfram-show-this (iInterval).
      317         vend   =  now.
      318         vint = vend - vStart.
      319         vint = iInterval - vint / 1000.
      320         if     not mWaitFramStop
      321            and vint > 0
      322         then do:
      323            run gbl/pause.p (vint * 1000).
      324         end.
      325         if iInterval ne ?
      326         then
      327            publish "WaitFramStop".
      328         waitfram-check-timeout().
      329      end.
      330      procedure WaitFramWaitFor:
      331         define input  parameter iInterval as dec no-undo.
      332         assign
      333            mWaitFramStartProc   = now
      334            mWaitFramStopUser    = no
      335            mWaitFramStopTimeOut = no
      336         .
      337         block-wait:
      338         do while not mWaitFramStop:
      339            run WaitFramRunPause (iInterval).
      340            if  waitfram-check-timeout()
      341            then do:
      342               leave block-wait.
      343            end.
      344         end.
      345         run waitfram-hide.
      346      end.
      347   procedure waitfram-join :
      348     define input  parameter p-line-1  as character no-undo .
      349     define input  parameter p-line-2  as character no-undo .
      350     define input  parameter p-line-3  as character no-undo .
      351     define output parameter p-message as character no-undo .
      352     do
      353     on error undo, return error return-value
      354     :
      355       assign
      356         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      357                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      358                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      359       .
      360     end.
      361   end procedure.
      362   function waitfram-join-function returns character
      363     (input p-line-1 as character
      364     ,input p-line-2 as character
      365     ,input p-line-3 as character
      366     ).
      367     define variable v-message as character no-undo .
      368     run waitfram-join in this-procedure
      369       (input  p-line-1
      370       ,input  p-line-2
      371       ,input  p-line-3
      372       ,output v-message
      373       ) .
      374     return v-message .
      375   end function .
      376   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   procedure cur-time :
      378      define output parameter p-today as date      no-undo .
      379      define output parameter p-time  as integer   no-undo .
      380     do
      381     on error undo, return error
      382     :
      383       define variable v-date1 as date      no-undo .
      384       define variable v-date2 as date      no-undo .
      385       define variable v-time  as integer   no-undo .
      386       assign
      387         v-date1 = today
      388         v-time  = time
      389         v-date2 = today
      390       .
      391       if v-date1 <> v-date2
      392       then do:
      393         assign
      394           v-date1 = today
      395           v-time  = v-time
      396         .
      397       end.
      398       assign
      399         p-today = v-date1
      400         p-time  = v-time
      401       .
      402     end.
      403   end.
      404   function cur-time-date returns character
      405   :
      406     return string(today, '99/99/9999':U) .
      407   end.
      408   function cur-time-mjd returns decimal
      409   :
      410     define variable v-date as date      no-undo .
      411     define variable v-time as integer   no-undo .
      412     run cur-time in this-procedure
      413       (output v-date
      414       ,output v-time
      415       ) .
      416     return integer(v-date) - 2400002 + (v-time / 86400) .
      417   end.
      418   function cur-time-get-ending-index returns integer
      419   (input p-number as integer
      420   )
      421   :
      422     if p-number < 0
      423     or p-number = ?
      424     then do:
      425       return 1 .
      426     end.
      427     define variable v-rest as integer   no-undo .
      428     assign
      429       p-number = p-number modulo 100
      430     .
      431     if p-number < 20
      432     then do:
      433       assign
      434         v-rest = p-number
      435       .
      436     end.
      437     else do:
      438       assign
      439         v-rest = p-number modulo 10
      440       .
      441     end.
      442     case v-rest :
      443       when 1
      444       then do:
      445         return 2 .
      446       end.
      447       when 2 or
      448       when 3 or
      449       when 4
      450       then do:
      451         return 3 .
      452       end.
      453       otherwise do:
      454         return 1 .
      455       end.
      456     end case .
      457   end.
      458   procedure cur-time-mjd-to-date :
      459      define input  parameter i-mjd-diff as decimal no-undo.
      460      define output parameter o-Date     as date    no-undo.
      461      define output parameter o-Time     as integer no-undo.
      462      define variable v-day-number as integer   no-undo .
      463      if    i-mjd-diff < 0
      464         or i-mjd-diff = ?
      465      then do:
      466         return "?" .
      467      end.
      468      assign
      469         v-day-number = truncate(i-mjd-diff,0).
      470         o-Date = date(v-day-number + 2400002).
      471         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      472     .
      473   end.
      474   function cur-time-mjd-to-string returns character
      475   (input p-mjd-diff as decimal
      476   )
      477   :
      478     define variable v-day-number as integer   no-undo .
      479     define variable v-seconds    as integer   no-undo .
      480     define variable v-hour       as integer   no-undo .
      481     define variable v-min        as integer   no-undo .
      482     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      483     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      484     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      485     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      486     if p-mjd-diff < 0
      487     or p-mjd-diff = ?
      488     then do:
      489       return "?" .
      490     end.
      491     assign
      492       v-day-number = integer(truncate(p-mjd-diff,0))
      493       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      494     .
      495     if v-seconds > 86400
      496     then do:
      497       assign
      498         v-seconds = 86400 - 1
      499       .
      500     end.
      501     if v-seconds < 0
      502     then do:
      503       assign
      504         v-seconds = 0
      505       .
      506     end.
      507     assign
      508       v-hour = truncate(v-seconds / 3600, 0)
      509     .
      510     assign
      511       v-seconds = v-seconds modulo 3600
      512     .
      513     assign
      514       v-min = truncate(v-seconds / 60, 0)
      515     .
      516     assign
      517       v-seconds = v-seconds modulo 60
      518     .
      519     return
      520         (if v-day-number <> 0
      521           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      522           else ""
      523         )
      524       + (if v-day-number <> 0 or v-hour <> 0
      525           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      526           else ""
      527         )
      528       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      529           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      530           else ""
      531         )
      532       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      533       .
      534   end.
      535   function cur-time-string returns character
      536   :
      537     define variable v-date as date      no-undo .
      538     define variable v-time as integer   no-undo .
      539     run cur-time in this-procedure
      540       (output v-date
      541       ,output v-time
      542       ) .
      543     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      544   end.
      545   function cur-time-string-sec returns character
      546   :
      547     define variable v-date as date      no-undo .
      548     define variable v-time as integer   no-undo .
      549     run cur-time in this-procedure
      550       (output v-date
      551       ,output v-time
      552       ) .
      553     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      554   end.
      555   function cur-time-custom  returns character
      556   (input p-prefix as character
      557   ,input p-date-format as character
      558   ,input p-delimiter as character
      559   ,input p-time-format as character
      560   ,input p-suffix as character
      561   )
      562   :
      563     define variable v-date as date      no-undo .
      564     define variable v-time as integer   no-undo .
      565     run cur-time in this-procedure
      566       (output v-date
      567       ,output v-time
      568       ) .
      569     return
      570       p-prefix
      571       + string(v-date, p-date-format)
      572       + p-delimiter
      573       + string(v-time, p-time-format)
      574       + p-suffix
      575       .
      576   end.
      577   function cur-time-print  returns character
      578   :
      579     define variable v-date as date      no-undo .
      580     define variable v-time as integer   no-undo .
      581     run cur-time in this-procedure
      582       (output v-date
      583       ,output v-time
      584       ) .
      585     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      586   end.
      587   function cur-time-datetime returns datetime
