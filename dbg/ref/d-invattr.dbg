        1   DEFINE INPUT        PARAMETER pParameters  AS CHARACTER NO-UNDO.
        2   define input        parameter pTech        as logical no-undo .
        3   DEFINE INPUT-OUTPUT PARAMETER pValue       AS CHARACTER NO-UNDO.
        4   DEFINE INPUT-OUTPUT PARAMETER pSecondValue AS CHARACTER NO-UNDO.
        5   define variable vss-revision    as character no-undo init "$Revision: 3d3ba7fff1ab, 2269, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
        7   define variable vss-date        as character no-undo init "$Date: Wed Dec 25 15:24:02 2019 +0300 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: d-invAttr.w $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: gbl/d-invAttr.w $":U .
       10   define variable vss-description as character no-undo init "Универсальный диалог для ввода данных".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       66   DEF VAR BLACK_COLOR        AS INTEGER NO-UNDO INIT  0.
       67   DEF VAR DARK_BLUE_COLOR    AS INTEGER NO-UNDO INIT  1.
       68   DEF VAR DARK_GREEN_COLOR   AS INTEGER NO-UNDO INIT  2.
       69   DEF VAR CYAN_COLOR         AS INTEGER NO-UNDO INIT  3.
       70   DEF VAR BROWN_COLOR        AS INTEGER NO-UNDO INIT  4.
       71   DEF VAR DARK_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       72   DEF VAR DARK_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       73   DEF VAR VERY_GRAY_COLOR    AS INTEGER NO-UNDO INIT  7.
       74   DEF VAR VERY_GREY_COLOR    AS INTEGER NO-UNDO INIT  7.
       75   DEF VAR GRAY_COLOR         AS INTEGER NO-UNDO INIT  8.
       76   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
       77   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
       78   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
       79   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
       80   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
       81   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
       82   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
       83   define new global shared variable g#language as character no-undo .
       84   if g#language <> '' and g#language <> 'rus':U then do:
       85     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       86   end.
       87   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       88   function octal-to-char return character
       89   ( p-string as character ) :
       90     def var v-asc     as integer no-undo .
       91     def var v-new-asc as integer no-undo .
       92     def var ind       as integer no-undo .
       93     if length(p-string) <> 3 then do:
       94       return ? .
       95     end.
       96     assign
       97       v-asc = 0
       98     .
       99     do ind = 1 to length(p-string)
      100     :
      101       assign
      102         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      103       .
      104       if v-new-asc < 0 or v-new-asc >= 8 then do:
      105         return ? .
      106       end.
      107       assign
      108         v-asc = v-asc * 8 + v-new-asc
      109       .
      110     end.
      111     return chr(v-asc) .
      112   end function .
      113   function char-to-octal return character
      114   ( p-chr as character ) :
      115     def var v-asc    as integer   no-undo .
      116     def var ind      as integer   no-undo .
      117     def var v-string as character no-undo .
      118     if length(p-chr) <> 1 then do:
      119       return ? .
      120     end.
      121     assign
      122       v-asc    = asc(p-chr)
      123       v-string = ""
      124     .
      125     do ind = 1 to 3
      126     :
      127       assign
      128         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      129       .
      130       assign
      131         v-asc = truncate(v-asc / 8, 0)
      132       .
      133     end.
      134     return v-string .
      135   end.
      136   function str-encode return character
      137   (   p-init-string       as character
      138     , p-encode-char       as character
      139     , p-special-char-list as character
      140   ) :
      141     def var p-encode-string as character no-undo .
      142     def var ind                as integer no-undo .
      143     def var v-num-special-char as integer no-undo .
      144     def var v-special-char     as character no-undo .
      145     if p-encode-char = ?
      146     or p-encode-char = "" then do:
      147       assign
      148         p-encode-char = "~~"
      149       .
      150     end.
      151     if p-init-string = ? then do:
      152       return "?" .
      153     end.
      154     if p-init-string = "?" then do:
      155       return p-encode-char + char-to-octal("?") .
      156     end.
      157     assign
      158       v-num-special-char = length(p-special-char-list)
      159       p-encode-string    = replace(p-init-string
      160                                   ,p-encode-char
      161                                   ,p-encode-char + char-to-octal(p-encode-char)
      162                                   )
      163     .
      164     do ind = 1 to v-num-special-char
      165     :
      166       assign
      167         v-special-char = substring(p-special-char-list, ind, 1)
      168       .
      169       if v-special-char <> p-encode-char then do:
      170         assign
      171           p-encode-string = replace (p-encode-string
      172                                     ,v-special-char
      173                                     ,p-encode-char + char-to-octal(v-special-char)
      174                                     )
      175         .
      176       end.
      177     end.
      178     return p-encode-string .
      179   end.
      180   function str-decode returns character
      181     (p-init-string   as character
      182     ,p-encode-char   as character
      183     ) :
      184     def var p-decode-string as character no-undo .
      185     def var ind                       as integer no-undo .
      186     def var v-num-entries-init-string as integer no-undo .
      187     def var v-sub-phrase              as character no-undo .
      188     def var v-special-char            as character no-undo .
      189     if p-encode-char = ?
      190     or p-encode-char = "" then do:
      191       assign
      192         p-encode-char = "~~"
      193       .
      194     end.
      195     if p-init-string = "?" then do:
      196       return ? .
      197     end.
      198     assign
      199       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      200     .
      201     if v-num-entries-init-string > 1 then do:
      202       assign
      203         p-decode-string = entry(1, p-init-string, p-encode-char)
      204       .
      205       do ind = 2 to v-num-entries-init-string
      206       :
      207         assign
      208           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      209         .
      210         assign
      211           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      212         .
      213         if v-special-char <> ? then do:
      214           assign
      215             p-decode-string = p-decode-string
      216                             + v-special-char
      217                             + substring(v-sub-phrase, 4)
      218           .
      219         end.
      220         else do:
      221           assign
      222             p-decode-string = p-decode-string
      223                             + p-encode-char
      224                             + v-sub-phrase
      225           .
      226         end.
      227       end.
      228     end.
      229     else do:
      230       assign
      231         p-decode-string = p-init-string
      232       .
      233     end.
      234     return p-decode-string .
      235   end.
      236   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      237   procedure sel-date :
      238     define input  parameter p-date-handle as handle    no-undo .
      239     define input  parameter p-description as character no-undo .
      240     do
      241     on error undo, return error return-value
      242     :
      243       if (can-query (p-date-handle, "sensitive")
      244         and
      245         p-date-handle :sensitive = true
      246         )
      247       or (can-query (p-date-handle, "read-only")
      248         and
      249         p-date-handle :read-only = false
      250         )
      251       then do:
      252         if p-date-handle :handle <> focus :handle
      253         then do:
      254           apply "entry":u to p-date-handle .
      255         end.
      256         define variable v-ok            as logical no-undo .
      257         define variable v-curr-sv-date as date no-undo .
      258         assign
      259           v-curr-sv-date = date(p-date-handle :screen-value) no-error
      260         .
      261         if v-curr-sv-date = ?
      262         then do:
      263           run gbl/getcurdt.p
      264             (output v-curr-sv-date
      265             ) .
      266         end.
      267         if v-curr-sv-date <> ?
      268         then do:
      269           run gbl/d-inpday.w
      270             (input ?
      271             ,input "Выбор даты"
      272             ,input p-description
      273             ,input ""
      274             ,input-output v-curr-sv-date
      275             ,output v-ok
      276             ).
      277           if v-ok = true
      278           then do:
      279             assign
      280               p-date-handle :screen-value = string(v-curr-sv-date) .
      281             .
      282           end.
      283         end.
      284       end.
      285     end.
      286   end procedure.
      287   procedure proc-alt-shift-f2:
      288     if not ibs.th.gbl.gbl-var:rcode
      289   then
      290     run gbl\inidebug.p .
      291   end.
      292   procedure proc-alt-shift-f3:
      293     run gbl/prvssinf.p
      294       ( input this-procedure
      295       ) .
      296   end.
      297   define variable v-inform-launched as logical no-undo initial false .
      298   procedure proc-alt-shift-f4:
      299     define variable v-action as character no-undo .
      300     if v-inform-launched = false then do:
      301       assign
      302         v-inform-launched = true
      303       .
      304       run gbl/d-inform.w
      305         (  input self
      306         ,  input this-procedure
      307         , output v-action
      308         ) no-error .
      309       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      310       assign
      311         v-inform-launched = false
      312       .
      313     end.
      314   end.
      315   procedure proc-alt-f1:
      316     run gbl/corrhelp.p
      317       (input this-procedure
      318       ) .
      319   end .
      320   on alt-shift-f2 anywhere do:
      321     run proc-alt-shift-f2.
      322   end.
      323   on alt-shift-f3 anywhere do:
      324     run proc-alt-shift-f3 in this-procedure .
      325   end.
      326   on alt-shift-f4 anywhere do:
      327     run proc-alt-shift-f4 in this-procedure.
      328   end.
      329   on alt-f1 anywhere do:
      330     run proc-alt-f1 in this-procedure .
      331   end.
      332   define variable v-read-only     AS LOGICAL   NO-UNDO INIT False .
      333   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
      334     LABEL "&Отмена"
      335     SIZE 10 BY 1
      336     BGCOLOR 8 .
      337   DEFINE BUTTON Btn_OK AUTO-GO
      338     LABEL "&Ввод "
      339     SIZE 10 BY 1
      340     BGCOLOR 8 .
      341   DEFINE VARIABLE FILL-IN-Character   AS CHARACTER FORMAT "X(256)":U
      342     VIEW-AS FILL-IN
      343     SIZE 88 BY 1.04
      344     BGCOLOR 15 NO-UNDO.
      345   DEFINE VARIABLE FILL-IN-Character-2 AS CHARACTER FORMAT "X(256)":U
      346     VIEW-AS FILL-IN
      347     SIZE 88 BY 1
      348     BGCOLOR 15 NO-UNDO.
      349   DEFINE VARIABLE FILL-IN-Text-1      AS CHARACTER FORMAT "X(256)":U
      350     VIEW-AS TEXT
      351     SIZE 41.25 BY .58
      352     FONT 4 NO-UNDO.
      353   DEFINE VARIABLE FILL-IN-Text-2      AS CHARACTER FORMAT "X(256)":U
      354     VIEW-AS TEXT
      355     SIZE 41.25 BY .58
      356     FONT 4 NO-UNDO.
      357   DEFINE VARIABLE FILL-IN-Text-3      AS CHARACTER FORMAT "X(256)":U
      358     VIEW-AS TEXT
      359     SIZE 41.25 BY .58
      360     FONT 4 NO-UNDO.
      361   DEFINE FRAME Dialog-Frame
      362     FILL-IN-Character AT ROW 2.96 COL 2 NO-LABEL
      363     FILL-IN-Character-2 AT ROW 5 COL 2 NO-LABEL WIDGET-ID 2
      364     Btn_OK AT ROW 7 COL 2.5
      365     Btn_Cancel AT ROW 7 COL 12.5
      366     FILL-IN-Text-1 AT ROW 1.13 COL 2.5 NO-LABEL
      367     FILL-IN-Text-2 AT ROW 2.04 COL 2.5 NO-LABEL
      368     FILL-IN-Text-3 AT ROW 4.21 COL 2.5 NO-LABEL WIDGET-ID 4
      369     SPACE(50.12) SKIP(3.58)
      370     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      371     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      372     TITLE "Атрибуты инвентаризации"
      373     CANCEL-BUTTON Btn_Cancel.
      374   ASSIGN
      375     FRAME Dialog-Frame:SCROLLABLE = FALSE
      376     FRAME Dialog-Frame:HIDDEN     = TRUE.
      377   ASSIGN
      378     FILL-IN-Text-1:HIDDEN IN FRAME Dialog-Frame = TRUE.
      379   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      380     DO:
      381       APPLY "END-ERROR":U TO SELF.
      382     END.
      383   ON choose OF Btn_OK IN FRAME Dialog-Frame
      384     DO:
      385       if not pTech then
      386       do:
      387         if (FiLL-IN-Character = "" and FiLL-IN-Character-2 <> "") or
      388         (FILL-IN-Character-2 = "" and FiLL-IN-Character <> "") then
      389         do:
      390           message "Не все поля заполнены."
      391             view-as alert-box.
      392           return no-apply .
      393         end.
      394       end.
      395         pValue = FILL-IN-Character .
      396         pSecondValue = FILL-IN-Character-2 .
      397     END.
      398   ON RETURN OF FILL-IN-Character IN FRAME Dialog-Frame
      399     DO:
      400       assign
      401         FILL-IN-Character .
      402       APPLY "value-changed":U TO FILL-IN-Character-2.
      403     END.
      404   ON RETURN OF FILL-IN-Character-2 IN FRAME Dialog-Frame
      405     DO:
      406       assign
      407         FILL-IN-Character-2 .
      408       APPLY "CHOOSE":U TO Btn_OK.
      409     END.
      410   ON value-changed OF FILL-IN-Character IN FRAME Dialog-Frame
      411     DO:
      412       assign
      413         FILL-IN-Character .
      414     END.
      415   ON value-changed OF FILL-IN-Character-2 IN FRAME Dialog-Frame
      416     DO:
      417       assign
      418         FILL-IN-Character-2 .
      419     END.
      420   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      421     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      422   define variable ind      AS INTEGER   NO-UNDO.
      423   define variable sElement AS CHARACTER NO-UNDO.
      424   define variable sValue   AS CHARACTER NO-UNDO.
      425   DO ind = 1 TO NUM-ENTRIES(pParameters, '\'):
      426     sElement = ENTRY(ind, pParameters, '\').
      427     IF NUM-ENTRIES(sElement, '=') = 2
      428       THEN
      429     DO:
      430       sValue   = ENTRY(2, sElement, '=').
      431       CASE ENTRY(1, sElement, '='):
      432         WHEN 'text1'         THEN
      433           do:
      434             assign
      435               FILL-IN-Text-2 = str-decode(sValue, "").
      436           end.
      437         WHEN 'text2'         THEN
      438           do:
      439             assign
      440               FILL-IN-Text-3 = str-decode(sValue, "").
      441           end.
      442         WHEN 'readonly'      THEN
      443           do:
      444             assign
      445               v-read-only = lookup(sValue, 'yes,true':U) > 0 .
      446           end.
      447       END CASE.
      448     END.
      449   END.
      450   assign
      451     FILL-IN-Character   = pValue
      452     FILL-IN-Character-2 = pSecondValue
      453     .
      454   define variable hFrameHandle AS WIDGET-HANDLE NO-UNDO.
      455   hFrameHandle = FRAME Dialog-Frame:HANDLE.
      456   define variable hText AS WIDGET-HANDLE NO-UNDO.
      457   DO WITH FRAME Dialog-Frame
      458     :
      459     IF FILL-IN-Text-1 <> ''
      460       THEN
      461     DO:
      462       DISPLAY FILL-IN-Text-1.
      463     END.
      464     IF FILL-IN-Text-2 <> ''
      465       THEN
      466     DO:
      467       DISPLAY FILL-IN-Text-2.
      468     END.
      469   END.
      470   define variable sText1Label AS CHARACTER NO-UNDO.
      471   define variable sTypeOk     as logical   no-undo .
      472   assign
      473     sTypeOk = false
      474     .
      475   MAIN-BLOCK:
      476   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      477     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      478     RUN enable_UI.
      479     run setup-cancel-button .
      480     WAIT-FOR GO OF FRAME Dialog-Frame.
      481   END.
      482   RUN disable_UI.
      483   PROCEDURE disable_UI :
      484     HIDE FRAME Dialog-Frame.
      485   END PROCEDURE.
      486   PROCEDURE enable_UI :
      487     DISPLAY FILL-IN-Character FILL-IN-Character-2 FILL-IN-Text-2 FILL-IN-Text-3
      488       WITH FRAME Dialog-Frame.
      489     ENABLE FILL-IN-Character FILL-IN-Character-2 Btn_OK Btn_Cancel
      490       WITH FRAME Dialog-Frame.
      491     VIEW FRAME Dialog-Frame.
      492   END PROCEDURE.
      493   PROCEDURE setup-cancel-button :
      494     do with frame Dialog-Frame
      495       :
      496       if v-read-only
      497         then
      498       do:
      499         assign
      500           Btn_OK :LABEL = "&Выход"
      501           .
      502       end.
      503       if v-read-only = false
      504         then
      505       do:
      506         assign
      507           Btn_Cancel :visible   = true
      508           Btn_Cancel :sensitive = true
      509           .
      510       end.
      511       else
      512       do:
      513         assign
      514           Btn_Cancel :sensitive = false
      515           Btn_Cancel :visible   = false
      516           .
      517       end.
      518       FILL-IN-Character :SENSITIVE    = True AND NOT v-read-only .
      519       FILL-IN-Character-2 :SENSITIVE    = True AND NOT v-read-only .
      520     end.
      521   END PROCEDURE.
