      494   field sum-cur        as decimal
      495   field sum-doc        as decimal
      496   field vat-acc        as decimal
      497   field vat-cur        as decimal
      498   field vat-doc        as decimal
      499   field transport-acc  as decimal
      500   field transport-cur  as decimal
      501   field transport-doc  as decimal
      502   field other-acc      as decimal
      503   field other-cur      as decimal
      504   field other-doc      as decimal
      505   field road-tax-acc   as decimal
      506   field road-tax-cur   as decimal
      507   field road-tax-doc   as decimal
      508   field slt-acc        as decimal
      509   field slt-cur        as decimal
      510   field slt-doc        as decimal
      511   field order-qnty     as decimal
      512   field temp-sale-goods  as decimal
      513   index pi as unique primary  gds-code obj-type obj-code
      514   .
      515   define temp-table temp-goods no-undo
      516   field gds-code       as integer
      517   field sum-crit       as decimal
      518   field crit-pr        as decimal
      519   field crit           as char
      520   field kol-period     as int
      521   field average-qnty   as decimal
      522   field sigma          as decimal
      523   field K_V            as decimal
      524   field qnty           as decimal
      525   field price-crc      as decimal
      526   field reserve-day    as integer
      527   field sum-acc        as decimal
      528   field sum-cur        as decimal
      529   field sum-doc        as decimal
      530   field vat-acc        as decimal
      531   field vat-cur        as decimal
      532   field vat-doc        as decimal
      533   field transport-acc  as decimal
      534   field transport-cur  as decimal
      535   field transport-doc  as decimal
      536   field other-acc      as decimal
      537   field other-cur      as decimal
      538   field other-doc      as decimal
      539   field road-tax-acc   as decimal
      540   field road-tax-cur   as decimal
      541   field road-tax-doc   as decimal
      542   field slt-acc        as decimal
      543   field slt-cur        as decimal
      544   field slt-doc        as decimal
      545   field order-qnty       as decimal
      546   field stock-price-acc  as decimal
      547   field stock-price-sale as decimal
      548   field stock-qnty       as decimal
      549   field temp-sale-goods  as decimal
      550   field prcnt-account as decimal
      551   index pi as UNIQUE primary  gds-code
      552   index pi-1 crit-pr desc
      553   .
      554   define temp-table temp-xyz no-undo
      555   field gds-code       as integer
      556   field num-per        as integer
      557   field sum-crit-p     as decimal
      558   index pi2 as UNIQUE primary   gds-code num-per
      559   .
      560   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      561   define variable v-waitfram-action01         as character   no-undo .
      562   define variable v-waitfram-action02         as character   no-undo .
      563   define variable v-waitfram-action03         as character   no-undo .
      564   define variable mWaitFramTextBeg            as character   no-undo.
      565   define variable mWaitFramTextEnd            as character   no-undo.
      566   define variable mWaitFramView               as logical     no-undo.
      567   define variable mWaitProcEvent              as logical     no-undo init yes.
      568   define variable mWaitFramInterval           as integer     no-undo init 1 .
      569   define variable mWaitFramStop               as logical     no-undo.
      570   define variable mWaitFramStopUser           as logical     no-undo.
      571   define variable mWaitFramStopTimeOut        as logical     no-undo.
      572   define variable mWaitFramStartProc          as datetime-tz no-undo.
      573   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      574   define button B-WaitFramStop auto-end-key
      575        label "Стоп"
      576        size 10 by 1 tooltip "Остоновить процесс".
      577   define button B-viewProcInfo
      578        label "Информация"
      579        size 15 by 1 tooltip "Информация о процесс".
      580   define frame waitfram
      581     v-waitfram-action01 format "x(72)" no-label skip
      582     v-waitfram-action02 format "x(72)" no-label skip
      583     v-waitfram-action03 format "x(72)" no-label skip
      584     B-viewProcInfo
      585     B-WaitFramStop at row 4 col 30
      586     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      587     .
      588   define new global shared variable mBatchMode as logical no-undo init ?.
      589   define variable mFramBachModHandle as handle no-undo.
      590   mFramBachModHandle = frame waitfram:handle.
      591   define variable mFameOldVis as logical no-undo.
      592   define variable mVisCUrentVin as logical no-undo.
      593   if session:batch-mode
      594   then
      595      mBatchMode = yes.
      596   if mBatchMode = ? then do:
      597     mVisCUrentVin = current-window:visible.
      598     mFameOldVis = mFramBachModHandle:visible.
      599     mFramBachModHandle:visible  = yes.
      600     mBatchMode = mFramBachModHandle:visible ne yes.
      601     mFramBachModHandle:visible = mFameOldVis.
      602     current-window:visible = mVisCUrentVin.
      603   end.
      604    if  log-manager:logfile-name ne ?
      605     then DO:
      606         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      607         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      608         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      609     end.
      610   on choose of B-WaitFramStop in frame waitfram
      611   do:
      612     mWaitFramStop = yes.
      613     mWaitFramStopUser = yes.
      614   end.
      615   function waitfram-check-timeout returns logical():
      616      define variable vtime as int64 no-undo.
      617      if mWaitFramStopTimeOut
      618      then
      619         return yes.
      620      vtime = ( now - mWaitFramStartProc ) / 1000 .
      621      if     mWaitFramTimeOut ne ?
      622         and mWaitFramTimeOut ne 0
      623         and mWaitFramTimeOut lt vtime
      624      then do:
      625         mWaitFramStopTimeOut = yes.
      626      end.
      627      return mWaitFramStopTimeOut.
      628   end.
      629   procedure waitfram-hide :
      630     if not session:batch-mode
      631     then do
      632     on error undo, return error return-value
      633     :
      634       pause 0 before-hide .
      635       if not mBatchMode then
      636         hide frame waitfram .
      637     if     not mWaitFramView
      638        and mWaitProcEvent
      639     then
      640       process events .
      641     end.
      642   end procedure.
      643   procedure waitfram-show :
      644     define input  parameter p-message as character no-undo .
      645     define variable v-left-margin as integer   no-undo .
      646     if not session:batch-mode
      647     then do
      648     on error undo, return error return-value
      649     :
      650       if length(p-message) <= 70 then do:
      651         assign
      652           v-left-margin = integer((70 - length(p-message)) / 2)
      653         .
      654         assign
      655           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      656         .
      657         assign
      658           v-waitfram-action01 = " "
      659           v-waitfram-action02 = " "
      660                                    + fill(" ", v-left-margin)
      661                                    + p-message
      662           v-waitfram-action03 = " "
      663         .
      664       end.
      665       else do:
      666         define variable vRindex1 as integer no-undo.
      667         define variable vRindex2 as integer no-undo.
      668         vRindex1 = r-index(p-message," ",70).
      669         if vRindex1 = 0
      670         then
      671            vRindex1 = 70.
      672         if length(p-message)  <= vRindex1 + 70 then do:
      673           assign
      674             v-waitfram-action01 = " "
      675             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      676             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      677           .
      678         end.
      679         else do:
      680           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      681           if vRindex2 <= vRindex1
      682           then
      683              vRindex2 = vRindex1 + 70.
      684           assign
      685             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      686             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      687             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      688           .
      689         end.
      690       end.
      691       B-viewProcInfo:visible   in frame waitfram = no.
      692       B-viewProcInfo:sensitive in frame waitfram = no.
      693       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      694       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      695       if  (   mWaitFramView
      696          or  mWaitProcEvent)
      697          and not mBatchMode
      698       then
      699          display
      700             v-waitfram-action01 skip
      701             v-waitfram-action02 skip
      702             v-waitfram-action03 skip
      703          with frame waitfram .
      704       if     mWaitFramView
      705          then do:
      706             if     mWaitFramInterval ne ?
      707                and not mBatchMode
      708             then
      709                wait-for go of frame waitfram pause mWaitFramInterval.
      710          end.
      711          else
      712             if     mWaitProcEvent
      713                and not mBatchMode
      714             then
      715                process events .
      716     end.
      717   end procedure.
      718      procedure waitfram-show-this:
      719         define input  parameter iInterval as int64 no-undo.
      720         define variable vtime as int64 no-undo.
      721         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      722         mWaitFramInterval = iInterval.
      723         run waitfram-show (substitute("&1&2 &3&4" ,
      724                                       mWaitFramTextBeg ,
      725                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      726                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      727                                       mWaitFramTextEnd
      728                                      )
      729                           ).
      730      end.
      731      procedure WaitFramRunPause:
      732         define input  parameter iInterval as dec no-undo.
      733         define variable vStart  as datetime-tz no-undo.
      734         define variable vend    as datetime-tz no-undo.
      735         define variable vint as int64 no-undo.
      736         define variable vOk as logical no-undo.
      737         vStart = now.
      738         vend   = vStart.
      739         publish "WaitFramPause" (iInterval,output vOk).
      740         vend   =  now.
      741         vint = vend - vStart.
      742         vint = iInterval - vint / 1000.
      743         if     not mWaitFramStop
      744            and (   vint > 0
      745                 or (    not vOk
      746                     and iInterval eq ?
      747                     )
      748                 )
      749         then
      750            run waitfram-show-this (iInterval).
      751         vend   =  now.
      752         vint = vend - vStart.
      753         vint = iInterval - vint / 1000.
      754         if     not mWaitFramStop
      755            and vint > 0
      756         then do:
      757            run gbl/pause.p (vint * 1000).
      758         end.
      759         if iInterval ne ?
      760         then
      761            publish "WaitFramStop".
      762         waitfram-check-timeout().
      763      end.
      764      procedure WaitFramWaitFor:
      765         define input  parameter iInterval as dec no-undo.
      766         assign
      767            mWaitFramStartProc   = now
      768            mWaitFramStopUser    = no
      769            mWaitFramStopTimeOut = no
      770         .
      771         block-wait:
      772         do while not mWaitFramStop:
      773            run WaitFramRunPause (iInterval).
      774            if  waitfram-check-timeout()
      775            then do:
      776               leave block-wait.
      777            end.
      778         end.
      779         run waitfram-hide.
      780      end.
      781   procedure waitfram-join :
      782     define input  parameter p-line-1  as character no-undo .
      783     define input  parameter p-line-2  as character no-undo .
      784     define input  parameter p-line-3  as character no-undo .
      785     define output parameter p-message as character no-undo .
      786     do
      787     on error undo, return error return-value
      788     :
      789       assign
      790         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      791                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      792                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      793       .
      794     end.
      795   end procedure.
      796   function waitfram-join-function returns character
      797     (input p-line-1 as character
      798     ,input p-line-2 as character
      799     ,input p-line-3 as character
      800     ).
      801     define variable v-message as character no-undo .
      802     run waitfram-join in this-procedure
      803       (input  p-line-1
      804       ,input  p-line-2
      805       ,input  p-line-3
      806       ,output v-message
      807       ) .
      808     return v-message .
      809   end function .
      810   define temp-table  x-analysis        no-undo  like ub.abc-analysis.
      811   define input         parameter table for    x-analysis.
      812   define input-output  parameter table for    temp-oborot.
      813   define output        parameter table for    temp-goods.
      814   run waitfram-show ("Ранжирование товаров...").
      815   define variable v-all-sum as decimal   no-undo .
      816   v-all-sum = 0 .
      817   for each  temp-oborot USE-INDEX PI :
      818       v-all-sum = v-all-sum + temp-oborot.sum-crit .
      819       find first temp-goods where temp-goods.gds-code = temp-oborot.gds-code no-error .
      820       if not available temp-goods then DO:
      821          create temp-goods.
      822           assign
      823             temp-goods.gds-code          =  temp-oborot.gds-code
      824             temp-goods.sum-crit          =  temp-oborot.sum-crit
      825             temp-goods.qnty              =  temp-oborot.qnty
      826             temp-goods.reserve-day       =  temp-oborot.reserve-day
      827             temp-goods.stock-qnty        =  temp-oborot.stock-qnty
      828             temp-goods.stock-price-acc   =  temp-oborot.price-cost
      829             temp-goods.stock-price-sale  =  temp-oborot.qnty * temp-oborot.price-crc
      830             temp-goods.sum-acc           =  temp-oborot.sum-acc
      831             temp-goods.sum-cur           =  temp-oborot.sum-cur
      832             temp-goods.sum-doc           =  temp-oborot.sum-doc
      833             temp-goods.vat-acc           =  temp-oborot.vat-acc
      834             temp-goods.vat-cur           =  temp-oborot.vat-cur
      835             temp-goods.vat-doc           =  temp-oborot.vat-doc
      836             temp-goods.transport-acc     =  temp-oborot.transport-acc
      837             temp-goods.transport-cur     =  temp-oborot.transport-cur
      838             temp-goods.transport-doc     =  temp-oborot.transport-doc
      839             temp-goods.other-acc         =  temp-oborot.other-acc
      840             temp-goods.other-cur         =  temp-oborot.other-cur
      841             temp-goods.other-doc         =  temp-oborot.other-doc
      842             temp-goods.road-tax-acc      =  temp-oborot.road-tax-acc
      843             temp-goods.road-tax-cur      =  temp-oborot.road-tax-cur
      844             temp-goods.road-tax-doc      =  temp-oborot.road-tax-doc
      845             temp-goods.slt-acc           =  temp-oborot.slt-acc
      846             temp-goods.slt-cur           =  temp-oborot.slt-cur
      847             temp-goods.slt-doc           =  temp-oborot.slt-doc
      848             temp-goods.order-qnty        =  temp-oborot.order-qnty
      849         .
      850       END.
      851       ELSE
      852        assign
      853         temp-goods.gds-code          = temp-oborot.gds-code
      854         temp-goods.sum-crit          = temp-goods.sum-crit       + temp-oborot.sum-crit
      855         temp-goods.qnty              = temp-goods.qnty           + temp-oborot.qnty
      856         temp-goods.reserve-day       = temp-goods.reserve-day    + temp-oborot.reserve-day
      857         temp-goods.stock-qnty        = temp-goods.stock-qnty     + temp-oborot.stock-qnty
      858         temp-goods.stock-price-acc   = temp-goods.stock-price-acc  + ( temp-oborot.price-cost )
      859         temp-goods.stock-price-sale  = temp-goods.stock-price-sale + ( temp-oborot.qnty * temp-oborot.price-crc )
      860         temp-goods.sum-acc           = temp-goods.sum-acc        + temp-oborot.sum-acc
      861         temp-goods.sum-cur           = temp-goods.sum-cur        + temp-oborot.sum-cur
      862         temp-goods.sum-doc           = temp-goods.sum-doc        + temp-oborot.sum-doc
      863         temp-goods.vat-acc           = temp-goods.vat-acc        + temp-oborot.vat-acc
      864         temp-goods.vat-cur           = temp-goods.vat-cur        + temp-oborot.vat-cur
      865         temp-goods.vat-doc           = temp-goods.vat-doc        + temp-oborot.vat-doc
      866         temp-goods.transport-acc     = temp-goods.transport-acc  + temp-oborot.transport-acc
      867         temp-goods.transport-cur     = temp-goods.transport-cur  + temp-oborot.transport-cur
      868         temp-goods.transport-doc     = temp-goods.transport-doc  + temp-oborot.transport-doc
      869         temp-goods.other-acc         = temp-goods.other-acc      + temp-oborot.other-acc
      870         temp-goods.other-cur         = temp-goods.other-cur      + temp-oborot.other-cur
      871         temp-goods.other-doc         = temp-goods.other-doc      + temp-oborot.other-doc
      872         temp-goods.road-tax-acc      = temp-goods.road-tax-acc   + temp-oborot.road-tax-acc
      873         temp-goods.road-tax-cur      = temp-goods.road-tax-cur   + temp-oborot.road-tax-cur
      874         temp-goods.road-tax-doc      = temp-goods.road-tax-doc   + temp-oborot.road-tax-doc
      875         temp-goods.slt-acc           = temp-goods.slt-acc        + temp-oborot.slt-acc
      876         temp-goods.slt-cur           = temp-goods.slt-cur        + temp-oborot.slt-cur
      877         temp-goods.slt-doc           = temp-goods.slt-doc        + temp-oborot.slt-doc
      878         temp-goods.order-qnty        = temp-goods.order-qnty     + temp-oborot.order-qnty
      879       .
      880   end.
      881   for each  temp-goods :
      882             temp-goods.crit-pr = temp-goods.sum-crit * 100 / v-all-sum.
      883   end.
      884   run waitfram-hide.
