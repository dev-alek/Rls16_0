        1   block-level on error undo, throw.
        2   define input  parameter iParentProc as widget-handle no-undo .
        3   define input  parameter iGdsCode    as integer       no-undo .
        4   define output parameter oId         as recid         no-undo init ? .
        5   define new global shared variable g#language as character no-undo .
        6   if g#language <> '' and g#language <> 'rus':U then do:
        7     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        8   end.
        9    define new shared temp-table tmprecid
       10       field Frecid as recid init ?
       11       field fnum as character
       12       field fTable as character
       13    index num  fnum Frecid
       14    index itable is primary unique fTable Frecid
       15    .
       16   define variable fSelect as logical no-undo format "*/" column-label "".
       17   function isSelect return logical
       18       (iBuffer as handle  ):
       19       define buffer tmprecid for tmprecid.
       20       if iBuffer:available
       21       then
       22          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
       23                                and tmprecid.Frecid = iBuffer:recid
       24          no-lock no-error.
       25       return available tmprecid.
       26    end.
       27   function setSelect return logical
       28       (iBuffer as handle  ):
       29       define buffer tmprecid for tmprecid.
       30       if iBuffer:available
       31       then do:
       32          find first tmprecid where tmprecid.fTable = iBuffer:TABLE
       33                                and tmprecid.Frecid = iBuffer:recid
       34          no-lock no-error.
       35          if available tmprecid
       36          then
       37             delete tmprecid.
       38          else do:
       39             create tmprecid.
       40             assign
       41                tmprecid.fTable = iBuffer:TABLE
       42                tmprecid.Frecid = iBuffer:recid
       43             .
       44          end.
       45       end.
       46       return available tmprecid.
       47    end.
       48    procedure rid-keep :
       49        run gbl/rid-keep.p (input table tmprecid) no-error.
       50    end.
       51    procedure rid-rest :
       52         run gbl/rid-rest.p (output table tmprecid) no-error.
       53    end.
       54   define variable vFilter as character no-undo.
       55   define variable vTitle  as character no-undo.
       56   define variable vOk as logical no-undo .
       57   find first ub.Code no-lock where ub.Code.parent = "DTSeasons" and ub.Code.CodeValue <> ? no-error .
       58   if available (ub.Code) then vOk = true .
       59   assign
       60     vFilter = if iGdsCode = 0 or iGdsCode = ? or not vOk then ""
       61               else ("and code.codeValue = " + quoter(iGdsCode))
       62     vTitle = if vFilter = "" then "Сезоны ДТ" else substitute("&1&3&2", "Сезоны ДТ", vFilter, chr(4))
       63   .
       64   run ref/codelay.p
       65     (input  iParentProc
       66     ,input  'ВЫБОР':U
       67     ,input  ""
       68     ,input  "DTSeasons"
       69     ,input  vTitle
       70     ) .
       71   run rid-rest.
       72   find tmprecid no-error.
       73   if available tmprecid then
       74   do:
       75     oId = tmprecid.frecid.
       76   end.
       77   else
       78   do:
       79     find first tmprecid no-error.
       80     if available tmprecid then
       81     do:
       82       return error "Можно выбрать только одну запись ~"Сезона ДТ~".".
       83     end.
       84   end.
