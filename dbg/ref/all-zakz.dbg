    10801         view-as alert-box.
    10802      end.
    10803    end.
    10804    assign del-list = "".
    10805   find first bf_ord-doc where recid(bf_ord-doc) = v-doc-code no-lock  no-error .
    10806   end.
    10807   end procedure.
    10808   PROCEDURE proc-m_gen-2-2 :
    10809   define buffer bf_sysconf   for ub.sysconf.
    10810   define buffer bf_ord-doc   for ub.ord-doc.
    10811   define variable v-i        as integer no-undo.
    10812   define variable v-doc-code as integer no-undo.
    10813   do on error undo, return error return-value
    10814   :
    10815   if del-list = "" then do:
    10816     if available shar-buf_ord-doc then assign del-list = string(recid(shar-buf_ord-doc)).
    10817   end.
    10818   define variable v-nn as integer   no-undo .
    10819   v-nn = num-entries (del-list).
    10820   v-i-cycle:
    10821     do v-i = 1 to v-nn :
    10822       assign v-doc-code = integer(entry (v-i, del-list)).
    10823       find first bf_ord-doc where recid(bf_ord-doc) = v-doc-code exclusive-lock.
    10824       if bf_ord-doc.doc-type <> 'ПО':U then next.
    10825       if bf_ord-doc.status_ <> 'факт':U then do:
    10826         message "Документ " bf_ord-doc.status_ " не в статусе " 'факт':U " . Пропускаем." view-as alert-box.
    10827         next v-i-cycle.
    10828       end.
    10829       find first bf_sysconf where bf_sysconf.host-code = bf_ord-doc.host-code no-lock.
    10830       if bf_ord-doc.cr-fo2 = yes then do:
    10831         message "По документу " bf_ord-doc.doc-code " уже создавался ФО от " bf_ord-doc.fo-date2 " числа." view-as alert-box.
    10832         next v-i-cycle.
    10833       end.
    10834       else do:
    10835         if bf_ord-doc.need-fo2 = 1 or bf_ord-doc.need-fo2 = 2 then assign  bf_ord-doc.need-fo2 = 0.
    10836         else do:
    10837           message "Данный документ не нуждался в генерации ФО." view-as alert-box.
    10838           next v-i-cycle.
    10839         end.
    10840         reposition br-docs to recid recid(bf_ord-doc) no-error.
    10841         if not error-status:error then do:
    10842           apply "value-changed" to br-docs in frame d-all-docs .
    10843           display f-fo (buffer bf_ord-doc) @ v-fo with browse br-docs.
    10844           display  mark with browse br-docs.
    10845         end.
    10846       end.
    10847     end.
    10848     assign del-list = "".
    10849   find first bf_ord-doc where recid(bf_ord-doc) = v-doc-code no-lock no-error .
    10850   end.
    10851   end procedure.
    10852   PROCEDURE proc-m_gen-4-2 :
    10853   define buffer bf_sysconf for ub.sysconf.
    10854   define buffer bf_ord-doc for ub.ord-doc.
    10855   define variable v-i as integer no-undo.
    10856   define variable v-doc-code as integer no-undo.
    10857   define variable v-need-fo as logical no-undo.
    10858   define buffer bf_contract for ub.contract.
    10859   do on error undo, return error return-value
    10860   :
    10861   if del-list = "" then do:
    10862     if available shar-buf_ord-doc then assign del-list = string(recid(shar-buf_ord-doc)).
    10863   end.
    10864   define variable v-nn as integer   no-undo .
    10865   v-nn = num-entries (del-list) .
    10866   v-i-cycle:
    10867     do v-i = 1 to v-nn:
    10868       assign v-doc-code = integer(entry (v-i, del-list)) .
    10869       find first bf_ord-doc where recid(bf_ord-doc) = v-doc-code exclusive-lock.
    10870       if bf_ord-doc.doc-type <> 'ПО':U then next.
    10871       find first bf_sysconf where bf_sysconf.host-code = bf_ord-doc.host-code no-lock.
    10872       if bf_ord-doc.status_ <> 'факт':U then do:
    10873         message "Документ " bf_ord-doc.doc-code " не в статусе " 'факт':U " . Пропускаем."  view-as alert-box.
    10874         next.
    10875       end.
    10876       if bf_ord-doc.need-FO2 = 2 then do:
    10877         if bf_ord-doc.contract-code <> 0 then do:
    10878           find first bf_contract where bf_contract.host-code     = bf_ord-doc.host-code   and
    10879                                        bf_contract.contract-code = bf_ord-doc.contract-code no-lock no-error.
    10880           if available bf_contract then do:
    10881             if  true  then do:
    10882               assign bf_ord-doc.need-FO2 = 1  .
    10883               reposition br-docs to recid recid(bf_ord-doc) no-error.
    10884               if not error-status:error then do:
    10885                  apply "value-changed" to br-docs in frame d-all-docs .
    10886                  display f-FO (buffer bf_ord-doc) @ v-FO   mark  with browse br-docs.
    10887                  end.
    10888             end.
    10889             else message "По документу " bf_ord-doc.doc-code " нет договоров для генерации ФО."  view-as alert-box.
    10890           end.
    10891         end.
    10892       end.
    10893       else do:
    10894         message "Документ " bf_ord-doc.doc-code "не имеет признака 'не опред' генерация ФО."
    10895         view-as alert-box.
    10896         next v-i-cycle.
    10897       end.
    10898     end.
    10899     assign del-list = "" .
    10900   find first bf_ord-doc where recid(bf_ord-doc) = v-doc-code no-lock no-error .
    10901   end.
    10902   end procedure.
    10903   procedure clip-ord :
    10904   define output parameter p-recid as recid no-undo .
    10905   define buffer buf_ord-doc  for ub.ord-doc  .
    10906   define buffer new_ord-doc  for ub.ord-doc  .
    10907   define buffer new_ord-line for ub.ord-line  .
    10908   define buffer buf_ord-line for ub.ord-line  .
    10909   define buffer bb2_ord-line for ub.ord-line.
    10910   define buffer bb_ord-line  for ub.ord-line.
    10911   define buffer bb_goods for ub.goods  .
    10912   define variable loc-ord-num as character no-undo .
    10913     do
    10914     on error undo, return error return-value
    10915     :
    10916   for each tempclip-orddoc :
    10917     delete tempclip-orddoc.
    10918   end.
    10919   find current shar-buf_ord-doc no-lock .
    10920   p-recid = recid(shar-buf_ord-doc) .
    10921    if num-entries (del-list) < 2 then do:
    10922       message "Для объединения в один заказ нужно выделить не менее двух заказов!"  view-as alert-box information .
    10923       return .
    10924    end.
    10925   define variable v-nn   as integer   no-undo .
    10926   define variable v-i    as integer   no-undo .
    10927   define variable v-str  as character no-undo .
    10928   define variable v-diff as character no-undo .
    10929   define variable v-diff-contract as character no-undo init "" .
    10930   v-nn = num-entries (del-list).
    10931   find first buf_ord-doc exclusive-lock where
    10932         recid(buf_ord-doc) = integer ( entry (1, del-list)) no-error .
    10933   if error-status :error then return .
    10934   if buf_ord-doc.ord-int1 <> 0 then do:
    10935      message "Нельзя объединять заказы , которые уже начали обработку по EDOC\EDI !"
    10936      view-as alert-box information .
    10937      return .
    10938   end.
    10939    create tempclip-orddoc.
    10940    buffer-copy buf_ord-doc to tempclip-orddoc .
    10941    find first tempclip-orddoc.
    10942   define variable v-longchar as longchar no-undo .
    10943   define variable v-err-clip as logical   no-undo .
    10944   v-err-clip = false .
    10945     do v-i = 1 to v-nn :
    10946       find first  buf_ord-doc exclusive-lock where
    10947            recid (buf_ord-doc) = integer ( entry (v-i, del-list))  .
    10948            if not available buf_ord-doc then next.
    10949       if buf_ord-doc.status_ <> 'новый':U then do:
    10950         message "Объединять заказы  можно только в статусе НОВЫЙ !"
    10951         view-as alert-box information .
    10952         return .
    10953       end.
    10954       if buf_ord-doc.doc-type <> 'ОП':U then do:
    10955         message "Объединять  можно только заказы ОП !"
    10956         view-as alert-box information .
    10957         return .
    10958       end.
    10959       buffer-compare tempclip-orddoc EXCEPT
    10960         agnt
    10961         boss
    10962         cli-qnty
    10963         creid
    10964         date-sale-1
    10965         date-sale-2
    10966         doc-code
    10967         doc-date
    10968         e-method
    10969         end-date
    10970         exch-date
    10971         ord-method
    10972         out-code
    10973         qnty
    10974         real-date-create
    10975         real-time-create
    10976         start-date
    10977         sub-par
    10978         sum-base
    10979         sum-cli
    10980         sum-rubl
    10981         sys-date
    10982         sys-time-int
    10983         sys-time
    10984         tot-lines
    10985         user-db-num
    10986         user-name
    10987         whole-send-news
    10988         wrkr
    10989         fact-num
    10990         ps
    10991         cli-name
    10992         exch-date
    10993         transport-cli-code
    10994         transport-cli-type
    10995         transport-condition
    10996         transport-contract
    10997         transport-host-code
    10998         transport-value
    10999         transport-VAT
    11000         pay-day
    11001         contract-code
    11002         order-type
    11003         cycle-day
    11004         cli-out-doc
    11005       to buf_ord-doc save result in v-diff .
    11006       .
    11007       if entry(1, buf_ord-doc.cli-out-doc, chr(4)) <> entry(1, tempclip-orddoc.cli-out-doc, chr(4)) then do:
    11008         v-diff = v-diff + (if v-diff = '' then '' else chr(44)) + "cli-out-doc".
    11009       end.
    11010       if v-diff <> ""
    11011       then do:
    11012             define variable v-str2 as character no-undo .
    11013             define variable newstr as character no-undo .
    11014             define variable i as integer   no-undo .
    11015             define variable l as integer   no-undo .
    11016             v-str2 = v-diff .
    11017             newstr = "" .
    11018             repeat i = 1 to num-entries (v-str2) :
    11019               l = lookup ( entry (i,v-str2) , "base-rate,base-scale,buyer-out-code,cli-code,cli-out-doc,cli-point-code,cli-point-db-num,cli-type,cons-code,contract-code,cycle-day,date-pay,deliv-subj-code,deliv-type-code,doc-type,exch-code,exch-rate,exch-scale,fact-date,fact-order,fact-time,flag_,host-code,obj-code,obj-point-code,obj-point-db-num,obj-type,ord-date1,ord-date2,ord-date3,ord-dec1,ord-dec2,ord-dec3,ord-int1,ord-int2,ord-int3,order-type,pay-code,pay-day,shift-date,shift-name,shift-num,ship-date,ship-time,slt-type,vat-type,status_,sum-service,sum-ship,transport-cli-code,transport-cli-type,transport-condition,transport-contract,transport-host-code,transport-value,transport-VAT" )  .
    11020               newstr  = newstr + entry ( l , "Баз.валюта_м.б.,Баз.валюта_шкала,Номер по поставщику,Код Поставщика,Номер по Поставщику,Пункты доставки,Пункты доставки,Тип Поставщика,Код,Договор,Цикл,Дата платежа,Код доставки,Код доставки,Тип заказа,Валюта,Курс валюты поставщика,М.б. валюты поставщика,факт дата,факт номер,факт врем,флаг,фирма,Объект код,Доставка код,Доставка БД,Объект тип,ord-date1,ord-date2,ord-date3,ord-dec1,ord-dec2,ord-dec3,Статус Edoc-NN\EDI,ord-int2,ord-int3,тип заказа,код платежа,дней продаж,сменная дата,смена,смена №,Дата доставки (Заказ на),Время доставки,Тип НсП,Тип НДС,Статус,Сумма обслуживани,Сумма доставки,Транспортный договор (Контрагент код),Транспортный договор (Контрагент тип),Транспортный договор (условия),Транспортный договор (№ договора),Транспортный договор (код фирмы),Транспортный договор,Транспортный договор (НДС)" )  + ", " .
    11021             end.
    11022             newstr = trim(trim(newstr),"," ).
    11023             v-err-clip = true .
    11024             v-longchar = v-longchar +
    11025             substitute ( "Нельзя объединить заказ &1 c &2 , есть несовпадения (&3)&4" ,buf_ord-doc.doc-code,tempclip-orddoc.doc-code, newstr,chr(10) ) .
    11026       end.
    11027       else do:
    11028           buffer-compare tempclip-orddoc USING
    11029             contract-code
    11030           to buf_ord-doc save result in v-diff-contract .
    11031             if v-diff-contract <> "" then do:
    11032               v-diff-contract = "".
    11033             end.
    11034             else do:
    11035                 v-diff-contract = string (buf_ord-doc.contract-code) .
    11036             end.
    11037       end.
    11038       v-str = v-str + buf_ord-doc.doc-code + ", ".
    11039             for each  bb_ord-line no-lock where
    11040                    bb_ord-line.doc-code = tempclip-orddoc.doc-code :
    11041              find first bb2_ord-line no-lock where
    11042                         bb2_ord-line.doc-code = buf_ord-doc.doc-code and
    11043                         bb2_ord-line.gds-code = bb_ord-line.gds-code and
    11044                         bb2_ord-line.cli-art <> bb_ord-line.cli-art
    11045                         no-error .
    11046               if available bb2_ord-line then do:
    11047                   find first bb_goods no-lock where
    11048                              bb_goods.gds-code = bb2_ord-line.gds-code no-error .
    11049                   v-err-clip = true .
    11050                   v-longchar = v-longchar +
    11051                   substitute ( "Нельзя объединить заказ &1 c &2 , есть несовпадения по артикулу поставщика Товар &3 &4&5 &6 &7" ,buf_ord-doc.doc-code,tempclip-orddoc.doc-code,bb_ord-line.artic,bb_ord-line.prod-type,bb_ord-line.prod-code ,bb_goods.gds-name,chr(10)) .
    11052               end.
    11053              find first bb2_ord-line no-lock where
    11054                         bb2_ord-line.doc-code = buf_ord-doc.doc-code and
    11055                         bb2_ord-line.gds-code = bb_ord-line.gds-code and
    11056                         bb2_ord-line.price-cli <>  bb_ord-line.price-cli
    11057                         no-error .
    11058               if available bb2_ord-line then do:
    11059                   find first bb_goods no-lock where
    11060                              bb_goods.gds-code = bb2_ord-line.gds-code no-error .
    11061                   v-err-clip = true .
    11062                   v-longchar = v-longchar +
    11063                   substitute ( "Нельзя объединить заказ &1 c &2 , есть несовпадения по цене поставщика Товар &3 &4&5 &6 (&8 и &9)&7" ,buf_ord-doc.doc-code,tempclip-orddoc.doc-code,bb_ord-line.artic,bb_ord-line.prod-type,bb_ord-line.prod-code ,bb_goods.gds-name,chr(10), bb2_ord-line.price-cli , bb_ord-line.price-cli) .
    11064               end.
    11065           end.
    11066     end.
    11067     if v-err-clip = true   then do:
    11068         run gbl/d-longchar.w (
    11069                 ?,
    11070                 'Editor_row=2\':u
    11071               + 'title=Ошибки объединения заказов\':u
    11072               + 'Editor_col=1\':u
    11073               + 'Editor_width=96\':u
    11074               + 'Editor_height=21\':u
    11075               + 'readonly=yes\':u
    11076             ,input-output v-longchar
    11077             ,output v-ok ) no-error .
    11078             if error-status :error then message
    11079               vss-workfile vss-revision vss-description skip
    11080               error-status :get-message(1) skip
    11081               return-value skip
    11082               "4"
    11083               view-as alert-box error
    11084             .
    11085             assign
    11086             v-longchar = '':U.
    11087       return error "Заказ не может быть закрыт ! Исправьте внешние артикулы Поставщика" .
    11088     end.
    11089     v-str = trim(trim(v-str),"," ).
    11090     message "Объединять заказы " v-str
    11091             "в один ? "
    11092             view-as alert-box question
    11093             buttons yes-no
    11094             update v-okk as logical
    11095           .
    11096     if v-okk = false then return .
    11097   define variable v-i-doc as character no-undo .
    11098   define variable vss-include-info100 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11099   run proc-ord-code in this-procedure
    11100    (input   'main' ,
    11101     input   v-cntxt-db-num ,
    11102     input   v-cntxt-obj-type ,
    11103     input   v-cntxt-obj-code ,
    11104     input   v-i-doc ,
    11105     output  loc-ord-num
    11106    ) .
    11107     define variable v-ln as integer   no-undo .
    11108     v-ln = 0.
    11109     do v-i = 1 to v-nn :
    11110       find first buf_ord-doc exclusive-lock where
    11111            recid(buf_ord-doc) = integer ( entry (v-i, del-list))  no-error .
    11112            if not available buf_ord-doc then next.
    11113            run save-orddoc ( buffer buf_ord-doc , input loc-ord-num) .
    11114             for each buf_ord-line exclusive-lock where
    11115                      buf_ord-line.doc-code =  buf_ord-doc.doc-code by  buf_ord-line.line-num :
    11116                      run save-ordline
    11117                          ( input loc-ord-num ,
    11118                            input buf_ord-line.doc-code,
    11119                            input buf_ord-line.gds-code,
    11120                            input buf_ord-line.cli-qnty,
    11121                            input buf_ord-doc.order-type
    11122                            ) no-error  .
    11123                      if error-status :error then message
    11124                        vss-workfile vss-revision vss-description skip
    11125                        error-status :get-message(1) skip
    11126                        return-value skip
    11127                        "save-ordline"
    11128                        view-as alert-box error
    11129                      .
    11130                     find first new_ord-line exclusive-lock where
    11131                                new_ord-line.doc-code =  loc-ord-num and
    11132                                new_ord-line.gds-code =  buf_ord-line.gds-code no-error .
    11133                     if available new_ord-line then do:
    11134                         new_ord-line.qnty     =  new_ord-line.qnty     + buf_ord-line.qnty .
    11135                         new_ord-line.cli-qnty =  new_ord-line.cli-qnty + buf_ord-line.cli-qnty.
    11136                         new_ord-line.sum-rubl =  new_ord-line.sum-rubl + buf_ord-line.sum-rubl.
    11137                         new_ord-line.sum-base =  new_ord-line.sum-base + buf_ord-line.sum-base.
    11138                         new_ord-line.sum-cli  =  new_ord-line.sum-cli  + buf_ord-line.sum-cli.
    11139                         new_ord-line.sum-vat  =  new_ord-line.sum-vat  + buf_ord-line.sum-vat.
    11140                     end.
    11141                     else do:
    11142                        v-ln = v-ln + 1.
    11143                        assign
    11144                         buf_ord-line.doc-code = loc-ord-num
    11145                         buf_ord-line.line-num = v-ln
    11146                         .
    11147                     end.
    11148               end.
    11149     delete buf_ord-doc.
    11150     end.
    11151     create new_ord-doc.
    11152     buffer-copy tempclip-orddoc to new_ord-doc
    11153       assign
    11154         new_ord-doc.doc-code     = loc-ord-num
    11155         new_ord-doc.doc-date     = to-day
    11156         new_ord-doc.contract-code = integer(v-diff-contract)
    11157       .
    11158       p-recid = recid ( new_ord-doc ) .
    11159       del-list = "" .
    11160   end.
    11161   end procedure.
    11162   procedure save-orddoc :
    11163   define parameter buffer  buf_ord-doc for ub.ord-doc.
    11164   define input  parameter p-new-ord-num as character no-undo .
    11165   define variable v-new-code as character no-undo .
    11166     do
    11167     on error undo, return error return-value
    11168     :
    11169     if buf_ord-doc.order-type = 0 then return .
    11170     assign
    11171       tempclip-orddoc.order-type    = 4
    11172       tempclip-orddoc.contract-code = 0
    11173       tempclip-orddoc.cycle-day     = 0
    11174     .
    11175     v-new-code = p-new-ord-num + chr(4) + buf_ord-doc.doc-code .
    11176     run orddocattr-write (
    11177          input v-new-code
    11178         ,input 'cycle-doc-code':U
    11179         ,input buf_ord-doc.doc-code) no-error .
    11180         if error-status :error then
    11181         message
    11182           vss-workfile vss-revision vss-description skip
    11183           error-status :get-message(1) skip
    11184           return-value skip
    11185           "Ошибка из orddocattr-write"
    11186           view-as alert-box error
    11187         .
    11188     run orddocattr-write (
    11189          input v-new-code
    11190         ,input 'cycle-day':U
    11191         ,input string(buf_ord-doc.cycle-day)) no-error .
    11192         if error-status :error then
    11193         message
    11194           vss-workfile vss-revision vss-description skip
    11195           error-status :get-message(1) skip
    11196           return-value skip
    11197           "Ошибка из orddocattr-write"
    11198           view-as alert-box error
    11199         .
    11200     run orddocattr-write (
    11201          input v-new-code
    11202         ,input 'cycle-doc-date':U
    11203         ,input string(buf_ord-doc.doc-date , "99/99/9999" )) no-error .
    11204         if error-status :error then
    11205         message
    11206           vss-workfile vss-revision vss-description skip
    11207           error-status :get-message(1) skip
    11208           return-value skip
    11209           "Ошибка из orddocattr-write"
    11210           view-as alert-box error
    11211         .
    11212     run orddocattr-write (
    11213          input v-new-code
    11214         ,input 'exch-code':U
    11215         ,input string(buf_ord-doc.exch-code)) no-error .
    11216         if error-status :error then
    11217         message
    11218           vss-workfile vss-revision vss-description skip
    11219           error-status :get-message(1) skip
    11220           return-value skip
    11221           "Ошибка из orddocattr-write"
    11222           view-as alert-box error
    11223         .
    11224     run orddocattr-write (
    11225          input v-new-code
    11226         ,input 'exch-rate':U
    11227         ,input string(buf_ord-doc.exch-rate)) no-error .
    11228         if error-status :error then
    11229         message
    11230           vss-workfile vss-revision vss-description skip
    11231           error-status :get-message(1) skip
    11232           return-value skip
    11233           "Ошибка из orddocattr-write"
    11234           view-as alert-box error
    11235         .
    11236     run orddocattr-write (
    11237          input v-new-code
    11238         ,input 'base-rate':U
    11239         ,input string(buf_ord-doc.base-rate)) no-error .
    11240         if error-status :error then
    11241         message
    11242           vss-workfile vss-revision vss-description skip
    11243           error-status :get-message(1) skip
    11244           return-value skip
    11245           "Ошибка из orddocattr-write"
    11246           view-as alert-box error
    11247         .
    11248     run orddocattr-write (
    11249          input v-new-code
    11250         ,input 'base-scale':U
    11251         ,input string(buf_ord-doc.base-scale)) no-error .
    11252         if error-status :error then
    11253         message
    11254           vss-workfile vss-revision vss-description skip
    11255           error-status :get-message(1) skip
    11256           return-value skip
    11257           "Ошибка из orddocattr-write"
    11258           view-as alert-box error
    11259         .
    11260     run orddocattr-write (
    11261          input v-new-code
    11262         ,input 'cycle-done':U
    11263         ,input "no") no-error .
    11264         if error-status :error then
    11265         message
    11266           vss-workfile vss-revision vss-description skip
    11267           error-status :get-message(1) skip
    11268           return-value skip
    11269           "Ошибка из orddocattr-write"
    11270           view-as alert-box error
    11271         .
    11272     run orddocattr-write (
    11273          input  v-new-code
    11274         ,input 'cycle-contract-code':U
    11275         ,input string(buf_ord-doc.contract-code)) no-error .
    11276         if error-status :error then
    11277         message
    11278           vss-workfile vss-revision vss-description skip
    11279           error-status :get-message(1) skip
    11280           return-value skip
    11281           "Ошибка из orddocattr-write"
    11282           view-as alert-box error
    11283         .
    11284     run orddocattr-write (
    11285          input v-new-code
    11286         ,input 'cycle-ship-date':U
    11287         ,input string(buf_ord-doc.ship-date, "99/99/9999" )) no-error .
    11288         if error-status :error then
    11289         message
    11290           vss-workfile vss-revision vss-description skip
    11291           error-status :get-message(1) skip
    11292           return-value skip
    11293           "Ошибка из orddocattr-write"
    11294           view-as alert-box error
    11295         .
    11296     run orddocattr-write (
    11297          input v-new-code
    11298         ,input 'cycle-ship-time':U
    11299         ,input string(buf_ord-doc.ship-time)) no-error .
    11300         if error-status :error then
    11301         message
    11302           vss-workfile vss-revision vss-description skip
    11303           error-status :get-message(1) skip
    11304           return-value skip
    11305           "Ошибка из orddocattr-write"
    11306           view-as alert-box error
    11307         .
    11308     run orddocattr-write (
    11309          input v-new-code
    11310         ,input 'cycle-date1':U
    11311         ,input string(buf_ord-doc.date-sale-1, "99/99/9999" )) no-error .
    11312         if error-status :error then
    11313         message
    11314           vss-workfile vss-revision vss-description skip
    11315           error-status :get-message(1) skip
    11316           return-value skip
    11317           "Ошибка из orddocattr-write"
