      599   function cross-list returns logical (
      600     input parfirst-stream  as character,
      601     input parsecond-stream as character,
      602     input pardelim         as character).
      603     if pardelim = ""
      604     or pardelim = ?
      605     then do:
      606       assign
      607         pardelim = ","
      608       .
      609     end.
      610     define variable vari            as integer no-undo .
      611     define variable varresult-cross as logical no-undo .
      612     assign
      613       varresult-cross = no
      614     .
      615     def var v-num-parfirst-stream as integer no-undo .
      616     assign
      617       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      618     .
      619     do vari = 1 to v-num-parfirst-stream
      620     :
      621       if lookup(entry(vari, parfirst-stream, pardelim)
      622                ,parsecond-stream
      623                ,pardelim
      624                ) > 0 then do:
      625         assign
      626           varresult-cross = yes
      627         .
      628         leave.
      629       end.
      630     end.
      631     return varresult-cross .
      632   end function.
      633   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      634   function octal-to-char return character
      635   ( p-string as character ) :
      636     def var v-asc     as integer no-undo .
      637     def var v-new-asc as integer no-undo .
      638     def var ind       as integer no-undo .
      639     if length(p-string) <> 3 then do:
      640       return ? .
      641     end.
      642     assign
      643       v-asc = 0
      644     .
      645     do ind = 1 to length(p-string)
      646     :
      647       assign
      648         v-new-asc = asc(substring(p-string, ind, 1)) - asc('0')
      649       .
      650       if v-new-asc < 0 or v-new-asc >= 8 then do:
      651         return ? .
      652       end.
      653       assign
      654         v-asc = v-asc * 8 + v-new-asc
      655       .
      656     end.
      657     return chr(v-asc) .
      658   end function .
      659   function char-to-octal return character
      660   ( p-chr as character ) :
      661     def var v-asc    as integer   no-undo .
      662     def var ind      as integer   no-undo .
      663     def var v-string as character no-undo .
      664     if length(p-chr) <> 1 then do:
      665       return ? .
      666     end.
      667     assign
      668       v-asc    = asc(p-chr)
      669       v-string = ""
      670     .
      671     do ind = 1 to 3
      672     :
      673       assign
      674         v-string = chr( v-asc mod 8 + asc('0')) + v-string
      675       .
      676       assign
      677         v-asc = truncate(v-asc / 8, 0)
      678       .
      679     end.
      680     return v-string .
      681   end.
      682   function str-encode return character
      683   (   p-init-string       as character
      684     , p-encode-char       as character
      685     , p-special-char-list as character
      686   ) :
      687     def var p-encode-string as character no-undo .
      688     def var ind                as integer no-undo .
      689     def var v-num-special-char as integer no-undo .
      690     def var v-special-char     as character no-undo .
      691     if p-encode-char = ?
      692     or p-encode-char = "" then do:
      693       assign
      694         p-encode-char = "~~"
      695       .
      696     end.
      697     if p-init-string = ? then do:
      698       return "?" .
      699     end.
      700     if p-init-string = "?" then do:
      701       return p-encode-char + char-to-octal("?") .
      702     end.
      703     assign
      704       v-num-special-char = length(p-special-char-list)
      705       p-encode-string    = replace(p-init-string
      706                                   ,p-encode-char
      707                                   ,p-encode-char + char-to-octal(p-encode-char)
      708                                   )
      709     .
      710     do ind = 1 to v-num-special-char
      711     :
      712       assign
      713         v-special-char = substring(p-special-char-list, ind, 1)
      714       .
      715       if v-special-char <> p-encode-char then do:
      716         assign
      717           p-encode-string = replace (p-encode-string
      718                                     ,v-special-char
      719                                     ,p-encode-char + char-to-octal(v-special-char)
      720                                     )
      721         .
      722       end.
      723     end.
      724     return p-encode-string .
      725   end.
      726   function str-decode returns character
      727     (p-init-string   as character
      728     ,p-encode-char   as character
      729     ) :
      730     def var p-decode-string as character no-undo .
      731     def var ind                       as integer no-undo .
      732     def var v-num-entries-init-string as integer no-undo .
      733     def var v-sub-phrase              as character no-undo .
      734     def var v-special-char            as character no-undo .
      735     if p-encode-char = ?
      736     or p-encode-char = "" then do:
      737       assign
      738         p-encode-char = "~~"
      739       .
      740     end.
      741     if p-init-string = "?" then do:
      742       return ? .
      743     end.
      744     assign
      745       v-num-entries-init-string = num-entries(p-init-string, p-encode-char)
      746     .
      747     if v-num-entries-init-string > 1 then do:
      748       assign
      749         p-decode-string = entry(1, p-init-string, p-encode-char)
      750       .
      751       do ind = 2 to v-num-entries-init-string
      752       :
      753         assign
      754           v-sub-phrase = entry(ind, p-init-string, p-encode-char)
      755         .
      756         assign
      757           v-special-char = octal-to-char(substring(v-sub-phrase, 1, 3))
      758         .
      759         if v-special-char <> ? then do:
      760           assign
      761             p-decode-string = p-decode-string
      762                             + v-special-char
      763                             + substring(v-sub-phrase, 4)
      764           .
      765         end.
      766         else do:
      767           assign
      768             p-decode-string = p-decode-string
      769                             + p-encode-char
      770                             + v-sub-phrase
      771           .
      772         end.
      773       end.
      774     end.
      775     else do:
      776       assign
      777         p-decode-string = p-init-string
      778       .
      779     end.
      780     return p-decode-string .
      781   end.
      782   procedure proc-alt-shift-f2:
