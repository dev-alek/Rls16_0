     3523         delete buf_ord-line-attr.
     3524         p-deleted = yes.
     3525       end.
     3526     end.
     3527   end procedure.
     3528   procedure ordlineattr-code :
     3529     do on error undo, return error return-value
     3530     :
     3531       define input  parameter p-code           as character no-undo .
     3532       define output parameter p-type           as character no-undo .
     3533       define output parameter p-format         as character no-undo .
     3534       define output parameter p-fillin_width   as integer   no-undo .
     3535       define output parameter p-fillin_height  as integer   no-undo .
     3536       define output parameter p-label          as character no-undo .
     3537       define output parameter p-user-can-edit  as logical   no-undo .
     3538       define output parameter p-output-display as logical   no-undo .
     3539       define output parameter p-proc           as character no-undo .
     3540       define output parameter p-func           as character no-undo .
     3541       define output parameter p-sort           as integer   no-undo .
     3542       define output parameter p-other          as character no-undo .
     3543       case p-code :
     3544               when 'cycle-cli-qnty':U then do:     assign     p-label          = "Количество"     p-type           = 'D':U      p-format         = ">>>>>>>>>>>>>>>9.999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Количество"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3545               when 'ord-EAN13':U then do:     assign     p-label          = "EAN в EDI"     p-type           = 'C':U      p-format         = "X(13)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "EAN в EDI"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3546         otherwise do:
     3547           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
     3548         end.
     3549       end.
     3550     end.
     3551   end procedure.
