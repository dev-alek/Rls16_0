     7725         parameter-4-73 =
     7726           "where ":u +  substitute(' shar-buf_ord-doc.host-code =  &1 ' , g#host-code )  + " ":u + where-phrase-73 + " ":u + p-find-condition + " " + ""
     7727         parameter-5-73 = " USE-INDEX ByFirm "
     7728       .
