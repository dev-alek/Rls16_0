     4168    else do:
     4169        message "Печать документа только для заказов Фирма - Поставщик" view-as alert-box.
     4170        end.
     4171           END.
     4172   ON CHOOSE OF MENU-ITEM m_PRINT2
     4173   DO:
     4174   define variable j as integer init 0 no-undo .
     4175   DEFINE  BUFFER post-firm    for ub.firm.
     4176   DEFINE  BUFFER zak-firm     for ub.firm.
     4177   DEFINE  BUFFER ord-blank-1  for ub.ord-blank.
     4178   DEFINE VARIABLE chExcelApplication      AS COM-HANDLE no-undo .
     4179   DEFINE VARIABLE chWorkbook              AS COM-HANDLE no-undo .
     4180   DEFINE VARIABLE chWorksheet             AS COM-HANDLE no-undo .
     4181   define variable PrintRubl  as logical   no-undo .
     4182   define variable Abbr       as character no-undo .
     4183   define variable PropisSum  as character no-undo .
     4184   define variable B-Sum      as decimal   no-undo .
     4185   DEFINE VARIABLE N#ROW         as  integer  no-undo .
     4186   DEFINE VARIABLE GoodN#ROW     as  integer  no-undo .
     4187   DEFINE VARIABLE GoodEI#ROW    as  integer  no-undo .
     4188   DEFINE VARIABLE OKEI#ROW      as  integer  no-undo .
     4189   DEFINE VARIABLE Qnty#ROW      as  integer  no-undo .
     4190   DEFINE VARIABLE Cost#ROW      as  integer  no-undo .
     4191   DEFINE VARIABLE Summa#ROW     as  integer  no-undo .
     4192   DEFINE VARIABLE N#col         as  integer  no-undo .
     4193   DEFINE VARIABLE GoodN#col     as  integer  no-undo .
     4194   DEFINE VARIABLE GoodEI#col    as  integer  no-undo .
     4195   DEFINE VARIABLE OKEI#col      as  integer  no-undo .
     4196   DEFINE VARIABLE Qnty#col      as  integer  no-undo .
     4197   DEFINE VARIABLE Cost#col      as  integer  no-undo .
     4198   DEFINE VARIABLE Summa#col     as  integer  no-undo .
     4199   DEFINE VARIABLE Sort#ROW      as  integer  no-undo .
     4200   DEFINE VARIABLE Sort#COL      as  integer  no-undo .
     4201   DEFINE VARIABLE GoodCode#ROW  as  integer  no-undo .
     4202   DEFINE VARIABLE GoodCode#COL  as  integer  no-undo .
     4203   DEFINE VARIABLE CliArt#ROW    as  integer  no-undo .
     4204   DEFINE VARIABLE CliArt#COL    as  integer  no-undo .
     4205   DEFINE VARIABLE Art#ROW       as  integer  no-undo .
     4206   DEFINE VARIABLE Art#COL       as  integer  no-undo .
     4207     if not available shar-buf_ord-doc then return .
     4208   define variable Current-ROW  as integer no-undo .
     4209    if blank#name = ?  or blank#name = "" Then
     4210       Find first ub.ord-blank
     4211            where ub.ord-blank.cli-code = shar-buf_ord-doc.cli-code
     4212              and ub.ord-blank.cli-type = shar-buf_ord-doc.cli-type
     4213              and ub.ord-blank.last-use = TRUE
     4214            no-lock no-error.
     4215      else
     4216       Find first ub.ord-blank
     4217            where ub.ord-blank.cli-code = shar-buf_ord-doc.cli-code
     4218              and ub.ord-blank.cli-type = shar-buf_ord-doc.cli-type
     4219              and ub.ord-blank.blank-name = blank#name
     4220             no-lock no-error.
     4221      if not  available  ub.ord-blank  then do :
     4222         Message "Для этого поставщика нет формы !   Задайте ее в режиме  <<выбор формы печати>>".
     4223         Return.
     4224         End.
     4225      if  available  ub.ord-blank  then do :
     4226          Assign blank#name = ?.
     4227          For each ord-blank-1 where ub.ord-blank-1.cli-code = shar-buf_ord-doc.cli-code
     4228                                 and ub.ord-blank-1.cli-type = shar-buf_ord-doc.cli-type   exclusive-lock :
     4229          if  ord-blank.blank-name = ub.ord-blank-1.blank-name and
     4230              ord-blank.cli-code = ub.ord-blank-1.cli-code     and
     4231              ord-blank.cli-type = ub.ord-blank-1.cli-type then  ord-blank-1.last-use = TRUE .
     4232              Else ord-blank-1.last-use = false  .
     4233          End.
     4234    B-Sum = shar-buf_ord-doc.sum-Service + shar-buf_ord-doc.sum-Ship + shar-buf_ord-doc.sum-cli.
     4235    FIND ub.currency NO-LOCK WHERE ub.currency.curr-code = shar-buf_ord-doc.exch-code no-error .
     4236    if shar-buf_ord-doc.exch-code <> 0 then
     4237          assign
     4238           PrintRubl = false
     4239           abbr = ub.currency.curr-abbr
     4240           .
     4241    else  PrintRubl =  true .
     4242         if NOT PrintRubl then
     4243              assign
     4244               PropisSum = Total-Word( B-Sum, ub.currency.curr-abbr, ub.currency.part-abbr )
     4245             .
     4246         else
     4247             run rep/wp-rub.p ( B-Sum , output PropisSum, output abbr).
     4248   CREATE "Excel.Application" chExcelApplication no-error.
     4249       if error-status :error then do:
     4250           message
     4251           "Ошибка при запуске Excel" skip
     4252           error-status :get-message(1) skip
     4253           view-as alert-box error .
     4254           return no-apply .
     4255       end.
     4256   ASSIGN
     4257     chExcelApplication:Visible = FALSE
     4258     chWorkbook  = chExcelApplication:Workbooks:Add ( ub.ord-blank.file-name )
     4259     chWorkSheet = chExcelApplication:Sheets:Item (1)
     4260     chExcelApplication:Interactive    = false
     4261     chExcelApplication:ScreenUpdating = false
     4262     .
     4263         Find first post-firm where  post-firm.firm-code = shar-buf_ord-doc.cli-code no-lock  no-error .
