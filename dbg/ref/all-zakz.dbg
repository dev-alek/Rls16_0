     1995   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1996   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1997   define variable v-waitfram-action01         as character   no-undo .
     1998   define variable v-waitfram-action02         as character   no-undo .
     1999   define variable v-waitfram-action03         as character   no-undo .
     2000   define variable mWaitFramTextBeg            as character   no-undo.
     2001   define variable mWaitFramTextEnd            as character   no-undo.
     2002   define variable mWaitFramView               as logical     no-undo.
     2003   define variable mWaitProcEvent              as logical     no-undo init yes.
     2004   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2005   define variable mWaitFramStop               as logical     no-undo.
     2006   define variable mWaitFramStopUser           as logical     no-undo.
     2007   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2008   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2009   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2010   define button B-WaitFramStop auto-end-key
     2011        label "Стоп"
     2012        size 10 by 1 tooltip "Остоновить процесс".
     2013   define button B-viewProcInfo
     2014        label "Информация"
     2015        size 15 by 1 tooltip "Информация о процесс".
     2016   define frame waitfram
     2017     v-waitfram-action01 format "x(72)" no-label skip
     2018     v-waitfram-action02 format "x(72)" no-label skip
     2019     v-waitfram-action03 format "x(72)" no-label skip
     2020     B-viewProcInfo
     2021     B-WaitFramStop at row 4 col 30
     2022     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2023     .
     2024   define new global shared variable mBatchMode as logical no-undo init ?.
     2025   define variable mFramBachModHandle as handle no-undo.
     2026   mFramBachModHandle = frame waitfram:handle.
     2027   define variable mFameOldVis as logical no-undo.
     2028   define variable mVisCUrentVin as logical no-undo.
     2029   if session:batch-mode
     2030   then
     2031      mBatchMode = yes.
     2032   if mBatchMode = ? then do:
     2033     mVisCUrentVin = current-window:visible.
     2034     mFameOldVis = mFramBachModHandle:visible.
     2035     mFramBachModHandle:visible  = yes.
     2036     mBatchMode = mFramBachModHandle:visible ne yes.
     2037     mFramBachModHandle:visible = mFameOldVis.
     2038     current-window:visible = mVisCUrentVin.
     2039   end.
     2040    if  log-manager:logfile-name ne ?
     2041     then DO:
     2042         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2043         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2044         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2045     end.
     2046   on choose of B-WaitFramStop in frame waitfram
     2047   do:
     2048     mWaitFramStop = yes.
     2049     mWaitFramStopUser = yes.
     2050   end.
     2051   function waitfram-check-timeout returns logical():
     2052      define variable vtime as int64 no-undo.
     2053      if mWaitFramStopTimeOut
     2054      then
     2055         return yes.
     2056      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2057      if     mWaitFramTimeOut ne ?
     2058         and mWaitFramTimeOut ne 0
     2059         and mWaitFramTimeOut lt vtime
     2060      then do:
     2061         mWaitFramStopTimeOut = yes.
     2062      end.
     2063      return mWaitFramStopTimeOut.
     2064   end.
     2065   procedure waitfram-hide :
     2066     if not session:batch-mode
     2067     then do
     2068     on error undo, return error return-value
     2069     :
     2070       pause 0 before-hide .
     2071       if not mBatchMode then
     2072         hide frame waitfram .
     2073     if     not mWaitFramView
     2074        and mWaitProcEvent
     2075     then
     2076       process events .
     2077     end.
     2078   end procedure.
     2079   procedure waitfram-show :
     2080     define input  parameter p-message as character no-undo .
     2081     define variable v-left-margin as integer   no-undo .
     2082     if not session:batch-mode
     2083     then do
     2084     on error undo, return error return-value
     2085     :
     2086       if length(p-message) <= 70 then do:
     2087         assign
     2088           v-left-margin = integer((70 - length(p-message)) / 2)
     2089         .
     2090         assign
     2091           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2092         .
     2093         assign
     2094           v-waitfram-action01 = " "
     2095           v-waitfram-action02 = " "
     2096                                    + fill(" ", v-left-margin)
     2097                                    + p-message
     2098           v-waitfram-action03 = " "
     2099         .
     2100       end.
     2101       else do:
     2102         define variable vRindex1 as integer no-undo.
     2103         define variable vRindex2 as integer no-undo.
     2104         vRindex1 = r-index(p-message," ",70).
     2105         if vRindex1 = 0
     2106         then
     2107            vRindex1 = 70.
     2108         if length(p-message)  <= vRindex1 + 70 then do:
     2109           assign
     2110             v-waitfram-action01 = " "
     2111             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2112             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2113           .
     2114         end.
     2115         else do:
     2116           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2117           if vRindex2 <= vRindex1
     2118           then
     2119              vRindex2 = vRindex1 + 70.
     2120           assign
     2121             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2122             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2123             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2124           .
     2125         end.
     2126       end.
     2127       B-viewProcInfo:visible   in frame waitfram = no.
     2128       B-viewProcInfo:sensitive in frame waitfram = no.
     2129       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2130       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2131       if  (   mWaitFramView
     2132          or  mWaitProcEvent)
     2133          and not mBatchMode
     2134       then
     2135          display
     2136             v-waitfram-action01 skip
     2137             v-waitfram-action02 skip
     2138             v-waitfram-action03 skip
     2139          with frame waitfram .
     2140       if     mWaitFramView
     2141          then do:
     2142             if     mWaitFramInterval ne ?
     2143                and not mBatchMode
     2144             then
     2145                wait-for go of frame waitfram pause mWaitFramInterval.
     2146          end.
     2147          else
     2148             if     mWaitProcEvent
     2149                and not mBatchMode
     2150             then
     2151                process events .
     2152     end.
     2153   end procedure.
     2154      procedure waitfram-show-this:
     2155         define input  parameter iInterval as int64 no-undo.
     2156         define variable vtime as int64 no-undo.
     2157         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2158         mWaitFramInterval = iInterval.
     2159         run waitfram-show (substitute("&1&2 &3&4" ,
     2160                                       mWaitFramTextBeg ,
     2161                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2162                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2163                                       mWaitFramTextEnd
     2164                                      )
     2165                           ).
     2166      end.
     2167      procedure WaitFramRunPause:
     2168         define input  parameter iInterval as dec no-undo.
     2169         define variable vStart  as datetime-tz no-undo.
     2170         define variable vend    as datetime-tz no-undo.
     2171         define variable vint as int64 no-undo.
     2172         define variable vOk as logical no-undo.
     2173         vStart = now.
     2174         vend   = vStart.
     2175         publish "WaitFramPause" (iInterval,output vOk).
     2176         vend   =  now.
     2177         vint = vend - vStart.
     2178         vint = iInterval - vint / 1000.
     2179         if     not mWaitFramStop
     2180            and (   vint > 0
     2181                 or (    not vOk
     2182                     and iInterval eq ?
     2183                     )
     2184                 )
     2185         then
     2186            run waitfram-show-this (iInterval).
     2187         vend   =  now.
     2188         vint = vend - vStart.
     2189         vint = iInterval - vint / 1000.
     2190         if     not mWaitFramStop
     2191            and vint > 0
     2192         then do:
     2193            run gbl/pause.p (vint * 1000).
     2194         end.
     2195         if iInterval ne ?
     2196         then
     2197            publish "WaitFramStop".
     2198         waitfram-check-timeout().
     2199      end.
     2200      procedure WaitFramWaitFor:
     2201         define input  parameter iInterval as dec no-undo.
     2202         assign
     2203            mWaitFramStartProc   = now
     2204            mWaitFramStopUser    = no
     2205            mWaitFramStopTimeOut = no
     2206         .
     2207         block-wait:
     2208         do while not mWaitFramStop:
     2209            run WaitFramRunPause (iInterval).
     2210            if  waitfram-check-timeout()
     2211            then do:
     2212               leave block-wait.
     2213            end.
     2214         end.
     2215         run waitfram-hide.
     2216      end.
     2217   procedure waitfram-join :
     2218     define input  parameter p-line-1  as character no-undo .
     2219     define input  parameter p-line-2  as character no-undo .
     2220     define input  parameter p-line-3  as character no-undo .
     2221     define output parameter p-message as character no-undo .
     2222     do
     2223     on error undo, return error return-value
     2224     :
     2225       assign
     2226         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2227                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2228                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2229       .
     2230     end.
     2231   end procedure.
     2232   function waitfram-join-function returns character
     2233     (input p-line-1 as character
     2234     ,input p-line-2 as character
     2235     ,input p-line-3 as character
     2236     ).
     2237     define variable v-message as character no-undo .
     2238     run waitfram-join in this-procedure
     2239       (input  p-line-1
     2240       ,input  p-line-2
     2241       ,input  p-line-3
     2242       ,output v-message
     2243       ) .
     2244     return v-message .
     2245   end function .
     2246   def var vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2247   define new global shared variable g#attr-lib  as handle no-undo .
     2248   define variable v-attr-lib-variable as handle no-undo .
     2249   procedure clntattr-code :
     2250     define input  parameter p-code           as character no-undo .
     2251     define output parameter p-type           as character no-undo .
     2252     define output parameter p-format         as character no-undo .
     2253     define output parameter p-label          as character no-undo .
     2254     define output parameter p-user-can-edit  as logical   no-undo .
