     7507    x-mode =  list-mode.
     7508   MAIN-BLOCK:
     7509   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     7510      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     7511      ON STOP    UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     7512   find sch-cli where recid (sch-cli) = p-doc-rec no-lock no-error.
     7513   find sch-cons where recid (sch-cons) = p-doc-rec no-lock no-error.
     7514   find sch-contract where recid (sch-contract) = p-doc-rec no-lock no-error.
     7515   doc-rec = ?.
     7516   define variable v-ok as logical   no-undo .
     7517   define variable v-mail as logical no-undo.
     7518   v-mail = b-email:load-image ("cmp/www.bmp").
     7519   v-ok = b-cons:load-IMAGE ("cmp/group.bmp") .
     7520   ENABLE b-quit  b-print b-sch b-history b-help br-docs  sch-code sch-date sch-fact ed-notes  b-rep  b-exec b-cons b-email
     7521   WITH FRAME d-all-docs.
     7522    hide b-open in frame d-all-docs .
     7523   if is-edoc-nn = false and is-edi = false then  do:
     7524      str-status-edoc-nn:VISIBLE IN BROWSE br-docs = FALSE.
     7525   end.
     7526   if g#type = 'ФП':U or  g#type = 'ОФ':U then
     7527       assign
     7528         str-status-edoc-nn:VISIBLE IN BROWSE br-docs = FALSE
     7529       .
     7530   if lookup (x-mode,"firm-fin,firm-fintypestatus,without-fotypestatus,without-fo,with-fotypestatus,with-fo") > 0 then
     7531   br-docs:MOVE-COLUMN ( 15, 8 ) IN FRAME d-all-docs .
     7532   run UI-on in this-procedure (yes, no, '':U).
     7533   run mode-g#type in this-procedure.
     7534   apply "value-changed" to br-docs in frame d-all-docs   .
     7535   WAIT-FOR GO OF FRAME d-all-docs focus br-docs.
     7536   END.
     7537   run disable_UI in this-procedure .
     7538   PROCEDURE disable_UI :
     7539     HIDE FRAME d-all-docs.
     7540   END PROCEDURE.
     7541   PROCEDURE UI-on :
     7542   define input  parameter   p-open-query     as logical   no-undo init true .
     7543   define input  parameter   p-find-next      as logical   no-undo init false .
     7544   define input  parameter   p-find-condition as character no-undo .
     7545     if p-open-query then frame d-all-docs:title = "ВСЕ  ДОКУМЕНТЫ".
     7546     sch-num = 0.
     7547     hide sch-num in frame d-all-docs.
     7548   define variable v-l-mode as character no-undo .
     7549   v-l-mode = list-mode .
     7550   x-mode  = list-mode.
     7551   if g#type <> "all" and g#type <> ? then x-mode  = list-mode + "type" .
     7552   if g#stat <> "all" and g#stat <> ? then x-mode  = list-mode + "type" + "status".
     7553   Disable b-payment  WITH FRAME d-all-docs.
     7554   define variable l-query-was-opened as logical no-undo .
     7555   define variable title0 as character no-undo.
     7556   filter-point = filter-point0 + v-l-mode.
     7557   define variable sort-column-phrase as character no-undo .
     7558   case sort-column-name :
     7559     when "" then do:
     7560       assign
     7561         sort-column-phrase = ""
     7562       .
     7563     end.
     7564     otherwise do:
     7565       assign
     7566         sort-column-phrase = "by " + sort-column-name
     7567       .
     7568     end.
     7569   end case.
     7570   define variable l-open-query as logical   no-undo .
     7571   if Lookup("nob-exec",p-buttons) <> 0 then disable b-exec WITH FRAME d-all-docs. else enable b-exec  WITH FRAME d-all-docs.
     7572   if Lookup("nob-copy",p-buttons) <> 0 then disable b-copy WITH FRAME d-all-docs. else enable b-copy  WITH FRAME d-all-docs.
     7573   enable b-mark WITH FRAME d-all-docs.
     7574   if Lookup("b-sel",p-buttons) <> 0 then enable  b-sel WITH FRAME d-all-docs.  else disable b-sel   WITH FRAME d-all-docs.
     7575   if Lookup("b-del",p-buttons) <> 0 then
     7576      enable  b-del   WITH FRAME d-all-docs.
     7577      else disable b-del WITH FRAME d-all-docs.
     7578   if Lookup("b-lkp",p-buttons) <> 0 then
     7579      enable b-lkp  WITH FRAME d-all-docs.
     7580      else  disable b-lkp WITH FRAME d-all-docs.
     7581   if Lookup("b-chg",p-buttons) <> 0 then
     7582      enable b-chg  WITH FRAME d-all-docs.
     7583      else  disable b-chg WITH FRAME d-all-docs.
     7584   if Lookup("b-add",p-buttons) <> 0 then
     7585      enable b-add  WITH FRAME d-all-docs.
     7586      else  disable b-add WITH FRAME d-all-docs.
     7587   if Lookup("b-close",p-buttons) <> 0 then
     7588      enable b-close WITH FRAME d-all-docs.
     7589      else  disable b-close WITH FRAME d-all-docs.
     7590   if Lookup("fin-block",p-buttons) <> 0 then
     7591      disable b-close b-payment  b-copy WITH FRAME d-all-docs.
     7592   if g#type = ?  then  do:
     7593     disable b-add with frame d-all-docs .
     7594   end.
     7595   if g#type = 'ОФ':U and v-cntxt-db-num = 0  then  do:
     7596     disable  b-copy   with frame d-all-docs .
     7597   end.
     7598   CASE x-mode :
     7599     when "firm":U then do:
     7600         if p-open-query then frame d-all-docs:title = " Фирма : " + g#host-name.
     7601         Disable b-add b-chg b-del b-close   b-close b-copy b-sost  WITH FRAME d-all-docs.
     7602         Enable b-lkp
     7603         WITH FRAME d-all-docs.
     7604         if v-cntxt-level <>  'object':U then do:
     7605           Disable b-payment   WITH FRAME d-all-docs.
     7606         end.
