     4038   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4039   FUNCTION RedLine RETURNS CHARACTER ( INPUT i-str AS CHARACTER ) :
     4040     DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
     4041     RUN get-red-line IN THIS-PROCEDURE ( INPUT i-str, OUTPUT v-str ) NO-ERROR.
     4042     RETURN ( IF ERROR-STATUS :ERROR THEN i-str ELSE v-str ).
     4043   END FUNCTION.
     4044   PROCEDURE get-red-line :
     4045     DEFINE  INPUT PARAMETER p-str AS CHARACTER NO-UNDO.
     4046     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
     4047     DO ON ERROR UNDO, RETURN ERROR :
     4048       ASSIGN p-res = CAPS( SUBSTRING( p-str, 1, 1 ) ) + LC( SUBSTRING( p-str, 2 ) ).
     4049     END.
     4050   END PROCEDURE.
     4051   FUNCTION get-decade-word RETURNS CHARACTER ( INPUT i-dec AS INTEGER, INPUT i-num AS INTEGER ) :
     4052     DEFINE VARIABLE v-grade AS CHARACTER NO-UNDO.
     4053     RUN get-number-grade IN THIS-PROCEDURE ( INPUT i-dec, INPUT i-num, OUTPUT v-grade ) NO-ERROR.
     4054     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-grade ).
     4055   END FUNCTION.
     4056   FUNCTION Word-Sum RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
     4057     DEFINE VARIABLE OutSum AS CHARACTER NO-UNDO.
     4058     RUN conv-sum-to-word IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT OutSum ) NO-ERROR.
     4059     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE OutSum ).
     4060   END FUNCTION.
     4061   PROCEDURE get-number-grade :
     4062     DEFINE  INPUT PARAMETER p-dec AS INTEGER   NO-UNDO.
     4063     DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.
     4064     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
     4065     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO.
     4066     DO ON ERROR UNDO, RETURN ERROR :
     4067       IF      p-dec = 1 THEN DO: ASSIGN v-list = ",один,два,три,четыре,пять,шесть,семь,восемь,девять".    END.
     4068       ELSE IF p-dec = 2 THEN DO: ASSIGN v-list = "десять,одиннадцать,двенадцать,тринадцать,четырнадцать,пятнадцать,шестнадцать,семнадцать,восемнадцать,девятнадцать".    END.
     4069       ELSE IF p-dec = 3 THEN DO: ASSIGN v-list = ",,двадцать,тридцать,сорок,пятьдесят,шестьдесят,семьдесят,восемьдесят,девяносто".   END.
     4070       ELSE IF p-dec = 4 THEN DO: ASSIGN v-list = ",сто,двести,триста,четыреста,пятьсот,шестьсот,семьсот,восемьсот,девятьсот".  END.
     4071                         ELSE DO: ASSIGN v-list = ",,,,,,,,,". END.
     4072       ASSIGN p-res = ENTRY( p-num + 1, v-list ).
     4073     END.
     4074   END PROCEDURE.
     4075   PROCEDURE conv-sum-to-word :
     4076     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
     4077     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
     4078     DEFINE VARIABLE Formatted  AS CHARACTER NO-UNDO.
     4079     DEFINE VARIABLE Word       AS CHARACTER NO-UNDO.
     4080     DEFINE VARIABLE OutSum     AS CHARACTER NO-UNDO.
     4081     DEFINE VARIABLE jj         AS INTEGER   NO-UNDO.
     4082     DO ON ERROR UNDO, RETURN ERROR :
     4083       ASSIGN Formatted = STRING( ABS( p-sum ), "999999999999999.99":U ) NO-ERROR.
     4084       IF ERROR-STATUS :ERROR THEN DO:
     4085         ASSIGN p-res = ?.
     4086         UNDO, RETURN ERROR.
     4087       END.
     4088       DO jj = ( LENGTH( Formatted ) - 3 ) TO 3 BY -3 :
     4089         IF SUBSTRING( Formatted, jj - 2, 3 ) = "000" THEN DO: NEXT. END.
     4090         IF jj < 15 THEN DO:
     4091           ASSIGN Word = ENTRY( jj, ",,триллион,,,миллиард,,,миллион,,,тысяч" ).
     4092           IF SUBSTRING( Formatted, jj,     1 )  = "1" AND
     4093              SUBSTRING( Formatted, jj - 1, 1 ) <> "1" AND jj = 12 THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
     4094           IF SUBSTRING( Formatted, jj, 1 ) = "2" OR
     4095              SUBSTRING( Formatted, jj, 1 ) = "3" OR
     4096              SUBSTRING( Formatted, jj, 1 ) = "4" THEN DO:
     4097             IF jj = 12 THEN DO:
     4098               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "и". END.
     4099             END.       ELSE DO:
     4100               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
     4101             END.
     4102           END.
     4103           IF ( SUBSTRING( Formatted, jj,     1 ) <> "1" AND
     4104                SUBSTRING( Formatted, jj,     1 ) <> "2" AND
     4105                SUBSTRING( Formatted, jj,     1 ) <> "3" AND
     4106                SUBSTRING( Formatted, jj,     1 ) <> "4" AND jj <> 12 ) OR
     4107              ( SUBSTRING( Formatted, jj - 1, 1 )  = "1" AND jj <  12 ) THEN DO: ASSIGN Word = TRIM( Word ) + "ов". END.
     4108           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
     4109         END.
     4110         IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO:
     4111           IF      jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "1" THEN DO: ASSIGN Word = "одна". END.
     4112           ELSE IF jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "2" THEN DO: ASSIGN Word = "две".  END.
     4113           ELSE DO: ASSIGN Word = get-decade-word( 1, INTEGER( SUBSTRING( Formatted, jj, 1 ) ) ). END.
     4114           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
     4115           ASSIGN Word = get-decade-word( 3, INTEGER( SUBSTRING( Formatted, jj - 1, 1 ) ) ).
     4116         END.                                        ELSE DO:
     4117           ASSIGN Word = get-decade-word( 2, INTEGER( SUBSTRING( Formatted, jj,     1 ) ) ).
     4118         END.
     4119         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
     4120         ASSIGN Word = get-decade-word( 4, INTEGER( SUBSTRING( Formatted, jj - 2, 1 ) ) ).
     4121         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
     4122       END.
     4123       ASSIGN OutSum = CAPS( SUBSTRING( OutSum, 1, 1 ) ) + SUBSTRING( OutSum, 2 ).
     4124       IF OutSum = "":U AND TRUNCATE( p-sum, 0 ) = 0 THEN DO: ASSIGN OutSum = "Ноль". END.
     4125       ASSIGN p-res = TRIM( OutSum ).
     4126     END.
     4127   END PROCEDURE.
     4128   FUNCTION Total-Word RETURNS CHARACTER ( INPUT i-sum AS DECIMAL, INPUT i-curr AS CHARACTER, INPUT i-part AS CHARACTER ) :
     4129     DEFINE VARIABLE word_sum AS CHARACTER NO-UNDO.
     4130     RUN get-total-word IN THIS-PROCEDURE ( INPUT i-sum, INPUT i-curr, INPUT i-part, OUTPUT word_sum ) NO-ERROR.
     4131     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE word_sum ).
     4132   END FUNCTION.
     4133   PROCEDURE get-total-word :
     4134     DEFINE  INPUT PARAMETER p-sum  AS DECIMAL   NO-UNDO.
     4135     DEFINE  INPUT PARAMETER p-curr AS CHARACTER NO-UNDO.
     4136     DEFINE  INPUT PARAMETER p-part AS CHARACTER NO-UNDO.
     4137     DEFINE OUTPUT PARAMETER p-word AS CHARACTER NO-UNDO.
     4138     DO ON ERROR UNDO, RETURN ERROR :
     4139       ASSIGN p-word = Word-Sum( p-sum ).
     4140                  ASSIGN p-word = ( IF p-sum < 0 THEN "- " ELSE "":U ) + TRIM(
     4141                         RedLine( p-word )
     4142                  ) +
     4143                         " ":U + p-curr + " ":U +
     4144                         SUBSTRING( STRING( ABS( p-sum ), "999999999999999999999999999999.99" ), 32, 2 ) +
     4145                         " ":U + p-part + ".".
     4146                           END.
     4147   END PROCEDURE.
     4148   ON CHOOSE OF MENU-ITEM m_PRINT1
