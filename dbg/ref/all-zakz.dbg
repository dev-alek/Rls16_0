    11319         .
    11320     run orddocattr-write (
    11321          input v-new-code
    11322         ,input 'cycle-date2':U
    11323         ,input string(buf_ord-doc.date-sale-2, "99/99/9999")) no-error .
    11324         if error-status :error then
    11325         message
    11326           vss-workfile vss-revision vss-description skip
    11327           error-status :get-message(1) skip
    11328           return-value skip
