     9989             (" shar-buf_ord-doc.contract-code = sch-contract.contract-code and shar-buf_ord-doc.host-code = g#host-code " + " " + where-phrase-97 = "")
     9990         .
     9991         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     9992                             ,input query br-docs:handle
     9993                             ,input parameter-3-97
     9994                             ,input parameter-4-97
     9995                             ,input parameter-5-97
     9996                             ,input parameter-6-97
     9997                             ,input parameter-7-97
     9998                             )
     9999         .
    10000         assign
    10001           l-filter-open-97 = true
    10002         .
    10003       end.
    10004       if l-filter-open-97 = false then do:
    10005         message
    10006           "Ошибка при фильтрации / сортировке" skip
    10007           "Будут показаны записи без учета фильтра" skip
    10008           view-as alert-box .
    10009       end.
    10010       else do:
    10011           assign
    10012             l-query-was-opened = true
    10013           .
    10014       end.
    10015     end.
    10016     if l-filter-open-97 = false then do:
    10017       OPEN QUERY br-docs FOR EACH shar-buf_ord-doc no-lock
    10018         where  shar-buf_ord-doc.contract-code = sch-contract.contract-code and shar-buf_ord-doc.host-code = g#host-code
    10019         use-index by_contract
    10020         indexed-reposition
    10021     .
    10022         assign
    10023           l-query-was-opened = true
    10024         .
    10025     end.
    10026   end.
    10027   else do:
    10028     assign
    10029       doc-rec = recid( shar-buf_ord-doc )
    10030     .
    10031     do
    10032     on stop undo, leave
    10033     on error undo, leave
    10034     :
    10035       if query br-docs:handle:get-buffer-handle(1) = (buffer shar-buf_ord-doc:handle) then do:
    10036         assign
    10037         parameter-2-97 = (if p-find-next then "true":u else "false":u )
    10038         parameter-4-97 =
    10039           "where ":u +  substitute('                             shar-buf_ord-doc.host-code =  &2 and                             shar-buf_ord-doc.contract-code = &3                             ' , chr(34) , g#host-code , sch-contract.contract-code )  + " ":u + where-phrase-97 + " ":u + p-find-condition + " " + ""
    10040         parameter-5-97 = "use-index by_contract "
    10041       .
    10042         run fltopend_fltfindd in this-procedure  (
    10043                             input this-procedure:handle
    10044                             ,input query br-docs:handle
    10045                             ,input rowid(shar-buf_ord-doc)
    10046                             ,input logical(parameter-2-97)
    10047                             ,input no-lock
    10048                             ,input (buffer shar-buf_ord-doc:handle)
    10049                             ,input parameter-4-97
    10050                             ,input parameter-5-97
    10051                             ) no-error.
    10052         .
    10053         assign
    10054           doc-rec = integer(return-value)
    10055           v-fltopend-rowid[1] = ?
    10056         .
    10057       end.
    10058       else do:
    10059         assign
    10060         parameter-2-97 = (if p-find-next then "true":u else "false":u )
    10061         parameter-3-97 =  "FOR EACH shar-buf_ord-doc"
    10062         parameter-4-97 =
    10063           (
    10064             if (" shar-buf_ord-doc.contract-code = sch-contract.contract-code and shar-buf_ord-doc.host-code = g#host-code " + " " + where-phrase-97) <> ""
    10065             then  substitute('                             shar-buf_ord-doc.host-code =  &2 and                             shar-buf_ord-doc.contract-code = &3                             ' , chr(34) , g#host-code , sch-contract.contract-code )  + " " + where-phrase-97
    10066             else "true"
    10067           )
    10068         parameter-5-97 = (" " + "" + " " + "" + " " + p-find-condition)
    10069         parameter-6-97 = if sort-phrase-97 = ''
    10070                              then
    10071           (
    10072           " " + "use-index by_contract " +
    10073             " " + sort-column-phrase +
    10074           " " + " "
    10075           )
    10076                              else
    10077           (
    10078           " " + "use-index by_contract " +
    10079             " " + sort-column-phrase +
    10080           " " + sort-phrase-97
    10081           )
    10082         parameter-7-97 =
    10083           " indexed-reposition  "
    10084       .
    10085         run fltopend_fltfindq in this-procedure  (
    10086                             input this-procedure:handle
    10087                             ,input query br-docs:handle
    10088                             ,input logical(parameter-2-97)
    10089                             ,input no-lock
    10090                             ,input parameter-3-97
    10091                             ,input parameter-4-97
    10092                             ,input parameter-5-97
    10093                             ,input parameter-6-97
    10094                             ,input parameter-7-97
    10095                             ,output v-fltopend-rowid
    10096                             ) no-error.
    10097         .
    10098         doc-rec = ?.
    10099       end.
    10100       assign
    10101         l-query-was-opened = true
    10102       .
    10103     end.
    10104   end.
    10105     run waitfram-hide in this-procedure .
    10106     end.
    10107   end case.
    10108   if not p-open-query then do:
    10109      reposition br-docs to recid doc-rec no-error.
    10110      if error-status :error then message "Документ не найден." view-as alert-box information .
    10111      apply "value-changed" to br-docs in frame d-all-docs .
    10112   end.
    10113   apply "entry" to br-docs in frame d-all-docs.
    10114   END PROCEDURE.
    10115   PROCEDURE local-mark:
    10116     if not available shar-buf_ord-doc then do:
    10117       message "Неправильный выбор строки.".
    10118       return error.
    10119     end.
    10120   define variable vss-include-info98 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10121   define variable v-str-recid99 as character no-undo .
    10122   define variable v-num-entry99 as integer   no-undo .
    10123   assign
    10124     v-str-recid99 = trim( string( recid( shar-buf_ord-doc ) , "->>>>>>>>>>>9":U ) )
    10125     v-num-entry99 = lookup( v-str-recid99 , del-list )
    10126   .
    10127   if v-num-entry99 > 0 then do:
    10128     assign
    10129       entry( v-num-entry99, del-list ) = "":U
    10130       del-list = trim( replace( del-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
    10131     .
    10132   end.
    10133   else do:
    10134     assign
    10135       del-list = del-list + ( if del-list = "":U then "":U else chr(44) ) + v-str-recid99
    10136     .
    10137   end.
    10138     if lookup(string( recid(shar-buf_ord-doc) ), del-list ) > 0
    10139         then disp "*"  @ mark with browse  br-docs.
    10140         else disp "" @ mark with browse  br-docs.
    10141   END PROCEDURE.
    10142   procedure set-reject :
    10143   define buffer t-ord-line for ub.ord-line.
    10144   if not available shar-buf_ord-doc then do:   message "Неправильно выбран документ.".   return no-apply. end. doc-rec = recid (shar-buf_ord-doc). do on stop undo, return no-apply :   find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec exclusive-lock .   end. if shar-buf_ord-doc.status_     = 'факт':U and shar-buf_ord-doc.flag_= true  then do:    find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec no-lock.    message "Данный документ закрыт по факту .".    return no-apply. end.
    10145    find current shar-buf_ord-doc no-lock  no-error.
    10146     if avail shar-buf_ord-doc and shar-buf_ord-doc.status_ = 'отказ':U then do:
    10147         Message "Документ уже находится в статусе " shar-buf_ord-doc.status_ view-as alert-box.
    10148         return.
    10149     end.
    10150     if not( shar-buf_ord-doc.status_ = 'новый':U OR
    10151             shar-buf_ord-doc.status_ = 'согласование':U or
    10152             shar-buf_ord-doc.status_ = 'поставка':U
    10153             ) then do:
    10154         Message "Документ  находится в статусе " CAPS(shar-buf_ord-doc.status_) " Отказать нельзя !" view-as alert-box.
    10155         return.
    10156     end.
    10157     if shar-buf_ord-doc.status_ = 'поставка':U then do:
    10158     g#log = false .
    10159     Message "Вы собираетесь проставить статус ОТКАЗАТЬ заказу в статусе ПОСТАВКА !" skip (2)
    10160             "Это означает, что ВЫ не сможете по нему сформировать или получить ПН !" skip(2)
    10161              " Если поставки и накладные уже созданы, то они будут существовать самостоятельно !" skip(2)
    10162             "Отказать заказу № " shar-buf_ord-doc.doc-code  " ?"
    10163              view-as alert-box question
    10164              buttons YES-NO
    10165              title "В Н И М А Н И Е !!! "
    10166              update g#log
    10167              .
    10168              if NOT g#log then return .
    10169     end.
    10170     Message "Отказать заказу № " shar-buf_ord-doc.doc-code  " ?" view-as alert-box
    10171              QUESTION buttons YES-NO update g#log.
    10172              if NOT g#log then return .
    10173    if shar-buf_ord-doc.cons-code <> "" and shar-buf_ord-doc.cons-code <> ? then do:
    10174    define buffer b_ord-cons for ub.ord-cons.
    10175       find first b_ord-cons where b_ord-cons.cons-code = shar-buf_ord-doc.cons-code no-lock no-error .
    10176       if avail b_ord-cons and b_ord-cons.status_ <> 'новый':U then do:
    10177           Message "Нельзя отказать заказу № " shar-buf_ord-doc.doc-code  " , так как СЗФП уже находится в статусе " b_ord-cons.status_ view-as alert-box.
    10178           return.
    10179       end.
    10180    end.
    10181    define variable tt as character no-undo .
    10182    define variable tt2 as character no-undo .
    10183    find current shar-buf_ord-doc EXCLUSIVE-LOCK no-error.
    10184       if available shar-buf_ord-doc then do:
    10185         if shar-buf_ord-doc.status_ = 'поставка':U then do:
    10186            shar-buf_ord-doc.PS =  substitute("ОТКАЗ со статуса ПОСТАВКА !!! &1" ,shar-buf_ord-doc.PS ) .
    10187         end.
    10188         assign
    10189           tt = shar-buf_ord-doc.cons-code
    10190           shar-buf_ord-doc.status_ = 'отказ':U
    10191           shar-buf_ord-doc.fact-date = to-day
    10192           shar-buf_ord-doc.cons-code  = shar-buf_ord-doc.cons-code + 'отказ':U .
    10193           .
    10194          if tt <> "" and tt <> ? then do:
    10195             for each t-ord-line where t-ord-line.doc-code = shar-buf_ord-doc.doc-code :
    10196                   find first  ub.ord-gds-cons where
    10197                     ub.ord-gds-cons.cons-code = tt                    and
    10198                     ub.ord-gds-cons.artic =     t-ord-line.artic       and
    10199                     ub.ord-gds-cons.prod-code = t-ord-line.prod-code   and
    10200                     ub.ord-gds-cons.prod-type = t-ord-line.prod-type   exclusive-lock use-index pi no-error .
    10201                     if available ub.ord-gds-cons then do:
    10202                         ub.ord-gds-cons.sum-qnty = ub.ord-gds-cons.sum-qnty - t-ord-line.qnty.
    10203                         if ub.ord-gds-cons.sum-qnty  = 0 then do:
    10204                           delete ub.ord-gds-cons.
    10205                         end.
    10206                     end.
    10207             end.
    10208           end.
    10209          find current shar-buf_ord-doc  no-lock  no-error .
    10210          define variable v-recid as recid no-undo .
    10211          if error-status :error then
    10212             message 'ошибка поиска shar-buf_ord-doc'skip
    10213             vss-workfile vss-revision vss-description skip
    10214             error-status :get-message(1) .
    10215           v-recid = recid (shar-buf_ord-doc) .
    10216          run str/callnews.p     (input "ord-doc"      ,input (buffer shar-buf_ord-doc:handle)    ) no-error .        if error-status:error then do:     Assign shar-buf_ord-doc.flag_ = True  shar-buf_ord-doc.status_ = 'новый':U.     Message                                                      vss-workfile vss-revision vss-description skip             "Ошибка при передаче заказа в новости" skip                "Документ" shar-buf_ord-doc.doc-code skip                             view-as alert-box .                                        return no-apply.                                       end.
    10217           run UI-on in this-procedure (yes, no, '':U) no-error .
    10218           if error-status :error then
    10219               message 'ошибка процедуры UI-on' skip
    10220               vss-workfile vss-revision vss-description skip
    10221               error-status :get-message(1) .
    10222            reposition br-docs to recid v-recid no-error .
    10223            apply "value-changed" to br-docs in frame d-all-docs .
    10224       end.
    10225   END PROCEDURE.
    10226   PROCEDURE mode-g#type :
    10227   define variable  m-i-of  as widget-handle.
    10228   define variable  m-i-op  as widget-handle.
    10229   define variable  m-i-fp  as widget-handle.
    10230   CREATE WIDGET-POOL "My-pool" PERSISTENT no-error .
    10231   if  g#type <> 'ОФ':U
    10232   and g#type <> 'ОП':U
    10233   and g#type <> 'ФП':U
    10234   then do:
    10235     disable b-rep with frame d-all-docs .
    10236   end.
    10237   if g#type = 'ОФ':U then  do:
    10238   frame d-all-docs:title = "ЗАЯВКИ   " + frame d-all-docs:title .
    10239       create menu-item m-i-of IN WIDGET-POOL "My-pool"
    10240         assign parent = menu m-rep:handle
    10241         label = 'Отчет об исполнении заявок'
    10242         .
    10243         ON CHOOSE OF m-i-of PERSISTENT
    10244          run run-rep (1) .
    10245   end.
    10246   if g#type = 'ОП':U then  do:
    10247   frame d-all-docs:title = "ЗАКАЗЫ   " + frame d-all-docs:title .
    10248       create menu-item m-i-op IN WIDGET-POOL "My-pool"
    10249         assign parent = menu m-rep:handle
    10250               label = 'Отчет об исполнении заказов ОП'
    10251         .
    10252         ON CHOOSE OF m-i-op PERSISTENT run run-rep (2) .
    10253         g#log =  br-docs:MOVE-COLUMN(10, 14) IN FRAME d-all-docs  no-error .
    10254         shar-buf_ord-doc.cons-code:label in browse  br-docs = "Ссылка".
    10255   end.
    10256   if g#type = 'ФП':U then  do:
    10257   frame d-all-docs:title = "ЗАКАЗЫ   " + frame d-all-docs:title .
    10258       create menu-item m-i-fp IN WIDGET-POOL "My-pool"
    10259         assign parent = menu m-rep:handle
    10260               label = 'Отчет об исполнении заказов ФП'
    10261         .
    10262         ON CHOOSE OF m-i-fp PERSISTENT run run-rep (3) .
    10263   end.
    10264   end procedure.
    10265   procedure run-rep :
    10266   define input parameter j as integer no-undo .
    10267   if j = 1 then do:
    10268      run cus/g-isp-zy.p
    10269        (input parparentproc
    10270        ) .
    10271   end.
    10272   if j = 2 then do:
    10273      run cus/g-isp-zk.p
    10274        (input parparentproc
    10275        ) .
    10276   end.
    10277   if j = 3 then do:
    10278      run cus/g-isp-zf.p
    10279        (input parparentproc
    10280        ) .
    10281   end.
    10282   end procedure.
    10283   procedure proc-b-chg:
    10284    if not available shar-buf_ord-doc then do:   message "Неправильно выбран документ.".   return no-apply. end. doc-rec = recid (shar-buf_ord-doc). do on stop undo, return no-apply :   find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec exclusive-lock .   end. if shar-buf_ord-doc.status_     = 'факт':U and shar-buf_ord-doc.flag_= true  then do:    find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec no-lock.    message "Данный документ закрыт по факту .".    return no-apply. end.
    10285     if (( shar-buf_ord-doc.ord-int1 = int('1':U)
    10286        or shar-buf_ord-doc.ord-int1 = int('2':U) )
    10287       and shar-buf_ord-doc.whole-send-news = integer('1':U))
    10288     or (( shar-buf_ord-doc.ord-int1 = int('1':U)
    10289        or shar-buf_ord-doc.ord-int1 = int('2':U) )
    10290       and shar-buf_ord-doc.whole-send-news = integer('2':U))
    10291     then do:
    10292       message
    10293       "Документ "  shar-buf_ord-doc.doc-code  " нельзя корректировать, по системе EDOC\EDI заказ направлен поставщику"  view-as  alert-box .
    10294           return .
    10295     end.
    10296     if v-cntxt-db-num = 0 then do:
    10297       if not (shar-buf_ord-doc.status_  = 'новый':U or
    10298               shar-buf_ord-doc.status_  = 'согласование':U)
    10299           or (shar-buf_ord-doc.status_  = 'новый':U and not v-obj-active = "yes")
    10300       then do:
    10301           message "Документ "  shar-buf_ord-doc.doc-code  " нельзя корректировать ,  статус " caps(shar-buf_ord-doc.status_) if v-not-activ then "на неактивном складе" else ""  view-as  alert-box .
    10302           return .
    10303       end.
    10304     end.
    10305     else do:
    10306       if shar-buf_ord-doc.status_  <> 'новый':U then do:
    10307           message "Документ "  shar-buf_ord-doc.doc-code  " нельзя корректировать ,  статус " caps(shar-buf_ord-doc.status_) view-as  alert-box .
    10308           return .
    10309       end.
    10310     end.
    10311    if shar-buf_ord-doc.doc-type  =  'ФП':U and v-not-activ then do :
    10312       message "Заказ "  shar-buf_ord-doc.doc-code  " нельзя корректировать ,  статус " shar-buf_ord-doc.status_ " на неактивном складе "
    10313       view-as alert-box information.
    10314       return .
    10315     end.
    10316   define variable v-ri as recid no-undo .
    10317   v-ri = recid (shar-buf_ord-doc) .
    10318   run cus/ord-zakz.p
    10319     (  input parParentProc ,
    10320        input 'ИЗМЕНЕНИЕ':U ,
    10321        input shar-buf_ord-doc.doc-type ,
    10322        output doc-rec ,
    10323        input-output  br-handle ,
    10324        input-output  bf-handle ,
    10325        input-output  next-prev
    10326       ) .
    10327   run UI-on in this-procedure (yes, no, '':U).
    10328   reposition br-docs to recid v-ri no-error.
    10329   apply "value-changed" to br-docs in frame d-all-docs .
    10330   end procedure.
    10331   PROCEDURE proc-b-add :
    10332    define variable v-par-prt as logical no-undo .
    10333    define buffer buff_ord-doc for ub.ord-doc  .
    10334    if g#type = 'ОП':U  then do:
    10335       if v-cntxt-db-num <> v-cntxt-db-num-obj then do:
    10336          message  substitute("Заказ &1 можно создать только в  БД №  &2" ,  g#type,v-cntxt-db-num-obj )
    10337                   view-as alert-box information .
    10338          return .
    10339       end.
    10340    end.
    10341     run cus/ord-zakz.p
    10342       (input  parParentProc,
    10343        input  'ДОБАВЛЕНИЕ':U ,
    10344        input  g#type,
    10345        output doc-rec ,
    10346        input-output  br-handle ,
    10347        input-output  bf-handle ,
    10348        input-output  next-prev
    10349         ) no-error .
    10350        if error-status :error then
    10351        message
    10352          vss-workfile vss-revision vss-description skip
    10353          error-status :get-message(1) skip
    10354          return-value skip
    10355          "Ошибка при создании заказа"
    10356          view-as alert-box error
    10357        .
    10358     find first buff_ord-doc no-lock where recid(buff_ord-doc) =  doc-rec no-error .
    10359     if  available buff_ord-doc then do:
    10360         run UI-on in this-procedure (yes, no, '':U).
    10361         reposition br-docs to recid doc-rec no-error.
    10362         apply "value-changed" to br-docs in frame d-all-docs .
    10363     end.
    10364   END PROCEDURE.
    10365   procedure pp-1 :
    10366    do
    10367    on error undo, return error return-value
    10368    :
    10369     if not available shar-buf_ord-doc then do:   message "Неправильно выбран документ.".   return no-apply. end. doc-rec = recid (shar-buf_ord-doc). do on stop undo, return no-apply :   find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec no-lock .   end.
    10370     run cus/ord-zakz.p
    10371    (input parParentProc,
    10372     input "copy":u ,
    10373     input  shar-buf_ord-doc.doc-type ,
    10374     output doc-rec ,
    10375     input-output  br-handle ,
    10376     input-output  bf-handle ,
    10377     input-output  next-prev
    10378     ) .
    10379     run UI-on in this-procedure (yes, no, '':U).
    10380     reposition br-docs to recid doc-rec no-error.
    10381     apply "value-changed" to br-docs in frame d-all-docs .
    10382    end.
    10383   end procedure.
    10384   procedure pp-2 :
    10385    do
    10386    on error undo, return error return-value
    10387    :
    10388   define variable del-rec as recid no-undo.
    10389   define variable unrv-qnty as dec no-undo.
    10390       if not available shar-buf_ord-doc then do:   message "Неправильно выбран документ.".   return no-apply. end. doc-rec = recid (shar-buf_ord-doc). do on stop undo, return no-apply :   find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec exclusive-lock .   end. if shar-buf_ord-doc.status_     = 'факт':U and shar-buf_ord-doc.flag_= true  then do:    find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec no-lock.    message "Данный документ закрыт по факту .".    return no-apply. end.
    10391       find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec no-lock.
    10392       if shar-buf_ord-doc.status_ <> 'новый':U or (shar-buf_ord-doc.status_ = 'новый':U and not v-obj-active = "yes") then do:
    10393         message "Документ в статусе" shar-buf_ord-doc.status_ "удалять нельзя! " view-as alert-box error .
    10394         return no-apply.
    10395       end.
    10396       if (( shar-buf_ord-doc.ord-int1 = int('1':U)
    10397          or shar-buf_ord-doc.ord-int1 = int('2':U) )
    10398         and is-edoc-nn
    10399         and shar-buf_ord-doc.whole-send-news = integer('1':U) )
    10400       or (( shar-buf_ord-doc.ord-int1 = int('1':U)
    10401          or shar-buf_ord-doc.ord-int1 = int('2':U) )
    10402         and is-edi
    10403         and shar-buf_ord-doc.whole-send-news = integer('2':U) )
    10404         then do:
    10405         message
    10406         "Документ "  shar-buf_ord-doc.doc-code  " нельзя удалить ,  статус EDOC\EDI " caps('отправлен':U) "(Отправлен поставщику)"  view-as  alert-box .
    10407             return .
    10408       end.
    10409       if (( shar-buf_ord-doc.ord-int1 = int('3':U)
    10410          or shar-buf_ord-doc.ord-int1 = int('4':U) )
    10411         and is-edoc-nn
    10412         and shar-buf_ord-doc.whole-send-news = integer('1':U) )
    10413       or (( shar-buf_ord-doc.ord-int1 = int('3':U)
    10414          or shar-buf_ord-doc.ord-int1 = int('5':U))
    10415         and is-edi
    10416         and shar-buf_ord-doc.whole-send-news = integer('2':U) )
    10417         then do:
    10418         message
    10419         "Документ "  shar-buf_ord-doc.doc-code  " нельзя удалить ,  статус EDOC\EDI " caps('отправлен':U) "(Ожидает решения)"  view-as  alert-box .
    10420             return .
    10421       end.
    10422       g#log = no.
    10423       message "Удалить документ №" shar-buf_ord-doc.doc-code "?   Вы уверены ?"
    10424                       view-as alert-box question buttons OK-Cancel update g#log.
    10425       if not g#log then do:   find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec no-lock.   return no-apply. end.
    10426       run waitfram-show in this-procedure ("Удаление документа № " + shar-buf_ord-doc.doc-code + ". Ждите...").
    10427       br-handle  = br-docs:handle  in frame d-all-docs .
    10428       if valid-handle (br-handle) then do:
    10429         g#log = br-handle:select-next-row().
    10430         if not g#log then g#log = br-handle:select-prev-row().
    10431         del-rec = recid (shar-buf_ord-doc).
    10432       end.
    10433       find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec.
    10434       del-doc:
    10435       do on stop undo del-doc, return no-apply on error undo del-doc, return no-apply:
    10436         delete shar-buf_ord-doc.
    10437       end.
    10438       doc-rec = del-rec.
    10439       run waitfram-hide in this-procedure .
    10440       run UI-on in this-procedure (yes, no, '':U).
    10441    end.
    10442   end procedure.
    10443   PROCEDURE set-filter-name :
    10444   define input parameter p-filter-name as character no-undo .
    10445     do with frame d-all-docs:
    10446       if p-filter-name > "" then do:
    10447         assign
    10448           frame d-all-docs:title
    10449             = frame d-all-docs:title + "   ФИЛЬТР: " + p-filter-name.
    10450         .
    10451         assign
    10452           b-sch :TOOLTIP = "Установлен фильтр " + p-filter-name
    10453         .
    10454       end.
    10455       else do:
    10456         assign
    10457           b-sch :TOOLTIP = ""
    10458         .
    10459       end.
    10460     end.
    10461   END PROCEDURE.
    10462   procedure proc-doc-code :
    10463   define input parameter par-next as logical no-undo.
    10464   define input parameter pardoc-code as char no-undo.
    10465     do
    10466     on error undo, return error return-value
    10467     :
    10468   display "" @ sch-date with frame d-all-docs.
    10469   display "" @ sch-fact with frame d-all-docs.
    10470   assign
    10471     pardoc-code = chr(34) + pardoc-code + chr(34) .
    10472        run Ui-on in this-procedure
    10473             (input false
    10474             ,input par-next
    10475             ,input substitute ( "and shar-buf_ord-doc.doc-code begins &1 "
    10476               , pardoc-code)
    10477             ) no-error .
    10478       if error-status :error then
    10479       message
    10480         vss-workfile vss-revision vss-description skip
    10481         error-status :get-message(1) skip
    10482         return-value skip
    10483         "ui-on"
    10484         view-as alert-box error
    10485       .
    10486    apply "VALUE-CHANGED" to br-docs in frame d-all-docs.
    10487    apply "entry" to sch-code in frame d-all-docs.
    10488     end.
    10489   end procedure.
    10490   procedure proc-doc-date :
    10491   define input parameter par-next as logical no-undo.
    10492   define input parameter pardoc-code as date      no-undo .
    10493     do
    10494     on error undo, return error return-value
    10495     :
    10496   define variable ppp as character no-undo .
    10497   display "" @ sch-code with frame d-all-docs.
    10498   display "" @ sch-fact with frame d-all-docs.
    10499   assign
    10500     ppp =  string( day(pardoc-code)) + "/" +  string( month(pardoc-code)) + "/" +  string( year(pardoc-code)) .
    10501        run Ui-on in this-procedure
    10502             (input false
    10503             ,input par-next
    10504             ,input substitute ( "and shar-buf_ord-doc.doc-date = &1 "
    10505               , ppp)
    10506             ) no-error .
    10507       if error-status :error then
    10508       message
    10509         vss-workfile vss-revision vss-description skip
    10510         error-status :get-message(1) skip
    10511         return-value skip
    10512         "ui-on"
    10513         view-as alert-box error
    10514       .
    10515    apply "VALUE-CHANGED" to br-docs in frame d-all-docs.
    10516    apply "entry" to sch-date in frame d-all-docs.
    10517     end.
    10518   end procedure.
    10519   procedure proc-fact-date :
    10520   define input parameter par-next as logical no-undo.
    10521   define input parameter pardoc-code as date      no-undo .
    10522     do
    10523     on error undo, return error return-value
    10524     :
    10525   define variable ppp as character no-undo .
    10526   display "" @ sch-code with frame d-all-docs.
    10527   display "" @ sch-date with frame d-all-docs.
    10528   assign
    10529     ppp =  string( day(pardoc-code)) + "/" +  string(  month(pardoc-code)) + "/" +  string( year(pardoc-code)) .
    10530        run Ui-on in this-procedure
    10531             (input false
    10532             ,input par-next
    10533             ,input substitute ( "and shar-buf_ord-doc.fact-date = &1 "
    10534               , ppp)
    10535             ) no-error .
    10536       if error-status :error then
    10537       message
    10538         vss-workfile vss-revision vss-description skip
    10539         error-status :get-message(1) skip
    10540         return-value skip
    10541         "ui-on"
    10542         view-as alert-box error
    10543       .
    10544    apply "VALUE-CHANGED" to br-docs in frame d-all-docs.
    10545    apply "entry" to sch-fact in frame d-all-docs.
    10546     end.
    10547   end procedure.
    10548   procedure  proc-m_gen-1 :
    10549     do
    10550     on error undo, return error return-value
    10551     :
    10552       if num-entries(del-list) = 0 then do:
    10553         message "Не выделено ни одного Заказа для генерации ФО !".
    10554         return error .
    10555       end.
    10556       run str/gen-fl.w
    10557       (
    10558           input parparentproc,
    10559           input g#host-code,
    10560           input del-list,
    10561           input "order"
    10562           ) .
    10563       assign del-list = "" .
    10564       run UI-on in this-procedure (yes, no, '':U) .
    10565     end.
    10566   end procedure.
    10567   procedure  proc-m_gen-1_buyer :
    10568     do
    10569     on error undo, return error return-value
    10570     :
    10571       if num-entries(del-list) = 0 then do:
    10572         message "Не выделено ни одного Заказа для генерации ФО !".
    10573         return error .
    10574       end.
    10575       run str/gen-fbuy.w
    10576       (   input parparentproc,
    10577           input g#host-code,
    10578           input del-list,
    10579           input "order"
    10580           ) .
    10581       assign del-list = "" .
    10582       run UI-on in this-procedure (yes, no, '':U) .
    10583     end.
    10584   end procedure.
    10585   PROCEDURE proc-m_gen-2 :
    10586   define buffer bf_sysconf for ub.sysconf.
    10587   define buffer bf_ord-doc for ub.ord-doc.
    10588   define variable v-i as integer no-undo.
    10589   define variable v-doc-code as integer no-undo.
    10590   do on error undo, return error return-value
    10591   :
    10592   if del-list = "" then do:
    10593     if available shar-buf_ord-doc then assign del-list = string(recid(shar-buf_ord-doc)).
    10594   end.
    10595   define variable v-nn as integer   no-undo .
    10596   v-nn = num-entries (del-list).
    10597   v-i-cycle:
    10598     do v-i = 1 to v-nn :
    10599       assign v-doc-code = integer(entry (v-i, del-list)).
    10600       find first bf_ord-doc where recid(bf_ord-doc) = v-doc-code exclusive-lock.
    10601       if bf_ord-doc.status_ <> 'факт':U then do:
    10602         message "Документ " bf_ord-doc.status_ " не в статусе " 'факт':U " . Пропускаем." view-as alert-box.
    10603         next v-i-cycle.
    10604       end.
    10605       find first bf_sysconf where bf_sysconf.host-code = bf_ord-doc.host-code no-lock.
    10606       if bf_ord-doc.doc-type <> 'ПО':U then do:
    10607           if bf_sysconf.firm-db-num <> v-cntxt-db-num then do:
    10608             message "Главная БД для фирмы по документу с кодом " bf_ord-doc.doc-code " не является текущей БД." skip
    10609                     "Текущая БД: " v-cntxt-db-num skip "Главная БД фирмы: " bf_sysconf.firm-db-num
    10610             view-as alert-box error.
    10611             next v-i-cycle.
    10612           end.
    10613       end.
    10614       if bf_ord-doc.cr-fo = yes then do:
    10615         message "По документу " bf_ord-doc.doc-code " уже создавался ФО от " bf_ord-doc.fo-date " числа." view-as alert-box.
    10616         next v-i-cycle.
    10617       end.
    10618       else do:
    10619         if bf_ord-doc.need-fo = 1 or bf_ord-doc.need-fo = 2 then assign  bf_ord-doc.need-fo = 0.
    10620         else do:
    10621           message "Данный документ не нуждался в генерации ФО." view-as alert-box.
    10622           next v-i-cycle.
    10623         end.
    10624         reposition br-docs to recid recid(bf_ord-doc) no-error.
    10625         if not error-status:error then do:
    10626            apply "value-changed" to br-docs in frame d-all-docs .
    10627            display f-fo (buffer bf_ord-doc) @ v-fo  mark  with browse br-docs.
    10628         end.
    10629       end.
    10630     end.
    10631     find first bf_ord-doc where recid(bf_ord-doc) = v-doc-code no-lock no-error .
    10632     assign del-list = "".
    10633   end.
    10634   end procedure.
    10635   PROCEDURE proc-m_gen-3 :
    10636   define buffer bf_sysconf for ub.sysconf.
    10637   define buffer bf_ord-doc for ub.ord-doc.
    10638   define variable v-i as integer no-undo.
    10639   define variable v-doc-code as integer no-undo.
    10640   define variable v-log as logical   no-undo .
    10641   do on error undo, return error return-value
    10642   :
    10643     if del-list = "" then do:
    10644       if available shar-buf_ord-doc then assign del-list = string(recid(shar-buf_ord-doc)).
    10645     end.
    10646   define variable v-nn as integer   no-undo .
    10647   v-nn = num-entries (del-list).
    10648   v-i-cycle:
    10649     do v-i = 1 to v-nn :
    10650       assign v-doc-code = integer(entry (v-i, del-list)).
    10651       find first bf_ord-doc where recid(bf_ord-doc) = v-doc-code exclusive-lock.
    10652       find first bf_sysconf where bf_sysconf.host-code = bf_ord-doc.host-code no-lock.
    10653       if lookup(bf_ord-doc.status_, 'факт':U + "," + 'поставка':U) = 0 then do:
    10654         message "Документ " bf_ord-doc.status_ " не в статусе " 'факт':U " . Пропускаем." view-as alert-box.
    10655         next v-i-cycle.
    10656       end.
    10657       if bf_ord-doc.doc-type <> 'ПО':U then do:
    10658           if bf_sysconf.firm-db-num <> v-cntxt-db-num then do:
    10659             message "Главная БД для фирмы по документу с кодом " bf_ord-doc.doc-code " не является текущей БД." skip
    10660                     "Текущая БД: " v-cntxt-db-num skip   "Главная БД фирмы: " bf_sysconf.firm-db-num
    10661             view-as alert-box error.
    10662             next v-i-cycle.
    10663           end.
    10664       end.
    10665       if bf_ord-doc.cr-fo = yes then do:
    10666         assign
    10667           v-log = no.
    10668           message "По документу " bf_ord-doc.doc-code " был создан ФО от " bf_ord-doc.fo-date " ." skip
    10669                   "Вы действительно хотите снять признак, чтобы по этому документу был ФО?"
    10670           view-as alert-box question buttons yes-no update v-log.
    10671          if v-log <> yes then  next v-i-cycle.
    10672          assign
    10673            bf_ord-doc.cr-fo   = no
    10674            bf_ord-doc.fo-date = 01/01/1990
    10675          .
    10676          reposition br-docs to recid recid(bf_ord-doc) no-error.
    10677         if not error-status:error then do:
    10678           apply "value-changed" to br-docs in frame d-all-docs .
    10679           display f-fo (buffer bf_ord-doc) @ v-fo mark with browse br-docs.
    10680         end.
    10681       end.
    10682       else do:
    10683         message "По документу " bf_ord-doc.doc-code " не было генерации."
    10684         view-as alert-box.
    10685      end.
    10686    end.
    10687    assign del-list = "".
    10688   end.
    10689   end procedure.
    10690   PROCEDURE proc-m_gen-4 :
    10691   define buffer bf_sysconf for ub.sysconf.
    10692   define buffer bf_ord-doc for ub.ord-doc.
    10693   define variable v-i as integer no-undo.
    10694   define variable v-doc-code as integer no-undo.
    10695   define variable v-need-fo as logical no-undo.
    10696   define buffer bf_contract for ub.contract.
    10697   do on error undo, return error return-value
    10698   :
    10699     if del-list = "" then do:
    10700       if available shar-buf_ord-doc then assign del-list = string(recid(shar-buf_ord-doc)).
    10701     end.
    10702   define variable v-nn as integer   no-undo .
    10703   v-nn = num-entries (del-list) .
    10704   v-i-cycle:
    10705     do v-i = 1 to v-nn:
    10706       assign v-doc-code = integer(entry (v-i, del-list)) .
    10707       find first bf_ord-doc where recid(bf_ord-doc) = v-doc-code exclusive-lock.
    10708       find first bf_sysconf where bf_sysconf.host-code = bf_ord-doc.host-code no-lock.
    10709       if bf_ord-doc.status_ <> 'факт':U then do:
    10710         message "Документ " bf_ord-doc.doc-code " не в статусе " 'факт':U " . Пропускаем."  view-as alert-box.
    10711         next.
    10712       end.
    10713       if bf_ord-doc.doc-type <> 'ПО':U then do:
    10714           if bf_sysconf.firm-db-num <> v-cntxt-db-num then do:
    10715             message "Главная БД для фирмы по документу с кодом " bf_ord-doc.doc-code " не является текущей БД." skip
    10716                     "Текущая БД: " v-cntxt-db-num skip "Главная БД фирмы: " bf_sysconf.firm-db-num
    10717             view-as alert-box error.
    10718             return error.
    10719           end.
    10720       end.
    10721       if bf_ord-doc.need-FO = 2 then do:
    10722         if bf_ord-doc.contract-code <> 0 then do:
    10723           find first bf_contract where bf_contract.host-code     = bf_ord-doc.host-code   and
    10724                                        bf_contract.contract-code = bf_ord-doc.contract-code no-lock no-error.
    10725           if available bf_contract then do:
    10726             if  true  then do:
    10727               assign bf_ord-doc.need-FO = 1  .
    10728               reposition br-docs to recid recid(bf_ord-doc) no-error.
    10729               if not error-status:error then do:
    10730                 apply "value-changed" to br-docs in frame d-all-docs .
    10731                 display f-FO (buffer bf_ord-doc) @ v-FO  mark with browse br-docs.
    10732               end.
    10733             end.
    10734             else message "По документу " bf_ord-doc.doc-code " нет договоров для генерации ФО."  view-as alert-box.
    10735           end.
    10736         end.
    10737       end.
    10738       else do:
    10739         message "Документ " bf_ord-doc.doc-code "не имеет признака 'не опред' генерация ФО."
    10740         view-as alert-box.
    10741         next v-i-cycle.
    10742       end.
    10743     end.
    10744     assign del-list = "" .
    10745   find first bf_ord-doc where recid(bf_ord-doc) = v-doc-code no-lock no-error .
    10746   end.
    10747   end procedure.
    10748   procedure proc-m_lkp-fo :
    10749     do
    10750     on error undo, return error return-value
    10751     :
    10752     if available shar-buf_ord-doc then do:
    10753       run str/fi-trns.w
    10754       (   input parparentproc,
    10755           input shar-buf_ord-doc.host-code,
    10756           input ?              ,
    10757           input shar-buf_ord-doc.doc-code ,
    10758           input "order":U
    10759           ) .
    10760       end.
    10761     end.
    10762   end procedure.
    10763   PROCEDURE proc-m_gen-3-2 :
