     3389         (input  p-code
     3390         ,output v-type
     3391         ,output v-format
     3392         ,output v-fillin_width
     3393         ,output v-fillin_height
     3394         ,output v-label
     3395         ,output v-user-can-edit
     3396         ,output v-output-display
     3397         ,output v-proc
     3398         ,output v-func
     3399         ,output v-sort
     3400         ,output v-other
     3401         ) no-error .
     3402       if error-status :error then do:
     3403         message
     3404           vss-workfile vss-revision vss-description skip
     3405           error-status :get-message(1) skip
     3406           return-value skip
     3407           ""
     3408           view-as alert-box error
     3409         .
     3410         undo, return error return-value .
     3411       end.
     3412       find first buf_ord-line-attr exclusive-lock
     3413         where buf_ord-line-attr.doc-code  = p-doc-code
     3414           and buf_ord-line-attr.gds-code  = p-gds-code
     3415           and buf_ord-line-attr.attr-code = p-code
     3416         no-error .
     3417       if not available buf_ord-line-attr then do:
     3418         create buf_ord-line-attr .
     3419         assign
     3420           buf_ord-line-attr.doc-code   = p-doc-code
     3421           buf_ord-line-attr.gds-code   = p-gds-code
     3422           buf_ord-line-attr.attr-code  = p-code
     3423         .
     3424       end.
     3425       assign
     3426         buf_ord-line-attr.attr-value = p-value
     3427       .
     3428   end.
     3429   end procedure.
