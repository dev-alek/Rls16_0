     3562   procedure ver-qnty-rcv-from-ord :
     3563   define input  parameter p-ord-doc as character no-undo .
     3564   define output parameter p-is-lim as logical    no-undo .
     3565   define buffer buf_ord-doc     for ub.ord-doc      .
     3566   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv  .
     3567   define variable v-kol as integer   no-undo .
     3568   define variable v-ver as logical   no-undo .
     3569     do
     3570     on error undo, return error return-value
     3571     :
     3572      p-is-lim = false .
     3573     find first buf_ord-doc no-lock where buf_ord-doc.doc-code = p-ord-doc no-error .
     3574     if buf_ord-doc.doc-type <> 'ОП':U then return .
     3575   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3576   empty temp-table thbjattr_thbj-attr.
     3577   run adm/shattri.p (
     3578      input "get":U
     3579     ,input buf_ord-doc.obj-type
     3580     ,input buf_ord-doc.obj-code
     3581     ,input 'ord-obj':U
     3582     ,input  ""
     3583     ,output v-value-character
     3584     ,output v-value-date
     3585     ,output v-value-decimal
     3586     ,output v-value-integer
     3587     ,output v-value-logical
     3588     ,output par-type
     3589     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3590     ) no-error .
     3591     for each thbjattr_thbj-attr :
     3592         if thbjattr_thbj-attr.prop-code = 'ord-11':U then v-ver = thbjattr_thbj-attr.property-value-logical .
     3593     end.
     3594   v-kol = 0.
     3595     if v-ver then do:
     3596        for each buf_ord-doc-rcv no-lock where
     3597                 buf_ord-doc-rcv.doc-code = p-ord-doc :
     3598          v-kol = v-kol + 1.
     3599          leave.
     3600        end.
     3601      if v-kol > 0 then p-is-lim = true .
     3602     end.
     3603   end.
     3604   end procedure.
     3605   procedure ver-qnty-trn-from-rcv :
     3606   define input  parameter p-rcv-code as character no-undo .
     3607   define output parameter p-is-lim as logical   no-undo .
     3608   define buffer buf_ord-doc for ub.ord-doc  .
     3609   define buffer buf_ord-doc-rcv for ub.ord-doc-rcv  .
     3610   define buffer buf_ord-chain for ub.ord-chain .
     3611   define buffer buf_trn-doc for ub.trn-doc  .
     3612   define variable v-kol as integer   no-undo .
     3613   define variable v-ver as logical   no-undo .
     3614     do
     3615     on error undo, return error return-value
     3616     :
     3617      p-is-lim = false .
     3618     find first buf_ord-doc-rcv no-lock where buf_ord-doc-rcv.rcv-code = p-rcv-code no-error .
     3619     find first buf_ord-doc no-lock where buf_ord-doc.doc-code = buf_ord-doc-rcv.doc-code no-error .
     3620     if buf_ord-doc.doc-type <> 'ОП':U then return .
     3621   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3622   empty temp-table thbjattr_thbj-attr.
     3623   run adm/shattri.p (
     3624      input "get":U
     3625     ,input buf_ord-doc.obj-type
     3626     ,input buf_ord-doc.obj-code
     3627     ,input 'ord-obj':U
     3628     ,input  ""
     3629     ,output v-value-character
     3630     ,output v-value-date
     3631     ,output v-value-decimal
     3632     ,output v-value-integer
     3633     ,output v-value-logical
     3634     ,output par-type
     3635     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     3636     ) no-error .
     3637     for each thbjattr_thbj-attr :
     3638         if thbjattr_thbj-attr.prop-code = 'ord-11':U then v-ver = thbjattr_thbj-attr.property-value-logical .
     3639     end.
     3640       if v-ver then do:
     3641       v-kol = 0.
     3642           for each buf_ord-chain no-lock where
     3643                   buf_ord-chain.doc-code = p-rcv-code and
     3644                   buf_ord-chain.doc-type = 'rcv' and
     3645                   buf_ord-chain.rel-doc-type = 'trn' ,
     3646               first buf_trn-doc NO-LOCK where
     3647                     buf_trn-doc.doc-code = buf_ord-chain.rel-doc-code
     3648                     :
     3649               v-kol = v-kol + 1.
     3650               leave.
     3651           end.
     3652           if v-kol > 0 then p-is-lim = true .
     3653       end.
     3654     end.
     3655   end procedure.
     3656   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3657   FUNCTION isoraret_on returns logical :
     3658   define buffer buf_ext-system for ub.ext-system.
     3659   define buffer buf_db for ub.db  .
     3660   find first buf_db no-lock where buf_db.db-num > 0 no-error .
     3661   if available buf_db then  do:
     3662      return no.
     3663   end.
     3664   find first buf_ext-system no-lock no-error .
     3665   if available buf_ext-system
     3666   and buf_ext-system.esys-type = integer('3':U)
     3667   and buf_ext-system.delivery-method = integer('3':U) then return yes.
     3668   return no.
     3669   end function.
     3670   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3671   procedure ver-clients-calc :
     3672   define input  parameter p-cli-type as character no-undo .
     3673   define input  parameter p-cli-code as integer   no-undo .
     3674   define input  parameter p-obj-type as character no-undo .
     3675   define input  parameter p-obj-code as integer   no-undo .
     3676   define input  parameter p-method   as character no-undo .
     3677   define output parameter p-error    as logical   no-undo .
     3678   define variable v-not-corr-op as character no-undo .
     3679   define variable v-type as character no-undo .
     3680     do
     3681     on error undo, return error return-value
     3682     :
     3683    p-error = false .
     3684    v-not-corr-op  = 'no' .
     3685    run clntattr-value (
     3686       input   p-obj-type
     3687     , input   p-obj-code
     3688     , input   'not-corr-op':U
     3689     , output  v-not-corr-op
     3690     , output  v-type
     3691     ) no-error .
     3692     if error-status :error then v-not-corr-op  = 'no' .
     3693     if v-not-corr-op = 'yes' and  p-method = ""  then do:
     3694       assign v-not-corr-op = 'no' .
     3695       run clntattr-value (
     3696       input   p-cli-type
     3697     , input   p-cli-code
     3698     , input   'not-corr-op':U
     3699     , output  v-not-corr-op
     3700     , output  v-type
     3701     ) no-error .
     3702     if error-status :error then v-not-corr-op  = 'no' .
     3703     if v-not-corr-op = 'yes'  and  p-method = ""  then p-error = true .
     3704     end.
     3705     end.
     3706   end procedure.
