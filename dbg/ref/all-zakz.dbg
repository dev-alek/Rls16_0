      790       ) .
      791   end.
      792   define variable v-inform-launched as logical no-undo initial false .
      793   procedure proc-alt-shift-f4:
      794     define variable v-action as character no-undo .
      795     if v-inform-launched = false then do:
      796       assign
      797         v-inform-launched = true
      798       .
      799       run gbl/d-inform.w
      800         (  input self
      801         ,  input this-procedure
      802         , output v-action
      803         ) no-error .
      804       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      805       assign
      806         v-inform-launched = false
      807       .
      808     end.
      809   end.
