     7624     ,output sort-phrase-73
     7625     ,output where-phrase-rus-73
     7626     ,output sort-phrase-rus-73
     7627     ).
     7628   if p-open-query then do:
     7629       run set-filter-name in this-procedure
     7630         (INPUT filter-name-73
     7631         ) no-error .
     7632     assign
     7633       l-filter-open-73 = false
     7634     .
     7635     if flt-rec-73 <> ?
     7636       or sort-column-phrase > ""
     7637     then do:
     7638       define variable  parameter-2-73 as character no-undo .
     7639       define variable  parameter-3-73 as character no-undo .
     7640       define variable  parameter-4-73 as character no-undo .
     7641       define variable  parameter-5-73 as character no-undo .
     7642       define variable  parameter-6-73 as character no-undo .
     7643       define variable  parameter-7-73 as character no-undo .
     7644         assign
     7645         parameter-3-73 =
     7646                                 "FOR EACH shar-buf_ord-doc"
     7647         parameter-4-73 =
     7648           (
     7649             if (" shar-buf_ord-doc.host-code = g#host-code " + " " + where-phrase-73) <> ""
     7650             then  substitute(' shar-buf_ord-doc.host-code =  &1 ' , g#host-code )  + " " + where-phrase-73
     7651             else "true"
     7652           )
     7653         parameter-5-73 = (" " + "" + " " + "")
     7654         parameter-6-73 = if sort-phrase-73 = ''
     7655                              then
     7656           (
     7657           " " + " USE-INDEX ByFirm " +
     7658             " " + sort-column-phrase +
     7659           " " + " "
     7660           )
     7661                              else
     7662           (
     7663           " " + " USE-INDEX ByFirm " +
     7664             " " + sort-column-phrase +
     7665           " " + sort-phrase-73
     7666           )
     7667         parameter-7-73 =
     7668           " indexed-reposition  "
     7669       .
     7670       do
     7671       on stop undo, leave
     7672       on error undo, leave
     7673       :
     7674         assign
     7675           l-disable-where-73 =
     7676             (" shar-buf_ord-doc.host-code = g#host-code " + " " + where-phrase-73 = "")
     7677         .
     7678         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     7679                             ,input query br-docs:handle
     7680                             ,input parameter-3-73
     7681                             ,input parameter-4-73
     7682                             ,input parameter-5-73
     7683                             ,input parameter-6-73
     7684                             ,input parameter-7-73
     7685                             )
     7686         .
     7687         assign
