     3276   procedure orddocattr-code :
     3277     do on error undo, return error return-value
     3278     :
     3279       define input  parameter p-code           as character no-undo .
     3280       define output parameter p-type           as character no-undo .
     3281       define output parameter p-format         as character no-undo .
     3282       define output parameter p-fillin_width   as integer   no-undo .
     3283       define output parameter p-fillin_height  as integer   no-undo .
     3284       define output parameter p-label          as character no-undo .
     3285       define output parameter p-user-can-edit  as logical   no-undo .
     3286       define output parameter p-output-display as logical   no-undo .
     3287       define output parameter p-proc           as character no-undo .
     3288       define output parameter p-func           as character no-undo .
     3289       define output parameter p-sort           as integer   no-undo .
     3290       define output parameter p-other          as character no-undo .
     3291       case p-code :
     3292               when 'cycle-doc-code':U then do:     assign     p-label          = "Номер заказа цикличного"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Номер заказа цикличного"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3293               when 'cycle-day':U then do:     assign     p-label          = "период цикличности"     p-type           = 'I':U      p-format         = ">>>>>>9"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "период цикличности"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3294               when 'cycle-done':U then do:     assign     p-label          = "Заказ рассчитан"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Заказ рассчитан"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3295               when 'exch-code':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3296               when 'exch-rate':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3297               when 'exch-scale':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3298               when 'base-rate':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3299               when 'base-scale':U then do:     assign     p-label          = "Валюта Заказа"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Валюта Заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3300               when 'cycle-contract-code':U then do:     assign     p-label          = "договор"     p-type           = 'C':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "договор"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3301               when 'cycle-ship-date':U then do:     assign     p-label          = "дата доставки"     p-type           = 'T':U      p-format         = "99/99/9999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "дата доставки"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3302               when 'cycle-ship-time':U then do:     assign     p-label          = "время доставки"     p-type           = 'I':U      p-format         = "x(16)"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "время доставки"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3303               when 'cycle-date1':U then do:     assign     p-label          = "период продаж"     p-type           = 'T':U      p-format         = "99/99/9999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "период продаж"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3304               when 'cycle-date2':U then do:     assign     p-label          = "период продаж"     p-type           = 'T':U      p-format         = "99/99/9999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "период продаж"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3305               when 'cycle-doc-date':U then do:     assign     p-label          = "дата заказа"     p-type           = 'T':U      p-format         = "99/99/9999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "дата заказа"     p-user-can-edit  = false     p-output-display = false     p-sort           = 10     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3306               when 'ora-exp-seq-num':U then do:     assign     p-label          = "Номер выгрузки в Oracle Retail"     p-type           = 'I':U      p-format         = "999999999"     p-fillin_width   = 20     p-fillin_height  = 1     p-label          = "Номер выгрузки в Oracle Retail"     p-user-can-edit  = false     p-output-display = false     p-sort           = 100     p-proc           = '':u     p-func           = '':u     p-other          = '':u      .   end.
     3307         otherwise do:
     3308           undo, return error "неизвестный атрибут строки заказа" + " " + p-code .
     3309         end.
     3310       end.
     3311     end.
     3312   end procedure.
     3313   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3314   procedure ordlineattr-value :
     3315     do
     3316     on error undo, return error return-value
     3317     :
     3318       define input  parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     3319       define input  parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     3320       define input  parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     3321       define output parameter p-value    like ub.ord-line-attr.attr-value no-undo .
     3322       define output parameter p-type     as character no-undo .
     3323       define buffer buf_ord-line-attr for ub.ord-line-attr .
     3324       define variable v-format         as character no-undo .
     3325       define variable v-fillin_width   as integer   no-undo .
     3326       define variable v-fillin_height  as integer   no-undo .
     3327       define variable v-label          as character no-undo .
     3328       define variable v-user-can-edit  as logical   no-undo .
     3329       define variable v-output-display as logical   no-undo .
     3330       define variable v-other          as character no-undo .
     3331       define variable v-proc           as character no-undo .
     3332       define variable v-func           as character no-undo .
     3333       define variable v-sort           as integer   no-undo .
     3334       run ordlineattr-code in this-procedure
     3335         (input  p-code
     3336         ,output p-type
     3337         ,output v-format
     3338         ,output v-fillin_width
     3339         ,output v-fillin_height
     3340         ,output v-label
     3341         ,output v-user-can-edit
     3342         ,output v-output-display
     3343         ,output v-proc
     3344         ,output v-func
     3345         ,output v-sort
     3346         ,output v-other
     3347         ) no-error .
     3348       if error-status :error then do:
     3349         undo, return error return-value .
     3350       end.
     3351       find first buf_ord-line-attr no-lock
     3352         where buf_ord-line-attr.doc-code  = p-doc-code
     3353           and buf_ord-line-attr.gds-code  = p-gds-code
     3354           and buf_ord-line-attr.attr-code = p-code
     3355         no-error .
     3356       if avail buf_ord-line-attr then do:
     3357         assign
     3358           p-value =  buf_ord-line-attr.attr-value
     3359         .
     3360       end.
     3361       else do:
     3362         assign
     3363           p-value = if p-type = 'L':U then "no":U else ""
     3364         .
     3365       end.
     3366     end.
     3367   end procedure.
     3368   procedure ordlineattr-write :
     3369     do
     3370     on error undo, return error return-value
     3371     :
     3372       define input parameter p-doc-code like ub.ord-line-attr.doc-code   no-undo .
     3373       define input parameter p-gds-code like ub.ord-line-attr.gds-code   no-undo .
     3374       define input parameter p-code     like ub.ord-line-attr.attr-code  no-undo .
     3375       define input parameter p-value    like ub.ord-line-attr.attr-value no-undo .
