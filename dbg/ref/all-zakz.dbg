     5379   if not available shar-buf_ord-doc then do:   message "Неправильно выбран документ.".   return no-apply. end. doc-rec = recid (shar-buf_ord-doc). do on stop undo, return no-apply :   find shar-buf_ord-doc where recid (shar-buf_ord-doc) = doc-rec no-lock .   end.
