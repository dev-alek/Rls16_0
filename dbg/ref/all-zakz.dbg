     5642   ON CHOOSE OF b-close IN FRAME d-all-docs
     5643   DO:
     5644   define variable ll-recid as recid no-undo .
     5645   define variable mark-list as character no-undo.
     5646   define buffer buf_clients for ub.clients  .
     5647   define buffer buf_ext-classif for ub.ext-classif  .
     5648   define buffer buf1_ord-doc for ub.ord-doc.
     5649     find current shar-buf_ord-doc no-lock no-error.
     5650     if del-list = "" then
     5651       assign
     5652         mark-list = string(recid(shar-buf_ord-doc))
     5653         .
     5654     else
     5655       assign
     5656         mark-list = del-list
     5657         .
     5658     do kk = 1 to num-entries(mark-list) :
     5659       for each shar-buf_ord-doc share-lock where recid(shar-buf_ord-doc) = integer(entry(kk,mark-list)):
     5660         if shar-buf_ord-doc.status_ = 'факт':U and shar-buf_ord-doc.flag_= true  then do:
     5661            message "Заказ закрыт до статуса ФАКТ .".
     5662            next.
     5663         end.
     5664     if ( shar-buf_ord-doc.status_ = 'новый':U or
     5665          shar-buf_ord-doc.status_ = 'поставка':U) and
     5666          shar-buf_ord-doc.doc-type = 'ОП':U then do:
     5667       if status-is-edoc-nn ( input is-edoc-nn
     5668                             , input shar-buf_ord-doc.cli-type
     5669                             , input shar-buf_ord-doc.cli-code
     5670                             , input shar-buf_ord-doc.obj-type
     5671                             , input shar-buf_ord-doc.obj-code
     5672                             )
     5673        or  (status-is-edi ( input is-edi
     5674                         , input shar-buf_ord-doc.cli-type
     5675                         , input shar-buf_ord-doc.cli-code
     5676                         , input shar-buf_ord-doc.obj-type
     5677                         , input shar-buf_ord-doc.obj-code
     5678                         , output v-dm-edi
     5679                         )
     5680             and
     5681             shar-buf_ord-doc.whole-send-news = integer('2':U)
     5682             )
     5683       then do:
     5684         if shar-buf_ord-doc.status_ = 'новый':U then do:
     5685           message
     5686           substitute(" По ПОСТАВЩИКУ &1&2 система работает по EDOC\EDI , Закрыть можно будет при корректировке заказа в статусе EDOC\EDI ПОДТВЕРЖДЕН"
     5687                      ,shar-buf_ord-doc.cli-type
     5688                      ,shar-buf_ord-doc.cli-code
     5689                      )
     5690           view-as alert-box information .
     5691               next .
     5692         end.
     5693         if shar-buf_ord-doc.status_ = 'поставка':U then do:
     5694          define variable vv-ok as logical   no-undo .
     5695          vv-ok = false .
     5696          message
     5697           substitute(" По ПОСТАВЩИКУ &1&2 система работает по EDOC\EDI. Заказ ожидает поставку. Вы уверены что хотите закрыть заказ без поставки?"
     5698                      ,shar-buf_ord-doc.cli-type
     5699                      ,shar-buf_ord-doc.cli-code)
     5700              view-as alert-box question
     5701              buttons yes-no
     5702              update vv-ok
     5703             .
     5704               if not vv-ok then  next .
     5705         end.
     5706       end.
     5707     end.
     5708     message
     5709       "Закрыть " (if shar-buf_ord-doc.doc-type  =  'ОФ':U then " заявку " else " заказ " ) shar-buf_ord-doc.doc-code  " ?"
     5710       view-as alert-box question
     5711       buttons yes-no
     5712       update g#log .
     5713         if not g#log then next.
     5714         ll-recid = recid(shar-buf_ord-doc).
     5715         run cus/ord-clos.p
     5716           (input  parParentProc
     5717           ,input  recid(shar-buf_ord-doc)
     5718           ,input  store-type
     5719           ,input  store-code
     5720           ,input  v-cntxt-db-num
     5721           ,input  true
     5722           ,input  "no"
     5723           ) no-error .
     5724           if error-status :error or return-value <> "" then do:
     5725               message return-value         skip
     5726               error-status :get-message(1) skip
     5727               view-as alert-box error
     5728               title "Закрытие заказа"
     5729             .
     5730           end.
     5731       end.
     5732     end.
     5733     find current shar-buf_ord-doc no-lock no-error.
     5734     run ui-on in this-procedure (yes, no, '':U).
     5735     reposition br-docs to recid ll-recid no-error.
     5736     apply "value-changed" to br-docs in frame d-all-docs .
     5737     return no-apply.
     5738    END.
