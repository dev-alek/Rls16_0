    11332     end.
    11333   end procedure.
    11334   procedure save-ordline :
    11335   define input  parameter p-new-code as character no-undo .
    11336   define input  parameter p-doc-code as character no-undo .
    11337   define input  parameter p-gds-code  as integer   no-undo .
    11338   define input  parameter p-cli-qnty as decimal   no-undo .
    11339   define input  parameter p-order-type as integer   no-undo .
    11340     do
    11341     on error undo, return error return-value
    11342     :
    11343     if p-order-type = 0 then return .
    11344     run ordlineattr-write (
    11345          input p-new-code + chr(4) + p-doc-code
    11346         ,input p-gds-code
    11347         ,input 'cycle-cli-qnty':U
    11348         ,input string(p-cli-qnty)) no-error .
    11349         if error-status :error then
    11350         message
    11351           vss-workfile vss-revision vss-description skip
    11352           error-status :get-message(1) skip
    11353           return-value skip
    11354           "Ошибка из ordlineattr-write"
    11355           view-as alert-box error
    11356         .
    11357     end.
    11358   end procedure.
