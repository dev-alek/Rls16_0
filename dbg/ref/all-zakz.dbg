     3377       define variable v-type           as character no-undo .
     3378       define variable v-format         as character no-undo .
     3379       define variable v-fillin_width   as integer   no-undo .
     3380       define variable v-fillin_height  as integer   no-undo .
     3381       define variable v-label          as character no-undo .
     3382       define variable v-user-can-edit  as logical   no-undo .
     3383       define variable v-output-display as logical   no-undo .
     3384       define variable v-other          as character no-undo .
     3385       define variable v-proc           as character no-undo .
     3386       define variable v-func           as character no-undo .
     3387       define variable v-sort           as integer   no-undo .
