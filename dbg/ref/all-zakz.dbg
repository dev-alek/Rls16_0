     1903   FUNCTION mark-string RETURN CHAR (buffer loc-t-doc for shar-buf_ord-doc ).
     1904     if can-do (del-list, string (recid (loc-t-doc))) then RETURN "*".
     1905     else RETURN "".
     1906   END FUNCTION.
     1907   FUNCTION f-fo RETURNS CHARACTER
     1908     ( buffer loc-t-doc for ub.ord-doc ) :
     1909   define buffer bufb_contract for ub.contract  .
     1910   define variable v-proc as character no-undo .
     1911      find first bufb_contract no-lock where
     1912                 bufb_contract.contract-code = loc-t-doc.contract-code and
     1913                 bufb_contract.host-code     = loc-t-doc.host-code and
     1914                 bufb_contract.usl-opl       = 'Предоплата(%)':U
     1915                 no-error .
     1916   if available bufb_contract then v-proc = "%" + trim( string(bufb_contract.srok-opl)).
     1917                              else v-proc = "".
     1918   if v-proc = ? then v-proc = "err" .
     1919    if loc-t-doc.cr-fo = yes then do:
     1920      if loc-t-doc.status_ = 'факт':U
     1921      then do:
     1922       if loc-t-doc.cr-fo2 = yes then return substring(string ( loc-t-doc.fo-date, "99/99/99"),1,5) + "-" + substring (string (loc-t-doc.fo-date2, "99/99/99"),1,5)  .
     1923       else return string (loc-t-doc.fo-date, "99/99/99") + v-proc.
     1924      end.
     1925      else return string (loc-t-doc.fo-date, "99/99/99") + v-proc.
     1926    end.
     1927    else do:
     1928      if loc-t-doc.need-fo = 0 then do:
     1929        return "--------".
     1930      end.
     1931      if loc-t-doc.need-fo = 1 then do:
     1932        return "".
     1933      end.
     1934      if loc-t-doc.need-fo = 2 then do:
     1935        return "не опред".
     1936      end.
     1937    end.
     1938   END FUNCTION.
     1939   DEFINE BROWSE br-docs QUERY br-docs NO-LOCK DISPLAY
     1940         mark-string (buffer shar-buf_ord-doc) @ mark COLUMN-LABEL "*" FORMAT "x(1)"
     1941         if shar-buf_ord-doc.order-type = 1 then "*" Else "" COLUMN-LABEL "Ц" FORMAT "x(1)"    COLUMN-FGCOLOR 3
     1942         (substring (shar-buf_ord-doc.doc-type, 1, 2)) COLUMN-LABEL "Т" FORMAT "x(2)"
     1943         IF (shar-buf_ord-doc.status_ = 'факт':U or shar-buf_ord-doc.status_ = 'закрыто':U) THEN (shar-buf_ord-doc.status_ + string(shar-buf_ord-doc.flag_,"+/-")) ELSE (shar-buf_ord-doc.status_) COLUMN-LABEL "Статус" format "x(8)"
     1944         status-edoc-edi-light (buffer shar-buf_ord-doc, input no, input no, output v-color) @ str-status-edoc-nn COLUMN-LABEL "Статус EDOC" FORMAT "x(12)"
     1945         shar-buf_ord-doc.doc-code format "x(12)"
     1946         shar-buf_ord-doc.doc-date   format "99/99/9999" column-label "Дата"
     1947         shar-buf_ord-doc.fact-date  format "99/99/9999" COLUMN-LABEL "Факт"
     1948         shar-buf_ord-doc.cli-type + " " + String(shar-buf_ord-doc.cli-code)   format "x(13)" column-label "Код"
     1949         shar-buf_ord-doc.cli-name  format "x(27)"
     1950         shar-buf_ord-doc.cons-code  column-label "Ссылка"
     1951         shar-buf_ord-doc.host-code format ">>>>>>>>9" column-label "Фирма"
     1952         shar-buf_ord-doc.obj-type + " " + string(shar-buf_ord-doc.obj-code)  column-label "Объект"
     1953         shar-buf_ord-doc.ship-date column-label "Доставка"
     1954         string(shar-buf_ord-doc.ship-time,"hh:mm") column-label "Время"
     1955         f-fo ( buffer shar-buf_ord-doc ) @ v-fo column-label "ФО" format "x(11)"
     1956       WITH SIZE 98 BY 15 separators.
