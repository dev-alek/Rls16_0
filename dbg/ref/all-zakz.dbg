     5797   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5798   procedure minbtn-set :
     5799       do
     5800           on error undo, return error return-value
     5801           :
     5802           define variable ii              as integer       no-undo .
     5803           define variable fh              as widget-handle no-undo .
     5804           define variable hh              as widget-handle no-undo .
     5805           define variable v-h             as handle        extent 4 no-undo .
     5806           define variable v-name-button   as character     no-undo .
     5807           define variable v-help-old-x    as decimal       no-undo .
     5808           define variable v-help-old-y    as decimal       no-undo .
     5809           define variable v-help-old-size as decimal       no-undo .
     5810           define variable v-frame-width   as decimal       no-undo .
     5811           define variable jj              as integer       no-undo .
     5812           do
     5813               on error undo, return error
     5814               :
     5815               assign
     5816                   v-frame-width = frame d-all-docs:width - 0.3
     5817                   fh            = frame d-all-docs:first-child
     5818                   hh            = fh:first-child
     5819                   ii            = 1
     5820                   .
     5821               do while valid-handle(hh):
     5822                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     5823                   do:
     5824                       case lc(hh:name) :
     5825                           when "b-help" then
     5826                               do:
     5827                                   hh:load-image-up("cmp/b-help.bmp":u) .
     5828                                   hh:load-image-down("cmp/b-help.bmp":u) .
     5829                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     5830                                   hh:TOOLTIP = "Помощь" .
     5831                                   v-help-old-x = hh:column .
     5832                                   v-help-old-y = hh:row    .
     5833                                   v-help-old-size = hh:width .
     5834                                   hh:width-chars = 2.5 .
     5835                               end.
     5836                           when "b-print" then
     5837                               do:
     5838                                   hh:load-image("cmp/b-print.bmp":u) .
     5839                                   hh:TOOLTIP = "Печать" .
     5840                                   v-h[ii] = hh:handle .
     5841                                   ii = ii + 1 .
     5842                                   hh:width-chars = 3 .
     5843                               end.
     5844                           when "b-history" or
     5845                           when "b-hist" then
     5846                               do:
     5847                                   hh:load-image("cmp/b-hist.bmp":u) .
     5848                                   hh:TOOLTIP = "История" .
     5849                                   v-h[ii] = hh:handle .
     5850                                   ii = ii + 1 .
     5851                                   hh:width-chars = 3 .
     5852                               end.
     5853                           when "b-sch" then
     5854                               do:
     5855                                   hh:load-image("cmp/b-sch.bmp":u) .
     5856                                   hh:TOOLTIP = "Установка Фильтра" .
     5857                                   v-h[ii] = hh:handle .
     5858                                   ii = ii + 1 .
     5859                                   hh:width-chars = 3 .
     5860                               end.
     5861                           when "b-hist-user" then
     5862                               do:
     5863                                   hh:load-image("cmp/b-hist.bmp":u) .
     5864                                   hh:TOOLTIP = "История пользователя" .
     5865                                   ii = ii + 1 .
     5866                               end.
     5867                       end case.
     5868                   end.
     5869                   hh = hh:next-sibling.
     5870               end.
     5871               b-help:column = v-frame-width - b-help:width-chars.
     5872               jj = 0.
     5873               repeat ii = 4 to 1 by -1 :
     5874                   if valid-handle (v-h[ii] ) then
     5875                   do:
     5876                       jj  = jj + 1 .
     5877                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     5878                       v-h[ii]:row    = v-help-old-y .
     5879                   end.
     5880               end.
     5881           end.
     5882       end.
     5883   end procedure.
     5884   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     5885   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     5886   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     5887   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     5888   define variable v-diasize-current-frame-width  as decimal   no-undo .
     5889   define variable v-diasize-current-frame-height as decimal   no-undo .
     5890   define variable v-diasize-change-size          as logical   no-undo .
     5891   define variable v-diasize-resize-button        as handle    no-undo .
     5892   define variable v-diasize-wndmax               as logical   no-undo .
     5893   define variable v-diasize-wndstore             as logical   no-undo .
     5894   define variable v-diasize-proc-name            as character no-undo .
     5895   define variable v-diasize-browse-handle        as handle    no-undo .
     5896   define variable v-diasize-browse-number        as integer   no-undo .
     5897   define variable v-diasize-need-full-display    as logical   no-undo init false .
     5898   define temp-table temp-diasize-handle no-undo
     5899     field handle-value  as handle
     5900     field save-position as decimal
     5901     index xpk is primary unique handle-value
     5902     .
     5903   define temp-table temp-browse-handle no-undo
     5904     field browse-type   as character
     5905     field browse-number as integer
     5906     field browse-handle as handle
     5907     field original-size as decimal
     5908     index xpk is primary unique browse-type browse-number
     5909     index xie browse-type browse-handle
     5910   .
     5911   procedure diasize_change-height :
     5912     define input  parameter p-change-value  as decimal   no-undo .
     5913     define input  parameter p-move-resize   as logical   no-undo .
     5914     define variable v-field-group-handle    as handle    no-undo .
     5915     define variable v-object-handle         as handle    no-undo .
     5916     define variable v-frame-height          as decimal   no-undo .
     5917     define variable v-frame-virtual-height  as decimal   no-undo .
     5918     define variable v-browse-height         as decimal   no-undo .
     5919     define variable v-window-height         as decimal   no-undo .
     5920     define variable v-window-virtual-height as decimal   no-undo .
     5921     define variable v-change-sign           as integer   no-undo .
     5922     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     5923     define buffer buf_temp-browse-handle  for temp-browse-handle .
     5924     if p-change-value > 0
     5925     then do:
     5926       if frame d-all-docs :height + p-change-value
     5927           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     5928       then do:
     5929         assign
     5930           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     5931                           - (frame d-all-docs :height-chars)
     5932         .
     5933         if p-change-value <= 0
     5934         then do:
     5935           run diasize_position-resize-button in this-procedure .
     5936           return .
     5937         end.
     5938       end.
     5939     end.
     5940     if p-change-value < 0
     5941     then do:
     5942       if frame d-all-docs :height + p-change-value < v-diasize-orig-frame-height
     5943       then do:
     5944         assign
     5945           p-change-value = v-diasize-orig-frame-height
     5946                          - (frame d-all-docs :height-chars)
     5947         .
     5948         if p-change-value >= 0
     5949         then do:
     5950           run diasize_position-resize-button in this-procedure .
     5951           return .
     5952         end.
     5953       end.
     5954     end.
     5955     if p-change-value >= 0
     5956     then do:
     5957       assign
     5958         v-change-sign = 1
     5959       .
     5960     end.
     5961     else do:
     5962       assign
     5963         v-change-sign = -1
     5964       .
     5965     end.
     5966     assign
     5967       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     5968     .
     5969     if p-change-value = 0
     5970     then do:
     5971       run diasize_position-resize-button in this-procedure .
     5972       return .
     5973     end.
     5974     move_block:
     5975     do
     5976     on error undo move_block, retry move_block
     5977     :
     5978       if retry
     5979       then do:
     5980         do
     5981         on error undo move_block, leave move_block
     5982         :
     5983           if p-change-value > 0
     5984           then do:
     5985             for each buf_temp-diasize-handle
     5986             on error undo, next
     5987             :
     5988               assign
     5989                 v-object-handle = buf_temp-diasize-handle.handle-value
     5990               .
     5991               if v-object-handle <> v-diasize-resize-button
     5992               then do:
     5993                 assign
     5994                   v-object-handle :row = buf_temp-diasize-handle.save-position
     5995                 .
     5996               end.
     5997             end.
     5998             assign
     5999               v-diasize-browse-handle :height = v-browse-height
     6000             .
     6001             for each buf_temp-browse-handle
     6002               where buf_temp-browse-handle.browse-type = 'height':u
     6003             on error undo, next
     6004             :
     6005               assign
     6006                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     6007               .
     6008             end.
     6009             assign
     6010               frame d-all-docs :height = v-frame-height
     6011             .
     6012             if frame d-all-docs :scrollable = true
     6013             then do:
     6014               assign
     6015                 frame d-all-docs :virtual-height = v-frame-virtual-height
     6016               .
     6017             end.
     6018             run diasize_position-resize-button in this-procedure .
     6019           end.
     6020           else do:
     6021             if frame d-all-docs :scrollable = true
     6022             then do:
     6023               assign
     6024                 frame d-all-docs :virtual-height = v-frame-virtual-height
     6025               .
     6026             end.
     6027             assign
     6028               frame d-all-docs :height = v-frame-height
     6029             .
     6030             assign
     6031               v-diasize-browse-handle :height = v-browse-height
     6032             .
     6033             for each buf_temp-browse-handle
     6034               where buf_temp-browse-handle.browse-type = 'height':u
     6035             on error undo, next
     6036             :
     6037               assign
     6038                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     6039               .
     6040             end.
     6041             for each buf_temp-diasize-handle
     6042             on error undo, next
     6043             :
     6044               assign
     6045                 v-object-handle = buf_temp-diasize-handle.handle-value
     6046               .
     6047               if v-object-handle <> v-diasize-resize-button
     6048               then do:
     6049                 assign
     6050                   v-object-handle :row = buf_temp-diasize-handle.save-position
     6051                 .
     6052               end.
     6053             end.
     6054             run diasize_position-resize-button in this-procedure .
     6055           end.
     6056           assign
     6057             v-diasize-change-size = false
     6058           .
     6059           leave move_block .
     6060         end.
     6061       end.
     6062       assign
     6063         v-diasize-need-full-display = true
     6064       .
     6065       if v-diasize-change-size = false
     6066       then do:
     6067         assign
     6068           v-diasize-change-size = true
     6069         .
     6070       end.
     6071       else do:
     6072         return .
     6073       end.
     6074       assign
     6075         v-frame-height = frame d-all-docs :height
     6076         v-frame-virtual-height = frame d-all-docs :virtual-height
     6077         v-browse-height = v-diasize-browse-handle :height
     6078       .
     6079       for each buf_temp-browse-handle
     6080         where buf_temp-browse-handle.browse-type = 'height':u
     6081       :
     6082         assign
     6083           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     6084         .
     6085       end.
     6086       for each buf_temp-diasize-handle
     6087       :
     6088         delete buf_temp-diasize-handle .
     6089       end.
     6090       assign
     6091         v-field-group-handle = frame d-all-docs :first-child
     6092       .
     6093       do while valid-handle(v-field-group-handle)
     6094       :
     6095         assign
     6096           v-object-handle = v-field-group-handle :first-child
     6097         .
     6098         do while valid-handle(v-object-handle)
     6099         :
     6100           if  v-object-handle <> v-diasize-browse-handle :handle
     6101           and can-query(v-object-handle, "row")
     6102           and can-query(v-object-handle, "height")
     6103           and ( v-object-handle :row > v-diasize-browse-handle :row )
     6104           then do:
     6105             find first buf_temp-browse-handle
     6106               where buf_temp-browse-handle.browse-type   = 'height':u
     6107                 and buf_temp-browse-handle.browse-handle = v-object-handle
     6108               no-error .
     6109             if available buf_temp-browse-handle
     6110             then do:
     6111             end.
     6112             else do:
     6113               create buf_temp-diasize-handle .
     6114               assign
     6115                 buf_temp-diasize-handle.handle-value  = v-object-handle
     6116                 buf_temp-diasize-handle.save-position = v-object-handle :row
     6117               .
     6118             end.
     6119           end.
     6120           assign
     6121             v-object-handle = v-object-handle :next-sibling
     6122           .
     6123         end.
     6124         assign
     6125           v-field-group-handle = v-field-group-handle :next-sibling
     6126         .
     6127       end.
     6128       do with frame d-all-docs
     6129       :
     6130         hide v-diasize-resize-button .
     6131         assign
     6132           v-diasize-resize-button :row    = 1
     6133           v-diasize-resize-button :column = 1
     6134         .
     6135       end.
     6136       if p-change-value > 0
     6137       then do:
     6138         if frame d-all-docs :scrollable = true
     6139         then do:
     6140           assign
     6141             frame d-all-docs :virtual-height = frame d-all-docs :virtual-height + p-change-value
     6142             no-error .
     6143           if error-status :error
     6144           or error-status :get-message(1) <> ""
     6145           then do:
     6146             undo move_block, retry move_block .
     6147           end.
     6148         end.
     6149         assign
     6150           frame d-all-docs :height = frame d-all-docs :height + p-change-value
     6151           no-error .
     6152         if error-status :error
     6153         or error-status :get-message(1) <> ""
     6154         then do:
     6155           undo move_block, retry move_block .
     6156         end.
     6157         assign
     6158           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     6159           no-error .
     6160         if error-status :error
     6161         or error-status :get-message(1) <> ""
     6162         then do:
     6163           undo move_block, retry move_block .
     6164         end.
     6165         for each buf_temp-browse-handle
     6166           where buf_temp-browse-handle.browse-type = 'height':u
     6167         on error undo move_block, retry move_block
     6168         :
     6169           assign
     6170             buf_temp-browse-handle.browse-handle :height
     6171               = buf_temp-browse-handle.browse-handle :height + p-change-value
     6172             no-error .
     6173           if error-status :error
     6174           or error-status :get-message(1) <> ""
     6175           then do:
     6176             undo move_block, retry move_block .
     6177           end.
     6178         end.
     6179         for each buf_temp-diasize-handle
     6180         on error undo move_block, retry move_block
     6181         :
     6182           assign
     6183             v-object-handle = buf_temp-diasize-handle.handle-value
     6184           .
     6185           if v-object-handle <> v-diasize-resize-button
     6186           then do:
     6187             assign
     6188               v-object-handle :row = v-object-handle :row + p-change-value
     6189               no-error .
     6190             if error-status :error
     6191             or error-status :get-message(1) <> ""
     6192             then do:
     6193               undo move_block, retry move_block .
     6194             end.
     6195           end.
     6196         end.
     6197       end.
     6198       else do:
     6199         for each buf_temp-diasize-handle
     6200         on error undo move_block, retry move_block
     6201         :
     6202           assign
     6203             v-object-handle = buf_temp-diasize-handle.handle-value
     6204           .
     6205           if v-object-handle <> v-diasize-resize-button
     6206           then do:
     6207             assign
     6208               v-object-handle :row = v-object-handle :row + p-change-value
     6209               no-error .
     6210             if error-status :error
     6211             or error-status :get-message(1) <> ""
     6212             then do:
     6213               undo move_block, retry move_block .
     6214             end.
     6215           end.
     6216         end.
     6217         assign
     6218           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     6219           no-error .
     6220         if error-status :error
     6221         or error-status :get-message(1) <> ""
     6222         then do:
     6223           undo move_block, retry move_block .
     6224         end.
     6225         for each buf_temp-browse-handle
     6226           where buf_temp-browse-handle.browse-type = 'height':u
     6227         on error undo move_block, retry move_block
     6228         :
     6229           assign
     6230             buf_temp-browse-handle.browse-handle :height
     6231               = buf_temp-browse-handle.browse-handle :height + p-change-value
     6232             no-error .
     6233           if error-status :error
     6234           or error-status :get-message(1) <> ""
     6235           then do:
     6236             undo move_block, retry move_block .
     6237           end.
     6238         end.
     6239         assign
     6240           frame d-all-docs :height = frame d-all-docs :height + p-change-value
     6241           no-error .
     6242         if error-status :error
     6243         or error-status :get-message(1) <> ""
     6244         then do:
     6245           undo move_block, retry move_block .
     6246         end.
     6247         if frame d-all-docs :scrollable = true
     6248         then do:
     6249           assign
     6250             frame d-all-docs :virtual-height = frame d-all-docs :virtual-height + p-change-value
     6251             no-error .
     6252           if error-status :error
     6253           or error-status :get-message(1) <> ""
     6254           then do:
     6255             undo move_block, retry move_block .
     6256           end.
     6257         end.
     6258       end.
     6259       if p-move-resize = true
     6260       then do:
     6261         run diasize_position-resize-button in this-procedure .
     6262       end.
     6263       if v-diasize-wndstore = true
     6264       then do:
     6265         if connected("ub") = true
     6266         then do:
     6267           define variable v-cntxt-db-num        as integer   no-undo .
     6268           define variable v-cntxt-userid        as character no-undo .
     6269           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6270                                             , OUTPUT v-cntxt-userid
     6271                                             ) .
     6272           run gbl/wndsizew.p
     6273             (input  v-cntxt-db-num
     6274             ,input  v-cntxt-userid
     6275             ,input  v-diasize-proc-name
     6276             ,input  'height':u
     6277             ,input  string(frame d-all-docs :height - v-diasize-orig-frame-height)
     6278             ) .
     6279         end.
     6280       end.
     6281     end.
     6282     assign
     6283       v-diasize-change-size = false
     6284     .
     6285   end procedure.
     6286   procedure diasize_set-height :
     6287     define input  parameter p-new-height  as decimal   no-undo .
     6288     define input  parameter p-move-resize as logical   no-undo .
     6289     do
     6290     on error undo, return error return-value
     6291     :
     6292       run diasize_change-height in this-procedure
     6293         (input  (p-new-height - frame d-all-docs :height)
     6294         ,input  p-move-resize
     6295         ) .
     6296     end.
     6297   end procedure.
     6298   procedure diasize_change-width :
     6299     define input  parameter p-change-value as decimal   no-undo .
     6300     define input  parameter p-move-resize  as logical   no-undo .
     6301     define variable v-field-group-handle   as handle    no-undo .
     6302     define variable v-object-handle        as handle    no-undo .
     6303     define variable v-frame-width          as decimal   no-undo .
     6304     define variable v-frame-virtual-width  as decimal   no-undo .
     6305     define variable v-browse-width         as decimal   no-undo .
     6306     define variable v-window-width         as decimal   no-undo .
     6307     define variable v-window-virtual-width as decimal   no-undo .
     6308     define variable v-change-sign          as integer   no-undo .
     6309     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     6310     define buffer buf_temp-browse-handle  for temp-browse-handle .
     6311     if p-change-value > 0
     6312     then do:
     6313       if frame d-all-docs :width + p-change-value >
     6314           session :width-chars
     6315       then do:
     6316         assign
     6317           p-change-value = session :width-chars - frame d-all-docs :width
     6318         .
     6319         if p-change-value <= 0
     6320         then do:
     6321           run diasize_position-resize-button in this-procedure .
     6322           return .
     6323         end.
     6324       end.
     6325     end.
     6326     if p-change-value < 0
     6327     then do:
     6328       if frame d-all-docs :width + p-change-value < v-diasize-orig-frame-width
     6329       then do:
     6330         assign
     6331           p-change-value = v-diasize-orig-frame-width
     6332                          - frame d-all-docs :width
     6333         .
     6334         if p-change-value >= 0
     6335         then do:
     6336           run diasize_position-resize-button in this-procedure .
     6337           return .
     6338         end.
     6339       end.
     6340     end.
     6341     if p-change-value >= 0
     6342     then do:
     6343       assign
     6344         v-change-sign = 1
     6345       .
     6346     end.
     6347     else do:
     6348       assign
     6349         v-change-sign = -1
     6350       .
     6351     end.
     6352     assign
     6353       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     6354     .
     6355     if p-change-value = 0
     6356     then do:
     6357       run diasize_position-resize-button in this-procedure .
     6358       return .
     6359     end.
     6360     move_block:
     6361     do
     6362     on error undo move_block, leave move_block
     6363     :
     6364       if retry
     6365       then do:
     6366         do
     6367         on error undo move_block, leave move_block
     6368         :
     6369           if p-change-value > 0
     6370           then do:
     6371             for each buf_temp-diasize-handle
     6372             on error undo, next
     6373             :
     6374               assign
     6375                 v-object-handle = buf_temp-diasize-handle.handle-value
     6376               .
     6377               if v-object-handle <> v-diasize-resize-button
     6378               then do:
     6379                 assign
     6380                   v-object-handle :col = buf_temp-diasize-handle.save-position
     6381                 .
     6382               end.
     6383             end.
     6384             assign
     6385               v-diasize-browse-handle :width = v-browse-width
     6386             .
     6387             for each buf_temp-browse-handle
     6388               where buf_temp-browse-handle.browse-type = 'width':u
     6389             on error undo, next
     6390             :
     6391               assign
     6392                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     6393               .
     6394             end.
     6395             assign
     6396               frame d-all-docs :width = v-frame-width
     6397             .
     6398             if frame d-all-docs :scrollable = true
     6399             then do:
     6400               assign
     6401                 frame d-all-docs :virtual-width = v-frame-virtual-width
     6402               .
     6403             end.
     6404             run diasize_position-resize-button in this-procedure .
     6405           end.
     6406           else do:
     6407             if frame d-all-docs :scrollable = true
     6408             then do:
     6409               assign
     6410                 frame d-all-docs :virtual-width = v-frame-virtual-width
     6411               .
     6412             end.
     6413             assign
     6414               frame d-all-docs :width = v-frame-width
     6415             .
     6416             for each buf_temp-browse-handle
     6417               where buf_temp-browse-handle.browse-type = 'width':u
     6418             on error undo, next
     6419             :
     6420               assign
     6421                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     6422               .
     6423             end.
     6424             assign
     6425               v-diasize-browse-handle :width = v-browse-width
     6426             .
     6427             for each buf_temp-diasize-handle
     6428             on error undo, next
     6429             :
     6430               assign
     6431                 v-object-handle = buf_temp-diasize-handle.handle-value
     6432               .
     6433               if v-object-handle <> v-diasize-resize-button
     6434               then do:
     6435                 assign
     6436                   v-object-handle :col = buf_temp-diasize-handle.save-position
     6437                 .
     6438               end.
     6439             end.
     6440             run diasize_position-resize-button in this-procedure .
     6441           end.
     6442           assign
     6443             v-diasize-change-size = false
     6444           .
     6445           leave move_block .
     6446         end.
     6447       end.
     6448       assign
     6449         v-diasize-need-full-display = true
     6450       .
     6451       if v-diasize-change-size = false
     6452       then do:
     6453         assign
     6454           v-diasize-change-size = true
     6455         .
     6456       end.
     6457       else do:
     6458         return .
     6459       end.
     6460       assign
     6461         v-frame-width = frame d-all-docs :width
     6462         v-frame-virtual-width = frame d-all-docs :virtual-width
     6463         v-browse-width = v-diasize-browse-handle :width
     6464       .
     6465       for each buf_temp-browse-handle
     6466         where buf_temp-browse-handle.browse-type = 'width':u
     6467       :
     6468         assign
     6469           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     6470         .
     6471       end.
     6472       for each buf_temp-diasize-handle
     6473       :
     6474         delete buf_temp-diasize-handle .
     6475       end.
     6476       assign
     6477         v-field-group-handle = frame d-all-docs :first-child
     6478       .
     6479       do while valid-handle(v-field-group-handle)
     6480       :
     6481         assign
     6482           v-object-handle = v-field-group-handle :first-child
     6483         .
     6484         do while valid-handle(v-object-handle)
     6485         :
     6486           if  v-object-handle <> v-diasize-browse-handle :handle
     6487           and v-object-handle <> v-diasize-resize-button
     6488           and can-query(v-object-handle, "row")
     6489           and can-query(v-object-handle, "height")
     6490           and ( v-object-handle :col + v-object-handle :width
     6491                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     6492               )
     6493           then do:
     6494             find first buf_temp-browse-handle
     6495               where buf_temp-browse-handle.browse-type   = 'width':u
     6496                 and buf_temp-browse-handle.browse-handle = v-object-handle
     6497               no-error .
     6498             if available buf_temp-browse-handle
     6499             then do:
     6500             end.
     6501             else do:
     6502               create buf_temp-diasize-handle .
     6503               assign
     6504                 buf_temp-diasize-handle.handle-value  = v-object-handle
     6505                 buf_temp-diasize-handle.save-position = v-object-handle :col
     6506               .
     6507             end.
     6508           end.
     6509           assign
     6510             v-object-handle = v-object-handle :next-sibling
     6511           .
     6512         end.
     6513         assign
     6514           v-field-group-handle = v-field-group-handle :next-sibling
     6515         .
     6516       end.
     6517       do with frame d-all-docs
     6518       :
     6519         hide v-diasize-resize-button .
     6520         v-diasize-resize-button :row = 1.
     6521         v-diasize-resize-button :column = 1.
     6522       end.
     6523       if p-change-value > 0
     6524       then do:
     6525         if frame d-all-docs :scrollable = true
     6526         then do:
     6527           assign
     6528             frame d-all-docs :virtual-width = frame d-all-docs :virtual-width + p-change-value
     6529             no-error .
     6530           if error-status :error
     6531           or error-status :get-message(1) <> ""
     6532           then do:
     6533             undo move_block, retry move_block.
     6534           end.
     6535         end.
     6536         assign
     6537           frame d-all-docs :width = v-frame-width + p-change-value
     6538           no-error .
     6539         if error-status :error
     6540         or error-status :get-message(1) <> ""
     6541         then do:
     6542           undo move_block, retry move_block.
     6543         end.
     6544         assign
     6545           v-diasize-browse-handle :width = v-browse-width + p-change-value
     6546         no-error .
     6547         if error-status :error
     6548         or error-status :get-message(1) <> ""
     6549         then do:
     6550           undo move_block, retry move_block.
     6551         end.
     6552         for each buf_temp-browse-handle
     6553           where buf_temp-browse-handle.browse-type = 'width':u
     6554         on error undo move_block, retry move_block
     6555         :
     6556           assign
     6557             buf_temp-browse-handle.browse-handle :width
     6558               = buf_temp-browse-handle.browse-handle :width + p-change-value
     6559             no-error .
     6560           if error-status :error
     6561           or error-status :get-message(1) <> ""
     6562           then do:
     6563             undo move_block, retry move_block .
     6564           end.
     6565         end.
     6566         for each buf_temp-diasize-handle
     6567         on error undo move_block, retry move_block
     6568         :
     6569           assign
     6570             v-object-handle = buf_temp-diasize-handle.handle-value
     6571           .
     6572           if v-object-handle <> v-diasize-resize-button
     6573           then do:
     6574             assign
     6575               v-object-handle :col = v-object-handle :col + p-change-value
     6576               no-error .
     6577             if error-status :error
     6578             or error-status :get-message(1) <> ""
     6579             then do:
     6580               undo move_block, retry move_block .
     6581             end.
     6582           end.
     6583         end.
     6584       end.
     6585       else do:
     6586         for each buf_temp-diasize-handle
     6587         on error undo move_block, retry move_block
     6588         :
     6589           assign
     6590             v-object-handle = buf_temp-diasize-handle.handle-value
     6591           .
     6592           if v-object-handle <> v-diasize-resize-button
     6593           then do:
     6594             assign
     6595               v-object-handle :col = v-object-handle :col + p-change-value
     6596               no-error .
     6597             if error-status :error
     6598             or error-status :get-message(1) <> ""
     6599             then do:
     6600               undo move_block, retry move_block .
     6601             end.
     6602           end.
     6603         end.
     6604         for each buf_temp-browse-handle
     6605           where buf_temp-browse-handle.browse-type = 'width':u
     6606         on error undo move_block, retry move_block
     6607         :
     6608           assign
     6609             buf_temp-browse-handle.browse-handle :width
     6610               = buf_temp-browse-handle.browse-handle :width + p-change-value
     6611             no-error .
     6612           if error-status :error
     6613           or error-status :get-message(1) <> ""
     6614           then do:
     6615             undo move_block, retry move_block .
     6616           end.
     6617         end.
     6618         assign
     6619           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     6620           no-error .
     6621         if error-status :error
     6622         or error-status :get-message(1) <> ""
     6623         then do:
     6624           undo move_block, retry move_block.
     6625         end.
     6626         assign
     6627           frame d-all-docs :width = frame d-all-docs :width + p-change-value
     6628         no-error .
     6629         if error-status :error
     6630         or error-status :get-message(1) <> ""
     6631         then do:
     6632           undo move_block, retry move_block.
     6633         end.
     6634         if frame d-all-docs :scrollable = true
     6635         then do:
     6636           assign
     6637             frame d-all-docs :virtual-width = frame d-all-docs :virtual-width + p-change-value
     6638           no-error .
     6639           if error-status :error
     6640           or error-status :get-message(1) <> ""
     6641           then do:
     6642             undo move_block, retry move_block.
     6643           end.
     6644         end.
     6645       end.
     6646       if p-move-resize
     6647       then do:
     6648         run diasize_position-resize-button in this-procedure .
     6649       end.
     6650       if v-diasize-wndstore = true
     6651       then do:
     6652         if connected("ub") = true
     6653         then do:
     6654           define variable v-cntxt-db-num        as integer   no-undo .
     6655           define variable v-cntxt-userid        as character no-undo .
     6656           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6657                                             , OUTPUT v-cntxt-userid
     6658                                             ) .
     6659           run gbl/wndsizew.p
     6660             (input  v-cntxt-db-num
     6661             ,input  v-cntxt-userid
     6662             ,input  v-diasize-proc-name
     6663             ,input  'width':u
     6664             ,input  string(frame d-all-docs :width - v-diasize-orig-frame-width)
     6665             ) .
     6666         end.
     6667       end.
     6668     end.
     6669     assign
     6670       v-diasize-change-size = false
     6671     .
     6672   end procedure.
     6673   procedure diasize_set-width :
     6674     define input  parameter p-new-width  as decimal   no-undo .
     6675     define input  parameter p-move-resize as logical   no-undo .
     6676     do
     6677     on error undo, return error return-value
     6678     :
     6679       run diasize_change-width in this-procedure
     6680         (input  (p-new-width - frame d-all-docs :width)
     6681         ,input  p-move-resize
     6682         ) .
     6683     end.
     6684   end procedure.
     6685   procedure diasize_position-resize-button :
     6686     do with frame d-all-docs
     6687     :
     6688       hide v-diasize-resize-button .
     6689       assign
     6690         v-diasize-resize-button :row = frame d-all-docs :height - v-diasize-resize-button :height
     6691                     - 1
     6692                     - (frame d-all-docs :border-bottom-pixels / session :pixels-per-row)
     6693         v-diasize-resize-button :col = frame d-all-docs :width - v-diasize-resize-button :width
     6694                     - 1
     6695                     - (frame d-all-docs :border-right-pixels / session :pixels-per-column)
     6696       .
     6697       view v-diasize-resize-button .
     6698     end.
     6699   end procedure.
     6700   on alt-right anywhere
     6701   do:
     6702     run diasize_change-width in this-procedure
     6703       (input 1
     6704       ,input true
     6705       ) .
     6706     return no-apply .
     6707   end.
     6708   on alt-left anywhere
     6709   do:
     6710     run diasize_change-width in this-procedure
     6711       (input -1
     6712       ,input true
     6713       ) .
     6714     return no-apply .
     6715   end.
     6716   on alt-down anywhere
     6717   do:
     6718     run diasize_change-height in this-procedure
     6719       (input 1
     6720       ,input true
     6721       ) .
     6722     return no-apply .
     6723   end.
     6724   on alt-up anywhere
     6725   do:
     6726     run diasize_change-height in this-procedure
     6727       (input -1
     6728       ,input true
     6729       ) .
     6730     return no-apply .
     6731   end.
     6732   on alt-enter of frame d-all-docs
     6733   do:
     6734     run diasize_maximize in this-procedure
     6735       (input  ?
     6736       ).
     6737     return no-apply .
     6738   end.
     6739   procedure diasize_end-move :
     6740     do
     6741     on error undo, return error return-value
     6742     :
     6743       define variable v-row-delta as decimal   no-undo .
     6744       define variable v-col-delta as decimal   no-undo .
     6745       define variable v-new-row as decimal   no-undo .
     6746       define variable v-new-col as decimal   no-undo .
     6747       assign
     6748         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     6749         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     6750       .
     6751       assign
     6752         v-row-delta = v-new-row - frame d-all-docs :height
     6753         v-col-delta = v-new-col - frame d-all-docs :width
     6754       .
     6755       run diasize_change-height in this-procedure
     6756         (input v-row-delta
     6757         ,input true
     6758         ) .
     6759       run diasize_change-width in this-procedure
     6760         (input v-col-delta
     6761         ,input true
     6762         ) .
     6763     end.
     6764   end procedure.
     6765   procedure diasize_maximize :
     6766     define input  parameter p-action as logical   no-undo .
     6767     do
     6768     on error undo, return error return-value
     6769     :
     6770       if p-action = ?
     6771       then do:
     6772         if v-diasize-need-maximize = true
     6773         then do:
     6774           assign
     6775             p-action = true
     6776           .
     6777         end.
     6778         else do:
     6779           assign
     6780             p-action = false
     6781           .
     6782         end.
     6783       end.
     6784       if p-action = true
     6785       then do:
     6786         run diasize_change-height in this-procedure
     6787           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     6788               - frame d-all-docs :height-chars
     6789           ,input true
     6790           ) .
     6791         run diasize_change-width in this-procedure
     6792           (input session :width-chars
     6793               - frame d-all-docs :width-chars
     6794           ,input true
     6795           ) .
     6796         assign
     6797           v-diasize-need-maximize = false
     6798         .
     6799       end.
     6800       else do:
     6801         run diasize_change-width in this-procedure
     6802           (input v-diasize-orig-frame-width
     6803               - frame d-all-docs :width-chars
     6804           ,input true
     6805           ) .
     6806         run diasize_change-height in this-procedure
     6807           (input v-diasize-orig-frame-height
     6808               - frame d-all-docs :height-chars
     6809           ,input true
     6810           ) .
     6811         assign
     6812           v-diasize-need-maximize = true
     6813         .
     6814       end.
     6815     end.
     6816   end procedure.
     6817   procedure diasize_restore-orig-size :
     6818     do
     6819     on error undo, return error return-value
     6820     :
     6821       assign
     6822         v-diasize-current-frame-width  = frame d-all-docs :width
     6823         v-diasize-current-frame-height = frame d-all-docs :height
     6824       .
     6825       run diasize_set-height in this-procedure
     6826         (input  v-diasize-orig-frame-height
     6827         ,input  true
     6828         ) .
     6829       run diasize_set-width in this-procedure
     6830         (input  v-diasize-orig-frame-width
     6831         ,input  true
     6832         ) .
     6833     end.
     6834   end procedure.
     6835   procedure diasize_restore-current-size :
     6836     do
     6837     on error undo, return error return-value
     6838     :
     6839       run diasize_set-height in this-procedure
     6840         (input  v-diasize-current-frame-height
     6841         ,input  true
     6842         ) .
     6843       run diasize_set-width in this-procedure
     6844         (input  v-diasize-current-frame-width
     6845         ,input  true
     6846         ) .
     6847     end.
     6848   end procedure.
     6849   procedure diasize_set-browse-handle :
     6850     define input  parameter p-browse-handle as handle   no-undo .
     6851     define buffer buf_temp-browse-handle for temp-browse-handle .
     6852     do
     6853     on error undo, return error return-value
     6854     :
     6855       assign
     6856         v-diasize-browse-handle = p-browse-handle
     6857       .
     6858       for each buf_temp-browse-handle
     6859       on error undo, return error return-value
     6860       :
     6861         delete buf_temp-browse-handle .
     6862       end.
     6863     end.
     6864   end procedure.
     6865   procedure diasize_add_browse :
     6866     define input  parameter p-browse-type   as character no-undo .
     6867     define input  parameter p-browse-handle as handle    no-undo .
     6868     define buffer buf_temp-browse-handle for temp-browse-handle .
     6869     do
     6870     on error undo, return error return-value
     6871     :
     6872       assign
     6873         v-diasize-browse-number = v-diasize-browse-number + 1
     6874       .
     6875       create buf_temp-browse-handle .
     6876       assign
     6877         buf_temp-browse-handle.browse-type   = p-browse-type
     6878         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     6879         buf_temp-browse-handle.browse-handle = p-browse-handle
     6880       .
     6881     end.
     6882   end procedure.
     6883   procedure diasize_init :
     6884     define variable v-default-value    as logical   no-undo .
     6885     define variable v-restore-saved    as logical   no-undo .
     6886     define variable v-resize-value-str as character no-undo .
     6887     do
     6888     on error undo, return error return-value
     6889     :
     6890       do with frame d-all-docs
     6891       :
     6892         assign
     6893           v-diasize-orig-frame-height = frame d-all-docs :height
     6894           v-diasize-orig-frame-width  = frame d-all-docs :width
     6895           v-diasize-browse-handle     = browse br-docs :handle
     6896         .
     6897         create button v-diasize-resize-button
     6898         assign
     6899           parent        = frame d-all-docs :first-child
     6900           label         = "s"
     6901           height-pixels = 16
     6902           width-pixels  = 16
     6903           visible       = true
     6904           sensitive     = true
     6905           movable       = true
     6906           triggers:
     6907             on end-move persistent run diasize_end-move in this-procedure .
     6908           end triggers.
     6909         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     6910         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     6911         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     6912         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     6913         assign
     6914           v-diasize-wndmax = false
     6915         .
     6916         if connected("ub") = true
     6917         then do:
     6918           define variable v-cntxt-db-num        as integer   no-undo .
     6919           define variable v-cntxt-userid        as character no-undo .
     6920           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6921                                             , OUTPUT v-cntxt-userid
     6922                                             ) .
     6923           run gbl/wndpar_r.p
     6924             (input  v-cntxt-db-num
     6925             ,input  v-cntxt-userid
     6926             ,input  'wndmax':U
     6927             ,output v-diasize-wndmax
     6928             ,output v-default-value
     6929             ) .
     6930         end.
     6931         assign
     6932           v-diasize-wndstore = false
     6933         .
     6934         if connected("ub") = true
     6935         then do:
     6936           run gbl/wndpar_r.p
     6937             (input  v-cntxt-db-num
     6938             ,input  v-cntxt-userid
     6939             ,input  'wndstore':U
     6940             ,output v-diasize-wndstore
     6941             ,output v-default-value
     6942             ) .
     6943         end.
     6944         assign
     6945           v-diasize-proc-name = entry(1, program-name(2), '.')
     6946         .
     6947         if v-diasize-wndstore = true
     6948         then do:
     6949           assign
     6950             v-restore-saved = false
     6951           .
     6952           if connected("ub") = true
     6953           then do:
     6954             run gbl/wndsizer.p
     6955               (input  v-cntxt-db-num
     6956               ,input  v-cntxt-userid
     6957               ,input  v-diasize-proc-name
     6958               ,input  'height':u
     6959               ,output v-resize-value-str
     6960               ) .
     6961             if v-resize-value-str <> '':U
     6962             then do:
     6963               run diasize_change-height in this-procedure
     6964                 (input  integer(v-resize-value-str)
     6965                 ,input  true
     6966                 ) .
     6967               assign
     6968                 v-restore-saved = true
     6969               .
     6970             end.
     6971           end.
     6972           if connected("ub") = true
     6973           then do:
     6974             run gbl/wndsizer.p
     6975               (input  v-cntxt-db-num
     6976               ,input  v-cntxt-userid
     6977               ,input  v-diasize-proc-name
     6978               ,input  'width':u
     6979               ,output v-resize-value-str
     6980               ) .
     6981             if v-resize-value-str <> '':U
     6982             then do:
     6983               run diasize_change-width in this-procedure
     6984                 (input  integer(v-resize-value-str)
     6985                 ,input  true
     6986                 ) .
     6987               assign
     6988                 v-restore-saved = true
     6989               .
     6990             end.
     6991           end.
     6992           if v-restore-saved <> true
     6993           then do:
     6994             if v-diasize-wndmax = true
     6995             then do:
     6996               run diasize_maximize in this-procedure
     6997                 (input  true
     6998                 ) .
     6999             end.
     7000           end.
     7001         end.
     7002         else do:
     7003           if v-diasize-wndmax = true
     7004           then do:
     7005             run diasize_maximize in this-procedure
     7006               (input  true
     7007               ) .
     7008           end.
     7009         end.
     7010       end.
     7011     end.
     7012   end procedure.
     7013   procedure diasize_need-full-display :
     7014     define output parameter p-need-full-display as logical   no-undo .
     7015     do
     7016     on error undo, return error return-value
     7017     :
     7018       assign
     7019         p-need-full-display = v-diasize-need-full-display
     7020       .
     7021       assign
     7022         v-diasize-need-full-display = false
     7023       .
     7024     end.
     7025   end procedure.
     7026   procedure get-context :
     7027      define output parameter p-db-num as integer          no-undo.
     7028      define output parameter p-user-id as character        no-undo.
     7029      define variable v-login               as character    no-undo.
     7030      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     7031      define buffer buf_user-login  for ub.user-login .
     7032      do
     7033      on error undo, return error
     7034      :
     7035            FIND FIRST buf_sys-ctrl no-lock.
     7036            ASSIGN
     7037               v-login = USERID("ub")
     7038               p-db-num = buf_sys-ctrl.db-num
     7039            .
     7040            FIND FIRST buf_user-login
     7041                 WHERE buf_user-login.db-num = p-db-num
     7042                   AND buf_user-login.user-login = v-login
     7043                 no-lock
     7044                 no-error
     7045                 .
     7046            IF AVAILABLE buf_user-login
     7047            THEN DO:
     7048               assign
     7049                  p-user-id = buf_user-login.user-id
     7050               .
     7051            END.
     7052      end.
     7053   end procedure.
     7054       run diasize_init in this-procedure .
