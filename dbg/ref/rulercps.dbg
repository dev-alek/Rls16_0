     1243   CALL_tt-rule-call-param.ruleset_id  COLUMN-LABEL "Набор"
     1244   CALL_tt-rule-call-param.order_id    COLUMN-LABEL "Порядок!вызова"
     1245   CALL_tt-rule-call-param.rule_id    COLUMN-LABEL "Правило"
     1246       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7 FIT-LAST-COLUMN
     1247       title "Правила, в которых применяются параметры"   .
     1248   DEFINE BROWSE BR-rcp
     1249     QUERY BR-rcp DISPLAY
     1250         X_rp-rule-param.rp-param-name COLUMN-LABEL "Название пар-ра!профайла" FORMAT "X(20)" width 16
     1251   term_tt-rule-call-param.codex_id COLUMN-LABEL "Кодекс"
     1252   term_tt-rule-call-param.ruleset_id COLUMN-LABEL "Набор"
     1253   term_tt-rule-call-param.order_id  COLUMN-LABEL "Порядок!вызова"
     1254   term_tt-rule-call-param.rule_id  COLUMN-LABEL "Правило"
     1255   term_tt-rule-call-param.profile_id  COLUMN-LABEL "Профайл"
     1256   term_tt-rule-call-param.once-more COLUMN-LABEL "№!Привязки"
     1257   (if lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U) > 0 then entry (lookup (term_tt-rule-call-param.param-data-type, 'character,date,datetime,datetime-tz,decimal,integer,void,logical,memptr,raw,recid,rowid,widget-handle,handle,blob,clob,class,com-handle,longchar,int64':U), 'строка,дата,дата-время,дата-время-з,десятичное,целое,пусто,логическое,память,двоичные,номер записи,Номер Записи,ссылка,ссылка,Больш.бин.объект,Больш.стр.объект,Объект,COM-объект,Длинная строка,64Целое':U) else term_tt-rule-call-param.param-data-type) COLUMN-LABEL "Тип пар-ра" FORMAT "X(12)"
     1258   term_tt-rule-call-param.param-num COLUMN-LABEL "№!пар-ра" FORMAT ">9"
     1259   TERM_tt-rule-call-param.p-index COLUMN-LABEL "Инд!екс" FORMAT ">>9"
     1260   term_tt-rule-call-param.param-name COLUMN-LABEL "Название пар-ра!правила" FORMAT "X(16)"
     1261   term_tt-rule-call-param.param-label COLUMN-LABEL "Название пар-ра" FORMAT "X(255)" WIDTH 30
     1262   entry (lookup (term_tt-rule-call-param.param-mode, 'input,output,input-output,buffer,input table,output table,input-output table':u), 'вх,вых,вх-вых,курсор,вх табл,вых табл,вх/вых табл':u) COLUMN-LABEL "Вид!пар-ра"
     1263   get-param-value( INPUT term_tt-rule-call-param.param-data-type
     1264                   ,INPUT term_tt-rule-call-param.param-2-data-type
     1265                   ,INPUT term_tt-rule-call-param.param-3-data-type
     1266                   ,INPUT TERM_tt-rule-call-param.p-index
     1267                   ,INPUT term_tt-rule-call-param.param-value-character
     1268                   ,INPUT term_tt-rule-call-param.param-value-date
     1269                   ,INPUT term_tt-rule-call-param.param-value-decimal
     1270                   ,INPUT term_tt-rule-call-param.param-value-integer
     1271                   ,INPUT term_tt-rule-call-param.param-value-logical) COLUMN-LABEL "Значение" FORMAT "X(255)" WIDTH 26
     1272   (IF term_tt-rule-call-param.param-data-type = 'character':U
     1273    THEN term_tt-rule-call-param.param-value-character
     1274    ELSE '':U) COLUMN-LABEL "Значение!(строковое)" FORMAT "X(26)"
     1275   (IF term_tt-rule-call-param.param-data-type = 'date':U
     1276   THEN STRING(term_tt-rule-call-param.param-value-date, "99/99/9999")
     1277   ELSE '':U)    COLUMN-LABEL "Значение!(Дата)" FORMAT "X(10)" WIDTH 12
     1278   (IF term_tt-rule-call-param.param-data-type = 'decimal':U
     1279   THEN STRING(term_tt-rule-call-param.param-value-decimal)
     1280   ELSE '':U) COLUMN-LABEL "Значение!(Десятичное)"   FORMAT "X(16)"
     1281   (IF term_tt-rule-call-param.param-data-type = 'integer':U
     1282   THEN STRING(term_tt-rule-call-param.param-value-integer)
     1283   ELSE '':U) COLUMN-LABEL "Значение!(Целое)" FORMAT "X(10)"
     1284   (IF term_tt-rule-call-param.param-data-type = 'logical':U
     1285   THEN STRING(term_tt-rule-call-param.param-value-logical, "+/-")
     1286   ELSE '':U) COLUMN-LABEL "Значение!(Логическое)" FORMAT "X(2)"
     1287   calldscr(tt-rule-call-param.call_id) COLUMN-LABEL  "Точка вызова" FORMAT "X(40)"
     1288       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16
     1289            FONT 4 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
     1290   DEFINE FRAME Dialog-Frame
     1291        B-exit AT ROW 1 COL 1
     1292        b-quit AT ROW 1 COL 11
     1293        b-add AT ROW 1 COL 28 WIDGET-ID 10
     1294        b-chg AT ROW 1 COL 38 WIDGET-ID 6
     1295        b-del AT ROW 1 COL 48 WIDGET-ID 12
     1296        b-lkp AT ROW 1 COL 58 WIDGET-ID 8
     1297        b-rule AT ROW 1 COL 68 WIDGET-ID 14
     1298        b-ruleset AT ROW 1 COL 78 WIDGET-ID 16
     1299        b-set AT ROW 1 COL 92 WIDGET-ID 18
     1300        B-Help AT ROW 1 COL 95
     1301        BR-rcp AT ROW 3 COL 1 WIDGET-ID 100
     1302        BR-callee AT ROW 12 COL 1 WIDGET-ID 200
     1303        E-rule-name AT ROW 19 COL 1 NO-LABEL WIDGET-ID 2
     1304        E-param-des AT ROW 21.2 COL 1 NO-LABEL WIDGET-ID 4
     1305        SPACE(0.00) SKIP(0.04)
     1306       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1307            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1308            TITLE ""
     1309            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1310   ASSIGN
     1311          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1312          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1313   ASSIGN
     1314          b-rule:HIDDEN IN FRAME Dialog-Frame           = TRUE
     1315          b-rule:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-rule:HANDLE.
     1316   ASSIGN
     1317          b-ruleset:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1318   ASSIGN
     1319          E-param-des:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1320   ASSIGN
     1321          E-rule-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1322   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1323   DO:
     1324     APPLY "END-ERROR":U TO SELF.
     1325   END.
     1326   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1327   DO:
     1328     RUN proc-b-add IN THIS-PROCEDURE NO-ERROR.
     1329     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1330   END.
     1331   ON CHOOSE OF b-set IN FRAME Dialog-Frame
     1332   DO:
     1333     RUN proc-b-set IN THIS-PROCEDURE NO-ERROR.
     1334     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1335   END.
     1336   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1337   DO:
     1338     RUN proc-b-chg IN THIS-PROCEDURE NO-ERROR.
     1339     IF NOT ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1340   END.
     1341   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1342   DO:
     1343       RUN proc-b-del IN THIS-PROCEDURE NO-ERROR.
     1344     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1345   END.
     1346   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1347   DO:
     1348     RUN rcps_proc-save0 IN THIS-PROCEDURE  NO-ERROR.
     1349     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1350   END.
     1351   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1352   DO:
     1353    if term_tt-rule-call-param.p-index = 0
     1354    and (lookup("LIST", term_tt-rule-call-param.param-3-data-type) > 0
     1355    or lookup("SORTED-LIST", term_tt-rule-call-param.param-3-data-type) > 0)
     1356    then do:
     1357      message
     1358      "Это шапка Параметра типа СПИСОК, не содержащая реального значения" skip
     1359      "просмотр невозможен"
     1360      view-as alert-box error .
     1361      return no-apply.
     1362    end.
     1363    RUN proc-b-lkp IN this-procedure NO-ERROR.
     1364    IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1365   END.
     1366   ON CHOOSE OF b-rule IN FRAME Dialog-Frame
     1367   DO:
     1368       IF NOT AVAILABLE CALL_tt-rule-call-param THEN RETURN NO-APPLY.
     1369     IF rule-display-option = "" THEN DO:
     1370      run gbl/pop-up.p ( input self:handle, input no) no-error.
     1371     END.
     1372     IF rule-display-option = "" THEN DO:
     1373       RETURN NO-APPLY.
     1374     END.
     1375     RUN proc-display-rule IN THIS-PROCEDURE (
     1376                                                INPUT rule-display-option
     1377                                               ,input CALL_tt-rule-call-param.codex_id
     1378                                               ,input CALL_tt-rule-call-param.ruleset_id
     1379                                               ,input CALL_tt-rule-call-param.call_id
     1380                                               ,input CALL_tt-rule-call-param.order_id
     1381                                               ,INPUT CALL_tt-rule-call-param.rule_id) NO-ERROR.
     1382     IF ERROR-STATUS:ERROR THEN DO:
     1383       ASSIGN
     1384       rule-display-option = "".
     1385       RETURN NO-APPLY.
     1386     END.
     1387     ASSIGN
     1388     rule-display-option = "".
     1389   END.
     1390   ON CHOOSE OF b-ruleset IN FRAME Dialog-Frame
     1391   DO:
     1392     DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     1393   define buffer buf_ruleset for ub.ruleset.
     1394     IF NOT AVAILABLe CALL_tt-rule-call-param THEN DO:
     1395         RETURN NO-APPLY.
     1396     END.
     1397     FIND FIRST buf_ruleset NO-LOCK WHERE
     1398               buf_ruleset.codex_id = CALL_tt-rule-call-param.codex_id
     1399           AND buf_ruleset.ruleset_id = CALL_tt-rule-call-param.ruleset_id.
     1400     run rul/ruleset-i.w ( input parparentproc
     1401                          ,input 'ПРОСМОТР':U
     1402                          ,input buf_ruleset.codex_id
     1403                          ,input buf_ruleset.ruleset_id
     1404                          ,input-output v-rec) no-error.
     1405   END.
     1406   ON VALUE-CHANGED OF BR-rcp IN FRAME Dialog-Frame
     1407   DO:
     1408     RUN OpenbrCAllee IN THIS-PROCEDURE.
     1409     IF NOT AVAILABLE tt-rule-call-param THEN DO:
     1410        ASSIGN
     1411        e-rule-name:SCREEN-VALUE = '':U
     1412        e-param-des:SCREEN-VALUE = '':U
     1413        .
     1414        DISABLE
     1415        b-add
     1416        b-set
     1417        b-chg
     1418        b-del
     1419        with FRAME Dialog-Frame.
     1420   ENABLE
     1421         b-set
     1422         b-add
     1423         WITH FRAME Dialog-Frame.
     1424     END.
     1425     ELSE DO:
     1426       find first X_rule no-lock where
     1427               X_rule.rule_id = term_tt-rule-call-param.rule_id no-error.
     1428        ASSIGN
     1429        e-rule-name:SCREEN-VALUE = (if available X_rule then X_rule.name else "<ПРАВИЛО НЕ НАЙДЕНО>").
     1430        ASSIGN
     1431        e-param-des:SCREEN-VALUE = term_tt-rule-call-param.param-des.
     1432       IF term_tt-rule-call-param.param-2-data-type <> '':U
     1433       and not ((lookup("LIST", term_tt-rule-call-param.param-3-data-type) > 0
     1434                or
     1435                lookup("SORTED-LIST", term_tt-rule-call-param.param-3-data-type) > 0
     1436                )
     1437                and
     1438                term_tt-rule-call-param.p-index = 0)
     1439       THEN DO:
     1440          ENABLE
     1441          b-lkp WITH FRAME Dialog-Frame.
     1442       END.
     1443       ELSE DO:
     1444           disable
     1445           b-lkp WITH FRAME Dialog-Frame.
     1446       END.
     1447       IF (p-mode = 'ДОБАВЛЕНИЕ':U
     1448       OR p-mode = 'ИЗМЕНЕНИЕ':U)
     1449       and lookup("b-chg", bttns) > 0
     1450       AND (lookup("LIST", term_tt-rule-call-param.param-3-data-type) > 0
     1451            or
     1452            lookup("SORTED-LIST", term_tt-rule-call-param.param-3-data-type) > 0
     1453            )
     1454       AND term_tt-rule-call-param.p-index = 0 THEN DO:
     1455         ENABLE
     1456         b-add
     1457         b-set
     1458         WITH FRAME Dialog-Frame.
     1459         disable
     1460         b-chg
     1461         b-del
     1462         WITH FRAME Dialog-Frame.
     1463       END.
     1464       IF (p-mode = 'ДОБАВЛЕНИЕ':U
     1465       OR p-mode = 'ИЗМЕНЕНИЕ':U)
     1466       and lookup("b-chg", bttns) > 0
     1467       AND not ((lookup("LIST", term_tt-rule-call-param.param-3-data-type) > 0
     1468                 or
     1469                 lookup("SORTED-LIST", term_tt-rule-call-param.param-3-data-type) > 0
     1470                 )
     1471       AND term_tt-rule-call-param.p-index = 0 ) THEN DO:
     1472         disable
     1473         b-add
     1474         b-set
     1475         WITH FRAME Dialog-Frame.
     1476         enable
     1477         b-chg
     1478         b-del
     1479         WITH FRAME Dialog-Frame.
     1480   ENABLE
     1481         b-add
     1482         b-set
     1483         WITH FRAME Dialog-Frame.
     1484       END.
     1485     END.
     1486   END.
     1487   ON CHOOSE OF MENU-ITEM m_graph
     1488   DO:
     1489         IF NOT AVAILABLE CALL_tt-rule-call-param THEN RETURN NO-APPLY.
     1490     ASSIGN
     1491     rule-display-option = "graph".
     1492     RUN proc-display-rule IN THIS-PROCEDURE (  INPUT rule-display-option
     1493                                               ,INPUT CALL_tt-rule-call-param.codex_id
     1494                                               ,INPUT CALL_tt-rule-call-param.ruleset_id
     1495                                               ,INPUT CALL_tt-rule-call-param.call_id
     1496                                               ,INPUT CALL_tt-rule-call-param.order_id
     1497                                               ,INPUT CALL_tt-rule-call-param.rule_id) NO-ERROR.
     1498     ASSIGN
     1499     rule-display-option = "".
     1500   END.
     1501   ON CHOOSE OF MENU-ITEM m_text
     1502   DO:
     1503       IF NOT AVAILABLE CALL_tt-rule-call-param THEN RETURN NO-APPLY.
     1504      ASSIGN
     1505      rule-display-option = "text".
     1506      RUN proc-display-rule IN THIS-PROCEDURE (  INPUT rule-display-option
     1507                                                ,INPUT CALL_tt-rule-call-param.codex_id
     1508                                                ,INPUT CALL_tt-rule-call-param.ruleset_id
     1509                                                ,INPUT CALL_tt-rule-call-param.call_id
     1510                                                ,INPUT CALL_tt-rule-call-param.order_id
     1511                                                ,INPUT CALL_tt-rule-call-param.rule_id) NO-ERROR.
     1512      ASSIGN
     1513      rule-display-option = "".
     1514   END.
     1515   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1516   procedure rcps_get-profile-id :
     1517   define output parameter p-local-profile-id as integer no-undo .
     1518   do
     1519   on error undo, return error:
     1520   p-local-profile-id = p-profile-id.
     1521   end.
     1522   end procedure.
     1523   PROCEDURE rcps_fill-table :
     1524   define input parameter p-clear-params as logical no-undo .
     1525   if p-clear-params then do:
     1526   FOR EACH tt-rule-call-param:
     1527       DELETE tt-rule-call-param.
     1528   END.
     1529   end.
     1530    FOR EACH tt0-rule-call-param:
     1531      IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     1532        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     1533           NEXT.
     1534        end.
     1535        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     1536          NEXT.
     1537        end.
     1538        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     1539          NEXT.
     1540        end.
     1541        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     1542          NEXT.
     1543        end.
     1544        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     1545          NEXT.
     1546        end.
     1547      END.
     1548      if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then do:
     1549        next.
     1550      end.
     1551      IF p-list-mode = 'rp-rule-param':U
     1552      or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     1553      THEN DO:
     1554         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     1555           NEXT.
     1556         end.
     1557         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     1558           NEXT.
     1559         end.
     1560      END.
     1561      CREATE tt-rule-call-param.
     1562      BUFFER-COPY tt0-rule-call-param TO tt-rule-call-param.
     1563   END.
     1564   END PROCEDURE.
     1565   procedure rcps_get-value :
     1566   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     1567   DEFINE INPUT-output PARAMETER pp-index AS integer NO-UNDO.
     1568   DEFINE output parameter p-value-character AS CHARACTER NO-UNDO.
     1569   DEFINE output parameter p-value-date AS date NO-UNDO.
     1570   DEFINE output parameter p-value-decimal AS decimal NO-UNDO.
     1571   DEFINE output parameter p-value-integer AS integer NO-UNDO.
     1572   DEFINE output parameter p-value-logical AS logical NO-UNDO.
     1573   define variable v-current-index as integer no-undo init -1.
     1574   define variable v-start as logical no-undo init yes.
     1575   DEFINE BUFFER buf_ruledict-param FOR ub.ruledict-param.
     1576   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     1577   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     1578   DEFINE BUFFER buf_term_tt-rule-call-param FOR tt-rule-call-param.
     1579   do
     1580   on error undo, return error
     1581   :
     1582   FOR FIRST buf_rp-rule-param WHERE
     1583         buf_rp-rule-param.profile_id = p-profile-id
     1584     AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1585   , each buf_tt-rule-call-param WHERE
     1586      buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1587   AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1588   AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1589   AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1590   AND buf_tt-rule-call-param.p-index >= pp-index
     1591    ,each buf_term_tt-rule-call-param where
     1592          buf_term_tt-rule-call-param.call_id = buf_tt-rule-call-param.call_id
     1593      and buf_term_tt-rule-call-param.codex_id = buf_tt-rule-call-param.codex_id
     1594      and buf_term_tt-rule-call-param.ruleset_id = buf_tt-rule-call-param.ruleset_id
     1595      and buf_term_tt-rule-call-param.order_id = buf_tt-rule-call-param.order_id
     1596      and buf_term_tt-rule-call-param.param-name = buf_tt-rule-call-param.param-name
     1597      and buf_term_tt-rule-call-param.p-index = buf_tt-rule-call-param.p-index
     1598     by buf_term_tt-rule-call-param.call_id
     1599     by buf_term_tt-rule-call-param.codex_id
     1600     by buf_term_tt-rule-call-param.ruleset_id
     1601     by buf_term_tt-rule-call-param.order_id
     1602     by buf_term_tt-rule-call-param.param-name
     1603     by buf_term_tt-rule-call-param.p-index :
     1604       if v-start
     1605       then do:
     1606         assign
     1607         pp-index = buf_term_tt-rule-call-param.p-index
     1608         p-value-character = buf_term_tt-rule-call-param.param-value-character
     1609         p-value-date      = buf_term_tt-rule-call-param.param-value-date
     1610         p-value-decimal   = buf_term_tt-rule-call-param.param-value-decimal
     1611         p-value-integer   = buf_term_tt-rule-call-param.param-value-integer
     1612         p-value-logical   = buf_term_tt-rule-call-param.param-value-logical
     1613         v-start = no
     1614         .
     1615       end.
     1616       else do:
     1617         if buf_term_tt-rule-call-param.p-index > pp-index then do:
     1618           v-current-index = buf_term_tt-rule-call-param.p-index.
     1619           leave.
     1620         end.
     1621             end.
     1622     end.
     1623     pp-index = v-current-index.
     1624   end.
     1625   end procedure.
     1626   PROCEDURE rcps_proc-b-add :
     1627   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     1628   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     1629   define variable v-ind as integer no-undo .
     1630   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     1631   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     1632   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     1633   define buffer buf_rp-rule-param for ub.rp-rule-param.
     1634   FOR FIRST buf_rp-rule-param WHERE
     1635             buf_rp-rule-param.profile_id = p-profile-id
     1636         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1637       , first buf0_tt-rule-call-param WHERE
     1638          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1639      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1640      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1641      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     1642     LEAVE.
     1643   END.
     1644   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     1645     BELL.
     1646     RETURN.
     1647   END.
     1648   for each buf_rp-rule-param where
     1649           buf_rp-rule-param.rp-param-name = p-rp-param-name
     1650       and buf_rp-rule-param.profile_id = p-profile-id,
     1651       first buf_tt-rule-call-param where
     1652           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     1653       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     1654       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1655       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1656       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1657       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1658       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     1659       and buf_tt-rule-call-param.p-index = p-index:
     1660     RETURN.
     1661   END.
     1662   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     1663   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     1664   THEN DO:
     1665     BELL.
     1666     RETURN.
     1667   END.
     1668   IF buf0_tt-rule-call-param.p-index <> 0 THEN DO:
     1669     BELL.
     1670     RETURN.
     1671   END.
     1672   find last buf_tt-rule-call-param where
     1673            buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     1674        and buf_tt-rule-call-param.codex_id = buf0_tt-rule-call-param.codex_id
     1675        and buf_tt-rule-call-param.ruleset_id = buf0_tt-rule-call-param.ruleset_id
     1676        and buf_tt-rule-call-param.order_id = buf0_tt-rule-call-param.order_id
     1677        and buf_tt-rule-call-param.param-name = buf0_tt-rule-call-param.param-name no-error .
     1678   if available buf_tt-rule-call-param
     1679   and (lookup("LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     1680        or
     1681        lookup("SORTED-LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     1682        )
     1683   and buf_tt-rule-call-param.p-index > 0 then do:
     1684     v-ind = buf_tt-rule-call-param.p-index.
     1685   end.
     1686   for each buf_rp-rule-param where
     1687           buf_rp-rule-param.rp-param-name = p-rp-param-name
     1688       and buf_rp-rule-param.profile_id = p-profile-id,
     1689       first buf_tt-rule-call-param where
     1690           buf_tt-rule-call-param.call_id = buf0_tt-rule-call-param.call_id
     1691       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     1692       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1693       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1694       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1695       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1696       and buf_tt-rule-call-param.once-more = buf0_tt-rule-call-param.once-more
     1697       and buf_tt-rule-call-param.p-index = 0
     1698   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1699   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1700   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     1701   :
     1702     create buf2_tt-rule-call-param.
     1703     buffer-copy buf_tt-rule-call-param
     1704     except p-index
     1705     to buf2_tt-rule-call-param
     1706     assign
     1707     buf2_tt-rule-call-param.p-index = v-ind + 1
     1708     .
     1709   end.
     1710   END PROCEDURE.
     1711   PROCEDURE rcps_proc-b-del :
     1712   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     1713   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     1714   define variable v-ind as integer no-undo .
     1715   define variable v-once-more as integer no-undo .
     1716   define variable v-call-id as character no-undo .
     1717   define buffer buf0_tt-rule-call-param for tt-rule-call-param.
     1718   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     1719   define buffer buf_rp-rule-param for ub.rp-rule-param.
     1720   if pp-index = 0 then do:
     1721     undo, return error substitute("Нельзя удалять корневой параметр &1 (индекс = 0)", p-rp-param-name).
     1722   end.
     1723   FOR first buf_rp-rule-param WHERE
     1724             buf_rp-rule-param.profile_id = p-profile-id
     1725         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1726       , first buf0_tt-rule-call-param WHERE
     1727          buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1728      AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1729      AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1730      AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1731      AND buf0_tt-rule-call-param.p-index = pp-index
     1732      :
     1733     LEAVE.
     1734   END.
     1735   IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     1736     FOR first buf_rp-rule-param WHERE
     1737               buf_rp-rule-param.profile_id = p-profile-id
     1738           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1739         , last buf0_tt-rule-call-param WHERE
     1740           buf0_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1741       AND buf0_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1742       AND buf0_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1743       AND buf0_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1744       AND buf0_tt-rule-call-param.p-index > pp-index :
     1745       leave.
     1746     end.
     1747     IF NOT AVAILABLE buf0_tt-rule-call-param THEN do:
     1748     return "not-found".
     1749     end.
     1750     else do:
     1751       return ''.
     1752     end.
     1753   END.
     1754   IF lookup("LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     1755   and lookup("SORTED-LIST", buf0_tt-rule-call-param.param-3-data-type) = 0
     1756   THEN DO:
     1757     undo, return error substitute("Можно удалять только параметры типа LIST и SORTED-LIST").
     1758   END.
     1759   IF lookup("READ-ONLY", buf0_tt-rule-call-param.param-3-data-type) > 0 THEN DO:
     1760     undo, return error substitute("Нельзя удалять  параметры типа READ-ONLY").
     1761   END.
     1762   for each buf_rp-rule-param where
     1763           buf_rp-rule-param.rp-param-name = buf_rp-rule-param.rp-param-name
     1764       and buf_rp-rule-param.profile_id = buf_rp-rule-param.profile_id,
     1765       each buf_tt-rule-call-param where
     1766           buf_tt-rule-call-param.call_id = p-call-id
     1767       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     1768       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1769       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1770       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1771       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1772       and buf_tt-rule-call-param.once-more = p-once-more
     1773       and buf_tt-rule-call-param.p-index = pp-index
     1774   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1775   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     1776   on endkey undo, return error substitute( "&1. endkey", vss-workfile ):
     1777       DELETE buf_tt-rule-call-param.
     1778   end.
     1779   return ''.
     1780   END PROCEDURE.
     1781   PROCEDURE rcps_proc-save0 :
     1782   FOR EACH tt-rule-call-param
     1783   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1784   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1785   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1786   :
     1787      find  FIRST tt0-rule-call-param NO-LOCK WHERE
     1788               tt0-rule-call-param.codex_id = tt-rule-call-param.codex_id
     1789          AND  tt0-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     1790          AND tt0-rule-call-param.call_id = tt-rule-call-param.call_id
     1791          AND tt0-rule-call-param.order_id = tt-rule-call-param.order_id
     1792          AND tt0-rule-call-param.param-name = tt-rule-call-param.param-name
     1793          AND tt0-rule-call-param.p-index = tt-rule-call-param.p-index no-error .
     1794      if not available tt0-rule-call-param
     1795      and (lookup("LIST", tt-rule-call-param.param-3-data-type) > 0
     1796           OR
     1797           lookup("SORTED-LIST", tt-rule-call-param.param-3-data-type) > 0
     1798           )
     1799      and tt-rule-call-param.p-index > 0 then do:
     1800        create tt0-rule-call-param.
     1801      end.
     1802      BUFFER-COPY tt-rule-call-param TO tt0-rule-call-param.
     1803   END.
     1804   FOR EACH tt0-rule-call-param
     1805   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1806   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1807   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1808   :
     1809     if tt0-rule-call-param.p-index = 0 then next.
     1810     if lookup("hidden", tt0-rule-call-param.param-3-data-type) > 0 then next.
     1811     find  FIRST tt-rule-call-param NO-LOCK WHERE
     1812             tt-rule-call-param.codex_id = tt0-rule-call-param.codex_id
     1813         AND tt-rule-call-param.ruleset_id = tt0-rule-call-param.ruleset_id
     1814         AND tt-rule-call-param.call_id = tt0-rule-call-param.call_id
     1815         AND tt-rule-call-param.order_id = tt0-rule-call-param.order_id
     1816         AND tt-rule-call-param.param-name = tt0-rule-call-param.param-name
     1817         AND tt-rule-call-param.p-index = tt0-rule-call-param.p-index no-error .
     1818     if not available tt-rule-call-param
     1819     and (lookup("LIST", tt0-rule-call-param.param-3-data-type) > 0
     1820         OR
     1821         lookup("SORTED-LIST", tt0-rule-call-param.param-3-data-type) > 0
     1822         )
     1823     and tt0-rule-call-param.p-index > 0
     1824     then do:
     1825        IF p-call-id <> '':U and p-call-id <> tt0-rule-call-param.call_id THEN do:
     1826           NEXT.
     1827        end.
     1828        IF p-codex-id <> 0 and p-codex-id <> tt0-rule-call-param.codex_id THEN do:
     1829          NEXT.
     1830        end.
     1831        IF p-ruleset-id <> 0 and p-ruleset-id <> tt0-rule-call-param.ruleset_id THEN do:
     1832          NEXT.
     1833        end.
     1834        IF p-rule-id <> 0 and p-rule-id <> tt0-rule-call-param.RULE_id THEN do:
     1835          NEXT.
     1836        end.
     1837        IF p-order-id <> ? and p-order-id <> tt0-rule-call-param.order_id THEN do:
     1838          NEXT.
     1839        end.
     1840       IF p-list-mode = 'rp-rule-param':U
     1841       or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     1842       THEN DO:
     1843         IF p-profile-id <> 0 AND p-profile-id <> tt0-rule-call-param.profile_id THEN do:
     1844           NEXT.
     1845         end.
     1846         IF p-once-more <> ? AND p-once-more <> tt0-rule-call-param.once-more THEN do:
     1847           NEXT.
     1848         end.
     1849       end.
     1850       delete tt0-rule-call-param.
     1851     end.
     1852   end.
     1853   END PROCEDURE.
     1854   PROCEDURE rcps_set-value :
     1855   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     1856   DEFINE INPUT PARAMETER pp-index AS integer NO-UNDO.
     1857   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     1858   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     1859   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     1860   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     1861   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     1862   DEFINE VARIABLE v-codex-id AS integer NO-UNDO.
     1863   DEFINE VARIABLE v-ruleset-id AS integer NO-UNDO.
     1864   DEFINE VARIABLE v-order-id AS integer NO-UNDO.
     1865   DEFINE VARIABLE V-param-name AS character NO-UNDO.
     1866   define variable v-found as logical no-undo .
     1867   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     1868   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     1869   FOR FIRST buf_rp-rule-param WHERE
     1870             buf_rp-rule-param.profile_id = p-profile-id
     1871         AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1872       , first buf_tt-rule-call-param WHERE
     1873          buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1874      AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1875      AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1876      AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name:
     1877     ASSIGN
     1878     v-codex-id = buf_tt-rule-call-param.codex_id
     1879     v-ruleset-id = buf_tt-rule-call-param.ruleset_id
     1880     v-order-id = buf_tt-rule-call-param.order_id
     1881     V-PARAM-NAME = buf_tt-rule-call-param.PARAM-NAME
     1882     .
     1883     LEAVE.
     1884   END.
     1885   CASE p-list-mode:
     1886     WHEN 'rp-rule-param':U THEN DO:
     1887       if pp-index > 0
     1888       then do:
     1889         FOR EACH  buf_rp-rule-param NO-LOCK where
     1890             buf_rp-rule-param.profile_id = p-profile-id
     1891             AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1892             ,EACH buf_tt-rule-call-param WHERE
     1893                 buf_tt-rule-call-param.profile_id = p-profile-id
     1894             AND buf_tt-rule-call-param.once-more = p-once-more
     1895             AND buf_tt-rule-call-param.call_id = p-CALL-id
     1896             AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1897             AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1898             AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1899             AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1900             AND buf_tt-rule-call-param.p-index = pp-index
     1901         ON error undo, return error :
     1902           v-found = yes.
     1903         end.
     1904       end.
     1905       if not v-found then do:
     1906         run rcps_proc-b-add in this-procedure (
     1907                                                  input p-rp-param-name
     1908                                                 ,input pp-index).
     1909       end.
     1910       FOR EACH  buf_rp-rule-param NO-LOCK where
     1911           buf_rp-rule-param.profile_id = p-profile-id
     1912           AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     1913           ,EACH buf_tt-rule-call-param WHERE
     1914               buf_tt-rule-call-param.profile_id = p-profile-id
     1915           AND buf_tt-rule-call-param.once-more = p-once-more
     1916           AND buf_tt-rule-call-param.call_id = p-CALL-id
     1917           AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     1918           AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     1919           AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     1920           AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     1921           AND buf_tt-rule-call-param.p-index = pp-index
     1922         ON error undo, return error :
     1923         assign
     1924         buf_tt-rule-call-param.param-value-character = p-value-character
     1925         buf_tt-rule-call-param.param-value-date      = p-value-date
     1926         buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     1927         buf_tt-rule-call-param.param-value-integer   = p-value-integer
     1928         buf_tt-rule-call-param.param-value-logical   = p-value-logical
     1929         .
     1930       END.
     1931     END.
     1932     WHEN 'rule-call-param':U THEN DO:
     1933       FIND FIRST buf_tt-rule-call-param WHERE
     1934           buf_tt-rule-call-param.call_id = p-call-id
     1935       AND buf_tt-rule-call-param.codex_id = v-codex-id
     1936       AND buf_tt-rule-call-param.ruleset_id = v-ruleset-id
     1937       AND buf_tt-rule-call-param.order_id = v-order-id
     1938       AND buf_tt-rule-call-param.param-name = V-PARAM-NAME
     1939       AND buf_tt-rule-call-param.p-index = pp-index.
     1940       assign
     1941       buf_tt-rule-call-param.param-value-character = p-value-character
     1942       buf_tt-rule-call-param.param-value-date      = p-value-date
     1943       buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     1944       buf_tt-rule-call-param.param-value-integer   = p-value-integer
     1945       buf_tt-rule-call-param.param-value-logical   = p-value-logical
     1946       .
     1947     END.
     1948   END CASE.
     1949   END PROCEDURE.
     1950   procedure rcps_get-rule-on-off :
     1951   define input parameter p-codex-id as integer no-undo .
     1952   define input parameter p-ruleset-id as integer no-undo .
     1953   define input parameter p-rule-id as integer no-undo .
     1954   define input parameter p-profile-id as integer no-undo .
     1955   define input parameter p-once-more as integer no-undo .
     1956   define output parameter p-on-off as logical no-undo .
     1957   if valid-handle(p-call-handle)
     1958   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     1959     run rcpscont_get-rule-on-off in p-call-handle (
     1960                                              input p-codex-id
     1961                                             ,input p-ruleset-id
     1962                                             ,input p-rule-id
     1963                                             ,input p-profile-id
     1964                                             ,input p-once-more
     1965                                             ,output p-on-off) no-error.
     1966   end.
     1967   end procedure.
     1968   procedure rcps_set-rule-on-off :
     1969   define input parameter p-codex-id as integer no-undo .
     1970   define input parameter p-ruleset-id as integer no-undo .
     1971   define input parameter p-rule-id as integer no-undo .
     1972   define input parameter p-profile-id as integer no-undo .
     1973   define input parameter p-once-more as integer no-undo .
     1974   define input parameter p-on-off as logical no-undo .
     1975   if valid-handle(p-call-handle)
     1976   and lookup("rcpscont_get-rule-on-off", p-call-handle:internal-entries) > 0 then do:
     1977     run rcpscont_set-rule-on-off in p-call-handle (
     1978                                              input p-codex-id
     1979                                             ,input p-ruleset-id
     1980                                             ,input p-rule-id
     1981                                             ,input p-profile-id
     1982                                             ,input p-once-more
     1983                                             ,input p-on-off) no-error.
     1984   end.
     1985   end procedure.
     1986   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1987   PROCEDURE rcps_MyEnable0 :
     1988   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     1989   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     1990   ASSIGN
     1991   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     1992   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     1993   .
     1994   ASSIGN
     1995   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     1996   REPEAT WHILE valid-handle(v-ch0):
     1997      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     1998        v-ch[1] = v-ch0.
     1999        v-ch0:VISIBLE = NO.
     2000      END.
     2001      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     2002        v-ch[2] = v-ch0.
     2003        v-ch0:VISIBLE = NO.
     2004      END.
     2005      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     2006        v-ch[3] = v-ch0.
     2007        v-ch0:VISIBLE = NO.
     2008      END.
     2009      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     2010        v-ch[4] = v-ch0.
     2011        v-ch0:VISIBLE = NO.
     2012      END.
     2013      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     2014        v-ch[5] = v-ch0.
     2015        v-ch0:VISIBLE = NO.
     2016      END.
     2017      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     2018        v-ch[6] = v-ch0.
     2019      END.
     2020      IF v-ch0:LABEL = "Значение" THEN
     2021      v-ch0:RESIZABLE = YES.
     2022      v-ch0 = v-ch0:NEXT-COLUMN.
     2023   END.
     2024   assign
     2025   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     2026   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     2027   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     2028   .
     2029   CASE p-list-mode:
     2030     WHEN 'rule-call-param':U THEN DO:
     2031        ASSIGN
     2032        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     2033        .
     2034     END.
     2035     WHEN 'rp-rule-param':U
     2036     or
     2037     when 'rp-rule-param':U + chr(44) + 'все':U
     2038     THEN DO:
     2039       assign
     2040       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     2041       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     2042       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     2043       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     2044       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     2045       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     2046       .
     2047     END.
     2048   END CASE.
     2049    IF p-call-id <> '':U THEN DO:
     2050      v-ch[6]:VISIBLE = NO.
     2051    END.
     2052     IF p-profile-id <> 0 THEN DO:
     2053      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     2054    END.
     2055     IF p-rule-id <> 0 THEN DO:
     2056      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     2057    END.
     2058     IF p-once-more <> 0 THEN DO:
     2059      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     2060    END.
     2061   END PROCEDURE.
     2062   PROCEDURE rcps_Openbr :
     2063   CASE p-list-mode:
     2064     WHEN 'rp-rule-param':U THEN DO:
     2065         OPEN QUERY br-rcp
     2066         FOR EACH  X_ruledict-param NO-LOCK WHERE X_ruledict-param.entry-id = v-rcps-entry-id
     2067             ,FIRST X_rp-rule-param WHERE
     2068                 X_rp-rule-param.profile_id = p-profile-id
     2069             AND X_rp-rule-param.rp-param-name = X_ruledict-param.param-name
     2070           , first tt-rule-call-param WHERE
     2071              tt-rule-call-param.codex_id = X_rp-rule-param.codex_id
     2072          AND tt-rule-call-param.ruleset_id = X_rp-rule-param.ruleset_id
     2073          AND tt-rule-call-param.rule_id = X_rp-rule-param.rule_id
     2074          AND tt-rule-call-param.param-name = X_rp-rule-param.rule-param-name
     2075            ,each term_tt-rule-call-param where
     2076                  term_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     2077              and term_tt-rule-call-param.codex_id = tt-rule-call-param.codex_id
     2078              and term_tt-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     2079              and term_tt-rule-call-param.order_id = tt-rule-call-param.order_id
     2080              and term_tt-rule-call-param.param-name = tt-rule-call-param.param-name
     2081         BY tt-rule-call-param.call_id
     2082         BY tt-rule-call-param.codex_id
     2083         BY tt-rule-call-param.ruleset_id
     2084         BY tt-rule-call-param.order_id
     2085         BY tt-rule-call-param.param-num.
     2086     END.
     2087   END CASE.
     2088   apply "ENTRY" to br-rcp in frame Dialog-Frame .
     2089   APPLy "VALUE-CHANGED" to br-rcp.
     2090   END PROCEDURE.
     2091   PROCEDURE rcps_proc-b-chg PRIVATE :
     2092   DEFINE VARIABLE v-rec1 AS Rowid NO-UNDO.
     2093   DEFINE VARIABLE v-rec2 AS Rowid NO-UNDO.
     2094   DEFINE VARIABLE v-rec3 AS Rowid NO-UNDO.
     2095   DEFINE VARIABLE v-rec4 AS Rowid NO-UNDO.
     2096   define variable v-param-data-type as character no-undo .
     2097   define variable v-rid-list as character no-undo .
     2098   IF NOT AVAILABLE TERM_tt-rule-call-param  THEN DO:
     2099     RETURN ERROR.
     2100   END.
     2101   ASSIGN
     2102   v-rec1 = rowid(X_ruledict-param)
     2103   v-rec2 = rowid(X_rp-rule-param)
     2104   v-rec3 = Rowid(tt-rule-call-param)
     2105   v-rec4 = Rowid(term_tt-rule-call-param)
     2106   .
     2107   run rcps_openbr in this-procedure .
     2108   REPOSITION br-rcp TO Rowid v-rec1, v-rec2,v-rec3, v-rec4 NO-ERROR.
     2109   IF ERROR-STATUS:ERROR THEN DO:
     2110     REPOSITION br-rcp TO ROW 1 NO-ERROR.
     2111   END.
     2112   APPLY "ENTRY" TO br-rcp in frame Dialog-Frame .
     2113   APPLY "VALUE-CHANGED" TO br-rcp in frame Dialog-Frame .
     2114   END PROCEDURE.
     2115   PROCEDURE rcps_set-row-color :
     2116   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     2117   ASSIGN
     2118   v-ch[1]:FGCOLOR = GREY_COLOR
     2119   v-ch[1]:BGCOLOR = GREY_Color
     2120   v-ch[1]:PFCOLOR = GREY_Color
     2121   v-ch[2]:FGCOLOR = GREY_COLOR
     2122   v-ch[2]:BGCOLOR = GREY_Color
     2123   v-ch[2]:PFCOLOR = GREY_Color
     2124   v-ch[3]:FGCOLOR = GREY_COLOR
     2125   v-ch[3]:BGCOLOR = GREY_Color
     2126   v-ch[3]:PFCOLOR = GREY_Color
     2127   v-ch[4]:FGCOLOR = GREY_COLOR
     2128   v-ch[4]:BGCOLOR = GREY_Color
     2129   v-ch[4]:PFCOLOR = GREY_Color
     2130   v-ch[5]:FGCOLOR = GREY_COLOR
     2131   v-ch[5]:BGCOLOR = GREY_Color
     2132   v-ch[5]:PFCOLOR = GREY_Color
     2133   .
     2134   CASE entry(1, p-data-type):
     2135        WHEN 'character':U THEN DO:
     2136         ASSIGN
     2137         v-ch[1]:FGCOLOR = BLACK_COLOR
     2138         v-ch[1]:BGCOLOR = WHITE_Color.
     2139       END.
     2140       WHEN 'decimal':U THEN DO:
     2141         ASSIGN
     2142         v-ch[3]:FGCOLOR = BLACK_COLOR
     2143         v-ch[3]:BGCOLOR = WHITE_Color.
     2144       END.
     2145       WHEN 'integer':U THEN DO:
     2146         ASSIGN
     2147         v-ch[4]:FGCOLOR = BLACK_COLOR
     2148         v-ch[4]:BGCOLOR = WHITE_Color.
     2149       END.
     2150       WHEN 'date':U THEN DO:
     2151         ASSIGN
     2152         v-ch[2]:FGCOLOR = BLACK_COLOR
     2153         v-ch[2]:BGCOLOR = WHITE_Color.
     2154        END.
     2155        WHEN 'logical':U THEN DO:
     2156          ASSIGN
     2157          v-ch[5]:FGCOLOR = BLACK_COLOR
     2158          v-ch[5]:BGCOLOR = WHITE_Color.
     2159        END.
     2160   END CASE.
     2161   END PROCEDURE.
     2162   ON ROW-DISPLAY OF br-rcp IN frame Dialog-Frame
     2163   DO:
     2164     IF AVAIL tt-rule-call-param THEN DO:
     2165       RUN set-row-color IN THIS-PROCEDURE ( INPUT term_tt-rule-call-param.param-data-type).
     2166     END.
     2167   END.
     2168   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2169   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2170   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2171   on help of frame Dialog-Frame
     2172   do:
     2173     run gbl/app_help.p
     2174       (input this-procedure :file-name
     2175       ,input ''
     2176       ,input ?
     2177       ) no-error.
     2178     if error-status :error then do:
     2179       message
     2180         "Ошибка при вызове помощи"
     2181         error-status :get-message(1)
     2182         view-as alert-box .
     2183     end.
     2184   end.
     2185   run minbtn-set in this-procedure .
     2186   on choose of b-help in frame Dialog-Frame
     2187   do:
     2188     apply "help":u to frame Dialog-Frame .
     2189   end.
     2190   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2191   procedure minbtn-set :
     2192       do
     2193           on error undo, return error return-value
     2194           :
     2195           define variable ii              as integer       no-undo .
     2196           define variable fh              as widget-handle no-undo .
     2197           define variable hh              as widget-handle no-undo .
     2198           define variable v-h             as handle        extent 4 no-undo .
     2199           define variable v-name-button   as character     no-undo .
     2200           define variable v-help-old-x    as decimal       no-undo .
     2201           define variable v-help-old-y    as decimal       no-undo .
     2202           define variable v-help-old-size as decimal       no-undo .
     2203           define variable v-frame-width   as decimal       no-undo .
     2204           define variable jj              as integer       no-undo .
     2205           do
     2206               on error undo, return error
     2207               :
     2208               assign
     2209                   v-frame-width = frame Dialog-Frame:width - 0.3
     2210                   fh            = frame Dialog-Frame:first-child
     2211                   hh            = fh:first-child
     2212                   ii            = 1
     2213                   .
     2214               do while valid-handle(hh):
     2215                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2216                   do:
     2217                       case lc(hh:name) :
     2218                           when "b-help" then
     2219                               do:
     2220                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2221                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2222                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2223                                   hh:TOOLTIP = "Помощь" .
     2224                                   v-help-old-x = hh:column .
     2225                                   v-help-old-y = hh:row    .
     2226                                   v-help-old-size = hh:width .
     2227                                   hh:width-chars = 2.5 .
     2228                               end.
     2229                           when "b-print" then
     2230                               do:
     2231                                   hh:load-image("cmp/b-print.bmp":u) .
     2232                                   hh:TOOLTIP = "Печать" .
     2233                                   v-h[ii] = hh:handle .
     2234                                   ii = ii + 1 .
     2235                                   hh:width-chars = 3 .
     2236                               end.
     2237                           when "b-history" or
     2238                           when "b-hist" then
     2239                               do:
     2240                                   hh:load-image("cmp/b-hist.bmp":u) .
     2241                                   hh:TOOLTIP = "История" .
     2242                                   v-h[ii] = hh:handle .
     2243                                   ii = ii + 1 .
     2244                                   hh:width-chars = 3 .
     2245                               end.
     2246                           when "b-sch" then
     2247                               do:
     2248                                   hh:load-image("cmp/b-sch.bmp":u) .
     2249                                   hh:TOOLTIP = "Установка Фильтра" .
     2250                                   v-h[ii] = hh:handle .
     2251                                   ii = ii + 1 .
     2252                                   hh:width-chars = 3 .
     2253                               end.
     2254                           when "b-hist-user" then
     2255                               do:
     2256                                   hh:load-image("cmp/b-hist.bmp":u) .
     2257                                   hh:TOOLTIP = "История пользователя" .
     2258                                   ii = ii + 1 .
     2259                               end.
     2260                       end case.
     2261                   end.
     2262                   hh = hh:next-sibling.
     2263               end.
     2264               b-help:column = v-frame-width - b-help:width-chars.
     2265               jj = 0.
     2266               repeat ii = 4 to 1 by -1 :
     2267                   if valid-handle (v-h[ii] ) then
     2268                   do:
     2269                       jj  = jj + 1 .
     2270                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2271                       v-h[ii]:row    = v-help-old-y .
     2272                   end.
     2273               end.
     2274           end.
     2275       end.
     2276   end procedure.
     2277   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2278   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2279   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2280   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2281   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2282   define variable v-diasize-current-frame-height as decimal   no-undo .
     2283   define variable v-diasize-change-size          as logical   no-undo .
     2284   define variable v-diasize-resize-button        as handle    no-undo .
     2285   define variable v-diasize-wndmax               as logical   no-undo .
     2286   define variable v-diasize-wndstore             as logical   no-undo .
     2287   define variable v-diasize-proc-name            as character no-undo .
     2288   define variable v-diasize-browse-handle        as handle    no-undo .
     2289   define variable v-diasize-browse-number        as integer   no-undo .
     2290   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2291   define temp-table temp-diasize-handle no-undo
     2292     field handle-value  as handle
     2293     field save-position as decimal
     2294     index xpk is primary unique handle-value
     2295     .
     2296   define temp-table temp-browse-handle no-undo
     2297     field browse-type   as character
     2298     field browse-number as integer
     2299     field browse-handle as handle
     2300     field original-size as decimal
     2301     index xpk is primary unique browse-type browse-number
     2302     index xie browse-type browse-handle
     2303   .
     2304   procedure diasize_change-height :
     2305     define input  parameter p-change-value  as decimal   no-undo .
     2306     define input  parameter p-move-resize   as logical   no-undo .
     2307     define variable v-field-group-handle    as handle    no-undo .
     2308     define variable v-object-handle         as handle    no-undo .
     2309     define variable v-frame-height          as decimal   no-undo .
     2310     define variable v-frame-virtual-height  as decimal   no-undo .
     2311     define variable v-browse-height         as decimal   no-undo .
     2312     define variable v-window-height         as decimal   no-undo .
     2313     define variable v-window-virtual-height as decimal   no-undo .
     2314     define variable v-change-sign           as integer   no-undo .
     2315     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2316     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2317     if p-change-value > 0
     2318     then do:
     2319       if frame Dialog-Frame :height + p-change-value
     2320           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2321       then do:
     2322         assign
     2323           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2324                           - (frame Dialog-Frame :height-chars)
     2325         .
     2326         if p-change-value <= 0
     2327         then do:
     2328           run diasize_position-resize-button in this-procedure .
     2329           return .
     2330         end.
     2331       end.
     2332     end.
     2333     if p-change-value < 0
     2334     then do:
     2335       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2336       then do:
     2337         assign
     2338           p-change-value = v-diasize-orig-frame-height
     2339                          - (frame Dialog-Frame :height-chars)
     2340         .
     2341         if p-change-value >= 0
     2342         then do:
     2343           run diasize_position-resize-button in this-procedure .
     2344           return .
     2345         end.
     2346       end.
     2347     end.
     2348     if p-change-value >= 0
     2349     then do:
     2350       assign
     2351         v-change-sign = 1
     2352       .
     2353     end.
     2354     else do:
     2355       assign
     2356         v-change-sign = -1
     2357       .
     2358     end.
     2359     assign
     2360       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2361     .
     2362     if p-change-value = 0
     2363     then do:
     2364       run diasize_position-resize-button in this-procedure .
     2365       return .
     2366     end.
     2367     move_block:
     2368     do
     2369     on error undo move_block, retry move_block
     2370     :
     2371       if retry
     2372       then do:
     2373         do
     2374         on error undo move_block, leave move_block
     2375         :
     2376           if p-change-value > 0
     2377           then do:
     2378             for each buf_temp-diasize-handle
     2379             on error undo, next
     2380             :
     2381               assign
     2382                 v-object-handle = buf_temp-diasize-handle.handle-value
     2383               .
     2384               if v-object-handle <> v-diasize-resize-button
     2385               then do:
     2386                 assign
     2387                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2388                 .
     2389               end.
     2390             end.
     2391             assign
     2392               v-diasize-browse-handle :height = v-browse-height
     2393             .
     2394             for each buf_temp-browse-handle
     2395               where buf_temp-browse-handle.browse-type = 'height':u
     2396             on error undo, next
     2397             :
     2398               assign
     2399                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2400               .
     2401             end.
     2402             assign
     2403               frame Dialog-Frame :height = v-frame-height
     2404             .
     2405             if frame Dialog-Frame :scrollable = true
     2406             then do:
     2407               assign
     2408                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2409               .
     2410             end.
     2411             run diasize_position-resize-button in this-procedure .
     2412           end.
     2413           else do:
     2414             if frame Dialog-Frame :scrollable = true
     2415             then do:
     2416               assign
     2417                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2418               .
     2419             end.
     2420             assign
     2421               frame Dialog-Frame :height = v-frame-height
     2422             .
     2423             assign
     2424               v-diasize-browse-handle :height = v-browse-height
     2425             .
     2426             for each buf_temp-browse-handle
     2427               where buf_temp-browse-handle.browse-type = 'height':u
     2428             on error undo, next
     2429             :
     2430               assign
     2431                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2432               .
     2433             end.
     2434             for each buf_temp-diasize-handle
     2435             on error undo, next
     2436             :
     2437               assign
     2438                 v-object-handle = buf_temp-diasize-handle.handle-value
     2439               .
     2440               if v-object-handle <> v-diasize-resize-button
     2441               then do:
     2442                 assign
     2443                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2444                 .
     2445               end.
     2446             end.
     2447             run diasize_position-resize-button in this-procedure .
     2448           end.
     2449           assign
     2450             v-diasize-change-size = false
     2451           .
     2452           leave move_block .
     2453         end.
     2454       end.
     2455       assign
     2456         v-diasize-need-full-display = true
     2457       .
     2458       if v-diasize-change-size = false
     2459       then do:
     2460         assign
     2461           v-diasize-change-size = true
     2462         .
     2463       end.
     2464       else do:
     2465         return .
     2466       end.
     2467       assign
     2468         v-frame-height = frame Dialog-Frame :height
     2469         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2470         v-browse-height = v-diasize-browse-handle :height
     2471       .
     2472       for each buf_temp-browse-handle
     2473         where buf_temp-browse-handle.browse-type = 'height':u
     2474       :
     2475         assign
     2476           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2477         .
     2478       end.
     2479       for each buf_temp-diasize-handle
     2480       :
     2481         delete buf_temp-diasize-handle .
     2482       end.
     2483       assign
     2484         v-field-group-handle = frame Dialog-Frame :first-child
     2485       .
     2486       do while valid-handle(v-field-group-handle)
     2487       :
     2488         assign
     2489           v-object-handle = v-field-group-handle :first-child
     2490         .
     2491         do while valid-handle(v-object-handle)
     2492         :
     2493           if  v-object-handle <> v-diasize-browse-handle :handle
     2494           and can-query(v-object-handle, "row")
     2495           and can-query(v-object-handle, "height")
     2496           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2497           then do:
     2498             find first buf_temp-browse-handle
     2499               where buf_temp-browse-handle.browse-type   = 'height':u
     2500                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2501               no-error .
     2502             if available buf_temp-browse-handle
     2503             then do:
     2504             end.
     2505             else do:
     2506               create buf_temp-diasize-handle .
     2507               assign
     2508                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2509                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2510               .
     2511             end.
     2512           end.
     2513           assign
     2514             v-object-handle = v-object-handle :next-sibling
     2515           .
     2516         end.
     2517         assign
     2518           v-field-group-handle = v-field-group-handle :next-sibling
     2519         .
     2520       end.
     2521       do with frame Dialog-Frame
     2522       :
     2523         hide v-diasize-resize-button .
     2524         assign
     2525           v-diasize-resize-button :row    = 1
     2526           v-diasize-resize-button :column = 1
     2527         .
     2528       end.
     2529       if p-change-value > 0
     2530       then do:
     2531         if frame Dialog-Frame :scrollable = true
     2532         then do:
     2533           assign
     2534             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2535             no-error .
     2536           if error-status :error
     2537           or error-status :get-message(1) <> ""
     2538           then do:
     2539             undo move_block, retry move_block .
     2540           end.
     2541         end.
     2542         assign
     2543           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2544           no-error .
     2545         if error-status :error
     2546         or error-status :get-message(1) <> ""
     2547         then do:
     2548           undo move_block, retry move_block .
     2549         end.
     2550         assign
     2551           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2552           no-error .
     2553         if error-status :error
     2554         or error-status :get-message(1) <> ""
     2555         then do:
     2556           undo move_block, retry move_block .
     2557         end.
     2558         for each buf_temp-browse-handle
     2559           where buf_temp-browse-handle.browse-type = 'height':u
     2560         on error undo move_block, retry move_block
     2561         :
     2562           assign
     2563             buf_temp-browse-handle.browse-handle :height
     2564               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2565             no-error .
     2566           if error-status :error
     2567           or error-status :get-message(1) <> ""
     2568           then do:
     2569             undo move_block, retry move_block .
     2570           end.
     2571         end.
     2572         for each buf_temp-diasize-handle
     2573         on error undo move_block, retry move_block
     2574         :
     2575           assign
     2576             v-object-handle = buf_temp-diasize-handle.handle-value
     2577           .
     2578           if v-object-handle <> v-diasize-resize-button
     2579           then do:
     2580             assign
     2581               v-object-handle :row = v-object-handle :row + p-change-value
     2582               no-error .
     2583             if error-status :error
     2584             or error-status :get-message(1) <> ""
     2585             then do:
     2586               undo move_block, retry move_block .
     2587             end.
     2588           end.
     2589         end.
     2590       end.
     2591       else do:
     2592         for each buf_temp-diasize-handle
     2593         on error undo move_block, retry move_block
     2594         :
     2595           assign
     2596             v-object-handle = buf_temp-diasize-handle.handle-value
     2597           .
     2598           if v-object-handle <> v-diasize-resize-button
     2599           then do:
     2600             assign
     2601               v-object-handle :row = v-object-handle :row + p-change-value
     2602               no-error .
     2603             if error-status :error
     2604             or error-status :get-message(1) <> ""
     2605             then do:
     2606               undo move_block, retry move_block .
     2607             end.
     2608           end.
     2609         end.
     2610         assign
     2611           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2612           no-error .
     2613         if error-status :error
     2614         or error-status :get-message(1) <> ""
     2615         then do:
     2616           undo move_block, retry move_block .
     2617         end.
     2618         for each buf_temp-browse-handle
     2619           where buf_temp-browse-handle.browse-type = 'height':u
     2620         on error undo move_block, retry move_block
     2621         :
     2622           assign
     2623             buf_temp-browse-handle.browse-handle :height
     2624               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2625             no-error .
     2626           if error-status :error
     2627           or error-status :get-message(1) <> ""
     2628           then do:
     2629             undo move_block, retry move_block .
     2630           end.
     2631         end.
     2632         assign
     2633           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2634           no-error .
     2635         if error-status :error
     2636         or error-status :get-message(1) <> ""
     2637         then do:
     2638           undo move_block, retry move_block .
     2639         end.
     2640         if frame Dialog-Frame :scrollable = true
     2641         then do:
     2642           assign
     2643             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2644             no-error .
     2645           if error-status :error
     2646           or error-status :get-message(1) <> ""
     2647           then do:
     2648             undo move_block, retry move_block .
     2649           end.
     2650         end.
     2651       end.
     2652       if p-move-resize = true
     2653       then do:
     2654         run diasize_position-resize-button in this-procedure .
     2655       end.
     2656       if v-diasize-wndstore = true
     2657       then do:
     2658         if connected("ub") = true
     2659         then do:
     2660           define variable v-cntxt-db-num        as integer   no-undo .
     2661           define variable v-cntxt-userid        as character no-undo .
     2662           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2663                                             , OUTPUT v-cntxt-userid
     2664                                             ) .
     2665           run gbl/wndsizew.p
     2666             (input  v-cntxt-db-num
     2667             ,input  v-cntxt-userid
     2668             ,input  v-diasize-proc-name
     2669             ,input  'height':u
     2670             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2671             ) .
     2672         end.
     2673       end.
     2674     end.
     2675     assign
     2676       v-diasize-change-size = false
     2677     .
     2678   end procedure.
     2679   procedure diasize_set-height :
     2680     define input  parameter p-new-height  as decimal   no-undo .
     2681     define input  parameter p-move-resize as logical   no-undo .
     2682     do
     2683     on error undo, return error return-value
     2684     :
     2685       run diasize_change-height in this-procedure
     2686         (input  (p-new-height - frame Dialog-Frame :height)
     2687         ,input  p-move-resize
     2688         ) .
     2689     end.
     2690   end procedure.
     2691   procedure diasize_change-width :
     2692     define input  parameter p-change-value as decimal   no-undo .
     2693     define input  parameter p-move-resize  as logical   no-undo .
     2694     define variable v-field-group-handle   as handle    no-undo .
     2695     define variable v-object-handle        as handle    no-undo .
     2696     define variable v-frame-width          as decimal   no-undo .
     2697     define variable v-frame-virtual-width  as decimal   no-undo .
     2698     define variable v-browse-width         as decimal   no-undo .
     2699     define variable v-window-width         as decimal   no-undo .
     2700     define variable v-window-virtual-width as decimal   no-undo .
     2701     define variable v-change-sign          as integer   no-undo .
     2702     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2703     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2704     if p-change-value > 0
     2705     then do:
     2706       if frame Dialog-Frame :width + p-change-value >
     2707           session :width-chars
     2708       then do:
     2709         assign
     2710           p-change-value = session :width-chars - frame Dialog-Frame :width
     2711         .
     2712         if p-change-value <= 0
     2713         then do:
     2714           run diasize_position-resize-button in this-procedure .
     2715           return .
     2716         end.
     2717       end.
     2718     end.
     2719     if p-change-value < 0
     2720     then do:
     2721       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2722       then do:
     2723         assign
     2724           p-change-value = v-diasize-orig-frame-width
     2725                          - frame Dialog-Frame :width
     2726         .
     2727         if p-change-value >= 0
     2728         then do:
     2729           run diasize_position-resize-button in this-procedure .
     2730           return .
     2731         end.
     2732       end.
     2733     end.
     2734     if p-change-value >= 0
     2735     then do:
     2736       assign
     2737         v-change-sign = 1
     2738       .
     2739     end.
     2740     else do:
     2741       assign
     2742         v-change-sign = -1
     2743       .
     2744     end.
     2745     assign
     2746       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2747     .
     2748     if p-change-value = 0
     2749     then do:
     2750       run diasize_position-resize-button in this-procedure .
     2751       return .
     2752     end.
     2753     move_block:
     2754     do
     2755     on error undo move_block, leave move_block
     2756     :
     2757       if retry
     2758       then do:
     2759         do
     2760         on error undo move_block, leave move_block
     2761         :
     2762           if p-change-value > 0
     2763           then do:
     2764             for each buf_temp-diasize-handle
     2765             on error undo, next
     2766             :
     2767               assign
     2768                 v-object-handle = buf_temp-diasize-handle.handle-value
     2769               .
     2770               if v-object-handle <> v-diasize-resize-button
     2771               then do:
     2772                 assign
     2773                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2774                 .
     2775               end.
     2776             end.
     2777             assign
     2778               v-diasize-browse-handle :width = v-browse-width
     2779             .
     2780             for each buf_temp-browse-handle
     2781               where buf_temp-browse-handle.browse-type = 'width':u
     2782             on error undo, next
     2783             :
     2784               assign
     2785                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2786               .
     2787             end.
     2788             assign
     2789               frame Dialog-Frame :width = v-frame-width
     2790             .
     2791             if frame Dialog-Frame :scrollable = true
     2792             then do:
     2793               assign
     2794                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2795               .
     2796             end.
     2797             run diasize_position-resize-button in this-procedure .
     2798           end.
     2799           else do:
     2800             if frame Dialog-Frame :scrollable = true
     2801             then do:
     2802               assign
     2803                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2804               .
     2805             end.
     2806             assign
     2807               frame Dialog-Frame :width = v-frame-width
     2808             .
     2809             for each buf_temp-browse-handle
     2810               where buf_temp-browse-handle.browse-type = 'width':u
     2811             on error undo, next
     2812             :
     2813               assign
     2814                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2815               .
     2816             end.
     2817             assign
     2818               v-diasize-browse-handle :width = v-browse-width
     2819             .
     2820             for each buf_temp-diasize-handle
     2821             on error undo, next
     2822             :
     2823               assign
     2824                 v-object-handle = buf_temp-diasize-handle.handle-value
     2825               .
     2826               if v-object-handle <> v-diasize-resize-button
     2827               then do:
     2828                 assign
     2829                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2830                 .
     2831               end.
     2832             end.
     2833             run diasize_position-resize-button in this-procedure .
     2834           end.
     2835           assign
     2836             v-diasize-change-size = false
     2837           .
     2838           leave move_block .
     2839         end.
     2840       end.
     2841       assign
     2842         v-diasize-need-full-display = true
     2843       .
     2844       if v-diasize-change-size = false
     2845       then do:
     2846         assign
     2847           v-diasize-change-size = true
     2848         .
     2849       end.
     2850       else do:
     2851         return .
     2852       end.
     2853       assign
     2854         v-frame-width = frame Dialog-Frame :width
     2855         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2856         v-browse-width = v-diasize-browse-handle :width
     2857       .
     2858       for each buf_temp-browse-handle
     2859         where buf_temp-browse-handle.browse-type = 'width':u
     2860       :
     2861         assign
     2862           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2863         .
     2864       end.
     2865       for each buf_temp-diasize-handle
     2866       :
     2867         delete buf_temp-diasize-handle .
     2868       end.
     2869       assign
     2870         v-field-group-handle = frame Dialog-Frame :first-child
     2871       .
     2872       do while valid-handle(v-field-group-handle)
     2873       :
     2874         assign
     2875           v-object-handle = v-field-group-handle :first-child
     2876         .
     2877         do while valid-handle(v-object-handle)
     2878         :
     2879           if  v-object-handle <> v-diasize-browse-handle :handle
     2880           and v-object-handle <> v-diasize-resize-button
     2881           and can-query(v-object-handle, "row")
     2882           and can-query(v-object-handle, "height")
     2883           and ( v-object-handle :col + v-object-handle :width
     2884                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2885               )
     2886           then do:
     2887             find first buf_temp-browse-handle
     2888               where buf_temp-browse-handle.browse-type   = 'width':u
     2889                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2890               no-error .
     2891             if available buf_temp-browse-handle
     2892             then do:
     2893             end.
     2894             else do:
     2895               create buf_temp-diasize-handle .
     2896               assign
     2897                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2898                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2899               .
     2900             end.
     2901           end.
     2902           assign
     2903             v-object-handle = v-object-handle :next-sibling
     2904           .
     2905         end.
     2906         assign
     2907           v-field-group-handle = v-field-group-handle :next-sibling
     2908         .
     2909       end.
     2910       do with frame Dialog-Frame
     2911       :
     2912         hide v-diasize-resize-button .
     2913         v-diasize-resize-button :row = 1.
     2914         v-diasize-resize-button :column = 1.
     2915       end.
     2916       if p-change-value > 0
     2917       then do:
     2918         if frame Dialog-Frame :scrollable = true
     2919         then do:
     2920           assign
     2921             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2922             no-error .
     2923           if error-status :error
     2924           or error-status :get-message(1) <> ""
     2925           then do:
     2926             undo move_block, retry move_block.
     2927           end.
     2928         end.
     2929         assign
     2930           frame Dialog-Frame :width = v-frame-width + p-change-value
     2931           no-error .
     2932         if error-status :error
     2933         or error-status :get-message(1) <> ""
     2934         then do:
     2935           undo move_block, retry move_block.
     2936         end.
     2937         assign
     2938           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2939         no-error .
     2940         if error-status :error
     2941         or error-status :get-message(1) <> ""
     2942         then do:
     2943           undo move_block, retry move_block.
     2944         end.
     2945         for each buf_temp-browse-handle
     2946           where buf_temp-browse-handle.browse-type = 'width':u
     2947         on error undo move_block, retry move_block
     2948         :
     2949           assign
     2950             buf_temp-browse-handle.browse-handle :width
     2951               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2952             no-error .
     2953           if error-status :error
     2954           or error-status :get-message(1) <> ""
     2955           then do:
     2956             undo move_block, retry move_block .
     2957           end.
     2958         end.
     2959         for each buf_temp-diasize-handle
     2960         on error undo move_block, retry move_block
     2961         :
     2962           assign
     2963             v-object-handle = buf_temp-diasize-handle.handle-value
     2964           .
     2965           if v-object-handle <> v-diasize-resize-button
     2966           then do:
     2967             assign
     2968               v-object-handle :col = v-object-handle :col + p-change-value
     2969               no-error .
     2970             if error-status :error
     2971             or error-status :get-message(1) <> ""
     2972             then do:
     2973               undo move_block, retry move_block .
     2974             end.
     2975           end.
     2976         end.
     2977       end.
     2978       else do:
     2979         for each buf_temp-diasize-handle
     2980         on error undo move_block, retry move_block
     2981         :
     2982           assign
     2983             v-object-handle = buf_temp-diasize-handle.handle-value
     2984           .
     2985           if v-object-handle <> v-diasize-resize-button
     2986           then do:
     2987             assign
     2988               v-object-handle :col = v-object-handle :col + p-change-value
     2989               no-error .
     2990             if error-status :error
     2991             or error-status :get-message(1) <> ""
     2992             then do:
     2993               undo move_block, retry move_block .
     2994             end.
     2995           end.
     2996         end.
     2997         for each buf_temp-browse-handle
     2998           where buf_temp-browse-handle.browse-type = 'width':u
     2999         on error undo move_block, retry move_block
     3000         :
     3001           assign
     3002             buf_temp-browse-handle.browse-handle :width
     3003               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3004             no-error .
     3005           if error-status :error
     3006           or error-status :get-message(1) <> ""
     3007           then do:
     3008             undo move_block, retry move_block .
     3009           end.
     3010         end.
     3011         assign
     3012           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3013           no-error .
     3014         if error-status :error
     3015         or error-status :get-message(1) <> ""
     3016         then do:
     3017           undo move_block, retry move_block.
     3018         end.
     3019         assign
     3020           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3021         no-error .
     3022         if error-status :error
     3023         or error-status :get-message(1) <> ""
     3024         then do:
     3025           undo move_block, retry move_block.
     3026         end.
     3027         if frame Dialog-Frame :scrollable = true
     3028         then do:
     3029           assign
     3030             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3031           no-error .
     3032           if error-status :error
     3033           or error-status :get-message(1) <> ""
     3034           then do:
     3035             undo move_block, retry move_block.
     3036           end.
     3037         end.
     3038       end.
     3039       if p-move-resize
     3040       then do:
     3041         run diasize_position-resize-button in this-procedure .
     3042       end.
     3043       if v-diasize-wndstore = true
     3044       then do:
     3045         if connected("ub") = true
     3046         then do:
     3047           define variable v-cntxt-db-num        as integer   no-undo .
     3048           define variable v-cntxt-userid        as character no-undo .
     3049           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3050                                             , OUTPUT v-cntxt-userid
     3051                                             ) .
     3052           run gbl/wndsizew.p
     3053             (input  v-cntxt-db-num
     3054             ,input  v-cntxt-userid
     3055             ,input  v-diasize-proc-name
     3056             ,input  'width':u
     3057             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3058             ) .
     3059         end.
     3060       end.
     3061     end.
     3062     assign
     3063       v-diasize-change-size = false
     3064     .
     3065   end procedure.
     3066   procedure diasize_set-width :
     3067     define input  parameter p-new-width  as decimal   no-undo .
     3068     define input  parameter p-move-resize as logical   no-undo .
     3069     do
     3070     on error undo, return error return-value
     3071     :
     3072       run diasize_change-width in this-procedure
     3073         (input  (p-new-width - frame Dialog-Frame :width)
     3074         ,input  p-move-resize
     3075         ) .
     3076     end.
     3077   end procedure.
     3078   procedure diasize_position-resize-button :
     3079     do with frame Dialog-Frame
     3080     :
     3081       hide v-diasize-resize-button .
     3082       assign
     3083         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3084                     - 1
     3085                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3086         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3087                     - 1
     3088                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3089       .
     3090       view v-diasize-resize-button .
     3091     end.
     3092   end procedure.
     3093   on alt-right anywhere
     3094   do:
     3095     run diasize_change-width in this-procedure
     3096       (input 1
     3097       ,input true
     3098       ) .
     3099     return no-apply .
     3100   end.
     3101   on alt-left anywhere
     3102   do:
     3103     run diasize_change-width in this-procedure
     3104       (input -1
     3105       ,input true
     3106       ) .
     3107     return no-apply .
     3108   end.
     3109   on alt-down anywhere
     3110   do:
     3111     run diasize_change-height in this-procedure
     3112       (input 1
     3113       ,input true
     3114       ) .
     3115     return no-apply .
     3116   end.
     3117   on alt-up anywhere
     3118   do:
     3119     run diasize_change-height in this-procedure
     3120       (input -1
     3121       ,input true
     3122       ) .
     3123     return no-apply .
     3124   end.
     3125   on alt-enter of frame Dialog-Frame
     3126   do:
     3127     run diasize_maximize in this-procedure
     3128       (input  ?
     3129       ).
     3130     return no-apply .
     3131   end.
     3132   procedure diasize_end-move :
     3133     do
     3134     on error undo, return error return-value
     3135     :
     3136       define variable v-row-delta as decimal   no-undo .
     3137       define variable v-col-delta as decimal   no-undo .
     3138       define variable v-new-row as decimal   no-undo .
     3139       define variable v-new-col as decimal   no-undo .
     3140       assign
     3141         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3142         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3143       .
     3144       assign
     3145         v-row-delta = v-new-row - frame Dialog-Frame :height
     3146         v-col-delta = v-new-col - frame Dialog-Frame :width
     3147       .
     3148       run diasize_change-height in this-procedure
     3149         (input v-row-delta
     3150         ,input true
     3151         ) .
     3152       run diasize_change-width in this-procedure
     3153         (input v-col-delta
     3154         ,input true
     3155         ) .
     3156     end.
     3157   end procedure.
     3158   procedure diasize_maximize :
     3159     define input  parameter p-action as logical   no-undo .
     3160     do
     3161     on error undo, return error return-value
     3162     :
     3163       if p-action = ?
     3164       then do:
     3165         if v-diasize-need-maximize = true
     3166         then do:
     3167           assign
     3168             p-action = true
     3169           .
     3170         end.
     3171         else do:
     3172           assign
     3173             p-action = false
     3174           .
     3175         end.
     3176       end.
     3177       if p-action = true
     3178       then do:
     3179         run diasize_change-height in this-procedure
     3180           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3181               - frame Dialog-Frame :height-chars
     3182           ,input true
     3183           ) .
     3184         run diasize_change-width in this-procedure
     3185           (input session :width-chars
     3186               - frame Dialog-Frame :width-chars
     3187           ,input true
     3188           ) .
     3189         assign
     3190           v-diasize-need-maximize = false
     3191         .
     3192       end.
     3193       else do:
     3194         run diasize_change-width in this-procedure
     3195           (input v-diasize-orig-frame-width
     3196               - frame Dialog-Frame :width-chars
     3197           ,input true
     3198           ) .
     3199         run diasize_change-height in this-procedure
     3200           (input v-diasize-orig-frame-height
     3201               - frame Dialog-Frame :height-chars
     3202           ,input true
     3203           ) .
     3204         assign
     3205           v-diasize-need-maximize = true
     3206         .
     3207       end.
     3208     end.
     3209   end procedure.
     3210   procedure diasize_restore-orig-size :
     3211     do
     3212     on error undo, return error return-value
     3213     :
     3214       assign
     3215         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3216         v-diasize-current-frame-height = frame Dialog-Frame :height
     3217       .
     3218       run diasize_set-height in this-procedure
     3219         (input  v-diasize-orig-frame-height
     3220         ,input  true
     3221         ) .
     3222       run diasize_set-width in this-procedure
     3223         (input  v-diasize-orig-frame-width
     3224         ,input  true
     3225         ) .
     3226     end.
     3227   end procedure.
     3228   procedure diasize_restore-current-size :
     3229     do
     3230     on error undo, return error return-value
     3231     :
     3232       run diasize_set-height in this-procedure
     3233         (input  v-diasize-current-frame-height
     3234         ,input  true
     3235         ) .
     3236       run diasize_set-width in this-procedure
     3237         (input  v-diasize-current-frame-width
     3238         ,input  true
     3239         ) .
     3240     end.
     3241   end procedure.
     3242   procedure diasize_set-browse-handle :
     3243     define input  parameter p-browse-handle as handle   no-undo .
     3244     define buffer buf_temp-browse-handle for temp-browse-handle .
     3245     do
     3246     on error undo, return error return-value
     3247     :
     3248       assign
     3249         v-diasize-browse-handle = p-browse-handle
     3250       .
     3251       for each buf_temp-browse-handle
     3252       on error undo, return error return-value
     3253       :
     3254         delete buf_temp-browse-handle .
     3255       end.
     3256     end.
     3257   end procedure.
     3258   procedure diasize_add_browse :
     3259     define input  parameter p-browse-type   as character no-undo .
     3260     define input  parameter p-browse-handle as handle    no-undo .
     3261     define buffer buf_temp-browse-handle for temp-browse-handle .
     3262     do
     3263     on error undo, return error return-value
     3264     :
     3265       assign
     3266         v-diasize-browse-number = v-diasize-browse-number + 1
     3267       .
     3268       create buf_temp-browse-handle .
     3269       assign
     3270         buf_temp-browse-handle.browse-type   = p-browse-type
     3271         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3272         buf_temp-browse-handle.browse-handle = p-browse-handle
     3273       .
     3274     end.
     3275   end procedure.
     3276   procedure diasize_init :
     3277     define variable v-default-value    as logical   no-undo .
     3278     define variable v-restore-saved    as logical   no-undo .
     3279     define variable v-resize-value-str as character no-undo .
     3280     do
     3281     on error undo, return error return-value
     3282     :
     3283       do with frame Dialog-Frame
     3284       :
     3285         assign
     3286           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3287           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3288           v-diasize-browse-handle     = browse BR-callee :handle
     3289         .
     3290         create button v-diasize-resize-button
     3291         assign
     3292           parent        = frame Dialog-Frame :first-child
     3293           label         = "s"
     3294           height-pixels = 16
     3295           width-pixels  = 16
     3296           visible       = true
     3297           sensitive     = true
     3298           movable       = true
     3299           triggers:
     3300             on end-move persistent run diasize_end-move in this-procedure .
     3301           end triggers.
     3302         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3303         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3304         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3305         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3306         assign
     3307           v-diasize-wndmax = false
     3308         .
     3309         if connected("ub") = true
     3310         then do:
     3311           define variable v-cntxt-db-num        as integer   no-undo .
     3312           define variable v-cntxt-userid        as character no-undo .
     3313           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3314                                             , OUTPUT v-cntxt-userid
     3315                                             ) .
     3316           run gbl/wndpar_r.p
     3317             (input  v-cntxt-db-num
     3318             ,input  v-cntxt-userid
     3319             ,input  'wndmax':U
     3320             ,output v-diasize-wndmax
     3321             ,output v-default-value
     3322             ) .
     3323         end.
     3324         assign
     3325           v-diasize-wndstore = false
     3326         .
     3327         if connected("ub") = true
     3328         then do:
     3329           run gbl/wndpar_r.p
     3330             (input  v-cntxt-db-num
     3331             ,input  v-cntxt-userid
     3332             ,input  'wndstore':U
     3333             ,output v-diasize-wndstore
     3334             ,output v-default-value
     3335             ) .
     3336         end.
     3337         assign
     3338           v-diasize-proc-name = entry(1, program-name(2), '.')
     3339         .
     3340         if v-diasize-wndstore = true
     3341         then do:
     3342           assign
     3343             v-restore-saved = false
     3344           .
     3345           if connected("ub") = true
     3346           then do:
     3347             run gbl/wndsizer.p
     3348               (input  v-cntxt-db-num
     3349               ,input  v-cntxt-userid
     3350               ,input  v-diasize-proc-name
     3351               ,input  'height':u
     3352               ,output v-resize-value-str
     3353               ) .
     3354             if v-resize-value-str <> '':U
     3355             then do:
     3356               run diasize_change-height in this-procedure
     3357                 (input  integer(v-resize-value-str)
     3358                 ,input  true
     3359                 ) .
     3360               assign
     3361                 v-restore-saved = true
     3362               .
     3363             end.
     3364           end.
     3365           if connected("ub") = true
     3366           then do:
     3367             run gbl/wndsizer.p
     3368               (input  v-cntxt-db-num
     3369               ,input  v-cntxt-userid
     3370               ,input  v-diasize-proc-name
     3371               ,input  'width':u
     3372               ,output v-resize-value-str
     3373               ) .
     3374             if v-resize-value-str <> '':U
     3375             then do:
     3376               run diasize_change-width in this-procedure
     3377                 (input  integer(v-resize-value-str)
     3378                 ,input  true
     3379                 ) .
     3380               assign
     3381                 v-restore-saved = true
     3382               .
     3383             end.
     3384           end.
     3385           if v-restore-saved <> true
     3386           then do:
     3387             if v-diasize-wndmax = true
     3388             then do:
     3389               run diasize_maximize in this-procedure
     3390                 (input  true
     3391                 ) .
     3392             end.
     3393           end.
     3394         end.
     3395         else do:
     3396           if v-diasize-wndmax = true
     3397           then do:
     3398             run diasize_maximize in this-procedure
     3399               (input  true
     3400               ) .
     3401           end.
     3402         end.
     3403       end.
     3404     end.
     3405   end procedure.
     3406   procedure diasize_need-full-display :
     3407     define output parameter p-need-full-display as logical   no-undo .
     3408     do
     3409     on error undo, return error return-value
     3410     :
     3411       assign
     3412         p-need-full-display = v-diasize-need-full-display
     3413       .
     3414       assign
     3415         v-diasize-need-full-display = false
     3416       .
     3417     end.
     3418   end procedure.
     3419   procedure get-context :
     3420      define output parameter p-db-num as integer          no-undo.
     3421      define output parameter p-user-id as character        no-undo.
     3422      define variable v-login               as character    no-undo.
     3423      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3424      define buffer buf_user-login  for ub.user-login .
     3425      do
     3426      on error undo, return error
     3427      :
     3428            FIND FIRST buf_sys-ctrl no-lock.
     3429            ASSIGN
     3430               v-login = USERID("ub")
     3431               p-db-num = buf_sys-ctrl.db-num
     3432            .
     3433            FIND FIRST buf_user-login
     3434                 WHERE buf_user-login.db-num = p-db-num
     3435                   AND buf_user-login.user-login = v-login
     3436                 no-lock
     3437                 no-error
     3438                 .
     3439            IF AVAILABLE buf_user-login
     3440            THEN DO:
     3441               assign
     3442                  p-user-id = buf_user-login.user-id
     3443               .
     3444            END.
     3445      end.
     3446   end procedure.
     3447       run diasize_init in this-procedure .
     3448   MAIN-BLOCK:
     3449   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3450      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3451      run gbl/dftempl.p ( input 'rp-rule-param':U
     3452                        , output v-dflt-rec) no-error.
     3453       if error-status:error then dO:
     3454         message
     3455         vss-workfile vss-revision vss-description skip
     3456         "Невозможно найти recid template записи в таблице rp-rule-param"
     3457         view-as alert-box error .
     3458         return error.
     3459       end.
     3460       run gbl/dftempl.p ( input 'ruledict-param':U
     3461                         , output v-rp-dflt-rec) no-error.
     3462        if error-status:error then dO:
     3463          message
     3464          vss-workfile vss-revision vss-description skip
     3465          "Невозможно найти recid template записи в таблице ruledict-param"
     3466          view-as alert-box error .
     3467          return error.
     3468        end.
     3469     IF p-list-mode = 'rp-rule-param':U
     3470     or p-list-mode = 'rp-rule-param':U  + chr(44) + 'все':U
     3471     THEN DO:
     3472       FIND FIRST buf_rule-profile NO-LOCK WHERE
     3473                 buf_rule-profile.profile_id = p-profile-id.
     3474       define variable v-field-list as character no-undo .
     3475       define variable v-value-list as character no-undo .
     3476       run  gen-key-fv in this-procedure ( input p-call-id
     3477                                         ,output v-field-list
     3478                                         ,output v-value-list).
     3479       if lookup(v-field-list, "obj-type", chr(3)) > 0 then do:
     3480         assign
     3481         v-obj-type = entry(lookup(v-field-list, "obj-type", chr(3)), v-value-list, chr(3))
     3482         v-obj-code = integer(entry(lookup(v-field-list, "obj-code", chr(3)), v-value-list, chr(3)) )
     3483         .
     3484       end.
     3485       if v-obj-type <> ''
     3486       and lookup("obj", buf_rule-profile.short-name) = 0
     3487       then do:
     3488         p-mode = 'ПРОСМОТР':U.
     3489       end.
     3490       if buf_rule-profile.parent-feature = integer('1':U) then do:
     3491         if p-codex-id = 0
     3492         and p-once-more > 0
     3493         and p-ruleset-id = 0
     3494         and p-order-id = ?
     3495         and p-rule-id = 0
     3496         and (p-mode = 'ПРОСМОТР':U
     3497             or
     3498             (p-mode = 'ИЗМЕНЕНИЕ':U and lookup("free", bttns) > 0))
     3499         then do:
     3500             find first buf_rp-by-call no-lock
     3501                   where buf_rp-by-call.call_id = p-call-id
     3502                     and buf_rp-by-call.profile_id = p-profile-id
     3503                     and buf_rp-by-call.once-more = p-once-more.
     3504             find first buf2_rule-profile no-lock where
     3505                       buf2_rule-profile.profile_id = buf_rp-by-call.parent-profile_id.
     3506             frame Dialog-Frame:visible = no.
     3507             message
     3508             substitute("Просмотр параметров для подчиненного профайла возможен только в составе комбинированного алгоритма:&1&2"
     3509                       , chr(10)
     3510                       , buf2_rule-profile.name)
     3511             view-as alert-box warning.
     3512             v-current-call-id = p-call-id.
     3513             entry(lookup(buf_rule-profile.profile-type, p-call-id, chr(3)), v-current-call-id, chr(3)) = 'cmb':U.
     3514             if search( substitute("rul/rcps-&1.w", buf2_rule-profile.profile_id)) <> ?
     3515             or search( substitute("rul/rcps-&1.r", buf2_rule-profile.profile_id)) <> ?
     3516             then do:
     3517               v-param-form = substitute("rul/rcps-&1.w", buf2_rule-profile.profile_id).
     3518             end.
     3519             else do:
     3520               message
     3521               substitute("Не найдена форма для алгоритма &1", buf2_rule-profile.profile_id)
     3522               view-as alert-box error .
     3523               undo, return error .
     3524             end.
     3525             run value(v-param-form) (
     3526                                   input parparentproc
     3527                                   ,input bttns
     3528                                   ,input p-mode
     3529                                   ,input 'rp-rule-param':U
     3530                                   ,input buf2_rule-profile.profile_id
     3531                                   ,input buf_rp-by-call.once-more
     3532                                   ,input v-current-call-id
     3533                                   ,input 0
     3534                                   ,input 0
     3535                                   ,input ?
     3536                                   ,input 0
     3537                                   ,INput substitute("Профайл &1 № привязки &2 &3"
     3538                                                     ,buf2_rule-profile.profile_id
     3539                                                     ,buf_rp-by-call.once-more
     3540                                                     ,calldscr(v-current-call-id)
     3541                                                     )
     3542                                   ,input-output table tt0-rule-call-param  ) no-error.
     3543             return.
     3544         end.
     3545         else do:
     3546           message
     3547           "Просмотр/изменение параметров для ПОДЧИНЕННОГО профайла невозможен"
     3548           view-as alert-box .
     3549           RETURN.
     3550         end.
     3551       end.
     3552       run gen-key-rec in this-procedure ( input 'rule-profile':U
     3553                                       ,input buffer buf_rule-profile:handle
     3554                                       ,output v-uniq-key-rec).
     3555       FIND FIRST buf_ruledict NO-LOCK WHERE
     3556                 buf_ruledict.entry-type = 'rule-profile':U
     3557          AND  buf_ruledict.uniq-key-rec = v-uniq-key-rec.
     3558       v-entry-id = buf_ruledict.entry-id.
     3559     END.
     3560     RUN rcps_fill-table IN THIS-PROCEDURE ( input no).
     3561     RUN Myenable in THIS-PROCEDURE.
     3562   ENABLE
     3563         b-add
     3564         b-set
     3565         WITH FRAME Dialog-Frame.
     3566     WAIT-FOR GO OF FRAME Dialog-Frame.
     3567   END.
     3568   RUN disable_UI.
     3569   PROCEDURE disable_UI :
     3570     HIDE FRAME Dialog-Frame.
     3571   END PROCEDURE.
     3572   PROCEDURE enable_UI :
     3573     DISPLAY E-rule-name E-param-des
     3574         WITH FRAME Dialog-Frame.
     3575     ENABLE B-exit b-quit b-chg b-del b-lkp b-rule b-ruleset B-Help BR-rcp
     3576            BR-callee E-rule-name E-param-des
     3577         WITH FRAME Dialog-Frame.
     3578     VIEW FRAME Dialog-Frame.
     3579     OPEN QUERY BR-callee FOR EACH call_rp-rule-param,        each CALL_tt-rule-call-param.
     3580   END PROCEDURE.
     3581   PROCEDURE MyEnable :
     3582   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     3583   DEFINE VARIABLE v-ch0 AS widget-handle NO-UNDO.
     3584   b-rule:MENU-MOUSE in frame Dialog-Frame = 1.
     3585   ASSIGN
     3586   term_tt-rule-call-param.param-label:RESIZABLE IN browse br-rcp = YES
     3587   X_rp-rule-param.rp-param-name:RESIZABLE IN browse br-rcp = YES
     3588   .
     3589   ASSIGN
     3590   v-ch0 = br-rcp:FIRST-COLUMN IN FRAME Dialog-Frame.
     3591   REPEAT WHILE valid-handle(v-ch0):
     3592      IF v-ch0:LABEL = "Значение!(строковое)" THEN DO:
     3593        v-ch[1] = v-ch0.
     3594        v-ch0:VISIBLE = NO.
     3595      END.
     3596      IF v-ch0:LABEL = "Значение!(Дата)" THEN DO:
     3597        v-ch[2] = v-ch0.
     3598        v-ch0:VISIBLE = NO.
     3599      END.
     3600      IF v-ch0:LABEL = "Значение!(Десятичное)" THEN DO:
     3601        v-ch[3] = v-ch0.
     3602        v-ch0:VISIBLE = NO.
     3603      END.
     3604      IF v-ch0:LABEL = "Значение!(Целое)" THEN DO:
     3605        v-ch[4] = v-ch0.
     3606        v-ch0:VISIBLE = NO.
     3607      END.
     3608      IF v-ch0:LABEL = "Значение!(Логическое)" THEN DO:
     3609        v-ch[5] = v-ch0.
     3610        v-ch0:VISIBLE = NO.
     3611      END.
     3612      IF v-ch0:LABEL = "Точка вызова" THEN DO:
     3613        v-ch[6] = v-ch0.
     3614      END.
     3615      IF v-ch0:LABEL = "Значение" THEN
     3616      v-ch0:RESIZABLE = YES.
     3617      v-ch0 = v-ch0:NEXT-COLUMN.
     3618   END.
     3619   assign
     3620   X_rp-rule-param.rp-param-name:resizable in browse br-rcp = yes
     3621   term_tt-rule-call-param.param-name:resizable in browse br-rcp = yes
     3622   term_tt-rule-call-param.param-label:resizable in browse br-rcp = yes
     3623   .
     3624   CASE p-list-mode:
     3625     WHEN 'rule-call-param':U THEN DO:
     3626        ASSIGN
     3627        X_rp-rule-param.rp-param-name:VISIBLE IN BROWSE br-rcp = NO
     3628        .
     3629        HIDE
     3630        br-callee
     3631        b-rule
     3632        b-ruleset
     3633        IN FRAME Dialog-Frame.
     3634     END.
     3635     WHEN 'rp-rule-param':U
     3636     or
     3637     when 'rp-rule-param':U + chr(44) + 'все':U
     3638     THEN DO:
     3639       assign
     3640       term_tt-rule-call-param.codex_id:VISIBLE IN BROWSE br-rcp = NO
     3641       term_tt-rule-call-param.ruleset_id:VISIBLE IN BROWSE br-rcp = NO
     3642       term_tt-rule-call-param.rule_id:VISIBLE IN BROWSE br-rcp = NO
     3643       term_tt-rule-call-param.order_id:VISIBLE IN BROWSE br-rcp = NO
     3644       term_tt-rule-call-param.param-name:VISIBLE IN BROWSE br-rcp = NO
     3645       term_tt-rule-call-param.param-num:VISIBLE IN BROWSE br-rcp = NO
     3646       .
     3647       br-rcp:height-chars = br-rcp:height-chars - br-callee:height-chars - 0.5.
     3648       ENABLE
     3649       br-callee
     3650       b-rule
     3651       b-ruleset
     3652       WITH FRAME Dialog-Frame.
     3653     END.
     3654   END CASE.
     3655    IF p-call-id <> '':U THEN DO:
     3656      v-ch[6]:VISIBLE = NO.
     3657    END.
     3658     IF p-profile-id <> 0 THEN DO:
     3659      term_tt-rule-call-param.profile_id :VISIBLE IN BROWSE br-rcp= NO.
     3660    END.
     3661     IF p-rule-id <> 0 THEN DO:
     3662      term_tt-rule-call-param.RULE_id :VISIBLE IN BROWSE br-rcp= NO.
     3663    END.
     3664     IF p-once-more <> 0 THEN DO:
     3665      term_tt-rule-call-param.once-more :VISIBLE IN BROWSE br-rcp= NO.
     3666    END.
     3667   DISPLAY
     3668   E-rule-name
     3669   E-param-des
     3670   WITH FRAME Dialog-Frame.
     3671   ENABLE
     3672   B-exit WHEN p-mode <> 'ПРОСМОТР':U
     3673   b-quit
     3674   b-chg WHEN p-mode <> 'ПРОСМОТР':U and lookup("b-chg", bttns) > 0
     3675   B-Help
     3676   BR-rcp
     3677   E-rule-name
     3678   E-param-des
     3679   WITH FRAME Dialog-Frame.
     3680   VIEW FRAME Dialog-Frame.
     3681   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3682      ASSIGN
     3683      b-quit:COLUMN = 1
     3684      b-quit:LABEL = "&Выход".
     3685      HIDE
     3686      b-exit
     3687      b-chg
     3688      IN FRAME Dialog-Frame.
     3689   END.
     3690   ASSIGN
     3691   FRAME Dialog-Frame:TITLE = substitute("Параметры вызова правил: &1", p-title).
     3692   RUN OpenBr in THIS-PROCEDURE.
     3693   END PROCEDURE.
     3694   PROCEDURE Openbr :
     3695   CASE p-list-mode:
     3696     WHEN 'rule-call-param':U THEN DO:
     3697         OPEN QUERY br-rcp
     3698         FOR EACH X_ruledict-param NO-LOCK WHERE RECID(X_ruledict-param) = v-rp-dflt-rec
     3699            ,EACH X_rp-rule-param NO-LOCK WHERE recid(X_rp-rule-param) = v-dflt-rec
     3700            ,first tt-rule-call-param
     3701            ,each term_tt-rule-call-param
     3702         BY term_tt-rule-call-param.call_id
     3703         BY term_tt-rule-call-param.codex_id
     3704         BY term_tt-rule-call-param.ruleset_id
     3705         BY term_tt-rule-call-param.order_id
     3706         BY term_tt-rule-call-param.param-num
     3707         BY term_tt-rule-call-param.p-index
     3708         .
     3709     END.
     3710     WHEN 'rp-rule-param':U THEN DO:
     3711         OPEN QUERY br-rcp
     3712         FOR EACH  X_ruledict-param NO-LOCK WHERE X_ruledict-param.entry-id = v-entry-id
     3713             ,FIRST X_rp-rule-param WHERE
     3714                 X_rp-rule-param.profile_id = p-profile-id
     3715             AND X_rp-rule-param.rp-param-name = X_ruledict-param.param-name
     3716           , first tt-rule-call-param WHERE
     3717              tt-rule-call-param.codex_id = X_rp-rule-param.codex_id
     3718          AND tt-rule-call-param.ruleset_id = X_rp-rule-param.ruleset_id
     3719          AND tt-rule-call-param.rule_id = X_rp-rule-param.rule_id
     3720          AND tt-rule-call-param.param-name = X_rp-rule-param.rule-param-name
     3721            ,each term_tt-rule-call-param where
     3722                  term_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     3723              and term_tt-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3724              and term_tt-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3725              and term_tt-rule-call-param.order_id = tt-rule-call-param.order_id
     3726              and term_tt-rule-call-param.param-name = tt-rule-call-param.param-name
     3727         BY tt-rule-call-param.call_id
     3728         BY tt-rule-call-param.codex_id
     3729         BY tt-rule-call-param.ruleset_id
     3730         BY tt-rule-call-param.order_id
     3731         BY tt-rule-call-param.param-num.
     3732     END.
     3733     WHEN 'rp-rule-param':U + chr(44) + 'все':U THEN DO:
     3734         OPEN QUERY br-rcp
     3735         FOR EACH  X_ruledict-param NO-LOCK WHERE X_ruledict-param.entry-id = v-entry-id
     3736             ,first X_rp-rule-param WHERE
     3737                 X_rp-rule-param.profile_id = p-profile-id
     3738             AND X_rp-rule-param.rp-param-name = X_ruledict-param.param-name
     3739           , each tt-rule-call-param WHERE
     3740              tt-rule-call-param.codex_id = X_rp-rule-param.codex_id
     3741          AND tt-rule-call-param.ruleset_id = X_rp-rule-param.ruleset_id
     3742          AND tt-rule-call-param.rule_id = X_rp-rule-param.rule_id
     3743          AND tt-rule-call-param.param-name = X_rp-rule-param.rule-param-name
     3744            ,each term_tt-rule-call-param where
     3745                  term_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     3746              and term_tt-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3747              and term_tt-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3748              and term_tt-rule-call-param.order_id = tt-rule-call-param.order_id
     3749              and term_tt-rule-call-param.param-name = tt-rule-call-param.param-name
     3750         BY tt-rule-call-param.call_id
     3751         BY tt-rule-call-param.codex_id
     3752         BY tt-rule-call-param.ruleset_id
     3753         BY tt-rule-call-param.order_id
     3754         BY tt-rule-call-param.param-num.
     3755     END.
     3756   END CASE.
     3757   apply "ENTRY" to br-rcp in frame Dialog-Frame .
     3758   APPLy "VALUE-CHANGED" to br-rcp.
     3759   RUN OpenbrCAllee IN THIS-PROCEDURE.
     3760   END PROCEDURE.
     3761   PROCEDURE OpenbrCAllee :
     3762   if p-list-mode = 'rp-rule-param':U + chr(44) + 'все':U then do:
     3763     OPEN QUERY br-callee
     3764     FOR EACH call_rp-rule-param NO-LOCK WHERE call_rp-rule-param.rp-param-name = X_rp-rule-param.rp-param-name,
     3765         EACH CALL_tt-rule-call-param WHERE
     3766           CALL_tt-rule-call-param.param-name = call_rp-rule-param.rule-param-name
     3767        and CALL_tt-rule-call-param.codex_id = call_rp-rule-param.codex_id
     3768        and CALL_tt-rule-call-param.ruleset_id = call_rp-rule-param.ruleset_id
     3769        and CALL_tt-rule-call-param.rule_id = call_rp-rule-param.rule_id
     3770        and CALL_tt-rule-call-param.call_id = term_tt-rule-call-param.call_id
     3771        and CALL_tt-rule-call-param.p-index = 0.
     3772   end.
     3773   else do:
     3774     IF AVAILABLE X_rp-rule-param THEN DO:
     3775         OPEN QUERY br-callee
     3776         FOR EACH call_rp-rule-param NO-LOCK WHERE
     3777             call_rp-rule-param.rp-param-name = X_rp-rule-param.rp-param-name,
     3778             EACH CALL_tt-rule-call-param WHERE
     3779               CALL_tt-rule-call-param.param-name = call_rp-rule-param.rule-param-name
     3780             and CALL_tt-rule-call-param.codex_id = call_rp-rule-param.codex_id
     3781             and CALL_tt-rule-call-param.ruleset_id = call_rp-rule-param.ruleset_id
     3782             and CALL_tt-rule-call-param.rule_id = call_rp-rule-param.rule_id
     3783             and CALL_tt-rule-call-param.p-index = 0
     3784               .
     3785     END.
     3786     ELSE DO:
     3787         OPEN QUERY br-callee
     3788         FOR EACH  call_rp-rule-param NO-LOCK WHERE false,
     3789             EACH CALL_tt-rule-call-param WHERE false.
     3790     END.
     3791   end.
     3792   END PROCEDURE.
     3793   PROCEDURE proc-b-add :
     3794   define variable v-ind as integer no-undo .
     3795   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3796   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     3797   define buffer buf_rp-rule-param for ub.rp-rule-param.
     3798   IF NOT AVAILABLE tt-rule-call-param THEN do:
     3799     BELL.
     3800     RETURN.
     3801   END.
     3802   IF lookup("LIST", tt-rule-call-param.param-3-data-type) = 0
     3803   and lookup("SORTED-LIST", tt-rule-call-param.param-3-data-type) = 0
     3804   THEN DO:
     3805     BELL.
     3806     RETURN.
     3807   END.
     3808   IF tt-rule-call-param.p-index <> 0 THEN DO:
     3809     BELL.
     3810     RETURN.
     3811   END.
     3812   find last buf_tt-rule-call-param where
     3813            buf_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     3814        and buf_tt-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3815        and buf_tt-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3816        and buf_tt-rule-call-param.order_id = tt-rule-call-param.order_id
     3817        and buf_tt-rule-call-param.param-num = tt-rule-call-param.param-num no-error .
     3818   if available buf_tt-rule-call-param
     3819   and (lookup("LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     3820        or
     3821        lookup("SORTED-LIST", buf_tt-rule-call-param.param-3-data-type) > 0
     3822        )
     3823   and buf_tt-rule-call-param.p-index > 0 then do:
     3824     v-ind = buf_tt-rule-call-param.p-index.
     3825   end.
     3826   for each buf_rp-rule-param where
     3827           buf_rp-rule-param.rp-param-name = X_rp-rule-param.rp-param-name
     3828       and buf_rp-rule-param.profile_id = X_rp-rule-param.profile_id,
     3829       first buf_tt-rule-call-param where
     3830           buf_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     3831       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3832       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3833       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3834       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3835       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3836       and buf_tt-rule-call-param.once-more = tt-rule-call-param.once-more
     3837       and buf_tt-rule-call-param.p-index = 0
     3838   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3839   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3840   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     3841   :
     3842     create buf2_tt-rule-call-param.
     3843     buffer-copy buf_tt-rule-call-param
     3844     except p-index
     3845     to buf2_tt-rule-call-param
     3846     assign
     3847     buf2_tt-rule-call-param.p-index = v-ind + 1
     3848     .
     3849   end.
     3850   run Openbr in this-procedure .
     3851   END PROCEDURE.
     3852   PROCEDURE proc-b-set :
     3853   define variable v-ind as integer no-undo .
     3854   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     3855   define buffer buf2_tt-rule-call-param for tt-rule-call-param.
     3856   define buffer buf3_tt-rule-call-param for tt-rule-call-param.
     3857   define buffer buf_rp-rule-param for ub.rp-rule-param.
     3858   IF NOT AVAILABLE tt-rule-call-param THEN do:
     3859     BELL.
     3860     RETURN.
     3861   END.
     3862   IF lookup("LIST", tt-rule-call-param.param-3-data-type) = 0
     3863   and lookup("SORTED-LIST", tt-rule-call-param.param-3-data-type) = 0
     3864   THEN DO:
     3865     BELL.
     3866     RETURN.
     3867   END.
     3868   IF tt-rule-call-param.p-index <> 0 THEN DO:
     3869     BELL.
     3870     RETURN.
     3871   END.
     3872   for each buf3_tt-rule-call-param where
     3873            buf3_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     3874        and buf3_tt-rule-call-param.codex_id = tt-rule-call-param.codex_id
     3875        and buf3_tt-rule-call-param.ruleset_id = tt-rule-call-param.ruleset_id
     3876        and buf3_tt-rule-call-param.order_id = tt-rule-call-param.order_id
     3877        and buf3_tt-rule-call-param.param-num = tt-rule-call-param.param-num
     3878   no-lock:
     3879      if      (lookup("LIST", buf3_tt-rule-call-param.param-3-data-type) > 0
     3880         or
     3881               lookup("SORTED-LIST", buf3_tt-rule-call-param.param-3-data-type) > 0
     3882            )
     3883         and buf3_tt-rule-call-param.p-index > 0
     3884      then do:
     3885         v-ind = buf3_tt-rule-call-param.p-index.
     3886         for each buf_rp-rule-param where
     3887                  buf_rp-rule-param.rp-param-name = X_rp-rule-param.rp-param-name
     3888              and buf_rp-rule-param.profile_id = X_rp-rule-param.profile_id
     3889         on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3890         on stop   undo, return error substitute( "&1. stop", vss-workfile )
     3891         on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     3892         :
     3893            find first buf_tt-rule-call-param where
     3894                  buf_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     3895              and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3896              and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3897              and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3898              and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3899              and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3900              and buf_tt-rule-call-param.once-more = tt-rule-call-param.once-more
     3901              and buf_tt-rule-call-param.p-index = v-ind no-error.
     3902            if not avail buf_tt-rule-call-param
     3903            then do:
     3904               find first buf_tt-rule-call-param where
     3905                        buf_tt-rule-call-param.call_id = tt-rule-call-param.call_id
     3906                    and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     3907                    and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     3908                    and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     3909                    and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     3910                    and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     3911                    and buf_tt-rule-call-param.once-more = tt-rule-call-param.once-more
     3912                    and buf_tt-rule-call-param.p-index = 0.
     3913               create buf2_tt-rule-call-param.
     3914               buffer-copy buf_tt-rule-call-param
     3915               except p-index
     3916               to buf2_tt-rule-call-param
     3917               assign
     3918               buf2_tt-rule-call-param.p-index = v-ind
     3919               .
     3920               RUN set-value IN THIS-PROCEDURE (
     3921                                          INPUT buf2_tt-rule-call-param.profile_id
     3922                                         ,INPUT buf2_tt-rule-call-param.once-more
     3923                                         ,INPUT buf_rp-rule-param.rp-param-name
     3924                                         ,INPUT buf2_tt-rule-call-param.call_id
     3925                                         ,INPUT buf2_tt-rule-call-param.codex_id
     3926                                         ,INPUT buf2_tt-rule-call-param.ruleset_id
     3927                                         ,INPUT buf2_tt-rule-call-param.order_id
     3928                                         ,INPUT buf2_tt-rule-call-param.param-name
     3929                                         ,INPUT buf2_tt-rule-call-param.p-index
     3930                                         ,INPUT buf3_tt-rule-call-param.param-value-character
     3931                                         ,INPUT buf3_tt-rule-call-param.param-value-date
     3932                                         ,INPUT buf3_tt-rule-call-param.param-value-decimal
     3933                                         ,INPUT buf3_tt-rule-call-param.param-value-integer
     3934                                         ,INPUT buf3_tt-rule-call-param.param-value-logical).
     3935            end.
     3936         end.
     3937      end.
     3938   end.
     3939   run Openbr in this-procedure .
     3940   END PROCEDURE.
     3941   PROCEDURE proc-b-chg PRIVATE :
     3942   DEFINE VARIABLE v-format AS CHARACTER NO-UNDO.
     3943   DEFINE VARIABLE v-value-character AS CHARACTER NO-UNDO.
     3944   DEFINE VARIABLE v-value-integer AS integer NO-UNDO.
     3945   DEFINE VARIABLE v-value-decimal AS decimal NO-UNDO.
     3946   DEFINE VARIABLE v-value-logical AS logical NO-UNDO.
     3947   DEFINE VARIABLE v-value-date AS date NO-UNDO.
     3948   define variable v-ok as logical no-undo .
     3949   DEFINE VARIABLE v-rec1 AS Rowid NO-UNDO.
     3950   DEFINE VARIABLE v-rec2 AS Rowid NO-UNDO.
     3951   DEFINE VARIABLE v-rec3 AS Rowid NO-UNDO.
     3952   DEFINE VARIABLE v-rec4 AS Rowid NO-UNDO.
     3953   define variable v-param-data-type as character no-undo .
     3954   define variable v-rid-list as character no-undo .
     3955   IF NOT AVAILABLE TERM_tt-rule-call-param  THEN DO:
     3956     RETURN ERROR.
     3957   END.
     3958   v-param-data-type = TERM_tt-rule-call-param.param-data-type +
     3959                       (if term_tt-rule-call-param.param-2-data-type = '':U
     3960                        then '':U
     3961                        else chr(44)) +
     3962                       term_tt-rule-call-param.param-2-data-type
     3963                        .
     3964   if lookup("READ-ONLY", TERM_tt-rule-call-param.param-3-data-type) > 0 then do:
     3965     message
     3966     "Данный параметр задан как READ-ONLY (Только для чтения)" skip
     3967     "Изменения не допускаются"
     3968     view-as alert-box error .
     3969     undo, return error .
     3970   end.
     3971   CASE  v-param-data-type:
     3972     when 'integer':U then do:
     3973       assign
     3974       v-value-integer = term_tt-rule-call-param.param-value-integer.
     3975       run gbl/d-integer.w (
     3976              input ?
     3977             ,input (
     3978             'title=':u + substitute("Изменение параметра &1", term_tt-rule-call-param.param-label) + '\':u
     3979           + 'text1=':u + term_tt-rule-call-param.param-label + '\':u
     3980           + 'format=' + (if term_tt-rule-call-param.param-data-type = 'L':U
     3981                         then "yes/no"
     3982                         else v-format) + '\':u
     3983           + 'fillin_row=3\':u
     3984           + 'fillin_col=4\':u
     3985           + 'fillin_width=20\':u
     3986           + 'fillin_height=1\':u
     3987           + 'max-chars=70\':u
     3988           + 'readonly=' + (if p-mode <> 'ИЗМЕНЕНИЕ':U and p-mode <> 'ДОБАВЛЕНИЕ':U then 'yes':u else 'no':u) + '\':u)
     3989           , input-output v-value-integer
     3990           , output v-ok
     3991               ).
     3992       if not v-ok then return error.
     3993       RUN set-value IN THIS-PROCEDURE (
     3994                                          INPUT term_tt-rule-call-param.profile_id
     3995                                         ,INPUT term_tt-rule-call-param.once-more
     3996                                         ,INPUT (if p-list-mode = 'rp-rule-param':U
     3997                                                then X_rp-rule-param.rp-param-name
     3998                                                else '':U)
     3999                                         ,INPUT term_tt-rule-call-param.call_id
     4000                                         ,INPUT term_tt-rule-call-param.codex_id
     4001                                         ,INPUT term_tt-rule-call-param.ruleset_id
     4002                                         ,INPUT term_tt-rule-call-param.order_id
     4003                                         ,INPUT term_tt-rule-call-param.param-name
     4004                                         ,INPUT term_tt-rule-call-param.p-index
     4005                                         ,INPUT term_tt-rule-call-param.param-value-character
     4006                                         ,INPUT term_tt-rule-call-param.param-value-date
     4007                                         ,INPUT term_tt-rule-call-param.param-value-decimal
     4008                                         ,INPUT v-value-integer
     4009                                         ,INPUT term_tt-rule-call-param.param-value-logical).
     4010     end.
     4011     when 'decimal':U then do:
     4012       assign
     4013       v-value-decimal = term_tt-rule-call-param.param-value-decimal.
     4014       run gbl/d-decimal.w (
     4015              input ?
     4016             ,input (
     4017             'title=':u + substitute("Изменение параметра &1", term_tt-rule-call-param.param-label) + '\':u
     4018           + 'text1=':u + term_tt-rule-call-param.param-label + '\':u
     4019           + 'format=' + (if term_tt-rule-call-param.param-data-type = 'L':U
     4020                         then "yes/no"
     4021                         else v-format) + '\':u
     4022           + 'fillin_row=3\':u
     4023           + 'fillin_col=4\':u
     4024           + 'fillin_width=20\':u
     4025           + 'fillin_height=1\':u
     4026           + 'max-chars=70\':u
     4027           + 'readonly=' + (if p-mode <> 'ИЗМЕНЕНИЕ':U and p-mode <> 'ДОБАВЛЕНИЕ':U then 'yes':u else 'no':u) + '\':u)
     4028           , input-output v-value-decimal
     4029           , output v-ok
     4030               ).
     4031       if not v-ok then return error.
     4032       RUN set-value IN THIS-PROCEDURE (
     4033                                          INPUT term_tt-rule-call-param.profile_id
     4034                                         ,INPUT term_tt-rule-call-param.once-more
     4035                                         ,INPUT (if p-list-mode = 'rp-rule-param':U
     4036                                                then X_rp-rule-param.rp-param-name
     4037                                                else '':U)
     4038                                         ,INPUT term_tt-rule-call-param.call_id
     4039                                         ,INPUT term_tt-rule-call-param.codex_id
     4040                                         ,INPUT term_tt-rule-call-param.ruleset_id
     4041                                         ,INPUT term_tt-rule-call-param.order_id
     4042                                         ,INPUT term_tt-rule-call-param.param-name
     4043                                         ,INPUT term_tt-rule-call-param.p-index
     4044                                         ,INPUT term_tt-rule-call-param.param-value-character
     4045                                         ,INPUT term_tt-rule-call-param.param-value-date
     4046                                         ,INPUT v-value-decimal
     4047                                         ,INPUT term_tt-rule-call-param.param-value-decimal
     4048                                         ,INPUT term_tt-rule-call-param.param-value-logical).
     4049     end.
     4050     when 'character':U then do:
     4051       assign
     4052       v-value-character = term_tt-rule-call-param.param-value-character.
     4053       run gbl/d-character.w (
     4054             input ?
     4055            ,input (
     4056             'title=':u + substitute("Изменение параметра &1", term_tt-rule-call-param.param-label) + '\':u
     4057           + 'text1=':u + term_tt-rule-call-param.param-label + '\':u
     4058           + 'format=' + (if term_tt-rule-call-param.param-data-type = 'L':U
     4059                         then "yes/no"
     4060                         else v-format) + '\':u
     4061           + 'fillin_row=4\':u
     4062           + 'fillin_col=4\':u
     4063           + 'fillin_width=20\':u
     4064           + 'fillin_height=1\':u
     4065           + 'max-chars=70\':u
     4066           + 'readonly=' + (if p-mode <> 'ИЗМЕНЕНИЕ':U and p-mode <> 'ДОБАВЛЕНИЕ':U then 'yes':u else 'no':u) + '\':u)
     4067           , input-output v-value-character
     4068           , output v-ok
     4069               ).
     4070           if not v-ok then return error.
     4071       RUN set-value IN THIS-PROCEDURE (
     4072                                          INPUT term_tt-rule-call-param.profile_id
     4073                                         ,INPUT term_tt-rule-call-param.once-more
     4074                                         ,INPUT (if p-list-mode = 'rp-rule-param':U
     4075                                                then X_rp-rule-param.rp-param-name
     4076                                                else '':U)
     4077                                         ,INPUT term_tt-rule-call-param.call_id
     4078                                         ,INPUT term_tt-rule-call-param.codex_id
     4079                                         ,INPUT term_tt-rule-call-param.ruleset_id
     4080                                         ,INPUT term_tt-rule-call-param.order_id
     4081                                         ,INPUT term_tt-rule-call-param.param-name
     4082                                         ,INPUT term_tt-rule-call-param.p-index
     4083                                        ,INPUT v-value-character
     4084                                        ,INPUT term_tt-rule-call-param.param-value-date
     4085                                        ,INPUT term_tt-rule-call-param.param-value-decimal
     4086                                        ,INPUT term_tt-rule-call-param.param-value-integer
     4087                                        ,INPUT term_tt-rule-call-param.param-value-logical).
     4088     end.
     4089     when 'logical':U then do:
     4090       assign
     4091       v-value-logical = term_tt-rule-call-param.param-value-logical.
     4092       run gbl/d-logical.w (
     4093             input ?
     4094            ,input  (
     4095             'title=':u + substitute("Изменение параметра &1", term_tt-rule-call-param.param-label) + '\':u
     4096           + 'text1=':u + term_tt-rule-call-param.param-label + '\':u
     4097           + 'format=' + (if term_tt-rule-call-param.param-data-type = 'L':U
     4098                         then "yes/no"
     4099                         else v-format) + '\':u
     4100           + 'fillin_row=2\':u
     4101           + 'fillin_col=4\':u
     4102           + 'fillin_width=20\':u
     4103           + 'fillin_height=1\':u
     4104           + 'max-chars=70\':u
     4105           + 'readonly=' + (if p-mode <> 'ИЗМЕНЕНИЕ':U and p-mode <> 'ДОБАВЛЕНИЕ':U then 'yes':u else 'no':u) + '\':u)
     4106           , input-output v-value-logical
     4107           , output v-ok
     4108               ).
     4109       if not v-ok then return error.
     4110       RUN set-value IN THIS-PROCEDURE (
     4111                                          INPUT term_tt-rule-call-param.profile_id
     4112                                         ,INPUT term_tt-rule-call-param.once-more
     4113                                         ,INPUT (if p-list-mode = 'rp-rule-param':U
     4114                                                then X_rp-rule-param.rp-param-name
     4115                                                else '':U)
     4116                                         ,INPUT term_tt-rule-call-param.call_id
     4117                                         ,INPUT term_tt-rule-call-param.codex_id
     4118                                         ,INPUT term_tt-rule-call-param.ruleset_id
     4119                                         ,INPUT term_tt-rule-call-param.order_id
     4120                                         ,INPUT term_tt-rule-call-param.param-name
     4121                                         ,INPUT term_tt-rule-call-param.p-index
     4122                                        ,INPUT term_tt-rule-call-param.param-value-character
     4123                                        ,INPUT term_tt-rule-call-param.param-value-date
     4124                                        ,INPUT term_tt-rule-call-param.param-value-decimal
     4125                                        ,INPUT term_tt-rule-call-param.param-value-integer
     4126                                        ,INPUT v-value-logical).
     4127     end.
     4128     when 'date':U then do:
     4129       assign
     4130       v-value-date = term_tt-rule-call-param.param-value-date.
     4131         run gbl/d-inpday.w
     4132           (input ?
     4133           ,input substitute("Изменение параметра &1", term_tt-rule-call-param.param-label)
     4134           ,input ""
     4135           ,input ""
     4136           ,input-output v-value-date
     4137           ,output v-ok
     4138           ) NO-ERROR.
     4139       if not v-ok then return error.
     4140       RUN set-value IN THIS-PROCEDURE (
     4141                                          INPUT term_tt-rule-call-param.profile_id
     4142                                         ,INPUT term_tt-rule-call-param.once-more
     4143                                         ,INPUT (if p-list-mode = 'rp-rule-param':U
     4144                                                then X_rp-rule-param.rp-param-name
     4145                                                else '':U)
     4146                                         ,INPUT term_tt-rule-call-param.call_id
     4147                                         ,INPUT term_tt-rule-call-param.codex_id
     4148                                         ,INPUT term_tt-rule-call-param.ruleset_id
     4149                                         ,INPUT term_tt-rule-call-param.order_id
     4150                                         ,INPUT term_tt-rule-call-param.param-name
     4151                                         ,INPUT term_tt-rule-call-param.p-index
     4152                                        ,INPUT term_tt-rule-call-param.param-value-character
     4153                                        ,INPUT v-value-date
     4154                                        ,INPUT term_tt-rule-call-param.param-value-decimal
     4155                                        ,INPUT term_tt-rule-call-param.param-value-integer
     4156                                        ,INPUT term_tt-rule-call-param.param-value-logical).
     4157     end.
     4158     otherwise do:
     4159       assign
     4160       v-value-character = term_tt-rule-call-param.param-value-character
     4161       v-value-date = term_tt-rule-call-param.param-value-date
     4162       v-value-decimal = term_tt-rule-call-param.param-value-decimal
     4163       v-value-integer = term_tt-rule-call-param.param-value-integer
     4164       v-value-logical = term_tt-rule-call-param.param-value-logical
     4165       .
     4166       run ref/rule-dtt.p (
     4167                            input parparentproc
     4168                           ,input 'ИЗМЕНЕНИЕ':U
     4169                           ,input p-call-id
     4170                           ,input term_tt-rule-call-param.param-data-type
     4171                           ,input term_tt-rule-call-param.param-2-data-type
     4172                           ,input term_tt-rule-call-param.param-3-data-type
     4173                           ,input term_tt-rule-call-param.p-index
     4174                           ,input-output v-value-character
     4175                           ,input-output v-value-date
     4176                           ,input-output v-value-decimal
     4177                           ,input-output v-value-integer
     4178                           ,input-output v-value-logical
     4179                           ,output v-ok
     4180                           ) no-error.
     4181       if not error-status:error
     4182       and v-ok then do:
     4183         RUN set-value IN THIS-PROCEDURE (
     4184                                          INPUT term_tt-rule-call-param.profile_id
     4185                                         ,INPUT term_tt-rule-call-param.once-more
     4186                                         ,INPUT (if p-list-mode = 'rp-rule-param':U
     4187                                                then X_rp-rule-param.rp-param-name
     4188                                                else '':U)
     4189                                         ,INPUT term_tt-rule-call-param.call_id
     4190                                         ,INPUT term_tt-rule-call-param.codex_id
     4191                                         ,INPUT term_tt-rule-call-param.ruleset_id
     4192                                         ,INPUT term_tt-rule-call-param.order_id
     4193                                         ,INPUT term_tt-rule-call-param.param-name
     4194                                         ,INPUT term_tt-rule-call-param.p-index
     4195                                          ,INPUT v-value-character
     4196                                          ,INPUT v-value-date
     4197                                          ,INPUT v-value-decimal
     4198                                          ,INPUT v-value-integer
     4199                                          ,INPUT v-value-logical).
     4200       end.
     4201     end.
     4202   end case.
     4203   ASSIGN
     4204   v-rec1 = rowid(X_ruledict-param)
     4205   v-rec2 = rowid(X_rp-rule-param)
     4206   v-rec3 = Rowid(tt-rule-call-param)
     4207   v-rec4 = Rowid(term_tt-rule-call-param)
     4208   .
     4209   run openbr in this-procedure .
     4210   REPOSITION br-rcp TO Rowid v-rec1, v-rec2,v-rec3, v-rec4 NO-ERROR.
     4211   IF ERROR-STATUS:ERROR THEN DO:
     4212     REPOSITION br-rcp TO ROW 1 NO-ERROR.
     4213   END.
     4214   APPLY "ENTRY" TO br-rcp in frame Dialog-Frame .
     4215   APPLY "VALUE-CHANGED" TO br-rcp in frame Dialog-Frame .
     4216   END PROCEDURE.
     4217   PROCEDURE proc-b-del :
     4218   define variable v-ind as integer no-undo .
     4219   define variable v-once-more as integer no-undo .
     4220   define variable v-call-id as character no-undo .
     4221   define buffer buf_tt-rule-call-param for tt-rule-call-param.
     4222   define buffer buf_rp-rule-param for ub.rp-rule-param.
     4223   IF NOT AVAILABLE term_tt-rule-call-param THEN do:
     4224     BELL.
     4225     RETURN.
     4226   END.
     4227   IF lookup("LIST", term_tt-rule-call-param.param-3-data-type) = 0
     4228   and lookup("SORTED-LIST", term_tt-rule-call-param.param-3-data-type) = 0
     4229   THEN DO:
     4230     BELL.
     4231     RETURN.
     4232   END.
     4233   IF lookup("READ-ONLY", term_tt-rule-call-param.param-3-data-type) > 0 THEN DO:
     4234     BELL.
     4235     RETURN.
     4236   END.
     4237   IF term_tt-rule-call-param.p-index  = 0 THEN DO:
     4238     BELL.
     4239     RETURN.
     4240   END.
     4241   assign
     4242   v-ind = term_tt-rule-call-param.p-index
     4243   v-once-more = tt-rule-call-param.once-more
     4244   v-call-id = tt-rule-call-param.call_id
     4245   .
     4246   for each buf_rp-rule-param where
     4247           buf_rp-rule-param.rp-param-name = X_rp-rule-param.rp-param-name
     4248       and buf_rp-rule-param.profile_id = X_rp-rule-param.profile_id,
     4249       first buf_tt-rule-call-param where
     4250           buf_tt-rule-call-param.call_id = v-call-id
     4251       and buf_tt-rule-call-param.profile_id = buf_rp-rule-param.profile_id
     4252       and buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     4253       and buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     4254       and buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     4255       and buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     4256       and buf_tt-rule-call-param.once-more = v-once-more
     4257       and buf_tt-rule-call-param.p-index = v-ind
     4258   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4259   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     4260   on endkey undo, return error substitute( "&1. endkey", vss-workfile ):
     4261       DELETE buf_tt-rule-call-param.
     4262   end.
     4263   run Openbr in this-procedure .
     4264   END PROCEDURE.
     4265   PROCEDURE proc-b-lkp :
     4266   define buffer buf_dis-rule for ub.dis-rule.
     4267   define variable v-doc-rec as recid no-undo .
     4268   define variable v-rid-list as character no-undo .
     4269   define variable v-ok as logical no-undo .
     4270   CASE entry(1, term_tt-rule-call-param.param-2-data-type, "_"):
     4271     WHEN 'dis-rule':U THEN DO:
     4272       run ref/show-dr.p ( input parparentproc
     4273                          ,input term_tt-rule-call-param.param-value-integer) no-error.
     4274       if error-status:error then do:
     4275         undo, return error .
     4276       end.
     4277     END.
     4278     WHEN 'r-b':U THEN DO:
     4279     END.
     4280     WHEN 'output-type':U THEN DO:
     4281     END.
     4282     WHEN 'prop-ref':U THEN DO:
     4283       run ref/proprefs.w (   input  parparentproc
     4284                             ,input ""
     4285                             ,input "sum-id"
     4286                             ,input  integer(entry(2, term_tt-rule-call-param.param-2-data-type, "_"))
     4287                             ,input  term_tt-rule-call-param.param-value-character
     4288                             ,input '':U
     4289                             ,input-OUTPUT v-rid-list) NO-ERROR.
     4290     END.
     4291     when 'ext-system':U then do:
     4292       define variable v-int as integer no-undo .
     4293       v-int = term_tt-rule-call-param.param-value-integer.
     4294       run bge/oxmlspci.w ( input parparentproc
     4295                            ,input 'ПРОСМОТР':U
     4296                            ,input-output v-int
     4297                            ,input 0
     4298                            ,output v-ok) no-error.
     4299     end.
     4300     when "xsd" then do:
     4301       define variable v-longchar as longchar no-undo .
     4302       define variable v-part-num as integer no-undo init 1.
     4303       define variable v-clob-db-num as integer no-undo .
     4304       define variable v-int64-id as int64 no-undo .
     4305       define buffer buf_clob-data for ub.clob-data.
     4306       run gbl/file2clb.p ( input 'ПРОСМОТР':U
     4307                           ,input ""
     4308                           ,input ?
     4309                           ,input term_tt-rule-call-param.param-value-character
     4310                           ,input '':U
     4311                           ,input '':U
     4312                           ,input-output v-part-num
     4313                           ,input 'gate':U
     4314                           ,input-output v-clob-db-num
     4315                           ,input-output v-int64-id
     4316                           ,input term_tt-rule-call-param.param-value-character
     4317                           ,input ?
     4318                           ) no-error .
     4319       if error-status :error then do:
     4320         return error return-value .
     4321       end.
     4322       find first buf_clob-data no-lock where
     4323                 buf_clob-data.db-num = v-clob-db-num
     4324             and buf_clob-data.int64-id = v-int64-id.
     4325       run gbl/clbxmlvw.p (  input parparentproc
     4326                             ,input rowid(buf_clob-data)
     4327                             ,input substitute("tmp_&1", buf_clob-data.file-name)
     4328                             ) no-error.
     4329     end.
     4330     when 'list':U
     4331     or when 'list-macro':U
     4332     then do:
     4333       define variable v-res-type as character no-undo .
     4334       v-res-type = entry(1, term_tt-rule-call-param.param-2-data-type, "_").
     4335       run gbl/file2clb.p ( input 'ПРОСМОТР':U
     4336                           ,input ""
     4337                           ,input ?
     4338                           ,input entry(1, term_tt-rule-call-param.param-value-character, "_")
     4339                           ,input entry(2, term_tt-rule-call-param.param-value-character, "_")
     4340                           ,input '':U
     4341                           ,input-output v-part-num
     4342                           ,input v-res-type
     4343                           ,input-output v-clob-db-num
     4344                           ,input-output v-int64-id
     4345                           ,input term_tt-rule-call-param.param-value-character
     4346                           ,input ?
     4347                           ) no-error .
     4348       if error-status :error then do:
     4349         return error return-value .
     4350       end.
     4351       find first buf_clob-data no-lock where
     4352                 buf_clob-data.db-num = v-clob-db-num
     4353             and buf_clob-data.int64-id = v-int64-id.
     4354       assign
     4355       v-longchar = buf_clob-data.cdata.
     4356       run gbl/d-longchar.w (
     4357                              input ?
     4358                             ,input (
     4359                                       'title=':u + "СПИСОК" + '\':u
     4360                                     + 'Editor_row=2\':u
     4361                                     + 'Editor_col=1\':u
     4362                                     + 'Editor_width=96\':u
     4363                                     + 'Editor_height=15\':u
     4364                                     + 'readonly=yes\':u)
     4365                             ,input-output v-longchar
     4366                             ,output v-ok ) no-error .
     4367       assign
     4368       v-longchar = '':U.
     4369     end.
     4370     when "tpl" then do:
     4371       define variable v-recid as recid no-undo .
     4372       define buffer loc_price-list-type for ub.price-list-type.
     4373       if term_tt-rule-call-param.param-value-character <> '' then do:
     4374           find first loc_price-list-type where
     4375                     loc_price-list-type.plt-id = integer(entry(1, term_tt-rule-call-param.param-value-character, "-"))
     4376                  and loc_price-list-type.plt-db-num = integer(entry(2, term_tt-rule-call-param.param-value-character, "-")) no-error.
     4377           if available loc_price-list-type then do:
     4378               v-recid = RECID(loc_price-list-type).
     4379               run ref/tp-price.w ( input parparentproc
     4380                                 ,input NO
     4381                                 ,INPUT 'ПРОСМОТР':U
     4382                                  ,INPUT-OUTPUT v-recid ) NO-ERROR.
     4383           end.
     4384           ELSE DO:
     4385              MESSAGE
     4386              "Тип прайс-листа не определен, возможно удален"
     4387              VIEW-AS ALERT-BOX ERROR.
     4388            END.
     4389       end.
     4390       ELSE DO:
     4391         MESSAGE
     4392         "Тип прайс-листа не определен"
     4393         VIEW-AS ALERT-BOX ERROR.
     4394       END.
     4395     end.
     4396     when "sel-obj" then do:
     4397     end.
     4398   END CASE.
     4399   END PROCEDURE.
     4400   PROCEDURE proc-display-rule :
     4401   DEFINE INPUT PARAMETER p-display-mode AS CHARACTER NO-UNDO.
     4402   define input parameter p-codex-id as integer no-undo .
     4403   define input parameter p-ruleset-id as integer no-undo .
     4404   define input parameter p-call-id as character no-undo .
     4405   define input parameter p-order-id as integer no-undo .
     4406   DEFINE INPUT PARAMETER p-rule-id AS INTEGER NO-UNDO.
     4407     run rul/disprule.p (
     4408                          input p-DISPLAY-MODE
     4409                         ,input p-rule-id
     4410                         ,input p-codex-id
     4411                         ,input p-ruleset-id
     4412                         ,input p-call-id
     4413                         ,input p-order-id
     4414                          ).
     4415   END PROCEDURE.
     4416   PROCEDURE set-row-color :
     4417   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     4418   ASSIGN
     4419   v-ch[1]:FGCOLOR = GREY_COLOR
     4420   v-ch[1]:BGCOLOR = GREY_Color
     4421   v-ch[1]:PFCOLOR = GREY_Color
     4422   v-ch[2]:FGCOLOR = GREY_COLOR
     4423   v-ch[2]:BGCOLOR = GREY_Color
     4424   v-ch[2]:PFCOLOR = GREY_Color
     4425   v-ch[3]:FGCOLOR = GREY_COLOR
     4426   v-ch[3]:BGCOLOR = GREY_Color
     4427   v-ch[3]:PFCOLOR = GREY_Color
     4428   v-ch[4]:FGCOLOR = GREY_COLOR
     4429   v-ch[4]:BGCOLOR = GREY_Color
     4430   v-ch[4]:PFCOLOR = GREY_Color
     4431   v-ch[5]:FGCOLOR = GREY_COLOR
     4432   v-ch[5]:BGCOLOR = GREY_Color
     4433   v-ch[5]:PFCOLOR = GREY_Color
     4434   .
     4435   CASE entry(1, p-data-type):
     4436        WHEN 'character':U THEN DO:
     4437         ASSIGN
     4438         v-ch[1]:FGCOLOR = BLACK_COLOR
     4439         v-ch[1]:BGCOLOR = WHITE_Color.
     4440       END.
     4441       WHEN 'decimal':U THEN DO:
     4442         ASSIGN
     4443         v-ch[3]:FGCOLOR = BLACK_COLOR
     4444         v-ch[3]:BGCOLOR = WHITE_Color.
     4445       END.
     4446       WHEN 'integer':U THEN DO:
     4447         ASSIGN
     4448         v-ch[4]:FGCOLOR = BLACK_COLOR
     4449         v-ch[4]:BGCOLOR = WHITE_Color.
     4450       END.
     4451       WHEN 'date':U THEN DO:
     4452         ASSIGN
     4453         v-ch[2]:FGCOLOR = BLACK_COLOR
     4454         v-ch[2]:BGCOLOR = WHITE_Color.
     4455        END.
     4456        WHEN 'logical':U THEN DO:
     4457          ASSIGN
     4458          v-ch[5]:FGCOLOR = BLACK_COLOR
     4459          v-ch[5]:BGCOLOR = WHITE_Color.
     4460        END.
     4461   END CASE.
     4462   END PROCEDURE.
     4463   PROCEDURE set-value :
     4464   DEFINE INPUT PARAMETER p-profile-id AS integer NO-UNDO.
     4465   DEFINE INPUT PARAMETER p-once-more AS integer NO-UNDO.
     4466   DEFINE INPUT PARAMETER p-rp-param-name AS CHARACTER NO-UNDO.
     4467   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     4468   DEFINE INPUT PARAMETER p-codex-id AS integer NO-UNDO.
     4469   DEFINE INPUT PARAMETER p-ruleset-id AS integer NO-UNDO.
     4470   DEFINE INPUT PARAMETER p-order-id AS integer NO-UNDO.
     4471   DEFINE INPUT PARAMETER p-param-name AS character NO-UNDO.
     4472   DEFINE INPUT PARAMETER p-index AS integer NO-UNDO.
     4473   DEFINE INPUT parameter p-value-character AS CHARACTER NO-UNDO.
     4474   DEFINE INPUT parameter p-value-date AS date NO-UNDO.
     4475   DEFINE INPUT parameter p-value-decimal AS decimal NO-UNDO.
     4476   DEFINE INPUT parameter p-value-integer AS integer NO-UNDO.
     4477   DEFINE INPUT parameter p-value-logical AS logical NO-UNDO.
     4478   DEFINE BUFFER buf_tt-rule-call-param FOR tt-rule-call-param.
     4479   DEFINE BUFFER buf_rp-rule-param FOR ub.rp-rule-param.
     4480   CASE p-list-mode:
     4481     WHEN 'rp-rule-param':U THEN DO:
     4482         FOR EACH  buf_rp-rule-param NO-LOCK where
     4483             buf_rp-rule-param.profile_id = p-profile-id
     4484             AND buf_rp-rule-param.rp-param-name = p-rp-param-name
     4485             ,EACH buf_tt-rule-call-param WHERE
     4486                buf_tt-rule-call-param.profile_id = p-profile-id
     4487             AND buf_tt-rule-call-param.once-more = p-once-more
     4488             AND buf_tt-rule-call-param.call_id = p-CALL-id
     4489             AND buf_tt-rule-call-param.codex_id = buf_rp-rule-param.codex_id
     4490             AND buf_tt-rule-call-param.ruleset_id = buf_rp-rule-param.ruleset_id
     4491             AND buf_tt-rule-call-param.rule_id = buf_rp-rule-param.rule_id
     4492             AND buf_tt-rule-call-param.param-name = buf_rp-rule-param.rule-param-name
     4493             AND buf_tt-rule-call-param.p-index = p-index
     4494           ON error undo, return error :
     4495             assign
     4496             buf_tt-rule-call-param.param-value-character = p-value-character
     4497             buf_tt-rule-call-param.param-value-date      = p-value-date
     4498             buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     4499             buf_tt-rule-call-param.param-value-integer   = p-value-integer
     4500             buf_tt-rule-call-param.param-value-logical   = p-value-logical
     4501             .
     4502         END.
     4503     END.
     4504     WHEN 'rule-call-param':U THEN DO:
     4505       FIND FIRST buf_tt-rule-call-param WHERE
     4506           buf_tt-rule-call-param.call_id = p-call-id
     4507       AND buf_tt-rule-call-param.codex_id = p-codex-id
     4508       AND buf_tt-rule-call-param.ruleset_id = p-ruleset-id
     4509       AND buf_tt-rule-call-param.order_id = p-order-id
     4510       AND buf_tt-rule-call-param.param-name = p-param-name
     4511       AND buf_tt-rule-call-param.p-index = p-index.
     4512       assign
     4513       buf_tt-rule-call-param.param-value-character = p-value-character
     4514       buf_tt-rule-call-param.param-value-date      = p-value-date
     4515       buf_tt-rule-call-param.param-value-decimal   = p-value-decimal
     4516       buf_tt-rule-call-param.param-value-integer   = p-value-integer
     4517       buf_tt-rule-call-param.param-value-logical   = p-value-logical
     4518       .
     4519     END.
     4520   END CASE.
     4521   END PROCEDURE.
