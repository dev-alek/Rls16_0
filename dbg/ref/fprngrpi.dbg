        1   DEFINE BUFFER buf_clients FOR ub.clients.
        2   DEFINE BUFFER buf_fbr-prn FOR ub.fbr-prn.
        3   DEFINE BUFFER buf_gds-grp FOR ub.gds-grp.
        4   DEFINE BUFFER fbr_clients FOR ub.clients.
        5   DEFINE BUFFER loc_fbr-prn-grp FOR ub.fbr-prn-grp.
        6   DEFINE TEMP-TABLE tt-fbr-prn-grp NO-UNDO LIKE ub.fbr-prn-grp.
        7   define input parameter parparentproc as widget-handle no-undo .
        8   define input parameter par-mode as character no-undo.
        9   define input parameter par-call-mode as character no-undo.
       10   define input parameter p-db-num like ub.fbr-prn-grp.db-num no-undo.
       11   define input parameter p-prn-num like ub.fbr-prn-grp.prn-num no-undo.
       12   define input parameter p-obj-type like ub.fbr-prn-grp.obj-type no-undo.
       13   define input parameter p-obj-code like ub.fbr-prn-grp.obj-code no-undo.
       14   define input parameter p-node-code like ub.fbr-prn-grp.node-code no-undo.
       15   define input-output parameter p-rec as recid no-undo.
       16   def var vss-revision    as character no-undo init "$Revision$":U .
       17   def var vss-author      as character no-undo init "$Author$":U .
       18   def var vss-date        as character no-undo init "$Date$":U .
       19   def var vss-workfile    as character no-undo init "$Workfile$":U .
       20   def var vss-archive     as character no-undo init "$Archive$":U .
       21   def var vss-description as character no-undo init "Группа товаров на  принтере кухни-создание, редактирование".
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define new global shared variable g#library  as handle no-undo .
       81   define new global shared variable g#library2 as handle no-undo .
       82   procedure proc-alt-shift-f2:
       83     if not ibs.th.gbl.gbl-var:rcode
       84   then
       85     run gbl\inidebug.p .
       86   end.
       87   procedure proc-alt-shift-f3:
       88     run gbl/prvssinf.p
       89       ( input this-procedure
       90       ) .
       91   end.
       92   define variable v-inform-launched as logical no-undo initial false .
       93   procedure proc-alt-shift-f4:
       94     define variable v-action as character no-undo .
       95     if v-inform-launched = false then do:
       96       assign
       97         v-inform-launched = true
       98       .
       99       run gbl/d-inform.w
      100         (  input self
      101         ,  input this-procedure
      102         , output v-action
      103         ) no-error .
      104       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      105       assign
      106         v-inform-launched = false
      107       .
      108     end.
      109   end.
      110   procedure proc-alt-f1:
      111     run gbl/corrhelp.p
      112       (input this-procedure
      113       ) .
      114   end .
      115   on alt-shift-f2 anywhere do:
      116     run proc-alt-shift-f2.
      117   end.
      118   on alt-shift-f3 anywhere do:
      119     run proc-alt-shift-f3 in this-procedure .
      120   end.
      121   on alt-shift-f4 anywhere do:
      122     run proc-alt-shift-f4 in this-procedure.
      123   end.
      124   on alt-f1 anywhere do:
      125     run proc-alt-f1 in this-procedure .
      126   end.
      127   define variable vss-include-info0 as character format "X(65)" no-undo
      128   initial "@(#)$Workfile$ $Revision$".
      129   procedure grplib-get-full-name :
      130      define input parameter p-node-code  as integer      no-undo.
      131      define output parameter p-full-name as character    no-undo.
      132      do
      133   on error undo, return error
      134   :
      135       define variable v-upper-code    as integer           no-undo.
      136       define buffer buf_gds-grp       for ub.gds-grp.
      137       define buffer buf_upper_gds-grp for ub.gds-grp.
      138       find first buf_gds-grp no-lock
      139            where buf_gds-grp.node-code = p-node-code
      140       no-error.
      141       if not available buf_gds-grp
      142       then do:
      143           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      144       end.
      145       assign
      146           p-full-name  = ""
      147           v-upper-code = 1
      148       .
      149       do while buf_gds-grp.upper-code <> 0
      150       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      151       :
      152           assign
      153               p-full-name  = buf_gds-grp.node-name
      154                            + (if p-full-name <> "" then chr(47) else "")
      155                            + p-full-name
      156               v-upper-code = buf_gds-grp.upper-code
      157           .
      158           find first buf_gds-grp no-lock
      159                where buf_gds-grp.node-code = v-upper-code
      160           no-error.
      161           if not available buf_gds-grp
      162           then do:
      163               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      164                                   + string( v-upper-code )
      165                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      166           end.
      167       end.
      168       assign
      169       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      170       .
      171   end.
      172   end .
      173   procedure grplib-get-node-from-full-name :
      174   define input parameter p-full-name as character no-undo .
      175   define output parameter p-node-code as integer no-undo .
      176   define variable v-ii as integer no-undo .
      177   define variable v-upper-code as integer no-undo .
      178   define variable v-root-code as integer no-undo .
      179   define variable v-entry as character no-undo .
      180   define buffer buf_gds-grp       for ub.gds-grp.
      181   do
      182   on error undo, return error
      183   :
      184     find first buf_gds-grp no-lock
      185         where buf_gds-grp.upper-code = 0
      186     no-error .
      187     if not available buf_gds-grp
      188     then do:
      189         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      190     end.
      191     else do:
      192       assign
      193       v-root-code = buf_gds-grp.node-code
      194       .
      195     end.
      196     v-upper-code = v-root-code.
      197     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      198       assign
      199       v-entry = entry(v-ii, p-full-name, chr(47)).
      200       if v-entry = '' then leave.
      201       find first buf_gds-grp no-lock where
      202                 buf_gds-grp.node-name = v-entry
      203             and buf_gds-grp.upper-code = v-upper-code
      204             no-error.
      205       if not available buf_gds-grp then do:
      206         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      207       end.
      208       else do:
      209         p-node-code = buf_gds-grp.node-code.
      210         v-upper-code = buf_gds-grp.node-code.
      211       end.
      212     end.
      213   end.
      214   end .
      215   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      216     define variable v-cntxt-db-num        as integer   no-undo .
      217     define variable v-cntxt-userid        as character no-undo .
      218     define variable v-cntxt-level         as character no-undo .
      219     define variable v-cntxt-host-code-obj as integer   no-undo .
      220     define variable v-cntxt-obj-type      as character no-undo .
      221     define variable v-cntxt-obj-code      as integer   no-undo .
      222     define variable v-cntxt-db-num-obj    as integer   no-undo .
      223     define variable v-cntxt-is-admin      as logical   no-undo .
      224   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      225   define temp-table userobjs_temp-user-obj no-undo
      226     field obj-type as character
      227     field obj-code as integer
      228     index xpk is primary unique obj-type obj-code
      229     .
      230   procedure userobjs_clear :
      231     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      232     do
      233     on error undo, return error return-value
      234     :
      235       for each buf_userobjs_temp-user-obj
      236       on error undo, return error return-value
      237       :
      238         delete buf_userobjs_temp-user-obj .
      239       end.
      240     end.
      241   end .
      242   procedure userobjs_object-count :
      243     define output parameter p-total-count as integer   no-undo .
      244     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      245     do
      246     on error undo, return error return-value
      247     :
      248       assign
      249         p-total-count = 0
      250       .
      251       for each buf_userobjs_temp-user-obj
      252       on error undo, return error return-value
      253       :
      254         assign
      255           p-total-count = p-total-count + 1
      256         .
      257       end.
      258     end.
      259   end.
      260   procedure userobjs_append :
      261      define input  parameter p-obj-type as character no-undo .
      262      define input  parameter p-obj-code as integer   no-undo .
      263     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      264     do
      265     on error undo, return error return-value
      266     :
      267       find first buf_userobjs_temp-user-obj
      268         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      269           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      270         no-error .
      271       if not available buf_userobjs_temp-user-obj
      272       then do:
      273         create buf_userobjs_temp-user-obj .
      274         assign
      275           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      276           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      277         .
      278       end.
      279     end.
      280   end.
      281   procedure userobjs_object-exist :
      282     define output parameter p-object-exist as logical   no-undo .
      283     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      284     do
      285     on error undo, return error return-value
      286     :
      287       find first buf_userobjs_temp-user-obj
      288         no-error .
      289       if not available buf_userobjs_temp-user-obj
      290       then do:
      291         assign
      292           p-object-exist = false
      293         .
      294       end.
      295       else do:
      296         assign
      297           p-object-exist = true
      298         .
      299       end.
      300     end.
      301   end.
      302   procedure userobjs_transfer :
      303     define input  parameter p-callback-handle as handle no-undo .
      304     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      305     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      306     do
      307     on error undo, return error return-value
      308     :
      309       if valid-handle(p-callback-handle) <> true
      310       then do:
      311         message
      312           vss-workfile vss-revision vss-description skip
      313           "Ошибка задания входных параметров" skip
      314           "Неизвестный указатель на процедуру" skip
      315           view-as alert-box error .
      316         undo, return error return-value .
      317       end.
      318       if p-callback-handle :get-signature("userobjs_append") = ""
      319       then do:
      320         message
      321           vss-workfile vss-revision vss-description skip
      322           "Ошибка задания входных параметров" skip
      323           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      324                     ,p-callback-handle :file-name
      325                     ) skip
      326           view-as alert-box error .
      327         undo, return error return-value .
      328       end.
      329       for each buf_userobjs_temp-user-obj
      330       on error undo, return error return-value
      331       :
      332         run userobjs_append in p-callback-handle
      333           (input  buf_userobjs_temp-user-obj.obj-type
      334           ,input  buf_userobjs_temp-user-obj.obj-code
      335           ) .
      336       end.
      337     end.
      338   end procedure.
      339   procedure userobjs_select-one :
      340      define input  parameter parparentproc     as widget-handle no-undo .
      341      define input  parameter p-db-num          as integer   no-undo .
      342      define input  parameter p-user-id         as character no-undo .
      343      define input  parameter p-host-code-obj   as integer   no-undo .
      344      define input  parameter p-obj-type        as character no-undo .
      345      define input  parameter p-obj-code        as integer   no-undo .
      346      define output parameter p-user-select     as logical   no-undo .
      347      define output parameter p-select-obj-type as character no-undo .
      348      define output parameter p-select-obj-code as character no-undo .
      349     do
      350     on error undo, return error return-value
      351     :
      352       run gbl/userobjs.w
      353         (input  parparentproc
      354         ,input  this-procedure :handle
      355         ,input  p-db-num
      356         ,input  p-user-id
      357         ,input  p-host-code-obj
      358         ,input  p-obj-type
      359         ,input  p-obj-code
      360         ,INPUT  "b-sel"
      361         ,output p-user-select
      362         ,output p-select-obj-type
      363         ,output p-select-obj-code
      364         ) .
      365     end.
      366   end.
