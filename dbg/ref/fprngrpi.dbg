      395   procedure thobjs :
      396      define input        parameter parparentproc     as widget-handle no-undo .
      397      define input        parameter i-bttns           as character     no-undo .
      398      define input        parameter i-list-mode       as character     no-undo.
      399      define input        parameter i-obj-type        as character     no-undo.
      400      define input        parameter i-db-num          as integer       no-undo.
      401      define input        parameter i-host-code       as integer       no-undo.
      402      define input-output parameter p-rid-list        as character     no-undo .
      403   run ref/thobjs.p
      404           ( input parparentproc
      405            ,input  this-procedure :handle
      406           , input i-bttns
      407           , input i-list-mode
      408           , input i-obj-type
      409           , input i-db-num
      410           , input i-host-code
      411           , input-output p-rid-list ) no-error .
      412   end.
      413   define variable v-db-num like ub.db.db-num no-undo.
      414   DEFINE BUTTON B-exit AUTO-GO
      415        LABEL "&Ввод"
      416        SIZE 10 BY 1
      417        BGCOLOR 8 .
      418   DEFINE BUTTON B-grp
      419        IMAGE-UP FILE "btn-down-arrow":U
      420        IMAGE-DOWN FILE "btn-down-arrow":U
      421        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      422        LABEL "Btn 2"
      423        SIZE 3 BY 1.
      424   DEFINE BUTTON B-Help
      425        LABEL "Помо&щь"
      426        SIZE 10 BY 1
      427        BGCOLOR 8 .
      428   DEFINE BUTTON B-printer
      429        IMAGE-UP FILE "btn-down-arrow":U
      430        IMAGE-DOWN FILE "btn-down-arrow":U
      431        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      432        LABEL "Btn 2"
      433        SIZE 3 BY 1.
      434   DEFINE BUTTON b-quit AUTO-END-KEY
      435        LABEL "&Отмена"
      436        SIZE 10 BY 1
      437        BGCOLOR 8 .
      438   DEFINE BUTTON B-shop
      439        IMAGE-UP FILE "btn-down-arrow":U
      440        IMAGE-DOWN FILE "btn-down-arrow":U
      441        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      442        LABEL "Btn 2"
      443        SIZE 3 BY 1.
      444   DEFINE VARIABLE f-obj-name AS CHARACTER FORMAT "X(256)":U
      445         VIEW-AS TEXT
      446        SIZE 45.8 BY .67 NO-UNDO.
      447   DEFINE VARIABLE f-prn-name AS CHARACTER FORMAT "X(40)":U
      448         VIEW-AS TEXT
      449        SIZE 35.9 BY .67 NO-UNDO.
      450   DEFINE VARIABLE fbr-obj-name AS CHARACTER FORMAT "X(256)":U
      451         VIEW-AS TEXT
      452        SIZE 42.4 BY .67 NO-UNDO.
      453   DEFINE VARIABLE grp-name AS CHARACTER FORMAT "X(256)":U
      454         VIEW-AS TEXT
      455        SIZE 59.5 BY .67 NO-UNDO.
      456   DEFINE QUERY Dialog-Frame FOR
      457         tt-fbr-prn-grp SCROLLING.
      458   DEFINE FRAME Dialog-Frame
      459        b-quit AT ROW 1 COL 1
      460        B-exit AT ROW 1 COL 11
      461        B-Help AT ROW 1 COL 54.9
      462        B-grp AT ROW 4.17 COL 62.4
      463        B-shop AT ROW 6.67 COL 19.3
      464        B-printer AT ROW 10.07 COL 47.1
      465        grp-name AT ROW 4.27 COL 1.9 NO-LABEL
      466        tt-fbr-prn-grp.obj-type AT ROW 6.7 COL 2 NO-LABEL
      467              VIEW-AS TEXT
      468             SIZE 7 BY .67
      469        tt-fbr-prn-grp.obj-code AT ROW 6.77 COL 8.5 COLON-ALIGNED NO-LABEL
      470              VIEW-AS TEXT
      471             SIZE 7.1 BY .67
      472        f-obj-name AT ROW 7.83 COL 2.3 NO-LABEL
      473        tt-fbr-prn-grp.prn-num AT ROW 10.27 COL 2.3 NO-LABEL
      474              VIEW-AS TEXT
      475             SIZE 5.5 BY .67
      476        f-prn-name AT ROW 10.3 COL 7.9 COLON-ALIGNED NO-LABEL
      477        fbr-obj-name AT ROW 11.67 COL 22.8 NO-LABEL
      478        "Принтер" VIEW-AS TEXT
      479             SIZE 18.6 BY .67 AT ROW 9.17 COL 2.3
      480             FGCOLOR 4
      481        "Группа товаров" VIEW-AS TEXT
      482             SIZE 17.9 BY .67 AT ROW 2.83 COL 2.4
      483             FGCOLOR 4
      484        "Объект" VIEW-AS TEXT
      485             SIZE 17.9 BY .67 AT ROW 5.43 COL 2.1
      486             FGCOLOR 4
      487        "Установлен:" VIEW-AS TEXT
      488             SIZE 18.6 BY .67 AT ROW 11.57 COL 2.3
      489             FGCOLOR 4
      490        SPACE(44.97) SKIP(0.54)
      491       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      492            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      493            TITLE "Принтер для группы товаров"
      494            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      495   ASSIGN
      496          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      497          FRAME Dialog-Frame:HIDDEN           = TRUE.
      498   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      499   DO:
      500     APPLY "END-ERROR":U TO SELF.
      501   END.
      502   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      503   DO:
      504     run proc-save in this-procedure no-error.
      505     if error-status:error then return no-apply.
      506   END.
      507   ON CHOOSE OF B-grp IN FRAME Dialog-Frame
      508   DO:
      509   define variable rec-list as character no-undo.
      510     run ref/gds-grp.w (input parparentproc
      511                  , input ('терм':U + ',b-sel')
      512                  , input p-obj-type
      513                  , input p-obj-code
      514                  , input-output rec-list).
      515     if rec-list = "" then do:
      516       return no-apply.
      517     end.
      518     FIND first buf_gds-grp WHERE
      519                  recid (buf_gds-grp) = integer (rec-list) No-ERROR.
      520     if not avail buf_gds-grp then do:
      521       return no-apply.
      522     end.
      523     assign
      524     tt-fbr-prn-grp.node-code = buf_gds-grp.node-code
      525     .
      526     RUN grplib-get-full-name in this-procedure (input buf_gds-grp.node-code, output grp-name).
      527   display grp-name
      528   with frame Dialog-Frame.
      529   END.
      530   ON CHOOSE OF B-printer IN FRAME Dialog-Frame
      531   DO:
      532   define variable v-recid as recid no-undo.
      533   run ref/fbr-prns.w (
      534                           input parparentproc
      535                          ,input "db":U
      536                          ,input v-db-num
      537                          ,input "b-sel":U
      538                          ,input-output v-recid
      539   ) no-error.
      540   if error-status:error then return no-apply.
      541   find first buf_fbr-prn where
      542               recid(buf_fbr-prn) = v-recid no-error.
      543   if error-status:error or buf_fbr-prn.db-num <> v-db-num then return no-apply.
      544   find first fbr_clients no-lock where
      545               fbr_clients.obj-type = buf_fbr-prn.fbr-obj-type
      546          AND fbr_clients.obj-code = buf_fbr-prn.fbr-obj-code no-error.
      547   assign
      548   tt-fbr-prn-grp.prn-num = buf_fbr-prn.prn-num
      549   f-prn-name = buf_fbr-prn.prn-name
      550   fbr-obj-name = (if available fbr_clients
      551                            then fbr_clients.obj-name
      552                            else (buf_fbr-prn.fbr-obj-type + string(buf_fbr-prn.fbr-obj-code)))
      553   .
      554   display
      555   f-obj-name
      556   f-prn-name
      557   tt-fbr-prn-grp.prn-num
      558   with frame Dialog-Frame.
      559   END.
      560   ON CHOOSE OF B-shop IN FRAME Dialog-Frame
      561   DO:
      562     define variable v-host-code   as integer   no-undo .
      563     define variable v-user-select as logical   no-undo .
      564     define variable v-obj-type    as character no-undo .
      565     define variable v-obj-code    as integer   no-undo .
      566   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      568     (input  p-obj-type
      569     ,input  p-obj-code
      570     ,output v-host-code
      571     )  .
      572   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      573   run userobjs_select-one in this-procedure
      574     (input  parparentproc
      575     ,input  v-cntxt-db-num
      576     ,input  v-cntxt-userid
      577     ,input  v-host-code
      578     ,input  p-obj-type
      579     ,input  p-obj-code
      580     ,output v-user-select
      581     ,output v-obj-type
      582     ,output v-obj-code
      583     )  .
      584     if v-user-select = true
      585     then do:
      586       find first buf_clients no-lock
      587         where buf_clients.obj-type = v-obj-type
      588           and buf_clients.obj-code = v-obj-code
      589         no-error.
      590       if not available buf_clients then do:
      591         return no-apply.
      592       end.
      593       if buf_clients.db-num <> v-db-num
      594       then do:
      595         message
      596           "Можно выбрать только объект текущей БД"
      597           view-as alert-box error.
      598           return no-apply.
      599       end.
      600       assign
      601         f-obj-name:screen-value = buf_clients.obj-name
      602         tt-fbr-prn-grp.obj-code = buf_clients.obj-code
      603         tt-fbr-prn-grp.obj-type = buf_clients.obj-type
      604       .
      605       display
      606         tt-fbr-prn-grp.obj-code
      607         tt-fbr-prn-grp.obj-type
      608         f-obj-name
      609         with frame Dialog-Frame.
      610     end.
      611   END.
      612   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      613   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      614   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      615   on help of frame Dialog-Frame
      616   do:
      617     run gbl/app_help.p
      618       (input this-procedure :file-name
      619       ,input ''
      620       ,input ?
      621       ) no-error.
      622     if error-status :error then do:
      623       message
      624         "Ошибка при вызове помощи"
      625         error-status :get-message(1)
      626         view-as alert-box .
      627     end.
      628   end.
      629   run minbtn-set in this-procedure .
      630   on choose of b-help in frame Dialog-Frame
      631   do:
      632     apply "help":u to frame Dialog-Frame .
      633   end.
      634   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      635   procedure minbtn-set :
      636       do
      637           on error undo, return error return-value
      638           :
      639           define variable ii              as integer       no-undo .
      640           define variable fh              as widget-handle no-undo .
      641           define variable hh              as widget-handle no-undo .
      642           define variable v-h             as handle        extent 4 no-undo .
      643           define variable v-name-button   as character     no-undo .
      644           define variable v-help-old-x    as decimal       no-undo .
      645           define variable v-help-old-y    as decimal       no-undo .
      646           define variable v-help-old-size as decimal       no-undo .
      647           define variable v-frame-width   as decimal       no-undo .
      648           define variable jj              as integer       no-undo .
      649           do
      650               on error undo, return error
      651               :
      652               assign
      653                   v-frame-width = frame Dialog-Frame:width - 0.3
      654                   fh            = frame Dialog-Frame:first-child
      655                   hh            = fh:first-child
      656                   ii            = 1
      657                   .
      658               do while valid-handle(hh):
      659                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      660                   do:
      661                       case lc(hh:name) :
      662                           when "b-help" then
      663                               do:
      664                                   hh:load-image-up("cmp/b-help.bmp":u) .
      665                                   hh:load-image-down("cmp/b-help.bmp":u) .
      666                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      667                                   hh:TOOLTIP = "Помощь" .
      668                                   v-help-old-x = hh:column .
      669                                   v-help-old-y = hh:row    .
      670                                   v-help-old-size = hh:width .
      671                                   hh:width-chars = 2.5 .
      672                               end.
      673                           when "b-print" then
      674                               do:
      675                                   hh:load-image("cmp/b-print.bmp":u) .
      676                                   hh:TOOLTIP = "Печать" .
      677                                   v-h[ii] = hh:handle .
      678                                   ii = ii + 1 .
      679                                   hh:width-chars = 3 .
      680                               end.
      681                           when "b-history" or
      682                           when "b-hist" then
      683                               do:
      684                                   hh:load-image("cmp/b-hist.bmp":u) .
      685                                   hh:TOOLTIP = "История" .
      686                                   v-h[ii] = hh:handle .
      687                                   ii = ii + 1 .
      688                                   hh:width-chars = 3 .
      689                               end.
      690                           when "b-sch" then
      691                               do:
      692                                   hh:load-image("cmp/b-sch.bmp":u) .
      693                                   hh:TOOLTIP = "Установка Фильтра" .
      694                                   v-h[ii] = hh:handle .
      695                                   ii = ii + 1 .
      696                                   hh:width-chars = 3 .
      697                               end.
      698                           when "b-hist-user" then
      699                               do:
      700                                   hh:load-image("cmp/b-hist.bmp":u) .
      701                                   hh:TOOLTIP = "История пользователя" .
      702                                   ii = ii + 1 .
      703                               end.
      704                       end case.
      705                   end.
      706                   hh = hh:next-sibling.
      707               end.
      708               b-help:column = v-frame-width - b-help:width-chars.
      709               jj = 0.
      710               repeat ii = 4 to 1 by -1 :
      711                   if valid-handle (v-h[ii] ) then
      712                   do:
      713                       jj  = jj + 1 .
      714                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      715                       v-h[ii]:row    = v-help-old-y .
      716                   end.
      717               end.
      718           end.
      719       end.
      720   end procedure.
      721   MAIN-BLOCK:
      722   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      723      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      724   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      725     run mainmenu_getcntxt in parparentproc
      726       (output v-cntxt-db-num
      727       ,output v-cntxt-userid
      728       ,output v-cntxt-level
      729       ,output v-cntxt-host-code-obj
      730       ,output v-cntxt-obj-type
      731       ,output v-cntxt-obj-code
      732       ,output v-cntxt-db-num-obj
      733       ,output v-cntxt-is-admin
      734       ) .
      735      if par-mode <> 'ИЗМЕНЕНИЕ':U and par-mode <> 'ДОБАВЛЕНИЕ':U then do:
      736       message
      737       vss-workfile vss-revision vss-description skip
      738        "Неверный параметр вызова par-mode" par-mode
      739       view-as alert-box ERROR.
      740       return error.
      741     end.
      742     if par-mode = 'ДОБАВЛЕНИЕ':U
      743     AND  (par-call-mode <> "group":U
      744           and par-call-mode <> "printer":U )
      745     then do:
      746         message
      747           vss-workfile vss-revision vss-description skip
      748            "Неверный параметр вызова par-call-mode" par-call-mode
      749           view-as alert-box ERROR.
      750           return error.
      751     end.
      752   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      753   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      754     (output v-db-num
      755     )  .
      756     run fill-tables in this-procedure.
      757     RUN Myenable in this-procedure.
      758     WAIT-FOR GO OF FRAME Dialog-Frame.
      759   END.
      760   RUN disable_UI.
      761   PROCEDURE disable_UI :
      762     HIDE FRAME Dialog-Frame.
      763   END PROCEDURE.
      764   PROCEDURE enable_UI :
      765     OPEN QUERY Dialog-Frame FOR EACH tt-fbr-prn-grp SHARE-LOCK.
      766     GET FIRST Dialog-Frame.
      767     DISPLAY grp-name f-obj-name f-prn-name fbr-obj-name
      768         WITH FRAME Dialog-Frame.
      769     IF AVAILABLE tt-fbr-prn-grp THEN
      770       DISPLAY tt-fbr-prn-grp.obj-type tt-fbr-prn-grp.obj-code tt-fbr-prn-grp.prn-num
      771         WITH FRAME Dialog-Frame.
      772     ENABLE b-quit B-exit B-Help B-grp B-shop B-printer grp-name
      773            tt-fbr-prn-grp.obj-type tt-fbr-prn-grp.obj-code f-obj-name
      774            tt-fbr-prn-grp.prn-num f-prn-name fbr-obj-name
      775         WITH FRAME Dialog-Frame.
      776     VIEW FRAME Dialog-Frame.
      777   END PROCEDURE.
      778   PROCEDURE Fill-tables :
      779   CASE par-mode:
      780     when 'ДОБАВЛЕНИЕ':U then do:
      781       CASE par-call-mode:
      782         when "group":U then do:
      783           create tt-fbr-prn-grp .
      784           assign
      785           tt-fbr-prn-grp.node-code = p-node-code
      786           .
      787         end.
      788         when "printer":U then do:
      789           create tt-fbr-prn-grp.
      790           assign
      791           tt-fbr-prn-grp.prn-num = p-prn-num.
      792         end.
      793       END CASE.
      794     end.
      795     when 'ИЗМЕНЕНИЕ':U then do:
      796       find first loc_fbr-prn-grp exclusive-lock where
      797                   recid(loc_fbr-prn-grp ) = p-rec no-error.
      798       if not available loc_fbr-prn-grp then do:
      799         message
      800         vss-workfile vss-revision vss-description skip
      801         "Неверное значение параметра p-rec" p-rec
      802         view-as alert-box error.
      803         return error.
      804       end.
      805       find first buf_gds-grp no-lock where
      806                  buf_gds-grp.node-code = p-node-code no-error .
      807       if not avail buf_gds-grp then do:
      808         message
      809         vss-workfile vss-revision vss-description skip
      810         "Неверное значение параметра p-node-code" p-node-code
      811         view-as alert-box error.
      812         return error.
      813       end.
      814       find first buf_clients no-lock where
      815                 buf_clients.obj-type = loc_fbr-prn-grp.obj-type
      816             AND buf_clients.obj-code = loc_fbr-prn-grp.obj-code no-error.
      817       if buf_clients.db-num <> v-db-num then do:
      818         message
      819         vss-workfile vss-revision vss-description skip
      820         "Нельзя редактировать запись, принадлежащую другой БД"
      821         "номер узла групп товаров" loc_fbr-prn-grp.node-code skip
      822         "объект" loc_fbr-prn-grp.obj-type loc_fbr-prn-grp.obj-code skip
      823         "принтер" loc_fbr-prn-grp.prn-num
      824         view-as alert-box error.
      825         return error.
      826       end.
      827       create tt-fbr-prn-grp.
      828       buffer-copy loc_fbr-prn-grp to tt-fbr-prn-grp.
      829     end.
      830   END CASE.
      831   END PROCEDURE.
      832   PROCEDURE MyEnable :
      833   assign
      834   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + par-mode
      835   .
      836   CASE par-mode:
      837     when 'ДОБАВЛЕНИЕ':U then do:
      838       CASE par-call-mode:
      839         when "group":U then do:
      840           run grplib-get-full-name  in this-procedure(
      841                                                       input tt-fbr-prn-grp.node-code
      842                                                     ,output grp-name).
      843         end.
      844         when "printer":U then do:
      845           find first buf_fbr-prn where
      846                       buf_fbr-prn.prn-num = tt-fbr-prn-grp.prn-num
      847                   AND buf_fbr-prn.db-num = v-db-num .
      848           assign
      849           f-prn-name = buf_fbr-prn.prn-name
      850           .
      851           find first fbr_clients no-lock where
      852                     fbr_clients.obj-type = buf_fbr-prn.fbr-obj-type
      853                 AND fbr_clients.obj-code = buf_fbr-prn.fbr-obj-code.
      854           assign
      855           fbr-obj-name = fbr_clients.obj-name
      856           .
      857         end.
      858       END CASE.
      859     end.
      860     when 'ИЗМЕНЕНИЕ':U then do:
      861       find first buf_fbr-prn where
      862                 buf_fbr-prn.prn-num = tt-fbr-prn-grp.prn-num
      863             AND buf_fbr-prn.db-num = v-db-num.
      864       assign
      865       f-prn-name = buf_fbr-prn.prn-name
      866       .
      867       run grplib-get-full-name  in this-procedure(
      868                                                   input tt-fbr-prn-grp.node-code
      869                                                  ,output grp-name).
      870       find first fbr_clients no-lock where
      871                 fbr_clients.obj-type = buf_fbr-prn.fbr-obj-type
      872             AND fbr_clients.obj-code = buf_fbr-prn.fbr-obj-code.
      873       assign
      874       fbr-obj-name = fbr_clients.obj-name
      875       .
      876       assign
      877       frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + grp-name
      878       .
      879     end.
      880   END CASE.
      881     DISPLAY
      882     grp-name
      883     f-obj-name
      884     f-prn-name
      885     fbr-obj-name
      886     WITH FRAME Dialog-Frame.
      887     IF AVAILABLE tt-fbr-prn-grp THEN
      888     DISPLAY
      889     tt-fbr-prn-grp.obj-type
      890     tt-fbr-prn-grp.obj-code
      891     tt-fbr-prn-grp.prn-num
      892     WITH FRAME Dialog-Frame.
      893     ENABLE
      894     b-quit
      895     B-exit
      896     B-Help
      897     B-grp when par-mode = 'ДОБАВЛЕНИЕ':U and par-call-mode = "printer":U
      898     B-shop when par-mode = 'ДОБАВЛЕНИЕ':U
      899     B-printer when par-call-mode = "group"
      900     WITH FRAME Dialog-Frame.
      901     VIEW FRAME Dialog-Frame.
      902   END PROCEDURE.
      903   PROCEDURE proc-save :
      904   run ref/fprngrp1.p (
      905                       input-output p-rec
      906                       ,input par-mode
      907                       ,input tt-fbr-prn-grp.db-num
      908                       ,input tt-fbr-prn-grp.prn-num
      909                       ,input tt-fbr-prn-grp.obj-type
      910                       ,input tt-fbr-prn-grp.obj-code
      911                       ,input tt-fbr-prn-grp.node-code
      912                       ) no-error.
      913   if error-status:error then do:
      914       CASE return-value:
      915           when "node-code":U then do:
      916               APPLY "ENTRY" to b-grp in frame Dialog-Frame.
      917           end.
      918           when "obj-type":U or when "obj-code":U then do:
      919              APPLY "ENTRY" to b-shop.
      920           end.
      921           when "prn-num" then do:
      922                APPLY "ENTRY" to b-printer.
      923           end.
      924       END CASE.
      925       return error.
      926   end.
      927   END PROCEDURE.
