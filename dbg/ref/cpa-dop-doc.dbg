        1   define input parameter parparentproc as widget-handle no-undo.
        2   define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
        3   define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
        4   define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
        5   define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
        6   define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
        7   define input-output parameter p-attr-value as character no-undo.
        8   define output parameter p-ok as logical no-undo.
        9   def var vss-revision    as character no-undo init "$Revision$":U .
       10   def var vss-author      as character no-undo init "$Author$":U .
       11   def var vss-date        as character no-undo init "$Date$":U .
       12   def var vss-workfile    as character no-undo init "$Workfile$":U .
       13   def var vss-archive     as character no-undo init "$Archive$":U .
       14   def var vss-description as character no-undo init "Задание атрибута дополнительного документа".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   DEFINE BUTTON btn-cli
       74        IMAGE-UP FILE "btn-down-arrow":U
       75        IMAGE-DOWN FILE "btn-down-arrow":U
       76        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
       77        LABEL "r-acc"
       78        SIZE 3 BY 1.
       79   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
       80        LABEL "Выход"
       81        SIZE 8 BY .96
       82        BGCOLOR 8 .
       83   DEFINE BUTTON Btn_OK AUTO-GO
       84        LABEL "Сохранить"
       85        SIZE 10 BY .96
       86        BGCOLOR 8 .
       87   DEFINE VARIABLE cb-doc-type AS CHARACTER FORMAT "X(256)":U
       88        LABEL "Тип документа"
       89        VIEW-AS COMBO-BOX INNER-LINES 5
       90        LIST-ITEM-PAIRS "Item 1","Item 1"
       91        DROP-DOWN-LIST
       92        SIZE 23 BY 1 NO-UNDO.
       93   DEFINE VARIABLE FILL-IN-cli AS CHARACTER FORMAT "X(256)":U
       94        VIEW-AS FILL-IN
       95        SIZE 12 BY .96 NO-UNDO.
       96   DEFINE FRAME Dialog-Frame
       97        Btn_Cancel AT ROW 1 COL 1
       98        Btn_OK AT ROW 1 COL 11
       99        cb-doc-type AT ROW 2.17 COL 1.57 WIDGET-ID 4
      100        FILL-IN-cli AT ROW 3.39 COL 23 COLON-ALIGNED NO-LABEL WIDGET-ID 8
      101        btn-cli AT ROW 3.39 COL 37 WIDGET-ID 10
      102        "Контрагент:" VIEW-AS TEXT
      103             SIZE 13 BY .96 AT ROW 3.39 COL 2 WIDGET-ID 6
      104        SPACE(27.79) SKIP(0.74)
      105       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      106            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      107            TITLE "Создание дополнительного документа"
      108            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
      109   ASSIGN
      110          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      111          FRAME Dialog-Frame:HIDDEN           = TRUE.
      112   ASSIGN
      113          FILL-IN-cli:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      114   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      115   DO:
      116           APPLY "END-ERROR":U TO SELF.
      117       END.
      118   ON CHOOSE OF btn-cli IN FRAME Dialog-Frame
      119   DO:
      120           define variable v-ok       as logical   no-undo.
      121           define variable v-cli-type as character no-undo.
      122           define variable v-cli-code as integer   no-undo.
      123           run ref/selcli.p(
      124               parparentproc,
      125               ?,
      126               'орг':U,
      127               false,
      128               output v-ok,
      129               output v-cli-type,
      130               output v-cli-code
      131           ).
      132           if v-ok then
      133               FILL-IN-cli:screen-value = v-cli-type + " " + string(v-cli-code).
      134   END.
      135   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      136   DO:
      137                   RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      138                   IF ERROR-STATUS:ERROR THEN
      139                   DO:
      140                       RETURN NO-APPLY.
      141                   END.
      142               END.
      143           IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      144               THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      145           MAIN-BLOCK:
      146           DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      147               ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      148               RUN enable_UI.
      149               run proc-load.
      150               WAIT-FOR GO OF FRAME Dialog-Frame.
      151           END.
      152           RUN disable_UI.
      153   PROCEDURE disable_UI :
      154     HIDE FRAME Dialog-Frame.
      155   END PROCEDURE.
      156   PROCEDURE enable_UI :
      157     DISPLAY cb-doc-type FILL-IN-cli
      158         WITH FRAME Dialog-Frame.
      159     ENABLE Btn_Cancel Btn_OK cb-doc-type btn-cli
      160         WITH FRAME Dialog-Frame.
      161     VIEW FRAME Dialog-Frame.
      162   END PROCEDURE.
      163   PROCEDURE proc-load :
      164   define variable i      as integer   no-undo.
      165       define variable v-list as character no-undo.
      166       do with frame Dialog-Frame:
      167           do i = 1 to num-entries ('swo':U + ',' + 'trf':U + ',' + 'vir':U + ',none'):
      168               v-list = v-list + subst(",&1,&2", entry(i, 'Списание,ТехПролив,Перемещение в вирт.рез.,Не создавать'), i).
      169           end.
      170           cb-doc-type:list-item-pairs = trim(v-list, ",").
      171           if p-attr-value <> "" then
      172           do:
      173               FILL-IN-cli:screen-value = entry(2, p-attr-value) + " " + entry(3, p-attr-value).
      174               cb-doc-type:screen-value = string(lookup(entry(1, p-attr-value), 'swo':U + ',' + 'trf':U + ',' + 'vir':U + ',none')).
      175           end.
      176           else
      177           do:
      178               cb-doc-type:screen-value = string(lookup('swo':U, 'swo':U + ',' + 'trf':U + ',' + 'vir':U + ',none')).
      179           end.
      180       end.
      181   end procedure.
      182   PROCEDURE proc-save :
      183       define variable v-cli-type as character no-undo.
      184       define variable v-cli-code as integer no-undo.
      185       do with frame Dialog-Frame:
      186           v-cli-type = ''.
      187           v-cli-code = 0.
      188           assign
      189           v-cli-type = entry(1, FILL-IN-cli:screen-value, " ")
      190           v-cli-code = int(entry(2, FILL-IN-cli:screen-value, " ")) no-error.
      191           p-attr-value = entry(int(cb-doc-type:input-value), 'swo':U + ',' + 'trf':U + ',' + 'vir':U + ',none') +
      192                          ',' +
      193                          v-cli-type +
      194                          "," +
      195                          string(v-cli-code).
      196           p-ok = yes.
      197       end.
      198   end procedure.
