      757   define variable rid-list    as  character no-undo .
      758   define variable log-res     as log no-undo.
      759   define variable rr          as recid no-undo.
      760   define variable v-log       as logical   no-undo .
      761   define variable line-mode   as character no-undo .
      762   define variable doc-rec     as recid no-undo .
      763   define variable gds-rec     as recid no-undo .
      764   define variable lns-cnt     as integer   no-undo .
      765   define variable g#log       as logical   no-undo .
      766   define variable varschartic like ub.price-list.artic initial " " no-undo.
      767   define variable ref-list    as character                     no-undo.
      768   define variable sch-field   as character no-undo.
      769   define variable sort-column-name as character no-undo .
      770   define variable list-option as character no-undo.
      771   define variable v-del       as logical no-undo .
      772   define variable v-rid-list  as character no-undo COLUMN-LABEL "*" .
      773   define stream sout.
      774   define temp-table tt-gds-list no-undo like ub.goods
      775   field nn as integer
      776   index by-nn nn
      777   index by_gds-code gds-code
      778   .
      779   define temp-table temp-goods no-undo
      780     field gds-code as integer
      781     index xpk is primary unique gds-code
      782     .
      783   define buffer buf_goods-attr          for ub.goods-attr.
      784   define buffer buf_goods               for ub.goods.
      785   define buffer buf_sum-group-attr      for ub.sum-group-attr.
      786   FUNCTION mark-string RETURNS CHARACTER
      787     ( p-gds-code as integer)  FORWARD.
      788   DEFINE BUTTON b-add
      789        LABEL "&Добавить":L
      790        SIZE 10 BY 1.
      791   DEFINE BUTTON b-del
      792        LABEL "&Удалить":L
      793        SIZE 10 BY 1.
      794   DEFINE BUTTON b-exit AUTO-GO
      795        LABEL "&Выход ":L
      796        SIZE 10 BY 1.
      797   DEFINE BUTTON b-help
      798        LABEL "Помо&щь":L
      799        SIZE 10 BY 1.
      800   DEFINE BUTTON b-mark
      801        LABEL "&*":L
      802        SIZE 3 BY 1.
      803   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>>9":U INITIAL 0
      804        VIEW-AS FILL-IN
      805        SIZE 6 BY 1 NO-UNDO.
      806   DEFINE BUTTON b-print
      807        LABEL "Пе&чать":L
      808        SIZE 10 BY 1.
      809   DEFINE VARIABLE FILL-IN-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Поиск по"
      810         VIEW-AS TEXT
      811        SIZE 8.88 BY .67 NO-UNDO.
      812   DEFINE VARIABLE s-artic AS CHARACTER FORMAT "X(256)":U
      813        VIEW-AS FILL-IN
      814        SIZE 29.88 BY 1 NO-UNDO.
      815   DEFINE VARIABLE s-code AS CHARACTER FORMAT "X(256)":U
      816        VIEW-AS FILL-IN
      817        SIZE 29.88 BY 1 NO-UNDO.
      818   DEFINE VARIABLE s-name AS CHARACTER FORMAT "X(256)":U
      819        VIEW-AS FILL-IN
      820        SIZE 29.88 BY 1 NO-UNDO.
      821   DEFINE VARIABLE s-name-cnt AS CHARACTER FORMAT "X(256)":U
      822        LABEL ""
      823        VIEW-AS FILL-IN
      824        SIZE 29.88 BY 1 NO-UNDO.
      825   DEFINE VARIABLE r-sort AS INTEGER
      826        VIEW-AS RADIO-SET HORIZONTAL
      827        RADIO-BUTTONS
      828             "Код", 1,
      829   "Артикул", 2,
      830   "Нач.назв", 3
      831        SIZE 38.75 BY .96 TOOLTIP "Поиск по" NO-UNDO.
      832   DEFINE QUERY BROWSE-2 FOR
      833         goods-attr,
      834         goods SCROLLING.
      835   DEFINE BROWSE BROWSE-2
      836     QUERY BROWSE-2 NO-LOCK DISPLAY
      837         mark-string(goods.gds-code) @ v-rid-list FORMAT "X(3)":U
      838         goods.artic FORMAT "X(16)":U
      839         goods.gds-name FORMAT "X(46)":U
      840         goods.gds-code FORMAT "999999999":U
      841       WITH NO-ROW-MARKERS SEPARATORS SIZE 79.5 BY 18.92
      842            BGCOLOR 15 .
      843   DEFINE FRAME Dialog-Frame
      844        b-exit AT ROW 1 COL 1
      845        b-mark AT ROW 1 COL 11 WIDGET-ID 16
      846        b-add AT ROW 1 COL 14.13
      847        b-del AT ROW 1 COL 24.13
      848        b-print AT ROW 1 COL 60.75
      849        b-help AT ROW 1 COL 70.75
      850        r-sort AT ROW 2.04 COL 10.75 NO-LABEL WIDGET-ID 4
      851        s-artic AT ROW 2.04 COL 49 COLON-ALIGNED NO-LABEL WIDGET-ID 10
      852        s-name AT ROW 2.04 COL 49 COLON-ALIGNED NO-LABEL WIDGET-ID 8
      853        s-name-cnt AT ROW 2.04 COL 49 COLON-ALIGNED WIDGET-ID 12
      854        s-code AT ROW 2.04 COL 49 COLON-ALIGNED NO-LABEL WIDGET-ID 14
      855        BROWSE-2 AT ROW 3.21 COL 1.5
      856        FILL-IN-2 AT ROW 2.21 COL 1 NO-LABEL WIDGET-ID 2
      857        SPACE(72.11) SKIP(20.61)
      858       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      859            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      860            TITLE "Товары ".
      861   ASSIGN
      862          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      863          FRAME Dialog-Frame:HIDDEN           = TRUE.
      864   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      865   DO:
      866     APPLY "END-ERROR":U TO SELF.
      867   END.
      868   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      869   DO:
      870   assign
      871     line-mode = 'ДОБАВЛЕНИЕ':U
      872   .
      873   run str/chsgdsls.w
      874   (   input parParentProc ,
      875       input "p-attr-code" ,
      876       input "Группа товаров на кассе: " + p-name  ,
      877       input ? ,
      878       input ? ,
      879       input v-cntxt-host-code-obj,
      880       input-output varschartic,
      881       output ref-list,
      882       output table tt-gds-list,
      883       false )
      884       .
      885       if ref-list <> "" then do:
      886          run cycle-add in this-procedure no-error.
      887         if error-status:error then do:
      888            message
      889               vss-workfile vss-revision vss-description skip
      890               "Ошибка при вызове процедуры создания товара" skip
      891               error-status :get-message(1) skip
      892               return-value skip
      893               view-as alert-box error .
      894            return no-apply.
      895         end.
      896          OPEN QUERY BROWSE-2 FOR EACH goods-attr       WHERE goods-attr.attr-code = p-attr-code and goods-attr.attr-value = p-attr-value NO-LOCK,       EACH goods WHERE goods.gds-code = goods-attr.gds-code NO-LOCK     .
      897       end.
      898   END.
      899   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      900   DO:
      901   define variable g-log as logical   no-undo .
      902   define buffer buf_temp-goods for temp-goods .
      903   define variable v-del as logical   no-undo .
      904   if not available goods-attr then  return no-apply.
      905         message "Удалить запись ? "
      906         view-as alert-box question
      907         buttons yes-no
      908         update g-log.
      909         if g-log = false then return no-apply.
      910     define variable v-recid as integer no-undo .
      911     define variable ii as integer no-undo .
      912     define variable cur-number as integer no-undo.
      913        for each temp-goods:
      914           run gds-attr-delete (input temp-goods.gds-code
      915                       ,input p-attr-code
      916                       ,output v-del
      917                       ) no-error.
      918        end.
      919         if not v-del then do:
      920           find current goods-attr exclusive-lock no-error .
      921             run gds-attr-delete (input goods-attr.gds-code
      922                                 ,input p-attr-code
      923                                 ,output g-log
      924                                 ) no-error.
      925         end.
      926     apply "HOME" to BROWSE-2 in frame Dialog-Frame.
      927   END.
      928   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      929   DO:
      930     run choose-mark in this-procedure
      931       no-error .
      932     if error-status :error
      933     then do:
      934       return no-apply .
      935     end.
      936   END.
      937   ON VALUE-CHANGED OF r-sort IN FRAME Dialog-Frame
      938   DO:
      939     Assign frame Dialog-Frame r-sort.
      940     case r-sort :
      941     when 1 then do:
      942           if sch-field = "s-name-cnt" then do:
      943                          assign frame Dialog-Frame:title = "Товары >> Группа товаров на кассе - " + p-name.
      944                         OPEN QUERY BROWSE-2 FOR EACH goods-attr       WHERE goods-attr.attr-code = p-attr-code and goods-attr.attr-value = p-attr-value NO-LOCK,       EACH goods WHERE goods.gds-code = goods-attr.gds-code NO-LOCK     .
      945                         end.
      946           enable s-code with frame Dialog-Frame.
      947               Hide s-name  s-name-cnt s-artic in frame Dialog-Frame.
      948           display s-code with frame Dialog-Frame.
      949           apply "entry" to s-code in frame Dialog-Frame.
      950      end.
      951     when 2 then do:
      952           if sch-field = "s-name-cnt" then do:
      953                          assign frame Dialog-Frame:title = "Товары >> Группа товаров на кассе - " + p-name.
      954                         OPEN QUERY BROWSE-2 FOR EACH goods-attr       WHERE goods-attr.attr-code = p-attr-code and goods-attr.attr-value = p-attr-value NO-LOCK,       EACH goods WHERE goods.gds-code = goods-attr.gds-code NO-LOCK     .
      955                         end.
      956           enable s-artic with frame Dialog-Frame.
      957               Hide s-name  s-name-cnt s-code in frame Dialog-Frame.
      958           display s-artic with frame Dialog-Frame.
      959           apply "entry" to s-artic in frame Dialog-Frame.
      960      end.
      961     when 3 then do:
      962       if sch-field = "s-name-cnt" then do:
      963                    assign frame Dialog-Frame:title = "Товары >> Группа товаров на кассе - " + p-name.
      964                   OPEN QUERY BROWSE-2 FOR EACH goods-attr       WHERE goods-attr.attr-code = p-attr-code and goods-attr.attr-value = p-attr-value NO-LOCK,       EACH goods WHERE goods.gds-code = goods-attr.gds-code NO-LOCK     .
      965                   end.
      966           enable s-name with frame Dialog-Frame.
      967           hide s-artic  s-name-cnt s-code in frame Dialog-Frame.
      968           display s-name with frame Dialog-Frame.
      969           apply "entry" to s-name in frame Dialog-Frame.
      970      end.
      971     when 4 then do:
      972           enable s-name-cnt with frame Dialog-Frame.
      973           hide s-artic  s-name s-code in frame Dialog-Frame.
      974           display s-name-cnt with frame Dialog-Frame.
      975           apply "entry" to s-name-cnt in frame Dialog-Frame.
      976      end.
      977     end case.
      978   END.
      979   ON MOUSE-SELECT-DBLCLICK OF s-artic IN FRAME Dialog-Frame
      980   OR  RETURN OF s-artic IN FRAME Dialog-Frame
      981   DO:
      982     if s-artic <> input frame Dialog-Frame s-artic or sch-field <> "s-artic" then do:
      983    sch-field = "s-artic".
      984    assign s-artic = input frame Dialog-Frame s-artic.
      985    doc-rec = ?.
      986    for each buf_goods-attr where buf_goods-attr.attr-code = p-attr-code,
      987               first buf_goods where buf_goods-attr.gds-code = buf_goods.gds-code and
      988                                     buf_goods.artic begins s-artic :
      989            doc-rec = recid(buf_goods-attr) .
      990            leave.
      991    end.
      992     if doc-rec = ? then message "Товар не найден !"  .
      993     else
      994         reposition BROWSE-2 to recid doc-rec no-error.
      995   return no-apply.
      996   end.
      997   END.
      998   ON MOUSE-SELECT-DBLCLICK OF s-code IN FRAME Dialog-Frame
      999   OR  RETURN OF s-code IN FRAME Dialog-Frame
     1000   DO:
     1001     if s-code <> input frame Dialog-Frame s-code or sch-field <> "s-code" then do:
     1002    sch-field = "s-code".
     1003    assign s-code = input frame Dialog-Frame s-code.
     1004    doc-rec = ?.
     1005    for each buf_goods-attr where buf_goods-attr.attr-code = p-attr-code,
     1006               first buf_goods where buf_goods-attr.gds-code = buf_goods.gds-code and
     1007                                     buf_goods.gds-code = integer(s-code) :
     1008            doc-rec = recid(buf_goods-attr) .
     1009            leave.
     1010    end.
     1011     if doc-rec = ? then message "Товар не найден !"  .
     1012     else
     1013         reposition BROWSE-2 to recid doc-rec no-error.
     1014   return no-apply.
     1015   end.
     1016   END.
     1017   ON MOUSE-SELECT-DBLCLICK OF s-name IN FRAME Dialog-Frame
     1018   OR  RETURN OF s-name IN FRAME Dialog-Frame
     1019   DO:
     1020     if s-name <> input frame Dialog-Frame s-name or sch-field <> "s-name" then do:
     1021    sch-field = "s-name".
     1022    assign s-name = input frame Dialog-Frame s-name.
     1023    doc-rec = ?.
     1024    for each buf_goods-attr where buf_goods-attr.attr-code = p-attr-code,
     1025               first buf_goods where buf_goods-attr.gds-code = buf_goods.gds-code and
     1026                                     buf_goods.gds-name begins s-name :
     1027            doc-rec = recid(buf_goods-attr) .
     1028            leave.
     1029    end.
     1030     if doc-rec = ? then message "Товар не найден !"  .
     1031     else
     1032         reposition BROWSE-2 to recid doc-rec no-error.
     1033   return no-apply.
     1034   end.
     1035   END.
     1036   ON MOUSE-SELECT-DBLCLICK OF s-name-cnt IN FRAME Dialog-Frame
     1037   OR  RETURN OF s-name-cnt IN FRAME Dialog-Frame
     1038   DO:
     1039     if s-name-cnt <> input frame Dialog-Frame s-name-cnt or sch-field <> "s-name-cnt" then do:
     1040    sch-field = "s-name-cnt".
     1041    assign s-name-cnt = input frame Dialog-Frame s-name-cnt.
     1042    doc-rec = ?.
     1043    for each buf_goods-attr where buf_goods-attr.attr-code = p-attr-code,
     1044               first buf_goods where
     1045                  buf_goods-attr.gds-code = buf_goods.gds-code and
     1046                INDEX(buf_goods.gds-name,s-name-cnt) > 0 :
     1047            doc-rec = recid(buf_goods-attr) .
     1048            leave.
     1049    end.
     1050     if doc-rec = ? then message "Товар не найден !"  .
     1051     else do:
     1052        assign frame Dialog-Frame:title = "Товары >> Группы товаров на кассе - " + p-name + " , содержащие в названии " + s-name-cnt .
     1053        end.
     1054   return no-apply.
     1055   end.
     1056   END.
     1057   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1058   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1059   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1060   on help of frame Dialog-Frame
     1061   do:
     1062     run gbl/app_help.p
     1063       (input this-procedure :file-name
     1064       ,input ''
     1065       ,input ?
     1066       ) no-error.
     1067     if error-status :error then do:
     1068       message
     1069         "Ошибка при вызове помощи"
     1070         error-status :get-message(1)
     1071         view-as alert-box .
     1072     end.
     1073   end.
     1074   run minbtn-set in this-procedure .
     1075   on choose of b-help in frame Dialog-Frame
     1076   do:
     1077     apply "help":u to frame Dialog-Frame .
     1078   end.
     1079   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1080   procedure minbtn-set :
     1081       do
     1082           on error undo, return error return-value
     1083           :
     1084           define variable ii              as integer       no-undo .
     1085           define variable fh              as widget-handle no-undo .
     1086           define variable hh              as widget-handle no-undo .
     1087           define variable v-h             as handle        extent 4 no-undo .
     1088           define variable v-name-button   as character     no-undo .
     1089           define variable v-help-old-x    as decimal       no-undo .
     1090           define variable v-help-old-y    as decimal       no-undo .
     1091           define variable v-help-old-size as decimal       no-undo .
     1092           define variable v-frame-width   as decimal       no-undo .
     1093           define variable jj              as integer       no-undo .
     1094           do
     1095               on error undo, return error
     1096               :
     1097               assign
     1098                   v-frame-width = frame Dialog-Frame:width - 0.3
     1099                   fh            = frame Dialog-Frame:first-child
     1100                   hh            = fh:first-child
     1101                   ii            = 1
     1102                   .
     1103               do while valid-handle(hh):
     1104                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1105                   do:
     1106                       case lc(hh:name) :
     1107                           when "b-help" then
     1108                               do:
     1109                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1110                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1111                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1112                                   hh:TOOLTIP = "Помощь" .
     1113                                   v-help-old-x = hh:column .
     1114                                   v-help-old-y = hh:row    .
     1115                                   v-help-old-size = hh:width .
     1116                                   hh:width-chars = 2.5 .
     1117                               end.
     1118                           when "b-print" then
     1119                               do:
     1120                                   hh:load-image("cmp/b-print.bmp":u) .
     1121                                   hh:TOOLTIP = "Печать" .
     1122                                   v-h[ii] = hh:handle .
     1123                                   ii = ii + 1 .
     1124                                   hh:width-chars = 3 .
     1125                               end.
     1126                           when "b-history" or
     1127                           when "b-hist" then
     1128                               do:
     1129                                   hh:load-image("cmp/b-hist.bmp":u) .
     1130                                   hh:TOOLTIP = "История" .
     1131                                   v-h[ii] = hh:handle .
     1132                                   ii = ii + 1 .
     1133                                   hh:width-chars = 3 .
     1134                               end.
     1135                           when "b-sch" then
     1136                               do:
     1137                                   hh:load-image("cmp/b-sch.bmp":u) .
     1138                                   hh:TOOLTIP = "Установка Фильтра" .
     1139                                   v-h[ii] = hh:handle .
     1140                                   ii = ii + 1 .
     1141                                   hh:width-chars = 3 .
     1142                               end.
     1143                           when "b-hist-user" then
     1144                               do:
     1145                                   hh:load-image("cmp/b-hist.bmp":u) .
     1146                                   hh:TOOLTIP = "История пользователя" .
     1147                                   ii = ii + 1 .
     1148                               end.
     1149                       end case.
     1150                   end.
     1151                   hh = hh:next-sibling.
     1152               end.
     1153               b-help:column = v-frame-width - b-help:width-chars.
     1154               jj = 0.
     1155               repeat ii = 4 to 1 by -1 :
     1156                   if valid-handle (v-h[ii] ) then
     1157                   do:
     1158                       jj  = jj + 1 .
     1159                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1160                       v-h[ii]:row    = v-help-old-y .
     1161                   end.
     1162               end.
     1163           end.
     1164       end.
     1165   end procedure.
     1166   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1167   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1168   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1169   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1170   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1171   define variable v-diasize-current-frame-height as decimal   no-undo .
     1172   define variable v-diasize-change-size          as logical   no-undo .
     1173   define variable v-diasize-resize-button        as handle    no-undo .
     1174   define variable v-diasize-wndmax               as logical   no-undo .
     1175   define variable v-diasize-wndstore             as logical   no-undo .
     1176   define variable v-diasize-proc-name            as character no-undo .
     1177   define variable v-diasize-browse-handle        as handle    no-undo .
     1178   define variable v-diasize-browse-number        as integer   no-undo .
     1179   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1180   define temp-table temp-diasize-handle no-undo
     1181     field handle-value  as handle
     1182     field save-position as decimal
     1183     index xpk is primary unique handle-value
     1184     .
     1185   define temp-table temp-browse-handle no-undo
     1186     field browse-type   as character
     1187     field browse-number as integer
     1188     field browse-handle as handle
     1189     field original-size as decimal
     1190     index xpk is primary unique browse-type browse-number
     1191     index xie browse-type browse-handle
     1192   .
     1193   procedure diasize_change-height :
     1194     define input  parameter p-change-value  as decimal   no-undo .
     1195     define input  parameter p-move-resize   as logical   no-undo .
     1196     define variable v-field-group-handle    as handle    no-undo .
     1197     define variable v-object-handle         as handle    no-undo .
     1198     define variable v-frame-height          as decimal   no-undo .
     1199     define variable v-frame-virtual-height  as decimal   no-undo .
     1200     define variable v-browse-height         as decimal   no-undo .
     1201     define variable v-window-height         as decimal   no-undo .
     1202     define variable v-window-virtual-height as decimal   no-undo .
     1203     define variable v-change-sign           as integer   no-undo .
     1204     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1205     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1206     if p-change-value > 0
     1207     then do:
     1208       if frame Dialog-Frame :height + p-change-value
     1209           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1210       then do:
     1211         assign
     1212           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1213                           - (frame Dialog-Frame :height-chars)
     1214         .
     1215         if p-change-value <= 0
     1216         then do:
     1217           run diasize_position-resize-button in this-procedure .
     1218           return .
     1219         end.
     1220       end.
     1221     end.
     1222     if p-change-value < 0
     1223     then do:
     1224       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1225       then do:
     1226         assign
     1227           p-change-value = v-diasize-orig-frame-height
     1228                          - (frame Dialog-Frame :height-chars)
     1229         .
     1230         if p-change-value >= 0
     1231         then do:
     1232           run diasize_position-resize-button in this-procedure .
     1233           return .
     1234         end.
     1235       end.
     1236     end.
     1237     if p-change-value >= 0
     1238     then do:
     1239       assign
     1240         v-change-sign = 1
     1241       .
     1242     end.
     1243     else do:
     1244       assign
     1245         v-change-sign = -1
     1246       .
     1247     end.
     1248     assign
     1249       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1250     .
     1251     if p-change-value = 0
     1252     then do:
     1253       run diasize_position-resize-button in this-procedure .
     1254       return .
     1255     end.
     1256     move_block:
     1257     do
     1258     on error undo move_block, retry move_block
     1259     :
     1260       if retry
     1261       then do:
     1262         do
     1263         on error undo move_block, leave move_block
     1264         :
     1265           if p-change-value > 0
     1266           then do:
     1267             for each buf_temp-diasize-handle
     1268             on error undo, next
     1269             :
     1270               assign
     1271                 v-object-handle = buf_temp-diasize-handle.handle-value
     1272               .
     1273               if v-object-handle <> v-diasize-resize-button
     1274               then do:
     1275                 assign
     1276                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1277                 .
     1278               end.
     1279             end.
     1280             assign
     1281               v-diasize-browse-handle :height = v-browse-height
     1282             .
     1283             for each buf_temp-browse-handle
     1284               where buf_temp-browse-handle.browse-type = 'height':u
     1285             on error undo, next
     1286             :
     1287               assign
     1288                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1289               .
     1290             end.
     1291             assign
     1292               frame Dialog-Frame :height = v-frame-height
     1293             .
     1294             if frame Dialog-Frame :scrollable = true
     1295             then do:
     1296               assign
     1297                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1298               .
     1299             end.
     1300             run diasize_position-resize-button in this-procedure .
     1301           end.
     1302           else do:
     1303             if frame Dialog-Frame :scrollable = true
     1304             then do:
     1305               assign
     1306                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1307               .
     1308             end.
     1309             assign
     1310               frame Dialog-Frame :height = v-frame-height
     1311             .
     1312             assign
     1313               v-diasize-browse-handle :height = v-browse-height
     1314             .
     1315             for each buf_temp-browse-handle
     1316               where buf_temp-browse-handle.browse-type = 'height':u
     1317             on error undo, next
     1318             :
     1319               assign
     1320                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1321               .
     1322             end.
     1323             for each buf_temp-diasize-handle
     1324             on error undo, next
     1325             :
     1326               assign
     1327                 v-object-handle = buf_temp-diasize-handle.handle-value
     1328               .
     1329               if v-object-handle <> v-diasize-resize-button
     1330               then do:
     1331                 assign
     1332                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1333                 .
     1334               end.
     1335             end.
     1336             run diasize_position-resize-button in this-procedure .
     1337           end.
     1338           assign
     1339             v-diasize-change-size = false
     1340           .
     1341           leave move_block .
     1342         end.
     1343       end.
     1344       assign
     1345         v-diasize-need-full-display = true
     1346       .
     1347       if v-diasize-change-size = false
     1348       then do:
     1349         assign
     1350           v-diasize-change-size = true
     1351         .
     1352       end.
     1353       else do:
     1354         return .
     1355       end.
     1356       assign
     1357         v-frame-height = frame Dialog-Frame :height
     1358         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1359         v-browse-height = v-diasize-browse-handle :height
     1360       .
     1361       for each buf_temp-browse-handle
     1362         where buf_temp-browse-handle.browse-type = 'height':u
     1363       :
     1364         assign
     1365           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1366         .
     1367       end.
     1368       for each buf_temp-diasize-handle
     1369       :
     1370         delete buf_temp-diasize-handle .
     1371       end.
     1372       assign
     1373         v-field-group-handle = frame Dialog-Frame :first-child
     1374       .
     1375       do while valid-handle(v-field-group-handle)
     1376       :
     1377         assign
     1378           v-object-handle = v-field-group-handle :first-child
     1379         .
     1380         do while valid-handle(v-object-handle)
     1381         :
     1382           if  v-object-handle <> v-diasize-browse-handle :handle
     1383           and can-query(v-object-handle, "row")
     1384           and can-query(v-object-handle, "height")
     1385           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1386           then do:
     1387             find first buf_temp-browse-handle
     1388               where buf_temp-browse-handle.browse-type   = 'height':u
     1389                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1390               no-error .
     1391             if available buf_temp-browse-handle
     1392             then do:
     1393             end.
     1394             else do:
     1395               create buf_temp-diasize-handle .
     1396               assign
     1397                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1398                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1399               .
     1400             end.
     1401           end.
     1402           assign
     1403             v-object-handle = v-object-handle :next-sibling
     1404           .
     1405         end.
     1406         assign
     1407           v-field-group-handle = v-field-group-handle :next-sibling
     1408         .
     1409       end.
     1410       do with frame Dialog-Frame
     1411       :
     1412         hide v-diasize-resize-button .
     1413         assign
     1414           v-diasize-resize-button :row    = 1
     1415           v-diasize-resize-button :column = 1
     1416         .
     1417       end.
     1418       if p-change-value > 0
     1419       then do:
     1420         if frame Dialog-Frame :scrollable = true
     1421         then do:
     1422           assign
     1423             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1424             no-error .
     1425           if error-status :error
     1426           or error-status :get-message(1) <> ""
     1427           then do:
     1428             undo move_block, retry move_block .
     1429           end.
     1430         end.
     1431         assign
     1432           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1433           no-error .
     1434         if error-status :error
     1435         or error-status :get-message(1) <> ""
     1436         then do:
     1437           undo move_block, retry move_block .
     1438         end.
     1439         assign
     1440           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1441           no-error .
     1442         if error-status :error
     1443         or error-status :get-message(1) <> ""
     1444         then do:
     1445           undo move_block, retry move_block .
     1446         end.
     1447         for each buf_temp-browse-handle
     1448           where buf_temp-browse-handle.browse-type = 'height':u
     1449         on error undo move_block, retry move_block
     1450         :
     1451           assign
     1452             buf_temp-browse-handle.browse-handle :height
     1453               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1454             no-error .
     1455           if error-status :error
     1456           or error-status :get-message(1) <> ""
     1457           then do:
     1458             undo move_block, retry move_block .
     1459           end.
     1460         end.
     1461         for each buf_temp-diasize-handle
     1462         on error undo move_block, retry move_block
     1463         :
     1464           assign
     1465             v-object-handle = buf_temp-diasize-handle.handle-value
     1466           .
     1467           if v-object-handle <> v-diasize-resize-button
     1468           then do:
     1469             assign
     1470               v-object-handle :row = v-object-handle :row + p-change-value
     1471               no-error .
     1472             if error-status :error
     1473             or error-status :get-message(1) <> ""
     1474             then do:
     1475               undo move_block, retry move_block .
     1476             end.
     1477           end.
     1478         end.
     1479       end.
     1480       else do:
     1481         for each buf_temp-diasize-handle
     1482         on error undo move_block, retry move_block
     1483         :
     1484           assign
     1485             v-object-handle = buf_temp-diasize-handle.handle-value
     1486           .
     1487           if v-object-handle <> v-diasize-resize-button
     1488           then do:
     1489             assign
     1490               v-object-handle :row = v-object-handle :row + p-change-value
     1491               no-error .
     1492             if error-status :error
     1493             or error-status :get-message(1) <> ""
     1494             then do:
     1495               undo move_block, retry move_block .
     1496             end.
     1497           end.
     1498         end.
     1499         assign
     1500           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1501           no-error .
     1502         if error-status :error
     1503         or error-status :get-message(1) <> ""
     1504         then do:
     1505           undo move_block, retry move_block .
     1506         end.
     1507         for each buf_temp-browse-handle
     1508           where buf_temp-browse-handle.browse-type = 'height':u
     1509         on error undo move_block, retry move_block
     1510         :
     1511           assign
     1512             buf_temp-browse-handle.browse-handle :height
     1513               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1514             no-error .
     1515           if error-status :error
     1516           or error-status :get-message(1) <> ""
     1517           then do:
     1518             undo move_block, retry move_block .
     1519           end.
     1520         end.
     1521         assign
     1522           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1523           no-error .
     1524         if error-status :error
     1525         or error-status :get-message(1) <> ""
     1526         then do:
     1527           undo move_block, retry move_block .
     1528         end.
     1529         if frame Dialog-Frame :scrollable = true
     1530         then do:
     1531           assign
     1532             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1533             no-error .
     1534           if error-status :error
     1535           or error-status :get-message(1) <> ""
     1536           then do:
     1537             undo move_block, retry move_block .
     1538           end.
     1539         end.
     1540       end.
     1541       if p-move-resize = true
     1542       then do:
     1543         run diasize_position-resize-button in this-procedure .
     1544       end.
     1545       if v-diasize-wndstore = true
     1546       then do:
     1547         if connected("ub") = true
     1548         then do:
     1549           define variable v-cntxt-db-num        as integer   no-undo .
     1550           define variable v-cntxt-userid        as character no-undo .
     1551           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1552                                             , OUTPUT v-cntxt-userid
     1553                                             ) .
     1554           run gbl/wndsizew.p
     1555             (input  v-cntxt-db-num
     1556             ,input  v-cntxt-userid
     1557             ,input  v-diasize-proc-name
     1558             ,input  'height':u
     1559             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1560             ) .
     1561         end.
     1562       end.
     1563     end.
     1564     assign
     1565       v-diasize-change-size = false
     1566     .
     1567   end procedure.
     1568   procedure diasize_set-height :
     1569     define input  parameter p-new-height  as decimal   no-undo .
     1570     define input  parameter p-move-resize as logical   no-undo .
     1571     do
     1572     on error undo, return error return-value
     1573     :
     1574       run diasize_change-height in this-procedure
     1575         (input  (p-new-height - frame Dialog-Frame :height)
     1576         ,input  p-move-resize
     1577         ) .
     1578     end.
     1579   end procedure.
     1580   procedure diasize_change-width :
     1581     define input  parameter p-change-value as decimal   no-undo .
     1582     define input  parameter p-move-resize  as logical   no-undo .
     1583     define variable v-field-group-handle   as handle    no-undo .
     1584     define variable v-object-handle        as handle    no-undo .
     1585     define variable v-frame-width          as decimal   no-undo .
     1586     define variable v-frame-virtual-width  as decimal   no-undo .
     1587     define variable v-browse-width         as decimal   no-undo .
     1588     define variable v-window-width         as decimal   no-undo .
     1589     define variable v-window-virtual-width as decimal   no-undo .
     1590     define variable v-change-sign          as integer   no-undo .
     1591     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1592     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1593     if p-change-value > 0
     1594     then do:
     1595       if frame Dialog-Frame :width + p-change-value >
     1596           session :width-chars
     1597       then do:
     1598         assign
     1599           p-change-value = session :width-chars - frame Dialog-Frame :width
     1600         .
     1601         if p-change-value <= 0
     1602         then do:
     1603           run diasize_position-resize-button in this-procedure .
     1604           return .
     1605         end.
     1606       end.
     1607     end.
     1608     if p-change-value < 0
     1609     then do:
     1610       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1611       then do:
     1612         assign
     1613           p-change-value = v-diasize-orig-frame-width
     1614                          - frame Dialog-Frame :width
     1615         .
     1616         if p-change-value >= 0
     1617         then do:
     1618           run diasize_position-resize-button in this-procedure .
     1619           return .
     1620         end.
     1621       end.
     1622     end.
     1623     if p-change-value >= 0
     1624     then do:
     1625       assign
     1626         v-change-sign = 1
     1627       .
     1628     end.
     1629     else do:
     1630       assign
     1631         v-change-sign = -1
     1632       .
     1633     end.
     1634     assign
     1635       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1636     .
     1637     if p-change-value = 0
     1638     then do:
     1639       run diasize_position-resize-button in this-procedure .
     1640       return .
     1641     end.
     1642     move_block:
     1643     do
     1644     on error undo move_block, leave move_block
     1645     :
     1646       if retry
     1647       then do:
     1648         do
     1649         on error undo move_block, leave move_block
     1650         :
     1651           if p-change-value > 0
     1652           then do:
     1653             for each buf_temp-diasize-handle
     1654             on error undo, next
     1655             :
     1656               assign
     1657                 v-object-handle = buf_temp-diasize-handle.handle-value
     1658               .
     1659               if v-object-handle <> v-diasize-resize-button
     1660               then do:
     1661                 assign
     1662                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1663                 .
     1664               end.
     1665             end.
     1666             assign
     1667               v-diasize-browse-handle :width = v-browse-width
     1668             .
     1669             for each buf_temp-browse-handle
     1670               where buf_temp-browse-handle.browse-type = 'width':u
     1671             on error undo, next
     1672             :
     1673               assign
     1674                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1675               .
     1676             end.
     1677             assign
     1678               frame Dialog-Frame :width = v-frame-width
     1679             .
     1680             if frame Dialog-Frame :scrollable = true
     1681             then do:
     1682               assign
     1683                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1684               .
     1685             end.
     1686             run diasize_position-resize-button in this-procedure .
     1687           end.
     1688           else do:
     1689             if frame Dialog-Frame :scrollable = true
     1690             then do:
     1691               assign
     1692                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1693               .
     1694             end.
     1695             assign
     1696               frame Dialog-Frame :width = v-frame-width
     1697             .
     1698             for each buf_temp-browse-handle
     1699               where buf_temp-browse-handle.browse-type = 'width':u
     1700             on error undo, next
     1701             :
     1702               assign
     1703                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1704               .
     1705             end.
     1706             assign
     1707               v-diasize-browse-handle :width = v-browse-width
     1708             .
     1709             for each buf_temp-diasize-handle
     1710             on error undo, next
     1711             :
     1712               assign
     1713                 v-object-handle = buf_temp-diasize-handle.handle-value
     1714               .
     1715               if v-object-handle <> v-diasize-resize-button
     1716               then do:
     1717                 assign
     1718                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1719                 .
     1720               end.
     1721             end.
     1722             run diasize_position-resize-button in this-procedure .
     1723           end.
     1724           assign
     1725             v-diasize-change-size = false
     1726           .
     1727           leave move_block .
     1728         end.
     1729       end.
     1730       assign
     1731         v-diasize-need-full-display = true
     1732       .
     1733       if v-diasize-change-size = false
     1734       then do:
     1735         assign
     1736           v-diasize-change-size = true
     1737         .
     1738       end.
     1739       else do:
     1740         return .
     1741       end.
     1742       assign
     1743         v-frame-width = frame Dialog-Frame :width
     1744         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1745         v-browse-width = v-diasize-browse-handle :width
     1746       .
     1747       for each buf_temp-browse-handle
     1748         where buf_temp-browse-handle.browse-type = 'width':u
     1749       :
     1750         assign
     1751           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1752         .
     1753       end.
     1754       for each buf_temp-diasize-handle
     1755       :
     1756         delete buf_temp-diasize-handle .
     1757       end.
     1758       assign
     1759         v-field-group-handle = frame Dialog-Frame :first-child
     1760       .
     1761       do while valid-handle(v-field-group-handle)
     1762       :
     1763         assign
     1764           v-object-handle = v-field-group-handle :first-child
     1765         .
     1766         do while valid-handle(v-object-handle)
     1767         :
     1768           if  v-object-handle <> v-diasize-browse-handle :handle
     1769           and v-object-handle <> v-diasize-resize-button
     1770           and can-query(v-object-handle, "row")
     1771           and can-query(v-object-handle, "height")
     1772           and ( v-object-handle :col + v-object-handle :width
     1773                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1774               )
     1775           then do:
     1776             find first buf_temp-browse-handle
     1777               where buf_temp-browse-handle.browse-type   = 'width':u
     1778                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1779               no-error .
     1780             if available buf_temp-browse-handle
     1781             then do:
     1782             end.
     1783             else do:
     1784               create buf_temp-diasize-handle .
     1785               assign
     1786                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1787                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1788               .
     1789             end.
     1790           end.
     1791           assign
     1792             v-object-handle = v-object-handle :next-sibling
     1793           .
     1794         end.
     1795         assign
     1796           v-field-group-handle = v-field-group-handle :next-sibling
     1797         .
     1798       end.
     1799       do with frame Dialog-Frame
     1800       :
     1801         hide v-diasize-resize-button .
     1802         v-diasize-resize-button :row = 1.
     1803         v-diasize-resize-button :column = 1.
     1804       end.
     1805       if p-change-value > 0
     1806       then do:
     1807         if frame Dialog-Frame :scrollable = true
     1808         then do:
     1809           assign
     1810             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1811             no-error .
     1812           if error-status :error
     1813           or error-status :get-message(1) <> ""
     1814           then do:
     1815             undo move_block, retry move_block.
     1816           end.
     1817         end.
     1818         assign
     1819           frame Dialog-Frame :width = v-frame-width + p-change-value
     1820           no-error .
     1821         if error-status :error
     1822         or error-status :get-message(1) <> ""
     1823         then do:
     1824           undo move_block, retry move_block.
     1825         end.
     1826         assign
     1827           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1828         no-error .
     1829         if error-status :error
     1830         or error-status :get-message(1) <> ""
     1831         then do:
     1832           undo move_block, retry move_block.
     1833         end.
     1834         for each buf_temp-browse-handle
     1835           where buf_temp-browse-handle.browse-type = 'width':u
     1836         on error undo move_block, retry move_block
     1837         :
     1838           assign
     1839             buf_temp-browse-handle.browse-handle :width
     1840               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1841             no-error .
     1842           if error-status :error
     1843           or error-status :get-message(1) <> ""
     1844           then do:
     1845             undo move_block, retry move_block .
     1846           end.
     1847         end.
     1848         for each buf_temp-diasize-handle
     1849         on error undo move_block, retry move_block
     1850         :
     1851           assign
     1852             v-object-handle = buf_temp-diasize-handle.handle-value
     1853           .
     1854           if v-object-handle <> v-diasize-resize-button
     1855           then do:
     1856             assign
     1857               v-object-handle :col = v-object-handle :col + p-change-value
     1858               no-error .
     1859             if error-status :error
     1860             or error-status :get-message(1) <> ""
     1861             then do:
     1862               undo move_block, retry move_block .
     1863             end.
     1864           end.
     1865         end.
     1866       end.
     1867       else do:
     1868         for each buf_temp-diasize-handle
     1869         on error undo move_block, retry move_block
     1870         :
     1871           assign
     1872             v-object-handle = buf_temp-diasize-handle.handle-value
     1873           .
     1874           if v-object-handle <> v-diasize-resize-button
     1875           then do:
     1876             assign
     1877               v-object-handle :col = v-object-handle :col + p-change-value
     1878               no-error .
     1879             if error-status :error
     1880             or error-status :get-message(1) <> ""
     1881             then do:
     1882               undo move_block, retry move_block .
     1883             end.
     1884           end.
     1885         end.
     1886         for each buf_temp-browse-handle
     1887           where buf_temp-browse-handle.browse-type = 'width':u
     1888         on error undo move_block, retry move_block
     1889         :
     1890           assign
     1891             buf_temp-browse-handle.browse-handle :width
     1892               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1893             no-error .
     1894           if error-status :error
     1895           or error-status :get-message(1) <> ""
     1896           then do:
     1897             undo move_block, retry move_block .
     1898           end.
     1899         end.
     1900         assign
     1901           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1902           no-error .
     1903         if error-status :error
     1904         or error-status :get-message(1) <> ""
     1905         then do:
     1906           undo move_block, retry move_block.
     1907         end.
     1908         assign
     1909           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1910         no-error .
     1911         if error-status :error
     1912         or error-status :get-message(1) <> ""
     1913         then do:
     1914           undo move_block, retry move_block.
     1915         end.
     1916         if frame Dialog-Frame :scrollable = true
     1917         then do:
     1918           assign
     1919             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1920           no-error .
     1921           if error-status :error
     1922           or error-status :get-message(1) <> ""
     1923           then do:
     1924             undo move_block, retry move_block.
     1925           end.
     1926         end.
     1927       end.
     1928       if p-move-resize
     1929       then do:
     1930         run diasize_position-resize-button in this-procedure .
     1931       end.
     1932       if v-diasize-wndstore = true
     1933       then do:
     1934         if connected("ub") = true
     1935         then do:
     1936           define variable v-cntxt-db-num        as integer   no-undo .
     1937           define variable v-cntxt-userid        as character no-undo .
     1938           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1939                                             , OUTPUT v-cntxt-userid
     1940                                             ) .
     1941           run gbl/wndsizew.p
     1942             (input  v-cntxt-db-num
     1943             ,input  v-cntxt-userid
     1944             ,input  v-diasize-proc-name
     1945             ,input  'width':u
     1946             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1947             ) .
     1948         end.
     1949       end.
     1950     end.
     1951     assign
     1952       v-diasize-change-size = false
     1953     .
     1954   end procedure.
     1955   procedure diasize_set-width :
     1956     define input  parameter p-new-width  as decimal   no-undo .
     1957     define input  parameter p-move-resize as logical   no-undo .
     1958     do
     1959     on error undo, return error return-value
     1960     :
     1961       run diasize_change-width in this-procedure
     1962         (input  (p-new-width - frame Dialog-Frame :width)
     1963         ,input  p-move-resize
     1964         ) .
     1965     end.
     1966   end procedure.
     1967   procedure diasize_position-resize-button :
     1968     do with frame Dialog-Frame
     1969     :
     1970       hide v-diasize-resize-button .
     1971       assign
     1972         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1973                     - 1
     1974                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1975         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1976                     - 1
     1977                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1978       .
     1979       view v-diasize-resize-button .
     1980     end.
     1981   end procedure.
     1982   on alt-right anywhere
     1983   do:
     1984     run diasize_change-width in this-procedure
     1985       (input 1
     1986       ,input true
     1987       ) .
     1988     return no-apply .
     1989   end.
     1990   on alt-left anywhere
     1991   do:
     1992     run diasize_change-width in this-procedure
     1993       (input -1
     1994       ,input true
     1995       ) .
     1996     return no-apply .
     1997   end.
     1998   on alt-down anywhere
     1999   do:
     2000     run diasize_change-height in this-procedure
     2001       (input 1
     2002       ,input true
     2003       ) .
     2004     return no-apply .
     2005   end.
     2006   on alt-up anywhere
     2007   do:
     2008     run diasize_change-height in this-procedure
     2009       (input -1
     2010       ,input true
     2011       ) .
     2012     return no-apply .
     2013   end.
     2014   on alt-enter of frame Dialog-Frame
     2015   do:
     2016     run diasize_maximize in this-procedure
     2017       (input  ?
     2018       ).
     2019     return no-apply .
     2020   end.
     2021   procedure diasize_end-move :
     2022     do
     2023     on error undo, return error return-value
     2024     :
     2025       define variable v-row-delta as decimal   no-undo .
     2026       define variable v-col-delta as decimal   no-undo .
     2027       define variable v-new-row as decimal   no-undo .
     2028       define variable v-new-col as decimal   no-undo .
     2029       assign
     2030         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2031         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2032       .
     2033       assign
     2034         v-row-delta = v-new-row - frame Dialog-Frame :height
     2035         v-col-delta = v-new-col - frame Dialog-Frame :width
     2036       .
     2037       run diasize_change-height in this-procedure
     2038         (input v-row-delta
     2039         ,input true
     2040         ) .
     2041       run diasize_change-width in this-procedure
     2042         (input v-col-delta
     2043         ,input true
     2044         ) .
     2045     end.
     2046   end procedure.
     2047   procedure diasize_maximize :
     2048     define input  parameter p-action as logical   no-undo .
     2049     do
     2050     on error undo, return error return-value
     2051     :
     2052       if p-action = ?
     2053       then do:
     2054         if v-diasize-need-maximize = true
     2055         then do:
     2056           assign
     2057             p-action = true
     2058           .
     2059         end.
     2060         else do:
     2061           assign
     2062             p-action = false
     2063           .
     2064         end.
     2065       end.
     2066       if p-action = true
     2067       then do:
     2068         run diasize_change-height in this-procedure
     2069           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2070               - frame Dialog-Frame :height-chars
     2071           ,input true
     2072           ) .
     2073         run diasize_change-width in this-procedure
     2074           (input session :width-chars
     2075               - frame Dialog-Frame :width-chars
     2076           ,input true
     2077           ) .
     2078         assign
     2079           v-diasize-need-maximize = false
     2080         .
     2081       end.
     2082       else do:
     2083         run diasize_change-width in this-procedure
     2084           (input v-diasize-orig-frame-width
     2085               - frame Dialog-Frame :width-chars
     2086           ,input true
     2087           ) .
     2088         run diasize_change-height in this-procedure
     2089           (input v-diasize-orig-frame-height
     2090               - frame Dialog-Frame :height-chars
     2091           ,input true
     2092           ) .
     2093         assign
     2094           v-diasize-need-maximize = true
     2095         .
     2096       end.
     2097     end.
     2098   end procedure.
     2099   procedure diasize_restore-orig-size :
     2100     do
     2101     on error undo, return error return-value
     2102     :
     2103       assign
     2104         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2105         v-diasize-current-frame-height = frame Dialog-Frame :height
     2106       .
     2107       run diasize_set-height in this-procedure
     2108         (input  v-diasize-orig-frame-height
     2109         ,input  true
     2110         ) .
     2111       run diasize_set-width in this-procedure
     2112         (input  v-diasize-orig-frame-width
     2113         ,input  true
     2114         ) .
     2115     end.
     2116   end procedure.
     2117   procedure diasize_restore-current-size :
     2118     do
     2119     on error undo, return error return-value
     2120     :
     2121       run diasize_set-height in this-procedure
     2122         (input  v-diasize-current-frame-height
     2123         ,input  true
     2124         ) .
     2125       run diasize_set-width in this-procedure
     2126         (input  v-diasize-current-frame-width
     2127         ,input  true
     2128         ) .
     2129     end.
     2130   end procedure.
     2131   procedure diasize_set-browse-handle :
     2132     define input  parameter p-browse-handle as handle   no-undo .
     2133     define buffer buf_temp-browse-handle for temp-browse-handle .
     2134     do
     2135     on error undo, return error return-value
     2136     :
     2137       assign
     2138         v-diasize-browse-handle = p-browse-handle
     2139       .
     2140       for each buf_temp-browse-handle
     2141       on error undo, return error return-value
     2142       :
     2143         delete buf_temp-browse-handle .
     2144       end.
     2145     end.
     2146   end procedure.
     2147   procedure diasize_add_browse :
     2148     define input  parameter p-browse-type   as character no-undo .
     2149     define input  parameter p-browse-handle as handle    no-undo .
     2150     define buffer buf_temp-browse-handle for temp-browse-handle .
     2151     do
     2152     on error undo, return error return-value
     2153     :
     2154       assign
     2155         v-diasize-browse-number = v-diasize-browse-number + 1
     2156       .
     2157       create buf_temp-browse-handle .
     2158       assign
     2159         buf_temp-browse-handle.browse-type   = p-browse-type
     2160         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2161         buf_temp-browse-handle.browse-handle = p-browse-handle
     2162       .
     2163     end.
     2164   end procedure.
     2165   procedure diasize_init :
     2166     define variable v-default-value    as logical   no-undo .
     2167     define variable v-restore-saved    as logical   no-undo .
     2168     define variable v-resize-value-str as character no-undo .
     2169     do
     2170     on error undo, return error return-value
     2171     :
     2172       do with frame Dialog-Frame
     2173       :
     2174         assign
     2175           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2176           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2177           v-diasize-browse-handle     = browse BROWSE-2 :handle
     2178         .
     2179         create button v-diasize-resize-button
     2180         assign
     2181           parent        = frame Dialog-Frame :first-child
     2182           label         = "s"
     2183           height-pixels = 16
     2184           width-pixels  = 16
     2185           visible       = true
     2186           sensitive     = true
     2187           movable       = true
     2188           triggers:
     2189             on end-move persistent run diasize_end-move in this-procedure .
     2190           end triggers.
     2191         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2192         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2193         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2194         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2195         assign
     2196           v-diasize-wndmax = false
     2197         .
     2198         if connected("ub") = true
     2199         then do:
     2200           define variable v-cntxt-db-num        as integer   no-undo .
     2201           define variable v-cntxt-userid        as character no-undo .
     2202           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2203                                             , OUTPUT v-cntxt-userid
     2204                                             ) .
     2205           run gbl/wndpar_r.p
     2206             (input  v-cntxt-db-num
     2207             ,input  v-cntxt-userid
     2208             ,input  'wndmax':U
     2209             ,output v-diasize-wndmax
     2210             ,output v-default-value
     2211             ) .
     2212         end.
     2213         assign
     2214           v-diasize-wndstore = false
     2215         .
     2216         if connected("ub") = true
     2217         then do:
     2218           run gbl/wndpar_r.p
     2219             (input  v-cntxt-db-num
     2220             ,input  v-cntxt-userid
     2221             ,input  'wndstore':U
     2222             ,output v-diasize-wndstore
     2223             ,output v-default-value
     2224             ) .
     2225         end.
     2226         assign
     2227           v-diasize-proc-name = entry(1, program-name(2), '.')
     2228         .
     2229         if v-diasize-wndstore = true
     2230         then do:
     2231           assign
     2232             v-restore-saved = false
     2233           .
     2234           if connected("ub") = true
     2235           then do:
     2236             run gbl/wndsizer.p
     2237               (input  v-cntxt-db-num
     2238               ,input  v-cntxt-userid
     2239               ,input  v-diasize-proc-name
     2240               ,input  'height':u
     2241               ,output v-resize-value-str
     2242               ) .
     2243             if v-resize-value-str <> '':U
     2244             then do:
     2245               run diasize_change-height in this-procedure
     2246                 (input  integer(v-resize-value-str)
     2247                 ,input  true
     2248                 ) .
     2249               assign
     2250                 v-restore-saved = true
     2251               .
     2252             end.
     2253           end.
     2254           if connected("ub") = true
     2255           then do:
     2256             run gbl/wndsizer.p
     2257               (input  v-cntxt-db-num
     2258               ,input  v-cntxt-userid
     2259               ,input  v-diasize-proc-name
     2260               ,input  'width':u
     2261               ,output v-resize-value-str
     2262               ) .
     2263             if v-resize-value-str <> '':U
     2264             then do:
     2265               run diasize_change-width in this-procedure
     2266                 (input  integer(v-resize-value-str)
     2267                 ,input  true
     2268                 ) .
     2269               assign
     2270                 v-restore-saved = true
     2271               .
     2272             end.
     2273           end.
     2274           if v-restore-saved <> true
     2275           then do:
     2276             if v-diasize-wndmax = true
     2277             then do:
     2278               run diasize_maximize in this-procedure
     2279                 (input  true
     2280                 ) .
     2281             end.
     2282           end.
     2283         end.
     2284         else do:
     2285           if v-diasize-wndmax = true
     2286           then do:
     2287             run diasize_maximize in this-procedure
     2288               (input  true
     2289               ) .
     2290           end.
     2291         end.
     2292       end.
     2293     end.
     2294   end procedure.
     2295   procedure diasize_need-full-display :
     2296     define output parameter p-need-full-display as logical   no-undo .
     2297     do
     2298     on error undo, return error return-value
     2299     :
     2300       assign
     2301         p-need-full-display = v-diasize-need-full-display
     2302       .
     2303       assign
     2304         v-diasize-need-full-display = false
     2305       .
     2306     end.
     2307   end procedure.
     2308   procedure get-context :
     2309      define output parameter p-db-num as integer          no-undo.
     2310      define output parameter p-user-id as character        no-undo.
     2311      define variable v-login               as character    no-undo.
     2312      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2313      define buffer buf_user-login  for ub.user-login .
     2314      do
     2315      on error undo, return error
     2316      :
     2317            FIND FIRST buf_sys-ctrl no-lock.
     2318            ASSIGN
     2319               v-login = USERID("ub")
     2320               p-db-num = buf_sys-ctrl.db-num
     2321            .
     2322            FIND FIRST buf_user-login
     2323                 WHERE buf_user-login.db-num = p-db-num
     2324                   AND buf_user-login.user-login = v-login
     2325                 no-lock
     2326                 no-error
     2327                 .
     2328            IF AVAILABLE buf_user-login
     2329            THEN DO:
     2330               assign
     2331                  p-user-id = buf_user-login.user-id
     2332               .
     2333            END.
     2334      end.
     2335   end procedure.
     2336       run diasize_init in this-procedure .
     2337   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2338   on INS of frame Dialog-Frame anywhere do:
     2339     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2340     return no-apply.
     2341   end.
     2342   assign
     2343      frame Dialog-Frame:title = "Товары >> " + p-name
     2344   .
     2345   def var sort-labelBROWSE-2   as character no-undo .
     2346   def var sort-clmnBROWSE-2    as handle    no-undo .
     2347   def var cur-clmnBROWSE-2     as handle    no-undo .
     2348   def var cur-clmn-locBROWSE-2 as integer   no-undo .
     2349   def var re-queryBROWSE-2     as logical   initial no no-undo .
     2350   on start-search, ctrl-o of BROWSE-2 in frame Dialog-Frame do:
     2351      run sort-brBROWSE-2
     2352        (input (if available goods-attr
     2353                then recid(goods-attr)
     2354                else ?
     2355               )
     2356        ).
     2357   end.
     2358   PROCEDURE sort-brBROWSE-2 :
     2359     define input parameter p-recid as recid no-undo .
     2360     if re-queryBROWSE-2 = no then do:
     2361       assign
     2362          cur-clmnBROWSE-2 = BROWSE-2:current-column in frame Dialog-Frame
     2363       .
     2364       if sort-clmnBROWSE-2 <> ? then sort-clmnBROWSE-2:column-fgcolor = 0.
     2365       if cur-clmnBROWSE-2 = sort-clmnBROWSE-2 then do:
     2366         assign
     2367            sort-labelBROWSE-2 = ""
     2368            sort-clmnBROWSE-2 = ?
     2369         .
     2370        end.
     2371        else do:
     2372          assign
     2373            sort-labelBROWSE-2 = cur-clmnBROWSE-2:label
     2374            sort-clmnBROWSE-2  = cur-clmnBROWSE-2
     2375            sort-clmnBROWSE-2:column-fgcolor = 4
     2376          .
     2377        end.
     2378      end.
     2379     assign
     2380       cur-clmn-locBROWSE-2 = 1
     2381     .
     2382     def var column-handle as handle no-undo .
     2383     column-handle = BROWSE-2:first-column.
     2384     do while valid-handle(column-handle) :
     2385       if column-handle = cur-clmnBROWSE-2 then do:
     2386         leave .
     2387       end.
     2388       column-handle = column-handle:NEXT-COLUMN.
     2389       assign
     2390         cur-clmn-locBROWSE-2 = cur-clmn-locBROWSE-2 + 1
     2391       .
     2392     end.
     2393     case sort-labelBROWSE-2:
     2394           when goods.artic:label in browse BROWSE-2 then DO:   assign     sort-column-name = "goods.artic"   .   run OpenBr.   . END.
     2395           when goods.gds-name:label in browse BROWSE-2 then DO:   assign     sort-column-name = "goods.gds-name"   .   run OpenBr.   . END.
     2396       otherwise do:
     2397         assign
     2398           sort-column-name = ""
     2399         .
     2400         run OpenBr.
     2401         if sort-labelBROWSE-2 <> "" then do:
     2402           assign
     2403             cur-clmnBROWSE-2:column-fgcolor = 0
     2404           .
     2405         end.
     2406         assign
     2407           cur-clmn-locBROWSE-2 = ?
     2408         .
     2409       end.
     2410     end case.
     2411     if p-recid <> ? then do:
     2412       reposition BROWSE-2 to recid p-recid no-error.
     2413       apply "value-changed" to BROWSE-2 in frame Dialog-Frame.
     2414     end.
     2415     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     2416   END PROCEDURE.
     2417   procedure re-open-query-srt-clmnBROWSE-2:
     2418   if cur-clmnBROWSE-2 = ? then do:
     2419      run OpenBr.
     2420   end.
     2421   else do:
     2422      assign re-queryBROWSE-2 = yes.
     2423      run sort-brBROWSE-2
     2424        (input (if available goods-attr
     2425                then recid(goods-attr)
     2426                else ?
     2427               )
     2428        ).
     2429      assign re-queryBROWSE-2 = no.
     2430   end.
     2431   end.
     2432   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2433   on F9 of frame Dialog-Frame anywhere do:
     2434     if not available ub.goods then
     2435       return no-apply.
     2436     gds-rec = recid (ub.goods).
     2437     run ref/gds-form.w ( input parParentProc
     2438                         ,input 'ПРОСМОТР':U
     2439                         ,input ?
     2440                         ,input ?
     2441                         ,input ?
     2442                         ,input-output gds-rec).
     2443     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     2444     return no-apply.
     2445   end.
     2446   MAIN-BLOCK:
     2447   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2448      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2449      run enable_UI in this-procedure .
     2450      run post_enable_UI in this-procedure .
     2451      enable  s-code with frame Dialog-Frame.
     2452      Hide    s-name  s-name-cnt s-artic in frame Dialog-Frame.
     2453      display s-code with frame Dialog-Frame.
     2454      WAIT-FOR GO OF FRAME Dialog-Frame.
     2455   END.
     2456   run disable_UI in this-procedure .
     2457   PROCEDURE cycle-add :
     2458   define variable v-num   as integer no-undo .
     2459   define variable v-flag as logical   no-undo init false .
     2460   define variable v-count as integer no-undo .
     2461      define buffer bb_goods-attr   for ub.goods-attr .
     2462      define buffer buf_goods       for ub.goods .
     2463      run gbl/d-askw.w
     2464         (input "Вопрос"
     2465         ,input "Если товар уже прикреплен к Группе товаров на кассе, пропускаем его?"
     2466         ,input "|^"
     2467         ,input "Не добавлять|Добавлять|Остановка"
     2468         ,input "Не добавляем товар к новой группе товаров на кассе, товар остается в старой группе товаров|"
     2469            + "Добавляем товар к новой группе товаров на кассе и открепляем от старой|"
     2470            + "Остановить добавление товаров, если встречаются товары прикрепленные к другим группам товар на кассе."
     2471         ,input 1
     2472         ,input 2
     2473         ,output v-num
     2474         ).
     2475       case v-num :
     2476         when 1 then do :
     2477             for each tt-gds-list no-lock  by tt-gds-list.nn :
     2478               lns-cnt  =  lns-cnt + 1 .
     2479               if lns-cnt > 1 then assign line-mode = "ЦИКЛ":U.
     2480                 v-flag = false .
     2481                 for each bb_goods-attr no-lock where
     2482                          bb_goods-attr.gds-code = tt-gds-list.gds-code
     2483                 :
     2484                   v-flag = true.
     2485                   leave.
     2486                 end.
     2487                 if v-flag = false then do :
     2488                   find first bb_goods-attr no-lock
     2489                       where bb_goods-attr.gds-code = tt-gds-list.gds-code
     2490                         and bb_goods-attr.attr-code = p-attr-code
     2491                         no-error.
     2492                   if not available bb_goods-attr then do :
     2493                       run gds-attr-write (input tt-gds-list.gds-code
     2494                                          ,input p-attr-code
     2495                                          ,input p-attr-value
     2496                                           ) no-error.
     2497                   end.
     2498                 end.
     2499             end.
     2500         end.
     2501         when 2 then do :
     2502             for each tt-gds-list no-lock  by tt-gds-list.nn :
     2503               lns-cnt  =  lns-cnt + 1 .
     2504               if lns-cnt > 1 then assign line-mode = "ЦИКЛ":U.
     2505                 v-flag = false .
     2506                 for each bb_goods-attr exclusive-lock where
     2507                          bb_goods-attr.gds-code = tt-gds-list.gds-code and
     2508                          bb_goods-attr.attr-code = p-attr-code
     2509                 :
     2510                   run gds-attr-delete (input tt-gds-list.gds-code
     2511                                       ,input p-attr-code
     2512                                       ,output v-del
     2513                                        ) no-error.
     2514                 end.
     2515               find first bb_goods-attr no-lock
     2516                    where bb_goods-attr.gds-code = tt-gds-list.gds-code
     2517                      and bb_goods-attr.attr-code = p-attr-code no-error.
     2518               if not available bb_goods-attr then do :
     2519                       run gds-attr-write (input tt-gds-list.gds-code
     2520                                          ,input p-attr-code
     2521                                          ,input p-attr-value
     2522                                           ) no-error.
     2523               end.
     2524             end.
     2525         end.
     2526         when 3 then do :
     2527             for each tt-gds-list no-lock  by tt-gds-list.nn :
     2528               lns-cnt  =  lns-cnt + 1 .
     2529               if lns-cnt > 1 then assign line-mode = "ЦИКЛ":U.
     2530                 v-flag = false .
     2531                 for each bb_goods-attr no-lock where
     2532                           bb_goods-attr.gds-code = tt-gds-list.gds-code and
     2533                           bb_goods-attr.attr-code = p-attr-code
     2534                 :
     2535                   v-flag = true .
     2536                   leave.
     2537                 end.
     2538               if v-flag = true then do :
     2539                 leave.
     2540               end.
     2541             end.
     2542             if v-flag <> true then do :
     2543             for each tt-gds-list no-lock  by tt-gds-list.nn :
     2544               find first bb_goods-attr no-lock
     2545                    where bb_goods-attr.gds-code = tt-gds-list.gds-code
     2546                      and bb_goods-attr.attr-code = p-attr-code no-error.
     2547               if not available bb_goods-attr then do :
     2548                       run gds-attr-write (input tt-gds-list.gds-code
     2549                                          ,input p-attr-code
     2550                                          ,input p-attr-value
     2551                                           ) no-error.
     2552               end.
     2553             end.
     2554             end.
     2555         end.
     2556       end case.
     2557   end procedure.
     2558   PROCEDURE disable_UI :
     2559     HIDE FRAME Dialog-Frame.
     2560   END PROCEDURE.
     2561   PROCEDURE enable_UI :
     2562     DISPLAY r-sort s-artic s-name s-name-cnt s-code FILL-IN-2
     2563         WITH FRAME Dialog-Frame.
     2564     ENABLE b-exit b-mark b-add b-del b-help r-sort s-artic s-code BROWSE-2
     2565            FILL-IN-2
     2566         WITH FRAME Dialog-Frame.
     2567     VIEW FRAME Dialog-Frame.
     2568     OPEN QUERY BROWSE-2 FOR EACH goods-attr       WHERE goods-attr.attr-code = p-attr-code and goods-attr.attr-value = p-attr-value NO-LOCK,       EACH goods WHERE goods.gds-code = goods-attr.gds-code NO-LOCK     .
     2569   END PROCEDURE.
     2570   PROCEDURE OpenBr :
     2571   define variable t-ret as logical no-undo .
     2572   t-ret =  session:SET-WAIT-STATE("GENERAL") .
     2573   case sort-column-name :
     2574     when "goods.artic" then do:
     2575           assign frame Dialog-Frame:title = "Товары >> " + p-name.    OPEN QUERY BROWSE-2 FOR EACH goods-attr       WHERE goods-attr.attr-code = p-attr-code and goods-attr.attr-value = p-attr-value NO-LOCK,       EACH goods WHERE goods.gds-code = goods-attr.gds-code NO-LOCK     by goods.artic.    .
     2576     end.
     2577     when "goods.gds-name" then do:
     2578           assign frame Dialog-Frame:title = "Товары >> " + p-name.    OPEN QUERY BROWSE-2 FOR EACH goods-attr       WHERE goods-attr.attr-code = p-attr-code and goods-attr.attr-value = p-attr-value NO-LOCK,       EACH goods WHERE goods.gds-code = goods-attr.gds-code NO-LOCK     by goods.gds-name.    .
     2579     end.
     2580     otherwise do:
     2581           assign frame Dialog-Frame:title = "Товары >> " + p-name.    OPEN QUERY BROWSE-2 FOR EACH goods-attr       WHERE goods-attr.attr-code = p-attr-code and goods-attr.attr-value = p-attr-value NO-LOCK,       EACH goods WHERE goods.gds-code = goods-attr.gds-code NO-LOCK     .    .
     2582     end.
     2583   end case.
     2584   t-ret =  session:SET-WAIT-STATE("") .
     2585   apply "HOME" to BROWSE-2 in frame Dialog-Frame.
     2586   END PROCEDURE.
     2587   PROCEDURE post_enable_UI :
     2588      if v-cntxt-db-num <> 0 then do:
     2589         disable
     2590               b-add b-del
     2591         WITH FRAME Dialog-Frame.
     2592      end.
     2593   END PROCEDURE.
     2594   PROCEDURE get-mark-string :
     2595     define input  parameter p-gds-code    as integer   no-undo .
     2596     define output parameter p-mark-string as character no-undo .
     2597     do
     2598     on error undo, return error return-value
     2599     :
     2600       find first temp-goods
     2601         where temp-goods.gds-code = p-gds-code
     2602         no-error .
     2603       if available temp-goods
     2604       then do:
     2605         assign
     2606           p-mark-string = '*':U
     2607         .
     2608       end.
     2609       else do:
     2610         assign
     2611           p-mark-string = '':U
     2612         .
     2613       end.
     2614     end.
     2615   END PROCEDURE.
     2616   PROCEDURE choose-mark :
     2617     define variable v-log as logical no-undo .
     2618     do
     2619     on error undo, return error return-value
     2620     :
     2621       if available goods
     2622       then do:
     2623         find first temp-goods
     2624           where temp-goods.gds-code = goods.gds-code
     2625           no-error .
     2626         if available temp-goods
     2627         then do:
     2628           run goods_delete in this-procedure
     2629             (input  goods.gds-code
     2630             ) .
     2631         end.
     2632         else do:
     2633           run goods_append in this-procedure
     2634             (input  goods.gds-code
     2635             ) .
     2636         end.
     2637         v-log = Browse-2:refresh() in frame Dialog-Frame.
     2638         if last-event :function <> "MOUSE-SELECT-DBLCLICK"
     2639         then do:
     2640           v-log = browse-2:select-next-row ().
     2641           apply "iteration-changed" to browse-2 in frame Dialog-Frame.
     2642         end.
     2643         apply "entry" to browse-2 in frame Dialog-Frame.
     2644       end.
     2645     end.
     2646   END PROCEDURE.
     2647   PROCEDURE goods_append :
     2648     define input  parameter p-gds-code as integer no-undo .
     2649     do
     2650     on error undo, return error return-value
     2651     :
     2652       find first temp-goods
     2653         where temp-goods.gds-code = p-gds-code
     2654         no-error .
     2655       if not available temp-goods
     2656       then do:
     2657         create temp-goods .
     2658         assign
     2659           temp-goods.gds-code = p-gds-code
     2660         .
     2661       end.
     2662     end.
     2663   END PROCEDURE.
     2664   PROCEDURE goods_delete :
     2665     define input  parameter p-gds-code as integer   no-undo .
     2666     do
     2667     on error undo, return error return-value
     2668     :
     2669       find first temp-goods
     2670         where temp-goods.gds-code = p-gds-code
     2671           no-error .
     2672       if available temp-goods
     2673       then do:
     2674         delete temp-goods .
     2675       end.
     2676     end.
     2677   END PROCEDURE.
     2678   FUNCTION mark-string RETURNS CHARACTER
     2679     ( p-gds-code as integer ) :
     2680     define variable v-mark-string as character no-undo .
     2681     run get-mark-string in this-procedure
     2682       (input  p-gds-code
     2683       ,output v-mark-string
     2684       ) .
     2685     return v-mark-string .
     2686   END FUNCTION.
