     2522   ( x-abc-analysis.abc-a,
     2523   x-abc-analysis.abc-b,
     2524   x-abc-analysis.abc-c,
     2525   x-abc-analysis.abc-d,
     2526   x-abc-analysis.abc-e
     2527   )  no-error .
