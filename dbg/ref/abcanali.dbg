     2915     if  x-abc-analysis.abc-a  = 0  or  x-abc-analysis.abc-b = 0  then do:
     2916                 message "Ранжирование АВС не задано !!!" view-as alert-box information .
     2917                 return .
     2918     end.
     2919     run waitfram-show ("Ждите...").
     2920     define variable v-list-obj as character no-undo .
     2921     define variable v-possb-keep-string-obj as logical   no-undo .
     2922     define variable v-string-obj            as character no-undo .
     2923     define variable v-hash-string-obj       as character no-undo .
     2924     define variable v-id as integer   no-undo .
