     2557   ON return OF x-abc-analysis.abc-name IN FRAME Dialog-Frame
     2558   DO:
     2559     run next-focus in this-procedure  (input  x-abc-analysis.abc-name:handle ) .
     2560     return no-apply .
     2561   END.
     2562   ON VALUE-CHANGED OF x-abc-analysis.abc-type IN FRAME Dialog-Frame
     2563   DO:
     2564     ASSIGN x-abc-analysis.abc-type .
     2565     if x-abc-analysis.abc-type = "2" then do:
     2566         display FILL-IN-10 FILL-IN-11 FILL-IN-8 FILL-IN-9 x-abc-analysis.LE-proc  x-abc-analysis.double-line-proc
     2567         with FRAME Dialog-Frame .
     2568         enable  x-abc-analysis.LE-proc x-abc-analysis.double-line-proc  with FRAME Dialog-Frame .
     2569      end.
     2570     else do:
     2571         HIDE FILL-IN-10 FILL-IN-11 FILL-IN-8 FILL-IN-9 x-abc-analysis.LE-proc x-abc-analysis.double-line-proc
     2572         IN FRAME Dialog-Frame .
     2573     end.
     2574   END.
     2575   ON CHOOSE OF B-add-doc IN FRAME Dialog-Frame
     2576   DO:
     2577   define variable  pattr-codes as character no-undo.
     2578   define variable pattr-labels as character no-undo.
     2579   define variable ppresel-codes as character no-undo.
     2580   define variable  psel-codes as character no-undo.
     2581   pattr-codes      =  'ee,es,re,rs,we':u .
     2582   pattr-labels     =  'расход внешний,касса продажа,возврат внешний,касса возврат,списание':u .
     2583   if p-id = ? then p-id = 1 .
     2584     run gbl/d-list.w (
     2585         "b-sel,b-mark"     ,
     2586         "Расширенный тип"  ,
     2587         pattr-codes        ,
     2588         pattr-labels       ,
     2589         ","                ,
     2590         ppresel-codes  ,
     2591         OUTPUT  psel-codes             ) .
     2592   if  psel-codes = "" then return no-apply.
     2593   define variable ii as integer   no-undo .
     2594   define variable i-all as integer   no-undo .
     2595   i-all = num-entries (psel-codes) .
     2596   repeat ii = 1 to  i-all :
     2597          find first x-abc-analysis-doc where x-abc-analysis-doc.abcd-ext-doc-type = entry(ii, psel-codes ) no-error .
     2598            if not available x-abc-analysis-doc   then do:
     2599                 create x-abc-analysis-doc .
     2600                 assign
     2601                   x-abc-analysis-doc.abc-id   = p-id
     2602                   x-abc-analysis-doc.db-num   = p-db-num
     2603                   x-abc-analysis-doc.abcd-ext-doc-type = entry(ii, psel-codes )
     2604                 .
     2605            end.
     2606   end.
     2607   OPEN QUERY BROWSE-type-doc FOR EACH x-abc-analysis-doc       WHERE x-abc-analysis-doc.abc-id = x-abc-analysis.abc-id and x-abc-analysis-doc.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     2608   END.
     2609   ON return OF B-add-doc IN FRAME Dialog-Frame
     2610   DO:
     2611       run next-focus in this-procedure  (input  B-add-doc:handle ) .
     2612     return no-apply .
     2613   END.
     2614   ON CHOOSE OF B-add-obj IN FRAME Dialog-Frame
     2615   DO:
     2616   define variable p-obj-type like ub.clients.obj-type no-undo.
     2617   define variable p-obj-code like ub.clients.obj-code no-undo.
     2618     define variable v-user-select as logical   no-undo .
     2619   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2620   run userobjs_select-many in this-procedure
     2621     (input  parparentproc
     2622     ,input  v-cntxt-db-num
     2623     ,input  v-cntxt-userid
     2624     ,input  v-cntxt-host-code-obj
     2625     ,input  v-cntxt-obj-type
     2626     ,input  v-cntxt-obj-code
     2627     ,output v-user-select
     2628     )  .
     2629     if v-user-select <> true
     2630     then do:
     2631       return no-apply .
     2632     end.
     2633     if p-id = ?
     2634     then do:
     2635       assign
     2636         p-id = 1
     2637       .
     2638     end.
     2639     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     2640     for each buf_userobjs_temp-user-obj
     2641       on error undo, return no-apply  :
     2642       find first x-abc-analysis-obj where
     2643                  x-abc-analysis-obj.obj-type = buf_userobjs_temp-user-obj.obj-type and
     2644                  x-abc-analysis-obj.obj-code = buf_userobjs_temp-user-obj.obj-code no-error .
     2645       if error-status :error then do :
     2646           create x-abc-analysis-obj .
     2647           assign
     2648             x-abc-analysis-obj.abc-id   = p-id
     2649             x-abc-analysis-obj.db-num   = p-db-num
     2650             x-abc-analysis-obj.obj-type = buf_userobjs_temp-user-obj.obj-type
     2651             x-abc-analysis-obj.obj-code = buf_userobjs_temp-user-obj.obj-code
     2652           .
     2653       end.
     2654     end.
     2655   OPEN QUERY BROWSE-obj FOR EACH x-abc-analysis-obj       WHERE x-abc-analysis-obj.abc-id = x-abc-analysis.abc-id and x-abc-analysis-obj.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     2656    if x-abc-analysis.abc-a = 0 then do:
     2657       run find-hash-obj in this-procedure .
     2658    end.
     2659   END.
     2660   ON return OF B-add-obj IN FRAME Dialog-Frame
     2661   DO:
     2662       run next-focus in this-procedure  (input  B-add-obj:handle ) .
     2663     return no-apply .
     2664   END.
     2665   ON CHOOSE OF B-add-period IN FRAME Dialog-Frame
     2666   DO:
     2667   if p-id = ? then p-id = 1 .
     2668   define variable date-1  as date   no-undo .
     2669   define variable date-2  as date   no-undo .
     2670   define variable v-ok as logical   no-undo .
     2671      run gbl/get-per.w (
     2672           output        v-ok ,
     2673           input-output  date-1  ,
     2674           input-output  date-2  ) .
     2675       if v-ok then do:
     2676          find first x-abc-analysis-period where
     2677             x-abc-analysis-period.abcp-end   = date-2 and
     2678             x-abc-analysis-period.abcp-start = date-1 no-error .
     2679          if not available x-abc-analysis-period then do:
     2680           create x-abc-analysis-period .
     2681           assign
     2682             x-abc-analysis-period.abc-id     = p-id
     2683             x-abc-analysis-period.db-num     = p-db-num
     2684             x-abc-analysis-period.abcp-end   = date-2
     2685             x-abc-analysis-period.abcp-start = date-1
     2686           .
     2687          end.
     2688       end.
     2689     OPEN QUERY BROWSE-period FOR EACH x-abc-analysis-period       WHERE x-abc-analysis-period.abc-id = x-abc-analysis.abc-id and x-abc-analysis-period.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     2690   END.
     2691   ON return OF B-add-period IN FRAME Dialog-Frame
     2692   DO:
     2693       run next-focus in this-procedure  (input  B-add-period:handle ) .
     2694     return no-apply .
     2695   END.
     2696   ON CHOOSE OF B-crt IN FRAME Dialog-Frame
     2697   DO:
     2698   define VAR v-rid-list    as  char no-undo .
     2699         DISPLAY
     2700          "" @ x-abc-analysis.cral-id
     2701          "" @ x-criterion-analysis.cral-name
     2702         WITH FRAME Dialog-Frame.
     2703   run ref/critanal.w (parParentProc,"b-sel", "", OUTPUT v-rid-list ) no-error .
     2704     if error-status :error or  v-rid-list = "" or v-rid-list = ? then do:
     2705        message "Не выбран критерий анализа!" skip
     2706        error-status :get-message(1) skip
     2707        return-value skip
     2708        view-as alert-box error
     2709        .
     2710        return no-apply.
     2711     end.
     2712     find first x-criterion-analysis no-lock where recid(x-criterion-analysis) = integer(v-rid-list) no-error.
     2713         if error-status :error or  v-rid-list = "" or v-rid-list = ? then do:
     2714           message "Не правильно выбран критерий анализа!" skip
     2715           error-status :get-message(1) skip
     2716           return-value skip
     2717           view-as alert-box error
     2718           .
     2719           return no-apply.
     2720         end.
     2721         if x-criterion-analysis.cral-status <> 0 then do:
     2722           message "Не правильно выбран критерий анализа! Статус критерия должен быть АКТИВНЫЙ ." skip
     2723           view-as alert-box error
     2724           .
     2725           return no-apply.
     2726         end.
     2727      ASSIGN
     2728         x-abc-analysis.cral-id = x-criterion-analysis.cral-id
     2729       .
     2730         DISPLAY
     2731           x-abc-analysis.cral-id
     2732           x-criterion-analysis.cral-name
     2733         WITH FRAME Dialog-Frame.
     2734   END.
     2735   ON return OF B-crt IN FRAME Dialog-Frame
     2736   DO:
     2737       run next-focus in this-procedure  (input  B-crt:handle ) .
     2738     return no-apply .
     2739   END.
     2740   ON CHOOSE OF B-del-doc IN FRAME Dialog-Frame
     2741   DO:
     2742     IF AVAILABLE x-abc-analysis-doc THEN DELETE x-abc-analysis-doc.
     2743     OPEN QUERY BROWSE-type-doc FOR EACH x-abc-analysis-doc       WHERE x-abc-analysis-doc.abc-id = x-abc-analysis.abc-id and x-abc-analysis-doc.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     2744   END.
     2745   ON CHOOSE OF B-del-obj IN FRAME Dialog-Frame
     2746   DO:
     2747    IF AVAILABLE x-abc-analysis-obj THEN DELETE x-abc-analysis-obj.
     2748   OPEN QUERY BROWSE-obj FOR EACH x-abc-analysis-obj       WHERE x-abc-analysis-obj.abc-id = x-abc-analysis.abc-id and x-abc-analysis-obj.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     2749   END.
     2750   ON CHOOSE OF B-del-period IN FRAME Dialog-Frame
     2751   DO:
     2752     IF AVAILABLE x-abc-analysis-period THEN DELETE x-abc-analysis-period.
     2753     OPEN QUERY BROWSE-period FOR EACH x-abc-analysis-period       WHERE x-abc-analysis-period.abc-id = x-abc-analysis.abc-id and x-abc-analysis-period.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     2754   END.
     2755   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     2756   DO:
     2757       run proc-save in this-procedure no-error.
     2758       if error-status:error then do:
     2759           case return-value
     2760           :
     2761           when "cral-id"
     2762             then do:
     2763                 apply "CHOOSE" to B-crt IN FRAME Dialog-Frame .
     2764             end.
     2765           when "obj"
     2766             then do:
     2767                 apply "CHOOSE" to B-add-obj IN FRAME Dialog-Frame .
     2768             end.
     2769           when "doc"
     2770             then do:
     2771                 apply "CHOOSE" to B-add-doc IN FRAME Dialog-Frame .
     2772             end.
     2773           when "period"
     2774             then do:
     2775                 apply "CHOOSE" to B-add-period IN FRAME Dialog-Frame .
     2776             end.
     2777           when "abc-name"
     2778             then do:
     2779                 apply "entry" to x-abc-analysis.abc-name IN FRAME Dialog-Frame .
     2780             end.
     2781           when "abc-rang"
     2782             then do:
     2783                 apply "entry" to x-abc-analysis.abc-a IN FRAME Dialog-Frame .
     2784             end.
     2785           otherwise do:
     2786             MESSAGE  RETURN-VALUE "ДЛЯ ОТЛАДКИ !!! " view-as alert-box information .
     2787           end.
     2788           end case.
     2789           return no-apply.
     2790       end.
     2791       find first locked_abc-analysis no-lock where
     2792                         recid(locked_abc-analysis) = p-doc-rec no-error .
     2793       run ref/abc-a.p  (
     2794           input parparentproc
     2795         , input "abc":U
     2796         , input locked_abc-analysis.abc-id
     2797         , input locked_abc-analysis.db-num
     2798         , input table x-abc-analysis
     2799         , input table x-abc-analysis-doc
     2800         , input table x-abc-analysis-obj
     2801         , input table x-abc-analysis-period )
     2802       no-error.
     2803       if error-status:error then do:
     2804           MESSAGE "Ошибка расчета АВС анализа"
     2805           error-status :get-message(1)
     2806           return-value
     2807           "456" skip
     2808       .
     2809         return no-apply.
     2810         end.
     2811       run ref/abc-view.w (
     2812       parParentProc,
     2813       locked_abc-analysis.abc-id ,
     2814       locked_abc-analysis.db-num
     2815       )  .
     2816   END.
     2817   ON CHOOSE OF B-gds-list IN FRAME Dialog-Frame
     2818   DO:
     2819   define variable v-ps as character no-undo .
     2820   v-ps = "".
     2821   for each gds-list-hist:
     2822     v-ps = v-ps + gds-list-hist.des + chr(10).
     2823   end.
     2824     run gbl/d-prompt.w (
     2825           'title=':u + "Список товаров" + '\':u
     2826         + 'format=' + "x(1000)" + '\':u
     2827         + 'type=' + "edit" + '\':u
     2828         + 'fillin_row=2\':u
     2829         + 'fillin_col=4\':u
     2830         + 'fillin_width=60\':u
     2831         + 'fillin_height=10\':u
     2832         + 'max-chars=1000\':u
     2833         + 'readonly=yes\':u
     2834         , input-output v-ps
     2835         ) no-error.
     2836   END.
     2837   ON CHOOSE OF B-rez IN FRAME Dialog-Frame
     2838   DO:
