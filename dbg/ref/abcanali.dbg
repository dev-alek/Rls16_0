     3676                 .
     3677               end.
     3678             end.
     3679             run diasize_position-resize-button in this-procedure .
     3680           end.
     3681           assign
     3682             v-diasize-change-size = false
     3683           .
     3684           leave move_block .
     3685         end.
     3686       end.
     3687       assign
     3688         v-diasize-need-full-display = true
     3689       .
     3690       if v-diasize-change-size = false
     3691       then do:
     3692         assign
     3693           v-diasize-change-size = true
     3694         .
     3695       end.
     3696       else do:
     3697         return .
     3698       end.
     3699       assign
     3700         v-frame-width = frame Dialog-Frame :width
     3701         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3702         v-browse-width = v-diasize-browse-handle :width
     3703       .
     3704       for each buf_temp-browse-handle
     3705         where buf_temp-browse-handle.browse-type = 'width':u
     3706       :
     3707         assign
     3708           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3709         .
     3710       end.
     3711       for each buf_temp-diasize-handle
     3712       :
     3713         delete buf_temp-diasize-handle .
     3714       end.
     3715       assign
     3716         v-field-group-handle = frame Dialog-Frame :first-child
     3717       .
