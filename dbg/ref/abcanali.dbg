     1094   procedure def-hash :
     1095     do
     1096     on error undo, return error return-value
     1097     :
     1098     define input  parameter p-full-string as character no-undo .
     1099     define output parameter p-possb-keep-string as logical   no-undo .
     1100     define output parameter p-string            as character no-undo .
     1101     define output parameter p-hash-string       as character no-undo .
     1102       p-full-string = trim( p-full-string ) .
     1103       if length (p-full-string ) > 150 then do:
     1104       assign
     1105         p-possb-keep-string =  false
     1106         p-string            =  substring(p-full-string,1,150)
     1107         p-hash-string       =  encode(p-full-string)
     1108       .
     1109       end.
     1110       else do:
     1111       assign
     1112         p-possb-keep-string =  true
     1113         p-string            =  p-full-string
     1114         p-hash-string       =  encode(p-full-string)
     1115       .
     1116       end.
     1117     end.
     1118   end procedure.
     1119   procedure find-from-hash :
     1120     do
     1121     on error undo, return error return-value
     1122     :
     1123   define input  parameter  p-full-string            as character no-undo .
     1124   define input  parameter  p-table-name             as character no-undo .
     1125   define input  parameter  p-field-possb-keep-name  as character no-undo .
     1126   define input  parameter  p-field-string-name      as character no-undo .
     1127   define input  parameter  p-field-hash-string-name as character no-undo .
     1128   define input  parameter  p-sub-table-name         as character no-undo .
     1129   define output parameter  p-recid                  as recid     no-undo .
     1130   define variable v-possb-keep-string as logical   no-undo .
     1131   define variable v-string            as character no-undo .
     1132   define variable v-hash-string       as character no-undo .
     1133   define variable v-query-prepare     as character no-undo .
     1134   define variable i  as integer no-undo .
     1135   define variable qh as widget-handle no-undo .
     1136   define variable bh as widget-handle no-undo .
     1137   define variable p-rez as logical   no-undo .
     1138   run def-hash in this-procedure (input  p-full-string ,
     1139                 output v-possb-keep-string ,
     1140                 output v-string            ,
     1141                 output v-hash-string
     1142                 ).
     1143   p-recid = ? .
     1144   create buffer bh for table p-table-name.
     1145   create query qh.
     1146      v-query-prepare =
     1147       "for each " + p-table-name + " no-lock where "
     1148       + p-field-possb-keep-name   + " = "  + string(v-possb-keep-string) + " and "
     1149       + p-field-string-name       + " = '" + v-string            + "' and "
     1150       + p-field-hash-string-name  + " = '" + v-hash-string       + "'"
     1151       .
     1152   if v-possb-keep-string = true then do:
     1153       qh:set-buffers(bh).
     1154       qh:query-prepare(v-query-prepare).
     1155       qh:query-open.
     1156       qh:get-first.
     1157       p-recid = bh:recid.
     1158   end.
     1159   else do:
     1160   message false "анализ hash" .
     1161     qh:set-buffers(bh).
     1162     qh:query-prepare(v-query-prepare).
     1163     qh:query-open.
     1164     qh:get-first.
     1165     p-recid = bh:recid.
     1166     repeat :
     1167       qh:get-next.
     1168       if bh:available then do:
     1169          qh:get-first.
     1170          run ver-sub-table in this-procedure (
     1171              input  p-full-string ,
     1172              input  p-table-name ,
     1173              input  p-sub-table-name ,
     1174              input  bh:recid  ,
     1175              output p-rez
     1176              ).
     1177          if p-rez = true  then do:
     1178             p-recid = bh:recid .
     1179             leave.
     1180          end.
     1181          else do:
     1182            next.
     1183          end.
     1184       end.
     1185       leave.
     1186     end.
     1187   end.
     1188   delete widget bh.
     1189   delete widget qh.
     1190     end.
     1191   end procedure.
     1192   procedure ver-sub-table :
     1193     do
     1194     on error undo, return error return-value
     1195     :
     1196   define input  parameter p-full-string as character no-undo .
     1197   define input  parameter p-name-table as character no-undo .
     1198   define input  parameter p-sub-name-table as character no-undo .
     1199   define input  parameter p-recid as recid no-undo .
     1200   define output parameter p-ok as logical   no-undo .
     1201   define variable v-query-prepare     as character no-undo .
     1202   define variable i  as integer no-undo .
     1203   define variable qh as widget-handle no-undo .
     1204   define variable bh as widget-handle no-undo .
     1205   define variable p-rez as logical   no-undo .
     1206   for each temp-index_name-value : delete temp-index_name-value . end.
     1207   for each temp-sub-index_name : delete temp-sub-index_name . end.
     1208       create buffer bh for table p-name-table.
     1209       create query qh.
     1210       v-query-prepare = "for each " + p-name-table + " no-lock where recid(" + p-name-table + ") = " + string ( p-recid ) .
     1211       qh:set-buffers(bh).
     1212       qh:query-prepare(v-query-prepare).
     1213       qh:query-open.
     1214       qh:get-first.
     1215       p-recid = bh:recid.
     1216   define variable v-inf-ind AS CHAR NO-UNDO.
     1217   define variable v-name-pi as character no-undo .
     1218   define variable v-num-fl-inkey as integer   no-undo .
     1219   define variable v-num-fl       as integer   no-undo .
     1220   define variable j as integer   no-undo .
     1221   v-name-pi = bh:PRIMARY .
     1222   v-inf-ind = "1".
     1223   i = 0.
     1224   DO while ( v-inf-ind <> ? )
     1225       on error undo, return error:
     1226       i = i + 1 .
     1227       v-inf-ind = bh:INDEX-INFORMATION(i) .
     1228       if v-inf-ind = ? then leave.
     1229       if entry( 1 , v-inf-ind ) = v-name-pi then do:
     1230          v-num-fl-inkey = ( num-entries(v-inf-ind) - 4 ) / 2 .
     1231          v-num-fl       = ( num-entries(v-inf-ind) - 4 )     .
     1232         if v-num-fl-inkey >= 1 then do:
     1233             do j = 5 to v-num-fl  by 2 :
     1234                 create temp-index_name-value .
     1235                 assign
     1236                   temp-index_name-value.name-key  = entry( j , v-inf-ind )
     1237                   temp-index_name-value.value-key = bh:BUFFER-FIELD(entry( j , v-inf-ind )):BUFFER-VALUE
     1238                 .
     1239             end.
     1240          end.
     1241       end.
     1242   END.
     1243   define variable qh-sub as widget-handle no-undo .
     1244   define variable bh-sub as widget-handle no-undo .
     1245       create buffer bh-sub for table p-sub-name-table.
     1246       create query qh-sub.
     1247   define variable k as integer   no-undo init 0 .
     1248       v-query-prepare = "for each " + p-sub-name-table + " no-lock where " .
     1249       for each temp-index_name-value :
     1250           v-query-prepare = v-query-prepare  + p-sub-name-table + "." + temp-index_name-value.name-key +
     1251                         " = " + temp-index_name-value.value-key + " and " .
     1252       end.
     1253       v-query-prepare = v-query-prepare + " true = true " .
     1254       qh-sub:set-buffers(bh-sub).
     1255       qh-sub:query-prepare(v-query-prepare).
     1256       qh-sub:query-open.
     1257         v-name-pi = bh-sub:PRIMARY .
     1258         v-inf-ind = "1".
     1259         i = 0.
     1260         DO while ( v-inf-ind <> ? )
     1261             on error undo, return error:
     1262             i = i + 1 .
     1263             v-inf-ind = bh-sub:INDEX-INFORMATION(i) .
     1264             if v-inf-ind = ? then leave.
     1265             if entry( 1 , v-inf-ind ) = v-name-pi then do:
     1266               v-num-fl-inkey = ( num-entries(v-inf-ind) - 4 ) / 2 .
     1267               v-num-fl       = ( num-entries(v-inf-ind) - 4 )     .
     1268               if v-num-fl-inkey >= 1 then do:
     1269                   do j = 5 to v-num-fl  by 2 :
     1270                       if not can-find (first temp-index_name-value  where temp-index_name-value.name-key =  entry( j , v-inf-ind )) then do:
     1271                           create temp-sub-index_name .
     1272                           assign
     1273                             temp-sub-index_name.name-key  = entry( j , v-inf-ind )
     1274                             temp-sub-index_name.nn  = j
     1275                           .
     1276                       end.
     1277                   end.
     1278               end.
     1279             end.
     1280         END.
     1281         define variable v-qw as character no-undo .
     1282         v-qw = "".
     1283         qh-sub:GET-first.
     1284         DO WHILE (bh-sub:AVAILABLE):
     1285           for each temp-sub-index_name :
     1286               v-qw = v-qw + string(bh-sub:BUFFER-FIELD(temp-sub-index_name.name-key):BUFFER-VALUE) .
     1287           end.
     1288           v-qw = v-qw + ",".
     1289           qh-sub:GET-NEXT.
     1290         END.
     1291         p-ok = false .
     1292         if trim(p-full-string, ",")  =  trim (v-qw, ",") then p-ok = true  .
     1293       delete widget bh-sub.
     1294       delete widget qh-sub.
     1295       delete widget bh.
     1296       delete widget qh.
     1297     end.
     1298   end procedure.
     1299   PROCEDURE update-rang-def :
     1300   define input  parameter p-recid as recid     no-undo .
     1301   define input  parameter p-list-obj as character no-undo .
     1302   define input  parameter p-a as decimal   no-undo .
     1303   define input  parameter p-b as decimal   no-undo .
     1304   define input  parameter p-c as decimal   no-undo .
     1305   define input  parameter p-d as decimal   no-undo .
     1306   define input  parameter p-e as decimal   no-undo .
     1307   define input  parameter p-f as decimal   no-undo .
     1308   define variable v-date as date no-undo .
     1309   define variable v-time as integer no-undo .
     1310   define variable v-exist as logical   no-undo .
     1311   define variable p-id as integer   no-undo .
     1312   define variable p-db as integer   no-undo .
     1313   define variable  p-possb-keep-string-obj as logical   no-undo .
     1314   define variable  p-string-obj            as character no-undo .
     1315   define variable  p-hash-string-obj       as character no-undo .
     1316   define buffer buf_rang-abc-def     for ub.rang-abc-def.
     1317   define buffer buf_rang-abc-def-obj for ub.rang-abc-def-obj.
     1318   find first buf_rang-abc-def exclusive-lock where recid(buf_rang-abc-def) = p-recid no-error .
     1319   if not available buf_rang-abc-def then do:
     1320       v-exist = false  .
     1321       assign
     1322         p-id = next-value(s-asmt, ub)
     1323         p-db = g#db-num
     1324       .
     1325       create buf_rang-abc-def.
     1326       run def-hash in this-procedure (
     1327            input   p-list-obj
     1328           ,output  p-possb-keep-string-obj
     1329           ,output  p-string-obj
     1330           ,output  p-hash-string-obj
     1331           ).
     1332   end.
     1333   else do:
     1334     assign
     1335         v-exist = true
     1336         p-id = buf_rang-abc-def.raad-id
     1337         p-db = buf_rang-abc-def.db-num
     1338         p-hash-string-obj       = buf_rang-abc-def.raad-hash-string-obj
     1339         p-possb-keep-string-obj = buf_rang-abc-def.raad-possb-keep-string-obj
     1340         p-string-obj            = buf_rang-abc-def.raad-string-obj
     1341     .
     1342   end.
     1343   run cur-time in this-procedure ( output v-date, output v-time ) .
     1344       assign
     1345             buf_rang-abc-def.raad-hash-string-obj       = p-hash-string-obj
     1346             buf_rang-abc-def.raad-possb-keep-string-obj = p-possb-keep-string-obj
     1347             buf_rang-abc-def.raad-string-obj            = p-string-obj
     1348             buf_rang-abc-def.raad-a                     = p-a
     1349             buf_rang-abc-def.raad-b                     = p-b
     1350             buf_rang-abc-def.raad-c                     = p-c
     1351             buf_rang-abc-def.raad-d                     = p-d
     1352             buf_rang-abc-def.raad-e                     = p-e
     1353             buf_rang-abc-def.raad-f                     = p-f
     1354             buf_rang-abc-def.raad-id                    = p-id
     1355             buf_rang-abc-def.raad-date                  = v-date
     1356             buf_rang-abc-def.raad-db-num                = g#db-num
     1357             buf_rang-abc-def.db-num                     = p-db
     1358             buf_rang-abc-def.raad-time                  = v-time
     1359             buf_rang-abc-def.raad-who                   = g#userid
     1360         .
     1361   if v-exist = true then do:
     1362      for each buf_rang-abc-def-obj exclusive-lock where
     1363               buf_rang-abc-def-obj.raad-id = buf_rang-abc-def.raad-id and
     1364               buf_rang-abc-def-obj.db-num  = buf_rang-abc-def.db-num :
     1365               delete buf_rang-abc-def-obj.
     1366      end.
     1367   end.
     1368   define variable i as integer   no-undo .
     1369   define variable k as integer   no-undo .
     1370   p-list-obj = trim(p-list-obj, "," ).
     1371   k = num-entries(p-list-obj, ",") .
     1372   repeat  i = 1 to k :
     1373     create buf_rang-abc-def-obj.
     1374     assign
     1375       buf_rang-abc-def-obj.raad-id  = buf_rang-abc-def.raad-id
     1376       buf_rang-abc-def-obj.db-num   = buf_rang-abc-def.db-num
     1377       buf_rang-abc-def-obj.obj-type = substring(entry(i, p-list-obj) , 1 , 3 )
     1378       buf_rang-abc-def-obj.obj-code = integer(substring(entry(i, p-list-obj) , 4 , 10 ))
     1379     .
     1380   end.
     1381   RELEASE buf_rang-abc-def .
     1382   END PROCEDURE.
     1383   PROCEDURE update-rang-xyz-def :
     1384   define input  parameter p-recid as recid     no-undo .
