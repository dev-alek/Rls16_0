     1429             buf_rang-xyz-def.raxd-x                     = p-x
     1430             buf_rang-xyz-def.raxd-y                     = p-y
     1431             buf_rang-xyz-def.raxd-z                     = p-z
     1432             buf_rang-xyz-def.raxd-id                    = p-id
     1433             buf_rang-xyz-def.raxd-date                  = v-date
     1434             buf_rang-xyz-def.raxd-db-num                = g#db-num
     1435             buf_rang-xyz-def.db-num                     = p-db
     1436             buf_rang-xyz-def.raxd-time                  = v-time
     1437             buf_rang-xyz-def.raxd-who                   = g#userid
     1438         .
     1439   if v-exist = true then do:
     1440      for each buf_rang-xyz-def-obj exclusive-lock where
     1441               buf_rang-xyz-def-obj.raxd-id = buf_rang-xyz-def.raxd-id and
     1442               buf_rang-xyz-def-obj.db-num  = buf_rang-xyz-def.db-num :
     1443               delete buf_rang-xyz-def-obj.
     1444      end.
     1445   end.
     1446   define variable i as integer   no-undo .
     1447   define variable k as integer   no-undo .
     1448   p-list-obj = trim(p-list-obj, "," ).
     1449   k = num-entries(p-list-obj, ",") .
     1450   repeat  i = 1 to k :
     1451     create buf_rang-xyz-def-obj.
     1452     assign
     1453       buf_rang-xyz-def-obj.raxd-id  = buf_rang-xyz-def.raxd-id
     1454       buf_rang-xyz-def-obj.db-num   = buf_rang-xyz-def.db-num
     1455       buf_rang-xyz-def-obj.obj-type = substring(entry(i, p-list-obj) , 1 , 3 )
     1456       buf_rang-xyz-def-obj.obj-code = integer(substring(entry(i, p-list-obj) , 4 , 10 ))
     1457     .
     1458   end.
     1459   RELEASE buf_rang-xyz-def .
     1460   END PROCEDURE.
     1461   PROCEDURE update-doc-xyz-def :
     1462   define input  parameter p-recid as recid     no-undo .
     1463   define input  parameter p-list-obj as character no-undo .
     1464   define input  parameter p-list-doc as character no-undo .
     1465   define variable v-date as date no-undo .
     1466   define variable v-time as integer no-undo .
     1467   define variable v-exist as logical   no-undo .
     1468   define variable p-id as integer   no-undo .
     1469   define variable p-db as integer   no-undo .
     1470   define variable  p-possb-keep-string-obj as logical   no-undo .
     1471   define variable  p-string-obj            as character no-undo .
     1472   define variable  p-hash-string-obj       as character no-undo .
     1473   define variable  p-possb-keep-string-doc as logical   no-undo .
     1474   define variable  p-string-doc            as character no-undo .
     1475   define variable  p-hash-string-doc       as character no-undo .
     1476   define buffer buf_doc-xyz-def     for ub.doc-xyz-def.
     1477   define buffer buf_doc-xyz-def-obj for ub.doc-xyz-def-obj.
     1478   define buffer buf_doc-xyz-def-doc for ub.doc-xyz-def-doc.
     1479       run def-hash in this-procedure (
     1480            input   p-list-obj
     1481           ,output  p-possb-keep-string-obj
     1482           ,output  p-string-obj
     1483           ,output  p-hash-string-obj
     1484           ).
     1485       run def-hash in this-procedure  (
     1486            input   p-list-doc
     1487           ,output  p-possb-keep-string-doc
     1488           ,output  p-string-doc
     1489           ,output  p-hash-string-doc
     1490           ).
     1491   find first buf_doc-xyz-def exclusive-lock where recid(buf_doc-xyz-def) = p-recid no-error .
     1492   if not available buf_doc-xyz-def then do:
     1493       v-exist = false  .
     1494       assign
     1495         p-id = next-value(s-asmt, ub)
     1496         p-db = g#db-num
     1497       .
     1498       create buf_doc-xyz-def.
     1499   end.
     1500   else do:
     1501     assign
     1502         v-exist = true
     1503         p-id = buf_doc-xyz-def.doxd-id
     1504         p-db = buf_doc-xyz-def.db-num
     1505     .
     1506   end .
     1507   run cur-time in this-procedure ( output v-date, output v-time ) .
     1508       assign
     1509             buf_doc-xyz-def.doxd-hash-string-obj       = p-hash-string-obj
     1510             buf_doc-xyz-def.doxd-possb-keep-string-obj = p-possb-keep-string-obj
     1511             buf_doc-xyz-def.doxd-string-obj            = p-string-obj
     1512             buf_doc-xyz-def.doxd-hash-string-doc       = p-hash-string-doc
     1513             buf_doc-xyz-def.doxd-possb-keep-string-doc = p-possb-keep-string-doc
     1514             buf_doc-xyz-def.doxd-string-doc            = p-string-doc
     1515             buf_doc-xyz-def.doxd-id                    = p-id
     1516             buf_doc-xyz-def.doxd-date                  = v-date
     1517             buf_doc-xyz-def.doxd-db-num                = g#db-num
     1518             buf_doc-xyz-def.doxd-time                  = v-time
     1519             buf_doc-xyz-def.doxd-who                   = g#userid
     1520             buf_doc-xyz-def.db-num                     = p-db
     1521         .
     1522   if v-exist = true then do:
     1523      for each buf_doc-xyz-def-doc exclusive-lock where
     1524               buf_doc-xyz-def-doc.doxd-id = buf_doc-xyz-def.doxd-id and
     1525               buf_doc-xyz-def-doc.db-num  = buf_doc-xyz-def.db-num :
     1526               delete buf_doc-xyz-def-doc.
     1527      end.
     1528      for each buf_doc-xyz-def-obj exclusive-lock where
     1529               buf_doc-xyz-def-obj.doxd-id = buf_doc-xyz-def.doxd-id and
     1530               buf_doc-xyz-def-obj.db-num  = buf_doc-xyz-def.db-num :
     1531               delete buf_doc-xyz-def-obj.
     1532      end.
     1533   end.
     1534   define variable i as integer   no-undo .
     1535   define variable k as integer   no-undo .
     1536   p-list-obj = trim(p-list-obj, ",")  .
     1537   k = num-entries(p-list-obj, ",") .
     1538   repeat  i = 1 to k :
     1539     create buf_doc-xyz-def-obj.
     1540     assign
     1541       buf_doc-xyz-def-obj.doxd-id  = buf_doc-xyz-def.doxd-id
     1542       buf_doc-xyz-def-obj.db-num   = buf_doc-xyz-def.db-num
     1543       buf_doc-xyz-def-obj.obj-type = substring(entry(i, p-list-obj) , 1 , 3 )
     1544       buf_doc-xyz-def-obj.obj-code = integer(substring(entry(i, p-list-obj) , 4 , 10 ))
     1545     .
     1546   end.
     1547   p-list-doc = trim(p-list-doc , ",") .
     1548   k = num-entries(p-list-doc, ",") .
     1549   repeat  i = 1 to k :
     1550     create buf_doc-xyz-def-doc.
     1551     assign
     1552       buf_doc-xyz-def-doc.doxd-id  = buf_doc-xyz-def.doxd-id
     1553       buf_doc-xyz-def-doc.db-num   = buf_doc-xyz-def.db-num
     1554       buf_doc-xyz-def-doc.dxdd-ext-doc-type = entry(i, p-list-doc)
     1555     .
     1556   end.
     1557   RELEASE buf_doc-xyz-def .
     1558   END PROCEDURE.
     1559   PROCEDURE update-doc-def :
     1560   define input  parameter p-recid as recid     no-undo .
     1561   define input  parameter p-list-obj as character no-undo .
     1562   define input  parameter p-list-doc as character no-undo .
     1563   define variable v-date as date no-undo .
     1564   define variable v-time as integer no-undo .
     1565   define variable v-exist as logical   no-undo .
     1566   define variable p-id as integer   no-undo .
     1567   define variable p-db as integer   no-undo .
     1568   define variable  p-possb-keep-string-obj as logical   no-undo .
     1569   define variable  p-string-obj            as character no-undo .
     1570   define variable  p-hash-string-obj       as character no-undo .
     1571   define variable  p-possb-keep-string-doc as logical   no-undo .
     1572   define variable  p-string-doc            as character no-undo .
     1573   define variable  p-hash-string-doc       as character no-undo .
     1574   define buffer buf_doc-abc-def     for ub.doc-abc-def.
     1575   define buffer buf_doc-abc-def-obj for ub.doc-abc-def-obj.
     1576   define buffer buf_doc-abc-def-doc for ub.doc-abc-def-doc.
     1577       run def-hash  in this-procedure (
     1578            input   p-list-obj
     1579           ,output  p-possb-keep-string-obj
     1580           ,output  p-string-obj
     1581           ,output  p-hash-string-obj
     1582           ).
     1583       run def-hash  in this-procedure (
     1584            input   p-list-doc
     1585           ,output  p-possb-keep-string-doc
     1586           ,output  p-string-doc
     1587           ,output  p-hash-string-doc
     1588           ).
     1589   find first buf_doc-abc-def exclusive-lock where recid(buf_doc-abc-def) = p-recid no-error .
     1590   if not available buf_doc-abc-def then do:
     1591       v-exist = false  .
     1592       assign
     1593         p-id = next-value(s-asmt, ub)
     1594         p-db = g#db-num
     1595       .
     1596       create buf_doc-abc-def.
     1597   end.
     1598   else do:
     1599     assign
     1600         v-exist = true
     1601         p-id = buf_doc-abc-def.doad-id
     1602         p-db = buf_doc-abc-def.db-num
     1603     .
     1604   end .
     1605   run cur-time in this-procedure ( output v-date, output v-time ) .
     1606       assign
     1607             buf_doc-abc-def.doad-hash-string-obj       = p-hash-string-obj
     1608             buf_doc-abc-def.doad-possb-keep-string-obj = p-possb-keep-string-obj
     1609             buf_doc-abc-def.doad-string-obj            = p-string-obj
     1610             buf_doc-abc-def.doad-hash-string-doc       = p-hash-string-doc
     1611             buf_doc-abc-def.doad-possb-keep-string-doc = p-possb-keep-string-doc
     1612             buf_doc-abc-def.doad-string-doc            = p-string-doc
     1613             buf_doc-abc-def.doad-id                    = p-id
     1614             buf_doc-abc-def.doad-date                  = v-date
     1615             buf_doc-abc-def.doad-db-num                = g#db-num
     1616             buf_doc-abc-def.doad-time                  = v-time
     1617             buf_doc-abc-def.doad-who                   = g#userid
     1618             buf_doc-abc-def.db-num                     = p-db
     1619         .
     1620   if v-exist = true then do:
     1621      for each buf_doc-abc-def-doc exclusive-lock where
     1622               buf_doc-abc-def-doc.doad-id = buf_doc-abc-def.doad-id and
     1623               buf_doc-abc-def-doc.db-num  = buf_doc-abc-def.db-num :
     1624               delete buf_doc-abc-def-doc.
     1625      end.
     1626      for each buf_doc-abc-def-obj exclusive-lock where
     1627               buf_doc-abc-def-obj.doad-id = buf_doc-abc-def.doad-id and
     1628               buf_doc-abc-def-obj.db-num  = buf_doc-abc-def.db-num :
     1629               delete buf_doc-abc-def-obj.
     1630      end.
     1631   end.
     1632   define variable i as integer   no-undo .
     1633   define variable k as integer   no-undo .
     1634   p-list-obj = trim(p-list-obj, ",")  .
     1635   k = num-entries(p-list-obj, ",") .
     1636   repeat  i = 1 to k :
     1637     create buf_doc-abc-def-obj.
     1638     assign
     1639       buf_doc-abc-def-obj.doad-id  = buf_doc-abc-def.doad-id
     1640       buf_doc-abc-def-obj.db-num   = buf_doc-abc-def.db-num
     1641       buf_doc-abc-def-obj.obj-type = substring(entry(i, p-list-obj) , 1 , 3 )
     1642       buf_doc-abc-def-obj.obj-code = integer(substring(entry(i, p-list-obj) , 4 , 10 ))
     1643     .
     1644   end.
     1645   p-list-doc = trim(p-list-doc , ",") .
     1646   k = num-entries(p-list-doc, ",") .
     1647   repeat  i = 1 to k :
     1648     create buf_doc-abc-def-doc.
     1649     assign
     1650       buf_doc-abc-def-doc.doad-id  = buf_doc-abc-def.doad-id
     1651       buf_doc-abc-def-doc.db-num   = buf_doc-abc-def.db-num
     1652       buf_doc-abc-def-doc.dadd-ext-doc-type = entry(i, p-list-doc)
     1653     .
     1654   end.
     1655   RELEASE buf_doc-abc-def .
     1656   END PROCEDURE.
     1657   PROCEDURE find-def-analysis-obj :
     1658   define input  parameter p-type     as character no-undo .
     1659   define input  parameter p-obj-type as character no-undo .
     1660   define input  parameter p-obj-code as integer   no-undo .
     1661   define output parameter p-abc-id   as integer   no-undo .
     1662   define output parameter p-db-num   as integer   no-undo .
     1663     do
     1664     on error undo, return error return-value
     1665     :
     1666     if p-type = "abc"  then do:
     1667         define buffer buf_abc-analysis-obj for ub.abc-analysis-obj  .
     1668         define buffer buf_abc-analysis     for ub.abc-analysis      .
     1669         find first buf_abc-analysis-obj no-lock where
     1670                   buf_abc-analysis-obj.obj-type = p-obj-type and
     1671                   buf_abc-analysis-obj.obj-code = p-obj-code and
     1672                   buf_abc-analysis-obj.is-def   = true use-index objdef no-error .
     1673                   if available buf_abc-analysis-obj then do:
     1674                       p-abc-id = buf_abc-analysis-obj.abc-id .
     1675                       p-db-num = buf_abc-analysis-obj.db-num .
     1676                   end.
     1677                   else do:
     1678                       p-abc-id = 0 .
     1679                       p-db-num = 0.
     1680                       return "На объекте нет анализа по умолчанию" .
     1681                   end.
     1682     end.
     1683     if p-type = "xyz"  then do:
     1684         define buffer buf_xyz-analysis-obj for ub.xyz-analysis-obj  .
     1685         define buffer buf_xyz-analysis     for ub.xyz-analysis      .
     1686         find first buf_xyz-analysis-obj no-lock where
     1687                   buf_xyz-analysis-obj.obj-type = p-obj-type and
     1688                   buf_xyz-analysis-obj.obj-code = p-obj-code and
     1689                   buf_xyz-analysis-obj.is-def   = true use-index objdef no-error .
     1690                   if available buf_xyz-analysis-obj then do:
     1691                       p-abc-id = buf_xyz-analysis-obj.xyz-id .
     1692                       p-db-num = buf_xyz-analysis-obj.db-num .
     1693                   end.
     1694                   else do:
     1695                       p-abc-id = 0 .
     1696                       p-db-num = 0 .
     1697                       return "На объекте нет анализа по умолчанию" .
     1698                   end.
     1699     end.
     1700     return .
     1701   end.
     1702   END PROCEDURE.
     1703   procedure save-def-analysis-obj :
     1704   define input  parameter p-type     as character no-undo .
     1705   define input  parameter p-db-num   as integer   no-undo .
     1706   define input  parameter p-abc-id   as integer   no-undo .
     1707   define output parameter v-log      as logical   no-undo .
     1708     do
     1709     on error undo, return error return-value
     1710     :
     1711     v-log = true .
     1712     if p-type = "abc"  then do:
     1713         define buffer buf_abc-analysis-obj for ub.abc-analysis-obj  .
     1714         define buffer buf_abc-obj          for ub.abc-analysis-obj  .
     1715         define buffer buf_abc-analysis     for ub.abc-analysis      .
     1716         for each buf_abc-obj no-lock where
     1717                  buf_abc-obj.abc-id = p-abc-id and
     1718                  buf_abc-obj.db-num = p-db-num :
     1719               define variable v-exist    as logical   no-undo init false .
     1720               define variable v-list-anal as character no-undo init ""    .
     1721               for each  buf_abc-analysis-obj no-lock where
     1722                         not (buf_abc-analysis-obj.abc-id = p-abc-id and
     1723                              buf_abc-analysis-obj.db-num = p-db-num) and
     1724                         buf_abc-analysis-obj.is-def   = true   and
     1725                         buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1726                         buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code
     1727                         :
     1728                   v-exist    = true .
     1729                   v-list-anal = string( buf_abc-analysis-obj.abc-id ) + "," .
     1730               end.
     1731               if v-exist then do:
     1732                   message "На объекте "
     1733                   buf_abc-obj.obj-type
     1734                   buf_abc-obj.obj-code
     1735                   skip
     1736                   "уже есть анализы по умолчанию , их внутренние номера :" skip
     1737                   v-list-anal                                              skip
     1738                   "Сделать по умолчанию анализ текущий " p-abc-id " ?"
     1739                   view-as alert-box question
     1740                   buttons yes-no update v-log .
     1741                   if v-log then do:
     1742                       for each  buf_abc-analysis-obj exclusive-lock where
     1743                                 buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1744                                 buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code :
     1745                         if ( buf_abc-analysis-obj.abc-id = p-abc-id and
     1746                              buf_abc-analysis-obj.db-num = p-db-num ) then
     1747                                 buf_abc-analysis-obj.is-def   = true .
     1748                         else buf_abc-analysis-obj.is-def   = false  .
     1749                       end.
     1750                   end.
     1751               end.
     1752               else do:
     1753                 for each  buf_abc-analysis-obj exclusive-lock where
     1754                           buf_abc-analysis-obj.obj-type = buf_abc-obj.obj-type and
     1755                           buf_abc-analysis-obj.obj-code = buf_abc-obj.obj-code and
     1756                           buf_abc-analysis-obj.abc-id = p-abc-id and
     1757                           buf_abc-analysis-obj.db-num = p-db-num
     1758                           :
     1759                     buf_abc-analysis-obj.is-def   = true .
     1760                 end.
     1761               end.
     1762         end.
     1763     end.
     1764     if p-type = "xyz"  then do:
     1765         define buffer buf_xyz-analysis-obj for ub.xyz-analysis-obj  .
     1766         define buffer buf_xyz-obj          for ub.xyz-analysis-obj  .
     1767         define buffer buf_xyz-analysis     for ub.xyz-analysis      .
     1768         for each buf_xyz-obj no-lock where
     1769                  buf_xyz-obj.xyz-id = p-abc-id and
     1770                  buf_xyz-obj.db-num = p-db-num :
     1771               v-exist = false .
     1772               v-list-anal = ""    .
     1773               for each  buf_xyz-analysis-obj no-lock where
     1774                         not (buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1775                              buf_xyz-analysis-obj.db-num = p-db-num) and
     1776                         buf_xyz-analysis-obj.is-def   = true   and
     1777                         buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1778                         buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code
     1779                         :
     1780                   v-exist    = true .
     1781                   v-list-anal = string( buf_xyz-analysis-obj.xyz-id ) + "," .
     1782               end.
     1783               if v-exist then do:
     1784                   message "На объекте "
     1785                   buf_xyz-obj.obj-type
     1786                   buf_xyz-obj.obj-code
     1787                   skip
     1788                   "уже есть анализы по умолчанию , их внутренние номера :" skip
     1789                   v-list-anal                                              skip
     1790                   "Сделать по умолчанию анализ текущий " p-abc-id " ?"
     1791                   view-as alert-box question
     1792                   buttons yes-no update v-log .
     1793                   if v-log then do:
     1794                       for each  buf_xyz-analysis-obj exclusive-lock where
     1795                                 buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1796                                 buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code :
     1797                         if ( buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1798                              buf_xyz-analysis-obj.db-num = p-db-num ) then
     1799                                 buf_xyz-analysis-obj.is-def   = true .
     1800                         else buf_xyz-analysis-obj.is-def   = false  .
     1801                       end.
     1802                   end.
     1803               end.
     1804               else do:
     1805                 for each  buf_xyz-analysis-obj exclusive-lock where
     1806                           buf_xyz-analysis-obj.obj-type = buf_xyz-obj.obj-type and
     1807                           buf_xyz-analysis-obj.obj-code = buf_xyz-obj.obj-code and
     1808                           buf_xyz-analysis-obj.xyz-id = p-abc-id and
     1809                           buf_xyz-analysis-obj.db-num = p-db-num
     1810                           :
     1811                     buf_xyz-analysis-obj.is-def   = true .
     1812                 end.
     1813               end.
     1814         end.
     1815     end.
     1816   end.
     1817   end procedure.
     1818   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1819   define new global shared variable g#attr-lib  as handle no-undo .
     1820   define variable v-attr-lib-variable as handle no-undo .
     1821   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1822   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1823   procedure thbjattr_code :
     1824      define input  parameter p-upper-code     as character no-undo .
     1825      define input  parameter p-code           as character no-undo .
     1826      define output parameter p-label          as character no-undo .
     1827      define output parameter p-user-can-edit  as logical   no-undo .
     1828      define output parameter p-output-display as logical   no-undo .
     1829      define output parameter p-other          as character no-undo .
     1830      define output parameter p-prop-list      as character no-undo .
     1831      define output parameter p-prop-type-list as character no-undo .
     1832      define output parameter p-prop-label-list as character no-undo .
     1833      define output parameter p-global          as logical no-undo .
     1834      define output parameter p-host           as logical no-undo .
     1835      define output parameter p-shop           as logical no-undo .
     1836      define output parameter p-store          as logical no-undo .
     1837      define output parameter p-db             as logical no-undo .
     1838      define variable p-region as logical no-undo.
     1839      run thbjattr_code_reg in this-procedure (
     1840                                               p-upper-code,
     1841                                               p-code,
     1842                                               output p-label,
     1843                                               output p-user-can-edit,
     1844                                               output p-output-display,
     1845                                               output p-other,
     1846                                               output p-prop-list,
     1847                                               output p-prop-type-list,
     1848                                               output p-prop-label-list,
     1849                                               output p-global,
     1850                                               output p-host,
     1851                                               output p-shop,
     1852                                               output p-store,
     1853                                               output p-db,
     1854                                               output p-region
     1855                                               ).
     1856   end procedure.
     1857   procedure thbjattr_code_reg :
     1858   define input  parameter p-upper-code     as character no-undo .
     1859   define input  parameter p-code           as character no-undo .
     1860   define output parameter p-label          as character no-undo .
     1861   define output parameter p-user-can-edit  as logical   no-undo .
     1862   define output parameter p-output-display as logical   no-undo .
     1863   define output parameter p-other          as character no-undo .
     1864   define output parameter p-prop-list      as character no-undo .
     1865   define output parameter p-prop-type-list as character no-undo .
     1866   define output parameter p-prop-label-list as character no-undo .
     1867   define output parameter p-global          as logical no-undo .
     1868   define output parameter p-host           as logical no-undo .
     1869   define output parameter p-shop           as logical no-undo .
     1870   define output parameter p-store          as logical no-undo .
     1871   define output parameter p-db             as logical no-undo .
     1872   define output parameter p-region         as logical no-undo .
     1873   do
     1874   on error undo, return error return-value
     1875   :
     1876       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     1877       (input  p-upper-code
     1878       ,input  p-code
     1879       ,output p-label
     1880       ,output p-user-can-edit
     1881       ,output p-output-display
     1882       ,output p-other
     1883       ,output p-prop-list
     1884       ,output p-prop-type-list
     1885       ,output p-prop-label-list
     1886       ,output p-global
     1887       ,output p-host
     1888       ,output p-shop
     1889       ,output p-store
     1890       ,output p-db
     1891       ,output p-region
     1892       ) no-error .
     1893     if error-status :error
     1894     then do:
     1895       undo, return error substitute( "&1. &2&3&4", vss-include-info12, return-value, chr(10), error-status :get-message (1)).
     1896     end.
     1897   end.
     1898   end procedure.
     1899   procedure thbjattr_tooltip :
     1900   define input  parameter p-upper-code  as character no-undo .
     1901   define input  parameter p-code      as character no-undo .
     1902   define output parameter p-tooltip   as character no-undo .
     1903   define output parameter p-label     as character no-undo .
     1904   define output parameter p-tooltip-code as character no-undo .
