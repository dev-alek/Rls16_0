     3810           .
     3811           if v-object-handle <> v-diasize-resize-button
     3812           then do:
     3813             assign
     3814               v-object-handle :col = v-object-handle :col + p-change-value
     3815               no-error .
     3816             if error-status :error
     3817             or error-status :get-message(1) <> ""
     3818             then do:
     3819               undo move_block, retry move_block .
     3820             end.
     3821           end.
     3822         end.
     3823       end.
     3824       else do:
     3825         for each buf_temp-diasize-handle
     3826         on error undo move_block, retry move_block
     3827         :
     3828           assign
     3829             v-object-handle = buf_temp-diasize-handle.handle-value
     3830           .
     3831           if v-object-handle <> v-diasize-resize-button
     3832           then do:
     3833             assign
     3834               v-object-handle :col = v-object-handle :col + p-change-value
     3835               no-error .
     3836             if error-status :error
     3837             or error-status :get-message(1) <> ""
     3838             then do:
     3839               undo move_block, retry move_block .
     3840             end.
     3841           end.
     3842         end.
     3843         for each buf_temp-browse-handle
     3844           where buf_temp-browse-handle.browse-type = 'width':u
     3845         on error undo move_block, retry move_block
     3846         :
     3847           assign
     3848             buf_temp-browse-handle.browse-handle :width
     3849               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3850             no-error .
     3851           if error-status :error
     3852           or error-status :get-message(1) <> ""
     3853           then do:
     3854             undo move_block, retry move_block .
     3855           end.
     3856         end.
     3857         assign
     3858           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3859           no-error .
     3860         if error-status :error
     3861         or error-status :get-message(1) <> ""
     3862         then do:
     3863           undo move_block, retry move_block.
     3864         end.
     3865         assign
     3866           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3867         no-error .
     3868         if error-status :error
     3869         or error-status :get-message(1) <> ""
     3870         then do:
     3871           undo move_block, retry move_block.
     3872         end.
     3873         if frame Dialog-Frame :scrollable = true
     3874         then do:
     3875           assign
     3876             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3877           no-error .
     3878           if error-status :error
     3879           or error-status :get-message(1) <> ""
     3880           then do:
     3881             undo move_block, retry move_block.
     3882           end.
     3883         end.
     3884       end.
     3885       if p-move-resize
     3886       then do:
     3887         run diasize_position-resize-button in this-procedure .
     3888       end.
     3889       if v-diasize-wndstore = true
     3890       then do:
     3891         if connected("ub") = true
     3892         then do:
     3893           define variable v-cntxt-db-num        as integer   no-undo .
     3894           define variable v-cntxt-userid        as character no-undo .
     3895           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3896                                             , OUTPUT v-cntxt-userid
     3897                                             ) .
     3898           run gbl/wndsizew.p
     3899             (input  v-cntxt-db-num
     3900             ,input  v-cntxt-userid
     3901             ,input  v-diasize-proc-name
     3902             ,input  'width':u
     3903             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3904             ) .
     3905         end.
     3906       end.
     3907     end.
     3908     assign
     3909       v-diasize-change-size = false
     3910     .
     3911   end procedure.
     3912   procedure diasize_set-width :
     3913     define input  parameter p-new-width  as decimal   no-undo .
     3914     define input  parameter p-move-resize as logical   no-undo .
