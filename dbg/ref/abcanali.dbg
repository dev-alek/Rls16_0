      468   procedure prn-lib-open-stream :
      469     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      470     define input parameter p-page-size    as integer no-undo .
      471     define input parameter p-is-stream    as logical no-undo .
      472     define input parameter p-append       as logical no-undo .
      473     define variable v-report-name as character no-undo .
      474     do
      475       on error undo, return error
      476       :
      477       run prn-lib-get-report-name  in this-procedure (
      478         input parParentProc
      479         ,output v-report-name
      480         ).
      481       if p-is-stream then
      482       do:
      483         if p-append then
      484         do:
      485           output stream PrnLibStream to value( v-report-name )
      486             page-size value(p-page-size) append .
      487         end.
      488         if not p-append then
      489         do:
      490           output stream PrnLibStream to value( v-report-name )
      491             page-size value(p-page-size) .
      492         end.
      493       end.
      494       if not p-is-stream then
      495       do:
      496         if p-append then
      497         do:
      498           output to value( v-report-name )
      499             page-size value(p-page-size) append .
      500         end.
      501         if not p-append then
      502         do:
      503           output to value( v-report-name )
      504             page-size value(p-page-size) .
      505         end.
      506       end.
      507     end.
      508   end procedure.
      509   procedure prn-lib-open-exp :
      510     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      511     define input parameter p-is-stream    as logical no-undo .
      512     define input parameter p-is-append    as logical no-undo .
      513     define output parameter p-ReportFileName as char init "report" no-undo.
      514     define output parameter p-process as logical no-undo .
      515     define variable glog as logical no-undo .
      516     do
      517       on error undo, return error
      518       :
      519       SYSTEM-DIALOG GET-FILE p-ReportFileName
      520         TITLE      "Укажите путь"
      521         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      522         ASK-OVERWRITE
      523         CREATE-TEST-FILE
      524         SAVE-AS
      525         USE-FILENAME
      526         DEFAULT-EXTENSION "txt"
      527         UPDATE glog
      528         .
      529       if not glog then  return.
      530       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      531       if p-is-stream then
      532       do:
      533         if p-is-append then
      534         do:
      535           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      536         end.
      537         else
      538         do:
      539           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      540         end.
      541       end.
      542       else
      543       do:
      544         if p-is-append then
      545         do:
      546           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      547         end.
      548         else
      549         do:
      550           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      551         end.
      552       end.
      553       p-process = yes.
      554     end.
      555   end procedure.
      556   procedure prn-lib-get-report-name :
      557     define input parameter parParentProc  as widget-handle no-undo.
      558     define output parameter p-report-name as character no-undo .
      559     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      560   end procedure.
      561   procedure prn-lib-reportviewer-report-name :
      562     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      563     define input parameter p-report-name-html as character no-undo .
      564     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      565   end procedure.
      566   procedure prn-lib-reportviewer :
      567     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      568     define input parameter p-report-name-html as character no-undo .
      569     define input parameter p-param        as character no-undo .
      570     define variable v-excel           as character no-undo init 'TRUE' .
      571     define variable v-value-character as character no-undo .
      572     define variable v-value-integer   as character no-undo .
      573     define variable v-value-date      as date      no-undo .
      574     define variable v-value-decimal   as decimal   no-undo .
      575     define variable rep-excel         as logical   no-undo .
      576     define variable excel-string      as character no-undo .
      577     define variable v-param-type      as character no-undo .
      578     define variable v-tth             as handle    no-undo .
      579     run adm/shattri.p (
      580       input "get":U
      581       ,input  ""
      582       ,input  0
      583       ,input  'report-glob':U
      584       ,input  'rep-excel':U
      585       ,output v-value-character
      586       ,output v-value-date
      587       ,output v-value-decimal
      588       ,output v-value-integer
      589       ,output rep-excel
      590       ,output v-param-type
      591       ,INPUT-OUTPUT table-handle v-tth
      592       )  .
      593     if rep-excel then v-excel = "TRUE" .
      594     else v-excel = "FALSE" .
      595     if p-param eq ""
      596     then
      597        p-param = "EXCEL:" + v-excel.
      598     else
      599        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      600     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      601   end procedure.
      602   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      603   procedure cur-time :
      604      define output parameter p-today as date      no-undo .
      605      define output parameter p-time  as integer   no-undo .
      606     do
      607     on error undo, return error
      608     :
      609       define variable v-date1 as date      no-undo .
      610       define variable v-date2 as date      no-undo .
      611       define variable v-time  as integer   no-undo .
      612       assign
      613         v-date1 = today
      614         v-time  = time
      615         v-date2 = today
      616       .
      617       if v-date1 <> v-date2
      618       then do:
      619         assign
      620           v-date1 = today
      621           v-time  = v-time
      622         .
      623       end.
      624       assign
      625         p-today = v-date1
      626         p-time  = v-time
      627       .
      628     end.
      629   end.
      630   function cur-time-date returns character
      631   :
      632     return string(today, '99/99/9999':U) .
      633   end.
      634   function cur-time-mjd returns decimal
      635   :
      636     define variable v-date as date      no-undo .
      637     define variable v-time as integer   no-undo .
      638     run cur-time in this-procedure
      639       (output v-date
      640       ,output v-time
      641       ) .
      642     return integer(v-date) - 2400002 + (v-time / 86400) .
      643   end.
      644   function cur-time-get-ending-index returns integer
      645   (input p-number as integer
      646   )
      647   :
      648     if p-number < 0
      649     or p-number = ?
      650     then do:
      651       return 1 .
      652     end.
      653     define variable v-rest as integer   no-undo .
      654     assign
      655       p-number = p-number modulo 100
      656     .
      657     if p-number < 20
      658     then do:
      659       assign
      660         v-rest = p-number
      661       .
      662     end.
      663     else do:
      664       assign
      665         v-rest = p-number modulo 10
      666       .
      667     end.
      668     case v-rest :
      669       when 1
      670       then do:
      671         return 2 .
      672       end.
      673       when 2 or
      674       when 3 or
      675       when 4
      676       then do:
      677         return 3 .
      678       end.
      679       otherwise do:
      680         return 1 .
      681       end.
      682     end case .
      683   end.
      684   procedure cur-time-mjd-to-date :
      685      define input  parameter i-mjd-diff as decimal no-undo.
      686      define output parameter o-Date     as date    no-undo.
      687      define output parameter o-Time     as integer no-undo.
      688      define variable v-day-number as integer   no-undo .
      689      if    i-mjd-diff < 0
      690         or i-mjd-diff = ?
      691      then do:
      692         return "?" .
      693      end.
      694      assign
      695         v-day-number = truncate(i-mjd-diff,0).
      696         o-Date = date(v-day-number + 2400002).
      697         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      698     .
      699   end.
      700   function cur-time-mjd-to-string returns character
      701   (input p-mjd-diff as decimal
      702   )
      703   :
      704     define variable v-day-number as integer   no-undo .
      705     define variable v-seconds    as integer   no-undo .
      706     define variable v-hour       as integer   no-undo .
      707     define variable v-min        as integer   no-undo .
      708     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      709     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      710     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      711     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      712     if p-mjd-diff < 0
      713     or p-mjd-diff = ?
      714     then do:
      715       return "?" .
      716     end.
      717     assign
      718       v-day-number = integer(truncate(p-mjd-diff,0))
      719       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      720     .
      721     if v-seconds > 86400
      722     then do:
      723       assign
      724         v-seconds = 86400 - 1
      725       .
      726     end.
      727     if v-seconds < 0
      728     then do:
      729       assign
      730         v-seconds = 0
      731       .
      732     end.
      733     assign
      734       v-hour = truncate(v-seconds / 3600, 0)
      735     .
      736     assign
      737       v-seconds = v-seconds modulo 3600
      738     .
      739     assign
      740       v-min = truncate(v-seconds / 60, 0)
      741     .
      742     assign
      743       v-seconds = v-seconds modulo 60
      744     .
      745     return
      746         (if v-day-number <> 0
      747           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      748           else ""
      749         )
      750       + (if v-day-number <> 0 or v-hour <> 0
      751           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      752           else ""
      753         )
      754       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      755           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      756           else ""
      757         )
      758       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      759       .
      760   end.
      761   function cur-time-string returns character
      762   :
      763     define variable v-date as date      no-undo .
      764     define variable v-time as integer   no-undo .
      765     run cur-time in this-procedure
      766       (output v-date
      767       ,output v-time
      768       ) .
      769     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      770   end.
      771   function cur-time-string-sec returns character
      772   :
      773     define variable v-date as date      no-undo .
      774     define variable v-time as integer   no-undo .
      775     run cur-time in this-procedure
      776       (output v-date
      777       ,output v-time
      778       ) .
      779     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      780   end.
      781   function cur-time-custom  returns character
      782   (input p-prefix as character
      783   ,input p-date-format as character
      784   ,input p-delimiter as character
      785   ,input p-time-format as character
      786   ,input p-suffix as character
      787   )
      788   :
      789     define variable v-date as date      no-undo .
      790     define variable v-time as integer   no-undo .
      791     run cur-time in this-procedure
      792       (output v-date
      793       ,output v-time
      794       ) .
      795     return
      796       p-prefix
      797       + string(v-date, p-date-format)
      798       + p-delimiter
      799       + string(v-time, p-time-format)
      800       + p-suffix
      801       .
      802   end.
      803   function cur-time-print  returns character
      804   :
      805     define variable v-date as date      no-undo .
      806     define variable v-time as integer   no-undo .
      807     run cur-time in this-procedure
      808       (output v-date
      809       ,output v-time
      810       ) .
      811     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      812   end.
      813   function cur-time-datetime returns datetime
      814   :
      815     define variable v-char as character no-undo .
      816     define variable v-datetime as datetime no-undo .
      817     v-char = cur-time-string().
      818     v-datetime = datetime(v-char).
      819     return  v-datetime.
      820   end.
      821   function cur-time-string-msec returns character
      822   :
      823     define variable v-date as datetime  no-undo .
      824     v-date = now.
      825     return string(v-date) .
      826   end.
