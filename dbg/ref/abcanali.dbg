      437   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      438   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      439     (input  v-report-name
      440     ,input  2
      441     ,output v-exist
      442     )  .
      443       if NOT v-exist then
      444       DO:
      445         Message
      446           "Нет заданий на печать ! "
      447           view-as alert-box .
      448         Return  .
      449       End.
      450       run gbl/prnfilen.w
      451         (input  ""
      452         ,input  p-DisabledOptions
      453         ,input  string(v-report-name )
      454         ,input  7
      455         ,output v-user-action
      456         ,output v-printed
      457         ) .
      458       if v-printed then
