     3724         :
     3725           if  v-object-handle <> v-diasize-browse-handle :handle
     3726           and v-object-handle <> v-diasize-resize-button
     3727           and can-query(v-object-handle, "row")
     3728           and can-query(v-object-handle, "height")
     3729           and ( v-object-handle :col + v-object-handle :width
     3730                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3731               )
     3732           then do:
     3733             find first buf_temp-browse-handle
     3734               where buf_temp-browse-handle.browse-type   = 'width':u
     3735                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3736               no-error .
     3737             if available buf_temp-browse-handle
     3738             then do:
     3739             end.
     3740             else do:
     3741               create buf_temp-diasize-handle .
     3742               assign
     3743                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3744                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3745               .
     3746             end.
     3747           end.
     3748           assign
     3749             v-object-handle = v-object-handle :next-sibling
     3750           .
     3751         end.
     3752         assign
     3753           v-field-group-handle = v-field-group-handle :next-sibling
     3754         .
     3755       end.
     3756       do with frame Dialog-Frame
     3757       :
     3758         hide v-diasize-resize-button .
     3759         v-diasize-resize-button :row = 1.
     3760         v-diasize-resize-button :column = 1.
     3761       end.
     3762       if p-change-value > 0
     3763       then do:
     3764         if frame Dialog-Frame :scrollable = true
     3765         then do:
     3766           assign
     3767             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3768             no-error .
     3769           if error-status :error
     3770           or error-status :get-message(1) <> ""
     3771           then do:
     3772             undo move_block, retry move_block.
     3773           end.
     3774         end.
     3775         assign
     3776           frame Dialog-Frame :width = v-frame-width + p-change-value
     3777           no-error .
     3778         if error-status :error
     3779         or error-status :get-message(1) <> ""
     3780         then do:
     3781           undo move_block, retry move_block.
     3782         end.
     3783         assign
     3784           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3785         no-error .
     3786         if error-status :error
     3787         or error-status :get-message(1) <> ""
     3788         then do:
     3789           undo move_block, retry move_block.
     3790         end.
     3791         for each buf_temp-browse-handle
     3792           where buf_temp-browse-handle.browse-type = 'width':u
     3793         on error undo move_block, retry move_block
     3794         :
     3795           assign
     3796             buf_temp-browse-handle.browse-handle :width
     3797               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3798             no-error .
     3799           if error-status :error
     3800           or error-status :get-message(1) <> ""
     3801           then do:
     3802             undo move_block, retry move_block .
     3803           end.
     3804         end.
     3805         for each buf_temp-diasize-handle
     3806         on error undo move_block, retry move_block
     3807         :
     3808           assign
