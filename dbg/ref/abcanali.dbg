     3014   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3015   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3016   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3017   on help of frame Dialog-Frame
     3018   do:
     3019     run gbl/app_help.p
     3020       (input this-procedure :file-name
     3021       ,input ''
     3022       ,input ?
     3023       ) no-error.
     3024     if error-status :error then do:
     3025       message
     3026         "Ошибка при вызове помощи"
     3027         error-status :get-message(1)
     3028         view-as alert-box .
     3029     end.
     3030   end.
     3031   run minbtn-set in this-procedure .
     3032   on choose of b-help in frame Dialog-Frame
     3033   do:
     3034     apply "help":u to frame Dialog-Frame .
     3035   end.
     3036   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3037   procedure minbtn-set :
     3038       do
     3039           on error undo, return error return-value
     3040           :
     3041           define variable ii              as integer       no-undo .
     3042           define variable fh              as widget-handle no-undo .
     3043           define variable hh              as widget-handle no-undo .
     3044           define variable v-h             as handle        extent 4 no-undo .
     3045           define variable v-name-button   as character     no-undo .
     3046           define variable v-help-old-x    as decimal       no-undo .
     3047           define variable v-help-old-y    as decimal       no-undo .
     3048           define variable v-help-old-size as decimal       no-undo .
     3049           define variable v-frame-width   as decimal       no-undo .
     3050           define variable jj              as integer       no-undo .
     3051           do
     3052               on error undo, return error
     3053               :
     3054               assign
     3055                   v-frame-width = frame Dialog-Frame:width - 0.3
     3056                   fh            = frame Dialog-Frame:first-child
     3057                   hh            = fh:first-child
     3058                   ii            = 1
     3059                   .
     3060               do while valid-handle(hh):
     3061                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3062                   do:
     3063                       case lc(hh:name) :
     3064                           when "b-help" then
     3065                               do:
     3066                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3067                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3068                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3069                                   hh:TOOLTIP = "Помощь" .
     3070                                   v-help-old-x = hh:column .
     3071                                   v-help-old-y = hh:row    .
     3072                                   v-help-old-size = hh:width .
     3073                                   hh:width-chars = 2.5 .
     3074                               end.
     3075                           when "b-print" then
     3076                               do:
     3077                                   hh:load-image("cmp/b-print.bmp":u) .
     3078                                   hh:TOOLTIP = "Печать" .
     3079                                   v-h[ii] = hh:handle .
     3080                                   ii = ii + 1 .
     3081                                   hh:width-chars = 3 .
     3082                               end.
     3083                           when "b-history" or
     3084                           when "b-hist" then
     3085                               do:
     3086                                   hh:load-image("cmp/b-hist.bmp":u) .
     3087                                   hh:TOOLTIP = "История" .
     3088                                   v-h[ii] = hh:handle .
     3089                                   ii = ii + 1 .
     3090                                   hh:width-chars = 3 .
     3091                               end.
     3092                           when "b-sch" then
     3093                               do:
     3094                                   hh:load-image("cmp/b-sch.bmp":u) .
     3095                                   hh:TOOLTIP = "Установка Фильтра" .
     3096                                   v-h[ii] = hh:handle .
     3097                                   ii = ii + 1 .
     3098                                   hh:width-chars = 3 .
     3099                               end.
     3100                           when "b-hist-user" then
     3101                               do:
     3102                                   hh:load-image("cmp/b-hist.bmp":u) .
     3103                                   hh:TOOLTIP = "История пользователя" .
     3104                                   ii = ii + 1 .
     3105                               end.
     3106                       end case.
     3107                   end.
     3108                   hh = hh:next-sibling.
     3109               end.
     3110               b-help:column = v-frame-width - b-help:width-chars.
     3111               jj = 0.
     3112               repeat ii = 4 to 1 by -1 :
     3113                   if valid-handle (v-h[ii] ) then
     3114                   do:
     3115                       jj  = jj + 1 .
     3116                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3117                       v-h[ii]:row    = v-help-old-y .
     3118                   end.
     3119               end.
     3120           end.
     3121       end.
     3122   end procedure.
     3123   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3124   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3125   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3126   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3127   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3128   define variable v-diasize-current-frame-height as decimal   no-undo .
     3129   define variable v-diasize-change-size          as logical   no-undo .
     3130   define variable v-diasize-resize-button        as handle    no-undo .
     3131   define variable v-diasize-wndmax               as logical   no-undo .
     3132   define variable v-diasize-wndstore             as logical   no-undo .
     3133   define variable v-diasize-proc-name            as character no-undo .
     3134   define variable v-diasize-browse-handle        as handle    no-undo .
     3135   define variable v-diasize-browse-number        as integer   no-undo .
     3136   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3137   define temp-table temp-diasize-handle no-undo
     3138     field handle-value  as handle
     3139     field save-position as decimal
     3140     index xpk is primary unique handle-value
     3141     .
     3142   define temp-table temp-browse-handle no-undo
     3143     field browse-type   as character
     3144     field browse-number as integer
     3145     field browse-handle as handle
     3146     field original-size as decimal
     3147     index xpk is primary unique browse-type browse-number
     3148     index xie browse-type browse-handle
     3149   .
     3150   procedure diasize_change-height :
     3151     define input  parameter p-change-value  as decimal   no-undo .
     3152     define input  parameter p-move-resize   as logical   no-undo .
     3153     define variable v-field-group-handle    as handle    no-undo .
     3154     define variable v-object-handle         as handle    no-undo .
     3155     define variable v-frame-height          as decimal   no-undo .
     3156     define variable v-frame-virtual-height  as decimal   no-undo .
     3157     define variable v-browse-height         as decimal   no-undo .
     3158     define variable v-window-height         as decimal   no-undo .
     3159     define variable v-window-virtual-height as decimal   no-undo .
     3160     define variable v-change-sign           as integer   no-undo .
     3161     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3162     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3163     if p-change-value > 0
     3164     then do:
     3165       if frame Dialog-Frame :height + p-change-value
     3166           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3167       then do:
     3168         assign
     3169           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3170                           - (frame Dialog-Frame :height-chars)
     3171         .
     3172         if p-change-value <= 0
     3173         then do:
     3174           run diasize_position-resize-button in this-procedure .
     3175           return .
     3176         end.
     3177       end.
     3178     end.
     3179     if p-change-value < 0
     3180     then do:
     3181       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3182       then do:
     3183         assign
     3184           p-change-value = v-diasize-orig-frame-height
     3185                          - (frame Dialog-Frame :height-chars)
     3186         .
     3187         if p-change-value >= 0
     3188         then do:
     3189           run diasize_position-resize-button in this-procedure .
     3190           return .
     3191         end.
     3192       end.
     3193     end.
     3194     if p-change-value >= 0
     3195     then do:
     3196       assign
     3197         v-change-sign = 1
     3198       .
     3199     end.
     3200     else do:
     3201       assign
     3202         v-change-sign = -1
     3203       .
     3204     end.
     3205     assign
     3206       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3207     .
     3208     if p-change-value = 0
     3209     then do:
     3210       run diasize_position-resize-button in this-procedure .
     3211       return .
     3212     end.
     3213     move_block:
     3214     do
     3215     on error undo move_block, retry move_block
     3216     :
     3217       if retry
     3218       then do:
     3219         do
     3220         on error undo move_block, leave move_block
     3221         :
     3222           if p-change-value > 0
     3223           then do:
     3224             for each buf_temp-diasize-handle
     3225             on error undo, next
     3226             :
     3227               assign
     3228                 v-object-handle = buf_temp-diasize-handle.handle-value
     3229               .
     3230               if v-object-handle <> v-diasize-resize-button
     3231               then do:
     3232                 assign
     3233                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3234                 .
     3235               end.
     3236             end.
     3237             assign
     3238               v-diasize-browse-handle :height = v-browse-height
     3239             .
     3240             for each buf_temp-browse-handle
     3241               where buf_temp-browse-handle.browse-type = 'height':u
     3242             on error undo, next
     3243             :
     3244               assign
     3245                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3246               .
     3247             end.
     3248             assign
     3249               frame Dialog-Frame :height = v-frame-height
     3250             .
     3251             if frame Dialog-Frame :scrollable = true
     3252             then do:
     3253               assign
     3254                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3255               .
     3256             end.
     3257             run diasize_position-resize-button in this-procedure .
     3258           end.
     3259           else do:
     3260             if frame Dialog-Frame :scrollable = true
     3261             then do:
     3262               assign
     3263                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3264               .
     3265             end.
     3266             assign
     3267               frame Dialog-Frame :height = v-frame-height
     3268             .
     3269             assign
     3270               v-diasize-browse-handle :height = v-browse-height
     3271             .
     3272             for each buf_temp-browse-handle
     3273               where buf_temp-browse-handle.browse-type = 'height':u
     3274             on error undo, next
     3275             :
     3276               assign
     3277                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3278               .
     3279             end.
     3280             for each buf_temp-diasize-handle
     3281             on error undo, next
     3282             :
     3283               assign
     3284                 v-object-handle = buf_temp-diasize-handle.handle-value
     3285               .
     3286               if v-object-handle <> v-diasize-resize-button
     3287               then do:
     3288                 assign
     3289                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3290                 .
     3291               end.
     3292             end.
     3293             run diasize_position-resize-button in this-procedure .
     3294           end.
     3295           assign
     3296             v-diasize-change-size = false
     3297           .
     3298           leave move_block .
     3299         end.
     3300       end.
     3301       assign
     3302         v-diasize-need-full-display = true
     3303       .
     3304       if v-diasize-change-size = false
     3305       then do:
     3306         assign
     3307           v-diasize-change-size = true
     3308         .
     3309       end.
     3310       else do:
     3311         return .
     3312       end.
     3313       assign
     3314         v-frame-height = frame Dialog-Frame :height
     3315         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3316         v-browse-height = v-diasize-browse-handle :height
     3317       .
     3318       for each buf_temp-browse-handle
     3319         where buf_temp-browse-handle.browse-type = 'height':u
     3320       :
     3321         assign
     3322           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3323         .
     3324       end.
     3325       for each buf_temp-diasize-handle
     3326       :
     3327         delete buf_temp-diasize-handle .
     3328       end.
     3329       assign
     3330         v-field-group-handle = frame Dialog-Frame :first-child
     3331       .
     3332       do while valid-handle(v-field-group-handle)
     3333       :
     3334         assign
     3335           v-object-handle = v-field-group-handle :first-child
     3336         .
     3337         do while valid-handle(v-object-handle)
     3338         :
     3339           if  v-object-handle <> v-diasize-browse-handle :handle
     3340           and can-query(v-object-handle, "row")
     3341           and can-query(v-object-handle, "height")
     3342           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3343           then do:
     3344             find first buf_temp-browse-handle
     3345               where buf_temp-browse-handle.browse-type   = 'height':u
     3346                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3347               no-error .
     3348             if available buf_temp-browse-handle
     3349             then do:
     3350             end.
     3351             else do:
     3352               create buf_temp-diasize-handle .
     3353               assign
     3354                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3355                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3356               .
     3357             end.
     3358           end.
     3359           assign
     3360             v-object-handle = v-object-handle :next-sibling
     3361           .
     3362         end.
     3363         assign
     3364           v-field-group-handle = v-field-group-handle :next-sibling
     3365         .
     3366       end.
     3367       do with frame Dialog-Frame
     3368       :
     3369         hide v-diasize-resize-button .
     3370         assign
     3371           v-diasize-resize-button :row    = 1
     3372           v-diasize-resize-button :column = 1
     3373         .
     3374       end.
     3375       if p-change-value > 0
     3376       then do:
     3377         if frame Dialog-Frame :scrollable = true
     3378         then do:
     3379           assign
     3380             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3381             no-error .
     3382           if error-status :error
     3383           or error-status :get-message(1) <> ""
     3384           then do:
     3385             undo move_block, retry move_block .
     3386           end.
     3387         end.
     3388         assign
     3389           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3390           no-error .
     3391         if error-status :error
     3392         or error-status :get-message(1) <> ""
     3393         then do:
     3394           undo move_block, retry move_block .
     3395         end.
     3396         assign
     3397           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3398           no-error .
     3399         if error-status :error
     3400         or error-status :get-message(1) <> ""
     3401         then do:
     3402           undo move_block, retry move_block .
     3403         end.
     3404         for each buf_temp-browse-handle
     3405           where buf_temp-browse-handle.browse-type = 'height':u
     3406         on error undo move_block, retry move_block
     3407         :
     3408           assign
     3409             buf_temp-browse-handle.browse-handle :height
     3410               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3411             no-error .
     3412           if error-status :error
     3413           or error-status :get-message(1) <> ""
     3414           then do:
     3415             undo move_block, retry move_block .
     3416           end.
     3417         end.
     3418         for each buf_temp-diasize-handle
     3419         on error undo move_block, retry move_block
     3420         :
     3421           assign
     3422             v-object-handle = buf_temp-diasize-handle.handle-value
     3423           .
     3424           if v-object-handle <> v-diasize-resize-button
     3425           then do:
     3426             assign
     3427               v-object-handle :row = v-object-handle :row + p-change-value
     3428               no-error .
     3429             if error-status :error
     3430             or error-status :get-message(1) <> ""
     3431             then do:
     3432               undo move_block, retry move_block .
     3433             end.
     3434           end.
     3435         end.
     3436       end.
     3437       else do:
     3438         for each buf_temp-diasize-handle
     3439         on error undo move_block, retry move_block
     3440         :
     3441           assign
     3442             v-object-handle = buf_temp-diasize-handle.handle-value
     3443           .
     3444           if v-object-handle <> v-diasize-resize-button
     3445           then do:
     3446             assign
     3447               v-object-handle :row = v-object-handle :row + p-change-value
     3448               no-error .
     3449             if error-status :error
     3450             or error-status :get-message(1) <> ""
     3451             then do:
     3452               undo move_block, retry move_block .
     3453             end.
     3454           end.
     3455         end.
     3456         assign
     3457           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3458           no-error .
     3459         if error-status :error
     3460         or error-status :get-message(1) <> ""
     3461         then do:
     3462           undo move_block, retry move_block .
     3463         end.
     3464         for each buf_temp-browse-handle
     3465           where buf_temp-browse-handle.browse-type = 'height':u
     3466         on error undo move_block, retry move_block
     3467         :
     3468           assign
     3469             buf_temp-browse-handle.browse-handle :height
     3470               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3471             no-error .
     3472           if error-status :error
     3473           or error-status :get-message(1) <> ""
     3474           then do:
     3475             undo move_block, retry move_block .
     3476           end.
     3477         end.
     3478         assign
     3479           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3480           no-error .
