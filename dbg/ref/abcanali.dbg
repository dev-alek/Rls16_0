     3483         then do:
     3484           undo move_block, retry move_block .
     3485         end.
     3486         if frame Dialog-Frame :scrollable = true
     3487         then do:
     3488           assign
     3489             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3490             no-error .
     3491           if error-status :error
     3492           or error-status :get-message(1) <> ""
     3493           then do:
     3494             undo move_block, retry move_block .
     3495           end.
     3496         end.
     3497       end.
     3498       if p-move-resize = true
     3499       then do:
     3500         run diasize_position-resize-button in this-procedure .
     3501       end.
     3502       if v-diasize-wndstore = true
     3503       then do:
     3504         if connected("ub") = true
     3505         then do:
     3506           define variable v-cntxt-db-num        as integer   no-undo .
     3507           define variable v-cntxt-userid        as character no-undo .
     3508           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3509                                             , OUTPUT v-cntxt-userid
     3510                                             ) .
