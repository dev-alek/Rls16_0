     2965             temp-rez.ABC:fgcolor in browse BROWSE-rez = 12 .
     2966             temp-rez.Sum-cr:fgcolor in browse BROWSE-rez = 12 .
     2967             temp-rez.Sum_prc:fgcolor in browse BROWSE-rez = 12 .
     2968             temp-rez.qnty:fgcolor in browse BROWSE-rez = 12 .
     2969             temp-rez.qnty_prc:fgcolor in browse BROWSE-rez = 12 .
     2970         END.
     2971         IF  temp-rez.ABC = "B" THEN DO:
     2972             temp-rez.ABC:fgcolor      in browse BROWSE-rez = 9 .
     2973             temp-rez.Sum-cr:fgcolor     in browse BROWSE-rez = 9 .
     2974             temp-rez.Sum_prc:fgcolor  in browse BROWSE-rez = 9 .
     2975             temp-rez.qnty:fgcolor     in browse BROWSE-rez = 9 .
     2976             temp-rez.qnty_prc:fgcolor in browse BROWSE-rez = 9 .
