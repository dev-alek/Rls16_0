     1043   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1044   function func-get-name-from-ext-type   returns char
     1045     ( p-ext-type as character   ,
     1046       p-caps     as logical ).
     1047   define variable v-ext-name as character no-undo .
     1048   run get-name-from-ext-type in this-procedure (
     1049       input p-ext-type  ,
     1050       input p-caps  ,
     1051       output v-ext-name )
     1052       no-error .
     1053       if error-status :error then do:
     1054          assign
     1055            v-ext-name = p-ext-type
     1056          .
     1057       end.
     1058    return (v-ext-name) .
     1059   end.
     1060   procedure get-name-from-ext-type :
     1061    do
     1062    on error undo, return error return-value
     1063    :
     1064   define input  parameter p-ext-type as character no-undo .
     1065   define input  parameter p-caps     as logical no-undo   .
     1066   define output parameter p-ext-name as character no-undo .
     1067   define variable v-num as integer no-undo .
     1068     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     1069       message
     1070         vss-include-info10 skip
     1071         "Неправильно задано значение входящего параметра! "
     1072         "Нет такого типа документов " p-ext-type
     1073         view-as alert-box error .
     1074         undo, return error .
     1075     end.
     1076     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     1077     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     1078     if p-caps  = true then do :
     1079        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     1080     end .
     1081     end.
     1082   end procedure.
     1083   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
