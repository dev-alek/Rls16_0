     2978         IF  temp-rez.ABC = "D" THEN DO:
     2979             temp-rez.ABC:fgcolor      in browse BROWSE-rez = 3 .
     2980             temp-rez.Sum-cr:fgcolor   in browse BROWSE-rez = 3 .
     2981             temp-rez.Sum_prc:fgcolor  in browse BROWSE-rez = 3 .
     2982             temp-rez.qnty:fgcolor     in browse BROWSE-rez = 3 .
     2983             temp-rez.qnty_prc:fgcolor in browse BROWSE-rez = 3 .
