     1906   on error undo, return error return-value
     1907   :
     1908       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_tooltip in g#attr-lib
     1909       (input  p-upper-code
     1910       ,input  p-code
     1911       ,output p-tooltip
     1912       ,output p-label
     1913       ,output p-tooltip-code
     1914       ) no-error .
     1915     if error-status :error
     1916     then do:
     1917       undo, return error return-value .
     1918     end.
     1919   end.
     1920   end procedure.
     1921   procedure thbjattr_legacy :
