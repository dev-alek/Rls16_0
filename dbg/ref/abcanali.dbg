     3923   end procedure.
     3924   procedure diasize_position-resize-button :
     3925     do with frame Dialog-Frame
     3926     :
     3927       hide v-diasize-resize-button .
     3928       assign
     3929         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3930                     - 1
     3931                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3932         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3933                     - 1
     3934                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3935       .
     3936       view v-diasize-resize-button .
     3937     end.
     3938   end procedure.
     3939   on alt-right anywhere
     3940   do:
     3941     run diasize_change-width in this-procedure
     3942       (input 1
     3943       ,input true
     3944       ) .
     3945     return no-apply .
     3946   end.
     3947   on alt-left anywhere
     3948   do:
     3949     run diasize_change-width in this-procedure
     3950       (input -1
     3951       ,input true
     3952       ) .
     3953     return no-apply .
     3954   end.
     3955   on alt-down anywhere
     3956   do:
     3957     run diasize_change-height in this-procedure
     3958       (input 1
     3959       ,input true
     3960       ) .
     3961     return no-apply .
     3962   end.
     3963   on alt-up anywhere
     3964   do:
     3965     run diasize_change-height in this-procedure
     3966       (input -1
     3967       ,input true
     3968       ) .
     3969     return no-apply .
     3970   end.
     3971   on alt-enter of frame Dialog-Frame
     3972   do:
     3973     run diasize_maximize in this-procedure
     3974       (input  ?
     3975       ).
     3976     return no-apply .
     3977   end.
     3978   procedure diasize_end-move :
     3979     do
     3980     on error undo, return error return-value
     3981     :
     3982       define variable v-row-delta as decimal   no-undo .
     3983       define variable v-col-delta as decimal   no-undo .
     3984       define variable v-new-row as decimal   no-undo .
     3985       define variable v-new-col as decimal   no-undo .
     3986       assign
     3987         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3988         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3989       .
     3990       assign
     3991         v-row-delta = v-new-row - frame Dialog-Frame :height
     3992         v-col-delta = v-new-col - frame Dialog-Frame :width
     3993       .
     3994       run diasize_change-height in this-procedure
     3995         (input v-row-delta
     3996         ,input true
     3997         ) .
     3998       run diasize_change-width in this-procedure
     3999         (input v-col-delta
     4000         ,input true
     4001         ) .
     4002     end.
     4003   end procedure.
     4004   procedure diasize_maximize :
     4005     define input  parameter p-action as logical   no-undo .
     4006     do
     4007     on error undo, return error return-value
     4008     :
     4009       if p-action = ?
     4010       then do:
     4011         if v-diasize-need-maximize = true
     4012         then do:
     4013           assign
     4014             p-action = true
     4015           .
     4016         end.
     4017         else do:
     4018           assign
     4019             p-action = false
     4020           .
     4021         end.
     4022       end.
     4023       if p-action = true
     4024       then do:
     4025         run diasize_change-height in this-procedure
     4026           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4027               - frame Dialog-Frame :height-chars
     4028           ,input true
     4029           ) .
     4030         run diasize_change-width in this-procedure
     4031           (input session :width-chars
     4032               - frame Dialog-Frame :width-chars
     4033           ,input true
     4034           ) .
     4035         assign
     4036           v-diasize-need-maximize = false
     4037         .
     4038       end.
     4039       else do:
     4040         run diasize_change-width in this-procedure
     4041           (input v-diasize-orig-frame-width
     4042               - frame Dialog-Frame :width-chars
     4043           ,input true
     4044           ) .
     4045         run diasize_change-height in this-procedure
     4046           (input v-diasize-orig-frame-height
     4047               - frame Dialog-Frame :height-chars
     4048           ,input true
     4049           ) .
     4050         assign
     4051           v-diasize-need-maximize = true
     4052         .
     4053       end.
     4054     end.
     4055   end procedure.
     4056   procedure diasize_restore-orig-size :
     4057     do
     4058     on error undo, return error return-value
     4059     :
     4060       assign
     4061         v-diasize-current-frame-width  = frame Dialog-Frame :width
     4062         v-diasize-current-frame-height = frame Dialog-Frame :height
     4063       .
     4064       run diasize_set-height in this-procedure
     4065         (input  v-diasize-orig-frame-height
     4066         ,input  true
     4067         ) .
     4068       run diasize_set-width in this-procedure
     4069         (input  v-diasize-orig-frame-width
     4070         ,input  true
     4071         ) .
     4072     end.
     4073   end procedure.
     4074   procedure diasize_restore-current-size :
     4075     do
     4076     on error undo, return error return-value
     4077     :
     4078       run diasize_set-height in this-procedure
     4079         (input  v-diasize-current-frame-height
     4080         ,input  true
     4081         ) .
     4082       run diasize_set-width in this-procedure
     4083         (input  v-diasize-current-frame-width
     4084         ,input  true
     4085         ) .
     4086     end.
     4087   end procedure.
     4088   procedure diasize_set-browse-handle :
     4089     define input  parameter p-browse-handle as handle   no-undo .
     4090     define buffer buf_temp-browse-handle for temp-browse-handle .
     4091     do
     4092     on error undo, return error return-value
     4093     :
     4094       assign
     4095         v-diasize-browse-handle = p-browse-handle
     4096       .
     4097       for each buf_temp-browse-handle
     4098       on error undo, return error return-value
     4099       :
     4100         delete buf_temp-browse-handle .
     4101       end.
     4102     end.
     4103   end procedure.
     4104   procedure diasize_add_browse :
     4105     define input  parameter p-browse-type   as character no-undo .
     4106     define input  parameter p-browse-handle as handle    no-undo .
     4107     define buffer buf_temp-browse-handle for temp-browse-handle .
     4108     do
     4109     on error undo, return error return-value
     4110     :
     4111       assign
     4112         v-diasize-browse-number = v-diasize-browse-number + 1
     4113       .
     4114       create buf_temp-browse-handle .
     4115       assign
     4116         buf_temp-browse-handle.browse-type   = p-browse-type
     4117         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4118         buf_temp-browse-handle.browse-handle = p-browse-handle
     4119       .
     4120     end.
     4121   end procedure.
     4122   procedure diasize_init :
     4123     define variable v-default-value    as logical   no-undo .
     4124     define variable v-restore-saved    as logical   no-undo .
     4125     define variable v-resize-value-str as character no-undo .
     4126     do
     4127     on error undo, return error return-value
     4128     :
     4129       do with frame Dialog-Frame
     4130       :
     4131         assign
     4132           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4133           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4134           v-diasize-browse-handle     = browse BROWSE-obj :handle
     4135         .
     4136         create button v-diasize-resize-button
     4137         assign
     4138           parent        = frame Dialog-Frame :first-child
     4139           label         = "s"
     4140           height-pixels = 16
     4141           width-pixels  = 16
     4142           visible       = true
     4143           sensitive     = true
     4144           movable       = true
     4145           triggers:
     4146             on end-move persistent run diasize_end-move in this-procedure .
     4147           end triggers.
     4148         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4149         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4150         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4151         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4152         assign
     4153           v-diasize-wndmax = false
     4154         .
     4155         if connected("ub") = true
     4156         then do:
     4157           define variable v-cntxt-db-num        as integer   no-undo .
     4158           define variable v-cntxt-userid        as character no-undo .
     4159           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4160                                             , OUTPUT v-cntxt-userid
     4161                                             ) .
     4162           run gbl/wndpar_r.p
     4163             (input  v-cntxt-db-num
     4164             ,input  v-cntxt-userid
     4165             ,input  'wndmax':U
     4166             ,output v-diasize-wndmax
     4167             ,output v-default-value
     4168             ) .
     4169         end.
     4170         assign
     4171           v-diasize-wndstore = false
     4172         .
     4173         if connected("ub") = true
     4174         then do:
     4175           run gbl/wndpar_r.p
     4176             (input  v-cntxt-db-num
     4177             ,input  v-cntxt-userid
     4178             ,input  'wndstore':U
     4179             ,output v-diasize-wndstore
     4180             ,output v-default-value
     4181             ) .
     4182         end.
     4183         assign
     4184           v-diasize-proc-name = entry(1, program-name(2), '.')
     4185         .
     4186         if v-diasize-wndstore = true
     4187         then do:
     4188           assign
     4189             v-restore-saved = false
     4190           .
     4191           if connected("ub") = true
     4192           then do:
     4193             run gbl/wndsizer.p
     4194               (input  v-cntxt-db-num
     4195               ,input  v-cntxt-userid
     4196               ,input  v-diasize-proc-name
     4197               ,input  'height':u
     4198               ,output v-resize-value-str
     4199               ) .
     4200             if v-resize-value-str <> '':U
     4201             then do:
     4202               run diasize_change-height in this-procedure
     4203                 (input  integer(v-resize-value-str)
     4204                 ,input  true
     4205                 ) .
     4206               assign
     4207                 v-restore-saved = true
     4208               .
     4209             end.
     4210           end.
     4211           if connected("ub") = true
     4212           then do:
     4213             run gbl/wndsizer.p
     4214               (input  v-cntxt-db-num
     4215               ,input  v-cntxt-userid
     4216               ,input  v-diasize-proc-name
     4217               ,input  'width':u
     4218               ,output v-resize-value-str
     4219               ) .
     4220             if v-resize-value-str <> '':U
     4221             then do:
     4222               run diasize_change-width in this-procedure
     4223                 (input  integer(v-resize-value-str)
     4224                 ,input  true
     4225                 ) .
     4226               assign
     4227                 v-restore-saved = true
     4228               .
     4229             end.
     4230           end.
     4231           if v-restore-saved <> true
     4232           then do:
     4233             if v-diasize-wndmax = true
     4234             then do:
     4235               run diasize_maximize in this-procedure
     4236                 (input  true
     4237                 ) .
     4238             end.
     4239           end.
     4240         end.
     4241         else do:
     4242           if v-diasize-wndmax = true
     4243           then do:
     4244             run diasize_maximize in this-procedure
     4245               (input  true
     4246               ) .
     4247           end.
     4248         end.
     4249       end.
     4250     end.
     4251   end procedure.
     4252   procedure diasize_need-full-display :
     4253     define output parameter p-need-full-display as logical   no-undo .
     4254     do
     4255     on error undo, return error return-value
     4256     :
     4257       assign
     4258         p-need-full-display = v-diasize-need-full-display
     4259       .
     4260       assign
     4261         v-diasize-need-full-display = false
     4262       .
     4263     end.
     4264   end procedure.
     4265   procedure get-context :
     4266      define output parameter p-db-num as integer          no-undo.
     4267      define output parameter p-user-id as character        no-undo.
     4268      define variable v-login               as character    no-undo.
     4269      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4270      define buffer buf_user-login  for ub.user-login .
     4271      do
     4272      on error undo, return error
     4273      :
     4274            FIND FIRST buf_sys-ctrl no-lock.
     4275            ASSIGN
     4276               v-login = USERID("ub")
     4277               p-db-num = buf_sys-ctrl.db-num
     4278            .
     4279            FIND FIRST buf_user-login
     4280                 WHERE buf_user-login.db-num = p-db-num
     4281                   AND buf_user-login.user-login = v-login
     4282                 no-lock
     4283                 no-error
     4284                 .
     4285            IF AVAILABLE buf_user-login
     4286            THEN DO:
     4287               assign
     4288                  p-user-id = buf_user-login.user-id
     4289               .
     4290            END.
     4291      end.
     4292   end procedure.
     4293       run diasize_init in this-procedure .
     4294   MAIN-BLOCK:
     4295   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4296      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4297   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4298     run mainmenu_getcntxt in parparentproc
     4299       (output v-cntxt-db-num
     4300       ,output v-cntxt-userid
     4301       ,output v-cntxt-level
     4302       ,output v-cntxt-host-code-obj
     4303       ,output v-cntxt-obj-type
     4304       ,output v-cntxt-obj-code
     4305       ,output v-cntxt-db-num-obj
     4306       ,output v-cntxt-is-admin
     4307       ) .
     4308   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4309   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     4310     (output v-db-num
     4311     )  .
     4312   define variable loc#log as logical   no-undo .
     4313   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4314   do:
     4315     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4316       (input  v-cntxt-db-num
     4317       ,input  v-cntxt-userid
     4318       ,input  0
     4319       ,input  'actn_ABC-XYZ_lookup':U
     4320       ,input  'global':U
     4321       ,input  0
     4322       ,input  '':U
     4323       ,input  0
     4324       ,input  0
     4325       ,input  0
     4326       ,input  0
     4327       ,input  true
     4328       ,output loc#log
     4329       )  .
     4330   end.
     4331      if not loc#log then return .
     4332     for each x-abc-analysis:
     4333       delete x-abc-analysis.
     4334     end.
     4335   define variable  v-value-date    as date   no-undo .
     4336   define variable  v-value-decimal as decimal   no-undo .
     4337   define variable  v-value-integer as integer   no-undo .
     4338   define variable  v-value-logical as logical   no-undo .
     4339   define variable v-found as logical   no-undo .
     4340   run thbjattr_value in this-procedure  (
     4341     input   "",
     4342     input   0 ,
     4343     input   'abc-global':U ,
     4344     input   'abc-type'  ,
     4345     output  par-abc-type ,
     4346     output  v-value-date      ,
     4347     output  v-value-decimal   ,
     4348     output  v-value-integer   ,
     4349     output  v-value-logical   ,
     4350     output  par-type            ,
     4351     output  v-found
     4352     ) no-error
     4353     .
     4354     if error-status :error or v-found = false then do:
     4355         message "Нет настроек Ассортиментной политики !!!." view-as alert-box information .
     4356         return error return-value .
     4357     end.
     4358   run thbjattr_value in this-procedure  (
     4359     input   "",
     4360     input   0 ,
     4361     input   'abc-global':U ,
     4362     input   'abc-mode'  ,
     4363     output  par-abc-mode ,
     4364     output  v-value-date      ,
     4365     output  v-value-decimal   ,
     4366     output  v-value-integer   ,
     4367     output  v-value-logical   ,
     4368     output  par-type            ,
     4369     output  v-found
     4370     ) no-error
     4371     .
     4372     if error-status :error or v-found = false then do:
     4373         message "Нет настроек Ассортиментной политики !!!." view-as alert-box information .
     4374         return error return-value .
     4375     end.
     4376   run thbjattr_value in this-procedure  (
     4377     input   "",
     4378     input   0 ,
     4379     input   'abc-global':U ,
     4380     input   'abc-one'  ,
     4381     output  par-abc-one ,
     4382     output  v-value-date      ,
     4383     output  v-value-decimal   ,
     4384     output  v-value-integer   ,
     4385     output  v-value-logical   ,
     4386     output  par-type            ,
     4387     output  v-found
     4388     ) no-error
     4389     .
     4390     if error-status :error or v-found = false then do:
     4391         message "Нет настроек Ассортиментной политики !!!." view-as alert-box information .
     4392         return error return-value .
     4393     end.
     4394   run thbjattr_value in this-procedure  (
     4395     input   "",
     4396     input   0 ,
     4397     input   'abc-global':U ,
     4398     input   'abc-two'  ,
     4399     output  par-abc-two ,
     4400     output  v-value-date      ,
     4401     output  v-value-decimal   ,
     4402     output  v-value-integer   ,
     4403     output  v-value-logical   ,
     4404     output  par-type            ,
     4405     output  v-found
     4406     ) no-error
     4407     .
     4408     if error-status :error or v-found = false then do:
     4409         message "Нет настроек Ассортиментной политики !!!." view-as alert-box information .
     4410         return error return-value .
     4411     end.
     4412     if p-mode = 'ИЗМЕНЕНИЕ':U
     4413     or p-mode = 'ПРОСМОТР':U then do:
     4414       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     4415         find first locked_abc-analysis  no-lock  where
     4416                     recid(locked_abc-analysis) = p-doc-rec no-wait no-error.
     4417         if locked locked_abc-analysis then do:
     4418           message
     4419           vss-workfile vss-revision vss-description skip
     4420            "Запись АBC анализа занята"
     4421           view-as alert-box error .
     4422           undo, return error.
     4423         end.
     4424       end.
     4425       else do:
     4426         find first locked_abc-analysis no-lock where
     4427                          recid(locked_abc-analysis) = p-doc-rec no-error .
     4428         if not avail locked_abc-analysis then do:
     4429           find first locked_abc-analysis no-lock where
     4430                      locked_abc-analysis.db-num = p-db-num and
     4431                      locked_abc-analysis.abc-id = p-id
     4432                      no-error .
     4433         end.
     4434       end.
     4435       if not available locked_abc-analysis then do:
     4436         message
     4437         vss-workfile vss-revision vss-description skip
     4438         "Не найдена запись АBC анализа"
     4439         view-as alert-box error .
     4440         undo, return error.
     4441       end.
     4442       create x-abc-analysis.
     4443       buffer-copy locked_abc-analysis to x-abc-analysis.
     4444      end.
     4445      else do:
     4446             run cur-time in this-procedure(output v-date, output v-time).
     4447             create x-abc-analysis.
     4448             assign
     4449             x-abc-analysis.abc-id = v-last-code + 1
     4450             x-abc-analysis.db-num = v-db-num
     4451             x-abc-analysis.cral-id = 1
     4452             x-abc-analysis.abc-date-create = v-date
     4453             x-abc-analysis.abc-time-create = v-time
     4454             x-abc-analysis.abc-db-num-create = v-db-num
     4455             x-abc-analysis.abc-who-create  = g#userid
     4456            .
     4457      if par-abc-mode = "bimodal":U then do:
     4458         x-abc-analysis.abc-type = "2" .
     4459         if num-entries(par-abc-two,";") <> 3 then do:
     4460            message "Неверно задан конфигурационный параметр abc-two" view-as alert-box error .
     4461            return error return-value .
     4462         end.
     4463         else do:
     4464            x-abc-analysis.double-line-proc = decimal(entry(1 ,entry(1 , par-abc-two ,";" ),"/" )) .
     4465            x-abc-analysis.LE-proc          = decimal(entry(3 , par-abc-two,";" ))  .
     4466            v-abc-one                       =  entry(2 , par-abc-two,";" )  .
     4467         case par-abc-type :
     4468           when 'ABC' then do:
     4469              if num-entries (v-abc-one ,"/") < 2 then do:
     4470                 message "Неверно задан конфигурационный параметр abc-two , задайте не менее двух уровней процентов через запятую < 100 " view-as alert-box error .
     4471                 return error return-value .
     4472              end.
     4473              x-abc-analysis.abc-a = decimal( entry ( 1 , v-abc-one ,"/" )) .
     4474              x-abc-analysis.abc-b = decimal(  entry ( 2 , v-abc-one,"/" )) .
     4475              x-abc-analysis.abc-c = 100 .
     4476           end.
     4477           when 'ABCD' then do:
     4478              if num-entries (v-abc-one ,"/") < 3 then do:
     4479                 message "Неверно задан конфигурационный параметр abc-two , задайте не менее трех уровней процентов через запятую < 100 " view-as alert-box error .
     4480                 return error return-value .
     4481              end.
     4482              x-abc-analysis.abc-a = decimal( entry ( 1 , v-abc-one ,"/" )) .
     4483              x-abc-analysis.abc-b = decimal(  entry ( 2 , v-abc-one,"/" )) .
     4484              x-abc-analysis.abc-c = decimal(  entry ( 3 , v-abc-one,"/" )) .
     4485              x-abc-analysis.abc-d = 100 .
     4486           end.
     4487           when 'ABCDE' then do:
     4488              if num-entries (v-abc-one ,"/") < 4 then do:
     4489                 message "Неверно задан конфигурационный параметр abc-two , задайте не менее четырех уровней процентов через запятую < 100 " view-as alert-box error .
     4490                 return error return-value .
     4491              end.
     4492              x-abc-analysis.abc-a = decimal(  entry ( 1 , v-abc-one,"/" )) .
     4493              x-abc-analysis.abc-b = decimal(  entry ( 2 , v-abc-one,"/" )) .
     4494              x-abc-analysis.abc-c = decimal(  entry ( 3 , v-abc-one,"/" )) .
     4495              x-abc-analysis.abc-d = decimal(  entry ( 4 , v-abc-one,"/" )) .
     4496              x-abc-analysis.abc-E = 100 .
     4497           end.
     4498           when 'ABCDEF' then do:
     4499              if num-entries (v-abc-one ,"/") < 5 then do:
     4500                 message "Неверно задан конфигурационный параметр abc-two , задайте не менее пяти уровней процентов через запятую < 100 " view-as alert-box error .
     4501                 return error return-value .
     4502              end.
     4503              x-abc-analysis.abc-a = decimal(  entry ( 1 , v-abc-one,"/" )) .
     4504              x-abc-analysis.abc-b = decimal(  entry ( 2 , v-abc-one,"/" )) .
     4505              x-abc-analysis.abc-c = decimal(  entry ( 3 , v-abc-one,"/" )) .
     4506              x-abc-analysis.abc-d = decimal(  entry ( 4 , v-abc-one,"/" )) .
     4507              x-abc-analysis.abc-E = decimal(  entry ( 5 , v-abc-one,"/" )) .
     4508              x-abc-analysis.abc-f = 100 .
     4509           end.
     4510         end case.
     4511         end.
     4512      end.
     4513      else do:
     4514         x-abc-analysis.abc-type = "1" .
     4515         case par-abc-type :
     4516           when 'ABC' then do:
     4517              if num-entries (par-abc-one,"/") < 2 then do:
     4518                 message "Неверно задан конфигурационный параметр abc-one , задайте не менее двух уровней процентов через запятую < 100 " view-as alert-box error .
     4519                 return error return-value .
     4520              end.
     4521              x-abc-analysis.abc-a = decimal( entry ( 1 , par-abc-one ,"/" )) .
     4522              x-abc-analysis.abc-b = decimal(  entry ( 2 , par-abc-one,"/" )) .
     4523              x-abc-analysis.abc-c = 100 .
     4524           end.
     4525           when 'ABCD' then do:
     4526              if num-entries (par-abc-one,"/") < 3 then do:
     4527                 message "Неверно задан конфигурационный параметр abc-one , задайте не менее трех уровней процентов через запятую < 100 " view-as alert-box error .
     4528                 return error return-value .
     4529              end.
     4530              x-abc-analysis.abc-a = decimal( entry ( 1 , par-abc-one ,"/" )) .
     4531              x-abc-analysis.abc-b = decimal(  entry ( 2 , par-abc-one,"/" )) .
     4532              x-abc-analysis.abc-c = decimal(  entry ( 3 , par-abc-one,"/" )) .
     4533              x-abc-analysis.abc-d = 100 .
     4534           end.
     4535           when 'ABCDE' then do:
     4536              if num-entries (par-abc-one,"/") < 4 then do:
     4537                  message "Неверно задан конфигурационный параметр abc-one , задайте не менее четырех уровней процентов через запятую < 100 " view-as alert-box error .
     4538                 return error return-value .
     4539              end.
     4540              x-abc-analysis.abc-a = decimal(  entry ( 1 , par-abc-one,"/" )) .
     4541              x-abc-analysis.abc-b = decimal(  entry ( 2 , par-abc-one,"/" )) .
     4542              x-abc-analysis.abc-c = decimal(  entry ( 3 , par-abc-one,"/" )) .
     4543              x-abc-analysis.abc-d = decimal(  entry ( 4 , par-abc-one,"/" )) .
     4544              x-abc-analysis.abc-E = 100 .
     4545           end.
     4546           when 'ABCDEF' then do:
     4547              if num-entries (par-abc-one,"/") < 5 then do:
     4548                message "Неверно задан конфигурационный параметр abc-one , задайте не менее пяти уровней процентов через запятую < 100 " view-as alert-box error .
     4549                 return error return-value .
     4550              end.
     4551              x-abc-analysis.abc-a = decimal(  entry ( 1 , par-abc-one ,"/" )) .
     4552              x-abc-analysis.abc-b = decimal(  entry ( 2 , par-abc-one ,"/" )) .
     4553              x-abc-analysis.abc-c = decimal(  entry ( 3 , par-abc-one ,"/" )) .
     4554              x-abc-analysis.abc-d = decimal(  entry ( 4 , par-abc-one ,"/" )) .
     4555              x-abc-analysis.abc-E = decimal(  entry ( 5 , par-abc-one ,"/" )) .
     4556              x-abc-analysis.abc-f = 100 .
     4557           end.
     4558         end case.
     4559      end.
     4560      end.
     4561      run my_enable in this-procedure .
     4562          find first x-criterion-analysis no-lock where x-criterion-analysis.cral-id = x-abc-analysis.cral-id no-error .
     4563          if available x-criterion-analysis then
     4564              display x-criterion-analysis.cral-name with frame dialog-frame.
     4565     hide b-save-doc-typd  b-save-rang in frame Dialog-Frame .
     4566     wait-for go of frame Dialog-Frame focus x-abc-analysis.abc-name.
     4567   end.
     4568   run disable_ui in this-procedure .
     4569   PROCEDURE disable_UI :
     4570     HIDE FRAME Dialog-Frame.
     4571   END PROCEDURE.
     4572   PROCEDURE enable_UI :
     4573     DISPLAY FILL-IN-11 FILL-IN-1 FILL-IN-2 FILL-IN-4 FILL-IN-6 FILL-IN-3 FILL-IN-5
     4574             FILL-rez F-time FILL-IN-7
     4575         WITH FRAME Dialog-Frame.
     4576     IF AVAILABLE x-abc-analysis THEN
     4577       DISPLAY x-abc-analysis.double-line-proc x-abc-analysis.abc-type
     4578             x-abc-analysis.LE-proc x-abc-analysis.r-goods x-abc-analysis.abc-name
     4579             x-abc-analysis.abc-a x-abc-analysis.abc-b x-abc-analysis.abc-c
     4580             x-abc-analysis.abc-d x-abc-analysis.abc-e x-abc-analysis.abc-des
     4581             x-abc-analysis.abc-id x-abc-analysis.cral-id
     4582             x-abc-analysis.abc-who-create x-abc-analysis.abc-date-create
     4583             x-abc-analysis.abc-db-num-create
     4584         WITH FRAME Dialog-Frame.
     4585     IF AVAILABLE x-criterion-analysis THEN
     4586       DISPLAY x-criterion-analysis.cral-name
     4587         WITH FRAME Dialog-Frame.
     4588     ENABLE BROWSE-rez x-abc-analysis.double-line-proc x-abc-analysis.abc-type
     4589            FILL-IN-11 x-abc-analysis.LE-proc x-abc-analysis.r-goods B-gds-list
     4590            b-quit B-exit B-save-rang B-save-doc-typd B-rez B-Help
     4591            x-abc-analysis.abc-name B-crt B-add-obj B-del-obj B-add-period
     4592            B-del-period B-add-doc B-del-doc BROWSE-obj BROWSE-period
     4593            BROWSE-type-doc x-abc-analysis.abc-a x-abc-analysis.abc-b
     4594            x-abc-analysis.abc-c x-abc-analysis.abc-d x-abc-analysis.abc-e
     4595            x-abc-analysis.abc-des x-abc-analysis.abc-id x-abc-analysis.cral-id
     4596            x-criterion-analysis.cral-name FILL-IN-1 FILL-IN-2 FILL-IN-4 FILL-IN-6
     4597            FILL-IN-3 FILL-IN-5 FILL-rez x-abc-analysis.abc-who-create
     4598            x-abc-analysis.abc-date-create F-time x-abc-analysis.abc-db-num-create
     4599            FILL-IN-7 RECT-f RECT-E RECT-D RECT-C RECT-B RECT-A
     4600         WITH FRAME Dialog-Frame.
     4601     VIEW FRAME Dialog-Frame.
     4602     OPEN QUERY BROWSE-obj FOR EACH x-abc-analysis-obj       WHERE x-abc-analysis-obj.abc-id = x-abc-analysis.abc-id and x-abc-analysis-obj.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-period FOR EACH x-abc-analysis-period       WHERE x-abc-analysis-period.abc-id = x-abc-analysis.abc-id and x-abc-analysis-period.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-rez FOR EACH temp-rez .    OPEN QUERY BROWSE-type-doc FOR EACH x-abc-analysis-doc       WHERE x-abc-analysis-doc.abc-id = x-abc-analysis.abc-id and x-abc-analysis-doc.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     4603   END PROCEDURE.
     4604   PROCEDURE find-hash-obj :
     4605     define variable v-list-obj as character no-undo .
     4606     define variable v-possb-keep-string-obj as logical   no-undo .
     4607     define variable v-string-obj            as character no-undo .
     4608     define variable v-hash-string-obj       as character no-undo .
     4609     define variable v-recid as recid     no-undo .
     4610     v-list-obj = "".
     4611     for each x-abc-analysis-obj no-lock
     4612         where x-abc-analysis-obj.abc-id = x-abc-analysis.abc-id and
     4613               x-abc-analysis-obj.db-num = x-abc-analysis.db-num  :
     4614               v-list-obj = v-list-obj + x-abc-analysis-obj.obj-type + string(x-abc-analysis-obj.obj-code) + "," .
     4615     end.
     4616     run find-from-hash  (
     4617        input v-list-obj
     4618       ,input "ub.rang-abc-def"
     4619       ,input "ub.raad-possb-keep-string-obj"
     4620       ,input "ub.raad-string-obj"
     4621       ,input "ub.raad-hash-string-obj"
     4622       ,input "ub.rang-abc-def-obj"
     4623       ,output v-recid
     4624       ).
     4625      find first ub.rang-abc-def no-lock where
     4626                 recid(ub.rang-abc-def) = v-recid
     4627                 no-error .
     4628       if available ub.rang-abc-def then do:
     4629          message "Найдено значение уровней ранжирования для данного списка объектов по умолчанию : " skip
     4630                   ub.rang-abc-def.raad-a                                                                skip
     4631                   ub.rang-abc-def.raad-b                                                                skip
     4632                   ub.rang-abc-def.raad-c                                                                skip
     4633                  if  ub.rang-abc-def.raad-d = 0 then "" else string(ub.rang-abc-def.raad-d)                skip
     4634                  if  ub.rang-abc-def.raad-e = 0 then "" else string(ub.rang-abc-def.raad-e)                skip
     4635                  if  ub.rang-abc-def.raad-f = 0 then "" else string(ub.rang-abc-def.raad-f)
     4636                  .
     4637          define variable raad-def as character no-undo .
     4638          define variable v-raad-d as decimal   no-undo .
     4639          define variable v-raad-e as decimal   no-undo .
     4640          define variable v-raad-c as decimal   no-undo .
     4641          if ub.rang-abc-def.raad-d = 0 and  ub.rang-abc-def.raad-e = 0 and ub.rang-abc-def.raad-f = 0 then raad-def = "ABC":U .
     4642          if ub.rang-abc-def.raad-d > 0 and  ub.rang-abc-def.raad-e = 0 and ub.rang-abc-def.raad-f = 0 then raad-def = "ABCD":U .
     4643          if ub.rang-abc-def.raad-d > 0 and  ub.rang-abc-def.raad-e > 0 and ub.rang-abc-def.raad-f = 0 then raad-def = "ABCDE":U .
     4644          if ub.rang-abc-def.raad-d > 0 and  ub.rang-abc-def.raad-e > 0 and ub.rang-abc-def.raad-f > 0 then raad-def = "ABCDEF":U .
     4645          assign
     4646            v-raad-d = ub.rang-abc-def.raad-d
     4647            v-raad-e = ub.rang-abc-def.raad-e
     4648            v-raad-c = ub.rang-abc-def.raad-c
     4649          .
     4650          if length(raad-def) < length(par-abc-type) then do:
     4651             if  ub.rang-abc-def.raad-d = 100 then v-raad-d = 0 .
     4652             if  ub.rang-abc-def.raad-e = 100 then v-raad-e = 0 .
     4653             if  ub.rang-abc-def.raad-c = 100 then v-raad-c = 0 .
     4654          end.
     4655          assign
     4656           x-abc-analysis.abc-a  = ub.rang-abc-def.raad-a
     4657           x-abc-analysis.abc-b  = ub.rang-abc-def.raad-b
     4658           x-abc-analysis.abc-c  = v-raad-c
     4659           x-abc-analysis.abc-d  = v-raad-d
     4660           x-abc-analysis.abc-e  = v-raad-e
     4661           x-abc-analysis.abc-f  = ub.rang-abc-def.raad-f
     4662           x-abc-analysis.raad-f = ub.rang-abc-def.raad-f
     4663           x-abc-analysis.raad-a = ub.rang-abc-def.raad-a
     4664           x-abc-analysis.raad-b = ub.rang-abc-def.raad-b
     4665           x-abc-analysis.raad-c = v-raad-c
     4666           x-abc-analysis.raad-d = v-raad-d
     4667           x-abc-analysis.raad-e = v-raad-e
     4668          .
     4669          if par-abc-type = "ABC":U  then do:
     4670          assign
     4671              x-abc-analysis.abc-c = 100
     4672              x-abc-analysis.abc-d = 0
     4673              x-abc-analysis.abc-e = 0
     4674              x-abc-analysis.abc-f = 0
     4675          .
     4676          end.
     4677          if par-abc-type = "ABCD":U  then do:
     4678          assign
     4679              x-abc-analysis.abc-d = 100
     4680              x-abc-analysis.abc-e = 0
     4681              x-abc-analysis.abc-f = 0
     4682          .
     4683          end.
     4684          if par-abc-type = "ABCDE":U  then do:
     4685          assign
     4686              x-abc-analysis.abc-e = 100
     4687              x-abc-analysis.abc-f = 0
     4688          .
     4689          end.
     4690          if par-abc-type = "ABCDEF":U  then do:
     4691          assign
     4692              x-abc-analysis.abc-f = 100
     4693          .
     4694          end.
     4695          display x-abc-analysis.abc-a
     4696                  x-abc-analysis.abc-b
     4697                  x-abc-analysis.abc-c  when par-abc-type = "ABCD":U   or  par-abc-type = "ABCDE":U or  par-abc-type = "ABCDEF":U
     4698                  x-abc-analysis.abc-d  when par-abc-type = "ABCDE":U  or  par-abc-type = "ABCDEF":U
     4699                  x-abc-analysis.abc-e  when par-abc-type = "ABCDEF":U
     4700                  with frame Dialog-Frame .
     4701          apply "LEAVE" to x-abc-analysis.abc-b  in frame Dialog-Frame .
     4702       end.
     4703     run find-from-hash  (
     4704        input v-list-obj
     4705       ,input "ub.doc-abc-def"
     4706       ,input "ub.doad-possb-keep-string-obj"
     4707       ,input "ub.doad-string-obj"
     4708       ,input "ub.doad-hash-string-obj"
     4709       ,input "ub.doc-abc-def-obj"
     4710       ,output v-recid
     4711       ).
     4712      find first ub.doc-abc-def no-lock where
     4713                 recid(ub.doc-abc-def) = v-recid
     4714                 no-error .
     4715       if available ub.doc-abc-def then do:
     4716       for each ub.doc-abc-def-doc no-lock  where
     4717               ub.doc-abc-def-doc.doad-id = ub.doc-abc-def.doad-id and
     4718               ub.doc-abc-def-doc.db-num  = ub.doc-abc-def.db-num   :
     4719           create x-abc-analysis-doc.
     4720            assign
     4721               x-abc-analysis-doc.abcd-ext-doc-type = ub.doc-abc-def-doc.dadd-ext-doc-type
     4722               x-abc-analysis-doc.abc-id   = x-abc-analysis.abc-id
     4723               x-abc-analysis-doc.db-num   = x-abc-analysis.db-num
     4724            .
     4725           OPEN QUERY BROWSE-type-doc FOR EACH x-abc-analysis-doc       WHERE x-abc-analysis-doc.abc-id = x-abc-analysis.abc-id and x-abc-analysis-doc.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     4726       end.
     4727       end.
     4728   END PROCEDURE.
     4729   PROCEDURE make-temp-rez :
     4730   define buffer bb_abc-analysis for ub.abc-analysis.
     4731   find first bb_abc-analysis no-lock where
     4732              bb_abc-analysis.abc-id = p-id and
     4733              bb_abc-analysis.db-num = p-db-num
     4734              no-error .
     4735   for each temp-rez : delete temp-rez. end.
     4736       CREATE temp-rez.
     4737       ASSIGN
     4738       temp-rez.n  = 1
     4739       temp-rez.ABC  = "A"
     4740       temp-rez.Sum-cr   = bb_abc-analysis.abc-a-sum
     4741       temp-rez.Sum_prc  = bb_abc-analysis.abc-a-sum-prc
     4742       temp-rez.qnty     = bb_abc-analysis.abc-a-qnty
     4743       temp-rez.qnty_prc = bb_abc-analysis.abc-a-prc-qnty
     4744        .
     4745       CREATE temp-rez.
     4746       ASSIGN
     4747       temp-rez.n  = 2
     4748       temp-rez.ABC  = "B"
     4749       temp-rez.Sum-cr   = bb_abc-analysis.abc-b-sum
     4750       temp-rez.Sum_prc  = bb_abc-analysis.abc-b-sum-prc
     4751       temp-rez.qnty     = bb_abc-analysis.abc-b-qnty
     4752       temp-rez.qnty_prc = bb_abc-analysis.abc-b-prc-qnty
     4753        .
     4754       CREATE temp-rez.
     4755       ASSIGN
     4756       temp-rez.n  = 3
     4757       temp-rez.ABC  = "C"
     4758       temp-rez.Sum-cr   = bb_abc-analysis.abc-c-sum
     4759       temp-rez.Sum_prc  = bb_abc-analysis.abc-c-sum-prc
     4760       temp-rez.qnty     = bb_abc-analysis.abc-c-qnty
     4761       temp-rez.qnty_prc = bb_abc-analysis.abc-c-prc-qnty
     4762        .
     4763       if LENGTH(par-abc-type) >= 4 or bb_abc-analysis.abc-type = "2" then  do:
     4764           CREATE temp-rez.
     4765           ASSIGN
     4766           temp-rez.n  = 4
     4767           temp-rez.ABC  = "D"
     4768           temp-rez.Sum-cr   = bb_abc-analysis.abc-d-sum
     4769           temp-rez.Sum_prc  = bb_abc-analysis.abc-d-sum-prc
     4770           temp-rez.qnty     = bb_abc-analysis.abc-d-qnty
     4771           temp-rez.qnty_prc = bb_abc-analysis.abc-d-prc-qnty
     4772           .
     4773       end.
     4774       if LENGTH(par-abc-type) >= 5 or bb_abc-analysis.abc-type = "2" then do:
     4775           CREATE temp-rez.
     4776           ASSIGN
     4777           temp-rez.n  = 5
     4778           temp-rez.ABC  = "E"
     4779           temp-rez.Sum-cr   = bb_abc-analysis.abc-e-sum
     4780           temp-rez.Sum_prc  = bb_abc-analysis.abc-e-sum-prc
     4781           temp-rez.qnty     = bb_abc-analysis.abc-e-qnty
     4782           temp-rez.qnty_prc = bb_abc-analysis.abc-e-prc-qnty
     4783           .
     4784       end.
     4785       if LENGTH(par-abc-type) >= 6 then do:
     4786           CREATE temp-rez.
     4787           ASSIGN
     4788           temp-rez.n  = 6
     4789           temp-rez.ABC  = "F"
     4790           temp-rez.Sum-cr   = bb_abc-analysis.abc-f-sum
     4791           temp-rez.Sum_prc  = bb_abc-analysis.abc-f-sum-prc
     4792           temp-rez.qnty     = bb_abc-analysis.abc-f-qnty
     4793           temp-rez.qnty_prc = bb_abc-analysis.abc-f-prc-qnty
     4794           .
     4795       end.
     4796       CREATE temp-rez.
     4797       ASSIGN
     4798       temp-rez.n  = 7
     4799       temp-rez.ABC  = "ИТОГО"
     4800       temp-rez.Sum-cr     =
     4801                             bb_abc-analysis.abc-a-sum + bb_abc-analysis.abc-b-sum +
     4802                             bb_abc-analysis.abc-c-sum + bb_abc-analysis.abc-d-sum +
     4803                             bb_abc-analysis.abc-e-sum + bb_abc-analysis.abc-f-sum
     4804       temp-rez.Sum_prc    = 100
     4805       temp-rez.qnty       =
     4806                             bb_abc-analysis.abc-a-qnty + bb_abc-analysis.abc-b-qnty +
     4807                             bb_abc-analysis.abc-c-qnty + bb_abc-analysis.abc-d-qnty +
     4808                             bb_abc-analysis.abc-e-qnty + bb_abc-analysis.abc-f-qnty
     4809       temp-rez.qnty_prc   = 100
     4810        .
     4811   OPEN QUERY BROWSE-rez FOR EACH temp-rez .
     4812   END PROCEDURE.
     4813   PROCEDURE my_enable :
     4814      case par-abc-type :
     4815      when 'AB':U then do:
     4816             hide
     4817                 f-c in frame Dialog-Frame
     4818                 f-d in frame Dialog-Frame
     4819                 f-e
     4820                 f-f
     4821                 rect-c
     4822                 rect-d
     4823                 rect-e
     4824                 rect-f
     4825                 fill-in-3
     4826                 fill-in-4
     4827                 fill-in-5
     4828                 fill-in-6
     4829                 in frame Dialog-Frame .
     4830      end.
     4831      when 'ABC':U then do:
     4832             hide
     4833                 f-d in frame Dialog-Frame
     4834                 f-e
     4835                 f-f
     4836                 rect-d
     4837                 rect-e
     4838                 rect-f
     4839                 fill-in-4
     4840                 fill-in-5
     4841                 fill-in-6
     4842                 in frame Dialog-Frame .
     4843                 x-abc-analysis.LE-proc:label = "E <= % "  .
     4844      end.
     4845      when 'ABCD':U then do:
     4846        hide
     4847           f-e
     4848           f-f
     4849           rect-e
     4850           rect-f
     4851           fill-in-5
     4852           fill-in-6
     4853           in frame Dialog-Frame .
     4854        x-abc-analysis.LE-proc:label = "F <= % "  .
     4855      end.
     4856      when 'ABCDE':U  then do:
     4857         hide
     4858         f-f
     4859         rect-f
     4860         fill-in-6
     4861         in frame Dialog-Frame .
     4862         x-abc-analysis.LE-proc:label = "G <= % "  .
     4863      end.
     4864      when 'ABCDEF':U then do:
     4865         x-abc-analysis.LE-proc:label = "H <= % "  .
     4866      end.
     4867      otherwise do:
     4868        message "Не верно задан параметр abc-type " par-abc-type view-as alert-box error .
     4869      end.
     4870      end case.
     4871       if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     4872      assign frame Dialog-Frame:title = "Просмотр АВС анализа " .
     4873       for each ub.abc-analysis-doc no-lock  where
     4874               ub.abc-analysis-doc.abc-id = x-abc-analysis.abc-id and
     4875               ub.abc-analysis-doc.db-num = x-abc-analysis.db-num   :
     4876           create x-abc-analysis-doc.
     4877           BUFFER-COPY ub.abc-analysis-doc  TO x-abc-analysis-doc
     4878               .
     4879       end.
     4880       for each ub.abc-analysis-obj no-lock  where
     4881               ub.abc-analysis-obj.abc-id = x-abc-analysis.abc-id and
     4882               ub.abc-analysis-obj.db-num = x-abc-analysis.db-num   :
     4883           create x-abc-analysis-obj.
     4884           BUFFER-COPY ub.abc-analysis-obj  TO x-abc-analysis-obj.
     4885       end.
     4886       for each ub.abc-analysis-period no-lock where
     4887               ub.abc-analysis-period.abc-id = x-abc-analysis.abc-id and
     4888               ub.abc-analysis-period.db-num = x-abc-analysis.db-num   :
     4889           create x-abc-analysis-period.
     4890           BUFFER-COPY ub.abc-analysis-period TO x-abc-analysis-period.
     4891       end.
     4892       run make-temp-rez in this-procedure .
     4893   end.
     4894   define variable v-user-name as character no-undo .
     4895   IF AVAILABLE x-abc-analysis THEN DO:
     4896       f-time =  STRING (x-abc-analysis.abc-time-create,'HH:MM') .
     4897   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4898   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     4899     (input  x-abc-analysis.abc-who-create
     4900     ,output v-user-name
     4901     )  .
     4902       DISPLAY x-abc-analysis.abc-name
     4903               x-abc-analysis.abc-a
     4904               x-abc-analysis.abc-b
     4905               x-abc-analysis.abc-c when  par-abc-type = "ABCD":U   or  par-abc-type = "ABCDE":U or  par-abc-type = "ABCDEF":U
     4906               x-abc-analysis.abc-d when  par-abc-type = "ABCDE":U  or  par-abc-type = "ABCDEF":U
     4907               x-abc-analysis.abc-e when  par-abc-type = "ABCDEF":U
     4908               x-abc-analysis.abc-des
     4909               x-abc-analysis.cral-id
     4910               v-user-name          when p-mode <> 'ДОБАВЛЕНИЕ':U @  x-abc-analysis.abc-who-create
     4911               x-abc-analysis.abc-date-create   when p-mode <> 'ДОБАВЛЕНИЕ':U
     4912               f-time                           when p-mode <> 'ДОБАВЛЕНИЕ':U
     4913               x-abc-analysis.abc-db-num-create when p-mode <> 'ДОБАВЛЕНИЕ':U
     4914               x-abc-analysis.abc-id when p-mode <> 'ДОБАВЛЕНИЕ':U
     4915               fill-in-1
     4916               fill-in-2
     4917               fill-in-3
     4918               fill-in-4 when  par-abc-type = "ABCD":U   or  par-abc-type = "ABCDE":U or  par-abc-type = "ABCDEF":U
     4919               fill-in-5 when  par-abc-type = "ABCDE":U  or  par-abc-type = "ABCDEF":U
     4920               fill-in-6 when  par-abc-type = "ABCDEF":U
     4921               fill-in-7
     4922               B-rez                             when p-mode <> 'ДОБАВЛЕНИЕ':U
     4923               FILL-rez                          when p-mode <> 'ДОБАВЛЕНИЕ':U
     4924               x-abc-analysis.r-goods
     4925               x-abc-analysis.abc-type
     4926               x-abc-analysis.LE-proc WHEN  x-abc-analysis.abc-type = "2"
     4927               x-abc-analysis.double-line-proc WHEN  x-abc-analysis.abc-type = "2"
     4928               fill-in-8  WHEN  x-abc-analysis.abc-type = "2"
     4929               fill-in-9  WHEN  x-abc-analysis.abc-type = "2"
     4930               fill-in-10 WHEN  x-abc-analysis.abc-type = "2"
     4931               fill-in-11 WHEN  x-abc-analysis.abc-type = "2"
     4932               WITH FRAME Dialog-Frame.
     4933       find first x-criterion-analysis no-lock where x-criterion-analysis.cral-id = x-abc-analysis.cral-id no-error .
     4934          IF AVAILABLE x-criterion-analysis THEN
     4935              DISPLAY x-criterion-analysis.cral-name WITH FRAME Dialog-Frame.
     4936    END.
     4937     rect-a:bgcolor in frame Dialog-Frame = 4.
     4938     rect-b:bgcolor in frame Dialog-Frame = 1.
     4939     rect-c:bgcolor in frame Dialog-Frame = 15.
     4940     rect-d:bgcolor in frame Dialog-Frame = 3.
     4941     rect-e:bgcolor in frame Dialog-Frame = 5.
     4942     rect-f:bgcolor in frame Dialog-Frame = 7.
     4943         if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     4944           assign frame Dialog-Frame:title = "Добавление АВС анализа " .
     4945           display  ""  @  x-criterion-analysis.cral-name     with frame Dialog-Frame .
     4946           hide rect-a
     4947                rect-b
     4948                rect-c
     4949                rect-d
     4950                rect-e
     4951                rect-f
     4952                B-rez
     4953                FILL-rez
     4954                BROWSE-rez
     4955                in frame Dialog-Frame .
     4956           hide  x-abc-analysis.abc-c
     4957                 x-abc-analysis.abc-d
     4958                 x-abc-analysis.abc-e
     4959                 in frame Dialog-Frame .
     4960           if x-abc-analysis.abc-a > 0 then
     4961                 run proc-sel-rec (
     4962                     x-abc-analysis.abc-a ,
     4963                     x-abc-analysis.abc-b ,
     4964                     x-abc-analysis.abc-c ,
     4965                     x-abc-analysis.abc-d ,
     4966                     x-abc-analysis.abc-e
     4967                     )  .
     4968         end.
     4969         if p-mode = 'ПРОСМОТР':U then do:
     4970           assign
     4971             b-quit:label = "&Выход"
     4972             b-quit:col = 1
     4973           .
     4974             hide b-exit in frame Dialog-Frame.
     4975             if x-abc-analysis.abc-a > 0 then
     4976                run proc-sel-rec (
     4977                    x-abc-analysis.abc-a ,
     4978                    x-abc-analysis.abc-b ,
     4979                    x-abc-analysis.abc-c ,
     4980                    x-abc-analysis.abc-d ,
     4981                    x-abc-analysis.abc-e
     4982                    )  .
     4983         end.
     4984         ENABLE
     4985         B-exit when p-mode <> 'ПРОСМОТР':U
     4986         b-quit
     4987         B-Help
     4988         x-abc-analysis.abc-name when p-mode <> 'ПРОСМОТР':U
     4989         B-crt                   when p-mode <> 'ПРОСМОТР':U
     4990         x-abc-analysis.abc-a    when p-mode <> 'ПРОСМОТР':U
     4991         x-abc-analysis.abc-b    when p-mode <> 'ПРОСМОТР':U
     4992         x-abc-analysis.abc-c    when p-mode <> 'ПРОСМОТР':U and (par-abc-type = "ABCD":U   or  par-abc-type = "ABCDE":U or  par-abc-type = "ABCDEF":U)
     4993         x-abc-analysis.abc-d    when p-mode <> 'ПРОСМОТР':U and (par-abc-type = "ABCDE":U  or  par-abc-type = "ABCDEF":U                             )
     4994         x-abc-analysis.abc-e    when p-mode <> 'ПРОСМОТР':U and (par-abc-type = "ABCDEF":U                                                           )
     4995         FILL-IN-1
     4996         B-add-obj               when p-mode <> 'ПРОСМОТР':U
     4997         B-del-obj               when p-mode <> 'ПРОСМОТР':U
     4998         B-add-period            when p-mode <> 'ПРОСМОТР':U
     4999         B-del-period            when p-mode <> 'ПРОСМОТР':U
     5000         B-add-doc               when p-mode <> 'ПРОСМОТР':U
     5001         B-del-doc               when p-mode <> 'ПРОСМОТР':U
     5002         x-abc-analysis.abc-des  when p-mode <> 'ПРОСМОТР':U
     5003         BROWSE-obj
     5004         BROWSE-period
     5005         BROWSE-type-doc
     5006         BROWSE-rez        when p-mode = 'ПРОСМОТР':U
     5007         B-save-doc-typd   when p-mode <> 'ПРОСМОТР':U
     5008         B-save-rang       when p-mode <> 'ПРОСМОТР':U
     5009         b-rez             when p-mode = 'ПРОСМОТР':U
     5010         x-abc-analysis.r-goods  when p-mode <> 'ПРОСМОТР':U
     5011         x-abc-analysis.abc-type when p-mode <> 'ПРОСМОТР':U
     5012         x-abc-analysis.LE-proc  when ( p-mode = 'ДОБАВЛЕНИЕ':U and  x-abc-analysis.abc-type = "2")
     5013         b-gds-list        when p-mode <> 'ПРОСМОТР':U
     5014         WITH FRAME Dialog-Frame.
     5015     VIEW FRAME Dialog-Frame.
     5016       FILL-IN-11 = "/ " + string ( 100 - x-abc-analysis.double-line-proc ) + " %" .
     5017       if x-abc-analysis.abc-type <> "2" then do:
     5018         hide FILL-IN-8 FILL-IN-9 FILL-IN-10 FILL-IN-11 x-abc-analysis.le-proc x-abc-analysis.double-line-proc in frame Dialog-Frame .
     5019       end.
     5020       else do:
     5021         display  FILL-IN-8 FILL-IN-9 FILL-IN-10 FILL-IN-11  x-abc-analysis.le-proc x-abc-analysis.double-line-proc with frame Dialog-Frame .
     5022         if p-mode = 'ДОБАВЛЕНИЕ':U then
     5023            enable  x-abc-analysis.le-proc x-abc-analysis.double-line-proc with frame Dialog-Frame .
     5024       end.
     5025     OPEN QUERY BROWSE-obj FOR EACH x-abc-analysis-obj       WHERE x-abc-analysis-obj.abc-id = x-abc-analysis.abc-id and x-abc-analysis-obj.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-period FOR EACH x-abc-analysis-period       WHERE x-abc-analysis-period.abc-id = x-abc-analysis.abc-id and x-abc-analysis-period.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-rez FOR EACH temp-rez .    OPEN QUERY BROWSE-type-doc FOR EACH x-abc-analysis-doc       WHERE x-abc-analysis-doc.abc-id = x-abc-analysis.abc-id and x-abc-analysis-doc.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     5026   END PROCEDURE.
     5027   PROCEDURE next-focus :
     5028     define input parameter p-widget-handle as handle no-undo .
     5029     define variable l-apply-entry as logical no-undo .
     5030     assign
     5031       l-apply-entry =  true
     5032     .
     5033     do with frame Dialog-Frame :
     5034       if  x-abc-analysis.abc-name  :handle = p-widget-handle then do:    if B-crt                  :sensitive then do: apply "entry":u to B-crt                  .  return . end. end.
     5035       if  B-crt              :handle = p-widget-handle then do:          if B-add-obj              :sensitive then do: apply "entry":u to B-add-obj              .  return . end. end.
     5036       if  B-add-obj          :handle = p-widget-handle then do:          if B-add-period           :sensitive then do: apply "entry":u to B-add-period           .  return . end. end.
     5037       if  B-add-period         :handle = p-widget-handle then do:        if B-add-doc              :sensitive then do: apply "entry":u to B-add-doc              .  return . end. end.
     5038       if  B-add-doc        :handle = p-widget-handle then do:            if x-abc-analysis.abc-a   :sensitive then do: apply "entry":u to x-abc-analysis.abc-a   .  return . end. end.
     5039       if  x-abc-analysis.abc-a        :handle = p-widget-handle then do: if x-abc-analysis.abc-b   :sensitive then do: apply "entry":u to x-abc-analysis.abc-b   .  return . end. end.
     5040       if  x-abc-analysis.abc-b        :handle = p-widget-handle then do: if x-abc-analysis.abc-c   :sensitive then do: apply "entry":u to x-abc-analysis.abc-c .  return . end.
     5041                                                                                                               else do: apply "entry":u to x-abc-analysis.abc-des .  return . end. end.
     5042       if  x-abc-analysis.abc-c        :handle = p-widget-handle then do: if x-abc-analysis.abc-d   :sensitive then do: apply "entry":u to x-abc-analysis.abc-d .  return . end.
     5043                                                                                                               else do: apply "entry":u to x-abc-analysis.abc-des .  return . end. end.
     5044       if  x-abc-analysis.abc-d        :handle = p-widget-handle then do: if x-abc-analysis.abc-e   :sensitive then do: apply "entry":u to x-abc-analysis.abc-e .  return . end.
     5045                                                                                                               else do: apply "entry":u to x-abc-analysis.abc-des .  return . end. end.
     5046       if  x-abc-analysis.abc-e        :handle = p-widget-handle then do: if x-abc-analysis.abc-des :sensitive then do: apply "entry":u to x-abc-analysis.abc-des .  return . end. end.
     5047       if  x-abc-analysis.abc-des      :handle = p-widget-handle then do: if B-exit                 :sensitive then do: apply "entry":u to B-exit                 .  return . end. end.
     5048     end.
     5049   END PROCEDURE.
     5050   PROCEDURE OpenBR :
     5051   OPEN QUERY BROWSE-obj FOR EACH x-abc-analysis-obj       WHERE x-abc-analysis-obj.abc-id = x-abc-analysis.abc-id and x-abc-analysis-obj.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-period FOR EACH x-abc-analysis-period       WHERE x-abc-analysis-period.abc-id = x-abc-analysis.abc-id and x-abc-analysis-period.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-rez FOR EACH temp-rez .    OPEN QUERY BROWSE-type-doc FOR EACH x-abc-analysis-doc       WHERE x-abc-analysis-doc.abc-id = x-abc-analysis.abc-id and x-abc-analysis-doc.db-num = x-abc-analysis.db-num NO-LOCK INDEXED-REPOSITION.
     5052   END PROCEDURE.
     5053   PROCEDURE proc-save :
     5054   if p-mode = 'ПРОСМОТР':U then do:
     5055       return error.
     5056   end.
     5057   if not available x-abc-analysis then do:
     5058       create x-abc-analysis.
     5059   end.
     5060   assign
     5061   frame Dialog-Frame
     5062   x-abc-analysis.abc-id
     5063   x-abc-analysis.abc-name
     5064   x-abc-analysis.abc-a
     5065   x-abc-analysis.abc-b
     5066   x-abc-analysis.abc-c
     5067   x-abc-analysis.abc-d
     5068   x-abc-analysis.abc-e
     5069   x-abc-analysis.r-goods
     5070   x-abc-analysis.LE-proc
     5071   x-abc-analysis.abc-type
     5072   .
     5073   IF r-goods = 1 THEN DO:
     5074   END.
     5075   if LENGTH(par-abc-type) = 3 then do:
     5076   x-abc-analysis.abc-c = 100  .
     5077   x-abc-analysis.abc-d = 0    .
     5078   x-abc-analysis.abc-e = 0    .
     5079   x-abc-analysis.abc-f = 0    .
     5080   end.
     5081   if LENGTH(par-abc-type) = 4 then do:
     5082   x-abc-analysis.abc-d = 100    .
     5083   x-abc-analysis.abc-e = 0    .
     5084   x-abc-analysis.abc-f = 0    .
     5085   end.
     5086   if LENGTH(par-abc-type) = 5 then do:
     5087   x-abc-analysis.abc-e = 100    .
     5088   x-abc-analysis.abc-f = 0    .
     5089   end.
     5090   if LENGTH(par-abc-type) = 6 then do:
     5091   x-abc-analysis.abc-f = 100    .
     5092   end.
     5093   assign
     5094     x-abc-analysis.abc-des = x-abc-analysis.abc-des:SCREEN-VALUE
     5095     .
     5096    run ref/abcanal1.p (
     5097                   input-output p-doc-rec
     5098                   ,p-mode
     5099                   ,table x-abc-analysis
     5100                   ,table x-abc-analysis-doc
     5101                   ,table x-abc-analysis-obj
     5102                   ,table x-abc-analysis-period
     5103                   ) no-error .
     5104   if error-status :error then do:
     5105       return error return-value .
     5106   end.
     5107   END PROCEDURE.
     5108   PROCEDURE proc-sel-rec :
     5109   define input  parameter p-abc-a as decimal   no-undo .
     5110   define input  parameter p-abc-b as decimal   no-undo .
     5111   define input  parameter p-abc-c as decimal   no-undo .
     5112   define input  parameter p-abc-d as decimal   no-undo .
     5113   define input  parameter p-abc-e as decimal   no-undo .
     5114   define variable v-a as decimal   no-undo .
     5115   define variable v-b as decimal   no-undo .
     5116   define variable v-c as decimal   no-undo .
     5117   define variable v-d as decimal   no-undo .
     5118   define variable v-e as decimal   no-undo .
     5119   define variable v-f as decimal   no-undo .
     5120   define variable v-a-pr as decimal   no-undo .
     5121   define variable v-b-pr as decimal   no-undo .
     5122   define variable v-c-pr as decimal   no-undo .
     5123   define variable v-d-pr as decimal   no-undo .
     5124   define variable v-e-pr as decimal   no-undo .
     5125   define variable old-par-abc-type as character no-undo .
     5126   old-par-abc-type = par-abc-type .
     5127   if p-abc-e = 100  then  par-abc-type = 'ABCDE':U .
     5128   if p-abc-d = 100  then  par-abc-type = 'ABCD':U .
     5129   if p-abc-c = 100  then  par-abc-type = 'ABC':U .
     5130   if p-abc-e <> 0 and p-abc-e <> 100 then  par-abc-type = 'ABCDEF':U .
     5131   if LENGTH(par-abc-type) > LENGTH(old-par-abc-type) then message "Анализ проведен по типу " par-abc-type " а тип работы выставленный в параметре конфигурации " old-par-abc-type
     5132      view-as alert-box information
     5133   .
     5134   case par-abc-type :
     5135      when 'ABC':U
     5136      then do:
     5137           assign
     5138             v-c    = 37.5
     5139             v-a-pr = p-abc-a
     5140             v-b-pr = p-abc-b
     5141           .
     5142           if v-a-pr >  v-b-pr and v-b-pr <> 0 then do:
     5143               return error "Уровень ранжирования А должны быть меньше В  !!! "  .
     5144           end.
     5145           if v-a-pr > 100 then do:
     5146               return error "Уровень ранжирования А должны быть меньше 100%  !!! "  .
     5147           end.
     5148           if v-b-pr > 100 then do:
     5149               return error "Уровень ранжирования B должны быть меньше 100%  !!! "  .
     5150           end.
     5151           v-a = v-a-pr * v-c / 100 .
     5152           v-b = v-b-pr * v-c / 100 .
     5153           if v-a > 0 then
     5154               rect-a:WIDTH-CHARS in frame Dialog-Frame  =  v-a.
     5155           if v-b > 0 then
     5156               rect-b:WIDTH-CHARS =  v-b.
     5157               rect-c:WIDTH-CHARS =  v-c.
     5158           DISPLAY
     5159             rect-c
     5160             rect-b when v-b > 0
     5161             rect-a
     5162           WITH FRAME Dialog-Frame.
     5163           DISPLAY
     5164             rect-a
     5165           WITH FRAME Dialog-Frame.
     5166           assign
     5167             f-a = "A=" + string(v-a-pr)
     5168             f-b = "B=" + string(v-b-pr - v-a-pr )
     5169             f-c = "C=" + string( 100 - v-b-pr )
     5170             f-d = ""
     5171             f-e = ""
     5172             f-f = ""
     5173           .
     5174           DISPLAY
     5175             f-c when v-b > 0
     5176             f-b when v-b > 0
     5177             f-a when v-a > 0
     5178           WITH FRAME Dialog-Frame.
     5179           hide
     5180           f-d  rect-d x-abc-analysis.abc-d fill-in-4
     5181           f-e  rect-e x-abc-analysis.abc-e fill-in-5
     5182           f-f  rect-f                      fill-in-6
     5183           in frame Dialog-Frame .
     5184      end.
     5185      when 'ABCD':U
     5186      then do:
     5187           assign
     5188             v-d    = 37.5
     5189             v-a-pr = p-abc-a
     5190             v-b-pr = p-abc-b
     5191             v-c-pr = p-abc-c
     5192           .
     5193           if v-a-pr >  v-b-pr and v-b-pr <> 0 then do:
     5194               return error "Уровень ранжирования А должны быть меньше В  !!! "  .
     5195           end.
     5196           if v-b-pr >  v-c-pr and v-c-pr <> 0 then do:
     5197               return error "Уровень ранжирования B должны быть меньше C  !!! "  .
     5198           end.
     5199           if v-a-pr > 100 then do:
     5200               return error "Уровень ранжирования А должны быть меньше 100%  !!! "  .
     5201           end.
     5202           if v-b-pr > 100 then do:
     5203               return error "Уровень ранжирования B должны быть меньше 100%  !!! "  .
     5204           end.
     5205           if v-c-pr > 100 then do:
     5206               return error "Уровень ранжирования C должны быть меньше 100%  !!! "  .
     5207           end.
     5208           v-a = v-a-pr * v-d / 100 .
     5209           v-b = v-b-pr * v-d / 100 .
     5210           v-c = v-c-pr * v-d / 100 .
     5211           if v-a > 0 then
     5212               rect-a:WIDTH-CHARS =  v-a.
     5213           if v-b > 0 then
     5214               rect-b:WIDTH-CHARS =  v-b.
     5215           if v-c > 0 then
     5216               rect-c:WIDTH-CHARS =  v-c.
     5217               rect-d:WIDTH-CHARS =  v-d.
     5218           DISPLAY
     5219             rect-d
     5220             rect-c when v-c > 0
     5221             rect-b when v-b > 0
     5222             rect-a
     5223           WITH FRAME Dialog-Frame.
     5224           DISPLAY
     5225             rect-a
     5226           WITH FRAME Dialog-Frame.
     5227           assign
     5228             f-a = "A=" + string(v-a-pr)
     5229             f-b = "B=" + string(v-b-pr - v-a-pr )
     5230             f-c = "C=" + string( v-c-pr - v-b-pr )
     5231             f-d = "D=" + string( 100 - v-c-pr )
     5232             f-e = ""
     5233             f-f = ""
     5234           .
     5235           display
     5236             f-a when v-a > 0
     5237             f-b when v-b > 0
     5238             f-c when v-c > 0
     5239             f-d when v-d > 0
     5240           with frame Dialog-Frame.
     5241           hide
     5242           f-e  rect-e x-abc-analysis.abc-e fill-in-5
     5243           f-f  rect-f                      fill-in-6
     5244           in frame Dialog-Frame .
     5245      end.
     5246      when 'ABCDE':U
     5247      then do:
     5248           assign
     5249             v-e    = 37.5
     5250             v-d-pr = p-abc-d
     5251             v-a-pr = p-abc-a
     5252             v-b-pr = p-abc-b
     5253             v-c-pr = p-abc-c
     5254           .
     5255           if v-a-pr >  v-b-pr and v-b-pr <> 0 then do:
     5256               return error "Уровень ранжирования А должны быть меньше В  !!! "  .
     5257           end.
     5258           if v-b-pr >  v-c-pr and v-c-pr <> 0 then do:
     5259               return error "Уровень ранжирования B должны быть меньше C  !!! "  .
     5260           end.
     5261           if v-c-pr >  v-d-pr and v-d-pr <> 0 then do:
     5262               return error "Уровень ранжирования C должны быть меньше D  !!! "  .
     5263           end.
     5264           if v-a-pr > 100 then do:
     5265               return error "Уровень ранжирования А должны быть меньше 100%  !!! "  .
     5266           end.
     5267           if v-b-pr > 100 then do:
     5268               return error "Уровень ранжирования B должны быть меньше 100%  !!! "  .
     5269           end.
     5270           if v-c-pr > 100 then do:
     5271               return error "Уровень ранжирования C должны быть меньше 100%  !!! "  .
     5272           end.
     5273           if v-d-pr > 100 then do:
     5274               return error "Уровень ранжирования D должны быть меньше 100%  !!! "  .
     5275           end.
     5276           v-a = v-a-pr * v-e / 100 .
     5277           v-b = v-b-pr * v-e / 100 .
     5278           v-c = v-c-pr * v-e / 100 .
     5279           v-d = v-d-pr * v-e / 100 .
     5280           if v-a > 0 then
     5281               rect-a:WIDTH-CHARS =  v-a.
     5282           if v-b > 0 then
     5283               rect-b:WIDTH-CHARS =  v-b.
     5284           if v-c > 0 then
     5285               rect-c:WIDTH-CHARS =  v-c.
     5286           if v-d > 0 then
     5287               rect-d:WIDTH-CHARS =  v-d.
     5288               rect-e:WIDTH-CHARS =  v-e.
     5289           DISPLAY
     5290             rect-e
     5291             rect-d when v-d > 0
     5292             rect-c when v-c > 0
     5293             rect-b when v-b > 0
     5294             rect-a
     5295           WITH FRAME Dialog-Frame.
     5296           DISPLAY
     5297             rect-a
     5298           WITH FRAME Dialog-Frame.
     5299           assign
     5300             f-a = "A=" + string(v-a-pr)
     5301             f-b = "B=" + string(v-b-pr - v-a-pr )
     5302             f-c = "C=" + string( v-c-pr - v-b-pr )
     5303             f-d = "D=" + string( v-d-pr - v-c-pr )
     5304             f-e = "E=" + string( 100 - v-d-pr )
     5305             f-f = ""
     5306           .
     5307           display
     5308             f-a when v-a > 0
     5309             f-b when v-b > 0
     5310             f-c when v-c > 0
     5311             f-d when v-d > 0
     5312             f-e when v-e > 0
     5313           with frame Dialog-Frame.
     5314           hide
     5315           f-f  rect-f fill-in-6
     5316           in frame Dialog-Frame .
     5317      end.
     5318      when 'ABCDEF':U
     5319      then do:
     5320           assign
     5321             v-f    = 37.5
     5322             v-a-pr = p-abc-a
     5323             v-b-pr = p-abc-b
     5324             v-c-pr = p-abc-c
     5325             v-d-pr = p-abc-d
     5326             v-e-pr = p-abc-e
     5327           .
     5328           if v-a-pr >  v-b-pr and v-b-pr <> 0 then do:
     5329               return error "Уровень ранжирования А должны быть меньше В  !!! "  .
     5330           end.
     5331           if v-b-pr >  v-c-pr and v-c-pr <> 0 then do:
     5332               return error "Уровень ранжирования B должны быть меньше C  !!! "  .
     5333           end.
     5334           if v-c-pr >  v-d-pr and v-d-pr <> 0 then do:
     5335               return error "Уровень ранжирования C должны быть меньше D  !!! "  .
     5336           end.
     5337           if v-d-pr >  v-e-pr and v-e-pr <> 0 then do:
     5338               return error "Уровень ранжирования D должны быть меньше E  !!! "  .
     5339           end.
     5340           if v-a-pr > 100 then do:
     5341               return error "Уровень ранжирования А должны быть меньше 100%  !!! "  .
     5342           end.
     5343           if v-b-pr > 100 then do:
     5344               return error "Уровень ранжирования B должны быть меньше 100%  !!! "  .
     5345           end.
     5346           if v-c-pr > 100 then do:
     5347               return error "Уровень ранжирования C должны быть меньше 100%  !!! "  .
     5348           end.
     5349           if v-d-pr > 100 then do:
     5350               return error "Уровень ранжирования D должны быть меньше 100%  !!! "  .
     5351           end.
     5352           if v-e-pr > 100 then do:
     5353               return error "Уровень ранжирования E должны быть меньше 100%  !!! "  .
     5354           end.
     5355           v-a = v-a-pr * v-f / 100 .
     5356           v-b = v-b-pr * v-f / 100 .
     5357           v-c = v-c-pr * v-f / 100 .
     5358           v-d = v-d-pr * v-f / 100 .
     5359           v-e = v-e-pr * v-f / 100 .
     5360           if v-a > 0 then
     5361               rect-a:WIDTH-CHARS =  v-a.
     5362           if v-b > 0 then
     5363               rect-b:WIDTH-CHARS =  v-b.
     5364           if v-c > 0 then
     5365               rect-c:WIDTH-CHARS =  v-c.
     5366           if v-d > 0 then
     5367               rect-d:WIDTH-CHARS =  v-d.
     5368           if v-e > 0 then
     5369               rect-e:WIDTH-CHARS =  v-e.
     5370               rect-f:WIDTH-CHARS =  v-f.
     5371   DISPLAY
     5372     rect-f
     5373     rect-e
     5374     rect-d
     5375     rect-c
     5376     rect-b
     5377     rect-a
     5378   WITH FRAME Dialog-Frame.
     5379   assign
     5380     f-a = "A=" + string( v-a-pr)
     5381     f-b = "B=" + string( v-b-pr - v-a-pr )
     5382     f-c = "C=" + string( v-c-pr - v-b-pr )
     5383     f-d = "D=" + string( v-d-pr - v-c-pr )
     5384     f-e = "E=" + string( v-e-pr - v-d-pr )
     5385     f-f = "F=" + string( 100    - v-e-pr )
     5386   .
     5387     display
     5388       f-a when v-a > 0
     5389       f-b when v-b > 0
     5390       f-c when v-c > 0
     5391       f-d when v-d > 0
     5392       f-e when v-e > 0
     5393       f-f when v-f > 0
     5394     with frame Dialog-Frame.
     5395      end.
     5396   end case.
     5397       DISPLAY
     5398         x-abc-analysis.abc-a
     5399         x-abc-analysis.abc-b
     5400         x-abc-analysis.abc-c when  par-abc-type = "ABCD":U   or  par-abc-type = "ABCDE":U or  par-abc-type = "ABCDEF":U
     5401         x-abc-analysis.abc-d when  par-abc-type = "ABCDE":U  or  par-abc-type = "ABCDEF":U
     5402         x-abc-analysis.abc-e when  par-abc-type = "ABCDEF":U
     5403       with frame Dialog-Frame.
     5404    par-abc-type = old-par-abc-type .
     5405   END PROCEDURE.
     5406   FUNCTION f-name-doc RETURNS CHARACTER
     5407     ( BUFFER buf_abc-analysis-doc FOR  x-abc-analysis-doc   ) :
     5408     define variable v-ret as character no-undo .
     5409     run get-name-from-ext-type (buf_abc-analysis-doc.abcd-ext-doc-type , no , output v-ret ) .
     5410     RETURN v-ret.
     5411   END FUNCTION.
