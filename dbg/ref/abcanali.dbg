     2372             LABEL "C" FORMAT ">9.9"
     2373             VIEW-AS FILL-IN
     2374             SIZE 6 BY 1
     2375        x-abc-analysis.abc-d AT ROW 10 COL 61 COLON-ALIGNED
     2376             LABEL "D" FORMAT ">9.9"
     2377             VIEW-AS FILL-IN
