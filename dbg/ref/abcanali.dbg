     2480   DO:
     2481       run next-focus in this-procedure  (input  x-abc-analysis.abc-a:handle ) .
     2482     return no-apply .
     2483   END.
     2484   ON LEAVE OF x-abc-analysis.abc-b IN FRAME Dialog-Frame
     2485   DO:
     2486           ASSIGN x-abc-analysis.abc-a x-abc-analysis.abc-b x-abc-analysis.abc-c x-abc-analysis.abc-d x-abc-analysis.abc-e  .
