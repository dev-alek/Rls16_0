     2985         IF  temp-rez.ABC = "E" THEN DO:
     2986             temp-rez.ABC:fgcolor      in browse BROWSE-rez = 5 .
     2987             temp-rez.Sum-cr:fgcolor   in browse BROWSE-rez = 5 .
     2988             temp-rez.Sum_prc:fgcolor  in browse BROWSE-rez = 5 .
     2989             temp-rez.qnty:fgcolor     in browse BROWSE-rez = 5 .
     2990             temp-rez.qnty_prc:fgcolor in browse BROWSE-rez = 5 .
     2991         END.
     2992         IF  temp-rez.ABC = "F" THEN DO:
     2993             temp-rez.ABC:fgcolor      in browse BROWSE-rez = 7 .
     2994             temp-rez.Sum-cr:fgcolor   in browse BROWSE-rez = 7 .
     2995             temp-rez.Sum_prc:fgcolor  in browse BROWSE-rez = 7 .
     2996             temp-rez.qnty:fgcolor     in browse BROWSE-rez = 7 .
     2997             temp-rez.qnty_prc:fgcolor in browse BROWSE-rez = 7 .
     2998         END.
     2999     END.
     3000   END.
