     2946       ,input x-abc-analysis.abc-b
     2947       ,input x-abc-analysis.abc-c
     2948       ,input x-abc-analysis.abc-d
     2949       ,input x-abc-analysis.abc-e
     2950       ,input x-abc-analysis.abc-f ) .
     2951       assign
     2952           x-abc-analysis.raad-a = x-abc-analysis.abc-a
     2953           x-abc-analysis.raad-b = x-abc-analysis.abc-b
     2954           x-abc-analysis.raad-c = x-abc-analysis.abc-c
     2955           x-abc-analysis.raad-d = x-abc-analysis.abc-d
     2956           x-abc-analysis.raad-e = x-abc-analysis.abc-e
     2957           x-abc-analysis.raad-f = x-abc-analysis.abc-f
     2958       .
     2959     run waitfram-hide in this-procedure .
     2960   END.
     2961   ON ROW-DISPLAY OF BROWSE-rez IN FRAME Dialog-Frame
     2962   DO:
