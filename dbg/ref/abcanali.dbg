     2392              VIEW-AS TEXT
     2393             SIZE 3 BY .67
     2394        x-criterion-analysis.cral-name AT ROW 4.25 COL 26.5 COLON-ALIGNED NO-LABEL FORMAT "X(50)"
     2395              VIEW-AS TEXT
     2396             SIZE 68 BY .67
     2397        FILL-IN-1 AT ROW 7.75 COL 59.5 NO-LABEL
     2398        FILL-IN-2 AT ROW 9 COL 67.25 COLON-ALIGNED NO-LABEL
     2399        FILL-IN-4 AT ROW 9 COL 92.25 COLON-ALIGNED NO-LABEL
     2400        FILL-IN-6 AT ROW 10 COL 79.25 COLON-ALIGNED NO-LABEL
     2401        FILL-IN-3 AT ROW 9 COL 79.25 COLON-ALIGNED NO-LABEL
     2402       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2403            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE .
     2404   DEFINE FRAME Dialog-Frame
     2405        FILL-IN-5 AT ROW 10 COL 67.25 COLON-ALIGNED NO-LABEL
     2406        F-a AT ROW 14 COL 58.5 COLON-ALIGNED NO-LABEL
     2407        F-b AT ROW 14 COL 66 COLON-ALIGNED NO-LABEL
     2408        F-c AT ROW 14 COL 73.5 COLON-ALIGNED NO-LABEL
     2409        F-d AT ROW 14 COL 81 COLON-ALIGNED NO-LABEL
     2410        F-E AT ROW 14 COL 88.5 COLON-ALIGNED NO-LABEL
     2411        F-F AT ROW 15 COL 73.5 COLON-ALIGNED NO-LABEL
     2412        FILL-rez AT ROW 11.71 COL 1.5 NO-LABEL
     2413        x-abc-analysis.abc-who-create AT ROW 20.8 COL 23.5 COLON-ALIGNED FORMAT "X(15)"
     2414              VIEW-AS TEXT
     2415             SIZE 14 BY .67
     2416        x-abc-analysis.abc-date-create AT ROW 21.5 COL 23.5 COLON-ALIGNED
     2417              VIEW-AS TEXT
     2418             SIZE 13 BY .67
     2419        F-time AT ROW 21.5 COL 37 COLON-ALIGNED NO-LABEL
     2420        x-abc-analysis.abc-db-num-create AT ROW 22.25 COL 23.5 COLON-ALIGNED
     2421             LABEL "БД создания анализа"
     2422              VIEW-AS TEXT
     2423             SIZE 3 BY .67
     2424        FILL-IN-7 AT ROW 11.25 COL 60.5 NO-LABEL
     2425        FILL-IN-9 AT ROW 6.92 COL 59.5 COLON-ALIGNED NO-LABEL
     2426        FILL-IN-10 AT ROW 15.92 COL 59.5 COLON-ALIGNED NO-LABEL
     2427        RECT-f AT ROW 12.25 COL 60.5
     2428        RECT-E AT ROW 12.25 COL 60.5
     2429        RECT-D AT ROW 12.25 COL 60.5
     2430        RECT-C AT ROW 12.25 COL 60.5
     2431        RECT-B AT ROW 12.25 COL 60.5
     2432        RECT-A AT ROW 12.25 COL 60.5
     2433        SPACE(39.36) SKIP(8.99)
     2434       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2435            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2436            TITLE "Список ABC-анализов".
     2437   ASSIGN
     2438          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2439          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2440   ASSIGN
     2441          F-a:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2442   ASSIGN
     2443          F-b:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2444   ASSIGN
     2445          F-c:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2446   ASSIGN
     2447          F-d:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2448   ASSIGN
     2449          F-E:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2450   ASSIGN
     2451          F-F:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2452   ASSIGN
     2453          FILL-IN-1:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2454   ASSIGN
     2455          FILL-IN-11:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     2456   ASSIGN
     2457          FILL-IN-7:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     2458   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2459   DO:
     2460     APPLY "END-ERROR":U TO SELF.
     2461   END.
     2462   ON LEAVE OF x-abc-analysis.abc-a IN FRAME Dialog-Frame
     2463   DO:
     2464       ASSIGN x-abc-analysis.abc-a
     2465              x-abc-analysis.abc-b
     2466              x-abc-analysis.abc-c
     2467              x-abc-analysis.abc-d
     2468              x-abc-analysis.abc-e
     2469              .
     2470     RUN proc-sel-rec
     2471     ( x-abc-analysis.abc-a,
     2472       x-abc-analysis.abc-b,
     2473       x-abc-analysis.abc-c,
     2474       x-abc-analysis.abc-d,
     2475       x-abc-analysis.abc-e
     2476       )  no-error .
     2477     if error-status :error then message return-value .
     2478   END.
