      171   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172   define variable v-waitfram-action01         as character   no-undo .
      173   define variable v-waitfram-action02         as character   no-undo .
      174   define variable v-waitfram-action03         as character   no-undo .
      175   define variable mWaitFramTextBeg            as character   no-undo.
      176   define variable mWaitFramTextEnd            as character   no-undo.
      177   define variable mWaitFramView               as logical     no-undo.
      178   define variable mWaitProcEvent              as logical     no-undo init yes.
      179   define variable mWaitFramInterval           as integer     no-undo init 1 .
      180   define variable mWaitFramStop               as logical     no-undo.
      181   define variable mWaitFramStopUser           as logical     no-undo.
      182   define variable mWaitFramStopTimeOut        as logical     no-undo.
      183   define variable mWaitFramStartProc          as datetime-tz no-undo.
      184   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      185   define button B-WaitFramStop auto-end-key
      186        label "Стоп"
      187        size 10 by 1 tooltip "Остоновить процесс".
      188   define button B-viewProcInfo
      189        label "Информация"
      190        size 15 by 1 tooltip "Информация о процесс".
      191   define frame waitfram
      192     v-waitfram-action01 format "x(72)" no-label skip
      193     v-waitfram-action02 format "x(72)" no-label skip
      194     v-waitfram-action03 format "x(72)" no-label skip
      195     B-viewProcInfo
      196     B-WaitFramStop at row 4 col 30
      197     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      198     .
      199   define new global shared variable mBatchMode as logical no-undo init ?.
      200   define variable mFramBachModHandle as handle no-undo.
      201   mFramBachModHandle = frame waitfram:handle.
      202   define variable mFameOldVis as logical no-undo.
      203   define variable mVisCUrentVin as logical no-undo.
      204   if session:batch-mode
      205   then
      206      mBatchMode = yes.
      207   if mBatchMode = ? then do:
      208     mVisCUrentVin = current-window:visible.
      209     mFameOldVis = mFramBachModHandle:visible.
      210     mFramBachModHandle:visible  = yes.
      211     mBatchMode = mFramBachModHandle:visible ne yes.
      212     mFramBachModHandle:visible = mFameOldVis.
      213     current-window:visible = mVisCUrentVin.
      214   end.
      215    if  log-manager:logfile-name ne ?
      216     then DO:
      217         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      218         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      219         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      220     end.
      221   on choose of B-WaitFramStop in frame waitfram
      222   do:
      223     mWaitFramStop = yes.
      224     mWaitFramStopUser = yes.
      225   end.
      226   function waitfram-check-timeout returns logical():
      227      define variable vtime as int64 no-undo.
      228      if mWaitFramStopTimeOut
      229      then
      230         return yes.
      231      vtime = ( now - mWaitFramStartProc ) / 1000 .
      232      if     mWaitFramTimeOut ne ?
      233         and mWaitFramTimeOut ne 0
      234         and mWaitFramTimeOut lt vtime
      235      then do:
      236         mWaitFramStopTimeOut = yes.
      237      end.
      238      return mWaitFramStopTimeOut.
      239   end.
      240   procedure waitfram-hide :
      241     if not session:batch-mode
      242     then do
      243     on error undo, return error return-value
      244     :
      245       pause 0 before-hide .
      246       if not mBatchMode then
      247         hide frame waitfram .
      248     if     not mWaitFramView
      249        and mWaitProcEvent
      250     then
      251       process events .
      252     end.
      253   end procedure.
      254   procedure waitfram-show :
      255     define input  parameter p-message as character no-undo .
      256     define variable v-left-margin as integer   no-undo .
      257     if not session:batch-mode
      258     then do
      259     on error undo, return error return-value
      260     :
      261       if length(p-message) <= 70 then do:
      262         assign
      263           v-left-margin = integer((70 - length(p-message)) / 2)
      264         .
      265         assign
      266           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      267         .
      268         assign
      269           v-waitfram-action01 = " "
      270           v-waitfram-action02 = " "
      271                                    + fill(" ", v-left-margin)
      272                                    + p-message
      273           v-waitfram-action03 = " "
      274         .
      275       end.
      276       else do:
      277         define variable vRindex1 as integer no-undo.
      278         define variable vRindex2 as integer no-undo.
      279         vRindex1 = r-index(p-message," ",70).
      280         if vRindex1 = 0
      281         then
      282            vRindex1 = 70.
      283         if length(p-message)  <= vRindex1 + 70 then do:
      284           assign
      285             v-waitfram-action01 = " "
      286             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      287             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      288           .
      289         end.
      290         else do:
      291           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      292           if vRindex2 <= vRindex1
      293           then
      294              vRindex2 = vRindex1 + 70.
      295           assign
      296             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      297             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      298             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      299           .
      300         end.
      301       end.
      302       B-viewProcInfo:visible   in frame waitfram = no.
      303       B-viewProcInfo:sensitive in frame waitfram = no.
      304       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      305       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      306       if  (   mWaitFramView
      307          or  mWaitProcEvent)
      308          and not mBatchMode
      309       then
      310          display
      311             v-waitfram-action01 skip
      312             v-waitfram-action02 skip
      313             v-waitfram-action03 skip
      314          with frame waitfram .
      315       if     mWaitFramView
      316          then do:
      317             if     mWaitFramInterval ne ?
      318                and not mBatchMode
      319             then
      320                wait-for go of frame waitfram pause mWaitFramInterval.
      321          end.
      322          else
      323             if     mWaitProcEvent
      324                and not mBatchMode
      325             then
      326                process events .
      327     end.
      328   end procedure.
      329      procedure waitfram-show-this:
      330         define input  parameter iInterval as int64 no-undo.
      331         define variable vtime as int64 no-undo.
      332         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      333         mWaitFramInterval = iInterval.
      334         run waitfram-show (substitute("&1&2 &3&4" ,
      335                                       mWaitFramTextBeg ,
      336                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      337                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      338                                       mWaitFramTextEnd
      339                                      )
      340                           ).
      341      end.
      342      procedure WaitFramRunPause:
      343         define input  parameter iInterval as dec no-undo.
      344         define variable vStart  as datetime-tz no-undo.
      345         define variable vend    as datetime-tz no-undo.
      346         define variable vint as int64 no-undo.
      347         define variable vOk as logical no-undo.
      348         vStart = now.
      349         vend   = vStart.
      350         publish "WaitFramPause" (iInterval,output vOk).
      351         vend   =  now.
      352         vint = vend - vStart.
      353         vint = iInterval - vint / 1000.
      354         if     not mWaitFramStop
      355            and (   vint > 0
      356                 or (    not vOk
      357                     and iInterval eq ?
      358                     )
      359                 )
      360         then
      361            run waitfram-show-this (iInterval).
      362         vend   =  now.
      363         vint = vend - vStart.
      364         vint = iInterval - vint / 1000.
      365         if     not mWaitFramStop
      366            and vint > 0
      367         then do:
      368            run gbl/pause.p (vint * 1000).
      369         end.
      370         if iInterval ne ?
      371         then
      372            publish "WaitFramStop".
      373         waitfram-check-timeout().
      374      end.
      375      procedure WaitFramWaitFor:
      376         define input  parameter iInterval as dec no-undo.
      377         assign
      378            mWaitFramStartProc   = now
      379            mWaitFramStopUser    = no
      380            mWaitFramStopTimeOut = no
      381         .
      382         block-wait:
      383         do while not mWaitFramStop:
      384            run WaitFramRunPause (iInterval).
      385            if  waitfram-check-timeout()
      386            then do:
      387               leave block-wait.
      388            end.
      389         end.
      390         run waitfram-hide.
      391      end.
      392   procedure waitfram-join :
      393     define input  parameter p-line-1  as character no-undo .
      394     define input  parameter p-line-2  as character no-undo .
      395     define input  parameter p-line-3  as character no-undo .
      396     define output parameter p-message as character no-undo .
      397     do
      398     on error undo, return error return-value
      399     :
      400       assign
      401         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      402                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      403                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      404       .
      405     end.
      406   end procedure.
      407   function waitfram-join-function returns character
      408     (input p-line-1 as character
      409     ,input p-line-2 as character
      410     ,input p-line-3 as character
      411     ).
      412     define variable v-message as character no-undo .
      413     run waitfram-join in this-procedure
      414       (input  p-line-1
      415       ,input  p-line-2
      416       ,input  p-line-3
      417       ,output v-message
      418       ) .
      419     return v-message .
      420   end function .
      421   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      422   define  stream PrnLibStream.
      423   procedure prn-lib-prn-file :
      424     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      425     define input parameter p-DIsabledoptions as integer no-undo .
      426     define variable v-report-name as character no-undo .
      427     define variable v-user-action as character no-undo .
