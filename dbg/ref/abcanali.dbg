     2853   ON CHOOSE OF B-save-doc-typd IN FRAME Dialog-Frame
     2854   DO:
     2855     if not can-find (first x-abc-analysis-obj no-lock
     2856           where x-abc-analysis-obj.abc-id = x-abc-analysis.abc-id and
     2857                 x-abc-analysis-obj.db-num = x-abc-analysis.db-num  ) then do:
     2858                 message "Не выбрано ни одного объекта! Сохранить список типов документов можно после определения списка объектов." view-as alert-box information .
     2859                 return .
     2860     end.
     2861     if not can-find (first x-abc-analysis-doc no-lock
     2862           where x-abc-analysis-doc.abc-id = x-abc-analysis.abc-id and
     2863                 x-abc-analysis-doc.db-num = x-abc-analysis.db-num  ) then do:
     2864                 message "Список типов документов для сохранения пуст! Заполните список типов документов." view-as alert-box information .
     2865                 return .
     2866     end.
     2867     run waitfram-show ("Ждите...").
     2868     define variable v-list-obj as character no-undo .
     2869     define variable v-list-doc as character no-undo .
     2870     define variable v-possb-keep-string-obj as logical   no-undo .
     2871     define variable v-string-obj            as character no-undo .
     2872     define variable v-hash-string-obj       as character no-undo .
     2873     define variable v-possb-keep-string-doc as logical   no-undo .
     2874     define variable v-string-doc            as character no-undo .
     2875     define variable v-hash-string-doc       as character no-undo .
     2876     define variable v-id as integer   no-undo .
     2877     define variable v-db as integer   no-undo .
     2878     define variable v-recid as recid  no-undo .
     2879     v-list-obj = "".
     2880     for each x-abc-analysis-obj no-lock
     2881         where x-abc-analysis-obj.abc-id = x-abc-analysis.abc-id and
     2882               x-abc-analysis-obj.db-num = x-abc-analysis.db-num  :
     2883               v-list-obj = v-list-obj + x-abc-analysis-obj.obj-type + string(x-abc-analysis-obj.obj-code) + "," .
     2884     end.
     2885     v-list-doc = "".
     2886     for each x-abc-analysis-doc no-lock
     2887         where x-abc-analysis-doc.abc-id = x-abc-analysis.abc-id and
     2888               x-abc-analysis-doc.db-num = x-abc-analysis.db-num  :
     2889               v-list-doc = v-list-doc + x-abc-analysis-doc.abcd-ext-doc-type  + "," .
     2890     end.
     2891     run find-from-hash  (
     2892        input v-list-obj
     2893       ,input "doc-abc-def"
     2894       ,input "doad-possb-keep-string-obj"
     2895       ,input "doad-string-obj"
     2896       ,input "doad-hash-string-obj"
     2897       ,input "doc-abc-def-obj"
     2898       ,output v-recid
     2899       ).
     2900     run update-doc-def (
     2901        input v-recid
     2902       ,input v-list-obj
     2903       ,input v-list-doc
     2904       ).
     2905     run waitfram-hide in this-procedure .
     2906   END.
     2907   ON CHOOSE OF B-save-rang IN FRAME Dialog-Frame
     2908   DO:
     2909     if not can-find (first x-abc-analysis-obj no-lock
     2910           where x-abc-analysis-obj.abc-id = x-abc-analysis.abc-id and
     2911                 x-abc-analysis-obj.db-num = x-abc-analysis.db-num  ) then do:
     2912                 message "Не выбрано ни одного объекта! Сохранить ранжирование можно после определения списка объектов." view-as alert-box information .
     2913                 return .
