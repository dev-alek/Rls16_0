     1939   procedure thbjattr_value :
     1940   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
     1941   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
     1942   define input  parameter p-upper-code like ub.thbj-attr.upper-prop-code  no-undo .
     1943   define input  parameter p-code     like ub.thbj-attr.prop-code  no-undo .
     1944   define output parameter p-value-character like ub.thbj-attr.property-value-character no-undo .
     1945   define output parameter p-value-date    like ub.thbj-attr.property-value-date no-undo .
     1946   define output parameter p-value-decimal like ub.thbj-attr.property-value-decimal no-undo .
     1947   define output parameter p-value-integer like ub.thbj-attr.property-value-integer no-undo .
     1948   define output parameter p-value-logical like ub.thbj-attr.property-value-logical no-undo .
     1949   define output parameter p-type     as character no-undo .
     1950   define output parameter p-found as decimal no-undo .
     1951   do
     1952   on error undo, return error return-value
     1953   :
     1954       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_value in g#attr-lib
     1955       (input  p-obj-type
     1956       ,input  p-obj-code
     1957       ,input  p-upper-code
     1958       ,input  p-code
     1959       ,output p-value-character
     1960       ,output p-value-date
     1961       ,output p-value-decimal
     1962       ,output p-value-integer
     1963       ,output p-value-logical
     1964       ,output p-type
     1965       ,output p-found
     1966       ) no-error .
     1967     if error-status :error
     1968     then do:
     1969       undo, return error return-value .
     1970     end.
     1971   end.
     1972   end procedure.
     1973   procedure thbjattr_get-section :
     1974   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
     1975   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
     1976   define input  parameter p-upper-param-code  like ub.thbj-attr.upper-prop-code  no-undo .
     1977   define input  parameter p-mode as character no-undo .
     1978   define input-output parameter table-handle p-tth.
     1979   define output parameter p-all-found as decimal no-undo .
     1980   do
     1981   on error undo, return error return-value
     1982   :
     1983       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_get-section in g#attr-lib
     1984       (input  p-obj-type
     1985       ,input  p-obj-code
     1986       ,input  p-upper-param-code
     1987       ,input  p-mode
     1988       ,input-output table-handle p-tth
     1989       ,output p-all-found
     1990       ) no-error .
     1991     if error-status :error
     1992     then do:
     1993       delete object p-tth.
     1994       undo, return error return-value .
     1995     end.
     1996     delete object p-tth.
     1997   end.
     1998   end procedure.
