     3512             (input  v-cntxt-db-num
     3513             ,input  v-cntxt-userid
     3514             ,input  v-diasize-proc-name
     3515             ,input  'height':u
     3516             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3517             ) .
     3518         end.
     3519       end.
     3520     end.
     3521     assign
     3522       v-diasize-change-size = false
     3523     .
     3524   end procedure.
     3525   procedure diasize_set-height :
     3526     define input  parameter p-new-height  as decimal   no-undo .
     3527     define input  parameter p-move-resize as logical   no-undo .
     3528     do
     3529     on error undo, return error return-value
     3530     :
     3531       run diasize_change-height in this-procedure
     3532         (input  (p-new-height - frame Dialog-Frame :height)
     3533         ,input  p-move-resize
     3534         ) .
     3535     end.
     3536   end procedure.
     3537   procedure diasize_change-width :
     3538     define input  parameter p-change-value as decimal   no-undo .
     3539     define input  parameter p-move-resize  as logical   no-undo .
     3540     define variable v-field-group-handle   as handle    no-undo .
     3541     define variable v-object-handle        as handle    no-undo .
     3542     define variable v-frame-width          as decimal   no-undo .
     3543     define variable v-frame-virtual-width  as decimal   no-undo .
     3544     define variable v-browse-width         as decimal   no-undo .
     3545     define variable v-window-width         as decimal   no-undo .
     3546     define variable v-window-virtual-width as decimal   no-undo .
     3547     define variable v-change-sign          as integer   no-undo .
     3548     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3549     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3550     if p-change-value > 0
     3551     then do:
     3552       if frame Dialog-Frame :width + p-change-value >
     3553           session :width-chars
     3554       then do:
     3555         assign
     3556           p-change-value = session :width-chars - frame Dialog-Frame :width
     3557         .
     3558         if p-change-value <= 0
     3559         then do:
     3560           run diasize_position-resize-button in this-procedure .
     3561           return .
     3562         end.
     3563       end.
     3564     end.
     3565     if p-change-value < 0
     3566     then do:
     3567       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3568       then do:
     3569         assign
     3570           p-change-value = v-diasize-orig-frame-width
     3571                          - frame Dialog-Frame :width
     3572         .
     3573         if p-change-value >= 0
     3574         then do:
     3575           run diasize_position-resize-button in this-procedure .
     3576           return .
     3577         end.
     3578       end.
     3579     end.
     3580     if p-change-value >= 0
     3581     then do:
     3582       assign
     3583         v-change-sign = 1
     3584       .
     3585     end.
     3586     else do:
     3587       assign
     3588         v-change-sign = -1
     3589       .
     3590     end.
     3591     assign
     3592       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3593     .
     3594     if p-change-value = 0
     3595     then do:
     3596       run diasize_position-resize-button in this-procedure .
     3597       return .
     3598     end.
     3599     move_block:
     3600     do
     3601     on error undo move_block, leave move_block
     3602     :
     3603       if retry
     3604       then do:
     3605         do
     3606         on error undo move_block, leave move_block
     3607         :
     3608           if p-change-value > 0
     3609           then do:
     3610             for each buf_temp-diasize-handle
     3611             on error undo, next
     3612             :
     3613               assign
     3614                 v-object-handle = buf_temp-diasize-handle.handle-value
     3615               .
     3616               if v-object-handle <> v-diasize-resize-button
     3617               then do:
     3618                 assign
     3619                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3620                 .
     3621               end.
     3622             end.
     3623             assign
     3624               v-diasize-browse-handle :width = v-browse-width
     3625             .
     3626             for each buf_temp-browse-handle
     3627               where buf_temp-browse-handle.browse-type = 'width':u
     3628             on error undo, next
     3629             :
     3630               assign
     3631                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3632               .
     3633             end.
     3634             assign
     3635               frame Dialog-Frame :width = v-frame-width
     3636             .
     3637             if frame Dialog-Frame :scrollable = true
     3638             then do:
     3639               assign
     3640                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3641               .
     3642             end.
     3643             run diasize_position-resize-button in this-procedure .
     3644           end.
     3645           else do:
     3646             if frame Dialog-Frame :scrollable = true
     3647             then do:
     3648               assign
     3649                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3650               .
     3651             end.
     3652             assign
     3653               frame Dialog-Frame :width = v-frame-width
     3654             .
     3655             for each buf_temp-browse-handle
     3656               where buf_temp-browse-handle.browse-type = 'width':u
     3657             on error undo, next
     3658             :
     3659               assign
     3660                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3661               .
     3662             end.
     3663             assign
     3664               v-diasize-browse-handle :width = v-browse-width
     3665             .
     3666             for each buf_temp-diasize-handle
     3667             on error undo, next
     3668             :
