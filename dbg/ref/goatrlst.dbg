      623   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      624   def
      625    shared
      626   temp-table  obj-list no-undo
      627     field obj-type like ub.clients.obj-type
      628     field obj-code like ub.clients.obj-code
      629     field obj-name like ub.clients.obj-name
      630     field obj-id   as integer
      631     field db-num   as integer
      632     index pi is primary unique obj-id
      633     index ie1 obj-type obj-code
      634     index ie2 obj-name
      635   .
      636   procedure create_obj-list :
      637      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      638      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      639      do
      640      on error undo, return error return-value
      641      :
      642         define buffer cli-obj for ub.clients .
      643         define variable p-var as integer no-undo .
      644         define buffer buf_obj-list for obj-list .
      645         find last buf_obj-list  use-index pi no-error .
      646         if available buf_obj-list
      647         then
      648            p-var = buf_obj-list.obj-id + 1.
      649         else
      650            p-var = 1.
      651         find first cli-obj where
      652                   cli-obj.obj-type = p-obj-type
      653               and cli-obj.obj-code = p-obj-code
      654         no-lock no-error.
      655         if available cli-obj
      656         then do:
      657            create buf_obj-list.
      658            assign
      659               buf_obj-list.obj-id   = p-var
      660               buf_obj-list.obj-code = cli-obj.obj-code
      661               buf_obj-list.obj-type = cli-obj.obj-type
      662               buf_obj-list.obj-name = cli-obj.obj-name
      663               buf_obj-list.db-num   = cli-obj.db-num
      664            .
      665         end.
      666      end.
      667   end.
      668   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      669     define variable v-cntxt-db-num        as integer   no-undo .
      670     define variable v-cntxt-userid        as character no-undo .
      671     define variable v-cntxt-level         as character no-undo .
      672     define variable v-cntxt-host-code-obj as integer   no-undo .
      673     define variable v-cntxt-obj-type      as character no-undo .
      674     define variable v-cntxt-obj-code      as integer   no-undo .
      675     define variable v-cntxt-db-num-obj    as integer   no-undo .
      676     define variable v-cntxt-is-admin      as logical   no-undo .
      677   define variable parhost-code like ub.sysconf.host-code no-undo .
      678   define variable parobj-type like ub.clients.obj-type no-undo .
      679   define variable parobj-code like ub.clients.obj-code no-undo .
      680   define variable pardelete-ok as logical no-undo .
      681   DEFINE VARIABLE var-object as character no-undo init 'gds-obj-attr':U.
      682   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      683   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
      684   def var vl_bin as char no-undo init "".
      685   if vl_int < 0 OR vl_int = ? then return ?.
      686   do while vl_int > 0:
      687     assign
      688     vl_bin = (if vl_int modulo 2 = 0
      689                 then "0":U
      690                 else "1":U) + vl_bin
      691     vl_int = truncate(vl_int / 2,0).
      692   end.
      693   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
      694   END FUNCTION.
      695   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
      696                                    input vl_binm as character):
      697   DEFINE VARIABLE vl_bin as character no-undo.
      698   DEFINE VARIABLE ii as integer no-undo.
      699   DEFINE VARIABLE ii-len as integer no-undo.
      700   DEFINE VARIABLE ii-lenm as integer no-undo.
      701   DEFINE VARIABLE mchar as character no-undo.
      702   DEFINE VARIABLE ichar as character no-undo.
      703   if vl_binm = ? then return ?.
      704   vl_bin = CIntBinS(vl_int).
      705   if vl_bin = ? then return ?.
      706   assign
      707   vl_binm = LEFT-TRIM(vl_binm, "X":U)
      708   ii-lenm = LENGTH(vl_binm)
      709   ii-len = LENGTH(vl_bin) - ii-lenm
      710   .
      711   if II-LENM > 32 THEN RETURN ?.
      712   DO II = 1 to II-LENm:
      713     assign
      714     mchar = SUBSTR(vl_binm, ii, 1)
      715     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
      716     .
      717     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
      718     IF ichar <> mchar AND mchar <> "X":U then return no.
      719   END.
      720   return yes.
      721   END FUNCTION.
      722   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      723   define SHARED temp-table temp-attr no-undo
      724   field attr-code like ub.gds-obj-attr.attr-code
      725   field attr-value like ub.gds-obj-attr.attr-value
      726   field host-code as integer
      727   field obj-type as character
      728   field obj-code as integer
      729   field user-can-edit as log
      730   field code as char
      731   field action as logical
      732   field other-inf as character
      733   index pi is  unique primary
      734   attr-code host-code obj-type obj-code ASCENDING
      735   index action
      736   action
      737   .
      738   procedure tempattr-value :
      739    do
      740     on error undo, return error
      741     :
      742       define input  parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
      743       define input  parameter p-host-code as integer no-undo .
      744       define input  parameter p-obj-type as character no-undo .
      745       define input  parameter p-obj-code as integer no-undo .
      746       define input  parameter p-mode      as character no-undo .
      747       define output parameter p-value    like ub.gds-obj-attr.attr-value no-undo .
      748       define output parameter p-type     as character no-undo .
      749       define buffer buf_temp-attr for temp-attr .
      750       define variable v-format         as character no-undo .
      751       define variable v-label          as character no-undo .
      752       define variable v-user-can-edit  as logical   no-undo .
      753       define variable v-output-display as logical   no-undo .
      754       define variable v-other          as character no-undo .
      755       define variable v-range          as integer   no-undo .
      756       define variable jj               as integer   no-undo .
      757       define variable v-spr            as logical   no-undo .
      758       define variable v-spr-name       as character no-undo .
      759       define variable v-spr-param      as character no-undo .
      760       define variable v-setted         as logical   no-undo .
      761       case var-object:
      762         when 'gds-obj-attr':U
      763         then do:
      764           run gdsoattr-name in this-procedure
      765             (input  p-code
      766             ,output p-type
      767             ,output v-format
      768             ,output v-label
      769             ,output v-user-can-edit
      770             ,output v-output-display
      771             ,output v-other
      772             ) no-error .
      773         end.
      774         when 'gds-host-attr':U
      775         then do:
      776           run gdshattr-name in this-procedure
      777             (input  p-code
      778             ,output p-type
      779             ,output v-format
      780             ,output v-label
      781             ,output v-user-can-edit
      782             ,output v-output-display
      783             ,output v-other
      784             ) no-error .
      785         end.
      786         when 'clients-attr':U
      787         then do:
      788           run clntattr-code in this-procedure
      789             (input  p-code
      790             ,output p-type
      791             ,output v-format
      792             ,output v-label
      793             ,output v-user-can-edit
      794             ,output v-output-display
      795             ,output v-other
      796             ) no-error .
      797         end.
      798         when 'goods-attr':U
      799         then do:
      800           run gds-attr-name in this-procedure
      801             (input  p-code
      802             ,output p-type
      803             ,output v-format
      804             ,output v-label
      805             ,output v-user-can-edit
      806             ,output v-output-display
      807             ,output v-other
      808             ) no-error .
      809         end.
      810         otherwise do:
      811           undo, return error .
      812         end.
      813       end case.
      814       if error-status :error
      815       then do:
      816         undo, return error return-value .
      817       end.
      818       if v-user-can-edit
      819       then do:
      820         do jj = 1 to num-entries(v-other, chr(47)):
      821           if entry(1, entry(jj, v-other, chr(47)), "=":U) = "spr":U then do:
      822             assign
      823             v-spr-name = entry(2, entry(jj, v-other, chr(47)), "=":U)
      824             .
      825           end.
      826           if entry(1, entry(jj, v-other, chr(47)), "=":U) = "spr-param":U then do:
      827             assign
      828             v-spr-param = entry(2, entry(jj, v-other, chr(47)), "=":U)
      829             .
      830           end.
      831        end.
      832         if v-spr-name <> "":U then do:
      833           if p-mode = "change":U
      834           then do:
      835             find first buf_temp-attr no-lock where
      836                       buf_temp-attr.attr-code = p-code
      837                   and buf_temp-attr.host-code = p-host-code
      838                   and buf_temp-attr.obj-type = p-obj-type
      839                   and buf_temp-attr.obj-code = p-obj-code
      840               no-error .
      841             if avail buf_temp-attr then do:
      842               assign
      843                 p-value =  buf_temp-attr.attr-value
      844               .
      845             end.
      846             else do:
      847               assign
      848                 p-value = if p-type = 'L':U then "no":U else ""
      849               .
      850             end.
      851           end.
      852           CASE var-object:
      853             when 'gds-obj-attr':U then do:
      854               if v-spr-param = "":U then do:
      855                 run value (
      856                             v-spr-name)
      857                             in this-procedure (
      858                                                   input 0
      859                                                 ,input parobj-type
      860                                                 ,input parobj-code
      861                                                 ,input-output p-value
      862                                                 ,output v-setted) no-error .
      863               end.
      864               else do:
      865                 run value (
      866                             v-spr-name)
      867                             in this-procedure (
      868                                                   input 0
      869                                                 ,input parobj-type
      870                                                 ,input parobj-code
      871                                                 ,input v-spr-param
      872                                                 ,input-output p-value
      873                                                 ,output v-setted) no-error .
      874               end.
      875               if error-status :error then do:
      876                 undo, return error "Неизвестный справочник для получения значения атрибут товара на объекте" + " " + p-code .
      877               end.
      878             end.
      879             when 'clients-attr':U then do:
      880             if v-spr-param = "":U then do:
      881               run   value ( v-spr-name ) in this-procedure
      882                   (  input 0
      883                     ,input parobj-type
      884                     ,input parobj-code
      885                     ,input-output p-value
      886                     ,output v-setted )
      887                     no-error .
      888             end.
      889             end.
      890             END CASE.
      891           if v-setted = no then do:
      892             return "not-set":U.
      893           end.
      894           assign
      895           v-spr = yes
      896           .
      897         end.
      898       end.
      899       if not v-spr then do:
      900         find first buf_temp-attr no-lock where
      901                   buf_temp-attr.attr-code = p-code
      902               and buf_temp-attr.host-code = p-host-code
      903               and buf_temp-attr.obj-type = p-obj-type
      904               and buf_temp-attr.obj-code = p-obj-code
      905           no-error .
      906         if avail buf_temp-attr then do:
      907           assign
      908             p-value =  buf_temp-attr.attr-value
      909           .
      910         end.
      911         else do:
      912           assign
      913             p-value = if p-type = 'L':U then "no":U else ""
      914           .
      915         end.
      916       end.
      917     end.
      918   end procedure.
      919   procedure tempattr-write :
      920     do
      921     on error undo, return error
      922     :
      923       define input parameter p-add      as logical no-undo .
      924       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
      925       define input parameter p-host-code as integer no-undo .
      926       define input parameter p-obj-type as character no-undo .
      927       define input parameter p-obj-code as integer no-undo .
      928       define input parameter p-value    like ub.gds-obj-attr.attr-value no-undo .
      929       define input parameter p-action   like temp-attr.action no-undo .
      930       define buffer buf_temp-attr for temp-attr .
      931       define variable v-type           as character no-undo .
      932       define variable v-format         as character no-undo .
      933       define variable v-label          as character no-undo .
      934       define variable v-user-can-edit  as logical   no-undo .
      935       define variable v-output-display as logical   no-undo .
      936       define variable v-other          as character no-undo .
      937       define variable v-range          as integer   no-undo .
      938       define variable var-region  as character no-undo.
      939       DEFINE VARIABLE v-sel-vals as character no-undo .
      940       DEFINE VARIABLE v-sel-labels as character no-undo .
      941       define variable varhost-code like ub.sysconf.host-code no-undo.
      942       define variable varobj-type like ub.clients.obj-type no-undo.
      943       define variable varobj-code like ub.clients.obj-code no-undo.
      944       define variable choice as integer no-undo .
      945       case var-object:
      946         when 'gds-obj-attr':U
      947         then do:
      948           run gdsoattr-name in this-procedure
      949             (input  p-code
      950             ,output v-type
      951             ,output v-format
      952             ,output v-label
      953             ,output v-user-can-edit
      954             ,output v-output-display
      955             ,output v-other
      956             ) no-error .
      957         end.
      958         when 'gds-host-attr':U
      959         then do:
      960           run gdshattr-name in this-procedure
      961             (input  p-code
      962             ,output v-type
      963             ,output v-format
      964             ,output v-label
      965             ,output v-user-can-edit
      966             ,output v-output-display
      967             ,output v-other
      968             ) no-error .
      969         end.
      970         when 'clients-attr':U
      971         then do:
      972           run clntattr-code in this-procedure
      973             (input  p-code
      974             ,output v-type
      975             ,output v-format
      976             ,output v-label
      977             ,output v-user-can-edit
      978             ,output v-output-display
      979             ,output v-other
      980             ) no-error .
      981         end.
      982         when 'goods-attr':U
      983         then do:
      984           run gds-attr-name in this-procedure
      985             (input  p-code
      986             ,output v-type
      987             ,output v-format
      988             ,output v-label
      989             ,output v-user-can-edit
      990             ,output v-output-display
      991             ,output v-other
      992             ) no-error .
      993         end.
      994         otherwise do:
      995           undo, return error .
      996         end.
      997       END CASE.
      998       if error-status :error then do:
      999         undo, return error return-value .
     1000       end.
     1001       if not v-user-can-edit then do:
     1002         message
     1003         "Запрещено редактировать атрибут" v-label
     1004         view-as alert-box error .
     1005         undo, return error.
     1006       end.
     1007       find first buf_temp-attr exclusive-lock where
     1008                  buf_temp-attr.attr-code = p-code
     1009               and buf_temp-attr.host-code = p-host-code
     1010               and buf_temp-attr.obj-type = p-obj-type
     1011               and buf_temp-attr.obj-code = p-obj-code no-error .
     1012       if not available buf_temp-attr then do:
     1013         create buf_temp-attr .
     1014         assign
     1015           buf_temp-attr.attr-code = p-code
     1016           buf_temp-attr.host-code = p-host-code
     1017           buf_temp-attr.obj-type = p-obj-type
     1018           buf_temp-attr.obj-code = p-obj-code
     1019           buf_temp-attr.attr-value = p-value
     1020           buf_temp-attr.action = p-action
     1021           buf_temp-attr.code = v-label
     1022           buf_temp-attr.other-inf = v-other
     1023           no-error
     1024         .
     1025       end.
     1026       ELSE
     1027       ASSIGN
     1028       buf_temp-attr.attr-value = p-value no-error.
     1029     end.
     1030   end procedure.
     1031   procedure tempattr-exist :
     1032     do
     1033     on error undo, return error
     1034     :
     1035       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
     1036       define input parameter p-host-code as integer no-undo .
     1037       define input parameter p-obj-type as character no-undo .
     1038       define input parameter p-obj-code as integer no-undo .
     1039       define output parameter p-exist    as logical no-undo .
     1040       define output parameter p-action as logical no-undo .
     1041       define buffer buf_temp-attr for temp-attr .
     1042       define variable v-type           as character no-undo .
     1043       define variable v-format         as character no-undo .
     1044       define variable v-label          as character no-undo .
     1045       define variable v-user-can-edit  as logical   no-undo .
     1046       define variable v-output-display as logical   no-undo .
     1047       define variable v-other          as character no-undo .
     1048       define variable v-range          as integer   no-undo .
     1049       case var-object:
     1050         when 'gds-obj-attr':U then do:
     1051           run gdsoattr-name in this-procedure
     1052             (input  p-code
     1053             ,output v-type
     1054             ,output v-format
     1055             ,output v-label
     1056             ,output v-user-can-edit
     1057             ,output v-output-display
     1058             ,output v-other
     1059             ) no-error .
     1060         end.
     1061         when 'gds-host-attr':U
     1062         then do:
     1063           run gdshattr-name in this-procedure
     1064             (input  p-code
     1065             ,output v-type
     1066             ,output v-format
     1067             ,output v-label
     1068             ,output v-user-can-edit
     1069             ,output v-output-display
     1070             ,output v-other
     1071             ) no-error .
     1072         end.
     1073         when 'clients-attr':U
     1074         then do:
     1075           run clntattr-code in this-procedure
     1076             (input  p-code
     1077             ,output v-type
     1078             ,output v-format
     1079             ,output v-label
     1080             ,output v-user-can-edit
     1081             ,output v-output-display
     1082             ,output v-other
     1083             ) no-error .
     1084         end.
     1085         when 'goods-attr':U then do:
     1086           run gds-attr-name in this-procedure
     1087             (input  p-code
     1088             ,output v-type
     1089             ,output v-format
     1090             ,output v-label
     1091             ,output v-user-can-edit
     1092             ,output v-output-display
     1093             ,output v-other
     1094             ) no-error .
     1095         end.
     1096         otherwise do:
     1097           undo, return error .
     1098         end.
     1099       end case.
     1100       if error-status :error
     1101       then do:
     1102         undo, return error return-value .
     1103       end.
     1104       find first buf_temp-attr no-lock where
     1105                  buf_temp-attr.attr-code = p-code
     1106               and buf_temp-attr.host-code = p-host-code
     1107               and buf_temp-attr.obj-type = p-obj-type
     1108               and buf_temp-attr.obj-code = p-obj-code no-error .
     1109       if available buf_temp-attr then do:
     1110         P-EXIST = YES.
     1111         p-action = buf_temp-attr.action.
     1112       end.
     1113     end.
     1114   end procedure.
     1115   procedure tempattr-delete :
     1116     do
     1117     on error undo, return error
     1118     :
     1119       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
     1120       define input parameter p-host-code as integer no-undo .
     1121       define input parameter p-obj-type as character no-undo .
     1122       define input parameter p-obj-code as integer no-undo .
     1123       define output parameter p-deleted  as logical no-undo .
     1124       define buffer buf_temp-attr for temp-attr .
     1125       define variable v-type           as character no-undo .
     1126       define variable v-format         as character no-undo .
     1127       define variable v-label          as character no-undo .
     1128       define variable v-user-can-edit  as logical   no-undo .
     1129       define variable v-output-display as logical   no-undo .
     1130       define variable v-other          as character no-undo .
     1131       define variable v-range          as integer   no-undo .
     1132       case var-object:
     1133         when 'gds-obj-attr':U
     1134         then do:
     1135           run gdsoattr-name in this-procedure
     1136             (input  p-code
     1137             ,output v-type
     1138             ,output v-format
     1139             ,output v-label
     1140             ,output v-user-can-edit
     1141             ,output v-output-display
     1142             ,output v-other
     1143             ) no-error .
     1144         end.
     1145         when 'gds-host-attr':U
     1146         then do:
     1147           run gdshattr-name in this-procedure
     1148             (input  p-code
     1149             ,output v-type
     1150             ,output v-format
     1151             ,output v-label
     1152             ,output v-user-can-edit
     1153             ,output v-output-display
     1154             ,output v-other
     1155             ) no-error .
     1156         end.
     1157         when 'clients-attr':U
     1158         then do:
     1159           run clntattr-code in this-procedure
     1160             (input  p-code
     1161             ,output v-type
     1162             ,output v-format
     1163             ,output v-label
     1164             ,output v-user-can-edit
     1165             ,output v-output-display
     1166             ,output v-other
     1167             ) no-error .
     1168         end.
     1169         when 'goods-attr':U
     1170         then do:
     1171           run gds-attr-name in this-procedure
     1172             (input  p-code
     1173             ,output v-type
     1174             ,output v-format
     1175             ,output v-label
     1176             ,output v-user-can-edit
     1177             ,output v-output-display
     1178             ,output v-other
     1179             ) no-error .
     1180         end.
     1181         otherwise do:
     1182           undo, return error .
     1183         end.
     1184       END CASE.
     1185       if error-status :error then do:
     1186         undo, return error return-value .
     1187       end.
     1188       find first buf_temp-attr exclusive-lock where
     1189                  buf_temp-attr.attr-code = p-code
     1190               and buf_temp-attr.host-code = p-host-code
     1191               and buf_temp-attr.obj-type = p-obj-type
     1192               and buf_temp-attr.obj-code = p-obj-code no-error .
     1193       if not available buf_temp-attr then do:
     1194         P-DELETED = NO.
     1195       end.
     1196       ELSE DO:
     1197          delete buf_temp-attr.
     1198          P-DELETED = YES.
     1199       END.
     1200     end.
     1201   end procedure.
     1202   define variable v-no-ask as logical no-undo .
     1203   define variable v-view-log as logical no-undo .
     1204   define variable log-file-name                as character      no-undo init "goatrlst.txt".
     1205   define variable v-stop                       as logical        no-undo .
     1206   define variable v-choice as integer no-undo .
     1207   DEFINE VARIABLE num-rec as integer no-undo .
     1208   DEFINE VARIABLE num-rec-ok as integer no-undo .
     1209   DEFINE VARIABLE num-rec-all as integer no-undo .
     1210   DEFINE VARIABLE num-rec-ok-all as integer no-undo .
     1211   define variable v-host-code as integer no-undo .
     1212   define variable v-mes as character no-undo .
     1213   define variable v-ok as logical no-undo .
     1214   assign
     1215   parhost-code = integer(entry(1, p-parameter, chr(4)))
     1216   parobj-type  = entry(2, p-parameter, chr(4))
     1217   parobj-code = integer(entry(3, p-parameter, chr(4)))
     1218   pardelete-ok = logical(entry(4, p-parameter, chr(4)))
     1219   no-error
     1220   .
     1221   if error-status:error then do:
     1222    run write-log-and-file in p-log-handle (
     1223           input 1
     1224         , input log-file-name
     1225         , input 1
     1226         , input substitute("Ошибка входных параметров &1:&2&3&4"
     1227                            , p-parameter
     1228                            , chr(10)
     1229                            , error-status:get-message(1)
     1230                            , return-value
     1231                            )).
     1232     assign
     1233     v-view-log = yes.
     1234   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1235   if v-view-log
     1236   and not g#news
     1237   and not g#auto
     1238   then do:
     1239     message
     1240     '!!!При изменении атрибутов товара на объекте по списку товаров произошли ошибки!!!'  skip
     1241     "!!!Внимательно прочитайте Log-file!!"
     1242     view-as alert-box error .
     1243        define variable v-user-action8   as character no-undo .
     1244     define variable v-printed8       as logical   no-undo .
     1245     run gbl/prnfilen.w
     1246       (input  ('!!!При изменении атрибутов товара на объекте по списку товаров произошли ошибки!!!')
     1247       ,input  0
     1248       ,input  (string("./":U) + 'goatrlst.txt')
     1249       ,input  7
     1250       ,output v-user-action8
     1251       ,output v-printed8
     1252       ) .
     1253   end.
     1254   if v-view-log = true
     1255   and (g#news
     1256   or g#auto)
     1257   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     1258   then do:
     1259      run cb_set-view-log in p-parent-handle ( input yes).
     1260   end.
     1261   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     1262     OS-DELETE value(string("./":U) + 'goatrlst.txt').
     1263   end.
     1264     return .
     1265   end.
     1266   for each obj-list
     1267   break
     1268   by obj-list.obj-type
     1269   by obj-list.obj-code
     1270   :
     1271   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1272   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1273     (input  obj-list.obj-type
     1274     ,input  obj-list.obj-code
     1275     ,output v-host-code
     1276     )  .
     1277   assign
     1278   parhost-code = v-host-code
     1279   parobj-type  = obj-list.obj-type
     1280   parobj-code = obj-list.obj-code
     1281   .
     1282   run write-log  in p-log-handle(
     1283                                    input 0
     1284                                  , "&DLine").
     1285   run write-log-and-file in p-log-handle (
     1286         input 1
     1287       , input log-file-name
     1288       , input 1
     1289       , input substitute("Изменение атрибутов товара на объекте &1&2 по списку товаров", parobj-type, parobj-code)).
     1290   assign
     1291   num-rec = 0
     1292   num-rec-ok = 0
     1293   .
     1294   _gds-list:
     1295   for each gds-list
     1296     ON ERROR undo, NEXT:
     1297       num-rec = num-rec + 1.
     1298       num-rec-all = num-rec-all + 1.
     1299       v-ok = false.
     1300       run check-actg in this-procedure ( input gds-list.grp-code
     1301                                         ,input gds-list.gds-code
     1302                                         ,input parobj-code
     1303                                         ,input parobj-type
     1304                                         ,output v-ok ) no-error .
     1305       if v-ok = true then do :
     1306         run do-changes in this-procedure (
     1307                                           input gds-list.gds-code
     1308                                           ,input parobj-type
     1309                                           ,input parobj-code) no-error .
     1310       end.
     1311       if error-status:error then do:
     1312         run write-log-and-file in p-log-handle (
     1313                   input 1
     1314                 , input log-file-name
     1315                 , input 1
     1316                 , input return-value
     1317                                             ).
     1318         assign
     1319         v-view-log = yes.
     1320         if v-no-ask  then do:
     1321           run gbl/d-askw.w (
     1322                         input "Изменение атрибутов товара на объекте по списку товаров"
     1323                         ,input substitute("Товар с кодом &1 &2&3 - не удалось провести изменение атрибутов товара на объекте"
     1324                                         , gds-list.gds-code
     1325                                         , parobj-type
     1326                                         , parobj-code
     1327                                         )
     1328                         ,input "|"
     1329                         ,input ("Продолжить|" +
     1330                               "Продолжить и больше не запрашивать подтверждения на продолжение|" +
     1331                               "Прекратить")
     1332                         ,input "||"
     1333                         ,input 1
     1334                         ,input 3
     1335                         ,output v-choice).
     1336           if v-choice = 3 then do:
     1337             leave.
     1338           end.
     1339           if v-choice = 2 then do:
     1340             assign
     1341             v-no-ask = yes.
     1342           end.
     1343         end.
     1344       end.
     1345       else do:
     1346         num-rec-ok = num-rec-ok + 1.
     1347         num-rec-ok-all = num-rec-ok-all + 1.
     1348         if pardelete-ok
     1349         and last(obj-list.obj-type)
     1350         and last(obj-list.obj-code) then do:
     1351           delete gds-list.
     1352         end.
     1353       end.
     1354       run show-counter in p-log-handle .
     1355       run write-counter in p-log-handle (substitute("Обработано &1 по &3&4 из них успешно &2"
     1356                                                   , num-rec
     1357                                                   , num-rec-ok
     1358                                                   , obj-list.obj-type
     1359                                                   , obj-list.obj-code
     1360                                                   )) no-error.
     1361       run get-stop-state in p-log-handle (
     1362           output v-stop
     1363       ).
     1364       if v-stop then do:
     1365         leave _gds-list.
     1366       end.
     1367   END.
     1368   run write-log-and-file in p-log-handle (
     1369         input 1
     1370       , input log-file-name
     1371       , input 1
     1372       , input substitute("Пакетное изменение атрибутов по &3&4: из &1 товаров успешно изменено &2"
     1373                         , num-rec
     1374                         , num-rec-ok
     1375                         , obj-list.obj-type
     1376                         , obj-list.obj-code
     1377                         )).
     1378   end.
     1379   run write-log  in p-log-handle(
     1380                                    input 0
     1381                                  , "&DLine").
     1382   run write-log-and-file in p-log-handle (
     1383         input 1
     1384       , input log-file-name
     1385       , input 1
     1386       , input substitute("Пакетное изменение атрибутов по списку товаров по списку объектов завершено:&3 из &1 успешно изменено &2"
     1387                         , num-rec-all, num-rec-ok-all
     1388                         ,chr(10)
     1389                         )).
     1390   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1391   if v-view-log
     1392   and not g#news
     1393   and not g#auto
     1394   then do:
     1395     message
     1396     '!!!При изменении атрибутов товара на объекте по списку товаров произошли ошибки!!!'  skip
     1397     "!!!Внимательно прочитайте Log-file!!"
     1398     view-as alert-box error .
     1399        define variable v-user-action11   as character no-undo .
     1400     define variable v-printed11       as logical   no-undo .
     1401     run gbl/prnfilen.w
     1402       (input  ('!!!При изменении атрибутов товара на объекте по списку товаров произошли ошибки!!!')
     1403       ,input  0
     1404       ,input  (string("./":U) + 'goatrlst.txt')
     1405       ,input  7
     1406       ,output v-user-action11
     1407       ,output v-printed11
     1408       ) .
     1409   end.
     1410   if v-view-log = true
     1411   and (g#news
     1412   or g#auto)
     1413   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     1414   then do:
     1415      run cb_set-view-log in p-parent-handle ( input yes).
     1416   end.
     1417   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     1418     OS-DELETE value(string("./":U) + 'goatrlst.txt').
     1419   end.
     1420   procedure do-changes :
     1421   define input parameter pargds-code like ub.gds-obj.gds-code no-undo .
     1422   define input parameter parobj-type like ub.clients.obj-type no-undo .
     1423   define input parameter parobj-code like ub.clients.obj-code no-undo .
     1424   DEFINE VARIABLE loc#log as logical no-undo .
     1425   DEFINE VARIABLE var-deleted as logical no-undo .
     1426   define variable v-check as character no-undo .
     1427   define variable v-correct as logical no-undo .
     1428   define variable v-error-code as character no-undo .
     1429   define variable jj as integer no-undo .
     1430       _main:
     1431     do
     1432     on error undo, return error
     1433     :
     1434       _temp-attr:
     1435       for each temp-attr no-lock
     1436           on error undo _main, return error:
     1437         do jj = 1 to num-entries(temp-attr.other-inf, chr(47)):
     1438           if entry(1, entry(jj, temp-attr.other-inf, chr(47)), "=":U) = "check-ext":U then do:
     1439             assign
     1440             v-check = string(entry(2, entry(jj, temp-attr.other-inf, chr(47)), "=":U))
     1441             .
     1442           end.
     1443         end.
     1444         if v-check <> "":U then do:
     1445           assign
     1446           v-correct = no
     1447           v-error-code = "":U.
     1448           run value(v-check)(
     1449                             input pargds-code
     1450                             ,input parobj-type
     1451                             ,input parobj-code
     1452                             ,input attr-value
     1453                             ,input (if temp-attr.action = yes then 'ИЗМЕНЕНИЕ':U else 'удаление':U)
     1454                             ,output v-correct
     1455                             ,output v-error-code) no-error.
     1456           if error-status:error
     1457           or not v-correct  then do:
     1458             assign v-mes = substitute("товар с кодом &1, &2&3: ошибка при проверке корректности задаваемого значения атрибута товара на объекте &4&5:&6 &7&5"  +                    "Обратитесь к администратору системы"                     , gds-list.gds-code                    , parobj-type                            , parobj-code                            , temp-attr.attr-value                    , chr(10)                        , error-status:get-message(1)                    , return-value ).
     1459             undo _main, return error v-mes.
     1460           end.
     1461         end.
     1462         CASE temp-attr.action:
     1463           when yes then do:
     1464             run gdsoattr-write in this-procedure(
     1465                                                   input pargds-code,
     1466                                                   input parobj-type,
     1467                                                   input parobj-code,
     1468                                                   input temp-attr.attr-code,
     1469                                                   input temp-attr.attr-value
     1470                                                       )  no-error.
     1471              if error-status:error  then do:
     1472                if entry(1, return-value , chr(4) ) = 'lock':U then do:
     1473                  undo _main, return error entry(2, return-value, chr(4)).
     1474                end.
     1475                else do:
     1476                 assign v-mes = substitute("товар с кодом &1, &2&3: ошибка при записи атрибута товара на объекте &4&5:&6 &7&5"  +                    "Обратитесь к администратору системы"                     , gds-list.gds-code                    , parobj-type                            , parobj-code                            , temp-attr.attr-value                    , chr(10)                        , error-status:get-message(1)                    , return-value ).
     1477                 undo _main, return error v-mes.
     1478                end.
     1479              end.
     1480           end.
     1481           when no then do:
     1482             var-deleted = no.
     1483             run gdsoattr-delete in this-procedure(
     1484                                                   input pargds-code,
     1485                                                   input parobj-type,
     1486                                                   input parobj-code,
     1487                                                   input temp-attr.attr-code,
     1488                                                   output var-deleted
     1489                                                       )  no-error.
     1490              if error-status:error  then do:
     1491                if entry(1, return-value , chr(4) ) = 'lock':U then do:
     1492                  undo _main, return error entry(2, return-value, chr(4)).
     1493                end.
     1494                else do:
     1495                 assign v-mes = substitute("товар с кодом &1, &2&3: ошибка при удалении атрибута товара на объекте &4&5:&6 &7&5"  +                    "Обратитесь к администратору системы"                     , gds-list.gds-code                    , parobj-type                            , parobj-code                            , temp-attr.attr-value                    , chr(10)                        , error-status:get-message(1)                    , return-value ).
     1496                 undo _main, return error v-mes.
     1497                end.
     1498              end.
     1499            end.
     1500         END CASE.
     1501       end.
     1502     end.
     1503   end procedure.
     1504   procedure check-actg :
     1505   define input parameter p-grp-code as integer no-undo.
     1506   define input parameter p-gds-code as integer no-undo.
     1507   define input parameter p-obj-code as integer no-undo.
     1508   define input parameter p-obj-type as character no-undo.
     1509   define output parameter p-ok as logical no-undo.
     1510   define variable glog as logical no-undo.
     1511   define variable glog-obj as logical no-undo.
     1512   do
     1513   on error undo, return error
     1514   :
     1515   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1516     run mainmenu_getcntxt in parparentproc
     1517       (output v-cntxt-db-num
     1518       ,output v-cntxt-userid
     1519       ,output v-cntxt-level
     1520       ,output v-cntxt-host-code-obj
     1521       ,output v-cntxt-obj-type
     1522       ,output v-cntxt-obj-code
     1523       ,output v-cntxt-db-num-obj
     1524       ,output v-cntxt-is-admin
     1525       ) .
     1526   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1527   do:
     1528     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1529       (input  v-cntxt-db-num
     1530       ,input  v-cntxt-userid
     1531       ,input  0
     1532       ,input  'actn_reference_update':U
     1533       ,input  'global':U
     1534       ,input  0
     1535       ,input  '':U
     1536       ,input  0
     1537       ,input  0
     1538       ,input  p-grp-code
     1539       ,input  0
     1540       ,input  false
     1541       ,output glog
     1542       )  .
     1543   end.
     1544       if glog then do :
     1545         assign
     1546           p-ok = true.
     1547       end.
     1548       else do:
     1549   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1550   do:
     1551     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1552       (input  v-cntxt-db-num
     1553       ,input  v-cntxt-userid
     1554       ,input  0
     1555       ,input  'actn_reference_update_dopinfo':U
     1556       ,input  'object':U
     1557       ,input  v-cntxt-host-code-obj
     1558       ,input  v-cntxt-obj-type
     1559       ,input  v-cntxt-obj-code
     1560       ,input  0
     1561       ,input  0
     1562       ,input  0
     1563       ,input  false
     1564       ,output glog-obj
     1565       )  .
     1566   end.
     1567       if glog-obj then do :
     1568         assign
     1569           p-ok = true.
     1570       end.
     1571       else do :
     1572         find first gds-grp no-lock
     1573              where gds-grp.node-code = p-grp-code no-error.
     1574         v-mes = substitute("товар с кодом &1, &2&3: У вас отсутствует глобальное право на изменение товара в привязке к группе товаров &4"
     1575                      , p-gds-code
     1576                      , p-obj-type
     1577                      , p-obj-code
     1578                      , (string(gds-grp.node-code) + " " + gds-grp.node-name)
     1579                       ).
     1580         undo,return error v-mes.
     1581       end.
     1582       end.
     1583   end.
     1584   end procedure.
