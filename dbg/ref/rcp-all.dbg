     6398      prevvalue = find-by .
     6399     if find-by:screen-value = "all":u then do:
     6400       assign
     6401       log-res = find-by:enable(radio-label("name":u, find-by:radio-buttons))
     6402       log-res = find-by:enable(radio-label("number":u, find-by:radio-buttons))
     6403       log-res = find-by:enable(radio-label("article":u, find-by:radio-buttons))
     6404       log-res = find-by:enable(radio-label("goods":u, find-by:radio-buttons))
     6405       .
     6406       run change-query .
     6407       disable nameorcode with frame dialog-frame .
     6408       hide nameorcode .
     6409     end.
     6410     else  do:
     6411       view nameorcode .
     6412       enable nameorcode with frame dialog-frame .
     6413       case find-by:screen-value :
     6414         when "number":u then do:
     6415             assign
     6416                 log-res = find-by:disable(radio-label("name":u, find-by:radio-buttons))
     6417                 log-res = find-by:disable(radio-label("article":u, find-by:radio-buttons))
     6418                 log-res = find-by:disable(radio-label("goods":u, find-by:radio-buttons))
     6419                 .
     6420         end.
     6421         when "name":u then do:
     6422             assign
     6423                 log-res = find-by:disable(radio-label("number":u, find-by:radio-buttons))
     6424                 log-res = find-by:disable(radio-label("article":u, find-by:radio-buttons))
     6425                 log-res = find-by:disable(radio-label("goods":u, find-by:radio-buttons))
     6426                  .
     6427         end.
     6428         when "article":u then do:
     6429             assign
