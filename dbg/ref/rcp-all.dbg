     7991                   where recid(ub.goods) = p-goods-recid
     7992                 , first ub.clients no-lock
     7993                   where ub.clients.obj-type = ub.recipe.prod-type
     7994                     and ub.clients.obj-code = ub.recipe.prod-code
     7995                 by ub.recipe.recipe-order
