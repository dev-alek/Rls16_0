     6135                     at 56 format "x(15)" skip
     6136             line format "x(135)" at 1
     6137         with width 160 down use-text stream-io no-box .
     6138     if num-results( "br-recipe" ) = 0 then
     6139         do:
     6140             message "Список  П У С Т !" skip view-as alert-box information .
     6141             return no-apply .
