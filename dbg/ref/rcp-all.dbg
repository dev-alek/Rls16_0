     6431                 log-res = find-by:disable(radio-label("number":u, find-by:radio-buttons))
     6432                 log-res = find-by:disable(radio-label("goods":u, find-by:radio-buttons))
     6433                 .
     6434         end.
     6435         when "goods":u then do:
