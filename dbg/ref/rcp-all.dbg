     5133   function get-ingr-qnty returns decimal
     5134     ( input  v-browse-type     as  character,
     5135       input  p-qnty-type       as  integer,
     5136       buffer local-recipe      for ub.recipe,
     5137       buffer local-recipe-gds  for ub.recipe-gds) :
     5138     define variable v-output-qnty    as decimal  no-undo.
     5139     define buffer bf_recipe-gds for ub.recipe-gds.
     5140     define buffer bf_goods      for ub.goods.
     5141     define variable varrecipe-qnty-season            as decimal no-undo.
     5142     define variable varrecipe-brutto-qnty-season     as decimal no-undo.
     5143     define variable varrecipe-gds-qnty-season        as decimal no-undo.
     5144     define variable varrecipe-gds-brutto-qnty-season as decimal no-undo.
     5145     define variable varcoeff                         as decimal no-undo.
     5146     if v-browse-type = "recipe-gds":u
     5147     then do:
     5148       case p-qnty-type
     5149       :
     5150         when 1
     5151         then do:
     5152             assign
     5153                 v-output-qnty = local-recipe-gds.qnty / local-recipe.qnty
     5154             .
     5155         end.
     5156         when 2
     5157         then do:
     5158           assign
     5159             v-output-qnty = local-recipe-gds.brutto-qnty / local-recipe.brutto-qnty
     5160           .
     5161         end.
     5162         otherwise do:
     5163           message "Неверный режим просмотра списка рецептов." view-as alert-box error.
     5164         end.
     5165       end case.
     5166     end.
     5167     else do:
     5168       case p-qnty-type
     5169       :
     5170         when 1
     5171         then do:
     5172           assign
     5173             v-output-qnty = local-recipe.qnty.
     5174         end.
     5175         when 2
     5176         then do:
     5177           assign
     5178             v-output-qnty = local-recipe.brutto-qnty.
     5179         end.
     5180         otherwise do:
     5181           message "Неверный режим просмотра списка рецептов." view-as alert-box error.
     5182         end.
     5183       end case.
     5184     end.
     5185     return v-output-qnty.
     5186   end function.
     5187   function get-browse-field returns character
     5188     ( input p-parameter-number as integer, input p-recipe-code as character, input p-gds-code as integer ) :
     5189       define variable v-output-string    as character      no-undo.
     5190       define variable v-recipe-code      as character    no-undo.
     5191       define variable v-mark as logical no-undo .
     5192       define buffer buf_recipe        for ub.recipe.
     5193       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     5194       case p-parameter-number
     5195       :
     5196           when 1
     5197           then do:
     5198               find first buf_recipe no-lock
     5199                    where buf_recipe.recipe-code = p-recipe-code
     5200               .
     5201               if buf_recipe.host-code = 0
     5202               and buf_recipe.obj-type = ""
     5203               and buf_recipe.obj-code = 0
     5204               then do:
     5205                   assign
     5206                       v-output-string = "+"
     5207                   .
     5208               end.
     5209               else do:
     5210                   assign
     5211                       v-output-string = "-"
     5212                   .
     5213               end.
     5214           end.
     5215           when 2
     5216           then do:
     5217   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5218   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     5219     (input  p-gds-code
     5220     ,output v-output-string
     5221     )  .
     5222           end.
     5223           when 3
     5224           then do:
     5225               run fbrlib-get-obj-recipe (
     5226                     input p-store-type
     5227                   , input p-store-code
     5228                   , input p-gds-code
     5229                   , output v-recipe-code
     5230               ).
     5231               if v-recipe-code = p-recipe-code
     5232               then do:
     5233                   assign
     5234                       v-output-string = " +"
     5235                   .
     5236               end.
     5237               else do:
     5238                   assign
     5239                       v-output-string = " -"
     5240                   .
     5241               end.
     5242           end.
     5243           when 4
     5244           then do:
     5245               run fbrlib-get-mark (
     5246                     input p-recipe-code
     5247                   , output v-mark
     5248               ).
     5249               if v-mark then do:
     5250                   assign
     5251                       v-output-string = "+"
     5252                   .
     5253               end.
     5254               else do:
     5255                   assign
     5256                       v-output-string = "-"
     5257                   .
     5258               end.
     5259           end.
     5260           otherwise do:
     5261               message "Неверный режим просмотра списка рецептов." view-as alert-box error.
     5262           end.
     5263       end case.
     5264       return v-output-string.
     5265   end function.
