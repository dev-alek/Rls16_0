     2185   procedure fbrlib_get-default-pay-code :
     2186   define input parameter p-obj-type   as character        no-undo.
     2187   define input parameter p-obj-code   as integer          no-undo.
     2188   define output parameter p-pay-code  as integer          no-undo.
     2189   define variable v-host-code as integer no-undo .
     2190   define buffer buf_shop          for ub.shop.
     2191   define buffer buf_store         for ub.store.
     2192   define buffer buf_sysconf       for ub.sysconf.
     2193   do
     2194   for buf_shop
     2195     , buf_store
     2196     , buf_sysconf
     2197   on error undo, return error
     2198   :
     2199     case p-obj-type  :
     2200       when 'маг':U then do:
     2201           find first buf_shop no-lock
     2202                 where buf_shop.obj-code = p-obj-code
     2203           no-error.
     2204           if available buf_shop
     2205           then do:
     2206               assign
     2207                   p-pay-code = buf_shop.fbr-pay
     2208               .
     2209           end.
     2210       end.
     2211       when 'скл':U then do:
     2212           find first buf_store no-lock
     2213                 where buf_store.obj-code = p-obj-code
     2214           no-error.
     2215           if available buf_store
     2216           then do:
     2217               assign
     2218                   p-pay-code = buf_store.fbr-pay
     2219               .
     2220           end.
     2221       end.
     2222     end case.
     2223     if p-pay-code = ?
     2224     or p-pay-code = 0
     2225     then do:
     2226   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2227   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2228     (input  p-obj-type
     2229     ,input  p-obj-code
     2230     ,output v-host-code
     2231     )  .
     2232         find first buf_sysconf no-lock
     2233               where buf_sysconf.host-code = v-host-code
     2234         no-error.
     2235         if available buf_sysconf
     2236         then do:
     2237             assign
     2238                 p-pay-code = buf_sysconf.fbr-pay
     2239             .
     2240         end.
     2241     end.
     2242     if p-pay-code = ?
     2243     or p-pay-code = 0
     2244     then do:
     2245   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2246   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     2247     (input  p-obj-type
     2248     ,input  p-obj-code
     2249     ,output p-pay-code
     2250     )  .
     2251     end.
     2252   end.
     2253   end procedure.
     2254   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     2255   do
     2256   on error undo, return error
     2257   :
     2258   define input parameter p-fbr-doc-code as character    no-undo.
     2259       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     2260       define variable v-gds-name      as character    no-undo.
     2261       define buffer buf_fbr-doc               for ub.fbr-doc.
     2262       define buffer buf_fbr-line              for ub.fbr-line.
     2263       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     2264       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     2265       find first buf_fbr-doc no-lock
     2266            where buf_fbr-doc.doc-code = p-fbr-doc-code
     2267       .
     2268       for each buf_temp_fbrlib_recipe
     2269       :
     2270           delete buf_temp_fbrlib_recipe.
     2271       end.
     2272       for each buf_fbr-line no-lock
     2273          where buf_fbr-line.doc-code = p-fbr-doc-code
     2274       :
     2275           find first buf_temp_fbrlib_recipe
     2276                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     2277           no-error.
     2278           if not available buf_temp_fbrlib_recipe
     2279           then do:
     2280               create buf_temp_fbrlib_recipe.
     2281               assign
     2282                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     2283                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     2284               .
     2285           end.
     2286       end.
     2287       for each buf_temp_fbrlib_recipe
     2288       :
     2289           assign
     2290               buf_temp_fbrlib_recipe.count-income                = 0
     2291               buf_temp_fbrlib_recipe.qnty-income                 = 0
     2292               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     2293               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     2294               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     2295               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     2296               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     2297               buf_temp_fbrlib_recipe.count-write-off             = 0
     2298               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     2299               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     2300               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     2301               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     2302               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     2303               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     2304           .
     2305           for each buf_fbr-line no-lock
     2306              where buf_fbr-line.doc-code     = p-fbr-doc-code
     2307                and buf_fbr-line.trn-type     = 'при':U
     2308                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     2309           :
     2310               if ( buf_fbr-line.price-base   = ?
     2311                   or buf_fbr-line.price-rubl = ?
     2312                   or buf_fbr-line.price-base <= 0
     2313                   or buf_fbr-line.price-rubl <= 0 )
     2314               and buf_fbr-line.fact-qnty <> 0
     2315               and buf_fbr-line.rsrv-qnty <> ?
     2316               and buf_fbr-doc.is-free    = no
     2317               then do:
     2318   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2319   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     2320     (input  buf_fbr-line.artic
     2321     ,input  buf_fbr-line.prod-type
     2322     ,input  buf_fbr-line.prod-code
     2323     ,output v-gds-name
     2324     ) no-error .
     2325                   if error-status :error
     2326                   then do:
     2327                       assign
     2328                           v-gds-name = ""
     2329                       .
     2330                   end.
     2331                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     2332                                                 ,vss-description
     2333                                                 ,buf_fbr-doc.doc-code
     2334                                                 ,chr(10)
     2335                                                 ,buf_fbr-line.recipe-code
     2336                                                 ,buf_fbr-line.artic
     2337                                                 ,v-gds-name).
     2338               end.
     2339               assign
     2340                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     2341                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     2342                                                                   + buf_fbr-line.fact-qnty
     2343                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     2344                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     2345               .
     2346               if buf_fbr-line.is-waste = no
     2347               then do:
     2348                   assign
     2349                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     2350                                                                       + buf_fbr-line.price-sum-base
     2351                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2352                                                                       + buf_fbr-line.price-sum-rubl
     2353                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2354                                                                       + buf_fbr-line.price-sum-vat-base
     2355                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2356                                                                       + buf_fbr-line.price-sum-vat-rubl
     2357                   .
     2358               end.
     2359           end.
     2360           for each buf_fbr-line no-lock
     2361              where buf_fbr-line.doc-code     = p-fbr-doc-code
     2362                and buf_fbr-line.trn-type     = 'спи':U
     2363                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     2364           :
     2365               if ( buf_fbr-line.price-base   = ?
     2366                   or buf_fbr-line.price-rubl = ?
     2367                   or buf_fbr-line.price-base <= 0
     2368                   or buf_fbr-line.price-rubl <= 0 )
     2369               and buf_fbr-line.fact-qnty <> 0
     2370               and buf_fbr-line.rsrv-qnty <> ?
     2371               and buf_fbr-doc.is-free    = no
     2372               and buf_fbr-doc.status_    = 'разрешен':U
     2373               then do:
     2374   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2375   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     2376     (input  buf_fbr-line.artic
     2377     ,input  buf_fbr-line.prod-type
     2378     ,input  buf_fbr-line.prod-code
     2379     ,output v-gds-name
     2380     ) no-error .
     2381                   if error-status :error
     2382                   then do:
     2383                       assign
     2384                           v-gds-name = ""
     2385                       .
     2386                   end.
     2387                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     2388                                                 ,vss-description
     2389                                                 ,buf_fbr-doc.doc-code
     2390                                                 ,chr(10)
     2391                                                 ,buf_fbr-line.recipe-code
     2392                                                 ,buf_fbr-line.artic
     2393                                                 ,v-gds-name).
     2394               end.
     2395               assign
     2396                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     2397                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     2398                                                                   + buf_fbr-line.fact-qnty
     2399                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     2400                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     2401               .
     2402               if buf_fbr-line.is-waste = no
     2403               then do:
     2404                   assign
     2405                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2406                                                                       + buf_fbr-line.price-sum-base
     2407                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2408                                                                       + buf_fbr-line.price-sum-rubl
     2409                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2410                                                                       + buf_fbr-line.price-sum-vat-base
     2411                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2412                                                                       + buf_fbr-line.price-sum-vat-rubl
     2413                   .
     2414               end.
     2415           end.
     2416           if buf_fbr-doc.status_    = 'разрешен':U
     2417           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     2418           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     2419           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     2420           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     2421               )
     2422           then do:
     2423            undo, return error
     2424               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     2425                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     2426                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     2427                           "Сумма в &9.&4&7&4&4&8&2"
     2428                          , buf_fbr-doc.doc-code
     2429                          , chr(10)
     2430                          , buf_temp_fbrlib_recipe.recipe-code
     2431                          , chr(9)
     2432                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2433                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     2434                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2435                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2436                          , "руб"
     2437                          )
     2438              +
     2439              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     2440                         "НДС в &7.&1&5&1&1&6&4"
     2441                        ,  chr(9)
     2442                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2443                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2444                        ,chr(10)
     2445                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2446                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2447                        ,"руб"
     2448                        )       .
     2449           end.
     2450       end.
     2451   end.
     2452   end procedure.
     2453   procedure fbrlib-fill-sum-fbr-doc :
     2454   do
     2455   on error undo, return error
     2456   :
     2457   define input parameter p-fbr-doc-recid  as recid        no-undo.
     2458   define input parameter p-mode           as character    no-undo.
     2459       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     2460       define buffer buf_fbr-doc           for ub.fbr-doc.
     2461       define buffer buf_fbr-line          for ub.fbr-line.
     2462       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     2463       define variable v-in-count          as integer       no-undo.
     2464       define variable v-out-count         as integer       no-undo.
     2465       find first buf_fbr-doc exclusive-lock
     2466            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     2467       .
     2468       find first buf_temp_fbrlib_recipe no-error.
     2469       if not available buf_temp_fbrlib_recipe
     2470       then do:
     2471           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     2472               input buf_fbr-doc.doc-code
     2473           ) no-error.
     2474           if error-status :error
     2475           then do:
     2476               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     2477                                              , vss-description
     2478                                              , chr(10)
     2479                                              , error-status:get-message(1)
     2480                                              , return-value ).
     2481           end.
     2482       end.
     2483       assign
     2484           v-in-count                  = 0
     2485           buf_fbr-doc.in-qnty         = 0
     2486           buf_fbr-doc.in-sale         = 0
     2487           buf_fbr-doc.in-base         = 0
     2488           buf_fbr-doc.in-rubl         = 0
     2489           buf_fbr-doc.in-vat-base     = 0
     2490           buf_fbr-doc.in-vat-rubl     = 0
     2491           v-out-count                 = 0
     2492           buf_fbr-doc.out-qnty        = 0
     2493           buf_fbr-doc.out-sale        = 0
     2494           buf_fbr-doc.out-base        = 0
     2495           buf_fbr-doc.out-rubl        = 0
     2496           buf_fbr-doc.out-vat-base    = 0
     2497           buf_fbr-doc.out-vat-rubl    = 0
     2498       .
     2499       for each buf_temp_fbrlib_recipe
     2500       :
     2501           assign
     2502               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     2503               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     2504               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     2505               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     2506               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     2507               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     2508               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     2509               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     2510               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     2511               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     2512               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     2513               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     2514               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     2515               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     2516           .
     2517       end.
     2518       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     2519       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     2520       or p-mode <> 'факт':U
     2521       then do:
     2522           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     2523           then do:
     2524               assign
     2525                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     2526                                   + string( v-out-count, ">>>,>>9" )
     2527                                   + chr(10) + "Строк исходных товаров : "
     2528                                   + string( v-in-count, ">>>,>>9" )
     2529               .
     2530           end.
     2531       end.
     2532       else do:
     2533         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     2534                                       "Сумма списанных товаров в &3 - &4&2" +
     2535                                       "Сумма оприходованных товаров в &3 - &5&2" +
     2536                                       "Сумма оприходованных товаров в &3 - &6&2" +
     2537                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     2538                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     2539                                       , buf_fbr-doc.doc-code
     2540                                       , chr(10)
     2541                                       , "рублях"
     2542                                       , round( buf_fbr-doc.out-rubl, 2 )
     2543                                       , round( buf_fbr-doc.in-rubl,  2 )
     2544                                       , round( buf_fbr-doc.in-rubl,  2 )
     2545                                       , round( buf_fbr-doc.out-base, 2 )
     2546                                       , round( buf_fbr-doc.in-base,  2 )).
     2547       end.
     2548   end.
     2549   end procedure.
     2550   procedure fbrlib-calc-prices :
     2551   do
     2552   on error undo, return error
     2553   :
     2554   define input parameter p-fbr-line-recid as recid        no-undo.
     2555   define input parameter p-price-obj-type as character    no-undo.
     2556   define input parameter p-price-obj-code as integer      no-undo.
     2557   define output parameter p-current-price as decimal      no-undo.
     2558       define variable v-void          as decimal       no-undo.
     2559       define variable v-void-char     as character     no-undo.
     2560       define variable v-gds-code      as integer       no-undo.
     2561       define variable v-b-code        as integer       no-undo.
     2562       define buffer buf_fbr-doc   for ub.fbr-doc.
     2563       define buffer buf_fbr-line  for ub.fbr-line.
     2564       define buffer buf_gds-prt   for ub.gds-prt.
     2565       define buffer buf_bar-code  for ub.bar-code.
     2566       find first buf_fbr-line no-lock
     2567           where recid( buf_fbr-line ) = p-fbr-line-recid
     2568       .
     2569   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2570   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     2571     (input  buf_fbr-line.artic
     2572     ,input  buf_fbr-line.prod-type
     2573     ,input  buf_fbr-line.prod-code
     2574     ,output v-gds-code
     2575     ) no-error .
     2576       if error-status :error
     2577       then do:
     2578         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     2579                                         ,vss-workfile
     2580                                         ,vss-revision
     2581                                         ,vss-description
     2582                                         ,chr(10)
     2583                                         , error-status:get-message(1)
     2584                                         , return-value
     2585                                         , buf_fbr-line.artic
     2586                                         ).
     2587       end.
     2588   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     2589     (input  v-gds-code
     2590     ,input  ?
     2591     ,output v-b-code
     2592     ) no-error .
     2593       if error-status :error
     2594       then do:
     2595         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     2596                                         ,vss-workfile
     2597                                         ,vss-revision
     2598                                         ,vss-description
     2599                                         ,chr(10)
     2600                                         , error-status:get-message(1)
     2601                                         , return-value
     2602                                         , v-gds-code
     2603                                         ).
     2604       end.
     2605       if buf_fbr-line.is-calc = no
     2606       then do:
     2607   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2608   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2609     (input  p-price-obj-type
     2610     ,input  p-price-obj-code
     2611     ,input  v-b-code
     2612     ,input  0
     2613     ,input  0
     2614     ,output v-void-char
     2615     ,output p-current-price
     2616     ,output v-void
     2617     ,output v-void
     2618     ) no-error .
     2619           if error-status :error
     2620           then do:
     2621             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     2622                                             ,vss-workfile
     2623                                             ,vss-revision
     2624                                             ,vss-description
     2625                                             ,chr(10)
     2626                                             , error-status:get-message(1)
     2627                                             , return-value
     2628                                             , v-gds-code
     2629                                             ).
     2630           end.
     2631       end.
     2632       else do:
     2633           assign
     2634               p-current-price = buf_fbr-line.price-sale
     2635           .
     2636       end.
     2637   end.
     2638   end procedure.
     2639   procedure fbrlib-put-in-order-recipe :
     2640   do
     2641   on error undo, return error
     2642   :
     2643   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2644       define variable v-recipe-counter    as integer          no-undo.
     2645       define variable v-recipe-amount     as integer init 0   no-undo.
     2646       define variable v-child-counter     as integer          no-undo.
     2647       define variable v-is-call-cycle     as logical          no-undo.
     2648       define variable v-str as character     no-undo.
     2649       define buffer buf_in_fbr-line       for ub.fbr-line.
     2650       define buffer buf_dress_fbr-line    for ub.fbr-line.
     2651       define buffer buf_fbr-line          for ub.fbr-line.
     2652       define buffer buf_recipe-gds        for ub.recipe-gds.
     2653       define buffer buf_recipe            for ub.recipe.
     2654       for each temp_recipe-childs-qnty
     2655       :
     2656           delete temp_recipe-childs-qnty.
     2657       end.
     2658       for each temp_recipe-childs
     2659       :
     2660           delete temp_recipe-childs.
     2661       end.
     2662       for each temp_recipe-order
     2663       :
     2664           delete temp_recipe-order.
     2665       end.
     2666       for each buf_fbr-line no-lock
     2667          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     2668       on error undo, return error
     2669       :
     2670           find first temp_recipe-childs-qnty
     2671                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2672           no-error.
     2673           if not available temp_recipe-childs-qnty
     2674           then do:
     2675               create temp_recipe-childs-qnty.
     2676               assign
     2677                   v-recipe-amount                     = v-recipe-amount + 1
     2678                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2679                   temp_recipe-childs-qnty.order       = v-recipe-amount
     2680                   temp_recipe-childs-qnty.childs-qnty = 0
     2681                   v-child-counter                     = 0
     2682               .
     2683           end.
     2684       end.
     2685       for each buf_in_fbr-line no-lock
     2686          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2687            and buf_in_fbr-line.trn-type = 'спи':U
     2688       on error undo, return error
     2689       :
     2690           for each buf_dress_fbr-line no-lock
     2691              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     2692                and buf_dress_fbr-line.trn-type    = 'при':U
     2693                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     2694                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     2695                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     2696           on error undo, return error
     2697           :
     2698               find first buf_recipe no-lock
     2699                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     2700               .
     2701               if buf_in_fbr-line.is-comp = yes
     2702               then do:
     2703                   find last temp_recipe-childs-qnty
     2704                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2705                   .
     2706                   assign
     2707                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2708                   .
     2709                   create temp_recipe-childs.
     2710                   assign
     2711                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2712                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2713                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     2714                   .
     2715               end.
     2716               else do:
     2717               end.
     2718           end.
     2719       end.
     2720       for each buf_in_fbr-line no-lock
     2721          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2722            and buf_in_fbr-line.trn-type = 'при':U
     2723       on error undo, return error
     2724       :
     2725           find first buf_recipe no-lock
     2726                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     2727           no-error.
     2728           if buf_in_fbr-line.is-comp = no
     2729           then do:
     2730           end.
     2731           else do:
     2732               for each buf_recipe-gds no-lock
     2733               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     2734               :
     2735                   for each buf_fbr-line no-lock
     2736                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     2737                       and buf_fbr-line.trn-type    = 'при':U
     2738                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     2739                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     2740                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     2741                   on error undo, return error
     2742                   :
     2743                       find first buf_recipe no-lock
     2744                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     2745                       .
     2746                       if buf_recipe.recipe-type = 'разделка':U
     2747                       then do:
     2748                       end.
     2749                       else do:
     2750                           find last temp_recipe-childs-qnty
     2751                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2752                           .
     2753                           assign
     2754                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2755                           .
     2756                           create temp_recipe-childs.
     2757                           assign
     2758                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2759                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2760                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     2761                           .
     2762                       end.
     2763                   end.
     2764               end.
     2765           end.
     2766       end.
     2767       for each temp_recipe-order
     2768       on error undo, return error
     2769       :
     2770           delete temp_recipe-order.
     2771       end.
     2772       assign
     2773           v-fbrlib-recipe-order = 0
     2774       .
     2775       do v-recipe-counter = 1 to v-recipe-amount
     2776       on error undo, return error
     2777       :
     2778           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2779                 input v-recipe-counter
     2780               , input 0
     2781               , output v-is-call-cycle
     2782           ).
     2783           if v-is-call-cycle = yes
     2784           then do:
     2785               message
     2786                       "Достигнут максимальный уровень вложенности рецептов."
     2787                   skip(1)
     2788                   skip "Невозможно упорядочить рецепты."
     2789                   skip(1)
     2790                   skip "Необходимо изменить структуру рецептов,"
     2791                   skip "используемых при формировании"
     2792                   skip "данного документа производства."
     2793               view-as alert-box error
     2794               title "Невозможно рассчитать документ производства".
     2795               for each temp_recipe-childs-qnty
     2796               :
     2797                   delete temp_recipe-childs-qnty.
     2798               end.
     2799               for each temp_recipe-childs
     2800               :
     2801                   delete temp_recipe-childs.
     2802               end.
     2803               for each temp_recipe-order
     2804               :
     2805                   delete temp_recipe-order.
     2806               end.
     2807               for each temp_recipe-order
     2808               on error undo, return error
     2809               :
     2810                   delete temp_recipe-order.
     2811               end.
     2812               for each temp_fbrlib_recipe
     2813               on error undo, return error
     2814               :
     2815                   delete temp_recipe-order.
     2816               end.
     2817               undo, return error.
     2818           end.
     2819       end.
     2820   end.
     2821   end procedure.
     2822   procedure fbrlib-add-recipe-in-tmp-order :
     2823   do
     2824   on error undo, return error
     2825   :
     2826   define input parameter p-order              as integer      no-undo.
     2827   define input parameter p-call-counter       as integer      no-undo.
     2828   define output parameter p-is-call-cycle     as logical      no-undo.
     2829       define variable v-nodes-counter     as integer       no-undo.
     2830       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     2831       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     2832       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     2833       define buffer buf_temp_recipe-order         for temp_recipe-order.
     2834       assign
     2835           p-call-counter = p-call-counter + 1
     2836       .
     2837       if p-call-counter > 50
     2838       then do:
     2839           assign
     2840               p-is-call-cycle = yes
     2841           .
     2842       end.
     2843       else do:
     2844           find first buf_temp_recipe-childs-qnty
     2845                where buf_temp_recipe-childs-qnty.order = p-order
     2846           .
     2847           find first buf_temp_recipe-order
     2848                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2849           no-error.
     2850           if not available buf_temp_recipe-order
     2851           then do:
     2852               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     2853               :
     2854                   find first buf_temp_recipe-childs
     2855                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2856                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     2857                   .
     2858                   find first buf_c_temp_recipe-childs-qnty
     2859                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     2860                   .
     2861                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2862                         input buf_c_temp_recipe-childs-qnty.order
     2863                       , input p-call-counter
     2864                       , output p-is-call-cycle
     2865                   ).
     2866                   if p-is-call-cycle = yes
     2867                   then do:
     2868                       return.
     2869                   end.
     2870               end.
     2871               assign
     2872                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     2873               .
     2874               create buf_temp_recipe-order.
     2875               assign
     2876                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     2877                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     2878               .
     2879           end.
     2880       end.
     2881   end.
     2882   end procedure.
     2883   procedure fbrlib-get-trn-type :
     2884   define input parameter p-recipe-code    as character    no-undo.
     2885   define input parameter p-goods-recid    as recid        no-undo.
     2886   define input parameter p-is-integration as logical      no-undo.
     2887   define output parameter p-is-comp       as logical      no-undo.
     2888   define output parameter p-trn-type      as character    no-undo.
     2889   define buffer buf_recipe    for ub.recipe.
     2890   define buffer buf_goods     for ub.goods.
     2891   do
     2892   for buf_recipe
     2893     , buf_goods
     2894   on error undo, return error
     2895   :
     2896       find first buf_goods no-lock
     2897            where recid( buf_goods ) = p-goods-recid
     2898       .
     2899       find first buf_recipe no-lock
     2900            where buf_recipe.recipe-code = p-recipe-code
     2901       no-error.
     2902       if not available buf_recipe
     2903       then do:
     2904           assign
     2905               p-is-comp = no
     2906               p-trn-type = "":U
     2907           .
     2908           undo, return.
     2909       end.
     2910       if  buf_recipe.artic        = buf_goods.artic
     2911       and buf_recipe.prod-type    = buf_goods.prod-type
     2912       and buf_recipe.prod-code    = buf_goods.prod-code
     2913       then do:
     2914           assign
     2915               p-is-comp = yes
     2916           .
     2917       end.
     2918       else do:
     2919           assign
     2920               p-is-comp = no
     2921           .
     2922       end.
     2923       case buf_recipe.recipe-type
     2924       :
     2925           when 'производство':U
     2926           then do:
     2927               if p-is-comp = yes
     2928               then do:
     2929                   assign
     2930                       p-trn-type = 'при':U
     2931                   .
     2932               end.
     2933               else do:
     2934                   assign
     2935                       p-trn-type = 'спи':U
     2936                   .
     2937               end.
     2938           end.
     2939           when 'альтернатива':U
     2940           then do:
     2941               if p-is-comp = yes
     2942               then do:
     2943                   assign
     2944                       p-trn-type = 'при':U
     2945                   .
     2946               end.
     2947               else do:
     2948                   assign
     2949                       p-trn-type = 'спи':U
     2950                   .
     2951               end.
     2952           end.
     2953           when 'разделка':U
     2954           then do:
     2955               if p-is-comp = no
     2956               then do:
     2957                   assign
     2958                       p-trn-type = 'при':U
     2959                   .
     2960               end.
     2961               else do:
     2962                   assign
     2963                       p-trn-type = 'спи':U
     2964                   .
     2965               end.
     2966           end.
     2967           when 'комплектация':U
     2968           then do:
     2969               if p-is-integration = ?
     2970               then do:
     2971                   message
     2972                       "Выберите тип операции по рецепту комплектации:"
     2973                       skip (2) "YES - комплектация"
     2974                       skip     "NO - разукомплектация"
     2975                   view-as alert-box question
     2976                   buttons YES-NO
     2977                   update p-is-integration.
     2978               end.
     2979               if p-is-integration = yes
     2980               then do:
     2981                   if p-is-comp = yes
     2982                   then do:
     2983                       assign
     2984                           p-trn-type = 'при':U
     2985                       .
     2986                   end.
     2987                   else do:
     2988                       assign
     2989                           p-trn-type = 'спи':U
     2990                       .
     2991                   end.
     2992               end.
     2993               else do:
     2994                   if p-is-comp = yes
     2995                   then do:
     2996                       assign
     2997                           p-trn-type = 'спи':U
     2998                       .
     2999                   end.
     3000                   else do:
     3001                       assign
     3002                           p-trn-type = 'при':U
     3003                       .
     3004                   end.
     3005               end.
     3006           end.
     3007       end case.
     3008   end.
     3009   end procedure.
     3010   procedure fbrlib-get-mark :
     3011   define input parameter p-recipe-code    as character    no-undo.
     3012   define output parameter p-mark          as logical    no-undo.
     3013   define buffer buf_goods-attr     for ub.goods-attr.
     3014   define buffer buf_recipe-gds for ub.recipe-gds .
     3015       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     3016            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     3017                                               buf_goods-attr.attr-code = 'mark-type':U:
     3018            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     3019               p-mark = true .
     3020               return .
     3021            end.
     3022       end.
     3023   end procedure.
     3024   procedure fbrlib-check-temp-tables :
     3025   do
     3026   on error undo, return error
     3027   :
     3028   define input parameter p-title  as character    no-undo.
     3029       define variable v-str               as character        no-undo.
     3030       assign
     3031           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     3032       .
     3033       for each temp_recipe-childs-qnty
     3034       on error undo, return error
     3035       :
     3036           assign
     3037               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     3038                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     3039                       + "   " + string( temp_recipe-childs-qnty.order )
     3040                       + chr(10)
     3041           .
     3042       end.
     3043       assign
     3044           v-str = v-str + "temp_recipe-childs:" + chr(10)
     3045       .
     3046       for each temp_recipe-childs
     3047       on error undo, return error
     3048       :
     3049           assign
     3050               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     3051                       + "   " + string( temp_recipe-childs.child-code )
     3052                       + "   " + string( temp_recipe-childs.child-recipe-code )
     3053                       + chr(10)
     3054           .
     3055       end.
     3056       assign
     3057           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     3058       .
     3059       for each temp_recipe-order
     3060       on error undo, return error
     3061       :
     3062           assign
     3063               v-str   = v-str + string( temp_recipe-order.recipe-code )
     3064                       + "   " + string( temp_recipe-order.order )
     3065                       + chr(10)
     3066           .
     3067       end.
     3068       assign
     3069           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     3070       .
     3071       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     3072       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     3073       for each temp_fbrlib_recipe
     3074       on error undo, return error
     3075       :
     3076           assign
     3077               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     3078                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     3079                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     3080                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     3081                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     3082                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     3083                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     3084                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     3085                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     3086                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     3087                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     3088                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     3089                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     3090                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     3091                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     3092                       + chr(10)
     3093           .
     3094           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     3095       end.
     3096   end.
     3097   end procedure.
     3098   procedure fbrlib-s-coeff-value :
     3099   define input  parameter p-gds-code    as integer        no-undo.
     3100   define input  parameter p-date        as date           no-undo.
     3101   define input  parameter p-obj-type    as character      no-undo.
     3102   define input  parameter p-obj-code    as integer        no-undo.
     3103   define output parameter p-coeff-value as decimal        no-undo.
     3104   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     3105       define variable v-date          as date         no-undo.
     3106       define variable v-host-code     as integer      no-undo.
     3107       define buffer buf_goods       for ub.goods.
     3108       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     3109       define buffer buf_clients     for ub.clients.
     3110       define buffer buf_s-coeff     for ub.s-coeff.
     3111   do
     3112   for buf_goods
     3113     , buf_fbr-gds-obj
     3114     , buf_clients
     3115     , buf_s-coeff
     3116   on error undo, return error return-value
     3117   :
     3118       find first buf_goods no-lock
     3119            where buf_goods.gds-code = p-gds-code
     3120       no-error .
     3121       if not available buf_goods
     3122       then do:
     3123          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     3124       end.
     3125       find first buf_clients no-lock
     3126            where buf_clients.obj-type = p-obj-type
     3127              and buf_clients.obj-code = p-obj-code
     3128       no-error.
     3129       if not available buf_clients
     3130       then do:
     3131          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     3132       end.
     3133       assign
     3134           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     3135       .
     3136       find first buf_fbr-gds-obj no-lock
     3137            where buf_fbr-gds-obj.gds-code = p-gds-code
     3138              and buf_fbr-gds-obj.obj-type = p-obj-type
     3139              and buf_fbr-gds-obj.obj-code = p-obj-code
     3140       no-error.
     3141       if not available buf_fbr-gds-obj
     3142       or buf_fbr-gds-obj.is-season = no
     3143       then do:
     3144           assign
     3145               p-coeff-value = 0
     3146           .
     3147           return.
     3148       end.
     3149   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3150   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3151     (input  p-obj-type
     3152     ,input  p-obj-code
     3153     ,output v-host-code
     3154     )  .
     3155       find last buf_s-coeff no-lock
     3156           where buf_s-coeff.gds-code = p-gds-code
     3157             and buf_s-coeff.host-code = v-host-code
     3158             and buf_s-coeff.obj-type = p-obj-type
     3159             and buf_s-coeff.obj-code = p-obj-code
     3160             and buf_s-coeff.s-date <= v-date
     3161       no-error.
     3162       if available buf_s-coeff
     3163       then do:
     3164           assign
     3165               p-coeff-value = buf_s-coeff.coeff-value
     3166           .
     3167           return.
     3168       end.
     3169       find last buf_s-coeff no-lock
     3170           where buf_s-coeff.gds-code = p-gds-code
     3171             and buf_s-coeff.host-code = v-host-code
     3172             and buf_s-coeff.obj-type = "":U
     3173             and buf_s-coeff.obj-code = 0
     3174             and buf_s-coeff.s-date <= v-date
     3175       no-error.
     3176       if available buf_s-coeff
     3177       then do:
     3178           assign
     3179               p-coeff-value = buf_s-coeff.coeff-value
     3180           .
     3181           return.
     3182       end.
     3183       find last buf_s-coeff no-lock
     3184           where buf_s-coeff.gds-code = p-gds-code
     3185             and buf_s-coeff.host-code = 0
     3186             and buf_s-coeff.obj-type = "":U
     3187             and buf_s-coeff.obj-code = 0
     3188             and buf_s-coeff.s-date <= v-date
     3189       no-error.
     3190       if available buf_s-coeff
     3191       then do:
     3192           assign
     3193               p-coeff-value = buf_s-coeff.coeff-value
     3194           .
     3195       end.
     3196       else do:
     3197           assign
     3198               p-coeff-value = 0
     3199           .
     3200       end.
     3201   end.
     3202   end procedure.
     3203   procedure fbrlib_create-fbr-recipe-gds :
     3204   define input parameter p-doc-code         as character      no-undo.
     3205   define input parameter p-recipe-code      as character      no-undo.
     3206   define input parameter p-prod-type        as character      no-undo.
     3207   define input parameter p-prod-code        as integer        no-undo.
     3208   define input parameter p-artic            as character      no-undo.
     3209   define input parameter p-gds-code         as integer        no-undo.
     3210   define input parameter p-is-waste         as logical        no-undo.
     3211   define input parameter p-proc-number      as integer        no-undo.
     3212   define input parameter p-obj-date         as date           no-undo.
     3213   define input parameter p-obj-type         as character      no-undo.
     3214   define input parameter p-obj-code         as integer        no-undo.
     3215   define input parameter p-calc-method      as decimal        no-undo.
     3216   define input parameter p-coeff-waste      as decimal        no-undo.
     3217   define input parameter p-orig-qnty        as decimal        no-undo.
     3218   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     3219       define variable v-coeff-season  as decimal      no-undo.
     3220       define variable v-void-decimal  as decimal      no-undo.
     3221       define variable v-void-integer  as integer      no-undo.
     3222       define variable v-recipe-type   as character    no-undo.
     3223       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3224       define buffer buf_goods             for ub.goods.
     3225       define buffer buf_recipe            for ub.recipe.
     3226   do
     3227   for buf_fbr-recipe-gds
     3228     , buf_recipe
     3229     , buf_goods
     3230   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     3231   :
     3232       find first buf_fbr-recipe-gds exclusive-lock
     3233            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3234              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3235              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     3236              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     3237              and buf_fbr-recipe-gds.artic       = p-artic
     3238       no-error.
     3239       if not available buf_fbr-recipe-gds
     3240       then do:
     3241           create buf_fbr-recipe-gds.
     3242           assign
     3243               buf_fbr-recipe-gds.doc-code           = p-doc-code
     3244               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     3245               buf_fbr-recipe-gds.prod-type          = p-prod-type
     3246               buf_fbr-recipe-gds.prod-code          = p-prod-code
     3247               buf_fbr-recipe-gds.artic              = p-artic
     3248               buf_fbr-recipe-gds.gds-code           = p-gds-code
     3249               buf_fbr-recipe-gds.is-waste           = p-is-waste
     3250               buf_fbr-recipe-gds.proc-number        = p-proc-number
     3251               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     3252               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     3253           .
     3254           find first buf_goods no-lock
     3255                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     3256                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     3257                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     3258           .
     3259           run fbrlib-s-coeff-value in this-procedure (
     3260                 input buf_goods.gds-code
     3261               , input p-obj-date
     3262               , input p-obj-type
     3263               , input p-obj-code
     3264               , output v-coeff-season
     3265           ) no-error.
     3266           if error-status:error
     3267           then do:
     3268               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     3269           end.
     3270           assign
     3271               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     3272               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     3273               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     3274           .
     3275           run fbrlib-get-recipe-type in this-procedure (
     3276                 input buf_fbr-recipe-gds.doc-code
     3277               , input buf_fbr-recipe-gds.recipe-code
     3278               , output v-recipe-type
     3279           ).
     3280           if v-recipe-type <> 'производство':U
     3281           then do:
     3282               assign
     3283                   buf_fbr-recipe-gds.coeff-value  = 0
     3284                   buf_fbr-recipe-gds.coeff-waste  = 0
     3285                   buf_fbr-recipe-gds.calc-method  = 1
     3286                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     3287               .
     3288           end.
     3289           else do:
     3290               run fbrlib-calc-brutto in this-procedure (
     3291                     input v-recipe-type
     3292                   , input buf_fbr-recipe-gds.qnty
     3293                   , input buf_fbr-recipe-gds.coeff-value
     3294                   , input buf_fbr-recipe-gds.coeff-waste
     3295                   , input 0
     3296                   , input 3
     3297                   , output v-void-decimal
     3298                   , output v-void-decimal
     3299                   , output buf_fbr-recipe-gds.brutto-qnty
     3300                   , output v-void-integer
     3301               ).
     3302               assign
     3303                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     3304               .
     3305               run fbrlib-calc-brutto in this-procedure (
     3306                     input v-recipe-type
     3307                   , input buf_fbr-recipe-gds.qnty
     3308                   , input buf_fbr-recipe-gds.coeff-value
     3309                   , input buf_fbr-recipe-gds.coeff-waste
     3310                   , input buf_fbr-recipe-gds.brutto-qnty
     3311                   , input buf_fbr-recipe-gds.calc-method
     3312                   , output buf_fbr-recipe-gds.qnty
     3313                   , output v-void-decimal
     3314                   , output v-void-decimal
     3315                   , output v-void-integer
     3316               ).
     3317           end.
     3318       end.
     3319   end.
     3320   end procedure.
     3321   procedure fbrlib-set-default-recipe :
     3322   define input parameter p-obj-type   as character    no-undo.
     3323   define input parameter p-obj-code   as integer      no-undo.
     3324   define input parameter p-gds-code   as integer      no-undo.
     3325       define variable v-artic             as character    no-undo.
     3326       define variable v-prod-type         as character    no-undo.
     3327       define variable v-prod-code         as character    no-undo.
     3328       define variable v-recipe-code       as character    no-undo.
     3329       define variable v-fbr-gds-obj-recid as recid        no-undo.
     3330       define variable v-recipe-found      as logical      no-undo.
     3331       define buffer buf_recipe        for ub.recipe.
     3332       define buffer buf_other_recipe  for ub.recipe.
     3333       define buffer buf_goods         for ub.goods.
     3334       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     3335   do
     3336   for buf_recipe
     3337     , buf_goods
     3338     , buf_fbr-gds-obj
     3339   on error undo, return error
     3340   :
     3341       find first buf_goods no-lock
     3342            where buf_goods.gds-code = p-gds-code
     3343       .
     3344       run fbrlib-get-obj-recipe in this-procedure (
     3345             input p-obj-type
     3346           , input p-obj-code
     3347           , input p-gds-code
     3348           , output v-recipe-code
     3349       ).
     3350       if v-recipe-code <> ""
     3351       then do:
     3352           find first buf_recipe no-lock
     3353               where buf_recipe.recipe-code = v-recipe-code
     3354           no-error.
     3355           if not available buf_recipe
     3356           then do:
     3357               assign
     3358                   v-recipe-code = ""
     3359               .
     3360           end.
     3361       end.
     3362       if v-recipe-code = ""
     3363       then do:
     3364           find first buf_fbr-gds-obj exclusive-lock
     3365                where buf_fbr-gds-obj.obj-type = p-obj-type
     3366                  and buf_fbr-gds-obj.obj-code = p-obj-code
     3367                  and buf_fbr-gds-obj.gds-code = p-gds-code
     3368           no-error.
     3369           if not available buf_fbr-gds-obj
     3370           then do:
     3371               run ref/fgdsobj1.p (
     3372                     input-output v-fbr-gds-obj-recid
     3373                   , input 'ДОБАВЛЕНИЕ':U
     3374                   , input no
     3375                   , input p-gds-code
     3376                   , input p-obj-type
     3377                   , input p-obj-code
     3378                   , input 0
     3379                   , input ""
     3380                   , input 0
     3381                   , input no
     3382                   , input no
     3383                   , input no
     3384                   , input no
     3385                   , input no
     3386                   , input no
     3387               ) no-error.
     3388               if error-status:error
     3389               then do:
     3390                   message
     3391                           vss-workfile vss-revision vss-description
     3392                       skip "Ошибка изменения атрибутов товара на объекте"
     3393                       skip return-value
     3394                       skip trim(error-status :get-message(1))
     3395                               trim(error-status :get-message(2))
     3396                               trim(error-status :get-message(3))
     3397                   view-as alert-box error.
     3398                   undo, return error .
     3399               end.
     3400               find first buf_fbr-gds-obj exclusive-lock
     3401                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     3402               .
     3403           end.
     3404           assign
     3405               v-recipe-found = no
     3406           .
     3407           for first buf_recipe no-lock
     3408               where buf_recipe.obj-type    = p-obj-type
     3409                 and buf_recipe.obj-code    = p-obj-code
     3410                 and buf_recipe.artic       = buf_goods.artic
     3411                 and buf_recipe.prod-type   = buf_goods.prod-type
     3412                 and buf_recipe.prod-code   = buf_goods.prod-code
     3413                 and buf_recipe.recipe-type = 'производство':U
     3414                 or (
     3415                     buf_recipe.obj-type    = ""
     3416                 and buf_recipe.obj-code    = 0
     3417                 and buf_recipe.artic       = buf_goods.artic
     3418                 and buf_recipe.prod-type   = buf_goods.prod-type
     3419                 and buf_recipe.prod-code   = buf_goods.prod-code
     3420                 and buf_recipe.recipe-type = 'производство':U
     3421                     )
     3422           :
     3423               assign
     3424                   v-recipe-found = yes
     3425                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3426               .
     3427           end.
     3428           if v-recipe-found = no
     3429           then do:
     3430               for first buf_recipe no-lock
     3431                   where buf_recipe.obj-type    = p-obj-type
     3432                     and buf_recipe.obj-code    = p-obj-code
     3433                     and buf_recipe.artic       = buf_goods.artic
     3434                     and buf_recipe.prod-type   = buf_goods.prod-type
     3435                     and buf_recipe.prod-code   = buf_goods.prod-code
     3436                     and buf_recipe.recipe-type <> 'альтернатива':U
     3437                     or (
     3438                         buf_recipe.obj-type    = ""
     3439                     and buf_recipe.obj-code    = 0
     3440                     and buf_recipe.artic       = buf_goods.artic
     3441                     and buf_recipe.prod-type   = buf_goods.prod-type
     3442                     and buf_recipe.prod-code   = buf_goods.prod-code
     3443                     and buf_recipe.recipe-type <> 'альтернатива':U
     3444                         )
     3445               :
     3446                   assign
     3447                       v-recipe-found = yes
     3448                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3449                   .
     3450               end.
     3451               if v-recipe-found = no
     3452               then do:
     3453                   for first buf_recipe no-lock
     3454                       where buf_recipe.obj-type    = p-obj-type
     3455                         and buf_recipe.obj-code    = p-obj-code
     3456                         and buf_recipe.artic       = buf_goods.artic
     3457                         and buf_recipe.prod-type   = buf_goods.prod-type
     3458                         and buf_recipe.prod-code   = buf_goods.prod-code
     3459                         or (
     3460                             buf_recipe.obj-type    = ""
     3461                         and buf_recipe.obj-code    = 0
     3462                         and buf_recipe.artic       = buf_goods.artic
     3463                         and buf_recipe.prod-type   = buf_goods.prod-type
     3464                         and buf_recipe.prod-code   = buf_goods.prod-code
     3465                             )
     3466                   :
     3467                       assign
     3468                           v-recipe-found = yes
     3469                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     3470                       .
     3471                   end.
     3472                   if v-recipe-found = no
     3473                   then do:
     3474                       assign
     3475                           buf_fbr-gds-obj.default-recipe-code = ""
     3476                       .
     3477                   end.
     3478               end.
     3479           end.
     3480       end.
     3481   end.
     3482   end procedure.
     3483   procedure fbrlib-get-obj-recipe :
     3484   define input parameter p-obj-type       as character    no-undo.
     3485   define input parameter p-obj-code       as integer      no-undo.
     3486   define input parameter p-gds-code       as integer      no-undo.
     3487   define output parameter p-recipe-code   as character    no-undo.
     3488       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     3489   do
     3490   for buf_fbr-gds-obj
     3491   on error undo, return error
     3492   :
     3493       find first buf_fbr-gds-obj no-lock
     3494            where buf_fbr-gds-obj.obj-type = p-obj-type
     3495              and buf_fbr-gds-obj.obj-code = p-obj-code
     3496              and buf_fbr-gds-obj.gds-code = p-gds-code
     3497       no-error.
     3498       if available buf_fbr-gds-obj
     3499       then do:
     3500           assign
     3501               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     3502           .
     3503       end.
     3504       else do:
     3505           assign
     3506               p-recipe-code = ""
     3507           .
     3508       end.
     3509   end.
     3510   end procedure.
     3511   procedure fbrlib-create-or-update-recipe-gds :
     3512   define input parameter p-recipe-code    as character        no-undo.
     3513   define input parameter p-gds-code       as integer          no-undo.
     3514   define input parameter p-is-waste       as logical          no-undo.
     3515   define input parameter p-qnty           as decimal          no-undo.
     3516   define input parameter p-proc-number    as integer          no-undo.
     3517   define input parameter p-nws-self       as logical          no-undo.
     3518       define variable v-max-proc-num  as integer      no-undo.
     3519       define variable v-recipe-type   as character    no-undo.
     3520       define buffer buf_goods             for ub.goods.
     3521       define buffer buf_recipe-gds        for ub.recipe-gds.
     3522       define buffer buf_recipe            for ub.recipe.
     3523       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     3524   do
     3525   for buf_goods
     3526     , buf_recipe-gds
     3527     , buf_recipe
     3528     , buf_proc_recipe-gds
     3529   on error undo, return error
     3530   :
     3531       find first buf_recipe no-lock
     3532            where buf_recipe.recipe-code = p-recipe-code
     3533       .
     3534       find first buf_goods no-lock
     3535            where buf_goods.gds-code = p-gds-code
     3536       .
     3537       find first buf_recipe-gds
     3538            where buf_recipe-gds.recipe-code = p-recipe-code
     3539              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     3540              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     3541              and buf_recipe-gds.artic       = buf_goods.artic
     3542       no-error.
     3543       if not available buf_recipe-gds
     3544       then do:
     3545           create buf_recipe-gds.
     3546           assign
     3547               buf_recipe-gds.recipe-code = p-recipe-code
     3548               buf_recipe-gds.gds-code    = p-gds-code
     3549               buf_recipe-gds.prod-type   = buf_goods.prod-type
     3550               buf_recipe-gds.prod-code   = buf_goods.prod-code
     3551               buf_recipe-gds.artic       = buf_goods.artic
     3552           .
     3553           assign
     3554               buf_recipe-gds.is-waste    = no
     3555               buf_recipe-gds.qnty        = 0
     3556               buf_recipe-gds.coeff-waste = 0
     3557               buf_recipe-gds.brutto-qnty = 0
     3558               buf_recipe-gds.proc-number = 0
     3559               buf_recipe-gds.nws-self    = no
     3560           .
     3561       end.
     3562       assign
     3563           buf_recipe-gds.is-waste    = p-is-waste
     3564       .
     3565       run fbrlib-get-recipe-type in this-procedure (
     3566             input "":U
     3567           , input buf_recipe-gds.recipe-code
     3568           , output v-recipe-type
     3569       ).
     3570       if v-recipe-type <> 'производство':U
     3571       then do:
     3572           assign
     3573               buf_recipe-gds.calc-method = 1
     3574               buf_recipe-gds.qnty        = p-qnty
     3575               buf_recipe-gds.brutto-qnty = p-qnty
     3576               buf_recipe-gds.coeff-waste = 0
     3577           .
     3578       end.
     3579       else do:
     3580           assign
     3581               buf_recipe-gds.calc-method = 1
     3582               buf_recipe-gds.brutto-qnty = p-qnty
     3583           .
     3584           run fbrlib-calc-brutto in this-procedure (
     3585                 input v-recipe-type
     3586               , input 0
     3587               , input 0
     3588               , input buf_recipe-gds.coeff-waste
     3589               , input buf_recipe-gds.brutto-qnty
     3590               , input 1
     3591               , output buf_recipe-gds.qnty
     3592               , output buf_recipe-gds.coeff-waste
     3593               , output buf_recipe-gds.brutto-qnty
     3594               , output buf_recipe-gds.calc-method
     3595           ).
     3596       end.
     3597       assign
     3598           buf_recipe-gds.nws-self    = p-nws-self
     3599       .
     3600       if buf_recipe.recipe-type = 'альтернатива':U
     3601       and buf_recipe-gds.proc-number <> 0
     3602       then do:
     3603       end.
     3604       else do:
     3605           if p-proc-number <> 0
     3606           then do:
     3607               assign
     3608                   buf_recipe-gds.proc-number = p-proc-number
     3609               .
     3610           end.
     3611           else do:
     3612               assign
     3613                   v-max-proc-num = 0
     3614               .
     3615               for each buf_proc_recipe-gds no-lock
     3616                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     3617               :
     3618                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     3619                   then do:
     3620                       assign
     3621                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     3622                       .
     3623                   end.
     3624               end.
     3625               assign
     3626                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     3627               .
     3628           end.
     3629       end.
     3630   end.
     3631   end procedure.
     3632   PROCEDURE fbrlib-create-or-update-recipe :
     3633   define input parameter p-mode               as character    no-undo.
     3634   define input parameter p-obj-type           as character    no-undo.
     3635   define input parameter p-obj-code           as integer      no-undo.
     3636   define input parameter p-recipe-code        as character    no-undo.
     3637   define input parameter p-recipe-type        as character    no-undo.
     3638   define input parameter p-gds-code           as integer      no-undo.
     3639   define input parameter p-name               as character    no-undo.
     3640   define input parameter p-design             as character    no-undo.
     3641   define input parameter p-order              as integer      no-undo.
     3642   define input parameter p-quality            as character    no-undo.
     3643   define input parameter p-ref-num            as character    no-undo.
     3644   define input parameter p-technique          as character    no-undo.
     3645   define input parameter p-template           as character    no-undo.
     3646   define input parameter p-qnty               as decimal      no-undo.
     3647   define input parameter p-portion-qnty       as integer      no-undo.
     3648   define input parameter p-portion-weight     as decimal      no-undo.
     3649   define output parameter p-new-recipe-code   as character    no-undo.
     3650       define variable v-host-code         as integer      no-undo.
     3651       define variable v-fbr-gds-obj-recid as recid        no-undo.
     3652       define buffer buf_recipe    for ub.recipe.
     3653       define buffer buf_goods     for ub.goods.
     3654   do
     3655   for buf_recipe
     3656     , buf_goods
     3657   on error undo, return error
     3658   :
     3659       if p-mode <> 'ДОБАВЛЕНИЕ':U
     3660       and p-mode <> 'ИЗМЕНЕНИЕ':U
     3661       then do:
     3662           message
     3663               skip "Ошибка задания типа операции для создания или измения рецепта."
     3664               skip (1)
     3665               skip "Задан тип операции:" p-mode
     3666           view-as alert-box error.
     3667           undo, return error .
     3668       end.
     3669       if p-recipe-code = ""
     3670       then do:
     3671   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3672   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3673     (input  p-obj-type
     3674     ,input  p-obj-code
     3675     ,output v-host-code
     3676     )  .
     3677           find first buf_goods no-lock
     3678                where buf_goods.gds-code = p-gds-code
     3679           .
     3680           create buf_recipe .
     3681           run fbrcode-gen-recipe-code in this-procedure (
     3682                 input p-obj-type
     3683               , input p-obj-code
     3684               , output buf_recipe.recipe-code
     3685           ).
     3686           assign
     3687               buf_recipe.artic               = buf_goods.artic
     3688               buf_recipe.prod-type           = buf_goods.prod-type
     3689               buf_recipe.prod-code           = buf_goods.prod-code
     3690               buf_recipe.recipe-type         = p-recipe-type
     3691               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     3692               buf_recipe.gds-code            = p-gds-code
     3693               buf_recipe.host-code           = v-host-code
     3694               buf_recipe.obj-type            = p-obj-type
     3695               buf_recipe.obj-code            = p-obj-code
     3696               buf_recipe.recipe-design       = ""
     3697               buf_recipe.recipe-order        = 0
     3698               buf_recipe.recipe-quality      = ""
     3699               buf_recipe.recipe-ref-num      = ""
     3700               buf_recipe.recipe-technique    = ""
     3701               buf_recipe.recipe-template     = ""
     3702               buf_recipe.qnty                = 1.0
     3703               buf_recipe.portion-qnty        = 1
     3704               buf_recipe.portion-weight      = 0
     3705           .
     3706       end.
     3707       if p-name <> ""
     3708       then do:
     3709           assign
     3710               buf_recipe.recipe-name = p-name
     3711           .
     3712       end.
     3713       assign
     3714           buf_recipe.recipe-design       = p-design
     3715           buf_recipe.recipe-order        = p-order
     3716           buf_recipe.recipe-quality      = p-quality
     3717           buf_recipe.recipe-ref-num      = p-ref-num
     3718           buf_recipe.recipe-technique    = p-technique
     3719           buf_recipe.recipe-template     = p-template
     3720           buf_recipe.qnty                = p-qnty
     3721           buf_recipe.portion-qnty        = p-portion-qnty
     3722           buf_recipe.portion-weight      = p-portion-weight
     3723       .
     3724       assign
     3725           p-new-recipe-code = buf_recipe.recipe-code
     3726       .
     3727       run fbrlib-set-default-recipe in this-procedure (
     3728             input p-obj-type
     3729           , input p-obj-code
     3730           , input buf_goods.gds-code
     3731       ).
     3732   end.
     3733   END PROCEDURE.
     3734   PROCEDURE fbrlib-delete-fact-fbr-doc :
     3735   define input parameter parparentproc-handle as widget-handle no-undo .
     3736   define input parameter p-doc-code   as character no-undo.
     3737   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     3738       define variable v-shift-on      as logical      no-undo.
     3739       define variable v-shift-date    as date         no-undo.
     3740       define variable v-shift-num     as integer      no-undo.
     3741       define variable v-shift-name    as character    no-undo.
     3742       define variable v-obj-date      as date         no-undo.
     3743       define variable v-chip-num      as integer      no-undo.
     3744       define buffer buf_fbr-doc       for ub.fbr-doc.
     3745       define buffer buf_fbr-line      for ub.fbr-line.
     3746       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     3747       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     3748       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     3749       define buffer buf_marking-lines for ub.marking-lines .
     3750       define buffer buf_marking       for ub.marking .
     3751       define buffer buf_goods         for ub.goods .
     3752   do
     3753   for buf_fbr-doc
     3754     , buf_fbr-line
     3755     , buf_c-fbr-doc
     3756     , buf_fbr-recipe
     3757     , buf_fbr-recipe-gds
     3758     , buf_goods
     3759     , buf_marking
     3760     , buf_marking-lines
     3761   on error undo, return error
     3762   :
     3763   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3764     define variable v-cntxt-db-num        as integer   no-undo .
     3765     define variable v-cntxt-userid        as character no-undo .
     3766     define variable v-cntxt-level         as character no-undo .
     3767     define variable v-cntxt-host-code-obj as integer   no-undo .
     3768     define variable v-cntxt-obj-type      as character no-undo .
     3769     define variable v-cntxt-obj-code      as integer   no-undo .
     3770     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3771     define variable v-cntxt-is-admin      as logical   no-undo .
     3772   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3773     run mainmenu_getcntxt in parparentproc-handle
     3774       (output v-cntxt-db-num
     3775       ,output v-cntxt-userid
     3776       ,output v-cntxt-level
     3777       ,output v-cntxt-host-code-obj
     3778       ,output v-cntxt-obj-type
     3779       ,output v-cntxt-obj-code
     3780       ,output v-cntxt-db-num-obj
     3781       ,output v-cntxt-is-admin
     3782       ) .
     3783       if search ("delfbr.err") <> ?
     3784       then do:
     3785           os-delete "delfbr.err".
     3786       end.
     3787     _del-block:
     3788       do transaction
     3789     on error undo _del-block, return error return-value
     3790     on endkey undo _del-block , return error return-value
     3791     on stop undo _del-block , return error return-value
     3792       :
     3793           find first buf_fbr-doc exclusive-lock
     3794                where buf_fbr-doc.doc-code = p-doc-code
     3795           no-error.
     3796           if not available buf_fbr-doc
     3797           then do:
     3798         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     3799                                           ,vss-workfile
     3800                                           ,vss-revision
     3801                                           ,vss-description
     3802                                           ,chr(10)
     3803                                           , p-doc-code).
     3804           end.
     3805           run fbrlib-delete-fact-trn-doc in this-procedure (
     3806               input parparentproc-handle
     3807              ,input p-doc-code
     3808              ,input 'при':U
     3809              ,input p-chip-num
     3810              ,output v-chip-num
     3811           ) no-error.
     3812           if error-status :error
     3813           then do:
     3814               run fbrlib-print-del-error-message in this-procedure .
     3815         undo _del-block, return error.
     3816           end.
     3817           assign
     3818           p-chip-num = (if p-chip-num = ?
     3819                         then v-chip-num
     3820                         else p-chip-num).
     3821           run fbrlib-delete-fact-trn-doc in this-procedure (
     3822               input parparentproc-handle
     3823              ,input p-doc-code
     3824              ,input 'рас':U
     3825              ,input p-chip-num
     3826              ,output v-chip-num
     3827           ) no-error.
     3828           if error-status :error
     3829           then do:
     3830               run fbrlib-print-del-error-message in this-procedure .
     3831         undo _del-block, return error.
     3832           end.
     3833           run fbrlib-delete-fact-trn-doc in this-procedure (
     3834               input parparentproc-handle
     3835              ,input p-doc-code
     3836              ,input 'спи':U
     3837              ,input p-chip-num
     3838              ,output v-chip-num
     3839           ) no-error.
     3840           if error-status :error
     3841           then do:
     3842               run fbrlib-print-del-error-message in this-procedure .
     3843         undo _del-block, return error.
     3844           end.
     3845           create buf_c-fbr-doc.
     3846           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     3847   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3848   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3849     (input  buf_fbr-doc.obj-type
     3850     ,input  buf_fbr-doc.obj-code
     3851     ,output v-obj-date
     3852     ) no-error .
     3853           if error-status :error
     3854           or v-obj-date = ?
     3855           then do:
     3856         undo _del-block, return error "Нет текущей даты на объекте документа.".
     3857           end.
     3858   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3859   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3860     (input  buf_fbr-doc.obj-type
     3861     ,input  buf_fbr-doc.obj-code
     3862     ,input  'shift-on=request'
     3863     ,output v-shift-on
     3864     )  .
     3865           if v-shift-on
     3866           then do:
     3867   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3868   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3869     (input  buf_fbr-doc.obj-type
     3870     ,input  buf_fbr-doc.obj-code
     3871     ,output v-shift-date
     3872     ,output v-shift-num
     3873     ,output v-shift-name
     3874     ) no-error .
     3875               if error-status :error
     3876               then do:
     3877           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     3878               end.
     3879           end.
     3880           else do:
     3881               assign
     3882                   v-shift-date = ?
     3883                   v-shift-num  = ?
     3884                   v-shift-name = ?
     3885               .
     3886           end.
     3887           define variable v-today       as date         no-undo.
     3888           define variable v-time        as integer      no-undo.
     3889           run cur-time in this-procedure (
     3890                 output v-today
     3891               , output v-time
     3892           ).
     3893           assign
     3894               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     3895               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     3896               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     3897               buf_c-fbr-doc.corr-date        = v-today
     3898               buf_c-fbr-doc.corr-time        = v-time
     3899               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     3900               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     3901               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     3902               buf_c-fbr-doc.is-del           = yes
     3903           .
     3904           assign
     3905               buf_fbr-doc.is-del = yes
     3906           .
     3907           for each buf_fbr-line exclusive-lock
     3908              where buf_fbr-line.doc-code = p-doc-code
     3909       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3910       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3911       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3912           :
     3913               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     3914                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     3915                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     3916               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     3917                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     3918                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     3919                                                       and buf_marking-lines.in-code  = "manufacturing"
     3920                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     3921                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     3922                                                       and buf_marking-lines.prt-code = 0
     3923               :
     3924                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     3925                   assign
     3926                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     3927                   .
     3928                 end .
     3929                 delete buf_marking-lines.
     3930               end .
     3931               delete buf_fbr-line.
     3932           end.
     3933           for each buf_fbr-recipe exclusive-lock
     3934              where buf_fbr-recipe.doc-code = p-doc-code
     3935       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3936       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3937       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3938           :
     3939               delete buf_fbr-recipe.
     3940           end.
     3941           for each buf_fbr-recipe-gds exclusive-lock
     3942              where buf_fbr-recipe-gds.doc-code = p-doc-code
     3943       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3944       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3945       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3946           :
     3947               delete buf_fbr-recipe-gds.
     3948           end.
     3949           delete buf_fbr-doc.
     3950       end.
     3951   end.
     3952   END PROCEDURE.
     3953   PROCEDURE fbrlib-del-trn-doc :
     3954   do
     3955   on error undo, return error
     3956   :
     3957   define input parameter parparentproc        as widget-handle no-undo .
     3958   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3959   define input parameter p-trn-doc-type       as character    no-undo.
     3960   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     3961   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     3962       define variable v-trn-doc-doc-code  as character     no-undo.
     3963       define buffer buf_trn-doc       for ub.trn-doc.
     3964   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3965     define variable v-cntxt-db-num        as integer   no-undo .
     3966     define variable v-cntxt-userid        as character no-undo .
     3967     define variable v-cntxt-level         as character no-undo .
     3968     define variable v-cntxt-host-code-obj as integer   no-undo .
     3969     define variable v-cntxt-obj-type      as character no-undo .
     3970     define variable v-cntxt-obj-code      as integer   no-undo .
     3971     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3972     define variable v-cntxt-is-admin      as logical   no-undo .
     3973   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3974     run mainmenu_getcntxt in parparentproc
     3975       (output v-cntxt-db-num
     3976       ,output v-cntxt-userid
     3977       ,output v-cntxt-level
     3978       ,output v-cntxt-host-code-obj
     3979       ,output v-cntxt-obj-type
     3980       ,output v-cntxt-obj-code
     3981       ,output v-cntxt-db-num-obj
     3982       ,output v-cntxt-is-admin
     3983       ) .
     3984       run fbrcode-trn-doc in this-procedure (
     3985             input 'производство':U
     3986           , input p-fbr-doc-doc-code
     3987           , input p-trn-doc-type
     3988           , output v-trn-doc-doc-code
     3989       ).
     3990       find first buf_trn-doc no-lock
     3991            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     3992       no-error.
     3993       if available buf_trn-doc
     3994       then do:
     3995           run str/del-doc.p (
     3996                 input parparentproc
     3997               , input buf_trn-doc.doc-code
     3998               , input v-cntxt-db-num
     3999               , input "del-doc.err"
     4000               , input ?
     4001               , input p-fbr-doc-doc-code
     4002               , input v-cntxt-userid
     4003               , input 0
     4004               , input p-phchip-num
     4005               , output p-chip-num
     4006           ) no-error.
     4007           if error-status :error
     4008           then do:
     4009             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     4010                                           ,v-trn-doc-doc-code
     4011                                           ,p-fbr-doc-doc-code
     4012                                           , chr(10)
     4013                                           , error-status:get-message(1)
     4014                                           , return-value ).
     4015           end.
     4016       end.
     4017   end.
     4018   END PROCEDURE.
     4019   PROCEDURE fbrlib-delete-fact-trn-doc :
     4020   define input parameter parparentproc    as widget-handle    no-undo.
     4021   define input parameter p-fbr-doc-code   as character        no-undo.
     4022   define input parameter p-doc-type       as character    no-undo.
     4023   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     4024   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     4025       define variable v-doc-code          as character        no-undo.
     4026       define variable v-ext-doc-type      as character        no-undo.
     4027       define variable v-trn-doc-recid     as recid            no-undo.
     4028       define variable varchip-code        as integer          no-undo.
     4029       define variable varchip-code2       as integer          no-undo.
     4030       define variable v-chip-counter      as integer          no-undo.
     4031       define buffer buf_trn-doc       for ub.trn-doc.
     4032       define buffer buf_pri_trn-doc   for ub.trn-doc.
     4033       define buffer buf_cons_trn-doc  for ub.trn-doc.
     4034   do
     4035   for buf_trn-doc
     4036     , buf_pri_trn-doc
     4037     , buf_cons_trn-doc
     4038   on error undo, return error
     4039   :
     4040   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4041     define variable v-cntxt-db-num        as integer   no-undo .
     4042     define variable v-cntxt-userid        as character no-undo .
     4043     define variable v-cntxt-level         as character no-undo .
     4044     define variable v-cntxt-host-code-obj as integer   no-undo .
     4045     define variable v-cntxt-obj-type      as character no-undo .
     4046     define variable v-cntxt-obj-code      as integer   no-undo .
     4047     define variable v-cntxt-db-num-obj    as integer   no-undo .
     4048     define variable v-cntxt-is-admin      as logical   no-undo .
     4049   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4050     run mainmenu_getcntxt in parparentproc
     4051       (output v-cntxt-db-num
     4052       ,output v-cntxt-userid
     4053       ,output v-cntxt-level
     4054       ,output v-cntxt-host-code-obj
     4055       ,output v-cntxt-obj-type
     4056       ,output v-cntxt-obj-code
     4057       ,output v-cntxt-db-num-obj
     4058       ,output v-cntxt-is-admin
     4059       ) .
     4060       run fbrcode-trn-doc in this-procedure (
     4061             input 'производство':U
     4062           , input p-fbr-doc-code
     4063           , input p-doc-type
     4064           , output v-doc-code
     4065       ).
     4066       find first buf_trn-doc no-lock
     4067            where buf_trn-doc.doc-code = v-doc-code
     4068       no-error.
     4069       if not available buf_trn-doc
     4070       then do:
     4071           if p-doc-type <> 'спи':U
     4072           then do:
     4073               message
     4074                   "Не найден документ '" p-doc-type "'"
     4075                   "по документу производства " p-fbr-doc-code
     4076               view-as alert-box.
     4077               undo, return error.
     4078           end.
     4079           else do:
     4080           end.
     4081       end.
     4082       else do:
     4083           assign
     4084               v-trn-doc-recid = recid( buf_trn-doc )
     4085               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     4086           .
     4087           if v-ext-doc-type = 'ev':U
     4088           then do:
     4089               find first buf_pri_trn-doc no-lock
     4090                    where buf_pri_trn-doc.out-code     = v-doc-code
     4091                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     4092               no-error.
     4093               if available buf_pri_trn-doc
     4094               then do:
     4095                   run str/del-doc.p (
     4096                         input parparentproc
     4097                       , input buf_pri_trn-doc.doc-code
     4098                       , input v-cntxt-db-num
     4099                       , input "delfbr.err"
     4100                       , input ?
     4101                       , input p-fbr-doc-code
     4102                       , input v-cntxt-userid
     4103                       , input 0
     4104                       , input (if p-ph-chip-num <> ?
     4105                               then p-ph-chip-num
     4106                               else (if varchip-code <> 0
     4107                                   then varchip-code
     4108                                   else ?)
     4109                               )
     4110                       , output varchip-code2
     4111                   ) no-error.
     4112                   if error-status :error
     4113                   then do:
     4114                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     4115                                                   ,buf_pri_trn-doc.doc-code
     4116                                                   ,p-fbr-doc-code
     4117                                                   , chr(10)
     4118                                                   , error-status:get-message(1)
     4119                                                   , return-value ).
     4120                   end.
     4121               end.
     4122           end.
     4123           define buffer buf_out_trn-doc       for ub.trn-doc.
     4124           if p-doc-type = 'при':U
     4125           then do:
     4126               assign
     4127                   v-chip-counter = 0
     4128               .
     4129               for each buf_out_trn-doc exclusive-lock
     4130                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     4131               on error undo, return error
     4132               :
     4133                   assign
     4134                       v-chip-counter = v-chip-counter + 1
     4135                   .
     4136                   if v-chip-counter > 1
     4137                   then do:
     4138                       assign
     4139                           varchip-code = varchip-code2
     4140                       .
     4141                   end.
     4142                   run str/del-doc.p (
     4143                         input parparentproc
     4144                       , input buf_out_trn-doc.doc-code
     4145                       , input v-cntxt-db-num
     4146                       , input "delfbr.err"
     4147                       , input ?
     4148                       , input p-fbr-doc-code
     4149                       , input v-cntxt-userid
     4150                       , input 0
     4151                       , input (if p-ph-chip-num <> ?
     4152                               then p-ph-chip-num
     4153                               else (if varchip-code <> 0
     4154                                   then varchip-code
     4155                                   else ?)
     4156                               )
     4157                       , output varchip-code2
     4158                   ) no-error.
     4159                   if error-status :error
     4160                   then do:
     4161                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     4162                                                   ,buf_out_trn-doc.doc-code
     4163                                                   ,buf_trn-doc.doc-code
     4164                                                   ,p-fbr-doc-code
     4165                                                   , chr(10)
     4166                                                   , error-status:get-message(1)
     4167                                                   , return-value ).
     4168                   end.
     4169               end.
     4170           end.
     4171           run str/del-doc.p (
     4172                 input parparentproc
     4173               , input buf_trn-doc.doc-code
     4174               , input v-cntxt-db-num
     4175               , input "delfbr.err"
     4176               , input ?
     4177               , input p-fbr-doc-code
     4178               , input v-cntxt-userid
     4179               , input 0
     4180               , input (if p-ph-chip-num <> ?
     4181                        then p-ph-chip-num
     4182                        else (if varchip-code <> 0
     4183                              then varchip-code
     4184                              else ?)
     4185                        )
     4186               , output varchip-code2
     4187           ) no-error.
     4188           if error-status :error
     4189           then do:
     4190               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     4191                                             ,buf_trn-doc.doc-code
     4192                                             ,p-fbr-doc-code
     4193                                             , chr(10)
     4194                                             , error-status:get-message(1)
     4195                                             , return-value ).
     4196           end.
     4197           if p-doc-type = 'рас':U
     4198           or p-doc-type = 'спи':U
     4199           then do:
     4200               assign
     4201                   v-chip-counter = 0
     4202               .
     4203               for each buf_cons_trn-doc no-lock
     4204                  where buf_cons_trn-doc.out-code      = v-doc-code
     4205                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     4206               :
     4207                   assign
     4208                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     4209                       v-chip-counter = v-chip-counter + 1
     4210                   .
     4211                   assign
     4212                   varchip-code = if v-chip-counter = 2
     4213                                  then varchip-code2
     4214                                  else varchip-code.
     4215                   run str/del-doc.p (
     4216                         input parparentproc
     4217                       , input buf_cons_trn-doc.doc-code
     4218                       , input v-cntxt-db-num
     4219                       , input "delfbr.err"
     4220                       , input ?
     4221                       , input ?
     4222                       , input v-cntxt-userid
     4223                       , input 0
     4224                       , input (if p-ph-chip-num <> ?
     4225                                then p-ph-chip-num
     4226                                else ( if v-chip-counter = 1
     4227                                       then ?
     4228                                       else varchip-code )
     4229                                )
     4230                       , output varchip-code2
     4231                   ) no-error.
     4232                   if error-status :error
     4233                   then do:
     4234                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     4235                                                     ,buf_cons_trn-doc.doc-code
     4236                                                     ,p-fbr-doc-code
     4237                                                     , chr(10)
     4238                                                     , error-status:get-message(1)
     4239                                                     , return-value ).
     4240                   end.
     4241                   assign
     4242                       p-chip-num = varchip-code2
     4243                   .
     4244               end.
     4245           end.
     4246           assign
     4247               p-chip-num = varchip-code2
     4248           .
     4249       end.
     4250   end.
     4251   END PROCEDURE.
     4252   PROCEDURE fbrlib-print-del-error-message :
     4253   do
     4254   on error undo, return error
     4255   :
     4256       define variable v-user-action   as character    no-undo.
     4257       define variable v-printed       as logical      no-undo.
     4258       message
     4259           vss-workfile vss-revision vss-description
     4260           skip "Ошибка при удалении документа."
     4261           skip return-value
     4262           skip trim(error-status :get-message(1))
     4263           skip trim(error-status :get-message(2))
     4264           skip trim(error-status :get-message(3))
     4265       view-as alert-box error.
     4266       if search ("delfbr.err") <> ?
     4267       then do:
     4268         run gbl/prnfilen.w
     4269           (input  "Ошибки при удалении документа производства"
     4270           ,input  0
     4271           ,input  "delfbr.err"
     4272           ,input  7
     4273           ,output v-user-action
     4274           ,output v-printed
     4275           ).
     4276       end.
     4277   end.
     4278   END PROCEDURE.
     4279   procedure fbrlib-calc-brutto :
     4280   define input parameter p-recipe-type        as character        no-undo.
     4281   define input parameter p-netto              as decimal          no-undo.
     4282   define input parameter p-coeff-value        as decimal          no-undo.
     4283   define input parameter p-coeff-waste        as decimal          no-undo.
     4284   define input parameter p-brutto             as decimal          no-undo.
     4285   define input parameter p-calc-method        as integer          no-undo.
     4286   define output parameter p-new-netto         as decimal          no-undo.
     4287   define output parameter p-new-coeff-waste   as decimal          no-undo.
     4288   define output parameter p-new-brutto        as decimal          no-undo.
     4289   define output parameter p-new-calc-method   as integer          no-undo.
     4290   do
     4291   on error undo, return error
     4292   :
     4293       if p-recipe-type <> 'производство':U
     4294       then do:
     4295           assign
     4296               p-new-coeff-waste = 0
     4297               p-new-calc-method = 1
     4298               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     4299               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     4300           .
     4301       end.
     4302       else do:
     4303           assign
     4304               p-new-calc-method = p-calc-method
     4305           .
     4306           if p-coeff-waste = 0
     4307           then do:
     4308               assign
     4309                   p-coeff-value = 0
     4310               .
     4311           end.
     4312           case p-calc-method
     4313           :
     4314               when 1
     4315               then do:
     4316                   assign
     4317                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     4318                       p-new-coeff-waste   = p-coeff-waste
     4319                       p-new-brutto        = p-brutto
     4320                   .
     4321               end.
     4322               when 2
     4323               then do:
     4324                   assign
     4325                       p-new-netto         = p-netto
     4326                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     4327                       p-new-brutto        = p-brutto
     4328                   .
     4329               end.
     4330               when 3
     4331               then do:
     4332                   assign
     4333                       p-new-netto         = p-netto
     4334                       p-new-coeff-waste   = p-coeff-waste
     4335                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     4336                   .
     4337               end.
     4338               otherwise do:
     4339                   define variable v-yesno    as logical      no-undo.
     4340                   assign
     4341                       v-yesno = yes
     4342                   .
     4343                   message
     4344                       "Неверный метод для расчета брутто, нетто и процента потерь."
     4345                       skip "Значение метода должно быть 1, 2 или 3."
     4346                       skip(1)
     4347                       skip "Заданное значение:" p-calc-method
     4348                       skip(1)
     4349                       skip "Установить значение метода расчета 1"
     4350                       skip "(расчет нетто по брутто и проценту потерь)?"
     4351                   view-as alert-box warning
     4352                   buttons yes-no
     4353                   title "Неверное значение метода пересчета в строках документа-производства"
     4354                   update v-yesno
     4355                   .
     4356                   if v-yesno = yes
     4357                   then do:
     4358                       assign
     4359                           p-new-calc-method   = 1
     4360                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     4361                           p-new-coeff-waste   = p-coeff-waste
     4362                           p-new-brutto        = p-brutto
     4363                       .
     4364                   end.
     4365                   else do:
     4366                       message
     4367                               vss-workfile vss-revision vss-description
     4368                           skip(1)
     4369                           skip "Ошибка расчета брутто, нетто и процента потерь."
     4370                           skip return-value
     4371                           skip trim(error-status :get-message(1))
     4372                               trim(error-status :get-message(2))
     4373                               trim(error-status :get-message(3))
     4374                       view-as alert-box error
     4375                       title "Неверное значение метода расчета"
     4376                       .
     4377                       undo, return error .
     4378                   end.
     4379               end.
     4380           end case.
     4381       end.
     4382   end.
     4383   end procedure.
     4384   procedure fbrlib-check-brutto :
     4385   define input parameter p-recipe-type        as character        no-undo.
     4386   define input parameter p-netto              as decimal          no-undo.
     4387   define input parameter p-coeff-value        as decimal          no-undo.
     4388   define input parameter p-coeff-waste        as decimal          no-undo.
     4389   define input parameter p-brutto             as decimal          no-undo.
     4390   define input parameter p-calc-method        as integer          no-undo.
     4391   define output parameter p-error-message     as character        no-undo.
     4392   define output parameter p-not-good          as logical          no-undo.
     4393   do
     4394   on error undo, return error
     4395   :
     4396       if p-recipe-type <> 'производство':U
     4397       then do:
     4398           if p-netto <> p-brutto
     4399           or p-coeff-waste <> 0
     4400           then do:
     4401               assign
     4402                   p-not-good      = yes
     4403                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     4404                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     4405               .
     4406           end.
     4407       end.
     4408       else do:
     4409           if p-coeff-waste = 0
     4410           then do:
     4411               assign
     4412                   p-coeff-value = 0
     4413               .
     4414           end.
     4415           case p-calc-method
     4416           :
     4417               when 1
     4418               then do:
     4419                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     4420                   then do:
     4421                       assign
     4422                           p-not-good      = yes
     4423                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     4424                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     4425                       .
     4426                   end.
     4427               end.
     4428               when 2
     4429               then do:
     4430                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     4431                   then do:
     4432                       assign
     4433                           p-not-good      = yes
     4434                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     4435                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     4436                       .
     4437                   end.
     4438               end.
     4439               when 3
     4440               then do:
     4441                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     4442                   then do:
     4443                       assign
     4444                           p-not-good      = yes
     4445                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     4446                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     4447                       .
     4448                   end.
     4449               end.
     4450               otherwise do:
     4451                   assign
     4452                       p-not-good      = yes
     4453                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     4454                   .
     4455               end.
     4456           end case.
     4457       end.
     4458   end.
     4459   end procedure.
     4460   procedure fbrlib-check-fbr-recipe :
     4461   define input parameter p-doc-code       as character        no-undo.
     4462   define input parameter p-recipe-code    as character        no-undo.
     4463   define output parameter p-is-correct    as logical          no-undo.
     4464       define variable v-comp-factor    as decimal      no-undo.
     4465       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4466       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4467       define buffer buf_fbr-line          for ub.fbr-line.
     4468   do
     4469   for buf_fbr-recipe
     4470     , buf_fbr-recipe-gds
     4471     , buf_fbr-line
     4472   on error undo, return error
     4473   :
     4474       assign
     4475           p-is-correct = yes
     4476       .
     4477       find first buf_fbr-recipe no-lock
     4478            where buf_fbr-recipe.doc-code    = p-doc-code
     4479              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     4480       .
     4481       if not available buf_fbr-recipe then do:
     4482         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     4483       end.
     4484       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4485       then do:
     4486       end.
     4487       else do:
     4488           find first buf_fbr-line no-lock
     4489                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     4490                  and buf_fbr-line.is-comp     = yes
     4491                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     4492                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     4493                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     4494                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     4495           .
     4496           assign
     4497               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     4498           .
     4499           recipe-line-cycle:
     4500           for each buf_fbr-recipe-gds no-lock
     4501              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4502                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4503           on error undo, return error
     4504           :
     4505               find first buf_fbr-line no-lock
     4506                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4507                      and buf_fbr-line.is-comp     = no
     4508                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4509                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4510                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4511                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4512               .
     4513               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     4514               then do:
     4515                   assign
     4516                       p-is-correct = no
     4517                   .
     4518                   leave recipe-line-cycle.
     4519               end.
     4520           end.
     4521       end.
     4522   end.
     4523   end procedure.
     4524   procedure fbrlib-get-recipe-type :
     4525   define input parameter p-fbr-doc-code   as character        no-undo.
     4526   define input parameter p-recipe-code    as character        no-undo.
     4527   define output parameter p-recipe-type   as character        no-undo.
     4528       define buffer buf_recipe        for ub.recipe.
     4529       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     4530   do
     4531   for buf_recipe
     4532     , buf_fbr-recipe
     4533   on error undo, return error
     4534   :
     4535       if p-fbr-doc-code = ""
     4536       then do:
     4537           find first buf_recipe no-lock
     4538                where buf_recipe.recipe-code = p-recipe-code
     4539           no-error.
     4540           if available buf_recipe
     4541           then do:
     4542               assign
     4543                   p-recipe-type = buf_recipe.recipe-type
     4544               .
     4545           end.
     4546           else do:
     4547               assign
     4548                   p-recipe-type = "":U
     4549               .
     4550           end.
     4551       end.
     4552       else do:
     4553           find first buf_fbr-recipe no-lock
     4554                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     4555                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     4556           no-error.
     4557           if available buf_fbr-recipe
     4558           then do:
     4559               assign
     4560                   p-recipe-type = buf_fbr-recipe.recipe-type
     4561               .
     4562           end.
     4563           else do:
     4564               assign
     4565                   p-recipe-type = "":U
     4566               .
     4567           end.
     4568       end.
     4569   end.
     4570   end procedure.
     4571   PROCEDURE calc-comp-from-ingr :
     4572   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     4573   define input parameter p-fact-qnty                          as decimal      no-undo.
     4574   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     4575   define output parameter p-comp-qnty                         as decimal      no-undo.
     4576       define variable v-ingr-qnty     as decimal       no-undo.
     4577       define buffer buf_i_fbr-line    for ub.fbr-line.
     4578       define buffer buf_fbr-line      for ub.fbr-line.
     4579       define buffer buf_recipe        for ub.fbr-recipe.
     4580       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     4581   do
     4582   for buf_i_fbr-line
     4583     , buf_fbr-line
     4584     , buf_recipe
     4585     , buf_recipe-gds
     4586   on error undo, return error
     4587   :
     4588       find first buf_i_fbr-line no-lock
     4589            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     4590       .
     4591       find first buf_recipe no-lock
     4592            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     4593              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     4594       no-error.
     4595       if not available buf_recipe
     4596       then do:
     4597           message
     4598                   vss-workfile vss-revision vss-description
     4599               skip "В строке производства не указан рецепт."
     4600               skip "Невозможно рассчитать количество составного товара."
     4601               skip return-value
     4602               skip trim(error-status :get-message(1))
     4603                   trim(error-status :get-message(2))
     4604                   trim(error-status :get-message(3))
     4605           view-as alert-box error.
     4606           undo, return error .
     4607       end.
     4608       if buf_recipe.recipe-type = 'альтернатива':U
     4609       then do:
     4610           for each buf_fbr-line no-lock
     4611              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4612                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     4613                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4614           on error undo, return error
     4615           :
     4616               find first buf_recipe-gds no-lock
     4617                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4618                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4619                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     4620                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     4621                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     4622               .
     4623               assign
     4624                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     4625               .
     4626           end.
     4627           assign
     4628               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     4629           .
     4630       end.
     4631       else do:
     4632           find first buf_recipe-gds no-lock
     4633                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     4634                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     4635                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     4636                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     4637                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     4638           .
     4639           assign
     4640               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     4641           .
     4642       end.
     4643       find first buf_fbr-line no-lock
     4644            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     4645              and buf_fbr-line.is-comp     = yes
     4646              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     4647       .
     4648       assign
     4649           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     4650       .
     4651   end.
     4652   END PROCEDURE.
     4653   PROCEDURE get-temp_dressing-ingr-used-qnty :
     4654   define input parameter p-recipe-code    as character    no-undo.
     4655   define input parameter p-gds-code       as integer      no-undo.
     4656   define output parameter p-line-qnty     as decimal      no-undo.
     4657   define output parameter p-used-qnty     as decimal      no-undo.
     4658   define output parameter p-recipe-qnty   as decimal      no-undo.
     4659       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     4660   do
     4661   for buf_temp_dressing-ingr
     4662   on error undo, return error
     4663   :
     4664       find first buf_temp_dressing-ingr no-lock
     4665            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     4666              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     4667       no-error.
     4668       if available buf_temp_dressing-ingr
     4669       then do:
     4670           assign
     4671               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     4672               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     4673               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     4674           .
     4675       end.
     4676       else do:
     4677           assign
     4678               p-line-qnty     = 0
     4679               p-used-qnty     = 0
     4680               p-recipe-qnty   = 0
     4681           .
     4682       end.
     4683   end.
     4684   END PROCEDURE.
     4685   PROCEDURE fbrlib_adjust-recipe :
     4686   do
     4687   on error undo, return error
     4688   :
     4689   define input parameter parparentproc as widget-handle no-undo .
     4690   define input parameter p-fbrhist-handle as handle no-undo .
     4691   define input parameter p-doc-code       as character    no-undo.
     4692   define input parameter p-recipe-code    as character    no-undo.
     4693   define input parameter p-price-sale-obj-type as character no-undo .
     4694   define input parameter p-price-sale-obj-code as integer no-undo .
     4695       define variable v-recipe-qnty       as decimal      no-undo.
     4696       define variable v-comp-qnty         as decimal      no-undo.
     4697       define variable v-recipe-gds-qnty   as decimal      no-undo.
     4698       define variable v-ingr-qnty         as decimal      no-undo.
     4699       define variable v-qnty              as decimal      no-undo.
     4700       define variable v-coeff-waste       as decimal      no-undo.
     4701       define variable v-brutto-qnty       as decimal      no-undo.
     4702       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4703       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4704       define buffer buf_fbr-line          for ub.fbr-line.
     4705       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     4706       find first buf_fbr-recipe no-lock
     4707            where buf_fbr-recipe.doc-code      = p-doc-code
     4708              and buf_fbr-recipe.recipe-code   = p-recipe-code
     4709       .
     4710       assign
     4711           v-recipe-qnty = buf_fbr-recipe.qnty
     4712       .
     4713       find first buf_fbr-line no-lock
     4714            where buf_fbr-line.doc-code    = p-doc-code
     4715              and buf_fbr-line.is-comp     = yes
     4716              and buf_fbr-line.recipe-code = p-recipe-code
     4717       .
     4718       assign
     4719           v-comp-qnty = buf_fbr-line.fact-qnty
     4720       .
     4721       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4722       then do:
     4723       end.
     4724       else do:
     4725           for each buf_fbr-recipe-gds no-lock
     4726              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4727                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4728           on error undo, return error
     4729           :
     4730               find first buf_fbr-line no-lock
     4731                    where buf_fbr-line.doc-code    = p-doc-code
     4732                      and buf_fbr-line.is-comp     = no
     4733                      and buf_fbr-line.recipe-code = p-recipe-code
     4734                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4735                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4736                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4737               .
     4738               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     4739               then do:
     4740                   do transaction
     4741                   on error undo, return error
     4742                   :
     4743                       find first buf_el_fbr-recipe-gds exclusive-lock
     4744                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     4745                       .
     4746                       assign
     4747                           buf_el_fbr-recipe-gds.calc-method   = 1
     4748                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     4749                       .
     4750                       run fbrlib-calc-brutto in this-procedure (
     4751                             input buf_fbr-recipe.recipe-type
     4752                           , input 0
     4753                           , input buf_el_fbr-recipe-gds.coeff-value
     4754                           , input buf_el_fbr-recipe-gds.coeff-waste
     4755                           , input buf_el_fbr-recipe-gds.brutto-qnty
     4756                           , input 1
     4757                           , output buf_el_fbr-recipe-gds.qnty
     4758                           , output buf_el_fbr-recipe-gds.coeff-waste
     4759                           , output buf_el_fbr-recipe-gds.brutto-qnty
     4760                           , output buf_el_fbr-recipe-gds.calc-method
     4761                       ).
     4762                   end.
     4763               end.
     4764           end.
     4765           run fbrlib_adjust-doc-lines in this-procedure (
     4766                 input parparentproc
     4767               , input p-fbrhist-handle
     4768               , input p-doc-code
     4769               , input p-recipe-code
     4770               , input p-price-sale-obj-type
     4771               , input p-price-sale-obj-code
     4772           ).
     4773       end.
     4774   end.
     4775   END PROCEDURE.
     4776   PROCEDURE fbrlib_adjust-doc-lines :
     4777   define input parameter parparentproc as widget-handle no-undo .
     4778   define input parameter p-fbrhist-handle as handle no-undo .
     4779   define input parameter p-doc-code       as character    no-undo.
     4780   define input parameter p-recipe-code    as character    no-undo.
     4781   define input parameter p-price-sale-obj-type as character no-undo .
     4782   define input parameter p-price-sale-obj-code as integer no-undo .
     4783   define variable v-comp-qnty         as decimal      no-undo.
     4784   define variable v-trn-type          as character    no-undo.
     4785   define variable v-ingr-qnty         as decimal      no-undo.
     4786   define variable v-recipe-qnty       as decimal      no-undo.
     4787   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     4788   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4789   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4790   define buffer buf_fbr-line          for ub.fbr-line.
     4791   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     4792   define buffer buf_goods             for ub.goods.
     4793   define buffer buf_fbr-doc           for ub.fbr-doc.
     4794   do
     4795   for buf_fbr-recipe
     4796     , buf_fbr-recipe-gds
     4797     , buf_fbr-line
     4798     , buf_coeff_fbr-line
     4799     , buf_goods
     4800     , buf_fbr-doc
     4801   on error undo, return error
     4802   :
     4803       find first buf_fbr-line no-lock
     4804            where buf_fbr-line.doc-code      = p-doc-code
     4805              and buf_fbr-line.is-comp       = yes
     4806              and buf_fbr-line.recipe-code   = p-recipe-code
     4807       .
     4808       find first buf_fbr-doc no-lock
     4809            where buf_fbr-doc.doc-code      = p-doc-code
     4810       .
     4811       assign
     4812           v-comp-qnty = buf_fbr-line.fact-qnty
     4813           v-trn-type  = buf_fbr-line.trn-type
     4814       .
     4815       find first buf_fbr-recipe no-lock
     4816            where buf_fbr-recipe.doc-code    = p-doc-code
     4817              and buf_fbr-recipe.recipe-code = p-recipe-code
     4818       .
     4819       assign
     4820       v-recipe-qnty = buf_fbr-recipe.qnty
     4821       .
     4822       do transaction
     4823       on error undo, return error
     4824       :
     4825           for each buf_fbr-recipe-gds no-lock
     4826              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     4827                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     4828           on error undo, return error
     4829           :
     4830               find first buf_fbr-line no-lock
     4831                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4832                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4833                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4834                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4835                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4836               no-error.
     4837               if not available buf_fbr-line
     4838               then do:
     4839                   find first buf_goods no-lock
     4840                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     4841                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     4842                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     4843                   .
     4844                   run str/fbr-crln.p (
     4845                         input parparentproc
     4846                       , input recid( buf_fbr-doc )
     4847                       , input recid( buf_goods )
     4848                       , input buf_fbr-recipe-gds.recipe-code
     4849                       , input v-trn-type
     4850                       , input no
     4851                       , input no
     4852                       , input buf_fbr-doc.obj-type
     4853                       , input buf_fbr-doc.obj-code
     4854                       , output v-fbr-v-fbr-doc-line-recid
     4855                   ).
     4856                   find first buf_fbr-line no-lock
     4857                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4858                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4859                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4860                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4861                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4862                   no-error.
     4863                   if not available buf_fbr-line
     4864                   then do:
     4865                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     4866                                                      , p-doc-code
     4867                                                      , buf_fbr-recipe-gds.artic
     4868                                                      , buf_fbr-recipe-gds.prod-type
     4869                                                      , buf_fbr-recipe-gds.prod-code).
     4870                   end.
     4871               end.
     4872               find first buf_coeff_fbr-line exclusive-lock
     4873                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     4874               .
     4875               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     4876               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     4877               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     4878               then do:
     4879                   assign
     4880                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     4881                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     4882                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     4883                   .
     4884               end.
     4885           end.
     4886       end.
     4887       define variable v-need-goods    as logical       no-undo.
     4888       define variable v-need-goods-list       as character     no-undo.
     4889       define variable v-need-goods-qnty-list  as character     no-undo.
     4890       find first buf_fbr-line no-lock
     4891            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     4892              and buf_fbr-line.is-comp     = yes
     4893              and buf_fbr-line.recipe-code = p-recipe-code
     4894       .
     4895       run str/fbr-qnty.p (
     4896             input parparentproc
     4897           , input p-fbrhist-handle
     4898           , input recid( buf_fbr-doc )
     4899           , input recid( buf_fbr-line )
     4900           , input no
     4901           , input "ingr"
     4902           , input no
     4903           , input p-price-sale-obj-type
     4904           , input p-price-sale-obj-code
     4905           , input no
     4906           , input no
     4907           , input no
     4908           , output v-need-goods
     4909           , output v-need-goods-list
     4910           , output v-need-goods-qnty-list
     4911       ).
     4912   end.
     4913   END PROCEDURE.
     4914   procedure fbrlib_check-before-close :
     4915   define input parameter p-doc-code as character no-undo .
     4916   define variable same-sale as decimal no-undo .
     4917   define variable is-waste as logical no-undo .
     4918   define variable fix-price as logical no-undo .
     4919   define buffer buf_fbr-doc for ub.fbr-doc.
     4920   define buffer buf_fbr-line for ub.fbr-line.
     4921   define buffer buf_goods for ub.goods.
     4922   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4923   do
     4924   on error undo, return error
     4925   :
     4926     for each buf_fbr-line no-lock
     4927         where buf_fbr-line.doc-code = p-doc-code
     4928       , each buf_goods no-lock
     4929         where buf_goods.artic     = buf_fbr-line.artic
     4930           and buf_goods.prod-type = buf_fbr-line.prod-type
     4931           and buf_goods.prod-code = buf_fbr-line.prod-code
     4932     break by buf_fbr-line.prod-type
     4933           by buf_fbr-line.prod-code
     4934           by buf_fbr-line.artic
     4935     :
     4936       if first-of (buf_fbr-line.artic)
     4937       then do:
     4938         assign
     4939         same-sale = buf_fbr-line.price-sale
     4940         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     4941         fix-price = buf_fbr-line.is-calc
     4942         .
     4943       end.
     4944       if same-sale <> buf_fbr-line.price-sale
     4945       then do:
     4946           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     4947                                         ,p-doc-code
     4948                                         ,buf_goods.artic
     4949                                         ,buf_goods.gds-name
     4950                                         ,chr(10)).
     4951       end.
     4952       if fix-price <> buf_fbr-line.is-calc then do:
     4953           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     4954                                         ,p-doc-code
     4955                                         ,buf_goods.artic
     4956                                         ,buf_goods.gds-name
     4957                                         ,chr(10)).
     4958       end.
     4959       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     4960       then do:
     4961         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     4962                                         ,p-doc-code
     4963                                         ,buf_goods.artic
     4964                                         ,buf_goods.gds-name
     4965                                         ,chr(10)).
     4966       end.
     4967       if buf_fbr-line.rsrv-qnty <> ?
     4968       and buf_goods.gds-type <> 'у':U
     4969       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     4970       and buf_fbr-line.fact-qnty <> 0
     4971       then do:
     4972         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     4973           if  can-find(first buf_fbr-gds-obj no-lock where
     4974                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     4975               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     4976               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     4977               and buf_fbr-gds-obj.is-null-price  )  then .
     4978                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4979                                         ,p-doc-code
     4980                                         ,buf_goods.artic
     4981                                         ,buf_goods.gds-name
     4982                                         ,chr(10)
     4983                                         ,buf_fbr-line.recipe-code
     4984                                         ).
     4985         end.
     4986         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4987                                         ,p-doc-code
     4988                                         ,buf_goods.artic
     4989                                         ,buf_goods.gds-name
     4990                                         ,chr(10)
     4991                                         ,buf_fbr-line.recipe-code
     4992                                         ).
     4993       end.
     4994     end.
     4995   end.
     4996   end procedure.
     4997   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4998     define variable v-cntxt-db-num        as integer   no-undo .
     4999     define variable v-cntxt-userid        as character no-undo .
     5000     define variable v-cntxt-level         as character no-undo .
     5001     define variable v-cntxt-host-code-obj as integer   no-undo .
     5002     define variable v-cntxt-obj-type      as character no-undo .
     5003     define variable v-cntxt-obj-code      as integer   no-undo .
     5004     define variable v-cntxt-db-num-obj    as integer   no-undo .
     5005     define variable v-cntxt-is-admin      as logical   no-undo .
     5006   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5007   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     5008       define variable v-upper-code as int no-undo.
     5009       define variable v-value as character no-undo.
     5010       define variable v-type as character no-undo.
     5011       define buffer lc_gds-grp for ub.gds-grp.
     5012       define buffer lc_goods for ub.goods.
     5013      if p-gds-code <> 0 then do:
     5014       find first lc_goods where lc_goods.gds-code = p-gds-code.
     5015       v-upper-code = lc_goods.grp-code.
     5016       do while v-upper-code > 0 :
     5017           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     5018           run ggoattr-value(
     5019             input lc_gds-grp.node-code,
     5020             input 0,
     5021             input "",
     5022             input 0,
     5023             input 'ban-sales-via-cd':U,
     5024             output v-value,
     5025             output v-type
     5026           ).
     5027          if v-value = "yes" then
     5028             return true.
     5029          else
     5030          do:
     5031             run ggoattr-value(
     5032                input lc_gds-grp.node-code,
     5033                input v-cntxt-host-code-obj,
     5034                input "",
     5035                input 0,
     5036                input 'ban-sales-via-cd':U,
     5037                output v-value,
     5038                output v-type
     5039                ).
     5040             if v-value = "yes" then
     5041                return true.
     5042             else
     5043             do:
     5044                run ggoattr-value(
     5045                   input lc_gds-grp.node-code,
     5046                   input v-cntxt-host-code-obj,
     5047                   input v-cntxt-obj-type,
     5048                   input v-cntxt-obj-code,
     5049                   input 'ban-sales-via-cd':U,
     5050                   output v-value,
     5051                   output v-type
     5052                   ).
     5053                if v-value = "yes" then
     5054                   return true.
     5055                else v-upper-code = lc_gds-grp.upper-code.
     5056             end .
     5057          end.
     5058         end.
     5059       end.
     5060       if v-value = "" or logical(v-value) = false then return false .
     5061   end.
     5062   FUNCTION check-ban-sales-via-cd-grp return logical ( input p-grp-code as integer ) :
     5063       define variable v-upper-code as int no-undo.
     5064       define variable v-value as character no-undo.
     5065       define variable v-type as character no-undo.
     5066       define buffer lc_gds-grp for ub.gds-grp.
     5067       define buffer lc_goods for ub.goods.
     5068       v-upper-code = p-grp-code.
     5069       do while v-upper-code > 0 :
     5070           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     5071           run ggoattr-value(
     5072             input lc_gds-grp.node-code,
     5073             input 0,
     5074             input "",
     5075             input 0,
     5076             input 'ban-sales-via-cd':U,
     5077             output v-value,
     5078             output v-type
     5079           ).
     5080          if v-value = "yes" then
     5081             return true.
     5082          else
     5083          do:
     5084             run ggoattr-value(
     5085                input lc_gds-grp.node-code,
     5086                input v-cntxt-host-code-obj,
     5087                input "",
     5088                input 0,
     5089                input 'ban-sales-via-cd':U,
     5090                output v-value,
     5091                output v-type
     5092                ).
     5093             if v-value = "yes" then
     5094                return true.
     5095             else
     5096             do:
     5097                run ggoattr-value(
     5098                   input lc_gds-grp.node-code,
     5099                   input v-cntxt-host-code-obj,
     5100                   input v-cntxt-obj-type,
     5101                   input v-cntxt-obj-code,
     5102                   input 'ban-sales-via-cd':U,
     5103                   output v-value,
     5104                   output v-type
     5105                   ).
     5106                if v-value = "yes" then
     5107                   return true.
     5108                else v-upper-code = lc_gds-grp.upper-code.
     5109             end .
     5110          end.
     5111         end.
     5112   end.
