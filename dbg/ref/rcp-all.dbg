     1871   procedure grp-obj-notcorr-value :
     1872   do
     1873   on error undo, return error
     1874   :
     1875   define input parameter p-node-code             as integer      no-undo.
     1876   define input parameter p-obj-type              as character    no-undo.
     1877   define input parameter p-obj-code              as integer      no-undo.
     1878   define output parameter p-notcorr              as character    no-undo init ?.
     1879   define output parameter p-range-notcorr     as integer      no-undo.
     1880   define output parameter p-exists-notcorr    as logical      no-undo.
     1881   define variable v-host-code as integer      no-undo.
     1882   DEFINE VARIABLE v-found as logical no-undo .
     1883   DEFINE VARIABLE v-exists as logical no-undo .
     1884   DEFINE VARIABLE v-range as integer no-undo .
     1885   DEFINE VARIABLE jj as integer no-undo .
     1886   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     1887   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     1888   define buffer buf_gds-grp for ub.gds-grp.
     1889   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1890   find first buf_gds-grp no-lock where
     1891              buf_gds-grp.node-code = p-node-code no-error .
     1892   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1893     message
     1894       vss-workfile vss-revision vss-description
     1895       skip "Не удалось найти группу товаров с кодом" p-node-code
     1896       view-as alert-box error .
     1897     undo, return error .
     1898   end.
     1899   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1900   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1901     (input  p-obj-type
     1902     ,input  p-obj-code
     1903     ,output v-host-code
     1904     ) no-error .
     1905   if error-status :error
     1906   then do:
     1907       message
     1908         vss-workfile vss-revision vss-description
     1909         skip "Не удалось найти фирму объекта"
     1910         skip p-obj-type p-obj-code
     1911         skip return-value
     1912         skip trim(error-status :get-message(1))
     1913       view-as alert-box error.
     1914       undo, return error .
     1915   end.
     1916   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1917   do while v-found = no and jj < 2:
     1918     if v-range <> 3 then do:
     1919       find first buf_gds-grp-obj no-lock
     1920           where buf_gds-grp-obj.node-code = p-node-code
     1921             and buf_gds-grp-obj.host-code = v-host-code
     1922             and buf_gds-grp-obj.obj-type  = p-obj-type
     1923             and buf_gds-grp-obj.obj-code  = p-obj-code
     1924       no-error .
     1925     end.
     1926     if v-range = 3 or not available buf_gds-grp-obj
     1927     then do:
     1928        if v-range <> 2 then do:
     1929           find first buf_gds-grp-obj no-lock
     1930               where buf_gds-grp-obj.node-code = p-node-code
     1931                 and buf_gds-grp-obj.host-code = v-host-code
     1932                 and buf_gds-grp-obj.obj-type  = ""
     1933                 and buf_gds-grp-obj.obj-code  = 0
     1934           no-error .
     1935         end.
     1936         if v-range = 2 or not available buf_gds-grp-obj
     1937         then do:
     1938             if v-range <> 1 then do:
     1939               find first buf_gds-grp-obj no-lock
     1940                   where buf_gds-grp-obj.node-code = p-node-code
     1941                   and buf_gds-grp-obj.host-code = 0
     1942                   and buf_gds-grp-obj.obj-type  = ""
     1943                   and buf_gds-grp-obj.obj-code  = 0
     1944               no-error .
     1945             end.
     1946             if v-range = 1 or not available buf_gds-grp-obj
     1947             then do:
     1948                 assign
     1949                     v-exists = no
     1950                 .
     1951             end.
     1952             else do:
     1953                 assign
     1954                     v-exists = yes
     1955                     v-range = 1
     1956                 .
     1957             end.
     1958         end.
     1959         else do:
     1960             assign
     1961                 v-exists = yes
     1962                 v-range  = 2
     1963             .
     1964         end.
     1965     end.
     1966     else do:
     1967         assign
     1968             v-exists = yes
     1969             v-range  = 3
     1970         .
     1971     end.
     1972     if available buf_gds-grp-obj
     1973     then do:
     1974       find first buf_gds-grp-obj-attr no-lock
     1975         where buf_gds-grp-obj-attr.node-code   = p-node-code
     1976           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     1977           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     1978           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     1979           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     1980         no-error .
     1981       if available buf_gds-grp-obj-attr then do:
     1982         assign
     1983           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     1984         .
     1985       end.
     1986       else do:
     1987         assign
     1988           v-notcorr-value = ?
     1989         .
     1990       end.
     1991       assign
     1992       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     1993                           then yes
     1994                           else p-exists-notcorr)
     1995       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     1996                         then v-range
     1997                         else p-range-notcorr
     1998       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     1999                         then v-notcorr-value
     2000                         else p-notcorr
     2001       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     2002       jj = jj + 1
     2003       .
     2004     end.
     2005     else do:
     2006       assign
     2007       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     2008       jj = jj + 1
     2009       .
     2010     end.
     2011   end.
     2012   end.
     2013   end procedure.
