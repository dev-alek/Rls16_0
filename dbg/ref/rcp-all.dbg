     7939                             and ub.recipe.obj-type = p-store-type
     7940                             and ub.recipe.obj-code = p-store-code
     7941                     ) use-index gds
     7942                   ,first ub.goods no-lock
     7943                     where ub.goods.artic = ub.recipe.artic
     7944                       and ub.goods.prod-type = ub.recipe.prod-type
     7945                       and ub.goods.prod-code = ub.recipe.prod-code
     7946                   ,first ub.clients no-lock
     7947                     where ub.clients.obj-type = ub.recipe.prod-type
     7948                       and ub.clients.obj-code = ub.recipe.prod-code
     7949                 by ub.recipe.recipe-order
     7950                 .
     7951               end.
     7952             end.
     7953             else do:
