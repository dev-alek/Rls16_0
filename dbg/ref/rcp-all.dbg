        4   define input  parameter bttns             as character    no-undo.
        5   define input  parameter call-mode         as character    no-undo.
        6   define input  parameter p-goods-recid     as recid        no-undo.
        7   define input  parameter p-store-type      as character    no-undo.
        8   define input  parameter p-store-code      as integer      no-undo.
        9   define output parameter rid-list          as character    no-undo.
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
