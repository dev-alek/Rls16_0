     9419                            where recid( ub.recipe-gds ) = v-recipe-gds-recid
     9420                           , each ub.recipe no-lock
     9421                            where ub.recipe.recipe-type = recipetype
     9422                                     and ( ( ub.recipe.host-code = 0
     9423                                             and ub.recipe.obj-type = ""
     9424                                             and ub.recipe.obj-code = 0
     9425                                         ) or ( ub.recipe.host-code = v-host-code
     9426                                             and ub.recipe.obj-type = p-store-type
     9427                                             and ub.recipe.obj-code = p-store-code
     9428                                             ) )
     9429                             use-index pi
     9430                          , first ub.goods no-lock
     9431                            where ub.goods.artic = ub.recipe.artic
     9432                              and ub.goods.prod-type = ub.recipe.prod-type
     9433                              and ub.goods.prod-code = ub.recipe.prod-code
     9434                              and ub.goods.gds-name begins nameorcode
     9435                          , first ub.clients no-lock
     9436                            where ub.clients.obj-type = ub.recipe.prod-type
     9437                              and ub.clients.obj-code = ub.recipe.prod-code
     9438                         .
     9439                     end.
     9440                       if recipeprop = "global" then do :
     9441                         open query br-recipe
     9442                         for each ub.recipe-gds no-lock
     9443                            where recid( ub.recipe-gds ) = v-recipe-gds-recid
     9444                           , each ub.recipe no-lock
     9445                            where ub.recipe.recipe-type = recipetype
     9446                                     and ( ub.recipe.host-code = 0
     9447                                             and ub.recipe.obj-type = ""
     9448                                             and ub.recipe.obj-code = 0
     9449                                         )
     9450                             use-index pi
     9451                          , first ub.goods no-lock
     9452                            where ub.goods.artic = ub.recipe.artic
     9453                              and ub.goods.prod-type = ub.recipe.prod-type
     9454                              and ub.goods.prod-code = ub.recipe.prod-code
     9455                              and ub.goods.gds-name begins nameorcode
     9456                          , first ub.clients no-lock
     9457                            where ub.clients.obj-type = ub.recipe.prod-type
     9458                              and ub.clients.obj-code = ub.recipe.prod-code
     9459                         .
     9460                 end.
     9461                       if recipeprop = "local" then do :
     9462                         open query br-recipe
     9463                         for each ub.recipe-gds no-lock
     9464                            where recid( ub.recipe-gds ) = v-recipe-gds-recid
     9465                           , each ub.recipe no-lock
     9466                            where ub.recipe.recipe-type = recipetype
     9467                                     and ( ub.recipe.host-code = v-host-code
     9468                                             and ub.recipe.obj-type = p-store-type
     9469                                             and ub.recipe.obj-code = p-store-code
     9470                                             )
     9471                             use-index pi
     9472                          , first ub.goods no-lock
     9473                            where ub.goods.artic = ub.recipe.artic
     9474                              and ub.goods.prod-type = ub.recipe.prod-type
     9475                              and ub.goods.prod-code = ub.recipe.prod-code
     9476                              and ub.goods.gds-name begins nameorcode
     9477                          , first ub.clients no-lock
     9478                            where ub.clients.obj-type = ub.recipe.prod-type
     9479                              and ub.clients.obj-code = ub.recipe.prod-code
     9480                         .
     9481                       end.
     9482                     end.
     9483                 end.
     9484                 when "recipe-gds":u then do :
     9485                     if p-goods-recid <> ? then do :
     9486                       if recipeprop = "all" then do :
     9487                         open query br-recipe
     9488                         for each ub.recipe-gds no-lock
     9489                            where ub.recipe-gds.artic      = b-goods.artic
     9490                              and ub.recipe-gds.prod-type  = b-goods.prod-type
     9491                              and ub.recipe-gds.prod-code  = b-goods.prod-code
     9492                          , first ub.recipe no-lock
     9493                            where ub.recipe.recipe-code = ub.recipe-gds.recipe-code
     9494                              and ub.recipe.recipe-type = recipetype
     9495                                     and ( ( ub.recipe.host-code = 0
     9496                                             and ub.recipe.obj-type = ""
     9497                                             and ub.recipe.obj-code = 0
     9498                                         ) or ( ub.recipe.host-code = v-host-code
     9499                                             and ub.recipe.obj-type = p-store-type
     9500                                             and ub.recipe.obj-code = p-store-code
     9501                                             ) )
     9502                            use-index pi
     9503                          , first ub.goods no-lock
     9504                            where ub.goods.artic = ub.recipe.artic
     9505                              and ub.goods.prod-type = ub.recipe.prod-type
     9506                              and ub.goods.prod-code = ub.recipe.prod-code
     9507                              and ub.goods.gds-name begins nameorcode
     9508                          , first ub.clients no-lock
     9509                            where ub.clients.obj-type = ub.recipe.prod-type
     9510                              and ub.clients.obj-code = ub.recipe.prod-code
     9511                          .
     9512                     end.
     9513                       if recipeprop = "global" then do :
     9514                         open query br-recipe
     9515                         for each ub.recipe-gds no-lock
     9516                            where ub.recipe-gds.artic      = b-goods.artic
     9517                              and ub.recipe-gds.prod-type  = b-goods.prod-type
     9518                              and ub.recipe-gds.prod-code  = b-goods.prod-code
     9519                          , first ub.recipe no-lock
     9520                            where ub.recipe.recipe-code = ub.recipe-gds.recipe-code
     9521                              and ub.recipe.recipe-type = recipetype
     9522                                     and ( ub.recipe.host-code = 0
     9523                                             and ub.recipe.obj-type = ""
     9524                                             and ub.recipe.obj-code = 0
     9525                                         )
     9526                            use-index pi
     9527                          , first ub.goods no-lock
     9528                            where ub.goods.artic = ub.recipe.artic
     9529                              and ub.goods.prod-type = ub.recipe.prod-type
     9530                              and ub.goods.prod-code = ub.recipe.prod-code
     9531                              and ub.goods.gds-name begins nameorcode
     9532                          , first ub.clients no-lock
     9533                            where ub.clients.obj-type = ub.recipe.prod-type
     9534                              and ub.clients.obj-code = ub.recipe.prod-code
     9535                          .
     9536                       end.
     9537                       if recipeprop = "local" then do :
     9538                         open query br-recipe
     9539                         for each ub.recipe-gds no-lock
     9540                            where ub.recipe-gds.artic      = b-goods.artic
     9541                              and ub.recipe-gds.prod-type  = b-goods.prod-type
     9542                              and ub.recipe-gds.prod-code  = b-goods.prod-code
     9543                          , first ub.recipe no-lock
     9544                            where ub.recipe.recipe-code = ub.recipe-gds.recipe-code
     9545                              and ub.recipe.recipe-type = recipetype
     9546                                     and ( ub.recipe.host-code = v-host-code
     9547                                             and ub.recipe.obj-type = p-store-type
     9548                                             and ub.recipe.obj-code = p-store-code
     9549                                             )
     9550                            use-index pi
     9551                          , first ub.goods no-lock
     9552                            where ub.goods.artic = ub.recipe.artic
     9553                              and ub.goods.prod-type = ub.recipe.prod-type
     9554                              and ub.goods.prod-code = ub.recipe.prod-code
     9555                              and ub.goods.gds-name begins nameorcode
     9556                          , first ub.clients no-lock
     9557                            where ub.clients.obj-type = ub.recipe.prod-type
     9558                              and ub.clients.obj-code = ub.recipe.prod-code
     9559                          .
     9560                       end.
     9561                     end.
     9562                  end.
     9563             end case.
     9564     end case .
     9565   end.
     9566   if session :set-wait-state( "" ) then.
     9567   apply "value-changed" to br-recipe in frame dialog-frame.
     9568   apply "entry" to br-recipe in frame dialog-frame.
     9569   return no-apply.
     9570   end procedure.
     9571   procedure disable_ui :
     9572     hide frame dialog-frame.
     9573   end procedure.
     9574   procedure enable_ui :
     9575     define variable v-obj-is-active    as logical        no-undo.
     9576     define variable v-have-rights      as logical        no-undo.
     9577   do
     9578   on error undo, return error
     9579   :
     9580   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9581   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     9582     (input  p-store-type
     9583     ,input  p-store-code
     9584     ,input  'active=request'
     9585     ,output v-obj-is-active
     9586     ) no-error .
     9587       if error-status :error
     9588       then do:
     9589           message
     9590               vss-workfile vss-revision vss-description
     9591               skip "Не удалось определить активность объекта."
     9592               skip "Объект" v-cntxt-obj-type v-cntxt-obj-code
     9593               skip return-value
     9594               skip error-status :get-message(1)
     9595           view-as alert-box error .
     9596           undo, return error .
     9597       end.
     9598       if can-do( bttns, "b-add" )
     9599       and can-do( "all":u, find-by )
     9600       and can-do( "all":u, recipetype )
     9601       and v-obj-is-active = yes
     9602       then do:
     9603           enable
     9604               b-add
     9605               b-del when not can-do (bttns, "nb-del")
     9606               b-chg when not can-do (bttns, "nb-chg")
     9607               b-copy when not can-do (bttns, "nb-copy")
     9608               b-set-default when p-goods-recid <> ?
     9609               b-down when p-goods-recid <> ?
     9610               b-up when p-goods-recid <> ?
     9611           with frame dialog-frame.
     9612       end.
     9613       else do:
     9614           if can-do( "all":u, find-by )
     9615           and can-do( "all":u, recipetype )
     9616           and v-obj-is-active = yes
     9617           then do:
     9618               enable
     9619                   b-set-default when p-goods-recid <> ?
     9620                   b-down when p-goods-recid <> ?
     9621                   b-up when p-goods-recid <> ?
     9622               with frame dialog-frame.
     9623           end.
     9624           else do:
     9625               disable
     9626                   b-add
     9627                   b-del
     9628                   b-chg
     9629                   b-copy
     9630                   b-set-default
     9631                   b-down
     9632                   b-up
     9633               with frame dialog-frame.
     9634           end.
     9635       end.
     9636       enable
     9637           br-recipe
     9638           b-lkp
     9639           b-exit
     9640           b-sel when can-do(  bttns, "b-sel" )
     9641           recipetype
     9642           recipeprop
     9643           find-by
     9644           nameorcode
     9645           table-find
     9646           b-print
     9647           b-hist
     9648           b-help
     9649       with frame dialog-frame.
     9650   define variable vss-include-info56 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9651   do:
     9652     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9653       (input  v-cntxt-db-num
     9654       ,input  v-cntxt-userid
     9655       ,input  0
     9656       ,input  'actn_recipe-reference_view_global':U
     9657       ,input  'global':U
     9658       ,input  0
     9659       ,input  '':U
     9660       ,input  0
     9661       ,input  0
     9662       ,input  0
     9663       ,input  0
     9664       ,input  true
     9665       ,output v-have-rights
     9666       )  .
     9667   end.
     9668       if not v-have-rights
     9669       then do :
     9670         recipeprop :disable ( radio-label("all",recipeprop :radio-buttons ) ) .
     9671         recipeprop :disable ( radio-label("global",recipeprop :radio-buttons ) ) .
     9672         recipeprop = "local" .
     9673       end.
     9674       if p-goods-recid <> ?
     9675       and lookup( 'вес':U, ub.units.type ) > 0
     9676       then do:
     9677           if call-mode = 'комплектация':U
     9678           then do:
     9679               disable
     9680                   recipetype
     9681               with frame dialog-frame.
     9682               assign
     9683                   menu-item m-type-1:label in menu m-types = "":U
     9684               .
     9685           end.
     9686           else do:
     9687               assign
     9688                   g#log = recipetype :disable ( radio-label( 'комплектация':U, recipetype :radio-buttons ) )
     9689                   menu-item m-type-1 :label in menu m-types = "":U
     9690               .
     9691           end.
     9692       end.
     9693       if p-goods-recid <> ?
     9694       and lookup('топ':U, ub.units.type) = 0
     9695       then do:
     9696           assign
     9697               g#log = recipetype :disable ( radio-label( 'топливо':U, recipetype :radio-buttons ) )
     9698               menu-item m-type-5 :label in menu m-types = "":U
     9699           .
     9700       end.
     9701       if p-goods-recid = ?
     9702       then do:
     9703           assign
     9704               table-find  = "recipe":U
     9705               log-res     = table-find :disable ( radio-label( "recipe-gds":U, table-find :radio-buttons ) )
     9706           .
     9707       end.
     9708       if p-goods-recid <> ?
     9709       and not table-find = "recipe-gds":U
     9710       then do:
     9711           assign
     9712               table-find = "recipe":U
     9713           .
     9714       end.
     9715       display
     9716           recipetype
     9717           recipeprop
     9718           table-find
     9719       with frame dialog-frame.
     9720       view frame dialog-frame.
     9721   end.
     9722   end procedure.
     9723   procedure check-recipe-lock :
     9724   define input parameter p-recipe-code        as character    no-undo.
     9725   define output parameter p-lock-not-enabled  as logical      no-undo.
     9726       define buffer buf_recipe        for ub.recipe.
     9727   do
     9728   for buf_recipe
     9729   on error undo, return error
     9730   :
     9731       find first buf_recipe exclusive-lock
     9732            where buf_recipe.recipe-code = p-recipe-code
     9733       no-error no-wait.
     9734       if not available buf_recipe
     9735       then do:
     9736           assign
     9737               p-lock-not-enabled = yes
     9738           .
     9739       end.
     9740   end.
     9741   end procedure.
     9742   procedure add-recipe :
     9743       define variable v-br-line-num       as integer      no-undo.
     9744       define variable v-recipe-code       as character    no-undo.
     9745       define variable v-yesno             as logical      no-undo.
     9746       define variable v-is-menu           as logical      no-undo.
     9747       define variable v-fbr-gds-obj-recid as recid        no-undo.
     9748       define variable v-goods-recid       as recid        no-undo.
     9749       define variable v-goods-recid-list  as character    no-undo.
     9750     define variable v-value   as character    no-undo.
     9751     define variable v-type    as character    no-undo.
     9752       define buffer buf_goods         for ub.goods.
     9753       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     9754       define buffer buf_recipe        for ub.recipe.
     9755   do
     9756   for buf_goods
     9757     , buf_fbr-gds-obj
     9758   on error undo, return error
     9759   :
     9760       if p-goods-recid = ?
     9761       then do:
     9762           run ref/gds-ref.p (
     9763                 input p-mainmenu-handle
     9764               , input "b-sel"
     9765               , input 'текущие':U
     9766               , input 'все':U
     9767               , input 'объект':U
     9768               , input ?
     9769               , input ?
     9770               , input ?
     9771               , input ?
     9772               , input p-store-type
     9773               , input p-store-code
     9774               , input ?
     9775               , output v-goods-recid-list
     9776           ).
     9777          if v-goods-recid-list <> ''
     9778             then
     9779          do:
     9780             assign
     9781                v-goods-recid = integer( entry( 1, v-goods-recid-list ) )
     9782                .
     9783             if ObjSrv:Env:ParametrsOfSection:GetSectionEDO(v-cntxt-obj-type, v-cntxt-obj-code):IsBanAltr then v-ban-altr = true .
     9784             if v-ban-altr then
     9785             do:
     9786                if recipetype = 'альтернатива':U or new-type = 'альтернатива':U then
     9787                do:
     9788                   for first ub.goods no-lock where recid (ub.goods) = v-goods-recid:
     9789                      if check-ban-sales-via-cd(ub.goods.gds-code) then
     9790                      do:
     9791                      end.
     9792                  end.
     9793               end.
     9794            end.
     9795         end.
     9796         else
     9797         do:
     9798            message
     9799               "Не выбран товар"
     9800               skip
     9801               "для создания рецепта."
     9802               view-as alert-box error.
     9803            undo, return.
     9804         end.
     9805      end.
     9806      else
     9807      do:
     9808         assign
     9809            v-goods-recid = p-goods-recid
     9810            .
     9811      end.
     9812       find first buf_goods no-lock
     9813            where recid( buf_goods ) = v-goods-recid
     9814       .
     9815   define variable vss-include-info57 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9816   do:
     9817     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     9818       (input  v-cntxt-db-num
     9819       ,input  v-cntxt-userid
     9820       ,input  0
     9821       ,input  'actn_recipe-reference_input-deletion-updating':U
     9822       ,input  'object':U
     9823       ,input  v-host-code
     9824       ,input  p-store-type
     9825       ,input  p-store-code
     9826       ,input  0
     9827       ,input  0
     9828       ,input  0
     9829       ,input  yes
     9830       ,output v-yesno
     9831       ) no-error .
     9832   end.
     9833       if error-status :error then do :
     9834         message
     9835           error-status :get-message(1)
     9836         view-as alert-box information.
     9837       end.
     9838       if v-yesno <> yes
     9839       then do:
     9840           undo, return error .
     9841       end.
     9842       if recipetype <> "all"
     9843       then do:
     9844           assign
     9845               new-type = recipetype
     9846           .
     9847       end.
     9848       else if new-type = ""
     9849       then do:
     9850           run gbl/pop-up.p (
     9851                 input self:handle
     9852               , input no
     9853           ) no-error.
     9854         if error-status:error
     9855         then do:
     9856             return.
     9857         end.
     9858       end.
     9859       do transaction
     9860       on error undo, return error
     9861       :
     9862           find first buf_fbr-gds-obj exclusive-lock
     9863                where buf_fbr-gds-obj.obj-type = p-store-type
     9864                  and buf_fbr-gds-obj.obj-code = p-store-code
     9865                  and buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     9866           no-error.
     9867           if new-type = 'производство':U
     9868           and ( not available buf_fbr-gds-obj
     9869                       or ( buf_fbr-gds-obj.is-menu = no
     9870                           and buf_fbr-gds-obj.is-semi-finished = no ) )
     9871           and p-store-type = 'маг':U
     9872           then do:
     9873               message
     9874                   "Рецепт производства можно создать только для товара"
     9875                   skip "с атрибутом блюдо или полуфабрикат."
     9876                   skip (1)
     9877                   skip "Поэтому будет создан атрибут товара:"
     9878                   skip (1)
     9879                   skip "Да - блюдо"
     9880                   skip "Нет  - полуфабрикат"
     9881                   skip "Отмена - отменить добавление рецепта"
     9882                   skip (1)
     9883                   skip "Выберите значение атрибута."
     9884               view-as alert-box question
     9885               buttons yes-no-cancel
     9886               title "Изменение атрибутов товара"
     9887               update v-yesno.
     9888               if v-yesno = ?
     9889               then do:
     9890                   undo, return error .
     9891               end.
     9892               if v-yesno = yes
     9893               then do:
     9894                   assign
     9895                       v-is-menu = yes
     9896                   .
     9897               end.
     9898               else do:
     9899                   assign
     9900                       v-is-menu = no
     9901                   .
     9902               end.
     9903               if available buf_fbr-gds-obj
     9904               then do:
     9905                   assign
     9906                       buf_fbr-gds-obj.is-menu          = v-is-menu
     9907                       buf_fbr-gds-obj.is-semi-finished = ( if v-is-menu = yes then no else yes )
     9908                   .
     9909               end.
     9910               else do:
     9911                   assign
     9912                       v-fbr-gds-obj-recid = ?
     9913                   .
     9914                   run ref/fgdsobj1.p (
     9915                         input-output v-fbr-gds-obj-recid
     9916                       , input 'ДОБАВЛЕНИЕ':U
     9917                       , input no
     9918                       , input buf_goods.gds-code
     9919                       , input p-store-type
     9920                       , input p-store-code
     9921                       , input 0
     9922                       , input p-store-type
     9923                       , input p-store-code
     9924                       , input no
     9925                       , input v-is-menu
     9926                       , input no
     9927                       , input no
     9928                       , input no
     9929                       , input ( if v-is-menu = yes then no else yes )
     9930                   ) no-error.
     9931                   if error-status:error
     9932                   then do:
     9933                       message
     9934                               vss-workfile vss-revision vss-description
     9935                           skip "Ошибка изменения атрибутов товара на объекте"
     9936                           skip return-value
     9937                           skip trim(error-status :get-message(1))
     9938                                   trim(error-status :get-message(2))
     9939                                   trim(error-status :get-message(3))
     9940                       view-as alert-box error.
     9941                       undo, return error .
     9942                   end.
     9943               end.
     9944           end.
     9945       end.
     9946       assign
     9947           ri = ?
     9948           v-can-set-global = true
     9949       .
     9950       run ref/recipe.w (
     9951           input p-mainmenu-handle
     9952           , input 'ДОБАВЛЕНИЕ':U
     9953           , input v-goods-recid
     9954           , input new-type
     9955           , input ""
     9956           , input v-host-code
     9957           , input p-store-type
     9958           , input p-store-code
     9959           , input ( v-cntxt-db-num = 0 )
     9960           , input v-can-set-global
     9961           , output v-recipe-code
     9962       ) no-error.
     9963       if error-status :error
     9964       then do:
     9965           message
     9966                   vss-workfile vss-revision vss-description
     9967               skip "Ошибка при добавлении рецепта."
     9968               skip return-value
     9969               skip "Артикул товара:" buf_goods.artic
     9970               skip trim(error-status :get-message(1))
     9971                   trim(error-status :get-message(2))
     9972                   trim(error-status :get-message(3))
     9973           view-as alert-box error.
     9974           undo, return no-apply .
     9975       end.
     9976       assign
     9977           new-type = "":U
     9978       .
     9979       if v-recipe-code <> "":U
     9980       then do:
     9981           run fbrlib-set-default-recipe in this-procedure (
     9982                 input p-store-type
     9983               , input p-store-code
     9984               , input buf_goods.gds-code
     9985           ).
     9986           run change-query .
     9987           if table-find = "recipe":U
     9988           then do:
     9989               get first br-recipe no-lock.
     9990               assign
     9991                   v-br-line-num = 1
     9992               .
     9993               if ub.recipe.recipe-code = v-recipe-code
     9994               then do:
     9995                   reposition br-recipe to row 1 no-error.
     9996               end.
     9997               else do:
     9998                   do while available ub.recipe-gds
     9999                   :
    10000                       get next br-recipe no-lock .
    10001                       assign
    10002                           v-br-line-num = v-br-line-num + 1
    10003                       .
    10004                       if ub.recipe.recipe-code = v-recipe-code
    10005                       then do:
    10006                           leave.
    10007                       end.
    10008                   end.
    10009               end.
    10010               reposition br-recipe to row v-br-line-num no-error.
    10011           end.
    10012       end.
    10013   end.
    10014   end procedure.
    10015   procedure copy-recipe :
    10016   define input parameter p-recipe-code        as character    no-undo.
    10017   define input parameter p-host-code          as integer      no-undo.
    10018   define input parameter p-store-type         as character    no-undo.
    10019   define input parameter p-store-code         as integer      no-undo.
    10020   define output parameter p-new-recipe-rowid  as rowid        no-undo.
    10021       define buffer buf_recipe            for ub.recipe.
    10022       define buffer buf_recipe-gds        for ub.recipe-gds.
    10023       define buffer buf_copy_recipe       for ub.recipe.
    10024       define buffer buf_copy_recipe-gds   for ub.recipe-gds.
    10025   do
    10026   for buf_recipe
    10027     , buf_recipe-gds
    10028     , buf_copy_recipe
    10029     , buf_copy_recipe-gds
    10030   on error undo, return error
    10031   :
    10032       find first buf_recipe no-lock
    10033            where buf_recipe.recipe-code = p-recipe-code
    10034       .
    10035       do transaction
    10036       on error undo, return error
    10037       :
    10038           create buf_copy_recipe.
    10039           buffer-copy buf_recipe
    10040                except buf_recipe.recipe-code
    10041                       buf_recipe.host-code
    10042                       buf_recipe.obj-type
    10043                       buf_recipe.obj-code
    10044           to buf_copy_recipe.
    10045           run fbrcode-gen-recipe-code in this-procedure (
    10046                 input p-store-type
    10047               , input p-store-code
    10048               , output buf_copy_recipe.recipe-code
    10049           ).
    10050           assign
    10051               buf_copy_recipe.host-code = p-host-code
    10052               buf_copy_recipe.obj-type  = p-store-type
    10053               buf_copy_recipe.obj-code  = p-store-code
    10054           .
    10055           assign
    10056               p-new-recipe-rowid        = rowid( buf_copy_recipe )
    10057           .
    10058       end.
    10059       do transaction
    10060       on error undo, return error
    10061       :
    10062           for each buf_recipe-gds no-lock
    10063              where buf_recipe-gds.recipe-code = buf_recipe.recipe-code
    10064           :
    10065               create buf_copy_recipe-gds.
    10066               buffer-copy buf_recipe-gds
    10067               except buf_recipe-gds.recipe-code
    10068               to buf_copy_recipe-gds.
    10069               assign
    10070                   buf_copy_recipe-gds.recipe-code = buf_copy_recipe.recipe-code
    10071               .
    10072           end.
    10073       end.
    10074   end.
    10075   end procedure.
    10076   PROCEDURE set-default-recipe :
    10077   define input parameter p-recipe-code    as character    no-undo.
    10078       define variable v-gds-code    as integer      no-undo.
    10079       define buffer buf_recipe    for ub.recipe.
    10080       define buffer buf_fbr-gds-obj       for ub.fbr-gds-obj.
    10081   do
    10082   for buf_recipe
    10083     , buf_fbr-gds-obj
    10084   on error undo, return error
    10085   :
    10086       find first buf_recipe no-lock
    10087            where buf_recipe.recipe-code = p-recipe-code
    10088       .
    10089   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10090   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
    10091     (input  buf_recipe.artic
    10092     ,input  buf_recipe.prod-type
    10093     ,input  buf_recipe.prod-code
    10094     ,output v-gds-code
    10095     )  .
    10096       run fbrlib-set-default-recipe in this-procedure (
    10097             input p-store-type
    10098           , input p-store-code
    10099           , input v-gds-code
    10100       ).
    10101       for each buf_fbr-gds-obj exclusive-lock
    10102          where buf_fbr-gds-obj.obj-type = p-store-type
    10103            and buf_fbr-gds-obj.obj-code = p-store-code
    10104            and buf_fbr-gds-obj.gds-code = v-gds-code
    10105       on error undo, return error
    10106       :
    10107           assign
    10108               buf_fbr-gds-obj.default-recipe-code = p-recipe-code
    10109           .
    10110       end.
    10111   end.
    10112   END PROCEDURE.
