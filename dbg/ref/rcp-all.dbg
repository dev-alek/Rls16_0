     5440   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5441   DEF VAR cur-clmn-numbr-recipe as INT EXTENT 10 no-undo.
     5442   DEF VAR varmvibr-recipe       as INT no-undo.
     5443   DEF VAR varmvjbr-recipe       as INT no-undo.
     5444   DEF VAR varmvkbr-recipe       as INT no-undo.
     5445   DEF VAR varmvlbr-recipe       as INT no-undo.
     5446   DEF VAR move-elementbr-recipe as INT no-undo.
     5447   def var jjbr-recipe           as int no-undo.
     5448   do varmvibr-recipe = 1 to EXTENT(cur-clmn-numbr-recipe):
     5449     ASSIGN cur-clmn-numbr-recipe[varmvibr-recipe] = varmvibr-recipe.
     5450   END.
     5451   RUN start-mv-clmnbr-recipe.
     5452   PROCEDURE start-mv-clmnbr-recipe:
     5453   def var old-session as logical no-undo.
     5454      old-session = SESSION:IMMEDIATE-DISPLAY.
     5455      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     5456      SESSION:IMMEDIATE-DISPLAY = old-session.
     5457   END.
     5458   ON ctrl-cursor-right OF BROWSE br-recipe do:
     5459     RUN re-move-clmnbr-recipe ( 3, 10).
     5460   END.
     5461   ON ctrl-cursor-left OF BROWSE br-recipe do:
     5462     RUN re-move-clmnbr-recipe (10, 3).
     5463   END.
     5464   PROCEDURE re-move-clmnbr-recipe:
     5465     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     5466     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     5467     DO varmvibr-recipe = 1 TO EXTENT(cur-clmn-numbr-recipe):
     5468       if cur-clmn-numbr-recipe[varmvibr-recipe] = source-column THEN cur-clmn-numbr-recipe[varmvibr-recipe] = -1.
     5469     END.
     5470     if br-recipe:MOVE-COLUMN(source-column, target-column) IN FRAME dialog-frame then.
     5471     if source-column > target-column THEN
     5472     DO varmvjbr-recipe = source-column - 1 to target-column BY -1:
     5473       DO varmvibr-recipe = 1 TO EXTENT(cur-clmn-numbr-recipe):
     5474           if cur-clmn-numbr-recipe[varmvibr-recipe] = varmvjbr-recipe THEN DO:
     5475             cur-clmn-numbr-recipe[varmvibr-recipe] = cur-clmn-numbr-recipe[varmvibr-recipe] + 1.
     5476           END.
     5477       END.
     5478     END.
     5479     ELSE
     5480     DO varmvjbr-recipe = source-column + 1 to target-column:
     5481       DO varmvibr-recipe = 1 TO EXTENT(cur-clmn-numbr-recipe):
     5482         if cur-clmn-numbr-recipe[varmvibr-recipe] = varmvjbr-recipe THEN DO:
     5483           cur-clmn-numbr-recipe[varmvibr-recipe] = cur-clmn-numbr-recipe[varmvibr-recipe] - 1.
     5484         END.
     5485       END.
     5486     END.
     5487     DO varmvibr-recipe = 1 TO EXTENT(cur-clmn-numbr-recipe):
     5488       if cur-clmn-numbr-recipe[varmvibr-recipe] = -1 THEN cur-clmn-numbr-recipe[varmvibr-recipe] = target-column.
     5489     END.
     5490   END PROCEDURE.
     5491   PROCEDURE ch-clmnbr-recipe:
     5492     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     5493     if cur-clmn-loc <= 3 then do:
     5494       return .
     5495     end.
     5496     DO varmvibr-recipe = 1 TO EXTENT(cur-clmn-numbr-recipe):
     5497       if cur-clmn-numbr-recipe[varmvibr-recipe] = cur-clmn-loc THEN move-elementbr-recipe = varmvibr-recipe.
     5498     END.
     5499     RUN re-move-clmnbr-recipe (cur-clmn-loc, 3).
     5500   END PROCEDURE.
     5501   PROCEDURE mv-brw-defaultbr-recipe:
     5502   def var old-session as logical no-undo.
     5503     old-session = SESSION:IMMEDIATE-DISPLAY.
     5504     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     5505     do varmvlbr-recipe = 3 to EXTENT(cur-clmn-numbr-recipe):
     5506       RUN re-move-clmnbr-recipe (cur-clmn-numbr-recipe[varmvlbr-recipe], varmvlbr-recipe).
     5507     END.
     5508     RUN start-mv-clmnbr-recipe.
     5509     SESSION:IMMEDIATE-DISPLAY = old-session.
     5510   END PROCEDURE.
     5511   .
     5512   on window-close of frame dialog-frame
     5513   do:
     5514       apply "end-error":u to self.
     5515   end.
     5516   on choose of b-set-default  in frame dialog-frame
     5517   do:
     5518   define variable vss-include-info41 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5519   if lookup(self :type
     5520            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     5521            ) = 0
     5522   then do:
     5523     message
     5524       "$Workfile$"
     5525       "Указанному интерфейсному элементу фокус не может быть передан" skip
     5526       "Интерфейсный элемент" self :name  skip
     5527       "Тип" self :type  skip
     5528       "Процедура" this-procedure :file-name skip
     5529       view-as alert-box .
     5530   end.
     5531   else do:
     5532     apply "entry":u to self  .
     5533     if focus :handle <> self :handle  then do:
     5534       return no-apply .
     5535     end.
     5536   end.
     5537       define variable v-focused-row     as integer      no-undo.
     5538       define variable v-cur-line        as recid        no-undo.
     5539       define variable v-proc-number     as integer      no-undo.
     5540       define variable v-yesno           as logical      no-undo.
     5541       if not available ub.recipe
     5542       or not available ub.goods
     5543       then do:
     5544           return no-apply.
     5545       end.
     5546       apply "entry" to br-recipe .
     5547       assign
