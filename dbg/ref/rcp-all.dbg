      125   function diff-list returns character (
      126     input parfirst-list  as character,
      127     input parsecond-list as character,
      128     input pardelim       as character).
      129     if pardelim = ""
      130     or pardelim = ?
      131     then do:
      132       assign
      133         pardelim = ","
      134       .
      135     end.
      136     def var ind as integer no-undo .
      137     def var v-elem as character no-undo .
      138     def var v-result-list as character no-undo init "".
      139     def var v-num-parfirst-list as integer no-undo .
      140     assign
      141       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      142     .
      143     do ind = 1 to v-num-parfirst-list
      144     :
      145       assign
      146         v-elem = entry(ind, parfirst-list, pardelim)
      147       .
      148       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      149         assign
      150           v-result-list = v-result-list
      151                         + (if v-result-list > "" then pardelim else "")
      152                         + v-elem
      153         .
      154       end.
      155     end.
      156     return v-result-list .
      157   end function.
      158   function add-list returns character (
      159    input parfirst-list  as character,
      160    input parsecond-list as character,
      161    input pardelim       as character).
      162     if pardelim = ""
      163     or pardelim = ?
      164     then do:
      165       assign
      166         pardelim = ","
      167       .
      168     end.
      169     def var ind as integer no-undo .
      170     def var v-elem as character no-undo .
      171     def var v-result-list as character no-undo init "".
      172     def var v-num-parfirst-list as integer no-undo .
      173     assign
      174       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      175     .
      176     do ind = 1 to v-num-parfirst-list
      177     :
      178       assign
      179         v-elem = entry(ind, parfirst-list, pardelim)
      180       .
      181       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      182         assign
      183           v-result-list = v-result-list
      184                         + (if v-result-list > "" then pardelim else "")
      185                         + v-elem
      186         .
      187       end.
      188     end.
      189     def var v-num-parsecond-list as integer no-undo .
      190     assign
      191       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      192     .
      193     do ind = 1 to v-num-parsecond-list
      194     :
      195       assign
      196         v-elem = entry(ind, parsecond-list, pardelim)
      197       .
      198       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      199         assign
      200           v-result-list = v-result-list
      201                         + (if v-result-list > "" then pardelim else "")
      202                         + v-elem
      203         .
      204       end.
      205     end.
      206     return v-result-list .
      207   end function.
      208   function cross-list returns character (
      209    input parfirst-list  as character,
      210    input parsecond-list as character,
      211    input pardelim       as character).
      212     if pardelim = ""
      213     or pardelim = ?
      214     then do:
      215       assign
      216         pardelim = ","
      217       .
      218     end.
      219     def var ind as integer no-undo .
      220     def var v-elem as character no-undo .
      221     def var v-result-list as character no-undo init "".
      222     def var v-num-parfirst-list as integer no-undo .
      223     assign
      224       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      225     .
      226     do ind = 1 to v-num-parfirst-list
      227     :
      228       assign
      229         v-elem = entry(ind, parfirst-list, pardelim)
      230       .
      231       if lookup(v-elem, v-result-list, pardelim) = 0
      232       and lookup(v-elem, parsecond-list, pardelim) > 0
      233       then do:
      234         assign
      235           v-result-list = v-result-list
      236                         + (if v-result-list > "" then pardelim else "")
      237                         + v-elem
      238         .
      239       end.
      240     end.
      241     return v-result-list .
      242   end function.
      243   function radio-label returns character (
      244    input par-rs-value  as character,
      245    input par-rs-radio-buttons as character)
      246    .
      247    DEFINE variable v-result-label as character no-undo.
      248    assign
      249    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      250                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      251                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      252                             ), par-rs-radio-buttons
      253                           )
      254    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      255    .
      256   return v-result-label.
      257   end function.
      258   function m-radio-label returns character (
      259    input par-rs-value  as character,
      260    input par-rs-radio-buttons as character,
      261    input par-delim as character
      262    )
      263    .
      264    DEFINE variable v-result-label as character no-undo.
      265    assign
      266    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      267                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      268                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      269                             ), par-rs-radio-buttons, par-delim
      270                           )
      271    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      272    .
      273   return v-result-label.
      274   end function.
      275   FUNCTION mixlist returns character
      276   (
      277    input parfirst-list  as character
      278    ,input parsecond-list as character
      279    ,input pardelim       as character
      280    ,input pardelim-result as character ) :
      281     if pardelim = ""
      282     or pardelim = ?
      283     then do:
      284       assign
      285         pardelim = ","
      286       .
      287     end.
      288     def var ind as integer no-undo .
      289     def var v-elem1 as character no-undo .
      290     def var v-elem2 as character no-undo .
      291     def var v-result-list as character no-undo init "".
      292     do ind = 1 to num-entries(parfirst-list, pardelim)
      293     :
      294       assign
      295         v-elem1 = entry(ind, parfirst-list, pardelim)
      296         v-elem2 = entry(ind, parsecond-list, pardelim)
      297       .
      298         assign
      299           v-result-list = v-result-list
      300                         + (if v-result-list > "" then pardelim-result else "")
      301                         + v-elem1 + pardelim-result + v-elem2
      302         .
      303     end.
      304     return v-result-list .
      305   END FUNCTION.
      306   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   procedure cur-time :
      308      define output parameter p-today as date      no-undo .
      309      define output parameter p-time  as integer   no-undo .
      310     do
      311     on error undo, return error
      312     :
      313       define variable v-date1 as date      no-undo .
      314       define variable v-date2 as date      no-undo .
      315       define variable v-time  as integer   no-undo .
      316       assign
      317         v-date1 = today
      318         v-time  = time
      319         v-date2 = today
      320       .
      321       if v-date1 <> v-date2
      322       then do:
      323         assign
      324           v-date1 = today
      325           v-time  = v-time
      326         .
      327       end.
      328       assign
      329         p-today = v-date1
      330         p-time  = v-time
      331       .
      332     end.
      333   end.
      334   function cur-time-date returns character
      335   :
      336     return string(today, '99/99/9999':U) .
      337   end.
      338   function cur-time-mjd returns decimal
      339   :
      340     define variable v-date as date      no-undo .
      341     define variable v-time as integer   no-undo .
      342     run cur-time in this-procedure
      343       (output v-date
      344       ,output v-time
      345       ) .
      346     return integer(v-date) - 2400002 + (v-time / 86400) .
      347   end.
      348   function cur-time-get-ending-index returns integer
      349   (input p-number as integer
      350   )
      351   :
      352     if p-number < 0
      353     or p-number = ?
      354     then do:
      355       return 1 .
      356     end.
      357     define variable v-rest as integer   no-undo .
      358     assign
      359       p-number = p-number modulo 100
      360     .
      361     if p-number < 20
      362     then do:
      363       assign
      364         v-rest = p-number
      365       .
      366     end.
      367     else do:
      368       assign
      369         v-rest = p-number modulo 10
      370       .
      371     end.
      372     case v-rest :
      373       when 1
      374       then do:
      375         return 2 .
      376       end.
      377       when 2 or
      378       when 3 or
      379       when 4
      380       then do:
      381         return 3 .
      382       end.
      383       otherwise do:
      384         return 1 .
      385       end.
      386     end case .
      387   end.
      388   procedure cur-time-mjd-to-date :
      389      define input  parameter i-mjd-diff as decimal no-undo.
      390      define output parameter o-Date     as date    no-undo.
      391      define output parameter o-Time     as integer no-undo.
      392      define variable v-day-number as integer   no-undo .
      393      if    i-mjd-diff < 0
      394         or i-mjd-diff = ?
      395      then do:
      396         return "?" .
      397      end.
      398      assign
      399         v-day-number = truncate(i-mjd-diff,0).
      400         o-Date = date(v-day-number + 2400002).
      401         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      402     .
      403   end.
      404   function cur-time-mjd-to-string returns character
      405   (input p-mjd-diff as decimal
      406   )
      407   :
      408     define variable v-day-number as integer   no-undo .
      409     define variable v-seconds    as integer   no-undo .
      410     define variable v-hour       as integer   no-undo .
      411     define variable v-min        as integer   no-undo .
      412     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      413     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      414     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      415     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      416     if p-mjd-diff < 0
      417     or p-mjd-diff = ?
      418     then do:
      419       return "?" .
      420     end.
      421     assign
      422       v-day-number = integer(truncate(p-mjd-diff,0))
      423       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      424     .
      425     if v-seconds > 86400
      426     then do:
      427       assign
      428         v-seconds = 86400 - 1
      429       .
      430     end.
      431     if v-seconds < 0
      432     then do:
      433       assign
      434         v-seconds = 0
      435       .
      436     end.
      437     assign
      438       v-hour = truncate(v-seconds / 3600, 0)
      439     .
      440     assign
      441       v-seconds = v-seconds modulo 3600
      442     .
      443     assign
      444       v-min = truncate(v-seconds / 60, 0)
      445     .
      446     assign
      447       v-seconds = v-seconds modulo 60
      448     .
      449     return
      450         (if v-day-number <> 0
      451           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      452           else ""
      453         )
      454       + (if v-day-number <> 0 or v-hour <> 0
      455           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      456           else ""
      457         )
      458       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      459           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      460           else ""
      461         )
      462       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      463       .
      464   end.
      465   function cur-time-string returns character
      466   :
      467     define variable v-date as date      no-undo .
      468     define variable v-time as integer   no-undo .
      469     run cur-time in this-procedure
      470       (output v-date
      471       ,output v-time
      472       ) .
      473     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      474   end.
      475   function cur-time-string-sec returns character
      476   :
      477     define variable v-date as date      no-undo .
      478     define variable v-time as integer   no-undo .
      479     run cur-time in this-procedure
      480       (output v-date
      481       ,output v-time
      482       ) .
      483     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      484   end.
      485   function cur-time-custom  returns character
      486   (input p-prefix as character
      487   ,input p-date-format as character
      488   ,input p-delimiter as character
      489   ,input p-time-format as character
      490   ,input p-suffix as character
      491   )
      492   :
      493     define variable v-date as date      no-undo .
      494     define variable v-time as integer   no-undo .
      495     run cur-time in this-procedure
      496       (output v-date
      497       ,output v-time
      498       ) .
      499     return
      500       p-prefix
      501       + string(v-date, p-date-format)
      502       + p-delimiter
      503       + string(v-time, p-time-format)
      504       + p-suffix
      505       .
      506   end.
      507   function cur-time-print  returns character
      508   :
      509     define variable v-date as date      no-undo .
      510     define variable v-time as integer   no-undo .
      511     run cur-time in this-procedure
      512       (output v-date
      513       ,output v-time
      514       ) .
      515     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      516   end.
      517   function cur-time-datetime returns datetime
      518   :
      519     define variable v-char as character no-undo .
      520     define variable v-datetime as datetime no-undo .
      521     v-char = cur-time-string().
      522     v-datetime = datetime(v-char).
      523     return  v-datetime.
      524   end.
      525   function cur-time-string-msec returns character
      526   :
      527     define variable v-date as datetime  no-undo .
      528     v-date = now.
      529     return string(v-date) .
      530   end.
      531   define variable vss-include-info2 as character format "X(65)" no-undo
      532   initial "@(#)$Workfile$ $Revision$".
      533   define temp-table temp_fbrtest_recipe no-undo
      534       field recipe-code   as character
      535       field error-code    as integer
      536       field gds-code      as integer
      537       field artic         as character
      538       field prod-type     as character
      539       field prod-code     as integer
      540       index pi is primary unique recipe-code error-code artic prod-type prod-code
      541       index gc gds-code
      542       index ar artic prod-type prod-code
      543   .
      544   define variable v-fbrtest-error-description as character extent 3 init
      545       [ "Нет товара в рецепте"
      546       , "Количество составного товара не равно 1 в рецепте альтернативы"
      547       ] no-undo.
      548   procedure fbrtest-test-recipe :
      549   do
      550   on error undo, return error
      551   :
      552   define input parameter p-recipe-code        as character    no-undo.
      553   define input parameter p-append-error       as logical      no-undo.
      554   define input parameter p-error-code-list    as character    no-undo.
      555   define output parameter p-bad-recipe        as logical      no-undo.
      556       define variable v-have-error    as logical       no-undo.
      557       if p-append-error = no
      558       then do:
      559           for each temp_fbrtest_recipe
      560           :
      561               delete temp_fbrtest_recipe.
      562           end.
      563       end.
      564       if p-error-code-list = ""
      565       or lookup( "1", p-error-code-list ) > 0
      566       then do:
      567           run fbrtest-test-goods-in-recipe in this-procedure (
      568                 input p-recipe-code
      569               , output v-have-error
      570           ).
      571           if v-have-error = yes
      572           then do:
      573               assign
      574                   p-bad-recipe = yes
      575               .
      576           end.
      577       end.
      578       if p-error-code-list = ""
      579       or lookup( "2", p-error-code-list ) > 0
      580       then do:
      581           run fbrtest-test-alt-qnty-in-recipe in this-procedure (
      582                 input p-recipe-code
      583               , output v-have-error
      584           ).
      585           if v-have-error = yes
      586           then do:
      587               assign
      588                   p-bad-recipe = yes
      589               .
      590           end.
      591       end.
      592   end.
      593   end procedure.
      594   procedure fbrtest-test-goods-in-recipe :
      595   do
      596   on error undo, return error
      597   :
      598   define input parameter p-recipe-code        as character    no-undo.
      599   define output parameter p-no-exists-good    as logical      no-undo.
      600       define buffer buf_recipe                for ub.recipe.
      601       define buffer buf_recipe-gds            for ub.recipe-gds.
      602       define buffer buf_goods                 for ub.goods.
      603       define buffer buf_temp_fbrtest_recipe   for temp_fbrtest_recipe.
      604       find first buf_recipe no-lock
      605            where buf_recipe.recipe-code = p-recipe-code
      606       .
      607       find first buf_goods no-lock
      608            where buf_goods.artic      = buf_recipe.artic
      609              and buf_goods.prod-type  = buf_recipe.prod-type
      610              and buf_goods.prod-code  = buf_recipe.prod-code
      611       no-error.
      612       if not available buf_goods
      613       then do:
      614           assign
      615               p-no-exists-good = yes
      616           .
      617           create buf_temp_fbrtest_recipe.
      618           assign
      619               buf_temp_fbrtest_recipe.recipe-code  = p-recipe-code
      620               buf_temp_fbrtest_recipe.error-code   = 1
      621               buf_temp_fbrtest_recipe.artic        = buf_recipe.artic
      622               buf_temp_fbrtest_recipe.prod-type    = buf_recipe.prod-type
      623               buf_temp_fbrtest_recipe.prod-code    = buf_recipe.prod-code
      624               buf_temp_fbrtest_recipe.gds-code     = buf_recipe.gds-code
      625           .
      626       end.
      627       for each buf_recipe-gds no-lock
      628          where buf_recipe-gds.recipe-code = buf_recipe.recipe-code
      629       on error undo, return error
      630       :
      631           find first buf_goods no-lock
      632                where buf_goods.artic      = buf_recipe-gds.artic
      633                  and buf_goods.prod-type  = buf_recipe-gds.prod-type
      634                  and buf_goods.prod-code  = buf_recipe-gds.prod-code
      635           no-error.
      636           if not available buf_goods
      637           then do:
      638               assign
      639                   p-no-exists-good = yes
      640               .
      641               create buf_temp_fbrtest_recipe.
      642               assign
      643                   buf_temp_fbrtest_recipe.recipe-code  = p-recipe-code
      644                   buf_temp_fbrtest_recipe.error-code   = 1
      645                   buf_temp_fbrtest_recipe.artic        = buf_recipe-gds.artic
      646                   buf_temp_fbrtest_recipe.prod-type    = buf_recipe-gds.prod-type
      647                   buf_temp_fbrtest_recipe.prod-code    = buf_recipe-gds.prod-code
      648                   buf_temp_fbrtest_recipe.gds-code     = buf_recipe-gds.gds-code
      649               .
      650           end.
      651       end.
      652   end.
      653   end procedure.
      654   procedure fbrtest-test-alt-qnty-in-recipe :
      655   do
      656   on error undo, return error
      657   :
      658   define input parameter p-recipe-code    as character    no-undo.
      659   define output parameter p-bad-qnty      as logical      no-undo.
      660       define buffer buf_recipe                for ub.recipe.
      661       define buffer buf_goods                 for ub.goods.
      662       define buffer buf_temp_fbrtest_recipe   for temp_fbrtest_recipe.
      663       find first buf_recipe no-lock
      664            where buf_recipe.recipe-code = p-recipe-code
      665       .
      666       find first buf_goods no-lock
      667            where buf_goods.artic      = buf_recipe.artic
      668              and buf_goods.prod-type  = buf_recipe.prod-type
      669              and buf_goods.prod-code  = buf_recipe.prod-code
      670       no-error.
      671       if buf_recipe.recipe-type = 'альтернатива':U
      672       then do:
      673           if buf_recipe.qnty <> 1
      674           then do:
      675               assign
      676                   p-bad-qnty = yes
      677               .
      678               create buf_temp_fbrtest_recipe.
      679               assign
      680                   buf_temp_fbrtest_recipe.recipe-code  = p-recipe-code
      681                   buf_temp_fbrtest_recipe.error-code   = 2
      682                   buf_temp_fbrtest_recipe.artic        = buf_recipe.artic
      683                   buf_temp_fbrtest_recipe.prod-type    = buf_recipe.prod-type
      684                   buf_temp_fbrtest_recipe.prod-code    = buf_recipe.prod-code
      685                   buf_temp_fbrtest_recipe.gds-code     = buf_recipe.gds-code
      686               .
      687           end.
      688       end.
      689   end.
      690   end procedure.
      691   define variable vss-include-info3 as character format "X(65)" no-undo
      692   initial "@(#)$Workfile$ $Revision$".
      693   define temp-table temp_fbrcode-doc-code no-undo
      694       field rec-type      as character
      695       field doc-code      as character
      696       field obj-type      as character
      697       field obj-code      as integer
      698       field cli-type      as character
      699       field cli-code      as integer
      700       field ext-doc-type  as character
      701       field doc-type      as character
      702       field order         as integer
      703       index pi is primary unique rec-type doc-code
      704       index od order
      705   .
      706   procedure fbrcode-gen-recipe-code :
      707   do
      708   on error undo, return error
      709   :
      710   define input parameter p-obj-type           as character    no-undo.
      711   define input parameter p-obj-code           as integer      no-undo.
      712   define output parameter p-recipe-code       as character    no-undo.
      713       assign
      714           p-recipe-code   = string( next-value( s-recipe, ub ) )
      715                               + "-"
      716                               + trim( string( p-obj-code, ">>>>9" ) )
      717                               + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
      718       .
      719   end.
      720   end procedure.
      721   procedure fbrcode-is-from-object :
      722   do
      723   on error undo, return error
      724   :
      725   define input parameter p-doc-code           as character    no-undo.
      726   define input parameter p-obj-type           as character    no-undo.
      727   define input parameter p-obj-code           as integer      no-undo.
      728   define output parameter p-is-from-object    as logical      no-undo.
      729       if num-entries( p-doc-code, "-" ) < 2
      730       or entry( 2, p-doc-code, "-" ) <> trim (string (p-obj-code, ">>>>9"))
      731                                       + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
      732       then do:
      733           assign
      734               p-is-from-object = no
      735           .
      736       end.
      737       else do:
      738           assign
      739               p-is-from-object = yes
      740           .
      741       end.
      742   end.
      743   end procedure.
      744   procedure fbrcode-trn-doc :
      745   do
      746   on error undo, return error
      747   :
      748       define input parameter p-out-doc-type       as character    no-undo.
      749       define input parameter p-out-code           as character    no-undo.
      750       define input parameter p-trn-doc-out-type   as character    no-undo.
      751       define output parameter p-trn-doc-doc-code  as character   no-undo.
      752       case p-out-doc-type:
      753           when 'производство':U
      754           then do:
      755               case p-trn-doc-out-type :
      756                   when 'рас':U
      757                   then do:
      758                       assign
      759                           p-trn-doc-doc-code = p-out-code
      760                       .
      761                   end.
      762                   when 'при':U
      763                   then do:
      764                       assign
      765                           p-trn-doc-doc-code = replace ( p-out-code, "-", "=" )
      766                       .
      767                   end.
      768                   when 'спи':U
      769                   then do:
      770                       assign
      771                           p-trn-doc-doc-code = replace ( p-out-code, "-", "*" )
      772                       .
      773                   end.
      774                   otherwise do:
      775                       assign
      776                           p-trn-doc-doc-code = ""
      777                       .
      778                       undo, return error "Не может быть обработан тип складского документа '"
      779                                           + p-trn-doc-out-type + "' во входных параметрах".
      780                   end.
      781               end case.
      782           end.
      783           otherwise do:
      784               assign
      785                   p-trn-doc-doc-code = ""
      786               .
      787               undo, return error "Не может быть обработан тип внешнего документа '"
      788                                   + p-out-doc-type + "' во входных параметрах".
      789           end.
      790       end case.
      791   end.
      792   end procedure.
      793   procedure fbrcode-fill-fbr-by-sale-or-pln :
      794   define input parameter p-main-doc-code      as character        no-undo.
      795       define variable v-order    as integer      no-undo.
      796       define buffer buf_fbr-doc               for ub.fbr-doc.
      797       define buffer buf_trn-doc               for ub.trn-doc.
      798       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
      799   do
      800   for buf_fbr-doc
      801     , buf_trn-doc
      802     , buf_temp_fbrcode-doc-code
      803   on error undo, return error
      804   :
      805       for each buf_temp_fbrcode-doc-code
      806       on error undo, return error
      807       :
      808           delete buf_temp_fbrcode-doc-code.
      809       end.
      810       assign
      811           v-order = 0
      812       .
      813       for each buf_fbr-doc no-lock
      814          where buf_fbr-doc.out-code = p-main-doc-code
      815       on error undo, return error
      816       :
      817           create buf_temp_fbrcode-doc-code.
      818           assign
      819               buf_temp_fbrcode-doc-code.rec-type      = 'производство':U
      820               buf_temp_fbrcode-doc-code.doc-code      = buf_fbr-doc.doc-code
      821               buf_temp_fbrcode-doc-code.ext-doc-type  = "":U
      822               buf_temp_fbrcode-doc-code.obj-type      = buf_fbr-doc.obj-type
      823               buf_temp_fbrcode-doc-code.obj-code      = buf_fbr-doc.obj-code
      824               buf_temp_fbrcode-doc-code.cli-type      = buf_fbr-doc.obj-type
      825               buf_temp_fbrcode-doc-code.cli-code      = buf_fbr-doc.obj-code
      826               buf_temp_fbrcode-doc-code.doc-type      = buf_fbr-doc.doc-type
      827           .
      828           for each buf_trn-doc no-lock
      829              where buf_trn-doc.out-code = buf_fbr-doc.doc-code
      830           by buf_trn-doc.fact-order
      831           on error undo, return error
      832           :
      833               if buf_trn-doc.ext-doc-type = 'em':U
      834               or buf_trn-doc.ext-doc-type = 'im':U
      835               or buf_trn-doc.ext-doc-type = 'wm':U
      836               or buf_trn-doc.ext-doc-type = 'ev':U
      837               then do:
      838                   assign
      839                       v-order = v-order + 1
      840                   .
      841                   create buf_temp_fbrcode-doc-code.
      842                   assign
      843                       buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
      844                       buf_temp_fbrcode-doc-code.rec-type      = 'скл':U
      845                       buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
      846                       buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
      847                       buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
      848                       buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
      849                       buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
      850                       buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
      851                       buf_temp_fbrcode-doc-code.order         = v-order
      852                   .
      853               end.
      854           end.
      855           assign
      856               v-order  = v-order + 1
      857           .
      858           find first buf_temp_fbrcode-doc-code
      859                where buf_temp_fbrcode-doc-code.rec-type = 'производство':U
      860                  and buf_temp_fbrcode-doc-code.doc-code = buf_fbr-doc.doc-code
      861           .
      862           assign
      863               buf_temp_fbrcode-doc-code.order = v-order
      864           .
      865       end.
      866       for each buf_trn-doc no-lock
      867          where buf_trn-doc.out-code = p-main-doc-code
      868       by buf_trn-doc.fact-order
      869       on error undo, return error
      870       :
      871           assign
      872               v-order = v-order + 1
      873           .
      874           create buf_temp_fbrcode-doc-code.
      875           assign
      876               buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
      877               buf_temp_fbrcode-doc-code.rec-type      = 'маг':U
      878               buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
      879               buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
      880               buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
      881               buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
      882               buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
      883               buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
      884               buf_temp_fbrcode-doc-code.order         = v-order
      885           .
      886       end.
      887   end.
      888   end procedure.
      889   procedure fbrcode-get-final-doc :
      890   define input parameter p-main-doc-code      as character        no-undo.
      891   define output parameter p-income-doc-code   as character        no-undo.
      892       define variable v-main-obj-type    as character    no-undo.
      893       define variable v-main-obj-code    as integer      no-undo.
      894       define buffer buf_trn-doc               for ub.trn-doc.
      895       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
      896   do
      897   for buf_trn-doc
      898   on error undo, return error
      899   :
      900       run fbrcode-fill-fbr-by-sale-or-pln in this-procedure (
      901           input p-main-doc-code
      902       ).
      903       find first buf_trn-doc no-lock
      904            where buf_trn-doc.doc-code = p-main-doc-code
      905       .
      906       assign
      907           v-main-obj-type = buf_trn-doc.obj-type
      908           v-main-obj-code = buf_trn-doc.obj-code
      909       .
      910       find first buf_temp_fbrcode-doc-code
      911            where buf_temp_fbrcode-doc-code.ext-doc-type = 'ev':U
      912              and buf_temp_fbrcode-doc-code.cli-type     = v-main-obj-type
      913              and buf_temp_fbrcode-doc-code.cli-code     = v-main-obj-code
      914       no-error.
      915       if available buf_temp_fbrcode-doc-code
      916       then do:
      917           find first buf_trn-doc no-lock
      918                where buf_trn-doc.out-code     = buf_temp_fbrcode-doc-code.doc-code
      919                  and buf_trn-doc.ext-doc-type = 'iv':U
      920           .
      921           assign
      922               p-income-doc-code = buf_trn-doc.doc-code
      923           .
      924       end.
      925       else do:
      926           find first buf_temp_fbrcode-doc-code
      927                where buf_temp_fbrcode-doc-code.ext-doc-type = 'im':U
      928                  and buf_temp_fbrcode-doc-code.obj-type     = v-main-obj-type
      929                  and buf_temp_fbrcode-doc-code.obj-code     = v-main-obj-code
      930           no-error.
      931           if available buf_temp_fbrcode-doc-code
      932           then do:
      933               assign
      934                   p-income-doc-code = buf_temp_fbrcode-doc-code.doc-code
      935               .
      936           end.
      937           else do:
      938               assign
      939                   p-income-doc-code = "":U
      940               .
      941           end.
      942       end.
      943   end.
      944   end procedure.
      945   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      946   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      947   procedure partslib-clear-temp-parts :
      948     define buffer buf_temp-parts for temp-parts .
      949     do
      950     on error undo, return error
      951     :
      952       for each buf_temp-parts
      953       on error undo, return error
      954       :
      955         delete buf_temp-parts .
      956       end.
      957     end.
      958   end procedure.
      959   procedure partslib-create-temp-parts :
      960     define parameter buffer buf_parts       for ub.parts .
      961     define parameter buffer buf_temp-parts  for temp-parts .
      962     define input  parameter p-goods-twounit as logical   no-undo .
      963     define variable v-base-part-code as character no-undo .
      964     do
      965     on error undo, return error
      966     :
      967       if p-goods-twounit = true
      968       then do:
      969         assign
      970           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      971         .
      972       end.
      973       else do:
      974         assign
      975           v-base-part-code = buf_parts.part-code
      976         .
      977       end.
      978       find first buf_temp-parts exclusive-lock
      979         where buf_temp-parts.obj-type  = buf_parts.obj-type
      980           and buf_temp-parts.obj-code  = buf_parts.obj-code
      981           and buf_temp-parts.artic     = buf_parts.artic
      982           and buf_temp-parts.prod-type = buf_parts.prod-type
      983           and buf_temp-parts.prod-code = buf_parts.prod-code
      984           and buf_temp-parts.in-code   = buf_parts.in-code
      985           and buf_temp-parts.out-code  = 'free-zone':U
      986           and buf_temp-parts.part-code = v-base-part-code
      987         no-error.
      988       if not available buf_temp-parts
      989       then do:
      990         create buf_temp-parts .
      991         buffer-copy buf_parts to buf_temp-parts
      992         assign
      993           buf_temp-parts.out-code  = 'free-zone':U
      994           buf_temp-parts.part-code = v-base-part-code
      995           buf_temp-parts.rsrv-free = yes
      996           buf_temp-parts.status_   = no
      997           buf_temp-parts.qnty      = 0
      998           buf_temp-parts.fact-qnty = 0
      999           buf_temp-parts.real-qnty = 0
     1000           buf_temp-parts.cli-qnty  = 0
     1001         .
     1002       end.
     1003     end.
     1004   end procedure.
     1005   procedure partslib-init-temp-parts :
     1006     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1007     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1008     define input parameter p-artic           like ub.parts.artic     no-undo .
     1009     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1010     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1011     define buffer buf_parts      for ub.parts .
     1012     define buffer buf_temp-parts for temp-parts .
     1013     define variable v-goods-twounit    as logical   no-undo .
     1014     do
     1015     on error undo, return error
     1016     :
     1017   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1018   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1019     (input  p-artic
     1020     ,input  p-prod-type
     1021     ,input  p-prod-code
     1022     ,input  'twounit=request':u
     1023     ,output v-goods-twounit
     1024     ) no-error .
     1025       if error-status :error
     1026       then do:
     1027         message
     1028           vss-workfile vss-revision vss-description skip
     1029           vss-include-info4 skip
     1030           "Ошибка при определении атрибута товара" skip
     1031           "Артикул" p-artic p-prod-type p-prod-code skip
     1032           "twounit=request" skip
     1033           error-status :get-message(1) skip
     1034           return-value skip
     1035           view-as alert-box error .
     1036         undo, return error return-value .
     1037       end.
     1038       run partslib-clear-temp-parts in this-procedure .
     1039       for each buf_parts
     1040         where buf_parts.obj-type  = p-obj-type
     1041           and buf_parts.obj-code  = p-obj-code
     1042           and buf_parts.artic     = p-artic
     1043           and buf_parts.prod-type = p-prod-type
     1044           and buf_parts.prod-code = p-prod-code
     1045           and buf_parts.rsrv-free = yes
     1046           and buf_parts.status_   = no
     1047           and buf_parts.in-code   <> buf_parts.out-code
     1048       on error undo, return error
     1049       :
     1050         run partslib-create-temp-parts in this-procedure
     1051           (buffer buf_parts
     1052           ,buffer buf_temp-parts
     1053           ,input  v-goods-twounit
     1054           ) .
     1055         define variable v-parts-qnty          as decimal   no-undo .
     1056         define variable v-parts-cli-qnty      as decimal   no-undo .
     1057         define variable v-parts-free-qnty     as decimal   no-undo .
     1058         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1059         if buf_parts.out-code = 'free-zone':U
     1060         then do:
     1061           assign
     1062             v-parts-qnty          = buf_parts.qnty
     1063             v-parts-cli-qnty      = buf_parts.cli-qnty
     1064             v-parts-free-qnty     = buf_parts.qnty
     1065             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1066           .
     1067         end.
     1068         else do:
     1069           assign
     1070             v-parts-qnty          = abs(buf_parts.qnty)
     1071             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1072             v-parts-free-qnty     = 0
     1073             v-parts-free-cli-qnty = 0
     1074           .
     1075         end.
     1076         assign
     1077           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1078           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1079           buf_temp-parts.real-qnty     = 0
     1080           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1081           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1082           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1083         .
     1084       end.
     1085     end.
     1086   end procedure.
     1087   procedure partslib-init-temp-parts-by-factord :
     1088     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1089     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1090     define input parameter p-artic              like ub.parts.artic     no-undo .
     1091     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1092     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1093     define input parameter p-fact-order         as decimal   no-undo .
     1094     define input parameter p-include-fact-order as logical   no-undo .
     1095     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1096     define buffer buf_gds-obj  for ub.gds-obj .
     1097     do
     1098     on error undo, return error
     1099     :
     1100       do transaction
     1101       on error undo, return error
     1102       :
     1103   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1104   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1105     (input  p-obj-type
     1106     ,input  p-obj-code
     1107     ,input  p-artic
     1108     ,input  p-prod-type
     1109     ,input  p-prod-code
     1110     ,buffer buf_gds-obj
     1111     ) no-error .
     1112         if error-status :error
     1113         then do:
     1114           message
     1115             vss-workfile vss-revision vss-description skip
     1116             vss-include-info4 skip
     1117             "Невозможно найти товар на объекте" skip
     1118             "Объект" p-obj-type p-obj-code skip
     1119             "Артикул" p-artic p-prod-type p-prod-code skip
     1120             error-status :get-message(1) skip
     1121             return-value skip
     1122             view-as alert-box error .
     1123           undo, return error .
     1124         end.
     1125         find current buf_gds-obj exclusive-lock .
     1126       end.
     1127       run partslib-init-temp-parts in this-procedure
     1128         (input p-obj-type
     1129         ,input p-obj-code
     1130         ,input p-artic
     1131         ,input p-prod-type
     1132         ,input p-prod-code
     1133         ) no-error .
     1134       if error-status :error
     1135       then do:
     1136         message
     1137           vss-workfile vss-revision vss-description skip
     1138           vss-include-info4 skip
     1139           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1140           "Объект" p-obj-type p-obj-code skip
     1141           "Артикул" p-artic p-prod-type p-prod-code skip
     1142           "p-fact-order" p-fact-order skip
     1143           view-as alert-box error .
     1144         undo, return error .
     1145       end.
     1146       if p-include-fact-order = true
     1147       then do:
     1148         assign
     1149           p-fact-order = p-fact-order - 0.0000000001
     1150         .
     1151       end.
     1152       define variable v-max-fact-order as character no-undo .
     1153       run factord-max-fact-order in this-procedure
     1154         (output v-max-fact-order
     1155         ) no-error .
     1156       if error-status :error
     1157       then do:
     1158         message
     1159           vss-workfile vss-revision vss-description skip
     1160           vss-include-info4 skip
     1161           "Ошибка при вызове процедуры factord-max-fact-order" skip
     1162           "Объект" p-obj-type p-obj-code skip
     1163           "Артикул" p-artic p-prod-type p-prod-code skip
     1164           "p-fact-order" p-fact-order skip
     1165           view-as alert-box error .
     1166         undo, return error .
     1167       end.
     1168       run partslib-update-by-factord in this-procedure
     1169         (input p-obj-type
     1170         ,input p-obj-code
     1171         ,input p-artic
     1172         ,input p-prod-type
     1173         ,input p-prod-code
     1174         ,input p-fact-order
     1175         ,input v-max-fact-order
     1176         ,input false
     1177         ) no-error .
     1178       if error-status :error
     1179       then do:
     1180         message
     1181           vss-workfile vss-revision vss-description skip
     1182           vss-include-info4 skip
     1183           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     1184           "Объект" p-obj-type p-obj-code skip
     1185           "Артикул" p-artic p-prod-type p-prod-code skip
     1186           "p-fact-order" p-fact-order skip
     1187           "v-max-fact-order" v-max-fact-order skip
     1188           view-as alert-box error .
     1189         undo, return error .
     1190       end.
     1191     end.
     1192   end procedure.
     1193   procedure partslib-update-by-factord :
     1194     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1195     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1196     define input parameter p-artic              like ub.parts.artic     no-undo .
     1197     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1198     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1199     define input parameter p-start-fact-order   as decimal   no-undo .
     1200     define input parameter p-end-fact-order     as decimal   no-undo .
     1201     define input parameter p-lock-gds-obj       as logical   no-undo .
     1202     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1203     define buffer buf_gds-obj  for ub.gds-obj .
     1204     define buffer buf_doc-line for ub.doc-line .
     1205     define variable v-total-parts-qnty as decimal   no-undo .
     1206     define variable v-goods-gds-goods  as logical   no-undo .
     1207     define variable v-goods-twounit    as logical   no-undo .
     1208     do
     1209     on error undo, return error
     1210     :
     1211       if p-start-fact-order > p-end-fact-order
     1212       then do:
     1213         message
     1214           vss-workfile vss-revision vss-description skip
     1215           vss-include-info4 skip
     1216           "Ошибка задания входных параметров" skip
     1217           "Начало интервала превышает конец интервала" skip
     1218           "Объект" p-obj-type p-obj-code skip
     1219           "Артикул" p-artic p-prod-type p-prod-code skip
     1220           "p-start-fact-order" p-start-fact-order skip
     1221           "p-end-fact-order"   p-end-fact-order skip
     1222           view-as alert-box error .
     1223         undo, return error .
     1224       end.
     1225       if p-lock-gds-obj = true
     1226       then do:
     1227         do transaction
     1228         on error undo, return error
     1229         :
     1230   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1231   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1232     (input  p-obj-type
     1233     ,input  p-obj-code
     1234     ,input  p-artic
     1235     ,input  p-prod-type
     1236     ,input  p-prod-code
     1237     ,buffer buf_gds-obj
     1238     ) no-error .
     1239           if error-status :error
     1240           then do:
     1241             message
     1242               vss-workfile vss-revision vss-description skip
     1243               vss-include-info4 skip
     1244               "Невозможно найти gds-obj" skip
     1245               error-status :get-message(1) skip
     1246               return-value skip
     1247               view-as alert-box error .
     1248             undo, return error .
     1249           end.
     1250           find current buf_gds-obj exclusive-lock .
     1251         end.
     1252       end.
     1253   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1254   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1255     (input  p-artic
     1256     ,input  p-prod-type
     1257     ,input  p-prod-code
     1258     ,input  'gds-goods=request':u
     1259     ,output v-goods-gds-goods
     1260     ) no-error .
     1261       if error-status :error
     1262       then do:
     1263         message
     1264           vss-workfile vss-revision vss-description skip
     1265           vss-include-info4 skip
     1266           "Ошибка при определении атрибута товара" skip
     1267           "Артикул" p-artic p-prod-type p-prod-code skip
     1268           "gds-goods=request" skip
     1269           error-status :get-message(1) skip
     1270           return-value skip
     1271           view-as alert-box error .
     1272         undo, return error return-value .
     1273       end.
     1274   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1275   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1276     (input  p-artic
     1277     ,input  p-prod-type
     1278     ,input  p-prod-code
     1279     ,input  'twounit=request':u
     1280     ,output v-goods-twounit
     1281     ) no-error .
     1282       if error-status :error
     1283       then do:
     1284         message
     1285           vss-workfile vss-revision vss-description skip
     1286           vss-include-info4 skip
     1287           "Ошибка при определении атрибута товара" skip
     1288           "Артикул" p-artic p-prod-type p-prod-code skip
     1289           "twounit=request" skip
     1290           error-status :get-message(1) skip
     1291           return-value skip
     1292           view-as alert-box error .
     1293         undo, return error return-value .
     1294       end.
     1295       for each buf_doc-line no-lock
     1296         where buf_doc-line.obj-type   = p-obj-type
     1297           and buf_doc-line.obj-code   = p-obj-code
     1298           and buf_doc-line.artic      = p-artic
     1299           and buf_doc-line.prod-type  = p-prod-type
     1300           and buf_doc-line.prod-code  = p-prod-code
     1301           and buf_doc-line.status_    = 'факт':U
     1302           and buf_doc-line.fact-order > p-start-fact-order
     1303           and buf_doc-line.fact-order <= p-end-fact-order
     1304       on error undo, return error
     1305       :
     1306         run partslib-process-document in this-procedure
     1307           (input  buf_doc-line.doc-code
     1308           ,input  p-obj-type
     1309           ,input  p-obj-code
     1310           ,input  p-artic
     1311           ,input  p-prod-type
     1312           ,input  p-prod-code
     1313           ,input  v-goods-gds-goods
     1314           ,input  v-goods-twounit
     1315           ,output v-total-parts-qnty
     1316           ) no-error .
     1317         if error-status :error
     1318         then do:
     1319           message
     1320             vss-workfile vss-revision vss-description skip
     1321             vss-include-info4 skip
     1322             "Ошибка при вызове процедуры partslib-process-document" skip
     1323             "Документ" buf_doc-line.doc-code skip
     1324             "Объект" p-obj-type p-obj-code skip
     1325             "Артикул" p-artic p-prod-type p-prod-code skip
     1326             "p-start-fact-order" p-start-fact-order skip
     1327             "p-end-fact-order" p-end-fact-order skip
     1328             error-status :get-message(1) skip
     1329             return-value skip
     1330             view-as alert-box error .
     1331           undo, return error return-value .
     1332         end.
     1333       end.
     1334     end.
     1335   end procedure.
     1336   procedure partslib-process-document :
     1337     define input  parameter p-doc-code         as character no-undo .
     1338     define input  parameter p-obj-type         as character no-undo .
     1339     define input  parameter p-obj-code         as integer   no-undo .
     1340     define input  parameter p-artic            as character no-undo .
     1341     define input  parameter p-prod-type        as character no-undo .
     1342     define input  parameter p-prod-code        as integer   no-undo .
     1343     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1344     define input  parameter p-goods-twounit    as logical   no-undo .
     1345     define output parameter p-total-parts-qnty as decimal   no-undo .
     1346     define variable v-parts-sign as integer   no-undo .
     1347     define buffer buf_trn-doc    for ub.trn-doc .
     1348     define buffer buf_doc-line   for ub.doc-line .
     1349     define buffer buf_parts      for ub.parts .
     1350     define buffer buf_temp-parts for temp-parts .
     1351     do
     1352     on error undo, return error return-value
     1353     :
     1354       find first buf_trn-doc no-lock
     1355         where buf_trn-doc.doc-code = p-doc-code
     1356         no-error .
     1357       if not available buf_trn-doc
     1358       then do:
     1359         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1360                                      ,p-doc-code
     1361                                      ) .
     1362       end.
     1363       case buf_trn-doc.doc-type
     1364       :
     1365         when 'при':U or
     1366         when 'возврат':U or
     1367         when 'инв':U
     1368         then do:
     1369           assign
     1370             v-parts-sign = -1
     1371           .
     1372         end.
     1373         when 'рас':U or
     1374         when 'спи':U
     1375         then do:
     1376           assign
     1377             v-parts-sign = 1
     1378           .
     1379         end.
     1380         otherwise do:
     1381           undo, return error substitute("Неизвестный тип документа &1"
     1382                                       ,buf_trn-doc.doc-type
     1383                                       ) .
     1384         end.
     1385       end.
     1386       find first buf_doc-line no-lock
     1387         where buf_doc-line.doc-code  = p-doc-code
     1388           and buf_doc-line.artic     = p-artic
     1389           and buf_doc-line.prod-type = p-prod-type
     1390           and buf_doc-line.prod-code = p-prod-code
     1391         no-error .
     1392       if not available buf_doc-line
     1393       then do:
     1394         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1395                                      ,p-doc-code
     1396                                      ,artic
     1397                                      ,prod-type
     1398                                      ,prod-code
     1399                                      ) .
     1400       end.
     1401       assign
     1402         p-total-parts-qnty = 0
     1403       .
     1404       if p-goods-gds-goods = true
     1405       then do:
     1406         for each buf_parts no-lock
     1407           where buf_parts.out-code  = p-doc-code
     1408             and buf_parts.obj-type  = p-obj-type
     1409             and buf_parts.obj-code  = p-obj-code
     1410             and buf_parts.artic     = p-artic
     1411             and buf_parts.prod-type = p-prod-type
     1412             and buf_parts.prod-code = p-prod-code
     1413         on error undo, return error
     1414         :
     1415           run partslib-create-temp-parts in this-procedure
     1416             (buffer buf_parts
     1417             ,buffer buf_temp-parts
     1418             ,input  p-goods-twounit
     1419             ) .
     1420           assign
     1421             p-total-parts-qnty        = p-total-parts-qnty
     1422                                       + v-parts-sign * buf_parts.fact-qnty
     1423             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1424                                       + v-parts-sign * buf_parts.fact-qnty
     1425             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1426                                       + v-parts-sign * buf_parts.fact-qnty
     1427             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1428                                       + v-parts-sign * buf_parts.cli-qnty
     1429           .
     1430           if buf_temp-parts.qnty = 0
     1431           then do:
     1432             delete buf_temp-parts .
     1433           end.
     1434         end.
     1435       end.
     1436       else do:
     1437         assign
     1438           p-total-parts-qnty = p-total-parts-qnty
     1439                              + v-parts-sign * buf_doc-line.fact-qnty
     1440         .
     1441       end.
     1442     end.
     1443   end procedure.
     1444   procedure partslib-init-temp-parts-by-date :
     1445     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1446     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1447     define input parameter p-artic           like ub.parts.artic     no-undo .
     1448     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1449     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1450     define input parameter p-fact-date       as date      no-undo .
     1451     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1452     do
     1453     on error undo, return error
     1454     :
     1455       define variable v-fact-order                as decimal   no-undo .
     1456       define variable v-shift-end-fact-order      as decimal   no-undo .
     1457       define variable v-day-end-fact-order        as decimal   no-undo .
     1458       run factord in this-procedure
     1459         (input  p-fact-date
     1460         ,input  1
     1461         ,input  1
     1462         ,input  ?
     1463         ,input  0
     1464         ,input  false
     1465         ,output v-fact-order
     1466         ,output v-shift-end-fact-order
     1467         ,output v-day-end-fact-order
     1468         ) no-error .
     1469       if error-status :error
     1470       then do:
     1471         message
     1472           vss-workfile vss-revision vss-description skip
     1473           vss-include-info4 skip
     1474           "Ошибка при определении момента времени, на который требуется остаток" skip
     1475           "Объект" p-obj-type p-obj-code skip
     1476           "Артикул" p-artic p-prod-type p-prod-code skip
     1477           "Дата" p-fact-date skip
     1478           view-as alert-box error .
     1479         undo, return error .
     1480       end.
     1481       run partslib-init-temp-parts-by-factord in this-procedure
     1482         (input p-obj-type
     1483         ,input p-obj-code
     1484         ,input p-artic
     1485         ,input p-prod-type
     1486         ,input p-prod-code
     1487         ,input v-day-end-fact-order
     1488         ,input false
     1489         ) no-error .
     1490       if error-status :error
     1491       then do:
     1492         message
     1493           vss-workfile vss-revision vss-description skip
     1494           vss-include-info4 skip
     1495           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1496           "Объект" p-obj-type p-obj-code skip
     1497           "Артикул" p-artic p-prod-type p-prod-code skip
     1498           "Дата" p-fact-date skip
     1499           view-as alert-box error .
     1500         undo, return error .
     1501       end.
     1502     end.
     1503   end procedure.
     1504   procedure partslib-calc-cost :
     1505     define output parameter p-fact-qnty      as decimal   no-undo .
     1506     define output parameter p-vat-pc         as decimal   no-undo .
     1507     define output parameter p-slt-pc         as decimal   no-undo .
     1508     define output parameter p-sum-base       as decimal   no-undo .
     1509     define output parameter p-sum-rubl       as decimal   no-undo .
     1510     define output parameter p-vat-base       as decimal   no-undo .
     1511     define output parameter p-vat-rubl       as decimal   no-undo .
     1512     define output parameter p-slt-base       as decimal   no-undo .
     1513     define output parameter p-slt-rubl       as decimal   no-undo .
     1514     define output parameter p-road-tax-base  as decimal   no-undo .
     1515     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1516     define output parameter p-transport-base as decimal   no-undo .
     1517     define output parameter p-transport-rubl as decimal   no-undo .
     1518     define output parameter p-other-base     as decimal   no-undo .
     1519     define output parameter p-other-rubl     as decimal   no-undo .
     1520     define output parameter p-excise-base    as decimal   no-undo .
     1521     define output parameter p-excise-rubl    as decimal   no-undo .
     1522     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1523     do
     1524     on error undo, return error return-value
     1525     :
     1526       define buffer buf_temp-parts for temp-parts .
     1527       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1528       define buffer   in-vatp-parts    for ub.parts   .
     1529       define buffer   in-vatp-doc      for ub.trn-doc .
     1530       define buffer   in-vatp-goods    for ub.goods   .
     1531       define buffer   in-vatp-sysconf  for ub.sysconf .
     1532       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1533       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1534       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1535       define variable varinvprb                  as   character              no-undo.
     1536       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1537       define variable cli-base-rate              as   decimal                no-undo.
     1538       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1539       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1540       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1541       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1542       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1543       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1544       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1545       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1546       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1547       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1548       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1549       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1550       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1551       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1552       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1553       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1554       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1555       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1556       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1557       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1558       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1559       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1560       define variable varinvatp-envd             as   character              no-undo.
     1561       define variable varinvatp-type             as   character              no-undo.
     1562       for each buf_temp-parts
     1563       on error undo, return error
     1564       :
     1565   assign
     1566     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1567     price-base-with-tax-loc = buf_temp-parts.price-base
     1568   .
     1569   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1570   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1571     (output varinvprb
     1572     )  .
     1573     if buf_temp-parts.out-code = 'free-zone':U     or
     1574        buf_temp-parts.out-code = 'out-zone':U   or
     1575        buf_temp-parts.doc-type = 'акт':U then do:
     1576       assign
     1577         in-vatp-have-vat-slt = yes.
     1578     end.
     1579     else do:
     1580       find first in-vatp_doc-attr no-lock
     1581         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1582           and in-vatp_doc-attr.attr-code = 'envd':U
     1583         no-error .
     1584       if not available in-vatp_doc-attr then do:
     1585         assign
     1586           in-vatp-have-vat-slt = yes.
     1587       end.
     1588       else do:
     1589            in-vatp-have-vat-slt = no.
     1590       end.
     1591     end.
     1592     assign
     1593      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1594      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1595     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1596              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1597     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1598             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1599             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1600             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1601             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1602             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1603             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1604       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1605     assign
     1606       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1607     assign
     1608       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1609       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1610       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1611       transport-cli-loc  = 0
     1612       other-cli-loc      = 0
     1613     .
     1614   ASSIGN
     1615             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1616       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1617   .
     1618         assign
     1619           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1620           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1621           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1622           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1623           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1624           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1625           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1626           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1627           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1628           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1629           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1630           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1631           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1632           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1633           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1634           p-excise-base    = p-excise-base    + 0
     1635           p-excise-rubl    = p-excise-rubl    + 0
     1636         .
     1637       end.
     1638       if p-fact-qnty      = ?
     1639       or p-sum-base       = ?
     1640       or p-sum-rubl       = ?
     1641       or p-vat-base       = ?
     1642       or p-vat-rubl       = ?
     1643       or p-slt-base       = ?
     1644       or p-slt-rubl       = ?
     1645       or p-road-tax-base  = ?
     1646       or p-road-tax-rubl  = ?
     1647       or p-transport-base = ?
     1648       or p-transport-rubl = ?
     1649       or p-other-base     = ?
     1650       or p-other-rubl     = ?
     1651       or p-excise-base    = ?
     1652       or p-excise-rubl    = ?
     1653       then do:
     1654         message
     1655           vss-workfile vss-revision vss-description skip
     1656           vss-include-info4 skip
     1657           "Программа in-vatp.i вернула неопределенные значения" skip
     1658           "p-fact-qnty"      p-fact-qnty      skip
     1659           "p-sum-base"       p-sum-base       skip
     1660           "p-sum-rubl"       p-sum-rubl       skip
     1661           "p-vat-base"       p-vat-base       skip
     1662           "p-vat-rubl"       p-vat-rubl       skip
     1663           "p-slt-base"       p-slt-base       skip
     1664           "p-slt-rubl"       p-slt-rubl       skip
     1665           "p-road-tax-base"  p-road-tax-base  skip
     1666           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1667           "p-transport-base" p-transport-base skip
     1668           "p-transport-rubl" p-transport-rubl skip
     1669           "p-other-base"     p-other-base     skip
     1670           "p-other-rubl"     p-other-rubl     skip
     1671           "p-excise-base"    p-excise-base    skip
     1672           "p-excise-rubl"    p-excise-rubl    skip
     1673           view-as alert-box error .
     1674         undo, return error .
     1675       end.
     1676     end.
     1677   end procedure.
