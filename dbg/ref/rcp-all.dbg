     6497         error-status :get-message(1)
     6498         view-as alert-box .
     6499     end.
     6500   end.
     6501   run minbtn-set in this-procedure .
     6502   on choose of b-help in frame dialog-frame
     6503   do:
     6504     apply "help":u to frame dialog-frame .
     6505   end.
     6506   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6507   procedure minbtn-set :
     6508       do
     6509           on error undo, return error return-value
     6510           :
     6511           define variable ii              as integer       no-undo .
     6512           define variable fh              as widget-handle no-undo .
     6513           define variable hh              as widget-handle no-undo .
     6514           define variable v-h             as handle        extent 4 no-undo .
     6515           define variable v-name-button   as character     no-undo .
     6516           define variable v-help-old-x    as decimal       no-undo .
     6517           define variable v-help-old-y    as decimal       no-undo .
     6518           define variable v-help-old-size as decimal       no-undo .
     6519           define variable v-frame-width   as decimal       no-undo .
     6520           define variable jj              as integer       no-undo .
     6521           do
     6522               on error undo, return error
     6523               :
     6524               assign
     6525                   v-frame-width = frame dialog-frame:width - 0.3
     6526                   fh            = frame dialog-frame:first-child
     6527                   hh            = fh:first-child
     6528                   ii            = 1
     6529                   .
     6530               do while valid-handle(hh):
     6531                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     6532                   do:
     6533                       case lc(hh:name) :
     6534                           when "b-help" then
     6535                               do:
     6536                                   hh:load-image-up("cmp/b-help.bmp":u) .
     6537                                   hh:load-image-down("cmp/b-help.bmp":u) .
     6538                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     6539                                   hh:TOOLTIP = "Помощь" .
     6540                                   v-help-old-x = hh:column .
     6541                                   v-help-old-y = hh:row    .
     6542                                   v-help-old-size = hh:width .
     6543                                   hh:width-chars = 2.5 .
     6544                               end.
     6545                           when "b-print" then
     6546                               do:
     6547                                   hh:load-image("cmp/b-print.bmp":u) .
     6548                                   hh:TOOLTIP = "Печать" .
     6549                                   v-h[ii] = hh:handle .
     6550                                   ii = ii + 1 .
     6551                                   hh:width-chars = 3 .
     6552                               end.
     6553                           when "b-history" or
     6554                           when "b-hist" then
     6555                               do:
     6556                                   hh:load-image("cmp/b-hist.bmp":u) .
     6557                                   hh:TOOLTIP = "История" .
     6558                                   v-h[ii] = hh:handle .
     6559                                   ii = ii + 1 .
     6560                                   hh:width-chars = 3 .
     6561                               end.
     6562                           when "b-sch" then
     6563                               do:
     6564                                   hh:load-image("cmp/b-sch.bmp":u) .
     6565                                   hh:TOOLTIP = "Установка Фильтра" .
     6566                                   v-h[ii] = hh:handle .
     6567                                   ii = ii + 1 .
     6568                                   hh:width-chars = 3 .
     6569                               end.
     6570                           when "b-hist-user" then
     6571                               do:
     6572                                   hh:load-image("cmp/b-hist.bmp":u) .
     6573                                   hh:TOOLTIP = "История пользователя" .
     6574                                   ii = ii + 1 .
     6575                               end.
     6576                       end case.
     6577                   end.
     6578                   hh = hh:next-sibling.
     6579               end.
     6580               b-help:column = v-frame-width - b-help:width-chars.
     6581               jj = 0.
     6582               repeat ii = 4 to 1 by -1 :
     6583                   if valid-handle (v-h[ii] ) then
     6584                   do:
     6585                       jj  = jj + 1 .
     6586                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     6587                       v-h[ii]:row    = v-help-old-y .
     6588                   end.
     6589               end.
     6590           end.
     6591       end.
     6592   end procedure.
     6593   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     6594   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     6595   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     6596   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     6597   define variable v-diasize-current-frame-width  as decimal   no-undo .
     6598   define variable v-diasize-current-frame-height as decimal   no-undo .
     6599   define variable v-diasize-change-size          as logical   no-undo .
     6600   define variable v-diasize-resize-button        as handle    no-undo .
     6601   define variable v-diasize-wndmax               as logical   no-undo .
     6602   define variable v-diasize-wndstore             as logical   no-undo .
     6603   define variable v-diasize-proc-name            as character no-undo .
     6604   define variable v-diasize-browse-handle        as handle    no-undo .
     6605   define variable v-diasize-browse-number        as integer   no-undo .
     6606   define variable v-diasize-need-full-display    as logical   no-undo init false .
     6607   define temp-table temp-diasize-handle no-undo
     6608     field handle-value  as handle
     6609     field save-position as decimal
     6610     index xpk is primary unique handle-value
     6611     .
     6612   define temp-table temp-browse-handle no-undo
     6613     field browse-type   as character
     6614     field browse-number as integer
     6615     field browse-handle as handle
     6616     field original-size as decimal
     6617     index xpk is primary unique browse-type browse-number
     6618     index xie browse-type browse-handle
     6619   .
     6620   procedure diasize_change-height :
     6621     define input  parameter p-change-value  as decimal   no-undo .
     6622     define input  parameter p-move-resize   as logical   no-undo .
     6623     define variable v-field-group-handle    as handle    no-undo .
     6624     define variable v-object-handle         as handle    no-undo .
     6625     define variable v-frame-height          as decimal   no-undo .
     6626     define variable v-frame-virtual-height  as decimal   no-undo .
     6627     define variable v-browse-height         as decimal   no-undo .
     6628     define variable v-window-height         as decimal   no-undo .
     6629     define variable v-window-virtual-height as decimal   no-undo .
     6630     define variable v-change-sign           as integer   no-undo .
     6631     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     6632     define buffer buf_temp-browse-handle  for temp-browse-handle .
     6633     if p-change-value > 0
     6634     then do:
     6635       if frame dialog-frame :height + p-change-value
     6636           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     6637       then do:
     6638         assign
     6639           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     6640                           - (frame dialog-frame :height-chars)
     6641         .
     6642         if p-change-value <= 0
     6643         then do:
     6644           run diasize_position-resize-button in this-procedure .
     6645           return .
     6646         end.
     6647       end.
     6648     end.
     6649     if p-change-value < 0
     6650     then do:
     6651       if frame dialog-frame :height + p-change-value < v-diasize-orig-frame-height
     6652       then do:
     6653         assign
     6654           p-change-value = v-diasize-orig-frame-height
     6655                          - (frame dialog-frame :height-chars)
     6656         .
     6657         if p-change-value >= 0
     6658         then do:
     6659           run diasize_position-resize-button in this-procedure .
     6660           return .
     6661         end.
     6662       end.
     6663     end.
     6664     if p-change-value >= 0
     6665     then do:
     6666       assign
     6667         v-change-sign = 1
     6668       .
     6669     end.
     6670     else do:
     6671       assign
     6672         v-change-sign = -1
     6673       .
     6674     end.
     6675     assign
     6676       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     6677     .
     6678     if p-change-value = 0
     6679     then do:
     6680       run diasize_position-resize-button in this-procedure .
     6681       return .
     6682     end.
     6683     move_block:
     6684     do
     6685     on error undo move_block, retry move_block
     6686     :
     6687       if retry
     6688       then do:
     6689         do
     6690         on error undo move_block, leave move_block
     6691         :
     6692           if p-change-value > 0
     6693           then do:
     6694             for each buf_temp-diasize-handle
     6695             on error undo, next
     6696             :
     6697               assign
     6698                 v-object-handle = buf_temp-diasize-handle.handle-value
     6699               .
     6700               if v-object-handle <> v-diasize-resize-button
     6701               then do:
     6702                 assign
     6703                   v-object-handle :row = buf_temp-diasize-handle.save-position
     6704                 .
     6705               end.
     6706             end.
     6707             assign
     6708               v-diasize-browse-handle :height = v-browse-height
     6709             .
     6710             for each buf_temp-browse-handle
     6711               where buf_temp-browse-handle.browse-type = 'height':u
     6712             on error undo, next
     6713             :
     6714               assign
     6715                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     6716               .
     6717             end.
     6718             assign
     6719               frame dialog-frame :height = v-frame-height
     6720             .
     6721             if frame dialog-frame :scrollable = true
     6722             then do:
     6723               assign
     6724                 frame dialog-frame :virtual-height = v-frame-virtual-height
     6725               .
     6726             end.
     6727             run diasize_position-resize-button in this-procedure .
     6728           end.
     6729           else do:
     6730             if frame dialog-frame :scrollable = true
     6731             then do:
     6732               assign
     6733                 frame dialog-frame :virtual-height = v-frame-virtual-height
     6734               .
     6735             end.
     6736             assign
     6737               frame dialog-frame :height = v-frame-height
     6738             .
     6739             assign
     6740               v-diasize-browse-handle :height = v-browse-height
     6741             .
     6742             for each buf_temp-browse-handle
     6743               where buf_temp-browse-handle.browse-type = 'height':u
     6744             on error undo, next
     6745             :
     6746               assign
     6747                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     6748               .
     6749             end.
     6750             for each buf_temp-diasize-handle
     6751             on error undo, next
     6752             :
     6753               assign
     6754                 v-object-handle = buf_temp-diasize-handle.handle-value
     6755               .
     6756               if v-object-handle <> v-diasize-resize-button
     6757               then do:
     6758                 assign
     6759                   v-object-handle :row = buf_temp-diasize-handle.save-position
     6760                 .
     6761               end.
     6762             end.
     6763             run diasize_position-resize-button in this-procedure .
     6764           end.
     6765           assign
     6766             v-diasize-change-size = false
     6767           .
     6768           leave move_block .
     6769         end.
     6770       end.
     6771       assign
     6772         v-diasize-need-full-display = true
     6773       .
     6774       if v-diasize-change-size = false
     6775       then do:
     6776         assign
     6777           v-diasize-change-size = true
     6778         .
     6779       end.
     6780       else do:
     6781         return .
     6782       end.
     6783       assign
     6784         v-frame-height = frame dialog-frame :height
     6785         v-frame-virtual-height = frame dialog-frame :virtual-height
     6786         v-browse-height = v-diasize-browse-handle :height
     6787       .
     6788       for each buf_temp-browse-handle
     6789         where buf_temp-browse-handle.browse-type = 'height':u
     6790       :
     6791         assign
     6792           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     6793         .
     6794       end.
     6795       for each buf_temp-diasize-handle
     6796       :
     6797         delete buf_temp-diasize-handle .
     6798       end.
     6799       assign
     6800         v-field-group-handle = frame dialog-frame :first-child
     6801       .
     6802       do while valid-handle(v-field-group-handle)
     6803       :
     6804         assign
     6805           v-object-handle = v-field-group-handle :first-child
     6806         .
     6807         do while valid-handle(v-object-handle)
     6808         :
     6809           if  v-object-handle <> v-diasize-browse-handle :handle
     6810           and can-query(v-object-handle, "row")
     6811           and can-query(v-object-handle, "height")
     6812           and ( v-object-handle :row > v-diasize-browse-handle :row )
     6813           then do:
     6814             find first buf_temp-browse-handle
     6815               where buf_temp-browse-handle.browse-type   = 'height':u
     6816                 and buf_temp-browse-handle.browse-handle = v-object-handle
     6817               no-error .
     6818             if available buf_temp-browse-handle
     6819             then do:
     6820             end.
     6821             else do:
     6822               create buf_temp-diasize-handle .
     6823               assign
     6824                 buf_temp-diasize-handle.handle-value  = v-object-handle
     6825                 buf_temp-diasize-handle.save-position = v-object-handle :row
     6826               .
     6827             end.
     6828           end.
     6829           assign
     6830             v-object-handle = v-object-handle :next-sibling
     6831           .
     6832         end.
     6833         assign
     6834           v-field-group-handle = v-field-group-handle :next-sibling
     6835         .
     6836       end.
     6837       do with frame dialog-frame
     6838       :
     6839         hide v-diasize-resize-button .
     6840         assign
     6841           v-diasize-resize-button :row    = 1
     6842           v-diasize-resize-button :column = 1
     6843         .
     6844       end.
     6845       if p-change-value > 0
     6846       then do:
     6847         if frame dialog-frame :scrollable = true
     6848         then do:
     6849           assign
     6850             frame dialog-frame :virtual-height = frame dialog-frame :virtual-height + p-change-value
     6851             no-error .
     6852           if error-status :error
     6853           or error-status :get-message(1) <> ""
     6854           then do:
     6855             undo move_block, retry move_block .
     6856           end.
     6857         end.
     6858         assign
     6859           frame dialog-frame :height = frame dialog-frame :height + p-change-value
     6860           no-error .
     6861         if error-status :error
     6862         or error-status :get-message(1) <> ""
     6863         then do:
     6864           undo move_block, retry move_block .
     6865         end.
     6866         assign
     6867           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     6868           no-error .
     6869         if error-status :error
     6870         or error-status :get-message(1) <> ""
     6871         then do:
     6872           undo move_block, retry move_block .
     6873         end.
     6874         for each buf_temp-browse-handle
     6875           where buf_temp-browse-handle.browse-type = 'height':u
     6876         on error undo move_block, retry move_block
     6877         :
     6878           assign
     6879             buf_temp-browse-handle.browse-handle :height
     6880               = buf_temp-browse-handle.browse-handle :height + p-change-value
     6881             no-error .
     6882           if error-status :error
     6883           or error-status :get-message(1) <> ""
     6884           then do:
     6885             undo move_block, retry move_block .
     6886           end.
     6887         end.
     6888         for each buf_temp-diasize-handle
     6889         on error undo move_block, retry move_block
     6890         :
     6891           assign
     6892             v-object-handle = buf_temp-diasize-handle.handle-value
     6893           .
     6894           if v-object-handle <> v-diasize-resize-button
     6895           then do:
     6896             assign
     6897               v-object-handle :row = v-object-handle :row + p-change-value
     6898               no-error .
     6899             if error-status :error
     6900             or error-status :get-message(1) <> ""
     6901             then do:
     6902               undo move_block, retry move_block .
     6903             end.
     6904           end.
     6905         end.
     6906       end.
     6907       else do:
     6908         for each buf_temp-diasize-handle
     6909         on error undo move_block, retry move_block
     6910         :
     6911           assign
     6912             v-object-handle = buf_temp-diasize-handle.handle-value
     6913           .
     6914           if v-object-handle <> v-diasize-resize-button
     6915           then do:
     6916             assign
     6917               v-object-handle :row = v-object-handle :row + p-change-value
     6918               no-error .
     6919             if error-status :error
     6920             or error-status :get-message(1) <> ""
     6921             then do:
     6922               undo move_block, retry move_block .
     6923             end.
     6924           end.
     6925         end.
     6926         assign
     6927           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     6928           no-error .
     6929         if error-status :error
     6930         or error-status :get-message(1) <> ""
     6931         then do:
     6932           undo move_block, retry move_block .
     6933         end.
     6934         for each buf_temp-browse-handle
     6935           where buf_temp-browse-handle.browse-type = 'height':u
     6936         on error undo move_block, retry move_block
     6937         :
     6938           assign
     6939             buf_temp-browse-handle.browse-handle :height
     6940               = buf_temp-browse-handle.browse-handle :height + p-change-value
     6941             no-error .
     6942           if error-status :error
     6943           or error-status :get-message(1) <> ""
     6944           then do:
     6945             undo move_block, retry move_block .
     6946           end.
     6947         end.
     6948         assign
     6949           frame dialog-frame :height = frame dialog-frame :height + p-change-value
     6950           no-error .
     6951         if error-status :error
     6952         or error-status :get-message(1) <> ""
     6953         then do:
     6954           undo move_block, retry move_block .
     6955         end.
     6956         if frame dialog-frame :scrollable = true
     6957         then do:
     6958           assign
     6959             frame dialog-frame :virtual-height = frame dialog-frame :virtual-height + p-change-value
     6960             no-error .
     6961           if error-status :error
     6962           or error-status :get-message(1) <> ""
     6963           then do:
     6964             undo move_block, retry move_block .
     6965           end.
     6966         end.
     6967       end.
     6968       if p-move-resize = true
     6969       then do:
     6970         run diasize_position-resize-button in this-procedure .
     6971       end.
     6972       if v-diasize-wndstore = true
     6973       then do:
     6974         if connected("ub") = true
     6975         then do:
     6976           define variable v-cntxt-db-num        as integer   no-undo .
     6977           define variable v-cntxt-userid        as character no-undo .
     6978           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6979                                             , OUTPUT v-cntxt-userid
     6980                                             ) .
     6981           run gbl/wndsizew.p
     6982             (input  v-cntxt-db-num
     6983             ,input  v-cntxt-userid
     6984             ,input  v-diasize-proc-name
     6985             ,input  'height':u
     6986             ,input  string(frame dialog-frame :height - v-diasize-orig-frame-height)
     6987             ) .
     6988         end.
     6989       end.
     6990     end.
     6991     assign
     6992       v-diasize-change-size = false
     6993     .
     6994   end procedure.
     6995   procedure diasize_set-height :
     6996     define input  parameter p-new-height  as decimal   no-undo .
     6997     define input  parameter p-move-resize as logical   no-undo .
     6998     do
     6999     on error undo, return error return-value
     7000     :
     7001       run diasize_change-height in this-procedure
     7002         (input  (p-new-height - frame dialog-frame :height)
     7003         ,input  p-move-resize
     7004         ) .
     7005     end.
     7006   end procedure.
     7007   procedure diasize_change-width :
     7008     define input  parameter p-change-value as decimal   no-undo .
     7009     define input  parameter p-move-resize  as logical   no-undo .
     7010     define variable v-field-group-handle   as handle    no-undo .
     7011     define variable v-object-handle        as handle    no-undo .
     7012     define variable v-frame-width          as decimal   no-undo .
     7013     define variable v-frame-virtual-width  as decimal   no-undo .
     7014     define variable v-browse-width         as decimal   no-undo .
     7015     define variable v-window-width         as decimal   no-undo .
     7016     define variable v-window-virtual-width as decimal   no-undo .
     7017     define variable v-change-sign          as integer   no-undo .
     7018     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     7019     define buffer buf_temp-browse-handle  for temp-browse-handle .
     7020     if p-change-value > 0
     7021     then do:
     7022       if frame dialog-frame :width + p-change-value >
     7023           session :width-chars
     7024       then do:
     7025         assign
     7026           p-change-value = session :width-chars - frame dialog-frame :width
     7027         .
     7028         if p-change-value <= 0
     7029         then do:
     7030           run diasize_position-resize-button in this-procedure .
     7031           return .
     7032         end.
     7033       end.
     7034     end.
     7035     if p-change-value < 0
     7036     then do:
     7037       if frame dialog-frame :width + p-change-value < v-diasize-orig-frame-width
     7038       then do:
     7039         assign
     7040           p-change-value = v-diasize-orig-frame-width
     7041                          - frame dialog-frame :width
     7042         .
     7043         if p-change-value >= 0
     7044         then do:
     7045           run diasize_position-resize-button in this-procedure .
     7046           return .
     7047         end.
     7048       end.
     7049     end.
     7050     if p-change-value >= 0
     7051     then do:
     7052       assign
     7053         v-change-sign = 1
     7054       .
     7055     end.
     7056     else do:
     7057       assign
     7058         v-change-sign = -1
     7059       .
     7060     end.
     7061     assign
     7062       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     7063     .
     7064     if p-change-value = 0
     7065     then do:
     7066       run diasize_position-resize-button in this-procedure .
     7067       return .
     7068     end.
     7069     move_block:
     7070     do
     7071     on error undo move_block, leave move_block
     7072     :
     7073       if retry
     7074       then do:
     7075         do
     7076         on error undo move_block, leave move_block
     7077         :
     7078           if p-change-value > 0
     7079           then do:
     7080             for each buf_temp-diasize-handle
     7081             on error undo, next
     7082             :
     7083               assign
     7084                 v-object-handle = buf_temp-diasize-handle.handle-value
     7085               .
     7086               if v-object-handle <> v-diasize-resize-button
     7087               then do:
     7088                 assign
     7089                   v-object-handle :col = buf_temp-diasize-handle.save-position
     7090                 .
     7091               end.
     7092             end.
     7093             assign
     7094               v-diasize-browse-handle :width = v-browse-width
     7095             .
     7096             for each buf_temp-browse-handle
     7097               where buf_temp-browse-handle.browse-type = 'width':u
     7098             on error undo, next
     7099             :
     7100               assign
     7101                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     7102               .
     7103             end.
     7104             assign
     7105               frame dialog-frame :width = v-frame-width
     7106             .
     7107             if frame dialog-frame :scrollable = true
     7108             then do:
     7109               assign
     7110                 frame dialog-frame :virtual-width = v-frame-virtual-width
     7111               .
     7112             end.
     7113             run diasize_position-resize-button in this-procedure .
     7114           end.
     7115           else do:
     7116             if frame dialog-frame :scrollable = true
     7117             then do:
     7118               assign
     7119                 frame dialog-frame :virtual-width = v-frame-virtual-width
     7120               .
     7121             end.
     7122             assign
     7123               frame dialog-frame :width = v-frame-width
     7124             .
     7125             for each buf_temp-browse-handle
     7126               where buf_temp-browse-handle.browse-type = 'width':u
     7127             on error undo, next
     7128             :
     7129               assign
     7130                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     7131               .
     7132             end.
     7133             assign
     7134               v-diasize-browse-handle :width = v-browse-width
     7135             .
     7136             for each buf_temp-diasize-handle
     7137             on error undo, next
     7138             :
     7139               assign
     7140                 v-object-handle = buf_temp-diasize-handle.handle-value
     7141               .
     7142               if v-object-handle <> v-diasize-resize-button
     7143               then do:
     7144                 assign
     7145                   v-object-handle :col = buf_temp-diasize-handle.save-position
     7146                 .
     7147               end.
     7148             end.
     7149             run diasize_position-resize-button in this-procedure .
     7150           end.
     7151           assign
     7152             v-diasize-change-size = false
     7153           .
     7154           leave move_block .
     7155         end.
     7156       end.
     7157       assign
     7158         v-diasize-need-full-display = true
     7159       .
     7160       if v-diasize-change-size = false
     7161       then do:
     7162         assign
     7163           v-diasize-change-size = true
     7164         .
     7165       end.
     7166       else do:
     7167         return .
     7168       end.
     7169       assign
     7170         v-frame-width = frame dialog-frame :width
     7171         v-frame-virtual-width = frame dialog-frame :virtual-width
     7172         v-browse-width = v-diasize-browse-handle :width
     7173       .
     7174       for each buf_temp-browse-handle
     7175         where buf_temp-browse-handle.browse-type = 'width':u
     7176       :
     7177         assign
     7178           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     7179         .
     7180       end.
     7181       for each buf_temp-diasize-handle
     7182       :
     7183         delete buf_temp-diasize-handle .
     7184       end.
     7185       assign
     7186         v-field-group-handle = frame dialog-frame :first-child
     7187       .
     7188       do while valid-handle(v-field-group-handle)
     7189       :
     7190         assign
     7191           v-object-handle = v-field-group-handle :first-child
     7192         .
     7193         do while valid-handle(v-object-handle)
     7194         :
     7195           if  v-object-handle <> v-diasize-browse-handle :handle
     7196           and v-object-handle <> v-diasize-resize-button
     7197           and can-query(v-object-handle, "row")
     7198           and can-query(v-object-handle, "height")
     7199           and ( v-object-handle :col + v-object-handle :width
     7200                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     7201               )
     7202           then do:
     7203             find first buf_temp-browse-handle
     7204               where buf_temp-browse-handle.browse-type   = 'width':u
     7205                 and buf_temp-browse-handle.browse-handle = v-object-handle
     7206               no-error .
     7207             if available buf_temp-browse-handle
     7208             then do:
     7209             end.
     7210             else do:
     7211               create buf_temp-diasize-handle .
     7212               assign
     7213                 buf_temp-diasize-handle.handle-value  = v-object-handle
     7214                 buf_temp-diasize-handle.save-position = v-object-handle :col
     7215               .
     7216             end.
     7217           end.
     7218           assign
     7219             v-object-handle = v-object-handle :next-sibling
     7220           .
     7221         end.
     7222         assign
     7223           v-field-group-handle = v-field-group-handle :next-sibling
     7224         .
     7225       end.
     7226       do with frame dialog-frame
     7227       :
     7228         hide v-diasize-resize-button .
     7229         v-diasize-resize-button :row = 1.
     7230         v-diasize-resize-button :column = 1.
     7231       end.
     7232       if p-change-value > 0
     7233       then do:
     7234         if frame dialog-frame :scrollable = true
     7235         then do:
     7236           assign
     7237             frame dialog-frame :virtual-width = frame dialog-frame :virtual-width + p-change-value
     7238             no-error .
     7239           if error-status :error
     7240           or error-status :get-message(1) <> ""
     7241           then do:
     7242             undo move_block, retry move_block.
     7243           end.
     7244         end.
     7245         assign
     7246           frame dialog-frame :width = v-frame-width + p-change-value
     7247           no-error .
     7248         if error-status :error
     7249         or error-status :get-message(1) <> ""
     7250         then do:
     7251           undo move_block, retry move_block.
     7252         end.
     7253         assign
     7254           v-diasize-browse-handle :width = v-browse-width + p-change-value
     7255         no-error .
     7256         if error-status :error
     7257         or error-status :get-message(1) <> ""
     7258         then do:
     7259           undo move_block, retry move_block.
     7260         end.
     7261         for each buf_temp-browse-handle
     7262           where buf_temp-browse-handle.browse-type = 'width':u
     7263         on error undo move_block, retry move_block
     7264         :
     7265           assign
     7266             buf_temp-browse-handle.browse-handle :width
     7267               = buf_temp-browse-handle.browse-handle :width + p-change-value
     7268             no-error .
     7269           if error-status :error
     7270           or error-status :get-message(1) <> ""
     7271           then do:
     7272             undo move_block, retry move_block .
     7273           end.
     7274         end.
     7275         for each buf_temp-diasize-handle
     7276         on error undo move_block, retry move_block
     7277         :
     7278           assign
     7279             v-object-handle = buf_temp-diasize-handle.handle-value
     7280           .
     7281           if v-object-handle <> v-diasize-resize-button
     7282           then do:
     7283             assign
     7284               v-object-handle :col = v-object-handle :col + p-change-value
     7285               no-error .
     7286             if error-status :error
     7287             or error-status :get-message(1) <> ""
     7288             then do:
     7289               undo move_block, retry move_block .
     7290             end.
     7291           end.
     7292         end.
     7293       end.
     7294       else do:
     7295         for each buf_temp-diasize-handle
     7296         on error undo move_block, retry move_block
     7297         :
     7298           assign
     7299             v-object-handle = buf_temp-diasize-handle.handle-value
     7300           .
     7301           if v-object-handle <> v-diasize-resize-button
     7302           then do:
     7303             assign
     7304               v-object-handle :col = v-object-handle :col + p-change-value
     7305               no-error .
     7306             if error-status :error
     7307             or error-status :get-message(1) <> ""
     7308             then do:
     7309               undo move_block, retry move_block .
     7310             end.
     7311           end.
     7312         end.
     7313         for each buf_temp-browse-handle
     7314           where buf_temp-browse-handle.browse-type = 'width':u
     7315         on error undo move_block, retry move_block
     7316         :
     7317           assign
     7318             buf_temp-browse-handle.browse-handle :width
     7319               = buf_temp-browse-handle.browse-handle :width + p-change-value
     7320             no-error .
     7321           if error-status :error
     7322           or error-status :get-message(1) <> ""
     7323           then do:
     7324             undo move_block, retry move_block .
     7325           end.
     7326         end.
     7327         assign
     7328           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     7329           no-error .
     7330         if error-status :error
     7331         or error-status :get-message(1) <> ""
     7332         then do:
     7333           undo move_block, retry move_block.
     7334         end.
     7335         assign
     7336           frame dialog-frame :width = frame dialog-frame :width + p-change-value
     7337         no-error .
     7338         if error-status :error
     7339         or error-status :get-message(1) <> ""
     7340         then do:
     7341           undo move_block, retry move_block.
     7342         end.
     7343         if frame dialog-frame :scrollable = true
     7344         then do:
     7345           assign
     7346             frame dialog-frame :virtual-width = frame dialog-frame :virtual-width + p-change-value
     7347           no-error .
     7348           if error-status :error
     7349           or error-status :get-message(1) <> ""
     7350           then do:
     7351             undo move_block, retry move_block.
     7352           end.
     7353         end.
     7354       end.
     7355       if p-move-resize
     7356       then do:
     7357         run diasize_position-resize-button in this-procedure .
     7358       end.
     7359       if v-diasize-wndstore = true
     7360       then do:
     7361         if connected("ub") = true
     7362         then do:
     7363           define variable v-cntxt-db-num        as integer   no-undo .
     7364           define variable v-cntxt-userid        as character no-undo .
     7365           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     7366                                             , OUTPUT v-cntxt-userid
     7367                                             ) .
     7368           run gbl/wndsizew.p
     7369             (input  v-cntxt-db-num
     7370             ,input  v-cntxt-userid
     7371             ,input  v-diasize-proc-name
     7372             ,input  'width':u
     7373             ,input  string(frame dialog-frame :width - v-diasize-orig-frame-width)
     7374             ) .
     7375         end.
     7376       end.
     7377     end.
     7378     assign
     7379       v-diasize-change-size = false
     7380     .
     7381   end procedure.
     7382   procedure diasize_set-width :
     7383     define input  parameter p-new-width  as decimal   no-undo .
     7384     define input  parameter p-move-resize as logical   no-undo .
     7385     do
     7386     on error undo, return error return-value
     7387     :
     7388       run diasize_change-width in this-procedure
     7389         (input  (p-new-width - frame dialog-frame :width)
     7390         ,input  p-move-resize
     7391         ) .
     7392     end.
     7393   end procedure.
     7394   procedure diasize_position-resize-button :
     7395     do with frame dialog-frame
     7396     :
     7397       hide v-diasize-resize-button .
     7398       assign
     7399         v-diasize-resize-button :row = frame dialog-frame :height - v-diasize-resize-button :height
     7400                     - 1
     7401                     - (frame dialog-frame :border-bottom-pixels / session :pixels-per-row)
     7402         v-diasize-resize-button :col = frame dialog-frame :width - v-diasize-resize-button :width
     7403                     - 1
     7404                     - (frame dialog-frame :border-right-pixels / session :pixels-per-column)
     7405       .
     7406       view v-diasize-resize-button .
     7407     end.
     7408   end procedure.
     7409   on alt-right anywhere
     7410   do:
     7411     run diasize_change-width in this-procedure
     7412       (input 1
     7413       ,input true
     7414       ) .
     7415     return no-apply .
     7416   end.
     7417   on alt-left anywhere
     7418   do:
     7419     run diasize_change-width in this-procedure
     7420       (input -1
     7421       ,input true
     7422       ) .
     7423     return no-apply .
     7424   end.
     7425   on alt-down anywhere
     7426   do:
     7427     run diasize_change-height in this-procedure
     7428       (input 1
     7429       ,input true
     7430       ) .
     7431     return no-apply .
     7432   end.
     7433   on alt-up anywhere
     7434   do:
     7435     run diasize_change-height in this-procedure
     7436       (input -1
     7437       ,input true
     7438       ) .
     7439     return no-apply .
     7440   end.
     7441   on alt-enter of frame dialog-frame
     7442   do:
     7443     run diasize_maximize in this-procedure
     7444       (input  ?
     7445       ).
     7446     return no-apply .
     7447   end.
     7448   procedure diasize_end-move :
     7449     do
     7450     on error undo, return error return-value
     7451     :
     7452       define variable v-row-delta as decimal   no-undo .
     7453       define variable v-col-delta as decimal   no-undo .
     7454       define variable v-new-row as decimal   no-undo .
     7455       define variable v-new-col as decimal   no-undo .
     7456       assign
     7457         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     7458         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     7459       .
     7460       assign
     7461         v-row-delta = v-new-row - frame dialog-frame :height
     7462         v-col-delta = v-new-col - frame dialog-frame :width
     7463       .
     7464       run diasize_change-height in this-procedure
     7465         (input v-row-delta
     7466         ,input true
     7467         ) .
     7468       run diasize_change-width in this-procedure
     7469         (input v-col-delta
     7470         ,input true
     7471         ) .
     7472     end.
     7473   end procedure.
     7474   procedure diasize_maximize :
     7475     define input  parameter p-action as logical   no-undo .
     7476     do
     7477     on error undo, return error return-value
     7478     :
     7479       if p-action = ?
     7480       then do:
     7481         if v-diasize-need-maximize = true
     7482         then do:
     7483           assign
     7484             p-action = true
     7485           .
     7486         end.
     7487         else do:
     7488           assign
     7489             p-action = false
     7490           .
     7491         end.
     7492       end.
     7493       if p-action = true
     7494       then do:
     7495         run diasize_change-height in this-procedure
     7496           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     7497               - frame dialog-frame :height-chars
     7498           ,input true
     7499           ) .
     7500         run diasize_change-width in this-procedure
     7501           (input session :width-chars
     7502               - frame dialog-frame :width-chars
     7503           ,input true
     7504           ) .
     7505         assign
     7506           v-diasize-need-maximize = false
     7507         .
     7508       end.
     7509       else do:
     7510         run diasize_change-width in this-procedure
     7511           (input v-diasize-orig-frame-width
     7512               - frame dialog-frame :width-chars
     7513           ,input true
     7514           ) .
     7515         run diasize_change-height in this-procedure
     7516           (input v-diasize-orig-frame-height
     7517               - frame dialog-frame :height-chars
     7518           ,input true
     7519           ) .
     7520         assign
     7521           v-diasize-need-maximize = true
     7522         .
     7523       end.
     7524     end.
     7525   end procedure.
     7526   procedure diasize_restore-orig-size :
     7527     do
     7528     on error undo, return error return-value
     7529     :
     7530       assign
     7531         v-diasize-current-frame-width  = frame dialog-frame :width
     7532         v-diasize-current-frame-height = frame dialog-frame :height
     7533       .
     7534       run diasize_set-height in this-procedure
     7535         (input  v-diasize-orig-frame-height
     7536         ,input  true
     7537         ) .
     7538       run diasize_set-width in this-procedure
     7539         (input  v-diasize-orig-frame-width
     7540         ,input  true
     7541         ) .
     7542     end.
     7543   end procedure.
     7544   procedure diasize_restore-current-size :
     7545     do
     7546     on error undo, return error return-value
     7547     :
     7548       run diasize_set-height in this-procedure
     7549         (input  v-diasize-current-frame-height
     7550         ,input  true
     7551         ) .
     7552       run diasize_set-width in this-procedure
     7553         (input  v-diasize-current-frame-width
     7554         ,input  true
     7555         ) .
     7556     end.
     7557   end procedure.
     7558   procedure diasize_set-browse-handle :
     7559     define input  parameter p-browse-handle as handle   no-undo .
     7560     define buffer buf_temp-browse-handle for temp-browse-handle .
     7561     do
     7562     on error undo, return error return-value
     7563     :
     7564       assign
     7565         v-diasize-browse-handle = p-browse-handle
     7566       .
     7567       for each buf_temp-browse-handle
     7568       on error undo, return error return-value
     7569       :
     7570         delete buf_temp-browse-handle .
     7571       end.
     7572     end.
     7573   end procedure.
     7574   procedure diasize_add_browse :
     7575     define input  parameter p-browse-type   as character no-undo .
     7576     define input  parameter p-browse-handle as handle    no-undo .
     7577     define buffer buf_temp-browse-handle for temp-browse-handle .
     7578     do
     7579     on error undo, return error return-value
     7580     :
     7581       assign
     7582         v-diasize-browse-number = v-diasize-browse-number + 1
     7583       .
     7584       create buf_temp-browse-handle .
     7585       assign
     7586         buf_temp-browse-handle.browse-type   = p-browse-type
     7587         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     7588         buf_temp-browse-handle.browse-handle = p-browse-handle
     7589       .
     7590     end.
     7591   end procedure.
     7592   procedure diasize_init :
     7593     define variable v-default-value    as logical   no-undo .
     7594     define variable v-restore-saved    as logical   no-undo .
     7595     define variable v-resize-value-str as character no-undo .
     7596     do
     7597     on error undo, return error return-value
     7598     :
     7599       do with frame dialog-frame
     7600       :
     7601         assign
     7602           v-diasize-orig-frame-height = frame dialog-frame :height
     7603           v-diasize-orig-frame-width  = frame dialog-frame :width
     7604           v-diasize-browse-handle     = browse br-recipe :handle
     7605         .
     7606         create button v-diasize-resize-button
     7607         assign
     7608           parent        = frame dialog-frame :first-child
     7609           label         = "s"
     7610           height-pixels = 16
     7611           width-pixels  = 16
     7612           visible       = true
     7613           sensitive     = true
     7614           movable       = true
     7615           triggers:
     7616             on end-move persistent run diasize_end-move in this-procedure .
     7617           end triggers.
     7618         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     7619         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     7620         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     7621         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     7622         assign
     7623           v-diasize-wndmax = false
     7624         .
     7625         if connected("ub") = true
     7626         then do:
     7627           define variable v-cntxt-db-num        as integer   no-undo .
     7628           define variable v-cntxt-userid        as character no-undo .
     7629           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     7630                                             , OUTPUT v-cntxt-userid
     7631                                             ) .
     7632           run gbl/wndpar_r.p
     7633             (input  v-cntxt-db-num
     7634             ,input  v-cntxt-userid
     7635             ,input  'wndmax':U
     7636             ,output v-diasize-wndmax
     7637             ,output v-default-value
     7638             ) .
     7639         end.
     7640         assign
     7641           v-diasize-wndstore = false
     7642         .
     7643         if connected("ub") = true
     7644         then do:
     7645           run gbl/wndpar_r.p
     7646             (input  v-cntxt-db-num
     7647             ,input  v-cntxt-userid
     7648             ,input  'wndstore':U
     7649             ,output v-diasize-wndstore
     7650             ,output v-default-value
     7651             ) .
     7652         end.
     7653         assign
     7654           v-diasize-proc-name = entry(1, program-name(2), '.')
     7655         .
     7656         if v-diasize-wndstore = true
     7657         then do:
     7658           assign
     7659             v-restore-saved = false
     7660           .
     7661           if connected("ub") = true
     7662           then do:
     7663             run gbl/wndsizer.p
     7664               (input  v-cntxt-db-num
     7665               ,input  v-cntxt-userid
     7666               ,input  v-diasize-proc-name
     7667               ,input  'height':u
     7668               ,output v-resize-value-str
     7669               ) .
     7670             if v-resize-value-str <> '':U
     7671             then do:
     7672               run diasize_change-height in this-procedure
     7673                 (input  integer(v-resize-value-str)
     7674                 ,input  true
     7675                 ) .
     7676               assign
     7677                 v-restore-saved = true
     7678               .
     7679             end.
     7680           end.
     7681           if connected("ub") = true
     7682           then do:
     7683             run gbl/wndsizer.p
     7684               (input  v-cntxt-db-num
     7685               ,input  v-cntxt-userid
     7686               ,input  v-diasize-proc-name
     7687               ,input  'width':u
     7688               ,output v-resize-value-str
     7689               ) .
     7690             if v-resize-value-str <> '':U
     7691             then do:
     7692               run diasize_change-width in this-procedure
     7693                 (input  integer(v-resize-value-str)
     7694                 ,input  true
     7695                 ) .
     7696               assign
     7697                 v-restore-saved = true
     7698               .
     7699             end.
     7700           end.
     7701           if v-restore-saved <> true
     7702           then do:
     7703             if v-diasize-wndmax = true
     7704             then do:
     7705               run diasize_maximize in this-procedure
     7706                 (input  true
     7707                 ) .
     7708             end.
     7709           end.
     7710         end.
     7711         else do:
     7712           if v-diasize-wndmax = true
     7713           then do:
     7714             run diasize_maximize in this-procedure
     7715               (input  true
     7716               ) .
     7717           end.
     7718         end.
     7719       end.
     7720     end.
     7721   end procedure.
     7722   procedure diasize_need-full-display :
     7723     define output parameter p-need-full-display as logical   no-undo .
     7724     do
     7725     on error undo, return error return-value
     7726     :
     7727       assign
     7728         p-need-full-display = v-diasize-need-full-display
     7729       .
     7730       assign
     7731         v-diasize-need-full-display = false
     7732       .
     7733     end.
     7734   end procedure.
     7735   procedure get-context :
     7736      define output parameter p-db-num as integer          no-undo.
     7737      define output parameter p-user-id as character        no-undo.
     7738      define variable v-login               as character    no-undo.
     7739      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     7740      define buffer buf_user-login  for ub.user-login .
     7741      do
     7742      on error undo, return error
     7743      :
     7744            FIND FIRST buf_sys-ctrl no-lock.
     7745            ASSIGN
     7746               v-login = USERID("ub")
     7747               p-db-num = buf_sys-ctrl.db-num
     7748            .
     7749            FIND FIRST buf_user-login
     7750                 WHERE buf_user-login.db-num = p-db-num
     7751                   AND buf_user-login.user-login = v-login
     7752                 no-lock
     7753                 no-error
     7754                 .
     7755            IF AVAILABLE buf_user-login
     7756            THEN DO:
     7757               assign
     7758                  p-user-id = buf_user-login.user-id
     7759               .
     7760            END.
     7761      end.
     7762   end procedure.
     7763       run diasize_init in this-procedure .
     7764   main-block:
     7765   do on error   undo main-block, leave main-block
     7766      on end-key undo main-block, leave main-block:
     7767   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7768     run mainmenu_getcntxt in p-mainmenu-handle
     7769       (output v-cntxt-db-num
     7770       ,output v-cntxt-userid
     7771       ,output v-cntxt-level
     7772       ,output v-cntxt-host-code-obj
     7773       ,output v-cntxt-obj-type
     7774       ,output v-cntxt-obj-code
     7775       ,output v-cntxt-db-num-obj
     7776       ,output v-cntxt-is-admin
     7777       ) .
     7778       run get-report-num in p-mainmenu-handle (
     7779           output g#report-num
     7780       ).
     7781       run get-quest-print in p-mainmenu-handle (
     7782           output g#quest-print
     7783       ).
     7784       assign
     7785           v-can-set-global = no
     7786       .
     7787   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7788   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     7789     (input  v-cntxt-obj-type
     7790     ,input  v-cntxt-obj-code
     7791     ,output varobj-date
     7792     ) no-error .
     7793       if error-status:error then do:
     7794         message "Ошибка при поиске даты на текущем объекте." view-as alert-box error.
     7795         return error.
     7796       end.
     7797       if can-do(call-mode, "recipe-gds")
     7798       then do:
     7799         assign
     7800             recipetype = entry(1,call-mode )
     7801             table-find = "ub.recipe-gds":u
     7802         .
     7803       end.
     7804       else do:
     7805         assign
     7806             recipetype = call-mode
     7807         .
     7808       end.
     7809   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7810   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     7811     (input  p-store-type
     7812     ,input  p-store-code
     7813     ,output v-host-code
     7814     ) no-error .
     7815       if error-status :error then do:
     7816         message
     7817             "Не удалось получить код фирмы для текущего объекта."
     7818             skip "Операции будут возможны только для глобальных рецептов."
     7819         view-as alert-box warning.
     7820         assign
     7821             p-store-type = ""
     7822             p-store-code = 0
     7823             v-host-code  = 0
     7824         .
     7825       end.
     7826       if recipetype <> 'разделка':U
     7827       and recipetype <> 'производство':U
     7828       and recipetype <> 'комплектация':U
     7829       and recipetype <> 'альтернатива':U
     7830       and recipetype <> 'топливо':U
     7831       then do:
     7832         assign
     7833           recipetype = "all"
     7834         .
     7835       end.
     7836       if p-goods-recid <> ? then do:
     7837         find first b-goods where recid(b-goods) = p-goods-recid no-lock no-error.
     7838         find first units where units.unit-name = b-goods.unit-base no-lock no-error.
     7839         rg-artic-name = b-goods.artic + " " + b-goods.gds-name.
     7840       end.
     7841       find ub.db where ub.db.db-num = v-cntxt-db-num no-lock .
     7842       run enable_ui.
     7843       run change-query .
     7844       hide nameorcode in frame dialog-frame .
     7845       wait-for go of frame dialog-frame focus br-recipe.
     7846   end.
     7847   run disable_ui.
     7848   procedure change-query :
     7849   define variable v-recipe-gds-recid as recid no-undo .
     7850   define buffer buf_recipe-gds for ub.recipe-gds .
     7851   find first buf_recipe-gds no-lock  no-error.
     7852   if avail buf_recipe-gds then
     7853   assign
     7854     v-recipe-gds-recid = recid(buf_recipe-gds)
     7855   .
     7856   assign frame dialog-frame
     7857       find-by nameorcode
     7858   .
     7859   if session :set-wait-state( "compiler" ) then.
     7860   case recipetype :
     7861       when "all":u then
     7862           frame dialog-frame:title = "Все РЕЦЕПТЫ " .
     7863       when 'разделка':U then
     7864           frame dialog-frame:title = "РЕЦЕПТЫ для разделки " .
     7865       when 'производство':U then
     7866           frame dialog-frame:title = "РЕЦЕПТЫ для производства " .
     7867       when 'комплектация':U then
     7868           frame dialog-frame:title = "РЕЦЕПТЫ для комплектации " .
     7869       when 'альтернатива':U then
     7870           frame dialog-frame:title = "РЕЦЕПТЫ альтернативной замены " .
     7871       when 'топливо':U then
     7872           frame dialog-frame:title = "РЕЦЕПТЫ на топливо " .
     7873   end case .
     7874   if p-goods-recid <> ? then do:
     7875       frame dialog-frame:title =
     7876       frame dialog-frame:title +
     7877       (if  table-find = "recipe":u then ("НА ТОВАР "
     7878                                                                                        + b-goods.artic + " " + b-goods.gds-name)
     7879                                                                                   else
     7880                                                                                   ("c ТОВАРОМ " + b-goods.artic + " " +
     7881                                                                                    b-goods.gds-name)
     7882       ).
     7883   end.
     7884   if find-by <> "all":u then
     7885   frame dialog-frame:title = frame dialog-frame:title + " ФИЛЬТР - " + find-by + " " +
     7886   '"' + nameorcode + '"'.
     7887   show-as = recipetype + "-" + find-by  + "-" + table-find.
     7888   if recipetype = "all" then do:
     7889     case find-by :
     7890       when "all":u then do:
     7891         case table-find:
     7892           when "recipe":u
     7893           then do:
     7894             if p-goods-recid = ? then do:
     7895               if recipeprop = "all" then do :
     7896               open query br-recipe
     7897               for each ub.recipe-gds no-lock where recid(ub.recipe-gds) = v-recipe-gds-recid,
     7898                   each ub.recipe no-lock
     7899                  where ( ub.recipe.host-code = 0
     7900                            and ub.recipe.obj-type = ""
     7901                            and ub.recipe.obj-code = 0
     7902                   ) or ( ub.recipe.host-code = v-host-code
     7903                            and ub.recipe.obj-type = p-store-type
     7904                            and ub.recipe.obj-code = p-store-code
     7905                   ) use-index gds
     7906                 ,first ub.goods no-lock
     7907                     where ub.goods.artic = ub.recipe.artic
     7908                     and ub.goods.prod-type = ub.recipe.prod-type
     7909                     and ub.goods.prod-code = ub.recipe.prod-code
     7910                 ,first ub.clients no-lock
     7911                   where ub.clients.obj-type = ub.recipe.prod-type
     7912                     and ub.clients.obj-code = ub.recipe.prod-code
     7913               by ub.recipe.recipe-order
     7914               .
     7915             end.
     7916               if recipeprop = "global" then do :
     7917                 open query br-recipe
     7918                 for each ub.recipe-gds no-lock where recid(ub.recipe-gds) = v-recipe-gds-recid,
     7919                     each ub.recipe no-lock
     7920                   where ( ub.recipe.host-code = 0
     7921                             and ub.recipe.obj-type = ""
     7922                             and ub.recipe.obj-code = 0
     7923                     ) use-index gds
     7924                   ,first ub.goods no-lock
     7925                     where ub.goods.artic = ub.recipe.artic
     7926                       and ub.goods.prod-type = ub.recipe.prod-type
     7927                       and ub.goods.prod-code = ub.recipe.prod-code
     7928                   ,first ub.clients no-lock
     7929                     where ub.clients.obj-type = ub.recipe.prod-type
     7930                       and ub.clients.obj-code = ub.recipe.prod-code
     7931                 by ub.recipe.recipe-order
     7932                 .
     7933               end.
