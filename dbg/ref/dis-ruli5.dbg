      570   ON CHOOSE OF B-plt IN FRAME Dialog-Frame
      571   DO:
      572    DEFINE VARIABLE v-charkey_one AS CHARACTER NO-UNDO.
      573    DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      574    DEFINE BUFFER local_price-list-type FOR ub.price-list-type.
      575    DEFINE BUFFER local2_price-list-type FOR ub.price-list-type.
      576    IF AVAILABLE tt0-term_dis-rule
      577    and tt0-term_dis-rule.charkey_one <> '' then do:
      578       find first local_price-list-type no-lock where
      579                 local_price-list-type.plt-id = integer(entry(1, tt0-term_dis-rule.charkey_one, "-") )
      580             and local_price-list-type.plt-db-num = integer(entry(2, tt0-term_dis-rule.charkey_one, "-") ) no-error.
      581       if available local_price-list-type then do:
      582         v-rid-list = STRING(RECID(local_price-list-type)).
      583         charkey_one-name =     local_price-list-type.NAME .
      584         display
      585         tt0-term_dis-rule.charkey_one @ tt-dis-rule.charkey_one
      586         charkey_one-name
      587         with frame Dialog-Frame .
      588       end.
      589    END.
      590    v-rid-list = string(p-templ-rl-root).
      591    run ref/typepric.w (
      592                         input  parParentProc
      593                        ,INPUT "b-sel,mode=ban-discnt"
      594                        ,INPUT-OUTPUT v-rid-list ) NO-ERROR.
      595   IF error-status:error
      596   or v-rid-list = ""
      597   THEN RETURN NO-APPLY.
      598    IF (available local_price-list-type and v-rid-list <> string(p-templ-rl-root))
      599    or not available local_price-list-type
      600    THEN DO:
      601        FIND FIRST local2_price-list-type NO-LOCK WHERE
      602                   recid(local2_price-list-type) = INTEGER(v-rid-list) NO-ERROR.
      603       IF AVAILABLE local2_price-list-type THEN DO:
      604           ASSIGN
      605           tt-dis-rule.charkey_one = SUBSTITUTE("&1-&2"
      606                                                , local2_price-list-type.plt-id
      607                                                , local2_price-list-type.plt-db-num)
      608           charkey_one-name =     local2_price-list-type.NAME
      609           .
      610           DISPLAY
      611           tt-dis-rule.charkey_one
      612           charkey_one-name
      613           WITH FRAME Dialog-Frame.
      614       END.
      615       ELSE DO:
      616           MESSAGE
      617           substitute("Не удалось найти ТПЛ с recid=&1", v-rid-list)
      618           VIEW-AS ALERT-BOX ERROR.
      619       END.
      620    END.
      621    apply "entry" to tt-dis-rule.charkey_one in FRAME Dialog-Frame.
      622    return no-apply.
      623   END.
      624   ON CHOOSE OF b-plt-lookup IN FRAME Dialog-Frame
      625   DO:
      626   DEFINE VARIABLE v-recid AS RECID NO-UNDO.
      627   define buffer loc_price-list-type for ub.price-list-type.
      628     IF AVAILABLE tt0-term_dis-rule then do:
      629       if tt0-term_dis-rule.charkey_one <> '' then do:
      630           find first loc_price-list-type where
      631                     loc_price-list-type.plt-id = integer(entry(1, tt0-term_dis-rule.charkey_one, "-"))
      632                  and loc_price-list-type.plt-db-num = integer(entry(2, tt0-term_dis-rule.charkey_one, "-")) no-error.
      633           if available loc_price-list-type then do:
      634               v-recid = RECID(loc_price-list-type).
      635               run ref/tp-price.w ( input parparentproc
      636                                 ,input NO
      637                                 ,INPUT 'ПРОСМОТР':U
      638                                  ,INPUT-OUTPUT v-recid ) NO-ERROR.
      639           end.
      640           ELSE DO:
      641              MESSAGE
