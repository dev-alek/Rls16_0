     1327   PROCEDURE fill-tables :
     1328   define buffer buf_c-fin-doc-tax for ub.c-fin-doc-tax.
     1329   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
     1330   for each buf_c-fin-doc-tax no-lock where
     1331   buf_c-fin-doc-tax.host-code = tt-c-fin-doc.host-code
     1332   AND buf_c-fin-doc-tax.fin-doc-code = tt-c-fin-doc.fin-doc-code
     1333   AND buf_c-fin-doc-tax.chip-num = tt-c-fin-doc.chip-num
     1334    :
     1335       create tt0-fin-doc-tax.
     1336       buffer-copy buf_c-fin-doc-tax to tt0-fin-doc-tax.
     1337   end.
     1338   for each buf_c-fin-doc-attr no-lock where
     1339   buf_c-fin-doc-attr.host-code = tt-c-fin-doc.host-code
     1340   AND buf_c-fin-doc-attr.fin-doc-code = tt-c-fin-doc.fin-doc-code
     1341   AND buf_c-fin-doc-attr.chip-num = tt-c-fin-doc.chip-num
     1342   :
     1343       create tt0-fin-doc-attr.
     1344       buffer-copy buf_c-fin-doc-attr to tt0-fin-doc-attr.
     1345   end.
     1346   END PROCEDURE.
     1347   PROCEDURE hide-view-currency :
     1348   assign
     1349   v-rubf = no
     1350   v-exchf = no
     1351   v-basef = no
     1352   v-baseratef = no
     1353   v-contractf = no
     1354   v-contractratef = no
     1355   .
     1356   hide
     1357   tt-c-fin-doc.exch-rate in frame Dialog-Frame
     1358   tt-c-fin-doc.exch-scale
     1359   tt-c-fin-doc.sum-rubl
     1360   tt-c-fin-doc.sum-base
     1361   tt-c-fin-doc.base-rate
     1362   tt-c-fin-doc.base-scale
     1363   tt-c-fin-doc.sum-contr
     1364   tt-c-fin-doc.contract-rate
     1365   tt-c-fin-doc.contract-scale
     1366   in frame Dialog-Frame .
     1367   if tt-c-fin-doc.curr-code = 0
     1368   and v-base-code = 0
     1369   and
     1370   (tt-c-fin-doc.contract-code = 0
     1371   or tt-c-fin-doc.contract-curr = 0)
     1372   then do:
     1373       return.
     1374   end.
     1375   if tt-c-fin-doc.curr-code <> 0 then do:
     1376     if tt-c-fin-doc.curr-code:visible then
     1377     display
     1378     tt-c-fin-doc.exch-rate
     1379     tt-c-fin-doc.exch-scale
     1380     tt-c-fin-doc.sum-rubl
     1381     with frame Dialog-Frame.
     1382     assign
     1383     v-rubf = yes
     1384     v-exchf = yes
     1385     .
     1386   end.
     1387   if v-base-code <> 0 then do:
     1388     if tt-c-fin-doc.curr-code:visible then
     1389     display
     1390     tt-c-fin-doc.base-rate
     1391     tt-c-fin-doc.base-scale
     1392     tt-c-fin-doc.sum-base
     1393     with frame Dialog-Frame.
     1394     assign
     1395     v-basef = yes
     1396     v-baseratef = yes
     1397     .
     1398   end.
     1399   if tt-c-fin-doc.contract-code  <> 0 and
     1400     (tt-c-fin-doc.contract-curr <> 0  )
     1401     then do:
     1402       if tt-c-fin-doc.curr-code:visible then
     1403       display
     1404       tt-c-fin-doc.sum-contr
     1405       tt-c-fin-doc.contract-rate
     1406       tt-c-fin-doc.contract-scale
     1407       with frame Dialog-Frame.
     1408     assign
     1409     v-contractf = yes
     1410     v-contractratef = yes
     1411     .
     1412   end.
     1413   END PROCEDURE.
     1414   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1415   on help of frame Dialog-Frame
     1416   do:
     1417     run gbl/app_help.p
     1418       (input this-procedure :file-name
     1419       ,input ''
     1420       ,input ?
     1421       ) no-error.
     1422     if error-status :error then do:
     1423       message
     1424         "Ошибка при вызове помощи"
     1425         error-status :get-message(1)
     1426         view-as alert-box .
     1427     end.
     1428   end.
     1429   run minbtn-set in this-procedure .
     1430   on choose of b-help in frame Dialog-Frame
     1431   do:
     1432     apply "help":u to frame Dialog-Frame .
     1433   end.
     1434   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1435   procedure minbtn-set :
     1436       do
     1437           on error undo, return error return-value
     1438           :
     1439           define variable ii              as integer       no-undo .
     1440           define variable fh              as widget-handle no-undo .
     1441           define variable hh              as widget-handle no-undo .
     1442           define variable v-h             as handle        extent 4 no-undo .
     1443           define variable v-name-button   as character     no-undo .
     1444           define variable v-help-old-x    as decimal       no-undo .
     1445           define variable v-help-old-y    as decimal       no-undo .
     1446           define variable v-help-old-size as decimal       no-undo .
     1447           define variable v-frame-width   as decimal       no-undo .
     1448           define variable jj              as integer       no-undo .
     1449           do
     1450               on error undo, return error
     1451               :
     1452               assign
     1453                   v-frame-width = frame Dialog-Frame:width - 0.3
     1454                   fh            = frame Dialog-Frame:first-child
     1455                   hh            = fh:first-child
     1456                   ii            = 1
     1457                   .
     1458               do while valid-handle(hh):
     1459                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1460                   do:
     1461                       case lc(hh:name) :
     1462                           when "b-help" then
     1463                               do:
     1464                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1465                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1466                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1467                                   hh:TOOLTIP = "Помощь" .
     1468                                   v-help-old-x = hh:column .
     1469                                   v-help-old-y = hh:row    .
     1470                                   v-help-old-size = hh:width .
     1471                                   hh:width-chars = 2.5 .
     1472                               end.
     1473                           when "b-print" then
     1474                               do:
     1475                                   hh:load-image("cmp/b-print.bmp":u) .
     1476                                   hh:TOOLTIP = "Печать" .
     1477                                   v-h[ii] = hh:handle .
     1478                                   ii = ii + 1 .
     1479                                   hh:width-chars = 3 .
     1480                               end.
     1481                           when "b-history" or
     1482                           when "b-hist" then
     1483                               do:
     1484                                   hh:load-image("cmp/b-hist.bmp":u) .
     1485                                   hh:TOOLTIP = "История" .
     1486                                   v-h[ii] = hh:handle .
     1487                                   ii = ii + 1 .
     1488                                   hh:width-chars = 3 .
     1489                               end.
     1490                           when "b-sch" then
     1491                               do:
     1492                                   hh:load-image("cmp/b-sch.bmp":u) .
     1493                                   hh:TOOLTIP = "Установка Фильтра" .
     1494                                   v-h[ii] = hh:handle .
     1495                                   ii = ii + 1 .
     1496                                   hh:width-chars = 3 .
     1497                               end.
     1498                           when "b-hist-user" then
     1499                               do:
     1500                                   hh:load-image("cmp/b-hist.bmp":u) .
     1501                                   hh:TOOLTIP = "История пользователя" .
     1502                                   ii = ii + 1 .
     1503                               end.
     1504                       end case.
     1505                   end.
     1506                   hh = hh:next-sibling.
     1507               end.
     1508               b-help:column = v-frame-width - b-help:width-chars.
     1509               jj = 0.
     1510               repeat ii = 4 to 1 by -1 :
     1511                   if valid-handle (v-h[ii] ) then
     1512                   do:
     1513                       jj  = jj + 1 .
     1514                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1515                       v-h[ii]:row    = v-help-old-y .
     1516                   end.
     1517               end.
     1518           end.
     1519       end.
     1520   end procedure.
