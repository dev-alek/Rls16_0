        1   DEFINE BUFFER locked_c-fin-doc FOR ub.c-fin-doc.
        2   DEFINE NEW SHARED TEMP-TABLE tt-c-fin-doc NO-UNDO LIKE ub.c-fin-doc.
        3   DEFINE NEW SHARED TEMP-TABLE tt-fin-doc NO-UNDO LIKE ub.fin-doc.
        4   DEFINE TEMP-TABLE tt0-fin-doc-attr NO-UNDO LIKE ub.fin-doc-attr.
        5   DEFINE TEMP-TABLE tt0-fin-doc-tax NO-UNDO LIKE ub.fin-doc-tax.
        6   DEFINE BUFFER X_clients-host FOR ub.clients.
        7   DEFINE BUFFER X_firm FOR ub.firm.
        8   DEFINE BUFFER X_sysconf FOR ub.sysconf.
        9   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
       10   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo.
       11   define input parameter p-mode as character no-undo.
       12   define input parameter p-host-code like ub.fin-doc.host-code no-undo.
       13   define input parameter p-fin-doc-code like ub.fin-doc.fin-doc-code no-undo.
       14   define input parameter p-fin-ext-doc-type like ub.fin-doc.fin-ext-doc-type no-undo.
       15   define input-output parameter p-doc-rec as recid no-undo.
       16   define variable vss-revision    as character no-undo init "$Revision$":U .
       17   define variable vss-author      as character no-undo init "$Author$":U .
       18   define variable vss-date        as character no-undo init "$Date$":U .
       19   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       20   define variable vss-archive     as character no-undo init "$Archive$":U .
       21   define variable vss-description as character no-undo init "Карточка истории приходного платежного поручения".
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define variable v-db-num like ub.db.db-num no-undo.
       77   define variable v-view as character no-undo init "full":U.
       78   define variable v-not-uf-set as logical no-undo.
       79   define variable v-rubf          as logical no-undo .
       80   define variable v-exchf         as logical no-undo .
       81   define variable v-basef         as logical no-undo .
       82   define variable v-baseratef     as logical no-undo .
       83   define variable v-contractf     as logical no-undo .
       84   define variable v-contractratef as logical no-undo .
       85   define variable v-us            as logical no-undo .
       86   define buffer X_fin-code-cor-acc for ub.fin-code-cor-acc.
       87   define buffer X_fin-code-an-uchet for ub.fin-code-an-uchet.
       88   define buffer X_fin-code-cel-nazn for ub.fin-code-cel-nazn.
       89   define buffer X_currency for ub.currency.
       90   DEFINE BUFFER X_payer FOR ub.clients.
       91   DEFINE BUFFER X_receiver FOR ub.clients.
       92   define buffer X_curr_sysconf for ub.sysconf.
       93   define buffer X_receiver-fin-schet for ub.fin-schet.
       94   define buffer X_receiver-fin-bank for ub.fin-bank.
       95   define buffer X_payer-fin-schet for ub.fin-schet.
       96   define buffer X_payer-fin-bank for ub.fin-bank.
       97   define buffer X_payer-firm for ub.firm.
       98   define buffer X_payer-person for ub.person.
       99   define buffer X_contract for ub.contract.
      100   define buffer X_fin-ob for ub.fin-ob.
      101   DEFINE BUFFER X_fin-statement FOR ub.fin-statement.
      102   DEFINE BUFFER X_c-fin-statement FOR ub.c-fin-statement.
      103   define variable v-base-code like ub.sysconf.host-code no-undo.
      104   define new global shared variable g#language as character no-undo .
      105   if g#language <> '' and g#language <> 'rus':U then do:
      106     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      107   end.
      108   define new global shared variable g#library  as handle no-undo .
      109   define new global shared variable g#library2 as handle no-undo .
      110   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      111   define variable v-waitfram-action01         as character   no-undo .
      112   define variable v-waitfram-action02         as character   no-undo .
      113   define variable v-waitfram-action03         as character   no-undo .
      114   define variable mWaitFramTextBeg            as character   no-undo.
      115   define variable mWaitFramTextEnd            as character   no-undo.
      116   define variable mWaitFramView               as logical     no-undo.
      117   define variable mWaitProcEvent              as logical     no-undo init yes.
      118   define variable mWaitFramInterval           as integer     no-undo init 1 .
      119   define variable mWaitFramStop               as logical     no-undo.
      120   define variable mWaitFramStopUser           as logical     no-undo.
      121   define variable mWaitFramStopTimeOut        as logical     no-undo.
      122   define variable mWaitFramStartProc          as datetime-tz no-undo.
      123   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      124   define button B-WaitFramStop auto-end-key
      125        label "Стоп"
      126        size 10 by 1 tooltip "Остоновить процесс".
      127   define button B-viewProcInfo
      128        label "Информация"
      129        size 15 by 1 tooltip "Информация о процесс".
      130   define frame waitfram
      131     v-waitfram-action01 format "x(72)" no-label skip
      132     v-waitfram-action02 format "x(72)" no-label skip
      133     v-waitfram-action03 format "x(72)" no-label skip
      134     B-viewProcInfo
      135     B-WaitFramStop at row 4 col 30
      136     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      137     .
      138   define new global shared variable mBatchMode as logical no-undo init ?.
      139   define variable mFramBachModHandle as handle no-undo.
      140   mFramBachModHandle = frame waitfram:handle.
      141   define variable mFameOldVis as logical no-undo.
      142   define variable mVisCUrentVin as logical no-undo.
      143   if session:batch-mode
      144   then
      145      mBatchMode = yes.
      146   if mBatchMode = ? then do:
      147     mVisCUrentVin = current-window:visible.
      148     mFameOldVis = mFramBachModHandle:visible.
      149     mFramBachModHandle:visible  = yes.
      150     mBatchMode = mFramBachModHandle:visible ne yes.
      151     mFramBachModHandle:visible = mFameOldVis.
      152     current-window:visible = mVisCUrentVin.
      153   end.
      154    if  log-manager:logfile-name ne ?
      155     then DO:
      156         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      157         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      158         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      159     end.
      160   on choose of B-WaitFramStop in frame waitfram
      161   do:
      162     mWaitFramStop = yes.
      163     mWaitFramStopUser = yes.
      164   end.
      165   function waitfram-check-timeout returns logical():
      166      define variable vtime as int64 no-undo.
      167      if mWaitFramStopTimeOut
      168      then
      169         return yes.
      170      vtime = ( now - mWaitFramStartProc ) / 1000 .
      171      if     mWaitFramTimeOut ne ?
      172         and mWaitFramTimeOut ne 0
      173         and mWaitFramTimeOut lt vtime
      174      then do:
      175         mWaitFramStopTimeOut = yes.
      176      end.
      177      return mWaitFramStopTimeOut.
      178   end.
      179   procedure waitfram-hide :
      180     if not session:batch-mode
      181     then do
      182     on error undo, return error return-value
      183     :
      184       pause 0 before-hide .
      185       if not mBatchMode then
      186         hide frame waitfram .
      187     if     not mWaitFramView
      188        and mWaitProcEvent
      189     then
      190       process events .
      191     end.
      192   end procedure.
      193   procedure waitfram-show :
      194     define input  parameter p-message as character no-undo .
      195     define variable v-left-margin as integer   no-undo .
      196     if not session:batch-mode
      197     then do
      198     on error undo, return error return-value
      199     :
      200       if length(p-message) <= 70 then do:
      201         assign
      202           v-left-margin = integer((70 - length(p-message)) / 2)
      203         .
      204         assign
      205           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      206         .
      207         assign
      208           v-waitfram-action01 = " "
      209           v-waitfram-action02 = " "
      210                                    + fill(" ", v-left-margin)
      211                                    + p-message
      212           v-waitfram-action03 = " "
      213         .
      214       end.
      215       else do:
      216         define variable vRindex1 as integer no-undo.
      217         define variable vRindex2 as integer no-undo.
      218         vRindex1 = r-index(p-message," ",70).
      219         if vRindex1 = 0
      220         then
      221            vRindex1 = 70.
      222         if length(p-message)  <= vRindex1 + 70 then do:
      223           assign
      224             v-waitfram-action01 = " "
      225             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      226             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      227           .
      228         end.
      229         else do:
      230           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      231           if vRindex2 <= vRindex1
      232           then
      233              vRindex2 = vRindex1 + 70.
      234           assign
      235             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      236             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      237             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      238           .
      239         end.
      240       end.
      241       B-viewProcInfo:visible   in frame waitfram = no.
      242       B-viewProcInfo:sensitive in frame waitfram = no.
      243       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      244       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      245       if  (   mWaitFramView
      246          or  mWaitProcEvent)
      247          and not mBatchMode
      248       then
      249          display
      250             v-waitfram-action01 skip
      251             v-waitfram-action02 skip
      252             v-waitfram-action03 skip
      253          with frame waitfram .
      254       if     mWaitFramView
      255          then do:
      256             if     mWaitFramInterval ne ?
      257                and not mBatchMode
      258             then
      259                wait-for go of frame waitfram pause mWaitFramInterval.
      260          end.
      261          else
      262             if     mWaitProcEvent
      263                and not mBatchMode
      264             then
      265                process events .
      266     end.
      267   end procedure.
      268      procedure waitfram-show-this:
      269         define input  parameter iInterval as int64 no-undo.
      270         define variable vtime as int64 no-undo.
      271         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      272         mWaitFramInterval = iInterval.
      273         run waitfram-show (substitute("&1&2 &3&4" ,
      274                                       mWaitFramTextBeg ,
      275                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      276                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      277                                       mWaitFramTextEnd
      278                                      )
      279                           ).
      280      end.
      281      procedure WaitFramRunPause:
      282         define input  parameter iInterval as dec no-undo.
      283         define variable vStart  as datetime-tz no-undo.
      284         define variable vend    as datetime-tz no-undo.
      285         define variable vint as int64 no-undo.
      286         define variable vOk as logical no-undo.
      287         vStart = now.
      288         vend   = vStart.
      289         publish "WaitFramPause" (iInterval,output vOk).
      290         vend   =  now.
      291         vint = vend - vStart.
      292         vint = iInterval - vint / 1000.
      293         if     not mWaitFramStop
      294            and (   vint > 0
      295                 or (    not vOk
      296                     and iInterval eq ?
      297                     )
      298                 )
      299         then
      300            run waitfram-show-this (iInterval).
      301         vend   =  now.
      302         vint = vend - vStart.
      303         vint = iInterval - vint / 1000.
      304         if     not mWaitFramStop
      305            and vint > 0
      306         then do:
      307            run gbl/pause.p (vint * 1000).
      308         end.
      309         if iInterval ne ?
      310         then
      311            publish "WaitFramStop".
      312         waitfram-check-timeout().
      313      end.
      314      procedure WaitFramWaitFor:
      315         define input  parameter iInterval as dec no-undo.
      316         assign
      317            mWaitFramStartProc   = now
      318            mWaitFramStopUser    = no
      319            mWaitFramStopTimeOut = no
      320         .
      321         block-wait:
      322         do while not mWaitFramStop:
      323            run WaitFramRunPause (iInterval).
      324            if  waitfram-check-timeout()
      325            then do:
      326               leave block-wait.
      327            end.
      328         end.
      329         run waitfram-hide.
      330      end.
      331   procedure waitfram-join :
      332     define input  parameter p-line-1  as character no-undo .
      333     define input  parameter p-line-2  as character no-undo .
      334     define input  parameter p-line-3  as character no-undo .
      335     define output parameter p-message as character no-undo .
      336     do
      337     on error undo, return error return-value
      338     :
      339       assign
      340         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      341                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      342                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      343       .
      344     end.
      345   end procedure.
      346   function waitfram-join-function returns character
      347     (input p-line-1 as character
      348     ,input p-line-2 as character
      349     ,input p-line-3 as character
      350     ).
      351     define variable v-message as character no-undo .
      352     run waitfram-join in this-procedure
      353       (input  p-line-1
      354       ,input  p-line-2
      355       ,input  p-line-3
      356       ,output v-message
      357       ) .
      358     return v-message .
      359   end function .
      360   procedure proc-alt-shift-f2:
      361     if not ibs.th.gbl.gbl-var:rcode
      362   then
      363     run gbl\inidebug.p .
      364   end.
      365   procedure proc-alt-shift-f3:
      366     run gbl/prvssinf.p
      367       ( input this-procedure
      368       ) .
      369   end.
      370   define variable v-inform-launched as logical no-undo initial false .
      371   procedure proc-alt-shift-f4:
      372     define variable v-action as character no-undo .
      373     if v-inform-launched = false then do:
      374       assign
      375         v-inform-launched = true
      376       .
      377       run gbl/d-inform.w
      378         (  input self
      379         ,  input this-procedure
      380         , output v-action
      381         ) no-error .
      382       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      383       assign
      384         v-inform-launched = false
      385       .
      386     end.
      387   end.
      388   procedure proc-alt-f1:
      389     run gbl/corrhelp.p
      390       (input this-procedure
      391       ) .
      392   end .
      393   on alt-shift-f2 anywhere do:
      394     run proc-alt-shift-f2.
      395   end.
      396   on alt-shift-f3 anywhere do:
      397     run proc-alt-shift-f3 in this-procedure .
      398   end.
      399   on alt-shift-f4 anywhere do:
      400     run proc-alt-shift-f4 in this-procedure.
      401   end.
      402   on alt-f1 anywhere do:
      403     run proc-alt-f1 in this-procedure .
      404   end.
      405   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      406   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      407   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      408   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      409   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      410   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      411   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      412   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      413   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      414   procedure uf-name :
      415     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      416     define output parameter p-use-List_     as logical   no-undo .
      417     define output parameter p-type-List_     as character no-undo .
      418     define output parameter p-format-List_   as character no-undo .
      419     define output parameter p-use-Naim      as logical   no-undo .
      420     define output parameter p-type-Naim      as character no-undo .
      421     define output parameter p-format-Naim    as character no-undo .
      422     define output parameter p-use-print-graft as logical   no-undo .
      423     define output parameter p-use-sort-gr   as logical   no-undo .
      424     define output parameter p-use-type-price as logical   no-undo .
      425     define output parameter p-use-type-val  as logical   no-undo .
      426     define output parameter p-label          as character no-undo .
      427     define output parameter p-tooltip        as character no-undo .
      428     define output parameter p-user-can-edit  as logical   no-undo .
      429     define output parameter p-output-display as logical   no-undo .
      430     define output parameter p-other          as character no-undo .
      431     do
      432     on error undo, return error
      433     :
      434       case p-code :
      435               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      436               when 'oldscode':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника неиспользуемых весовых кодов"     p-tooltip = "Настройки справочника неиспользуемых весовых кодов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      437               when 'gds-ref-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(8)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = yes      p-label = "Параметры вызова справочника товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
