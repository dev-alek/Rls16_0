     1622     tt-c-fin-doc.vid-plat
     1623     tt-c-fin-doc.receiver-bank-name
     1624     tt-c-fin-doc.receiver-bik
     1625     tt-c-fin-doc.receiver-r-schet
     1626     tt-c-fin-doc.receiver-c-schet
     1627     tt-c-fin-doc.payer-code
     1628     tt-c-fin-doc.payer-type
     1629     tt-c-fin-doc.payer-name
     1630     tt-c-fin-doc.payer-inn
     1631     tt-c-fin-doc.payer-kpp
     1632     tt-c-fin-doc.payer-bank-name
     1633     tt-c-fin-doc.payer-bik
     1634     tt-c-fin-doc.payer-r-schet
     1635     tt-c-fin-doc.payer-c-schet
     1636     tt-c-fin-doc.naznach-plat
     1637     tt-c-fin-doc.PS
     1638     tt-c-fin-doc.payer-sign1
     1639     tt-c-fin-doc.payer-sign2
     1640     with frame Dialog-Frame
     1641     .
     1642     if tt-c-fin-doc.perm-date <> ? then
     1643     display
     1644     tt-c-fin-doc.perm-date
     1645     tt-c-fin-doc.user-name-perm
     1646     with frame Dialog-Frame
     1647      .
     1648     if tt-c-fin-doc.pay-date <> ? then
     1649     display
     1650     tt-c-fin-doc.pay-date
     1651     tt-c-fin-doc.user-name-pl
     1652     with frame Dialog-Frame
     1653      .
     1654     if tt-c-fin-doc.fact-date <> ? then
     1655     display
     1656     tt-c-fin-doc.fact-date
     1657     tt-c-fin-doc.user-name-fact
     1658     tt-c-fin-doc.sttm-code
     1659     v-sttm-prn-doc-code
     1660     with frame Dialog-Frame
     1661     .
     1662   ENABLE
     1663   b-quit
     1664   B-tax
     1665   b-other
     1666   B-Help
     1667   RS-view
     1668   b-payer-view
     1669   b-receiver-view
     1670   WITH FRAME Dialog-Frame.
     1671   assign
     1672   b-quit:label = "&Выход".
     1673   run hide-view-currency in this-procedure.
     1674   CASE p-view:
     1675     when "full":U then do:
     1676       IF AVAILABLE tt-c-fin-doc THEN
     1677       display
     1678       f-bank
     1679       tt-c-fin-doc.receiver-type
     1680       tt-c-fin-doc.receiver-code
     1681       tt-c-fin-doc.receiver-name
     1682       tt-c-fin-doc.receiver-inn
     1683       tt-c-fin-doc.receiver-kpp
     1684       with frame Dialog-Frame
     1685       .
     1686       display
     1687       tt-c-fin-doc.cor-acc-value    when X_sysconf.is-corr-acc
     1688       f-cor-acc-descr               when X_sysconf.is-corr-acc
     1689       tt-c-fin-doc.an-uchet-value   when X_sysconf.is-an-uchet
     1690       f-an-uchet-descr              when X_sysconf.is-an-uchet
     1691       tt-c-fin-doc.cel-nazn-value   when X_sysconf.is-code-cel-nazn
     1692       f-cel-nazn-descr              when X_sysconf.is-code-cel-nazn
     1693       with frame Dialog-Frame
     1694       .
     1695     end.
     1696     when "brief":U then do:
     1697     end.
     1698     when "contract":U then do:
     1699       display
     1700       b-contract-view
     1701       f-contract-date when tt-c-fin-doc.contract-code <> 0
     1702       f-contract-prn-code when tt-c-fin-doc.contract-code <> 0
     1703       f-contract-type when tt-c-fin-doc.contract-code <> 0
     1704       f-contract-curr-abbr when tt-c-fin-doc.contract-code <> 0
     1705       tt-c-fin-doc.contract-curr when tt-c-fin-doc.contract-code <> 0
     1706       with frame Dialog-Frame
     1707       .
     1708       ENABLE
     1709       b-contract-view
     1710       with frame Dialog-Frame.
     1711     end.
     1712   END CASE.
     1713   END PROCEDURE.
     1714   PROCEDURE disable_UI :
     1715     HIDE FRAME Dialog-Frame.
     1716   END PROCEDURE.
     1717   PROCEDURE enable_UI :
     1718     OPEN QUERY Dialog-Frame FOR EACH locked_c-fin-doc SHARE-LOCK,       EACH tt-fin-doc WHERE TRUE  SHARE-LOCK.
     1719     GET FIRST Dialog-Frame.
     1720     DISPLAY RS-view v-sttm-prn-doc-code f-cor-acc-descr f-an-uchet-descr
     1721             f-contract-curr-abbr f-contract-prn-code f-contract-date
     1722             f-contract-type f-cel-nazn-descr F-curr-abbr f-bank
     1723         WITH FRAME Dialog-Frame.
     1724     IF AVAILABLE tt-c-fin-doc THEN
     1725       DISPLAY tt-c-fin-doc.prn-doc-code tt-c-fin-doc.vid-plat
     1726             tt-c-fin-doc.fin-doc-code tt-c-fin-doc.perm-date
     1727             tt-c-fin-doc.user-name-perm tt-c-fin-doc.pay-date
     1728             tt-c-fin-doc.doc-date tt-c-fin-doc.user-name-doc tt-c-fin-doc.obj-type
     1729             tt-c-fin-doc.obj-code tt-c-fin-doc.user-name-pl tt-c-fin-doc.fact-date
     1730             tt-c-fin-doc.user-name-fact tt-c-fin-doc.cor-acc-value
     1731             tt-c-fin-doc.an-uchet-value tt-c-fin-doc.contract-curr
     1732             tt-c-fin-doc.cel-nazn-value tt-c-fin-doc.sum-doc
     1733             tt-c-fin-doc.curr-code tt-c-fin-doc.sum-rubl tt-c-fin-doc.exch-rate
     1734             tt-c-fin-doc.exch-scale tt-c-fin-doc.base-rate tt-c-fin-doc.base-scale
     1735             tt-c-fin-doc.sum-base tt-c-fin-doc.contract-rate
     1736             tt-c-fin-doc.contract-scale tt-c-fin-doc.sum-contr
     1737             tt-c-fin-doc.payer-inn tt-c-fin-doc.payer-kpp tt-c-fin-doc.payer-type
     1738             tt-c-fin-doc.receiver-code tt-c-fin-doc.payer-name
     1739             tt-c-fin-doc.payer-bank-name tt-c-fin-doc.payer-r-schet
     1740             tt-c-fin-doc.payer-bik tt-c-fin-doc.payer-c-schet
     1741             tt-c-fin-doc.receiver-inn tt-c-fin-doc.receiver-kpp
     1742             tt-c-fin-doc.receiver-type tt-c-fin-doc.payer-code
     1743             tt-c-fin-doc.receiver-name tt-c-fin-doc.receiver-bank-name
     1744             tt-c-fin-doc.receiver-r-schet tt-c-fin-doc.receiver-bik
     1745             tt-c-fin-doc.receiver-c-schet tt-c-fin-doc.naznach-plat
     1746             tt-c-fin-doc.PS tt-c-fin-doc.payer-sign1 tt-c-fin-doc.payer-sign2
     1747             tt-c-fin-doc.sttm-code
     1748         WITH FRAME Dialog-Frame.
     1749     ENABLE B-exit b-quit b-other B-tax B-Help RS-view tt-c-fin-doc.prn-doc-code
     1750            tt-c-fin-doc.vid-plat tt-c-fin-doc.doc-date tt-c-fin-doc.user-name-doc
     1751            tt-c-fin-doc.obj-type tt-c-fin-doc.obj-code tt-c-fin-doc.cor-acc-value
     1752            tt-c-fin-doc.an-uchet-value f-contract-curr-abbr B-contract-view
     1753            tt-c-fin-doc.contract-curr tt-c-fin-doc.cel-nazn-value
     1754            tt-c-fin-doc.sum-doc tt-c-fin-doc.curr-code tt-c-fin-doc.exch-rate
     1755            tt-c-fin-doc.exch-scale B-get-rate tt-c-fin-doc.sum-base
     1756            B-get-contract-rate tt-c-fin-doc.contract-rate
     1757            tt-c-fin-doc.contract-scale tt-c-fin-doc.sum-contr
     1758            tt-c-fin-doc.payer-type tt-c-fin-doc.payer-name B-payer-view
     1759            tt-c-fin-doc.payer-code tt-c-fin-doc.receiver-name
     1760            tt-c-fin-doc.receiver-bank-name B-receiver-view
     1761            tt-c-fin-doc.receiver-c-schet tt-c-fin-doc.naznach-plat
     1762            tt-c-fin-doc.PS tt-c-fin-doc.payer-sign1 tt-c-fin-doc.payer-sign2
     1763         WITH FRAME Dialog-Frame.
     1764     VIEW FRAME Dialog-Frame.
     1765   END PROCEDURE.
     1766   PROCEDURE fill-main-table :
     1767   define variable v-recid-schet as recid no-undo .
     1768   define variable v-recid-bank as recid no-undo .
     1769   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1770   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1771     (output v-db-num
     1772     )  .
     1773   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1774   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1775     (input  p-host-code
     1776     ,output v-base-code
     1777     )  .
     1778   find first X_curr_sysconf no-lock where
     1779                   X_curr_sysconf.host-code = p-curr-host-code.
     1780   find first X_sysconf no-lock where
     1781                 X_sysconf.host-code = p-host-code.
     1782   find first X_clients-host no-lock where
     1783               X_clients-host.obj-type = 'орг':U
     1784           AND   X_clients-host.obj-code = p-host-code  no-error.
     1785   if not available X_clients-host then do:
     1786     message
     1787     vss-workfile vss-revision vss-description skip
     1788     "Неверное значение параметра вызова p-host-code"  p-host-code
     1789     view-as alert-box ERROR.
     1790     undo, return error.
     1791   end.
     1792   find first X_firm no-lock where
     1793               X_firm.firm-code = p-host-code.
     1794   for each tt-c-fin-doc:
     1795     delete tt-c-fin-doc.
     1796   end.
     1797   for each tt0-fin-doc-attr:
     1798     delete tt0-fin-doc-attr.
     1799   end.
     1800   for each tt0-fin-doc-tax:
     1801     delete tt0-fin-doc-tax.
     1802   end.
     1803   find first locked_c-fin-doc no-lock where
     1804             recid(locked_c-fin-doc) = p-doc-rec no-error .
     1805   if not available locked_c-fin-doc then do:
     1806   find first locked_c-fin-doc no-lock where
     1807               locked_c-fin-doc.host-code = p-host-code
     1808           AND locked_c-fin-doc.fin-doc-code = p-fin-doc-code no-error .
     1809   end.
     1810   if not available locked_c-fin-doc then do:
     1811   message
     1812   vss-workfile vss-revision vss-description skip
     1813   "Не найдена запись ПРИХОДНОЕ ПЛАТЕЖНОЕ ПОРУЧЕНИЕ"
     1814   view-as alert-box error .
     1815   undo, return error.
     1816   end.
     1817   create tt-c-fin-doc.
     1818   buffer-copy locked_c-fin-doc to tt-c-fin-doc.
     1819   END PROCEDURE.
     1820   PROCEDURE Myenable :
     1821   define variable v-inn like ub.firm.inn no-undo .
     1822   define variable v-kpp like ub.firm.kpp no-undo .
     1823   define variable g-log as logical no-undo.
     1824   assign
     1825       tt-c-fin-doc.sum-rubl :label in frame Dialog-Frame = "Рубли"
     1826   .
     1827   tt-c-fin-doc.payer-inn:label in frame Dialog-Frame = "ИНН".
     1828   tt-c-fin-doc.receiver-inn:label in frame Dialog-Frame = "ИНН".
     1829   tt-c-fin-doc.payer-kpp:label in frame Dialog-Frame = "КПП".
     1830   tt-c-fin-doc.receiver-kpp:label in frame Dialog-Frame = "КПП".
     1831   run uf-get in this-procedure(
     1832       input  ('findoci-p':U + chr(4) + 'ппп':U)
     1833       ,input  v-cntxt-userid
     1834       ,output v-uf-List_
     1835       ,output v-uf-Naim
     1836       ,output v-uf-print-graft
     1837       ,output v-uf-sort-gr
     1838       ,output v-uf-type-price
     1839       ,output v-uf-type-val
     1840   )  no-error.
     1841   if not error-status:error
     1842   and not v-uf-LIst_ = "":U
     1843   then do:
     1844       assign
     1845       v-view =  entry(1, v-uf-List_, chr(4))
     1846       .
     1847   end.
     1848   assign
     1849   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + x_clients-host.obj-name
     1850   tt-c-fin-doc.payer-type:radio-buttons = "Орг" + chr(44) + 'орг':U + chr(44) +
     1851                                            "Чел" + chr(44) + 'чел':U
     1852   rs-view:radio-buttons = "&Полностью" + chr(44) + "full":U +  chr(44) +
     1853                                       "&Сокращ." + chr(44) + "brief":U + chr(44) +
     1854                                       "&Договор" + chr(44) + "contract":U
     1855   tt-c-fin-doc.obj-type:radio-buttons = "Маг" + chr(44) + 'маг':U + chr(44) +
     1856                                         "Скл" + chr(44) + 'скл':U
     1857   tt-c-fin-doc.vid-plat:list-items = 'почтой,телеграфом,электронно,':U
     1858   rs-view = v-view
     1859   .
     1860   if tt-c-fin-doc.contract-code = 0 then do:
     1861       assign
     1862       g-log = rs-view:disable(radio-label("contract":U, RS-view:radio-buttons))
     1863       .
     1864       if rs-view = "contract":U then
     1865       assign
     1866       rs-view = "full":U
     1867       v-not-uf-set = yes.
     1868   end.
     1869   find first X_currency no-lock where
     1870                 X_currency.curr-code = tt-c-fin-doc.curr-code.
     1871   assign
     1872   f-curr-abbr = X_Currency.curr-abbr.
     1873   if tt-c-fin-doc.cor-acc <> 0 then do:
     1874     find first X_fin-code-cor-acc no-lock where
     1875                 X_fin-code-cor-acc.fin-code  = tt-c-fin-doc.cor-acc no-error.
     1876     if available X_fin-code-cor-acc then do:
     1877       assign
     1878       f-cor-acc-descr = X_fin-code-cor-acc.descr.
     1879     end.
     1880     if not available X_fin-code-cor-acc
     1881     or (p-mode = 'ИЗМЕНЕНИЕ':U and X_fin-code-cor-acc.code-value <> tt-c-fin-doc.cor-acc-value ) then do:
     1882       assign
     1883       f-cor-acc-descr = "!!!Код больше не существует".
     1884     end.
     1885   end.
     1886   if tt-c-fin-doc.an-uchet-code <> 0 then do:
     1887   find first X_fin-code-an-uchet no-lock where
     1888                 X_fin-code-an-uchet.fin-code  = tt-c-fin-doc.an-uchet-code no-error.
     1889     if available X_fin-code-an-uchet then do:
     1890       assign
     1891       f-an-uchet-descr = X_fin-code-an-uchet.descr.
     1892     end.
     1893     if not available X_fin-code-an-uchet
     1894     or (p-mode = 'ИЗМЕНЕНИЕ':U and X_fin-code-an-uchet.code-value <> tt-c-fin-doc.an-uchet-value ) then do:
     1895       assign
     1896       f-an-uchet-descr = "!!!Код больше не существует".
     1897     end.
     1898   end.
     1899   if tt-c-fin-doc.cel-nazn-code <> 0 then do:
     1900     find first X_fin-code-cel-nazn no-lock where
     1901                   X_fin-code-cel-nazn.fin-code  = tt-c-fin-doc.cel-nazn-code no-error.
     1902     if available X_fin-code-cel-nazn then do:
     1903       assign
     1904       f-cel-nazn-descr = X_fin-code-cel-nazn.descr.
     1905     end.
     1906     if not available X_fin-code-cel-nazn
     1907     or (p-mode = 'ИЗМЕНЕНИЕ':U and X_fin-code-cel-nazn.code-value <> tt-c-fin-doc.cel-nazn-value ) then do:
     1908       assign
     1909       f-cel-nazn-descr = "!!!Код больше не существует".
     1910     end.
     1911   end.
     1912   IF tt-c-fin-doc.sttm-code <> 0 THEN DO:
     1913     FIND FIRST X_fin-statement NO-LOCK WHERE
     1914               X_fin-statement.host-code  = tt-c-fin-doc.host-code
     1915           AND X_fin-statement.sttm-code  = tt-c-fin-doc.sttm-code NO-ERROR.
     1916     IF NOT AVAILABLE X_fin-statement THEN DO:
     1917         FIND FIRST X_c-fin-statement NO-LOCK WHERE
     1918                   X_c-fin-statement.host-code  = tt-c-fin-doc.host-code
     1919               AND X_c-fin-statement.sttm-code  = tt-c-fin-doc.sttm-code NO-ERROR.
     1920       IF AVAILABLE X_c-fin-statement THEN DO:
     1921          ASSIGN
     1922          v-sttm-prn-doc-CODE = X_c-fin-statement.prn-doc-code.
     1923       END.
     1924       ELSE DO:
     1925           ASSIGN
     1926           v-sttm-prn-doc-CODE = "@НЕИЗВЕСТНАЯ ВЫПИСКА".
     1927       END.
     1928     END.
     1929     ELSE DO:
     1930         ASSIGN
     1931         v-sttm-prn-doc-CODE = X_fin-statement.prn-doc-code.
     1932     END.
     1933   END.
     1934   run proc-color-widgets in this-procedure("f-an-uchet-descr,f-cel-nazn-descr,f-contract-curr-abbr,f-contract-date,f-contract-prn-code,f-contract-rate," +                         "f-contract-scale,f-contract-type,f-cor-acc-descr,base-rate,base-scale,curr-code,exch-rate,exch-scale,contract-rate,contract-scale," +                         "fact-date,fin-doc-code,payer-code,payer-type,pay-date,perm-date,PS,receiver-code,receiver-type,sum-base,sum-rubl,sum-contr," +                         "user-name-doc,user-name-fact,user-name-perm.user-name-pl", no, yes, ?, grey_color).
     1935   run proc-color-widgets in this-procedure("F-curr-abbr,an-uchet-value,cel-nazn-value,cor-acc-value,doc-date," +                       "naznach-plat,payer-name,payer-inn,payer-kpp,payer-bank-name,payer-bik,payer-r-schet,payer-c-schet," +                       "prn-doc-code,receiver-name,receiver-inn,receiver-kpp,receiver-bank-name,receiver-bik,receiver-r-schet,receiver-c-schet,payer-sign1,payer-sign2" +                       "sum-doc", no, yes, ?, grey_color).
     1936   run change-view in this-procedure(rs-view).
     1937   VIEW FRAME Dialog-Frame.
     1938   END PROCEDURE.
