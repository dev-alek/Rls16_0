      511   procedure uf-get :
      512     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      513     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      514     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      515     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      516     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      517     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      518     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      519     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      520     do
      521     on error undo, return error
      522     :
      523       define buffer buf_usr-flt for ubflt.usr-flt .
      524       define variable v-use-List_     as logical   no-undo .
      525       define variable v-type-List_     as character no-undo .
      526       define variable v-format-List_   as character no-undo .
      527       define variable v-use-Naim      as logical   no-undo .
      528       define variable v-type-Naim      as character no-undo .
      529       define variable v-format-Naim    as character no-undo .
      530       define variable v-use-print-graft as logical   no-undo .
      531       define variable v-use-sort-gr     as logical   no-undo .
      532       define variable v-use-type-price  as logical   no-undo .
      533       define variable v-use-type-val    as logical   no-undo .
      534       define variable v-label          as character no-undo .
      535       define variable v-tooltip        as character no-undo .
      536       define variable v-user-can-edit  as logical   no-undo .
      537       define variable v-output-display as logical   no-undo .
      538       define variable v-other          as character no-undo .
      539       run uf-name in this-procedure
      540          (input  entry(1, p-code, chr(4))
      541         ,output v-use-List_
      542         ,output v-type-List_
      543         ,output v-format-List_
      544         ,output v-use-Naim
      545         ,output v-type-Naim
      546         ,output v-format-Naim
      547         ,output v-use-print-graft
      548         ,output v-use-sort-gr
      549         ,output v-use-type-price
      550         ,output v-use-type-val
      551         ,output v-label
      552         ,output v-tooltip
      553         ,output v-user-can-edit
      554         ,output v-output-display
      555         ,output v-other
      556         ) no-error .
      557       if error-status :error then do:
      558         undo, return error return-value .
      559       end.
      560       find first buf_usr-flt no-lock where
      561                  buf_usr-flt.Call-point     = p-code AND
      562                  buf_usr-flt.user-name       = p-user-name
      563         no-error .
      564       if avail buf_usr-flt then do:
      565         assign
      566         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      567         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      568         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      569         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      570         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      571         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      572         .
      573       end.
      574       else do:
      575         assign
      576         p-List_        = (if v-use-List_       then "":U                    else ?)
      577         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      578         p-print-graft  = (if v-use-print-graft then no                      else ?)
      579         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      580         p-type-price   = (if v-use-type-price  then no                      else ?)
      581         p-type-val     = (if v-use-List_       then no                      else ?)
      582         .
      583       end.
      584     end.
      585   end procedure.
      586   procedure uf-set :
      587     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      588     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      589     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      590     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      591     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      592     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      593     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      594     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      595     do
      596     on error undo, return error
      597     :
      598       define buffer buf_usr-flt for ubflt.usr-flt .
      599       define variable v-use-List_     as logical   no-undo .
      600       define variable v-type-List_     as character no-undo .
      601       define variable v-format-List_   as character no-undo .
      602       define variable v-use-Naim      as logical   no-undo .
      603       define variable v-type-Naim      as character no-undo .
      604       define variable v-format-Naim    as character no-undo .
      605       define variable v-use-print-graft as logical   no-undo .
      606       define variable v-use-sort-gr   as logical   no-undo .
      607       define variable v-use-type-price as logical   no-undo .
      608       define variable v-use-type-val  as logical   no-undo .
      609       define variable v-tooltip        as character no-undo .
      610       define variable v-label          as character no-undo .
      611       define variable v-user-can-edit  as logical   no-undo .
      612       define variable v-output-display as logical   no-undo .
      613       define variable v-other          as character no-undo .
      614       run uf-name in this-procedure
      615         (input  entry(1, p-code, chr(4))
      616         ,output v-use-List_
      617         ,output v-type-List_
      618         ,output v-format-List_
      619         ,output v-use-Naim
      620         ,output v-type-Naim
      621         ,output v-format-Naim
      622         ,output v-use-print-graft
      623         ,output v-use-sort-gr
      624         ,output v-use-type-price
      625         ,output v-use-type-val
      626         ,output v-label
      627         ,output v-tooltip
      628         ,output v-user-can-edit
      629         ,output v-output-display
      630         ,output v-other
      631         ) no-error .
      632       if error-status :error then do:
      633         undo, return error return-value .
      634       end.
      635       find first buf_usr-flt where
      636                  buf_usr-flt.Call-point     = p-code AND
      637                  buf_usr-flt.user-name       = p-user-name
      638         no-error .
      639       if not avail buf_usr-flt then do:
      640           create buf_usr-flt .
      641           assign
      642           buf_usr-flt.call-point = p-code
      643           buf_usr-flt.user-name  = p-user-name
      644           .
      645       end.
      646       if avail buf_usr-flt then do:
      647        assign
      648        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      649        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      650        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      651        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      652        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      653        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      654       .
      655       release buf_usr-flt.
      656       end.
      657       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      658     end.
      659   end procedure.
      660   function diff-list returns character (
      661     input parfirst-list  as character,
      662     input parsecond-list as character,
      663     input pardelim       as character).
      664     if pardelim = ""
      665     or pardelim = ?
      666     then do:
      667       assign
      668         pardelim = ","
      669       .
      670     end.
      671     def var ind as integer no-undo .
      672     def var v-elem as character no-undo .
      673     def var v-result-list as character no-undo init "".
      674     def var v-num-parfirst-list as integer no-undo .
      675     assign
      676       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      677     .
      678     do ind = 1 to v-num-parfirst-list
      679     :
      680       assign
      681         v-elem = entry(ind, parfirst-list, pardelim)
      682       .
      683       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      684         assign
      685           v-result-list = v-result-list
      686                         + (if v-result-list > "" then pardelim else "")
      687                         + v-elem
      688         .
      689       end.
      690     end.
      691     return v-result-list .
      692   end function.
      693   function add-list returns character (
      694    input parfirst-list  as character,
      695    input parsecond-list as character,
      696    input pardelim       as character).
      697     if pardelim = ""
      698     or pardelim = ?
      699     then do:
      700       assign
      701         pardelim = ","
      702       .
      703     end.
      704     def var ind as integer no-undo .
      705     def var v-elem as character no-undo .
      706     def var v-result-list as character no-undo init "".
      707     def var v-num-parfirst-list as integer no-undo .
      708     assign
      709       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      710     .
      711     do ind = 1 to v-num-parfirst-list
      712     :
      713       assign
      714         v-elem = entry(ind, parfirst-list, pardelim)
      715       .
      716       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      717         assign
      718           v-result-list = v-result-list
      719                         + (if v-result-list > "" then pardelim else "")
      720                         + v-elem
      721         .
      722       end.
      723     end.
      724     def var v-num-parsecond-list as integer no-undo .
      725     assign
      726       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      727     .
      728     do ind = 1 to v-num-parsecond-list
      729     :
      730       assign
      731         v-elem = entry(ind, parsecond-list, pardelim)
      732       .
      733       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      734         assign
      735           v-result-list = v-result-list
      736                         + (if v-result-list > "" then pardelim else "")
      737                         + v-elem
      738         .
      739       end.
      740     end.
      741     return v-result-list .
      742   end function.
      743   function cross-list returns character (
      744    input parfirst-list  as character,
      745    input parsecond-list as character,
      746    input pardelim       as character).
      747     if pardelim = ""
      748     or pardelim = ?
      749     then do:
      750       assign
      751         pardelim = ","
      752       .
      753     end.
      754     def var ind as integer no-undo .
      755     def var v-elem as character no-undo .
      756     def var v-result-list as character no-undo init "".
      757     def var v-num-parfirst-list as integer no-undo .
      758     assign
      759       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      760     .
      761     do ind = 1 to v-num-parfirst-list
      762     :
      763       assign
      764         v-elem = entry(ind, parfirst-list, pardelim)
      765       .
      766       if lookup(v-elem, v-result-list, pardelim) = 0
      767       and lookup(v-elem, parsecond-list, pardelim) > 0
      768       then do:
      769         assign
      770           v-result-list = v-result-list
      771                         + (if v-result-list > "" then pardelim else "")
      772                         + v-elem
      773         .
      774       end.
      775     end.
      776     return v-result-list .
      777   end function.
      778   function radio-label returns character (
      779    input par-rs-value  as character,
      780    input par-rs-radio-buttons as character)
      781    .
      782    DEFINE variable v-result-label as character no-undo.
      783    assign
      784    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      785                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      786                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      787                             ), par-rs-radio-buttons
      788                           )
      789    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      790    .
      791   return v-result-label.
      792   end function.
      793   function m-radio-label returns character (
      794    input par-rs-value  as character,
      795    input par-rs-radio-buttons as character,
      796    input par-delim as character
      797    )
      798    .
      799    DEFINE variable v-result-label as character no-undo.
      800    assign
      801    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      802                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      803                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      804                             ), par-rs-radio-buttons, par-delim
      805                           )
      806    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      807    .
      808   return v-result-label.
      809   end function.
      810   FUNCTION mixlist returns character
      811   (
      812    input parfirst-list  as character
      813    ,input parsecond-list as character
      814    ,input pardelim       as character
      815    ,input pardelim-result as character ) :
      816     if pardelim = ""
      817     or pardelim = ?
      818     then do:
      819       assign
      820         pardelim = ","
      821       .
      822     end.
      823     def var ind as integer no-undo .
      824     def var v-elem1 as character no-undo .
      825     def var v-elem2 as character no-undo .
      826     def var v-result-list as character no-undo init "".
      827     do ind = 1 to num-entries(parfirst-list, pardelim)
      828     :
      829       assign
      830         v-elem1 = entry(ind, parfirst-list, pardelim)
      831         v-elem2 = entry(ind, parsecond-list, pardelim)
      832       .
      833         assign
      834           v-result-list = v-result-list
      835                         + (if v-result-list > "" then pardelim-result else "")
      836                         + v-elem1 + pardelim-result + v-elem2
      837         .
      838     end.
      839     return v-result-list .
      840   END FUNCTION.
