     1273       ,input  '':U
     1274       ,input  0
     1275       ,input  0
     1276       ,input  0
     1277       ,input  0
     1278       ,input  true
     1279       ,output g-log
     1280       )  .
     1281   end.
     1282     if not g-log then  return .
     1283     ri = recid( X_contract ).
