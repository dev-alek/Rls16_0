     1231   procedure proc-color-widgets :
     1232   define input parameter p-list as character no-undo .
     1233   define input parameter p-fg as logical no-undo .
     1234   define input parameter p-bg as logical no-undo .
     1235   define input parameter p-fgc as integer no-undo .
     1236   define input parameter p-bgc as integer no-undo .
     1237   define variable ii as integer no-undo .
     1238   define variable fh as widget-handle no-undo .
     1239   define variable hh as widget-handle no-undo .
     1240     do
     1241     on error undo, return error
     1242     :
     1243       assign
     1244       fh = frame Dialog-Frame:first-child
     1245       hh = fh:first-child
     1246       .
     1247       do while valid-handle(hh):
     1248         if LOOKUP(hh:name, p-list) > 0  then do:
     1249           assign
     1250           hh:fgcolor = (if p-fg then p-fgc else hh:fgcolor)
     1251           hh:bgcolor = (if p-bg then p-bgc else hh:bgcolor)
     1252           .
     1253         end.
     1254         hh = hh:next-sibling.
     1255       end.
     1256     end.
     1257   end procedure.
     1258   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1259   ON CHOOSE OF B-contract-view IN FRAME Dialog-Frame
     1260   DO:
     1261   define variable g-log as logical no-undo.
     1262    define variable ri as recid no-undo .
     1263     if not avail X_contract then return no-apply.
     1264   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1265   do:
     1266     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1267       (input  v-cntxt-db-num
     1268       ,input  v-cntxt-userid
     1269       ,input  0
     1270       ,input  'actn_fin-contract_lookup':U
     1271       ,input  'firm':U
