        1   define input parameter p-mode           as character        no-undo.
        2   define input parameter p-recipe-code    as character        no-undo.
        3   define input parameter p-in-doc-code    as character        no-undo.
        4   define input parameter p-in-doc-date    as date             no-undo.
        5   define output parameter p-out-doc-code  as character        no-undo.
        6   define output parameter p-out-doc-date  as date             no-undo.
        7   define output parameter p-ok            as logical          no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Просмотр, изменение и добавление акта проработки для рецептов производства".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   procedure proc-alt-shift-f2:
       75     if not ibs.th.gbl.gbl-var:rcode
       76   then
       77     run gbl\inidebug.p .
       78   end.
       79   procedure proc-alt-shift-f3:
       80     run gbl/prvssinf.p
       81       ( input this-procedure
       82       ) .
       83   end.
       84   define variable v-inform-launched as logical no-undo initial false .
       85   procedure proc-alt-shift-f4:
       86     define variable v-action as character no-undo .
       87     if v-inform-launched = false then do:
       88       assign
       89         v-inform-launched = true
       90       .
       91       run gbl/d-inform.w
       92         (  input self
       93         ,  input this-procedure
       94         , output v-action
       95         ) no-error .
       96       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       97       assign
       98         v-inform-launched = false
       99       .
      100     end.
      101   end.
      102   procedure proc-alt-f1:
      103     run gbl/corrhelp.p
      104       (input this-procedure
      105       ) .
      106   end .
      107   on alt-shift-f2 anywhere do:
      108     run proc-alt-shift-f2.
      109   end.
      110   on alt-shift-f3 anywhere do:
      111     run proc-alt-shift-f3 in this-procedure .
      112   end.
      113   on alt-shift-f4 anywhere do:
      114     run proc-alt-shift-f4 in this-procedure.
      115   end.
      116   on alt-f1 anywhere do:
      117     run proc-alt-f1 in this-procedure .
      118   end.
      119   DEFINE BUTTON b-cancel AUTO-END-KEY DEFAULT
      120        LABEL "&Отмена"
      121        SIZE 10 BY 1
      122        BGCOLOR 8 .
      123   DEFINE BUTTON b-exit AUTO-GO
      124        LABEL "В&вод"
      125        SIZE 10 BY 1
      126        BGCOLOR 8 .
      127   DEFINE BUTTON b-help
      128        LABEL "Помощ&ь"
      129        SIZE 10 BY 1
      130        BGCOLOR 8 .
      131   DEFINE VARIABLE fi-doc-code AS CHARACTER FORMAT "X(256)":U
      132        LABEL "Номер акта"
      133        VIEW-AS FILL-IN
      134        SIZE 21 BY 1 NO-UNDO.
      135   DEFINE VARIABLE fi-doc-date AS DATE FORMAT "99.99.9999":U INITIAL ?
      136        LABEL "Дата"
      137        VIEW-AS FILL-IN
      138        SIZE 14 BY 1 NO-UNDO.
      139   DEFINE FRAME Dialog-Frame
      140        b-exit AT ROW 1.25 COL 2
      141        b-cancel AT ROW 1.25 COL 12
      142        b-help AT ROW 1.25 COL 28
      143        fi-doc-code AT ROW 3.5 COL 3.5
      144        fi-doc-date AT ROW 5 COL 13.5 COLON-ALIGNED
      145        SPACE(10.37) SKIP(0.87)
      146       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      147            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      148            TITLE "Акт проработки"
      149            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel.
      150   ASSIGN
      151          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      152          FRAME Dialog-Frame:HIDDEN           = TRUE.
      153   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      154   DO:
      155     APPLY "END-ERROR":U TO SELF.
      156   END.
      157   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      158   DO:
      159       assign
      160           p-ok = no
      161       .
      162   END.
      163   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      164   DO:
      165       define variable v-is-available     as logical      no-undo.
      166       define variable v-reason           as character    no-undo.
      167       define variable v-focus-handle     as handle       no-undo.
      168       assign
      169           fi-doc-code
      170           fi-doc-date
      171       .
      172       run check-output in this-procedure (
      173             input p-recipe-code
      174           , input fi-doc-code
      175           , input fi-doc-date
      176           , output v-is-available
      177           , output v-reason
      178           , output v-focus-handle
      179       ).
      180       if v-is-available = no
      181       then do:
      182           message
      183                    v-reason
      184               skip (1)
      185               skip "Исправьте данные или отмените ввод."
      186           view-as alert-box warning.
      187           apply "entry" to v-focus-handle.
      188           undo, return no-apply.
      189       end.
      190       else do:
      191           assign
      192               p-ok            = yes
      193               p-out-doc-code  = fi-doc-code
      194               p-out-doc-date  = fi-doc-date
      195           .
      196       end.
      197   END.
      198   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      199   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      200   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      201   on help of frame Dialog-Frame
      202   do:
      203     run gbl/app_help.p
      204       (input this-procedure :file-name
      205       ,input ''
      206       ,input ?
      207       ) no-error.
      208     if error-status :error then do:
      209       message
      210         "Ошибка при вызове помощи"
      211         error-status :get-message(1)
      212         view-as alert-box .
      213     end.
      214   end.
      215   run minbtn-set in this-procedure .
      216   on choose of b-help in frame Dialog-Frame
      217   do:
      218     apply "help":u to frame Dialog-Frame .
      219   end.
      220   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      221   procedure minbtn-set :
      222       do
      223           on error undo, return error return-value
      224           :
      225           define variable ii              as integer       no-undo .
      226           define variable fh              as widget-handle no-undo .
      227           define variable hh              as widget-handle no-undo .
      228           define variable v-h             as handle        extent 4 no-undo .
      229           define variable v-name-button   as character     no-undo .
      230           define variable v-help-old-x    as decimal       no-undo .
      231           define variable v-help-old-y    as decimal       no-undo .
      232           define variable v-help-old-size as decimal       no-undo .
      233           define variable v-frame-width   as decimal       no-undo .
      234           define variable jj              as integer       no-undo .
      235           do
      236               on error undo, return error
      237               :
      238               assign
      239                   v-frame-width = frame Dialog-Frame:width - 0.3
      240                   fh            = frame Dialog-Frame:first-child
      241                   hh            = fh:first-child
      242                   ii            = 1
      243                   .
      244               do while valid-handle(hh):
      245                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      246                   do:
      247                       case lc(hh:name) :
      248                           when "b-help" then
      249                               do:
      250                                   hh:load-image-up("cmp/b-help.bmp":u) .
      251                                   hh:load-image-down("cmp/b-help.bmp":u) .
      252                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      253                                   hh:TOOLTIP = "Помощь" .
      254                                   v-help-old-x = hh:column .
      255                                   v-help-old-y = hh:row    .
      256                                   v-help-old-size = hh:width .
      257                                   hh:width-chars = 2.5 .
      258                               end.
      259                           when "b-print" then
      260                               do:
      261                                   hh:load-image("cmp/b-print.bmp":u) .
      262                                   hh:TOOLTIP = "Печать" .
      263                                   v-h[ii] = hh:handle .
      264                                   ii = ii + 1 .
      265                                   hh:width-chars = 3 .
      266                               end.
      267                           when "b-history" or
      268                           when "b-hist" then
      269                               do:
      270                                   hh:load-image("cmp/b-hist.bmp":u) .
      271                                   hh:TOOLTIP = "История" .
      272                                   v-h[ii] = hh:handle .
      273                                   ii = ii + 1 .
      274                                   hh:width-chars = 3 .
      275                               end.
      276                           when "b-sch" then
      277                               do:
      278                                   hh:load-image("cmp/b-sch.bmp":u) .
      279                                   hh:TOOLTIP = "Установка Фильтра" .
      280                                   v-h[ii] = hh:handle .
      281                                   ii = ii + 1 .
      282                                   hh:width-chars = 3 .
      283                               end.
      284                           when "b-hist-user" then
      285                               do:
      286                                   hh:load-image("cmp/b-hist.bmp":u) .
      287                                   hh:TOOLTIP = "История пользователя" .
      288                                   ii = ii + 1 .
      289                               end.
      290                       end case.
      291                   end.
      292                   hh = hh:next-sibling.
      293               end.
      294               b-help:column = v-frame-width - b-help:width-chars.
      295               jj = 0.
      296               repeat ii = 4 to 1 by -1 :
      297                   if valid-handle (v-h[ii] ) then
      298                   do:
      299                       jj  = jj + 1 .
      300                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      301                       v-h[ii]:row    = v-help-old-y .
      302                   end.
      303               end.
      304           end.
      305       end.
      306   end procedure.
      307   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      308   on ' ' of fi-doc-date in frame Dialog-Frame
      309   do:
      310     if (can-query (self, "sensitive")
      311        and
      312        self :sensitive = true
      313        )
      314     or (can-query (self, "read-only")
      315        and
      316        self :read-only = false
      317        )
      318     then do:
      319       assign
      320         self :screen-value = ?
      321       .
      322     end.
      323     return no-apply.
      324   end.
      325   on delete-character of fi-doc-date in frame Dialog-Frame
      326   do:
      327     if (can-query (self, "sensitive")
      328        and
      329        self :sensitive = true
      330        )
      331     or (can-query (self, "read-only")
      332        and
      333        self :read-only = false
      334        )
      335     then do:
      336       assign
      337         self :screen-value = ?
      338       .
      339     end.
      340     return no-apply.
      341   end.
      342   on ctrl-d of fi-doc-date in frame Dialog-Frame
      343   do:
      344     define variable v-curr-sv-date as date no-undo .
      345     if (can-query (self, "sensitive")
      346        and
      347        self :sensitive = true
      348        )
      349     or (can-query (self, "read-only")
      350        and
      351        self :read-only = false
      352        )
      353     then do:
      354       if self :handle <> focus :handle
      355       then do:
      356         apply "entry":u to self .
      357       end.
      358       run gbl/getcurdt.p
      359         (output v-curr-sv-date
      360         ) .
      361       assign
      362         self :screen-value = string(v-curr-sv-date) .
      363       .
      364     end.
      365     return no-apply.
      366   end.
      367   on ctrl-b of fi-doc-date in frame Dialog-Frame
      368   do:
      369     if (can-query (self, "sensitive")
      370        and
      371        self :sensitive = true
      372        )
      373     or (can-query (self, "read-only")
      374        and
      375        self :read-only = false
      376        )
      377     then do:
      378       if self :handle <> focus :handle
      379       then do:
      380         apply "entry":u to self .
      381       end.
      382       define variable v-curr-sv-date as date no-undo .
      383       define variable v-new-sv-date  as date no-undo .
      384       assign
      385         v-curr-sv-date = date(self :screen-value) no-error
      386       .
      387       if v-curr-sv-date = ?
      388       then do:
      389         run gbl/getcurdt.p
      390           (output v-curr-sv-date
      391           ) .
      392       end.
      393       if v-curr-sv-date <> ?
      394       then do:
      395         assign
      396           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
      397         .
      398         assign
      399           self :screen-value = string(v-new-sv-date) .
      400         .
      401       end.
      402     end.
      403     return no-apply .
      404   end.
      405   on ctrl-e of fi-doc-date in frame Dialog-Frame
      406   do:
      407     if (can-query (self, "sensitive")
      408        and
      409        self :sensitive = true
      410        )
      411     or (can-query (self, "read-only")
      412        and
      413        self :read-only = false
      414        )
      415     then do:
      416       if self :handle <> focus :handle
      417       then do:
      418         apply "entry":u to self .
      419       end.
      420       define variable v-curr-sv-date as date no-undo .
      421       define variable v-new-sv-date  as date no-undo .
      422       assign
      423         v-curr-sv-date = date(self :screen-value) no-error
      424       .
      425       if v-curr-sv-date = ?
      426       then do:
      427         run gbl/getcurdt.p
      428           (output v-curr-sv-date
      429           ) .
      430       end.
      431       if v-curr-sv-date <> ?
      432       then do:
      433         run gbl/lastdate.p
      434           (input  v-curr-sv-date
      435           ,output v-new-sv-date
      436           ).
      437         assign
      438           self :screen-value = string(v-new-sv-date) .
      439         .
      440       end.
      441     end.
      442     return no-apply .
      443   end.
      444   on ctrl-f of fi-doc-date in frame Dialog-Frame
      445   do:
      446     if (can-query (self, "sensitive")
      447        and
      448        self :sensitive = true
      449        )
      450     or (can-query (self, "read-only")
      451        and
      452        self :read-only = false
      453        )
      454     then do:
      455       if self :handle <> focus :handle
      456       then do:
      457         apply "entry":u to self .
      458       end.
      459       define variable v-ok            as logical   no-undo .
      460       define variable v-curr-sv-date  as date      no-undo .
      461       define variable v-description   as character no-undo .
      462       assign
      463         v-curr-sv-date = date(self :screen-value) no-error
      464       .
      465       if v-curr-sv-date = ?
      466       then do:
      467         run gbl/getcurdt.p
      468           (output v-curr-sv-date
      469           ) .
      470       end.
      471       if v-curr-sv-date <> ?
      472       then do:
      473         run gbl/d-inpday.w
      474           (input ?
      475           ,input "Выбор даты"
      476           ,input v-description
      477           ,input ""
      478           ,input-output v-curr-sv-date
      479           ,output v-ok
      480           ).
      481         if v-ok = true
      482         then do:
      483           assign
      484             self :screen-value = string(v-curr-sv-date) .
      485           .
      486         end.
      487       end.
      488     end.
      489     return no-apply .
      490   end.
      491     define MENU m-ed-date3
      492       MENU-ITEM m-ed-date3-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      493       MENU-ITEM m-ed-date3-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      494       MENU-ITEM m-ed-date3-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      495       MENU-ITEM m-ed-date3-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      496       .
      497     if fi-doc-date :POPUP-MENU in frame Dialog-Frame = ?
      498     then do:
      499       ASSIGN
      500         fi-doc-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date3 :HANDLE
      501         fi-doc-date :MENU-MOUSE in frame Dialog-Frame = 3
      502       .
      503     end.
      504     define variable v-label-handle3 as handle no-undo .
      505     assign
      506       v-label-handle3 = fi-doc-date :side-label-handle in frame Dialog-Frame
      507     .
      508     if valid-handle (v-label-handle3)
      509     then do:
      510       if v-label-handle3 :tooltip = ""
      511       or v-label-handle3 :tooltip = ?
      512       then do:
      513         assign
      514           v-label-handle3 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      515         .
      516       end.
      517     end.
      518     ON CHOOSE OF MENU-ITEM m-ed-date3-1 in menu m-ed-date3 DO:
      519       apply "ctrl-b":U to fi-doc-date in frame Dialog-Frame .
      520     END.
      521     ON CHOOSE OF MENU-ITEM m-ed-date3-2 in menu m-ed-date3 DO:
      522       apply "ctrl-d":U to fi-doc-date in frame Dialog-Frame .
      523     END.
      524     ON CHOOSE OF MENU-ITEM m-ed-date3-3 in menu m-ed-date3 DO:
      525       apply "ctrl-e":U to fi-doc-date in frame Dialog-Frame .
      526     END.
      527     ON CHOOSE OF MENU-ITEM m-ed-date3-4 in menu m-ed-date3 DO:
      528       apply "ctrl-f":U to fi-doc-date in frame Dialog-Frame .
      529     END.
      530   MAIN-BLOCK:
      531   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      532      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      533      run init-fields in this-procedure.
      534     RUN enable_UI.
      535     apply "entry" to fi-doc-code .
      536     WAIT-FOR GO OF FRAME Dialog-Frame.
      537   END.
      538   RUN disable_UI.
      539   PROCEDURE check-output :
      540       define input parameter p-recipe-code    as character        no-undo.
      541       define input parameter p-doc-code       as character        no-undo.
      542       define input parameter p-doc-date       as date             no-undo.
      543       define output parameter p-ok            as logical          no-undo.
      544       define output parameter p-reason        as character        no-undo.
      545       define output parameter p-focus-handle  as handle           no-undo.
      546       define buffer buf_recipe-develop        for recipe-develop.
      547   do
      548   for buf_recipe-develop
      549   on error undo, return error
      550   :
      551       assign
      552           p-ok = yes
      553       .
      554       if p-mode = 'ДОБАВЛЕНИЕ':U
      555       then do:
      556           find first buf_recipe-develop no-lock
      557                where buf_recipe-develop.recipe-code = p-recipe-code
      558                  and buf_recipe-develop.doc-code    = p-doc-code
      559           no-error.
      560           if available buf_recipe-develop
      561           then do:
      562               assign
      563                   p-ok            = no
      564                   p-reason        = "Акт проработки с таким номером уже есть."
      565                   p-focus-handle  = fi-doc-code :handle in frame Dialog-Frame
      566               .
      567           end.
      568       end.
      569       if p-mode = 'ИЗМЕНЕНИЕ':U
      570       then do:
      571           if p-doc-code <> p-in-doc-code
      572           then do:
      573               find first buf_recipe-develop no-lock
      574                    where buf_recipe-develop.recipe-code = p-recipe-code
      575                      and buf_recipe-develop.doc-code    = p-doc-code
      576               no-error.
      577               if available buf_recipe-develop
      578               then do:
      579                   assign
      580                       p-ok            = no
      581                       p-reason        = "Акт проработки с таким номером уже есть."
      582                       p-focus-handle  = fi-doc-code :handle in frame Dialog-Frame
      583                   .
      584               end.
      585           end.
      586       end.
      587   end.
      588   END PROCEDURE.
      589   PROCEDURE disable_UI :
      590     HIDE FRAME Dialog-Frame.
      591   END PROCEDURE.
      592   PROCEDURE enable_UI :
      593     DISPLAY fi-doc-code fi-doc-date
      594         WITH FRAME Dialog-Frame.
      595     ENABLE b-exit b-cancel b-help fi-doc-code fi-doc-date
      596         WITH FRAME Dialog-Frame.
      597     VIEW FRAME Dialog-Frame.
      598   END PROCEDURE.
      599   PROCEDURE init-fields :
      600   do
      601   on error undo, return error
      602   :
      603       assign
      604           fi-doc-code = p-in-doc-code
      605           fi-doc-date = p-in-doc-date
      606       .
      607   end.
      608   END PROCEDURE.
