        1   define input parameter parparentproc as widget-handle   no-undo.
        2   define input parameter p-mode       as character    no-undo.
        3   define input parameter p-store-type as character    no-undo.
        4   define input parameter p-store-code as integer      no-undo.
        5   define input parameter p-grp-code   as integer      no-undo.
        6   define input parameter p-upper-code as integer      no-undo.
        7   define input parameter p-in-name    as character    no-undo.
        8   define input parameter p-in-code    as integer      no-undo.
        9   define output parameter p-out-name  as character    no-undo.
       10   define output parameter p-out-code  as integer      no-undo.
       11   define output parameter p-cancel    as logical initial yes no-undo.
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Просмотр и редактирование группы блюд".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   procedure proc-alt-shift-f2:
       77     if not ibs.th.gbl.gbl-var:rcode
       78   then
       79     run gbl\inidebug.p .
       80   end.
       81   procedure proc-alt-shift-f3:
       82     run gbl/prvssinf.p
       83       ( input this-procedure
       84       ) .
       85   end.
       86   define variable v-inform-launched as logical no-undo initial false .
       87   procedure proc-alt-shift-f4:
       88     define variable v-action as character no-undo .
       89     if v-inform-launched = false then do:
       90       assign
       91         v-inform-launched = true
       92       .
       93       run gbl/d-inform.w
       94         (  input self
       95         ,  input this-procedure
       96         , output v-action
       97         ) no-error .
       98       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       99       assign
      100         v-inform-launched = false
      101       .
      102     end.
      103   end.
      104   procedure proc-alt-f1:
      105     run gbl/corrhelp.p
      106       (input this-procedure
      107       ) .
      108   end .
      109   on alt-shift-f2 anywhere do:
      110     run proc-alt-shift-f2.
      111   end.
      112   on alt-shift-f3 anywhere do:
      113     run proc-alt-shift-f3 in this-procedure .
      114   end.
      115   on alt-shift-f4 anywhere do:
      116     run proc-alt-shift-f4 in this-procedure.
      117   end.
      118   on alt-f1 anywhere do:
      119     run proc-alt-f1 in this-procedure .
      120   end.
      121   define variable dflt-cd as character no-undo .
      122   DEFINE BUTTON b-cancel
      123        LABEL "&Отмена"
      124        SIZE 10 BY 1
      125        BGCOLOR 8 .
      126   DEFINE BUTTON b-exit
      127        LABEL "&Ввод"
      128        SIZE 10 BY 1
      129        BGCOLOR 8 .
      130   DEFINE BUTTON b-help
      131        LABEL "Помощ&ь"
      132        SIZE 10 BY 1
      133        BGCOLOR 8 .
      134   DEFINE BUTTON B-hist
      135        LABEL "Ис&тория"
      136        SIZE 10 BY 1.
      137   DEFINE VARIABLE fi-name AS CHARACTER FORMAT "X(256)":U
      138        LABEL "Наименование"
      139        VIEW-AS FILL-IN
      140        SIZE 46.63 BY 1 NO-UNDO.
      141   DEFINE VARIABLE fi-out-code AS INTEGER FORMAT ">>9":U INITIAL 0
      142        LABEL "Код кассы"
      143        VIEW-AS FILL-IN
      144        SIZE 11.38 BY 1 NO-UNDO.
      145   DEFINE FRAME Dialog-Frame
      146        b-exit AT ROW 1 COL 1
      147        b-cancel AT ROW 1 COL 11
      148        B-hist AT ROW 1 COL 41
      149        b-help AT ROW 1 COL 51
      150        fi-name AT ROW 3.13 COL 1.63
      151        fi-out-code AT ROW 4.5 COL 13.63 COLON-ALIGNED
      152        SPACE(36.23) SKIP(0.53)
      153       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      154            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      155            TITLE "Группа блюд"
      156            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel.
      157   ASSIGN
      158          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      159          FRAME Dialog-Frame:HIDDEN           = TRUE.
      160   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      161   DO:
      162     APPLY "END-ERROR":U TO SELF.
      163   END.
      164   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      165   DO:
      166       assign
      167           p-cancel   = yes
      168       .
      169       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      170   END.
      171   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      172   DO:
      173       assign
      174           fi-name
      175           fi-out-code
      176       .
      177       run check-output in this-procedure (
      178             input fi-name
      179           , input fi-out-code
      180       ).
      181       assign
      182           p-out-name = fi-name
      183           p-out-code = fi-out-code
      184           p-cancel   = no
      185       .
      186       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      187   END.
      188   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      189   DO:
      190    DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      191    run ref/cfggrphi.w (
      192                     input parparentproc
      193                    ,INPUT '':U
      194                    ,INPUT 'one'
      195                    ,INPUT p-store-type
      196                    ,INPUT p-store-code
      197                    ,INPUT p-grp-code
      198                    ,INPUT '':U
      199                    ,INPUT NO
      200                    ,INPUT '':U
      201                    ,OUTPUT v-rid-list) NO-ERROR.
      202   END.
      203   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      204   on help of frame Dialog-Frame
      205   do:
      206     run gbl/app_help.p
      207       (input this-procedure :file-name
      208       ,input ''
      209       ,input ?
      210       ) no-error.
      211     if error-status :error then do:
      212       message
      213         "Ошибка при вызове помощи"
      214         error-status :get-message(1)
      215         view-as alert-box .
      216     end.
      217   end.
      218   run minbtn-set in this-procedure .
      219   on choose of b-help in frame Dialog-Frame
      220   do:
      221     apply "help":u to frame Dialog-Frame .
      222   end.
      223   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      224   procedure minbtn-set :
      225       do
      226           on error undo, return error return-value
      227           :
      228           define variable ii              as integer       no-undo .
      229           define variable fh              as widget-handle no-undo .
      230           define variable hh              as widget-handle no-undo .
      231           define variable v-h             as handle        extent 4 no-undo .
      232           define variable v-name-button   as character     no-undo .
      233           define variable v-help-old-x    as decimal       no-undo .
      234           define variable v-help-old-y    as decimal       no-undo .
      235           define variable v-help-old-size as decimal       no-undo .
      236           define variable v-frame-width   as decimal       no-undo .
      237           define variable jj              as integer       no-undo .
      238           do
      239               on error undo, return error
      240               :
      241               assign
      242                   v-frame-width = frame Dialog-Frame:width - 0.3
      243                   fh            = frame Dialog-Frame:first-child
      244                   hh            = fh:first-child
      245                   ii            = 1
      246                   .
      247               do while valid-handle(hh):
      248                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      249                   do:
      250                       case lc(hh:name) :
      251                           when "b-help" then
      252                               do:
      253                                   hh:load-image-up("cmp/b-help.bmp":u) .
      254                                   hh:load-image-down("cmp/b-help.bmp":u) .
      255                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      256                                   hh:TOOLTIP = "Помощь" .
      257                                   v-help-old-x = hh:column .
      258                                   v-help-old-y = hh:row    .
      259                                   v-help-old-size = hh:width .
      260                                   hh:width-chars = 2.5 .
      261                               end.
      262                           when "b-print" then
      263                               do:
      264                                   hh:load-image("cmp/b-print.bmp":u) .
      265                                   hh:TOOLTIP = "Печать" .
      266                                   v-h[ii] = hh:handle .
      267                                   ii = ii + 1 .
      268                                   hh:width-chars = 3 .
      269                               end.
      270                           when "b-history" or
      271                           when "b-hist" then
      272                               do:
      273                                   hh:load-image("cmp/b-hist.bmp":u) .
      274                                   hh:TOOLTIP = "История" .
      275                                   v-h[ii] = hh:handle .
      276                                   ii = ii + 1 .
      277                                   hh:width-chars = 3 .
      278                               end.
      279                           when "b-sch" then
      280                               do:
      281                                   hh:load-image("cmp/b-sch.bmp":u) .
      282                                   hh:TOOLTIP = "Установка Фильтра" .
      283                                   v-h[ii] = hh:handle .
      284                                   ii = ii + 1 .
      285                                   hh:width-chars = 3 .
      286                               end.
      287                           when "b-hist-user" then
      288                               do:
      289                                   hh:load-image("cmp/b-hist.bmp":u) .
      290                                   hh:TOOLTIP = "История пользователя" .
      291                                   ii = ii + 1 .
      292                               end.
      293                       end case.
      294                   end.
      295                   hh = hh:next-sibling.
      296               end.
      297               b-help:column = v-frame-width - b-help:width-chars.
      298               jj = 0.
      299               repeat ii = 4 to 1 by -1 :
      300                   if valid-handle (v-h[ii] ) then
      301                   do:
      302                       jj  = jj + 1 .
      303                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      304                       v-h[ii]:row    = v-help-old-y .
      305                   end.
      306               end.
      307           end.
      308       end.
      309   end procedure.
      310   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      311   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      312   MAIN-BLOCK:
      313   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      314      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      315       run init-fields in this-procedure.
      316       RUN Myenable.
      317       if p-mode = 'ПРОСМОТР':U
      318       then do:
      319           apply "entry" to b-exit in frame Dialog-Frame .
      320           disable
      321               fi-name
      322           with frame Dialog-Frame .
      323           assign
      324               fi-name :fgcolor = 4
      325           .
      326       end.
      327       else do:
      328           apply "entry" to fi-name in frame Dialog-Frame .
      329       end.
      330       WAIT-FOR GO OF FRAME Dialog-Frame.
      331   END.
      332   RUN disable_UI.
      333   PROCEDURE check-output :
      334   do
      335   on error undo, return error
      336   :
      337   define input parameter p-name       as character    no-undo.
      338   define input parameter p-out-code   as integer      no-undo.
      339   define variable v-rezerved-out-code like ub.fbr-gds-grp.out-code no-undo .
      340       define buffer buf_fbr-gds-grp       for ub.fbr-gds-grp.
      341       if p-name = '' then do:
      342         message
      343         "Название группы не может быть пустым!"
      344         view-as alert-box error .
      345         undo, return error .
      346       end.
      347       find first buf_fbr-gds-grp no-lock
      348            where buf_fbr-gds-grp.obj-type   = p-store-type
      349              and buf_fbr-gds-grp.obj-code   = p-store-code
      350              and buf_fbr-gds-grp.upper-code = p-upper-code
      351              and buf_fbr-gds-grp.node-name  = p-name
      352              and buf_fbr-gds-grp.node-code  <> p-grp-code
      353       no-error.
      354       if available buf_fbr-gds-grp
      355       then do:
      356           message
      357               skip "Есть другая группа блюд с таким именем."
      358               skip(1)
      359               skip "Измените имя группы."
      360           view-as alert-box error
      361           title "Проверка введенных значений".
      362           undo, return error .
      363       end.
      364       find last buf_fbr-gds-grp no-lock where
      365                 buf_fbr-gds-grp.obj-type = "":U
      366             AND buf_fbr-gds-grp.obj-code = 0
      367             use-index pi .
      368       assign
      369       v-rezerved-out-code = buf_fbr-gds-grp.out-code
      370       .
      371       if p-out-code > 65535
      372       then do:
      373           message
      374                   "Код группы на кассе может быть числом от 0 до 65535."
      375               skip(1)
      376               skip "Измените код группы на кассе."
      377           view-as alert-box error
      378           title "Проверка введенных значений".
      379           undo, return error .
      380       end.
      381       if p-out-code <> 0
      382       and p-out-code < 9998
      383       then do:
      384           find first buf_fbr-gds-grp no-lock
      385                where buf_fbr-gds-grp.obj-type   = p-store-type
      386                  and buf_fbr-gds-grp.obj-code   = p-store-code
      387                  and buf_fbr-gds-grp.out-code   = p-out-code
      388                  and buf_fbr-gds-grp.node-code  <> p-grp-code
      389           no-error.
      390           if available buf_fbr-gds-grp
      391           then do:
      392               message
      393                   skip "Есть другая группа блюд с таким кодом на кассе."
      394                   skip(1)
      395                   skip "Измените код на кассе."
      396               view-as alert-box error
      397               title "Проверка введенных значений".
      398               undo, return error .
      399           end.
      400       end.
      401       if  p-out-code <> p-in-code
      402       and p-out-code <= v-rezerved-out-code
      403       and dflt-cd = 'MAGIA-XML':U
      404       then do:
      405           message
      406               skip substitute("Коды групп на кассе со значением менее &1 зарезервированы.",  v-rezerved-out-code)
      407               skip(1)
      408               skip "Измените код на кассе."
      409           view-as alert-box error
      410           title "Проверка введенных значений".
      411           undo, return error .
      412       end.
      413   end.
      414   END PROCEDURE.
      415   PROCEDURE disable_UI :
      416     HIDE FRAME Dialog-Frame.
      417   END PROCEDURE.
      418   PROCEDURE enable_UI :
      419     DISPLAY fi-name fi-out-code
      420         WITH FRAME Dialog-Frame.
      421     ENABLE b-exit b-cancel B-hist b-help fi-name fi-out-code
      422         WITH FRAME Dialog-Frame.
      423     VIEW FRAME Dialog-Frame.
      424   END PROCEDURE.
      425   PROCEDURE init-fields :
      426   do
      427   on error undo, return error
      428   :
      429       assign
      430           fi-name     = p-in-name
      431           fi-out-code = p-in-code
      432       .
      433   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      434   define variable v-param-type2 as character no-undo .
      435   define variable v-value-date2 as date no-undo .
      436   define variable v-value-decimal2 as decimal no-undo .
      437   define variable v-value-integer2 as INTEGER no-undo .
      438   define variable v-value-logical2 AS LOGICAL no-undo .
      439   define variable v-tth2 as handle no-undo .
      440   run adm/shattri.p (
      441       input "get":U
      442       ,input  p-store-type
      443       ,input  p-store-code
      444       ,input  'cd-sending':U
      445       ,input  'dflt-cd':U
      446       ,output dflt-cd
      447       ,output v-value-date2
      448       ,output v-value-decimal2
      449       ,output v-value-integer2
      450       ,output v-value-logical2
      451       ,output v-param-type2
      452       ,INPUT-OUTPUT table-handle v-tth2
      453       )  .
      454   delete object v-tth2 no-error.
      455   end.
      456   END PROCEDURE.
      457   PROCEDURE MyEnable :
      458     DISPLAY
      459     fi-name
      460     fi-out-code
      461     WITH FRAME Dialog-Frame.
      462     ENABLE
      463     b-exit
      464     b-cancel
      465     B-hist
      466     b-help WHEN p-mode <> 'ДОБАВЛЕНИЕ':U
      467     fi-name
      468     fi-out-code
      469     WITH FRAME Dialog-Frame.
      470     VIEW FRAME Dialog-Frame.
      471   END PROCEDURE.
