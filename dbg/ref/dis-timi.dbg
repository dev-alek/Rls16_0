      989     run ref/disctrls.w (
      990                      INPUT parParentProc
      991                     ,input "":U
      992                     ,input "rl-root":U
      993                     ,input tt-dis-time-rule.time-rule-num
      994                     ,input tt-dis-time-rule.upper-time-rule-num
      995                     ,input-output v-rid-list ).
      996   END.
      997   ON CHOOSE OF B-quit-1 IN FRAME Dialog-Frame
