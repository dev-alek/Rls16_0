     2193             (input  v-cntxt-db-num
     2194             ,input  v-cntxt-userid
     2195             ,input  'wndmax':U
     2196             ,output v-diasize-wndmax
     2197             ,output v-default-value
     2198             ) .
     2199         end.
     2200         assign
     2201           v-diasize-wndstore = false
     2202         .
     2203         if connected("ub") = true
     2204         then do:
     2205           run gbl/wndpar_r.p
     2206             (input  v-cntxt-db-num
     2207             ,input  v-cntxt-userid
     2208             ,input  'wndstore':U
     2209             ,output v-diasize-wndstore
     2210             ,output v-default-value
     2211             ) .
     2212         end.
     2213         assign
     2214           v-diasize-proc-name = entry(1, program-name(2), '.')
     2215         .
     2216         if v-diasize-wndstore = true
     2217         then do:
     2218           assign
     2219             v-restore-saved = false
     2220           .
     2221           if connected("ub") = true
     2222           then do:
     2223             run gbl/wndsizer.p
     2224               (input  v-cntxt-db-num
     2225               ,input  v-cntxt-userid
     2226               ,input  v-diasize-proc-name
     2227               ,input  'height':u
     2228               ,output v-resize-value-str
     2229               ) .
     2230             if v-resize-value-str <> '':U
     2231             then do:
     2232               run diasize_change-height in this-procedure
     2233                 (input  integer(v-resize-value-str)
     2234                 ,input  true
     2235                 ) .
     2236               assign
     2237                 v-restore-saved = true
     2238               .
     2239             end.
     2240           end.
     2241           if connected("ub") = true
     2242           then do:
     2243             run gbl/wndsizer.p
     2244               (input  v-cntxt-db-num
     2245               ,input  v-cntxt-userid
     2246               ,input  v-diasize-proc-name
     2247               ,input  'width':u
     2248               ,output v-resize-value-str
     2249               ) .
     2250             if v-resize-value-str <> '':U
     2251             then do:
     2252               run diasize_change-width in this-procedure
     2253                 (input  integer(v-resize-value-str)
     2254                 ,input  true
     2255                 ) .
     2256               assign
     2257                 v-restore-saved = true
     2258               .
     2259             end.
     2260           end.
     2261           if v-restore-saved <> true
     2262           then do:
     2263             if v-diasize-wndmax = true
     2264             then do:
     2265               run diasize_maximize in this-procedure
     2266                 (input  true
     2267                 ) .
     2268             end.
     2269           end.
     2270         end.
     2271         else do:
     2272           if v-diasize-wndmax = true
     2273           then do:
     2274             run diasize_maximize in this-procedure
     2275               (input  true
     2276               ) .
     2277           end.
     2278         end.
     2279       end.
     2280     end.
     2281   end procedure.
     2282   procedure diasize_need-full-display :
     2283     define output parameter p-need-full-display as logical   no-undo .
     2284     do
     2285     on error undo, return error return-value
     2286     :
