     4045   if error-status:error then do:
     4046   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4047   define variable fh as widget-handle no-undo .
     4048   define variable hh as widget-handle no-undo .
     4049   define variable rv as character no-undo .
     4050   assign
     4051   rv = entry(1, return-value , chr(4)).
     4052   if rv <> "":U then do:
     4053     assign
     4054     fh = frame Dialog-Frame:first-child
     4055     hh = fh:first-child
     4056     .
     4057     do while valid-handle(hh):
     4058       if hh:name = rv then do:
     4059         APPLY "ENTRY" to hh.
     4060         undo ,
     4061         return error.
     4062       end.
     4063       hh = hh:next-sibling.
     4064     end.
     4065   end.
     4066     undo, return error.
     4067   end.
     4068   END PROCEDURE.
