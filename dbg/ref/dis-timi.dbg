     2295   procedure get-context :
     2296      define output parameter p-db-num as integer          no-undo.
     2297      define output parameter p-user-id as character        no-undo.
     2298      define variable v-login               as character    no-undo.
     2299      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2300      define buffer buf_user-login  for ub.user-login .
     2301      do
     2302      on error undo, return error
     2303      :
     2304            FIND FIRST buf_sys-ctrl no-lock.
     2305            ASSIGN
     2306               v-login = USERID("ub")
     2307               p-db-num = buf_sys-ctrl.db-num
     2308            .
     2309            FIND FIRST buf_user-login
     2310                 WHERE buf_user-login.db-num = p-db-num
     2311                   AND buf_user-login.user-login = v-login
     2312                 no-lock
     2313                 no-error
     2314                 .
     2315            IF AVAILABLE buf_user-login
     2316            THEN DO:
     2317               assign
     2318                  p-user-id = buf_user-login.user-id
     2319               .
     2320            END.
     2321      end.
     2322   end procedure.
     2323       run diasize_init in this-procedure .
     2324   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2325   ON TAB ANYWHERE
     2326   DO:
     2327   define variable ii as integer no-undo .
     2328   define variable fh as widget-handle no-undo .
     2329   define variable hh as widget-handle no-undo .
     2330   define variable v-next-widget-name as character no-undo .
     2331   if v-tab-order <> '' then do:
     2332     if self:type = "TOGGLE-BOX" then
     2333     self:BGCOLOR = ?.
     2334     assign
     2335     ii = lookup(self:name, v-tab-order).
     2336     assign
     2337     ii = ii + 1
     2338     v-next-widget-name = entry(ii, v-tab-order)
     2339     no-error .
     2340     if error-status:error then do:
     2341       assign
     2342       ii = 1
     2343       v-next-widget-name = entry( ii, v-tab-order)
     2344       .
     2345     end.
     2346     assign
     2347     fh = frame Dialog-Frame:first-child
     2348     hh = fh:first-child
     2349     .
     2350     do while valid-handle(hh):
     2351       if hh:name = v-next-widget-name then do:
     2352         if hh:sensitive  = yes
     2353         AND hh:visible = yes then do:
     2354           if hh:type = "TOGGLE-BOX":U then do:
     2355             assign
     2356             hh:BGcolor = 1
     2357             .
     2358           end.
     2359           APPLY "ENTRY" to hh.
     2360           return no-apply.
     2361         end.
     2362         else do:
     2363           APPLY "TAB" to hh.
     2364           return no-apply.
     2365         end.
     2366       end.
     2367       hh = hh:next-sibling.
     2368     end.
     2369   end.
     2370   END.
     2371   ON BACK-TAB ANYWHERE
     2372   DO:
     2373   define variable ii as integer no-undo .
     2374   define variable fh as widget-handle no-undo .
     2375   define variable hh as widget-handle no-undo .
     2376   define variable v-next-widget-name as character no-undo .
     2377   if v-tab-order <> '' then do:
     2378     assign
     2379     ii = lookup(self:name, v-tab-order).
     2380     .
     2381     assign
     2382     ii = (if ii = 1
     2383           then  num-entries(v-tab-order)
     2384           else ii - 1
     2385           )
     2386     v-next-widget-name = entry(ii, v-tab-order)
     2387     .
     2388     assign
     2389     fh = frame Dialog-Frame:first-child
     2390     hh = fh:first-child
     2391     .
     2392     do while valid-handle(hh):
     2393       if hh:name = v-next-widget-name then do:
     2394         if hh:sensitive  = yes
     2395         AND hh:visible = yes then do:
     2396           if hh:type = "TOGGLE-BOX":U then do:
     2397             assign
     2398             hh:BGcolor = 1
     2399             .
     2400           end.
     2401           APPLY "ENTRY" to hh.
     2402           return no-apply.
     2403         end.
     2404         else do:
     2405         APPLY "BACK-TAB" to hh.
     2406         return no-apply.
     2407         end.
     2408       end.
     2409       hh = hh:next-sibling.
     2410     end.
     2411     end.
     2412   END.
     2413   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2414   ON RETURN ANYWHERE
     2415   DO:
     2416   define variable ii as integer no-undo .
     2417   define variable fh as widget-handle no-undo .
     2418   define variable hh as widget-handle no-undo .
     2419   define variable v-next-widget-name as character no-undo .
     2420     if v-tab-order <> '' then do:
     2421       assign
     2422       ii = lookup(self:name, v-tab-order).
     2423       if ii = num-entries(v-tab-order) then do:
     2424           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     2425           return no-apply.
     2426       end.
     2427       if self:type <> "BUTTON" and
     2428         self:type <> "EDITOR"  then do:
     2429         run proc-move-forward in this-procedure .
     2430         return no-apply.
     2431       end.
     2432       if self:type = "BUTTON" then do:
     2433         APPLY "CHOOSE" to self.
     2434       end.
     2435       if self:type = "TOGGLE-BOX" then
     2436       self:BGCOLOR = ?.
     2437       assign
     2438       ii = ii + 1
     2439       v-next-widget-name = entry(ii, v-tab-order)
     2440       no-error .
     2441       if error-status:error then do:
     2442         assign
     2443         ii = 1
     2444         v-next-widget-name = entry( ii, v-tab-order)
     2445         .
     2446       end.
     2447       assign
     2448       fh = frame Dialog-Frame:first-child
     2449       hh = fh:first-child
     2450       .
     2451       do while valid-handle(hh):
     2452         if hh:name = v-next-widget-name then do:
     2453           if hh:sensitive  = yes
     2454           AND hh:visible = yes then do:
     2455             if hh:type = "TOGGLE-BOX":U then do:
     2456               assign
     2457               hh:BGcolor = 1
     2458               .
     2459             end.
     2460             APPLY "ENTRY" to hh.
     2461             return no-apply.
     2462           end.
     2463           else do:
     2464             APPLY "TAB" to hh.
     2465             return no-apply.
     2466           end.
     2467         end.
     2468         hh = hh:next-sibling.
     2469       end.
     2470     end.
     2471   END.
     2472   procedure proc-move-forward :
     2473   define variable ii as integer no-undo .
     2474   define variable fh as widget-handle no-undo .
     2475   define variable hh as widget-handle no-undo .
     2476   define variable v-next-widget-name as character no-undo .
     2477   do
     2478   on error undo, return error
     2479   :
     2480     if v-tab-order <> '' then do:
     2481       if self:type = "TOGGLE-BOX" then
     2482       self:BGCOLOR = ?.
     2483       assign
     2484       ii = lookup(self:name, v-tab-order).
     2485       assign
     2486       ii = ii + 1
     2487       v-next-widget-name = entry(ii, v-tab-order)
     2488       no-error .
     2489       if error-status:error then do:
     2490         assign
     2491         ii = 1
     2492         v-next-widget-name = entry( ii, v-tab-order)
     2493         .
     2494       end.
     2495       assign
     2496       fh = frame Dialog-Frame:first-child
     2497       hh = fh:first-child
     2498       .
     2499       do while valid-handle(hh):
     2500         if hh:name = v-next-widget-name then do:
     2501           if hh:sensitive  = yes
     2502           AND hh:visible = yes then do:
     2503             if hh:type = "TOGGLE-BOX":U then do:
     2504               assign
     2505               hh:BGcolor = 1
     2506               .
     2507             end.
     2508             APPLY "ENTRY" to hh.
     2509             return.
     2510           end.
     2511           else do:
     2512             assign
     2513             ii = ii + 1
     2514             v-next-widget-name = entry(ii, v-tab-order)
     2515             no-error .
     2516             if error-status:error then do:
     2517               assign
     2518               ii = 1
     2519               v-next-widget-name = entry( ii, v-tab-order)
     2520               .
     2521             end.
     2522           end.
     2523         end.
     2524         hh = hh:next-sibling.
     2525       end.
     2526     end.
     2527   end.
     2528   end procedure.
     2529   MAIN-BLOCK:
     2530   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2531      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2532     IF p-mode <> 'ƒŒ¡¿¬À≈Õ»≈':U
     2533     and p-mode <> 'œ–Œ—ÃŒ“–':U
     2534     and p-mode <> '»«Ã≈Õ≈Õ»≈':U THEN DO:
     2535         MESSAGE
     2536         vss-workfile vss-revision vss-description skip
     2537         "ÕÂ‚ÂÌÓÂ ÁÌ‡˜ÂÌËÂ Ô‡‡ÏÂÚ‡ p-mode" p-mode
     2538         VIEW-AS ALERT-BOX ERROR.
     2539         UNDO, RETURN ERROR.
     2540     END.
     2541     IF p-mode <> 'ƒŒ¡¿¬À≈Õ»≈':U THEN DO:
     2542     END.
     2543     for each tt-dis-time-rule:
     2544       delete tt-dis-time-rule.
     2545     end.
     2546     for each tt0-term_dis-time-rule:
     2547       delete tt0-term_dis-time-rule.
     2548     end.
     2549   if p-mode = '»«Ã≈Õ≈Õ»≈':U
     2550     or p-mode = 'œ–Œ—ÃŒ“–':U then do:
     2551       if p-mode = '»«Ã≈Õ≈Õ»≈':U then do:
     2552         find first locked_dis-time-rule EXclusive-lock where
     2553                      recid(locked_dis-time-rule) = p-recid no-wait no-error.
     2554         if locked locked_dis-time-rule then do:
     2555           message
     2556           vss-workfile vss-revision vss-description skip
     2557            "«‡ÔËÒ¸ –¿—œ»—¿Õ»≈ Á‡ÌˇÚ‡"
     2558           view-as alert-box error .
     2559           undo, return error.
     2560         end.
     2561       end.
     2562       else do:
     2563         find first locked_dis-time-rule no-lock where
     2564                          recid(locked_dis-time-rule) = p-recid no-error .
     2565         if not avail locked_dis-time-rule then do:
     2566           find first locked_dis-time-rule no-lock where
     2567                      locked_dis-time-rule.time-rule-num = p-time-rule-num no-error .
     2568         end.
     2569       end.
     2570       if not available locked_dis-time-rule then do:
     2571         message
     2572         vss-workfile vss-revision vss-description skip
     2573         "ÕÂ Ì‡È‰ÂÌ‡ Á‡ÔËÒ¸ –¿—œ»—¿Õ»ﬂ Ò ÌÓÏÂÓÏ" p-time-rule-num
     2574         view-as alert-box error .
     2575         undo, return error.
     2576       end.
     2577       if locked_dis-time-rule.time-rule-num <= 99999
     2578       and p-mode = '»«Ã≈Õ≈Õ»≈':U then do:
     2579         message
     2580         vss-workfile vss-revision vss-description skip
     2581         "ÕÂÎ¸Áˇ Â‰‡ÍÚËÓ‚‡Ú¸ ÿ¿¡ÀŒÕ€ –¿—œ»—¿Õ»…"
     2582         view-as alert-box error .
     2583         undo, return error.
     2584       end.
     2585       create tt-dis-time-rule.
     2586       buffer-copy locked_dis-time-rule to tt-dis-time-rule
     2587       .
     2588      end.
     2589      else do:
     2590          FIND FIRST template_dis-time-rule NO-LOCK WHERE
     2591                       template_dis-time-rule.time-rule-num = p-templ-rl-root .
     2592          create tt-dis-time-rule.
     2593          BUFFER-COPY template_dis-time-rule TO tt-dis-time-rule
     2594          ASSIGN
     2595          tt-dis-time-rule.upper-time-rule-num = template_dis-time-rule.time-rule-num
     2596          tt-dis-time-rule.templ-rl-root  = template_dis-time-rule.time-rule-num
     2597          tt-dis-time-rule.root        = yes
     2598          tt-dis-time-rule.des = trim(template_dis-time-rule.des, "@":U)
     2599          .
     2600     end.
     2601     run dtr-code  in this-procedure (
     2602        input  (if p-templ-rl-root > 0 then p-templ-rl-root else tt-dis-time-rule.templ-rl-root)
     2603       ,output vt-des
     2604       ,output vt-upper-time-rule-num
     2605       ,output vt-value-type
     2606       ,output vt-level-1
     2607       ,output vt-level-2
     2608       ,output vt-output-display
     2609       ,output vt-tree
     2610       ,output vt-other
     2611                                  ) no-error .
     2612     IF ERROR-STATUS:ERROR THEN DO:
     2613       MESSAGE
     2614       vss-workfile vss-revision vss-description skip
     2615       "ÕÂ‚ÂÌÓÂ ÁÌ‡˜ÂÌËÂ Ô‡‡ÏÂÚ‡ p-templ-rl-root" p-templ-rl-root SKIP
     2616        error-status:get-message(1) SKIP
     2617        RETURN-VALUE
     2618       VIEW-AS ALERT-BOX ERROR.
     2619       UNDO, RETURN ERROR.
     2620     END.
     2621     run disrules-fill-properties in this-procedure ( input p-templ-rl-root).
     2622     if p-upper-time-rule-num > 99999 then do:
     2623       assign
     2624       vt-tree = "":U.
     2625     end.
     2626     RUN fill-tables IN THIS-PROCEDURE NO-ERROR.
     2627     IF ERROR-STATUS:ERROR THEN UNDO, RETURN ERROR.
     2628     RUN MYenable in this-procedure .
     2629     WAIT-FOR GO OF FRAME Dialog-Frame.
     2630   END.
     2631   RUN disable_UI.
     2632   PROCEDURE check-time :
     2633   define input parameter p-screen-value as integer no-undo.
     2634   define input parameter p-mode as character no-undo.
     2635   define variable v-limit as integer no-undo.
     2636   CASE p-mode:
     2637       when "hour":U then do:
     2638            v-limit = 23.
     2639       end.
     2640       when "min":U then do:
     2641             v-limit = 59.
     2642       end.
     2643       when "sec" then do:
     2644             v-limit = 59.
     2645       end.
     2646   END.
     2647     if int(p-screen-value) > v-limit then do:
     2648       bell.
     2649       Message "ÕÂ‚ÂÌÓÂ ‚ÂÏˇ!" view-as alert-box ERROR.
     2650       return error.
     2651     end.
     2652    if error-status:error then return error.
     2653   END PROCEDURE.
     2654   PROCEDURE disable_UI :
     2655     HIDE FRAME Dialog-Frame.
     2656   END PROCEDURE.
     2657   PROCEDURE display-hide-fields :
     2658   DEFINE INPUT PARAMETER p-tree AS CHARACTER NO-UNDO.
     2659   DEFINE INPUT PARAMETER p-other AS CHARACTER NO-UNDO.
     2660   DEFINE INPUT PARAMETER p-main AS LOGICAL NO-UNDO.
     2661   DEFINE INPUT PARAMETER p-display-hide AS integer NO-UNDO.
     2662   CASE p-display-hide:
     2663       WHEN 1 THEN DO:
     2664         IF p-main THEN DO:
     2665           IF lookup("time-from":U, vt-level-1) > 0
     2666           THEN DO:
     2667              DISPLAY
     2668              fhour fmin fsec
     2669              WITH FRAME Dialog-Frame.
     2670              ENABLE
     2671              fhour WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
     2672              fmin WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
     2673              fsec WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
     2674              WITH FRAME Dialog-Frame.
     2675           END.
     2676           else do:
     2677             hide
     2678             fhour fmin fsec
     2679             in FRAME Dialog-Frame.
     2680           end.
     2681           IF lookup("time-to", vt-level-1) > 0 THEN DO:
     2682              DISPLAY
     2683              thour tmin tsec
     2684              WITH FRAME Dialog-Frame.
     2685              ENABLE
     2686              thour WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
     2687              tmin WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
     2688              tsec WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
     2689              WITH FRAME Dialog-Frame.
     2690           END.
     2691           else do:
     2692             hide
     2693             thour tmin tsec
     2694             in FRAME Dialog-Frame.
     2695           end.
     2696           IF lookup("date-from":U, vt-level-1) >  0 THEN DO:
     2697              DISPLAY
     2698              tt-dis-time-rule.date-from
     2699              WITH FRAME Dialog-Frame.
     2700              ENABLE
     2701              tt-dis-time-rule.date-from WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
     2702              WITH FRAME Dialog-Frame.
     2703           END.
     2704           else do:
     2705             hide
     2706             tt-dis-time-rule.date-from
     2707             in FRAME Dialog-Frame.
     2708           end.
     2709           IF lookup("date-to":U, vt-level-1) >  0 THEN DO:
     2710              DISPLAY
     2711              tt-dis-time-rule.date-to
     2712              WITH FRAME Dialog-Frame.
     2713              ENABLE
     2714              tt-dis-time-rule.date-to WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
     2715              WITH FRAME Dialog-Frame.
     2716           END.
     2717           else do:
     2718             hide
     2719             tt-dis-time-rule.date-to
     2720             in FRAME Dialog-Frame.
     2721           end.
     2722           IF lookup("month-day":U, vt-level-1) >  0 THEN DO:
     2723              DISPLAY
     2724              tt-dis-time-rule.month-day
     2725              WITH FRAME Dialog-Frame.
     2726              ENABLE
     2727              tt-dis-time-rule.month-day WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
     2728              WITH FRAME Dialog-Frame.
     2729           END.
     2730           else do:
     2731             hide
     2732             tt-dis-time-rule.month-day
     2733             in FRAME Dialog-Frame.
     2734           end.
