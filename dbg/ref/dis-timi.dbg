        1   DEFINE BUFFER locked_dis-time-rule FOR ub.dis-time-rule.
        2   DEFINE BUFFER root_dis-time-rule FOR ub.dis-time-rule.
        3   DEFINE BUFFER template_dis-time-rule FOR ub.dis-time-rule.
        4   DEFINE TEMP-TABLE term_dis-time-rule NO-UNDO LIKE ub.dis-time-rule.
        5   DEFINE TEMP-TABLE tt-dis-time-rule NO-UNDO LIKE ub.dis-time-rule.
        6   DEFINE TEMP-TABLE tt0-term_dis-time-rule NO-UNDO LIKE ub.dis-time-rule.
        7   DEFINE INPUT PARAMETER parparentproc AS widget-handle NO-UNDO.
        8   DEFINE INPUT PARAMETER p-mode AS character NO-UNDO.
        9   DEFINE INPUT PARAMETER p-templ-rl-root like ub.dis-time-rule.templ-rl-root NO-UNDO.
       10   DEFINE INPUT PARAMETER p-time-rule-num LIKE ub.dis-time-rule.time-rule-num NO-UNDO.
       11   define input parameter p-upper-time-rule-num like ub.dis-time-rule.upper-time-rule-num no-undo .
       12   DEFINE INPUT-OUTPUT PARAMETER p-recid AS recid NO-UNDO.
       13   define variable vss-revision    as character no-undo init "$Revision$":U .
