     3132   PROCEDURE enable_UI :
     3133     OPEN QUERY Dialog-Frame FOR EACH tt-dis-time-rule SHARE-LOCK.
     3134     GET FIRST Dialog-Frame.
     3135     DISPLAY fhour fmin fsec thour tmin tsec RS-week-day lfromt ltot
     3136         WITH FRAME Dialog-Frame.
     3137     IF AVAILABLE tt-dis-time-rule THEN
     3138       DISPLAY tt-dis-time-rule.des tt-dis-time-rule.date-from
     3139             tt-dis-time-rule.date-to tt-dis-time-rule.month-day
     3140             tt-dis-time-rule.week-day-1 tt-dis-time-rule.week-day-2
     3141             tt-dis-time-rule.week-day-3 tt-dis-time-rule.week-day-4
     3142             tt-dis-time-rule.week-day-5 tt-dis-time-rule.week-day-6
     3143             tt-dis-time-rule.week-day-7
     3144         WITH FRAME Dialog-Frame.
     3145     ENABLE B-exit b-quit b-hist B-Help tt-dis-time-rule.des B-add B-del
     3146            tt-dis-time-rule.date-from br-term-dtr tt-dis-time-rule.date-to fhour
     3147            fmin fsec thour tmin tsec tt-dis-time-rule.month-day
     3148            tt-dis-time-rule.week-day-1 RS-week-day tt-dis-time-rule.week-day-2
     3149            tt-dis-time-rule.week-day-3 tt-dis-time-rule.week-day-4
     3150            tt-dis-time-rule.week-day-5 tt-dis-time-rule.week-day-6
     3151            tt-dis-time-rule.week-day-7 B-exit-1 B-quit-1 lfromt ltot
     3152         WITH FRAME Dialog-Frame.
     3153     VIEW FRAME Dialog-Frame.
     3154   END PROCEDURE.
     3155   PROCEDURE fill-tables :
     3156   define variable f-chr as character no-undo .
     3157   define variable t-chr as character no-undo .
     3158   DEFINE BUFFER buf_tt0-term_dis-time-rule FOR tt0-term_dis-time-rule.
     3159   DEFINE BUFFER buf_dis-time-rule FOR ub.dis-time-rule.
     3160   IF p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U THEN RETURN.
     3161   FOR EACH buf_tt0-term_dis-time-rule:
     3162       DELETE buf_tt0-term_dis-time-rule.
     3163   END.
     3164   if (lookup("time-from":U, vt-tree) = 0
     3165   AND lookup("time-period":U, vt-tree) = 0) then do:
     3166     assign
     3167     f-chr = string(tt-dis-time-rule.time-from, "HH:MM:SS")
     3168     fhour = integer(substring(f-chr, 1, 2))
     3169     fmin  = integer(substring(f-chr, 4, 2))
     3170     fsec  = integer(substring(f-chr, 7, 2))
     3171     .
     3172   end.
     3173   if (lookup("time-to":U, vt-tree) = 0
     3174             AND lookup("time-period":U, vt-tree) = 0) then do:
     3175     assign
     3176     t-chr = string(tt-dis-time-rule.time-to, "HH:MM:SS")
     3177     thour = integer(substring(t-chr, 1, 2))
     3178     tmin  = integer(substring(t-chr, 4, 2))
     3179     tsec  = integer(substring(t-chr, 7, 2))
     3180     .
     3181   end.
     3182   IF lookup("week-day-0", vt-level-1) > 0
     3183   OR lookup("week-day-1", vt-level-1) > 0
     3184   OR lookup("week-day-2", vt-level-1) > 0
     3185   OR lookup("week-day-3", vt-level-1) > 0
     3186   OR lookup("week-day-4", vt-level-1) > 0
     3187   OR lookup("week-day-5", vt-level-1) > 0
     3188   OR lookup("week-day-6", vt-level-1) > 0
     3189   OR lookup("week-day-7", vt-level-1) > 0
     3190   AND lookup("week-day-c":U, vt-tree) = 0
     3191   AND lookup("week-day-a":U, vt-tree) = 0
     3192   AND lookup("week-day-b":U, vt-tree) = 0
     3193   AND lookup("week-day-c":U, vt-other, ";") = 0 THEN DO:
     3194     if tt-dis-time-rule.week-day-0 then
     3195     RS-week-day = 0.
     3196     if tt-dis-time-rule.week-day-1 then
     3197     RS-week-day = 1.
     3198     if tt-dis-time-rule.week-day-2 then
     3199     RS-week-day = 2.
     3200     if tt-dis-time-rule.week-day-3 then
     3201     RS-week-day = 3.
     3202     if tt-dis-time-rule.week-day-4 then
     3203     RS-week-day = 4.
     3204     if tt-dis-time-rule.week-day-5 then
     3205     RS-week-day = 5.
     3206     if tt-dis-time-rule.week-day-6 then
     3207     RS-week-day = 6.
     3208     if tt-dis-time-rule.week-day-7 then
     3209     RS-week-day = 7.
     3210   end.
     3211   FOR EACH buf_dis-time-rule NO-LOCK WHERE
     3212           buf_dis-time-rule.upper-time-rule-num = tt-dis-time-rule.time-rule-num:
     3213     CREATE buf_tt0-term_dis-time-rule.
     3214     BUFFER-COPY buf_dis-time-rule
     3215     TO buf_tt0-term_dis-time-rule
     3216     ASSIGN
     3217     buf_tt0-term_dis-time-rule.time-from = (IF lookup("time-from":U, vt-level-2) = 0
     3218                                             AND lookup("time-period":U, vt-level-2) = 0
     3219                                       THEN 0
     3220                                       ELSE buf_dis-time-rule.time-from)
     3221     buf_tt0-term_dis-time-rule.time-to = (IF lookup("time-to":U, vt-level-2) = 0
     3222                                                 AND lookup("time-period":U, vt-level-2) = 0
     3223                                           THEN 0
     3224                                           ELSE buf_dis-time-rule.time-to)
     3225     buf_tt0-term_dis-time-rule.date-from = (IF lookup("date-from":U, vt-level-2) = 0
     3226                                             AND lookup("date-period":U, vt-level-2) = 0
     3227                                       THEN 01/01/1990
     3228                                       ELSE buf_dis-time-rule.date-from)
     3229     buf_tt0-term_dis-time-rule.date-to = (IF lookup("date-to":U, vt-level-2) = 0
     3230                                                 AND lookup("date-period":U, vt-level-2) = 0
     3231                                           THEN 01/01/1990
     3232                                           ELSE buf_dis-time-rule.date-to)
     3233     buf_tt0-term_dis-time-rule.month-day = (IF lookup("month-day":U, vt-level-2) = 0
     3234                                              THEN 0
     3235                                      ELSE buf_dis-time-rule.month-day)
     3236     buf_tt0-term_dis-time-rule.week-day-0 = (IF lookup("week-day-0":U, vt-level-2) = 0
     3237                                             AND lookup("week-day-a":U, vt-level-2) = 0
     3238                                       THEN FALSE
     3239                                       ELSE buf_dis-time-rule.week-day-0)
     3240     buf_tt0-term_dis-time-rule.week-day-1 = (IF lookup("week-day-0":U, vt-level-2) = 0
     3241                                             AND lookup("week-day-a":U, vt-level-2) = 0
     3242                                             AND lookup("week-day-b":U, vt-level-2) = 0
     3243                                             AND lookup("week-day-c":U, vt-level-2) = 0
     3244                                       THEN FALSE
     3245                                       ELSE buf_dis-time-rule.week-day-1)
     3246     buf_tt0-term_dis-time-rule.week-day-2 = (IF lookup("week-day-0":U, vt-level-2) = 0
     3247                                             AND lookup("week-day-a":U, vt-level-2) = 0
     3248                                             AND lookup("week-day-b":U, vt-level-2) = 0
     3249                                             AND lookup("week-day-c":U, vt-level-2) = 0
     3250                                       THEN FALSE
     3251                                       ELSE buf_dis-time-rule.week-day-2)
     3252     buf_tt0-term_dis-time-rule.week-day-3 = (IF lookup("week-day-0":U, vt-level-2) = 0
     3253                                               AND lookup("week-day-a":U, vt-level-2) = 0
     3254                                               AND lookup("week-day-b":U, vt-level-2) = 0
     3255                                               AND lookup("week-day-c":U, vt-level-2) = 0
     3256                                         THEN FALSE
     3257                                         ELSE buf_dis-time-rule.week-day-3)
     3258     buf_tt0-term_dis-time-rule.week-day-4 = (IF lookup("week-day-0":U, vt-level-2) = 0
     3259                                               AND lookup("week-day-a":U, vt-level-2) = 0
     3260                                               AND lookup("week-day-b":U, vt-level-2) = 0
     3261                                               AND lookup("week-day-c":U, vt-level-2) = 0
     3262                                         THEN FALSE
     3263                                         ELSE buf_dis-time-rule.week-day-4)
     3264     buf_tt0-term_dis-time-rule.week-day-5 = (IF lookup("week-day-0":U, vt-level-2) = 0
     3265                                               AND lookup("week-day-a":U, vt-level-2) = 0
     3266                                               AND lookup("week-day-b":U, vt-level-2) = 0
     3267                                               AND lookup("week-day-c":U, vt-level-2) = 0
     3268                                         THEN FALSE
     3269                                         ELSE buf_dis-time-rule.week-day-5)
     3270     buf_tt0-term_dis-time-rule.week-day-6 = (IF lookup("week-day-0":U, vt-level-2) = 0
     3271                                               AND lookup("week-day-a":U, vt-level-2) = 0
     3272                                               AND lookup("week-day-b":U, vt-level-2) = 0
     3273                                               AND lookup("week-day-c":U, vt-level-2) = 0
     3274                                         THEN FALSE
     3275                                         ELSE buf_dis-time-rule.week-day-6)
     3276     buf_tt0-term_dis-time-rule.week-day-7 = (IF lookup("week-day-0":U, vt-level-2) = 0
     3277                                               AND lookup("week-day-a":U, vt-level-2) = 0
     3278                                               AND lookup("week-day-b":U, vt-level-2) = 0
     3279                                               AND lookup("week-day-c":U, vt-level-2) = 0
     3280                                         THEN FALSE
     3281                                         ELSE buf_dis-time-rule.week-day-7)
     3282     .
     3283   END.
     3284   END PROCEDURE.
     3285   PROCEDURE MyEnable :
     3286   define variable ii AS INTEGER NO-UNDO.
     3287   ASSIGN
     3288   v-tab-order = "des,b-add,b-del,date-from,date-to,fhour,fmin,fsec,thour,tmin,tsec,month-day" +
     3289                 "week-day-1,week-day-2,week-day-3,week-day-4,week-day-5,week-day-6,week-day-7,RS-week-day," +
     3290                 "b-exit-1,b-quit-1"
     3291   FRAME Dialog-Frame:TITLE = substitute("&1 &2 &3"
     3292                                         , (if p-mode = 'ƒŒ¡¿¬À≈Õ»≈':U then '' else string(p-time-rule-num))
     3293                                         , FRAME Dialog-Frame:TITLE
     3294                                         , vt-des
     3295                                         )
     3296   .
     3297   IF LOOKUP("week-day-b", vt-tree) > 0
     3298   OR LOOKUP("week-day-b", vt-other, ";") > 0 THEN DO:
     3299     define variable kkk as character no-undo .
     3300     kkk = rs-week-day:RADIO-BUTTONS.
     3301     kkk = substring(kkk, 1, R-INDEX(kkk, chr(44)) - 1).
     3302     kkk = substring(kkk, 1, R-INDEX(kkk, chr(44)) - 1).
     3303     ASSIGN
     3304     rs-week-day:RADIO-BUTTONS = kkk
     3305     .
     3306   END.
     3307   RUN display-hide-fields IN THIS-PROCEDURE ( vt-tree, vt-other, YES , 1 ).
     3308   IF vt-tree = "":U THEN DO:
     3309     HIDE
     3310     br-term-dtr
     3311     b-exit-1
     3312     b-quit-1
     3313     b-add
     3314     b-del
     3315     in FRAME Dialog-Frame.
     3316   END.
     3317   ELSE DO:
     3318   DO ii = 1 TO NUM-ENTRIES(vt-tree):
     3319       ASSIGN
     3320       v-display-time-from:VISIBLE IN BROWSE br-term-dtr = no
     3321       v-display-time-to:VISIBLE IN BROWSE br-term-dtr = no
     3322       .
     3323       case ENTRY(ii, vt-tree):
     3324           WHEN "date-from":U THEN DO:
     3325               ASSIGN
     3326               tt0-term_dis-time-rule.date-from:VISIBLE IN BROWSE br-term-dtr = YES
     3327                .
     3328           END.
     3329           WHEN "date-to":U THEN DO:
     3330               ASSIGN
     3331               tt0-term_dis-time-rule.date-to:VISIBLE IN BROWSE br-term-dtr = YES
     3332               .
     3333           END.
     3334           WHEN "date-period":U THEN DO:
     3335               ASSIGN
     3336               tt0-term_dis-time-rule.date-from:VISIBLE IN BROWSE br-term-dtr = YES
     3337               tt0-term_dis-time-rule.date-to:VISIBLE IN BROWSE br-term-dtr = YES
     3338               .
     3339           END.
     3340           WHEN "time-from":U THEN DO:
     3341               ASSIGN
     3342               v-display-time-from:VISIBLE IN BROWSE br-term-dtr = YES
     3343                .
     3344           END.
     3345           WHEN "time-to":U THEN DO:
     3346               ASSIGN
     3347               v-display-time-to:VISIBLE IN BROWSE br-term-dtr = YES
     3348               .
     3349           END.
     3350           WHEN "time-period":U THEN DO:
     3351               ASSIGN
     3352               v-display-time-from:VISIBLE IN BROWSE br-term-dtr = YES
     3353               v-display-time-to:VISIBLE IN BROWSE br-term-dtr = YES
     3354               .
     3355           END.
     3356           WHEN "month-day":U THEN DO:
     3357               ASSIGN
     3358               tt0-term_dis-time-rule.month-day:VISIBLE IN BROWSE br-term-dtr = YES
     3359               .
     3360           END.
     3361           WHEN "week-day-0" THEN DO:
     3362               ASSIGN
     3363               tt0-term_dis-time-rule.week-day-0:VISIBLE IN BROWSE br-term-dtr = YES
     3364               .
     3365          END.
     3366           WHEN "week-day-a" THEN DO:
     3367             ASSIGN
     3368             tt0-term_dis-time-rule.week-day-0:VISIBLE IN BROWSE br-term-dtr = YES
     3369             tt0-term_dis-time-rule.week-day-1:VISIBLE IN BROWSE br-term-dtr = YES
     3370             tt0-term_dis-time-rule.week-day-2:VISIBLE IN BROWSE br-term-dtr = YES
     3371             tt0-term_dis-time-rule.week-day-3:VISIBLE IN BROWSE br-term-dtr = YES
     3372             tt0-term_dis-time-rule.week-day-4:VISIBLE IN BROWSE br-term-dtr = YES
     3373             tt0-term_dis-time-rule.week-day-5:VISIBLE IN BROWSE br-term-dtr = YES
     3374             tt0-term_dis-time-rule.week-day-6:VISIBLE IN BROWSE br-term-dtr = YES
     3375             tt0-term_dis-time-rule.week-day-7:VISIBLE IN BROWSE br-term-dtr = YES
     3376             .
     3377           END.
     3378           WHEN "week-day-b" THEN DO:
     3379             ASSIGN
     3380             tt0-term_dis-time-rule.week-day-1:VISIBLE IN BROWSE br-term-dtr = YES
     3381             tt0-term_dis-time-rule.week-day-2:VISIBLE IN BROWSE br-term-dtr = YES
     3382             tt0-term_dis-time-rule.week-day-3:VISIBLE IN BROWSE br-term-dtr = YES
     3383             tt0-term_dis-time-rule.week-day-4:VISIBLE IN BROWSE br-term-dtr = YES
     3384             tt0-term_dis-time-rule.week-day-5:VISIBLE IN BROWSE br-term-dtr = YES
     3385             tt0-term_dis-time-rule.week-day-6:VISIBLE IN BROWSE br-term-dtr = YES
     3386             tt0-term_dis-time-rule.week-day-7:VISIBLE IN BROWSE br-term-dtr = YES
     3387             .
     3388           END.
     3389           WHEN "week-day-1"  THEN DO:
     3390               ASSIGN
     3391               tt0-term_dis-time-rule.week-day-1:VISIBLE IN BROWSE br-term-dtr = YES
     3392               .
     3393           END.
     3394           WHEN "week-day-2"  THEN DO:
     3395           ASSIGN
     3396           tt0-term_dis-time-rule.week-day-2:VISIBLE IN BROWSE br-term-dtr = YES
     3397           .
     3398      END.
     3399       WHEN "week-day-3" THEN DO:
     3400           ASSIGN
     3401           tt0-term_dis-time-rule.week-day-3:VISIBLE IN BROWSE br-term-dtr = YES
     3402           .
     3403      END.
     3404           WHEN "week-day-4"  THEN DO:
     3405               ASSIGN
     3406               tt0-term_dis-time-rule.week-day-4:VISIBLE IN BROWSE br-term-dtr = YES
     3407               .
     3408          END.
     3409           WHEN "week-day-5" THEN DO:
     3410               ASSIGN
     3411               tt0-term_dis-time-rule.week-day-5:VISIBLE IN BROWSE br-term-dtr = YES
     3412               .
     3413          END.
     3414           WHEN "week-day-6"  THEN DO:
     3415               ASSIGN
     3416               tt0-term_dis-time-rule.week-day-6:VISIBLE IN BROWSE br-term-dtr = YES
     3417               .
     3418          END.
     3419           WHEN "week-day-7"  THEN DO:
     3420               ASSIGN
     3421               tt0-term_dis-time-rule.week-day-7:VISIBLE IN BROWSE br-term-dtr = YES
     3422               .
     3423          END.
     3424        END CASE.
     3425       END.
     3426       ENABLE
     3427       b-add WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
     3428       b-DEL WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
     3429       WITH FRAME Dialog-Frame.
     3430   END.
     3431   IF AVAILABLE tt-dis-time-rule THEN
     3432   DISPLAY
     3433   tt-dis-time-rule.des
     3434   WITH FRAME Dialog-Frame.
     3435   IF (LOOKUP("week-day-a":U, vt-other) > 0 and LOOKUP("week-day-b":U, vt-other) > 0) THEN HIDE
     3436   rs-week-day  IN FRAME Dialog-Frame.
     3437   ENABLE
     3438   b-quit
     3439   B-exit WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
     3440   b-hist when p-mode <> 'ƒŒ¡¿¬À≈Õ»≈':U
     3441   B-Help
     3442   tt-dis-time-rule.des WHEN p-mode <> 'œ–Œ—ÃŒ“–':U
     3443   WITH FRAME Dialog-Frame.
     3444   if p-mode <> 'œ–Œ—ÃŒ“–':U then do:
     3445   end.
     3446   VIEW FRAME Dialog-Frame.
     3447   IF p-mode = 'œ–Œ—ÃŒ“–':U THEN DO:
     3448       HIDE
     3449       b-exit
     3450       IN FRAME Dialog-Frame.
     3451       ASSIGN
     3452       b-quit:LABEL = "&¬˚ıÓ‰"
     3453       .
     3454   END.
     3455   IF vt-tree <> "":u THEN DO:
     3456     ENABLE
     3457     br-term-dtr
     3458     WITH FRAME Dialog-Frame.
     3459     RUN openbr-term-dtr.
     3460     IF p-mode = 'œ–Œ—ÃŒ“–':U THEN APPLY "ENTRY" TO b-exit.
     3461     ELSE APPLY "entry" to b-add.
     3462   END.
     3463   ELSE DO:
     3464   END.
     3465   END PROCEDURE.
     3466   PROCEDURE openbr-term-dtr :
     3467   OPEN QUERY BR-term-dtr
     3468     FOR  EACH tt0-term_dis-time-rule WHERE
     3469              tt0-term_dis-time-rule.upper-time-rule-num = tt-dis-time-rule.time-rule-num
     3470   BY tt0-term_dis-time-rule.date-from
     3471   BY tt0-term_dis-time-rule.date-to
     3472   BY tt0-term_dis-time-rule.time-from
     3473   BY tt0-term_dis-time-rule.time-to
     3474   BY tt0-term_dis-time-rule.week-day-0
     3475   BY tt0-term_dis-time-rule.week-day-1
     3476   BY tt0-term_dis-time-rule.week-day-2
     3477   BY tt0-term_dis-time-rule.week-day-3
     3478   BY tt0-term_dis-time-rule.week-day-4
     3479   BY tt0-term_dis-time-rule.week-day-5
     3480   BY tt0-term_dis-time-rule.week-day-6
     3481   BY tt0-term_dis-time-rule.week-day-7
     3482   BY tt0-term_dis-time-rule.month-day
     3483    .
     3484   END PROCEDURE.
     3485   PROCEDURE proc-b-add :
     3486   IF vt-tree = "":U THEN RETURN ERROR.
     3487   RUN display-hide-fields IN THIS-PROCEDURE ( vt-tree, vt-other, NO , 1 ).
     3488   IF lookup("date-from", vt-level-2) > 0
     3489   AND tt-dis-time-rule.date-from:sensitive  IN FRAME Dialog-Frame THEN DO:
     3490      DISPLAY
     3491      today @ tt-dis-time-rule.date-from
     3492      WITH FRAME Dialog-Frame.
     3493   END.
     3494   IF lookup("date-to", vt-level-2) > 0
     3495   AND tt-dis-time-rule.date-to:sensitive  IN FRAME Dialog-Frame THEN DO:
     3496      DISPLAY
     3497      today @ tt-dis-time-rule.date-to
     3498      WITH FRAME Dialog-Frame.
     3499   END.
     3500   IF lookup("time-from", vt-level-2) > 0
     3501   AND fhour:sensitive  IN FRAME Dialog-Frame THEN DO:
     3502      DISPLAY
     3503      0 @ fhour
     3504      0 @ fmin
     3505      0 @ fsec
     3506      WITH FRAME Dialog-Frame.
     3507   END.
     3508   IF lookup("time-to", vt-level-2) > 0
     3509   AND fhour:sensitive  IN FRAME Dialog-Frame THEN DO:
     3510      DISPLAY
     3511      0 @ thour
     3512      0 @ tmin
     3513      0 @ tsec
     3514      WITH FRAME Dialog-Frame.
     3515   END.
     3516   IF lookup("month-day", vt-level-2) > 0
     3517   AND tt-dis-time-rule.month-day:sensitive  IN FRAME Dialog-Frame THEN DO:
     3518      DISPLAY
     3519      1 @ tt-dis-time-rule.month-day
     3520      WITH FRAME Dialog-Frame.
     3521   END.
     3522   IF lookup("week-day-1", vt-level-2) > 0
     3523   AND tt-dis-time-rule.week-day-1:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     3524     ASSIGN
     3525     tt-dis-time-rule.week-day-1:SCREEN-VALUE IN FRAME Dialog-Frame = "no".
     3526     DISPLAY
     3527     tt-dis-time-rule.week-day-1
     3528     WITH FRAME Dialog-Frame.
     3529   END.
     3530   IF lookup("week-day-2", vt-level-2) > 0
     3531   AND tt-dis-time-rule.week-day-2:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     3532     ASSIGN
     3533     tt-dis-time-rule.week-day-2:SCREEN-VALUE IN FRAME Dialog-Frame = "no".
     3534     DISPLAY
     3535     tt-dis-time-rule.week-day-2
     3536     WITH FRAME Dialog-Frame.
     3537   END.
     3538   IF lookup("week-day-3", vt-level-2) > 0
     3539   AND tt-dis-time-rule.week-day-3:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     3540     ASSIGN
     3541     tt-dis-time-rule.week-day-3:SCREEN-VALUE IN FRAME Dialog-Frame = "no".
     3542     DISPLAY
     3543     tt-dis-time-rule.week-day-3
     3544     WITH FRAME Dialog-Frame.
     3545   END.
     3546   IF lookup("week-day-4", vt-level-2) > 0
     3547   AND tt-dis-time-rule.week-day-4:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     3548     ASSIGN
     3549     tt-dis-time-rule.week-day-4:SCREEN-VALUE IN FRAME Dialog-Frame = "no".
     3550     DISPLAY
     3551     tt-dis-time-rule.week-day-4
     3552     WITH FRAME Dialog-Frame.
     3553   END.
     3554   IF lookup("week-day-5", vt-level-2) > 0
     3555   AND tt-dis-time-rule.week-day-5:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     3556     ASSIGN
     3557     tt-dis-time-rule.week-day-5:SCREEN-VALUE IN FRAME Dialog-Frame = "no".
     3558     DISPLAY
     3559     tt-dis-time-rule.week-day-5
     3560     WITH FRAME Dialog-Frame.
     3561   END.
     3562   IF lookup("week-day-6", vt-level-2) > 0
     3563   AND tt-dis-time-rule.week-day-6:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     3564     ASSIGN
     3565     tt-dis-time-rule.week-day-6:SCREEN-VALUE IN FRAME Dialog-Frame = "no".
     3566     DISPLAY
     3567     tt-dis-time-rule.week-day-6
     3568     WITH FRAME Dialog-Frame.
     3569   END.
     3570   IF lookup("week-day-7", vt-level-2) > 0
     3571   AND tt-dis-time-rule.week-day-7:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     3572     ASSIGN
     3573     tt-dis-time-rule.week-day-7:SCREEN-VALUE IN FRAME Dialog-Frame = "no".
     3574     DISPLAY
     3575     tt-dis-time-rule.week-day-7
     3576     WITH FRAME Dialog-Frame.
     3577   END.
     3578   IF (lookup("week-day-0", vt-level-2) > 0
     3579   or lookup("week-day-1", vt-level-2) > 0
     3580   or lookup("week-day-2", vt-level-2) > 0
     3581   or lookup("week-day-3", vt-level-2) > 0
     3582   or lookup("week-day-4", vt-level-2) > 0
     3583   or lookup("week-day-5", vt-level-2) > 0
     3584   or lookup("week-day-6", vt-level-2) > 0
     3585   or lookup("week-day-7", vt-level-2) > 0
     3586   ) AND RS-week-day:SENSITIVE IN FRAME Dialog-Frame THEN DO:
     3587       ASSIGN
     3588       RS-Week-day = 1.
     3589       DISPLAY Rs-week-day
     3590       WITH FRAME Dialog-Frame.
     3591   END.
     3592   ENABLE
     3593   b-exit-1
     3594   b-quit-1
     3595   WITH FRAME Dialog-Frame.
     3596   END PROCEDURE.
     3597   PROCEDURE proc-b-del :
     3598   DEFINE BUFFER buf_tt0-term_dis-time-rule FOR tt0-term_dis-time-rule.
     3599   IF vt-tree = "":U THEN RETURN ERROR.
     3600   IF NOT AVAILABLE tt0-term_dis-time-rule THEN RETURN.
     3601   FIND first buf_tt0-term_dis-time-rule WHERE RECID(buf_tt0-term_dis-time-rule) = RECID(tt0-term_dis-time-rule).
     3602   DELETE buf_tt0-term_dis-time-rule.
     3603   RUN rename-term_dis-time-rule.
     3604   RUN openbr-term-dtr.
     3605   END PROCEDURE.
     3606   PROCEDURE proc-b-exit-1 :
     3607   DEFINE VARIABLE v-time-from LIKE ub.dis-time-rule.time-from NO-UNDO.
     3608   DEFINE VARIABLE v-time-to  LIKE ub.dis-time-rule.time-to NO-UNDO.
     3609   DEFINE VARIABLE v-date-from LIKE ub.dis-time-rule.date-from NO-UNDO.
     3610   DEFINE VARIABLE v-date-to  LIKE ub.dis-time-rule.date-to NO-UNDO.
     3611   DEFINE VARIABLE v-month-day  LIKE ub.dis-time-rule.month-day NO-UNDO.
     3612   DEFINE VARIABLE v-week-day-0  LIKE ub.dis-time-rule.week-day-0 NO-UNDO.
     3613   DEFINE VARIABLE v-week-day-1  LIKE ub.dis-time-rule.week-day-1 NO-UNDO.
     3614   DEFINE VARIABLE v-week-day-2  LIKE ub.dis-time-rule.week-day-2 NO-UNDO.
     3615   DEFINE VARIABLE v-week-day-3  LIKE ub.dis-time-rule.week-day-3 NO-UNDO.
     3616   DEFINE VARIABLE v-week-day-4  LIKE ub.dis-time-rule.week-day-4 NO-UNDO.
     3617   DEFINE VARIABLE v-week-day-5  LIKE ub.dis-time-rule.week-day-5 NO-UNDO.
     3618   DEFINE VARIABLE v-week-day-6  LIKE ub.dis-time-rule.week-day-6 NO-UNDO.
     3619   DEFINE VARIABLE v-week-day-7  LIKE ub.dis-time-rule.week-day-7 NO-UNDO.
     3620   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     3621   DEFINE VARIABLE v-time-rule-num LIKE ub.dis-time-rule.time-rule-num NO-UNDO.
     3622   DEFINE VARIABLE v-dub AS LOGICAL NO-UNDO.
     3623   DEFINE BUFFER buf_tt0-term_dis-time-rule FOR tt0-term_dis-time-rule.
     3624   IF vt-tree = "":U  THEN RETURN ERROR.
