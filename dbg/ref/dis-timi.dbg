     1044   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1045   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1046   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1047   on help of frame Dialog-Frame
     1048   do:
     1049     run gbl/app_help.p
     1050       (input this-procedure :file-name
     1051       ,input ''
     1052       ,input ?
     1053       ) no-error.
     1054     if error-status :error then do:
     1055       message
     1056         "Œ¯Ë·Í‡ ÔË ‚˚ÁÓ‚Â ÔÓÏÓ˘Ë"
     1057         error-status :get-message(1)
     1058         view-as alert-box .
     1059     end.
     1060   end.
     1061   run minbtn-set in this-procedure .
     1062   on choose of b-help in frame Dialog-Frame
     1063   do:
     1064     apply "help":u to frame Dialog-Frame .
     1065   end.
     1066   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1067   procedure minbtn-set :
     1068       do
     1069           on error undo, return error return-value
     1070           :
     1071           define variable ii              as integer       no-undo .
     1072           define variable fh              as widget-handle no-undo .
     1073           define variable hh              as widget-handle no-undo .
     1074           define variable v-h             as handle        extent 4 no-undo .
     1075           define variable v-name-button   as character     no-undo .
     1076           define variable v-help-old-x    as decimal       no-undo .
     1077           define variable v-help-old-y    as decimal       no-undo .
     1078           define variable v-help-old-size as decimal       no-undo .
     1079           define variable v-frame-width   as decimal       no-undo .
     1080           define variable jj              as integer       no-undo .
     1081           do
     1082               on error undo, return error
     1083               :
     1084               assign
     1085                   v-frame-width = frame Dialog-Frame:width - 0.3
     1086                   fh            = frame Dialog-Frame:first-child
     1087                   hh            = fh:first-child
     1088                   ii            = 1
     1089                   .
     1090               do while valid-handle(hh):
     1091                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1092                   do:
     1093                       case lc(hh:name) :
     1094                           when "b-help" then
     1095                               do:
     1096                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1097                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1098                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1099                                   hh:TOOLTIP = "œÓÏÓ˘¸" .
     1100                                   v-help-old-x = hh:column .
     1101                                   v-help-old-y = hh:row    .
     1102                                   v-help-old-size = hh:width .
     1103                                   hh:width-chars = 2.5 .
     1104                               end.
     1105                           when "b-print" then
     1106                               do:
     1107                                   hh:load-image("cmp/b-print.bmp":u) .
     1108                                   hh:TOOLTIP = "œÂ˜‡Ú¸" .
     1109                                   v-h[ii] = hh:handle .
     1110                                   ii = ii + 1 .
     1111                                   hh:width-chars = 3 .
     1112                               end.
     1113                           when "b-history" or
     1114                           when "b-hist" then
     1115                               do:
     1116                                   hh:load-image("cmp/b-hist.bmp":u) .
     1117                                   hh:TOOLTIP = "»ÒÚÓËˇ" .
     1118                                   v-h[ii] = hh:handle .
     1119                                   ii = ii + 1 .
     1120                                   hh:width-chars = 3 .
     1121                               end.
     1122                           when "b-sch" then
     1123                               do:
     1124                                   hh:load-image("cmp/b-sch.bmp":u) .
     1125                                   hh:TOOLTIP = "”ÒÚ‡ÌÓ‚Í‡ ‘ËÎ¸Ú‡" .
     1126                                   v-h[ii] = hh:handle .
     1127                                   ii = ii + 1 .
     1128                                   hh:width-chars = 3 .
     1129                               end.
     1130                           when "b-hist-user" then
     1131                               do:
     1132                                   hh:load-image("cmp/b-hist.bmp":u) .
     1133                                   hh:TOOLTIP = "»ÒÚÓËˇ ÔÓÎ¸ÁÓ‚‡ÚÂÎˇ" .
     1134                                   ii = ii + 1 .
     1135                               end.
     1136                       end case.
     1137                   end.
     1138                   hh = hh:next-sibling.
     1139               end.
     1140               b-help:column = v-frame-width - b-help:width-chars.
     1141               jj = 0.
     1142               repeat ii = 4 to 1 by -1 :
     1143                   if valid-handle (v-h[ii] ) then
     1144                   do:
     1145                       jj  = jj + 1 .
     1146                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1147                       v-h[ii]:row    = v-help-old-y .
     1148                   end.
     1149               end.
     1150           end.
     1151       end.
     1152   end procedure.
     1153   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ ¡Ë·ÎËÓÚÂÍ‡ ËÁÏÂÌÂÌËˇ ‡ÁÏÂÓ‚ ÓÍÌ‡".
     1154   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1155   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1156   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1157   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1158   define variable v-diasize-current-frame-height as decimal   no-undo .
     1159   define variable v-diasize-change-size          as logical   no-undo .
     1160   define variable v-diasize-resize-button        as handle    no-undo .
     1161   define variable v-diasize-wndmax               as logical   no-undo .
     1162   define variable v-diasize-wndstore             as logical   no-undo .
     1163   define variable v-diasize-proc-name            as character no-undo .
     1164   define variable v-diasize-browse-handle        as handle    no-undo .
     1165   define variable v-diasize-browse-number        as integer   no-undo .
     1166   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1167   define temp-table temp-diasize-handle no-undo
     1168     field handle-value  as handle
     1169     field save-position as decimal
     1170     index xpk is primary unique handle-value
     1171     .
     1172   define temp-table temp-browse-handle no-undo
     1173     field browse-type   as character
     1174     field browse-number as integer
     1175     field browse-handle as handle
     1176     field original-size as decimal
     1177     index xpk is primary unique browse-type browse-number
     1178     index xie browse-type browse-handle
     1179   .
     1180   procedure diasize_change-height :
     1181     define input  parameter p-change-value  as decimal   no-undo .
     1182     define input  parameter p-move-resize   as logical   no-undo .
     1183     define variable v-field-group-handle    as handle    no-undo .
     1184     define variable v-object-handle         as handle    no-undo .
     1185     define variable v-frame-height          as decimal   no-undo .
     1186     define variable v-frame-virtual-height  as decimal   no-undo .
     1187     define variable v-browse-height         as decimal   no-undo .
     1188     define variable v-window-height         as decimal   no-undo .
     1189     define variable v-window-virtual-height as decimal   no-undo .
     1190     define variable v-change-sign           as integer   no-undo .
     1191     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1192     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1193     if p-change-value > 0
     1194     then do:
     1195       if frame Dialog-Frame :height + p-change-value
     1196           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1197       then do:
     1198         assign
     1199           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1200                           - (frame Dialog-Frame :height-chars)
     1201         .
     1202         if p-change-value <= 0
     1203         then do:
     1204           run diasize_position-resize-button in this-procedure .
     1205           return .
     1206         end.
     1207       end.
     1208     end.
     1209     if p-change-value < 0
     1210     then do:
     1211       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1212       then do:
     1213         assign
     1214           p-change-value = v-diasize-orig-frame-height
     1215                          - (frame Dialog-Frame :height-chars)
     1216         .
     1217         if p-change-value >= 0
     1218         then do:
     1219           run diasize_position-resize-button in this-procedure .
     1220           return .
     1221         end.
     1222       end.
     1223     end.
     1224     if p-change-value >= 0
     1225     then do:
     1226       assign
     1227         v-change-sign = 1
     1228       .
     1229     end.
     1230     else do:
     1231       assign
     1232         v-change-sign = -1
     1233       .
     1234     end.
     1235     assign
     1236       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1237     .
     1238     if p-change-value = 0
     1239     then do:
     1240       run diasize_position-resize-button in this-procedure .
     1241       return .
     1242     end.
     1243     move_block:
     1244     do
     1245     on error undo move_block, retry move_block
     1246     :
     1247       if retry
     1248       then do:
     1249         do
     1250         on error undo move_block, leave move_block
     1251         :
     1252           if p-change-value > 0
     1253           then do:
     1254             for each buf_temp-diasize-handle
     1255             on error undo, next
     1256             :
     1257               assign
     1258                 v-object-handle = buf_temp-diasize-handle.handle-value
     1259               .
     1260               if v-object-handle <> v-diasize-resize-button
     1261               then do:
     1262                 assign
     1263                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1264                 .
     1265               end.
     1266             end.
     1267             assign
     1268               v-diasize-browse-handle :height = v-browse-height
     1269             .
     1270             for each buf_temp-browse-handle
     1271               where buf_temp-browse-handle.browse-type = 'height':u
     1272             on error undo, next
     1273             :
     1274               assign
     1275                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1276               .
     1277             end.
     1278             assign
     1279               frame Dialog-Frame :height = v-frame-height
     1280             .
     1281             if frame Dialog-Frame :scrollable = true
     1282             then do:
     1283               assign
     1284                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1285               .
     1286             end.
     1287             run diasize_position-resize-button in this-procedure .
     1288           end.
     1289           else do:
     1290             if frame Dialog-Frame :scrollable = true
     1291             then do:
     1292               assign
     1293                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1294               .
     1295             end.
     1296             assign
     1297               frame Dialog-Frame :height = v-frame-height
     1298             .
     1299             assign
     1300               v-diasize-browse-handle :height = v-browse-height
     1301             .
     1302             for each buf_temp-browse-handle
     1303               where buf_temp-browse-handle.browse-type = 'height':u
     1304             on error undo, next
     1305             :
     1306               assign
     1307                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1308               .
     1309             end.
     1310             for each buf_temp-diasize-handle
     1311             on error undo, next
     1312             :
     1313               assign
     1314                 v-object-handle = buf_temp-diasize-handle.handle-value
     1315               .
     1316               if v-object-handle <> v-diasize-resize-button
     1317               then do:
     1318                 assign
     1319                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1320                 .
     1321               end.
     1322             end.
     1323             run diasize_position-resize-button in this-procedure .
     1324           end.
     1325           assign
     1326             v-diasize-change-size = false
     1327           .
     1328           leave move_block .
     1329         end.
     1330       end.
     1331       assign
     1332         v-diasize-need-full-display = true
     1333       .
     1334       if v-diasize-change-size = false
     1335       then do:
     1336         assign
     1337           v-diasize-change-size = true
     1338         .
     1339       end.
     1340       else do:
     1341         return .
     1342       end.
     1343       assign
     1344         v-frame-height = frame Dialog-Frame :height
     1345         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1346         v-browse-height = v-diasize-browse-handle :height
     1347       .
     1348       for each buf_temp-browse-handle
     1349         where buf_temp-browse-handle.browse-type = 'height':u
     1350       :
     1351         assign
     1352           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1353         .
     1354       end.
     1355       for each buf_temp-diasize-handle
     1356       :
     1357         delete buf_temp-diasize-handle .
     1358       end.
     1359       assign
     1360         v-field-group-handle = frame Dialog-Frame :first-child
     1361       .
     1362       do while valid-handle(v-field-group-handle)
     1363       :
     1364         assign
     1365           v-object-handle = v-field-group-handle :first-child
     1366         .
     1367         do while valid-handle(v-object-handle)
     1368         :
     1369           if  v-object-handle <> v-diasize-browse-handle :handle
     1370           and can-query(v-object-handle, "row")
     1371           and can-query(v-object-handle, "height")
     1372           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1373           then do:
     1374             find first buf_temp-browse-handle
     1375               where buf_temp-browse-handle.browse-type   = 'height':u
     1376                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1377               no-error .
     1378             if available buf_temp-browse-handle
     1379             then do:
     1380             end.
     1381             else do:
     1382               create buf_temp-diasize-handle .
     1383               assign
     1384                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1385                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1386               .
     1387             end.
     1388           end.
     1389           assign
     1390             v-object-handle = v-object-handle :next-sibling
     1391           .
     1392         end.
     1393         assign
     1394           v-field-group-handle = v-field-group-handle :next-sibling
     1395         .
     1396       end.
     1397       do with frame Dialog-Frame
     1398       :
     1399         hide v-diasize-resize-button .
     1400         assign
     1401           v-diasize-resize-button :row    = 1
     1402           v-diasize-resize-button :column = 1
     1403         .
     1404       end.
     1405       if p-change-value > 0
     1406       then do:
     1407         if frame Dialog-Frame :scrollable = true
     1408         then do:
     1409           assign
     1410             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1411             no-error .
     1412           if error-status :error
     1413           or error-status :get-message(1) <> ""
     1414           then do:
     1415             undo move_block, retry move_block .
     1416           end.
     1417         end.
     1418         assign
     1419           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1420           no-error .
     1421         if error-status :error
     1422         or error-status :get-message(1) <> ""
     1423         then do:
     1424           undo move_block, retry move_block .
     1425         end.
     1426         assign
     1427           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1428           no-error .
     1429         if error-status :error
     1430         or error-status :get-message(1) <> ""
     1431         then do:
     1432           undo move_block, retry move_block .
     1433         end.
     1434         for each buf_temp-browse-handle
     1435           where buf_temp-browse-handle.browse-type = 'height':u
     1436         on error undo move_block, retry move_block
     1437         :
     1438           assign
     1439             buf_temp-browse-handle.browse-handle :height
     1440               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1441             no-error .
     1442           if error-status :error
     1443           or error-status :get-message(1) <> ""
     1444           then do:
     1445             undo move_block, retry move_block .
     1446           end.
     1447         end.
     1448         for each buf_temp-diasize-handle
     1449         on error undo move_block, retry move_block
     1450         :
     1451           assign
     1452             v-object-handle = buf_temp-diasize-handle.handle-value
     1453           .
     1454           if v-object-handle <> v-diasize-resize-button
     1455           then do:
     1456             assign
     1457               v-object-handle :row = v-object-handle :row + p-change-value
     1458               no-error .
     1459             if error-status :error
     1460             or error-status :get-message(1) <> ""
     1461             then do:
     1462               undo move_block, retry move_block .
     1463             end.
     1464           end.
     1465         end.
     1466       end.
     1467       else do:
     1468         for each buf_temp-diasize-handle
     1469         on error undo move_block, retry move_block
     1470         :
     1471           assign
     1472             v-object-handle = buf_temp-diasize-handle.handle-value
     1473           .
     1474           if v-object-handle <> v-diasize-resize-button
     1475           then do:
     1476             assign
     1477               v-object-handle :row = v-object-handle :row + p-change-value
     1478               no-error .
     1479             if error-status :error
     1480             or error-status :get-message(1) <> ""
     1481             then do:
     1482               undo move_block, retry move_block .
     1483             end.
     1484           end.
     1485         end.
     1486         assign
     1487           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1488           no-error .
     1489         if error-status :error
     1490         or error-status :get-message(1) <> ""
     1491         then do:
     1492           undo move_block, retry move_block .
     1493         end.
     1494         for each buf_temp-browse-handle
     1495           where buf_temp-browse-handle.browse-type = 'height':u
     1496         on error undo move_block, retry move_block
     1497         :
     1498           assign
     1499             buf_temp-browse-handle.browse-handle :height
     1500               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1501             no-error .
     1502           if error-status :error
     1503           or error-status :get-message(1) <> ""
     1504           then do:
     1505             undo move_block, retry move_block .
     1506           end.
     1507         end.
     1508         assign
     1509           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1510           no-error .
     1511         if error-status :error
     1512         or error-status :get-message(1) <> ""
     1513         then do:
     1514           undo move_block, retry move_block .
     1515         end.
     1516         if frame Dialog-Frame :scrollable = true
     1517         then do:
     1518           assign
     1519             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1520             no-error .
     1521           if error-status :error
     1522           or error-status :get-message(1) <> ""
     1523           then do:
     1524             undo move_block, retry move_block .
     1525           end.
     1526         end.
     1527       end.
     1528       if p-move-resize = true
     1529       then do:
     1530         run diasize_position-resize-button in this-procedure .
     1531       end.
     1532       if v-diasize-wndstore = true
     1533       then do:
     1534         if connected("ub") = true
     1535         then do:
     1536           define variable v-cntxt-db-num        as integer   no-undo .
     1537           define variable v-cntxt-userid        as character no-undo .
     1538           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1539                                             , OUTPUT v-cntxt-userid
     1540                                             ) .
     1541           run gbl/wndsizew.p
     1542             (input  v-cntxt-db-num
     1543             ,input  v-cntxt-userid
     1544             ,input  v-diasize-proc-name
     1545             ,input  'height':u
     1546             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1547             ) .
     1548         end.
     1549       end.
     1550     end.
     1551     assign
     1552       v-diasize-change-size = false
     1553     .
     1554   end procedure.
     1555   procedure diasize_set-height :
     1556     define input  parameter p-new-height  as decimal   no-undo .
     1557     define input  parameter p-move-resize as logical   no-undo .
     1558     do
     1559     on error undo, return error return-value
     1560     :
     1561       run diasize_change-height in this-procedure
     1562         (input  (p-new-height - frame Dialog-Frame :height)
     1563         ,input  p-move-resize
     1564         ) .
     1565     end.
     1566   end procedure.
     1567   procedure diasize_change-width :
     1568     define input  parameter p-change-value as decimal   no-undo .
     1569     define input  parameter p-move-resize  as logical   no-undo .
     1570     define variable v-field-group-handle   as handle    no-undo .
     1571     define variable v-object-handle        as handle    no-undo .
     1572     define variable v-frame-width          as decimal   no-undo .
     1573     define variable v-frame-virtual-width  as decimal   no-undo .
     1574     define variable v-browse-width         as decimal   no-undo .
     1575     define variable v-window-width         as decimal   no-undo .
     1576     define variable v-window-virtual-width as decimal   no-undo .
     1577     define variable v-change-sign          as integer   no-undo .
     1578     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1579     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1580     if p-change-value > 0
     1581     then do:
     1582       if frame Dialog-Frame :width + p-change-value >
     1583           session :width-chars
     1584       then do:
     1585         assign
     1586           p-change-value = session :width-chars - frame Dialog-Frame :width
     1587         .
     1588         if p-change-value <= 0
     1589         then do:
     1590           run diasize_position-resize-button in this-procedure .
     1591           return .
     1592         end.
     1593       end.
     1594     end.
     1595     if p-change-value < 0
     1596     then do:
     1597       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1598       then do:
     1599         assign
     1600           p-change-value = v-diasize-orig-frame-width
     1601                          - frame Dialog-Frame :width
     1602         .
     1603         if p-change-value >= 0
     1604         then do:
     1605           run diasize_position-resize-button in this-procedure .
     1606           return .
     1607         end.
     1608       end.
     1609     end.
     1610     if p-change-value >= 0
     1611     then do:
     1612       assign
     1613         v-change-sign = 1
     1614       .
     1615     end.
     1616     else do:
     1617       assign
     1618         v-change-sign = -1
     1619       .
     1620     end.
     1621     assign
     1622       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1623     .
     1624     if p-change-value = 0
     1625     then do:
     1626       run diasize_position-resize-button in this-procedure .
     1627       return .
     1628     end.
     1629     move_block:
     1630     do
     1631     on error undo move_block, leave move_block
     1632     :
     1633       if retry
     1634       then do:
     1635         do
     1636         on error undo move_block, leave move_block
     1637         :
     1638           if p-change-value > 0
     1639           then do:
     1640             for each buf_temp-diasize-handle
     1641             on error undo, next
     1642             :
     1643               assign
     1644                 v-object-handle = buf_temp-diasize-handle.handle-value
     1645               .
     1646               if v-object-handle <> v-diasize-resize-button
     1647               then do:
     1648                 assign
     1649                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1650                 .
     1651               end.
     1652             end.
     1653             assign
     1654               v-diasize-browse-handle :width = v-browse-width
     1655             .
     1656             for each buf_temp-browse-handle
     1657               where buf_temp-browse-handle.browse-type = 'width':u
     1658             on error undo, next
     1659             :
     1660               assign
     1661                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1662               .
     1663             end.
     1664             assign
     1665               frame Dialog-Frame :width = v-frame-width
     1666             .
     1667             if frame Dialog-Frame :scrollable = true
     1668             then do:
     1669               assign
     1670                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1671               .
     1672             end.
     1673             run diasize_position-resize-button in this-procedure .
     1674           end.
     1675           else do:
     1676             if frame Dialog-Frame :scrollable = true
     1677             then do:
     1678               assign
     1679                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1680               .
     1681             end.
     1682             assign
     1683               frame Dialog-Frame :width = v-frame-width
     1684             .
     1685             for each buf_temp-browse-handle
     1686               where buf_temp-browse-handle.browse-type = 'width':u
     1687             on error undo, next
     1688             :
     1689               assign
     1690                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1691               .
     1692             end.
     1693             assign
     1694               v-diasize-browse-handle :width = v-browse-width
     1695             .
     1696             for each buf_temp-diasize-handle
     1697             on error undo, next
     1698             :
     1699               assign
     1700                 v-object-handle = buf_temp-diasize-handle.handle-value
     1701               .
     1702               if v-object-handle <> v-diasize-resize-button
     1703               then do:
     1704                 assign
     1705                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1706                 .
     1707               end.
     1708             end.
     1709             run diasize_position-resize-button in this-procedure .
     1710           end.
     1711           assign
     1712             v-diasize-change-size = false
     1713           .
     1714           leave move_block .
     1715         end.
     1716       end.
     1717       assign
     1718         v-diasize-need-full-display = true
     1719       .
     1720       if v-diasize-change-size = false
     1721       then do:
     1722         assign
     1723           v-diasize-change-size = true
     1724         .
     1725       end.
     1726       else do:
     1727         return .
     1728       end.
     1729       assign
     1730         v-frame-width = frame Dialog-Frame :width
     1731         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1732         v-browse-width = v-diasize-browse-handle :width
     1733       .
     1734       for each buf_temp-browse-handle
     1735         where buf_temp-browse-handle.browse-type = 'width':u
     1736       :
     1737         assign
     1738           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1739         .
     1740       end.
     1741       for each buf_temp-diasize-handle
     1742       :
     1743         delete buf_temp-diasize-handle .
     1744       end.
     1745       assign
     1746         v-field-group-handle = frame Dialog-Frame :first-child
     1747       .
     1748       do while valid-handle(v-field-group-handle)
     1749       :
     1750         assign
     1751           v-object-handle = v-field-group-handle :first-child
     1752         .
     1753         do while valid-handle(v-object-handle)
     1754         :
     1755           if  v-object-handle <> v-diasize-browse-handle :handle
     1756           and v-object-handle <> v-diasize-resize-button
     1757           and can-query(v-object-handle, "row")
     1758           and can-query(v-object-handle, "height")
     1759           and ( v-object-handle :col + v-object-handle :width
     1760                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1761               )
     1762           then do:
     1763             find first buf_temp-browse-handle
     1764               where buf_temp-browse-handle.browse-type   = 'width':u
     1765                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1766               no-error .
     1767             if available buf_temp-browse-handle
     1768             then do:
     1769             end.
     1770             else do:
     1771               create buf_temp-diasize-handle .
     1772               assign
     1773                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1774                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1775               .
     1776             end.
     1777           end.
     1778           assign
     1779             v-object-handle = v-object-handle :next-sibling
     1780           .
     1781         end.
     1782         assign
     1783           v-field-group-handle = v-field-group-handle :next-sibling
     1784         .
     1785       end.
     1786       do with frame Dialog-Frame
     1787       :
     1788         hide v-diasize-resize-button .
     1789         v-diasize-resize-button :row = 1.
     1790         v-diasize-resize-button :column = 1.
     1791       end.
     1792       if p-change-value > 0
     1793       then do:
     1794         if frame Dialog-Frame :scrollable = true
     1795         then do:
     1796           assign
     1797             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1798             no-error .
     1799           if error-status :error
     1800           or error-status :get-message(1) <> ""
     1801           then do:
     1802             undo move_block, retry move_block.
     1803           end.
     1804         end.
     1805         assign
     1806           frame Dialog-Frame :width = v-frame-width + p-change-value
     1807           no-error .
     1808         if error-status :error
     1809         or error-status :get-message(1) <> ""
     1810         then do:
     1811           undo move_block, retry move_block.
     1812         end.
     1813         assign
     1814           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1815         no-error .
     1816         if error-status :error
     1817         or error-status :get-message(1) <> ""
     1818         then do:
     1819           undo move_block, retry move_block.
     1820         end.
     1821         for each buf_temp-browse-handle
     1822           where buf_temp-browse-handle.browse-type = 'width':u
     1823         on error undo move_block, retry move_block
     1824         :
     1825           assign
     1826             buf_temp-browse-handle.browse-handle :width
     1827               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1828             no-error .
     1829           if error-status :error
     1830           or error-status :get-message(1) <> ""
     1831           then do:
     1832             undo move_block, retry move_block .
     1833           end.
     1834         end.
     1835         for each buf_temp-diasize-handle
     1836         on error undo move_block, retry move_block
     1837         :
     1838           assign
     1839             v-object-handle = buf_temp-diasize-handle.handle-value
     1840           .
     1841           if v-object-handle <> v-diasize-resize-button
     1842           then do:
     1843             assign
     1844               v-object-handle :col = v-object-handle :col + p-change-value
     1845               no-error .
     1846             if error-status :error
     1847             or error-status :get-message(1) <> ""
     1848             then do:
     1849               undo move_block, retry move_block .
     1850             end.
     1851           end.
     1852         end.
     1853       end.
     1854       else do:
     1855         for each buf_temp-diasize-handle
     1856         on error undo move_block, retry move_block
     1857         :
     1858           assign
     1859             v-object-handle = buf_temp-diasize-handle.handle-value
     1860           .
     1861           if v-object-handle <> v-diasize-resize-button
     1862           then do:
     1863             assign
     1864               v-object-handle :col = v-object-handle :col + p-change-value
     1865               no-error .
     1866             if error-status :error
     1867             or error-status :get-message(1) <> ""
     1868             then do:
     1869               undo move_block, retry move_block .
     1870             end.
     1871           end.
     1872         end.
     1873         for each buf_temp-browse-handle
     1874           where buf_temp-browse-handle.browse-type = 'width':u
     1875         on error undo move_block, retry move_block
     1876         :
     1877           assign
     1878             buf_temp-browse-handle.browse-handle :width
     1879               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1880             no-error .
     1881           if error-status :error
     1882           or error-status :get-message(1) <> ""
     1883           then do:
     1884             undo move_block, retry move_block .
     1885           end.
     1886         end.
     1887         assign
     1888           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1889           no-error .
     1890         if error-status :error
     1891         or error-status :get-message(1) <> ""
     1892         then do:
     1893           undo move_block, retry move_block.
     1894         end.
     1895         assign
     1896           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1897         no-error .
     1898         if error-status :error
     1899         or error-status :get-message(1) <> ""
     1900         then do:
     1901           undo move_block, retry move_block.
     1902         end.
     1903         if frame Dialog-Frame :scrollable = true
     1904         then do:
     1905           assign
     1906             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1907           no-error .
     1908           if error-status :error
     1909           or error-status :get-message(1) <> ""
     1910           then do:
     1911             undo move_block, retry move_block.
     1912           end.
     1913         end.
     1914       end.
     1915       if p-move-resize
     1916       then do:
     1917         run diasize_position-resize-button in this-procedure .
     1918       end.
     1919       if v-diasize-wndstore = true
     1920       then do:
     1921         if connected("ub") = true
     1922         then do:
     1923           define variable v-cntxt-db-num        as integer   no-undo .
     1924           define variable v-cntxt-userid        as character no-undo .
     1925           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1926                                             , OUTPUT v-cntxt-userid
     1927                                             ) .
     1928           run gbl/wndsizew.p
     1929             (input  v-cntxt-db-num
     1930             ,input  v-cntxt-userid
     1931             ,input  v-diasize-proc-name
     1932             ,input  'width':u
     1933             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1934             ) .
     1935         end.
     1936       end.
     1937     end.
     1938     assign
     1939       v-diasize-change-size = false
     1940     .
     1941   end procedure.
     1942   procedure diasize_set-width :
     1943     define input  parameter p-new-width  as decimal   no-undo .
     1944     define input  parameter p-move-resize as logical   no-undo .
     1945     do
     1946     on error undo, return error return-value
     1947     :
     1948       run diasize_change-width in this-procedure
     1949         (input  (p-new-width - frame Dialog-Frame :width)
     1950         ,input  p-move-resize
     1951         ) .
     1952     end.
     1953   end procedure.
     1954   procedure diasize_position-resize-button :
     1955     do with frame Dialog-Frame
     1956     :
     1957       hide v-diasize-resize-button .
     1958       assign
     1959         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1960                     - 1
     1961                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1962         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1963                     - 1
     1964                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1965       .
     1966       view v-diasize-resize-button .
     1967     end.
     1968   end procedure.
     1969   on alt-right anywhere
     1970   do:
     1971     run diasize_change-width in this-procedure
     1972       (input 1
     1973       ,input true
     1974       ) .
     1975     return no-apply .
     1976   end.
     1977   on alt-left anywhere
     1978   do:
     1979     run diasize_change-width in this-procedure
     1980       (input -1
     1981       ,input true
     1982       ) .
     1983     return no-apply .
     1984   end.
     1985   on alt-down anywhere
     1986   do:
     1987     run diasize_change-height in this-procedure
     1988       (input 1
     1989       ,input true
     1990       ) .
     1991     return no-apply .
     1992   end.
     1993   on alt-up anywhere
     1994   do:
     1995     run diasize_change-height in this-procedure
     1996       (input -1
     1997       ,input true
     1998       ) .
     1999     return no-apply .
     2000   end.
     2001   on alt-enter of frame Dialog-Frame
     2002   do:
     2003     run diasize_maximize in this-procedure
     2004       (input  ?
     2005       ).
     2006     return no-apply .
     2007   end.
     2008   procedure diasize_end-move :
     2009     do
     2010     on error undo, return error return-value
     2011     :
     2012       define variable v-row-delta as decimal   no-undo .
     2013       define variable v-col-delta as decimal   no-undo .
     2014       define variable v-new-row as decimal   no-undo .
     2015       define variable v-new-col as decimal   no-undo .
     2016       assign
     2017         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2018         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2019       .
     2020       assign
     2021         v-row-delta = v-new-row - frame Dialog-Frame :height
     2022         v-col-delta = v-new-col - frame Dialog-Frame :width
     2023       .
     2024       run diasize_change-height in this-procedure
     2025         (input v-row-delta
     2026         ,input true
     2027         ) .
     2028       run diasize_change-width in this-procedure
     2029         (input v-col-delta
     2030         ,input true
     2031         ) .
     2032     end.
     2033   end procedure.
     2034   procedure diasize_maximize :
     2035     define input  parameter p-action as logical   no-undo .
     2036     do
     2037     on error undo, return error return-value
     2038     :
     2039       if p-action = ?
     2040       then do:
     2041         if v-diasize-need-maximize = true
     2042         then do:
     2043           assign
     2044             p-action = true
     2045           .
     2046         end.
     2047         else do:
     2048           assign
     2049             p-action = false
     2050           .
     2051         end.
     2052       end.
     2053       if p-action = true
     2054       then do:
     2055         run diasize_change-height in this-procedure
     2056           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2057               - frame Dialog-Frame :height-chars
     2058           ,input true
     2059           ) .
     2060         run diasize_change-width in this-procedure
     2061           (input session :width-chars
     2062               - frame Dialog-Frame :width-chars
     2063           ,input true
     2064           ) .
     2065         assign
     2066           v-diasize-need-maximize = false
     2067         .
     2068       end.
     2069       else do:
     2070         run diasize_change-width in this-procedure
     2071           (input v-diasize-orig-frame-width
     2072               - frame Dialog-Frame :width-chars
     2073           ,input true
     2074           ) .
     2075         run diasize_change-height in this-procedure
     2076           (input v-diasize-orig-frame-height
     2077               - frame Dialog-Frame :height-chars
     2078           ,input true
     2079           ) .
     2080         assign
     2081           v-diasize-need-maximize = true
     2082         .
     2083       end.
     2084     end.
     2085   end procedure.
     2086   procedure diasize_restore-orig-size :
     2087     do
     2088     on error undo, return error return-value
     2089     :
     2090       assign
     2091         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2092         v-diasize-current-frame-height = frame Dialog-Frame :height
     2093       .
     2094       run diasize_set-height in this-procedure
     2095         (input  v-diasize-orig-frame-height
     2096         ,input  true
     2097         ) .
     2098       run diasize_set-width in this-procedure
     2099         (input  v-diasize-orig-frame-width
     2100         ,input  true
     2101         ) .
     2102     end.
     2103   end procedure.
     2104   procedure diasize_restore-current-size :
     2105     do
     2106     on error undo, return error return-value
     2107     :
     2108       run diasize_set-height in this-procedure
     2109         (input  v-diasize-current-frame-height
     2110         ,input  true
     2111         ) .
     2112       run diasize_set-width in this-procedure
     2113         (input  v-diasize-current-frame-width
     2114         ,input  true
     2115         ) .
     2116     end.
     2117   end procedure.
     2118   procedure diasize_set-browse-handle :
     2119     define input  parameter p-browse-handle as handle   no-undo .
     2120     define buffer buf_temp-browse-handle for temp-browse-handle .
     2121     do
     2122     on error undo, return error return-value
     2123     :
     2124       assign
     2125         v-diasize-browse-handle = p-browse-handle
     2126       .
     2127       for each buf_temp-browse-handle
     2128       on error undo, return error return-value
     2129       :
     2130         delete buf_temp-browse-handle .
     2131       end.
     2132     end.
     2133   end procedure.
     2134   procedure diasize_add_browse :
     2135     define input  parameter p-browse-type   as character no-undo .
     2136     define input  parameter p-browse-handle as handle    no-undo .
     2137     define buffer buf_temp-browse-handle for temp-browse-handle .
     2138     do
     2139     on error undo, return error return-value
     2140     :
     2141       assign
     2142         v-diasize-browse-number = v-diasize-browse-number + 1
     2143       .
     2144       create buf_temp-browse-handle .
     2145       assign
     2146         buf_temp-browse-handle.browse-type   = p-browse-type
     2147         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2148         buf_temp-browse-handle.browse-handle = p-browse-handle
     2149       .
     2150     end.
     2151   end procedure.
     2152   procedure diasize_init :
     2153     define variable v-default-value    as logical   no-undo .
     2154     define variable v-restore-saved    as logical   no-undo .
     2155     define variable v-resize-value-str as character no-undo .
     2156     do
     2157     on error undo, return error return-value
     2158     :
     2159       do with frame Dialog-Frame
     2160       :
     2161         assign
     2162           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2163           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2164           v-diasize-browse-handle     = browse br-term-dtr :handle
     2165         .
     2166         create button v-diasize-resize-button
     2167         assign
     2168           parent        = frame Dialog-Frame :first-child
     2169           label         = "s"
     2170           height-pixels = 16
     2171           width-pixels  = 16
     2172           visible       = true
     2173           sensitive     = true
     2174           movable       = true
     2175           triggers:
     2176             on end-move persistent run diasize_end-move in this-procedure .
     2177           end triggers.
     2178         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2179         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2180         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2181         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2182         assign
