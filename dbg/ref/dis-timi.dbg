       38   define new global shared variable g#vssrevis-logger as handle    no-undo .
       39   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       40   define variable v-vssrevis-logger                   as handle    no-undo .
       41   procedure vss-logevent :
       42     define input  parameter p-extra-paramters as character no-undo .
       43     define variable v-vssrevis-parameters as character no-undo .
       44     do
       45     on error undo, return error return-value
       46     :
       47       if  valid-handle(v-vssrevis-logger)
       48       and v-vssrevis-logger :get-signature("logevent") <> ""
       49       then do:
       50         run vss-get-parameters in this-procedure
       51           (output v-vssrevis-parameters
       52           ).
       53         run logevent in v-vssrevis-logger
       54           (input vss-workfile
       55           ,input vss-revision
       56           ,input v-vssrevis-parameters
       57           ,input p-extra-paramters
       58           ).
       59       end.
       60     end.
       61   end procedure.
       62   assign
       63     v-vssrevis-logger = g#vssrevis-logger
       64   .
       65   if  valid-handle(v-vssrevis-logger)
       66   and v-vssrevis-logger :get-signature("logevent") <> ""
       67   then do:
       68     assign
       69       v-vssrevis-logevent = true
       70     .
       71     run vss-logevent in this-procedure (input vss-description) .
       72   end.
       73   define new global shared variable g#language as character no-undo .
       74   if g#language <> '' and g#language <> 'rus':U then do:
       75     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       76   end.
       77   define new global shared variable g#library  as handle no-undo .
       78   define new global shared variable g#library2 as handle no-undo .
       79   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   procedure dtr-code :
       81     do
       82     on error undo, return error
       83     :
       84       define input  parameter  p-templ-rl-root     like ub.dis-time-rule.templ-rl-root     no-undo .
       85       define output parameter  p-des               like ub.dis-time-rule.des               no-undo .
       86       define output parameter  p-upper-time-rule-num    like ub.dis-time-rule.upper-time-rule-num    no-undo .
       87       define output parameter  p-value-type        like ub.dis-time-rule.value-type        no-undo .
       88       define output parameter  p-level-1 as character no-undo .
       89       define output parameter  p-level-2 as character no-undo .
       90       define output parameter  p-output-display as logical   no-undo .
       91       define output parameter  p-tree           as char  no-undo .
       92       define output parameter  p-other          as character no-undo .
       93       define variable v-templ-rl-root like ub.dis-time-rule.templ-rl-root no-undo .
       94       define buffer buf_dis-time-rule for ub.dis-time-rule .
       95       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
       96       if p-templ-rl-root < 50000 then
       97       v-templ-rl-root = (p-templ-rl-root + 50000).
       98       else v-templ-rl-root = p-templ-rl-root.
       99       find first buf_dis-time-rule no-lock where
      100                 buf_dis-time-rule.time-rule-num = v-templ-rl-root no-error .
      101       if not available buf_dis-time-rule then do:
      102         undo, return error substitute("ÌÂËÁ‚ÂÒÚÌ˚È ÚËÔ ‡ÒÔËÒ‡ÌËˇ &1", p-templ-rl-root) .
      103       end.
      104       find first buf_dis-cfg-rule no-lock where
      105               buf_dis-cfg-rule.templ-rl-root = 0
      106           and buf_dis-cfg-rule.time-templ-rl-root = p-templ-rl-root
      107           and buf_dis-cfg-rule.pos-type = '':U
      108           and buf_dis-cfg-rule.table-name = '':U
      109           and buf_dis-cfg-rule.discnt-role = '':U
      110           and buf_dis-cfg-rule.self-nonunique = '':U
      111               no-error.
      112       if not available buf_Dis-cfg-rule then do:
      113           undo, return error substitute("ÌÂËÁ‚ÂÒÚÌ˚È ÚËÔ ‡ÒÔËÒ‡ÌËˇ &1", p-templ-rl-root ).
      114       end.
      115       assign
      116       p-des = buf_dis-time-rule.des
      117       p-upper-time-rule-num = (buf_dis-time-rule.upper-time-rule-num - 50000)
      118       p-value-type = buf_dis-time-rule.value-type
      119       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      120       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      121                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      122                    else '')
      123       p-output-display = (buf_dis-time-rule.sts = integer('0':U))
      124       p-tree = buf_dis-time-rule.uniq-field
      125       p-other = buf_dis-time-rule.other-inf
      126       .
      127     end.
      128   end procedure.
      129   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   procedure dr-code :
      131     do
      132     on error undo, return error
      133     :
      134       define input  parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
      135       define output parameter  p-des               like ub.dis-rule.des               no-undo .
      136       define output parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
      137       define output parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
      138       define output parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
      139       define output parameter  p-level-1           as character no-undo .
      140       define output parameter  p-level-2           as character no-undo .
      141       define output parameter  p-global             as integer no-undo .
      142       define output parameter  p-host               as integer no-undo .
      143       define output parameter  p-object             as integer no-undo .
      144       define output parameter  p-output-display as logical   no-undo .
      145       define output parameter  p-tree           as char  no-undo .
      146       define output parameter  p-other          as character no-undo .
      147       define variable v-other as character no-undo .
      148       define buffer buf_dis-rule for ub.dis-rule .
      149       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      150       find first buf_dis-rule no-lock where
      151                 buf_dis-rule.rule-num = p-templ-rl-root no-error.
      152       find first buf_dis-cfg-rule no-lock where
      153               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      154           and buf_dis-cfg-rule.pos-type = '':U
      155           and buf_dis-cfg-rule.table-name = '':U
      156           and buf_dis-cfg-rule.discnt-role = '':U
      157           and buf_dis-cfg-rule.self-nonunique = '':U
      158               no-error.
      159       if not available buf_Dis-cfg-rule then do:
      160           undo, return error substitute("ÌÂËÁ‚ÂÒÚÌ˚È ¯‡·ÎÓÌ ÒÍË‰ÍË &1", p-templ-rl-root ).
      161       end.
      162       assign
      163       p-des = buf_dis-rule.des
      164       p-discnt-type = buf_dis-rule.discnt-type
      165       p-subject-type = buf_dis-rule.subject-type
      166       p-value-type = buf_dis-rule.value-type
      167       p-global = (if available buf_dis-cfg-rule
      168                   then buf_dis-cfg-rule.has-global
      169                   else 0)
      170       p-host = (if available buf_dis-cfg-rule
      171                 then buf_dis-cfg-rule.has-host
      172                 else 0)
      173       p-object = (if available buf_dis-cfg-rule
      174                 then buf_dis-cfg-rule.has-obj
      175                 else 0)
      176       p-output-display = (buf_dis-rule.sts = integer('0':U))
      177       p-tree = buf_Dis-rule.uniq-field
      178       p-other = buf_dis-rule.other-inf
      179       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      180       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      181                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      182                    else '')
      183       .
      184     end.
      185   end procedure.
      186   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      187   procedure disrules-fill-properties:
      188   define input  parameter p-templ-rl-root as integer   no-undo .
      189   define buffer buf_drt-prop for ub.drt-prop.
      190   define buffer buf_temp-drt-prop for temp-drt-prop.
      191   do
      192   on error undo, return error return-value
      193   :
      194     for each buf_temp-drt-prop:
      195       delete buf_temp-drt-prop.
      196     end.
      197     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      198       create buf_temp-drt-prop.
      199       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      200     end.
      201   end.
      202   end procedure.
      203   procedure disrules-get-interface-form :
      204   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
      205   define output parameter p-form-name as character no-undo .
      206   define buffer buf_temp-drt-prop for temp-drt-prop.
      207   define buffer buf_drt-prop for ub.drt-prop.
      208   find first buf_temp-drt-prop where
      209             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
      210         and buf_temp-drt-prop.upper-prop-code = "InputForm"
      211         and buf_temp-drt-prop.prop-code = "FormName" no-error.
      212   if not available buf_temp-drt-prop then do:
      213     find first buf_drt-prop where
      214               buf_drt-prop.templ-rl-root = p-templ-rl-root
      215           and buf_drt-prop.upper-prop-code = "InputForm"
      216           and buf_drt-prop.prop-code = "FormName" no-error.
      217     if available buf_drt-prop then do:
      218       p-form-name = buf_drt-prop.property-value.
      219     end.
      220     else do:
      221       p-form-name = "ref/dis-ruli.w".
      222     end.
      223   end.
      224   else do:
      225     p-form-name = buf_temp-drt-prop.property-value.
      226   end.
      227   end procedure.
      228   ~
      229   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      230   define variable v-waitfram-action01         as character   no-undo .
      231   define variable v-waitfram-action02         as character   no-undo .
      232   define variable v-waitfram-action03         as character   no-undo .
      233   define variable mWaitFramTextBeg            as character   no-undo.
      234   define variable mWaitFramTextEnd            as character   no-undo.
      235   define variable mWaitFramView               as logical     no-undo.
      236   define variable mWaitProcEvent              as logical     no-undo init yes.
      237   define variable mWaitFramInterval           as integer     no-undo init 1 .
      238   define variable mWaitFramStop               as logical     no-undo.
      239   define variable mWaitFramStopUser           as logical     no-undo.
      240   define variable mWaitFramStopTimeOut        as logical     no-undo.
      241   define variable mWaitFramStartProc          as datetime-tz no-undo.
      242   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      243   define button B-WaitFramStop auto-end-key
      244        label "—ÚÓÔ"
      245        size 10 by 1 tooltip "ŒÒÚÓÌÓ‚ËÚ¸ ÔÓˆÂÒÒ".
      246   define button B-viewProcInfo
      247        label "»ÌÙÓÏ‡ˆËˇ"
      248        size 15 by 1 tooltip "»ÌÙÓÏ‡ˆËˇ Ó ÔÓˆÂÒÒ".
      249   define frame waitfram
      250     v-waitfram-action01 format "x(72)" no-label skip
      251     v-waitfram-action02 format "x(72)" no-label skip
      252     v-waitfram-action03 format "x(72)" no-label skip
      253     B-viewProcInfo
      254     B-WaitFramStop at row 4 col 30
      255     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      256     .
      257   define new global shared variable mBatchMode as logical no-undo init ?.
      258   define variable mFramBachModHandle as handle no-undo.
      259   mFramBachModHandle = frame waitfram:handle.
      260   define variable mFameOldVis as logical no-undo.
      261   define variable mVisCUrentVin as logical no-undo.
      262   if session:batch-mode
      263   then
      264      mBatchMode = yes.
      265   if mBatchMode = ? then do:
      266     mVisCUrentVin = current-window:visible.
      267     mFameOldVis = mFramBachModHandle:visible.
      268     mFramBachModHandle:visible  = yes.
      269     mBatchMode = mFramBachModHandle:visible ne yes.
      270     mFramBachModHandle:visible = mFameOldVis.
      271     current-window:visible = mVisCUrentVin.
      272   end.
      273    if  log-manager:logfile-name ne ?
      274     then DO:
      275         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      276         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      277         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      278     end.
      279   on choose of B-WaitFramStop in frame waitfram
      280   do:
      281     mWaitFramStop = yes.
      282     mWaitFramStopUser = yes.
      283   end.
      284   function waitfram-check-timeout returns logical():
      285      define variable vtime as int64 no-undo.
      286      if mWaitFramStopTimeOut
      287      then
      288         return yes.
      289      vtime = ( now - mWaitFramStartProc ) / 1000 .
      290      if     mWaitFramTimeOut ne ?
      291         and mWaitFramTimeOut ne 0
      292         and mWaitFramTimeOut lt vtime
      293      then do:
      294         mWaitFramStopTimeOut = yes.
      295      end.
      296      return mWaitFramStopTimeOut.
      297   end.
      298   procedure waitfram-hide :
      299     if not session:batch-mode
      300     then do
      301     on error undo, return error return-value
      302     :
      303       pause 0 before-hide .
      304       if not mBatchMode then
      305         hide frame waitfram .
      306     if     not mWaitFramView
      307        and mWaitProcEvent
      308     then
      309       process events .
      310     end.
      311   end procedure.
      312   procedure waitfram-show :
      313     define input  parameter p-message as character no-undo .
      314     define variable v-left-margin as integer   no-undo .
      315     if not session:batch-mode
      316     then do
      317     on error undo, return error return-value
      318     :
      319       if length(p-message) <= 70 then do:
      320         assign
      321           v-left-margin = integer((70 - length(p-message)) / 2)
      322         .
      323         assign
      324           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      325         .
      326         assign
      327           v-waitfram-action01 = " "
      328           v-waitfram-action02 = " "
      329                                    + fill(" ", v-left-margin)
      330                                    + p-message
      331           v-waitfram-action03 = " "
      332         .
      333       end.
      334       else do:
      335         define variable vRindex1 as integer no-undo.
      336         define variable vRindex2 as integer no-undo.
      337         vRindex1 = r-index(p-message," ",70).
      338         if vRindex1 = 0
      339         then
      340            vRindex1 = 70.
      341         if length(p-message)  <= vRindex1 + 70 then do:
      342           assign
      343             v-waitfram-action01 = " "
      344             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      345             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      346           .
      347         end.
      348         else do:
      349           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      350           if vRindex2 <= vRindex1
      351           then
      352              vRindex2 = vRindex1 + 70.
      353           assign
      354             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      355             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      356             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      357           .
      358         end.
      359       end.
      360       B-viewProcInfo:visible   in frame waitfram = no.
      361       B-viewProcInfo:sensitive in frame waitfram = no.
      362       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      363       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      364       if  (   mWaitFramView
      365          or  mWaitProcEvent)
      366          and not mBatchMode
      367       then
      368          display
      369             v-waitfram-action01 skip
      370             v-waitfram-action02 skip
      371             v-waitfram-action03 skip
      372          with frame waitfram .
      373       if     mWaitFramView
      374          then do:
      375             if     mWaitFramInterval ne ?
      376                and not mBatchMode
      377             then
      378                wait-for go of frame waitfram pause mWaitFramInterval.
      379          end.
      380          else
      381             if     mWaitProcEvent
      382                and not mBatchMode
      383             then
      384                process events .
      385     end.
      386   end procedure.
      387      procedure waitfram-show-this:
      388         define input  parameter iInterval as int64 no-undo.
      389         define variable vtime as int64 no-undo.
      390         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      391         mWaitFramInterval = iInterval.
      392         run waitfram-show (substitute("&1&2 &3&4" ,
      393                                       mWaitFramTextBeg ,
      394                                       if vtime eq ? then "" else substitute (" œÓ¯ÎÓ: &1 ÒÂÍ" , string( vtime)),
      395                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " ËÁ " + string(mWaitFramTimeOut) + " ÒÂÍ. " else "",
      396                                       mWaitFramTextEnd
      397                                      )
      398                           ).
      399      end.
      400      procedure WaitFramRunPause:
      401         define input  parameter iInterval as dec no-undo.
      402         define variable vStart  as datetime-tz no-undo.
      403         define variable vend    as datetime-tz no-undo.
      404         define variable vint as int64 no-undo.
      405         define variable vOk as logical no-undo.
      406         vStart = now.
      407         vend   = vStart.
      408         publish "WaitFramPause" (iInterval,output vOk).
      409         vend   =  now.
      410         vint = vend - vStart.
      411         vint = iInterval - vint / 1000.
      412         if     not mWaitFramStop
      413            and (   vint > 0
      414                 or (    not vOk
      415                     and iInterval eq ?
      416                     )
      417                 )
      418         then
      419            run waitfram-show-this (iInterval).
      420         vend   =  now.
      421         vint = vend - vStart.
      422         vint = iInterval - vint / 1000.
      423         if     not mWaitFramStop
      424            and vint > 0
      425         then do:
      426            run gbl/pause.p (vint * 1000).
      427         end.
      428         if iInterval ne ?
      429         then
      430            publish "WaitFramStop".
      431         waitfram-check-timeout().
      432      end.
      433      procedure WaitFramWaitFor:
      434         define input  parameter iInterval as dec no-undo.
      435         assign
      436            mWaitFramStartProc   = now
      437            mWaitFramStopUser    = no
      438            mWaitFramStopTimeOut = no
      439         .
      440         block-wait:
      441         do while not mWaitFramStop:
      442            run WaitFramRunPause (iInterval).
      443            if  waitfram-check-timeout()
      444            then do:
      445               leave block-wait.
      446            end.
      447         end.
      448         run waitfram-hide.
      449      end.
      450   procedure waitfram-join :
      451     define input  parameter p-line-1  as character no-undo .
      452     define input  parameter p-line-2  as character no-undo .
      453     define input  parameter p-line-3  as character no-undo .
      454     define output parameter p-message as character no-undo .
      455     do
      456     on error undo, return error return-value
      457     :
      458       assign
      459         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      460                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      461                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      462       .
      463     end.
      464   end procedure.
      465   function waitfram-join-function returns character
      466     (input p-line-1 as character
      467     ,input p-line-2 as character
      468     ,input p-line-3 as character
      469     ).
      470     define variable v-message as character no-undo .
      471     run waitfram-join in this-procedure
      472       (input  p-line-1
      473       ,input  p-line-2
      474       ,input  p-line-3
      475       ,output v-message
      476       ) .
      477     return v-message .
      478   end function .
      479   procedure proc-alt-shift-f2:
      480     if not ibs.th.gbl.gbl-var:rcode
      481   then
      482     run gbl\inidebug.p .
      483   end.
      484   procedure proc-alt-shift-f3:
      485     run gbl/prvssinf.p
      486       ( input this-procedure
      487       ) .
      488   end.
      489   define variable v-inform-launched as logical no-undo initial false .
      490   procedure proc-alt-shift-f4:
      491     define variable v-action as character no-undo .
      492     if v-inform-launched = false then do:
      493       assign
      494         v-inform-launched = true
      495       .
      496       run gbl/d-inform.w
      497         (  input self
      498         ,  input this-procedure
      499         , output v-action
      500         ) no-error .
      501       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      502       assign
      503         v-inform-launched = false
      504       .
      505     end.
      506   end.
      507   procedure proc-alt-f1:
      508     run gbl/corrhelp.p
      509       (input this-procedure
      510       ) .
      511   end .
      512   on alt-shift-f2 anywhere do:
      513     run proc-alt-shift-f2.
      514   end.
      515   on alt-shift-f3 anywhere do:
      516     run proc-alt-shift-f3 in this-procedure .
      517   end.
      518   on alt-shift-f4 anywhere do:
      519     run proc-alt-shift-f4 in this-procedure.
      520   end.
      521   on alt-f1 anywhere do:
      522     run proc-alt-f1 in this-procedure .
      523   end.
      524   function diff-list returns character (
      525     input parfirst-list  as character,
      526     input parsecond-list as character,
      527     input pardelim       as character).
      528     if pardelim = ""
      529     or pardelim = ?
      530     then do:
      531       assign
      532         pardelim = ","
      533       .
      534     end.
      535     def var ind as integer no-undo .
      536     def var v-elem as character no-undo .
      537     def var v-result-list as character no-undo init "".
      538     def var v-num-parfirst-list as integer no-undo .
      539     assign
      540       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      541     .
      542     do ind = 1 to v-num-parfirst-list
      543     :
      544       assign
      545         v-elem = entry(ind, parfirst-list, pardelim)
      546       .
      547       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      548         assign
      549           v-result-list = v-result-list
      550                         + (if v-result-list > "" then pardelim else "")
      551                         + v-elem
      552         .
      553       end.
      554     end.
      555     return v-result-list .
      556   end function.
      557   function add-list returns character (
      558    input parfirst-list  as character,
      559    input parsecond-list as character,
      560    input pardelim       as character).
      561     if pardelim = ""
      562     or pardelim = ?
      563     then do:
      564       assign
      565         pardelim = ","
      566       .
      567     end.
      568     def var ind as integer no-undo .
      569     def var v-elem as character no-undo .
      570     def var v-result-list as character no-undo init "".
      571     def var v-num-parfirst-list as integer no-undo .
      572     assign
      573       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      574     .
      575     do ind = 1 to v-num-parfirst-list
      576     :
      577       assign
      578         v-elem = entry(ind, parfirst-list, pardelim)
      579       .
      580       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      581         assign
      582           v-result-list = v-result-list
      583                         + (if v-result-list > "" then pardelim else "")
      584                         + v-elem
      585         .
      586       end.
      587     end.
      588     def var v-num-parsecond-list as integer no-undo .
      589     assign
      590       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      591     .
      592     do ind = 1 to v-num-parsecond-list
      593     :
      594       assign
      595         v-elem = entry(ind, parsecond-list, pardelim)
      596       .
      597       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      598         assign
      599           v-result-list = v-result-list
      600                         + (if v-result-list > "" then pardelim else "")
      601                         + v-elem
      602         .
      603       end.
      604     end.
      605     return v-result-list .
      606   end function.
      607   function cross-list returns character (
      608    input parfirst-list  as character,
      609    input parsecond-list as character,
      610    input pardelim       as character).
      611     if pardelim = ""
      612     or pardelim = ?
      613     then do:
      614       assign
      615         pardelim = ","
      616       .
      617     end.
      618     def var ind as integer no-undo .
      619     def var v-elem as character no-undo .
      620     def var v-result-list as character no-undo init "".
      621     def var v-num-parfirst-list as integer no-undo .
      622     assign
      623       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      624     .
      625     do ind = 1 to v-num-parfirst-list
      626     :
      627       assign
      628         v-elem = entry(ind, parfirst-list, pardelim)
      629       .
      630       if lookup(v-elem, v-result-list, pardelim) = 0
      631       and lookup(v-elem, parsecond-list, pardelim) > 0
      632       then do:
      633         assign
      634           v-result-list = v-result-list
      635                         + (if v-result-list > "" then pardelim else "")
      636                         + v-elem
      637         .
      638       end.
      639     end.
      640     return v-result-list .
      641   end function.
      642   function radio-label returns character (
      643    input par-rs-value  as character,
      644    input par-rs-radio-buttons as character)
      645    .
      646    DEFINE variable v-result-label as character no-undo.
      647    assign
      648    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      649                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      650                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      651                             ), par-rs-radio-buttons
      652                           )
      653    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      654    .
      655   return v-result-label.
      656   end function.
      657   function m-radio-label returns character (
      658    input par-rs-value  as character,
      659    input par-rs-radio-buttons as character,
      660    input par-delim as character
      661    )
      662    .
      663    DEFINE variable v-result-label as character no-undo.
      664    assign
      665    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      666                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      667                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      668                             ), par-rs-radio-buttons, par-delim
      669                           )
      670    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      671    .
      672   return v-result-label.
      673   end function.
      674   FUNCTION mixlist returns character
      675   (
      676    input parfirst-list  as character
      677    ,input parsecond-list as character
      678    ,input pardelim       as character
      679    ,input pardelim-result as character ) :
      680     if pardelim = ""
      681     or pardelim = ?
      682     then do:
      683       assign
      684         pardelim = ","
      685       .
      686     end.
      687     def var ind as integer no-undo .
      688     def var v-elem1 as character no-undo .
      689     def var v-elem2 as character no-undo .
      690     def var v-result-list as character no-undo init "".
      691     do ind = 1 to num-entries(parfirst-list, pardelim)
      692     :
      693       assign
      694         v-elem1 = entry(ind, parfirst-list, pardelim)
      695         v-elem2 = entry(ind, parsecond-list, pardelim)
      696       .
      697         assign
      698           v-result-list = v-result-list
      699                         + (if v-result-list > "" then pardelim-result else "")
      700                         + v-elem1 + pardelim-result + v-elem2
      701         .
      702     end.
      703     return v-result-list .
      704   END FUNCTION.
