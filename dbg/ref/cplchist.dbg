     3553   PROCEDURE OpenBr :
     3554   define input  parameter p-open-query     as logical   no-undo .
     3555   define input  parameter p-find-next      as logical   no-undo .
     3556   define input  parameter p-find-condition as character no-undo .
     3557   define variable l-query-was-opened as logical no-undo .
     3558   define variable v-title as character no-undo .
     3559   define variable title0 as character no-undo.
     3560   title0 = "История складского места" + chr(32).
     3561   run waitfram-show in this-procedure ( input "Ждите...").
     3562   define variable sort-column-phrase as character no-undo .
     3563   case sort-column-name :
     3564     when "" then do:
     3565       assign
     3566         sort-column-phrase = ""
     3567       .
     3568     end.
     3569     otherwise do:
     3570       assign
     3571         sort-column-phrase = "by " + sort-column-name
     3572       .
     3573     end.
     3574   end case.
     3575   define variable l-open-query as logical   no-undo .
     3576   CASE p-mode :
     3577     WHEN 'все':U        THEN DO:
     3578        assign
     3579        filter-point = filter-point0 + p-mode
     3580        filter-label = substitute("&1", filter-label0)
     3581        .
     3582   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3583   define variable  l-disable-where-28  as logical   no-undo .
     3584   define variable  l-filter-open-28    as logical   .
     3585   define variable  flt-rec-28       as recid     no-undo .
     3586   define variable  filter-name-28      as character no-undo .
     3587   define variable  where-phrase-28     as character no-undo .
     3588   define variable  sort-phrase-28      as character no-undo .
     3589   define variable  where-phrase-rus-28 as character no-undo .
     3590   define variable  sort-phrase-rus-28  as character no-undo .
     3591     run waitfram-show in this-procedure
     3592       (input "ЖДИТЕ ..."
     3593       ).
     3594   run gbl/flt-get.p
     3595     (input filter-point
     3596     ,output flt-rec-28
     3597     ,output filter-name-28
     3598     ,output where-phrase-28
     3599     ,output sort-phrase-28
     3600     ,output where-phrase-rus-28
     3601     ,output sort-phrase-rus-28
     3602     ).
     3603   if p-open-query then do:
     3604       run set-filter-name in this-procedure
     3605         (INPUT filter-name-28
     3606         ) no-error .
     3607     assign
     3608       l-filter-open-28 = false
     3609     .
     3610     if flt-rec-28 <> ?
     3611       or sort-column-phrase > ""
     3612     then do:
     3613       define variable  parameter-2-28 as character no-undo .
     3614       define variable  parameter-3-28 as character no-undo .
     3615       define variable  parameter-4-28 as character no-undo .
     3616       define variable  parameter-5-28 as character no-undo .
     3617       define variable  parameter-6-28 as character no-undo .
     3618       define variable  parameter-7-28 as character no-undo .
     3619         assign
     3620         parameter-3-28 =
     3621                                 "FOR EACH X_c-plc-hist"
     3622         parameter-4-28 =
     3623           (
     3624             if (" TRUE " + " " + where-phrase-28) <> ""
     3625             then " TRUE " + " " + where-phrase-28
     3626             else "true"
     3627           )
     3628         parameter-5-28 = (" " + "" + " " + "")
     3629         parameter-6-28 = if sort-phrase-28 = ''
     3630                              then
     3631           (
     3632           " " + " use-index idate  " +
     3633             " " + sort-column-phrase +
     3634           " " + "  "
     3635           )
     3636                              else
     3637           (
     3638           " " + " use-index idate  " +
     3639             " " + sort-column-phrase +
     3640           " " + sort-phrase-28
     3641           )
     3642         parameter-7-28 =
     3643           " indexed-reposition  "
     3644       .
     3645       do
     3646       on stop undo, leave
     3647       on error undo, leave
     3648       :
     3649         assign
     3650           l-disable-where-28 =
     3651             (" TRUE " + " " + where-phrase-28 = "")
     3652         .
     3653         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3654                             ,input query br-plc-hist:handle
     3655                             ,input parameter-3-28
     3656                             ,input parameter-4-28
     3657                             ,input parameter-5-28
     3658                             ,input parameter-6-28
     3659                             ,input parameter-7-28
     3660                             )
     3661         .
     3662         assign
     3663           l-filter-open-28 = true
     3664         .
     3665       end.
     3666       if l-filter-open-28 = false then do:
     3667         message
     3668           "Ошибка при фильтрации / сортировке" skip
     3669           "Будут показаны записи без учета фильтра" skip
     3670           view-as alert-box .
     3671       end.
     3672       else do:
     3673           assign
     3674             l-query-was-opened = true
     3675           .
     3676       end.
     3677     end.
     3678     if l-filter-open-28 = false then do:
     3679       OPEN QUERY br-plc-hist FOR EACH X_c-plc-hist
     3680         where  TRUE
     3681          use-index idate
     3682         indexed-reposition
     3683     .
     3684         assign
     3685           l-query-was-opened = true
     3686         .
     3687     end.
     3688   end.
     3689   else do:
     3690     assign
     3691       v-doc-rec = recid( X_c-plc-hist )
     3692     .
     3693     do
     3694     on stop undo, leave
     3695     on error undo, leave
     3696     :
     3697       if query br-plc-hist:handle:get-buffer-handle(1) = (buffer X_c-plc-hist:handle) then do:
     3698         assign
     3699         parameter-2-28 = (if p-find-next then "true":u else "false":u )
     3700         parameter-4-28 =
     3701           "where ":u + " TRUE " + " ":u + where-phrase-28 + " ":u + p-find-condition + " " + ""
     3702         parameter-5-28 = " use-index idate  "
     3703       .
     3704         run fltopend_fltfindd in this-procedure  (
     3705                             input this-procedure:handle
     3706                             ,input query br-plc-hist:handle
     3707                             ,input rowid(X_c-plc-hist)
     3708                             ,input logical(parameter-2-28)
     3709                             ,input no-lock
     3710                             ,input (buffer X_c-plc-hist:handle)
     3711                             ,input parameter-4-28
     3712                             ,input parameter-5-28
     3713                             ) no-error.
     3714         .
     3715         assign
     3716           v-doc-rec = integer(return-value)
     3717           v-fltopend-rowid[1] = ?
     3718         .
     3719       end.
     3720       else do:
     3721         assign
     3722         parameter-2-28 = (if p-find-next then "true":u else "false":u )
     3723         parameter-3-28 =  "FOR EACH X_c-plc-hist"
     3724         parameter-4-28 =
     3725           (
     3726             if (" TRUE " + " " + where-phrase-28) <> ""
     3727             then " TRUE " + " " + where-phrase-28
     3728             else "true"
     3729           )
     3730         parameter-5-28 = (" " + "" + " " + "" + " " + p-find-condition)
     3731         parameter-6-28 = if sort-phrase-28 = ''
     3732                              then
     3733           (
     3734           " " + " use-index idate  " +
     3735             " " + sort-column-phrase +
     3736           " " + "  "
     3737           )
     3738                              else
     3739           (
     3740           " " + " use-index idate  " +
     3741             " " + sort-column-phrase +
     3742           " " + sort-phrase-28
     3743           )
     3744         parameter-7-28 =
     3745           " indexed-reposition  "
     3746       .
     3747         run fltopend_fltfindq in this-procedure  (
     3748                             input this-procedure:handle
     3749                             ,input query br-plc-hist:handle
     3750                             ,input logical(parameter-2-28)
     3751                             ,input no-lock
     3752                             ,input parameter-3-28
     3753                             ,input parameter-4-28
     3754                             ,input parameter-5-28
     3755                             ,input parameter-6-28
     3756                             ,input parameter-7-28
     3757                             ,output v-fltopend-rowid
     3758                             ) no-error.
     3759         .
     3760         v-doc-rec = ?.
     3761       end.
     3762       assign
     3763         l-query-was-opened = true
     3764       .
     3765     end.
     3766   end.
     3767     run waitfram-hide in this-procedure .
