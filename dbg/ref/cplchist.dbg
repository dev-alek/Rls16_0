     1685     if error-status:error then return no-apply.
     1686   END.
     1687   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1688   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1689   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1690   on help of frame Dialog-Frame
     1691   do:
     1692     run gbl/app_help.p
     1693       (input this-procedure :file-name
     1694       ,input ''
     1695       ,input ?
     1696       ) no-error.
     1697     if error-status :error then do:
     1698       message
     1699         "Ошибка при вызове помощи"
     1700         error-status :get-message(1)
     1701         view-as alert-box .
     1702     end.
     1703   end.
     1704   run minbtn-set in this-procedure .
     1705   on choose of b-help in frame Dialog-Frame
     1706   do:
     1707     apply "help":u to frame Dialog-Frame .
     1708   end.
     1709   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1710   procedure minbtn-set :
     1711       do
     1712           on error undo, return error return-value
     1713           :
     1714           define variable ii              as integer       no-undo .
     1715           define variable fh              as widget-handle no-undo .
     1716           define variable hh              as widget-handle no-undo .
     1717           define variable v-h             as handle        extent 4 no-undo .
     1718           define variable v-name-button   as character     no-undo .
     1719           define variable v-help-old-x    as decimal       no-undo .
     1720           define variable v-help-old-y    as decimal       no-undo .
     1721           define variable v-help-old-size as decimal       no-undo .
     1722           define variable v-frame-width   as decimal       no-undo .
     1723           define variable jj              as integer       no-undo .
     1724           do
     1725               on error undo, return error
     1726               :
     1727               assign
     1728                   v-frame-width = frame Dialog-Frame:width - 0.3
     1729                   fh            = frame Dialog-Frame:first-child
     1730                   hh            = fh:first-child
     1731                   ii            = 1
     1732                   .
     1733               do while valid-handle(hh):
     1734                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1735                   do:
     1736                       case lc(hh:name) :
     1737                           when "b-help" then
     1738                               do:
     1739                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1740                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1741                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1742                                   hh:TOOLTIP = "Помощь" .
     1743                                   v-help-old-x = hh:column .
     1744                                   v-help-old-y = hh:row    .
     1745                                   v-help-old-size = hh:width .
     1746                                   hh:width-chars = 2.5 .
     1747                               end.
     1748                           when "b-print" then
     1749                               do:
     1750                                   hh:load-image("cmp/b-print.bmp":u) .
     1751                                   hh:TOOLTIP = "Печать" .
     1752                                   v-h[ii] = hh:handle .
     1753                                   ii = ii + 1 .
     1754                                   hh:width-chars = 3 .
     1755                               end.
     1756                           when "b-history" or
     1757                           when "b-hist" then
     1758                               do:
     1759                                   hh:load-image("cmp/b-hist.bmp":u) .
     1760                                   hh:TOOLTIP = "История" .
     1761                                   v-h[ii] = hh:handle .
     1762                                   ii = ii + 1 .
     1763                                   hh:width-chars = 3 .
     1764                               end.
     1765                           when "b-sch" then
     1766                               do:
     1767                                   hh:load-image("cmp/b-sch.bmp":u) .
     1768                                   hh:TOOLTIP = "Установка Фильтра" .
     1769                                   v-h[ii] = hh:handle .
     1770                                   ii = ii + 1 .
     1771                                   hh:width-chars = 3 .
     1772                               end.
     1773                           when "b-hist-user" then
     1774                               do:
     1775                                   hh:load-image("cmp/b-hist.bmp":u) .
     1776                                   hh:TOOLTIP = "История пользователя" .
     1777                                   ii = ii + 1 .
     1778                               end.
     1779                       end case.
     1780                   end.
     1781                   hh = hh:next-sibling.
     1782               end.
     1783               b-help:column = v-frame-width - b-help:width-chars.
     1784               jj = 0.
     1785               repeat ii = 4 to 1 by -1 :
     1786                   if valid-handle (v-h[ii] ) then
     1787                   do:
     1788                       jj  = jj + 1 .
     1789                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1790                       v-h[ii]:row    = v-help-old-y .
     1791                   end.
     1792               end.
     1793           end.
     1794       end.
     1795   end procedure.
     1796   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1797   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1798   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1799   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1800   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1801   define variable v-diasize-current-frame-height as decimal   no-undo .
     1802   define variable v-diasize-change-size          as logical   no-undo .
     1803   define variable v-diasize-resize-button        as handle    no-undo .
     1804   define variable v-diasize-wndmax               as logical   no-undo .
     1805   define variable v-diasize-wndstore             as logical   no-undo .
     1806   define variable v-diasize-proc-name            as character no-undo .
     1807   define variable v-diasize-browse-handle        as handle    no-undo .
     1808   define variable v-diasize-browse-number        as integer   no-undo .
     1809   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1810   define temp-table temp-diasize-handle no-undo
     1811     field handle-value  as handle
     1812     field save-position as decimal
     1813     index xpk is primary unique handle-value
     1814     .
     1815   define temp-table temp-browse-handle no-undo
     1816     field browse-type   as character
     1817     field browse-number as integer
     1818     field browse-handle as handle
     1819     field original-size as decimal
     1820     index xpk is primary unique browse-type browse-number
     1821     index xie browse-type browse-handle
     1822   .
     1823   procedure diasize_change-height :
     1824     define input  parameter p-change-value  as decimal   no-undo .
     1825     define input  parameter p-move-resize   as logical   no-undo .
     1826     define variable v-field-group-handle    as handle    no-undo .
     1827     define variable v-object-handle         as handle    no-undo .
     1828     define variable v-frame-height          as decimal   no-undo .
     1829     define variable v-frame-virtual-height  as decimal   no-undo .
     1830     define variable v-browse-height         as decimal   no-undo .
     1831     define variable v-window-height         as decimal   no-undo .
     1832     define variable v-window-virtual-height as decimal   no-undo .
     1833     define variable v-change-sign           as integer   no-undo .
     1834     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1835     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1836     if p-change-value > 0
     1837     then do:
     1838       if frame Dialog-Frame :height + p-change-value
     1839           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1840       then do:
     1841         assign
     1842           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1843                           - (frame Dialog-Frame :height-chars)
     1844         .
     1845         if p-change-value <= 0
     1846         then do:
     1847           run diasize_position-resize-button in this-procedure .
     1848           return .
     1849         end.
     1850       end.
     1851     end.
     1852     if p-change-value < 0
     1853     then do:
     1854       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1855       then do:
     1856         assign
     1857           p-change-value = v-diasize-orig-frame-height
     1858                          - (frame Dialog-Frame :height-chars)
     1859         .
     1860         if p-change-value >= 0
     1861         then do:
     1862           run diasize_position-resize-button in this-procedure .
     1863           return .
     1864         end.
     1865       end.
     1866     end.
     1867     if p-change-value >= 0
     1868     then do:
     1869       assign
     1870         v-change-sign = 1
     1871       .
     1872     end.
     1873     else do:
     1874       assign
     1875         v-change-sign = -1
     1876       .
     1877     end.
     1878     assign
     1879       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1880     .
     1881     if p-change-value = 0
     1882     then do:
     1883       run diasize_position-resize-button in this-procedure .
     1884       return .
     1885     end.
     1886     move_block:
     1887     do
     1888     on error undo move_block, retry move_block
     1889     :
     1890       if retry
     1891       then do:
     1892         do
     1893         on error undo move_block, leave move_block
     1894         :
     1895           if p-change-value > 0
     1896           then do:
     1897             for each buf_temp-diasize-handle
     1898             on error undo, next
     1899             :
     1900               assign
     1901                 v-object-handle = buf_temp-diasize-handle.handle-value
     1902               .
     1903               if v-object-handle <> v-diasize-resize-button
     1904               then do:
     1905                 assign
     1906                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1907                 .
     1908               end.
     1909             end.
     1910             assign
     1911               v-diasize-browse-handle :height = v-browse-height
     1912             .
     1913             for each buf_temp-browse-handle
     1914               where buf_temp-browse-handle.browse-type = 'height':u
     1915             on error undo, next
     1916             :
     1917               assign
     1918                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1919               .
     1920             end.
     1921             assign
     1922               frame Dialog-Frame :height = v-frame-height
     1923             .
     1924             if frame Dialog-Frame :scrollable = true
     1925             then do:
     1926               assign
     1927                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1928               .
     1929             end.
     1930             run diasize_position-resize-button in this-procedure .
     1931           end.
     1932           else do:
     1933             if frame Dialog-Frame :scrollable = true
     1934             then do:
     1935               assign
     1936                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1937               .
     1938             end.
     1939             assign
     1940               frame Dialog-Frame :height = v-frame-height
     1941             .
     1942             assign
     1943               v-diasize-browse-handle :height = v-browse-height
     1944             .
     1945             for each buf_temp-browse-handle
     1946               where buf_temp-browse-handle.browse-type = 'height':u
     1947             on error undo, next
     1948             :
     1949               assign
     1950                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1951               .
     1952             end.
     1953             for each buf_temp-diasize-handle
     1954             on error undo, next
     1955             :
     1956               assign
     1957                 v-object-handle = buf_temp-diasize-handle.handle-value
     1958               .
     1959               if v-object-handle <> v-diasize-resize-button
     1960               then do:
     1961                 assign
     1962                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1963                 .
     1964               end.
     1965             end.
     1966             run diasize_position-resize-button in this-procedure .
     1967           end.
     1968           assign
     1969             v-diasize-change-size = false
     1970           .
     1971           leave move_block .
     1972         end.
     1973       end.
     1974       assign
     1975         v-diasize-need-full-display = true
     1976       .
     1977       if v-diasize-change-size = false
     1978       then do:
     1979         assign
     1980           v-diasize-change-size = true
     1981         .
     1982       end.
     1983       else do:
     1984         return .
     1985       end.
     1986       assign
     1987         v-frame-height = frame Dialog-Frame :height
     1988         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1989         v-browse-height = v-diasize-browse-handle :height
     1990       .
     1991       for each buf_temp-browse-handle
     1992         where buf_temp-browse-handle.browse-type = 'height':u
     1993       :
     1994         assign
     1995           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1996         .
     1997       end.
     1998       for each buf_temp-diasize-handle
     1999       :
     2000         delete buf_temp-diasize-handle .
     2001       end.
     2002       assign
     2003         v-field-group-handle = frame Dialog-Frame :first-child
     2004       .
     2005       do while valid-handle(v-field-group-handle)
     2006       :
     2007         assign
     2008           v-object-handle = v-field-group-handle :first-child
     2009         .
     2010         do while valid-handle(v-object-handle)
     2011         :
     2012           if  v-object-handle <> v-diasize-browse-handle :handle
     2013           and can-query(v-object-handle, "row")
     2014           and can-query(v-object-handle, "height")
     2015           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2016           then do:
     2017             find first buf_temp-browse-handle
     2018               where buf_temp-browse-handle.browse-type   = 'height':u
     2019                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2020               no-error .
     2021             if available buf_temp-browse-handle
     2022             then do:
     2023             end.
     2024             else do:
     2025               create buf_temp-diasize-handle .
     2026               assign
     2027                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2028                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2029               .
     2030             end.
     2031           end.
     2032           assign
     2033             v-object-handle = v-object-handle :next-sibling
     2034           .
     2035         end.
     2036         assign
     2037           v-field-group-handle = v-field-group-handle :next-sibling
     2038         .
     2039       end.
     2040       do with frame Dialog-Frame
     2041       :
     2042         hide v-diasize-resize-button .
     2043         assign
     2044           v-diasize-resize-button :row    = 1
     2045           v-diasize-resize-button :column = 1
     2046         .
     2047       end.
     2048       if p-change-value > 0
     2049       then do:
     2050         if frame Dialog-Frame :scrollable = true
     2051         then do:
     2052           assign
     2053             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2054             no-error .
     2055           if error-status :error
     2056           or error-status :get-message(1) <> ""
     2057           then do:
     2058             undo move_block, retry move_block .
     2059           end.
     2060         end.
     2061         assign
     2062           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2063           no-error .
     2064         if error-status :error
     2065         or error-status :get-message(1) <> ""
     2066         then do:
     2067           undo move_block, retry move_block .
     2068         end.
     2069         assign
     2070           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2071           no-error .
     2072         if error-status :error
     2073         or error-status :get-message(1) <> ""
     2074         then do:
     2075           undo move_block, retry move_block .
     2076         end.
     2077         for each buf_temp-browse-handle
     2078           where buf_temp-browse-handle.browse-type = 'height':u
     2079         on error undo move_block, retry move_block
     2080         :
     2081           assign
     2082             buf_temp-browse-handle.browse-handle :height
     2083               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2084             no-error .
     2085           if error-status :error
     2086           or error-status :get-message(1) <> ""
     2087           then do:
     2088             undo move_block, retry move_block .
     2089           end.
     2090         end.
     2091         for each buf_temp-diasize-handle
     2092         on error undo move_block, retry move_block
     2093         :
     2094           assign
     2095             v-object-handle = buf_temp-diasize-handle.handle-value
     2096           .
     2097           if v-object-handle <> v-diasize-resize-button
     2098           then do:
     2099             assign
     2100               v-object-handle :row = v-object-handle :row + p-change-value
     2101               no-error .
     2102             if error-status :error
     2103             or error-status :get-message(1) <> ""
     2104             then do:
     2105               undo move_block, retry move_block .
     2106             end.
     2107           end.
     2108         end.
     2109       end.
     2110       else do:
     2111         for each buf_temp-diasize-handle
     2112         on error undo move_block, retry move_block
     2113         :
     2114           assign
     2115             v-object-handle = buf_temp-diasize-handle.handle-value
     2116           .
     2117           if v-object-handle <> v-diasize-resize-button
     2118           then do:
     2119             assign
     2120               v-object-handle :row = v-object-handle :row + p-change-value
     2121               no-error .
     2122             if error-status :error
     2123             or error-status :get-message(1) <> ""
     2124             then do:
     2125               undo move_block, retry move_block .
     2126             end.
     2127           end.
     2128         end.
     2129         assign
     2130           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2131           no-error .
     2132         if error-status :error
     2133         or error-status :get-message(1) <> ""
     2134         then do:
     2135           undo move_block, retry move_block .
     2136         end.
     2137         for each buf_temp-browse-handle
     2138           where buf_temp-browse-handle.browse-type = 'height':u
     2139         on error undo move_block, retry move_block
     2140         :
     2141           assign
     2142             buf_temp-browse-handle.browse-handle :height
     2143               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2144             no-error .
     2145           if error-status :error
     2146           or error-status :get-message(1) <> ""
     2147           then do:
     2148             undo move_block, retry move_block .
     2149           end.
     2150         end.
     2151         assign
     2152           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2153           no-error .
     2154         if error-status :error
     2155         or error-status :get-message(1) <> ""
     2156         then do:
     2157           undo move_block, retry move_block .
     2158         end.
     2159         if frame Dialog-Frame :scrollable = true
     2160         then do:
     2161           assign
     2162             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2163             no-error .
     2164           if error-status :error
     2165           or error-status :get-message(1) <> ""
     2166           then do:
     2167             undo move_block, retry move_block .
     2168           end.
     2169         end.
     2170       end.
     2171       if p-move-resize = true
     2172       then do:
     2173         run diasize_position-resize-button in this-procedure .
     2174       end.
     2175       if v-diasize-wndstore = true
     2176       then do:
     2177         if connected("ub") = true
     2178         then do:
     2179           define variable v-cntxt-db-num        as integer   no-undo .
     2180           define variable v-cntxt-userid        as character no-undo .
     2181           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2182                                             , OUTPUT v-cntxt-userid
     2183                                             ) .
     2184           run gbl/wndsizew.p
     2185             (input  v-cntxt-db-num
     2186             ,input  v-cntxt-userid
     2187             ,input  v-diasize-proc-name
     2188             ,input  'height':u
     2189             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2190             ) .
     2191         end.
     2192       end.
     2193     end.
     2194     assign
     2195       v-diasize-change-size = false
     2196     .
     2197   end procedure.
     2198   procedure diasize_set-height :
     2199     define input  parameter p-new-height  as decimal   no-undo .
     2200     define input  parameter p-move-resize as logical   no-undo .
     2201     do
     2202     on error undo, return error return-value
     2203     :
     2204       run diasize_change-height in this-procedure
     2205         (input  (p-new-height - frame Dialog-Frame :height)
     2206         ,input  p-move-resize
     2207         ) .
     2208     end.
     2209   end procedure.
     2210   procedure diasize_change-width :
     2211     define input  parameter p-change-value as decimal   no-undo .
     2212     define input  parameter p-move-resize  as logical   no-undo .
     2213     define variable v-field-group-handle   as handle    no-undo .
     2214     define variable v-object-handle        as handle    no-undo .
     2215     define variable v-frame-width          as decimal   no-undo .
     2216     define variable v-frame-virtual-width  as decimal   no-undo .
     2217     define variable v-browse-width         as decimal   no-undo .
     2218     define variable v-window-width         as decimal   no-undo .
     2219     define variable v-window-virtual-width as decimal   no-undo .
     2220     define variable v-change-sign          as integer   no-undo .
     2221     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2222     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2223     if p-change-value > 0
     2224     then do:
     2225       if frame Dialog-Frame :width + p-change-value >
     2226           session :width-chars
     2227       then do:
     2228         assign
     2229           p-change-value = session :width-chars - frame Dialog-Frame :width
     2230         .
     2231         if p-change-value <= 0
     2232         then do:
     2233           run diasize_position-resize-button in this-procedure .
     2234           return .
     2235         end.
     2236       end.
     2237     end.
     2238     if p-change-value < 0
     2239     then do:
     2240       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2241       then do:
     2242         assign
     2243           p-change-value = v-diasize-orig-frame-width
     2244                          - frame Dialog-Frame :width
     2245         .
     2246         if p-change-value >= 0
     2247         then do:
     2248           run diasize_position-resize-button in this-procedure .
     2249           return .
     2250         end.
     2251       end.
     2252     end.
     2253     if p-change-value >= 0
     2254     then do:
     2255       assign
     2256         v-change-sign = 1
     2257       .
     2258     end.
     2259     else do:
     2260       assign
     2261         v-change-sign = -1
     2262       .
     2263     end.
     2264     assign
     2265       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2266     .
     2267     if p-change-value = 0
     2268     then do:
     2269       run diasize_position-resize-button in this-procedure .
     2270       return .
     2271     end.
     2272     move_block:
     2273     do
     2274     on error undo move_block, leave move_block
     2275     :
     2276       if retry
     2277       then do:
     2278         do
     2279         on error undo move_block, leave move_block
     2280         :
     2281           if p-change-value > 0
     2282           then do:
     2283             for each buf_temp-diasize-handle
     2284             on error undo, next
     2285             :
     2286               assign
     2287                 v-object-handle = buf_temp-diasize-handle.handle-value
     2288               .
     2289               if v-object-handle <> v-diasize-resize-button
     2290               then do:
     2291                 assign
     2292                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2293                 .
     2294               end.
     2295             end.
     2296             assign
     2297               v-diasize-browse-handle :width = v-browse-width
     2298             .
     2299             for each buf_temp-browse-handle
     2300               where buf_temp-browse-handle.browse-type = 'width':u
     2301             on error undo, next
     2302             :
     2303               assign
     2304                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2305               .
     2306             end.
     2307             assign
     2308               frame Dialog-Frame :width = v-frame-width
     2309             .
     2310             if frame Dialog-Frame :scrollable = true
     2311             then do:
     2312               assign
     2313                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2314               .
     2315             end.
     2316             run diasize_position-resize-button in this-procedure .
     2317           end.
     2318           else do:
     2319             if frame Dialog-Frame :scrollable = true
     2320             then do:
     2321               assign
     2322                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2323               .
     2324             end.
     2325             assign
     2326               frame Dialog-Frame :width = v-frame-width
     2327             .
     2328             for each buf_temp-browse-handle
     2329               where buf_temp-browse-handle.browse-type = 'width':u
     2330             on error undo, next
     2331             :
     2332               assign
     2333                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2334               .
     2335             end.
     2336             assign
     2337               v-diasize-browse-handle :width = v-browse-width
     2338             .
     2339             for each buf_temp-diasize-handle
     2340             on error undo, next
     2341             :
     2342               assign
     2343                 v-object-handle = buf_temp-diasize-handle.handle-value
     2344               .
     2345               if v-object-handle <> v-diasize-resize-button
     2346               then do:
     2347                 assign
     2348                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2349                 .
     2350               end.
     2351             end.
     2352             run diasize_position-resize-button in this-procedure .
     2353           end.
     2354           assign
     2355             v-diasize-change-size = false
     2356           .
     2357           leave move_block .
     2358         end.
     2359       end.
     2360       assign
     2361         v-diasize-need-full-display = true
     2362       .
     2363       if v-diasize-change-size = false
     2364       then do:
     2365         assign
     2366           v-diasize-change-size = true
     2367         .
     2368       end.
     2369       else do:
     2370         return .
     2371       end.
     2372       assign
     2373         v-frame-width = frame Dialog-Frame :width
     2374         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2375         v-browse-width = v-diasize-browse-handle :width
     2376       .
     2377       for each buf_temp-browse-handle
     2378         where buf_temp-browse-handle.browse-type = 'width':u
     2379       :
     2380         assign
     2381           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2382         .
     2383       end.
     2384       for each buf_temp-diasize-handle
     2385       :
     2386         delete buf_temp-diasize-handle .
     2387       end.
     2388       assign
     2389         v-field-group-handle = frame Dialog-Frame :first-child
     2390       .
     2391       do while valid-handle(v-field-group-handle)
     2392       :
     2393         assign
     2394           v-object-handle = v-field-group-handle :first-child
     2395         .
     2396         do while valid-handle(v-object-handle)
     2397         :
     2398           if  v-object-handle <> v-diasize-browse-handle :handle
     2399           and v-object-handle <> v-diasize-resize-button
     2400           and can-query(v-object-handle, "row")
     2401           and can-query(v-object-handle, "height")
     2402           and ( v-object-handle :col + v-object-handle :width
     2403                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2404               )
     2405           then do:
     2406             find first buf_temp-browse-handle
     2407               where buf_temp-browse-handle.browse-type   = 'width':u
     2408                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2409               no-error .
     2410             if available buf_temp-browse-handle
     2411             then do:
     2412             end.
     2413             else do:
     2414               create buf_temp-diasize-handle .
     2415               assign
     2416                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2417                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2418               .
     2419             end.
     2420           end.
     2421           assign
     2422             v-object-handle = v-object-handle :next-sibling
     2423           .
     2424         end.
     2425         assign
     2426           v-field-group-handle = v-field-group-handle :next-sibling
     2427         .
     2428       end.
     2429       do with frame Dialog-Frame
     2430       :
     2431         hide v-diasize-resize-button .
     2432         v-diasize-resize-button :row = 1.
     2433         v-diasize-resize-button :column = 1.
     2434       end.
     2435       if p-change-value > 0
     2436       then do:
     2437         if frame Dialog-Frame :scrollable = true
     2438         then do:
     2439           assign
     2440             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2441             no-error .
     2442           if error-status :error
     2443           or error-status :get-message(1) <> ""
     2444           then do:
     2445             undo move_block, retry move_block.
     2446           end.
     2447         end.
     2448         assign
     2449           frame Dialog-Frame :width = v-frame-width + p-change-value
     2450           no-error .
     2451         if error-status :error
     2452         or error-status :get-message(1) <> ""
     2453         then do:
     2454           undo move_block, retry move_block.
     2455         end.
     2456         assign
     2457           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2458         no-error .
     2459         if error-status :error
     2460         or error-status :get-message(1) <> ""
     2461         then do:
     2462           undo move_block, retry move_block.
     2463         end.
     2464         for each buf_temp-browse-handle
     2465           where buf_temp-browse-handle.browse-type = 'width':u
     2466         on error undo move_block, retry move_block
     2467         :
     2468           assign
     2469             buf_temp-browse-handle.browse-handle :width
     2470               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2471             no-error .
     2472           if error-status :error
     2473           or error-status :get-message(1) <> ""
     2474           then do:
     2475             undo move_block, retry move_block .
     2476           end.
     2477         end.
     2478         for each buf_temp-diasize-handle
     2479         on error undo move_block, retry move_block
     2480         :
     2481           assign
     2482             v-object-handle = buf_temp-diasize-handle.handle-value
     2483           .
     2484           if v-object-handle <> v-diasize-resize-button
     2485           then do:
     2486             assign
     2487               v-object-handle :col = v-object-handle :col + p-change-value
     2488               no-error .
     2489             if error-status :error
     2490             or error-status :get-message(1) <> ""
     2491             then do:
     2492               undo move_block, retry move_block .
     2493             end.
     2494           end.
     2495         end.
     2496       end.
     2497       else do:
     2498         for each buf_temp-diasize-handle
     2499         on error undo move_block, retry move_block
     2500         :
     2501           assign
     2502             v-object-handle = buf_temp-diasize-handle.handle-value
     2503           .
     2504           if v-object-handle <> v-diasize-resize-button
     2505           then do:
     2506             assign
     2507               v-object-handle :col = v-object-handle :col + p-change-value
     2508               no-error .
     2509             if error-status :error
     2510             or error-status :get-message(1) <> ""
     2511             then do:
     2512               undo move_block, retry move_block .
     2513             end.
     2514           end.
     2515         end.
     2516         for each buf_temp-browse-handle
     2517           where buf_temp-browse-handle.browse-type = 'width':u
     2518         on error undo move_block, retry move_block
     2519         :
     2520           assign
     2521             buf_temp-browse-handle.browse-handle :width
     2522               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2523             no-error .
     2524           if error-status :error
     2525           or error-status :get-message(1) <> ""
     2526           then do:
     2527             undo move_block, retry move_block .
     2528           end.
     2529         end.
     2530         assign
     2531           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2532           no-error .
     2533         if error-status :error
     2534         or error-status :get-message(1) <> ""
     2535         then do:
     2536           undo move_block, retry move_block.
     2537         end.
     2538         assign
     2539           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2540         no-error .
     2541         if error-status :error
     2542         or error-status :get-message(1) <> ""
     2543         then do:
     2544           undo move_block, retry move_block.
     2545         end.
     2546         if frame Dialog-Frame :scrollable = true
     2547         then do:
     2548           assign
     2549             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2550           no-error .
     2551           if error-status :error
     2552           or error-status :get-message(1) <> ""
     2553           then do:
     2554             undo move_block, retry move_block.
     2555           end.
     2556         end.
     2557       end.
     2558       if p-move-resize
     2559       then do:
     2560         run diasize_position-resize-button in this-procedure .
     2561       end.
     2562       if v-diasize-wndstore = true
     2563       then do:
     2564         if connected("ub") = true
     2565         then do:
     2566           define variable v-cntxt-db-num        as integer   no-undo .
     2567           define variable v-cntxt-userid        as character no-undo .
     2568           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2569                                             , OUTPUT v-cntxt-userid
     2570                                             ) .
     2571           run gbl/wndsizew.p
     2572             (input  v-cntxt-db-num
     2573             ,input  v-cntxt-userid
     2574             ,input  v-diasize-proc-name
     2575             ,input  'width':u
     2576             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2577             ) .
     2578         end.
     2579       end.
     2580     end.
     2581     assign
     2582       v-diasize-change-size = false
     2583     .
     2584   end procedure.
     2585   procedure diasize_set-width :
     2586     define input  parameter p-new-width  as decimal   no-undo .
     2587     define input  parameter p-move-resize as logical   no-undo .
     2588     do
     2589     on error undo, return error return-value
     2590     :
     2591       run diasize_change-width in this-procedure
     2592         (input  (p-new-width - frame Dialog-Frame :width)
     2593         ,input  p-move-resize
     2594         ) .
     2595     end.
     2596   end procedure.
     2597   procedure diasize_position-resize-button :
     2598     do with frame Dialog-Frame
     2599     :
     2600       hide v-diasize-resize-button .
     2601       assign
     2602         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2603                     - 1
     2604                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2605         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2606                     - 1
     2607                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2608       .
     2609       view v-diasize-resize-button .
     2610     end.
     2611   end procedure.
     2612   on alt-right anywhere
     2613   do:
     2614     run diasize_change-width in this-procedure
     2615       (input 1
     2616       ,input true
     2617       ) .
     2618     return no-apply .
     2619   end.
     2620   on alt-left anywhere
     2621   do:
     2622     run diasize_change-width in this-procedure
     2623       (input -1
     2624       ,input true
     2625       ) .
     2626     return no-apply .
     2627   end.
     2628   on alt-down anywhere
     2629   do:
     2630     run diasize_change-height in this-procedure
     2631       (input 1
     2632       ,input true
     2633       ) .
     2634     return no-apply .
     2635   end.
     2636   on alt-up anywhere
     2637   do:
     2638     run diasize_change-height in this-procedure
     2639       (input -1
     2640       ,input true
     2641       ) .
     2642     return no-apply .
     2643   end.
     2644   on alt-enter of frame Dialog-Frame
     2645   do:
     2646     run diasize_maximize in this-procedure
     2647       (input  ?
     2648       ).
     2649     return no-apply .
     2650   end.
     2651   procedure diasize_end-move :
     2652     do
     2653     on error undo, return error return-value
     2654     :
     2655       define variable v-row-delta as decimal   no-undo .
     2656       define variable v-col-delta as decimal   no-undo .
     2657       define variable v-new-row as decimal   no-undo .
     2658       define variable v-new-col as decimal   no-undo .
     2659       assign
     2660         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2661         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2662       .
     2663       assign
     2664         v-row-delta = v-new-row - frame Dialog-Frame :height
     2665         v-col-delta = v-new-col - frame Dialog-Frame :width
     2666       .
     2667       run diasize_change-height in this-procedure
     2668         (input v-row-delta
     2669         ,input true
     2670         ) .
     2671       run diasize_change-width in this-procedure
     2672         (input v-col-delta
     2673         ,input true
     2674         ) .
     2675     end.
     2676   end procedure.
     2677   procedure diasize_maximize :
     2678     define input  parameter p-action as logical   no-undo .
     2679     do
     2680     on error undo, return error return-value
     2681     :
     2682       if p-action = ?
     2683       then do:
     2684         if v-diasize-need-maximize = true
     2685         then do:
     2686           assign
     2687             p-action = true
     2688           .
     2689         end.
     2690         else do:
     2691           assign
     2692             p-action = false
     2693           .
     2694         end.
     2695       end.
     2696       if p-action = true
     2697       then do:
     2698         run diasize_change-height in this-procedure
     2699           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2700               - frame Dialog-Frame :height-chars
     2701           ,input true
     2702           ) .
     2703         run diasize_change-width in this-procedure
     2704           (input session :width-chars
     2705               - frame Dialog-Frame :width-chars
     2706           ,input true
     2707           ) .
     2708         assign
     2709           v-diasize-need-maximize = false
     2710         .
     2711       end.
     2712       else do:
     2713         run diasize_change-width in this-procedure
     2714           (input v-diasize-orig-frame-width
     2715               - frame Dialog-Frame :width-chars
     2716           ,input true
     2717           ) .
     2718         run diasize_change-height in this-procedure
     2719           (input v-diasize-orig-frame-height
     2720               - frame Dialog-Frame :height-chars
     2721           ,input true
     2722           ) .
     2723         assign
