      709   procedure prn-lib-open-stream :
      710     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      711     define input parameter p-page-size    as integer no-undo .
      712     define input parameter p-is-stream    as logical no-undo .
      713     define input parameter p-append       as logical no-undo .
      714     define variable v-report-name as character no-undo .
      715     do
      716       on error undo, return error
      717       :
      718       run prn-lib-get-report-name  in this-procedure (
      719         input parParentProc
      720         ,output v-report-name
      721         ).
      722       if p-is-stream then
      723       do:
      724         if p-append then
      725         do:
      726           output stream PrnLibStream to value( v-report-name )
      727             page-size value(p-page-size) append .
      728         end.
      729         if not p-append then
      730         do:
      731           output stream PrnLibStream to value( v-report-name )
      732             page-size value(p-page-size) .
      733         end.
      734       end.
      735       if not p-is-stream then
      736       do:
      737         if p-append then
      738         do:
      739           output to value( v-report-name )
      740             page-size value(p-page-size) append .
      741         end.
      742         if not p-append then
      743         do:
      744           output to value( v-report-name )
      745             page-size value(p-page-size) .
      746         end.
      747       end.
      748     end.
      749   end procedure.
      750   procedure prn-lib-open-exp :
      751     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      752     define input parameter p-is-stream    as logical no-undo .
      753     define input parameter p-is-append    as logical no-undo .
      754     define output parameter p-ReportFileName as char init "report" no-undo.
      755     define output parameter p-process as logical no-undo .
      756     define variable glog as logical no-undo .
      757     do
      758       on error undo, return error
      759       :
      760       SYSTEM-DIALOG GET-FILE p-ReportFileName
      761         TITLE      "Укажите путь"
      762         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      763         ASK-OVERWRITE
      764         CREATE-TEST-FILE
      765         SAVE-AS
      766         USE-FILENAME
      767         DEFAULT-EXTENSION "txt"
      768         UPDATE glog
      769         .
      770       if not glog then  return.
      771       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      772       if p-is-stream then
      773       do:
      774         if p-is-append then
      775         do:
      776           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      777         end.
      778         else
      779         do:
      780           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      781         end.
      782       end.
      783       else
      784       do:
      785         if p-is-append then
      786         do:
      787           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      788         end.
      789         else
      790         do:
      791           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      792         end.
      793       end.
      794       p-process = yes.
      795     end.
      796   end procedure.
