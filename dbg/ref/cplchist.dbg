     3215   def var sort-labelbr-plc-hist   as character no-undo .
     3216   def var sort-clmnbr-plc-hist    as handle    no-undo .
     3217   def var cur-clmnbr-plc-hist     as handle    no-undo .
     3218   def var cur-clmn-locbr-plc-hist as integer   no-undo .
     3219   def var re-querybr-plc-hist     as logical   initial no no-undo .
     3220   on start-search, ctrl-o of br-plc-hist in frame Dialog-Frame do:
     3221      run sort-brbr-plc-hist
     3222        (input (if available X_c-plc-hist
     3223                then recid(X_c-plc-hist)
     3224                else ?
     3225               )
     3226        ).
     3227   end.
     3228   PROCEDURE sort-brbr-plc-hist :
     3229     define input parameter p-recid as recid no-undo .
     3230     if re-querybr-plc-hist = no then do:
     3231       assign
     3232          cur-clmnbr-plc-hist = br-plc-hist:current-column in frame Dialog-Frame
     3233       .
     3234       if sort-clmnbr-plc-hist <> ? then sort-clmnbr-plc-hist:column-fgcolor = 0.
     3235       if cur-clmnbr-plc-hist = sort-clmnbr-plc-hist then do:
     3236         assign
     3237            sort-labelbr-plc-hist = ""
     3238            sort-clmnbr-plc-hist = ?
     3239         .
     3240        end.
     3241        else do:
     3242          assign
     3243            sort-labelbr-plc-hist = cur-clmnbr-plc-hist:label
     3244            sort-clmnbr-plc-hist  = cur-clmnbr-plc-hist
     3245            sort-clmnbr-plc-hist:column-fgcolor = 4
     3246          .
     3247        end.
     3248      end.
     3249     assign
     3250       cur-clmn-locbr-plc-hist = 1
     3251     .
     3252     def var column-handle as handle no-undo .
     3253     column-handle = br-plc-hist:first-column.
     3254     do while valid-handle(column-handle) :
     3255       if column-handle = cur-clmnbr-plc-hist then do:
     3256         leave .
     3257       end.
     3258       column-handle = column-handle:NEXT-COLUMN.
     3259       assign
     3260         cur-clmn-locbr-plc-hist = cur-clmn-locbr-plc-hist + 1
     3261       .
     3262     end.
     3263     case sort-labelbr-plc-hist:
     3264           when X_c-plc-hist.pl-code:label in browse br-plc-hist then DO:    assign       sort-column-name = "X_c-plc-hist.pl-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3265           when X_c-plc-hist.corr-date:label in browse br-plc-hist then DO:    assign       sort-column-name = "X_c-plc-hist.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3266           when X_c-plc-hist.corr-user-db-num:label in browse br-plc-hist then DO:    assign       sort-column-name = "X_c-plc-hist.corr-user-db-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3267       otherwise do:
     3268         assign
     3269           sort-column-name = ""
     3270         .
     3271         run OpenBr in this-procedure ( input yes, input no, input '':U).
     3272           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-plc-hist') then do:
     3273             run mv-brw-defaultbr-plc-hist.
     3274           end.
     3275         if sort-labelbr-plc-hist <> "" then do:
     3276           assign
     3277             cur-clmnbr-plc-hist:column-fgcolor = 0
     3278           .
     3279         end.
     3280         assign
     3281           cur-clmn-locbr-plc-hist = ?
     3282         .
     3283       end.
     3284     end case.
     3285       if cur-clmn-locbr-plc-hist <> ? then do:
     3286         if can-do( this-procedure:internal-entries, 'ch-clmnbr-plc-hist') then do:
     3287           run ch-clmnbr-plc-hist in this-procedure (cur-clmn-locbr-plc-hist).
     3288         end.
     3289       end.
     3290     if p-recid <> ? then do:
     3291       reposition br-plc-hist to recid p-recid no-error.
     3292       apply "value-changed" to br-plc-hist in frame Dialog-Frame.
     3293     end.
     3294     apply "entry" to br-plc-hist in frame Dialog-Frame.
     3295   END PROCEDURE.
     3296   procedure re-open-query-srt-clmnbr-plc-hist:
     3297   if cur-clmnbr-plc-hist = ? then do:
     3298      run OpenBr in this-procedure ( input yes, input no, input '':U).
     3299   end.
     3300   else do:
     3301      assign re-querybr-plc-hist = yes.
     3302      run sort-brbr-plc-hist
     3303        (input (if available X_c-plc-hist
     3304                then recid(X_c-plc-hist)
     3305                else ?
     3306               )
     3307        ).
     3308      assign re-querybr-plc-hist = no.
     3309   end.
     3310   end.
     3311   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3312   do:
     3313     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3314   end.
     3315   MAIN-BLOCK:
     3316   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3317      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3318      if p-mode <> 'все':U
     3319    and p-mode <> "one":U
     3320    and p-mode <> 'объект':U
     3321    and p-mode <> "subject":U
     3322    then dO:
     3323       message
     3324       vss-workfile vss-revision vss-description skip
     3325       "Неверное значение параметров вызова p-mode"
     3326       p-mode
     3327       view-as alert-box ERROR.
     3328       return.
     3329    end.
     3330    if p-mode = 'объект':U
     3331    or p-mode = "subject":U
     3332    then do:
     3333     find first X_clients no-lock
     3334       where X_clients.obj-type = p-obj-type
     3335         and X_clients.obj-code = p-obj-code
     3336       no-error.
     3337       if not available X_clients then do:
     3338         message
     3339           vss-workfile vss-revision vss-description skip
     3340           substitute( "Неверное значение параметра вызова.&1 Отсутствует объект &2 &3", chr(10), p-obj-type, p-obj-code)
     3341           view-as alert-box error.
     3342         return.
     3343       end.
     3344   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3345   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3346     (input  p-obj-type
     3347     ,input  p-obj-code
     3348     ,output v-host-code
     3349     )  .
     3350    end.
     3351    if p-mode = "one":U
     3352    or p-mode = "subject":U
     3353    then do:
     3354     find first X_place no-lock
     3355       where X_place.pl-code = p-pl-code
     3356       no-error.
     3357       if not available X_place then do:
     3358         message
     3359           vss-workfile vss-revision vss-description skip
     3360           substitute( "Неверное значение параметра вызова.&1 Отсутствует место хранения с кодом &2", chr(10), p-pl-code )
     3361           view-as alert-box error.
     3362         return.
     3363       end.
     3364     end.
     3365     if p-mode = "subject"  then do:
     3366       if p-subject = 'pl-gds':U
     3367       or p-subject = 'pl-gds-pump':U
     3368       then do:
     3369           find first X_goods no-lock
     3370             where X_goods.gds-code = p-gds-code
     3371             no-error .
     3372           if not available X_goods then do:
     3373             message
     3374               vss-workfile vss-revision vss-description skip
     3375               substitute( "Неверное значение параметра вызова.&1 Отсутствует товар с кодом &2", chr(10), p-gds-code )
     3376               view-as alert-box error.
     3377             return.
     3378           end.
     3379       end.
     3380     end.
     3381      v-rid-list = p-rid-list.
     3382     if v-rid-list <> "" then do:
     3383         find first find_c-plc-hist no-lock
     3384           where recid(find_c-plc-hist) = integer(entry(1, v-rid-list))
     3385           no-error.
     3386         if not available find_c-plc-hist then do:
     3387           message
     3388             vss-workfile vss-revision vss-description skip
     3389             "Неверное значение параметра вызова v-rid-list" v-rid-list
     3390             view-as alert-box error .
     3391           return error.
     3392         end.
     3393         v-doc-rec = integer(entry(1, v-rid-list)).
     3394       end.
     3395   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3396   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3397     (output v-db-num
     3398     )  .
     3399     if p-mode <> 'все':U then do:
     3400       assign
     3401       v-find = yes.
     3402       end.
     3403       else do:
     3404       assign
     3405       v-pl-name = get-place(p-obj-type, p-obj-code, p-pl-code)
     3406       .
