     3136        and
     3137        self :read-only = false
     3138        )
     3139     then do:
     3140       if self :handle <> focus :handle
     3141       then do:
     3142         apply "entry":u to self .
     3143       end.
     3144       define variable v-ok            as logical   no-undo .
     3145       define variable v-curr-sv-date  as date      no-undo .
     3146       define variable v-description   as character no-undo .
     3147       assign
