     1083   index
     1084   Chan
     1085   fnotChange
     1086   t_name
     1087   f_name
     1088   index imain uniq-key-rec
     1089   .
     1090   FUNCTION get-all-fields returns character (p-file-name as character ):
     1091   define variable v-dop as character no-undo .
     1092     find first _file no-lock where _file._file-name = p-file-name no-error .
     1093     if not available _file then return "":U.
     1094     for each _field no-lock where
     1095              _field._file-recid = recid(_file) :
     1096       assign
     1097       v-dop = v-dop + _field._field-name + chr(44)
     1098       .
     1099     end.
     1100     return trim(v-dop).
     1101   END FUNCTION.
     1102   PROCEDURE proc-full-temp-changes :
     1103     define input  parameter p-hst-handle as handle    no-undo .
     1104     define input  parameter p-main-table as character no-undo .
     1105     define input  parameter p-field-list as character no-undo .
     1106     define input  parameter p-label-form as character no-undo .
     1107     define variable h-new-buf         as handle    no-undo .
     1108     define variable h-main-buf        as handle    no-undo .
     1109     define variable h-for-comp        as handle    no-undo .
     1110     define variable v-inform          as character no-undo .
     1111     define variable v-ind             as integer   no-undo .
     1112     define variable v-idx-field-qnty  as integer   no-undo .
     1113     define variable v-num-entries     as integer   no-undo .
     1114     define variable fh                as handle    no-undo .
     1115     define variable fh-main           as handle    no-undo .
     1116     define variable fh-old            as handle    no-undo .
     1117     define variable fh-new            as handle    no-undo .
     1118     define variable v-field-name      as character no-undo .
     1119     define variable v-field-lvl       as character no-undo .
     1120     define variable v-field-form      as character no-undo .
     1121     define variable v-search-exp      as character no-undo .
     1122     define variable v-srch-main       as character no-undo .
     1123     define variable v-word-link       as character no-undo .
     1124     define variable v-av-chip-num     as logical   no-undo .
     1125     define variable v-main-pi-fld-lst as character no-undo .
     1126     define variable v-main-fld-lst    as character no-undo .
     1127     define variable v-delim-list      as character no-undo .
     1128     define variable v-label           as character no-undo .
     1129     define variable v-old-value       as character no-undo case-sensitive.
     1130     define variable v-new-value       as character no-undo case-sensitive.
     1131     define variable v-chg-fields as character no-undo.
     1132     for each temp-changes:
     1133       delete temp-changes.
     1134     end.
     1135     if not p-hst-handle:available then do:
     1136       return .
     1137     end.
     1138     create buffer h-new-buf  for table p-hst-handle .
     1139     create buffer h-main-buf for table p-main-table .
     1140     assign
     1141       v-inform = h-main-buf:index-information(1)
     1142       v-ind    = 2
     1143     .
     1144     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1145     on error undo, return error
     1146     :
     1147       assign
     1148         v-inform = h-main-buf:index-information( v-ind )
     1149         v-ind    = v-ind + 1
     1150       .
     1151     end.
     1152     if v-inform = ?
     1153       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1154       or entry( 3, v-inform, ",":U ) <> "1":U
     1155     then do:
     1156       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1157     end.
     1158     assign
     1159       v-idx-field-qnty = num-entries( v-inform ) - 4
     1160     .
     1161     if v-idx-field-qnty < 2 then do:
     1162       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1163     end.
     1164     assign
     1165       v-srch-main   = "where":U
     1166       v-word-link   = "":U
     1167       v-av-chip-num = false
     1168       v-delim-list  = "":U
     1169     .
     1170     do v-ind = 1 to v-idx-field-qnty by 2
     1171     on error undo, return error
     1172     :
     1173       assign
     1174         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1175         fh                = p-hst-handle:buffer-field( v-field-name )
     1176         fh-main           = h-main-buf:buffer-field( v-field-name )
     1177         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1178         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1179       .
     1180       if fh:data-type ="character":U then do:
     1181         assign
     1182           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1183         .
     1184       end.
     1185       else do:
     1186         assign
     1187           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1188         .
     1189       end.
     1190       if v-delim-list = "":U then do:
     1191         assign
     1192           v-delim-list = ",":U
     1193         .
     1194       end.
     1195       if v-word-link = "":U then do:
     1196         assign
     1197           v-word-link = "and":U
     1198         .
     1199       end.
     1200     end.
     1201     assign
     1202       v-delim-list  = "":U
     1203     .
     1204     do v-ind = 1 to h-main-buf:num-fields
     1205     on error undo, return error
     1206     :
     1207       assign
     1208         fh-main      = h-main-buf:buffer-field( v-ind )
     1209         v-field-name = fh-main:name
     1210       .
     1211         assign
     1212           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1213         .
     1214         if v-delim-list = "":U then do:
     1215           assign
     1216             v-delim-list = ",":U
     1217           .
     1218         end.
     1219     end.
     1220     assign
     1221       v-inform = p-hst-handle:index-information(1)
     1222       v-ind    = 2
     1223     .
     1224     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1225     on error undo, return error
     1226     :
     1227       assign
     1228         v-inform = p-hst-handle:index-information( v-ind )
     1229         v-ind    = v-ind + 1
     1230       .
     1231     end.
     1232     if v-inform = ?
     1233       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1234       or entry( 3, v-inform, ",":U ) <> "1":U
     1235     then do:
     1236       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1237     end.
     1238     assign
     1239       v-idx-field-qnty = num-entries( v-inform ) - 4
     1240     .
     1241     if v-idx-field-qnty < 2 then do:
     1242       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1243     end.
     1244     assign
     1245       v-search-exp  = "where":U
     1246       v-word-link   = "":U
     1247       v-av-chip-num = false
     1248     .
     1249     do v-ind = 1 to v-idx-field-qnty by 2
     1250     on error undo, return error
     1251     :
     1252       assign
     1253         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1254         fh           = p-hst-handle:buffer-field( v-field-name )
     1255         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1256       .
     1257       if v-field-name = "chip-num":U then do:
     1258         assign
     1259           v-search-exp  = substitute( "&1 >", v-search-exp )
     1260           v-av-chip-num = true
     1261         .
     1262       end.
     1263       else do:
     1264         assign
     1265           v-search-exp = substitute( "&1 =", v-search-exp )
     1266         .
     1267       end.
     1268       if fh:data-type ="character":U then do:
     1269         assign
     1270           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1271         .
     1272       end.
     1273       else do:
     1274         assign
     1275           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1276         .
     1277       end.
     1278       if v-word-link = "":U then do:
     1279         assign
     1280           v-word-link = "and":U
     1281         .
     1282       end.
     1283     end.
     1284     if v-av-chip-num = false then do:
     1285       message
     1286         vss-workfile vss-revision vss-description skip
     1287         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1288         "Использование данной процедуры невозможно!" skip
     1289         view-as alert-box error .
     1290       return error .
     1291     end.
     1292     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1293     if not h-new-buf:available then do:
     1294       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1295       if not h-main-buf:available then do:
     1296         assign
     1297           h-for-comp = ?
     1298         .
     1299       end.
     1300       else do:
     1301         assign
     1302           h-for-comp = h-main-buf
     1303         .
     1304       end.
     1305     end.
     1306     else do:
     1307       assign
     1308         h-for-comp = h-new-buf
     1309       .
     1310     end.
     1311     assign
     1312       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1313     .
     1314     do v-ind = 1 to v-num-entries
     1315     on error undo, return error return-value
     1316     :
     1317       assign
     1318         v-field-name = entry( v-ind, v-main-fld-lst )
     1319         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1320         v-old-value  = fh-old:buffer-value()
     1321         v-label      = trim( fh-old:label )
     1322       .
     1323       if ( trim( p-field-list ) <> "":U
     1324            and lookup( v-field-name, p-field-list ) > 0
     1325          )
     1326          or trim( p-field-list ) = "":U
     1327       then do:
     1328         if h-for-comp <> ? then do:
     1329           assign
     1330             fh-new      = h-for-comp:buffer-field( v-field-name )
     1331             v-new-value = fh-new:buffer-value()
     1332           .
     1333         end.
     1334         else do:
     1335           assign
     1336             v-new-value = "":U
     1337           .
     1338         end.
     1339         if v-old-value <> v-new-value
     1340         then do:
     1341           create temp-changes.
     1342           assign
     1343             temp-changes.t_name = p-main-table
     1344             temp-changes.f_name = v-field-name
     1345             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1346             temp-changes.v_old  = trim( v-old-value )
     1347             temp-changes.v_new  = trim( v-new-value )
     1348             temp-changes.num_   = 0
     1349             temp-changes.fNotChange = v-old-value eq v-new-value
     1350           .
     1351         end.
     1352       end.
     1353     end.
     1354     assign
     1355       v-num-entries = num-entries( p-label-form, chr(8) )
     1356     .
     1357     do v-ind = 1 to v-num-entries
     1358     on error undo, return error return-value
     1359     :
     1360       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1361         assign
     1362           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1363           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1364           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1365         .
     1366         find first temp-changes
     1367           where temp-changes.f_name = v-field-name
     1368           no-error .
     1369         if available temp-changes then do:
     1370           if trim( v-field-lvl ) <> "":U then do:
     1371             assign
     1372               temp-changes.l_name = v-field-lvl
     1373             .
     1374           end.
     1375           if trim( v-field-form ) <> "":U then do:
     1376             assign
     1377               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1378             .
     1379             if h-for-comp <> ? then do:
     1380               assign
     1381                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1382               .
     1383             end.
     1384           end.
     1385         end.
     1386       end.
     1387       else do:
     1388         message
     1389           vss-workfile vss-revision vss-description skip
     1390           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1391           substitute( "список для поля '&1': '&2'"
     1392                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1393                       ,entry( v-ind, p-label-form, chr(8) )
     1394                     ) skip
     1395           substitute( "полный список: &2", p-label-form ) skip
     1396           view-as alert-box error .
     1397       end.
     1398     end.
     1399     delete object h-new-buf .
     1400     delete object h-main-buf .
     1401   END PROCEDURE.
     1402   FUNCTION get-action RETURNS CHARACTER
     1403     ( p-action as integer )  FORWARD.
     1404   FUNCTION get-place RETURNS CHARACTER
     1405     ( p-obj-type as character, p-obj-code as integer, p-pl-code as integer )  FORWARD.
     1406   FUNCTION get-subject RETURNS CHARACTER
     1407     ( p-subject as character )  FORWARD.
     1408   DEFINE BUTTON B-Help
     1409        LABEL "Помо&щь"
     1410        SIZE 3 BY 1
     1411        BGCOLOR 8 .
     1412   DEFINE BUTTON B-lookup
     1413        LABEL "&Просмотр"
     1414        SIZE 10 BY 1.
     1415   DEFINE BUTTON B-mark
     1416        LABEL "&*"
     1417        SIZE 3 BY 1.
     1418   DEFINE BUTTON b-pl-gds-rest
     1419        LABEL "&Остатки"
     1420        SIZE 10 BY 1.
     1421   DEFINE BUTTON B-print
     1422        LABEL "Пе&чать"
     1423        SIZE 3 BY 1.
     1424   DEFINE BUTTON b-quit AUTO-END-KEY
     1425        LABEL "&Выход"
     1426        SIZE 10 BY 1
     1427        BGCOLOR 8 .
     1428   DEFINE BUTTON B-sch
     1429        LABEL "&Фильтр"
     1430        SIZE 3 BY 1.
     1431   DEFINE BUTTON b-sel AUTO-GO
     1432        LABEL "Вы&бор"
     1433        SIZE 10 BY 1
     1434        BGCOLOR 8 .
     1435   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1436         VIEW-AS TEXT
     1437        SIZE 6 BY 1
     1438        FGCOLOR 4  NO-UNDO.
     1439   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1440        LABEL "Дате изменения"
     1441        VIEW-AS FILL-IN
     1442        SIZE 11 BY 1 NO-UNDO.
     1443   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1444        LABEL "пользователю"
     1445        VIEW-AS FILL-IN
     1446        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1447   DEFINE VARIABLE sch-pl-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1448        LABEL "коду скл.места"
     1449        VIEW-AS FILL-IN
     1450        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1451   DEFINE QUERY BR-changes FOR
     1452         temp-changes SCROLLING.
     1453   DEFINE QUERY br-plc-hist FOR
     1454         X_c-plc-hist SCROLLING.
     1455   DEFINE BROWSE BR-changes
     1456     QUERY BR-changes DISPLAY
     1457         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1458   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1459   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1460       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1461   DEFINE BROWSE br-plc-hist
     1462     QUERY br-plc-hist NO-LOCK DISPLAY
     1463         mark-string(recid(X_c-plc-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1464         X_c-plc-hist.pl-code COLUMN-LABEL "Код скл.места" FORMAT "999999999":U
     1465         X_c-plc-hist.corr-date FORMAT "99/99/9999":U
     1466         string(X_c-plc-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1467         usrfulnf(X_c-plc-hist.corr-user-name) FORMAT "X(18)":U
     1468         get-action(X_c-plc-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1469         X_c-plc-hist.corr-user-db-num FORMAT ">>>>9":U
     1470         if v-find then get-place(X_c-plc-hist.obj-type, X_c-plc-hist.obj-code, X_c-plc-hist.pl-code) else "":U COLUMN-LABEL "Назв. складского места" FORMAT "X(25)":U
     1471         get-subject(X_c-plc-hist.subject) COLUMN-LABEL "Предмет изменений" FORMAT "X(15)":U
     1472         X_c-plc-hist.obj-type + string(X_c-plc-hist.obj-code) COLUMN-LABEL "Объект" FORMAT "X(8)":U
     1473     ENABLE
     1474         X_c-plc-hist.corr-DATE
     1475       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1476   DEFINE FRAME Dialog-Frame
     1477        b-quit AT ROW 1 COL 1
     1478        B-mark AT ROW 1 COL 11
     1479        b-sel AT ROW 1 COL 21
     1480        b-pl-gds-rest AT ROW 1 COL 55
     1481        B-print AT ROW 1 COL 89
     1482        B-sch AT ROW 1 COL 92
     1483        B-Help AT ROW 1 COL 95
     1484        B-lookup AT ROW 1.04 COL 45
     1485        br-plc-hist AT ROW 2 COL 1
     1486        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1487        sch-pl-code AT ROW 13.67 COL 56.13 COLON-ALIGNED
     1488        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1489        BR-changes AT ROW 14.79 COL 1
     1490        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1491        "ПОИСК ПО" VIEW-AS TEXT
     1492             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1493             FGCOLOR 4
     1494        SPACE(89.48) SKIP(7.44)
     1495       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1496            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1497            TITLE "Полная история по складскому месту"
     1498            CANCEL-BUTTON b-quit.
     1499   ASSIGN
     1500          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1501          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1502   ASSIGN
     1503          br-plc-hist:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1504   ON GO OF FRAME Dialog-Frame
     1505   DO:
     1506     p-rid-list = v-rid-list.
     1507   END.
     1508   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1509   DO:
     1510     APPLY "END-ERROR":U TO SELF.
     1511   END.
     1512   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1513   DO:
     1514     DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     1515     DEFINE BUFFER buf_c-place FOR ub.c-place.
     1516     DEFINE BUFFER buf_c-pl-gds FOR ub.c-pl-gds.
     1517     DEFINE BUFFER buf_c-pl-gds-pump FOR ub.c-pl-gds-pump.
     1518     DEFINE BUFFER buf_c-pl-pump FOR ub.c-pl-pump.
     1519     DEFINE BUFFER buf_c-pl-pump-nozzle FOR ub.c-pl-pump-nozzle.
     1520       IF AVAILABLE X_c-plc-hist THEN DO:
     1521       CASE X_c-plc-hist.subject:
     1522         WHEN 'place':U THEN DO:
     1523           find first buf_c-place no-lock where
     1524                  buf_c-place.obj-type = p-obj-type
     1525              AND buf_c-place.obj-code = p-obj-code
     1526              AND buf_c-place.pl-code = X_c-plc-hist.pl-code
     1527              AND buf_c-place.chip-num = X_c-plc-hist.chip-num
     1528              AND buf_c-place.corr-user-db-num = X_c-plc-hist.corr-user-db-num
     1529              no-error .
     1530              ASSIGN v-rec = RECID(buf_c-place).
     1531               run str/c-placea.w (
     1532                              INPUT 'ПРОСМОТР':U
     1533                             ,INPUT-OUTPUT v-rec) NO-ERROR.
     1534           END.
     1535         WHEN 'pl-gds':U THEN DO:
     1536           find first buf_c-pl-gds no-lock where
     1537                  buf_c-pl-gds.obj-type = p-obj-type
     1538              AND buf_c-pl-gds.obj-code = p-obj-code
     1539              AND buf_c-pl-gds.pl-code = X_c-plc-hist.pl-code
     1540              AND buf_c-pl-gds.chip-num = X_c-plc-hist.chip-num
     1541              AND buf_c-pl-gds.corr-user-db-num = X_c-plc-hist.corr-user-db-num
     1542              no-error .
     1543              ASSIGN v-rec = RECID(buf_c-pl-gds).
     1544               run str/cpl-gdsa.w (
     1545                              INPUT 'ПРОСМОТР':U
     1546                             ,INPUT-OUTPUT v-rec) NO-ERROR.
     1547         END.
     1548       END CASE.
     1549     END.
     1550   END.
     1551   ON ROW-DISPLAY OF BR-changes IN FRAME Dialog-Frame
     1552   DO:
     1553      if temp-changes.fNotChange
     1554      then do:
     1555         temp-changes.l_name:fGCOLOR in browse BR-changes = GRAY_COLOR.
     1556         temp-changes.v_old:fGCOLOR in browse BR-changes  = GRAY_COLOR.
     1557         temp-changes.v_new:fGCOLOR in browse BR-changes  = GRAY_COLOR.
     1558      end.
     1559      else do:
     1560         temp-changes.l_name:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1561         temp-changes.v_old:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1562         temp-changes.v_new:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1563      end.
     1564   END.
     1565   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1566   DO:
     1567   define variable loc#log as logical no-undo .
     1568     if available X_c-plc-hist then do:
     1569   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1570   define variable v-str-recid15 as character no-undo .
     1571   define variable v-num-entry15 as integer   no-undo .
     1572   assign
     1573     v-str-recid15 = trim( string( recid( X_c-plc-hist ) , "->>>>>>>>>>>9":U ) )
     1574     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1575   .
     1576   if v-num-entry15 > 0 then do:
     1577     assign
     1578       entry( v-num-entry15, v-rid-list ) = "":U
     1579       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1580     .
     1581   end.
     1582   else do:
     1583     assign
     1584       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1585     .
     1586   end.
     1587       loc#log = br-plc-hist:refresh() .
     1588       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1589           loc#log = br-plc-hist:select-next-row ().
     1590           apply "VALUE-CHANGED" to br-plc-hist in frame Dialog-Frame.
     1591       end.
     1592       if num-entries( v-rid-list ) = 0
     1593       then
     1594           hide mark-num in frame Dialog-Frame.
     1595       else
     1596           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1597     end.
     1598     apply "entry" to br-plc-hist in frame Dialog-Frame.
     1599   END.
     1600   ON CHOOSE OF b-pl-gds-rest IN FRAME Dialog-Frame
     1601   DO:
     1602     if not available X_c-plc-hist then return no-apply.
     1603     if p-mode = 'subject':U
     1604     and p-subject = 'pl-gds':U then do:
     1605       run ref/cplgdsob.w (
     1606                     input parparentproc
     1607                     ,input 'one':U
     1608                     ,input X_c-plc-hist.obj-type
     1609                     ,input X_c-plc-hist.obj-code
     1610                     ,input X_c-plc-hist.pl-code
     1611                     ,input X_c-plc-hist.gds-code
     1612                     ) no-error .
     1613     end.
     1614     else do:
     1615       run ref/cplgdsob.w (
     1616                     input parparentproc
     1617                     ,input 'place':U
     1618                     ,input X_c-plc-hist.obj-type
     1619                     ,input X_c-plc-hist.obj-code
     1620                     ,input X_c-plc-hist.pl-code
     1621                     ,input 0
     1622                     ) no-error .
     1623     end.
     1624   END.
