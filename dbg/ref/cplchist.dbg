     5140   END PROCEDURE.
     5141   PROCEDURE proc-b-print :
     5142   define variable date_string     as      char    no-undo.
     5143   define variable Line                as      char    no-undo.
     5144   define variable for-time as char.
     5145   define variable accum-count as integer.
     5146   define variable v-doc-rec as recid no-undo.
     5147   define variable v-prod as character no-undo .
     5148   define variable v-subject-chr as character no-undo .
     5149   define variable v-upd-time as character no-undo .
     5150   define variable v-obj as character no-undo .
     5151   define variable v-action-chr as character no-undo .
     5152   DEFINE VARIABLE v-for-user-name AS CHARACTER NO-UNDO.
     5153   DEFINE FRAME HistoryList
     5154   X_c-plc-hist.pl-code COLUMN-LABEL "Код скл.места"
     5155   v-action-chr FORMAT "X(10)" COLUMn-LABEL "Действие"
     5156   v-pl-name COLUMN-LABEL "Назв. складского места" FORMAT "X(20)"
     5157   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     5158   X_c-plc-hist.corr-date
     5159   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     5160   v-for-user-name  column-label "Изменил" format "X(18)"
     5161   X_c-plc-hist.corr-user-db-num
     5162   v-obj COLUMN-LABEL "Объект" FORMAT "X(8)"
     5163   HEADER  date_string AT 5 format "X(35)"
     5164   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5165   Line format "X(195)" AT 1
     5166   with width 232 down stream-io use-text    .
     5167   Line = fill("-", 195).
     5168   date_string = cur-time-print() .
     5169   assign
     5170   v-doc-rec = recid( X_c-plc-hist ).
     5171   DO WHILE available X_c-plc-hist :
     5172         GET prev br-plc-hist.
     5173   END.
     5174   run prn-lib-open-stream  in this-procedure (
     5175                                                input parparentProc
     5176                                               ,input 43
     5177                                               ,input yes
     5178                                               ,input no
     5179                                               ).
     5180   PUT  STREAM PrnLibStream
     5181   SPACE(25) ( frame Dialog-Frame:title )
     5182   format "x(90)" SKIP(1) .
     5183   FORM HEADER
     5184   Line format "X(180)" AT 1 SKIP
     5185   "Продолжение - на следующей странице" AT 30 SKIP
     5186   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5187   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5188   FORM with FRAME HistoryList  .
     5189   run waitfram-show in this-procedure (  input "Ждите...").
     5190     GET next br-plc-hist.
     5191       DO WHILE available X_c-plc-hist :
     5192         Display STREAM PrnLibStream
     5193         X_c-plc-hist.pl-code
     5194         get-action(X_c-plc-hist.action) @ v-action-chr
     5195         (if v-find then get-place(X_c-plc-hist.obj-type, X_c-plc-hist.obj-code, X_c-plc-hist.pl-code) else "":U )
     5196         @ v-pl-name
     5197         get-subject(X_c-plc-hist.subject) @ v-subject-chr
     5198         X_c-plc-hist.corr-date
     5199         string(X_c-plc-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     5200         usrfulnf(X_c-plc-hist.corr-user-name) @ v-for-user-name
     5201         X_c-plc-hist.corr-user-db-num
     5202         X_c-plc-hist.obj-type + string(X_c-plc-hist.obj-code) @ v-obj
     5203         with FRAME HistoryList .
     5204     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     5205     assign
     5206     accum-count = accum-count + 1
     5207     .
     5208     GET next br-plc-hist.
     5209   END.
     5210   UNDERLINE  STREAM PrnLibStream
     5211   X_c-plc-hist.pl-code
     5212   v-action-chr
     5213   v-pl-name
     5214   v-subject-chr
     5215   X_c-plc-hist.corr-date
     5216   v-upd-time
     5217   v-for-user-name
     5218   X_c-plc-hist.corr-user-db-num
     5219   v-obj
     5220   with FRAME HistoryList .
     5221   DISPLAY STREAM PrnLibStream
     5222   "ИТОГО"  @ X_c-plc-hist.pl-code
     5223   string(accum-count)  @ v-action-chr
     5224   with frame HistoryList.
     5225   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5226   HIDE  STREAM PrnLibStream FRAME CheckList.
     5227   output  STREAM PrnLibStream CLOSE.
     5228   run waitfram-hide in this-procedure.
     5229   run prn-lib-prn-file in this-procedure (
     5230                                             input parparentproc
     5231                                             ,input 8
     5232                                             ).
     5233   reposition br-plc-hist to recid v-doc-rec no-error.
     5234   apply "entry" to br-plc-hist in frame Dialog-Frame.
     5235   END PROCEDURE.
     5236   PROCEDURE proc-b-sch :
     5237   assign
     5238     tbl = 'c-plc-hist'
     5239     join-tbl = 'X_c-plc-hist'
     5240     fld = ""
     5241     lab = ""
     5242     spr = ""
     5243     dim = '0'
     5244     .
     5245   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', '',
     5246   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5247   run fltfield-add in this-procedure('pl-code', 'Код складского места', '',
     5248   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5249   run fltfield-add in this-procedure('corr-date', '', '',
     5250   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5251   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     5252   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5253   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     5254   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5255   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     5256   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5257   run fltfield-add in this-procedure('subject', 'Предмет изменения', 'plc-hist-subject',
     5258   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5259   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     5260   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5261   Filter-Block:
     5262   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5263       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5264       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5265     run gbl/filter.w ( INPUT parparentproc
     5266                       ,INPUT (filter-point + chr(4) + filter-label + chr(4) + 'yes':U)
     5267                       ,INPUT tbl
     5268                       ,INPUT join-tbl
     5269                       ,INPUT fld
     5270                       ,INPUT lab
     5271                       ,INPUT spr
     5272                       ,INPUT dim ).
     5273     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     5274   END.
     5275   END PROCEDURE.
     5276   PROCEDURE proc-br-plc-hist :
     5277   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5278   if b-sel:sensitive in frame Dialog-Frame then dO:
     5279       if b-mark:sensitive then do:
     5280           apply "choose" to b-mark in frame Dialog-Frame.
     5281       end.
     5282       else do:
     5283           apply "choose" to b-sel in frame Dialog-Frame.
     5284       end.
     5285   end.
     5286   else do:
     5287       if b-lookup:sensitive then
     5288       apply "choose" to b-lookup in frame Dialog-Frame.
     5289   end.
     5290   END PROCEDURE.
     5291   PROCEDURE proc-find-corr-date :
     5292   define input parameter p-next as logical no-undo.
     5293   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     5294   define variable v-date-chr as character no-undo.
     5295   if p-date = ? then return .
     5296   display
     5297   0 @ sch-pl-code
     5298   "":U @ sch-corr-user-name
     5299   with frame Dialog-Frame.
     5300   assign
     5301   v-date-chr = string(day(p-date)) + chr(47) +
     5302                    string(month(p-date)) + chr(47) +
     5303                    string(year(p-date)).
     5304          run OpenBr in this-procedure
     5305           (input false
     5306           ,input true
     5307           ,input substitute("and X_c-plc-hist.corr-date = &1 "
     5308             , v-date-chr)
     5309           ).
     5310         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     5311   END PROCEDURE.
     5312   PROCEDURE proc-find-pl-code :
     5313   define input parameter p-next as logical no-undo.
     5314   define input parameter p-pl-code like ub.c-plc-hist.pl-code no-undo.
     5315   define variable v-pl-code as character no-undo.
     5316   assign
     5317   sch-corr-date = ?.
     5318   display
     5319   "":U @ sch-corr-user-name
     5320   sch-corr-date
     5321   with frame Dialog-Frame.
     5322   assign
     5323   v-pl-code = string(p-pl-code).
     5324   run OpenBr in this-procedure
     5325       (input false
     5326       ,input p-next
     5327       ,input substitute("and X_c-plc-hist.pl-code = &1 "
     5328         , v-pl-code)
     5329       ).
     5330   apply "entry":u to sch-pl-code in frame Dialog-Frame .
     5331   END PROCEDURE.
     5332   PROCEDURE proc-find-user :
     5333   define input parameter p-next as logical no-undo.
     5334   define input parameter p-user like ub.c-plc-hist.corr-user-name no-undo.
     5335   assign
     5336   sch-corr-date = ?.
     5337   display
     5338   sch-corr-date
     5339   0 @ sch-pl-code
     5340   with frame Dialog-Frame.
     5341   p-user = chr(34) + p-user + chr(34).
     5342   run OpenBr in this-procedure
     5343       (input false
     5344       ,input p-next
     5345       ,input substitute("and X_c-plc-hist.corr-user-name = &1 "
     5346         , p-user)
     5347       ).
     5348   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     5349   END PROCEDURE.
     5350   PROCEDURE proc-view-changes :
     5351   define variable v-description as character no-undo .
     5352   for each temp-changes:
     5353       delete temp-changes.
     5354   END.
     5355   if not available X_c-plc-hist then do:
     5356     Open QUery br-changes for each temp-changes.
     5357     return.
     5358   end.
     5359   run ref/cplchisv.p (
     5360                      input X_c-plc-hist.obj-type
     5361                     ,input X_c-plc-hist.obj-code
     5362                     ,input X_c-plc-hist.pl-code
     5363                     ,input X_c-plc-hist.chip-num
     5364                     ,input X_c-plc-hist.corr-user-db-num
     5365                     ,input X_c-plc-hist.subject
     5366                     ,input X_c-plc-hist.action
     5367                     ,input no
     5368                     ,output v-description
     5369                  ) no-error .
     5370   Open QUery br-changes for each temp-changes.
     5371   assign
     5372   br-changes:title in frame Dialog-Frame = v-description
     5373   .
     5374   END PROCEDURE.
     5375   FUNCTION get-action RETURNS CHARACTER
     5376     ( p-action as integer ) :
     5377     define variable dops as character no-undo.
     5378   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     5379   RETURN dops.
     5380   END FUNCTION.
     5381   FUNCTION get-place RETURNS CHARACTER
     5382     ( p-obj-type as character, p-obj-code as integer, p-pl-code as integer ) :
     5383   define buffer buf_place for ub.place.
     5384   find first buf_place no-lock where
     5385             buf_place.obj-type = p-obj-type
     5386        AND  buf_place.obj-code = p-obj-code
     5387        AND  buf_place.pl-code = p-pl-code no-error.
     5388   if not available buf_place then do:
     5389       return "!!! Неизвестное складское место!!!".
     5390   end.
     5391     RETURN buf_place.pl-name.
     5392   END FUNCTION.
     5393   FUNCTION get-subject RETURNS CHARACTER
     5394     ( p-subject as character ) :
     5395     RETURN entry (lookup (p-subject, 'place,pl-gds,pl-gds-pump,pl-pump,pl-pump-nozzle,place-attr':U), 'Складское место,Товар на складском месте,Товар на ТРК,Резервуар/ТРК,Резервуар/ТРК/Пистолет,Атрибут Скл. места':U).
     5396   END FUNCTION.
