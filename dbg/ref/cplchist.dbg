      690       End.
      691       run gbl/prnfilen.w
      692         (input  ""
      693         ,input  p-DisabledOptions
      694         ,input  string(v-report-name )
      695         ,input  7
      696         ,output v-user-action
      697         ,output v-printed
      698         ) .
      699       if v-printed then
