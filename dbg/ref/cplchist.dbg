      663   define  stream PrnLibStream.
      664   procedure prn-lib-prn-file :
      665     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      666     define input parameter p-DIsabledoptions as integer no-undo .
      667     define variable v-report-name as character no-undo .
      668     define variable v-user-action as character no-undo .
      669     define variable v-printed     as logical   no-undo .
      670     define variable v-exist       as logical   no-undo .
