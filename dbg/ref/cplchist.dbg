      131   end.
      132   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   define variable c-point  as character no-undo .
      134   define variable tbl      as character no-undo .
      135   define variable join-tbl as character no-undo .
      136   define variable fld      as character no-undo .
      137   define variable lab      as character no-undo .
      138   define variable spr      as character no-undo .
      139   define variable dim      as character no-undo .
      140   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      141   procedure cur-time :
      142      define output parameter p-today as date      no-undo .
      143      define output parameter p-time  as integer   no-undo .
      144     do
      145     on error undo, return error
      146     :
      147       define variable v-date1 as date      no-undo .
      148       define variable v-date2 as date      no-undo .
      149       define variable v-time  as integer   no-undo .
      150       assign
      151         v-date1 = today
      152         v-time  = time
      153         v-date2 = today
      154       .
      155       if v-date1 <> v-date2
      156       then do:
      157         assign
      158           v-date1 = today
      159           v-time  = v-time
      160         .
      161       end.
      162       assign
      163         p-today = v-date1
      164         p-time  = v-time
      165       .
      166     end.
      167   end.
      168   function cur-time-date returns character
      169   :
      170     return string(today, '99/99/9999':U) .
      171   end.
      172   function cur-time-mjd returns decimal
      173   :
      174     define variable v-date as date      no-undo .
      175     define variable v-time as integer   no-undo .
      176     run cur-time in this-procedure
      177       (output v-date
      178       ,output v-time
      179       ) .
      180     return integer(v-date) - 2400002 + (v-time / 86400) .
      181   end.
      182   function cur-time-get-ending-index returns integer
      183   (input p-number as integer
      184   )
      185   :
      186     if p-number < 0
      187     or p-number = ?
      188     then do:
      189       return 1 .
      190     end.
      191     define variable v-rest as integer   no-undo .
      192     assign
      193       p-number = p-number modulo 100
      194     .
      195     if p-number < 20
      196     then do:
      197       assign
      198         v-rest = p-number
      199       .
      200     end.
      201     else do:
      202       assign
      203         v-rest = p-number modulo 10
      204       .
      205     end.
      206     case v-rest :
      207       when 1
      208       then do:
      209         return 2 .
      210       end.
      211       when 2 or
      212       when 3 or
      213       when 4
      214       then do:
      215         return 3 .
      216       end.
      217       otherwise do:
      218         return 1 .
      219       end.
      220     end case .
      221   end.
      222   procedure cur-time-mjd-to-date :
      223      define input  parameter i-mjd-diff as decimal no-undo.
      224      define output parameter o-Date     as date    no-undo.
      225      define output parameter o-Time     as integer no-undo.
      226      define variable v-day-number as integer   no-undo .
      227      if    i-mjd-diff < 0
      228         or i-mjd-diff = ?
      229      then do:
      230         return "?" .
      231      end.
      232      assign
      233         v-day-number = truncate(i-mjd-diff,0).
      234         o-Date = date(v-day-number + 2400002).
      235         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      236     .
      237   end.
      238   function cur-time-mjd-to-string returns character
      239   (input p-mjd-diff as decimal
      240   )
      241   :
      242     define variable v-day-number as integer   no-undo .
      243     define variable v-seconds    as integer   no-undo .
      244     define variable v-hour       as integer   no-undo .
      245     define variable v-min        as integer   no-undo .
      246     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      247     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      248     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      249     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      250     if p-mjd-diff < 0
      251     or p-mjd-diff = ?
      252     then do:
      253       return "?" .
      254     end.
      255     assign
      256       v-day-number = integer(truncate(p-mjd-diff,0))
      257       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      258     .
      259     if v-seconds > 86400
      260     then do:
      261       assign
      262         v-seconds = 86400 - 1
      263       .
      264     end.
      265     if v-seconds < 0
      266     then do:
      267       assign
      268         v-seconds = 0
      269       .
      270     end.
      271     assign
      272       v-hour = truncate(v-seconds / 3600, 0)
      273     .
      274     assign
      275       v-seconds = v-seconds modulo 3600
      276     .
      277     assign
      278       v-min = truncate(v-seconds / 60, 0)
      279     .
      280     assign
      281       v-seconds = v-seconds modulo 60
      282     .
      283     return
      284         (if v-day-number <> 0
      285           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      286           else ""
      287         )
      288       + (if v-day-number <> 0 or v-hour <> 0
      289           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      290           else ""
      291         )
      292       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      293           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      294           else ""
      295         )
      296       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      297       .
      298   end.
      299   function cur-time-string returns character
      300   :
      301     define variable v-date as date      no-undo .
      302     define variable v-time as integer   no-undo .
      303     run cur-time in this-procedure
      304       (output v-date
      305       ,output v-time
      306       ) .
      307     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      308   end.
      309   function cur-time-string-sec returns character
      310   :
      311     define variable v-date as date      no-undo .
      312     define variable v-time as integer   no-undo .
      313     run cur-time in this-procedure
      314       (output v-date
      315       ,output v-time
      316       ) .
      317     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      318   end.
      319   function cur-time-custom  returns character
      320   (input p-prefix as character
      321   ,input p-date-format as character
      322   ,input p-delimiter as character
      323   ,input p-time-format as character
      324   ,input p-suffix as character
      325   )
      326   :
      327     define variable v-date as date      no-undo .
      328     define variable v-time as integer   no-undo .
      329     run cur-time in this-procedure
      330       (output v-date
      331       ,output v-time
      332       ) .
      333     return
      334       p-prefix
      335       + string(v-date, p-date-format)
      336       + p-delimiter
      337       + string(v-time, p-time-format)
      338       + p-suffix
      339       .
      340   end.
      341   function cur-time-print  returns character
      342   :
      343     define variable v-date as date      no-undo .
      344     define variable v-time as integer   no-undo .
      345     run cur-time in this-procedure
      346       (output v-date
      347       ,output v-time
      348       ) .
      349     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      350   end.
      351   function cur-time-datetime returns datetime
      352   :
      353     define variable v-char as character no-undo .
      354     define variable v-datetime as datetime no-undo .
      355     v-char = cur-time-string().
      356     v-datetime = datetime(v-char).
      357     return  v-datetime.
      358   end.
      359   function cur-time-string-msec returns character
      360   :
      361     define variable v-date as datetime  no-undo .
      362     v-date = now.
      363     return string(v-date) .
      364   end.
      365   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      366   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      367   define new shared variable RepPathName        as character no-undo .
      368   define new shared variable PrintRubl          as logical   no-undo .
      369   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      370   define variable v-waitfram-action01         as character   no-undo .
      371   define variable v-waitfram-action02         as character   no-undo .
      372   define variable v-waitfram-action03         as character   no-undo .
      373   define variable mWaitFramTextBeg            as character   no-undo.
      374   define variable mWaitFramTextEnd            as character   no-undo.
      375   define variable mWaitFramView               as logical     no-undo.
      376   define variable mWaitProcEvent              as logical     no-undo init yes.
      377   define variable mWaitFramInterval           as integer     no-undo init 1 .
      378   define variable mWaitFramStop               as logical     no-undo.
      379   define variable mWaitFramStopUser           as logical     no-undo.
      380   define variable mWaitFramStopTimeOut        as logical     no-undo.
      381   define variable mWaitFramStartProc          as datetime-tz no-undo.
      382   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      383   define button B-WaitFramStop auto-end-key
      384        label "Стоп"
      385        size 10 by 1 tooltip "Остоновить процесс".
      386   define button B-viewProcInfo
      387        label "Информация"
      388        size 15 by 1 tooltip "Информация о процесс".
      389   define frame waitfram
      390     v-waitfram-action01 format "x(72)" no-label skip
      391     v-waitfram-action02 format "x(72)" no-label skip
      392     v-waitfram-action03 format "x(72)" no-label skip
      393     B-viewProcInfo
      394     B-WaitFramStop at row 4 col 30
      395     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      396     .
      397   define new global shared variable mBatchMode as logical no-undo init ?.
      398   define variable mFramBachModHandle as handle no-undo.
      399   mFramBachModHandle = frame waitfram:handle.
      400   define variable mFameOldVis as logical no-undo.
      401   define variable mVisCUrentVin as logical no-undo.
      402   if session:batch-mode
      403   then
      404      mBatchMode = yes.
      405   if mBatchMode = ? then do:
      406     mVisCUrentVin = current-window:visible.
      407     mFameOldVis = mFramBachModHandle:visible.
      408     mFramBachModHandle:visible  = yes.
      409     mBatchMode = mFramBachModHandle:visible ne yes.
      410     mFramBachModHandle:visible = mFameOldVis.
      411     current-window:visible = mVisCUrentVin.
      412   end.
      413    if  log-manager:logfile-name ne ?
      414     then DO:
      415         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      416         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      417         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      418     end.
      419   on choose of B-WaitFramStop in frame waitfram
      420   do:
      421     mWaitFramStop = yes.
      422     mWaitFramStopUser = yes.
      423   end.
      424   function waitfram-check-timeout returns logical():
      425      define variable vtime as int64 no-undo.
      426      if mWaitFramStopTimeOut
      427      then
      428         return yes.
      429      vtime = ( now - mWaitFramStartProc ) / 1000 .
      430      if     mWaitFramTimeOut ne ?
      431         and mWaitFramTimeOut ne 0
      432         and mWaitFramTimeOut lt vtime
      433      then do:
      434         mWaitFramStopTimeOut = yes.
      435      end.
      436      return mWaitFramStopTimeOut.
      437   end.
      438   procedure waitfram-hide :
      439     if not session:batch-mode
      440     then do
      441     on error undo, return error return-value
      442     :
      443       pause 0 before-hide .
      444       if not mBatchMode then
      445         hide frame waitfram .
      446     if     not mWaitFramView
      447        and mWaitProcEvent
      448     then
      449       process events .
      450     end.
      451   end procedure.
      452   procedure waitfram-show :
      453     define input  parameter p-message as character no-undo .
      454     define variable v-left-margin as integer   no-undo .
      455     if not session:batch-mode
      456     then do
      457     on error undo, return error return-value
      458     :
      459       if length(p-message) <= 70 then do:
      460         assign
      461           v-left-margin = integer((70 - length(p-message)) / 2)
      462         .
      463         assign
      464           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      465         .
      466         assign
      467           v-waitfram-action01 = " "
      468           v-waitfram-action02 = " "
      469                                    + fill(" ", v-left-margin)
      470                                    + p-message
      471           v-waitfram-action03 = " "
      472         .
      473       end.
      474       else do:
      475         define variable vRindex1 as integer no-undo.
      476         define variable vRindex2 as integer no-undo.
      477         vRindex1 = r-index(p-message," ",70).
      478         if vRindex1 = 0
      479         then
      480            vRindex1 = 70.
      481         if length(p-message)  <= vRindex1 + 70 then do:
      482           assign
      483             v-waitfram-action01 = " "
      484             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      485             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      486           .
      487         end.
      488         else do:
      489           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      490           if vRindex2 <= vRindex1
      491           then
      492              vRindex2 = vRindex1 + 70.
      493           assign
      494             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      495             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      496             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      497           .
      498         end.
      499       end.
      500       B-viewProcInfo:visible   in frame waitfram = no.
      501       B-viewProcInfo:sensitive in frame waitfram = no.
      502       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      503       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      504       if  (   mWaitFramView
      505          or  mWaitProcEvent)
      506          and not mBatchMode
      507       then
      508          display
      509             v-waitfram-action01 skip
      510             v-waitfram-action02 skip
      511             v-waitfram-action03 skip
      512          with frame waitfram .
      513       if     mWaitFramView
      514          then do:
      515             if     mWaitFramInterval ne ?
      516                and not mBatchMode
      517             then
      518                wait-for go of frame waitfram pause mWaitFramInterval.
      519          end.
      520          else
      521             if     mWaitProcEvent
      522                and not mBatchMode
      523             then
      524                process events .
      525     end.
      526   end procedure.
      527      procedure waitfram-show-this:
      528         define input  parameter iInterval as int64 no-undo.
      529         define variable vtime as int64 no-undo.
      530         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      531         mWaitFramInterval = iInterval.
      532         run waitfram-show (substitute("&1&2 &3&4" ,
      533                                       mWaitFramTextBeg ,
      534                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      535                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      536                                       mWaitFramTextEnd
      537                                      )
      538                           ).
      539      end.
      540      procedure WaitFramRunPause:
      541         define input  parameter iInterval as dec no-undo.
      542         define variable vStart  as datetime-tz no-undo.
      543         define variable vend    as datetime-tz no-undo.
      544         define variable vint as int64 no-undo.
      545         define variable vOk as logical no-undo.
      546         vStart = now.
      547         vend   = vStart.
      548         publish "WaitFramPause" (iInterval,output vOk).
      549         vend   =  now.
      550         vint = vend - vStart.
      551         vint = iInterval - vint / 1000.
      552         if     not mWaitFramStop
      553            and (   vint > 0
      554                 or (    not vOk
      555                     and iInterval eq ?
      556                     )
      557                 )
      558         then
      559            run waitfram-show-this (iInterval).
      560         vend   =  now.
      561         vint = vend - vStart.
      562         vint = iInterval - vint / 1000.
      563         if     not mWaitFramStop
      564            and vint > 0
      565         then do:
      566            run gbl/pause.p (vint * 1000).
      567         end.
      568         if iInterval ne ?
      569         then
      570            publish "WaitFramStop".
      571         waitfram-check-timeout().
      572      end.
      573      procedure WaitFramWaitFor:
      574         define input  parameter iInterval as dec no-undo.
      575         assign
      576            mWaitFramStartProc   = now
      577            mWaitFramStopUser    = no
      578            mWaitFramStopTimeOut = no
      579         .
      580         block-wait:
      581         do while not mWaitFramStop:
      582            run WaitFramRunPause (iInterval).
      583            if  waitfram-check-timeout()
      584            then do:
      585               leave block-wait.
      586            end.
      587         end.
      588         run waitfram-hide.
      589      end.
      590   procedure waitfram-join :
      591     define input  parameter p-line-1  as character no-undo .
      592     define input  parameter p-line-2  as character no-undo .
      593     define input  parameter p-line-3  as character no-undo .
      594     define output parameter p-message as character no-undo .
      595     do
      596     on error undo, return error return-value
      597     :
      598       assign
      599         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      600                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      601                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      602       .
      603     end.
      604   end procedure.
      605   function waitfram-join-function returns character
      606     (input p-line-1 as character
      607     ,input p-line-2 as character
      608     ,input p-line-3 as character
      609     ).
      610     define variable v-message as character no-undo .
      611     run waitfram-join in this-procedure
      612       (input  p-line-1
      613       ,input  p-line-2
      614       ,input  p-line-3
      615       ,output v-message
      616       ) .
      617     return v-message .
      618   end function .
      619   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      620   procedure fltfield-clear :
      621     define output parameter loc-fld as character no-undo.
      622     define output parameter loc-lab as character no-undo .
      623     define output parameter loc-spr as character no-undo .
      624     define output parameter loc-dim as character no-undo .
      625     assign
      626       loc-fld = ""
      627       loc-lab = ""
      628       loc-spr = ""
      629       loc-dim = "0"
      630     .
      631   end procedure .
      632   procedure fltfield-add :
      633     define input        parameter par-fld as character no-undo.
      634     define input        parameter par-lab as character no-undo .
      635     define input        parameter par-spr as character no-undo .
      636     define input-output parameter loc-fld as character no-undo.
      637     define input-output parameter loc-lab as character no-undo .
      638     define input-output parameter loc-spr as character no-undo .
      639     define input-output parameter loc-dim as character no-undo .
      640     do
      641     on error undo, return error
      642     :
      643       assign
      644       loc-fld = if loc-dim = '0'
      645                 then par-fld
      646                 else (loc-fld + chr(44) + par-fld)
      647       loc-lab = if loc-dim = '0'
      648                 then par-lab
      649                 else (loc-lab + chr(44) + par-lab)
      650       loc-spr = if loc-dim = '0'
      651                 then par-spr
      652                 else (loc-spr + chr(44) + par-spr)
      653       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      654                 string(integer(if num-entries(loc-dim) > 1
      655                               then entry(2, loc-dim)
      656                               else entry(1, loc-dim)
      657                               ) + 1)
      658       no-error
      659       .
      660     end.
      661   end procedure.
