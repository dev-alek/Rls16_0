     3515   PROCEDURE MyEnable :
     3516   assign
     3517     br-plc-hist:num-locked-columns in frame Dialog-Frame = 1
     3518     X_c-plc-hist.corr-DATE:read-only in browse br-plc-hist = yes
     3519     br-changes:title = "":U
     3520     temp-changes.l_name:resizable in browse br-changes = true
     3521     temp-changes.v_old:resizable in browse br-changes = true
     3522     temp-changes.v_new:resizable in browse br-changes = true
