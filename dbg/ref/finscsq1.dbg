      645       OPEN QUERY br-fin-statement FOR EACH X_fin-statement
      646         where  TRUE
      647         indexed-reposition
      648     .
      649         assign
      650           l-query-was-opened = true
      651         .
      652     end.
      653   end.
      654   else do:
      655     assign
      656       v-doc-rec = recid( X_fin-statement )
      657     .
      658     do
      659     on stop undo, leave
      660     on error undo, leave
      661     :
      662       if QUERY br-fin-statement:handle:get-buffer-handle(1) = (buffer X_fin-statement:handle) then do:
      663         assign
      664         parameter-2-5 = (if p-find-next then "true":u else "false":u )
      665         parameter-4-5 =
      666           "where ":u + " TRUE " + " ":u + where-phrase-5 + " ":u + p-find-condition + " " + ""
      667         parameter-5-5 = "  "
      668       .
      669         run fltopend_fltfindd in this-procedure  (
      670                             input this-procedure:handle
      671                             ,input QUERY br-fin-statement:handle
      672                             ,input rowid(X_fin-statement)
      673                             ,input logical(parameter-2-5)
      674                             ,input no-lock
      675                             ,input (buffer X_fin-statement:handle)
      676                             ,input parameter-4-5
