      633         message
      634           "Ошибка при фильтрации / сортировке" skip
      635           "Будут показаны записи без учета фильтра" skip
      636           view-as alert-box .
      637       end.
      638       else do:
      639           assign
      640             l-query-was-opened = true
      641           .
      642       end.
      643     end.
