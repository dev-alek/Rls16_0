      522   PROCEDURE Set-filter-name :
      523   define input parameter v-filter-name as character no-undo .
      524     assign
      525     p-filter-name = v-filter-name
      526     .
      527   END PROCEDURE.
      528   run proc-main in this-procedure .
      529   procedure proc-main :
      530     do
      531     on error undo, return error
      532     :
      533   case sort-column-name :
      534     when "" then do:
      535       assign
      536         sort-column-phrase = ""
      537       .
      538     end.
      539     otherwise do:
      540       assign
      541         sort-column-phrase = "by " + sort-column-name
      542       .
      543     end.
      544   end case.
      545   define variable l-open-query as logical   no-undo .
      546     CASE p-mode :
      547       WHEN 'все':U        THEN DO:
      548   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
