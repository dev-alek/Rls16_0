        1   block-level on error undo, throw.
        2   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
        3   define input  parameter p-open-query     as logical   no-undo .
        4   define input  parameter p-find-next      as logical   no-undo .
        5   define input  parameter p-find-condition as character no-undo .
        6   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        7   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo.
        8   define input parameter p-mode  as char   no-undo .
        9   define input parameter p-host-code like ub.fin-statement.host-code no-undo .
       10   define input parameter p-status_ like ub.fin-statement.status_ no-undo.
       11   define input parameter p-fins-doc-type like ub.fin-statement.fins-doc-type no-undo.
       12   define input parameter p-fins-ext-doc-type like ub.fin-statement.fins-ext-doc-type no-undo.
       13   define input parameter p-start-date   like ub.fin-statement.doc-date no-undo .
       14   define input parameter p-end-date   like ub.fin-statement.doc-date no-undo .
       15   define input parameter p-code-bank like ub.fin-statement.code-bank no-undo.
       16   define input parameter p-code-schet like ub.fin-statement.code-schet no-undo.
       17   define input parameter p-curr-code like ub.fin-statement.curr-code no-undo.
       18   define input-output param p-rid-list    as  character no-undo .
       19   define input parameter filter-point as character no-undo .
       20   define input parameter filter-point0 as character no-undo .
       21   define input parameter sort-column-name as character no-undo .
       22   define output parameter p-filter-name   as character  no-undo .
       23   define input-output parameter v-doc-rec as recid no-undo .
       24   define variable vss-revision    as character no-undo init "$Revision$":U .
       25   define variable vss-author      as character no-undo init "$Author$":U .
       26   define variable vss-date        as character no-undo init "$Date$":U .
       27   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       28   define variable vss-archive     as character no-undo init "$Archive$":U .
       29   define variable vss-description as character no-undo init "Список выписок  - открытие запроса".
       30   procedure vss-get-info :
       31     define output parameter p-vss-revision    like vss-revision    no-undo .
       32     define output parameter p-vss-author      like vss-author      no-undo .
       33     define output parameter p-vss-date        like vss-date        no-undo .
       34     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       35     define output parameter p-vss-archive     like vss-archive     no-undo .
       36     define output parameter p-vss-description like vss-description no-undo .
       37     assign
       38       p-vss-revision    = vss-revision
       39       p-vss-author      = vss-author
       40       p-vss-date        = vss-date
       41       p-vss-workfile    = vss-workfile
       42       p-vss-archive     = vss-archive
       43       p-vss-description = vss-description
       44     .
       45   end procedure.
       46   procedure vss-get-parameters :
       47     define output parameter p-vss-parameters as character no-undo .
       48   end procedure.
       49   define new global shared variable g#vssrevis-logger as handle    no-undo .
       50   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       51   define variable v-vssrevis-logger                   as handle    no-undo .
       52   procedure vss-logevent :
       53     define input  parameter p-extra-paramters as character no-undo .
       54     define variable v-vssrevis-parameters as character no-undo .
       55     do
       56     on error undo, return error return-value
       57     :
       58       if  valid-handle(v-vssrevis-logger)
       59       and v-vssrevis-logger :get-signature("logevent") <> ""
       60       then do:
       61         run vss-get-parameters in this-procedure
       62           (output v-vssrevis-parameters
       63           ).
       64         run logevent in v-vssrevis-logger
       65           (input vss-workfile
       66           ,input vss-revision
       67           ,input v-vssrevis-parameters
       68           ,input p-extra-paramters
       69           ).
       70       end.
       71     end.
       72   end procedure.
       73   assign
       74     v-vssrevis-logger = g#vssrevis-logger
       75   .
       76   if  valid-handle(v-vssrevis-logger)
       77   and v-vssrevis-logger :get-signature("logevent") <> ""
       78   then do:
       79     assign
       80       v-vssrevis-logevent = true
       81     .
       82     run vss-logevent in this-procedure (input vss-description) .
       83   end.
       84   define new global shared variable g#language as character no-undo .
       85   if g#language <> '' and g#language <> 'rus':U then do:
       86     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       87   end.
       88   define new global shared variable g#library  as handle no-undo .
       89   define new global shared variable g#library2 as handle no-undo .
       90   define   shared variable g#auto as logical no-undo.
       91   define   shared variable g#news as logical no-undo.
       92   define   shared variable g#oxml as logical no-undo.
       93   define   shared variable g#esys as logical no-undo.
       94   define   shared variable g#news-source-db as integer no-undo.
       95   define   shared variable g#esys-source-esys as integer no-undo.
       96   define   shared variable g#db-num as integer   no-undo .
       97   define   shared variable g#userid as character no-undo .
       98   define   shared variable g#passwd as character no-undo .
       99   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   define variable v-waitfram-action01         as character   no-undo .
      101   define variable v-waitfram-action02         as character   no-undo .
      102   define variable v-waitfram-action03         as character   no-undo .
      103   define variable mWaitFramTextBeg            as character   no-undo.
      104   define variable mWaitFramTextEnd            as character   no-undo.
      105   define variable mWaitFramView               as logical     no-undo.
      106   define variable mWaitProcEvent              as logical     no-undo init yes.
      107   define variable mWaitFramInterval           as integer     no-undo init 1 .
      108   define variable mWaitFramStop               as logical     no-undo.
      109   define variable mWaitFramStopUser           as logical     no-undo.
      110   define variable mWaitFramStopTimeOut        as logical     no-undo.
      111   define variable mWaitFramStartProc          as datetime-tz no-undo.
      112   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      113   define button B-WaitFramStop auto-end-key
      114        label "Стоп"
      115        size 10 by 1 tooltip "Остоновить процесс".
      116   define button B-viewProcInfo
      117        label "Информация"
      118        size 15 by 1 tooltip "Информация о процесс".
      119   define frame waitfram
      120     v-waitfram-action01 format "x(72)" no-label skip
      121     v-waitfram-action02 format "x(72)" no-label skip
      122     v-waitfram-action03 format "x(72)" no-label skip
      123     B-viewProcInfo
      124     B-WaitFramStop at row 4 col 30
      125     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      126     .
      127   define new global shared variable mBatchMode as logical no-undo init ?.
      128   define variable mFramBachModHandle as handle no-undo.
      129   mFramBachModHandle = frame waitfram:handle.
      130   define variable mFameOldVis as logical no-undo.
      131   define variable mVisCUrentVin as logical no-undo.
      132   if session:batch-mode
      133   then
      134      mBatchMode = yes.
      135   if mBatchMode = ? then do:
      136     mVisCUrentVin = current-window:visible.
      137     mFameOldVis = mFramBachModHandle:visible.
      138     mFramBachModHandle:visible  = yes.
      139     mBatchMode = mFramBachModHandle:visible ne yes.
      140     mFramBachModHandle:visible = mFameOldVis.
      141     current-window:visible = mVisCUrentVin.
      142   end.
      143    if  log-manager:logfile-name ne ?
      144     then DO:
      145         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      146         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      147         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      148     end.
      149   on choose of B-WaitFramStop in frame waitfram
      150   do:
      151     mWaitFramStop = yes.
      152     mWaitFramStopUser = yes.
      153   end.
      154   function waitfram-check-timeout returns logical():
      155      define variable vtime as int64 no-undo.
      156      if mWaitFramStopTimeOut
      157      then
      158         return yes.
      159      vtime = ( now - mWaitFramStartProc ) / 1000 .
      160      if     mWaitFramTimeOut ne ?
      161         and mWaitFramTimeOut ne 0
      162         and mWaitFramTimeOut lt vtime
      163      then do:
      164         mWaitFramStopTimeOut = yes.
      165      end.
      166      return mWaitFramStopTimeOut.
      167   end.
      168   procedure waitfram-hide :
      169     if not session:batch-mode
      170     then do
      171     on error undo, return error return-value
      172     :
      173       pause 0 before-hide .
      174       if not mBatchMode then
      175         hide frame waitfram .
      176     if     not mWaitFramView
      177        and mWaitProcEvent
      178     then
      179       process events .
      180     end.
      181   end procedure.
      182   procedure waitfram-show :
      183     define input  parameter p-message as character no-undo .
      184     define variable v-left-margin as integer   no-undo .
      185     if not session:batch-mode
      186     then do
      187     on error undo, return error return-value
      188     :
      189       if length(p-message) <= 70 then do:
      190         assign
      191           v-left-margin = integer((70 - length(p-message)) / 2)
      192         .
      193         assign
      194           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      195         .
      196         assign
      197           v-waitfram-action01 = " "
      198           v-waitfram-action02 = " "
      199                                    + fill(" ", v-left-margin)
      200                                    + p-message
      201           v-waitfram-action03 = " "
      202         .
      203       end.
      204       else do:
      205         define variable vRindex1 as integer no-undo.
      206         define variable vRindex2 as integer no-undo.
      207         vRindex1 = r-index(p-message," ",70).
      208         if vRindex1 = 0
      209         then
      210            vRindex1 = 70.
      211         if length(p-message)  <= vRindex1 + 70 then do:
      212           assign
      213             v-waitfram-action01 = " "
      214             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      215             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      216           .
      217         end.
      218         else do:
      219           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      220           if vRindex2 <= vRindex1
      221           then
      222              vRindex2 = vRindex1 + 70.
      223           assign
      224             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      225             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      226             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      227           .
      228         end.
      229       end.
      230       B-viewProcInfo:visible   in frame waitfram = no.
      231       B-viewProcInfo:sensitive in frame waitfram = no.
      232       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      233       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      234       if  (   mWaitFramView
      235          or  mWaitProcEvent)
      236          and not mBatchMode
      237       then
      238          display
      239             v-waitfram-action01 skip
      240             v-waitfram-action02 skip
      241             v-waitfram-action03 skip
      242          with frame waitfram .
      243       if     mWaitFramView
      244          then do:
      245             if     mWaitFramInterval ne ?
      246                and not mBatchMode
      247             then
      248                wait-for go of frame waitfram pause mWaitFramInterval.
      249          end.
      250          else
      251             if     mWaitProcEvent
      252                and not mBatchMode
      253             then
      254                process events .
      255     end.
      256   end procedure.
      257      procedure waitfram-show-this:
      258         define input  parameter iInterval as int64 no-undo.
      259         define variable vtime as int64 no-undo.
      260         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      261         mWaitFramInterval = iInterval.
      262         run waitfram-show (substitute("&1&2 &3&4" ,
      263                                       mWaitFramTextBeg ,
      264                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      265                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      266                                       mWaitFramTextEnd
      267                                      )
      268                           ).
      269      end.
      270      procedure WaitFramRunPause:
      271         define input  parameter iInterval as dec no-undo.
      272         define variable vStart  as datetime-tz no-undo.
      273         define variable vend    as datetime-tz no-undo.
      274         define variable vint as int64 no-undo.
      275         define variable vOk as logical no-undo.
      276         vStart = now.
      277         vend   = vStart.
      278         publish "WaitFramPause" (iInterval,output vOk).
      279         vend   =  now.
      280         vint = vend - vStart.
      281         vint = iInterval - vint / 1000.
      282         if     not mWaitFramStop
      283            and (   vint > 0
      284                 or (    not vOk
      285                     and iInterval eq ?
      286                     )
      287                 )
      288         then
      289            run waitfram-show-this (iInterval).
      290         vend   =  now.
      291         vint = vend - vStart.
      292         vint = iInterval - vint / 1000.
      293         if     not mWaitFramStop
      294            and vint > 0
      295         then do:
      296            run gbl/pause.p (vint * 1000).
      297         end.
      298         if iInterval ne ?
      299         then
      300            publish "WaitFramStop".
      301         waitfram-check-timeout().
      302      end.
      303      procedure WaitFramWaitFor:
      304         define input  parameter iInterval as dec no-undo.
      305         assign
      306            mWaitFramStartProc   = now
      307            mWaitFramStopUser    = no
      308            mWaitFramStopTimeOut = no
      309         .
      310         block-wait:
      311         do while not mWaitFramStop:
      312            run WaitFramRunPause (iInterval).
      313            if  waitfram-check-timeout()
      314            then do:
      315               leave block-wait.
      316            end.
      317         end.
      318         run waitfram-hide.
      319      end.
      320   procedure waitfram-join :
      321     define input  parameter p-line-1  as character no-undo .
      322     define input  parameter p-line-2  as character no-undo .
      323     define input  parameter p-line-3  as character no-undo .
      324     define output parameter p-message as character no-undo .
      325     do
      326     on error undo, return error return-value
      327     :
      328       assign
      329         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      330                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      331                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      332       .
      333     end.
      334   end procedure.
      335   function waitfram-join-function returns character
      336     (input p-line-1 as character
      337     ,input p-line-2 as character
      338     ,input p-line-3 as character
      339     ).
      340     define variable v-message as character no-undo .
      341     run waitfram-join in this-procedure
      342       (input  p-line-1
      343       ,input  p-line-2
      344       ,input  p-line-3
      345       ,output v-message
      346       ) .
      347     return v-message .
      348   end function .
      349   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      350   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      351   procedure fltopend_fltopend :
      352   define input parameter p-parent-handle as handle no-undo .
      353   define input parameter p-qh as handle no-undo .
      354   define input parameter p-flt-open-open-query  as character no-undo .
      355   define input parameter p-where-cond as character no-undo .
      356   define input parameter p-use-indFIRST-query-tail as character no-undo .
      357   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      358   define input parameter p-indexed-reposition as character no-undo .
      359     do
      360     on error undo, return error
      361     :
      362   define variable v-prepare-string as character no-undo .
      363   define variable glog as logical no-undo .
      364   assign
      365   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      366                      p-where-cond + chr(32)  +
      367                      p-use-indFIRST-query-tail + chr(32) +
      368                      p-use-ind-sort-clmn-by + chr(32) +
      369                      p-indexed-reposition
      370   .
      371   assign
      372   glog = p-qh:query-prepare(v-prepare-string) no-error .
      373   if not glog
      374   or error-status:error then do:
      375     message error-status:get-message(1) view-as alert-box .
      376     undo, return error .
      377   end.
      378   assign
      379   glog = p-qh:query-open no-error .
      380   if not glog
      381   or error-status:error then do:
      382     message error-status:get-message(1) view-as alert-box .
      383     undo, return error .
      384   end.
      385     end.
      386   end procedure.
      387   procedure fltopend_fltfindd :
      388   define input parameter p-parent-handle as handle no-undo .
      389   define input parameter p-qh as handle no-undo .
      390   define input parameter p-rowid as rowid no-undo .
      391   define input parameter p-next as logical no-undo .
      392   define input parameter p-lock as integer no-undo .
      393   define input parameter p-bh as handle no-undo .
      394   define input parameter p-where-cond as character no-undo .
      395   define input parameter p-use-index-phrase as character no-undo .
      396   define variable glog as logical no-undo .
      397   define variable v-qh as handle no-undo .
      398   define variable v-bh as handle no-undo .
      399   define variable v-recid as recid no-undo .
      400   define variable v-prepare-string as character no-undo .
      401   do
      402   on error undo, return error
      403   on stop undo, return error
      404   :
      405     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      406     create buffer v-bh for table p-bh buffer-name p-bh:name.
      407     create query v-qh.
      408     v-qh:set-buffers(v-bh).
      409     v-prepare-string = substitute("for each &1 &2 &3"
      410                                     ,v-bh:name
      411                                     ,p-where-cond
      412                                     ,p-use-index-phrase).
      413     glog = v-qh:query-prepare(v-prepare-string) no-error.
      414     if not glog then do:
      415       delete object v-qh.
      416       delete object v-bh.
      417       undo, return error .
      418     end.
      419     glog = v-qh:query-open no-error .
      420     if not glog then do:
      421       delete object v-qh.
      422       delete object v-bh.
      423       undo, return error .
      424     end.
      425     if p-next then do:
      426       v-qh:reposition-to-rowid(p-rowid) no-error .
      427       glog = v-qh:get-next( p-lock) no-error .
      428       glog = v-qh:get-next( p-lock) no-error .
      429       if not glog or v-qh:query-off-end = yes then do:
      430         glog = v-qh:get-first( p-lock) no-error .
      431       end.
      432     end.
      433     else do:
      434       glog = v-qh:get-first( p-lock) no-error .
      435     end.
      436     v-recid = v-bh:recid no-error .
      437     delete object v-qh.
      438     delete object v-bh.
      439     return string(v-recid) .
      440   end.
      441   end procedure.
      442   procedure fltopend_fltfindq :
      443   define input parameter p-parent-handle as handle no-undo .
      444   define input parameter p-qh as handle no-undo .
      445   define input parameter p-next as logical no-undo .
      446   define input parameter p-lock as integer no-undo .
      447   define input parameter p-flt-open-open-query  as character no-undo .
      448   define input parameter p-where-cond as character no-undo .
      449   define input parameter p-use-indFIRST-query-tail as character no-undo .
      450   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      451   define input parameter p-indexed-reposition as character no-undo .
      452   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      453   define variable glog as logical no-undo .
      454   define variable v-qh as handle no-undo .
      455   define variable v-bh as handle no-undo extent 18.
      456   define variable v-rowid as rowid no-undo extent 18.
      457   define variable v-ii as integer no-undo .
      458   define variable v-prepare-string as character no-undo .
      459   do
      460   on error undo, return error
      461   on stop undo, return error
      462   :
      463     create query v-qh.
      464     do v-ii = 1 to p-qh:num-buffers:
      465       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      466       assign
      467       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      468       no-error.
      469       v-qh:add-buffer(v-bh[v-ii]).
      470     end.
      471     assign
      472     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      473                       p-where-cond + chr(32)  +
      474                       p-use-indFIRST-query-tail + chr(32) +
      475                       p-use-ind-sort-clmn-by + chr(32) +
      476                       p-indexed-reposition
      477     .
      478     glog = v-qh:query-prepare( v-prepare-string) no-error .
      479     if not glog then do:
      480       delete object v-qh.
      481       do v-ii = 1 to p-qh:num-buffers:
      482         delete object v-bh[v-ii].
      483       end.
      484       undo, return error .
      485     end.
      486     glog = v-qh:query-open no-error .
      487     if not glog then do:
      488       delete object v-qh.
      489       do v-ii = 1 to p-qh:num-buffers:
      490         delete object v-bh[v-ii].
      491       end.
      492       undo, return error .
      493     end.
      494     if p-next then do:
      495       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      496       glog = v-qh:get-next( p-lock) no-error .
      497       glog = v-qh:get-next( p-lock) no-error .
      498       if not glog or v-qh:query-off-end = yes then do:
      499         glog = v-qh:get-first( p-lock) no-error .
      500       end.
      501     end.
      502     else do:
      503       glog = v-qh:get-first( p-lock) no-error .
      504     end.
      505     do v-ii = 1 to p-qh:num-buffers:
      506       assign
      507       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      508       no-error.
      509     end.
      510     delete object v-qh.
      511     do v-ii = 1 to p-qh:num-buffers:
      512       delete object v-bh[v-ii].
      513     end.
      514   end.
      515   end procedure.
      516   DEFINE SHARED BUFFER X_fin-statement FOR ub.fin-statement.
      517   DEFINE SHARED QUERY br-fin-statement FOR
      518         X_fin-statement SCROLLING.
      519   define variable v-list-cond as character no-undo.
      520   define variable  l-query-was-opened as logical no-undo .
