      722                             ,output v-fltopend-rowid
      723                             ) no-error.
      724         .
      725         v-doc-rec = ?.
      726       end.
      727       assign
      728         l-query-was-opened = true
      729       .
      730     end.
      731   end.
      732     run waitfram-hide in this-procedure .
