      566     ,output where-phrase-rus-5
      567     ,output sort-phrase-rus-5
      568     ).
      569   if p-open-query then do:
      570       run set-filter-name in this-procedure
      571         (INPUT filter-name-5
      572         ) no-error .
      573     assign
      574       l-filter-open-5 = false
      575     .
      576     if flt-rec-5 <> ?
      577       or sort-column-phrase > ""
      578     then do:
      579       define variable  parameter-2-5 as character no-undo .
      580       define variable  parameter-3-5 as character no-undo .
      581       define variable  parameter-4-5 as character no-undo .
      582       define variable  parameter-5-5 as character no-undo .
      583       define variable  parameter-6-5 as character no-undo .
      584       define variable  parameter-7-5 as character no-undo .
      585         assign
      586         parameter-3-5 =
      587                                 "FOR EACH X_fin-statement"
      588         parameter-4-5 =
      589           (
      590             if (" TRUE " + " " + where-phrase-5) <> ""
      591             then " TRUE " + " " + where-phrase-5
      592             else "true"
      593           )
      594         parameter-5-5 = (" " + "" + " " + "")
      595         parameter-6-5 = if sort-phrase-5 = ''
      596                              then
      597           (
      598           " " + "  " +
      599             " " + sort-column-phrase +
      600           " " + "  "
      601           )
      602                              else
      603           (
      604           " " + "  " +
      605             " " + sort-column-phrase +
      606           " " + sort-phrase-5
      607           )
      608         parameter-7-5 =
      609           " indexed-reposition  "
      610       .
      611       do
      612       on stop undo, leave
      613       on error undo, leave
      614       :
      615         assign
      616           l-disable-where-5 =
      617             (" TRUE " + " " + where-phrase-5 = "")
      618         .
