      702           )
      703                              else
      704           (
      705           " " + "  " +
      706             " " + sort-column-phrase +
      707           " " + sort-phrase-5
      708           )
      709         parameter-7-5 =
      710           " indexed-reposition  "
      711       .
      712         run fltopend_fltfindq in this-procedure  (
      713                             input this-procedure:handle
      714                             ,input QUERY br-fin-statement:handle
