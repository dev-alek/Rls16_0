        1   define variable vss-revision    as character no-undo init "$Revision$":U .
        2   define variable vss-author      as character no-undo init "$Author$":U .
        3   define variable vss-date        as character no-undo init "$Date$":U .
        4   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        5   define variable vss-archive     as character no-undo init "$Archive$":U .
        6   define variable vss-description as character no-undo init "Диалог создания записей в справочнике товаров во внешней системе ".
        7   define input  parameter parparentproc as widget-handle no-undo.
        8   define output parameter  v-rid as recid no-undo .
        9   define variable one-goods as logical no-undo.
       10   define variable char-gds-code as character no-undo.
       11       DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
       12      define variable ref-list as char no-undo.
       13       DEFINE VARIABLE v-ok AS logical NO-UNDO.
       14       define variable v-esys-id as integer no-undo .
       15       define variable v-value-character as character no-undo init "".
       16       define variable v-uniq-key-rec as character no-undo .
       17       define variable v-esys-uniq-key-rec as character no-undo .
       18       define variable v-tbl-row as rowid no-undo .
       19       define variable v-tbl-name as character no-undo .
       20       define buffer buf_gds-grp for ub.gds-grp.
       21       define buffer buf_ext-system for ub.ext-system.
       22       define variable cursorr  as integer no-undo init 0.
       23     define variable code_goods_name as character no-undo.
       24       define variable v-list      as character no-undo.
       25       define variable p-goods-gds  as integer no-undo.
       26       define variable p-name-goods as char no-undo.
       27       define variable i as integer   no-undo .
       28           define variable v-grp           as character    no-undo .
       29       define variable v-grp-recid     as recid        no-undo.
       30   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       31   define new global shared variable g#language as character no-undo .
       32   if g#language <> '' and g#language <> 'rus':U then do:
       33     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       34   end.
       35   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       36   procedure gen-key-rec :
       37     define input  parameter p-tbl-name    as character no-undo.
       38     define input  parameter p-bh_tbl-name as handle    no-undo.
       39     define output parameter p-key-rec     as character no-undo.
       40     do
       41     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       42     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       43     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       44     :
       45       define variable fh               as handle    no-undo .
       46       define variable v-ok             as logical   no-undo .
       47       define variable v-inform         as character no-undo .
       48       define variable v-ind            as integer   no-undo .
       49       define variable v-idx-field-qnty as integer   no-undo .
       50       if p-tbl-name = ?
       51         or p-tbl-name = "":U
       52       then do:
       53         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info1 ).
       54       end.
       55       if not p-bh_tbl-name:available then do:
       56         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info1, p-tbl-name ).
       57       end.
       58       assign
       59         p-key-rec = p-tbl-name
       60         v-inform  = p-bh_tbl-name:index-information(1)
       61         v-ind     = 2
       62       .
       63       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
       64       on error undo, return error
       65       :
       66         assign
       67           v-inform = p-bh_tbl-name:index-information( v-ind )
       68           v-ind    = v-ind + 1
       69         .
       70       end.
       71       if v-inform = ?
       72         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
       73         or entry( 3, v-inform, ",":U ) <> "1":U
       74       then do:
       75         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, p-tbl-name ).
       76       end.
       77       else do:
       78         assign
       79           v-idx-field-qnty = num-entries( v-inform ) - 4
       80         .
       81         if v-idx-field-qnty < 2 then do:
       82           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, p-tbl-name ).
       83         end.
       84         do v-ind = 1 to v-idx-field-qnty by 2
       85         on error undo, return error
       86         :
       87           assign
       88             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
       89             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
       90           .
       91         end.
       92       end.
       93       if p-key-rec = ? then do:
       94         assign
       95           p-key-rec = "":U
       96         .
       97         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info1, p-tbl-name ).
       98       end.
       99     end.
      100     return.
      101   end procedure.
      102   procedure gen-where-keyr-tab :
      103     define input  parameter i-tableSerach as character no-undo.
      104     define input  parameter i-tablekey   as character  no-undo.
      105     define input  parameter p-key-rec    as character  no-undo.
      106     define input  parameter p-key-handle as handle     no-undo .
      107     define input  parameter p-db-name    as character  no-undo .
      108     define input  parameter p-tt-handle  as handle     no-undo .
      109     define output parameter o-Where      as character  no-undo.
      110     do
      111     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      112     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      113     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      114     :
      115       define variable v-full-tbl-name  as character no-undo .
      116       define variable bh_tbl-name      as handle    no-undo .
      117       define variable fh_key           as handle    no-undo .
      118       define variable fh_search        as handle    no-undo .
      119       define variable v-field-num      as integer   no-undo .
      120       define variable v-count-fld      as integer   no-undo .
      121       define variable v-inform         as character no-undo .
      122       define variable v-ind            as integer   no-undo .
      123       define variable v-idx-field-qnty as integer   no-undo .
      124       define variable v-field-name     as character no-undo .
      125       define variable v-field-val      as character no-undo .
      126       define variable v-word-link      as character no-undo .
      127       define variable vTable           as character no-undo.
      128       define variable bh_tbl-key       as handle    no-undo .
      129       assign
      130         p-key-rec = trim( p-key-rec )
      131       .
      132       if p-key-handle <> ? then do:
      133         if not valid-handle(p-key-handle)
      134            or p-key-handle:type <> "buffer"
      135         then do:
      136           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info1 ).
      137         end.
      138         if num-entries( p-key-rec, chr(3) ) > 1
      139           or p-key-rec = ?
      140           or p-key-rec = "":U
      141         then do:
      142           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info1, p-key-rec ).
      143         end.
      144       end.
      145       else do:
      146         if p-key-rec = ?
      147           or p-key-rec = "":U
      148         then do:
      149           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      150         end.
      151       end.
      152       assign
      153         vTable = entry( 1 , p-key-rec, chr(3) )
      154       .
      155       if p-tt-handle <> ?
      156         and ( not valid-handle(p-tt-handle)
      157               or p-tt-handle:type <> "buffer"
      158             )
      159       then do:
      160         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info1, vTable, chr(10) ).
      161       end.
      162       if p-tt-handle = ? then do:
      163         assign
      164           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      165         .
      166         create buffer bh_tbl-name for table v-full-tbl-name .
      167       end.
      168       else do:
      169         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      170       end.
      171       assign
      172         v-inform = bh_tbl-name:index-information(1)
      173         v-ind    = 2
      174       .
      175       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      176       on error undo, return error
      177       :
      178         assign
      179           v-inform = bh_tbl-name:index-information( v-ind )
      180           v-ind    = v-ind + 1
      181         .
      182       end.
      183       if v-inform = ?
      184         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      185         or entry( 3, v-inform, ",":U ) <> "1":U
      186       then do:
      187         delete object bh_tbl-name no-error.
      188         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info1, vTable ).
      189       end.
      190       assign
      191         v-idx-field-qnty = num-entries( v-inform ) - 4
      192       .
      193       if v-idx-field-qnty < 2 then do:
      194         delete object bh_tbl-name no-error.
      195         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, vTable ).
      196       end.
      197       assign
      198         o-where     = "where":U
      199         v-word-link = "":U
      200         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      201         v-count-fld = 0
      202       .
      203       if i-tablekey ne "" and i-tablekey ne ?
      204       then do:
      205         assign
      206           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      207         .
      208         create buffer bh_tbl-key for table v-full-tbl-name .
      209       end.
      210       if i-tableSerach ne "" and i-tableSerach ne ?
      211       then do:
      212         delete object bh_tbl-name no-error.
      213         assign
      214           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      215         .
      216         create buffer bh_tbl-name for table v-full-tbl-name .
      217       end.
      218       block_where:
      219       do v-ind = 1 to v-idx-field-qnty by 2
      220       on error undo, return error
      221       :
      222         assign
      223           v-count-fld = v-count-fld + 1
      224         .
      225         if p-key-handle = ?
      226           and v-count-fld > v-field-num
      227         then do:
      228           leave block_where.
      229         end.
      230         define variable VfieldKeyTable as handle no-undo.
      231         assign
      232           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      233           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      234         .
      235         if     bh_tbl-key ne ?
      236         then do:
      237            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      238            if VfieldKeyTable eq ?
      239            then next block_where.
      240         end.
      241         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      242         then
      243            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      244         else
      245            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      246         if p-key-handle = ? then do:
      247           assign
      248             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      249           .
      250         end.
      251         else do:
      252           assign
      253             fh_key = p-key-handle:buffer-field( v-field-name )
      254           .
      255           if fh_key = ?
      256             or not valid-handle( fh_key )
      257           then do:
      258             delete object bh_tbl-name.
      259             if     bh_tbl-key ne ?
      260             then
      261                delete object bh_tbl-key.
      262             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info1, p-key-handle:name, v-field-name ).
      263           end.
      264           assign
      265             v-field-val = fh_key:buffer-value
      266           .
      267         end.
      268         if fh_search:data-type ="character":U then do:
      269           assign
      270             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      271             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      272             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      273             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      274             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      275             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      276             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      277             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      278             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      279             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      280             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      281             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      282             v-field-val = substitute( '"&1"', v-field-val )
      283           .
      284         end.
      285         assign
      286           o-where = substitute( "&1 &2", o-where, v-field-val )
      287         .
      288         if v-word-link = "":U then do:
      289           assign
      290             v-word-link = "and":U
      291           .
      292         end.
      293       end.
      294       delete object bh_tbl-name.
      295       if     bh_tbl-key ne ?
      296       then
      297          delete object bh_tbl-key.
      298       if p-key-handle = ?
      299         and v-count-fld <> v-field-num
      300       then do:
      301         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info1, vTable ).
      302       end.
      303     end.
      304   end procedure.
      305   procedure gen-hn-keyr-tab :
      306     define input  parameter i-tableSerach as character no-undo.
      307     define input  parameter i-tablekey   as character no-undo.
      308     define input  parameter p-key-rec    as character no-undo.
      309     define input  parameter p-key-handle as handle    no-undo .
      310     define input  parameter p-db-name    as character no-undo .
      311     define input  parameter p-tt-handle  as handle    no-undo .
      312     define input  parameter p-stts-lock  as integer   no-undo .
      313     define output parameter o-hn         as handle    no-undo.
      314     define variable v-full-tbl-name as character no-undo.
      315     define variable v-where         as character no-undo.
      316     define variable bh_tbl-name     as handle    no-undo.
      317     define variable vTable          as character no-undo.
      318     do
      319     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      320     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      321     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      322         run gen-where-keyr-tab(i-tableSerach,
      323                                i-tablekey,
      324                                p-key-rec,
      325                                p-key-handle,
      326                                p-db-name,
      327                                p-tt-handle,
      328                                output v-where).
      329         if i-tableSerach ne "" and i-tableSerach ne ?
      330         then do:
      331            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      332            create buffer bh_tbl-name for table v-full-tbl-name .
      333         end.
      334         else do:
      335            if p-tt-handle = ? then do:
      336               assign
      337                  vTable = entry( 1 , p-key-rec, chr(3) )
      338               .
      339               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      340               create buffer bh_tbl-name for table v-full-tbl-name .
      341            end.
      342            else do:
      343               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      344            end.
      345         end.
      346         if p-tt-handle = ? then do:
      347            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      348         end.
      349         else do:
      350            bh_tbl-name:find-first( v-where ) no-error .
      351         end.
      352         o-hn = bh_tbl-name.
      353      end.
      354   end procedure.
      355   procedure gen-hn-keyr :
      356     define input  parameter p-key-rec    as character no-undo.
      357     define input  parameter p-key-handle as handle    no-undo .
      358     define input  parameter p-db-name    as character no-undo .
      359     define input  parameter p-tt-handle  as handle    no-undo .
      360     define input  parameter p-stts-lock  as integer   no-undo .
      361     define output parameter o-hn         as handle    no-undo.
      362     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      363   end.
      364   procedure gen-row-keyr :
      365     define input  parameter p-key-rec    as character no-undo.
      366     define input  parameter p-key-handle as handle    no-undo .
      367     define input  parameter p-db-name    as character no-undo .
      368     define input  parameter p-tt-handle  as handle    no-undo .
      369     define input  parameter p-stts-lock  as integer   no-undo .
      370     define output parameter p-tbl-row    as rowid     no-undo.
      371     define output parameter p-tbl-name   as character no-undo.
      372     define variable vHn as handle no-undo.
      373       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      374       p-tbl-row = if vHn:available then vHn:rowid else ?.
      375       p-tbl-name =  vHn:table.
      376       delete object vHn no-error.
      377     if p-tbl-row = ? then do:
      378       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info1, p-tbl-name, p-key-rec ).
      379     end.
      380     else do:
      381       return.
      382     end.
      383   end procedure.
      384   procedure gen-key-fv :
      385     define input  parameter p-key-rec    as character no-undo .
      386     define output parameter p-field-list as character no-undo .
      387     define output parameter p-value-list as character no-undo.
      388     do
      389     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      390     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      391     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      392     :
      393       define variable v-full-tbl-name  as character no-undo .
      394       define variable bh_tbl-name      as handle    no-undo .
      395       define variable v-tbl-name       as character no-undo .
      396       define variable v-field-num      as integer   no-undo .
      397       define variable v-count-fld      as integer   no-undo .
      398       define variable v-inform         as character no-undo .
      399       define variable v-ind            as integer   no-undo .
      400       define variable v-idx-field-qnty as integer   no-undo .
      401       define variable v-delim-key      as character no-undo .
      402       if p-key-rec = ?
      403         or p-key-rec = "":U
      404       then do:
      405         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info1 ).
      406       end.
      407       assign
      408         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      409         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      410       .
      411       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      412       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info1 ).
      413       assign
      414         v-inform = bh_tbl-name:index-information(1)
      415         v-ind    = 2
      416       .
      417       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      418       on error undo, return error
      419       :
      420         assign
      421           v-inform = bh_tbl-name:index-information( v-ind )
      422           v-ind    = v-ind + 1
      423         .
      424       end.
      425       if v-inform = ?
      426         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      427         or entry( 3, v-inform, ",":U ) <> "1":U
      428       then do:
      429         delete object bh_tbl-name no-error.
      430         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      431       end.
      432       assign
      433         v-idx-field-qnty = num-entries( v-inform ) - 4
      434       .
      435       if v-idx-field-qnty < 2 then do:
      436         delete object bh_tbl-name no-error.
      437         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      438       end.
      439       assign
      440         p-field-list = "":U
      441         p-value-list = "":U
      442         v-delim-key  = "":U
      443         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      444         v-count-fld  = 0
      445       .
      446       block_where:
      447       do v-ind = 1 to v-idx-field-qnty by 2
      448       on error undo, return error
      449       :
      450         assign
      451           v-count-fld = v-count-fld + 1
      452         .
      453         if v-count-fld > v-field-num then do:
      454           leave block_where.
      455         end.
      456         assign
      457           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      458           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      459         .
      460         if v-ind = 1 then do:
      461           assign
      462             v-delim-key = chr(3)
      463           .
      464         end.
      465       end.
      466       delete object bh_tbl-name.
      467       if v-count-fld <> v-field-num then do:
      468         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info1, v-tbl-name ).
      469       end.
      470     end.
      471   end procedure.
      472   procedure gen-key-field :
      473     define input  parameter p-table      as character no-undo .
      474     define output parameter p-field-list as character no-undo .
      475     do
      476     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      477     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      478     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      479     :
      480       define variable v-full-tbl-name  as character no-undo .
      481       define variable bh_tbl-name      as handle    no-undo .
      482       define variable v-tbl-name       as character no-undo .
      483       define variable v-field-num      as integer   no-undo .
      484       define variable v-count-fld      as integer   no-undo .
      485       define variable v-inform         as character no-undo .
      486       define variable v-ind            as integer   no-undo .
      487       define variable v-idx-field-qnty as integer   no-undo .
      488       define variable v-delim-key      as character no-undo .
      489       if p-table = ?
      490         or p-table = "":U
      491       then do:
      492         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info1 ).
      493       end.
      494       assign
      495         v-tbl-name      = p-table
      496         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      497       .
      498       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      499       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info1 ).
      500       assign
      501         v-inform = bh_tbl-name:index-information(1)
      502         v-ind    = 2
      503       .
      504       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      505       on error undo, return error
      506       :
      507         assign
      508           v-inform = bh_tbl-name:index-information( v-ind )
      509           v-ind    = v-ind + 1
      510         .
      511       end.
      512       if v-inform = ?
      513         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      514         or entry( 3, v-inform, ",":U ) <> "1":U
      515       then do:
      516         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info1, v-tbl-name ).
      517       end.
      518       assign
      519         v-idx-field-qnty = num-entries( v-inform ) - 4
      520       .
      521       if v-idx-field-qnty < 2 then do:
      522         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info1, v-inform, v-tbl-name ).
      523       end.
      524       assign
      525         p-field-list = "":U
      526         v-delim-key  = "":U
      527         v-count-fld  = 0
      528       .
      529       block_where:
      530       do v-ind = 1 to v-idx-field-qnty by 2
      531       on error undo, return error
      532       :
      533         assign
      534           v-count-fld = v-count-fld + 1
      535         .
      536         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      537         if v-ind = 1 then do:
      538           assign
      539             v-delim-key = chr(3)
      540           .
      541         end.
      542       end.
      543       delete object bh_tbl-name.
      544     end.
      545   end procedure.
      546   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      547     define variable v-cntxt-db-num        as integer   no-undo .
      548     define variable v-cntxt-userid        as character no-undo .
      549     define variable v-cntxt-level         as character no-undo .
      550     define variable v-cntxt-host-code-obj as integer   no-undo .
      551     define variable v-cntxt-obj-type      as character no-undo .
      552     define variable v-cntxt-obj-code      as integer   no-undo .
      553     define variable v-cntxt-db-num-obj    as integer   no-undo .
      554     define variable v-cntxt-is-admin      as logical   no-undo .
      555   DEFINE BUTTON btn_cancel AUTO-END-KEY
      556        LABEL "Отменить"
      557        SIZE 15 BY 1.13
      558        BGCOLOR 8 .
      559        DEFINE BUTTON b-system
      560        IMAGE-UP FILE "btn-down-arrow":U
      561        IMAGE-DOWN FILE "btn-down-arrow":U
      562        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      563        LABEL ""
      564        SIZE 3 BY .89.
      565        DEFINE BUTTON b-goods-grp
      566        IMAGE-UP FILE "btn-down-arrow":U
      567        IMAGE-DOWN FILE "btn-down-arrow":U
      568        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      569        LABEL ""
      570        SIZE 3 BY .89.
      571   DEFINE BUTTON btn_save AUTO-GO
      572        LABEL "Добавить"
      573        SIZE 15 BY 1.13
      574        BGCOLOR 8 .
      575   DEFINE VARIABLE code_goods as  character FORMAT "X(256)":U
      576        LABEL "Код группы товаров"
      577        VIEW-AS FILL-IN
      578        SIZE 20 BY 1 NO-UNDO.
      579   DEFINE VARIABLE name_goods as  character FORMAT "X(256)":U
      580       LABEL "Имя товара"
      581        VIEW-AS FILL-IN
      582        SIZE 25 BY 1 NO-UNDO.
      583   DEFINE VARIABLE code_system AS CHARACTER FORMAT "X(256)":U
      584        LABEL "Код внешней системы"
      585        VIEW-AS FILL-IN
      586        SIZE 20 BY 1 NO-UNDO.
      587   DEFINE VARIABLE code_vnesh AS CHARACTER FORMAT "X(256)":U
      588        LABEL "Код группы товаров во внешней системе"
      589        VIEW-AS FILL-IN
      590        SIZE 20 BY 1 NO-UNDO.
      591   DEFINE FRAME Dialog-Frame
      592       code_system AT ROW 5.5 COL 45 COLON-ALIGNED WIDGET-ID 2
      593       code_goods AT ROW 6.75 COL 45 COLON-ALIGNED WIDGET-ID 4
      594       code_vnesh at row 8 col 45 COLON-ALIGNED WIDGET-ID 6
      595       btn_save AT ROW 2 COL 2.5
      596       btn_cancel AT ROW 2 COL 59
      597       b-system AT ROW 5.5 COL 65 COLON-ALIGNED WIDGET-ID 8
      598       b-goods-grp AT ROW 6.75 COL 65 COLON-ALIGNED WIDGET-ID 10
      599       name_goods at row 6.75 col 70 COLON-ALIGNED no-label
      600       SPACE(5.12) SKIP(3.53)
      601       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      602       SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      603       TITLE "Добавление записи в  справочник соответствий группы товаров ТН во ВС "
      604       DEFAULT-BUTTON btn_save CANCEL-BUTTON btn_cancel WIDGET-ID 100.
      605   ASSIGN
      606          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      607          FRAME Dialog-Frame:HIDDEN           = TRUE.
      608   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      609       DO:
      610           APPLY "END-ERROR":U TO SELF.
      611       END.
      612   ON CHOOSE OF btn_save IN FRAME Dialog-Frame
      613       DO:
      614           assign code_vnesh
      615               code_goods
      616               code_system.
      617           v-value-character = code_vnesh.
      618           if code_system = "" then
      619           do:
      620               message "Не введен код ВС" view-as alert-box.
      621               return no-apply.
      622           end.
      623           if code_goods = ""  then
      624           do:
      625               message "Не введен код группы товаров" view-as alert-box.
      626               return no-apply.
      627           end.
      628           if code_vnesh = "" then
      629           do:
      630               message "Не введен код группы товаров во ВС" view-as alert-box.
      631               return no-apply.
      632           end.
      633               do transaction on error undo, return no-apply:
      634                   for first ub.gds-grp no-lock where ub.gds-grp.node-code = integer(code_goods)
      635                       :
      636                       find first buf_gds-grp no-lock
      637                           where recid( buf_gds-grp ) = recid(ub.gds-grp).
      638                       run gen-key-rec IN THIS-PROCEDURE ( input 'gds-grp':U
      639                           ,input (buffer buf_gds-grp:handle)
      640                           ,output v-uniq-key-rec).
      641                       run ref/extclas1.p (
      642                           INPUT 'ДОБАВЛЕНИЕ':U
      643                           ,INPUT NO
      644                           ,INPUT-OUTPUT v-rid
      645                           ,INPUT 'gds-grp':U
      646                           ,INPUT 'gds-grp':U
      647                           ,input 0
      648                           ,input buf_gds-grp.node-code
      649                           ,input code_system
      650                           ,input 0
      651                           ,input v-value-character
      652                           ,input '':U
      653                           ,input buf_gds-grp.node-name
      654                           ,input 0
      655                           ,input v-uniq-key-rec ) no-error.
      656                       if error-status:error then
      657                       do:
      658                           if error-status:get-message(1) = "" then
      659                               message "Ошибка добавления записи в справочник!" view-as alert-box .
      660                           else
      661                               message error-status:get-message(1) view-as alert-box .
      662                           undo, return no-apply .
      663                       end.
      664                   end.
      665               end.
      666       end.
      667   on leave of name_goods in frame dialog-frame
      668       do:
      669           assign code_goods.
      670           if code_goods = "" then  return no-apply.
      671           find first gds-grp where gds-grp.node-code = integer(code_goods) no-error.
      672           if  error-status:error then
      673           do:
      674               message "Неправильно введен код группы товаров" view-as alert-box.
      675            return no-apply.
      676           end.
      677           else
      678           do:
      679               p-name-goods = gds-grp.node-name.
      680               name_goods:screen-value = p-name-goods.
      681           end.
      682       end.
      683   ON CHOOSE OF b-system IN FRAME Dialog-Frame
      684       DO:
      685           run bge/oxmlexts.p (
      686               input parparentproc,
      687               input 2,
      688               input substitute("esys-type > &1", '0':U),
      689               input "",
      690               output v-rid-list,
      691               output v-ok).
      692           if v-rid-list = "" or v-ok <> true then message "Не была выбрана внешняя система." view-as alert-box.
      693           if v-ok = true then
      694           do:
      695               run gen-row-keyr in this-procedure
      696                   ( input v-rid-list
      697                   ,input ?
      698                   ,input "ub"
      699                   ,input ?
      700                   ,input no-lock
      701                   ,output v-tbl-row
      702                   ,output v-tbl-name
      703                   ).
      704               find first buf_ext-system no-lock where
      705                   rowid(buf_ext-system) = v-tbl-row.
      706           end.
      707           else
      708           do:
      709               undo, return no-apply .
      710           end.
      711           code_system:screen-value =  entry(2,v-rid-list,chr(3)) no-error.
      712       end.
      713   ON CHOOSE OF b-goods-grp IN FRAME Dialog-Frame
      714       DO:
      715           assign code_goods .
      716            run ref/gds-grp.w (
      717                 input parparentproc
      718               , input "b-sel":U
      719               , input v-cntxt-obj-type
      720               , input v-cntxt-obj-code
      721               , input-output v-grp
      722           ).
      723           assign
      724               v-grp-recid = integer( v-grp )
      725           no-error.
      726           if error-status:error or v-grp = ? or v-grp = "" then
      727           do:
      728               message "Ошибка при выборе товара для добавления в справочник." view-as alert-box.
      729               return no-apply.
      730           end.
      731           v-ok = false.
      732               find first buf_gds-grp no-lock
      733                    where recid( buf_gds-grp ) = v-grp-recid
      734               .
      735                      code_goods:screen-value = string(buf_gds-grp.node-code) no-error.
      736           apply "leave" to name_goods.
      737           end.
      738   on leave of code_goods in frame dialog-frame
      739       do:
      740           apply "leave" to name_goods.
      741       end.
      742   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      743   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      744   MAIN-BLOCK:
      745   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      746      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      747     RUN enable_UI.
      748     WAIT-FOR GO OF FRAME Dialog-Frame.
      749   END.
      750   RUN disable_UI.
      751   PROCEDURE disable_UI :
      752     HIDE FRAME Dialog-Frame.
      753   END PROCEDURE.
      754   PROCEDURE enable_UI :
      755     DISPLAY code_system code_goods b-system b-goods-grp code_vnesh name_goods
      756         WITH FRAME Dialog-Frame.
      757     ENABLE btn_save btn_cancel code_system code_goods b-system b-goods-grp code_vnesh
      758         WITH FRAME Dialog-Frame.
      759     VIEW FRAME Dialog-Frame.
      760   END PROCEDURE.
