        1   block-level on error undo, throw.
        2   define input parameter p-mode as character no-undo .
        3   define input parameter p-silent as logical no-undo .
        4   define input parameter p-get-node-code as logical no-undo .
        5   define input parameter p-fill-tax-from-upper as logical no-undo .
        6   define input-output parameter p-node-code  like ub.gds-grp.node-code no-undo .
        7   define input-output parameter p-upper-code like ub.gds-grp.upper-code no-undo .
        8   define input parameter p-node-name   like ub.gds-grp.node-name no-undo .
        9   define input parameter p-calc-method like ub.gds-grp.calc-method no-undo .
       10   define input parameter p-increase-pc like ub.gds-grp.increase-pc no-undo .
       11   define input parameter p-print-code  like ub.gds-grp.print-code no-undo .
       12   define input parameter p-round-method as character no-undo .
       13   define input parameter p-base         as decimal no-undo .
       14   define output parameter p-rid as recid no-undo .
       15   define variable vss-revision    as character no-undo init "$Revision: 74e644abf59e, 1135, rls $":U .
       16   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       17   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:13:54 2017 +0300 $":U .
       18   define variable vss-workfile    as character no-undo init "$Workfile: gdsgrp01.p $":U .
       19   define variable vss-archive     as character no-undo init "$Archive: ref/gdsgrp01.p $":U .
       20   define variable vss-description as character no-undo init "Проверка и создание группы товара".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   define   shared variable g#auto as logical no-undo.
       82   define   shared variable g#news as logical no-undo.
       83   define   shared variable g#oxml as logical no-undo.
       84   define   shared variable g#esys as logical no-undo.
       85   define   shared variable g#news-source-db as integer no-undo.
       86   define   shared variable g#esys-source-esys as integer no-undo.
       87   define   shared variable g#db-num as integer   no-undo .
       88   define   shared variable g#userid as character no-undo .
       89   define   shared variable g#passwd as character no-undo .
       90   define variable vss-include-info0 as character format "X(65)" no-undo
       91   initial "@(#)$Workfile$ $Revision$".
       92   define temp-table temp_grplib_grp no-undo
       93       field sel           as character
       94       field nabor         as character
       95       field full-name     as character
       96       field print-code    as character
       97       field sort-name     as character
       98       field node-code     as integer
       99       field upper-code    as integer
      100       field calc-method   as character
      101       field round-method  as character
      102       field increase-pc   as decimal
      103       field min-marg      as character
      104       field max-marg      as character
      105       field cli-type      as character
      106       field cli-code      as integer
      107       field notcorr      as character
      108       field name          as character
      109       field level         as integer
      110       field mark          as character
      111       index pi is primary unique sort-name
      112       index fn full-name
      113       index nc is unique node-code
      114       index sl sel
      115       index uc upper-code
      116   .
      117   define temp-table temp_grplib_found-grp no-undo
      118       field full-name   as character
      119       field sort-name   as character
      120       field node-code   as integer
      121       field level       as integer
      122       field is-terminal as logical
      123       index pi is primary unique sort-name
      124       index fn full-name
      125       index lv level
      126       index it is-terminal
      127   .
      128   define temp-table temp_found-result-nodelist no-undo
      129       field node-code     as recid
      130       field processed     as logical
      131       field sort-name     as character
      132       field full-name     as character
      133       index pi is primary unique node-code
      134       index ps processed
      135   .
      136   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
      137   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
      138   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
      139   procedure grplib-get-parameters :
      140   define input parameter p-store-type     as character        no-undo.
      141   define input parameter p-store-code     as integer          no-undo.
      142   do
      143   on error undo, return error
      144   :
      145       assign
      146           v-grplib-not-fill-extra-info = no
      147       .
      148   end.
      149   end procedure.
      150   procedure grplib-get-sort-name :
      151   do
      152   on error undo, return error
      153   :
      154   define input parameter p-node-code  as integer      no-undo.
      155   define output parameter p-sort-name as character    no-undo.
      156       define variable v-upper-code    as integer           no-undo.
      157       define buffer buf_gds-grp       for ub.gds-grp.
      158       define buffer buf_upper_gds-grp for ub.gds-grp.
      159       find first buf_gds-grp no-lock
      160            where buf_gds-grp.node-code = p-node-code
      161       no-error.
      162       if not available buf_gds-grp
      163       then do:
      164           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      165       end.
      166       assign
      167           p-sort-name  = ""
      168           v-upper-code = 1
      169       .
      170       do while buf_gds-grp.upper-code <> 0
      171       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
      172       :
      173           assign
      174               p-sort-name  = buf_gds-grp.node-name
      175                            + (if p-sort-name <> "" then chr(2) else "")
      176                            + p-sort-name
      177               v-upper-code = buf_gds-grp.upper-code
      178           .
      179           find first buf_gds-grp no-lock
      180                where buf_gds-grp.node-code = v-upper-code
      181           no-error.
      182           if not available buf_gds-grp
      183           then do:
      184               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
      185                                   + string( v-upper-code )
      186                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      187           end.
      188       end.
      189   end.
      190   end procedure.
      191   define variable vss-include-info1 as character format "X(65)" no-undo
      192   initial "@(#)$Workfile$ $Revision$".
      193   procedure grplib-get-full-name :
      194      define input parameter p-node-code  as integer      no-undo.
      195      define output parameter p-full-name as character    no-undo.
      196      do
      197   on error undo, return error
      198   :
      199       define variable v-upper-code    as integer           no-undo.
      200       define buffer buf_gds-grp       for ub.gds-grp.
      201       define buffer buf_upper_gds-grp for ub.gds-grp.
      202       find first buf_gds-grp no-lock
      203            where buf_gds-grp.node-code = p-node-code
      204       no-error.
      205       if not available buf_gds-grp
      206       then do:
      207           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      208       end.
      209       assign
      210           p-full-name  = ""
      211           v-upper-code = 1
      212       .
      213       do while buf_gds-grp.upper-code <> 0
      214       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      215       :
      216           assign
      217               p-full-name  = buf_gds-grp.node-name
      218                            + (if p-full-name <> "" then chr(47) else "")
      219                            + p-full-name
      220               v-upper-code = buf_gds-grp.upper-code
      221           .
      222           find first buf_gds-grp no-lock
      223                where buf_gds-grp.node-code = v-upper-code
      224           no-error.
      225           if not available buf_gds-grp
      226           then do:
      227               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      228                                   + string( v-upper-code )
      229                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      230           end.
      231       end.
      232       assign
      233       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      234       .
      235   end.
      236   end .
      237   procedure grplib-get-node-from-full-name :
      238   define input parameter p-full-name as character no-undo .
      239   define output parameter p-node-code as integer no-undo .
      240   define variable v-ii as integer no-undo .
      241   define variable v-upper-code as integer no-undo .
      242   define variable v-root-code as integer no-undo .
      243   define variable v-entry as character no-undo .
      244   define buffer buf_gds-grp       for ub.gds-grp.
      245   do
      246   on error undo, return error
      247   :
      248     find first buf_gds-grp no-lock
      249         where buf_gds-grp.upper-code = 0
      250     no-error .
      251     if not available buf_gds-grp
      252     then do:
      253         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      254     end.
      255     else do:
      256       assign
      257       v-root-code = buf_gds-grp.node-code
      258       .
      259     end.
      260     v-upper-code = v-root-code.
      261     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      262       assign
      263       v-entry = entry(v-ii, p-full-name, chr(47)).
      264       if v-entry = '' then leave.
      265       find first buf_gds-grp no-lock where
      266                 buf_gds-grp.node-name = v-entry
      267             and buf_gds-grp.upper-code = v-upper-code
      268             no-error.
      269       if not available buf_gds-grp then do:
      270         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      271       end.
      272       else do:
      273         p-node-code = buf_gds-grp.node-code.
      274         v-upper-code = buf_gds-grp.node-code.
      275       end.
      276     end.
      277   end.
      278   end .
      279   procedure grplib-get-root-code :
      280   do
      281   on error undo, return error
      282   :
      283   define output parameter p-root-code as integer      no-undo.
      284       define buffer buf_gds-grp       for ub.gds-grp.
      285       find first buf_gds-grp no-lock
      286           where buf_gds-grp.upper-code = 0
      287       no-error .
      288       if not available buf_gds-grp
      289       then do:
      290           undo, return error .
      291       end.
      292       else do:
      293           assign
      294               p-root-code = buf_gds-grp.node-code
      295           .
      296       end.
      297   end.
      298   end procedure.
      299   procedure grplib-find-grp-by-full-name :
      300   do
      301   on error undo, return error
      302   :
      303   define input parameter p-search-name  as character    no-undo.
      304   define input parameter p-fill-path    as logical      no-undo.
      305   define output parameter p-found       as logical      no-undo.
      306       define variable v-upper-code    as integer          no-undo.
      307       define variable v-counter       as integer           no-undo.
      308       define variable v-level         as integer           no-undo.
      309       define variable v-full-name     as character         no-undo.
      310       define variable v-sort-name     as character         no-undo.
      311       define buffer buf_gds-grp       for ub.gds-grp.
      312       assign
      313           p-search-name = replace( p-search-name, chr(47), chr(2) )
      314       .
      315       run grplib-get-root-code ( output v-upper-code ) no-error .
      316       if error-status :error
      317       then do:
      318           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
      319       end.
      320       assign
      321           v-full-name  = ""
      322           v-level      = num-entries( p-search-name, chr(2) )
      323       .
      324       for each temp_grplib_found-grp
      325       :
      326           delete temp_grplib_found-grp.
      327       end.
      328       start-name-analyze:
      329       do v-counter = 1 to v-level
      330       :
      331           if v-counter < v-level
      332           then do:
      333               find first buf_gds-grp no-lock
      334                    where buf_gds-grp.upper-code = v-upper-code
      335                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
      336               no-error .
      337               if not available buf_gds-grp
      338               then do:
      339                   assign
      340                       v-full-name  = p-search-name
      341                       v-sort-name  = p-search-name
      342                   .
      343                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
      344               end.
      345               else do:
      346                   assign
      347                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
      348                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
      349                       v-upper-code = buf_gds-grp.node-code
      350                   .
      351                   if p-fill-path = yes
      352                   then do:
      353                       create temp_grplib_found-grp.
      354                       assign
      355                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
      356                           temp_grplib_found-grp.sort-name = v-sort-name
      357                           temp_grplib_found-grp.node-code = v-upper-code
      358                           temp_grplib_found-grp.level     = v-counter
      359                       .
      360                   end.
      361               end.
      362           end.
      363           else do:
      364               for each buf_gds-grp no-lock
      365                  where buf_gds-grp.upper-code = v-upper-code
      366                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
      367               :
      368                   assign
      369                       p-found = yes
      370                   .
      371                   create temp_grplib_found-grp.
      372                   assign
      373                       temp_grplib_found-grp.full-name = v-full-name
      374                                                           + (if v-full-name = "" then "" else chr(47) )
      375                                                           + buf_gds-grp.node-name + chr(47)
      376                       temp_grplib_found-grp.sort-name = v-sort-name
      377                                                           + ( if v-sort-name = "" then "" else chr(2) )
      378                                                           + buf_gds-grp.node-name
      379                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
      380                       temp_grplib_found-grp.level     = v-level
      381                   .
      382               end.
      383               if p-found = no
      384               then do:
      385                   assign
      386                       v-full-name  = p-search-name
      387                       v-sort-name  = p-search-name
      388                   .
      389                   for each temp_grplib_found-grp
      390                   :
      391                       delete temp_grplib_found-grp.
      392                   end.
      393                   assign
      394                       p-found = no
      395                   .
      396               end.
      397           end.
      398       end.
      399   end.
      400   end procedure.
      401   procedure grplib-find-all-subgroup :
      402   do
      403   on error undo, return error
      404   :
      405   define input parameter p-start-node-code    as integer      no-undo.
      406   define input parameter p-terminal-only      as logical      no-undo.
      407       define variable v-start-full-name   as character     no-undo.
      408       define variable v-start-sort-name   as character     no-undo.
      409       define variable v-not-found         as logical       no-undo.
      410       define variable v-is-terminal       as logical       no-undo.
      411       define buffer buf_gds-grp           for ub.gds-grp.
      412       create temp_found-result-nodelist.
      413       assign
      414           temp_found-result-nodelist.node-code = p-start-node-code
      415           temp_found-result-nodelist.processed = no
      416       .
      417       run grplib-get-full-name in this-procedure (
      418             input p-start-node-code
      419           , output v-start-full-name
      420       ).
      421       run grplib-get-full-name in this-procedure (
      422             input p-start-node-code
      423           , output v-start-sort-name
      424       ).
      425       process-nodes:
      426       do while yes
      427       :
      428           find first temp_found-result-nodelist
      429                where temp_found-result-nodelist.node-code = p-start-node-code
      430           .
      431           assign
      432               temp_found-result-nodelist.processed = yes
      433           .
      434           for each buf_gds-grp no-lock
      435              where buf_gds-grp.upper-code = p-start-node-code
      436           on error undo, return error
      437           :
      438               run grplib-is-terminal in this-procedure (
      439                     input buf_gds-grp.node-code
      440                   , output v-is-terminal
      441               ).
      442               if v-is-terminal = yes
      443               then do:
      444                   create temp_grplib_found-grp.
      445                   assign
      446                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      447                                                           chr(47) + buf_gds-grp.node-name + chr(47)
      448                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      449                                                           chr(2) + buf_gds-grp.node-name + chr(2)
      450                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      451                       temp_grplib_found-grp.is-terminal = yes
      452                   .
      453               end.
      454               else do:
      455                   create temp_found-result-nodelist.
      456                   assign
      457                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
      458                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
      459                                                              chr(47) + buf_gds-grp.node-name + chr(47)
      460                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
      461                                                              chr(2) + buf_gds-grp.node-name + chr(2)
      462                       temp_found-result-nodelist.processed = no
      463                   .
      464                   if p-terminal-only = no
      465                   then do:
      466                       create temp_grplib_found-grp.
      467                       assign
      468                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
      469                                                               chr(47) + buf_gds-grp.node-name + chr(47)
      470                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
      471                                                               chr(2) + buf_gds-grp.node-name + chr(2)
      472                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
      473                           temp_grplib_found-grp.is-terminal = no
      474                       .
      475                   end.
      476               end.
      477           end.
      478           find first temp_found-result-nodelist
      479                where temp_found-result-nodelist.processed = no
      480           no-error.
      481           if not available temp_found-result-nodelist
      482           then do:
      483               leave process-nodes.
      484           end.
      485           else do:
      486               assign
      487                   p-start-node-code = temp_found-result-nodelist.node-code
      488                   v-start-full-name = temp_found-result-nodelist.full-name
      489                   v-start-sort-name = temp_found-result-nodelist.sort-name
      490               .
      491           end.
      492       end.
      493   end.
      494   end procedure.
      495   procedure grplib-expand-name :
      496   define input parameter p-start-name as character        no-undo.
      497   define output parameter p-end-name  as character        no-undo.
      498       define variable v-is-terminal   as logical      no-undo.
      499       define variable v-found         as character    no-undo.
      500       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
      501   do
      502   for buf_temp_grplib_found-grp
      503   on error undo, return error
      504   :
      505       run grplib-find-grp-by-full-name in this-procedure (
      506             input p-start-name
      507           , input no
      508           , output v-found
      509       ) no-error.
      510       run grplib-get-max-substring in this-procedure (
      511                   input length( p-start-name )
      512                 , output p-end-name
      513       ) no-error .
      514       if error-status :error
      515       then do:
      516           assign
      517               p-end-name = ""
      518           .
      519       end.
      520       else do:
      521           find first temp_grplib_found-grp
      522               where temp_grplib_found-grp.full-name = p-end-name
      523           no-error.
      524           if available temp_grplib_found-grp
      525           then do:
      526               find first buf_temp_grplib_found-grp
      527                   where buf_temp_grplib_found-grp.full-name begins p-end-name
      528                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
      529               no-error.
      530               if not available buf_temp_grplib_found-grp
      531               then do:
      532                   run grplib-is-terminal in this-procedure (
      533                       input temp_grplib_found-grp.node-code
      534                       , output v-is-terminal
      535                   ).
      536               end.
      537           end.
      538       end.
      539   end.
      540   end procedure.
      541   procedure grplib-get-max-substring :
      542   do
      543   on error undo, return error
      544   :
      545   define input parameter p-min-substring-length   as integer      no-undo.
      546   define output parameter p-substring             as character    no-undo.
      547           define variable v-char-counter  as integer           no-undo.
      548           define variable v-current-char  as character         no-undo.
      549           define variable v-names-counter  as integer           no-undo.
      550           define variable v-base-string   as character         no-undo.
      551           assign
      552               v-char-counter  = p-min-substring-length
      553           .
      554           find first temp_grplib_found-grp no-error.
      555           if not available temp_grplib_found-grp
      556           then do:
      557               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
      558           end.
      559           else do:
      560               assign
      561                   v-base-string  = temp_grplib_found-grp.full-name
      562                   v-char-counter = 0
      563               .
      564               counter-block:
      565               do while yes
      566               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
      567               :
      568                   assign
      569                       v-char-counter  = v-char-counter + 1
      570                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
      571                       v-names-counter = 0
      572                   .
      573                   compare-block:
      574                   for each temp_grplib_found-grp
      575                   :
      576                       assign
      577                           v-names-counter = v-names-counter + 1
      578                       .
      579                       if v-names-counter = 1
      580                       then do:
      581                           next compare-block.
      582                       end.
      583                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
      584                       then do:
      585                           leave counter-block.
      586                       end.
      587                   end.
      588                   if v-names-counter = 1
      589                   then do:
      590                       assign
      591                           p-substring = v-base-string
      592                       .
      593                       return.
      594                   end.
      595               end.
      596               assign
      597                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
      598               .
      599           end.
      600   end.
      601   end procedure.
      602   procedure grplib-is-terminal :
      603   do
      604   on error undo, return error "Ошибка процедуры grplib-is-terminal"
      605   :
      606   define input parameter p-node-code      as integer      no-undo.
      607   define output parameter p-is-terminal   as logical      no-undo.
      608       define buffer buf_gds-grp       for ub.gds-grp.
      609       find first buf_gds-grp no-lock
      610           where buf_gds-grp.upper-code = p-node-code
      611       no-error .
      612       if not available buf_gds-grp
      613       then do:
      614           assign
      615               p-is-terminal = yes
      616           .
      617       end.
      618       else do:
      619           assign
      620               p-is-terminal = no
      621           .
      622       end.
      623   end.
      624   end procedure.
      625   procedure grplib-have-goods :
      626   do
      627   on error undo, return error
      628   :
      629   define input parameter p-node-code      as integer      no-undo.
      630   define output parameter p-have-goods   as logical      no-undo.
      631       define buffer buf_goods         for ub.goods.
      632       find first buf_goods no-lock
      633            where buf_goods.grp-code = p-node-code
      634       no-error .
      635       if available buf_goods
      636       then do:
      637           assign
      638               p-have-goods = yes
      639           .
      640       end.
      641       else do:
      642           assign
      643               p-have-goods = no
      644           .
      645       end.
      646   end.
      647   end procedure.
      648   procedure grplib-find-by-substring :
      649   do
      650   on error undo, return error
      651   :
      652   define input parameter p-start-code         as integer      no-undo.
      653   define input parameter p-full-search-string as character    no-undo.
      654   define output parameter p-found-code        as integer      no-undo.
      655   define output parameter p-full-name         as character    no-undo.
      656       define variable v-start-code     as integer           no-undo.
      657       define variable v-found          as logical  init no  no-undo.
      658       define buffer buf_gds-grp       for ub.gds-grp.
      659       search-grp:
      660       for each buf_gds-grp no-lock
      661           where buf_gds-grp.node-code > p-start-code
      662       :
      663           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
      664           then do:
      665               assign
      666                   p-found-code = buf_gds-grp.node-code
      667                   v-found      = yes
      668               .
      669               run grplib-get-full-name in this-procedure (
      670                     input p-found-code
      671                   , output p-full-name
      672               ) no-error .
      673               if error-status :error
      674               then do:
      675                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
      676               end.
      677               leave search-grp.
      678           end.
      679       end.
      680       if v-found = yes
      681       then do:
      682       end.
      683       else do:
      684           assign
      685               p-full-name  = ""
      686               p-found-code = 0
      687           .
      688       end.
      689   end.
      690   end procedure.
      691   procedure grplib-analyze-grp-name :
      692   do
      693   on error undo, return error
      694   :
      695   define input parameter p-grp-name       as character            no-undo.
      696   define input parameter p-upper-code     as integer              no-undo.
      697   define output parameter p-error-message as character init ""    no-undo.
      698       define variable v-char-list     as character    no-undo.
      699       define variable v-char-counter  as integer      no-undo.
      700       define variable v-full-name     as character    no-undo.
      701       if p-grp-name = "" then do:
      702           assign
      703               p-error-message = "Название группы не может быть пустым.".
      704           .
      705       end.
      706       else do:
      707           assign
      708               v-char-list = "47,92,58,63,34,60,62,171,187,183"
      709           .
      710           do v-char-counter = 1 to num-entries( v-char-list )
      711           :
      712               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
      713               then do:
      714                   assign
      715                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
      716                   .
      717                   return.
      718               end.
      719           end.
      720           if p-upper-code > 0
      721           then do:
      722               run grplib-get-full-name in this-procedure (
      723                     input p-upper-code
      724                   , output v-full-name
      725               ) no-error .
      726               if error-status :error
      727               then do:
      728                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
      729               end.
      730               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
      731               then do:
      732                   assign
      733                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
      734                   .
      735               end.
      736           end.
      737       end.
      738   end.
      739   end procedure.
      740   procedure grplib-get-lvl-num :
      741   define input parameter p-node-code  as integer      no-undo.
      742   define output parameter p-lvl-num   as integer      no-undo.
      743       define variable v-full-name    as character    no-undo.
      744   do
      745   on error undo, return error
      746   :
      747       run grplib-get-full-name in this-procedure (
      748             input p-node-code
      749           , output v-full-name
      750       ).
      751       assign
      752           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
      753       .
      754       if p-lvl-num = -1
      755       then do:
      756           assign
      757               p-lvl-num = 0
      758           .
      759       end.
      760   end.
      761   end procedure.
      762   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      763   procedure grp-obj-write :
      764   do
      765   on error undo, return error
      766   :
      767   define input parameter p-node-code  like ub.gds-grp-obj.node-code      no-undo.
      768   define input parameter p-host-code  as integer                          no-undo.
      769   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      770   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      771   define input parameter p-min-increase like ub.gds-grp-obj.min-increase  no-undo.
      772   define input parameter p-max-increase like ub.gds-grp-obj.max-increase  no-undo.
      773   define input parameter p-increase-pc like ub.gds-grp-obj.increase-pc  no-undo.
      774   define input parameter p-calc-method like ub.gds-grp-obj.calc-method no-undo .
      775   define input parameter p-round-method like ub.gds-grp-obj.round-method no-undo .
      776   define input parameter p-round-coef like ub.gds-grp-obj.round-coef no-undo .
      777   define input parameter p-cli-type   like ub.clients.obj-type            no-undo.
      778   define input parameter p-cli-code   like ub.clients.obj-code            no-undo.
      779   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
      780       find first buf_gds-grp-obj exclusive-lock
      781            where buf_gds-grp-obj.node-code  = p-node-code
      782              and buf_gds-grp-obj.host-code  = p-host-code
      783              and buf_gds-grp-obj.obj-type   = p-obj-type
      784              and buf_gds-grp-obj.obj-code   = p-obj-code
      785       no-error.
      786       if not available buf_gds-grp-obj
      787       then do:
      788           create buf_gds-grp-obj.
      789           assign
      790                   buf_gds-grp-obj.node-code  = p-node-code
      791                   buf_gds-grp-obj.host-code  = p-host-code
      792                   buf_gds-grp-obj.obj-type   = p-obj-type
      793                   buf_gds-grp-obj.obj-code   = p-obj-code
      794           .
      795       end.
      796       assign
      797       buf_gds-grp-obj.min-increase = p-min-increase
      798       buf_gds-grp-obj.max-increase = p-max-increase
      799       buf_gds-grp-obj.increase-pc = p-increase-pc
      800       buf_gds-grp-obj.calc-method = p-calc-method
      801       buf_gds-grp-obj.round-method = p-round-method
      802       buf_gds-grp-obj.round-coef = p-round-coef
      803       buf_gds-grp-obj.cli-type   = p-cli-type
      804       buf_gds-grp-obj.cli-code   = p-cli-code
      805       .
      806   end.
      807   end procedure.
      808   procedure grp-obj-margin-value :
      809   do
      810   on error undo, return error
      811   :
      812   define input parameter p-node-code as integer      no-undo.
      813   define input parameter p-obj-type  as character    no-undo.
      814   define input parameter p-obj-code  as integer      no-undo.
      815   define output parameter p-min-value as decimal      no-undo init ?.
      816   define output parameter p-max-value as decimal      no-undo init ?.
      817   define output parameter p-increase-pc as decimal      no-undo init ?.
      818   define output parameter p-round-method as character no-undo init "":U.
      819   define output parameter p-base as decimal no-undo init ?.
      820   define output parameter p-range-margin     as integer      no-undo.
      821   define output parameter p-exists-margin    as logical      no-undo.
      822   define output parameter p-range-increase     as integer      no-undo.
      823   define output parameter p-exists-increase    as logical      no-undo.
      824   define output parameter p-range-rmethod     as integer no-undo .
      825   define output parameter p-exists-rmethod    as logical no-undo .
      826   define variable v-host-code as integer      no-undo.
      827   DEFINE VARIABLE v-found as logical no-undo .
      828   DEFINE VARIABLE v-exists as logical no-undo .
      829   DEFINE VARIABLE v-range as integer no-undo .
      830   DEFINE VARIABLE jj as integer no-undo .
      831   DEFINE VARIABLE v-margin-found as logical no-undo .
      832   DEFINE VARIABLE v-increase-found as logical no-undo .
      833   DEFINE VARIABLE v-min-value as decimal      no-undo.
      834   DEFINE VARIABLE v-max-value as decimal      no-undo.
      835   DEFINE VARIABLE v-increase-pc as decimal      no-undo.
      836   define variable v-round-method as character no-undo .
      837   define variable v-base as decimal no-undo .
      838   define variable v-print-code as character no-undo .
      839   define buffer buf_gds-grp for ub.gds-grp.
      840   find first buf_gds-grp no-lock where
      841              buf_gds-grp.node-code = p-node-code no-error .
      842   if not avail buf_gds-grp and p-node-code <> 0 then do:
      843     message
      844       vss-workfile vss-revision vss-description
      845       skip "Не удалось найти группу товаров с кодом" p-node-code
      846       view-as alert-box error .
      847     undo, return error .
      848   end.
      849   if p-obj-type <> '' then do:
      850   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      851   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      852     (input  p-obj-type
      853     ,input  p-obj-code
      854     ,output v-host-code
      855     ) no-error .
      856     if error-status :error
      857     then do:
      858         message
      859           vss-workfile vss-revision vss-description
      860           skip "Не удалось найти фирму объекта"
      861           skip p-obj-type p-obj-code
      862           skip return-value
      863           skip trim(error-status :get-message(1))
      864               trim(error-status :get-message(2))
      865               trim(error-status :get-message(3))
      866               trim(error-status :get-message(4))
      867               trim(error-status :get-message(5))
      868         view-as alert-box error.
      869         undo, return error .
      870     end.
      871   end.
      872   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
      873   do while v-found = no and jj < 2:
      874     if v-range <> 3 then do:
      875       find first buf_gds-grp-obj no-lock
      876           where buf_gds-grp-obj.node-code = p-node-code
      877             and buf_gds-grp-obj.host-code = v-host-code
      878             and buf_gds-grp-obj.obj-type  = p-obj-type
      879             and buf_gds-grp-obj.obj-code  = p-obj-code
      880       no-error .
      881     end.
      882     if v-range = 3 or not available buf_gds-grp-obj
      883     then do:
      884        if v-range <> 2 then do:
      885           find first buf_gds-grp-obj no-lock
      886               where buf_gds-grp-obj.node-code = p-node-code
      887                 and buf_gds-grp-obj.host-code = v-host-code
      888                 and buf_gds-grp-obj.obj-type  = ""
      889                 and buf_gds-grp-obj.obj-code  = 0
      890           no-error .
      891         end.
      892         if v-range = 2 or not available buf_gds-grp-obj
      893         then do:
      894             if v-range <> 1 then do:
      895               find first buf_gds-grp-obj no-lock
      896                   where buf_gds-grp-obj.node-code = p-node-code
      897                   and buf_gds-grp-obj.host-code = 0
      898                   and buf_gds-grp-obj.obj-type  = ""
      899                   and buf_gds-grp-obj.obj-code  = 0
      900               no-error .
      901             end.
      902             if v-range = 1 or not available buf_gds-grp-obj
      903             then do:
      904                 assign
      905                     v-exists = no
      906                 .
      907             end.
      908             else do:
      909                 assign
      910                     v-exists = yes
      911                     v-range = 1
      912                 .
      913             end.
      914         end.
      915         else do:
      916             assign
      917                 v-exists = yes
      918                 v-range  = 2
      919             .
      920         end.
      921     end.
      922     else do:
      923         assign
      924             v-exists = yes
      925             v-range  = 3
      926         .
      927     end.
      928     if available buf_gds-grp-obj
      929     then do:
      930       assign
      931       v-min-value    = buf_gds-grp-obj.min-increase
      932       v-max-value    = buf_gds-grp-obj.max-increase
      933       v-increase-pc  = buf_gds-grp-obj.increase-pc
      934       v-round-method = buf_gds-grp-obj.round-method
      935       v-base         = buf_gds-grp-obj.round-coef
      936       .
      937       assign
      938       p-exists-margin = (if v-min-value <> ? and v-max-value <> ? and p-min-value = ?
      939                           then yes
      940                           else p-exists-margin)
      941       p-range-margin = if p-exists-margin and p-min-value = ?
      942                         then v-range
      943                         else p-range-margin
      944       p-min-value   =  if p-exists-margin and  p-min-value = ?
      945                         then v-min-value
      946                         else p-min-value
      947       p-max-value   =  if p-exists-margin and  p-max-value = ?
      948                         then v-max-value
      949                         else p-max-value
      950       p-exists-increase = (if v-increase-pc <> ? and p-increase-pc = ?
      951                           then yes
      952                           else p-exists-increase)
      953       p-range-increase = if p-exists-increase and p-increase-pc = ?
      954                         then v-range
      955                         else p-range-increase
      956       p-increase-pc = (if p-exists-increase and p-increase-pc = ?
      957                         then v-increase-pc
      958                         else p-increase-pc)
      959       p-exists-rmethod = if v-round-method <> "":U and p-round-method = "":U
      960                           then yes
      961                           else p-exists-rmethod
      962       p-range-rmethod = (if p-exists-rmethod and p-round-method = "":U
      963                           then v-range
      964                           else p-range-rmethod)
      965       p-round-method  = (if p-exists-rmethod and p-round-method = "":U
      966                           then v-round-method
      967                           else p-round-method)
      968       p-base          = (if p-exists-rmethod and p-base = ?
      969                           then v-base
      970                           else p-base)
      971       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod) or (v-range <= 1)
      972       jj = jj + 1
      973       .
      974     end.
      975     else do:
      976       assign
      977       v-found =  (p-exists-margin and p-exists-increase and p-exists-rmethod ) or (v-range <= 1)
      978       jj = jj + 1
      979       .
      980     end.
      981   end.
      982   end.
      983   end procedure.
      984   procedure grp-obj-income-cli-value :
      985   do
      986   on error undo, return error
      987   :
      988   define input parameter p-node-code as integer      no-undo.
      989   define input parameter p-obj-type  as character    no-undo.
      990   define input parameter p-obj-code  as integer      no-undo.
      991   define output parameter p-cli-type as character    no-undo init ?.
      992   define output parameter p-cli-code as integer      no-undo init ?.
      993   define output parameter p-range-income-cli     as integer      no-undo.
      994   define output parameter p-exists-income-cli    as logical      no-undo.
      995   define variable v-host-code as integer      no-undo.
      996   DEFINE VARIABLE v-found as logical no-undo .
      997   DEFINE VARIABLE v-exists as logical no-undo .
      998   DEFINE VARIABLE v-range as integer no-undo .
      999   DEFINE VARIABLE jj as integer no-undo .
     1000   DEFINE VARIABLE v-income-cli-found as logical no-undo .
     1001   DEFINE VARIABLE v-cli-type-value as char      no-undo.
     1002   DEFINE VARIABLE v-cli-code-value as int      no-undo.
     1003   define buffer buf_gds-grp for ub.gds-grp.
     1004   find first buf_gds-grp no-lock where
     1005              buf_gds-grp.node-code = p-node-code no-error .
     1006   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1007     message
     1008       vss-workfile vss-revision vss-description
     1009       skip "Не удалось найти группу товаров с кодом" p-node-code
     1010       view-as alert-box error .
     1011     undo, return error .
     1012   end.
     1013   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1014   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1015     (input  p-obj-type
     1016     ,input  p-obj-code
     1017     ,output v-host-code
     1018     ) no-error .
     1019   if error-status :error
     1020   then do:
     1021       message
     1022         vss-workfile vss-revision vss-description
     1023         skip "Не удалось найти фирму объекта"
     1024         skip p-obj-type p-obj-code
     1025         skip return-value
     1026         skip trim(error-status :get-message(1))
     1027              trim(error-status :get-message(2))
     1028              trim(error-status :get-message(3))
     1029              trim(error-status :get-message(4))
     1030              trim(error-status :get-message(5))
     1031       view-as alert-box error.
     1032       undo, return error .
     1033   end.
     1034   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1035   do while v-found = no and jj < 2:
     1036     if v-range <> 3 then do:
     1037       find first buf_gds-grp-obj no-lock
     1038           where buf_gds-grp-obj.node-code = p-node-code
     1039             and buf_gds-grp-obj.host-code = v-host-code
     1040             and buf_gds-grp-obj.obj-type  = p-obj-type
     1041             and buf_gds-grp-obj.obj-code  = p-obj-code
     1042       no-error .
     1043     end.
     1044     if v-range = 3 or not available buf_gds-grp-obj
     1045     then do:
     1046        if v-range <> 2 then do:
     1047           find first buf_gds-grp-obj no-lock
     1048               where buf_gds-grp-obj.node-code = p-node-code
     1049                 and buf_gds-grp-obj.host-code = v-host-code
     1050                 and buf_gds-grp-obj.obj-type  = ""
     1051                 and buf_gds-grp-obj.obj-code  = 0
     1052           no-error .
     1053         end.
     1054         if v-range = 2 or not available buf_gds-grp-obj
     1055         then do:
     1056             if v-range <> 1 then do:
     1057               find first buf_gds-grp-obj no-lock
     1058                   where buf_gds-grp-obj.node-code = p-node-code
     1059                   and buf_gds-grp-obj.host-code = 0
     1060                   and buf_gds-grp-obj.obj-type  = ""
     1061                   and buf_gds-grp-obj.obj-code  = 0
     1062               no-error .
     1063             end.
     1064             if v-range = 1 or not available buf_gds-grp-obj
     1065             then do:
     1066                 assign
     1067                     v-exists = no
     1068                 .
     1069             end.
     1070             else do:
     1071                 assign
     1072                     v-exists = yes
     1073                     v-range = 1
     1074                 .
     1075             end.
     1076         end.
     1077         else do:
     1078             assign
     1079                 v-exists = yes
     1080                 v-range  = 2
     1081             .
     1082         end.
     1083     end.
     1084     else do:
     1085         assign
     1086             v-exists = yes
     1087             v-range  = 3
     1088         .
     1089     end.
     1090     if available buf_gds-grp-obj
     1091     then do:
     1092       assign
     1093       v-cli-type-value    = buf_gds-grp-obj.cli-type
     1094       v-cli-code-value    = buf_gds-grp-obj.cli-code
     1095       .
     1096       assign
     1097       p-exists-income-cli = (if v-cli-type-value <> ? and v-cli-code-value <> ? and p-cli-type = ?
     1098                           then yes
     1099                           else p-exists-income-cli)
     1100       p-range-income-cli = if p-exists-income-cli and p-cli-type = ?
     1101                         then v-range
     1102                         else p-range-income-cli
     1103       p-cli-type   =  if p-exists-income-cli and  p-cli-type = ?
     1104                         then v-cli-type-value
     1105                         else p-cli-type
     1106       p-cli-code   =  if p-exists-income-cli and  p-cli-code = ?
     1107                         then v-cli-code-value
     1108                         else p-cli-code
     1109       v-found =  (p-exists-income-cli ) or (v-range <= 1)
     1110       jj = jj + 1
     1111       .
     1112     end.
     1113     else do:
     1114       assign
     1115       v-found =  (p-exists-income-cli  ) or (v-range <= 1)
     1116       jj = jj + 1
     1117       .
     1118     end.
     1119   end.
     1120   end.
     1121   end procedure.
     1122     define NEW SHARED temp-table  tt-tax no-undo
     1123   field tax-code    like ub.tax.tax-code
     1124   FIELD individual  like ub.tax.individual
     1125   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
     1126   field rate-code   like ub.tax-rate.rate-code
     1127   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
     1128   FIELD tax-type    like ub.tax.tax-type
     1129   field rate-value  like ub.tax-rate-value.rate-value
     1130   FIELD tax-rate-gds-rc  as recid
     1131   FIELD to-cashdesk like ub.tax.to-cashdesk
     1132   FIELD fact-date like ub.tax-rate-value.fact-date
     1133   FIELD fact-order like ub.tax-rate-value.fact-order
     1134   FIELD next-order like ub.tax-rate-value.fact-order
     1135   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
     1136   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
     1137   FIELD corr-date like ub.tax-rate-gds.corr-date
     1138   FIELD corr-time like ub.tax-rate-gds.corr-time
     1139   index tax-code is unique primary tax-code fact-order descending rate-code.
     1140   DEFINE VARIABLE v-full-name as character no-undo .
     1141   DEFINE VARIABLE v-error-message as character no-undo .
     1142   DEFINE VARIABLE v-list as character no-undo .
     1143   DEFINE VARIABLE v-node-code like ub.gds-grp.node-code no-undo .
     1144   define variable v-last-node-code as integer no-undo .
     1145   define variable v-is-import as logical no-undo .
     1146   define variable v-print-code  as character no-undo .
     1147   define variable v-value as character no-undo.
     1148   define variable v-ttype as character no-undo.
     1149   define buffer upper_gds-grp  for ub.gds-grp.
     1150   define buffer buf_gds-grp-obj for ub.gds-grp-obj.
     1151   define buffer buf_gds-grp for ub.gds-grp.
     1152   main-block:
     1153   do
     1154   on error undo, return error
     1155   :
     1156     if NOT (p-mode = 'ДОБАВЛЕНИЕ':U
     1157          or p-mode = 'ИЗМЕНЕНИЕ':U
     1158          or p-mode = "import":U
     1159          ) then do:
     1160       message
     1161       vss-workfile vss-revision vss-description skip
     1162       "Неверное значение параметра p-mode" p-mode
     1163       view-as alert-box error .
     1164       return error .
     1165     end.
     1166   run gbl/conf-rd.p ("is-erpRN", "", "", 0, "", "", "", no, output v-value, output v-ttype) no-error.
     1167   if v-value = "no"  then do:
     1168     if g#db-num <> 0 then do:
     1169       message
     1170       vss-workfile vss-revision vss-description skip
     1171       "Нельзя добавлять/изменить группы клиентов в УБД"
     1172       view-as alert-box error .
     1173       undo main-block, return error .
     1174     end.
     1175   end.
     1176     if p-node-name = ""
     1177     or p-node-name = ? then do:
     1178       assign
     1179       v-error-message = substitute("Не задано название группы" ).
     1180       run err-mess in this-procedure ( input-output v-error-message).
     1181       undo main-block, return error (if p-silent then v-error-message else "node-name").
     1182     end.
     1183       if p-mode = 'ДОБАВЛЕНИЕ':U  then
     1184     do:
     1185       find first buf_gds-grp  no-lock where
     1186         buf_gds-grp.node-code <> p-node-code and
     1187         buf_gds-grp.print-code = p-print-code no-error.
     1188       if available buf_gds-grp then
     1189       do:
     1190         assign
     1191           v-error-message = substitute("Уже есть группа с кодом. № &1", p-print-code).
     1192         run err-mess in this-procedure ( input-output v-error-message).
     1193         undo main-block, return error (if p-silent then v-error-message else "print-code").
     1194       end.
     1195     end.
     1196     if p-mode = 'ИЗМЕНЕНИЕ':U then
     1197     do:
     1198       find first buf_gds-grp exclusive-lock where
     1199         buf_gds-grp.node-code = p-node-code
     1200         AND buf_gds-grp.upper-code = p-upper-code no-error .
     1201       if not avail buf_gds-grp then
     1202       do:
     1203         assign
     1204           v-error-message = substitute("Не найдена группа товаров, которую предполагается изменить", p-node-code).
     1205         run err-mess in this-procedure ( input-output v-error-message).
     1206         undo main-block, return error (if p-silent then v-error-message else "node-code").
     1207       end.
     1208       else
     1209       do:
     1210         find first buf_gds-grp  no-lock where
     1211           buf_gds-grp.node-code <> p-node-code and
     1212           buf_gds-grp.print-code = p-print-code no-error.
     1213         if AVAILABLE buf_gds-grp then
     1214         do:
     1215           assign
     1216             v-error-message = substitute("Уже есть группа с кодом. № &1", p-print-code).
     1217           run err-mess in this-procedure ( input-output v-error-message).
     1218           undo main-block, return error (if p-silent then v-error-message else "print-code").
     1219         end.
     1220         else
     1221         do:
     1222           assign
     1223             p-rid = recid(buf_gds-grp)
     1224             .
     1225           run grplib-get-full-name in this-procedure (
     1226             input p-node-code
     1227             ,output v-full-name).
     1228         end.
     1229       end.
     1230     end.
     1231     if p-mode = 'ДОБАВЛЕНИЕ':U
     1232     and p-get-node-code = yes  then do:
     1233       find first buf_gds-grp  no-lock where
     1234                 buf_gds-grp.node-code = p-node-code no-error.
     1235       if available buf_gds-grp then do:
     1236         assign
     1237         v-error-message = substitute("Уже есть группа с внутр. № &1", p-node-code).
     1238         run err-mess in this-procedure ( input-output v-error-message).
     1239         undo main-block, return error (if p-silent then v-error-message else "node-code").
     1240       end.
     1241     end.
     1242     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1243       find first buf_gds-grp exclusive-lock where
     1244                  buf_gds-grp.node-code = p-node-code
     1245              AND buf_gds-grp.upper-code = p-upper-code no-error .
     1246       if not avail buf_gds-grp then do:
     1247         assign
     1248         v-error-message = substitute("Не найдена группа товаров, которую предполагается изменить", p-node-code).
     1249         run err-mess in this-procedure ( input-output v-error-message).
     1250         undo main-block, return error (if p-silent then v-error-message else "node-code").
     1251       end.
     1252       assign
     1253       p-rid = recid(buf_gds-grp)
     1254       .
     1255       run grplib-get-full-name in this-procedure (
     1256                                                   input p-node-code
     1257                                                  ,output v-full-name).
     1258     end.
     1259     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1260       find first upper_gds-grp exclusive-lock where
     1261                  upper_gds-grp.node-code = p-upper-code no-error .
     1262       if not avail upper_gds-grp then do:
     1263         assign
     1264         v-error-message = substitute("Не найдена группа верхнего уровня с внутр. № &1", p-upper-code).
     1265         run err-mess in this-procedure ( input-output v-error-message).
     1266         undo main-block, return error (if p-silent then v-error-message else "upper-code").
     1267       end.
     1268       if p-get-node-code = yes then do:
     1269         find last buf_gds-grp no-lock use-index pi.
     1270         assign
     1271         v-last-node-code = buf_gds-grp.node-code.
     1272         find first buf_gds-grp no-lock where
     1273                   buf_gds-grp.node-code = p-node-code no-error.
     1274         if available buf_gds-grp then do:
     1275           assign
     1276           v-error-message = substitute("Уже есть группа с внутр. № &1", p-node-code).
     1277           run err-mess in this-procedure ( input-output v-error-message).
     1278           undo main-block, return error (if p-silent then v-error-message else "node-code").
     1279         end.
     1280       end.
     1281       run grplib-get-full-name in this-procedure (
     1282                                                   input p-upper-code
     1283                                                  ,output v-full-name).
     1284       assign
     1285       v-full-name = v-full-name + chr(47) + p-node-name + chr(47)
     1286       .
     1287     end.
     1288     CASE p-calc-method:
     1289       when ? or when "":U then do:
     1290         assign
     1291         v-error-message = substitute("Поле <СПОСОБ РАСЧЕТА> должно быть заполнено").
     1292         run err-mess in this-procedure ( input-output v-error-message).
     1293         undo main-block, return error (if p-silent then v-error-message else "calc-method").
     1294       end.
     1295       otherwise do:
     1296        run str/pr-listv.p (
     1297                        input 'Учетная,Учет-резерв,Накладная,Накл-безНДС,Учет-безНДС,Учет+накл,Уч+накл-НДС,Не-считать,Производит,Произв-НДС,ПорогПр-НДС,ПорогПр+НДС,Спецификация':U
     1298                      , "":U
     1299                      , output v-list) .
     1300         if LOOKUP(p-calc-method, v-list) = 0 then do:
     1301           assign
     1302           v-error-message = substitute("Поле <СПОСОБ РАСЧЕТА> может принимать значения &1", v-list).
     1303           run err-mess in this-procedure ( input-output v-error-message).
     1304           undo main-block, return error (if p-silent then v-error-message else "calc-method").
     1305         end.
     1306       end.
     1307     END CASE.
     1308     CASE p-round-method:
     1309       when ? or when "":U then do:
     1310         assign
     1311         v-error-message = substitute("Поле <МЕТОД ОКРУГЛЕНИЯ> должно быть заполнено").
     1312         run err-mess in this-procedure ( input-output v-error-message).
     1313         undo main-block, return error (if p-silent then v-error-message else "round-method").
     1314       end.
     1315       otherwise do:
     1316         if LOOKUP(p-round-method, '9-окончание,9-99окончание,Без-дробных,Произвольно,Вверх,Коэффициент,Отключено':U) = 0 then do:
     1317           assign
     1318           v-error-message = substitute("Поле <МЕТОД ОКРУГЛЕНИЯ> может принимать значения &1", v-list).
     1319           run err-mess in this-procedure ( input-output v-error-message).
     1320           undo main-block, return error (if p-silent then v-error-message else "round-method").
     1321         end.
     1322       end.
     1323     END CASE.
     1324     if lookup(p-round-method, 'Произвольно,Вверх,Коэффициент,9-99окончание':U) > 0 and
     1325     p-base = 0 then do:
     1326       assign
     1327       v-error-message = substitute("Неверное значение коэффициента 0 для метода округления").
     1328        run err-mess in this-procedure ( input-output v-error-message).
     1329       undo main-block, return error (if p-silent then v-error-message else "round-method").
     1330     end.
     1331     run  grplib-analyze-grp-name in this-procedure
     1332                                                     ( input p-node-name
     1333                                                      ,input p-upper-code
     1334                                                      ,output v-error-message ) no-error .
     1335     if error-status:error or v-error-message <> "":U then do:
     1336       assign
     1337       v-error-message = substitute("Группа &1&2&3", p-node-name, chr(10), v-error-message).
     1338       run err-mess in this-procedure ( input-output v-error-message).
     1339       undo main-block, return error (if p-silent then v-error-message else "node-name").
     1340     end.
     1341     if can-find (ub.gds-grp where ub.gds-grp.upper-code = p-upper-code
     1342                           AND gds-grp.node-name = p-node-name
     1343                           and gds-grp.print-code = p-print-code
     1344                           AND recid (ub.gds-grp) <> p-rid) then do:
     1345       assign
     1346       v-error-message = substitute("Группа &1&2Группа с таким названием уже есть"
     1347                                   , v-full-name
     1348                                   , chr(10)).
     1349       run err-mess in this-procedure ( input-output v-error-message).
     1350       undo main-block, return error (if p-silent then v-error-message else "node-name").
     1351     end.
     1352     if p-fill-tax-from-upper then do:
     1353       run ref/dtaxgrps.p (
     1354                      input (if p-mode = 'ДОБАВЛЕНИЕ':U then 0 else p-node-code)
     1355                     ,input p-upper-code
     1356                     ,input 0
     1357                     ,input "":U
     1358                     ,input 0
     1359                     ) no-error .
     1360       if error-status:error then do:
     1361         assign
     1362         v-error-message = substitute("Группа &1&2Ошибка при заполнении записей НАЛОГИ ПО УМОЛЧАНИЮ ДЛЯ ГРУППЫ ТОВАРОВ&2&3&2&4"
     1363                                     , v-full-name
     1364                                     , chr(10)
     1365                                     , error-status:get-message(1)
     1366                                     , return-value
     1367                                     ).
     1368         run err-mess in this-procedure ( input-output v-error-message).
     1369         undo main-block, return error (if p-silent then v-error-message else "").
     1370       end.
     1371     end.
     1372     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1373       create buf_gds-grp.
     1374       assign
     1375       buf_gds-grp.node-code = (if p-get-node-code
     1376                               then  p-node-code
     1377                               else next-value (s-gds-grp, ub))
     1378       buf_gds-grp.upper-code = p-upper-code
     1379       buf_gds-grp.print-code = p-print-code
     1380       p-node-code = buf_gds-grp.node-code
     1381       .
     1382     end.
     1383     assign
     1384     buf_gds-grp.node-name = p-node-name
     1385     buf_gds-grp.calc-method = p-calc-method
     1386     buf_gds-grp.increase-pc = p-increase-pc
     1387     buf_gds-grp.print-code  = p-print-code
     1388     p-rid = recid(buf_gds-grp)
     1389     v-node-code = buf_gds-grp.node-code
     1390     .
     1391     release buf_gds-grp no-error.
     1392     if error-status:error then do:
     1393       assign
     1394       v-error-message = substitute("Ошибка при сохранении группы товаров:&1&2&1&3"
     1395                                    , chr(10)
     1396                                    , error-status:get-message(1)
     1397                                    , return-value  ).
     1398       run err-mess in this-procedure ( input-output v-error-message).
     1399       undo main-block, return error (if p-silent then v-error-message else "").
     1400     end.
     1401     if p-mode = 'ДОБАВЛЕНИЕ':U
     1402     and p-get-node-code
     1403     and p-node-code > v-last-node-code
     1404     then do:
     1405       run adm/restseqr.p
     1406         ( input "rest-no-msg":U
     1407         ,input "s-gds-grp":U
     1408         ,input no
     1409         ) no-error .
     1410       if error-status :error then do:
     1411         assign
     1412         v-error-message = substitute("Ошибка при восстановлении последовательности вн.№ групп товаров:&1&2&1&3"
     1413                                     , chr(10)
     1414                                     , error-status:get-message(1)
     1415                                     , return-value  ).
     1416         run err-mess in this-procedure ( input-output v-error-message).
     1417         undo main-block, return error (if p-silent then v-error-message else "").
     1418       end.
     1419     end.
     1420    if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1421       find first buf_gds-grp-obj exclusive-lock
     1422            where buf_gds-grp-obj.node-code  = v-node-code
     1423              and buf_gds-grp-obj.host-code  = 0
     1424              and buf_gds-grp-obj.obj-type   = "":U
     1425              and buf_gds-grp-obj.obj-code   = 0
     1426       no-error.
     1427       if not available buf_gds-grp-obj
     1428       then do:
     1429           create buf_gds-grp-obj.
     1430           assign
     1431                   buf_gds-grp-obj.node-code  = v-node-code
     1432                   buf_gds-grp-obj.host-code  = 0
     1433                   buf_gds-grp-obj.obj-type   = "":U
     1434                   buf_gds-grp-obj.obj-code   = 0
     1435           .
     1436       end.
     1437       assign
     1438       buf_gds-grp-obj.min-increase =  ?
     1439       buf_gds-grp-obj.max-increase = ?
     1440       buf_gds-grp-obj.increase-pc = p-increase-pc
     1441       buf_gds-grp-obj.round-method = p-round-method
     1442       buf_gds-grp-obj.round-coef = p-base
     1443       buf_gds-grp-obj.calc-method = p-calc-method
     1444       .
     1445     end.
     1446     if p-fill-tax-from-upper then do:
     1447       run ref/dtaxgrpu.p (
     1448                        input p-node-code
     1449                       ,input p-upper-code
     1450                       ,input yes
     1451                       ,input 0
     1452                       ,input "":U
     1453                       ,input 0
     1454                       )  no-error.
     1455       if error-status:error then do:
     1456         assign
     1457         v-error-message = substitute("Группа &1&2Ошибка при сохранении записей НАЛОГИ ПО УМОЛЧАНИЮ ДЛЯ ГРУППЫ ТОВАРОВ&2&3&2&4"
     1458                                     , v-full-name
     1459                                     , chr(10)
     1460                                     , error-status:get-message(1)
     1461                                     , return-value
     1462                                     ).
     1463         run err-mess in this-procedure ( input-output v-error-message).
     1464         undo main-block, return error (if p-silent then v-error-message else "").
     1465       end.
     1466     END.
     1467   end.
     1468   PROCEDURE err-mess:
     1469     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
     1470     CASE p-silent:
     1471       when yes then do:
     1472         assign
     1473         p-mess = substitute("Группа c внутр. №: &1 (&2):&3&4"
     1474                            , p-node-code
     1475                            , p-node-name
     1476                            , chr(10)
     1477                            , p-mess)
     1478         .
     1479       end.
     1480       when no then do:
     1481         message
     1482         p-mess
     1483         view-as alert-box error .
     1484       end.
     1485     end.
     1486   END PROCEDURE.
