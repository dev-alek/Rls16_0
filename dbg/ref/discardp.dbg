      775   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      776   procedure cur-time :
      777      define output parameter p-today as date      no-undo .
      778      define output parameter p-time  as integer   no-undo .
      779     do
      780     on error undo, return error
      781     :
      782       define variable v-date1 as date      no-undo .
      783       define variable v-date2 as date      no-undo .
      784       define variable v-time  as integer   no-undo .
      785       assign
      786         v-date1 = today
      787         v-time  = time
      788         v-date2 = today
      789       .
      790       if v-date1 <> v-date2
      791       then do:
      792         assign
      793           v-date1 = today
      794           v-time  = v-time
      795         .
      796       end.
      797       assign
      798         p-today = v-date1
      799         p-time  = v-time
      800       .
      801     end.
      802   end.
      803   function cur-time-date returns character
      804   :
      805     return string(today, '99/99/9999':U) .
      806   end.
      807   function cur-time-mjd returns decimal
      808   :
      809     define variable v-date as date      no-undo .
      810     define variable v-time as integer   no-undo .
      811     run cur-time in this-procedure
      812       (output v-date
      813       ,output v-time
      814       ) .
      815     return integer(v-date) - 2400002 + (v-time / 86400) .
      816   end.
      817   function cur-time-get-ending-index returns integer
      818   (input p-number as integer
      819   )
      820   :
      821     if p-number < 0
      822     or p-number = ?
      823     then do:
      824       return 1 .
      825     end.
      826     define variable v-rest as integer   no-undo .
      827     assign
      828       p-number = p-number modulo 100
      829     .
      830     if p-number < 20
      831     then do:
      832       assign
      833         v-rest = p-number
      834       .
      835     end.
      836     else do:
      837       assign
      838         v-rest = p-number modulo 10
      839       .
      840     end.
      841     case v-rest :
      842       when 1
      843       then do:
      844         return 2 .
      845       end.
      846       when 2 or
      847       when 3 or
      848       when 4
      849       then do:
      850         return 3 .
      851       end.
      852       otherwise do:
      853         return 1 .
      854       end.
      855     end case .
      856   end.
      857   procedure cur-time-mjd-to-date :
      858      define input  parameter i-mjd-diff as decimal no-undo.
      859      define output parameter o-Date     as date    no-undo.
      860      define output parameter o-Time     as integer no-undo.
      861      define variable v-day-number as integer   no-undo .
      862      if    i-mjd-diff < 0
      863         or i-mjd-diff = ?
      864      then do:
      865         return "?" .
      866      end.
      867      assign
      868         v-day-number = truncate(i-mjd-diff,0).
      869         o-Date = date(v-day-number + 2400002).
      870         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      871     .
      872   end.
      873   function cur-time-mjd-to-string returns character
      874   (input p-mjd-diff as decimal
      875   )
      876   :
      877     define variable v-day-number as integer   no-undo .
      878     define variable v-seconds    as integer   no-undo .
      879     define variable v-hour       as integer   no-undo .
      880     define variable v-min        as integer   no-undo .
      881     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      882     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      883     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      884     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      885     if p-mjd-diff < 0
      886     or p-mjd-diff = ?
      887     then do:
      888       return "?" .
      889     end.
      890     assign
      891       v-day-number = integer(truncate(p-mjd-diff,0))
      892       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      893     .
      894     if v-seconds > 86400
      895     then do:
      896       assign
      897         v-seconds = 86400 - 1
      898       .
      899     end.
      900     if v-seconds < 0
      901     then do:
      902       assign
      903         v-seconds = 0
      904       .
      905     end.
      906     assign
      907       v-hour = truncate(v-seconds / 3600, 0)
      908     .
      909     assign
      910       v-seconds = v-seconds modulo 3600
      911     .
      912     assign
      913       v-min = truncate(v-seconds / 60, 0)
      914     .
      915     assign
      916       v-seconds = v-seconds modulo 60
      917     .
      918     return
      919         (if v-day-number <> 0
      920           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      921           else ""
      922         )
      923       + (if v-day-number <> 0 or v-hour <> 0
      924           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      925           else ""
      926         )
      927       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      928           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      929           else ""
      930         )
      931       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      932       .
      933   end.
      934   function cur-time-string returns character
      935   :
      936     define variable v-date as date      no-undo .
      937     define variable v-time as integer   no-undo .
      938     run cur-time in this-procedure
      939       (output v-date
      940       ,output v-time
      941       ) .
      942     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      943   end.
      944   function cur-time-string-sec returns character
      945   :
      946     define variable v-date as date      no-undo .
      947     define variable v-time as integer   no-undo .
      948     run cur-time in this-procedure
      949       (output v-date
      950       ,output v-time
      951       ) .
      952     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      953   end.
      954   function cur-time-custom  returns character
      955   (input p-prefix as character
      956   ,input p-date-format as character
      957   ,input p-delimiter as character
      958   ,input p-time-format as character
      959   ,input p-suffix as character
      960   )
      961   :
      962     define variable v-date as date      no-undo .
      963     define variable v-time as integer   no-undo .
      964     run cur-time in this-procedure
      965       (output v-date
      966       ,output v-time
      967       ) .
      968     return
      969       p-prefix
      970       + string(v-date, p-date-format)
      971       + p-delimiter
      972       + string(v-time, p-time-format)
      973       + p-suffix
      974       .
      975   end.
      976   function cur-time-print  returns character
      977   :
      978     define variable v-date as date      no-undo .
      979     define variable v-time as integer   no-undo .
      980     run cur-time in this-procedure
      981       (output v-date
      982       ,output v-time
      983       ) .
      984     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      985   end.
      986   function cur-time-datetime returns datetime
      987   :
      988     define variable v-char as character no-undo .
      989     define variable v-datetime as datetime no-undo .
      990     v-char = cur-time-string().
      991     v-datetime = datetime(v-char).
      992     return  v-datetime.
      993   end.
      994   function cur-time-string-msec returns character
      995   :
      996     define variable v-date as datetime  no-undo .
      997     v-date = now.
      998     return string(v-date) .
      999   end.
     1000   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1001   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1002   FUNCTION get-d-pcnt RETURNS CHARACTER
     1003     ( buffer loc-dis-card for ub.dis-card,
     1004       input parhost-code as integer,
     1005       input parobj-type as character,
     1006       input parobj-code as integer,
     1007       input p-discnt-role as character,
     1008       output loc-d-v as decimal) :
     1009   define variable v-node-code as integer no-undo .
     1010   define buffer buf_dis-card-type for ub.dis-card-type.
     1011   define buffer buf_dis-card-property for ub.dis-card-property.
     1012   find first buf_dis-card-type no-lock where
     1013             buf_dis-card-type.type = loc-dis-card.type
     1014         and buf_dis-card-type.emitent-host-code = loc-dis-card.emitent-host-code
     1015         and buf_dis-card-type.host-code = 0
     1016         and buf_dis-card-type.obj-type = '':U
     1017         and buf_dis-card-type.obj-code = 0 no-error.
     1018   if available buf_dis-card-type then do:
     1019     case p-discnt-role:
     1020       when 'def-pcnt':U  then do:
     1021         assign
     1022         v-node-code = 1.
     1023       end.
     1024       when 'def-cash-pcnt':U then do:
     1025         assign
     1026         v-node-code = 2.
     1027       end.
     1028       when 'def-categ':U then do:
     1029         assign
     1030         v-node-code = 3.
     1031       end.
     1032     end.
     1033     if buf_dis-card-type.d-pcnt-byshop then do:
     1034      find first buf_dis-card-property no-lock where
     1035                buf_dis-card-property.d-card = loc-dis-card.d-card
     1036            and buf_dis-card-property.dtm-code = 26
     1037            and buf_dis-card-property.host-code = parhost-code
     1038            and buf_dis-card-property.obj-type = parobj-type
     1039            and buf_dis-card-property.obj-code = parobj-code
     1040            and buf_dis-card-property.node-code = v-node-code no-error.
     1041      if available buf_dis-card-property then do:
     1042        if p-discnt-role = 'def-categ':U then do:
     1043          assign
     1044          loc-d-v = buf_dis-card-property.property-value-integer.
     1045        end.
     1046        else do:
     1047          assign
     1048          loc-d-v = buf_dis-card-property.property-value-decimal.
     1049        end.
     1050      end.
     1051       if loc-d-v = ? then do:
     1052   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1053   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     1054     (
     1055      input  loc-dis-card.type
     1056     ,input  loC-dis-card.emitent-host-code
     1057     ,input  parhost-code
     1058     ,input  parobj-type
     1059     ,input  parobj-code
     1060     ,input  p-discnt-role
     1061     ,output loc-d-v
     1062     ) no-error .
     1063       end.
     1064       if loc-d-v = ? then do:
     1065         find first buf_dis-card-property no-lock where
     1066                   buf_dis-card-property.d-card = loc-dis-card.d-card
     1067               and buf_dis-card-property.dtm-code = 26
     1068               and buf_dis-card-property.host-code = parhost-code
     1069               and buf_dis-card-property.obj-type = ''
     1070               and buf_dis-card-property.obj-code = 0
     1071               and buf_dis-card-property.node-code = v-node-code no-error.
     1072         if available buf_dis-card-property then do:
     1073           if p-discnt-role = 'def-categ':U then do:
     1074             assign
     1075             loc-d-v = buf_dis-card-property.property-value-integer.
     1076           end.
     1077           else do:
     1078             assign
     1079             loc-d-v = buf_dis-card-property.property-value-decimal.
     1080           end.
     1081         end.
     1082       end.
     1083       if loc-d-v = ? then do:
     1084   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1085   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
     1086     (
     1087      input  loc-dis-card.type
     1088     ,input  loC-dis-card.emitent-host-code
     1089     ,input  parhost-code
     1090     ,input  ''
     1091     ,input  0
     1092     ,input  p-discnt-role
     1093     ,output loc-d-v
     1094     ) no-error .
     1095       end.
     1096       if loc-d-v = ? then do:
     1097         case p-discnt-role:
     1098           when 'def-categ':U then do:
     1099             loc-d-v = loc-dis-card.category.
     1100           end.
     1101           when 'def-pcnt':U then do:
     1102             loc-d-v = loc-dis-card.d-pcnt.
     1103           end.
     1104           when 'def-cash-pcnt':U then do:
     1105             loc-d-v = loc-dis-card.cash-d-pcnt.
     1106           end.
     1107         end case.
     1108       end.
     1109       if p-discnt-role = 'def-categ':U then do:
     1110         return substitute("(i) &1", string(loc-d-v, ">>>9")).
     1111       end.
     1112       else do:
     1113         return substitute("(i) &1", string(loc-d-v, "->9.99%")).
     1114       end.
     1115     end.
     1116   end.
     1117   else do:
     1118    return "ОШИБКА-НЕТ ТИПА".
     1119   end.
     1120   case p-discnt-role:
     1121     when 'def-categ':U then do:
     1122        loc-d-v = loc-dis-card.category.
     1123        return string(loc-d-v, ">>>9").
     1124     end.
     1125     when 'def-pcnt':U then do:
     1126       loc-d-v = loc-dis-card.d-pcnt.
     1127       return string(loc-d-v, "->9.99%").
     1128     end.
     1129     when 'def-cash-pcnt':U then do:
     1130       loc-d-v = loc-dis-card.cash-d-pcnt.
     1131       return string(loc-d-v, "->9.99%").
     1132     end.
     1133   end case.
     1134   END FUNCTION.
     1135   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1136   define variable num-chk as integer no-undo.
     1137   define variable gds-sum as decimal no-undo.
     1138   define variable disc-sum as decimal no-undo.
     1139   define variable netto-sum as decimal no-undo.
     1140   define variable pay-sum as decimal no-undo.
     1141   define variable credit-sum as decimal no-undo.
     1142   define variable saldo-sum as decimal no-undo.
     1143   define variable gds-sum-ch as char no-undo.
     1144   define variable disc-sum-ch as char no-undo.
     1145   define variable netto-sum-ch as char no-undo.
     1146   define variable pay-sum-ch as char no-undo.
     1147   define variable credit-sum-ch as char no-undo.
     1148   define variable pravo as logical no-undo.
     1149   define variable smart-pravo as logical no-undo .
     1150   FUNCTION get-cli-name RETURNS CHARACTER
     1151     (  input p-cli-type as character, input p-cli-code as integer ) :
     1152   define buffer buf_clients for ub.clients.
     1153   find first buf_clients no-lock where buf_clients.obj-type = p-cli-type
     1154   and buf_clients.obj-code = p-cli-code no-error.
     1155   if available buf_clients then return buf_clients.obj-name.
     1156   RETURN (p-cli-type + string(p-cli-code)).
     1157   END FUNCTION.
     1158   FUNCTION Get-num-chk RETURNS CHARACTER(input rs-val as character
     1159                                        , input p-pravo as logical
     1160                                        , buffer buf_dis-card for ub.dis-card
     1161                                        , input p-db-num as integer
     1162                                        ):
     1163   DEFINE variable num-chk-ch as char no-undo.
     1164   define variable loc-smart-pravo as logical no-undo .
     1165   define buffer buf_dis-host for ub.dis-host.
     1166   define buffer buf_hist-nws-option for ub.hist-nws-option.
     1167     if NOT p-pravo then do:
     1168         assign
     1169         num-chk = 0
     1170         gds-sum-ch = ""
     1171         disc-sum-ch = ""
     1172         netto-sum-ch = ""
     1173         pay-sum-ch = ""
     1174         credit-sum-ch = ""
     1175         .
     1176         return "Нет прав".
     1177     end.
     1178     IF not avail buf_dis-card then do:
     1179         assign
     1180         num-chk = 0
     1181         gds-sum-ch = ""
     1182         disc-sum-ch = ""
     1183         netto-sum-ch = ""
     1184         pay-sum-ch = ""
     1185         credit-sum-ch = ""
     1186         .
     1187         return "".
     1188     end.
     1189     assign
     1190     num-chk = 0
     1191     gds-sum = 0
     1192     disc-sum = 0
     1193     netto-sum = 0
     1194     pay-sum = 0
     1195     credit-sum = 0
     1196     .
     1197     if p-db-num > 0 then do:
     1198       find first buf_HIST-NWS-OPTION WHERE
     1199         buf_HIST-NWS-OPTION.db-num = 0
     1200         and buf_hist-nws-option.table-name = 'dis-host':U
     1201         and buf_hist-nws-option.host-code = buf_dis-card.emitent-host-code
     1202         and buf_hist-nws-option.obj-type = '':U
     1203         and buf_hist-nws-option.obj-code = 0
     1204         and buf_hist-nws-option.key#_one = 1
     1205         and buf_hist-nws-option.charkey_one = buf_dis-card.type
     1206         and buf_hist-nws-option.subject-group = 'c-dc-hist':U NO-ERROR.
     1207       if available buf_hist-nws-option
     1208       and buf_hist-nws-option.smart-nws >= 0 then loc-smart-pravo = yes.
     1209       if loc-smart-pravo then do:
     1210         assign
     1211         num-chk = ?
     1212         gds-sum = ?
     1213         disc-sum = ?
     1214         netto-sum = ?
     1215         pay-sum = ?
     1216         credit-sum = ?
     1217         .
     1218         return "".
     1219       end.
     1220     end.
     1221     find first buf_Dis-host no-lock where
     1222               buf_dis-host.host-code = buf_Dis-card.emitent-host-code
     1223           and buf_dis-host.d-card = buf_Dis-card.d-card
     1224           and buf_Dis-host.dt-code = 0 no-error.
     1225     if not available buf_Dis-host then return "".
     1226     IF RS-val = 'rubl':U then do:
     1227       assign
     1228       num-chk = buf_dis-host.num-chk
     1229       gds-sum = buf_dis-host.gds-tot-rubl
     1230       disc-sum = buf_dis-host.gds-dis-rubl
     1231       netto-sum = gds-sum - disc-sum
     1232       pay-sum = buf_dis-host.pay-tot-rubl
     1233       credit-sum = netto-sum - pay-sum
     1234       saldo-sum = buf_dis-card.saldo-rubl.
     1235     end.
     1236     else do:
     1237       assign
     1238       num-chk = buf_dis-host.num-chk
     1239       gds-sum = buf_dis-host.gds-tot-base
     1240       disc-sum = buf_dis-host.gds-dis-base
     1241       netto-sum = gds-sum - disc-sum
     1242       pay-sum = buf_dis-host.pay-tot-base
     1243       credit-sum = netto-sum - pay-sum
     1244       saldo-sum = buf_dis-card.saldo-base.
     1245     end.
     1246     assign
     1247     gds-sum-ch = string(gds-sum, "->>>,>>>,>>9.99")
     1248     disc-sum-ch = string(disc-sum, "->>>,>>>,>>9.99")
     1249     netto-sum-ch = string(netto-sum, "->>>,>>>,>>9.99")
     1250     pay-sum-ch = string(pay-sum, "->>>,>>>,>>9.99")
     1251     num-chk-ch = string(num-chk, "->>>>>>>9")
     1252     credit-sum-ch = string(credit-sum, "->>>,>>>,>>9.99")
     1253     .
     1254     RETURN num-chk-ch.
     1255   END FUNCTION.
     1256   FUNCTION Get-num-chk-l RETURNS integer(input rs-val as character
     1257                                        , input p-pravo as logical
     1258                                        , input p-num-chk as integer
     1259                                        , input p-type as character
     1260                                        , input p-emitent-host-code as integer
     1261                                        , input p-db-num as integer
     1262                                        ):
     1263   define buffer buf_hist-nws-option for ub.hist-nws-option.
     1264     smart-pravo = no.
     1265     if NOT p-pravo then do:
     1266       return 0.
     1267     end.
     1268     if p-db-num > 0 then do:
     1269       find first buf_HIST-NWS-OPTION WHERE
     1270         buf_HIST-NWS-OPTION.db-num = 0
     1271         and buf_hist-nws-option.table-name = 'dis-host':U
     1272         and buf_hist-nws-option.host-code = p-emitent-host-code
     1273         and buf_hist-nws-option.obj-type = '':U
     1274         and buf_hist-nws-option.obj-code = 0
     1275         and buf_hist-nws-option.key#_one = 1
     1276         and buf_hist-nws-option.charkey_one = p-type
     1277         and buf_hist-nws-option.subject-group = 'c-dc-hist':U NO-ERROR.
     1278       if available buf_hist-nws-option
     1279       and buf_hist-nws-option.smart-nws >= 0 then smart-pravo = yes.
     1280       else smart-pravo = no.
     1281     end.
     1282     if smart-pravo then return ?.
     1283     return p-num-chk.
     1284   end FUNCTION.
     1285   FUNCTION Get-gds-sum-l RETURNS decimal(
     1286                                          input rs-val as character
     1287                                        , input p-pravo as logical
     1288                                        , input p-gds-tot-rubl as decimal
     1289                                        , input p-gds-tot-base as decimal):
     1290     if NOT p-pravo then do:
     1291       return 0.0.
     1292     end.
     1293     if smart-pravo then return ?.
     1294     if rs-val = 'rubl':U then
     1295     return p-gds-tot-rubl.
     1296     else
     1297     return p-gds-tot-base.
     1298   end FUNCTION.
     1299   FUNCTION Get-disc-sum-l RETURNS decimal(input rs-val as character
     1300                                        , input p-pravo as logical
     1301                                        , input p-gds-dis-rubl as decimal
     1302                                        , input p-gds-dis-base as decimal):
     1303     if NOT p-pravo then do:
     1304       return 0.0.
     1305     end.
     1306     if smart-pravo then return ?.
     1307     if rs-val = 'rubl':U then
     1308     return p-gds-dis-rubl.
     1309     else
     1310     return p-gds-dis-base.
     1311   end FUNCTION.
     1312   FUNCTION Get-netto-sum-l RETURNS decimal(input rs-val as character
     1313                                        , input p-pravo as logical
     1314                                        , input p-gds-tot-rubl as decimal
     1315                                        , input p-gds-tot-base as decimal
     1316                                        , input p-gds-dis-rubl as decimal
     1317                                        , input p-gds-dis-base as decimal):
     1318     if NOT p-pravo then do:
     1319       return 0.0.
     1320     end.
     1321     if smart-pravo then return ?.
     1322     if rs-val = 'rubl':U then
     1323     return (p-gds-tot-rubl - p-gds-dis-rubl).
     1324     else
     1325     return (p-gds-tot-base - p-gds-dis-base).
     1326   end FUNCTION.
     1327   FUNCTION Get-pay-sum-l RETURNS decimal(input rs-val as character
     1328                                        , input p-pravo as logical
     1329                                        , buffer buf_dis-host for ub.dis-host):
     1330     if NOT p-pravo then do:
     1331       return 0.0.
     1332     end.
     1333     if smart-pravo then return ?.
     1334     if rs-val = 'rubl':U then
     1335     return buf_dis-host.pay-tot-rubl.
     1336     else
     1337     return buf_dis-host.pay-tot-base.
     1338   end FUNCTION.
     1339   FUNCTION Get-credit-sum-l RETURNS decimal(input rs-val as character
     1340                                        , input p-pravo as logical
     1341                                        , input p-gds-tot-rubl as decimal
     1342                                        , input p-gds-tot-base as decimal
     1343                                        , input p-gds-dis-rubl as decimal
     1344                                        , input p-gds-dis-base as decimal
     1345                                        , input p-pay-tot-rubl as decimal
     1346                                        , input p-pay-tot-base as decimal):
     1347     if NOT p-pravo then do:
     1348       return 0.0.
     1349     end.
     1350     if smart-pravo then return ?.
     1351     if rs-val = 'rubl':U then
     1352     return (p-gds-tot-rubl - p-gds-dis-rubl - p-pay-tot-rubl).
     1353     else
     1354     return (p-gds-tot-base - p-gds-dis-base - p-pay-tot-base).
     1355   end FUNCTION.
     1356   FUNCTION Get-saldo-l RETURNS decimal(input rs-val as character
     1357                                        , input p-pravo as logical
     1358                                        , buffer buf_dis-card for ub.dis-card):
     1359     if NOT p-pravo then do:
     1360       return 0.0.
     1361     end.
     1362     if smart-pravo then return ?.
     1363     if rs-val = 'rubl':U then
     1364     return buf_dis-card.saldo-rubl.
     1365     else
     1366     return buf_dis-card.saldo-base.
     1367   end FUNCTION.
     1368   define variable g#report-num as integer   no-undo .
     1369   procedure OpenForExcel :
     1370      define variable v-ch#ExcelApplication as com-handle no-undo .
     1371      define variable v-ch#Workbook         as com-handle no-undo .
     1372      define variable v-ch#Worksheet        as com-handle no-undo .
     1373      os-delete value( string( session:temp-directory ) +
     1374                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     1375      os-delete value( string( session:temp-directory ) +
     1376                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     1377      os-delete value( string( session:temp-directory ) +
     1378                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     1379      if Make-Excel
     1380      then do:
     1381         output stream ForExcel to value( string( session:temp-directory +
     1382                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     1383         assign
     1384            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     1385            number-list = 1
     1386         .
     1387         if make-excel-com
     1388         then do:
     1389   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1390   if valid-handle(ch#WorkSheet) then
     1391   RELEASE OBJECT ch#WorkSheet no-error.
     1392   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1393   if valid-handle(ch#Workbook) then
     1394   RELEASE OBJECT ch#Workbook no-error.
     1395   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1396   if valid-handle(ch#ExcelApplication) then
     1397   RELEASE OBJECT ch#ExcelApplication no-error.
     1398            create "Excel.Application" ch#excelApplication connect no-error.
     1399            if error-status:error
     1400            then do :
     1401           create "Excel.Application" ch#excelApplication no-error.
     1402       if error-status :error then do:
     1403           message
     1404           "Ошибка при запуске Excel" skip
     1405           error-status :get-message(1) skip
     1406           view-as alert-box error .
     1407           undo, return error .
     1408       end.
     1409            end.
     1410            assign
     1411               num#str#  = 0.
     1412               v-ch#excelApplication  = ch#excelApplication.
     1413               v-ch#excelApplication:Interactive = false.
     1414               v-ch#excelApplication:ScreenUpdating = false.
     1415               v-ch#excelApplication:Visible = false.
     1416               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     1417               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     1418               v-ch#Worksheet = ch#WorkSheet.
     1419               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     1420               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     1421               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     1422               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     1423            no-error .
     1424            if error-status:error
     1425            then do:
     1426               Make-Excel-com = false .
     1427               Make-Excel = false .
     1428               output Stream  ForExcel close.
     1429               os-delete value( string( session:temp-directory ) +
     1430                              "rpt" + string( g#report-num ) + ".txt":U ) .
     1431               os-delete value( string( session:temp-directory ) +
     1432                              "rpt" + string( g#report-num ) + ".frm":U ) .
     1433               return.
     1434            end.
     1435         end.
     1436      end.
     1437   end.
     1438   procedure CloseForExcel :
     1439      define variable ii as integer no-undo .
     1440      define variable vsheet-num as integer no-undo.
     1441      if Make-Excel
     1442      then  do:
     1443         output Stream  ForExcel close.
     1444         os-delete value( string( session:temp-directory ) +
     1445                                "rpt" + string( g#report-num ) + ".txt":U ) .
     1446         os-delete value( string( session:temp-directory ) +
     1447                                "rpt" + string( g#report-num ) + ".frm":U ) .
     1448         define buffer buf_sheetf for sheetf.
     1449         find last buf_sheetf no-error .
     1450         if available buf_sheetf
     1451         then
     1452            vsheet-num = buf_sheetf.sheet-num.
     1453         if vsheet-num > 1
     1454         then do:
     1455            do ii = 2 to vsheet-num:
     1456               os-delete value( string( session:temp-directory ) +
     1457                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     1458            end.
     1459         end.
     1460   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1461   if valid-handle(ch#WorkSheet) then
     1462   RELEASE OBJECT ch#WorkSheet no-error.
     1463   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1464   if valid-handle(ch#Workbook) then
     1465   RELEASE OBJECT ch#Workbook no-error.
     1466   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1467   if valid-handle(ch#ExcelApplication) then
     1468   RELEASE OBJECT ch#ExcelApplication no-error.
     1469      end.
     1470   end.
     1471   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1472   define variable v-waitfram-action01         as character   no-undo .
     1473   define variable v-waitfram-action02         as character   no-undo .
     1474   define variable v-waitfram-action03         as character   no-undo .
     1475   define variable mWaitFramTextBeg            as character   no-undo.
     1476   define variable mWaitFramTextEnd            as character   no-undo.
     1477   define variable mWaitFramView               as logical     no-undo.
     1478   define variable mWaitProcEvent              as logical     no-undo init yes.
     1479   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1480   define variable mWaitFramStop               as logical     no-undo.
     1481   define variable mWaitFramStopUser           as logical     no-undo.
     1482   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1483   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1484   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1485   define button B-WaitFramStop auto-end-key
     1486        label "Стоп"
     1487        size 10 by 1 tooltip "Остоновить процесс".
     1488   define button B-viewProcInfo
     1489        label "Информация"
     1490        size 15 by 1 tooltip "Информация о процесс".
     1491   define frame waitfram
     1492     v-waitfram-action01 format "x(72)" no-label skip
     1493     v-waitfram-action02 format "x(72)" no-label skip
     1494     v-waitfram-action03 format "x(72)" no-label skip
     1495     B-viewProcInfo
     1496     B-WaitFramStop at row 4 col 30
     1497     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1498     .
     1499   define new global shared variable mBatchMode as logical no-undo init ?.
     1500   define variable mFramBachModHandle as handle no-undo.
     1501   mFramBachModHandle = frame waitfram:handle.
     1502   define variable mFameOldVis as logical no-undo.
     1503   define variable mVisCUrentVin as logical no-undo.
     1504   if session:batch-mode
     1505   then
     1506      mBatchMode = yes.
     1507   if mBatchMode = ? then do:
     1508     mVisCUrentVin = current-window:visible.
     1509     mFameOldVis = mFramBachModHandle:visible.
     1510     mFramBachModHandle:visible  = yes.
     1511     mBatchMode = mFramBachModHandle:visible ne yes.
     1512     mFramBachModHandle:visible = mFameOldVis.
     1513     current-window:visible = mVisCUrentVin.
     1514   end.
     1515    if  log-manager:logfile-name ne ?
     1516     then DO:
     1517         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1518         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1519         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1520     end.
     1521   on choose of B-WaitFramStop in frame waitfram
     1522   do:
     1523     mWaitFramStop = yes.
     1524     mWaitFramStopUser = yes.
     1525   end.
     1526   function waitfram-check-timeout returns logical():
     1527      define variable vtime as int64 no-undo.
     1528      if mWaitFramStopTimeOut
     1529      then
     1530         return yes.
     1531      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1532      if     mWaitFramTimeOut ne ?
     1533         and mWaitFramTimeOut ne 0
     1534         and mWaitFramTimeOut lt vtime
     1535      then do:
     1536         mWaitFramStopTimeOut = yes.
     1537      end.
     1538      return mWaitFramStopTimeOut.
     1539   end.
     1540   procedure waitfram-hide :
     1541     if not session:batch-mode
     1542     then do
     1543     on error undo, return error return-value
     1544     :
     1545       pause 0 before-hide .
     1546       if not mBatchMode then
     1547         hide frame waitfram .
     1548     if     not mWaitFramView
     1549        and mWaitProcEvent
     1550     then
     1551       process events .
     1552     end.
     1553   end procedure.
     1554   procedure waitfram-show :
     1555     define input  parameter p-message as character no-undo .
     1556     define variable v-left-margin as integer   no-undo .
     1557     if not session:batch-mode
     1558     then do
     1559     on error undo, return error return-value
     1560     :
     1561       if length(p-message) <= 70 then do:
     1562         assign
     1563           v-left-margin = integer((70 - length(p-message)) / 2)
     1564         .
     1565         assign
     1566           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1567         .
     1568         assign
     1569           v-waitfram-action01 = " "
     1570           v-waitfram-action02 = " "
     1571                                    + fill(" ", v-left-margin)
     1572                                    + p-message
     1573           v-waitfram-action03 = " "
     1574         .
     1575       end.
     1576       else do:
     1577         define variable vRindex1 as integer no-undo.
     1578         define variable vRindex2 as integer no-undo.
     1579         vRindex1 = r-index(p-message," ",70).
     1580         if vRindex1 = 0
     1581         then
     1582            vRindex1 = 70.
     1583         if length(p-message)  <= vRindex1 + 70 then do:
     1584           assign
     1585             v-waitfram-action01 = " "
     1586             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1587             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1588           .
     1589         end.
     1590         else do:
     1591           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1592           if vRindex2 <= vRindex1
     1593           then
     1594              vRindex2 = vRindex1 + 70.
     1595           assign
     1596             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1597             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1598             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1599           .
     1600         end.
     1601       end.
     1602       B-viewProcInfo:visible   in frame waitfram = no.
     1603       B-viewProcInfo:sensitive in frame waitfram = no.
     1604       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1605       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1606       if  (   mWaitFramView
     1607          or  mWaitProcEvent)
     1608          and not mBatchMode
     1609       then
     1610          display
     1611             v-waitfram-action01 skip
     1612             v-waitfram-action02 skip
     1613             v-waitfram-action03 skip
     1614          with frame waitfram .
     1615       if     mWaitFramView
     1616          then do:
     1617             if     mWaitFramInterval ne ?
     1618                and not mBatchMode
     1619             then
     1620                wait-for go of frame waitfram pause mWaitFramInterval.
     1621          end.
     1622          else
     1623             if     mWaitProcEvent
     1624                and not mBatchMode
     1625             then
     1626                process events .
     1627     end.
     1628   end procedure.
     1629      procedure waitfram-show-this:
     1630         define input  parameter iInterval as int64 no-undo.
     1631         define variable vtime as int64 no-undo.
     1632         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1633         mWaitFramInterval = iInterval.
     1634         run waitfram-show (substitute("&1&2 &3&4" ,
     1635                                       mWaitFramTextBeg ,
     1636                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1637                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1638                                       mWaitFramTextEnd
     1639                                      )
     1640                           ).
     1641      end.
     1642      procedure WaitFramRunPause:
     1643         define input  parameter iInterval as dec no-undo.
     1644         define variable vStart  as datetime-tz no-undo.
     1645         define variable vend    as datetime-tz no-undo.
     1646         define variable vint as int64 no-undo.
     1647         define variable vOk as logical no-undo.
     1648         vStart = now.
     1649         vend   = vStart.
     1650         publish "WaitFramPause" (iInterval,output vOk).
     1651         vend   =  now.
     1652         vint = vend - vStart.
     1653         vint = iInterval - vint / 1000.
     1654         if     not mWaitFramStop
     1655            and (   vint > 0
     1656                 or (    not vOk
     1657                     and iInterval eq ?
     1658                     )
     1659                 )
     1660         then
     1661            run waitfram-show-this (iInterval).
     1662         vend   =  now.
     1663         vint = vend - vStart.
     1664         vint = iInterval - vint / 1000.
     1665         if     not mWaitFramStop
     1666            and vint > 0
     1667         then do:
     1668            run gbl/pause.p (vint * 1000).
     1669         end.
     1670         if iInterval ne ?
     1671         then
     1672            publish "WaitFramStop".
     1673         waitfram-check-timeout().
     1674      end.
     1675      procedure WaitFramWaitFor:
     1676         define input  parameter iInterval as dec no-undo.
     1677         assign
     1678            mWaitFramStartProc   = now
     1679            mWaitFramStopUser    = no
     1680            mWaitFramStopTimeOut = no
     1681         .
     1682         block-wait:
     1683         do while not mWaitFramStop:
     1684            run WaitFramRunPause (iInterval).
     1685            if  waitfram-check-timeout()
     1686            then do:
     1687               leave block-wait.
     1688            end.
     1689         end.
     1690         run waitfram-hide.
     1691      end.
     1692   procedure waitfram-join :
     1693     define input  parameter p-line-1  as character no-undo .
     1694     define input  parameter p-line-2  as character no-undo .
     1695     define input  parameter p-line-3  as character no-undo .
     1696     define output parameter p-message as character no-undo .
     1697     do
     1698     on error undo, return error return-value
     1699     :
     1700       assign
     1701         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1702                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1703                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1704       .
     1705     end.
     1706   end procedure.
     1707   function waitfram-join-function returns character
     1708     (input p-line-1 as character
     1709     ,input p-line-2 as character
     1710     ,input p-line-3 as character
     1711     ).
     1712     define variable v-message as character no-undo .
     1713     run waitfram-join in this-procedure
     1714       (input  p-line-1
     1715       ,input  p-line-2
     1716       ,input  p-line-3
     1717       ,output v-message
     1718       ) .
     1719     return v-message .
     1720   end function .
