      497       run gbl/getlocal.p ( output v-delim  , output v-del-1, output v-sdate, output v-shortdate ) no-error .
      498       if error-status :error then do:
      499         message error-status :error error-status :get-message(1)
      500                 v-delim v-del-1.
      501           v-delim = ','  .
      502       end.
      503   end.
