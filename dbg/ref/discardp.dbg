     1977       with frame List .
     1978       DOWN stream PrnLibStream 1
     1979       with frame List .
     1980       if Make-Excel then  put   stream ForExcel unformatted
     1981       X_dis-card.d-card                                                        CHR(9)
     1982       for-d-pcnt                                                               CHR(9)
     1983       loc-d-pcnt                                                               CHR(9)
     1984       X_dis-card.category                                                      CHR(9)
     1985       ( X_dis-card.cli-type + " " +  STRING ( X_dis-card.cli-code ) )          CHR(9)
     1986       get-cli-name(X_dis-card.cli-type, X_dis-card.cli-code)                   CHR(9)
     1987       X_dis-card.issue-code                                                    CHR(9)
     1988       X_dis-card.issue-date                                                    CHR(9)
     1989       X_dis-card.type                                                          CHR(9)
     1990       X_dis-card.credit-card                                                   CHR(9)
     1991       X_dis-card.status_                                                       CHR(9)
     1992       X_dis-card.emitent-host-code
     1993       skip.
     1994     end.
     1995     ii =  ii + 1 .
     1996     if ( ( ii modulo 10 ) = 0 ) AND ( ii >= 10 ) then
     1997     run waitfram-show in this-procedure ( "Просмотрено строк : " + string( ii ) ) .
     1998     p-qh:GET-next (no-lock) .
     1999   END.
     2000   if p-pravo then do:
     2001     UNDERLINE stream PrnLibStream
     2002     X_dis-card.d-card
     2003     for-d-pcnt
     2004     X_dis-card.d-pcnt
     2005     X_dis-card.category
     2006     cli-attr
     2007     cli-name
     2008     X_dis-card.issue-code
     2009     X_dis-card.issue-date
     2010     X_dis-card.valid-date
     2011     for-type
     2012     for-status
     2013     X_dis-card.emitent-host-code
     2014     num-chk
     2015     gds-sum
     2016     disc-sum
     2017     netto-sum
     2018     credit-sum
     2019     saldo-sum
     2020     with frame List-pravo .
     2021     DISPLAY stream PrnLibStream
     2022     substitute("Итого &1 карт", ii) @ X_dis-card.d-card
     2023     dop-num-chk @ num-chk
     2024     dop-gds-sum  @ gds-sum
     2025     dop-disc-sum @ disc-sum
     2026     dop-netto-sum @ netto-sum
     2027     dop-credit-sum @ credit-sum
     2028     dop-saldo-sum @ saldo-sum
     2029     with frame List-pravo .
     2030     if Make-Excel then  put   stream ForExcel unformatted
     2031     skip
     2032     substitute("Итого &1 карт", ii)                                     CHR(9)
     2033                                                                         CHR(9)
     2034                                                                         CHR(9)
     2035                                                                         CHR(9)
     2036                                                                         CHR(9)
     2037                                                                         CHR(9)
     2038                                                                         CHR(9)
     2039                                                                         CHR(9)
     2040                                                                         CHR(9)
     2041                                                                         CHR(9)
     2042                                                                         CHR(9)
     2043                                                                         CHR(9)
     2044     dop-num-chk                                                         CHR(9)
     2045     dop-gds-sum                                                         CHR(9)
     2046     dop-disc-sum                                                        CHR(9)
     2047     dop-netto-sum                                                       CHR(9)
     2048     dop-credit-sum                                                      CHR(9)
     2049     dop-saldo-sum
     2050     skip.
     2051   end.
     2052   run waitfram-hide in this-procedure .
     2053   if p-pravo then do:
     2054     PUT stream PrnLibStream Line format "X(231)" SKIP.
     2055     HIDE stream PrnLibStream FRAME CliBottomFramep .
     2056   end.
     2057   else do:
     2058     PUT stream PrnLibStream Line format "X(136)" SKIP.
     2059     HIDE stream PrnLibStream FRAME CliBottomFrame .
     2060   end.
     2061   output stream PrnLibStream close .
     2062   if Make-Excel then output stream ForExcel close.
     2063   run prn-lib-prn-file in this-procedure (
     2064                                              input parparentproc
     2065                                             ,input (if p-pravo then 1 else 8)
     2066                                             ).
     2067   p-qh:reposition-to-rowid( StartRowid ) no-error .
