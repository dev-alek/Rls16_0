      680   define  stream PrnLibStream.
      681   procedure prn-lib-prn-file :
      682     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      683     define input parameter p-DIsabledoptions as integer no-undo .
      684     define variable v-report-name as character no-undo .
      685     define variable v-user-action as character no-undo .
      686     define variable v-printed     as logical   no-undo .
      687     define variable v-exist       as logical   no-undo .
      688     do
      689       on error undo, return error
      690       :
      691       run prn-lib-get-report-name  in this-procedure (
      692         input parParentProc
      693         ,output v-report-name
      694         ).
      695   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      696   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      697     (input  v-report-name
      698     ,input  2
      699     ,output v-exist
      700     )  .
      701       if NOT v-exist then
      702       DO:
      703         Message
      704           "Нет заданий на печать ! "
      705           view-as alert-box .
      706         Return  .
      707       End.
      708       run gbl/prnfilen.w
      709         (input  ""
      710         ,input  p-DisabledOptions
      711         ,input  string(v-report-name )
      712         ,input  7
      713         ,output v-user-action
      714         ,output v-printed
      715         ) .
      716       if v-printed then
      717       do:
      718         return "YES" .
      719       end.
      720       else
      721       do:
      722         return "NO" .
      723       end.
      724     end.
      725   end procedure.
      726   procedure prn-lib-open-stream :
      727     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      728     define input parameter p-page-size    as integer no-undo .
      729     define input parameter p-is-stream    as logical no-undo .
      730     define input parameter p-append       as logical no-undo .
      731     define variable v-report-name as character no-undo .
      732     do
      733       on error undo, return error
      734       :
      735       run prn-lib-get-report-name  in this-procedure (
      736         input parParentProc
      737         ,output v-report-name
      738         ).
      739       if p-is-stream then
      740       do:
      741         if p-append then
      742         do:
      743           output stream PrnLibStream to value( v-report-name )
      744             page-size value(p-page-size) append .
      745         end.
      746         if not p-append then
      747         do:
      748           output stream PrnLibStream to value( v-report-name )
      749             page-size value(p-page-size) .
      750         end.
      751       end.
      752       if not p-is-stream then
      753       do:
      754         if p-append then
      755         do:
      756           output to value( v-report-name )
      757             page-size value(p-page-size) append .
      758         end.
      759         if not p-append then
      760         do:
      761           output to value( v-report-name )
      762             page-size value(p-page-size) .
      763         end.
      764       end.
      765     end.
      766   end procedure.
      767   procedure prn-lib-open-exp :
      768     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      769     define input parameter p-is-stream    as logical no-undo .
      770     define input parameter p-is-append    as logical no-undo .
      771     define output parameter p-ReportFileName as char init "report" no-undo.
      772     define output parameter p-process as logical no-undo .
      773     define variable glog as logical no-undo .
      774     do
      775       on error undo, return error
      776       :
      777       SYSTEM-DIALOG GET-FILE p-ReportFileName
      778         TITLE      "Укажите путь"
      779         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      780         ASK-OVERWRITE
      781         CREATE-TEST-FILE
      782         SAVE-AS
      783         USE-FILENAME
      784         DEFAULT-EXTENSION "txt"
      785         UPDATE glog
      786         .
      787       if not glog then  return.
      788       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      789       if p-is-stream then
      790       do:
      791         if p-is-append then
      792         do:
      793           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      794         end.
      795         else
      796         do:
      797           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      798         end.
      799       end.
      800       else
      801       do:
      802         if p-is-append then
      803         do:
      804           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      805         end.
      806         else
      807         do:
      808           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      809         end.
      810       end.
      811       p-process = yes.
      812     end.
      813   end procedure.
      814   procedure prn-lib-get-report-name :
      815     define input parameter parParentProc  as widget-handle no-undo.
      816     define output parameter p-report-name as character no-undo .
      817     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      818   end procedure.
      819   procedure prn-lib-reportviewer-report-name :
      820     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      821     define input parameter p-report-name-html as character no-undo .
      822     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      823   end procedure.
      824   procedure prn-lib-reportviewer :
      825     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      826     define input parameter p-report-name-html as character no-undo .
      827     define input parameter p-param        as character no-undo .
      828     define variable v-excel           as character no-undo init 'TRUE' .
      829     define variable v-value-character as character no-undo .
      830     define variable v-value-integer   as character no-undo .
      831     define variable v-value-date      as date      no-undo .
      832     define variable v-value-decimal   as decimal   no-undo .
      833     define variable rep-excel         as logical   no-undo .
      834     define variable excel-string      as character no-undo .
      835     define variable v-param-type      as character no-undo .
      836     define variable v-tth             as handle    no-undo .
      837     run adm/shattri.p (
      838       input "get":U
      839       ,input  ""
      840       ,input  0
      841       ,input  'report-glob':U
      842       ,input  'rep-excel':U
      843       ,output v-value-character
      844       ,output v-value-date
      845       ,output v-value-decimal
      846       ,output v-value-integer
      847       ,output rep-excel
      848       ,output v-param-type
      849       ,INPUT-OUTPUT table-handle v-tth
      850       )  .
      851     if rep-excel then v-excel = "TRUE" .
      852     else v-excel = "FALSE" .
      853     if p-param eq ""
      854     then
      855        p-param = "EXCEL:" + v-excel.
      856     else
      857        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      858     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      859   end procedure.
      860   define temp-table tt-norm-loss no-undo
      861     field clim-grp   as character
      862     field position   as character
      863     field oil-grp    as character
      864     field season     as character
      865     field value-loss as decimal
      866     field type-id    as integer
      867     field id         as integer
      868     index pi id type-id
      869     .
      870   DEFINE BUTTON b-add
      871        LABEL "&Добавить"
      872        SIZE 10 BY 1
      873        BGCOLOR 8 .
      874   DEFINE BUTTON B-exit AUTO-END-KEY
      875        LABEL "&Выход"
      876        SIZE 10 BY 1
      877        BGCOLOR 8 .
      878   DEFINE BUTTON B-Help
      879        LABEL "Помо&щь"
      880        SIZE 10 BY 1
      881        BGCOLOR 8 .
      882   DEFINE BUTTON b-print
      883     LABEL "Печ&ать"
      884     SIZE 10 BY 1
      885     BGCOLOR 8 .
      886   DEFINE QUERY br-norm-loss FOR
      887     tt-norm-loss SCROLLING.
      888   DEFINE BROWSE BR-norm-loss
      889     QUERY br-norm-loss DISPLAY
      890     tt-norm-loss.clim-grp FORMAT "x(10)":U label "Клим.гр."
      891     tt-norm-loss.position FORMAT "x(10)":U  label "Разм.рез."
      892     tt-norm-loss.oil-grp FORMAT "x(10)":U label "Гр.НП"
      893     tt-norm-loss.season FORMAT "x(10)":U label "Сезон"
      894     tt-norm-loss.value-loss FORMAT "->>>>>>>9.999":U label "Норма потерь при приеме в РГС"
      895       WITH SEPARATORS SIZE 87.75 BY 18.5 FIT-LAST-COLUMN.
      896   DEFINE FRAME Dialog-Frame
      897        B-exit AT ROW 1 COL 1 WIDGET-ID 2
      898        b-add AT ROW 1 COL 11 WIDGET-ID 14
      899        b-print AT ROW 1 COL 69.13 WIDGET-ID 12
      900        B-Help AT ROW 1 COL 79.13 WIDGET-ID 4
      901        BR-norm-loss AT ROW 2.25 COL 1.75 WIDGET-ID 200
      902        SPACE(0.99) SKIP(0.20)
      903       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      904            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      905            TITLE "Нормы технологических потерь НП при приеме в РГС" WIDGET-ID 100.
      906   ASSIGN
      907          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      908          FRAME Dialog-Frame:HIDDEN           = TRUE.
      909   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      910   DO:
      911     run ref/normloss-add.w (parparentproc,
      912     input 0)no-error.
      913     run init-tt-table in this-procedure .
      914     OPEN QUERY BR-norm-loss FOR EACH tt-norm-loss NO-LOCK by tt-norm-loss.clim-grp by tt-norm-loss.position DESCENDING by tt-norm-loss.oil-grp by tt-norm-loss.season INDEXED-REPOSITION.
      915     END.
      916   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      917   DO:
      918   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      919   if lookup(self :type
      920            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      921            ) = 0
      922   then do:
      923     message
      924       "$Workfile$"
      925       "Указанному интерфейсному элементу фокус не может быть передан" skip
      926       "Интерфейсный элемент" self :name  skip
      927       "Тип" self :type  skip
      928       "Процедура" this-procedure :file-name skip
      929       view-as alert-box .
      930   end.
      931   else do:
      932     apply "entry":u to self  .
      933     if focus :handle <> self :handle  then do:
      934       return no-apply .
      935     end.
      936   end.
      937   END.
      938   ON CHOOSE OF b-print IN FRAME Dialog-Frame
      939   DO:
      940       if not available tt-norm-loss then return no-apply.
      941       run proc-b-print in this-procedure no-error.
      942       if error-status:error then
      943       do:
      944         return no-apply.
      945       end.
      946     END.
      947   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      948     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      949   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      950   on help of frame Dialog-Frame
      951   do:
      952     run gbl/app_help.p
      953       (input this-procedure :file-name
      954       ,input ''
      955       ,input ?
      956       ) no-error.
      957     if error-status :error then do:
      958       message
      959         "Ошибка при вызове помощи"
      960         error-status :get-message(1)
      961         view-as alert-box .
      962     end.
      963   end.
      964   run minbtn-set in this-procedure .
      965   on choose of b-help in frame Dialog-Frame
      966   do:
      967     apply "help":u to frame Dialog-Frame .
      968   end.
      969   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      970   procedure minbtn-set :
      971       do
      972           on error undo, return error return-value
      973           :
      974           define variable ii              as integer       no-undo .
      975           define variable fh              as widget-handle no-undo .
      976           define variable hh              as widget-handle no-undo .
      977           define variable v-h             as handle        extent 4 no-undo .
      978           define variable v-name-button   as character     no-undo .
      979           define variable v-help-old-x    as decimal       no-undo .
      980           define variable v-help-old-y    as decimal       no-undo .
      981           define variable v-help-old-size as decimal       no-undo .
      982           define variable v-frame-width   as decimal       no-undo .
      983           define variable jj              as integer       no-undo .
      984           do
      985               on error undo, return error
      986               :
      987               assign
      988                   v-frame-width = frame Dialog-Frame:width - 0.3
      989                   fh            = frame Dialog-Frame:first-child
      990                   hh            = fh:first-child
      991                   ii            = 1
      992                   .
      993               do while valid-handle(hh):
      994                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      995                   do:
      996                       case lc(hh:name) :
      997                           when "b-help" then
      998                               do:
      999                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1000                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1001                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1002                                   hh:TOOLTIP = "Помощь" .
     1003                                   v-help-old-x = hh:column .
     1004                                   v-help-old-y = hh:row    .
     1005                                   v-help-old-size = hh:width .
     1006                                   hh:width-chars = 2.5 .
     1007                               end.
     1008                           when "b-print" then
     1009                               do:
     1010                                   hh:load-image("cmp/b-print.bmp":u) .
     1011                                   hh:TOOLTIP = "Печать" .
     1012                                   v-h[ii] = hh:handle .
     1013                                   ii = ii + 1 .
     1014                                   hh:width-chars = 3 .
     1015                               end.
     1016                           when "b-history" or
     1017                           when "b-hist" then
     1018                               do:
     1019                                   hh:load-image("cmp/b-hist.bmp":u) .
     1020                                   hh:TOOLTIP = "История" .
     1021                                   v-h[ii] = hh:handle .
     1022                                   ii = ii + 1 .
     1023                                   hh:width-chars = 3 .
     1024                               end.
     1025                           when "b-sch" then
     1026                               do:
     1027                                   hh:load-image("cmp/b-sch.bmp":u) .
     1028                                   hh:TOOLTIP = "Установка Фильтра" .
     1029                                   v-h[ii] = hh:handle .
     1030                                   ii = ii + 1 .
     1031                                   hh:width-chars = 3 .
     1032                               end.
     1033                           when "b-hist-user" then
     1034                               do:
     1035                                   hh:load-image("cmp/b-hist.bmp":u) .
     1036                                   hh:TOOLTIP = "История пользователя" .
     1037                                   ii = ii + 1 .
     1038                               end.
     1039                       end case.
     1040                   end.
     1041                   hh = hh:next-sibling.
     1042               end.
     1043               b-help:column = v-frame-width - b-help:width-chars.
     1044               jj = 0.
     1045               repeat ii = 4 to 1 by -1 :
     1046                   if valid-handle (v-h[ii] ) then
     1047                   do:
     1048                       jj  = jj + 1 .
     1049                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1050                       v-h[ii]:row    = v-help-old-y .
     1051                   end.
     1052               end.
     1053           end.
     1054       end.
     1055   end procedure.
     1056   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1057   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1058   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1059   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1060   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1061   define variable v-diasize-current-frame-height as decimal   no-undo .
     1062   define variable v-diasize-change-size          as logical   no-undo .
     1063   define variable v-diasize-resize-button        as handle    no-undo .
     1064   define variable v-diasize-wndmax               as logical   no-undo .
     1065   define variable v-diasize-wndstore             as logical   no-undo .
     1066   define variable v-diasize-proc-name            as character no-undo .
     1067   define variable v-diasize-browse-handle        as handle    no-undo .
     1068   define variable v-diasize-browse-number        as integer   no-undo .
     1069   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1070   define temp-table temp-diasize-handle no-undo
     1071     field handle-value  as handle
     1072     field save-position as decimal
     1073     index xpk is primary unique handle-value
     1074     .
     1075   define temp-table temp-browse-handle no-undo
     1076     field browse-type   as character
     1077     field browse-number as integer
     1078     field browse-handle as handle
     1079     field original-size as decimal
     1080     index xpk is primary unique browse-type browse-number
     1081     index xie browse-type browse-handle
     1082   .
     1083   procedure diasize_change-height :
     1084     define input  parameter p-change-value  as decimal   no-undo .
     1085     define input  parameter p-move-resize   as logical   no-undo .
     1086     define variable v-field-group-handle    as handle    no-undo .
     1087     define variable v-object-handle         as handle    no-undo .
     1088     define variable v-frame-height          as decimal   no-undo .
     1089     define variable v-frame-virtual-height  as decimal   no-undo .
     1090     define variable v-browse-height         as decimal   no-undo .
     1091     define variable v-window-height         as decimal   no-undo .
     1092     define variable v-window-virtual-height as decimal   no-undo .
     1093     define variable v-change-sign           as integer   no-undo .
     1094     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1095     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1096     if p-change-value > 0
     1097     then do:
     1098       if frame Dialog-Frame :height + p-change-value
     1099           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1100       then do:
     1101         assign
     1102           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1103                           - (frame Dialog-Frame :height-chars)
     1104         .
     1105         if p-change-value <= 0
     1106         then do:
     1107           run diasize_position-resize-button in this-procedure .
     1108           return .
     1109         end.
     1110       end.
     1111     end.
     1112     if p-change-value < 0
     1113     then do:
     1114       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1115       then do:
     1116         assign
     1117           p-change-value = v-diasize-orig-frame-height
     1118                          - (frame Dialog-Frame :height-chars)
     1119         .
     1120         if p-change-value >= 0
     1121         then do:
     1122           run diasize_position-resize-button in this-procedure .
     1123           return .
     1124         end.
     1125       end.
     1126     end.
     1127     if p-change-value >= 0
     1128     then do:
     1129       assign
     1130         v-change-sign = 1
     1131       .
     1132     end.
     1133     else do:
     1134       assign
     1135         v-change-sign = -1
     1136       .
     1137     end.
     1138     assign
     1139       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1140     .
     1141     if p-change-value = 0
     1142     then do:
     1143       run diasize_position-resize-button in this-procedure .
     1144       return .
     1145     end.
     1146     move_block:
     1147     do
     1148     on error undo move_block, retry move_block
     1149     :
     1150       if retry
     1151       then do:
     1152         do
     1153         on error undo move_block, leave move_block
     1154         :
     1155           if p-change-value > 0
     1156           then do:
     1157             for each buf_temp-diasize-handle
     1158             on error undo, next
     1159             :
     1160               assign
     1161                 v-object-handle = buf_temp-diasize-handle.handle-value
     1162               .
     1163               if v-object-handle <> v-diasize-resize-button
     1164               then do:
     1165                 assign
     1166                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1167                 .
     1168               end.
     1169             end.
     1170             assign
     1171               v-diasize-browse-handle :height = v-browse-height
     1172             .
     1173             for each buf_temp-browse-handle
     1174               where buf_temp-browse-handle.browse-type = 'height':u
     1175             on error undo, next
     1176             :
     1177               assign
     1178                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1179               .
     1180             end.
     1181             assign
     1182               frame Dialog-Frame :height = v-frame-height
     1183             .
     1184             if frame Dialog-Frame :scrollable = true
     1185             then do:
     1186               assign
     1187                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1188               .
     1189             end.
     1190             run diasize_position-resize-button in this-procedure .
     1191           end.
     1192           else do:
     1193             if frame Dialog-Frame :scrollable = true
     1194             then do:
     1195               assign
     1196                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1197               .
     1198             end.
     1199             assign
     1200               frame Dialog-Frame :height = v-frame-height
     1201             .
     1202             assign
     1203               v-diasize-browse-handle :height = v-browse-height
     1204             .
     1205             for each buf_temp-browse-handle
     1206               where buf_temp-browse-handle.browse-type = 'height':u
     1207             on error undo, next
     1208             :
     1209               assign
     1210                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1211               .
     1212             end.
     1213             for each buf_temp-diasize-handle
     1214             on error undo, next
     1215             :
     1216               assign
     1217                 v-object-handle = buf_temp-diasize-handle.handle-value
     1218               .
     1219               if v-object-handle <> v-diasize-resize-button
     1220               then do:
     1221                 assign
     1222                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1223                 .
     1224               end.
     1225             end.
     1226             run diasize_position-resize-button in this-procedure .
     1227           end.
     1228           assign
     1229             v-diasize-change-size = false
     1230           .
     1231           leave move_block .
     1232         end.
     1233       end.
     1234       assign
     1235         v-diasize-need-full-display = true
     1236       .
     1237       if v-diasize-change-size = false
     1238       then do:
     1239         assign
     1240           v-diasize-change-size = true
     1241         .
     1242       end.
     1243       else do:
     1244         return .
     1245       end.
     1246       assign
     1247         v-frame-height = frame Dialog-Frame :height
     1248         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1249         v-browse-height = v-diasize-browse-handle :height
     1250       .
     1251       for each buf_temp-browse-handle
     1252         where buf_temp-browse-handle.browse-type = 'height':u
     1253       :
     1254         assign
     1255           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1256         .
     1257       end.
     1258       for each buf_temp-diasize-handle
     1259       :
     1260         delete buf_temp-diasize-handle .
     1261       end.
     1262       assign
     1263         v-field-group-handle = frame Dialog-Frame :first-child
     1264       .
     1265       do while valid-handle(v-field-group-handle)
     1266       :
     1267         assign
     1268           v-object-handle = v-field-group-handle :first-child
     1269         .
     1270         do while valid-handle(v-object-handle)
     1271         :
     1272           if  v-object-handle <> v-diasize-browse-handle :handle
     1273           and can-query(v-object-handle, "row")
     1274           and can-query(v-object-handle, "height")
     1275           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1276           then do:
     1277             find first buf_temp-browse-handle
     1278               where buf_temp-browse-handle.browse-type   = 'height':u
     1279                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1280               no-error .
     1281             if available buf_temp-browse-handle
     1282             then do:
     1283             end.
     1284             else do:
     1285               create buf_temp-diasize-handle .
     1286               assign
     1287                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1288                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1289               .
     1290             end.
     1291           end.
     1292           assign
     1293             v-object-handle = v-object-handle :next-sibling
     1294           .
     1295         end.
     1296         assign
     1297           v-field-group-handle = v-field-group-handle :next-sibling
     1298         .
     1299       end.
     1300       do with frame Dialog-Frame
     1301       :
     1302         hide v-diasize-resize-button .
     1303         assign
     1304           v-diasize-resize-button :row    = 1
     1305           v-diasize-resize-button :column = 1
     1306         .
     1307       end.
     1308       if p-change-value > 0
     1309       then do:
     1310         if frame Dialog-Frame :scrollable = true
     1311         then do:
     1312           assign
     1313             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1314             no-error .
     1315           if error-status :error
     1316           or error-status :get-message(1) <> ""
     1317           then do:
     1318             undo move_block, retry move_block .
     1319           end.
     1320         end.
     1321         assign
     1322           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1323           no-error .
     1324         if error-status :error
     1325         or error-status :get-message(1) <> ""
     1326         then do:
     1327           undo move_block, retry move_block .
     1328         end.
     1329         assign
     1330           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1331           no-error .
     1332         if error-status :error
     1333         or error-status :get-message(1) <> ""
     1334         then do:
     1335           undo move_block, retry move_block .
     1336         end.
     1337         for each buf_temp-browse-handle
     1338           where buf_temp-browse-handle.browse-type = 'height':u
     1339         on error undo move_block, retry move_block
     1340         :
     1341           assign
     1342             buf_temp-browse-handle.browse-handle :height
     1343               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1344             no-error .
     1345           if error-status :error
     1346           or error-status :get-message(1) <> ""
     1347           then do:
     1348             undo move_block, retry move_block .
     1349           end.
     1350         end.
     1351         for each buf_temp-diasize-handle
     1352         on error undo move_block, retry move_block
     1353         :
     1354           assign
     1355             v-object-handle = buf_temp-diasize-handle.handle-value
     1356           .
     1357           if v-object-handle <> v-diasize-resize-button
     1358           then do:
     1359             assign
     1360               v-object-handle :row = v-object-handle :row + p-change-value
     1361               no-error .
     1362             if error-status :error
     1363             or error-status :get-message(1) <> ""
     1364             then do:
     1365               undo move_block, retry move_block .
     1366             end.
     1367           end.
     1368         end.
     1369       end.
     1370       else do:
     1371         for each buf_temp-diasize-handle
     1372         on error undo move_block, retry move_block
     1373         :
     1374           assign
     1375             v-object-handle = buf_temp-diasize-handle.handle-value
     1376           .
     1377           if v-object-handle <> v-diasize-resize-button
     1378           then do:
     1379             assign
     1380               v-object-handle :row = v-object-handle :row + p-change-value
     1381               no-error .
     1382             if error-status :error
     1383             or error-status :get-message(1) <> ""
     1384             then do:
     1385               undo move_block, retry move_block .
     1386             end.
     1387           end.
     1388         end.
     1389         assign
     1390           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1391           no-error .
     1392         if error-status :error
     1393         or error-status :get-message(1) <> ""
     1394         then do:
     1395           undo move_block, retry move_block .
     1396         end.
     1397         for each buf_temp-browse-handle
     1398           where buf_temp-browse-handle.browse-type = 'height':u
     1399         on error undo move_block, retry move_block
     1400         :
     1401           assign
     1402             buf_temp-browse-handle.browse-handle :height
     1403               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1404             no-error .
     1405           if error-status :error
     1406           or error-status :get-message(1) <> ""
     1407           then do:
     1408             undo move_block, retry move_block .
     1409           end.
     1410         end.
     1411         assign
     1412           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1413           no-error .
     1414         if error-status :error
     1415         or error-status :get-message(1) <> ""
     1416         then do:
     1417           undo move_block, retry move_block .
     1418         end.
     1419         if frame Dialog-Frame :scrollable = true
     1420         then do:
     1421           assign
     1422             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1423             no-error .
     1424           if error-status :error
     1425           or error-status :get-message(1) <> ""
     1426           then do:
     1427             undo move_block, retry move_block .
     1428           end.
     1429         end.
     1430       end.
     1431       if p-move-resize = true
     1432       then do:
     1433         run diasize_position-resize-button in this-procedure .
     1434       end.
     1435       if v-diasize-wndstore = true
     1436       then do:
     1437         if connected("ub") = true
     1438         then do:
     1439           define variable v-cntxt-db-num        as integer   no-undo .
     1440           define variable v-cntxt-userid        as character no-undo .
     1441           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1442                                             , OUTPUT v-cntxt-userid
     1443                                             ) .
     1444           run gbl/wndsizew.p
     1445             (input  v-cntxt-db-num
     1446             ,input  v-cntxt-userid
     1447             ,input  v-diasize-proc-name
     1448             ,input  'height':u
     1449             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1450             ) .
     1451         end.
     1452       end.
     1453     end.
     1454     assign
     1455       v-diasize-change-size = false
     1456     .
     1457   end procedure.
     1458   procedure diasize_set-height :
     1459     define input  parameter p-new-height  as decimal   no-undo .
     1460     define input  parameter p-move-resize as logical   no-undo .
     1461     do
     1462     on error undo, return error return-value
     1463     :
     1464       run diasize_change-height in this-procedure
     1465         (input  (p-new-height - frame Dialog-Frame :height)
     1466         ,input  p-move-resize
     1467         ) .
     1468     end.
     1469   end procedure.
     1470   procedure diasize_change-width :
     1471     define input  parameter p-change-value as decimal   no-undo .
     1472     define input  parameter p-move-resize  as logical   no-undo .
     1473     define variable v-field-group-handle   as handle    no-undo .
     1474     define variable v-object-handle        as handle    no-undo .
     1475     define variable v-frame-width          as decimal   no-undo .
     1476     define variable v-frame-virtual-width  as decimal   no-undo .
     1477     define variable v-browse-width         as decimal   no-undo .
     1478     define variable v-window-width         as decimal   no-undo .
     1479     define variable v-window-virtual-width as decimal   no-undo .
     1480     define variable v-change-sign          as integer   no-undo .
     1481     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1482     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1483     if p-change-value > 0
     1484     then do:
     1485       if frame Dialog-Frame :width + p-change-value >
     1486           session :width-chars
     1487       then do:
     1488         assign
     1489           p-change-value = session :width-chars - frame Dialog-Frame :width
     1490         .
     1491         if p-change-value <= 0
     1492         then do:
     1493           run diasize_position-resize-button in this-procedure .
     1494           return .
     1495         end.
     1496       end.
     1497     end.
     1498     if p-change-value < 0
     1499     then do:
     1500       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1501       then do:
     1502         assign
     1503           p-change-value = v-diasize-orig-frame-width
     1504                          - frame Dialog-Frame :width
     1505         .
     1506         if p-change-value >= 0
     1507         then do:
     1508           run diasize_position-resize-button in this-procedure .
     1509           return .
     1510         end.
     1511       end.
     1512     end.
     1513     if p-change-value >= 0
     1514     then do:
     1515       assign
     1516         v-change-sign = 1
     1517       .
     1518     end.
     1519     else do:
     1520       assign
     1521         v-change-sign = -1
     1522       .
     1523     end.
     1524     assign
     1525       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1526     .
     1527     if p-change-value = 0
     1528     then do:
     1529       run diasize_position-resize-button in this-procedure .
     1530       return .
     1531     end.
     1532     move_block:
     1533     do
     1534     on error undo move_block, leave move_block
     1535     :
     1536       if retry
     1537       then do:
     1538         do
     1539         on error undo move_block, leave move_block
     1540         :
     1541           if p-change-value > 0
     1542           then do:
     1543             for each buf_temp-diasize-handle
     1544             on error undo, next
     1545             :
     1546               assign
     1547                 v-object-handle = buf_temp-diasize-handle.handle-value
     1548               .
     1549               if v-object-handle <> v-diasize-resize-button
     1550               then do:
     1551                 assign
     1552                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1553                 .
     1554               end.
     1555             end.
     1556             assign
     1557               v-diasize-browse-handle :width = v-browse-width
     1558             .
     1559             for each buf_temp-browse-handle
     1560               where buf_temp-browse-handle.browse-type = 'width':u
     1561             on error undo, next
     1562             :
     1563               assign
     1564                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1565               .
     1566             end.
     1567             assign
     1568               frame Dialog-Frame :width = v-frame-width
     1569             .
     1570             if frame Dialog-Frame :scrollable = true
     1571             then do:
     1572               assign
     1573                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1574               .
     1575             end.
     1576             run diasize_position-resize-button in this-procedure .
     1577           end.
     1578           else do:
     1579             if frame Dialog-Frame :scrollable = true
     1580             then do:
     1581               assign
     1582                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1583               .
     1584             end.
     1585             assign
     1586               frame Dialog-Frame :width = v-frame-width
     1587             .
     1588             for each buf_temp-browse-handle
     1589               where buf_temp-browse-handle.browse-type = 'width':u
     1590             on error undo, next
     1591             :
     1592               assign
     1593                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1594               .
     1595             end.
     1596             assign
     1597               v-diasize-browse-handle :width = v-browse-width
     1598             .
     1599             for each buf_temp-diasize-handle
     1600             on error undo, next
     1601             :
     1602               assign
     1603                 v-object-handle = buf_temp-diasize-handle.handle-value
     1604               .
     1605               if v-object-handle <> v-diasize-resize-button
     1606               then do:
     1607                 assign
     1608                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1609                 .
     1610               end.
     1611             end.
     1612             run diasize_position-resize-button in this-procedure .
     1613           end.
     1614           assign
     1615             v-diasize-change-size = false
     1616           .
     1617           leave move_block .
     1618         end.
     1619       end.
     1620       assign
     1621         v-diasize-need-full-display = true
     1622       .
     1623       if v-diasize-change-size = false
     1624       then do:
     1625         assign
     1626           v-diasize-change-size = true
     1627         .
     1628       end.
     1629       else do:
     1630         return .
     1631       end.
     1632       assign
     1633         v-frame-width = frame Dialog-Frame :width
     1634         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1635         v-browse-width = v-diasize-browse-handle :width
     1636       .
     1637       for each buf_temp-browse-handle
     1638         where buf_temp-browse-handle.browse-type = 'width':u
     1639       :
     1640         assign
     1641           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1642         .
     1643       end.
     1644       for each buf_temp-diasize-handle
     1645       :
     1646         delete buf_temp-diasize-handle .
     1647       end.
     1648       assign
     1649         v-field-group-handle = frame Dialog-Frame :first-child
     1650       .
     1651       do while valid-handle(v-field-group-handle)
     1652       :
     1653         assign
     1654           v-object-handle = v-field-group-handle :first-child
     1655         .
     1656         do while valid-handle(v-object-handle)
     1657         :
     1658           if  v-object-handle <> v-diasize-browse-handle :handle
     1659           and v-object-handle <> v-diasize-resize-button
     1660           and can-query(v-object-handle, "row")
     1661           and can-query(v-object-handle, "height")
     1662           and ( v-object-handle :col + v-object-handle :width
     1663                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1664               )
     1665           then do:
     1666             find first buf_temp-browse-handle
     1667               where buf_temp-browse-handle.browse-type   = 'width':u
     1668                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1669               no-error .
     1670             if available buf_temp-browse-handle
     1671             then do:
     1672             end.
     1673             else do:
     1674               create buf_temp-diasize-handle .
     1675               assign
     1676                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1677                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1678               .
     1679             end.
     1680           end.
     1681           assign
     1682             v-object-handle = v-object-handle :next-sibling
     1683           .
     1684         end.
     1685         assign
     1686           v-field-group-handle = v-field-group-handle :next-sibling
     1687         .
     1688       end.
     1689       do with frame Dialog-Frame
     1690       :
     1691         hide v-diasize-resize-button .
     1692         v-diasize-resize-button :row = 1.
     1693         v-diasize-resize-button :column = 1.
     1694       end.
     1695       if p-change-value > 0
     1696       then do:
     1697         if frame Dialog-Frame :scrollable = true
     1698         then do:
     1699           assign
     1700             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1701             no-error .
     1702           if error-status :error
     1703           or error-status :get-message(1) <> ""
     1704           then do:
     1705             undo move_block, retry move_block.
     1706           end.
     1707         end.
     1708         assign
     1709           frame Dialog-Frame :width = v-frame-width + p-change-value
     1710           no-error .
     1711         if error-status :error
     1712         or error-status :get-message(1) <> ""
     1713         then do:
     1714           undo move_block, retry move_block.
     1715         end.
     1716         assign
     1717           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1718         no-error .
     1719         if error-status :error
     1720         or error-status :get-message(1) <> ""
     1721         then do:
     1722           undo move_block, retry move_block.
     1723         end.
     1724         for each buf_temp-browse-handle
     1725           where buf_temp-browse-handle.browse-type = 'width':u
     1726         on error undo move_block, retry move_block
     1727         :
     1728           assign
     1729             buf_temp-browse-handle.browse-handle :width
     1730               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1731             no-error .
     1732           if error-status :error
     1733           or error-status :get-message(1) <> ""
     1734           then do:
     1735             undo move_block, retry move_block .
     1736           end.
     1737         end.
     1738         for each buf_temp-diasize-handle
     1739         on error undo move_block, retry move_block
     1740         :
     1741           assign
     1742             v-object-handle = buf_temp-diasize-handle.handle-value
     1743           .
     1744           if v-object-handle <> v-diasize-resize-button
     1745           then do:
     1746             assign
     1747               v-object-handle :col = v-object-handle :col + p-change-value
     1748               no-error .
     1749             if error-status :error
     1750             or error-status :get-message(1) <> ""
     1751             then do:
     1752               undo move_block, retry move_block .
     1753             end.
     1754           end.
     1755         end.
     1756       end.
     1757       else do:
     1758         for each buf_temp-diasize-handle
     1759         on error undo move_block, retry move_block
     1760         :
     1761           assign
     1762             v-object-handle = buf_temp-diasize-handle.handle-value
     1763           .
     1764           if v-object-handle <> v-diasize-resize-button
     1765           then do:
     1766             assign
     1767               v-object-handle :col = v-object-handle :col + p-change-value
     1768               no-error .
     1769             if error-status :error
     1770             or error-status :get-message(1) <> ""
     1771             then do:
     1772               undo move_block, retry move_block .
     1773             end.
     1774           end.
     1775         end.
     1776         for each buf_temp-browse-handle
     1777           where buf_temp-browse-handle.browse-type = 'width':u
     1778         on error undo move_block, retry move_block
     1779         :
     1780           assign
     1781             buf_temp-browse-handle.browse-handle :width
     1782               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1783             no-error .
     1784           if error-status :error
     1785           or error-status :get-message(1) <> ""
     1786           then do:
     1787             undo move_block, retry move_block .
     1788           end.
     1789         end.
     1790         assign
     1791           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1792           no-error .
     1793         if error-status :error
     1794         or error-status :get-message(1) <> ""
     1795         then do:
     1796           undo move_block, retry move_block.
     1797         end.
     1798         assign
     1799           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1800         no-error .
     1801         if error-status :error
     1802         or error-status :get-message(1) <> ""
     1803         then do:
     1804           undo move_block, retry move_block.
     1805         end.
     1806         if frame Dialog-Frame :scrollable = true
     1807         then do:
     1808           assign
     1809             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1810           no-error .
     1811           if error-status :error
     1812           or error-status :get-message(1) <> ""
     1813           then do:
     1814             undo move_block, retry move_block.
     1815           end.
     1816         end.
     1817       end.
     1818       if p-move-resize
     1819       then do:
     1820         run diasize_position-resize-button in this-procedure .
     1821       end.
     1822       if v-diasize-wndstore = true
     1823       then do:
     1824         if connected("ub") = true
     1825         then do:
     1826           define variable v-cntxt-db-num        as integer   no-undo .
     1827           define variable v-cntxt-userid        as character no-undo .
     1828           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1829                                             , OUTPUT v-cntxt-userid
     1830                                             ) .
     1831           run gbl/wndsizew.p
     1832             (input  v-cntxt-db-num
     1833             ,input  v-cntxt-userid
     1834             ,input  v-diasize-proc-name
     1835             ,input  'width':u
     1836             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1837             ) .
     1838         end.
     1839       end.
     1840     end.
     1841     assign
     1842       v-diasize-change-size = false
     1843     .
     1844   end procedure.
     1845   procedure diasize_set-width :
     1846     define input  parameter p-new-width  as decimal   no-undo .
     1847     define input  parameter p-move-resize as logical   no-undo .
     1848     do
     1849     on error undo, return error return-value
     1850     :
     1851       run diasize_change-width in this-procedure
     1852         (input  (p-new-width - frame Dialog-Frame :width)
     1853         ,input  p-move-resize
     1854         ) .
     1855     end.
     1856   end procedure.
     1857   procedure diasize_position-resize-button :
     1858     do with frame Dialog-Frame
     1859     :
     1860       hide v-diasize-resize-button .
     1861       assign
     1862         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1863                     - 1
     1864                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1865         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1866                     - 1
     1867                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1868       .
     1869       view v-diasize-resize-button .
     1870     end.
     1871   end procedure.
     1872   on alt-right anywhere
     1873   do:
     1874     run diasize_change-width in this-procedure
     1875       (input 1
     1876       ,input true
     1877       ) .
     1878     return no-apply .
     1879   end.
     1880   on alt-left anywhere
     1881   do:
     1882     run diasize_change-width in this-procedure
     1883       (input -1
     1884       ,input true
     1885       ) .
     1886     return no-apply .
     1887   end.
     1888   on alt-down anywhere
     1889   do:
     1890     run diasize_change-height in this-procedure
     1891       (input 1
     1892       ,input true
     1893       ) .
     1894     return no-apply .
     1895   end.
     1896   on alt-up anywhere
     1897   do:
     1898     run diasize_change-height in this-procedure
     1899       (input -1
     1900       ,input true
     1901       ) .
     1902     return no-apply .
     1903   end.
     1904   on alt-enter of frame Dialog-Frame
     1905   do:
     1906     run diasize_maximize in this-procedure
     1907       (input  ?
     1908       ).
     1909     return no-apply .
     1910   end.
     1911   procedure diasize_end-move :
     1912     do
     1913     on error undo, return error return-value
     1914     :
     1915       define variable v-row-delta as decimal   no-undo .
     1916       define variable v-col-delta as decimal   no-undo .
     1917       define variable v-new-row as decimal   no-undo .
     1918       define variable v-new-col as decimal   no-undo .
     1919       assign
     1920         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1921         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1922       .
     1923       assign
     1924         v-row-delta = v-new-row - frame Dialog-Frame :height
     1925         v-col-delta = v-new-col - frame Dialog-Frame :width
     1926       .
     1927       run diasize_change-height in this-procedure
     1928         (input v-row-delta
     1929         ,input true
     1930         ) .
     1931       run diasize_change-width in this-procedure
     1932         (input v-col-delta
     1933         ,input true
     1934         ) .
     1935     end.
     1936   end procedure.
     1937   procedure diasize_maximize :
     1938     define input  parameter p-action as logical   no-undo .
     1939     do
     1940     on error undo, return error return-value
     1941     :
     1942       if p-action = ?
     1943       then do:
     1944         if v-diasize-need-maximize = true
     1945         then do:
     1946           assign
     1947             p-action = true
     1948           .
     1949         end.
     1950         else do:
     1951           assign
     1952             p-action = false
     1953           .
     1954         end.
     1955       end.
     1956       if p-action = true
     1957       then do:
     1958         run diasize_change-height in this-procedure
     1959           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1960               - frame Dialog-Frame :height-chars
     1961           ,input true
     1962           ) .
     1963         run diasize_change-width in this-procedure
     1964           (input session :width-chars
     1965               - frame Dialog-Frame :width-chars
     1966           ,input true
     1967           ) .
     1968         assign
     1969           v-diasize-need-maximize = false
     1970         .
     1971       end.
     1972       else do:
     1973         run diasize_change-width in this-procedure
     1974           (input v-diasize-orig-frame-width
     1975               - frame Dialog-Frame :width-chars
     1976           ,input true
     1977           ) .
     1978         run diasize_change-height in this-procedure
     1979           (input v-diasize-orig-frame-height
     1980               - frame Dialog-Frame :height-chars
     1981           ,input true
     1982           ) .
     1983         assign
     1984           v-diasize-need-maximize = true
     1985         .
     1986       end.
     1987     end.
     1988   end procedure.
     1989   procedure diasize_restore-orig-size :
     1990     do
     1991     on error undo, return error return-value
     1992     :
     1993       assign
     1994         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1995         v-diasize-current-frame-height = frame Dialog-Frame :height
     1996       .
     1997       run diasize_set-height in this-procedure
     1998         (input  v-diasize-orig-frame-height
     1999         ,input  true
     2000         ) .
     2001       run diasize_set-width in this-procedure
     2002         (input  v-diasize-orig-frame-width
     2003         ,input  true
     2004         ) .
     2005     end.
     2006   end procedure.
     2007   procedure diasize_restore-current-size :
     2008     do
     2009     on error undo, return error return-value
     2010     :
     2011       run diasize_set-height in this-procedure
     2012         (input  v-diasize-current-frame-height
     2013         ,input  true
     2014         ) .
     2015       run diasize_set-width in this-procedure
     2016         (input  v-diasize-current-frame-width
     2017         ,input  true
     2018         ) .
     2019     end.
     2020   end procedure.
     2021   procedure diasize_set-browse-handle :
     2022     define input  parameter p-browse-handle as handle   no-undo .
     2023     define buffer buf_temp-browse-handle for temp-browse-handle .
     2024     do
     2025     on error undo, return error return-value
     2026     :
     2027       assign
     2028         v-diasize-browse-handle = p-browse-handle
     2029       .
     2030       for each buf_temp-browse-handle
     2031       on error undo, return error return-value
     2032       :
     2033         delete buf_temp-browse-handle .
     2034       end.
     2035     end.
     2036   end procedure.
     2037   procedure diasize_add_browse :
     2038     define input  parameter p-browse-type   as character no-undo .
     2039     define input  parameter p-browse-handle as handle    no-undo .
     2040     define buffer buf_temp-browse-handle for temp-browse-handle .
     2041     do
     2042     on error undo, return error return-value
     2043     :
     2044       assign
     2045         v-diasize-browse-number = v-diasize-browse-number + 1
     2046       .
     2047       create buf_temp-browse-handle .
     2048       assign
     2049         buf_temp-browse-handle.browse-type   = p-browse-type
     2050         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2051         buf_temp-browse-handle.browse-handle = p-browse-handle
     2052       .
     2053     end.
     2054   end procedure.
     2055   procedure diasize_init :
     2056     define variable v-default-value    as logical   no-undo .
     2057     define variable v-restore-saved    as logical   no-undo .
     2058     define variable v-resize-value-str as character no-undo .
     2059     do
     2060     on error undo, return error return-value
     2061     :
     2062       do with frame Dialog-Frame
     2063       :
     2064         assign
     2065           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2066           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2067           v-diasize-browse-handle     = browse BR-norm-loss :handle
     2068         .
     2069         create button v-diasize-resize-button
     2070         assign
     2071           parent        = frame Dialog-Frame :first-child
     2072           label         = "s"
     2073           height-pixels = 16
     2074           width-pixels  = 16
     2075           visible       = true
     2076           sensitive     = true
     2077           movable       = true
     2078           triggers:
     2079             on end-move persistent run diasize_end-move in this-procedure .
     2080           end triggers.
     2081         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2082         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2083         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2084         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2085         assign
     2086           v-diasize-wndmax = false
     2087         .
     2088         if connected("ub") = true
     2089         then do:
     2090           define variable v-cntxt-db-num        as integer   no-undo .
     2091           define variable v-cntxt-userid        as character no-undo .
     2092           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2093                                             , OUTPUT v-cntxt-userid
     2094                                             ) .
     2095           run gbl/wndpar_r.p
     2096             (input  v-cntxt-db-num
     2097             ,input  v-cntxt-userid
     2098             ,input  'wndmax':U
     2099             ,output v-diasize-wndmax
     2100             ,output v-default-value
     2101             ) .
     2102         end.
     2103         assign
     2104           v-diasize-wndstore = false
     2105         .
     2106         if connected("ub") = true
     2107         then do:
     2108           run gbl/wndpar_r.p
     2109             (input  v-cntxt-db-num
     2110             ,input  v-cntxt-userid
     2111             ,input  'wndstore':U
     2112             ,output v-diasize-wndstore
     2113             ,output v-default-value
     2114             ) .
     2115         end.
     2116         assign
     2117           v-diasize-proc-name = entry(1, program-name(2), '.')
     2118         .
     2119         if v-diasize-wndstore = true
     2120         then do:
     2121           assign
     2122             v-restore-saved = false
     2123           .
     2124           if connected("ub") = true
     2125           then do:
     2126             run gbl/wndsizer.p
     2127               (input  v-cntxt-db-num
     2128               ,input  v-cntxt-userid
     2129               ,input  v-diasize-proc-name
     2130               ,input  'height':u
     2131               ,output v-resize-value-str
     2132               ) .
     2133             if v-resize-value-str <> '':U
     2134             then do:
     2135               run diasize_change-height in this-procedure
     2136                 (input  integer(v-resize-value-str)
     2137                 ,input  true
     2138                 ) .
     2139               assign
     2140                 v-restore-saved = true
     2141               .
     2142             end.
     2143           end.
     2144           if connected("ub") = true
     2145           then do:
     2146             run gbl/wndsizer.p
     2147               (input  v-cntxt-db-num
     2148               ,input  v-cntxt-userid
     2149               ,input  v-diasize-proc-name
     2150               ,input  'width':u
     2151               ,output v-resize-value-str
     2152               ) .
     2153             if v-resize-value-str <> '':U
     2154             then do:
     2155               run diasize_change-width in this-procedure
     2156                 (input  integer(v-resize-value-str)
     2157                 ,input  true
     2158                 ) .
     2159               assign
     2160                 v-restore-saved = true
     2161               .
     2162             end.
     2163           end.
     2164           if v-restore-saved <> true
     2165           then do:
     2166             if v-diasize-wndmax = true
     2167             then do:
     2168               run diasize_maximize in this-procedure
     2169                 (input  true
     2170                 ) .
     2171             end.
     2172           end.
     2173         end.
     2174         else do:
     2175           if v-diasize-wndmax = true
     2176           then do:
     2177             run diasize_maximize in this-procedure
     2178               (input  true
     2179               ) .
     2180           end.
     2181         end.
     2182       end.
     2183     end.
     2184   end procedure.
     2185   procedure diasize_need-full-display :
     2186     define output parameter p-need-full-display as logical   no-undo .
     2187     do
     2188     on error undo, return error return-value
     2189     :
     2190       assign
     2191         p-need-full-display = v-diasize-need-full-display
     2192       .
     2193       assign
     2194         v-diasize-need-full-display = false
     2195       .
     2196     end.
     2197   end procedure.
     2198   procedure get-context :
     2199      define output parameter p-db-num as integer          no-undo.
     2200      define output parameter p-user-id as character        no-undo.
     2201      define variable v-login               as character    no-undo.
     2202      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2203      define buffer buf_user-login  for ub.user-login .
     2204      do
     2205      on error undo, return error
     2206      :
     2207            FIND FIRST buf_sys-ctrl no-lock.
     2208            ASSIGN
     2209               v-login = USERID("ub")
     2210               p-db-num = buf_sys-ctrl.db-num
     2211            .
     2212            FIND FIRST buf_user-login
     2213                 WHERE buf_user-login.db-num = p-db-num
     2214                   AND buf_user-login.user-login = v-login
     2215                 no-lock
     2216                 no-error
     2217                 .
     2218            IF AVAILABLE buf_user-login
     2219            THEN DO:
     2220               assign
     2221                  p-user-id = buf_user-login.user-id
     2222               .
     2223            END.
     2224      end.
     2225   end procedure.
     2226       run diasize_init in this-procedure .
     2227   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2228   on F2 of frame Dialog-Frame anywhere do:
     2229     if b-exit :sensitive then DO: apply "CHOOSE":U to b-exit in frame Dialog-Frame. END.
     2230     return no-apply.
     2231   end.
     2232   MAIN-BLOCK:
     2233   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2234     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2235     run init-tt-table in this-procedure .
     2236     RUN my-enable in this-procedure .
     2237     WAIT-FOR GO OF FRAME Dialog-Frame.
     2238   END.
     2239   RUN my-disable.
     2240   PROCEDURE disable_UI :
     2241     HIDE FRAME Dialog-Frame.
     2242   END PROCEDURE.
     2243   PROCEDURE enable_UI :
     2244     ENABLE B-exit b-print B-Help
     2245         WITH FRAME Dialog-Frame.
     2246     VIEW FRAME Dialog-Frame.
     2247     OPEN QUERY BR-norm-loss FOR EACH tt-norm-loss NO-LOCK by tt-norm-loss.clim-grp by tt-norm-loss.position DESCENDING by tt-norm-loss.oil-grp by tt-norm-loss.season INDEXED-REPOSITION.
     2248   END PROCEDURE.
     2249   PROCEDURE init-tt-table :
     2250     for each buf_norm-loss no-lock where buf_norm-loss.type = 0 break by buf_norm-loss.clim-grp by buf_norm-loss.position by buf_norm-loss.oil-grp:
     2251       create tt-norm-loss .
     2252       buffer-copy buf_norm-loss except buf_norm-loss.season buf_norm-loss.sec-vol buf_norm-loss.position to tt-norm-loss no-error .
     2253       if buf_norm-loss.season = 0 then tt-norm-loss.season = "В-Л" .
     2254       else tt-norm-loss.season = "О-З" .
     2255       if buf_norm-loss.position = "0" then tt-norm-loss.position = "наземный" .
     2256       else tt-norm-loss.position = "подземный" .
     2257     end.
     2258   END PROCEDURE.
     2259   PROCEDURE my-disable :
     2260     run disable_UI in this-procedure .
     2261   END PROCEDURE.
     2262   PROCEDURE my-enable :
     2263     enable
     2264       b-exit
     2265       b-help
     2266       b-print
     2267       br-norm-loss
     2268       with frame Dialog-Frame.
     2269     disable
     2270       b-add
     2271       with frame Dialog-Frame .
