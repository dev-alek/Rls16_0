        1   block-level on error undo, throw.
        2   SESSION:ERROR-STACK-TRACE=YES.
        3   define input  parameter parparentproc as handle no-undo .
        4   define input  parameter iChange as character  no-undo .
        5   define output parameter pList   as character no-undo .
        6     define variable v-listact-brw as class ibs.th.ref.bpa.BPA_browse no-undo .
        7     v-listact-brw = new ibs.th.ref.bpa.BPA_browse (iChange).
        8     v-listact-brw:parparentproc = parparentproc.
        9     wait-for  v-listact-brw:ShowDialog() .
       10     pList = v-listact-brw:p-list .
       11   define variable v-err-msg as character no-undo .
       12     catch exAppErrors as class Progress.Lang.AppError :
       13       v-err-msg = exAppErrors:ReturnValue .
       14       if v-err-msg > "" then . else do :
       15         v-err-msg = exAppErrors:GetMessage(1) .
       16         if v-err-msg > "" then . else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\bpa.p" .
       17       end .
       18       message v-err-msg  view-as alert-box.
       19     end catch .
       20     catch exProErrors as class Progress.Lang.ProError :
       21       v-err-msg = exProErrors:GetMessage(1) .
       22       if v-err-msg > "" then . else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\bpa.p" .
       23       message "ProError" skip(1) v-err-msg  view-as alert-box.
       24     end catch .
       25     catch exAnyErrors as class Progress.Lang.Error:
       26       v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\bpa.p " + exAnyErrors:GetMessage(1).
       27       message "LangError" skip(1) v-err-msg  view-as alert-box.
       28     end catch .
       29   finally:
       30       SESSION:ERROR-STACK-TRACE=no.
       31      if valid-object(v-listact-brw) then delete object v-listact-brw no-error .
       32   end finally.
