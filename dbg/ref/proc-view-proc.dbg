        1   block-level on error undo, throw.
        2   session:debug-alert = yes.
        3   output to "error.log".
        4   output close.
        5   define variable vAsyncProc as class ibs.th.file.AsyncProc.
        6   define variable mDir as character no-undo.
        7   vAsyncProc = new ibs.th.file.AsyncProc().
        8   vAsyncProc:creatProcInfo(1,1,1).
        9   assign
       10      mdir =
       11      vAsyncProc:GetPARAM(1)
       12       .
       13   output to "endproc.txt".
       14   put unformatted "end" skip.
       15   output close.
       16     define variable v-ProcView as class ibs.th.file.ProcViewth no-undo .
       17     v-ProcView = new  ibs.th.file.ProcViewth (
       18     ).
       19     //iChange = not iChange.
       20     v-ProcView:MWorkDir = mdir.
       21     wait-for  v-ProcView:ShowDialog() .
       22   delete object vAsyncProc.
       23   delete object v-ProcView.
       24   quit.
       25   define variable v-err-msg as character no-undo .
       26     catch exAppErrors as class Progress.Lang.AppError :
       27       v-err-msg = exAppErrors:ReturnValue .
       28       if v-err-msg > "" then . else do :
       29         v-err-msg = exAppErrors:GetMessage(1) .
       30         if v-err-msg > "" then . else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\proc-view-proc.p" .
       31       end .
       32       message v-err-msg  view-as alert-box.
       33     end catch .
       34     catch exProErrors as class Progress.Lang.ProError :
       35       v-err-msg = exProErrors:GetMessage(1) .
       36       if v-err-msg > "" then . else v-err-msg = "ProError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\proc-view-proc.p" .
       37       message "ProError" skip(1) v-err-msg  view-as alert-box.
       38     end catch .
       39     catch exAnyErrors as class Progress.Lang.Error:
       40       v-err-msg = "Unexpected error в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\proc-view-proc.p " + exAnyErrors:GetMessage(1).
       41       message "LangError" skip(1) v-err-msg  view-as alert-box.
       42     end catch .
       43   finally:
       44       session:error-stack-trace=no.
       45      if valid-object(v-ProcView) then delete object v-ProcView no-error .
       46   end finally.
