      546   define button B-WaitFramStop auto-end-key
      547        label "Стоп"
      548        size 10 by 1 tooltip "Остоновить процесс".
      549   define button B-viewProcInfo
      550        label "Информация"
      551        size 15 by 1 tooltip "Информация о процесс".
      552   define frame waitfram
      553     v-waitfram-action01 format "x(72)" no-label skip
      554     v-waitfram-action02 format "x(72)" no-label skip
      555     v-waitfram-action03 format "x(72)" no-label skip
      556     B-viewProcInfo
      557     B-WaitFramStop at row 4 col 30
      558     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      559     .
      560   define new global shared variable mBatchMode as logical no-undo init ?.
      561   define variable mFramBachModHandle as handle no-undo.
      562   mFramBachModHandle = frame waitfram:handle.
      563   define variable mFameOldVis as logical no-undo.
      564   define variable mVisCUrentVin as logical no-undo.
      565   if session:batch-mode
      566   then
      567      mBatchMode = yes.
      568   if mBatchMode = ? then do:
      569     mVisCUrentVin = current-window:visible.
      570     mFameOldVis = mFramBachModHandle:visible.
      571     mFramBachModHandle:visible  = yes.
      572     mBatchMode = mFramBachModHandle:visible ne yes.
      573     mFramBachModHandle:visible = mFameOldVis.
      574     current-window:visible = mVisCUrentVin.
      575   end.
      576    if  log-manager:logfile-name ne ?
      577     then DO:
      578         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      579         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      580         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      581     end.
      582   on choose of B-WaitFramStop in frame waitfram
      583   do:
      584     mWaitFramStop = yes.
      585     mWaitFramStopUser = yes.
      586   end.
      587   function waitfram-check-timeout returns logical():
      588      define variable vtime as int64 no-undo.
      589      if mWaitFramStopTimeOut
      590      then
      591         return yes.
      592      vtime = ( now - mWaitFramStartProc ) / 1000 .
      593      if     mWaitFramTimeOut ne ?
      594         and mWaitFramTimeOut ne 0
      595         and mWaitFramTimeOut lt vtime
      596      then do:
      597         mWaitFramStopTimeOut = yes.
      598      end.
      599      return mWaitFramStopTimeOut.
      600   end.
      601   procedure waitfram-hide :
      602     if not session:batch-mode
      603     then do
      604     on error undo, return error return-value
      605     :
      606       pause 0 before-hide .
      607       if not mBatchMode then
      608         hide frame waitfram .
      609     if     not mWaitFramView
      610        and mWaitProcEvent
      611     then
      612       process events .
      613     end.
      614   end procedure.
      615   procedure waitfram-show :
      616     define input  parameter p-message as character no-undo .
      617     define variable v-left-margin as integer   no-undo .
      618     if not session:batch-mode
      619     then do
      620     on error undo, return error return-value
      621     :
      622       if length(p-message) <= 70 then do:
      623         assign
      624           v-left-margin = integer((70 - length(p-message)) / 2)
      625         .
      626         assign
      627           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      628         .
      629         assign
      630           v-waitfram-action01 = " "
      631           v-waitfram-action02 = " "
      632                                    + fill(" ", v-left-margin)
      633                                    + p-message
      634           v-waitfram-action03 = " "
      635         .
      636       end.
      637       else do:
      638         define variable vRindex1 as integer no-undo.
      639         define variable vRindex2 as integer no-undo.
      640         vRindex1 = r-index(p-message," ",70).
      641         if vRindex1 = 0
      642         then
      643            vRindex1 = 70.
      644         if length(p-message)  <= vRindex1 + 70 then do:
      645           assign
      646             v-waitfram-action01 = " "
      647             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      648             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      649           .
      650         end.
      651         else do:
      652           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      653           if vRindex2 <= vRindex1
      654           then
      655              vRindex2 = vRindex1 + 70.
      656           assign
      657             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      658             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      659             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      660           .
      661         end.
      662       end.
      663       B-viewProcInfo:visible   in frame waitfram = no.
      664       B-viewProcInfo:sensitive in frame waitfram = no.
      665       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      666       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      667       if  (   mWaitFramView
      668          or  mWaitProcEvent)
      669          and not mBatchMode
      670       then
      671          display
      672             v-waitfram-action01 skip
      673             v-waitfram-action02 skip
      674             v-waitfram-action03 skip
      675          with frame waitfram .
      676       if     mWaitFramView
      677          then do:
      678             if     mWaitFramInterval ne ?
      679                and not mBatchMode
      680             then
      681                wait-for go of frame waitfram pause mWaitFramInterval.
      682          end.
      683          else
      684             if     mWaitProcEvent
      685                and not mBatchMode
      686             then
      687                process events .
      688     end.
      689   end procedure.
      690      procedure waitfram-show-this:
      691         define input  parameter iInterval as int64 no-undo.
      692         define variable vtime as int64 no-undo.
      693         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      694         mWaitFramInterval = iInterval.
      695         run waitfram-show (substitute("&1&2 &3&4" ,
      696                                       mWaitFramTextBeg ,
      697                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      698                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      699                                       mWaitFramTextEnd
      700                                      )
      701                           ).
      702      end.
      703      procedure WaitFramRunPause:
      704         define input  parameter iInterval as dec no-undo.
      705         define variable vStart  as datetime-tz no-undo.
      706         define variable vend    as datetime-tz no-undo.
      707         define variable vint as int64 no-undo.
      708         define variable vOk as logical no-undo.
      709         vStart = now.
      710         vend   = vStart.
      711         publish "WaitFramPause" (iInterval,output vOk).
      712         vend   =  now.
      713         vint = vend - vStart.
      714         vint = iInterval - vint / 1000.
      715         if     not mWaitFramStop
      716            and (   vint > 0
      717                 or (    not vOk
      718                     and iInterval eq ?
      719                     )
      720                 )
      721         then
      722            run waitfram-show-this (iInterval).
      723         vend   =  now.
      724         vint = vend - vStart.
      725         vint = iInterval - vint / 1000.
      726         if     not mWaitFramStop
      727            and vint > 0
      728         then do:
      729            run gbl/pause.p (vint * 1000).
      730         end.
      731         if iInterval ne ?
      732         then
      733            publish "WaitFramStop".
      734         waitfram-check-timeout().
      735      end.
      736      procedure WaitFramWaitFor:
      737         define input  parameter iInterval as dec no-undo.
      738         assign
      739            mWaitFramStartProc   = now
      740            mWaitFramStopUser    = no
      741            mWaitFramStopTimeOut = no
      742         .
      743         block-wait:
      744         do while not mWaitFramStop:
      745            run WaitFramRunPause (iInterval).
      746            if  waitfram-check-timeout()
      747            then do:
      748               leave block-wait.
      749            end.
      750         end.
      751         run waitfram-hide.
      752      end.
      753   procedure waitfram-join :
      754     define input  parameter p-line-1  as character no-undo .
      755     define input  parameter p-line-2  as character no-undo .
      756     define input  parameter p-line-3  as character no-undo .
      757     define output parameter p-message as character no-undo .
      758     do
      759     on error undo, return error return-value
      760     :
      761       assign
      762         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      763                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      764                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      765       .
      766     end.
      767   end procedure.
      768   function waitfram-join-function returns character
      769     (input p-line-1 as character
      770     ,input p-line-2 as character
      771     ,input p-line-3 as character
      772     ).
      773     define variable v-message as character no-undo .
      774     run waitfram-join in this-procedure
      775       (input  p-line-1
      776       ,input  p-line-2
      777       ,input  p-line-3
      778       ,output v-message
      779       ) .
      780     return v-message .
      781   end function .
      782   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      783   FUNCTION mark-string RETURNS CHARACTER
      784     ( input p-recid as recid, input mark-list as character  ) :
      785     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      786   END FUNCTION.
      787   DEFINE shared TEMP-TABLE tt-chk-type NO-UNDO
      788      field sel  as logical
      789      field code as integer
      790      field name as character
      791   index pi code
      792   index si sel code.
      793   define temp-table tt-work-chk-type no-undo like tt-chk-type.
      794   define variable log-res     as log       no-undo.
      795   define variable ri          as recid     no-undo.
      796   define variable v-rid       as recid     no-undo .
      797   define variable v-db-num like ub.db.db-num no-undo .
      798   DEFINE BUTTON b-exit AUTO-GO
      799        LABEL "&Выход ":L
      800        SIZE 10 BY 1.
      801   DEFINE BUTTON b-mark
      802        LABEL "&*":L
      803        SIZE 3.5 BY 1.
      804   DEFINE BUTTON b-sel AUTO-GO
      805        LABEL "Вы&бор ":L
      806        SIZE 10 BY 1.
      807   DEFINE QUERY br-chk-type FOR
      808         tt-work-chk-type SCROLLING.
      809   DEFINE BROWSE br-chk-type
      810     QUERY br-chk-type DISPLAY
      811         tt-work-chk-type.sel COLUMN-LABEL "*" FORMAT "*/":U
      812     tt-work-chk-type.code COLUMN-LABEL "Код" FORMAT ">>>>9":U
      813     tt-work-chk-type.name COLUMN-LABEL "Наименование" FORMAT "X(20)":U
      814       WITH SEPARATORS SIZE 49 BY 15.25.
      815   DEFINE FRAME f-chk-type
      816        b-exit AT ROW 1 COL 1
      817        b-mark AT ROW 1 COL 12.5 WIDGET-ID 2
      818        b-sel AT ROW 1 COL 16
      819        br-chk-type AT ROW 2.5 COL 3
      820        SPACE(1.99) SKIP(0.82)
      821       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      822            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      823            TITLE "Типы чеков":L.
      824   ASSIGN
      825          FRAME f-chk-type:SCROLLABLE       = FALSE.
      826   ON GO OF FRAME f-chk-type
      827   DO:
      828   END.
      829   ON CHOOSE OF b-mark IN FRAME f-chk-type
      830   DO:
      831      define variable v-focused-row       as integer no-undo.
      832      define variable v-repositioned-row  as integer no-undo.
      833      if not avail tt-work-chk-type then return.
      834      tt-work-chk-type.sel = not tt-work-chk-type.sel.
      835      assign
      836         v-focused-row      = br-chk-type:focused-row in frame f-chk-type
      837         v-repositioned-row = current-result-row("br-chk-type")
      838         .
      839      OPEN QUERY br-chk-type FOR EACH tt-work-chk-type NO-LOCK.
      840      if v-focused-row > br-chk-type:height - 2
      841      then do:
      842         assign
      843            v-repositioned-row  = v-repositioned-row + 1
      844            .
      845      end.
      846      else do:
      847         assign
      848            v-focused-row       = v-focused-row + 1
      849            v-repositioned-row  = v-repositioned-row + 1
      850            .
      851      end.
      852      br-chk-type:set-repositioned-row(v-focused-row, "ALWAYS") in frame f-chk-type.
      853      reposition br-chk-type to row v-repositioned-row.
      854      apply "entry" to br-chk-type in frame f-chk-type.
      855   END.
      856   ON CHOOSE OF b-sel IN FRAME f-chk-type
      857   DO:
      858      define buffer b-tt-work-chk-type for tt-work-chk-type.
      859      if not can-find(first b-tt-work-chk-type where b-tt-work-chk-type.sel = yes) then
      860         tt-work-chk-type.sel = yes.
      861      empty temp-table tt-chk-type.
      862      for each tt-work-chk-type:
      863         create tt-chk-type.
      864         buffer-copy tt-work-chk-type to tt-chk-type.
      865      end.
      866   END.
      867   ON RETURN OF br-chk-type IN FRAME f-chk-type
      868   DO:
      869       apply "DEFAULT-ACTION":U to self.
      870   END.
      871   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME f-chk-type:PARENT eq ?
      872     THEN FRAME f-chk-type:PARENT = ACTIVE-WINDOW.
      873   ON WINDOW-CLOSE OF FRAME f-chk-type
      874     APPLY "END-ERROR":U TO SELF.
      875   MAIN-BLOCK:
      876   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      877     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      878   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      879     run mainmenu_getcntxt in parparentproc
      880       (output v-cntxt-db-num
      881       ,output v-cntxt-userid
      882       ,output v-cntxt-level
      883       ,output v-cntxt-host-code-obj
      884       ,output v-cntxt-obj-type
      885       ,output v-cntxt-obj-code
      886       ,output v-cntxt-db-num-obj
      887       ,output v-cntxt-is-admin
      888       ) .
      889   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      890   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      891     (output v-db-num
      892     )  .
      893     run FillTT.
      894     run enable_UI in this-procedure .
      895     WAIT-FOR GO OF FRAME f-chk-type focus br-chk-type.
      896   END.
      897   run disable_UI in this-procedure .
      898   PROCEDURE disable_UI :
      899     HIDE FRAME f-chk-type.
      900   END PROCEDURE.
      901   PROCEDURE enable_UI :
      902     ENABLE
      903       br-chk-type
      904       b-exit
      905       b-sel
      906       b-mark
      907       WITH FRAME f-chk-type.
      908     OPEN QUERY br-chk-type FOR EACH tt-work-chk-type NO-LOCK.
      909   END PROCEDURE.
      910   PROCEDURE FillTT :
      911      define variable vCode    as integer   no-undo.
      912      define variable vName    as character no-undo.
      913      define variable vI       as integer   no-undo.
      914      if not can-find(first tt-chk-type) then do:
      915         do vI = 1 to num-entries("1,6,8,11,12,13,40,69,96,14,15,16,17,36,101,106,108,111,112,113,169,196,114,115,116,117,136,201,206,208,301,306,2,3,4,5,7,43,44"):
      916            vCode = integer(entry(vI, "1,6,8,11,12,13,40,69,96,14,15,16,17,36,101,106,108,111,112,113,169,196,114,115,116,117,136,201,206,208,301,306,2,3,4,5,7,43,44")).
      917            vName = entry(vI, "Продажа,Возврат,Аннуляция,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,ТехПролив,РазблТрнзкц,_Продажа,_Возврат,_Аннуляция,_Инвентаризация,_Z-отчет,_Закрытие_смены,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_РазблТрнзкц,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр").
      918            create tt-work-chk-type.
      919            assign
      920               tt-work-chk-type.code = vCode
      921               tt-work-chk-type.name = vName
      922               .
      923         end.
      924      end.
      925      else do:
      926         for each tt-chk-type:
      927            create tt-work-chk-type.
      928            buffer-copy tt-chk-type to tt-work-chk-type.
      929         end.
      930      end.
      931   END PROCEDURE.
