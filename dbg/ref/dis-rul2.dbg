        1   block-level on error undo, throw.
        2   define parameter buffer bf-dis-rule for ub.dis-rule.
        3   define input parameter p-silent as logical no-undo .
        4   define input parameter p-pos-type as character no-undo .
        5   define input-output parameter par-sts like ub.dis-rule.sts no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        7   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        8   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: dis-rul2.p $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: ref/dis-rul2.p $":U .
       11   define variable vss-description as character no-undo init "Изменение статуса правил скидок".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define   shared variable g#auto as logical no-undo.
       73   define   shared variable g#news as logical no-undo.
       74   define   shared variable g#oxml as logical no-undo.
       75   define   shared variable g#esys as logical no-undo.
       76   define   shared variable g#news-source-db as integer no-undo.
       77   define   shared variable g#esys-source-esys as integer no-undo.
       78   define   shared variable g#db-num as integer   no-undo .
       79   define   shared variable g#userid as character no-undo .
       80   define   shared variable g#passwd as character no-undo .
       81   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   procedure dr-code :
       83     do
       84     on error undo, return error
       85     :
       86       define input  parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
       87       define output parameter  p-des               like ub.dis-rule.des               no-undo .
       88       define output parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
       89       define output parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
       90       define output parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
       91       define output parameter  p-level-1           as character no-undo .
       92       define output parameter  p-level-2           as character no-undo .
       93       define output parameter  p-global             as integer no-undo .
       94       define output parameter  p-host               as integer no-undo .
       95       define output parameter  p-object             as integer no-undo .
       96       define output parameter  p-output-display as logical   no-undo .
       97       define output parameter  p-tree           as char  no-undo .
       98       define output parameter  p-other          as character no-undo .
       99       define variable v-other as character no-undo .
      100       define buffer buf_dis-rule for ub.dis-rule .
      101       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      102       find first buf_dis-rule no-lock where
      103                 buf_dis-rule.rule-num = p-templ-rl-root no-error.
      104       find first buf_dis-cfg-rule no-lock where
      105               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      106           and buf_dis-cfg-rule.pos-type = '':U
      107           and buf_dis-cfg-rule.table-name = '':U
      108           and buf_dis-cfg-rule.discnt-role = '':U
      109           and buf_dis-cfg-rule.self-nonunique = '':U
      110               no-error.
      111       if not available buf_Dis-cfg-rule then do:
      112           undo, return error substitute("неизвестный шаблон скидки &1", p-templ-rl-root ).
      113       end.
      114       assign
      115       p-des = buf_dis-rule.des
      116       p-discnt-type = buf_dis-rule.discnt-type
      117       p-subject-type = buf_dis-rule.subject-type
      118       p-value-type = buf_dis-rule.value-type
      119       p-global = (if available buf_dis-cfg-rule
      120                   then buf_dis-cfg-rule.has-global
      121                   else 0)
      122       p-host = (if available buf_dis-cfg-rule
      123                 then buf_dis-cfg-rule.has-host
      124                 else 0)
      125       p-object = (if available buf_dis-cfg-rule
      126                 then buf_dis-cfg-rule.has-obj
      127                 else 0)
      128       p-output-display = (buf_dis-rule.sts = integer('0':U))
      129       p-tree = buf_Dis-rule.uniq-field
      130       p-other = buf_dis-rule.other-inf
      131       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      132       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      133                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      134                    else '')
      135       .
      136     end.
      137   end procedure.
      138   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      139   procedure disrules-fill-properties:
      140   define input  parameter p-templ-rl-root as integer   no-undo .
      141   define buffer buf_drt-prop for ub.drt-prop.
      142   define buffer buf_temp-drt-prop for temp-drt-prop.
      143   do
      144   on error undo, return error return-value
      145   :
      146     for each buf_temp-drt-prop:
      147       delete buf_temp-drt-prop.
      148     end.
      149     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      150       create buf_temp-drt-prop.
      151       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      152     end.
      153   end.
      154   end procedure.
      155   procedure disrules-get-interface-form :
      156   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
      157   define output parameter p-form-name as character no-undo .
      158   define buffer buf_temp-drt-prop for temp-drt-prop.
      159   define buffer buf_drt-prop for ub.drt-prop.
      160   find first buf_temp-drt-prop where
      161             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
      162         and buf_temp-drt-prop.upper-prop-code = "InputForm"
      163         and buf_temp-drt-prop.prop-code = "FormName" no-error.
      164   if not available buf_temp-drt-prop then do:
      165     find first buf_drt-prop where
      166               buf_drt-prop.templ-rl-root = p-templ-rl-root
      167           and buf_drt-prop.upper-prop-code = "InputForm"
      168           and buf_drt-prop.prop-code = "FormName" no-error.
      169     if available buf_drt-prop then do:
      170       p-form-name = buf_drt-prop.property-value.
      171     end.
      172     else do:
      173       p-form-name = "ref/dis-ruli.w".
      174     end.
      175   end.
      176   else do:
      177     p-form-name = buf_temp-drt-prop.property-value.
      178   end.
      179   end procedure.
      180   ~
      181   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      182   define variable v-waitfram-action01         as character   no-undo .
      183   define variable v-waitfram-action02         as character   no-undo .
      184   define variable v-waitfram-action03         as character   no-undo .
      185   define variable mWaitFramTextBeg            as character   no-undo.
      186   define variable mWaitFramTextEnd            as character   no-undo.
      187   define variable mWaitFramView               as logical     no-undo.
      188   define variable mWaitProcEvent              as logical     no-undo init yes.
      189   define variable mWaitFramInterval           as integer     no-undo init 1 .
      190   define variable mWaitFramStop               as logical     no-undo.
      191   define variable mWaitFramStopUser           as logical     no-undo.
      192   define variable mWaitFramStopTimeOut        as logical     no-undo.
      193   define variable mWaitFramStartProc          as datetime-tz no-undo.
      194   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      195   define button B-WaitFramStop auto-end-key
      196        label "Стоп"
      197        size 10 by 1 tooltip "Остоновить процесс".
      198   define button B-viewProcInfo
      199        label "Информация"
      200        size 15 by 1 tooltip "Информация о процесс".
      201   define frame waitfram
      202     v-waitfram-action01 format "x(72)" no-label skip
      203     v-waitfram-action02 format "x(72)" no-label skip
      204     v-waitfram-action03 format "x(72)" no-label skip
      205     B-viewProcInfo
      206     B-WaitFramStop at row 4 col 30
      207     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      208     .
      209   define new global shared variable mBatchMode as logical no-undo init ?.
      210   define variable mFramBachModHandle as handle no-undo.
      211   mFramBachModHandle = frame waitfram:handle.
      212   define variable mFameOldVis as logical no-undo.
      213   define variable mVisCUrentVin as logical no-undo.
      214   if session:batch-mode
      215   then
      216      mBatchMode = yes.
      217   if mBatchMode = ? then do:
      218     mVisCUrentVin = current-window:visible.
      219     mFameOldVis = mFramBachModHandle:visible.
      220     mFramBachModHandle:visible  = yes.
      221     mBatchMode = mFramBachModHandle:visible ne yes.
      222     mFramBachModHandle:visible = mFameOldVis.
      223     current-window:visible = mVisCUrentVin.
      224   end.
      225    if  log-manager:logfile-name ne ?
      226     then DO:
      227         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      228         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      229         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      230     end.
      231   on choose of B-WaitFramStop in frame waitfram
      232   do:
      233     mWaitFramStop = yes.
      234     mWaitFramStopUser = yes.
      235   end.
      236   function waitfram-check-timeout returns logical():
      237      define variable vtime as int64 no-undo.
      238      if mWaitFramStopTimeOut
      239      then
      240         return yes.
      241      vtime = ( now - mWaitFramStartProc ) / 1000 .
      242      if     mWaitFramTimeOut ne ?
      243         and mWaitFramTimeOut ne 0
      244         and mWaitFramTimeOut lt vtime
      245      then do:
      246         mWaitFramStopTimeOut = yes.
      247      end.
      248      return mWaitFramStopTimeOut.
      249   end.
      250   procedure waitfram-hide :
      251     if not session:batch-mode
      252     then do
      253     on error undo, return error return-value
      254     :
      255       pause 0 before-hide .
      256       if not mBatchMode then
      257         hide frame waitfram .
      258     if     not mWaitFramView
      259        and mWaitProcEvent
      260     then
      261       process events .
      262     end.
      263   end procedure.
      264   procedure waitfram-show :
      265     define input  parameter p-message as character no-undo .
      266     define variable v-left-margin as integer   no-undo .
      267     if not session:batch-mode
      268     then do
      269     on error undo, return error return-value
      270     :
      271       if length(p-message) <= 70 then do:
      272         assign
      273           v-left-margin = integer((70 - length(p-message)) / 2)
      274         .
      275         assign
      276           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      277         .
      278         assign
      279           v-waitfram-action01 = " "
      280           v-waitfram-action02 = " "
      281                                    + fill(" ", v-left-margin)
      282                                    + p-message
      283           v-waitfram-action03 = " "
      284         .
      285       end.
      286       else do:
      287         define variable vRindex1 as integer no-undo.
      288         define variable vRindex2 as integer no-undo.
      289         vRindex1 = r-index(p-message," ",70).
      290         if vRindex1 = 0
      291         then
      292            vRindex1 = 70.
      293         if length(p-message)  <= vRindex1 + 70 then do:
      294           assign
      295             v-waitfram-action01 = " "
      296             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      297             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      298           .
      299         end.
      300         else do:
      301           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      302           if vRindex2 <= vRindex1
      303           then
      304              vRindex2 = vRindex1 + 70.
      305           assign
      306             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      307             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      308             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      309           .
      310         end.
      311       end.
      312       B-viewProcInfo:visible   in frame waitfram = no.
      313       B-viewProcInfo:sensitive in frame waitfram = no.
      314       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      315       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      316       if  (   mWaitFramView
      317          or  mWaitProcEvent)
      318          and not mBatchMode
      319       then
      320          display
      321             v-waitfram-action01 skip
      322             v-waitfram-action02 skip
      323             v-waitfram-action03 skip
      324          with frame waitfram .
      325       if     mWaitFramView
      326          then do:
      327             if     mWaitFramInterval ne ?
      328                and not mBatchMode
      329             then
      330                wait-for go of frame waitfram pause mWaitFramInterval.
      331          end.
      332          else
      333             if     mWaitProcEvent
      334                and not mBatchMode
      335             then
      336                process events .
      337     end.
      338   end procedure.
      339      procedure waitfram-show-this:
      340         define input  parameter iInterval as int64 no-undo.
      341         define variable vtime as int64 no-undo.
      342         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      343         mWaitFramInterval = iInterval.
      344         run waitfram-show (substitute("&1&2 &3&4" ,
      345                                       mWaitFramTextBeg ,
      346                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      347                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      348                                       mWaitFramTextEnd
      349                                      )
      350                           ).
      351      end.
      352      procedure WaitFramRunPause:
      353         define input  parameter iInterval as dec no-undo.
      354         define variable vStart  as datetime-tz no-undo.
      355         define variable vend    as datetime-tz no-undo.
      356         define variable vint as int64 no-undo.
      357         define variable vOk as logical no-undo.
      358         vStart = now.
      359         vend   = vStart.
      360         publish "WaitFramPause" (iInterval,output vOk).
      361         vend   =  now.
      362         vint = vend - vStart.
      363         vint = iInterval - vint / 1000.
      364         if     not mWaitFramStop
      365            and (   vint > 0
      366                 or (    not vOk
      367                     and iInterval eq ?
      368                     )
      369                 )
      370         then
      371            run waitfram-show-this (iInterval).
      372         vend   =  now.
      373         vint = vend - vStart.
      374         vint = iInterval - vint / 1000.
      375         if     not mWaitFramStop
      376            and vint > 0
      377         then do:
      378            run gbl/pause.p (vint * 1000).
      379         end.
      380         if iInterval ne ?
      381         then
      382            publish "WaitFramStop".
      383         waitfram-check-timeout().
      384      end.
      385      procedure WaitFramWaitFor:
      386         define input  parameter iInterval as dec no-undo.
      387         assign
      388            mWaitFramStartProc   = now
      389            mWaitFramStopUser    = no
      390            mWaitFramStopTimeOut = no
      391         .
      392         block-wait:
      393         do while not mWaitFramStop:
      394            run WaitFramRunPause (iInterval).
      395            if  waitfram-check-timeout()
      396            then do:
      397               leave block-wait.
      398            end.
      399         end.
      400         run waitfram-hide.
      401      end.
      402   procedure waitfram-join :
      403     define input  parameter p-line-1  as character no-undo .
      404     define input  parameter p-line-2  as character no-undo .
      405     define input  parameter p-line-3  as character no-undo .
      406     define output parameter p-message as character no-undo .
      407     do
      408     on error undo, return error return-value
      409     :
      410       assign
      411         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      412                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      413                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      414       .
      415     end.
      416   end procedure.
      417   function waitfram-join-function returns character
      418     (input p-line-1 as character
      419     ,input p-line-2 as character
      420     ,input p-line-3 as character
      421     ).
      422     define variable v-message as character no-undo .
      423     run waitfram-join in this-procedure
      424       (input  p-line-1
      425       ,input  p-line-2
      426       ,input  p-line-3
      427       ,output v-message
      428       ) .
      429     return v-message .
      430   end function .
      431   DEFINE TEMP-TABLE tt0-term_dis-rule NO-UNDO LIKE ub.dis-rule.
      432   DEFINE VARIABLE loc#log as logical no-undo .
      433   define buffer buf_dis-rule for ub.dis-rule.
      434   DEFINE VARIABLE choice as logical no-undo .
      435   DEFINE VARIABLE varold-sts like ub.dis-rule.sts no-undo .
      436   define variable v-rule-num like ub.dis-rule.rule-num no-undo .
      437   define variable v-mess as character no-undo .
      438   define variable v-recid as recid no-undo .
      439   define variable v-can as logical no-undo .
      440   define buffer buf_dis-thbj-rule for ub.dis-thbj-rule.
      441   _main:
      442   do
      443   on error undo, return error return-value
      444   :
      445   find current bf-dis-rule exclusive-lock.
      446   if bf-dis-rule.lvl-num > 1
      447   or bf-dis-rule.upper-rule-num > 99999 then do:
      448     v-mess = substitute("Правило скидки №&1: невозможно изменить статус&2" +
      449                         "Менять статус можно только для неиспользуемых шаблонов скидок&2"  +
      450                         "и правил скидок уровня 1"
      451                         , bf-dis-rule.rule-num
      452                         ).
      453     if not p-silent then do:
      454       message
      455       v-mess
      456       view-as alert-box error .
      457     end.
      458     undo, return error (if p-silent then v-mess else '':U).
      459   end.
      460   varold-sts = bf-dis-rule.sts.
      461   if par-sts = ? then do:
      462     CASE varold-sts:
      463       when integer('0':U) then do:
      464         assign
      465         par-sts = integer('1':U).
      466       end.
      467       when integer('1':U)
      468       or
      469       when integer('2':U)
      470       then do:
      471         assign
      472         par-sts = integer('0':U).
      473       end.
      474     END CASE.
      475   end.
      476   CASE par-sts:
      477     WHEN integer('0':U) then do:
      478       if integer('0':U) = bf-dis-rule.sts  then do:
      479         if p-silent then do:
      480           return ''.
      481         end.
      482         else do:
      483           message "Запись уже имеет статус ИСПОЛЬЗУЕТСЯ!"
      484           view-as alert-box ERROR.
      485           par-sts = ?.
      486           return error.
      487         end.
      488       end.
      489       else do:
      490         if p-silent then do:
      491           choice = yes.
      492         end.
      493         else  do:
      494           message
      495           "Запись не используется - восстановить?"
      496           view-as alert-box QUestion buttons YEs-no update choice.
      497         end.
      498       end.
      499     end.
      500     WHEN integer('1':U) then do:
      501       if integer('1':U) = bf-dis-rule.sts  then do:
      502         if p-silent then do:
      503           return ''.
      504         end.
      505         else do:
      506           message "Запись уже имеет статус НЕ ИСПОЛЬЗУЕТСЯ!"
      507           view-as alert-box ERROR.
      508           par-sts = ?.
      509           return error.
      510         end.
      511       end.
      512       else do:
      513         if p-silent then do:
      514           choice = yes.
      515         end.
      516         else do:
      517           message
      518           "Поставить статус НЕ ИСПОЛЬЗУЕТСЯ?" skip(0)
      519           (if bf-dis-rule.rule-num <= 99999
      520           then "Все правила скидок данного типа будут удалены!"
      521           else  '':U)
      522           view-as alert-box QUestion buttons yes-no update choice.
      523         end.
      524       end.
      525     end.
      526   END CASE.
      527   if choice then do:
      528     if bf-dis-rule.sts = integer('0':U)
      529     and bf-dis-rule.rule-num <= 99999
      530     then do:
      531         for each BUF_dis-rule where
      532                 buf_dis-rule.upper-rule-num = bf-dis-rule.rule-num:
      533           v-rule-num = buf_dis-rule.rule-num.
      534           run ref/dis-rul3.p (
      535                           buffer buf_dis-rule
      536                          ,input no
      537                          ,input p-silent
      538                          ,output v-can
      539                          ) no-error .
      540         if error-status:error
      541         or not v-can
      542         then do:
      543             v-mess = substitute("Ошибка при удалении ПРАВИЛА СКИДОК №&1&2&3&2&4"
      544                                 , buf_dis-rule.rule-num
      545                                 , chr(10)
      546                                 , error-status:get-message(1)
      547                                 , return-value ).
      548           if not p-silent then do:
      549             message
      550             v-mess
      551             view-as alert-box error .
      552           end.
      553             undo _main, return error (if p-silent then v-mess else '':U).
      554           end.
      555       end.
      556     end.
      557     else do:
      558       CASE par-sts:
      559         when integer('1':U) then do:
      560           run ref/dis-rul3.p (
      561                          buffer bf-dis-rule
      562                         ,input yes
      563                         ,input yes
      564                         ,output v-can
      565                         ) no-error.
      566         end.
      567         when integer('0':U) then do:
      568           v-recid = recid(bf-dis-rule).
      569           v-can = yes.
      570           if p-pos-type = ''
      571           or p-pos-type = ? then do:
      572             run ref/dcr-pos.p (
      573                                input 'ИЗМЕНЕНИЕ':U
      574                               ,input p-silent
      575                               ,input bf-dis-rule.templ-rl-root
      576                               ,input bf-dis-rule.host-code
      577                               ,input bf-dis-rule.obj-type
      578                               ,input bf-dis-rule.obj-code
      579                               ,input par-sts
      580                               ,input bf-dis-rule.rule-num
      581                               ,output p-pos-type) no-error.
      582             if error-status:error then do:
      583               v-mess = substitute("Ошибка при определении места действия ПРАВИЛА СКИДОК №&1&2&3&2&4"
      584                                       , v-rule-num
      585                                       , chr(10)
      586                                       , error-status:get-message(1)
      587                                       , return-value ).
      588               if not p-silent then do:
      589                 message
      590                 v-mess
      591                 view-as alert-box error .
      592               end.
      593               undo _main, return error (if p-silent then v-mess else '':U).
      594             end.
      595           end.
      596           run ref/dis-rul1.p (
      597                          input bf-dis-rule.rule-num
      598                         ,input p-pos-type
      599                         ,input bf-dis-rule.templ-rl-root
      600                         ,input bf-dis-rule.templ-rl-root
      601                         ,input bf-dis-rule.des
      602                         ,input bf-dis-rule.dis-kat
      603                         ,input bf-dis-rule.discnt-type
      604                         ,input bf-dis-rule.doc-qnty
      605                         ,input bf-dis-rule.tot-sum
      606                         ,input bf-dis-rule.charkey_one
      607                         ,input bf-dis-rule.charkey_two
      608                         ,input bf-dis-rule.charkey_three
      609                         ,input bf-dis-rule.deckey_one
      610                         ,input bf-dis-rule.deckey_two
      611                         ,input bf-dis-rule.deckey_three
      612                         ,input bf-dis-rule.key#_one
      613                         ,input bf-dis-rule.key#_two
      614                         ,input bf-dis-rule.key#_three
      615                         ,input bf-dis-rule.subject-type
      616                         ,input bf-dis-rule.TIME-TEMPL-RL-ROOT
      617                         ,input bf-dis-rule.time-rule-num
      618                         ,input bf-dis-rule.upper-rule-num
      619                         ,input bf-dis-rule.value-type
      620                         ,input bf-dis-rule.host-code
      621                         ,INPUT bf-dis-rule.obj-type
      622                         ,INPUT bf-dis-rule.obj-code
      623                         ,INPUT bf-dis-rule.discnt-value
      624                         ,input table tt0-term_dis-rule
      625                         ,input-output v-recid
      626                         ,input 'ИЗМЕНЕНИЕ':U + chr(4) + 'sts'
      627                         ,input yes
      628                         ) no-error.
      629         end.
      630       END CASE.
      631       if error-status:error
      632       or not v-can
      633       then do:
      634         v-mess = substitute("ПРАВИЛО СКИДОК №&1 не может быть выключено/выключено &2&3&2&4"
      635                               , bf-dis-rule.rule-num
      636                               , chr(10)
      637                               , error-status:get-message(1)
      638                               , return-value ).
      639        if not p-silent then do:
      640           message
      641           v-mess
      642           view-as alert-box error .
      643         end.
      644         undo _main, return error (if p-silent then v-mess else '':U).
      645       end.
      646     end.
      647     assign
      648     bf-dis-rule.sts = par-sts.
      649     v-rule-num = bf-dis-rule.rule-num.
      650     release bf-dis-rule no-error .
      651     if error-status:error then do:
      652       v-mess = substitute("Ошибка при сохранении записи ПРАВИЛА СКИДОК №&1&2&3&2&4"
      653                                , v-rule-num
      654                                , chr(10)
      655                                , error-status:get-message(1)
      656                                , return-value ).
      657       if not p-silent then do:
      658         message
      659         v-mess
      660         view-as alert-box error .
      661       end.
      662       undo _main, return error (if p-silent then v-mess else '':U).
      663     end.
      664     if par-sts = integer('1':U) then do:
      665       for each buf_dis-thbj-rule exclusive-lock where
      666               buf_dis-thbj-rule.rule-num = v-rule-num
      667       on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      668       on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      669       on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      670       :
      671         delete buf_dis-thbj-rule.
      672       end.
      673     end.
      674   end.
      675   par-sts = ?.
      676   end.
