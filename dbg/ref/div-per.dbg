        1   define temp-table temp-date no-undo
        2   field date1 as date
        3   field date2 as date
        4   index pi date1
        5   .
        6   define input-output PARAMETER table for temp-date .
        7   define variable is-ok as logical initial false no-undo.
        8   define variable p-from-date as date no-undo .
        9   define variable p-to-date as date no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision$":U .
       11   define variable vss-author      as character no-undo init "$Author$":U .
       12   define variable vss-date        as character no-undo init "$Date$":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       14   define variable vss-archive     as character no-undo init "$Archive$":U .
       15   define variable vss-description as character no-undo init "Задание диапазона дат: начало - конец".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   procedure proc-alt-shift-f2:
       86     if not ibs.th.gbl.gbl-var:rcode
       87   then
       88     run gbl\inidebug.p .
       89   end.
       90   procedure proc-alt-shift-f3:
       91     run gbl/prvssinf.p
       92       ( input this-procedure
       93       ) .
       94   end.
       95   define variable v-inform-launched as logical no-undo initial false .
       96   procedure proc-alt-shift-f4:
       97     define variable v-action as character no-undo .
       98     if v-inform-launched = false then do:
       99       assign
      100         v-inform-launched = true
      101       .
      102       run gbl/d-inform.w
      103         (  input self
      104         ,  input this-procedure
      105         , output v-action
      106         ) no-error .
      107       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      108       assign
      109         v-inform-launched = false
      110       .
      111     end.
      112   end.
      113   procedure proc-alt-f1:
      114     run gbl/corrhelp.p
      115       (input this-procedure
      116       ) .
      117   end .
      118   on alt-shift-f2 anywhere do:
      119     run proc-alt-shift-f2.
      120   end.
      121   on alt-shift-f3 anywhere do:
      122     run proc-alt-shift-f3 in this-procedure .
      123   end.
      124   on alt-shift-f4 anywhere do:
      125     run proc-alt-shift-f4 in this-procedure.
      126   end.
      127   on alt-f1 anywhere do:
      128     run proc-alt-f1 in this-procedure .
      129   end.
      130   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   procedure cur-time :
      132      define output parameter p-today as date      no-undo .
      133      define output parameter p-time  as integer   no-undo .
      134     do
      135     on error undo, return error
      136     :
      137       define variable v-date1 as date      no-undo .
      138       define variable v-date2 as date      no-undo .
      139       define variable v-time  as integer   no-undo .
      140       assign
      141         v-date1 = today
      142         v-time  = time
      143         v-date2 = today
      144       .
      145       if v-date1 <> v-date2
      146       then do:
      147         assign
      148           v-date1 = today
      149           v-time  = v-time
      150         .
      151       end.
      152       assign
      153         p-today = v-date1
      154         p-time  = v-time
      155       .
      156     end.
      157   end.
      158   function cur-time-date returns character
      159   :
      160     return string(today, '99/99/9999':U) .
      161   end.
      162   function cur-time-mjd returns decimal
      163   :
      164     define variable v-date as date      no-undo .
      165     define variable v-time as integer   no-undo .
      166     run cur-time in this-procedure
      167       (output v-date
      168       ,output v-time
      169       ) .
      170     return integer(v-date) - 2400002 + (v-time / 86400) .
      171   end.
      172   function cur-time-get-ending-index returns integer
      173   (input p-number as integer
      174   )
      175   :
      176     if p-number < 0
      177     or p-number = ?
      178     then do:
      179       return 1 .
      180     end.
      181     define variable v-rest as integer   no-undo .
      182     assign
      183       p-number = p-number modulo 100
      184     .
      185     if p-number < 20
      186     then do:
      187       assign
      188         v-rest = p-number
      189       .
      190     end.
      191     else do:
      192       assign
      193         v-rest = p-number modulo 10
      194       .
      195     end.
      196     case v-rest :
      197       when 1
      198       then do:
      199         return 2 .
      200       end.
      201       when 2 or
      202       when 3 or
      203       when 4
      204       then do:
      205         return 3 .
      206       end.
      207       otherwise do:
      208         return 1 .
      209       end.
      210     end case .
      211   end.
      212   procedure cur-time-mjd-to-date :
      213      define input  parameter i-mjd-diff as decimal no-undo.
      214      define output parameter o-Date     as date    no-undo.
      215      define output parameter o-Time     as integer no-undo.
      216      define variable v-day-number as integer   no-undo .
      217      if    i-mjd-diff < 0
      218         or i-mjd-diff = ?
      219      then do:
      220         return "?" .
      221      end.
      222      assign
      223         v-day-number = truncate(i-mjd-diff,0).
      224         o-Date = date(v-day-number + 2400002).
      225         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      226     .
      227   end.
      228   function cur-time-mjd-to-string returns character
      229   (input p-mjd-diff as decimal
      230   )
      231   :
      232     define variable v-day-number as integer   no-undo .
      233     define variable v-seconds    as integer   no-undo .
      234     define variable v-hour       as integer   no-undo .
      235     define variable v-min        as integer   no-undo .
      236     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      237     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      238     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      239     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      240     if p-mjd-diff < 0
      241     or p-mjd-diff = ?
      242     then do:
      243       return "?" .
      244     end.
      245     assign
      246       v-day-number = integer(truncate(p-mjd-diff,0))
      247       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      248     .
      249     if v-seconds > 86400
      250     then do:
      251       assign
      252         v-seconds = 86400 - 1
      253       .
      254     end.
      255     if v-seconds < 0
      256     then do:
      257       assign
      258         v-seconds = 0
      259       .
      260     end.
      261     assign
      262       v-hour = truncate(v-seconds / 3600, 0)
      263     .
      264     assign
      265       v-seconds = v-seconds modulo 3600
      266     .
      267     assign
      268       v-min = truncate(v-seconds / 60, 0)
      269     .
      270     assign
      271       v-seconds = v-seconds modulo 60
      272     .
      273     return
      274         (if v-day-number <> 0
      275           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      276           else ""
      277         )
      278       + (if v-day-number <> 0 or v-hour <> 0
      279           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      280           else ""
      281         )
      282       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      283           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      284           else ""
      285         )
      286       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      287       .
      288   end.
      289   function cur-time-string returns character
      290   :
      291     define variable v-date as date      no-undo .
      292     define variable v-time as integer   no-undo .
      293     run cur-time in this-procedure
      294       (output v-date
      295       ,output v-time
      296       ) .
      297     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      298   end.
      299   function cur-time-string-sec returns character
      300   :
      301     define variable v-date as date      no-undo .
      302     define variable v-time as integer   no-undo .
      303     run cur-time in this-procedure
      304       (output v-date
      305       ,output v-time
      306       ) .
      307     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      308   end.
      309   function cur-time-custom  returns character
      310   (input p-prefix as character
      311   ,input p-date-format as character
      312   ,input p-delimiter as character
      313   ,input p-time-format as character
      314   ,input p-suffix as character
      315   )
      316   :
      317     define variable v-date as date      no-undo .
      318     define variable v-time as integer   no-undo .
      319     run cur-time in this-procedure
      320       (output v-date
      321       ,output v-time
      322       ) .
      323     return
      324       p-prefix
      325       + string(v-date, p-date-format)
      326       + p-delimiter
      327       + string(v-time, p-time-format)
      328       + p-suffix
      329       .
      330   end.
      331   function cur-time-print  returns character
      332   :
      333     define variable v-date as date      no-undo .
      334     define variable v-time as integer   no-undo .
      335     run cur-time in this-procedure
      336       (output v-date
      337       ,output v-time
      338       ) .
      339     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      340   end.
      341   function cur-time-datetime returns datetime
      342   :
      343     define variable v-char as character no-undo .
      344     define variable v-datetime as datetime no-undo .
      345     v-char = cur-time-string().
      346     v-datetime = datetime(v-char).
      347     return  v-datetime.
      348   end.
      349   function cur-time-string-msec returns character
      350   :
      351     define variable v-date as datetime  no-undo .
      352     v-date = now.
      353     return string(v-date) .
      354   end.
      355   FUNCTION LastDay-MY  RETURNS INTEGER ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
      356     DEFINE VARIABLE j_day AS INTEGER NO-UNDO.
      357     run get-last-day-my in this-procedure ( input i-month, input i-year, output j_day ) no-error.
      358     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_day ).
      359   END FUNCTION.
      360   PROCEDURE get-last-day-MY :
      361     DEFINE  INPUT PARAMETER p-month AS INTEGER NO-UNDO.
      362     DEFINE  INPUT PARAMETER p-year  AS INTEGER NO-UNDO.
      363     DEFINE OUTPUT PARAMETER p-day   AS INTEGER NO-UNDO.
      364     DEFINE VARIABLE t_date AS DATE NO-UNDO.
      365     DO ON ERROR UNDO, RETURN ERROR :
      366       ASSIGN t_date = DATE( p-month, 28, p-year ).
      367       ASSIGN p-day  = DAY( t_date - DAY( t_date + 4 ) + 4 ).
      368     END.
      369   END PROCEDURE.
      370   DEFINE BUTTON b-del
      371        LABEL "Удал"
      372        SIZE 7 BY 1 TOOLTIP "Удалить интервал произвольно".
      373   DEFINE BUTTON b-help DEFAULT
      374        LABEL "Помо&щь"
      375        SIZE 12 BY 1
      376        BGCOLOR 8 .
      377   DEFINE BUTTON B-more
      378        LABEL "Еще"
      379        SIZE 7 BY 1 TOOLTIP "Добавить интервал произвольно".
      380   DEFINE BUTTON b-ok AUTO-GO DEFAULT
      381        LABEL "&Ввод "
      382        SIZE 12 BY 1
      383        BGCOLOR 8 .
      384   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
      385        LABEL "&Отмена"
      386        SIZE 12 BY 1
      387        BGCOLOR 8 .
      388   DEFINE VARIABLE date-b AS DATE FORMAT "99/99/9999":U
      389        LABEL "С"
      390        VIEW-AS FILL-IN
      391        SIZE 11 BY 1 NO-UNDO.
      392   DEFINE VARIABLE date-e AS DATE FORMAT "99/99/9999":U
      393        LABEL "По"
      394        VIEW-AS FILL-IN
      395        SIZE 11 BY 1 NO-UNDO.
      396   DEFINE VARIABLE RADIO-TYPE AS INTEGER
      397        VIEW-AS RADIO-SET VERTICAL
      398        RADIO-BUTTONS
      399             "<--->", 0,
      400   "Годам", 1,
      401   "Месяцам", 2,
      402   "Неделям", 3,
      403   "Размер интервала в днях", 5,
      404   "Количество интервалов", 6,
      405   "Произвольно", 7,
      406   "Очистить", 8
      407        SIZE 26 BY 9.25 NO-UNDO.
      408   DEFINE QUERY BROWSE-date FOR
      409         temp-date SCROLLING.
      410   DEFINE BROWSE BROWSE-date
      411     QUERY BROWSE-date DISPLAY
      412         temp-date.date1 FORMAT "99/99/9999"  column-label "c"
      413         temp-date.date2 FORMAT "99/99/9999"  column-label "по"
      414       WITH NO-ROW-MARKERS SEPARATORS SIZE 28.63 BY 13.46 EXPANDABLE.
      415   DEFINE FRAME get-rep
      416        b-ok AT ROW 1 COL 1
      417        b-quit AT ROW 1 COL 13
      418        b-help AT ROW 1 COL 25
      419        BROWSE-date AT ROW 2 COL 71.51 RIGHT-ALIGNED
      420        date-b AT ROW 2.5 COL 4.5 COLON-ALIGNED
      421        date-e AT ROW 2.5 COL 22 COLON-ALIGNED
      422        RADIO-TYPE AT ROW 5 COL 3 NO-LABEL
      423        B-more AT ROW 12.25 COL 28
      424        b-del AT ROW 13.25 COL 28
      425        "Разбить по:" VIEW-AS TEXT
      426             SIZE 31 BY .67 AT ROW 4.25 COL 4.5
      427             FGCOLOR 4
      428        SPACE(37.12) SKIP(10.61)
      429       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      430            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      431            TITLE "Задайте период"
      432            CANCEL-BUTTON b-quit.
      433   ASSIGN
      434          FRAME get-rep:SCROLLABLE       = FALSE.
      435   ON CHOOSE OF b-del IN FRAME get-rep
      436   DO:
      437     IF AVAILABLE temp-date THEN DELETE  temp-date.
      438   OPEN QUERY BROWSE-date FOR EACH temp-date.
      439   END.
      440   ON CHOOSE OF B-more IN FRAME get-rep
      441   DO:
      442           define variable date-1  as date   no-undo .
      443           define variable date-2  as date   no-undo .
      444           define variable v-ok as logical   no-undo .
      445             run gbl/get-per.w (
      446                   output        v-ok ,
      447                   input-output  date-1  ,
      448                   input-output  date-2  ) .
      449               if v-ok then do:
      450                     create temp-date.
      451                     assign
      452                       temp-date.date1 = date-1
      453                       temp-date.date2 = date-2
      454                     .
      455                 end.
      456   OPEN QUERY BROWSE-date FOR EACH temp-date.
      457   END.
      458   ON CHOOSE OF b-ok IN FRAME get-rep
      459   DO:
      460   define variable v-calk as integer   no-undo  init 0.
      461   for each  temp-date :
      462   v-calk = v-calk + 1 .
      463   end.
      464   if v-calk = 0 then message "Вы не задали ни одного интервала!!!" view-as alert-box information .
      465     define buffer b_date for temp-date .
      466     for each temp-date :
      467       find first b_date where
      468                     ( b_date.date1 >= temp-date.date1 and
      469                       b_date.date1 <= temp-date.date2  ) or
      470                     ( b_date.date2 >= temp-date.date1 and
      471                       b_date.date2 <= temp-date.date2  )
      472                    no-error .
      473        if available b_date and
      474            not  (   b_date.date1 = temp-date.date1  and
      475                     b_date.date2 = temp-date.date2  )  then do:
      476             message "Интервалы пересекаются ! "        skip
      477                       temp-date.date1   temp-date.date2 skip
      478                       b_date.date1      b_date.date2    skip
      479                       view-as alert-box error .
      480             return no-apply.
      481        end.
      482     end.
      483   END.
      484   ON CHOOSE OF b-quit IN FRAME get-rep
      485   DO:
      486     for EACH temp-date: DELETE temp-date. END.
      487   END.
      488   ON RETURN OF date-b IN FRAME get-rep
      489   DO:
      490       APPLY "ENTRY" TO date-e IN FRAME get-rep.
      491       RETURN NO-APPLY.
      492   END.
      493   ON RETURN OF date-e IN FRAME get-rep
      494   DO:
      495       APPLY "CHOOSE" TO b-ok IN FRAME get-rep.
      496       RETURN NO-APPLY.
      497   END.
      498   ON VALUE-CHANGED OF RADIO-TYPE IN FRAME get-rep
      499   DO:
      500     ASSIGN date-b date-e RADIO-TYPE no-error .
      501     if error-status :error then RADIO-TYPE = 0 .
      502     if date-b >= date-e then do:
      503       message "Не верно задана дата !" view-as alert-box error .
      504       return no-apply .
      505     end.
      506     if date-e - date-b <= 4 then do:
      507       message "Очень маленький период !" view-as alert-box error .
      508       return no-apply .
      509     end.
      510   define variable ii as integer   no-undo .
      511   define variable mm as integer   no-undo .
      512   define variable dd as integer   no-undo .
      513   define variable v-last-day as integer   no-undo .
      514   define variable yy1  as integer   no-undo .
      515   define variable yy2  as integer   no-undo .
      516   define variable v-dd as date      no-undo .
      517       CASE RADIO-TYPE :
      518        when 8
      519        then do:
      520           for EACH temp-date: DELETE temp-date. END.
      521        end.
      522        when 1
      523        then do:
      524           if year(date-b) <  year(date-e) then do:
      525              repeat ii = year(date-b) to year(date-e) :
      526                create temp-date.
      527                assign
      528                  temp-date.date1 = date(1 ,1 ,ii)
      529                  temp-date.date2 = date(12,31,ii)
      530                .
      531              end.
      532           end.
      533        end.
      534        when 2
      535        then do:
      536        yy1 = year(date-b) .
      537        yy2 = year(date-e).
      538           if yy1 =  yy2 then do:
      539              repeat ii = yy1 to yy2 :
      540                 repeat mm = month(date-b) to month(date-e) :
      541                   v-last-day = lastday-my ( mm , ii ) .
      542                   create temp-date.
      543                   assign
      544                     temp-date.date1 = date(mm,1,ii)
      545                     temp-date.date2 = date(mm, v-last-day ,ii)
      546                   .
      547                 end.
      548              end.
      549           end.
      550          if yy1 < yy2 then do:
      551                 repeat mm = month(date-b) to 12 :
      552                   v-last-day = lastday-my ( mm , yy1 ) .
      553                   create temp-date.
      554                   assign
      555                     temp-date.date1 = date(mm,1,yy1)
      556                     temp-date.date2 = date(mm, v-last-day ,yy1)
      557                   .
      558                 end.
      559                 repeat mm = 1 to  month(date-e) :
      560                   v-last-day = lastday-my ( mm , yy2 ) .
      561                   create temp-date.
      562                   assign
      563                     temp-date.date1 = date(mm,1,yy2)
      564                     temp-date.date2 = date(mm, v-last-day ,yy2)
      565                   .
      566                 end.
      567                 if yy2 - yy1 > 1 then do:
      568                     yy1 = year(date-b) + 1 .
      569                     yy2 = year(date-e) - 1.
      570                           repeat ii = yy1 to yy2 :
      571                               repeat mm = 1 to 12 :
      572                                 v-last-day = lastday-my ( mm , ii ) .
      573                                 create temp-date.
      574                                 assign
      575                                   temp-date.date1 = date(mm,1,ii)
      576                                   temp-date.date2 = date(mm, v-last-day ,ii)
      577                                 .
      578                               end.
      579                         end.
      580                 end.
      581          end.
      582        end.
      583        when 3
      584        then do:
      585        define variable v-w as integer   no-undo .
      586        v-w = int(date-b) modulo 7 .
      587        if v-w <> 1 then do:
      588           if v-w = 0 then date-b = date-b + 1 .
      589           else date-b = date-b - v-w + 1 .
      590        end.
      591               repeat v-dd = date-b to date-e  by 7 :
      592                           create temp-date.
      593                           assign
      594                             temp-date.date1 = v-dd
      595                             temp-date.date2 = v-dd + 6
      596                           .
      597                  if temp-date.date2 + 6 > date-e then leave.
      598               end.
      599        end.
      600        when 4
      601        then do:
      602               repeat v-dd = date-b to date-e  by 1 :
      603                           create temp-date.
      604                           assign
      605                             temp-date.date1 = v-dd
      606                             temp-date.date2 = v-dd
      607                           .
      608               end.
      609        end.
      610        when 5
      611        then do:
      612           define variable v-kol-days-c as character no-undo .
      613           run gbl/d-prompt.w (
      614               'title=':u + "Введите количество дней" + '\':u
      615             + 'text1=':u + "Введите количество дней" + '\':u
      616             + 'type=int\':u
      617             + 'fillin_row=2\':u
      618             + 'fillin_col=4\':u
      619             + 'fillin_width=5\':u
      620             + 'fillin_height=1\':u
      621             + 'max-chars=5\':u
      622             + 'readonly=no\':u
      623             , input-output v-kol-days-c
      624             ).
      625             if int (v-kol-days-c) = 0 then do:
      626                 return no-apply .
      627             end.
      628            define variable vv-d as integer   no-undo .
      629            define variable vv-ds as integer   no-undo .
      630            vv-ds = int(v-kol-days-c).
      631                repeat v-dd = date-b to date-e  by  1  :
      632                     create temp-date.
      633                     assign
      634                       temp-date.date1 = v-dd
      635                       temp-date.date2 = v-dd + vv-ds - 1
      636                       v-dd = temp-date.date2
      637                     .
      638                     if temp-date.date2 + vv-ds > date-e then leave.
      639                end.
      640        end.
      641        when 6
      642        then do:
      643           define variable v-kol-int-c as character no-undo .
      644           run gbl/d-prompt.w (
      645               'title=':u + "Введите количество интервалов" + '\':u
      646             + 'text1=':u + "Введите количество интервалов" + '\':u
      647             + 'type=int\':u
      648             + 'fillin_row=2\':u
      649             + 'fillin_col=4\':u
      650             + 'fillin_width=5\':u
      651             + 'fillin_height=1\':u
      652             + 'max-chars=5\':u
      653             + 'readonly=no\':u
      654             , input-output v-kol-int-c
      655             ).
      656             if int (v-kol-int-c) < 3 then do:
      657                 message "Интервалов должно быть не менее 3 !" view-as alert-box error .
      658                 return no-apply .
      659             end.
      660             define variable v-vdv as integer   no-undo .
      661             define variable v-vdvs as integer   no-undo .
      662             v-vdvs = int( (date-e - date-b) / int (v-kol-int-c)).
      663               repeat v-dd = date-b to date-e  by  1 :
      664                           create temp-date.
      665                           assign
      666                             temp-date.date1 = v-dd
      667                             temp-date.date2 = v-dd +  v-vdvs - 1
      668                             v-dd = temp-date.date2
      669                           .
      670                           if v-dd + v-vdvs > date-e then leave.
      671               end.
      672        end.
      673        when 7
      674        then do:
      675           define variable date-1  as date   no-undo .
      676           define variable date-2  as date   no-undo .
      677           define variable v-ok as logical   no-undo .
      678             run gbl/get-per.w (
      679                   output        v-ok ,
      680                   input-output  date-1  ,
      681                   input-output  date-2  ) .
      682               if v-ok then do:
      683                     create temp-date.
      684                     assign
      685                       temp-date.date1 = date-1
      686                       temp-date.date2 = date-2
      687                     .
      688                 end.
      689        end.
      690       END CASE.
      691   OPEN QUERY BROWSE-date FOR EACH temp-date.
      692   END.
      693   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME get-rep:PARENT eq ?
      694   THEN FRAME get-rep:PARENT = ACTIVE-WINDOW.
      695   ON WINDOW-CLOSE OF FRAME get-rep APPLY "END-ERROR":U TO SELF.
      696   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
