     1162   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1163   procedure minbtn-set :
     1164       do
     1165           on error undo, return error return-value
     1166           :
     1167           define variable ii              as integer       no-undo .
     1168           define variable fh              as widget-handle no-undo .
     1169           define variable hh              as widget-handle no-undo .
     1170           define variable v-h             as handle        extent 4 no-undo .
     1171           define variable v-name-button   as character     no-undo .
     1172           define variable v-help-old-x    as decimal       no-undo .
     1173           define variable v-help-old-y    as decimal       no-undo .
     1174           define variable v-help-old-size as decimal       no-undo .
     1175           define variable v-frame-width   as decimal       no-undo .
     1176           define variable jj              as integer       no-undo .
     1177           do
     1178               on error undo, return error
     1179               :
     1180               assign
     1181                   v-frame-width = frame get-rep:width - 0.3
     1182                   fh            = frame get-rep:first-child
     1183                   hh            = fh:first-child
     1184                   ii            = 1
     1185                   .
     1186               do while valid-handle(hh):
     1187                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1188                   do:
     1189                       case lc(hh:name) :
     1190                           when "b-help" then
     1191                               do:
     1192                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1193                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1194                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1195                                   hh:TOOLTIP = "Помощь" .
     1196                                   v-help-old-x = hh:column .
     1197                                   v-help-old-y = hh:row    .
     1198                                   v-help-old-size = hh:width .
     1199                                   hh:width-chars = 2.5 .
     1200                               end.
     1201                           when "b-print" then
     1202                               do:
     1203                                   hh:load-image("cmp/b-print.bmp":u) .
     1204                                   hh:TOOLTIP = "Печать" .
     1205                                   v-h[ii] = hh:handle .
     1206                                   ii = ii + 1 .
     1207                                   hh:width-chars = 3 .
     1208                               end.
     1209                           when "b-history" or
     1210                           when "b-hist" then
     1211                               do:
     1212                                   hh:load-image("cmp/b-hist.bmp":u) .
     1213                                   hh:TOOLTIP = "История" .
     1214                                   v-h[ii] = hh:handle .
     1215                                   ii = ii + 1 .
     1216                                   hh:width-chars = 3 .
     1217                               end.
     1218                           when "b-sch" then
     1219                               do:
     1220                                   hh:load-image("cmp/b-sch.bmp":u) .
     1221                                   hh:TOOLTIP = "Установка Фильтра" .
     1222                                   v-h[ii] = hh:handle .
     1223                                   ii = ii + 1 .
     1224                                   hh:width-chars = 3 .
     1225                               end.
     1226                           when "b-hist-user" then
     1227                               do:
     1228                                   hh:load-image("cmp/b-hist.bmp":u) .
     1229                                   hh:TOOLTIP = "История пользователя" .
     1230                                   ii = ii + 1 .
     1231                               end.
     1232                       end case.
     1233                   end.
     1234                   hh = hh:next-sibling.
     1235               end.
     1236               b-help:column = v-frame-width - b-help:width-chars.
     1237               jj = 0.
     1238               repeat ii = 4 to 1 by -1 :
     1239                   if valid-handle (v-h[ii] ) then
     1240                   do:
     1241                       jj  = jj + 1 .
     1242                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1243                       v-h[ii]:row    = v-help-old-y .
     1244                   end.
     1245               end.
     1246           end.
     1247       end.
     1248   end procedure.
     1249   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1250   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1251   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1252   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1253   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1254   define variable v-diasize-current-frame-height as decimal   no-undo .
     1255   define variable v-diasize-change-size          as logical   no-undo .
     1256   define variable v-diasize-resize-button        as handle    no-undo .
     1257   define variable v-diasize-wndmax               as logical   no-undo .
     1258   define variable v-diasize-wndstore             as logical   no-undo .
     1259   define variable v-diasize-proc-name            as character no-undo .
     1260   define variable v-diasize-browse-handle        as handle    no-undo .
     1261   define variable v-diasize-browse-number        as integer   no-undo .
     1262   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1263   define temp-table temp-diasize-handle no-undo
     1264     field handle-value  as handle
     1265     field save-position as decimal
     1266     index xpk is primary unique handle-value
     1267     .
     1268   define temp-table temp-browse-handle no-undo
     1269     field browse-type   as character
     1270     field browse-number as integer
     1271     field browse-handle as handle
     1272     field original-size as decimal
     1273     index xpk is primary unique browse-type browse-number
     1274     index xie browse-type browse-handle
     1275   .
     1276   procedure diasize_change-height :
     1277     define input  parameter p-change-value  as decimal   no-undo .
     1278     define input  parameter p-move-resize   as logical   no-undo .
     1279     define variable v-field-group-handle    as handle    no-undo .
     1280     define variable v-object-handle         as handle    no-undo .
     1281     define variable v-frame-height          as decimal   no-undo .
     1282     define variable v-frame-virtual-height  as decimal   no-undo .
     1283     define variable v-browse-height         as decimal   no-undo .
     1284     define variable v-window-height         as decimal   no-undo .
     1285     define variable v-window-virtual-height as decimal   no-undo .
     1286     define variable v-change-sign           as integer   no-undo .
     1287     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1288     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1289     if p-change-value > 0
     1290     then do:
     1291       if frame get-rep :height + p-change-value
     1292           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1293       then do:
     1294         assign
     1295           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1296                           - (frame get-rep :height-chars)
     1297         .
     1298         if p-change-value <= 0
     1299         then do:
     1300           run diasize_position-resize-button in this-procedure .
     1301           return .
     1302         end.
     1303       end.
     1304     end.
     1305     if p-change-value < 0
     1306     then do:
     1307       if frame get-rep :height + p-change-value < v-diasize-orig-frame-height
     1308       then do:
     1309         assign
     1310           p-change-value = v-diasize-orig-frame-height
     1311                          - (frame get-rep :height-chars)
     1312         .
     1313         if p-change-value >= 0
     1314         then do:
     1315           run diasize_position-resize-button in this-procedure .
     1316           return .
     1317         end.
     1318       end.
     1319     end.
     1320     if p-change-value >= 0
     1321     then do:
     1322       assign
     1323         v-change-sign = 1
     1324       .
     1325     end.
     1326     else do:
     1327       assign
     1328         v-change-sign = -1
     1329       .
     1330     end.
     1331     assign
     1332       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1333     .
     1334     if p-change-value = 0
     1335     then do:
     1336       run diasize_position-resize-button in this-procedure .
     1337       return .
     1338     end.
     1339     move_block:
     1340     do
     1341     on error undo move_block, retry move_block
     1342     :
     1343       if retry
     1344       then do:
     1345         do
     1346         on error undo move_block, leave move_block
     1347         :
     1348           if p-change-value > 0
     1349           then do:
     1350             for each buf_temp-diasize-handle
     1351             on error undo, next
     1352             :
     1353               assign
     1354                 v-object-handle = buf_temp-diasize-handle.handle-value
     1355               .
     1356               if v-object-handle <> v-diasize-resize-button
     1357               then do:
     1358                 assign
     1359                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1360                 .
     1361               end.
     1362             end.
     1363             assign
     1364               v-diasize-browse-handle :height = v-browse-height
     1365             .
     1366             for each buf_temp-browse-handle
     1367               where buf_temp-browse-handle.browse-type = 'height':u
     1368             on error undo, next
     1369             :
     1370               assign
     1371                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1372               .
     1373             end.
     1374             assign
     1375               frame get-rep :height = v-frame-height
     1376             .
     1377             if frame get-rep :scrollable = true
     1378             then do:
     1379               assign
     1380                 frame get-rep :virtual-height = v-frame-virtual-height
     1381               .
     1382             end.
     1383             run diasize_position-resize-button in this-procedure .
     1384           end.
     1385           else do:
     1386             if frame get-rep :scrollable = true
     1387             then do:
     1388               assign
     1389                 frame get-rep :virtual-height = v-frame-virtual-height
     1390               .
     1391             end.
     1392             assign
     1393               frame get-rep :height = v-frame-height
     1394             .
     1395             assign
     1396               v-diasize-browse-handle :height = v-browse-height
     1397             .
     1398             for each buf_temp-browse-handle
     1399               where buf_temp-browse-handle.browse-type = 'height':u
     1400             on error undo, next
     1401             :
     1402               assign
     1403                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1404               .
     1405             end.
     1406             for each buf_temp-diasize-handle
     1407             on error undo, next
     1408             :
     1409               assign
     1410                 v-object-handle = buf_temp-diasize-handle.handle-value
     1411               .
     1412               if v-object-handle <> v-diasize-resize-button
     1413               then do:
     1414                 assign
     1415                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1416                 .
     1417               end.
     1418             end.
     1419             run diasize_position-resize-button in this-procedure .
     1420           end.
     1421           assign
     1422             v-diasize-change-size = false
     1423           .
     1424           leave move_block .
     1425         end.
     1426       end.
     1427       assign
     1428         v-diasize-need-full-display = true
     1429       .
     1430       if v-diasize-change-size = false
     1431       then do:
     1432         assign
     1433           v-diasize-change-size = true
     1434         .
     1435       end.
     1436       else do:
     1437         return .
     1438       end.
     1439       assign
     1440         v-frame-height = frame get-rep :height
     1441         v-frame-virtual-height = frame get-rep :virtual-height
     1442         v-browse-height = v-diasize-browse-handle :height
     1443       .
     1444       for each buf_temp-browse-handle
     1445         where buf_temp-browse-handle.browse-type = 'height':u
     1446       :
     1447         assign
     1448           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1449         .
     1450       end.
     1451       for each buf_temp-diasize-handle
     1452       :
     1453         delete buf_temp-diasize-handle .
     1454       end.
     1455       assign
     1456         v-field-group-handle = frame get-rep :first-child
     1457       .
     1458       do while valid-handle(v-field-group-handle)
     1459       :
     1460         assign
     1461           v-object-handle = v-field-group-handle :first-child
     1462         .
     1463         do while valid-handle(v-object-handle)
     1464         :
     1465           if  v-object-handle <> v-diasize-browse-handle :handle
     1466           and can-query(v-object-handle, "row")
     1467           and can-query(v-object-handle, "height")
     1468           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1469           then do:
     1470             find first buf_temp-browse-handle
     1471               where buf_temp-browse-handle.browse-type   = 'height':u
     1472                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1473               no-error .
     1474             if available buf_temp-browse-handle
     1475             then do:
     1476             end.
     1477             else do:
     1478               create buf_temp-diasize-handle .
     1479               assign
     1480                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1481                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1482               .
     1483             end.
     1484           end.
     1485           assign
     1486             v-object-handle = v-object-handle :next-sibling
     1487           .
     1488         end.
     1489         assign
     1490           v-field-group-handle = v-field-group-handle :next-sibling
     1491         .
     1492       end.
     1493       do with frame get-rep
     1494       :
     1495         hide v-diasize-resize-button .
     1496         assign
     1497           v-diasize-resize-button :row    = 1
     1498           v-diasize-resize-button :column = 1
     1499         .
     1500       end.
     1501       if p-change-value > 0
     1502       then do:
     1503         if frame get-rep :scrollable = true
     1504         then do:
     1505           assign
     1506             frame get-rep :virtual-height = frame get-rep :virtual-height + p-change-value
     1507             no-error .
     1508           if error-status :error
     1509           or error-status :get-message(1) <> ""
     1510           then do:
     1511             undo move_block, retry move_block .
     1512           end.
     1513         end.
     1514         assign
     1515           frame get-rep :height = frame get-rep :height + p-change-value
     1516           no-error .
     1517         if error-status :error
     1518         or error-status :get-message(1) <> ""
     1519         then do:
     1520           undo move_block, retry move_block .
     1521         end.
     1522         assign
     1523           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1524           no-error .
     1525         if error-status :error
     1526         or error-status :get-message(1) <> ""
     1527         then do:
     1528           undo move_block, retry move_block .
     1529         end.
     1530         for each buf_temp-browse-handle
     1531           where buf_temp-browse-handle.browse-type = 'height':u
     1532         on error undo move_block, retry move_block
     1533         :
     1534           assign
     1535             buf_temp-browse-handle.browse-handle :height
     1536               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1537             no-error .
     1538           if error-status :error
     1539           or error-status :get-message(1) <> ""
     1540           then do:
     1541             undo move_block, retry move_block .
     1542           end.
     1543         end.
     1544         for each buf_temp-diasize-handle
     1545         on error undo move_block, retry move_block
     1546         :
     1547           assign
     1548             v-object-handle = buf_temp-diasize-handle.handle-value
     1549           .
     1550           if v-object-handle <> v-diasize-resize-button
     1551           then do:
     1552             assign
     1553               v-object-handle :row = v-object-handle :row + p-change-value
     1554               no-error .
     1555             if error-status :error
     1556             or error-status :get-message(1) <> ""
     1557             then do:
     1558               undo move_block, retry move_block .
     1559             end.
     1560           end.
     1561         end.
     1562       end.
     1563       else do:
     1564         for each buf_temp-diasize-handle
     1565         on error undo move_block, retry move_block
     1566         :
     1567           assign
     1568             v-object-handle = buf_temp-diasize-handle.handle-value
     1569           .
     1570           if v-object-handle <> v-diasize-resize-button
     1571           then do:
     1572             assign
     1573               v-object-handle :row = v-object-handle :row + p-change-value
     1574               no-error .
     1575             if error-status :error
     1576             or error-status :get-message(1) <> ""
     1577             then do:
     1578               undo move_block, retry move_block .
     1579             end.
     1580           end.
     1581         end.
     1582         assign
     1583           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1584           no-error .
     1585         if error-status :error
     1586         or error-status :get-message(1) <> ""
     1587         then do:
     1588           undo move_block, retry move_block .
     1589         end.
     1590         for each buf_temp-browse-handle
     1591           where buf_temp-browse-handle.browse-type = 'height':u
     1592         on error undo move_block, retry move_block
     1593         :
     1594           assign
     1595             buf_temp-browse-handle.browse-handle :height
     1596               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1597             no-error .
     1598           if error-status :error
     1599           or error-status :get-message(1) <> ""
     1600           then do:
     1601             undo move_block, retry move_block .
     1602           end.
     1603         end.
     1604         assign
     1605           frame get-rep :height = frame get-rep :height + p-change-value
     1606           no-error .
     1607         if error-status :error
     1608         or error-status :get-message(1) <> ""
     1609         then do:
     1610           undo move_block, retry move_block .
     1611         end.
     1612         if frame get-rep :scrollable = true
     1613         then do:
     1614           assign
     1615             frame get-rep :virtual-height = frame get-rep :virtual-height + p-change-value
     1616             no-error .
     1617           if error-status :error
     1618           or error-status :get-message(1) <> ""
     1619           then do:
     1620             undo move_block, retry move_block .
     1621           end.
     1622         end.
     1623       end.
     1624       if p-move-resize = true
     1625       then do:
     1626         run diasize_position-resize-button in this-procedure .
     1627       end.
     1628       if v-diasize-wndstore = true
     1629       then do:
     1630         if connected("ub") = true
     1631         then do:
     1632           define variable v-cntxt-db-num        as integer   no-undo .
     1633           define variable v-cntxt-userid        as character no-undo .
     1634           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1635                                             , OUTPUT v-cntxt-userid
     1636                                             ) .
     1637           run gbl/wndsizew.p
     1638             (input  v-cntxt-db-num
     1639             ,input  v-cntxt-userid
     1640             ,input  v-diasize-proc-name
     1641             ,input  'height':u
     1642             ,input  string(frame get-rep :height - v-diasize-orig-frame-height)
     1643             ) .
     1644         end.
     1645       end.
     1646     end.
     1647     assign
     1648       v-diasize-change-size = false
     1649     .
     1650   end procedure.
     1651   procedure diasize_set-height :
     1652     define input  parameter p-new-height  as decimal   no-undo .
     1653     define input  parameter p-move-resize as logical   no-undo .
     1654     do
     1655     on error undo, return error return-value
     1656     :
     1657       run diasize_change-height in this-procedure
     1658         (input  (p-new-height - frame get-rep :height)
     1659         ,input  p-move-resize
     1660         ) .
     1661     end.
     1662   end procedure.
     1663   procedure diasize_change-width :
     1664     define input  parameter p-change-value as decimal   no-undo .
     1665     define input  parameter p-move-resize  as logical   no-undo .
     1666     define variable v-field-group-handle   as handle    no-undo .
     1667     define variable v-object-handle        as handle    no-undo .
     1668     define variable v-frame-width          as decimal   no-undo .
     1669     define variable v-frame-virtual-width  as decimal   no-undo .
     1670     define variable v-browse-width         as decimal   no-undo .
     1671     define variable v-window-width         as decimal   no-undo .
     1672     define variable v-window-virtual-width as decimal   no-undo .
     1673     define variable v-change-sign          as integer   no-undo .
     1674     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1675     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1676     if p-change-value > 0
     1677     then do:
     1678       if frame get-rep :width + p-change-value >
     1679           session :width-chars
     1680       then do:
     1681         assign
     1682           p-change-value = session :width-chars - frame get-rep :width
     1683         .
     1684         if p-change-value <= 0
     1685         then do:
     1686           run diasize_position-resize-button in this-procedure .
     1687           return .
     1688         end.
     1689       end.
     1690     end.
     1691     if p-change-value < 0
     1692     then do:
     1693       if frame get-rep :width + p-change-value < v-diasize-orig-frame-width
     1694       then do:
     1695         assign
     1696           p-change-value = v-diasize-orig-frame-width
     1697                          - frame get-rep :width
     1698         .
     1699         if p-change-value >= 0
     1700         then do:
     1701           run diasize_position-resize-button in this-procedure .
     1702           return .
     1703         end.
     1704       end.
     1705     end.
     1706     if p-change-value >= 0
     1707     then do:
     1708       assign
     1709         v-change-sign = 1
     1710       .
     1711     end.
     1712     else do:
     1713       assign
     1714         v-change-sign = -1
     1715       .
     1716     end.
     1717     assign
     1718       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1719     .
     1720     if p-change-value = 0
     1721     then do:
     1722       run diasize_position-resize-button in this-procedure .
     1723       return .
     1724     end.
     1725     move_block:
     1726     do
     1727     on error undo move_block, leave move_block
     1728     :
     1729       if retry
     1730       then do:
     1731         do
     1732         on error undo move_block, leave move_block
     1733         :
     1734           if p-change-value > 0
     1735           then do:
     1736             for each buf_temp-diasize-handle
     1737             on error undo, next
     1738             :
     1739               assign
     1740                 v-object-handle = buf_temp-diasize-handle.handle-value
     1741               .
     1742               if v-object-handle <> v-diasize-resize-button
     1743               then do:
     1744                 assign
     1745                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1746                 .
     1747               end.
     1748             end.
     1749             assign
     1750               v-diasize-browse-handle :width = v-browse-width
     1751             .
     1752             for each buf_temp-browse-handle
     1753               where buf_temp-browse-handle.browse-type = 'width':u
     1754             on error undo, next
     1755             :
     1756               assign
     1757                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1758               .
     1759             end.
     1760             assign
     1761               frame get-rep :width = v-frame-width
     1762             .
     1763             if frame get-rep :scrollable = true
     1764             then do:
     1765               assign
     1766                 frame get-rep :virtual-width = v-frame-virtual-width
     1767               .
     1768             end.
     1769             run diasize_position-resize-button in this-procedure .
     1770           end.
     1771           else do:
     1772             if frame get-rep :scrollable = true
     1773             then do:
     1774               assign
     1775                 frame get-rep :virtual-width = v-frame-virtual-width
     1776               .
     1777             end.
     1778             assign
     1779               frame get-rep :width = v-frame-width
     1780             .
     1781             for each buf_temp-browse-handle
     1782               where buf_temp-browse-handle.browse-type = 'width':u
     1783             on error undo, next
     1784             :
     1785               assign
     1786                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1787               .
     1788             end.
     1789             assign
     1790               v-diasize-browse-handle :width = v-browse-width
     1791             .
     1792             for each buf_temp-diasize-handle
     1793             on error undo, next
     1794             :
     1795               assign
     1796                 v-object-handle = buf_temp-diasize-handle.handle-value
     1797               .
     1798               if v-object-handle <> v-diasize-resize-button
     1799               then do:
     1800                 assign
     1801                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1802                 .
     1803               end.
     1804             end.
     1805             run diasize_position-resize-button in this-procedure .
     1806           end.
     1807           assign
     1808             v-diasize-change-size = false
     1809           .
     1810           leave move_block .
     1811         end.
     1812       end.
     1813       assign
     1814         v-diasize-need-full-display = true
     1815       .
     1816       if v-diasize-change-size = false
     1817       then do:
     1818         assign
     1819           v-diasize-change-size = true
     1820         .
     1821       end.
     1822       else do:
     1823         return .
     1824       end.
     1825       assign
     1826         v-frame-width = frame get-rep :width
     1827         v-frame-virtual-width = frame get-rep :virtual-width
     1828         v-browse-width = v-diasize-browse-handle :width
     1829       .
     1830       for each buf_temp-browse-handle
     1831         where buf_temp-browse-handle.browse-type = 'width':u
     1832       :
     1833         assign
     1834           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1835         .
     1836       end.
     1837       for each buf_temp-diasize-handle
     1838       :
     1839         delete buf_temp-diasize-handle .
     1840       end.
     1841       assign
     1842         v-field-group-handle = frame get-rep :first-child
     1843       .
     1844       do while valid-handle(v-field-group-handle)
     1845       :
     1846         assign
     1847           v-object-handle = v-field-group-handle :first-child
     1848         .
     1849         do while valid-handle(v-object-handle)
     1850         :
     1851           if  v-object-handle <> v-diasize-browse-handle :handle
     1852           and v-object-handle <> v-diasize-resize-button
     1853           and can-query(v-object-handle, "row")
     1854           and can-query(v-object-handle, "height")
     1855           and ( v-object-handle :col + v-object-handle :width
     1856                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1857               )
     1858           then do:
     1859             find first buf_temp-browse-handle
     1860               where buf_temp-browse-handle.browse-type   = 'width':u
     1861                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1862               no-error .
     1863             if available buf_temp-browse-handle
     1864             then do:
     1865             end.
     1866             else do:
     1867               create buf_temp-diasize-handle .
     1868               assign
     1869                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1870                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1871               .
     1872             end.
     1873           end.
     1874           assign
     1875             v-object-handle = v-object-handle :next-sibling
     1876           .
     1877         end.
     1878         assign
     1879           v-field-group-handle = v-field-group-handle :next-sibling
     1880         .
     1881       end.
     1882       do with frame get-rep
     1883       :
     1884         hide v-diasize-resize-button .
     1885         v-diasize-resize-button :row = 1.
     1886         v-diasize-resize-button :column = 1.
     1887       end.
     1888       if p-change-value > 0
     1889       then do:
     1890         if frame get-rep :scrollable = true
     1891         then do:
     1892           assign
     1893             frame get-rep :virtual-width = frame get-rep :virtual-width + p-change-value
     1894             no-error .
     1895           if error-status :error
     1896           or error-status :get-message(1) <> ""
     1897           then do:
     1898             undo move_block, retry move_block.
     1899           end.
     1900         end.
     1901         assign
     1902           frame get-rep :width = v-frame-width + p-change-value
     1903           no-error .
     1904         if error-status :error
     1905         or error-status :get-message(1) <> ""
     1906         then do:
     1907           undo move_block, retry move_block.
     1908         end.
     1909         assign
     1910           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1911         no-error .
     1912         if error-status :error
     1913         or error-status :get-message(1) <> ""
     1914         then do:
     1915           undo move_block, retry move_block.
     1916         end.
     1917         for each buf_temp-browse-handle
     1918           where buf_temp-browse-handle.browse-type = 'width':u
     1919         on error undo move_block, retry move_block
     1920         :
     1921           assign
     1922             buf_temp-browse-handle.browse-handle :width
     1923               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1924             no-error .
     1925           if error-status :error
     1926           or error-status :get-message(1) <> ""
     1927           then do:
     1928             undo move_block, retry move_block .
     1929           end.
     1930         end.
     1931         for each buf_temp-diasize-handle
     1932         on error undo move_block, retry move_block
     1933         :
     1934           assign
     1935             v-object-handle = buf_temp-diasize-handle.handle-value
     1936           .
     1937           if v-object-handle <> v-diasize-resize-button
     1938           then do:
     1939             assign
     1940               v-object-handle :col = v-object-handle :col + p-change-value
     1941               no-error .
     1942             if error-status :error
     1943             or error-status :get-message(1) <> ""
     1944             then do:
     1945               undo move_block, retry move_block .
     1946             end.
     1947           end.
     1948         end.
     1949       end.
     1950       else do:
     1951         for each buf_temp-diasize-handle
     1952         on error undo move_block, retry move_block
     1953         :
     1954           assign
     1955             v-object-handle = buf_temp-diasize-handle.handle-value
     1956           .
     1957           if v-object-handle <> v-diasize-resize-button
     1958           then do:
     1959             assign
     1960               v-object-handle :col = v-object-handle :col + p-change-value
     1961               no-error .
     1962             if error-status :error
     1963             or error-status :get-message(1) <> ""
     1964             then do:
     1965               undo move_block, retry move_block .
     1966             end.
     1967           end.
     1968         end.
     1969         for each buf_temp-browse-handle
     1970           where buf_temp-browse-handle.browse-type = 'width':u
     1971         on error undo move_block, retry move_block
     1972         :
     1973           assign
     1974             buf_temp-browse-handle.browse-handle :width
     1975               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1976             no-error .
     1977           if error-status :error
     1978           or error-status :get-message(1) <> ""
     1979           then do:
     1980             undo move_block, retry move_block .
     1981           end.
     1982         end.
     1983         assign
     1984           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1985           no-error .
     1986         if error-status :error
     1987         or error-status :get-message(1) <> ""
     1988         then do:
     1989           undo move_block, retry move_block.
     1990         end.
     1991         assign
     1992           frame get-rep :width = frame get-rep :width + p-change-value
     1993         no-error .
     1994         if error-status :error
     1995         or error-status :get-message(1) <> ""
     1996         then do:
     1997           undo move_block, retry move_block.
     1998         end.
     1999         if frame get-rep :scrollable = true
     2000         then do:
     2001           assign
     2002             frame get-rep :virtual-width = frame get-rep :virtual-width + p-change-value
     2003           no-error .
     2004           if error-status :error
     2005           or error-status :get-message(1) <> ""
     2006           then do:
     2007             undo move_block, retry move_block.
     2008           end.
     2009         end.
     2010       end.
     2011       if p-move-resize
     2012       then do:
     2013         run diasize_position-resize-button in this-procedure .
     2014       end.
     2015       if v-diasize-wndstore = true
     2016       then do:
     2017         if connected("ub") = true
     2018         then do:
     2019           define variable v-cntxt-db-num        as integer   no-undo .
     2020           define variable v-cntxt-userid        as character no-undo .
     2021           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2022                                             , OUTPUT v-cntxt-userid
     2023                                             ) .
     2024           run gbl/wndsizew.p
     2025             (input  v-cntxt-db-num
     2026             ,input  v-cntxt-userid
     2027             ,input  v-diasize-proc-name
     2028             ,input  'width':u
     2029             ,input  string(frame get-rep :width - v-diasize-orig-frame-width)
     2030             ) .
     2031         end.
     2032       end.
     2033     end.
     2034     assign
     2035       v-diasize-change-size = false
     2036     .
     2037   end procedure.
     2038   procedure diasize_set-width :
     2039     define input  parameter p-new-width  as decimal   no-undo .
     2040     define input  parameter p-move-resize as logical   no-undo .
     2041     do
     2042     on error undo, return error return-value
     2043     :
     2044       run diasize_change-width in this-procedure
     2045         (input  (p-new-width - frame get-rep :width)
     2046         ,input  p-move-resize
     2047         ) .
     2048     end.
     2049   end procedure.
     2050   procedure diasize_position-resize-button :
     2051     do with frame get-rep
     2052     :
     2053       hide v-diasize-resize-button .
     2054       assign
     2055         v-diasize-resize-button :row = frame get-rep :height - v-diasize-resize-button :height
     2056                     - 1
     2057                     - (frame get-rep :border-bottom-pixels / session :pixels-per-row)
     2058         v-diasize-resize-button :col = frame get-rep :width - v-diasize-resize-button :width
     2059                     - 1
     2060                     - (frame get-rep :border-right-pixels / session :pixels-per-column)
     2061       .
     2062       view v-diasize-resize-button .
     2063     end.
     2064   end procedure.
     2065   on alt-right anywhere
     2066   do:
     2067     run diasize_change-width in this-procedure
     2068       (input 1
     2069       ,input true
     2070       ) .
     2071     return no-apply .
     2072   end.
     2073   on alt-left anywhere
     2074   do:
     2075     run diasize_change-width in this-procedure
     2076       (input -1
     2077       ,input true
     2078       ) .
     2079     return no-apply .
     2080   end.
     2081   on alt-down anywhere
     2082   do:
     2083     run diasize_change-height in this-procedure
     2084       (input 1
     2085       ,input true
     2086       ) .
     2087     return no-apply .
     2088   end.
     2089   on alt-up anywhere
     2090   do:
     2091     run diasize_change-height in this-procedure
     2092       (input -1
     2093       ,input true
     2094       ) .
     2095     return no-apply .
     2096   end.
     2097   on alt-enter of frame get-rep
     2098   do:
     2099     run diasize_maximize in this-procedure
     2100       (input  ?
     2101       ).
     2102     return no-apply .
     2103   end.
     2104   procedure diasize_end-move :
     2105     do
     2106     on error undo, return error return-value
     2107     :
     2108       define variable v-row-delta as decimal   no-undo .
     2109       define variable v-col-delta as decimal   no-undo .
     2110       define variable v-new-row as decimal   no-undo .
     2111       define variable v-new-col as decimal   no-undo .
     2112       assign
     2113         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2114         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2115       .
     2116       assign
     2117         v-row-delta = v-new-row - frame get-rep :height
     2118         v-col-delta = v-new-col - frame get-rep :width
     2119       .
     2120       run diasize_change-height in this-procedure
     2121         (input v-row-delta
     2122         ,input true
     2123         ) .
     2124       run diasize_change-width in this-procedure
     2125         (input v-col-delta
     2126         ,input true
     2127         ) .
     2128     end.
     2129   end procedure.
     2130   procedure diasize_maximize :
     2131     define input  parameter p-action as logical   no-undo .
     2132     do
     2133     on error undo, return error return-value
     2134     :
     2135       if p-action = ?
     2136       then do:
     2137         if v-diasize-need-maximize = true
     2138         then do:
     2139           assign
     2140             p-action = true
     2141           .
     2142         end.
     2143         else do:
     2144           assign
     2145             p-action = false
     2146           .
     2147         end.
     2148       end.
     2149       if p-action = true
     2150       then do:
     2151         run diasize_change-height in this-procedure
     2152           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2153               - frame get-rep :height-chars
     2154           ,input true
     2155           ) .
     2156         run diasize_change-width in this-procedure
     2157           (input session :width-chars
     2158               - frame get-rep :width-chars
     2159           ,input true
     2160           ) .
     2161         assign
     2162           v-diasize-need-maximize = false
     2163         .
     2164       end.
     2165       else do:
     2166         run diasize_change-width in this-procedure
     2167           (input v-diasize-orig-frame-width
     2168               - frame get-rep :width-chars
     2169           ,input true
     2170           ) .
     2171         run diasize_change-height in this-procedure
     2172           (input v-diasize-orig-frame-height
     2173               - frame get-rep :height-chars
     2174           ,input true
     2175           ) .
     2176         assign
     2177           v-diasize-need-maximize = true
     2178         .
     2179       end.
     2180     end.
     2181   end procedure.
     2182   procedure diasize_restore-orig-size :
     2183     do
     2184     on error undo, return error return-value
     2185     :
     2186       assign
     2187         v-diasize-current-frame-width  = frame get-rep :width
     2188         v-diasize-current-frame-height = frame get-rep :height
     2189       .
     2190       run diasize_set-height in this-procedure
     2191         (input  v-diasize-orig-frame-height
     2192         ,input  true
     2193         ) .
     2194       run diasize_set-width in this-procedure
     2195         (input  v-diasize-orig-frame-width
     2196         ,input  true
     2197         ) .
     2198     end.
     2199   end procedure.
     2200   procedure diasize_restore-current-size :
     2201     do
     2202     on error undo, return error return-value
     2203     :
     2204       run diasize_set-height in this-procedure
     2205         (input  v-diasize-current-frame-height
     2206         ,input  true
     2207         ) .
     2208       run diasize_set-width in this-procedure
     2209         (input  v-diasize-current-frame-width
     2210         ,input  true
     2211         ) .
     2212     end.
     2213   end procedure.
     2214   procedure diasize_set-browse-handle :
     2215     define input  parameter p-browse-handle as handle   no-undo .
     2216     define buffer buf_temp-browse-handle for temp-browse-handle .
     2217     do
     2218     on error undo, return error return-value
     2219     :
     2220       assign
     2221         v-diasize-browse-handle = p-browse-handle
     2222       .
     2223       for each buf_temp-browse-handle
     2224       on error undo, return error return-value
     2225       :
     2226         delete buf_temp-browse-handle .
     2227       end.
     2228     end.
     2229   end procedure.
     2230   procedure diasize_add_browse :
     2231     define input  parameter p-browse-type   as character no-undo .
     2232     define input  parameter p-browse-handle as handle    no-undo .
     2233     define buffer buf_temp-browse-handle for temp-browse-handle .
     2234     do
     2235     on error undo, return error return-value
     2236     :
     2237       assign
     2238         v-diasize-browse-number = v-diasize-browse-number + 1
     2239       .
     2240       create buf_temp-browse-handle .
     2241       assign
     2242         buf_temp-browse-handle.browse-type   = p-browse-type
     2243         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2244         buf_temp-browse-handle.browse-handle = p-browse-handle
     2245       .
     2246     end.
     2247   end procedure.
     2248   procedure diasize_init :
     2249     define variable v-default-value    as logical   no-undo .
     2250     define variable v-restore-saved    as logical   no-undo .
     2251     define variable v-resize-value-str as character no-undo .
     2252     do
     2253     on error undo, return error return-value
     2254     :
     2255       do with frame get-rep
     2256       :
     2257         assign
     2258           v-diasize-orig-frame-height = frame get-rep :height
     2259           v-diasize-orig-frame-width  = frame get-rep :width
     2260           v-diasize-browse-handle     = browse BROWSE-date :handle
     2261         .
     2262         create button v-diasize-resize-button
     2263         assign
     2264           parent        = frame get-rep :first-child
     2265           label         = "s"
     2266           height-pixels = 16
     2267           width-pixels  = 16
     2268           visible       = true
     2269           sensitive     = true
     2270           movable       = true
     2271           triggers:
     2272             on end-move persistent run diasize_end-move in this-procedure .
     2273           end triggers.
     2274         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2275         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2276         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2277         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2278         assign
     2279           v-diasize-wndmax = false
     2280         .
     2281         if connected("ub") = true
     2282         then do:
     2283           define variable v-cntxt-db-num        as integer   no-undo .
     2284           define variable v-cntxt-userid        as character no-undo .
     2285           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2286                                             , OUTPUT v-cntxt-userid
     2287                                             ) .
     2288           run gbl/wndpar_r.p
     2289             (input  v-cntxt-db-num
     2290             ,input  v-cntxt-userid
     2291             ,input  'wndmax':U
     2292             ,output v-diasize-wndmax
     2293             ,output v-default-value
     2294             ) .
     2295         end.
     2296         assign
     2297           v-diasize-wndstore = false
     2298         .
     2299         if connected("ub") = true
     2300         then do:
     2301           run gbl/wndpar_r.p
     2302             (input  v-cntxt-db-num
     2303             ,input  v-cntxt-userid
     2304             ,input  'wndstore':U
     2305             ,output v-diasize-wndstore
     2306             ,output v-default-value
     2307             ) .
     2308         end.
     2309         assign
     2310           v-diasize-proc-name = entry(1, program-name(2), '.')
     2311         .
     2312         if v-diasize-wndstore = true
     2313         then do:
     2314           assign
     2315             v-restore-saved = false
     2316           .
     2317           if connected("ub") = true
     2318           then do:
     2319             run gbl/wndsizer.p
     2320               (input  v-cntxt-db-num
     2321               ,input  v-cntxt-userid
     2322               ,input  v-diasize-proc-name
     2323               ,input  'height':u
     2324               ,output v-resize-value-str
     2325               ) .
     2326             if v-resize-value-str <> '':U
     2327             then do:
     2328               run diasize_change-height in this-procedure
     2329                 (input  integer(v-resize-value-str)
     2330                 ,input  true
     2331                 ) .
     2332               assign
     2333                 v-restore-saved = true
     2334               .
     2335             end.
     2336           end.
     2337           if connected("ub") = true
     2338           then do:
     2339             run gbl/wndsizer.p
     2340               (input  v-cntxt-db-num
     2341               ,input  v-cntxt-userid
     2342               ,input  v-diasize-proc-name
     2343               ,input  'width':u
     2344               ,output v-resize-value-str
     2345               ) .
     2346             if v-resize-value-str <> '':U
     2347             then do:
     2348               run diasize_change-width in this-procedure
     2349                 (input  integer(v-resize-value-str)
     2350                 ,input  true
     2351                 ) .
     2352               assign
     2353                 v-restore-saved = true
     2354               .
     2355             end.
     2356           end.
     2357           if v-restore-saved <> true
     2358           then do:
     2359             if v-diasize-wndmax = true
     2360             then do:
     2361               run diasize_maximize in this-procedure
     2362                 (input  true
     2363                 ) .
     2364             end.
     2365           end.
     2366         end.
     2367         else do:
     2368           if v-diasize-wndmax = true
     2369           then do:
     2370             run diasize_maximize in this-procedure
     2371               (input  true
     2372               ) .
     2373           end.
     2374         end.
     2375       end.
     2376     end.
     2377   end procedure.
     2378   procedure diasize_need-full-display :
     2379     define output parameter p-need-full-display as logical   no-undo .
     2380     do
     2381     on error undo, return error return-value
     2382     :
     2383       assign
     2384         p-need-full-display = v-diasize-need-full-display
     2385       .
     2386       assign
     2387         v-diasize-need-full-display = false
     2388       .
     2389     end.
     2390   end procedure.
     2391   procedure get-context :
     2392      define output parameter p-db-num as integer          no-undo.
     2393      define output parameter p-user-id as character        no-undo.
     2394      define variable v-login               as character    no-undo.
     2395      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2396      define buffer buf_user-login  for ub.user-login .
     2397      do
     2398      on error undo, return error
     2399      :
     2400            FIND FIRST buf_sys-ctrl no-lock.
     2401            ASSIGN
     2402               v-login = USERID("ub")
     2403               p-db-num = buf_sys-ctrl.db-num
     2404            .
     2405            FIND FIRST buf_user-login
     2406                 WHERE buf_user-login.db-num = p-db-num
     2407                   AND buf_user-login.user-login = v-login
     2408                 no-lock
     2409                 no-error
     2410                 .
     2411            IF AVAILABLE buf_user-login
     2412            THEN DO:
     2413               assign
     2414                  p-user-id = buf_user-login.user-id
     2415               .
     2416            END.
     2417      end.
     2418   end procedure.
     2419       run diasize_init in this-procedure .
     2420   MAIN-BLOCK:
     2421   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2422      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2423      define variable v-time  as integer   no-undo.
     2424     if p-from-date = ? OR p-to-date = ?
     2425     then do:
     2426         run cur-time in this-procedure ( output p-to-date
     2427                                        , output v-time
     2428                                        ).
     2429         assign
     2430             p-from-date = date( month( p-to-date ), 01, year( p-to-date ))
     2431         .
     2432     end.
     2433     assign
     2434         date-b = p-from-date
     2435         date-e = p-to-date
     2436         RADIO-TYPE = 0
     2437         .
     2438     APPLY "VALUE-CHANGED" TO RADIO-TYPE IN FRAME get-rep .
     2439     run enable_ui.
     2440     apply "entry" to date-b in frame get-rep.
     2441     wait-for go of frame get-rep.
     2442   end.
     2443   run disable_ui.
     2444   PROCEDURE disable_UI :
     2445     HIDE FRAME get-rep.
     2446   END PROCEDURE.
     2447   PROCEDURE enable_UI :
     2448     DISPLAY date-b date-e RADIO-TYPE
     2449         WITH FRAME get-rep.
     2450     ENABLE b-ok b-quit b-help BROWSE-date date-b date-e RADIO-TYPE B-more b-del
     2451         WITH FRAME get-rep.
     2452     OPEN QUERY BROWSE-date FOR EACH temp-date.
     2453   END PROCEDURE.
