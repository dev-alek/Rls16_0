     2303   procedure get-context :
     2304      define output parameter p-db-num as integer          no-undo.
     2305      define output parameter p-user-id as character        no-undo.
     2306      define variable v-login               as character    no-undo.
     2307      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2308      define buffer buf_user-login  for ub.user-login .
     2309      do
     2310      on error undo, return error
     2311      :
     2312            FIND FIRST buf_sys-ctrl no-lock.
     2313            ASSIGN
     2314               v-login = USERID("ub")
     2315               p-db-num = buf_sys-ctrl.db-num
     2316            .
     2317            FIND FIRST buf_user-login
     2318                 WHERE buf_user-login.db-num = p-db-num
     2319                   AND buf_user-login.user-login = v-login
     2320                 no-lock
     2321                 no-error
     2322                 .
     2323            IF AVAILABLE buf_user-login
     2324            THEN DO:
     2325               assign
     2326                  p-user-id = buf_user-login.user-id
     2327               .
     2328            END.
     2329      end.
     2330   end procedure.
