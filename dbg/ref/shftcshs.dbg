      360     run proc-alt-shift-f4 in this-procedure.
      361   end.
      362   on alt-f1 anywhere do:
      363     run proc-alt-f1 in this-procedure .
      364   end.
      365   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      366   define variable c-point  as character no-undo .
      367   define variable tbl      as character no-undo .
      368   define variable join-tbl as character no-undo .
      369   define variable fld      as character no-undo .
      370   define variable lab      as character no-undo .
      371   define variable spr      as character no-undo .
      372   define variable dim      as character no-undo .
      373   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      374   procedure fltfield-clear :
      375     define output parameter loc-fld as character no-undo.
      376     define output parameter loc-lab as character no-undo .
      377     define output parameter loc-spr as character no-undo .
      378     define output parameter loc-dim as character no-undo .
      379     assign
      380       loc-fld = ""
      381       loc-lab = ""
      382       loc-spr = ""
      383       loc-dim = "0"
      384     .
      385   end procedure .
      386   procedure fltfield-add :
      387     define input        parameter par-fld as character no-undo.
      388     define input        parameter par-lab as character no-undo .
      389     define input        parameter par-spr as character no-undo .
      390     define input-output parameter loc-fld as character no-undo.
      391     define input-output parameter loc-lab as character no-undo .
      392     define input-output parameter loc-spr as character no-undo .
      393     define input-output parameter loc-dim as character no-undo .
      394     do
      395     on error undo, return error
      396     :
      397       assign
      398       loc-fld = if loc-dim = '0'
      399                 then par-fld
      400                 else (loc-fld + chr(44) + par-fld)
      401       loc-lab = if loc-dim = '0'
      402                 then par-lab
      403                 else (loc-lab + chr(44) + par-lab)
      404       loc-spr = if loc-dim = '0'
      405                 then par-spr
      406                 else (loc-spr + chr(44) + par-spr)
      407       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      408                 string(integer(if num-entries(loc-dim) > 1
      409                               then entry(2, loc-dim)
      410                               else entry(1, loc-dim)
      411                               ) + 1)
      412       no-error
      413       .
      414     end.
      415   end procedure.
      416   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      417   define variable v-waitfram-action01         as character   no-undo .
      418   define variable v-waitfram-action02         as character   no-undo .
      419   define variable v-waitfram-action03         as character   no-undo .
      420   define variable mWaitFramTextBeg            as character   no-undo.
      421   define variable mWaitFramTextEnd            as character   no-undo.
      422   define variable mWaitFramView               as logical     no-undo.
      423   define variable mWaitProcEvent              as logical     no-undo init yes.
      424   define variable mWaitFramInterval           as integer     no-undo init 1 .
      425   define variable mWaitFramStop               as logical     no-undo.
      426   define variable mWaitFramStopUser           as logical     no-undo.
      427   define variable mWaitFramStopTimeOut        as logical     no-undo.
      428   define variable mWaitFramStartProc          as datetime-tz no-undo.
      429   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      430   define button B-WaitFramStop auto-end-key
      431        label "Стоп"
      432        size 10 by 1 tooltip "Остоновить процесс".
      433   define button B-viewProcInfo
      434        label "Информация"
      435        size 15 by 1 tooltip "Информация о процесс".
      436   define frame waitfram
      437     v-waitfram-action01 format "x(72)" no-label skip
      438     v-waitfram-action02 format "x(72)" no-label skip
      439     v-waitfram-action03 format "x(72)" no-label skip
      440     B-viewProcInfo
      441     B-WaitFramStop at row 4 col 30
      442     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      443     .
      444   define new global shared variable mBatchMode as logical no-undo init ?.
      445   define variable mFramBachModHandle as handle no-undo.
      446   mFramBachModHandle = frame waitfram:handle.
      447   define variable mFameOldVis as logical no-undo.
      448   define variable mVisCUrentVin as logical no-undo.
      449   if session:batch-mode
      450   then
      451      mBatchMode = yes.
      452   if mBatchMode = ? then do:
      453     mVisCUrentVin = current-window:visible.
      454     mFameOldVis = mFramBachModHandle:visible.
      455     mFramBachModHandle:visible  = yes.
      456     mBatchMode = mFramBachModHandle:visible ne yes.
      457     mFramBachModHandle:visible = mFameOldVis.
      458     current-window:visible = mVisCUrentVin.
      459   end.
      460    if  log-manager:logfile-name ne ?
      461     then DO:
      462         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      463         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      464         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      465     end.
      466   on choose of B-WaitFramStop in frame waitfram
      467   do:
      468     mWaitFramStop = yes.
      469     mWaitFramStopUser = yes.
      470   end.
      471   function waitfram-check-timeout returns logical():
      472      define variable vtime as int64 no-undo.
      473      if mWaitFramStopTimeOut
      474      then
      475         return yes.
      476      vtime = ( now - mWaitFramStartProc ) / 1000 .
      477      if     mWaitFramTimeOut ne ?
      478         and mWaitFramTimeOut ne 0
      479         and mWaitFramTimeOut lt vtime
      480      then do:
      481         mWaitFramStopTimeOut = yes.
      482      end.
      483      return mWaitFramStopTimeOut.
      484   end.
      485   procedure waitfram-hide :
      486     if not session:batch-mode
      487     then do
      488     on error undo, return error return-value
      489     :
      490       pause 0 before-hide .
      491       if not mBatchMode then
      492         hide frame waitfram .
      493     if     not mWaitFramView
      494        and mWaitProcEvent
      495     then
      496       process events .
      497     end.
      498   end procedure.
      499   procedure waitfram-show :
      500     define input  parameter p-message as character no-undo .
      501     define variable v-left-margin as integer   no-undo .
      502     if not session:batch-mode
      503     then do
      504     on error undo, return error return-value
      505     :
      506       if length(p-message) <= 70 then do:
      507         assign
      508           v-left-margin = integer((70 - length(p-message)) / 2)
      509         .
      510         assign
      511           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      512         .
      513         assign
      514           v-waitfram-action01 = " "
      515           v-waitfram-action02 = " "
      516                                    + fill(" ", v-left-margin)
      517                                    + p-message
      518           v-waitfram-action03 = " "
      519         .
      520       end.
      521       else do:
      522         define variable vRindex1 as integer no-undo.
      523         define variable vRindex2 as integer no-undo.
      524         vRindex1 = r-index(p-message," ",70).
      525         if vRindex1 = 0
      526         then
      527            vRindex1 = 70.
      528         if length(p-message)  <= vRindex1 + 70 then do:
      529           assign
      530             v-waitfram-action01 = " "
      531             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      532             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      533           .
      534         end.
      535         else do:
      536           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      537           if vRindex2 <= vRindex1
      538           then
      539              vRindex2 = vRindex1 + 70.
      540           assign
      541             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      542             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      543             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      544           .
      545         end.
      546       end.
      547       B-viewProcInfo:visible   in frame waitfram = no.
      548       B-viewProcInfo:sensitive in frame waitfram = no.
      549       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      550       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      551       if  (   mWaitFramView
      552          or  mWaitProcEvent)
      553          and not mBatchMode
      554       then
      555          display
      556             v-waitfram-action01 skip
      557             v-waitfram-action02 skip
      558             v-waitfram-action03 skip
      559          with frame waitfram .
      560       if     mWaitFramView
      561          then do:
      562             if     mWaitFramInterval ne ?
      563                and not mBatchMode
      564             then
      565                wait-for go of frame waitfram pause mWaitFramInterval.
      566          end.
      567          else
      568             if     mWaitProcEvent
      569                and not mBatchMode
      570             then
      571                process events .
      572     end.
      573   end procedure.
      574      procedure waitfram-show-this:
      575         define input  parameter iInterval as int64 no-undo.
      576         define variable vtime as int64 no-undo.
      577         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      578         mWaitFramInterval = iInterval.
      579         run waitfram-show (substitute("&1&2 &3&4" ,
      580                                       mWaitFramTextBeg ,
      581                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      582                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      583                                       mWaitFramTextEnd
      584                                      )
      585                           ).
      586      end.
      587      procedure WaitFramRunPause:
      588         define input  parameter iInterval as dec no-undo.
      589         define variable vStart  as datetime-tz no-undo.
      590         define variable vend    as datetime-tz no-undo.
      591         define variable vint as int64 no-undo.
      592         define variable vOk as logical no-undo.
      593         vStart = now.
      594         vend   = vStart.
      595         publish "WaitFramPause" (iInterval,output vOk).
      596         vend   =  now.
      597         vint = vend - vStart.
      598         vint = iInterval - vint / 1000.
      599         if     not mWaitFramStop
      600            and (   vint > 0
      601                 or (    not vOk
      602                     and iInterval eq ?
      603                     )
      604                 )
      605         then
      606            run waitfram-show-this (iInterval).
      607         vend   =  now.
      608         vint = vend - vStart.
      609         vint = iInterval - vint / 1000.
      610         if     not mWaitFramStop
      611            and vint > 0
      612         then do:
      613            run gbl/pause.p (vint * 1000).
      614         end.
      615         if iInterval ne ?
      616         then
      617            publish "WaitFramStop".
      618         waitfram-check-timeout().
      619      end.
      620      procedure WaitFramWaitFor:
      621         define input  parameter iInterval as dec no-undo.
      622         assign
      623            mWaitFramStartProc   = now
      624            mWaitFramStopUser    = no
      625            mWaitFramStopTimeOut = no
      626         .
      627         block-wait:
      628         do while not mWaitFramStop:
      629            run WaitFramRunPause (iInterval).
      630            if  waitfram-check-timeout()
      631            then do:
      632               leave block-wait.
      633            end.
      634         end.
      635         run waitfram-hide.
      636      end.
      637   procedure waitfram-join :
      638     define input  parameter p-line-1  as character no-undo .
      639     define input  parameter p-line-2  as character no-undo .
      640     define input  parameter p-line-3  as character no-undo .
      641     define output parameter p-message as character no-undo .
      642     do
      643     on error undo, return error return-value
      644     :
      645       assign
      646         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      647                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      648                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      649       .
      650     end.
      651   end procedure.
      652   function waitfram-join-function returns character
      653     (input p-line-1 as character
      654     ,input p-line-2 as character
      655     ,input p-line-3 as character
      656     ).
      657     define variable v-message as character no-undo .
      658     run waitfram-join in this-procedure
      659       (input  p-line-1
      660       ,input  p-line-2
      661       ,input  p-line-3
      662       ,output v-message
      663       ) .
      664     return v-message .
      665   end function .
      666   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667     define variable v-cntxt-db-num        as integer   no-undo .
      668     define variable v-cntxt-userid        as character no-undo .
      669     define variable v-cntxt-level         as character no-undo .
      670     define variable v-cntxt-host-code-obj as integer   no-undo .
      671     define variable v-cntxt-obj-type      as character no-undo .
      672     define variable v-cntxt-obj-code      as integer   no-undo .
      673     define variable v-cntxt-db-num-obj    as integer   no-undo .
      674     define variable v-cntxt-is-admin      as logical   no-undo .
      675   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      676   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      677   procedure fltopend_fltopend :
      678   define input parameter p-parent-handle as handle no-undo .
      679   define input parameter p-qh as handle no-undo .
      680   define input parameter p-flt-open-open-query  as character no-undo .
      681   define input parameter p-where-cond as character no-undo .
      682   define input parameter p-use-indFIRST-query-tail as character no-undo .
      683   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      684   define input parameter p-indexed-reposition as character no-undo .
      685     do
      686     on error undo, return error
      687     :
      688   define variable v-prepare-string as character no-undo .
      689   define variable glog as logical no-undo .
      690   assign
      691   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      692                      p-where-cond + chr(32)  +
      693                      p-use-indFIRST-query-tail + chr(32) +
      694                      p-use-ind-sort-clmn-by + chr(32) +
      695                      p-indexed-reposition
      696   .
      697   assign
      698   glog = p-qh:query-prepare(v-prepare-string) no-error .
      699   if not glog
      700   or error-status:error then do:
      701     message error-status:get-message(1) view-as alert-box .
      702     undo, return error .
      703   end.
      704   assign
      705   glog = p-qh:query-open no-error .
      706   if not glog
      707   or error-status:error then do:
      708     message error-status:get-message(1) view-as alert-box .
      709     undo, return error .
      710   end.
      711     end.
      712   end procedure.
      713   procedure fltopend_fltfindd :
      714   define input parameter p-parent-handle as handle no-undo .
      715   define input parameter p-qh as handle no-undo .
      716   define input parameter p-rowid as rowid no-undo .
      717   define input parameter p-next as logical no-undo .
      718   define input parameter p-lock as integer no-undo .
      719   define input parameter p-bh as handle no-undo .
      720   define input parameter p-where-cond as character no-undo .
      721   define input parameter p-use-index-phrase as character no-undo .
      722   define variable glog as logical no-undo .
      723   define variable v-qh as handle no-undo .
      724   define variable v-bh as handle no-undo .
      725   define variable v-recid as recid no-undo .
      726   define variable v-prepare-string as character no-undo .
      727   do
      728   on error undo, return error
      729   on stop undo, return error
      730   :
      731     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      732     create buffer v-bh for table p-bh buffer-name p-bh:name.
      733     create query v-qh.
      734     v-qh:set-buffers(v-bh).
      735     v-prepare-string = substitute("for each &1 &2 &3"
      736                                     ,v-bh:name
      737                                     ,p-where-cond
      738                                     ,p-use-index-phrase).
      739     glog = v-qh:query-prepare(v-prepare-string) no-error.
      740     if not glog then do:
      741       delete object v-qh.
      742       delete object v-bh.
      743       undo, return error .
      744     end.
      745     glog = v-qh:query-open no-error .
      746     if not glog then do:
      747       delete object v-qh.
      748       delete object v-bh.
      749       undo, return error .
      750     end.
      751     if p-next then do:
      752       v-qh:reposition-to-rowid(p-rowid) no-error .
      753       glog = v-qh:get-next( p-lock) no-error .
      754       glog = v-qh:get-next( p-lock) no-error .
      755       if not glog or v-qh:query-off-end = yes then do:
      756         glog = v-qh:get-first( p-lock) no-error .
      757       end.
      758     end.
      759     else do:
      760       glog = v-qh:get-first( p-lock) no-error .
      761     end.
      762     v-recid = v-bh:recid no-error .
      763     delete object v-qh.
      764     delete object v-bh.
      765     return string(v-recid) .
      766   end.
      767   end procedure.
      768   procedure fltopend_fltfindq :
      769   define input parameter p-parent-handle as handle no-undo .
      770   define input parameter p-qh as handle no-undo .
      771   define input parameter p-next as logical no-undo .
      772   define input parameter p-lock as integer no-undo .
      773   define input parameter p-flt-open-open-query  as character no-undo .
      774   define input parameter p-where-cond as character no-undo .
      775   define input parameter p-use-indFIRST-query-tail as character no-undo .
      776   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      777   define input parameter p-indexed-reposition as character no-undo .
      778   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      779   define variable glog as logical no-undo .
      780   define variable v-qh as handle no-undo .
      781   define variable v-bh as handle no-undo extent 18.
      782   define variable v-rowid as rowid no-undo extent 18.
      783   define variable v-ii as integer no-undo .
      784   define variable v-prepare-string as character no-undo .
      785   do
      786   on error undo, return error
      787   on stop undo, return error
      788   :
      789     create query v-qh.
      790     do v-ii = 1 to p-qh:num-buffers:
      791       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      792       assign
      793       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      794       no-error.
      795       v-qh:add-buffer(v-bh[v-ii]).
      796     end.
      797     assign
      798     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      799                       p-where-cond + chr(32)  +
      800                       p-use-indFIRST-query-tail + chr(32) +
      801                       p-use-ind-sort-clmn-by + chr(32) +
      802                       p-indexed-reposition
      803     .
      804     glog = v-qh:query-prepare( v-prepare-string) no-error .
      805     if not glog then do:
      806       delete object v-qh.
      807       do v-ii = 1 to p-qh:num-buffers:
      808         delete object v-bh[v-ii].
      809       end.
      810       undo, return error .
      811     end.
      812     glog = v-qh:query-open no-error .
      813     if not glog then do:
      814       delete object v-qh.
      815       do v-ii = 1 to p-qh:num-buffers:
      816         delete object v-bh[v-ii].
      817       end.
      818       undo, return error .
      819     end.
      820     if p-next then do:
      821       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      822       glog = v-qh:get-next( p-lock) no-error .
      823       glog = v-qh:get-next( p-lock) no-error .
      824       if not glog or v-qh:query-off-end = yes then do:
      825         glog = v-qh:get-first( p-lock) no-error .
      826       end.
      827     end.
      828     else do:
      829       glog = v-qh:get-first( p-lock) no-error .
      830     end.
      831     do v-ii = 1 to p-qh:num-buffers:
      832       assign
      833       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      834       no-error.
      835     end.
      836     delete object v-qh.
      837     do v-ii = 1 to p-qh:num-buffers:
      838       delete object v-bh[v-ii].
      839     end.
      840   end.
      841   end procedure.
      842   define variable filter-label0 as character no-undo init "Кассовые_смены" .
      843   define variable filter-label as character no-undo init "Кассовые_смены" .
      844   define variable filter-point0 as character no-undo init "shftcshs" .
      845   define variable filter-point as character no-undo init "shftcshs" .
      846   define variable sort-column-name as character no-undo .
      847   define variable v-rec as recid no-undo .
      848   define buffer sb-shift-cash for ub.shift-cash.
      849   define variable cashnum like ub.cash-desk.cash-num no-undo.
      850   define variable old-sale-date like ub.shift-cash.sale-date no-undo.
      851   DEFINE VARIABLE l-shift-on AS LOGICAL NO-UNDO.
      852   DEFINE VARIABLE v-shft AS INTEGER NO-UNDO.
      853   DEFINE VARIABLE cas-shft AS logical NO-UNDO.
      854   DEFINE BUTTON B-chg
      855        LABEL "&Изменить"
      856        SIZE 10 BY 1.
      857   DEFINE BUTTON B-close
      858        LABEL "Закрыть смену"
      859        SIZE 15 BY 1.
      860   DEFINE BUTTON B-exit AUTO-GO
      861        LABEL "&Выход"
      862        SIZE 10 BY 1
      863        BGCOLOR 8 .
      864   DEFINE BUTTON B-Help
      865        LABEL "Помо&щь"
      866        SIZE 3 BY 1
      867        BGCOLOR 8 .
      868   DEFINE BUTTON B-sch
      869        LABEL "&Фильтр"
      870        SIZE 10 BY 1.
      871   DEFINE QUERY BR-docs FOR
      872                   sb-shift-cash SCROLLING.
      873   DEFINE BROWSE BR-docs
      874     QUERY BR-docs DISPLAY
      875         sb-shift-cash.cash-num COLUMN-LABEL "Касса" FORMAT "9999"
      876         sb-shift-cash.obj-code COLUMN-LABEL "Магазин"
      877         sb-shift-cash.sale-date
      878         sb-shift-cash.src-shift-name COLUMN-LABEL "№!(первонач.)"
      879         sb-shift-cash.shift-name COLUMN-LABEL "№!(окончат.)"
      880         sb-shift-cash.shift-num COLUMN-LABEL "Пор."
      881         sb-shift-cash.shift-date COLUMN-LABEL "Дата смены" FORMAT "99/99/9999"
      882         string(sb-shift-cash.shift-open-time, "HH:MM:SS") COLUMN-LABEL "Время!начала" FORMAT "X(8)"
      883         sb-shift-cash.status_
      884         sb-shift-cash.opened FORMAT "X(15)"
      885         sb-shift-cash.shift-close-date COLUMN-LABEL "Дата закрытия" FORMAT "99/99/9999"
      886         string(sb-shift-cash.shift-close-time, "HH:MM:SS") COLUMN-LABEL "Время!закрытия" FORMAT "X(8)"
      887         sb-shift-cash.closed FORMAT "X(15)"
      888         sb-shift-cash.z-num
      889         ENABLE
      890         sb-shift-cash.sale-date
      891       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.5 BY 10.37.
      892   DEFINE FRAME Dialog-Frame
      893        B-exit AT ROW 1 COL 1.1
      894        B-chg AT ROW 1 COL 11
      895        B-sch AT ROW 1 COL 21
      896        B-close AT ROW 1 COL 21
      897        B-Help AT ROW 1 COL 95
      898        BR-docs AT ROW 3.43 COL 1
      899        SPACE(0.00) SKIP(0.44)
      900       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      901            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      902            TITLE "Кассовые смены"
      903            DEFAULT-BUTTON B-exit.
      904   ASSIGN
      905          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      906          FRAME Dialog-Frame:HIDDEN           = TRUE.
      907   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      908   DO:
      909     APPLY "END-ERROR":U TO SELF.
      910   END.
      911   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
      912   DO:
      913       IF NOT l-shift-on AND v-shft > 0 THEN DO:
      914         assign
      915         sb-shift-cash.sale-date:read-only in browse BR-docs = NOT
      916                 sb-shift-cash.sale-date:read-only in browse BR-docs .
      917         APPLY "ENTRY" to browse BR-docs.
      918         IF   sb-shift-cash.sale-date:read-only in browse BR-docs = FALSE THEN do:
      919             APPLY "ENTRY" to sb-shift-cash.sale-date in browse BR-docs.
      920         end.
      921         else do:
      922             .
      923         end.
      924     END.
      925     run proc-b-chg IN THIS-PROCEDURE ( INPUT sb-shift-cash.obj-code
      926                                     ,INPUT sb-shift-cash.cash-num
      927                                     ,INPUT sb-shift-cash.shift-date
      928                                     ,INPUT sb-shift-cash.shift-num
      929                                     ,INPUT sb-shift-cash.src-shift-name
      930                                     ,input recid(sb-shift-cash)
      931                                        ) NO-ERROR.
      932     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      933     br-docs:refresh().
      934   END.
      935   ON CHOOSE OF B-close IN FRAME Dialog-Frame
      936   DO:
      937     DEFINE VARIABLE v-today as date no-undo .
      938     DEFINE VARIABLE v-time as integer no-undo .
      939     define variable glog as logical no-undo .
      940     define variable is-super as logical no-undo .
      941     DEFINE BUFFER t-shift-cash for ub.shift-cash.
      942     message
      943     "Вы действительно хотите закрыть эту смену на кассе?"
      944     view-as alert-box question buttons YES-NO update glog.
      945     if not glog then return no-apply.
      946   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      947   do:
      948     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      949       (input  v-cntxt-db-num
      950       ,input  v-cntxt-userid
      951       ,input  0
      952       ,input  'actn_shift_super':U
      953       ,input  'object':U
      954       ,input  v-cntxt-host-code-obj
      955       ,input  v-cntxt-obj-type
      956       ,input  v-cntxt-obj-code
      957       ,input  0
      958       ,input  0
      959       ,input  0
      960       ,input  false
      961       ,output glog
      962       )  .
      963   end.
      964     if glog then do:
      965       is-super = yes.
      966     end.
      967     else do:
      968   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      969   do:
      970     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      971       (input  v-cntxt-db-num
      972       ,input  v-cntxt-userid
      973       ,input  0
      974       ,input  'actn_shift_regular':U
      975       ,input  'object':U
      976       ,input  v-cntxt-host-code-obj
      977       ,input  v-cntxt-obj-type
      978       ,input  v-cntxt-obj-code
      979       ,input  0
      980       ,input  0
      981       ,input  0
      982       ,input  true
      983       ,output glog
      984       )  .
      985   end.
      986       if not glog
      987       then do:
      988         return no-apply.
      989       end.
      990     end.
      991     FIND FIRST t-shift-cash where recid(t-shift-cash) = recid(sb-shift-cash).
      992     if t-shift-cash.status_ <> 'зкр':U  then do:
      993       run cur-time in this-procedure ( output v-today, output v-time).
      994       assign
      995       t-shift-cash.status_ =  'зкр':U
      996       t-shift-cash.closed = 'режим-менеджера':U
      997       t-shift-cash.shift-close-date = v-today
      998       t-shift-cash.shift-close-time = v-time
      999       .
     1000     end.
     1001     else do:
     1002       message
     1003       "Эта смена уже закрыта"
     1004       view-as alert-box .
     1005     end.
     1006     br-docs:refresh().
     1007   END.
     1008   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1009   DO:
     1010     assign
     1011     tbl = 'shift-cash'
     1012     join-tbl = 'sb-shift-cash'
     1013     fld = '':U
     1014     lab = '':U
     1015     spr = '':U
     1016     dim = '0':U
     1017     .
     1018     run fltfield-add in this-procedure('obj-code', 'N магазина', '',
     1019     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1020     run fltfield-add in this-procedure('cash-num', 'N кассы', '',
     1021     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1022     run fltfield-add in this-procedure('sale-date', 'Дата продажи', '',
     1023     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1024     run fltfield-add in this-procedure('shift-date', 'Дата смены', '',
     1025     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1026     run fltfield-add in this-procedure('shift-num', 'Пор. смены', '',
     1027     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1028     run fltfield-add in this-procedure('src-shift-name', 'Первонач. № смены', '',
     1029     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1030     run fltfield-add in this-procedure('shift-name', 'Оконч. № смены', '',
     1031     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1032     run fltfield-add in this-procedure('z-num', 'N z-отчета', '',
     1033     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1034     run fltfield-add in this-procedure('shift-open-time', 'Время начала', 'time',
     1035     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1036     run fltfield-add in this-procedure('shift-close-date', 'Дата закрытия', '',
     1037     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1038     run fltfield-add in this-procedure('shift-close-time', 'Время закрытия', 'time',
     1039     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1040     DO on stop undo, leave:
     1041       run gbl/filter.w ( input parparentproc
     1042                         ,input (filter-point + chr(4) + filter-label)
     1043                         ,input tbl
     1044                         ,input join-tbl
     1045                         ,input fld
     1046                         ,input lab
     1047                         ,input spr
     1048                         ,input dim).
     1049       RUN OpenBr  ( input yes, input no, input '':U).
     1050     END .
     1051   END.
     1052   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1053   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1054   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1055   on help of frame Dialog-Frame
     1056   do:
     1057     run gbl/app_help.p
     1058       (input this-procedure :file-name
     1059       ,input ''
     1060       ,input ?
     1061       ) no-error.
     1062     if error-status :error then do:
     1063       message
     1064         "Ошибка при вызове помощи"
     1065         error-status :get-message(1)
     1066         view-as alert-box .
     1067     end.
     1068   end.
     1069   run minbtn-set in this-procedure .
     1070   on choose of b-help in frame Dialog-Frame
     1071   do:
     1072     apply "help":u to frame Dialog-Frame .
     1073   end.
     1074   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1075   procedure minbtn-set :
     1076       do
     1077           on error undo, return error return-value
     1078           :
     1079           define variable ii              as integer       no-undo .
     1080           define variable fh              as widget-handle no-undo .
     1081           define variable hh              as widget-handle no-undo .
     1082           define variable v-h             as handle        extent 4 no-undo .
     1083           define variable v-name-button   as character     no-undo .
     1084           define variable v-help-old-x    as decimal       no-undo .
     1085           define variable v-help-old-y    as decimal       no-undo .
     1086           define variable v-help-old-size as decimal       no-undo .
     1087           define variable v-frame-width   as decimal       no-undo .
     1088           define variable jj              as integer       no-undo .
     1089           do
     1090               on error undo, return error
     1091               :
     1092               assign
     1093                   v-frame-width = frame Dialog-Frame:width - 0.3
     1094                   fh            = frame Dialog-Frame:first-child
     1095                   hh            = fh:first-child
     1096                   ii            = 1
     1097                   .
     1098               do while valid-handle(hh):
     1099                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1100                   do:
     1101                       case lc(hh:name) :
     1102                           when "b-help" then
     1103                               do:
     1104                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1105                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1106                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1107                                   hh:TOOLTIP = "Помощь" .
     1108                                   v-help-old-x = hh:column .
     1109                                   v-help-old-y = hh:row    .
     1110                                   v-help-old-size = hh:width .
     1111                                   hh:width-chars = 2.5 .
     1112                               end.
     1113                           when "b-print" then
     1114                               do:
     1115                                   hh:load-image("cmp/b-print.bmp":u) .
     1116                                   hh:TOOLTIP = "Печать" .
     1117                                   v-h[ii] = hh:handle .
     1118                                   ii = ii + 1 .
     1119                                   hh:width-chars = 3 .
     1120                               end.
     1121                           when "b-history" or
     1122                           when "b-hist" then
     1123                               do:
     1124                                   hh:load-image("cmp/b-hist.bmp":u) .
     1125                                   hh:TOOLTIP = "История" .
     1126                                   v-h[ii] = hh:handle .
     1127                                   ii = ii + 1 .
     1128                                   hh:width-chars = 3 .
     1129                               end.
     1130                           when "b-sch" then
     1131                               do:
     1132                                   hh:load-image("cmp/b-sch.bmp":u) .
     1133                                   hh:TOOLTIP = "Установка Фильтра" .
     1134                                   v-h[ii] = hh:handle .
     1135                                   ii = ii + 1 .
     1136                                   hh:width-chars = 3 .
     1137                               end.
     1138                           when "b-hist-user" then
     1139                               do:
     1140                                   hh:load-image("cmp/b-hist.bmp":u) .
     1141                                   hh:TOOLTIP = "История пользователя" .
     1142                                   ii = ii + 1 .
     1143                               end.
     1144                       end case.
     1145                   end.
     1146                   hh = hh:next-sibling.
     1147               end.
     1148               b-help:column = v-frame-width - b-help:width-chars.
     1149               jj = 0.
     1150               repeat ii = 4 to 1 by -1 :
     1151                   if valid-handle (v-h[ii] ) then
     1152                   do:
     1153                       jj  = jj + 1 .
     1154                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1155                       v-h[ii]:row    = v-help-old-y .
     1156                   end.
     1157               end.
     1158           end.
     1159       end.
     1160   end procedure.
     1161   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1162   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1163   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1164   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1165   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1166   define variable v-diasize-current-frame-height as decimal   no-undo .
     1167   define variable v-diasize-change-size          as logical   no-undo .
     1168   define variable v-diasize-resize-button        as handle    no-undo .
     1169   define variable v-diasize-wndmax               as logical   no-undo .
     1170   define variable v-diasize-wndstore             as logical   no-undo .
     1171   define variable v-diasize-proc-name            as character no-undo .
     1172   define variable v-diasize-browse-handle        as handle    no-undo .
     1173   define variable v-diasize-browse-number        as integer   no-undo .
     1174   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1175   define temp-table temp-diasize-handle no-undo
     1176     field handle-value  as handle
     1177     field save-position as decimal
     1178     index xpk is primary unique handle-value
     1179     .
     1180   define temp-table temp-browse-handle no-undo
     1181     field browse-type   as character
     1182     field browse-number as integer
     1183     field browse-handle as handle
     1184     field original-size as decimal
     1185     index xpk is primary unique browse-type browse-number
     1186     index xie browse-type browse-handle
     1187   .
     1188   procedure diasize_change-height :
     1189     define input  parameter p-change-value  as decimal   no-undo .
     1190     define input  parameter p-move-resize   as logical   no-undo .
     1191     define variable v-field-group-handle    as handle    no-undo .
     1192     define variable v-object-handle         as handle    no-undo .
     1193     define variable v-frame-height          as decimal   no-undo .
     1194     define variable v-frame-virtual-height  as decimal   no-undo .
     1195     define variable v-browse-height         as decimal   no-undo .
     1196     define variable v-window-height         as decimal   no-undo .
     1197     define variable v-window-virtual-height as decimal   no-undo .
     1198     define variable v-change-sign           as integer   no-undo .
     1199     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1200     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1201     if p-change-value > 0
     1202     then do:
     1203       if frame Dialog-Frame :height + p-change-value
     1204           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1205       then do:
     1206         assign
     1207           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1208                           - (frame Dialog-Frame :height-chars)
     1209         .
     1210         if p-change-value <= 0
     1211         then do:
     1212           run diasize_position-resize-button in this-procedure .
     1213           return .
     1214         end.
     1215       end.
     1216     end.
     1217     if p-change-value < 0
     1218     then do:
     1219       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1220       then do:
     1221         assign
     1222           p-change-value = v-diasize-orig-frame-height
     1223                          - (frame Dialog-Frame :height-chars)
     1224         .
     1225         if p-change-value >= 0
     1226         then do:
     1227           run diasize_position-resize-button in this-procedure .
     1228           return .
     1229         end.
     1230       end.
     1231     end.
     1232     if p-change-value >= 0
     1233     then do:
     1234       assign
     1235         v-change-sign = 1
     1236       .
     1237     end.
     1238     else do:
     1239       assign
     1240         v-change-sign = -1
     1241       .
     1242     end.
     1243     assign
     1244       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1245     .
     1246     if p-change-value = 0
     1247     then do:
     1248       run diasize_position-resize-button in this-procedure .
     1249       return .
     1250     end.
     1251     move_block:
     1252     do
     1253     on error undo move_block, retry move_block
     1254     :
     1255       if retry
     1256       then do:
     1257         do
     1258         on error undo move_block, leave move_block
     1259         :
     1260           if p-change-value > 0
     1261           then do:
     1262             for each buf_temp-diasize-handle
     1263             on error undo, next
     1264             :
     1265               assign
     1266                 v-object-handle = buf_temp-diasize-handle.handle-value
     1267               .
     1268               if v-object-handle <> v-diasize-resize-button
     1269               then do:
     1270                 assign
     1271                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1272                 .
     1273               end.
     1274             end.
     1275             assign
     1276               v-diasize-browse-handle :height = v-browse-height
     1277             .
     1278             for each buf_temp-browse-handle
     1279               where buf_temp-browse-handle.browse-type = 'height':u
     1280             on error undo, next
     1281             :
     1282               assign
     1283                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1284               .
     1285             end.
     1286             assign
     1287               frame Dialog-Frame :height = v-frame-height
     1288             .
     1289             if frame Dialog-Frame :scrollable = true
     1290             then do:
     1291               assign
     1292                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1293               .
     1294             end.
     1295             run diasize_position-resize-button in this-procedure .
     1296           end.
     1297           else do:
     1298             if frame Dialog-Frame :scrollable = true
     1299             then do:
     1300               assign
     1301                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1302               .
     1303             end.
     1304             assign
     1305               frame Dialog-Frame :height = v-frame-height
     1306             .
     1307             assign
     1308               v-diasize-browse-handle :height = v-browse-height
     1309             .
     1310             for each buf_temp-browse-handle
     1311               where buf_temp-browse-handle.browse-type = 'height':u
     1312             on error undo, next
     1313             :
     1314               assign
     1315                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1316               .
     1317             end.
     1318             for each buf_temp-diasize-handle
     1319             on error undo, next
     1320             :
     1321               assign
     1322                 v-object-handle = buf_temp-diasize-handle.handle-value
     1323               .
     1324               if v-object-handle <> v-diasize-resize-button
     1325               then do:
     1326                 assign
     1327                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1328                 .
     1329               end.
     1330             end.
     1331             run diasize_position-resize-button in this-procedure .
     1332           end.
     1333           assign
     1334             v-diasize-change-size = false
     1335           .
     1336           leave move_block .
     1337         end.
     1338       end.
     1339       assign
     1340         v-diasize-need-full-display = true
     1341       .
     1342       if v-diasize-change-size = false
     1343       then do:
     1344         assign
     1345           v-diasize-change-size = true
     1346         .
     1347       end.
     1348       else do:
     1349         return .
     1350       end.
     1351       assign
     1352         v-frame-height = frame Dialog-Frame :height
     1353         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1354         v-browse-height = v-diasize-browse-handle :height
     1355       .
     1356       for each buf_temp-browse-handle
     1357         where buf_temp-browse-handle.browse-type = 'height':u
     1358       :
     1359         assign
     1360           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1361         .
     1362       end.
     1363       for each buf_temp-diasize-handle
     1364       :
     1365         delete buf_temp-diasize-handle .
     1366       end.
     1367       assign
     1368         v-field-group-handle = frame Dialog-Frame :first-child
     1369       .
     1370       do while valid-handle(v-field-group-handle)
     1371       :
     1372         assign
     1373           v-object-handle = v-field-group-handle :first-child
     1374         .
     1375         do while valid-handle(v-object-handle)
     1376         :
     1377           if  v-object-handle <> v-diasize-browse-handle :handle
     1378           and can-query(v-object-handle, "row")
     1379           and can-query(v-object-handle, "height")
     1380           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1381           then do:
     1382             find first buf_temp-browse-handle
     1383               where buf_temp-browse-handle.browse-type   = 'height':u
     1384                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1385               no-error .
     1386             if available buf_temp-browse-handle
     1387             then do:
     1388             end.
     1389             else do:
     1390               create buf_temp-diasize-handle .
     1391               assign
     1392                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1393                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1394               .
     1395             end.
     1396           end.
     1397           assign
     1398             v-object-handle = v-object-handle :next-sibling
     1399           .
     1400         end.
     1401         assign
     1402           v-field-group-handle = v-field-group-handle :next-sibling
     1403         .
     1404       end.
     1405       do with frame Dialog-Frame
     1406       :
     1407         hide v-diasize-resize-button .
     1408         assign
     1409           v-diasize-resize-button :row    = 1
     1410           v-diasize-resize-button :column = 1
     1411         .
     1412       end.
     1413       if p-change-value > 0
     1414       then do:
     1415         if frame Dialog-Frame :scrollable = true
     1416         then do:
     1417           assign
     1418             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1419             no-error .
     1420           if error-status :error
     1421           or error-status :get-message(1) <> ""
     1422           then do:
     1423             undo move_block, retry move_block .
     1424           end.
     1425         end.
     1426         assign
     1427           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1428           no-error .
     1429         if error-status :error
     1430         or error-status :get-message(1) <> ""
     1431         then do:
     1432           undo move_block, retry move_block .
     1433         end.
     1434         assign
     1435           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1436           no-error .
     1437         if error-status :error
     1438         or error-status :get-message(1) <> ""
     1439         then do:
     1440           undo move_block, retry move_block .
     1441         end.
     1442         for each buf_temp-browse-handle
     1443           where buf_temp-browse-handle.browse-type = 'height':u
     1444         on error undo move_block, retry move_block
     1445         :
     1446           assign
     1447             buf_temp-browse-handle.browse-handle :height
     1448               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1449             no-error .
     1450           if error-status :error
     1451           or error-status :get-message(1) <> ""
     1452           then do:
     1453             undo move_block, retry move_block .
     1454           end.
     1455         end.
     1456         for each buf_temp-diasize-handle
     1457         on error undo move_block, retry move_block
     1458         :
     1459           assign
     1460             v-object-handle = buf_temp-diasize-handle.handle-value
     1461           .
     1462           if v-object-handle <> v-diasize-resize-button
     1463           then do:
     1464             assign
     1465               v-object-handle :row = v-object-handle :row + p-change-value
     1466               no-error .
     1467             if error-status :error
     1468             or error-status :get-message(1) <> ""
     1469             then do:
     1470               undo move_block, retry move_block .
     1471             end.
     1472           end.
     1473         end.
     1474       end.
     1475       else do:
     1476         for each buf_temp-diasize-handle
     1477         on error undo move_block, retry move_block
     1478         :
     1479           assign
     1480             v-object-handle = buf_temp-diasize-handle.handle-value
     1481           .
     1482           if v-object-handle <> v-diasize-resize-button
     1483           then do:
     1484             assign
     1485               v-object-handle :row = v-object-handle :row + p-change-value
     1486               no-error .
     1487             if error-status :error
     1488             or error-status :get-message(1) <> ""
     1489             then do:
     1490               undo move_block, retry move_block .
     1491             end.
     1492           end.
     1493         end.
     1494         assign
     1495           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1496           no-error .
     1497         if error-status :error
     1498         or error-status :get-message(1) <> ""
     1499         then do:
     1500           undo move_block, retry move_block .
     1501         end.
     1502         for each buf_temp-browse-handle
     1503           where buf_temp-browse-handle.browse-type = 'height':u
     1504         on error undo move_block, retry move_block
     1505         :
     1506           assign
     1507             buf_temp-browse-handle.browse-handle :height
     1508               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1509             no-error .
     1510           if error-status :error
     1511           or error-status :get-message(1) <> ""
     1512           then do:
     1513             undo move_block, retry move_block .
     1514           end.
     1515         end.
     1516         assign
     1517           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1518           no-error .
     1519         if error-status :error
     1520         or error-status :get-message(1) <> ""
     1521         then do:
     1522           undo move_block, retry move_block .
     1523         end.
     1524         if frame Dialog-Frame :scrollable = true
     1525         then do:
     1526           assign
     1527             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1528             no-error .
     1529           if error-status :error
     1530           or error-status :get-message(1) <> ""
     1531           then do:
     1532             undo move_block, retry move_block .
     1533           end.
     1534         end.
     1535       end.
     1536       if p-move-resize = true
     1537       then do:
     1538         run diasize_position-resize-button in this-procedure .
     1539       end.
     1540       if v-diasize-wndstore = true
     1541       then do:
     1542         if connected("ub") = true
     1543         then do:
     1544           define variable v-cntxt-db-num        as integer   no-undo .
     1545           define variable v-cntxt-userid        as character no-undo .
     1546           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1547                                             , OUTPUT v-cntxt-userid
     1548                                             ) .
     1549           run gbl/wndsizew.p
     1550             (input  v-cntxt-db-num
     1551             ,input  v-cntxt-userid
     1552             ,input  v-diasize-proc-name
     1553             ,input  'height':u
     1554             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1555             ) .
     1556         end.
     1557       end.
     1558     end.
     1559     assign
     1560       v-diasize-change-size = false
     1561     .
     1562   end procedure.
     1563   procedure diasize_set-height :
     1564     define input  parameter p-new-height  as decimal   no-undo .
     1565     define input  parameter p-move-resize as logical   no-undo .
     1566     do
     1567     on error undo, return error return-value
     1568     :
     1569       run diasize_change-height in this-procedure
     1570         (input  (p-new-height - frame Dialog-Frame :height)
     1571         ,input  p-move-resize
     1572         ) .
     1573     end.
     1574   end procedure.
     1575   procedure diasize_change-width :
     1576     define input  parameter p-change-value as decimal   no-undo .
     1577     define input  parameter p-move-resize  as logical   no-undo .
     1578     define variable v-field-group-handle   as handle    no-undo .
     1579     define variable v-object-handle        as handle    no-undo .
     1580     define variable v-frame-width          as decimal   no-undo .
     1581     define variable v-frame-virtual-width  as decimal   no-undo .
     1582     define variable v-browse-width         as decimal   no-undo .
     1583     define variable v-window-width         as decimal   no-undo .
     1584     define variable v-window-virtual-width as decimal   no-undo .
     1585     define variable v-change-sign          as integer   no-undo .
     1586     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1587     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1588     if p-change-value > 0
     1589     then do:
     1590       if frame Dialog-Frame :width + p-change-value >
     1591           session :width-chars
     1592       then do:
     1593         assign
     1594           p-change-value = session :width-chars - frame Dialog-Frame :width
     1595         .
     1596         if p-change-value <= 0
     1597         then do:
     1598           run diasize_position-resize-button in this-procedure .
     1599           return .
     1600         end.
     1601       end.
     1602     end.
     1603     if p-change-value < 0
     1604     then do:
     1605       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1606       then do:
     1607         assign
     1608           p-change-value = v-diasize-orig-frame-width
     1609                          - frame Dialog-Frame :width
     1610         .
     1611         if p-change-value >= 0
     1612         then do:
     1613           run diasize_position-resize-button in this-procedure .
     1614           return .
     1615         end.
     1616       end.
     1617     end.
     1618     if p-change-value >= 0
     1619     then do:
     1620       assign
     1621         v-change-sign = 1
     1622       .
     1623     end.
     1624     else do:
     1625       assign
     1626         v-change-sign = -1
     1627       .
     1628     end.
     1629     assign
     1630       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1631     .
     1632     if p-change-value = 0
     1633     then do:
     1634       run diasize_position-resize-button in this-procedure .
     1635       return .
     1636     end.
     1637     move_block:
     1638     do
     1639     on error undo move_block, leave move_block
     1640     :
     1641       if retry
     1642       then do:
     1643         do
     1644         on error undo move_block, leave move_block
     1645         :
     1646           if p-change-value > 0
     1647           then do:
     1648             for each buf_temp-diasize-handle
     1649             on error undo, next
     1650             :
     1651               assign
     1652                 v-object-handle = buf_temp-diasize-handle.handle-value
     1653               .
     1654               if v-object-handle <> v-diasize-resize-button
     1655               then do:
     1656                 assign
     1657                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1658                 .
     1659               end.
     1660             end.
     1661             assign
     1662               v-diasize-browse-handle :width = v-browse-width
     1663             .
     1664             for each buf_temp-browse-handle
     1665               where buf_temp-browse-handle.browse-type = 'width':u
     1666             on error undo, next
     1667             :
     1668               assign
     1669                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1670               .
     1671             end.
     1672             assign
     1673               frame Dialog-Frame :width = v-frame-width
     1674             .
     1675             if frame Dialog-Frame :scrollable = true
     1676             then do:
     1677               assign
     1678                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1679               .
     1680             end.
     1681             run diasize_position-resize-button in this-procedure .
     1682           end.
     1683           else do:
     1684             if frame Dialog-Frame :scrollable = true
     1685             then do:
     1686               assign
     1687                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1688               .
     1689             end.
     1690             assign
     1691               frame Dialog-Frame :width = v-frame-width
     1692             .
     1693             for each buf_temp-browse-handle
     1694               where buf_temp-browse-handle.browse-type = 'width':u
     1695             on error undo, next
     1696             :
     1697               assign
     1698                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1699               .
     1700             end.
     1701             assign
     1702               v-diasize-browse-handle :width = v-browse-width
     1703             .
     1704             for each buf_temp-diasize-handle
     1705             on error undo, next
     1706             :
     1707               assign
     1708                 v-object-handle = buf_temp-diasize-handle.handle-value
     1709               .
     1710               if v-object-handle <> v-diasize-resize-button
     1711               then do:
     1712                 assign
     1713                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1714                 .
     1715               end.
     1716             end.
     1717             run diasize_position-resize-button in this-procedure .
     1718           end.
     1719           assign
     1720             v-diasize-change-size = false
     1721           .
     1722           leave move_block .
     1723         end.
     1724       end.
     1725       assign
     1726         v-diasize-need-full-display = true
     1727       .
     1728       if v-diasize-change-size = false
     1729       then do:
     1730         assign
     1731           v-diasize-change-size = true
     1732         .
     1733       end.
     1734       else do:
     1735         return .
     1736       end.
     1737       assign
     1738         v-frame-width = frame Dialog-Frame :width
     1739         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1740         v-browse-width = v-diasize-browse-handle :width
     1741       .
     1742       for each buf_temp-browse-handle
     1743         where buf_temp-browse-handle.browse-type = 'width':u
     1744       :
     1745         assign
     1746           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1747         .
     1748       end.
     1749       for each buf_temp-diasize-handle
     1750       :
     1751         delete buf_temp-diasize-handle .
     1752       end.
     1753       assign
     1754         v-field-group-handle = frame Dialog-Frame :first-child
     1755       .
     1756       do while valid-handle(v-field-group-handle)
     1757       :
     1758         assign
     1759           v-object-handle = v-field-group-handle :first-child
     1760         .
     1761         do while valid-handle(v-object-handle)
     1762         :
     1763           if  v-object-handle <> v-diasize-browse-handle :handle
     1764           and v-object-handle <> v-diasize-resize-button
     1765           and can-query(v-object-handle, "row")
     1766           and can-query(v-object-handle, "height")
     1767           and ( v-object-handle :col + v-object-handle :width
     1768                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1769               )
     1770           then do:
     1771             find first buf_temp-browse-handle
     1772               where buf_temp-browse-handle.browse-type   = 'width':u
     1773                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1774               no-error .
     1775             if available buf_temp-browse-handle
     1776             then do:
     1777             end.
     1778             else do:
     1779               create buf_temp-diasize-handle .
     1780               assign
     1781                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1782                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1783               .
     1784             end.
     1785           end.
     1786           assign
     1787             v-object-handle = v-object-handle :next-sibling
     1788           .
     1789         end.
     1790         assign
     1791           v-field-group-handle = v-field-group-handle :next-sibling
     1792         .
     1793       end.
     1794       do with frame Dialog-Frame
     1795       :
     1796         hide v-diasize-resize-button .
     1797         v-diasize-resize-button :row = 1.
     1798         v-diasize-resize-button :column = 1.
     1799       end.
     1800       if p-change-value > 0
     1801       then do:
     1802         if frame Dialog-Frame :scrollable = true
     1803         then do:
     1804           assign
     1805             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1806             no-error .
     1807           if error-status :error
     1808           or error-status :get-message(1) <> ""
     1809           then do:
     1810             undo move_block, retry move_block.
     1811           end.
     1812         end.
     1813         assign
     1814           frame Dialog-Frame :width = v-frame-width + p-change-value
     1815           no-error .
     1816         if error-status :error
     1817         or error-status :get-message(1) <> ""
     1818         then do:
     1819           undo move_block, retry move_block.
     1820         end.
     1821         assign
     1822           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1823         no-error .
     1824         if error-status :error
     1825         or error-status :get-message(1) <> ""
     1826         then do:
     1827           undo move_block, retry move_block.
     1828         end.
     1829         for each buf_temp-browse-handle
     1830           where buf_temp-browse-handle.browse-type = 'width':u
     1831         on error undo move_block, retry move_block
     1832         :
     1833           assign
     1834             buf_temp-browse-handle.browse-handle :width
     1835               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1836             no-error .
     1837           if error-status :error
     1838           or error-status :get-message(1) <> ""
     1839           then do:
     1840             undo move_block, retry move_block .
     1841           end.
     1842         end.
     1843         for each buf_temp-diasize-handle
     1844         on error undo move_block, retry move_block
     1845         :
     1846           assign
     1847             v-object-handle = buf_temp-diasize-handle.handle-value
     1848           .
     1849           if v-object-handle <> v-diasize-resize-button
     1850           then do:
     1851             assign
     1852               v-object-handle :col = v-object-handle :col + p-change-value
     1853               no-error .
     1854             if error-status :error
     1855             or error-status :get-message(1) <> ""
     1856             then do:
     1857               undo move_block, retry move_block .
     1858             end.
     1859           end.
     1860         end.
     1861       end.
     1862       else do:
     1863         for each buf_temp-diasize-handle
     1864         on error undo move_block, retry move_block
     1865         :
     1866           assign
     1867             v-object-handle = buf_temp-diasize-handle.handle-value
     1868           .
     1869           if v-object-handle <> v-diasize-resize-button
     1870           then do:
     1871             assign
     1872               v-object-handle :col = v-object-handle :col + p-change-value
     1873               no-error .
     1874             if error-status :error
     1875             or error-status :get-message(1) <> ""
     1876             then do:
     1877               undo move_block, retry move_block .
     1878             end.
     1879           end.
     1880         end.
     1881         for each buf_temp-browse-handle
     1882           where buf_temp-browse-handle.browse-type = 'width':u
     1883         on error undo move_block, retry move_block
     1884         :
     1885           assign
     1886             buf_temp-browse-handle.browse-handle :width
     1887               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1888             no-error .
     1889           if error-status :error
     1890           or error-status :get-message(1) <> ""
     1891           then do:
     1892             undo move_block, retry move_block .
     1893           end.
     1894         end.
     1895         assign
     1896           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1897           no-error .
     1898         if error-status :error
     1899         or error-status :get-message(1) <> ""
     1900         then do:
     1901           undo move_block, retry move_block.
     1902         end.
     1903         assign
     1904           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1905         no-error .
     1906         if error-status :error
     1907         or error-status :get-message(1) <> ""
     1908         then do:
     1909           undo move_block, retry move_block.
     1910         end.
     1911         if frame Dialog-Frame :scrollable = true
     1912         then do:
     1913           assign
     1914             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1915           no-error .
     1916           if error-status :error
     1917           or error-status :get-message(1) <> ""
     1918           then do:
     1919             undo move_block, retry move_block.
     1920           end.
     1921         end.
     1922       end.
     1923       if p-move-resize
     1924       then do:
     1925         run diasize_position-resize-button in this-procedure .
     1926       end.
     1927       if v-diasize-wndstore = true
     1928       then do:
     1929         if connected("ub") = true
     1930         then do:
     1931           define variable v-cntxt-db-num        as integer   no-undo .
     1932           define variable v-cntxt-userid        as character no-undo .
     1933           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1934                                             , OUTPUT v-cntxt-userid
     1935                                             ) .
     1936           run gbl/wndsizew.p
     1937             (input  v-cntxt-db-num
     1938             ,input  v-cntxt-userid
     1939             ,input  v-diasize-proc-name
     1940             ,input  'width':u
     1941             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1942             ) .
     1943         end.
     1944       end.
     1945     end.
     1946     assign
     1947       v-diasize-change-size = false
     1948     .
     1949   end procedure.
     1950   procedure diasize_set-width :
     1951     define input  parameter p-new-width  as decimal   no-undo .
     1952     define input  parameter p-move-resize as logical   no-undo .
     1953     do
     1954     on error undo, return error return-value
     1955     :
     1956       run diasize_change-width in this-procedure
     1957         (input  (p-new-width - frame Dialog-Frame :width)
     1958         ,input  p-move-resize
     1959         ) .
     1960     end.
     1961   end procedure.
     1962   procedure diasize_position-resize-button :
     1963     do with frame Dialog-Frame
     1964     :
     1965       hide v-diasize-resize-button .
     1966       assign
     1967         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1968                     - 1
     1969                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1970         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1971                     - 1
     1972                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1973       .
     1974       view v-diasize-resize-button .
     1975     end.
     1976   end procedure.
     1977   on alt-right anywhere
     1978   do:
     1979     run diasize_change-width in this-procedure
     1980       (input 1
     1981       ,input true
     1982       ) .
     1983     return no-apply .
     1984   end.
     1985   on alt-left anywhere
     1986   do:
     1987     run diasize_change-width in this-procedure
     1988       (input -1
     1989       ,input true
     1990       ) .
     1991     return no-apply .
     1992   end.
     1993   on alt-down anywhere
     1994   do:
     1995     run diasize_change-height in this-procedure
     1996       (input 1
     1997       ,input true
     1998       ) .
     1999     return no-apply .
     2000   end.
     2001   on alt-up anywhere
     2002   do:
     2003     run diasize_change-height in this-procedure
     2004       (input -1
     2005       ,input true
     2006       ) .
     2007     return no-apply .
     2008   end.
     2009   on alt-enter of frame Dialog-Frame
     2010   do:
     2011     run diasize_maximize in this-procedure
     2012       (input  ?
     2013       ).
     2014     return no-apply .
     2015   end.
     2016   procedure diasize_end-move :
     2017     do
     2018     on error undo, return error return-value
     2019     :
     2020       define variable v-row-delta as decimal   no-undo .
     2021       define variable v-col-delta as decimal   no-undo .
     2022       define variable v-new-row as decimal   no-undo .
     2023       define variable v-new-col as decimal   no-undo .
     2024       assign
     2025         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2026         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2027       .
     2028       assign
     2029         v-row-delta = v-new-row - frame Dialog-Frame :height
     2030         v-col-delta = v-new-col - frame Dialog-Frame :width
     2031       .
     2032       run diasize_change-height in this-procedure
     2033         (input v-row-delta
     2034         ,input true
     2035         ) .
     2036       run diasize_change-width in this-procedure
     2037         (input v-col-delta
     2038         ,input true
     2039         ) .
     2040     end.
     2041   end procedure.
     2042   procedure diasize_maximize :
     2043     define input  parameter p-action as logical   no-undo .
     2044     do
     2045     on error undo, return error return-value
     2046     :
     2047       if p-action = ?
     2048       then do:
     2049         if v-diasize-need-maximize = true
     2050         then do:
     2051           assign
     2052             p-action = true
     2053           .
     2054         end.
     2055         else do:
     2056           assign
     2057             p-action = false
     2058           .
     2059         end.
     2060       end.
     2061       if p-action = true
     2062       then do:
     2063         run diasize_change-height in this-procedure
     2064           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2065               - frame Dialog-Frame :height-chars
     2066           ,input true
     2067           ) .
     2068         run diasize_change-width in this-procedure
     2069           (input session :width-chars
     2070               - frame Dialog-Frame :width-chars
     2071           ,input true
     2072           ) .
     2073         assign
     2074           v-diasize-need-maximize = false
     2075         .
     2076       end.
     2077       else do:
     2078         run diasize_change-width in this-procedure
     2079           (input v-diasize-orig-frame-width
     2080               - frame Dialog-Frame :width-chars
     2081           ,input true
     2082           ) .
     2083         run diasize_change-height in this-procedure
     2084           (input v-diasize-orig-frame-height
     2085               - frame Dialog-Frame :height-chars
     2086           ,input true
     2087           ) .
     2088         assign
     2089           v-diasize-need-maximize = true
     2090         .
     2091       end.
     2092     end.
     2093   end procedure.
     2094   procedure diasize_restore-orig-size :
     2095     do
     2096     on error undo, return error return-value
     2097     :
     2098       assign
     2099         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2100         v-diasize-current-frame-height = frame Dialog-Frame :height
     2101       .
     2102       run diasize_set-height in this-procedure
     2103         (input  v-diasize-orig-frame-height
     2104         ,input  true
     2105         ) .
     2106       run diasize_set-width in this-procedure
     2107         (input  v-diasize-orig-frame-width
     2108         ,input  true
     2109         ) .
     2110     end.
     2111   end procedure.
     2112   procedure diasize_restore-current-size :
     2113     do
     2114     on error undo, return error return-value
     2115     :
     2116       run diasize_set-height in this-procedure
     2117         (input  v-diasize-current-frame-height
     2118         ,input  true
     2119         ) .
     2120       run diasize_set-width in this-procedure
     2121         (input  v-diasize-current-frame-width
     2122         ,input  true
     2123         ) .
     2124     end.
     2125   end procedure.
     2126   procedure diasize_set-browse-handle :
     2127     define input  parameter p-browse-handle as handle   no-undo .
     2128     define buffer buf_temp-browse-handle for temp-browse-handle .
     2129     do
     2130     on error undo, return error return-value
     2131     :
     2132       assign
     2133         v-diasize-browse-handle = p-browse-handle
     2134       .
     2135       for each buf_temp-browse-handle
     2136       on error undo, return error return-value
     2137       :
     2138         delete buf_temp-browse-handle .
     2139       end.
     2140     end.
     2141   end procedure.
     2142   procedure diasize_add_browse :
     2143     define input  parameter p-browse-type   as character no-undo .
     2144     define input  parameter p-browse-handle as handle    no-undo .
     2145     define buffer buf_temp-browse-handle for temp-browse-handle .
     2146     do
     2147     on error undo, return error return-value
     2148     :
     2149       assign
     2150         v-diasize-browse-number = v-diasize-browse-number + 1
     2151       .
     2152       create buf_temp-browse-handle .
     2153       assign
     2154         buf_temp-browse-handle.browse-type   = p-browse-type
     2155         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2156         buf_temp-browse-handle.browse-handle = p-browse-handle
     2157       .
     2158     end.
     2159   end procedure.
     2160   procedure diasize_init :
     2161     define variable v-default-value    as logical   no-undo .
     2162     define variable v-restore-saved    as logical   no-undo .
     2163     define variable v-resize-value-str as character no-undo .
     2164     do
     2165     on error undo, return error return-value
     2166     :
     2167       do with frame Dialog-Frame
     2168       :
     2169         assign
     2170           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2171           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2172           v-diasize-browse-handle     = browse BR-docs :handle
     2173         .
     2174         create button v-diasize-resize-button
     2175         assign
     2176           parent        = frame Dialog-Frame :first-child
     2177           label         = "s"
     2178           height-pixels = 16
     2179           width-pixels  = 16
     2180           visible       = true
     2181           sensitive     = true
     2182           movable       = true
     2183           triggers:
     2184             on end-move persistent run diasize_end-move in this-procedure .
     2185           end triggers.
     2186         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2187         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2188         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2189         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2190         assign
     2191           v-diasize-wndmax = false
     2192         .
     2193         if connected("ub") = true
     2194         then do:
     2195           define variable v-cntxt-db-num        as integer   no-undo .
     2196           define variable v-cntxt-userid        as character no-undo .
     2197           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2198                                             , OUTPUT v-cntxt-userid
     2199                                             ) .
     2200           run gbl/wndpar_r.p
     2201             (input  v-cntxt-db-num
     2202             ,input  v-cntxt-userid
     2203             ,input  'wndmax':U
     2204             ,output v-diasize-wndmax
     2205             ,output v-default-value
     2206             ) .
     2207         end.
     2208         assign
     2209           v-diasize-wndstore = false
     2210         .
     2211         if connected("ub") = true
     2212         then do:
     2213           run gbl/wndpar_r.p
     2214             (input  v-cntxt-db-num
     2215             ,input  v-cntxt-userid
     2216             ,input  'wndstore':U
     2217             ,output v-diasize-wndstore
     2218             ,output v-default-value
     2219             ) .
     2220         end.
     2221         assign
     2222           v-diasize-proc-name = entry(1, program-name(2), '.')
     2223         .
     2224         if v-diasize-wndstore = true
     2225         then do:
     2226           assign
     2227             v-restore-saved = false
     2228           .
     2229           if connected("ub") = true
     2230           then do:
     2231             run gbl/wndsizer.p
     2232               (input  v-cntxt-db-num
     2233               ,input  v-cntxt-userid
     2234               ,input  v-diasize-proc-name
     2235               ,input  'height':u
     2236               ,output v-resize-value-str
     2237               ) .
     2238             if v-resize-value-str <> '':U
     2239             then do:
     2240               run diasize_change-height in this-procedure
     2241                 (input  integer(v-resize-value-str)
     2242                 ,input  true
     2243                 ) .
     2244               assign
     2245                 v-restore-saved = true
     2246               .
     2247             end.
     2248           end.
