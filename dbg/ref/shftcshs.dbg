     2753           view-as alert-box .
     2754       end.
     2755       else do:
     2756           assign
     2757             l-query-was-opened = true
     2758           .
     2759       end.
     2760     end.
     2761     if l-filter-open-28 = false then do:
     2762       OPEN QUERY br-docs FOR EACH sb-shift-cash
     2763         where  sb-shift-cash.obj-type = 'маг':U              AND sb-shift-cash.obj-code = shop-code              AND sb-shift-cash.sale-date = sale-date
     2764          BY sb-shift-cash.shift-date Descending By sb-shift-cash.shift-num descending By sb-shift-cash.cash-num
     2765         indexed-reposition
     2766     .
     2767         assign
     2768           l-query-was-opened = true
     2769         .
     2770     end.
     2771     run waitfram-hide in this-procedure .
     2772       end.
     2773       when 'касс':U then do:
     2774           find first ub.cash-desk WHERE recid(ub.cash-desk) = rc No-LOCK No-ERROR.
     2775           cashnum = ub.cash-desk.cash-num.
     2776           find first ub.shop No-LOCK WHERE ub.shop.obj-code = shop-code No-ERROR.
     2777           ASSIGN
     2778           frame Dialog-Frame:TITLE = "СМЕНЫ ПО КАССЕ N " +
     2779                                               string(ub.cash-desk.cash-num, "9999") +
     2780                                               " магазина N " +
     2781                                               string(shop-code, ">>>>9")
     2782           filter-point = filter-point0 + p-list-mode
     2783           filter-label = substitute("&1 Один магазин, одна касса", filter-label0)
     2784           .
     2785   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2786   define variable  l-disable-where-30  as logical   no-undo .
     2787   define variable  l-filter-open-30    as logical   .
     2788   define variable  flt-rec-30       as recid     no-undo .
     2789   define variable  filter-name-30      as character no-undo .
     2790   define variable  where-phrase-30     as character no-undo .
     2791   define variable  sort-phrase-30      as character no-undo .
     2792   define variable  where-phrase-rus-30 as character no-undo .
     2793   define variable  sort-phrase-rus-30  as character no-undo .
     2794     run waitfram-show in this-procedure
     2795       (input "ЖДИТЕ ..."
     2796       ).
     2797   run gbl/flt-get.p
     2798     (input filter-point
     2799     ,output flt-rec-30
     2800     ,output filter-name-30
     2801     ,output where-phrase-30
     2802     ,output sort-phrase-30
     2803     ,output where-phrase-rus-30
     2804     ,output sort-phrase-rus-30
     2805     ).
     2806       run set-filter-name in this-procedure
     2807         (INPUT filter-name-30
     2808         ) no-error .
     2809     assign
     2810       l-filter-open-30 = false
     2811     .
     2812     if flt-rec-30 <> ?
     2813       or sort-column-phrase > ""
     2814     then do:
     2815       define variable  parameter-2-30 as character no-undo .
     2816       define variable  parameter-3-30 as character no-undo .
     2817       define variable  parameter-4-30 as character no-undo .
     2818       define variable  parameter-5-30 as character no-undo .
     2819       define variable  parameter-6-30 as character no-undo .
     2820       define variable  parameter-7-30 as character no-undo .
     2821         assign
     2822         parameter-3-30 =
     2823                                 "FOR EACH sb-shift-cash"
     2824         parameter-4-30 =
     2825           (
     2826             if ("sb-shift-cash.obj-type = 'маг':U              AND sb-shift-cash.obj-code = shop-code              AND sb-shift-cash.cash-num = cashnum " + " " + where-phrase-30) <> ""
     2827             then  substitute('sb-shift-cash.obj-type = &1&2&1              AND sb-shift-cash.obj-code = &3              AND sb-shift-cash.cash-num = &4 ', chr(34), 'маг':U, shop-code, cashnum) + " " + where-phrase-30
     2828             else "true"
     2829           )
     2830         parameter-5-30 = (" " + "" + " " + "")
     2831         parameter-6-30 = if sort-phrase-30 = ''
     2832                              then
     2833           (
     2834           " " + "  " +
     2835             " " + sort-column-phrase +
     2836           " " + " BY sb-shift-cash.shift-date Descending By sb-shift-cash.shift-num descending "
     2837           )
     2838                              else
     2839           (
     2840           " " + "  " +
     2841             " " + sort-column-phrase +
     2842           " " + sort-phrase-30
     2843           )
     2844         parameter-7-30 =
     2845           " indexed-reposition  "
     2846       .
     2847       do
     2848       on stop undo, leave
     2849       on error undo, leave
     2850       :
     2851         assign
     2852           l-disable-where-30 =
     2853             ("sb-shift-cash.obj-type = 'маг':U              AND sb-shift-cash.obj-code = shop-code              AND sb-shift-cash.cash-num = cashnum " + " " + where-phrase-30 = "")
     2854         .
     2855         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2856                             ,input QUERY br-docs:handle
     2857                             ,input parameter-3-30
     2858                             ,input parameter-4-30
     2859                             ,input parameter-5-30
     2860                             ,input parameter-6-30
     2861                             ,input parameter-7-30
     2862                             )
     2863         .
     2864         assign
     2865           l-filter-open-30 = true
     2866         .
     2867       end.
     2868       if l-filter-open-30 = false then do:
     2869         message
     2870           "Ошибка при фильтрации / сортировке" skip
     2871           "Будут показаны записи без учета фильтра" skip
     2872           view-as alert-box .
     2873       end.
     2874       else do:
     2875           assign
     2876             l-query-was-opened = true
     2877           .
     2878       end.
     2879     end.
     2880     if l-filter-open-30 = false then do:
     2881       OPEN QUERY br-docs FOR EACH sb-shift-cash
     2882         where sb-shift-cash.obj-type = 'маг':U              AND sb-shift-cash.obj-code = shop-code              AND sb-shift-cash.cash-num = cashnum
     2883          BY sb-shift-cash.shift-date Descending By sb-shift-cash.shift-num descending
     2884         indexed-reposition
     2885     .
     2886         assign
     2887           l-query-was-opened = true
     2888         .
     2889     end.
     2890     run waitfram-hide in this-procedure .
     2891       end.
     2892   END CASE.
     2893   run waitfram-hide in this-procedure .
     2894   APPLY "VALUE-CHANGED" TO BR-DOCS IN FRAME Dialog-Frame.
     2895   APPLY "ENTRY" TO BR-DOCS.
     2896   END PROCEDURE.
     2897   PROCEDURE proc-b-chg :
     2898   DEFINE INPUT PARAMETER p-obj-code like ub.cash-desk.obj-code NO-UNDO.
     2899   DEFINE INPUT PARAMETER p-cash-num like ub.cash-desk.cash-num NO-UNDO.
     2900   DEFINE INPUT PARAMETER p-shift-date like ub.chk-doc.shift-date NO-UNDO.
     2901   DEFINE INPUT PARAMETER p-shift-num  like ub.chk-doc.shift-num NO-UNDO.
     2902   DEFINE INPUT PARAMETER p-shift-name  AS character NO-UNDO.
     2903   define input parameter p-recid as recid no-undo .
     2904   define variable glog as logical no-undo .
     2905   DEFINE VARIABLE v-shift-date LIKE ub.chk-doc.shift-date NO-UNDO.
     2906   DEFINE variable v-shift-num  like ub.chk-doc.shift-num NO-UNDO.
     2907   DEFINE VARIABLE v-shift-name  AS CHARACTER NO-UNDO.
     2908   DEFINE VARIABLE v-added AS logical NO-UNDO.
     2909   DEFINE VARIABLE v-added-num AS INTEGER NO-UNDO.
     2910   DEFINE VARIABLE v-added-num-wth AS INTEGER NO-UNDO.
     2911   DEFINE VARIABLE v-change-fields AS CHARACTER NO-UNDO.
     2912   DEFINE VARIABLE v-temp-char AS CHARACTER NO-UNDO.
     2913   define variable v-doc-rec as recid no-undo.
     2914   define variable v-field-descr1 as character no-undo .
     2915   define variable v-field-descr2 as character no-undo .
     2916   define variable v-host-code as integer no-undo .
     2917   DEFINE BUFFER buf_chk-doc FOR ub.chk-doc.
     2918   define buffer buf_shift-cash for ub.shift-cash.
     2919   define buffer uniq_shift-cash for ub.shift-cash.
     2920   IF l-shift-on THEN DO:
     2921   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2922   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     2923     (input  'маг':U
     2924     ,input  shop-code
     2925     ,output v-shift-date
     2926     ,output v-shift-num
     2927     ,output v-shift-name
     2928     ) no-error .
     2929     if error-status:error or v-shift-num = 0 then do:
     2930       message
     2931       substitute("На объекте кассы &1&2 смена не открыта,&3" +
     2932                  "Изменение невозможно"
     2933                  ,'маг':U
     2934                  ,p-obj-code
     2935                  ,chr(10))
     2936       view-as alert-box.
     2937       RETURN error.
     2938     end.
     2939     IF ERROR-STATUS:ERROR THEN DO:
     2940       MESSAGE
     2941       ERROR-STATUS:GET-MESSAGE(1) SKIP
     2942       RETURN-VALUE
     2943       VIEW-AS ALERT-BOX ERROR.
     2944       UNDO, RETURN ERROR.
     2945     END.
     2946     IF v-shift-date = p-shift-date
     2947     and v-shift-num = p-shift-num
     2948     and v-shift-name = p-shift-name THEN DO:
     2949        MESSAGE
     2950        "Изменения НЕВОЗМОЖНЫ" SKIP
     2951        "Данная смена на кассе УЖЕ СООТВЕТСТВУЕТ смене на объекте"
     2952        VIEW-AS ALERT-BOX ERROR .
     2953        RETURN.
     2954     END.
     2955     IF v-shift-date <> p-shift-date THEN DO:
     2956       ASSIGN
     2957       v-change-fields = v-change-fields + chr(44) + "shift-date".
     2958     END.
     2959     if v-shift-num <> p-shift-num THEN DO:
     2960       ASSIGN
     2961       v-change-fields = v-change-fields + chr(44) +  "shift-num".
     2962     END.
     2963     if v-shift-name <> p-shift-name THEN DO:
     2964       ASSIGN
     2965       v-change-fields = v-change-fields + chr(44) +  "shift-name".
     2966     END.
     2967     assign
     2968     v-field-descr1 = substitute("Дата смены &1, № смены &2, пор. смены &3"
     2969                                 ,v-shift-date
     2970                                 ,v-shift-num
     2971                                 ,v-shift-name).
     2972     assign
     2973     v-field-descr2 = substitute("Дата смены &1, № смены &2, пор. смены &3"
     2974                                 ,p-shift-date
     2975                                 ,p-shift-num
     2976                                 ,p-shift-name).
     2977      MESSAGE
     2978      substitute("ЗАПИСЬ КАССОВОЙ СМЕНЫ БУДЕТ ИМЕТЬ:&1&2" +
     2979                 "Все ЧЕКИ и ЧЕКИ МЦ для данной СМЕНЫ НА КАССЕ будут иметь:&1&3"
     2980                 ,chr(10)
     2981                 ,(if v-shift-date = p-shift-date
     2982                   THEN v-field-descr1
     2983                   else v-field-descr2)
     2984                 ,v-field-descr1
     2985                 )
     2986      VIEW-AS ALERT-BOX
     2987      QUESTION BUTTONS YES-NO
     2988      TITLE "ПЕРЕНОС СМЕНЫ НА КАССЕ на ТЕКУЩУЮ СМЕНУ НА ОБЪЕКТЕ"
     2989      UPDATE glog.
     2990      IF NOT glog THEN RETURN .
     2991      run waitfram-show in this-procedure ( input "Ждите...").
     2992      do TRANSACTION on stop undo, return no-apply on error undo, return no-apply:
     2993        find first buf_shift-cash exclusive-lock where
     2994               recid(buf_shift-cash) = p-recid.
     2995       assign
     2996       buf_shift-cash.shift-date = v-shift-date
     2997       buf_shift-cash.shift-num = v-shift-num
     2998       buf_shift-cash.shift-name = v-shift-name
     2999       glog = no
     3000       .
     3001   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3002   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3003     (input  'маг':U
     3004     ,input  p-obj-code
     3005     ,output v-host-code
     3006     )  .
     3007       _chk-doc:
     3008       for each buf_chk-doc where
     3009             buf_chk-doc.out-code = ?
     3010         and buf_chk-doc.obj-type = 'маг':U
     3011         AND buf_chk-doc.obj-code = p-obj-code
     3012         AND buf_chk-doc.pay-desk = p-cash-num
     3013         AND buf_chk-doc.shift-date = p-shift-date
     3014         AND buf_chk-doc.src-shift-name = p-shift-name
     3015       ON ERROR UNDO _chk-doc, NEXT _chk-doc:
     3016         assign
     3017         v-doc-rec = recid(buf_chk-doc)
     3018         v-added = no
     3019         .
     3020          run str/chkshift.p (
     3021                                input parparentproc
     3022                               ,input l-shift-on
     3023                               ,input v-doc-rec
     3024                               ,input v-shift-date
     3025                               ,input v-shift-num
     3026                               ,input v-shift-name
     3027                               ,input v-change-fields
     3028                               ,input NO
     3029                               ,output v-added
     3030                                 ) no-error.
     3031         if error-status:error then do:
     3032            next _chk-doc.
     3033         end.
     3034         if v-added then
     3035         assign
     3036         v-added-num = v-added-num + 1
     3037         .
     3038      end.
     3039     end.
     3040     run waitfram-hide in this-procedure .
     3041   END.
     3042   ELSE do:
     3043     IF v-shft > 0 THEN DO:
     3044       do TRANSACTION on stop undo, return error on error undo, return ERROR:
     3045           for each buf_chk-doc where
     3046                     buf_chk-doc.out-code = ?
     3047                 AND buf_chk-doc.obj-type = sb-shift-cash.obj-type
     3048                 AND buf_chk-doc.obj-code = sb-shift-cash.obj-code
     3049                 AND buf_chk-doc.pay-desk = sb-shift-cash.cash-num
     3050                 AND buf_chk-doc.shift-date = sb-shift-cash.sale-date
     3051                 AND buf_chk-doc.shift-num = sb-shift-cash.shift-num
     3052           ON ERROR UNDO, RETURN ERROR:
     3053             assign
     3054             buf_chk-doc.shift-date = p-shift-date.
     3055           end.
     3056       end.
     3057     end.
     3058   END.
     3059   END PROCEDURE.
