     2622                             ,input QUERY br-docs:handle
     2623                             ,input parameter-3-26
     2624                             ,input parameter-4-26
     2625                             ,input parameter-5-26
     2626                             ,input parameter-6-26
     2627                             ,input parameter-7-26
     2628                             )
     2629         .
     2630         assign
