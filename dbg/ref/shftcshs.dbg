     2531   define variable sort-column-phrase as character no-undo .
     2532   case sort-column-name :
     2533     when "" then do:
     2534       assign
     2535         sort-column-phrase = ""
     2536       .
     2537     end.
     2538     otherwise do:
     2539       assign
     2540         sort-column-phrase = "by " + sort-column-name
     2541       .
     2542     end.
