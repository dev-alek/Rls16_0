     2566     ,output filter-name-26
     2567     ,output where-phrase-26
     2568     ,output sort-phrase-26
     2569     ,output where-phrase-rus-26
     2570     ,output sort-phrase-rus-26
     2571     ).
     2572       run set-filter-name in this-procedure
     2573         (INPUT filter-name-26
     2574         ) no-error .
     2575     assign
     2576       l-filter-open-26 = false
     2577     .
     2578     if flt-rec-26 <> ?
     2579       or sort-column-phrase > ""
     2580     then do:
     2581       define variable  parameter-2-26 as character no-undo .
     2582       define variable  parameter-3-26 as character no-undo .
     2583       define variable  parameter-4-26 as character no-undo .
     2584       define variable  parameter-5-26 as character no-undo .
     2585       define variable  parameter-6-26 as character no-undo .
     2586       define variable  parameter-7-26 as character no-undo .
     2587         assign
     2588         parameter-3-26 =
     2589                                 "FOR EACH sb-shift-cash"
     2590         parameter-4-26 =
     2591           (
     2592             if (" " + " " + where-phrase-26) <> ""
     2593             then " " + " " + where-phrase-26
     2594             else "true"
     2595           )
     2596         parameter-5-26 = (" " + "" + " " + "")
     2597         parameter-6-26 = if sort-phrase-26 = ''
     2598                              then
