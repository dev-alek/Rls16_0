     2600           " " + "  " +
     2601             " " + sort-column-phrase +
     2602           " " + "  "
     2603           )
     2604                              else
     2605           (
     2606           " " + "  " +
     2607             " " + sort-column-phrase +
     2608           " " + sort-phrase-26
     2609           )
     2610         parameter-7-26 =
     2611           " indexed-reposition  "
     2612       .
     2613       do
     2614       on stop undo, leave
     2615       on error undo, leave
