     2162   ON TAB ANYWHERE
     2163   DO:
     2164   define variable ii as integer no-undo .
     2165   define variable fh as widget-handle no-undo .
     2166   define variable hh as widget-handle no-undo .
     2167   define variable v-next-widget-name as character no-undo .
     2168   if v-tab-order <> '' then do:
     2169     if self:type = "TOGGLE-BOX" then
     2170     self:BGCOLOR = ?.
     2171     assign
     2172     ii = lookup(self:name, v-tab-order).
     2173     assign
     2174     ii = ii + 1
     2175     v-next-widget-name = entry(ii, v-tab-order)
     2176     no-error .
     2177     if error-status:error then do:
     2178       assign
     2179       ii = 1
     2180       v-next-widget-name = entry( ii, v-tab-order)
     2181       .
     2182     end.
     2183     assign
     2184     fh = frame Dialog-Frame:first-child
     2185     hh = fh:first-child
     2186     .
     2187     do while valid-handle(hh):
     2188       if hh:name = v-next-widget-name then do:
     2189         if hh:sensitive  = yes
     2190         AND hh:visible = yes then do:
     2191           if hh:type = "TOGGLE-BOX":U then do:
     2192             assign
     2193             hh:BGcolor = 1
     2194             .
     2195           end.
     2196           APPLY "ENTRY" to hh.
     2197           return no-apply.
     2198         end.
     2199         else do:
     2200           APPLY "TAB" to hh.
     2201           return no-apply.
     2202         end.
     2203       end.
     2204       hh = hh:next-sibling.
     2205     end.
     2206   end.
     2207   END.
     2208   ON BACK-TAB ANYWHERE
     2209   DO:
     2210   define variable ii as integer no-undo .
     2211   define variable fh as widget-handle no-undo .
     2212   define variable hh as widget-handle no-undo .
     2213   define variable v-next-widget-name as character no-undo .
     2214   if v-tab-order <> '' then do:
     2215     assign
     2216     ii = lookup(self:name, v-tab-order).
     2217     .
     2218     assign
     2219     ii = (if ii = 1
     2220           then  num-entries(v-tab-order)
     2221           else ii - 1
     2222           )
     2223     v-next-widget-name = entry(ii, v-tab-order)
     2224     .
     2225     assign
     2226     fh = frame Dialog-Frame:first-child
     2227     hh = fh:first-child
     2228     .
     2229     do while valid-handle(hh):
     2230       if hh:name = v-next-widget-name then do:
     2231         if hh:sensitive  = yes
     2232         AND hh:visible = yes then do:
     2233           if hh:type = "TOGGLE-BOX":U then do:
     2234             assign
     2235             hh:BGcolor = 1
     2236             .
     2237           end.
     2238           APPLY "ENTRY" to hh.
     2239           return no-apply.
     2240         end.
     2241         else do:
     2242         APPLY "BACK-TAB" to hh.
     2243         return no-apply.
     2244         end.
     2245       end.
     2246       hh = hh:next-sibling.
     2247     end.
     2248     end.
     2249   END.
     2250   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2251   ON RETURN ANYWHERE
