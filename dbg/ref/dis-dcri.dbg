     2465   RUN disable_UI in this-procedure .
     2466   if updated then return 'ИЗМЕНЕНИЕ':U.
     2467   PROCEDURE disable_UI :
     2468     HIDE FRAME Dialog-Frame.
     2469   END PROCEDURE.
     2470   PROCEDURE enable_UI :
     2471     DISPLAY card-cli-name f-d-card card-cli-type card-cli-code card-type
     2472             card-emitent
     2473         WITH FRAME Dialog-Frame.
     2474     ENABLE B-exit b-quit b-add B-lookup b-chg b-del b-help card-cli-name f-d-card
     2475            card-cli-type card-cli-code card-type card-emitent
     2476         WITH FRAME Dialog-Frame.
     2477     VIEW FRAME Dialog-Frame.
     2478     OPEN QUERY br-dis-dc FOR EACH temp-odisc NO-LOCK.
     2479   END PROCEDURE.
     2480   PROCEDURE init-proc :
     2481   define variable v-rule-label as character no-undo .
     2482   define buffer buf_dis-card for ub.dis-card.
     2483   define buffer buf_clients for ub.clients.
     2484   for each  temp-odisc share-lock:
     2485     if p-mode = 'ИЗМЕНЕНИЕ':U
     2486     and (temp-odisc.obj-type = p-obj-type
     2487         and
     2488         temp-odisc.obj-code = p-obj-code)
     2489     or (v-cntxt-db-num = 0
     2490         and temp-odisc.obj-type = '':U
     2491         and
     2492         temp-odisc.obj-code = 0)
     2493     or (v-cntxt-db-num = 0
     2494         and temp-odisc.obj-type = 'орг':U
     2495         and temp-odisc.obj-code = p-host-code)
     2496         then do:
     2497     end.
     2498     else do:
     2499       delete temp-odisc.
     2500     end.
     2501   end.
     2502   if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     2503     find first buf_dis-card where
     2504              buf_dis-card.d-card =  p-d-card no-lock no-error .
     2505     find first buf_clients where
     2506                 buf_clients.obj-code =  buf_dis-card.cli-code
     2507             and buf_clients.obj-type =  buf_dis-card.cli-type  no-lock no-error .
     2508     Assign
     2509     card-cli-name = buf_clients.obj-name
     2510     f-d-card = buf_dis-card.d-card
     2511     card-cli-type = buf_clients.obj-type
     2512     card-cli-code = buf_clients.obj-code
     2513     card-type = buf_Dis-card.TYPE
     2514     card-emitent = buf_Dis-card.emitent-host-code
     2515     .
     2516     display
     2517     card-cli-name
     2518     f-d-card
     2519     card-type
     2520     card-cli-type
     2521     card-cli-code
     2522     with frame Dialog-Frame  .
     2523   end.
     2524    For each tt0-dis-dc-rule where
     2525            tt0-dis-dc-rule.d-card  = p-d-card  no-lock :
     2526       if p-pos-type <> '':U
     2527       and p-pos-type <> tt0-dis-dc-rule.pos-type then do:
     2528         NEXT.
     2529       end.
     2530       run disdcrul-name ( input tt0-dis-dc-rule.templ-rl-root
     2531                           ,output v-rule-label
     2532                            ).
     2533       find first temp-odisc where
     2534                 temp-odisc.discnt-role = tt0-dis-dc-rule.discnt-role
     2535             AND temp-odisc.host-code = tt0-dis-dc-rule.host-code
     2536             AND temp-odisc.obj-code = tt0-dis-dc-rule.obj-code
     2537             AND temp-odisc.obj-type = tt0-dis-dc-rule.obj-type
     2538             AND temp-odisc.d-card = tt0-dis-dc-rule.d-card
     2539             AND temp-odisc.nonunique = tt0-dis-dc-rule.nonunique
     2540             AND temp-odisc.pos-type = tt0-dis-dc-rule.pos-type
     2541             no-error.
     2542       if not available temp-odisc then do:
     2543         create temp-odisc.
     2544         assign
     2545         temp-odisc.host-code = tt0-dis-dc-rule.host-code
     2546         temp-odisc.obj-code = tt0-dis-dc-rule.obj-code
     2547         temp-odisc.obj-type = tt0-dis-dc-rule.obj-type
     2548         temp-odisc.d-card = tt0-dis-dc-rule.d-card
     2549         temp-odisc.pos-type = tt0-dis-dc-rule.pos-type
     2550         temp-odisc.nonunique = tt0-dis-dc-rule.nonunique
     2551         temp-odisc.discnt-role = tt0-dis-dc-rule.discnt-role
     2552         .
     2553       end.
     2554       assign
     2555       temp-odisc.templ-rl-root = tt0-dis-dc-rule.templ-rl-root
     2556       temp-odisc.time-templ-rl-root = tt0-dis-dc-rule.time-templ-rl-root
     2557       temp-odisc.rule-num =  tt0-dis-dc-rule.rule-num
     2558       temp-odisc.rule-label = v-rule-label
     2559       temp-odisc.rl-root = tt0-dis-dc-rule.rl-root
     2560       .
     2561     End.
     2562     OPEN QUERY br-dis-dc FOR EACH temp-odisc NO-LOCK.
     2563   END PROCEDURE.
     2564   PROCEDURE MyEnable :
     2565   DEFINE VARIABLE v-h AS WIDGET-HANDLE NO-UNDO.
     2566   v-h = br-dis-dc:FIRST-COLUMN IN FRAME Dialog-Frame.
     2567   DO while valid-handle(v-h) :
     2568     if v-h:LABEL = 'Тип скидки' then do:
     2569       v-h:RESIZABLE = YES.
     2570       leave.
     2571     end.
     2572     ELSE DO:
     2573       v-h = v-h:NEXT-COLUMN.
     2574     END.
     2575   END.
     2576   IF p-obj-type = 'маг':U THEN DO:
     2577   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2578   define variable v-param-type21 as character no-undo .
     2579   define variable v-value-date21 as date no-undo .
     2580   define variable v-value-decimal21 as decimal no-undo .
     2581   define variable v-value-integer21 as INTEGER no-undo .
     2582   define variable v-value-logical21 AS LOGICAL no-undo .
     2583   define variable v-tth21 as handle no-undo .
     2584   run adm/shattri.p (
     2585       input "get":U
     2586       ,input  p-obj-type
     2587       ,input  p-obj-code
     2588       ,input  'cd-sending':U
     2589       ,input  'dflt-cd':U
     2590       ,output dflt-cd
     2591       ,output v-value-date21
     2592       ,output v-value-decimal21
     2593       ,output v-value-integer21
     2594       ,output v-value-logical21
     2595       ,output v-param-type21
     2596       ,INPUT-OUTPUT table-handle v-tth21
     2597       )  .
     2598   delete object v-tth21 no-error.
     2599   END.
     2600   if p-obj-type = 'скл':U then do:
     2601     dflt-cd = '-':U.
     2602   end.
     2603   ASSIGN
     2604   b-add:POPUP-MENU IN FRAME Dialog-Frame = MENU MENU-b-add:HANDLE
     2605   b-add:MENU-MOUSE = 1
     2606   MENU-ITEM m_pos-type:LABEL IN MENU menu-b-add  = dflt-cd
     2607   MENU-ITEM m_pos-type:sensitive IN MENU menu-b-add  = ((dflt-cd <> '':U) and (dflt-cd <> '-':U))
     2608   .
     2609   assign
     2610   v-tab-order = "b-exit,b-quit,b-add,b-lookup,b-chg,b-del,b-help,br-dis-dc".
     2611                           .
     2612   DISPLAY
     2613   card-cli-name
     2614   f-d-card
     2615   card-type
     2616   card-emitent
     2617   WITH FRAME Dialog-Frame.
     2618   ENABLE
     2619   b-exit when (p-mode <> 'ПРОСМОТР':U )
     2620   b-quit
     2621   b-del when (p-mode <> 'ПРОСМОТР':U )
     2622   b-add when (p-mode <> 'ПРОСМОТР':U )
     2623   b-chg when (p-mode <> 'ПРОСМОТР':U )
     2624   b-lookup
     2625   b-help br-dis-dc card-cli-name f-d-card card-type
     2626   WITH FRAME Dialog-Frame .
     2627   VIEW FRAME Dialog-Frame .
     2628   if p-mode = 'ПРОСМОТР':U then do:
     2629     hide
     2630     b-exit
     2631     in frame Dialog-Frame .
     2632     assign
     2633     b-quit:label = "&Выход"
     2634     b-quit:col    = 1
     2635     .
     2636   end.
     2637   OPEN QUERY br-dis-dc FOR EACH temp-odisc NO-LOCK.
     2638   APPLY "ENTRY" to br-dis-dc.
     2639   END PROCEDURE.
     2640   PROCEDURE proc-add-chg :
     2641   define input parameter p-add as logical no-undo.
     2642   define input parameter p-pos-type as character no-undo.
     2643   define variable v-rule-label as character no-undo .
     2644   DEFINE VARIABLE v-rule-num as integer no-undo .
     2645   define variable v-setted as logical no-undo .
     2646   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2647   define variable v-templ-rl-root as integer no-undo .
     2648   define variable v-time-templ-rl-root as integer no-undo .
     2649   define variable v-cfg-nonunique as character no-undo .
     2650   define variable v-nonunique as character no-undo .
     2651   define variable v-pos-type as character no-undo .
     2652   define variable v-discnt-role as character no-undo .
     2653   define variable v-obj-type as character no-undo .
     2654   define variable v-obj-code as integer no-undo .
     2655   define variable v-host-code as integer no-undo .
     2656   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     2657   define buffer buf_dis-dc-rule for ub.dis-dc-rule.
     2658   define buffer buf_temp-odisc for temp-odisc.
     2659   CASE p-add:
     2660     when yes then do:
     2661       run ref/dis-pos.w ( INPUT parparentproc
     2662                           ,INPUT "b-sel":U
     2663                           ,INPUT (if p-pos-type = '':U then 'все':U else "cd-type-list")
     2664                           ,INPUT (if v-cntxt-db-num = 0 and loc-glob  then 1 else 0)
     2665                           ,INPUT (if v-cntxt-db-num = 0 and loc-firm  then 1 else 0)
     2666                           ,INPUT (if loc-object then 1 else 0)
     2667                           ,input 'dis-dc-rule':U
     2668                           ,input '':U
     2669                           ,input ?
     2670                           ,INPUT p-pos-type
     2671                           ,input '':U
     2672                           ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     2673      IF ERROR-STATUS:ERROR
     2674      OR v-rid-list = '':U THEN DO:
     2675         RETURN.
     2676      END.
     2677      FIND FIRST buf_dis-cfg-rule NO-LOCK where
     2678                recid(buf_dis-cfg-rule) = INTEGER(v-rid-list).
     2679       assign
     2680       v-templ-rl-root = buf_dis-cfg-rule.templ-rl-root
     2681       v-time-templ-rl-root = buf_dis-cfg-rule.time-templ-rl-root
     2682       V-cfg-NONUNIQUE = buf_dis-cfg-rule.nonunique
     2683       v-pos-type   = buf_dis-cfg-rule.pos-type
     2684       v-discnt-role = buf_dis-cfg-rule.discnt-role
     2685       .
     2686       assign
     2687       added = yes.
     2688       v-rule-num = 0.
     2689      if (buf_dis-cfg-rule.has-global +
     2690          buf_dis-cfg-rule.has-host +
     2691          buf_dis-cfg-rule.has-obj) > 1 then do:
     2692         define variable v-sel-vals as character no-undo .
     2693         define variable v-sel-labels as character no-undo .
     2694         define variable var-region as character no-undo .
     2695         assign
     2696         v-sel-vals = v-sel-vals +
     2697                       (if buf_dis-cfg-rule.has-global = 1
     2698                       then (fill(chr(32), 3)  + string(0) + chr(44))
     2699                       else "":U)
     2700         v-sel-labels = v-sel-labels +
     2701                       (if buf_dis-cfg-rule.has-global  = 1
     2702                       then ("Глобально" + chr(44))
     2703                       else "":U)
     2704         .
     2705         assign
     2706         v-sel-vals = v-sel-vals +
     2707                       (if buf_dis-cfg-rule.has-host = 1
     2708                       then ('орг':U  + string(v-cntxt-host-code-obj)  + chr(44))
     2709                       else "":U)
     2710         v-sel-labels = v-sel-labels +
     2711                       (if buf_dis-cfg-rule.has-host = 1
     2712                       then ("Фирма"  + string(v-cntxt-host-code-obj) + chr(44))
     2713                       else "":U)
     2714         .
     2715         assign
     2716         v-sel-vals = v-sel-vals +
     2717                       (if buf_dis-cfg-rule.has-obj = 1
     2718                       then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(44))
     2719                       else "":U)
     2720         v-sel-labels = v-sel-labels +
     2721                       (if buf_dis-cfg-rule.has-obj = 1
     2722                       then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(44))
     2723                       else "":U)
     2724         .
     2725         run gbl/d-list.w (
     2726                             input "b-sel":U
     2727                             ,input "Выберите область действия"
     2728                             ,input v-sel-vals
     2729                             ,input v-sel-labels
     2730                             ,input chr(44)
     2731                             ,input "":U
     2732                             ,output var-region) no-error.
     2733         if error-status:error then do:
     2734           return error.
     2735         end.
     2736         assign
     2737         v-obj-type = trim(substring(var-region, 1, 3))
     2738         v-obj-code = integer(substring(var-region, 4))
     2739         v-host-code = (if var-region begins 'орг':U
     2740                       then integer(substring(var-region, 4))
     2741                       else 0)
     2742         v-obj-code = (if v-obj-type = 'орг':U then 0 else v-obj-code)
     2743         v-obj-type = (if v-obj-type = 'орг':U then "" else v-obj-type)
     2744         .
     2745         if v-host-code = 0
     2746          and v-obj-type <> '':U then do:
     2747   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2748   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2749     (input  v-obj-type
     2750     ,input  v-obj-code
     2751     ,output v-host-code
     2752     )  .
     2753         end.
     2754       end.
     2755       else do:
     2756         if buf_dis-cfg-rule.has-obj = 1 then do:
     2757           assign
     2758           v-obj-type = p-obj-type
     2759           v-obj-code = p-obj-code
     2760           .
     2761   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2762   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2763     (input  p-obj-type
     2764     ,input  p-obj-code
     2765     ,output v-host-code
     2766     )  .
     2767         end.
     2768         if buf_dis-cfg-rule.has-host = 1 then do:
     2769   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2770   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2771     (input  p-obj-type
     2772     ,input  p-obj-code
     2773     ,output v-host-code
     2774     )  .
     2775           assign
     2776           v-obj-type = ""
     2777           v-obj-code = 0
     2778           .
     2779         end.
     2780         if buf_dis-cfg-rule.has-glob = 1 then do:
     2781           assign
     2782           v-host-code = 0
     2783           v-obj-type = '':U
     2784           v-obj-code = 0
     2785           .
     2786         end.
     2787       end.
     2788     end.
     2789     when no then do:
     2790       find first buf_dis-cfg-rule no-lock where
     2791                 buf_dis-cfg-rule.table-name = 'dis-dc-rule':U
     2792             and buf_dis-cfg-rule.discnt-role = temp-odisc.discnt-role
     2793             and buf_dis-cfg-rule.pos-type = temp-odisc.pos-type
     2794             no-error .
     2795       if available buf_dis-cfg-rule then do:
     2796         assign
     2797         v-nonunique = buf_dis-cfg-rule.nonunique.
     2798       end.
     2799       v-rule-num  = temp-odisc.rule-num.
     2800     end.
     2801   END CASE.
     2802   run disdcrul-edit in this-procedure (
     2803                                          input (if p-add then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     2804                                         ,input p-d-card
     2805                                         ,input (if p-add then v-host-code else temp-odisc.host-code)
     2806                                         ,input (if p-add then v-obj-type  else temp-odisc.obj-type)
     2807                                         ,input (if p-add then v-obj-code  else temp-odisc.obj-code)
     2808                                         ,INPUT (if p-add then v-pos-type else temp-odisc.pos-type)
     2809                                         ,input (if p-add then v-discnt-role else temp-odisc.discnt-role)
     2810                                         ,input (if p-add then v-templ-rl-root else temp-odisc.templ-rl-root)
     2811                                         ,input (if p-add then v-time-templ-rl-root else temp-odisc.time-templ-rl-root)
     2812                                         ,input v-cfg-nonunique
     2813                                         ,input 1
     2814                                         ,input-output v-rule-num
     2815                                         ,input-output v-nonunique
     2816                                         ,output v-setted ) no-error.
     2817   if not v-setted then return error.
     2818   run temp-disdcrul-write in this-procedure (
     2819                                              input p-d-card
     2820                                             ,input p-host-code
     2821                                             ,input p-obj-type
     2822                                             ,input p-obj-code
     2823                                             ,input (if p-add then v-pos-type else temp-odisc.pos-type)
     2824                                             ,input (if p-add then v-templ-rl-root else temp-odisc.templ-rl-root)
     2825                                             ,input (if p-add then v-time-templ-rl-root else temp-odisc.time-templ-rl-root)
     2826                                             ,input (if p-add then v-discnt-role else temp-odisc.discnt-role)
     2827                                             ,input (if p-add then ? else temp-odisc.nonunique)
     2828                                             ,input v-rule-num
     2829                                             ,input v-nonunique
     2830                                             ) no-error .
     2831   IF not error-status:error then do:
     2832     assign
     2833     updated = yes
     2834     .
     2835     br-dis-dc:refresh() in frame Dialog-Frame no-error .
     2836   END.
     2837   assign
     2838   added = no.
     2839   if p-add = yes then do:
     2840     OPEN QUERY br-dis-dc FOR EACH temp-odisc NO-LOCK.
     2841     find first buf_temp-odisc no-lock where
     2842               buf_temp-odisc.pos-type = add-option
     2843           AND buf_temp-odisc.templ-rl-root = v-templ-rl-root
     2844           AND buf_temp-odisc.nonunique = v-nonunique
     2845          and buf_temp-odisc.pos-type = add-option
     2846          and buf_temp-odisc.host-code = v-host-code
     2847          and buf_temp-odisc.obj-type = v-obj-type
     2848          and buf_temp-odisc.obj-code = v-obj-code
     2849         no-error.
     2850     add-option = '':U.
     2851     if avail buf_temp-odisc then
     2852         temp-doc-rec = recid(buf_temp-odisc).
     2853         else temp-doc-rec = ?.
     2854     reposition br-dis-dc to recid temp-doc-rec no-error.
     2855     if error-status:error then return no-apply.
     2856   end.
     2857   END PROCEDURE.
     2858   PROCEDURE proc-b-lookup :
     2859   define variable disc-label as character no-undo .
     2860   run disdcrul-name in this-procedure (
     2861                                         input temp-odisc.templ-rl-root
     2862                                       , output disc-label
     2863                                   ) no-error.
     2864   IF ERROR-STATUS:ERROR THEN DO:
     2865       message "Ошибка при определении названия и типа скидки ДК!"         skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     2866       return error.
     2867   END.
     2868   run ref/show-dr.p ( input parparentproc
     2869                      ,input temp-odisc.rule-num) no-error.
     2870   END PROCEDURE.
     2871   PROCEDURE proc-save :
     2872   DEFINE VARIABLE v-updated AS LOGICAL NO-UNDO.
     2873   define variable v-created as logical no-undo .
     2874   define variable v-deleted as logical no-undo .
     2875   define variable v-updated-str as character no-undo .
     2876   for each temp-odisc NO-LOCK where
     2877            temp-odisc.d-card = p-d-card
     2878   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2879   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2880   on endkey undo , return error substitute( "&1. endkey", vss-workfile ):
     2881     if temp-odisc.obj-type = "" and v-cntxt-db-num <> 0 then next.
     2882     if temp-odisc.host-code = 0 and v-cntxt-db-num <> 0 then next.
     2883     find first tt0-dis-dc-rule NO-LOCK WHERE
     2884             tt0-dis-dc-rule.d-card = temp-odisc.d-card
     2885       AND   tt0-dis-dc-rule.host-code = temp-odisc.host-code
     2886       AND   tt0-dis-dc-rule.obj-type = temp-odisc.obj-type
     2887       AND   tt0-dis-dc-rule.obj-code = temp-odisc.obj-code
     2888       AND   tt0-dis-dc-rule.pos-type = temp-odisc.pos-type
     2889       AND   tt0-dis-dc-rule.discnt-role = temp-odisc.discnt-role
     2890       AND tt0-dis-dc-rule.nonunique = temp-odisc.nonunique
     2891       no-error.
     2892     assign
     2893     v-updated = no.
     2894     if available  tt0-dis-dc-rule then do:
     2895       BUFFER-COMPARE temp-odisc
     2896                   TO tt0-dis-dc-rule
     2897                   case-sensitive
     2898                   SAVE result IN v-updated-str.
     2899       assign
     2900       v-created = yes
     2901       v-updated = (v-updated-str <> "":U)
     2902       .
     2903     end.
     2904     else do:
     2905       assign
     2906       v-updated = yes.
     2907     end.
     2908     if v-updated then do:
     2909       run tt0-disdcrul-write in this-procedure(
     2910                                        input p-d-card
     2911                                       ,input temp-odisc.host-code
     2912                                       ,input temp-odisc.obj-type
     2913                                       ,input temp-odisc.obj-code
     2914                                       ,input temp-odisc.pos-type
     2915                                       ,input temp-odisc.templ-rl-root
     2916                                       ,input temp-odisc.time-templ-rl-root
     2917                                       ,input temp-odisc.discnt-role
     2918                                       ,input temp-odisc.rule-num
     2919                                       ,input temp-odisc.nonunique
     2920                                       )  no-error.
     2921       if error-status:error then do:
     2922         message
     2923         "Ошибка при сохранении скидки на ДК" skip
     2924         "ДК" p-d-card skip
     2925         "объект" temp-odisc.obj-type temp-odisc.obj-code
     2926         "Фирма" temp-odisc.host-code
     2927         "Тип скидки" temp-odisc.templ-rl-root
     2928         "Место использ." temp-odisc.pos-type
     2929         view-as alert-box  error .
     2930         undo, return error  .
     2931       end.
     2932       updated = yes.
     2933     end.
     2934     ASSIGN
     2935     p-updated = v-updated OR p-updated.
     2936   End.
     2937   FOR EACH tt0-dis-dc-rule where
     2938            tt0-dis-dc-rule.d-card = p-d-card
     2939   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2940   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     2941   on endkey undo , return error substitute( "&1. endkey", vss-workfile ):
     2942     if p-pos-type <> '':U
     2943     and p-pos-type <> tt0-dis-dc-rule.pos-type then do:
     2944       NEXT.
     2945     end.
     2946     if tt0-dis-dc-rule.obj-type = "" and v-cntxt-db-num <> 0 then next.
     2947     if tt0-dis-dc-rule.host-code = 0 and v-cntxt-db-num <> 0 then next.
     2948     FIND FIRST temp-odisc NO-LOCK WHERE
     2949               temp-odisc.d-card = tt0-dis-dc-rule.d-card
     2950           AND temp-odisc.host-code = tt0-dis-dc-rule.host-code
     2951           AND temp-odisc.obj-type = tt0-dis-dc-rule.obj-type
     2952           AND temp-odisc.obj-code = tt0-dis-dc-rule.obj-code
     2953           AND temp-odisc.pos-type = tt0-dis-dc-rule.pos-type
     2954           AND temp-odisc.discnt-role = tt0-dis-dc-rule.discnt-role
     2955           AND temp-odisc.nonunique = tt0-dis-dc-rule.nonunique
     2956           NO-ERROR.
     2957       IF NOT AVAILABLE temp-odisc THEN DO:
     2958         DELETE tt0-dis-dc-rule.
     2959         assign
     2960         v-deleted = yes.
     2961         ASSIGN
     2962         p-updated = (v-deleted OR p-updated).
     2963       END.
     2964   END.
     2965   if p-updated
     2966   and p-update-instantly then do:
     2967     run ref/disdcr1.p (
     2968                        input p-mode
     2969                       ,input p-d-card
     2970                       ,input p-host-code
     2971                       ,input p-obj-type
     2972                       ,input p-obj-code
     2973                       ,INPUT table tt0-dis-dc-rule
     2974                       ) no-error .
     2975     if error-status:error then do:
     2976       message
     2977       substitute("Ошибка при сохранении скидок ДК:&1&2&1&3"
     2978                  , chr(10)
     2979                  , error-status:get-message(1)
     2980                  , return-value )
     2981       view-as alert-box
     2982       error .
     2983       undo, return error .
     2984     end.
     2985   end.
     2986   END PROCEDURE.
     2987   PROCEDURE temp-disdcrul-write :
     2988   do
     2989     on error undo, return error
     2990     :
     2991       define input parameter p-d-card like ub.dis-dc-rule.d-card   no-undo .
     2992       define input parameter p-host-code like ub.dis-dc-rule.host-code no-undo .
     2993       define input parameter p-obj-type like ub.dis-dc-rule.obj-type   no-undo .
     2994       define input parameter p-obj-code like ub.dis-dc-rule.obj-code   no-undo .
     2995       define input parameter p-pos-type like ub.dis-dc-rule.pos-type  no-undo .
     2996       define input parameter p-templ-rl-root     like ub.dis-dc-rule.templ-rl-root  no-undo .
     2997       define input parameter p-time-templ-rl-root     like ub.dis-dc-rule.time-templ-rl-root  no-undo .
     2998       define input parameter p-discnt-role like ub.dis-dc-rule.discnt-role no-undo .
     2999       define input parameter p-was-nonunique like ub.dis-dc-rule.nonunique no-undo .
     3000       define input parameter p-rule-num  like ub.dis-dc-rule.rule-num no-undo .
     3001       define input parameter p-nonunique like ub.dis-dc-rule.nonunique no-undo .
     3002       define variable v-rule-label as character no-undo .
     3003       define buffer buf_temp-odisc for temp-odisc .
     3004       run disdcrul-name in this-procedure (
     3005                                              input  p-templ-rl-root
     3006                                             ,output v-rule-label
     3007                                             ) no-error .
     3008       if error-status :error then do:
     3009         undo, return error return-value .
     3010       end.
     3011       find first buf_temp-odisc exclusive-lock where
     3012                  buf_temp-odisc.d-card  = p-d-card
     3013              AND buf_temp-odisc.host-code  = p-host-code
     3014              AND buf_temp-odisc.obj-type  = p-obj-type
     3015              AND buf_temp-odisc.obj-code  = p-obj-code
     3016              AND buf_temp-odisc.pos-type  = p-pos-type
     3017              AND buf_temp-odisc.discnt-role = p-discnt-role
     3018              AND buf_temp-odisc.nonunique = (if p-was-nonunique = ? then p-nonunique else p-was-nonunique)
     3019              no-error no-wait .
     3020       if not available buf_temp-odisc then do:
     3021         create buf_temp-odisc .
     3022         assign
     3023         buf_temp-odisc.d-card  = p-d-card
     3024         buf_temp-odisc.obj-type  = p-obj-type
     3025         buf_temp-odisc.obj-code  = p-obj-code
     3026         buf_temp-odisc.host-code  = p-host-code
     3027         buf_temp-odisc.pos-type  = p-pos-type
     3028         buf_temp-odisc.rule-num = p-rule-num
     3029         buf_temp-odisc.nonunique = p-nonunique
     3030         buf_temp-odisc.discnt-role = p-discnt-role
     3031         no-error
     3032         .
     3033       end.
     3034       ASSIGN
     3035       buf_temp-odisc.rule-num =  p-rule-num
     3036       buf_temp-odisc.time-templ-rl-root = p-time-templ-rl-root
     3037       buf_temp-odisc.nonunique = p-nonunique
     3038       buf_temp-odisc.templ-rl-root = p-templ-rl-root
     3039       no-error.
     3040     end.
     3041   END PROCEDURE.
     3042   PROCEDURE tt0-disdcrul-write :
     3043   do
     3044   on error undo, return error
     3045   :
     3046     define input parameter p-d-card like ub.dis-dc-rule.d-card   no-undo .
     3047     define input parameter p-host-code like ub.dis-dc-rule.host-code no-undo .
     3048     define input parameter p-obj-type like ub.dis-dc-rule.obj-type   no-undo .
     3049     define input parameter p-obj-code like ub.dis-dc-rule.obj-code   no-undo .
     3050     define input parameter p-pos-type like ub.dis-dc-rule.pos-type   no-undo .
     3051     define input parameter p-templ-rl-root     like ub.dis-dc-rule.templ-rl-root  no-undo .
     3052     define input parameter p-time-templ-rl-root     like ub.dis-dc-rule.time-templ-rl-root  no-undo .
     3053     define input parameter p-discnt-role       like ub.dis-dc-rule.discnt-role no-undo .
     3054     define input parameter p-value    like ub.dis-dc-rule.rule-num no-undo .
     3055     define input parameter p-nonunique like ub.dis-dc-rule.nonunique no-undo .
     3056     define variable v-rule-label          as character no-undo .
     3057     define buffer buf_tt0-dis-dc-rule for tt0-dis-dc-rule .
     3058     run disdcrul-name in this-procedure (
     3059                                         input  p-templ-rl-root
     3060                                         ,output v-rule-label
     3061                                         ) no-error .
     3062     if error-status :error then do:
     3063       undo, return error return-value .
     3064     end.
     3065     find first buf_tt0-dis-dc-rule exclusive-lock where
     3066                 buf_tt0-dis-dc-rule.d-card  = p-d-card
     3067             AND buf_tt0-dis-dc-rule.host-code  = p-host-code
     3068             AND buf_tt0-dis-dc-rule.obj-type  = p-obj-type
     3069             AND buf_tt0-dis-dc-rule.obj-code  = p-obj-code
     3070             AND buf_tt0-dis-dc-rule.pos-type  = p-pos-type
     3071             AND buf_tt0-dis-dc-rule.discnt-role = p-discnt-role
     3072             AND buf_tt0-dis-dc-rule.nonunique = p-nonunique
     3073             no-error .
     3074     if not available buf_tt0-dis-dc-rule then do:
     3075       create buf_tt0-dis-dc-rule .
     3076       assign
     3077       buf_tt0-dis-dc-rule.d-card  = p-d-card
     3078       buf_tt0-dis-dc-rule.obj-type  = p-obj-type
     3079       buf_tt0-dis-dc-rule.obj-code  = p-obj-code
     3080       buf_tt0-dis-dc-rule.host-code  = p-host-code
     3081       buf_tt0-dis-dc-rule.pos-type  = p-pos-type
     3082       buf_tt0-dis-dc-rule.nonunique = p-nonunique
     3083       buf_tt0-dis-dc-rule.discnt-role = p-discnt-role
     3084       no-error
     3085       .
     3086     end.
     3087     ASSIGN
     3088     buf_tt0-dis-dc-rule.templ-rl-root = p-templ-rl-root
     3089     buf_tt0-dis-dc-rule.rule-num = p-value
     3090     buf_tt0-dis-dc-rule.time-templ-rl-root = p-time-templ-rl-root
     3091     buf_tt0-dis-dc-rule.nonunique = p-nonunique
     3092     no-error.
     3093     release buf_tt0-dis-dc-rule no-error .
     3094     if error-status:error then do:
     3095       undo, return error return-value .
     3096     end.
     3097   end.
     3098   END PROCEDURE.
