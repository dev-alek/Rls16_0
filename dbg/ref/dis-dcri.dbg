     2268       end.
     2269       if self:type = "BUTTON" then do:
     2270         APPLY "CHOOSE" to self.
     2271       end.
     2272       if self:type = "TOGGLE-BOX" then
     2273       self:BGCOLOR = ?.
     2274       assign
     2275       ii = ii + 1
     2276       v-next-widget-name = entry(ii, v-tab-order)
     2277       no-error .
     2278       if error-status:error then do:
     2279         assign
     2280         ii = 1
     2281         v-next-widget-name = entry( ii, v-tab-order)
     2282         .
     2283       end.
     2284       assign
     2285       fh = frame Dialog-Frame:first-child
     2286       hh = fh:first-child
     2287       .
     2288       do while valid-handle(hh):
     2289         if hh:name = v-next-widget-name then do:
     2290           if hh:sensitive  = yes
     2291           AND hh:visible = yes then do:
     2292             if hh:type = "TOGGLE-BOX":U then do:
     2293               assign
     2294               hh:BGcolor = 1
     2295               .
     2296             end.
     2297             APPLY "ENTRY" to hh.
     2298             return no-apply.
     2299           end.
     2300           else do:
     2301             APPLY "TAB" to hh.
     2302             return no-apply.
     2303           end.
     2304         end.
     2305         hh = hh:next-sibling.
     2306       end.
     2307     end.
     2308   END.
     2309   procedure proc-move-forward :
     2310   define variable ii as integer no-undo .
     2311   define variable fh as widget-handle no-undo .
     2312   define variable hh as widget-handle no-undo .
     2313   define variable v-next-widget-name as character no-undo .
     2314   do
     2315   on error undo, return error
     2316   :
     2317     if v-tab-order <> '' then do:
     2318       if self:type = "TOGGLE-BOX" then
     2319       self:BGCOLOR = ?.
     2320       assign
     2321       ii = lookup(self:name, v-tab-order).
     2322       assign
     2323       ii = ii + 1
     2324       v-next-widget-name = entry(ii, v-tab-order)
     2325       no-error .
     2326       if error-status:error then do:
     2327         assign
     2328         ii = 1
     2329         v-next-widget-name = entry( ii, v-tab-order)
     2330         .
     2331       end.
     2332       assign
     2333       fh = frame Dialog-Frame:first-child
     2334       hh = fh:first-child
     2335       .
     2336       do while valid-handle(hh):
     2337         if hh:name = v-next-widget-name then do:
     2338           if hh:sensitive  = yes
     2339           AND hh:visible = yes then do:
     2340             if hh:type = "TOGGLE-BOX":U then do:
     2341               assign
     2342               hh:BGcolor = 1
     2343               .
     2344             end.
     2345             APPLY "ENTRY" to hh.
     2346             return.
     2347           end.
     2348           else do:
     2349             assign
     2350             ii = ii + 1
     2351             v-next-widget-name = entry(ii, v-tab-order)
     2352             no-error .
     2353             if error-status:error then do:
     2354               assign
